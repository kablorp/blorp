private pure func source_lines(lines: List[String]) -> String:
	lines.join("\n") + "\n"


private pure func joined_lines(lines: List[String]) -> String:
	lines.join("\n")


-- An interpolation hole, spelled without opening one in this file's own string.
private pure func hole(text: String) -> String:
	"$" + "{" + text + "}"


private pure func scanned(text: String) -> Option[(ParseState, ModuleDeclarationScan)]:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(state):
			Some(scan_module_declarations(state))
		Err(_):
			None


-- A fixture assembled from the scan's items and actual issued indexes, never
-- a production accepted module.
private pure func completed_module(state: ParseState, scan: ModuleDeclarationScan) -> ModuleSyntax:
	issued = issued_ids(state)
	{ documentation = None, items = scan.items, definitions = issued.definitions, imports = issued.imports, counts = issued.counts }


-- The dump of the one function `text` completes, when its scan reports nothing
-- and its ids pass the census.
private pure func completed_dump(text: String) -> Option[String]:
	match scanned(text):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			if completed_count(scan) == 1 and deferred_count(scan) == 0 and state.diagnostic_count() == 0 and id_census(module_id_at_row(0), syntax).is_empty():
				Some(syntax.dumped_module(spellings(state)))
			else:
				None
		None:
			None


func test_next_line_pipe_value_has_real_span_and_postorder_ids() -> Bool:
	text = "func f():\n\tvalue =\n\t\t|hello\n\tvalue\n"
	match scanned(text):
		Some((state, scan)):
			match scan.items:
				[FunctionItem(declaration)]:
					match declaration.function.body:
						Some(BlockBody(block)):
							match block.leading:
								[statement]:
									match statement.kind:
										Assignment(assignment):
											(completed_count(scan) == 1 and deferred_count(scan) == 0 and state.diagnostic_count() == 0
												and assignment.value.span.span_start() == 21 and assignment.value.span.span_end() == 28
												and assignment.value.id.expression_local_index() == 0 and statement.id.statement_local_index() == 0
												and block.last.id.statement_local_index() == 1 and block.id.block_local_index() == 0
												and id_census(module_id_at_row(0), completed_module(state, scan)).is_empty())
										_: False
								_: False
						_: False
				_: False
		None: False


func test_soft_keyword_assignment_mints_target_before_value() -> Bool:
	text = "func f():\n\tdebug = after\n"
	match scanned(text):
		Some((state, scan)):
			match scan.items:
				[FunctionItem(declaration)]:
					match declaration.function.body:
						Some(BlockBody(block)):
							match (block.leading, block.last):
								([], statement):
									match statement.kind:
										Assignment(assignment):
											match (assignment.target, assignment.value.kind):
												(AssignsName(target), NameReference(value)):
													(state.id_counts() == [1, 1, 1, 0, 0, 0, 2, 0, 0]
														and target.use.name_use_local_index() == 0 and value.use.name_use_local_index() == 1
														and assignment.value.id.expression_local_index() == 0 and statement.id.statement_local_index() == 0
														and block.id.block_local_index() == 0 and target.name.span.span_start() == 11 and target.name.span.span_end() == 16
														and value.name.span.span_start() == 19 and value.name.span.span_end() == 24
														and id_census(module_id_at_row(0), completed_module(state, scan)).is_empty())
												_: False
										_: False
								_: False
						_: False
				_: False
		None: False


func test_flat_tuple_destructuring_mints_only_binders_and_value() -> Bool:
	var correct = True
	for target in ["(a, b)", "(a, _, c)", "(_, b, c, _)", "(a, b,)", "(a, _, c, d,)"]:
		correct = correct and completed_dump(source_lines(["func f():", "\t" + target + " = pair"])).is_some()
	match scanned(source_lines(["func f():", "\t(a, _, c) = pair"])):
		Some((state, scan)):
			match scan.items:
				[FunctionItem(function)]:
					match function.function.body:
						Some(BlockBody(block)):
							match block.last.kind:
								TupleDestructure(destructure):
									match destructure.targets:
										Triple(BindsName(first), DiscardsValue(discard), BindsName(last)):
											correct = (correct and state.id_counts() == [1, 1, 1, 0, 0, 0, 1, 2, 0]
												and first.binder.binder_local_index() == 0 and last.binder.binder_local_index() == 1
												and first.name.span.span_start() == 12 and discard.span_start() == 15 and last.name.span.span_start() == 18
												and destructure.value.id.expression_local_index() == 0
												and block.last.span.span_start() == 11 and block.last.span.span_end() == 27
												and block.last.id.statement_local_index() == 0 and block.id.block_local_index() == 0
												and id_census(module_id_at_row(0), completed_module(state, scan)).is_empty())
										_: correct = False
								_: correct = False
						_: correct = False
				_: correct = False
		None: correct = False
	correct


func test_tuple_destructuring_does_not_admit_other_targets_or_keyword_tokens() -> Bool:
	var correct = True
	for target in ["(a)", "((a, b))", "((a, b), c)", "(a: Int, b)", "(a, 1)", "(a,)", "(a, b, c, d, e)", "(alias, b)", "(debug, b)", "(with, b)", "(concurrent, b)", "(select, b)"]:
		text = source_lines(["func f():", "\t" + target + " = pair"])
		match (scanned(text), new_parse_state(lex_module(module_id_at_row(0), text))):
			(Some((state, scan)), Ok(entry)):
				(plain, _) = parse_declaration_preview(entry)
				correct = (correct and completed_count(scan) == 0 and deferred_count(scan) == 1
					and state.position() == plain.position() and state.id_counts() == plain.id_counts()
					and state.diagnostic_count() == plain.diagnostic_count()
					and spelling_count(state.spellings()) == spelling_count(plain.spellings()))
			_: correct = False
	correct and tuple_keyword_routing() and completed_dump(source_lines(["func f():", "\t(a, b)"])).is_some()


-- Reserved keywords enter the binder refusal at their token. Soft keywords
-- keep the existing unsupported expression-name classification.
private pure func tuple_keyword_routing() -> Bool:
	var correct = True
	for (target, reason, start, end) in [("(alias, b)", TupleDestructuring, 12, 17), ("(debug, b)", SoftKeywordName, 12, 17), ("from", AssignmentTargetRoutedElsewhere, 16, 17)]:
		match scanned(source_lines(["func f():", "\t" + target + " = pair"])):
			Some((state, scan)):
				match scan.stop:
					StoppedAtUnreadDeclaration(unread):
						correct = (correct and unread.stop.reason == reason
							and unread.stop.at.span_start() == start and unread.stop.at.span_end() == end
							and state.diagnostic_count() == 0 and state.id_counts() == [0, 0, 0, 0, 0, 0, 0, 0, 0])
					_: correct = False
			None: correct = False
	correct


func test_tuple_destructuring_with_unread_value_rolls_back_binders_and_spellings() -> Bool:
	var correct = True
	for body in [
		["\t(fresh, other) =", "\t\tvalue", "\t\tother"],
		["\t(fresh, other) = f("],
		["\t(fresh, other) = into_opaque(value)"],
		["\tprevious = 1", "\t(fresh, other) = value extra"]
	]:
		text = source_lines(["func f():"].concat(body))
		match (scanned(text), new_parse_state(lex_module(module_id_at_row(0), text))):
			(Some((state, scan)), Ok(entry)):
				(plain, _) = parse_declaration_preview(entry)
				correct = (correct and completed_count(scan) == 0 and deferred_count(scan) == 1
					and state.position() == plain.position() and state.id_counts() == plain.id_counts()
					and state.diagnostic_count() == plain.diagnostic_count()
					and spelling_count(state.spellings()) == spelling_count(plain.spellings()))
			_: correct = False
	correct


-- Only the terminal ungrouped subscript is a place. The census detects an
-- extra Subscript expression id even when its AST is discarded afterward.
func test_only_the_outer_terminal_subscript_is_an_assignment_place() -> Bool:
	var correct = True
	for target in ["xs[i]", "make()[i]", "xs[i][j]", "(xs)[i]", "f(xs[i])[j]"]:
		correct = correct and completed_dump(source_lines(["func f():", "\t" + target + " = value"])).is_some()
	for (target, reason) in [
		("(xs[i])", NonPlaceAssignmentTarget),
		("((xs[i], ys[j]))", NonPlaceAssignmentTarget),
		("(xs[i], ys[j])", TupleDestructuring),
		("xs[i].field", FieldAssignment),
		("xs[i] + ys[j]", NonPlaceAssignmentTarget),
		("first + ys[j]", NonPlaceAssignmentTarget),
		("-xs[i]", NonPlaceAssignmentTarget),
		("not xs[i]", NonPlaceAssignmentTarget),
		("f(xs[i])", NonPlaceAssignmentTarget),
	]:
		match scanned(source_lines(["func f():", "\t" + target + " = value"])):
			Some((state, scan)):
				counts = state.issued_counts()
				correct = (correct and completed_count(scan) == 0 and deferred_count(scan) == 1
					and state.position() == 5 and state.diagnostic_count() == 0 and counts.expressions == 0 and counts.statements == 0)
				match scan.stop:
					StoppedAtUnreadDeclaration(unread):
						correct = (correct and unread.stop.reason == reason
							and unread.stop.at.span_start() == 12 + target.length()
							and unread.stop.at.span_end() == 13 + target.length())
					_: correct = False
			None: correct = False
	correct and nested_subscript_place_ids()


private pure func nested_subscript_place_ids() -> Bool:
	match scanned(source_lines(["func f():", "\txs[i][j] = value"])):
		Some((state, scan)):
			match scan.items:
				[FunctionItem(function)]:
					match function.function.body:
						Some(BlockBody(block)):
							match block.last.kind:
								SubscriptAssignment(assignment):
									match assignment.place.collection.kind:
										Subscript(collection, indices):
											(state.id_counts() == [1, 1, 6, 0, 0, 0, 4, 0, 0]
												and collection.id.expression_local_index() == 0
												and indices.first.id.expression_local_index() == 1
												and assignment.place.collection.id.expression_local_index() == 2
												and assignment.place.indices.first.id.expression_local_index() == 3
												and assignment.place.id.expression_local_index() == 4
												and assignment.value.id.expression_local_index() == 5
												and block.last.id.statement_local_index() == 0 and block.id.block_local_index() == 0
												and id_census(module_id_at_row(0), completed_module(state, scan)).is_empty())
										_: False
								_: False
						_: False
				_: False
		None: False


func test_grouped_thread_counts_issue_no_expression_ids() -> Bool:
	var correct = True
	for count in ["2", "((2))"]:
		text = source_lines(["func f():", "\tconcurrent(max_threads: " + count + ", timeout: delay):", "\t\twork()"])
		match scanned(text):
			Some((state, scan)):
				correct = (correct and completed_count(scan) == 1 and deferred_count(scan) == 0
					and state.id_counts() == [2, 2, 4, 0, 0, 0, 2, 0, 0]
					and id_census(module_id_at_row(0), completed_module(state, scan)).is_empty())
			None: correct = False
	correct



private pure func completed_count(scan: ModuleDeclarationScan) -> Int:
	scan.items
		.filter(pure func(item):
			match item:
				FunctionItem(_): True
				_: False
		)
		.length()


private pure func completed_owner_count(scan: ModuleDeclarationScan) -> Int:
	scan.items
		.filter(pure func(item):
			match item:
				TraitItem(_) | ImplementationItem(_): True
				_: False
		)
		.length()


-- 1 when the scan stopped at a trait or implementation it did not read.
private pure func deferred_owner_count(scan: ModuleDeclarationScan) -> Int:
	match scan.stop:
		StoppedAtUnreadDeclaration(unread):
			match unread.header:
				UnreadTrait(_) | UnreadImplementation(_): 1
				_: 0
		_:
			0


-- 1 when the scan stopped at a function whose body it did not read.
private pure func deferred_count(scan: ModuleDeclarationScan) -> Int:
	match scan.stop:
		StoppedAtUnreadDeclaration(unread):
			match unread.header:
				UnreadFunction(_): 1
				_: 0
		_:
			0


private pure func id_counts(state: ParseState) -> List[Int]:
	counts = state.issued_counts()
	[counts.statements, counts.blocks, counts.expressions, counts.patterns, counts.written_types,
		counts.dimensions, counts.name_uses, counts.binders, counts.type_binders]


func test_ids_follow_source_order_and_the_function_comes_last() -> Bool:
	text = source_lines(["func f(x: Int) -> Int:", "\ty = x + 1", "\ty * 2"])
	match scanned(text):
		Some((state, scan)):
			completed_module(state, scan).dumped_module(spellings(state)) == joined_lines([
				"(module",
				"  (function def0 public @0..40 (signature impure @0..4 \"f\"@5..6 (parameters (parameter @7..13 bind0:\"x\"@7..8 (named-type type0 @10..13 use0:\"Int\"@10..13))) (named-type type1 @18..21 use1:\"Int\"@18..21)) (type-parameters) (where) (block block0 @24..40",
				"    (assignment stmt0 @24..33 use2:\"y\"@24..25 (binary expr2 @28..33 add (name expr0 @28..29 use3:\"x\"@28..29) (integer expr1 @32..33 1)))",
				"    (expression-statement stmt1 @35..40 (binary expr5 @35..40 multiply (name expr3 @35..36 use4:\"y\"@35..36) (integer expr4 @39..40 2))))))"
			])
		None: False


func test_function_body_is_complete_syntax_with_an_exact_census() -> Bool:
	text = source_lines([
		"func g(xs: List[Int]) -> Int:",
		"\tvar total: Int = 0",
		"\tfor x in xs:",
		"\t\tif x < 0:",
		"\t\t\tcontinue",
		"\t\telse:",
		"\t\t\ttotal += x",
		"\twhile total > 100:",
		"\t\ttotal -= 1",
		"\txs[0] = total",
		"\tmatch total:",
		"\t\t0: total",
		"\t\tSome(v):",
		"\t\t\tv + 1",
		"\t\t_: 0",
		"\ttotal"
	])
	match scanned(text):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			completed_count(scan) == 1 and deferred_count(scan) == 0 and state.diagnostic_count() == 0 and id_census(module_id_at_row(0), syntax).is_empty() and syntax.definitions.length() == 1
		None: False


func test_leading_dot_chains_preserve_siblings_and_owner_boundaries() -> Bool:
	var correct = True
	for tail in ["", " == 0", " == 0 or ready"]:
		text = source_lines([
			"func f():", "\tx = values", "\t\t.map(func(item): item)", "\t\t.length()${tail}",
			"\tprint(x)", "\tx", "func g(): 1"
		])
		match scanned(text):
			Some((state, scan)):
				syntax = completed_module(state, scan)
				correct = (correct and completed_count(scan) == 2 and deferred_count(scan) == 0 and state.diagnostic_count() == 0
					and id_census(module_id_at_row(0), syntax).is_empty() and state.issued_counts().statements == 3
					and definition_names(syntax, spellings(state)) == [Some("f"), Some("g")])
			None: correct = False
	correct


func test_closed_chains_preserve_unary_siblings_and_nested_levels() -> Bool:
	var correct = True
	for sibling in ["-other", "not other", "(other)"]:
		correct = correct and true_if_completed(source_lines([
			"func f():", "\tx = values", "\t\t.first()", "\t\t\t.second()", "\t\t.third()", "\t${sibling}", "\tx"
		]))
	correct


func test_long_continuation_chain_has_an_exact_census() -> Bool:
	links = 256
	var lines = ["func f():", "\tvalues"]
	var index = 0
	while index < links:
		lines = lines.append("\t\t.step()")
		index += 1
	lines = lines.append("\t0")
	match scanned(source_lines(lines)):
		Some((state, scan)):
			(completed_count(scan) == 1 and deferred_count(scan) == 0 and state.diagnostic_count() == 0
				and state.issued_counts().expressions == links * 2 + 2 and state.issued_counts().statements == 2
				and id_census(module_id_at_row(0), completed_module(state, scan)).is_empty())
		None: False


-- Each shape is read in full by the frozen grammar or reported by it; this
-- slice leaves it to a later one. The scan keeps the skipped-body preview and
-- every id of the whole body is rolled back, even those minted by statements
-- the slice does support before the unsupported one.
func test_unsupported_bodies_roll_back_exactly() -> Bool:
	var correct: Bool = True
	for body in [
		["\tfor x in xs:", "\t\ty ?= f(x)"],
		["\tfor x in xs:", "\t\tif x:", "\t\t\ty: Int ?= f(x)"],
		["\ta = 1", "\t(b, c[0]) = pair"],
		["\t_ ?= f()"],
		["\tfor (k) in pairs:", "\t\tk"],
		["\tfor (a, b, c, d, e) in rows:", "\t\ta"],
		["\tfor (a, b in pairs:", "\t\ta"],
		["\tfor (a, 1) in pairs:", "\t\ta"],
		["\t(a, b[0]) = pair"],
		["\tx =", "\t\t1", "\t\t2"],
		["\tx =", "\t1"],
		["\tx =", "\t\t|first " + hole("a") + " second " + hole("b c")],
		["\twhile", "\t\tflag:", "\t\t1"],
		["\twith resource =", "\t\tacquire():", "\t\t1"],
		["\tx =", "\t\tif flag:", "\t\t1", "\t\telse:", "\t\t2"],
		["\tvalue = if flag: 1 else: 2"],
		["\tvalue = 1 + if flag:", "\t\t1", "\telse:", "\t\t2", "\tas Int"],
		["\tvalue = if flag:", "\t\t1", "\telse:", "\t\t2", "\tand other"],
		["\tvalue = 1 + if flag:", "\t\t1", "\telse:", "\t\t2", "\t.map(f)"],
		["\tvalue = match flag:", "\t\t_: 1", "\t.map(f)"],
		["\tvalue = [if flag:", "\t\t1", "\telse:", "\t\t2", "\t]"],
		["\tvalue = if flag:", "\t\t1", "\telse:", "\t\t2", "\tas Int"],
		["\tvalue = match flag:", "\t\t_: 1", "\tas Int"],
		["\tvalue = (if flag:", "\t\t1", "\telse:", "\t\t2)"],
		["\tvalue = if flag:", "\t\t1", "\telse:", "\t\t2", "\t.map(f)"],
		["\tvalue = if flag:", "\t\t1", "\telse if", "\t\t2"],
		-- A comma on a block's last line belongs to that statement, which the frozen
		-- grammar rejects; a block no deeper than the bracket of its list fails the
		-- bracketed-block anchor (`block_may_open`).
		["\tvalue = f(1,", "\t\tfunc(x: Int) -> Int:", "\t\t\tx,", "\t\t2)"],
		["\tvalue = [if flag:", "\t\t\t1", "\t\telse:", "\t\t\t2]"],
		["\tvalue = if flag:", "\t\t1", "\telse:", "\t\t2", "\t.map(f)"],
		["\tfor (k, v) in pairs concurrently(limit: 2):", "\t\tk"],
		["\tbreak"],
		["\tcontinue"],
		["\tx = values", "\t\t.method()", "\t\tunrelated"],
		["\tx = -values", "\t\t.length() + 1", "\tx"],
		["\tx = values", "\t\t.length() .. 10", "\tx"],
		["\tx = values", "\t\t.first()", "\t\t\t.second() + 1", "\tx"],
		["\tif text", "\t\t.trim()", "\t\t.is_empty():", "\t\treport()"],
		["\tmatch x:", "\t\t1: 2", "\tmatch y:", "\t\t_: 3", "\tas Int"],
		["\tx: Int", "\ty"],
		["\tif a:", "\t\tb", "\telse", "\t\tc"],
		["\tp.x = 1"],
		["\tvalue = \"" + hole("a b") + "\""],
		["\tvalue = \"" + hole("") + "\""],
		["\tvalue = \"" + hole("first") + " and " + hole("second third") + "\""],
		["\tf = func(x):", "\t\t(a, b[0]) = x"],
		["\ta = 1", "\tfunc helper(x: Int) -> Int:", "\t\t(a, b[0]) = x"],
		["\tfunc helper(x: Int) -> Int"],
		["\tf = func(x: Int, y): x", "\tg = func(z): (a, b[0]) = z"],
		["\tfor x in xs:", "\t\tf = func(): break"],
		-- A type and a pattern parsed to find their ends issue no ids that survive.
		["\tcount: Int = 1", "\tmatch count:", "\t\tSome(inner): inner", "\t(flag, other[0]) = pair"]
	]:
		text = source_lines(["func f() -> Int:"].concat(body))
		match (scanned(text), new_parse_state(lex_module(module_id_at_row(0), text))):
			(Some((state, scan)), Ok(entry)):
				(plain, _) = parse_declaration_preview(entry)
				same_ids: Bool = id_counts(state) == id_counts(plain)
				if completed_count(scan) != 0 or deferred_count(scan) != 1 or not same_ids:
					print("not rolled back: ${body}")
					correct = False
			_: correct = False
	correct


-- Comment indentation is layout evidence, but there is no supported statement
-- to mint. Decline the body without diagnosing the old parser's accepted input.
func test_comment_only_body_stops_without_diagnostics_or_body_ids() -> Bool:
	text = "func f():\n\t-- comment\n"
	match scanned(text):
		Some((state, scan)):
			match scan.stop:
				StoppedAtUnreadDeclaration(unread):
					match unread.header:
						UnreadFunction(_):
							counts = state.issued_counts()
							(completed_count(scan) == 0 and state.diagnostic_count() == 0
								and unread.stop.reason == BlockNotClosed and unread.stop.at.span_start() == 22 and unread.stop.at.span_end() == 22
								and state.position() == 5 and counts.blocks == 0 and counts.statements == 0 and counts.expressions == 0 and counts.patterns == 0)
						_: False
				_: False
		None: False


-- Comment indentation opens a list but contributes no case or arm. Its
-- closing dedent reports the empty list, and every attempted child rolls back.
func test_comment_only_match_and_select_lists_restore_function_header() -> Bool:
	var correct = True
	for (header, reason) in [("match subject:", MatchNotClosed), ("select:", SelectNotClosed)]:
		text = source_lines(["func f():", "\t" + header, "\t\t-- comment"])
		match (scanned(text), new_parse_state(lex_module(module_id_at_row(0), text))):
			(Some((state, scan)), Ok(entry)):
				(plain, _) = parse_declaration_preview(entry)
				match scan.stop:
					StoppedAtUnreadDeclaration(unread):
						correct = (correct and completed_count(scan) == 0 and deferred_count(scan) == 1
							and unread.stop.reason == reason and unread.stop.at.span_start() == text.length() and unread.stop.at.span_end() == text.length()
							and state.position() == plain.position() and state.current_kind() == plain.current_kind()
							and state.current_span().span_start() == plain.current_span().span_start()
							and state.current_span().span_end() == plain.current_span().span_end() and state.issued_counts() == plain.issued_counts()
							and state.spellings().spelling_count() == plain.spellings().spelling_count() and state.diagnostic_count() == 0)
					_: correct = False
			_: correct = False
	correct


-- A written type and a pattern are read once to find where they end and again
-- when minted, so their ids and the name uses inside them follow the
-- expressions written before them, not the whole body's.
func test_types_and_patterns_are_minted_in_source_order() -> Bool:
	text = source_lines([
		"func f(v: Int) -> Int:",
		"\tcount: Int = v",
		"\tmatch v:",
		"\t\tSome(inner): inner",
		"\t\t_: count"
	])
	match scanned(text):
		Some((state, scan)):
			dumped = completed_module(state, scan).dumped_module(spellings(state))
			-- Header: `Int` twice (uses 0, 1). Body: the binding's `Int` (2), `v` (3),
			-- the scrutinee `v` (4), `Some` (5), `inner` (6), then the case bodies (7, 8).
			-- The replay of each type and pattern reports nothing.
			state.diagnostic_count() == 0 and dumped.split("use2:\"Int\"").length() == 2 and dumped.split("use3:\"v\"").length() == 2 and dumped.split("use4:\"v\"").length() == 2 and dumped.split("(constructor-pattern pat1 @").length() == 2 and dumped.split("use5:\"Some\"").length() == 2 and dumped.split("use6:\"inner\"").length() == 2 and dumped.split("use7:\"inner\"").length() == 2
		None: False


-- A hole's value is minted before the hole, and the string after all of them;
-- the hole's own id is an expression id.
func test_interpolation_holes_are_minted_in_source_order() -> Bool:
	text = source_lines(["func f(a: Int, b: Int):", "\t\"x " + hole("a") + " y " + hole("b + 1") + "\""])
	match scanned(text):
		Some((state, scan)):
			dumped = completed_module(state, scan).dumped_module(spellings(state))
			counts = state.issued_counts()
			completed_count(scan) == 1 and state.diagnostic_count() == 0 and counts.expressions == 7 and dumped.split("(hole expr1 ").length() == 2 and dumped.split("(name expr2 ").length() == 2 and dumped.split("(hole expr5 ").length() == 2 and dumped.split("(interpolated expr6 ").length() == 2
		None: False


-- Each method is read header, body, definition, in turn; the owner is last.
func test_owner_methods_are_minted_in_source_order() -> Bool:
	text = source_lines([
		"trait Shape:",
		"\tfunc first(x: Int) -> Int:",
		"\t\tx",
		"\tfunc second(y: Int) -> Int",
		"\tfunc third(z: Int) -> Int: z",
		"implements Shape for Int:",
		"\tfunc first(x: Int) -> Int: x",
		"\tfunc second(y: Int) -> Int: y"
	])
	match scanned(text):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			dumped = syntax.dumped_module(spellings(state))
			-- Definitions: three trait methods then the trait, two implementation
			-- methods then the implementation.
			completed_owner_count(scan) == 2 and deferred_owner_count(scan) == 0 and state.diagnostic_count() == 0 and id_census(module_id_at_row(0), syntax).is_empty() and syntax.definitions.length() == 7 and dumped.split("(trait def3 ").length() == 2 and dumped.split("(implementation def6 ").length() == 2 and dumped.split("(trait-method def0 ").length() == 2 and dumped.split("(trait-method def2 ").length() == 2
		None: False


-- One body outside the slice stops the scan at its owner, and every id the
-- owner's methods minted before that body is rolled back: only the owner
-- header's ids remain (`implements Shape for Int` holds two name uses and one
-- written type; `trait Shape` none), and no definition.
func test_owner_with_an_unsupported_body_keeps_only_its_header_ids() -> Bool:
	var correct: Bool = True
	for (text, header_ids) in [
		(source_lines(["trait Shape:", "\tfunc first(x: Int) -> Int: x", "\tfunc second(y: Int) -> Int:", "\t\t(a, b[0]) = y"]), [0, 0, 0, 0, 0, 0, 0, 0, 0]),
		(source_lines(["implements Shape for Int:", "\tfunc first(x: Int) -> Int: x", "\tfunc second(y: Int) -> Int:", "\t\t(a, b[0]) = y"]), [0, 0, 0, 0, 1, 0, 2, 0, 0]),
	]:
		match scanned(text):
			Some((state, scan)):
				if completed_owner_count(scan) != 0 or deferred_owner_count(scan) != 1 or id_counts(state) != header_ids or issued_ids(state).definitions.length() != 0 or state.diagnostic_count() != 0:
					print("owner not rolled back: ${text}")
					correct = False
			None: correct = False
	correct


-- The name each definition of the module was written with, by definition id.
private pure func definition_names(syntax: ModuleSyntax, written: Spellings) -> List[Option[String]]:
	syntax.definitions.map(pure func(definition):
		match definition:
			LocalFunctionDefinition(local): written.spelling_text(local.function.signature.name.spelling)
			FunctionDefinition(function): written.spelling_text(function.function.signature.name.spelling)
			_: None
	)


-- A local function is minted after everything declared inside it, so its
-- definition id sits before its enclosing function's; a lambda owns its
-- parameters' ids and its body's, in that order.
func test_lambda_and_local_function_ids_follow_source_order() -> Bool:
	text = source_lines([
		"func f(a: Int) -> Int:",
		"\tg = func(x: Int) -> Int: x + a",
		"\tfunc local(y: Int) -> Int:",
		"\t\tfunc inner(z: Int) -> Int: z",
		"\t\tinner(y)",
		"\tg(local(1))"
	])
	match scanned(text):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			completed_count(scan) == 1 and state.diagnostic_count() == 0 and id_census(module_id_at_row(0), syntax).is_empty() and definition_names(syntax, spellings(state)) == [Some("inner"), Some("local"), Some("f")]
		None: False


-- Nested lambdas are right nesting: depth in the source is depth in the
-- parser, the minting, the dump and the census, but no walk follows a chain's
-- length with a frame per link beyond that.
func test_nested_lambdas_survive_parse_dump_and_census() -> Bool:
	depth = NESTED_LAMBDA_DEPTH
	var text: String = "func f() -> Int: "
	var level: Int = 0
	while level < depth:
		text += "func(a${level}): "
		level += 1
	text += "a0\n"
	match scanned(text):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			dumped = syntax.dumped_module(spellings(state))
			completed_count(scan) == 1 and state.diagnostic_count() == 0 and id_census(module_id_at_row(0), syntax).is_empty() and state.issued_counts().expressions == depth + 1 and dumped.split("(lambda expr").length() == depth + 1
		None: False


-- A chain of expression-bodied lambdas as long as the nesting limit allows
-- (section 3.14): `test_syntax_nesting` proves each form at the limit, and this
-- case also checks the whole chain's ids and shape.
NESTED_LAMBDA_DEPTH: Int = MAX_SYNTAX_NESTING


func test_break_and_continue_are_supported_only_inside_loops() -> Bool:
	inside = source_lines(["func f(xs: List[Int]):", "\tfor x in xs:", "\t\tif x:", "\t\t\tbreak", "\t\tcontinue", "\tvoid"])
	match scanned(inside):
		Some((state, scan)): completed_count(scan) == 1 and state.diagnostic_count() == 0
		None: False


-- The expression ids of a function's final `if` and of the `else if`s after
-- it, in chain order.
private pure func chain_expression_ids(function: FunctionDeclaration) -> Option[(Int, List[Int])]:
	match function.function.body:
		Some(BlockBody(block)):
			match block.last.kind:
				ExpressionStatement(outer):
					match outer.kind:
						If(first):
							var ids: List[Int] = []
							var branch: Option[ElseBranch] = first.else_branch
							while branch.is_some():
								match branch:
									Some(written):
										match written.body:
											ElseIf(else_if):
												ids = ids.append(else_if.id.expression_local_index())
												branch = else_if.conditional.else_branch
											_:
												branch = None
									None:
										branch = None
							Some((outer.id.expression_local_index(), ids))
						_:
							None
				_:
					None
		_:
			None


func test_else_if_chain_mints_inner_links_before_outer_ones() -> Bool:
	text = source_lines([
		"func f(a: Int) -> Int:",
		"\tif a:",
		"\t\t1",
		"\telse if a:",
		"\t\t2",
		"\telse if a:",
		"\t\t3",
		"\telse:",
		"\t\t4"
	])
	match scanned(text):
		Some((state, scan)):
			match scan.items.get(0):
				Some(FunctionItem(function)):
					-- Source order: every condition and block, then the `else if`s
					-- from the innermost out, then the outermost `if`.
					expressions = state.issued_counts().expressions
					chain_expression_ids(function) == Some((expressions - 1, [expressions - 2, expressions - 3]))
				_: False
		None: False


-- The scan stops at a function whose body it does not read: that function
-- mints no body and no definition, and the function after it is not read.
-- The function before it keeps its own ids.
func test_scan_stops_at_a_deferred_function() -> Bool:
	text = source_lines([
		"func first() -> Int:",
		"\tc = 2",
		"\tc",
		"func second() -> Int:",
		"\ta = 1",
		"\t(b, c[0]) = pair",
		"func third() -> Int:",
		"\td = 3",
		"\td"
	])
	match scanned(text):
		Some((state, scan)):
			counts = state.issued_counts()
			completed_count(scan) == 1 and deferred_count(scan) == 1 and state.diagnostic_count() == 0 and counts.statements == 2 and counts.blocks == 1 and counts.expressions == 2 and issued_ids(state).definitions.length() == 1
		None: False


func test_long_statement_list_is_read_and_minted_by_loops() -> Bool:
	count = 5000
	var lines: List[String] = ["func f() -> Int:"]
	var written: Int = 0
	while written < count:
		lines = lines.append("\tvalue${written} = ${written}")
		written += 1
	lines = lines.append("\tvalue0")
	match scanned(source_lines(lines)):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			counts = state.issued_counts()
			completed_count(scan) == 1 and counts.statements == count + 1 and counts.blocks == 1 and id_census(module_id_at_row(0), syntax).is_empty()
		None: False


func test_deep_else_if_chain_survives_parse_dump_and_census() -> Bool:
	links = 2000
	var lines: List[String] = ["func f(a: Int) -> Int:", "\tif a:", "\t\t0"]
	var written: Int = 1
	while written < links:
		lines = lines.append("\telse if a:")
		lines = lines.append("\t\t${written}")
		written += 1
	lines = lines.append("\telse:")
	lines = lines.append("\t\t${links}")
	match scanned(source_lines(lines)):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			dumped = dumped_module(syntax, spellings(state))
			counts = state.issued_counts()
			-- One block per `if`, `else if` and `else` arm, and the function's own.
			completed_count(scan) == 1 and id_census(module_id_at_row(0), syntax).is_empty() and counts.blocks == links + 2 and dumped.split("(else-if expr").length() == links
		None: False


-- A control expression is an operand wherever the frozen grammar reads one at
-- the end of a line: a statement's value, the right operand of an operator, a
-- unary operand and an expression statement's right end. Both sides are
-- pinned: those shapes complete; a postfix tail after a block stays deferred.
-- Binary continuations have their separate precedence and rollback probes.
func test_control_expression_operands_complete_and_their_continuations_defer() -> Bool:
	accepted = source_lines([
		"func f(a: Int) -> Int:",
		"\tx = if a:",
		"\t\t1",
		"\telse if a:",
		"\t\t2",
		"\telse:",
		"\t\t3",
		"\tvar y: Int = match x:",
		"\t\t0: 1",
		"\t\t_: 2",
		"\tx += if a:",
		"\t\ty",
		"\tz = 1 + if a:",
		"\t\t1",
		"\telse:",
		"\t\t2",
		"\tw = -match z:",
		"\t\t_: 1",
		"\tz == 1 and match w:",
		"\t\t_: True",
		"\tx"
	])
	deferred = source_lines(["func f(a: Int) -> Int:", "\tx = if a:", "\t\t1", "\telse:", "\t\t2", "\t.tail()", "\tx"])
	global_operand = source_lines(["g = 1 + if a:", "\t1", "else:", "\t2", "", "record Later {}"])
	global_value = source_lines(["h = match a:", "\t_: 1"])
	one_line_body = source_lines(["func k(a: Int) -> Int: match a:", "\t_: 1"])
	one_line_lambda_body = source_lines(["func m() -> (Int) -> Int: func(x: Int) -> Int:", "\tx + 1"])
	var correct: Bool = true_if_completed(accepted) and not true_if_completed(deferred)
	for text in [global_operand, global_value]:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(state, scan) = scan_module_declarations(entry)
				correct = correct and not scan.items.is_empty() and state.diagnostic_count() == 0
			Err(_): correct = False
	-- The frozen grammar rejects a block after a same-line body; the new one
	-- must not accept what it rejects.
	match scanned(one_line_body):
		Some((_, scan)): correct = correct and completed_count(scan) == 0
		None: correct = False
	match scanned(one_line_lambda_body):
		Some((_, scan)): correct = correct and completed_count(scan) == 0
		None: correct = False
	correct


-- Block dedents close postfix chains, but the frozen operator loop keeps
-- reading controls as operands without counting a flat chain as nesting.
func test_long_control_operator_chain_survives_dump_and_census() -> Bool:
	links = 256
	var lines: List[String] = ["func f(c: Int):", "\t(match c:", "\t\t_: True"]
	var index = 1
	while index < links:
		lines = lines.append("\tand match c:")
		lines = lines.append("\t\t_: True")
		index += 1
	lines = lines.append("\t)")
	lines = lines.append("\tfollowing(c)")
	match completed_dump(source_lines(lines)):
		Some(dumped): dumped.split("(match expr").length() == links + 1
		None: False


func test_control_operator_tail_rollback_preserves_entry() -> Bool:
	var correct = True
	for tail in ["\t+ [1, 2] unexpected", "\tas Int", "\t= value", "\t.tail()"]:
		text = source_lines(["func f(c: Int):", "\tmatch c:", "\t\t_: 1", tail])
		match scanned(text):
			Some((state, scan)):
				counts = state.issued_counts()
				correct = (correct and completed_count(scan) == 0 and deferred_count(scan) == 1
					and state.position() == 8 and state.diagnostic_count() == 0 and counts.expressions == 0 and counts.statements == 0)
			None: correct = False
	correct


func test_standalone_control_operator_tail_rollback_preserves_entry() -> Bool:
	var correct = True
	for tail in ["+ [1, 2] unexpected", "as Int", "= value"]:
		text = source_lines(["match c:", "\t_: 1", tail])
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(state, parsed) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
				match parsed:
					UnsupportedExpression(_):
						correct = (correct and state.position() == entry.position() and state.issued_counts() == entry.issued_counts()
							and state.spellings().spelling_count() == entry.spellings().spelling_count() and state.diagnostic_count() == entry.diagnostic_count())
					_: correct = False
			Err(_): correct = False
	correct


private pure func true_if_completed(text: String) -> Bool:
	match scanned(text):
		Some((state, scan)):
			completed_count(scan) == 1 and deferred_count(scan) == 0 and state.diagnostic_count() == 0 and id_census(module_id_at_row(0), completed_module(state, scan)).is_empty()
		None: False


-- A value `if` mints its condition, its blocks' statements, then itself, and
-- the assignment that owns it after all of them. Swapping any two would lower
-- an owner's index below a child's.
func test_control_value_ids_follow_source_order() -> Bool:
	text = source_lines(["func f(a: Int) -> Int:", "\tx = if a:", "\t\t1", "\telse:", "\t\t2", "\tx"])
	match scanned(text):
		Some((state, scan)):
			match scan.items.get(0):
				Some(FunctionItem(function)):
					match function.function.body:
						Some(BlockBody(block)):
							match block.leading.get(0):
								Some(assignment_statement):
									match assignment_statement.kind:
										Assignment(assignment):
											match assignment.value.kind:
												If(conditional):
													match conditional.else_branch:
														Some(branch):
															match branch.body:
																ElseBlock(else_block):
																	assignment_index = assignment_statement.id.statement_local_index()
																	(conditional.condition.id.expression_local_index() < assignment.value.id.expression_local_index() and conditional.then_block.last.id.statement_local_index() < else_block.last.id.statement_local_index() and else_block.last.id.statement_local_index() < assignment_index and conditional.then_block.id.block_local_index() < else_block.id.block_local_index() and id_census(module_id_at_row(0), completed_module(state, scan)).is_empty())
																_: False
														None: False
												_: False
										_: False
								None: False
						_: False
				_: False
		None: False


-- Value `if`s nest by indentation, one level per line.
func test_deeply_nested_value_ifs_survive_parse_dump_and_census() -> Bool:
	depth = 100
	var lines: List[String] = ["func f(a: Int) -> Int:"]
	var level: Int = 0
	while level < depth:
		lines = lines.append("\t".repeat(level + 1) + "v${level} = if a:")
		level += 1
	lines = lines.append("\t".repeat(depth + 1) + "1")
	match scanned(source_lines(lines)):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			dumped = dumped_module(syntax, spellings(state))
			completed_count(scan) == 1 and id_census(module_id_at_row(0), syntax).is_empty() and dumped.split("(if expr").length() == depth + 1
		None: False


