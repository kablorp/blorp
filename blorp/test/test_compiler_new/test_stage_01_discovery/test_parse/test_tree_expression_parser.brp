						shape = match (value.kind, form):
							(RecordLiteral(_), 0): True
							(RecordUpdate(_, _), 1): True
							(DictLiteral(_), 2): True
							(VectorLiteral(_), 3): True
							_: False
						correct = correct and shape and parsed.diagnostic_count() == 0
					_: correct = False
			Err(_): correct = False
	correct


-- A field's name use is issued before its value, a record update's base
-- before its fields, and a dict entry's key before its value.
pure func test_braced_source_order_and_spans() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "{base | first = x, second = 1,}")):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					match value.kind:
						RecordUpdate(base, [first, second]):
							(base.id.expression_local_index() == 0 and first.name.use.name_use_local_index() == 1
								and first.value.id.expression_local_index() == 1 and second.name.use.name_use_local_index() == 3
								and second.value.id.expression_local_index() == 2 and value.id.expression_local_index() == 3
								and first.span.span_start() == 8 and first.span.span_end() == 17
								and second.span.span_start() == 19 and second.span.span_end() == 29
								and value.span.span_start() == 0 and value.span.span_end() == 31
								and parsed.issued_counts().name_uses == 4 and parsed.diagnostic_count() == 0)
						_: False
				_: False
		Err(_): False


pure func test_dict_entries_issue_key_then_value() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "{k => v, 007 => [w],}")):
