private pure func id_counts(state: ParseState) -> List[Int]:
	counts = state.issued_counts()
	[counts.expressions, counts.name_uses, counts.statements, counts.blocks, counts.patterns,
		counts.written_types, counts.dimensions, counts.binders, counts.type_binders]


pure func test_precedence_and_postorder_ids() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "first + 007 * -last")):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					match value.kind:
						Binary(Add, first, product):
							match (first.kind, product.kind):
								(NameReference(first_use), Binary(Multiply, integer, negative)):
									match (integer.kind, negative.kind):
										(IntegerLiteral(magnitude), Unary(Negate, last)):
											match last.kind:
												NameReference(last_use):
													(first.id.expression_local_index() == 0 and integer.id.expression_local_index() == 1
														and last.id.expression_local_index() == 2 and negative.id.expression_local_index() == 3
														and product.id.expression_local_index() == 4 and value.id.expression_local_index() == 5
														and first_use.use.name_use_local_index() == 0 and last_use.use.name_use_local_index() == 1
														and magnitude.to_string() == "7" and parsed.issued_counts().expressions == 6
														and parsed.issued_counts().name_uses == 2 and parsed.diagnostic_count() == 0)
												_: False
										_: False
								_: False
						_: False
				_: False
		Err(_): False


pure func test_grouping_preserves_identity_and_name_token_span() -> Bool:
	var correct = True
	for text in ["((name))", "((007))"]:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
				match result:
					ParsedExpression(value):
						correct = correct and value.id.expression_local_index() == 0 and parsed.issued_counts().expressions == 1
						match value.kind:
							NameReference(use):
								correct = correct and value.span.spans_equal(use.name.span) and value.span.span_start() == 2 and value.span.span_end() == 6
							IntegerLiteral(magnitude):
								correct = correct and magnitude.to_string() == "7" and value.span.span_start() == 0 and value.span.span_end() == text.length()
							_: correct = False
					_: correct = False
			Err(_): correct = False
	correct


pure func test_logical_and_range_have_explicit_forms() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "a or b and 1..2")):
		Ok(entry):
			(_, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					match value.kind:
						ShortCircuit(LogicalOr, _, conjunction):
							match conjunction.kind:
								ShortCircuit(LogicalAnd, _, range):
									match range.kind:
										RangeExpression(_, _): True
										_: False
								_: False
						_: False
				_: False
		Err(_): False


-- `detach` is a prefix operator like `not`: it takes a whole postfix chain and
-- binds tighter than any binary operator, and its id follows its operand's.
pure func test_detach_is_a_prefix_operator_over_a_postfix_chain() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "detach first(x) + last")):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					match value.kind:
						Binary(Add, detached, last):
							match detached.kind:
								Detach(call):
									match call.kind:
										Call(_, _):
											-- first 0, x 1, the call 2, the detach 3, last 4, the sum 5.
											(call.id.expression_local_index() == 2 and detached.id.expression_local_index() == 3
												and last.id.expression_local_index() == 4 and value.id.expression_local_index() == 5
												and detached.span.span_start() == 0 and detached.span.span_end() == 15
												and parsed.issued_counts().expressions == 6 and parsed.diagnostic_count() == 0)
										_: False
								_: False
						_: False
				_: False
		Err(_): False


-- An interpolation hole, spelled without opening one in this file's own string.
pure func hole(text: String) -> String:
	"$" + "{" + text + "}"


pure func test_unsupported_returns_original_state() -> Bool:
	var correct = True
	for text in ["detach if x: 1 else: 2", "detach\n.field", "call(if True: 1 else: 2)", "name.field(1, if x: 1 else: 2)", "1\n.field", "1\n\t.field", "1 +\n 2", "not if x: 1 else: 2", "first + if x: 1 else: 2", "f(x)[if x: 1 else: 2]", "f(if True: 1 else: 2)", "f(x)\n.member", "target.member(1, if x: 1 else: 2)", "f(,x)", "f(x]",
		"[1 2]", "[,]", "[,1]", "[1,,2]", "[1, if x: 1 else: 2]", "[if x: 1 else: 2]", "[if True: 1 else: 2]", "[1)", "[1}", "[[1], if x: 1 else: 2]", "[1]\n.length()", "[1]\n\t.length()", 
		"{a = match x:\n\t_: 1\n}", "{1 => match x:\n\t_: 1\n}", "f(1 + [match x:\n\t_: 1\n])",
		"{a b}", "{a, b)", "{a => 1, b}", "{a => 1 b => 2}", "{a = 1, b}", "{a = 1 b = 2}", "{r | }", "{r | 1}", "{\na b\n}", "{\na = 1\nb = 2\n}", "{\nk => 1,\nw\n}", "{\nr |\n}", "{\na = 1\n} c", "{\n\na,\n\nb\n}\n.f", "{\na = if x:\n1\nelse:\n2\n}",
		"{a,", "{a, b,", "{a => 1,", "{k => v,", "{r | x}", "{on = 1}", "{r | on = 1}", "{k => v, w}", "{a = 1, b = }", "{x, if x: 1 else: 2}", "{a = if x: 1 else: 2}", "{}\n.f", "{a, b}\n\t.f", "{a = 1} c", "{,}", "{a,, b}",
		"(a, b c)", "(a, if x: 1 else: 2)", "(a, b]", "(a,, b)", "(, a)", "(x,", "(a,", "(a, b,", "(a, b)\n.f", "(a, b)\n\t.f", "(a, if x: 1 else: 2)", "(a, if True: 1 else: 2)", "(a, b) c"].concat(
		-- A hole outside the grammar leaves the whole string unsupported, even after
		-- an earlier hole read and interned its names.
		["first + \"" + hole("a") + " " + hole("b c") + "\"", "\"" + hole("") + "\"", "[\"" + hole("a") + hole("if x: 1 else: 2") + "\"]", "\"" + hole("\\\"") + "\""]):
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
				match result:
					UnsupportedExpression(_):
						correct = (correct and parsed.position() == entry.position() and parsed.current_kind() == entry.current_kind()
							and parsed.current_span().spans_equal(entry.current_span()) and parsed.previous_span().spans_equal(entry.previous_span())
							and parsed.id_counts() == entry.id_counts() and parsed.diagnostic_count() == entry.diagnostic_count()
							and parsed.spellings().spelling_count() == entry.spellings().spelling_count())
						var spelling_index = 0
						while spelling_index < entry.spellings().spelling_count():
							correct = correct and parsed.spellings().spelling_text_at(spelling_index) == entry.spellings().spelling_text_at(spelling_index)
							spelling_index += 1
					_: correct = False
			Err(_): correct = False
	correct


private pure func form_name(form: StringForm) -> String:
	match form:
		QuotedString: "quoted"
		RawString: "raw"
		PipeString: "pipe"
		RawPipeString: "raw pipe"


-- The form and decoded text of the one string literal `text` is, or nothing.
private pure func string_literal_of(text: String) -> Option[(String, String)]:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					match value.kind:
						StringLiteral(form, decoded):
							if parsed.issued_counts().expressions == 1 and parsed.diagnostic_count() == 0 and value.span.span_end() == text.length():
								Some((form_name(form), decoded))
							else:
								None
						_: None
				_: None
		Err(_): None


private pure func character_literal_of(text: String) -> Option[Char]:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					match value.kind:
						CharacterLiteral(character):
							if parsed.issued_counts().expressions == 1 and parsed.diagnostic_count() == 0:
								Some(character)
							else:
								None
						_: None
				_: None
		Err(_): None


-- Every string token kind keeps its own form and its decoded text.
pure func test_string_literals_keep_their_form_and_text() -> Bool:
	plain: Bool = string_literal_of("\"plain\"") == Some(("quoted", "plain")) and string_literal_of("\"\"") == Some(("quoted", ""))
	escaped: Bool = string_literal_of("\"tab\\there \\\\ \\\" \\u{41}\"") == Some(("quoted", "tab\there \\ \" A"))
	multiline: Bool = string_literal_of("raw\"a\\nb\"") == Some(("raw", "a\\nb")) and string_literal_of("|one\n|two") == Some(("pipe", "one\ntwo")) and string_literal_of("raw\n|a\\b\n|c") == Some(("raw pipe", "a\\b\nc"))
	plain and escaped and multiline


pure func test_character_literals_decode_every_escape() -> Bool:
	simple: Bool = character_literal_of("'c'") == Some('c') and character_literal_of("'\\n'") == Some('\n') and character_literal_of("'\\\\'") == Some('\\')
	simple and character_literal_of("'\\''") == Some('\'') and character_literal_of("'\\u{41}'") == Some('A') and character_literal_of("'\\u{1F600}'") == Some(to_char(128512))


-- A pipe string with holes is multiline, and its pieces keep the line break.
pure func test_pipe_interpolation_is_multiline_with_text_around_its_holes() -> Bool:
	text = "|a " + hole("b") + "\n|c"
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					match value.kind:
						InterpolatedString(PipeInterpolation, [InterpolationText(first), InterpolationHole(_), InterpolationText(last)]):
							first == "a " and last == "\nc" and parsed.issued_counts().expressions == 3 and parsed.diagnostic_count() == 0
						_: False
				_: False
		Err(_): False


pure func test_string_and_character_literals_are_atoms() -> Bool:
	var correct = True
	for (text, expected) in [("\"plain\"", "string"), ("raw\"x\"", "string"), ("'c'", "char")]:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
				match result:
					ParsedExpression(value):
						kind_matches: Bool = match value.kind:
							StringLiteral(_, _): expected == "string"
							CharacterLiteral(_): expected == "char"
							_: False
						correct = correct and kind_matches and value.span.span_end() == text.length() and parsed.id_counts() == [1, 0, 0, 0, 0, 0, 0, 0, 0] and parsed.diagnostic_count() == 0
					_: correct = False
			Err(_): correct = False
	correct


pure func test_interpolated_string_holes_are_expressions_in_source_order() -> Bool:
	text = "\"x " + hole("a") + " y " + hole("b.c(1)") + "\""
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					match value.kind:
						InterpolatedString(QuotedInterpolation, [InterpolationText(first_text), InterpolationHole(first), InterpolationText(second_text), InterpolationHole(second)]):
							-- a, hole, b, c, 1, call, hole, then the string itself.
							(first_text == "x " and second_text == " y " and first.id.expression_local_index() == 1
								and second.id.expression_local_index() == 6 and value.id.expression_local_index() == 7
								and parsed.issued_counts().expressions == 8 and parsed.diagnostic_count() == 0)
						_: False
				_: False
		Err(_): False


pure func test_rejection_issues_no_ids() -> Bool:
	var correct = True
	for text in ["1 +", "(1", "1 + )"]:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
				match result:
					RejectedExpression:
						correct = correct and parsed.diagnostic_count() == 1 and parsed.id_counts() == entry.id_counts()
						match parsed.diagnostics().get(0):
							Some(at):
								match at.diagnostic:
									ExpectedToken(ExpectedRightParen(RightParenInGroupedExpression)):
										correct = correct and text == "(1" and at.span.span_start() == 2 and at.span.span_end() == 2
									Plain(ExpectedExpressionDiagnostic):
										offset = if text == "1 + )":
											4
										else:
											3
										correct = correct and text != "(1" and at.span.span_start() == offset and at.span.span_end() == offset
									_: correct = False
							None: correct = False
					_: correct = False
			Err(_): correct = False
	correct


pure func test_long_sum_is_left_associative_without_recursive_left_walk() -> Bool:
	var text = "1"
	var terms = 1
	while terms < 5000:
		text += " + 1"
		terms += 1
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					var left = value
					var additions = 0
					var walking = True
					var correct = parsed.issued_counts().expressions == terms * 2 - 1
					while walking:
						match left.kind:
							Binary(Add, next, right):
								match right.kind:
									IntegerLiteral(magnitude): correct = correct and magnitude.to_string() == "1"
									_: correct = False
								left = next
								additions += 1
							IntegerLiteral(magnitude):
								correct = correct and magnitude.to_string() == "1"
								walking = False
							_:
								correct = False
								walking = False
					correct and additions == terms - 1
				_: False
		Err(_): False


pure func test_postfix_source_order_and_spans() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "target.member(arg,)[index,]")):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					match value.kind:
						Subscript(call, indices):
							match call.kind:
								Call(field, args):
									match field.kind:
										FieldAccess(target, member):
											(target.id.expression_local_index() == 0 and member.use.name_use_local_index() == 1
												and field.id.expression_local_index() == 1 and call.id.expression_local_index() == 3
												and indices.first.id.expression_local_index() == 4 and value.id.expression_local_index() == 5
												and args.length() == 1 and indices.rest.is_empty()
												and value.span.span_start() == 0 and value.span.span_end() == 27
												and parsed.issued_counts().name_uses == 4 and parsed.diagnostic_count() == 0)
										_: False
								_: False
						_: False
				_: False
		Err(_): False


-- Rows: source, rendered message, rendered help, and the byte offset where
-- the empty diagnostic span sits (an unclosed delimiter reports at EOF).
pure func test_postfix_rejection_has_exact_diagnostic_and_no_ids() -> Bool:
	call_message = "expected `)` after call arguments"
	call_help = "close the parenthesis opened earlier with `)`"
	subscript_message = "expected `]` after subscript"
	subscript_help = "close the bracket opened earlier with `]`"
	cases = [
		("f(", call_message, call_help, 2),
		("f(1", call_message, call_help, 3),
		("f(1,", call_message, call_help, 4),
		("f[", subscript_message, subscript_help, 2),
		("f[1", subscript_message, subscript_help, 3),
		("f[]", "expected expression", "write a value, a name or a call here", 2),
		("f.", "expected field name", "write an identifier here; it starts with a letter or `_` and is not a reserved keyword", 2)
	]
	var correct = True
	for (text, message, help, offset) in cases:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
				match result:
					RejectedExpression:
						correct = correct and parsed.diagnostic_count() == 1 and parsed.id_counts() == entry.id_counts()
						match reject_preview(parsed):
							Ok(rejected):
								match render_rejected_diagnostics(rejected):
									Ok([row]):
										correct = (correct and row.rendered.message == message and row.rendered.help == Some(help)
											and row.line == 1 and row.column == offset + 1
											and row.span.span_start() == offset and row.span.span_end() == offset)
									_: correct = False
							Err(_): correct = False
					_: correct = False
			Err(_): correct = False
	correct


pure func test_long_postfix_chain() -> Bool:
	var text = "target"
	var count = 0
	while count < 2000:
		text += ".member()"
		count += 1
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					var current = value
					var calls = 0
					var walking = True
					while walking:
						match current.kind:
							Call(field, args):
								match field.kind:
									FieldAccess(receiver, _):
										current = receiver
										calls += 1
									_: walking = False
							_: walking = False
					calls == count and parsed.issued_counts().expressions == count * 2 + 1 and parsed.issued_counts().name_uses == count + 1
				_: False
		Err(_): False


-- Argument nesting is the one postfix recursion: it follows brackets the
-- source itself nests, as the frozen parser does.
pure func test_nested_call_arguments() -> Bool:
	depth = 1000
	var text = ""
	var level = 0
	while level < depth:
		text += "f("
		level += 1
	text += "1"
	while level > 0:
		text += ")"
		level -= 1
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					var current = value
					var calls = 0
					var walking = True
					while walking:
						match current.kind:
							Call(_, [argument]):
								current = argument
								calls += 1
							_: walking = False
					(calls == depth and parsed.issued_counts().expressions == depth * 2 + 1
						and parsed.issued_counts().name_uses == depth and parsed.diagnostic_count() == 0)
				_: False
		Err(_): False


pure func test_list_source_order_and_spans() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "[first, 007, [last,],]")):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					match value.kind:
						ListLiteral([first, middle, inner]):
							match inner.kind:
								ListLiteral([last]):
									(first.id.expression_local_index() == 0 and middle.id.expression_local_index() == 1
										and last.id.expression_local_index() == 2 and inner.id.expression_local_index() == 3
										and value.id.expression_local_index() == 4
										and first.span.span_start() == 1 and first.span.span_end() == 6
										and inner.span.span_start() == 13 and inner.span.span_end() == 20
										and value.span.span_start() == 0 and value.span.span_end() == 22
										and parsed.issued_counts().name_uses == 2 and parsed.diagnostic_count() == 0)
								_: False
						_: False
				_: False
		Err(_): False


pure func test_empty_list_has_exact_span_and_one_id() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "[]")):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					match value.kind:
						ListLiteral([]):
							(value.id.expression_local_index() == 0 and value.span.span_start() == 0 and value.span.span_end() == 2
								and parsed.issued_counts().expressions == 1 and parsed.diagnostic_count() == 0)
						_: False
				_: False
		Err(_): False


-- A list is an atom, so postfix steps and operators apply to the whole list.
pure func test_list_is_an_atom_for_postfix_and_operators() -> Bool:
	var correct = True
	for text in ["[1, 2].length()", "[1][0]", "[a] + [b]", "-[1]", "([1])", "f([1], [2, 3],)", "x[[1]]"]:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
				match result:
					ParsedExpression(_): correct = correct and parsed.diagnostic_count() == 0
					_: correct = False
			Err(_): correct = False
	correct


pure func test_list_rejection_has_exact_diagnostic_and_no_ids() -> Bool:
	message = "expected `]` after list literal"
	help = "close the bracket opened earlier with `]`"
	cases = [("[", 1), ("[1", 2), ("[1,", 3), ("[1, 2", 5), ("f([1", 4), ("[[1]", 4), ("[[1, [2]", 8)]
	var correct = True
	for (text, offset) in cases:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
				match result:
					RejectedExpression:
						correct = correct and parsed.diagnostic_count() == 1 and parsed.id_counts() == entry.id_counts()
						match reject_preview(parsed):
							Ok(rejected):
								match render_rejected_diagnostics(rejected):
									Ok([row]):
										correct = (correct and row.rendered.message == message and row.rendered.help == Some(help)
											and row.line == 1 and row.column == offset + 1
											and row.span.span_start() == offset and row.span.span_end() == offset)
									_: correct = False
							Err(_): correct = False
					_: correct = False
			Err(_): correct = False
	correct


-- Nesting follows the brackets the source itself writes, as the frozen parser does.
pure func test_nested_lists() -> Bool:
	depth = 1000
	var text = ""
	var level = 0
	while level < depth:
		text += "["
		level += 1
	text += "1"
	while level > 0:
		text += "]"
		level -= 1
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					var current = value
					var lists = 0
					var walking = True
					while walking:
						match current.kind:
							ListLiteral([element]):
								current = element
								lists += 1
							_: walking = False
					(lists == depth and parsed.issued_counts().expressions == depth + 1
						and parsed.issued_counts().name_uses == 0 and parsed.diagnostic_count() == 0)
				_: False
		Err(_): False


pure func test_tuple_source_order_and_spans() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "(first, 007, (last, 1),)")):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					match value.kind:
						TupleLiteral(Triple(first, middle, inner)):
							match inner.kind:
								TupleLiteral(Pair(last, _)):
									(first.id.expression_local_index() == 0 and middle.id.expression_local_index() == 1
										and last.id.expression_local_index() == 2 and inner.id.expression_local_index() == 4
										and value.id.expression_local_index() == 5
										and inner.span.span_start() == 13 and inner.span.span_end() == 22
										and value.span.span_start() == 0 and value.span.span_end() == 24
										and parsed.issued_counts().name_uses == 2 and parsed.diagnostic_count() == 0)
								_: False
						_: False
				_: False
		Err(_): False


pure func test_each_tuple_arity_has_its_own_shape() -> Bool:
	var correct = True
	for (text, count) in [("(a, b)", 2), ("(a, b, c)", 3), ("(a, b, c, d)", 4), ("(a, b, c, d,)", 4)]:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
				match result:
					ParsedExpression(value):
						shape_matches = match (value.kind, count):
							(TupleLiteral(Pair(_, _)), 2): True
							(TupleLiteral(Triple(_, _, _)), 3): True
							(TupleLiteral(Quadruple(_, _, _, _)), 4): True
							_: False
						correct = correct and shape_matches and parsed.issued_counts().expressions == count + 1
					_: correct = False
			Err(_): correct = False
	correct


-- Parentheses without a comma are always a grouping, and grouping never
-- becomes a tuple, however many layers surround a tuple or a single item.
pure func test_grouping_is_never_a_tuple() -> Bool:
	var correct = True
	for text in ["(a)", "((a))", "(a + b)", "([a, b])", "((a, b))"]:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(_, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
				match result:
					ParsedExpression(value):
						is_tuple = match value.kind:
							TupleLiteral(_): True
							_: False
						correct = correct and (is_tuple == (text == "((a, b))"))
					_: correct = False
			Err(_): correct = False
	correct


-- Rows: source, then every diagnostic in order as (message, start, end).
pure func test_tuple_rejection_has_exact_diagnostics_and_no_ids() -> Bool:
	singleton = "a tuple has two to four elements, and `(x,)` has one"
	arity = "Tuples support 2-4 elements"
	unclosed = "expected `)` after tuple expression"
	cases = [
		("(x,)", [(singleton, 0, 4)]),
		("(a, b, c, d, e)", [(arity, 0, 15)]),
		("(a, b, c, d, e,)", [(arity, 0, 16)]),
		("(a, b, c, d, e, f)", [(arity, 0, 18)]),
		("[(x,)]", [(singleton, 1, 5)]),
		("f((a, b, c, d, e))", [(arity, 2, 17)]),
		("(a, b", [(unclosed, 5, 5)]),
		("(a, b, c, d, e", [(unclosed, 14, 14), (arity, 0, 2)])
	]
	var correct = True
	for (text, expected) in cases:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
				match result:
					RejectedExpression:
						correct = correct and parsed.diagnostic_count() == expected.length() and parsed.id_counts() == entry.id_counts()
						match reject_preview(parsed):
							Ok(rejected):
								match render_rejected_diagnostics(rejected):
									Ok(rows):
										correct = correct and rows.length() == expected.length()
										var index = 0
										for (message, start, end) in expected:
											match rows.get(index):
												Some(row):
													correct = (correct and row.rendered.message == message
														and row.span.span_start() == start and row.span.span_end() == end)
												None: correct = False
											index += 1
									Err(_): correct = False
							Err(_): correct = False
					_: correct = False
			Err(_): correct = False
	correct


-- Tuples and lists nest in each other with nothing but brackets between
-- levels, and both are bracket recursion in the source itself.
pure func test_tuples_and_lists_nest_in_each_other() -> Bool:
	depth = 1000
	var text = "1"
	var level = 0
	while level < depth:
		text = if level % 2 == 0:
			"(" + text + ", 0)"
		else:
			"[" + text + "]"
		level += 1
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					var current = value
					var layers = 0
					var walking = True
					while walking:
						match current.kind:
							TupleLiteral(Pair(inner, _)):
								current = inner
								layers += 1
							ListLiteral([inner]):
								current = inner
								layers += 1
							_: walking = False
					(layers == depth and parsed.issued_counts().expressions == depth + 1 + depth / 2
						and parsed.diagnostic_count() == 0)
				_: False
		Err(_): False


