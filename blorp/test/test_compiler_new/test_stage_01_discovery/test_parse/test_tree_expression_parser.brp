								and second.key.id.expression_local_index() == 2 and second.value.id.expression_local_index() == 4
								and value.id.expression_local_index() == 5
								and first.span.span_start() == 1 and first.span.span_end() == 7
								and second.span.span_start() == 9 and second.span.span_end() == 19
								and value.span.span_start() == 0 and value.span.span_end() == 21
								and parsed.issued_counts().name_uses == 3 and parsed.diagnostic_count() == 0)
						_: False
				_: False
		Err(_): False


-- Rows: source, then every diagnostic in order as (message, help, start, end).
pure func test_braced_rejection_has_exact_diagnostics_and_no_ids() -> Bool:
	duplicate = "duplicate field `a`"
	given = "the field was already given at 1:2; give it once"
	record_close = "expected `}` after record literal"
	update_close = "expected `}` after record update"
	dict_close = "expected `}` after dict literal"
	vector_close = "expected `}` after vector literal"
	close_help = "close the brace opened earlier with `}`"
	expression = "expected expression"
	expression_help = "write a value, a name or a call here"
	cases = [
		("{a = 1, a = 2}", [(duplicate, given, 8, 9)]),
		("{a = 1, a = 2, a = 3}", [(duplicate, given, 8, 9), (duplicate, given, 15, 16)]),
		("{r | a = 1, a = 2}", [(duplicate, "the field was already given at 1:6; give it once", 12, 13)]),
		("{a = 1, a = 2", [(duplicate, given, 8, 9), (record_close, close_help, 13, 13)]),
		("{a = 1", [(record_close, close_help, 6, 6)]),
		("{a = 1,", [(record_close, close_help, 7, 7)]),
		("{r | a = 1", [(update_close, close_help, 10, 10)]),
		("{r |", [(update_close, close_help, 4, 4)]),
		("{k => v", [(dict_close, close_help, 7, 7)]),
		("{a", [(vector_close, close_help, 2, 2)]),
		("{a, b", [(vector_close, close_help, 5, 5)]),
		("{", [(expression, expression_help, 1, 1), (vector_close, close_help, 1, 1)]),
		("[{a = 1, a = 2}]", [(duplicate, "the field was already given at 1:3; give it once", 9, 10)])
	]
	var correct = True
	for (text, expected) in cases:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
				match result:
					RejectedExpression:
						correct = correct and parsed.diagnostic_count() == expected.length() and parsed.id_counts() == entry.id_counts()
						match reject_preview(parsed):
							Ok(rejected):
								match render_rejected_diagnostics(rejected):
									Ok(rows):
										correct = correct and rows.length() == expected.length()
										var index = 0
										for (message, help, start, end) in expected:
											match rows.get(index):
												Some(row):
													correct = (correct and row.rendered.message == message and row.rendered.help == Some(help)
														and row.span.span_start() == start and row.span.span_end() == end)
												None: correct = False
											index += 1
									Err(_): correct = False
							Err(_): correct = False
					_: correct = False
			Err(_): correct = False
	correct


-- Braces nest in each other, and in lists and tuples, with only brackets
-- between levels.
pure func test_braced_forms_nest_in_each_other() -> Bool:
	depth = 200
	var text = "1"
	var level = 0
	while level < depth:
		text = match level % 4:
			0: "{k => " + text + "}"
			1: "{f = " + text + "}"
			2: "{" + text + "}"
			_: "{r | f = " + text + "}"
		level += 1
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					var current = value
					var layers = 0
					var walking = True
					while walking:
						match current.kind:
							DictLiteral([entry_value]):
								current = entry_value.value
								layers += 1
							RecordLiteral([field]):
								current = field.value
								layers += 1
							VectorLiteral([inner]):
								current = inner
								layers += 1
							RecordUpdate(_, [field]):
								current = field.value
								layers += 1
							_: walking = False
					layers == depth and parsed.diagnostic_count() == 0
				_: False
		Err(_): False


private enum BracketedShape:
	RecordShape
	UpdateShape
	DictShape
	VectorShape
	CallShape
	SubscriptShape
	ListShape
	GroupShape
	TupleShape
	BinaryShape


-- Layout is not significant between brackets, so any bracketed form may open,
-- separate and close on any lines; each shape reads as it does on one line.
pure func test_multiline_brackets_have_their_own_shapes() -> Bool:
	var correct = True
	for (text, form) in [
		("{\n}", RecordShape), ("{\n\ta = 1,\n\tb = [2],\n}", RecordShape), ("{a =\n 1,\n b\n = 2}", RecordShape),
		("{\n\tr |\n\ta = 1,\n\tb = 2,\n}", UpdateShape), ("{r |\n a = 1}", UpdateShape),
		("{\n\tk => v,\n\t1 => 2,\n}", DictShape), ("{k\n=>\nv}", DictShape),
		("{\n\ta,\n\tb,\n}", VectorShape), ("{\n\ta\n}", VectorShape), ("{a, b\n}", VectorShape), ("{(\n1\n)}", VectorShape),
		("{\n\ta = {\n\t\tb = 1,\n\t},\n}", RecordShape), ("{\n\ta = f(1,\n\t\t2),\n\tb = [1,\n2],\n\tc = (1,\n2),\n}", RecordShape),
		("{\n\ta = 1 +\n\t\t2,\n}", RecordShape), ("{\n\ta = x\n\t\t.field,\n}", RecordShape),
		("f(\n\t1,\n\t2,\n)", CallShape), ("f(\n)", CallShape), ("f(1,\n2)", CallShape), ("f(a)(\nb)", CallShape), ("f(match x:\n\t_: 1\n)", CallShape), ("f(1, if c:\n\t\t1\n\telse:\n\t\t2\n, 3)", CallShape), ("x[\n1,\n2\n]", SubscriptShape), ("[\n\t1,\n\t2,\n]", ListShape), ("[\n]", ListShape),
		("(\n1\n)", GroupShape), ("(\n)", GroupShape), ("(a,\nb)", TupleShape), ("(\n\ta,\n\tb,\n\tc,\n)", TupleShape), ("(1 +\n 2) * 3", BinaryShape), ("f(g(\n1,\n2),\n[3,\n4])", CallShape),
	]:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
				match result:
					ParsedExpression(value):
						shape = match (value.kind, form):
							(RecordLiteral(_), RecordShape): True
							(RecordUpdate(_, _), UpdateShape): True
							(DictLiteral(_), DictShape): True
							(VectorLiteral(_), VectorShape): True
							(Call(_, _), CallShape): True
							(Subscript(_, _), SubscriptShape): True
							(ListLiteral(_), ListShape): True
							(VoidValue, GroupShape): True
							(IntegerLiteral(_), GroupShape): True
							(TupleLiteral(_), TupleShape): True
							(Binary(_, _, _), BinaryShape): True
							_: False
						correct = correct and shape and parsed.diagnostic_count() == 0 and value.span.span_end() == text.length()
					_: correct = False
			Err(_): correct = False
	correct


-- A block opened inside brackets reads statements only past the frozen
-- parser's anchor (`block_may_open`): the bracket for a list, tuple or
-- grouping, the item itself for a braced form, the enclosing anchor for call
-- arguments and subscript indices. A tab advances to the next multiple-of-4 stop.
private pure func if_read(accepted: Bool) -> String:
	if accepted:
		"should read"
	else:
		"should decline"


func test_blocks_in_brackets_follow_the_anchor() -> Bool:
	var correct = True
	for (text, accepted) in [
		("[match x:\n\t_: 1\n]", True), ("[match x:\n_: 1\n]", False), ("[ match x:\n  _: 1\n]", True),
		("(match x:\n\t_: 1\n)", True), ("(1, match x:\n\t_: 1\n)", True), ("(1, match x:\n_: 1\n)", False),
		("f(match x:\n  _: 1\n)", True), ("f(match x:\n_: 1\n)", False), ("f(g(match x:\n\t_: 1\n))", True),
		("f([match x:\n\t_: 1\n])", True), ("x[match i:\n\t_: 1\n]", True),
		("{match x:\n  _: 1\n}", True), ("{match x:\n _: 1\n}", False),
		("{a = match x:\n\t_: 1\n}", False), ("{a = match x:\n\t\t_: 1\n}", True),
		("{1 => match x:\n\t_: 1\n}", False), ("{1 => match x:\n\t\t\t_: 1\n}", True),
		("f(1 + [match x:\n\t_: 1\n])", False), ("f(1 + [match x:\n\t\t_: 1\n])", True),
		("[func(y: Int) -> Int:\n\ty\n]", True), ("f(func(y: Int) -> Int:\n\ty\n)", True),
	]:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(_, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
				read: Bool = match result:
					ParsedExpression(_): True
					_: False
				if read != accepted:
					print("the anchor rule ${if_read(accepted)} ${text.replace("\n", "\\n").replace("\t", "\\t")}")
					correct = False
			Err(_): correct = False
	correct


-- Ids follow the source order of a form that spans lines, child first.
pure func test_multiline_braced_source_order() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "{\n\tbase |\n\tfirst = x,\n\tsecond = 1,\n}")):
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				ParsedExpression(value):
					match value.kind:
						RecordUpdate(base, [first, second]):
							(base.id.expression_local_index() == 0 and first.name.use.name_use_local_index() == 1
								and first.value.id.expression_local_index() == 1 and second.name.use.name_use_local_index() == 3
								and second.value.id.expression_local_index() == 2 and value.id.expression_local_index() == 3
								and parsed.issued_counts().name_uses == 4 and parsed.diagnostic_count() == 0)
						_: False
				_: False
		Err(_): False


-- An unclosed or repeating multiline form reports where the frozen parser does.
pure func test_multiline_braced_rejection_reports_the_right_line() -> Bool:
	cases = [
		("{\n\ta = 1,\n\ta = 2\n}", [("duplicate field `a`", 3, 5)]),
		("{\n\ta = 1,\n", [("expected `}` after record literal", 3, 1)]),
		("{\n\tk => v", [("expected `}` after dict literal", 2, 11)]),
	]
	var correct = True
	for (text, expected) in cases:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
				match result:
					RejectedExpression:
						correct = correct and parsed.id_counts() == entry.id_counts()
						match reject_preview(parsed):
							Ok(rejected):
								match render_rejected_diagnostics(rejected):
									Ok(rows):
										correct = correct and rows.length() == expected.length()
										var index = 0
										for (message, line, column) in expected:
											match rows.get(index):
												Some(row): correct = correct and row.rendered.message == message and row.line == line and row.column == column
												None: correct = False
											index += 1
									Err(_): correct = False
							Err(_): correct = False
					_: correct = False
			Err(_): correct = False
	correct


tests: TestSuite = {
	description = "Bounded tree operator expressions",
	tests = [
		("precedence and postorder ids", test_precedence_and_postorder_ids),
		("string and character literals", test_string_and_character_literals_are_atoms),
		("string literals keep form and text", test_string_literals_keep_their_form_and_text),
		("character escapes", test_character_literals_decode_every_escape),
		("pipe interpolation is multiline", test_pipe_interpolation_is_multiline_with_text_around_its_holes),
		("interpolation holes in source order", test_interpolated_string_holes_are_expressions_in_source_order),
