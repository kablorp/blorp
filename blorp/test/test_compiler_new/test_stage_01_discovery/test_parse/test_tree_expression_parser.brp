pure func test_braced_forms_have_their_own_shapes() -> Bool:
	var correct = True
	for (text, form) in [("{}", 0), ("{a = 1}", 0), ("{a = 1, b = [2],}", 0), ("{r | a = 1, b = 2,}", 1), ("{k => v}", 2), ("{1 => 2, 3 => 4,}", 2), ("{a}", 3), ("{a, b,}", 3), ("{(a), 2}", 3), ("{{a}}", 3)]:
