-- A `match` nests one level per case block.
private pure func nested_matches(count: Int) -> List[String]:
	var lines: List[String] = []
	var level: Int = 0
	while level < count:
		lines = lines.append("\t".repeat(2 * level) + "match a:")
		lines = lines.append("\t".repeat(2 * level + 1) + "_:")
		level += 1
	lines.append("\t".repeat(2 * count) + "1")


func test_match_blocks_at_the_limit() -> Bool:
	function_is_accepted(function_source(nested_matches(MAX_SYNTAX_NESTING - 1)))


func test_match_blocks_one_past_the_limit() -> Bool:
	function_is_declined_as_too_deep(function_source(nested_matches(MAX_SYNTAX_NESTING)))


-- Each `else` block nests inside the last `if`.
private pure func nested_else_blocks(count: Int) -> List[String]:
	var lines: List[String] = []
	var level: Int = 0
	while level < count:
		lines = lines.append("\t".repeat(level) + "if a:")
		lines = lines.append("\t".repeat(level + 1) + "1")
		lines = lines.append("\t".repeat(level) + "else:")
		level += 1
	lines.append("\t".repeat(count) + "1")


func test_else_blocks_at_the_limit() -> Bool:
	function_is_accepted(function_source(nested_else_blocks(MAX_SYNTAX_NESTING - 1)))


func test_else_blocks_one_past_the_limit() -> Bool:
	function_is_declined_as_too_deep(function_source(nested_else_blocks(MAX_SYNTAX_NESTING)))


func test_local_function_bodies_at_the_limit() -> Bool:
	blocks_at_the_limit("func g#(x: Int) -> Int:")


func test_local_function_bodies_one_past_the_limit() -> Bool:
	blocks_one_past_the_limit("func g#(x: Int) -> Int:")


-- The diagnostic of a real parse sits where the parser refused to nest.
func test_the_diagnostic_is_located_at_the_refused_token() -> Bool:
	text = nested_text("[", "1", "]", MAX_SYNTAX_NESTING + 1)
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Err(_): False
		Ok(entry):
			(parsed, _) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match reject_preview(parsed):
				Ok(rejected):
					match render_rejected_diagnostics(rejected):
						Ok([row]):
							(row.rendered.message == "syntax nested too deeply" and row.line == 1
								and row.column == MAX_SYNTAX_NESTING + 1)
						_: False
				Err(_): False


-- The same from a declaration: the `Int` that would be level 129 of a field's type.
func test_the_diagnostic_of_a_rejected_declaration_is_located() -> Bool:
	written = nested_text("List[", "Int", "]", MAX_SYNTAX_NESTING)
	lexed = lex_module(module_id_at_row(0), "record R {\n\tf: " + written + "\n}\n")
	match scan_rejected_declarations(lexed):
		Ok(CompleteDeclarationRejection(rejected)):
			match render_rejected_diagnostics(rejected):
				Ok([row]):
					-- A tab is `TAB_WIDTH` columns wide.
					(row.rendered.message == "syntax nested too deeply" and row.line == 2
						and row.column == TAB_WIDTH + "f: ".length() + "List[".length() * MAX_SYNTAX_NESTING + 1)
				_: False
		_: False


-- The chains that are loops in the parser are not counted at any length.
func test_left_spines_and_chains_do_not_count() -> Bool:
	sum = "1" + " + 1".repeat(5000)
	calls = "a" + ".f()".repeat(2000)
	global_value_is_accepted(sum) and global_value_is_accepted(calls)


tests: TestSuite = {
	description = "Syntax nesting limit",
	tests = [
