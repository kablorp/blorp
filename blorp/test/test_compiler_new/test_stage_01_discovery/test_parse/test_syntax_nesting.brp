-- `MAX_SYNTAX_NESTING` (section 3.14): every form that counts toward the limit
-- is read, minted, dumped and passed by the ID census at exactly the limit, and
-- one level more is rejected with `SyntaxNestingTooDeep`. The legacy projection
-- has the same proof in `test_syntax_nesting_projection.brp`.
--
-- A depth is the number of levels open at the deepest point. A source at the
-- limit puts its innermost construct at level `MAX_SYNTAX_NESTING`.
import:
	../../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../../src/compiler_new/stage_01_discovery/parse/layout_quirks: anchored_at
	../../../../src/compiler_new/stage_01_discovery/parse/parse_state:
		MAX_SYNTAX_NESTING, ParseState, new_parse_state, current_span, issued_ids, spellings, diagnostic_count, reported_nesting_too_deep
	../../../../src/compiler_new/stage_01_discovery/parse/stop_reason: StopReason(NestingTooDeep)
	../../../../src/compiler_new/stage_01_discovery/parse/tree_expression_parser:
		parse_expression_to_boundary, ExpressionParse(RejectedExpression, UnsupportedExpression)
	../../../../src/compiler_new/stage_01_discovery/parse/rejected_preview: reject_preview
	../../../../src/compiler_new/stage_01_discovery/parse/tree_rejected_declaration_scan: scan_rejected_declarations, RejectedDeclarationScan(CompleteDeclarationRejection)
	../../../../src/compiler_new/stage_01_discovery/diagnostics/rejected_syntax_render: render_rejected_diagnostics
	../../../../src/compiler_new/stage_01_discovery/parse/tree_module_declaration_scan:
		ModuleDeclarationScanStop(ReachedEndOfSource, StoppedAtRejectedDeclaration, StoppedAtUnreadDeclaration), scan_module_declarations
	../../../../src/compiler_new/stage_01_discovery/syntax/dump: dumped_module
	../../../../src/compiler_new/stage_01_discovery/syntax/id_census: id_census
	../../../../src/compiler_new/stage_01_discovery/syntax/module_syntax: ModuleSyntax, ModuleItem
	../../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_at_row
	../../../../src/compiler_new/stage_01_discovery/tables/limits: MAX_INTERPOLATION_DEPTH
	../../../../src/compiler_new/stage_01_discovery/tables/source_position: TAB_WIDTH
	test: TestSuite


-- `count` copies of `open`, `inner`, then `count` copies of `close`.
private pure func nested_text(open: String, inner: String, close: String, count: Int) -> String:
	open.repeat(count) + inner + close.repeat(count)


-- Whether the scan of `text` reads its one declaration in full, and the dump
-- and the census pass the result with no diagnostic.
private func is_accepted(text: String) -> Bool:
	module = module_id_at_row(0)
	match new_parse_state(lex_module(module, text)):
		Err(_): False
		Ok(entry):
			(state, scan) = scan_module_declarations(entry)
			issued = issued_ids(state)
			syntax: ModuleSyntax = {
				documentation = None, items = scan.items,
				definitions = issued.definitions, imports = issued.imports, counts = issued.counts
			}
			read_to_the_end: Bool = match scan.stop:
				ReachedEndOfSource: True
				_: False
			(scan.items.length() == 1 and state.diagnostic_count() == 0 and read_to_the_end
				and id_census(module, syntax).is_empty() and dumped_module(syntax, spellings(state)).length() > 0)


-- Whether the scan of `text` stops at its declaration for being nested too
-- deeply: reported as a diagnostic, or kept as the reason of a rollback.
private func is_stopped_as_too_deep(text: String) -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Err(_): False
		Ok(entry):
			(state, scan) = scan_module_declarations(entry)
			match scan.stop:
				StoppedAtRejectedDeclaration: state.reported_nesting_too_deep()
				StoppedAtUnreadDeclaration(unread): unread.stop.reason == NestingTooDeep
				_: False


-- Whether `text`, the value of a global, is accepted.
private func global_value_is_accepted(text: String) -> Bool:
	is_accepted("value = " + text)


-- Whether `text` as an expression is rejected for being nested too deeply.
private func expression_is_rejected_as_too_deep(text: String) -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Err(_): False
		Ok(entry):
			(parsed, result) = parse_expression_to_boundary(entry, anchored_at(entry.current_span()))
			match result:
				RejectedExpression: parsed.reported_nesting_too_deep()
				-- A construct that gives up its rollback (a lambda) hands the expression back with
				-- the reason, which the rollback keeps and the diagnostic does not.
				UnsupportedExpression(stop): stop.reason == NestingTooDeep
				_: False


-- An expression form: `count` levels around `inner` are `count` nesting levels.
private func expression_form_at_the_limit(open: String, inner: String, close: String) -> Bool:
	global_value_is_accepted(nested_text(open, inner, close, MAX_SYNTAX_NESTING))


private func expression_form_one_past_the_limit(open: String, inner: String, close: String) -> Bool:
	expression_is_rejected_as_too_deep(nested_text(open, inner, close, MAX_SYNTAX_NESTING + 1))


-- Each conversion owns a level; its written type uses the next one, even
-- though that type finishes before the value is read.
func test_opaque_conversions_and_types_at_the_combined_limit() -> Bool:
	(global_value_is_accepted(nested_text("into_opaque Handle(", "1", ")", MAX_SYNTAX_NESTING - 1))
		and expression_is_rejected_as_too_deep(nested_text("from_opaque Handle(", "1", ")", MAX_SYNTAX_NESTING)))


func test_builtin_markers_are_leaves_at_the_nesting_limit() -> Bool:
	(global_value_is_accepted(nested_text("(", "builtin(\"helper\")", ")", MAX_SYNTAX_NESTING))
		and expression_is_rejected_as_too_deep(nested_text("(", "builtin(\"helper\")", ")", MAX_SYNTAX_NESTING + 1)))


