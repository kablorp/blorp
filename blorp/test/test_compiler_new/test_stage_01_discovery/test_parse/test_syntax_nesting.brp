-- The lexer admits `MAX_INTERPOLATION_DEPTH` nested holes, fewer than the
-- parser's limit, so it is the lexer's own limit that ends a run of holes; each
-- hole it admits is one level.
func test_holes_are_accepted_up_to_the_lexer_cap() -> Bool:
	global_value_is_accepted(nested_text("\"$" + "{", "1", "}\"", MAX_INTERPOLATION_DEPTH))


-- A hole is a level, and what it holds nests from there: a hole around brackets
-- reaches the limit with one bracket fewer.
func test_a_hole_around_brackets_at_the_limit() -> Bool:
	global_value_is_accepted("\"$" + "{" + nested_text("[", "1", "]", MAX_SYNTAX_NESTING - 1) + "}\"")


func test_a_hole_around_brackets_one_past_the_limit() -> Bool:
	expression_is_rejected_as_too_deep("\"$" + "{" + nested_text("[", "1", "]", MAX_SYNTAX_NESTING) + "}\"")


-- Holes inside holes, each holding brackets, add up the same way.
func test_nested_holes_around_brackets_add_up() -> Bool:
	holes = MAX_INTERPOLATION_DEPTH
	brackets = MAX_SYNTAX_NESTING - holes
	inner = nested_text("[", "1", "]", brackets)
	text = nested_text("\"$" + "{", inner, "}\"", holes)
	global_value_is_accepted(text) and expression_is_rejected_as_too_deep(nested_text("\"$" + "{", "[" + inner + "]", "}\"", holes))


-- A level counted once on the way down is not counted again: after a deep form
-- returns, a shallow sibling is read at the depth it stands at.
func test_siblings_do_not_accumulate_depth() -> Bool:
	text = nested_text("[", "1", "]", MAX_SYNTAX_NESTING - 1)
	global_value_is_accepted("[" + text + ", " + text + ", " + text + "]")


-- The source of one function `f` whose body is `lines`, each indented once.
private pure func function_source(lines: List[String]) -> String:
	(["func f(a: Int) -> Int:"].concat(lines.map(pure func(line): "\t" + line))).join("\n") + "\n"


private func function_is_accepted(text: String) -> Bool:
	is_accepted(text)


private func function_is_declined_as_too_deep(text: String) -> Bool:
	is_stopped_as_too_deep(text)


-- Lines that nest `count` blocks, each opened by `header`, around `leaf`. The
-- function's own body is a block too, so the innermost block is level `count + 1`.
private pure func nested_blocks(header: String, count: Int, leaf: String) -> List[String]:
	var lines: List[String] = []
	var level: Int = 0
	while level < count:
		lines = lines.append("\t".repeat(level) + header.replace("#", level.to_string()))
		level += 1
	lines.append("\t".repeat(count) + leaf)


private func blocks_at_the_limit(header: String) -> Bool:
	function_is_accepted(function_source(nested_blocks(header, MAX_SYNTAX_NESTING - 1, "1")))


private func blocks_one_past_the_limit(header: String) -> Bool:
	function_is_declined_as_too_deep(function_source(nested_blocks(header, MAX_SYNTAX_NESTING, "1")))


func test_value_ifs_at_the_limit() -> Bool:
	blocks_at_the_limit("v# = if a:")


func test_value_ifs_one_past_the_limit() -> Bool:
	blocks_one_past_the_limit("v# = if a:")


func test_with_blocks_at_the_limit() -> Bool:
	blocks_at_the_limit("with r# = open(a):")


func test_with_blocks_one_past_the_limit() -> Bool:
	blocks_one_past_the_limit("with r# = open(a):")


func test_concurrently_for_at_the_limit() -> Bool:
	blocks_at_the_limit("for item# in items concurrently(limit: 2, timeout: a):")


func test_concurrently_for_one_past_the_limit() -> Bool:
	blocks_one_past_the_limit("for item# in items concurrently(limit: 2, timeout: a):")



func test_concurrent_blocks_at_the_limit() -> Bool:
	blocks_at_the_limit("concurrent(max_threads: 2, timeout: a):")


func test_concurrent_blocks_one_past_the_limit() -> Bool:
	blocks_one_past_the_limit("concurrent(max_threads: 2, timeout: a):")


func test_debug_blocks_at_the_limit() -> Bool:
	blocks_at_the_limit("debug:")


func test_debug_blocks_one_past_the_limit() -> Bool:
	blocks_one_past_the_limit("debug:")


-- A `select` nests two lines of indentation per level: the keyword, then the
-- arm, whose block is the next level.
private pure func nested_selects(count: Int) -> List[String]:
	var lines: List[String] = []
	var level: Int = 0
	while level < count:
		lines = lines.append("\t".repeat(2 * level) + "select:")
		lines = lines.append("\t".repeat(2 * level + 1) + "v" + level.to_string() + " from a:")
		level += 1
	lines.append("\t".repeat(2 * count) + "1")


func test_selects_at_the_limit() -> Bool:
	function_is_accepted(function_source(nested_selects(MAX_SYNTAX_NESTING - 1)))


func test_selects_one_past_the_limit() -> Bool:
	function_is_declined_as_too_deep(function_source(nested_selects(MAX_SYNTAX_NESTING)))


-- A control expression read as an operand is a level of its own, and so is its
-- block: `v = 1 + if a:` costs two levels, so the last whole level is the
-- 63rd, and a grouping around the leaf takes the innermost block to the limit.
private pure func nested_operand_ifs(count: Int, leaf: String) -> List[String]:
	var lines: List[String] = []
	var level: Int = 0
	while level < count:
		lines = lines.append("\t".repeat(level) + "v" + level.to_string() + " = 1 + if a:")
		level += 1
	lines.append("\t".repeat(count) + leaf)


func test_operand_ifs_at_the_limit() -> Bool:
	count = (MAX_SYNTAX_NESTING - 2) / 2
	function_is_accepted(function_source(nested_operand_ifs(count, "(1)")))


func test_operand_ifs_one_past_the_limit() -> Bool:
	count = (MAX_SYNTAX_NESTING - 2) / 2
	function_is_declined_as_too_deep(function_source(nested_operand_ifs(count, "((1))")))


-- A lambda with a block body: the lambda and its block are two levels.
private pure func nested_block_lambdas(count: Int) -> List[String]:
	var lines: List[String] = []
	var level: Int = 0
	while level < count:
		lines = lines.append("\t".repeat(level) + "f" + level.to_string() + " = func(b" + level.to_string() + "):")
		level += 1
	lines.append("\t".repeat(count) + "1")


func test_block_lambdas_at_the_limit() -> Bool:
	function_is_accepted(function_source(nested_block_lambdas((MAX_SYNTAX_NESTING - 1) / 2)))


func test_block_lambdas_one_past_the_limit() -> Bool:
	function_is_declined_as_too_deep(function_source(nested_block_lambdas((MAX_SYNTAX_NESTING - 1) / 2 + 1)))


private func declaration_is_rejected_as_too_deep(text: String) -> Bool:
	is_stopped_as_too_deep(text)


-- Written types. A type, and each argument or element inside it, is a level.
private pure func function_with_parameter_type(written: String) -> String:
	"func f(a: " + written + ") -> Int:\n\t1\n"


func test_tuple_types_at_the_limit() -> Bool:
	function_is_accepted(function_with_parameter_type(nested_text("(", "Int", ", Int)", MAX_SYNTAX_NESTING - 2)))


func test_tuple_types_one_past_the_limit() -> Bool:
	declaration_is_rejected_as_too_deep(function_with_parameter_type(nested_text("(", "Int", ", Int)", MAX_SYNTAX_NESTING - 1)))


func test_grouped_types_at_the_limit() -> Bool:
	function_is_accepted(function_with_parameter_type(nested_text("(", "Int", ")", MAX_SYNTAX_NESTING - 2)))


func test_grouped_types_one_past_the_limit() -> Bool:
	declaration_is_rejected_as_too_deep(function_with_parameter_type(nested_text("(", "Int", ")", MAX_SYNTAX_NESTING - 1)))


-- Each arrow nests its parameter list and its result, two levels.
func test_function_types_at_the_limit() -> Bool:
	function_is_accepted(function_with_parameter_type(nested_text("(Int) -> ", "Int", "", (MAX_SYNTAX_NESTING - 2) / 2)))


func test_function_types_one_past_the_limit() -> Bool:
	declaration_is_rejected_as_too_deep(function_with_parameter_type(nested_text("(Int) -> ", "Int", "", (MAX_SYNTAX_NESTING - 2) / 2 + 1)))


-- A dimension nests by its parentheses, inside the argument that holds it.
func test_parenthesized_dimensions_at_the_limit() -> Bool:
	function_is_accepted(function_with_parameter_type("Float[" + nested_text("(", "#N", ")", MAX_SYNTAX_NESTING - 2) + "]"))


func test_parenthesized_dimensions_one_past_the_limit() -> Bool:
	declaration_is_rejected_as_too_deep(function_with_parameter_type("Float[" + nested_text("(", "#N", ")", MAX_SYNTAX_NESTING - 1) + "]"))


-- A dimension sum and a run of array suffixes are loops in the parser, but the
-- tree holds each term inside the next and the type walkers recurse on it, so
-- their length counts like a nesting (section 3.14).
func test_dimension_sums_at_the_limit() -> Bool:
	function_is_accepted(function_with_parameter_type("Float[#N" + " + #N".repeat(MAX_SYNTAX_NESTING - 2) + "]"))


func test_dimension_sums_one_past_the_limit() -> Bool:
	declaration_is_rejected_as_too_deep(function_with_parameter_type("Float[#N" + " + #N".repeat(MAX_SYNTAX_NESTING - 1) + "]"))


func test_dimension_products_at_the_limit() -> Bool:
	function_is_accepted(function_with_parameter_type("Float[#N" + " * #N".repeat(MAX_SYNTAX_NESTING - 2) + "]"))


func test_dimension_products_one_past_the_limit() -> Bool:
	declaration_is_rejected_as_too_deep(function_with_parameter_type("Float[#N" + " * #N".repeat(MAX_SYNTAX_NESTING - 1) + "]"))


func test_array_suffixes_at_the_limit() -> Bool:
	function_is_accepted(function_with_parameter_type("Int" + "[#N]".repeat(MAX_SYNTAX_NESTING)))


func test_array_suffixes_one_past_the_limit() -> Bool:
	declaration_is_rejected_as_too_deep(function_with_parameter_type("Int" + "[#N]".repeat(MAX_SYNTAX_NESTING + 1)))


-- Patterns: the innermost pattern is a level of its own, and so is the
-- function's block and the match inside it.
private pure func function_matching(pattern: String) -> String:
	function_source(["match a:", "\t" + pattern + ": 1", "\t_: 0"])


func test_tuple_patterns_at_the_limit() -> Bool:
	function_is_accepted(function_matching(nested_text("(", "1", ", 1)", MAX_SYNTAX_NESTING - 2)))


func test_tuple_patterns_one_past_the_limit() -> Bool:
	function_is_declined_as_too_deep(function_matching(nested_text("(", "1", ", 1)", MAX_SYNTAX_NESTING - 1)))


func test_list_patterns_at_the_limit() -> Bool:
	function_is_accepted(function_matching(nested_text("[", "1", "]", MAX_SYNTAX_NESTING - 2)))


func test_list_patterns_one_past_the_limit() -> Bool:
	function_is_declined_as_too_deep(function_matching(nested_text("[", "1", "]", MAX_SYNTAX_NESTING - 1)))


-- Statement blocks: the function's body is the first level.
func test_if_statement_blocks_at_the_limit() -> Bool:
	blocks_at_the_limit("if a:")


func test_if_statement_blocks_one_past_the_limit() -> Bool:
	blocks_one_past_the_limit("if a:")


