-- Exact trait head/missing-body grammar and completed default-body boundaries.
-- header.span is the frozen declaration header extent, never the full method/body.
import:
	../../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../../src/compiler_new/stage_01_discovery/parse/parse_state: ParseState, new_parse_state, advanced, current_kind, current_span, position, diagnostics, diagnostic_count, issued_counts, spellings, consume_declared_name, finished_builtin_type, report_at_current
	../../../../src/compiler_new/stage_01_discovery/parse/tree_trait_method_header_parser: TraitMethodHeadParse(ParsedTraitMethodHead, RejectedTraitMethodHead), MethodBodyPresence(AbstractMethod, DefaultBodyFollows), parse_trait_method_head
	../../../../src/compiler_new/stage_01_discovery/parse/tree_body_parser: complete_body
	../../../../src/compiler_new/stage_01_discovery/parse/stop_reason: Recognition(Recognized)
	../../../../src/compiler_new/stage_01_discovery/syntax/declarations: ParameterBinding(NamedParameter, WildcardParameter, TupleParameter)
	../../../../src/compiler_new/stage_01_discovery/syntax/sequences: SmallTuple(Pair)
	../../../../src/compiler_new/stage_01_discovery/syntax/types: WrittenTypeKind(NamedType, TupleType), TypeArgument(TypeArgumentType)
	../../../../src/compiler_new/stage_01_discovery/syntax/ids: definition_local_index, binder_local_index, written_type_local_index, name_use_local_index
	../../../../src/compiler_new/stage_01_discovery/syntax/diagnostics: SyntaxDiagnostic(ExpectedToken, Plain, ReservedKeywordAsName)
	../../../../src/compiler_new/stage_01_discovery/syntax/spellings: spelling_text
	../../../../src/compiler_new/stage_01_discovery/tables/diagnostic_code: PlainSyntaxCode(MissingFunctionBodyDiagnostic, ExpectedSupertraitOrMethodsDiagnostic)
	../../../../src/compiler_new/stage_01_discovery/tables/expected_token: ExpectedTokenDiagnostic(ExpectedKeyword, ExpectedName, ExpectedLeftParen), KeywordConstruct(KeywordInTraitMethodName), NameConstruct(NameInTraitMethodName, NameInParameterName), LeftParenConstruct(LeftParenInTraitMethodName)
	../../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_at_row
	../../../../src/compiler_new/stage_01_discovery/tables/row_kinds: Visibility(PublicVisibility), Purity(PureFunction, ImpureFunction)
	../../../../src/compiler_new/stage_01_discovery/tables/span: Span, span_start, span_end
	../../../../src/compiler_new/stage_01_discovery/tables/token: TokenKind(EndOfFileToken, FuncKeyword, IdentifierToken, LeftBracketSymbol, WhereKeyword, NewlineToken, DedentToken, IntLiteralToken, ElseKeyword)
	../../../../src/compiler_new/stage_01_discovery/parse/rejected_preview: reject_preview
	../../../../src/compiler_new/stage_01_discovery/diagnostics/rejected_syntax_render: render_rejected_diagnostics
	test: TestSuite


private pure func covers(span: Span, first: Int, last: Int) -> Bool:
	span.span_start() == first and span.span_end() == last


private pure func is_abstract(body: MethodBodyPresence) -> Bool:
	match body:
		AbstractMethod:
			True
		DefaultBodyFollows:
			False


private pure func is_preexisting_diagnostic(diagnostic: SyntaxDiagnostic) -> Bool:
	match diagnostic:
		Plain(ExpectedSupertraitOrMethodsDiagnostic):
			True
		_:
			False


private pure func no_parent_or_body_ids(state: ParseState) -> Bool:
	counts = state.issued_counts()
	match new_parse_state(lex_module(module_id_at_row(0), "witness")):
		Ok(witness_state):
			(_, name) = witness_state.consume_declared_name(NameInTraitMethodName)
			match name:
				Some(name):
					(_, witness) = state.finished_builtin_type(PublicVisibility, None, name, [], name.span)
					(witness.id.definition_local_index() == 0 and counts.expressions == 0 and counts.blocks == 0
						and counts.statements == 0 and counts.patterns == 0 and counts.type_binders == 0)
				None:
					False
		Err(_):
			False


private union ExpectedDiagnostic:
	MissingKeyword
	MissingName
	MissingParameterName
	MissingParameters
	MissingBody
	ReservedName(String)


private pure func diagnostics_match(state: ParseState, expected: List[(ExpectedDiagnostic, Int, Int)]) -> Bool:
	var correct: Bool = state.diagnostic_count() == expected.length()
	for (actual, wanted) in state.diagnostics().zip(expected):
		(code, first, last) = wanted
		correct = correct and actual.span.covers(first, last)
		match (actual.diagnostic, code):
			(ExpectedToken(ExpectedKeyword(KeywordInTraitMethodName)), MissingKeyword) | (ExpectedToken(ExpectedName(NameInTraitMethodName)), MissingName) | (ExpectedToken(ExpectedName(NameInParameterName)), MissingParameterName) | (ExpectedToken(ExpectedLeftParen(LeftParenInTraitMethodName)), MissingParameters) | (Plain(MissingFunctionBodyDiagnostic), MissingBody):
				void
			(ReservedKeywordAsName(spelling), ReservedName(text)):
				correct = correct and state.spellings().spelling_text(spelling) == Some(text)
			_:
				correct = False
	correct


private pure func rejected(text: String, advance: Int, expected: List[(ExpectedDiagnostic, Int, Int)], cursor: TokenKind, first: Int, last: Int, token_position: Int, types: Int) -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(initial):
			var state = initial
			for _ in 0..advance:
				state = state.advanced()
			(parsed, result) = parse_trait_method_head(state)
			match result:
				RejectedTraitMethodHead:
					(diagnostics_match(parsed, expected) and parsed.current_kind() == cursor and parsed.current_span().covers(first, last)
						and parsed.position() == token_position and parsed.issued_counts().written_types == types and no_parent_or_body_ids(parsed))
				_:
					False
		Err(_):
			False


private pure func abstract_method(text: String, purity: Purity, end: Int, return_span: Option[(Int, Int)], cursor: TokenKind, first: Int, last: Int, token_position: Int) -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(state):
			(parsed, result) = parse_trait_method_head(state)
			match result:
				ParsedTraitMethodHead(preview):
					var correct: Bool = (is_abstract(preview.body_presence) and preview.header.span.covers(0, end)
						and preview.header.signature.purity == purity and preview.header.signature.parameters.is_empty()
						and parsed.current_kind() == cursor and parsed.current_span().covers(first, last) and parsed.position() == token_position
						and parsed.diagnostic_count() == 0 and parsed.issued_counts().binders == 0 and no_parent_or_body_ids(parsed))
					match (preview.header.signature.return_type, return_span):
						(None, None):
							correct = correct and parsed.issued_counts().written_types == 0 and parsed.issued_counts().name_uses == 0
						(Some(written), Some((start, finish))):
							correct = correct and written.span.covers(start, finish) and written.id.written_type_local_index() == 0 and parsed.issued_counts().written_types == 1 and parsed.issued_counts().name_uses == 1
						_:
							correct = False
					correct
				_:
					False
		Err(_):
			False


pure func test_abstract_header_ends_at_name_unless_return_is_written() -> Bool:
	(abstract_method("func f()", ImpureFunction, 6, None, EndOfFileToken, 8, 8, 4)
		and abstract_method("pure func f() -> Int", PureFunction, 20, Some((17, 20)), EndOfFileToken, 20, 20, 7))


pure func test_grouped_return_consumes_close_without_extending_header() -> Bool:
	abstract_method("func f() -> (Int)", ImpureFunction, 16, Some((13, 16)), EndOfFileToken, 17, 17, 8)


pure func test_where_remains_for_the_trait_owner() -> Bool:
	abstract_method("func f() -> Int where", ImpureFunction, 15, Some((12, 15)), WhereKeyword, 16, 21, 6)


pure func test_bad_names_and_parameters_recover_through_authored_suffix() -> Bool:
	(rejected("func 123() -> Int", 0, [(MissingName, 5, 5)], EndOfFileToken, 17, 17, 6, 1)
		and rejected("func if() -> Int", 0, [(ReservedName("if"), 5, 5)], EndOfFileToken, 16, 16, 6, 1)
		and rejected("func f(123) -> Int:", 0, [(MissingParameterName, 7, 7), (MissingBody, 5, 6)], EndOfFileToken, 19, 19, 8, 1))


pure func test_unsupported_prefixes_use_leaf_recovery_and_generics_stay_unconsumed() -> Bool:
	(rejected("private func f() -> Int", 0, [(MissingKeyword, 0, 0), (ReservedName("private"), 0, 0), (MissingParameters, 8, 8)], FuncKeyword, 8, 12, 1, 0)
		and rejected("@no_copy func f() -> Int", 0, [(MissingKeyword, 0, 0), (MissingName, 0, 0), (MissingParameters, 1, 1)], IdentifierToken, 1, 8, 1, 0)
		and rejected("---\nDocs\n---\nfunc f()", 0, [(MissingKeyword, 0, 0), (MissingName, 0, 0), (MissingParameters, 13, 13)], FuncKeyword, 13, 17, 1, 0)
		and rejected("func f[T]()", 0, [(MissingParameters, 6, 6)], LeftBracketSymbol, 6, 7, 2, 0))


pure func test_authored_colon_requires_body_at_eof_dedent_or_unindented_line() -> Bool:
	(rejected("func f():", 0, [(MissingBody, 5, 6)], EndOfFileToken, 9, 9, 5, 0)
		and rejected("func f(): else:", 0, [(MissingBody, 5, 6)], ElseKeyword, 10, 14, 5, 0)
		and rejected("func f():\nfunc g()", 0, [(MissingBody, 5, 6)], NewlineToken, 10, 10, 5, 0)
		and rejected("func f():\n-- comment\n\nfunc g()", 0, [(MissingBody, 5, 6)], NewlineToken, 10, 10, 5, 0)
		and rejected("holder\n\tfunc f():\nnext", 3, [(MissingBody, 13, 14)], DedentToken, 18, 18, 8, 0))


pure func test_parameter_children_keep_source_order_without_parent_definition() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "func f(x: List[Int], _, _: Int, (a, b): (Int, Bool))")):
		Ok(state):
			(parsed, result) = parse_trait_method_head(state)
			match result:
				ParsedTraitMethodHead(preview):
					match preview.header.signature.parameters:
						[first, wildcard, discard, pair]:
							match (first.binding, wildcard.binding, discard.binding, pair.binding):
								(NamedParameter(x), WildcardParameter(wildcard_span), NamedParameter(discard_name), TupleParameter(tuple_binding)):
									match (tuple_binding.names, first.declared_type, discard.declared_type, pair.declared_type):
										(Pair(a, b), Some(list_type), Some(discard_type), Some(tuple_type)):
											match (list_type.kind, discard_type.kind, tuple_type.kind):
												(NamedType(list_name, [TypeArgumentType(int_type)]), NamedType(discard_use, []), TupleType(Pair(TypeArgumentType(left), TypeArgumentType(right)))):
													match (int_type.kind, left.kind, right.kind):
														(NamedType(int_use, []), NamedType(left_use, []), NamedType(right_use, [])):
															(is_abstract(preview.body_presence) and preview.header.span.covers(0, 6)
																and x.binder.binder_local_index() == 0 and discard_name.binder.binder_local_index() == 1 and a.binder.binder_local_index() == 2 and b.binder.binder_local_index() == 3
																and wildcard_span.covers(21, 22) and tuple_binding.span.covers(32, 38)
																and first.span.covers(7, 19) and discard.span.covers(24, 30) and pair.span.covers(32, 51)
																and int_type.id.written_type_local_index() == 0 and list_type.id.written_type_local_index() == 1 and discard_type.id.written_type_local_index() == 2
																and left.id.written_type_local_index() == 3 and right.id.written_type_local_index() == 4 and tuple_type.id.written_type_local_index() == 5
																and list_name.use.name_use_local_index() == 0 and int_use.use.name_use_local_index() == 1 and discard_use.use.name_use_local_index() == 2 and left_use.use.name_use_local_index() == 3 and right_use.use.name_use_local_index() == 4
																and parsed.issued_counts().binders == 4 and parsed.issued_counts().written_types == 6 and parsed.issued_counts().name_uses == 5 and parsed.issued_counts().dimensions == 0
																and parsed.current_kind() == EndOfFileToken and parsed.current_span().covers(52, 52) and parsed.position() == 28 and parsed.diagnostic_count() == 0 and no_parent_or_body_ids(parsed))
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


-- Heads stop at body entry; completion owns syntax and its sibling boundary.
private pure func completed_default(text: String, advance: Int, header_first: Int, header_last: Int, body_first: Int, body_last: Int, next_first: Int, token_first: Int, token_last: Int) -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(initial):
			var state = initial
			for _ in 0..advance:
				state = state.advanced()
			(parsed, result) = parse_trait_method_head(state)
			match result:
				ParsedTraitMethodHead(head):
					(completed, body) = complete_body(parsed)
					match body:
						Recognized(body):
							(head.body_presence == DefaultBodyFollows and head.header.span.covers(header_first, header_last)
								and parsed.position() == token_first and no_parent_or_body_ids(parsed)
								and body.span.covers(body_first, body_last) and completed.position() == token_last
								and completed.current_kind() == FuncKeyword and completed.current_span().covers(next_first, next_first + 4)
								and completed.diagnostic_count() == 0)
						_: False
				_: False
		Err(_): False


pure func test_completed_default_bodies_preserve_sibling_boundaries() -> Bool:
	(completed_default("func f(): 1 + 2\nfunc g()", 0, 0, 6, 10, 15, 16, 5, 9)
		and completed_default("func f():\n\t1\nfunc g()", 0, 0, 6, 11, 12, 13, 5, 9)
		and completed_default("func f():\n-- comment\n\n\t1\nfunc g()", 0, 0, 6, 23, 24, 25, 5, 9)
		and completed_default("func f(): if True:\n\t\t\t1\nelse if False:\n\t\t\t2\nelse:\n\t\t\t3\nfunc g()", 0, 0, 6, 10, 54, 55, 5, 26)
		and completed_default("outer\n\tfunc f():\n\t\t1\n\tfunc g()", 3, 7, 13, 19, 20, 22, 8, 12)
		and completed_default("func f(): foo(\n\t1,\n\t2,\n)\nfunc g()", 0, 0, 6, 10, 24, 25, 5, 13))


pure func test_sequential_abstract_and_default_headers_do_not_leak_state() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "func f()\npure func g(): 1")):
		Ok(state):
			(first_state, first_result) = parse_trait_method_head(state)
			(second_state, second_result) = parse_trait_method_head(first_state.advanced())
			match (first_result, second_result):
				(ParsedTraitMethodHead(first), ParsedTraitMethodHead(second)):
					match (first.body_presence, second.body_presence):
						(AbstractMethod, DefaultBodyFollows):
							(first.header.span.covers(0, 6) and first.header.signature.purity == ImpureFunction and first.header.signature.name.span.covers(5, 6)
								and first_state.current_kind() == NewlineToken and first_state.current_span().covers(9, 9) and first_state.position() == 4
								and second.header.span.covers(9, 20) and second.header.signature.purity == PureFunction and second.header.signature.keyword.covers(14, 18) and second.header.signature.name.span.covers(19, 20)
								and second_state.current_span().covers(24, 25)
								and second_state.current_kind() == IntLiteralToken and second_state.position() == 11 and second_state.diagnostic_count() == 0
								and second_state.issued_counts().binders == 0 and second_state.issued_counts().written_types == 0 and no_parent_or_body_ids(second_state))
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_direct_leaf_tolerates_preexisting_diagnostics() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "func f()")):
		Ok(state):
			(parsed, result) = parse_trait_method_head(state.report_at_current(ExpectedSupertraitOrMethodsDiagnostic))
			match result:
				ParsedTraitMethodHead(preview):
					match parsed.diagnostics():
						[diagnostic]:
							(is_preexisting_diagnostic(diagnostic.diagnostic) and diagnostic.span.covers(0, 0)
								and is_abstract(preview.body_presence) and preview.header.span.covers(0, 6) and parsed.current_kind() == EndOfFileToken
								and parsed.current_span().covers(8, 8) and parsed.position() == 4 and no_parent_or_body_ids(parsed))
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_leading_else_keeps_the_missing_body_diagnostic() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "func f(): else:")):
		Ok(entry):
			(state, parsed) = parse_trait_method_head(entry)
			match parsed:
				RejectedTraitMethodHead:
					match reject_preview(state):
						Ok(rejected):
							match render_rejected_diagnostics(rejected):
								Ok([diagnostic]):
									(state.current_kind() == ElseKeyword and state.current_span().covers(10, 14) and state.position() == 5
										and diagnostic.span.covers(5, 6) and diagnostic.rendered.message == "function has no body"
										and diagnostic.rendered.help == Some("a function body must have at least one expression or statement, indented on the lines below the header; write `void` for a body that does nothing"))
								_: False
						_: False
				_: False
		Err(_): False


tests: TestSuite = {
	description = "Trait method heads and completed default-body boundaries",
	tests = [
		("leading else keeps missing-body diagnostic", test_leading_else_keeps_the_missing_body_diagnostic),
		("abstract header frozen endpoint and purity", test_abstract_header_ends_at_name_unless_return_is_written),
		("grouped return consumes close without extending header", test_grouped_return_consumes_close_without_extending_header),
		("where remains for trait owner", test_where_remains_for_the_trait_owner),
		("bad names and parameters consume authored suffix", test_bad_names_and_parameters_recover_through_authored_suffix),
		("unsupported prefixes recover and generics remain", test_unsupported_prefixes_use_leaf_recovery_and_generics_stay_unconsumed),
		("authored colon requires promised body", test_authored_colon_requires_body_at_eof_dedent_or_unindented_line),
		("parameter children keep IDs without parent", test_parameter_children_keep_source_order_without_parent_definition),
		("completed default bodies preserve sibling boundaries", test_completed_default_bodies_preserve_sibling_boundaries),
		("sequential methods do not leak state", test_sequential_abstract_and_default_headers_do_not_leak_state),
		("direct leaf tolerates existing diagnostics", test_direct_leaf_tolerates_preexisting_diagnostics)
	]
}
