tests: TestSuite = {
	description = "Bounded module declaration evidence and explicit scan stops",
	tests = [
		("fixed union scan keeps children and sibling ids", test_fixed_union_scan_keeps_children_and_sibling_ids),
		("expression scan operator global and function boundary", test_expression_scan_completes_operator_global_then_preserves_function_boundary),
		("expression scan unsupported control argument exact handoff", test_expression_scan_defers_unsupported_control_argument_without_minting_expression_ids),
		("expression scan vector missing its comma exact handoff", test_expression_scan_defers_vector_missing_its_comma_without_minting_expression_ids),
		("expression scan postfix global and record boundary", test_expression_scan_completes_postfix_global_then_record),
		("expression scan list global and record boundary", test_expression_scan_completes_list_global_then_record),
		("expression scan tuple global and record boundary", test_expression_scan_completes_tuple_global_then_record),
		("expression scan braced global and record boundary", test_expression_scan_completes_braced_global_then_record),
		("empty blank comment eof", test_empty_blank_and_comment_modules_reach_eof_without_nodes),
		("completed order and newlines", test_completed_leaves_keep_source_order_and_newlines),
		("module and declaration documentation", test_module_documentation_and_later_declaration_documentation_are_separate),
		("body previews carry only lexical evidence", test_function_trait_and_implementation_keep_only_lexical_body_evidence),
		("global hard stop retains prior previews", test_global_initializer_handoff_retains_prior_previews_and_next_tokens),
		("rejected global preserves initializer", test_rejected_global_handoff_does_not_skip_initializer_or_sibling),
		("generic fixed record scan completes", test_generic_fixed_record_scan_completes),
		("rejected declaration sibling boundary", test_rejected_declaration_stops_after_its_one_token_recovery),
		("lexical diagnostic retained at eof", test_lexical_diagnostic_survives_reached_eof_without_claiming_acceptance),
		("unpaired forward deferred final pairing", test_unpaired_forward_is_retained_without_final_pairing_diagnostic)
	]
}
