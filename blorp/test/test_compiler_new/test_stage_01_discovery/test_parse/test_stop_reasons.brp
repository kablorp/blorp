-- Every declaration the completing scan leaves as a skipped-body preview says
-- why: the rollback's own result names the construct and the token it stood at.
-- Each case is a shape one slice leaves to a later one; the expected reason is
-- the construct, never a message.
import:
	../../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../../src/compiler_new/stage_01_discovery/parse/parse_state: ParseState, new_parse_state, span_start_line
	../../../../src/compiler_new/stage_01_discovery/parse/stop_reason: StopReason
	../../../../src/compiler_new/stage_01_discovery/parse/tree_module_declaration_scan:
		DeclinedDeclaration, DeclinedKind(DeclinedFunction, DeclinedTrait, DeclinedImplementation, DeclinedGlobalInitializer),
		scan_module_declaration_prefix_with_bodies, scan_module_declaration_previews
	../../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_at_row
	../../support/stop_reason_label: declined_kind_label, stop_reason_label
	test: TestSuite


private pure func source_lines(lines: List[String]) -> String:
	lines.join("\n") + "\n"


-- An interpolation hole, spelled without opening one in this file's own string.
private pure func hole(text: String) -> String:
	"$" + "{" + text + "}"


-- The state after the scan, and the first declaration it could not complete.
private pure func first_declined(text: String) -> Option[(ParseState, DeclinedDeclaration)]:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(entry):
			(state, scan) = scan_module_declaration_prefix_with_bodies(entry)
			match scan.declined.get(0):
				Some(declined): Some((state, declined))
				None: None
		Err(_):
			None


-- The body of a function `f`, one statement per line, each indented once.
private pure func function_with(statements: List[String]) -> String:
	source_lines(["func f(xs: List[Int], c: Bool) -> Int:"].concat(statements.map(pure func(statement): "\t" + statement)))


private func declines_as(label: String, text: String, kind: DeclinedKind, reason: StopReason) -> Bool:
	match first_declined(text):
		Some((_, declined)):
			if declined.kind == kind and declined.stop.reason == reason:
				True
			else:
				print("${label}: declined as ${declined.kind.declined_kind_label()} ${declined.stop.reason.stop_reason_label()}")
				False
		None:
			print("${label}: nothing was declined")
			False


func test_expression_shapes_are_named() -> Bool:
	var correct: Bool = True
	for (label, statements, reason) in [
		("method chain on an unindented dot", ["x = xs", ".length()", "x"], LeadingDotContinuation),
		("method chain on an indented dot", ["x = xs", "\t.length()", "x"], IndentedMethodChain),
		("token after a complete expression", ["x = 1 2", "x"], TokenAfterExpression),
		("operand after an operator", ["x = 1 +", "\t2", "x"], OperatorOperandOnNextLine),
		("call arguments across lines", ["x = f(1,", "\t2)", "x"], MultilineCallArguments),
		("call opened on its own line", ["x = f(", "\t1)", "x"], MultilineCallArguments),
		("list across lines", ["x = [1,", "\t2]", "x"], MultilineListLiteral),
		("tuple across lines", ["x = (1,", "\t2)", "x"], MultilineTuple),
		("grouping across lines", ["x = (1 +", "\t2)", "x"], OperatorOperandOnNextLine),
		("record fields on the line after the brace", ["x = {", "\ta = 1}", "x"], MultilineBracedOpening),
		("record update fields on the next line", ["x = {c |", "\ta = 1}", "x"], MultilineRecordUpdate),
		("soft keyword record field", ["x = {on = 1}", "x"], SoftKeywordFieldName),
		("control expression written on one line", ["x = g(if c: 1 else: 2)", "x"], BlockWithoutIndent),
		("match operand without a block", ["x = 1 + match c: 1", "x"], MatchWithoutBlock),
		("operator after a control expression", ["x = if c:", "\t1", "else:", "\t2", "+ 1", "x"], OperatorAfterBlock),
		("value on the line after its operator", ["x =", "\t1", "x"], ValueOnNextLine),
		("operator without a left operand", ["x = * 2", "x"], OperatorWithoutLeftOperand),
		("punctuation where an expression begins", ["x = ,", "x"], PunctuationInExpression),
		("statement keyword where an expression begins", ["x = while", "x"], StatementKeywordInExpression),
		("declaration keyword where an expression begins", ["x = record", "x"], DeclarationKeywordInExpression),
		("loop exit as a value", ["x = break", "x"], LoopExitInExpression),
		("opaque conversion", ["x = into_opaque Handle(1)", "x"], OpaqueConversion),
		("lambda header without parameters", ["x = func g(): 1", "x"], MalformedLambdaHeader),
		("hole holding a lambda", ["x = \"" + hole("g(func(y: Int): y)") + "\"", "x"], LambdaInInterpolationHole),
		("empty hole", ["x = \"" + hole("") + "\"", "x"], InterpolationHoleRejected),
		("hole with a second expression", ["x = \"" + hole("a b") + "\"", "x"], InterpolationHoleTrailingTokens),
		("hole that does not lex", ["x = \"" + hole("\\\"") + "\"", "x"], InterpolationHoleNotLexed)
	]:
		correct = declines_as(label, function_with(statements), DeclinedFunction, reason) and correct
	correct


func test_a_soft_keyword_is_a_block_only_with_the_shape_of_one() -> Bool:
	var correct: Bool = True
	for (label, statements, reason) in [
		("debug block as a value", ["x = debug:", "\t\tuse(1)", "0"], DebugBlock),
		("debug as a name", ["debug = 1", "0"], SoftKeywordName),
		("select block as an operand", ["x = 1 + select:", "\t\t_ after 1:", "\t\t\tuse(1)", "0"], SelectBlock),
		("select as a name", ["select = 1", "0"], SoftKeywordName),
		("concurrent block as a value", ["x = concurrent:", "\t\tuse(1)", "0"], ConcurrentBlock),
		("concurrent block with parameters as a value", ["x = concurrent(max_threads: 2):", "\t\tuse(1)", "0"], ConcurrentBlock),
		("concurrent as a name", ["concurrent = 1", "0"], SoftKeywordName),
		("with block as a value", ["x = with r = open():", "\t\tuse(r)", "0"], WithBlock),
		("with as a name", ["with = 1", "0"], SoftKeywordName),
		("after as a name", ["after = 1", "0"], SoftKeywordName)
	]:
		correct = declines_as(label, function_with(statements), DeclinedFunction, reason) and correct
	correct


func test_block_forms_are_named_where_they_are_declined() -> Bool:
	var correct: Bool = True
	for (label, statements, reason) in [
		("select without arms", ["select:", "0"], SelectWithoutArms),
		("select whose block holds no arm", ["select:", "\t-- nothing"], SelectNotClosed),
		("select arm that waits for nothing", ["select:", "\t1:", "\t\tuse(1)"], SelectArmMalformed),
		("select receive arm without from", ["select:", "\tv xs:", "\t\tuse(v)", "0"], SelectArmMalformed),
		("with without a binding", ["with 1:", "\tuse(1)", "0"], WithBindingMalformed),
		("with without a colon", ["with r = open()", "\tuse(r)", "0"], WithHeaderWithoutColon),
		("with two bindings", ["with r = open(), s = open():", "\tuse(r)", "0"], WithHeaderWithoutColon),
		("with an error map on a plain binding", ["with r = open() on e => 0:", "\tuse(r)", "0"], WithHeaderWithoutColon),
		("with an error map without an arrow", ["with r ?= open() on e 0:", "\tuse(r)", "0"], WithErrorMapMalformed),
		("concurrent without a colon", ["concurrent", "0"], SoftKeywordName),
		("concurrent parameters without a colon", ["concurrent(max_threads: 2)", "\tuse(1)", "0"], ConcurrentHeaderWithoutColon),
		("concurrent without parameters in its parentheses", ["concurrent():", "\tuse(1)", "0"], ConcurrentParametersMalformed),
		("concurrent parameter without a value", ["concurrent(max_threads 2):", "\tuse(1)", "0"], ConcurrentParametersMalformed),
		("concurrent parameter that is not known", ["concurrent(limit: 2):", "\tuse(1)", "0"], ConcurrentParameterUnknown),
		("concurrent parameter written twice", ["concurrent(timeout: 1, timeout: 2):", "\tuse(1)", "0"], ConcurrentParameterRepeated),
		("concurrent count that is not a positive literal", ["concurrent(max_threads: 0):", "\tuse(1)", "0"], ConcurrentCountNotLiteral),
		("debug with its body on its line", ["debug: use(1)", "0"], BlockWithoutIndent)
	]:
		correct = declines_as(label, function_with(statements), DeclinedFunction, reason) and correct
	correct


func test_statement_shapes_are_named() -> Bool:
	var correct: Bool = True
	for (label, statements, reason) in [
		("concurrent loop", ["for x in xs concurrently(max_threads: 2):", "\tuse(x)", "0"], ConcurrentlyLoop),
		("question binding in a loop", ["for x in xs:", "\ty ?= use(x)", "0"], QuestionBindingInLoop),
		("break outside a loop", ["break"], LoopExitOutsideLoop),
		("field assignment", ["c.field = 1", "0"], FieldAssignment),
		("tuple destructuring", ["(a, b) = use(1)", "0"], TupleDestructuring),
		("assignment to a call", ["use(1) = 2", "0"], NonPlaceAssignmentTarget),
		("var without a name", ["var (a, b) = use(1)", "0"], VarWithoutName),
		("var without an initializer", ["var x: Int", "0"], VarWithoutInitializer),
		("typed binding without a value", ["x: Int", "0"], MalformedTypedBinding),
		("type with a diagnostic", ["x: = 2", "0"], InvalidType),
		("if without a colon", ["if c", "\t1", "0"], HeaderWithoutColon),
		("for without in", ["for x xs:", "\tuse(x)", "0"], ForWithoutIn),
		("for over a non-binder", ["for 1 in xs:", "\tuse(1)", "0"], InvalidLoopBinding),
		("while without an indented block", ["while c:", "0"], BlockWithoutIndent),
		("else that opens nothing", ["if c:", "\tuse(1)", "else use(2)", "0"], MalformedElse),
		("operator after an else block", ["x = if c:", "\t1", "else:", "\t2", "+ 3"], OperatorAfterBlock),
		("match without an indented block", ["match c:", "0"], MatchWithoutBlock),
		("match whose block holds no case", ["match c:", "\t-- nothing"], MatchNotClosed),
		("block that holds no statement", ["while c:", "\t-- nothing", "0"], BlockNotClosed),
		("case without a colon", ["match c:", "\tTrue 1", "0"], CaseWithoutColon),
		("case pattern with a diagnostic", ["match c:", "\t): 1", "0"], InvalidPattern),
		("case with a nested block on its line", ["match c:", "\tTrue: if c:", "\t\t1", "0"], NestedBlockInCaseLine)
	]:
		correct = declines_as(label, function_with(statements), DeclinedFunction, reason) and correct
	correct


func test_the_rollback_is_located_at_the_construct() -> Bool:
	text = function_with(["a = 1", "b = 2", "x = g(if c: 1 else: 2)", "x"])
	match first_declined(text):
		Some((state, declined)):
			-- Line 0 is the header; the control expression is the fourth line of the body.
			state.span_start_line(declined.stop.at) == 3
		None:
			False


func test_owners_and_globals_decline_with_their_own_kind() -> Bool:
	var correct: Bool = True
	correct = declines_as("global initializer", source_lines(["x = {on = 1}"]), DeclinedGlobalInitializer, SoftKeywordFieldName) and correct
	correct = declines_as(
		"implementation method",
		source_lines(["implements Show for Int:", "\tfunc show(x: Int) -> Int:", "\t\tg(if c: 1 else: 2)"]),
		DeclinedImplementation, BlockWithoutIndent,
	) and correct
	correct = declines_as(
		"trait default method",
		source_lines(["trait Show:", "\tfunc show(x: Int) -> Int:", "\t\tg(if c: 1 else: 2)"]),
		DeclinedTrait, BlockWithoutIndent,
	) and correct
	correct


pure func test_a_scan_without_bodies_declines_nothing() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), function_with(["x = g(if c: 1 else: 2)", "x"]))):
		Ok(entry):
			(_, scan) = scan_module_declaration_previews(entry)
			scan.declined.is_empty()
		Err(_):
			False


tests: TestSuite = {
	description = "Stop reasons of declined declarations",
	tests = [
		("expression shapes are named", test_expression_shapes_are_named),
		("a soft keyword is a block only with the shape of one", test_a_soft_keyword_is_a_block_only_with_the_shape_of_one),
		("statement shapes are named", test_statement_shapes_are_named),
		("the rollback is located at the construct", test_the_rollback_is_located_at_the_construct),
		("owners and globals decline with their own kind", test_owners_and_globals_decline_with_their_own_kind),
		("a scan without bodies declines nothing", test_a_scan_without_bodies_declines_nothing)
	]
}
