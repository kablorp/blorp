-- Global initializers read through the declaration scan: checked literals,
-- names, the id order of header, value and global, and the exact state an
-- initializer the expression parser does not read leaves behind.
import:
	../../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../../src/compiler_new/stage_01_discovery/parse/parse_state:
		ParseState, new_parse_state, position, current_kind, issued_counts, diagnostic_count, diagnostics, spellings, consume_declared_name, finished_builtin_type
	../../../../src/compiler_new/stage_01_discovery/parse/tree_module_declaration_scan:
		ModuleDeclarationScan, scan_module_declarations, ModuleDeclarationScanStop(ReachedEndOfSource, StoppedAtUnreadDeclaration, StoppedAtRejectedGlobalInitializer),
		UnreadHeader(UnreadGlobalInitializer)
	../../../../src/compiler_new/stage_01_discovery/parse/tree_global_header_parser: GlobalHeaderPreview
	../../../../src/compiler_new/stage_01_discovery/syntax/module_syntax: ModuleItem(GlobalItem, RecordItem)
	../../../../src/compiler_new/stage_01_discovery/syntax/expressions: ExpressionKind(NameReference, IntegerLiteral, FloatLiteral, FieldAccess)
	../../../../src/compiler_new/stage_01_discovery/syntax/checked_values: written_digits
	../../../../src/compiler_new/stage_01_discovery/syntax/declarations: GlobalDeclaration, GlobalForm(ConstantGlobal, MutableGlobal)
	../../../../src/compiler_new/stage_01_discovery/syntax/ids:
		name_use_local_index, expression_local_index, definition_local_index
	../../../../src/compiler_new/stage_01_discovery/syntax/spellings: spelling_text
	../../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_at_row
	../../../../src/compiler_new/stage_01_discovery/tables/expected_token: NameConstruct(NameInTypeName)
	../../../../src/compiler_new/stage_01_discovery/tables/row_kinds: Visibility(PublicVisibility, PrivateVisibility)
	../../../../src/compiler_new/stage_01_discovery/tables/span: span_start, span_end, spans_equal
	../../../../src/compiler_new/stage_01_discovery/tables/token: TokenKind(EndOfFileToken)
	../../../../src/compiler_new/stage_01_discovery/syntax/diagnostics: SyntaxDiagnostic(Plain)
	../../../../src/compiler_new/stage_01_discovery/tables/diagnostic_code: PlainSyntaxCode(ExpectedExpressionDiagnostic)
	test: TestSuite


private INT128_MAX_DIGITS: String = "170141183460469231731687303715884105727"


-- The lexer accepts finite underflow as zero while retaining decimal digits.
private FLOAT_UNDERFLOW_LITERAL: String = "0."

private FLOAT_OVERFLOW_LITERAL: String = ".0"


private pure func scanned(text: String) -> Option[(ParseState, ModuleDeclarationScan)]:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(entry):
			Some(scan_module_declarations(entry))
		Err(_):
			None


-- The one global `text` declares, read in full, with the state after the scan.
-- A declaration after it, if any, must have been read too.
private pure func read_global(text: String, declarations: Int) -> Option[(ParseState, GlobalDeclaration)]:
	match scanned(text):
		Some((state, scan)):
			match (scan.stop, scan.items.get(0)):
				(ReachedEndOfSource, Some(GlobalItem(global_value))):
					if scan.items.length() == declarations and state.diagnostic_count() == 0:
						Some((state, global_value))
					else:
						None
				_:
					None
		None:
			None


-- The global the scan stopped at, when its initializer was not read.
private pure func unread_global(scan: ModuleDeclarationScan) -> Option[GlobalHeaderPreview]:
	match scan.stop:
		StoppedAtUnreadDeclaration(unread):
			match unread.header:
				UnreadGlobalInitializer(global_value): Some(global_value)
				_: None
		_:
			None


-- The definition index the mint would issue next.
private pure func next_definition(state: ParseState, global_value: GlobalDeclaration) -> Int:
	(_, witness) = state.finished_builtin_type(PublicVisibility, None, global_value.name, [], global_value.name.span)
	witness.id.definition_local_index()


pure func test_float_initializer_preserves_checked_digits_without_name_ids() -> Bool:
	var correct: Bool = True
	for digits in ["0.0", "007.00", "1.23456789012345678901234567890123456789", "0.000000000000000000000000000000000000001", FLOAT_UNDERFLOW_LITERAL]:
		text = "value = ${digits}"
		match read_global(text, 1):
			Some((state, global_value)):
				match global_value.value.kind:
					FloatLiteral(value):
						counts = state.issued_counts()
						correct = (correct and value.written_digits() == digits
							and global_value.value.span.span_start() == "value = ".length() and global_value.value.span.span_end() == text.length()
							and global_value.span.span_start() == 0 and global_value.span.span_end() == text.length()
							and global_value.value.id.expression_local_index() == 0 and global_value.id.definition_local_index() == 0
							and state.next_definition(global_value) == 1 and counts.expressions == 1 and counts.name_uses == 0
							and counts.binders == 0 and counts.type_binders == 0 and counts.statements == 0 and counts.blocks == 0
							and state.current_kind() == EndOfFileToken)
					_: correct = False
			None: correct = False
	correct


-- A trailing comment ends the value, and a later declaration is read after it.
pure func test_float_initializer_preserves_rich_header_and_comment_boundary() -> Bool:
	var correct: Bool = True
	for (suffix, declarations) in [(" -- comment", 1), (" -- comment\n-- next comment\nrecord Later {}", 2)]:
		text = "---\nDocs\n---\nprivate var values: m.Buffer[Int][#N] = 007.00${suffix}"
		match read_global(text, declarations):
			Some((state, global_value)):
				match global_value.value.kind:
					FloatLiteral(value):
						counts = state.issued_counts()
						correct = (correct and value.written_digits() == "007.00" and global_value.form == MutableGlobal and global_value.visibility == PrivateVisibility
							and global_value.documentation.map(pure func(doc): doc.text) == Some("Docs") and global_value.declared_type.is_some()
							and counts.name_uses == 4 and counts.written_types == 3 and counts.dimensions == 1 and counts.expressions == 1
							and global_value.value.id.expression_local_index() == 0 and global_value.id.definition_local_index() == 0
							and global_value.span.span_end() == text.length() - suffix.length())
					_: correct = False
			None: correct = False
	correct


pure func test_integer_initializer_uses_checked_magnitude_without_name_ids() -> Bool:
	var correct: Bool = True
	for digits in ["0", "007", "9223372036854775808", INT128_MAX_DIGITS, "000" + INT128_MAX_DIGITS]:
		text = "value = ${digits}"
		match read_global(text, 1):
			Some((state, global_value)):
				match global_value.value.kind:
					IntegerLiteral(magnitude):
						counts = state.issued_counts()
						-- Leading zeros change authored span, not the magnitude.
						canonical = if digits == "007":
							"7"
						else if digits == "000" + INT128_MAX_DIGITS:
							INT128_MAX_DIGITS
						else:
							digits
						correct = (correct and magnitude.to_string() == canonical
							and global_value.value.span.span_start() == "value = ".length() and global_value.value.span.span_end() == text.length()
							and global_value.span.span_start() == 0 and global_value.span.span_end() == text.length()
							and global_value.value.id.expression_local_index() == 0 and global_value.id.definition_local_index() == 0
							and state.next_definition(global_value) == 1 and counts.expressions == 1 and counts.name_uses == 0
							and counts.binders == 0 and counts.type_binders == 0 and counts.statements == 0 and counts.blocks == 0
							and state.current_kind() == EndOfFileToken)
					_: correct = False
			None: correct = False
	correct


pure func test_integer_initializer_preserves_rich_header_and_comment_boundary() -> Bool:
	var correct: Bool = True
	for (suffix, declarations) in [(" -- comment", 1), (" -- comment\n-- next comment\nrecord Later {}", 2)]:
		text = "---\nDocs\n---\nprivate var values: m.Buffer[Int][#N] = 007${suffix}"
		match read_global(text, declarations):
			Some((state, global_value)):
				match global_value.value.kind:
					IntegerLiteral(magnitude):
						counts = state.issued_counts()
						correct = (correct and magnitude.to_string() == "7" and global_value.form == MutableGlobal and global_value.visibility == PrivateVisibility
							and global_value.documentation.map(pure func(doc): doc.text) == Some("Docs") and global_value.declared_type.is_some()
							and counts.name_uses == 4 and counts.written_types == 3 and counts.dimensions == 1 and counts.expressions == 1
							and global_value.value.id.expression_local_index() == 0 and global_value.id.definition_local_index() == 0
							and global_value.span.span_end() == text.length() - suffix.length())
					_: correct = False
			None: correct = False
	correct


pure func test_name_initializer_mints_use_expression_then_global() -> Bool:
	text = "target = Source"
	match read_global(text, 1):
		Some((state, global_value)):
			match global_value.value.kind:
				NameReference(use):
					counts = state.issued_counts()
					(global_value.form == ConstantGlobal and global_value.visibility == PublicVisibility
						and state.spellings().spelling_text(global_value.name.spelling) == Some("target")
						and state.spellings().spelling_text(use.name.spelling) == Some("Source")
						and use.use.name_use_local_index() == 0 and global_value.value.id.expression_local_index() == 0
						and global_value.id.definition_local_index() == 0
						and global_value.span.span_start() == 0 and global_value.span.span_end() == text.length()
						and global_value.value.span.spans_equal(use.name.span) and use.name.span.span_start() == 9
						and counts.name_uses == 1 and counts.expressions == 1 and counts.binders == 0
						and counts.statements == 0 and counts.blocks == 0 and counts.written_types == 0
						and state.current_kind() == EndOfFileToken)
				_: False
		None: False


pure func test_rich_header_ids_precede_value_and_completed_owner() -> Bool:
	text = "---\nDocs\n---\nprivate var values: m.Buffer[Int][#N] = Source\nrecord Later {}"
	match scanned(text):
		Some((state, scan)):
			match (scan.stop, scan.items):
				(ReachedEndOfSource, [GlobalItem(global_value), RecordItem(later)]):
					match global_value.value.kind:
						NameReference(use):
							counts = state.issued_counts()
							(global_value.form == MutableGlobal and global_value.visibility == PrivateVisibility
								and global_value.documentation.map(pure func(doc): doc.text) == Some("Docs")
								and global_value.declared_type.is_some() and global_value.span.span_start() == 0
								and global_value.span.span_end() == text.length() - "\nrecord Later {}".length()
								and counts.name_uses == 5 and counts.written_types == 3 and counts.dimensions == 1
								and counts.expressions == 1 and counts.binders == 0 and counts.statements == 0 and counts.blocks == 0
								and use.use.name_use_local_index() == 4 and global_value.value.id.expression_local_index() == 0
								and global_value.id.definition_local_index() == 0 and later.id.definition_local_index() == 1
								and state.diagnostic_count() == 0)
						_: False
				_: False
		None: False


pure func test_comment_and_blank_lines_preserve_unconsumed_boundary() -> Bool:
	var correct: Bool = True
	for (suffix, declarations) in [(" -- comment", 1), (" -- comment\n", 1), ("\n-- comment\n\nrecord Later {}", 2)]:
		text = "target = self${suffix}"
		match read_global(text, declarations):
			Some((_, global_value)):
				correct = correct and global_value.span.span_end() == "target = self".length()
			None: correct = False
	correct


pure func test_continued_global_fields_keep_spans_and_postorder_ids() -> Bool:
	var correct = True
	for initializer in ["Source\n.field", "Source\n\n.field", "Source\n-- comment\n.field", "Source\n\t.field", "1\n.field", "1\n\t.field", "1.0\n.field", "1.0\n\t.field"]:
		suffix = "\nrecord Later {}"
		text = "value: Int = ${initializer}${suffix}"
		match read_global(text, 2):
			Some((state, global_value)):
				match global_value.value.kind:
					FieldAccess(receiver, field):
						(receiver_matches, value_names) = match receiver.kind:
							NameReference(use):
								(state.spellings().spelling_text(use.name.spelling) == Some("Source") and use.use.name_use_local_index() == 1, 2)
							IntegerLiteral(magnitude): (magnitude.to_string() == "1", 1)
							FloatLiteral(value): (value.written_digits() == "1.0", 1)
							_: (False, 0)
						counts = state.issued_counts()
						correct = (correct and receiver_matches and state.spellings().spelling_text(field.name.spelling) == Some("field")
							and receiver.span.span_start() == "value: Int = ".length()
							and field.name.span.span_end() == text.length() - suffix.length()
							and global_value.value.span.span_start() == receiver.span.span_start()
							and global_value.value.span.span_end() == field.name.span.span_end()
							and global_value.span.span_start() == 0 and global_value.span.span_end() == field.name.span.span_end()
							and receiver.id.expression_local_index() == 0 and global_value.value.id.expression_local_index() == 1
							and field.use.name_use_local_index() == value_names and counts.name_uses == value_names + 1
							and counts.expressions == 2 and counts.written_types == 1 and counts.statements == 0 and counts.blocks == 0
							and global_value.id.definition_local_index() == 0 and state.next_definition(global_value) == 2
							and state.current_kind() == EndOfFileToken)
					_: correct = False
			None: correct = False
	correct


-- Each shape here is one the expression parser does not read yet, or one it
-- reads as a different expression than a whole initializer. The scan stops at
-- the initializer with only the header's ids issued: one written type and its
-- name use, no expression and no definition.
func test_unsupported_initializer_returns_exact_authoritative_state() -> Bool:
	var correct: Bool = True
	for initializer in ["Count(\n\t(func():\n\t\tBodyName + Count(func(): 1)\n\t+ Count)\n)", "\n\t|first " + "$" + "{a} second " + "$" + "{b c}", "Source Other", "123 Other", "Self", "\n\tSource\n\tOther", "Source\n\t.field\n\tOther", "Source\n\tOther", "Source\n\t+ Other", "Source, Other", "1.5 Other", "0x4", "1_000", "\n\t1\n\t2", "1\n\tOther", "\n\t1.0\n\t2.0", "1.0\n\tOther", ".5", "1e3", "1.0e3", "1.0f", "1.0_0"]:
		text = "value: Int = ${initializer}"
		match scanned(text):
			Some((state, scan)):
				match scan.unread_global():
					Some(preview):
						counts = state.issued_counts()
						(_, witness) = state.finished_builtin_type(PublicVisibility, None, preview.header.name, [], preview.header.name.span)
						if not (scan.items.is_empty() and state.position() == preview.initializer.token_start and state.diagnostic_count() == 0
							and witness.id.definition_local_index() == 0 and counts.written_types == 1 and counts.name_uses == 1
							and counts.expressions == 0 and counts.dimensions == 0 and counts.type_binders == 0 and counts.binders == 0
							and counts.statements == 0 and counts.blocks == 0 and counts.patterns == 0):
							print("not rolled back exactly: ${initializer}")
							correct = False
					_:
						print("not stopped at the initializer: ${initializer}")
						correct = False
			None: correct = False
	correct


-- A literal out of range is the lexer's diagnostic. The initializer that holds
-- it is not read, and nothing past the header is minted.
pure func test_out_of_range_literal_leaves_initializer_unread() -> Bool:
	var correct: Bool = True
	for literal in ["170141183460469231731687303715884105728", FLOAT_OVERFLOW_LITERAL]:
		match scanned("value: Int = ${literal}"):
			Some((state, scan)):
				match scan.unread_global():
					Some(preview):
						counts = state.issued_counts()
						correct = (correct and scan.items.is_empty() and state.position() == preview.initializer.token_start
							and state.diagnostic_count() == 1 and counts.expressions == 0 and counts.written_types == 1)
					_: correct = False
			None: correct = False
	correct


-- An `=` with no value before the end of the source is rejected where the
-- source ends, as the frozen parser reports it ("expected expression" at the
-- end), whether or not a newline follows the `=`.
pure func test_missing_initializer_at_end_of_source_is_rejected_at_the_end() -> Bool:
	var correct: Bool = True
	for text in ["x =", "x =\n"]:
		match scanned(text):
			Some((state, scan)):
				match (scan.stop, state.diagnostics().get(0)):
					(StoppedAtRejectedGlobalInitializer(_), Some(at)):
						expected_expression: Bool = match at.diagnostic:
							Plain(ExpectedExpressionDiagnostic): True
							_: False
						correct = correct and expected_expression and state.diagnostic_count() == 1 and at.span.span_start() == text.length()
					_: correct = False
			None: correct = False
	correct


pure func test_scan_completes_prefix_and_preserves_next_deferred_mint() -> Bool:
	text = "first = Source\nsecond = Source\nblocked: Int = Unsupported Other\nrecord Later {}"
	match scanned(text):
		Some((state, scan)):
			match (scan.items, scan.unread_global()):
				([GlobalItem(first), GlobalItem(second)], Some(blocked)):
					counts = state.issued_counts()
					(_, witness) = state.finished_builtin_type(PublicVisibility, None, blocked.header.name, [], blocked.header.name.span)
					match (first.value.kind, second.value.kind):
						(NameReference(first_use), NameReference(second_use)):
							(first.id.definition_local_index() == 0 and second.id.definition_local_index() == 1 and witness.id.definition_local_index() == 2
								and first_use.use.name_use_local_index() == 0 and second_use.use.name_use_local_index() == 1
								and first.value.id.expression_local_index() == 0 and second.value.id.expression_local_index() == 1
								and counts.expressions == 2 and counts.name_uses == 3 and counts.written_types == 1
								and counts.statements == 0 and counts.blocks == 0 and counts.binders == 0
								and state.position() == blocked.initializer.token_start and state.diagnostic_count() == 0)
						_: False
				_: False
		None: False


pure func test_prefix_diagnostic_cannot_complete_global_body() -> Bool:
	text = "@no_copy value = Source"
	match scanned(text):
		Some((state, scan)):
			match scan.stop:
				StoppedAtRejectedGlobalInitializer(start):
					counts = state.issued_counts()
					match new_parse_state(lex_module(module_id_at_row(0), "Witness")):
						Ok(witness_entry):
							(_, witness_name) = witness_entry.consume_declared_name(NameInTypeName)
							match witness_name:
								Some(name):
									(_, witness) = state.finished_builtin_type(PublicVisibility, None, name, [], name.span)
									(counts.expressions == 0 and counts.name_uses == 0 and counts.written_types == 0
										and witness.id.definition_local_index() == 0 and scan.items.is_empty()
										and state.diagnostic_count() > 0 and state.position() == start.token_start)
								None: False
						Err(_): False
				_: False
		None: False


tests: TestSuite = {
	description = "Global initializers read by the declaration scan",
	tests = [
		("checked float digits and id order", test_float_initializer_preserves_checked_digits_without_name_ids),
		("float rich header and comment boundary", test_float_initializer_preserves_rich_header_and_comment_boundary),
		("checked integer magnitude and id order", test_integer_initializer_uses_checked_magnitude_without_name_ids),
		("integer rich header and comment boundary", test_integer_initializer_preserves_rich_header_and_comment_boundary),
		("name initializer mints use expression then global", test_name_initializer_mints_use_expression_then_global),
		("rich header ids precede value and completed owner", test_rich_header_ids_precede_value_and_completed_owner),
		("comments preserve unconsumed boundary", test_comment_and_blank_lines_preserve_unconsumed_boundary),
		("continued global fields preserve spans and ids", test_continued_global_fields_keep_spans_and_postorder_ids),
		("scan preserves deferred mint", test_scan_completes_prefix_and_preserves_next_deferred_mint),
		("out of range literal leaves initializer unread", test_out_of_range_literal_leaves_initializer_unread),
		("missing initializer at end of source is rejected at the end", test_missing_initializer_at_end_of_source_is_rejected_at_the_end),
		("prefix diagnostic cannot complete global", test_prefix_diagnostic_cannot_complete_global_body),
		("unsupported initializer preserves authoritative state", test_unsupported_initializer_returns_exact_authoritative_state)
	]
}
