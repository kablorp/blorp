	test: TestSuite


-- Every payload family passes through the retained context. Definitions have
-- separate real-parser and malformed-reference regressions below.
pure func test_complete_renderer_covers_every_payload_family() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(2), "item tail")):
		Ok(entry):
			(after_name, name) = entry.consume_declared_name(NameInFieldName)
			match name:
				Some(written):
					cases: List[SyntaxDiagnostic] = [
						Plain(ExpectedTypeDiagnostic), ExpectedToken(ExpectedName(NameInFieldName)),
						UnknownEscape('q'), IntegerLiteralOverflow("999"), FloatLiteralOverflow("1e999"), UnexpectedByte('x'),
						ReservedKeywordAsName(written.spelling), UnknownAnnotation(written.spelling),
						ConcurrentDuplicateParameter(written.spelling), ConcurrentUnknownParameter(written.spelling),
						ConcurrentForUnknownParameter(written.spelling), DuplicateFieldGiven(written.span)
					]
					var state = after_name
					for diagnostic in cases:
						state = state.report_diagnostic(after_name.current_span(), diagnostic)
					match reject_preview(state):
						Ok(rejected):
							match render_rejected_diagnostics(rejected):
								Ok(rows):
									var correct: Bool = rows.length() == 12
									for row in rows:
										correct = correct and not row.rendered.message.is_empty() and row.rendered.help.is_some() and row.line == 1 and row.column == 6
									correct
								Err(_):
									False
						Err(_):
							False
				None:
					False
		Err(_):
			False


pure func test_complete_renderer_keeps_all_diagnostics_and_positions() -> Bool:
	match preview_record(lex_module(module_id_at_row(3), "record Box {\n\tif: Int,\n\tvalue Int,\n\tvalue: Int\n}")):
		Ok(RejectedRecordPreview(rejected)):
			match render_rejected_diagnostics(rejected):
				Ok([keyword, missing_colon, duplicate]):
					(keyword.rendered.message == "`if` is a reserved keyword and cannot be used as a name"
						and keyword.rendered.help == Some("choose another identifier such as `if_name`")
						and keyword.line == 2 and keyword.column == 5
						and missing_colon.rendered.message == "expected `:` after field name"
						and missing_colon.line == 3
						and duplicate.rendered.message == "duplicate field `value`"
						and duplicate.line == 4 and duplicate.column == 5)
				_:
					False
		_:
			False


pure func test_rejected_record_keeps_earlier_field_for_rendering() -> Bool:
	match preview_record(
		lex_module(
			module_id_at_row(3),
			"record Box {\n\tother: Int,\n\tvalue: Int,\n\tvalue: Int\n}",
		),
	):
		Ok(RejectedRecordPreview(rejected)):
			match rejected.rejected_diagnostics():
				[diagnostic]:
					match render_rejected_duplicate_field(rejected, diagnostic):
						Ok(rendered):
							(
								rendered.message == "duplicate field `value`"
								and rendered.help == Some(
									"the field was already declared at 3:5; remove one or give it another name",
								)
							)
						Err(_):
							False
				_:
					False
		_:
			False


