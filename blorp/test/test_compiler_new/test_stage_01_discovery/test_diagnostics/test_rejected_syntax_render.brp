-- Accepted leaf parses let tests mint real ids of each kind and module;
-- malformed ids are never built from magic integer encodings.
private pure func record_id(module: ModuleId, text: String) -> Option[DefinitionId]:
	match new_parse_state(lex_module(module, text)):
		Ok(state):
			match parse_record(state.advanced(), PublicVisibility, None, state.current_span()):
				(_, ParsedRecord(declaration)):
					Some(declaration.id)
				_:
					None
		_:
			None


private pure func rejects_reference(
	rejected: RejectedPreview,
	span: Span,
	id: DefinitionId,
	expected: RejectedRenderError,
) -> Bool:
	match (
		render_rejected_duplicate_field(
			rejected,
			{
				span = span,
				diagnostic = DuplicateField(id)
			},
		)
	):
		Err(error):
			error == expected
		Ok(_):
			False


pure func test_definition_lookup_rejects_missing_cross_module_and_forward_references() -> Bool:
	match preview_record(
		lex_module(
			module_id_at_row(3),
			"record Box { first: Int, value: Int, value: Int }",
		),
	):
		Ok(RejectedRecordPreview(rejected)):
			match (
				rejected.rejected_diagnostics(),
				rejected.rejected_definitions(),
				record_id(module_id_at_row(3), "record Box { a: Int, b: Int, c: Int, d: Int }"),
				record_id(module_id_at_row(4), "record Empty {}"),
			):
				([diagnostic], [FieldDefinition(_), FieldDefinition(earlier), FieldDefinition(later)], Some(missing), Some(other_module)):
					(
						earlier.id.definition_local_index() == 1
						and rejected.rejects_reference(diagnostic.span, missing, MissingDefinition)
						and rejected.rejects_reference(
							diagnostic.span,
							other_module,
							CrossModuleDefinition,
						)
						and rejected.rejects_reference(
							diagnostic.span,
							later.id,
							ForwardFieldReference,
						)
					)
				_:
					False
		_:
			False


pure func test_definition_lookup_rejects_wrong_kind() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(3), "record Box { a: Int }")):
		Ok(state):
			match parse_record(state.advanced(), PublicVisibility, None, state.current_span()):
				(parsed, ParsedRecord(declaration)):
					match reject_preview(
						parsed.report_diagnostic(
							declaration.name.span,
							DuplicateField(declaration.id),
						),
					):
						Ok(rejected):
							rejected.rejects_reference(
								declaration.name.span,
								declaration.id,
								WrongDefinitionKind,
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_rejection_requires_a_diagnostic() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(3), "record Box {}")):
		Ok(state):
			match reject_preview(state):
				Err(EmptyRejection):
					True
				_:
					False
		_:
			False


private pure func reserved_spelling_is_retained(rejected: RejectedPreview) -> Bool:
	match rejected.rejected_diagnostics():
		[diagnostic]:
			match diagnostic.diagnostic:
				ReservedKeywordAsName(spelling):
					rejected
						.rejected_spellings()
						.spelling_text(spelling) == Some("if")
				_:
					False
		_:
			False


pure func test_every_preview_rejection_keeps_spelling_lookup() -> Bool:
	alias_retained: Bool = match preview_alias(
		lex_module(
			module_id_at_row(3),
			"type alias if = Int",
		),
	):
		Ok(RejectedAliasPreview(rejected)):
			rejected.reserved_spelling_is_retained()
		_:
			False

	builtin_retained: Bool = match preview_builtin_type(
		lex_module(
			module_id_at_row(3),
			"type if = builtin",
		),
	):
		Ok(RejectedBuiltinTypePreview(rejected)):
			rejected.reserved_spelling_is_retained()
		_:
			False

	enum_retained: Bool = match preview_enum(lex_module(module_id_at_row(3), "enum if:\n\tA\n")):
		Ok(RejectedEnumPreview(rejected)):
			rejected.reserved_spelling_is_retained()
		_:
			False

	union_retained: Bool = match preview_union(lex_module(module_id_at_row(3), "union if:\n\tA\n")):
		Ok(RejectedUnionPreview(rejected)):
			rejected.reserved_spelling_is_retained()
		_:
			False

	record_retained: Bool = match preview_record(lex_module(module_id_at_row(3), "record if {}")):
		Ok(RejectedRecordPreview(rejected)):
			rejected.reserved_spelling_is_retained()
		_:
			False

	fixed_record_retained: Bool = match preview_record(
		lex_module(
			module_id_at_row(3),
			"fixed record if {}",
		),
	):
		Ok(RejectedRecordPreview(rejected)):
			rejected.reserved_spelling_is_retained()
		_:
			False

	(
		alias_retained
		and builtin_retained
		and enum_retained
		and union_retained
		and record_retained
		and fixed_record_retained
	)


pure func test_parser_rejects_inexact_line_starts() -> Bool:
	lexed = lex_module(module_id_at_row(3), "record Box {\n\ta: Int,\n\ta: Int\n}")
	var rejected: Bool = True
	invalid_starts: List[List[Int]] = [
		[],
		[0, 1],
		[0],
		[0, 13, 13],
		[0, 13, 22, 1000],
	]

	for starts in invalid_starts:
		match new_parse_state({ lexed | line_starts = starts }):
			Err(InvalidLineStarts):
				void
			_:
				rejected = False

	rejected


tests: TestSuite = {
	description = "rejected syntax rendering",
	tests = [
		("complete renderer covers every payload family", test_complete_renderer_covers_every_payload_family),
		("complete renderer keeps every diagnostic and position", test_complete_renderer_keeps_all_diagnostics_and_positions),
		(
			"rejected record keeps earlier field for rendering",
			test_rejected_record_keeps_earlier_field_for_rendering,
		),
		(
			"rejected ordinary record keeps earlier field for rendering",
			test_rejected_ordinary_record_keeps_earlier_field_for_rendering,
		),
		(
			"rejected fixed record keeps earlier field for rendering",
			test_rejected_fixed_record_keeps_earlier_field_for_rendering,
		),
		(
			"definition lookup rejects missing cross-module and forward references",
			test_definition_lookup_rejects_missing_cross_module_and_forward_references,
		),
		("definition lookup rejects wrong kind", test_definition_lookup_rejects_wrong_kind),
		("rejection requires a diagnostic", test_rejection_requires_a_diagnostic),
		(
			"every preview rejection keeps spelling lookup",
			test_every_preview_rejection_keeps_spelling_lookup,
		),
		("parser rejects inexact line starts", test_parser_rejects_inexact_line_starts),
	]
}
