import:
	../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../src/compiler/stage_03_parse/parsed_ast: parsed_program_ok
	../../src/lib/source: source_file
	../../src/test/generated_test_harness:
		GeneratedTestSuiteTarget,
		generate_doctest_batch_module,
		generate_suite_batch_module,
	test: TestSuite


private pure func test_target() -> GeneratedTestSuiteTarget:
	{
		path = "blorp/test/runtime/example.brp",
		module_name = "example"
	}


private pure func second_test_target() -> GeneratedTestSuiteTarget:
	{
		path = "blorp/test/runtime/other.brp",
		module_name = "other"
	}


private func test_suite_batch_harness_runs_all_targets_and_aggregates_results() -> Bool:
	generated = generate_suite_batch_module(
		[test_target(), second_test_target()],
		False,
		True,
	)
	source: String = generated.source.source_text

	(
		generated.source.path.ends_with("/__suite_batch_harness__.brp")
		and generated.source.module_name == "__suite_batch_harness__"
		and source.contains("run_suite_result(T0.tests)")
		and source.contains("run_suite_result(T1.tests)")
		and source.contains("passed += result_0[0]")
		and source.contains("failed += result_1[1]")
		and source.contains("print_error(\"BLORP_TEST_ARTIFACT_RESULT")
		and source.contains("BLORP_TEST_ARTIFACT_RESULT")
		and source
			.split("BLORP_TEST_ARTIFACT_RESULT")
			.length() == 3
		and generated.imports.length() == 2
		and generated.imports.any(func(binding): binding.source_path == test_target().path)
		and generated.imports.any(func(binding): binding.source_path == second_test_target().path)
	)


private func test_suite_batch_harness_bounds_generated_function_depth() -> Bool:
	var targets: List[GeneratedTestSuiteTarget] = []
	var index: Int = 0

	while index < 17:
		suffix: String = index.to_string()
		targets = targets.append({
			path = "blorp/test/runtime/example_" + suffix + ".brp",
			module_name = "example_" + suffix,
		})
		index += 1

	generated = generate_suite_batch_module(targets, False, True)
	source: String = generated.source.source_text
	group_0_start: Int = source
		.index_of("func __blorp_run_suite_group_0(")
		.get_or(0)
	group_1_start: Int = source
		.index_of("func __blorp_run_suite_group_1(")
		.get_or(0)
	main_start: Int = source
		.index_of("func main(args: List[String]) -> Int:")
		.get_or(0)
	group_0: String = source.substring(group_0_start, group_1_start - group_0_start)
	group_1: String = source.substring(group_1_start, main_start - group_1_start)
	program = parse_compiler_source(
		source_file(
			generated.source.path,
			generated.source.module_name,
			source,
		),
	)

	(
		parsed_program_ok(program)
		and source.contains("func __blorp_run_suite_group_0(")
		and source.contains("func __blorp_run_suite_group_1(")
		and source.contains("result_15: (Int, Int) = run_suite_result(T15.tests)")
		and source.contains("result_16: (Int, Int) = run_suite_result(T16.tests)")
		and source.contains("group_result_0: (Int, Int) = __blorp_run_suite_group_0(")
		and source.contains("group_result_1: (Int, Int) = __blorp_run_suite_group_1(")
		and group_0.contains("run_suite_result(T0.tests)")
		and group_0.contains("run_suite_result(T15.tests)")
		and not group_0.contains("run_suite_result(T16.tests)")
		and group_1.contains("run_suite_result(T16.tests)")
		and not group_1.contains("run_suite_result(T15.tests)")
		and source
			.split("func __blorp_run_suite_group_")
			.length() == 3
	)


private func test_doctest_batch_harness_runs_all_targets_and_aggregates_results() -> Bool:
	generated = generate_doctest_batch_module(
		[test_target(), second_test_target()],
		True,
	)
	source: String = generated.source.source_text

	(
		generated.source.path.ends_with("/__doctest_batch_harness__.brp")
		and source.contains("D0.__blorp_run_doctests()")
		and source.contains("D1.__blorp_run_doctests()")
		and source.contains("passed += doctest_passed_0")
		and source.contains("failed += doctest_failed_1")
		and source.contains("print_error(\"BLORP_TEST_ARTIFACT_RESULT")
		and source.contains("BLORP_TEST_ARTIFACT_RESULT")
		and source
			.split("BLORP_TEST_ARTIFACT_RESULT")
			.length() == 3
		and generated.imports.length() == 2
	)


private func test_doctest_batch_harness_bounds_generated_function_depth() -> Bool:
	var targets: List[GeneratedTestSuiteTarget] = []
	var index: Int = 0

	while index < 17:
		suffix: String = index.to_string()
		targets = targets.append({
			path = "std/example_" + suffix + ".brp",
			module_name = "example_" + suffix,
		})
		index += 1

	generated = generate_doctest_batch_module(targets, True)
	source: String = generated.source.source_text
	group_0_start: Int = source
		.index_of("func __blorp_run_doctest_group_0(")
		.get_or(0)
	group_1_start: Int = source
		.index_of("func __blorp_run_doctest_group_1(")
		.get_or(0)
	main_start: Int = source
		.index_of("func main(args: List[String]) -> Int:")
		.get_or(0)
	group_0: String = source.substring(group_0_start, group_1_start - group_0_start)
	group_1: String = source.substring(group_1_start, main_start - group_1_start)

	(
		source.contains("func __blorp_run_doctest_group_0(")
		and source.contains("func __blorp_run_doctest_group_1(")
		and group_0.contains("D0.__blorp_run_doctests()")
		and group_0.contains("D15.__blorp_run_doctests()")
		and not group_0.contains("D16.__blorp_run_doctests()")
		and group_1.contains("D16.__blorp_run_doctests()")
		and not group_1.contains("D15.__blorp_run_doctests()")
		and source.contains("__blorp_run_doctest_group_0(passed, failed)")
		and source.contains("__blorp_run_doctest_group_1(passed, failed)")
		and source
			.split("func __blorp_run_doctest_group_")
			.length() == 3
	)


private func test_single_target_suite_harness_uses_aggregate_path() -> Bool:
	generated = generate_suite_batch_module([test_target()], False, True)
	source: String = generated.source.source_text
	program = parse_compiler_source(
		source_file(
			generated.source.path,
			generated.source.module_name,
			source,
		),
	)

	(
		parsed_program_ok(program)
		and generated.source.path.ends_with("/__suite_batch_harness__.brp")
		and generated.source.module_name == "__suite_batch_harness__"
		and source.contains("std/test: run_suite_result")
		and source.contains("run_suite_result(T0.tests)")
		and source.contains("BLORP_TEST_ARTIFACT_RESULT")
		and not source.contains("parse_int")
		and not source.contains("get(args")
		and generated.imports.length() == 1
		and generated.imports.any(
			func(
				binding,
			): (
				binding.module_path == "./__blorp_generated_test_target_0"
				and binding.source_path == "blorp/test/runtime/example.brp"
				and binding.source_module == "example"
			),
		)
	)


private func test_single_target_suite_harness_selects_leak_runner() -> Bool:
	source: String = generate_suite_batch_module([test_target()], True, False).source.source_text

	(
		source.contains("std/test: run_suite_leak_check_result")
		and source.contains("run_suite_leak_check_result(T0.tests)")
		and not source.contains("BLORP_TEST_ARTIFACT_RESULT")
	)


tests: TestSuite = {
	description = "Blorp-owned generated test harnesses",
	tests = [
		(
			"suite batch bounds generated function depth",
			test_suite_batch_harness_bounds_generated_function_depth,
		),
		(
			"doctest batch bounds generated function depth",
			test_doctest_batch_harness_bounds_generated_function_depth,
		),
		(
			"doctest batch runs all targets and aggregates results",
			test_doctest_batch_harness_runs_all_targets_and_aggregates_results,
		),
		(
			"suite batch runs all targets and aggregates results",
			test_suite_batch_harness_runs_all_targets_and_aggregates_results,
		),
		(
			"single target uses aggregate suite path",
			test_single_target_suite_harness_uses_aggregate_path,
		),
		(
			"single target selects aggregate leak runner",
			test_single_target_suite_harness_selects_leak_runner,
		),
	]
}
