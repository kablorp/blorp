import:
	../../src/lib/cli_args: CliRunArgs
	../../src/lib/function_profile: FunctionProfileConfiguration(FunctionProfileOff)
	../../src/lib/run_environment: CliRunEnvironment, resolve_run_args_environment
	test: TestSuite


private pure func options() -> CliRunArgs:
	{
		profile = FunctionProfileOff,
		debug = False,
		sanitizer = None,
		leak_check = False,
		memory_diagnostics = False,
		memory_stats = False,
		release = False,
		c_translation_units = 1,
		no_format = False,
		timeout = None,
		threads = None,
		std_dir = None,
		files = ["main.brp"],
		user_args = []
	}


private pure func environment() -> CliRunEnvironment:
	{
		leak_check = Some("1"),
		threads = Some("4")
	}


pure func test_environment_fills_unspecified_run_options() -> Bool:
	match resolve_run_args_environment(options(), environment()):
		Ok(resolved):
			(
				resolved.leak_check
				and resolved.memory_diagnostics
				and not resolved.memory_stats
				and resolved.threads == Some(4)
			)
		Err(_):
			False


pure func test_cli_run_options_override_environment() -> Bool:
	configured = { options() |
		timeout = Some(0),
		leak_check = True,
		threads = Some(2)
	}

	match resolve_run_args_environment(configured, environment()):
		Ok(resolved):
			(
				resolved.timeout == Some(0)
				and resolved.leak_check
				and resolved.memory_diagnostics
				and resolved.threads == Some(2)
			)
		Err(_):
			False


private pure func rejected_with(result: Result[CliRunArgs, String], message: String) -> Bool:
	match result:
		Ok(_):
			False
		Err(found):
			found == message


pure func test_invalid_run_environment_is_rejected() -> Bool:
	bad_threads: CliRunEnvironment = { environment() | threads = Some("0") }
	bad_timeout: CliRunArgs = { options() | timeout = Some(-1) }

	(
		rejected_with(
			resolve_run_args_environment(options(), bad_threads),
			"BLORP_THREADS/--threads must be a positive integer",
		)
		and rejected_with(
			resolve_run_args_environment(bad_timeout, environment()),
			"--timeout must be a non-negative integer",
		)
	)


pure func test_inherited_leak_modes_select_diagnostic_runtime() -> Bool:
	strict = { environment() | leak_check = Some("strict") }
	verbose = { environment() | leak_check = Some("verbose") }
	strict_ok: Bool = match resolve_run_args_environment(options(), strict):
		Ok(resolved):
			resolved.memory_diagnostics and not resolved.leak_check
		Err(_):
			False
	verbose_ok: Bool = match resolve_run_args_environment(options(), verbose):
		Ok(resolved):
			resolved.memory_diagnostics and not resolved.leak_check
		Err(_):
			False
	strict_ok and verbose_ok


tests: TestSuite = {
	description = "Blorp compiler run environment",
	tests = [
		(
			"environment fills unspecified run options",
			test_environment_fills_unspecified_run_options,
		),
		("CLI run options override environment", test_cli_run_options_override_environment),
		("invalid run environment is rejected", test_invalid_run_environment_is_rejected),
		("inherited leak modes select diagnostic runtime", test_inherited_leak_modes_select_diagnostic_runtime),
	]
}
