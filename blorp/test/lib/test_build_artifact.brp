import:
	../../src/lib/build_artifact:
		BuildArtifact,
		BuildCompatibility,
		BuildOptimization(BuildFast),
		BuildPlatform(BuildLinux, BuildMacos),
		BuildRuntimeRequirement(BuildExternalRuntime),
		BuildSanitizer(BuildNoSanitizer),
		build_c_invocation,
	test: TestSuite


private pure func artifact() -> BuildArtifact:
	compatibility: BuildCompatibility = {
		debug = True,
		profile = False,
		optimization = BuildFast,
		sanitizer = BuildNoSanitizer,
		leak_check = False
	}

	{
		c_code = "int main(void) { return 0; }\\n",
		link_arguments = [
			{
				platform = None,
				value = "-lm"
			},
			{
				platform = Some(BuildLinux),
				value = "-llinux"
			},
			{
				platform = Some(BuildMacos),
				value = "-framework"
			},
			{
				platform = Some(BuildMacos),
				value = "Cocoa"
			},
		],
		include_dirs = ["generated/include", "/project/src"],
		runtime_requirement = BuildExternalRuntime,
		native_features = [],
		source = {
			path = "/project/src/main.brp",
			module_name = "main"
		},
		compatibility = compatibility
	}


pure func test_build_c_invocation_filters_without_losing_argument_boundaries() -> Bool:
	shared_artifact: BuildArtifact = artifact()
	invocation = build_c_invocation(shared_artifact, BuildMacos)

	(
		invocation.include_arguments == ["-Igenerated/include", "-I/project/src"]
		and invocation.link_arguments == ["-lm", "-framework", "Cocoa"]
		and invocation.source.path == shared_artifact.source.path
		and invocation.source.module_name == shared_artifact.source.module_name
		and invocation.compatibility.debug == shared_artifact.compatibility.debug
		and invocation.compatibility.profile == shared_artifact.compatibility.profile
		and invocation.compatibility.optimization == shared_artifact.compatibility.optimization
		and invocation.compatibility.sanitizer == shared_artifact.compatibility.sanitizer
		and invocation.compatibility.leak_check == shared_artifact.compatibility.leak_check
	)


tests: TestSuite = {
	description = "Shared build artifact",
	tests = [
		(
			"build invocation preserves argument boundaries",
			test_build_c_invocation_filters_without_losing_argument_boundaries,
		),
	]
}
