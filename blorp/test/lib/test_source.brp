import:
	../../src/lib/source:
		Cursor,
		SourceFile,
		SourceLocation,
		SourceSpan,
		compiler_prelude_source_location,
		singleton_source_table,
		source_advance,
		source_at_end,
		source_cursor_at,
		source_file,
		source_location,
		source_location_cover,
		source_location_from_offsets,
		source_location_span,
		source_peek,
		source_span,
		source_span_label,
		source_span_text,
		source_start,
		unindexed_source_table_for_file,
	test: TestSuite


pure func sample_source() -> SourceFile:
	source_file("sample.brp", "sample", "a\nbc\ndef")


func test_source_keeps_metadata() -> Bool:
	src: SourceFile = sample_source()
	src.path == "sample.brp" and src.module_name == "sample" and src.text.length() == 8


func test_cursor_tracks_newlines() -> Bool:
	src: SourceFile = sample_source()
	start: Cursor = source_start(src)
	after_a: Cursor = source_advance(src, start)
	after_newline: Cursor = source_advance(src, after_a)

	(
		after_newline.offset == 2
		and after_newline.line == 2
		and after_newline.column == 1
		and source_peek(src, after_newline).get_or('x') == 'b'
	)


func test_cursor_tracks_tabs_as_four_column_stops() -> Bool:
	src: SourceFile = source_file("tabs.brp", "tabs", "\tindent")
	start: Cursor = source_start(src)
	after_tab: Cursor = source_advance(src, start)
	after_i: Cursor = source_advance(src, after_tab)

	after_tab.offset == 1 and after_tab.line == 1 and after_tab.column == 5 and after_i.column == 6


func test_cursor_at_clamps_and_reconstructs_position() -> Bool:
	src: SourceFile = sample_source()
	before_start: Cursor = source_cursor_at(src, -5)
	middle: Cursor = source_cursor_at(src, 5)
	past_end: Cursor = source_cursor_at(src, 99)

	(
		before_start.offset == 0
		and middle.offset == 5
		and middle.line == 3
		and middle.column == 1
		and past_end.offset == src.text.length()
		and source_at_end(src, past_end)
	)


func test_span_text_and_label() -> Bool:
	src: SourceFile = sample_source()
	start: Cursor = source_cursor_at(src, 2)
	finish: Cursor = source_cursor_at(src, 4)
	span: SourceSpan = source_span(src, start, finish)

	source_span_text(src, span) == "bc" and source_span_label(span) == "sample.brp:2:1"


func test_source_table_materializes_compact_location() -> Bool:
	src: SourceFile = sample_source()
	table_and_id = singleton_source_table(src)
	location: SourceLocation = source_location(
		table_and_id[1],
		source_cursor_at(src, 2),
		source_cursor_at(src, 4),
	)
	span: SourceSpan = source_location_span(table_and_id[0], location)

	(
		span.path == "sample.brp"
		and span.module_name == "sample"
		and span.start_offset == 2
		and span.start_line == 2
		and span.start_column == 1
		and span.end_offset == 4
		and span.end_line == 2
		and span.end_column == 3
	)


func test_offset_location_materializes_empty_eof_extent() -> Bool:
	src = source_file("offsets.brp", "offsets", "first\n\tsecond")
	table_and_id = singleton_source_table(src)
	location = source_location_from_offsets(
		table_and_id[1],
		src.text.length(),
		src.text.length(),
	)
	span = source_location_span(table_and_id[0], location)

	(
		span.start_offset == src.text.length()
		and span.end_offset == src.text.length()
		and span.start_line == 2
		and span.start_column == 11
		and span.end_line == 2
		and span.end_column == 11
	)


func test_compact_location_cover_keeps_outer_coordinates() -> Bool:
	src: SourceFile = sample_source()
	table_and_id = singleton_source_table(src)
	left = source_location(
		table_and_id[1],
		source_cursor_at(src, 0),
		source_cursor_at(src, 1),
	)
	right = source_location(
		table_and_id[1],
		source_cursor_at(src, 5),
		source_cursor_at(src, 8),
	)
	span = source_location_span(
		table_and_id[0],
		source_location_cover(left, right),
	)

	span.start_offset == 0 and span.end_offset == 8


func test_compiler_prelude_location_keeps_its_identity_when_covered() -> Bool:
	src: SourceFile = sample_source()
	table_and_id = singleton_source_table(src)
	prelude = compiler_prelude_source_location()
	covered = source_location_cover(prelude, prelude)
	span = source_location_span(table_and_id[0], covered)

	(
		span.path == "<compiler-prelude>"
		and span.module_name == "<compiler-prelude>"
		and span.start_offset == 0
		and span.end_offset == 0
	)


func test_source_table_materializes_locations_after_tabs_and_newlines() -> Bool:
	src = source_file("indexed.brp", "indexed", "first\n\tsecond\nthird")
	table_and_id = singleton_source_table(src)
	location = source_location(
		table_and_id[1],
		source_cursor_at(src, 7),
		source_cursor_at(src, 13),
	)
	span = source_location_span(table_and_id[0], location)

	span.start_line == 2 and span.start_column == 5 and span.end_line == 2 and span.end_column == 11


func test_unindexed_source_table_materializes_locations_on_demand() -> Bool:
	src = source_file("deferred.brp", "deferred", "first\n\tsecond\nthird")
	table_and_id = singleton_source_table(src)
	location = source_location(
		table_and_id[1],
		source_cursor_at(src, 7),
		source_cursor_at(src, 13),
	)
	span = source_location_span(unindexed_source_table_for_file(src), location)

	span.start_line == 2 and span.start_column == 5 and span.end_line == 2 and span.end_column == 11


tests: TestSuite = {
	description = "Shared source foundation",
	tests = [
		("source keeps metadata", test_source_keeps_metadata),
		("cursor tracks newlines", test_cursor_tracks_newlines),
		("cursor tracks tabs as four column stops", test_cursor_tracks_tabs_as_four_column_stops),
		(
			"cursor_at clamps and reconstructs position",
			test_cursor_at_clamps_and_reconstructs_position,
		),
		("span text and label", test_span_text_and_label),
		(
			"source table materializes compact location",
			test_source_table_materializes_compact_location,
		),
		(
			"compact location cover keeps outer coordinates",
			test_compact_location_cover_keeps_outer_coordinates,
		),
		(
			"offset location materializes empty EOF extent",
			test_offset_location_materializes_empty_eof_extent,
		),
		(
			"compiler prelude location keeps its identity when covered",
			test_compiler_prelude_location_keeps_its_identity_when_covered,
		),
		(
			"source table materializes locations after tabs and newlines",
			test_source_table_materializes_locations_after_tabs_and_newlines,
		),
		(
			"unindexed source table materializes locations on demand",
			test_unindexed_source_table_materializes_locations_on_demand,
		),
	]
}
