func test_timed_compile_late_stop_reports_reached_phases() -> Bool:
	path: String = temp_dir() + "/blorp_cli_execute_phase_timing_late_stop.brp"
	_ = remove_file(path)

	if not write_source(path, "func main(args: List[String]) -> Int:\n\t0\n"):
		False
	else:
		plan = run_cli([
			"compile",
			"--no-format",
			"--dump-core-after=dce",
			"--stop-after=dce",
			path,
		])
		_ = remove_file(path)

		match plan:
			CliRunCompile(compile_plan):
				timed = execute_compile_plan_timed(compile_plan, True)
				timing_labels(
					timed.timings,
				) == [
					"typed_frontend",
					"core_lowering",
					"early_core",
					"runtime_projection",
					"late_core",
				]
			_:
				False


func test_timing_disabled_reports_no_phase_rows() -> Bool:
	path: String = temp_dir() + "/blorp_cli_execute_phase_timing_disabled.brp"
	_ = remove_file(path)

	if not write_source(path, "func main(args: List[String]) -> Int:\n\t0\n"):
		False
	else:
		plan = run_cli(["compile", "--no-format", path])
		_ = remove_file(path)

		match plan:
			CliRunCompile(compile_plan):
				execute_compile_plan_timed(compile_plan, False).timings.length() == 0
			_:
				False


tests: TestSuite = {
	description = "Blorp CLI frontend boundaries",
	tests = [
		(
			"frontend policy permits debug calls while erasing debug blocks",
			test_compile_frontend_policy_erases_debug_blocks,
		),
		(
			"typed validation stops before Core preparation",
			test_compile_typed_validation_stops_before_core_preparation,
		),
		(
			"early stop returns the requested Core snapshot",
			test_early_stop_returns_requested_core_snapshot,
		),
		("timed compile reports seven phase labels", test_timed_compile_reports_seven_phase_labels),
		(
			"timed compile type error reports typed frontend only",
			test_timed_compile_type_error_reports_typed_frontend_only,
		),
		(
			"timed compile early stop reports reached phases",
			test_timed_compile_early_stop_reports_reached_phases,
		),
		(
			"timed compile late stop reports reached phases",
			test_timed_compile_late_stop_reports_reached_phases,
		),
		("timing disabled reports no phase rows", test_timing_disabled_reports_no_phase_rows),
	]
}
