import:
	../../src/lib/build_artifact:
		BuildArtifact,
		BuildCompatibility,
		BuildLinkArgument,
		BuildNativeFeature(BuildRaylib),
		BuildOptimization(BuildFast, BuildRelease),
		BuildPlatform(BuildLinux, BuildMacos),
		BuildRuntimeRequirement(BuildEmbeddedRuntime, BuildExternalRuntime),
		BuildSanitizer(BuildAddressUndefinedSanitizer, BuildNoSanitizer),
	../../src/lib/host_c:
		HostCCompileError(HostCCompilerRejected),
		HostCCompiler,
		HostCCompilerFamily(HostClang, HostGcc),
		HostCConfiguration,
		HostCPreparationError(HostRuntimeRequirementMismatch, HostRuntimeTlsMismatch),
		HostPrecompiledRuntime,
		HostRuntimeInput(HostEmbeddedRuntime, HostPrecompiledRuntimeInput),
		HostTlsBackend(HostTlsOpenSsl, HostTlsUnsupported),
		HostTlsConfiguration,
		prepare_host_c_compilation,
		run_host_c_compilation,
	../../src/lib/runtime_sources: RuntimeSources
	fs: IOError, resource_path, temporary_directory
	process: ProcessStdin(BytesPartsStdin)
	system: file_exists, temp_dir
	test: TestSuite
	units: mebibytes, seconds


private pure func compatibility(
	optimization: BuildOptimization,
	sanitizer: BuildSanitizer,
) -> BuildCompatibility:
	{
		debug = False,
		profile = False,
		optimization = optimization,
		sanitizer = sanitizer,
		leak_check = False
	}


private pure func artifact(
	runtime: BuildRuntimeRequirement,
	optimization: BuildOptimization,
	sanitizer: BuildSanitizer,
	native_features: List[BuildNativeFeature],
) -> BuildArtifact:
	linux_link: BuildLinkArgument = {
		platform = Some(BuildLinux),
		value = "-llinux-only"
	}
	macos_link: BuildLinkArgument = {
		platform = Some(BuildMacos),
		value = "-framework"
	}
	macos_framework: BuildLinkArgument = {
		platform = Some(BuildMacos),
		value = "Cocoa"
	}
	{
		c_code = "int main(void) { return 0; }\n",
		link_arguments = [linux_link, macos_link, macos_framework],
		include_dirs = ["include path"],
		runtime_requirement = runtime,
		native_features = native_features,
		source = {
			path = "src/main.brp",
			module_name = "main"
		},
		compatibility = compatibility(optimization, sanitizer)
	}


private pure func compiler(family: HostCCompilerFamily) -> HostCCompiler:
	{
		program = "cc",
		prefix_arguments = [],
		family = family
	}


private pure func openssl() -> HostTlsConfiguration:
	{
		backend = HostTlsOpenSsl,
		runtime_arguments = ["-DOPENSSL_RUNTIME", "-Iopenssl include"],
		link_arguments = ["-lssl", "-lcrypto"]
	}


private pure func unsupported_tls() -> HostTlsConfiguration:
	{
		backend = HostTlsUnsupported,
		runtime_arguments = [],
		link_arguments = []
	}


private pure func configuration(
	platform: BuildPlatform,
	compiler_value: HostCCompiler,
	tls: HostTlsConfiguration,
	raylib_prefix: Option[String],
) -> HostCConfiguration:
	{
		platform = platform,
		compiler = compiler_value,
		tls = tls,
		raylib_prefix = raylib_prefix,
		timeout = Some(seconds(10)),
		capture_limit = mebibytes(4)
	}


private RUNTIME_SOURCES: RuntimeSources = {
	runtime = "/* runtime */\n",
	declarations = "/* declarations */\n"
}


pure func test_embedded_macos_clang_command_has_exact_policy() -> Bool:
	prepared = prepare_host_c_compilation(
		artifact(BuildEmbeddedRuntime, BuildRelease, BuildNoSanitizer, [BuildRaylib]),
		"build/program output",
		configuration(BuildMacos, compiler(HostClang), openssl(), Some("/opt/raylib")),
		HostEmbeddedRuntime(RUNTIME_SOURCES),
	)

	match prepared:
		Ok(value):
			stdin_matches: Bool = match value.command.stdin:
				BytesPartsStdin(parts):
					parts.map(
						func(
							part,
						): part.to_string(),
					) == ["/* runtime */\n", "int main(void) { return 0; }\n"]
				_:
					False

			(
				stdin_matches
				and value.command.args == [
					"-x",
					"c",
					"-",
					"-x",
					"none",
					"-O2",
					"-fwrapv",
					"-pipe",
					"-Wl,-stack_size,0x1000000",
					"-w",
					"-DOPENSSL_RUNTIME",
					"-Iopenssl include",
					"-Iinclude path",
					"-lm",
					"-lpthread",
					"-lssl",
					"-lcrypto",
					"-L/opt/raylib/lib",
					"-I/opt/raylib/include",
					"-lraylib",
					"-framework",
					"IOKit",
					"-framework",
					"Cocoa",
					"-framework",
					"OpenGL",
					"-framework",
					"CoreVideo",
					"-framework",
					"Cocoa",
					"-o",
					"build/program output",
				]
			)
		Err(_):
			False


pure func test_external_sanitized_command_uses_runtime_artifact() -> Bool:
	runtime: HostPrecompiledRuntime = {
		object_path = "cache/runtime.o",
		declarations_path = "cache/runtime.h",
		tls_backend = HostTlsOpenSsl
	}
	prepared = prepare_host_c_compilation(
		artifact(BuildExternalRuntime, BuildRelease, BuildAddressUndefinedSanitizer, []),
		"build/program",
		configuration(BuildLinux, compiler(HostGcc), openssl(), None),
		HostPrecompiledRuntimeInput(runtime),
	)

	match prepared:
		Ok(value):
			value.command.args == [
				"-x",
				"c",
				"-",
				"-x",
				"none",
				"-O0",
				"-fwrapv",
				"-pipe",
				"-Iinclude path",
				"-include",
				"cache/runtime.h",
				"cache/runtime.o",
				"-lm",
				"-lpthread",
				"-fsanitize=address,undefined",
				"-fno-omit-frame-pointer",
				"-g",
				"-lssl",
				"-lcrypto",
				"-llinux-only",
				"-o",
				"build/program",
			]
		Err(_):
			False


pure func test_runtime_requirement_mismatch_is_rejected() -> Bool:
	result = prepare_host_c_compilation(
		artifact(BuildExternalRuntime, BuildFast, BuildNoSanitizer, []),
		"build/program",
		configuration(BuildLinux, compiler(HostGcc), unsupported_tls(), None),
		HostEmbeddedRuntime(RUNTIME_SOURCES),
	)

	match result:
		Err(HostRuntimeRequirementMismatch):
			True
		_:
			False


pure func test_precompiled_runtime_tls_mismatch_is_rejected() -> Bool:
	runtime: HostPrecompiledRuntime = {
		object_path = "cache/runtime.o",
		declarations_path = "cache/runtime.h",
		tls_backend = HostTlsOpenSsl
	}
	result = prepare_host_c_compilation(
		artifact(BuildExternalRuntime, BuildFast, BuildNoSanitizer, []),
		"build/program",
		configuration(BuildLinux, compiler(HostGcc), unsupported_tls(), None),
		HostPrecompiledRuntimeInput(runtime),
	)

	match result:
		Err(HostRuntimeTlsMismatch):
			True
		_:
			False


private func exercise_real_c_compilation() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_host_c_"):
		output: String = directory.resource_path() + "/program output"
		standalone_artifact = { artifact(BuildEmbeddedRuntime, BuildFast, BuildNoSanitizer, []) |
			link_arguments = []
		}
		prepared = prepare_host_c_compilation(
			standalone_artifact,
			output,
			configuration(BuildLinux, compiler(HostGcc), unsupported_tls(), None),
			HostEmbeddedRuntime(RUNTIME_SOURCES),
		)

		match prepared:
			Err(_):
				Ok(False)
			Ok(value):
				match run_host_c_compilation(value):
					Ok(compiled_path):
						Ok(compiled_path == output and file_exists(compiled_path))
					Err(_):
						Ok(False)


private func test_compiles_c_from_stdin() -> Bool:
	match exercise_real_c_compilation():
		Ok(result):
			result
		Err(_):
			False


private func test_c_compiler_failure_keeps_diagnostics() -> Bool:
	bad_artifact = { artifact(BuildEmbeddedRuntime, BuildFast, BuildNoSanitizer, []) |
		c_code = "int main(void) { this is invalid C; }\n"
	}
	prepared = prepare_host_c_compilation(
		bad_artifact,
		"unused-output",
		configuration(BuildLinux, compiler(HostGcc), unsupported_tls(), None),
		HostEmbeddedRuntime(RUNTIME_SOURCES),
	)

	match prepared:
		Ok(value):
			match run_host_c_compilation(value):
				Err(HostCCompilerRejected(_, diagnostics)):
					diagnostics.length() > 0
				_:
					False
		Err(_):
			False


tests: TestSuite = {
	description = "Blorp host C compilation",
	tests = [
		(
			"embedded macOS clang policy is exact",
			test_embedded_macos_clang_command_has_exact_policy,
		),
		(
			"external sanitized policy uses runtime artifact",
			test_external_sanitized_command_uses_runtime_artifact,
		),
		("rejects runtime requirement mismatch", test_runtime_requirement_mismatch_is_rejected),
		("rejects runtime TLS mismatch", test_precompiled_runtime_tls_mismatch_is_rejected),
		("compiles C from stdin", test_compiles_c_from_stdin),
		("preserves C compiler diagnostics", test_c_compiler_failure_keeps_diagnostics),
	]
}
