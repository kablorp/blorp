import:
	../../../src/lsp/capabilities/document_symbol: encode_lsp_document_symbol_response
	../../../src/lsp/capabilities/document_symbol_query:
		DocumentSymbolKind(
			DocumentSymbolClass,
			DocumentSymbolConstructor,
			DocumentSymbolField,
			DocumentSymbolFunction,
			DocumentSymbolInterface,
			DocumentSymbolMethod,
			DocumentSymbolVariable,
		),
	../../../src/lsp/capabilities/query_dispatch:
		SemanticQueryDispatch(
			SemanticQueryAccepted,
			SemanticQueryIgnored,
			SemanticQueryRejected,
			SemanticQueryUnhandled,
		),
		SemanticQueryRequest(
			DefinitionSemanticQuery,
			DocumentSymbolSemanticQuery,
			DocumentHighlightSemanticQuery,
			HoverSemanticQuery,
			ReferencesSemanticQuery,
		),
		dispatch_lsp_semantic_query,
	../../../src/lsp/protocol/identity: document_uri_value
	../../../src/lsp/protocol/json_rpc: JsonRpcEnvelope, decode_lsp_json_rpc_body
	../../../src/lsp/protocol/position: ProtocolRange, position
	../../../src/lsp/protocol/protocol:
		ProtocolError(InvalidMethodParameters),
		ProtocolResponse(ProtocolSuccessResponse),
		RequestId(IntegerRequestId),
	json: as_array, as_number, get_field, parse_json
	test: TestSuite


private DEFINITION_BODY: String =
	|{"jsonrpc":"2.0","id":1,"method":"textDocument/definition","params":{
	|"textDocument":{"uri":"file:///workspace/main.brp"},
	|"position":{"line":2,"character":4}}}

private DOCUMENT_SYMBOL_BODY: String =
	|{"jsonrpc":"2.0","id":2,"method":"textDocument/documentSymbol","params":{
	|"textDocument":{"uri":"file:///workspace/main.brp"}}}

private REFERENCES_BODY: String =
	|{"jsonrpc":"2.0","id":3,"method":"textDocument/references","params":{
	|"textDocument":{"uri":"file:///workspace/main.brp"},
	|"position":{"line":2,"character":4},
	|"context":{"includeDeclaration":true}}}

private HOVER_BODY: String =
	|{"jsonrpc":"2.0","id":4,"method":"textDocument/hover","params":{
	|"textDocument":{"uri":"file:///workspace/main.brp"},
	|"position":{"line":2,"character":4}}}

private DOCUMENT_HIGHLIGHT_BODY: String =
	|{"jsonrpc":"2.0","id":5,"method":"textDocument/documentHighlight","params":{
	|"textDocument":{"uri":"file:///workspace/main.brp"},
	|"position":{"line":2,"character":4}}}

private UNKNOWN_OPERATION_BODY: String =
	|{"jsonrpc":"2.0","id":4,"method":"textDocument/didOpen","params":{}}

private DEFINITION_NOTIFICATION_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/definition","params":{
	|"textDocument":{"uri":"file:///workspace/main.brp"},
	|"position":{"line":2,"character":4}}}

private INVALID_DOCUMENT_SYMBOL_BODY: String =
	|{"jsonrpc":"2.0","id":5,"method":"textDocument/documentSymbol","params":{}}

private INVALID_DOCUMENT_HIGHLIGHT_BODY: String =
	|{"jsonrpc":"2.0","id":6,"method":"textDocument/documentHighlight","params":{}}

private NEGATIVE_DEFINITION_LINE_BODY: String =
	|{"jsonrpc":"2.0","id":7,"method":"textDocument/definition","params":{
	|"textDocument":{"uri":"file:///workspace/main.brp"},
	|"position":{"line":-1,"character":4}}}

private NON_INTEGER_REFERENCE_CHARACTER_BODY: String =
	|{"jsonrpc":"2.0","id":8,"method":"textDocument/references","params":{
	|"textDocument":{"uri":"file:///workspace/main.brp"},
	|"position":{"line":2,"character":"four"},
	|"context":{"includeDeclaration":true}}}

private MISSING_HOVER_CHARACTER_BODY: String =
	|{"jsonrpc":"2.0","id":9,"method":"textDocument/hover","params":{
	|"textDocument":{"uri":"file:///workspace/main.brp"},
	|"position":{"line":2}}}

private NON_OBJECT_HIGHLIGHT_POSITION_BODY: String =
	|{"jsonrpc":"2.0","id":10,"method":"textDocument/documentHighlight","params":{
	|"textDocument":{"uri":"file:///workspace/main.brp"},
	|"position":[]}}


private pure func dispatch_body(body: String) -> Option[SemanticQueryDispatch]:
	match decode_lsp_json_rpc_body(body):
		Err(_):
			None
		Ok(envelope):
			Some(dispatch_lsp_semantic_query(envelope))


private pure func rejected_parameters_equal(body: String, method: String, detail: String) -> Bool:
	match dispatch_body(body):
		Some(SemanticQueryRejected(failure)):
			match failure.error:
				InvalidMethodParameters(actual_method, actual_detail):
					actual_method == method and actual_detail == detail
				_:
					False
		_:
			False


private pure func query_dispatch_case() -> Option[Bool]:
	definition ?= dispatch_body(DEFINITION_BODY)
	document_symbols ?= dispatch_body(DOCUMENT_SYMBOL_BODY)
	references ?= dispatch_body(REFERENCES_BODY)
	hover ?= dispatch_body(HOVER_BODY)
	document_highlights ?= dispatch_body(DOCUMENT_HIGHLIGHT_BODY)
	unknown ?= dispatch_body(UNKNOWN_OPERATION_BODY)
	notification ?= dispatch_body(DEFINITION_NOTIFICATION_BODY)
	invalid ?= dispatch_body(INVALID_DOCUMENT_SYMBOL_BODY)

	definition_ok = match definition:
		SemanticQueryAccepted(DefinitionSemanticQuery(_)):
			True
		_:
			False

	document_symbols_ok = match document_symbols:
		SemanticQueryAccepted(DocumentSymbolSemanticQuery(_)):
			True
		_:
			False

	references_ok = match references:
		SemanticQueryAccepted(ReferencesSemanticQuery(_)):
			True
		_:
			False

	hover_ok = match hover:
		SemanticQueryAccepted(HoverSemanticQuery(_)):
			True
		_:
			False

	document_highlights_ok = match document_highlights:
		SemanticQueryAccepted(DocumentHighlightSemanticQuery(_)):
			True
		_:
			False

	unknown_ok = match unknown:
		SemanticQueryUnhandled(_):
			True
		_:
			False

	notification_ok = match notification:
		SemanticQueryIgnored(_):
			True
		_:
			False

	invalid_ok = match invalid:
		SemanticQueryRejected(failure):
			match failure.error:
				InvalidMethodParameters(method, _):
					method == "textDocument/documentSymbol"
				_:
					False
		_:
			False

	Some(
		(
			definition_ok
			and document_symbols_ok
			and references_ok
			and hover_ok
			and document_highlights_ok
			and unknown_ok
			and notification_ok
			and invalid_ok
		),
	)


func test_semantic_query_dispatch_is_typed_and_exhaustive() -> Bool:
	query_dispatch_case().get_or(False)


func test_dispatches_definition_query() -> Bool:
	match dispatch_body(DEFINITION_BODY):
		Some(SemanticQueryAccepted(DefinitionSemanticQuery(request))):
			(
				document_uri_value(request.uri) == "file:///workspace/main.brp"
				and request.position.line == 2
				and request.position.utf16_character == 4
			)
		_:
			False


func test_dispatches_document_symbol_query() -> Bool:
	match dispatch_body(DOCUMENT_SYMBOL_BODY):
		Some(SemanticQueryAccepted(DocumentSymbolSemanticQuery(_))):
			True
		_:
			False


func test_dispatches_references_query() -> Bool:
	match dispatch_body(REFERENCES_BODY):
		Some(SemanticQueryAccepted(ReferencesSemanticQuery(_))):
			True
		_:
			False


func test_dispatches_hover_query() -> Bool:
	match dispatch_body(HOVER_BODY):
		Some(SemanticQueryAccepted(HoverSemanticQuery(_))):
			True
		_:
			False


func test_dispatches_document_highlight_query() -> Bool:
	match dispatch_body(DOCUMENT_HIGHLIGHT_BODY):
		Some(SemanticQueryAccepted(DocumentHighlightSemanticQuery(_))):
			True
		_:
			False


func test_rejects_invalid_document_highlight_parameters() -> Bool:
	match dispatch_body(INVALID_DOCUMENT_HIGHLIGHT_BODY):
		Some(SemanticQueryRejected(failure)):
			match failure.error:
				InvalidMethodParameters(method, detail):
					method == "textDocument/documentHighlight" and detail.contains("textDocument")
				_:
					False
		_:
			False


func test_leaves_non_query_envelopes_unhandled() -> Bool:
	match dispatch_body(UNKNOWN_OPERATION_BODY):
		Some(SemanticQueryUnhandled(_)):
			True
		_:
			False


func test_ignores_semantic_notifications() -> Bool:
	match dispatch_body(DEFINITION_NOTIFICATION_BODY):
		Some(SemanticQueryIgnored(_)):
			True
		_:
			False


func test_preserves_query_parameter_errors() -> Bool:
	match dispatch_body(INVALID_DOCUMENT_SYMBOL_BODY):
		Some(SemanticQueryRejected(failure)):
			match failure.error:
				InvalidMethodParameters(method, _):
					method == "textDocument/documentSymbol"
				_:
					False
		_:
			False


func test_rejects_negative_definition_line() -> Bool:
	rejected_parameters_equal(
		NEGATIVE_DEFINITION_LINE_BODY,
		"textDocument/definition",
		"`line` must be non-negative",
	)


func test_rejects_non_integer_reference_character() -> Bool:
	rejected_parameters_equal(
		NON_INTEGER_REFERENCE_CHARACTER_BODY,
		"textDocument/references",
		"`character` must be a signed 32-bit integer",
	)


func test_rejects_missing_hover_character() -> Bool:
	rejected_parameters_equal(
		MISSING_HOVER_CHARACTER_BODY,
		"textDocument/hover",
		"missing required `character` integer",
	)


func test_rejects_non_object_highlight_position() -> Bool:
	rejected_parameters_equal(
		NON_OBJECT_HIGHLIGHT_POSITION_BODY,
		"textDocument/documentHighlight",
		"`position` must be an object",
	)


private pure func encoded_document_symbol_kinds() -> Option[List[Float]]:
	range: ProtocolRange = {
		start = position(1, 2),
		end = position(3, 4)
	}
	response = encode_lsp_document_symbol_response(ProtocolSuccessResponse(
		IntegerRequestId(11),
		Some([
			{
				name = "method",
				kind = DocumentSymbolMethod,
				range = range,
				selection_range = range
			},
			{
				name = "field",
				kind = DocumentSymbolField,
				range = range,
				selection_range = range
			},
			{
				name = "constructor",
				kind = DocumentSymbolConstructor,
				range = range,
				selection_range = range
			},
			{
				name = "class",
				kind = DocumentSymbolClass,
				range = range,
				selection_range = range
			},
			{
				name = "interface",
				kind = DocumentSymbolInterface,
				range = range,
				selection_range = range
			},
			{
				name = "function",
				kind = DocumentSymbolFunction,
				range = range,
				selection_range = range
			},
			{
				name = "variable",
				kind = DocumentSymbolVariable,
				range = range,
				selection_range = range
			},
		]),
	))
	json ?= parse_json(response).to_option()
	result ?= get_field(json, "result")
	values ?= as_array(result)
	kinds = values.filter_map(func(value):
		match get_field(value, "kind"):
			Some(kind):
				as_number(kind)
			None:
				None
	)

	if kinds.length() == values.length():
		Some(kinds)
	else:
		None


func test_document_symbol_wire_kinds_follow_lsp_values() -> Bool:
	match encoded_document_symbol_kinds():
		Some(kinds):
			(
				kinds.length() == 7
				and kinds.get(0) == Some(6.0)
				and kinds.get(1) == Some(8.0)
				and kinds.get(2) == Some(9.0)
				and kinds.get(3) == Some(5.0)
				and kinds.get(4) == Some(11.0)
				and kinds.get(5) == Some(12.0)
				and kinds.get(6) == Some(13.0)
			)
		None:
			False


tests: TestSuite = {
	description = "Compiler LSP semantic query dispatch",
	tests = [
		(
			"semantic query dispatch is typed and exhaustive",
			test_semantic_query_dispatch_is_typed_and_exhaustive,
		),
		("dispatches definition query", test_dispatches_definition_query),
		("dispatches document symbol query", test_dispatches_document_symbol_query),
		("dispatches references query", test_dispatches_references_query),
		("dispatches document highlight query", test_dispatches_document_highlight_query),
		(
			"rejects invalid document highlight parameters",
			test_rejects_invalid_document_highlight_parameters,
		),
		("dispatches hover query", test_dispatches_hover_query),
		("leaves non-query envelopes unhandled", test_leaves_non_query_envelopes_unhandled),
		("ignores semantic notifications", test_ignores_semantic_notifications),
		("preserves query parameter errors", test_preserves_query_parameter_errors),
		("rejects negative definition line", test_rejects_negative_definition_line),
		("rejects non-integer reference character", test_rejects_non_integer_reference_character),
		("rejects missing hover character", test_rejects_missing_hover_character),
		("rejects non-object highlight position", test_rejects_non_object_highlight_position),
		(
			"document symbol wire kinds follow LSP values",
			test_document_symbol_wire_kinds_follow_lsp_values,
		),
	]
}
