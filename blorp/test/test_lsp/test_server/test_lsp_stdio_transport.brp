import:
	../../../src/lsp/lsp_stdio_transport:
		CompilerStdinReadOutcome(CompilerStdinReadFailed),
		CompilerStdioError(CompilerStdioInvalidInput),
		compiler_stdin_read,
		compiler_stdout_write_all,
	bytes: bytes
	test: TestSuite


func test_non_positive_read_size_is_rejected() -> Bool:
	match compiler_stdin_read(0):
		CompilerStdinReadFailed(CompilerStdioInvalidInput(_)):
			True
		_:
			False


func test_empty_write_all_succeeds_without_output() -> Bool:
	compiler_stdout_write_all(bytes(0)).is_ok()


tests: TestSuite = {
	description = "Compiler-private LSP stdio transport",
	tests = [
		("non-positive read size is rejected", test_non_positive_read_size_is_rejected),
		("empty write-all succeeds without output", test_empty_write_all_succeeds_without_output),
	]
}
