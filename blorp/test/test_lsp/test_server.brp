        ("a request before initialize gets -32002", test_a_request_before_initialize_gets_32002),
        (
            "a notification before initialize is dropped",
            test_a_notification_before_initialize_is_dropped
        ),
        ("an unknown request gets -32601", test_an_unknown_request_gets_32601),
        ("an invalid message gets -32600", test_an_invalid_message_gets_32600),
        ("a second initialize gets -32600", test_a_second_initialize_gets_32600),
        (
            "shutdown returns null and later requests get -32600",
            test_shutdown_returns_null_and_later_requests_get_32600
