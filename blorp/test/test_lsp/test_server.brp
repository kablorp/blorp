---
The server's step: each message through `receive`, the lifecycle and its
errors, the open documents, the diagnostics each analysis publishes, which
roots a change stales, token requests answered at once or after an analysis,
definitions and references, and the library files a client opens.
---
import:
    bool: and, not, or
    bytes: Bytes, String methods, from_list
    io/environment: get_current_directory
    json: Json(Null, Text, Array, Object), parse, render
    list: List methods
    option: Option methods
    path: Path, join, normalize, parent, to_path
    result: Result methods
    string: String methods
    test: TestSuite
    ../../src/common/analysis/load/load:
        LibrarySource(EmbeddedLibrary, LibraryDirectory),
        library_layout,
        load_program_with_sources
    ../../src/common/syntax/source:
        ModuleKind(UserModule, LibraryModule, FoundationTypesModule, FoundationPreludeModule),
        ModuleSource,
        SourceFile,
        module_id,
        module_source
    ../../src/common/syntax/syntax: Diagnostic, Span, compiler_span, diagnostic, internal_error
    ../../src/lsp/protocol: file_uri
    ../../src/lsp/server:
        AnalysisOutcome(LoadFailed, CheckFailed, Analysed),
        AnalysisRequest,
        DocumentAnalysis,
        ServedLibrary,
        Server,
        Step,
        analysed,
        document_analysis,
        exit_status,
        library_left,
        receive,
        receive_body,
        shutdown_reply,
        snapshots,
        start_server
    ../driver/file_access: read_file
    ../driver/harness: LIBRARY_ROOT


private pure func json(text: String) -> Json:
    match parse(text):
        Ok(value): value
        Err(_): Null


private pure func path(text: String) -> Option[Path]:
    match text.to_path():
        Ok(present): Some(present)
        Err(_): None


-- The step the last message gives, after the ones before it, from `server`.
private pure func after(server: Server, messages: List[String]) -> Step:
    var step: Step = { server = server, replies = [], analyse = None }
    for message in messages:
        step = step.server.receive(json(message))
    step


-- The folder the tests' servers view the library in. Nothing is there: every
-- analysis here reads the embedded library.
private LIBRARY: String = "/library"

-- Where a load would resolve a relative library root. LIBRARY and the
-- embedded root are fixed, so the layouts never read it.
private WORKING_DIRECTORY: String = "/work"


-- The library a server serves: the embedded one, viewed in `view`.
private pure func served(view: Path, directory: Path) -> Option[ServedLibrary]:
    match (
        library_layout(EmbeddedLibrary, directory),
        library_layout(LibraryDirectory(view.to_string()), directory)
    ):
        (Ok(embedded), Ok(view_layout)): Some({ analysed = embedded, view = view_layout })
        _: None


-- A new server whose library's view is LIBRARY. The paths are valid, so the
-- layouts are always built; were they not, every test that needs a server
-- would fail.
private pure func new_server() -> Option[Server]:
    match (LIBRARY.to_path(), WORKING_DIRECTORY.to_path()):
        (Ok(view), Ok(directory)): served(view, directory).map(start_server)
        _: None


-- A pure test of a new server.
private pure func serving(test: pure (Server) -> Bool) -> Bool:
    match new_server():
        Some(server): test(server)
        None: False


-- A test of a new server that loads real programs.
private func loading(test: (Server) -> Bool) -> Bool:
    match new_server():
        Some(server): test(server)
        None: False


private pure func replies(step: Step) -> List[String]:
    step.replies.map(render)


-- The root a step asks the transport to analyse.
private pure func analysed_path(step: Step) -> Option[Path]:
    step.analyse.map(pure func(asked: AnalysisRequest) -> Path: asked.root)


-- Whether the step answers with exactly `expected` and asks for no analysis.
private pure func answers(step: Step, expected: List[String]) -> Bool:
    and(step.replies.map(render) == expected, step.analyse.is_none())


private INITIALIZE: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{\"general\":{\"positionEncodings\":[\"utf-16\",\"utf-8\"]}}}}"


private INITIALIZE_UTF16: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{}}}"


private SHUTDOWN: String = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\"}"

private EXIT: String = "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}"

private ROOT: String = "/work/main.brp"

private ROOT_URI: String = "file:///work/main.brp"

private OTHER: String = "/work/other.brp"

private OTHER_URI: String = "file:///work/other.brp"

-- The accented e takes two bytes and one UTF-16 unit, so a span after it has different
-- characters in the two encodings.
private ROOT_TEXT: String = "x = \"é\" + 1\n"


private pure func did_open(uri: String, text: String) -> String:
    "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"${uri}\",\"languageId\":\"blorp\",\"version\":1,\"text\":\"${text}\"}}}"


private pure func did_change(uri: String, text: String) -> String:
    "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"${uri}\",\"version\":2},\"contentChanges\":[{\"text\":\"old\"},{\"text\":\"${text}\"}]}}"


private pure func did_close(uri: String) -> String:
    "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"${uri}\"}}}"


private pure func initialized_reply(encoding: String) -> String:
    "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"capabilities\":{\"positionEncoding\":\"${encoding}\",\"textDocumentSync\":{\"openClose\":true,\"change\":1},\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":[\"namespace\",\"type\",\"interface\",\"enumMember\",\"typeParameter\",\"parameter\",\"variable\",\"property\",\"function\",\"method\",\"keyword\",\"comment\",\"string\",\"number\",\"operator\"],\"tokenModifiers\":[\"declaration\",\"readonly\",\"defaultLibrary\",\"documentation\"]},\"full\":true},\"definitionProvider\":true,\"referencesProvider\":true}}}"


private pure func error_reply(id: String, code: Int, message: String) -> String:
    "{\"jsonrpc\":\"2.0\",\"id\":${id},\"error\":{\"code\":${code},\"message\":\"${message}\"}}"


-- lifecycle

pure func test_initialize_chooses_utf8_when_the_client_offers_it() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .after([INITIALIZE])
            .answers([initialized_reply("utf-8")])
    )


pure func test_initialize_chooses_utf16_otherwise() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .after([INITIALIZE_UTF16])
            .answers([initialized_reply("utf-16")])
    )


pure func test_a_request_before_initialize_gets_32002() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .after([SHUTDOWN])
            .answers([error_reply("2", -32002, "the server has not been initialized")])
    )


pure func test_a_notification_before_initialize_is_dropped() -> Bool:
    serving(pure func(server: Server) -> Bool:
        and(
            server
                .after([did_open(ROOT_URI, "x")])
                .answers([]),
            server
                .after([did_open(ROOT_URI, "x"), INITIALIZE]).server
                .snapshots()
                .is_empty()
        )
    )


pure func test_an_unknown_request_gets_32601() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .after([
                INITIALIZE,
                "{\"jsonrpc\":\"2.0\",\"id\":\"h\",\"method\":\"textDocument/hover\"}"
            ])
            .answers([error_reply("\"h\"", -32601, "unknown method `textDocument/hover`")])
    )


pure func test_an_invalid_message_gets_32600() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .after([INITIALIZE, "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":7}"])
            .answers([
                error_reply("5", -32600, "the message is not a JSON-RPC request or notification")
            ])
    )


pure func test_a_second_initialize_gets_32600() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .after([INITIALIZE, INITIALIZE])
            .answers([error_reply("1", -32600, "the server is already initialized")])
    )


private SHUTDOWN_REPLY: String = "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":null}"


-- The reply waits for the transport to leave the library's folder, so the
-- step carries none; the server holds it until `library_left`.
pure func test_shutdown_holds_its_null_reply_until_the_library_is_left() -> Bool:
    serving(pure func(server: Server) -> Bool:
        shut = server.after([INITIALIZE, SHUTDOWN])
        and(
            and(
                shut.answers([]),
                (
                    shut.server
                        .shutdown_reply()
                        .map(render)
                    == Some(SHUTDOWN_REPLY)
                )
            ),
            and(
                server
                    .shutdown_reply()
                    .is_none(),
                shut.server
                    .library_left()
                    .shutdown_reply()
                    .is_none()
            )
        )
    )


pure func test_requests_after_shutdown_get_32600() -> Bool:
    serving(pure func(server: Server) -> Bool:
        shut = server.after([INITIALIZE, SHUTDOWN]).server
        and(
            shut
                .receive(json(SHUTDOWN))
                .answers([error_reply("2", -32600, "the server has shut down")]),
            shut
                .library_left()
                .receive(json(SHUTDOWN))
                .answers([error_reply("2", -32600, "the server has shut down")])
        )
    )


pure func test_exit_ends_with_0_only_after_shutdown() -> Bool:
    serving(pure func(server: Server) -> Bool:
        and(
            and(
                and(
                    (
                        server
                            .after([INITIALIZE, SHUTDOWN, EXIT]).server
                            .exit_status()
                        == Some(0)
                    ),
                    (
                        server
                            .after([INITIALIZE, SHUTDOWN]).server
                            .library_left()
                            .receive(json(EXIT)).server
                            .exit_status()
                        == Some(0)
                    )
                ),
                (
                    server
                        .after([INITIALIZE, EXIT]).server
                        .exit_status()
                    == Some(1)
                )
            ),
            and(
                (
                    server
                        .after([EXIT]).server
                        .exit_status()
                    == Some(1)
                ),
                (
                    server
                        .after([INITIALIZE, SHUTDOWN]).server
                        .exit_status()
                    == None
                )
            )
        )
    )


pure func test_nothing_is_answered_after_exit() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .after([INITIALIZE, EXIT, SHUTDOWN])
            .answers([])
    )


pure func test_cancellations_responses_and_unknown_notifications_are_ignored() -> Bool:
    serving(pure func(server: Server) -> Bool:
        and(
            and(
                server
                    .after([
                        INITIALIZE,
                        "{\"jsonrpc\":\"2.0\",\"method\":\"$/cancelRequest\",\"params\":{\"id\":1}}"
                    ])
                    .answers([]),
                server
                    .after([
                        INITIALIZE,
                        "{\"jsonrpc\":\"2.0\",\"method\":\"workspace/didChangeConfiguration\"}"
                    ])
                    .answers([])
            ),
            server
                .after([INITIALIZE, "{\"jsonrpc\":\"2.0\",\"id\":9,\"result\":null}"])
                .answers([])
        )
    )


-- bodies

pure func test_a_body_that_is_not_utf8_gets_32700() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .receive_body(from_list([123, 255]))
            .answers([error_reply("null", -32700, "the message body is not UTF-8")])
    )


pure func test_a_body_that_is_not_json_gets_32700() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .receive_body("{x}".to_bytes())
            .answers([
                error_reply(
                    "null",
                    -32700,
                    "the message body is not JSON: expected a quoted object name"
                )
            ])
    )


pure func test_a_json_body_is_received() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .receive_body(INITIALIZE.to_bytes())
            .answers([initialized_reply("utf-8")])
    )


-- documents

private pure func snapshot(path_text: String, contents: String) -> SourceFile:
    { path = path_text, contents = contents }


-- The analysis answers no request.
pure func test_did_open_asks_to_analyse_its_document() -> Bool:
    serving(pure func(server: Server) -> Bool:
        step = server.after([INITIALIZE, did_open(ROOT_URI, "x = 1")])
        answers_nothing = step.analyse.map(
            pure func(asked: AnalysisRequest) -> Bool: asked.answering.is_none()
        )
        and(
            and(step.replies.is_empty(), step.analysed_path() == path(ROOT)),
            and(
                answers_nothing == Some(True),
                step.server.snapshots() == [snapshot(ROOT, "x = 1")]
            )
        )
    )


pure func test_did_change_keeps_the_last_text_without_analysing() -> Bool:
    serving(pure func(server: Server) -> Bool:
        step = server.after([
            INITIALIZE,
            did_open(ROOT_URI, "x = 1"),
            did_change(ROOT_URI, "x = 2")
        ])
        and(step.answers([]), step.server.snapshots() == [snapshot(ROOT, "x = 2")])
    )


pure func test_a_change_to_a_document_not_open_is_ignored() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .after([INITIALIZE, did_change(ROOT_URI, "x = 2")]).server
            .snapshots()
            .is_empty()
    )


pure func test_did_close_reverts_the_document_to_the_disk() -> Bool:
    serving(pure func(server: Server) -> Bool:
        step = server.after([
            INITIALIZE,
            did_open(ROOT_URI, "x = 1"),
            did_open(OTHER_URI, "y = 1"),
            did_close(ROOT_URI)
        ])
        and(step.answers([]), step.server.snapshots() == [snapshot(OTHER, "y = 1")])
    )


pure func test_a_document_without_a_file_uri_is_ignored() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .after([INITIALIZE, did_open("untitled:Untitled-1", "x = 1")])
            .answers([])
    )


pure func test_a_percent_encoded_uri_names_its_decoded_path() -> Bool:
    serving(pure func(server: Server) -> Bool:
        (
            server
                .after([INITIALIZE, did_open("file:///work/a%20b.brp", "x")])
                .analysed_path()
            == path("/work/a b.brp")
        )
    )


-- diagnostics

private pure func in_module(module: Int, start: Int, end: Int) -> Span:
    match module_id(module):
        Some(id): { source = id.module_source(), start = start, end = end }
        None: compiler_span()


-- Rows in module order: the root, the foundation inputs, a library module and
-- a user module the root imports.
private pure func sources(root_text: String) -> List[ModuleSource]:
    [
        { path = ROOT, contents = root_text, role = UserModule },
        { path = "<standard library>/_base.brp", contents = "", role = FoundationTypesModule },
        { path = "<standard library>/prelude.brp", contents = "", role = FoundationPreludeModule },
        { path = "<standard library>/list.brp", contents = "a\nbc\n", role = LibraryModule },
        { path = OTHER, contents = "one\ntwo\n", role = UserModule }
    ]


private pure func rejected(
    root_text: String,
    first: Diagnostic,
    remaining: List[Diagnostic]
) -> DocumentAnalysis:
    {
        sources = { modules = sources(root_text) },
        outcome = CheckFailed({ first = first, remaining = remaining })
    }


-- A program that checks, and one that does not: the constant's value is not
-- an Int.
private CLEAN_TEXT: String = "ONE: Int = 1"

private BROKEN_TEXT: String = "ONE: Int = 1.5"


private func analysis_at(root: String, text: String) -> DocumentAnalysis:
    document_analysis(load_program_with_sources(root, EmbeddedLibrary, [snapshot(root, text)]))


-- A real analysis, as `root`, of a program that checks.
private func clean(root: String) -> DocumentAnalysis:
    analysis_at(root, CLEAN_TEXT)


-- The step `analysed` gives for the root, answering no request.
private pure func analysed_root(server: Server, result: DocumentAnalysis) -> Step:
    match path(ROOT):
        Some(present): server.analysed({ root = present, answering = None }, result)
        None: { server = server, replies = [], analyse = None }


private pure func analysed_at(server: Server, root: String, result: DocumentAnalysis) -> Step:
    match root.to_path():
        Ok(present): server.analysed({ root = present, answering = None }, result)
        Err(_): { server = server, replies = [], analyse = None }


-- What `server` steps to when the analysis that `asked` requested comes back
-- as `result`.
private pure func analysed_as_asked(server: Server, asked: Step, result: DocumentAnalysis) -> Step:
    match asked.analyse:
        Some(request): server.analysed(request, result)
        None: { server = server, replies = [], analyse = None }


private pure func published(uri: String, diagnostics: List[String]) -> String:
    "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"${uri}\",\"diagnostics\":[${diagnostics.join(",")}]}}"


private pure func reported(
    start_line: Int,
    start_character: Int,
    end_line: Int,
    end_character: Int,
    message: String
) -> String:
    "{\"range\":{\"start\":{\"line\":${start_line},\"character\":${start_character}},\"end\":{\"line\":${end_line},\"character\":${end_character}}},\"severity\":1,\"message\":\"${message}\"}"


-- The server after `initialize` and the root's didOpen.
private pure func with_root_open(server: Server, initialize: String) -> Server:
    server.after([initialize, did_open(ROOT_URI, "x")]).server


-- The library file cannot be shown, so its diagnostic goes at the start of the
-- root, led by its location in the view: `bc` starts line 2 of the library
-- text, which LIBRARY holds at `list.brp`.
pure func test_each_user_file_gets_its_diagnostics_and_the_library_its_root() -> Bool:
    serving(pure func(server: Server) -> Bool:
        step = server
            .with_root_open(INITIALIZE)
            .analysed_root(
                rejected(ROOT_TEXT, diagnostic(in_module(0, 10, 11), "first", "fix it"), [
                    diagnostic(in_module(3, 2, 4), "in the library", "nothing"),
                    diagnostic(in_module(4, 4, 7), "second", "fix that"),
                    diagnostic(in_module(0, 0, 1), "third", "and this")
                ])
            )
        step.answers([
            published(ROOT_URI, [
                reported(0, 10, 0, 11, "first\\nhelp: fix it"),
                reported(0, 0, 0, 0, "/library/list.brp:2:1: in the library\\nhelp: nothing"),
                reported(0, 0, 0, 1, "third\\nhelp: and this")
            ]),
            published(OTHER_URI, [reported(1, 0, 1, 3, "second\\nhelp: fix that")])
        ])
    )


pure func test_ranges_count_in_the_agreed_encoding() -> Bool:
    serving(pure func(server: Server) -> Bool:
        result = rejected(ROOT_TEXT, diagnostic(in_module(0, 10, 11), "first", "fix it"), [])
        and(
            server
                .with_root_open(INITIALIZE)
                .analysed_root(result)
                .answers([published(ROOT_URI, [reported(0, 10, 0, 11, "first\\nhelp: fix it")])]),
            server
                .with_root_open(INITIALIZE_UTF16)
                .analysed_root(result)
                .answers([published(ROOT_URI, [reported(0, 9, 0, 10, "first\\nhelp: fix it")])])
        )
    )


pure func test_a_diagnostic_about_blorp_is_shown_at_the_start_of_the_root() -> Bool:
    serving(pure func(server: Server) -> Bool:
        failure: DocumentAnalysis = {
            sources = { modules = [] },
            outcome = LoadFailed(internal_error(compiler_span(), "broken"))
        }
        server
            .with_root_open(INITIALIZE)
            .analysed_root(failure)
            .answers([
                published(ROOT_URI, [
                    reported(
                        0,
                        0,
                        0,
                        0,
                        "internal compiler error: broken\\nhelp: report this compiler error with the input program"
                    )
                ])
            ])
    )


func test_a_fixed_error_publishes_an_empty_list() -> Bool:
    loading(func(server: Server) -> Bool:
        first = server
            .with_root_open(INITIALIZE)
            .analysed_root(
                rejected(ROOT_TEXT, diagnostic(in_module(4, 0, 1), "second", "fix that"), [])
            )
        fixed = clean(ROOT)
        and(
            first.server
                .analysed_root(fixed)
                .answers([published(OTHER_URI, [])]),
            first.server
                .analysed_root(fixed).server
                .analysed_root(fixed)
                .answers([])
        )
    )


pure func test_an_analysis_of_a_document_no_longer_open_is_dropped() -> Bool:
    serving(pure func(server: Server) -> Bool:
        closed = server.after([INITIALIZE, did_open(ROOT_URI, "x"), did_close(ROOT_URI)]).server
        closed
            .analysed_root(
                rejected(ROOT_TEXT, diagnostic(in_module(0, 0, 1), "first", "fix it"), [])
            )
            .answers([])
    )


pure func test_diagnostics_go_to_the_uri_the_client_opened_the_file_by() -> Bool:
    serving(pure func(server: Server) -> Bool:
        -- `%6D` is an `m` that the server's own encoding would not escape.
        written = "file:///work/%6Dain.brp"
        server
            .after([INITIALIZE, did_open(written, "x")]).server
            .analysed_root(
                rejected(ROOT_TEXT, diagnostic(in_module(0, 0, 1), "first", "fix it"), [])
            )
            .answers([published(written, [reported(0, 0, 0, 1, "first\\nhelp: fix it")])])
    )


-- shared files: ROOT imports OTHER, and both are open. ROOT reports `second`
-- in OTHER, and OTHER, analysed as its own root, reports `own` there.

private SECOND: String = "second\\nhelp: fix that"

private OWN: String = "own\\nhelp: fix"


private pure func root_reports_second() -> DocumentAnalysis:
    rejected(ROOT_TEXT, diagnostic(in_module(0, 0, 1), "first", "fix it"), [
        diagnostic(in_module(4, 0, 1), "second", "fix that")
    ])


private pure func other_reports(error: Diagnostic) -> DocumentAnalysis:
    {
        sources = { modules = [{ path = OTHER, contents = "one\ntwo\n", role = UserModule }] },
        outcome = CheckFailed({ first = error, remaining = [] })
    }


private pure func both_open(server: Server) -> Server:
    server.after([INITIALIZE, did_open(ROOT_URI, "x"), did_open(OTHER_URI, "one")]).server


-- OTHER analysed, then ROOT, so OTHER shows `second`.
private pure func other_then_root(server: Server) -> Server:
    server
        .both_open()
        .analysed_at(OTHER, other_reports(diagnostic(in_module(0, 4, 7), "own", "fix"))).server
        .analysed_root(root_reports_second()).server


-- ROOT analysed, then OTHER, so OTHER shows `own`.
private pure func root_then_other(server: Server) -> Server:
    server
        .both_open()
        .analysed_root(root_reports_second()).server
        .analysed_at(OTHER, other_reports(diagnostic(in_module(0, 4, 7), "own", "fix"))).server


pure func test_closing_a_root_shows_what_another_root_reports_in_a_shared_file() -> Bool:
    serving(pure func(server: Server) -> Bool:
        and(
            server
                .other_then_root()
                .receive(json(did_close(ROOT_URI)))
                .answers([
                    published(ROOT_URI, []),
                    published(OTHER_URI, [reported(1, 0, 1, 3, OWN)])
                ]),
            and(
                server
                    .root_then_other()
                    .receive(json(did_close(ROOT_URI)))
                    .answers([
                        published(ROOT_URI, []),
                        published(OTHER_URI, [reported(1, 0, 1, 3, OWN)])
                    ]),
                server
                    .root_then_other()
                    .receive(json(did_close(OTHER_URI)))
                    .answers([published(OTHER_URI, [reported(0, 0, 0, 1, SECOND)])])
            )
        )
    )


func test_a_root_that_stops_reporting_in_a_shared_file_shows_another_roots() -> Bool:
    loading(func(server: Server) -> Bool:
        and(
            server
                .other_then_root()
                .analysed_root(clean(ROOT))
                .answers([
                    published(ROOT_URI, []),
                    published(OTHER_URI, [reported(1, 0, 1, 3, OWN)])
                ]),
            server
                .root_then_other()
                .analysed_at(OTHER, clean(OTHER))
                .answers([published(OTHER_URI, [reported(0, 0, 0, 1, SECOND)])])
        )
    )


-- Three roots report in one shared file. After X, Y and Z, X is analysed again,
-- so when Z closes the file shows X's, the latest of the others, not Y's.
private SHARED: String = "/work/shared.brp"


private pure func reports_in_shared(root: String, message: String) -> DocumentAnalysis:
    {
        sources = {
            modules = [
                { path = root, contents = "", role = UserModule },
                { path = SHARED, contents = "s\n", role = UserModule }
            ]
        },
        outcome = CheckFailed({
            first = diagnostic(in_module(1, 0, 1), message, "h"),
            remaining = []
        })
    }


pure func test_the_most_recently_analysed_root_wins_a_shared_file() -> Bool:
    serving(pure func(server: Server) -> Bool:
        opened = server.after([
            INITIALIZE,
            did_open("file:///work/x.brp", "x"),
            did_open("file:///work/y.brp", "y"),
            did_open("file:///work/z.brp", "z")
        ]).server
        reported_by_all = opened
            .analysed_at("/work/x.brp", reports_in_shared("/work/x.brp", "x")).server
            .analysed_at("/work/y.brp", reports_in_shared("/work/y.brp", "y")).server
            .analysed_at("/work/z.brp", reports_in_shared("/work/z.brp", "z")).server
            .analysed_at("/work/x.brp", reports_in_shared("/work/x.brp", "x again")).server
        reported_by_all
            .receive(json(did_close("file:///work/z.brp")))
            .answers([
                published("file:///work/shared.brp", [reported(0, 0, 0, 1, "x again\\nhelp: h")])
            ])
    )


-- analysing a loaded program

private func analysis_of(text: String) -> DocumentAnalysis:
    analysis_at(ROOT, text)


func test_a_check_failure_reaches_the_server_as_data() -> Bool:
    result = analysis_of("func main() -> Int:\n    x: Int = \"one\"\n    x\n")
    match result.outcome:
        CheckFailed(errors):
            and(
                and(errors.first.span == in_module(0, 33, 38), errors.remaining.is_empty()),
                and(
                    errors.first.message == "expression does not match the expected type",
                    (
                        result.sources.modules
                            .get(0)
                            .map(pure func(row: ModuleSource): row.role)
                        == Some(UserModule)
                    )
                )
            )
        LoadFailed(_) | Analysed(_):
            False


func test_a_load_failure_reaches_the_server_as_data() -> Bool:
    match analysis_of("$").outcome:
        LoadFailed(error):
            and(error.span == in_module(0, 0, 1), error.message == "unsupported character")
        CheckFailed(_) | Analysed(_):
            False


func test_a_program_without_main_analyses() -> Bool:
    match analysis_of("pure func value() -> Int:\n    1\n").outcome:
        Analysed(_): True
        LoadFailed(_) | CheckFailed(_): False


-- staleness: a token request on a stale root asks for an analysis first. The
-- analyses here were rejected, so they need no checked program, and a current
-- one answers with the lexer's tokens at once.

private pure func tokens_request(id: Int, uri: String) -> String:
    "{\"jsonrpc\":\"2.0\",\"id\":${id},\"method\":\"textDocument/semanticTokens/full\",\"params\":{\"textDocument\":{\"uri\":\"${uri}\"}}}"


-- Whether a token request on `uri` must first analyse its root.
private pure func stale(server: Server, uri: String) -> Bool:
    server
        .receive(json(tokens_request(9, uri))).analyse
        .is_some()


private pure func changed(server: Server, message: String) -> Server:
    server.receive(json(message)).server


-- A rejected analysis of `root` that read `files` too.
private pure func reading(root: String, files: List[String]) -> DocumentAnalysis:
    {
        sources = {
            modules = [root]
                .concat(files)
                .map(
                    pure func(file: String) -> ModuleSource: {
                        path = file,
                        contents = "",
                        role = UserModule
                    }
                )
        },
        outcome = CheckFailed({
            first = diagnostic(in_module(0, 0, 0), "rejected", "h"),
            remaining = []
        })
    }


-- ROOT read OTHER from the disk, so opening OTHER, whose unsaved text the next
-- analysis reads, stales ROOT.
pure func test_opening_a_file_stales_the_roots_that_read_it() -> Bool:
    serving(pure func(server: Server) -> Bool:
        reads_other = server
            .with_root_open(INITIALIZE)
            .analysed_root(reading(ROOT, [OTHER])).server
        and(
            not(reads_other.stale(ROOT_URI)),
            reads_other
                .changed(did_open(OTHER_URI, "y"))
                .stale(ROOT_URI)
        )
    )


-- ROOT read only itself, so editing OTHER leaves it current until ROOT
-- imports OTHER and is analysed again.
pure func test_a_newly_imported_file_stales_its_importer_after_the_next_analysis() -> Bool:
    serving(pure func(server: Server) -> Bool:
        alone = server
            .both_open()
            .analysed_root(reading(ROOT, [])).server
        importing = alone
            .changed(did_change(ROOT_URI, "import"))
            .analysed_root(reading(ROOT, [OTHER])).server
        and(
            not(
                alone
                    .changed(did_change(OTHER_URI, "z"))
                    .stale(ROOT_URI)
            ),
            importing
                .changed(did_change(OTHER_URI, "z"))
                .stale(ROOT_URI)
        )
    )


pure func test_editing_a_shared_file_stales_every_root_that_read_it() -> Bool:
    serving(pure func(server: Server) -> Bool:
        current = server
            .both_open()
            .analysed_root(reading(ROOT, [OTHER])).server
            .analysed_at(OTHER, reading(OTHER, [])).server
        edited = current.changed(did_change(OTHER_URI, "z"))
        and(
            and(not(current.stale(ROOT_URI)), not(current.stale(OTHER_URI))),
            and(edited.stale(ROOT_URI), edited.stale(OTHER_URI))
        )
    )


-- ROOT read OTHER's unsaved text, which closing OTHER discards.
pure func test_closing_a_file_stales_the_roots_that_read_its_unsaved_text() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .both_open()
            .analysed_root(reading(ROOT, [OTHER])).server
            .analysed_at(OTHER, reading(OTHER, [])).server
            .changed(did_close(OTHER_URI))
            .stale(ROOT_URI)
    )


-- A module the load could not find may exist after any change.
pure func test_a_root_whose_load_failed_is_stale_after_any_change() -> Bool:
    serving(pure func(server: Server) -> Bool:
        failed: DocumentAnalysis = {
            sources = { modules = [{ path = ROOT, contents = "", role = UserModule }] },
            outcome = LoadFailed(diagnostic(in_module(0, 0, 0), "missing", "h"))
        }
        loaded = server
            .with_root_open(INITIALIZE)
            .analysed_root(failed).server
        and(
            not(loaded.stale(ROOT_URI)),
            loaded
                .changed(did_open(OTHER_URI, "y"))
                .stale(ROOT_URI)
        )
    )


private pure func watched_change(uri: String) -> String:
    "{\"jsonrpc\":\"2.0\",\"method\":\"workspace/didChangeWatchedFiles\",\"params\":{\"changes\":[{\"uri\":\"${uri}\",\"type\":2}]}}"


-- A change on disk to a file that is not open stales its readers; an open
-- file's text is the editor's, so its change on disk stales nothing.
pure func test_a_change_on_disk_stales_only_through_a_file_not_open() -> Bool:
    serving(pure func(server: Server) -> Bool:
        read_from_disk = server
            .with_root_open(INITIALIZE)
            .analysed_root(reading(ROOT, [OTHER])).server
        read_open = server
            .both_open()
            .analysed_root(reading(ROOT, [OTHER])).server
        and(
            and(
                read_from_disk
                    .receive(json(watched_change(OTHER_URI)))
                    .answers([]),
                read_from_disk
                    .changed(watched_change(OTHER_URI))
                    .stale(ROOT_URI)
            ),
            not(
                read_open
                    .changed(watched_change(OTHER_URI))
                    .stale(ROOT_URI)
            )
        )
    )


-- token requests, against real analyses

private pure func tokens_reply(id: Int, data: String) -> String:
    "{\"jsonrpc\":\"2.0\",\"id\":${id},\"result\":{\"data\":[${data}]}}"


-- `ONE` declares a read-only variable, `Int` is a built-in type, then `=` and
-- `1`: types 6, 1, 14 and 13 by the legend.
private CLEAN_TOKENS: String = "0,0,3,6,3,0,5,3,1,4,0,4,1,14,0,0,2,1,13,0"

-- Only the lexer's `=` and `1.5`: the root does not check.
private BROKEN_TOKENS: String = "0,9,1,14,0,0,2,3,13,0"


private BROKEN_REPORT: String = "{\"range\":{\"start\":{\"line\":0,\"character\":11},\"end\":{\"line\":0,\"character\":14}},\"severity\":1,\"message\":\"expression does not match the expected type\\nhelp: use an expression of type Int here\"}"


func test_tokens_of_a_current_root_are_sent_at_once() -> Bool:
    loading(func(server: Server) -> Bool:
        server
            .after([INITIALIZE, did_open(ROOT_URI, CLEAN_TEXT)]).server
            .analysed_root(clean(ROOT)).server
            .receive(json(tokens_request(7, ROOT_URI)))
            .answers([tokens_reply(7, CLEAN_TOKENS)])
    )


func test_a_root_that_does_not_check_gets_only_lexer_tokens() -> Bool:
    loading(func(server: Server) -> Bool:
        server
            .after([INITIALIZE, did_open(ROOT_URI, BROKEN_TEXT)]).server
            .analysed_root(analysis_of(BROKEN_TEXT)).server
            .receive(json(tokens_request(7, ROOT_URI)))
            .answers([tokens_reply(7, BROKEN_TOKENS)])
    )


-- The edit fixes the error: the request waits for an analysis, which clears
-- the diagnostic and then answers with the new tokens.
func test_an_edit_refreshes_tokens_and_diagnostics_at_the_next_request() -> Bool:
    loading(func(server: Server) -> Bool:
        opened = server
            .after([INITIALIZE, did_open(ROOT_URI, BROKEN_TEXT)]).server
            .analysed_root(analysis_of(BROKEN_TEXT))
        requested = opened.server
            .changed(did_change(ROOT_URI, CLEAN_TEXT))
            .receive(json(tokens_request(7, ROOT_URI)))
        and(
            and(
                opened.replies.map(render) == [published(ROOT_URI, [BROKEN_REPORT])],
                and(requested.replies.is_empty(), requested.analysed_path() == path(ROOT))
            ),
            requested.server
                .analysed_as_asked(requested, clean(ROOT))
                .answers([published(ROOT_URI, []), tokens_reply(7, CLEAN_TOKENS)])
        )
    )


func test_a_burst_of_edits_costs_one_analysis() -> Bool:
    loading(func(server: Server) -> Bool:
        var edited = server
            .after([INITIALIZE, did_open(ROOT_URI, CLEAN_TEXT)]).server
            .analysed_root(clean(ROOT)).server
        var analyses = 0
        for text in ["ONE: Int = 2", "ONE: Int = 3", CLEAN_TEXT]:
            step = edited.receive(json(did_change(ROOT_URI, text)))
            if step.analyse.is_some():
                analyses = analyses + 1
            edited = step.server
        requested = edited.receive(json(tokens_request(7, ROOT_URI)))
        answered = requested.server
            .analysed_as_asked(requested, clean(ROOT)).server
            .receive(json(tokens_request(8, ROOT_URI)))
        and(
            and(analyses == 0, requested.analyse.is_some()),
            answered.answers([tokens_reply(8, CLEAN_TOKENS)])
        )
    )


private REJECTED: String = "{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"severity\":1,\"message\":\"rejected\\nhelp: h\"}"


-- Each request carries its id to its own analysis, so two requests waiting at
-- once each get their answer, with their own document's tokens.
pure func test_each_waiting_request_is_answered_by_its_own_analysis() -> Bool:
    serving(pure func(server: Server) -> Bool:
        edited = server
            .both_open()
            .analysed_root(reading(ROOT, [])).server
            .analysed_at(OTHER, reading(OTHER, [])).server
            .changed(did_change(ROOT_URI, "x = 2"))
            .changed(did_change(OTHER_URI, "yy = 3.5"))
        first = edited.receive(json(tokens_request(7, ROOT_URI)))
        second = first.server.receive(json(tokens_request(8, OTHER_URI)))
        other_answered = second.server.analysed_as_asked(second, reading(OTHER, []))
        and(
            other_answered.answers([
                published(OTHER_URI, [REJECTED]),
                tokens_reply(8, "0,3,1,14,0,0,2,3,13,0")
            ]),
            other_answered.server
                .analysed_as_asked(first, reading(ROOT, []))
                .answers([
                    published(ROOT_URI, [REJECTED]),
                    tokens_reply(7, "0,2,1,14,0,0,2,1,13,0")
                ])
        )
    )


pure func test_a_token_request_for_a_document_not_open_gets_null() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .after([INITIALIZE, tokens_request(7, ROOT_URI)])
            .answers(["{\"jsonrpc\":\"2.0\",\"id\":7,\"result\":null}"])
    )


-- watching files

private INITIALIZE_WATCHING: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{\"workspace\":{\"didChangeWatchedFiles\":{\"dynamicRegistration\":true}}}}}"


private INITIALIZED: String = "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}"


private REGISTRATION: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"client/registerCapability\",\"params\":{\"registrations\":[{\"id\":\"blorp-source-files\",\"method\":\"workspace/didChangeWatchedFiles\",\"registerOptions\":{\"watchers\":[{\"globPattern\":\"**/*.brp\"}]}}]}}"


pure func test_initialized_registers_for_changed_files_once_when_the_client_can() -> Bool:
    serving(pure func(server: Server) -> Bool:
        and(
            server
                .after([INITIALIZE_WATCHING, INITIALIZED])
                .answers([REGISTRATION]),
            and(
                server
                    .after([INITIALIZE_WATCHING, INITIALIZED, INITIALIZED])
                    .answers([]),
                server
                    .after([INITIALIZE, INITIALIZED])
                    .answers([])
            )
        )
    )


pure func test_the_clients_answer_to_the_registration_is_accepted() -> Bool:
    serving(pure func(server: Server) -> Bool:
        and(
            and(
                server
                    .after([
                        INITIALIZE_WATCHING,
                        INITIALIZED,
                        "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":null}"
                    ])
                    .answers([]),
                server
                    .after([
                        INITIALIZE_WATCHING,
                        INITIALIZED,
                        "{\"jsonrpc\":\"2.0\",\"id\":1,\"error\":{\"code\":-32601,\"message\":\"no\"}}"
                    ])
                    .answers([])
            ),
            server
                .after([
                    INITIALIZE_WATCHING,
                    INITIALIZED,
                    "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":null}",
                    SHUTDOWN
                ])
                .answers([])
        )
    )


-- refreshing an importer

private INITIALIZE_REFRESHING: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{\"workspace\":{\"semanticTokens\":{\"refreshSupport\":true}}}}}"


private INITIALIZE_WATCHING_AND_REFRESHING: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{\"workspace\":{\"didChangeWatchedFiles\":{\"dynamicRegistration\":true},\"semanticTokens\":{\"refreshSupport\":true}}}}}"


private pure func refresh_request(id: Int) -> String:
    "{\"jsonrpc\":\"2.0\",\"id\":${id},\"method\":\"workspace/semanticTokens/refresh\"}"


-- ROOT read OTHER, which is open, and OTHER read only itself, each analysed.
private pure func with_importer(server: Server, initialize: String) -> Server:
    server
        .after([initialize, did_open(ROOT_URI, "x"), did_open(OTHER_URI, "one")]).server
        .analysed_root(reading(ROOT, [OTHER])).server
        .analysed_at(OTHER, reading(OTHER, [])).server


pure func test_an_edit_to_an_imported_file_asks_the_client_to_refresh_when_it_can() -> Bool:
    serving(pure func(server: Server) -> Bool:
        and(
            server
                .with_importer(INITIALIZE_REFRESHING)
                .receive(json(did_change(OTHER_URI, "z")))
                .answers([refresh_request(1)]),
            server
                .with_importer(INITIALIZE)
                .receive(json(did_change(OTHER_URI, "z")))
                .answers([])
        )
    )


-- ROOT read OTHER from the disk; OTHER's opened text replaces it, and OTHER's
-- own analysis is still asked for.
pure func test_opening_an_imported_file_asks_the_client_to_refresh() -> Bool:
    serving(pure func(server: Server) -> Bool:
        opened = server
            .after([INITIALIZE_REFRESHING, did_open(ROOT_URI, "x")]).server
            .analysed_root(reading(ROOT, [OTHER])).server
            .receive(json(did_open(OTHER_URI, "y")))
        and(opened.replies() == [refresh_request(1)], opened.analysed_path() == path(OTHER))
    )


-- Closing OTHER discards the unsaved text ROOT read.
pure func test_closing_an_imported_file_asks_the_client_to_refresh() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .with_importer(INITIALIZE_REFRESHING)
            .receive(json(did_close(OTHER_URI)))
            .answers([published(OTHER_URI, []), refresh_request(1)])
    )


-- ROOT's own edit stales ROOT, whose request the client makes anyway, and
-- OTHER does not read ROOT.
pure func test_an_edit_that_stales_only_its_own_root_asks_for_no_refresh() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .with_importer(INITIALIZE_REFRESHING)
            .receive(json(did_change(ROOT_URI, "z")))
            .answers([])
    )


pure func test_a_root_already_stale_is_not_refreshed_again() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .with_importer(INITIALIZE_REFRESHING)
            .changed(did_change(OTHER_URI, "z"))
            .receive(json(did_change(OTHER_URI, "zz")))
            .answers([])
    )


private SHARED_URI: String = "file:///work/shared.brp"


-- ROOT and OTHER, both open, are analysed having read SHARED from the disk.
private pure func analysed_sharing(server: Server) -> Server:
    server
        .analysed_root(reading(ROOT, [SHARED])).server
        .analysed_at(OTHER, reading(OTHER, [SHARED])).server


-- Two roots go stale, and the client is asked once. The registration took id
-- 1, so the first refresh takes 2 and the next 3.
pure func test_a_change_on_disk_asks_once_and_requests_take_the_next_ids() -> Bool:
    serving(pure func(server: Server) -> Bool:
        opened = server.after([
            INITIALIZE_WATCHING_AND_REFRESHING,
            did_open(ROOT_URI, "x"),
            did_open(OTHER_URI, "one"),
            INITIALIZED
        ])
        first = opened.server
            .analysed_sharing()
            .receive(json(watched_change(SHARED_URI)))
        second = first.server
            .analysed_sharing()
            .receive(json(watched_change(SHARED_URI)))
        and(
            opened.answers([REGISTRATION]),
            and(first.answers([refresh_request(2)]), second.answers([refresh_request(3)]))
        )
    )


pure func test_the_clients_answer_to_a_refresh_is_ignored() -> Bool:
    serving(pure func(server: Server) -> Bool:
        asked = server
            .with_importer(INITIALIZE_REFRESHING)
            .changed(did_change(OTHER_URI, "z"))
        and(
            asked
                .receive(json("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":null}"))
                .answers([]),
            asked
                .receive(
                    json(
                        "{\"jsonrpc\":\"2.0\",\"id\":1,\"error\":{\"code\":-32601,\"message\":\"no\"}}"
                    )
                )
                .answers([])
        )
    )


-- MAIN, opened as `%6Dain.brp`, is clean, and OTHER reports in it under that
-- spelling. Closing MAIN clears the spelling and publishes OTHER's report
-- under the server's own URI, where later analyses publish it.
func test_closing_a_file_by_another_spelling_moves_what_others_report_there() -> Bool:
    loading(func(server: Server) -> Bool:
        written = "file:///work/%6Dain.brp"
        importer: DocumentAnalysis = {
            sources = {
                modules = [
                    { path = OTHER, contents = "", role = UserModule },
                    { path = ROOT, contents = "x\n", role = UserModule }
                ]
            },
            outcome = CheckFailed({
                first = diagnostic(in_module(1, 0, 1), "in main", "h"),
                remaining = []
            })
        }
        imported = server
            .after([INITIALIZE, did_open(written, CLEAN_TEXT), did_open(OTHER_URI, "o")]).server
            .analysed_root(clean(ROOT)).server
            .analysed_at(OTHER, importer)
        in_main = reported(0, 0, 0, 1, "in main\\nhelp: h")
        and(
            imported.answers([published(written, [in_main])]),
            imported.server
                .receive(json(did_close(written)))
                .answers([published(written, []), published(ROOT_URI, [in_main])])
        )
    )


-- After the close the server publishes to the file under its own URI, so the
-- set it published under the client's spelling is cleared.
pure func test_closing_a_file_opened_by_another_spelling_clears_that_spelling() -> Bool:
    serving(pure func(server: Server) -> Bool:
        written = "file:///work/%6Dain.brp"
        server
            .after([INITIALIZE, did_open(written, "x")]).server
            .analysed_root(
                rejected(ROOT_TEXT, diagnostic(in_module(0, 0, 1), "first", "fix it"), [])
            ).server
            .receive(json(did_close(written)))
            .answers([published(written, []), published(ROOT_URI, [])])
    )


-- definitions and references, against real analyses that read the library
-- from its folder, so that library declarations have their files

private HELPERS: String = "/work/helpers.brp"

private HELPERS_URI: String = "file:///work/helpers.brp"

private HELPERS_TEXT: String = "pure func one() -> Int:\n    1\n"


-- The root's text up to line 31; lines are counted from 0 in the comments of
-- the tests below.
private NAVIGATED_START: String =
    |import:
    |    ./helpers as helpers: one
    |
    |
    |record Point {
    |    x: Int
    |}
    |
    |
    |union Shape:
    |    Dot
    |    Circle(Int)
    |
    |
    |trait Sized:
    |    pure func size(value: Self) -> Int
    |
    |
    |implements Sized for Point:
    |    pure func size(value: Self) -> Int:
    |        value.x
    |
    |
    |pure func area(shape: Shape) -> Int:
    |    match shape:
    |        Dot: 0
    |        Circle(radius): radius * radius
    |
    |
    |func main() -> Int:
    |    point: Point = { x = 1 }
    |    total = point.size() + area(Circle(point.x)) + helpers.one()


-- The root's whole text. A pipe string cannot hold `$\{`, so the line that
-- interpolates is quoted.
private pure func navigated_text() -> String:
    NAVIGATED_START + "\n    print(\"$\{total}\")\n    0\n"


-- An analysis of `text` as ROOT, beside HELPERS, reading the embedded library
-- as the transport does.
private func navigated(text: String) -> DocumentAnalysis:
    document_analysis(
        load_program_with_sources(ROOT, EmbeddedLibrary, [
            snapshot(ROOT, text),
            snapshot(HELPERS, HELPERS_TEXT)
        ])
    )


-- `text` as the contents of a JSON string.
private pure func escaped(text: String) -> String:
    quoted = render(Text(text))
    quoted
        .slice(1, quoted.length() - 1)
        .get_or("")


-- `server` initialized by `initialize`, with ROOT open as `text` and analysed.
private func navigating_as(server: Server, initialize: String, text: String) -> Server:
    server
        .after([initialize, did_open(ROOT_URI, text.escaped())]).server
        .analysed_root(navigated(text)).server


private func navigating(server: Server, text: String) -> Server:
    server.navigating_as(INITIALIZE, text)


private INITIALIZE_LINKING: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{\"textDocument\":{\"definition\":{\"linkSupport\":true}}}}}"


-- A LocationLink whose origin is the name at `line` from `start` to `end` of
-- the root, and whose target is `target`, a Location.
private pure func location_link(
    line: Int,
    start: Int,
    end: Int,
    uri: String,
    target_line: Int,
    target_start: Int,
    target_end: Int
) -> String:
    range = "{\"start\":{\"line\":${target_line},\"character\":${target_start}},\"end\":{\"line\":${target_line},\"character\":${target_end}}}"
    "{\"originSelectionRange\":{\"start\":{\"line\":${line},\"character\":${start}},\"end\":{\"line\":${line},\"character\":${end}}},\"targetUri\":\"${uri}\",\"targetRange\":${range},\"targetSelectionRange\":${range}}"


private pure func position_params(uri: String, line: Int, character: Int) -> String:
    "\"textDocument\":{\"uri\":\"${uri}\"},\"position\":{\"line\":${line},\"character\":${character}}"


private pure func definition_request(id: Int, uri: String, line: Int, character: Int) -> String:
    "{\"jsonrpc\":\"2.0\",\"id\":${id},\"method\":\"textDocument/definition\",\"params\":{${position_params(uri, line, character)}}}"


private pure func references_request(
    id: Int,
    uri: String,
    line: Int,
    character: Int,
    includes_declaration: Bool
) -> String:
    included = if includes_declaration:
        "true"
    else:
        "false"
    "{\"jsonrpc\":\"2.0\",\"id\":${id},\"method\":\"textDocument/references\",\"params\":{${position_params(uri, line, character)},\"context\":{\"includeDeclaration\":${included}}}}"


private pure func location(uri: String, line: Int, start: Int, end: Int) -> String:
    "{\"uri\":\"${uri}\",\"range\":{\"start\":{\"line\":${line},\"character\":${start}},\"end\":{\"line\":${line},\"character\":${end}}}}"


private pure func result_reply(id: Int, result: String) -> String:
    "{\"jsonrpc\":\"2.0\",\"id\":${id},\"result\":${result}}"


-- The reply to a definition request at `line` and `character` of the root.
private pure func definition_at(server: Server, line: Int, character: Int) -> List[String]:
    server
        .receive(json(definition_request(7, ROOT_URI, line, character))).replies
        .map(render)


-- The positions in the root, each with where its name is declared, that do
-- not get that one location.
private pure func misplaced(
    server: Server,
    cases: List[(Int, Int, String)]
) -> List[(Int, Int, String)]:
    cases.filter(
        pure func(case: (Int, Int, String)) -> Bool: (
            server.definition_at(case[0], case[1])
            != [result_reply(7, case[2])]
        )
    )


-- On line 31: `point` at 12, `size` 18, `area` 27, `Circle` 32, `x` 45,
-- `helpers` 51 and `one` 59; `shape` on line 24 and `Point` on line 30.
func test_definition_finds_each_kind_of_declaration() -> Bool:
    loading(func(server: Server) -> Bool:
        ready = server.navigating(navigated_text())
        cases: List[(Int, Int, String)] = [
            (31, 12, location(ROOT_URI, 30, 4, 9)),
            (24, 10, location(ROOT_URI, 23, 15, 20)),
            (31, 45, location(ROOT_URI, 5, 4, 5)),
            (31, 33, location(ROOT_URI, 11, 4, 10)),
            (30, 11, location(ROOT_URI, 4, 7, 12)),
            (31, 27, location(ROOT_URI, 23, 10, 14)),
            (31, 18, location(ROOT_URI, 15, 14, 18)),
            (31, 51, location(HELPERS_URI, 0, 0, 0)),
            (31, 59, location(HELPERS_URI, 0, 10, 13))
        ]
        ready
            .misplaced(cases)
            .is_empty()
    )


-- `area` on line 23 and the implementation's `size` on line 19 declare what
-- they name.
func test_definition_on_a_declarations_own_name_answers_it() -> Bool:
    loading(func(server: Server) -> Bool:
        server
            .navigating(navigated_text())
            .misplaced([
                (23, 12, location(ROOT_URI, 23, 10, 14)),
                (19, 14, location(ROOT_URI, 19, 14, 18))
            ])
            .is_empty()
    )


-- The end of `area` on line 31, and the end of `point`, where the `.` after it
-- starts.
func test_definition_counts_an_identifiers_end_as_inside_it() -> Bool:
    loading(func(server: Server) -> Bool:
        server
            .navigating(navigated_text())
            .misplaced([
                (31, 31, location(ROOT_URI, 23, 10, 14)),
                (31, 17, location(ROOT_URI, 30, 4, 9))
            ])
            .is_empty()
    )


-- `total` inside `${...}` on line 32.
func test_definition_of_a_name_inside_an_interpolation() -> Bool:
    loading(func(server: Server) -> Bool:
        server
            .navigating(navigated_text())
            .misplaced([(32, 15, location(ROOT_URI, 31, 4, 9))])
            .is_empty()
    )


-- `Int` on line 5 is built in, and line 2 is blank.
func test_definition_of_a_built_in_type_or_of_no_name_is_null() -> Bool:
    loading(func(server: Server) -> Bool:
        ready = server.navigating(navigated_text())
        and(
            ready.definition_at(5, 8) == [result_reply(7, "null")],
            ready.definition_at(2, 0) == [result_reply(7, "null")]
        )
    )


-- A built-in type is declared nowhere, so its references are every use: the
-- root's on lines 5, 23 and 29, HELPERS', and the rest in the library's view.
func test_references_to_a_built_in_type_are_its_every_use() -> Bool:
    -- Every location in the view, LIBRARY, starts so.
    in_library = "{\"uri\":\"file://${LIBRARY}/"
    loading(func(server: Server) -> Bool:
        found = server
            .navigating(navigated_text())
            .references_at(5, 8, True)
            .listed()
        root_uses = [
            location(ROOT_URI, 5, 7, 10),
            location(ROOT_URI, 23, 32, 35),
            location(ROOT_URI, 29, 15, 18)
        ]
        library_uses = found.filter(
            pure func(each: String) -> Bool: not(
                or(
                    each.starts_with("{\"uri\":\"${ROOT_URI}\""),
                    each.starts_with("{\"uri\":\"${HELPERS_URI}\"")
                )
            )
        )
        and(
            root_uses.all(pure func(wanted: String) -> Bool: found.contains(wanted)),
            and(
                not(library_uses.is_empty()),
                library_uses.all(pure func(each: String) -> Bool: each.starts_with(in_library))
            )
        )
    )


-- The absolute path the loader gives the library file `relative`.
private func library_file(relative: String) -> Option[Path]:
    match (get_current_directory(), "${LIBRARY_ROOT}/${relative}".to_path()):
        (Ok(directory), Ok(file)):
            Some(
                directory
                    .join(file)
                    .normalize()
            )
        _:
            None


-- The line of `text`, counted from 0, that starts with `prefix`.
private pure func line_starting(text: String, prefix: String) -> Option[Int]:
    var found: Option[Int] = None
    var line = 0
    for written in text.lines():
        if and(found.is_none(), written.starts_with(prefix)):
            found = Some(line)
        line = line + 1
    found


-- `print` on line 32 is declared in the library's own file, on the line of
-- that file that declares it.
func test_definition_of_a_library_function_lands_in_its_file() -> Bool:
    match (library_server(), library_file("io/console/output.brp")):
        (Some(server), Some(file)):
            declared: Option[Int] = match read_file(file.to_string()):
                Ok(text): text.line_starting("func print(")
                Err(_): None
            match declared:
                Some(line):
                    (
                        server
                            .navigating(navigated_text())
                            .definition_at(32, 6)
                        == [result_reply(7, location(file.file_uri(), line, 5, 10))]
                    )
                None:
                    False
        _:
            False


-- `area` on line 31 spans 27 to 31 and is declared on line 23; the link's
-- origin is that name whether the position is inside it or at its end.
func test_a_link_supporting_client_gets_the_name_it_asked_about_as_the_origin() -> Bool:
    loading(func(server: Server) -> Bool:
        linked = server.navigating_as(INITIALIZE_LINKING, navigated_text())
        expected = [result_reply(7, location_link(31, 27, 31, ROOT_URI, 23, 10, 14))]
        and(linked.definition_at(31, 29) == expected, linked.definition_at(31, 31) == expected)
    )


-- The same definition without `linkSupport` is a plain Location.
func test_a_client_without_link_support_gets_a_location() -> Bool:
    loading(func(server: Server) -> Bool:
        (
            server
                .navigating(navigated_text())
                .definition_at(31, 29)
            == [result_reply(7, location(ROOT_URI, 23, 10, 14))]
        )
    )


func test_a_link_to_a_library_function_targets_its_file() -> Bool:
    match (library_server(), library_file("io/console/output.brp")):
        (Some(server), Some(file)):
            declared: Option[Int] = match read_file(file.to_string()):
                Ok(text): text.line_starting("func print(")
                Err(_): None
            match declared:
                Some(line):
                    (
                        server
                            .navigating_as(INITIALIZE_LINKING, navigated_text())
                            .definition_at(32, 6)
                        == [result_reply(7, location_link(32, 4, 9, file.file_uri(), line, 5, 10))]
                    )
                None:
                    False
        _:
            False


-- The reply to a references request at `line` and `character` of the root.
private pure func references_at(
    server: Server,
    line: Int,
    character: Int,
    includes_declaration: Bool
) -> List[String]:
    server
        .receive(json(references_request(8, ROOT_URI, line, character, includes_declaration))).replies
        .map(render)


-- The locations of the one references reply in `sent`.
private pure func listed(sent: List[String]) -> List[String]:
    match sent.map(json):
        [Object(fields)]:
            match fields.get("result"):
                Some(Array(found)): found.map(render)
                _: []
        _:
            []


-- Whether `sent` is one references reply listing the distinct `expected`
-- locations, led by the first: uses come in no promised order.
private pure func lists(sent: List[String], expected: List[String]) -> Bool:
    found = sent.listed()
    and(
        and(found.length() == expected.length(), found.take(1) == expected.take(1)),
        expected.all(pure func(wanted: String) -> Bool: found.contains(wanted))
    )


-- `total` is declared on line 31 and used on line 32. The declaration leads
-- when it is asked for.
func test_references_list_the_declaration_only_when_asked() -> Bool:
    loading(func(server: Server) -> Bool:
        ready = server.navigating(navigated_text())
        use = location(ROOT_URI, 32, 13, 18)
        and(
            (
                ready.references_at(32, 13, True)
                == [result_reply(8, "[${location(ROOT_URI, 31, 4, 9)},${use}]")]
            ),
            ready.references_at(31, 6, False) == [result_reply(8, "[${use}]")]
        )
    )


-- Each method of the implementation has its own id for the header's `T`, and
-- each use groups with the header's written `T` on line 7.
private RECEIVER_PARAMETER: String =
    |trait Size:
    |    pure func size(value: Self) -> Int
    |    pure func twice(value: Self) -> Int
    |record Box[T] {
    |    item: T,
    |}
    |implements Size for Box[T]:
    |    pure func size(value: Self) -> Int:
    |        items: List[T] = []
    |        0
    |    pure func twice(value: Self) -> Int:
    |        items: List[T] = []
    |        0


func test_references_group_an_implementations_type_parameter_by_its_declaration() -> Bool:
    loading(func(server: Server) -> Bool:
        uses = [
            location(ROOT_URI, 6, 24, 25),
            location(ROOT_URI, 8, 20, 21),
            location(ROOT_URI, 11, 20, 21)
        ]
        server
            .navigating(RECEIVER_PARAMETER)
            .references_at(8, 20, True)
            .lists(uses)
    )


-- `one` is declared in HELPERS, which the root imports, and the root names it
-- in its import list on line 1 and calls it on line 31.
func test_references_reach_a_declaration_in_an_imported_module() -> Bool:
    loading(func(server: Server) -> Bool:
        found = [
            location(HELPERS_URI, 0, 10, 13),
            location(ROOT_URI, 1, 26, 29),
            location(ROOT_URI, 31, 59, 62)
        ]
        server
            .navigating(navigated_text())
            .references_at(31, 60, True)
            .lists(found)
    )


-- HELPERS is open under another spelling of its path (`%68` is `h`), so its
-- location repeats the client's URI.
func test_locations_use_the_uri_the_client_opened_a_file_by() -> Bool:
    written = "file:///work/%68elpers.brp"
    loading(func(server: Server) -> Bool:
        (
            server
                .after([
                    INITIALIZE,
                    did_open(ROOT_URI, navigated_text().escaped()),
                    did_open(written, HELPERS_TEXT.escaped())
                ]).server
                .analysed_root(navigated(navigated_text())).server
                .definition_at(31, 59)
            == [result_reply(7, location(written, 0, 10, 13))]
        )
    )


-- An edit stales the root, so the request waits for the analysis, which
-- answers it: `total` moved down a line.
func test_a_request_on_a_stale_document_waits_for_its_analysis() -> Bool:
    edited = "\n" + navigated_text()
    loading(func(server: Server) -> Bool:
        edited_server = server
            .navigating(navigated_text())
            .changed(did_change(ROOT_URI, edited.escaped()))
        definition = edited_server.receive(json(definition_request(7, ROOT_URI, 33, 15)))
        references = edited_server.receive(json(references_request(8, ROOT_URI, 33, 15, False)))
        and(
            and(definition.replies.is_empty(), definition.analysed_path() == path(ROOT)),
            and(
                definition.server
                    .analysed_as_asked(definition, navigated(edited))
                    .answers([result_reply(7, location(ROOT_URI, 32, 4, 9))]),
                references.server
                    .analysed_as_asked(references, navigated(edited))
                    .answers([result_reply(8, "[${location(ROOT_URI, 33, 13, 18)}]")])
            )
        )
    )


-- While the root does not check, a definition is null and references are none.
func test_a_root_that_does_not_check_has_no_definitions_or_references() -> Bool:
    loading(func(server: Server) -> Bool:
        broken = server
            .after([INITIALIZE, did_open(ROOT_URI, BROKEN_TEXT)]).server
            .analysed_root(analysis_of(BROKEN_TEXT)).server
        and(
            broken.definition_at(0, 1) == [result_reply(7, "null")],
            broken.references_at(0, 1, True) == [result_reply(8, "[]")]
        )
    )


-- A request without a position cannot name a name.
pure func test_a_request_without_a_position_gets_null() -> Bool:
    serving(pure func(server: Server) -> Bool:
        server
            .after([
                INITIALIZE,
                did_open(ROOT_URI, "x"),
                "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"${ROOT_URI}\"}}}"
            ])
            .answers([result_reply(7, "null")])
    )


-- The token request waits for an analysis, and the document closes before it
-- comes back: the request gets null.
func test_closing_a_document_while_its_request_waits_answers_null() -> Bool:
    loading(func(server: Server) -> Bool:
        waiting = server
            .after([INITIALIZE, did_open(ROOT_URI, CLEAN_TEXT)]).server
            .analysed_root(clean(ROOT)).server
            .changed(did_change(ROOT_URI, CLEAN_TEXT))
            .receive(json(tokens_request(7, ROOT_URI)))
        and(
            waiting.analyse.is_some(),
            waiting.server
                .changed(did_close(ROOT_URI))
                .analysed_as_asked(waiting, clean(ROOT))
                .answers([result_reply(7, "null")])
        )
    )


-- A server whose library is the one the analyses here read.
private func library_server() -> Option[Server]:
    match (get_current_directory(), LIBRARY_ROOT.to_path()):
        (Ok(directory), Ok(root)):
            served(
                directory
                    .join(root)
                    .normalize(),
                directory
            ).map(start_server)
        _:
            None


-- A file of the library's view the client opens, after a definition led
-- there, is not the root of a program: it gets the lexer's tokens of its text,
-- no definition and no references. Its text is no snapshot, and every analysis
-- reads the embedded library, so opening, editing and closing it stale no
-- root; once closed it is forgotten. The foundation's files are the same.
func test_a_library_file_the_client_opens_gets_only_lexer_tokens() -> Bool:
    match (library_server(), library_file("list.brp"), library_file("_base.brp")):
        (Some(server), Some(list), Some(base)):
            uri = list.file_uri()
            ready = server.navigating(navigated_text())
            opened = ready.receive(json(did_open(uri, "x = 1")))
            library = opened.server
            edited = library.receive(json(did_change(uri, "y = 2")))
            closed = edited.server.receive(json(did_close(uri)))
            checks = [
                opened.answers([]),
                library.snapshots() == [snapshot(ROOT, navigated_text())],
                library
                    .receive(json(tokens_request(9, uri)))
                    .answers([tokens_reply(9, "0,2,1,14,0,0,2,1,13,0")]),
                library
                    .receive(json(definition_request(7, uri, 0, 0)))
                    .answers([result_reply(7, "null")]),
                library
                    .receive(json(references_request(8, uri, 0, 0, True)))
                    .answers([result_reply(8, "[]")]),
                edited.answers([]),
                not(edited.server.stale(ROOT_URI)),
                closed.answers([]),
                not(closed.server.stale(ROOT_URI)),
                closed.server
                    .receive(json(tokens_request(9, uri)))
                    .answers([result_reply(9, "null")]),
                ready
                    .receive(json(did_open(base.file_uri(), "x = 1")))
                    .answers([])
            ]
            checks.all(pure func(check: Bool) -> Bool: check)
        _:
            False


