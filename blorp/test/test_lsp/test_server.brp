            test_an_analysis_of_a_document_no_longer_open_is_dropped
        ),
        (
            "diagnostics go to the URI the client opened the file by",
            test_diagnostics_go_to_the_uri_the_client_opened_the_file_by
        ),
        (
            "closing a root shows what another root reports in a shared file",
            test_closing_a_root_shows_what_another_root_reports_in_a_shared_file
        ),
        (
            "a root that stops reporting in a shared file shows another root's",
            test_a_root_that_stops_reporting_in_a_shared_file_shows_another_roots
        ),
        (
            "the most recently analysed root wins a shared file",
            test_the_most_recently_analysed_root_wins_a_shared_file
        ),
        (
            "a check failure reaches the server as data",
            test_a_check_failure_reaches_the_server_as_data
        ),
        (
            "a load failure reaches the server as data",
            test_a_load_failure_reaches_the_server_as_data
        ),
        ("a program without main analyses", test_a_program_without_main_analyses),
        (
            "opening a file stales the roots that read it",
            test_opening_a_file_stales_the_roots_that_read_it
        ),
        (
