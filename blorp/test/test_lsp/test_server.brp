    description = "LSP server",
    tests = [
        (
            "initialize chooses UTF-8 when the client offers it",
            test_initialize_chooses_utf8_when_the_client_offers_it
        ),
        ("initialize chooses UTF-16 otherwise", test_initialize_chooses_utf16_otherwise),
        ("a request before initialize gets -32002", test_a_request_before_initialize_gets_32002),
        (
            "a notification before initialize is dropped",
            test_a_notification_before_initialize_is_dropped
        ),
        ("an unknown request gets -32601", test_an_unknown_request_gets_32601),
        ("an invalid message gets -32600", test_an_invalid_message_gets_32600),
        ("a second initialize gets -32600", test_a_second_initialize_gets_32600),
        (
            "shutdown holds its null reply until the library is left",
            test_shutdown_holds_its_null_reply_until_the_library_is_left
        ),
        ("requests after shutdown get -32600", test_requests_after_shutdown_get_32600),
        ("exit ends with 0 only after shutdown", test_exit_ends_with_0_only_after_shutdown),
        ("nothing is answered after exit", test_nothing_is_answered_after_exit),
        (
            "cancellations, responses and unknown notifications are ignored",
            test_cancellations_responses_and_unknown_notifications_are_ignored
        ),
        ("a body that is not UTF-8 gets -32700", test_a_body_that_is_not_utf8_gets_32700),
        ("a body that is not JSON gets -32700", test_a_body_that_is_not_json_gets_32700),
        ("a JSON body is received", test_a_json_body_is_received),
        ("didOpen asks to analyse its document", test_did_open_asks_to_analyse_its_document),
        (
            "didChange keeps the last text without analysing",
            test_did_change_keeps_the_last_text_without_analysing
        ),
        (
