        ("nothing is answered after exit", test_nothing_is_answered_after_exit),
        (
            "cancellations, responses and unknown notifications are ignored",
            test_cancellations_responses_and_unknown_notifications_are_ignored
        ),
        ("a body that is not UTF-8 gets -32700", test_a_body_that_is_not_utf8_gets_32700),
        ("a body that is not JSON gets -32700", test_a_body_that_is_not_json_gets_32700),
        ("a JSON body is received", test_a_json_body_is_received),
        ("didOpen asks to analyse its document", test_did_open_asks_to_analyse_its_document),
        (
