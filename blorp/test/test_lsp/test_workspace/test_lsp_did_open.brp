import:
	../../../src/lsp/protocol/identity: document_uri_value
	../../../src/lsp/protocol/json_rpc: decode_lsp_json_rpc_body, json_rpc_error_value
	../../../src/lsp/protocol/protocol:
		ProtocolError(InvalidMethodParameters, MalformedJson, UnexpectedRequestId),
		ProtocolInputOutcome(ProtocolInputAccepted, ProtocolInputIgnored, ProtocolInputRejected),
		RequestId(StringRequestId),
	../../../src/lsp/workspace/did_open:
		decode_lsp_did_open_envelope,
		decode_lsp_did_open_notification,
		handle_lsp_did_open_notification,
	../../../src/lsp/workspace/document_model: document_version, document_version_value
	../../../src/lsp/workspace/document_store:
		DOCUMENT_STORE_EMPTY,
		DocumentStoreError(DocumentAlreadyOpen),
		document_store_find,
	json: JsonValue, as_number, as_string, get_field
	test: TestSuite


private DID_OPEN_BODY: String =
	|{
	|  "jsonrpc": "2.0",
	|  "method": "textDocument/didOpen",
	|  "params": {
	|    "textDocument": {
	|      "uri": "file:///workspace/main.brp",
	|      "languageId": "blorp",
	|      "version": 12,
	|      "text": "func main(args: List[String]):\n\tprint(\"hello\")\n"
	|    }
	|  }
	|}

private DID_OPEN_TEXT: String = "func main(args: List[String]):\n\tprint(\"hello\")\n"

private DID_OPEN_REPLACEMENT_BODY: String =
	|{
	|  "jsonrpc": "2.0",
	|  "method": "textDocument/didOpen",
	|  "params": {
	|    "textDocument": {
	|      "uri": "file:///workspace/main.brp",
	|      "languageId": "blorp",
	|      "version": 99,
	|      "text": "replacement"
	|    }
	|  }
	|}


private pure func response_error_code(response: JsonValue) -> Option[Float]:
	error ?= get_field(response, "error")
	code ?= get_field(error, "code")
	code.as_number()


private pure func invalid_parameters_contain(body: String, expected: String) -> Bool:
	match decode_lsp_did_open_notification(body):
		ProtocolInputIgnored(InvalidMethodParameters(method, detail)):
			method == "textDocument/didOpen" and detail.contains(expected)
		_:
			False


func test_did_open_decodes_complete_document() -> Bool:
	match decode_lsp_did_open_notification(DID_OPEN_BODY):
		ProtocolInputAccepted(opened):
			(
				document_uri_value(opened.document.uri) == "file:///workspace/main.brp"
				and opened.language_id == "blorp"
				and document_version_value(opened.document.version) == 12
				and opened.document.text == DID_OPEN_TEXT
			)
		_:
			False


func test_did_open_accepts_predecoded_envelope() -> Bool:
	match decode_lsp_json_rpc_body(DID_OPEN_BODY):
		Err(_):
			False
		Ok(envelope):
			match decode_lsp_did_open_envelope(envelope):
				ProtocolInputAccepted(opened):
					document_version_value(opened.document.version) == 12
				_:
					False


func test_did_open_request_returns_invalid_request_error() -> Bool:
	body: String =
		|{
		|  "jsonrpc": "2.0",
		|  "id": "did-open-request",
		|  "method": "textDocument/didOpen",
		|  "params": {
		|    "textDocument": {
		|      "uri": "file:///workspace/main.brp",
		|      "languageId": "blorp",
		|      "version": 1,
		|      "text": ""
		|    }
		|  }
		|}

	match decode_lsp_did_open_notification(body):
		ProtocolInputRejected(failure):
			error_ok: Bool = match failure.error:
				UnexpectedRequestId(method):
					method == "textDocument/didOpen"
				_:
					False

			id_ok: Bool = match failure.request_id:
				Some(StringRequestId(id)):
					id == "did-open-request"
				_:
					False

			response = json_rpc_error_value(failure)

			response_id_ok: Bool = match get_field(response, "id"):
				Some(id):
					id.as_string() == Some("did-open-request")
				None:
					False

			(
				error_ok
				and id_ok
				and response_id_ok
				and response_error_code(response) == Some(-32600.0)
			)
		_:
			False


func test_did_open_ignores_invalid_notification_parameters() -> Bool:
	missing_params: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\"}",
		"params",
	)

	missing_document: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{}}",
		"textDocument",
	)

	missing_uri: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"languageId\":\"blorp\",\"version\":1,\"text\":\"\"}}}",
		"uri",
	)

	invalid_language: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.brp\",\"languageId\":false,\"version\":1,\"text\":\"\"}}}",
		"languageId",
	)

	invalid_version: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.brp\",\"languageId\":\"blorp\",\"version\":1.5,\"text\":\"\"}}}",
		"version",
	)

	missing_text: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.brp\",\"languageId\":\"blorp\",\"version\":1}}}",
		"text",
	)

	(
		missing_params
		and missing_document
		and missing_uri
		and invalid_language
		and invalid_version
		and missing_text
	)


func test_did_open_rejects_malformed_json() -> Bool:
	match decode_lsp_did_open_notification("{"):
		ProtocolInputRejected(failure):
			match failure.error:
				MalformedJson(_):
					True
				_:
					False
		_:
			False


private pure func has_document_version(value: Int) -> Bool:
	match document_version(value):
		Some(_):
			True
		None:
			False


func test_document_version_enforces_lsp_integer_bounds() -> Bool:
	(
		has_document_version(-2147483648)
		and has_document_version(2147483647)
		and not has_document_version(-2147483649)
		and not has_document_version(2147483648)
	)


func test_document_store_opens_once_and_preserves_original_overlay() -> Bool:
	match decode_lsp_did_open_notification(DID_OPEN_BODY):
		ProtocolInputAccepted(opened):
			match decode_lsp_did_open_notification(DID_OPEN_REPLACEMENT_BODY):
				ProtocolInputIgnored(_) | ProtocolInputRejected(_):
					False
				ProtocolInputAccepted(replacement):
					match handle_lsp_did_open_notification(DOCUMENT_STORE_EMPTY, opened):
						Err(_):
							False
						Ok(store):
							stored_ok: Bool = match document_store_find(store, opened.document.uri):
								Some(stored):
									stored.document.text == DID_OPEN_TEXT
								None:
									False

							duplicate_ok: Bool = match handle_lsp_did_open_notification(
								store,
								replacement,
							):
								Err(DocumentAlreadyOpen(uri)):
									document_uri_value(uri) == "file:///workspace/main.brp"
								Ok(_):
									False

							original_ok: Bool = match document_store_find(
								store,
								opened.document.uri,
							):
								Some(stored):
									(
										document_version_value(stored.document.version) == 12
										and stored.document.text == DID_OPEN_TEXT
									)
								None:
									False

							stored_ok and duplicate_ok and original_ok
		_:
			False


tests: TestSuite = {
	description = "Blorp LSP didOpen notification",
	tests = [
		("decode complete document", test_did_open_decodes_complete_document),
		("accept predecoded envelope", test_did_open_accepts_predecoded_envelope),
		("reject request form", test_did_open_request_returns_invalid_request_error),
		(
			"ignore invalid notification params",
			test_did_open_ignores_invalid_notification_parameters,
		),
		("reject malformed JSON", test_did_open_rejects_malformed_json),
		("enforce document version bounds", test_document_version_enforces_lsp_integer_bounds),
		(
			"open once and preserve original overlay",
			test_document_store_opens_once_and_preserves_original_overlay,
		),
	]
}
