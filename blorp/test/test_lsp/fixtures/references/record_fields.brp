record Point {x: Int, y: Int}
--            ^point_x_decl

record Size {x: Int, y: Int}
--           ^size_x_decl

func main(args: List[String]) -> Int:
    point: Point = {x = 1, y = 2}
--                  ^point_x_literal
    updated: Point = {point | x = 5, y = 6}
--                            ^point_x_update
    size: Size = {x = 3, y = 4}
--                ^size_x_literal
    point.x + point.x + updated.x + size.x
--        ^point_x_use1
--                  ^point_x_use2
--                              ^point_x_use3
--                                       ^size_x_use
