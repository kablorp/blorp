---
Positions in both directions and both encodings: a two-byte scalar, an astral
emoji, and each of the three line endings.
---
import:
    bool: and
    test: TestSuite
    ../../src/lsp/positions:
        LineIndex,
        Position,
        PositionEncoding(Utf8, Utf16),
        line_index,
        offset_of,
        position_of


-- Byte offsets: `a` 0, an accented e at 1-2 (one UTF-16 unit), an emoji at
-- 3-6 (two units), `b` 7, then CRLF at 8-9; `c` 10 and a lone CR at 11; `d` 12
-- and an LF at 13; `e` 14, and the end at 15.
private TEXT: String = "aé😀b\r\nc\rd\ne"


private pure func lines() -> LineIndex:
    line_index(TEXT)


private pure func at(line: Int, character: Int) -> Position:
    { line = line, character = character }


-- Whether `offset` and `position` convert into each other in `encoding`.
private pure func converts(offset: Int, position: Position, encoding: PositionEncoding) -> Bool:
    and(
        lines().position_of(offset, encoding) == position,
        lines().offset_of(position, encoding) == offset
    )


pure func test_utf8_counts_bytes() -> Bool:
    and(and(converts(1, at(0, 1), Utf8), converts(3, at(0, 3), Utf8)), converts(7, at(0, 7), Utf8))


pure func test_utf16_counts_an_astral_scalar_as_two_units() -> Bool:
    and(
        and(converts(1, at(0, 1), Utf16), converts(3, at(0, 2), Utf16)),
        converts(7, at(0, 4), Utf16)
    )


pure func test_crlf_ends_one_line() -> Bool:
    and(converts(8, at(0, 5), Utf16), converts(10, at(1, 0), Utf16))


pure func test_a_lone_cr_ends_a_line() -> Bool:
    and(converts(11, at(1, 1), Utf8), converts(12, at(2, 0), Utf8))


pure func test_lf_ends_a_line() -> Bool:
    and(converts(13, at(2, 1), Utf16), converts(14, at(3, 0), Utf16))


pure func test_the_end_of_the_text_is_a_position() -> Bool:
    and(converts(15, at(3, 1), Utf8), converts(15, at(3, 1), Utf16))


pure func test_a_character_past_its_line_is_the_line_end() -> Bool:
    and(
        and(lines().offset_of(at(0, 100), Utf8) == 8, lines().offset_of(at(1, 5), Utf16) == 11),
        lines().offset_of(at(3, 9), Utf8) == 15
    )


pure func test_a_line_past_the_last_is_the_end() -> Bool:
    lines().offset_of(at(7, 0), Utf16) == 15


pure func test_a_position_inside_a_scalar_is_its_start() -> Bool:
    and(
        and(lines().offset_of(at(0, 2), Utf8) == 1, lines().offset_of(at(0, 3), Utf16) == 3),
        lines().position_of(5, Utf16) == at(0, 2)
    )


pure func test_a_final_line_ending_starts_an_empty_last_line() -> Bool:
    ended = line_index("x\r\n")
    and(
        and(ended.position_of(3, Utf8) == at(1, 0), ended.offset_of(at(1, 0), Utf8) == 3),
        line_index("").position_of(0, Utf16) == at(0, 0)
    )


pure func test_an_offset_past_the_end_is_the_end() -> Bool:
    lines().position_of(40, Utf8) == at(3, 1)


TESTS: TestSuite = {
    description = "LSP positions",
    tests = [
        ("UTF-8 counts bytes", test_utf8_counts_bytes),
        (
            "UTF-16 counts an astral scalar as two units",
            test_utf16_counts_an_astral_scalar_as_two_units
        ),
        ("CRLF ends one line", test_crlf_ends_one_line),
        ("a lone CR ends a line", test_a_lone_cr_ends_a_line),
        ("LF ends a line", test_lf_ends_a_line),
        ("the end of the text is a position", test_the_end_of_the_text_is_a_position),
        (
            "a character past its line is the line end",
            test_a_character_past_its_line_is_the_line_end
        ),
        ("a line past the last is the end", test_a_line_past_the_last_is_the_end),
        ("a position inside a scalar is its start", test_a_position_inside_a_scalar_is_its_start),
        (
            "a final line ending starts an empty last line",
            test_a_final_line_ending_starts_an_empty_last_line
        ),
        ("an offset past the end is the end", test_an_offset_past_the_end_is_the_end)
    ]
}
