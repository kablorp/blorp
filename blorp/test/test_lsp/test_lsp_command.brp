---
The transport's start: a library folder the server cannot make stops it, with
a path problem, before it reads a message.
---
import:
    bool: and
    path: to_path
    test: TestSuite
    ../../src/common/cli/report: kind_status
    ../../src/common/cli/usage: EXIT_PATH
    ../../src/lsp/lsp_command: serve_in_new_folder


-- A file, so no folder can be made in it.
private NOT_A_FOLDER: String = "blorp/test/test_lsp/test_lsp_command.brp"


func test_a_folder_that_cannot_be_made_stops_the_server_with_a_path_problem() -> Bool:
    match NOT_A_FOLDER.to_path():
        Ok(file):
            match serve_in_new_folder(file):
                Err(error):
                    and(
                        (
                            error.message
                            == "blorp lsp could not make or remove its folder in ${NOT_A_FOLDER}: not a directory"
                        ),
                        and(
                            (
                                error.help
                                == "check that ${NOT_A_FOLDER} is a folder blorp can write to"
                            ),
                            error.kind.kind_status() == EXIT_PATH
                        )
                    )
                Ok(_):
                    False
        Err(_):
            False


TESTS: TestSuite = {
    description = "LSP transport",
    tests = [
        (
            "a folder that cannot be made stops the server with a path problem",
            test_a_folder_that_cannot_be_made_stops_the_server_with_a_path_problem
        )
    ]
}
