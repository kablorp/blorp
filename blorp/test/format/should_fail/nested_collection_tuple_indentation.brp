func nested_object(path: String, error_message: String):
	JsonObject([
		("schema", JsonNumber(to_float(BRIDGE_SCHEMA_VERSION))),
		("ok", JsonBool(False)),
		("error", JsonObject([
				("code", JsonString("source_read_error")),
				(
					"message",
					JsonString("failed to read source file `" + path + "`: " + error_message),
				),
			])),
	])
