record Language {safe: Bool, fast: Bool, expressive: Bool, simple: Bool}


struct Metrics {count: Int, average: Float, maximum: Float}


pure func identify(lang: Language) -> String:
	if lang.safe and lang.fast and lang.expressive and lang.simple:
		"blorp detected"
	else:
		"keep looking"


func main(args: List[String]):
	print(identify({safe = True, fast = True, expressive = True, simple = True}))
