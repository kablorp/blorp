import:
	../../src/format/command: run_format_command
	../../src/format/engine/document_layout: post_process
	system: read_file, remove_file, temp_dir, write_file
	test: TestSuite


private LARGE_POST_PROCESS_LINE_COUNT: Int = 20000


private pure func large_blank_line_source(count: Int) -> String:
	var source: String = "start"
	var i: Int = 0

	while i < count:
		source += "\n"
		i += 1

	source + "end\n"


func test_format_help_and_no_files() -> Bool:
	help = run_format_command(["--help"])
	no_files = run_format_command(["/tmp/__blorp_format_missing_path"])

	(
		help.status == 0
		and help.stdout.contains("Usage: blorp format")
		and help.stderr == ""
		and no_files.status == 1
		and no_files.stderr.contains("no .brp files found")
	)


func test_format_check_write_and_recheck() -> Bool:
	path: String = temp_dir() + "/blorp_format_command_test.brp"
	_ = remove_file(path)

	match write_file(path, "func main():\n\t1+2\n"):
		Ok(_):
			check_result = run_format_command(["--check", path])
			write_result = run_format_command([path])
			read_result = read_file(path)
			clean_result = run_format_command(["--check", path])
			_ = remove_file(path)

			match read_result:
				Ok(formatted):
					(
						check_result.status == 1
						and check_result.stdout.contains("needs formatting")
						and check_result.stderr == ""
						and write_result.status == 0
						and write_result.stdout == ""
						and write_result.stderr == ""
						and formatted.contains("1 + 2")
						and clean_result.status == 0
						and clean_result.stdout.contains("ok")
						and clean_result.stderr == ""
					)
				Err(_):
					False
		Err(_):
			False


func test_format_parse_error_reports_path_once() -> Bool:
	path: String = temp_dir() + "/blorp_format_parse_error.brp"
	_ = remove_file(path)

	match write_file(
		path,
		"func main(args: List[String]) -> Int:\n\tvalue: String = \"unterminated\n\t0\n",
	):
		Ok(_):
			result = run_format_command(["--check", path])
			_ = remove_file(path)

			(
				result.status == 1
				and result.stdout == ""
				and result.stderr.contains("Unterminated string literal")
				and not result.stderr.contains(path + ": " + path + ":")
			)
		Err(_):
			False


private FIXPOINT_LONG_SENTENCE: String = (
	"safe fast code should wrap near a word boundary so the formatter does not split "
	+ "words when a reasonable separator is available in the source text"
)


-- Builds a `main` program whose body is `body_lines`, one statement per line.
private pure func main_program(body_lines: List[String]) -> String:
	var source: String = "func main(args: List[String]) -> Int:\n"

	for line in body_lines:
		source += "\t" + line + "\n"

	source


-- Formats `source` twice through the production command and returns both
-- rendered results so a test can assert the first pass is already a fixpoint.
private func format_twice(name: String, source: String) -> Option[(String, String)]:
	path: String = temp_dir() + "/" + name
	_ = remove_file(path)

	match write_file(path, source):
		Ok(_):
			first_write = run_format_command([path])
			first_read = read_file(path)
			second_write = run_format_command([path])
			second_read = read_file(path)
			_ = remove_file(path)

			match (first_read, second_read):
				(Ok(first), Ok(second)):
					if first_write.status == 0 and second_write.status == 0:
						Some((first, second))
					else:
						None
				_:
					None
		Err(_):
			None


func test_format_wrapped_string_statement_is_a_fixpoint() -> Bool:
	source: String = main_program([
		"sentence = \"" + FIXPOINT_LONG_SENTENCE + "\"",
		"sentence.length()",
	])

	match format_twice("blorp_format_fixpoint_wrapped_string.brp", source):
		Some((first, second)):
			first != source and first.contains("\t)\n\tsentence.length()\n") and first == second
		None:
			False


func test_format_wrapped_string_list_element_is_a_fixpoint() -> Bool:
	source: String = main_program([
		"messages = [\"" + FIXPOINT_LONG_SENTENCE + "\"]",
		"messages.length()",
	])

	match format_twice("blorp_format_fixpoint_wrapped_list.brp", source):
		Some((first, second)):
			(
				first != source
				and first.contains("\tmessages = [\n\t\t(\n")
				and first.contains("\t\t),\n\t]\n")
				and first == second
			)
		None:
			False


func test_format_interpolation_preserves_non_ascii_bytes() -> Bool:
	source: String = main_program([
		"count: Int = 42",
		"label: String = \"café: $" + "{count.to_string()}\"",
		"label.length()",
	])

	match format_twice("blorp_format_fixpoint_non_ascii.brp", source):
		Some((first, second)):
			first == source and second == source
		None:
			False


func test_post_process_large_outputs() -> Bool:
	LARGE_POST_PROCESS_LINE_COUNT
		.large_blank_line_source()
		.post_process() == "start\n\n\nend\n"


tests: TestSuite = {
	description = "Blorp formatter command",
	tests = [
		("format help and no files", test_format_help_and_no_files),
		("format check write and recheck", test_format_check_write_and_recheck),
		("format parse error reports path once", test_format_parse_error_reports_path_once),
		("post-process large outputs", test_post_process_large_outputs),
		(
			"wrapped string statement is a fixpoint",
			test_format_wrapped_string_statement_is_a_fixpoint,
		),
		(
			"wrapped string list element is a fixpoint",
			test_format_wrapped_string_list_element_is_a_fixpoint,
		),
		(
			"interpolation preserves non-ASCII bytes",
			test_format_interpolation_preserves_non_ascii_bytes,
		),
	]
}
