func render(prefix: String, suffix: String) -> String:
	prefix + (
		"a plain literal operand that is longer than the wrap limit gets split into a "
		+ "parenthesized group"
	) + suffix


func size() -> Int:
	(
		"a plain literal receiver that is longer than the wrap limit gets split into a "
		+ "parenthesized group"
	).length()
