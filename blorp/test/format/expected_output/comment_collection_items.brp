-- Comments among collection items survive layout changes: a collection with a
-- comment breaks one item per line, nested collections keep their own
-- comments, closing comments stay above the closing bracket, and comments
-- ending a closing or opening bracket's line stay there or move below it.
func add(left: Int, right: Int, extra: Int) -> Int:
	left + right + extra


func add2(a: Int, b: Int) -> Int:
	a + b


func sub2(a: Int, b: Int) -> Int:
	a - b


func brackets() -> Int:
	x = add2(
		sub2(1, 2), -- after bar
		3,
	)
	y = [
		-- o2
		[1], -- after inner
		[2],
	]
	z = add2(
		-- open
		1,
		2,
	) -- close
	w = add2(
		sub2(
			1, -- one
			2,
		),
	) -- both closers
	x + y.length() + z + w


func one(a: Int) -> Int:
	a


func operands() -> Int:
	a = 1 + one(1) -- d1
	c = not (one(1) > 0) -- d3
	d = one(1) + 2 -- d4
	fs = [
		func(w): one(w), -- c4
		func(w): w,
	]
	b = [
		one(1) > 0 and one(2) > 0, -- c5
	]
	e = one(
		one(
			fs.length(), -- inner
		),
	)
		.to_string()
		.length() -- d7
	g = fs
		.map(func(w):
			w(1) -- block tail
		)
		.length() -- after chain
	a + d + e + g


func subscripts() -> Int:
	x = [1, 2]
	h = x[
		one(0), -- r10
	]
	k = x[
		-- the start
		0,
	]
	r = 0..one(1) -- r1
	h + k


func main() -> Int:
	values = [
		1, -- first
		2,
	]
	box = {
		-- field note
		width = 1.0
	}
	grid = [
		[1, 2],
		[
			3, -- three
			4,
		],
	]
	total = add(
		1,
		values.length(), -- the count
		grid.length(),
		-- nothing after
	)
	total
