-- Logical chain comments survive layout changes: a chain with a comment breaks
-- one term per line inside parentheses, even where it would fit on one line.
func value(flag: Bool, other: Bool) -> Bool:
	not (
		flag -- either
		or other
	)


func short(flag: Bool, other: Bool) -> Bool:
	(
		flag -- first
		and other
	)


func main() -> Int:
	0
