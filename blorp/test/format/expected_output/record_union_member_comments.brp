-- Misformatted members keep their comments when the declaration is reformatted:
-- the spacing is fixed and each comment stays beside its member.
record A {
	-- before the first field
	first: Int,
	-- before the last field
	last: Int -- ends the last field's line
	-- after the last field
}


union U:
	-- before the first variant
	One
	-- before a later variant
	Two(Int) -- ends the variant's line
	-- after the last variant
