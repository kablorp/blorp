import:
	../../../src/format/engine/document_json: document_from_json_string, render_document_json
	../../../src/format/engine/document_layout:
		Doc(Hardline, Softline, SoftlineSpace),
		cat,
		comma_sep_break,
		group,
		indent,
		layout,
		line_suffix,
		post_process,
		text,
	test: TestSuite


func call_doc() -> Doc:
	body: Doc = Softline
		.cat(text("one,"))
		.cat(SoftlineSpace)
		.cat(text("two"))
	text("call(")
		.cat(body.indent())
		.cat(Softline)
		.cat(text(")"))
		.group()


func test_group_stays_flat_when_it_fits() -> Bool:
	doc: Doc = text("abc")
		.cat(SoftlineSpace)
		.cat(text("def"))
		.group()
	100.layout(doc) == "abc def\n"


func test_group_breaks_with_indent_when_too_wide() -> Bool:
	8.layout(call_doc()) == "call(\n\tone,\n\ttwo\n)\n"


func test_if_break_adds_trailing_comma_only_when_broken() -> Bool:
	body: Doc = [text("alpha"), text("beta")].comma_sep_break()
	doc: Doc = text("[")
		.cat(
			Softline
				.cat(body)
				.indent(),
		)
		.cat(Softline)
		.cat(text("]"))
		.group()
	100.layout(doc) == "[alpha, beta]\n" and 8.layout(doc) == "[\n\talpha,\n\tbeta,\n]\n"


func test_line_suffix_flushes_before_newline() -> Bool:
	doc: Doc = text("x")
		.cat(line_suffix("-- comment"))
		.cat(Hardline)
		.cat(text("y"))
	100.layout(doc) == "x -- comment\ny\n"


func test_post_process_trims_and_collapses_blank_lines() -> Bool:
	"a  \n\n\n\nb\t\n\n".post_process() == "a\n\n\nb\n"


func test_empty_document_stays_empty() -> Bool:
	100.layout(text("")) == "" and "\n\n".post_process() == ""


func repeated_text_doc(count: Int) -> Doc:
	var doc: Doc = text("")
	var i: Int = 0

	while i < count:
		doc = doc.cat(text("x"))
		i += 1

	doc


func test_deep_grouped_document_renders_without_stack_growth() -> Bool:
	rendered: String = 10000.layout(repeated_text_doc(5000).group())
	rendered.length() == 5001


func flat_group_json() -> String:
	"{\"tag\":\"Group\",\"doc\":{\"tag\":\"Concat\",\"left\":{\"tag\":\"Text\",\"text\":\"abc\"},\"right\":{\"tag\":\"Concat\",\"left\":{\"tag\":\"SoftlineSpace\"},\"right\":{\"tag\":\"Text\",\"text\":\"def\"}}}}"


func test_doc_json_layout() -> Bool:
	match 100.render_document_json(flat_group_json()):
		Ok(rendered):
			rendered == "abc def\n"
		Err(_):
			False


func test_doc_json_error() -> Bool:
	match "{\"tag\":\"Mystery\"}".document_from_json_string():
		Ok(_):
			False
		Err(msg):
			msg == "unknown Doc JSON tag: Mystery"


tests: TestSuite = {
	description = "Blorp formatter layout",
	tests = [
		("group stays flat when it fits", test_group_stays_flat_when_it_fits),
		("group breaks with indent when too wide", test_group_breaks_with_indent_when_too_wide),
		(
			"IfBreak adds trailing comma only when broken",
			test_if_break_adds_trailing_comma_only_when_broken,
		),
		("line suffix flushes before newline", test_line_suffix_flushes_before_newline),
		(
			"post process trims and collapses blank lines",
			test_post_process_trims_and_collapses_blank_lines,
		),
		("empty document stays empty", test_empty_document_stays_empty),
		(
			"deep grouped document renders without stack growth",
			test_deep_grouped_document_renders_without_stack_growth,
		),
		("Doc JSON layouts", test_doc_json_layout),
		("Doc JSON rejects unknown tag", test_doc_json_error),
	]
}
