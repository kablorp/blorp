import:
	../../../src/format/engine/document_json: document_from_json_string, render_document_json
	../../../src/format/engine/document_layout:
		Doc(Hardline, Softline, SoftlineSpace),
		cat,
		comma_fill,
		comma_sep_break,
		group,
		indent,
		layout,
		line_suffix,
		post_process,
		render_flat,
		text,
	test: TestSuite


func call_doc() -> Doc:
	body: Doc = Softline
		.cat(text("one,"))
		.cat(SoftlineSpace)
		.cat(text("two"))
	text("call(")
		.cat(body.indent())
		.cat(Softline)
		.cat(text(")"))
		.group()


func test_group_stays_flat_when_it_fits() -> Bool:
	doc: Doc = text("abc")
		.cat(SoftlineSpace)
		.cat(text("def"))
		.group()
	100.layout(doc) == "abc def\n"


func test_group_breaks_with_indent_when_too_wide() -> Bool:
	8.layout(call_doc()) == "call(\n\tone,\n\ttwo\n)\n"


func test_if_break_adds_trailing_comma_only_when_broken() -> Bool:
	body: Doc = [text("alpha"), text("beta")].comma_sep_break()
	doc: Doc = text("[")
		.cat(
			Softline
				.cat(body)
				.indent(),
		)
		.cat(Softline)
		.cat(text("]"))
		.group()
	100.layout(doc) == "[alpha, beta]\n" and 8.layout(doc) == "[\n\talpha,\n\tbeta,\n]\n"


func test_line_suffix_flushes_before_newline() -> Bool:
	doc: Doc = text("x")
		.cat(line_suffix("-- comment"))
		.cat(Hardline)
		.cat(text("y"))
	100.layout(doc) == "x -- comment\ny\n"


func test_post_process_trims_and_collapses_blank_lines() -> Bool:
	"a  \n\n\n\nb\t\n\n".post_process() == "a\n\n\nb\n"


func test_empty_document_stays_empty() -> Bool:
	100.layout(text("")) == "" and "\n\n".post_process() == ""


func repeated_text_doc(count: Int) -> Doc:
	var doc: Doc = text("")
	var i: Int = 0

	while i < count:
		doc = doc.cat(text("x"))
		i += 1

	doc


func test_deep_grouped_document_renders_without_stack_growth() -> Bool:
	rendered: String = 10000.layout(repeated_text_doc(5000).group())
	rendered.length() == 5001


func chain_doc() -> Doc:
	text("value").cat(
		Hardline
			.cat(text(".trim()"))
			.cat(Hardline)
			.cat(text(".length()"))
			.indent(),
	)


func block_call_doc() -> Doc:
	text("max(")
		.cat(
			Hardline
				.cat(text("alpha,"))
				.cat(Hardline)
				.cat(text("beta,"))
				.indent(),
		)
		.cat(Hardline)
		.cat(text(")"))


func test_render_flat_collapses_chain_hardlines() -> Bool:
	chain_doc().render_flat() == "value.trim().length()"


func test_render_flat_drops_the_broken_trailing_comma() -> Bool:
	block_call_doc().render_flat() == "max(alpha, beta)"


func test_render_flat_separates_tokens_a_hardline_kept_apart() -> Bool:
	doc: Doc = text("alpha")
		.cat(Hardline)
		.cat(text("and beta"))
	doc.render_flat() == "alpha and beta"


func test_render_flat_uses_the_flat_branch_of_if_break() -> Bool:
	body: Doc = [text("alpha"), text("beta")].comma_sep_break()
	doc: Doc = text("[")
		.cat(
			Softline
				.cat(body)
				.indent(),
		)
		.cat(Softline)
		.cat(text("]"))
		.group()
	doc.render_flat() == "[alpha, beta]"


func test_render_flat_drops_line_suffixes() -> Bool:
	doc: Doc = text("x")
		.cat(line_suffix("-- comment"))
		.cat(Hardline)
		.cat(text("y"))
	doc.render_flat() == "x y"


func flat_group_json() -> String:
	"{\"tag\":\"Group\",\"doc\":{\"tag\":\"Concat\",\"left\":{\"tag\":\"Text\",\"text\":\"abc\"},\"right\":{\"tag\":\"Concat\",\"left\":{\"tag\":\"SoftlineSpace\"},\"right\":{\"tag\":\"Text\",\"text\":\"def\"}}}}"


func test_doc_json_layout() -> Bool:
	match 100.render_document_json(flat_group_json()):
		Ok(rendered):
			rendered == "abc def\n"
		Err(_):
			False


func filled_call_doc(items: List[String]) -> Doc:
	text("call(")
		.cat(
			Softline
				.cat(
					items
						.string_texts()
						.comma_fill(),
				)
				.indent(),
		)
		.cat(Softline)
		.cat(text(")"))
		.group()


func string_texts(items: List[String]) -> List[Doc]:
	var documents: List[Doc] = []

	for item in items:
		documents = documents.append(text(item))

	documents


func five_names() -> List[String]:
	["aaaa", "bbbb", "cccc", "dddd", "eeee"]


func test_fill_stays_flat_without_trailing_comma_when_it_fits() -> Bool:
	100.layout(filled_call_doc(five_names())) == "call(aaaa, bbbb, cccc, dddd, eeee)\n"


func test_fill_packs_items_per_line_in_order() -> Bool:
	21.layout(filled_call_doc(five_names())) == "call(\n\taaaa, bbbb, cccc,\n\tdddd, eeee,\n)\n"


func test_fill_counts_the_trailing_comma_when_deciding_fit() -> Bool:
	20.layout(filled_call_doc(five_names())) == "call(\n\taaaa, bbbb,\n\tcccc, dddd,\n\teeee,\n)\n"


func test_fill_puts_an_oversized_item_on_its_own_line() -> Bool:
	items: List[String] = ["ab", "abcdefghijklmnop", "cd", "ef"]
	11.layout(filled_call_doc(items)) == "call(\n\tab,\n\tabcdefghijklmnop,\n\tcd, ef,\n)\n"


func test_fill_of_no_items_renders_nothing() -> Bool:
	100.layout(filled_call_doc([])) == "call()\n"


func test_fill_keeps_a_line_suffix_on_the_line_of_its_item() -> Bool:
	items: List[Doc] = [text("aaaa"), text("bbbb").cat(line_suffix("-- note")), text("cccc")]
	doc: Doc = text("call(")
		.cat(
			Softline
				.cat(items.comma_fill())
				.indent(),
		)
		.cat(Softline)
		.cat(text(")"))
		.group()
	21.layout(doc) == "call(\n\taaaa, bbbb, -- note\n\tcccc,\n)\n"


func test_doc_json_fill() -> Bool:
	json: String = "{\"tag\":\"Fill\",\"items\":[{\"tag\":\"Text\",\"text\":\"a,\"},{\"tag\":\"Text\",\"text\":\"b\"}]}"

	match 100.render_document_json(json):
		Ok(rendered):
			rendered == "a, b\n"
		Err(_):
			False


func test_doc_json_error() -> Bool:
	match "{\"tag\":\"Mystery\"}".document_from_json_string():
		Ok(_):
			False
		Err(msg):
			msg == "unknown Doc JSON tag: Mystery"


tests: TestSuite = {
	description = "Blorp formatter layout",
	tests = [
		("group stays flat when it fits", test_group_stays_flat_when_it_fits),
		("group breaks with indent when too wide", test_group_breaks_with_indent_when_too_wide),
		(
			"IfBreak adds trailing comma only when broken",
			test_if_break_adds_trailing_comma_only_when_broken,
		),
		("line suffix flushes before newline", test_line_suffix_flushes_before_newline),
		(
			"post process trims and collapses blank lines",
			test_post_process_trims_and_collapses_blank_lines,
		),
		("empty document stays empty", test_empty_document_stays_empty),
		(
			"deep grouped document renders without stack growth",
			test_deep_grouped_document_renders_without_stack_growth,
		),
		("render flat collapses chain hardlines", test_render_flat_collapses_chain_hardlines),
		(
			"render flat drops the broken trailing comma",
			test_render_flat_drops_the_broken_trailing_comma,
		),
		(
			"render flat separates tokens a hardline kept apart",
			test_render_flat_separates_tokens_a_hardline_kept_apart,
		),
		(
			"render flat uses the flat branch of IfBreak",
			test_render_flat_uses_the_flat_branch_of_if_break,
		),
		("render flat drops line suffixes", test_render_flat_drops_line_suffixes),
		("Doc JSON layouts", test_doc_json_layout),
		("Doc JSON Fill", test_doc_json_fill),
		(
			"fill stays flat without trailing comma when it fits",
			test_fill_stays_flat_without_trailing_comma_when_it_fits,
		),
		("fill packs items per line in order", test_fill_packs_items_per_line_in_order),
		(
			"fill counts the trailing comma when deciding fit",
			test_fill_counts_the_trailing_comma_when_deciding_fit,
		),
		(
			"fill puts an oversized item on its own line",
			test_fill_puts_an_oversized_item_on_its_own_line,
		),
		("fill of no items renders nothing", test_fill_of_no_items_renders_nothing),
		(
			"fill keeps a line suffix on the line of its item",
			test_fill_keeps_a_line_suffix_on_the_line_of_its_item,
		),
		("Doc JSON rejects unknown tag", test_doc_json_error),
	]
}
