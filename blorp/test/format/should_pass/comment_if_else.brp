-- Comments around `if`, `else if` and `else` stay with the header line they
-- end or the keyword they precede, and loop headers keep their comments too.
func pick(flag: Bool, other: Bool) -> Int:
	if flag: -- the common case
		1
	-- Only reached when `flag` is false.
	else if other: -- the rare case
		2
	-- Neither holds.
	else: -- fallback
		3


func sign(value: Int) -> Int:
	result = if value > 0: -- positive
		1
	else:
		0

	result


func nested(values: List[Int]) -> Int:
	match values.get(0):
		Some(value):
			if value > 0: -- nested header
				value
			-- A non-positive value.
			else:
				0
		None:
			0


func total(values: List[Int]) -> Int:
	var sum: Int = 0

	for value in values: -- every value
		sum += value

	for (index, value) in values.enumerate(): -- with positions
		sum += index * value

	while sum > 100: -- keep it small
		sum -= 100

	sum


func main() -> Int:
	pick(True, False) + sign(1) + nested([1]) + total([1, 2])
