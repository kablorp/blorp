-- Comments between the members of a record, struct, enum or union body stay
-- directly above the member they precede, and the comment ending a member's
-- line stays there. Comments after the last member stay inside the body.
record A {
	-- before the first field
	first: Int,
	-- before a middle field
	middle: Int, -- ends the middle field's line
	-- before the last field
	last: Int
	-- after the last field
}


struct Point {
	-- the horizontal position
	x: Int,
	y: Int -- the vertical position
}


record Empty {
	-- nothing here yet
}


---
Documents the union; the docstring is not a member comment.
---
union U:
	-- before the first variant
	One
	-- before a later variant
	Two(Int) -- ends the variant's line
	Three
	-- after the last variant


enum Color:
	-- warm
	Red
	-- cool
	Blue


record AfterUnion {
	value: Int
}
