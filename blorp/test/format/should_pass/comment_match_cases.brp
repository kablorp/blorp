-- Comments written among match cases stay with the case they precede, the
-- pattern line they end, or the match they close.
func classify(values: List[Int]) -> Int:
	match values.get(0): -- the first value decides
		-- A present value.
		Some(value): -- keep it as is
			-- The body keeps its own comments.
			value -- the value itself
		-- An empty list.
		-- A second note for the empty list.
		None:
			0
		-- No other case can occur.


func nested(values: List[Int], flag: Bool) -> Int:
	result = match values.get(0): -- the first value, if any
		Some(value):
			match flag:
				-- Flagged values double.
				True:
					value * 2
				False:
					value
				-- The inner match closes here.

			-- The outer match continues.
		None:
			0
		-- The outer match closes here.

	result


func in_lambda(values: List[Option[Int]]) -> List[Int]:
	values.map(func(value):
		match value: -- each value
			-- A present value.
			Some(v):
				v
			-- An absent value.
			None:
				0
	)


func main() -> Int:
	classify([1]) + nested([2], True)
