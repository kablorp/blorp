-- Tests fitting calls inside lambda bodies stay flat
-- Inline lambda body: fitting inner calls stay inline
func inline_lambda() -> List[Int]:
	[1, 2, 3].map(func(x: Int): some_long_function_name(x, x + 1, x + 2, x + 3))


-- Block lambda body: fitting inner calls stay inline
func block_lambda() -> List[Int]:
	[1, 2, 3].map(func(x: Int):
		result: Int = some_long_function_name(x, x + 1, x + 2, x + 3)
		result
	)


-- Chained lambda body: fitting inner calls stay inline
func chained_lambda() -> String:
	items.flat_map(func(item: String, rest: String):
		process(item, rest, "extra_argument_one", "extra_argument_two")
	)


func main(args: List[String]) -> Int:
	0
