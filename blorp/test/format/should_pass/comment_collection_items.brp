-- Comments among call arguments and collection items keep their place: each
-- collection with comments lays out one item per line.
func add(left: Int, right: Int, extra: Int) -> Int:
	left + right + extra


func add2(a: Int, b: Int) -> Int:
	a + b


func sub2(a: Int, b: Int) -> Int:
	a - b


func brackets() -> Int:
	x = add2(
		sub2(1, 2), -- after bar
		3,
	)
	y = [
		-- o2
		[1], -- after inner
		[2],
	]
	z = add2(
		-- open
		1,
		2,
	) -- close
	w = add2(
		sub2(
			1, -- one
			2,
		),
	) -- both closers
	x + y.length() + z + w


func main() -> Int:
	values = [
		-- first
		1,
		2, -- second
	]
	box = {
		-- field note
		width = 1.0
	}
	wide = { box |
		-- wider
		width = 2.0,
		height = 3.0 -- taller
	}
	table = {
		-- one
		"a" => 1,
		"b" => 2, -- two
	}
	pair = (
		1, -- left
		2,
		-- nothing after
	)
	total = add(
		-- the first operand
		1,
		values.length(), -- the count
		values
			.map(func(value):
				-- doubled
				value * 2
			)
			.length(),
	)
	total
