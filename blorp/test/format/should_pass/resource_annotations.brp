resource type FileReader = builtin("blorp_file_close_reader")


@resource_result_ordinary
func read_text(reader: FileReader) -> Result[String, String]:
	builtin("blorp_file_read_text_reader_raw")


trait ReaderCount:
	func count(handle: Self) -> Result[Int, String]


implements ReaderCount for FileReader:
	@resource_result_ordinary
	func count(reader: FileReader) -> Result[Int, String]:
		builtin("blorp_file_count_lines_reader_raw")
