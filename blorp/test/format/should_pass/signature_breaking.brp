-- Tests function signature breaking for long parameter lists
-- Short signature stays flat
pure func add(a: Int, b: Int) -> Int:
	a + b


-- Long signature breaks parameters with trailing comma
pure func between(
	open_delim: String,
	parser_fn: String,
	close_delim: String,
	extra_input: String,
	another_param: String,
) -> String:
	"result"


-- Two params that fit on one line
pure func multiply(x: Int, y: Int) -> Int:
	x * y


-- Four compact params stay flat
func sum4(a: I, b: I, c: I, d: I) -> I:
	a


-- Four params break when any rendered param is long
pure func blend_ids(
	user_id: UserId,
	item_id: ItemId,
	page_id: PageId,
	sort_id: SortId,
) -> Int:
	0


func main(args: List[String]) -> Int:
	0
