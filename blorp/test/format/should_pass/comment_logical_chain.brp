-- Comments among the terms of an `and` or `or` chain stay with the term they
-- precede or end, in values and in block headers.
func check(name: String) -> Bool:
	(
		name == "a"
		-- b is special
		or name == "b" -- trailing b
		or name == "c"
	)


func gate(name: String, flag: Bool) -> Int:
	if (
		name == "a" -- first
		-- second is rare
		or name == "b"
		or flag and name == "c"
	): -- header note
		1
	else:
		0


func value(flag: Bool, other: Bool) -> Bool:
	not (
		flag -- either
		or other
	)


func main() -> Int:
	gate("a", True)
