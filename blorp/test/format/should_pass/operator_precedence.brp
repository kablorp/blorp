func math_ops(seed: Int) -> Int:
	(seed * 1103515245 + 12345) / 65536


func scale(t: Float) -> Float:
	(t - 0.33) * 3.0


func distance(cx: Float, dx: Float) -> Float:
	sqrt((dx - cx) * (dx - cx))


func precedence_chain(a: Int, b: Int, c: Int) -> Int:
	(a + b) * (c - a)


func right_assoc_sub(a: Int, b: Int, c: Int) -> Int:
	a - (b - c)


func right_assoc_div(a: Float, b: Float, c: Float) -> Float:
	a / (b / c)


func mod_then_add(a: Int, b: Int, c: Int) -> Int:
	a + b % c


func compare_sum(a: Int, b: Int, c: Int) -> Bool:
	a + b > c


func logic_ops(x: Bool, y: Bool, z: Bool) -> Bool:
	(x or y) and z


func neg_sum(a: Int, b: Int) -> Int:
	-(a + b)


func method_receiver_precedence(a: Int, b: Int) -> String:
	(a + b).to_string()


func main(args: List[String]) -> Int:
	0
