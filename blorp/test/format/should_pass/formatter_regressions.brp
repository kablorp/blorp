-- Regression tests for formatter bugs.
-- Each section tests a specific formatter behavior that was broken.
import:
	option: Option(Some, None)


-- Bug 1: Some() must preserve empty parens in patterns.
-- Formatter was changing Some() to Some (variable binding, different semantics).
func test_constructor_empty_parens() -> Int:
	x: Option[Int] = Some(42)

	match x:
		Some():
			1
		None:
			0


-- Bug 3: Supertraits-only traits must NOT have trailing colon.
-- Formatter was adding colon: `trait Baz: Foo` became `trait Baz: Foo:`
trait Testable:
	pure func test_it(x: Self) -> Bool


trait SubTestable: Testable


trait MultiSuper: Testable + Testable


-- Bug 4: private @tail_recursive order must be preserved.
-- Formatter was reordering to @tail_recursive private which parser rejects.
private @tail_recursive pure func countdown(n: Int) -> Int:
	if n <= 0:
		0
	else:
		countdown(n - 1)


-- Bug 5: foreign block syntax must be preserved.
-- Formatter was flattening `foreign:` block to standalone foreign declarations.
foreign:
	@no_copy func process(data: String) -> Int = "process_data"


---
Private helper docs must survive formatting.
---
private pure func documented_private_helper(x: Int) -> Int:
	x + 1


-- Bug 7: forward declarations must keep their required trailing colon.
func declared_only(x: Int) -> Int:
pure func declared_only(x: Int) -> Int:
	x


-- Bug 8: simple trait default bodies must remain inline.
trait DefaultBodyRegression:
	pure func lt(a: Self, b: Self) -> Bool
	pure func ge(a: Self, b: Self) -> Bool: not lt(a, b)


-- Bug 9: imports after declarations must not be hoisted above them.
type ImportAnchor = builtin


-- Bug 10: comparison grouping must remain stable.
pure func comparison_grouping(a: Float, b: Float, c: Float) -> Bool:
	a > b != (c > b)


pure func matches_expected_intrinsic_name(actual: String, expected: String) -> Bool:
	actual == expected


-- Logical expression continuations in value positions need explicit grouping
-- before they can put `and`/`or` at the start of continuation lines.
pure func logical_value_continuations() -> Bool:
	names_ok: Bool = (
		matches_expected_intrinsic_name("math_sqrt", "math_sqrt")
		and matches_expected_intrinsic_name("dict_meta_get", "dict_meta_get")
	)

	arities_ok: Bool = (
		matches_expected_intrinsic_name("math_nan", "math_nan")
		and matches_expected_intrinsic_name("math_fma", "math_fma")
		and matches_expected_intrinsic_name("tensor_set_f64", "tensor_set_f64")
	)

	names_ok and arities_ok


-- Alias comment must stay with the alias, not move into the import block.
type alias ImportAnchorAlias = ImportAnchor


import:
	option: Option(Some, None)
	result: Result(Ok, Err)


-- Match-arm trailing comments must stay with their own arm.
func match_arm_trailing_comments(result: Result[Int, String]) -> Bool:
	match result:
		Ok(_):
			True -- pass is OK
		Err(_):
			True -- expected fallback


-- Detach only accepts a unary expression, so lower-precedence bodies must keep
-- their parentheses or the formatted source parses as a different expression.
func detach_assignment_grouping() -> Int:
	var total: Int = 0
	detach (total = 1)
	total


func main(args: List[String]) -> Int:
	0
