-- Expressions inside `${...}` stay on one line. A break there would end the
-- string literal mid-expression, so forced layouts such as the leading-dot
-- chain collapse back to their flat form.
func chain(text: String) -> String:
	"len=${text.trim().length().to_string()}"


func lambdas(numbers: List[Int]) -> String:
	"doubled=${numbers.map(pure func(n): n * 2).length().to_string()}"


func nested_calls(numbers: List[Int], text: String) -> String:
	"count=${max(numbers.filter(pure func(n): n > 1).length(), text.length())}"


func collection_receiver() -> String:
	"first=${[1, 2, 3].map(pure func(n): n + 1).length().to_string()}"


func nested_literal(names: List[String]) -> String:
	"names=${names.map(pure func(name): name.trim()).join(", ").upper()}"


func long_interpolation(numbers: List[Int]) -> String:
	"total=${numbers.filter(pure func(n): n > 0).map(pure func(n): n * 3).length().to_string()}"


func pipe_interpolation(label: String, numbers: List[Int]) -> String:
	|<section>
	|  <h1>${label.trim().upper()}</h1>
	|  <p>${numbers.map(pure func(n): n * 2).length().to_string()}</p>
	|</section>


func main(args: List[String]) -> Int:
	numbers: List[Int] = [1, 2, 3]
	print(chain(" hi "))
	print(lambdas(numbers))
	print(nested_calls(numbers, "abc"))
	print(collection_receiver())
	print(nested_literal(["a", "b"]))
	print(long_interpolation(numbers))
	print(pipe_interpolation("title", numbers))
	0
