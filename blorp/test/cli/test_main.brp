func test_run_cli_reports_missing_package_cache() -> Bool:
	root: String = temp_dir() + "/blorp_cli_missing_package_cache"
	app_dir: String = root + "/app"
	cache_dir: String = root + "/cache"
	main_path: String = app_dir + "/main.brp"
	previous_cache: Option[String] = getenv("BLORP_PACKAGE_CACHE")

	cleanup_missing_package_cache_project(root)

	created_ok: Bool = mkdir(root) and mkdir(app_dir) and mkdir(cache_dir)
	config: String =
		|[packages]
		|sample = { hash = "0123456789abcdef", from = ["sample.blorpkg"] }
	source: String =
		|import:
		|	sample: answer
		|
		|func main(args: List[String]) -> Int:
		|	answer()
	_ = setenv("BLORP_PACKAGE_CACHE", cache_dir)
	writes_ok: Bool = (
		write_text_ok(root + "/blorp.toml", config)
		and write_text_ok(main_path, source)
	)

	plan: CliRunPlan = run_cli(["check", "--no-format", main_path])

	match previous_cache:
		Some(path):
			_ = setenv("BLORP_PACKAGE_CACHE", path)
		None:
			_ = setenv("BLORP_PACKAGE_CACHE", "")

	cleanup_missing_package_cache_project(root)

	if not created_ok or not writes_ok:
		False
	else:
		match plan:
			CliRunCheck(check_plan):
				check_plan.graph.diagnostics.any(
					func(
						diagnostic,
					): (
						diagnostic.contains("local package cache")
						and diagnostic.contains("blorp package fetch sample")
					),
				)
			_:
				False


func test_run_cli_discovers_package_alias_source_graph() -> Bool:
	root: String = temp_dir() + "/blorp_cli_package_graph"
	app_dir: String = root + "/app"
	package_dir: String = root + "/vendor/sample"
	package_src: String = package_dir + "/src"
	package_nested: String = package_src + "/sample"
	main_path: String = app_dir + "/main.brp"

	cleanup_package_graph_project(root)

	created_ok: Bool = (
		mkdir(root)
		and mkdir(app_dir)
		and mkdir(root + "/vendor")
		and mkdir(package_dir)
		and mkdir(package_src)
		and mkdir(package_nested)
	)

	root_source: String =
		|import:
		|	sample_v1: answer
		|
		|func main(args: List[String]) -> Int:
		|	answer()
	package_source: String =
		|import:
		|	sample/internal: inner
		|
		|pure func answer() -> Int:
		|	inner()
	internal_source: String = "pure func inner() -> Int: 42\n"
	manifest: String =
		|[package]
		|name = "sample"
		|
		|[compat]
		|std = "preview-1"
		|
		|[exports]
		|modules = ["sample", "sample/internal"]
	config: String =
		|[packages.sample_v1]
		|path = "vendor/sample"

	if not ((
		created_ok
		and write_text_ok(root + "/blorp.toml", config)
		and write_text_ok(package_dir + "/package.toml", manifest)
		and write_text_ok(package_src + "/sample.brp", package_source)
		and write_text_ok(package_nested + "/internal.brp", internal_source)
		and write_text_ok(main_path, root_source)
	)):
		cleanup_package_graph_project(root)
		False
	else:
		plan: CliRunPlan = run_cli(["compile", "--no-format", main_path])
		cleanup_package_graph_project(root)

		match plan:
			CliRunCompile(compile_plan):
				graph = compile_plan.graph
				non_std_modules = non_std_graph_modules(graph)
				non_std_edges = non_std_source_import_edges(graph)
				var saw_alias: Bool = False
				var saw_internal: Bool = False

				for module in non_std_modules:
					if module.module_name == "sample_v1":
						saw_alias = (
							module.path.ends_with("/vendor/sample/src/sample.brp")
							and is_source_package_origin(module, "sample_v1")
						)
					else if module.module_name == "sample/internal":
						saw_internal = (
							module.path.ends_with("/vendor/sample/src/sample/internal.brp")
							and module.source_text == internal_source
							and is_source_package_origin(module, "sample_v1")
						)

				(
					graph.roots.length() == 1
					and non_std_modules.length() == 2
					and non_std_edges.length() == 2
					and graph_has_source_package_context(graph, "sample_v1", "/vendor/sample/src")
					and saw_alias
					and saw_internal
				)
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunLint(_):
				False
			CliRunLsp:
				False
			CliRunPackage(_):
				False
			_:
				False


func cleanup_pkg_root_graph_project(root: String) -> Void:
	_ = remove_file(root + "/app/main.brp")
	_ = remove_file(root + "/pkg/local_math.brp")
	_ = remove_dir(root + "/app")
	_ = remove_dir(root + "/pkg")
	_ = remove_dir(root)


func test_run_cli_discovers_pkg_root_source_graph() -> Bool:
	root: String = temp_dir() + "/blorp_cli_pkg_root_graph"
	app_dir: String = root + "/app"
	pkg_dir: String = root + "/pkg"
	main_path: String = app_dir + "/main.brp"
	pkg_path: String = pkg_dir + "/local_math.brp"

	cleanup_pkg_root_graph_project(root)

	root_source: String =
		|import:
		|	pkg/local_math: double
		|
		|func main(args: List[String]) -> Int:
		|	double(21)
	pkg_source: String = "pure func double(x: Int) -> Int:\n\tx * 2\n"

	if not ((
		mkdir(root)
		and mkdir(app_dir)
		and mkdir(pkg_dir)
		and write_text_ok(pkg_path, pkg_source)
		and write_text_ok(main_path, root_source)
	)):
		cleanup_pkg_root_graph_project(root)
		False
	else:
		plan: CliRunPlan = run_cli(["compile", "--no-format", main_path])
		cleanup_pkg_root_graph_project(root)

		match plan:
			CliRunCompile(compile_plan):
				graph = compile_plan.graph
				non_std_modules = non_std_graph_modules(graph)
				non_std_edges = non_std_source_import_edges(graph)

				match non_std_modules.get(0):
					Some(module):
						(
							graph.roots.length() == 1
							and non_std_modules.length() == 1
							and non_std_edges.length() == 1
							and module.module_name == "pkg/local_math"
							and module.path.ends_with("/pkg/local_math.brp")
							and module.source_text == pkg_source
							and is_pkg_origin(module, "local_math")
							and graph_has_package_root_context(graph, "/pkg")
						)
					None:
						False
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunLint(_):
				False
			CliRunLsp:
				False
			CliRunPackage(_):
				False
			_:
				False


