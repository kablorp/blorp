import:
	../../src/compiler/frontend_request:
		FrontendGraphSource,
		FrontendModuleGraph,
		FrontendModuleOrigin(
			FrontendPkgModule,
			FrontendSourcePackageModule,
			FrontendStdModule,
			FrontendUserModule,
		),
		FrontendSourceImportEdge,
	../../src/lib/source: source_file
	../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../src/compiler/stage_03_parse/source_ast_finalize:
		FinalizedTypecheckProgram,
		finalized_typecheck_program,
		finalized_typecheck_program_ast,
	../../src/main: run_cli
	../../src/lib/source_graph:
		expand_check_targets,
		frontend_module_graph_for_roots,
		parse_cli_source_with_setup,
		source_graph_modules_for_roots,
		source_graph_setup_for_paths,
	../../src/lib/cli_args:
		CliAction(CliCheck),
		CliSanitizerMode(CliSanitizeUndefined),
		CliTestMode(CliTestDocOnly),
	../../src/lib/cli_plan:
		CliCheckTargetExpansion,
		CliPackageRunCommand(
			CliPackageRunCheck,
			CliPackageRunFetchTarget,
			CliPackageRunPack,
			CliPackageRunVendorTarget,
		),
		CliParsedSourceFile,
		CliRunPlan(
			CliRunCheck,
			CliRunCompile,
			CliRunHandled,
			CliRunLsp,
			CliRunLint,
			CliRunPackage,
			CliRunPurify,
			CliRunSource,
			CliRunTest,
		),
		CliSourceFile,
		CliSourceTarget(CliSourceDirectoryTarget, CliSourceFileTarget),
		CliTestRunCommand(CliTestExecute, CliTestWarmup),
	fs: message, resource_path, temporary_directory
	system: getcwd, getenv, mkdir, read_file, remove_dir, remove_file, setenv, temp_dir, write_file
	test: TestSuite


pure func graph_source_decl_count(source: FrontendGraphSource) -> Int:
	finalized_typecheck_program_ast(source.typecheck_program).decls.length()


pure func graph_source_diagnostic_count(source: FrontendGraphSource) -> Int:
	finalized_typecheck_program_ast(source.typecheck_program).diagnostics.length()


pure func typecheck_program_fixture(
	path: String,
	module_name: String,
	source: String,
) -> FinalizedTypecheckProgram:
	finalized_typecheck_program(parse_compiler_source(source_file(path, module_name, source)))


pure func source_graph_test_check_action(root_path: String) -> CliAction:
	CliCheck({
		dump_ast = False,
		dump_typed_ast = False,
		capture_typecheck_request = None,
		debug = False,
		no_format = True,
		std_dir = None,
		paths = [root_path],
	})


pure func source_graph_test_check_action_with_std(root_path: String, std_dir: String) -> CliAction:
	CliCheck({
		dump_ast = False,
		dump_typed_ast = False,
		capture_typecheck_request = None,
		debug = False,
		no_format = True,
		std_dir = Some(std_dir),
		paths = [root_path],
	})


pure func graph_root_at(graph: FrontendModuleGraph, index: Int) -> Option[FrontendGraphSource]:
	graph.roots.get(index)


pure func non_std_graph_modules(graph: FrontendModuleGraph) -> List[FrontendGraphSource]:
	graph.modules.filter(func(source):
		match source.origin:
			FrontendStdModule:
				False
			_:
				True
	)


pure func non_std_source_import_edges(graph: FrontendModuleGraph) -> List[FrontendSourceImportEdge]:
	graph.import_edges.filter(func(edge): not edge.from_module.starts_with("std/"))


pure func graph_has_single_root(graph: FrontendModuleGraph, path: String) -> Bool:
	match graph.roots:
		[root]:
			root.path == path
		_:
			False


pure func is_source_package_origin(source: FrontendGraphSource, package_alias: String) -> Bool:
	match source.origin:
		FrontendSourcePackageModule(actual_package_alias):
			actual_package_alias == package_alias
		_:
			False


pure func is_pkg_origin(source: FrontendGraphSource, package_id: String) -> Bool:
	match source.origin:
		FrontendPkgModule(actual_package_id):
			actual_package_id == package_id
		_:
			False


pure func is_std_origin(source: FrontendGraphSource) -> Bool:
	match source.origin:
		FrontendStdModule:
			True
		_:
			False


pure func graph_has_implicit_prelude(graph: FrontendModuleGraph) -> Bool:
	graph.modules.any(func(source):
		(
			source.module_name == "std/prelude"
			and is_std_origin(source)
			and source.source_text.starts_with("import:\n")
			and source.source_text.contains("\tbool: Bool\n")
			and graph_source_decl_count(source) == 1
		)
	)


pure func graph_has_source_package_context(
	graph: FrontendModuleGraph,
	package_alias: String,
	source_dir_suffix: String,
) -> Bool:
	var found: Bool = False

	for package in graph.context.source_packages:
		if (
			package.package_alias == package_alias
			and package.source_dir.ends_with(source_dir_suffix)
		):
			found = True
			break

	found


pure func graph_has_package_root_context(graph: FrontendModuleGraph, root_suffix: String) -> Bool:
	var found: Bool = False

	for package_root in graph.context.package_roots:
		if package_root.ends_with(root_suffix):
			found = True
			break

	found


func write_text_ok(path: String, text: String) -> Bool:
	match write_file(path, text):
		Ok(_):
			True
		Err(_):
			False


func cleanup_check_expansion_tree(root: String, nested: String) -> Void:
	_ = remove_file(root + "/a.brp")
	_ = remove_file(root + "/b.brp")
	_ = remove_file(root + "/note.txt")
	_ = remove_file(nested + "/c.brp")
	_ = remove_dir(nested)
	_ = remove_dir(root)


pure func unformatted_check_source(function_name: String) -> String:
	"func " + function_name + "() -> Int:\n\tx=1\n\t0\n"


func file_contains(path: String, text: String) -> Bool:
	match read_file(path):
		Ok(content):
			content.contains(text)
		Err(_):
			False


func test_cli_source_models_represent_targets_and_files() -> Bool:
	file_target: CliSourceTarget = CliSourceFileTarget("src/main.brp")
	dir_target: CliSourceTarget = CliSourceDirectoryTarget("src")
	source_file: CliSourceFile = {
		path = "src/main.brp",
		module_name = "main",
		source_text = "func main(args: List[String]) -> Int: 0"
	}
	parsed_file: CliParsedSourceFile = {
		path = source_file.path,
		module_name = source_file.module_name,
		source_text = source_file.source_text,
		typecheck_program = typecheck_program_fixture(
			source_file.path,
			source_file.module_name,
			source_file.source_text,
		)
	}

	file_target_ok: Bool = match file_target:
		CliSourceFileTarget(path):
			path == "src/main.brp"
		CliSourceDirectoryTarget(_):
			False

	dir_target_ok: Bool = match dir_target:
		CliSourceDirectoryTarget(path):
			path == "src"
		CliSourceFileTarget(_):
			False

	(
		file_target_ok
		and dir_target_ok
		and parsed_file.path == "src/main.brp"
		and parsed_file.module_name == "main"
	)


func test_source_graph_discovers_imports_from_retained_program() -> Bool:
	root_path: String = temp_dir() + "/blorp_cli_surface_root.brp"
	dep_path: String = temp_dir() + "/blorp_cli_surface_dep.brp"
	_ = remove_file(root_path)
	_ = remove_file(dep_path)

	root_source: String =
		|import:
		|	./blorp_cli_surface_dep: surface_dep_value
		|
		|pure func root_value() -> Int:
		|	surface_dep_value()
	stale_source: String =
		|import:
		|	./blorp_cli_surface_stale_dep: stale_dep_value
		|
		|pure func root_value() -> Int:
		|	stale_dep_value()
	root: CliParsedSourceFile = {
		path = root_path,
		module_name = "surface_root",
		source_text = root_source,
		typecheck_program = typecheck_program_fixture(root_path, "surface_root", stale_source)
	}
	dep_source: String = "pure func surface_dep_value() -> Int: 11\n"

	if not write_text_ok(dep_path, dep_source):
		False
	else:
		result: Result[List[CliParsedSourceFile], String] = source_graph_modules_for_roots(
			source_graph_test_check_action(root_path),
			[root],
		)
		_ = remove_file(dep_path)

		match result:
			Ok(modules):
				match modules:
					[module]:
						(
							module.path.ends_with("/blorp_cli_surface_dep.brp")
							and module.module_name.ends_with("/blorp_cli_surface_dep")
							and module.source_text == dep_source
						)
					_:
						False
			Err(_):
				False


private func configured_std_origin_case(std_dir: String) -> Bool:
	std_path: String = std_dir + "/bool.brp"
	user_path: String = temp_dir() + "/blorp_cli_user/std/bool.brp"
	std_source: CliParsedSourceFile = {
		path = std_path,
		module_name = "bool",
		source_text = "",
		typecheck_program = typecheck_program_fixture(std_path, "bool", "")
	}
	user_source: CliParsedSourceFile = {
		path = user_path,
		module_name = "bool",
		source_text = "",
		typecheck_program = typecheck_program_fixture(user_path, "bool", "")
	}
	std_action: CliAction = source_graph_test_check_action_with_std(std_path, std_dir)
	user_action: CliAction = source_graph_test_check_action_with_std(user_path, std_dir)

	if not write_text_ok(std_path, ""):
		False
	else:
		configured_std_ok: Bool = match frontend_module_graph_for_roots(std_action, [std_source]):
			Ok(graph):
				match graph_root_at(graph, 0):
					Some(root):
						(
							is_std_origin(root)
							and root.module_name == "std/bool"
							and finalized_typecheck_program_ast(
								root.typecheck_program,
							).source.module_name == "std/bool"
						)
					None:
						False
			Err(_):
				False

		user_std_name_ok: Bool = match frontend_module_graph_for_roots(user_action, [user_source]):
			Ok(graph):
				match graph_root_at(graph, 0):
					Some(root):
						match root.origin:
							FrontendUserModule:
								finalized_typecheck_program_ast(
									root.typecheck_program,
								).source.module_name == "bool"
							_:
								False
					None:
						False
			Err(_):
				False

		configured_std_ok and user_std_name_ok


private func configured_std_origin_resource_case() -> Result[Bool, String]:
	with directory ?= temporary_directory(
		temp_dir(),
		"blorp_cli_configured_std_",
	) on error => message(error):
		Ok(configured_std_origin_case(resource_path(directory)))


func test_frontend_graph_uses_configured_std_origin() -> Bool:
	configured_std_origin_resource_case().get_or(False)


private func parse_cli_source_with_configured_std_case(std_dir: String) -> Bool:
	std_path: String = std_dir + "/constants.brp"
	action: CliAction = source_graph_test_check_action_with_std(std_path, std_dir)
	setup = source_graph_setup_for_paths(action, [std_path])

	if not write_text_ok(std_path, "ANSWER: Int = 42"):
		False
	else:
		match (
			parse_cli_source_with_setup(
				setup,
				{
					path = std_path,
					module_name = "constants",
					source_text = "ANSWER: Int = 42"
				},
			)
		):
			Ok(source):
				(
					source.module_name == "std/constants"
					and finalized_typecheck_program_ast(
						source.typecheck_program,
					).source.module_name == "std/constants"
				)
			Err(_):
				False


private func parse_cli_source_with_configured_std_resource_case() -> Result[Bool, String]:
	with directory ?= temporary_directory(
		temp_dir(),
		"blorp_cli_parse_configured_library_",
	) on error => message(error):
		Ok(parse_cli_source_with_configured_std_case(resource_path(directory)))


func test_parse_cli_source_with_setup_uses_configured_std_identity() -> Bool:
	parse_cli_source_with_configured_std_resource_case().get_or(False)


func test_frontend_graph_uses_embedded_std_without_override() -> Bool:
	root_path: String = temp_dir() + "/blorp_cli_embedded_std_main.brp"
	previous_std: Option[String] = getenv("BLORP_STD")
	root: CliParsedSourceFile = {
		path = root_path,
		module_name = "blorp_cli_embedded_std_main",
		source_text = "",
		typecheck_program = typecheck_program_fixture(root_path, "blorp_cli_embedded_std_main", "")
	}
	_ = setenv("BLORP_STD", "")
	result: Result[FrontendModuleGraph, String] = frontend_module_graph_for_roots(
		source_graph_test_check_action(root_path),
		[root],
	)

	match previous_std:
		Some(path):
			_ = setenv("BLORP_STD", path)
		None:
			_ = setenv("BLORP_STD", "")

	match result:
		Ok(graph):
			(
				graph.context.std_dir.is_none()
				and graph.modules.any(
					func(
						source,
					): (
						source.module_name == "std/prelude"
						and source.path == "<embedded:std/prelude>"
						and source.source_text.length() > 0
					),
				)
				and graph.modules.any(
					func(
						source,
					): (
						source.module_name == "std/tuple"
						and source.path == "<embedded:std/tuple>"
						and source.source_text.length() > 0
					),
				)
			)
		Err(_):
			False


func test_expand_check_targets_discovers_sorted_directory_sources() -> Bool:
	root: String = temp_dir() + "/blorp_cli_check_targets_dir"
	nested: String = root + "/nested"
	cleanup_check_expansion_tree(root, nested)

	created_ok: Bool = mkdir(root) and mkdir(nested)
	writes_ok: Bool = (
		write_text_ok(root + "/b.brp", "func b() -> Int: 2")
		and write_text_ok(root + "/a.brp", "func a() -> Int: 1")
		and write_text_ok(root + "/note.txt", "ignore")
		and write_text_ok(nested + "/c.brp", "func c() -> Int: 3")
	)

	result: Result[CliCheckTargetExpansion, String] = expand_check_targets([root])
	cleanup_check_expansion_tree(root, nested)

	if not created_ok or not writes_ok:
		False
	else:
		match result:
			Ok(expansion):
				target_ok: Bool = match expansion.targets:
					[CliSourceDirectoryTarget(path)]:
						path == root
					_:
						False

				expected: List[String] = [
					root + "/a.brp",
					root + "/b.brp",
					nested + "/c.brp",
				].sort()

				target_ok and expansion.source_paths == expected
			Err(_):
				False


func test_expand_check_targets_preserves_explicit_file_sources() -> Bool:
	path: String = temp_dir() + "/blorp_cli_explicit_check_target.txt"
	_ = remove_file(path)

	if not write_text_ok(path, "not blorp source"):
		False
	else:
		result: Result[CliCheckTargetExpansion, String] = expand_check_targets([path])
		_ = remove_file(path)

		match result:
			Ok(expansion):
				target_ok: Bool = match expansion.targets:
					[CliSourceFileTarget(target_path)]:
						target_path == path
					_:
						False

				target_ok and expansion.source_paths == [path]
			Err(_):
				False


func test_expand_check_targets_handles_mixed_file_and_directory_targets() -> Bool:
	root: String = temp_dir() + "/blorp_cli_check_targets_mixed_dir"
	nested: String = root + "/nested"
	explicit_path: String = temp_dir() + "/blorp_cli_check_targets_explicit.brp"
	cleanup_check_expansion_tree(root, nested)
	_ = remove_file(explicit_path)

	created_ok: Bool = mkdir(root) and mkdir(nested)
	writes_ok: Bool = (
		write_text_ok(root + "/a.brp", "func a() -> Int: 1")
		and write_text_ok(root + "/note.txt", "ignore")
		and write_text_ok(nested + "/c.brp", "func c() -> Int: 3")
		and write_text_ok(explicit_path, "func explicit() -> Int: 4")
	)

	result: Result[CliCheckTargetExpansion, String] = expand_check_targets([root, explicit_path])
	cleanup_check_expansion_tree(root, nested)
	_ = remove_file(explicit_path)

	if not created_ok or not writes_ok:
		False
	else:
		match result:
			Ok(expansion):
				targets_ok: Bool = match expansion.targets:
					[CliSourceDirectoryTarget(dir_path), CliSourceFileTarget(file_path)]:
						dir_path == root and file_path == explicit_path
					_:
						False

				expected: List[String] = [root + "/a.brp", nested + "/c.brp", explicit_path].sort()

				targets_ok and expansion.source_paths == expected
			Err(_):
				False


func test_expand_check_targets_preserves_empty_directory_targets() -> Bool:
	root: String = temp_dir() + "/blorp_cli_empty_check_dir"
	nested: String = root + "/nested"
	cleanup_check_expansion_tree(root, nested)

	created_ok: Bool = mkdir(root)
	result: Result[CliCheckTargetExpansion, String] = expand_check_targets([root])
	cleanup_check_expansion_tree(root, nested)

	if not created_ok:
		False
	else:
		match result:
			Ok(expansion):
				targets_ok: Bool = match expansion.targets:
					[CliSourceDirectoryTarget(path)]:
						path == root
					_:
						False

				empty_sources: List[String] = []
				targets_ok and expansion.source_paths == empty_sources
			Err(_):
				False


func test_expand_check_targets_reports_missing_targets() -> Bool:
	path: String = temp_dir() + "/blorp_cli_missing_check_target.brp"
	_ = remove_file(path)

	match expand_check_targets([path]):
		Ok(_):
			False
		Err(message):
			(
				message.contains("failed to read source file")
				and message.contains("not found")
				and message.contains(path)
			)


func test_run_cli_returns_frontend_graph_for_multi_file_check() -> Bool:
	first_path: String = temp_dir() + "/blorp_cli_check_multi_a.brp"
	second_path: String = temp_dir() + "/blorp_cli_check_multi_b.brp"
	_ = remove_file(first_path)
	_ = remove_file(second_path)

	if not ((
		write_text_ok(first_path, "func a() -> Int: 1")
		and write_text_ok(second_path, "func b() -> Int: 2")
	)):
		False
	else:
		plan: CliRunPlan = run_cli([
			"check",
			"--no-format",
			first_path,
			second_path,
		])
		_ = remove_file(first_path)
		_ = remove_file(second_path)

		match plan:
			CliRunCheck(check_plan):
				graph = check_plan.graph

				first_ok: Bool = match graph.roots.get(0):
					Some(source):
						(
							source.path == first_path
							and source.module_name == "blorp_cli_check_multi_a"
							and graph_source_decl_count(source) == 1
							and graph_source_diagnostic_count(source) == 0
						)
					None:
						False

				second_ok: Bool = match graph.roots.get(1):
					Some(source):
						(
							source.path == second_path
							and source.module_name == "blorp_cli_check_multi_b"
							and graph_source_decl_count(source) == 1
							and graph_source_diagnostic_count(source) == 0
						)
					None:
						False

				(
					check_plan.args == ["check", "--no-format", first_path, second_path]
					and check_plan.options.no_format
					and check_plan.options.paths.length() == 2
					and graph.roots.length() == 2
					and non_std_graph_modules(graph).length() == 0
					and non_std_source_import_edges(graph).length() == 0
					and first_ok
					and second_ok
				)
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunLint(_):
				False
			CliRunLsp:
				False
			CliRunPackage(_):
				False
			_:
				False


func test_run_cli_returns_frontend_graph_for_directory_check() -> Bool:
	root: String = temp_dir() + "/blorp_cli_check_single_file_dir"
	nested: String = root + "/nested"
	cleanup_check_expansion_tree(root, nested)

	created_ok: Bool = mkdir(root)
	wrote_ok: Bool = write_text_ok(root + "/a.brp", "func a() -> Int: 1")
	plan: CliRunPlan = run_cli(["check", "--no-format", root])
	cleanup_check_expansion_tree(root, nested)

	if not created_ok or not wrote_ok:
		False
	else:
		match plan:
			CliRunCheck(check_plan):
				graph = check_plan.graph

				source_ok: Bool = match graph.roots.get(0):
					Some(source):
						(
							source.path == root + "/a.brp"
							and source.module_name == "a"
							and graph_source_decl_count(source) == 1
							and graph_source_diagnostic_count(source) == 0
						)
					None:
						False

				(
					check_plan.args == ["check", "--no-format", root]
					and check_plan.options.paths.length() == 1
					and graph.roots.length() == 1
					and non_std_graph_modules(graph).length() == 0
					and source_ok
				)
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunLint(_):
				False
			CliRunLsp:
				False
			CliRunPackage(_):
				False
			_:
				False


func test_run_cli_frontend_graph_preserves_parse_diagnostics() -> Bool:
	first_path: String = temp_dir() + "/blorp_cli_check_diag_a.brp"
	second_path: String = temp_dir() + "/blorp_cli_check_diag_b.brp"
	_ = remove_file(first_path)
	_ = remove_file(second_path)

	if not ((
		write_text_ok(first_path, "func a() -> Int: 1")
		and write_text_ok(second_path, "func bad(\n")
	)):
		False
	else:
		plan: CliRunPlan = run_cli([
			"check",
			"--no-format",
			first_path,
			second_path,
		])
		_ = remove_file(first_path)
		_ = remove_file(second_path)

		match plan:
			CliRunCheck(check_plan):
				graph = check_plan.graph

				failing_source_ok: Bool = match graph.roots.get(1):
					Some(source):
						(
							source.path == second_path
							and source.module_name == "blorp_cli_check_diag_b"
							and graph_source_diagnostic_count(source) > 0
						)
					None:
						False

				graph.roots.length() == 2 and failing_source_ok
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunLint(_):
				False
			CliRunLsp:
				False
			CliRunPackage(_):
				False
			_:
				False


func test_run_cli_formats_check_source_before_read() -> Bool:
	path: String = temp_dir() + "/blorp_cli_check_format_source.brp"
