pure func graph_source_decl_count(source: FrontendModule) -> Int:
	finalized_typecheck_program_ast(source.program).decls.length()


pure func graph_source_diagnostic_count(source: FrontendModule) -> Int:
	finalized_typecheck_program_ast(source.program).diagnostics.length()


pure func graph_module_path(source: FrontendModule) -> String:
	finalized_typecheck_program_ast(source.program).source.path


pure func graph_module_name(source: FrontendModule) -> String:
	finalized_typecheck_program_ast(source.program).source.module_name


pure func graph_module_text(source: FrontendModule) -> String:
	finalized_typecheck_program_ast(source.program).source.text


pure func graph_edge_resolved_module(edge: FrontendImportEdge) -> Option[String]:
	match edge.resolution:
		FrontendResolvedImport(target):
			Some(resolved_module_canonical_path(target))
		_:
			None


pure func typecheck_program_fixture(
	path: String,
	module_name: String,
	source: String,
) -> FinalizedTypecheckProgram:
	finalized_typecheck_program(parse_compiler_source(source_file(path, module_name, source)))


private pure func generated_root_test_module(
	path: String,
	module_name: String,
	identity: ResolvedModuleIdentity,
) -> FrontendModule:
	program = typecheck_program_fixture(path, module_name, "")
	{
		identity = identity,
		program = program,
		surface = module_surface_for_program(finalized_typecheck_program_ast(program))
	}


private func generated_root_test_result(
	modules: List[FrontendModule],
	generated: CliGeneratedModule,
) -> Result[FrontendCompilationGraph, String]:
	match frontend_graph(
		modules,
		modules.map(func(module): module.identity),
		[],
	):
		Err(_):
			Err("generated-root test fixture graph is invalid")
		Ok(graph):
			frontend_compilation_graph_with_generated_root(
				{
					context = {
						std_dir = None,
						source_packages = [],
						package_roots = []
					},
					graph = graph,
					diagnostics = []
				},
				generated,
			)


private pure func generated_root_source(import_path: Option[String]) -> CliGeneratedModule:
	import_text = import_path
		.map(func(path): "import:\n    " + path + "\n")
		.get_or("")
	{
		source = {
			path = "/generated.brp",
			module_name = "generated",
			source_text = import_text
		},
		imports = []
	}


pure func source_graph_test_check_action(root_path: String) -> CliAction:
	CliCheck({
		dump_ast = False,
		dump_typed_ast = False,
		capture_typecheck_request = None,
		debug = False,
		no_format = True,
		std_dir = None,
		paths = [root_path],
	})


pure func source_graph_test_check_action_with_std(root_path: String, std_dir: String) -> CliAction:
	CliCheck({
		dump_ast = False,
		dump_typed_ast = False,
		capture_typecheck_request = None,
		debug = False,
		no_format = True,
		std_dir = Some(std_dir),
		paths = [root_path],
	})


pure func graph_root_at(graph: FrontendCompilationGraph, index: Int) -> Option[FrontendModule]:
	frontend_graph_root_modules(graph.graph).get(index)


pure func non_std_graph_modules(graph: FrontendCompilationGraph) -> List[FrontendModule]:
	frontend_graph_dependency_modules(graph.graph).filter(func(source):
		match resolved_module_origin(source.identity):
			StdlibModule:
				False
			_:
				True
	)


pure func non_std_source_import_edges(graph: FrontendCompilationGraph) -> List[FrontendImportEdge]:
	std_identities = frontend_graph_modules(graph.graph)
		.filter(func(source): is_std_origin(source))
		.map(func(source): source.identity)

	frontend_graph_import_edges(graph.graph).filter(func(edge):
		not std_identities.any(func(identity):
			resolved_module_identities_equal(identity, edge.importer)
		)
	)


pure func graph_has_single_root(graph: FrontendCompilationGraph, path: String) -> Bool:
	match frontend_graph_root_modules(graph.graph):
		[root]:
			graph_module_path(root) == path
		_:
			False


pure func is_source_package_origin(source: FrontendModule, package_alias: String) -> Bool:
	match resolved_module_origin(source.identity):
		SourcePackageModule(actual_package_alias):
			actual_package_alias == package_alias
		_:
			False


pure func is_pkg_origin(source: FrontendModule, package_id: String) -> Bool:
	match resolved_module_origin(source.identity):
		NativePackageModule(actual_package_id):
			actual_package_id == package_id
		_:
			False


pure func is_std_origin(source: FrontendModule) -> Bool:
	match resolved_module_origin(source.identity):
		StdlibModule:
			True
		_:
			False


pure func graph_has_implicit_prelude(graph: FrontendCompilationGraph) -> Bool:
	frontend_graph_modules(graph.graph).any(func(source):
		(
			graph_module_name(source) == "prelude"
			and is_std_origin(source)
			and graph_module_text(source).starts_with("import:\n")
			and graph_module_text(source).contains("\tbool: Bool\n")
			and graph_source_decl_count(source) == 1
		)
	)


pure func graph_has_source_package_context(
	graph: FrontendCompilationGraph,
	package_alias: String,
	source_dir_suffix: String,
) -> Bool:
	var found: Bool = False

	for package in graph.context.source_packages:
		if (
			package.package_alias == package_alias
			and package.source_dir.ends_with(source_dir_suffix)
		):
			found = True
			break

	found


pure func graph_has_package_root_context(
	graph: FrontendCompilationGraph,
	root_suffix: String,
) -> Bool:
	var found: Bool = False

	for package_root in graph.context.package_roots:
		if package_root.ends_with(root_suffix):
			found = True
			break

	found


func write_text_ok(path: String, text: String) -> Bool:
	match write_file(path, text):
		Ok(_):
			True
		Err(_):
			False


func cleanup_check_expansion_tree(root: String, nested: String) -> Void:
	_ = remove_file(root + "/a.brp")
	_ = remove_file(root + "/b.brp")
	_ = remove_file(root + "/note.txt")
	_ = remove_file(nested + "/c.brp")
	_ = remove_dir(nested)
	_ = remove_dir(root)


pure func unformatted_check_source(function_name: String) -> String:
	"func " + function_name + "() -> Int:\n\tx=1\n\t0\n"


func file_contains(path: String, text: String) -> Bool:
	match read_file(path):
		Ok(content):
			content.contains(text)
		Err(_):
			False


func test_cli_source_models_represent_targets_and_files() -> Bool:
	file_target: CliSourceTarget = CliSourceFileTarget("src/main.brp")
	dir_target: CliSourceTarget = CliSourceDirectoryTarget("src")
	source_file: CliSourceFile = {
		path = "src/main.brp",
		module_name = "main",
		source_text = "func main(args: List[String]) -> Int: 0"
	}
	parsed_file: CliParsedSourceFile = {
		path = source_file.path,
		module_name = source_file.module_name,
		source_text = source_file.source_text,
		typecheck_program = typecheck_program_fixture(
			source_file.path,
			source_file.module_name,
			source_file.source_text,
		)
	}

	file_target_ok: Bool = match file_target:
		CliSourceFileTarget(path):
			path == "src/main.brp"
		CliSourceDirectoryTarget(_):
			False

	dir_target_ok: Bool = match dir_target:
		CliSourceDirectoryTarget(path):
			path == "src"
		CliSourceFileTarget(_):
			False

	(
		file_target_ok
		and dir_target_ok
		and parsed_file.path == "src/main.brp"
		and parsed_file.module_name == "main"
	)


private func configured_std_origin_case(std_dir: String) -> Bool:
	std_path: String = std_dir + "/bool.brp"
	user_path: String = temp_dir() + "/blorp_cli_user/bool.brp"
	std_source: CliParsedSourceFile = {
		path = std_path,
		module_name = "bool",
		source_text = "",
		typecheck_program = typecheck_program_fixture(std_path, "bool", "")
	}
	user_source: CliParsedSourceFile = {
		path = user_path,
		module_name = "bool",
		source_text = "",
		typecheck_program = typecheck_program_fixture(user_path, "bool", "")
	}
	std_action: CliAction = source_graph_test_check_action_with_std(std_path, std_dir)
	user_action: CliAction = source_graph_test_check_action_with_std(user_path, std_dir)

	if not write_text_ok(std_path, ""):
		False
	else:
		configured_std_ok: Bool = match frontend_compilation_graph_for_roots(
			std_action,
			[std_source],
		):
			Ok(graph):
				match graph_root_at(graph, 0):
					Some(root):
						is_std_origin(root) and graph_module_name(root) == "bool"
					None:
						False
			Err(_):
				False

		reserved_user_path_rejected: Bool = match frontend_compilation_graph_for_roots(
			user_action,
			[user_source],
		):
			Ok(_):
				False
			Err(message):
				message.contains(
					"standard-library module path `bool` is reserved; rename the non-standard module",
				)

		configured_std_ok and reserved_user_path_rejected


private func configured_std_origin_resource_case() -> Result[Bool, String]:
	with directory ?= temporary_directory(
		temp_dir(),
		"blorp_cli_configured_std_",
	) on error => message(error):
		Ok(configured_std_origin_case(resource_path(directory)))


func test_frontend_graph_uses_configured_std_origin() -> Bool:
	configured_std_origin_resource_case().get_or(False)


private func parse_cli_source_with_configured_std_case(std_dir: String) -> Bool:
	std_path: String = std_dir + "/constants.brp"
	action: CliAction = source_graph_test_check_action_with_std(std_path, std_dir)
	setup = source_graph_setup_for_paths(action, [std_path])

	if not write_text_ok(std_path, "ANSWER: Int = 42"):
		False
	else:
		source = parse_cli_source_with_setup(
			setup,
			{
				path = std_path,
				module_name = "constants",
				source_text = "ANSWER: Int = 42"
			},
		)

		(
			source.module_name == "constants"
			and finalized_typecheck_program_ast(
				source.typecheck_program,
			).source.module_name == "constants"
		)


private func parse_cli_source_with_configured_std_resource_case() -> Result[Bool, String]:
	with directory ?= temporary_directory(
		temp_dir(),
		"blorp_cli_parse_configured_library_",
	) on error => message(error):
		Ok(parse_cli_source_with_configured_std_case(resource_path(directory)))


func test_parse_cli_source_with_setup_uses_configured_std_identity() -> Bool:
	parse_cli_source_with_configured_std_resource_case().get_or(False)


func test_frontend_graph_uses_embedded_std_without_override() -> Bool:
	root_path: String = temp_dir() + "/blorp_cli_embedded_std_main.brp"
	previous_std: Option[String] = getenv("BLORP_STD")
	root: CliParsedSourceFile = {
		path = root_path,
		module_name = "blorp_cli_embedded_std_main",
		source_text = "",
		typecheck_program = typecheck_program_fixture(root_path, "blorp_cli_embedded_std_main", "")
	}
	_ = setenv("BLORP_STD", "")
	result: Result[FrontendCompilationGraph, String] = frontend_compilation_graph_for_roots(
		source_graph_test_check_action(root_path),
		[root],
	)

	match previous_std:
		Some(path):
			_ = setenv("BLORP_STD", path)
		None:
			_ = setenv("BLORP_STD", "")

	match result:
		Ok(graph):
			(
				graph.context.std_dir.is_none()
				and frontend_graph_dependency_modules(
					graph.graph,
				).any(
					func(
						source,
					): (
						graph_module_name(source) == "prelude"
						and graph_module_path(source) == "<embedded:prelude>"
						and graph_module_text(source).length() > 0
					),
				)
				and frontend_graph_dependency_modules(
					graph.graph,
				).any(
					func(
						source,
					): (
						graph_module_name(source) == "tuple"
						and graph_module_path(source) == "<embedded:tuple>"
						and graph_module_text(source).length() > 0
					),
				)
			)
		Err(_):
			False


func test_generated_root_rejections_preserve_exact_diagnostics() -> Bool:
	user_dep = generated_root_test_module(
		"/user-dep.brp",
		"dep",
		resolved_module_identity_from_resolver("user/dep", UserModule),
	)
	std_dep = generated_root_test_module(
		"/std-dep.brp",
		"dep",
		resolved_module_identity_from_resolver("std/dep", StdlibModule),
	)
	generated_import = generated_root_source(Some("dep"))
	collision: CliGeneratedModule = {
		source = {
			path = "/user-dep.brp",
			module_name = "generated",
			source_text = ""
		},
		imports = []
	}
	duplicate_binding: CliGeneratedModuleImport = {
		module_path = "dep",
		source_path = "/user-dep.brp",
		source_module = "dep"
	}
	duplicate_generated: CliGeneratedModule = {
		source = generated_import.source,
		imports = [duplicate_binding, duplicate_binding]
	}
	ambiguous_generated: CliGeneratedModule = {
		source = generated_import.source,
		imports = [duplicate_binding, { duplicate_binding | source_path = "/other-dep.brp" }]
	}
	explicit_absent_generated: CliGeneratedModule = {
		source = generated_import.source,
		imports = [
			{ duplicate_binding |
				source_path = "/absent.brp",
				source_module = "absent"
			},
		]
	}

	cases = [
		(generated_root_test_result([user_dep], collision), (
				"generated module identity collides with existing graph source `dep` at `/user-"
				+ "dep.brp`"
			)),
		(
			generated_root_test_result([user_dep], duplicate_generated),
			"generated module has duplicate binding for import `dep`",
		),
		(
			generated_root_test_result([user_dep], ambiguous_generated),
			"generated imports target distinct sources with the same module identity `dep`",
		),
		(generated_root_test_result([user_dep], explicit_absent_generated), (
				"generated import `dep` targets an absent graph identity `absent` at `/absent."
				+ "brp`"
			)),
		(
			generated_root_test_result([], generated_import),
			"generated import `dep` is absent from the retained graph",
		),
		(
			generated_root_test_result(
				[user_dep, std_dep],
				generated_import,
			),
			"generated import `dep` has an ambiguous retained graph identity",
		),
	]

	var passed = True

	for (result, expected) in cases:
		case_passed = match result:
			Err(message):
				if message != expected:
					print_error("expected `" + expected + "`, got `" + message + "`")

				message == expected
			Ok(_):
				print_error("expected generated-root rejection `" + expected + "`")
				False

		passed = passed and case_passed

	passed


func test_expand_check_targets_discovers_sorted_directory_sources() -> Bool:
	root: String = temp_dir() + "/blorp_cli_check_targets_dir"
	nested: String = root + "/nested"
	cleanup_check_expansion_tree(root, nested)

	created_ok: Bool = mkdir(root) and mkdir(nested)
	writes_ok: Bool = (
		write_text_ok(root + "/b.brp", "func b() -> Int: 2")
		and write_text_ok(root + "/a.brp", "func a() -> Int: 1")
		and write_text_ok(root + "/note.txt", "ignore")
		and write_text_ok(nested + "/c.brp", "func c() -> Int: 3")
	)

	result: Result[CliCheckTargetExpansion, String] = expand_check_targets([root])
	cleanup_check_expansion_tree(root, nested)

	if not created_ok or not writes_ok:
		False
	else:
		match result:
			Ok(expansion):
				target_ok: Bool = match expansion.targets:
					[CliSourceDirectoryTarget(path)]:
						path == root
					_:
						False

				expected: List[String] = [
					root + "/a.brp",
					root + "/b.brp",
					nested + "/c.brp",
				].sort()

				target_ok and expansion.source_paths == expected
			Err(_):
				False


func test_expand_check_targets_preserves_explicit_file_sources() -> Bool:
	path: String = temp_dir() + "/blorp_cli_explicit_check_target.txt"
	_ = remove_file(path)

	if not write_text_ok(path, "not blorp source"):
		False
	else:
		result: Result[CliCheckTargetExpansion, String] = expand_check_targets([path])
		_ = remove_file(path)

		match result:
			Ok(expansion):
				target_ok: Bool = match expansion.targets:
					[CliSourceFileTarget(target_path)]:
						target_path == path
					_:
						False

				target_ok and expansion.source_paths == [path]
			Err(_):
				False


func test_expand_check_targets_handles_mixed_file_and_directory_targets() -> Bool:
	root: String = temp_dir() + "/blorp_cli_check_targets_mixed_dir"
	nested: String = root + "/nested"
	explicit_path: String = temp_dir() + "/blorp_cli_check_targets_explicit.brp"
	cleanup_check_expansion_tree(root, nested)
	_ = remove_file(explicit_path)

	created_ok: Bool = mkdir(root) and mkdir(nested)
	writes_ok: Bool = (
		write_text_ok(root + "/a.brp", "func a() -> Int: 1")
		and write_text_ok(root + "/note.txt", "ignore")
		and write_text_ok(nested + "/c.brp", "func c() -> Int: 3")
		and write_text_ok(explicit_path, "func explicit() -> Int: 4")
	)

	result: Result[CliCheckTargetExpansion, String] = expand_check_targets([root, explicit_path])
	cleanup_check_expansion_tree(root, nested)
	_ = remove_file(explicit_path)

	if not created_ok or not writes_ok:
		False
	else:
		match result:
			Ok(expansion):
				targets_ok: Bool = match expansion.targets:
					[CliSourceDirectoryTarget(dir_path), CliSourceFileTarget(file_path)]:
						dir_path == root and file_path == explicit_path
					_:
						False

				expected: List[String] = [root + "/a.brp", nested + "/c.brp", explicit_path].sort()

				targets_ok and expansion.source_paths == expected
			Err(_):
				False


func test_expand_check_targets_preserves_empty_directory_targets() -> Bool:
	root: String = temp_dir() + "/blorp_cli_empty_check_dir"
	nested: String = root + "/nested"
	cleanup_check_expansion_tree(root, nested)

	created_ok: Bool = mkdir(root)
	result: Result[CliCheckTargetExpansion, String] = expand_check_targets([root])
	cleanup_check_expansion_tree(root, nested)

	if not created_ok:
		False
	else:
		match result:
			Ok(expansion):
				targets_ok: Bool = match expansion.targets:
					[CliSourceDirectoryTarget(path)]:
						path == root
					_:
						False

				empty_sources: List[String] = []
				targets_ok and expansion.source_paths == empty_sources
			Err(_):
				False


func test_expand_check_targets_reports_missing_targets() -> Bool:
	path: String = temp_dir() + "/blorp_cli_missing_check_target.brp"
	_ = remove_file(path)

	match expand_check_targets([path]):
		Ok(_):
			False
		Err(message):
			(
				message.contains("failed to read source file")
				and message.contains("not found")
				and message.contains(path)
			)


func test_run_cli_returns_frontend_graph_for_multi_file_check() -> Bool:
	first_path: String = temp_dir() + "/blorp_cli_check_multi_a.brp"
	second_path: String = temp_dir() + "/blorp_cli_check_multi_b.brp"
	_ = remove_file(first_path)
	_ = remove_file(second_path)

	if not ((
		write_text_ok(first_path, "func a() -> Int: 1")
		and write_text_ok(second_path, "func b() -> Int: 2")
	)):
		False
	else:
		plan: CliRunPlan = run_cli([
			"check",
			"--no-format",
			first_path,
			second_path,
		])
		_ = remove_file(first_path)
		_ = remove_file(second_path)

		match plan:
			CliRunCheck(check_plan):
				graph = check_plan.graph

				roots = frontend_graph_root_modules(graph.graph)

				first_ok: Bool = match roots.get(0):
					Some(source):
						(
							graph_module_path(source) == first_path
							and graph_module_name(source) == "blorp_cli_check_multi_a"
							and graph_source_decl_count(source) == 1
							and graph_source_diagnostic_count(source) == 0
						)
					None:
						False

				second_ok: Bool = match roots.get(1):
					Some(source):
						(
							graph_module_path(source) == second_path
							and graph_module_name(source) == "blorp_cli_check_multi_b"
							and graph_source_decl_count(source) == 1
							and graph_source_diagnostic_count(source) == 0
						)
					None:
						False

				(
					check_plan.args == ["check", "--no-format", first_path, second_path]
					and check_plan.options.no_format
					and check_plan.options.paths.length() == 2
					and roots.length() == 2
					and non_std_graph_modules(graph).length() == 0
					and non_std_source_import_edges(graph).length() == 0
					and first_ok
					and second_ok
				)
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunLint(_):
				False
			CliRunLsp:
				False
			CliRunPackage(_):
				False
			_:
				False


func test_run_cli_returns_frontend_graph_for_directory_check() -> Bool:
	root: String = temp_dir() + "/blorp_cli_check_single_file_dir"
