			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunLint(_):
				False
			CliRunLsp:
				False
			CliRunPackage(_):
				False
			_:
				False


func test_run_cli_formats_compile_source_before_parse() -> Bool:
	path: String = temp_dir() + "/blorp_cli_run_compile_format_frontier.brp"
	source: String = "func main(args: List[String]) -> Int:\n\tx=1\n\t0\n"

	match write_file(path, source):
		Ok(_):
			plan: CliRunPlan = run_cli(["compile", path])

			file_ok: Bool = match read_file(path):
				Ok(formatted):
					formatted.contains("x = 1") and not formatted.contains("x=1")
				Err(_):
					False

			_ = remove_file(path)

			plan_ok: Bool = match plan:
				CliRunCompile(compile_plan):
					graph_has_single_root(compile_plan.graph, path)
				CliRunHandled(_):
					False
				CliRunTest(_):
					False
				CliRunPurify(_):
					False
				CliRunLint(_):
					False
				CliRunLsp:
					False
				CliRunPackage(_):
					False
				_:
					False

			file_ok and plan_ok
		Err(_):
			False


func test_run_cli_builds_run_source_plan() -> Bool:
	path: String = temp_dir() + "/blorp_cli_run_frontier.brp"
	source: String = "func main(args: List[String]) -> Int: 0"

	match write_file(path, source):
		Ok(_):
			plan: CliRunPlan = run_cli([
				"run",
				"--no-format",
				"--timeout",
				"5",
				path,
			])
			_ = remove_file(path)

			match plan:
				CliRunSource(run_plan):
					graph = run_plan.graph

					match graph.roots.get(0):
						Some(source):
							(
								source.path == path
								and source.module_name == "blorp_cli_run_frontier"
								and graph_source_decl_count(source) == 1
								and graph_source_diagnostic_count(source) == 0
								and run_plan.options.timeout == Some(5)
							)
						None:
							False
				CliRunHandled(_):
					False
				CliRunTest(_):
					False
				CliRunPurify(_):
					False
				CliRunLint(_):
					False
				CliRunLsp:
					False
				CliRunPackage(_):
					False
				_:
					False
		Err(_):
			False


