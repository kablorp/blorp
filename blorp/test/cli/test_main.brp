	_ = remove_file(second_path)

	if not ((
		write_text_ok(first_path, "func a() -> Int: 1")
		and write_text_ok(second_path, "func bad(\n")
	)):
		False
	else:
		plan: CliRunPlan = run_cli([
			"check",
			"--no-format",
			first_path,
			second_path,
		])
		_ = remove_file(first_path)
		_ = remove_file(second_path)

		match plan:
			CliRunCheck(check_plan):
				graph = check_plan.graph

				roots = frontend_graph_root_modules(graph.graph)

				failing_source_ok: Bool = match roots.get(1):
					Some(source):
						(
							graph_module_path(source) == second_path
							and graph_module_name(source) == "blorp_cli_check_diag_b"
							and graph_source_diagnostic_count(source) > 0
						)
					None:
						False

				roots.length() == 2 and failing_source_ok
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunLint(_):
				False
			CliRunLsp:
				False
			CliRunPackage(_):
				False
			_:
				False


