func test_run_cli_plans_test_command() -> Bool:
	test_ok: Bool = match run_cli([
		"test",
		"--profile",
		"--debug",
		"--leak-check",
		"--doc",
		"--repeat",
		"3",
		"--sanitize=undefined",
		"--timeout",
		"5",
		"--std-dir",
		"custom-std",
		"tests",
	]):
		CliRunCheck(_):
			False
		CliRunCompile(_):
			False
		CliRunSource(_):
			False
		CliRunTest(test_plan):
			match test_plan.command:
				CliTestExecute(options):
					(
						test_plan.args == [
							"test",
							"--profile",
							"--debug",
							"--leak-check",
							"--doc",
							"--repeat",
							"3",
							"--sanitize=undefined",
							"--timeout",
							"5",
							"--std-dir",
							"custom-std",
							"tests",
						]
						and options.profile
						and options.debug
						and options.leak_check
						and options.mode == CliTestDocOnly
						and options.sanitizer == Some(CliSanitizeUndefined)
						and options.std_dir == Some("custom-std")
						and options.repeat == 3
						and options.timeout == Some(5)
						and options.paths == ["tests"]
					)
				CliTestWarmup:
					False
		CliRunHandled(_):
			False
		CliRunPurify(_):
			False
		CliRunLint(_):
			False
		CliRunLsp:
			False
		CliRunPackage(_):
			False
		_:
			False

	warmup_ok: Bool = match run_cli(["test", "--warmup-only"]):
		CliRunCheck(_):
			False
		CliRunCompile(_):
			False
		CliRunSource(_):
			False
		CliRunTest(test_plan):
			match test_plan.command:
				CliTestExecute(_):
					False
				CliTestWarmup:
					test_plan.args == ["test", "--warmup-only"]
		CliRunHandled(_):
			False
		CliRunPurify(_):
			False
		CliRunLint(_):
			False
		CliRunLsp:
			False
		CliRunPackage(_):
			False
		_:
			False

	test_ok and warmup_ok


func test_run_cli_plans_purify_command() -> Bool:
	path: String = "blorp/test/purify/should_purify/simple_pure.brp"

	non_source_rejected: Bool = match run_cli(["purify", "README.md"]):
		CliRunHandled(result):
			result.status == 1 and result.stderr.contains("no .brp files found")
		_:
			False

	plan_ok: Bool = match run_cli([
		"purify",
		"--dry-run",
		"--verbose",
		path,
	]):
		CliRunCheck(_):
			False
		CliRunCompile(_):
			False
		CliRunSource(_):
			False
		CliRunPurify(purify_plan):
			(
				purify_plan.args == ["purify", "--dry-run", "--verbose", path]
				and purify_plan.options.dry_run
				and purify_plan.options.verbose
				and purify_plan.options.paths == [path]
				and purify_plan.graph.diagnostics.length() == 0
				and frontend_graph_root_modules(purify_plan.graph.graph).length() == 1
				and frontend_graph_root_modules(purify_plan.graph.graph)
					.get(0)
					.map(func(root): graph_module_path(root) == path)
					.get_or(False)
			)
		CliRunHandled(_):
			False
		CliRunTest(_):
			False
		CliRunLsp:
			False
		CliRunPackage(_):
			False
		_:
			False

	non_source_rejected and plan_ok


