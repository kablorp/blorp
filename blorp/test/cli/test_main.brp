func test_run_cli_builds_compile_source_plan() -> Bool:
	path: String = temp_dir() + "/blorp_cli_run_compile_frontier.brp"
	source: String = "func main(args: List[String]) -> Int: 0"

	match write_file(path, source):
		Ok(_):
			plan: CliRunPlan = run_cli(["compile", "--no-format", path])
			_ = remove_file(path)

			match plan:
				CliRunCompile(compile_plan):
					graph = compile_plan.graph

					match graph.roots.get(0):
						Some(source):
							(
								source.path == path
								and source.module_name == "blorp_cli_run_compile_frontier"
								and graph_source_decl_count(source) == 1
								and graph_source_diagnostic_count(source) == 0
								and non_std_graph_modules(graph).length() == 0
								and graph_has_implicit_prelude(graph)
							)
						None:
							False
				CliRunHandled(_):
					False
				CliRunTest(_):
					False
				CliRunPurify(_):
					False
				CliRunLint(_):
					False
				CliRunLsp:
					False
				CliRunPackage(_):
					False
				_:
					False
		Err(_):
			False


func test_run_cli_discovers_compile_import_source_graph() -> Bool:
	root_path: String = temp_dir() + "/blorp_cli_compile_graph_root.brp"
	dep_path: String = temp_dir() + "/blorp_cli_compile_graph_dep.brp"
	_ = remove_file(root_path)
	_ = remove_file(dep_path)

	root_source: String =
		|import:
		|	./blorp_cli_compile_graph_dep: dep_value
		|
		|func main(args: List[String]) -> Int:
		|	dep_value()
	dep_source: String = "pure func dep_value() -> Int: 7\n"

	if not (write_text_ok(dep_path, dep_source) and write_text_ok(root_path, root_source)):
		False
	else:
		plan: CliRunPlan = run_cli(["compile", "--no-format", root_path])
		_ = remove_file(root_path)
		_ = remove_file(dep_path)

		match plan:
			CliRunCompile(compile_plan):
				graph = compile_plan.graph

				non_std_modules = non_std_graph_modules(graph)
				non_std_edges = non_std_source_import_edges(graph)

				match (graph.roots.get(0), non_std_modules.get(0)):
					(Some(root), Some(module)):
						(
							graph.roots.length() == 1
							and non_std_modules.length() == 1
							and non_std_edges.length() == 1
							and module.path.ends_with("/blorp_cli_compile_graph_dep.brp")
							and module.module_name.ends_with("/blorp_cli_compile_graph_dep")
							and module.source_text == dep_source
							and graph_source_decl_count(module) == 1
						)
					_:
						False
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunLint(_):
				False
			CliRunLsp:
				False
			CliRunPackage(_):
				False
			_:
				False


func cleanup_import_spelling_graph_project(root: String, nested: String) -> Void:
	_ = remove_file(root + "/a.brp")
	_ = remove_file(root + "/c.brp")
	_ = remove_file(root + "/shared.brp")
	_ = remove_file(nested + "/b.brp")
	_ = remove_dir(nested)
	_ = remove_dir(root)


func test_run_cli_preserves_import_spellings_for_same_path() -> Bool:
	root: String = temp_dir() + "/blorp_cli_import_spelling_graph"
	nested: String = root + "/nested"
	first_path: String = root + "/a.brp"
	second_path: String = nested + "/b.brp"
	third_path: String = root + "/c.brp"

	cleanup_import_spelling_graph_project(root, nested)

	first_source: String =
		|import:
		|	./shared: shared_value
		|
		|func a() -> Int:
		|	shared_value()
	second_source: String =
		|import:
		|	../shared: shared_value
		|
		|func b() -> Int:
		|	shared_value()
	third_source: String =
		|import:
		|	shared: shared_value
		|
		|func c() -> Int:
		|	shared_value()
	shared_source: String = "pure func shared_value() -> Int: 9\n"

	if not ((
		mkdir(root)
		and mkdir(nested)
		and write_text_ok(first_path, first_source)
		and write_text_ok(second_path, second_source)
		and write_text_ok(third_path, third_source)
		and write_text_ok(root + "/shared.brp", shared_source)
	)):
		cleanup_import_spelling_graph_project(root, nested)
		False
	else:
		plan: CliRunPlan = run_cli([
			"check",
			"--no-format",
			first_path,
			second_path,
			third_path,
		])
		cleanup_import_spelling_graph_project(root, nested)

		match plan:
			CliRunCheck(check_plan):
				graph = check_plan.graph
				non_std_modules = non_std_graph_modules(graph)
				non_std_edges = non_std_source_import_edges(graph)
				var saw_dot_import: Bool = False
				var saw_dotdot_import: Bool = False
				var saw_bare_import: Bool = False
				var dot_resolved: Option[String] = None
				var dotdot_resolved: Option[String] = None
				var bare_resolved: Option[String] = None
				var saw_shared_module: Bool = False

				for edge in graph.import_edges:
					if edge.import_path == "./shared":
						saw_dot_import = True
						dot_resolved = edge.resolved_module
					else if edge.import_path == "../shared":
						saw_dotdot_import = True
						dotdot_resolved = edge.resolved_module
					else if edge.import_path == "shared":
						saw_bare_import = True
						bare_resolved = edge.resolved_module

				for module in non_std_modules:
					if (
						module.path.ends_with("/shared.brp")
						and module.module_name.ends_with("/blorp_cli_import_spelling_graph/shared")
					):
						saw_shared_module = True

				same_resolved_module: Bool = match (dot_resolved, dotdot_resolved, bare_resolved):
					(Some(dot), Some(dotdot), Some(bare)):
						(
							dot == dotdot
							and dot == bare
							and dot.ends_with("/blorp_cli_import_spelling_graph/shared")
						)
					_:
						False

				(
					graph.roots.length() == 3
					and non_std_modules.length() == 1
					and non_std_edges.length() == 3
					and saw_dot_import
					and saw_dotdot_import
					and saw_bare_import
					and saw_shared_module
					and same_resolved_module
				)
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunLint(_):
				False
			CliRunLsp:
				False
			CliRunPackage(_):
				False
			_:
				False


