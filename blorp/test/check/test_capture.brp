import:
	../../src/check/capture: capture_check_typecheck_request
	../../src/compiler/bridge_protocol:
		BridgeAction(TypecheckGraphAction),
		decode_bridge_envelope_value,
	../../src/compiler/frontend_request: FrontendCompilationGraph
	../../src/compiler/stage_03_parse/parser_bridge as ParserBridge
	../../src/compiler/stage_03_parse/source_ast_finalize: finalized_typecheck_program_ast
	../../src/compiler/stage_04_modules/frontend_graph: FrontendModule
	../../src/compiler/stage_04_modules/frontend_graph_service:
		frontend_graph_for_sources,
		frontend_graph_service_error_message,
	../../src/compiler/stage_04_modules/loaded_module:
		ModuleOrigin(UserModule),
		resolved_module_identity_from_resolver,
	../../src/compiler/stage_04_modules/module_surface: module_surface_for_program
	../../src/lib/cli_args: CliCheckArgs
	../../src/lib/cli_plan: CliCheckPlan
	json: JsonValue, as_array, as_string, get_field, parse_json
	system: read_file, remove_file, temp_dir
	test: TestSuite


private pure func capture_source(path: String, module_name: String, text: String) -> FrontendModule:
	program = ParserBridge.parsed_typecheck_source_bridge_artifact(
		path,
		module_name,
		text,
		False,
	).program
	{
		identity = resolved_module_identity_from_resolver(module_name, UserModule),
		program = program,
		surface = module_surface_for_program(finalized_typecheck_program_ast(program))
	}


private pure func capture_plan(roots: List[FrontendModule]) -> Result[CliCheckPlan, String]:
	graph ?= frontend_graph_for_sources(
		roots,
		roots.map(func(root): root.identity),
		[],
	).map_err(func(errors): errors
			.map(frontend_graph_service_error_message)
			.join("\n"))
	root_paths = roots.map(func(root): finalized_typecheck_program_ast(root.program).source.path)
	Ok({
		args = [],
		options = {
			dump_ast = False,
			dump_typed_ast = False,
			capture_typecheck_request = None,
			debug = False,
			no_format = True,
			std_dir = None,
			paths = root_paths
		},
		graph = {
			context = {
				std_dir = None,
				source_packages = [],
				package_roots = []
			},
			graph = graph,
			diagnostics = []
		},
	})


private pure func json_string_field(value: JsonValue, name: String) -> Option[String]:
	match get_field(value, name):
		Some(field):
			as_string(field)
		None:
			None


private func capture_request_was_not_written(path: String) -> Bool:
	match read_file(path):
		Err(_):
			True
		Ok(_):
			False


private pure func capture_has_expected_request(content: String, path: String) -> Bool:
	match parse_json(content):
		Ok(root):
			match decode_bridge_envelope_value(root):
				Ok(envelope):
					match (
						envelope.action,
						get_field(envelope.payload, "target"),
						get_field(envelope.payload, "modules"),
					):
						(TypecheckGraphAction, Some(target), Some(modules)):
							(
								json_string_field(target, "path") == Some(path)
								and json_string_field(
									target,
									"text",
								) == Some("func main(args: List[String]) -> Int:\n\tmissing\n")
								and as_array(modules)
									.get_or([])
									.length() == 0
							)
						_:
							False
				Err(_):
					False
		Err(_):
			False


func test_capture_writes_replayable_request_without_typechecking() -> Bool:
	path = temp_dir() + "/blorp_typecheck_capture_request.json"
	_ = remove_file(path)
	root = capture_source(
		"/project/capture_target.brp",
		"capture_target",
		"func main(args: List[String]) -> Int:\n\tmissing\n",
	)
	plan = capture_plan([root])
	result = plan.map(func(value): capture_check_typecheck_request(value, path))
	content = read_file(path)
	_ = remove_file(path)

	(
		result
			.map(
				func(
					value,
				): (
					value.status == 0
					and value.stdout == "Captured typecheck graph request to ${path}"
					and value.stderr == ""
				),
			)
			.get_or(False)
		and content
			.map(
				func(
					text,
				): capture_has_expected_request(
					text,
					finalized_typecheck_program_ast(root.program).source.path,
				),
			)
			.get_or(False)
	)


func test_capture_rejects_multiple_roots() -> Bool:
	first = capture_source(
		"/project/first.brp",
		"first",
		"func main(args: List[String]) -> Int:\n\t0\n",
	)
	second = capture_source(
		"/project/second.brp",
		"second",
		"func main(args: List[String]) -> Int:\n\t0\n",
	)
	result = capture_plan([first, second]).map(func(plan):
		capture_check_typecheck_request(plan, temp_dir() + "/blorp_typecheck_capture_rejected.json")
	)

	result
		.map(
			func(
				value,
			): (
				value.status == 1
				and value.stdout == ""
				and value.stderr == "cannot capture typecheck request: exactly one root is required"
			),
		)
		.get_or(False)


func test_capture_rejects_parse_errors_without_writing_request() -> Bool:
	path = temp_dir() + "/blorp_typecheck_capture_invalid.json"
	_ = remove_file(path)
	root = capture_source(
		"/project/invalid_capture_target.brp",
		"invalid_capture_target",
		"func main(\n",
	)
	result = capture_plan([root]).map(func(plan): capture_check_typecheck_request(plan, path))
	request_was_not_written = capture_request_was_not_written(path)
	_ = remove_file(path)

	(
		result
			.map(
				func(
					value,
				): (
					value.status == 1
					and value.stdout == ""
					and value.stderr == "cannot capture typecheck request: one or more source files have parse errors"
				),
			)
			.get_or(False)
		and request_was_not_written
	)


func test_capture_rejects_ast_dump_options() -> Bool:
	path = temp_dir() + "/blorp_typecheck_capture_ast_dump.json"
	_ = remove_file(path)
	root = capture_source(
		"/project/capture_ast_dump.brp",
		"capture_ast_dump",
		"func main(args: List[String]) -> Int:\n\t0\n",
	)
	result = capture_plan([root]).map(func(plan):
		capture_check_typecheck_request(
			{ plan | options = { plan.options | dump_ast = True } },
			path,
		)
	)
	request_was_not_written = capture_request_was_not_written(path)
	_ = remove_file(path)

	(
		result
			.map(func(value): value.status == 1 and value.stdout == "" and value.stderr == (
					"cannot capture typecheck request: --capture-typecheck-request cannot be "
					+ "combined with AST dump options"
				))
			.get_or(False)
		and request_was_not_written
	)


tests: TestSuite = {
	description = "Blorp check typecheck request capture",
	tests = [
		(
			"capture writes a replayable request without typechecking",
			test_capture_writes_replayable_request_without_typechecking,
		),
		("capture rejects multiple roots", test_capture_rejects_multiple_roots),
		(
			"capture rejects parse errors without writing a request",
			test_capture_rejects_parse_errors_without_writing_request,
		),
		("capture rejects AST dump options", test_capture_rejects_ast_dump_options),
	]
}
