import:
	../../src/check/command: execute_check_plan
	../../src/compiler/frontend_request: FrontendCompilationGraph
	../../src/compiler/pipeline: typecheck_frontend_root_only
	../../src/compiler/stage_03_parse/source_ast_finalize:
		FinalizedTypecheckProgram,
		finalized_typecheck_program_ast,
	../../src/compiler/stage_04_modules/frontend_graph:
		FrontendImportEdge,
		FrontendImportResolution(FrontendResolvedImport),
		FrontendModule,
	../../src/compiler/stage_04_modules/frontend_graph_service:
		frontend_graph_service_error_message,
		validated_frontend_graph_for_modules,
	../../src/compiler/stage_04_modules/loaded_module:
		ModuleOrigin(UserModule),
		resolved_module_canonical_path,
		resolved_module_identity_from_resolver,
	../../src/compiler/stage_04_modules/module_surface: module_surface_for_program
	../compiler/typecheck_test_support as TypecheckTestSupport
	test: TestSuite


private pure func typecheck_program_fixture(
	path: String,
	module_name: String,
	source: String,
) -> FinalizedTypecheckProgram:
	TypecheckTestSupport.finalized_typecheck_program_fixture(path, module_name, source)


private pure func graph_source(path: String, module_name: String, source: String) -> FrontendModule:
	program = typecheck_program_fixture(path, module_name, source)
	{
		identity = resolved_module_identity_from_resolver(module_name, UserModule),
		program = program,
		surface = module_surface_for_program(finalized_typecheck_program_ast(program))
	}


private pure func import_edge(
	root: FrontendModule,
	dependency: FrontendModule,
) -> FrontendImportEdge:
	{
		importer = root.identity,
		requested_path = resolved_module_canonical_path(dependency.identity),
		resolution = FrontendResolvedImport(dependency.identity)
	}


private pure func frontend_graph(
	roots: List[FrontendModule],
	modules: List[FrontendModule],
	import_edges: List[FrontendImportEdge],
) -> Result[FrontendCompilationGraph, String]:
	validated_frontend_graph_for_modules(
		roots.concat(modules),
		roots.map(func(root): root.identity),
		import_edges,
	)
		.map(func(graph): {
				context = {
					std_dir = None,
					source_packages = [],
					package_roots = []
				},
				graph = graph,
				diagnostics = []
			})
		.map_err(func(errors): errors
				.map(frontend_graph_service_error_message)
				.join("\n"))


pure func test_check_visits_all_roots_and_reports_shared_dependency_once() -> Bool:
	first_root = graph_source(
		"/project/first.brp",
		"first",
		"import:\n\tshared: broken\n\npure func first() -> Int: broken()",
	)
	second_root = graph_source(
		"/project/second.brp",
		"second",
		"import:\n\tshared: broken\n\npure func second() -> Int: broken()",
	)
	dependency = graph_source(
		"/project/shared.brp",
		"shared",
		"pure func broken() -> Int: missing_shared_value",
	)
	graph_result = frontend_graph(
		[first_root, second_root],
		[dependency],
		[import_edge(first_root, dependency), import_edge(second_root, dependency)],
	)

	match graph_result:
		Err(_):
			False
		Ok(graph):
			first_program = finalized_typecheck_program_ast(first_root.program)
			second_program = finalized_typecheck_program_ast(second_root.program)
			result = execute_check_plan({
				args = [],
				graph = graph,
				options = {
					debug = False,
					dump_ast = False,
					dump_typed_ast = False,
					capture_typecheck_request = None,
					no_format = True,
					std_dir = None,
					paths = [first_program.source.path, second_program.source.path]
				},
			})

			(
				result.status == 1
				and result.stdout.contains("Checking /project/first.brp")
				and result.stdout.contains("Checking /project/second.brp")
				and result.stderr.count("missing_shared_value") == 1
			)


pure func test_check_root_only_returns_no_dependency_artifacts() -> Bool:
	root = graph_source(
		"/project/main.brp",
		"main",
		"import:\n\tdep: helper\n\nfunc main() -> Int: helper()",
	)
	dependency = graph_source("/project/dep.brp", "dep", "pure func helper() -> Int: 1")

	match frontend_graph([root], [dependency], [import_edge(root, dependency)]):
		Err(_):
			False
		Ok(graph):
			typechecked = typecheck_frontend_root_only(graph, root, False)
			typechecked.modules.length() == 0


tests: TestSuite = {
	description = "Blorp CLI check execution",
	tests = [
		(
			"check visits all roots and reports a shared dependency once",
			test_check_visits_all_roots_and_reports_shared_dependency_once,
		),
		(
			"check root only returns no dependency artifacts",
			test_check_root_only_returns_no_dependency_artifacts,
		),
	]
}
