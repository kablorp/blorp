import:
	../../../src/compiler/stage_02_lex/name_table: name_ids_equal
	../../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../../src/compiler/stage_03_parse/parsed_ast:
		ParsedDecl(FunctionParsedDecl, ImportBlockParsedDecl), ParsedProgram, ParsedIdentifier,
		ParsedExpr(ParsedBoolLiteralExpr, ParsedCallExpr, ParsedFieldAccessExpr, ParsedNameExpr, ParsedUnaryExpr),
		ParsedUnaryOp(ParsedNotOp), parsed_program_ok
	../../../src/lib/source: source_file
	../../../src/compiler_new/stage_01_discovery/pipeline: load_module
	../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../src/compiler_new/stage_01_discovery/tables/builder: empty_discovery_builder
	../../../src/compiler_new/stage_01_discovery/tables/frontend_tables: FreezeOutcome(FrozenTables), freeze
	../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_at_row, name_id_index
	../../../src/compiler_new/stage_01_discovery/tables/row_kinds:
		ModuleReach(RootModule), NodeKind(CallNode, FieldAccessNode), Visibility(PublicVisibility), Purity(PureFunction)
	../../../src/compiler_new/stage_01_discovery/sources/source_provider: ModulePlacement(InUserCode)
	../../../src/compiler_new/stage_01_discovery/parse/parse_state:
		new_parse_state, current_span, diagnostics, diagnostic_count, spellings
	../../../src/compiler_new/stage_01_discovery/parse/layout_quirks: anchored_at
	../../../src/compiler_new/stage_01_discovery/parse/tree_expression_parser:
		parse_expression_to_boundary, ExpressionParse(ParsedExpression)
