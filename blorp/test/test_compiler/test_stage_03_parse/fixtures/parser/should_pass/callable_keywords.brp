-- RUN-BLORP-CHECK
-- A fixture-owned identity function distinguishes an ordinary call from unary not.
pure func not(value: Bool) -> Bool:
	value

pure func and(left: Bool, right: Bool) -> Bool:
	match left:
		True: right
		False: False

pure func or(left: Bool, right: Bool) -> Bool:
	match left:
		True: True
		False: right

func main() -> Int:
	match True.not().and(or(False, and(True, True))):
		True: 17
		False: 23
