-- RUN-BLORP-CHECK
-- EXPECT-BLORP: error: `limit` must be a positive integer literal, at most 9223372036854775807
-- EXPECT-BLORP: help: write `concurrently(limit: 4)`
-- EXPECT-BLORP-CONTAINS: :9:39: error:
-- EXPECT-DISCOVERY: ConcurrentLimitNotPositiveLiteralDiagnostic 9:39
-- TEST: limit rejects zero
func main(args: List[String]) -> Int:
	nums: List[Int] = [1, 2, 3]
	for n in nums concurrently(limit: 0):
		n * 2
	0
