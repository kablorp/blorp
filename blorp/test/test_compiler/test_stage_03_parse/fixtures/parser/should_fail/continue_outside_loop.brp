-- RUN-BLORP-CHECK
-- EXPECT-BLORP: error: `continue` can only be used inside a loop
-- EXPECT-BLORP: help: move `continue` into a `while` or `for` body, or remove it
-- EXPECT-BLORP-CONTAINS: :9:9: error:
-- EXPECT-DISCOVERY: ContinueOutsideLoopDiagnostic 9:9
-- TEST: `continue` at function level is rejected by the parser
func stop(flag: Bool) -> Int:
	if flag:
		continue
	0
