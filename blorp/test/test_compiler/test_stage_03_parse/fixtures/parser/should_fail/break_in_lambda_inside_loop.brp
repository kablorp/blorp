-- RUN-BLORP-CHECK
-- EXPECT-BLORP: error: `break` can only be used inside a loop
-- EXPECT-BLORP: help: move `break` into a `while` or `for` body, or remove it
-- EXPECT-BLORP-CONTAINS: :10:13: error:
-- EXPECT-DISCOVERY: BreakOutsideLoopDiagnostic 10:13
-- TEST: a lambda body starts outside every loop, so its `break` cannot leave the enclosing `for`
func run(values: List[Int]) -> Int:
	for value in values:
		stop = func(item: Int) -> Int:
			break
			item
		print(stop(value))
	0
