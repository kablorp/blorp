-- RUN-BLORP-CHECK
-- EXPECT-BLORP: error: `continue` can only be used inside a loop
-- EXPECT-BLORP: help: move `continue` into a `while` or `for` body, or remove it
-- EXPECT-BLORP-CONTAINS: :10:20: error:
-- EXPECT-DISCOVERY: ContinueOutsideLoopDiagnostic 10:20
-- TEST: a `concurrent:` task body starts outside every loop, so its `continue` cannot reach the enclosing `while`
func run(ready: Bool) -> Int:
	while ready:
		concurrent:
			task = continue
	0
