-- RUN-BLORP-CHECK
-- EXPECT-BLORP: error: expected `]` after list pattern
-- EXPECT-BLORP-CONTAINS: :11:17: error:
-- EXPECT-DISCOVERY: ExpectedRightBracketDiagnostic 11:17
-- EXPECT-DISCOVERY-TEXT: error: expected `]` after list pattern
-- EXPECT-DISCOVERY-TEXT: help: close the bracket opened earlier with `]`
-- A list pattern with elements after its spread: the parser stops at the `,` where it expects the closing `]`.

func bad(xs: List[Int]) -> Int:
    match xs:
        [...rest, x]: x
        _: 0
