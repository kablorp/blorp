-- An input the existing parser reads wrongly and the discovery stage reads as
-- the language says. The adapter differential reports it, and
-- `ADAPTER_DIFFERENCES` in `scripts/compiler-new-parity` lists it with its
-- reason (`docs/issues/interpolation_nesting_in_the_existing_lexer.md`).
-- Do not run the formatter on this file: it re-reads the string through the same
-- lexer and rewrites it as the lexer misreads it.
func nesting(h: Int) -> String:
	third_level = "a ${f("b ${g("c ${h}")}")} d"
	third_level
