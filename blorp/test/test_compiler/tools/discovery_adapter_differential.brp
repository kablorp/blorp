-- Compares the legacy adapter's declaration-level parsed AST with the
-- existing parser's, module by module, for every module the discovery stage
-- loads, for the adapter check of `scripts/compiler-new-parity`.
--
-- Usage: discovery_adapter_differential.brp <compile|test> <root.brp> [--embedded-std] [--package <spec>]...
--        discovery_adapter_differential.brp files <file listing one source path per line> [--stop-census] [--only-listed]
--
-- The first form takes the command line of `module_order_options`: `compile`
-- loads the implicit modules a compile or check loads, `test` also the test
-- runtime; `--embedded-std` reads the standard library from the compiler's
-- embedded texts; `--package` adds a source package.
-- The root module is named `main`. `files` makes every listed file a root of one
-- discovery (named by its path without `.brp`) and loads the implicit modules a
-- compile loads, so one run covers files no import reaches, fixtures included.
-- Discovery still loads everything the roots import, and by default every
-- loaded module is compared. With `--only-listed` only the listed roots are
-- compared (the summaries count them alone), which is how a targeted run of
-- `scripts/compiler-new-parity` avoids comparing a root's whole import graph.
-- It then prints `listed-module <path>` for each module it compares, so the
-- caller can check that every listed file was reached and no other was.
-- With `--stop-census` (`files` only) the declaration the tree scan stopped
-- at, in a module it did not read in full, also prints why, for the
-- stop-reason census of `scripts/compiler-new-parity --stop-census`:
--
--   stop-reason <path> | <function|trait|implementation|global-initializer> | <reason> | <line>
--
-- The scan stops at the module's first declaration it does not read in full,
-- so there is at most one per module. The reason is the rollback's own
-- `StopReason`, named by `stop_reason_label`; the line is 1-based and is where
-- the parser stood when it declined.
--
-- For each module the existing parser's program, with each interpolated
-- string's holes parsed (`with_holes_parsed`: the adapter's strings come from
-- the stage, which parses the holes with the file), is encoded with
-- `parsed_program_to_json`, as is the adapter's program; every field that
-- differs, spans included, is one `difference` line:
--
--   difference <module path> | <declaration> | <json path> | old=<value> | new=<value>
--
-- A module the existing parser rejects is not compared (the parity gate
-- compares the verdicts) and prints `skipped`; a module the adapter could not
-- rebuild prints `adapter-error` and the run exits with status 4.
--
-- The additive tree declaration-prefix protocol uses the exact accepted old
-- program and one shared legacy name table per run. Completed declarations are
-- compared field by field; a typed stop validates the next old declaration.
-- A rejected old program prints `tree-prefix-skipped`. Accepted tree rejections
-- remain comparisons and report helper differences. Infrastructure failures
-- print `tree-prefix-error` and exit 4, independently of adapter rebuilding.
--
--   tree-prefix-difference <path> | <declaration> | <json path> | old=<value> | new=<value>
--   tree-prefix-skipped <path> | <reason>
--   tree-prefix-error <path> | <source|input|projection> | <message>
--
-- The tree module protocol assembles each module the old parser accepts
-- (`tree_module_assembly.brp`), runs the id census over every assembled
-- module and compares its whole projected program with the old one, field by
-- field and span by span, through one shared legacy name table per run:
--
--   tree-module-difference <path> | <declaration> | <json path> | old=<value> | new=<value>
--   tree-module-rejected <path> | <diagnostic count>
--   tree-module-skipped <path> | <reason>
--   tree-module-error <path> | <source|input|census|projection> | <message>
--   tree-module-summary modules=<n> assembled=<n> rejected=<n> unassembled=<n> skipped=<n> errors=<n> differences=<n> reported=<n> <stop>=<n>...
--
-- A module the tree path did not read in full is counted by where it stopped;
-- one the tree path rejects although the old parser accepts it is a
-- `tree-module-rejected` line. Errors exit 4.
--
-- At most MAX_DIFFERENCES_PER_MODULE tree differences are printed per module.
-- `tree-prefix-summary` counts every difference in `differences`, emitted
-- lines in `reported`, compared declarations, and per-module distinct kind
-- coverage (including separate record/fixed_record) plus all eight stops.
-- Its modules/compared/skipped/errors accounting covers every discovered module.
-- It appears immediately before the existing final summary, which is unchanged:
--
--   summary modules=<n> compared=<n> skipped=<n> declarations=<n> differences=<n>
--
-- This tool imports the existing compiler and the discovery stage, so it
-- lives beside the existing front end's tools, outside `compiler_new`, whose
-- sources and tests must not import the existing compiler.
import:
	../../../src/compiler/discovery_adapter:
		COMPILER_EMBEDDED_TEXTS,
		CompilerEmbeddedTexts,
		DeclarationReader,
		LegacyAdapterError,
		LegacyModuleNaming,
		legacy_adapter_error_message,
		legacy_declaration_reader,
		legacy_embedded_path,
		legacy_parsed_program,
		legacy_source_file,
	../../../src/compiler/discovery_tree_projection:
		LegacyDeclarationPreviewError(MissingDimensionLiteralToken, MissingVariadicWildcardToken, InvalidGlobalInitializerEntry, UnsupportedGlobalInitializerExpression, MissingIntegerLiteralToken, UnsupportedBodyStatement, MissingPatternNumberToken),
		legacy_assembled_program,
		legacy_declaration_projection,
	../../../src/compiler/stage_02_lex/name_table: NameTable, SYNTHESIZED_NAME_TABLE
	../../../src/compiler/stage_01_generated_inputs/embedded_std: embedded_std_source
	../../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../../src/compiler/stage_03_parse/parsed_ast: ParsedProgram
	../../../src/compiler/stage_03_parse/parsed_ast_json: parsed_program_to_json
	../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../src/compiler_new/stage_01_discovery/parse/parse_state:
		ParseInputError(EmptyRejection, InvalidLineStarts, InvalidTokenInput, NonLexicalDiagnostic),
		new_parse_state,
		span_start_line,
	../../../src/compiler_new/stage_01_discovery/parse/preview_source: preview_source
	../../../src/compiler_new/stage_01_discovery/syntax/module_syntax: ModuleItem(FunctionItem, TraitItem, ImplementationItem)
	../../../src/compiler_new/stage_01_discovery/parse/tree_module_declaration_scan:
		UnreadDeclaration, UnreadHeader(UnreadFunction, UnreadTrait, UnreadImplementation, UnreadGlobalInitializer),
		ModuleDeclarationScanStop(StoppedAtUnreadDeclaration), scan_module_declarations
	../../../src/compiler_new/stage_01_discovery/parse/tree_module_assembly:
		ModuleAssembly(AssembledModule, RejectedModule, UnassembledModule),
		UnassembledReason(DeclarationNotRead, GlobalInitializerRejected, DeclarationRejected, DeclarationMadeNoProgress),
		assemble_module,
	../../../src/compiler_new/stage_01_discovery/parse/rejected_preview: rejected_diagnostics
	../../../src/compiler_new/stage_01_discovery/syntax/id_census:
		CensusProblem(IdHeldTwice, IdNotHeld, IdNotIssued, IdOfAnotherModule),
		IdFamily(
			DefinitionIds, ImportIds, StatementIds, BlockIds, ExpressionIds, PatternIds, WrittenTypeIds,
			DimensionIds, NameUseIds, BinderIds, TypeBinderIds,
		),
		id_census,
	../../../src/compiler_new/stage_01_discovery/tables/span: span_start, span_end
	../../../src/compiler_new/stage_01_discovery/pipeline:
		ImplicitModules,
		compiler_implicit_modules,
		discover,
		test_implicit_modules,
	../../../src/compiler_new/stage_01_discovery/sources/embedded_standard_library:
		EmbeddedStandardLibraryProvider,
		embedded_lookup_roots,
	../../../src/compiler_new/stage_01_discovery/sources/source_provider:
		FILE_SYSTEM_SOURCE_PROVIDER,
		FileSystemSourceProvider,
		SourceLookupRoots,
		SourcePackageRoot,
		SourceProvider,
	../../../src/compiler_new/stage_01_discovery/tables/frontend_tables:
		FreezeOutcome(FrozenTables, TableInvariantsViolated),
		FrontendTables,
		module_count,
		module_row,
		path_text,
		source_row,
	../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_at_row
	../../../src/compiler_new/stage_01_discovery/tables/rows: ModuleRow
	../../../src/lib/source: SourceFile, source_file
	discovery_adapter_comparison:
		JsonDifference, program_differences, with_holes_parsed, shortened,
		DeclarationPrefixComparison, declaration_prefix_comparison,
		DeclarationPrefixKind(ImportBlockPrefix, ForeignBlockPrefix, RecordPrefix, FixedRecordPrefix, AliasPrefix, BuiltinTypePrefix, ResourceTypePrefix, UnionPrefix, FixedUnionPrefix, FunctionPrefix, TraitPrefix, ImplementationPrefix, ConstantGlobalPrefix, MutableGlobalPrefix),
		DeclarationPrefixStopKind(EndOfSourcePrefixStop, FunctionHeaderPrefixStop, TraitPreviewPrefixStop, ImplementationPreviewPrefixStop, GlobalInitializerPrefixStop, RejectedGlobalInitializerPrefixStop, RejectedDeclarationPrefixStop, WithoutProgressPrefixStop)
	module_order_options:
		ModuleOrderMode(TestMode),
		ModuleOrderOptions,
		SourcePackageSpec,
		StandardLibrarySource(StandardLibraryEmbedded, StandardLibraryOnDisk),
		parse_module_order_options,
	list: range
	set as Sets
	system: read_file
	../../test_compiler_new/support/stop_reason_label: unread_kind_label, stop_reason_label


STANDARD_LIBRARY_ROOT: String = "standard_library/src"

NATIVE_PACKAGE_ROOT: String = "pkg"

FILES_MODE: String = "files"

FILES_ARGUMENT: Int = 2

FLAGS_START: Int = 3

STOP_CENSUS_FLAG: String = "--stop-census"

ONLY_LISTED_FLAG: String = "--only-listed"

SOURCE_FILE_SUFFIX: String = ".brp"

ROOT_MODULE_NAME: String = "main"

EXIT_USAGE: Int = 2

EXIT_INVARIANT_VIOLATION: Int = 3

EXIT_ADAPTER_ERROR: Int = 4

---
The most differing fields reported for one module; a module that differs
everywhere is one problem, not hundreds of lines.
---
MAX_DIFFERENCES_PER_MODULE: Int = 40


-- Why a module is not compared; `scripts/compiler-new-parity` reads it.
EXISTING_PARSER_REJECTED: String = "rejected by the existing parser"


-- The comparison of one module.
union ModuleComparison:
	ModuleCompared(Int, List[JsonDifference])
	ModuleSkipped(String)
	ModuleNotRebuilt(String)


-- The declaration the tree scan stopped at, and the 1-based line it declined at.
record LocatedStop {
	unread: UnreadDeclaration,
	line: Int
}


-- Only a successful projection carries names to advance the shared table.
union TreePrefixModuleComparison:
	TreePrefixCompared(NameTable, DeclarationPrefixComparison, CompletedBodyCounts, Option[LocatedStop])
	TreePrefixSkipped(String)
	TreePrefixError(TreePrefixErrorStage, String)


fixed union TreePrefixErrorStage:
	TreePrefixSourceError
	TreePrefixInputError
	TreePrefixProjectionError


record ModuleComparisons {
	adapter: ModuleComparison,
	tree: TreePrefixModuleComparison,
	module_tree: TreeModuleComparison
}


-- The whole-module tree comparison of one module. Only a compared module
-- carries names to advance the run's shared table.
union TreeModuleComparison:
	TreeModuleCompared(NameTable, List[JsonDifference])
	TreeModuleRejected(Int)
	TreeModuleUnassembled(UnassembledReason)
	TreeModuleSkipped(String)
	TreeModuleError(TreeModuleErrorStage, String)


fixed union TreeModuleErrorStage:
	TreeModuleSourceError
	TreeModuleInputError
	TreeModuleCensusError
	TreeModuleProjectionError


-- Modules the tree path did not read in full, by where it stopped first.
record TreeModuleStopCounts {
	function_body: Int,
	trait_bodies: Int,
	implementation_bodies: Int,
	global_initializer: Int,
	rejected_global_initializer: Int,
	rejected_declaration: Int,
	without_progress: Int
}


record TreeModuleCounts {
	assembled: Int,
	rejected: Int,
	unassembled: Int,
	skipped: Int,
	errors: Int,
	differences: Int,
	reported: Int,
	stops: TreeModuleStopCounts
}


private EMPTY_TREE_MODULE_COUNTS: TreeModuleCounts = {
	assembled = 0, rejected = 0, unassembled = 0, skipped = 0, errors = 0, differences = 0, reported = 0,
	stops = {
		function_body = 0, trait_bodies = 0, implementation_bodies = 0, global_initializer = 0,
		rejected_global_initializer = 0, rejected_declaration = 0, without_progress = 0
	}
}


pure func count_tree_module_stop(counts: TreeModuleStopCounts, reason: UnassembledReason) -> TreeModuleStopCounts:
	match reason:
		DeclarationNotRead(unread):
			match unread.header:
				UnreadFunction(_):
					{ counts | function_body = counts.function_body + 1 }
				UnreadTrait(_):
					{ counts | trait_bodies = counts.trait_bodies + 1 }
				UnreadImplementation(_):
					{ counts | implementation_bodies = counts.implementation_bodies + 1 }
				UnreadGlobalInitializer(_):
					{ counts | global_initializer = counts.global_initializer + 1 }
		GlobalInitializerRejected(_):
			{ counts | rejected_global_initializer = counts.rejected_global_initializer + 1 }
		DeclarationRejected:
			{ counts | rejected_declaration = counts.rejected_declaration + 1 }
		DeclarationMadeNoProgress:
			{ counts | without_progress = counts.without_progress + 1 }


pure func tree_module_error_stage_label(stage: TreeModuleErrorStage) -> String:
	match stage:
		TreeModuleSourceError: "source"
		TreeModuleInputError: "input"
		TreeModuleCensusError: "census"
		TreeModuleProjectionError: "projection"


pure func census_problem_text(problem: CensusProblem) -> String:
	match problem:
		IdHeldTwice(family, index):
			"${id_family_label(family)} ${index} held twice"
		IdNotHeld(family, index):
			"${id_family_label(family)} ${index} issued and not held"
		IdNotIssued(family, index):
			"${id_family_label(family)} ${index} held and not issued"
		IdOfAnotherModule(family, _, index):
			"${id_family_label(family)} ${index} of another module"


pure func id_family_label(family: IdFamily) -> String:
	match family:
		DefinitionIds: "definition"
		ImportIds: "import"
		StatementIds: "statement"
		BlockIds: "block"
		ExpressionIds: "expression"
		PatternIds: "pattern"
		WrittenTypeIds: "written type"
		DimensionIds: "dimension"
		NameUseIds: "name use"
		BinderIds: "binder"
		TypeBinderIds: "type binder"


pure func parse_input_error_text(error: ParseInputError) -> String:
	match error:
		EmptyRejection:
			"a rejection with no diagnostic"
		InvalidLineStarts:
			"line starts that do not match the source"
		InvalidTokenInput(_):
			"tokens the cursor refuses"
		NonLexicalDiagnostic(span, _):
			"a parser diagnostic among the lexer's at ${span.span_start()}..${span.span_end()}"


---
The old program against the tree path's whole module: assembled, censused,
projected and compared in full. `existing` is the accepted old program, whose
source file the projection reuses: module naming belongs to the module walk.
---
pure func compare_tree_module(existing: ParsedProgram, module: Int, names: NameTable) -> TreeModuleComparison:
	lexed = lex_module(module_id_at_row(module), existing.source.text)
	match assemble_module(lexed):
		Err(error):
			TreeModuleError(TreeModuleInputError, "lexed source cannot initialize the tree parse state: ${parse_input_error_text(error)}")
		Ok(UnassembledModule(reason)):
			TreeModuleUnassembled(reason)
		Ok(RejectedModule(rejected)):
			TreeModuleRejected(rejected.rejected_diagnostics().length())
		Ok(AssembledModule(assembled)):
			problems = id_census(module_id_at_row(module), assembled.syntax)
			match problems.get(0):
				Some(first):
					TreeModuleError(TreeModuleCensusError, "${problems.length()} problems, first ${census_problem_text(first)}")
				None:
					match legacy_assembled_program(existing.source, preview_source(lexed), assembled.syntax, names):
						Ok((projected_names, projected)):
							TreeModuleCompared(
								projected_names,
								program_differences(parsed_program_to_json(existing), parsed_program_to_json(projected)),
							)
						Err(error):
							TreeModuleError(TreeModuleProjectionError, projection_error_message(error))


record TreePrefixKindCounts {
	import_block_modules: Int,
	foreign_block_modules: Int,
	record_modules: Int,
	fixed_record_modules: Int,
	alias_modules: Int,
	builtin_type_modules: Int,
	resource_type_modules: Int,
	union_modules: Int,
	fixed_union_modules: Int,
	function_modules: Int,
	trait_modules: Int,
	implementation_modules: Int,
	constant_global_modules: Int,
	mutable_global_modules: Int
}


private EMPTY_TREE_PREFIX_KIND_COUNTS: TreePrefixKindCounts = {
	import_block_modules = 0,
	foreign_block_modules = 0,
	record_modules = 0,

	fixed_record_modules = 0,
	alias_modules = 0,
	builtin_type_modules = 0,
	resource_type_modules = 0,
	union_modules = 0,
	fixed_union_modules = 0,
	function_modules = 0,
	trait_modules = 0,
	implementation_modules = 0,
	constant_global_modules = 0,
	mutable_global_modules = 0
}


record TreePrefixStopCounts {
	end_of_source_modules: Int,
	function_header_modules: Int,
	trait_preview_modules: Int,
	implementation_preview_modules: Int,
	global_initializer_modules: Int,
	rejected_global_initializer_modules: Int,
	rejected_declaration_modules: Int,
	without_progress_modules: Int
}


private EMPTY_TREE_PREFIX_STOP_COUNTS: TreePrefixStopCounts = {
	end_of_source_modules = 0,
	function_header_modules = 0,
	trait_preview_modules = 0,
	implementation_preview_modules = 0,
	global_initializer_modules = 0,
	rejected_global_initializer_modules = 0,
	rejected_declaration_modules = 0,
	without_progress_modules = 0
}


-- The functions, traits and implementations whose bodies the tree path read.
record CompletedBodyCounts {
	functions: Int,
	traits: Int,
	implementations: Int
}


private EMPTY_COMPLETED_BODY_COUNTS: CompletedBodyCounts = { functions = 0, traits = 0, implementations = 0 }


record TreePrefixCounts {
	compared: Int,
	skipped: Int,
	errors: Int,
	declarations: Int,
	completed: CompletedBodyCounts,
	differences: Int,
	reported: Int,
	kinds: TreePrefixKindCounts,
	stops: TreePrefixStopCounts
}


private EMPTY_TREE_PREFIX_COUNTS: TreePrefixCounts = {
	compared = 0, skipped = 0, errors = 0, declarations = 0, completed = EMPTY_COMPLETED_BODY_COUNTS, differences = 0, reported = 0,
	kinds = EMPTY_TREE_PREFIX_KIND_COUNTS, stops = EMPTY_TREE_PREFIX_STOP_COUNTS
}


pure func count_tree_prefix_kind(counts: TreePrefixKindCounts, kind: DeclarationPrefixKind) -> TreePrefixKindCounts:
	match kind:
		ImportBlockPrefix:
			{ counts | import_block_modules = counts.import_block_modules + 1 }
		ForeignBlockPrefix:
			{ counts | foreign_block_modules = counts.foreign_block_modules + 1 }
		RecordPrefix:
			{ counts | record_modules = counts.record_modules + 1 }
		FixedRecordPrefix:
			{ counts | fixed_record_modules = counts.fixed_record_modules + 1 }
		AliasPrefix:
			{ counts | alias_modules = counts.alias_modules + 1 }
		BuiltinTypePrefix:
			{ counts | builtin_type_modules = counts.builtin_type_modules + 1 }
		ResourceTypePrefix:
			{ counts | resource_type_modules = counts.resource_type_modules + 1 }
		UnionPrefix:
			{ counts | union_modules = counts.union_modules + 1 }
		FixedUnionPrefix:
			{ counts | fixed_union_modules = counts.fixed_union_modules + 1 }
		FunctionPrefix:
			{ counts | function_modules = counts.function_modules + 1 }
		TraitPrefix:
			{ counts | trait_modules = counts.trait_modules + 1 }
		ImplementationPrefix:
			{ counts | implementation_modules = counts.implementation_modules + 1 }
		ConstantGlobalPrefix:
			{ counts | constant_global_modules = counts.constant_global_modules + 1 }
		MutableGlobalPrefix:
			{ counts | mutable_global_modules = counts.mutable_global_modules + 1 }


pure func count_tree_prefix_stop(counts: TreePrefixStopCounts, kind: DeclarationPrefixStopKind) -> TreePrefixStopCounts:
	match kind:
		EndOfSourcePrefixStop:
			{ counts | end_of_source_modules = counts.end_of_source_modules + 1 }
		FunctionHeaderPrefixStop:
			{ counts | function_header_modules = counts.function_header_modules + 1 }
		TraitPreviewPrefixStop:
			{ counts | trait_preview_modules = counts.trait_preview_modules + 1 }
		ImplementationPreviewPrefixStop:
			{ counts | implementation_preview_modules = counts.implementation_preview_modules + 1 }
		GlobalInitializerPrefixStop:
			{ counts | global_initializer_modules = counts.global_initializer_modules + 1 }
		RejectedGlobalInitializerPrefixStop:
			{ counts | rejected_global_initializer_modules = counts.rejected_global_initializer_modules + 1 }
		RejectedDeclarationPrefixStop:
			{ counts | rejected_declaration_modules = counts.rejected_declaration_modules + 1 }
		WithoutProgressPrefixStop:
			{ counts | without_progress_modules = counts.without_progress_modules + 1 }


pure func count_completed_bodies(counts: CompletedBodyCounts, item: ModuleItem) -> CompletedBodyCounts:
	match item:
		FunctionItem(_): { counts | functions = counts.functions + 1 }
		TraitItem(_): { counts | traits = counts.traits + 1 }
		ImplementationItem(_): { counts | implementations = counts.implementations + 1 }
		_: counts


pure func tree_prefix_error_stage_label(stage: TreePrefixErrorStage) -> String:
	match stage:
		TreePrefixSourceError: "source"
		TreePrefixInputError: "input"
		TreePrefixProjectionError: "projection"


pure func compare_tree_prefix(existing: ParsedProgram, module: Int, names: NameTable) -> TreePrefixModuleComparison:
	lexed = lex_module(module_id_at_row(module), existing.source.text)
	match new_parse_state(lexed):
		Ok(entry):
			(_, scan) = scan_module_declarations(entry)
			located: Option[LocatedStop] = match scan.stop:
				StoppedAtUnreadDeclaration(unread):
					Some({ unread = unread, line = entry.span_start_line(unread.stop.at) + 1 })
				_:
					None
			match legacy_declaration_projection(preview_source(lexed), scan, names):
				Ok(projection):
					var compared_bodies: CompletedBodyCounts = EMPTY_COMPLETED_BODY_COUNTS
					for item in scan.items:
						compared_bodies = count_completed_bodies(compared_bodies, item)
					TreePrefixCompared(projection.names, declaration_prefix_comparison(existing, projection), compared_bodies, located)
				Err(error):
					TreePrefixError(TreePrefixProjectionError, projection_error_message(error))
		Err(_):
			TreePrefixError(TreePrefixInputError, "lexed source cannot initialize the tree parse state")


pure func projection_error_message(error: LegacyDeclarationPreviewError) -> String:
	match error:
		MissingDimensionLiteralToken(span):
			"missing dimension literal token at ${span.span_start()}..${span.span_end()}"
		MissingIntegerLiteralToken(span):
			"missing integer literal token at ${span.span_start()}..${span.span_end()}"
		MissingVariadicWildcardToken(span):
			"missing variadic wildcard token at ${span.span_start()}..${span.span_end()}"
		InvalidGlobalInitializerEntry(span):
			"invalid global initializer entry at ${span.span_start()}..${span.span_end()}"
		UnsupportedGlobalInitializerExpression(span):
			"unsupported completed global initializer at ${span.span_start()}..${span.span_end()}"
		UnsupportedBodyStatement(span):
			"unsupported body statement at ${span.span_start()}..${span.span_end()}"
		MissingPatternNumberToken(span):
			"missing pattern number token at ${span.span_start()}..${span.span_end()}"


---
The text of the source of a module as the existing front end reads it: an
embedded module from the embedded texts by its module name, any other from the
file system.
---
func existing_source_text(source: SourceFile) -> Result[String, String]:
	if source.path == legacy_embedded_path(source.module_name):
		match embedded_std_source(source.module_name):
			Some(text):
				Ok(text)
			None:
				Err("the embedded standard library has no ${source.module_name}")
	else:
		read_file(source.path)


---
One module: the existing parser over its source, against the adapter's program
from the tables. A module the existing parser rejects is skipped before the
adapter runs, since the adapter rebuilds only what the parser accepted.
---
func compare_module(reader: DeclarationReader, module: Int, row: ModuleRow, names: NameTable, module_names: NameTable) -> ModuleComparisons:
	match legacy_source_file(reader, module_id_at_row(module)):
		Ok(source):
			match existing_source_text(source):
				Ok(text):
					existing: ParsedProgram = parse_compiler_source(
						source_file(
							source.path,
							source.module_name,
							text,
						),
					)

					-- The verdict is the one `compiler-new-parity` compares: parse, then
					-- finalize the interpolation holes, which can reject a file the raw
					-- parse accepts.
					finalized: ParsedProgram = with_holes_parsed(existing)

					if not finalized.diagnostics.is_empty():
						{
							adapter = ModuleSkipped(EXISTING_PARSER_REJECTED),
							tree = TreePrefixSkipped(EXISTING_PARSER_REJECTED),
							module_tree = TreeModuleSkipped(EXISTING_PARSER_REJECTED)
						}
					else:
						{
							adapter = compare_accepted(reader, module, row, finalized, text),
							tree = compare_tree_prefix(finalized, module, names),
							module_tree = compare_tree_module(finalized, module, module_names)
						}
				Err(message):
					{
						adapter = ModuleSkipped("unreadable: ${message}"),
						tree = TreePrefixError(TreePrefixSourceError, message),
						module_tree = TreeModuleError(TreeModuleSourceError, message)
					}
		Err(error):
			message = legacy_adapter_error_message(error)
			{
				adapter = ModuleNotRebuilt(message),
				tree = TreePrefixError(TreePrefixSourceError, message),
				module_tree = TreeModuleError(TreeModuleSourceError, message)
			}


func compare_accepted(
	reader: DeclarationReader,
	module: Int,
	row: ModuleRow,
	existing: ParsedProgram,
	text: String,
) -> ModuleComparison:
	match legacy_parsed_program(reader, module_id_at_row(module)):
		Ok(adapted):
			if row.diagnostics.count > 0:
				ModuleCompared(
					0,
					[
						{
							declaration = "",
							path = "diagnostics",
							old_text = "0",
							new_text = "${row.diagnostics.count}"
						},
					],
				)
			else:
				differences: List[JsonDifference] = program_differences(
					parsed_program_to_json(existing),
					parsed_program_to_json(adapted),
				)

				text_differences: List[JsonDifference] = if adapted.source.text == text:
					[]
				else:
					[
						{
							declaration = "",
							path = "source.text",
							old_text = "${text.length()} bytes",
							new_text = "${adapted.source.text.length()} bytes"
						},
					]

				ModuleCompared(
					adapted.decls.length(),
					text_differences.concat(differences),
				)
		Err(error):
			ModuleNotRebuilt(legacy_adapter_error_message(error))


---
A run: the roots to discover, how the existing front end names them, the
implicit modules, where the standard library comes from and the source packages.
---
record DifferentialRun {
	paths: List[String],
	root_module_name: pure (String) -> String,
	implicit: ImplicitModules,
	standard_library: StandardLibrarySource,
	source_packages: List[SourcePackageSpec],
	stop_census: StopCensus,
	compared: ComparedModules
}


-- Which discovered modules a run compares. Discovery loads every import of a
-- root; a targeted run compares only the roots it was asked about, named by the
-- paths the discovery tables hold for them.
union ComparedModules:
	EveryDiscoveredModule
	ListedModulesOnly(Set[String])


pure func is_compared(compared: ComparedModules, path: String) -> Bool:
	match compared:
		EveryDiscoveredModule:
			True
		ListedModulesOnly(listed):
			Sets.contains(listed, path)


-- Whether the run prints each module's first unread declaration.
fixed union StopCensus:
	ReportStops
	OmitStops


func run_from_options(options: ModuleOrderOptions) -> DifferentialRun:
	implicit: ImplicitModules = if options.mode == TestMode:
		test_implicit_modules()
	else:
		compiler_implicit_modules()

	{
		paths = [options.root],
		root_module_name = pure func(request_path): ROOT_MODULE_NAME,
		implicit = implicit,
		standard_library = options.standard_library,
		source_packages = options.source_packages,
		stop_census = OmitStops,
		compared = EveryDiscoveredModule
	}


---
Every file of the listing at `listing_path` as a root, or `None` when it cannot
be read.
---
func run_over_files(listing_path: String, stop_census: StopCensus, only_listed: Bool) -> Option[DifferentialRun]:
	match read_file(listing_path):
		Ok(listing):
			paths: List[String] = listing
				.split("\n")
				.filter(pure func(line): line != "")
			compared: ComparedModules = if only_listed:
				ListedModulesOnly(Sets.from_list(paths))
			else:
				EveryDiscoveredModule
			Some({
				paths = paths,
				root_module_name = pure func(
					request_path,
				): request_path.remove_suffix(SOURCE_FILE_SUFFIX),
				implicit = compiler_implicit_modules(),
				standard_library = StandardLibraryOnDisk,
				source_packages = [],
				stop_census = stop_census,
				compared = compared,
			})
		Err(_):
			None


func source_package_root(spec: SourcePackageSpec) -> SourcePackageRoot:
	{
		package_alias = spec.package_alias,
		package_name = spec.package_name,
		source_dir = spec.source_dir,
		exports = spec.exports
	}


func main(args: List[String]) -> Int:
	if args.get_or(1, "") == FILES_MODE:
		flags: List[String] = args.drop(FLAGS_START)
		stop_census: StopCensus = if flags.contains(STOP_CENSUS_FLAG):
			ReportStops
		else:
			OmitStops
		match run_over_files(args.get_or(FILES_ARGUMENT, ""), stop_census, flags.contains(ONLY_LISTED_FLAG)):
			Some(run):
				execute(run)
			None:
				print("usage: discovery_adapter_differential.brp files <listing> [--stop-census] [--only-listed]")
				EXIT_USAGE
	else:
		match parse_module_order_options(args):
			Ok(options):
				execute(run_from_options(options))
			Err(usage):
				print(usage)
				EXIT_USAGE


---
Discovers the run's roots with the provider its standard library needs, then
compares every module.
---
func execute(run: DifferentialRun) -> Int:
	source_packages: List[SourcePackageRoot] = run.source_packages.map(source_package_root)

	match run.standard_library:
		StandardLibraryOnDisk:
			roots: SourceLookupRoots = {
				standard_library_root = STANDARD_LIBRARY_ROOT,
				native_package_roots = [NATIVE_PACKAGE_ROOT],
				source_packages = source_packages
			}
			compare_discovered(FILE_SYSTEM_SOURCE_PROVIDER, roots, run)
		StandardLibraryEmbedded:
			roots: SourceLookupRoots = embedded_lookup_roots([NATIVE_PACKAGE_ROOT], source_packages)
			provider: EmbeddedStandardLibraryProvider[CompilerEmbeddedTexts, FileSystemSourceProvider] = {
				texts = COMPILER_EMBEDDED_TEXTS,
				inner = FILE_SYSTEM_SOURCE_PROVIDER
			}
			compare_discovered(provider, roots, run)


func compare_discovered[Provider:SourceProvider](
	provider: Provider,
	roots: SourceLookupRoots,
	run: DifferentialRun,
) -> Int:
	match discover(provider, roots, run.paths, run.implicit):
		FrozenTables(tables):
			naming: LegacyModuleNaming = {
				root_module_name = run.root_module_name,
				path_module_name = pure func(path): path.remove_suffix(SOURCE_FILE_SUFFIX)
			}

			match legacy_declaration_reader(tables, naming):
				Ok(reader):
					print_comparison(tables, reader, run.stop_census, run.compared)
				Err(error):
					print("adapter-error | ${legacy_adapter_error_message(error)}")
					EXIT_ADAPTER_ERROR
		TableInvariantsViolated(violations):
			print("table invariants violated: ${violations.length()}")
			EXIT_INVARIANT_VIOLATION


-- The path of the module at table row `module`, as the listing names it.
pure func module_path(tables: FrontendTables, module: Int) -> String:
	row: ModuleRow = module_row(tables, module_id_at_row(module))
	path_text(tables, source_row(tables, row.source).path)


func print_comparison(
	tables: FrontendTables, reader: DeclarationReader, stop_census: StopCensus, scope: ComparedModules,
) -> Int:
	selected: List[Int] = range(0, module_count(tables)).filter(
		pure func(module): is_compared(scope, module_path(tables, module)),
	)
	var compared: Int = 0
	var skipped: Int = 0
	var not_rebuilt: Int = 0
	var declarations: Int = 0
	var differing: Int = 0
	var tree_counts: TreePrefixCounts = EMPTY_TREE_PREFIX_COUNTS
	var tree_names: NameTable = SYNTHESIZED_NAME_TABLE
	var module_counts: TreeModuleCounts = EMPTY_TREE_MODULE_COUNTS
	var module_names: NameTable = SYNTHESIZED_NAME_TABLE

	for module in selected:
		row: ModuleRow = module_row(tables, module_id_at_row(module))
		path: String = module_path(tables, module)

		match scope:
			ListedModulesOnly(_):
				print("listed-module ${path}")
			EveryDiscoveredModule:
				void

		comparisons = compare_module(reader, module, row, tree_names, module_names)
		match comparisons.adapter:
			ModuleCompared(count, differences):
				compared += 1
				declarations += count

				for difference in differences.take(MAX_DIFFERENCES_PER_MODULE):
					differing += 1
					print(
						"difference ${path} | ${difference.declaration} | ${difference.path} | old=${difference.old_text} | new=${difference.new_text}",
					)
			ModuleSkipped(reason):
				skipped += 1
				print("skipped ${path} | ${reason}")
			ModuleNotRebuilt(message):
				not_rebuilt += 1
				print("adapter-error ${path} | ${message}")

		match comparisons.tree:
			TreePrefixCompared(names, comparison, completed_bodies, located):
				tree_names = names
				tree_counts = report_tree_prefix_comparison(path, tree_counts, comparison, completed_bodies)
				match stop_census:
					ReportStops:
						print_stop_census(path, located)
					OmitStops:
						void
			TreePrefixSkipped(reason):
				tree_counts = { tree_counts | skipped = tree_counts.skipped + 1 }
				print("tree-prefix-skipped ${path} | ${shortened(reason)}")
			TreePrefixError(stage, message):
				tree_counts = { tree_counts | errors = tree_counts.errors + 1 }
				print("tree-prefix-error ${path} | ${tree_prefix_error_stage_label(stage)} | ${shortened(message)}")

		match comparisons.module_tree:
			TreeModuleCompared(names, differences):
				module_names = names
				module_counts = report_tree_module_comparison(path, module_counts, differences)
			TreeModuleRejected(diagnostics):
				module_counts = { module_counts | rejected = module_counts.rejected + 1 }
				print("tree-module-rejected ${path} | ${diagnostics}")
			TreeModuleUnassembled(reason):
				module_counts = {
					module_counts |
					unassembled = module_counts.unassembled + 1,
					stops = count_tree_module_stop(module_counts.stops, reason)
				}
			TreeModuleSkipped(reason):
				module_counts = { module_counts | skipped = module_counts.skipped + 1 }
				print("tree-module-skipped ${path} | ${shortened(reason)}")
			TreeModuleError(stage, message):
				module_counts = { module_counts | errors = module_counts.errors + 1 }
				print("tree-module-error ${path} | ${tree_module_error_stage_label(stage)} | ${shortened(message)}")

	print_tree_prefix_summary(selected.length(), tree_counts)
	print_tree_module_summary(selected.length(), module_counts)
	print(
		"summary modules=${selected.length()} compared=${compared} skipped=${skipped} declarations=${declarations} differences=${differing}",
	)

	if not_rebuilt > 0 or tree_counts.errors > 0 or module_counts.errors > 0:
		EXIT_ADAPTER_ERROR
	else:
		0


func print_stop_census(path: String, located: Option[LocatedStop]) -> Void:
	match located:
		Some(stop):
			print("stop-reason ${path} | ${unread_kind_label(stop.unread.header)} | ${stop_reason_label(stop.unread.stop.reason)} | ${stop.line}")
		None:
			void


func report_tree_prefix_comparison(
	path: String, counts: TreePrefixCounts, comparison: DeclarationPrefixComparison, completed_bodies: CompletedBodyCounts,
) -> TreePrefixCounts:
	var kinds: TreePrefixKindCounts = counts.kinds
	for kind in comparison.declaration_kinds:
		kinds = count_tree_prefix_kind(kinds, kind)

	reported = comparison.differences.take(MAX_DIFFERENCES_PER_MODULE)
	for difference in reported:
		print("tree-prefix-difference ${path} | ${difference.declaration} | ${difference.path} | old=${difference.old_text} | new=${difference.new_text}")

	{ counts | compared = counts.compared + 1,
		declarations = counts.declarations + comparison.completed_declarations,
		completed = {
			functions = counts.completed.functions + completed_bodies.functions,
			traits = counts.completed.traits + completed_bodies.traits,
			implementations = counts.completed.implementations + completed_bodies.implementations
		},
		differences = counts.differences + comparison.differences.length(),
		reported = counts.reported + reported.length(),
		kinds = kinds, stops = count_tree_prefix_stop(counts.stops, comparison.stop) }


func print_tree_prefix_summary(modules: Int, counts: TreePrefixCounts) -> Void:
	print(
		"tree-prefix-summary modules=${modules} compared=${counts.compared} skipped=${counts.skipped} errors=${counts.errors} declarations=${counts.declarations} completed_functions=${counts.completed.functions} completed_traits=${counts.completed.traits} completed_implementations=${counts.completed.implementations} differences=${counts.differences} reported=${counts.reported} kind_import_block=${counts.kinds.import_block_modules} kind_foreign_block=${counts.kinds.foreign_block_modules} kind_record=${counts.kinds.record_modules} kind_fixed_record=${counts.kinds.fixed_record_modules} kind_alias=${counts.kinds.alias_modules} kind_builtin_type=${counts.kinds.builtin_type_modules} kind_resource_type=${counts.kinds.resource_type_modules} kind_union=${counts.kinds.union_modules} kind_fixed_union=${counts.kinds.fixed_union_modules} kind_function=${counts.kinds.function_modules} kind_trait=${counts.kinds.trait_modules} kind_implementation=${counts.kinds.implementation_modules} kind_constant_global=${counts.kinds.constant_global_modules} kind_mutable_global=${counts.kinds.mutable_global_modules} stop_end_of_source=${counts.stops.end_of_source_modules} stop_function_header=${counts.stops.function_header_modules} stop_trait_preview=${counts.stops.trait_preview_modules} stop_implementation_preview=${counts.stops.implementation_preview_modules} stop_global_initializer=${counts.stops.global_initializer_modules} stop_rejected_global_initializer=${counts.stops.rejected_global_initializer_modules} stop_rejected_declaration=${counts.stops.rejected_declaration_modules} stop_without_progress=${counts.stops.without_progress_modules}",
	)


func report_tree_module_comparison(path: String, counts: TreeModuleCounts, differences: List[JsonDifference]) -> TreeModuleCounts:
	reported = differences.take(MAX_DIFFERENCES_PER_MODULE)
	for difference in reported:
		print("tree-module-difference ${path} | ${difference.declaration} | ${difference.path} | old=${difference.old_text} | new=${difference.new_text}")

	{ counts | assembled = counts.assembled + 1, differences = counts.differences + differences.length(), reported = counts.reported + reported.length() }


func print_tree_module_summary(modules: Int, counts: TreeModuleCounts) -> Void:
	stops = counts.stops
	print(
		"tree-module-summary modules=${modules} assembled=${counts.assembled} rejected=${counts.rejected} unassembled=${counts.unassembled} skipped=${counts.skipped} errors=${counts.errors} differences=${counts.differences} reported=${counts.reported} stop_function_body=${stops.function_body} stop_trait_bodies=${stops.trait_bodies} stop_implementation_bodies=${stops.implementation_bodies} stop_global_initializer=${stops.global_initializer} stop_rejected_global_initializer=${stops.rejected_global_initializer} stop_rejected_declaration=${stops.rejected_declaration} stop_without_progress=${stops.without_progress}",
	)
