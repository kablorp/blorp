	../../../src/compiler/stage_09_core/synth_nodes: core_var
	test: TestSuite


-- What `CoreDeclarationIndex.copy_declarations` holds before mono records it.
NO_RECORDED_COPY_DECLARATIONS: CoreCopyDeclarations = {}


pure func no_recorded_declarations() -> CoreDeclarationIndex:
	core_empty_declaration_index()


pure func index_with_copies(copies: CoreCopyDeclarations) -> CoreDeclarationIndex:
	{ core_empty_declaration_index() | copy_declarations = copies }


SOURCE_ORIGIN: CoreDeclaredOrigin = SourceFunction(synthesized_name_id("_"))

INT_TYPE: CoreType = NamedType("Int", [])


pure func module_for(source_module: Option[String]) -> CoreModuleOrigin:
	match source_module:
		Some(path):
			fixture_source_module(path, UserModule)
		None:
			NoSourceModule


pure func source_origin_in(source_module: Option[String]) -> CoreFunctionOrigin:
	Declared(SourceFunction(synthesized_name_id("_")))


pure func function_in_module(
	name: String,
	source_module: Option[String],
	origin: CoreFunctionOrigin,
) -> CoreFunction:
	{
		name = name,
		source_module = source_module,
		module = module_for(source_module),
		type_params = [],
		params = [],
		return_type = INT_TYPE,
		body = None,
		is_pure = False,
		function_kind = UserFunction,
		origin = origin,
		def_id = 1,
		loc = synthetic_core_source_loc()
	}


pure func function_with(name: String, declared: CoreDeclaredOrigin) -> CoreFunction:
	function_in_module(name, None, Declared(declared))


pure func synthesized_function_with(name: String, origin: CoreFunctionOrigin) -> CoreFunction:
	function_in_module(name, None, origin)


pure func program_of(decls: List[CoreDecl]) -> CoreProgram:
	{
		decls = decls,
		foreign_includes = [],
		source_files = []
	}


pure func agreement_for(functions: List[CoreFunction]) -> OriginNameAgreement:
	origin_name_agreement(
		no_recorded_declarations(),
		fn_program(functions),
		CheckWithoutModuleTable,
	)


pure func string_contains_all(text: String, needles: List[String]) -> Bool:
	needles.all(pure func(needle: String) -> Bool: text.contains(needle))


pure func mono_origin() -> CoreDeclaredOrigin:
	MonoInstance(5, [("T", TypeSubstitution(INT_TYPE))])


pure func test_functions_whose_names_and_origins_agree_report_nothing() -> Bool:
	agreement = agreement_for([
		function_with("list__map", SOURCE_ORIGIN),
		function_with("list__map__mono_Int", mono_origin()),
		function_with("list__map__pure", PureVariant(5)),
		function_with(
			"_blorp_clambda_3",
			HoistedLambda(9, 3),
		),
		function_with(
			"_blorp_task_0",
			HoistedTask(9, 0),
		),
		function_with("_blorp_eta_2", EtaExpansion(5)),
		function_with("$blorp$program", Entrypoint(ProgramWrapperEntrypoint)),
		function_with("$blorp$user_main_12", Entrypoint(UserMainEntrypoint)),
	])

	agreement.checked == 8 and agreement.violations.is_empty()


pure func test_mono_named_function_with_source_origin_is_reported() -> Bool:
	agreement = agreement_for([function_with("list__map__mono_Int", SOURCE_ORIGIN)])

	match agreement.violations:
		[message]:
			string_contains_all(
				message,
				["list__map__mono_Int", "a mono instance", "origin is SourceFunction"],
			)
		_:
			False


pure func test_plain_named_function_with_mono_origin_is_reported() -> Bool:
	agreement = agreement_for([function_with("list__map", mono_origin())])

	match agreement.violations:
		[message]:
			string_contains_all(
				message,
				["a plain source or impl function", "MonoInstance"],
			)
		_:
			False


pure func test_pure_suffix_without_pure_variant_origin_is_reported() -> Bool:
	agreement = agreement_for([function_with("list__map__pure", SOURCE_ORIGIN)])

	agreement.violations.length() == 1


pure func test_hoisted_lambda_ordinal_must_match_the_name() -> Bool:
	agreement = agreement_for([
		function_with(
			"_blorp_clambda_4",
			HoistedLambda(9, 3),
		),
		function_with(
			"_blorp_task_1",
			HoistedTask(9, 1),
		),
	])

	match agreement.violations:
		[message]:
			string_contains_all(
				message,
				["_blorp_clambda_4", "a hoisted lambda"],
			)
		_:
			False


pure func test_entrypoint_names_require_matching_entrypoint_kind() -> Bool:
	agreement = agreement_for([
		function_with("$blorp$program", Entrypoint(UserMainEntrypoint)),
		function_with("$blorp$user_main_3", Entrypoint(ProgramWrapperEntrypoint)),
	])

	agreement.violations.length() == 2


pure func test_synthesized_function_is_judged_by_its_declared_origin() -> Bool:
	agreement = agreement_for([
		synthesized_function_with(
			"list__map__mono_Int",
			Synthesized(TensorSynthesis, mono_origin()),
		),
		synthesized_function_with(
			"list__length",
			Synthesized(TensorSynthesis, SOURCE_ORIGIN),
		),
		synthesized_function_with(
			"list__map",
			Synthesized(TensorSynthesis, mono_origin()),
		),
	])

	agreement.violations.length() == 1 and agreement.checked == 3


pure func test_member_named_mono_something_is_not_a_mono_instance() -> Bool:
	-- `src_compiler_synth_name__mono_name_base` is member `mono_name_base` of
	-- module `src/compiler/synth_name`: the marker sits inside the module prefix.
	agreement = agreement_for([
		function_in_module(
			"src_compiler_synth_name__mono_name_base",
			Some("src/compiler/synth_name"),
			source_origin_in(Some("src/compiler/synth_name")),
		),
		function_in_module(
			"src_compiler_synth_name__mono_name_base__mono_Int",
			Some("src/compiler/synth_name"),
			Declared(mono_origin()),
		),
	])

	agreement.violations.is_empty()


pure func impl_program(method_origin: CoreFunctionOrigin) -> CoreProgram:
	program_of([ImplDecl({
			trait_name = "Display",
			for_type = INT_TYPE,
			type_params = [],
			methods = [function_in_module("show", None, method_origin)],
			loc = synthetic_core_source_loc(),
		})])


pure func plain_impl_method_origin() -> CoreDeclaredOrigin:
	ImplMethod(synthesized_name_id("_"), synthesized_name_id("_"), OrdinaryImplMethod)


pure func projected_impl_method_origin() -> CoreDeclaredOrigin:
	ProjectedImplMethod(
		synthesized_name_id("_"),
		synthesized_name_id("_"),
		NamedType("_", []),
		OrdinaryImplMethod,
	)


pure func test_impl_methods_must_carry_an_impl_method_origin() -> Bool:
	good = origin_name_agreement(
		no_recorded_declarations(),
		impl_program(Declared(plain_impl_method_origin())),
		CheckWithoutModuleTable,
	)
	wrapped = origin_name_agreement(
		no_recorded_declarations(),
		impl_program(Synthesized(TensorSynthesis, plain_impl_method_origin())),
		CheckWithoutModuleTable,
	)
	projected = origin_name_agreement(
		no_recorded_declarations(),
		impl_program(Declared(projected_impl_method_origin())),
		CheckWithoutModuleTable,
	)
	bad = origin_name_agreement(
		no_recorded_declarations(),
		impl_program(Declared(SOURCE_ORIGIN)),
		CheckWithoutModuleTable,
	)

	(
		good.violations.is_empty()
		and wrapped.violations.is_empty()
		and projected.violations.is_empty()
		and bad.violations.length() == 1
	)


pure func test_trait_named_functions_are_projected_impl_methods() -> Bool:
	trait_decl: CoreDecl = TraitDecl({
		name = "Display",
		type_params = [],
		methods = [],
		loc = synthetic_core_source_loc(),
	})
	projected: CoreDecl = FunctionDecl(
		function_with(
			"Display_show_Int",
			plain_impl_method_origin(),
		),
	)
	misattributed: CoreDecl = FunctionDecl(function_with("Display_show_Bool", SOURCE_ORIGIN))

	projected_agreement = origin_name_agreement(
		no_recorded_declarations(),
		program_of([trait_decl, projected]),
		CheckWithoutModuleTable,
	)
	misattributed_agreement = origin_name_agreement(
		no_recorded_declarations(),
		program_of([trait_decl, misattributed]),
		CheckWithoutModuleTable,
	)

	projected_agreement.violations.is_empty() and misattributed_agreement.violations.length() == 1


pure func test_source_module_without_a_path_is_the_target_module() -> Bool:
	target_module: CoreFunction = function_in_module(
		"main",
		None,
		Declared(SourceFunction(synthesized_name_id("_"))),
	)
	target_module_function: CoreFunction = { target_module |
		module = fixture_source_module("main", UserModule)
	}

	agreement_for([target_module_function]).violations.is_empty()


pure func test_path_without_a_source_module_is_reported() -> Bool:
	function_info: CoreFunction = { function_in_module(
		"list__map",
		Some("list"),
		Declared(SourceFunction(synthesized_name_id("_"))),
	) |
		module = NoSourceModule
	}

	match agreement_for([function_info]).violations:
		[message]:
			message.contains("module origin NoSourceModule")
		_:
			False


pure func module_table_of(path: String, origin: ModuleOrigin) -> ModuleTable:
	(table, _) = singleton_module_table(resolved_module_identity_from_resolver(path, origin))
	table


pure func list_function_in(path: String, module: CoreModuleOrigin) -> CoreFunction:
	{ function_in_module("list__map", Some(path), Declared(SOURCE_ORIGIN)) | module = module }


pure func test_module_table_accepts_a_function_whose_path_and_origin_match() -> Bool:
	table: ModuleTable = module_table_of("list", StdlibModule)
	matching: CoreFunction = list_function_in(
		"list",
		fixture_source_module("list", StdlibModule),
	)

	origin_name_agreement(
		no_recorded_declarations(),
		fn_program([matching]),
		CheckAgainstModuleTable(table),
	).violations.is_empty()


pure func test_module_table_reports_a_path_the_module_id_does_not_name() -> Bool:
	table: ModuleTable = module_table_of("list", StdlibModule)
	wrong_path: CoreFunction = list_function_in(
		"elsewhere",
		fixture_source_module("list", StdlibModule),
	)

	match origin_name_agreement(
		no_recorded_declarations(),
		fn_program([wrong_path]),
		CheckAgainstModuleTable(table),
	).violations:
		[message]:
			message.contains("another path in the table")
		_:
			False


pure func test_module_table_reports_an_origin_the_table_does_not_give() -> Bool:
	table: ModuleTable = module_table_of("list", StdlibModule)
	wrong_origin: CoreFunction = list_function_in(
		"list",
		fixture_source_module("list", UserModule),
	)

	match origin_name_agreement(
		no_recorded_declarations(),
		fn_program([wrong_origin]),
		CheckAgainstModuleTable(table),
	).violations:
		[message]:
			message.contains("origin the table does not give")
		_:
			False


pure func test_late_passes_without_a_table_still_apply_the_path_rule_but_skip_table_rules() -> Bool:
	no_module_with_path: CoreFunction = list_function_in("list", NoSourceModule)
	path_the_id_does_not_name: CoreFunction = list_function_in(
		"elsewhere",
		fixture_source_module("list", StdlibModule),
	)

	path_rule_fires: Bool = origin_name_agreement(
		no_recorded_declarations(),
		fn_program([no_module_with_path]),
		CheckWithoutModuleTable,
	).violations.length() == 1
	table_rule_skipped: Bool = origin_name_agreement(
		no_recorded_declarations(),
		fn_program([path_the_id_does_not_name]),
		CheckWithoutModuleTable,
	).violations.is_empty()

	path_rule_fires and table_rule_skipped


pure func fn_program(functions: List[CoreFunction]) -> CoreProgram:
	program_of(functions.map(
		pure func(function: CoreFunction) -> CoreDecl: FunctionDecl(function),
	))


pure func test_native_tag_equality_origin_and_reserved_name_agree() -> Bool:
	target = UnionType("Choice", ScalarTagValue)
	loc = synthetic_core_source_loc()
	callback = { function_with(NATIVE_TAG_EQUALITY_CALLBACK_NAME, NativeTagEqualityCallback(target)) |
		params = [
			{ name = core_var("left"), typ = target, loc = loc },
			{ name = core_var("right"), typ = target, loc = loc },
		],
		return_type = NamedType("Bool", [])
	}
	(
		agreement_for(
			[callback],
		).violations.is_empty()
		and not agreement_for(
			[
				{ callback | origin = Declared(SOURCE_ORIGIN) },
			],
		).violations.is_empty()
		and not agreement_for([{ callback | name = "authored" }]).violations.is_empty()
	)


pure func test_summary_reports_totals_and_counts_per_origin_case() -> Bool:
	agreement = agreement_for([
		function_with("list__map", SOURCE_ORIGIN),
		function_with("list__filter", SOURCE_ORIGIN),
		function_with("list__map__mono_Int", mono_origin()),
		function_with("list__bad__mono_Int", SOURCE_ORIGIN),
	])

	origin_name_agreement_summary(agreement).starts_with((
			"4 functions, 1 disagree; SourceFunction=3 ImplMethod=0 PureVariant=0 "
			+ "MonoInstance=1"
		))


-- Once mono has recorded the copy declarations, a copy the index does not list has
-- no source declaration for any reader; the invariant says so.
pure func test_copy_missing_from_recorded_names_is_reported() -> Bool:
	copy: CoreFunction = function_with("list__map__mono_Int", mono_origin())
	recorded_other: CoreCopyDeclarations = NO_RECORDED_COPY_DECLARATIONS.set(
		copy.def_id + 1,
		SourceFunction(synthesized_name_id("map")),
	)
	recorded_copy: CoreCopyDeclarations = NO_RECORDED_COPY_DECLARATIONS.set(
		copy.def_id,
		SourceFunction(synthesized_name_id("map")),
	)
	program: CoreProgram = fn_program([copy])

	missing = origin_name_agreement(
		index_with_copies(recorded_other),
		program,
		CheckWithoutModuleTable,
	)
	listed = origin_name_agreement(
		index_with_copies(recorded_copy),
		program,
		CheckWithoutModuleTable,
	)
	before_mono = origin_name_agreement(
		no_recorded_declarations(),
		program,
		CheckWithoutModuleTable,
	)

	missing.violations.length() == 1 and string_contains_all(
		missing.violations
			.get(0)
			.get_or(""),
		["list__map__mono_Int", "no entry in the recorded copy declarations"],
	) and listed.violations.is_empty() and before_mono.violations.is_empty()


-- A name table with one spelling, standing for a compilation's table that does not
-- hold the ids the functions were minted with.
pure func index_with_names(names: NameTable) -> CoreDeclarationIndex:
	{ core_empty_declaration_index() | names = names }


-- Once the compilation's name table is recorded, a declared member that is not in
-- it would make `core_declared_member_spelling` answer None and synthesis, resolve
-- and std inlining skip the function without a word; the invariant reports it.
pure func test_declared_member_missing_from_the_name_table_is_reported() -> Bool:
	function_program: CoreProgram = fn_program([function_with("list__map", SOURCE_ORIGIN)])
	impl_method_program: CoreProgram = impl_program(Declared(plain_impl_method_origin()))
	other_table: NameTable = name_table_from_parts(["unrelated"], {"unrelated" => 0})

	function_unresolved = origin_name_agreement(
		index_with_names(other_table),
		function_program,
		CheckWithoutModuleTable,
	)
	method_unresolved = origin_name_agreement(
		index_with_names(other_table),
		impl_method_program,
		CheckWithoutModuleTable,
	)
	function_resolved = origin_name_agreement(
		index_with_names(SYNTHESIZED_NAME_TABLE),
		function_program,
		CheckWithoutModuleTable,
	)
	method_resolved = origin_name_agreement(
		index_with_names(SYNTHESIZED_NAME_TABLE),
		impl_method_program,
		CheckWithoutModuleTable,
	)
	before_mono = origin_name_agreement(
		no_recorded_declarations(),
		function_program,
		CheckWithoutModuleTable,
	)

	function_unresolved.violations.length() == 1 and string_contains_all(
		function_unresolved.violations
			.get(0)
			.get_or(""),
		["list__map", "not in the name table"],
	) and method_unresolved.violations.length() == 1 and string_contains_all(
		method_unresolved.violations
			.get(0)
			.get_or(""),
		["show", "not in the name table"],
	) and function_resolved.violations.is_empty() and method_resolved.violations.is_empty() and before_mono.violations.is_empty()


func test_native_tag_equality_rejects_non_scalar_and_mismatched_parameters() -> Bool:
	key_type = UnionType("TagKey", ScalarTagValue)
	base = function_with("__native_tag_equals", NativeTagEqualityCallback(key_type))
	-- Wrong arity and a non-scalar target cannot pass merely by display name.
	wrong_arity = agreement_for([base])
	wrong_target = agreement_for([function_with("__native_tag_equals", NativeTagEqualityCallback(INT_TYPE))])
	loc = synthetic_core_source_loc()
	wrong_parameter = agreement_for([{ base |
		params = [
			{ name = core_var("left"), typ = key_type, loc = loc },
			{ name = core_var("right"), typ = INT_TYPE, loc = loc },
		],
		return_type = NamedType("Bool", [])
	}])
	valid = { base |
		params = [
			{ name = core_var("left"), typ = key_type, loc = loc },
			{ name = core_var("right"), typ = key_type, loc = loc },
		],
		return_type = NamedType("Bool", [])
	}
	wrong_return = agreement_for([{ valid | return_type = INT_TYPE }])
	wrong_type_params = agreement_for([{ valid | type_params = ["T"] }])
	(
		agreement_for([valid]).violations.is_empty()
		and wrong_arity.violations.length() == 1
		and wrong_target.violations.length() == 1
		and wrong_arity.violations.get(0).get_or("").contains("scalar target and two parameters")
		and wrong_target.violations.get(0).get_or("").contains("scalar target and two parameters")
		and wrong_parameter.violations.length() == 1
		and wrong_parameter.violations.get(0).get_or("").contains("matching scalar parameters and Bool return")
		and wrong_return.violations.length() == 1
		and wrong_return.violations.get(0).get_or("").contains("matching scalar parameters and Bool return")
		and wrong_type_params.violations.length() == 1
		and wrong_type_params.violations.get(0).get_or("").contains("matching scalar parameters and Bool return")
	)


tests: TestSuite = {
	description = "Compiler Core origin and name agreement",
	tests = [
		("native tag equality rejects non-scalar and malformed parameters", test_native_tag_equality_rejects_non_scalar_and_mismatched_parameters),
		(
			"native tag equality origin matches reserved name",
			test_native_tag_equality_origin_and_reserved_name_agree,
		),
		(
			"declared member missing from the name table is reported",
			test_declared_member_missing_from_the_name_table_is_reported,
		),
		(
			"copy missing from the recorded names is reported",
			test_copy_missing_from_recorded_names_is_reported,
		),
		(
			"functions whose names and origins agree report nothing",
			test_functions_whose_names_and_origins_agree_report_nothing,
		),
		(
			"mono named function with source origin is reported",
			test_mono_named_function_with_source_origin_is_reported,
		),
		(
			"plain named function with mono origin is reported",
			test_plain_named_function_with_mono_origin_is_reported,
		),
		(
			"pure suffix without pure variant origin is reported",
			test_pure_suffix_without_pure_variant_origin_is_reported,
		),
		(
			"hoisted lambda ordinal must match the name",
			test_hoisted_lambda_ordinal_must_match_the_name,
		),
		(
			"entrypoint names require matching entrypoint kind",
			test_entrypoint_names_require_matching_entrypoint_kind,
		),
		(
			"synthesized function is judged by its declared origin",
			test_synthesized_function_is_judged_by_its_declared_origin,
		),
		(
			"member named mono something is not a mono instance",
			test_member_named_mono_something_is_not_a_mono_instance,
		),
		(
			"impl methods must carry an impl method origin",
			test_impl_methods_must_carry_an_impl_method_origin,
		),
		(
			"trait named functions are projected impl methods",
			test_trait_named_functions_are_projected_impl_methods,
		),
		(
			"source module without a path is the target module",
			test_source_module_without_a_path_is_the_target_module,
		),
		("path without a source module is reported", test_path_without_a_source_module_is_reported),
		(
			"module table accepts a function whose path and origin match",
			test_module_table_accepts_a_function_whose_path_and_origin_match,
		),
		(
			"module table reports a path the module id does not name",
			test_module_table_reports_a_path_the_module_id_does_not_name,
		),
		(
			"module table reports an origin the table does not give",
			test_module_table_reports_an_origin_the_table_does_not_give,
		),
		(
			"late passes without a table still apply the path rule but skip table rules",
			test_late_passes_without_a_table_still_apply_the_path_rule_but_skip_table_rules,
		),
		(
			"summary reports totals and counts per origin case",
			test_summary_reports_totals_and_counts_per_origin_case,
		),
	]
}
