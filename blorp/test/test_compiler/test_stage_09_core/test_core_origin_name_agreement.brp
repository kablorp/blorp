	../../../src/compiler/stage_09_core/function_origin_fixture: fixture_source_module
	../../../src/compiler/stage_09_core/hash_key_callbacks: NATIVE_TAG_EQUALITY_CALLBACK_NAME
	../../../src/compiler/stage_09_core/ir:
		CoreUnionValueStorage(ScalarTagValue, ManagedUnionValue),
		CoreCopyDeclarations,
		CoreDecl(FunctionDecl, ImplDecl, TraitDecl),
		CoreDeclarationIndex,
