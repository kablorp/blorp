import:
	../../../benchmark/compiler/compiler_core_call_resolve_profile_fixture:
		CompilerCoreCallResolveBenchmarkResult,
		CompilerCoreCallResolveProfileConfig,
		compiler_core_call_resolve_benchmark,
		compiler_core_call_resolve_benchmark_input,
		compiler_core_call_resolve_benchmark_with_input,
	memory: get_mem_stats, reset_mem_stats
	test: TestSuite


private INDEX_FIXTURE_MODULE_PATH_ORDER_CHECKSUM: Int = -708699917141736653

private pure func index_fixture_config() -> CompilerCoreCallResolveProfileConfig:
	{
		iterations = 1,
		function_count = 8,
		module_count = 2,
		constructors_per_type = 3,
		duplicate_id_interval = 4,
		imports_per_module = 2
	}


-- The fixture at `scale` times a base size, with the other dimensions scaled
-- alongside so only the problem size changes.
private pure func scaled_fixture_config(scale: Int) -> CompilerCoreCallResolveProfileConfig:
	{
		iterations = 1,
		function_count = 256 * scale,
		module_count = 16 * scale,
		constructors_per_type = 4,
		duplicate_id_interval = 32 * scale,
		imports_per_module = 4
	}


private func construction_allocations(config: CompilerCoreCallResolveProfileConfig) -> Int:
	input = compiler_core_call_resolve_benchmark_input(config)
	reset_mem_stats()
	result = compiler_core_call_resolve_benchmark_with_input(input)
	stats = get_mem_stats()

	if result.error_count == 0 and result.workload_valid:
		stats.total_allocations
	else:
		-1


private func test_call_resolve_fixture_builds_its_logical_indexes() -> Bool:
	result: CompilerCoreCallResolveBenchmarkResult = compiler_core_call_resolve_benchmark(
		index_fixture_config(),
	)
	observation = result.observation

	(
		result.error_count == 0
		and observation.module_path_order_checksum == INDEX_FIXTURE_MODULE_PATH_ORDER_CHECKSUM
		and result.workload_valid
	)


-- Doubling the problem size must not much more than double the allocations, so
-- a construction that went quadratic fails here without a tuned absolute bound.
private func test_call_resolve_construction_allocations_grow_linearly() -> Bool:
	half = construction_allocations(scaled_fixture_config(1))
	full = construction_allocations(scaled_fixture_config(2))

	half > 0 and full > 0 and full * 2 <= half * 5


tests: TestSuite = {
	description = "Compiler Core call-resolution profile benchmark",
	tests = [
		(
			"fixture builds its logical indexes",
			test_call_resolve_fixture_builds_its_logical_indexes,
		),
		(
			"construction allocations grow linearly",
			test_call_resolve_construction_allocations_grow_linearly,
		),
	]
}
