pure func projected_memory_intrinsic(
	name: String,
	arg_type: CoreType,
	result_type: CoreType,
) -> Option[String]:
	call: CoreExpr = builtin_call(name, [variable("value", arg_type)], result_type)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call))],
		foreign_includes = [],
		source_files = []
	}

	match projected_body(program):
		Some(CallExpr(IntrinsicCall(intrinsic), _, _, _, _)):
			Some(intrinsic)
		_:
			None


pure func projected_binary_memory_intrinsic(
	name: String,
	arg_type: CoreType,
	result_type: CoreType,
) -> Option[String]:
	call: CoreExpr = builtin_call(
		name,
		[variable("left", arg_type), variable("right", arg_type)],
		result_type,
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call))],
		foreign_includes = [],
		source_files = []
	}

	match projected_body(program):
		Some(CallExpr(IntrinsicCall(intrinsic), _, _, _, _)):
			Some(intrinsic)
		_:
			None


pure func test_projects_allocation_identity_by_storage() -> Bool:
	(
		projected_binary_memory_intrinsic(
			"blorp_same_object",
			named_type("String"),
			named_type("Bool"),
		) == Some("memory_same_object_heap")
		and projected_binary_memory_intrinsic(
			"blorp_same_object",
			named_type("Int"),
			named_type("Bool"),
		) == Some("memory_same_object_stack")
	)


pure func test_projects_memory_inspection_by_storage() -> Bool:
	(
		projected_memory_intrinsic(
			"blorp_is_unique",
			named_type("String"),
			named_type("Bool"),
		) == Some("memory_is_unique_heap")
		and projected_memory_intrinsic(
			"blorp_is_unique",
			named_type("Int"),
			named_type("Bool"),
		) == Some("memory_is_unique_stack")
		and projected_memory_intrinsic(
			"blorp_refcount",
			named_type("String"),
			named_type("Int"),
		) == Some("memory_refcount_heap")
		and projected_memory_intrinsic(
			"blorp_refcount",
			named_type("Int"),
			named_type("Int"),
		) == Some("memory_refcount_stack")
		and projected_memory_intrinsic(
			"blorp_size_of",
			named_type("String"),
			named_type("Int"),
		) == Some("memory_size_of_heap")
		and projected_memory_intrinsic(
			"blorp_size_of",
			named_type("Int"),
			named_type("Int"),
		) == Some("memory_size_of_stack")
	)


pure func test_preserves_semantic_and_unknown_calls() -> Bool:
	option_type: CoreType = NamedType("Option", [named_type("Int")])
	option_call: CoreExpr = builtin_call(
		"blorp_option_some",
		[variable("value", named_type("Int"))],
		option_type,
	)
	unknown_call: CoreExpr = builtin_call("blorp_not_a_runtime_call", [], VoidType)

	option_program: CoreProgram = {
		decls = [function_decl("main", 1, Some(option_call))],
		foreign_includes = [],
		source_files = []
	}
	unknown_program: CoreProgram = {
		decls = [function_decl("main", 1, Some(unknown_call))],
		foreign_includes = [],
		source_files = []
	}

	match (projected_body(option_program), projected_body(unknown_program)):
		(Some(CallExpr(BuiltinCall(option_name), _, _, _, _)), Some(CallExpr(BuiltinCall(unknown_name), _, _, _, _))):
			option_name == "blorp_option_some" and unknown_name == "blorp_not_a_runtime_call"
		_:
			False


