pure func test_projects_boxed_file_open_result() -> Bool:
	result_type: CoreType = BoxedResultType(named_type("FileReader"), UnionType("fs__IOError"))
	call: CoreExpr = builtin_call(
		"blorp_file_open_read_raw",
		[variable("path", named_type("String"))],
		result_type,
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call)), io_error_decl()],
		foreign_includes = [],
		source_files = []
	}

	match projected_body(program):
		Some(CallExpr(OperationResultCall(bridge), _, _, _, _)):
			layout_is_boxed: Bool = match bridge.result_layout_policy:
				BoxedResultOnlyPolicy(_):
					True
				_:
					False

			payload_is_handle: Bool = match bridge.success.runtime_payload:
				RuntimeField("handle"):
					True
				_:
					False

			(
				bridge.runtime_result_c_type == "blorp_FileOpenReaderResult"
				and bridge.temp_prefix == "file_open"
				and layout_is_boxed
				and payload_is_handle
				and bridge.error.other_constructor_def_id == 107
				and bridge.error.cases.length() == 8
			)
		_:
			False


---
The bridge spells its error constructors from their definition ids, so a
variant declared without an id makes the operation's metadata unavailable and
the builtin call stays unprojected.
---
pure func test_boxed_file_open_result_needs_error_variant_ids() -> Bool:
	result_type: CoreType = BoxedResultType(named_type("FileReader"), UnionType("IOError"))
	call: CoreExpr = builtin_call(
		"blorp_file_open_read_raw",
		[variable("path", named_type("String"))],
		result_type,
	)
	decl_without_ids: CoreDecl = UnionDecl({
		abi_type = None,
		name = "IOError",
		type_params = [],
		payload_storage = TypedUnionPayloadStorage,
		variants = ["NotFound", "PermissionDenied", "AlreadyExists", "InvalidInput", "Interrupted", "TimedOut", "Unsupported", "Other"]
			.map(func(name): { union_variant(name, 0) | def_id = None }),
		loc = synthetic_core_source_loc(),
	})
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call)), decl_without_ids],
		foreign_includes = [],
		source_files = []
	}

	match projected_body(program):
		Some(CallExpr(OperationResultCall(_), _, _, _, _)):
			False
		_:
			True


