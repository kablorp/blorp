pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = None,
		origin = AuthoredBinder
	}


pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, synthetic_core_source_loc())


pure func runtime_union_args_are_empty(args: List[CoreRuntimeUnionArg]) -> Bool:
	match args:
		[]:
			True
		_:
			False


pure func builtin_call(name: String, args: List[CoreExpr], result_type: CoreType) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		VoidExpr(VoidType, synthetic_core_source_loc()),
		args,
		result_type,
		synthetic_core_source_loc(),
	)


pure func intrinsic_call(name: String, args: List[CoreExpr], result_type: CoreType) -> CoreExpr:
	CallExpr(
		IntrinsicCall(name),
		VoidExpr(VoidType, synthetic_core_source_loc()),
		args,
		result_type,
		synthetic_core_source_loc(),
	)


pure func function_decl(name: String, def_id: Int, body: Option[CoreExpr]) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = None,
		type_params = [],
		params = [],
		return_type = named_type("Int"),
		body = body,
		is_pure = True,
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = UserFunction,
		def_id = def_id,
		loc = synthetic_core_source_loc(),
	})


---
A top-level function the way runtime projection leaves an impl method: named
by the (still produced) `Trait_method_TypeKey` spelling, and recording in its
origin which trait method on which type it implements and the role the backend
calls it back under.
---
pure func callback_decl(
	name: String,
	def_id: Int,
	for_type: CoreType,
	role: CoreRuntimeCallbackRole,
) -> CoreDecl:
	match function_decl(name, def_id, None):
		FunctionDecl(function):
			FunctionDecl({ function |
				origin = Declared(
					ProjectedImplMethod(
						synthesized_name_id("_"),
						synthesized_name_id("_"),
						for_type,
						RuntimeCallbackMethod(role),
					),
				)
			})
		other:
			other


pure func union_variant(name: String, tag: Int) -> CoreUnionVariant:
	{
		name = name,
		tag = tag,
		fields = [],
		def_id = Some(100 + tag)
	}


pure func union_decl(name: String, variant_names: List[String]) -> CoreDecl:
	var variants: List[CoreUnionVariant] = []
	var tag: Int = 0

	for variant_name in variant_names:
		variants = variants.append(union_variant(variant_name, tag))
		tag += 1

	UnionDecl({
		abi_type = None,
		name = name,
		type_params = [],
		payload_storage = TypedUnionPayloadStorage,
		variants = variants,
		loc = synthetic_core_source_loc(),
	})


COMPILER_STDIO_ERROR_CORE_NAME: String = "blorp_src_lsp_lsp_stdio_transport__CompilerStdioError"


