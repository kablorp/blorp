pure func project_string_intrinsic(name: String, args: List[CoreExpr]) -> Option[CoreExpr]:
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(intrinsic_call(name, args, VoidType)))],
		foreign_includes = [],
		source_files = []
	}
	projected_body(program)


pure func test_projects_string_storage_intrinsics() -> Bool:
	string_value: CoreExpr = variable("text", named_type("String"))
	index: CoreExpr = variable("index", named_type("Int"))
	byte: CoreExpr = variable("byte", named_type("UInt8"))

	read_projected: Bool = match (
		project_string_intrinsic(
			"string_get_byte",
			[string_value, index],
		)
	):
		Some(StringByteReadExpr(_, _, _)):
			True
		_:
			False

	write_projected: Bool = match (
		project_string_intrinsic(
			"string_set_byte",
			[string_value, index, byte],
		)
	):
		Some(StringByteWriteExpr(_, _, _)):
			True
		_:
			False

	copy_projected: Bool = match (
		project_string_intrinsic(
			"string_copy_bytes",
			[string_value, index, string_value, index, index],
		)
	):
		Some(StringByteCopyExpr(_, _, _)):
			True
		_:
			False

	set_len_projected: Bool = match (
		project_string_intrinsic(
			"string_set_len",
			[string_value, index],
		)
	):
		Some(StringSetLenExpr(_, _, _)):
			True
		_:
			False

	read_projected and write_projected and copy_projected and set_len_projected


pure func test_storage_projection_rejects_wrong_arity() -> Bool:
	program: CoreProgram = {
		decls = [
			function_decl(
				"main",
				1,
				Some(intrinsic_call("list_get_unchecked", [], named_type("Int"))),
			),
		],
		foreign_includes = [],
		source_files = []
	}

	match projected_body(program):
		Some(CallExpr(IntrinsicCall("list_get_unchecked"), _, [], _, _)):
			True
		_:
			False


