		list_type,
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call))],
		foreign_includes = [],
		source_files = []
	}

	match projected_body(program):
		Some(CallExpr(DirectRuntimeCall(runtime), _, _, _, _)):
			match runtime.args:
				DirectRuntimeArgsAppendListParallelLayout(metadata):
					match metadata.layout:
						InlineListStorage(width_bytes):
							metadata.semantic_arity == 3 and width_bytes == 8
						_:
							False
				_:
					False
		_:
			False


