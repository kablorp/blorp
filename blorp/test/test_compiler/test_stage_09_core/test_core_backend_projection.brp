pure func test_projects_list_retain_pointer_ownership() -> Bool:
	list_type: CoreType = NamedType("List", [named_type("Ptr")])
	call: CoreExpr = intrinsic_call(
		"list_retain_for",
		[variable("items", list_type), variable("value", named_type("Ptr"))],
		VoidType,
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call))],
		foreign_includes = [],
		source_files = []
	}

	match projected_body(program):
		Some(ListRetainExpr(retain, VoidType, _)):
			kind_is_pointer: Bool = match retain.value.kind:
				PointerBox:
					True
				_:
					False

			kind_is_pointer and retain.value.needs_release and not retain.value.transfers_ownership
		_:
			False


