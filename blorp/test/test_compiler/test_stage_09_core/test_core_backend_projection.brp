		("projects memory inspection by storage", test_projects_memory_inspection_by_storage),
		("projects allocation identity by storage", test_projects_allocation_identity_by_storage),
		("preserves semantic and unknown calls", test_preserves_semantic_and_unknown_calls),
		("projects list string callback", test_projects_list_string_callback),
		("projects custom dict constructor", test_projects_custom_dict_constructor),
		("callback lookup reads origin not spelling", test_callback_lookup_reads_origin_not_spelling),
		(
			"functions spelled like callbacks without the origin are not callbacks",
			test_functions_spelled_like_callbacks_without_the_origin_are_not_callbacks,
		),
		("projects empty custom dict constructor", test_projects_empty_custom_dict_constructor),
		("projects empty custom set constructor", test_projects_empty_custom_set_constructor),
		(
			"projects empty option-keyed set as trait hashed",
			test_projects_empty_option_keyed_set_as_trait_hashed,
		),
		(
			"leaves pointer key without adapters unbound",
			test_leaves_pointer_key_without_adapters_unbound,
		),
		("lowers trait-keyed dict literal with adapters", test_lowers_trait_keyed_dict_literal_with_adapters),
		(
			"leaves word-keyed dict literal for ownership pass",
			test_leaves_word_keyed_dict_literal_for_ownership_pass,
		),
		("projects singleton constructor value", test_projects_singleton_constructor_value),
		(
			"projects global singleton constructor value",
			test_projects_global_singleton_constructor_value,
		),
		("constructor index does not match a variant of the other parent kind", test_constructor_index_does_not_match_variant_of_other_parent_kind),
		(
