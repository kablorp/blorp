pure func pointer_slot_call(slot_count: Int) -> CoreExpr:
	slot: CoreExpr = UnboxExpr(
		PointerUnbox,
		variable("slot", named_type("Ptr")),
		UnionType("Key"),
		synthetic_core_source_loc(),
	)
	args: List[CoreExpr] = if slot_count == 1:
		[slot]
	else:
		[slot, slot]
	builtin_call("impl", args, named_type("Int"))


---
A slot adapter the way `hash_key_callbacks` mints one: identified by its
origin, whose payload is the impl method it calls.
---
pure func slot_adapter_decl(def_id: Int, impl_def: Int, slot_count: Int) -> CoreDecl:
	match function_decl("adapter", def_id, Some(pointer_slot_call(slot_count))):
		FunctionDecl(function):
			FunctionDecl({ function | origin = Declared(HashKeySlotAdapter(impl_def)) })
		other:
			other


--- An impl method taking `param_count` keys, as the adapter table reads it.
pure func key_callback_decl(
	def_id: Int,
	role: CoreRuntimeCallbackRole,
	param_count: Int,
) -> CoreDecl:
	key_type: CoreType = UnionType("Key")
	key_param: CoreParam = {
		name = core_var("key"),
		typ = key_type,
		loc = synthetic_core_source_loc()
	}

	match callback_decl("key_callback", def_id, key_type, role):
		FunctionDecl(function):
			FunctionDecl({ function | params = repeat(key_param, param_count) })
		other:
			other


--- Key's hash and equals impls (defs 2 and 3) and their slot adapters (4 and 5).
pure func key_adapter_decls() -> List[CoreDecl]:
	[
		key_callback_decl(2, HashableHashCallback, 1),
		key_callback_decl(3, EquatableEqualsCallback, 2),
		slot_adapter_decl(4, 2, 1),
		slot_adapter_decl(5, 3, 2),
	]


pure func binds_key_adapters(constructor: CoreHashContainerConstructor) -> Bool:
	match constructor:
		CustomHashContainerConstructor(hash_fn, equals_fn, needs_release):
			hash_fn == 4 and equals_fn == 5 and needs_release
		_:
			False


pure func test_projects_custom_dict_constructor() -> Bool:
	key_type: CoreType = UnionType("Key")
	dict_type: CoreType = NamedType(
		"Dict",
		[key_type, named_type("Int")],
	)
	call: CoreExpr = builtin_call(
		"blorp_dict_with_capacity_custom",
		[variable("capacity", named_type("Int"))],
		dict_type,
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call))].concat(key_adapter_decls()),
		foreign_includes = [],
		source_files = []
	}

	match projected_body(program):
		Some(CallExpr(DictWithCapacityCall(constructor), _, _, _, _)):
			binds_key_adapters(constructor)
		_:
			False


pure func test_callback_lookup_reads_origin_not_spelling() -> Bool:
	-- The functions are spelled nothing like `Hashable_hash_Key`; only their
	-- origins say they are Key's hash and equals.
	key_type: CoreType = UnionType("Key")
	dict_type: CoreType = NamedType("Dict", [key_type, named_type("Int")])
	call: CoreExpr = builtin_call("blorp_dict_new_custom", [], dict_type)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call))].concat(key_adapter_decls()),
		foreign_includes = [],
		source_files = []
	}

	match projected_body(program):
		Some(DictConstructExpr(construct, _, _)):
			binds_key_adapters(construct.constructor)
		_:
			False


pure func test_functions_spelled_like_callbacks_without_the_origin_are_not_callbacks() -> Bool:
	key_type: CoreType = UnionType("Key")
	dict_type: CoreType = NamedType("Dict", [key_type, named_type("Int")])
	call: CoreExpr = builtin_call("blorp_dict_new_custom", [], dict_type)
	program: CoreProgram = {
		decls = [
			function_decl("main", 1, Some(call)),
			function_decl("pkg__Hashable_hash_Key", 2, None),
			function_decl("pkg__Equatable_equals_Key", 3, None),
		],
		foreign_includes = [],
		source_files = []
	}

	match projected_body(program):
		Some(DictConstructExpr(construct, _, _)):
			match construct.constructor:
				CustomHashContainerConstructor(_, _, _):
					False
				_:
					True
		_:
			False


pure func test_projects_empty_custom_dict_constructor() -> Bool:
	key_type: CoreType = UnionType("Key")
	dict_type: CoreType = NamedType(
		"Dict",
		[key_type, named_type("Int")],
	)
	call: CoreExpr = builtin_call("blorp_dict_new_custom", [], dict_type)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call))].concat(key_adapter_decls()),
		foreign_includes = [],
		source_files = []
	}

	match projected_body(program):
		Some(DictConstructExpr(construct, _, _)):
			(
				binds_key_adapters(construct.constructor)
				and construct.entries.is_empty()
				and not construct.value_needs_release
			)
		_:
			False


