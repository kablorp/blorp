					signal_arg_is_typed: Bool = match signaled.args:
						[RuntimeTypedIntField("code")]:
							True
						_:
							False

					(
						bridge.runtime_result_c_type == "blorp_ProcessSessionStateResult"
						and bridge.success.release_mask == 1
