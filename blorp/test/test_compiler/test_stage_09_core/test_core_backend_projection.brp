---
Core spells a declared type with its flattened `module__Type` name; neither the
bare name nor the typechecker's `module::Type` spelling reaches operation
projection, so only the flattened canonical LSP transport name projects.
---
pure func test_projects_only_canonical_compiler_stdio_results() -> Bool:
	(
		projects_compiler_stdio_error_name(COMPILER_STDIO_ERROR_CORE_NAME)
		and not projects_compiler_stdio_error_name("CompilerStdioError")
		and not projects_compiler_stdio_error_name(
			"blorp/src/lsp/lsp_stdio_transport::CompilerStdioError",
		)
		and not projects_compiler_stdio_error_name(
			"compiler_blorp_lsp_lsp_stdio_transport__CompilerStdioError",
		)
		and not projects_compiler_stdio_error_name(
			"compiler_src_stage_12_lsp_lsp_stdio_transport__CompilerStdioError",
		)
		and not projects_compiler_stdio_error_name(
			"compiler_blorp_src_stage_12_lsp_lsp_stdio_transport__CompilerStdioError",
		)
		and not projects_compiler_stdio_error_name(
			"blorp_src_compiler_stage_12_lsp_lsp_stdio_transport__CompilerStdioError",
		)
		and not projects_compiler_stdin_outcome_name("CompilerStdinRawOutcome")
		and not projects_compiler_stdin_outcome_name(
			"blorp/src/lsp/lsp_stdio_transport::CompilerStdinRawOutcome",
		)
		and projects_compiler_stdin_outcome_name(
			"blorp_src_lsp_lsp_stdio_transport__CompilerStdinRawOutcome",
		)
		and not projects_compiler_stdin_outcome_name(
			"compiler_blorp_src_stage_12_lsp_lsp_stdio_transport__CompilerStdinRawOutcome",
		)
	)


