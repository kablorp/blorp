pure func test_projects_singleton_constructor_value() -> Bool:
	status_type: CoreType = EnumType("Status")
	program: CoreProgram = {
		decls = [
			function_decl(
				"main",
				1,
				Some(
					VarExpr(
						{
							name = "Ready",
							id = 0,
							def_id = Some(2),
							origin = AuthoredBinder
						},
						status_type,
						synthetic_core_source_loc(),
					),
				),
			),
			EnumDecl({
				abi_type = None,
				name = "Status",
				type_params = [],
				variants = [
					{
						name = "Ready",
						tag = 0,
						def_id = Some(2)
					},
				],
				loc = synthetic_core_source_loc(),
			}),
		],
		foreign_includes = [],
		source_files = []
	}

	match projected_body(program):
		Some(VarExpr(variable, EnumType("Status"), _)):
			variable.name == variant_constructor_symbol(2)
		_:
			False


pure func test_projects_global_singleton_constructor_value() -> Bool:
	status_type: CoreType = EnumType("Status")
	program: CoreProgram = {
		decls = [
			GlobalDecl({
				name = {
					name = "status",
					id = 0,
					def_id = Some(1),
					origin = AuthoredBinder
				},
				source_module = None,
				typ = status_type,
				init = VarExpr(
					{
						name = "Ready",
						id = 0,
						def_id = Some(2),
						origin = AuthoredBinder
					},
					status_type,
					synthetic_core_source_loc(),
				),
				is_mutable = False,
				is_const = True,
				is_private = False,
				def_id = 1,
				loc = synthetic_core_source_loc(),
			}),
			EnumDecl({
				abi_type = None,
				name = "Status",
				type_params = [],
				variants = [
					{
						name = "Ready",
						tag = 0,
						def_id = Some(2)
					},
				],
				loc = synthetic_core_source_loc(),
			}),
		],
		foreign_includes = [],
		source_files = []
	}

	match project_backend_calls(program).decls:
		[GlobalDecl(global), ..._]:
			match global.init:
				VarExpr(variable, EnumType("Status"), _):
					variable.name == variant_constructor_symbol(2)
				_:
					False
		_:
			False


private pure func constructor_kind_collision_program(typ: CoreType) -> CoreProgram:
	{
		decls = [
			function_decl(
				"main",
				1,
				Some(
					VarExpr(
						{
							name = "Ready",
							id = 0,
							def_id = Some(2),
							origin = AuthoredBinder
						},
						typ,
						synthetic_core_source_loc(),
					),
				),
			),
			UnionDecl({
				abi_type = None,
				name = "Status",
				type_params = [],
				payload_storage = TypedUnionPayloadStorage,
				variants = [
					{
						name = "Ready",
						tag = 0,
						fields = [],
						def_id = Some(3)
					},
				],
				loc = synthetic_core_source_loc(),
			}),
			EnumDecl({
				abi_type = None,
				name = "Status",
				type_params = [],
				variants = [
					{
						name = "Ready",
						tag = 0,
						def_id = Some(2)
					},
				],
				loc = synthetic_core_source_loc(),
			}),
		],
		foreign_includes = [],
		source_files = []
	}


pure func test_constructor_index_does_not_match_variant_of_other_parent_kind() -> Bool:
	match (
		projected_body(constructor_kind_collision_program(EnumType("Status"))),
		projected_body(constructor_kind_collision_program(UnionType("Status"))),
	):
		(Some(VarExpr(enum_var, _, _)), Some(VarExpr(union_var, _, _))):
			enum_var.name == variant_constructor_symbol(2) and union_var.name == "Ready"
		_:
			False


