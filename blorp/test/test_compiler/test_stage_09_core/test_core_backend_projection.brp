						and running.runtime_tag == "BLORP_PROCESS_SESSION_STATE_RUNNING"
						and running.constructor_name == "SessionRunning"
						and running.constructor_def_id == 100
						and runtime_union_args_are_empty(running.args)
						and exited.runtime_tag == "BLORP_PROCESS_SESSION_STATE_EXITED"
						and exited.constructor_name == "SessionExited"
						and exited.constructor_def_id == 101
						and exit_arg_is_typed
						and signaled.runtime_tag == "BLORP_PROCESS_SESSION_STATE_SIGNALED"
						and signaled.constructor_name == "SessionSignaled"
						and signaled.constructor_def_id == 102
						and signal_arg_is_typed
						and timed_out.runtime_tag == "BLORP_PROCESS_SESSION_STATE_TIMED_OUT"
						and timed_out.constructor_name == "SessionTimedOut"
						and timed_out.constructor_def_id == 103
						and runtime_union_args_are_empty(timed_out.args)
