pure func test_lowers_trait_keyed_dict_literal_with_adapters() -> Bool:
	key_type: CoreType = UnionType("Key")
	dict_type: CoreType = NamedType("Dict", [key_type, named_type("Int")])
	literal: CoreExpr = DictExpr(
		[
			{
				key = variable("key", key_type),
				value = variable("value", named_type("Int"))
			},
		],
		dict_type,
		synthetic_core_source_loc(),
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(literal))].concat(key_adapter_decls()),
		foreign_includes = [],
		source_files = []
	}

	match projected_body(program):
		Some(DictConstructExpr(construct, _, _)):
			binds_key_adapters(construct.constructor) and construct.entries.length() == 1
		_:
			False


