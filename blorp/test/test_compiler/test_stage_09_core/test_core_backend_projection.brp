pure func test_projects_unchecked_list_get() -> Bool:
	element_type: CoreType = UnionType("Node")
	list_type: CoreType = NamedType("List", [element_type])
	call: CoreExpr = intrinsic_call(
		"list_get_unchecked",
		[variable("items", list_type), variable("index", named_type("Int"))],
		element_type,
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call))],
		foreign_includes = [],
		source_files = []
	}

	match projected_body(program):
		Some(ListGetExpr(get, UnionType("Node"), _)):
			layout_is_pointer: Bool = match get.layout:
				PointerListStorage:
					True
				_:
					False

			bounds_are_proven: Bool = match get.bounds:
				ProvenListAccess:
					True
				_:
					False

			layout_is_pointer and bounds_are_proven
		_:
			False


pure func test_projects_parallel_list_alloc() -> Bool:
	element_type: CoreType = EnumType("Bool")
	parallel_list_type: CoreType = NamedType("ParallelList", [element_type])
	call: CoreExpr = intrinsic_call(
		"list_alloc",
		[variable("capacity", named_type("Int"))],
		parallel_list_type,
	)
	program: CoreProgram = {
		decls = [
			function_decl("main", 1, Some(call)),
			EnumDecl({
				abi_type = None,
				name = "Bool",
				type_params = [],
				variants = [
					{
						name = "True",
						tag = 0,
						def_id = Some(2)
					},
					{
						name = "False",
						tag = 1,
						def_id = Some(3)
					},
				],
				loc = synthetic_core_source_loc(),
			}),
		],
		foreign_includes = [],
		source_files = []
	}

	match projected_body(program):
		Some(ListAllocExpr(alloc, _, _)):
			match alloc.layout:
				InlineListStorage(width):
					width == 1 and not alloc.elem_needs_release
				_:
					False
		_:
			False


pure func test_projects_list_parallel_metadata_as_typed_layout() -> Bool:
	list_type: CoreType = NamedType("List", [named_type("Int")])
