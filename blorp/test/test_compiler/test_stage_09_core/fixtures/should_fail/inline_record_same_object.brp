-- EXPECT: :17:8: error[inline_record_identity]: `same_object` compares managed objects; `Point` is a fixed record stored inline
-- EXPECT-HELP: help: Compare values with `==`; an inline record is a value with no object identity.
-- An inline fixed record is a value: it has no object identity to compare.
import:
	memory: same_object


fixed record Point {
	x: Float,
	y: Float
}


func main(args: List[String]) -> Int:
	p: Point = {x = 1.0, y = 2.0}
	q: Point = p
	if same_object(p, q):
		1
	else:
		0
