-- EXPECT: :14:5: error[inline_record_identity]: `refcount` reads a managed object's reference count; `Pair__mono_Int` is a fixed record stored inline
-- EXPECT-HELP: help: An inline record is copied by value and has no reference count; remove the check, or declare it as `record` if it must be a shared object.
-- Representation is decided per instantiation, so the `refcount` call in the
-- generic body is rejected for the instance whose argument is inline. The error
-- points into the generic body, not at `owners(pair)` (DIAGNOSTIC_GAPS DG-054).
import:
	memory: refcount


fixed record Pair[T] {first: T, second: T}


pure func owners[T](value: T) -> Int:
	refcount(value)


func main(args: List[String]) -> Int:
	pair: Pair[Int] = {first = 1, second = 2}
	owners(pair)
