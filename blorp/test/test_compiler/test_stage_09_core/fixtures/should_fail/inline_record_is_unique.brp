-- EXPECT: :16:8: error[inline_record_identity]: `is_unique` reads a managed object's reference count; `Point` is a fixed record stored inline
-- EXPECT-HELP: help: An inline record is copied by value and has no reference count; remove the check, or declare it as `record` if it must be a shared object.
-- An inline fixed record has no reference count, so it is never unique or shared.
import:
	memory: is_unique


fixed record Point {
	x: Float,
	y: Float
}


func main(args: List[String]) -> Int:
	p: Point = {x = 1.0, y = 2.0}
	if is_unique(p):
		1
	else:
		0
