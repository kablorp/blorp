import:
	../../../benchmark/compiler/compiler_managed_type_index_profile_fixture:
		compiler_managed_type_index_profile_benchmark,
		compiler_managed_type_index_profile_fixture,
		compiler_managed_type_index_profile_index,
		compiler_managed_type_index_profile_indexed_queries,
		compiler_managed_type_index_profile_legacy_names,
		compiler_managed_type_index_profile_legacy_queries,
	../../../src/compiler/stage_09_core/ir:
		CoreDecl(UnionDecl),
		CoreType(NamedType, UnionType),
		CoreUnionStorage(ScalarTagStorage),
		CoreUnionValueStorage(ScalarTagValue),
		synthetic_core_source_loc,
	test: TestSuite


pure func test_managed_type_index_profile_agrees_with_expected_classifications() -> Bool:
	result = compiler_managed_type_index_profile_benchmark({
		managed_count = 4,
		queries_per_name = 2,
		hit_ratio_percent = 50,
		nesting_depth = 4,
	})

	(
		result.legacy_successful_classifications == result.expected_successful_classifications
		and result.indexed_successful_classifications == result.expected_successful_classifications
		and result.legacy_checksum == result.indexed_checksum
		and result.workload_valid
	)


pure func test_managed_type_index_profile_scales_queries_per_name() -> Bool:
	result = compiler_managed_type_index_profile_benchmark({
		managed_count = 3,
		queries_per_name = 5,
		hit_ratio_percent = 0,
		nesting_depth = 1,
	})

	(
		result.hit_count == 0
		and result.legacy_successful_classifications == result.expected_successful_classifications
		and result.indexed_successful_classifications == result.expected_successful_classifications
		and result.legacy_checksum == result.indexed_checksum
		and result.workload_valid
	)


pure func test_managed_type_index_profile_normalizes_invalid_config() -> Bool:
	fixture = compiler_managed_type_index_profile_fixture({
		managed_count = 0,
		queries_per_name = 0,
		hit_ratio_percent = 120,
		nesting_depth = 0,
	})

	(
		fixture.config.managed_count == 1
		and fixture.config.queries_per_name == 1
		and fixture.config.hit_ratio_percent == 100
		and fixture.config.nesting_depth == 1
		and fixture.hit_count == 1
	)


pure func test_profile_reference_excludes_scalar_union_declarations() -> Bool:
	base = compiler_managed_type_index_profile_fixture({
		managed_count = 1,
		queries_per_name = 1,
		hit_ratio_percent = 0,
		nesting_depth = 1,
	})
	fixture = { base |
		program = { base.program | decls = base.program.decls.append(UnionDecl({
			abi_type = None,
			name = "ScalarChoice",
			type_params = [],
			storage = ScalarTagStorage,
			variants = [{ name = "First", tag = 0, fields = [], def_id = Some(220) }],
			loc = synthetic_core_source_loc(),
		})) },
		query_types = [NamedType("ScalarChoice", []), UnionType("ScalarChoice", ScalarTagValue)],
		query_type_count = 2,
		query_count = 2,
		hit_count = 0,
		expected_successful_classifications = 0,
	}
	names = compiler_managed_type_index_profile_legacy_names(fixture)
	legacy = compiler_managed_type_index_profile_legacy_queries(names, fixture)
	indexed = compiler_managed_type_index_profile_indexed_queries(
		compiler_managed_type_index_profile_index(fixture), fixture,
	)
	(
		not names.contains("ScalarChoice")
		and legacy.successful_classifications == 0 and indexed.successful_classifications == 0
		and legacy.query_count == 2 and indexed.query_count == 2
		and legacy.checksum == indexed.checksum
	)


tests: TestSuite = {
	description = "Compiler managed type index profile benchmark",
	tests = [
		("profile reference excludes scalar union declarations", test_profile_reference_excludes_scalar_union_declarations),
		(
			"managed type index profile agrees with expected classifications",
			test_managed_type_index_profile_agrees_with_expected_classifications,
		),
		(
			"managed type index profile scales queries per name",
			test_managed_type_index_profile_scales_queries_per_name,
		),
		(
			"managed type index profile normalizes invalid config",
			test_managed_type_index_profile_normalizes_invalid_config,
		),
	]
}
