import:
	../../../src/compiler/stage_09_core/c_type_layout:
		c_type_name,
		type_requires_release,
		boxed_value_needs_release_type,
		dict_value_needs_release_type,
	../../../src/compiler/stage_06_typecheck/type_system/language_surface_manifest:
		NativeManagedBuiltin(NativeIpAddress, NativeDnsName, NativeInterfaceScope),
		native_managed_builtin_canonical_name,
	../../../src/compiler/stage_09_core/ir:
		core_native_managed_identity,
		CoreUnionStorage(ScalarTagStorage, ManagedPayloadStorage),
		CoreUnionValueStorage(ScalarTagValue, ManagedUnionValue),
		CoreDecl(UnionDecl, HeapRecordDecl),
		CoreRecordForm(OrdinaryRecordForm),
		CoreProgram,
		CoreReleasePolicy(ArcReleasePolicy, ArcReleaseOnlyPolicy),
		synthetic_core_source_loc,
		CoreTensorDim(TensorStaticDim),
		CoreType(InlineRecordType, BoxedResultType, UnionType, FunctionType, HeapRecordType, NativeManagedType, NamedType, RangeType, SelfType, StackResultType, TensorType, TupleType, TypeParameterType, VoidType),
		CoreUnionDecl,
		CoreUnionPayloadStorage(TypedUnionPayloadStorage),
	../../../src/compiler/stage_09_core/type_policy:
		bool_type_is,
		CORE_MANAGED_TYPE_NAMES,
		cleanup_release_policy_for_type,
		core_type_requires_ownership,
		ManagedTypeIndex,
		is_managed_type,
		is_core_one_shot_stream_type_name,
		is_core_resource_source_type_name,
		managed_type_index,
		nullable_managed_option_payload_release_policy,
	io: print_error
	test: TestSuite


record ManagedTypeCase {
	label: String,
	typ: CoreType,
	expected: Bool
}


private pure func int_type() -> CoreType:
	NamedType("Int", [])


private pure func string_type() -> CoreType:
	NamedType("String", [])


private pure func bool_type() -> CoreType:
	NamedType("Bool", [])


private pure func managed_decl_program() -> CoreProgram:
	{
		decls = [HeapRecordDecl({
				abi_type = None,
				form = OrdinaryRecordForm,
				name = "Box",
				type_params = [],
				fields = [],
				loc = synthetic_core_source_loc(),
			}), HeapRecordDecl({
				abi_type = None,
				form = OrdinaryRecordForm,
				name = "Box",
				type_params = [],
				fields = [],
				loc = synthetic_core_source_loc(),
			}), UnionDecl({
				abi_type = None,
				name = "Choice",
				type_params = [],
				storage = ManagedPayloadStorage(TypedUnionPayloadStorage),
				variants = [],
				loc = synthetic_core_source_loc(),
			}), UnionDecl({
				abi_type = None,
				name = "Choice",
				type_params = [],
				storage = ManagedPayloadStorage(TypedUnionPayloadStorage),
				variants = [],
				loc = synthetic_core_source_loc(),
			}), HeapRecordDecl({
				abi_type = None,
				form = OrdinaryRecordForm,
				name = "Pair",
				type_params = [],
				fields = [],
				loc = synthetic_core_source_loc(),
			}), UnionDecl({
				abi_type = None,
				storage = ScalarTagStorage,
				name = "Color",
				type_params = [],
				variants = [],
				loc = synthetic_core_source_loc(),
			})],
		foreign_includes = [],
		source_files = []
	}


private pure func legacy_is_managed_type(managed_names: List[String], typ: CoreType) -> Bool:
	match typ:
		NativeManagedType(_):
			-- The historical comparison matrix excludes this new witnessed leaf.
			False
		NamedType("Option", [payload_type]):
			match payload_type:
				NamedType("Option", _):
					True
				StackResultType(_, _):
					True
				BoxedResultType(_, _):
					True
				_:
					legacy_is_managed_type(managed_names, payload_type)
		NamedType(name, _):
			(
				managed_names.contains(name)
				or is_core_one_shot_stream_type_name(name)
				or is_core_resource_source_type_name(name)
			)
		TypeParameterType(_) | SelfType:
			False
		HeapRecordType(_) | UnionType(_, ManagedUnionValue) | BoxedResultType(_, _):
			True
		FunctionType(_, _, _) | TupleType(_) | TensorType(_):
			True
		InlineRecordType(_):
			False
		StackResultType(ok_type, err_type):
			(
				legacy_is_managed_type(managed_names, ok_type)
				or legacy_is_managed_type(managed_names, err_type)
			)
		VoidType | UnionType(_, ScalarTagValue) | RangeType:
			False


private pure func managed_type_cases() -> List[ManagedTypeCase]:
	[
		{
			label = "named builtin managed",
			typ = string_type(),
			expected = True
		},
		{
			label = "named scalar unmanaged",
			typ = int_type(),
			expected = False
		},
		{
			label = "named heap declaration",
			typ = NamedType("Box", []),
			expected = True
		},
		{
			label = "named union declaration",
			typ = NamedType("Choice", []),
			expected = True
		},
		{
			label = "named managed product declaration",
			typ = NamedType("Pair", []),
			expected = True
		},
		{
			label = "named scalar union declaration",
			typ = NamedType("Color", []),
			expected = False
		},
		{
			label = "one-shot stream name",
			typ = NamedType("Stream", []),
			expected = True
		},
		{
			label = "fallible stream name",
			typ = NamedType(
				"FallibleStream",
				[int_type(), string_type()],
			),
			expected = True
		},
		{
			label = "resource source name",
			typ = NamedType(
				"stream__ResourceSource",
				[string_type(), string_type()],
			),
			expected = True
		},
		{
			label = "type parameter",
			typ = TypeParameterType("T"),
			expected = False
		},
		{
			label = "self type",
			typ = SelfType,
			expected = False
		},
		{
			label = "heap record type",
			typ = HeapRecordType("AnyRecord"),
			expected = True
		},
		{
			label = "union type",
			typ = UnionType("AnyUnion", ManagedUnionValue),
			expected = True
		},
		{
			label = "boxed result",
			typ = BoxedResultType(int_type(), bool_type()),
			expected = True
		},
		{
			label = "function type",
			typ = FunctionType(True, [int_type()], string_type()),
			expected = True
		},
		{
			label = "tuple type",
			typ = TupleType([int_type()]),
			expected = True
		},
		{
			label = "tensor type",
			typ = TensorType({
				element_type = int_type(),
				dims = [TensorStaticDim(4)],
			}),
			expected = True
		},
		{
			label = "stack result with managed value",
			typ = StackResultType(string_type(), int_type()),
			expected = True
		},
		{
			label = "stack result with managed error",
			typ = StackResultType(
				int_type(),
				NamedType("Box", []),
			),
			expected = True
		},
		{
			label = "stack result unmanaged payloads",
			typ = StackResultType(int_type(), bool_type()),
			expected = False
		},
		{
			label = "void type",
			typ = VoidType,
			expected = False
		},
		{
			label = "scalar union type",
			typ = UnionType("Color", ScalarTagValue),
			expected = False
		},
		{
			label = "managed product type",
			typ = HeapRecordType("Pair"),
			expected = True
		},
		{
			label = "range type",
			typ = RangeType,
			expected = False
		},
		{
			label = "option of unmanaged scalar",
			typ = NamedType("Option", [int_type()]),
			expected = False
		},
		{
			label = "option of managed name",
			typ = NamedType("Option", [string_type()]),
			expected = True
		},
		{
			label = "nested option of unmanaged scalar",
			typ = NamedType("Option", [NamedType("Option", [int_type()])]),
			expected = True
		},
		{
			label = "option of stack result",
			typ = NamedType("Option", [StackResultType(int_type(), int_type())]),
			expected = True
		},
		{
			label = "option of boxed result",
			typ = NamedType("Option", [BoxedResultType(int_type(), int_type())]),
			expected = True
		},
	]


private pure func legacy_managed_type_names(program: CoreProgram) -> List[String]:
	var names: List[String] = CORE_MANAGED_TYPE_NAMES

	for decl in program.decls:
		match decl:
			HeapRecordDecl(record_decl):
				if not names.contains(record_decl.name):
					names = names.append(record_decl.name)
				else:
					void
			UnionDecl(union_decl):
				match union_decl.storage:
					ManagedPayloadStorage(_):
						if not names.contains(union_decl.name):
							names = names.append(union_decl.name)
					ScalarTagStorage:
						void
			_:
				void

	names


func test_managed_type_index_matches_legacy_policy() -> Bool:
	program: CoreProgram = managed_decl_program()
	legacy_names: List[String] = legacy_managed_type_names(program)
	index: ManagedTypeIndex = managed_type_index(program)
	var valid: Bool = True

	for test_case in managed_type_cases():
		legacy_result: Bool = legacy_is_managed_type(legacy_names, test_case.typ)
		indexed_result: Bool = is_managed_type(index, test_case.typ)
		case_valid: Bool = (
			legacy_result == test_case.expected
			and indexed_result == test_case.expected
			and legacy_result == indexed_result
		)

		if not case_valid:
			print_error("managed type policy mismatch: " + test_case.label)
			print_error(
				"expected=" + test_case.expected.to_string() + " legacy=" + legacy_result.to_string() + " indexed=" + indexed_result.to_string(),
			)
			valid = False
		else:
			void

	valid


pure func test_optional_function_requires_arc_cleanup() -> Bool:
	function_type: CoreType = FunctionType(True, [int_type()], int_type())
	cleanup_release_policy_for_type(NamedType("Option", [function_type])) == ArcReleasePolicy


pure func test_record_declarations_use_existing_managed_policy() -> Bool:
	index = managed_type_index(managed_decl_program())
	(
		is_managed_type(index, NamedType("Pair", []))
		and is_managed_type(index, HeapRecordType("Pair"))
		and cleanup_release_policy_for_type(HeapRecordType("Pair")) == ArcReleasePolicy
		and not is_managed_type(index, int_type())
	)


pure func test_existing_releasable_types_classify_as_managed() -> Bool:
	index = managed_type_index(managed_decl_program())
	(
		core_type_requires_ownership(index, NamedType("LiteralString", []))
		and core_type_requires_ownership(index, NamedType("net_tls__TlsSession", []))
		and core_type_requires_ownership(index, NamedType("List", [int_type()]))
	)


-- Malformed internal descriptors must miss the singleton Option pattern and
-- use the ordinary named-type policy. These are types, not runtime None values.
pure func test_empty_option_type_arguments_use_named_type_fallback() -> Bool:
	not is_managed_type(
		managed_type_index(managed_decl_program()),
		NamedType("Option", []),
	)


pure func test_singleton_option_type_arguments_classify_the_payload() -> Bool:
	index = managed_type_index(managed_decl_program())
	not is_managed_type(
		index,
		NamedType("Option", [int_type()]),
	) and is_managed_type(
		index,
		NamedType("Option", [string_type()]),
	)


pure func test_multiple_option_type_arguments_use_named_type_fallback() -> Bool:
	not is_managed_type(
		managed_type_index(managed_decl_program()),
		NamedType(
			"Option",
			[string_type(), string_type()],
		),
	)


pure func test_union_storage_controls_named_and_optional_ownership() -> Bool:
	index: ManagedTypeIndex = managed_type_index(managed_decl_program())
	(
		not is_managed_type(index, UnionType("Color", ScalarTagValue))
		and not is_managed_type(index, NamedType("Color", []))
		and not is_managed_type(index, NamedType("Option", [UnionType("Color", ScalarTagValue)]))
		and not is_managed_type(index, NamedType("Option", [NamedType("Color", [])]))
		and is_managed_type(index, UnionType("Choice", ManagedUnionValue))
		and is_managed_type(index, NamedType("Choice", []))
		and is_managed_type(index, NamedType("Option", [UnionType("Choice", ManagedUnionValue)]))
		and is_managed_type(index, NamedType("Option", [NamedType("Choice", [])]))
	)


pure func test_scalar_union_name_does_not_fabricate_bool() -> Bool:
	bool_type_is(NamedType("Bool", [])) and not bool_type_is(UnionType("Bool", ScalarTagValue))


private NATIVE_MANAGED_FIXTURE_DEFINITION_ID: Int = 41


pure func test_native_managed_witness_owns_leaf_and_nullable_payload() -> Bool:
	index = managed_type_index(managed_decl_program())
	var valid = True
	for kind in [NativeIpAddress, NativeDnsName, NativeInterfaceScope]:
		match core_native_managed_identity(NATIVE_MANAGED_FIXTURE_DEFINITION_ID, kind, native_managed_builtin_canonical_name(kind)):
			Err(_):
				valid = False
			Ok(identity):
				leaf = NativeManagedType(identity)
				valid = (
					valid
					and is_managed_type(index, leaf)
					and core_type_requires_ownership(index, leaf)
					and c_type_name(leaf, {}) == "blorp_String*"
					and type_requires_release(leaf)
					and boxed_value_needs_release_type(leaf)
					and dict_value_needs_release_type(leaf)
					and cleanup_release_policy_for_type(leaf) == ArcReleaseOnlyPolicy
					and nullable_managed_option_payload_release_policy(leaf) == Some(ArcReleaseOnlyPolicy)
					and is_managed_type(index, NamedType("Option", [leaf]))
					and not is_managed_type(index, NamedType(native_managed_builtin_canonical_name(kind), []))
				)
	valid


tests: TestSuite = {
	description = "Blorp compiler Core type policy",
	tests = [
		("Native managed witness owns leaf and nullable payload, not namesakes", test_native_managed_witness_owns_leaf_and_nullable_payload),
		("Scalar union spelling does not fabricate primitive Bool", test_scalar_union_name_does_not_fabricate_bool),
		("Union storage controls named and optional ownership", test_union_storage_controls_named_and_optional_ownership),
		("record declarations use managed ownership", test_record_declarations_use_existing_managed_policy),
		("optional function fields require ARC cleanup", test_optional_function_requires_arc_cleanup),
		(
			"managed type index matches legacy policy",
			test_managed_type_index_matches_legacy_policy,
		),
		("existing releasable types classify as managed", test_existing_releasable_types_classify_as_managed),
		("empty Option type arguments use named type fallback", test_empty_option_type_arguments_use_named_type_fallback),
		("singleton Option type arguments classify payload", test_singleton_option_type_arguments_classify_the_payload),
		("multiple Option type arguments use named type fallback", test_multiple_option_type_arguments_use_named_type_fallback),
	]
}
