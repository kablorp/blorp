		ForListExpr(
			{
				binder = loop_binder(),
				layout = PointerListStorage,
				iterable = LiteralExpr(
					IntLiteral(0),
					NamedType("String", []),
					synthetic_core_source_loc(),
				),
				iterable_release_policy = ArcReleaseOnlyPolicy,
				body = int_literal(0)
			},
			NamedType("Void", []),
			synthetic_core_source_loc(),
		),
	) == "String"


private pure func test_all_loop_site_details_use_their_own_iterable_field() -> Bool:
	iterable: CoreExpr = LiteralExpr(
		StringLiteral("items"),
		NamedType("String", []),
		synthetic_core_source_loc(),
	)
	loops: List[CoreExpr] = [
		ForListExpr(
			{
				binder = loop_binder(),
				layout = PointerListStorage,
				iterable = iterable,
				iterable_release_policy = NoReleasePolicy,
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			synthetic_core_source_loc(),
		),
		ForStringExpr(
			{
				binder = loop_binder(),
				iterable = iterable,
				iterable_release_policy = NoReleasePolicy,
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			synthetic_core_source_loc(),
		),
		ForSetExpr(
			{
				binder = loop_binder(),
				iterable = iterable,
				iterable_release_policy = NoReleasePolicy,
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			synthetic_core_source_loc(),
		),
		ForResourceSourceExpr(
			{
				binder = loop_binder(),
				iterable = iterable,
				iterable_release_policy = NoReleasePolicy,
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			synthetic_core_source_loc(),
		),
		ForTensorExpr(
			{
				binder = loop_binder(),
				element_storage = TensorForRawScalarElement(TensorInt64Elements),
				iterable = iterable,
				iterable_release_policy = NoReleasePolicy,
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			synthetic_core_source_loc(),
		),
		ForStreamExpr(
			{
				binder = loop_binder(),
				iterable = iterable,
				iterable_release_policy = NoReleasePolicy,
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			synthetic_core_source_loc(),
		),
		ForDictExpr(
			{
			iteration_mode = CoreDictIterationKeys,
				binder = loop_binder(),
				iterable = iterable,
				iterable_release_policy = NoReleasePolicy,
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			synthetic_core_source_loc(),
		),
	]
	var correct: Bool = True

	for loop in loops:
		correct = correct and core_expr_operation_detail({}, loop) == "String"

	correct


private pure func test_custom_hash_dict_detail_names_the_hash_function() -> Bool:
	construct: CoreExpr = DictConstructExpr(
		{
			constructor = CustomHashContainerConstructor(42, 43, False),
			entries = [],
			value_needs_release = False
		},
		NamedType(
			"Dict",
			[],
		),
		synthetic_core_source_loc(),
	)

	(
		core_expr_operation_detail({42 => "hash_point"}, construct) == "hash_point"
		and core_expr_operation_detail({}, construct) == "definition 42"
	)


tests: TestSuite = {
	description = "Blorp compiler Core allocation contracts",
	tests = [
		(
			"native snapshot and counter allocation contracts",
			test_native_snapshot_and_counter_allocation_contracts,
		),
		("bit-packed boxes are allocation-free", test_bit_packed_boxes_are_allocation_free),
		("wide and struct boxes allocate", test_wide_and_struct_boxes_allocate),
		("union cleanup plans are explicit", test_union_cleanup_plans_are_explicit),
		("mixed risks are preserved", test_mixed_risks_are_preserved),
		("reason codes are stable", test_reason_codes_are_stable),
		(
			"direct call dependencies use exact definition IDs",
			test_direct_call_dependencies_use_exact_definition_ids,
		),
		(
			"unknown and named runtime calls fail closed",
			test_unknown_and_named_runtime_calls_fail_closed,
		),
		(
			"expr coverage is separate from semantic facts",
			test_expr_coverage_is_separate_from_semantic_facts,
		),
		(
			"dict iteration distinguishes pair binders",
			test_dict_iteration_distinguishes_pair_binders,
		),
		(
			"foreign defensive copy preserves may and unknown",
			test_foreign_defensive_copy_preserves_may_and_unknown,
		),
		(
			"closure creation distinguishes capture environments",
			test_closure_creation_distinguishes_capture_environments,
		),
		(
			"record construction distinguishes value and heap layouts",
			test_record_construction_uses_managed_allocation,
		),
		(
			"generic union construction distinguishes nullary payload",
			test_generic_union_construction_distinguishes_nullary_payload,
		),
		("stack union elides implicit boxes", test_stack_union_elides_implicit_boxes),
		("union box facts follow payload emission", test_union_box_facts_follow_payload_emission),
		(
			"typed product fields avoid erased-slot boxes",
			test_typed_product_fields_do_not_add_slot_boxes,
		),
		(
			"drop policies publish exact cleanup dependencies",
			test_drop_policies_publish_exact_cleanup_dependencies,
		),
		(
			"list get layouts are locally allocation-free",
			test_list_get_layouts_are_locally_allocation_free,
		),
		("scheduler checkpoint is allocation-free", test_scheduler_checkpoint_is_allocation_free),
		(
			"loop contracts publish hidden runtime and cleanup",
			test_loop_contracts_publish_hidden_runtime_and_cleanup,
		),
		(
			"accessor match publishes scrutinee cleanup",
			test_accessor_match_publishes_scrutinee_cleanup,
		),
		(
			"container construction preserves payload risks",
			test_container_construction_preserves_payload_risks,
		),
		(
			"list to string preserves known and unknown risks",
			test_list_to_string_preserves_known_and_unknown_risks,
		),
		(
			"channel and select publish received value cleanup",
			test_channel_and_select_publish_received_value_cleanup,
		),
		(
			"capture and reuse contracts preserve hidden causes",
			test_capture_and_reuse_contracts_preserve_hidden_causes,
		),
		(
			"closed intrinsic catalog admits only audited names",
			test_closed_intrinsic_catalog_admits_only_audited_names,
		),
		(
			"closed runtime catalog distinguishes safe and allocating",
			test_closed_runtime_catalog_distinguishes_safe_and_allocating,
		),
		("fact merging is stable and deduplicated", test_fact_merging_is_stable_and_deduplicated),
		(
			"call site detail names the matched operation",
			test_call_site_detail_names_the_matched_operation,
		),
		(
			"cleanup and loop site detail names the type",
			test_cleanup_and_loop_site_detail_names_the_type,
		),
		(
			"custom hash dict detail names the hash function",
			test_custom_hash_dict_detail_names_the_hash_function,
		),
		(
			"all loop site details use their own iterable field",
			test_all_loop_site_details_use_their_own_iterable_field,
		),
	]
}
