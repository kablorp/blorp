private pure func facts_are_empty(facts: CoreLocalAllocationFacts) -> Bool:
	facts.may_allocate.is_empty() and facts.unknown.is_empty()


private pure func test_bit_packed_boxes_are_allocation_free() -> Bool:
	var valid: Bool = True

	for kind in [PrimBox, PointerBox, VoidBox, FloatBox, Float32Box, Float16Box]:
		facts: CoreLocalAllocationFacts = box_allocation_facts(kind)

		if not facts_are_empty(facts) or not allocation_facts_are_free(facts):
			valid = False
		else:
			void

	valid


private pure func test_wide_and_struct_boxes_allocate() -> Bool:
	var valid: Bool = True

	for kind in [Int128Box, UInt128Box, StructBox("blorp_StackOption_Int")]:
		facts: CoreLocalAllocationFacts = box_allocation_facts(kind)

		if facts.may_allocate != [HeapBoxAllocation] or not facts.unknown.is_empty():
			valid = False
		else:
			void

	valid


private pure func union_field(typ: CoreType, release_policy: CoreReleasePolicy) -> CoreUnionField:
	{
		typ = typ,
		release_policy = release_policy
	}


private pure func union_variant(
	name: String,
	tag: Int,
	fields: List[CoreUnionField],
) -> CoreUnionVariant:
	{
		name = name,
		tag = tag,
		fields = fields,
		def_id = None
	}


private pure func union_decl(name: String, variants: List[CoreUnionVariant]) -> CoreUnionDecl:
	{
		abi_type = None,
		name = name,
		type_params = [],
		storage = ManagedPayloadStorage(TypedUnionPayloadStorage),
		variants = variants,
		loc = synthetic_core_source_loc()
	}


private pure func direct_cleanup_dependencies_match(
	dependencies: List[UnionCleanupDependency],
) -> Bool:
	match dependencies:
		[text, nested, stack_result]:
			match (text.typ, text.release_policy):
				(NamedType("String", []), ArcReleaseOnlyPolicy):
					match (nested.typ, nested.release_policy):
						(UnionType("Other", ManagedUnionValue), ArcReleasePolicy):
							match (stack_result.typ, stack_result.release_policy):
								(NamedType("Result", []), StackResultReleasePolicy):
									True
								_:
									False
						_:
							False
				_:
					False
		_:
			False


private pure func iterative_cleanup_dependencies_match(
	dependencies: List[UnionCleanupDependency],
) -> Bool:
	match dependencies:
		[recursive]:
			match (recursive.typ, recursive.release_policy):
				(UnionType("Node", ManagedUnionValue), ArcReleasePolicy):
					True
				_:
					False
		_:
			False


private pure func test_union_cleanup_plans_are_explicit() -> Bool:
	none: CoreUnionDecl = union_decl("Empty", [union_variant("Empty", 0, [union_field(
						NamedType("Int", []),
						NoReleasePolicy,
					)])])
	direct: CoreUnionDecl = union_decl(
		"Holder",
		[
			union_variant("Text", 0, [union_field(
						NamedType("String", []),
						ArcReleaseOnlyPolicy,
					)]),
			union_variant(
				"Nested",
				1,
				[union_field(
						UnionType("Other", ManagedUnionValue),
						ArcReleasePolicy,
					), union_field(
						NamedType("Result", []),
						StackResultReleasePolicy,
					)],
			),
		],
	)
	iterative: CoreUnionDecl = union_decl("Node", [union_variant("Node", 0, [union_field(
						UnionType("Node", ManagedUnionValue),
						ArcReleasePolicy,
					)])])

	none_plan: UnionCleanupPlan = union_cleanup_plan(none)
	direct_plan: UnionCleanupPlan = union_cleanup_plan(direct)
	iterative_plan: UnionCleanupPlan = union_cleanup_plan(iterative)

	match (none_plan.kind, direct_plan.kind, iterative_plan.kind):
		(NoUnionCleanup, DirectUnionCleanup, IterativeUnionCleanup):
			(
				none_plan.dependencies.is_empty()
				and allocation_facts_are_free(none_plan.facts)
				and direct_cleanup_dependencies_match(direct_plan.dependencies)
				and allocation_facts_are_free(direct_plan.facts)
				and iterative_cleanup_dependencies_match(iterative_plan.dependencies)
				and iterative_plan.facts.may_allocate == [CleanupScratchAllocation]
				and iterative_plan.facts.unknown.is_empty()
				and not allocation_facts_are_free(iterative_plan.facts)
			)
		_:
			False


private pure func test_mixed_risks_are_preserved() -> Bool:
	facts: CoreLocalAllocationFacts = {
		may_allocate = [HeapBoxAllocation],
		unknown = [ForeignCallBoundary]
	}

	(
		facts.may_allocate == [HeapBoxAllocation]
		and facts.unknown == [ForeignCallBoundary]
		and not allocation_facts_are_free(facts)
	)


private pure func test_reason_codes_are_stable() -> Bool:
	(
		allocation_reason_code(HeapBoxAllocation) == "heap_box"
		and allocation_reason_code(CleanupScratchAllocation) == "cleanup_scratch"
		and allocation_reason_code(MissingFunctionBody) == "missing_function_body"
	)


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(
		IntLiteral(value),
		NamedType("Int", []),
		synthetic_core_source_loc(),
	)


private pure func stack_option_value() -> CoreExpr:
	UnionConstructExpr(
		{
			type_name = "Option",
			constructor_name = "Some",
			variant = unspelled_test_variant(),
			representation = InlineTaggedRepresentation(
				{
					c_type = "blorp_StackOption_Int",
					empty_initializer = ZeroInlineTaggedInitializer,
					empty_encoding = OPTION_INLINE_TAGGED_EMPTY_ENCODING,
					payload_encoding = OPTION_INLINE_TAGGED_PAYLOAD_ENCODING
				},
				PayloadInlineTaggedVariant,
			),
			payload_storage = TypedUnionPayloadStorage,
			uses_release_mask = False,
			release_mask = 0,
			args = [
				{
					kind = PrimBox,
					value = int_literal(1),
					needs_release = False,
					transfers_ownership = False
				},
			]
		},
		NamedType(
			"Option",
			[NamedType("Int", [])],
		),
		synthetic_core_source_loc(),
	)


private pure func test_direct_call_dependencies_use_exact_definition_ids() -> Bool:
	contract: CoreAllocationContract = core_call_allocation_contract(
		UserCall(
			"display name is not identity",
			Some(73),
			[],
		),
	)

	match contract.dependencies:
		[DirectFunctionAllocationDependency(def_id)]:
			(
				def_id == 73
				and contract.coverage == CoveredAllocationOperation
				and contract.category == CallAllocationOperation
				and allocation_facts_are_free(contract.facts)
			)
		_:
			False


private pure func test_native_snapshot_and_counter_allocation_contracts() -> Bool:
	memory = core_call_allocation_contract(BuiltinCall("blorp_get_mem_stats"))
	scheduler = core_call_allocation_contract(BuiltinCall("blorp_get_scheduler_stats"))
	counter = core_call_allocation_contract(BuiltinCall("blorp_read_memory_counter"))
	near_miss = core_call_allocation_contract(BuiltinCall("blorp_read_memory_counter_extra"))
	(
		memory.facts.may_allocate == [ManagedObjectAllocation]
		and scheduler.facts.may_allocate == [ManagedObjectAllocation]
		and allocation_facts_are_free(counter.facts)
		and not allocation_facts_are_free(near_miss.facts)
	)


private pure func test_unknown_and_named_runtime_calls_fail_closed() -> Bool:
	unknown: CoreAllocationContract = core_call_allocation_contract(UnknownCall)
	runtime: CoreAllocationContract = core_call_allocation_contract(
		BuiltinCall("unregistered_runtime_operation"),
	)

	match (unknown.dependencies, runtime.dependencies):
		([UnknownCallAllocationDependency], [RuntimeAllocationDependency]):
			(
				unknown.coverage == CoveredAllocationOperation
				and runtime.coverage == CoveredAllocationOperation
				and unknown.facts.may_allocate.is_empty()
				and unknown.facts.unknown == [UnknownCallTarget]
				and runtime.facts.may_allocate.is_empty()
				and runtime.facts.unknown == [RuntimeOperationAllocation]
			)
		_:
			False


private pure func test_expr_coverage_is_separate_from_semantic_facts() -> Bool:
	scalar: CoreAllocationContract = core_expr_allocation_contract(int_literal(1))
	unsupported: CoreAllocationContract = core_expr_allocation_contract(
		DebugBlockExpr(
			int_literal(1),
			NamedType("Int", []),
			synthetic_core_source_loc(),
		),
	)

	(
		scalar.coverage == CoveredAllocationOperation
		and scalar.category == ScalarAllocationOperation
		and allocation_facts_are_free(scalar.facts)
		and unsupported.coverage == UnsupportedFinalCoreOperation
		and unsupported.category == UnsupportedAllocationOperation
		and allocation_facts_are_free(unsupported.facts)
	)


private pure func dict_loop(
	mode: CoreDictIterationMode,
	binder_type: CoreType,
) -> CoreExpr:
	ForDictExpr(
		{
			iteration_mode = mode,
			binder = {
				variable = {
					name = "item",
					id = 1,
					def_id = None,
					origin = AuthoredBinder
				},
				typ = binder_type,
				range_direction = RangeMayRunBackward
			},
			iterable = int_literal(0),
			iterable_release_policy = NoReleasePolicy,
			body = int_literal(1)
		},
		NamedType(
			"Int",
			[],
		),
		synthetic_core_source_loc(),
	)


private pure func test_dict_iteration_distinguishes_pair_binders() -> Bool:
	key_only: CoreAllocationContract = core_expr_allocation_contract(
		dict_loop(CoreDictIterationKeys, NamedType("String", [])),
	)
	pair: CoreAllocationContract = core_expr_allocation_contract(
		dict_loop(CoreDictIterationEntries, TupleType([NamedType("String", []), NamedType("Int", [])])),
	)

	(
		allocation_facts_are_free(key_only.facts)
		and pair.facts.may_allocate == [ManagedObjectAllocation]
		and pair.facts.unknown.is_empty()
	)


private pure func test_foreign_defensive_copy_preserves_may_and_unknown() -> Bool:
	contract: CoreAllocationContract = core_call_allocation_contract(
		ForeignCall(
			"foreign_name_is_not_a_contract",
			ForeignDefaultArgs([ForeignDefensiveCopy(ForeignStringCopy)]),
		),
	)

	match contract.dependencies:
		[ForeignAllocationDependency]:
			(
				contract.facts.may_allocate == [RawBufferAllocation]
				and contract.facts.unknown == [ForeignCallBoundary]
			)
		_:
			False


private pure func closure_create(captures_value: Bool) -> CoreExpr:
	captures: List[CoreClosureCapture] = if captures_value:
		[
			{
				name = "captured",
				id = 0,
				typ = NamedType("Int", []),
				origin = AuthoredBinder
			},
		]
	else:
		[]

	ClosureCreateExpr(
		{
			def_id = 91,
			captures = captures
		},
		NamedType(
			"Closure",
			[],
		),
		synthetic_core_source_loc(),
	)


private pure func test_closure_creation_distinguishes_capture_environments() -> Bool:
	static_closure: CoreAllocationContract = core_expr_allocation_contract(closure_create(False))
	captured_closure: CoreAllocationContract = core_expr_allocation_contract(closure_create(True))

	(
		allocation_facts_are_free(static_closure.facts)
		and captured_closure.facts.may_allocate == [ClosureEnvironmentAllocation]
		and captured_closure.facts.unknown.is_empty()
	)


private pure func test_record_construction_uses_managed_allocation() -> Bool:
	heap_record: CoreAllocationContract = core_expr_allocation_contract(
		ProductExpr(
			product_build_in_declared_order([]),
			HeapRecordType("Node"),
			synthetic_core_source_loc(),
		),
	)

	(
		heap_record.facts.may_allocate == [ManagedObjectAllocation]
		and heap_record.facts.unknown.is_empty()
	)


private pure func union_construct(has_payload: Bool) -> CoreExpr:
	args: List[CoreBoxedStorageValue] = if has_payload:
		[
			{
				kind = PrimBox,
				value = int_literal(1),
				needs_release = False,
				transfers_ownership = False
			},
		]
	else:
		[]

	constructor_name: String = if has_payload:
		"Some"
	else:
		"None"

	UnionConstructExpr(
		{
			type_name = "MaybeInt",
			constructor_name = constructor_name,
			variant = unspelled_test_variant(),
			representation = GenericUnionRepresentation,
			payload_storage = TypedUnionPayloadStorage,
			uses_release_mask = False,
			release_mask = 0,
			args = args
		},
		UnionType(
			"MaybeInt",
			ManagedUnionValue,
		),
		synthetic_core_source_loc(),
	)


private pure func test_generic_union_construction_distinguishes_nullary_payload() -> Bool:
	nullary: CoreAllocationContract = core_expr_allocation_contract(union_construct(False))
	payload: CoreAllocationContract = core_expr_allocation_contract(union_construct(True))

	(
		allocation_facts_are_free(nullary.facts)
		and payload.facts.may_allocate == [ManagedObjectAllocation]
		and payload.facts.unknown.is_empty()
	)


private pure func stack_union_construct(kind: CoreBoxKind) -> CoreExpr:
	payload_type: CoreType = if kind == Int128Box:
		NamedType("Int128", [])
	else:
		NamedType("Int", [])

	payload_literal: CoreLiteral = if kind == Int128Box:
		WideIntLiteral("1")
	else:
		IntLiteral(1)

	option_type: String = if kind == Int128Box:
		"blorp_StackOption_Int128"
	else:
		"blorp_StackOption_Int"

	UnionConstructExpr(
		{
			type_name = "Option",
			constructor_name = "Some",
			variant = unspelled_test_variant(),
			representation = InlineTaggedRepresentation(
				{
					c_type = option_type,
					empty_initializer = ZeroInlineTaggedInitializer,
					empty_encoding = OPTION_INLINE_TAGGED_EMPTY_ENCODING,
					payload_encoding = OPTION_INLINE_TAGGED_PAYLOAD_ENCODING
				},
				PayloadInlineTaggedVariant,
			),
			payload_storage = TypedUnionPayloadStorage,
			uses_release_mask = False,
			release_mask = 0,
			args = [
				{
					kind = kind,
					value = LiteralExpr(payload_literal, payload_type, synthetic_core_source_loc()),
					needs_release = False,
					transfers_ownership = False
				},
			]
		},
		NamedType(
			"Option",
			[payload_type],
		),
		synthetic_core_source_loc(),
	)


private pure func test_stack_union_elides_implicit_boxes() -> Bool:
	primitive: CoreAllocationContract = core_expr_allocation_contract(
		stack_union_construct(PrimBox),
	)
	wide: CoreAllocationContract = core_expr_allocation_contract(stack_union_construct(Int128Box))
	allocation_facts_are_free(primitive.facts) and allocation_facts_are_free(wide.facts)


private pure func generic_wide_integer_union(erased: Bool) -> CoreExpr:
	payload_storage: CoreUnionPayloadStorage = if erased:
		ErasedUnionPayloadStorage
	else:
		TypedUnionPayloadStorage

	UnionConstructExpr(
		{
			type_name = "WrappedWideInteger",
			constructor_name = "WrappedWideInteger",
			variant = unspelled_test_variant(),
			representation = GenericUnionRepresentation,
			payload_storage = payload_storage,
			uses_release_mask = False,
			release_mask = 0,
			args = [
				{
					kind = Int128Box,
					value = LiteralExpr(
						WideIntLiteral("1"),
						NamedType("Int128", []),
						synthetic_core_source_loc(),
					),
					needs_release = False,
					transfers_ownership = False
				},
			]
		},
		UnionType(
			"WrappedWideInteger",
			ManagedUnionValue,
		),
		synthetic_core_source_loc(),
	)


private pure func nullable_pointer_union() -> CoreExpr:
	UnionConstructExpr(
		{
			type_name = "Option",
			constructor_name = "Some",
			variant = unspelled_test_variant(),
			representation = NullableOptionRepresentation,
			payload_storage = TypedUnionPayloadStorage,
			uses_release_mask = False,
			release_mask = 0,
			args = [
				{
					kind = PointerBox,
					value = LiteralExpr(
						StringLiteral("value"),
						NamedType("String", []),
						synthetic_core_source_loc(),
					),
					needs_release = True,
					transfers_ownership = False
				},
			]
		},
		NamedType(
			"Option",
			[NamedType("String", [])],
		),
		synthetic_core_source_loc(),
	)


private pure func test_union_box_facts_follow_payload_emission() -> Bool:
	typed: CoreAllocationContract = core_expr_allocation_contract(generic_wide_integer_union(False))
	erased: CoreAllocationContract = core_expr_allocation_contract(generic_wide_integer_union(True))
	nullable: CoreAllocationContract = core_expr_allocation_contract(nullable_pointer_union())

	(
		typed.facts.may_allocate == [ManagedObjectAllocation]
		and erased.facts.may_allocate == [ManagedObjectAllocation, HeapBoxAllocation]
		and allocation_facts_are_free(nullable.facts)
	)


-- Typed products allocate only their managed row. Inline aggregates and
-- StackResult fields use their declared C storage without erased-slot boxes.
private pure func test_typed_product_fields_do_not_add_slot_boxes() -> Bool:
	primitive: CoreExpr = ProductExpr(
		product_build_in_declared_order([int_literal(1), int_literal(2)]),
		HeapRecordType("PrimitivePair"),
		synthetic_core_source_loc(),
	)
	structure: CoreExpr = ProductExpr(
		product_build_in_declared_order([stack_option_value(), int_literal(2)]),
		HeapRecordType("InlinePair"),
		synthetic_core_source_loc(),
	)
	stack_result: CoreExpr = ProductExpr(
		product_build_in_declared_order([int_literal(1), int_literal(2)]),
		HeapRecordType("ResultPair"),
		synthetic_core_source_loc(),
	)

	[primitive, structure, stack_result].all(func(expr):
		contract = core_expr_allocation_contract(expr)
		contract.facts.may_allocate == [ManagedObjectAllocation] and contract.facts.unknown.is_empty()
	)


private pure func drop_expr(value_type: CoreType, policy: CoreReleasePolicy) -> CoreExpr:
	DropExpr(
		{
			name = "value",
			id = 4,
			def_id = None,
			origin = AuthoredBinder
		},
		value_type,
		policy,
		int_literal(0),
		NamedType(
			"Int",
			[],
		),
		synthetic_core_source_loc(),
	)


private pure func test_drop_policies_publish_exact_cleanup_dependencies() -> Bool:
	no_release: CoreAllocationContract = core_expr_allocation_contract(
		drop_expr(
			NamedType("Int", []),
			NoReleasePolicy,
		),
	)
	arc_release_only: CoreAllocationContract = core_expr_allocation_contract(
		drop_expr(
			NamedType("String", []),
			ArcReleaseOnlyPolicy,
		),
	)
	arc: CoreAllocationContract = core_expr_allocation_contract(
		drop_expr(
			NamedType("String", []),
			ArcReleasePolicy,
		),
	)
	stack: CoreAllocationContract = core_expr_allocation_contract(
		drop_expr(
			NamedType("Result", []),
			StackResultReleasePolicy,
		),
	)

	match (arc.dependencies, stack.dependencies):
		([CleanupAllocationDependency(NamedType("String", []), ArcReleasePolicy)], [CleanupAllocationDependency(NamedType("Result", []), StackResultReleasePolicy)]):
			(
				allocation_facts_are_free(no_release.facts)
				and no_release.dependencies.is_empty()
				and allocation_facts_are_free(arc_release_only.facts)
				and arc_release_only.dependencies.is_empty()
				and allocation_facts_are_free(arc.facts)
				and allocation_facts_are_free(stack.facts)
			)
		_:
			False


private pure func list_get(layout: CoreListStorageLayout) -> CoreExpr:
	ListGetExpr(
		{
			layout = layout,
			list = int_literal(0),
			index = int_literal(0),
			bounds = CheckedListAccess
		},
		NamedType(
			"Int",
			[],
		),
		synthetic_core_source_loc(),
	)


private pure func test_list_get_layouts_are_locally_allocation_free() -> Bool:
	(
		allocation_facts_are_free(core_expr_allocation_contract(list_get(PointerListStorage)).facts)
		and allocation_facts_are_free(
			core_expr_allocation_contract(list_get(InlineListStorage(8))).facts,
		)
		and allocation_facts_are_free(
			core_expr_allocation_contract(
				list_get(InlineStructListStorage("blorp_StackOption_Int")),
			).facts,
		)
	)


-- blorp_cooperative_checkpoint's fast path only decrements a thread-local
-- budget (runtime.c:26007-26013); its slow path resets the budget, polls
-- cancellation, and calls blorp_yield_now, which is a coroutine stack switch
-- (runtime.c:25947-25971, runtime.c:25988-26001) -- no heap allocation on
-- either path, so the checkpoint the fairness pass inserts at loop
-- back-edges must not make an otherwise allocation-free loop unknown.
private pure func test_scheduler_checkpoint_is_allocation_free() -> Bool:
	contract: CoreAllocationContract = core_expr_allocation_contract(
		CooperativeCheckpointExpr(
			NamedType("Void", []),
			synthetic_core_source_loc(),
		),
	)

	allocation_facts_are_free(contract.facts) and contract.dependencies.is_empty()


private pure func loop_binder() -> CoreLoopBinder:
	{
		variable = {
			name = "item",
			id = 12,
			def_id = None,
			origin = AuthoredBinder
		},
		typ = NamedType("Int", []),
		range_direction = RangeMayRunBackward
	}


private pure func test_loop_contracts_publish_hidden_runtime_and_cleanup() -> Bool:
	iterable: CoreExpr = LiteralExpr(
		IntLiteral(0),
		UnionType("Node", ManagedUnionValue),
		synthetic_core_source_loc(),
	)
	list_loop: CoreAllocationContract = core_expr_allocation_contract(
		ForListExpr(
			{
				binder = loop_binder(),
				layout = PointerListStorage,
				iterable = iterable,
				iterable_release_policy = ArcReleasePolicy,
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			synthetic_core_source_loc(),
		),
	)
	resource_loop: CoreAllocationContract = core_expr_allocation_contract(
		ForResourceSourceExpr(
			{
				binder = loop_binder(),
				iterable = iterable,
				iterable_release_policy = NoReleasePolicy,
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			synthetic_core_source_loc(),
		),
	)
	raw_tensor: CoreAllocationContract = core_expr_allocation_contract(
		ForTensorExpr(
			{
				binder = loop_binder(),
				element_storage = TensorForRawScalarElement(TensorInt64Elements),
				iterable = iterable,
				iterable_release_policy = NoReleasePolicy,
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			synthetic_core_source_loc(),
		),
	)
	row_tensor: CoreAllocationContract = core_expr_allocation_contract(
		ForTensorExpr(
			{
				binder = loop_binder(),
				element_storage = TensorForRowSliceElement({
					row_size = "4",
					result_first_dim = "4",
					runtime_derived = False,
				}),
				iterable = iterable,
				iterable_release_policy = NoReleasePolicy,
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			synthetic_core_source_loc(),
		),
	)

	match (list_loop.dependencies, resource_loop.dependencies):
		([CleanupAllocationDependency(UnionType("Node", ManagedUnionValue), ArcReleasePolicy)], [RuntimeAllocationDependency]):
			(
				resource_loop.facts.unknown == [RuntimeCallbackBoundary]
				and allocation_facts_are_free(raw_tensor.facts)
				and row_tensor.facts.may_allocate == [ManagedObjectAllocation]
			)
		_:
			False


private pure func test_accessor_match_publishes_scrutinee_cleanup() -> Bool:
	scrutinee: CoreExpr = LiteralExpr(
