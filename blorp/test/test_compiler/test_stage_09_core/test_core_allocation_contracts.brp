					range_direction = RangeMayRunBackward
				},
				iterable = int_literal(0),
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			synthetic_core_source_loc(),
		),
	)
	select_contract: CoreAllocationContract = core_expr_allocation_contract(
		SelectExpr(
			[
				{
					kind = SelectRecvArm({
						binder = {
							name = "value",
							id = 31,
							def_id = None,
							origin = AuthoredBinder
						},
						elem_type = UnionType("Node", ManagedUnionValue),
						channel = int_literal(0),
					}),
					body = int_literal(0),
					loc = synthetic_core_source_loc()
				},
			],
			NamedType(
				"Void",
				[],
			),
			synthetic_core_source_loc(),
		),
	)

	match (channel.dependencies, select_contract.dependencies):
		([RuntimeAllocationDependency, CleanupAllocationDependency(UnionType("Node", ManagedUnionValue), ArcReleasePolicy)], [RuntimeAllocationDependency, CleanupAllocationDependency(UnionType("Node", ManagedUnionValue), ArcReleasePolicy)]):
