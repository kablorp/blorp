private POINT_TYPE: CoreType = HeapRecordType("Point")

private INT_TYPE: CoreType = NamedType("Int", [])

private BOOL_TYPE: CoreType = NamedType("Bool", [])

private FIRST_FREE_DEF_ID: Int = 100

private MAIN_DEF_ID: Int = 1

private HASH_IMPL_DEF_ID: Int = 2

private EQUALS_IMPL_DEF_ID: Int = 3


pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = None,
		origin = AuthoredBinder
	}


pure func param(name: String, typ: CoreType) -> CoreParam:
	{
		name = core_var(name),
		typ = typ,
		loc = synthetic_core_source_loc()
	}


pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), INT_TYPE, synthetic_core_source_loc())


pure func function_info(
	name: String,
	def_id: Int,
	params: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
) -> CoreFunction:
	{
		name = name,
		source_module = None,
		module = FIXTURE_NO_SOURCE_MODULE,
		type_params = [],
		params = params,
		return_type = return_type,
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		def_id = def_id,
		loc = synthetic_core_source_loc()
	}


---
An impl method as runtime projection leaves it. The name is deliberately not
the `Trait_method_Type` spelling: only the origin says what it implements.
---
pure func impl_method(
	def_id: Int,
	key_type: CoreType,
	role: CoreRuntimeCallbackRole,
	params: List[CoreParam],
	return_type: CoreType,
) -> CoreDecl:
	FunctionDecl(
		{ function_info("impl", def_id, params, return_type, int_literal(0)) |
			origin = Declared(
				ProjectedImplMethod(
					synthesized_name_id("_"),
					synthesized_name_id("_"),
					key_type,
					RuntimeCallbackMethod(role),
				),
			)
		},
	)


pure func hash_impl(key_type: CoreType) -> CoreDecl:
	impl_method(
		HASH_IMPL_DEF_ID,
		key_type,
		HashableHashCallback,
		[param("self", key_type)],
		INT_TYPE,
	)


pure func equals_impl(key_type: CoreType) -> CoreDecl:
	impl_method(
		EQUALS_IMPL_DEF_ID,
		key_type,
		EquatableEqualsCallback,
		[param("a", key_type), param("b", key_type)],
		BOOL_TYPE,
	)


pure func program_with(decls: List[CoreDecl]) -> CoreProgram:
	{
		decls = [
			FunctionDecl(
				function_info(
					"main",
					MAIN_DEF_ID,
					[],
					INT_TYPE,
					int_literal(0),
				),
			),
		].concat(decls),
		foreign_includes = [],
		source_files = []
	}


pure func minted(decls: List[CoreDecl]) -> HashKeyCallbackResult:
	mint_hash_key_callbacks(program_with(decls), FIRST_FREE_DEF_ID)


pure func adapter_for(program: CoreProgram, impl_def: Int) -> Option[CoreFunction]:
	var found: Option[CoreFunction] = None

	for decl in program.decls:
		match decl:
			FunctionDecl(candidate):
				match core_function_declared_origin(candidate.origin):
					HashKeySlotAdapter(target, _):
						if found.is_none() and target == impl_def:
							found = Some(candidate)
					_:
						void
			_:
				void

	found


pure func is_record_slot_unbox(expr: CoreExpr, slot_name: String, struct_name: String) -> Bool:
	match expr:
		UnboxExpr(PointerUnbox, VarExpr(slot, NamedType("Ptr", []), _), HeapRecordType(unboxed), _):
			slot.name == slot_name and unboxed == struct_name
		_:
			False


pure func adapter_table(program: CoreProgram) -> HashKeyAdapterTable:
	build_hash_key_adapter_table(
		program,
		build_specialize_layout(program),
		build_runtime_callback_table(program),
	)


pure func test_mints_record_slot_adapters() -> Bool:
	result: HashKeyCallbackResult = minted([hash_impl(POINT_TYPE), equals_impl(POINT_TYPE)])

	hash_adapter_calls_impl: Bool = match adapter_for(result.program, HASH_IMPL_DEF_ID):
		Some(adapter):
			role_matches = match core_function_declared_origin(adapter.origin):
				HashKeySlotAdapter(_, HashSlotCallback): True
				_: False
			match adapter.body:
				Some(CallExpr(UserCall(_, Some(impl_id), _), _, [key], _, _)):
					(
						impl_id == HASH_IMPL_DEF_ID
						and adapter.def_id == FIRST_FREE_DEF_ID
						and adapter.return_type == INT_TYPE
						and role_matches
						and adapter.params.map(func(p): p.typ) == [NamedType("Ptr", [])]
						and is_record_slot_unbox(key, "key_slot", "Point")
					)
				_:
					False
		None:
			False

	equals_adapter_calls_impl: Bool = match adapter_for(result.program, EQUALS_IMPL_DEF_ID):
		Some(adapter):
			role_matches = match core_function_declared_origin(adapter.origin):
				HashKeySlotAdapter(_, EqualitySlotCallback): True
				_: False
			match adapter.body:
				Some(CallExpr(UserCall(_, Some(impl_id), _), _, [left, right], _, _)):
					(
						impl_id == EQUALS_IMPL_DEF_ID
						and adapter.def_id == FIRST_FREE_DEF_ID + 1
						and adapter.return_type == BOOL_TYPE
						and role_matches
						and is_record_slot_unbox(left, "left_slot", "Point")
						and is_record_slot_unbox(right, "right_slot", "Point")
					)
				_:
					False
		None:
			False

	(
		hash_adapter_calls_impl
		and equals_adapter_calls_impl
		and result.next_def_id == FIRST_FREE_DEF_ID + 2
	)


pure func test_mints_nothing_without_hash_impls() -> Bool:
	result: HashKeyCallbackResult = minted([])
	result.program.decls.length() == 1 and result.next_def_id == FIRST_FREE_DEF_ID


pure func test_needs_both_impls_to_mint() -> Bool:
	result: HashKeyCallbackResult = minted([hash_impl(POINT_TYPE)])
	(
		adapter_for(result.program, HASH_IMPL_DEF_ID).is_none()
		and result.next_def_id == FIRST_FREE_DEF_ID
	)


pure func test_mints_nothing_for_runtime_hashed_keys() -> Bool:
	-- An impl on Int itself: Int keys use the runtime's word hash.
	result: HashKeyCallbackResult = minted([hash_impl(INT_TYPE), equals_impl(INT_TYPE)])
	result.next_def_id == FIRST_FREE_DEF_ID


pure func test_scalar_defaults_keep_word_fastpath() -> Bool:
	program: CoreProgram = program_with([])
	(
		hash_key_strategy(build_specialize_layout(program), UnionType("Choice", ScalarTagValue)) == WordHashKeys
		and minted([]).next_def_id == FIRST_FREE_DEF_ID
	)


pure func test_native_equality_callback_excludes_primitives_and_managed_unions() -> Bool:
	keys: List[CoreType] = [INT_TYPE, BOOL_TYPE, NamedType("String", []), UnionType("Payload", ManagedUnionValue)]
	keys.all(func(key): minted([hash_impl(key)]).next_def_id == FIRST_FREE_DEF_ID)


pure func test_scalar_authored_pair_binds_word_slot_callbacks() -> Bool:
	key: CoreType = UnionType("Choice", ScalarTagValue)
	result = minted([hash_impl(key), equals_impl(key)])

	match bound_hash_container_constructor(
		build_specialize_layout(result.program),
		adapter_table(result.program),
		key,
	):
		CustomHashContainerConstructor(hash_def, equals_def, needs_release):
			(
				hash_def == FIRST_FREE_DEF_ID
				and equals_def == FIRST_FREE_DEF_ID + 1
				and not needs_release
				and result.next_def_id == FIRST_FREE_DEF_ID + 2
			)
		_:
			False


pure func test_scalar_hash_only_mints_one_native_equality_callback() -> Bool:
	key: CoreType = UnionType("Choice", ScalarTagValue)
	result = minted([hash_impl(key)])
	callbacks = build_runtime_callback_table(result.program)
	var native_count: Int = 0
	var native_body: Bool = False

	for decl in result.program.decls:
		match decl:
			FunctionDecl(function_info):
				match core_function_declared_origin(function_info.origin):
					NativeTagEqualityCallback(typ):
						native_count += 1

						body_matches: Bool = match function_info.body:
							Some(BinaryExpr(EqualOp, _, _, _, _)):
								True
							_:
								False

						native_body = (
							typ == key
							and function_info.def_id == FIRST_FREE_DEF_ID
							and function_info.params.map(func(p): p.typ) == [key, key]
							and body_matches
						)
					_:
						void
			_:
				void

	bound: Bool = match bound_hash_container_constructor(
		build_specialize_layout(result.program),
		adapter_table(result.program),
		key,
	):
		CustomHashContainerConstructor(_, _, needs_release):
			not needs_release
		_:
			False

	(
		native_count == 1
		and native_body
		and bound
		and result.next_def_id == FIRST_FREE_DEF_ID + 3
		and find_runtime_callback(
			callbacks,
			EquatableEqualsCallback,
			key,
		) == Some(FIRST_FREE_DEF_ID)
	)


pure func test_preprojection_impl_uses_same_scalar_callback_policy() -> Bool:
	key: CoreType = UnionType("Choice", ScalarTagValue)
	method = { function_info(
		"hash",
		HASH_IMPL_DEF_ID,
		[param("self", key)],
		INT_TYPE,
		int_literal(0),
	) |
		origin = Declared(
			ImplMethod(
				synthesized_name_id("_"),
				synthesized_name_id("_"),
				RuntimeCallbackMethod(HashableHashCallback),
			),
		)
	}
	program = program_with([ImplDecl({
			trait_name = "Hashable",
			for_type = key,
			type_params = [],
			methods = [method],
			loc = synthetic_core_source_loc(),
		})])
	context = core_synth_context(core_empty_declaration_index(), program)

	projection_preserves_identity: Bool = match project_runtime_program(program):
		Ok(projected):
			no_impl_declarations: Bool = projected.decls.all(func(decl):
				match decl:
					ImplDecl(_):
						False
					_:
						True
			)
			(
				build_runtime_callback_table(
					program,
				).hashable_hash == build_runtime_callback_table(projected).hashable_hash
				and duplicate_runtime_callbacks(projected).is_empty()
				and no_impl_declarations
			)
		Err(_):
			False

	match classify_hash_collection_type(context, key):
		ExactHashTypeLayout(facts):
			(
				projection_preserves_identity
				and facts.probe_mode == DispatchedHashProbe
				and hash_key_strategy(build_specialize_layout(program), key) == TraitHashKeys
			)
		_:
			False


---
Projection leaves an impl on `opaque type UserId = Int` with an `Int`
parameter and `UserId` only in its origin. Its adapters unbox the word the
key slot stores; a container pinned to the impls reaches them.
---
pure func opaque_int_impl(
	def_id: Int,
	role: CoreRuntimeCallbackRole,
	params: List[CoreParam],
	return_type: CoreType,
) -> CoreDecl:
	impl_method(
		def_id,
		NamedType("UserId", []),
		role,
		params,
		return_type,
	)


pure func opaque_int_impls() -> List[CoreDecl]:
	[
		opaque_int_impl(
			HASH_IMPL_DEF_ID,
			HashableHashCallback,
			[param("self", INT_TYPE)],
			INT_TYPE,
		),
		opaque_int_impl(
			EQUALS_IMPL_DEF_ID,
			EquatableEqualsCallback,
			[param("a", INT_TYPE), param("b", INT_TYPE)],
			BOOL_TYPE,
		),
	]


pure func test_mints_word_slot_adapters_for_impls_on_erased_opaque_types() -> Bool:
	result: HashKeyCallbackResult = minted(opaque_int_impls())

	match adapter_for(result.program, HASH_IMPL_DEF_ID):
		Some(adapter):
			match adapter.body:
				Some(CallExpr(_, _, [UnboxExpr(PrimUnbox, _, NamedType("Int", []), _)], _, _)):
					result.next_def_id == FIRST_FREE_DEF_ID + 2
				_:
					False
		None:
			False


pure func test_binds_pinned_constructor_to_impl_adapters() -> Bool:
	result: HashKeyCallbackResult = minted(opaque_int_impls())

	match bound_pinned_hash_container_constructor(
		build_specialize_layout(result.program),
		adapter_table(result.program),
		ImplHashContainerConstructor(HASH_IMPL_DEF_ID, EQUALS_IMPL_DEF_ID),
		INT_TYPE,
	):
		-- A word slot owns nothing, so the container releases no key.
		CustomHashContainerConstructor(hash_fn, equals_fn, needs_release):
			(
				hash_fn == FIRST_FREE_DEF_ID
				and equals_fn == FIRST_FREE_DEF_ID + 1
				and not needs_release
			)
		_:
			False


pure func has_expected_pinned_impl_ids(constructor: CoreHashContainerConstructor) -> Bool:
	match constructor:
		ImplHashContainerConstructor(hash_impl_def_id, equals_impl_def_id):
			hash_impl_def_id == HASH_IMPL_DEF_ID and equals_impl_def_id == EQUALS_IMPL_DEF_ID
		_:
			False


pure func test_leaves_pinned_constructor_without_adapters_unbound() -> Bool:
	program: CoreProgram = program_with([])

	constructor: CoreHashContainerConstructor = bound_pinned_hash_container_constructor(
		build_specialize_layout(program),
		adapter_table(program),
		ImplHashContainerConstructor(HASH_IMPL_DEF_ID, EQUALS_IMPL_DEF_ID),
		INT_TYPE,
	)
	has_expected_pinned_impl_ids(constructor)


pure func test_rejects_other_pinned_impl_ids() -> Bool:
	not has_expected_pinned_impl_ids(
		ImplHashContainerConstructor(
			EQUALS_IMPL_DEF_ID,
			HASH_IMPL_DEF_ID,
		),
	)


pure func test_unboxes_heap_record_slot_as_pointer() -> Bool:
	key_type: CoreType = HeapRecordType("Account")
	result: HashKeyCallbackResult = minted([hash_impl(key_type), equals_impl(key_type)])

	match adapter_for(result.program, HASH_IMPL_DEF_ID):
		Some(adapter):
			match adapter.body:
				Some(CallExpr(_, _, [UnboxExpr(PointerUnbox, _, HeapRecordType("Account"), _)], _, _)):
					True
				_:
					False
		None:
			False


pure func test_binds_record_key_to_minted_adapters() -> Bool:
	result: HashKeyCallbackResult = minted([hash_impl(POINT_TYPE), equals_impl(POINT_TYPE)])

	match bound_hash_container_constructor(
		build_specialize_layout(result.program),
		adapter_table(result.program),
		POINT_TYPE,
	):
		-- The slot owns the managed record pointer, so the container releases it.
		CustomHashContainerConstructor(hash_fn, equals_fn, needs_release):
			hash_fn == FIRST_FREE_DEF_ID and equals_fn == FIRST_FREE_DEF_ID + 1 and needs_release
		_:
			False


pure func test_leaves_boxed_key_without_adapters_unbound() -> Bool:
	program: CoreProgram = program_with([])

	match bound_hash_container_constructor(
		build_specialize_layout(program),
		adapter_table(program),
		POINT_TYPE,
	):
		TraitHashContainerConstructor(HeapRecordType("Point")):
			True
		_:
			False


pure func test_refuses_adapters_with_a_different_slot_layout() -> Bool:
	-- Even with exact impl identity, a stale scalar stack-Option slot must
	-- never bind a managed record pointer key.
	result: HashKeyCallbackResult = minted([
		hash_impl(HeapRecordType("Point")),
		equals_impl(HeapRecordType("Point")),
	])

	table: HashKeyAdapterTable = adapter_table(result.program)
	mismatched: HashKeyAdapterTable = { table | adapters = table.adapters.set(
			HASH_IMPL_DEF_ID,
			{
				def_id = FIRST_FREE_DEF_ID,
				slot = StructUnbox("blorp_StackOption_Int")
			},
		) }

	match bound_hash_container_constructor(
		build_specialize_layout(result.program),
		mismatched,
		POINT_TYPE,
	):
		TraitHashContainerConstructor(_):
			True
		_:
			False


pure func test_leaves_pointer_key_without_adapters_unbound() -> Bool:
	-- No identity fallback: a record key without impls stays unbound for C
	-- symbol projection to report.
	program: CoreProgram = program_with([])

	match bound_hash_container_constructor(
		build_specialize_layout(program),
		adapter_table(program),
		HeapRecordType("Account"),
	):
		TraitHashContainerConstructor(HeapRecordType("Account")):
			True
		_:
			False


private pure func nested_callback(decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(function):
			match core_function_declared_origin(function.origin):
				ProjectedImplMethod(trait_id, method_id, target, role):
					ImplDecl({
						trait_name = "fixture",
						for_type = target,
						type_params = [],
						methods = [{ function | origin = Declared(ImplMethod(trait_id, method_id, role)) }],
						loc = synthetic_core_source_loc(),
					})
				_: decl
		_: decl


func test_callback_identity_survives_impl_projection() -> Bool:
	projected = build_runtime_callback_table(program_with([hash_impl(POINT_TYPE), equals_impl(POINT_TYPE)]))
	nested = build_runtime_callback_table(program_with([
		nested_callback(hash_impl(POINT_TYPE)),
		nested_callback(equals_impl(POINT_TYPE)),
		FunctionDecl(function_info("Hashable_hash_Point", 99, [], INT_TYPE, int_literal(0))),
	]))
	(
		find_runtime_callback(projected, HashableHashCallback, POINT_TYPE) == Some(HASH_IMPL_DEF_ID)
		and find_runtime_callback(nested, HashableHashCallback, POINT_TYPE) == Some(HASH_IMPL_DEF_ID)
		and find_runtime_callback(projected, EquatableEqualsCallback, POINT_TYPE) == Some(EQUALS_IMPL_DEF_ID)
		and find_runtime_callback(nested, EquatableEqualsCallback, POINT_TYPE) == Some(EQUALS_IMPL_DEF_ID)
		and nested.hashable_hash.length() == 1
		and nested.equatable_equals.length() == 1
	)


private pure func native_equality_count(program: CoreProgram, key_type: CoreType) -> Int:
	var count: Int = 0
	for decl in program.decls:
		match decl:
			FunctionDecl(function_info):
				match core_function_declared_origin(function_info.origin):
					NativeTagEqualityCallback(target):
						if target == key_type:
							count += 1
					_:
						void
			_:
				void
	count


func test_hash_only_scalar_mints_native_equality_once() -> Bool:
	key_type = UnionType("TagKey", ScalarTagValue)
	result = minted([hash_impl(key_type)])
	callbacks = build_runtime_callback_table(result.program)
	second = mint_hash_key_callbacks(result.program, result.next_def_id)
	(
		native_equality_count(result.program, key_type) == 1
		and result.next_def_id == FIRST_FREE_DEF_ID + 3
		and find_runtime_callback(callbacks, EquatableEqualsCallback, key_type) == Some(FIRST_FREE_DEF_ID)
		and native_equality_count(second.program, key_type) == 1
	)


tests: TestSuite = {
	description = "Core hash-key callback adapters",
	tests = [
		("hash-only scalar mints native equality once", test_hash_only_scalar_mints_native_equality_once),
		("callback identity survives impl projection", test_callback_identity_survives_impl_projection),
		("mints record pointer slot adapters", test_mints_record_slot_adapters),
		("mints nothing without hash impls", test_mints_nothing_without_hash_impls),
		("needs both impls to mint", test_needs_both_impls_to_mint),
		("mints nothing for runtime-hashed keys", test_mints_nothing_for_runtime_hashed_keys),
		("scalar defaults retain word fastpath", test_scalar_defaults_keep_word_fastpath),
		("native equality callback excludes primitives and managed unions", test_native_equality_callback_excludes_primitives_and_managed_unions),
		(
			"scalar authored pair binds word slot callbacks",
			test_scalar_authored_pair_binds_word_slot_callbacks,
		),
		(
			"scalar hash-only mints one native equality callback",
			test_scalar_hash_only_mints_one_native_equality_callback,
		),
		(
			"preprojection impl shares scalar callback policy",
			test_preprojection_impl_uses_same_scalar_callback_policy,
		),
		(
			"mints word slot adapters for impls on erased opaque types",
			test_mints_word_slot_adapters_for_impls_on_erased_opaque_types,
		),
		(
			"binds pinned constructor to impl adapters",
			test_binds_pinned_constructor_to_impl_adapters,
		),
		(
			"leaves pinned constructor without adapters unbound",
			test_leaves_pinned_constructor_without_adapters_unbound,
		),
		("rejects other pinned impl ids", test_rejects_other_pinned_impl_ids),
		("unboxes heap record slot as pointer", test_unboxes_heap_record_slot_as_pointer),
		("binds record key to minted adapters", test_binds_record_key_to_minted_adapters),
		(
			"leaves boxed key without adapters unbound",
			test_leaves_boxed_key_without_adapters_unbound,
		),
		(
			"refuses adapters with a different slot layout",
			test_refuses_adapters_with_a_different_slot_layout,
		),
		(
			"leaves pointer key without adapters unbound",
			test_leaves_pointer_key_without_adapters_unbound,
		),
	]
}
