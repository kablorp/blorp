import:
	../../../src/compiler/stage_02_lex/name_table: SYNTHESIZED_NAME_TABLE, synthesized_name_id
	../../../src/compiler/stage_09_core/function_origin_fixture:
		fixture_declaration_index,
		FIXTURE_NO_SOURCE_MODULE,
		fixture_mono_instance_of,
		fixture_source_function_origin_named,
	../../../src/compiler/stage_09_core/ir:
		CoreCallKind(IntrinsicCall, UserCall),
		CoreDeclarationIndex,
		CoreDecl(FunctionDecl),
		CoreDeclaredOrigin(ImplMethod),
		CoreFunction,
		CoreFunctionOrigin(Declared),
		CoreFunctionKind(UnresolvedBuiltinFunction),
		CoreImplMethodRole(OrdinaryImplMethod),
		CoreProgram,
		CoreExpr(BorrowLetExpr, CallExpr, LetExpr, LiteralExpr, SeqExpr, VarExpr),
		CoreLiteral(IntLiteral, StringLiteral),
		CoreSourceLoc,
		CoreSourceLocRow,
		core_source_loc_is_synthetic,
		core_source_loc_row_unresolved,
		pack_core_source_loc,
		synthetic_core_source_loc,
		CoreType(FunctionType, NamedType, VoidType),
		CoreBinderOrigin(AuthoredBinder),
		CoreVar,
		core_expr_type,
	../../../src/compiler/stage_09_core/string_pipeline: fuse_string_expr
	../../../src/compiler/stage_09_core/traverse: immediate_core_expr_children
	test: TestSuite


TY_INT: CoreType = NamedType("Int", [])

TY_STRING: CoreType = NamedType("String", [])


-- The `string` functions the fixture calls reach, by the callee name the call
-- site writes and the source member each is, with the definition id its callee
-- carries. `HasLength_length_String` is the `HasLength` method of `string`.
private STRING_FIXTURE_FUNCTIONS: List[(String, String)] = [
	("string__reverse", "reverse"),
	("string__trim", "trim"),
	("string__trim_left", "trim_left"),
	("string__trim_right", "trim_right"),
	("string__take_left", "take_left"),
	("string__drop_left", "drop_left"),
	("string__take_right", "take_right"),
	("string__drop_right", "drop_right"),
	("string__substring", "substring"),
	("string__replace", "replace"),
	("HasLength_length_String", "length"),
]

private FIXTURE_DECLARATION_ID_BASE: Int = 10

-- A callee name no fixture function has: the definition id of a call the
-- declaration index does not know.
private UNKNOWN_CALLEE_DEF_ID: Int = 1

private REVERSE_INSTANCE_DEF_ID: Int = 2


private pure func fixture_callee_def_id(name: String) -> Int:
	var found: Int = UNKNOWN_CALLEE_DEF_ID
	var index: Int = 0

	for entry in STRING_FIXTURE_FUNCTIONS:
		if entry[0] == name:
			found = FIXTURE_DECLARATION_ID_BASE + index

		index += 1

	found


private pure func fixture_string_function(name: String, member: String, def_id: Int) -> CoreFunction:
	{
		name = name,
		source_module = Some("string"),
		module = FIXTURE_NO_SOURCE_MODULE,
		type_params = [],
		params = [],
		return_type = VoidType,
		body = None,
		is_pure = True,
		origin = fixture_string_function_origin(name, member),
		function_kind = UnresolvedBuiltinFunction,
		def_id = def_id,
		loc = synthetic_core_source_loc()
	}


-- `length` is declared by `implements HasLength for String`; every other member
-- is a plain source function of the module.
private pure func fixture_string_function_origin(name: String, member: String) -> CoreFunctionOrigin:
	if name == "HasLength_length_String":
		Declared(
			ImplMethod(
				synthesized_name_id("HasLength"),
				synthesized_name_id(member),
				OrdinaryImplMethod,
			),
		)
	else:
		fixture_source_function_origin_named(member)


private pure func fixture_string_functions(extra: List[CoreFunction]) -> CoreProgram:
	var functions: List[CoreFunction] = []
	var index: Int = 0

	for entry in STRING_FIXTURE_FUNCTIONS:
		functions = functions.append(
			fixture_string_function(entry[0], entry[1], FIXTURE_DECLARATION_ID_BASE + index),
		)
		index += 1

	{
		decls = functions.concat(extra).map(pure func(function_info): FunctionDecl(function_info)),
		foreign_includes = [],
		source_files = []
	}


-- The declaration index of the fixture's `string` declarations, with no mono
-- instance or pure variant among them.
private pure func fixture_declarations() -> CoreDeclarationIndex:
	fixture_declaration_index(SYNTHESIZED_NAME_TABLE, fixture_string_functions([]))


private pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = None,
		origin = AuthoredBinder
	}


private pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, synthetic_core_source_loc())


private pure func user_call(name: String, args: List[CoreExpr], return_type: CoreType) -> CoreExpr:
	callee_type: CoreType = FunctionType(
		True,
		args.map(core_expr_type),
		return_type,
	)

	CallExpr(
		UserCall(name, Some(fixture_callee_def_id(name)), []),
		variable(name, callee_type),
		args,
		return_type,
		synthetic_core_source_loc(),
	)


private pure func reverse_call(source: CoreExpr) -> CoreExpr:
	user_call("string__reverse", [source], TY_STRING)


private pure func trim_call(source: CoreExpr) -> CoreExpr:
	user_call("string__trim", [source], TY_STRING)


private pure func take_left_call(source: CoreExpr, count: CoreExpr) -> CoreExpr:
	user_call(
		"string__take_left",
		[source, count],
		TY_STRING,
	)


private pure func substring_call(source: CoreExpr, start: CoreExpr, length: CoreExpr) -> CoreExpr:
	user_call(
		"string__substring",
		[source, start, length],
		TY_STRING,
	)


private pure func replace_call(source: CoreExpr, old: CoreExpr, new: CoreExpr) -> CoreExpr:
	user_call(
		"string__replace",
		[source, old, new],
		TY_STRING,
	)


private pure func length_call(source: CoreExpr) -> CoreExpr:
	user_call("HasLength_length_String", [source], TY_INT)


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), TY_INT, synthetic_core_source_loc())


private pure func string_literal(value: String) -> CoreExpr:
	LiteralExpr(StringLiteral(value), TY_STRING, synthetic_core_source_loc())


private pure func count_expr(
	expr: CoreExpr,
	predicate: pure (CoreExpr) -> Bool,
) -> Int:
	var count: Int = if predicate(expr):
		1
	else:
		0

	for child in immediate_core_expr_children(expr):
		count += count_expr(child, predicate)

	count


private pure func is_user_call_named(name: String, expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(UserCall(actual, _, _), _, _, _, _):
			actual == name
		_:
			False


private pure func count_user_call(name: String, expr: CoreExpr) -> Int:
	count_expr(expr, pure func(candidate: CoreExpr): is_user_call_named(name, candidate))


private pure func is_intrinsic_call_named(name: String, expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(IntrinsicCall(actual), _, _, _, _):
			actual == name
		_:
			False


private pure func count_intrinsic_call(name: String, expr: CoreExpr) -> Int:
	count_expr(expr, pure func(candidate: CoreExpr): is_intrinsic_call_named(name, candidate))


private pure func core_vars_equal(left: CoreVar, right: CoreVar) -> Bool:
	left.name == right.name and left.id == right.id and left.def_id == right.def_id


private pure func count_var_references(variable: CoreVar, expr: CoreExpr) -> Int:
	count_expr(expr, pure func(candidate: CoreExpr):
		match candidate:
			VarExpr(actual, _, _):
				core_vars_equal(variable, actual)
			_:
				False
	)


private pure func has_distinct_binding_for_rhs(expr: CoreExpr, target: CoreVar) -> Bool:
	match expr:
		LetExpr(binding, _, _, VarExpr(rhs, _, _), _):
			if core_vars_equal(rhs, target):
				not core_vars_equal(binding, target)
			else:
				immediate_core_expr_children(
					expr,
				).any(
					pure func(child): has_distinct_binding_for_rhs(child, target),
				)
		BorrowLetExpr(binding, _, VarExpr(rhs, _, _), _):
			if core_vars_equal(rhs, target):
				not core_vars_equal(binding, target)
			else:
				immediate_core_expr_children(
					expr,
				).any(
					pure func(child): has_distinct_binding_for_rhs(child, target),
				)
		_:
			immediate_core_expr_children(
				expr,
			).any(
				pure func(child): has_distinct_binding_for_rhs(child, target),
			)


pure func test_reverse_length_rewrites_to_source_length() -> Bool:
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), length_call(reverse_call(variable("source", TY_STRING))))

	count_user_call("string__reverse", fused) == 0 and count_intrinsic_call("string_len", fused) > 0


-- A call to a mono instance is read through the declaration its origin names,
-- whatever the instance is called, and a marker in a name proves nothing.
pure func test_mono_instance_of_reverse_is_read_through_its_declaration() -> Bool:
	instance_name: String = "string__reverse__instance_fixture"
	source: CoreExpr = variable("source", TY_STRING)
	reverse_instance: CoreExpr = CallExpr(
		UserCall(instance_name, Some(REVERSE_INSTANCE_DEF_ID), []),
		variable(instance_name, FunctionType(True, [TY_STRING], TY_STRING)),
		[source],
		TY_STRING,
		synthetic_core_source_loc(),
	)
	reverse_declaration: CoreFunction = fixture_string_function(
		"string__reverse",
		"reverse",
		fixture_callee_def_id("string__reverse"),
	)
	instance: CoreFunction = fixture_mono_instance_of(
		reverse_declaration,
		instance_name,
		REVERSE_INSTANCE_DEF_ID,
	)
	listed: CoreDeclarationIndex = fixture_declaration_index(
		SYNTHESIZED_NAME_TABLE,
		fixture_string_functions([instance]),
	)
	fused: CoreExpr = fuse_string_expr(listed, length_call(reverse_instance))
	unlisted: CoreExpr = fuse_string_expr(fixture_declarations(), length_call(reverse_instance))

	(
		count_user_call(instance_name, fused) == 0
		and count_user_call(instance_name, unlisted) == 1
	)


pure func test_trim_length_rewrites_without_materializing() -> Bool:
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), length_call(trim_call(variable("source", TY_STRING))))

	(
		count_user_call("string__trim", fused) == 0
		and count_intrinsic_call("string_get_byte", fused) > 0
	)


pure func test_composed_span_replace_length_rewrites_without_materializing() -> Bool:
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), 
		length_call(
			replace_call(
				take_left_call(trim_call(variable("source", TY_STRING)), int_literal(10)),
				string_literal("a"),
				string_literal("xy"),
			),
		),
	)

	(
		count_user_call("string__replace", fused) == 0
		and count_user_call("string__trim", fused) == 0
		and count_user_call("string__take_left", fused) == 0
		and count_intrinsic_call("string_get_byte", fused) > 0
	)


pure func test_composed_span_replace_materializes_once() -> Bool:
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), 
		replace_call(
			take_left_call(trim_call(variable("source", TY_STRING)), int_literal(5)),
			string_literal("a"),
			string_literal("xy"),
		),
	)

	(
		count_user_call("string__replace", fused) == 0
		and count_user_call("string__trim", fused) == 0
		and count_user_call("string__take_left", fused) == 0
		and count_intrinsic_call("string_alloc", fused) > 0
		and count_intrinsic_call("string_copy_bytes", fused) > 0
	)


pure func test_composed_span_materializes_once() -> Bool:
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), 
		take_left_call(
			trim_call(variable("source", TY_STRING)),
			int_literal(5),
		),
	)

	(
		count_user_call("string__trim", fused) == 0
		and count_user_call("string__take_left", fused) == 0
		and count_intrinsic_call("string_alloc", fused) > 0
		and count_intrinsic_call("string_copy_bytes", fused) > 0
	)


pure func test_long_window_reverse_chain_preserves_fusion() -> Bool:
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), 
		reverse_call(
			substring_call(
				take_left_call(trim_call(variable("source", TY_STRING)), int_literal(9)),
				int_literal(1),
				int_literal(4),
			),
		),
	)

	(
		count_user_call("string__reverse", fused) == 0
		and count_user_call("string__substring", fused) == 0
		and count_user_call("string__take_left", fused) == 0
		and count_user_call("string__trim", fused) == 0
		and count_intrinsic_call("string_alloc", fused) == 1
		and count_intrinsic_call("string_set_byte", fused) > 0
	)


pure func test_composed_span_reverse_materializes_once() -> Bool:
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), reverse_call(trim_call(variable("source", TY_STRING))))

	(
		count_user_call("string__reverse", fused) == 0
		and count_user_call("string__trim", fused) == 0
		and count_intrinsic_call("string_alloc", fused) > 0
		and count_intrinsic_call("string_set_byte", fused) > 0
	)


pure func test_materialized_window_borrows_existing_source_alias() -> Bool:
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), 
		substring_call(
			variable("source", TY_STRING),
			int_literal(0),
			int_literal(3),
		),
	)

	match fused:
		BorrowLetExpr(_, _, VarExpr(source, _, _), _):
			source.name == "source"
		_:
			False


pure func test_materialized_window_owns_non_variable_source() -> Bool:
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), 
		substring_call(
			string_literal("abcdef"),
			int_literal(0),
			int_literal(3),
		),
	)

	match fused:
		LetExpr(_, _, _, LiteralExpr(StringLiteral("abcdef"), _, _), _):
			True
		_:
			False


pure func test_replace_then_trim_length_is_not_rewritten() -> Bool:
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), 
		length_call(
			trim_call(
				replace_call(
					variable("source", TY_STRING),
					string_literal("a"),
					string_literal(" "),
				),
			),
		),
	)

	count_user_call("string__replace", fused) == 1 and count_user_call("string__trim", fused) == 1


pure func test_reverse_then_replace_length_is_not_rewritten() -> Bool:
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), 
		length_call(
			replace_call(
				reverse_call(variable("source", TY_STRING)),
				string_literal("ab"),
				string_literal("x"),
			),
		),
	)

	(
		count_user_call("string__reverse", fused) == 1
		and count_user_call("string__replace", fused) == 1
	)


pure func test_reverse_then_same_width_replace_length_rewrites() -> Bool:
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), 
		length_call(
			replace_call(
				reverse_call(variable("source", TY_STRING)),
				string_literal("l"),
				string_literal("L"),
			),
		),
	)

	(
		count_user_call("string__reverse", fused) == 0
		and count_user_call("string__replace", fused) == 0
		and count_intrinsic_call("string_len", fused) > 0
	)


pure func test_plain_string_length_rewrites_to_intrinsic() -> Bool:
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), length_call(variable("source", TY_STRING)))

	(
		count_user_call("HasLength_length_String", fused) == 0
		and count_intrinsic_call("string_len", fused) == 1
	)


pure func test_plain_string_length_preserves_call_location() -> Bool:
	loc: CoreSourceLoc = pack_core_source_loc(0, 29, 10, 29, 18)
	call: CoreExpr = length_call(variable("source", TY_STRING))

	positioned: CoreExpr = match call:
		CallExpr(kind, callee, args, typ, _):
			CallExpr(kind, callee, args, typ, loc)
		_:
			call

	match fuse_string_expr(fixture_declarations(), positioned):
		CallExpr(IntrinsicCall("string_len"), _, _, _, result_loc):
			row: CoreSourceLocRow = core_source_loc_row_unresolved(result_loc)
			not core_source_loc_is_synthetic(result_loc) and row.start_line == 29 and row.start_column == 10
		_:
			False


pure func test_user_defined_length_is_not_rewritten() -> Bool:
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), user_call("length", [variable("source", TY_STRING)], TY_INT))

	count_user_call("length", fused) == 1 and count_intrinsic_call("string_len", fused) == 0


pure func test_bound_reverse_is_not_rewritten_as_pipeline() -> Bool:
	temp: CoreVar = core_var("temp")
	bound: CoreExpr = LetExpr(
		temp,
		False,
		TY_STRING,
		reverse_call(variable("source", TY_STRING)),
		length_call(VarExpr(temp, TY_STRING, synthetic_core_source_loc())),
	)

	match fuse_string_expr(fixture_declarations(), bound):
		LetExpr(_, _, _, CallExpr(UserCall("string__reverse", _, _), _, _, _, _), CallExpr(IntrinsicCall("string_len"), _, _, _, _)):
			True
		_:
			False


pure func test_empty_needle_length_fusion_preserves_argument_evaluation() -> Bool:
	effectful_replacement: CoreExpr = user_call("effectful_string", [], TY_STRING)
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), 
		length_call(
			replace_call(
				reverse_call(variable("source", TY_STRING)),
				string_literal(""),
				effectful_replacement,
			),
		),
	)

	(
		count_user_call("string__reverse", fused) == 0
		and count_user_call("string__replace", fused) == 0
		and count_user_call("effectful_string", fused) == 1
	)


pure func test_generated_source_alias_does_not_capture_user_binding() -> Bool:
	user_source: CoreVar = core_var("__sp_source_1")
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), 
		take_left_call(
			VarExpr(user_source, TY_STRING, synthetic_core_source_loc()),
			int_literal(2),
		),
	)

	match fused:
		BorrowLetExpr(binding, _, VarExpr(rhs, _, _), _):
			(
				core_vars_equal(rhs, user_source)
				and not core_vars_equal(binding, user_source)
				and binding.id > 0
			)
		_:
			False


pure func test_generated_stage_binding_does_not_capture_user_binding() -> Bool:
	user_count: CoreVar = core_var("__sp_take_n_2")
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), 
		take_left_call(
			variable("source", TY_STRING),
			VarExpr(user_count, TY_INT, synthetic_core_source_loc()),
		),
	)

	has_distinct_binding_for_rhs(fused, user_count)


pure func test_separated_materializations_have_distinct_bound_ids() -> Bool:
	left_source: CoreVar = core_var("left_source")
	right_source: CoreVar = core_var("right_source")
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), 
		SeqExpr(
			take_left_call(VarExpr(left_source, TY_STRING, synthetic_core_source_loc()), int_literal(2)),
			SeqExpr(
				user_call("opaque_string", [variable("middle", TY_STRING)], TY_STRING),
				take_left_call(VarExpr(right_source, TY_STRING, synthetic_core_source_loc()), int_literal(3)),
			),
		),
	)

	match fused:
		SeqExpr(
			BorrowLetExpr(left_binding, _, VarExpr(left_rhs, _, _), left_body),
			SeqExpr(
				middle,
				BorrowLetExpr(right_binding, _, VarExpr(right_rhs, _, _), right_body),
			),
		):
			(
				is_user_call_named("opaque_string", middle)
				and core_vars_equal(left_rhs, left_source)
				and core_vars_equal(right_rhs, right_source)
				and left_binding.id != right_binding.id
				and count_var_references(left_binding, left_body) > 0
				and count_var_references(right_binding, right_body) > 0
			)
		_:
			False


---
Each successful fusion seeds its fresh vars from its own
`string_pipeline_id_band(fusion_index)`, so a materialization at
`fusion_index = 0` and one at `fusion_index = 1` both mint their first
fresh var from a local count of 1 within their own band -- values that
coincide modulo the band (`STRING_PIPELINE_ID_BAND`, one million) even
though the underlying ids differ by exactly one band. `fresh_var` used to
spell that reduced, mod-banded count instead of the id itself, so both
sites minted the identical `$blorp$string_pipeline$6$source$1` name once
both landed in one function -- a duplicate C declaration once the
combining `SeqExpr` reached one translation unit. Spelling the full id
keeps the two names apart.
---
pure func test_fresh_var_names_differ_across_fusion_sites_in_one_expression() -> Bool:
	first_window: CoreExpr = substring_call(string_literal("abcdef"), int_literal(0), int_literal(3))
	second_window: CoreExpr = substring_call(string_literal("ghijkl"), int_literal(0), int_literal(3))
	fused: CoreExpr = fuse_string_expr(fixture_declarations(), SeqExpr(first_window, second_window))

	match fused:
		SeqExpr(LetExpr(first_source, _, _, _, _), LetExpr(second_source, _, _, _, _)):
			first_source.name != second_source.name
		_:
			False


tests: TestSuite = {
	description = "Blorp compiler string pipeline",
	tests = [
		("reverse length uses source length", test_reverse_length_rewrites_to_source_length),
		(
			"mono instance is read through its declaration",
			test_mono_instance_of_reverse_is_read_through_its_declaration,
		),
		("trim length avoids materialization", test_trim_length_rewrites_without_materializing),
		(
			"span replace length avoids materialization",
			test_composed_span_replace_length_rewrites_without_materializing,
		),
		("span replace materializes once", test_composed_span_replace_materializes_once),
		("span materializes once", test_composed_span_materializes_once),
		("long window reverse chain fuses", test_long_window_reverse_chain_preserves_fusion),
		("span reverse materializes once", test_composed_span_reverse_materializes_once),
		("existing source is borrowed", test_materialized_window_borrows_existing_source_alias),
		("computed source is owned", test_materialized_window_owns_non_variable_source),
		("unsafe replace trim remains", test_replace_then_trim_length_is_not_rewritten),
		("unsafe reverse replace remains", test_reverse_then_replace_length_is_not_rewritten),
		("same-width replace length fuses", test_reverse_then_same_width_replace_length_rewrites),
		("plain length uses intrinsic", test_plain_string_length_rewrites_to_intrinsic),
		("plain length preserves location", test_plain_string_length_preserves_call_location),
		("user length remains", test_user_defined_length_is_not_rewritten),
		("bound producer remains materialized", test_bound_reverse_is_not_rewritten_as_pipeline),
		(
			"empty needle length preserves argument evaluation",
			test_empty_needle_length_fusion_preserves_argument_evaluation,
		),
		(
			"generated source alias is hygienic",
			test_generated_source_alias_does_not_capture_user_binding,
		),
		(
			"generated stage binding is hygienic",
			test_generated_stage_binding_does_not_capture_user_binding,
		),
		(
			"separated materializations have distinct bound ids",
			test_separated_materializations_have_distinct_bound_ids,
		),
		(
			"fresh var names differ across fusion sites in one expression",
			test_fresh_var_names_differ_across_fusion_sites_in_one_expression,
		),
	]
}
