import:
	../../../benchmark/compiler/compiler_core_pipeline_work_profile_fixture:
		CompilerCorePipelineWorkProfileConfig,
		CompilerCorePipelineWorkProfileResult,
		compiler_core_pipeline_work_profile_run,
	test: TestSuite


private pure func small_config(pass_name: String) -> CompilerCorePipelineWorkProfileConfig:
	{
		iterations = 1,
		pass_name = pass_name,
		function_count = 4,
		expression_nodes_per_function = 8,
		union_count = 4,
		alias_count = 2,
		callable_declaration_count = 4,
		call_density = 2,
		union_match_density = 4,
		duplicate_name_interval = 2
	}


private func test_work_profile_reflects_fixture_shape() -> Bool:
	config = small_config("match_projection")
	result: CompilerCorePipelineWorkProfileResult = compiler_core_pipeline_work_profile_run(config)
	observation = result.observation

	(
		result.workload_valid
		and observation.pass_name == "match_projection"
		and observation.input_declarations == observation.input_function_count + observation.input_union_count + observation.input_alias_count
		and observation.input_function_count == config.function_count
		and observation.input_union_count == config.union_count
		and observation.input_alias_count == config.alias_count
		and observation.input_expression_roots == observation.input_function_count
		and observation.input_expression_nodes > 0
		and observation.input_call_expr_count > 0
		and observation.input_semantic_match_count > 0
		and observation.declaration_lookup_queries == observation.input_semantic_match_count
		and observation.declaration_lookup_candidates_inspected >= observation.declaration_lookup_queries
	)


private func test_work_profile_reproduces_fixture_workload_checksums() -> Bool:
	result: CompilerCorePipelineWorkProfileResult = compiler_core_pipeline_work_profile_run(
		small_config("match_projection"),
	)
	observation = result.observation

	(
		result.workload_valid
		and observation.input_call_expr_count > 0
		and observation.input_semantic_match_count > 0
		and observation.input_constructor_match_count == 0
		and observation.workload_checksum == -1646294515644582960
		and observation.output_expression_nodes == observation.input_expression_nodes
		-- Serialized Core JSON character length, not the semantic workload checksum.
		-- Common storage and tag-access fields add 104 + 140 + 136 characters.
		and observation.output_checksum == 13796
		and observation.declaration_lookup_queries == observation.input_semantic_match_count
		and observation.declaration_lookup_candidates_inspected == observation.declaration_lookup_queries
	)


private func test_non_match_pass_uses_same_schema_without_lookup_pressure() -> Bool:
	result: CompilerCorePipelineWorkProfileResult = compiler_core_pipeline_work_profile_run(
		small_config("consume_specialize"),
	)
	observation = result.observation

	(
		result.workload_valid
		and observation.pass_name == "consume_specialize"
		and observation.input_declarations > 0
		and observation.declaration_lookup_queries == 0
		and observation.declaration_lookup_candidates_inspected == 0
		and observation.output_checksum > 0
	)


tests: TestSuite = {
	description = "Compiler Core pipeline work profile benchmark",
	tests = [
		("work profile reflects fixture shape", test_work_profile_reflects_fixture_shape),
		(
			"work profile reproduces fixture workload checksums",
			test_work_profile_reproduces_fixture_workload_checksums,
		),
		(
			"non-match pass uses same schema without lookup pressure",
			test_non_match_pass_uses_same_schema_without_lookup_pressure,
		),
	]
}
