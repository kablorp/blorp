import:
	../../../src/compiler/stage_03_parse/parsed_ast: MAX_UNION_VARIANT_FIELDS
	../../../src/compiler/stage_09_core/release_mask:
		RELEASE_MASK_WORD_BITS,
		release_mask_bit,
		release_mask_first_word,
		release_mask_word_at,
		release_mask_word_count,
		release_mask_word_has_bit,
		release_mask_words,
	test: TestSuite


SIGN_BIT_WORD: Int = -9223372036854775807 - 1


func owns_every_slot(count: Int) -> List[Bool]:
	var slots: List[Bool] = []

	for index in 0..count:
		slots = slots.append(True)

	slots


func owns_only_slot(count: Int, owned: Int) -> List[Bool]:
	var slots: List[Bool] = []

	for index in 0..count:
		slots = slots.append(index == owned)

	slots


func test_parser_limit_matches_mask_word_width() -> Bool:
	MAX_UNION_VARIANT_FIELDS == RELEASE_MASK_WORD_BITS


func test_bit_values_wrap_into_the_sign_bit() -> Bool:
	release_mask_bit(0) == 1 and release_mask_bit(62) == 4611686018427387904 and release_mask_bit(63) == SIGN_BIT_WORD


func test_word_count_rounds_up_per_64_slots() -> Bool:
	(
		release_mask_word_count(0) == 0
		and release_mask_word_count(1) == 1
		and release_mask_word_count(64) == 1
		and release_mask_word_count(65) == 2
		and release_mask_word_count(128) == 2
		and release_mask_word_count(129) == 3
	)


func test_full_word_is_all_ones() -> Bool:
	release_mask_words(owns_every_slot(64)) == [-1]


func test_slot_64_starts_the_second_word() -> Bool:
	release_mask_words(owns_only_slot(65, 64)) == [0, 1]


func test_slot_63_is_the_sign_bit_of_the_first_word() -> Bool:
	release_mask_words(owns_only_slot(64, 63)) == [SIGN_BIT_WORD]


func test_third_word_holds_slot_128() -> Bool:
	release_mask_words(owns_only_slot(129, 128)) == [0, 0, 1]


func test_no_slots_have_no_words() -> Bool:
	nothing: List[Bool] = []
	empty_words: List[Int] = []
	release_mask_words(nothing) == empty_words and release_mask_first_word(nothing) == 0


func test_first_word_of_a_wider_list_covers_only_the_first_64_slots() -> Bool:
	release_mask_first_word(owns_only_slot(65, 64)) == 0 and release_mask_first_word(owns_only_slot(65, 0)) == 1


func test_word_lookup_past_the_end_owns_nothing() -> Bool:
	words: List[Int] = release_mask_words(owns_only_slot(65, 64))
	release_mask_word_at(words, 1) == 1 and release_mask_word_at(words, 2) == 0


func test_bit_lookup_agrees_with_construction_for_every_bit() -> Bool:
	var agrees: Bool = True

	for slot in 0..64:
		word: Int = release_mask_first_word(owns_only_slot(64, slot))

		for probe in 0..64:
			if release_mask_word_has_bit(word, probe) != (probe == slot):
				agrees = False

	agrees


func test_bit_lookup_on_a_full_word() -> Bool:
	full: Int = release_mask_first_word(owns_every_slot(64))
	var every_bit_set: Bool = True

	for index in 0..64:
		if not release_mask_word_has_bit(full, index):
			every_bit_set = False

	every_bit_set


tests: TestSuite = {
	description = "Release mask words",
	tests = [
		("parser field limit equals the mask word width", test_parser_limit_matches_mask_word_width),
		("bit 63 is the wrapped sign bit", test_bit_values_wrap_into_the_sign_bit),
		("word count rounds up per 64 slots", test_word_count_rounds_up_per_64_slots),
		("64 owning slots fill one word", test_full_word_is_all_ones),
		("slot 64 starts the second word", test_slot_64_starts_the_second_word),
		("slot 63 is the sign bit of the first word", test_slot_63_is_the_sign_bit_of_the_first_word),
		("slot 128 starts the third word", test_third_word_holds_slot_128),
		("no slots have no words", test_no_slots_have_no_words),
		("the first word of a wider list covers only 64 slots", test_first_word_of_a_wider_list_covers_only_the_first_64_slots),
		("word lookup past the end owns nothing", test_word_lookup_past_the_end_owns_nothing),
		("bit lookup agrees with construction for every bit", test_bit_lookup_agrees_with_construction_for_every_bit),
		("bit lookup on a full word", test_bit_lookup_on_a_full_word),
	]
}
