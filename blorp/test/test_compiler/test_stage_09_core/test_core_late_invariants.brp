pure func test_final_boundary_rejects_same_named_methods_from_distinct_impls() -> Bool:
	match program_with_body(literal(1)).decls:
		[FunctionDecl(method)]:
			left_impl: CoreImplDecl = {
				trait_name = "Example",
				for_type = NamedType("Left", []),
				type_params = [],
				methods = [
					{ method |
						name = "same",
						def_id = 50
					},
				],
				loc = synthetic_core_source_loc()
			}
			right_impl: CoreImplDecl = { left_impl | for_type = NamedType("Right", []) }
			program: CoreProgram = {
				decls = [ImplDecl(left_impl), ImplDecl(right_impl)],
				foreign_includes = [],
				source_files = []
			}

			match check_late_core_invariants(FinalStage, program):
				[DuplicateDefinitionId(50, first_owner, second_owner)]:
					first_owner.contains("Left") and second_owner.contains("Right")
				_:
					False
		_:
			False


--- `keep(value)` with the argument handed over as `consumed_args` says.
pure func keep_call(consumed_args: List[Int]) -> CoreExpr:
	CallExpr(
		UserCall("keep", Some(2), consumed_args),
		VarExpr(variable("keep"), int_type(), synthetic_core_source_loc()),
		[literal(1)],
		int_type(),
		synthetic_core_source_loc(),
	)


pure func program_calling_keep(first: List[Int], second: List[Int]) -> CoreProgram:
	main_program: CoreProgram = program_with_body(SeqExpr(keep_call(first), keep_call(second)))
	keep: CoreFunction = {
		name = "keep",
		source_module = None,
		type_params = [],
		params = [{
			name = variable("value"),
			typ = int_type(),
			loc = synthetic_core_source_loc()
		}],
		return_type = int_type(),
		body = Some(literal(0)),
		is_pure = True,
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = UserFunction,
		def_id = 2,
		loc = synthetic_core_source_loc()
	}
	{ main_program | decls = main_program.decls.append(FunctionDecl(keep)) }


pure func is_disagreeing_contract(violation: CoreLateInvariantViolation) -> Bool:
	match violation:
		DisagreeingUserCallContract(_, _, _, _, _):
			True
		_:
			False


pure func has_disagreeing_contract(program: CoreProgram) -> Bool:
	check_late_core_invariants(FinalStage, program).any(is_disagreeing_contract)


---
The cancellation planner gives a callee an entry slot for the arguments its
calls hand over, and each caller pops its own slot for them, so every call of
one function must hand over the same arguments.
---
pure func test_final_boundary_rejects_disagreeing_user_call_contracts() -> Bool:
	(
		has_disagreeing_contract(program_calling_keep([0], []))
		and not has_disagreeing_contract(program_calling_keep([0], [0]))
		and not has_disagreeing_contract(program_calling_keep([], []))
	)


-- Completed final Core legitimately holds the forms built after Perceus, so
-- the boundary rule must stay out of the final-stage audit.
pure func has_perceus_boundary_violation(violations: List[CoreLateInvariantViolation]) -> Bool:
	violations.any(func(violation):
		match violation:
			FormBuiltAfterPerceusSurvived(_, _) | FormErasedBeforePerceusSurvived(_, _):
				True
			_:
				False
	)


-- The Perceus borrowed-payload walk skips forms that cannot reach it, so the
-- Perceus boundary rejects them instead of letting the walk pass over them.
pure func test_perceus_boundary_rejects_forms_outside_the_pass_window() -> Bool:
	detached: CoreExpr = DetachExpr(
		{ def_id = 2, captures = [], return_type = VoidType },
		VoidType,
		synthetic_core_source_loc(),
	)
	raw_dict: CoreExpr = DictExpr([], NamedType("Dict", []), synthetic_core_source_loc())

	(
		match check_late_core_invariants(PerceusStage, program_with_body(detached)):
			[FormBuiltAfterPerceusSurvived("DetachExpr", _)]:
				True
			_:
				False
		and match check_late_core_invariants(PerceusStage, program_with_body(raw_dict)):
			[FormErasedBeforePerceusSurvived("DictExpr", _)]:
				True
			_:
				False
		and check_late_core_invariants(DceStage, program_with_body(detached)).is_empty()
		and check_late_core_invariants(ReuseStage, program_with_body(detached)).is_empty()
		and not has_perceus_boundary_violation(
			check_late_core_invariants(FinalStage, program_with_body(detached)),
		)
	)



pure func test_union_storage_invariant_rejects_payload_on_scalar() -> Bool:
	base: CoreProgram = program_with_body(literal(0))
	invalid: CoreProgram = { base | decls = base.decls.append(UnionDecl({
		abi_type = None,
		name = "Color",
		type_params = [],
		storage = ScalarTagStorage,
		variants = [{
			name = "Red", tag = 0, def_id = Some(101),
			fields = [{ typ = int_type(), release_policy = NoReleasePolicy }]
		}],
		loc = synthetic_core_source_loc()
	})) }
	match check_late_core_invariants(DceStage, invalid):
		[UnionStorageViolation(reason)]:
			reason == "union `Color`: scalar union storage requires payload-free variants"
		_:
			False


pure func test_union_storage_invariant_checks_declared_type_identity() -> Bool:
	base: CoreProgram = program_with_body(
		VarExpr(variable("color"), UnionType("Color", ScalarTagValue), synthetic_core_source_loc()),
	)
	invalid: CoreProgram = { base | decls = base.decls.append(UnionDecl({
		abi_type = None, name = "Color", type_params = [],
		storage = ManagedPayloadStorage(TypedUnionPayloadStorage),
		variants = [{ name = "Red", tag = 0, def_id = Some(101), fields = [] }],
		loc = synthetic_core_source_loc()
	})) }
	match check_late_core_invariants(DceStage, invalid):
		[UnionStorageViolation(reason)]:
			reason == "union type storage disagrees with declaration `Color`"
		_:
			False


tests: TestSuite = {
	description = "Blorp late Core invariants",
	tests = [
		("Union storage rejects payload on scalar", test_union_storage_invariant_rejects_payload_on_scalar),
		("Union storage agrees with declared type identity", test_union_storage_invariant_checks_declared_type_identity),
		(
			"Perceus boundary rejects forms outside the pass window",
			test_perceus_boundary_rejects_forms_outside_the_pass_window,
		),
		(
			"final boundary rejects disagreeing user call contracts",
			test_final_boundary_rejects_disagreeing_user_call_contracts,
		),
		(
			"DCE boundary requires named releasing match scrutinee",
			test_releasing_match_requires_named_scrutinee_at_dce,
		),
		("record update boundary starts at Perceus", test_record_update_boundary_starts_at_perceus),
		("closure boundary rejects lambda", test_closure_boundary_rejects_lambda),
		("composite tail boundary rejects lambda", test_composite_tail_boundary_rejects_lambda),
		(
			"closure boundary rejects pre-closure detach",
			test_closure_boundary_rejects_preclosure_detach,
		),
		(
			"closure boundary rejects pre-closure concurrent block",
			test_closure_boundary_rejects_preclosure_concurrent_block,
		),
		(
			"closure boundary rejects pre-closure concurrent loop",
			test_closure_boundary_rejects_preclosure_concurrent_loop,
		),
		("final boundary rejects unresolved call", test_final_boundary_rejects_unresolved_call),
		("final boundary rejects debug block", test_final_boundary_rejects_debug_block),
		(
			"final boundary rejects nested debug block",
			test_final_boundary_rejects_nested_debug_block,
		),
		("final boundary rejects raw match", test_final_boundary_rejects_raw_match),
		("final boundary rejects semantic match", test_final_boundary_rejects_semantic_match),
		("final boundary rejects raw tuple", test_final_boundary_rejects_raw_tuple),
		("final boundary rejects raw vector", test_final_boundary_rejects_raw_vector),
		("final boundary rejects raw dictionary", test_final_boundary_rejects_raw_dict),
		(
			"final boundary rejects product without record type",
			test_final_boundary_rejects_product_without_record_type,
		),
		(
			"final boundary rejects product of an undeclared record",
			test_final_boundary_rejects_product_of_an_undeclared_record,
		),
		(
			"final boundary rejects product short of its fields",
			test_final_boundary_rejects_product_short_of_its_fields,
		),
		("Perceus boundary rejects product field evaluation", test_perceus_boundary_rejects_product_field_evaluation),
		("Perceus boundary rejects evaluable reuse source", test_perceus_boundary_rejects_evaluable_record_reuse_source),
		("Perceus boundary accepts named product ownership wrappers", test_perceus_boundary_accepts_named_product_ownership_wrappers),
		("final boundary accepts product with every field", test_final_boundary_accepts_product_with_every_field),
		("final boundary rejects record reuse short of its fields", test_final_boundary_rejects_record_reuse_short_of_its_fields),
		("final boundary accepts record reuse with every field", test_final_boundary_accepts_record_reuse_with_every_field),
		("final boundary accepts prepared tuple", test_final_boundary_accepts_prepared_tuple),
		(
			"final boundary rejects missing ownership contract",
			test_final_boundary_rejects_missing_ownership_contract,
