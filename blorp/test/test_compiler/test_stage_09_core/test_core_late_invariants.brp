private pure func checkpoint_loop_variants(iterable: CoreExpr, body: CoreExpr) -> List[CoreExpr]:
	binder: CoreLoopBinder = {
		variable = variable("item"), typ = int_type(), range_direction = RangeForwardOnly
	}
	loc = synthetic_core_source_loc()
	[
		ForChannelExpr({binder = binder, iterable = iterable, body = body}, VoidType, loc),
		ForListExpr({
			binder = binder, layout = PointerListStorage, iterable = iterable,
			iterable_release_policy = NoReleasePolicy, body = body
		}, VoidType, loc),
		ForStringExpr({
			binder = binder, iterable = iterable, iterable_release_policy = NoReleasePolicy, body = body
		}, VoidType, loc),
		ForDictExpr({
			iteration_mode = CoreDictIterationKeys,
			binder = binder, iterable = iterable, iterable_release_policy = NoReleasePolicy, body = body
		}, VoidType, loc),
		ForSetExpr({
			binder = binder, iterable = iterable, iterable_release_policy = NoReleasePolicy, body = body
		}, VoidType, loc),
		ForStreamExpr({
			binder = binder, iterable = iterable, iterable_release_policy = NoReleasePolicy, body = body
		}, VoidType, loc),
		ForResourceSourceExpr({
			binder = binder, iterable = iterable, iterable_release_policy = NoReleasePolicy, body = body
		}, VoidType, loc),
		ForTensorExpr({
			binder = binder, element_storage = TensorForRawScalarElement(TensorInt64Elements),
			iterable = iterable, iterable_release_policy = NoReleasePolicy, body = body
		}, VoidType, loc),
	]


private pure func misplaced_checkpoint_count(expr: CoreExpr) -> Int:
	check_late_core_invariants(FinalStage, program_with_body(expr)).filter(func(violation):
		match violation:
			CooperativeCheckpointMisplaced(_): True
			_: False
	).length()


pure func test_all_iterable_loop_layouts_distinguish_checkpoint_body_from_iterable() -> Bool:
	checkpoint = CooperativeCheckpointExpr(VoidType, synthetic_core_source_loc())
	body_checkpoint_loops = checkpoint_loop_variants(literal(1), checkpoint)
	iterable_checkpoint_loops = checkpoint_loop_variants(checkpoint, literal(0))
	(
		body_checkpoint_loops.length() == 8
		and iterable_checkpoint_loops.length() == 8
		and body_checkpoint_loops.all(func(loop): misplaced_checkpoint_count(loop) == 0)
		and iterable_checkpoint_loops.all(func(loop): misplaced_checkpoint_count(loop) == 1)
	)


private pure func scope_nonlocal_exit_count(loop: CoreExpr) -> Int:
	check_late_core_invariants(
		FinalStage, program_with_body(resource_scope_with_body(loop)),
	).filter(func(violation):
		match violation:
			ResourceContractViolation(detail, _):
				detail == "scope body contains nonlocal control flow before cleanup rewriting"
			_: False
	).length()


pure func test_all_iterable_loop_layouts_reject_resource_exit_in_iterable() -> Bool:
	loops = checkpoint_loop_variants(
		BreakExpr(VoidType, synthetic_core_source_loc()),
		VoidExpr(VoidType, synthetic_core_source_loc()),
	)
	loops.length() == 8 and loops.all(func(loop): scope_nonlocal_exit_count(loop) == 1)


pure func test_all_iterable_loop_layouts_allow_loop_local_resource_body_exit() -> Bool:
	loops = checkpoint_loop_variants(
		literal(1), BreakExpr(VoidType, synthetic_core_source_loc()),
	)
	loops.length() == 8 and loops.all(func(loop): scope_nonlocal_exit_count(loop) == 0)


