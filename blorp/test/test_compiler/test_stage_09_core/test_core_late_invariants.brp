pure func test_final_boundary_rejects_definition_id_owned_by_two_functions() -> Bool:
	match program_with_body(literal(1)).decls:
		[FunctionDecl(first)]:
			second = { first | name = "other" }
			program: CoreProgram = {
				decls = [FunctionDecl(first), FunctionDecl(second)],
				foreign_includes = [],
				source_files = []
			}

			match check_late_core_invariants(FinalStage, program):
				[DuplicateDefinitionId(1, first_owner, second_owner)]:
					first_owner.contains("main") and second_owner.contains("other")
				_:
					False
		_:
			False


pure func hash_callback_function(name: String, def_id: Int, for_type: CoreType) -> CoreFunction:
	{
		name = name,
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(literal(1)),
		is_pure = True,
		origin = Declared(
			ProjectedImplMethod(
				synthesized_name_id("_"),
				synthesized_name_id("_"),
				for_type,
				RuntimeCallbackMethod(HashableHashCallback),
			),
		),
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = UserFunction,
		def_id = def_id,
		loc = synthetic_core_source_loc(),
	}


pure func test_final_boundary_rejects_two_functions_implementing_one_callback_on_one_type() -> Bool:
	key_type: CoreType = NamedType("Key", [])
	program: CoreProgram = {
		decls = [
			FunctionDecl(hash_callback_function("Hashable_hash_Key", 2, key_type)),
			FunctionDecl(hash_callback_function("other_hash_of_Key", 3, key_type)),
		],
		foreign_includes = [],
		source_files = []
	}

	match check_definition_id_uniqueness(program):
		[DuplicateRuntimeCallback(role, type_key, first, second)]:
			(
				role == "Hashable.hash"
				and type_key == "Key"
				and first == "Hashable_hash_Key"
				and second == "other_hash_of_Key"
			)
		_:
			False


