pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func variable(name: String) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = None,
		origin = AuthoredBinder
	}


pure func literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), int_type(), synthetic_core_source_loc())


pure func program_with_body(body: CoreExpr) -> CoreProgram:
	{
		decls = [FunctionDecl({
				name = "main",
				source_module = None,
				type_params = [],
				params = [],
				return_type = int_type(),
				body = Some(body),
				is_pure = True,
				origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
				module = FIXTURE_NO_SOURCE_MODULE,
				function_kind = UserFunction,
				def_id = 1,
				loc = synthetic_core_source_loc(),
			})],
		foreign_includes = [],
		source_files = []
	}


pure func record_update_program() -> CoreProgram:
	point_type: CoreType = NamedType("Point", [])
	point: CoreVar = variable("point")
	program_with_body(
		RecordUpdateExpr(
			VarExpr(point, point_type, synthetic_core_source_loc()),
			[],
			point_type,
			synthetic_core_source_loc(),
		),
	)


pure func releasing_match_program(scrutinee: CoreExpr) -> CoreProgram:
	program_with_body(
		ConstructorMatchExpr(
			scrutinee,
			ArcReleasePolicy,
			[],
			ConstructorMatchFallbackFail,
			int_type(),
			synthetic_core_source_loc(),
		),
	)


pure func test_releasing_match_requires_named_scrutinee_at_dce() -> Bool:
	union_type: CoreType = UnionType("Choice", ManagedUnionValue)
	invalid: CoreProgram = releasing_match_program(
		CallExpr(
			IntrinsicCall("make_choice"),
			VarExpr(
				variable("make_choice"),
				FunctionType(True, [], union_type),
				synthetic_core_source_loc(),
			),
			[],
			union_type,
			synthetic_core_source_loc(),
		),
	)
	valid: CoreProgram = releasing_match_program(
		VarExpr(
			variable("choice"),
			union_type,
			synthetic_core_source_loc(),
		),
	)

	match check_late_core_invariants(DceStage, invalid):
		[ManagedMatchScrutineeUnmaterialized(_)]:
			check_late_core_invariants(DceStage, valid).is_empty()
		_:
			False


pure func test_record_update_boundary_starts_at_perceus() -> Bool:
	(
		check_late_core_invariants(DceStage, record_update_program()).is_empty()
		and match check_late_core_invariants(PerceusStage, record_update_program()):
			[RecordUpdateSurvived(_)]:
				match check_late_core_invariants(PostDceTailStage, record_update_program()):
					[RecordUpdateSurvived(_)]:
						True
					_:
						False
			_:
				False
	)


