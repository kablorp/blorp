-- `fixed record Point {x: Int, y: Int}`, stored inline.
pure func inline_point_program(body: CoreExpr) -> CoreProgram:
	program: CoreProgram = program_with_body(body)
	point_decl: CoreDecl = InlineRecordDecl({
		name = "Point",
		fields = [
			{ name = "x", ref = core_field_ref(1), typ = int_type() },
			{ name = "y", ref = core_field_ref(2), typ = int_type() },
		],
		loc = synthetic_core_source_loc()
	})

	{ program | decls = [point_decl].concat(program.decls) }


-- A build short of the record's fields would emit a C compound literal that
-- silently zero-fills the missing member.
pure func test_final_boundary_rejects_product_short_of_its_fields() -> Bool:
	short: CoreExpr = ProductExpr(
		product_build_in_declared_order([LiteralExpr(IntLiteral(1), int_type(), synthetic_core_source_loc())]),
		InlineRecordType("Point"),
		synthetic_core_source_loc(),
	)

	match check_late_core_invariants(FinalStage, inline_point_program(short)):
		[ProductFieldCountMismatch(record_name, field_count, value_count, _)]:
			record_name == "Point" and field_count == 2 and value_count == 1
		_:
			False


pure func test_final_boundary_accepts_product_with_every_field() -> Bool:
	complete: CoreExpr = ProductExpr(
		product_build_in_declared_order([
			LiteralExpr(IntLiteral(1), int_type(), synthetic_core_source_loc()),
			LiteralExpr(IntLiteral(2), int_type(), synthetic_core_source_loc()),
		]),
		InlineRecordType("Point"),
		synthetic_core_source_loc(),
	)

	check_late_core_invariants(FinalStage, inline_point_program(complete)).is_empty()


private pure func managed_point_program(body: CoreExpr) -> CoreProgram:
	program: CoreProgram = program_with_body(body)
	point_decl: CoreDecl = HeapRecordDecl({
		name = "Point",
		abi_type = None,
		form = OrdinaryRecordForm,
		type_params = [],
		fields = [
			{ name = "x", ref = core_field_ref(1), typ = int_type(), release_policy = NoReleasePolicy },
			{ name = "y", ref = core_field_ref(2), typ = int_type(), release_policy = NoReleasePolicy },
		],
		loc = synthetic_core_source_loc()
	})

	{ program | decls = [point_decl].concat(program.decls) }


pure func test_final_boundary_rejects_record_reuse_short_of_its_fields() -> Bool:
	typ = HeapRecordType("Point")
	short = RecordReuseExpr(
		VarExpr(variable("old_point"), typ, synthetic_core_source_loc()),
		product_build_in_declared_order([literal(1)]),
		typ,
		synthetic_core_source_loc(),
	)

	match check_late_core_invariants(FinalStage, managed_point_program(short)):
		[ProductFieldCountMismatch(record_name, field_count, value_count, _)]:
			record_name == "Point" and field_count == 2 and value_count == 1
		_:
			False


pure func test_final_boundary_accepts_record_reuse_with_every_field() -> Bool:
	typ = HeapRecordType("Point")
	complete = RecordReuseExpr(
		VarExpr(variable("old_point"), typ, synthetic_core_source_loc()),
		product_build_in_declared_order([literal(1), literal(2)]),
		typ,
		synthetic_core_source_loc(),
	)

	check_late_core_invariants(FinalStage, managed_point_program(complete)).is_empty()


pure func test_perceus_boundary_rejects_product_field_evaluation() -> Bool:
	call = CallExpr(
		IntrinsicCall("make_field"),
		VarExpr(variable("make_field"), FunctionType(True, [], int_type()), synthetic_core_source_loc()),
		[], int_type(), synthetic_core_source_loc(),
	)
	values: List[CoreExpr] = [
		call,
		IfExpr(LiteralExpr(BoolLiteral(True), NamedType("Bool", []), synthetic_core_source_loc()), literal(2), literal(3), int_type(), synthetic_core_source_loc()),
		SeqExpr(literal(1), literal(2)),
	]
	values.all(func(value):
		build = product_build_in_declared_order([value, literal(0)])
		product = ProductExpr(build, InlineRecordType("Point"), synthetic_core_source_loc())
		reuse = RecordReuseExpr(VarExpr(variable("old_point"), HeapRecordType("Point"), synthetic_core_source_loc()), build, HeapRecordType("Point"), synthetic_core_source_loc())
		match check_late_core_invariants(PerceusStage, inline_point_program(product)):
			[ProductFieldEvaluationSurvived(_)]:
				match check_late_core_invariants(PerceusStage, managed_point_program(reuse)):
					[ProductFieldEvaluationSurvived(_)]: True
					_: False
			_: False
	)


pure func test_perceus_boundary_rejects_evaluable_record_reuse_source() -> Bool:
	typ = HeapRecordType("Point")
	source = CallExpr(IntrinsicCall("make_point"), VarExpr(variable("make_point"), FunctionType(True, [], typ), synthetic_core_source_loc()), [], typ, synthetic_core_source_loc())
	reuse = RecordReuseExpr(source, product_build_in_declared_order([literal(1), literal(2)]), typ, synthetic_core_source_loc())
	match check_late_core_invariants(PerceusStage, managed_point_program(reuse)):
		[ProductFieldEvaluationSurvived(_)]: True
		_: False


pure func test_perceus_boundary_accepts_named_product_ownership_wrappers() -> Bool:
	field = variable("field")
	value = DupExpr(field, int_type(), NoRetainPolicy, VarExpr(field, int_type(), synthetic_core_source_loc()), int_type(), synthetic_core_source_loc())
	projection = ProductFieldExpr(VarExpr(variable("old_point"), HeapRecordType("Point"), synthetic_core_source_loc()), core_field_ordinal(1), int_type(), synthetic_core_source_loc())
	product = ProductExpr(product_build_in_declared_order([value, projection]), InlineRecordType("Point"), synthetic_core_source_loc())
	check_late_core_invariants(PerceusStage, inline_point_program(product)).is_empty()


pure func test_final_boundary_accepts_prepared_tuple() -> Bool:
	tuple_type = TupleType([int_type(), int_type()])
	source = program_with_body(TupleExpr([literal(1), literal(2)], tuple_type, synthetic_core_source_loc()))
	match source.decls:
		[FunctionDecl(function)]:
			typed_source = { source | decls = [FunctionDecl({ function | return_type = tuple_type })] }
			match lower_tuple_storage_program(typed_source):
				Ok(mapped_source):
					check_late_core_invariants(FinalStage, mapped_source).is_empty()
				Err(_):
					False
		_:
			False


pure func intrinsic_call(name: String) -> CoreExpr:
	CallExpr(
		IntrinsicCall(name),
		VarExpr(variable(name), int_type(), synthetic_core_source_loc()),
		[],
		int_type(),
		synthetic_core_source_loc(),
	)


pure func test_final_boundary_rejects_missing_ownership_contract() -> Bool:
	violations: List[CoreLateInvariantViolation] = check_late_core_invariants(
		FinalStage,
		program_with_body(intrinsic_call("missing_ownership_contract")),
	)

	violations.any(func(violation):
		match violation:
			MissingOwnershipCallContract("missing_ownership_contract", _):
				True
			_:
				False
	)


