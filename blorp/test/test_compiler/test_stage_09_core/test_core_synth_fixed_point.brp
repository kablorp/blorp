import:
	../../../src/compiler/stage_09_core/function_origin_fixture:
		FIXTURE_NO_SOURCE_MODULE,
		FIXTURE_SOURCE_FUNCTION_ORIGIN,
		fixture_member_spelling,
	../../../src/compiler/stage_09_core/ir:
		CoreBinaryOp(DivideOp, MultiplyOp),
		CoreBinderOrigin(AuthoredBinder),
		CoreCallKind(IntrinsicCall),
		CoreExpr(BinaryExpr, CallExpr),
		CoreFunction,
		CoreFunctionKind(UnresolvedBuiltinFunction),
		CoreParam,
		CoreSourceLoc,
		CoreType(NamedType),
		CoreVar,
		synthetic_core_source_loc,
	../../../src/compiler/stage_09_core/synth_fixed_point: synthesize_fixed_point_body
	../../../src/compiler/stage_09_core/traverse: immediate_core_expr_children
	test: TestSuite


private INT_TYPE: CoreType = NamedType("Int", [])

private FLOAT_TYPE: CoreType = NamedType("Float", [])

private FIXED_POINT_TYPE: CoreType = NamedType("FixedPoint", [])


pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = None,
		origin = AuthoredBinder
	}


pure func param(name: String, typ: CoreType) -> CoreParam:
	{
		name = core_var(name),
		typ = typ,
		loc = synthetic_core_source_loc()
	}


pure func builtin_function(
	module_name: String,
	source_name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> CoreFunction:
	{
		name = module_name.replace("/", "_") + "__" + source_name,
		source_module = Some(module_name),
		type_params = [],
		params = params,
		return_type = return_type,
		body = None,
		is_pure = True,
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = UnresolvedBuiltinFunction,
		def_id = 1,
		loc = synthetic_core_source_loc()
	}


pure func contains_intrinsic(expr: CoreExpr, expected: String) -> Bool:
	match expr:
		CallExpr(IntrinsicCall(name), _, _, _, _):
			(
				name == expected
				or immediate_core_expr_children(
					expr,
				).any(
					func(child): contains_intrinsic(child, expected),
				)
			)
		_:
			immediate_core_expr_children(expr).any(func(child):
				contains_intrinsic(child, expected)
			)


pure func contains_binary_op(expr: CoreExpr, expected: CoreBinaryOp) -> Bool:
	match expr:
		BinaryExpr(op, _, _, _, _):
			(
				op == expected
				or immediate_core_expr_children(
					expr,
				).any(
					func(child): contains_binary_op(child, expected),
				)
			)
		_:
			immediate_core_expr_children(expr).any(func(child):
				contains_binary_op(child, expected)
			)


pure func synthesized_body(function_info: CoreFunction) -> Option[CoreExpr]:
	synthesize_fixed_point_body(function_info, fixture_member_spelling(function_info))


pure func test_fixed_point_field_accessors_use_intrinsics() -> Bool:
	scale = builtin_function("fixed_point", "get_scale", [param("value", FIXED_POINT_TYPE)], INT_TYPE)
	precision = builtin_function("fixed_point", "get_precision", [param("value", FIXED_POINT_TYPE)], INT_TYPE)

	match (synthesized_body(scale), synthesized_body(precision)):
		(Some(scale_body), Some(precision_body)):
			(
				contains_intrinsic(scale_body, "fixed_point_scale")
				and contains_intrinsic(precision_body, "fixed_point_precision")
			)
		_:
			False


pure func test_fixed_point_to_int_handles_both_scale_directions() -> Bool:
	function_info = builtin_function("fixed_point", "to_int", [param("value", FIXED_POINT_TYPE)], INT_TYPE)

	match synthesized_body(function_info):
		Some(body):
			(
				contains_intrinsic(body, "fixed_point_value")
				and contains_intrinsic(body, "fixed_point_pow10")
				and contains_binary_op(body, DivideOp)
				and contains_binary_op(body, MultiplyOp)
			)
		None:
			False


pure func test_fixed_point_neg_allocates_from_components() -> Bool:
	function_info = builtin_function("fixed_point", "neg", [param("value", FIXED_POINT_TYPE)], FIXED_POINT_TYPE)

	match synthesized_body(function_info):
		Some(body):
			(
				contains_intrinsic(body, "fixed_point_value")
				and contains_intrinsic(body, "fixed_point_scale")
				and contains_intrinsic(body, "fixed_point_precision")
				and contains_intrinsic(body, "fixed_point_alloc")
			)
		None:
			False


pure func test_fixed_point_round_to_rescales_and_allocates() -> Bool:
	function_info = builtin_function(
		"fixed_point",
		"round_to",
		[param("value", FIXED_POINT_TYPE), param("scale", INT_TYPE)],
		FIXED_POINT_TYPE,
	)

	match synthesized_body(function_info):
		Some(body):
			(
				contains_intrinsic(body, "fixed_point_pow10")
				and contains_intrinsic(body, "fixed_point_alloc")
				and contains_binary_op(body, DivideOp)
				and contains_binary_op(body, MultiplyOp)
			)
		None:
			False


pure func test_fixed_point_synthesis_rejects_wrong_module_and_signature() -> Bool:
	wrong_module = builtin_function("app/fixed", "neg", [param("value", FIXED_POINT_TYPE)], FIXED_POINT_TYPE)
	wrong_signature = builtin_function("fixed_point", "neg", [param("value", FLOAT_TYPE)], FIXED_POINT_TYPE)

	synthesized_body(wrong_module).is_none() and synthesized_body(wrong_signature).is_none()


tests: TestSuite = {
	description = "Compiler Core FixedPoint synthesis",
	tests = [
		("FixedPoint field accessors use intrinsics", test_fixed_point_field_accessors_use_intrinsics),
		(
			"FixedPoint to_int handles both scale directions",
			test_fixed_point_to_int_handles_both_scale_directions,
		),
		("FixedPoint neg allocates from components", test_fixed_point_neg_allocates_from_components),
		("FixedPoint round_to rescales and allocates", test_fixed_point_round_to_rescales_and_allocates),
		(
			"FixedPoint synthesis rejects wrong module and signature",
			test_fixed_point_synthesis_rejects_wrong_module_and_signature,
		),
	]
}
