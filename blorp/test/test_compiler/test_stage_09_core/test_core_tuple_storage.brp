-- Generated tuple storage has structural identity and typed record fields.
-- These controls cover row identity, executable lowering and the checked
-- preparation/replay boundary. Semantic tuple metadata stays in the rows.
import:
	../../../src/compiler/stage_09_core/ir:
		CoreDecl(GeneratedTupleRecordDecl, GlobalDecl, HeapRecordDecl, InlineRecordDecl, TypeAliasDecl),
		CoreBinderOrigin(AuthoredBinder),
		CoreCallKind(BuiltinCall, UserCall),
		CoreExpr(CallExpr, LetExpr, LiteralExpr, ProductExpr, ProductFieldExpr, SeqExpr, TupleExpr, UnionConstructExpr, UnionReuseConstructExpr, VarExpr, VoidExpr),
		CoreGeneratedTupleRecordFault(
			GeneratedTupleArityOutsideSurface, GeneratedTupleElementNotConcrete,
		),
		CoreLiteral(IntLiteral, StringLiteral),
		CoreProgram,
		CoreSourceLoc,
		CoreInlineTaggedInitializer(ZeroInlineTaggedInitializer),
		CoreInlineTaggedPayloadPlan,
		CoreInlineTaggedTag(NumericInlineTaggedTag, VariantInlineTaggedTag),
		CoreInlineTaggedVariantRole(EmptyInlineTaggedVariant),
		CoreBoxKind(PointerBox),
		CoreUnionConstruct,
		CoreUnionRepresentation(BoxedOptionRepresentation, InlineTaggedRepresentation),
		CoreUnionPayloadStorage(ErasedUnionPayloadStorage),
		CoreVariantRef(BuiltinOptionNone, BuiltinResultErr, VariantById),
		CoreRecordForm(OrdinaryRecordForm),
		CoreReleasePolicy(NoReleasePolicy),
		CoreType(HeapRecordType, InlineRecordType, NamedType, TupleType, TypeParameterType, VoidType),
		core_field_ordinal,
		core_field_ordinal_index,
		core_field_ref,
		core_generated_tuple_record_decl,
		core_generated_tuple_record_name,
		core_generated_tuple_record_elements,
		core_type_equal,
		core_expr_type,
		core_tuple_storage_fault_message,
		core_program_to_json,
		decode_core_program_json,
		product_build_values,
		CoreTupleStorageFault(CyclicTupleStorageAlias, GeneratedTupleNameCollision, GeneratedTupleStorageReferenceInLogicalRow),
		generated_tuple_record_for_type,
		intern_tuple_storage_rows,
		tuple_storage_catalog,
		tuple_storage_rows,
		tuple_storage_type,
		product_build_in_declared_order,
		synthetic_core_source_loc,
		core_source_loc_from_raw,
	../../../src/compiler/stage_09_core/managed_record_layout:
		CoreManagedRecordFieldStorage(UnitManagedRecordField),
		CoreManagedRecordLayoutFault(
			GeneratedTupleRowOutsideCatalog, ManagedProductFieldOrdinalOutsideRow, ManagedProductFieldTypeMismatch,
		),
		generated_tuple_record_layout,
		managed_product_build_fault,
		managed_product_projection_fault,
		managed_record_layout_fields,
	../../../src/compiler/stage_09_core/prepare:
		prepare_program,
	../../../src/compiler/stage_09_core/tuple_storage:
		lower_tuple_storage_program,
		validate_tuple_storage_program,
		tuple_storage_failure_message,
	test: TestSuite


private pure func named(name: String) -> CoreType:
	NamedType(name, [])


private pure func program(decls: List[CoreDecl]) -> CoreProgram:
	{
		decls = decls,
		foreign_includes = [],
		source_files = [],
	}


private pure func pair_elements() -> List[CoreType]:
	[named("Int"), named("String")]


pure func test_tuple_rows_reject_unsupported_arities() -> Bool:
	one = core_generated_tuple_record_decl("one", [named("Int")], synthetic_core_source_loc())
	five = core_generated_tuple_record_decl("five", [
		named("Int"), named("Int"), named("Int"), named("Int"), named("Int"),
	], synthetic_core_source_loc())

	match (one, five):
		(Err(GeneratedTupleArityOutsideSurface(1)), Err(GeneratedTupleArityOutsideSurface(5))):
			True
		_:
			False


pure func test_tuple_rows_require_concrete_element_types() -> Bool:
	match core_generated_tuple_record_decl("generic", [
		named("Int"), NamedType("List", [TypeParameterType("T")]),
	], synthetic_core_source_loc()):
		Err(GeneratedTupleElementNotConcrete(1, _)):
			True
		_:
			False


pure func test_equal_structural_shapes_share_one_storage_row() -> Bool:
	loc = synthetic_core_source_loc()

	match intern_tuple_storage_rows(program([]), [(pair_elements(), loc), (pair_elements(), loc)]):
		Ok(catalog):
			match (
				tuple_storage_type(catalog, TupleType(pair_elements())),
				generated_tuple_record_for_type(catalog, TupleType(pair_elements())),
			):
				(Ok(HeapRecordType(name)), Some(row)):
					tuple_storage_rows(catalog).length() == 1 and name == core_generated_tuple_record_name(row)
				_:
					False
		Err(_):
			False


pure func test_generated_names_do_not_override_source_records() -> Bool:
	occupied_name: String = "$blorp$tuple_storage$0"
	source_record: CoreDecl = HeapRecordDecl({
		abi_type = None,
		form = OrdinaryRecordForm,
		name = occupied_name,
		type_params = [],
		fields = [],
		loc = synthetic_core_source_loc(),
	})

	match intern_tuple_storage_rows(program([source_record]), [
		(pair_elements(), synthetic_core_source_loc()),
	]):
		Ok(catalog):
			match tuple_storage_rows(catalog).get(0):
				Some(row):
					(
						core_generated_tuple_record_name(row) != occupied_name
						and generated_tuple_record_for_type(catalog, HeapRecordType(occupied_name)).is_none()
					)
				None:
					False
		Err(_):
			False


pure func test_decoded_generated_name_collision_is_rejected() -> Bool:
	loc = synthetic_core_source_loc()

	match core_generated_tuple_record_decl("Taken", pair_elements(), loc):
		Ok(row):
			source_record: CoreDecl = HeapRecordDecl({
				abi_type = None,
				form = OrdinaryRecordForm,
				name = "Taken",
				type_params = [],
				fields = [],
				loc = loc,
			})

			match tuple_storage_catalog(program([GeneratedTupleRecordDecl(row), source_record])):
				Err(GeneratedTupleNameCollision("Taken")):
					True
				_:
					False
		Err(_):
			False


pure func test_nested_tuple_fields_use_the_complete_catalog() -> Bool:
	loc = synthetic_core_source_loc()
	inner: CoreType = TupleType(pair_elements())
	outer_elements: List[CoreType] = [inner, named("Int")]

	-- Deliberately request the containing shape before its nested shape.
	match intern_tuple_storage_rows(program([]), [(outer_elements, loc), (pair_elements(), loc)]):
		Ok(catalog):
			match (
				generated_tuple_record_for_type(catalog, TupleType(outer_elements)),
				tuple_storage_type(catalog, inner),
			):
				(Some(outer_row), Ok(inner_storage)):
					match generated_tuple_record_layout(catalog, outer_row):
						Ok(layout):
							match managed_record_layout_fields(layout).get(0):
								Some(field):
									core_type_equal(field.typ, inner_storage)
								None:
									False
						Err(_):
							False
				_:
					False
		Err(_):
			False


pure func test_logical_rows_reject_generated_storage_references() -> Bool:
	loc = synthetic_core_source_loc()

	match (
		core_generated_tuple_record_decl("Pair", pair_elements(), loc),
		core_generated_tuple_record_decl("Outer", [HeapRecordType("Pair"), named("Int")], loc),
		core_generated_tuple_record_decl("Self", [HeapRecordType("Self"), named("Int")], loc),
	):
		(Ok(pair_row), Ok(outer_row), Ok(self_row)):
			match (
				tuple_storage_catalog(program([GeneratedTupleRecordDecl(pair_row), GeneratedTupleRecordDecl(outer_row)])),
				tuple_storage_catalog(program([GeneratedTupleRecordDecl(self_row)])),
			):
				(
					Err(GeneratedTupleStorageReferenceInLogicalRow("Pair")),
					Err(GeneratedTupleStorageReferenceInLogicalRow("Self")),
				):
					True
				_:
					False
		_:
			False


pure func test_generated_layout_requires_its_registered_row() -> Bool:
	loc = synthetic_core_source_loc()

	match (
		core_generated_tuple_record_decl("pair", pair_elements(), loc),
		core_generated_tuple_record_decl("pair", [named("String"), named("Int")], loc),
		core_generated_tuple_record_decl("other", pair_elements(), loc),
	):
		(Ok(registered), Ok(changed_shape), Ok(unregistered)):
			match tuple_storage_catalog(program([GeneratedTupleRecordDecl(registered)])):
				Ok(catalog):
					match (
						generated_tuple_record_layout(catalog, registered),
						generated_tuple_record_layout(catalog, changed_shape),
						generated_tuple_record_layout(catalog, unregistered),
					):
						(Ok(_), Err(GeneratedTupleRowOutsideCatalog("pair")), Err(GeneratedTupleRowOutsideCatalog("other"))):
							True
						_:
							False
				Err(_):
					False
		_:
			False


pure func test_void_tuple_field_keeps_its_logical_position_without_data() -> Bool:
	elements: List[CoreType] = [VoidType, named("Int")]
	loc = synthetic_core_source_loc()

	match intern_tuple_storage_rows(program([]), [(elements, loc)]):
		Ok(catalog):
			match generated_tuple_record_for_type(catalog, TupleType(elements)):
				Some(row):
					match generated_tuple_record_layout(catalog, row):
						Ok(layout):
							match managed_record_layout_fields(layout):
								[unit_field, value_field]:
									(
										unit_field.storage == UnitManagedRecordField
										and core_type_equal(unit_field.typ, VoidType)
										and unit_field.release_policy == NoReleasePolicy
										and managed_product_projection_fault(layout, core_field_ordinal(0), VoidType).is_none()
										and core_type_equal(value_field.typ, named("Int"))
									)
								_:
									False
						Err(_):
							False
				None:
					False
		Err(_):
			False


pure func test_inline_aggregate_tuple_fields_are_not_erased_boxes() -> Bool:
	elements: List[CoreType] = [InlineRecordType("Point"), NamedType("Option", [named("Int")])]
	loc = synthetic_core_source_loc()

	match intern_tuple_storage_rows(program([]), [(elements, loc)]):
		Ok(catalog):
			match generated_tuple_record_for_type(catalog, TupleType(elements)):
				Some(row):
					match generated_tuple_record_layout(catalog, row):
						Ok(layout):
							match managed_record_layout_fields(layout):
								[first, second]:
									(
										core_type_equal(first.typ, elements.get_or(0, named("Int")))
										and first.release_policy == NoReleasePolicy
										and second.release_policy == NoReleasePolicy
										and first.source_name.is_none()
									)
								_:
									False
						Err(_):
							False
				None:
					False
		Err(_):
			False


pure func test_generated_tuple_build_and_projection_types_are_checked() -> Bool:
	loc = synthetic_core_source_loc()
	wrong_build = product_build_in_declared_order([
		LiteralExpr(StringLiteral("wrong first field"), named("String"), loc),
		LiteralExpr(StringLiteral("second"), named("String"), loc),
	])

	match intern_tuple_storage_rows(program([]), [(pair_elements(), loc)]):
		Ok(catalog):
			match generated_tuple_record_for_type(catalog, TupleType(pair_elements())):
				Some(row):
					match generated_tuple_record_layout(catalog, row):
						Ok(layout):
							match (
								managed_product_build_fault(layout, wrong_build),
								managed_product_projection_fault(layout, core_field_ordinal(2), named("Int")),
								managed_product_projection_fault(layout, core_field_ordinal(1), named("Int")),
							):
								(
									Some(ManagedProductFieldTypeMismatch(_, 0, _, _)),
									Some(ManagedProductFieldOrdinalOutsideRow(_, 2)),
									Some(ManagedProductFieldTypeMismatch(_, 1, _, _)),
								):
									True
								_:
									False
						Err(_):
							False
				None:
					False
		Err(_):
			False


private pure func integer(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), named("Int"), synthetic_core_source_loc())


private pure func tuple_global_program(expr: CoreExpr) -> CoreProgram:
	program([GlobalDecl({
		name = { name = "VALUE", id = 71, def_id = Some(71), origin = AuthoredBinder },
		source_module = None,
		typ = core_expr_type(expr),
		init = expr,
		is_mutable = False,
		is_const = False,
		is_private = False,
		def_id = 71,
		loc = synthetic_core_source_loc(),
	})])


private pure func global_initializer(program: CoreProgram) -> Option[CoreExpr]:
	var result: Option[CoreExpr] = None
	for decl in program.decls:
		match decl:
			GlobalDecl(global): result = Some(global.init)
			_: void
	result


pure func test_storage_pass_uses_one_typed_product_for_equal_shapes() -> Bool:
	loc = synthetic_core_source_loc()
	logical = TupleType([named("Int"), named("Int")])
	source = TupleExpr([integer(1), integer(2)], logical, loc)
	match lower_tuple_storage_program(tuple_global_program(source)):
		Ok(mapped):
			match tuple_storage_catalog(mapped):
				Ok(catalog):
					match global_initializer(mapped):
						Some(ProductExpr(build, physical, _)):
							(
								tuple_storage_rows(catalog).length() == 1
								and generated_tuple_record_for_type(catalog, physical).is_some()
								and product_build_values(build).length() == 2
								and validate_tuple_storage_program(mapped).is_ok()
							)
						_: False
				Err(_): False
		Err(_): False


pure func test_storage_pass_maps_nested_products_through_complete_catalog() -> Bool:
	loc = synthetic_core_source_loc()
	pair = TupleType([named("Int"), named("Int")])
	inner = TupleExpr([integer(1), integer(2)], pair, loc)
	outer = TupleExpr([inner, integer(3)], TupleType([pair, named("Int")]), loc)
	match lower_tuple_storage_program(tuple_global_program(outer)):
		Ok(mapped):
			match tuple_storage_catalog(mapped):
				Ok(catalog):
					match global_initializer(mapped):
						Some(ProductExpr(build, _, _)):
							match product_build_values(build).get(0):
								Some(ProductExpr(_, typ, _)):
									(
										tuple_storage_rows(catalog).length() == 2
										and generated_tuple_record_for_type(catalog, typ).is_some()
										and validate_tuple_storage_program(mapped).is_ok()
									)
								_: False
						_: False
				Err(_): False
		Err(_): False


pure func test_unit_projection_preserves_one_receiver_evaluation() -> Bool:
	loc = synthetic_core_source_loc()
	logical = TupleType([VoidType, named("String")])
	receiver = CallExpr(BuiltinCall("fixture_unit_receiver"), VoidExpr(VoidType, loc), [], logical, loc)
	projection = ProductFieldExpr(receiver, core_field_ordinal(0), VoidType, loc)
	match lower_tuple_storage_program(tuple_global_program(projection)):
		Ok(mapped):
			match global_initializer(mapped):
				Some(ProductFieldExpr(CallExpr(_, _, [], physical, _), ordinal, VoidType, _)):
					match tuple_storage_catalog(mapped):
						Ok(catalog):
							core_field_ordinal_index(ordinal) == 0 and generated_tuple_record_for_type(catalog, physical).is_some()
						Err(_): False
				_: False
		Err(_): False


--- Unit reads borrow the existing receiver just as every scalar field read does.
--- Rewriting them as discarded managed values would release the row twice.
pure func test_repeated_unit_projections_preserve_borrowed_receiver() -> Bool:
	loc = synthetic_core_source_loc()
	logical = TupleType([VoidType, named("String"), VoidType])
	variable = { name = "entry", id = 901, def_id = None, origin = AuthoredBinder }
	receiver = VarExpr(variable, logical, loc)
	body = SeqExpr(
		ProductFieldExpr(receiver, core_field_ordinal(0), VoidType, loc),
		SeqExpr(
			ProductFieldExpr(receiver, core_field_ordinal(2), VoidType, loc),
			ProductFieldExpr(receiver, core_field_ordinal(1), named("String"), loc),
		),
	)
	match lower_tuple_storage_program(tuple_global_program(body)):
		Ok(mapped):
			match global_initializer(mapped):
				Some(SeqExpr(
					ProductFieldExpr(VarExpr(first, physical, _), first_ordinal, VoidType, _),
					SeqExpr(
						ProductFieldExpr(VarExpr(last, last_type, _), last_ordinal, VoidType, _),
						ProductFieldExpr(VarExpr(label, label_type, _), label_ordinal, label_result, _),
					),
				)):
					(
						first.id == variable.id and last.id == variable.id and label.id == variable.id
						and core_type_equal(physical, last_type) and core_type_equal(physical, label_type)
						and core_field_ordinal_index(first_ordinal) == 0 and core_field_ordinal_index(last_ordinal) == 2
						and core_field_ordinal_index(label_ordinal) == 1 and core_type_equal(label_result, named("String"))
						and validate_tuple_storage_program(mapped).is_ok()
					)
				_:
					False
		Err(_):
			False


pure func test_unused_binder_metadata_gets_physical_storage_type() -> Bool:
	loc = synthetic_core_source_loc()
	logical = TupleType([named("Int"), named("Int")])
	variable = { name = "unused_pair", id = 72, def_id = None, origin = AuthoredBinder }
	body = LetExpr(variable, False, logical, TupleExpr([integer(1), integer(2)], logical, loc), integer(3))
	match lower_tuple_storage_program(tuple_global_program(body)):
		Ok(mapped):
			match global_initializer(mapped):
				Some(LetExpr(_, False, physical, ProductExpr(_, value_type, _), _)):
					core_type_equal(physical, value_type) and validate_tuple_storage_program(mapped).is_ok()
				_: False
		Err(_): False


pure func test_concrete_alias_keeps_identity_with_physical_target() -> Bool:
	loc = synthetic_core_source_loc()
	alias_decl: CoreDecl = TypeAliasDecl({
		abi_type = None,
		name = "OpaquePair",
		type_params = [],
		target = TupleType(pair_elements()),
		is_opaque = True,
		loc = loc,
	})
	match lower_tuple_storage_program(program([alias_decl])):
		Ok(mapped):
			match mapped.decls.get(0):
				Some(TypeAliasDecl(result)):
					match tuple_storage_catalog(mapped):
						Ok(catalog):
							(
								result.name == "OpaquePair" and result.is_opaque
								and generated_tuple_record_for_type(catalog, result.target).is_some()
								and validate_tuple_storage_program(mapped).is_ok()
							)
						Err(_): False
				_: False
		Err(_): False


pure func test_generated_storage_round_trip_keeps_logical_rows() -> Bool:
	loc = synthetic_core_source_loc()
	logical = TupleType([named("Int"), named("Int")])
	match lower_tuple_storage_program(tuple_global_program(TupleExpr([integer(1), integer(2)], logical, loc))):
		Ok(mapped):
			match decode_core_program_json(core_program_to_json(mapped)):
				Ok(decoded):
					match tuple_storage_catalog(decoded):
						Ok(catalog):
							(
								tuple_storage_rows(catalog).length() == 1
								and generated_tuple_record_for_type(catalog, logical).is_some()
								and validate_tuple_storage_program(decoded).is_ok()
							)
						Err(_): False
				Err(_): False
		Err(_): False


pure func test_preparation_rejects_residual_logical_tuple_storage() -> Bool:
	loc = synthetic_core_source_loc()
	logical = TupleType([named("Int"), named("Int")])
	validate_tuple_storage_program(tuple_global_program(TupleExpr([integer(1), integer(2)], logical, loc))).is_err()


private pure func opaque_alias(name: String, target: CoreType) -> CoreDecl:
	TypeAliasDecl({
		abi_type = None,
		name = name,
		type_params = [],
		target = target,
		is_opaque = True,
		loc = synthetic_core_source_loc(),
	})


pure func test_scalar_alias_field_uses_numeric_storage_and_no_release() -> Bool:
	loc = synthetic_core_source_loc()
	elements = [named("OpaqueInt"), named("Int")]
	match intern_tuple_storage_rows(program([opaque_alias("OpaqueInt", named("Int"))]), [(elements, loc)]):
		Ok(catalog):
			match generated_tuple_record_for_type(catalog, TupleType(elements)):
				Some(row):
					match generated_tuple_record_layout(catalog, row):
						Ok(layout):
							match managed_record_layout_fields(layout).get(0):
								Some(field): core_type_equal(field.typ, named("Int")) and field.release_policy == NoReleasePolicy
								None: False
						Err(_): False
				None: False
		Err(_): False


pure func test_void_alias_field_has_no_member_or_ownership() -> Bool:
	loc = synthetic_core_source_loc()
	elements = [named("OpaqueUnit"), named("String")]
	match intern_tuple_storage_rows(program([opaque_alias("OpaqueUnit", VoidType)]), [(elements, loc)]):
		Ok(catalog):
			match generated_tuple_record_for_type(catalog, TupleType(elements)):
				Some(row):
					match generated_tuple_record_layout(catalog, row):
						Ok(layout):
							match managed_record_layout_fields(layout).get(0):
								Some(field):
									(
										core_type_equal(field.typ, VoidType)
										and field.storage == UnitManagedRecordField
										and field.release_policy == NoReleasePolicy
									)
								None: False
						Err(_): False
				None: False
		Err(_): False


pure func test_nested_tuple_alias_uses_registered_physical_field() -> Bool:
	loc = synthetic_core_source_loc()
	inner = [named("Int"), named("Int")]
	outer = [named("OpaquePair"), named("String")]
	match intern_tuple_storage_rows(program([opaque_alias("OpaquePair", TupleType(inner))]), [(inner, loc), (outer, loc)]):
		Ok(catalog):
			match generated_tuple_record_for_type(catalog, TupleType(outer)):
				Some(row):
					match generated_tuple_record_layout(catalog, row):
						Ok(layout):
							match managed_record_layout_fields(layout).get(0):
								Some(field): generated_tuple_record_for_type(catalog, field.typ).is_some()
								None: False
						Err(_): False
				None: False
		Err(_): False


pure func test_recursive_container_alias_is_rejected_before_row_mapping() -> Bool:
	alias_decl = opaque_alias("Loop", NamedType("List", [named("Loop")]))
	match intern_tuple_storage_rows(program([alias_decl]), [([named("Loop"), named("Int")], synthetic_core_source_loc())]):
		Err(CyclicTupleStorageAlias("Loop")): True
		_: False


pure func test_indirect_alias_cycle_is_rejected_before_collection() -> Bool:
	aliases = program([opaque_alias("First", named("Second")), opaque_alias("Second", named("First"))])
	match tuple_storage_catalog(aliases):
		Err(CyclicTupleStorageAlias(name)):
			name == "First" or name == "Second"
		_: False


pure func test_growing_generic_alias_cycle_is_checked() -> Bool:
	alias_decl: CoreDecl = TypeAliasDecl({
		abi_type = None,
		name = "Loop",
		type_params = ["T"],
		target = NamedType("List", [NamedType("Loop", [NamedType("List", [TypeParameterType("T")])])]),
		is_opaque = True,
		loc = synthetic_core_source_loc(),
	})
	match tuple_storage_catalog(program([alias_decl])):
		Err(CyclicTupleStorageAlias("Loop")): True
		_: False


pure func test_alias_validation_is_branch_local_for_repeated_fields() -> Bool:
	loc = synthetic_core_source_loc()
	elements = [named("OpaqueInt"), named("OpaqueInt")]
	match intern_tuple_storage_rows(program([opaque_alias("OpaqueInt", named("Int"))]), [(elements, loc)]):
		Ok(catalog):
			match tuple_storage_type(catalog, TupleType(elements)):
				Ok(physical): generated_tuple_record_for_type(catalog, physical).is_some()
				Err(_): False
		Err(_): False


pure func test_nested_application_of_parameter_alias_is_valid() -> Bool:
	loc = synthetic_core_source_loc()
	identity: CoreDecl = TypeAliasDecl({
		abi_type = None,
		name = "Identity",
		type_params = ["T"],
		target = TypeParameterType("T"),
		is_opaque = True,
		loc = loc,
	})
	nested = opaque_alias("Nested", NamedType("Identity", [NamedType("Identity", [named("Int")])]))
	elements = [named("Nested"), named("Int")]
	match intern_tuple_storage_rows(program([identity, nested]), [(elements, loc)]):
		Ok(catalog):
			match generated_tuple_record_for_type(catalog, TupleType(elements)):
				Some(row):
					match generated_tuple_record_layout(catalog, row):
						Ok(layout):
							match managed_record_layout_fields(layout).get(0):
								Some(field):
									core_type_equal(field.typ, named("Int")) and field.release_policy == NoReleasePolicy
								None: False
						Err(_): False
				None: False
		Err(_): False


pure func test_recursive_alias_diagnostic_teaches_nonrecursive_target() -> Bool:
	core_tuple_storage_fault_message(CyclicTupleStorageAlias("Loop")) == "tuple storage alias 'Loop' recursively refers to itself; use a nonrecursive alias target"


private pure func opaque_packet_program(expr: CoreExpr) -> CoreProgram:
	packet = opaque_alias("Packet", TupleType([named("String"), named("Int")]))
	{ tuple_global_program(expr) | decls = [packet].concat(tuple_global_program(expr).decls) }


private pure func packet_value() -> CoreExpr:
	TupleExpr([
		LiteralExpr(StringLiteral("payload"), named("String"), synthetic_core_source_loc()),
		integer(7),
	], named("Packet"), synthetic_core_source_loc())


private pure func boxed_packet_option_construct() -> CoreUnionConstruct:
	{
		type_name = "Option",
		constructor_name = "Some",
		variant = VariantById(88001),
		representation = BoxedOptionRepresentation,
		payload_storage = ErasedUnionPayloadStorage,
		uses_release_mask = True,
		release_mask = 1,
		args = [{ kind = PointerBox, value = packet_value(), needs_release = True, transfers_ownership = True }],
	}


private pure func storage_rejects_changed_option_representation(expr: CoreExpr) -> Bool:
	match lower_tuple_storage_program(opaque_packet_program(expr)):
		Err(failure):
			tuple_storage_failure_message(failure) == "prepared Option representation disagrees with its physical payload type; recreate the constructor after tuple storage lowering"
		Ok(_):
			False


pure func test_boxed_opaque_tuple_option_replay_is_rejected() -> Bool:
	storage_rejects_changed_option_representation(UnionConstructExpr(
		boxed_packet_option_construct(),
		NamedType("Option", [named("Packet")]),
		synthetic_core_source_loc(),
	))


pure func test_boxed_opaque_tuple_option_reuse_is_rejected() -> Bool:
	construct = boxed_packet_option_construct()
	typ = NamedType("Option", [named("Packet")])
	storage_rejects_changed_option_representation(UnionReuseConstructExpr({
		source = VarExpr({ name = "old_option", id = 991, def_id = None, origin = AuthoredBinder }, typ, synthetic_core_source_loc()),
		type_name = construct.type_name,
		constructor_name = construct.constructor_name,
		variant = construct.variant,
		representation = construct.representation,
		payload_storage = construct.payload_storage,
		uses_release_mask = construct.uses_release_mask,
		release_mask = construct.release_mask,
		args = construct.args,
	}, typ, synthetic_core_source_loc()))


pure func test_source_option_constructor_maps_payload_before_issuance() -> Bool:
	loc = synthetic_core_source_loc()
	call = CallExpr(UserCall("Some", Some(88001), []), VoidExpr(VoidType, loc), [packet_value()], NamedType("Option", [named("Packet")]), loc)
	match lower_tuple_storage_program(opaque_packet_program(call)):
		Ok(mapped):
			match global_initializer(mapped):
				Some(CallExpr(_, _, [ProductExpr(_, payload_type, _)], NamedType("Option", [result_payload]), _)):
					match tuple_storage_catalog(mapped):
						Ok(catalog): core_type_equal(payload_type, result_payload) and generated_tuple_record_for_type(catalog, payload_type).is_some()
						Err(_): False
				_: False
		Err(_): False


private fixed union InlineOptionReplayMutation:
	ChangedInlineOptionCType
	ChangedInlineOptionInitializer
	ChangedInlineOptionRole
	ChangedEmptyConstructorTag
	ChangedEmptyMatchTag
	ChangedPayloadConstructorTag
	ChangedPayloadMatchTag


-- Start from the source issuer, then change one recorded component. A replay
-- must agree with the full plan, including tags used only by later matches.
private pure func changed_inline_option_plans(
	plan: CoreInlineTaggedPayloadPlan,
	mutation: InlineOptionReplayMutation,
) -> List[CoreInlineTaggedPayloadPlan]:
	match mutation:
		ChangedInlineOptionCType:
			[{ plan | c_type = plan.c_type + "_changed" }]
		ChangedInlineOptionInitializer:
			[{ plan | empty_initializer = ZeroInlineTaggedInitializer }]
		ChangedInlineOptionRole:
			[plan]
		ChangedEmptyConstructorTag:
			[
				{ plan | empty_encoding = { plan.empty_encoding | constructor_tag = NumericInlineTaggedTag(0) } },
				{ plan | empty_encoding = { plan.empty_encoding | constructor_tag = VariantInlineTaggedTag(VariantById(11801)) } },
				{ plan | empty_encoding = { plan.empty_encoding | constructor_tag = VariantInlineTaggedTag(BuiltinResultErr) } },
			]
		ChangedEmptyMatchTag:
			[{ plan | empty_encoding = { plan.empty_encoding | match_tag = VariantInlineTaggedTag(BuiltinResultErr) } }]
		ChangedPayloadConstructorTag:
			[
				{ plan | payload_encoding = { plan.payload_encoding | constructor_tag = NumericInlineTaggedTag(1) } },
				{ plan | payload_encoding = { plan.payload_encoding | constructor_tag = VariantInlineTaggedTag(BuiltinOptionNone) } },
			]
		ChangedPayloadMatchTag:
			[{ plan | payload_encoding = { plan.payload_encoding | match_tag = VariantInlineTaggedTag(VariantById(11802)) } }]


private pure func both_storage_paths_reject_option_replay(expr: CoreExpr) -> Bool:
	source = tuple_global_program(expr)
	message = "prepared Option representation disagrees with its physical payload type; recreate the constructor after tuple storage lowering"
	match lower_tuple_storage_program(source):
		Err(lower_failure):
			match validate_tuple_storage_program(source):
				Err(validate_failure):
					tuple_storage_failure_message(lower_failure) == message and tuple_storage_failure_message(validate_failure) == message
				Ok(_): False
		Ok(_): False


private pure func inline_option_mutation_is_rejected(mutation: InlineOptionReplayMutation) -> Bool:
	loc = synthetic_core_source_loc()
	typ = NamedType("Option", [named("Int")])
	call = CallExpr(BuiltinCall("blorp_option_some"), VoidExpr(VoidType, loc), [integer(7)], typ, loc)
	match global_initializer(prepare_program(tuple_global_program(call))):
		Some(UnionConstructExpr(issued, _, _)):
			match issued.representation:
				InlineTaggedRepresentation(plan, role):
					changed_plans = changed_inline_option_plans(plan, mutation)
					var rejected = changed_plans.length() > 0
					for changed_plan in changed_plans:
						changed_role = if mutation == ChangedInlineOptionRole:
							EmptyInlineTaggedVariant
						else:
							role
						changed = { issued | representation = InlineTaggedRepresentation(changed_plan, changed_role) }
						construct = UnionConstructExpr(changed, typ, loc)
						reuse = UnionReuseConstructExpr({
							source = VarExpr({ name = "old_option", id = 992, def_id = None, origin = AuthoredBinder }, typ, loc),
							type_name = changed.type_name,
							constructor_name = changed.constructor_name,
							variant = changed.variant,
							representation = changed.representation,
							payload_storage = changed.payload_storage,
							uses_release_mask = changed.uses_release_mask,
							release_mask = changed.release_mask,
							args = changed.args,
						}, typ, loc)
						rejected = rejected and both_storage_paths_reject_option_replay(construct) and both_storage_paths_reject_option_replay(reuse)
					rejected
				_: False
		_: False


pure func test_inline_option_replay_checks_c_type() -> Bool:
	inline_option_mutation_is_rejected(ChangedInlineOptionCType)


pure func test_inline_option_replay_checks_empty_initializer() -> Bool:
	inline_option_mutation_is_rejected(ChangedInlineOptionInitializer)


pure func test_inline_option_replay_checks_variant_role() -> Bool:
	inline_option_mutation_is_rejected(ChangedInlineOptionRole)


pure func test_inline_option_replay_checks_empty_constructor_tag() -> Bool:
	inline_option_mutation_is_rejected(ChangedEmptyConstructorTag)


pure func test_inline_option_replay_checks_empty_match_tag() -> Bool:
	inline_option_mutation_is_rejected(ChangedEmptyMatchTag)


pure func test_inline_option_replay_checks_payload_constructor_tag() -> Bool:
	inline_option_mutation_is_rejected(ChangedPayloadConstructorTag)


pure func test_inline_option_replay_checks_payload_match_tag() -> Bool:
	inline_option_mutation_is_rejected(ChangedPayloadMatchTag)


private pure func issued_option_passes_both_storage_paths(
	constructor_name: String,
	payload: CoreType,
	args: List[CoreExpr],
	decls: List[CoreDecl],
) -> Bool:
	loc = synthetic_core_source_loc()
	call_name = if constructor_name == "Some":
		"blorp_option_some"
	else:
		"blorp_option_none"
	call = CallExpr(BuiltinCall(call_name), VoidExpr(VoidType, loc), args, NamedType("Option", [payload]), loc)
	source = tuple_global_program(call)
	prepared = prepare_program({ source | decls = decls.concat(source.decls) })
	match global_initializer(prepared):
		Some(UnionConstructExpr(construct, _, _)):
			match construct.representation:
				InlineTaggedRepresentation(_, _):
					lower_tuple_storage_program(prepared).is_ok() and validate_tuple_storage_program(prepared).is_ok()
				_: False
		_: False


pure func test_issued_inline_options_remain_valid_on_replay() -> Bool:
	loc = synthetic_core_source_loc()
	point_type = InlineRecordType("Point")
	point = ProductExpr(product_build_in_declared_order([integer(7)]), point_type, loc)
	point_decl = InlineRecordDecl({
		name = "Point",
		fields = [{ name = "x", ref = core_field_ref(11803), typ = named("Int") }],
		loc = loc,
	})
	(
		issued_option_passes_both_storage_paths("Some", named("Int"), [integer(7)], [])
		and issued_option_passes_both_storage_paths("None", named("Int"), [], [])
		and issued_option_passes_both_storage_paths("Some", point_type, [point], [point_decl])
		and issued_option_passes_both_storage_paths("None", point_type, [], [point_decl])
	)


private pure func catalog_rejects_generated_cycle(source: CoreProgram, name: String) -> Bool:
	match tuple_storage_catalog(source):
		Err(fault):
			core_tuple_storage_fault_message(fault) == "generated tuple storage row '" + name + "' recursively contains itself; preserve a finite logical tuple shape"
		Ok(_): False


pure func test_alias_to_own_generated_row_is_rejected() -> Bool:
	loc = synthetic_core_source_loc()
	match core_generated_tuple_record_decl("SelfRow", [named("Alias"), named("Int")], loc):
		Ok(row):
			catalog_rejects_generated_cycle(program([
				opaque_alias("Alias", HeapRecordType("SelfRow")),
				GeneratedTupleRecordDecl(row),
			]), "SelfRow")
		Err(_): False


pure func test_two_generated_rows_cannot_cycle_through_physical_aliases() -> Bool:
	loc = synthetic_core_source_loc()
	match core_generated_tuple_record_decl("FirstRow", [named("SecondAlias"), named("Int")], loc):
		Ok(first):
			match core_generated_tuple_record_decl("SecondRow", [named("FirstAlias"), named("String")], loc):
				Ok(second):
					catalog_rejects_generated_cycle(program([
						opaque_alias("FirstAlias", HeapRecordType("FirstRow")),
						opaque_alias("SecondAlias", HeapRecordType("SecondRow")),
						GeneratedTupleRecordDecl(first),
						GeneratedTupleRecordDecl(second),
					]), "FirstRow")
				Err(_): False
		Err(_): False


pure func test_nested_opaque_rows_keep_acyclic_physical_aliases_on_replay() -> Bool:
	loc = synthetic_core_source_loc()
	inner = TupleExpr([integer(1), integer(2)], named("Pair"), loc)
	outer = TupleExpr([inner, integer(3)], TupleType([named("Pair"), named("Int")]), loc)
	source = { tuple_global_program(outer) | decls = [
		opaque_alias("Pair", TupleType([named("Int"), named("Int")])),
	].concat(tuple_global_program(outer).decls) }
	match lower_tuple_storage_program(source):
		Ok(mapped):
			match decode_core_program_json(core_program_to_json(mapped)):
				Ok(decoded):
					match tuple_storage_catalog(decoded):
						Ok(catalog): tuple_storage_rows(catalog).length() == 2 and validate_tuple_storage_program(decoded).is_ok()
						Err(_): False
				Err(_): False
		Err(_): False


private pure func storage_frontier_program(roots: List[CoreExpr]) -> CoreProgram:
	var decls: List[CoreDecl] = []
	for root in roots:
		id = 97000 + decls.length()
		decls = decls.append(GlobalDecl({
			name = { name = "FRONTIER_${id}", id = id, def_id = Some(id), origin = AuthoredBinder },
			source_module = None, typ = core_expr_type(root), init = root,
			is_mutable = False, is_const = False, is_private = False,
			def_id = id, loc = synthetic_core_source_loc(),
		}))
	program(decls)


pure func test_storage_frontier_preserves_shape_order_and_deduplication() -> Bool:
	loc = synthetic_core_source_loc()
	unit = VoidExpr(VoidType, loc)
	first_type = TupleType([named("Int"), named("String")])
	second_type = TupleType([named("String"), named("String")])
	third_type = TupleType([named("Int"), named("Int")])
	first = TupleExpr([integer(1), LiteralExpr(StringLiteral("first"), named("String"), loc)], first_type, loc)
	second = TupleExpr([
		LiteralExpr(StringLiteral("left"), named("String"), loc),
		LiteralExpr(StringLiteral("right"), named("String"), loc),
	], second_type, loc)
	third = TupleExpr([integer(3), integer(4)], third_type, loc)
	-- The earlier root's nested children precede the later root; a repeated
	-- shape must not issue another row or change the first row's position.
	source = storage_frontier_program([
		SeqExpr(SeqExpr(first, unit), SeqExpr(second, unit)),
		SeqExpr(first, SeqExpr(third, unit)),
	])
	match lower_tuple_storage_program(source):
		Ok(mapped):
			match tuple_storage_catalog(mapped):
				Ok(catalog):
					match tuple_storage_rows(catalog):
						[first_row, second_row, third_row]:
							(
								core_type_equal(TupleType(core_generated_tuple_record_elements(first_row)), first_type)
								and core_type_equal(TupleType(core_generated_tuple_record_elements(second_row)), second_type)
								and core_type_equal(TupleType(core_generated_tuple_record_elements(third_row)), third_type)
								and validate_tuple_storage_program(mapped).is_ok()
							)
						_: False
				Err(_): False
		Err(_): False


private pure func storage_frontier_invalid_option() -> CoreExpr:
	loc = synthetic_core_source_loc()
	construct = { boxed_packet_option_construct() |
		constructor_name = "None", variant = BuiltinOptionNone, args = [],
	}
	UnionConstructExpr(construct, NamedType("Option", [named("Int")]), loc)


private pure func storage_frontier_wrong_product(loc: CoreSourceLoc) -> CoreExpr:
	ProductExpr(product_build_in_declared_order([
		LiteralExpr(StringLiteral("wrong numeric field"), named("String"), loc),
		LiteralExpr(StringLiteral("label"), named("String"), loc),
	]), HeapRecordType("FrontierPair"), loc)


private pure func storage_frontier_first_product_fault(roots: List[CoreExpr], loc: CoreSourceLoc) -> Bool:
	match core_generated_tuple_record_decl("FrontierPair", pair_elements(), synthetic_core_source_loc()):
		Ok(row):
			source = storage_frontier_program(roots)
			with_row = { source | decls = [GeneratedTupleRecordDecl(row)].concat(source.decls) }
			match lower_tuple_storage_program(with_row):
				Err(lower_failure):
					match validate_tuple_storage_program(with_row):
						Err(validate_failure):
							message = "managed product `FrontierPair` field 0 has an incompatible type; use its registered physical field type"
							(
								lower_failure.loc == loc and validate_failure.loc == loc
								and tuple_storage_failure_message(lower_failure) == message
								and tuple_storage_failure_message(validate_failure) == message
							)
						Ok(_): False
				Ok(_): False
		Err(_): False


pure func test_storage_frontier_checks_earlier_root_descendants_first() -> Bool:
	loc = core_source_loc_from_raw(97101)
	unit = VoidExpr(VoidType, synthetic_core_source_loc())
	storage_frontier_first_product_fault([
		SeqExpr(SeqExpr(storage_frontier_wrong_product(loc), unit), unit),
		storage_frontier_invalid_option(),
	], loc)


pure func test_storage_frontier_checks_earlier_child_first() -> Bool:
	loc = core_source_loc_from_raw(97102)
	storage_frontier_first_product_fault([
		SeqExpr(storage_frontier_wrong_product(loc), storage_frontier_invalid_option()),
	], loc)


pure func test_storage_frontier_checks_parent_before_invalid_option_child() -> Bool:
	loc = core_source_loc_from_raw(97103)
	parent = ProductExpr(product_build_in_declared_order([
		LiteralExpr(StringLiteral("wrong numeric field"), named("String"), loc),
		storage_frontier_invalid_option(),
	]), HeapRecordType("FrontierPair"), loc)
	storage_frontier_first_product_fault([parent], loc)


tests: TestSuite = {
	description = "Core tuple storage rows",
	tests = [
		("storage frontier preserves shape order and deduplication", test_storage_frontier_preserves_shape_order_and_deduplication),
		("storage frontier checks earlier root descendants first", test_storage_frontier_checks_earlier_root_descendants_first),
		("storage frontier checks earlier child first", test_storage_frontier_checks_earlier_child_first),
		("storage frontier checks parent before invalid Option child", test_storage_frontier_checks_parent_before_invalid_option_child),
		("inline Option replay checks C type", test_inline_option_replay_checks_c_type),
		("inline Option replay checks empty initializer", test_inline_option_replay_checks_empty_initializer),
		("inline Option replay checks variant role", test_inline_option_replay_checks_variant_role),
		("inline Option replay checks empty constructor tag", test_inline_option_replay_checks_empty_constructor_tag),
		("inline Option replay checks empty match tag", test_inline_option_replay_checks_empty_match_tag),
		("inline Option replay checks payload constructor tag", test_inline_option_replay_checks_payload_constructor_tag),
		("inline Option replay checks payload match tag", test_inline_option_replay_checks_payload_match_tag),
		("issued inline Options remain valid on replay", test_issued_inline_options_remain_valid_on_replay),
		("alias to own generated row is rejected", test_alias_to_own_generated_row_is_rejected),
		("generated rows reject cycles through aliases", test_two_generated_rows_cannot_cycle_through_physical_aliases),
		("nested opaque rows keep acyclic aliases on replay", test_nested_opaque_rows_keep_acyclic_physical_aliases_on_replay),
		("boxed opaque tuple Option replay is rejected", test_boxed_opaque_tuple_option_replay_is_rejected),
		("boxed opaque tuple Option reuse is rejected", test_boxed_opaque_tuple_option_reuse_is_rejected),
		("source Option maps payload before representation issuance", test_source_option_constructor_maps_payload_before_issuance),
		("recursive container alias is rejected before mapping", test_recursive_container_alias_is_rejected_before_row_mapping),
		("indirect alias cycle is rejected before collection", test_indirect_alias_cycle_is_rejected_before_collection),
		("growing generic alias cycle is checked", test_growing_generic_alias_cycle_is_checked),
		("repeated sibling alias fields stay valid", test_alias_validation_is_branch_local_for_repeated_fields),
		("nested parameter alias applications stay valid", test_nested_application_of_parameter_alias_is_valid),
		("recursive alias diagnostic teaches a target", test_recursive_alias_diagnostic_teaches_nonrecursive_target),

		("scalar opaque tuple field has numeric storage", test_scalar_alias_field_uses_numeric_storage_and_no_release),
		("opaque unit tuple field omits storage and release", test_void_alias_field_has_no_member_or_ownership),
		("nested opaque tuple field uses registered row", test_nested_tuple_alias_uses_registered_physical_field),

		("storage pass builds typed products", test_storage_pass_uses_one_typed_product_for_equal_shapes),
		("storage pass maps nested products", test_storage_pass_maps_nested_products_through_complete_catalog),
		("unit projection evaluates its receiver once", test_unit_projection_preserves_one_receiver_evaluation),
		("repeated unit reads keep a borrowed receiver", test_repeated_unit_projections_preserve_borrowed_receiver),
		("unused binder metadata maps to physical rows", test_unused_binder_metadata_gets_physical_storage_type),
		("opaque alias keeps identity and physical target", test_concrete_alias_keeps_identity_with_physical_target),
		("generated storage round trip keeps logical rows", test_generated_storage_round_trip_keeps_logical_rows),
		("preparation rejects residual logical tuple storage", test_preparation_rejects_residual_logical_tuple_storage),

		("generated tuple rows reject unsupported arities", test_tuple_rows_reject_unsupported_arities),
		("generated tuple rows require concrete elements", test_tuple_rows_require_concrete_element_types),
		("equal structural tuple shapes share one row", test_equal_structural_shapes_share_one_storage_row),
		("generated tuple names preserve source records", test_generated_names_do_not_override_source_records),
		("decoded tuple name collisions are rejected", test_decoded_generated_name_collision_is_rejected),
		("nested tuple fields resolve through complete catalog", test_nested_tuple_fields_use_the_complete_catalog),
		("logical rows reject generated physical references", test_logical_rows_reject_generated_storage_references),
		("generated layouts require their registered row", test_generated_layout_requires_its_registered_row),
		("unit tuple fields preserve logical ordinals without data", test_void_tuple_field_keeps_its_logical_position_without_data),
		("inline tuple fields use typed aggregate storage", test_inline_aggregate_tuple_fields_are_not_erased_boxes),
		("generated tuple builds and projections are checked", test_generated_tuple_build_and_projection_types_are_checked),
	],
}
