import:
	../../../benchmark/compiler/compiler_consume_candidate_index_profile_fixture:
		CompilerConsumeCandidateIndexProfileConfig,
		CompilerConsumeCandidateIndexProfileResult,
		compiler_consume_candidate_index_profile_run,
	test: TestSuite


private pure func small_config() -> CompilerConsumeCandidateIndexProfileConfig:
	{
		iterations = 1,
		function_count = 4,
		candidates_per_function = 2,
		user_calls = 8,
		used_percent = 50,
		collision_mode = "none"
	}


private func test_profile_fixture_generates_cloneable_candidates() -> Bool:
	config = small_config()
	result: CompilerConsumeCandidateIndexProfileResult = compiler_consume_candidate_index_profile_run(
		config,
	)

	(
		result.workload_valid
		and result.candidates_discovered == config.function_count * config.candidates_per_function
		and result.rewritten_clone_count == result.candidates_discovered
		and result.rewritten_function_checksum != 0
		and result.core_json_checksum != 0
		and result.core_json_bytes > 0
	)


private func test_profile_fixture_keeps_collision_mode_cloneable() -> Bool:
	config: CompilerConsumeCandidateIndexProfileConfig = { small_config() |
		collision_mode = "same-def-different-name"
	}
	result: CompilerConsumeCandidateIndexProfileResult = compiler_consume_candidate_index_profile_run(
		config,
	)

	(
		result.workload_valid
		and result.candidates_discovered == config.function_count * config.candidates_per_function
	)


private func test_profile_fixture_supports_zero_candidate_control() -> Bool:
	config: CompilerConsumeCandidateIndexProfileConfig = { small_config() |
		candidates_per_function = 0
	}
	result: CompilerConsumeCandidateIndexProfileResult = compiler_consume_candidate_index_profile_run(
		config,
	)

	(
		result.workload_valid
		and result.candidates_discovered == 0
		and result.rewritten_clone_count == 0
		and result.core_json_checksum != 0
	)


tests: TestSuite = {
	description = "Compiler consume candidate index profile benchmark",
	tests = [
		(
			"profile fixture generates cloneable candidates",
			test_profile_fixture_generates_cloneable_candidates,
		),
		(
			"profile fixture keeps collision mode cloneable",
			test_profile_fixture_keeps_collision_mode_cloneable,
		),
		(
			"profile fixture supports zero candidate control",
			test_profile_fixture_supports_zero_candidate_control,
		),
	]
}
