import:
	../../../src/compiler/stage_09_core/c_type_layout:
		runtime_owned_stack_option_payload_name,
		stack_option_c_type,
		unprojected_stack_option_c_type,
	../../../src/compiler/stage_09_core/ir:
		CoreBoxKind(PointerBox, StructBox),
		CoreDecl(HeapRecordDecl, TypeAliasDecl),
		CoreHeapRecordDecl,
		CoreProgram,
		CoreRecordForm(OrdinaryRecordForm),
		CoreSourceLoc,
		CoreType(
			FunctionType, InlineRecordType, SelfType, TypeParameterType, UnionType, HeapRecordType,
			NamedType, RangeType, StackResultType, TupleType, VoidType,
		),
		CoreTypeAliasDecl,
		CoreUnionValueStorage(ScalarTagValue, ManagedUnionValue),
		synthetic_core_source_loc,
	../../../src/compiler/stage_09_core/result_layout:
		CoreResultRuntimeRepresentation(StackResultRepresentation, BoxedResultRepresentation),
		result_runtime_representation,
	../../../src/compiler/stage_09_core/specialize_layout:
		CoreOptionRuntimeLayout(
			BoxedOptionLayout, NullableManagedOptionLayout, PrimitiveStackOptionLayout,
			UnspecializedOptionLayout,
		),
		CoreStreamElementLayout(
			StreamBorrowedArcLayout, StreamImmediateLayout, StreamOwnedArcLayout,
		),
		boxed_storage_allocates,
		boxed_storage_kind,
		boxed_storage_needs_release,
		boxed_storage_slot_needs_release,
		build_specialize_layout,
		option_runtime_layout,
		resolve_specialize_type,
		specialize_type_is_pointer,
		stream_element_layout_code,
	test: TestSuite


private pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


private pure func layout_program() -> CoreProgram:
	{
		decls = [TypeAliasDecl({
				abi_type = None,
				name = "Text",
				type_params = [],
				target = named_type("String"),
				is_opaque = False,
				loc = synthetic_core_source_loc(),
			}), HeapRecordDecl({
				abi_type = None,
				form = OrdinaryRecordForm,
				name = "Point",
				type_params = [],
				fields = [],
				loc = synthetic_core_source_loc(),
			}), HeapRecordDecl({
				abi_type = None,
				form = OrdinaryRecordForm,
				name = "Node",
				type_params = [],
				fields = [],
				loc = synthetic_core_source_loc(),
			})],
		foreign_includes = [],
		source_files = []
	}


private pure func option_layout_is(
	actual: Option[CoreOptionRuntimeLayout],
	expected: CoreOptionRuntimeLayout,
) -> Bool:
	match (actual, expected):
		(Some(PrimitiveStackOptionLayout(actual_suffix)), PrimitiveStackOptionLayout(expected_suffix)):
			actual_suffix == expected_suffix
		(Some(NullableManagedOptionLayout), NullableManagedOptionLayout):
			True
		(Some(BoxedOptionLayout), BoxedOptionLayout):
			True
		(Some(UnspecializedOptionLayout), UnspecializedOptionLayout):
			True
		_:
			False


pure func test_layout_resolves_aliases() -> Bool:
	layout = build_specialize_layout(layout_program())

	match resolve_specialize_type(layout, named_type("Text")):
		NamedType("String", []):
			True
		_:
			False


pure func test_layout_resolves_declarations() -> Bool:
	layout = build_specialize_layout(layout_program())

	match (
		resolve_specialize_type(layout, named_type("Point")),
		resolve_specialize_type(layout, named_type("Node")),
	):
		(HeapRecordType("Point"), HeapRecordType("Node")):
			True
		_:
			False


pure func test_option_runtime_layouts_are_explicit() -> Bool:
	layout = build_specialize_layout(layout_program())

	option_layout_is(
		option_runtime_layout(
			layout,
			NamedType("Option", [named_type("Int")]),
		),
		PrimitiveStackOptionLayout("int"),
	) and option_layout_is(
		option_runtime_layout(
			layout,
			NamedType("Option", [NamedType("Bool", [])]),
		),
		PrimitiveStackOptionLayout("bool"),
	) and option_layout_is(
		option_runtime_layout(
			layout,
			NamedType("Option", [named_type("String")]),
		),
		NullableManagedOptionLayout,
	) and option_layout_is(
		option_runtime_layout(
			layout,
			NamedType("Option", [NamedType("Option", [named_type("Int")])]),
		),
		BoxedOptionLayout,
	) and option_layout_is(
		option_runtime_layout(
			layout,
			NamedType("Option", [named_type("Point")]),
		),
		NullableManagedOptionLayout,
	)


pure func test_pointer_and_erased_release_classification() -> Bool:
	layout = build_specialize_layout(layout_program())

	(
		specialize_type_is_pointer(layout, named_type("Ptr"))
		and specialize_type_is_pointer(layout, named_type("Text"))
		and specialize_type_is_pointer(layout, named_type("Node"))
		and not specialize_type_is_pointer(layout, named_type("Float"))
		and not specialize_type_is_pointer(layout, named_type("Int"))
		and specialize_type_is_pointer(layout, named_type("Point"))
		and boxed_storage_needs_release(layout, named_type("String"))
		and boxed_storage_needs_release(layout, named_type("Int128"))
		and not boxed_storage_needs_release(layout, named_type("Int"))
	)


pure func test_erased_slot_release_matches_allocated_box_kinds() -> Bool:
	layout = build_specialize_layout(layout_program())

	(
		boxed_storage_slot_needs_release(layout, named_type("Point"))
		and boxed_storage_slot_needs_release(layout, named_type("Int128"))
		and boxed_storage_slot_needs_release(layout, named_type("UInt128"))
		and boxed_storage_slot_needs_release(layout, named_type("String"))
		and not boxed_storage_slot_needs_release(layout, named_type("Int"))
	)


pure func test_boxing_allocates_only_fresh_boxes() -> Bool:
	layout = build_specialize_layout(layout_program())

	(
		not boxed_storage_allocates(layout, named_type("Point"))
		and boxed_storage_allocates(layout, named_type("Int128"))
		and boxed_storage_allocates(layout, named_type("UInt128"))
		and boxed_storage_allocates(
			layout,
			StackResultType(named_type("Int"), named_type("String")),
		)
		and not boxed_storage_allocates(layout, named_type("Float"))
		and not boxed_storage_allocates(layout, named_type("String"))
		and not boxed_storage_allocates(layout, named_type("Int"))
	)


private pure func named_result_type() -> CoreType:
	NamedType(
		"Result",
		[named_type("Int"), named_type("String")],
	)


private pure func specialized_result_type() -> CoreType:
	StackResultType(named_type("Int"), named_type("String"))


private pure func is_stack_result_box(kind: CoreBoxKind) -> Bool:
	match kind:
		StructBox("blorp_StackResult"):
			True
		_:
			False


pure func test_result_types_are_not_pointers() -> Bool:
	layout = build_specialize_layout(layout_program())

	(
		not specialize_type_is_pointer(layout, named_result_type())
		and not specialize_type_is_pointer(layout, specialized_result_type())
	)


pure func test_result_erased_storage_uses_releasable_stack_boxes() -> Bool:
	layout = build_specialize_layout(layout_program())

	(
		boxed_storage_needs_release(layout, named_result_type())
		and boxed_storage_needs_release(layout, specialized_result_type())
		and is_stack_result_box(boxed_storage_kind(layout, named_result_type()))
		and is_stack_result_box(boxed_storage_kind(layout, specialized_result_type()))
	)


pure func test_option_of_named_result_uses_boxed_layout() -> Bool:
	layout = build_specialize_layout(layout_program())

	option_layout_is(
		option_runtime_layout(
			layout,
			NamedType("Option", [named_result_type()]),
		),
		BoxedOptionLayout,
	)


pure func test_stream_layout_codes_match_runtime_abi() -> Bool:
	(
		stream_element_layout_code(StreamImmediateLayout) == 0
		and stream_element_layout_code(StreamBorrowedArcLayout) == 1
		and stream_element_layout_code(StreamOwnedArcLayout) == 2
	)


pure func test_scalar_option_and_result_abi_catalog() -> Bool:
	layout = build_specialize_layout(layout_program())
	var passed = True

	for (name, suffix) in [
		("Int", "int"),
		("Int8", "int8"),
		("Int16", "int16"),
		("Int32", "int32"),
		("Int64", "int64"),
		("UInt8", "uint8"),
		("UInt16", "uint16"),
		("UInt32", "uint32"),
		("UInt64", "uint64"),
		("Float", "float"),
		("Float32", "f32"),
		("Float16", "f16"),
		("Bool", "bool"),
		("Char", "char"),
	]:
		payload = named_type(name)
		option = NamedType("Option", [payload])
		passed = passed and runtime_owned_stack_option_payload_name(name) and option_layout_is(
			option_runtime_layout(layout, option),
			PrimitiveStackOptionLayout(suffix),
		) and stack_option_c_type(
			payload,
			{},
		) == Some("blorp_StackOption_" + name) and is_stack_option_box(
			boxed_storage_kind(layout, option),
			Some("blorp_StackOption_" + name),
		) and result_runtime_representation(
			layout,
			payload,
			named_type("Int"),
		) == StackResultRepresentation

	passed


private pure func is_stack_option_box(kind: CoreBoxKind, expected: Option[String]) -> Bool:
	match (kind, expected):
		(StructBox(actual), Some(name)):
			actual == name
		(PointerBox, None):
			True
		_:
			False


private record PayloadAbiCase {
	payload: CoreType,
	runtime: CoreOptionRuntimeLayout,
	c_type: Option[String],
	box_type: Option[String],
	result: CoreResultRuntimeRepresentation
}


private pure func payload_abi_case(
	payload: CoreType,
	runtime: CoreOptionRuntimeLayout,
	c_type: Option[String],
	box_type: Option[String],
	result: CoreResultRuntimeRepresentation,
) -> PayloadAbiCase:
	{
		payload = payload,
		runtime = runtime,
		c_type = c_type,
		box_type = box_type,
		result = result
	}


pure func test_option_and_result_abi_exclusions() -> Bool:
	layout = build_specialize_layout(layout_program())
	var passed = True

	-- Runtime suffixes, C value types and erased struct boxes are distinct capabilities.
	for case in [
		payload_abi_case(
			VoidType,
			PrimitiveStackOptionLayout("void"),
			Some("blorp_StackOption_Void"),
			Some("blorp_StackOption_Void"),
			StackResultRepresentation,
		),
		payload_abi_case(
			named_type("Void"),
			PrimitiveStackOptionLayout("void"),
			None,
			Some("blorp_StackOption_Void"),
			BoxedResultRepresentation,
		),
		payload_abi_case(
			named_type("Int128"),
			UnspecializedOptionLayout,
			Some("blorp_StackOption_Int128"),
			Some("blorp_StackOption_Int128"),
			BoxedResultRepresentation,
		),
		payload_abi_case(
			named_type("UInt128"),
			UnspecializedOptionLayout,
			Some("blorp_StackOption_UInt128"),
			Some("blorp_StackOption_UInt128"),
			BoxedResultRepresentation,
		),
		payload_abi_case(
			named_type("Ptr"),
			BoxedOptionLayout,
			None,
			None,
			StackResultRepresentation,
		),
		payload_abi_case(
			named_type("Port"),
			UnspecializedOptionLayout,
			None,
			None,
			StackResultRepresentation,
		),
		payload_abi_case(
			named_type("ConcurrencyError"),
			UnspecializedOptionLayout,
			None,
			None,
			StackResultRepresentation,
		),
		payload_abi_case(
			NamedType("Int", [named_type("Int")]),
			UnspecializedOptionLayout,
			None,
			None,
			BoxedResultRepresentation,
		),
		payload_abi_case(
			UnionType("Bool", ScalarTagValue),
			UnspecializedOptionLayout,
			Some("blorp_StackOption_Bool"),
			Some("blorp_StackOption_Bool"),
			StackResultRepresentation,
		),
		payload_abi_case(
			InlineRecordType("Value"),
			UnspecializedOptionLayout,
			Some("blorp_StackOption_Value"),
			Some("blorp_StackOption_Value"),
			StackResultRepresentation,
		),
	]:
		option = NamedType("Option", [case.payload])
		passed = passed and option_layout_is(
			option_runtime_layout(layout, option),
			case.runtime,
		) and stack_option_c_type(case.payload, {}) == case.c_type and is_stack_option_box(
			boxed_storage_kind(layout, option),
			case.box_type,
		) and result_runtime_representation(layout, case.payload, named_type("Int")) == case.result

	(
		passed
		and runtime_owned_stack_option_payload_name("Void")
		and not runtime_owned_stack_option_payload_name("Int128")
		and not runtime_owned_stack_option_payload_name("UInt128")
		and not runtime_owned_stack_option_payload_name("Ptr")
		and not runtime_owned_stack_option_payload_name("Port")
		and not runtime_owned_stack_option_payload_name("ConcurrencyError")
		and stack_option_c_type(
			UnionType("Bool", ScalarTagValue),
			{"Bool" => "ProjectedBool"},
		) == Some("blorp_StackOption_ProjectedBool")
	)


pure func test_option_and_result_concrete_and_unresolved_payloads() -> Bool:
	layout = build_specialize_layout(layout_program())
	var passed = True

	for payload in [
		named_type("Text"),
		named_type("Point"),
		FunctionType(True, [], named_type("Int")),
	]:
		passed = passed and option_layout_is(
			option_runtime_layout(
				layout,
				NamedType("Option", [payload]),
			),
			NullableManagedOptionLayout,
		) and result_runtime_representation(
			layout,
			payload,
			named_type("Int"),
		) == StackResultRepresentation

	for payload in [
		TypeParameterType("T"),
		SelfType,
		NamedType("Option", [TypeParameterType("T")]),
		StackResultType(TypeParameterType("T"), named_type("Int")),
	]:
		passed = passed and option_layout_is(
			option_runtime_layout(
				layout,
				NamedType("Option", [payload]),
			),
			BoxedOptionLayout,
		) and result_runtime_representation(
			layout,
			payload,
			named_type(
				"Int",
			),
		) == BoxedResultRepresentation and result_runtime_representation(
			layout,
			named_type("Int"),
			payload,
		) == BoxedResultRepresentation

	for payload in [NamedType("Option", [named_type("String")]), specialized_result_type()]:
		passed = passed and option_layout_is(
			option_runtime_layout(
				layout,
				NamedType("Option", [payload]),
			),
			BoxedOptionLayout,
		) and result_runtime_representation(
			layout,
			payload,
			named_type("Int"),
		) == StackResultRepresentation

	-- A named Option[Int] is concrete but neither immediate nor managed in
	-- the current Result ABI. Option[String] is known through managed storage.
	passed and option_layout_is(
		option_runtime_layout(
			layout,
			NamedType("Option", [NamedType("Option", [named_type("Int")])]),
		),
		BoxedOptionLayout,
	) and result_runtime_representation(
		layout,
		NamedType("Option", [named_type("Int")]),
		named_type("Int"),
	) == BoxedResultRepresentation


pure func test_stack_option_raw_and_projected_names() -> Bool:
	layout = build_specialize_layout(layout_program())
	var passed: Bool = True

	for (payload, raw_name, projected_name) in [
		(
			UnionType("Range", ScalarTagValue),
			"blorp_StackOption_Range",
			"blorp_StackOption_RangeValue",
		),
		(InlineRecordType("Range"), "blorp_StackOption_RangeValue", "blorp_StackOption_RangeValue"),
		(RangeType, "blorp_StackOption_Range", "blorp_StackOption_Range"),
	]:
		passed = passed and is_stack_option_box(
			boxed_storage_kind(
				layout,
				NamedType("Option", [payload]),
			),
			Some(raw_name),
		) and stack_option_c_type(
			payload,
			{

			},
		) == Some(projected_name) and unprojected_stack_option_c_type(payload) == Some(raw_name)

	passed and stack_option_c_type(
		UnionType("Range", ScalarTagValue),
		{"Range" => "ProjectedRange"},
	) == Some(
		"blorp_StackOption_ProjectedRange",
	) and stack_option_c_type(
		InlineRecordType("Range"),
		{
			"Range" => "ProjectedRange",
		},
	) == Some(
		"blorp_StackOption_ProjectedRange",
	) and stack_option_c_type(
		RangeType,
		{"Range" => "ProjectedRange"},
	) == Some("blorp_StackOption_Range")


pure func test_stack_option_c_type_exclusions_and_alias_box() -> Bool:
	program = layout_program()
	layout = build_specialize_layout({ program | decls = program.decls.append(TypeAliasDecl({
				abi_type = None,
				name = "Scalar",
				type_params = [],
				target = named_type("Int"),
				is_opaque = False,
				loc = synthetic_core_source_loc(),
			})) })
	var passed: Bool = True

	for payload in [
		named_type("Ptr"),
		named_type("String"),
		TupleType([named_type("Int")]),
		specialized_result_type(),
		TypeParameterType("T"),
		SelfType,
		NamedType("Int", [named_type("Int")]),
	]:
		passed = (
			passed
			and stack_option_c_type(payload, {}).is_none()
			and unprojected_stack_option_c_type(payload).is_none()
			and is_stack_option_box(
				boxed_storage_kind(
					layout,
					NamedType("Option", [payload]),
				),
				None,
			)
		)

	passed and is_stack_option_box(
		boxed_storage_kind(
			layout,
			NamedType("Option", [named_type("Scalar")]),
		),
		Some("blorp_StackOption_Int"),
	)


tests: TestSuite = {
	description = "Blorp compiler Core specialization layout",
	tests = [
		("resolves aliases", test_layout_resolves_aliases),
		("boxing allocates only fresh boxes", test_boxing_allocates_only_fresh_boxes),
		("resolves declarations", test_layout_resolves_declarations),
		("Option runtime layouts are explicit", test_option_runtime_layouts_are_explicit),
		(
			"pointer and erased release classification",
			test_pointer_and_erased_release_classification,
		),
		(
			"erased slot release matches allocated box kinds",
			test_erased_slot_release_matches_allocated_box_kinds,
		),
		("Result types are not pointers", test_result_types_are_not_pointers),
		(
			"Result erased storage uses releasable stack boxes",
			test_result_erased_storage_uses_releasable_stack_boxes,
		),
		("Option of named Result uses boxed layout", test_option_of_named_result_uses_boxed_layout),
		("stream layout codes match runtime ABI", test_stream_layout_codes_match_runtime_abi),
		("scalar Option and Result ABI catalog", test_scalar_option_and_result_abi_catalog),
		("Option and Result ABI exclusions", test_option_and_result_abi_exclusions),
		("stack Option raw and projected names", test_stack_option_raw_and_projected_names),
		(
			"stack Option C type exclusions and alias box",
			test_stack_option_c_type_exclusions_and_alias_box,
		),
		(
			"Option and Result concrete and unresolved payloads",
			test_option_and_result_concrete_and_unresolved_payloads,
		),
	]
}
