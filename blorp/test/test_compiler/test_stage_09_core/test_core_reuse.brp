pure func test_rewrites_dead_heap_record_allocation() -> Bool:
	source_var: CoreVar = named_var("old")
	result_var: CoreVar = named_var("next")
	record_type: CoreType = heap_record_type("Counter")
	rewritten: CoreExpr = rewrite_post_perceus_expr(
		dropped_record_result_expr(
			source_var,
			result_var,
			record_type,
			record_type,
			ArcReleasePolicy,
			record_fields(int_expr(2)),
		),
	)

	match top_record_reuse_source(rewritten):
		Some(variable):
			variable.name == source_var.name and variable.id == source_var.id
		None:
			False


-- A literal written out of declaration order reuses the dropped record with
-- its build unchanged: the reuse evaluates in written order and stores each
-- value at its ordinal, as a fresh build would.
pure func test_reused_literal_keeps_written_order_and_ordinals() -> Bool:
	source_var: CoreVar = named_var("old")
	result_var: CoreVar = named_var("next")
	record_type: CoreType = heap_record_type("Pair")
	second_value: CoreExpr = int_expr(2)
	first_value: CoreExpr = int_expr(1)
	build: CoreProductBuild = fixture_build(2, [
		(1, second_value),
		(0, first_value),
	])
	rewritten: CoreExpr = rewrite_post_perceus_expr(
		dropped_record_result_expr(source_var, result_var, record_type, record_type, ArcReleasePolicy, build),
	)

	match rewritten:
		RecordReuseExpr(VarExpr(reused, _, _), reused_build, _, _):
			(
				reused.name == "old"
				and product_build_ordinals(reused_build).map(core_field_ordinal_index) == [1, 0]
				and match product_build_values(reused_build):
					[written_first, written_second]:
						same_object(written_first, second_value) and same_object(written_second, first_value)
					_:
						False
			)
		_:
			False


private pure func product_field_var(name: String, id: Int) -> CoreVar:
	{ unique_var(name, id) | origin = PRODUCT_FIELD_TEMP_ORIGIN }


private pure func fresh_record_field_expr(name: String) -> CoreExpr:
	loc = synthetic_core_source_loc()
	CallExpr(
		IntrinsicCall(name),
		VarExpr(named_var(name), FunctionType(True, [], string_type()), loc),
		[],
		string_type(),
		loc,
	)


private pure func named_record_fields_rhs(
	first: CoreVar,
	second: CoreVar,
	first_rhs: CoreExpr,
	second_rhs: CoreExpr,
) -> CoreExpr:
	LetExpr(
		first,
		False,
		string_type(),
		first_rhs,
		LetExpr(
			second,
			False,
			string_type(),
			second_rhs,
			ProductExpr(
				fixture_build(2, [
					(1, typed_var_expr(first, string_type())),
					(0, typed_var_expr(second, string_type())),
				]),
				heap_record_type("Pair"),
				synthetic_core_source_loc(),
			),
		),
	)


private pure func dropped_named_record_rhs(rhs: CoreExpr) -> CoreExpr:
	record_type = heap_record_type("Pair")
	result = named_var("next")
	LetExpr(
		result,
		False,
		record_type,
		rhs,
		DropExpr(
			named_var("old"),
			record_type,
			ArcReleasePolicy,
			typed_var_expr(result, record_type),
			record_type,
			synthetic_core_source_loc(),
		),
	)


pure func test_named_product_fields_preserve_dropped_record_reuse() -> Bool:
	first = product_field_var("written_first", -1)
	second = product_field_var("written_second", -2)
	first_rhs = fresh_record_field_expr("make_second")
	second_rhs = fresh_record_field_expr("make_first")
	rewritten = rewrite_post_perceus_expr(dropped_named_record_rhs(
		named_record_fields_rhs(first, second, first_rhs, second_rhs),
	))

	match rewritten:
		LetExpr(first_owner, False, _, written_first, LetExpr(second_owner, False, _, written_second, RecordReuseExpr(VarExpr(source, _, _), build, _, _))):
			(
				first_owner.id == first.id
				and second_owner.id == second.id
				and source.name == "old"
				and same_object(written_first, first_rhs)
				and same_object(written_second, second_rhs)
				and product_build_ordinals(build).map(core_field_ordinal_index) == [1, 0]
				and match product_build_values(build):
					[VarExpr(first_field, _, _), VarExpr(second_field, _, _)]:
						first_field.id == first.id and second_field.id == second.id
					_:
						False
			)
		_:
			False


private pure func named_product_fields_keep_drop(first: CoreVar, first_rhs: CoreExpr) -> Bool:
	input = dropped_named_record_rhs(named_record_fields_rhs(
		first,
		product_field_var("written_second", -2),
		first_rhs,
		fresh_record_field_expr("make_first"),
	))
	core_program_to_json(prepared_program([], input)).to_string() == core_program_to_json(
		prepared_program([], rewrite_post_perceus_expr(input)),
	).to_string()


pure func test_named_product_reuse_rejects_source_reassignment() -> Bool:
	loc = synthetic_core_source_loc()
	typ = heap_record_type("Pair")
	first_rhs = SeqExpr(
		AssignExpr(named_var("old"), typed_var_expr(named_var("replacement"), typ), typ, loc),
		fresh_record_field_expr("make_second"),
	)
	named_product_fields_keep_drop(product_field_var("written_first", -1), first_rhs)


pure func test_named_product_reuse_rejects_control_exit() -> Bool:
