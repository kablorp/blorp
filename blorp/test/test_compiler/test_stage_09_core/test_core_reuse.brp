		normalized_alias_keeps_retain(normalized_items_writeback(SeqExpr(hoisted_items_var_expr(), int_expr(1))))
		and normalized_alias_keeps_retain(normalized_items_writeback(SeqExpr(state_field_read("items", list_int_type()), int_expr(1))))
