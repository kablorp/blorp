	managed_with_wrong_index: Int = rewrite_program_reuse_count(
		[single_field_variant_decl(ArcReleasePolicy)],
		prepared_let_drop(
			[field_binding(left_var(), 1, MatchOwnBindingMode)],
			single_field_construct(),
		),
	)

	(
		unmanaged_without_binding == 1
		and managed_without_binding == 0
		and managed_with_direct_binding == 1
		and managed_with_wrong_index == 0
	)


pure func test_prepared_reuse_preserves_last_match_duplicate_behavior() -> Bool:
