pure func deeply_nested_if_result(depth: Int) -> CoreExpr:
	var body: CoreExpr = add_construct_from_fields()
	var index: Int = 0

	while index < depth:
		body = IfExpr(
			bool_expr(True),
			body,
			add_construct_from_fields(),
			expr_type(),
			synthetic_core_source_loc(),
		)
		index += 1

	body


pure func test_prepared_reuse_rewrites_deep_nested_match_result() -> Bool:
	depth: Int = 128
	body: CoreExpr = prepared_let_drop(owned_add_bindings(), deeply_nested_if_result(depth))

	rewrite_program_reuse_count(decls(), body) == depth + 1


pure func prepared_reuse_profile_target_union_index(program: CoreProgram) -> Int:
	var result: Int = -1
	var index: Int = 0

	for decl in program.decls:
		match decl:
			UnionDecl(union_decl):
				if union_decl.name == "PreparedReuseTarget":
					result = index
				else:
					void
			_:
				void

		index += 1

	result


pure func test_prepared_reuse_profile_fixture_layouts_are_explicit() -> Bool:
	config: PreparedReuseProfileConfig = {
		iterations = 1,
		declarations = 64,
		union_count = 8,
		variants_per_union = 4,
		prepared_match_count = 32
	}
	worst_program: CoreProgram = prepared_reuse_profile_worst_case_program(config)
	mixed_program: CoreProgram = prepared_reuse_profile_mixed_program(config)
	mixed_rewritten: CoreProgram = prepared_reuse_profile_execute(mixed_program, 1)
	mixed_result = prepared_reuse_profile_observe(config, mixed_program, mixed_rewritten)
	worst_target_index: Int = prepared_reuse_profile_target_union_index(worst_program)
	mixed_target_index: Int = prepared_reuse_profile_target_union_index(mixed_program)

	(
		worst_program.decls.length() == 64
		and worst_target_index == 63
		and mixed_program.decls.length() == 64
		and mixed_target_index > 0
		and mixed_target_index < 63
		and mixed_result.workload_valid
	)


pure func test_prepared_reuse_profile_observes_parent_and_indexed_lookup_work() -> Bool:
	config: PreparedReuseProfileConfig = {
		iterations = 1,
		declarations = 64,
		union_count = 8,
		variants_per_union = 4,
		prepared_match_count = 32
	}
	program: CoreProgram = prepared_reuse_profile_worst_case_program(config)
	rewritten: CoreProgram = prepared_reuse_profile_execute(program, config.iterations)
	parent_result = prepared_reuse_profile_observe_with_algorithm(
		config,
		program,
		rewritten,
		PreparedReuseParentLinearLookup,
	)
	indexed_result = prepared_reuse_profile_observe_with_algorithm(
		config,
		program,
		rewritten,
		PreparedReuseIndexedLookup,
	)
	expected_union_requests: Int = config.prepared_match_count * 2
	expected_variant_requests: Int = config.prepared_match_count

	(
		parent_result.workload_valid
		and indexed_result.workload_valid
		and parent_result.layout_builds == 0
		and parent_result.declarations_indexed == 0
		and parent_result.union_entries_written == 0
		and parent_result.union_lookup_requests == expected_union_requests
		and parent_result.union_linear_candidates_visited == expected_union_requests * program.decls.length()
		and parent_result.variant_lookup_requests == expected_variant_requests
		and parent_result.variant_linear_candidates_visited == expected_variant_requests * config.variants_per_union
		and indexed_result.layout_builds == 1
		and indexed_result.declarations_indexed == program.decls.length()
		and indexed_result.union_entries_written == config.union_count
		and indexed_result.union_lookup_requests == expected_union_requests
		and indexed_result.union_linear_candidates_visited == 0
		and indexed_result.variant_lookup_requests == expected_variant_requests
		and indexed_result.variant_linear_candidates_visited == expected_variant_requests * config.variants_per_union
	)


pure func test_prepared_reuse_profile_reports_indexed_declaration_work() -> Bool:
	config: PreparedReuseProfileConfig = {
		iterations = 1,
		declarations = 64,
		union_count = 8,
		variants_per_union = 4,
		prepared_match_count = 32
	}
	result = prepared_reuse_profile(config)

	(
		result.workload_valid
		and result.layout_builds == 1
		and result.declarations_indexed == 64
		and result.union_entries_written == 8
		and result.union_lookup_requests == 64
		and result.union_linear_candidates_visited == 0
		and result.variant_lookup_requests == 32
		and result.variant_linear_candidates_visited == 128
		and result.rewritten_reuse_sites == 32
	)


