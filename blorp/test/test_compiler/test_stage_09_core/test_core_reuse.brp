pure func state_type() -> CoreType:
	heap_record_type("State")


pure func state_var() -> CoreVar:
	unique_var("s", 3)


pure func state_var_expr() -> CoreExpr:
	VarExpr(state_var(), state_type(), synthetic_core_source_loc())


pure func state_field_read(field_name: String, typ: CoreType) -> CoreExpr:
	ProductFieldExpr(state_var_expr(), test_field_ordinal(field_name), typ, synthetic_core_source_loc())


-- Perceus's owned-alias shape for a field read passed to a consuming call.
pure func owned_items_read(policy: CoreRetainPolicy) -> CoreExpr:
	temp: CoreVar = named_var("owned_result")

	BorrowLetExpr(
		temp,
		list_int_type(),
		state_field_read("items", list_int_type()),
		DupExpr(
			temp,
			list_int_type(),
			policy,
			VarExpr(temp, list_int_type(), synthetic_core_source_loc()),
			list_int_type(),
			synthetic_core_source_loc(),
		),
	)


pure func consuming_append(args: List[CoreExpr]) -> CoreExpr:
	CallExpr(
		UnknownCall,
		VarExpr(named_var("append"), VoidType, synthetic_core_source_loc()),
		args,
		list_int_type(),
		synthetic_core_source_loc(),
	)


pure func inlined_append(receiver: CoreExpr) -> CoreExpr:
	self_var: CoreVar = named_var("__std_inline_self")

	LetExpr(
		self_var,
		False,
		list_int_type(),
		consuming_append([receiver, int_expr(1)]),
		VarExpr(self_var, list_int_type(), synthetic_core_source_loc()),
	)


pure func items_cow_field(replacement: Option[CoreExpr]) -> CoreRecordCowField:
	{
		field = {
			name = "items",
			ref = test_field_ref("items"),
			typ = list_int_type(),
			release_policy = ArcReleasePolicy
		},
		replacement = replacement
	}


pure func top_cow_field(replacement: Option[CoreExpr]) -> CoreRecordCowField:
	{
		field = {
			name = "top",
			ref = test_field_ref("top"),
			typ = int_type(),
			release_policy = NoReleasePolicy
		},
		replacement = replacement
	}


pure func state_cow_update(source: CoreExpr, fields: List[CoreRecordCowField]) -> CoreExpr:
	RecordCowUpdateExpr(source, fields, state_type(), synthetic_core_source_loc())


pure func first_dup_policy(expr: CoreExpr) -> Option[CoreRetainPolicy]:
	match expr:
		DupExpr(_, _, policy, _, _, _):
			Some(policy)
		BorrowLetExpr(_, _, _, body):
			first_dup_policy(body)
		LetExpr(_, _, _, rhs, _):
			first_dup_policy(rhs)
		CallExpr(_, _, args, _, _):
			match args.get(0):
				Some(arg):
					first_dup_policy(arg)
				None:
					None
		IfExpr(_, then_expr, _, _, _):
			first_dup_policy(then_expr)
		_:
			None


pure func first_replacement_policy(expr: CoreExpr) -> Option[CoreRetainPolicy]:
	match expr:
		RecordCowUpdateExpr(_, fields, _, _):
			match fields.get(0):
				Some(field):
					match field.replacement:
						Some(replacement):
							first_dup_policy(replacement)
						None:
							None
				None:
					None
		RecordReuseExpr(_, build, _, _):
			match product_build_values(build).get(0):
				Some(value):
					first_dup_policy(value)
				None:
					None
		_:
			None


pure func takes_items_from_state(policy: Option[CoreRetainPolicy]) -> Bool:
	match policy:
		Some(CowFieldTakeRetainPolicy(record_var, ordinal, record_name)):
			(
				record_var.name == state_var().name
				and record_var.id == state_var().id
				and core_field_ordinals_equal(ordinal, test_field_ordinal("items"))
				and record_name == "State"
			)
		_:
			False


pure func keeps_arc_retain(policy: Option[CoreRetainPolicy]) -> Bool:
	match policy:
		Some(ArcRetainPolicy):
			True
		_:
			False


pure func hoisted_items_var() -> CoreVar:
	unique_var("next_items", 41)


pure func hoisted_items_var_expr() -> CoreExpr:
	VarExpr(hoisted_items_var(), list_int_type(), synthetic_core_source_loc())


pure func hoisted_items_binding(body: CoreExpr) -> CoreExpr:
	LetExpr(
		hoisted_items_var(),
		False,
		list_int_type(),
		inlined_append(owned_items_read(ArcRetainPolicy)),
		body,
	)


pure func hoisted_items_cow_update(source: CoreExpr) -> CoreExpr:
	state_cow_update(
		source,
		[
			items_cow_field(Some(hoisted_items_var_expr())),
			top_cow_field(Some(int_expr(1))),
		],
	)


pure func hoisted_items_record_reuse() -> CoreExpr:
	RecordReuseExpr(
		state_var_expr(),
		product_build_in_declared_order([
			hoisted_items_var_expr(),
			int_expr(1),
		]),
		state_type(),
		synthetic_core_source_loc(),
	)


pure func length_of_state_items() -> CoreExpr:
	CallExpr(
		UnknownCall,
		VarExpr(named_var("length"), VoidType, synthetic_core_source_loc()),
		[state_field_read("items", list_int_type())],
		int_type(),
		synthetic_core_source_loc(),
	)


