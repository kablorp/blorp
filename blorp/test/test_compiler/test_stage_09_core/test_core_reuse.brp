pure func test_rewrites_dead_heap_record_allocation_in_range_body() -> Bool:
	source_var: CoreVar = unique_var("__record_update", 17)
	result_var: CoreVar = named_var("__cdrop___record_update")
	record_type: CoreType = heap_record_type("Counter")
	rewritten: CoreExpr = rewrite_post_perceus_expr(
