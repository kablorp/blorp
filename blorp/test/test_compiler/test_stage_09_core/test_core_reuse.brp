---
A replacement that can leave through `break` after the take would leave the
taken slot empty in a record that outlives the update, so the take is
refused: here a later argument of the consuming call breaks.
---
pure func test_keeps_retain_when_later_argument_may_break() -> Bool:
	rewritten: CoreExpr = rewrite_post_perceus_expr(
		state_cow_update(
			state_var_expr(),
			[
				items_cow_field(
					Some(
						consuming_append([
							owned_items_read(ArcRetainPolicy),
							BreakExpr(int_type(), synthetic_core_source_loc()),
						]),
					),
				),
				top_cow_field(None),
			],
		),
	)

	keeps_arc_retain(first_replacement_policy(rewritten))


---
Replacements all run before the source is consumed, so an exit in a later
replacement runs after an earlier replacement's take: refused too.
---
pure func test_keeps_retain_when_later_replacement_may_continue() -> Bool:
	rewritten: CoreExpr = rewrite_post_perceus_expr(
		RecordReuseExpr(
			state_var_expr(),
			product_build_in_declared_order([
				inlined_append(owned_items_read(ArcRetainPolicy)),
				ContinueExpr(int_type(), synthetic_core_source_loc()),
			]),
			state_type(),
			synthetic_core_source_loc(),
		),
	)

	keeps_arc_retain(first_replacement_policy(rewritten))


---
The hoisted form: the binding that takes the field can itself break after
the take, before the update writes the slot back.
---
pure func test_keeps_hoisted_retain_when_binding_may_break() -> Bool:
	rewritten: CoreExpr = rewrite_post_perceus_expr(
		LetExpr(
			hoisted_items_var(),
			False,
			list_int_type(),
			consuming_append([
				owned_items_read(ArcRetainPolicy),
				BreakExpr(int_type(), synthetic_core_source_loc()),
			]),
			hoisted_items_cow_update(state_var_expr()),
		),
	)

	keeps_arc_retain(first_dup_policy(rewritten))


