---
A fixture field's position in the field lists the tests build: `items` or
`outcome` first, then `top` or `backup`. `value` is `Counter`'s only field and
`inner` names a `State` field no list here holds. Any other name gets an
ordinal no fixture record has, so a misspelled field reads nothing a test
expects.
---
pure func test_field_ordinal(name: String) -> CoreFieldOrdinal:
	position: Int = match name:
		"items" | "outcome" | "value":
			0
		"top" | "backup":
			1
		"inner":
			2
		_:
			UNKNOWN_FIXTURE_FIELD_POSITION

	core_field_ordinal(position)


private UNKNOWN_FIXTURE_FIELD_POSITION: Int = 99


---
Fixture field identity: this test file's records are ad hoc (built directly
as `CoreRecordFieldValue`/`CoreHeapRecordField` literals, not lowered from
declarations), so there is no declaration ordinal to read. A stable per-name
ordinal reproduces the pre-identity behavior (fields compared by name) without
needing every fixture to track real declaration positions, since the passes
under test now compare `CoreFieldRef`s rather than name strings.
---
pure func test_field_ref(name: String) -> CoreFieldRef:
	ordinal: Int = match name:
		"backup":
			0
		"inner":
			1
		"items":
			2
		"outcome":
			3
		"top":
			4
		"value":
			5
		_:
			-2

	core_field_ref(ordinal)


pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = None,
		origin = AuthoredBinder
	}


pure func unique_var(name: String, id: Int) -> CoreVar:
	{
		name = name,
		id = id,
		def_id = None,
		origin = AuthoredBinder
	}


pure func expr_type() -> CoreType:
	UnionType("Expr", ManagedUnionValue)


pure func union_type(name: String) -> CoreType:
	UnionType(name, ManagedUnionValue)


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func string_type() -> CoreType:
	NamedType("String", [])


pure func list_int_type() -> CoreType:
	NamedType("List", [int_type()])


pure func set_int_type() -> CoreType:
	NamedType("Set", [int_type()])


pure func dict_int_string_type() -> CoreType:
	NamedType(
		"Dict",
		[int_type(), string_type()],
	)


pure func heap_record_type(name: String) -> CoreType:
	HeapRecordType(name)


pure func int_expr(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), int_type(), synthetic_core_source_loc())


pure func bool_expr(value: Bool) -> CoreExpr:
	LiteralExpr(
		BoolLiteral(value),
		NamedType("Bool", []),
		synthetic_core_source_loc(),
	)


pure func range_loop_binder() -> CoreLoopBinder:
	{
		variable = named_var("index"),
		typ = int_type(),
		range_direction = RangeForwardOnly
	}


pure func expr_union_field() -> CoreUnionField:
	{
		typ = expr_type(),
		release_policy = ArcReleasePolicy
	}


pure func expr_union_decl() -> CoreUnionDecl:
	{
		abi_type = None,
		name = "Expr",
		type_params = [],
		storage = ManagedPayloadStorage(ErasedUnionPayloadStorage),
		variants = [
			{
				name = "Add",
				tag = 1,
				fields = [expr_union_field(), expr_union_field()],
				def_id = None
			},
			{
				name = "Num",
				tag = 2,
				fields = [],
				def_id = None
			},
		],
		loc = synthetic_core_source_loc()
	}


pure func decls() -> List[CoreDecl]:
	[UnionDecl(expr_union_decl())]


pure func prepared_program(custom_decls: List[CoreDecl], body: CoreExpr) -> CoreProgram:
	{
		decls = custom_decls.append(FunctionDecl({
			name = "entry",
			source_module = None,
			type_params = [],
			params = [],
			return_type = expr_type(),
			body = Some(body),
			is_pure = True,
			origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
			module = FIXTURE_NO_SOURCE_MODULE,
			function_kind = UserFunction,
			def_id = 9001,
			loc = synthetic_core_source_loc(),
		})),
		foreign_includes = [],
		source_files = []
	}


pure func dummy_global_decl(name: String, order_value: Int) -> CoreDecl:
	GlobalDecl({
		name = unique_var(name, order_value),
		source_module = None,
		typ = int_type(),
		init = int_expr(order_value),
		is_mutable = False,
		is_const = False,
		is_private = False,
		def_id = 9100 + order_value,
		loc = synthetic_core_source_loc(),
	})


pure func union_decl_with_name_and_variants(
	name: String,
	variants: List[CoreUnionVariant],
) -> CoreDecl:
	UnionDecl({ expr_union_decl() |
			name = name,
			variants = variants
		})


pure func variant_with_fields(
	name: String,
	tag: Int,
	fields: List[CoreUnionField],
) -> CoreUnionVariant:
	{
		name = name,
		tag = tag,
		fields = fields,
		def_id = Some(9200 + tag)
	}


pure func variant_with_field_policy(name: String, policy: CoreReleasePolicy) -> CoreUnionVariant:
	variant_with_fields(
		name,
		1,
		[
			{
				typ = expr_type(),
				release_policy = policy
			},
		],
	)


pure func expr_var() -> CoreVar:
	named_var("expr")


pure func result_var() -> CoreVar:
	named_var("result")


pure func left_var() -> CoreVar:
	unique_var("left", 1)


pure func right_var() -> CoreVar:
	unique_var("right", 2)


pure func expr_var_expr(variable: CoreVar) -> CoreExpr:
	VarExpr(variable, expr_type(), synthetic_core_source_loc())


pure func typed_var_expr(variable: CoreVar, typ: CoreType) -> CoreExpr:
	VarExpr(variable, typ, synthetic_core_source_loc())


pure func pointer_box(value: CoreExpr) -> CoreBoxedStorageValue:
	{
		kind = PointerBox,
		value = value,
		needs_release = True,
		transfers_ownership = True
	}


pure func add_construct(args: List[CoreBoxedStorageValue]) -> CoreExpr:
	union_construct("Expr", "Add", unspelled_test_variant(), expr_type(), args)


pure func union_construct(
	type_name: String,
	constructor_name: String,
	variant: CoreVariantRef,
	typ: CoreType,
	args: List[CoreBoxedStorageValue],
) -> CoreExpr:
	UnionConstructExpr(
		{
			type_name = type_name,
			constructor_name = constructor_name,
			variant = variant,
			representation = GenericUnionRepresentation,
			payload_storage = ErasedUnionPayloadStorage,
			uses_release_mask = True,
			release_mask = 3,
			args = args
		},
		typ,
		synthetic_core_source_loc(),
	)


pure func add_construct_from_fields() -> CoreExpr:
	add_construct([
		pointer_box(expr_var_expr(left_var())),
		pointer_box(expr_var_expr(right_var())),
	])


pure func field_binding(
	variable: CoreVar,
	field_index: Int,
	mode: CoreMatchBindingMode,
) -> CoreMatchBinding:
	field_binding_for(variable, "Expr", "Add", expr_type(), field_index, mode)


pure func field_binding_for(
	variable: CoreVar,
	type_name: String,
	constructor_name: String,
	typ: CoreType,
	field_index: Int,
	mode: CoreMatchBindingMode,
) -> CoreMatchBinding:
	{
		variable = variable,
		typ = typ,
		accessor = VariantFieldAccessor(RootAccessor, type_name, constructor_name, field_index),
		mode = mode,
		needs_release = type_requires_release(typ)
	}


pure func owned_add_bindings() -> List[CoreMatchBinding]:
	[
		field_binding(left_var(), 0, MatchOwnBindingMode),
		field_binding(right_var(), 1, MatchOwnBindingMode),
	]


pure func borrowed_add_bindings() -> List[CoreMatchBinding]:
	[
		field_binding(left_var(), 0, MatchBorrowBindingMode),
		field_binding(right_var(), 1, MatchBorrowBindingMode),
	]


pure func add_case(bindings: List[CoreMatchBinding], body: CoreExpr) -> CoreConstructorMatchCase:
	constructor_case("Expr", "Add", bindings, body)


pure func constructor_case(
	type_name: String,
	constructor_name: String,
	bindings: List[CoreMatchBinding],
	body: CoreExpr,
) -> CoreConstructorMatchCase:
	{
		constructor = constructor_name,
		accessor = RootAccessor,
		test = UnionTagConstructorTest(unspelled_test_variant(), ManagedTagAccess(type_name)),
		bindings = bindings,
		body = ConstructorMatchBodyExpr(body)
	}


pure func prepared_match(bindings: List[CoreMatchBinding], body: CoreExpr) -> CoreExpr:
	prepared_match_for("Expr", "Add", expr_type(), expr_var_expr(expr_var()), bindings, body)


pure func prepared_match_for(
	type_name: String,
	constructor_name: String,
	typ: CoreType,
	source: CoreExpr,
	bindings: List[CoreMatchBinding],
	body: CoreExpr,
) -> CoreExpr:
	ConstructorMatchExpr(
		source,
		ArcReleasePolicy,
		[constructor_case(type_name, constructor_name, bindings, body)],
		ConstructorMatchFallbackFail,
		typ,
		synthetic_core_source_loc(),
	)


pure func prepared_let_drop(bindings: List[CoreMatchBinding], body: CoreExpr) -> CoreExpr:
	prepared_let_drop_with_type(
		expr_type(),
		prepared_match(bindings, body),
	)


pure func prepared_let_drop_with_type(dropped_type: CoreType, rhs: CoreExpr) -> CoreExpr:
	LetExpr(
		result_var(),
		False,
		dropped_type,
		rhs,
		DropExpr(
			expr_var(),
			dropped_type,
			ArcReleasePolicy,
			typed_var_expr(result_var(), dropped_type),
			dropped_type,
			synthetic_core_source_loc(),
		),
	)


pure func rewrite_expr(expr: CoreExpr) -> CoreExpr:
	rewrite_prepared_expr(decls(), expr)


pure func list_var_expr(variable: CoreVar) -> CoreExpr:
	VarExpr(variable, list_int_type(), synthetic_core_source_loc())


pure func list_alloc_expr(capacity: Int) -> CoreExpr:
	ListAllocExpr(
		{
			layout = InlineListStorage(8),
			capacity = int_expr(capacity),
			elem_needs_release = False
		},
		list_int_type(),
		synthetic_core_source_loc(),
	)


pure func set_alloc_expr() -> CoreExpr:
	SetAllocExpr(GenericHashContainerConstructor, set_int_type(), synthetic_core_source_loc())


pure func dict_construct_expr() -> CoreExpr:
	DictConstructExpr(
		{
			constructor = GenericHashContainerConstructor,
			entries = [],
			value_needs_release = True
		},
		dict_int_string_type(),
		synthetic_core_source_loc(),
	)


pure func dropped_allocation_expr(
	dropped_var: CoreVar,
	result_var: CoreVar,
	typ: CoreType,
	allocation: CoreExpr,
) -> CoreExpr:
	DropExpr(
		dropped_var,
		typ,
		ArcReleasePolicy,
		LetExpr(
			result_var,
			False,
			typ,
			allocation,
			VarExpr(result_var, typ, synthetic_core_source_loc()),
		),
		typ,
		synthetic_core_source_loc(),
	)


pure func list_handoff_expr_with_body(
	source_var: CoreVar,
	result_var: CoreVar,
	body: CoreExpr,
) -> CoreExpr:
	ListHandoffExpr(
		{
			mode = BorrowFreshHandoff,
			layout = InlineListStorage(8),
			elem_needs_release = False,
			source = list_var_expr(source_var),
			source_var = unique_var("__lh_source", 20),
			source_type = list_int_type(),
			result_type = list_int_type(),
			capacity = int_expr(4),
			result_var = result_var,
			len_var = unique_var("__lh_len", 21),
			out_var = unique_var("__lh_out", 22),
			body = body,
			write_order = ForwardCompactingHandoff
		},
		list_int_type(),
		synthetic_core_source_loc(),
	)


pure func list_handoff_expr(source_var: CoreVar, result_var: CoreVar) -> CoreExpr:
	list_handoff_expr_with_body(
		source_var,
		result_var,
		VoidExpr(VoidType, synthetic_core_source_loc()),
	)


pure func dropped_handoff_expr() -> CoreExpr:
	source_var: CoreVar = named_var("xs")
	handoff_result_var: CoreVar = named_var("__cdrop_xs")

	LetExpr(
		handoff_result_var,
		False,
		list_int_type(),
		list_handoff_expr(source_var, handoff_result_var),
		DropExpr(
			source_var,
			list_int_type(),
			ArcReleasePolicy,
			list_var_expr(handoff_result_var),
			list_int_type(),
			synthetic_core_source_loc(),
		),
	)


pure func record_fields(value: CoreExpr) -> CoreProductBuild:
	product_build_in_declared_order([value])


pure func dropped_record_result_expr(
	source_var: CoreVar,
	result_var: CoreVar,
	source_type: CoreType,
	result_type: CoreType,
	release_policy: CoreReleasePolicy,
	build: CoreProductBuild,
) -> CoreExpr:
	LetExpr(
		result_var,
		False,
		result_type,
		ProductExpr(build, result_type, synthetic_core_source_loc()),
		DropExpr(
			source_var,
			source_type,
			release_policy,
			VarExpr(result_var, result_type, synthetic_core_source_loc()),
			result_type,
			synthetic_core_source_loc(),
		),
	)


pure func top_record_reuse_source(expr: CoreExpr) -> Option[CoreVar]:
	match expr:
		RecordReuseExpr(source, build, typ, loc):
			match source:
				VarExpr(variable, source_type, source_loc):
					Some(variable)
				_:
					None
		_:
			None


pure func intrinsic_name_from_kind(kind: CoreCallKind) -> Option[String]:
	match kind:
		IntrinsicCall(name):
			Some(name)
		BuiltinCall(name):
			None
		UserCall(name, def_id, captured_def_ids):
			None
		ForeignCall(name, arg_passing):
			None
		DirectRuntimeCall(call):
			None
		OperationResultCall(call):
			None
		FallibleStreamTerminalCall(call):
			None
		TensorParallelCall(name, layout):
			None
		DictWithCapacityCall(constructor):
			None
		ListToStringCall(name, _):
			None
		ClosureCall:
			None
		UnknownCall:
			None
		SelectedDirectCall(def_id):
			None
		_:
			None


pure func top_intrinsic_name(expr: CoreExpr) -> Option[String]:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			intrinsic_name_from_kind(kind)
		LiteralExpr(literal, typ, loc):
			None
		StaticStringLiteralExpr(id, value, typ, loc):
			None
		VarExpr(variable, typ, loc):
			None
		VoidExpr(typ, loc):
			None
		DebugBlockExpr(body, typ, loc):
			None
		CooperativeCheckpointExpr(typ, loc):
			None
		BinaryExpr(op, left, right, typ, loc):
			None
		UnaryExpr(op, inner, typ, loc):
			None
		LogicalExpr(op, left, right, typ, loc):
			None
		AssignExpr(variable, rhs, typ, loc):
			None
		CastExpr(inner, typ, loc):
			None
		BoxExpr(box, typ, loc):
			None
		UnboxExpr(unbox_kind, inner, typ, loc):
			None
		ProductFieldExpr(inner, _, typ, loc):
			None
		ModuleMemberExpr(_, _, _, _):
			None
		TupleExpr(items, typ, loc):
			None
		VectorExpr(items, typ, loc):
			None
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			None
		ClosureCreateExpr(closure, typ, loc):
			None
		ListConstructExpr(construct, typ, loc):
			None
		ListAllocExpr(alloc, typ, loc):
			None
		ListGetExpr(get, typ, loc):
			None
		ListHandoffExpr(handoff, typ, loc):
			None
		ListHandoffSetOwnedExpr(set, typ, loc):
			None
		ListHandoffSetSourceSlotExpr(set, typ, loc):
			None
		StringByteReadExpr(read, typ, loc):
			None
		StringByteWriteExpr(write, typ, loc):
			None
		StringByteCopyExpr(copy, typ, loc):
			None
		StringSetLenExpr(set_len, typ, loc):
			None
		TensorLiteralExpr(literal, typ, loc):
			None
		TensorBoxedLiteralExpr(literal, typ, loc):
			None
		TensorPackedLiteralExpr(literal, typ, loc):
			None
		TensorRawFillExpr(fill, typ, loc):
			None
		TensorRawReadExpr(read, typ, loc):
			None
		TensorRawWriteExpr(write, typ, loc):
			None
		TensorRawViewLetExpr(binding, body, typ, loc):
			None
		DictExpr(entries, typ, loc):
			None
		DictConstructExpr(construct, typ, loc):
			None
		SetAllocExpr(alloc, typ, loc):
			None
		ListRetainExpr(retain, typ, loc):
			None
		ListSetExpr(set, typ, loc):
			None
		ListSwapExpr(swap, typ, loc):
			None
		ProductExpr(build, typ, loc):
			None
		RecordUpdateExpr(base, fields, typ, loc):
			None
		RecordReuseExpr(source, build, typ, loc):
			None
		RecordCowUpdateExpr(source, fields, typ, loc):
			None
		UnionConstructExpr(construct, typ, loc):
			None
		UnionReuseConstructExpr(construct, typ, loc):
			None
		PreClosureDetachExpr(detached, typ, loc):
			None
		DetachExpr(detached, typ, loc):
			None
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			None
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			None
