pure func test_normalized_retained_relay_requires_matching_later_drop() -> Bool:
	assignment = normalized_source_assignment(retained_items_writeback())
	(
		normalized_alias_keeps_retain(assignment)
		and normalized_alias_keeps_retain(SeqExpr(assignment, alias_cleanup(named_var("other"), list_int_type())))
		and normalized_alias_keeps_retain(SeqExpr(assignment, alias_cleanup(hoisted_items_var(), string_type())))
		and normalized_alias_keeps_retain(SeqExpr(alias_cleanup(hoisted_items_var(), list_int_type()), assignment))
		and normalized_alias_keeps_retain(SeqExpr(
			SeqExpr(assignment, hoisted_items_var_expr()),
			alias_cleanup(hoisted_items_var(), list_int_type()),
		))
	)


pure func test_normalized_result_wrapper_rejects_authored_spelling() -> Bool:
	result = unique_var("brp_vd_fixture_d0", 93)
	body = LetExpr(
		result,
		False,
		state_type(),
		normalized_items_writeback(int_expr(1)),
		typed_var_expr(result, state_type()),
	)
	normalized_alias_keeps_retain(body)


pure func test_normalized_later_closure_keeps_retain() -> Bool:
	lambda_type = FunctionType(True, [], int_type())
	later = CallExpr(
		IntrinsicCall("apply"),
		typed_var_expr(named_var("apply"), FunctionType(True, [lambda_type], int_type())),
		[LambdaExpr([], int_type(), int_expr(1), True, lambda_type, synthetic_core_source_loc())],
		int_type(),
		synthetic_core_source_loc(),
	)
	created_closure = CallExpr(
		IntrinsicCall("apply"),
		typed_var_expr(named_var("apply"), FunctionType(True, [lambda_type], int_type())),
		[ClosureCreateExpr({ def_id = 99, captures = [] }, lambda_type, synthetic_core_source_loc())],
		int_type(),
		synthetic_core_source_loc(),
	)
	(
		normalized_alias_keeps_retain(normalized_items_writeback(later))
		and normalized_alias_keeps_retain(normalized_items_writeback(created_closure))
	)


pure func test_normalized_retained_relay_rejects_exit_or_rebind() -> Bool:
	assignment = normalized_source_assignment(retained_items_writeback())
	cleanup = alias_cleanup(hoisted_items_var(), list_int_type())
	(
		normalized_alias_keeps_retain(SeqExpr(
			SeqExpr(assignment, BreakExpr(VoidType, synthetic_core_source_loc())), cleanup,
		))
		and normalized_alias_keeps_retain(SeqExpr(
			SeqExpr(assignment, normalized_source_assignment(state_var_expr())), cleanup,
		))
	)


