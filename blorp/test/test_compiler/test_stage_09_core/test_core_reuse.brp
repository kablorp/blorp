---
A binding evaluated before the update cannot observe the reused record, so an
update that ends a `let` still gets the field take.
---
pure func test_takes_cow_field_after_preceding_binding() -> Bool:
	rewritten: CoreExpr = rewrite_post_perceus_expr(
		LetExpr(
			named_var("probe"),
			False,
			int_type(),
			state_field_read(
				"top",
				int_type(),
			),
			state_cow_update(
				state_var_expr(),
				[
					items_cow_field(Some(inlined_append(owned_items_read(ArcRetainPolicy)))),
					top_cow_field(Some(int_expr(1))),
				],
			),
		),
	)

	match rewritten:
		LetExpr(_, _, _, _, body):
			takes_items_from_state(first_replacement_policy(body))
		_:
			False


---
The update can sit in a match arm under a binding, the shape a `match` on a
computed value lowers to: the take still applies there.
---
pure func test_takes_cow_field_in_match_arm_under_binding() -> Bool:
	scrutinee: CoreVar = named_var("scrutinee")
	update: CoreExpr = state_cow_update(
		state_var_expr(),
		[
			items_cow_field(Some(inlined_append(owned_items_read(ArcRetainPolicy)))),
			top_cow_field(Some(int_expr(1))),
		],
	)
	rewritten: CoreExpr = rewrite_post_perceus_expr(
		LetExpr(
			scrutinee,
			False,
			int_type(),
			state_field_read("top", int_type()),
			LiteralMatchExpr(
				VarExpr(scrutinee, int_type(), synthetic_core_source_loc()),
				[
					{
						literal = IntLiteral(0),
						bindings = [],
						body = update
					},
				],
				LiteralMatchFallbackBody(state_var_expr()),
				state_type(),
				synthetic_core_source_loc(),
			),
		),
	)

	match rewritten:
		LetExpr(_, _, _, _, LiteralMatchExpr(_, cases, _, _, _)):
			match cases.get(0):
				Some(first_case):
					takes_items_from_state(first_replacement_policy(first_case.body))
				None:
					False
		_:
			False


