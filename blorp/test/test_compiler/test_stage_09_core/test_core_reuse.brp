private pure func normalized_relay_writeback(
	relay: CoreVar,
	relay_type: CoreType,
	relay_rhs: CoreExpr,
	later_rhs: CoreExpr,
	ordinal: Int,
) -> CoreExpr:
	later = product_field_var("later_field", -92)
	LetExpr(
		relay,
		False,
		relay_type,
		relay_rhs,
		LetExpr(
			later,
			False,
			int_type(),
			later_rhs,
			RecordReuseExpr(
				state_var_expr(),
				fixture_build(2, [
					(ordinal, typed_var_expr(relay, relay_type)),
					(1 - ordinal, typed_var_expr(later, int_type())),
				]),
				state_type(),
				synthetic_core_source_loc(),
			),
		),
	)


private pure func normalized_items_writeback(later_rhs: CoreExpr) -> CoreExpr:
	normalized_relay_writeback(
		product_field_var("item_field", -91),
		list_int_type(),
		hoisted_items_var_expr(),
		later_rhs,
		0,
	)


private pure func normalized_alias_is_taken(body: CoreExpr) -> Bool:
	rewritten = rewrite_post_perceus_expr(hoisted_items_binding(body))
	match rewritten:
		LetExpr(_, False, _, rhs, actual_body):
			(
				takes_items_from_state(first_dup_policy(rhs))
				and core_program_to_json(prepared_program([], actual_body)).to_string() == core_program_to_json(
					prepared_program([], body),
				).to_string()
			)
		_:
			False


private pure func normalized_alias_keeps_retain(body: CoreExpr) -> Bool:
	keeps_arc_retain(first_dup_policy(rewrite_post_perceus_expr(hoisted_items_binding(body))))


private pure func retained_items_writeback() -> CoreExpr:
	normalized_relay_writeback(
		product_field_var("item_field", -91),
		list_int_type(),
		DupExpr(
			hoisted_items_var(),
			list_int_type(),
			ArcRetainPolicy,
			hoisted_items_var_expr(),
			list_int_type(),
			synthetic_core_source_loc(),
		),
		int_expr(1),
		0,
	)


private pure func normalized_source_assignment(rhs: CoreExpr) -> CoreExpr:
	AssignExpr(state_var(), rhs, VoidType, synthetic_core_source_loc())


private pure func alias_cleanup(variable: CoreVar, typ: CoreType) -> CoreExpr:
	DropExpr(
		variable,
		typ,
		ArcReleasePolicy,
		VoidExpr(VoidType, synthetic_core_source_loc()),
		VoidType,
		synthetic_core_source_loc(),
	)


pure func test_normalized_relay_keeps_field_take_and_owned_frames() -> Bool:
	normalized_alias_is_taken(normalized_items_writeback(int_expr(1)))


pure func test_normalized_result_wrapper_keeps_field_take() -> Bool:
	result = {
		unique_var("update_result", 93) |
		origin = DerivedFrom("fixture_anchor", DropTemp, 0)
	}
	body = LetExpr(
		result,
		False,
		state_type(),
		normalized_items_writeback(int_expr(1)),
		typed_var_expr(result, state_type()),
	)
	normalized_alias_is_taken(body)



private pure func result_identity_frame(variable: CoreVar, rhs: CoreExpr) -> CoreExpr:
	LetExpr(
		variable,
		False,
		state_type(),
		rhs,
		typed_var_expr(variable, state_type()),
	)


private pure func normalized_staged_writeback(later_rhs: CoreExpr) -> CoreExpr:
	later = {
		unique_var("staged_other_field", 94) |
		origin = RECORD_UPDATE_TEMP_ORIGIN
	}
	result = {
		unique_var("staged_update_result", 95) |
		origin = DerivedFrom("fixture_staged_field", DropTemp, 0)
	}
	LetExpr(
		later,
		False,
		int_type(),
		later_rhs,
		result_identity_frame(result, normalized_items_writeback(typed_var_expr(later, int_type()))),
	)


pure func test_nested_normalized_result_frames_keep_field_take() -> Bool:
	outer = {
		unique_var("outer_update_result", 96) |
		origin = DerivedFrom("fixture_outer_field", DropTemp, 0)
	}
	inner = {
		unique_var("inner_update_result", 97) |
		origin = DerivedFrom("fixture_inner_field", DropTemp, 0)
	}
	body = result_identity_frame(
		outer,
		result_identity_frame(inner, normalized_items_writeback(int_expr(1))),
	)
	normalized_alias_is_taken(body)


pure func test_sparse_staged_result_frames_keep_field_take() -> Bool:
	result = {
		unique_var("sparse_update_result", 98) |
		origin = DerivedFrom("fixture_sparse_field", DropTemp, 0)
	}
	body = result_identity_frame(result, normalized_staged_writeback(state_field_read("top", int_type())))
	normalized_alias_is_taken(body)


pure func test_nested_normalized_result_frames_require_typed_identity_return() -> Bool:
	result = {
		unique_var("malformed_update_result", 99) |
		origin = DerivedFrom("fixture_malformed_field", DropTemp, 0)
	}
	writeback = normalized_items_writeback(int_expr(1))
	malformed_return = LetExpr(
		result,
		False,
		state_type(),
		writeback,
		SeqExpr(hoisted_items_var_expr(), typed_var_expr(result, state_type())),
	)
	authored_result = unique_var("authored_update_result", 100)
	wrong_type_return = LetExpr(
		result,
		False,
		state_type(),
		writeback,
		typed_var_expr(result, string_type()),
	)
	mutable_result = LetExpr(
		result,
		True,
		state_type(),
		writeback,
		typed_var_expr(result, state_type()),
	)
	(
		normalized_alias_keeps_retain(result_identity_frame(authored_result, writeback))
		and normalized_alias_keeps_retain(malformed_return)
		and normalized_alias_keeps_retain(wrong_type_return)
		and normalized_alias_keeps_retain(mutable_result)
	)



pure func test_sparse_staged_result_frames_require_checked_stage_identity() -> Bool:
	staged = {
		unique_var("staged_other_field", 94) |
		origin = RECORD_UPDATE_TEMP_ORIGIN
	}
	result = {
		unique_var("staged_update_result", 95) |
		origin = DerivedFrom("fixture_staged_field", DropTemp, 0)
	}
	writeback = result_identity_frame(result, normalized_items_writeback(int_expr(1)))
	authored = { staged | origin = AuthoredBinder }
	(
		normalized_alias_keeps_retain(LetExpr(authored, False, int_type(), int_expr(1), writeback))
		and normalized_alias_keeps_retain(LetExpr(staged, True, int_type(), int_expr(1), writeback))
		and normalized_alias_keeps_retain(LetExpr(staged, False, string_type(), int_expr(1), writeback))
	)

pure func test_sparse_staged_result_frames_reject_unsafe_prefix() -> Bool:
	(
		normalized_alias_keeps_retain(normalized_staged_writeback(SeqExpr(hoisted_items_var_expr(), int_expr(1))))
		and normalized_alias_keeps_retain(normalized_staged_writeback(SeqExpr(
			state_field_read("items", list_int_type()), int_expr(1),
		)))
		and normalized_alias_keeps_retain(normalized_staged_writeback(SeqExpr(
			normalized_source_assignment(state_var_expr()), int_expr(1),
		)))
		and normalized_alias_keeps_retain(normalized_staged_writeback(SeqExpr(
			BreakExpr(VoidType, synthetic_core_source_loc()), int_expr(1),
		)))
	)

pure func test_normalized_later_call_keeps_field_take() -> Bool:
	later_call = CallExpr(
		IntrinsicCall("int_identity"),
		typed_var_expr(named_var("int_identity"), FunctionType(True, [int_type()], int_type())),
		[state_field_read("top", int_type())],
		int_type(),
		synthetic_core_source_loc(),
	)
	normalized_alias_is_taken(normalized_items_writeback(later_call))


pure func test_normalized_retained_relay_balances_original_owner() -> Bool:
	assignment = normalized_source_assignment(retained_items_writeback())
	bookkeeping = AssignExpr(named_var("index"), int_expr(1), VoidType, synthetic_core_source_loc())
	body = SeqExpr(
		SeqExpr(assignment, bookkeeping),
		alias_cleanup(hoisted_items_var(), list_int_type()),
	)
	normalized_alias_is_taken(body)


pure func test_normalized_relay_rejects_authored_or_wrong_type_or_ordinal() -> Bool:
