pure func count_reuse_in_body(body: CoreConstructorMatchBody) -> Int:
	match body:
		ConstructorMatchBodyExpr(expr):
			count_reuse(expr)
		ConstructorMatchBodyLiteral(match_expr):
			0
		ConstructorMatchBodyLength(match_expr):
			0


pure func count_reuse_in_cases(cases: List[CoreConstructorMatchCase]) -> Int:
	var count: Int = 0

	for match_case in cases:
		count += count_reuse_in_body(match_case.body)

	count


pure func count_reuse_in_exprs(exprs: List[CoreExpr]) -> Int:
	var count: Int = 0

	for expr in exprs:
		count += count_reuse(expr)

	count


pure func count_reuse_in_dict_entries(entries: List[CoreDictLiteralEntry]) -> Int:
	var count: Int = 0

	for entry in entries:
		count += count_reuse(entry.key) + count_reuse(entry.value)

	count


pure func count_reuse_in_raw_cases(cases: List[CoreRawMatchCase]) -> Int:
	var count: Int = 0

	for match_case in cases:
		count += count_reuse(match_case.body)

	count


private pure func count_reuse_in_semantic_tree(tree: CoreSemanticMatchTree) -> Int:
	match tree:
		SemanticMatchLeaf(bindings, body):
			count_reuse(body)
		SemanticMatchFail:
			0
		SemanticConstructorMatch(accessor, cases, fallback):
			var total: Int = 0

			for match_case in cases:
				total += count_reuse_in_semantic_tree(match_case.body)

			match fallback:
				Some(fallback_tree):
					total += count_reuse_in_semantic_tree(fallback_tree)
				None:
					void

			total
		SemanticLiteralMatch(accessor, cases, fallback):
			var total: Int = count_reuse_in_semantic_tree(fallback)

			for match_case in cases:
				total += count_reuse_in_semantic_tree(match_case.body)

			total
		SemanticLengthMatch(accessor, cases, geq, fallback):
			var total: Int = 0

			for match_case in cases:
				total += count_reuse_in_semantic_tree(match_case.body)

			match geq:
				Some(geq_case):
					total += count_reuse_in_semantic_tree(geq_case.body)
				None:
					void

			match fallback:
				Some(fallback_tree):
					total += count_reuse_in_semantic_tree(fallback_tree)
				None:
					void

			total


pure func count_reuse(expr: CoreExpr) -> Int:
	match expr:
		UnionReuseConstructExpr(construct, typ, loc):
			1
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			count_reuse(scrutinee) + count_reuse_in_cases(cases)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			count_reuse(cond) + count_reuse(then_expr) + count_reuse(else_expr)
		LetExpr(variable, is_mutable, value_type, rhs, body):
			count_reuse(rhs) + count_reuse(body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			count_reuse(body)
		BorrowLetExpr(variable, value_type, rhs, body):
			count_reuse(rhs) + count_reuse(body)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			count_reuse(body)
		SeqExpr(first, second):
			count_reuse(first) + count_reuse(second)
		CallExpr(kind, callee, args, typ, loc):
			count_reuse(callee) + count_reuse_in_exprs(args)
		BinaryExpr(op, left, right, typ, loc):
			count_reuse(left) + count_reuse(right)
		UnaryExpr(op, inner, typ, loc):
			count_reuse(inner)
		LogicalExpr(op, left, right, typ, loc):
			count_reuse(left) + count_reuse(right)
		AssignExpr(variable, rhs, typ, loc):
			count_reuse(rhs)
		CastExpr(inner, typ, loc):
			count_reuse(inner)
		UnboxExpr(unbox_kind, inner, typ, loc):
			count_reuse(inner)
		ProductFieldExpr(inner, _, typ, loc):
			count_reuse(inner)
		ModuleMemberExpr(_, _, _, _):
			0
		TupleExpr(items, typ, loc):
			count_reuse_in_exprs(items)
		VectorExpr(items, typ, loc):
			count_reuse_in_exprs(items)
		TensorRawViewLetExpr(binding, body, typ, loc):
			count_reuse(body)
		WhileExpr(cond, body, typ, loc):
			count_reuse(cond) + count_reuse(body)
		TailrecLoopExpr(params, return_type, body, loc):
			count_reuse(body)
		TailrecRecurExpr(args, typ, loc):
			count_reuse_in_exprs(args)
		TailrecListSpreadRecurExpr(rebinds, spread_index, typ, loc):
			0
		ForRangeExpr(binder, start, end, step, typ, loc):
			count_reuse(start) + count_reuse(end) + count_reuse(step)
		RawMatchExpr(scrutinee, cases, typ, loc):
			count_reuse(scrutinee) + count_reuse_in_raw_cases(cases)
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			count_reuse(scrutinee) + count_reuse_in_semantic_tree(tree)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			count_reuse(scrutinee)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			count_reuse(scrutinee)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			count_reuse(scrutinee)
		UnionConstructExpr(construct, typ, loc):
			0
		VarExpr(variable, typ, loc):
			0
		LiteralExpr(literal, typ, loc):
			0
		StaticStringLiteralExpr(id, value, typ, loc):
			0
		VoidExpr(typ, loc):
			0
		DebugBlockExpr(body, typ, loc):
			count_reuse(body)
		CooperativeCheckpointExpr(typ, loc):
			0
		BoxExpr(box, typ, loc):
			0
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			count_reuse(body)
		ClosureCreateExpr(closure, typ, loc):
			0
		ListConstructExpr(construct, typ, loc):
			0
		ListAllocExpr(alloc, typ, loc):
			0
		ListGetExpr(get, typ, loc):
			0
		ListHandoffExpr(handoff, typ, loc):
			count_reuse(handoff.source) + count_reuse(handoff.capacity) + count_reuse(handoff.body)
		ListHandoffSetOwnedExpr(set, typ, loc):
			0
		ListHandoffSetSourceSlotExpr(set, typ, loc):
			0
		StringByteReadExpr(read, typ, loc):
			0
		StringByteWriteExpr(write, typ, loc):
			0
		StringByteCopyExpr(copy, typ, loc):
			0
		StringSetLenExpr(set_len, typ, loc):
			0
		TensorLiteralExpr(literal, typ, loc):
			0
		TensorBoxedLiteralExpr(literal, typ, loc):
			0
		TensorPackedLiteralExpr(literal, typ, loc):
			0
		TensorRawFillExpr(fill, typ, loc):
			0
		TensorRawReadExpr(read, typ, loc):
			0
		TensorRawWriteExpr(write, typ, loc):
			0
		DictExpr(entries, typ, loc):
			count_reuse_in_dict_entries(entries)
		DictConstructExpr(construct, typ, loc):
			0
		SetAllocExpr(alloc, typ, loc):
			0
		ListRetainExpr(retain, typ, loc):
			0
		ListSetExpr(set, typ, loc):
			0
		ListSwapExpr(swap, typ, loc):
			0
		ProductExpr(build, typ, loc):
			0
		RecordUpdateExpr(base, fields, typ, loc):
			0
		RecordReuseExpr(source, build, typ, loc):
			1
		RecordCowUpdateExpr(source, fields, typ, loc):
			0
		PreClosureDetachExpr(detached, typ, loc):
			count_reuse(detached)
		DetachExpr(detached, typ, loc):
			0
		BreakExpr(typ, loc):
			0
		ContinueExpr(typ, loc):
			0
		ResourceScopeExpr(scope, typ, loc):
			0
		ResourceCleanupExitExpr(exit, typ, loc):
			0
		TailrecListSpreadLoopExpr(loop, loc):
			0
		ForChannelExpr(loop, typ, loc):
			0
		ForListExpr(loop, typ, loc):
			count_reuse(loop.iterable) + count_reuse(loop.body)
		ForStringExpr(loop, typ, loc):
			0
		ForDictExpr(loop, typ, loc):
			0
		ForSetExpr(loop, typ, loc):
			0
		ForStreamExpr(loop, typ, loc):
			0
		ForResourceSourceExpr(loop, typ, loc):
			0
		ForTensorExpr(loop, typ, loc):
			0
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			count_reuse(loop.iterable) + count_reuse(loop.body)
		ConcurrentlyLoopExpr(loop, typ, loc):
			0
		PreClosureConcurrentExpr(block, typ, loc):
			count_reuse(block.body)
		ConcurrentExpr(block, typ, loc):
			0
		SelectExpr(selection, typ, loc):
			0


pure func count_reuse_in_function(func_info: CoreFunction) -> Int:
	match func_info.body:
		Some(body):
			count_reuse(body)
		None:
			0


pure func count_reuse_in_decl(decl: CoreDecl) -> Int:
	match decl:
		FunctionDecl(func_info):
			count_reuse_in_function(func_info)
		GlobalDecl(global):
			count_reuse(global.init)
		_:
			0


pure func count_reuse_in_program(program: CoreProgram) -> Int:
	var total: Int = 0

	for decl in program.decls:
		total += count_reuse_in_decl(decl)

	total


pure func rewrite_program(custom_decls: List[CoreDecl], body: CoreExpr) -> CoreProgram:
	rewrite_prepared_program(prepared_program(custom_decls, body))


pure func rewrite_program_reuse_count(custom_decls: List[CoreDecl], body: CoreExpr) -> Int:
	count_reuse_in_program(rewrite_program(custom_decls, body))


pure func named_expr_type() -> CoreType:
	NamedType("Expr", [])


pure func prepared_named_expr_let_drop(body: CoreExpr) -> CoreExpr:
	prepared_let_drop_with_type(
		named_expr_type(),
		prepared_match_for(
			"Expr",
			"Add",
			named_expr_type(),
			typed_var_expr(expr_var(), named_expr_type()),
			owned_add_bindings(),
			body,
		),
	)


pure func single_field_variant_decl(policy: CoreReleasePolicy) -> CoreDecl:
	union_decl_with_name_and_variants("Expr", [variant_with_field_policy("Add", policy)])


pure func single_field_construct() -> CoreExpr:
	add_construct([pointer_box(expr_var_expr(left_var()))])


pure func test_prepared_reuse_recognizes_union_declaration_positions() -> Bool:
	body: CoreExpr = prepared_let_drop(owned_add_bindings(), add_construct_from_fields())

	beginning: Int = rewrite_program_reuse_count(
		[UnionDecl(expr_union_decl()), dummy_global_decl("after", 1)],
		body,
	)
	middle: Int = rewrite_program_reuse_count(
		[
			dummy_global_decl("before", 1),
			UnionDecl(expr_union_decl()),
			dummy_global_decl("after", 2),
		],
		body,
	)
	end: Int = rewrite_program_reuse_count(
		[
			dummy_global_decl("before", 1),
			dummy_global_decl("middle", 2),
			UnionDecl(expr_union_decl()),
		],
		body,
	)

	beginning == 1 and middle == 1 and end == 1


pure func test_prepared_reuse_recognizes_union_and_zero_arg_named_types() -> Bool:
	union_type_count: Int = rewrite_program_reuse_count(
		decls(),
		prepared_let_drop(owned_add_bindings(), add_construct_from_fields()),
	)
	named_type_count: Int = rewrite_program_reuse_count(
		decls(),
		prepared_named_expr_let_drop(
			union_construct(
				"Expr",
				"Add",
				unspelled_test_variant(),
				named_expr_type(),
				[pointer_box(typed_var_expr(left_var(), named_expr_type()))],
			),
		),
	)
	parameterized_count: Int = rewrite_program_reuse_count(
		decls(),
		prepared_let_drop_with_type(
			NamedType("Expr", [int_type()]),
			prepared_match_for(
				"Expr",
				"Add",
				NamedType("Expr", [int_type()]),
				typed_var_expr(
					expr_var(),
					NamedType("Expr", [int_type()]),
				),
				owned_add_bindings(),
				add_construct_from_fields(),
			),
		),
	)

	union_type_count == 1 and named_type_count == 1 and parameterized_count == 0


---
The source Num leaf has no payload. Its result Add owns two closed Num values,
so managed storage reaches the nonempty-allocation reuse path. The identical
allocation-shaped result is adversarial under the scalar declaration, which
must not enter the managed registry through a NamedType or managed-type view.
---
pure func prepared_fieldless_reuse_count(storage: CoreUnionStorage, typ: CoreType) -> Int:
	scalar_decl: CoreUnionDecl = {
		expr_union_decl() | storage = storage, variants = [{
			name = "Num", tag = 2, fields = [], def_id = None
		}]
	}
	declaration: CoreUnionDecl = match storage:
		ManagedPayloadStorage(_):
			expr_union_decl()
		ScalarTagStorage:
			scalar_decl
	num_value: CoreExpr = union_construct("Expr", "Num", unspelled_test_variant(), typ, [])
	add_value: CoreExpr = union_construct(
		"Expr", "Add", unspelled_test_variant(), typ,
		[pointer_box(num_value), pointer_box(num_value)],
	)
	body: CoreExpr = prepared_let_drop_with_type(
		typ,
		prepared_match_for(
			"Expr", "Num", typ, typed_var_expr(expr_var(), typ), [],
			add_value,
		),
	)
	rewrite_program_reuse_count([UnionDecl(declaration)], body)


pure func test_prepared_reuse_excludes_scalar_declaration_views() -> Bool:
	(
		prepared_fieldless_reuse_count(ManagedPayloadStorage(ErasedUnionPayloadStorage), named_expr_type()) == 1
		and prepared_fieldless_reuse_count(ScalarTagStorage, named_expr_type()) == 0
		and prepared_fieldless_reuse_count(ScalarTagStorage, UnionType("Expr", ScalarTagValue)) == 0
		and prepared_fieldless_reuse_count(ScalarTagStorage, expr_type()) == 0
	)


---
The reuse helper is spelled from the variant's id, so a generic union construct
naming a builtin Option or Result variant (a representation and variant that
disagree) is never rewritten to an in-place reuse.
---
pure func test_prepared_reuse_rejects_generic_construct_of_builtin_variant() -> Bool:
	body: CoreExpr = prepared_let_drop(
		owned_add_bindings(),
		union_construct(
			"Expr",
			"Add",
			BuiltinResultOk,
			expr_type(),
			[
				pointer_box(expr_var_expr(left_var())),
				pointer_box(expr_var_expr(right_var())),
			],
		),
	)

	rewrite_program_reuse_count(decls(), body) == 0


pure func test_prepared_reuse_fails_closed_for_missing_union_or_variant() -> Bool:
	body: CoreExpr = prepared_let_drop(owned_add_bindings(), add_construct_from_fields())
	missing_union: Int = rewrite_program_reuse_count([], body)
	missing_variant: Int = rewrite_program_reuse_count(
		[union_decl_with_name_and_variants("Expr", [variant_with_fields("Num", 1, [])])],
		body,
	)

	missing_union == 0 and missing_variant == 0


pure func test_prepared_reuse_keeps_same_spelling_variants_independent() -> Bool:
