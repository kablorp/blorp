pure func test_normalized_relay_rejects_resource_scope() -> Bool:
	later = ResourceScopeExpr(
		{
			variable = named_var("resource"),
			typ = int_type(),
			acquire = int_expr(0),
			body = int_expr(1),
			cleanup = VoidExpr(VoidType, synthetic_core_source_loc())
		},
		int_type(),
		synthetic_core_source_loc(),
