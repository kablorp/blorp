pure func list_intrinsic_prefix(name: String, args: List[CoreExpr], typ: CoreType) -> CoreExpr:
	CallExpr(
		IntrinsicCall(name),
		VoidExpr(VoidType, synthetic_core_source_loc()),
		args,
		typ,
		synthetic_core_source_loc(),
	)


