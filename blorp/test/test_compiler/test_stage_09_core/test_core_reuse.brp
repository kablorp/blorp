			product_field_var("item_field", -91),
			string_type(),
			hoisted_items_var_expr(),
			int_expr(1),
			0,
		))
		and normalized_alias_keeps_retain(normalized_relay_writeback(
			product_field_var("item_field", -91),
			list_int_type(),
			hoisted_items_var_expr(),
			int_expr(1),
			1,
		))
	)


pure func test_normalized_relay_rejects_later_alias_or_slot_reads() -> Bool:
