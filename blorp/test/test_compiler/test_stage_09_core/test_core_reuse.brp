	count == 0


pure func test_prepared_reuse_preserves_release_policy_and_binding_decisions() -> Bool:
	unmanaged_without_binding: Int = rewrite_program_reuse_count(
		[single_field_variant_decl(NoReleasePolicy)],
		prepared_let_drop([], single_field_construct()),
	)
	managed_without_binding: Int = rewrite_program_reuse_count(
		[single_field_variant_decl(ArcReleasePolicy)],
		prepared_let_drop([], single_field_construct()),
	)
	managed_with_direct_binding: Int = rewrite_program_reuse_count(
