private pure func unrelated_global_decl(name: String, value: Int) -> CoreDecl:
	GlobalDecl({
		name = core_var(name),
		source_module = Some("match_projection_test"),
		typ = named_type("Int"),
		init = int_literal(value),
		is_mutable = False,
		is_const = False,
		is_private = False,
		def_id = 600 + value,
		loc = known_loc(),
	})


private pure func semantic_choice_a_body() -> CoreExpr:
	choice_type: CoreType = UnionType("Choice")
	SemanticMatchExpr(
		variable(
			"choice",
			choice_type,
		),
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = "A",
					body = SemanticMatchLeaf([], int_literal(1))
				},
			],
			Some(SemanticMatchFail),
		),
		named_type("Int"),
		known_loc(),
	)


private pure func projected_choice_a_body() -> CoreExpr:
	choice_type: CoreType = UnionType("Choice")
	ConstructorMatchExpr(
		variable(
			"choice",
			choice_type,
		),
		NoReleasePolicy,
		[
			{
				constructor = "A",
				accessor = RootAccessor,
				test = UnionTagConstructorTest(VariantById(201), "Choice"),
				bindings = [],
				body = ConstructorMatchBodyExpr(int_literal(1))
			},
		],
		ConstructorMatchFallbackFail,
		named_type("Int"),
		known_loc(),
	)


private pure func program_json(program: CoreProgram) -> String:
	core_program_to_json(program).to_string()


private pure func test_projects_union_decl_at_beginning_middle_and_end() -> Bool:
	unrelated_before: CoreDecl = unrelated_global_decl("before", 1)
	unrelated_after: CoreDecl = unrelated_global_decl("after", 2)

	beginning: CoreProgram = program_with(
		semantic_choice_a_body(),
		[choice_decl(), unrelated_after],
	)
	expected_beginning: CoreProgram = program_with(
		projected_choice_a_body(),
		[choice_decl(), unrelated_after],
	)

	middle: CoreProgram = program_with(
		semantic_choice_a_body(),
		[unrelated_before, choice_decl(), unrelated_after],
	)
	expected_middle: CoreProgram = program_with(
		projected_choice_a_body(),
		[unrelated_before, choice_decl(), unrelated_after],
	)

	end: CoreProgram = program_with(
		semantic_choice_a_body(),
		[unrelated_before, choice_decl()],
	)
	expected_end: CoreProgram = program_with(
		projected_choice_a_body(),
		[unrelated_before, choice_decl()],
	)

	(
		projected_program_json(beginning) == program_json(expected_beginning)
		and projected_program_json(middle) == program_json(expected_middle)
		and projected_program_json(end) == program_json(expected_end)
	)


