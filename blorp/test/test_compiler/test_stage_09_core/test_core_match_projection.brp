private pure func chain_semantic_accessor(depth: Int) -> CoreSemanticMatchAccessor:
	var accessor: CoreSemanticMatchAccessor = RootSemanticMatchAccessor
	var index: Int = 0

	while index < depth:
		accessor = VariantFieldSemanticMatchAccessor(accessor, "Wrap", 0)
		index += 1

	accessor


private pure func chain_projected_accessor(depth: Int) -> CoreAccessor:
	var accessor: CoreAccessor = RootAccessor
	var index: Int = 0

	while index < depth:
		accessor = ErasedVariantFieldAccessor(accessor, "ChainChoice", "Wrap", 0)
		index += 1

	accessor


private pure func chain_semantic_body(depth: Int) -> CoreExpr:
	chain_type: CoreType = UnionType("ChainChoice")
	SemanticMatchExpr(
		variable(
			"chain",
			chain_type,
		),
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = "Wrap",
					body = SemanticMatchLeaf(
						[
							{
								variable = core_var("deep"),
								accessor = chain_semantic_accessor(depth),
								mode = MatchBorrowBindingMode
							},
						],
						int_literal(1),
					)
				},
			],
			Some(SemanticMatchFail),
		),
		named_type("Int"),
		known_loc(),
	)


private pure func chain_projected_body(depth: Int) -> CoreExpr:
	chain_type: CoreType = UnionType("ChainChoice")
	ConstructorMatchExpr(
		variable(
			"chain",
			chain_type,
		),
		NoReleasePolicy,
		[
			{
				constructor = "Wrap",
				accessor = RootAccessor,
				test = UnionTagConstructorTest(VariantById(701), "ChainChoice"),
				bindings = [
					{
						variable = core_var("deep"),
						typ = chain_type,
						accessor = chain_projected_accessor(depth),
						mode = MatchBorrowBindingMode,
						needs_release = type_requires_release(chain_type)
					},
				],
				body = ConstructorMatchBodyExpr(int_literal(1))
			},
		],
		ConstructorMatchFallbackFail,
		named_type("Int"),
		known_loc(),
	)


private pure func projected_chain_binding_accessor(depth: Int) -> Option[CoreAccessor]:
	match projected_body(program_with(chain_semantic_body(depth), [chain_choice_decl()])):
		Some(ConstructorMatchExpr(_, _, [match_case], _, _, _)):
			match match_case.bindings:
				[binding]:
					Some(binding.accessor)
				_:
					None
		_:
			None


private pure func erased_chain_accessor_depth(accessor: CoreAccessor) -> Int:
	var current: CoreAccessor = accessor
	var depth: Int = 0
	var valid: Bool = True

	while valid:
		match current:
			ErasedVariantFieldAccessor(parent, type_name, constructor, field_index):
				if (
					type_name == "ChainChoice"
					and constructor == "Wrap"
					and field_index == 0
				):
					depth += 1
					current = parent
				else:
					depth = -1
					valid = False
			RootAccessor:
				valid = False
			_:
				depth = -1
				valid = False

	depth


private pure func test_deep_variant_accessor_projection_matches_complete_core() -> Bool:
	source: CoreProgram = program_with(chain_semantic_body(4), [chain_choice_decl()])
	expected: CoreProgram = program_with(chain_projected_body(4), [chain_choice_decl()])

	projected_program_json(source) == program_json(expected)


private pure func test_deep_variant_accessor_projection_is_stack_bounded() -> Bool:
	match projected_chain_binding_accessor(256):
		Some(accessor):
			erased_chain_accessor_depth(accessor) == 256
		None:
			False


private pure func test_projection_is_idempotent() -> Bool:
	color_type: CoreType = EnumType("Color")
	body: CoreExpr = SemanticMatchExpr(
		variable(
			"color",
			color_type,
		),
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = "Red",
					body = SemanticMatchLeaf([], int_literal(1))
				},
			],
			Some(SemanticMatchFail),
		),
		named_type("Int"),
		known_loc(),
	)
	source: CoreProgram = program_with(body, [enum_decl()])
	once: CoreProgram = project_backend_matches(source)
	twice: CoreProgram = project_backend_matches(once)

	core_program_to_json(once).to_string() == core_program_to_json(twice).to_string()


-- A program exercising all three fused-walk passes on one path: a call
-- resolve_callables can promote to a `UserCall` (the match's own release
-- check then depends on that promotion having already happened, via
-- `contract_for_call`), an intrinsic call backend_projection rewrites into a
-- `ListRetainExpr`, and a `ConstructorMatchExpr` matching the user call's
-- result (exercising match's synthesized-temp release/materialize path,
-- which is where a wrong walk order or a wrong nesting depth would first
-- show up as a diff).
private pure func fused_dependency_program() -> CoreProgram:
	choice_type: CoreType = UnionType("Choice")
	user_call: CoreExpr = CallExpr(
		UnknownCall,
		VarExpr(
			core_var_with_def_id("helper", 900),
			named_type("HelperFn"),
			synthetic_core_source_loc(),
		),
		[],
		choice_type,
		synthetic_core_source_loc(),
	)
	list_type: CoreType = NamedType("List", [named_type("Ptr")])
	intrinsic_stmt: CoreExpr = CallExpr(
		IntrinsicCall("list_retain_for"),
		VoidExpr(
			VoidType,
			synthetic_core_source_loc(),
		),
		[variable("items", list_type), variable("value", named_type("Ptr"))],
		VoidType,
		synthetic_core_source_loc(),
	)
	match_on_call_result: CoreExpr = ConstructorMatchExpr(
		user_call,
		ArcReleasePolicy,
		[],
		ConstructorMatchFallbackFail,
		named_type("Int"),
		synthetic_core_source_loc(),
	)
	body: CoreExpr = SeqExpr(intrinsic_stmt, match_on_call_result)
	helper_decl: CoreDecl = FunctionDecl({
		name = "helper",
		source_module = None,
		type_params = [],
		params = [],
		return_type = choice_type,
		body = Some(int_literal(0)),
		is_pure = True,
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = UserFunction,
		def_id = 900,
		loc = known_loc(),
	})

	program_with(
		body,
		[choice_decl(), helper_decl],
	)


-- The dependency this module's `project_fused_late_core` relies on: running
-- resolve_callables, backend_projection, and match_projection as one fused
-- walk over `fused_dependency_program()` must produce the same Core as
-- running the three standalone passes in sequence (the `--dump-core-after`
-- path `late_core_passes_for_control` falls back to).
pure func test_fused_resolve_backend_match_matches_standalone_sequence() -> Bool:
	source: CoreProgram = fused_dependency_program()

	standalone: CoreProgram = project_backend_matches(
		project_backend_calls(resolve_callable_id_calls(source)),
	)

	callables: List[CoreCallableIdentity] = program_callables(source)
	backend: BackendProjectionContext = build_backend_projection_context(source)
	fused: CoreProgram = project_fused_late_core(source, callables, backend)

	core_program_to_json(standalone).to_string() == core_program_to_json(fused).to_string()


