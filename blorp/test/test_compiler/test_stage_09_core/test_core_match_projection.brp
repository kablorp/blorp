private pure func test_duplicate_union_names_retain_first_projection() -> Bool:
	source: CoreProgram = program_with(
		semantic_choice_a_body(),
		[choice_decl(), duplicate_choice_decl()],
	)
	expected: CoreProgram = program_with(
		projected_choice_a_body(),
		[choice_decl(), duplicate_choice_decl()],
	)
	result = project_backend_matches_indexed(source)
	program_json(result.program) == program_json(expected) and not result.workload_valid


private pure func test_duplicate_constructor_spelling_retains_first_projection() -> Bool:
	source: CoreProgram = program_with(
		semantic_choice_a_body(),
		[choice_decl_with_duplicate_constructor()],
	)
	expected: CoreProgram = program_with(
		projected_choice_a_body(),
		[choice_decl_with_duplicate_constructor()],
	)
	result = project_backend_matches_indexed(source)
	program_json(result.program) == program_json(expected) and not result.workload_valid


private pure func test_duplicate_constructor_def_id_retains_name_projection() -> Bool:
	choice_type: CoreType = UnionType("Choice")
	body: CoreExpr = SemanticMatchExpr(
		variable(
			"choice",
			choice_type,
		),
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = "B",
					body = SemanticMatchLeaf([], int_literal(2))
				},
			],
			Some(SemanticMatchFail),
		),
		named_type("Int"),
		known_loc(),
	)
	source: CoreProgram = program_with(body, [choice_decl_with_duplicate_constructor_def_id()])
	result = project_backend_matches_indexed(source)

	match result.program.decls:
		[UnionDecl(_), FunctionDecl(function_info)]:
			match function_info.body:
				Some(ConstructorMatchExpr(_, _, [match_case], _, _, _)):
					match match_case.test:
						-- Both variants carry id 201, so the projected test can only name
						-- that shared id; the name lookup still finds a variant.
						UnionTagConstructorTest(variant, "Choice"):
							variant_ref_is_id(variant, 201) and not result.workload_valid
						_:
							False
				_:
					False
		_:
			False


private pure func test_match_projection_index_hook_reports_layout_work() -> Bool:
	source: CoreProgram = program_with(
		semantic_choice_a_body(),
		[unrelated_global_decl("before", 1), choice_decl(), unrelated_global_decl("after", 2)],
	)
	result = project_backend_matches_indexed(source)
	expected: CoreProgram = program_with(
		projected_choice_a_body(),
		[unrelated_global_decl("before", 1), choice_decl(), unrelated_global_decl("after", 2)],
	)

	(
		result.declaration_index_entries == 1
		and result.variant_name_index_entries == 2
		and result.variant_id_index_entries == 2
		and result.workload_valid
		and program_json(result.program) == program_json(expected)
	)


private pure func test_projects_enum_constructor_match() -> Bool:
	color_type: CoreType = EnumType("Color")
	body: CoreExpr = SemanticMatchExpr(
		variable(
			"color",
			color_type,
		),
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = "Red",
					body = SemanticMatchLeaf([], int_literal(1))
				},
			],
			Some(SemanticMatchFail),
		),
		named_type("Int"),
		known_loc(),
	)

	match projected_body(program_with(body, [enum_decl()])):
		Some(ConstructorMatchExpr(_, NoReleasePolicy, cases, ConstructorMatchFallbackFail, _, _)):
			match cases:
				[first]:
					match first.test:
						EnumConstructorTest(variant):
							first.constructor == "Red" and variant_ref_is_id(variant, 101)
						_:
							False
				_:
					False
		_:
			False


private pure func test_projects_duplicate_constructor_names_by_declaring_type() -> Bool:
	choice_type: CoreType = UnionType("Choice")
	body: CoreExpr = SemanticMatchExpr(
		variable(
			"choice",
			choice_type,
		),
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = "A",
					body = SemanticMatchLeaf([], int_literal(1))
				},
			],
			Some(SemanticMatchFail),
		),
		named_type("Int"),
		known_loc(),
	)

	match (
		projected_body(
			program_with(
				body,
				[choice_decl(), ambiguous_choice_decl()],
			),
		)
	):
		Some(ConstructorMatchExpr(_, NoReleasePolicy, cases, ConstructorMatchFallbackFail, _, _)):
			match cases:
				[first]:
					match first.test:
						UnionTagConstructorTest(variant, type_name):
							(
								first.constructor == "A"
								and variant_ref_is_id(variant, 201)
								and type_name == "Choice"
							)
						_:
							False
				_:
					False
		_:
			False


private pure func test_projects_stack_option_binding() -> Bool:
	option_type: CoreType = NamedType("Option", [named_type("Int")])
	value_accessor = VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Some", 0)
	body: CoreExpr = SemanticMatchExpr(
		variable(
			"value",
			option_type,
		),
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = "Some",
					body = SemanticMatchLeaf(
						[
							{
								variable = core_var("payload"),
								accessor = value_accessor,
								mode = MatchBorrowBindingMode
							},
						],
						int_literal(1),
					)
				},
			],
			None,
		),
		named_type("Int"),
		known_loc(),
	)

	match projected_body(program_with(body, [])):
		Some(ConstructorMatchExpr(_, _, cases, _, _, _)):
			match cases:
				[first]:
					test_is_stack_option: Bool = match first.test:
						StackOptionSomeConstructorTest(c_type):
							c_type == "blorp_StackOption_Int"
						_:
							False

					match first.bindings:
						[binding]:
							accessor_is_stack_payload: Bool = match binding.accessor:
								StackOptionPayloadAccessor(RootAccessor):
									True
								_:
									False

							test_is_stack_option and accessor_is_stack_payload
						_:
							False
				_:
					False
		_:
			False


private pure func projected_option_envelope_binding(
	payload_type: CoreType,
	storage: CoreUnionPayloadStorage,
) -> Option[CoreMatchBinding]:
	option_type: CoreType = NamedType("Option", [payload_type])
	option_accessor = VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Wrapped", 0)
	payload_accessor = VariantFieldSemanticMatchAccessor(option_accessor, "Some", 0)
	envelope_decl ?= match generic_envelope_decl():
		UnionDecl(union_decl):
			Some(UnionDecl({ union_decl | payload_storage = storage }))
		_:
			None
	body: CoreExpr = SemanticMatchExpr(
		variable("envelope", NamedType("Envelope", [option_type])),
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = "Wrapped",
					body = SemanticConstructorMatch(
						option_accessor,
						[
							{
								constructor = "Some",
								body = SemanticMatchLeaf(
									[
										{
											variable = core_var("payload"),
											accessor = payload_accessor,
											mode = MatchBorrowBindingMode
										},
									],
									int_literal(1),
								)
							},
						],
						None,
					)
				},
			],
			None,
		),
		named_type("Int"),
		known_loc(),
	)
	projected ?= projected_body(program_with(body, [envelope_decl, enum_decl()]))

	match projected:
		ConstructorMatchExpr(_, _, [outer_case], _, _, _):
			match outer_case.body:
				ConstructorMatchBodyExpr(ConstructorMatchExpr(_, _, [some_case], _, _, _)):
					some_case.bindings.get(0)
				_:
					None
		_:
			None


private pure func test_projects_erased_union_stack_option_binding() -> Bool:
	int_payload: Bool = match projected_option_envelope_binding(named_type("Int"), ErasedUnionPayloadStorage):
		Some(binding):
			match binding.accessor:
				BoxedStackOptionPayloadAccessor(
					ErasedVariantFieldAccessor(RootAccessor, "Envelope", "Wrapped", 0),
					"blorp_StackOption_Int",
				):
					True
				_:
					False
		None:
			False
	enum_payload: Bool = match projected_option_envelope_binding(EnumType("Color"), ErasedUnionPayloadStorage):
		Some(binding):
			match binding.accessor:
				BoxedStackOptionPayloadAccessor(
					ErasedVariantFieldAccessor(RootAccessor, "Envelope", "Wrapped", 0),
					"blorp_StackOption_Color",
				):
					True
				_:
					False
		None:
			False

	int_payload and enum_payload


private pure func test_projects_typed_union_stack_option_binding_inline() -> Bool:
	match projected_option_envelope_binding(named_type("Int"), TypedUnionPayloadStorage):
		Some(binding):
			match binding.accessor:
				StackOptionPayloadAccessor(VariantFieldAccessor(RootAccessor, "Envelope", "Wrapped", 0)):
					True
				_:
					False
		None:
			False


private pure func test_projects_nested_literal_match() -> Bool:
	option_type: CoreType = NamedType("Option", [named_type("Int")])
	payload_accessor = VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Some", 0)
	body: CoreExpr = SemanticMatchExpr(
		variable(
			"value",
			option_type,
		),
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = "Some",
					body = SemanticLiteralMatch(
						payload_accessor,
						[
							{
								literal = IntLiteral(7),
								body = SemanticMatchLeaf([], int_literal(7))
							},
						],
						SemanticMatchFail,
					)
				},
			],
			None,
		),
		named_type("Int"),
		known_loc(),
	)

	match projected_body(program_with(body, [])):
		Some(ConstructorMatchExpr(_, _, cases, _, _, _)):
			match cases:
				[first]:
					match first.body:
						ConstructorMatchBodyLiteral(match_info):
							match_info.cases.length() == 1 and match match_info.accessor:
								StackOptionPayloadAccessor(RootAccessor):
									True
								_:
									False
						_:
							False
				_:
					False
		_:
			False


private pure func generic_option_some_match(
	option_type: CoreType,
	payload_type: CoreType,
) -> CoreExpr:
	ConstructorMatchExpr(
		variable(
			"value",
			option_type,
		),
		NoReleasePolicy,
		[
			{
				constructor = "Some",
				accessor = RootAccessor,
				test = UnionTagConstructorTest(BuiltinOptionSome, "Option"),
				bindings = [
					{
						variable = core_var("payload"),
						typ = payload_type,
						accessor = VariantFieldAccessor(RootAccessor, "Option", "Some", 0),
						mode = MatchBorrowBindingMode,
						needs_release = type_requires_release(payload_type)
					},
				],
				body = ConstructorMatchBodyExpr(int_literal(1))
			},
		],
		ConstructorMatchFallbackFail,
		named_type("Int"),
		known_loc(),
	)


private pure func test_reprojects_typed_nullable_option_match() -> Bool:
	payload_type: CoreType = UnionType("Choice")
	option_type: CoreType = NamedType("Option", [payload_type])

	match projected_body(
		program_with(
			generic_option_some_match(option_type, payload_type),
			[choice_decl()],
		),
	):
		Some(ConstructorMatchExpr(_, _, [match_case], _, _, _)):
			test_is_nullable: Bool = match match_case.test:
				NullableOptionSomeConstructorTest:
					True
				_:
					False

			accessor_is_nullable: Bool = match match_case.bindings:
				[binding]:
					match binding.accessor:
						NullableOptionPayloadAccessor(RootAccessor):
							True
						_:
							False
				_:
					False

			test_is_nullable and accessor_is_nullable
		_:
			False


