private pure func test_nested_synthetic_matches_have_distinct_owner_identities() -> Bool:
	choice_type: CoreType = UnionType("Choice")
	inner: CoreExpr = ConstructorMatchExpr(
		CallExpr(
			BuiltinCall("make_inner_choice"),
			VoidExpr(VoidType, synthetic_core_source_loc()),
			[],
			choice_type,
			synthetic_core_source_loc(),
		),
		ArcReleasePolicy,
		[],
		ConstructorMatchFallbackFail,
		named_type("Int"),
		synthetic_core_source_loc(),
	)
	body: CoreExpr = ConstructorMatchExpr(
		CallExpr(
			BuiltinCall("make_outer_choice"),
			VoidExpr(VoidType, synthetic_core_source_loc()),
			[],
			choice_type,
			synthetic_core_source_loc(),
		),
		ArcReleasePolicy,
		[
			{
				constructor = "A",
				accessor = RootAccessor,
				test = UnionTagConstructorTest(VariantById(201), "Choice"),
				bindings = [],
				body = ConstructorMatchBodyExpr(inner)
			},
		],
		ConstructorMatchFallbackFail,
		named_type("Int"),
		synthetic_core_source_loc(),
	)

	match projected_body(program_with(body, [choice_decl()])):
		Some(LetExpr(outer_owner, False, _, _, ConstructorMatchExpr(_, _, [outer_case], _, _, _))):
			match outer_case.body:
				ConstructorMatchBodyExpr(LetExpr(inner_owner, False, _, _, ConstructorMatchExpr(_, _, _, _, _, _))):
					-- The owners carry no id (their depth-qualified names are the identity), so
					-- distinct names are what keeps the two scrutinee temporaries apart.
					outer_owner.name != inner_owner.name
				_:
					False
		_:
			False


