private pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


private pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = None,
		origin = AuthoredBinder
	}


private pure func core_var_with_def_id(name: String, def_id: Int) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = Some(def_id),
		origin = AuthoredBinder
	}


private pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, synthetic_core_source_loc())


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), named_type("Int"), synthetic_core_source_loc())


pure func variant_ref_is_id(variant: CoreVariantRef, expected: Int) -> Bool:
	match variant:
		VariantById(def_id):
			def_id == expected
		_:
			False


private pure func known_loc() -> CoreSourceLoc:
	pack_core_source_loc(0, 7, 3, 9, 12)


private pure func function_decl(body: CoreExpr) -> CoreDecl:
	FunctionDecl({
		name = "classify",
		source_module = None,
		type_params = [],
		params = [],
		return_type = named_type("Int"),
		body = Some(body),
		is_pure = True,
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = UserFunction,
		def_id = 41,
		loc = known_loc(),
	})


private pure func program_with(body: CoreExpr, declarations: List[CoreDecl]) -> CoreProgram:
	{
		decls = declarations.append(function_decl(body)),
		foreign_includes = [],
		source_files = []
	}


private pure func projected_body(program: CoreProgram) -> Option[CoreExpr]:
	var result: Option[CoreExpr] = None

	for decl in project_backend_matches(program).decls:
		match decl:
			FunctionDecl(function_info):
				result = function_info.body
				break
			_:
				void

	result


private pure func projected_program_json(program: CoreProgram) -> String:
	core_program_to_json(project_backend_matches(program)).to_string()


