import:
	../../../src/compiler/stage_09_core/c_type_layout: type_requires_release
	../../../src/compiler/stage_09_core/function_origin_fixture: FIXTURE_NO_SOURCE_MODULE, FIXTURE_SOURCE_FUNCTION_ORIGIN
	../../../src/compiler/stage_09_core/ir:
		CoreUnionValueStorage(ScalarTagValue, ManagedUnionValue),
		CoreAccessor(RootAccessor),
		CoreBinaryOp(GreaterEqualOp, LessOp, NotEqualOp),
		CoreCallKind(BuiltinCall, DirectRuntimeCall, IntrinsicCall, UserCall),
		CoreConstructorMatchBody(ConstructorMatchBodyExpr),
		CoreConstructorMatchFallback(ConstructorMatchFallbackBody),
		CoreConstructorMatchTest(BoxedResultOkConstructorTest, StackResultOkConstructorTest),
		CoreDecl(FunctionDecl),
		CoreExpr(
			BinaryExpr,
			BoxExpr,
			CallExpr,
			CastExpr,
			ConstructorMatchExpr,
			IfExpr,
			LiteralExpr,
			LogicalExpr,
			SemanticMatchExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunctionKind(UserFunction),
		CoreLiteral(BoolLiteral, FloatLiteral, IntLiteral, StringLiteral),
		CoreLogicalOp(AndOp),
		CoreMatchBindingMode(MatchBorrowBindingMode),
		CoreProgram,
		CoreReleasePolicy(NoReleasePolicy),
		CoreSemanticMatchAccessor(RootSemanticMatchAccessor, VariantFieldSemanticMatchAccessor),
		CoreSemanticMatchTree(SemanticConstructorMatch, SemanticMatchLeaf),
		CoreSourceLoc,
		synthetic_core_source_loc,
		CoreTensorDim(TensorStaticDim),
		CoreTensorTypeInfo,
		CoreType(
			BoxedResultType,
			HeapRecordType,
			InlineRecordType,
			NamedType,
			RangeType,
			StackResultType,
			TensorType,
			TupleType,
			VoidType,
			UnionType,
		),
		CoreBinderOrigin(AuthoredBinder),
		CoreVar,
		core_expr_to_json,
		core_field_ref,
		core_program_to_json,
	../../../src/compiler/stage_09_core/specialize: specialize_program, specialize_program_fused
	../../../src/compiler/stage_09_core/tensor_specialize as CoreTensorSpecialize
	test: TestSuite


pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = None,
		origin = AuthoredBinder
	}


pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, synthetic_core_source_loc())


pure func builtin_call(name: String, arg: CoreExpr, typ: CoreType) -> CoreExpr:
	builtin_call_args(name, [arg], typ)


pure func builtin_call_args(name: String, args: List[CoreExpr], typ: CoreType) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		VoidExpr(VoidType, synthetic_core_source_loc()),
		args,
		typ,
		synthetic_core_source_loc(),
	)


pure func intrinsic_call(name: String, arg: CoreExpr, typ: CoreType) -> CoreExpr:
	CallExpr(
		IntrinsicCall(name),
		VoidExpr(VoidType, synthetic_core_source_loc()),
		[arg],
		typ,
		synthetic_core_source_loc(),
	)


pure func program_with_body(body: CoreExpr) -> CoreProgram:
	{
		decls = [FunctionDecl({
				name = "main",
				source_module = None,
				type_params = [],
				params = [],
				return_type = named_type("Int"),
				body = Some(body),
				is_pure = True,
				origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
				module = FIXTURE_NO_SOURCE_MODULE,
				function_kind = UserFunction,
				def_id = 1,
				loc = synthetic_core_source_loc(),
			})],
		foreign_includes = [],
		source_files = []
	}


pure func specialized_body(body: CoreExpr) -> Option[CoreExpr]:
	match specialize_program(program_with_body(body)).decls:
		[FunctionDecl(function_info)]:
			function_info.body
		_:
			None


pure func test_to_int_identity_and_casts() -> Bool:
	int_value: CoreExpr = variable("int_value", named_type("Int"))
	float_value: CoreExpr = variable("float_value", named_type("Float"))
	range_value: CoreExpr = variable("range_value", RangeType)

	match (
		specialized_body(builtin_call("blorp_to_int", int_value, named_type("Int"))),
		specialized_body(builtin_call("blorp_to_int", float_value, named_type("Int"))),
		specialized_body(builtin_call("blorp_to_int", range_value, named_type("Int"))),
	):
		(Some(VarExpr(int_var, NamedType("Int", []), _)), Some(CastExpr(VarExpr(float_var, _, _), NamedType("Int", []), _)), Some(CastExpr(VarExpr(range_var, _, _), NamedType("Int", []), _))):
			(
				int_var.name == "int_value"
				and float_var.name == "float_value"
				and range_var.name == "range_value"
			)
		_:
			False


pure func test_float_width_conversions() -> Bool:
	value: CoreExpr = variable("value", named_type("Int"))

	match (
		specialized_body(builtin_call("blorp_to_float", value, named_type("Float"))),
		specialized_body(builtin_call("blorp_to_float32", value, NamedType("Float32", []))),
		specialized_body(builtin_call("blorp_to_float16", value, NamedType("Float16", []))),
	):
		(Some(CastExpr(_, NamedType("Float", []), _)), Some(CastExpr(_, NamedType("Float32", []), _)), Some(CastExpr(_, NamedType("Float16", []), _))):
			True
		_:
			False


pure func test_bool_conversions() -> Bool:
	value: CoreExpr = variable("value", NamedType("Bool", []))

	match (
		specialized_body(builtin_call("blorp_to_int", value, named_type("Int"))),
		specialized_body(builtin_call("blorp_to_float", value, named_type("Float"))),
		specialized_body(builtin_call("blorp_to_bool", value, named_type("Bool"))),
	):
		(Some(CastExpr(VarExpr(_, NamedType("Bool", []), _), NamedType("Int", []), _)), Some(CastExpr(CastExpr(VarExpr(_, NamedType("Bool", []), _), NamedType("Int", []), _), NamedType("Float", []), _)), Some(VarExpr(_, NamedType("Bool", []), _))):
			True
		_:
			False


pure func test_to_bool_int_compares_against_zero() -> Bool:
	int_value: CoreExpr = variable("value", named_type("Int"))

	match specialized_body(builtin_call("blorp_to_bool", int_value, named_type("Bool"))):
		Some(BinaryExpr(NotEqualOp, _, LiteralExpr(IntLiteral(0), _, _), NamedType("Bool", []), _)):
			True
		_:
			False


pure func test_to_bool_float_uses_nonzero_comparison() -> Bool:
	float_value: CoreExpr = variable("value", named_type("Float"))

	match specialized_body(builtin_call("blorp_to_bool", float_value, named_type("Bool"))):
		Some(BinaryExpr(NotEqualOp, _, LiteralExpr(FloatLiteral(0.0), NamedType("Float", []), _), NamedType("Bool", []), _)):
			True
		_:
			False


private pure func expected_result_truthiness(
	arg: CoreExpr,
	test: CoreConstructorMatchTest,
) -> CoreExpr:
	bool_type = named_type("Bool")
	ConstructorMatchExpr(
		arg,
		NoReleasePolicy,
		[
			{
				constructor = "Ok",
				accessor = RootAccessor,
				test = test,
				bindings = [],
				body = ConstructorMatchBodyExpr(
					LiteralExpr(
						BoolLiteral(True),
						bool_type,
						synthetic_core_source_loc(),
					),
				)
			},
		],
		ConstructorMatchFallbackBody(
			LiteralExpr(
				BoolLiteral(False),
				bool_type,
				synthetic_core_source_loc(),
			),
		),
		bool_type,
		synthetic_core_source_loc(),
	)


private pure func specialized_matches(actual: Option[CoreExpr], expected: CoreExpr) -> Bool:
	match actual:
		Some(expr):
			core_expr_to_json(expr).to_string() == core_expr_to_json(expected).to_string()
		None:
			False


pure func test_to_bool_result_layouts() -> Bool:
	stack_result: CoreExpr = variable(
		"stack_result",
		StackResultType(VoidType, named_type("String")),
	)
	boxed_result: CoreExpr = variable(
		"boxed_result",
		BoxedResultType(named_type("String"), named_type("String")),
	)

	stack_specialized = specialized_body(
		builtin_call(
			"blorp_to_bool",
			stack_result,
			named_type("Bool"),
		),
	)
	boxed_specialized = specialized_body(
		builtin_call(
			"blorp_to_bool",
			boxed_result,
			named_type("Bool"),
		),
	)

	specialized_matches(
		stack_specialized,
		expected_result_truthiness(stack_result, StackResultOkConstructorTest("blorp_StackResult")),
	) and specialized_matches(
		boxed_specialized,
		expected_result_truthiness(boxed_result, BoxedResultOkConstructorTest),
	)


pure func test_specialization_recurses_through_nested_calls() -> Bool:
	inner: CoreExpr = builtin_call(
		"blorp_to_float",
		variable("value", named_type("Int")),
		named_type("Float"),
	)
	outer: CoreExpr = builtin_call("blorp_to_int", inner, named_type("Int"))

	match specialized_body(outer):
		Some(CastExpr(CastExpr(_, NamedType("Float", []), _), NamedType("Int", []), _)):
			True
		_:
			False


pure func test_specialization_recurses_through_semantic_match_leaf() -> Bool:
	body: CoreExpr = SemanticMatchExpr(
		LiteralExpr(BoolLiteral(True), named_type("Bool"), synthetic_core_source_loc()),
		SemanticMatchLeaf(
			[],
			builtin_call(
				"blorp_to_int",
				variable("value", named_type("Float")),
				named_type("Int"),
			),
		),
		named_type("Int"),
		synthetic_core_source_loc(),
	)

	match specialized_body(body):
		Some(SemanticMatchExpr(_, SemanticMatchLeaf(_, CastExpr(_, NamedType("Int", []), _)), _, _)):
			True
		_:
			False


private pure func tensor_get_or_match(return_type: CoreType, default: CoreExpr) -> CoreExpr:
	tensor_get_or_match_for_getter(
		BuiltinCall("blorp_vector_get_opt"),
		NamedType("Option", [return_type]),
		return_type,
		default,
	)


private pure func tensor_get_or_match_for_getter(
	get_kind: CoreCallKind,
	option_type: CoreType,
	return_type: CoreType,
	default: CoreExpr,
) -> CoreExpr:
	payload: CoreVar = core_var("payload")
	array_type: CoreType = TensorType({
		element_type = return_type,
		dims = [TensorStaticDim(4)],
	})

	SemanticMatchExpr(
		CallExpr(
			get_kind,
			VoidExpr(VoidType, synthetic_core_source_loc()),
			[variable("values", array_type), variable("index", named_type("Int"))],
			option_type,
			synthetic_core_source_loc(),
		),
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = "Some",
					body = SemanticMatchLeaf(
						[
							{
								variable = payload,
								accessor = VariantFieldSemanticMatchAccessor(
									RootSemanticMatchAccessor,
									"Some",
									0,
								),
								mode = MatchBorrowBindingMode
							},
						],
						VarExpr(
							payload,
							return_type,
							synthetic_core_source_loc(),
						),
					)
				},
				{
					constructor = "None",
					body = SemanticMatchLeaf([], default)
				},
			],
			None,
		),
		return_type,
		synthetic_core_source_loc(),
	)


pure func test_scalar_tensor_get_or_uses_bounded_direct_storage_read() -> Bool:
	int_default: CoreExpr = LiteralExpr(IntLiteral(9), named_type("Int"), synthetic_core_source_loc())
	body: CoreExpr = tensor_get_or_match(named_type("Int"), int_default)

	match body:
		SemanticMatchExpr(CallExpr(_, _, [values, index], _, _), _, _, _):
			expected: CoreExpr = IfExpr(
				LogicalExpr(
					AndOp,
					BinaryExpr(
						GreaterEqualOp,
						index,
						LiteralExpr(IntLiteral(0), named_type("Int"), synthetic_core_source_loc()),
						named_type("Bool"),
						synthetic_core_source_loc(),
					),
					BinaryExpr(
						LessOp,
						index,
						intrinsic_call("tensor_len", values, named_type("Int")),
						named_type("Bool"),
						synthetic_core_source_loc(),
					),
					named_type("Bool"),
					synthetic_core_source_loc(),
				),
				CallExpr(
					IntrinsicCall("tensor_get_i64"),
					VoidExpr(VoidType, synthetic_core_source_loc()),
					[values, index],
					named_type("Int"),
					synthetic_core_source_loc(),
				),
				int_default,
				named_type("Int"),
				synthetic_core_source_loc(),
			)

			match specialized_body(body):
				Some(specialized):
					core_expr_to_json(specialized).to_string() == core_expr_to_json(expected).to_string()
				None:
					False
		_:
			False


private pure func get_or_body_is_preserved(get_kind: CoreCallKind, payload: CoreType) -> Bool:
	body: CoreExpr = tensor_get_or_match_for_getter(
		get_kind,
		NamedType("Option", [payload]),
		payload,
		variable("default", payload),
	)

	match specialized_body(body):
		Some(actual):
			core_expr_to_json(actual).to_string() == core_expr_to_json(body).to_string()
		None:
			False


pure func test_tensor_get_or_preserves_unsupported_getter_suffixes() -> Bool:
	(
		get_or_body_is_preserved(BuiltinCall("blorp_vector_get_opt_int_extra"), named_type("Int"))
		and get_or_body_is_preserved(BuiltinCall("blorp_vector_get_opt_unknown"), named_type("Int"))
	)


pure func test_tensor_get_or_preserves_incompatible_getter_payloads() -> Bool:
	(
		get_or_body_is_preserved(BuiltinCall("blorp_vector_get_opt_f32"), named_type("Int"))
		and get_or_body_is_preserved(BuiltinCall("blorp_vector_get_opt_int"), named_type("Float32"))
		and get_or_body_is_preserved(BuiltinCall("blorp_vector_get_opt_int"), RangeType)
		and get_or_body_is_preserved(BuiltinCall("blorp_vector_get_opt_int"), UnionType("Color", ScalarTagValue))
	)


pure func test_tensor_get_or_preserves_nullable_and_nonbuiltin_calls() -> Bool:
	(
		get_or_body_is_preserved(BuiltinCall("blorp_vector_get_nullable"), HeapRecordType("Point"))
		and get_or_body_is_preserved(BuiltinCall("blorp_vector_get_opt_int"), HeapRecordType("Point"))
		and get_or_body_is_preserved(UserCall("blorp_vector_get_opt_int", Some(42), []), named_type("Int"))
	)


pure func test_tensor_get_or_rewrites_supported_scalar_getters() -> Bool:
	var rewrites: Bool = True

	for (getter, payload, read_name) in [
		("blorp_vector_get_opt_int", named_type("Int"), "tensor_get_i64"),
		("blorp_vector_get_opt_int8", named_type("Int8"), "tensor_get_i64"),
		("blorp_vector_get_opt_int16", named_type("Int16"), "tensor_get_i64"),
		("blorp_vector_get_opt_int32", named_type("Int32"), "tensor_get_i64"),
		("blorp_vector_get_opt_int64", named_type("Int64"), "tensor_get_i64"),
		("blorp_vector_get_opt_uint8", named_type("UInt8"), "tensor_get_i64"),
		("blorp_vector_get_opt_uint16", named_type("UInt16"), "tensor_get_i64"),
		("blorp_vector_get_opt_uint32", named_type("UInt32"), "tensor_get_i64"),
		("blorp_vector_get_opt_uint64", named_type("UInt64"), "tensor_get_i64"),
		("blorp_vector_get_opt_float", named_type("Float"), "tensor_get_f64"),
		("blorp_vector_get_opt_f32", named_type("Float32"), "tensor_get_f32"),
		("blorp_vector_get_opt_f16", named_type("Float16"), "tensor_get_f16"),
		("blorp_vector_get_opt_bool", named_type("Bool"), "tensor_get_i64"),
		("blorp_vector_get_opt_char", named_type("Char"), "tensor_get_i64"),
	]:
		body: CoreExpr = tensor_get_or_match_for_getter(
			BuiltinCall(getter), NamedType("Option", [payload]), payload, variable("default", payload),
		)

		match specialized_body(body):
			Some(IfExpr(LogicalExpr(AndOp, _, _, _, _), CallExpr(IntrinsicCall(actual), _, _, _, _), _, _, _)):
				rewrites = rewrites and actual == read_name
			_:
				rewrites = False

	rewrites


pure func test_tensor_get_or_preserves_generic_enum_and_inline_record_fallbacks() -> Bool:
	var rewrites: Bool = True

	for (payload, read_name) in [(UnionType("Color", ScalarTagValue), "tensor_get_i64"), (InlineRecordType("Point"), "tensor_get_unchecked")]:
		body: CoreExpr = tensor_get_or_match(payload, variable("default", payload))

		match specialized_body(body):
			Some(IfExpr(LogicalExpr(AndOp, _, _, _, _), CallExpr(IntrinsicCall(actual), _, _, _, _), _, _, _)):
				rewrites = rewrites and actual == read_name
			_:
				rewrites = False

	rewrites


pure func test_managed_tensor_get_or_preserves_nullable_payload_match() -> Bool:
	point_type: CoreType = HeapRecordType("Point")
	point_default: CoreExpr = variable("default_point", point_type)
	body: CoreExpr = tensor_get_or_match(point_type, point_default)

	match body:
		SemanticMatchExpr(CallExpr(_, callee, args, option_type, call_loc), tree, result_type, loc):
			-- Managed payloads preserve the authored Some borrow and None
			-- default; the nullable lookup replaces only the scrutinee call.
			expected: CoreExpr = SemanticMatchExpr(
				CallExpr(BuiltinCall("blorp_vector_get_nullable"), callee, args, option_type, call_loc),
				tree,
				result_type,
				loc,
			)

			match specialized_body(body):
				Some(specialized):
					core_expr_to_json(specialized).to_string() == core_expr_to_json(expected).to_string()
				None:
					False
		_:
			False


pure func test_program_specialization_boxes_dict_int_key() -> Bool:
	dict_type: CoreType = NamedType(
		"Dict",
		[named_type("Int"), NamedType("List", [HeapRecordType("CoreFunction")])],
	)
	result_type: CoreType = NamedType(
		"Option",
		[NamedType("List", [HeapRecordType("CoreFunction")])],
	)

	match (
		specialized_body(
			builtin_call_args(
				"blorp_dict_get",
				[variable("functions", dict_type), variable("def_id", named_type("Int"))],
				result_type,
			),
		)
	):
		Some(CallExpr(BuiltinCall("blorp_dict_get_nullable"), _, [_, BoxExpr(_, _, _)], _, _)):
			True
		_:
			False


pure func test_string_to_int_becomes_direct_runtime_call() -> Bool:
	text: CoreExpr = variable(
		"text",
		NamedType("String", []),
	)

	match specialized_body(builtin_call("blorp_to_int", text, named_type("Int"))):
		Some(specialized):
			match specialized:
				CallExpr(kind, _, args, _, _):
					match kind:
						DirectRuntimeCall(call):
							call.name == "blorp_to_int" and args.length() == 1
						_:
							False
				_:
					False
		_:
			False


pure func test_int_hash_becomes_direct_runtime_call() -> Bool:
	hash_specializes_to_runtime(named_type("Int"), "blorp_hash_int")


pure func hash_specializes_to_runtime(arg_type: CoreType, expected_runtime: String) -> Bool:
	match specialized_body(
		builtin_call(
			"blorp_hash",
			variable("value", arg_type),
			named_type("Int"),
		),
	):
		Some(specialized):
			match specialized:
				CallExpr(kind, _, args, _, _):
					match kind:
						DirectRuntimeCall(call):
							call.name == expected_runtime and args.length() == 1
						_:
							False
				_:
					False
		_:
			False


pure func test_hash_dispatches_other_primitive_types() -> Bool:
	(
		hash_specializes_to_runtime(named_type("String"), "blorp_hash_string")
		and hash_specializes_to_runtime(named_type("Bool"), "blorp_hash_int")
		and hash_specializes_to_runtime(named_type("Char"), "blorp_hash_int")
		and hash_specializes_to_runtime(named_type("UInt128"), "blorp_hash_int")
		and hash_specializes_to_runtime(named_type("Float"), "blorp_hash_float")
		and hash_specializes_to_runtime(named_type("Float32"), "blorp_hash_float")
		and hash_specializes_to_runtime(named_type("Float16"), "blorp_hash_float")
		and hash_specializes_to_runtime(RangeType, "blorp_hash_int")
	)


pure func test_type_name_intrinsic_renders_post_mono_core_types() -> Bool:
	tensor_type: CoreType = TensorType({
		element_type = named_type("Float"),
		dims = [TensorStaticDim(2), TensorStaticDim(3)],
	})
	tuple_type: CoreType = TupleType([named_type("Int"), named_type("String")])

	match (
		specialized_body(
			intrinsic_call(
				"type_name",
				variable("tensor", tensor_type),
				named_type("String"),
			),
		),
		specialized_body(
			intrinsic_call(
				"type_name",
				variable("tuple", tuple_type),
				named_type("String"),
			),
		),
	):
		(Some(LiteralExpr(StringLiteral(tensor_name), _, _)), Some(LiteralExpr(StringLiteral(tuple_name), _, _))):
			tensor_name == "Float[#2, #3]" and tuple_name == "(Int, String)"
		_:
			False


pure func is_heap_specializes_to(typ: CoreType, expected: Bool) -> Bool:
	match specialized_body(intrinsic_call("is_heap", variable("value", typ), named_type("Bool"))):
		Some(LiteralExpr(BoolLiteral(actual), _, _)):
			actual == expected
		_:
			False


pure func test_is_heap_intrinsic_uses_core_ownership_layout() -> Bool:
	(
		is_heap_specializes_to(named_type("Int"), False)
		and is_heap_specializes_to(named_type("String"), True)
		and is_heap_specializes_to(HeapRecordType("Point"), True)
		and is_heap_specializes_to(HeapRecordType("Node"), True)
		and is_heap_specializes_to(
			StackResultType(named_type("String"), named_type("Int")),
			True,
		)
		and is_heap_specializes_to(
			StackResultType(named_type("Int"), named_type("Bool")),
			False,
		)
	)


pure func test_hash_preserves_unsupported_type_dispatch() -> Bool:
	match specialized_body(
		builtin_call(
			"blorp_hash",
			variable("value", VoidType),
			named_type("Int"),
		),
	):
		Some(specialized):
			match specialized:
				CallExpr(kind, _, args, _, _):
					match kind:
						BuiltinCall(name):
							name == "blorp_hash" and args.length() == 1
						_:
							False
				_:
					False
		_:
			False


-- A program exercising both fused-walk passes on the same node: a tensor
-- length call inside a `SemanticMatchExpr` leaf. tensor_specialize turns the
-- call into `IntrinsicCall("tensor_len")` from inside
-- `specialize_semantic_match_tree`'s own (non-generic) recursion into the
-- match tree, which is where a fusion that only threaded the flag through
-- `specialize_expr`'s generic default arm -- and missed the semantic-match
-- helpers -- would first show up as a diff.
private pure func fused_dependency_program() -> CoreProgram:
	tensor_type: CoreType = TensorType({
		element_type = named_type("Int"),
		dims = [TensorStaticDim(4)],
	})
	tensor_len_call: CoreExpr = builtin_call(
		"blorp_vector_len",
		variable("values", tensor_type),
		named_type("Int"),
	)
	body: CoreExpr = SemanticMatchExpr(
		LiteralExpr(BoolLiteral(True), named_type("Bool"), synthetic_core_source_loc()),
		SemanticMatchLeaf([], tensor_len_call),
		named_type("Int"),
		synthetic_core_source_loc(),
	)

	program_with_body(body)


-- The dependency `specialize_program_fused` relies on: running
-- tensor_specialize then specialize as one fused walk over
-- `fused_dependency_program()` must produce the same Core as running the two
-- standalone passes in sequence (the `--dump-core-after` path
-- `late_core_passes_for_control` falls back to).
pure func test_fused_tensor_specialize_and_specialize_matches_standalone_sequence() -> Bool:
	source: CoreProgram = fused_dependency_program()

	standalone: CoreProgram = specialize_program(CoreTensorSpecialize.specialize_program(source))
	fused: CoreProgram = specialize_program_fused(source)

	core_program_to_json(standalone).to_string() == core_program_to_json(fused).to_string()


tests: TestSuite = {
	description = "Blorp compiler Core primitive specialization",
	tests = [
		("to_int identity and casts", test_to_int_identity_and_casts),
		("float width conversions", test_float_width_conversions),
		("Bool conversions", test_bool_conversions),
		("to_bool Int compares against zero", test_to_bool_int_compares_against_zero),
		("to_bool Float uses nonzero comparison", test_to_bool_float_uses_nonzero_comparison),
		("to_bool Result layouts", test_to_bool_result_layouts),
		(
			"specialization recurses through nested calls",
			test_specialization_recurses_through_nested_calls,
		),
		(
			"specialization recurses through semantic match leaf",
			test_specialization_recurses_through_semantic_match_leaf,
		),
		(
			"scalar tensor get_or uses bounded direct storage read",
			test_scalar_tensor_get_or_uses_bounded_direct_storage_read,
		),
		(
			"managed tensor get_or preserves nullable payload match",
			test_managed_tensor_get_or_preserves_nullable_payload_match,
		),
		("tensor get_or preserves unsupported getter suffixes", test_tensor_get_or_preserves_unsupported_getter_suffixes),
		("tensor get_or preserves incompatible getter payloads", test_tensor_get_or_preserves_incompatible_getter_payloads),
		("tensor get_or preserves nullable and nonbuiltin calls", test_tensor_get_or_preserves_nullable_and_nonbuiltin_calls),
		("tensor get_or rewrites supported scalar getters", test_tensor_get_or_rewrites_supported_scalar_getters),
		("tensor get_or preserves generic enum and inline-record fallbacks", test_tensor_get_or_preserves_generic_enum_and_inline_record_fallbacks),
		(
			"program specialization boxes Dict[Int] keys",
			test_program_specialization_boxes_dict_int_key,
		),
		(
			"String to_int becomes direct runtime call",
			test_string_to_int_becomes_direct_runtime_call,
		),
		("Int hash becomes direct runtime call", test_int_hash_becomes_direct_runtime_call),
		("hash dispatches other primitive types", test_hash_dispatches_other_primitive_types),
		(
			"type_name renders post-mono Core types",
			test_type_name_intrinsic_renders_post_mono_core_types,
		),
		("is_heap uses Core ownership layout", test_is_heap_intrinsic_uses_core_ownership_layout),
		("hash preserves unsupported type dispatch", test_hash_preserves_unsupported_type_dispatch),
		(
			"fused tensor_specialize/specialize walk matches standalone sequence",
			test_fused_tensor_specialize_and_specialize_matches_standalone_sequence,
		),
	]
}
