import:
	../../../benchmark/compiler/compiler_runtime_projection_profile_fixture:
		CompilerRuntimeProjectionProfileConfig,
		CompilerRuntimeProjectionProfileResult,
		compiler_runtime_projection_profile_execute,
	test: TestSuite


private pure func projection_config(
	generic_declarations: Int,
	function_declarations: Int,
	impl_declarations: Int,
	methods_per_impl: Int,
) -> CompilerRuntimeProjectionProfileConfig:
	{
		iterations = 1,
		generic_declarations = generic_declarations,
		function_declarations = function_declarations,
		impl_declarations = impl_declarations,
		methods_per_impl = methods_per_impl
	}


-- Each projected function row copies the rows before it, so n rows model
-- 0 + 1 + ... + (n - 1) copied prefix elements.
private pure func triangular_number(last: Int) -> Int:
	last * (last + 1) / 2


private pure func test_zero_row_generic_mix_projects_nothing() -> Bool:
	result: CompilerRuntimeProjectionProfileResult = compiler_runtime_projection_profile_execute(
		projection_config(
			32,
			0,
			0,
			0,
		),
	)
	observation = result.observation

	(
		result.workload_valid
		and result.error_count == 0
		and observation.input_declarations == 32
		and observation.projected_rows == 0
		and observation.canonicalization_calls == 0
		and observation.modeled_legacy_concat_prefix_elements_copied == 0
	)


private pure func test_many_row_impl_mix_canonicalizes_every_row() -> Bool:
	result: CompilerRuntimeProjectionProfileResult = compiler_runtime_projection_profile_execute(
		projection_config(
			0,
			0,
			4,
			3,
		),
	)
	observation = result.observation

	(
		result.workload_valid
		and result.error_count == 0
		and observation.input_declarations == 4
		and observation.projected_rows > 0
		and observation.canonicalization_calls == observation.projected_rows
		and observation.output_checksum != 0
	)


private pure func test_models_legacy_function_projection_prefix_copy_pressure() -> Bool:
	small: CompilerRuntimeProjectionProfileResult = compiler_runtime_projection_profile_execute(
		projection_config(
			0,
			64,
			0,
			0,
		),
	)
	large: CompilerRuntimeProjectionProfileResult = compiler_runtime_projection_profile_execute(
		projection_config(
			0,
			128,
			0,
			0,
		),
	)

	(
		small.workload_valid
		and large.workload_valid
		and small.error_count == 0
		and large.error_count == 0
		and small.observation.projected_rows == 64
		and large.observation.projected_rows == 128
		and small.observation.modeled_legacy_concat_prefix_elements_copied == triangular_number(64 - 1)
		and large.observation.modeled_legacy_concat_prefix_elements_copied == triangular_number(128 - 1)
	)


tests: TestSuite = {
	description = "Compiler Core runtime projection benchmark",
	tests = [
		("zero-row generic projection mix projects nothing", test_zero_row_generic_mix_projects_nothing),
		("many-row impl projection mix canonicalizes every row", test_many_row_impl_mix_canonicalizes_every_row),
		(
			"models legacy function projection prefix-copy pressure",
			test_models_legacy_function_projection_prefix_copy_pressure,
		),
	]
}
