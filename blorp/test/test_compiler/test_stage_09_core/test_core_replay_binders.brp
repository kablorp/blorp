import:
	../test_support_core_product_build: fixture_build
	../../../src/compiler/stage_09_core/function_origin_fixture:
		FIXTURE_NO_SOURCE_MODULE, FIXTURE_SOURCE_FUNCTION_ORIGIN
	../../../src/compiler/stage_09_core/ir:
		CoreBinderOrigin(AuthoredBinder),
		CoreDecl(FunctionDecl, TraitDecl),
		CoreExpr(ClosureCreateExpr, ForChannelExpr, LetExpr, LiteralExpr, ProductExpr, SelectExpr, SemanticMatchExpr, SeqExpr, TailrecLoopExpr, VarExpr, VoidExpr),
		CoreFunction,
		CoreFunctionKind(ClosureBodyFunction, UserFunction),
		CoreLiteral(IntLiteral),
		CoreLoopRangeDirection(RangeForwardOnly),
		CoreMatchBindingMode(MatchBorrowBindingMode),
		CoreParam,
		CoreProgram,
		CoreSelectArmKind(SelectRecvArm),
		CoreSemanticMatchAccessor(RootSemanticMatchAccessor),
		CoreSemanticMatchTree(SemanticMatchLeaf),
		CoreType(HeapRecordType, NamedType, VoidType),
		CoreVar,
		FIRST_MINTED_BINDER_ID,
		MINTED_BINDER_ID_FLOOR,
		core_expr_type,
		synthetic_core_source_loc,
	../../../src/compiler/stage_09_core/pass_runner:
		core_pass_diagnostic_message, core_pass_replay_state
	../../../src/compiler/stage_09_core/pipeline:
		try_prepare_perceus_input, try_run_perceus_stage, try_run_pre_dce_tail
	../../../src/compiler/stage_09_core/product_evaluation: normalize_product_evaluation
	../../../src/compiler/stage_09_core/replay_binders: replay_binder_frontier
	test: TestSuite


private pure func variable(id: Int) -> CoreVar:
	-- The decoder restores AuthoredBinder even for serialized pass temporaries.
	{ name = "replayed", id = id, def_id = None, origin = AuthoredBinder }


private pure func integer(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), NamedType("Int", []), synthetic_core_source_loc())


private pure func parameter(id: Int) -> CoreParam:
	{ name = variable(id), typ = NamedType("Int", []), loc = synthetic_core_source_loc() }


private pure func function(body: CoreExpr) -> CoreFunction:
	{
		name = "replay_binders",
		source_module = None,
		type_params = [],
		params = [],
		return_type = core_expr_type(body),
		body = Some(body),
		is_pure = True,
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = UserFunction,
		def_id = 1,
		loc = synthetic_core_source_loc()
	}


private pure func program(body: CoreExpr) -> CoreProgram:
	{ decls = [FunctionDecl(function(body))], foreign_includes = [], source_files = [] }


pure func test_replay_reserves_uses_with_decoded_origins() -> Bool:
	body = LetExpr(
		variable(-4),
		False,
		NamedType("Int", []),
		integer(0),
		SeqExpr(
			VarExpr(variable(-12), NamedType("Int", []), synthetic_core_source_loc()),
			VarExpr(variable(MINTED_BINDER_ID_FLOOR - 9), NamedType("Int", []), synthetic_core_source_loc()),
		),
	)
	replay_binder_frontier(program(body)) == -13


pure func test_replay_reserves_unused_loop_and_select_metadata() -> Bool:
	loop = ForChannelExpr({
		binder = {
			variable = variable(-81),
			typ = NamedType("Int", []),
			range_direction = RangeForwardOnly
		},
		iterable = integer(0),
		body = VoidExpr(VoidType, synthetic_core_source_loc())
	}, VoidType, synthetic_core_source_loc())
	tail = TailrecLoopExpr([parameter(-104)], VoidType, loop, synthetic_core_source_loc())
	select_expr = SelectExpr([{
		kind = SelectRecvArm({
			binder = variable(-117),
			elem_type = NamedType("Int", []),
			channel = integer(0)
		}),
		body = integer(0),
		loc = synthetic_core_source_loc()
	}], NamedType("Int", []), synthetic_core_source_loc())
	replay_binder_frontier(program(SeqExpr(tail, select_expr))) == -118


pure func test_replay_reserves_match_and_closure_metadata() -> Bool:
	body = SemanticMatchExpr(
		integer(0),
		SemanticMatchLeaf([{
			variable = variable(-140),
			accessor = RootSemanticMatchAccessor,
			mode = MatchBorrowBindingMode
		}], integer(0)),
		NamedType("Int", []),
		synthetic_core_source_loc(),
	)
	closure = ClosureCreateExpr({
		def_id = 2,
		captures = [{ name = "unused_capture", id = -150, typ = NamedType("Int", []), origin = AuthoredBinder }]
	}, NamedType("Function", []), synthetic_core_source_loc())
	declaration = { function(SeqExpr(closure, body)) |
		params = [parameter(-160)],
		function_kind = ClosureBodyFunction({
			params = [parameter(-170)],
			captures = [{ name = "unused_abi_capture", id = -180, typ = NamedType("Int", []), origin = AuthoredBinder }],
			moved_captures = [],
			task_abi = False
		})
	}
	replay_binder_frontier({ decls = [FunctionDecl(declaration)], foreign_includes = [], source_files = [] }) == -181


pure func test_replay_reserves_trait_signature_parameters() -> Bool:
	trait_decl = TraitDecl({
		name = "ReplayTrait",
		type_params = [],
		methods = [{
			name = "unused_parameter",
			params = [parameter(-190)],
			return_type = NamedType("Int", []),
			is_pure = True,
			loc = synthetic_core_source_loc()
		}],
		loc = synthetic_core_source_loc()
	})
	replay_binder_frontier({ decls = [trait_decl], foreign_includes = [], source_files = [] }) == -191


pure func test_replay_reserves_normalized_field_ids() -> Bool:
	body = ProductExpr(
		fixture_build(1, [(0, VarExpr(variable(0), NamedType("Int", []), synthetic_core_source_loc()))]),
		HeapRecordType("ReplayRecord"),
		synthetic_core_source_loc(),
	)
	first = normalize_product_evaluation(program(body), -20)
	match core_pass_replay_state(first.program, 2):
		Ok(state):
			state.next_binder_id == -21 and first.ids_used == 1
		Err(_):
			False


pure func test_exhausted_replay_is_rejected_before_preparation() -> Bool:
	-- The minimum id exists only in unused loop metadata, not a VarExpr.
	body = TailrecLoopExpr([parameter(MINTED_BINDER_ID_FLOOR + 1)], NamedType("Int", []), integer(0), synthetic_core_source_loc())
	input = program(body)
	expected = "Core replay exhausted the counter-minted binder id band; replay an earlier snapshot"
	constructor_rejects: Bool = match core_pass_replay_state(input, 2):
		Err(diagnostic): core_pass_diagnostic_message(diagnostic) == expected
		Ok(_): False
	(
		constructor_rejects
		and try_prepare_perceus_input(input).is_err()
		and try_run_perceus_stage(input).is_err()
		and try_run_pre_dce_tail(input).is_err()
		and replay_binder_frontier(program(integer(0))) == FIRST_MINTED_BINDER_ID
	)


pure func test_replay_rejects_product_that_exhausts_remaining_supply() -> Bool:
	source = variable(MINTED_BINDER_ID_FLOOR + 2)
	value = VarExpr(source, NamedType("Int", []), synthetic_core_source_loc())
	body = ProductExpr(fixture_build(2, [(0, value), (1, value)]), HeapRecordType("ReplayRecord"), synthetic_core_source_loc())
	input = program(body)
	match core_pass_replay_state(input, 2):
		Ok(state):
			state.next_binder_id == MINTED_BINDER_ID_FLOOR + 1 and try_prepare_perceus_input(input).is_err()
		Err(_):
			False


tests: TestSuite = {
	description = "Core replay binder frontier",
	tests = [
		("replay reserves uses with decoded origins", test_replay_reserves_uses_with_decoded_origins),
		("replay reserves unused loop and select metadata", test_replay_reserves_unused_loop_and_select_metadata),
		("replay reserves match and closure metadata", test_replay_reserves_match_and_closure_metadata),
		("replay reserves trait signature parameters", test_replay_reserves_trait_signature_parameters),
		("replay reserves normalized field ids", test_replay_reserves_normalized_field_ids),
		("exhausted replay is rejected before preparation", test_exhausted_replay_is_rejected_before_preparation),
		("replay rejects product that exhausts remaining supply", test_replay_rejects_product_that_exhausts_remaining_supply),
	]
}
