	assignment_call_name_matches(rewritten, "rewrite_expr__consume_arg0")


pure func test_same_named_distinct_argument_is_not_consumed() -> Bool:
	target: CoreVar = named_var("expr")
	distinct: CoreVar = {
		name = "expr",
		id = 1,
		def_id = None,
		origin = AuthoredBinder
	}
	assignment: CoreExpr = AssignExpr(
		target,
		user_call(
			"rewrite_expr",
			10,
			[VarExpr(distinct, expr_type(), synthetic_core_source_loc()), int_expr(1)],
			expr_type(),
		),
		VoidType,
		synthetic_core_source_loc(),
	)
	identity_run: CoreFunction = { run_function() |
		body = Some(
			LetExpr(
				target,
				True,
				expr_type(),
				lit_expr(0),
				SeqExpr(
					assignment,
					var_expr("expr", expr_type()),
				),
			),
		)
	}
	source_program: CoreProgram = {
		decls = [
			expr_record_decl(),
			FunctionDecl(rewrite_function(update_in_place(7))),
			FunctionDecl(identity_run),
		],
		foreign_includes = [],
		source_files = []
	}
	rewritten: CoreProgram = rewrite_program_for_test(source_program)

	assignment_call_name_matches(rewritten, "rewrite_expr")


private FORWARD_DEF_ID: Int = 40


---
`forward(expr, pass) = body`, a helper with the same signature as
`rewrite_expr` that the last-use tests fill with different call shapes.
---
pure func forward_function(body: CoreExpr) -> CoreFunction:
	{ rewrite_function(body) | name = "forward", def_id = FORWARD_DEF_ID }


---
`run` with `expr = forward(expr, 1)` in place of the `rewrite_expr` call.
---
pure func run_calling_forward() -> CoreFunction:
	{ run_function() |
		body = Some(
			LetExpr(
				named_var("expr"),
				True,
				expr_type(),
				lit_expr(0),
				SeqExpr(
					assignment_expr_for_call(
						named_var("expr"),
						"forward",
						FORWARD_DEF_ID,
						[var_expr("expr", expr_type()), int_expr(1)],
						expr_type(),
					),
					var_expr("expr", expr_type()),
				),
			),
		)
	}


---
Rewrites a program whose `rewrite_expr` has body `rewrite_body` and whose
`forward` helper has body `forward_body`, called from `run`.
---
pure func rewritten_forward_program(rewrite_body: CoreExpr, forward_body: CoreExpr) -> CoreProgram:
	rewrite_program_for_test({
		decls = [
			expr_record_decl(),
			FunctionDecl(rewrite_function(rewrite_body)),
			FunctionDecl(multi_rewrite_function(multi_update_in_place())),
			FunctionDecl(forward_function(forward_body)),
			FunctionDecl(run_calling_forward()),
		],
		foreign_includes = [],
		source_files = []
	})


pure func rewrite_call_on(argument: CoreExpr, pass: Int) -> CoreExpr:
	user_call("rewrite_expr", 10, [argument, int_expr(pass)], expr_type())


---
Every user call name in `expr`, in evaluation order, through the node kinds
these fixtures build.
---
pure func user_call_names(expr: CoreExpr) -> List[String]:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			var names: List[String] = []

			for arg in args:
				names = names.concat(user_call_names(arg))

			match kind:
				UserCall(name, _, _):
					names.append(name)
				_:
					names
		LetExpr(variable, is_mutable, typ, rhs, body):
			user_call_names(rhs).concat(user_call_names(body))
		SeqExpr(first, second):
			user_call_names(first).concat(user_call_names(second))
		IfExpr(cond, then_expr, else_expr, typ, loc):
			user_call_names(cond).concat(user_call_names(then_expr)).concat(user_call_names(else_expr))
		WhileExpr(cond, body, typ, loc):
			user_call_names(cond).concat(user_call_names(body))
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			user_call_names(body)
		AssignExpr(variable, rhs, typ, loc):
			user_call_names(rhs)
		RecordUpdateExpr(base, fields, typ, loc):
			var names: List[String] = user_call_names(base)

			for field in fields:
				names = names.concat(user_call_names(field.value))

			names
		_:
			[]


pure func function_calls_are(program_value: CoreProgram, name: String, expected: List[String]) -> Bool:
	match function_body(program_value, name):
		Some(body):
			user_call_names(body) == expected
		None:
			False


---
A helper whose body is a call on its parameter: the clone hands the
parameter on to `rewrite_expr`'s clone, which is created because the helper's
clone uses it, while the original helper keeps borrowing.
---
pure func test_clones_helper_tail_call_transitively() -> Bool:
	rewritten: CoreProgram = rewritten_forward_program(
		update_in_place(7),
		rewrite_call_on(var_expr("expr", expr_type()), 1),
	)

	(
		function_names_are(
			rewritten,
			[
				"rewrite_expr",
				"rewrite_expr__consume_arg0",
				"multi_rewrite",
				"forward",
				"forward__consume_arg0",
				"run",
			],
		)
		and function_calls_are(rewritten, "forward__consume_arg0", ["rewrite_expr__consume_arg0"])
		and function_calls_are(rewritten, "forward", ["rewrite_expr"])
		and assignment_call_name_matches(rewritten, "forward__consume_arg0")
	)


---
A chain of let-bound calls: the clone hands its parameter to the first call
and the first result to the second; the original keeps borrowing its
parameter but still hands on the local it owns.
---
pure func test_retargets_let_bound_calls_at_last_use() -> Bool:
	first_result: CoreVar = named_var("first_result")
	body: CoreExpr = LetExpr(
		first_result,
		False,
		expr_type(),
		rewrite_call_on(var_expr("expr", expr_type()), 1),
		rewrite_call_on(VarExpr(first_result, expr_type(), synthetic_core_source_loc()), 2),
	)
	rewritten: CoreProgram = rewritten_forward_program(update_in_place(7), body)

	(
		function_calls_are(
			rewritten,
			"forward__consume_arg0",
			["rewrite_expr__consume_arg0", "rewrite_expr__consume_arg0"],
		)
		and function_calls_are(rewritten, "forward", ["rewrite_expr", "rewrite_expr__consume_arg0"])
	)


---
A branch that hands the parameter on and a branch that returns it: the call
is the parameter's last use on its path.
---
pure func test_retargets_branch_call_at_last_use() -> Bool:
	body: CoreExpr = IfExpr(
		bool_expr(True),
		rewrite_call_on(var_expr("expr", expr_type()), 1),
		var_expr("expr", expr_type()),
		expr_type(),
		synthetic_core_source_loc(),
	)
	rewritten: CoreProgram = rewritten_forward_program(update_in_place(7), body)

	function_calls_are(rewritten, "forward__consume_arg0", ["rewrite_expr__consume_arg0"])


---
A chained call, `rewrite_expr(rewrite_expr(expr, 1), 2)`: the inner call's
result is an owned temporary whose only use is the outer argument, so the
outer call takes it in both the helper and its clone. Only the clone hands
its parameter to the inner call.
---
pure func test_retargets_chained_call_temporary() -> Bool:
	body: CoreExpr = rewrite_call_on(rewrite_call_on(var_expr("expr", expr_type()), 1), 2)
	rewritten: CoreProgram = rewritten_forward_program(update_in_place(7), body)

	(
		function_calls_are(
			rewritten,
			"forward__consume_arg0",
			["rewrite_expr__consume_arg0", "rewrite_expr__consume_arg0"],
		)
		and function_calls_are(rewritten, "forward", ["rewrite_expr", "rewrite_expr__consume_arg0"])
	)


---
An owned variable at its last use takes precedence over a call temporary in
a later record slot: `multi_rewrite(expr, rewrite_expr(other, 1), 2)` uses
the clone owning argument 0. The inner call takes `Lit(3)` the same way.
---
pure func test_owned_variable_precedes_call_temporary() -> Bool:
	body: CoreExpr = user_call(
		"multi_rewrite",
		30,
		[
			var_expr("expr", expr_type()),
			rewrite_call_on(lit_expr(3), 1),
			int_expr(2),
		],
		expr_type(),
	)
	rewritten: CoreProgram = rewritten_forward_program(update_in_place(7), body)

	(
		function_calls_are(
			rewritten,
			"forward__consume_arg0",
			["Lit", "rewrite_expr__consume_arg0", "multi_rewrite__consume_arg0"],
		)
		and function_calls_are(
			rewritten,
			"forward",
			["Lit", "rewrite_expr__consume_arg0", "multi_rewrite__consume_arg1"],
		)
	)


---
`expr = multi_rewrite(rewrite_expr(Lit(3), 1), expr, 2)`: the assignment
target in the second record slot is handed on ahead of the call temporary in
the first, so the call takes the clone owning argument 1.
---
pure func test_assignment_target_precedes_call_temporary() -> Bool:
	expr_var: CoreVar = named_var("expr")
	body: CoreExpr = LetExpr(
		expr_var,
		True,
		expr_type(),
		lit_expr(0),
		SeqExpr(
			assignment_expr_for_call(
				expr_var,
				"multi_rewrite",
				30,
				[
					rewrite_call_on(lit_expr(3), 1),
					var_expr("expr", expr_type()),
					int_expr(2),
				],
				expr_type(),
			),
			var_expr("expr", expr_type()),
		),
	)
	rewritten: CoreProgram = rewrite_program_for_test({
		decls = [
			expr_record_decl(),
			FunctionDecl(rewrite_function(update_in_place(7))),
			FunctionDecl(multi_rewrite_function(multi_update_in_place())),
			FunctionDecl({ run_function() | body = Some(body) }),
		],
		foreign_includes = [],
		source_files = []
	})

	function_calls_are(
		rewritten,
		"run",
		["Lit", "Lit", "rewrite_expr__consume_arg0", "multi_rewrite__consume_arg1"],
	)


---
`run` with `var expr = Lit(0); temp = rewrite_expr(expr, 1); expr = <second>;
<after>; expr`, where `second` and `after` may use `temp`.
---
pure func run_through_temporary(second: CoreExpr, after: CoreExpr) -> CoreProgram:
	temp: CoreVar = named_var("temp")
	expr_var: CoreVar = named_var("expr")
	body: CoreExpr = LetExpr(
		expr_var,
		True,
		expr_type(),
		lit_expr(0),
		SeqExpr(
			LetExpr(
				temp,
				False,
				expr_type(),
				rewrite_call_on(var_expr("expr", expr_type()), 1),
				SeqExpr(
					AssignExpr(expr_var, second, VoidType, synthetic_core_source_loc()),
					after,
				),
			),
			var_expr("expr", expr_type()),
		),
	)

	rewrite_program_for_test({
		decls = [
			expr_record_decl(),
			FunctionDecl(rewrite_function(update_in_place(7))),
			FunctionDecl(multi_rewrite_function(multi_update_in_place())),
			FunctionDecl({ run_function() | body = Some(body) }),
		],
		foreign_includes = [],
		source_files = []
	})


pure func void_expr() -> CoreExpr:
	VoidExpr(VoidType, synthetic_core_source_loc())


---
`temp = rewrite_expr(expr, 1); expr = rewrite_expr(temp, 2)` becomes two
`expr = rewrite_expr(expr, ...)` assignments, each handing `expr` on.
---
pure func test_forwards_temporary_into_assigned_variable() -> Bool:
	rewritten: CoreProgram = run_through_temporary(
		rewrite_call_on(var_expr("temp", expr_type()), 2),
		void_expr(),
	)

	(
		function_calls_are(
			rewritten,
			"run",
			["Lit", "rewrite_expr__consume_arg0", "rewrite_expr__consume_arg0"],
		)
		and function_body(rewritten, "run").map(func(body): count_lets_named(body, "temp")).get_or(-1) == 0
	)


---
A temporary read after the assignment keeps its binding: forwarding it would
read the reassigned variable instead.
---
pure func test_keeps_temporary_read_after_assignment() -> Bool:
	rewritten: CoreProgram = run_through_temporary(
		rewrite_call_on(var_expr("temp", expr_type()), 2),
		add_expr(var_expr("temp", expr_type()), lit_expr(1)),
	)

	function_body(rewritten, "run").map(func(body): count_lets_named(body, "temp")).get_or(-1) == 1


---
An assigned call that also reads the variable keeps the temporary: the read
must see the value from before the first call.
---
pure func test_keeps_temporary_when_assigned_call_reads_variable() -> Bool:
	rewritten: CoreProgram = run_through_temporary(
		user_call(
			"multi_rewrite",
			30,
			[var_expr("temp", expr_type()), var_expr("expr", expr_type()), int_expr(2)],
			expr_type(),
		),
		void_expr(),
	)

	function_body(rewritten, "run").map(func(body): count_lets_named(body, "temp")).get_or(-1) == 1


---
`expr = rewrite_expr(temp, <exit; 2>)`: evaluating the assigned call may leave
the loop iteration before the assignment, so `expr` must keep its old value
there; forwarding would leave it holding the first call's result.
---
pure func assigned_call_leaving_through(exit: CoreExpr) -> CoreExpr:
	rewrite_call_on_with_pass(
		var_expr("temp", expr_type()),
		SeqExpr(exit, int_expr(2)),
	)


pure func rewrite_call_on_with_pass(argument: CoreExpr, pass: CoreExpr) -> CoreExpr:
	user_call("rewrite_expr", 10, [argument, pass], expr_type())


pure func test_keeps_temporary_when_assigned_call_can_break() -> Bool:
	rewritten: CoreProgram = run_through_temporary(
		assigned_call_leaving_through(BreakExpr(VoidType, synthetic_core_source_loc())),
		void_expr(),
	)

	function_body(rewritten, "run").map(func(body): count_lets_named(body, "temp")).get_or(-1) == 1


pure func test_keeps_temporary_when_assigned_call_can_continue() -> Bool:
	rewritten: CoreProgram = run_through_temporary(
		assigned_call_leaving_through(ContinueExpr(VoidType, synthetic_core_source_loc())),
		void_expr(),
	)

	function_body(rewritten, "run").map(func(body): count_lets_named(body, "temp")).get_or(-1) == 1


pure func count_lets_named(expr: CoreExpr, name: String) -> Int:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			own: Int = if variable.name == name:
				1
			else:
				0

			own + count_lets_named(rhs, name) + count_lets_named(body, name)
		SeqExpr(first, second):
			count_lets_named(first, name) + count_lets_named(second, name)
		AssignExpr(variable, rhs, typ, loc):
			count_lets_named(rhs, name)
		_:
			0


---
The parameter is read after the call, so the call keeps borrowing it.
---
pure func test_keeps_call_when_argument_is_read_after() -> Bool:
	first_result: CoreVar = named_var("first_result")
	body: CoreExpr = LetExpr(
		first_result,
		False,
		expr_type(),
		rewrite_call_on(var_expr("expr", expr_type()), 1),
		add_expr(
			var_expr("expr", expr_type()),
			VarExpr(first_result, expr_type(), synthetic_core_source_loc()),
		),
	)
	rewritten: CoreProgram = rewritten_forward_program(update_in_place(7), body)

	-- A wrong retarget would hand the parameter on and make the helper's
	-- clone beneficial; kept borrowing, the helper gets no clone at all.
	(
		function_occurrence_count(rewritten, "forward__consume_arg0") == 0
		and function_calls_are(rewritten, "forward", ["rewrite_expr", "Add"])
	)


---
The parameter passed twice to one call is never handed over.
---
pure func test_keeps_call_when_argument_is_passed_twice() -> Bool:
	body: CoreExpr = user_call(
		"multi_rewrite",
		30,
		[var_expr("expr", expr_type()), var_expr("expr", expr_type()), int_expr(1)],
		expr_type(),
	)
	rewritten: CoreProgram = rewritten_forward_program(update_in_place(7), body)

	-- A wrong retarget would hand the parameter on and make the helper's
	-- clone beneficial; kept borrowing, the helper gets no clone at all.
	(
		function_occurrence_count(rewritten, "forward__consume_arg0") == 0
		and function_calls_are(rewritten, "forward", ["multi_rewrite"])
	)


---
A lambda that calls on the captured parameter borrows its capture: the call
inside it is never retargeted.
---
pure func test_keeps_call_inside_lambda_on_captured_parameter() -> Bool:
	lambda_type: CoreType = closure_type()
	body: CoreExpr = LetExpr(
		named_var("callback"),
		False,
		lambda_type,
		LambdaExpr(
			[param("pass_value", int_type())],
			expr_type(),
			rewrite_call_on(var_expr("expr", expr_type()), 1),
			True,
			lambda_type,
			synthetic_core_source_loc(),
		),
		var_expr("expr", expr_type()),
	)
	rewritten: CoreProgram = rewritten_forward_program(update_in_place(7), body)

	-- A wrong retarget would hand the parameter on and make the helper's
	-- clone beneficial; kept borrowing, the helper gets no clone at all.
	(
		function_occurrence_count(rewritten, "forward__consume_arg0") == 0
		and function_calls_are(rewritten, "forward", ["rewrite_expr"])
	)


---
A call on the parameter inside a loop runs once per iteration, so the
parameter stays live across it and the call keeps borrowing.
---
pure func test_keeps_call_inside_loop_on_outer_parameter() -> Bool:
	body: CoreExpr = SeqExpr(
		WhileExpr(
			bool_expr(False),
			rewrite_call_on(var_expr("expr", expr_type()), 1),
			VoidType,
			synthetic_core_source_loc(),
		),
		var_expr("expr", expr_type()),
	)
	rewritten: CoreProgram = rewritten_forward_program(update_in_place(7), body)

	-- A wrong retarget would hand the parameter on and make the helper's
	-- clone beneficial; kept borrowing, the helper gets no clone at all.
	(
		function_occurrence_count(rewritten, "forward__consume_arg0") == 0
		and function_calls_are(rewritten, "forward", ["rewrite_expr"])
	)


---
Self-recursion through the parameter: the clone calls itself, the original
keeps calling the original.
---
pure func test_recursive_clone_hands_parameter_to_itself() -> Bool:
	rewritten: CoreProgram = rewritten_program(
		IfExpr(
			bool_expr(True),
			update_in_place(1),
			rewrite_call_on(var_expr("expr", expr_type()), 2),
			expr_type(),
			synthetic_core_source_loc(),
		),
	)

	(
		function_calls_are(rewritten, "rewrite_expr__consume_arg0", ["rewrite_expr__consume_arg0"])
		and function_calls_are(rewritten, "rewrite_expr", ["rewrite_expr"])
	)


---
The safety net for imprecise last-use analysis: a call handed to a clone
while its argument is still live gets a retain from Perceus, so the clone's
in-place update cannot reach the caller's value.
---
pure func test_perceus_retains_live_argument_of_consuming_call() -> Bool:
	base: CoreProgram = rewritten_program(update_in_place(7))
	kept: CoreVar = named_var("kept")
	clone_def_id: Int = function_definition_id(base, "rewrite_expr__consume_arg0").get_or(0)
	keeps_old: CoreFunction = { run_function() |
		name = "keeps_old",
		def_id = 50,
		body = Some(
			LetExpr(
				kept,
				False,
				expr_type(),
				lit_expr(0),
				add_expr(
					user_call(
						"rewrite_expr__consume_arg0",
						clone_def_id,
						[VarExpr(kept, expr_type(), synthetic_core_source_loc()), int_expr(1)],
						expr_type(),
					),
					VarExpr(kept, expr_type(), synthetic_core_source_loc()),
				),
			),
		)
	}
	perceus: CoreProgram = insert_drops_program({ base |
		decls = base.decls.append(FunctionDecl(keeps_old))
	})
	json: String = core_program_to_json(perceus).to_string()

	json.contains("\"kind\":\"dup\",\"var\":{\"name\":\"kept\"")


---
An unmanaged parameter has no reference to hand over, so `n = count_up(n)`
never gets a clone even though the result type matches.
---
pure func test_does_not_clone_unmanaged_parameter() -> Bool:
	count_up: CoreFunction = { rewrite_function(var_expr("n", int_type())) |
		name = "count_up",
		def_id = 60,
		params = [param("n", int_type())],
		return_type = int_type()
	}
	counter_run: CoreFunction = { run_function() |
		return_type = int_type(),
		body = Some(
			LetExpr(
				named_var("n"),
				True,
				int_type(),
				int_expr(0),
				SeqExpr(
					assignment_expr_for_call(
						named_var("n"),
						"count_up",
						60,
						[var_expr("n", int_type())],
						int_type(),
					),
					var_expr("n", int_type()),
				),
			),
		)
	}
	rewritten: CoreProgram = rewrite_program_for_test({
		decls = [expr_record_decl(), FunctionDecl(count_up), FunctionDecl(counter_run)],
		foreign_includes = [],
		source_files = []
	})

	function_names_are(rewritten, ["count_up", "run"]) and assignment_call_name_matches(rewritten, "count_up")


---
`expr = if c: rewrite_expr(expr, 1) else Add(expr, 1)` would consume the
old value on one branch only, which Perceus does not balance at an
assignment, so a compound right-hand side never takes the assignment target.
---
pure func test_keeps_assignment_target_live_in_compound_right_hand_side() -> Bool:
	branch_assignment: CoreExpr = AssignExpr(
		named_var("expr"),
		IfExpr(
			bool_expr(True),
			rewrite_call_on(var_expr("expr", expr_type()), 1),
			add_expr(var_expr("expr", expr_type()), lit_expr(1)),
			expr_type(),
			synthetic_core_source_loc(),
		),
		VoidType,
		synthetic_core_source_loc(),
	)
	branch_run: CoreFunction = { run_function() |
		body = Some(
			LetExpr(
				named_var("expr"),
				True,
				expr_type(),
				lit_expr(0),
				SeqExpr(branch_assignment, var_expr("expr", expr_type())),
			),
		)
	}
	rewritten: CoreProgram = rewrite_program_for_test({
		decls = [
			expr_record_decl(),
			FunctionDecl(rewrite_function(update_in_place(7))),
			FunctionDecl(branch_run),
		],
		foreign_includes = [],
		source_files = []
	})

	function_calls_are(rewritten, "run", ["Lit", "rewrite_expr", "Lit", "Add"])


---
`var out = expr; out = { out | count = 1 }; out` updates the parameter's
record through the variable, which is a direct in-place benefit.
---
pure func test_clones_helper_updating_parameter_through_var() -> Bool:
	body: CoreExpr = LetExpr(
		named_var("out"),
		True,
		expr_type(),
		var_expr("expr", expr_type()),
		SeqExpr(
			AssignExpr(
				named_var("out"),
				update_param_in_place("out", 1),
				VoidType,
				synthetic_core_source_loc(),
			),
			var_expr("out", expr_type()),
		),
	)
	rewritten: CoreProgram = rewritten_forward_program(var_expr("expr", expr_type()), body)

	(
		function_occurrence_count(rewritten, "forward__consume_arg0") == 1
		and assignment_call_name_matches(rewritten, "forward__consume_arg0")
	)


---
`let fresh = Lit(0); multi_rewrite(fresh, expr, 1)`: the call is retargeted
to consume `fresh` (argument 0), so the helper's own parameter sits at a
borrowed position and is not handed over. The helper's clone has no benefit
and is not kept.
---
pure func test_does_not_count_borrowed_position_as_hand_off() -> Bool:
	fresh: CoreVar = named_var("fresh")
	body: CoreExpr = LetExpr(
		fresh,
		False,
		expr_type(),
		lit_expr(0),
		user_call(
			"multi_rewrite",
			30,
			[
				VarExpr(fresh, expr_type(), synthetic_core_source_loc()),
				var_expr("expr", expr_type()),
				int_expr(1),
			],
			expr_type(),
		),
	)
	rewritten: CoreProgram = rewritten_forward_program(var_expr("expr", expr_type()), body)

	(
		function_occurrence_count(rewritten, "forward__consume_arg0") == 0
		and function_calls_are(rewritten, "forward", ["Lit", "multi_rewrite__consume_arg0"])
		and assignment_call_name_matches(rewritten, "forward")
	)

private HOLDER_DEF_ID: Int = 50

private HOLDER_LEFT_FIELD: Int = 1

private HOLDER_RIGHT_FIELD: Int = 2

-- The positions of `left` and `right` in `Holder`.
private HOLDER_LEFT_POSITION: Int = 0

private HOLDER_RIGHT_POSITION: Int = 1


pure func holder_type() -> CoreType:
	HeapRecordType("Holder")


---
`Holder { left: Expr, right: Expr }`: a record whose fields are records
with consuming clones, the nested shape of a builder holding table families.
---
pure func holder_record_decl() -> CoreDecl:
	HeapRecordDecl({
		abi_type = None,
		form = OrdinaryRecordForm,
		name = "Holder",
		type_params = [],
		fields = [
			{
				ref = core_field_ref(HOLDER_LEFT_FIELD),
				name = "left",
				typ = expr_type(),
				release_policy = ArcReleasePolicy
			},
			{
				ref = core_field_ref(HOLDER_RIGHT_FIELD),
				name = "right",
				typ = expr_type(),
				release_policy = ArcReleasePolicy
			},
		],
		loc = synthetic_core_source_loc(),
	})


pure func holder_field_read(owner: String, position: Int) -> CoreExpr:
	ProductFieldExpr(
		var_expr(owner, holder_type()),
		core_field_ordinal(position),
		expr_type(),
		synthetic_core_source_loc(),
	)


---
`{ holder | left = replacement }` in its lowered form, with `right`
inherited from the record-update temporary.
---
pure func update_holder_left(replacement: CoreExpr) -> CoreExpr:
	base: CoreVar = named_var("__record_update_holder")

	LetExpr(
		base,
		False,
		holder_type(),
		var_expr("holder", holder_type()),
		RecordUpdateExpr(
			VarExpr(base, holder_type(), synthetic_core_source_loc()),
			[
				{
					ref = core_field_ref(HOLDER_LEFT_FIELD),
					name = "left",
					value = replacement
				},
				{
					ref = core_field_ref(HOLDER_RIGHT_FIELD),
					name = "right",
					value = ProductFieldExpr(
						VarExpr(base, holder_type(), synthetic_core_source_loc()),
						core_field_ordinal(HOLDER_RIGHT_POSITION),
						expr_type(),
						synthetic_core_source_loc(),
					)
				},
			],
			holder_type(),
			synthetic_core_source_loc(),
		),
	)


pure func update_holder_function(body: CoreExpr) -> CoreFunction:
	{ rewrite_function(body) |
		name = "update_holder",
		params = [param("holder", holder_type()), param("pass", int_type())],
		return_type = holder_type(),
		def_id = HOLDER_DEF_ID
	}


---
`run` threading a holder through `holder = update_holder(holder, 1)`.
---
pure func run_updating_holder() -> CoreFunction:
	holder: CoreVar = named_var("holder")

	{ run_function() |
		return_type = holder_type(),
		body = Some(
			LetExpr(
				holder,
				True,
				holder_type(),
				var_expr("initial_holder", holder_type()),
				SeqExpr(
					assignment_expr_for_call(
						holder,
						"update_holder",
						HOLDER_DEF_ID,
						[var_expr("holder", holder_type()), int_expr(1)],
						holder_type(),
					),
					var_expr("holder", holder_type()),
				),
			),
		)
	}


---
Rewrites a program whose `update_holder` updates `left` with `replacement`,
next to `rewrite_expr`, which updates its `Expr` in place.
---
pure func rewritten_holder_program(replacement: CoreExpr) -> CoreProgram:
	rewrite_program_for_test({
		decls = [
			expr_record_decl(),
			holder_record_decl(),
			FunctionDecl(rewrite_function(update_in_place(7))),
			FunctionDecl(update_holder_function(update_holder_left(replacement))),
			FunctionDecl(run_updating_holder()),
		],
		foreign_includes = [],
		source_files = []
	})


---
`{ holder | left = rewrite_expr(holder.left, 1) }`: the replacement reads the
slot it replaces, so in the holder's clone, which owns the holder, the call
takes the consuming clone and the reuse pass can move the field out of a
unique holder for it. The borrowing original can never update its holder in
place, so it keeps the original callee.
---
pure func test_retargets_replaced_field_slot_argument() -> Bool:
	rewritten: CoreProgram = rewritten_holder_program(
		rewrite_call_on(holder_field_read("holder", HOLDER_LEFT_POSITION), 1),
	)

	(
		function_calls_are(rewritten, "update_holder__consume_arg0", ["rewrite_expr__consume_arg0"])
		and function_calls_are(rewritten, "update_holder", ["rewrite_expr"])
		and assignment_call_name_matches(rewritten, "update_holder__consume_arg0")
	)


---
`holder = { holder | left = rewrite_expr(holder.left, 1) }` in a loop: the
assignment ends the old holder, so the update is in place and the replaced
slot goes to the consuming clone even though the walk owns nothing there.
---
pure func test_retargets_replaced_field_slot_of_assignment_target() -> Bool:
	holder: CoreVar = named_var("holder")
	update: CoreExpr = update_holder_left(
		rewrite_call_on(holder_field_read("holder", HOLDER_LEFT_POSITION), 1),
	)
	loop_run: CoreFunction = { run_function() |
		return_type = holder_type(),
		body = Some(
			LetExpr(
				holder,
				True,
				holder_type(),
				var_expr("initial_holder", holder_type()),
				SeqExpr(
					WhileExpr(
						bool_expr(False),
						AssignExpr(holder, update, VoidType, synthetic_core_source_loc()),
						VoidType,
						synthetic_core_source_loc(),
					),
					var_expr("holder", holder_type()),
				),
			),
		)
	}
	rewritten: CoreProgram = rewrite_program_for_test({
		decls = [
			expr_record_decl(),
			holder_record_decl(),
			FunctionDecl(rewrite_function(update_in_place(7))),
			FunctionDecl(loop_run),
		],
		foreign_includes = [],
		source_files = []
	})

	function_calls_are(rewritten, "run", ["rewrite_expr__consume_arg0"])


---
The record-update temporary names the same record, so a read of the slot
through it is the replaced slot too.
---
pure func test_retargets_replaced_field_slot_read_through_update_binding() -> Bool:
	rewritten: CoreProgram = rewritten_holder_program(
		rewrite_call_on(
			holder_field_read("__record_update_holder", HOLDER_LEFT_POSITION),
			1,
		),
	)

	function_calls_are(rewritten, "update_holder__consume_arg0", ["rewrite_expr__consume_arg0"])


---
A method chain on the replaced slot: the inner call reads the slot and the
outer one takes the inner call's owned result.
---
pure func test_retargets_method_chain_on_replaced_field_slot() -> Bool:
	rewritten: CoreProgram = rewritten_holder_program(
		rewrite_call_on(
			rewrite_call_on(holder_field_read("holder", HOLDER_LEFT_POSITION), 1),
			2,
		),
	)

	function_calls_are(
		rewritten,
		"update_holder__consume_arg0",
		["rewrite_expr__consume_arg0", "rewrite_expr__consume_arg0"],
	)


---
A read of another field is not the replaced slot: handing it to a clone
would only retain it, since the update keeps it in place.
---
pure func test_keeps_call_on_other_field_of_updated_record() -> Bool:
	rewritten: CoreProgram = rewritten_holder_program(
		rewrite_call_on(holder_field_read("holder", HOLDER_RIGHT_POSITION), 1),
	)

	function_calls_are(rewritten, "update_holder__consume_arg0", ["rewrite_expr"])


---
The same field of a different record is not the replaced slot.
---
pure func test_keeps_call_on_same_field_of_other_record() -> Bool:
	rewritten: CoreProgram = rewritten_holder_program(
		rewrite_call_on(holder_field_read("other_holder", HOLDER_LEFT_POSITION), 1),
	)

	function_calls_are(rewritten, "update_holder__consume_arg0", ["rewrite_expr"])


---
The field take does not reach into a branch of the replacement, so a call
there keeps the original callee.
---
pure func test_keeps_call_on_replaced_field_slot_in_branch() -> Bool:
	slot_read: CoreExpr = holder_field_read("holder", HOLDER_LEFT_POSITION)
	rewritten: CoreProgram = rewritten_holder_program(
		IfExpr(
			bool_expr(True),
			rewrite_call_on(slot_read, 1),
			slot_read,
			expr_type(),
			synthetic_core_source_loc(),
		),
	)

	function_calls_are(rewritten, "update_holder__consume_arg0", ["rewrite_expr"])


tests: TestSuite = {
	description = "Blorp compiler Core consume specialize",
	tests = [
		("rewrites safe self-replacement call", test_rewrites_safe_self_replacement_call),
		("clone identity uses name and def id", test_clone_identity_uses_name_and_def_id),
		(
			"later same def id name does not steal candidate",
			test_later_same_def_id_name_does_not_steal_candidate,
		),
		(
			"structurally different target type does not select candidate",
			test_structurally_different_target_type_does_not_select_candidate,
		),
		(
			"clone ID follows every declared definition ID",
			test_clone_id_follows_every_declared_definition_id,
		),
		(
			"later used candidate retains ID reserved by unused candidate",
			test_later_used_candidate_retains_id_reserved_by_unused_candidate,
		),
		("used clones emit once in parameter order", test_used_clones_emit_once_in_parameter_order),
		("does not clone without in-place update", test_does_not_clone_without_in_place_update),
		(
			"does not clone hand-off to clone without benefit",
			test_does_not_clone_hand_off_to_clone_without_benefit,
		),
		("does not clone recursion without update", test_does_not_clone_recursion_without_update),
		(
			"no-candidate program rewrites identically",
			test_no_candidate_program_rewrites_identically,
		),
		(
			"Perceus consuming clone skips old assignment drop",
			test_perceus_consuming_clone_skips_old_assignment_drop,
		),
		(
			"rewrites assignment nested in constructor match",
			test_rewrites_assignment_nested_in_constructor_match,
		),
		("rewrites assignment nested in while", test_rewrites_assignment_nested_in_while),
		(
			"same-named distinct argument is not consumed",
			test_same_named_distinct_argument_is_not_consumed,
		),
		(
			"clones helper tail call transitively",
			test_clones_helper_tail_call_transitively,
		),
		("retargets let-bound calls at last use", test_retargets_let_bound_calls_at_last_use),
		("retargets branch call at last use", test_retargets_branch_call_at_last_use),
		("retargets chained call temporary", test_retargets_chained_call_temporary),
		("owned variable precedes call temporary", test_owned_variable_precedes_call_temporary),
		(
			"assignment target precedes call temporary",
			test_assignment_target_precedes_call_temporary,
		),
		(
			"forwards temporary into assigned variable",
			test_forwards_temporary_into_assigned_variable,
		),
		("keeps temporary read after assignment", test_keeps_temporary_read_after_assignment),
		(
			"keeps temporary when assigned call reads variable",
			test_keeps_temporary_when_assigned_call_reads_variable,
		),
		(
			"keeps temporary when assigned call can break",
			test_keeps_temporary_when_assigned_call_can_break,
		),
		(
			"keeps temporary when assigned call can continue",
			test_keeps_temporary_when_assigned_call_can_continue,
		),
		(
			"keeps call when argument is read after",
			test_keeps_call_when_argument_is_read_after,
		),
		(
			"keeps call when argument is passed twice",
			test_keeps_call_when_argument_is_passed_twice,
		),
		(
			"keeps call inside lambda on captured parameter",
			test_keeps_call_inside_lambda_on_captured_parameter,
		),
		(
			"keeps call inside loop on outer parameter",
			test_keeps_call_inside_loop_on_outer_parameter,
		),
		(
			"recursive clone hands parameter to itself",
			test_recursive_clone_hands_parameter_to_itself,
		),
		(
			"Perceus retains live argument of consuming call",
			test_perceus_retains_live_argument_of_consuming_call,
		),
		("does not clone unmanaged parameter", test_does_not_clone_unmanaged_parameter),
		(
			"clones helper updating parameter through var",
			test_clones_helper_updating_parameter_through_var,
		),
		(
			"does not count borrowed position as hand-off",
			test_does_not_count_borrowed_position_as_hand_off,
		),
		(
			"keeps assignment target live in compound right-hand side",
			test_keeps_assignment_target_live_in_compound_right_hand_side,
		),
		("retargets replaced field slot argument", test_retargets_replaced_field_slot_argument),
		(
			"retargets replaced field slot of assignment target",
			test_retargets_replaced_field_slot_of_assignment_target,
		),
		(
			"retargets replaced field slot read through update binding",
			test_retargets_replaced_field_slot_read_through_update_binding,
		),
		(
			"retargets method chain on replaced field slot",
			test_retargets_method_chain_on_replaced_field_slot,
		),
		("keeps call on other field of updated record", test_keeps_call_on_other_field_of_updated_record),
		("keeps call on same field of other record", test_keeps_call_on_same_field_of_other_record),
		(
			"keeps call on replaced field slot in branch",
			test_keeps_call_on_replaced_field_slot_in_branch,
		),
	]
}
