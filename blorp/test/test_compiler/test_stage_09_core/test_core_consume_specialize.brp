-- See the matching helper in test_core_closure.brp: these fixtures build a
-- `CoreProgram` by hand, so they seed the definition-id frontier the same way
-- production would if this fixture were the whole program so far.
private pure func rewrite_program_for_test(program: CoreProgram) -> CoreProgram:
	rewrite_program(program, core_program_max_declared_definition_id(program) + 1).program


private MAX_NO_CANDIDATE_REWRITE_ALLOCATIONS: Int = 16

-- The fixture's highest definition id is `multi_rewrite`'s 30; its two record
-- parameters reserve 31 and 32 whether or not the first clone is used.
private MULTI_REWRITE_SECOND_CLONE_DEF_ID: Int = 32


pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = None,
		origin = AuthoredBinder
	}


pure func function_var(name: String, def_id: Int) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = Some(def_id),
		origin = AuthoredBinder
	}


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func expr_type() -> CoreType:
	HeapRecordType("Expr")


pure func other_expr_type() -> CoreType:
	HeapRecordType("OtherExpr")


pure func closure_type() -> CoreType:
	NamedType("Closure", [])


pure func param(name: String, typ: CoreType) -> CoreParam:
	{
		name = named_var(name),
		typ = typ,
		loc = synthetic_core_source_loc()
	}


pure func int_expr(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), int_type(), synthetic_core_source_loc())


pure func bool_expr(value: Bool) -> CoreExpr:
	LiteralExpr(BoolLiteral(value), bool_type(), synthetic_core_source_loc())


pure func var_expr(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(named_var(name), typ, synthetic_core_source_loc())


pure func callee_expr(name: String, def_id: Int) -> CoreExpr:
	VarExpr(
		function_var(name, def_id),
		closure_type(),
		synthetic_core_source_loc(),
	)


pure func user_call(
	name: String,
	def_id: Int,
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(
		UserCall(name, Some(def_id), []),
		callee_expr(name, def_id),
		args,
		return_type,
		synthetic_core_source_loc(),
	)


pure func lit_expr(value: Int) -> CoreExpr:
	user_call("Lit", 100, [int_expr(value)], expr_type())


pure func add_expr(left: CoreExpr, right: CoreExpr) -> CoreExpr:
	user_call(
		"Add",
		101,
		[left, right],
		expr_type(),
	)


---
`Expr` as a heap record with one `count` field: consuming clones only exist
for record parameters, because only a record can be updated in place.
---
pure func expr_record_decl() -> CoreDecl:
	HeapRecordDecl({
		abi_type = None,
		form = OrdinaryRecordForm,
		name = "Expr",
		type_params = [],
		fields = [
			{
				ref = core_field_ref(0),name = "count",
				typ = int_type(),
				release_policy = NoReleasePolicy
			},
		],
		loc = synthetic_core_source_loc(),
	})


pure func other_expr_record_decl() -> CoreDecl:
	match expr_record_decl():
		HeapRecordDecl(decl):
			HeapRecordDecl({ decl | name = "OtherExpr" })
		other:
			other


---
`{ <parameter> | count = value }` in its lowered form: the parameter bound to
a record-update temporary, then updated. This is the direct in-place benefit
that makes a consuming clone of the enclosing function worthwhile.
---
pure func update_param_in_place(parameter: String, value: Int) -> CoreExpr:
	base: CoreVar = named_var("__record_update_${parameter}")

	LetExpr(
		base,
		False,
		expr_type(),
		var_expr(parameter, expr_type()),
		RecordUpdateExpr(
			VarExpr(base, expr_type(), synthetic_core_source_loc()),
			[
				{
					ref = core_field_ref(0),name = "count",
					value = int_expr(value)
				},
			],
			expr_type(),
			synthetic_core_source_loc(),
		),
	)


pure func update_in_place(value: Int) -> CoreExpr:
	update_param_in_place("expr", value)


---
Updates both record parameters of `multi_rewrite`, so a clone for either one
has a direct benefit.
---
pure func multi_update_in_place() -> CoreExpr:
	LetExpr(
		named_var("updated_left"),
		False,
		expr_type(),
		update_param_in_place("left_expr", 1),
		update_param_in_place("right_expr", 2),
	)


pure func rewrite_function(body: CoreExpr) -> CoreFunction:
	{
		name = "rewrite_expr",
		source_module = None,
		type_params = [],
		params = [param("expr", expr_type()), param("pass", int_type())],
		return_type = expr_type(),
		body = Some(body),
		is_pure = True,
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = UserFunction,
		def_id = 10,
		loc = synthetic_core_source_loc()
	}


pure func multi_rewrite_function(body: CoreExpr) -> CoreFunction:
	{
		name = "multi_rewrite",
		source_module = None,
		type_params = [],
		params = [
			param("left_expr", expr_type()),
			param("right_expr", expr_type()),
			param("pass", int_type()),
		],
		return_type = expr_type(),
		body = Some(body),
		is_pure = True,
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = UserFunction,
		def_id = 30,
		loc = synthetic_core_source_loc()
	}


pure func assignment_expr() -> CoreExpr:
	AssignExpr(
		named_var("expr"),
		user_call(
			"rewrite_expr",
			10,
			[var_expr("expr", expr_type()), int_expr(1)],
			expr_type(),
		),
		VoidType,
		synthetic_core_source_loc(),
	)


pure func assignment_expr_for_call(
	target: CoreVar,
	call_name: String,
	def_id: Int,
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	AssignExpr(
		target,
		user_call(call_name, def_id, args, return_type),
		VoidType,
		synthetic_core_source_loc(),
	)


pure func run_function() -> CoreFunction:
	{
		name = "run",
		source_module = None,
		type_params = [],
		params = [],
		return_type = expr_type(),
		body = Some(
			LetExpr(
				named_var("expr"),
				True,
				expr_type(),
				lit_expr(0),
				SeqExpr(
					assignment_expr(),
					var_expr("expr", expr_type()),
				),
			),
		),
		is_pure = True,
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = UserFunction,
		def_id = 20,
		loc = synthetic_core_source_loc()
	}


pure func program(rewrite_body: CoreExpr) -> CoreProgram:
	{
		decls = [
			expr_record_decl(),
			FunctionDecl(rewrite_function(rewrite_body)),
			FunctionDecl(run_function()),
		],
		foreign_includes = [],
		source_files = []
	}


pure func rewritten_program(rewrite_body: CoreExpr) -> CoreProgram:
	rewrite_program_for_test(program(rewrite_body))


pure func function_names_are(program_value: CoreProgram, expected: List[String]) -> Bool:
	var index: Int = 0
	var matches: Bool = True

	for decl in program_value.decls:
		match decl:
			FunctionDecl(func_info):
				match expected.get(index):
					Some(expected_name):
						if func_info.name != expected_name:
							matches = False
							break
						else:
							void
					None:
						matches = False
						break

				index += 1
			UnionDecl(union_decl):
				void
			_:
				void

	matches and index == expected.length()


pure func function_definition_id(program_value: CoreProgram, name: String) -> Option[Int]:
	var found: Option[Int] = None

	for decl in program_value.decls:
		match decl:
			FunctionDecl(func_info):
				if func_info.name == name:
					found = Some(func_info.def_id)
				else:
					void
			_:
				void

	found


pure func function_occurrence_count(program_value: CoreProgram, name: String) -> Int:
	var count: Int = 0

	for decl in program_value.decls:
		match decl:
			FunctionDecl(func_info):
				if func_info.name == name:
					count += 1
				else:
					void
			_:
				void

	count


pure func assignment_call_name_matches_in_expr(expr: CoreExpr, expected: String) -> Option[Bool]:
	match expr:
		AssignExpr(variable, rhs, typ, loc):
			match rhs:
				CallExpr(UserCall(name, def_id, consumed_args), callee, args, call_type, call_loc):
					Some(name == expected)
				_:
					None
		LetExpr(variable, is_mutable, typ, rhs, body):
			match assignment_call_name_matches_in_expr(rhs, expected):
				Some(matches):
					Some(matches)
				None:
					assignment_call_name_matches_in_expr(body, expected)
		SeqExpr(first, second):
			match assignment_call_name_matches_in_expr(first, expected):
				Some(matches):
					Some(matches)
				None:
					assignment_call_name_matches_in_expr(second, expected)
		WhileExpr(cond, body, typ, loc):
			match assignment_call_name_matches_in_expr(cond, expected):
				Some(matches):
					Some(matches)
				None:
					assignment_call_name_matches_in_expr(body, expected)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			var found: Option[Bool] = assignment_call_name_matches_in_expr(scrutinee, expected)

			for match_case in cases:
				if found == None:
					match match_case.body:
						ConstructorMatchBodyExpr(body):
							found = assignment_call_name_matches_in_expr(body, expected)
						_:
							void
				else:
					void

			found
		_:
			None


pure func assignment_call_name_matches(program_value: CoreProgram, expected: String) -> Bool:
	var found: Option[Bool] = None

	for decl in program_value.decls:
		match decl:
			FunctionDecl(func_info):
				if func_info.name == "run":
					match func_info.body:
						Some(body):
							found = assignment_call_name_matches_in_expr(body, expected)
						None:
							void
				else:
					void
			_:
				void

	found.get_or(False)


pure func has_old_drop_reassign(name: String, expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(temp, is_mutable, bind_type, rhs, body):
			direct_match: Bool = match body:
				SeqExpr(DropExpr(drop_var, drop_type, release_policy, drop_body, drop_result, drop_loc), AssignExpr(assign_var, VarExpr(assign_rhs, rhs_type, rhs_loc), assign_type, assign_loc)):
					(
						drop_var.name == name
						and assign_var.name == name
						and assign_rhs.name == temp.name
					)
				_:
					False

			direct_match or has_old_drop_reassign(name, rhs) or has_old_drop_reassign(name, body)
		SeqExpr(first, second):
			has_old_drop_reassign(name, first) or has_old_drop_reassign(name, second)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			has_old_drop_reassign(name, body)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			(
				has_old_drop_reassign(name, cond)
				or has_old_drop_reassign(name, then_expr)
				or has_old_drop_reassign(name, else_expr)
			)
		_:
			False


pure func rewrite_expr_body_is_original_param(program_value: CoreProgram) -> Bool:
	match function_body(program_value, "rewrite_expr"):
		Some(VarExpr(variable, _, _)):
			variable.name == "expr"
		_:
			False


pure func function_body(program_value: CoreProgram, name: String) -> Option[CoreExpr]:
	var found: Option[CoreExpr] = None

	for decl in program_value.decls:
		match decl:
			FunctionDecl(func_info):
				if func_info.name == name:
					found = func_info.body
					break
				else:
					void
			_:
				void

	found


---
True when the clone declares `owned_parameter_index` as owned through its
origin and keeps the original body (a record update of the parameter): the
old protocol wrapped the body as `let result = body; drop param; result`.
---
pure func clone_declares_owned_parameter_with_original_body(
	program_value: CoreProgram,
	name: String,
	owned_parameter_index: Int,
) -> Bool:
	var found: Bool = False

	for decl in program_value.decls:
		match decl:
			FunctionDecl(func_info):
				if func_info.name == name:
					declares_owned: Bool = match func_info.origin:
						ConsumingClone(index, _):
							index == owned_parameter_index
						_:
							False
					keeps_body: Bool = match func_info.body:
						Some(body):
							match body:
								LetExpr(_, _, _, _, update):
									match update:
										RecordUpdateExpr(_, _, _, _):
											True
										_:
											False
								_:
									False
						None:
							False

					found = declares_owned and keeps_body
				else:
					void
			_:
				void

	found


pure func add_field_binding(
	name: String,
	field_index: Int,
	mode: CoreMatchBindingMode,
) -> CoreMatchBinding:
	{
		variable = named_var(name),
		typ = expr_type(),
		accessor = VariantFieldAccessor(RootAccessor, "Expr", "Add", field_index),
		mode = mode,
		needs_release = type_requires_release(expr_type())
	}


pure func add_match_case(body: CoreExpr) -> CoreConstructorMatchCase:
	{
		constructor = "Add",
		accessor = RootAccessor,
		test = UnionTagConstructorTest(unspelled_test_variant(), "Expr"),
		bindings = [
			add_field_binding("left", 0, MatchBorrowBindingMode),
			add_field_binding("right", 1, MatchBorrowBindingMode),
		],
		body = ConstructorMatchBodyExpr(body)
	}


pure func test_rewrites_safe_self_replacement_call() -> Bool:
	rewritten: CoreProgram = rewritten_program(update_in_place(7))
	has_functions: Bool = function_names_are(
		rewritten,
		["rewrite_expr", "rewrite_expr__consume_arg0", "run"],
	)
	retargeted_assignment: Bool = assignment_call_name_matches(
		rewritten,
		"rewrite_expr__consume_arg0",
	)
	clone_declares_owned_param: Bool = clone_declares_owned_parameter_with_original_body(
		rewritten,
		"rewrite_expr__consume_arg0",
		0,
	)

	has_functions and retargeted_assignment and clone_declares_owned_param


pure func test_clone_identity_uses_name_and_def_id() -> Bool:
	other: CoreFunction = { rewrite_function(update_in_place(99)) | name = "other_rewrite" }
	source_program: CoreProgram = {
		decls = [
			expr_record_decl(),
			FunctionDecl(other),
			FunctionDecl(rewrite_function(update_in_place(7))),
			FunctionDecl(run_function()),
		],
		foreign_includes = [],
		source_files = []
	}
	rewritten: CoreProgram = rewrite_program_for_test(source_program)

	function_names_are(
		rewritten,
		["other_rewrite", "rewrite_expr", "rewrite_expr__consume_arg0", "run"],
	) and assignment_call_name_matches(rewritten, "rewrite_expr__consume_arg0")


pure func test_later_same_def_id_name_does_not_steal_candidate() -> Bool:
	later_same_id: CoreFunction = { rewrite_function(update_in_place(99)) | name = "later_rewrite" }
	source_program: CoreProgram = {
		decls = [
			expr_record_decl(),
			FunctionDecl(rewrite_function(update_in_place(7))),
			FunctionDecl(later_same_id),
			FunctionDecl(run_function()),
		],
		foreign_includes = [],
		source_files = []
	}
	rewritten: CoreProgram = rewrite_program_for_test(source_program)

	function_names_are(
		rewritten,
		["rewrite_expr", "rewrite_expr__consume_arg0", "later_rewrite", "run"],
	) and assignment_call_name_matches(rewritten, "rewrite_expr__consume_arg0")


pure func test_structurally_different_target_type_does_not_select_candidate() -> Bool:
	other_target: CoreVar = named_var("other_expr")
	other_run: CoreFunction = { run_function() | body = Some(
			LetExpr(
				other_target,
				True,
				other_expr_type(),
				VarExpr(other_target, other_expr_type(), synthetic_core_source_loc()),
				SeqExpr(
					assignment_expr_for_call(
						other_target,
						"rewrite_expr",
						10,
						[VarExpr(other_target, other_expr_type(), synthetic_core_source_loc()), int_expr(1)],
						other_expr_type(),
					),
					VarExpr(other_target, other_expr_type(), synthetic_core_source_loc()),
				),
			),
		) }
	source_program: CoreProgram = {
		decls = [
			expr_record_decl(),
			other_expr_record_decl(),
			FunctionDecl(rewrite_function(update_in_place(7))),
			FunctionDecl(other_run),
		],
		foreign_includes = [],
		source_files = []
	}
	rewritten: CoreProgram = rewrite_program_for_test(source_program)

	function_names_are(
		rewritten,
		["rewrite_expr", "run"],
	) and assignment_call_name_matches(rewritten, "rewrite_expr")


pure func test_clone_id_follows_every_declared_definition_id() -> Bool:
	high_id_enum: CoreEnumDecl = {
		abi_type = None,
		name = "HighId",
		type_params = [],
		variants = [
			{
				name = "High",
				tag = 0,
				def_id = Some(5000)
			},
		],
		loc = synthetic_core_source_loc()
	}
	high_id_impl: CoreImplDecl = {
		trait_name = "HighIdTrait",
		for_type = NamedType("HighIdType", []),
		type_params = [],
		methods = [
			{ rewrite_function(update_in_place(0)) |
				name = "high_id_method",
				def_id = 6000
			},
		],
		loc = synthetic_core_source_loc()
	}
	base: CoreProgram = program(update_in_place(7))
	source_program: CoreProgram = { base |
		decls = [EnumDecl(high_id_enum), ImplDecl(high_id_impl)].concat(base.decls)
	}
	rewritten: CoreProgram = rewrite_program_for_test(source_program)

	function_definition_id(rewritten, "rewrite_expr__consume_arg0") == Some(6001)


pure func test_later_used_candidate_retains_id_reserved_by_unused_candidate() -> Bool:
	left: CoreVar = named_var("left_expr")
	right: CoreVar = named_var("right_expr")
	arg1_assignment: CoreExpr = assignment_expr_for_call(
		right,
		"multi_rewrite",
		30,
		[
			VarExpr(left, expr_type(), synthetic_core_source_loc()),
			VarExpr(right, expr_type(), synthetic_core_source_loc()),
			int_expr(1),
		],
		expr_type(),
	)
	multi_run: CoreFunction = { run_function() |
		body = Some(
			LetExpr(
				left,
				True,
				expr_type(),
				lit_expr(0),
				LetExpr(
					right,
					True,
					expr_type(),
					lit_expr(1),
					SeqExpr(
						arg1_assignment,
						VarExpr(right, expr_type(), synthetic_core_source_loc()),
					),
				),
			),
		)
	}
	source_program: CoreProgram = {
		decls = [
			expr_record_decl(),
			FunctionDecl(multi_rewrite_function(multi_update_in_place())),
			FunctionDecl(multi_run),
		],
		foreign_includes = [],
		source_files = []
	}
	rewritten: CoreProgram = rewrite_program_for_test(source_program)

	function_names_are(
		rewritten,
		["multi_rewrite", "multi_rewrite__consume_arg1", "run"],
	) and function_definition_id(rewritten, "multi_rewrite__consume_arg1") == Some(
		MULTI_REWRITE_SECOND_CLONE_DEF_ID,
	)


pure func test_used_clones_emit_once_in_parameter_order() -> Bool:
	left: CoreVar = named_var("left_expr")
	right: CoreVar = named_var("right_expr")
	use_arg0: CoreExpr = assignment_expr_for_call(
		left,
		"multi_rewrite",
		30,
		[
			VarExpr(left, expr_type(), synthetic_core_source_loc()),
			VarExpr(right, expr_type(), synthetic_core_source_loc()),
			int_expr(1),
		],
		expr_type(),
	)
	use_arg1: CoreExpr = assignment_expr_for_call(
		right,
		"multi_rewrite",
		30,
		[
			VarExpr(left, expr_type(), synthetic_core_source_loc()),
			VarExpr(right, expr_type(), synthetic_core_source_loc()),
			int_expr(1),
		],
		expr_type(),
	)
	repeated_arg0: CoreExpr = assignment_expr_for_call(
		left,
		"multi_rewrite",
		30,
		[
			VarExpr(left, expr_type(), synthetic_core_source_loc()),
			VarExpr(right, expr_type(), synthetic_core_source_loc()),
			int_expr(2),
		],
		expr_type(),
	)
	multi_run: CoreFunction = { run_function() |
		body = Some(
			LetExpr(
				left,
				True,
				expr_type(),
				lit_expr(0),
				LetExpr(
					right,
					True,
					expr_type(),
					lit_expr(1),
					SeqExpr(
						use_arg0,
						SeqExpr(
							use_arg1,
							SeqExpr(
								repeated_arg0,
								VarExpr(right, expr_type(), synthetic_core_source_loc()),
							),
						),
					),
				),
			),
		)
	}
	source_program: CoreProgram = {
		decls = [
			expr_record_decl(),
			FunctionDecl(multi_rewrite_function(multi_update_in_place())),
			FunctionDecl(multi_run),
		],
		foreign_includes = [],
		source_files = []
	}
	rewritten: CoreProgram = rewrite_program_for_test(source_program)

	function_names_are(
		rewritten,
		["multi_rewrite", "multi_rewrite__consume_arg0", "multi_rewrite__consume_arg1", "run"],
	) and function_occurrence_count(
		rewritten,
		"multi_rewrite__consume_arg0",
	) == 1 and function_occurrence_count(rewritten, "multi_rewrite__consume_arg1") == 1


---
A clone that only returns its parameter updates nothing in place, so it would
only add code: `expr = rewrite_expr(expr, 1)` keeps calling the original.
---
pure func test_does_not_clone_without_in_place_update() -> Bool:
	rewritten: CoreProgram = rewritten_program(var_expr("expr", expr_type()))

	(
		function_names_are(rewritten, ["rewrite_expr", "run"])
		and assignment_call_name_matches(rewritten, "rewrite_expr")
	)


---
A helper that hands its parameter to a function without an in-place update
gets no clone either: the benefit is transitive only through clones that
benefit.
---
pure func test_does_not_clone_hand_off_to_clone_without_benefit() -> Bool:
	rewritten: CoreProgram = rewritten_forward_program(
		var_expr("expr", expr_type()),
		rewrite_call_on(var_expr("expr", expr_type()), 1),
	)

	(
		function_names_are(rewritten, ["rewrite_expr", "multi_rewrite", "forward", "run"])
		and function_calls_are(rewritten, "forward", ["rewrite_expr"])
		and assignment_call_name_matches(rewritten, "forward")
	)


---
Self-recursion that never updates its parameter has no benefit: the least
fixpoint does not let a clone qualify through a hand-off to itself.
---
pure func test_does_not_clone_recursion_without_update() -> Bool:
	rewritten: CoreProgram = rewritten_program(rewrite_call_on(var_expr("expr", expr_type()), 2))

	(
		function_names_are(rewritten, ["rewrite_expr", "run"])
		and function_calls_are(rewritten, "rewrite_expr", ["rewrite_expr"])
	)


func test_no_candidate_program_rewrites_identically() -> Bool:
	-- A result type different from the parameter's makes the function
	-- ineligible, so no parameter of any function is a clone candidate.
	source_program: CoreProgram = {
		decls = [
			expr_record_decl(),
			FunctionDecl({
				rewrite_function(var_expr("expr", expr_type())) |
				return_type = other_expr_type()
			}),
			FunctionDecl(run_function()),
		],
		foreign_includes = [],
		source_files = []
	}

	reset_mem_stats()
	rewritten: CoreProgram = rewrite_program_for_test(source_program)
	stats = get_mem_stats()

	equivalent: Bool = function_names_are(
		rewritten,
		["rewrite_expr", "run"],
	) and function_definition_id(
		rewritten,
		"rewrite_expr",
	) == Some(
		10,
	) and function_definition_id(
		rewritten,
		"run",
	) == Some(
		20,
	) and rewrite_expr_body_is_original_param(
		rewritten,
	) and assignment_call_name_matches(rewritten, "rewrite_expr")
	allocations_ok: Bool = stats.total_allocations <= MAX_NO_CANDIDATE_REWRITE_ALLOCATIONS

	if not allocations_ok:
		print("consume specialize no-candidate allocations: ${stats.total_allocations}")
	else:
		void

	equivalent and allocations_ok


pure func test_perceus_consuming_clone_skips_old_assignment_drop() -> Bool:
	perceus: CoreProgram = insert_drops_program(rewritten_program(update_in_place(7)))

	match function_body(perceus, "run"):
		Some(body):
			not has_old_drop_reassign("expr", body)
		None:
			False


