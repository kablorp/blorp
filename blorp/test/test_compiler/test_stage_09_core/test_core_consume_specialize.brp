			FunctionDecl(match_run),
		],
		foreign_includes = [],
		source_files = []
	}
	rewritten: CoreProgram = rewrite_program_for_test(source_program)

	assignment_call_name_matches(rewritten, "rewrite_expr__consume_arg0")


pure func test_rewrites_assignment_nested_in_while() -> Bool:
	loop_run: CoreFunction = { run_function() |
		body = Some(
			LetExpr(
				named_var("expr"),
				True,
				expr_type(),
				lit_expr(0),
