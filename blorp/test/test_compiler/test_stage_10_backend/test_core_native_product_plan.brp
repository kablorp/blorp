pure func test_invalid_native_result_teaches_the_layout_boundary() -> Bool:
	match catalog():
		Some(rows):
			match build_native_product_adapter_plan(rows, [native_call("blorp_dict_entries", NamedType("Int", []))], ops()):
				Err(fault):
					match fault:
						NativeProductCallShapeMismatch(name):
							name == "blorp_dict_entries" and native_product_plan_fault_message(fault).contains("registered product")
						_:
							False
				Ok(_): False
		None: False


