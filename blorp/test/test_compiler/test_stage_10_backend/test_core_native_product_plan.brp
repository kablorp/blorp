private pure func range_row_symbols(typ: CoreType) -> Option[CNativeProductStorageSymbols]:
	if core_type_equal(typ, HeapRecordType("RangeRow")):
		Some({ c_type = "RangeRow*", make_name = "RangeRow_make", members = [Some("f0"), Some("f1")] })
	else:
		None


pure func test_native_tuple_value_projection_keeps_container_elements() -> Bool:
	loc = synthetic_core_source_loc()
	match core_generated_tuple_record_decl("RangeRow", [NamedType("List", [NamedType("Int", [])]), NamedType("Int", [])], loc):
		Ok(row):
			match tuple_storage_catalog({ decls = [GeneratedTupleRecordDecl(row)], foreign_includes = [], source_files = [] }):
				Ok(rows):
					fixture_ops = { ops() | product_symbols = range_row_symbols }
					call = vector_pair_call(NamedType("List", [RangeType]), HeapRecordType("RangeRow"))
					match build_native_product_adapter_plan(rows, [call], fixture_ops):
						Err(NativeProductCallShapeMismatch(name)): name == "blorp_vector_zip"
						_: False
				Err(_): False
		Err(_): False


