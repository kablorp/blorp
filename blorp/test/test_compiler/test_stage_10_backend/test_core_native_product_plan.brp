private pure func vector_pair_call(element: CoreType, pair: CoreType) -> CoreExpr:
	CallExpr(
		BuiltinCall("blorp_vector_zip"),
		VoidExpr(VoidType, synthetic_core_source_loc()),
		[typed_input(NamedType("Vector", [element])), typed_input(NamedType("Vector", [NamedType("Int", [])]))],
		NamedType("Vector", [pair]),
		synthetic_core_source_loc(),
	)


