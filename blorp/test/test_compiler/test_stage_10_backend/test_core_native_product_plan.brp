import:
	../test_support_core_native_product: native_process_product_fixture
	../../../src/compiler/stage_09_core/ir:
		CoreBinderOrigin(AuthoredBinder),
		CoreCallKind(BuiltinCall, DirectRuntimeCall, OperationResultCall),
		CoreDecl(GeneratedTupleRecordDecl, TypeAliasDecl),
		CoreDirectRuntimeArgs(DirectRuntimeArgsAsWritten),
		CoreDirectRuntimeResult(DirectRuntimeResultAsWritten),
		CoreDictIterationMode(CoreDictIterationKeys, CoreDictIterationEntries),
		CoreExpr(CallExpr, ForDictExpr, SeqExpr, VarExpr, VoidExpr),
		CoreLoopRangeDirection(RangeMayRunBackward),
		CoreOperationResultBridge,
		CoreOperationResultLayoutPolicy(DefaultResultLayoutPolicy),
		CoreRuntimeSuccessPayload(RuntimeField),
		CoreReleasePolicy(NoReleasePolicy),
		CoreType(BoxedResultType, FunctionType, HeapRecordType, NamedType, RangeType, StackResultType, VoidType),
		CoreTupleStorageCatalog,
		core_generated_tuple_record_decl,
		core_generated_tuple_record_elements,
		generated_tuple_record_for_type,
		core_type_equal,
		synthetic_core_source_loc,
		tuple_storage_catalog,
	../../../src/compiler/stage_10_backend/emit_tuple_product_adapters:
		CNativeProductFactoryKind(DictionaryEntryProductFactory, EnumeratedProductFactory, ProcessOutputProductFactory, VectorPairProductFactory),
		CNativeProductStorageSymbols,
		CRuntimeProductAdapterOps,
		CUnfoldProductResultRepresentation(NullableUnfoldProductResult, BoxedUnfoldProductResult),
	../../../src/compiler/stage_10_backend/emit_tuple_product_plan:
		CNativeProductPlanFault(NativeProductCallShapeMismatch, NativeProductCanonicalRowUnavailable),
		build_native_product_adapter_plan,
		native_product_adapter_declarations,
		native_product_factory_callback,
		native_unfold_product_callback,
		native_product_plan_fault_message,
	test: TestSuite


private pure func catalog() -> Option[CoreTupleStorageCatalog]:
	match core_generated_tuple_record_decl("Pair", [NamedType("Int", []), NamedType("Int", [])], synthetic_core_source_loc()):
		Ok(row):
			match tuple_storage_catalog({ decls = [GeneratedTupleRecordDecl(row)], foreign_includes = [], source_files = [] }):
				Ok(value): Some(value)
				Err(_): None
		Err(_): None


private pure func ops() -> CRuntimeProductAdapterOps:
	symbols: pure (CoreType) -> Option[CNativeProductStorageSymbols] = func(typ):
		if core_type_equal(typ, HeapRecordType("Pair")):
			Some({ c_type = "Pair*", make_name = "Pair_make", members = [Some("f0"), Some("f1")] })
		else:
			None
	{
		c_type = func(typ): "long",
		resolve_product_type = func(typ): Some(typ),
		product_symbols = symbols,
		decode_borrowed_slot = func(typ, value): Some("decode(" + value + ")"),
		encode_owned_slot = func(typ, value): Some("encode(" + value + ")"),
		read_vector_element = func(typ, vector, index): Some("read(" + vector + ", " + index + ")"),
		retain_typed = func(typ, value): Some(""),
	}


private pure func typed_input(typ: CoreType) -> CoreExpr:
	VarExpr({ name = "input", id = 1, def_id = None, origin = AuthoredBinder }, typ, synthetic_core_source_loc())


private pure func native_call(name: String, result: CoreType) -> CoreExpr:
	input_type = if name == "blorp_dict_entries":
		NamedType("Dict", [NamedType("Int", []), NamedType("Int", [])])
	else:
		NamedType("Stream", [NamedType("Int", [])])
	CallExpr(BuiltinCall(name), VoidExpr(VoidType, synthetic_core_source_loc()), [typed_input(input_type)], result, synthetic_core_source_loc())


pure func test_repeated_pair_calls_share_one_factory() -> Bool:
	match catalog():
		Some(rows):
			call = native_call("blorp_dict_entries", NamedType("List", [HeapRecordType("Pair")]))
			match build_native_product_adapter_plan(rows, [call, call], ops()):
				Ok(plan):
					match native_product_factory_callback(plan, DictionaryEntryProductFactory, HeapRecordType("Pair")):
						Ok(callback):
							(
								native_product_adapter_declarations(plan).split(callback + "(").length() == 2
								and native_product_adapter_declarations(plan).contains("static inline void* " + callback)
							)
						Err(_): False
				Err(_): False
		None: False


pure func test_pair_factories_keep_native_signatures_distinct() -> Bool:
	match catalog():
		Some(rows):
			calls = [
				native_call("blorp_dict_entries", NamedType("List", [HeapRecordType("Pair")])),
				native_call("blorp_stream_enumerate", NamedType("Stream", [HeapRecordType("Pair")])),
			]
			match build_native_product_adapter_plan(rows, calls, ops()):
				Ok(plan):
					match native_product_factory_callback(plan, DictionaryEntryProductFactory, HeapRecordType("Pair")):
						Ok(dictionary):
							match native_product_factory_callback(plan, EnumeratedProductFactory, HeapRecordType("Pair")):
								Ok(enumeration): dictionary != enumeration
								Err(_): False
						Err(_): False
				Err(_): False
		None: False


