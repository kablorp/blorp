pure func test_process_outputs_plan_the_success_payload_in_every_result_layout() -> Bool:
	match core_generated_tuple_record_decl("ProcessOutput", [NamedType("String", []), NamedType("String", []), NamedType("Int", [])], synthetic_core_source_loc()):
		Ok(row):
			match tuple_storage_catalog({ decls = [GeneratedTupleRecordDecl(row)], foreign_includes = [], source_files = [] }):
				Ok(rows):
					success = HeapRecordType("ProcessOutput")
					error = NamedType("String", [])
					results: List[CoreType] = [NamedType("Result", [success, error]), StackResultType(success, error), BoxedResultType(success, error)]
					calls = results.map(func(result): CallExpr(BuiltinCall("blorp_process_shell"), VoidExpr(VoidType, synthetic_core_source_loc()), [typed_input(NamedType("String", []))], result, synthetic_core_source_loc()))
					symbols: pure (CoreType) -> Option[CNativeProductStorageSymbols] = func(typ):
						if core_type_equal(typ, success):
							Some({ c_type = "Output*", make_name = "Output_make", members = [Some("f0"), Some("f1"), Some("f2")] })
						else:
							None
					fixture_ops = { ops() | product_symbols = symbols }
					match build_native_product_adapter_plan(rows, calls, fixture_ops):
						Ok(plan): native_product_factory_callback(plan, ProcessOutputProductFactory, success).is_ok()
						Err(_): False
				Err(_): False
		Err(_): False


