import:
	../../../src/compiler/stage_02_lex/lexer: lex
	../../../src/compiler/stage_02_lex/name_table: SYNTHESIZED_NAME_TABLE
	../../../src/compiler/stage_03_parse/source_ast_finalize: finalized_typecheck_program_ast
	../../../src/compiler/stage_06_typecheck/decl: TypecheckProgramResult
	../../../src/compiler/stage_06_typecheck/state:
		TYPECHECK_USER_ORIGIN,
		typecheck_state_for_origin,
	../../../src/compiler/stage_06_typecheck/typed_name_identity:
		NameIdentityCensus,
		name_identity_census_violations,
		typed_program_name_identity_census,
	../../../src/lib/source: SourceFile, source_file
	../typecheck_test_support: finalized_typecheck_program_fixture, typecheck_test_program
	test: TestSuite


SAMPLE_SOURCE: String = "func add(left: Int, right: Int) -> Int:\n\ttotal = left + right\n\ttotal\n"


func test_typed_program_identifiers_resolve_to_their_own_spelling() -> Bool:
	finalized = finalized_typecheck_program_fixture("sample.brp", "sample", SAMPLE_SOURCE)
	parsed = finalized_typecheck_program_ast(finalized)
	-- A single-file fixture's ids index the table its own lex builds from the
	-- synthesized vocabulary.
	names = lex(parsed.source, SYNTHESIZED_NAME_TABLE).names
	checked: TypecheckProgramResult = typecheck_test_program(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		parsed,
	)
	census: NameIdentityCensus = typed_program_name_identity_census(names, checked.program)

	(
		checked.state.errors.is_empty()
		and census.resolved >= 5
		and name_identity_census_violations(census) == 0
	)


func test_typed_program_census_counts_ids_from_another_table_as_violations() -> Bool:
	finalized = finalized_typecheck_program_fixture("sample.brp", "sample", SAMPLE_SOURCE)
	parsed = finalized_typecheck_program_ast(finalized)
	other_names = lex(source_file("other.brp", "other", "unrelated"), SYNTHESIZED_NAME_TABLE).names
	checked: TypecheckProgramResult = typecheck_test_program(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		parsed,
	)

	name_identity_census_violations(typed_program_name_identity_census(other_names, checked.program)) > 0


tests: TestSuite = {
	description = "Typed program name identity census",
	tests = [
		(
			"typed program identifiers resolve to their own spelling",
			test_typed_program_identifiers_resolve_to_their_own_spelling,
		),
		(
			"typed program census counts ids from another table as violations",
			test_typed_program_census_counts_ids_from_another_table_as_violations,
		),
	]
}
