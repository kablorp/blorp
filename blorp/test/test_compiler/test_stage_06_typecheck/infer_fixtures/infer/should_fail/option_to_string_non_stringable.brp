-- EXPECT: error: Type Wrap[NotStringable] does not implement trait Stringable (from traits) (required by to_string)
-- to_string on generic type should fail when T is not Stringable
union Wrap[T]:
	W(T)


union NotStringable:
	NS(Int)


implements Stringable for Wrap[T:Stringable]:
	pure func to_string(w: Wrap[T]) -> String:
		match w:
			W(v):
				to_string(v)


-- ERROR: NotStringable does not implement Stringable
func test_non_stringable() -> String:
	x: Wrap[NotStringable] = W(NS(42))
	to_string(x)
