-- EXPECT: error: Constructor Red belongs to type Color, not Shape
-- TEST: Should fail - using constructor from different union type
-- Red belongs to Color, not Shape
union Color:
	Red
	Blue


union Shape:
	Circle(Int)
	Square(Int, Int)


func test(s: Shape) -> Int:
	match s:
		Red: 0
		Circle(r): r
		Square(w, h): w + h


func main(args: List[String]) -> Int:
	test(Circle(5))
