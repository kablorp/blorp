-- EXPECT: error: Binding `as_strings` declared as `List[String]` but initializer has type `List[U]`
-- RUN-BLORP-CHECK
-- A closure parameter typed with the enclosing U does not instantiate U
-- afresh: passing anything() to it solves T to the rigid U, so the later
-- String annotation is a mismatch.
pure func anything[T]() -> List[T]:
	[]


func same_as[U](sample: U) -> Int:
	keep = func(items: List[U]) -> List[U]:
		items.append(sample)

	value = anything()
	kept = keep(value)
	as_strings: List[String] = value
	as_strings.length()


func main(args: List[String]) -> Int:
	same_as(1)
