-- EXPECT-CONTAINS: `Listener` cannot be a Dict key because it does not implement Hashable at
-- EXPECT: help: Dict keys and Set elements are compared by value, so `Listener` must implement Equatable and Hashable over the same fields: `implements Equatable for Listener` (define `equals`) and `implements Hashable for Listener` (define `hash`, for example `hash_combine(self.x.hash(), self.y.hash())`)
-- RUN-BLORP-CHECK
-- A record with a function field does not derive Equatable, so a key of that
-- type needs both implementations.
record Listener {
	id: Int,
	notify: (Int) -> Int
}


func main(args: List[String]) -> Int:
	listener: Listener = { id = 0, notify = func(value): value }
	counts: Dict[Listener, Int] = {listener => 1}
	counts.length()
