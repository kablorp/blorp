-- EXPECT-CONTAINS: `Point` cannot be a Dict key because it does not implement Hashable at
-- EXPECT: help: Dict keys and Set elements are compared by value, so `Point` must implement Hashable consistently with its `==`: `implements Hashable for Point` (define `hash`, for example `hash_combine(self.x.hash(), self.y.hash())`)
-- RUN-BLORP-CHECK
-- A Dict literal does not go through a bounded Dict function, so its key type
-- is checked where the literal is written.
record Point {
	x: Int,
	y: Int
}


func main(args: List[String]) -> Int:
	origin: Point = { x = 0, y = 0 }
	counts: Dict[Point, Int] = {origin => 1}
	counts.length()
