-- EXPECT: error: Argument type mismatch: in call to 'filter_strings', argument 1 ('predicate') expected (String) -> Bool, got (Int) -> Bool
-- TEST: Should fail - Function with wrong parameter type cannot be passed
-- Passing (Int) -> Bool where (String) -> Bool is expected
-- blorp enforces invariant function types (no variance)
func filter_strings(predicate: (String) -> Bool, s: String) -> Bool:
	predicate(s)


func is_positive(n: Int) -> Bool:
	n > 0


func main(args: List[String]) -> Int:
	result: Bool = filter_strings(is_positive, "hello")
	print(to_string(result))
	-- Error: is_positive expects Int, but filter_strings needs (String) -> Bool
	0
