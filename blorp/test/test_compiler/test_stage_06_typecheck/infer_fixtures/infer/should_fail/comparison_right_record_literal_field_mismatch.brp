-- EXPECT: error: Record field 'value': expected Int, got String at blorp/test/test_compiler/test_stage_06_typecheck/infer_fixtures/infer/should_fail/comparison_right_record_literal_field_mismatch.brp:24:18
-- EXPECT-NOT-CONTAINS: Ambiguous record literal
-- RUN-BLORP-CHECK
-- The left operand types the record literal on the right, so a wrong field
-- value is reported against the left operand's record, not as an ambiguity.
record Plain {
	value: Int
}


implements Equatable for Plain:
	pure func equals(a: Plain, b: Plain) -> Bool:
		a.value == b.value


record Other {
	value: Int
}


func main(args: List[String]) -> Int:
	plain: Plain = {value = 0}

	if plain == {value = "x"}:
		1
	else:
		0
