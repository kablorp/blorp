-- EXPECT: error: Argument type mismatch: in call to 'test', argument 1 ('x') expected T, got String
-- Test: A union named [T] declared AFTER a function that references it
-- must still be treated as that concrete type: a function declares its type
-- parameters in brackets, so `T` here can only be the union.
func test(x: T) -> Int:
	match x:
		Wrap(n):
			n


union T:
	Wrap(Int)


func main(args: List[String]) -> Int:
	test("hello")
