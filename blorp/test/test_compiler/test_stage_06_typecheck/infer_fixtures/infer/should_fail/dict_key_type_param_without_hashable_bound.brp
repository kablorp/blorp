-- EXPECT: error: Type parameter K does not have bound Hashable (required by set)
-- EXPECT: help: Dict keys and Set elements are compared by value, so add the bound where `K` is declared: `[K: Hashable]`
-- RUN-BLORP-CHECK
-- Generic code that inserts into a Dict must declare that its key type is
-- Hashable, like a sort needs Orderable.
pure func remember[K, V](seen: Dict[K, V], key: K, value: V) -> Dict[K, V]:
	seen.set(key, value)


