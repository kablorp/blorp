-- RUN-BLORP-CHECK
-- The first field solves the record's type argument, so a second field of a
-- different type is reported against it.
record Pair[T] {
	first: T,
	second: T
}


func main(args: List[String]) -> Int:
	pair = {
		first = 1,
		second = "b"
	}
	0
