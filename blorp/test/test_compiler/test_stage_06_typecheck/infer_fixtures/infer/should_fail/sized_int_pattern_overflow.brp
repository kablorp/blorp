-- Literal 300 is out of range for Int8 (-128 to 127)
-- EXPECT: error: Integer literal 300 does not fit in Int8
-- EXPECT: help: Int8 holds -128 to 127; use a value in that range or a wider type such as Int16
-- RUN-BLORP-CHECK
func test_overflow(x: Int8) -> Int:
	match x:
		300: 1
		_: 0


