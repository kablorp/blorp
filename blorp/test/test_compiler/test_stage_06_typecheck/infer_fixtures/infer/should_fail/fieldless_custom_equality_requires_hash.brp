-- EXPECT: error: Type OrdinaryKey does not implement trait Hashable (required by hash)
-- EXPECT: error: Type FixedKey does not implement trait Hashable (required by hash)
-- EXPECT-CONTAINS: `OrdinaryKey` cannot be a Dict key because it does not implement Hashable at
-- EXPECT-CONTAINS: `FixedKey` cannot be a Dict key because it does not implement Hashable at
-- EXPECT: error: Type OrdinaryKey does not implement trait Hashable (required by hash_bound)
-- EXPECT: help: Dict keys and Set elements are compared by value, so `OrdinaryKey` must implement Hashable consistently with its `==`: `implements Hashable for OrdinaryKey` (define `hash`, for example `hash_combine(self.x.hash(), self.y.hash())`)
-- EXPECT: help: Dict keys and Set elements are compared by value, so `FixedKey` must implement Hashable consistently with its `==`: `implements Hashable for FixedKey` (define `hash`, for example `hash_combine(self.x.hash(), self.y.hash())`)
-- RUN-BLORP-CHECK
-- Tag hashing is not compatible with an authored equality relation.
union OrdinaryKey:
	OrdinaryFirst
	OrdinarySecond


fixed union FixedKey:
	FixedFirst
	FixedSecond


implements Equatable for OrdinaryKey:
	pure func equals(left: OrdinaryKey, right: OrdinaryKey) -> Bool:
		True

	pure func not_equals(left: OrdinaryKey, right: OrdinaryKey) -> Bool:
		False


implements Equatable for FixedKey:
	pure func equals(left: FixedKey, right: FixedKey) -> Bool:
		True

	pure func not_equals(left: FixedKey, right: FixedKey) -> Bool:
		False


pure func ordinary_hash() -> Int:
	OrdinaryFirst.hash()


pure func fixed_hash() -> Int:
	FixedFirst.hash()


pure func ordinary_dict_key() -> Dict[OrdinaryKey, Int]:
	{OrdinaryFirst => 9}


pure func fixed_dict_key() -> Dict[FixedKey, Int]:
	{FixedFirst => 9}


pure func hash_bound[T: Hashable](value: T) -> Int:
	value.hash()


pure func ordinary_hash_bound() -> Int:
	hash_bound(OrdinaryFirst)
