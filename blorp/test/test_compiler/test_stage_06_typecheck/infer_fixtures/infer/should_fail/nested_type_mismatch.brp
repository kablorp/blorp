import:
	option: Option(Some, None)


-- EXPECT: error: Binding `str_opt` declared as `Option[String]` but initializer has type `Option[Int]`
-- RUN-BLORP-CHECK
-- TEST: Should fail - Nested generic type parameter mismatch
-- Option[Int] cannot be assigned to Option[String]
-- List[Option[Int]] cannot be assigned to List[Option[String]]
-- ERROR: Option[Int] assigned to Option[String]
func test_option_type_mismatch() -> Int:
	int_opt: Option[Int] = Some(42)
	str_opt: Option[String] = int_opt
	0
