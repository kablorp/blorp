-- EXPECT: error: Cannot iterate over type ParallelList[Int]. For-in loops work with Channel, Dict, List, Vector, Set, Stream, String, and Range types
-- RUN-BLORP-CHECK
func bad(xs: List[Int]) -> List[Int]:
	xs.parallel(pure func(chunk: ParallelList[Int]):
		for x in chunk:
			_ = x
		chunk.map(pure func(x: Int): x)
	)
