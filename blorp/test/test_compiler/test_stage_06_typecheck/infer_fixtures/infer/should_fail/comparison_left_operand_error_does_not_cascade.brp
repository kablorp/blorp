-- EXPECT: error: Unbound value `missing_value`
-- EXPECT-NOT-CONTAINS: Cannot use record literal for type
-- RUN-BLORP-CHECK
-- A left operand that fails to infer gives the right operand no expected type,
-- so the record literal on the right reports nothing of its own.
record Plain {
	value: Int
}


func main(args: List[String]) -> Int:
	if missing_value == {value = 1}:
		1
	else:
		0
