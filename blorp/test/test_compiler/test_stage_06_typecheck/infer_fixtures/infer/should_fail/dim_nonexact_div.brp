-- EXPECT: error: Argument type mismatch: in call to 'needs_triple', argument 1 ('v') expected ?m0[?m1 * #3], got Int[#7]
-- #N * 3 = 7 has no integer solution (7 is not a multiple of 3)
pure func needs_triple[T, #N](v: T[#N * #3]) -> Int:
	length(v)


pure func test() -> Int:
	needs_triple({1, 2, 3, 4, 5, 6, 7})
