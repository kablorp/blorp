import:
	option: Option(Some, None)


-- EXPECT: error: Argument type mismatch: in call to 'process_string_opts', argument 1 ('opts') expected List[Option[String]], got List[Option[Int]]
-- TEST: Should fail - Nested generic type parameter mismatch in lists
-- List[Option[Int]] cannot be assigned to List[Option[String]]
-- ERROR: List[Option[Int]] passed where List[Option[String]] expected
func process_string_opts(opts: List[Option[String]]) -> Int:
	length(opts)


func test_nested_list_type_mismatch() -> Int:
	opt1: Option[Int] = Some(1)
	opt2: Option[Int] = Some(2)
	int_opts: List[Option[Int]] = [opt1, opt2]
	result: Int = process_string_opts(int_opts)
	result
-- This should fail: List[Option[Int]] != List[Option[String]]
