-- EXPECT: error: Type Point does not implement trait Hashable (required by add)
-- RUN-BLORP-CHECK
-- The element type of `set()` is inferred from the chained `add`; the bound is
-- checked against that solved type.
import:
	set as S


record Point {
	x: Int,
	y: Int
}


func main(args: List[String]) -> Int:
	origin: Point = { x = 0, y = 0 }
	S.set().add(origin).length()
