-- Test: bare-name trait-method call dispatches on the first-argument type.
-- `describe(a)` where `a: Animal` and `impl Describable for Animal` must
-- resolve to the Animal-specific method, not fail with "no function".
trait Describable:
	pure func describe(value: Self) -> String


record Animal {
	name: String,
	legs: Int
}


implements Describable for Animal:
	pure func describe(value: Animal) -> String:
		"${value.name} has ${value.legs} legs"


func main(args: List[String]) -> Int:
	a: Animal = {
		name = "cat",
		legs = 4
	}
	msg: String = describe(a)
	if msg == "cat has 4 legs":
		0
	else:
		1
