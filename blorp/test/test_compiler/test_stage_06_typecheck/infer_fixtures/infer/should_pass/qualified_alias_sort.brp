-- Test: Qualified module alias calls dispatch correctly
-- Regression test for sort via aliased import (was generating bad C function name)
import:
	list as L


func main(args: List[String]) -> Int:
	ints: List[Int] = L.sort([3, 1, 2])
	floats: List[Float] = L.sort([3.0, 1.0, 2.0])
	strings: List[String] = L.sort(["c", "a", "b"])
	n: Int = L.length(ints)
	n
