import:
	tensor: set_all


-- Named dim sharing: dim type param in sig's param and return must
-- resolve consistently to the concrete literal at the call site.
-- (Originally tested #Ds... sharing via set_all; set_all was narrowed
-- to 1D in Phase 2.7 because the body only typechecks for 1D, so this
-- now exercises the simpler #N case. Variadic-#Ds sharing via other
-- stdlib functions, e.g. assert_shape, is covered by runtime tests.)
func main(args: List[String]) -> Int:
	v: Int[#3] = {1, 2, 3}
	result: Int[#3] = set_all(v, 0)
	result.length()
