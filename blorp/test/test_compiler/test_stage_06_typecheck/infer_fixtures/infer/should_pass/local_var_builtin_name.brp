-- Current behaviour: an annotated local binding may reuse the name of an outer
-- function (length, add, etc.) and shadows it inside this body. Shadowing is to
-- be rejected (owner decision: a binding may not reuse a name that is already
-- visible, whether an outer function, builtin, import, global or local); this
-- fixture moves to should_fail when that rule is implemented.
func main(args: List[String]) -> Int:
	length: Int = 42
	add: Int = 5
	sub: Int = 3
	length + add + sub
