-- Test: nested fixed record (fixed record containing another fixed record)
fixed record Point {
	x: Float,
	y: Float
}


fixed record Rect {
	origin: Point,
	size: Point
}


func main(args: List[String]) -> Int:
	r: Rect = {
		origin = {
			x = 0.0,
			y = 0.0
		},
		size = {
			x = 10.0,
			y = 5.0
		}
	}
	0
