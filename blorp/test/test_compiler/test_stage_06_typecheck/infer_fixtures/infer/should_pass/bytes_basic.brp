import:
	bytes as B


-- Test that Bytes type works in annotations, function params/returns
pure func make_buffer(size: Int) -> Bytes:
	B.bytes(size)


pure func get_first(b: Bytes) -> Option[Int]:
	B.get(b, 0)


pure func roundtrip(s: String) -> String:
	b: Bytes = s.to_bytes()
	B.to_string(b)


func main(args: List[String]) -> Int:
	buf: Bytes = make_buffer(10)
	print(to_string(B.length(buf)))
	0
