-- TEST: Should pass - match expression type checking
-- Test utilities
func test_section(name: String) -> Void:
	print("")
	print("=== " + name + " ===")


func assert_eq_int(actual: Int, expected: Int, message: String) -> Void:
	match actual == expected:
		True: print("  PASS: " + message)
		False: print("  FAIL: " + message)


-- Tests
func main(args: List[String]) -> Int:
	print("Match Expression Type Checking")
	test_section("Boolean Match")
	x: Int = 10
	result: String = match x > 5:
		True: "greater"
		False: "not greater"
	match result == "greater":
		True: print("  PASS: Boolean match returns correct type")
		False: print("  FAIL: Boolean match failed")
	test_section("Integer Match")
	num: Int = 42
	category: Int = match num:
		0: 1
		1: 2
		42: 3
		_: 4
	assert_eq_int(category, 3, "Integer match returns correct value")
	test_section("Match Returns Consistent Type")
	value: Int = 5
	result2: Int = match value > 0:
		True: 1
		False: 0
	assert_eq_int(result2, 1, "Match returns consistent type")
	print("")
	print("PASS: All match expression tests completed")
	0
