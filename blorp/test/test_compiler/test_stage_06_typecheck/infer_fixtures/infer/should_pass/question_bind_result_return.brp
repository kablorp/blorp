import:
	result: Result(Ok, Err)


pure func parse_id(text: String) -> Result[Int, String]:
	Ok(42)


pure func load_name(id: Int) -> Result[String, String]:
	Ok("user")


pure func load_user(text: String) -> Result[String, String]:
	id ?= parse_id(text)
	load_name(id)


