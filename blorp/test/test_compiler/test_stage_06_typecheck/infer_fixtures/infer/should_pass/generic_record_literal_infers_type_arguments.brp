-- RUN-BLORP-CHECK
-- A record literal with no expected type that names a generic record by its
-- fields infers the type arguments from the field values.
record Wrap[T] {
	value: T
}


record Pair[T] {
	first: T,
	second: T
}


pure func unwrap(wrapped: Wrap[Int]) -> Int:
	wrapped.value


func main(args: List[String]) -> Int:
	wrapped = {value = 3}
	pair = {
		first = "a",
		second = "b"
	}

	if unwrap(wrapped) == 3 and pair.second == "b":
		0
	else:
		1
