-- UFCS overload resolution should keep the selected list.get overload.
-- Regression: the selected UFCS callee was later re-resolved through the
-- bare overload set and could pick string.get, producing Option[Char].
import:
	json: JsonValue(JsonNull, JsonVector)


func main(args: List[String]) -> Int:
	match JsonVector([JsonNull]):
		JsonVector(items):
			got: Option[JsonValue] = items.get(0)
			0
		_: 1
