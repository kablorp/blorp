-- Compound dim expressions with proper precedence
-- (#N + 1) * 2 should parse as multiplication of (#N + 1) by 2
pure func padded_double[T, #N](v: T[(#N + #1) * #2]) -> Int:
	length(v)


pure func test_padded() -> Int:
	padded_double({1, 2, 3, 4, 5, 6})


-- Chained multiplication: #N * 2 * 3 should parse as (#N * 2) * 3
pure func triple_scale[T, #N](v: T[#N * #2 * #3]) -> Int:
	length(v)


pure func test_triple() -> Int:
	triple_scale({1, 2, 3, 4, 5, 6})


-- Mixed: #N * 2 + 1 should parse as (#N * 2) + 1
pure func scale_plus[T, #N](v: T[#N * #2 + #1]) -> Int:
	length(v)


pure func test_scale_plus() -> Int:
	scale_plus({1, 2, 3, 4, 5, 6, 7})
