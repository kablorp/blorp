-- Matrix cell get/get_or and tensor first-dimension get/get_or should coexist.
-- Resolution is type- and arity-directed, not name-split by API spelling.
import:
	matrix: get, get_or
	tensor: get as tensor_get, get_or as tensor_get_or


func main(args: List[String]) -> Int:
	m: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	cell: Int = match get(m, 1, 0):
		Some(v): v
		None: -1
	fallback_cell: Int = m.get_or(9, 9, -2)

	xs: Int[#3] = {5, 6, 7}
	first_opt: Option[Int] = tensor_get(xs, 0)
	first: Int = tensor_get_or(xs, 0, -3)

	match first_opt:
		Some(f):
			if (
				cell == 3
				and fallback_cell == -2
				and f == 5
				and first == 5
			):
				0
			else:
				1
		None: 1
