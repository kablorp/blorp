-- Test: same-type arithmetic on sized integers
func main(args: List[String]) -> Int:
	a: Int8 = 10
	b: Int8 = 20
	c: Int8 = a + b
	d: Int8 = a - b
	e: Int8 = a * b
	f: Int8 = a / b
	g: Int8 = a % b
	x: UInt32 = 100
	y: UInt32 = 50
	z: UInt32 = x + y
	p: Int16 = 5
	q: Int16 = 3
	r: Bool = p > q
	s: Bool = p == q
	0
