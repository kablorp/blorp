-- Tests that division involving to_float() and record field access
-- correctly dispatches to float division (not integer division).
-- Regression test for bug where to_float(record.field) in a complex
-- expression like pi * to_float(x) / to_float(record.field) would
-- use integer division instead of float division.
record Config {
	count: Int,
	rate: Float
}


func compute(config: Config) -> Float:
	pi: Float = 3.14159
	result: Float = pi * to_float(2) / to_float(config.count)
	result


func main(args: List[String]) -> Int:
	0
-- This expression must use float division, not integer division
