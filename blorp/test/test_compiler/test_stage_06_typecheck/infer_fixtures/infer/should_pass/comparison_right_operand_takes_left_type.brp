-- RUN-BLORP-CHECK
-- A comparison checks its right operand against the left operand's type, so a
-- record literal on the right needs no annotation: it takes the generic
-- record's type arguments, and it is not ambiguous with a namesake record. An
-- empty list on the right takes the left operand's element type the same way.
record Wrap[T] {
	value: T
}


implements Equatable for Wrap[T:Equatable]:
	pure func equals(a: Wrap[T], b: Wrap[T]) -> Bool:
		a.value == b.value


record Plain {
	value: Int
}


implements Equatable for Plain:
	pure func equals(a: Plain, b: Plain) -> Bool:
		a.value == b.value


record Rank[T] {
	key: T
}


implements Equatable for Rank[T:Orderable]:
	pure func equals(a: Rank[T], b: Rank[T]) -> Bool:
		a.key == b.key


implements Orderable for Rank[T:Orderable]:
	pure func less_than(a: Rank[T], b: Rank[T]) -> Bool:
		a.key < b.key


func main(args: List[String]) -> Int:
	wrapped: Wrap[Int] = {value = 1}
	plain: Plain = {value = 0}
	rank: Rank[Int] = {key = 1}
	numbers: List[Int] = [1]
	equal = wrapped == {value = 1} and plain == {value = 0}
	ordered = rank < {key = 2} and rank >= {key = 1}

	if (
		equal
		and wrapped != {value = 2}
		and ordered
		and numbers != []
	):
		0
	else:
		1
