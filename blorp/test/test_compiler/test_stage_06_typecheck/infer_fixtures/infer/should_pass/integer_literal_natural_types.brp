-- Integer literal natural type inference.
-- Positive non-zero Int-sized literals keep singleton dimension types.
-- Zero and negative literals remain plain Int.
func main(args: List[String]) -> Int:
	small = 123
	small_dim: #123 = small
	small_int: Int = small
	small_int64: Int64 = small
	wide = 23423342342234
	wide_dim: #23423342342234 = wide
	wide_int: Int = wide
	zero = 0
	zero_int: Int = zero
	negative = -123
	negative_int: Int = negative
	explicit_small: Int8 = 123
	explicit_small
	0
