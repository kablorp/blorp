-- NAME_RESOLUTION.md §4.2: M.name resolves to a symbol exported by a
-- qualified-import module. Here D is the alias for dict.
import:
	dict as D: Dict
	option: Option(Some, None)


func lookup(d: Dict[String, Int], key: String) -> Option[Int]:
	D.get(d, key)


func main(args: List[String]) -> Int:
	d: Dict[String, Int] = {"one" => 1}

	match lookup(d, "one"):
		Some(v):
			print("${v}")
		None:
			print("missing")

	0
