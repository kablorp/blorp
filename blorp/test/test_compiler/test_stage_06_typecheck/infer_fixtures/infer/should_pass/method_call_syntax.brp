-- Method-call syntax: obj.method(args) rewrites to method(obj, args) in inference
func double(x: Int) -> Int:
	x * 2


pure func add(a: Int, b: Int) -> Int:
	a + b


func main(args: List[String]) -> Int:
	x: Int = 5
	y: Int = x.double()
	z: Int = x.add(3)
	0
-- Method call on primitive: x.double()
-- Method call with args: a.add(b)
