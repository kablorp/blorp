-- Comprehensive tests for canonical-form dimension solving
-- These test cases require the generalized algebraic solver.
-- ============================================================================
-- Category 1: Symmetric operations (unknown on right of - and /)
-- ============================================================================
-- c - #N = concrete → #N = c - concrete
pure func needs_sub_right[T, #N](v: T[#10 - #N]) -> Int:
	length(v)


pure func test_sub_right() -> Int:
	needs_sub_right({1, 2, 3})


-- c / #N = concrete → #N = c / concrete
pure func needs_div_right[T, #N](v: T[#12 / #N]) -> Int:
	length(v)


pure func test_div_right() -> Int:
	needs_div_right({1, 2, 3})


-- ============================================================================
-- Category 2: Nested generic calls (DimOp = DimOp symbolic solving)
-- ============================================================================
-- Inner expects #N + 1, outer provides #M + 2 → #N = #M + 1
pure func inner_a[T, #N](v: T[#N + #1]) -> Int:
	length(v)


pure func outer_a[T, #M](v: T[#M + #2]) -> Int:
	inner_a(v)


pure func test_nested_a() -> Int:
	outer_a({1, 2, 3, 4, 5})


-- Inner expects #N + 3, outer provides #M + 5 → #N = #M + 2
pure func inner_b[T, #N](v: T[#N + #3]) -> Int:
	length(v)


pure func outer_b[T, #M](v: T[#M + #5]) -> Int:
	inner_b(v)


pure func test_nested_b() -> Int:
	outer_b({1, 2, 3, 4, 5, 6, 7, 8})


-- Three levels of nesting: c calls b calls a, each adding 1
pure func level_a[T, #N](v: T[#N + #1]) -> Int:
	length(v)


pure func level_b[T, #N](v: T[#N + #2]) -> Int:
	level_a(v)


pure func level_c[T, #N](v: T[#N + #3]) -> Int:
	level_b(v)


pure func test_three_levels() -> Int:
	level_c({1, 2, 3, 4, 5, 6})


-- ============================================================================
-- Category 3: Commutativity (the canonical form should handle)
-- ============================================================================
-- #N + #M should match #M + #N
pure func commutative_add[T, #N, #M](a: T[#N + #M], b: T[#M + #N]) -> Int:
	length(a) + length(b)


-- ============================================================================
-- Category 4: Compound expressions
-- ============================================================================
-- #N * 2 + 1 = 7 → #N = 3
pure func compound_mul_add[T, #N](v: T[#N * #2 + #1]) -> Int:
	length(v)


pure func test_compound() -> Int:
	compound_mul_add({1, 2, 3, 4, 5, 6, 7})


-- ============================================================================
-- Category 5: Return type with solved dims
-- ============================================================================
-- Solved dim flows correctly into return type
pure func identity_plus1[T, #N](v: T[#N + #1]) -> T[#N + #1]:
	v


pure func test_return_type() -> Int:
	r: Int[#5] = identity_plus1({1, 2, 3, 4, 5})
	length(r)


-- ============================================================================
-- Category 6: Multiple params with dim arithmetic
-- ============================================================================
pure func multi_arith[T, #N, #M](a: T[#N + #1], b: T[#M * #2]) -> Int:
	length(a) + length(b)


pure func test_multi() -> Int:
	multi_arith({1, 2, 3}, {1, 2, 3, 4})


-- ============================================================================
-- Category 7: Division and subtraction solving
-- ============================================================================
-- #N / 3 = 4 → #N = 12
pure func div_solve[T, #N](v: T[#N / #3]) -> Int:
	length(v)


pure func test_div() -> Int:
	div_solve({1, 2, 3, 4})


-- #N - 2 = 5 → #N = 7
pure func sub_solve[T, #N](v: T[#N - #2]) -> Int:
	length(v)


pure func test_sub() -> Int:
	sub_solve({1, 2, 3, 4, 5})
