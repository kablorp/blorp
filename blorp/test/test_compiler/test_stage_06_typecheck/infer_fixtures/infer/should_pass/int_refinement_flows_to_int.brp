trait Mergeable:
	pure func merge_vals(a: Self, b: Self) -> Self


implements Mergeable for Int:
	pure func merge_vals(a: Int, b: Int) -> Int:
		a + b


func takes_int(x: Int) -> Int:
	x


func main(args: List[String]) -> Int:
	x = 123
	y: Int = takes_int(x)
	z: Int = shift_left(1, 8)
	w: Int = merge_vals(10, 20)
	concurrent(timeout: 500):
		a = y + z + w
	0
