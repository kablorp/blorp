-- Test tensor scalar broadcasting type-checks
func test_broadcast(v: Int[#3], s: Int) -> Bool:
	a: Int[#3] = v + s
	b: Int[#3] = v - s
	c: Int[#3] = v * s
	d: Int[#3] = v / s
	e: Int[#3] = s + v
	f: Int[#3] = s - v
	g: Int[#3] = s * v
	h: Int[#3] = s / v
	True


func test_broadcast_float(v: Float[#3], s: Float) -> Bool:
	r: Float[#3] = v * s
	True
-- Both directions, all 4 ops
