-- Hashable: Equatable. A function bound by `T: Hashable` must also
-- accept Equatable operations (==/!=) on T values without requiring
-- the caller to spell both bounds. Mirrors how `T: Orderable`
-- transitively satisfies Equatable (the inheritance path the
-- uniform-trait-inheritance machinery was built for).
pure func same_hash[T:Hashable](a: T, b: T) -> Bool:
	if a == b:
		a.hash() == b.hash()
	else:
		True


func main(args: List[String]) -> Int:
	if same_hash(42, 42):
		0
	else:
		1
