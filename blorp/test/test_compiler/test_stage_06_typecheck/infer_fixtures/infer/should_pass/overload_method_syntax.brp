-- Method syntax with qualified imports.
-- xs.get(0) desugars to list_get(xs, 0) when get is imported as list_get.
-- UFCS also works: xs.get(0) resolves via the type of xs.
import:
	list: contains as list_contains, get as list_get


func test_method_get(xs: List[Int]) -> Option[Int]:
	list_get(xs, 0)


func test_method_contains(xs: List[Int]) -> Bool:
	list_contains(xs, 42)
