-- TEST: UFCS resolves multiple methods via first-arg type with only type import
import:
	list: List


func main(args: List[String]) -> Int:
	data: List[Int] = [3, 1, 2]
	filtered: List[Int] = data.filter(func(x: Int): x > 1)
	sorted: List[Int] = data.sort()
	reversed: List[Int] = data.reverse()
	taken: List[Int] = data.take(2)
	dropped: List[Int] = data.drop(1)
	appended: List[Int] = data.append(4)
	length(
		filtered,
	) + length(sorted) + length(reversed) + length(taken) + length(dropped) + length(appended)
