-- Bug 5: UFCS method calls inside ?= bindings should resolve correctly
-- Previously leaked internal __ufcs_list__get identifier
import:
	list: List
	option: Option(Some, None)
	string: parse_int


func get_second(items: List[String]) -> Option[Int]:
	s ?= items.get(1)
	n ?= parse_int(s)
	Some(n)


func main(args: List[String]) -> Int:
	0
