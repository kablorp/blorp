-- Multi-character type parameters must keep their bounds when forwarded
-- through generic callees. This guards the TyNamed-vs-type-param ambiguity
-- in callee trait-bound checks.
pure func stringify[Item:Stringable](value: Item) -> String:
	to_string(value)


pure func stringify_wrapper[Element:Stringable](value: Element) -> String:
	stringify(value)


pure func same_equatable[Value:Equatable](left: Value, right: Value) -> Bool:
	left == right


pure func same_hashable[Payload:Hashable](left: Payload, right: Payload) -> Bool:
	same_equatable(left, right)


func main(args: List[String]) -> Int:
	match stringify_wrapper(42) == "42" and same_hashable(7, 7):
		True: 0
		False: 1
