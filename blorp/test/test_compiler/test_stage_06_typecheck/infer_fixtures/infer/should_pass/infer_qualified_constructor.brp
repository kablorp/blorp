-- Test: qualified constructor value (`O.None`) and qualified constructor
-- call (`O.Some(42)`) through a module alias. The typechecker must accept
-- both in expression AND pattern positions — module aliases don't carry
-- runtime values, so the alias identifier itself is never read.
import:
	option as O


func test_qualified_expr() -> Bool:
	x: Option[Int] = O.Some(42)
	match x:
		Some(v): v == 42
		None: False


func test_qualified_pattern() -> Bool:
	x: Option[Int] = Some(100)
	match x:
		O.Some(v): v == 100
		O.None: False


func test_nullary_qualified() -> Bool:
	x: Option[Int] = O.None
	match x:
		O.Some(_): False
		O.None: True


func main(args: List[String]) -> Int:
	if (
		test_qualified_expr()
		and test_qualified_pattern()
		and test_nullary_qualified()
	):
		0
	else:
		1
