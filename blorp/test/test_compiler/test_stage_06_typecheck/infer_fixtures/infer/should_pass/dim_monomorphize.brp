-- Dim vars should monomorphize: different dim values produce different specializations
-- This enables compile-time constant folding of lengths and bounds elimination
-- Basic: T and #N both monomorphized
pure func first[T, #N](v: T[#N]) -> T:
	v[0]


pure func test_basic() -> Int:
	a: Int = first({1, 2, 3})
	b: Int = first({10, 20, 30, 40, 50})
	a + b


-- Dim arithmetic in signature
pure func second[T, #N](v: T[#N + #1]) -> T:
	v[1]


pure func test_arith() -> Int:
	second({1, 2, 3})


-- Multiple dim vars
pure func dot2[#M, #N](a: Int[#M], b: Int[#N]) -> Int:
	a[0] * b[0]


pure func test_multi_dim() -> Int:
	dot2({1, 2, 3}, {4, 5})


-- Matrix dims
pure func mat_elem[T, #M, #N](m: T[#M, #N]) -> T:
	m[0, 0]


pure func test_matrix() -> Int:
	mat_elem({
			{1, 2},
			{3, 4},
			{5, 6},
		})


-- Dim-only generic (no type param T)
pure func vec_len[#N](v: Int[#N]) -> Int:
	length(v)


pure func test_dim_only() -> Int:
	vec_len({1, 2, 3})
