-- NAME_RESOLUTION.md §4.7: binary operators desugar to trait calls.
-- `+` requires Addable; a type parameter bound T: Addable satisfies it.
-- Here Int satisfies Addable via a builtin impl (env_builtins), so calling
-- sum([1,2,3]) typechecks.
pure func sum[T:Addable](xs: List[T], zero: T) -> T:
	var total: T = zero
	for x in xs:
		total += x
	total


func main(args: List[String]) -> Int:
	s: Int = sum([1, 2, 3], 0)
	if s == 6:
		0
	else:
		1
