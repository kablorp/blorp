-- Compiler test: checked_get / checked_set / checked_slice type inference
func test_checked_get_literal() -> Int:
	v: Int[#5] = {10, 20, 30, 40, 50}
	checked_get(v, 0)


func test_checked_get_float() -> Float:
	v: Float[#3] = {1.5, 2.5, 3.5}
	checked_get(v, 1)


func test_checked_set() -> Int[#3]:
	v: Int[#3] = {1, 2, 3}
	checked_set(v, 0, 99)


func test_checked_slice() -> Int[#2]:
	v: Int[#5] = {10, 20, 30, 40, 50}
	checked_slice(v, 1, 3)


func test_checked_get_2d() -> Int[#3]:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	checked_get(m, 0)


func test_matrix_checked_get() -> Int:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	matrix_checked_get(m, 0, 1)


func test_subscript_desugar() -> Int:
	v: Int[#3] = {10, 20, 30}
	v[1]


func test_subscript_assign_desugar() -> Int:
	var v: Int[#3] = {10, 20, 30}
	v[0] = 99
	v[0]


func test_range_desugar() -> Int[#2]:
	v: Int[#5] = {10, 20, 30, 40, 50}
	v[1..3]


func test_multi_index_desugar() -> Int:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	m[1, 2]
