private pure func typed_function_body_trait_identity(
	program: TypedProgram,
	name: String,
) -> Option[BoundTraitIdentity]:
	var result: Option[BoundTraitIdentity] = None

	for decl in program.decls:
		match decl:
			TypedFunctionDecl(info):
				if info.decl.name.text == name:
					match info.body:
						Some(body):
							result = typed_expr_resolved_call(
								body,
							).and_then(
								func(call): call.trait_identity,
							)
						None:
							void

					break
			_:
				void

	result


private pure func definition_table_find_trait_id(
	definition_table: DefinitionTable,
	module_id: ModuleId,
	name: String,
	next_definition_id: Int,
) -> Option[TraitId]:
	var result: Option[TraitId] = None
	var definition_id: Int = 0

	while definition_id < next_definition_id:
		match trait_id_from_definition_table(definition_table, definition_id):
			Some(trait_id):
				if (
					trait_id_module_id(definition_table, trait_id) == Some(module_id)
					and trait_id_name(definition_table, trait_id) == name
				):
					result = Some(trait_id)
					break
			None:
				void

		definition_id += 1

	result


private pure func typed_function_body_callee_call_module_path(
	definition_table: DefinitionTable,
	program: TypedProgram,
	name: String,
) -> Option[String]:
	var result: Option[String] = None

	for decl in program.decls:
		match decl:
			TypedFunctionDecl(info):
				if info.decl.name.text == name:
					match info.body:
						Some(body):
							result = typed_expr_callee_call_module_path(definition_table, body)
						None:
							void

					break
			_:
				void

	result


private pure func typed_module_program(
	module_table: ModuleTable,
	modules: List[TypecheckedModule],
	module_path: String,
) -> Option[TypedProgram]:
	modules
		.find(
			pure func(
				module,
			): module_table_canonical_path(module_table, module.module_id) == Some(module_path),
		)
		.map(pure func(module): module.typed_program)


private pure func typed_impl_method_callable_id(
	program: TypedProgram,
	trait_name: String,
	method_name: String,
) -> Option[Int]:
	var result: Option[Int] = None

	for decl in program.decls:
		match decl:
			TypedImplDecl(info):
				if info.decl.trait_name.text == trait_name:
					match info.methods.find(func(method): method.decl.name.text == method_name):
						Some(method):
							result = method.callable_id
						None:
							void

					break
			_:
				void

	result


private pure func typed_union_constructor_id(
	program: TypedProgram,
	type_name: String,
	constructor_name: String,
) -> Option[Int]:
	var result: Option[Int] = None

	for decl in program.decls:
		match decl:
			TypedUnionDecl(info):
				if info.decl.name.text == type_name:
					match info.variants.find(func(variant): variant.name == constructor_name):
						Some(variant):
							result = variant.def_id
						None:
							void

					break
			_:
				void

	result


private pure func deterministic_definition_id_request() -> TypecheckGraphRequest:
	{
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = "import:\n\tutil\n\nfunc main(args: List[String]) -> Int:\n\tutil.answer()",
			typecheck_program = None,
			module_surface = None,
			origin = UserModule
		},
		modules = [
			{
				path = "util.brp",
				module_name = "util",
				module_path = "util",
				text = "union Signal:\n\tReady\n\npure func answer() -> Int:\n\t42",
				typecheck_program = None,
				module_surface = None,
				origin = UserModule
			},
		],
		module_targets = ["util"],
		resolved_imports = [
			{
				from_path = "main.brp",
				from_module = "main",
				import_path = "util",
				resolved_module = "util"
			},
		],
		allow_debug_only_calls = False
	}


func test_typed_graph_definition_ids_are_deterministic() -> Bool:
	first = typecheck_graph(deterministic_definition_id_request())
	second = typecheck_graph(deterministic_definition_id_request())

	match (
		typed_module_program(first.module_table, first.modules, "util"),
		typed_module_program(second.module_table, second.modules, "util"),
	):
		(Some(first_util), Some(second_util)):
			first_main = typed_function_callable_id(first.target.typed_program, "main")
			second_main = typed_function_callable_id(second.target.typed_program, "main")
			first_answer = typed_function_callable_id(first_util, "answer")
			second_answer = typed_function_callable_id(second_util, "answer")
			first_call = typed_function_body_call_id(first.target.typed_program, "main")
			second_call = typed_function_body_call_id(second.target.typed_program, "main")
			first_ready = typed_union_constructor_id(first_util, "Signal", "Ready")
			second_ready = typed_union_constructor_id(second_util, "Signal", "Ready")

			(
				first.next_def_id == second.next_def_id
				and first_main.is_some()
				and first_answer.is_some()
				and first_call.is_some()
				and first_ready.is_some()
				and first_main == second_main
				and first_answer == second_answer
				and first_call == second_call
				and first_ready == second_ready
			)
		_:
			False


