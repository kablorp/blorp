func test_trait_authority_metrics_use_record_storage() -> Bool:
	trait_metrics: AcceptedTraitImplementationAuthorityMetrics = {
		accepted_trait_table_entries = 0,
		accepted_implementation_table_entries = 0,
		accepted_trait_semantic_conversions = 0,
		accepted_implementation_semantic_conversions = 0,
		accepted_qualified_implementation_method_rows = 0,
		accepted_compiler_implementation_links = 0,
		module_view_trait_indices = 0,
		module_view_implementation_indices = 0
	}

	same_object(trait_metrics, trait_metrics)


pure func test_ctfe_eager_bound_attempts_have_planned_invocations() -> Bool:
	(
		ctfe_eager_bound_attempt_invocation(DirectEagerBoundAttempt) == 0
		and ctfe_eager_bound_attempt_invocation(EagerBoundAfterArtifactAttempt) == 1
	)


private OPTION_MODULE_TEXT: String = "union Option[T]:\n\tSome(T)\n\tNone"

private CTFE_REACHABILITY_TRACKED_GROWTH_NUMERATOR: Int = 11

private CTFE_REACHABILITY_TRACKED_GROWTH_DENOMINATOR: Int = 5


pure func typecheck_program_fixture(
	path: String,
	module_name: String,
	source: String,
) -> FinalizedTypecheckProgram:
	TypecheckTestSupport.finalized_typecheck_program_fixture(path, module_name, source)


pure func typecheck_import_module_fixture(
	module_path: String,
	source: String,
) -> TypecheckImportModule:
	path = module_path + ".brp"
	{
		path = path,
		module_name = module_path,
		module_path = module_path,
		text = source,
		typecheck_program = Some(typecheck_program_fixture(path, module_path, source)),
		module_surface = None,
		origin = UserModule
	}


pure func typed_program_global_int(program: TypedProgram, name: String) -> Option[String]:
	var result: Option[String] = None

	for decl in program.decls:
		match decl:
			TypedGlobalVarDecl(info):
				if info.decl.name.text == name:
					match info.value:
						TypedIntLiteralExpr(text, _, _):
							result = Some(text)
						_:
							void
			_:
				void

	result


pure func typechecked_module_global_int(module: TypecheckedModule, name: String) -> Option[String]:
	typed_program_global_int(typechecked_module_program_with_ctfe_replacements(module), name)


pure func import_module(
	module_path: String,
	module_name: String,
	text: String,
	origin: ModuleOrigin,
) -> TypecheckImportModule:
	{
		path = module_name + ".brp",
		module_name = module_name,
		module_path = module_path,
		text = text,
		typecheck_program = None,
		module_surface = None,
		origin = origin
	}


pure func std_import_module(
	module_path: String,
	module_name: String,
	text: String,
) -> TypecheckImportModule:
	import_module(module_path, module_name, text, StdlibModule)


pure func user_import_module(
	module_path: String,
	module_name: String,
	text: String,
) -> TypecheckImportModule:
	import_module(module_path, module_name, text, UserModule)


pure func source_package_import_module(
	module_path: String,
	module_name: String,
	package: String,
	text: String,
) -> TypecheckImportModule:
	import_module(module_path, module_name, text, SourcePackageModule(package))


pure func resolved_import(
	from_path: String,
	from_module: String,
	import_path: String,
	resolved_module: String,
) -> TypecheckResolvedImport:
	{
		from_path = from_path,
		from_module = from_module,
		import_path = import_path,
		resolved_module = resolved_module
	}


func typecheck_modules_with_resolved_imports(
	target: TypecheckImportModule,
	modules: List[TypecheckImportModule],
	module_targets: List[String],
	resolved_imports: List[TypecheckResolvedImport],
) -> TypecheckedGraph:
	typecheck_graph({
		target = target,
		modules = modules,
		module_targets = module_targets,
		resolved_imports = resolved_imports,
		allow_debug_only_calls = False,
	})


func typecheck_modules(
	target: TypecheckImportModule,
	modules: List[TypecheckImportModule],
	module_targets: List[String],
) -> TypecheckedGraph:
	typecheck_modules_with_resolved_imports(target, modules, module_targets, [])


func typecheck_modules_with_metrics(
	target: TypecheckImportModule,
	modules: List[TypecheckImportModule],
	module_targets: List[String],
) -> TypecheckGraphRun:
	typecheck_graph_with_metrics({
		target = target,
		modules = modules,
		module_targets = module_targets,
		resolved_imports = [],
		allow_debug_only_calls = False,
	})


-- Dependency modules the CTFE preparation scanned: the selected modules scan
-- only what they import, and an unrelated module is never scanned.
pure func ctfe_dependency_module_count(run: TypecheckGraphRun) -> Int:
	(
		run.ctfe.selective_dependency_modules
		+ run.ctfe.eager_dependency_modules
		+ run.ctfe.failed_dependency_modules
	)


func typecheck_modules_allowing_debug_only_calls(
	target: TypecheckImportModule,
) -> TypecheckedGraph:
	typecheck_graph({
		target = target,
		modules = [],
		module_targets = [],
		resolved_imports = [],
		allow_debug_only_calls = True,
	})


-- A single module named `main`, checked with `imports` available as context but
-- not themselves checked.
func typecheck_source(source: String, imports: List[TypecheckImportModule]) -> TypecheckedGraph:
	typecheck_modules(user_import_module("main", "main", source), imports, [])


pure func accepted_module(module: TypecheckedModule) -> Bool:
	module.errors.is_empty()


pure func errors_contain(errors: List[String], needle: String) -> Bool:
	errors.any(func(error): error.contains(needle))


pure func import_binding_exists(
	definition_table: DefinitionTable,
	bindings: List[ImportBinding],
	local_name: String,
	module_path: String,
	original_name: Option[String],
) -> Bool:
	module_table = definition_table_module_table(definition_table)

	bindings.any(func(binding):
		match binding:
			GraphQualifiedModuleBinding(name, module_id):
				(
					name == local_name
					and module_table_canonical_path(module_table, module_id) == Some(module_path)
					and original_name == None
				)
			StandaloneQualifiedModuleBinding(name, path):
				name == local_name and path == module_path and original_name == None
			GraphSelectiveDefinitionBinding(name, module_id, definition_ids):
				(
					name == local_name
					and module_table_canonical_path(module_table, module_id) == Some(module_path)
					and definition_table_selective_definition_name(
						definition_table,
						module_id,
						definition_ids,
					) == original_name
				)
			GraphSelectiveTraitMethodBinding(name, module_id, source_name, _):
				(
					name == local_name
					and module_table_canonical_path(module_table, module_id) == Some(module_path)
					and Some(source_name) == original_name
				)
			StandaloneSelectiveDefinitionBinding(name, path, source_name):
				name == local_name and path == module_path and Some(source_name) == original_name
	)


pure func typed_function_info(program: TypedProgram, name: String) -> Option[TypedFunctionInfo]:
	var result: Option[TypedFunctionInfo] = None

	for decl in program.decls:
		match decl:
			TypedFunctionDecl(info):
				if info.decl.name.text == name:
					result = Some(info)
					break
			TypedPrivateDecl(TypedFunctionDecl(info)):
				if info.decl.name.text == name:
					result = Some(info)
					break
			_:
				void

	result


pure func typed_global_match_binds_name_pattern(program: TypedProgram, name: String) -> Bool:
	var result: Bool = False

	for decl in program.decls:
		match decl:
			TypedGlobalVarDecl(info):
				if info.decl.name.text == name:
					match info.value:
						TypedMatchExpr(_, cases, _, _):
							result = cases.all(func(case):
								match case.pattern:
									TypedNamePattern(_, _):
										True
									_:
										False
							)
						_:
							void

					break
			_:
				void

	result


-- The imported opaque type keeps its owning module in the semantic type, so
-- `Duration` renders owner-qualified wherever it is used.
pure func record_field_type_text(
	program: TypedProgram,
	record_name: String,
	field_name: String,
) -> Option[String]:
	var result: Option[String] = None

	for decl in program.decls:
		match decl:
			TypedRecordDecl(info):
				if info.decl.name.text == record_name:
					result = info.fields
						.find(func(field): field.name == field_name)
						.map(func(field): type_to_string(field.semantic_type))
					break
			_:
				void

	result


pure func final_match_scrutinee_type_text(program: TypedProgram, function_name: String) -> Option[String]:
	info ?= typed_function_info(program, function_name)
	body ?= info.body

	match body:
		TypedBlockExpr(items, _, _):
			last ?= items.get(items.length() - 1)

			match last:
				TypedMatchExpr(scrutinee, _, _, _):
					Some(type_to_string(typed_expr_semantic_type(scrutinee)))
				_:
					None
		_:
			None


pure func typed_function_body_resolved_call(
	program: TypedProgram,
	name: String,
) -> Option[ResolvedCallInfo]:
	info ?= typed_function_info(program, name)
	body ?= info.body
	typed_expr_resolved_call(body)


pure func typed_function_body_has_alias_source(
	program: TypedProgram,
	function_name: String,
	callee_name: String,
	source_name: String,
) -> Bool:
	match typed_function_body_resolved_call(program, function_name):
		Some(call):
			call.callee_name == callee_name and call.source_name == source_name
		None:
			False


pure func typed_function_body_calls_trait_method_in_module(
	definition_table: DefinitionTable,
	program: TypedProgram,
	function_name: String,
	callee_name: String,
	impl_module_path: String,
) -> Bool:
	match typed_function_body_resolved_call(program, function_name):
		Some(call):
			impl_callable_id = match call.target:
				ResolvedAcceptedTraitMethodCall(_, callable_id):
					Some(callable_id)
				ResolvedSelectedTraitMethodCall(_, callable_id):
					Some(callable_id)
				_:
					None

			call.callee_name == callee_name and impl_callable_id
				.and_then(func(callable_id): callable_id_module_id(definition_table, callable_id))
				.and_then(
					func(
						module_id,
					): module_table_canonical_path(definition_table_module_table(definition_table), module_id),
				) == Some(impl_module_path)
		None:
			False


pure func typed_expr_cleanup_function(expr: TypedExpr) -> Option[String]:
	match expr:
		TypedWithExpr(binding, _, _, _):
			binding.cleanup_function
		TypedBlockExpr(items, _, _):
			items.find(func(item): typed_expr_cleanup_function(item).is_some()).and_then(typed_expr_cleanup_function)
		_:
			None


pure func typed_function_body_cleanup_function(program: TypedProgram, name: String) -> Option[String]:
	info ?= typed_function_info(program, name)
	body ?= info.body
	typed_expr_cleanup_function(body)


pure func typed_program_impl_methods(program: TypedProgram) -> List[TypedFunctionInfo]:
	var result: List[TypedFunctionInfo] = []

	for decl in program.decls:
		match decl:
			TypedImplDecl(info):
				result = info.methods
				break
			_:
				void

	result


pure func ctfe_reachability_chain_module(index: Int, module_count: Int) -> TypecheckImportModule:
	module_name = "reachability_" + index.to_string()
	value_name = "value_" + index.to_string()

	source = if index + 1 < module_count:
		next_module_name = "reachability_" + (index + 1).to_string()
		next_value_name = "value_" + (index + 1).to_string()
		"import:\n\t" + next_module_name + ": " + next_value_name + "\n\n" + value_name + ": Int = " + next_value_name
	else:
		value_name + ": Int = 42"

	path = module_name + ".brp"

	{
		path = path,
		module_name = module_name,
		module_path = module_name,
		text = source,
		typecheck_program = Some(typecheck_program_fixture(path, module_name, source)),
		module_surface = None,
		origin = UserModule
	}


func ctfe_reachability_chain_tracked_allocation_count(module_count: Int) -> (Int, Bool):
	var modules: List[TypecheckImportModule] = []
	var module_targets: List[String] = []

	for index in 0..module_count:
		module = ctfe_reachability_chain_module(index, module_count)
		modules = modules.append(module)
		module_targets = module_targets.append(module.module_path)

	target_source: String =
		|import:
		|	reachability_0: value_0
		|
		|answer: Int = value_0
	target_path = "reachability_target.brp"
	target: TypecheckImportModule = {
		path = target_path,
		module_name = "reachability_target",
		module_path = "reachability_target",
		text = target_source,
		typecheck_program = Some(
			typecheck_program_fixture(
				target_path,
				"reachability_target",
				target_source,
			),
		),
		module_surface = None,
		origin = UserModule
	}

	reset_mem_stats()
	graph = typecheck_graph({
		target = target,
		modules = modules,
		module_targets = module_targets,
		resolved_imports = [],
		allow_debug_only_calls = False,
	})
	stats = get_mem_stats()
	valid = (
		graph.target.errors.length() == 0
		and graph.modules.length() == module_count
		and graph.modules.all(func(module): module.errors.length() == 0)
	)

	(stats.total_allocations, valid)


func test_typecheck_graph_target_reachability_has_bounded_tracked_allocation_growth() -> Bool:
	shallow = ctfe_reachability_chain_tracked_allocation_count(8)
	deep = ctfe_reachability_chain_tracked_allocation_count(16)
	-- This guards the former recursive visited-path allocation growth. Native
	-- Dict backing arrays are outside MemStats and are covered by the compiler
	-- instruction benchmark instead.
	bounded = deep[0] * CTFE_REACHABILITY_TRACKED_GROWTH_DENOMINATOR <= shallow[0] * CTFE_REACHABILITY_TRACKED_GROWTH_NUMERATOR

	if not bounded:
		print(
			"typecheck target reachability allocations: shallow=" + shallow[0].to_string() + " deep=" + deep[0].to_string(),
		)

	shallow[1] and deep[1] and bounded


func test_typecheck_source_returns_typed_program() -> Bool:
	source: String = "func identity(value: Int) -> Int:\n\tvalue"
	module = typecheck_source(source, []).target

	(
		module.errors.is_empty()
		and module.typed_program.diagnostics.is_empty()
		and module.typed_program.decls.length() == 1
		and typed_function_info(module.typed_program, "identity").is_some()
	)


func test_typecheck_graph_returns_selected_modules_then_target() -> Bool:
	dep = user_import_module(
		"dep",
		"dep",
		"pure func answer() -> Int:\n\t41\n\nfunc main() -> String:\n\t\"dependency main\"",
	)
	unused = user_import_module(
		"unused",
		"unused",
		"pure func unused_value() -> Int:\n\t0",
	)
	context = user_import_module(
		"context",
		"context",
		"pure func context_value() -> Int:\n\t0",
	)
	target = user_import_module(
		"main",
		"main",
		"import:\n\tdep: answer\n\nfunc main(args: List[String]) -> Int:\n\tanswer()",
	)

	graph = typecheck_modules(target, [dep, unused, context], ["unused", "dep"])
	target_bindings = graph.target.import_bindings

	match graph.modules:
		[unused_module, dep_module]:
			(
				unused_module.errors.is_empty()
				and dep_module.errors.is_empty()
				and graph.target.errors.is_empty()
				and typechecked_module_path(unused_module) == "unused.brp"
				and typechecked_module_path(dep_module) == "dep.brp"
				and target_bindings.length() == 1
				and import_binding_exists(
					graph.definition_table,
					target_bindings,
					"answer",
					"dep",
					Some("answer"),
				)
			)
		_:
			False


func test_typecheck_graph_evaluates_target_global_from_dependency_global() -> Bool:
	dependency = user_import_module(
		"dependency",
		"dependency",
		"answer: Int = 41\n\nfunc main() -> String:\n\t\"dependency main\"",
	)
	target = user_import_module(
		"main",
		"main",
		"import:\n\tdependency: answer\n\nfinal_answer: Int = answer",
	)

	run = typecheck_modules_with_metrics(target, [dependency], ["dependency"])
	graph = run.graph

	match graph.modules:
		[dependency_module]:
			(
				dependency_module.errors.is_empty()
				and dependency_module.ctfe_evaluated
				and graph.target.errors.is_empty()
				and typechecked_module_global_int(graph.target, "final_answer") == Some("41")
				and run.ctfe.retained_ctfe_module_reuses == 1
			)
		_:
			False


func test_typecheck_graph_handles_shared_import_context() -> Bool:
	base = user_import_module("base", "base", "pure func answer() -> Int:\n\t41")
	left = user_import_module(
		"left",
		"left",
		"import:\n\tbase: answer\n\npure func left_value() -> Int:\n\tanswer()",
	)
	right = user_import_module(
		"right",
		"right",
		"import:\n\tbase: answer\n\npure func right_value() -> Int:\n\tanswer() + 1",
	)
	target_text: String =
		|import:
		|	left: left_value
		|	right: right_value
		|
		|func main(args: List[String]) -> Int:
		|	left_value() + right_value()
	target = user_import_module("main", "main", target_text)

	graph = typecheck_modules(target, [base, left, right], ["left", "right"])

	(
		graph.target.errors.is_empty()
		and graph.modules.length() == 2
		and graph.modules.all(accepted_module)
	)


func test_typecheck_graph_preserves_qualified_trait_method_resolution() -> Bool:
	traits = std_import_module(
		"traits",
		"traits",
		"trait Stringable:\n\tpure func to_string(value: Self) -> String",
	)
	slice_source: String =
		|import:
		|	traits: Stringable
		|
		|type StringSlice = builtin
		|
		|implements Stringable for StringSlice:
		|	pure func to_string(value: StringSlice) -> String:
		|		builtin("slice.to_string")
	slice = std_import_module("slice", "slice", slice_source)
	subject_source: String =
		|import:
		|	slice as S
		|
		|pure func render(value: S.StringSlice) -> String:
		|	S.to_string(value)
	subject = user_import_module("subject", "subject", subject_source)
	target = user_import_module(
		"main",
		"main",
		"func main(args: List[String]) -> Int:\n\t0",
	)

	graph = typecheck_modules(target, [traits, slice, subject], ["subject"])

	match graph.modules:
		[subject_module]:
			(
				subject_module.errors.is_empty()
				and typed_function_body_calls_trait_method_in_module(
					graph.definition_table,
					subject_module.typed_program,
					"render",
					"to_string",
					"slice",
				)
			)
		_:
			False


func test_typecheck_graph_refines_unannotated_generic_factory() -> Bool:
	dep_source: String =
		|opaque type Cache[K, V] = (K, V)
		|
		|pure func cache[K, V](capacity: Int) -> Cache[K, V]:
		|	builtin("test_store")
		|
		|pure func put[K, V](store: Cache[K, V], key: K, value: V) -> Cache[K, V]:
		|	builtin("test_put")
	dep = user_import_module("store_factory", "store_factory", dep_source)
	target_source: String =
		|import:
		|	store_factory as C: Cache
		|
		|func use_store() -> Bool:
		|	var store = C.cache(10)
		|	store = C.put(store, "answer", 42)
		|	True
	target = user_import_module("main", "main", target_source)

	graph = typecheck_modules(target, [dep], [])

	graph.target.errors.is_empty()


