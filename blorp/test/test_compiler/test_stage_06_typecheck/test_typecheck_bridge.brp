		and graph.target.errors.contains(
			"duplicate canonical module identity 'app': 'main.brp' and 'copy.brp'",
		)
	)


private func ambiguous_source_name_graph(modules: List[TypecheckImportModule]) -> TypecheckedGraph:
	typecheck_graph({
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "app",
			text = "import:\n\tshared as Shared\n\nfunc main(args: List[String]) -> Int:\n\t0",
			typecheck_program = None,
			module_surface = None,
			origin = UserModule
		},
		modules = modules,
		module_targets = [],
		resolved_imports = [],
		allow_debug_only_calls = False,
	})


func test_typed_graph_rejects_ambiguous_source_name_independent_of_order() -> Bool:
	left: TypecheckImportModule = {
		path = "left.brp",
		module_name = "shared",
		module_path = "pkg/left",
		text = "pure func left() -> Int:\n\t1",
		typecheck_program = None,
		module_surface = None,
		origin = UserModule
	}
	right: TypecheckImportModule = {
		path = "right.brp",
		module_name = "shared",
		module_path = "pkg/right",
		text = "pure func right() -> Int:\n\t2",
		typecheck_program = None,
		module_surface = None,
		origin = UserModule
	}
	left_first = ambiguous_source_name_graph([left, right])
	right_first = ambiguous_source_name_graph([right, left])
	expected = "module 'shared' is ambiguous; it matches 'pkg/left' and 'pkg/right'"

	(
		left_first.target.errors == right_first.target.errors
		and left_first.target.errors.contains(expected)
	)


