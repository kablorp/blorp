private func typed_graph_retains_trait_topology_diagnostic_spans() -> Option[Bool]:
	graph = typecheck_graph({
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = "trait Broken[T: MissingBound]: MissingParent:\n\tpure func broken(self: Self) -> Int",
			typecheck_program = None,
			module_surface = None,
			origin = UserModule
		},
		modules = [],
		module_targets = [],
		resolved_imports = [],
		allow_debug_only_calls = False,
	})
	first ?= graph.target.diagnostics.get(0)
	second ?= graph.target.diagnostics.get(1)
	first_span ?= first.span
	second_span ?= second.span
	source_table = source_table_for_file(graph.target.typed_program.source)
	first_materialized = source_location_span(source_table, first_span)
	second_materialized = source_location_span(source_table, second_span)
	Some(
		(
			first.message.contains("unknown supertrait 'MissingParent'")
			and first_materialized.path == "main.brp"
			and first_materialized.start_line == 1
			and first_materialized.start_column == 32
			and second.message.contains("unknown bound 'MissingBound'")
			and second_materialized.path == "main.brp"
			and second_materialized.start_line == 1
			and second_materialized.start_column == 17
		),
	)


func test_typed_graph_retains_trait_topology_diagnostic_spans() -> Bool:
	typed_graph_retains_trait_topology_diagnostic_spans().get_or(False)


