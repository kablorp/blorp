		and run.ctfe.retained_ctfe_module_reuses == 0
	)


func test_typecheck_graph_evaluates_dependency_beside_support_importing_target() -> Bool:
	support_source: String =
		|import:
		| main: Marker
	support = user_import_module("support", "support", support_source)
	dependency_source: String =
		|answer: Int = 42
		|
		|pure func preserve[T](value: T) -> T:
		| value
	dependency = user_import_module("dependency", "dependency", dependency_source)
	target_source: String =
		|import:
		| dependency: answer
		|
		|record Marker {value: Int}
		|
		|final_answer: Int = answer
	target = std_import_module("main", "main", target_source)

	run = typecheck_modules_with_metrics(target, [support, dependency], ["dependency"])
	graph = run.graph

	(
		graph.modules.all(accepted_module)
		and graph.target.errors.is_empty()
		and graph.target.ctfe_evaluated
		and typechecked_module_global_int(graph.target, "final_answer") == Some("42")
		and run.ctfe.retained_ctfe_module_reuses == 1
	)


