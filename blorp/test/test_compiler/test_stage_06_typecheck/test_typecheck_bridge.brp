						and graph.modules.all(func(module): module.errors.length() == 0)
						and left_id != right_id
					)
				_:
					False
		_:
			False


func test_typed_graph_ufcs_rejects_mismatched_local_generic_receiver() -> Bool:
	graph = typecheck_graph({
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = "import:\n\tdep: Data, HasLength\n\nrecord Cache[K, V] {key: K, value: V}\n\npure func length[K, V](cache: Cache[K, V]) -> Int:\n\t0\n\npure func measure[T](data: Data[T]) -> Int:\n\tdata.length()",
			typecheck_program = None,
			module_surface = None,
			origin = UserModule
		},
		modules = [
			{
				path = "dep.brp",
				module_name = "dep",
				module_path = "dep",
				text = "trait HasLength:\n\tpure func length(self: Self) -> Int\n\nrecord Data[T] {value: T}\n\nimplements HasLength for Data[T]:\n\tpure func length(self: Data[T]) -> Int:\n\t\t1",
				typecheck_program = None,
				module_surface = None,
				origin = UserModule
			},
		],
		module_targets = ["dep"],
		resolved_imports = [
			{
				from_path = "main.brp",
				from_module = "main",
				import_path = "dep",
				resolved_module = "dep"
			},
		],
		allow_debug_only_calls = False,
	})
	body_call_module = typed_function_body_call_module(
		graph.definition_table,
		graph.target.typed_program,
		"measure",
	)
	dep_module_id = module_table_find_id_by_canonical_path(graph.module_table, "dep")
	accepted_trait_id = typed_function_body_accepted_trait_id(graph.target.typed_program, "measure")
	expected_trait_id = dep_module_id.and_then(func(module_id):
		definition_table_find_trait_id(
			graph.definition_table,
			module_id,
			"HasLength",
			graph.next_def_id,
		)
	)

	call_module_matches = match (body_call_module, dep_module_id):
		(Some((call_module_id, "dep")), Some(expected_module_id)):
			module_ids_equal(call_module_id, expected_module_id)
		_:
			False

	match (
		typed_function_callable_id(graph.target.typed_program, "length"),
		typed_function_body_call_id(graph.target.typed_program, "measure"),
		typed_function_body_callee_call_module_path(
			graph.definition_table,
			graph.target.typed_program,
			"measure",
		),
		typed_module_program(graph.module_table, graph.modules, "dep"),
	):
		(Some(local_length_id), Some(measure_call_id), Some("dep"), Some(dep_program)):
			(
				graph.target.errors.length() == 0
				and call_module_matches
				and match (accepted_trait_id, expected_trait_id):
					(Some(actual), Some(expected)):
						trait_ids_equal(actual, expected)
					_:
						False
				and measure_call_id != local_length_id
				and typed_impl_method_callable_id(
					dep_program,
					"HasLength",
					"length",
				) == Some(measure_call_id)
			)
		_:
			False


func test_typed_graph_preserves_exact_qualified_trait_method_identity() -> Bool:
	graph = typecheck_graph({
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = "import:\n\tdep as D\n\npure func render(data: D.Data) -> String:\n\tD.show(data)",
			typecheck_program = None,
			module_surface = None,
			origin = UserModule
		},
		modules = [
			{
				path = "contracts.brp",
				module_name = "contracts",
				module_path = "contracts",
				text = "trait Renderable:\n\tpure func show(value: Self) -> String\n\ntrait Show: Renderable:\n\tpure func detail(value: Self) -> String",
				typecheck_program = None,
				module_surface = None,
				origin = UserModule
			},
			{
				path = "dep.brp",
				module_name = "dep",
				module_path = "dep",
				text = "import:\n\tcontracts: Renderable, Show\n\nrecord Data {value: Int}\n\nimplements Show for Data:\n\tpure func show(value: Data) -> String:\n\t\t\"data\"\n\tpure func detail(value: Data) -> String:\n\t\t\"detail\"\n\nimplements Renderable for Data:\n\tpure func show(value: Data) -> String:\n\t\t\"base\"",
				typecheck_program = None,
				module_surface = None,
				origin = UserModule
			},
		],
		module_targets = ["contracts", "dep"],
		resolved_imports = [
			{
				from_path = "main.brp",
				from_module = "main",
				import_path = "dep",
				resolved_module = "dep"
			},
			{
				from_path = "dep.brp",
				from_module = "dep",
				import_path = "contracts",
				resolved_module = "contracts"
			},
		],
		allow_debug_only_calls = False,
	})
	trait_module_id = module_table_find_id_by_canonical_path(graph.module_table, "contracts")
	actual_trait_id = typed_function_body_accepted_trait_id(graph.target.typed_program, "render")
	actual_trait_identity = typed_function_body_trait_identity(graph.target.typed_program, "render")
	expected_trait_id = trait_module_id.and_then(func(module_id):
		definition_table_find_trait_id(
			graph.definition_table,
			module_id,
			"Renderable",
			graph.next_def_id,
		)
	)
	actual_callable_id = typed_function_body_call_id(graph.target.typed_program, "render")
	dep_program = typed_module_program(graph.module_table, graph.modules, "dep")

	(
		graph.target.errors.length() == 0
		and graph.modules.all(func(module): module.errors.length() == 0)
		and match (actual_trait_id, expected_trait_id):
			(Some(actual), Some(expected)):
				trait_ids_equal(actual, expected)
			_:
				False
		and match (actual_trait_identity, expected_trait_id, trait_module_id):
			(Some(identity), Some(expected), Some(expected_module_id)):
				identity.definition_id == trait_id_definition_id(expected) and match identity.owner:
					GraphBoundTraitOwner(actual_module_id):
						module_ids_equal(actual_module_id, expected_module_id)
					_:
						False
			_:
				False
		and match (actual_callable_id, dep_program):
			(Some(actual), Some(program)):
				typed_impl_method_callable_id(program, "Show", "show") == Some(actual)
			_:
				False
	)


func test_typed_graph_imported_ufcs_precedes_builtin_fallback() -> Bool:
	graph = typecheck_graph({
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = "import:\n\tdep: parallel\n\npure func measure(data: List[Int]) -> Int:\n\tdata.parallel(1)",
			typecheck_program = None,
			module_surface = None,
			origin = UserModule
		},
		modules = [
			{
				path = "dep.brp",
				module_name = "dep",
				module_path = "dep",
				text = "pure func parallel[T](data: List[T], extra: Int) -> Int:\n\textra",
				typecheck_program = None,
				module_surface = None,
				origin = UserModule
			},
		],
		module_targets = ["dep"],
		resolved_imports = [
			{
				from_path = "main.brp",
				from_module = "main",
				import_path = "dep",
				resolved_module = "dep"
			},
		],
		allow_debug_only_calls = False,
	})

	match typed_module_program(graph.module_table, graph.modules, "dep"):
		Some(dep_program):
			match (
				typed_function_callable_id(dep_program, "parallel"),
				typed_function_body_call_id(graph.target.typed_program, "measure"),
			):
				(Some(parallel_id), Some(measure_call_id)):
					graph.target.errors.length() == 0 and parallel_id == measure_call_id
				_:
					False
		None:
			False


func test_typed_graph_rejects_duplicate_canonical_dependency_identity() -> Bool:
	graph = typecheck_graph({
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = "func main(args: List[String]) -> Int:\n\t0",
			typecheck_program = None,
			module_surface = None,
			origin = UserModule
		},
		modules = [
			{
				path = "first.brp",
				module_name = "first",
				module_path = "shared",
				text = "pure func first() -> Int:\n\t1",
				typecheck_program = None,
				module_surface = None,
				origin = UserModule
			},
			{
				path = "second.brp",
				module_name = "second",
				module_path = "shared",
				text = "pure func second() -> Int:\n\t2",
				typecheck_program = None,
				module_surface = None,
				origin = UserModule
			},
		],
		module_targets = ["shared"],
		resolved_imports = [],
		allow_debug_only_calls = False,
	})

	(
		graph.modules.length() == 0
		and graph.target.errors.contains(
			"duplicate canonical module identity 'shared': 'first.brp' and 'second.brp'",
		)
	)


func test_typed_graph_rejects_target_dependency_identity_conflict() -> Bool:
	graph = typecheck_graph({
