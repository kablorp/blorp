			typecheck_program = None,
			module_surface = None,
			origin = UserModule
		},
		modules = [
			{
				path = "shared.brp",
				module_name = "shared",
				module_path = "pkg/left",
				text = "pure func render() -> Int:\n\t1",
				typecheck_program = None,
				module_surface = None,
				origin = UserModule
			},
			{
				path = "shared.brp",
				module_name = "shared",
				module_path = "pkg/right",
				text = "pure func render() -> Int:\n\t1",
				typecheck_program = None,
				module_surface = None,
				origin = UserModule
			},
		],
		module_targets = ["pkg/left", "pkg/right"],
		resolved_imports = [
			{
				from_path = "main.brp",
				from_module = "main",
				import_path = "left",
				resolved_module = "pkg/left"
			},
			{
				from_path = "main.brp",
				from_module = "main",
				import_path = "right",
				resolved_module = "pkg/right"
			},
		],
		allow_debug_only_calls = False,
	})

	match (
		typed_module_program(graph.module_table, graph.modules, "pkg/left"),
		typed_module_program(graph.module_table, graph.modules, "pkg/right"),
	):
		(Some(left_program), Some(right_program)):
			match (
				typed_function_callable_id(left_program, "render"),
				typed_function_callable_id(right_program, "render"),
			):
				(Some(left_id), Some(right_id)):
					(
						graph.target.errors.length() == 0
						and graph.modules.all(func(module): module.errors.length() == 0)
						and left_program.source.module_name == "shared"
						and right_program.source.module_name == "shared"
						and left_id != right_id
					)
				_:
					False
		_:
			False


