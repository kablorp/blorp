func test_typecheck_graph_preserves_imported_opaque_record_field_owner() -> Bool:
	durations = user_import_module(
		"durations",
		"durations",
		"opaque type Duration = Int",
	)
	worker_source: String =
		|import:
		|	durations: Duration
		|
		|record Command {timeout: Option[Duration]}
		|
		|pure func command() -> Command:
		|	{timeout = None}
	worker = user_import_module("worker", "worker", worker_source)
	target_source: String =
		|import:
		|	worker: command
		|
		|func main(args: List[String]) -> Int:
		|	configured = { command() | timeout = None }
		|
		|	match configured.timeout:
		|		Some(_):
		|			1
		|		None:
		|			0
	target = user_import_module("main", "main", target_source)

	graph = typecheck_modules(target, [durations, worker], ["worker"])

	match graph.modules:
		[worker_module]:
			(
				worker_module.errors.is_empty()
				and graph.target.errors.is_empty()
				and record_field_type_text(worker_module.typed_program, "Command", "timeout")
						== Some("Option[durations.Duration]")
				and final_match_scrutinee_type_text(graph.target.typed_program, "main")
						== Some("Option[durations.Duration]")
			)
		_:
			False


