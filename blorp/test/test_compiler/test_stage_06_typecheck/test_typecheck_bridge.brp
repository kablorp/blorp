		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = "import:\n\tleft: Weight, MyCompare, my_gt\n\npure func compare(a: Weight, b: Weight) -> Bool:\n\ta.my_gt(b)\n\nfunc main(args: List[String]) -> Int:\n\t0",
