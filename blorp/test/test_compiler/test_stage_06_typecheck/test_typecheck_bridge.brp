pure func resource_trait_dep_text() -> String:
	"resource type Handle = builtin(\"close_handle\")\n\nunion IOError:\n\tOther(String)\n\ntrait Readable:\n\tfunc read_text(handle: Self) -> Result[String, IOError]\n\nfunc open_handle(path: String) -> Result[Handle, IOError]:\n\tbuiltin(\"open_handle\")\n\nimplements Readable for Handle:\n\t@resource_result_ordinary\n\tfunc read_text(handle: Handle) -> Result[String, IOError]:\n\t\tbuiltin(\"read_handle\")"


func test_typecheck_source_preserves_resource_policy_for_trait_method_ufcs() -> Bool:
	source: String = "import:\n\tdep: Handle, IOError, open_handle, read_text\n\nfunc read(path: String) -> Result[String, IOError]:\n\twith handle ?= open_handle(path):\n\t\thandle.read_text()"
	dep_text: String = resource_trait_dep_text()

	typecheck_source(source, [std_import_module("dep", "dep", dep_text)]).target.errors.is_empty()


func test_typecheck_source_preserves_resource_policy_for_direct_trait_method() -> Bool:
	source: String = "import:\n\tdep: Handle, IOError, open_handle, read_text\n\nfunc read(path: String) -> Result[String, IOError]:\n\twith handle ?= open_handle(path):\n\t\tread_text(handle)"
	dep_text: String = resource_trait_dep_text()

	typecheck_source(source, [std_import_module("dep", "dep", dep_text)]).target.errors.is_empty()


-- The bound must name the prelude `Addable`, so the imported module plays the
-- standard prelude-traits module; a user trait that only shares the spelling
-- would not grant the operator.
func test_typecheck_source_uses_trait_bounded_generic_arithmetic() -> Bool:
	source: String = "import:\n\ttraits: Addable, HasZero, zero\n\npure func add_from_zero[T: Addable + HasZero](left: T, right: T) -> T:\n\tvar total: T = zero()\n\ttotal = total + left\n\ttotal + right"
	dep_text: String = "trait Addable:\n\tpure func add(a: Self, b: Self) -> Self\n\ntrait HasZero:\n\tpure func zero() -> Self"

	typecheck_source(source, [std_import_module("traits", "traits", dep_text)]).target.errors.is_empty()


-- A user trait that only shares the spelling `Addable` is not the prelude trait,
-- so bounding a type parameter by it does not grant the `+` operator.
func test_typecheck_source_rejects_arithmetic_through_a_same_named_user_trait() -> Bool:
	source: String = "import:\n\tdep: Addable\n\npure func add_pair[T: Addable](left: T, right: T) -> T:\n\tleft + right"
	dep_text: String = "trait Addable:\n\tpure func add(a: Self, b: Self) -> Self"

	errors = typecheck_source(source, [user_import_module("dep", "dep", dep_text)]).target.errors

	errors_contain(
		errors,
		(
			"Type parameter 'T' requires Addable bound for + operator\n"
			+ "    help: 'Addable' here is your module's trait, not the prelude Addable; "
			+ "use the prelude trait or implement it for T"
		),
	)


func test_typecheck_source_rejects_impl_method_parameter_owner_collision() -> Bool:
	source: String = "import:\n\tdep: Stringable\n\nrecord Box[T] {value: T}\n\nimplements Stringable for Box[T:Stringable]:\n\tpure func to_string[T](self: Box[T]) -> String:\n\t\t\"box\""
	dep_text: String = "trait Stringable:\n\tpure func to_string(value: Self) -> String"

	errors = typecheck_source(source, [std_import_module("dep", "dep", dep_text)]).target.errors

	errors_contain(
		errors,
		(
			"implementation method 'to_string' redeclares implementation type parameter 'T'; "
			+ "remove it from the method's type parameter list because implementation "
			+ "parameters are already in scope"
		),
	)


func test_typecheck_source_rejects_bare_qualified_only_import() -> Bool:
	source: String = "import:\n\tdep as Dep\n\nfunc identity() -> Int:\n\tanswer()"
	dep_text: String = "pure func answer() -> Int:\n\t1"

	errors = typecheck_source(source, [std_import_module("dep", "dep", dep_text)]).target.errors

	errors_contain(errors, "Unbound value `answer`")


func test_typecheck_source_rejects_private_qualified_import() -> Bool:
	source: String = "import:\n\tdep as Dep\n\nfunc identity() -> Int:\n\tDep.secret()"
	dep_text: String = "private pure func secret() -> Int:\n\t1"

	errors = typecheck_source(source, [std_import_module("dep", "dep", dep_text)]).target.errors

	errors_contain(errors, "has no function `secret`")


