			module_surface = None,
			origin = UserModule
		},
		modules = [
			{
				path = "copy.brp",
				module_name = "copy",
				module_path = "app",
				text = "pure func copy() -> Int:\n\t1",
				typecheck_program = None,
				module_surface = None,
				origin = UserModule
			},
		],
		module_targets = ["app"],
		resolved_imports = [],
		allow_debug_only_calls = False,
