func test_typecheck_graph_reports_duplicate_canonical_identity() -> Bool:
	dependency = user_import_module("shared", "dep", "pure func answer() -> Int:\n\t42")
	target = user_import_module("main", "main", "func main(args: List[String]) -> Int:\n\t0")
	graph = typecheck_modules(target, [dependency, dependency], [])
	expected = "duplicate canonical module identity 'shared': 'dep.brp' and 'dep.brp'"

	graph.modules.is_empty() and graph.target.errors.contains(expected)


func test_typecheck_graph_rejects_mixed_valid_and_unknown_targets() -> Bool:
	dependency = user_import_module("shared", "dep", "pure func answer() -> Int:\n\t42")
	target = user_import_module(
		"main",
		"main",
		"import:\n\tshared\n\nfunc main(args: List[String]) -> Int:\n\tshared.answer()",
	)
	graph = typecheck_modules(target, [dependency], ["shared", "missing"])
	expected = "unknown typecheck module target 'missing'"

	(
		graph.modules.is_empty()
		and typechecked_module_path(graph.target) == "main.brp"
		and graph.target.errors.length() == 1
		and graph.target.errors.contains(expected)
	)


