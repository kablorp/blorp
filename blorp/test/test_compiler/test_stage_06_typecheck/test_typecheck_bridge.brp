func test_typed_graph_api_returns_in_memory_results() -> Bool:
	graph = typecheck_graph({
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = "import:\n\tutil\n\nfunc main(args: List[String]) -> Int:\n\tutil.answer()",
			typecheck_program = None,
			module_surface = None,
			origin = UserModule
		},
		modules = [
			{
				path = "util.brp",
				module_name = "util",
				module_path = "util",
				text = "pure func answer() -> Int:\n\t42",
				typecheck_program = None,
				module_surface = None,
				origin = UserModule
			},
		],
		module_targets = ["util"],
		resolved_imports = [
			{
				from_path = "main.brp",
				from_module = "main",
				import_path = "util",
				resolved_module = "util"
			},
		],
		allow_debug_only_calls = False,
	})

	module_ids_are_aligned = match (
		module_table_find_id_by_canonical_path(graph.module_table, "util"),
		graph.modules.get(0),
		typed_function_body_call_module(
			graph.definition_table,
			graph.target.typed_program,
			"main",
		),
	):
		(Some(dependency_id), Some(dependency), Some((call_module_id, call_module_path))):
			(
				module_table_canonical_path(
					graph.module_table,
					graph.target.module_id,
				) == Some("main")
				and module_ids_equal(dependency_id, dependency.module_id)
				and module_ids_equal(call_module_id, dependency_id)
				and call_module_path == "util"
			)
		_:
			False

	(
		typechecked_module_path(graph.target) == "main.brp"
		and graph.target.errors.length() == 0
		and graph.target.ctfe_evaluated
		and graph.target.import_bindings.length() == 1
		and graph.modules.length() == 1
		and graph.modules
			.get(0)
			.and_then(
				func(
					module,
				): module_table_canonical_path(
					graph.module_table,
					module.module_id,
				),
			) == Some("util")
		and module_ids_are_aligned
	)


