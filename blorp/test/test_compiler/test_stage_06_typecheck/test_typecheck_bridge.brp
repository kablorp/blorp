				module_path = "pkg/right",
				text = module_source,
				typecheck_program = None,
				module_surface = None,
				origin = UserModule
			},
		],
		module_targets = ["pkg/left", "pkg/right"],
		resolved_imports = [
			{
				from_path = "main.brp",
				from_module = "main",
				import_path = "left",
				resolved_module = "pkg/left"
			},
		],
		allow_debug_only_calls = False,
	})

	match (
		typed_module_program(graph.module_table, graph.modules, "pkg/left"),
		typed_module_program(graph.module_table, graph.modules, "pkg/right"),
	):
		(Some(left_program), Some(right_program)):
			match (
				typed_impl_method_callable_id(left_program, "MyCompare", "my_gt"),
