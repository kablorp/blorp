private func rejects_ambiguous_implicit_trait_method(modules: List[TypecheckImportModule]) -> Bool:
	source: String = "import:\n\tbox: Box, make_box\n\tfirst as First\n\tsecond as Second\n\npure func show_box() -> Int:\n\tmake_box().show()"
	errors = typecheck_source(source, modules).target.errors

	(
		errors_contain(errors, "Ambiguous trait method 'show' for receiver type")
		and errors_contain(errors, "Import one trait method explicitly to select it.")
	)


func test_typecheck_source_rejects_ambiguous_implicit_trait_method_independent_of_order() -> Bool:
	box_module = std_import_module(
		"box",
		"box",
		"record Box {value: Int}\n\npure func make_box() -> Box:\n\t{value = 7}",
	)
	first_module = std_import_module(
		"first",
		"first",
		"import:\n\tbox: Box\n\ntrait FirstShow:\n\tpure func show(value: Self) -> Int\n\nimplements FirstShow for Box:\n\tpure func show(value: Box) -> Int:\n\t\t1",
	)
	second_module = std_import_module(
		"second",
		"second",
		"import:\n\tbox: Box\n\ntrait SecondShow:\n\tpure func show(value: Self) -> Int\n\nimplements SecondShow for Box:\n\tpure func show(value: Box) -> Int:\n\t\t2",
	)

	(
		rejects_ambiguous_implicit_trait_method([box_module, first_module, second_module])
		and rejects_ambiguous_implicit_trait_method([box_module, second_module, first_module])
	)


