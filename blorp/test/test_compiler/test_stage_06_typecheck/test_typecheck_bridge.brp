-- What the `base` module's artifact looks like once the graph is typechecked.
-- `ready_binds_name` names the regression: its `Ready` pattern must stay a name
-- binding rather than resolve to the constructor another module declares.
private record CtfeCollisionBaseFacts {
	answer: Option[String],
	ready_binds_name: Bool,
	program_json: String
}


private func ctfe_collision_base_facts(artifact_paths: List[String]) -> Option[CtfeCollisionBaseFacts]:
	base_source: String =
		|answer: Int = match 41:
		|	Ready: Ready
	base = user_import_module("base", "base", base_source)
	dep_source: String =
		|import:
		|	base: answer
		|
		|next_answer: Int = answer + 1
	dep = user_import_module("dep", "dep", dep_source)
	left_source: String =
		|import:
		|	dep: next_answer
		|
		|left_answer: Int = next_answer
	left = user_import_module("left", "left", left_source)
	right_source: String =
		|import:
		|	dep: next_answer
		|
		|union Status:
		|	Ready
		|
		|right_answer: Int = next_answer
	right = user_import_module("right", "right", right_source)
	target_source: String =
		|import:
		|	dep: next_answer
		|
		|main_answer: Int = next_answer
	target = user_import_module("main", "main", target_source)

	graph = typecheck_modules(target, [base, dep, left, right], artifact_paths)
	modules = graph.modules.append(graph.target)
	all_evaluated = modules.all(func(module): module.errors.is_empty() and module.ctfe_evaluated)

	if all_evaluated:
		graph.modules
			.find(func(module): typechecked_module_path(module) == "base.brp")
			.map(func(module):
				{
					answer = typechecked_module_global_int(module, "answer"),
					ready_binds_name = typed_global_match_binds_name_pattern(
						module.typed_program,
						"answer",
					),
					program_json = typed_program_to_json_in_graph(
						module.module_id,
						graph.module_table,
						graph.definition_table,
						typechecked_graph_identifier_spellings(graph),
						typechecked_module_program_with_ctfe_replacements(module),
					).to_string()
				}
			)
	else:
		None


func test_typecheck_graph_ctfe_constructor_resolution_is_artifact_stable() -> Bool:
	left_first = ctfe_collision_base_facts(["base", "left", "right"])
	right_first = ctfe_collision_base_facts(["right", "left", "base"])

	match (left_first, right_first):
		(Some(left_facts), Some(right_facts)):
			left_facts == right_facts and left_facts.ready_binds_name
		_:
			False


