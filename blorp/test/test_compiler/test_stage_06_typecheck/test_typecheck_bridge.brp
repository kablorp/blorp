	materialized = source_location_span(
		source_table_for_file(graph.target.typed_program.source),
		span,
	)
	Some(
		(
			diagnostic.message == "Unknown type 'MissingType' while resolving 'Box'\nhelp: if 'MissingType' is a type parameter, declare it in brackets after the name, such as `func identity[MissingType](x: MissingType) -> MissingType`; otherwise check its spelling and imports"
			and materialized.path == "main.brp"
			and materialized.start_line == 1
			and materialized.start_column > 1
		),
	)


