func test_typecheck_graph_evaluates_ctfe_for_empty_and_selected_artifacts() -> Bool:
	target = user_import_module("main", "main", "answer: Int = 42")
	empty_run = typecheck_modules_with_metrics(target, [], [])
	empty_graph = empty_run.graph
	base = user_import_module("base", "base", "base_value: Int = 40")
	left_source: String =
		|import:
		|	base: base_value
		|
		|left_value: Int = base_value + 1
	left = user_import_module("left", "left", left_source)
	right_source: String =
		|import:
		|	base: base_value
		|
		|right_value: Int = base_value + 2
	right = user_import_module("right", "right", right_source)
	unrelated = user_import_module("unrelated", "unrelated", "value: Int = 99")
	selected_run = typecheck_modules_with_metrics(
		target,
		[unrelated, right, base, left],
		["left", "right"],
	)
	selected_graph = selected_run.graph

	match selected_graph.modules:
		[left_module, right_module]:
			(
				empty_graph.target.errors.is_empty()
				and empty_graph.target.ctfe_evaluated
				and selected_graph.target.errors.is_empty()
				and selected_graph.target.ctfe_evaluated
				and typechecked_module_global_int(left_module, "left_value") == Some("41")
				and typechecked_module_global_int(right_module, "right_value") == Some("42")
				and ctfe_dependency_module_count(empty_run) == 0
				and ctfe_dependency_module_count(selected_run) == 1
			)
		_:
			False


