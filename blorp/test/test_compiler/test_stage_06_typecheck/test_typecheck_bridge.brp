private pure func typed_function_callable_id(program: TypedProgram, name: String) -> Option[Int]:
	var result: Option[Int] = None

	for decl in program.decls:
		match decl:
			TypedFunctionDecl(info):
				if info.decl.name.text == name:
					result = info.callable_id
					break
			TypedPrivateDecl(TypedFunctionDecl(info)):
				if info.decl.name.text == name:
					result = info.callable_id
					break
			_:
				void

	result


private pure func typed_function_body_call_id(program: TypedProgram, name: String) -> Option[Int]:
	var result: Option[Int] = None

	for decl in program.decls:
		match decl:
			TypedFunctionDecl(info):
				if info.decl.name.text == name:
					match info.body:
						Some(body):
							match typed_expr_resolved_call(body):
								Some(call):
									result = resolved_call_callable_id(call)
								None:
									void
						None:
							void

					break
			_:
				void

	result


private pure func typed_function_body_call_module(
	definition_table: DefinitionTable,
	program: TypedProgram,
	name: String,
) -> Option[(ModuleId, String)]:
	var result: Option[(ModuleId, String)] = None

	for decl in program.decls:
		match decl:
			TypedFunctionDecl(info):
				if info.decl.name.text == name:
					match info.body:
						Some(body):
							match typed_expr_resolved_call(body):
								Some(call):
									match call.target:
										ResolvedGraphCallableCall(callable_id, _):
											result = callable_id_module_id(
												definition_table,
												callable_id,
											).and_then(func(module_id):
												module_table_canonical_path(
													definition_table_module_table(definition_table),
													module_id,
												).map(
													func(path): (module_id, path),
												)
											)
										ResolvedSelectedTraitMethodCall(_, callable_id):
											result = callable_id_module_id(
												definition_table,
												callable_id,
											).and_then(func(module_id):
												module_table_canonical_path(
													definition_table_module_table(definition_table),
													module_id,
												).map(
													func(path): (module_id, path),
												)
											)
										ResolvedAcceptedTraitMethodCall(_, callable_id):
											result = callable_id_module_id(
												definition_table,
												callable_id,
											).and_then(func(module_id):
												module_table_canonical_path(
													definition_table_module_table(definition_table),
													module_id,
												).map(
													func(path): (module_id, path),
												)
											)
										_:
											void
								None:
									void
						None:
							void

					break
			_:
				void

	result


private pure func typed_expr_callee_call_module_path(
	definition_table: DefinitionTable,
	expr: TypedExpr,
) -> Option[String]:
	match expr:
		TypedCallExpr(callee, _, _, _):
			match typed_expr_resolved_call(callee):
				Some(call):
					match call.target:
						ResolvedAcceptedTraitMethodCall(_, callable_id):
							callable_id_module_id(
								definition_table,
								callable_id,
							).and_then(
								func(
									module_id,
								): module_table_canonical_path(
									definition_table_module_table(definition_table),
									module_id,
								),
							)
						ResolvedSelectedTraitMethodCall(_, callable_id):
							callable_id_module_id(
								definition_table,
								callable_id,
							).and_then(
								func(
									module_id,
								): module_table_canonical_path(
									definition_table_module_table(definition_table),
									module_id,
								),
							)
						_:
							None
				None:
					None
		TypedBlockExpr(items, _, _):
			match items.get(items.length() - 1):
				Some(last):
					typed_expr_callee_call_module_path(definition_table, last)
				None:
					None
		_:
			None


private pure func typed_function_body_accepted_trait_id(
	program: TypedProgram,
	name: String,
) -> Option[TraitId]:
	var result: Option[TraitId] = None

	for decl in program.decls:
		match decl:
			TypedFunctionDecl(info):
				if info.decl.name.text == name:
					match info.body:
						Some(body):
							match typed_expr_resolved_call(body):
								Some(call):
									match call.target:
										ResolvedAcceptedUnresolvedTraitMethodCall(trait_id):
											result = Some(trait_id)
										ResolvedAcceptedTraitMethodCall(trait_id, _):
											result = Some(trait_id)
										_:
											void
								None:
									void
						None:
							void

					break
			_:
				void

	result


