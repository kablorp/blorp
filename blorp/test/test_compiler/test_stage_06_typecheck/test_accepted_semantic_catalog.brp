private func compiler_scope_preserves_obligation_and_selected_metadata() -> Option[Bool]:
	fixture ?= scoped_authority_fixture(
		"record Choice {value: Int}\nimplements Equatable for Choice:\n\tpure func equals(left: Choice, right: Choice) -> Bool: True\n",
	)

	compiler_source = match accepted_scoped_trait_methods(
		fixture.authority,
		fixture.issuer,
		TRAIT_ID_EQUATABLE,
	):
		Ok(CompilerProvidedScopedTrait(id)):
			trait_ids_equal(id, TRAIT_ID_EQUATABLE)
		_:
			False

	env = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN).env
	receiver = SemanticNamedType("Choice", [])
	legacy ?= accepted_find_impl_method_info(
		fixture.authority,
		env,
		"Equatable",
		"equals",
		receiver,
	)
	selected ?= accepted_find_impl_method_info_by_trait_id(
		fixture.authority,
		fixture.issuer,
		env,
		TRAIT_ID_EQUATABLE,
		"equals",
		receiver,
	)
	legacy_target ?= legacy.target
	selected_target ?= selected.target
	issued_callable ?= callable_id_from_definition_table(
		fixture.issuer,
		selected_target.callable_id,
	)
	Some(
		(
			compiler_source
			and accepted_trait_find(fixture.authority, "Equatable").is_none()
			and callable_id_name(fixture.issuer, issued_callable) == Some("equals")
			and selected_target.callable_id == legacy_target.callable_id
			and types_equal(selected.func_type, legacy.func_type)
			and selected.param_names == legacy.param_names
			and selected.purity == legacy.purity
			and resource_arg_policies_equal(selected.resource_args, legacy.resource_args)
			and selected.debug_only == legacy.debug_only
			and selected.type_params.is_empty()
			and legacy.type_params.is_empty()
			and selected.dim_constraints.is_empty()
			and legacy.dim_constraints.is_empty()
			and accepted_resolve_trait_id_obligation(
				fixture.authority,
				fixture.issuer,
				env,
				TYPE_INT,
				TRAIT_ID_EQUATABLE,
			) == TraitObligationSatisfied
		),
	)


func test_compiler_scope_preserves_obligation_and_selected_metadata() -> Bool:
