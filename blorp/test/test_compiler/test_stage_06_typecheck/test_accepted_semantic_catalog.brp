private func source_match_keeps_private_selection_local() -> Option[Bool]:
	fixture ?= catalog_component_fixture("scope/main",
		"record Choice {value: Int}\nprivate implements Equatable for Choice:\n\tpure func equals(left: Choice, right: Choice) -> Bool: True\n\tpure func not_equals(left: Choice, right: Choice) -> Bool: False\n",
	)
	table = fixture.traits_and_implementations
	issuer = implementation_header_graph_definition_table(fixture.implementation_headers)
	provider = accepted_trait_implementation_authority(table, "scope/main", accepted_trait_empty_visibility(table), [])
	importer = accepted_trait_implementation_authority(table, "scope/importer", accepted_trait_empty_visibility(table), [])
	identity = bound_trait_identity_from_id(issuer, TRAIT_ID_EQUATABLE)
	selected ?= source_packet_for_projection_test(provider, issuer, SemanticNamedType("Choice", []), identity).to_option()
	absent ?= source_packet_for_projection_test(importer, issuer, SemanticNamedType("scope/main.Choice", []), identity).to_option()
	packet ?= selected
	callables = accepted_source_implementation_match_callables(packet)
	equality ?= callables.get(0)
	inequality ?= callables.get(1)
	Some(absent.is_none() and callables.length() == 2 and match (equality, inequality):
		(TraitImplementationMember(CompilerScopedEvidenceMember(owner, ordinal), _), AuxiliaryImplementationCallable(target)):
			(
				trait_ids_equal(owner, TRAIT_ID_EQUATABLE) and ordinal == 0
				and callable_id_name(issuer, target) == Some("not_equals")
			)
		_:
			False
	)


