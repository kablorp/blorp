func test_installed_builtin_members_agree_with_shared_registry() -> Bool:
	env = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN).env
	var valid: Bool = builtin_trait_topology_is_acyclic()
	-- The equivalent nested HOF assertion exposes an independent current-base
	-- closure emission defect; retain its reproduction in the evidence packet.
	for indexed in BUILTIN_TRAIT_NAMES.enumerate():
		id = builtin_trait_id_at_registry_index(indexed[0])
		match env_get_trait_by_id(env, id):
			Some(declaration):
				valid = (
					valid and declaration.def_id == FIRST_BUILTIN_ENV_DEFINITION_ID + indexed[0]
					and declaration.name == indexed[1]
				)
				for method in declaration.methods.enumerate():
					valid = valid and match builtin_trait_member_declaration(id, method[1].name):
						Some(found): trait_ids_equal(found[0], id) and found[1] == method[0]
						None: False
					if not valid:
						break
			None:
				valid = False
		if not valid:
			break
	valid


private CYCLIC_SOURCE: String =
	|trait Recursive:
	|	pure func marker(value: Self) -> Int
	|implements Recursive for (T:Recursive):
	|	pure func marker(value: T) -> Int: 1


-- These differently declared implementations both survive normal coherence
-- filtering. Deliberate callback outcomes exercise the owner loop, not a
-- claim that a real recursively closed source witness exists.
private ORDERED_SOURCE: String =
	|trait Base:
	|	pure func marker(value: Self) -> Int
	|trait Derived: Base:
	|	pure func child(value: Self) -> Int
	|implements Base for Int:
	|	pure func marker(value: Int) -> Int: 1
	|implements Derived for Int:
	|	pure func child(value: Int) -> Int: 2
	|	pure func marker(value: Int) -> Int: 3


private func guarded_candidate_retains_declared_supertraits() -> Option[Bool]:
	fixture ?= scoped_authority_fixture(
		|trait Parent:
		|	pure func parent(value: Self) -> Int
		|trait Child: Parent:
		|	pure func child(value: Self) -> Int
		|implements Child for Int:
		|	pure func child(value: Int) -> Int: 2
	)
	child ?= accepted_trait_find(fixture.authority, "Child")
	parent ?= accepted_trait_find(fixture.authority, "Parent")
	applicability: pure (AcceptedSourceCandidate) -> Result[AcceptedSourceCandidateDecision[Bool, Bool], String] = pure func(candidate):
		parents ?= accepted_source_candidate_supertraits(fixture.authority, candidate)
		parents_valid = match parents:
			Some(items): items.length() == 1 and items.get(0).map(
				func(identity): bound_trait_identities_equal(identity, bound_trait_identity_from_id(fixture.issuer, parent.trait_id)),
			).get_or(False)
			None: False
		Ok(SourceCandidateApplicable(
			trait_ids_equal(accepted_source_candidate_declared_trait(candidate), child.trait_id) and parents_valid,
		))
	selected ?= accepted_match_source_trait_implementation_with(
		fixture.authority, fixture.issuer, TYPE_INT,
		bound_trait_identity_from_id(fixture.issuer, child.trait_id),
		applicability,
	).to_option()
	Some(match selected:
		SourceImplementationSelected(_, proof): proof
		_: False
	)


func test_guarded_candidate_retains_declared_supertraits() -> Bool:
	guarded_candidate_retains_declared_supertraits().get_or(False)


private func guarded_source_cycle_skips_to_later_applicable() -> Option[Bool]:
	fixture ?= scoped_authority_fixture(ORDERED_SOURCE)
	declaration ?= accepted_trait_find(fixture.authority, "Base")
	derived ?= accepted_trait_find(fixture.authority, "Derived")
	first_callback: pure (AcceptedSourceCandidate) -> Result[AcceptedSourceCandidateDecision[Bool, Bool], String] = pure func(_candidate): Ok(SourceCandidateDeferred(True))
	first ?= accepted_match_source_trait_implementation_with(
		fixture.authority, fixture.issuer, TYPE_INT,
		bound_trait_identity_from_id(fixture.issuer, declaration.trait_id), first_callback,
	).to_option()
	first_candidate ?= match first:
		SourceImplementationDeferred(candidate, _): Some(candidate)
		_: None
	applicability: pure (AcceptedSourceCandidate) -> Result[AcceptedSourceCandidateDecision[Bool, Bool], String] = pure func(candidate):
		Ok(if impl_ids_equal(accepted_source_candidate_id(candidate), accepted_source_candidate_id(first_candidate)):
			SourceCandidateCyclic("recursive proof")
		else:
			SourceCandidateApplicable(trait_ids_equal(accepted_source_candidate_declared_trait(candidate), derived.trait_id))
		)
	selected ?= accepted_match_source_trait_implementation_with(
		fixture.authority, fixture.issuer, TYPE_INT,
		bound_trait_identity_from_id(fixture.issuer, declaration.trait_id),
		applicability,
	).to_option()
	Some(match selected:
		SourceImplementationSelected(packet, proof):
			(proof and trait_ids_equal(accepted_source_candidate_declared_trait(first_candidate), declaration.trait_id)
			and not impl_ids_equal(accepted_source_implementation_match_id(packet), accepted_source_candidate_id(first_candidate))
			)
		_: False
	)


func test_guarded_source_cycle_skips_to_later_applicable() -> Bool:
	guarded_source_cycle_skips_to_later_applicable().get_or(False)


