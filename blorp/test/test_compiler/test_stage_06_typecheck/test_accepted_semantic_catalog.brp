private func source_match_preserves_exact_hidden_member_and_issuer() -> Option[Bool]:
	fixture ?= scoped_authority_fixture(CATALOG_SOURCE)
	foreign_fixture ?= scoped_authority_fixture(CATALOG_SOURCE)
	trait_def ?= accepted_trait_find(fixture.authority, "Identity")
	methods ?= issued_scoped_methods(fixture, trait_def.trait_id)
	expected ?= methods.get(0)
	identity = bound_trait_identity_from_id(fixture.issuer, trait_def.trait_id)
	hidden = accepted_trait_implementation_authority_without_visible_names(fixture.authority)
	matched ?= source_packet_for_projection_test(
		hidden, fixture.issuer, SemanticNamedType("Pair", []), identity,
	).to_option().and_then(func(found): found)
	member ?= accepted_source_implementation_match_callables(matched).get(0)
	foreign_rejected = match source_packet_for_projection_test(
		hidden, foreign_fixture.issuer, SemanticNamedType("Pair", []), identity,
	):
		Err(message): message == "trait evidence issuer does not match accepted authority"
		_:
			False
	Some(
		foreign_rejected and accepted_trait_find(hidden, "Identity").is_none()
		and types_equal(accepted_source_implementation_match_receiver(matched), SemanticNamedType("Pair", []))
		and accepted_source_implementation_match_dependencies(matched).is_empty()
		and match member:
			TraitImplementationMember(IssuedEvidenceMember(id), _): trait_method_ids_equal(id, expected[1])
			_:
				False
	)


