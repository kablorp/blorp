private func compiler_consumers_reject_foreign_and_unregistered_ids() -> Option[Bool]:
	fixture ?= scoped_authority_fixture(CATALOG_SOURCE)
	other_fixture ?= scoped_authority_fixture(CATALOG_SOURCE)
	env = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN).env
	forged = builtin_trait_id_at_registry_index(BUILTIN_TRAIT_NAMES.length())

	forged_scope_rejected = match accepted_scoped_trait_methods(
		fixture.authority,
		fixture.issuer,
		forged,
	):
		Err(message):
			message == "scoped trait identity is not registered in its issuing domain"
		_:
			False

	Some(
		(
			forged_scope_rejected
			and accepted_resolve_trait_id_obligation(
				fixture.authority,
				other_fixture.issuer,
				env,
				TYPE_INT,
				TRAIT_ID_EQUATABLE,
			) == TraitObligationUnsatisfied
			and accepted_resolve_trait_id_obligation(
				fixture.authority,
				fixture.issuer,
				env,
				TYPE_INT,
				forged,
			) == TraitObligationUnsatisfied
			and accepted_find_impl_method_info_by_trait_id(
				fixture.authority,
				other_fixture.issuer,
				env,
				TRAIT_ID_EQUATABLE,
				"equals",
				TYPE_INT,
			).is_none()
			and accepted_find_impl_method_info_by_trait_id(
				fixture.authority,
				fixture.issuer,
				env,
				forged,
				"equals",
				TYPE_INT,
			).is_none()
		),
	)


