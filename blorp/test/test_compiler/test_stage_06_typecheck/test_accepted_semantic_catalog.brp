private func guarded_source_stops_at_first_deferred() -> Option[Bool]:
	fixture ?= scoped_authority_fixture(ORDERED_SOURCE)
	declaration ?= accepted_trait_find(fixture.authority, "Base")
	applicability: pure (AcceptedSourceCandidate) -> Result[AcceptedSourceCandidateDecision[Bool, String], String] = pure func(candidate):
		Ok(if trait_ids_equal(accepted_source_candidate_declared_trait(candidate), declaration.trait_id):
			SourceCandidateDeferred("unresolved first candidate")
		else:
			SourceCandidateApplicable(True)
		)
	selected ?= accepted_match_source_trait_implementation_with(
		fixture.authority, fixture.issuer, TYPE_INT,
		bound_trait_identity_from_id(fixture.issuer, declaration.trait_id),
		applicability,
	).to_option()
	Some(match selected:
		SourceImplementationDeferred(candidate, pending):
			(pending == "unresolved first candidate"
			and trait_ids_equal(accepted_source_candidate_declared_trait(candidate), declaration.trait_id)
			)
		_: False
	)


func test_guarded_source_stops_at_first_deferred() -> Bool:
	guarded_source_stops_at_first_deferred().get_or(False)


