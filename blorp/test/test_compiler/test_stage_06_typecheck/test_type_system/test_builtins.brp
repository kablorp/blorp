	required_names.all(func(name): env_is_builtin_func(env, name))


func test_channel_builtins_use_public_result_types() -> Bool:
	env: Env = env_with_builtins(ENV_EMPTY)
	type_t: SemanticType = SemanticTypeVar("T", SemanticTypeParameter)
	channel_t: SemanticType = SemanticNamedType("Channel", [type_t])

	match (env_get_func_info(env, "send"), env_get_func_info(env, "recv")):
		(Some((send_type, _, _)), Some((recv_type, _, _))):
			types_equal(
				send_type,
				SemanticFunctionType(
					False,
					[channel_t, type_t],
					TYPE_BOOL,
				),
			) and types_equal(
				recv_type,
				SemanticFunctionType(
					False,
					[channel_t],
					SemanticNamedType("Option", [type_t]),
				),
			)
		_:
			False


func test_builtin_numeric_families_satisfy_declared_traits() -> Bool:
	env: Env = env_with_builtins(ENV_EMPTY)

	env_resolve_trait_obligation(
		env,
		trait_obligation(
			SemanticNamedType("Int32", []),
			test_trait_id("Integer")),
	) == TraitObligationSatisfied and env_resolve_trait_obligation(
		env,
		trait_obligation(
			SemanticNamedType("Int16", []),
			test_trait_id("SignedInteger")),
	) == TraitObligationSatisfied and env_resolve_trait_obligation(
		env,
		trait_obligation(
			SemanticNamedType("UInt8", []),
			test_trait_id("UnsignedInteger")),
	) == TraitObligationSatisfied and env_resolve_trait_obligation(
		env,
		trait_obligation(
			SemanticNamedType("Float32", []),
			test_trait_id("FloatingPoint")),
	) == TraitObligationSatisfied


func test_floating_point_methods_are_registered() -> Bool:
	env: Env = env_with_builtins(ENV_EMPTY)
	method_names: List[String] = [
		"floor",
		"ceil",
		"round",
		"trunc",
		"sqrt",
		"sin",
		"cos",
		"tan",
		"asin",
		"acos",
		"atan",
		"atan2",
		"sinh",
		"cosh",
		"tanh",
		"asinh",
		"acosh",
		"atanh",
		"exp",
		"exp2",
		"expm1",
		"log",
		"log2",
		"log10",
		"log1p",
		"pow",
		"cbrt",
		"hypot",
		"fmod",
		"copysign",
		"fma",
		"is_nan",
		"is_inf",
		"is_finite",
	]

	registered = method_names.all(func(name):
		env_get_function_trait(env, name) == Some("FloatingPoint")
	)

	registered and match env_get_trait(env, "FloatingPoint"):
		Some(trait_def):
			trait_def.methods.any(func(method):
				floating_point_method_matches(
					method,
					"atan2",
					[SemanticSelfType, SemanticSelfType],
					SemanticSelfType,
				)
			) and trait_def.methods.any(func(method):
				floating_point_method_matches(
					method,
					"fma",
					[SemanticSelfType, SemanticSelfType, SemanticSelfType],
					SemanticSelfType,
				)
			) and trait_def.methods.any(func(method):
				floating_point_method_matches(method, "is_finite", [SemanticSelfType], TYPE_BOOL)
			)
		None:
			False


pure func floating_point_method_matches(
	method: TraitMethodSig,
	name: String,
	params: List[SemanticType],
	return_type: SemanticType,
) -> Bool:
	(
		method.name == name
		and method.is_pure
		and floating_point_param_types_match(method.params, params)
		and types_equal(method.return_type, return_type)
	)


pure func floating_point_param_types_match(
	left: List[SemanticType],
	right: List[SemanticType],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var index: Int = 0
		var equal: Bool = True

		while index < left.length() and equal:
			equal = types_equal(
				left.get_or(index, SemanticSelfType),
				right.get_or(index, SemanticSelfType),
			)
			index += 1

		equal


func test_assert_shape_builtin_uses_variadic_tensor_signature() -> Bool:
	env: Env = env_with_builtins(ENV_EMPTY)
	type_t: SemanticType = SemanticTypeVar("T", SemanticTypeParameter)
	tensor_t: SemanticType = SemanticArrayType(type_t, [SemanticVarDimsType("#Ds")])

	match env_get_func_info(env, "assert_shape"):
		Some((typ, params, purity)):
			params.map(bound_type_param_name) == ["T"] and purity == Pure and types_equal(
				typ,
				SemanticFunctionType(
					True,
					[tensor_t, TYPE_INT],
					SemanticNamedType("Option", [tensor_t]),
				),
			)
		None:
			False


-- Int128 and UInt128 are Hashable through their standard-library impls, not
-- builtin evidence.
func test_hashable_primitives_and_dispatch_are_registered() -> Bool:
	env: Env = env_with_builtins(ENV_EMPTY)
	hashable_types: List[SemanticType] = [
		TYPE_INT,
		SemanticNamedType("Int8", []),
		SemanticNamedType("Int16", []),
		SemanticNamedType("Int32", []),
		SemanticNamedType("Int64", []),
		SemanticNamedType("UInt8", []),
		SemanticNamedType("UInt16", []),
		SemanticNamedType("UInt32", []),
		SemanticNamedType("UInt64", []),
		SemanticNamedType("Float", []),
		SemanticNamedType("Float32", []),
		SemanticNamedType("Float16", []),
		SemanticNamedType("Bool", []),
		SemanticNamedType("Char", []),
		TYPE_STRING,
	]

	(
		builtin_trait_is_prelude("Hashable")
		and env_get_function_trait(env, "hash") == Some("Hashable")
		and env_is_builtin_func(env, "hash")
		and env_is_builtin_func(env, "hash_combine")
		and hashable_types.all(func(typ):
			env_resolve_trait_obligation(
				env,
				trait_obligation(typ, test_trait_id("Hashable")),
			) == TraitObligationSatisfied
		)
	)


pure func test_builtin_trait_topology_matches_registered_traits() -> Bool:
	env = env_with_builtins(ENV_EMPTY)
	names = BUILTIN_TRAIT_NAMES

	(
		builtin_trait_topology_is_acyclic()
		and env.traits.length() == names.length()
		and env.traits.all(func(trait_definition):
			match builtin_trait_supertraits(trait_definition.name):
				Some(supertraits):
					(
						trait_definition.supertraits.map(
							func(id): env_get_trait_by_id(env, id).map(func(held): held.name).get_or(""),
						) == supertraits
						and supertraits.all(func(name): env_get_trait(env, name).is_some())
					)
				None:
					False
		)
		and names.all(func(name): env_get_trait(env, name).is_some())
	)


func test_special_inference_is_keyed_by_source_name_id_not_spelling() -> Bool:
	-- A spelling the vocabulary does not know, and the unseeded sentinel, are misses;
	-- every entry of the closed table is found by its pinned id.
	(
		builtin_special_inference(synthesized_name_id("not_a_builtin")).is_none()
		and builtin_special_inference(synthesized_name_id("vector_length")).is_some()
		and builtin_special_inference(synthesized_name_id("bit_xor")).is_some()
		and builtin_special_inference(synthesized_name_id("get")).is_none()
	)


func test_builtin_implementation_facts_preserve_installation_order() -> Bool:
	env = env_with_builtins(ENV_EMPTY)
	facts = builtin_implementation_facts()
	installed = env.impls.filter(func(item): item.is_builtin)
	-- Independent snapshot of the original installer, including duplicate
	-- receiver rows for distinct traits. Production has only one inventory.
	expected = [
		"Integer:Int", "SignedInteger:Int",
		"Integer:Int8", "SignedInteger:Int8", "Integer:Int16", "SignedInteger:Int16",
		"Integer:Int32", "SignedInteger:Int32", "Integer:Int128", "SignedInteger:Int128",
		"Integer:UInt8", "UnsignedInteger:UInt8", "Integer:UInt16", "UnsignedInteger:UInt16",
		"Integer:UInt32", "UnsignedInteger:UInt32", "Integer:UInt64", "UnsignedInteger:UInt64",
		"Integer:UInt128", "UnsignedInteger:UInt128",
		"FloatingPoint:Float", "FloatingPoint:Float32", "FloatingPoint:Float16", "FixedPointNumber:FixedPoint",
		"Stringable:String", "Addable:String", "Equatable:String", "Equatable:Bool",
		"Hashable:Int", "Hashable:Int8", "Hashable:Int16", "Hashable:Int32", "Hashable:Int64",
		"Hashable:UInt8", "Hashable:UInt16", "Hashable:UInt32", "Hashable:UInt64",
		"Hashable:Float", "Hashable:Float32", "Hashable:Float16", "Hashable:Bool",
		"Hashable:Char", "Hashable:String",
		"Orderable:String", "Orderable:Int", "Orderable:Float", "Orderable:Char",
	]
	-- The installer has 47 rows: integer families, floats, FixedPoint, String/Bool,
	-- primitive hashes and the four explicit Orderable implementations.
	var valid = facts.length() == expected.length() and installed.length() == facts.length()
	for indexed in facts.enumerate():
		match installed.get(indexed[0]):
			Some(item):
				row = match item.for_type:
					SemanticNamedType(name, []):
						env_get_trait_by_id(env, item.trait_id).map(func(held): held.name + ":" + name)
					_:
						None
				valid = (valid and trait_ids_equal(item.trait_id, builtin_implementation_fact_trait(indexed[1]))
					and types_equal(item.for_type, builtin_implementation_fact_receiver(indexed[1]))
					and item.bounds.is_empty() and item.methods.is_empty()
					and row == expected.get(indexed[0]))
			None:
				valid = False
	valid


private func builtin_evidence_registry_preserves_declaring_members() -> Result[Bool, String]:
	registry ?= builtin_trait_evidence_registry()
	members ?= builtin_trait_evidence_members(registry, TRAIT_ID_ORDERABLE)
	var inherited_equality: Bool = False
	for member in members:
		if builtin_trait_evidence_member_signature(member).name == "equals":
			inherited_equality = (trait_ids_equal(builtin_trait_evidence_member_declaring_trait(member), TRAIT_ID_EQUATABLE)
				and builtin_trait_evidence_member_ordinal(member) == 0)
	Ok(inherited_equality and match builtin_trait_evidence_members(registry, builtin_trait_id_at_registry_index(99)):
		Err(message): message == "compiler trait evidence identity is not registered"
		Ok(_): False
	)


func test_builtin_evidence_registry_preserves_declaring_members() -> Bool:
	builtin_evidence_registry_preserves_declaring_members().get_or(False)


private record BuiltinEvidenceExpectation {
	name: String,
	own_methods: List[String],
	parents: List[Int]
}


-- Independent installed-registry snapshot. Parent positions refer to this
-- golden order; own ordinals are never flattened inherited-list positions.
private pure func builtin_evidence_expectations() -> List[BuiltinEvidenceExpectation]:
	[
		{name = "Stringable", own_methods = ["to_string"], parents = []},
		{name = "Equatable", own_methods = ["equals"], parents = []},
		{name = "Orderable", own_methods = ["less_than"], parents = [1]},
		{name = "HasLength", own_methods = ["length"], parents = []},
		{name = "Integer", own_methods = ["checked_div", "checked_mod", "bit_and", "bit_or", "bit_xor", "bit_not", "shift_left", "shift_right"], parents = [6, 7, 8, 9, 10, 2, 12, 13, 0, 14, 15, 19]},
		{name = "FloatingPoint", own_methods = ["floor", "ceil", "round", "trunc", "sqrt", "sin", "cos", "tan", "asin", "acos", "atan", "atan2", "sinh", "cosh", "tanh", "asinh", "acosh", "atanh", "exp", "exp2", "expm1", "log", "log2", "log10", "log1p", "pow", "cbrt", "hypot", "fmod", "copysign", "fma", "is_nan", "is_inf", "is_finite"], parents = [6, 7, 8, 9, 10, 11, 2, 12, 13, 0, 14, 15, 20]},
		{name = "Addable", own_methods = ["add"], parents = []},
		{name = "Subtractable", own_methods = ["subtract"], parents = []},
		{name = "Multipliable", own_methods = ["multiply"], parents = []},
		{name = "Divisible", own_methods = ["divide"], parents = []},
		{name = "Modulable", own_methods = ["remainder"], parents = []},
		{name = "Negatable", own_methods = ["negate"], parents = []},
		{name = "HasZero", own_methods = ["zero"], parents = []},
		{name = "HasOne", own_methods = ["one"], parents = []},
		{name = "Absolute", own_methods = ["abs"], parents = []},
		{name = "Bounded", own_methods = ["min", "max"], parents = []},
		{name = "Hashable", own_methods = ["hash"], parents = [1]},
		{name = "ToBool", own_methods = ["to_bool"], parents = []},
		{name = "Logical", own_methods = ["logical_and", "logical_or", "logical_not"], parents = []},
		{name = "ToInt", own_methods = ["to_int"], parents = []},
		{name = "ToFloat", own_methods = ["to_float"], parents = []},
		{name = "ToFixedPoint", own_methods = ["to_fixed_point"], parents = []},
		{name = "ToChar", own_methods = ["to_char"], parents = []},
		{name = "SignedInteger", own_methods = [], parents = [4, 11]},
		{name = "UnsignedInteger", own_methods = [], parents = [4]},
		{name = "Numeric", own_methods = [], parents = [6, 8, 12]},
		{name = "FixedPointNumber", own_methods = ["get_scale", "round_to"], parents = [6, 7, 8, 9, 2, 12, 0, 14, 15]},
		{name = "Copyable", own_methods = ["copy"], parents = []},
		{name = "Cloneable", own_methods = ["clone"], parents = []},
	]


private pure func expected_builtin_evidence_traits(rows: List[BuiltinEvidenceExpectation], index: Int) -> List[Int]:
	var result = [index]
	match rows.get(index):
		Some(row):
			for parent in row.parents:
				for inherited in expected_builtin_evidence_traits(rows, parent):
					if not result.contains(inherited):
						result = result.append(inherited)
		None: void
	result


private pure func expected_builtin_evidence_members(rows: List[BuiltinEvidenceExpectation], index: Int) -> List[(Int, Int, String)]:
	var result: List[(Int, Int, String)] = []
	match rows.get(index):
		Some(row):
			for method in row.own_methods.enumerate():
				result = result.append((index, method[0], method[1]))
			for parent in row.parents:
				for inherited in expected_builtin_evidence_members(rows, parent):
					if not result.contains(inherited):
						result = result.append(inherited)
		None: void
	result


func test_prepared_registry_matches_independent_all_row_snapshot() -> Bool:
	rows = builtin_evidence_expectations()
	registry_result = builtin_trait_evidence_registry()
	var valid = rows.map(func(row): row.name) == BUILTIN_TRAIT_NAMES
	match registry_result:
		Err(_): valid = False
		Ok(registry):
			for indexed in rows.enumerate():
				id = builtin_trait_id_at_registry_index(indexed[0])
				expected_members = expected_builtin_evidence_members(rows, indexed[0])
				match builtin_trait_evidence_members(registry, id):
					Err(_): valid = False
					Ok(members):
						valid = valid and members.length() == expected_members.length()
						for actual in members.enumerate():
							match expected_members.get(actual[0]):
								None: valid = False
								Some(expected):
									valid = (valid
										and trait_ids_equal(builtin_trait_evidence_member_declaring_trait(actual[1]), builtin_trait_id_at_registry_index(expected[0]))
										and builtin_trait_evidence_member_ordinal(actual[1]) == expected[1]
										and builtin_trait_evidence_member_signature(actual[1]).name == expected[2])
				expected_traits = expected_builtin_evidence_traits(rows, indexed[0])
				for requested in rows.enumerate():
					match builtin_trait_evidence_satisfies(registry, id, builtin_trait_id_at_registry_index(requested[0])):
						Err(_): valid = False
						Ok(satisfied): valid = valid and satisfied == expected_traits.contains(requested[0])
	valid


