import:
	../../../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticDimOp(SemanticDimAdd, SemanticDimDivide, SemanticDimMultiply, SemanticDimSubtract),
		SemanticType(
			SemanticArrayType,
			SemanticConstIntType,
			SemanticDimOpType,
			SemanticFunctionType,
			SemanticMetaType,
			SemanticNamedType,
			SemanticRangeType,
			SemanticSelfType,
			SemanticTupleType,
			SemanticTypeVar,
			SemanticVarDimsType,
		),
		SemanticTypeVarKind(SemanticDimensionParameter, SemanticTypeParameter),
		SemanticTypeSubstEntry,
		TYPE_BOOL,
		TYPE_CHAR,
		TYPE_FLOAT,
		TYPE_INT,
		TYPE_STRING,
		TYPE_VOID,
		apply_subst,
		array_type,
		array_type_parts,
		canonical_module_type_name,
		qualify_module_local_types,
		collect_type_vars,
		is_dimension_parameter_name,
		semantic_type_variable_named,
		type_parameter_name_kind,
		type_parameter_name_without_sigil,
		display_type_name,
		is_any_float_type,
		is_any_integer_type,
		is_dim_type,
		is_global_abi_type_name,
		is_scalar_int_value_type,
		is_signed_integer_type,
		is_type_param_name,
		is_unsigned_integer_type,
		normalize_dim,
		normalize_type_name,
		occurs_in,
		scalar_int_value_type,
		semantic_function_type,
		type_contains_meta,
		type_instantiate_type_params,
		type_list,
		type_subst_entry,
		type_to_string,
		types_compatible_with_params,
		types_equal,
		validate_array_dims,
	test: TestSuite
	meta_support: test_meta, test_meta_context, test_meta_type


func test_type_to_string_simple() -> Bool:
	(
		type_to_string(TYPE_INT) == "Int"
		and type_to_string(TYPE_STRING) == "String"
		and type_to_string(TYPE_BOOL) == "Bool"
		and type_to_string(TYPE_VOID) == "Void"
		and type_to_string(TYPE_CHAR) == "Char"
	)


func test_type_to_string_parameterized_and_tuple() -> Bool:
	list_int: SemanticType = type_list(TYPE_INT)
	dict_type: SemanticType = SemanticNamedType(
		"Dict",
		[TYPE_STRING, TYPE_INT],
	)
	tuple_type: SemanticType = SemanticTupleType([TYPE_INT, TYPE_STRING])
	named_tuple: SemanticType = SemanticNamedType(
		"Tuple",
		[TYPE_INT, TYPE_STRING],
	)

	(
		type_to_string(list_int) == "List[Int]"
		and type_to_string(dict_type) == "Dict[String, Int]"
		and type_to_string(tuple_type) == "(Int, String)"
		and type_to_string(named_tuple) == "(Int, String)"
	)


func test_type_to_string_function_array_and_dims() -> Bool:
	impure_func: SemanticType = semantic_function_type(
		False,
		[TYPE_INT, TYPE_STRING],
		TYPE_BOOL,
	)
	pure_func: SemanticType = semantic_function_type(True, [TYPE_INT], TYPE_INT)
	function_array: SemanticType = array_type(pure_func, [SemanticConstIntType(3)])
	dim_expr: SemanticType = SemanticDimOpType(
		SemanticDimAdd,
		SemanticTypeVar("#N", SemanticDimensionParameter),
		SemanticConstIntType(1),
	)

	(
		type_to_string(impure_func) == "(Int, String) -> Bool"
		and type_to_string(pure_func) == "pure (Int) -> Int"
		and type_to_string(function_array) == "(pure (Int) -> Int)[#3]"
		and type_to_string(SemanticRangeType(SemanticConstIntType(3))) == "..#3"
		and type_to_string(SemanticVarDimsType("#Ds")) == "#Ds..."
		and type_to_string(dim_expr) == "#N + #1"
		and type_to_string(test_meta_type(4)) == "?m4"
		and type_to_string(SemanticSelfType) == "Self"
	)


func test_type_contains_meta_checks_nested_types() -> Bool:
	with_meta: SemanticType = semantic_function_type(
		True,
		[
			SemanticNamedType(
				"List",
				[SemanticArrayType(test_meta_type(1), [SemanticConstIntType(3)])],
			),
		],
		SemanticDimOpType(SemanticDimAdd, SemanticConstIntType(1), test_meta_type(2)),
	)
	without_meta: SemanticType = semantic_function_type(
		True,
		[SemanticNamedType("List", [SemanticArrayType(TYPE_INT, [SemanticConstIntType(3)])])],
		SemanticDimOpType(SemanticDimAdd, SemanticConstIntType(1), SemanticConstIntType(2)),
	)

	type_contains_meta(with_meta) and not type_contains_meta(without_meta)


func test_type_contains_meta_scans_late_list_elements() -> Bool:
	meta = test_meta_type(1)

	type_contains_meta(
		SemanticNamedType(
			"Pair",
			[TYPE_INT, meta],
		),
	) and type_contains_meta(
		SemanticArrayType(
			TYPE_INT,
			[SemanticConstIntType(2), meta],
		),
	) and type_contains_meta(
		SemanticFunctionType(
			True,
			[TYPE_INT, meta],
			TYPE_INT,
		),
	) and type_contains_meta(
		SemanticTupleType(
			[
				TYPE_INT,
				meta,
			],
		),
	) and not type_contains_meta(
		SemanticTupleType(
			[TYPE_INT, TYPE_STRING],
		),
	) and not type_contains_meta(SemanticTupleType([]))


func test_canonical_type_display() -> Bool:
	canonical: String = canonical_module_type_name("pkg/math", "Point")

	canonical == "pkg/math::Point" and display_type_name(canonical) == "pkg/math.Point"


func test_std_duration_type_is_module_owned() -> Bool:
	(
		not is_global_abi_type_name("Duration")
		and canonical_module_type_name("units", "Duration") == "units::Duration"
	)


func test_native_nominal_types_keep_module_identity() -> Bool:
	names: List[String] = ["IpAddress", "DnsName", "InterfaceScope"]
	(
		names.all(func(name):
			(
				not is_global_abi_type_name(name)
				and canonical_module_type_name("net/tcp", name) == "net/tcp::" + name
				and canonical_module_type_name("consumer", name) == "consumer::" + name
				and not types_equal(
					SemanticNamedType(canonical_module_type_name("net/tcp", name), []),
					SemanticNamedType(canonical_module_type_name("consumer", name), []),
				)
			)
		)
		and canonical_module_type_name("string", "String") == "String"
		and canonical_module_type_name("list", "List") == "List"
		and canonical_module_type_name("int", "Int") == "Int"
	)


func test_native_nominal_qualification_preserves_nested_types() -> Bool:
	names: List[String] = ["IpAddress", "DnsName", "InterfaceScope"]
	names.all(func(name):
		local_type: SemanticType = SemanticNamedType(name, [])
		qualified: SemanticType = SemanticNamedType("net/tcp::" + name, [])
		local_signature: SemanticType = SemanticFunctionType(
			True, [SemanticNamedType("Option", [local_type])], local_type,
		)
		expected: SemanticType = SemanticFunctionType(
			True, [SemanticNamedType("Option", [qualified])], qualified,
		)
		types_equal(qualify_module_local_types("net/tcp", names, local_signature), expected)
	)


func test_types_equal_basic_and_tensor_normalization() -> Bool:
	vector: SemanticType = SemanticNamedType(
		"Vector",
		[TYPE_FLOAT, SemanticConstIntType(3)],
	)
	tensor: SemanticType = SemanticNamedType(
		"Tensor",
		[TYPE_FLOAT, SemanticConstIntType(3)],
	)
	matrix: SemanticType = SemanticNamedType(
		"Matrix",
		[TYPE_FLOAT, SemanticConstIntType(3)],
	)

	(
		types_equal(TYPE_INT, TYPE_INT)
		and not types_equal(TYPE_INT, TYPE_STRING)
		and normalize_type_name("Vector") == "Tensor"
		and normalize_type_name("Matrix") == "Tensor"
		and types_equal(vector, tensor)
		and types_equal(vector, matrix)
	)


func test_types_equal_tuple_function_and_array_forms() -> Bool:
	tuple_type: SemanticType = SemanticTupleType([TYPE_INT, TYPE_STRING])
	named_tuple: SemanticType = SemanticNamedType(
		"Tuple",
		[TYPE_INT, TYPE_STRING],
	)
	pure_fn: SemanticType = SemanticFunctionType(True, [TYPE_INT], TYPE_BOOL)
	impure_fn: SemanticType = SemanticFunctionType(False, [TYPE_INT], TYPE_BOOL)
	array_type: SemanticType = SemanticArrayType(TYPE_FLOAT, [SemanticConstIntType(3)])
	tensor_type: SemanticType = SemanticNamedType(
		"Tensor",
		[TYPE_FLOAT, SemanticConstIntType(3)],
	)
	zero_dim_tensor: SemanticType = SemanticNamedType("Tensor", [TYPE_INT])

	(
		types_equal(tuple_type, named_tuple)
		and types_equal(named_tuple, tuple_type)
		and types_equal(pure_fn, pure_fn)
		and not types_equal(pure_fn, impure_fn)
		and types_equal(array_type, tensor_type)
		and types_equal(zero_dim_tensor, TYPE_INT)
	)


func test_variable_equality_respects_kind_without_reading_spelling() -> Bool:
	var equalities_hold = True

	for name in ["Parameter", "#Parameter"]:
		type_parameter = SemanticTypeVar(name, SemanticTypeParameter)
		dimension_parameter = SemanticTypeVar(name, SemanticDimensionParameter)

		equalities_hold = (
			equalities_hold
			and types_equal(type_parameter, SemanticTypeVar(name, SemanticTypeParameter))
			and types_equal(dimension_parameter, SemanticTypeVar(name, SemanticDimensionParameter))
			and not types_equal(type_parameter, dimension_parameter)
			and not types_equal(dimension_parameter, type_parameter)
			and not types_equal(type_parameter, SemanticTypeVar("Other", SemanticTypeParameter))
			and not types_equal(dimension_parameter, SemanticTypeVar("Other", SemanticDimensionParameter))
		)

	equalities_hold


func test_nested_structural_equality_preserves_variable_kind() -> Bool:
	type_parameter = SemanticTypeVar("Parameter", SemanticTypeParameter)
	dimension_parameter = SemanticTypeVar("Parameter", SemanticDimensionParameter)
	type_wrapper = SemanticNamedType("Wrapper", [SemanticTupleType([type_parameter])])
	dimension_wrapper = SemanticNamedType("Wrapper", [SemanticTupleType([dimension_parameter])])
	type_function = SemanticFunctionType(True, [type_wrapper], TYPE_INT)
	dimension_function = SemanticFunctionType(True, [dimension_wrapper], TYPE_INT)

	(
		not types_equal(type_function, dimension_function)
		and not types_equal(dimension_function, type_function)
	)


func test_array_types_equal_mismatched_dims_and_nesting() -> Bool:
	short_dims: SemanticType = SemanticArrayType(TYPE_FLOAT, [SemanticConstIntType(3)])
	long_dims: SemanticType = SemanticArrayType(
		TYPE_FLOAT,
		[SemanticConstIntType(3), SemanticConstIntType(4)],
	)
	nested_a: SemanticType = SemanticArrayType(
		SemanticArrayType(TYPE_INT, [SemanticConstIntType(2)]),
		[SemanticConstIntType(3)],
	)
	nested_b: SemanticType = SemanticArrayType(
		SemanticArrayType(TYPE_INT, [SemanticConstIntType(2)]),
		[SemanticConstIntType(3)],
	)
	nested_mismatch: SemanticType = SemanticArrayType(
		SemanticArrayType(TYPE_STRING, [SemanticConstIntType(2)]),
		[SemanticConstIntType(3)],
	)

	(
		not types_equal(short_dims, long_dims)
		and not types_equal(long_dims, short_dims)
		and types_equal(nested_a, nested_b)
		and not types_equal(nested_a, nested_mismatch)
	)


func test_types_equal_named_tensor_family_and_array_forms() -> Bool:
	dims: List[SemanticType] = [SemanticConstIntType(3)]
	tensor_type: SemanticType = SemanticNamedType(
		"Tensor",
		[TYPE_FLOAT, SemanticConstIntType(3)],
	)
	vector_type: SemanticType = SemanticNamedType(
		"Vector",
		[TYPE_FLOAT, SemanticConstIntType(3)],
	)
	matrix_type: SemanticType = SemanticNamedType(
		"Matrix",
		[TYPE_FLOAT, SemanticConstIntType(3)],
	)
	array_type: SemanticType = SemanticArrayType(TYPE_FLOAT, dims)

	(
		types_equal(tensor_type, tensor_type)
		and types_equal(tensor_type, array_type)
		and types_equal(array_type, tensor_type)
		and types_equal(vector_type, array_type)
		and types_equal(array_type, vector_type)
		and types_equal(matrix_type, array_type)
		and types_equal(array_type, matrix_type)
	)


func test_types_equal_distinguishes_meta_sessions_and_slots() -> Bool:
	context = test_meta_context()
	other_context = test_meta_context()

	(
		types_equal(test_meta(context, 4), test_meta(context, 4))
		and not types_equal(test_meta(context, 4), test_meta(context, 5))
		and not types_equal(test_meta(context, 4), test_meta(other_context, 4))
	)


func test_array_type_parts() -> Bool:
	array_type: SemanticType = SemanticArrayType(TYPE_FLOAT, [SemanticConstIntType(4)])
	tensor_type: SemanticType = SemanticNamedType(
		"Tensor",
		[TYPE_FLOAT, SemanticConstIntType(4)],
	)

	match (array_type_parts(array_type), array_type_parts(tensor_type)):
		(Some(array_parts), Some(tensor_parts)):
			types_equal(array_parts[0], tensor_parts[0]) and types_equal(
				array_parts[1].get_or(0, SemanticSelfType),
				tensor_parts[1].get_or(0, SemanticSelfType),
			)
		_:
			False


func test_numeric_predicates() -> Bool:
	(
		is_any_integer_type(TYPE_INT)
		and is_signed_integer_type(TYPE_INT)
		and is_unsigned_integer_type(SemanticNamedType("UInt32", []))
		and not is_unsigned_integer_type(TYPE_INT)
		and is_any_float_type(TYPE_FLOAT)
		and is_any_float_type(SemanticNamedType("Float16", []))
		and not is_any_float_type(TYPE_INT)
	)


func test_dim_const_and_type_var_predicates() -> Bool:
	(
		is_dim_type(SemanticConstIntType(4))
		and is_dim_type(SemanticTypeVar("#N", SemanticDimensionParameter))
		and not is_dim_type(SemanticTypeVar("T", SemanticTypeParameter))
	)


func test_dim_named_and_variadic_predicates() -> Bool:
	(
		is_dim_type(SemanticNamedType("#N", []))
		and is_dim_type(SemanticVarDimsType("#Ds"))
		and not is_dim_type(TYPE_INT)
	)


func test_dim_range_and_operation_predicates() -> Bool:
	(
		is_dim_type(SemanticRangeType(SemanticConstIntType(8)))
		and is_dim_type(
			SemanticDimOpType(
				SemanticDimMultiply,
				SemanticTypeVar("#M", SemanticDimensionParameter),
				SemanticTypeVar("#N", SemanticDimensionParameter),
			),
		)
	)


func test_scalar_dim_value_lifting() -> Bool:
	(
		types_equal(scalar_int_value_type(SemanticConstIntType(3)), TYPE_INT)
		and types_equal(scalar_int_value_type(SemanticRangeType(SemanticConstIntType(8))), TYPE_INT)
		and types_equal(scalar_int_value_type(SemanticTypeVar("#N", SemanticDimensionParameter)), TYPE_INT)
		and types_equal(scalar_int_value_type(SemanticNamedType("#N", [])), TYPE_INT)
		and types_equal(
			scalar_int_value_type(SemanticVarDimsType("#Ds")),
			SemanticVarDimsType("#Ds"),
		)
		and is_scalar_int_value_type(SemanticConstIntType(3))
		and not is_scalar_int_value_type(TYPE_STRING)
	)


func test_collect_type_vars() -> Bool:
	typ: SemanticType = SemanticFunctionType(
		True,
		[
			SemanticTypeVar("T", SemanticTypeParameter),
			SemanticNamedType("U", []),
			SemanticArrayType(TYPE_INT, [SemanticTypeVar("#N", SemanticDimensionParameter)]),
		],
		SemanticTupleType([SemanticVarDimsType("#Ds"), TYPE_STRING]),
	)
	vars: List[String] = collect_type_vars(typ)

	(
		vars.contains("T")
		and vars.contains("U")
		and vars.contains("#N")
		and vars.contains("#Ds")
		and vars.length() == 4
	)


func test_type_param_name_helpers() -> Bool:
	(
		is_type_param_name("T")
		and not is_type_param_name("T:Stringable")
		and not is_type_param_name("Text")
		and type_parameter_name_without_sigil("#N") == "N"
		and type_parameter_name_without_sigil("N") == "N"
		and type_parameter_name_without_sigil("#") == ""
		and type_parameter_name_kind("#N") == SemanticDimensionParameter
		and type_parameter_name_kind("T") == SemanticTypeParameter
		and is_dimension_parameter_name("#N")
		and not is_dimension_parameter_name("N")
		and match semantic_type_variable_named("#N"):
			SemanticTypeVar(_, SemanticDimensionParameter):
				True
			_:
				False
	)


func test_instantiate_type_params_rewrites_nested_bare_names() -> Bool:
	source: SemanticType = SemanticFunctionType(
		True,
		[SemanticNamedType("Box", [SemanticNamedType("T", [])]), SemanticArrayType(
				SemanticNamedType("U", []),
				[SemanticNamedType("#N", [])],
			)],
		SemanticTupleType([
			SemanticNamedType("T", [SemanticNamedType("T", [])]),
			SemanticNamedType(
				"Triple",
				[TYPE_INT, SemanticNamedType("T", []), TYPE_STRING],
			),
			SemanticRangeType(SemanticNamedType("#N", [])),
			SemanticDimOpType(
				SemanticDimAdd,
				SemanticNamedType("#N", []),
				SemanticConstIntType(1),
			),
			SemanticVarDimsType("#Ds"),
		]),
	)
	expected: SemanticType = SemanticFunctionType(
		True,
		[SemanticNamedType("Box", [SemanticTypeVar("T", SemanticTypeParameter)]), SemanticArrayType(
				SemanticNamedType("U", []),
				[SemanticTypeVar("#N", SemanticDimensionParameter)],
			)],
		SemanticTupleType([
			SemanticNamedType("T", [SemanticTypeVar("T", SemanticTypeParameter)]),
			SemanticNamedType(
				"Triple",
				[TYPE_INT, SemanticTypeVar("T", SemanticTypeParameter), TYPE_STRING],
			),
			SemanticRangeType(SemanticTypeVar("#N", SemanticDimensionParameter)),
			SemanticDimOpType(SemanticDimAdd, SemanticTypeVar("#N", SemanticDimensionParameter), SemanticConstIntType(1)),
			SemanticVarDimsType("#Ds"),
		]),
	)
	source_before: String = type_to_string(source)
	instantiated: SemanticType = type_instantiate_type_params(
		["T", "#N"],
		source,
	)
	source_after: String = type_to_string(source)

	types_equal(instantiated, expected) and source_after == source_before


func test_instantiate_type_params_preserves_unmatched_shapes() -> Bool:
	source: SemanticType = SemanticTupleType([
		SemanticNamedType("List", [TYPE_INT]),
		SemanticArrayType(
			SemanticNamedType(
				"U",
				[],
			),
			[SemanticConstIntType(4), SemanticVarDimsType("#Ds")],
		),
		SemanticSelfType,
		test_meta_type(7),
		SemanticTypeVar("T", SemanticTypeParameter),
	])

	types_equal(
		type_instantiate_type_params(
			["T", "#Ds"],
			source,
		),
		source,
	) and types_equal(
		type_instantiate_type_params([], source),
		source,
	)


func test_apply_subst_basic_and_nested() -> Bool:
	subst: List[SemanticTypeSubstEntry] = [type_subst_entry("T", TYPE_INT)]
	direct: SemanticType = apply_subst(subst, SemanticTypeVar("T", SemanticTypeParameter))
	unchanged: SemanticType = apply_subst(subst, SemanticTypeVar("U", SemanticTypeParameter))
	nested: SemanticType = apply_subst(subst, type_list(SemanticTypeVar("T", SemanticTypeParameter)))

	(
		types_equal(direct, TYPE_INT)
		and types_equal(unchanged, SemanticTypeVar("U", SemanticTypeParameter))
		and types_equal(nested, type_list(TYPE_INT))
	)


func test_apply_subst_chained_and_cycle_safe() -> Bool:
	chained: List[SemanticTypeSubstEntry] = [
		type_subst_entry("T", SemanticTypeVar("U", SemanticTypeParameter)),
		type_subst_entry("U", TYPE_INT),
	]
	cyclic: List[SemanticTypeSubstEntry] = [
		type_subst_entry("T", SemanticTypeVar("U", SemanticTypeParameter)),
		type_subst_entry("U", SemanticTypeVar("T", SemanticTypeParameter)),
	]
	chained_result: SemanticType = apply_subst(chained, SemanticTypeVar("T", SemanticTypeParameter))
	cyclic_result: SemanticType = apply_subst(cyclic, SemanticTypeVar("T", SemanticTypeParameter))

	types_equal(chained_result, TYPE_INT) and types_equal(cyclic_result, SemanticTypeVar("T", SemanticTypeParameter))


func test_apply_subst_function_and_self_names() -> Bool:
	subst: List[SemanticTypeSubstEntry] = [
		type_subst_entry("A", TYPE_INT),
		type_subst_entry("B", TYPE_STRING),
		type_subst_entry("Self", TYPE_BOOL),
	]
	func_type: SemanticType = semantic_function_type(
		True,
		[SemanticTypeVar("A", SemanticTypeParameter)],
		SemanticTypeVar("B", SemanticTypeParameter),
	)
	expected_func: SemanticType = semantic_function_type(True, [TYPE_INT], TYPE_STRING)

	types_equal(
		apply_subst(subst, func_type),
		expected_func,
	) and types_equal(
		apply_subst(subst, SemanticSelfType),
		TYPE_BOOL,
	)


func test_occurs_in() -> Bool:
	nested: SemanticType = type_list(SemanticTypeVar("T", SemanticTypeParameter))
	func_type: SemanticType = semantic_function_type(
		False,
		[SemanticTypeVar("A", SemanticTypeParameter)],
		SemanticTypeVar("B", SemanticTypeParameter),
	)

	(
		occurs_in("T", SemanticTypeVar("T", SemanticTypeParameter))
		and occurs_in("T", nested)
		and occurs_in("A", func_type)
		and occurs_in("B", func_type)
		and not occurs_in("T", TYPE_INT)
	)


func test_normalize_dim_arithmetic() -> Bool:
	n: SemanticType = SemanticTypeVar("#N", SemanticDimensionParameter)

	(
		types_equal(
			normalize_dim(
				SemanticDimOpType(
					SemanticDimAdd,
					SemanticConstIntType(2),
					SemanticConstIntType(3),
				),
			),
			SemanticConstIntType(5),
		)
		and types_equal(
			normalize_dim(SemanticDimOpType(SemanticDimSubtract, n, n)),
			SemanticConstIntType(0),
		)
		and types_equal(
			normalize_dim(SemanticDimOpType(SemanticDimMultiply, n, SemanticConstIntType(1))),
			n,
		)
		and types_equal(
			normalize_dim(
				SemanticDimOpType(
					SemanticDimDivide,
					SemanticConstIntType(8),
					SemanticConstIntType(2),
				),
			),
			SemanticConstIntType(4),
		)
	)


func test_apply_subst_normalizes_dim_ops() -> Bool:
	subst: List[SemanticTypeSubstEntry] = [type_subst_entry("#N", SemanticConstIntType(2))]
	dim_expr: SemanticType = SemanticDimOpType(
		SemanticDimAdd,
		SemanticTypeVar("#N", SemanticDimensionParameter),
		SemanticConstIntType(3),
	)

	types_equal(
		apply_subst(subst, dim_expr),
		SemanticConstIntType(5),
	)


func test_apply_empty_subst_normalizes_dim_ops() -> Bool:
	dim_expr: SemanticType = SemanticDimOpType(
		SemanticDimAdd,
		SemanticConstIntType(2),
		SemanticConstIntType(3),
	)

	top_level_normalized = match apply_subst([], dim_expr):
		SemanticConstIntType(5):
			True
		_:
			False

	nested_normalized = match apply_subst(
		[],
		SemanticArrayType(TYPE_INT, [dim_expr]),
	):
		SemanticArrayType(SemanticNamedType("Int", []), [SemanticConstIntType(5)]):
			True
		_:
			False

	top_level_normalized and nested_normalized


func test_validate_array_dims_accepts_valid_arrays() -> Bool:
	array_type: SemanticType = SemanticArrayType(
		TYPE_INT,
		[SemanticTypeVar("#N", SemanticDimensionParameter), SemanticConstIntType(3)],
	)
	tensor_type: SemanticType = SemanticNamedType(
		"Tensor",
		[TYPE_FLOAT, SemanticTypeVar("#N", SemanticDimensionParameter), SemanticVarDimsType("#Ds")],
	)

	(
		validate_array_dims(["#N"], array_type) == None
		and validate_array_dims(["#N"], tensor_type) == None
	)


func test_validate_array_dims_rejects_invalid_dim_type() -> Bool:
	array_type: SemanticType = SemanticArrayType(TYPE_INT, [TYPE_STRING])
	tensor_type: SemanticType = SemanticNamedType(
		"Tensor",
		[TYPE_FLOAT, TYPE_STRING],
	)

	match (validate_array_dims([], array_type), validate_array_dims([], tensor_type)):
		(Some(array_error), Some(tensor_error)):
			(
				array_error.contains("Array dimension argument must be a dimension type")
				and array_error.contains("String")
				and tensor_error.contains("Tensor dimension argument must be a dimension type")
				and tensor_error.contains("String")
			)
		_:
			False


func test_validate_array_dims_rejects_non_positive_dims() -> Bool:
	zero_dim: SemanticType = SemanticArrayType(TYPE_INT, [SemanticConstIntType(0)])
	negative_expr: SemanticType = SemanticArrayType(
		TYPE_INT,
		[SemanticDimOpType(SemanticDimSubtract, SemanticConstIntType(2), SemanticConstIntType(3))],
	)

	match (validate_array_dims([], zero_dim), validate_array_dims([], negative_expr)):
		(Some(zero_error), Some(negative_error)):
			(
				zero_error.contains("non-positive result: 0")
				and negative_error.contains("non-positive result: -1")
			)
		_:
			False


func test_validate_array_dims_rejects_variadic_placement() -> Bool:
	multiple: SemanticType = SemanticArrayType(
		TYPE_INT,
		[SemanticVarDimsType("#A"), SemanticVarDimsType("#B")],
	)
	not_last: SemanticType = SemanticArrayType(
		TYPE_INT,
		[SemanticVarDimsType("#A"), SemanticTypeVar("#N", SemanticDimensionParameter)],
	)
	vector: SemanticType = SemanticNamedType(
		"Vector",
		[TYPE_FLOAT, SemanticVarDimsType("#Ds")],
	)
	matrix: SemanticType = SemanticNamedType(
		"Matrix",
		[TYPE_FLOAT, SemanticVarDimsType("#Ds")],
	)

	match (
		validate_array_dims([], multiple),
		validate_array_dims([], not_last),
		validate_array_dims([], vector),
		validate_array_dims([], matrix),
	):
		(Some(multiple_error), Some(not_last_error), Some(vector_error), Some(matrix_error)):
			(
				multiple_error.contains("multiple variadic dims")
				and not_last_error.contains("must be the last")
				and vector_error.contains("Vector does not support variadic dimensions")
				and matrix_error.contains("Matrix does not support variadic dimensions")
			)
		_:
			False


func test_validate_array_dims_rejects_scalar_type_args() -> Bool:
	scalar_with_arg: SemanticType = SemanticNamedType("Int", [TYPE_STRING])

	match validate_array_dims([], scalar_with_arg):
		Some(error):
			(
				error.contains("Array dimension argument must be a dimension type")
				and error.contains("String")
			)
		None:
			False


func test_dim_wildcard_accepts_any_concrete_dimension() -> Bool:
	expected: SemanticType = SemanticArrayType(SemanticTypeVar("T", SemanticTypeParameter), [SemanticTypeVar("#_", SemanticDimensionParameter)])
	actual: SemanticType = SemanticArrayType(TYPE_INT, [SemanticConstIntType(3)])

	types_compatible_with_params(["T"], expected, actual)


func test_dimension_value_is_compatible_with_int() -> Bool:
	(
		types_compatible_with_params([], TYPE_INT, SemanticTypeVar("#N", SemanticDimensionParameter))
		and types_compatible_with_params([], TYPE_INT, SemanticRangeType(SemanticConstIntType(8)))
		and not types_compatible_with_params([], TYPE_STRING, SemanticTypeVar("#N", SemanticDimensionParameter))
	)


func test_range_accepts_only_proven_literal_values() -> Bool:
	expected = SemanticRangeType(SemanticConstIntType(8))

	(
		types_compatible_with_params([], expected, SemanticConstIntType(0))
		and types_compatible_with_params([], expected, SemanticConstIntType(7))
		and not types_compatible_with_params([], expected, SemanticConstIntType(-1))
		and not types_compatible_with_params([], expected, SemanticConstIntType(8))
		and not types_compatible_with_params([], expected, TYPE_INT)
	)


func test_variadic_dims_accept_any_concrete_rank_one_way() -> Bool:
	expected: SemanticType = SemanticArrayType(TYPE_FLOAT, [SemanticVarDimsType("#Ds")])
	actual_vector: SemanticType = SemanticArrayType(TYPE_FLOAT, [SemanticConstIntType(3)])
	actual_matrix: SemanticType = SemanticArrayType(
		TYPE_FLOAT,
		[SemanticConstIntType(3), SemanticConstIntType(4)],
	)

	(
		types_compatible_with_params([], expected, actual_vector)
		and types_compatible_with_params([], expected, actual_matrix)
		and not types_compatible_with_params([], actual_vector, expected)
	)


func test_variadic_dims_preserve_fixed_prefix() -> Bool:
	expected: SemanticType = SemanticArrayType(
		TYPE_FLOAT,
		[SemanticConstIntType(2), SemanticVarDimsType("#Ds")],
	)
	matching: SemanticType = SemanticArrayType(
		TYPE_FLOAT,
		[SemanticConstIntType(2), SemanticConstIntType(3), SemanticConstIntType(4)],
	)
	prefix_only: SemanticType = SemanticArrayType(TYPE_FLOAT, [SemanticConstIntType(2)])
	wrong_prefix: SemanticType = SemanticArrayType(
		TYPE_FLOAT,
		[SemanticConstIntType(3), SemanticConstIntType(4)],
	)

	(
		types_compatible_with_params([], expected, matching)
		and types_compatible_with_params([], expected, prefix_only)
		and not types_compatible_with_params([], expected, wrong_prefix)
		and not types_compatible_with_params([], matching, expected)
	)


func test_function_purity_compatibility_is_recursive() -> Bool:
	impure_callback = SemanticFunctionType(False, [TYPE_INT], TYPE_INT)
	pure_callback = SemanticFunctionType(True, [TYPE_INT], TYPE_INT)
	expected = SemanticTupleType([impure_callback, impure_callback])
	actual = SemanticTupleType([pure_callback, pure_callback])

	(
		types_compatible_with_params([], expected, actual)
		and not types_compatible_with_params([], actual, expected)
	)


func test_function_parameter_compatibility_is_contravariant() -> Bool:
	impure_callback = SemanticFunctionType(False, [TYPE_INT], TYPE_INT)
	pure_callback = SemanticFunctionType(True, [TYPE_INT], TYPE_INT)
	expected = SemanticFunctionType(False, [impure_callback], TYPE_INT)
	narrower_actual = SemanticFunctionType(True, [pure_callback], TYPE_INT)

	not types_compatible_with_params([], expected, narrower_actual)


