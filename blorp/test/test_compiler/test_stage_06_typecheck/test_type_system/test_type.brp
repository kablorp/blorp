		("type contains meta checks nested types", test_type_contains_meta_checks_nested_types),
		(
			"type contains meta scans late list elements",
			test_type_contains_meta_scans_late_list_elements,
		),
		("canonical type display", test_canonical_type_display),
		("native nominal types retain module identity", test_native_nominal_types_keep_module_identity),
		("native nominal qualification preserves nested types", test_native_nominal_qualification_preserves_nested_types),
		("std Duration type is module-owned", test_std_duration_type_is_module_owned),
		(
			"types_equal basic and tensor normalization",
			test_types_equal_basic_and_tensor_normalization,
		),
		(
			"types_equal tuple function and array forms",
			test_types_equal_tuple_function_and_array_forms,
		),
		(
			"variable equality respects kind without reading spelling",
			test_variable_equality_respects_kind_without_reading_spelling,
		),
		(
			"nested structural equality preserves variable kind",
			test_nested_structural_equality_preserves_variable_kind,
		),
		(
			"array types equal mismatched dims and nesting",
			test_array_types_equal_mismatched_dims_and_nesting,
		),
		(
			"types equal named tensor family and array forms",
			test_types_equal_named_tensor_family_and_array_forms,
		),
		(
			"types equal distinguishes meta sessions and slots",
			test_types_equal_distinguishes_meta_sessions_and_slots,
		),
		("array type parts", test_array_type_parts),
		("numeric predicates", test_numeric_predicates),
		("dim const and type var predicates", test_dim_const_and_type_var_predicates),
		("dim named and variadic predicates", test_dim_named_and_variadic_predicates),
		("dim range and operation predicates", test_dim_range_and_operation_predicates),
		("scalar dim value lifting", test_scalar_dim_value_lifting),
		("collect type vars", test_collect_type_vars),
		("type parameter name helpers", test_type_param_name_helpers),
		(
			"instantiate type params rewrites nested bare names",
			test_instantiate_type_params_rewrites_nested_bare_names,
		),
		(
			"instantiate type params preserves unmatched shapes",
			test_instantiate_type_params_preserves_unmatched_shapes,
		),
		("apply subst basic and nested", test_apply_subst_basic_and_nested),
		("apply subst chained and cycle safe", test_apply_subst_chained_and_cycle_safe),
		(
			"apply subst function and self names",
			test_apply_subst_function_and_self_names,
		),
		("occurs in", test_occurs_in),
		("normalize dim arithmetic", test_normalize_dim_arithmetic),
		("apply subst normalizes dim ops", test_apply_subst_normalizes_dim_ops),
		("empty subst normalizes dim ops", test_apply_empty_subst_normalizes_dim_ops),
		("validate array dims accepts valid arrays", test_validate_array_dims_accepts_valid_arrays),
		(
			"validate array dims rejects invalid dim type",
			test_validate_array_dims_rejects_invalid_dim_type,
		),
		(
			"validate array dims rejects non-positive dims",
			test_validate_array_dims_rejects_non_positive_dims,
		),
		(
			"validate array dims rejects variadic placement",
			test_validate_array_dims_rejects_variadic_placement,
		),
		(
			"validate array dims rejects scalar type args",
			test_validate_array_dims_rejects_scalar_type_args,
