private func shared_pattern_match_retains_dependency() -> Option[Bool]:
	parameter = SemanticNamedType("T", [])
	actual = SemanticNamedType("Int", [])
	bounds = [test_bound_type_param("T", ["Stringable"])]
	matched ?= implementation_pattern_match(
		SemanticNamedType("Pair", [parameter, parameter]),
		bounds,
		SemanticNamedType("Pair", [actual, actual]),
	)
	substituted ?= lookup_subst("T", implementation_pattern_match_substitution(matched))
	dependency ?= implementation_pattern_match_dependencies(matched, bounds).get(0)
	Some(types_equal(substituted, actual) and match dependency:
		InstantiatedBoundDependency(position, typ, identity):
			(
				position.parameter_index == 0
				and position.bound_index == 0
				and types_equal(typ, actual)
				and bound_trait_identities_equal(identity, test_bound_trait_identity("Stringable"))
			)
		_:
			False
	)


func test_shared_pattern_match_retains_dependency() -> Bool:
	shared_pattern_match_retains_dependency().get_or(False)


func test_shared_pattern_match_rejects_conflicting_repetition() -> Bool:
	parameter = SemanticNamedType("T", [])
	implementation_pattern_match(
		SemanticNamedType("Pair", [parameter, parameter]),
		[test_bound_type_param("T", [])],
		SemanticNamedType("Pair", [SemanticNamedType("Int", []), SemanticNamedType("String", [])]),
	).is_none()


private func shared_pattern_match_preserves_phantom_admission() -> Option[Bool]:
	receiver = SemanticNamedType("Marker", [])
	bounds = [test_bound_type_param("Unused", ["Stringable"])]
	matched ?= implementation_pattern_match(receiver, bounds, receiver)
	dependency ?= implementation_pattern_match_dependencies(matched, bounds).get(0)
	Some(match dependency:
		UninstantiatedBoundDependency(position, identity):
			(
				position.parameter_index == 0
				and position.bound_index == 0
				and bound_trait_identities_equal(identity, test_bound_trait_identity("Stringable"))
				and implementation_pattern_matches_with(receiver, bounds, receiver, pure func(_obligation, _identity): False)
			)
		_:
			False
	)


func test_shared_pattern_match_preserves_phantom_admission() -> Bool:
	shared_pattern_match_preserves_phantom_admission().get_or(False)


private func shared_pattern_match_preserves_dependency_order() -> Option[Bool]:
	pattern = SemanticNamedType("Pair", [SemanticNamedType("T", []), SemanticNamedType("U", [])])
	receiver = SemanticNamedType("Pair", [TYPE_INT, TYPE_STRING])
	bounds = [
		test_bound_type_param("T", ["Equatable", "Stringable"]),
		test_bound_type_param("U", ["Stringable"]),
	]
	matched ?= implementation_pattern_match(pattern, bounds, receiver)
	dependencies = implementation_pattern_match_dependencies(matched, bounds)
	first ?= dependencies.get(0)
	second ?= dependencies.get(1)
	third ?= dependencies.get(2)
	positions_preserved = match (first, second, third):
		(
			InstantiatedBoundDependency(first_position, first_type, first_identity),
			InstantiatedBoundDependency(second_position, second_type, second_identity),
			InstantiatedBoundDependency(third_position, third_type, third_identity),
		):
			(
				first_position.parameter_index == 0 and first_position.bound_index == 0
				and second_position.parameter_index == 0 and second_position.bound_index == 1
				and third_position.parameter_index == 1 and third_position.bound_index == 0
				and types_equal(first_type, TYPE_INT) and types_equal(second_type, TYPE_INT)
				and types_equal(third_type, TYPE_STRING)
				and bound_trait_identities_equal(first_identity, test_bound_trait_identity("Equatable"))
				and bound_trait_identities_equal(second_identity, test_bound_trait_identity("Stringable"))
				and bound_trait_identities_equal(third_identity, test_bound_trait_identity("Stringable"))
			)
		_:
			False
	-- The original nested loop must stop at the first False callback. This
	-- pure predicate pins the result; source/generated-C review pins no later
	-- invocation without introducing observable test-only effects.
	Some(
		dependencies.length() == 3 and positions_preserved
		and not implementation_pattern_match_bounds_satisfied(
			matched, bounds,
			pure func(_, identity): identity
				.map(pure func(found): not bound_trait_identities_equal(found, test_bound_trait_identity("Equatable")))
				.get_or(False),
		)
		and implementation_pattern_match_bounds_satisfied(matched, bounds, pure func(_obligation, _identity): True)
	)


func test_shared_pattern_match_preserves_dependency_order() -> Bool:
	shared_pattern_match_preserves_dependency_order().get_or(False)


func test_unbounded_pattern_match_preserves_exact_type_admission() -> Bool:
	receiver = SemanticNamedType("Marker", [])
	(
		implementation_pattern_matches_with(receiver, [], receiver, pure func(_obligation, _identity): False)
		and not implementation_pattern_matches_with(
			receiver,
			[],
			SemanticNamedType("Other", []),
			pure func(_obligation, _identity): True,
		)
	)


