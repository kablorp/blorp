pure func overload_entry(
	def_id: Int,
	first_type: SemanticType,
	return_type: SemanticType,
) -> OverloadEntry:
	{
		def_id = def_id,
		func_type = SemanticFunctionType(True, [first_type], return_type),
		type_params = [],
		param_names = [Some("value")],
		purity = Pure,
		origin = UserDefinedFunc,
		resource_args = RejectResourceArgs,
		module_path = None,
		dim_constraints = [],
		loop_producer = None,
		debug_only = False
	}


pure func env_add_test_ufcs_function(env: Env, name: String, entry: OverloadEntry) -> Env:
	env_add_func_with_info(
		env,
		name,
		func_symbol(
			entry.def_id,
			entry.func_type,
			entry.type_params,
			entry.param_names,
			entry.purity,
			entry.origin,
			entry.resource_args,
			entry.module_path,
			entry.dim_constraints,
			entry.loop_producer,
			entry.debug_only,
		),
	)


pure func two_arg_overload_entry(
	def_id: Int,
	first_type: SemanticType,
	second_type: SemanticType,
	return_type: SemanticType,
) -> OverloadEntry:
	{
		def_id = def_id,
		func_type = SemanticFunctionType(
			True,
			[first_type, second_type],
			return_type,
		),
		type_params = [],
		param_names = [Some("left"), Some("right")],
		purity = Pure,
		origin = UserDefinedFunc,
		resource_args = RejectResourceArgs,
		module_path = None,
		dim_constraints = [],
		loop_producer = None,
		debug_only = False
	}


pure func generic_overload_entry(
	def_id: Int,
	param_type: SemanticType,
	return_type: SemanticType,
	type_param_name: String,
) -> OverloadEntry:
	{
		def_id = def_id,
		func_type = SemanticFunctionType(True, [param_type], return_type),
		type_params = [test_bound_type_param(type_param_name, [])],
		param_names = [Some("value")],
		purity = Pure,
		origin = UserDefinedFunc,
		resource_args = RejectResourceArgs,
		module_path = None,
		dim_constraints = [],
		loop_producer = None,
		debug_only = False
	}


func test_scope_lookup_and_shadowing() -> Bool:
	base: Env = ENV_EMPTY
	with_x = env_add_var(base, "x", TYPE_INT)
	inner = env_push_scope(with_x)
	inner_with_x = env_add_var_with_details(
		inner,
		"x",
		TYPE_STRING,
		None,
		ImmutableBinding,
		FuncParam,
		UNREFINED_BINDING,
	)
	with_resource = env_add_var_with_details(
		inner_with_x,
		"reader_line",
		TYPE_STRING,
		None,
		ImmutableBinding,
		ScopedResourceDerived,
		UNREFINED_BINDING,
	)
	with_scoped_reader = env_add_var_with_details(
		with_resource,
		"reader",
		TYPE_STRING,
		None,
		ImmutableBinding,
		ScopedResource,
		UNREFINED_BINDING,
	)
	with_unavailable_reader = env_add_var_with_details(
		with_scoped_reader,
		"parent_reader",
		TYPE_STRING,
		None,
		ImmutableBinding,
		ScopedResourceUnavailable("child"),
		UNREFINED_BINDING,
	)
	outer_lookup = env_lookup_with_scope_depth(inner, "x")
	shadow_lookup = env_lookup_with_scope_depth(with_unavailable_reader, "x")

	match (
		env_get_var_type(with_unavailable_reader, "x"),
		env_lookup_in_current_scope(with_unavailable_reader, "x"),
		outer_lookup,
		shadow_lookup,
	):
		(Some(shadow_type), Some(current_symbol), Some(outer), Some(shadow)):
			(
				types_equal(shadow_type, TYPE_STRING)
				and current_symbol.name == "x"
				and env_is_func_param(with_unavailable_reader, "x")
				and env_is_scoped_resource_related_var(with_unavailable_reader, "reader_line")
				and env_is_scoped_resource_derived_var(with_unavailable_reader, "reader_line")
				and env_is_scoped_resource_related_var(with_unavailable_reader, "reader")
				and env_is_scoped_resource_var(with_unavailable_reader, "reader")
				and env_is_scoped_resource_related_var(with_unavailable_reader, "parent_reader")
				and env_scoped_resource_unavailable_owner(
					with_unavailable_reader,
					"parent_reader",
				) == Some("child")
				and env_get_var_type(base, "x").is_none()
				and outer.scope_depth == 1
				and env_lookup_is_outermost_scope(inner, outer)
				and shadow.scope_depth == 0
				and not env_lookup_is_outermost_scope(with_resource, shadow)
			)
		_:
			False


func test_same_scope_lookup_preserves_latest_symbol_and_full_history() -> Bool:
	base = ENV_EMPTY
	with_int = env_add_var(base, "value", TYPE_INT)
	with_string = env_add_var(with_int, "value", TYPE_STRING)

	match env_lookup(with_string, "value"):
		Some(symbol):
			symbol.name == "value" and types_equal(
				env_get_var_type(with_string, "value").get_or(TYPE_INT),
				TYPE_STRING,
			) and env_symbols_named(with_string, "value").length() == 2
		None:
			False


func test_symbol_history_preserves_scope_and_declaration_order() -> Bool:
	outer = env_add_var(ENV_EMPTY, "value", TYPE_INT)
	inner = env_add_var(
		env_add_var(env_push_scope(outer), "value", TYPE_STRING),
		"value",
		TYPE_BOOL,
	)
	history = env_symbols_named(inner, "value")

	match (history.get(0), history.get(1), history.get(2)):
		(Some(first), Some(second), Some(third)):
			match (first.kind, second.kind, third.kind):
				(VarSymbolKind(first_var), VarSymbolKind(second_var), VarSymbolKind(third_var)):
					(
						history.length() == 3
						and types_equal(first_var.var_type, TYPE_BOOL)
						and types_equal(second_var.var_type, TYPE_STRING)
						and types_equal(third_var.var_type, TYPE_INT)
					)
				_:
					False
		_:
			False


func test_symbol_history_preserves_duplicate_identity_across_scopes() -> Bool:
	outer = env_add_var_with_module_details(
		ENV_EMPTY,
		"dup",
		TYPE_INT,
		None,
		ImmutableBinding,
		LetBinding,
		UNREFINED_BINDING,
		Some("outer"),
		Some(10),
	)
	outer_shadow = env_add_var_with_module_details(
		outer,
		"dup",
		TYPE_STRING,
		None,
		ImmutableBinding,
		LetBinding,
		UNREFINED_BINDING,
		Some("outer"),
		Some(11),
	)
	inner = env_add_var_with_module_details(
		env_push_scope(outer_shadow),
		"dup",
		TYPE_BOOL,
		None,
		ImmutableBinding,
		LetBinding,
		UNREFINED_BINDING,
		Some("inner"),
		Some(20),
	)
	history = env_symbols_named(inner, "dup")

	match (history.get(0), history.get(1), history.get(2)):
		(Some(first), Some(second), Some(third)):
			match (first.kind, second.kind, third.kind):
				(VarSymbolKind(first_var), VarSymbolKind(second_var), VarSymbolKind(third_var)):
					(
						history.length() == 3
						and first_var.definition_id == Some(20)
						and second_var.definition_id == Some(11)
						and third_var.definition_id == Some(10)
						and first_var.module_path == Some("inner")
						and second_var.module_path == Some("outer")
						and third_var.module_path == Some("outer")
					)
				_:
					False
		_:
			False


func test_symbol_history_keeps_all_overloads_before_outer_shadow() -> Bool:
	outer = env_add_var_with_module_details(
		ENV_EMPTY,
		"call",
		TYPE_INT,
		None,
		ImmutableBinding,
		LetBinding,
		UNREFINED_BINDING,
		Some("outer"),
		Some(3),
	)
	inner = env_add_test_ufcs_function(
		env_add_test_ufcs_function(
			env_push_scope(outer),
			"call",
			overload_entry(40, TYPE_INT, TYPE_INT),
		),
		"call",
		overload_entry(41, TYPE_STRING, TYPE_STRING),
	)
	history = env_symbols_named(inner, "call")

	match (history.get(0), history.get(1), history.get(2)):
		(Some(first), Some(second), Some(third)):
			match (first.kind, second.kind, third.kind):
				(FuncSymbolKind(first_func), FuncSymbolKind(second_func), VarSymbolKind(third_var)):
					(
						history.length() == 3
						and first_func.callable_id == 41
						and second_func.callable_id == 40
						and third_var.definition_id == Some(3)
					)
				_:
					False
		_:
			False


func test_symbol_history_no_match_and_empty_scope_return_empty() -> Bool:
	outer = env_add_var(ENV_EMPTY, "present", TYPE_INT)
	inner = env_push_scope(outer)

	(
		env_symbols_named(ENV_EMPTY, "missing").is_empty()
		and env_symbols_named(inner, "missing").is_empty()
		and env_symbols_named(env_push_scope(ENV_EMPTY), "missing").is_empty()
	)


func test_local_and_outermost_lookups_split_at_the_module_scope() -> Bool:
	module_scope = env_add_var(env_add_var(ENV_EMPTY, "value", TYPE_INT), "value", TYPE_BOOL)
	inner = env_add_var(env_push_scope(env_push_scope(module_scope)), "value", TYPE_STRING)
	local_type = env_lookup_local(inner, "value").map(func(symbol): symbol.kind)
	outermost_type = env_lookup_outermost_scope(inner, "value").map(func(symbol): symbol.kind)

	match (local_type, outermost_type):
		(Some(VarSymbolKind(local_var)), Some(VarSymbolKind(module_var))):
			(
				types_equal(local_var.var_type, TYPE_STRING)
				and types_equal(module_var.var_type, TYPE_BOOL)
				and env_outermost_scope_symbols_named(inner, "value").length() == 2
				and env_lookup_local(module_scope, "value").is_none()
				and env_lookup_local(env_push_scope(module_scope), "value").is_none()
				and env_lookup_outermost_scope(inner, "missing").is_none()
				and env_outermost_scope_symbols_named(ENV_EMPTY, "missing").is_empty()
			)
		_:
			False


func test_constructor_lookup_preserves_same_name_candidates() -> Bool:
	first = env_add_type(
		ENV_EMPTY,
		"FirstChoice",
		[],
		[
			{
				name = "Shared",
				fields = [TYPE_INT],
				tag = 0
			},
		],
		TypeUnion(TaggedUnion),
		False,
		True,
	)
	second = env_add_type(
		first,
		"SecondChoice",
		[],
		[
			{
				name = "Shared",
				fields = [TYPE_STRING],
				tag = 0
			},
		],
		TypeUnion(TaggedUnion),
		False,
		True,
	)
	constructors = env_get_constructors(second, "Shared")

	match (constructors.get(0), constructors.get(1)):
		(Some(latest), Some(earlier)):
			(
				constructors.length() == 2
				and latest.parent_type == "SecondChoice"
				and earlier.parent_type == "FirstChoice"
			)
		_:
			False


func test_union_constructor_batch_preserves_intra_group_order_and_ids() -> Bool:
	env = env_add_type_with_constructor_ids(
		{ ENV_EMPTY | next_def_id = 71 },
		"BatchChoice",
		[],
		[
			{
				name = "Shared",
				fields = [TYPE_INT],
				tag = 0
			},
			{
				name = "Other",
				fields = [],
				tag = 1
			},
			{
				name = "Shared",
				fields = [TYPE_STRING],
				tag = 2
			},
		],
		TypeUnion(TaggedUnion),
		False,
		True,
		[Some(61), None, Some(63)],
	)
	shared = env_get_constructors(env, "Shared")

	match (shared.get(0), shared.get(1), env_get_constructor(env, "Other")):
		(Some(latest), Some(earlier), Some(other)):
			(
				shared.length() == 2
				and latest.parent_type == "BatchChoice"
				and latest.constructor_id == 63
				and latest.tag == 2
				and earlier.parent_type == "BatchChoice"
				and earlier.constructor_id == 61
				and earlier.tag == 0
				and other.constructor_id == 71
				and other.tag == 1
				and env.next_def_id == 72
			)
		_:
			False


func test_accepted_union_constructor_batch_retains_containment_facts() -> Bool:
	facts: TypeContainmentSummary = {
		may_contain_function = False,
		may_contain_one_shot_stream = True,
		may_contain_resource_source = False
	}
	retained_facts: TypeContainmentSummary = {
		may_contain_function = True,
		may_contain_one_shot_stream = False,
		may_contain_resource_source = False
	}
	with_inferred = env_add_type(
		ENV_EMPTY,
		"InferredBeforeAcceptedBatch",
		[],
		[],
		TypeBuiltin,
		False,
		False,
	)
	with_retained_accepted = env_add_accepted_type(
		with_inferred,
		"RetainedAcceptedBatch",
		[],
		[],
		TypeBuiltin,
		False,
		False,
		retained_facts,
	)
	with_shadowed_name = env_add_type(
		with_retained_accepted,
		"AcceptedBatchChoice",
		[],
		[],
		TypeBuiltin,
		False,
		False,
	)
	env = env_add_accepted_type(
		with_shadowed_name,
		"AcceptedBatchChoice",
		[],
		[
			{
				name = "AcceptedShared",
				fields = [TYPE_INT],
				tag = 0
			},
			{
				name = "AcceptedShared",
				fields = [TYPE_STRING],
				tag = 1
			},
		],
		TypeUnion(TaggedUnion),
		False,
		True,
		facts,
	)
	constructors = env_get_constructors(env, "AcceptedShared")

	match (constructors.get(0), constructors.get(1)):
		(Some(latest), Some(earlier)):
			(
				constructors.length() == 2
				and latest.tag == 1
				and earlier.tag == 0
				and env_type_may_contain_function(env, "AcceptedBatchChoice") == Some(False)
				and env_type_may_contain_one_shot_stream(env, "AcceptedBatchChoice") == Some(True)
				and env_type_may_contain_resource_source(env, "AcceptedBatchChoice") == Some(False)
				and env_type_may_contain_function(env, "RetainedAcceptedBatch") == Some(True)
				and env_type_may_contain_function(env, "InferredBeforeAcceptedBatch").is_none()
			)
		_:
			False


func test_type_registration_without_constructors_consumes_no_ids() -> Bool:
	facts: TypeContainmentSummary = {
		may_contain_function = False,
		may_contain_one_shot_stream = False,
		may_contain_resource_source = False
	}
	variants = [
		{
			name = "Issue09DisabledCtor",
			fields = [],
			tag = 0
		},
		{
			name = "Issue09DisabledCtor",
			fields = [TYPE_INT],
			tag = 1
		},
	]
	ordinary_disabled = env_add_type_with_constructor_ids(
		{ ENV_EMPTY | next_def_id = 50 },
		"Issue09NoOrdinaryConstructors",
		[],
		variants,
		TypeUnion(TaggedUnion),
		False,
		False,
		[None, None],
	)
	accepted_disabled = env_add_accepted_type_with_constructor_ids(
		{ ENV_EMPTY | next_def_id = 50 },
		"Issue09NoAcceptedConstructors",
		[],
		variants,
		TypeUnion(TaggedUnion),
		False,
		False,
		[None, None],
		facts,
	)
	ordinary_zero = env_add_type_with_constructor_ids(
		{ ENV_EMPTY | next_def_id = 70 },
		"Issue09ZeroOrdinaryConstructors",
		[],
		[],
		TypeUnion(TaggedUnion),
		False,
		True,
		[],
	)
	accepted_zero = env_add_accepted_type_with_constructor_ids(
		{ ENV_EMPTY | next_def_id = 70 },
		"Issue09ZeroAcceptedConstructors",
		[],
		[],
		TypeUnion(TaggedUnion),
		False,
		True,
		[],
		facts,
	)

	(
		ordinary_disabled.next_def_id == 50
		and accepted_disabled.next_def_id == 50
		and ordinary_zero.next_def_id == 70
		and accepted_zero.next_def_id == 70
		and env_get_constructor(ordinary_disabled, "Issue09DisabledCtor").is_none()
		and env_get_constructor(accepted_disabled, "Issue09DisabledCtor").is_none()
		and env_get_constructors(ordinary_disabled, "Issue09DisabledCtor").length() == 0
		and env_get_constructors(accepted_disabled, "Issue09DisabledCtor").length() == 0
		and env_symbols_named(ordinary_disabled, "Issue09NoOrdinaryConstructors").length() == 1
		and env_symbols_named(accepted_disabled, "Issue09NoAcceptedConstructors").length() == 1
		and env_symbols_named(ordinary_zero, "Issue09ZeroOrdinaryConstructors").length() == 1
		and env_symbols_named(accepted_zero, "Issue09ZeroAcceptedConstructors").length() == 1
		and env_type_may_contain_function(
			accepted_disabled,
			"Issue09NoAcceptedConstructors",
		) == Some(False)
		and env_type_may_contain_function(
			accepted_zero,
			"Issue09ZeroAcceptedConstructors",
		) == Some(False)
	)


func test_issue16_public_batch_edges_preserve_env_behavior() -> Bool:
	facts: TypeContainmentSummary = {
		may_contain_function = True,
		may_contain_one_shot_stream = False,
		may_contain_resource_source = False
	}
	empty_ordinary = env_add_type_with_constructor_ids(
		{ ENV_EMPTY | next_def_id = 100 },
		"Issue16Empty",
		[],
		[],
		TypeUnion(TaggedUnion),
		False,
		True,
		[],
	)
	singleton_ordinary = env_add_type_with_constructor_ids(
		{ empty_ordinary | next_def_id = 101 },
		"Issue16Single",
		[],
		[
			{
				name = "Issue16Only",
				fields = [TYPE_INT],
				tag = 0
			},
		],
		TypeUnion(TaggedUnion),
		False,
		True,
		[None],
	)
	singleton_accepted = env_add_accepted_type_with_constructor_ids(
		singleton_ordinary,
		"Issue16Accepted",
		[],
		[
			{
				name = "Issue16AcceptedOnly",
				fields = [TYPE_STRING],
				tag = 0
			},
		],
		TypeUnion(TaggedUnion),
		False,
		True,
		[Some(333)],
		facts,
	)

	match (
		env_get_type_decl(empty_ordinary, "Issue16Empty"),
		env_get_constructor(singleton_ordinary, "Issue16Only"),
		env_get_constructor(singleton_accepted, "Issue16AcceptedOnly"),
	):
		(Some((_, empty_variants)), Some(ordinary_constructor), Some(accepted_constructor)):
			(
				empty_variants.length() == 0
				and empty_ordinary.next_def_id == 100
				and singleton_ordinary.next_def_id == 102
				and ordinary_constructor.constructor_id == 101
				and ordinary_constructor.tag == 0
				and accepted_constructor.constructor_id == 333
				and accepted_constructor.field_types.length() == 1
				and env_symbols_named(singleton_accepted, "Issue16Single").length() == 1
				and env_symbols_named(singleton_accepted, "Issue16Accepted").length() == 1
				and env_type_may_contain_function(
					singleton_accepted,
					"Issue16Accepted",
				) == Some(True)
			)
		_:
			False


func test_issue16_public_batch_histories_and_scope_restoration() -> Bool:
	facts: TypeContainmentSummary = {
		may_contain_function = False,
		may_contain_one_shot_stream = False,
		may_contain_resource_source = False
	}
	outer = env_add_accepted_type(
		ENV_EMPTY,
		"Issue16Restored",
		[],
		[],
		TypeBuiltin,
		False,
		False,
		facts,
	)
	inner = env_add_type(
		env_push_scope(outer),
		"Issue16Restored",
		[],
		[
			{
				name = "Issue16Repeated",
				fields = [TYPE_INT],
				tag = 0
			},
			{
				name = "Issue16Repeated",
				fields = [TYPE_STRING],
				tag = 1
			},
		],
		TypeUnion(TaggedUnion),
		False,
		True,
	)
	restored = env_pop_scope(inner)
	history = env_get_constructors(inner, "Issue16Repeated")

	match (history.get(0), history.get(1)):
		(Some(latest), Some(earlier)):
			(
				history.length() == 2
				and latest.tag == 1
				and earlier.tag == 0
				and env_symbols_named(inner, "Issue16Restored").length() == 2
				and env_type_may_contain_function(inner, "Issue16Restored").is_none()
				and env_get_constructor(restored, "Issue16Repeated").is_none()
				and env_symbols_named(restored, "Issue16Restored").length() == 1
				and env_type_may_contain_function(restored, "Issue16Restored") == Some(False)
			)
		_:
			False


func test_union_constructor_batch_preserves_scope_snapshots() -> Bool:
	ordinary_accepted_facts: TypeContainmentSummary = {
		may_contain_function = False,
		may_contain_one_shot_stream = False,
		may_contain_resource_source = False
	}
	ordinary_with_accepted = env_add_accepted_type(
		ENV_EMPTY,
		"AcceptedBeforeOrdinaryBatch",
		[],
		[],
		TypeBuiltin,
		False,
		False,
		ordinary_accepted_facts,
	)
	ordinary_outer = env_add_type(
		ordinary_with_accepted,
		"ScopeBatchChoice",
		[],
		[],
		TypeBuiltin,
		False,
		False,
	)
	ordinary_sibling = ordinary_outer
	ordinary_shadowed = env_add_type(
		env_push_scope(ordinary_outer),
		"ScopeBatchChoice",
		[],
		[
			{
				name = "ScopeBatchConstructor",
				fields = [],
				tag = 0
			},
		],
		TypeUnion(TaggedUnion),
		False,
		True,
	)
	ordinary_with_inner_accepted = env_add_accepted_type(
		ordinary_shadowed,
		"AcceptedInsideOrdinaryBatch",
		[],
		[],
		TypeBuiltin,
		False,
		False,
		{
			may_contain_function = True,
			may_contain_one_shot_stream = False,
			may_contain_resource_source = False
		},
	)
	ordinary_restored = env_pop_scope(ordinary_with_inner_accepted)

	old_facts: TypeContainmentSummary = {
		may_contain_function = False,
		may_contain_one_shot_stream = False,
		may_contain_resource_source = False
	}
	new_facts: TypeContainmentSummary = {
		may_contain_function = True,
		may_contain_one_shot_stream = False,
		may_contain_resource_source = False
	}
	accepted_outer = env_add_accepted_type(
		ENV_EMPTY,
		"AcceptedScopeBatchChoice",
		[],
		[],
		TypeBuiltin,
		False,
		False,
		old_facts,
	)
	accepted_sibling = accepted_outer
	accepted_shadowed = env_add_accepted_type(
		env_push_scope(accepted_outer),
		"AcceptedScopeBatchChoice",
		[],
		[
			{
				name = "AcceptedScopeBatchConstructor",
				fields = [],
				tag = 0
			},
		],
		TypeUnion(TaggedUnion),
		False,
		True,
		new_facts,
	)
	accepted_restored = env_pop_scope(accepted_shadowed)

	(
		env_type_may_contain_function(ordinary_shadowed, "ScopeBatchChoice").is_none()
		and env_type_may_contain_function(ordinary_sibling, "ScopeBatchChoice") == Some(False)
		and env_type_may_contain_function(ordinary_restored, "ScopeBatchChoice") == Some(False)
		and env_get_constructor(ordinary_shadowed, "ScopeBatchConstructor").is_some()
		and env_get_constructor(ordinary_restored, "ScopeBatchConstructor").is_none()
		and env_type_may_contain_function(
			ordinary_with_inner_accepted,
			"AcceptedBeforeOrdinaryBatch",
		).is_none()
		and env_type_may_contain_function(
			ordinary_with_inner_accepted,
			"AcceptedInsideOrdinaryBatch",
		) == Some(True)
		and env_type_may_contain_function(
			ordinary_restored,
			"AcceptedBeforeOrdinaryBatch",
		) == Some(False)
		and env_type_may_contain_function(
			ordinary_restored,
			"AcceptedInsideOrdinaryBatch",
		).is_none()
		and env_type_may_contain_function(
			accepted_shadowed,
			"AcceptedScopeBatchChoice",
		) == Some(True)
		and env_type_may_contain_function(
			accepted_sibling,
			"AcceptedScopeBatchChoice",
		) == Some(False)
		and env_type_may_contain_function(
			accepted_restored,
			"AcceptedScopeBatchChoice",
		) == Some(False)
		and env_get_constructor(accepted_shadowed, "AcceptedScopeBatchConstructor").is_some()
		and env_get_constructor(accepted_restored, "AcceptedScopeBatchConstructor").is_none()
	)


func test_type_record_alias_and_nominal_dim_resolution() -> Bool:
	var env: Env = ENV_EMPTY
	env = env_add_type(
		env,
		"Option",
		["T"],
		[
			{
				name = "Some",
				fields = [SemanticTypeVar("T", SemanticTypeParameter)],
				tag = 0
			},
			{
				name = "None",
				fields = [],
				tag = 1
			},
		],
		TypeUnion(TaggedUnion),
		False,
		True,
	)
	env = env_add_type(env, "File", [], [], TypeResource, True, False)
	env = env_add_record(
		env,
		"Point",
		[],
		[
			{
				name = "x",
				field_type = TYPE_FLOAT
			},
			{
				name = "y",
				field_type = TYPE_FLOAT
			},
		],
		False,
	)
	env = env_add_alias(env, "Str", [], TYPE_STRING)
	env = env_add_alias(
		env,
		"FloatRow",
		["#N"],
		SemanticArrayType(TYPE_FLOAT, [SemanticTypeVar("#N", SemanticDimensionParameter)]),
	)
	parsed: SemanticType = SemanticArrayType(
		SemanticNamedType("FloatRow", []),
		[SemanticConstIntType(8)],
	)
	nominal: SemanticType = env_disambiguate_nominal_dim_application(env, parsed)
	resolved: SemanticType = env_resolve_alias(env, nominal)

	match (
		env_get_type_decl(env, "Option"),
		env_get_constructor(env, "Some"),
		env_get_record(env, "Point"),
		env_get_alias(env, "Str"),
	):
		(Some((type_params, variants)), Some(ctor), Some((_, record_fields)), Some((_, alias_target))):
			(
				type_params == ["T"]
				and variants.length() == 2
				and ctor.parent_type == "Option"
				and ctor.type_params == ["T"]
				and ctor.field_types.length() == 1
				and ctor.tag == 0
				and env_get_type_kind(env, "File") == Some(TypeResource)
				and record_fields.length() == 2
				and env_find_records_with_fields(
					env,
					["y", "x"],
				) == ["Point"]
				and types_equal(alias_target, TYPE_STRING)
				and types_equal(
					resolved,
					SemanticArrayType(TYPE_FLOAT, [SemanticConstIntType(8)]),
				)
			)
		_:
			False


func test_type_registration_summarizes_containment_conservatively() -> Bool:
	var env = env_add_type(ENV_EMPTY, "Int", [], [], TypeBuiltin, False, False)
	env = env_add_type(env, "Stream", ["T"], [], TypeBuiltin, False, False)
	env = env_add_type(env, "stream::ResourceSource", ["T"], [], TypeBuiltin, False, False)
	env = env_add_type(env, "T", [], [], TypeBuiltin, False, False)
	env = env_add_record(
		env,
		"Plain",
		[],
		[
			{
				name = "value",
				field_type = TYPE_INT
			},
		],
		False,
	)
	env = env_add_record(
		env,
		"NestedPlain",
		[],
		[
			{
				name = "value",
				field_type = SemanticNamedType("Plain", [])
			},
		],
		False,
	)
	env = env_add_record(
		env,
		"StreamHolder",
		[],
		[
			{
				name = "stream",
				field_type = SemanticNamedType("Stream", [TYPE_INT])
			},
		],
		False,
	)
	env = env_add_record(
		env,
		"ResourceSourceHolder",
		[],
		[
			{
				name = "source",
				field_type = SemanticNamedType("stream::ResourceSource", [TYPE_INT])
			},
		],
		False,
	)
	env = env_add_record(
		env,
		"Callback",
		[],
		[
			{
				name = "run",
				field_type = SemanticFunctionType(True, [TYPE_INT], TYPE_INT)
			},
		],
		False,
	)
	env = env_add_record(
		env,
		"Generic",
		["T"],
		[
			{
				name = "value",
				field_type = SemanticNamedType("T", [])
			},
		],
		False,
	)
	env = env_add_record(
		env,
		"Forward",
		[],
		[
			{
				name = "value",
				field_type = SemanticNamedType("DeclaredLater", [])
			},
		],
		False,
	)
	env = env_add_record(
		env,
		"Recursive",
		[],
		[
			{
				name = "next",
				field_type = SemanticNamedType("Recursive", [])
			},
		],
		False,
	)

	(
		env_type_may_contain_function(env, "Plain") == Some(False)
		and env_type_may_contain_one_shot_stream(env, "Plain") == Some(False)
		and env_type_may_contain_resource_source(env, "Plain") == Some(False)
		and env_type_resource_scan_is_proven_unnecessary(env, "Plain")
		and env_type_may_contain_function(env, "NestedPlain") == Some(False)
		and env_type_may_contain_one_shot_stream(env, "NestedPlain") == Some(False)
		and env_type_may_contain_resource_source(env, "NestedPlain") == Some(False)
		and env_type_resource_scan_is_proven_unnecessary(env, "NestedPlain")
		and env_type_may_contain_one_shot_stream(env, "Stream") == Some(True)
		and env_type_may_contain_resource_source(env, "Stream") == Some(False)
		and not env_type_resource_scan_is_proven_unnecessary(env, "Stream")
		and env_type_may_contain_one_shot_stream(env, "stream::ResourceSource") == Some(False)
		and env_type_may_contain_resource_source(env, "stream::ResourceSource") == Some(True)
		and not env_type_resource_scan_is_proven_unnecessary(env, "stream::ResourceSource")
		and env_type_may_contain_function(env, "StreamHolder") == Some(False)
		and env_type_may_contain_one_shot_stream(env, "StreamHolder") == Some(True)
		and env_type_may_contain_resource_source(env, "StreamHolder") == Some(False)
		and not env_type_resource_scan_is_proven_unnecessary(env, "StreamHolder")
		and env_type_may_contain_function(env, "ResourceSourceHolder") == Some(False)
		and env_type_may_contain_one_shot_stream(env, "ResourceSourceHolder") == Some(False)
		and env_type_may_contain_resource_source(env, "ResourceSourceHolder") == Some(True)
		and not env_type_resource_scan_is_proven_unnecessary(env, "ResourceSourceHolder")
		and env_type_may_contain_function(env, "Callback") == Some(True)
		and env_type_may_contain_one_shot_stream(env, "Callback") == Some(False)
		and env_type_may_contain_resource_source(env, "Callback") == Some(False)
		and not env_type_resource_scan_is_proven_unnecessary(env, "Callback")
		and env_type_may_contain_function(env, "Generic") == Some(True)
		and env_type_may_contain_one_shot_stream(env, "Generic") == Some(True)
		and env_type_may_contain_resource_source(env, "Generic") == Some(True)
		and not env_type_resource_scan_is_proven_unnecessary(env, "Generic")
		and env_type_may_contain_function(env, "Forward") == Some(True)
		and env_type_may_contain_one_shot_stream(env, "Forward") == Some(True)
		and env_type_may_contain_resource_source(env, "Forward") == Some(True)
		and not env_type_resource_scan_is_proven_unnecessary(env, "Forward")
		and env_type_may_contain_function(env, "Recursive") == Some(True)
		and env_type_may_contain_one_shot_stream(env, "Recursive") == Some(True)
		and env_type_may_contain_resource_source(env, "Recursive") == Some(True)
		and not env_type_resource_scan_is_proven_unnecessary(env, "Recursive")
		and env_type_may_contain_function(env, "Missing").is_none()
		and env_type_may_contain_one_shot_stream(env, "Missing").is_none()
		and env_type_may_contain_resource_source(env, "Missing").is_none()
		and not env_type_resource_scan_is_proven_unnecessary(env, "Missing")
	)


func test_type_registration_invalidates_containment_when_binding_changes() -> Bool:
	var env = env_add_type(ENV_EMPTY, "Int", [], [], TypeBuiltin, False, False)
	env = env_add_type(env, "Stream", ["T"], [], TypeBuiltin, False, False)
	env = env_add_record(
		env,
		"Dependency",
		[],
		[
			{
				name = "value",
				field_type = TYPE_INT
			},
		],
		False,
	)
	env = env_add_record(
		env,
		"Container",
		[],
		[
			{
				name = "dependency",
				field_type = SemanticNamedType("Dependency", [])
			},
		],
		False,
	)
	was_negative = (
		env_type_contains_resource_if_valid(env, "Container") == Some(False)
		and env_type_may_contain_function(env, "Container") == Some(False)
		and env_type_may_contain_one_shot_stream(env, "Container") == Some(False)
		and env_type_may_contain_resource_source(env, "Container") == Some(False)
	)

	with_intervening_value = env_add_var(env, "Dependency", TYPE_INT)
	shadowed = env_add_record(
		with_intervening_value,
		"Dependency",
		[],
		[
			{
				name = "stream",
				field_type = SemanticNamedType("Stream", [TYPE_INT])
			},
		],
		False,
	)

	(
		was_negative
		and env_type_contains_resource_if_valid(shadowed, "Container").is_none()
		and env_type_may_contain_function(shadowed, "Container").is_none()
		and env_type_may_contain_one_shot_stream(shadowed, "Container").is_none()
		and env_type_may_contain_resource_source(shadowed, "Container").is_none()
		and not env_type_resource_scan_is_proven_unnecessary(shadowed, "Container")
	)


func test_accepted_shadow_invalidates_only_inferred_containment() -> Bool:
	var env = env_add_type(ENV_EMPTY, "Int", [], [], TypeBuiltin, False, False)
	env = env_add_record(
		env,
		"Dependency",
		[],
		[
			{
				name = "value",
				field_type = TYPE_INT
			},
		],
		False,
	)
	env = env_add_record(
		env,
		"Container",
		[],
		[
			{
				name = "dependency",
				field_type = SemanticNamedType("Dependency", [])
			},
		],
		False,
	)
	stream_facts: TypeContainmentSummary = {
		may_contain_function = False,
		may_contain_one_shot_stream = True,
		may_contain_resource_source = False
	}
	with_accepted_dependency = env_add_accepted_record(
		env,
		"Dependency",
		[],
		[
			{
				name = "stream",
				field_type = TYPE_INT
			},
		],
		False,
		stream_facts,
	)
	plain_facts: TypeContainmentSummary = {
		may_contain_function = False,
		may_contain_one_shot_stream = False,
		may_contain_resource_source = False
	}
	with_accepted_container = env_add_accepted_record(
		with_accepted_dependency,
		"AcceptedContainer",
		[],
		[
			{
				name = "value",
				field_type = TYPE_INT
			},
		],
		False,
		plain_facts,
	)
	with_arbitrary_shadow = env_add_alias(
		with_accepted_container,
		"Int",
		[],
		SemanticNamedType("String", []),
	)

	(
		env_type_may_contain_one_shot_stream(with_accepted_dependency, "Container").is_none()
		and env_type_may_contain_one_shot_stream(
			with_accepted_dependency,
			"Dependency",
		) == Some(True)
		and env_type_may_contain_function(
			with_accepted_container,
			"AcceptedContainer",
		) == Some(False)
		and env_type_may_contain_function(with_arbitrary_shadow, "AcceptedContainer").is_none()
	)


func test_accepted_containment_facts_follow_scopes() -> Bool:
	resource_facts: TypeContainmentSummary = {
		may_contain_function = False,
		may_contain_one_shot_stream = True,
		may_contain_resource_source = False
	}
	plain_facts: TypeContainmentSummary = {
		may_contain_function = False,
		may_contain_one_shot_stream = False,
		may_contain_resource_source = False
	}
	with_ordinary = env_add_record(ENV_EMPTY, "Ordinary", [], [], False)
	outer = env_add_accepted_record(with_ordinary, "Scoped", [], [], True, resource_facts)
	inner = env_add_accepted_record(
		env_push_scope(outer),
		"Scoped",
		[],
		[],
		False,
		plain_facts,
	)
	innermost = env_add_alias(
		env_push_scope(inner),
		"Scoped",
		[],
		SemanticNamedType("String", []),
	)
	restored_inner = env_pop_scope(innermost)
	restored_outer = env_pop_scope(restored_inner)

	(
		env_type_contains_resource_if_valid(outer, "Scoped") == Some(True)
		and env_type_may_contain_one_shot_stream(outer, "Scoped") == Some(True)
		and env_type_resource_scan_proof(outer, "Scoped") == Some(False)
		and env_type_contains_resource_if_valid(inner, "Scoped") == Some(False)
		and env_type_may_contain_one_shot_stream(inner, "Scoped") == Some(False)
		and env_type_resource_scan_proof(inner, "Scoped") == Some(True)
		and env_type_contains_resource_if_valid(innermost, "Scoped").is_none()
		and env_type_resource_scan_proof(innermost, "Scoped").is_none()
		and env_type_resource_scan_proof(innermost, "Missing").is_none()
		and env_type_contains_resource_if_valid(restored_inner, "Scoped") == Some(False)
		and env_type_may_contain_one_shot_stream(restored_inner, "Scoped") == Some(False)
		and env_type_contains_resource_if_valid(restored_outer, "Scoped") == Some(True)
		and env_type_may_contain_one_shot_stream(restored_outer, "Scoped") == Some(True)
		and env_type_may_contain_function(restored_outer, "Ordinary") == Some(False)
	)


func test_nested_generic_alias_resolution() -> Bool:
	var env = env_add_alias(
		ENV_EMPTY,
		"Check",
		["A", "E"],
		SemanticFunctionType(
			True,
			[SemanticTypeVar("A", SemanticTypeParameter)],
			SemanticNamedType("Option", [SemanticTypeVar("E", SemanticTypeParameter)]),
		),
	)
	env = env_add_alias(
		env,
		"InvalidCheck",
		["A"],
		SemanticNamedType(
			"Check",
			[SemanticTypeVar("A", SemanticTypeParameter), SemanticNamedType("Invalid", [])],
		),
	)
	resolved = env_resolve_alias(
		env,
		SemanticNamedType("InvalidCheck", [TYPE_INT]),
	)

	types_equal(
		resolved,
		SemanticFunctionType(
			True,
			[TYPE_INT],
			SemanticNamedType("Option", [SemanticNamedType("Invalid", [])]),
		),
	)


func test_alias_resolution_terminates_cycles() -> Bool:
	var env = env_add_alias(
		ENV_EMPTY,
		"FirstAlias",
		[],
		SemanticNamedType("SecondAlias", []),
	)
	env = env_add_alias(
		env,
		"SecondAlias",
		[],
		SemanticNamedType("FirstAlias", []),
	)

	types_equal(
		env_resolve_alias(
			env,
			SemanticNamedType("FirstAlias", []),
		),
		SemanticNamedType("FirstAlias", []),
	)


func test_type_registration_uses_reserved_constructor_ids() -> Bool:
	base = ENV_EMPTY
	env = env_add_type_with_constructor_ids(
		{ base | next_def_id = 43 },
		"Choice",
		[],
		[
			{
				name = "Left",
				fields = [TYPE_INT],
				tag = 0
			},
			{
				name = "Right",
				fields = [TYPE_INT],
				tag = 1
			},
		],
		TypeUnion(TaggedUnion),
		False,
		True,
		[Some(41), Some(42)],
	)

	match (env_get_constructor(env, "Left"), env_get_constructor(env, "Right")):
		(Some(left), Some(right)):
			left.constructor_id == 41 and right.constructor_id == 42 and env.next_def_id == 43
		_:
			False


func test_traits_impls_overloads_and_ufcs() -> Bool:
	show_method = trait_method_sig("show", [SemanticTypeVar("Self", SemanticTypeParameter)], TYPE_STRING, True)
	var env: Env = ENV_EMPTY
	env = env_add_trait(
		env,
		trait_def(1, test_trait_id("Stringable"), "Stringable", [], [show_method]),
	)
	env = env_add_trait(
		env,
		trait_def(2, test_trait_id("Display"), "Display", [test_trait_id("Stringable")], []),
	)
	env = env_set_type_param_bounds(env, [test_bound_type_param("T", ["Display"])])
	env = env_add_trait_function(env, "show", "Stringable")
	env = env_add_impl(
		env,
		impl_instance(3, test_trait_id("Display"), TYPE_STRING, [], False),
	)
	int_entry = overload_entry(10, TYPE_INT, TYPE_STRING)
	string_entry = overload_entry(11, TYPE_STRING, TYPE_STRING)
	int_string_entry = two_arg_overload_entry(13, TYPE_INT, TYPE_STRING, TYPE_STRING)
	int_bool_entry = two_arg_overload_entry(14, TYPE_INT, TYPE_BOOL, TYPE_BOOL)
	selected_two_arg = env_select_overload_for_args(
		[int_string_entry, int_bool_entry],
		[TYPE_INT, TYPE_BOOL],
	)
	windowed_entry: OverloadEntry = {
		def_id = 12,
		func_type = string_entry.func_type,
		type_params = string_entry.type_params,
		param_names = string_entry.param_names,
		purity = string_entry.purity,
		origin = string_entry.origin,
		resource_args = string_entry.resource_args,
		module_path = string_entry.module_path,
		dim_constraints = string_entry.dim_constraints,
		loop_producer = Some(LoopProducerWindows),
		debug_only = string_entry.debug_only
	}
	env = env_add_test_ufcs_function(env, "windowed", windowed_entry)
	env = env_add_func(
		env,
		"local_helper",
		SemanticFunctionType(True, [], TYPE_BOOL),
		Pure,
		UserDefinedFunc,
	)
	declaring_methods = env_trait_methods_with_declaring_trait(env, "Display")
	env = env_add_func(
		env,
		"print",
		SemanticFunctionType(False, [TYPE_STRING], TYPE_INT),
		Impure,
		BuiltinFunc,
	)

	match (
		(
			env_select_overload_for_args(
				[int_entry, string_entry],
				[TYPE_STRING],
			),
			env_lookup_session_ufcs_functions(env, "windowed", TYPE_STRING).get(0),
		)
	):
		(Some(resolved_overload), Some(ufcs_entry)):
			match env_get_func_info(env, "local_helper"):
				Some((_, _, purity)):
					generic_entry: OverloadEntry = {
						def_id = int_entry.def_id,
						func_type = int_entry.func_type,
						type_params = [test_bound_type_param("U", ["Stringable"])],
						param_names = int_entry.param_names,
						purity = int_entry.purity,
						origin = int_entry.origin,
						resource_args = int_entry.resource_args,
						module_path = int_entry.module_path,
						dim_constraints = int_entry.dim_constraints,
						loop_producer = int_entry.loop_producer,
						debug_only = int_entry.debug_only
					}

					(
						resolved_overload.def_id == 11
						and match selected_two_arg:
							Some(entry):
								entry.def_id == 14
							None:
								False
						and ufcs_entry.def_id == 12
						and not env_lookup_session_ufcs_functions(
							env,
							"windowed",
							TYPE_STRING,
						).is_empty()
						and env_trait_has_supertrait(env, "Display", "Stringable")
						and env_trait_method_names_transitive(env, "Display") == ["show"]
						and declaring_methods.length() == 1
						and match declaring_methods.get(0):
							Some(pair):
								pair[0] == "show" and pair[1] == "Stringable"
							None:
								False
						and env_has_trait_bound_transitive(env, "T", test_trait_id("Stringable"))
						and env_get_function_trait(env, "show") == Some("Stringable")
						and env_resolve_trait_obligation(
							env,
							trait_obligation(TYPE_STRING, test_trait_id("Stringable")),
						) == TraitObligationSatisfied
						and env_resolve_trait_obligation(
							env,
							trait_obligation(SemanticTypeVar("T", SemanticTypeParameter), test_trait_id("Stringable")),
						) == TraitObligationSatisfied
						and env_resolve_trait_obligation(
							env,
							trait_obligation(test_meta_type(1), test_trait_id("Stringable")),
						) == TraitObligationDeferred
						and env_resolve_trait_obligation(
							env,
							trait_obligation(TYPE_INT, test_trait_id("Stringable")),
						) == TraitObligationUnsatisfied
						and overload_type_param_names(generic_entry) == ["U"]
						and purity == Pure
					)
				None:
					False
		_:
			False


func test_empty_type_param_extension_preserves_environment() -> Bool:
	extended = env_extend_type_param_bounds(
		env_set_type_param_bounds(ENV_EMPTY, [test_bound_type_param("T", ["Display"])]),
		[],
	)

	env_has_trait_bound_transitive(extended, "T", test_trait_id("Display"))


func test_resolve_self_borrows_inputs_and_returns_owned_types() -> Bool:
	concrete = SemanticNamedType("Widget", [])
	source = SemanticFunctionType(
		True,
		[SemanticSelfType, SemanticArrayType(SemanticSelfType, [SemanticConstIntType(2)])],
		SemanticSelfType,
	)
	resolved = resolve_self(concrete, source)
	resolved_again = resolve_self(concrete, source)
	expected = SemanticFunctionType(
		True,
		[SemanticNamedType("Widget", []), SemanticArrayType(
				SemanticNamedType("Widget", []),
				[SemanticConstIntType(2)],
			)],
		SemanticNamedType(
			"Widget",
			[],
		),
	)

	types_equal(
		concrete,
		SemanticNamedType("Widget", []),
	) and types_equal(
		source,
		SemanticFunctionType(
			True,
			[SemanticSelfType, SemanticArrayType(SemanticSelfType, [SemanticConstIntType(2)])],
			SemanticSelfType,
		),
	) and types_equal(resolved, expected) and types_equal(resolved_again, expected)


