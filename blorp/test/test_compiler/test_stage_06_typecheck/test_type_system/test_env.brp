func test_overload_matching_handles_generic_callback_parameters() -> Bool:
	generic_callback_entry: OverloadEntry = {
		def_id = 62,
		func_type = SemanticFunctionType(
			True,
			[
				SemanticNamedType("List", [SemanticTypeVar("T", SemanticTypeParameter)]),
				SemanticFunctionType(True, [SemanticTypeVar("T", SemanticTypeParameter)], SemanticTypeVar("U", SemanticTypeParameter)),
			],
			SemanticNamedType(
				"List",
				[SemanticTypeVar("U", SemanticTypeParameter)],
			),
		),
		type_params = [test_bound_type_param("T", []), test_bound_type_param("U", [])],
		param_names = [Some("values"), Some("mapper")],
		purity = Pure,
		origin = UserDefinedFunc,
		resource_args = RejectResourceArgs,
		module_path = None,
		dim_constraints = [],
		loop_producer = None,
		debug_only = False
	}
	decoy = two_arg_overload_entry(63, TYPE_STRING, TYPE_STRING, TYPE_STRING)

	pure_selection = env_select_overload_for_args(
		[generic_callback_entry, decoy],
		[
			SemanticNamedType("List", [TYPE_INT]),
			SemanticFunctionType(True, [TYPE_INT], TYPE_STRING),
		],
	)
	impure_selection = env_select_overload_for_args(
		[generic_callback_entry],
		[
			SemanticNamedType("List", [TYPE_INT]),
			SemanticFunctionType(False, [TYPE_INT], TYPE_STRING),
		],
	)

	match pure_selection:
		Some(selected):
			selected.def_id == 62 and impure_selection.is_none()
		None:
			False


func test_overload_matching_rejects_narrower_higher_order_callback() -> Bool:
	impure_callback = SemanticFunctionType(False, [TYPE_INT], TYPE_INT)
	pure_callback = SemanticFunctionType(True, [TYPE_INT], TYPE_INT)
	expected_higher_order = SemanticFunctionType(False, [impure_callback], TYPE_INT)
	narrower_actual = SemanticFunctionType(True, [pure_callback], TYPE_INT)
	entry = two_arg_overload_entry(64, TYPE_INT, expected_higher_order, TYPE_INT)

	env_select_overload_for_args(
		[entry],
		[TYPE_INT, narrower_actual],
	).is_none()


func test_generic_impl_requires_concrete_type_to_satisfy_bounds() -> Bool:
	var env: Env = ENV_EMPTY
	env = env_add_trait(
		env,
		trait_def(42, test_trait_id("Showable"), "Showable", [], []),
	)
	env = env_add_trait(
		env,
		trait_def(43, test_trait_id("Printable"), "Printable", [], []),
	)
	env = env_add_impl(
		env,
		impl_instance(44, test_trait_id("Showable"), TYPE_INT, [], False),
	)
	env = env_add_impl(
		env,
		impl_instance(45,
			test_trait_id("Printable"),
			SemanticNamedType("Box", [SemanticNamedType("T", [])]),
			[test_bound_type_param("T", ["Showable"])],
			False,
		),
	)
	bounded_env = env_set_type_param_bounds(env, [test_bound_type_param("T", ["Showable"])])

	env_resolve_trait_obligation(
		env,
		trait_obligation(
			SemanticNamedType("Box", [TYPE_INT]),
			test_trait_id("Printable")),
	) == TraitObligationSatisfied and env_resolve_trait_obligation(
		env,
		trait_obligation(
			SemanticNamedType("Box", [TYPE_STRING]),
			test_trait_id("Printable")),
	) == TraitObligationUnsatisfied and env_resolve_trait_obligation(
		env,
		trait_obligation(
			SemanticNamedType("Box", [SemanticNamedType("T", [])]),
			test_trait_id("Printable")),
	) == TraitObligationUnsatisfied and env_resolve_trait_obligation(
		bounded_env,
		trait_obligation(
			SemanticNamedType("Box", [SemanticNamedType("T", [])]),
			test_trait_id("Printable")),
	) == TraitObligationSatisfied


func test_union_type_kind_equality_preserves_layout_identity() -> Bool:
	kinds = [TypeUnion(ScalarTagUnion), TypeUnion(TaggedUnion), TypeBuiltin, TypeScalarBuiltin, TypeResource]
	var matches: Bool = True
	for left in kinds.enumerate():
		for right in kinds.enumerate():
			matches = matches and ((left[1] == right[1]) == (left[0] == right[0]))
	matches


func test_union_type_kind_retains_installed_layout() -> Bool:
	scalar = env_add_type(ENV_EMPTY, "Scalar", [], [], TypeUnion(ScalarTagUnion), False, False)
	env = env_add_type(scalar, "Managed", [], [], TypeUnion(TaggedUnion), False, False)
	match (env_get_type_kind(env, "Scalar"), env_get_type_kind(env, "Managed")):
		(Some(TypeUnion(scalar_layout)), Some(TypeUnion(managed_layout))):
			(
				scalar_layout == ScalarTagUnion and managed_layout == TaggedUnion
				and not env_has_compiler_structural_equality(env, SemanticNamedType("Scalar", []))
				and env_resolve_trait_obligation(
					env,
					trait_obligation(SemanticNamedType("Scalar", []), test_trait_id("Hashable")),
				) == TraitObligationUnsatisfied
			)
		_:
			False
func test_default_tag_equality_is_scoped_and_not_hashability() -> Bool:
	outer = env_add_accepted_default_tag_equality(
		env_add_accepted_default_tag_equality(ENV_EMPTY, "OtherChoice"),
		"TagChoice",
	)
	typ = SemanticNamedType("TagChoice", [])
	authored_hash = env_add_impl(
		outer,
		impl_instance(46, test_trait_id("Hashable"), typ, [], False),
	)
	inner = env_add_type(env_push_scope(outer), "TagChoice", [], [], TypeUnion(TaggedUnion), False, True)
	(
		env_has_compiler_structural_equality(outer, typ)
		and env_resolve_trait_obligation(
			outer,
			trait_obligation(typ, test_trait_id("Hashable")),
		) == TraitObligationUnsatisfied
		and env_resolve_trait_obligation(
			authored_hash,
			trait_obligation(typ, test_trait_id("Hashable")),
		) == TraitObligationSatisfied
		and not env_has_compiler_structural_equality(outer, SemanticNamedType("TagChoice", [TYPE_INT]))
		and not env_has_compiler_structural_equality(inner, typ)
		and env_has_compiler_structural_equality(inner, SemanticNamedType("OtherChoice", []))
		and env_has_compiler_structural_equality(env_pop_scope(inner), typ)
		and env_has_compiler_structural_equality(outer, typ)
	)


func test_compiler_structural_equality_satisfies_trait_obligations() -> Bool:
	var env = env_add_type(ENV_EMPTY, "Choice", [], [], TypeUnion(TaggedUnion), False, False)
	env = env_add_type(env, "Color", [], [], TypeUnion(ScalarTagUnion), False, False)
	env = env_add_accepted_default_tag_equality(env, "Color")
	tested_env: Env = env
	structural_types: List[SemanticType] = [
		SemanticArrayType(TYPE_INT, [SemanticConstIntType(4)]),
		SemanticRangeType(SemanticConstIntType(4)),
		SemanticNamedType("Color", []),
		SemanticNamedType("Set", [TYPE_INT]),
	]
	-- Unions with payloads, tuples and Dict compare their contents through
	-- Equatable implementations, and Bytes has its own, so the compiler
	-- provides nothing for them; without an impl in scope they are not
	-- Equatable.
	implementation_only_types: List[SemanticType] = [
		SemanticNamedType("Choice", []),
		SemanticTupleType([TYPE_INT, TYPE_STRING]),
		SemanticNamedType("Point", []),
		SemanticNamedType(
			"Dict",
			[TYPE_STRING, TYPE_INT],
		),
		SemanticNamedType("Bytes", []),
	]

	structural_types.all(pure func(typ):
		env_resolve_trait_obligation(
			tested_env,
			trait_obligation(typ, test_trait_id("Equatable")),
		) == TraitObligationSatisfied
	) and implementation_only_types.all(pure func(typ):
		env_resolve_trait_obligation(
			tested_env,
			trait_obligation(typ, test_trait_id("Equatable")),
		) == TraitObligationUnsatisfied
	)


-- Two traits that share a spelling stay apart: the supertrait walk follows the
-- identities a trait records, not the names.
func test_supertrait_walk_follows_identity_not_spelling() -> Bool:
	first_id = graph_trait_id(2001).get_or(TRAIT_ID_STRINGABLE)
	second_id = graph_trait_id(2002).get_or(TRAIT_ID_STRINGABLE)
	env = env_add_trait(
		env_add_trait(ENV_EMPTY, trait_def(1, first_id, "Show", [], [])),
		trait_def(2, second_id, "Show", [first_id], []),
	)

	env_trait_id_has_supertrait(env, second_id, first_id) and not env_trait_id_has_supertrait(
		env,
		first_id,
		second_id,
	)


func test_prepared_module_declarations_create_isolated_root_environments() -> Bool:
	function = func_symbol(
		40,
		SemanticFunctionType(True, [TYPE_INT], TYPE_INT),
		[],
		[Some("value")],
		Pure,
		UserDefinedFunc,
		RejectResourceArgs,
		None,
		[],
		None,
		False,
	)
	base = env_add_func_with_info(
		env_add_var(ENV_EMPTY, "root_value", TYPE_INT),
		"root_function",
		function,
	)

	match prepare_module_declaration_env(base):
		None:
			False
		Some(prepared):
			first = env_from_prepared_module_declarations(prepared)
			first_nested = env_set_type_param_bounds(
				env_add_var(env_push_scope(first), "body_local", TYPE_STRING),
				[test_bound_type_param("T", [])],
			)
			(second_after_mint, second_id) = env_mint_def_id(
				env_from_prepared_module_declarations(prepared),
			)
			third = env_from_prepared_module_declarations(prepared)

			match (
				env_get_var_type(first_nested, "body_local"),
				env_get_var_type(third, "body_local"),
				env_get_func_info(third, "root_function"),
			):
				(Some(local_type), None, Some((root_function_type, _, _))):
					(
						types_equal(local_type, TYPE_STRING)
						and types_equal(root_function_type, function.func_type)
						and env_get_type_params(first_nested) == ["T"]
						and env_get_type_params(third).is_empty()
						and prepare_module_declaration_env(first_nested).is_none()
						and prepare_infer_session_env(env_push_scope(first)).is_none()
						and second_id == base.next_def_id
						and second_after_mint.next_def_id == base.next_def_id + 1
						and third.next_def_id == base.next_def_id
					)
				_:
					False


