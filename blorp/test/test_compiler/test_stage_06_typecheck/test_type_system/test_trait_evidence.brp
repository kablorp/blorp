private func legal_body_result(result: TypecheckProgramResult) -> Result[TypecheckProgramResult, String]:
	if result.state.errors.is_empty():
		Ok(result)
	else:
		Err("trait evidence positive fixture body is not legal: " + result.state.errors.join("; "))


private func legal_trait_evidence_fixture(
	program: ParsedProgram,
	modules: List[ImportableModule],
) -> Result[TypecheckGraphProgramFixture, String]:
	fixture ?= typecheck_test_graph_program_fixture(typecheck_state_for_origin(TYPECHECK_USER_ORIGIN), program, modules)
	if fixture.result.state.errors.is_empty():
		Ok(fixture)
	else:
		Err("trait evidence positive fixture body is not legal: " + fixture.result.state.errors.join("; "))


private func evidence_fixture() -> Option[TypecheckGraphProgramFixture]:
	program = parse_compiler_source(source_file("evidence/main.brp", "evidence/main",
		|trait Selector:
		|	pure func select(value: Self) -> Int
		|implements Selector for Int:
		|	pure func select(value: Int) -> Int: 7
		|trait Equatable:
		|	pure func equals(left: Self, right: Self) -> Bool
		|fixed union Shade:
		|	Dark
		|	Light
		|union Plain:
		|	Empty
	))
	match legal_trait_evidence_fixture(program, []):
		Ok(fixture): Some(fixture)
		Err(message):
			print(message)
			None


private func context_borrows_actual_graph_view() -> Option[Bool]:
	fixture ?= evidence_fixture()
	Some(trait_evidence_context(
		fixture.result.state.module_view,
		accepted_typecheck_graph_definition_table(fixture.graph),
		accepted_typecheck_graph_implementation_headers(fixture.graph),
	).is_ok())


func test_context_borrows_actual_graph_view() -> Bool:
	context_borrows_actual_graph_view().get_or(False)


private func context_rejects_foreign_issuer() -> Option[Bool]:
	fixture ?= evidence_fixture()
	foreign_fixture ?= evidence_fixture()
	Some(match trait_evidence_context(
		fixture.result.state.module_view,
		accepted_typecheck_graph_definition_table(foreign_fixture.graph),
		accepted_typecheck_graph_implementation_headers(fixture.graph),
	):
		Err(message): message == "trait evidence context issuer does not match accepted module authorities"
		Ok(_): False
	)


func test_context_rejects_foreign_issuer() -> Bool:
	context_rejects_foreign_issuer().get_or(False)


private func context_rejects_foreign_headers() -> Option[Bool]:
	fixture ?= evidence_fixture()
	foreign_fixture ?= evidence_fixture()
	Some(match trait_evidence_context(
		fixture.result.state.module_view,
		accepted_typecheck_graph_definition_table(fixture.graph),
		accepted_typecheck_graph_implementation_headers(foreign_fixture.graph),
	):
		Err(message): message == "trait evidence context headers do not match accepted issuer"
		Ok(_): False
	)


func test_context_rejects_foreign_headers() -> Bool:
	context_rejects_foreign_headers().get_or(False)


private func context_rejects_same_issuer_foreign_callable_owner() -> Result[Bool, String]:
	provider_program = parse_compiler_source(source_file("provider.brp", "provider",
		"pure func provided() -> Int: 1",
	))
	provider_graph ?= indexed_graph_build(module_load_candidate(
		resolved_module_identity_from_resolver("provider", UserModule),
		finalized_typecheck_program(provider_program),
	), []).map_err(func(errors): errors.map(indexed_graph_error_message).join("; "))
	importer_program = parse_compiler_source(source_file("main.brp", "main",
		"import:\n\tprovider: provided\npure func importer() -> Int: provided()",
	))
	fixture ?= legal_trait_evidence_fixture(
		importer_program,
		[importable_module(indexed_graph_target_scope(provider_graph))],
	)
	issuer = accepted_typecheck_graph_definition_table(fixture.graph)
	headers = accepted_typecheck_graph_implementation_headers(fixture.graph)
	bound_graph = type_header_graph_bound_graph(trait_topology_graph_type_headers(
		callable_header_graph_trait_topology(implementation_header_graph_callable_headers(headers)),
	))
	provider ?= bound_module_graph_find_canonical_path(bound_graph, "provider").to_result("provider scope is absent from shared graph")
	provider_input ?= accepted_graph_typecheck_module(fixture.graph, bound_module_scope(provider), False).to_result("provider input is absent from accepted graph")
	provider_result ?= legal_body_result(typecheck_program_with_type_header_module(provider_input))
	importer_context ?= trait_evidence_context(fixture.result.state.module_view, issuer, headers)
	provider_context ?= trait_evidence_context(provider_result.state.module_view, issuer, headers)
	provider_authority ?= module_view_accepted_callable_authority(provider_result.state.module_view).to_result("provider callable authority is absent")
	importer_authority ?= module_view_accepted_callable_authority(fixture.result.state.module_view).to_result("importer callable authority is absent")
	provider_owner ?= accepted_callable_authority_owner_module_id(provider_authority).to_result("provider callable owner is absent")
	importer_owner ?= accepted_callable_authority_owner_module_id(importer_authority).to_result("importer callable owner is absent")
	provided ?= callable_header_graph_callables(implementation_header_graph_callable_headers(headers)).find(func(header):
		callable_header_name(header) == "provided"
	).to_result("provider callable header is absent")
	provider_slots ?= trait_evidence_callable_slots(provider_context, issuer, callable_header_id(provided))
	provider_lexical ?= trait_evidence_lexical_context(provider_context, issuer, callable_header_id(provided), provider_slots)
	spliced = module_view_with_accepted_callable_authority(fixture.result.state.module_view, provider_authority)
	foreign_callable_rejected = match trait_evidence_callable_slots(importer_context, issuer, callable_header_id(provided)):
		Err(message): message == "trait evidence callable owner does not match context module"
		Ok(_): False
	foreign_bundle_rejected = match trait_evidence_lexical_context(importer_context, issuer, callable_header_id(provided), provider_slots):
		Err(message): message == "trait evidence callable owner does not match context module"
		Ok(_): False
	spliced_rejected = match trait_evidence_context(spliced, issuer, headers):
		Err(message): not module_ids_equal(provider_owner, importer_owner) and message == "trait evidence context authority owner does not match accepted module view"
		Ok(_): False
	Ok(foreign_callable_rejected and foreign_bundle_rejected and spliced_rejected)


func test_context_rejects_same_issuer_foreign_callable_owner() -> Bool:
	match context_rejects_same_issuer_foreign_callable_owner():
		Ok(valid): valid
		Err(message):
			print(message)
			False


private func registry_rejects_graph_namesake_identity() -> Option[Bool]:
	fixture ?= evidence_fixture()
	issuer = accepted_typecheck_graph_definition_table(fixture.graph)
	authority ?= module_view_accepted_trait_implementation_authority(fixture.result.state.module_view)
	namesake ?= accepted_trait_find(authority, "Equatable")
	registry ?= builtin_trait_evidence_registry().to_option()
	Some(not trait_id_is_compiler_builtin(namesake.trait_id)
		and trait_id_module_id(issuer, namesake.trait_id).is_some()
		and match builtin_trait_evidence_members(registry, namesake.trait_id):
			Err(message): message == "compiler trait evidence identity is not registered"
			Ok(_): False
	)


func test_registry_rejects_graph_namesake_identity() -> Bool:
	registry_rejects_graph_namesake_identity().get_or(False)


private func fieldless_union_capability_retains_exact_issued_identity() -> Option[Bool]:
	fixture ?= evidence_fixture()
	foreign_fixture ?= evidence_fixture()
	issuer = accepted_typecheck_graph_definition_table(fixture.graph)
	authority ?= module_view_accepted_union_authority(fixture.result.state.module_view)
	type_headers = trait_topology_graph_type_headers(callable_header_graph_trait_topology(
		implementation_header_graph_callable_headers(accepted_typecheck_graph_implementation_headers(fixture.graph)),
	))
	shade_header ?= type_header_graph_headers(type_headers).find(func(header): header.source_name == "Shade")
	plain_header ?= type_header_graph_headers(type_headers).find(func(header): header.source_name == "Plain")
	shade_selected ?= accepted_union_scalar_tag_identity(authority, issuer, SemanticNamedType("Shade", [])).to_option()
	plain_selected ?= accepted_union_scalar_tag_identity(authority, issuer, SemanticNamedType("Plain", [])).to_option()
	shade_id ?= shade_selected
	plain_id ?= plain_selected
	Some(type_ids_equal(shade_id, shade_header.id)
		and type_ids_equal(plain_id, plain_header.id)
		and not type_ids_equal(shade_id, plain_id)
		and accepted_union_scalar_tag_identity(authority, issuer, SemanticNamedType("Shade", [TYPE_INT])).map(func(selected): selected.is_none()).get_or(False)
		and accepted_union_scalar_tag_identity(authority, issuer, SemanticNamedType("Plain", [TYPE_INT])).map(func(selected): selected.is_none()).get_or(False)
		and match accepted_union_scalar_tag_identity(authority, accepted_typecheck_graph_definition_table(foreign_fixture.graph), SemanticNamedType("Shade", [])):
			Err(message): message == "compiler scalar union evidence issuer does not match accepted authority"
			Ok(_): False
	)


func test_fieldless_union_capability_retains_exact_issued_identity() -> Bool:
	fieldless_union_capability_retains_exact_issued_identity().get_or(False)


-- Two accepted owners deliberately use the same parameter spelling. Neither
-- graph provenance nor that spelling can authorize a cross-callable slot bundle.
private func lexical_slots_reject_same_spelled_foreign_owner() -> Result[Bool, String]:
	program = parse_compiler_source(source_file("slots/main.brp", "slots/main",
		|trait Selector:
		|	pure func select(value: Self) -> Int
		|trait Describer:
		|	pure func describe(value: Self) -> Int
		|pure func first[T: Selector](value: T) -> T: value
		|pure func second[T: Selector](value: T) -> T: value
		|pure func offset[U, T: Selector + Describer](unused: U, value: T) -> T: value
		|pure func shaped[#Ds, T: Selector](shape: Int[#Ds...], value: T) -> T: value
	))
	fixture ?= legal_trait_evidence_fixture(program, [])
	headers = accepted_typecheck_graph_implementation_headers(fixture.graph)
	context ?= trait_evidence_context(fixture.result.state.module_view,
		accepted_typecheck_graph_definition_table(fixture.graph), headers)
	callables = callable_header_graph_callables(implementation_header_graph_callable_headers(headers))
	first ?= callables.find(func(header): callable_header_name(header) == "first").to_result("missing first accepted header")
	second ?= callables.find(func(header): callable_header_name(header) == "second").to_result("missing second accepted header")
	issuer = accepted_typecheck_graph_definition_table(fixture.graph)
	slots ?= trait_evidence_callable_slots(context, issuer, callable_header_id(first))
	second_slots ?= trait_evidence_callable_slots(context, issuer, callable_header_id(second))
	second_context ?= trait_evidence_lexical_context(context, issuer, callable_header_id(second), second_slots)
	first_context ?= trait_evidence_lexical_context(context, issuer, callable_header_id(first), slots)
	detached ?= trait_evidence_callable_bound_slots(slots).get(0).to_result("missing first detached slot")
	offset ?= callables.find(func(header): callable_header_name(header) == "offset").to_result("missing offset accepted header")
	offset_slots ?= trait_evidence_callable_slots(context, issuer, callable_header_id(offset))
	bound_slots = trait_evidence_callable_bound_slots(offset_slots)
	bound ?= bound_slots.get(0).to_result("missing offset bound slot")
	second_bound ?= bound_slots.get(1).to_result("missing second offset bound slot")
	effective ?= trait_evidence_callable_parameters(offset_slots).get(1).to_result("missing offset effective parameter")
	shaped ?= callables.find(func(header): callable_header_name(header) == "shaped").to_result("missing shaped accepted header")
	shaped_slots ?= trait_evidence_callable_slots(context, issuer, callable_header_id(shaped))
	shaped_bounds = trait_evidence_callable_bound_slots(shaped_slots)
	shaped_bound ?= shaped_bounds.get(0).to_result("missing shaped bound slot")
	authority ?= module_view_accepted_trait_implementation_authority(fixture.result.state.module_view).to_result("missing trait authority")
	selector ?= accepted_trait_find(authority, "Selector").to_result("missing declared Selector")
	describer ?= accepted_trait_find(authority, "Describer").to_result("missing declared Describer")
	expected = bound_trait_identity_from_id(issuer, selector.trait_id)
	expected_second = bound_trait_identity_from_id(issuer, describer.trait_id)
	detached_rejected = match trait_evidence_lexical_slot(second_context, detached):
		Err(message): message == "trait evidence detached slot does not belong to active callable"
		Ok(_): False
	bundle_rejected = match trait_evidence_lexical_context(context, issuer, callable_header_id(second), slots):
		Err(message): message == "trait evidence lexical slots do not belong to active callable"
		Ok(_): False
	Ok(bound_slots.length() == 2
		and effective.name == "T"
		and effective.bound_identities.length() == 2
		and trait_evidence_slot_parameter_index(bound) == 1
		and trait_evidence_slot_bound_index(bound) == 0
		and bound_trait_identities_equal(trait_evidence_slot_bound(bound), expected)
		and trait_evidence_slot_parameter_index(second_bound) == 1
		and trait_evidence_slot_bound_index(second_bound) == 1
		and bound_trait_identities_equal(trait_evidence_slot_bound(second_bound), expected_second)
		and not bound_trait_identities_equal(expected, expected_second)
		and shaped_bounds.length() == 1
		and trait_evidence_slot_parameter_index(shaped_bound) == 0
		and trait_evidence_slot_bound_index(shaped_bound) == 0
		and bound_trait_identities_equal(trait_evidence_slot_bound(shaped_bound), expected)
		and trait_evidence_lexical_context(context, issuer, callable_header_id(first), slots).is_ok()
		and trait_evidence_lexical_slot(first_context, detached).is_ok()
		and callable_ids_equal(trait_evidence_lexical_owner_callable(trait_evidence_slot_owner(detached)), callable_header_id(first))
		and definition_tables_share_provenance(issuer, trait_evidence_lexical_owner_issuer(trait_evidence_slot_owner(detached)))
		and detached_rejected and bundle_rejected
	)


func test_lexical_slots_reject_same_spelled_foreign_owner() -> Bool:
	match lexical_slots_reject_same_spelled_foreign_owner():
		Ok(valid): valid
		Err(message):
			print(message)
			False


private func lexical_slots_reject_foreign_issuer() -> Result[Bool, String]:
	fixture ?= legal_trait_evidence_fixture(
		parse_compiler_source(source_file("foreign/main.brp", "foreign/main",
			|trait Selector:
			|	pure func select(value: Self) -> Int
			|pure func first[T: Selector](value: T) -> T: value
		)), [])
	foreign_fixture ?= legal_trait_evidence_fixture(
		parse_compiler_source(source_file("foreign/main.brp", "foreign/main",
			|trait Selector:
			|	pure func select(value: Self) -> Int
			|pure func first[T: Selector](value: T) -> T: value
		)), [])
	issuer = accepted_typecheck_graph_definition_table(fixture.graph)
	foreign_issuer = accepted_typecheck_graph_definition_table(foreign_fixture.graph)
	headers = accepted_typecheck_graph_implementation_headers(fixture.graph)
	foreign_headers = accepted_typecheck_graph_implementation_headers(foreign_fixture.graph)
	context ?= trait_evidence_context(fixture.result.state.module_view, issuer, headers)
	foreign_context ?= trait_evidence_context(foreign_fixture.result.state.module_view, foreign_issuer, foreign_headers)
	header ?= callable_header_graph_callables(implementation_header_graph_callable_headers(headers)).get(0).to_result("missing callable header")
	foreign_header ?= callable_header_graph_callables(implementation_header_graph_callable_headers(foreign_headers)).get(0).to_result("missing foreign callable header")
	id = callable_header_id(header)
	foreign_id = callable_header_id(foreign_header)
	slots ?= trait_evidence_callable_slots(foreign_context, foreign_issuer, foreign_id)
	local_slots ?= trait_evidence_callable_slots(context, issuer, id)
	local_context ?= trait_evidence_lexical_context(context, issuer, id, local_slots)
	detached ?= trait_evidence_callable_bound_slots(slots).get(0).to_result("missing foreign detached slot")
	callable_rejected = match trait_evidence_callable_slots(context, foreign_issuer, foreign_id):
		Err(message): message == "trait evidence callable issuer does not match context"
		Ok(_): False
	bundle_rejected = match trait_evidence_lexical_context(context, issuer, id, slots):
		Err(message): message == "trait evidence lexical slot issuer does not match context"
		Ok(_): False
	active_rejected = match trait_evidence_lexical_context(context, foreign_issuer, foreign_id, slots):
		Err(message): message == "trait evidence active callable issuer does not match context"
		Ok(_): False
	detached_rejected = match trait_evidence_lexical_slot(local_context, detached):
		Err(message): message == "trait evidence detached slot issuer does not match active callable"
		Ok(_): False
	Ok(callable_ids_equal(id, foreign_id) and callable_rejected and bundle_rejected and active_rejected and detached_rejected)


func test_lexical_slots_reject_foreign_issuer() -> Bool:
	match lexical_slots_reject_foreign_issuer():
		Ok(valid): valid
		Err(message):
			print(message)
			False


private func implementation_slots_follow_effective_body_order() -> Result[Bool, String]:
	fixture ?= legal_trait_evidence_fixture(
		parse_compiler_source(source_file("implementation/main.brp", "implementation/main",
			|trait Selector:
			|	pure func select(value: Self) -> Int
			|	pure func default_select(value: Self) -> Int: 9
			|record Box[T] {value: T}
			|implements Selector for Box[T: Selector]:
			|	pure func select(value: Box[T]) -> Int: 7
			|	pure func pick[U: Selector](value: Box[T], other: U) -> U: other
		)), [])
	issuer = accepted_typecheck_graph_definition_table(fixture.graph)
	headers = accepted_typecheck_graph_implementation_headers(fixture.graph)
	context ?= trait_evidence_context(fixture.result.state.module_view, issuer, headers)
	implementation ?= implementation_header_graph_headers(headers).get(0).to_result("missing implementation header")
	methods = implementation_header_methods(implementation)
	pick ?= methods.find(func(header): implementation_method_header_name(header) == "pick").to_result("missing explicit method header")
	default_method ?= methods.find(func(header): implementation_method_header_name(header) == "default_select").to_result("missing default method header")
	pick_slots ?= trait_evidence_callable_slots(context, issuer, implementation_method_header_id(pick))
	default_slots ?= trait_evidence_callable_slots(context, issuer, implementation_method_header_id(default_method))
	pick_bounds = trait_evidence_callable_bound_slots(pick_slots)
	default_bounds = trait_evidence_callable_bound_slots(default_slots)
	enclosing ?= pick_bounds.get(0).to_result("missing enclosing implementation bound")
	explicit ?= pick_bounds.get(1).to_result("missing explicit method bound")
	inherited ?= default_bounds.get(0).to_result("missing default enclosing bound")
	authority ?= module_view_accepted_trait_implementation_authority(fixture.result.state.module_view).to_result("missing implementation trait authority")
	selector ?= accepted_trait_find(authority, "Selector").to_result("missing declared implementation Selector")
	expected = bound_trait_identity_from_id(issuer, selector.trait_id)
	Ok(pick_bounds.length() == 2 and default_bounds.length() == 1
		and trait_evidence_slot_parameter_index(enclosing) == 0
		and trait_evidence_slot_parameter_index(explicit) == 1
		and trait_evidence_slot_parameter_index(inherited) == 0
		and trait_evidence_slot_bound_index(enclosing) == 0
		and trait_evidence_slot_bound_index(explicit) == 0
		and trait_evidence_slot_bound_index(inherited) == 0
		and bound_trait_identities_equal(trait_evidence_slot_bound(enclosing), expected)
		and bound_trait_identities_equal(trait_evidence_slot_bound(explicit), expected)
		and bound_trait_identities_equal(trait_evidence_slot_bound(inherited), expected)
		and trait_evidence_lexical_context(context, issuer, implementation_method_header_id(default_method), default_slots).is_ok()
	)


func test_implementation_slots_follow_effective_body_order() -> Bool:
	match implementation_slots_follow_effective_body_order():
		Ok(valid): valid
		Err(message):
			print(message)
			False


tests: TestSuite = {
