---
Every builtin trait constant with the name the registry gives it.
---
private pure func pinned_builtin_traits() -> List[(String, TraitId)]:
	[
		("Stringable", TRAIT_ID_STRINGABLE),
		("Equatable", TRAIT_ID_EQUATABLE),
		("Orderable", TRAIT_ID_ORDERABLE),
		("HasLength", TRAIT_ID_HAS_LENGTH),
		("Integer", TRAIT_ID_INTEGER),
		("FloatingPoint", TRAIT_ID_FLOATING_POINT),
		("Addable", TRAIT_ID_ADDABLE),
		("Subtractable", TRAIT_ID_SUBTRACTABLE),
		("Multipliable", TRAIT_ID_MULTIPLIABLE),
		("Divisible", TRAIT_ID_DIVISIBLE),
		("Modulable", TRAIT_ID_MODULABLE),
		("Negatable", TRAIT_ID_NEGATABLE),
		("HasZero", TRAIT_ID_HAS_ZERO),
		("HasOne", TRAIT_ID_HAS_ONE),
		("Absolute", TRAIT_ID_ABSOLUTE),
		("Bounded", TRAIT_ID_BOUNDED),
		("Hashable", TRAIT_ID_HASHABLE),
		("ToBool", TRAIT_ID_TO_BOOL),
		("Logical", TRAIT_ID_LOGICAL),
		("ToInt", TRAIT_ID_TO_INT),
		("ToFloat", TRAIT_ID_TO_FLOAT),
		("ToFixed", TRAIT_ID_TO_FIXED),
		("ToChar", TRAIT_ID_TO_CHAR),
		("SignedInteger", TRAIT_ID_SIGNED_INTEGER),
		("UnsignedInteger", TRAIT_ID_UNSIGNED_INTEGER),
		("Numeric", TRAIT_ID_NUMERIC),
		("FixedPoint", TRAIT_ID_FIXED_POINT),
		("Copyable", TRAIT_ID_COPYABLE),
		("Cloneable", TRAIT_ID_CLONEABLE),
	]


func test_pinned_constants_equal_the_registry_identity_of_their_names() -> Bool:
	pinned_builtin_traits().all(pure func(entry: (String, TraitId)) -> Bool:
		match builtin_trait_id(entry[0]):
			Some(registry_id):
				trait_ids_equal(registry_id, entry[1])
			None:
				False
	)


-- A named helper instead of a lambda inside `all`: the nested lambda would capture
-- the outer lambda's variable, which miscompiles today (filed as "Fix nested
-- lambda capturing a pipeline source variable").
pure func occurrences(keys: List[Int], key: Int) -> Int:
	var count: Int = 0

	for candidate in keys:
		if candidate == key:
			count += 1

	count


func test_pinned_constants_name_their_traits_and_are_distinct_builtins() -> Bool:
	pinned = pinned_builtin_traits()
	names_agree: Bool = pinned.all(pure func(entry: (String, TraitId)) -> Bool:
		builtin_trait_id_name(entry[1]) == Some(entry[0]) and trait_id_is_compiler_builtin(entry[1])
	)
	keys: List[Int] = pinned.map(pure func(entry: (String, TraitId)) -> Int: trait_id_storage_key(entry[1]))
	distinct: Bool = keys.all(pure func(key: Int) -> Bool: occurrences(keys, key) == 1)

	pinned.length() == BUILTIN_TRAIT_NAMES.length() and names_agree and distinct


func test_graph_trait_ids_are_their_definition_id_and_not_builtin() -> Bool:
	id = graph_trait_id(42).get_or(TRAIT_ID_STRINGABLE)

	(
		trait_id_storage_key(id) == 42
		and graph_trait_id(0).is_some()
		and graph_trait_id(-3).is_none()
		and graph_trait_id(-1).is_none()
		and not trait_id_is_compiler_builtin(id)
		and trait_id_registry_index(id).is_none()
		and trait_id_registry_index(builtin_trait_id_at_registry_index(3)) == Some(3)
	)


func test_fixture_trait_ids_are_distinct_per_name() -> Bool:
	names = ["Display", "ExitStatusAble", "Printable", "Renderable", "Showable", "Stringable"]
	keys: List[Int] = names.map(pure func(name: String) -> Int: trait_id_storage_key(test_trait_id(name)))

	keys.all(pure func(key: Int) -> Bool: occurrences(keys, key) == 1)


pure func trait_definition_agrees_with_its_id(definition: TraitDef) -> Bool:
	(
		builtin_trait_id_name(definition.trait_id) == Some(definition.name)
		and trait_id_storage_key(definition.trait_id) != definition.def_id
	)


pure func impl_agrees_with_its_trait(env: Env, instance: ImplInstance) -> Bool:
	env_get_trait_by_id(env, instance.trait_id).is_some()


-- Every trait and impl the builtin environment installs names its own
-- identity consistently: the trait's `trait_id` is the builtin id of its name,
-- an impl's `trait_id` is the `trait_id` of the trait it names, and neither is
-- confused with the environment's own `def_id` slot (builtin `def_id`s start at
-- 100; a builtin's `trait_id` is its negative registry encoding).
func test_builtin_environment_traits_and_impls_agree_with_their_ids() -> Bool:
	env: Env = env_with_builtins(ENV_EMPTY)

	(
		env.traits.length() > 0
		and env.impls.length() > 0
		and env.traits.all(trait_definition_agrees_with_its_id)
		and env.impls.all(pure func(instance: ImplInstance) -> Bool: impl_agrees_with_its_trait(env, instance))
	)


tests: TestSuite = {
	description = "Compiler trait identity",
	tests = [
		(
			"pinned constants equal the registry identity of their names",
			test_pinned_constants_equal_the_registry_identity_of_their_names,
		),
		(
			"pinned constants name their traits and are distinct builtins",
			test_pinned_constants_name_their_traits_and_are_distinct_builtins,
		),
		(
			"fixture trait ids are distinct per name",
			test_fixture_trait_ids_are_distinct_per_name,
		),
		(
			"graph trait ids are their definition id and not builtin",
			test_graph_trait_ids_are_their_definition_id_and_not_builtin,
		),
		(
			"builtin environment traits and impls agree with their ids",
			test_builtin_environment_traits_and_impls_agree_with_their_ids,
		),
	]
}
