pure func qualify_local(typ: SemanticType) -> SemanticType:
	match typ:
		SemanticNamedType("Local", args):
			SemanticNamedType(
				"mod/a::Local",
				args.map(qualify_local),
			)
		SemanticNamedType(name, args):
			SemanticNamedType(
				name,
				args.map(qualify_local),
			)
		SemanticArrayType(element, dims):
			SemanticArrayType(
				element.qualify_local(),
				dims.map(qualify_local),
			)
		SemanticFunctionType(is_pure, params, return_type):
			SemanticFunctionType(
				is_pure,
				params.map(qualify_local),
				return_type.qualify_local(),
			)
		SemanticTupleType(elements):
			SemanticTupleType(elements.map(qualify_local))
		SemanticRangeType(inner):
			SemanticRangeType(inner.qualify_local())
		SemanticDimOpType(op, left, right):
			SemanticDimOpType(op, left.qualify_local(), right.qualify_local())
		_:
			typ


func test_resolves_qualified_names_recursively() -> Bool:
	ctx = type_resolution_context(
		ENV_EMPTY,
		[("G", "geometry"), ("D", "dimensions")],
	)
	source: SemanticType = SemanticTupleType([
		SemanticFunctionType(
			True,
			[SemanticNamedType("G.Point", []), SemanticRangeType(SemanticNamedType("D.Width", []))],
			SemanticArrayType(
				SemanticNamedType("G.Direction", []),
				[SemanticDimOpType(
						SemanticDimAdd,
						SemanticNamedType("D.Width", []),
						SemanticNamedType("D.Height", []),
					)],
			),
		),
	])
	expected: SemanticType = SemanticTupleType([
		SemanticFunctionType(
			True,
			[
				SemanticNamedType("geometry::Point", []),
				SemanticRangeType(SemanticNamedType("dimensions::Width", [])),
			],
			SemanticArrayType(
				SemanticNamedType("geometry::Direction", []),
				[SemanticDimOpType(
						SemanticDimAdd,
						SemanticNamedType("dimensions::Width", []),
						SemanticNamedType("dimensions::Height", []),
					)],
			),
		),
	])

	types_equal(
		imported_signature_canonical(ctx, source),
		expected,
	)


func test_resolution_composes_owner_qualification_and_aliases() -> Bool:
	env: Env = env_add_alias(
		ENV_EMPTY,
		"LocalHit",
		[],
		SemanticNamedType("G.Hit", []),
	)
	ctx = type_resolution_context(env, [("G", "geometry")])
	source: SemanticType = SemanticFunctionType(
		True,
		[SemanticNamedType("Local", []), SemanticNamedType("LocalHit", [])],
		SemanticNamedType(
			"Local",
			[],
		),
	)
	resolved: ResolvedType = function_parameter_annotation(ctx, source, qualify_local)
	expected: SemanticType = SemanticFunctionType(
		True,
		[SemanticNamedType("mod/a::Local", []), SemanticNamedType("geometry::Hit", [])],
		SemanticNamedType(
			"mod/a::Local",
			[],
		),
	)

	(
		types_equal(resolved_type_source(resolved), source)
		and types_equal(resolved_type_canonical(resolved), expected)
	)


func test_native_nominal_import_alias_and_record_field_identity() -> Bool:
	names: List[String] = ["IpAddress", "DnsName", "InterfaceScope"]
	names.all(func(name):
		env = env_add_alias(ENV_EMPTY, "SelectedNative", [], SemanticNamedType("Tcp." + name, []))
		ctx = type_resolution_context(env, [("Tcp", "net/tcp")])
		qualified: SemanticType = SemanticNamedType("net/tcp::" + name, [])
		source: SemanticType = SemanticNamedType("Option", [SemanticNamedType("SelectedNative", [])])
		expected: SemanticType = SemanticNamedType("Option", [qualified])
		field = record_field_type_canonical(ctx, source)
		(
			types_equal(imported_signature_canonical(ctx, source), expected)
			and types_equal(field, expected)
			and not types_equal(qualified, SemanticNamedType("consumer::" + name, []))
		)
	)


func test_nominal_dim_alias_and_alias_preservation() -> Bool:
	env: Env = env_add_alias(
		ENV_EMPTY,
		"FloatRow",
		["#N"],
		SemanticArrayType(TYPE_FLOAT, [SemanticTypeVar("#N", SemanticDimensionParameter)]),
	)
	expand_ctx = type_resolution_context(env, [])
	preserve_ctx = type_resolution_context_with_alias_policy(env, [], PreserveAliasSource)
	source: SemanticType = SemanticArrayType(
		SemanticNamedType("FloatRow", []),
		[SemanticConstIntType(8)],
	)
	expanded: SemanticType = record_field_type_canonical(expand_ctx, source)
	preserved: SemanticType = record_field_type_canonical(preserve_ctx, source)

	types_equal(
		expanded,
		SemanticArrayType(TYPE_FLOAT, [SemanticConstIntType(8)]),
	) and types_equal(
		preserved,
		SemanticNamedType("FloatRow", [SemanticConstIntType(8)]),
	)


func test_entrypoints_share_resolution_pipeline() -> Bool:
	env: Env = env_add_alias(
		ENV_EMPTY,
		"Row",
		["#N"],
		SemanticArrayType(TYPE_INT, [SemanticTypeVar("#N", SemanticDimensionParameter)]),
	)
	ctx = type_resolution_context(env, [("M", "pkg/math")])
	source: SemanticType = SemanticFunctionType(
		True,
		[SemanticArrayType(
				SemanticNamedType("Row", []),
				[SemanticConstIntType(4)],
			)],
		SemanticNamedType("M.Result", []),
	)
	expected: SemanticType = SemanticFunctionType(
		True,
		[SemanticArrayType(TYPE_INT, [SemanticConstIntType(4)])],
		SemanticNamedType("pkg/math::Result", []),
	)
	return_resolved = function_return_annotation(
		ctx,
		source,
		func(typ: SemanticType): typ,
	)

	(
		types_equal(resolved_type_source(return_resolved), source)
		and types_equal(resolved_type_canonical(return_resolved), expected)
	)


func test_nominal_dimensions_respect_each_authority_boundary() -> Bool:
	match range_record_test_authority():
		Err(_): False
		Ok(authority):
			view = module_view_with_accepted_record_authority(COMPILER_MODULE_VIEW_EMPTY, authority)
			obsolete_record_env = env_add_record(ENV_EMPTY, "Obsolete", ["#N"], [], False)
			env = env_add_alias(obsolete_record_env, "LegacyAlias", ["#N"], TYPE_INT)
			record_source = SemanticArrayType(SemanticNamedType("Obsolete", []), [SemanticConstIntType(3)])
			alias_source = SemanticArrayType(SemanticNamedType("LegacyAlias", []), [SemanticConstIntType(4)])
			(
				types_equal(resolve_nominal_dimension_applications(view, env, record_source), record_source)
				and types_equal(
					resolve_nominal_dimension_applications(view, env, alias_source),
					SemanticNamedType("LegacyAlias", [SemanticConstIntType(4)]),
				)
			)


tests: TestSuite = {
	description = "Compiler type resolution",
	tests = [
		("native nominal imports and record aliases keep identity", test_native_nominal_import_alias_and_record_field_identity),
		("nominal dimensions respect each authority boundary", test_nominal_dimensions_respect_each_authority_boundary),
		("resolves qualified names recursively", test_resolves_qualified_names_recursively),
		(
			"composes owner qualification and aliases",
			test_resolution_composes_owner_qualification_and_aliases,
		),
		("nominal dim alias and alias preservation", test_nominal_dim_alias_and_alias_preservation),
		("entrypoints share resolution pipeline", test_entrypoints_share_resolution_pipeline),
	]
}
