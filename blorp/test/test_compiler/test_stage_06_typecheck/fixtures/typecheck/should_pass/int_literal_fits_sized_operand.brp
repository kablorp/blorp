-- RUN-BLORP-CHECK
-- A literal operand takes the sized integer type of the other operand, on either side.
pure func step(value: Int8) -> Int8:
	value + 1


pure func reflect(value: Int8) -> Int8:
	0 - value


pure func scaled(value: UInt8) -> UInt8:
	value * 2 + 3


func main(args: List[String]) -> Int:
	var total: Int8 = 0
	total += 1
	total -= -1
	0
