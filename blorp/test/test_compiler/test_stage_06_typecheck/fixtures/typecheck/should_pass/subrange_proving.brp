-- Subrange proving: loop range derived from length(v) with arithmetic
-- Half iteration
pure func first_half[#N](v: Int[#N]) -> Int:
	var sum: Int = 0
	for i in 0..length(v) / 2:
		sum += v[i]
	sum


-- Concrete half
pure func first_half_concrete(v: Int[#10]) -> Int:
	var sum: Int = 0
	for i in 0..length(v) / 2:
		sum += v[i]
	sum


-- Subtracted range (already works for concrete, test generic)
pure func skip_last[#N](v: Int[#N]) -> Int:
	var sum: Int = 0
	for i in 0..length(v) - 2:
		sum += v[i]
	sum
