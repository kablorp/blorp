-- RUN-BLORP-CHECK
-- Or-patterns inspect constructors and literals without introducing bindings.
import:
	../helpers/constructor_visibility_mod as External


union MarkerType:
	Marker
	Other


pure func ignore_payloads(value: Result[Int, String]) -> Int:
	match value:
		Ok(_) | Err(_):
			1


pure func inspect_constructor_payloads(value: Result[MarkerType, MarkerType]) -> Int:
	match value:
		Ok(Marker) | Err(Other):
			1
		_:
			0


pure func inspect_literals(value: Int) -> Int:
	match value:
		0 | 1:
			1
		_:
			0


pure func inspect_nested_literals(value: Option[Int]) -> Int:
	match value:
		Some(0 | 1):
			1
		_:
			0


pure func ignore_list_spreads(value: List[Int]) -> Int:
	match value:
		[] | [_, ..._]:
			1


pure func bind_outside_alternatives(value: (Int, Int)) -> Int:
	match value:
		(item, 0 | 1):
			item
		_:
			0


pure func ignore_qualified_payloads(value: External.ExternalChoice) -> Int:
	match value:
		External.ExternalSome(_) | External.ExternalNone:
			1
