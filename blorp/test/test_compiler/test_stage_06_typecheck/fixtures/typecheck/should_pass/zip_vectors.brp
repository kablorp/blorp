-- zip iterates two vectors in lockstep
func sum_products(a: Float[#4], b: Float[#4]) -> Float:
	var total: Float = 0.0
	for (x, y) in a.zip(b):
		total += x * y
	total


func main(args: List[String]) -> Int:
	a: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	b: Float[#4] = {10.0, 20.0, 30.0, 40.0}
	to_int(sum_products(a, b))
