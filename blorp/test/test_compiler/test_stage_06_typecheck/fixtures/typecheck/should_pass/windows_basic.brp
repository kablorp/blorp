import:
	tensor: windows


-- windows: for w in windows(v, K): — w is a sized window view
-- Basic windows with proven subscripts
pure func window_sum(v: Int[#10]) -> Int:
	var sum: Int = 0
	for w in windows(v, 3):
		sum = sum + w[0] + w[1] + w[2]
	sum


-- Windows with Float type
pure func moving_avg(v: Float[#5]) -> Float:
	var total: Float = 0.0
	for w in windows(v, 2):
		total += (w[0] + w[1]) / 2.0
	total
