-- Iterating a 2D matrix yields row sub-tensors (dimension peeling)
import:
	tensor: matrix


func sum_rows(m: Float[#3, #4]) -> Float:
	var total: Float = 0.0
	for row in m:
		-- row should be Float[#4]
		for val in row:
			total += val
	total


func main(args: List[String]) -> Int:
	m: Float[#3, #4] = matrix(1.0, 3, 4)
	to_int(sum_rows(m))
