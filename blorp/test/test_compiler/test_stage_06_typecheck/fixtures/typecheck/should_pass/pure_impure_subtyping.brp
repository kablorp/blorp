import:
	list: filter, map


-- Pure callbacks should select the pure list HOF overloads in pure functions.
pure func double_all(nums: List[Int]) -> List[Int]:
	nums.map(pure func(x: Int): x * 2)


pure func positives(nums: List[Int]) -> List[Int]:
	nums.filter(pure func(x: Int): x > 0)


func main(args: List[String]) -> Int:
	0
