-- The native contract is an Int wire tag, independent of language storage.
fixed union Color:
	Red
	Blue


foreign:
	func consume_color(color: Int) -> Int


pure func color_wire_tag(color: Color) -> Int:
	-- Native consume_color uses Red = 0 and Blue = 1.
	match color:
		Red:
			0
		Blue:
			1


func consume_language_color(color: Color) -> Int:
	consume_color(color_wire_tag(color))


func main(args: List[String]) -> Int:
	0
