import:
	list as L
	result: Result(Ok, Err)


private pure func build_values(limit: Int) -> List[Int]:
	var values: List[Int] = L.list(limit)

	for value in 0..limit:
		values = values.append(value)

	values
		.set(1, 20)
		.concat([42])


private pure func build_lookup() -> Dict[String, Int]:
	var lookup: Dict[String, Int] = {}

	lookup = lookup.set("x", 1)
	lookup = lookup.set("x", 40)

	lookup.set(
		"y",
		lookup.get_or("missing", 2),
	)


VALUES: List[Int] = build_values(3)

VALUE_LENGTH: Int = VALUES.length()

VALUE_AT_ONE: Int = VALUES.get_or(1, 0)

VALUE_HAS_42: Bool = VALUES.contains(42)

VALUE_OPTION: Option[Int] = VALUES.get(1)

VALUE_MISSING: Option[Int] = VALUES.get(99)

VALUE_OPTION_SCORE: Int = match VALUE_OPTION:
	Some(value):
		value + 22
	None:
		0

VALUE_MISSING_SCORE: Int = match VALUE_MISSING:
	Some(value):
		value
	None:
		42

LOOKUP: Dict[String, Int] = build_lookup()

LOOKUP_LENGTH: Int = LOOKUP.length()

LOOKUP_X: Int = LOOKUP.get_or("x", 0)

LOOKUP_HAS_Y: Bool = LOOKUP.contains("y")

LOOKUP_OPTION: Option[Int] = LOOKUP.get("x")

LOOKUP_MISSING: Option[Int] = LOOKUP.get("missing")

LOOKUP_OPTION_SCORE: Int = match LOOKUP_OPTION:
	Some(value):
		value + 2
	None:
		0

LOOKUP_MISSING_SCORE: Int = match LOOKUP_MISSING:
	Some(value):
		value
	None:
		42

LOOKUP_RESULT: Result[Int, String] = LOOKUP_OPTION.to_result("missing")

LOOKUP_MISSING_RESULT: Result[Int, String] = LOOKUP_MISSING.to_result("missing")

LOOKUP_RESULT_SCORE: Int = match LOOKUP_RESULT:
	Ok(value):
		value + 2
	Err(_):
		0

LOOKUP_MISSING_TEXT: String = match LOOKUP_MISSING_RESULT:
	Ok(_):
		"bad"
	Err(value):
		value

LOOKUP_RESULT_OR: Int = LOOKUP_RESULT.get_or(0)

LOOKUP_MISSING_OR: Int = LOOKUP_MISSING_RESULT.get_or(42)

LOOKUP_RESULT_OK: Bool = LOOKUP_RESULT.is_ok()

LOOKUP_MISSING_ERR: Bool = LOOKUP_MISSING_RESULT.is_err()


func main(args: List[String]) -> Int:
	if (
		VALUE_LENGTH == 4
		and VALUE_AT_ONE == 20
		and VALUE_HAS_42
		and VALUE_OPTION_SCORE == 42
		and VALUE_MISSING_SCORE == 42
		and LOOKUP_LENGTH == 2
		and LOOKUP_X == 40
		and LOOKUP_HAS_Y
		and LOOKUP_OPTION_SCORE == 42
		and LOOKUP_MISSING_SCORE == 42
		and LOOKUP_RESULT_SCORE == 42
		and LOOKUP_MISSING_TEXT == "missing"
		and LOOKUP_RESULT_OR == 40
		and LOOKUP_MISSING_OR == 42
		and LOOKUP_RESULT_OK
		and LOOKUP_MISSING_ERR
	):
		0
	else:
		1
