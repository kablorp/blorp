import:
	exit as Exit: ExitStatus, ExitStatusAble


record CustomStatus {
	code: Int
}


implements ExitStatusAble for CustomStatus:
	pure func to_exit_status(value: CustomStatus) -> Exit.ExitStatus:
		{
			code = value.code,
			message = None
		}


func main(args: List[String]) -> CustomStatus:
	{code = 7}
