-- Step 5 / Option D regression: a user-declared trait with a default
-- body must compile without requiring [import: traits]. The default
-- body references a sibling method (`my_lt`) by bare name; the
-- default-body synthesizer rewrites this into UFCS form
-- (`b.my_lt(a)`), which dispatches through the impl's methods
-- registered as UFCS entries on the impl's for-type.
trait MyCompare:
	pure func my_lt(a: Self, b: Self) -> Bool
	pure func my_gt(a: Self, b: Self) -> Bool:
		my_lt(b, a)


record Weight {
	grams: Int
}


implements MyCompare for Weight:
	pure func my_lt(a: Weight, b: Weight) -> Bool:
		a.grams < b.grams


func main(args: List[String]) -> Int:
	0
