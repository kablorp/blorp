import:
	vector: ParallelVector, parallel


pure func add_pairs(left: Int[#3], right: Int[#3]) -> Int[#3]:
	left.parallel(pure func(chunk: ParallelVector[Int, #3]):
		chunk.zip_map(right, pure func(a: Int, b: Int) -> Int: a + b)
	)


func main(args: List[String]) -> Int:
	left: Int[#3] = {1, 2, 3}
	right: Int[#3] = {10, 20, 30}
	result: Int[#3] = add_pairs(left, right)
	result[0] + result[1] + result[2]
