-- RUN-BLORP-CHECK
-- An id module that builds records declared by a module importing its opaque
-- type back keeps one identity for that type. Each accepted authority must
-- return the cycle partner's declarations in the id module's own spelling.
import:
	../helpers/opaque_cycle_ids: bind, bound_number, collected_ids, make_name, name_number, renumber
	../helpers/opaque_cycle_syntax: Name, name_id


func main(args: List[String]) -> Int:
	name: Name = renumber(
		make_name(1, "x"),
		3,
	)
	ids = collected_ids([name, make_name(4, "y")])

	if (
		bound_number(bind(name)) == 3
		and ids.length() == 2
		and name_number(name_id(name)) == 3
	):
		0
	else:
		1
