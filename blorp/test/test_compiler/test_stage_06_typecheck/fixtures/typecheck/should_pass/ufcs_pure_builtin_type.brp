-- UFCS methods on builtin types should preserve purity
-- get() from list module is pure, should work in pure functions
import:
	list: List
	option: Option(Some, None)


pure func first_or_zero(items: List[Int]) -> Int:
	match items.get(0):
		Some(v): v
		None: 0


func main(args: List[String]) -> Int:
	0
