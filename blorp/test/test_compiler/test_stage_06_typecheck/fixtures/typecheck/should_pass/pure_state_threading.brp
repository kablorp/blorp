-- Test: Pure state threading pattern
-- State is passed explicitly instead of captured in closure
-- Pure: counter using union type for explicit state
union Counter:
	Count(Int)


-- Pure: advance counter and return new value
pure func advance_value(c: Counter) -> Int:
	match c:
		Count(n): n + 1


-- Pure: get current value
pure func current_value(c: Counter) -> Int:
	match c:
		Count(n): n


-- Pure: create new counter with incremented value
pure func next_counter(c: Counter) -> Counter:
	match c:
		Count(n): Count(n + 1)


-- Pure: composition of pure functions
pure func demo() -> Int:
	current_value(next_counter(next_counter(Count(0))))
