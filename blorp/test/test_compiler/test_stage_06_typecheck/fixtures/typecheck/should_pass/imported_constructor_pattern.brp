-- A selectively imported constructor keeps its meaning as a pattern.
import:
	../helpers/constructor_visibility_mod:
		ExternalChoice(ExternalSome, ExternalNone),
		default_choice,


func check() -> Int:
	match default_choice():
		ExternalSome(value):
			value
		ExternalNone:
			0


func main(args: List[String]) -> Int:
	check()
-- RUN-BLORP-CHECK
