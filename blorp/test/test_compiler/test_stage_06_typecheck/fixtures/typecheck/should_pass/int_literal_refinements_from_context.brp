-- RUN-BLORP-CHECK
-- An integer literal infers Int; refinements come from the type that checks it.
import:
	tensor: indices

func main(args: List[String]) -> Int:
	var count = 42
	count += 1
	immutable_count = 5
	refined: #42 = 42
	small: Int8 = 7
	v: Int[#3] = {1, 2, 3}
	second = v[2]
	var total = 0

	for i in 0..3:
		total += v[i]

	for i in indices(v):
		total += v[i]

	checked = checked_slice(v, 0, 2)
	modulo_index = v[7 % 3]
	total + count + immutable_count + refined + second + length(checked) + modulo_index
