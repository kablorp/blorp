-- Loop offset proving: v[i+k] and v[i-k] should be accepted when loop bounds
-- accommodate the offset and the tensor dimension allows it.
-- Pairwise difference: v[i+1] safe when loop ends at length-1
pure func pairwise_diff(v: Float[#10]) -> Float:
	var sum: Float = 0.0
	for i in 0..9:
		sum += v[i + 1] - v[i]
	sum


-- Backward difference: v[i-1] safe when loop starts at 1
pure func backward_diff(v: Float[#10]) -> Float:
	var sum: Float = 0.0
	for i in 1..10:
		sum += v[i] - v[i - 1]
	sum


-- 1D stencil: v[i-1], v[i], v[i+1] all safe in 1..length-1
pure func stencil_1d(v: Float[#10]) -> Float:
	var sum: Float = 0.0
	for i in 1..9:
		sum = sum + v[i - 1] + v[i] + v[i + 1]
	sum


-- Moving average with offset -2
pure func moving_avg(v: Float[#10]) -> Float:
	var sum: Float = 0.0
	for i in 2..10:
		sum += (v[i - 2] + v[i - 1] + v[i]) / 3.0
	sum
