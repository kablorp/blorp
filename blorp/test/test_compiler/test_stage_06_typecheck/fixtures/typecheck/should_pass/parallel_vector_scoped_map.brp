import:
	vector: ParallelVector, parallel


pure func double_all(values: Int[#4]) -> Int[#4]:
	values.parallel(pure func(chunk: ParallelVector[Int, #4]):
		chunk.map(pure func(x: Int) -> Int: x * 2)
	)


func main(args: List[String]) -> Int:
	values: Int[#4] = {1, 2, 3, 4}
	result: Int[#4] = double_all(values)
	result[0] + result[1] + result[2] + result[3]
