import:
	bytes as B
	pkg/compress as C


func main(args: List[String]) -> Int:
	data: Bytes = "compress me".to_bytes()
	match C.gzip(data):
		Ok(compressed):
			match C.gunzip(compressed):
				Ok(decompressed):
					if B.to_string(decompressed) == "compress me":
						0
					else:
						1
				Err(_): 1
		Err(_): 1
