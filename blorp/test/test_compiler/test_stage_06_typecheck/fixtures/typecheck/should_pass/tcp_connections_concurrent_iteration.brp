import:
	net/tcp as Tcp: IpFamily(IPv4), TcpError


func accepts_connections_concurrently() -> Result[Int, TcpError]:
	with listener ?= Tcp.listen_loopback_any_port(IPv4, 1):
		for conn in Tcp.connections_continue_on_error(listener) concurrently(limit: 1):
			_ = Tcp.stream_local_port(conn)
		Ok(0)
