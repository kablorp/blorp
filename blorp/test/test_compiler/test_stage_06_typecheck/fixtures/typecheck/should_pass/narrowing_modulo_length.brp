-- Test: for-loop index % length(v) should produce ..#N because
-- loop variables from for i in 0..N are proven >= 0 (TyRange).
-- This enables safe ring-buffer-style indexing.
func main(args: List[String]) -> Int:
	v: Int[#8] = {1, 2, 3, 4, 5, 6, 7, 8}
	w: Int[#3] = {10, 20, 30}
	var sum: Int = 0
	for i in 0..length(v):
		idx = i % length(w)
		sum += w[idx]
	sum
