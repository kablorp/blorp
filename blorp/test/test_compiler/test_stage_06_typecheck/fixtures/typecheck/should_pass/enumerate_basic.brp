import:
	tensor: enumerate


-- enumerate: for (i, val) in enumerate(v): — i is proven index, val is element
-- Basic enumerate with proven index
pure func sum_indexed(v: Int[#5]) -> Int:
	var sum: Int = 0
	for (i, val) in enumerate(v):
		sum = sum + v[i] + val
	sum


-- Enumerate with generic dimension
pure func first_nonzero[#N](v: Int[#N]) -> Int:
	var result: Int = -1
	for (i, val) in enumerate(v):
		if val != 0 and result == -1:
			result = i
	result
