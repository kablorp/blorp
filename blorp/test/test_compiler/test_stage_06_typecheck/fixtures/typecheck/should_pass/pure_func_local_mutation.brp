-- Pure functions CAN use local mutable state
pure func sum(nums: List[Int]) -> Int:
	var total: Int = 0
	for n in nums:
		total += n
	total


-- Pure functions CAN call other pure functions
pure func double(x: Int) -> Int:
	x + x


pure func quadruple(x: Int) -> Int:
	double(double(x))


func main(args: List[String]) -> Int:
	sum([1, 2, 3]) + quadruple(2)
