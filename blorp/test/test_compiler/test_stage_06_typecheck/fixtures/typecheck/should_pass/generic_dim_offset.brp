-- Loop offset proving with generic #N dimensions
-- Stencil with generic dim
pure func stencil[#N](v: Float[#N]) -> Float:
	var sum: Float = 0.0
	for i in 1..length(v) - 1:
		sum = sum + v[i - 1] + v[i] + v[i + 1]
	sum


-- Pairwise diff with generic dim
pure func pairwise[#N](v: Int[#N]) -> Int:
	var sum: Int = 0
	for i in 0..length(v) - 1:
		sum = sum + v[i + 1] - v[i]
	sum


-- Backward diff with generic dim
pure func backward[#N](v: Float[#N]) -> Float:
	var sum: Float = 0.0
	for i in 1..length(v):
		sum = sum + v[i] - v[i - 1]
	sum
