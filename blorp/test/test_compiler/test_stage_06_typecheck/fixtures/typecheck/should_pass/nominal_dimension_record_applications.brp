-- RUN-BLORP-CHECK
-- Direct literals and accepted headers must agree on nominal dimensions.
record Ordinary[#N] {size: Int}
fixed record Fixed[#N] {size: Int}
type alias FixedAlias[#N] = Fixed[#N]
union Window[#N]:
	Samples(Int[#N])
	Empty


func make_fixed[#N](values: Int[#N]) -> Fixed[#N]:
	{size = values.length()}


func main(args: List[String]) -> Int:
	ordinary: Ordinary[#3] = {size = 3}
	fixed_value: Fixed[#3] = {size = 3}
	alias_value: FixedAlias[#3] = {size = 3}
	values: Int[#3] = {1, 2, 3}
	from_header: Fixed[#3] = make_fixed(values)
	nested: Option[Fixed[#3]] = Some(fixed_value)
	window: Window[#3] = Samples(values)
	count = match window:
		Samples(samples): samples.length()
		Empty: 0
	nested_size = match nested:
		Some(value): value.size
		None: 0
	if ordinary.size == 3 and alias_value.size == 3 and from_header.size == 3 and nested_size == 3 and count == 3:
		0
	else:
		1
