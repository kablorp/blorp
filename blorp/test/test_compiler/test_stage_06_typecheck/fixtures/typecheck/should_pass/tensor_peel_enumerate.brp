-- enumerate on a 2D matrix yields (index, row) pairs
import:
	tensor: enumerate, matrix


func sum_indexed(m: Float[#3, #4]) -> Float:
	var total: Float = 0.0
	for (i, row) in enumerate(m):
		for val in row:
			total += val
	total


func main(args: List[String]) -> Int:
	m: Float[#3, #4] = matrix(1.0, 3, 4)
	to_int(sum_indexed(m))
