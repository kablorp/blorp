-- A module that owns a trait, a type implementing it and a private trait, so
-- importers can name the trait only through the module's alias.
trait Shape:
	pure func area(self: Self) -> Int


private trait Hidden:
	pure func secret(self: Self) -> Int


record Square {
	side: Int
}


implements Shape for Square:
	pure func area(self: Square) -> Int:
		self.side * self.side


pure func make_square(side: Int) -> Square:
	{side = side}
