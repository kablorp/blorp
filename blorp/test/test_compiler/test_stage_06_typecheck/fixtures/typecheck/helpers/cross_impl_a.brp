-- Helper A owns one nominal Show trait and its Int implementation.
trait Show:
	pure func show(self: Self) -> String


implements Show for Int:
	pure func show(self: Int) -> String:
		"A"


record AValue {
	value: Int
}


implements Show for AValue:
	pure func show(self: AValue) -> String:
		self.value.to_string()


pure func value() -> AValue:
	{value = 1}


pure func render[T:Show](item: T) -> String:
	show(item)
