-- Helper module that uses String methods via UFCS without importing them.
-- String is a prelude type — its methods should resolve via UFCS.
pure func find_equals(s: String) -> Option[Int]:
	s.index_of("=")


pure func get_prefix(s: String) -> String:
	s.substring(0, 3)


pure func has_dash(s: String) -> Bool:
	s.starts_with("-")


pure func strip(s: String) -> String:
	s.trim()
