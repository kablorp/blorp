-- Helper B owns a separate nominal Show trait and its Int implementation.
trait Show:
	pure func show(self: Self) -> String


implements Show for Int:
	pure func show(self: Int) -> String:
		"B"


record BValue {
	value: Int
}


implements Show for BValue:
	pure func show(self: BValue) -> String:
		self.value.to_string()


pure func value() -> BValue:
	{value = 2}


pure func render[T:Show](item: T) -> String:
	show(item)
