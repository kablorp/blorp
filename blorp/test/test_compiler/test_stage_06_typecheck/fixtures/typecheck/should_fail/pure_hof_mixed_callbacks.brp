-- EXPECT: error: Pure function 'bad' cannot call impure function 'side_effect'
-- ERROR: Impure HOF called from pure context with one impure callback
-- Tests all_func_args_pure checking ALL function args
func apply_both(x: Int, f: (Int) -> Int, g: (Int) -> Int) -> Int:
	f(x) + g(x)


func side_effect(x: Int) -> Int:
	print(x)
	x


pure func bad(x: Int) -> Int:
	apply_both(x, pure func(n: Int): n + 1, side_effect)
