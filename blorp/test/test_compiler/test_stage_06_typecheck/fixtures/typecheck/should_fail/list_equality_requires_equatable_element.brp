-- EXPECT: error: Equality requires an implementation of Equatable for List[Point] (List equality compares elements with ==; add 'implements Equatable for Point') at blorp/test/test_compiler/test_stage_06_typecheck/fixtures/typecheck/should_fail/list_equality_requires_equatable_element.brp:13:8
-- RUN-BLORP-CHECK
-- List equality compares elements with the element type's own ==, so a list
-- of records without an Equatable implementation must be rejected instead of
-- silently comparing by identity.
record Point {x: Int, y: Int}


func main(args: List[String]) -> Int:
	left: List[Point] = [{x = 1, y = 2}]
	right: List[Point] = [{x = 1, y = 2}]

	if left == right:
		1
	else:
		0
