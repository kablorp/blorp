-- EXPECT: error: Equality requires an implementation of Equatable for List[Point] (List equality compares elements with ==; `Point` is not Equatable because its field `scale: (Int) -> Int` is not Equatable) at blorp/test/test_compiler/test_stage_06_typecheck/fixtures/typecheck/should_fail/list_equality_requires_equatable_element.brp:13:8
-- RUN-BLORP-CHECK
-- List equality compares elements with the element type's own ==, so a list
-- of records that are not Equatable (a function field cannot be compared)
-- must be rejected instead of silently comparing by identity.
record Point {x: Int, scale: (Int) -> Int}


func main(args: List[String]) -> Int:
	left: List[Point] = [{x = 1, scale = func(value): value}]
	right: List[Point] = [{x = 1, scale = func(value): value}]

	if left == right:
		1
	else:
		0
