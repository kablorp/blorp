-- EXPECT: help: use wildcards to ignore payloads, or split the alternatives into separate match arms to bind them
import:
	../helpers/constructor_visibility_mod as External


-- A constructor of an unrelated type is a binder at these payload types.
-- The scrutinee type, rather than the spelling, determines whether it binds.
union MarkerType:
	Marker


pure func reject(value: Result[Int, String]) -> Int:
	match value:
		Ok(Marker) | Err(Marker):
			0


pure func reject_qualified(value: External.ExternalChoice) -> Int:
	match value:
		External.ExternalSome(item) | External.ExternalNone:
			0


-- A local parameter shadows the constructor, so each alternative binds it.
pure func reject_shadowed_constructor(Marker: Int, value: MarkerType) -> Int:
	match value:
		Marker | Marker:
			0
