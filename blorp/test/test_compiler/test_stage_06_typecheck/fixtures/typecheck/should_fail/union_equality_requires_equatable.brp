-- EXPECT: error: Equality requires an implementation of Equatable for Shape at blorp/test/test_compiler/test_stage_06_typecheck/fixtures/typecheck/should_fail/union_equality_requires_equatable.brp:11:8
-- RUN-BLORP-CHECK
-- A union with payloads has no compiler-provided equality: comparing its
-- payloads is the implementer's decision, so `==` needs an explicit impl.
union Shape:
	Circle(Int)
	Named(String)


func main(args: List[String]) -> Int:
	if Named("a") == Named("a"):
		1
	else:
		0
