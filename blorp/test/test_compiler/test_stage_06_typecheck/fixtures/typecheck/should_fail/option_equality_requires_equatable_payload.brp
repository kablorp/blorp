-- EXPECT: error: Equality requires an implementation of Equatable for Option[Point] (Option equality compares payloads with ==; `Point` is not Equatable because its field `scale: (Int) -> Int` is not Equatable) at blorp/test/test_compiler/test_stage_06_typecheck/fixtures/typecheck/should_fail/option_equality_requires_equatable_payload.brp:13:8
-- RUN-BLORP-CHECK
-- Option equality compares payloads with the payload type's own ==, so an
-- Option of a record that is not Equatable (its function field cannot be
-- compared) must be rejected at typecheck rather than failing later in Core.
record Point {x: Int, scale: (Int) -> Int}


func main(args: List[String]) -> Int:
	left: Option[Point] = Some({x = 1, scale = func(value): value})
	right: Option[Point] = Some({x = 1, scale = func(value): value})

	if left == right:
		1
	else:
		0
