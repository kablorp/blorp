-- EXPECT: error: Integer literal 300 does not fit in UInt8
-- EXPECT: help: UInt8 holds 0 to 255; use a value in that range or a wider type such as UInt16
-- RUN-BLORP-CHECK
-- A literal pattern the scrutinee can never hold is reported instead of becoming a dead arm.
pure func describe(byte: UInt8) -> String:
	match byte:
		300:
			"never"
		_:
			"other"


func main(args: List[String]) -> Int:
	0
