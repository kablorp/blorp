-- EXPECT: error: impl Orderable for Weight: supertrait 'Equatable' is not implemented
-- RUN-BLORP-CHECK
-- Orderable: Equatable — implementing Orderable without Equatable should
-- fail, matching Rust/Haskell/Swift convention (mathematically: total
-- ordering defines equality via antisymmetry). The function field keeps
-- Weight from deriving Equatable from its fields.
import:
	traits: Orderable


record Weight {grams: Int, convert: (Int) -> Int}


implements Orderable for Weight:
	pure func less_than(a: Weight, b: Weight) -> Bool:
		a.grams < b.grams


func main(args: List[String]) -> Int:
	0
