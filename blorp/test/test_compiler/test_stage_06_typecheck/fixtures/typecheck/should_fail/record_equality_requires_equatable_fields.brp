-- EXPECT: error: `Holder` is not Equatable because its field `callback: (Int) -> Int` is not Equatable at blorp/test/test_compiler/test_stage_06_typecheck/fixtures/typecheck/should_fail/record_equality_requires_equatable_fields.brp:16:8
-- EXPECT: help: a record is Equatable when all its fields are; write `implements Equatable for Holder` to define its equality yourself
-- RUN-BLORP-CHECK
-- A record with no written Equatable implementation derives one only when
-- every field type is Equatable. A function cannot be compared, so `==` on
-- Holder is rejected, and the error names the field that stops derivation.
record Holder {
	label: String,
	callback: (Int) -> Int
}


func main(args: List[String]) -> Int:
	left: Holder = {label = "a", callback = func(value): value}

	if left == left:
		1
	else:
		0
