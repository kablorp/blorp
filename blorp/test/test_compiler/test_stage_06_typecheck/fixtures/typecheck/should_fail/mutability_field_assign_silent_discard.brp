-- EXPECT: error: field assignment is not supported
-- EXPECT: help: use record update syntax: { record | field = value }
-- RUN-BLORP-CHECK
-- Test: Field assignment on record should error, not silently discard
record Point {x: Int, y: Int}

func main(args: List[String]) -> Int:
    p: Point = {x = 1, y = 2}
    p.x = 99
    0
