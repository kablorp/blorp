-- EXPECT-CONTAINS: Subscript index must be a compile-time integer literal. Use get() for runtime-checked access
-- RUN-BLORP-CHECK
-- A binding initialized from a literal is an ordinary Int, so it proves nothing about bounds.
func main(args: List[String]) -> Int:
	v: Int[#3] = {1, 2, 3}
	i = 2
	chosen = v[i]
	chosen
