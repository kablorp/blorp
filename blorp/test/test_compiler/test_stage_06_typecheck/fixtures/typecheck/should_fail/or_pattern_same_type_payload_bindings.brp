-- EXPECT: help: use wildcards to ignore payloads, or split the alternatives into separate match arms to bind them
-- RUN-BLORP-CHECK
-- Equal payload types do not make bindings inside an or-pattern valid.
union Entry:
	Wide(Int, Int, String)
	Narrow(String)


pure func reject_same_type(value: Result[Int, Int]) -> Int:
	match value:
		Ok(item) | Err(item):
			0


pure func reject_different_positions(entry: Entry) -> Int:
	match entry:
		Wide(_, _, label) | Narrow(label):
			0


pure func reject_later_binding(value: Int) -> Int:
	match value:
		0 | item:
			0


pure func reject_same_type_spread(value: List[Int]) -> Int:
	match value:
		[_, ...tail] | [_, _, ...tail]:
			0
		_:
			0
