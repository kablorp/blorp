-- EXPECT: error: Function 'bad' return type cannot contain a one-shot stream type
import:
	net/tcp as Tcp: IpFamily(IPv4), TcpError
	stream: FallibleStream


func bad(port: Int) -> Result[FallibleStream[Bytes, TcpError], TcpError]:
	remote ?= Tcp.port(port)
	with stream ?= Tcp.connect_loopback(IPv4, remote):
		Ok(Tcp.chunks(stream, 64))
