-- EXPECT: error: Subscript index must be a compile-time constant or a loop variable proven in-bounds (e.g., for i in 0..length(v): v[i]). Use get() for runtime-checked access
-- Only lower bound in and-chain, no upper — should NOT narrow
pure func bad(v: Int[#10], i: Int) -> Bool:
	if i >= 0 and v[i] > 5:
		True
	else:
		False
