-- EXPECT: error: Type parameter T requires trait bound Equatable to call equals
-- BUG: equals(x, y) on type param T without Equatable bound should be rejected
-- equals is registered as a trait function for Equatable
func check_eq[T](x: T, y: T) -> Bool:
	equals(x, y)


func main(args: List[String]) -> Int:
	match check_eq(1, 2):
		True: 1
		False: 0
