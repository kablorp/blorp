-- EXPECT: error: Type parameter T does not have bound Equatable (required by equals)
-- RUN-BLORP-CHECK
-- `equals` is the Equatable trait method, so like `==` it needs the bound.
func check_eq[T](x: T, y: T) -> Bool:
	equals(x, y)


func main(args: List[String]) -> Int:
	match check_eq(1, 2):
		True: 1
		False: 0
