-- EXPECT: error: Variable 'x' is already declared in this scope. Use 'var' and reassignment instead of re-declaring
-- Concurrent result bindings are declared in the enclosing scope after join,
-- so they must obey the same redeclaration rules as ordinary bindings.
func main(args: List[String]) -> Int:
	x = 1
	concurrent:
		x = 2
	0
