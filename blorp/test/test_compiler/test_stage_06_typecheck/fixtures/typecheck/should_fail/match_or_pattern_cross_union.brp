-- EXPECT: error: Constructor Some (from option) belongs to type Option (from option), not Color
-- EXPECT: error: Constructor Some (from option) belongs to type Option (from option), not Color
-- Or-pattern mixing constructors from different union types
import:
	option: Option(Some, None)


union Color:
	Red
	Green
	Blue


func check(c: Color) -> Int:
	match c:
		Red | Some(1):
			1
		_:
			0
