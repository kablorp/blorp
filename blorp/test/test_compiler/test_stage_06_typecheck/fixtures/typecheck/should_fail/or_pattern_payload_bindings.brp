-- EXPECT: error: Or-pattern alternatives cannot bind variables at blorp/test/test_compiler/test_stage_06_typecheck/fixtures/typecheck/should_fail/or_pattern_payload_bindings.brp:38:9
-- EXPECT: help: use wildcards to ignore payloads, or split the alternatives into separate match arms to bind them
-- RUN-BLORP-CHECK
-- An or-pattern binds one name to payloads of different types. Each
-- alternative stores its payload at its own field positions, so the arm body
-- cannot read `item` through one layout. Bindings require separate arms.
record Small {
	body: String
}


record Large {
	flag: Int,
	extra: Int,
	body: String
}


union Shape:
	ShapeSmall(Small)
	ShapeLarge(Large)


union Outcome:
	Good(Int)
	Bad(String)


pure func body_of(shape: Shape) -> String:
	match shape:
		ShapeSmall(item) | ShapeLarge(item):
			item.body


pure func describe(outcome: Outcome) -> String:
	match outcome:
		Good(value) | Bad(value):
			"{value}"
