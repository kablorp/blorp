-- EXPECT: help: use wildcards to ignore payloads, or split the alternatives into separate match arms to bind them
-- RUN-BLORP-CHECK
-- Bindings nested in container patterns and list spreads are also forbidden.
pure func reject_lists(value: Result[List[Int], List[String]]) -> Int:
	match value:
		Ok(items) | Err(items):
			0


pure func reject_spreads(value: Result[List[Int], List[String]]) -> Int:
	match value:
		Ok([_, ...tail]) | Err([_, ...tail]):
			0
		_:
			0


pure func reject_nested(value: Result[(Int, List[Int]), (Int, List[String])]) -> Int:
	match value:
		Ok(nested) | Err(nested):
			0


pure func reject_generics[T, U](value: Result[T, U]) -> Int:
	match value:
		Ok(generic) | Err(generic):
			0


pure func reject_inner_binding(value: Option[Int]) -> Int:
	match value:
		Some(0 | item):
			0
		None:
			0


pure func reject_tuple_fields(value: (Int, Int)) -> Int:
	match value:
		(item, _) | (_, item):
			0


pure func reject_list_elements(value: List[Int]) -> Int:
	match value:
		[item] | [item, _]:
			0
		_:
			0
