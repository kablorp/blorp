-- EXPECT: error: String pattern requires String scrutinee, got Int
-- RUN-BLORP-CHECK
-- String literal inside Option[Int] nested pattern
import:
	option: Option(Some, None)


union Wrapper:
	Wrap(Option[Int])


func check(w: Wrapper) -> Int:
	match w:
		Wrap(Some("hello")): 1
		Wrap(None): 2
		_: 0
