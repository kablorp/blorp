-- EXPECT: error: `Outer` is not Equatable because its field `inner: Holder` is not Equatable at blorp/test/test_compiler/test_stage_06_typecheck/fixtures/typecheck/should_fail/nested_record_equality_names_field.brp:20:8
-- EXPECT: help: a record is Equatable when all its fields are; write `implements Equatable for Outer` to define its equality yourself
-- RUN-BLORP-CHECK
-- A record whose field is a record that cannot derive equality cannot derive
-- it either; the error names the outer record's own field.
record Holder {
	callback: (Int) -> Int
}


record Outer {
	id: Int,
	inner: Holder
}


func main(args: List[String]) -> Int:
	left: Outer = {id = 1, inner = {callback = func(value): value}}

	if left == left:
		1
	else:
		0
