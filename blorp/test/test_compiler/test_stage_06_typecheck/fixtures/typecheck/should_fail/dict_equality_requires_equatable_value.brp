-- EXPECT: error: Equality requires an implementation of Equatable for Dict[Int, Point] (Dict equality compares values with ==; add 'implements Equatable for Point') at blorp/test/test_compiler/test_stage_06_typecheck/fixtures/typecheck/should_fail/dict_equality_requires_equatable_value.brp:13:8
-- RUN-BLORP-CHECK
-- Dict equality compares values with the value type's own ==, so a dict of
-- records without an Equatable implementation must be rejected instead of
-- silently comparing the stored values by identity.
record Point {x: Int, y: Int}


func main(args: List[String]) -> Int:
	left: Dict[Int, Point] = {1 => {x = 1, y = 2}}
	right: Dict[Int, Point] = {1 => {x = 1, y = 2}}

	if left == right:
		1
	else:
		0
