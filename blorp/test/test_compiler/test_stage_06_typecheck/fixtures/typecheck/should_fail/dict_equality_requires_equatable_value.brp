-- EXPECT: error: Equality requires an implementation of Equatable for Dict[Int, Point] (Dict equality compares values with ==; `Point` is not Equatable because its field `scale: (Int) -> Int` is not Equatable) at blorp/test/test_compiler/test_stage_06_typecheck/fixtures/typecheck/should_fail/dict_equality_requires_equatable_value.brp:13:8
-- RUN-BLORP-CHECK
-- Dict equality compares values with the value type's own ==, so a dict of
-- records that are not Equatable (a function field cannot be compared) must
-- be rejected instead of silently comparing the stored values by identity.
record Point {x: Int, scale: (Int) -> Int}


func main(args: List[String]) -> Int:
	left: Dict[Int, Point] = {1 => {x = 1, scale = func(value): value}}
	right: Dict[Int, Point] = {1 => {x = 1, scale = func(value): value}}

	if left == right:
		1
	else:
		0
