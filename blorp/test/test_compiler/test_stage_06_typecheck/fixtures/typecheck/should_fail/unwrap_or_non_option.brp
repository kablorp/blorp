-- EXPECT: error: Function 'get_or' expects 2 arguments, got 1
-- RUN-BLORP-CHECK
-- Calling get_or on a non-Option value via UFCS after ?= must be rejected.
-- nl is List[String] (extracted by ?=), not Option[T].
import:
	list: List, append, set_index
	option: Option(Some, None), get_or


func test() -> Option[List[String]]:
	lst: List[String] = [""]
	nl ?= lst.set_index(0, "x")
	nl.get_or(lst)
