-- EXPECT: error: impl Hashable for Widget: supertrait 'Equatable' is not implemented
-- RUN-BLORP-CHECK
-- Implementing Hashable on a record that is not Equatable must be rejected.
-- Matches Rust/Swift: the contract `a == b ⇒ hash(a) == hash(b)` is
-- meaningless if the type has no equality to check. The function field keeps
-- Widget from deriving Equatable from its fields.
record Widget {id: Int, on_change: (Int) -> Int}


implements Hashable for Widget:
	pure func hash(self: Widget) -> Int:
		self.id


func main(args: List[String]) -> Int:
	0
