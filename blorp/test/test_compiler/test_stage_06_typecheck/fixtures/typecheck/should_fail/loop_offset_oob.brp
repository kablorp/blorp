-- EXPECT: error: Loop offset i + 1: index range [1, 10] exceeds dimension of size 10. Adjust loop bounds to ensure all accesses are in [0, 10)
-- Loop offset out of bounds: v[i+1] in for i in 0..length(v) overflows at i=9
pure func bad_offset(v: Float[#10]) -> Float:
	var sum: Float = 0.0
	for i in 0..10:
		sum += v[i + 1]
	sum
