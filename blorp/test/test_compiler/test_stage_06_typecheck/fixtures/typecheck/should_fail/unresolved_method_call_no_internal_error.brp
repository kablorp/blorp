-- EXPECT: error: Cannot access field on type Int. Field access is supported on record fields. Use tuple[index] for tuple elements
-- EXPECT: error: Cannot call non-function type: Void
-- EXPECT: error: Function 'g' returns wrong type
-- EXPECT-NOT-CONTAINS: internal typecheck error
-- RUN-BLORP-CHECK
-- A misspelled method name is an ordinary user error. Error recovery leaves the
-- call without resolved-call metadata, and the typed-body coherence audit must
-- not report that recovery as an internal compiler error.
pure func g(x: Int) -> Int:
	x.no_such_method()


func main(args: List[String]):
	print("${g(1)}")
