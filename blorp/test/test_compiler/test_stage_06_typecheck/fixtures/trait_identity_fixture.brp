-- Trait identities for hand-built environments in tests.
--
-- A test that installs `trait_def(...)` and `impl_instance(...)` by name needs
-- the `TraitId` production takes from the registry or the header graph. A
-- builtin name gets its registry id; any other name gets a graph id derived from
-- the name alone, so the trait and every impl of it built in one test agree.
import:
	../../../../src/compiler/stage_04_modules/module_table: module_id_from_serialized_index
	../../../../src/compiler/stage_06_typecheck/headers/declaration_skeleton:
		builtin_trait_id,
		trait_id_definition_id,
	../../../../src/compiler/stage_06_typecheck/type_system/generic_params:
		BoundTraitIdentity,
		BoundTraitOwner(CompilerBuiltinBoundTraitOwner, GraphBoundTraitOwner),
		BoundTypeParam,
		make_resolved_bound_type_param,
	../../../../src/compiler/stage_06_typecheck/type_system/trait_identity:
		TRAIT_ID_STRINGABLE,
		TraitId,
		graph_trait_id,
		trait_id_is_compiler_builtin,
		trait_ids_equal,
	../../../../src/lib/source: SourceLocation, source_file, source_location_for_file, source_start


private FIXTURE_TRAIT_ID_BASE: Int = 1000000

private FIXTURE_TRAIT_ID_SPAN: Int = 1099511627776

private FIXTURE_TRAIT_ID_MULTIPLIER: Int = 131


private pure func fixture_name_hash(name: String) -> Int:
	var hash: Int = 7

	for ch in name:
		hash = (hash * FIXTURE_TRAIT_ID_MULTIPLIER + ch.to_int()) % FIXTURE_TRAIT_ID_SPAN

	hash


---
The `TraitId` a fixture gives the trait spelled `name`.
---
pure func test_trait_id(name: String) -> TraitId:
	match builtin_trait_id(name):
		Some(id):
			id
		None:
			-- The id is at least FIXTURE_TRAIT_ID_BASE, so `graph_trait_id` accepts it.
			graph_trait_id(FIXTURE_TRAIT_ID_BASE + fixture_name_hash(name)).get_or(TRAIT_ID_STRINGABLE)


private pure func fixture_trait_source_location() -> SourceLocation:
	source = source_file("fixture_traits.brp", "fixture_traits", "trait Fixture:\n\tpure func value()")
	start = source_start(source)
	source_location_for_file(source, start, start)


---
Whether two identity lists name the same traits in the same order. A loop rather
than `all` with a nested lambda: a lambda capturing the outer lambda's variable
miscompiles today (filed as "Fix nested lambda capturing a pipeline source
variable").
---
pure func test_trait_ids_equal(left: List[TraitId], right: List[TraitId]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var same: Bool = True
		var index: Int = 0

		for id in left:
			if not trait_ids_equal(id, right.get_or(index, TRAIT_ID_STRINGABLE)):
				same = False

			index += 1

		same


---
The exact identity a fixture gives the bound trait spelled `name`: builtin
names are compiler builtins, any other name is owned by the fixture module.
---
pure func test_bound_trait_identity(name: String) -> BoundTraitIdentity:
	id = test_trait_id(name)
	owner = if trait_id_is_compiler_builtin(id):
		CompilerBuiltinBoundTraitOwner
	else:
		GraphBoundTraitOwner(module_id_from_serialized_index(0))

	{
		trait_id = id,
		owner = owner,
		definition_id = trait_id_definition_id(id),
		name = name,
		span = fixture_trait_source_location()
	}


---
A type parameter bounded by the traits spelled in `trait_names`, each with its
fixture identity.
---
pure func test_bound_type_param(name: String, trait_names: List[String]) -> BoundTypeParam:
	make_resolved_bound_type_param(name, trait_names.map(test_bound_trait_identity))
