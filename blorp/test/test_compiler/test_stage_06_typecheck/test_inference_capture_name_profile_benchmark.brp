import:
	../../../benchmark/compiler/compiler_inference_capture_name_profile_fixture:
		inference_capture_name_profile_execute,
		inference_capture_name_profile_fixture,
		inference_capture_name_profile_observe,
	test: TestSuite


private func test_capture_profile_reports_qualifying_names() -> Bool:
	fixture = inference_capture_name_profile_fixture({
		iterations = 1,
		capture_width = 4,
		qualifying_percent = 50,
	})
	result = inference_capture_name_profile_observe(
		fixture,
		inference_capture_name_profile_execute(fixture, 1),
	)

	(
		result.error_count == 1
		and result.qualifying_name_count == 2
		and result.workload_valid
	)


private func test_capture_profile_accepts_empty_qualifying_set() -> Bool:
	fixture = inference_capture_name_profile_fixture({
		iterations = 1,
		capture_width = 3,
		qualifying_percent = 0,
	})
	result = inference_capture_name_profile_observe(
		fixture,
		inference_capture_name_profile_execute(fixture, 1),
	)

	(
		result.error_count == 0
		and result.qualifying_name_count == 0
		and result.redundant_comparison_opportunities == 0
		and result.workload_valid
	)


tests: TestSuite = {
	description = "Compiler inference capture-name profile benchmark",
	tests = [
		("reports qualifying names", test_capture_profile_reports_qualifying_names),
		("accepts empty qualifying set", test_capture_profile_accepts_empty_qualifying_set),
	]
}
