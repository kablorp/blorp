-- Concrete native-process rows shared by adapter and plan contract fixtures.
import:
	../../src/compiler/stage_09_core/ir:
		CoreProgram,
		CoreTupleStorageCatalog,
		CoreType(NamedType, TupleType),
		intern_tuple_storage_rows,
		synthetic_core_source_loc,
		tuple_storage_type


private pure func named(name: String) -> CoreType:
	NamedType(name, [])


pure func native_process_product_fixture() -> Option[(CoreTupleStorageCatalog, CoreType, CoreType)]:
	strings = NamedType("List", [named("String")])
	cwd: List[CoreType] = [named("String"), named("Bool")]
	environment: List[CoreType] = [strings, strings, strings]
	input: List[CoreType] = [named("Bytes"), NamedType("List", [named("Bytes")])]
	streams: List[CoreType] = [named("Int"), TupleType(input), named("Int"), named("Int")]
	lifetime: List[CoreType] = [named("Bool"), named("Int"), named("Int"), named("Int")]
	outer: List[CoreType] = [TupleType(cwd), TupleType(environment), TupleType(streams), TupleType(lifetime)]
	loc = synthetic_core_source_loc()
	program: CoreProgram = { decls = [], foreign_includes = [], source_files = [] }
	session: List[CoreType] = [named("String"), strings, TupleType(outer)]
	match intern_tuple_storage_rows(program, [(outer, loc), (cwd, loc), (environment, loc), (input, loc), (streams, loc), (lifetime, loc), (session, loc)]):
		Ok(catalog):
			match tuple_storage_type(catalog, TupleType(outer)):
				Ok(typ):
					match tuple_storage_type(catalog, TupleType(session)):
						Ok(request_type):
							Some((catalog, typ, request_type))
						Err(_):
							None
				Err(_):
					None
		Err(_):
			None
