-- Phase-local evaluators still need a legitimate standard provider domain.
import:
	../test_support_range_record: range_record_test_authority
	../../../src/compiler/stage_06_typecheck/graph/range_record: ResolvedRangeFields
	../../../src/compiler/stage_06_typecheck/graph/type_identity: type_id_module_id
	../../../src/compiler/stage_06_typecheck/type_system/accepted_record_authority:
		accepted_record_authority_definition_table, accepted_record_range_fields
	../../../src/compiler/stage_07_ctfe/context: CtfeContext, ctfe_context_empty


pure func ctfe_range_test_context() -> Option[(CtfeContext, ResolvedRangeFields)]:
	authority ?= range_record_test_authority().to_option()
	fields ?= accepted_record_range_fields(authority)
	definitions = accepted_record_authority_definition_table(authority)
	module_id ?= type_id_module_id(definitions, fields.record_id)
	Some(({ ctfe_context_empty(definitions, module_id) | range_fields = Some(fields) }, fields))
