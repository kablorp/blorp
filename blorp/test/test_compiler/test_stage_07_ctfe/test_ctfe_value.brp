import:
	../../../src/compiler/stage_06_typecheck/graph/definition_index: MISSING_RESOLVED_FIELD_IDENTITY
	../../../src/compiler/stage_03_parse/parsed_ast:
		ParsedBinaryOp(
			ParsedAddOp,
			ParsedDivideOp,
			ParsedEqualOp,
			ParsedGreaterEqualOp,
			ParsedGreaterOp,
			ParsedLessOp,
			ParsedModuloOp,
			ParsedNotEqualOp,
		),
		ParsedUnaryOp(ParsedNegateOp, ParsedNotOp),
	../../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticType(SemanticNamedType, SemanticTupleType),
		TYPE_INT,
		type_list,
	../../../src/compiler/stage_07_ctfe/value:
		CtfeConstructorPayload,
		CtfeError(CtfeExpectedValue, CtfeUnsupported),
		CtfeValue,
		CtfeValueDesc(
			CtfeBoolValue,
			CtfeConstructorValue,
			CtfeDictValue,
			CtfeFloatValue,
			CtfeListValue,
			CtfeRecordValue,
			CtfeStringValue,
			CtfeTupleValue,
		),
		ctfe_bool,
		ctfe_constructor_info,
		ctfe_error_message,
		ctfe_eval_binary,
		ctfe_eval_unary,
		ctfe_float,
		ctfe_int,
		ctfe_int_literal,
		ctfe_int_literal_bits,
		ctfe_int_value_text,
		ctfe_string,
		ctfe_value,
		ctfe_values_equal,
	../../../src/lib/source:
		Cursor,
		SourceFile,
		SourceLocation,
		source_cursor_at,
		source_file,
		source_location_for_file,
	test: TestSuite


pure func fixture_source_file() -> SourceFile:
	source_file("value.brp", "value", "func main(): 0")


pure func fixture_source_span() -> SourceLocation:
	src: SourceFile = fixture_source_file()
	cursor: Cursor = source_cursor_at(src, 0)
	source_location_for_file(src, cursor, cursor)


pure func int_value(value: Int) -> CtfeValue:
	ctfe_int(fixture_source_span(), value)


pure func float_value(value: Float) -> CtfeValue:
	ctfe_float(fixture_source_span(), value)


pure func sized_float_value(type_name: String, value: Float) -> CtfeValue:
	ctfe_value(
		SemanticNamedType(type_name, []),
		CtfeFloatValue(value),
		fixture_source_span(),
	)


pure func string_value(value: String) -> CtfeValue:
	ctfe_string(fixture_source_span(), value)


pure func bool_value(value: Bool) -> CtfeValue:
	ctfe_bool(fixture_source_span(), value)


pure func result_value_equal(result: Result[CtfeValue, CtfeError], expected: CtfeValue) -> Bool:
	match result:
		Ok(value):
			ctfe_values_equal(value, expected)
		Err(_):
			False


pure func result_is_unsupported(
	result: Result[CtfeValue, CtfeError],
	expected_form: String,
) -> Bool:
	match result:
		Err(CtfeUnsupported(form)):
			form == expected_form
		_:
			False


pure func result_is_expected_value_error(
	result: Result[CtfeValue, CtfeError],
	expected_type: String,
	actual_type: String,
) -> Bool:
	match result:
		Err(CtfeExpectedValue(expected, actual)):
			expected == expected_type and actual == actual_type
		_:
			False


pure func tuple_value(values: List[CtfeValue]) -> CtfeValue:
	ctfe_value(SemanticTupleType(values.map(
			func(value: CtfeValue): value.typ,
		)), CtfeTupleValue(values), fixture_source_span())


pure func list_value(values: List[CtfeValue]) -> CtfeValue:
	ctfe_value(type_list(TYPE_INT), CtfeListValue(values), fixture_source_span())


func test_value_equality_is_structural() -> Bool:
	left = tuple_value([
		int_value(1),
		list_value([int_value(2), int_value(3)]),
		ctfe_value(
			SemanticNamedType("Point", []),
			CtfeRecordValue([("x", int_value(4), MISSING_RESOLVED_FIELD_IDENTITY), ("y", int_value(5), MISSING_RESOLVED_FIELD_IDENTITY)]),
			fixture_source_span(),
		),
	])
	right = tuple_value([
		int_value(1),
		list_value([int_value(2), int_value(3)]),
		ctfe_value(
			SemanticNamedType("Point", []),
			CtfeRecordValue([("x", int_value(4), MISSING_RESOLVED_FIELD_IDENTITY), ("y", int_value(5), MISSING_RESOLVED_FIELD_IDENTITY)]),
			fixture_source_span(),
		),
	])
	different = tuple_value([
		int_value(1),
		list_value([int_value(2), int_value(99)]),
		ctfe_value(
			SemanticNamedType("Point", []),
			CtfeRecordValue([("x", int_value(4), MISSING_RESOLVED_FIELD_IDENTITY), ("y", int_value(5), MISSING_RESOLVED_FIELD_IDENTITY)]),
			fixture_source_span(),
		),
	])

	ctfe_values_equal(left, right) and not ctfe_values_equal(left, different)


func test_constructor_and_dict_equality_are_structural() -> Bool:
	info = ctfe_constructor_info("Option", 1)
	left_ctor: CtfeConstructorPayload = {
		name = "Some",
		args = [int_value(42)],
		constructor_info = info
	}
	right_ctor: CtfeConstructorPayload = {
		name = "Some",
		args = [int_value(42)],
		constructor_info = info
	}
	left = ctfe_value(
		SemanticNamedType("Option", [TYPE_INT]),
		CtfeDictValue([(string_value("answer"), ctfe_value(
						SemanticNamedType("Option", [TYPE_INT]),
						CtfeConstructorValue(left_ctor),
						fixture_source_span(),
					))]),
		fixture_source_span(),
	)
	right = ctfe_value(
		SemanticNamedType("Option", [TYPE_INT]),
		CtfeDictValue([(string_value("answer"), ctfe_value(
						SemanticNamedType("Option", [TYPE_INT]),
						CtfeConstructorValue(right_ctor),
						fixture_source_span(),
					))]),
		fixture_source_span(),
	)

	ctfe_values_equal(left, right)


func test_int_binary_ops_match_language_infallibility() -> Bool:
	div_zero = ctfe_eval_binary(ParsedDivideOp, int_value(9), int_value(0))
	mod_zero = ctfe_eval_binary(ParsedModuloOp, int_value(9), int_value(0))
	add = ctfe_eval_binary(ParsedAddOp, int_value(40), int_value(2))

	(
		result_value_equal(div_zero, int_value(0))
		and result_value_equal(mod_zero, int_value(0))
		and result_value_equal(add, int_value(42))
	)


func test_comparisons_return_bool_values() -> Bool:
	greater = ctfe_eval_binary(ParsedGreaterOp, int_value(5), int_value(3))
	equal = ctfe_eval_binary(ParsedEqualOp, string_value("a"), string_value("a"))
	not_equal = ctfe_eval_binary(ParsedNotEqualOp, string_value("a"), string_value("b"))

	(
		result_value_equal(greater, bool_value(True))
		and result_value_equal(equal, bool_value(True))
		and result_value_equal(not_equal, bool_value(True))
	)


func test_float_binary_ops_and_errors() -> Bool:
	sum = ctfe_eval_binary(ParsedAddOp, float_value(1.5), float_value(2.25))
	modulo = ctfe_eval_binary(ParsedModuloOp, float_value(4.0), float_value(2.0))

	result_value_equal(sum, float_value(3.75)) and result_is_unsupported(modulo, "Float modulo")


func test_float32_arithmetic_rounds_each_result() -> Bool:
	result = ctfe_eval_binary(
		ParsedAddOp,
		sized_float_value("Float32", 16777216.0),
		sized_float_value("Float32", 1.0),
	)

	result_value_equal(
		result,
		sized_float_value("Float32", 16777216.0),
	)


func test_float16_arithmetic_rounds_each_result() -> Bool:
	result = ctfe_eval_binary(
		ParsedAddOp,
		sized_float_value("Float16", 2048.0),
		sized_float_value("Float16", 1.0),
	)

	result_value_equal(
		result,
		sized_float_value("Float16", 2048.0),
	)


func test_sized_float_unary_preserves_type() -> Bool:
	result = ctfe_eval_unary(
		ParsedNegateOp,
		sized_float_value("Float16", 2048.0),
	)

	result_value_equal(
		result,
		sized_float_value("Float16", -2048.0),
	)


func test_string_add_requires_string_rhs() -> Bool:
	ok = ctfe_eval_binary(ParsedAddOp, string_value("bl"), string_value("orp"))
	err = ctfe_eval_binary(ParsedAddOp, string_value("blorp"), int_value(1))

	(
		result_value_equal(ok, string_value("blorp"))
		and result_is_expected_value_error(err, "String", "Int")
	)


func test_unary_ops() -> Bool:
	neg_int = ctfe_eval_unary(ParsedNegateOp, int_value(7))
	neg_float = ctfe_eval_unary(ParsedNegateOp, float_value(2.5))
	not_bool = ctfe_eval_unary(ParsedNotOp, bool_value(False))

	(
		result_value_equal(neg_int, int_value(-7))
		and result_value_equal(neg_float, float_value(-2.5))
		and result_value_equal(not_bool, bool_value(True))
	)


func test_error_messages_are_user_facing() -> Bool:
	err = CtfeExpectedValue("Int", "String")

	ctfe_error_message(err) == "compile-time constant evaluation expected Int, found String"


---
UInt64 literals above Int's range keep their 64-bit pattern instead of
saturating, and render unsigned so compile-time text matches the runtime.
---
pure func test_uint64_literal_bits_render_unsigned() -> Bool:
	uint64 = SemanticNamedType("UInt64", [])
	max_bits = ctfe_int_literal_bits("18446744073709551615")
	half_bits = ctfe_int_literal_bits("9223372036854775808")
	(
		max_bits == -1
		and ctfe_int_literal_bits("42") == 42
		and ctfe_int_literal_bits("-42") == -42
		and ctfe_int_literal_bits("-9223372036854775808") == -9223372036854775807 - 1
		and ctfe_int_literal_bits("9223372036854775807") == 9223372036854775807
		and ctfe_int_value_text(uint64, max_bits) == "18446744073709551615"
		and ctfe_int_value_text(uint64, half_bits) == "9223372036854775808"
		and ctfe_int_value_text(uint64, ctfe_int_literal_bits("18446744073709551610")) == "18446744073709551610"
		and ctfe_int_value_text(uint64, 7) == "7"
		and ctfe_int_value_text(TYPE_INT, max_bits) == "-1"
	)


pure func uint64_value(text: String) -> CtfeValue:
	ctfe_int_literal(SemanticNamedType("UInt64", []), fixture_source_span(), text)


---
UInt64 division, modulo, and ordering read the 64-bit bits as unsigned, like
the runtime's C uint64_t arithmetic, including divisors of at least 2^63.
---
pure func test_uint64_binary_ops_are_unsigned() -> Bool:
	max = uint64_value("18446744073709551615")
	half = uint64_value("9223372036854775808")
	above_half = uint64_value("9223372036854775809")
	near_max = uint64_value("18446744073709551610")
	two = uint64_value("2")
	(
		result_value_equal(
			ctfe_eval_binary(ParsedDivideOp, max, two),
			uint64_value("9223372036854775807"),
		)
		and result_value_equal(
			ctfe_eval_binary(ParsedDivideOp, max, uint64_value("10")),
			uint64_value("1844674407370955161"),
		)
		and result_value_equal(
			ctfe_eval_binary(ParsedModuloOp, max, uint64_value("10")),
			uint64_value("5"),
		)
		and result_value_equal(
			ctfe_eval_binary(ParsedDivideOp, max, uint64_value("3")),
			uint64_value("6148914691236517205"),
		)
		and result_value_equal(ctfe_eval_binary(ParsedDivideOp, near_max, above_half), uint64_value("1"))
		and result_value_equal(
			ctfe_eval_binary(ParsedModuloOp, near_max, above_half),
			uint64_value("9223372036854775801"),
		)
		and result_value_equal(ctfe_eval_binary(ParsedDivideOp, half, above_half), uint64_value("0"))
		and result_value_equal(ctfe_eval_binary(ParsedDivideOp, max, uint64_value("0")), uint64_value("0"))
		and result_value_equal(ctfe_eval_binary(ParsedGreaterOp, max, two), bool_value(True))
		and result_value_equal(ctfe_eval_binary(ParsedLessOp, two, half), bool_value(True))
		and result_value_equal(ctfe_eval_binary(ParsedGreaterEqualOp, half, max), bool_value(False))
		and result_value_equal(ctfe_eval_binary(ParsedDivideOp, int_value(-7), int_value(2)), int_value(-3))
		and result_value_equal(ctfe_eval_binary(ParsedLessOp, int_value(-1), int_value(2)), bool_value(True))
	)


tests: TestSuite = {
	description = "Compiler CTFE value",
	tests = [
		("value equality is structural", test_value_equality_is_structural),
		("UInt64 literal bits render unsigned", test_uint64_literal_bits_render_unsigned),
		("UInt64 binary ops are unsigned", test_uint64_binary_ops_are_unsigned),
		(
			"constructor and dict equality are structural",
			test_constructor_and_dict_equality_are_structural,
		),
		(
			"int binary ops match language infallibility",
			test_int_binary_ops_match_language_infallibility,
		),
		("comparisons return bool values", test_comparisons_return_bool_values),
		("float binary ops and errors", test_float_binary_ops_and_errors),
		("Float32 arithmetic rounds each result", test_float32_arithmetic_rounds_each_result),
		("Float16 arithmetic rounds each result", test_float16_arithmetic_rounds_each_result),
		("sized float unary preserves type", test_sized_float_unary_preserves_type),
		("string add requires string rhs", test_string_add_requires_string_rhs),
		("unary ops", test_unary_ops),
		("error messages are user facing", test_error_messages_are_user_facing),
	]
}
