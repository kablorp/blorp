-- Test support: a chain of modules whose compile-time global reaches one function
-- per module, run through the production graph typechecker.
import:
	../../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../../src/compiler/stage_03_parse/source_ast_finalize:
		FinalizedTypecheckProgram,
		finalized_typecheck_program,
	../../../src/compiler/stage_04_modules/loaded_module: ModuleOrigin(UserModule)
	../../../src/compiler/stage_06_typecheck/bridge:
		TypecheckGraphRequest,
		TypecheckImportModule,
		TypecheckResolvedImport,
		TypecheckedGraph,
		TypecheckedModule,
		typecheck_graph_with_metrics,
	../../../src/compiler/stage_06_typecheck/decl: TypedDecl(TypedGlobalVarDecl), TypedProgram
	../../../src/compiler/stage_06_typecheck/infer: TypedExpr(TypedIntLiteralExpr)
	../../../src/compiler/stage_07_ctfe/globals: ctfe_global_replacements_find
	../../../src/lib/source: source_file
	string: parse_int


fixed record CtfeChainConfig {
	repetitions: Int,
	module_count: Int,
	functions_per_module: Int,
	retain_parsed_programs: Bool
}


fixed record CtfeChainResult {
	artifact_count: Int,
	ctfe_dependency_body_check_count: Int,
	ctfe_reused_body_check_count: Int,
	ctfe_planned_global_module_count: Int,
	ctfe_global_evaluation_start_count: Int,
	ctfe_duplicate_global_evaluation_count: Int,
	ctfe_global_import_binding_application_count: Int,
	ctfe_global_declaration_evaluation_count: Int,
	ctfe_rejected_global_evaluation_count: Int,
	expected_ctfe_reachable_function_body_count: Int,
	expected_ctfe_irrelevant_function_body_count: Int,
	target_declaration_count: Int,
	resolved_import_count: Int,
	evaluated_answer: Int,
	error_count: Int,
	ctfe_evaluated_count: Int,
	graph_valid: Bool
}


private TARGET_DECLARATION_COUNT: Int = 3


private pure func chain_module_path(module_index: Int) -> String:
	"fixture/ctfe_chain_" + module_index.to_string()


private pure func chain_module_file(module_index: Int) -> String:
	"/fixture/ctfe_chain_" + module_index.to_string() + ".brp"


private pure func chain_function_name(module_index: Int, function_index: Int) -> String:
	"ctfe_m" + module_index.to_string() + "_function_" + function_index.to_string()


private pure func chain_dependency_import(module_index: Int) -> String:
	if module_index == 0:
		""
	else:
		"import:\n\t" + chain_module_path(module_index - 1) + " as Previous"


private pure func chain_function_source(module_index: Int, function_index: Int) -> String:
	body: String = if module_index == 0:
		"value + 1"
	else:
		"Previous." + chain_function_name(module_index - 1, function_index) + "(value) + 1"

	"pure func " + chain_function_name(
		module_index,
		function_index,
	) + "(value: Int) -> Int:\n\t" + body


private pure func chain_module_source(module_index: Int, functions_per_module: Int) -> String:
	var declarations: List[String] = []
	dependency_import = chain_dependency_import(module_index)

	if dependency_import.length() > 0:
		declarations = declarations.append(dependency_import)

	for function_index in 0..functions_per_module:
		declarations = declarations.append(chain_function_source(module_index, function_index))

	declarations.join("\n\n") + "\n"


private pure func chain_retained_program(
	path: String,
	module_name: String,
	source: String,
	retain_parsed_programs: Bool,
) -> Option[FinalizedTypecheckProgram]:
	if retain_parsed_programs:
		Some(
			finalized_typecheck_program(
				parse_compiler_source(source_file(path, module_name, source)),
			),
		)
	else:
		None


private pure func chain_module(
	module_index: Int,
	functions_per_module: Int,
	retain_parsed_programs: Bool,
) -> TypecheckImportModule:
	module_path = chain_module_path(module_index)
	path = chain_module_file(module_index)
	source = chain_module_source(module_index, functions_per_module)

	{
		path = path,
		module_name = module_path,
		module_path = module_path,
		text = source,
		typecheck_program = chain_retained_program(
			path,
			module_path,
			source,
			retain_parsed_programs,
		),
		module_surface = None,
		origin = UserModule
	}


private pure func chain_resolved_import(
	from_path: String,
	from_module: String,
	imported_module_index: Int,
) -> TypecheckResolvedImport:
	{
		from_path = from_path,
		from_module = from_module,
		import_path = chain_module_path(imported_module_index),
		resolved_module = chain_module_path(imported_module_index)
	}


private pure func chain_target_source(last_module_index: Int) -> String:
	"import:\n\t" + chain_module_path(
		last_module_index,
	) + " as Dependency\n\nanswer: Int = Dependency." + chain_function_name(
		last_module_index,
		0,
	) + "(0)\n\nfunc main(args: List[String]) -> Int:\n\tanswer\n"


pure func ctfe_chain_request(config: CtfeChainConfig) -> TypecheckGraphRequest:
	var modules: List[TypecheckImportModule] = []
	var resolved_imports: List[TypecheckResolvedImport] = []

	for module_index in 0..config.module_count:
		modules = modules.append(
			chain_module(
				module_index,
				config.functions_per_module,
				config.retain_parsed_programs,
			),
		)

		if module_index > 0:
			resolved_imports = resolved_imports.append(
				chain_resolved_import(
					chain_module_file(module_index),
					chain_module_path(module_index),
					module_index - 1,
				),
			)

	target_path: String = "/fixture/ctfe_chain_main.brp"
	target_module: String = "fixture/ctfe_chain_main"
	last_module_index: Int = config.module_count - 1
	target_source = chain_target_source(last_module_index)
	resolved_imports = resolved_imports.append(
		chain_resolved_import(
			target_path,
			target_module,
			last_module_index,
		),
	)

	{
		target = {
			path = target_path,
			module_name = target_module,
			module_path = target_module,
			text = target_source,
			typecheck_program = chain_retained_program(
				target_path,
				target_module,
				target_source,
				config.retain_parsed_programs,
			),
			module_surface = None,
			origin = UserModule
		},
		modules = modules,
		module_targets = [],
		resolved_imports = resolved_imports,
		include_comments = False,
		allow_debug_only_calls = False
	}


private pure func chain_shared_global_consumer(
	config: CtfeChainConfig,
	consumer_index: Int,
) -> TypecheckImportModule:
	module_path = "fixture/ctfe_chain_consumer_" + consumer_index.to_string()
	path = "/" + module_path + ".brp"
	last_module_index = config.module_count - 1
	source = "import:\n\t" + chain_module_path(
		last_module_index,
	) + ": SHARED_OFFSET\n\nCONSUMER_VALUE: Int = SHARED_OFFSET + " + consumer_index.to_string() + "\n"

	{
		path = path,
		module_name = module_path,
		module_path = module_path,
		text = source,
		typecheck_program = chain_retained_program(
			path,
			module_path,
			source,
			config.retain_parsed_programs,
		),
		module_surface = None,
		origin = UserModule
	}


pure func ctfe_chain_shared_global_request(config: CtfeChainConfig) -> TypecheckGraphRequest:
	base = ctfe_chain_request(config)
	last_module_index = config.module_count - 1
	last_module_path = chain_module_path(last_module_index)
	var modules: List[TypecheckImportModule] = []

	for module in base.modules:
		if module.module_path == last_module_path:
			source = "SHARED_OFFSET: Int = 40\n\n" + module.text
			modules = modules.append({ module |
					text = source,
					typecheck_program = chain_retained_program(
						module.path,
						module.module_name,
						source,
						config.retain_parsed_programs,
					)
				})
		else:
			modules = modules.append(module)

	var module_targets: List[String] = []
	var resolved_imports = base.resolved_imports

	for consumer_index in 1..3:
		consumer = chain_shared_global_consumer(config, consumer_index)
		modules = modules.append(consumer)
		module_targets = module_targets.append(consumer.module_path)
		resolved_imports = resolved_imports.append({
			from_path = consumer.path,
			from_module = consumer.module_name,
			import_path = last_module_path,
			resolved_module = last_module_path,
		})

	{ base |
		modules = modules,
		module_targets = module_targets,
		resolved_imports = resolved_imports
	}


private pure func evaluated_module_global_int(
	module: TypecheckedModule,
	global_name: String,
) -> Option[Int]:
	var result: Option[Int] = None

	for decl in module.typed_program.decls:
		match decl:
			TypedGlobalVarDecl(info):
				if info.decl.name.text == global_name:
					match info.definition_id:
						Some(definition_id):
							match ctfe_global_replacements_find(
								module.ctfe_replacements,
								definition_id,
							):
								Some(replacement):
									match replacement.typed_value:
										TypedIntLiteralExpr(text, _, _):
											result = parse_int(text)
										_:
											void
								None:
									void
						None:
							void
			_:
				void

	result


private pure func evaluated_target_answer(graph: TypecheckedGraph) -> Option[Int]:
	evaluated_module_global_int(graph.target, "answer")


func ctfe_chain_run_with_request(
	config: CtfeChainConfig,
	request: TypecheckGraphRequest,
) -> CtfeChainResult:
	expected_answer: Int = config.module_count
	-- The generated call chain reaches exactly function zero in each module.
	expected_ctfe_reachable_function_body_count: Int = config.module_count
	expected_ctfe_irrelevant_function_body_count: Int = config.module_count * (config.functions_per_module - 1)

	var artifact_count: Int = 0
	var target_declaration_count: Int = 0
	var ctfe_dependency_body_check_count: Int = 0
	var ctfe_reused_body_check_count: Int = 0
	var ctfe_planned_global_module_count: Int = 0
	var ctfe_global_evaluation_start_count: Int = 0
	var ctfe_duplicate_global_evaluation_count: Int = 0
	var ctfe_global_import_binding_application_count: Int = 0
	var ctfe_global_declaration_evaluation_count: Int = 0
	var ctfe_rejected_global_evaluation_count: Int = 0
	var evaluated_answer: Int = -1
	var error_count: Int = 0
	var ctfe_evaluated_count: Int = 0
	var graph_valid: Bool = (
		config.repetitions > 0
		and config.module_count > 0
		and config.functions_per_module > 0
	)

	for _ in 0..config.repetitions:
		run = typecheck_graph_with_metrics(request)
		graph = run.graph
		ctfe_dependency_body_check_count += run.ctfe.dependency_body_checks
		ctfe_reused_body_check_count += run.ctfe.reused_body_checks
		ctfe_planned_global_module_count += run.ctfe.planned_global_modules
		ctfe_global_evaluation_start_count += run.ctfe.global_evaluation_starts
		ctfe_duplicate_global_evaluation_count += run.ctfe.duplicate_global_evaluations
		ctfe_global_import_binding_application_count += run.ctfe.global_import_binding_applications

		ctfe_global_declaration_evaluation_count += run.ctfe.global_declaration_evaluations
		ctfe_rejected_global_evaluation_count += run.ctfe.rejected_global_evaluations
		artifact_count = graph.modules.length() + 1
		target_declaration_count = graph.target.parsed_program.decls.length()
		error_count += graph.target.errors.length()
		var module_artifacts_valid: Bool = True
		var first_consumer_value: Option[Int] = None
		var second_consumer_value: Option[Int] = None

		for module in graph.modules:
			error_count += module.errors.length()
			module_artifacts_valid = (
				module_artifacts_valid
				and module.errors.is_empty()
				and module.ctfe_evaluated
			)

			consumer_value = evaluated_module_global_int(module, "CONSUMER_VALUE")

			match consumer_value:
				Some(value):
					if module.parsed_program.source.path == "/fixture/ctfe_chain_consumer_1.brp":
						first_consumer_value = Some(value)
					else if module.parsed_program.source.path == "/fixture/ctfe_chain_consumer_2.brp":
						second_consumer_value = Some(value)
				None:
					void

		if graph.target.ctfe_evaluated:
			ctfe_evaluated_count += 1

		match evaluated_target_answer(graph):
			Some(answer):
				evaluated_answer = answer
			None:
				evaluated_answer = -1

		consumer_values_valid: Bool = if request.module_targets.length() == 2:
			first_consumer_value == Some(41) and second_consumer_value == Some(42)
		else:
			first_consumer_value.is_none() and second_consumer_value.is_none()

		graph_valid = (
			graph_valid
			and artifact_count == request.module_targets.length() + 1
			and target_declaration_count == TARGET_DECLARATION_COUNT
			and request.modules.length() >= config.module_count
			and request.resolved_imports.length() >= config.module_count
			and graph.target.errors.length() == 0
			and graph.target.ctfe_evaluated
			and module_artifacts_valid
			and consumer_values_valid
			and evaluated_answer == expected_answer
		)

	{
		artifact_count = artifact_count,
		ctfe_dependency_body_check_count = ctfe_dependency_body_check_count,
		ctfe_reused_body_check_count = ctfe_reused_body_check_count,
		ctfe_planned_global_module_count = ctfe_planned_global_module_count,
		ctfe_global_evaluation_start_count = ctfe_global_evaluation_start_count,
		ctfe_duplicate_global_evaluation_count = ctfe_duplicate_global_evaluation_count,
		ctfe_global_import_binding_application_count = ctfe_global_import_binding_application_count,
		ctfe_global_declaration_evaluation_count = ctfe_global_declaration_evaluation_count,
		ctfe_rejected_global_evaluation_count = ctfe_rejected_global_evaluation_count,
		expected_ctfe_reachable_function_body_count = expected_ctfe_reachable_function_body_count,
		expected_ctfe_irrelevant_function_body_count = expected_ctfe_irrelevant_function_body_count,
		target_declaration_count = target_declaration_count,
		resolved_import_count = request.resolved_imports.length(),
		evaluated_answer = evaluated_answer,
		error_count = error_count,
		ctfe_evaluated_count = ctfe_evaluated_count,
		graph_valid = graph_valid
	}


func ctfe_chain_run(config: CtfeChainConfig) -> CtfeChainResult:
	request = ctfe_chain_request(config)
	ctfe_chain_run_with_request(config, request)
