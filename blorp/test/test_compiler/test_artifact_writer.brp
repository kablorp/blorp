import:
	../../src/compiler/artifact_writer:
		ArtifactWriteError(MissingEmbeddedRuntime, SplitArtifactRequiresExternalRuntime),
		CSplitOutputPaths,
		compile_output_path,
		compile_split_output_paths,
		split_manifest_text,
		write_compile_artifact,
	../../src/lib/compilation: CompileArtifactOutput
	../../src/lib/function_profile:
		FunctionProfileMode(
			FunctionProfileCallsMode,
			FunctionProfileExactMode,
			FunctionProfileOffMode,
		),
	fs: IOError(Other), resource_path, temporary_directory, write_text_parts_atomic
	system: read_file, temp_dir
	test: TestSuite


private pure func artifact(embed_runtime: Bool) -> CompileArtifactOutput:
	{
		c_code = "int generated(void) { return 1; }\n",
		extra_units = [],
		embed_runtime = embed_runtime,
		profile_mode = FunctionProfileOffMode
	}


private pure func test_compile_output_path_uses_source_stem() -> Bool:
	(
		compile_output_path("src/example.brp", None) == "src/example.c"
		and compile_output_path("src/archive.name.brp", None) == "src/archive.name.c"
		and compile_output_path("src/example.brp", Some("build/output.c")) == "build/output.c"
	)


private pure func test_split_output_paths_replace_the_output_extension() -> Bool:
	paths: CSplitOutputPaths = compile_split_output_paths("build/example.c", 3)

	(
		paths.shared_header == "build/example.h"
		and paths.bodies == ["build/example.0.c", "build/example.1.c", "build/example.2.c"]
		and paths.manifest == "build/example.units"
	)


private pure func test_split_output_paths_handle_a_bare_output_name() -> Bool:
	paths: CSplitOutputPaths = compile_split_output_paths("example", 1)

	(
		paths.shared_header == "example.h"
		and paths.bodies == ["example.0.c"]
		and paths.manifest == "example.units"
	)


private pure func test_split_output_paths_keep_interior_dots() -> Bool:
	paths: CSplitOutputPaths = compile_split_output_paths("build/archive.name.c", 2)

	(
		paths.shared_header == "build/archive.name.h"
		and paths.bodies == ["build/archive.name.0.c", "build/archive.name.1.c"]
		and paths.manifest == "build/archive.name.units"
	)


private pure func test_split_manifest_lists_the_header_first() -> Bool:
	split_manifest_text(
		compile_split_output_paths(
			"build/example.c",
			2,
		),
	) == "build/example.h\nbuild/example.0.c\nbuild/example.1.c\n"


private func test_split_artifact_requires_an_external_runtime() -> Bool:
	embedded_split: CompileArtifactOutput = { artifact(True) |
		extra_units = ["#include \"example.h\"\n"]
	}

	match write_compile_artifact(embedded_split, "unused.c", "/* runtime */\n"):
		Err(SplitArtifactRequiresExternalRuntime):
			True
		_:
			False


private func exercise_artifact_write(
	embed_runtime: Bool,
	runtime_source: String,
) -> Result[String, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_artifact_writer_"):
		path: String = directory.resource_path() + "/output file.c"

		match write_compile_artifact(artifact(embed_runtime), path, runtime_source):
			Ok(_):
				match read_file(path):
					Ok(contents):
						Ok(contents)
					Err(detail):
						Err(Other(detail))
			Err(_):
				Err(Other("artifact write failed"))


private func test_embedded_runtime_is_written_before_generated_c() -> Bool:
	match exercise_artifact_write(True, "/* runtime */\n"):
		Ok(contents):
			contents == "/* runtime */\nint generated(void) { return 1; }\n"
		Err(_):
			False


private func exercise_profile_write(
	mode: FunctionProfileMode,
	expected_contents: String,
) -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_artifact_writer_profile_"):
		path: String = directory.resource_path() + "/profile.c"
		profiled = { artifact(True) | profile_mode = mode }

		match write_compile_artifact(profiled, path, "/* runtime */\n"):
			Err(_):
				Ok(False)
			Ok(_):
				match read_file(path):
					Ok(contents):
						Ok(contents == expected_contents)
					Err(detail):
						Err(Other(detail))


private func test_exact_profile_define_precedes_embedded_runtime() -> Bool:
	match exercise_profile_write(
		FunctionProfileExactMode,
		"#define BLORP_PROFILE_EXACT_TIMING 1\n#define BLORP_PROFILE_COLLECTION_COPY_COUNTERS 1\n/* runtime */\nint generated(void) { return 1; }\n",
	):
		Ok(result):
			result
		Err(_):
			False


private func test_calls_profile_define_precedes_embedded_runtime() -> Bool:
	match exercise_profile_write(
		FunctionProfileCallsMode,
		"#define BLORP_PROFILE_COLLECTION_COPY_COUNTERS 1\n/* runtime */\nint generated(void) { return 1; }\n",
	):
		Ok(result):
			result
		Err(_):
			False


private func test_off_profile_omits_profile_prelude() -> Bool:
	match exercise_profile_write(
		FunctionProfileOffMode,
		"/* runtime */\nint generated(void) { return 1; }\n",
	):
		Ok(result):
			result
		Err(_):
			False


private func test_external_runtime_writes_only_generated_c() -> Bool:
	match exercise_artifact_write(False, "ignored"):
		Ok(contents):
			contents == "int generated(void) { return 1; }\n"
		Err(_):
			False


private func test_embedded_runtime_must_be_available() -> Bool:
	result: Result[String, ArtifactWriteError] = write_compile_artifact(
		artifact(True),
		"unused.c",
		"",
	)

	match result:
		Err(MissingEmbeddedRuntime):
			True
		_:
			False


private func exercise_atomic_text_parts() -> Result[String, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_atomic_parts_"):
		path: String = directory.resource_path() + "/parts.txt"
		ignored ?= write_text_parts_atomic(
			path,
			["first", "", "-second", "-third"],
		)

		match read_file(path):
			Ok(contents):
				Ok(contents)
			Err(detail):
				Err(Other(detail))


private func test_atomic_text_parts_preserve_order_and_empty_parts() -> Bool:
	match exercise_atomic_text_parts():
		Ok(contents):
			contents == "first-second-third"
		Err(_):
			False


tests: TestSuite = {
	description = "Compiler artifact writer",
	tests = [
		("default output uses source stem", test_compile_output_path_uses_source_stem),
		(
			"split paths replace the output extension",
			test_split_output_paths_replace_the_output_extension,
		),
		(
			"split paths handle a bare output name",
			test_split_output_paths_handle_a_bare_output_name,
		),
		("split paths keep interior dots", test_split_output_paths_keep_interior_dots),
		("split manifest lists the header first", test_split_manifest_lists_the_header_first),
		(
			"split artifact requires an external runtime",
			test_split_artifact_requires_an_external_runtime,
		),
		(
			"embedded runtime precedes generated C",
			test_embedded_runtime_is_written_before_generated_c,
		),
		(
			"exact profile define precedes embedded runtime",
			test_exact_profile_define_precedes_embedded_runtime,
		),
		(
			"calls profile define precedes embedded runtime",
			test_calls_profile_define_precedes_embedded_runtime,
		),
		("off profile omits profile prelude", test_off_profile_omits_profile_prelude),
		("external runtime writes generated C", test_external_runtime_writes_only_generated_c),
		("embedded runtime is required", test_embedded_runtime_must_be_available),
		(
			"atomic text parts preserve order",
			test_atomic_text_parts_preserve_order_and_empty_parts,
		),
	]
}
