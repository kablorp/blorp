-- Product builds for Core fixtures, checked like lowering checks them.
import:
	../../src/compiler/stage_09_core/ir:
		CoreExpr,
		CoreProductBuild,
		CoreProductFieldValue,
		core_field_ordinal,
		product_build,
		product_build_in_declared_order,


---
The build of a product with `field_count` fields from `(ordinal, value)`
pairs in written order. A fixture whose ordinals do not name every field once
gets an empty build, which no test expects, so the test using that fixture
fails rather than running on a malformed build.
---
pure func fixture_build(field_count: Int, fields: List[(Int, CoreExpr)]) -> CoreProductBuild:
	values: List[CoreProductFieldValue] = fields.map(pure func(entry: (Int, CoreExpr)) -> CoreProductFieldValue:
		(ordinal, value) = entry
		{
			ordinal = core_field_ordinal(ordinal),
			value = value
		}
	)

	match product_build(field_count, values):
		Ok(build):
			build
		Err(_):
			product_build_in_declared_order([])
