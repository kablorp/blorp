import:
	../../../src/compiler/pipeline:
		CompiledTypedGraph(CompiledTypedGraphReady),
		FrontendCompilePolicy,
		compile_frontend_graph,
	../../../src/compiler/stage_02_lex/name_table: NameTable, name_spelling
	../../../src/compiler/stage_09_core/ir:
		CoreBinaryOp(EqualOp),
		CoreCallKind(UserCall),
		CoreDecl(FunctionDecl, HeapRecordDecl),
		CoreDeclaredOrigin(ProjectedImplMethod),
		CoreExpr(BinaryExpr, CallExpr, LogicalExpr, ProductFieldExpr, UnaryExpr, VarExpr),
		CoreFieldOrdinal,
		CoreFunction,
		CoreLogicalOp(AndOp),
		CoreProgram,
		CoreType(HeapRecordType, NamedType),
		CoreUnaryOp(NotOp),
		core_field_ordinal_index,
		core_field_ordinals_equal,
		core_function_declared_origin,
	../../../src/compiler/stage_09_core/traverse: immediate_core_expr_children
	../../../src/lib/cli_plan: CliRunPlan(CliRunCompile)
	../../../src/main: run_cli
	io: print_error
	system: remove_file, temp_dir, write_file
	test: TestSuite


-- Neither record writes an `implements Equatable` block, so `==` and `!=` must
-- reach the impl Core lowering derives from the fields: `equals` compares the
-- fields in declaration order, and `not_equals` negates `==`.
private SOURCE: String = "record Point {\n" + "\tx: Int,\n" + "\ty: Int\n" + "}\n\n\n" + "record Wrap[T] {\n" + "\tvalue: T\n" + "}\n\n\n" + "func compare(a: Point, b: Point, c: Wrap[Point], d: Wrap[Point]) -> Bool:\n" + "\ta == b and a != b and c == d\n\n\n" + "func main(args: List[String]):\n" + "\tn: Int = args.length()\n" + "\tp: Point = {x = n, y = 1}\n" + "\tprint(compare(p, p, {value = p}, {value = p}))\n"


private func compiled_program() -> Option[(CoreProgram, NameTable)]:
	path: String = temp_dir() + "/blorp_derived_record_equality_targets.brp"
	_ = remove_file(path)

	if write_file(path, SOURCE).is_err():
		print_error("could not write " + path)
		None
	else:
		plan = run_cli(["compile", "--no-format", path])
		_ = remove_file(path)

		match plan:
			CliRunCompile(compile_plan):
				policy: FrontendCompilePolicy = {
					allow_debug_only_calls = False,
					retain_debug_blocks = False,
					include_typed_summary = False
				}

				match (
					compile_frontend_graph(
						compile_plan.graph,
						policy,
						pure func(errors): errors,
						True,
						False,
						[],
						None,
					)
				):
					Ok(CompiledTypedGraphReady(compilation, _, _, _)):
						Some((compilation.program, compilation.names))
					Err(errors):
						print_error("frontend compile failed:\n" + errors.join("\n"))
						None
					Ok(_):
						print_error("frontend compile did not reach Core")
						None
			_:
				print_error("run_cli did not produce a compile plan")
				None


private pure func functions(program: CoreProgram) -> List[CoreFunction]:
	program.decls.filter_map(func(decl):
		match decl:
			FunctionDecl(function_info):
				Some(function_info)
			_:
				None
	)


private pure func user_call_targets(expr: CoreExpr) -> List[Int]:
	own: List[Int] = match expr:
		CallExpr(UserCall(_, Some(def_id), _), _, _, _, _):
			[def_id]
		_:
			[]

	own.concat(immediate_core_expr_children(expr).flat_map(user_call_targets))


---
The fields an `equals` body compares, in order, spelled from `field_names` (the
record's fields in declaration order), when it is the derived form
`left.f == right.f and ...`; "?" marks any other shape.
---
private pure func compared_fields(field_names: List[String], body: CoreExpr) -> List[String]:
	match body:
		LogicalExpr(AndOp, earlier, last, _, _):
			compared_fields(field_names, earlier).concat(compared_fields(field_names, last))
		BinaryExpr(EqualOp, ProductFieldExpr(VarExpr(_, _, _), left, _, _), ProductFieldExpr(VarExpr(_, _, _), right, _, _), _, _):
			[same_field_name(field_names, left, right)]
		CallExpr(_, _, [ProductFieldExpr(_, left, _, _), ProductFieldExpr(_, right, _, _)], _, _):
			-- A field whose `==` is an impl method is a call to it.
			[same_field_name(field_names, left, right)]
		_:
			["?"]


private pure func same_field_name(
	field_names: List[String],
	left: CoreFieldOrdinal,
	right: CoreFieldOrdinal,
) -> String:
	if core_field_ordinals_equal(left, right):
		field_names.get(core_field_ordinal_index(left)).get_or("?")
	else:
		"?"


private pure func record_field_names(program: CoreProgram, record_name: String) -> List[String]:
	program.decls
		.filter_map(func(decl):
			match decl:
				HeapRecordDecl(record_decl):
					if record_decl.name == record_name:
						Some(record_decl.fields.map(func(field): field.name))
					else:
						None
				_:
					None
		)
		.get(0)
		.get_or([])


---
Describes a call target as `Trait.method on receiver`, then what its body
does: the fields a derived `equals` compares, or `not ==` for the default.
---
private pure func describe_target(
	program: CoreProgram,
	names: NameTable,
	target: CoreFunction,
) -> String:
	match core_function_declared_origin(target.origin):
		ProjectedImplMethod(trait_id, method_id, for_type, _):
			receiver: String = match for_type:
				HeapRecordType(name) | NamedType(name, _):
					name
				_:
					"other"

			body: String = match target.body:
				Some(UnaryExpr(NotOp, CallExpr(_, _, _, _, _), _, _)):
					"not =="
				Some(other):
					"compares " + compared_fields(record_field_names(program, receiver), other).join(", ")
				None:
					"no body"

			name_spelling(
				names,
				trait_id,
			).get_or(
				"?",
			) + "." + name_spelling(names, method_id).get_or("?") + " on " + receiver + ", " + body
		_:
			"not an impl method: " + target.name


func test_record_operators_call_derived_equality() -> Bool:
	match compiled_program():
		None:
			False
		Some((program, names)):
			all_functions: List[CoreFunction] = functions(program)

			match all_functions.find(func(function_info): function_info.name == "compare"):
				Some(compare):
					match compare.body:
						Some(body):
							targets: List[String] = user_call_targets(body).map(func(def_id):
								match all_functions.find(
									func(function_info): function_info.def_id == def_id,
								):
									Some(target):
										describe_target(program, names, target)
									None:
										"missing function " + def_id.to_string()
							)
							expected: List[String] = [
								"Equatable.equals on Point, compares x, y",
								"Equatable.not_equals on Point, not ==",
								"Equatable.equals on Wrap__mono_Point, compares value",
							]

							if targets != expected:
								print_error("compare calls " + targets.join("; "))
								False
							else:
								True
						None:
							print_error("compare has no body")
							False
				None:
					print_error("lowered Core has no compare function")
					False


tests: TestSuite = {
	description = "Operators on records without a written Equatable reach the derived impl",
	tests = [("record operators call derived equality", test_record_operators_call_derived_equality)]
}
