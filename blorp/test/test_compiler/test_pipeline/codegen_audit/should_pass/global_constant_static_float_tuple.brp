-- The static managed row stores all float widths directly, without slot boxes.
-- EXPECT-C-REGEX: static brp_ty[0-9A-Za-z]+ __blorp_static_record_FLOAT_TRIPLE = \{
-- EXPECT-C: .header = { BLORP_IMMORTAL_REFCOUNT, BLORP_ALLOC_CLASS_DIRECT, 0 },
-- EXPECT-C: .f0 = 1.5,
-- EXPECT-C: .f1 = 2.25,
-- EXPECT-C: .f2 = 3.5
-- EXPECT-C: double f0;
-- EXPECT-C: float f1;
-- EXPECT-C: _Float16 f2;
-- EXPECT-C-REGEX: static brp_ty[0-9A-Za-z]+\* FLOAT_TRIPLE = \(brp_ty[0-9A-Za-z]+\*\)&__blorp_static_record_FLOAT_TRIPLE;
-- EXPECT-NOT-C-REGEX: FLOAT_TRIPLE = .*_make\(
-- EXPECT-NOT-C: blorp_make_immortal_constant(FLOAT_TRIPLE);
-- EXPECT-NOT-C: blorp_box_float(
-- EXPECT-NOT-C: blorp_box_float32(
-- EXPECT-NOT-C: blorp_box_float16(
FLOAT_TRIPLE: (Float, Float32, Float16) = (1.5, to_float32(2.25), to_float16(3.5))


func main(args: List[String]) -> Int:
	if (
		FLOAT_TRIPLE[0] == 1.5
		and FLOAT_TRIPLE[1] == to_float32(2.25)
		and FLOAT_TRIPLE[2] == to_float16(3.5)
	):
		0
	else:
		1
