-- Escaping tuples should stay on the default Blorp final-Core-to-C emitter
-- through the production backend.
--
-- EXPECT-C: /* Blorp final Core C artifact */
-- Semantic callable expectation: typed managed row make_pair(long a, long b)
-- EXPECT-C-REGEX: brp_ty[0-9A-Za-z]+\* brp_[0-9A-Za-z]+\(long brp_vn?_[A-Za-z0-9]+, long brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C-REGEX: return brp_ty[0-9A-Za-z]+_make\(brp_vn_[A-Za-z0-9]+, brp_vn_[A-Za-z0-9]+\);
-- EXPECT-C: long f0;
-- EXPECT-C: long f1;
-- Semantic callable expectation: long pair_sum(typed managed row pair)
-- EXPECT-C-REGEX: long brp_[0-9A-Za-z]+\(brp_ty[0-9A-Za-z]+\* brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C-REGEX: return \(brp_vn?_[A-Za-z0-9]+->f0 \+ brp_vn?_[A-Za-z0-9]+->f1\);
pure func make_pair(a: Int, b: Int) -> (Int, Int):
	(a, b)


pure func pair_sum(pair: (Int, Int)) -> Int:
	pair[0] + pair[1]


func main(args: List[String]) -> Int:
	pair: (Int, Int) = make_pair(20, 22)

	if pair_sum(pair) == 42:
		0
	else:
		1
