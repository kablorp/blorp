-- Generated-C shape audit for nullable managed Option payloads in Stream APIs.
-- EXPECT-C-REGEX: blorp_stream_from_list\(brp_vt_[A-Za-z0-9]+_b0
-- EXPECT-C: blorp_Stream* __t1_2 = blorp_stream_filter_map_nullable(__t0_0, __t0_1);
-- EXPECT-C-REGEX: blorp_List\* brp_vn?_[A-Za-z0-9]+ = blorp_stream_collect\(brp_vn?_[A-Za-z0-9]+\);
-- EXPECT-C: void* __t1_5 = blorp_stream_find_nullable(__t0_3, __t0_4);
-- EXPECT-NOT-C: __def_528_stream__from_list
-- EXPECT-NOT-C: __def_541_stream__collect
-- EXPECT-NOT-C: __def_545_stream__find
import:
	option: Option(Some, None)
	stream as S


func keep_long(s: String) -> Option[String]:
	if s.length() > 1:
		Some(s)
	else:
		None


func main(args: List[String]) -> Int:
	filtered: Stream[String] = S.filter_map(
		S.from_list(["a", "bee"]),
		keep_long,
	)
	items: List[String] = S.collect(filtered)
	found: Option[String] = S.find(S.from_list(["a", "bee"]), func(s: String): s.length() > 1)

	items_ok: Bool = match items.get(0):
		Some(s):
			s == "bee"
		None:
			False

	found_ok: Bool = match found:
		Some(s):
			s == "bee"
		None:
			False

	if items_ok and found_ok:
		0
	else:
		1
