-- Regression: no-capture pure List HOF callbacks should inline into the
-- synthesized list loop instead of allocating/dispatching a closure.
--
-- EXPECT-NOT-C: _blorp_clambda
-- EXPECT-NOT-C: blorp_closure
import:
	list: List, filter, fold_left


pure func sum_even(xs: List[Int]) -> Int:
	evens: List[Int] = filter(xs, func(x: Int): x % 2 == 0)
	fold_left(evens, 0, func(acc: Int, x: Int): acc + x)


func main(args: List[String]) -> Int:
	sum_even([1, 2, 3, 4, 5, 6])
