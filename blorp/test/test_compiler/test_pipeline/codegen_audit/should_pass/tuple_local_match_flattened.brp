-- A local tuple matched with bindings of its elements is a group of values;
-- no tuple is allocated.
-- No generated tuple row survives this local-only shape.
-- EXPECT-NOT-C: "$blorp$tuple_storage$
-- EXPECT-C-REGEX: brp_vn_[0-9A-Za-z]+ =
func main(args: List[String]) -> Int:
	pair: (Int, Int) = (3, 7)

	result: Int = match pair:
		(a, b):
			a + b

	if result == 10:
		0
	else:
		1
