-- Scalar union keys stay unboxed while set probes dispatch through authored
-- Hashable callbacks. Default tag equality does not supply a hash: the old
-- immediate integer-hash shortcut would bypass the caller's implementation.
-- Mapped tags use immediate slots and the constructor has no key-release
-- callback; set storage itself can still allocate.
--
-- EXPECT-C: blorp_set_new_custom(
-- EXPECT-C-REGEX: blorp_set_new_custom\(\(unsigned long \(\*\)\(void\*\)\)[A-Za-z0-9_]+, \(bool \(\*\)\(void\*, void\*\)\)[A-Za-z0-9_]+, NULL\)
-- EXPECT-C-REGEX: static unsigned long [A-Za-z0-9_]+\(void\* key_slot\);
-- EXPECT-C-REGEX: static unsigned long [A-Za-z0-9_]+\(void\* key_slot\) \{
-- EXPECT-C-REGEX: static bool [A-Za-z0-9_]+\(void\* left_slot, void\* right_slot\);
-- EXPECT-C-REGEX: static bool [A-Za-z0-9_]+\(void\* left_slot, void\* right_slot\) \{
-- EXPECT-C: void* __mapped_key = (void*)(long)(__mapped);
-- EXPECT-NOT-C-REGEX: blorp_box_[A-Za-z0-9_]+\(
-- EXPECT-C-REGEX: ->hash_fn\(__insert_key\)
-- EXPECT-C-REGEX: ->hash_fn\(__elem\)
-- EXPECT-NOT-C: blorp_hash_int((long)(intptr_t)__insert_key)
-- EXPECT-NOT-C: blorp_hash_int((long)(intptr_t)__elem)
-- EXPECT-CALLABLE: Hashable_hash_Color
-- EXPECT-CALLABLE: Hashable_hash_Shade
-- EXPECT-CALLABLE: Equatable_equals_Shade
import:
	set as S


fixed union Color:
	Red
	Green
	Blue


implements Hashable for Color:
	pure func hash(value: Color) -> Int:
		-- Every key collides, and the adapter converts a signed hash to unsigned.
		-1


union Shade:
	Light
	Medium
	Dark


pure func shade_group(value: Shade) -> Int:
	match value:
		Light: 0
		Medium: 1
		Dark: 1


implements Equatable for Shade:
	pure func equals(left: Shade, right: Shade) -> Bool:
		shade_group(left) == shade_group(right)


implements Hashable for Shade:
	pure func hash(value: Shade) -> Int:
		-1


pure func next_color(c: Color) -> Color:
	match c:
		Red: Green
		Green: Blue
		Blue: Red


pure func lighten(value: Shade) -> Shade:
	Light


func default_equality_set() -> Bool:
	var s: Set[Color] = S.set()
	s = S.add(s, Red)
	s = S.add(s, Blue)
	s = S.add(s, Red)
	mapped: Set[Color] = S.map(s, next_color)
	filtered: Set[Color] = S.filter(mapped, func(c: Color): c != Red)
	(
		Red == Red and Red != Blue
		and S.length(s) == 2
		and S.contains(s, Red) and S.contains(s, Blue)
		and not S.contains(s, Green)
		and S.length(mapped) == 2
		and S.contains(mapped, Green)
		and S.contains(mapped, Red)
		and not S.contains(mapped, Blue)
		and S.length(filtered) == 1
		and S.contains(filtered, Green)
		and not S.contains(filtered, Red)
		and not S.contains(filtered, Blue)
	)


func authored_equality_set() -> Bool:
	var s: Set[Shade] = S.set()
	s = S.add(s, Medium)
	s = S.add(s, Dark)
	s = S.add(s, Medium)
	mapped: Set[Shade] = S.map(s, lighten)
	filtered: Set[Shade] = S.filter(s, func(value: Shade): shade_group(value) == 0)
	(
		Medium == Dark and Light != Medium
		and S.length(s) == 1
		and S.contains(s, Medium) and S.contains(s, Dark)
		and not S.contains(s, Light)
		and S.length(mapped) == 1 and S.contains(mapped, Light)
		and not S.contains(mapped, Medium)
		and S.length(filtered) == 0
		and not S.contains(filtered, Dark)
	)


func run() -> Int:
	if default_equality_set() and authored_equality_set():
		0
	else:
		1


func main(args: List[String]) -> Int:
	run()
