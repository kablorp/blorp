-- A local tuple binding whose RHS is a tuple-valued if is flattened when the
-- binding is used only through tuple fields. The condition is still evaluated
-- once, and each selected tuple element stays explicit.
-- No generated tuple row survives this local-only shape.
-- EXPECT-NOT-C: "$blorp$tuple_storage$
-- EXPECT-C-REGEX: brp_vn_[0-9A-Za-z]+ =
-- Semantic callable expectation: mark(20
-- EXPECT-C-REGEX: brp_[0-9A-Za-z]+\(20
-- Semantic callable expectation: mark(22
-- EXPECT-C-REGEX: brp_[0-9A-Za-z]+\(22
func mark(x: Int) -> Int:
	x


func main(args: List[String]) -> Int:
	pair: (Int, Int) = if True:
		(mark(20), mark(22))
	else:
		(mark(1), mark(2))

	if pair[0] + pair[1] == 42:
		0
	else:
		1
