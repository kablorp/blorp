-- Every literal storage variant evaluates its scalar element expressions at
-- the shared named ownership boundary before allocating tensor storage.
-- EXPECT-NOT-C: #error
-- EXPECT-C: blorp_vector_new_sized
-- EXPECT-C: blorp_vector_new_i64
-- EXPECT-C: blorp_vector_new_packed
fixed record Point {
	x: Int
}


record Score {
	score: Int
}


record Flag {
	flag: Bool
}


func main(args: List[String]) -> Int:
	points: Point[#1] = {{x = -1}}
	raw: Int[#1] = {({score = -1}).score}
	bits: Bool[#1] = {({flag = not True}).flag}

	if points[0].x == -1 and raw[0] == -1 and not bits[0]:
		0
	else:
		1
