-- Module-qualified fixed_point builtins must resolve as direct calls, not closure
-- field dispatch on the module alias.
-- EXPECT-C: blorp_fixed_point_new
-- EXPECT-C: blorp_fixed_point_from_int
-- EXPECT-NOT-C: F->fixed_point
-- EXPECT-NOT-C: F->from_int
import:
	fixed_point as F


func make_price() -> FixedPoint:
	F.fixed_point(2.5, 2)


func int_price() -> FixedPoint:
	F.from_int(2, 2)


func annotated_price() -> FixedPoint:
	price: FixedPoint = F.fixed_point(2.5, 2)
	price


func main(args: List[String]) -> Int:
	value: Float = to_float(3)
	value.to_int() + F.get_scale(
		make_price(),
	) + F.get_scale(int_price()) + F.get_scale(annotated_price())
