-- A managed record holds an inline record from another module by value.
-- Scan is declared before Cursor; inline records are defined ahead of every
-- other type, so Scan's struct can embed Cursor, and nothing releases it.
--
-- EXPECT-C-REGEX: ^  brp_ty[0-9A-Za-z]+ f0;$
-- EXPECT-C: _Bool f1;
-- EXPECT-C-REGEX: brp_ty[0-9A-Za-z]+\* brp_ty[0-9A-Za-z]+_make\(brp_ty[0-9A-Za-z]+ f0, int f1\)
-- EXPECT-NOT-C-REGEX: BLORP_INSTALL_(TAG|TYPE)\(__rec, [^)]*"Cursor"\)
-- EXPECT-NOT-C: blorp_release((blorp_Object*)__rec->f0);
import:
	cross_module_struct_field/b_scan: Scan, make_scan, scan_offset


func main(_: List[String]) -> Int:
	scan: Scan = make_scan(7)
	print(scan_offset(scan).to_string())
	0
