-- EXPECT-C: int main(void)
-- EXPECT-NOT-C: int main(int argc, char** argv)
import:
	exit as Exit: ExitStatus, ExitStatusAble


record CustomStatus {
	code: Int
}


implements ExitStatusAble for CustomStatus:
	pure func to_exit_status(value: CustomStatus) -> Exit.ExitStatus:
		{
			code = value.code,
			message = Some("custom status")
		}


func main() -> CustomStatus:
	{code = 9}
