-- A tensor of inline records stores the structs in its buffer: the literal is
-- written by value, `get_or` copies an element into a stack Option, and a
-- parallel map returns structs through the struct-box callback slot.
--
-- EXPECT-C: /* Blorp final Core C artifact */
-- EXPECT-C-REGEX: blorp_vector_new_sized\(3, sizeof\(brp_ty[0-9]+\)\)
-- EXPECT-C-REGEX: BLORP_VECTOR_STORAGE_INLINE, sizeof\(brp_ty[0-9]+\), BLORP_VECTOR_CALLBACK_BOXED_STRUCT
-- EXPECT-C-REGEX: ^static brp_ty[0-9]+ ZERO_ACCEL;$
-- EXPECT-NOT-C-REGEX: BLORP_INSTALL_(TAG|TYPE)\(__rec, [^)]*"(Accel|Point)"\)
import:
	tensor: get_or
	vector: ParallelVector, parallel


fixed record Accel {
	x: Float,
	y: Float,
	z: Float
}


fixed record Point {
	x: Int,
	y: Int
}


ZERO_ACCEL: Accel = {
	x = 0.0,
	y = 0.0,
	z = 0.0
}


func read_vector(v: Point[#3]) -> Point:
	v.get_or(1, {
			x = 0,
			y = 0
		})


func main(args: List[String]) -> Int:
	v: Point[#3] = {{
			x = 1,
			y = 10
		}, {
			x = 2,
			y = 20
		}, {
			x = 3,
			y = 30
		}}
	p: Point = read_vector(v)
	values: Float[#4] = vector(1.0, 4)
	accel: Accel[#4] = values.parallel(pure func(chunk: ParallelVector[Float, #4]):
		chunk.map_indexed(pure func(i: ..#4, value: Float) -> Accel: {
				x = value + to_float(i),
				y = value,
				z = 0.0
			})
	)
	sample: Accel = get_or(accel, 2, ZERO_ACCEL)
	if p.x == 2 and p.y == 20 and sample.x > 2.9:
		0
	else:
		1
