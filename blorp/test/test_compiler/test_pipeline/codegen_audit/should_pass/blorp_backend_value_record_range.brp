-- EXPECT-C: /* Blorp final Core C artifact */
-- Standard Range syntax constructs the authoritative managed record.
-- EXPECT-C: brp_ty0* brp_ty0_make(long f0, long f1)
-- EXPECT-C: BLORP_INSTALL_TAG(__rec, "range__Range");
-- EXPECT-C: brp_ty0* brp_v_7c = brp_ty0_make(1, 4);
-- EXPECT-C-REGEX: brp_vn?_[A-Za-z0-9]+->f1 - brp_vn?_[A-Za-z0-9]+->f0
-- EXPECT-C: blorp_release(brp_v_7c);
import:
	range: length


pure func count_range() -> Int:
	r: Range = 1..4
	r.length()


func main(args: List[String]) -> Int:
	if count_range() == 3:
		0
	else:
		1
