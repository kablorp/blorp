-- EXPECT-C: /* Blorp final Core C artifact */
-- Standard Range syntax builds the `range` module's fixed record of two Ints,
-- which is stored inline: a compound literal passed by value, with no constructor.
-- EXPECT-C-REGEX: (brp_ty[0-9A-Za-z]+) brp_vn?_[A-Za-z0-9]+ = \(\(\1\)\{ 1, 4 \}\);
-- EXPECT-C-REGEX: brp_vn?_[A-Za-z0-9]+\.f1 - brp_vn?_[A-Za-z0-9]+\.f0
-- EXPECT-NOT-C-REGEX: BLORP_INSTALL_(TAG|TYPE)\(__rec, [^)]*"Range"\)
import:
	range: length


pure func count_range() -> Int:
	r: Range = 1..4
	r.length()


func main(args: List[String]) -> Int:
	if count_range() == 3:
		0
	else:
		1
