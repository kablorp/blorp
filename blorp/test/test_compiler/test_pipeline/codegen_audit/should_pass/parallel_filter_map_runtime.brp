-- Generated-C shape audit for ParallelList.filter_map runtime lowering.
-- EXPECT-C: return ((blorp_List*)blorp_filter_map_parallel_int(
-- EXPECT-C: return ((blorp_List*)blorp_filter_map_parallel_nullable(
import:
	option: Option(Some, None)


pure func keep_even(x: Int) -> Option[Int]:
	if x % 2 == 0:
		Some(x * 2)
	else:
		None


pure func keep_word(word: String) -> Option[String]:
	if word.length() > 3:
		Some(word)
	else:
		None


pure func pair_even(x: Int) -> Option[(Int, Int)]:
	if x % 2 == 0:
		Some((x, x))
	else:
		None


func main(args: List[String]) -> Int:
	nums: List[Int] = [1, 2, 3, 4]
	words: List[String] = ["a", "pear", "plum"]
	ints: List[Int] = nums.parallel(pure func(chunk: ParallelList[Int]):
		chunk.filter_map(keep_even)
	)
	strings: List[String] = words.parallel(pure func(chunk: ParallelList[String]):
		chunk.filter_map(keep_word)
	)
	pairs: List[(Int, Int)] = nums.parallel(pure func(chunk: ParallelList[Int]):
		chunk.filter_map(pair_even)
	)
	ints.length() + strings.length() + pairs.length()
