-- Generated-C shape audit for list-spread @tail_recursive lowering when the final
-- tail position is reached through block-local bindings.
--
-- EXPECT-C: while (1) {
-- EXPECT-C: __tailrec_list_index
-- EXPECT-C: continue;
-- EXPECT-NOT-C: blorp_list_drop((blorp_List*)
-- Semantic callable expectation: sum_recursive(rest
-- EXPECT-NOT-C-REGEX: brp_[0-9A-Za-z]+\(rest
@tail_recursive
func sum_recursive(lst: List[Int], acc: Int) -> Int:
	bias: Int = 0
	match lst:
		[]: acc + bias
		[x, ...rest]: sum_recursive(rest, acc + x + bias)


func main(args: List[String]) -> Int:
	sum_recursive([1, 2, 3], 0)
