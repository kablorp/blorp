-- Regression: concrete Float vector dot products should use guarded raw
-- storage reads when both operands have packed Float storage, while retaining
-- the conservative runtime-safe fallback.
-- EXPECT-C: ->storage_mode == BLORP_VECTOR_STORAGE_F64 &&
-- EXPECT-C: ->elem_size == (int16_t)sizeof(double)
-- EXPECT-C: double* __tensor_a_raw = (double*)((blorp_Vector*)__tensor_a)->data
-- EXPECT-C: double* __tensor_b_raw = (double*)((blorp_Vector*)__tensor_b)->data
-- EXPECT-C: __tensor_a_raw[__i] * __tensor_b_raw[__i]
-- EXPECT-C: blorp_vector_read_f64((blorp_Vector*)__tensor_a, __i)
import:
	vector: dot


func main(args: List[String]) -> Int:
	a: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	b: Float[#4] = {5.0, 6.0, 7.0, 8.0}
	_ = dot(a, b)
	0
