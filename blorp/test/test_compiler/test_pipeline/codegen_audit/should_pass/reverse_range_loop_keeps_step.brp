-- Regression: reverse-capable ranges must keep the generic step loop.
-- EXPECT-C-REGEX: brp_vn?_[A-Za-z0-9]+ != __tp_
-- EXPECT-C-REGEX: brp_vn?_[A-Za-z0-9]+ \+= __tr_
-- EXPECT-NOT-C-REGEX: brp_vn?_[A-Za-z0-9]+ < __tp_
func main(args: List[String]) -> Int:
	var total: Int = 0
	for audit_i in 10..0:
		total += audit_i
	total
