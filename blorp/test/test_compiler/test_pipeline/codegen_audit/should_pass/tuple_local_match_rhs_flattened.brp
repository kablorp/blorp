-- A local tuple binding whose RHS is a match that returns tuples is flattened
-- when every reachable leaf returns the same tuple shape. The scrutinee is
-- bound once, while each scalar element stays explicit.
-- No generated tuple row survives this local-only shape.
-- EXPECT-NOT-C: "$blorp$tuple_storage$
-- EXPECT-C-REGEX: brp_vn_[0-9A-Za-z]+ =
-- Semantic callable expectation: mark(20)
-- EXPECT-C-REGEX: brp_[0-9A-Za-z]+\(20\)
-- Semantic callable expectation: mark(22)
-- EXPECT-C-REGEX: brp_[0-9A-Za-z]+\(22\)
func mark(x: Int) -> Int:
	x


func main(args: List[String]) -> Int:
	key: Int = 1

	pair: (Int, Int) = match key:
		0:
			(mark(1), mark(2))
		_:
			(mark(20), mark(22))

	if pair[0] + pair[1] == 42:
		0
	else:
		1
