-- Immediate tuple field access binds each element to a local instead of
-- allocating a tuple, still evaluating every element.
-- EXPECT-NOT-C: blorp_tuple_new(
-- EXPECT-C-REGEX: brp_vn_[0-9A-Za-z]+ =
-- Semantic callable expectation: mark(2)
-- EXPECT-C-REGEX: brp_[0-9A-Za-z]+\(2\)
func mark(x: Int) -> Int:
	x


func main(args: List[String]) -> Int:
	value: Int = (mark(40), mark(2))[0]

	if value == 40:
		0
	else:
		1
