-- A fixed record with a Bool field is not stored inline yet (Bool becomes
-- eligible with fixed unions), so it keeps the managed constructor.
--
-- EXPECT-C: /* Blorp final Core C artifact */
-- EXPECT-C-REGEX: _make\(1\.0, 
-- EXPECT-C-REGEX: ^  blorp_Object header;$
fixed record Flagged {
	x: Float,
	visible: Bool
}


func main(args: List[String]) -> Int:
	flagged: Flagged = {x = 1.0, visible = True}
	print(flagged.x)
	0
