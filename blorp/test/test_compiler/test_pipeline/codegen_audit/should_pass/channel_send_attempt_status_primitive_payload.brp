-- Status send helpers use the same void* runtime payload channel as send.
-- Primitive payloads cross that erased boundary as tagged immediate values.
-- EXPECT-C-REGEX: blorp_channel_try_send_status\(brp_vn?_[A-Za-z0-9]+, \(void\*\)\(long\)\(brp_vn?_[A-Za-z0-9]+\)\)
-- EXPECT-C-REGEX: blorp_channel_send_timeout_status\(brp_vn?_[A-Za-z0-9]+, \(void\*\)\(long\)\(brp_vn?_[A-Za-z0-9]+\), brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C: == BLORP_CHANNEL_SEND_ACCEPTED) {
-- EXPECT-C: == BLORP_CHANNEL_SEND_WOULD_BLOCK) {
-- EXPECT-C: == BLORP_CHANNEL_SEND_SEALED) {
-- EXPECT-NOT-C-REGEX: return blorp_channel_try_send_status\(brp_vn?_[A-Za-z0-9]+, brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-NOT-C-REGEX: return blorp_channel_send_timeout_status\(brp_vn?_[A-Za-z0-9]+, brp_vn?_[A-Za-z0-9]+, brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-NOT-C: __send_attempt_from_status
import:
	channel: SendAttempt(SendAccepted), send_timeout_attempt, try_send_attempt


func score_attempt(attempt: SendAttempt) -> Int:
	match attempt:
		SendAccepted:
			1
		_:
			0


func main(args: List[String]) -> Int:
	ch: Channel[Int] = channel(2)
	first: SendAttempt = try_send_attempt(ch, 7)
	second: SendAttempt = send_timeout_attempt(ch, 8, 1)
	score_attempt(first) + score_attempt(second)
