-- Generated-C shape audit for Stream.unfold result and state layout metadata.
-- EXPECT-C: void* __t0_0 = (void*)(long)(0);
-- EXPECT-C: long __t0_2 = 2;
-- EXPECT-C: long __t0_3 = 0;
-- EXPECT-C-REGEX: blorp_stream_unfold_product\(__t0_0, __t0_1, __t0_2, __t0_3, brp_ty[0-9A-Za-z]+_make_native_unfold_nullable\);
-- EXPECT-C-REGEX: blorp_String\* __t0_5 = brp_vn?_[A-Za-z0-9]+;
-- EXPECT-C: long __t0_7 = 2;
-- EXPECT-C: long __t0_8 = 2;
-- EXPECT-C-REGEX: blorp_stream_unfold_product\(__t0_5, __t0_6, __t0_7, __t0_8, brp_ty[0-9A-Za-z]+_make_native_unfold_nullable\);
-- The typed step transfers owned outputs before releasing its owned result pair.
-- EXPECT-C: blorp_retain(__product_field_0);  *value = (void*)__product_field_0;
-- EXPECT-C: *next_state = (void*)(long)(__product_field_1);
-- EXPECT-C: blorp_retain(__product_field_1);  *next_state = (void*)__product_field_1;
-- EXPECT-C: blorp_release(__pair);
import:
	option: Option(Some, None)
	stream: collect, unfold


func unfold_string_step(n: Int) -> Option[(String, Int)]:
	if n < 2:
		Some((n.to_string(), n + 1))
	else:
		None


func unfold_string_state_step(state: String) -> Option[(String, String)]:
	if state.length() < 3:
		Some((state, state + "a"))
	else:
		None


func main(args: List[String]) -> Int:
	scalar_state_items: List[String] = collect(unfold(0, unfold_string_step))
	seed: String = "a" + ""
	managed_state_items: List[String] = collect(unfold(seed, unfold_string_state_step))
	scalar_state_items.length() + managed_state_items.length()
