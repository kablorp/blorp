-- Keep the boxed Result cast and copy one native POD snapshot into an owned record.
-- EXPECT-C-REGEX: return blorp_stack_result_from_boxed\(\(blorp_Result\*\)blorp_read_file\(brp_vn?_[A-Za-z0-9]+\)\);
-- EXPECT-C: MemStats* MemStats_make(long total_allocations,
-- EXPECT-C: static inline MemStats* MemStats_make_native_snapshot(void) {
-- EXPECT-C: blorp_MemStats native = blorp_get_mem_stats();
-- EXPECT-C: return MemStats_make(native.total_allocations, native.total_releases, native.current_objects, native.bytes_allocated, native.bytes_available, native.allocator_bytes_in_use, native.allocator_bytes_available, native.backing_libc_malloc_events, native.raw_buffer_malloc_events, native.raw_buffer_calloc_events, native.raw_buffer_realloc_events, native.raw_buffer_aligned_events, native.cleanup_scratch_events, native.fiber_mmap_events, native.oracle_stats_active, native.memory_stats_active);
-- EXPECT-C: return MemStats_make_native_snapshot();
import:
	memory: get_mem_stats, mem_delta
	system: read_file


func main(args: List[String]) -> Int:
	before = get_mem_stats()
	after = get_mem_stats()
	_ = mem_delta(before, after)

	match read_file("/tmp/blorp_codegen_audit_missing_file"):
		Ok(_):
			1
		Err(_):
			0
