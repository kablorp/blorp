-- Numeric vector min/max specialization must select the element-specific
-- runtime helper at the production Core boundary.
-- EXPECT-C-REGEX: blorp_vector_max_float\(brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C-REGEX: blorp_vector_min_float\(brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C-REGEX: blorp_vector_max_float32\(brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C-REGEX: blorp_vector_min_float32\(brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C-REGEX: blorp_vector_max_float16\(brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C-REGEX: blorp_vector_min_float16\(brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C-REGEX: blorp_vector_max_int\(brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C-REGEX: blorp_vector_min_int\(brp_vn?_[A-Za-z0-9]+\)
import:
	float: to_float32
	vector: max, min


func main(args: List[String]):
	vf: Float[#3] = {1.5, 3.7, 2.1}
	v32: Float32[#3] = {to_float32(1.0), to_float32(5.0), to_float32(3.0)}
	v16: Float16[#3] = {to_float16(1.0), to_float16(4.0), to_float16(2.0)}
	vi: Int[#3] = {1, 6, 3}
	_ = max(vf) == 3.7
	_ = min(vf) == 1.5
	_ = max(v32) == to_float32(5.0)
	_ = min(v32) == to_float32(1.0)
	_ = max(v16) == to_float16(4.0)
	_ = min(v16) == to_float16(1.0)
	_ = max(vi) == 6
	_ = min(vi) == 1
