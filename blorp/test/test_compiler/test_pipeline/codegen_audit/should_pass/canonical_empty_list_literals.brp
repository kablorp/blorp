-- Empty literals use one immortal object per runtime layout. Explicit list
-- allocation and nonempty construction remain ordinary allocation paths.
--
-- EXPECT-C: } __blorp_canonical_empty_list_inline_8 = {
-- EXPECT-C: } __blorp_canonical_empty_list_pointer_managed = {
-- EXPECT-C: return (blorp_List*)&__blorp_canonical_empty_list_inline_8;
-- EXPECT-C: return (blorp_List*)&__blorp_canonical_empty_list_pointer_managed;
-- Pair uses the same managed pointer singleton as String, not an inline product singleton.
-- EXPECT-C: static blorp_List* EMPTY_PAIRS = (blorp_List*)&__blorp_canonical_empty_list_pointer_managed;
-- EXPECT-C: static blorp_List* EMPTY_STRINGS = (blorp_List*)&__blorp_canonical_empty_list_pointer_managed;
-- EXPECT-NOT-C: __blorp_canonical_empty_list_struct_
-- EXPECT-C: static blorp_List* EMPTY_INTS = (blorp_List*)&__blorp_canonical_empty_list_inline_8;
-- EXPECT-C: blorp_list_new_inline(1, 8)
-- EXPECT-NOT-C: blorp_list_new(0)
-- EXPECT-NOT-C: blorp_list_new_inline(0,
-- EXPECT-NOT-C: __blorp_static_list_EMPTY_INTS
import:
	list: List, append
	memory: same_object


fixed record Pair {
	left: Int,
	right: Int
}


EMPTY_INTS: List[Int] = []


EMPTY_PAIRS: List[Pair] = []


EMPTY_STRINGS: List[String] = []


pure func empty_ints() -> List[Int]:
	[]


pure func empty_ints_again() -> List[Int]:
	[]


pure func empty_strings() -> List[String]:
	[]


pure func empty_pairs() -> List[Pair]:
	[]


pure func nonempty_ints() -> List[Int]:
	[1]


func main(args: List[String]) -> Int:
	var values: List[Int] = empty_ints()
	values = values.append(42)
	-- Internal representation oracle, not a source-level immortal identity promise.
	managed_pool: Bool = same_object(empty_pairs(), EMPTY_PAIRS) and same_object(empty_strings(), EMPTY_STRINGS)
	var appended_value: Int = 0
	for value in values:
		appended_value += value
	if (
		managed_pool and values.length() == 1 and appended_value == 42
		and empty_ints_again().length() == 0
		and empty_strings().length() == 0
		and empty_pairs().length() == 0
		and nonempty_ints().length() == 1
	):
		0
	else:
		1
