-- Managed record payloads use erased pointers with owned-field cleanup.
-- A separate genuinely scalar enum/Int union retains typed payload storage.
-- EXPECT-C-REGEX: typedef struct [A-Za-z0-9_]+ \{
-- EXPECT-C: struct { void* field0; void* field1; } Circle;
-- EXPECT-C: struct { void* field0; void* field1; } Tagged;
-- EXPECT-C: struct { long field0; long field1; } ScalarTagged;
-- EXPECT-C-REGEX: brp_c_[A-Za-z0-9]+\(\(void\*\)brp_ty[A-Za-z0-9]+_make\(1\.0, 2\.0\), blorp_box_float\(3\.0\), 1UL\)
-- EXPECT-C-REGEX: if \(\(self->release_mask & 1UL\) && self->data\.Circle\.field0\) blorp_release\(self->data\.Circle\.field0\);
-- EXPECT-C-REGEX: static inline [A-Za-z0-9_]+\* __blorp_reuse_Shape_brp_c_[A-Za-z0-9]+\([A-Za-z0-9_]+\* __old, void\* field0, void\* field1, unsigned long release_mask\)
-- EXPECT-C: __old->release_mask = release_mask;
-- EXPECT-NOT-C: blorp_box_struct
fixed record Vec2 {
	x: Float,
	y: Float
}


enum Color:
	Red
	Green
	Blue


union Shape:
	Circle(Vec2, Float)
	Tagged(Color, Int)


union ScalarTag:
	ScalarTagged(Color, Int)


pure func scalar_score(value: ScalarTag) -> Int:
	match value:
		ScalarTagged(color, count):
			if color == Green:
				count
			else:
				0


func area(shape: Shape) -> Float:
	match shape:
		Circle(_, radius):
			radius * radius
		Tagged(_, n):
			n.to_float()


func main(args: List[String]) -> Int:
	shapes: List[Shape] = [
		Circle({ x = 1.0, y = 2.0 }, 3.0),
		Tagged(Green, 4),
	]
	var total: Float = 0.0

	for shape in shapes:
		total = total + area(shape)

	if total > 0.0 and scalar_score(ScalarTagged(Green, 4)) == 4:
		0
	else:
		1
