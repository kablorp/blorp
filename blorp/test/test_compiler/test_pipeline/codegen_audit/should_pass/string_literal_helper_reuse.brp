-- Passing one literal several times must share one statically initialized object.
-- It must not allocate or emit the old cached-literal assignment shape.
-- EXPECT-C: BLORP_STATIC_STRING(__blorp_string_literal_0, 1L, "\n");
-- EXPECT-C: ((blorp_String*)&__blorp_string_literal_0, (blorp_String*)&__blorp_string_literal_0, (blorp_String*)&__blorp_string_literal_0)
-- EXPECT-NOT-C: blorp_string_create("\n")
-- EXPECT-NOT-C: (__sl_0 ? __sl_0 : (__sl_0 = blorp_string_create
func same(a: String, b: String, c: String) -> Bool:
	a == b and b == c


func main(args: List[String]) -> Int:
	if same("\n", "\n", "\n"):
		0
	else:
		1
