-- EXPECT-C-REGEX: blorp_task_cleanup_push_with_task\(&__blorp_cleanup_brp_vn?_[A-Za-z0-9]+, &brp_vn?_[A-Za-z0-9]+, \(void\*\)brp_vn?_[A-Za-z0-9]+, \(blorp_CancelCleanupFn\)blorp_file_close_reader, __blorp_task\);
-- EXPECT-C-REGEX: blorp_task_cleanup_pop_slot_with_task\(&brp_vn?_[A-Za-z0-9]+, __blorp_task\);
-- EXPECT-C-REGEX: \(void\)\(blorp_file_close_reader\(brp_vn?_[A-Za-z0-9]+\)\);
import:
	fs: IOError, open_read


func hold_reader_until_cancel(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		sleep(1000)
		Ok(1)


func main(args: List[String]) -> Int:
	_ = hold_reader_until_cancel("")
	0
