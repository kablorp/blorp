-- EXPECT-C-REGEX: \(void\)\(blorp_file_close_writer\(brp_vn?_[A-Za-z0-9]+\)\);
-- EXPECT-C-REGEX: \(void\)\(blorp_file_close_read_writer\(brp_vn?_[A-Za-z0-9]+\)\);
import:
	fs: IOError, open_read_write, open_write


func write_open(path: String) -> Result[Int, IOError]:
	with writer ?= open_write(path):
		Ok(1)


func read_write_open(path: String) -> Result[Int, IOError]:
	with file ?= open_read_write(path):
		Ok(1)


func main(args: List[String]) -> Int:
	_ = write_open("")
	_ = read_write_open("")
	0
