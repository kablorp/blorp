-- Generated-C shape audit for inline bool ParallelList results.
-- EXPECT-C-REGEX: return \(\(blorp_List\*\)blorp_map_parallel\(brp_vn?_[A-Za-z0-9]+, brp_vn?_[A-Za-z0-9]+, 0, BLORP_LIST_STORAGE_INLINE, 1, BLORP_LIST_CALLBACK_BITS\)\);
-- EXPECT-C-REGEX: return \(\(blorp_List\*\)blorp_filter_map_parallel_bool\(brp_vn?_[A-Za-z0-9]+, brp_vn?_[A-Za-z0-9]+, 0, BLORP_LIST_STORAGE_INLINE, 1, BLORP_LIST_CALLBACK_BITS\)\);
func main(args: List[String]) -> Int:
	flags: List[Bool] = [False, True, False]
	mapped: List[Bool] = flags.parallel(
		pure func(chunk: ParallelList[Bool]): chunk.map(pure func(x: Bool): x),
	)
	kept: List[Bool] = flags.parallel(pure func(chunk: ParallelList[Bool]):
		chunk.filter_map(pure func(x: Bool) -> Option[Bool]:
			if x:
				Some(x)
			else:
				None
		)
	)

	if mapped.get_or(1, False) and kept.get_or(0, False):
		0
	else:
		1
