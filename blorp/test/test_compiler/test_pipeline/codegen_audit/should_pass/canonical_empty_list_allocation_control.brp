-- Explicit zero-capacity allocation remains an ordinary allocation path.
-- EXPECT-C: return blorp_list_new_inline(0, 8);
-- EXPECT-NOT-C: __blorp_canonical_empty_list_
import:
	list: List, list


pure func explicit_empty_allocation() -> List[Int]:
	list(0)


func main(args: List[String]) -> Int:
	explicit_empty_allocation().length()
