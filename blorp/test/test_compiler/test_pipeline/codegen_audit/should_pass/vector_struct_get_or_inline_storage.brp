-- Managed record get_or retains a checked pointer or returns the owned default.
-- EXPECT-C: blorp_vector_get_nullable(
-- EXPECT-C-REGEX: brp_ty1\* brp_vn?_[A-Za-z0-9]+ = brp_ty1_make\(0, 0\);
-- EXPECT-C: blorp_retain(brp_vn_4);
-- EXPECT-C: blorp_release(brp_vn_3);
-- EXPECT-C: __tn_1 = brp_vn_3;
-- EXPECT-NOT-C: memcpy(&__tgu_out_
-- EXPECT-NOT-C: __gso_payload_
import:
	tensor: get_or


fixed record Point {
	x: Int,
	y: Int
}


func read_vector(v: Point[#3]) -> Point:
	v.get_or(1, {
			x = 0,
			y = 0
		})


func main(args: List[String]) -> Int:
	v: Point[#3] = {{
			x = 1,
			y = 10
		}, {
			x = 2,
			y = 20
		}, {
			x = 3,
			y = 30
		}}
	p: Point = read_vector(v)
	if p.x == 2 and p.y == 20:
		0
	else:
		1
