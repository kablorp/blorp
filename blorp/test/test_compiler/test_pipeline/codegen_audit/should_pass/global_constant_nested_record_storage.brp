-- Closed literal globals keep their nested static objects through product
-- evaluation normalization; only local field evaluations acquire Let owners.
-- EXPECT-C-REGEX: __blorp_static_list_NESTED_f0_f1 = \{
-- EXPECT-C-REGEX: static [A-Za-z0-9_]+ __blorp_static_record_NESTED_f0 = \{
-- EXPECT-C-REGEX: static [A-Za-z0-9_]+ __blorp_static_record_NESTED = \{
-- EXPECT-C: .f1 = 7L
-- EXPECT-NOT-C: NESTED = ({
record Inner {
	count: Int,
	values: List[Int]
}


record Outer {
	inner: Inner,
	tag: Int
}


NESTED: Outer = {
	tag = 7,
	inner = { values = [3, 5], count = 2 }
}


func main(args: List[String]) -> Int:
	print((NESTED.inner.count + NESTED.inner.values.length() + NESTED.tag).to_string())
	0
