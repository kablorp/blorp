-- A literal written out of declaration order can reuse a dropped record of its
-- type: its fields are evaluated in written order (`second` into the first
-- temporary) and passed to the reuse helper by declared position.
-- EXPECT-C-REGEX: __blorp_reuse_record_brp_ty[0-9A-Za-z]+\(brp_v_[0-9A-Za-z]+, __t[0-9]+_1, __t[0-9]+_0\)
record Pair {
	first: String,
	second: String
}


func make(n: Int) -> Pair:
	{
		first = "a" + n.to_string(),
		second = "b" + n.to_string()
	}


func rebuild(n: Int) -> Pair:
	pair: Pair = make(n)
	{
		second = "second " + n.to_string(),
		first = pair.first
	}


func main(args: List[String]) -> Int:
	rebuilt: Pair = rebuild(args.length())
	print(rebuilt.first)
	print(rebuilt.second)
	0
