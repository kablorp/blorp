-- Regression: Int tensor updates should pass primitive i64 values to typed
-- COW setters instead of boxing through erased void* storage.
-- EXPECT-C: blorp_vector_set_cow_nullable_i64
-- EXPECT-C: blorp_matrix_checked_set_i64
import:
	tensor: matrix, set_index


func main(args: List[String]) -> Int:
	v: Int[#3] = {1, 2, 3}
	updated: Int[#3] = match v.set_index(1, 9):
		Some(next): next
		None: v
	var m: Int[#2, #2] = matrix(0, 2, 2)
	m[1, 1] = 7
	updated[1] + m[1, 1]
