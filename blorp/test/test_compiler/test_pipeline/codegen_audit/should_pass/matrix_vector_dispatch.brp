-- Matrix/vector helpers should resolve through specialization sentinels.
-- EXPECT-C: blorp_tensor_matrix_vector_multiply_int(
-- EXPECT-C: blorp_tensor_transposed_matrix_vector_multiply_int(
-- EXPECT-C: blorp_tensor_outer_float32(
-- EXPECT-NOT-C: blorp_tensor_matrix_vector_multiply(
-- EXPECT-NOT-C: blorp_tensor_transposed_matrix_vector_multiply(
-- EXPECT-NOT-C: blorp_tensor_outer(
import:
	matrix: multiply_transposed_vector, multiply_vector, outer


func main(args: List[String]) -> Int:
	w: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	x: Int[#2] = {10, 20}
	y: Int[#2] = multiply_vector(w, x)

	wt: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	yt: Int[#3] = multiply_transposed_vector(wt, x)

	a: Float32[#2] = {to_float32(2), to_float32(3)}
	b: Float32[#3] = {to_float32(4), to_float32(5), to_float32(6)}
	o: Float32[#2, #3] = outer(a, b)

	if (
		y[0] == 50
		and yt[2] == 150
		and o[1, 2] == to_float32(18)
	):
		0
	else:
		1
