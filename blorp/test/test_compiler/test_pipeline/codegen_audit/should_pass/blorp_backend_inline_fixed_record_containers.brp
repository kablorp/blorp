-- Inline records keep their by-value storage in containers that have a struct
-- family: list elements are stored inline in the list buffer, and an Option of
-- an inline record is a stack Option holding the struct.
--
-- EXPECT-C: /* Blorp final Core C artifact */
-- EXPECT-C-REGEX: blorp_list_new_inline\(2, sizeof\(brp_ty[0-9]+\)\)
-- EXPECT-C-REGEX: ^typedef struct \{ int tag; brp_ty[0-9]+ value; \} blorp_StackOption_brp_ty[0-9]+;$
-- EXPECT-C-REGEX: ^static blorp_StackOption_brp_ty[0-9]+ brp_[A-Za-z0-9]+\(blorp_List\* brp_v_[A-Za-z0-9]+\)
-- EXPECT-NOT-C-REGEX: _make\([0-9]+\.[0-9]+,
fixed record Point {
	x: Float,
	y: Float
}


pure func first_point(points: List[Point]) -> Option[Point]:
	match points:
		[first, ..._]:
			Some(first)
		[]:
			None


func main(args: List[String]) -> Int:
	points: List[Point] = [{x = 1.0, y = 2.0}, {x = 3.0, y = 4.0}]

	match first_point(points):
		Some(point):
			print(point.x)
		None:
			print(0.0)
	0
