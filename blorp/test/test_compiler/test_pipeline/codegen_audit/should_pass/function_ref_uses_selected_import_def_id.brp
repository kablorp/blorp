-- First-class references to imported functions must keep the selected callable
-- identity. A bare `sqrt` reference imported from float should not be captured
-- as vector.sqrt just because vector also exports a builtin named sqrt.
-- Semantic callable expectation: float__sqrt(__eta_arg_0)
-- EXPECT-C-REGEX: brp_[0-9A-Za-z]+\(__eta_arg_0\)
-- EXPECT-NOT-C: blorp_vector_sqrt(__eta_arg_0)
import:
	float: sqrt
	list: parallel


pure func roots(nums: List[Float]) -> List[Float]:
	nums.parallel(func(items):
		items.map(sqrt)
	)


func float_sqrt_reference_is_correct() -> Bool:
	values: List[Float] = roots([4.0, 9.0, 16.0])
	values.get_or(0, 0.0) == 2.0 and values.get_or(1, 0.0) == 3.0 and values.get_or(2, 0.0) == 4.0


func main(args: List[String]) -> Int:
	if float_sqrt_reference_is_correct():
		0
	else:
		1
