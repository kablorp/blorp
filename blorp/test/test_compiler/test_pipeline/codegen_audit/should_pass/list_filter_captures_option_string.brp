-- A closure that captures nullable managed Option payloads inside a generic
-- List.filter predicate must lower through closure conversion, emit valid C,
-- and release the closure environment after callback use.
-- EXPECT-C: /* Blorp final Core C artifact */
-- EXPECT-C: __cl->func
-- EXPECT-C: blorp_retain
-- EXPECT-C: blorp_release
import:
	list: List, filter, get
	option: Option(Some, None)


record Candidate {
	name: String,
	module_path: Option[String]
}


record Group {
	label: String,
	values: Option[List[Int]]
}


pure func matching_module(
	candidates: List[Candidate],
	selected_module_path: Option[String],
) -> List[Candidate]:
	filter(candidates, func(candidate: Candidate): candidate.module_path == selected_module_path)


pure func list_is_one_two(values: List[Int]) -> Bool:
	values.length() == 2 and get(values, 0).get_or(0) == 1 and get(values, 1).get_or(0) == 2


pure func group_matches_selected_some(values: Option[List[Int]], selected: List[Int]) -> Bool:
	if list_is_one_two(selected):
		match values:
			Some(group_values):
				list_is_one_two(group_values)
			None:
				False
	else:
		False


pure func group_matches_selected_none(values: Option[List[Int]]) -> Bool:
	match values:
		Some(group_values):
			False
		None:
			True


pure func matching_group(groups: List[Group], selected_values: Option[List[Int]]) -> List[Group]:
	filter(groups, func(group: Group):
		match selected_values:
			Some(selected):
				group_matches_selected_some(group.values, selected)
			None:
				group_matches_selected_none(group.values)
	)


pure func matches_module_capture_some(candidates: List[Candidate]) -> Bool:
	matches: List[Candidate] = matching_module(candidates, Some("demo"))
	matches.length() == 1 and match get(matches, 0):
		Some(candidate):
			candidate.name == "imported"
		None:
			False


pure func matches_module_capture_none(candidates: List[Candidate]) -> Bool:
	matches: List[Candidate] = matching_module(candidates, None)
	matches.length() == 1 and match get(matches, 0):
		Some(candidate):
			candidate.name == "local"
		None:
			False


pure func matches_group_capture_some(groups: List[Group]) -> Bool:
	matches: List[Group] = matching_group(groups, Some([1, 2]))
	matches.length() == 1 and match get(matches, 0):
		Some(group):
			group.label == "two"
		None:
			False


pure func matches_group_capture_none(groups: List[Group]) -> Bool:
	matches: List[Group] = matching_group(groups, None)
	matches.length() == 1 and match get(matches, 0):
		Some(group):
			group.label == "empty"
		None:
			False


func main(args: List[String]) -> Int:
	candidates: List[Candidate] = [
		{
			name = "local",
			module_path = None
		},
		{
			name = "imported",
			module_path = Some("demo")
		},
	]
	groups: List[Group] = [
		{
			label = "empty",
			values = None
		},
		{
			label = "two",
			values = Some([1, 2])
		},
	]

	if (
		matches_module_capture_some(candidates)
		and matches_module_capture_none(candidates)
		and matches_group_capture_some(groups)
		and matches_group_capture_none(groups)
	):
		0
	else:
		1
