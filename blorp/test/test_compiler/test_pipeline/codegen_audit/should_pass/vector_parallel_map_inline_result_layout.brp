-- Parallel map retains owned managed record callback results in pointer storage.
-- EXPECT-C: blorp_vmap_indexed_parallel(
-- EXPECT-C: BLORP_VECTOR_STORAGE_POINTER, sizeof(void*), BLORP_VECTOR_CALLBACK_BITS
-- EXPECT-C: brp_ty1* brp_ty1_make(double f0, double f1, double f2)
-- EXPECT-NOT-C: BLORP_VECTOR_CALLBACK_BOXED_STRUCT
import:
	tensor: get_or
	vector: ParallelVector, parallel


record Accel {
	x: Float,
	y: Float,
	z: Float
}


ZERO_ACCEL: Accel = {
	x = 0.0,
	y = 0.0,
	z = 0.0
}


func main(args: List[String]) -> Int:
	values: Float[#4] = vector(1.0, 4)
	accel: Accel[#4] = values.parallel(pure func(chunk: ParallelVector[Float, #4]):
		chunk.map_indexed(pure func(i: ..#4, value: Float) -> Accel: {
				x = value + to_float(i),
				y = value,
				z = 0.0
			})
	)
	sample: Accel = get_or(accel, 2, ZERO_ACCEL)
	if sample.x > 2.9:
		0
	else:
		1
