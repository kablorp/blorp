-- String concatenation should stay on the Blorp final-Core-to-C backend when
-- lowered to the direct runtime concat builtin.
--
-- EXPECT-C: /* Blorp final Core C artifact */
-- Semantic callable expectation: blorp_String* join_name(blorp_String* name)
-- EXPECT-C-REGEX: blorp_String\* brp_[0-9A-Za-z]+\(blorp_String\* brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C: BLORP_STATIC_STRING(__blorp_string_literal_0, 7L, "hello, ");
-- EXPECT-C: BLORP_STATIC_STRING(__blorp_string_literal_1, 5L, "blorp");
-- EXPECT-C-REGEX: blorp_string_concat\(\(blorp_String\*\)&__blorp_string_literal_0, brp_vn?_[A-Za-z0-9]+\)
-- Semantic callable expectation: join_name((blorp_String*)&__blorp_string_literal_1)
-- EXPECT-C-REGEX: brp_[0-9A-Za-z]+\(\(blorp_String\*\)&__blorp_string_literal_1\)
-- EXPECT-C-REGEX: blorp_release\(brp_vn?_[A-Za-z0-9]+\);
-- EXPECT-NOT-C: blorp_string_create("hello, ")
-- EXPECT-NOT-C: blorp_string_create("blorp")
pure func join_name(name: String) -> String:
	"hello, " + name


func main(args: List[String]) -> Int:
	message: String = join_name("blorp")
	0
