-- Ordinary and fixed records use the same managed header/pointer ownership.
-- EXPECT-C: brp_ty1* brp_ty1_make(long f0, long f1)
-- EXPECT-C: brp_ty2* brp_ty2_make(long f0, long f1)
-- EXPECT-C: brp_ty1* __rec = (brp_ty1*)blorp_alloc(sizeof(brp_ty1));
-- EXPECT-C: brp_ty2* __rec = (brp_ty2*)blorp_alloc(sizeof(brp_ty2));
-- EXPECT-C: brp_ty3* brp_ty3_make(long f0)
-- EXPECT-C: brp_ty5* brp_ty5_make(long f0)
-- EXPECT-C: brp_ty4* brp_ty4_make(brp_ty3* f0, long f1)
-- EXPECT-C: brp_ty6* brp_ty6_make(brp_ty5* f0, long f1)
-- EXPECT-C: BLORP_INSTALL_TYPE(__rec, brp_ty4_destroy, "LegacyOuter");
-- EXPECT-C: BLORP_INSTALL_TYPE(__rec, brp_ty6_destroy, "FixedOuter");
-- EXPECT-C: if (__rec->f0) blorp_release((blorp_Object*)__rec->f0);
record LegacyPoint {x: Int, y: Int}
fixed record FixedRecordPoint {x: Int, y: Int}
record LegacyInner {value: Int}
record LegacyOuter {inner: LegacyInner, other: Int}
fixed record FixedInner {value: Int}
fixed record FixedOuter {inner: FixedInner, other: Int}


pure func legacy_sum(value: Int) -> Int:
	point: LegacyPoint = {x = value, y = 3}
	updated: LegacyPoint = {point | x = point.x + 4}
	updated.x + updated.y


pure func fixed_sum(value: Int) -> Int:
	point: FixedRecordPoint = {x = value, y = 3}
	updated: FixedRecordPoint = {point | x = point.x + 4}
	updated.x + updated.y


pure func legacy_nested_sum(value: Int) -> Int:
	inner: LegacyInner = {value = value}
	point: LegacyOuter = {inner = inner, other = 3}
	updated: LegacyOuter = {point | other = point.other + 4}
	updated.inner.value + updated.other


pure func fixed_nested_sum(value: Int) -> Int:
	inner: FixedInner = {value = value}
	point: FixedOuter = {inner = inner, other = 3}
	updated: FixedOuter = {point | other = point.other + 4}
	updated.inner.value + updated.other


func main(args: List[String]) -> Int:
	if legacy_sum(2) == fixed_sum(2) and legacy_nested_sum(2) == fixed_nested_sum(2):
		0
	else:
		1
