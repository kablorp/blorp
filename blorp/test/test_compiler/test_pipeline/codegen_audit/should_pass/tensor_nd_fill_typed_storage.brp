-- Regression: compiler-owned 3D+ tensor fill factories should allocate
-- storage from the static element type instead of falling back to generic
-- pointer vectors.
--
-- EXPECT-C: blorp_tensor_new_i64(
-- EXPECT-C: blorp_tensor_new_f64(
-- EXPECT-C: blorp_tensor_new_f32(
-- EXPECT-C: long* __tensor_fill_raw_
-- EXPECT-C: double* __tensor_fill_raw_
-- EXPECT-C: float* __tensor_fill_raw_
-- EXPECT-NOT-C: blorp_tensor3_new(
-- EXPECT-NOT-C: blorp_tensor4_new(
-- EXPECT-NOT-C: blorp_tensor5_new(
import:
	float: to_float32


func main(args: List[String]) -> Int:
	ints: Int[#2, #3, #4] = tensor3(7, 2, 3, 4)
	floats: Float[#2, #2, #2, #2] = tensor4(1.5, 2, 2, 2, 2)
	floats32: Float32[#2, #2, #2, #2, #2] = tensor5(to_float32(2.5), 2, 2, 2, 2, 2)
	if (
		ints.length() == 2
		and floats.length() == 2
		and floats32.length() == 2
	):
		0
	else:
		1
