-- EXPECT-C-REGEX: blorp_task_cleanup_push_with_task\(&__blorp_cleanup_brp_vn?_[A-Za-z0-9]+, &brp_vn?_[A-Za-z0-9]+, \(void\*\)brp_vn?_[A-Za-z0-9]+, blorp_cleanup_release_arc_only_value, __blorp_task\);
-- EXPECT-C-REGEX: blorp_task_cleanup_push_with_task\(&__blorp_cleanup_brp_vn?_[A-Za-z0-9]+, &brp_vn?_[A-Za-z0-9]+, \(void\*\)brp_vn?_[A-Za-z0-9]+, \(blorp_CancelCleanupFn\)blorp_tcp_close_listener, __blorp_task\);
-- EXPECT-C-REGEX: blorp_task_cleanup_push_with_task\(&__blorp_cleanup_brp_vn?_[A-Za-z0-9]+, &brp_vn?_[A-Za-z0-9]+, \(void\*\)brp_vn?_[A-Za-z0-9]+, \(blorp_CancelCleanupFn\)blorp_tcp_close_stream, __blorp_task\);
-- EXPECT-C-REGEX: blorp_task_cleanup_push_with_task\(&__blorp_cleanup_brp_vn?_[A-Za-z0-9]+, &brp_vn?_[A-Za-z0-9]+, \(void\*\)brp_vn?_[A-Za-z0-9]+, \(blorp_CancelCleanupFn\)blorp_tcp_close_stream, __blorp_task\);
-- EXPECT-C-REGEX: blorp_tcp_read_raw\(brp_vn?_[A-Za-z0-9]+, brp_vn?_[A-Za-z0-9]+\)
-- Semantic callable expectation: net_tcp__read_chunk(peer, 64)
-- EXPECT-C-REGEX: brp_[0-9A-Za-z]+\(brp_vn?_[A-Za-z0-9]+, 64\)
-- EXPECT-C-REGEX: blorp_task_cleanup_pop_slot_with_task\(&brp_vn?_[A-Za-z0-9]+, __blorp_task\);
-- EXPECT-C-REGEX: \(void\)\(blorp_tcp_close_stream\(brp_vn?_[A-Za-z0-9]+\)\);
import:
	net/tcp:
		IpFamily(IPv4),
		TcpError,
		accept,
		connect_loopback,
		listen_loopback_any_port,
		local_port,
		port,
		read_chunk,


func probe() -> Result[Int, TcpError]:
	marker: String = "tcp-" + "read"

	with listener ?= listen_loopback_any_port(IPv4, 1):
		port_num ?= local_port(listener)
		remote ?= port(port_num)

		with client ?= connect_loopback(IPv4, remote):
			with peer ?= accept(listener):
				data ?= read_chunk(peer, 64)

				if marker == "tcp-read":
					Ok(data.length())
				else:
					Ok(-1)


func main(args: List[String]) -> Int:
	match probe():
		Ok(value):
			value
		Err(_):
			1
