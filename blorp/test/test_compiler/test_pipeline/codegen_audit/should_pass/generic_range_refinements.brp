-- Regression: range-refined loop indices erase to Int for generic
-- monomorphization. Qualified module calls and UFCS calls should both compile.
--
-- EXPECT: no line > 2000 chars
import:
	dict as D
	list as L


func main(args: List[String]) -> Int:
	var scores: Dict[Int, Int] = D.dict()
	var pairs: List[(Int, Int)] = []
	var total: Int = 0
	for i in 0..10:
		scores = D.set(scores, i, i + 1)
		from_qualified: Int = D.get_or(scores, i, 0)
		from_ufcs: Int = scores.get_or(i, 0)
		pairs = L.append(pairs, (i, from_qualified + from_ufcs))
		total += from_qualified
	total + L.length(pairs)
