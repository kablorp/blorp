-- A fixed record of numbers is a by-value C struct: built with a compound
-- literal, nested by value, read with `.`, updated as a plain copy, and passed
-- and returned by value. It has no constructor, no allocation, no reference
-- count and no copy-on-write check.
--
-- EXPECT-C: /* Blorp final Core C artifact */
-- EXPECT-C-REGEX: ^  brp_ty[0-9]+ f0;$
-- EXPECT-C-REGEX: \(\(brp_ty[0-9]+\)\{ 0\.0, 0\.0 \}\)
-- EXPECT-C-REGEX: \.f1\.f0
-- EXPECT-C-REGEX: ^static brp_ty[0-9]+ brp_[A-Za-z0-9]+\(brp_ty[0-9]+ brp_v_[A-Za-z0-9]+, double brp_v_[A-Za-z0-9]+\)
-- EXPECT-NOT-C-REGEX: ^  brp_ty[0-9]+\* f[0-9]+;$
-- EXPECT-NOT-C-REGEX: _make\(double
-- EXPECT-NOT-C-REGEX: _make\([0-9]+\.[0-9]+,
-- EXPECT-NOT-C-REGEX: blorp_is_unique\(__tt_
-- EXPECT-NOT-C-REGEX: __blorp_reuse_record_brp_ty[0-9]+\(brp_v_
fixed record Point {
	x: Float,
	y: Float
}


fixed record Segment {
	start: Point,
	finish: Point
}


pure func moved_finish(segment: Segment, dx: Float) -> Segment:
	{ segment | finish = { segment.finish | x = segment.finish.x + dx } }


pure func span(segment: Segment) -> Float:
	segment.finish.x - segment.start.x


func main(args: List[String]) -> Int:
	segment: Segment = {start = {x = 0.0, y = 0.0}, finish = {x = 3.0, y = 4.0}}
	moved: Segment = moved_finish(segment, 2.0)
	print(span(moved))
	0
