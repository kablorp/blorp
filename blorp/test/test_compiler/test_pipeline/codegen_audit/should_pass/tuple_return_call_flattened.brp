-- A tuple returned from a small monomorphic tuple-factory function and used
-- only through fields or tuple matches is expanded at the call site.
-- Eliminated factory signatures retain an unused row declaration. The observed
-- row constructor may only have its declaration and formal forwarding helper;
-- no executable call with locals, staged temporaries or scalar operands remains.
-- EXPECT-C: brp_ty1* brp_ty1_make(long f0, long f1)
-- EXPECT-NOT-C-REGEX: brp_ty1_make\((brp_v|__t|[0-9(])
-- EXPECT-NOT-C-REGEX: brp_ty1\* brp_v[^ ]+ =
-- EXPECT-C-REGEX: brp_vn_[0-9A-Za-z]+ =
-- Semantic callable expectation: swap(1L, 2L)
-- EXPECT-NOT-C-REGEX: brp_[0-9A-Za-z]+\(1L, 2L\)
-- Semantic callable expectation: swap(3L, 4L)
-- EXPECT-NOT-C-REGEX: brp_[0-9A-Za-z]+\(3L, 4L\)
-- Semantic callable expectation: swap(5L, 6L)
-- EXPECT-NOT-C-REGEX: brp_[0-9A-Za-z]+\(5L, 6L\)
-- Semantic callable expectation: pair_expr(2L, 3L)
-- EXPECT-NOT-C-REGEX: brp_[0-9A-Za-z]+\(2L, 3L\)
-- Semantic callable expectation: pair_locals(2L, 3L)
-- EXPECT-NOT-C-REGEX: brp_[0-9A-Za-z]+\(2L, 3L\)
-- Semantic callable expectation: choose_pair(true, 2L, 3L)
-- EXPECT-NOT-C-REGEX: brp_[0-9A-Za-z]+\(true, 2L, 3L\)
func swap(a: Int, b: Int) -> (Int, Int):
	result: (Int, Int) = (b, a)
	result


func pair_expr(a: Int, b: Int) -> (Int, Int):
	(a + 1, b * 2)


func pair_locals(a: Int, b: Int) -> (Int, Int):
	x: Int = a + 1
	y: Int = b * 2
	(x, y)


func choose_pair(use_swap: Bool, a: Int, b: Int) -> (Int, Int):
	if use_swap:
		(b, a)
	else:
		(a, b)


func main(args: List[String]) -> Int:
	p: (Int, Int) = swap(1, 2)
	direct: Int = swap(3, 4)[0]

	matched: Int = match swap(5, 6):
		(x, y):
			x + y

	expr: (Int, Int) = pair_expr(2, 3)
	locals: (Int, Int) = pair_locals(2, 3)
	chosen: (Int, Int) = choose_pair(True, 2, 3)

	if (
		p[0] == 2
		and p[1] == 1
		and direct == 4
		and matched == 11
		and expr[0] == 3
		and expr[1] == 6
		and locals[0] == 3
		and locals[1] == 6
		and chosen[0] == 3
		and chosen[1] == 2
	):
		0
	else:
		1
