-- A match subject with literal patterns on one element and constructor
-- patterns with payloads on the other: each payload is read in the case of
-- its own element's test, and no tuple is allocated.
-- No generated tuple row survives this local-only shape.
-- EXPECT-NOT-C: "$blorp$tuple_storage$
union Shape:
	Circle(Int)
	Square(Int)
	Empty


pure func classify(code: Int, shape: Shape) -> Int:
	match (code, shape):
		(0, Circle(radius)):
			radius
		(0, _):
			1
		(1, Square(side)):
			side + 2
		_:
			3


func main(args: List[String]) -> Int:
	if classify(0, Circle(7)) == 7 and classify(1, Square(1)) == 3 and classify(2, Empty) == 3:
		0
	else:
		1
