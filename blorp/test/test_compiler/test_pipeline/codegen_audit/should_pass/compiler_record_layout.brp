-- EXPECT-C: blorp_layout_foreign_mixed_fields(
-- EXPECT-C-REGEX: typedef struct [A-Za-z0-9_]+ \{
-- EXPECT-C-REGEX: blorp_String\* f[0-9]+;
-- EXPECT-C-REGEX: _Bool f[0-9]+ : 1;
-- EXPECT-C-REGEX: _Bool f[0-9]+ : 1;
-- EXPECT-C-REGEX: _Bool f[0-9]+ : 1;
-- EXPECT-C-REGEX: [A-Za-z0-9_]+\* [A-Za-z0-9_]+_make\(int f[0-9]+, int f[0-9]+, int f[0-9]+, blorp_String\* f[0-9]+\)
-- EXPECT-C-REGEX: typedef struct [A-Za-z0-9_]+ \{
-- EXPECT-C-REGEX: blorp_String\* f[0-9]+;
-- EXPECT-C-REGEX: _Bool f[0-9]+ : 1;
-- EXPECT-C-REGEX: _Bool f[0-9]+ : 1;
-- EXPECT-C-REGEX: _Bool f[0-9]+ : 1;
-- EXPECT-C-REGEX: _Bool f[0-9]+ : 1;
-- EXPECT-C-REGEX: _Bool f[0-9]+ : 1;
-- EXPECT-C-REGEX: _Bool f[0-9]+ : 1;
-- EXPECT-C-REGEX: _Bool f[0-9]+ : 1;
-- EXPECT-C-REGEX: _Bool f[0-9]+ : 1;
-- EXPECT-C-REGEX: _Bool f[0-9]+ : 1;
-- EXPECT-C-REGEX: [A-Za-z0-9_]+\* [A-Za-z0-9_]+_make\(int f[0-9]+, int f[0-9]+, int f[0-9]+, int f[0-9]+, int f[0-9]+, int f[0-9]+, int f[0-9]+, int f[0-9]+, int f[0-9]+, blorp_String\* f[0-9]+\)
-- EXPECT-C-REGEX: typedef struct [A-Za-z0-9_]+ \{
-- EXPECT-C:   long count;
-- EXPECT-C-REGEX: _Bool f[0-9]+;
-- EXPECT-C-REGEX: _Bool f[0-9]+;
-- EXPECT-C-REGEX: [A-Za-z0-9_]+\* [A-Za-z0-9_]+_make\(int f[0-9]+, long f[0-9]+, int f[0-9]+\)
-- EXPECT-C-REGEX: typedef struct [A-Za-z0-9_]+ \{
-- EXPECT-C:   long count;
-- EXPECT-C-REGEX: uint8_t f[0-9]+;
-- EXPECT-C-REGEX: uint8_t f[0-9]+;
-- EXPECT-C-REGEX: uint8_t f[0-9]+;
-- EXPECT-C-REGEX: [A-Za-z0-9_]+\* [A-Za-z0-9_]+_make\(long f[0-9]+, long f[0-9]+, long f[0-9]+, long f[0-9]+\)
-- EXPECT-C-REGEX: typedef struct [A-Za-z0-9_]+ \{
-- EXPECT-C:   int first;
-- EXPECT-C:   int second;
-- EXPECT-C:   long count;
-- EXPECT-C-REGEX: [A-Za-z0-9_]+\* [A-Za-z0-9_]+_make\(int first, int second, long count\)
-- EXPECT-C-REGEX: typedef struct [A-Za-z0-9_]+ \{
-- EXPECT-C:   long state;
-- EXPECT-C:   long count;
-- EXPECT-C-REGEX: [A-Za-z0-9_]+\* [A-Za-z0-9_]+_make\(long state, long count\)
-- EXPECT-C: blorp_layout_bool_identity(__t9_
-- EXPECT-C: long __t9_
-- EXPECT-C-REGEX: = brp_vn?_[A-Za-z0-9]+->f[0-9]+;
-- EXPECT-C: blorp_layout_enum_identity(__t9_
-- EXPECT-C-REGEX: = brp_vn?_[A-Za-z0-9]+->f[0-9]+;
import:
	list as Lists
	tensor as Tensors


fixed record LayoutThreeFlags {
	first: Bool,
	second: Bool,
	third: Bool
}


fixed record LayoutMixed {
	first: Bool,
	count: Int,
	second: Bool,
	total: Int
}


record LayoutHeapFlags {
	first: Bool,
	second: Bool,
	third: Bool,
	payload: String
}


record LayoutHeapDenseFlags {
	first: Bool,
	second: Bool,
	third: Bool,
	fourth: Bool,
	fifth: Bool,
	sixth: Bool,
	seventh: Bool,
	eighth: Bool,
	ninth: Bool,
	payload: String
}


record LayoutHeapInterleavedFlags {
	first: Bool,
	count: Int,
	second: Bool
}


enum LayoutState:
	LayoutStateReady
	LayoutStateRunning
	LayoutStateComplete


record LayoutHeapStates {
	count: Int,
	first: LayoutState,
	second: LayoutState,
	third: LayoutState
}


record LayoutForeignHeapFlags {
	first: Bool,
	second: Bool,
	count: Int
}


record LayoutForeignHeapState {
	state: LayoutState,
	count: Int
}


record LayoutForeignMixed {
	first: Bool,
	count: Int,
	second: Bool,
	total: Int
}


foreign(include: "compiler_record_layout_ffi.h"):
	func layout_ordered_flag(expected: Int) -> Bool = "blorp_layout_ordered_flag"
	func layout_ordered_count(expected: Int) -> Int = "blorp_layout_ordered_count"
	pure func layout_bool_identity(value: Bool) -> Bool = "blorp_layout_bool_identity"
	pure func layout_enum_identity(value: LayoutState) -> LayoutState = "blorp_layout_enum_identity"
	pure func layout_foreign_heap_flag(
		value: LayoutForeignHeapFlags,
	) -> Bool = "blorp_layout_foreign_heap_flag"
	@no_copy func layout_no_copy_foreign_heap_flag(
		value: LayoutForeignHeapFlags,
	) -> Bool = "blorp_layout_foreign_heap_flag"
	pure func layout_foreign_heap_state(
		value: LayoutForeignHeapState,
	) -> Bool = "blorp_layout_foreign_heap_state"
	pure func layout_foreign_mixed_fields(
		first: Bool,
		count: Int,
		second: Bool,
		total: Int,
	) -> Bool = "blorp_layout_foreign_mixed_fields"


func main(args: List[String]) -> Int:
	flags: LayoutThreeFlags = {
		first = True,
		second = False,
		third = True
	}
	updated_flags: LayoutThreeFlags = { flags | second = True }
	copied_flags: LayoutThreeFlags = updated_flags
	ordered_flags: LayoutThreeFlags = {
		first = layout_ordered_flag(0),
		second = layout_ordered_flag(1),
		third = layout_ordered_flag(2)
	}
	foreign_field_value: Bool = layout_bool_identity(flags.first)
	listed_flags: List[LayoutThreeFlags] = [copied_flags]

	list_flags: LayoutThreeFlags = match Lists.get(listed_flags, 0):
		Some(value):
			value
		None:
			flags

	tensor_flags: LayoutThreeFlags[#2] = {copied_flags, flags}
	tensor_value: LayoutThreeFlags = Tensors.get_or(tensor_flags, 0, flags)
	optional_flags: Option[LayoutThreeFlags] = Some(copied_flags)

	option_value: LayoutThreeFlags = match optional_flags:
		Some(value):
			value
		None:
			flags

	result_flags: Result[LayoutThreeFlags, String] = Ok(copied_flags)

	result_value: LayoutThreeFlags = match result_flags:
		Ok(value):
			value
		Err(_):
			flags

	mixed: LayoutMixed = {
		first = layout_ordered_flag(3),
		count = layout_ordered_count(4) + 1,
		second = not layout_ordered_flag(5),
		total = layout_ordered_count(6) + 2
	}
	updated_mixed: LayoutMixed = { mixed | second = True }
	copied_mixed: LayoutMixed = updated_mixed
	listed_mixed: List[LayoutMixed] = [copied_mixed]

	list_mixed: LayoutMixed = match Lists.get(listed_mixed, 0):
		Some(value):
			value
		None:
			mixed

	tensor_mixed_values: LayoutMixed[#1] = {copied_mixed}
	tensor_mixed: LayoutMixed = Tensors.get_or(tensor_mixed_values, 0, mixed)
	optional_mixed: Option[LayoutMixed] = Some(copied_mixed)

	option_mixed: LayoutMixed = match optional_mixed:
		Some(value):
			value
		None:
			mixed

	result_mixed_value: Result[LayoutMixed, String] = Ok(copied_mixed)

	result_mixed: LayoutMixed = match result_mixed_value:
		Ok(value):
			value
		Err(_):
			mixed

	heap_flags: LayoutHeapFlags = {
		first = layout_ordered_flag(7),
		second = layout_ordered_flag(8),
		third = layout_ordered_flag(9),
		payload = "layout"
	}
	foreign_heap_field_value: Bool = layout_bool_identity(heap_flags.first)
	updated_heap_flags: LayoutHeapFlags = { heap_flags | second = True }
	copied_heap_flags: LayoutHeapFlags = updated_heap_flags
	dense_heap_flags: LayoutHeapDenseFlags = {
		first = True,
		second = False,
		third = True,
		fourth = False,
		fifth = True,
		sixth = False,
		seventh = True,
		eighth = False,
		ninth = True,
		payload = "dense"
	}
	interleaved_heap_flags: LayoutHeapInterleavedFlags = {
		first = layout_ordered_flag(10),
		count = layout_ordered_count(11),
		second = layout_ordered_flag(12)
	}
	heap_states: LayoutHeapStates = {
		count = 42,
		first = LayoutStateReady,
		second = LayoutStateRunning,
		third = LayoutStateComplete
	}
	foreign_heap_state_value: LayoutState = layout_enum_identity(heap_states.first)
	updated_heap_states: LayoutHeapStates = { heap_states | second = LayoutStateComplete }
	copied_heap_states: LayoutHeapStates = updated_heap_states
	foreign_heap_flags: LayoutForeignHeapFlags = {
		first = True,
		second = False,
		count = 42
	}
	foreign_heap_state: LayoutForeignHeapState = {
		state = LayoutStateRunning,
		count = 42
	}
	foreign_mixed: LayoutForeignMixed = {
		first = heap_flags.first,
		count = mixed.count,
		second = mixed.second,
		total = mixed.total,
	}

	if (
		foreign_field_value
		and foreign_heap_field_value
		and foreign_heap_state_value == LayoutStateReady
		and ordered_flags.first
		and ordered_flags.second
		and ordered_flags.third
		and flags.third
		and copied_flags.second
		and list_flags.second
		and tensor_value.second
		and option_value.second
		and result_value.second
		and mixed.first
		and not mixed.second
		and mixed.count == 43
		and mixed.total == 44
		and updated_mixed.first
		and updated_mixed.second
		and updated_mixed.count == 43
		and updated_mixed.total == 44
		and copied_mixed.first
		and copied_mixed.second
		and copied_mixed.count == 43
		and copied_mixed.total == 44
		and list_mixed.first
		and list_mixed.second
		and list_mixed.count == 43
		and list_mixed.total == 44
		and tensor_mixed.first
		and tensor_mixed.second
		and tensor_mixed.count == 43
		and tensor_mixed.total == 44
		and option_mixed.first
		and option_mixed.second
		and option_mixed.count == 43
		and option_mixed.total == 44
		and result_mixed.first
		and result_mixed.second
		and result_mixed.count == 43
		and result_mixed.total == 44
		and foreign_mixed.first
		and not foreign_mixed.second
		and foreign_mixed.count == 43
		and foreign_mixed.total == 44
		and layout_foreign_mixed_fields(foreign_mixed.first, foreign_mixed.count, foreign_mixed.second, foreign_mixed.total)
		and heap_flags.payload == "layout"
		and heap_flags.first
		and heap_flags.second
		and heap_flags.third
		and copied_heap_flags.first
		and copied_heap_flags.second
		and copied_heap_flags.third
		and copied_heap_flags.payload == "layout"
		and dense_heap_flags.first
		and not dense_heap_flags.second
		and dense_heap_flags.third
		and not dense_heap_flags.fourth
		and dense_heap_flags.fifth
		and not dense_heap_flags.sixth
		and dense_heap_flags.seventh
		and not dense_heap_flags.eighth
		and dense_heap_flags.ninth
		and dense_heap_flags.payload == "dense"
		and interleaved_heap_flags.first
		and interleaved_heap_flags.count == 42
		and interleaved_heap_flags.second
		and heap_states.count == 42
		and heap_states.first == LayoutStateReady
		and heap_states.second == LayoutStateRunning
		and heap_states.third == LayoutStateComplete
		and copied_heap_states.count == 42
		and copied_heap_states.first == LayoutStateReady
		and copied_heap_states.second == LayoutStateComplete
		and copied_heap_states.third == LayoutStateComplete
		and layout_foreign_heap_flag(foreign_heap_flags)
		and layout_no_copy_foreign_heap_flag(foreign_heap_flags)
		and layout_foreign_heap_state(foreign_heap_state)
	):
		0
	else:
		1
