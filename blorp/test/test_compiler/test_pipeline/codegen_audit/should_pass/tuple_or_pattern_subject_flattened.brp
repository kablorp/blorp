-- A match subject written as a tuple, with or-patterns over a union, tests
-- each element with its own match, and no tuple is allocated.
-- No generated tuple row survives this local-only shape.
-- EXPECT-NOT-C: "$blorp$tuple_storage$
union Shape:
	Circle(Int)
	Square(Int)
	Empty


pure func same_kind(left: Shape, right: Shape) -> Bool:
	match (left, right):
		(Circle(_), Circle(_)) | (Square(_), Square(_)) | (Empty, Empty):
			True
		_:
			False


func main(args: List[String]) -> Int:
	if same_kind(Circle(1), Circle(2)) and not same_kind(Empty, Square(3)):
		0
	else:
		1
