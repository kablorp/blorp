-- Erased union storage directly owns managed record pointers. Their transfer
-- requires a release-mask bit without an additional struct box.
-- EXPECT-C: struct { void* field0; } StructPayload;
-- EXPECT-C-REGEX: brp_ty2\* brp_c_[A-Za-z0-9]+\(void\* field0, unsigned long release_mask\)
-- EXPECT-C-REGEX: return brp_ty1_make\(brp_vn?_[A-Za-z0-9]+\);
-- EXPECT-C-REGEX: brp_c_[A-Za-z0-9]+\(\(void\*\)brp_[A-Za-z0-9]+\(7\), 1UL\)
-- EXPECT-NOT-C: blorp_box_struct
-- EXPECT-C-REGEX: static inline brp_ty2\* __blorp_reuse_ErasedMixedPayload_brp_c_[A-Za-z0-9]+\(brp_ty2\* __old, void\* field0, unsigned long release_mask\)
-- EXPECT-C: __old->release_mask = release_mask;
-- EXPECT-C-REGEX: brp_ty2\* __fresh = brp_c_[A-Za-z0-9]+\(field0, release_mask\);
-- EXPECT-C-REGEX: if \(\(self->release_mask & 1UL\) && self->data\.StructPayload\.field0\) blorp_release\(self->data\.StructPayload\.field0\);

fixed record Point {
	value: Int
}


union ErasedMixedPayload:
	StructPayload(Point)
	TextPayload(String)


pure func make_point(value: Int) -> Point:
	{ value = value }


pure func payload_score(payload: ErasedMixedPayload) -> Int:
	match payload:
		StructPayload(point):
			point.value
		TextPayload(text):
			text.length()


func main(args: List[String]) -> Int:
	if (
		payload_score(StructPayload(make_point(7))) == 7
		and payload_score(TextPayload("managed")) == 7
	):
		0
	else:
		1
