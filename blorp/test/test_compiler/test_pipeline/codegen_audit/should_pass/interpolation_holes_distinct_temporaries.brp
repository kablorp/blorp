-- Two holes in one interpolated string that each convert an owned result to
-- text must get two distinct Perceus temporaries. Each hole's conversion call
-- takes the hole's own `${...}` extent as its node id; when every conversion
-- shared the string's extent, both holes minted the same `brp_vt_` and
-- `brp_vd_` names and the C compiler rejected the redefinition.
--
-- EXPECT-C: /* Blorp final Core C artifact */
-- EXPECT-C-REGEX: blorp_List\* brp_vt_[0-9A-Za-z]+_b0 = brp_[0-9A-Za-z]+\(brp_v_[0-9A-Za-z]+\);
-- EXPECT-C-REGEX: blorp_list_to_string_int\(brp_vt_[0-9A-Za-z]+_b0\);
pure func pair_of(value: Int) -> List[Int]:
	[value, value]


func main(args: List[String]) -> Int:
	first: Int = 1
	second: Int = 2
	print("${pair_of(first)} and ${pair_of(second)}")
	0
