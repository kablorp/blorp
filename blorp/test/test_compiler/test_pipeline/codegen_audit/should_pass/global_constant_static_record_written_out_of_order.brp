-- A constant record literal written out of declaration order is still one
-- static object: each field is stored by its declared position, and the static
-- list a field holds is named after that field's member.
-- EXPECT-C-REGEX: __blorp_static_list_LIMITS_f1 = \{
-- EXPECT-C-REGEX: static [A-Za-z0-9_]+ __blorp_static_record_LIMITS = \{
-- EXPECT-C: .f0 = 2L,
-- EXPECT-C: .f1 = (blorp_List*)&__blorp_static_list_LIMITS_f1
-- EXPECT-C-REGEX: static [A-Za-z0-9_]+\* LIMITS = \([A-Za-z0-9_]+\*\)&__blorp_static_record_LIMITS;
-- EXPECT-NOT-C: LIMITS = ({
record Limits {
	count: Int,
	values: List[Int]
}


LIMITS: Limits = {
	values = [3, 5],
	count = 2
}


func main(args: List[String]) -> Int:
	print((LIMITS.count + LIMITS.values.length()).to_string())
	0
