-- EXPECT-C-REGEX: static brp_ty[0-9A-Za-z]+\* STATIC_PAIR;
-- EXPECT-C: BLORP_STATIC_STRING(__blorp_string_literal_0, 5L, "seven");
-- All logical fields evaluate in order and transfer into the typed constructor.
-- EXPECT-C: long __t10_0 = 7;
-- EXPECT-C: blorp_String* __t10_1 = (blorp_String*)&__blorp_string_literal_0;
-- EXPECT-C-REGEX: brp_ty[0-9A-Za-z]+\* __t10_2 = brp_ty[0-9A-Za-z]+_make\(7\);
-- EXPECT-C-REGEX: brp_ty[0-9A-Za-z]+\* __t11_3 = brp_ty[0-9A-Za-z]+_make\(__t10_0, __t10_1, __t10_2\);
-- EXPECT-C: STATIC_PAIR = __t11_3;
-- The Int field has no release; both managed fields have typed release policies.
-- EXPECT-C: if (__rec->f1) blorp_release_arc_only(__rec->f1);
-- EXPECT-C: if (__rec->f2) blorp_release((blorp_Object*)__rec->f2);
-- EXPECT-C: blorp_release(STATIC_PAIR);
-- EXPECT-C: blorp_register_global_cleanup(__blorp_drop_globals);
-- EXPECT-NOT-C: blorp_string_create("seven")
-- EXPECT-NOT-C: blorp_make_immortal_
record Counter {
	value: Int
}


STATIC_PAIR: (Int, String, Counter) = (7, "seven", {value = 7})


func main(args: List[String]) -> Int:
	value = STATIC_PAIR[1]
	counter = STATIC_PAIR[2]
	print(value + ":" + counter.value.to_string())
	0
