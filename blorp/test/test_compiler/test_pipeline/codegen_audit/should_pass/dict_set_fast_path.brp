-- Generated-C shape audit for Dict.set.
--
-- set should use the synthesized Core insertion path after monomorphization,
-- not the legacy runtime blorp_dict_insert fallback.
--
-- EXPECT-C: __dict_insert_hash
-- EXPECT-C: __dict_insert_found_slot
-- EXPECT-C: blorp_hash_int((long)(intptr_t)__dict_insert_key)
-- EXPECT-C: __dict_insert_new_len
-- EXPECT-NOT-C: ((blorp_Dict*)blorp_dict_insert
import:
	dict: Dict, dict, set


type alias IntDict = Dict[Int, Int]


func alias_len() -> Int:
	var d: IntDict = dict()
	d = set(d, 1, 10)
	d = set(d, 2, 20)
	d.length()


func main(args: List[String]) -> Int:
	var d: Dict[Int, Int] = dict()
	d = set(d, 1, 10)
	d = set(d, 2, 20)
	d.length() + alias_len()
