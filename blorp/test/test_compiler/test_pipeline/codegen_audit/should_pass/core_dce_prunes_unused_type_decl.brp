-- EXPECT-C: UsedRecord
-- EXPECT-NOT-C: UnusedRecord
import:
	memory: same_object


record UsedRecord {
	value: Int
}


record UnusedRecord {
	value: Int
}


func main(args: List[String]) -> Int:
	used: UsedRecord = {value = 42}
	-- Keep UsedRecord physical while UnusedRecord remains unreachable.
	if same_object(used, used):
		used.value
	else:
		0
