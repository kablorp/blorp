-- Generated-C shape audit for sized-integer stack Option payloads.
-- EXPECT-C: blorp_StackOption_Int32
-- EXPECT-C: blorp_StackOption_UInt8
-- EXPECT-C-REGEX: int32_t brp_vn?_[A-Za-z0-9]+ = __to
-- EXPECT-C-REGEX: uint8_t brp_vn?_[A-Za-z0-9]+ = __to
-- EXPECT-NOT-C: Some((void*)(long)
import:
	option: Option(Some, None)


func choose_i32(flag: Bool) -> Option[Int32]:
	if flag:
		Some(to_int32(12))
	else:
		None


func choose_u8(flag: Bool) -> Option[UInt8]:
	if flag:
		Some(to_uint8(7))
	else:
		None


func main(args: List[String]) -> Int:
	oi: Option[Int32] = choose_i32(True)
	ou: Option[UInt8] = choose_u8(True)
	i_ok: Bool = match oi:
		Some(i): i == to_int32(12)
		None: False
	u_ok: Bool = match ou:
		Some(u): u == to_uint8(7)
		None: False
	if i_ok and u_ok:
		0
	else:
		1
