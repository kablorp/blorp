-- EXPECT-C: /* Blorp final Core C artifact */
-- Semantic callable expectation: long later(long x);
-- EXPECT-C-REGEX: long brp_[0-9A-Za-z]+\(long brp_vn?_[A-Za-z0-9]+\);
-- Semantic callable expectation: return later(41);
-- EXPECT-C-REGEX: return brp_[0-9A-Za-z]+\(41\);
pure func caller() -> Int:
	later(41)


pure func later(x: Int) -> Int:
	x + 1


func main(args: List[String]) -> Int:
	caller()
