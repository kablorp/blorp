-- List for-each loops should stay on the Blorp final-Core-to-C backend.
--
-- EXPECT-C: /* Blorp final Core C artifact */
-- Semantic callable expectation: long count_strings(blorp_List* xs)
-- EXPECT-C-REGEX: long brp_[0-9A-Za-z]+\(blorp_List\* brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C: blorp_List* __tc_
-- EXPECT-C: long __tf_
-- EXPECT-C: for (long __ta_
-- EXPECT-C-REGEX: blorp_String\* brp_vn?_[A-Za-z0-9]+ = \(\(blorp_String\*\)__tc_[0-9A-Za-z]+->data\[__ta_[0-9A-Za-z]+\]\);
pure func count_strings(xs: List[String]) -> Int:
	var count: Int = 0

	for item in xs:
		count += 1

	count


func main(args: List[String]) -> Int:
	count_strings(["a", "b"])
