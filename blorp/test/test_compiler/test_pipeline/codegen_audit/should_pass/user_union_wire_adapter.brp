-- EXPECT-C: blorp_wire_color_is_red(
-- EXPECT-C: blorp_wire_color_is_blue(
-- EXPECT-C: blorp_wire_color_identity(
-- A managed language union crosses a scalar boundary only through an adapter.
-- Deliberately reverse declaration order relative to the native wire tags.
union WireColor:
	WireBlue
	WireRed


pure func color_wire_tag(color: WireColor) -> Int:
	-- The external contract is Red = 0 and Blue = 1.
	match color:
		WireRed:
			0
		WireBlue:
			1


pure func color_from_wire_tag(tag: Int) -> Option[WireColor]:
	match tag:
		0:
			Some(WireRed)
		1:
			Some(WireBlue)
		_:
			None


foreign(include: "user_union_wire_adapter_ffi.h"):
	pure func native_is_red(tag: Int) -> Int = "blorp_wire_color_is_red"
	pure func native_is_blue(tag: Int) -> Int = "blorp_wire_color_is_blue"
	pure func native_identity(tag: Int) -> Int = "blorp_wire_color_identity"
	pure func native_test_tag(case_index: Int) -> Int = "blorp_wire_color_test_tag"


func main(args: List[String]) -> Int:
	known_tags_decode = match (
		color_from_wire_tag(native_identity(native_test_tag(0))),
		color_from_wire_tag(native_identity(native_test_tag(1))),
	):
		(Some(WireRed), Some(WireBlue)):
			True
		_:
			False

	unknown_tags_decode = match (
		color_from_wire_tag(native_identity(native_test_tag(2))),
		color_from_wire_tag(native_identity(native_test_tag(3))),
	):
		(None, None):
			True
		_:
			False

	selected = if args.length() == 0:
		WireRed
	else:
		WireBlue

	selected_roundtrip = match color_from_wire_tag(native_identity(color_wire_tag(selected))):
		Some(color):
			color_wire_tag(color) == color_wire_tag(selected)
		None:
			False

	if (
		native_is_red(color_wire_tag(WireRed)) == 1
		and native_is_blue(color_wire_tag(WireBlue)) == 1
		and native_is_red(color_wire_tag(WireBlue)) == 0
		and native_is_blue(color_wire_tag(WireRed)) == 0
		and known_tags_decode
		and unknown_tags_decode
		and selected_roundtrip
	):
		0
	else:
		1
