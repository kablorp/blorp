import:
	list as L


-- Codegen audit: fresh tuple appends inside expression-level while loops should
-- lower to the compiler-owned inline append path instead of the generic
-- ref-retaining list append wrapper.
--
-- EXPECT-C: blorp_list_set_raw(
-- EXPECT-NOT-C: blorp_list_append(draw_list
func f() -> Int:
	var frame: Int = 0
	while frame < 10:
		var draw_list: List[(Int, Float)] = []
		for i in 0..20:
			draw_list = L.append(draw_list, (i, to_float(i) * 1.5))
		_ = L.length(draw_list)
		frame += 1
	0


func main(args: List[String]) -> Int:
	f()
