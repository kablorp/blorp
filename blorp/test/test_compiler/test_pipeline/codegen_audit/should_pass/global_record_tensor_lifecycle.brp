-- Boxed record tensors already use runtime global initialization. Element
-- ownership normalization keeps that boundary and its shutdown cleanup.
-- EXPECT-C: static blorp_Vector* GLOBAL_POINTS;
-- EXPECT-C: blorp_release(GLOBAL_POINTS);
-- EXPECT-C: blorp_register_global_cleanup(__blorp_drop_globals);
-- EXPECT-NOT-C: #error
record Ranked {
	score: Int
}


GLOBAL_POINTS: Ranked[#2, #2] = {
	{{score = 4}, {score = 2}},
	{{score = 7}, {score = 1}},
}


func main(args: List[String]) -> Int:
	print((GLOBAL_POINTS[0, 0].score + GLOBAL_POINTS[1, 1].score).to_string())
	0
