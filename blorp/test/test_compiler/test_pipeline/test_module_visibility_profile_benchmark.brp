import:
	../../../benchmark/compiler/compiler_module_visibility_profile_fixture:
		CompilerModuleVisibilityBenchmarkConfig,
		CompilerModuleVisibilityGraphShape(
			ModuleVisibilityDenseGraph,
			ModuleVisibilityLayeredGraph,
		),
		compiler_module_visibility_benchmark,
		compiler_module_visibility_benchmark_input,
	test: TestSuite


private func test_module_visibility_profile_sees_every_module_in_layered_graph() -> Bool:
	maybe_input = compiler_module_visibility_benchmark_input({
		iterations = 2,
		module_count = 4,
		requested_imports_per_module = 2,
		root_count = 1,
		graph_shape = ModuleVisibilityLayeredGraph,
		mixed_origins = False,
	})

	match maybe_input:
		None:
			False
		Some(input):
			result = compiler_module_visibility_benchmark(input)

			(
				result.effective_import_limit == 2
				and result.visible_module_count == 4
				and result.error_count == 0
				and result.workload_valid
			)


private func test_module_visibility_profile_is_deterministic_for_mixed_dense_graph() -> Bool:
	maybe_input = compiler_module_visibility_benchmark_input({
		iterations = 3,
		module_count = 5,
		requested_imports_per_module = -1,
		root_count = 2,
		graph_shape = ModuleVisibilityDenseGraph,
		mixed_origins = True,
	})

	match maybe_input:
		None:
			False
		Some(input):
			first = compiler_module_visibility_benchmark(input)
			second = compiler_module_visibility_benchmark(input)

			(
				first.effective_import_limit == 4
				and first.visible_module_count == 5
				and first.checksum == second.checksum
				and first.error_count == 0
				and first.workload_valid
				and second.workload_valid
			)


private func test_module_visibility_profile_rejects_oversized_root_count() -> Bool:
	compiler_module_visibility_benchmark_input({
		iterations = 1,
		module_count = 2,
		requested_imports_per_module = 1,
		root_count = 3,
		graph_shape = ModuleVisibilityLayeredGraph,
		mixed_origins = False,
	}).is_none()


tests: TestSuite = {
	description = "Compiler module visibility benchmark",
	tests = [
		("layered closure sees every module", test_module_visibility_profile_sees_every_module_in_layered_graph),
		(
			"mixed dense closure is deterministic",
			test_module_visibility_profile_is_deterministic_for_mixed_dense_graph,
		),
		(
			"oversized root count is rejected",
			test_module_visibility_profile_rejects_oversized_root_count,
		),
	]
}
