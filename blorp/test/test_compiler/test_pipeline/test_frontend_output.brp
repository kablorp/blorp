import:
	../../../src/compiler/frontend_output: parsed_program_summary, parsed_source_summary
	../../../src/compiler/stage_02_lex/name_table:
		IdentifierSpellings(SpellingsFromIdentifierText, SpellingsFromNameTable),
		NameId,
		NameTable,
		name_id_index,
		name_table_from_parts,
	../../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../../src/compiler/stage_03_parse/parsed_ast: ParsedDecl(FunctionParsedDecl), ParsedProgram
	../../../src/lib/source: source_file
	list: repeat
	test: TestSuite


pure func test_parsed_source_summary_does_not_require_typechecking() -> Bool:
	summary: String = parsed_source_summary(
		"src/main.brp",
		"main",
		"func main(args: List[String]) -> Int:\n\tmissing_name\n",
	)

	summary == "Func main"


private pure func parsed_main_program() -> ParsedProgram:
	parse_compiler_source(source_file("src/main.brp", "main", "func main():\n\t1\n"))


-- A table whose spelling for `id` differs from the identifier's own text, so a
-- summary shows which of the two it read.
private pure func table_spelling_id_as(id: NameId, spelling: String) -> NameTable:
	index: Int = name_id_index(id)
	spellings: List[String] = repeat("filler", index).append(spelling)
	name_table_from_parts(spellings, {})


pure func test_parsed_summary_reads_a_discovery_identifier_spelling_from_the_table() -> Bool:
	program: ParsedProgram = parsed_main_program()

	match program.decls:
		[FunctionParsedDecl(function_decl)]:
			table: NameTable = table_spelling_id_as(function_decl.name.name, "from_table")
			parsed_program_summary(SpellingsFromNameTable(table), program) == "Func from_table"
		_:
			False


pure func test_parsed_summary_reads_a_standalone_identifier_spelling_from_its_text() -> Bool:
	program: ParsedProgram = parsed_main_program()

	parsed_program_summary(SpellingsFromIdentifierText, program) == "Func main"


tests: TestSuite = {
	description = "Compiler CLI frontend output",
	tests = [
		(
			"parsed summary reads a discovery identifier spelling from the table",
			test_parsed_summary_reads_a_discovery_identifier_spelling_from_the_table,
		),
		(
			"parsed summary reads a standalone identifier spelling from its text",
			test_parsed_summary_reads_a_standalone_identifier_spelling_from_its_text,
		),
		(
			"parsed source summary does not require typechecking",
			test_parsed_source_summary_does_not_require_typechecking,
		),
	]
}
