import:
	../../../benchmark/compiler/compiler_backend_bridge: handle_request_value
	io: print_error
	json:
		JsonValue(JsonBool, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_bool,
		as_string,
		get_field,
	test: TestSuite


private pure func benchmark_request(action: String) -> JsonValue:
	JsonObject([
		("schema", JsonNumber(1.0)),
		("domain", JsonString("compiler")),
		("action", JsonString(action)),
		("payload", JsonObject([("core", JsonObject([
				("kind", JsonString("program")),
				("decls", JsonVector([])),
				("foreign_includes", JsonVector([])),
			])), ("profile", JsonBool(False))])),
	])


private pure func artifact_field(response: JsonValue, name: String) -> Option[JsonValue]:
	artifact ?= get_field(response, "artifact")
	get_field(artifact, name)


private pure func artifact_string_field(response: JsonValue, name: String) -> Option[String]:
	match artifact_field(response, name):
		Some(value):
			as_string(value)
		None:
			None


private pure func artifact_array_field_exists(response: JsonValue, name: String) -> Bool:
	match artifact_field(response, name):
		Some(value):
			as_array(value).is_some()
		None:
			False


private pure func artifact_object_field_exists(response: JsonValue, name: String) -> Bool:
	match artifact_field(response, name):
		Some(value):
			match value:
				JsonObject(_):
					True
				_:
					False
		None:
			False


private pure func response_is_ok(response: JsonValue) -> Bool:
	match get_field(response, "ok"):
		Some(value):
			as_bool(value).get_or(False)
		None:
			False


func test_emit_core_c_returns_complete_artifact() -> Bool:
	response: JsonValue = handle_request_value(benchmark_request("emit_core_c"))

	valid: Bool = (
		response_is_ok(response)
		and artifact_string_field(response, "c_code")
			.map(func(code): code.length() > 0)
			.get_or(False)
		and artifact_array_field_exists(response, "link_flags")
		and artifact_array_field_exists(response, "include_dirs")
	)

	if not valid:
		print_error(response.to_string())

	valid


func test_run_perceus_returns_core_without_emission() -> Bool:
	response: JsonValue = handle_request_value(benchmark_request("run_perceus"))
	valid: Bool = (
		response_is_ok(response)
		and artifact_object_field_exists(response, "core")
		and artifact_field(response, "c_code").is_none()
	)

	if not valid:
		print_error(response.to_string())

	valid


func test_measurement_windows_are_named_explicitly() -> Bool:
	preparation_response: JsonValue = handle_request_value(
		benchmark_request("measure_ownership_preparation_perceus"),
	)
	direct_response: JsonValue = handle_request_value(benchmark_request("measure_perceus_direct"))

	var valid: Bool = response_is_ok(preparation_response) and response_is_ok(direct_response)
	valid = (
		valid
		and artifact_string_field(
			preparation_response,
			"window",
		) == Some("ownership-preparation plus Perceus")
	)

	valid = valid and artifact_string_field(direct_response, "window") == Some("direct Perceus")
	valid = valid and artifact_object_field_exists(preparation_response, "core")
	valid and artifact_object_field_exists(direct_response, "core")


func test_ownership_stage_inspection_returns_all_stage_snapshots() -> Bool:
	response: JsonValue = handle_request_value(benchmark_request("inspect_ownership_stages"))

	(
		response_is_ok(response)
		and artifact_object_field_exists(response, "ownership_ready")
		and artifact_object_field_exists(response, "post_perceus")
		and artifact_object_field_exists(response, "post_reuse")
		and artifact_object_field_exists(response, "prepared")
	)


func test_backend_emission_measurement_runs_the_ownership_pipeline_first() -> Bool:
	response: JsonValue = handle_request_value(benchmark_request("measure_backend_emission"))

	(
		response_is_ok(response)
		and artifact_string_field(response, "window") == Some("backend emission")
		and artifact_string_field(response, "c_code")
			.map(func(code): code.length() > 0)
			.get_or(False)
	)


func test_rejects_unsupported_benchmark_action() -> Bool:
	response: JsonValue = handle_request_value(benchmark_request("unknown_backend_action"))

	match get_field(response, "error"):
		Some(error):
			match get_field(error, "code"):
				Some(code_value):
					match as_string(code_value):
						Some(code):
							code == "unsupported_action"
						None:
							False
				None:
					False
		None:
			False


tests: TestSuite = {
	description = "Blorp compiler benchmark backend bridge",
	tests = [
		("emit Core C returns a complete artifact", test_emit_core_c_returns_complete_artifact),
		(
			"run Perceus returns Core without emission",
			test_run_perceus_returns_core_without_emission,
		),
		("measurement windows are named explicitly", test_measurement_windows_are_named_explicitly),
		(
			"ownership stage inspection returns every snapshot",
			test_ownership_stage_inspection_returns_all_stage_snapshots,
		),
		(
			"backend emission measurement runs ownership first",
			test_backend_emission_measurement_runs_the_ownership_pipeline_first,
		),
		("rejects unsupported benchmark action", test_rejects_unsupported_benchmark_action),
	]
}
