-- The legacy discovery adapter over small programs: each declaration and each
-- body construct is rebuilt from the stage's tables and compared with the
-- existing parser's program through the same full comparison, spans included,
-- that the corpus differential (`tools/discovery_adapter_differential.brp`)
-- runs, plus the adapter's own module naming and graph assembly.
import:
	../../../src/compiler/discovery_adapter:
		DeclarationReader,
		LegacyAdapterError(MalformedNode, MissingTableRow),
		LegacyModuleNaming,
		legacy_adapter_error_message,
		legacy_declaration_reader,
		legacy_frontend_graph,
		legacy_parsed_program,
	../../../src/compiler/discovery_tree_projection:
		LegacyAliasPreview,
		LegacyBuiltinTypePreview,
		LegacyDeclarationPreviewError(MissingDimensionLiteralToken, InvalidGlobalInitializerEntry),
		LegacyDeclarationProjection,
		LegacyDeclarationProjectionStop( ReachedEndOfSource, StoppedAtFunctionHeader, StoppedAtTraitPreview, StoppedAtImplementationPreview, StoppedAtGlobalInitializer, StoppedAtRejectedGlobalInitializer, StoppedAtRejectedDeclaration, StoppedWithoutDeclarationProgress, ),
		LegacyFunctionHeaderPreview,
		LegacyGlobalHeaderPreview,
		LegacyImplementationHeaderPreview,
		LegacyRecordPreview,
		LegacyTraitHeaderPreview,
		LegacyUnionPreview,
		legacy_alias_preview,
		legacy_builtin_type_preview,
		legacy_declaration_projection,
		legacy_implementation_header,
		legacy_record_preview,
		legacy_trait_header,
		legacy_union_preview,
	../../../src/compiler/frontend_request: FrontendGraphContext
	../../../src/compiler/stage_02_lex/name_table:
		EMPTY_NAME_TABLE,
		IdentifierSpellings(SpellingsFromIdentifierText, SpellingsFromNameTable),
		NameTable,
		name_id_from_interned_index,
		name_id_index,
		name_spelling,
		name_table_find_id,
		name_table_intern,
		name_table_spellings,
		name_table_synthesized_spellings,
	../../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../../src/compiler/stage_03_parse/parsed_ast:
		UnionDeclarationForm(OrdinaryUnion, FixedUnion),
		ParsedDecl(
			FunctionParsedDecl, VarParsedDecl, RecordParsedDecl, TypeAliasParsedDecl,
			BuiltinTypeParsedDecl, UnionParsedDecl,
		),
		ParsedExpr(
			ParsedBinaryExpr, ParsedBlockExpr, ParsedNameExpr, ParsedIntLiteralExpr,
			ParsedFloatLiteralExpr,
		),
		ParsedFunctionAnnotation(ParsedNoCopyAnnotation),
		ParsedFunctionHeader,
