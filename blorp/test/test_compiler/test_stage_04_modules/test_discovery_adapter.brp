---
Interpolation nested three levels deep is interpolated at every level here. The
existing lexer leaves the innermost string a plain literal (`"c {h}"`), a known
difference (listed in `ADAPTER_DIFFERENCES` through the `known_differences`
fixture).
---
func test_interpolation_three_levels_deep_is_interpolated_at_every_level() -> Bool:
	source: String = "func f(h: Int) -> String:\n\t\"a " + HOLE_OPENER + "f(\"b " + HOLE_OPENER + "g(\"c " + HOLE_OPENER + "h}\")}\")} d\"\n"

	match adapter_differences(source):
		Some((_, differences)):
			differences.any(
				pure func(
					difference,
				): (
					difference.path.ends_with(".kind")
					and difference.old_text == "\"string_literal\""
					and difference.new_text == "\"string_interp\""
				),
			)
		None:
			False


---
A chain of `DEEP_OPERANDS` operands nests that many levels deep, and a body the
adapter rebuilds does not recurse over them.
---
func test_a_deeply_nested_body_is_rebuilt_without_recursion() -> Bool:
	var chain: String = "1"

	for operand in 0..DEEP_OPERANDS:
		chain += " + ${operand}"

	match discovered({ROOT_PATH => "func deep() -> Int:\n\t${chain}\n"}):
		Some(tables):
			match reader_of(tables):
				Some(reader):
					match legacy_parsed_program(reader, module_id_at_row(0)):
						Ok(program):
							(
								program.decls.length() == 1
								and first_body_spine_length(program) == DEEP_OPERANDS
							)
						Err(_):
							False
				None:
					False
		None:
			False


---
How many binary operations the left spine of the first function's body holds:
the chain's depth, followed one level at a time.
---
func first_body_spine_length(program: ParsedProgram) -> Int:
	var spine: Int = 0

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			var current: Option[ParsedExpr] = function_decl.body

			-- The body is a block of one expression.
			match current:
				Some(ParsedBlockExpr(items, _)):
					current = items.get(0)
				_:
					void

			var following: Bool = True

			while following:
				match current:
					Some(ParsedBinaryExpr(_, left, _, _)):
						spine += 1
						current = Some(left)
					_:
						following = False
		_:
			void

	spine


DEEP_OPERANDS: Int = 6000

---
`$` then `{`: spelled apart so a test source can hold an interpolation hole
without opening one here.
---
HOLE_OPENER: String = "$" + "{"


---
A `concurrently` loop with no `limit` is something the parser reports, and the
tables then hold a loop without the parameter the existing AST requires: the
adapter reports the node, and does not invent a limit.
---
func test_a_concurrently_loop_without_a_limit_is_a_malformed_node() -> Bool:
	match discovered(
		{
			ROOT_PATH => "func f(xs: List[Int]) -> Int:\n\tfor x in xs concurrently():\n\t\tx\n\t0\n",
		},
	):
		Some(tables):
			match reader_of(tables):
				Some(reader):
					match legacy_parsed_program(reader, module_id_at_row(0)):
						Err(MalformedNode(_, ConcurrentForNode)):
							True
						_:
							False
				None:
					False
		None:
			False


func test_the_comparison_reports_a_changed_field() -> Bool:
	source: String = "func f(value: Int) -> Int:\n\tvalue\n"
	existing: ParsedProgram = parse_compiler_source(
		source_file(
			ROOT_PATH,
			ROOT_MODULE_NAME,
			source,
		),
	)
	changed: ParsedProgram = { existing | decls = existing.decls.drop(1) }
	differences: List[JsonDifference] = program_differences(
		parsed_program_to_json(with_holes_parsed(existing)),
		parsed_program_to_json(changed),
	)

	(
		differences.length() == 1
		and differences.any(pure func(difference): difference.path == "decls.length")
	)


