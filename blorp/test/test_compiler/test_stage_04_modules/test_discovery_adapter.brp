func record_preview_matches(text: String) -> Bool:
	source = source_file(ROOT_PATH, ROOT_MODULE_NAME, text)
	existing: ParsedProgram = parse_compiler_source(source)

	if not existing.diagnostics.is_empty() or existing.decls.length() != 1:
		print("expected one declaration without diagnostics from the existing parser")
		False
	else:
		match existing.decls.get(0):
			None:
				False
			Some(declaration):
				match preview_record(lex_module(module_id_at_row(0), text)):
					Ok(PreviewedRecord(preview)):
						result: Result[LegacyRecordPreview, LegacyDeclarationPreviewError] = legacy_record_preview(
							preview,
						)

						match result:
							Ok(adapted):
								expected = parsed_decl_to_json(
									ast_json_render(source, SpellingsFromIdentifierText),
									declaration,
								).to_string()
								actual = parsed_decl_to_json(
									ast_json_render(source, SpellingsFromNameTable(adapted.names)),
									adapted.declaration,
								).to_string()

								if expected != actual:
									print("expected: ${expected}\nactual: ${actual}")

								expected == actual
							Err(error):
								print("the legacy adapter rejected the ordinary record preview")
								False
					_:
						print("expected a successful standalone ordinary record preview")
						False


