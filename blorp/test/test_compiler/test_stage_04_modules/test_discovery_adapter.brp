func test_name_initialized_globals_compare_completed_syntax() -> Bool:
	var correct: Bool = True

	for prefix in ["", "private ", "---\nDoc.\n---\nprivate "]:
		for mutable in [False, True]:
			for written_type in ["", ": m.Buffer[Int][#N]"]:
				binding = if mutable:
					"var value"
				else:
					"value"

				text = "${prefix}${binding}${written_type} = Source -- comment\n-- next comment\nrecord Later {}"
				existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

				match projected(text, EMPTY_NAME_TABLE):
					Some(projection):
						comparison = declaration_prefix_comparison(existing, projection)

						kind = if mutable:
							MutableGlobalPrefix
						else:
							ConstantGlobalPrefix

						correct = (
							correct
							and existing.diagnostics.is_empty()
							and comparison.differences.is_empty()
							and comparison.completed_declarations == 2
							and comparison.declaration_kinds == [kind, RecordPrefix]
						)
					None:
						correct = False

	correct


func test_name_global_projection_reuses_names_and_excludes_deferred_values() -> Bool:
	text = "first = Source\nsecond = Source\nblocked: Int = " + unread_value("Unsupported(BodyName)") + "\nrecord Later {}"
	existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

	match projected(text, EMPTY_NAME_TABLE):
		Some(projection):
			match (projection.stop, projection.declarations):
				(StoppedAtGlobalInitializer(_), [VarParsedDecl(first), VarParsedDecl(second)]):
					match (first.value, second.value):
						(ParsedNameExpr(first_value), ParsedNameExpr(second_value)):
							comparison = declaration_prefix_comparison(existing, projection)
							var correct: Bool = (
								existing.diagnostics.is_empty()
								and comparison.differences.is_empty()
								and comparison.completed_declarations == 2
								and comparison.declaration_kinds == [ConstantGlobalPrefix]
								and name_table_spellings(
									projection.names,
								) == ["first", "Source", "second", "blocked", "Int"]
								and first_value.name == second_value.name
								and name_spelling(
									projection.names,
									first_value.name,
								) == Some("Source")
								and name_table_find_id(projection.names, "Unsupported").is_none()
								and name_table_find_id(projection.names, "BodyName").is_none()
								and name_table_find_id(projection.names, "Later").is_none()
							)

							match projected("third = Source", projection.names):
								Some(next):
									match next.declarations:
										[VarParsedDecl(third)]:
											match third.value:
												ParsedNameExpr(third_value):
													correct = (
														correct
														and third_value.name == first_value.name
														and name_table_spellings(
															next.names,
														) == name_table_spellings(
															projection.names,
														).append("third")
													)
												_:
													correct = False
										_:
											correct = False
								None:
									correct = False

							correct
						_:
							False
				_:
					False
		None:
			False


func test_name_global_completion_preserves_unsupported_name_table() -> Bool:
	var correct: Bool = True

	for initializer in [
		"Unsupported\n.field",
		"Unsupported\n\t.field",
		"123 Other",
		"\n\tUnsupported",
		unread_value("Unsupported"),
		"(" + unread_value("Unsupported") + ")",
	]:
		text = "value: Int = ${initializer}\nrecord Later {}"

		match (
			projected(text, EMPTY_NAME_TABLE),
			projected(text, EMPTY_NAME_TABLE),
		):
			(Some(before), Some(after)):
				match (before.stop, after.stop):
					(StoppedAtGlobalInitializer(original), StoppedAtGlobalInitializer(retained)):
						correct = (
							correct
							and before.declarations.is_empty()
							and after.declarations.is_empty()
							and name_table_spellings(before.names) == ["value", "Int"]
							and name_table_spellings(
								after.names,
							) == name_table_spellings(before.names)
							and original.initializer.anchor.span_start() == retained.initializer.anchor.span_start()
							and original.initializer.initializer_entry.span_start() == retained.initializer.initializer_entry.span_start()
							and original.header_span.span_end() == retained.header_span.span_end()
						)
					_:
						correct = False
			_:
				correct = False

	correct


