	text: String = "record Box[T: m.Eq + Hashable, #N, #_] { value: T }"

	match preview_record(lex_module(module_id_at_row(0), text)):
		Ok(PreviewedRecord(preview)):
			match legacy_record_preview(preview):
				Ok(adapted):
					match adapted.declaration:
						RecordParsedDecl(record_decl):
							match (record_decl.type_params, record_decl.fields):
								([type_param, dimension, wildcard], [field]):
									match (type_param.bounds, field.type_expr):
										([qualified, hashable], ParsedNamedType(field_type, [], _)):
											match qualified.qualifier:
												Some(qualifier):
													(
														name_spelling(
															adapted.names,
															record_decl.name.name,
														) == Some("Box")
