func test_integer_globals_preserve_authored_digits_in_full_ast() -> Bool:
	var correct: Bool = True

	for digits in ["0", "007", "9223372036854775808", "170141183460469231731687303715884105727"]:
		for prefix in ["", "---\nDoc.\n---\nprivate var "]:
			for written_type in ["", ": m.Buffer[Int][#N]"]:
				text = "${prefix}value${written_type} = ${digits} -- comment\n-- next comment\nrecord Later {}"
				existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

				match projected(text, EMPTY_NAME_TABLE):
					Some(projection):
						comparison = declaration_prefix_comparison(existing, projection)
						correct = (
							correct
							and existing.diagnostics.is_empty()
							and comparison.differences.is_empty()
							and comparison.completed_declarations == 2
							and name_table_find_id(projection.names, digits).is_none()
						)
					-- Full JSON equality above pins both raw digits and every span,
					-- including the declaration wrapper for private globals.
					None:
						correct = False

	correct


func test_mixed_atomic_globals_mint_no_names_for_integer_values() -> Bool:
	text = "first = Source\nzero = 0\nleading: Int = 007\nsecond = Source\nblocked = " + unread_value("1 + BodyName") + "\nrecord Later {}"
	existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

	match projected(text, EMPTY_NAME_TABLE):
		Some(projection):
			match (projection.stop, projection.declarations):
				(StoppedAtGlobalInitializer(_), [VarParsedDecl(first), VarParsedDecl(zero), VarParsedDecl(leading), VarParsedDecl(second)]):
					match (first.value, zero.value, leading.value, second.value):
						(ParsedNameExpr(first_name), ParsedIntLiteralExpr("0", _), ParsedIntLiteralExpr("007", _), ParsedNameExpr(second_name)):
							comparison = declaration_prefix_comparison(existing, projection)
							var correct: Bool = (
								existing.diagnostics.is_empty()
								and comparison.differences.is_empty()
								and comparison.completed_declarations == 4
								and first_name.name == second_name.name
								and name_table_spellings(
									projection.names,
								) == [
									"first",
									"Source",
									"zero",
									"leading",
									"Int",
									"second",
									"blocked",
								]
								and name_table_find_id(projection.names, "BodyName").is_none()
								and name_table_find_id(projection.names, "Later").is_none()
							)

							match projected(
								"third = 007\nfourth = Source",
								projection.names,
							):
								Some(next):
									match next.declarations:
										[VarParsedDecl(_), VarParsedDecl(fourth)]:
											match fourth.value:
												ParsedNameExpr(fourth_name):
													correct = (
														correct
														and fourth_name.name == first_name.name
														and name_table_spellings(
															next.names,
														) == name_table_spellings(projection.names)
															.append("third")
															.append("fourth")
													)
												_:
													correct = False
										_:
											correct = False
								None:
									correct = False

							correct
						_:
							False
				_:
					False
		None:
			False


