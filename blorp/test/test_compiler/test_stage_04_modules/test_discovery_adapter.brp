	../../../src/compiler/stage_03_parse/source_ast_finalize: finalized_typecheck_program_ast
	../../../src/compiler/stage_04_modules/frontend_graph:
		FrontendImportResolution(FrontendResolvedImport, FrontendUnresolvedImport),
		frontend_graph_import_edges,
		frontend_graph_modules,
		frontend_graph_name_table,
		frontend_graph_root_modules,
	../../../src/compiler/stage_04_modules/loaded_module: resolved_module_canonical_path
	../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../src/compiler_new/stage_01_discovery/parse/alias_preview:
		AliasPreviewOutcome(PreviewedAlias),
		preview_alias,
	../../../src/compiler_new/stage_01_discovery/parse/builtin_type_preview:
		BuiltinTypePreviewOutcome(PreviewedBuiltinType),
		preview_builtin_type,
	../../../src/compiler_new/stage_01_discovery/parse/parse_state: new_parse_state
	../../../src/compiler_new/stage_01_discovery/parse/preview_source: PreviewSource, preview_source
	../../../src/compiler_new/stage_01_discovery/parse/record_preview:
		RecordPreviewOutcome(PreviewedRecord, RejectedRecordPreview, UnsupportedRecordPreview),
		preview_record,
	../../../src/compiler_new/stage_01_discovery/parse/rejected_preview: rejected_diagnostics
