func test_alias_preview_populates_parameter_bound_and_target_identifier_spellings() -> Bool:
	text: String = "type alias Box[T: m.Eq + Hashable, #N, #_] = T"

	match preview_alias(lex_module(module_id_at_row(0), text)):
		Ok(PreviewedAlias(preview)):
			match legacy_alias_preview(preview):
				Ok(adapted):
					match adapted.declaration:
						TypeAliasParsedDecl(alias_decl):
							match (alias_decl.type_params, alias_decl.target):
								([type_param, dimension, wildcard], target):
									match (type_param.bounds, target):
										([qualified, hashable], ParsedNamedType(target_name, [], _)):
											match qualified.qualifier:
												Some(qualifier):
													(
														not alias_decl.is_opaque
														and name_spelling(
															adapted.names,
															alias_decl.name.name,
														) == Some("Box")
														and name_spelling(
															adapted.names,
															type_param.name.name,
														) == Some("T")
														and name_spelling(
															adapted.names,
															dimension.name.name,
														) == Some("#N")
														and name_spelling(
															adapted.names,
															wildcard.name.name,
														) == Some("#_")
														and name_spelling(
															adapted.names,
															qualifier.name,
														) == Some("m")
														and name_spelling(
															adapted.names,
															qualified.name.name,
														) == Some("Eq")
														and name_spelling(
															adapted.names,
															hashable.name.name,
														) == Some("Hashable")
														and name_spelling(
															adapted.names,
															target_name.name,
														) == Some("T")
													)
												None:
													False
										_:
											False
								_:
									False
						_:
							False
				Err(error):
					False
		_:
			False


