func test_declaration_projection_fails_closed_on_missing_dimension_token() -> Bool:
	lexed = lex_module(module_id_at_row(0), "record Before {}\nrecord Sized { value: Int[#003] }")

	match new_parse_state(lexed):
		Ok(entry):
			(_, scan) = ScanStop.scan_module_declarations(entry)
			broken_source: PreviewSource = {
				source = lexed.source,
				tokens = [],
				hole_tokens = []
			}

			match legacy_declaration_projection(broken_source, scan, EMPTY_NAME_TABLE):
				Err(MissingDimensionLiteralToken(span)):
					span.span_start() == 43 and span.span_end() == 47
				_:
					False
		Err(_):
			False


func test_declaration_projection_fails_closed_on_invalid_global_initializer_cursor() -> Bool:
	lexed = lex_module(module_id_at_row(0), "record Before {}\nvalue: Int = (" + unread_value("1 + 2") + ")")

	match new_parse_state(lexed):
		Ok(entry):
			(_, scan) = ScanStop.scan_module_declarations(entry)

			match unread_global(scan):
				Some((unread, preview)):
					var correct: Bool = True

					for token_start in [
						0,
						preview.initializer.token_start - 1,
						preview.initializer.token_start + 1,
						lexed.tokens.length(),
					]:
						changed = { scan |
							stop = ScanStop.StoppedAtUnreadDeclaration({ unread |
								header = ScanStop.UnreadGlobalInitializer(
									{ preview |
										initializer = { preview.initializer |
											token_start = token_start
										}
									},
								)
							})
						}

						match legacy_declaration_projection(
							preview_source(lexed),
							changed,
							EMPTY_NAME_TABLE,
						):
							Err(InvalidGlobalInitializerEntry(_)):
								void
							_:
								correct = False

					match (
						legacy_declaration_projection(
							{
								source = lexed.source,
								tokens = [],
								hole_tokens = []
							},
							scan,
							EMPTY_NAME_TABLE,
						)
					):
						Err(InvalidGlobalInitializerEntry(_)):
							correct
						_:
							False
				_:
					False
		Err(_):
			False


-- Prefix comparison is partial evidence: the old parser owns the whole program,
-- while the projection supplies completed declarations and a typed boundary.
func prefix_matches(
	text: String,
	count: Int,
	kinds: List[DeclarationPrefixKind],
	stop: DeclarationPrefixStopKind,
) -> Bool:
	existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

	match projected(text, EMPTY_NAME_TABLE):
		Some(projection):
			comparison = declaration_prefix_comparison(existing, projection)

			for difference in comparison.differences:
				print(
					"prefix difference ${difference.path}: ${difference.old_text} -> ${difference.new_text}",
				)

			(
				existing.diagnostics.is_empty()
				and comparison.differences.is_empty()
				and comparison.completed_declarations == count
				and comparison.declaration_kinds == kinds
				and comparison.stop == stop
			)
		None:
			False


func test_prefix_comparison_covers_completed_kinds_once_in_source_order() -> Bool:
	prefix_matches(
		"record First {}\nrecord Second {}\nrecord Point {}\nfixed record Pair {}\nrecord OtherPoint {}\nfixed record OtherPair {}\ntype alias Alias = Int\ntype Buffer = builtin\nresource type File = builtin\nunion Choice:\n\tOne\nfixed union Color:\n\tRed\nimport:\n\theap\nforeign:\n\tfunc read() -> Int\n",
		13,
		[
			RecordPrefix,
			FixedRecordPrefix,
			AliasPrefix,
			BuiltinTypePrefix,
			ResourceTypePrefix,
			UnionPrefix,
			FixedUnionPrefix,
			ImportBlockPrefix,
			ForeignBlockPrefix,
		],
		EndOfSourcePrefixStop,
	)


func test_prefix_comparison_reports_changed_completed_field_and_order() -> Bool:
	text = "record First { value: Int }\nrecord Second {}"
	existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

	match projected(text, EMPTY_NAME_TABLE):
		Some(projection):
			match projection.declarations:
				[RecordParsedDecl(first), second]:
					changed: LegacyDeclarationProjection = { projection |
						declarations = [RecordParsedDecl({ first | fields = [] }), second]
					}
					reordered: LegacyDeclarationProjection = { projection |
						declarations = [second, RecordParsedDecl(first)]
					}
					field_result = declaration_prefix_comparison(existing, changed)
					order_result = declaration_prefix_comparison(existing, reordered)
					(
						field_result.completed_declarations == 2
						and field_result.differences.any(
							pure func(
								difference,
							): difference.path == "decls[0].record.fields.length",
						)
						and order_result.differences.any(
							pure func(difference): difference.path == "decls[0].name",
						)
					)
				_:
					False
		None:
			False


func test_prefix_comparison_reports_module_documentation_text_and_span() -> Bool:
	text = "---\nModule doc.\n---\nimport:\n\theap\nrecord Item {}"
	existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

	match projected(text, EMPTY_NAME_TABLE):
		Some(projection):
			match projection.module_doc:
				Some(documentation):
					changed: LegacyDeclarationProjection = { projection |
						module_doc = Some({ documentation | text = "Different doc." })
					}
					missing: LegacyDeclarationProjection = { projection | module_doc = None }
					var span_differs: Bool = False

					match existing.decls.get(0):
						Some(declaration):
							wrong_span: LegacyDeclarationProjection = { projection |
								module_doc = Some(
									{ documentation | span = parsed_decl_location(declaration) },
								)
							}
							span_differs = not declaration_prefix_comparison(
								existing,
								wrong_span,
							).differences.is_empty()
						None:
							void

					changed_result = declaration_prefix_comparison(existing, changed)
					missing_result = declaration_prefix_comparison(existing, missing)
					(
						changed_result.differences.any(
							pure func(difference): difference.path == "module_doc.text",
						)
						and not missing_result.differences.is_empty()
						and span_differs
					)
				None:
					False
		None:
			False


func test_prefix_comparison_validates_forward_authored_and_private_functions() -> Bool:
	var correct: Bool = True

	for deferred in [
		"func next() -> Int: " + unread_value("1"),
		"func next() -> Int:" + unread_block("\t", "items"),
		"private func next() -> Int: " + unread_value("1"),
		"---\nDoc.\n---\nprivate pure func next() -> Int: " + unread_value("1"),
	]:
		correct = prefix_matches(
			"record Before {}\n${deferred}\nrecord After {}",
			1,
			[RecordPrefix, FunctionPrefix],
			FunctionHeaderPrefixStop,
		) and correct

	-- A forward declaration is read in full, so a paired one is compared as a
	-- whole declaration, its frozen shorter span included.
	for paired in [
		"func next() -> Int:\n\nfunc next() -> Int: 1",
		"func next() -> Int :\n\nfunc next() -> Int: 1",
		"func next():\n\nfunc next(): ()",
	]:
		correct = prefix_matches(
			"record Before {}\n${paired}\nrecord After {}",
			4,
			[RecordPrefix, FunctionPrefix],
			EndOfSourcePrefixStop,
		) and correct

	correct


private FUNCTION_HEADER_SOURCE: String = "---\nApply a value.\n---\nprivate @tail_recursive pure func apply[T: m.Eq + Hashable, #N](value: T, (left, right): (Int, Int), _: Int) -> T[#N] where #N == #3:"


func test_function_header_projection_compares_rich_authored_and_forward_headers() -> Bool:
	var correct: Bool = True

	-- Pair the forward declaration so the independent old module oracle accepts
	-- it. A forward declaration is read in full, so the projection stops at the
	-- definition after it, whose body it does not read.
	for (text, completed) in [
		(FUNCTION_HEADER_SOURCE + unread_block("\t", "value") + "\nrecord Later {}", 0),
		(
			FUNCTION_HEADER_SOURCE + "\n\n" + FUNCTION_HEADER_SOURCE + unread_block("\t", "value") + "\nrecord Later {}",
			1,
		),
	]:
		existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

		match projected(text, EMPTY_NAME_TABLE):
			Some(projection):
				match projection.stop:
					StoppedAtFunctionHeader(preview):
						-- These types exclude a ParsedFunctionDecl and its body.
						translated: LegacyFunctionHeaderPreview = preview
						header: ParsedFunctionHeader = translated.header

						comparison = declaration_prefix_comparison(existing, projection)
						correct = (
							correct
							and existing.diagnostics.is_empty()
							and projection.declarations.length() == completed
							and comparison.differences.is_empty()
							and comparison.completed_declarations == completed
							and comparison.declaration_kinds == [FunctionPrefix]
							and translated.visibility == PrivateVisibility
							and header.name.text == "apply"
							and header.keyword_span.is_some()
							and header.type_params.length() == 2
							and header.params.length() == 3
							and header.return_type.is_some()
							and header.dim_constraints.length() == 1
							and header.is_pure
							and header.annotations.length() == 1
							and header.doc == Some("Apply a value.")
						)
					_:
						correct = False
			None:
				correct = False

	correct


private func changed_function_header_reports(
	existing: ParsedProgram,
	projection: LegacyDeclarationProjection,
	preview: LegacyFunctionHeaderPreview,
	changed: ParsedFunctionHeader,
	path: String,
) -> Bool:
	comparison = declaration_prefix_comparison(
		existing,
		{ projection | stop = StoppedAtFunctionHeader({ preview | header = changed }) },
	)
	(
		comparison.differences.any(pure func(difference): difference.path == path)
		and comparison.declaration_kinds.is_empty()
	)


func test_function_header_comparison_reports_independent_structural_mutations() -> Bool:
	text = FUNCTION_HEADER_SOURCE + unread_block("\t", "value")
	existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

	match projected(text, EMPTY_NAME_TABLE):
		Some(projection):
			match projection.stop:
				StoppedAtFunctionHeader(preview):
					header = preview.header

					match (
						header.type_params.get(0),
						header.params.get(0),
						header.dim_constraints.get(0),
					):
						(Some(parameter), Some(argument), Some(constraint)):
							match parameter.bounds.get(0):
								Some(bound):
									(extended, changed_index) = name_table_intern(
										projection.names,
										"ChangedHeaderName",
									)
									changed_name = { header.name |
										name = name_id_from_interned_index(changed_index),
										text = "ChangedHeaderName"
									}
									changed_bound = { bound | name = { bound.name |
											name = changed_name.name,
											text = changed_name.text
										} }
									changed_type = ParsedNamedType(changed_name, [], argument.span)
									named_projection = { projection | names = extended }
									var correct: Bool = (
										existing.diagnostics.is_empty()
										and declaration_prefix_comparison(
											existing,
											named_projection,
										).differences.is_empty()
									)
									changes: List[(ParsedFunctionHeader, String)] = [
										({ header | name = changed_name }, "stop.header.name.text"),
										(
											{ header |
												type_params = [
													{ parameter |
														bounds = [
															changed_bound,
														].concat(parameter.bounds.drop(1))
													},
												].concat(header.type_params.drop(1))
											},
											"stop.header.type_params[0].bounds[0].name.text",
										),
										(
											{ header |
												params = [
													{ argument |
														type_expr = Some(changed_type)
													},
												].concat(header.params.drop(1))
											},
											"stop.header.params[0].type.name.text",
										),
										(
											{ header |
												params = [
													{ argument |
														span = header.name.span
													},
												].concat(header.params.drop(1))
											},
											"stop.header.params[0].span.start_column",
										),
										(
											{ header | annotations = [ParsedNoCopyAnnotation] },
											"stop.header.annotations[0]",
										),
										({ header | is_pure = False }, "stop.header.is_pure"),
										(
											{ header | return_type = Some(changed_type) },
											"stop.header.return_type.kind",
										),
										(
											{ header |
												dim_constraints = [
													{ constraint | right = changed_type },
												]
											},
											"stop.header.dim_constraints[0].right.kind",
										),
										(
											{ header | doc = Some("Changed documentation.") },
											"stop.header.doc",
										),
										(
											{ header | keyword_span = Some(header.name.span) },
											"stop.header.keyword_span.start_column",
										),
									]

									for (changed, path) in changes:
										correct = (
											changed_function_header_reports(
												existing,
												named_projection,
												preview,
												changed,
												path,
											)
											and correct
										)

									visibility_comparison = declaration_prefix_comparison(
										existing,
										{ named_projection |
											stop = StoppedAtFunctionHeader(
												{ preview | visibility = PublicVisibility },
											)
										},
									)
									(
										correct
										and visibility_comparison.differences.any(
											pure func(
												difference,
											): difference.path == "stop.visibility",
										)
										and visibility_comparison.declaration_kinds.is_empty()
									)
								None:
									False
						_:
							False
				_:
					False
		None:
			False


func test_function_header_stop_threads_authored_names_into_next_module() -> Bool:
	text = "record Before {}\n" + FUNCTION_HEADER_SOURCE + unread_block("\t", "BodyOnlyName") + "\nrecord LaterOnlyName {}"

	match projected(text, EMPTY_NAME_TABLE):
		Some(first):
			match first.stop:
				StoppedAtFunctionHeader(preview):
					-- A colon after `_` takes the named-parameter path in both
					-- parsers, so this typed underscore is interned in authored order.
					var correct: Bool = (
						first.declarations.length() == 1
						and name_table_spellings(
							first.names,
						) == [
							"Before",
							"apply",
							"T",
							"m",
							"Eq",
							"Hashable",
							"#N",
							"value",
							"left",
							"right",
							"Int",
							"_",
						]
					)
					correct = (
						correct
						and name_table_find_id(first.names, "BodyOnlyName").is_none()
						and name_table_find_id(first.names, "LaterOnlyName").is_none()
						and name_spelling(first.names, preview.header.name.name) == Some("apply")
					)

					match projected("record Next { value: T }", first.names):
						Some(second):
							match (second.stop, second.declarations):
								(ReachedEndOfSource, [RecordParsedDecl(next_record)]):
									match next_record.fields:
										[field]:
											match field.type_expr:
												ParsedNamedType(target, [], _):
													(
														correct
														and name_table_spellings(
															second.names,
														) == name_table_spellings(
															first.names,
														).append("Next")
														and name_table_find_id(
															first.names,
															"T",
														) == Some(target.name)
														and name_table_find_id(
															first.names,
															"value",
														) == Some(field.name.name)
													)
												_:
													False
										_:
											False
								_:
									False
						None:
							False
				_:
					False
		None:
			False


func test_prefix_comparison_validates_trait_and_implementation_private_outer_spans() -> Bool:
	var correct: Bool = True

	for prefix in ["", "private ", "---\nDoc.\n---\nprivate "]:
		correct = prefix_matches(
			"record Before {}\n${prefix}trait Next:\n\tfunc method() -> Int: " + unread_value("1") + "\nrecord After {}",
			1,
			[RecordPrefix, TraitPrefix],
			TraitPreviewPrefixStop,
		) and correct
		correct = prefix_matches(
			"record Before {}\n${prefix}implements Eq for Int:\n\tfunc equals(self: Int, other: Int) -> Bool: " + unread_value("True") + "\nrecord After {}",
			1,
			[RecordPrefix, ImplementationPrefix],
			ImplementationPreviewPrefixStop,
		) and correct

	correct


func test_prefix_comparison_rejects_wrong_next_kind_start_and_outside_extent() -> Bool:
	var correct: Bool = True

	wrong_kind = match projected("wrong = " + unread_value("1"), EMPTY_NAME_TABLE):
		Some(projection):
			projection.stop
		None:
			StoppedAtRejectedDeclaration

	for deferred in [
		"private func next() -> Int: " + unread_value("1"),
		"private trait Next:\n\tfunc method() -> Int: " + unread_value("1"),
		"private implements Eq for Int:\n\tfunc equals(self: Int, other: Int) -> Bool: " + unread_value("True"),
	]:
		text = "record Before {}\n${deferred}"
		existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

		match projected(text, EMPTY_NAME_TABLE):
			Some(projection):
				boundary: Span = match projection.stop:
					StoppedAtFunctionHeader(preview):
						preview.header_span
					StoppedAtTraitPreview(preview):
						preview.header_span
					StoppedAtImplementationPreview(preview):
						preview.header_span
					_:
						correct = False
						pack_span(source_id_at_row(0), 0, 0)

				shifted = pack_span(
					boundary.span_source(),
					boundary.span_start() + 1,
					boundary.span_end(),
				)
				outside = pack_span(
					boundary.span_source(),
					boundary.span_start(),
					text.length() + 1,
				)

				for (span, path) in [(shifted, "stop.start"), (outside, "stop.end")]:
					changed_stop: LegacyDeclarationProjectionStop = match projection.stop:
						StoppedAtFunctionHeader(preview):
							StoppedAtFunctionHeader({ preview | header_span = span })
						StoppedAtTraitPreview(preview):
							StoppedAtTraitPreview({ preview | header_span = span })
						StoppedAtImplementationPreview(preview):
							StoppedAtImplementationPreview({ preview | header_span = span })
						_:
							ReachedEndOfSource

					changed: LegacyDeclarationProjection = { projection | stop = changed_stop }
					comparison = declaration_prefix_comparison(existing, changed)
					correct = (
						comparison.differences.any(pure func(difference): difference.path == path)
						and correct
					)
					correct = comparison.declaration_kinds == [RecordPrefix] and correct

				kind_result = declaration_prefix_comparison(
					existing,
					{ projection | stop = wrong_kind },
				)
				correct = (
					kind_result.differences.any(
						pure func(difference): difference.path == "stop.kind",
					)
					and correct
				)
			None:
				correct = False

	correct


func test_prefix_comparison_rejects_premature_eof_extra_old_declarations_and_missing_next() -> Bool:
	text = "record Before {}\nfunc next() -> Int: " + unread_value("1") + "\nrecord After {}"
	existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

	match projected(text, EMPTY_NAME_TABLE):
		Some(projection):
			premature = declaration_prefix_comparison(
				existing,
				{ projection | stop = ReachedEndOfSource },
			)
			missing = declaration_prefix_comparison(
				{ existing | decls = existing.decls.take(1) },
				projection,
			)
			short_old = declaration_prefix_comparison({ existing | decls = [] }, projection)
			(
				premature.differences.any(pure func(difference): difference.path == "prefix.length")
				and not missing.differences.is_empty()
				and not short_old.differences.is_empty()
				and missing.declaration_kinds == [RecordPrefix]
			)
		None:
			False


func test_prefix_comparison_validates_constant_mutable_private_and_grouped_globals() -> Bool:
	var correct: Bool = True

	for global in [
		"value = (" + unread_value("1") + ")",
		"value: Int = (" + unread_value("1 + 2") + ")",
		"---\nDoc.\n---\nprivate value: Int = (" + unread_value("1") + ")",
	]:
		correct = prefix_matches(
			"record Before {}\n${global}\nrecord After {}",
			1,
			[RecordPrefix, ConstantGlobalPrefix],
			GlobalInitializerPrefixStop,
		) and correct

	for global in [
		"var value = (" + unread_value("1") + ")",
		"private var value: Int = (" + unread_value("1 + 2") + ")",
		"---\nDoc.\n---\nprivate var value: Int = (" + unread_value("1") + ")",
	]:
		correct = prefix_matches(
			"record Before {}\n${global}\nrecord After {}",
			1,
			[RecordPrefix, MutableGlobalPrefix],
			GlobalInitializerPrefixStop,
		) and correct

	correct


private GLOBAL_HEADER_TYPE: String = "m.Box[List[n.Item], #03, #N]"


func test_global_header_projection_compares_public_private_mutable_and_optional_types() -> Bool:
	var correct: Bool = True

	for prefix in [
		"",
		"private ",
		"---\nGlobal documentation.\n---\n",
		"---\nGlobal documentation.\n---\nprivate ",
	]:
		for mutable in [False, True]:
			for written_type in ["", ": Int", ": ${GLOBAL_HEADER_TYPE}"]:
				binding = if mutable:
					"var global"
				else:
					"global"

				text = "record Before {}\n${prefix}${binding}${written_type} = " + unread_value("InitializerOnlyName") + "\nrecord LaterOnlyName {}"
				existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

				match projected(text, EMPTY_NAME_TABLE):
					Some(projection):
						match projection.stop:
							StoppedAtGlobalInitializer(preview):
								translated: LegacyGlobalHeaderPreview = preview
								-- ParsedVarHeader has no initializer/value field.
								header: ParsedVarHeader = translated.header
								comparison = declaration_prefix_comparison(existing, projection)

								kind = if mutable:
									MutableGlobalPrefix
								else:
									ConstantGlobalPrefix

								correct = (
									correct
									and existing.diagnostics.is_empty()
									and comparison.differences.is_empty()
									and projection.declarations.length() == 1
									and comparison.completed_declarations == 1
									and comparison.declaration_kinds == [RecordPrefix, kind]
									and header.name.text == "global"
									and header.is_mutable == mutable
									and header.type_expr.is_some() == (written_type != "")
									and header.doc.is_some() == prefix.starts_with("---")
									and translated.visibility == PrivateVisibility == prefix.contains(
										"private",
									)
								)
							_:
								correct = False
					None:
						correct = False

	correct


func test_global_header_comparison_reports_independent_structural_mutations() -> Bool:
	text = "record Before {}\n---\nGlobal documentation.\n---\nprivate var global: ${GLOBAL_HEADER_TYPE} = " + unread_value("InitializerOnlyName")
	existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

	match projected(text, EMPTY_NAME_TABLE):
		Some(projection):
			match projection.stop:
				StoppedAtGlobalInitializer(preview):
					header = preview.header

					match header.type_expr:
						Some(ParsedQualifiedNamedType(qualifier, name, [ParsedNamedType(list_name, [nested], list_span), ParsedDimLiteralType(digits, dimension_span), dimension_name], type_span)):
							match nested:
								ParsedQualifiedNamedType(nested_qualifier, nested_name, [], nested_span):
									(extended, changed_index) = name_table_intern(
										projection.names,
										"ChangedGlobalName",
									)
									changed_name = { header.name |
										name = name_id_from_interned_index(changed_index),
										text = "ChangedGlobalName"
									}
									changed_nested = ParsedQualifiedNamedType(
										nested_qualifier,
										{ nested_name |
											name = changed_name.name,
											text = changed_name.text
										},
										[],
										nested_span,
									)
									original_list = ParsedNamedType(list_name, [nested], list_span)
									original_dimension = ParsedDimLiteralType(
										digits,
										dimension_span,
									)
									arguments = [original_list, original_dimension, dimension_name]
									named_projection = { projection | names = extended }
									var correct: Bool = (
										existing.diagnostics.is_empty()
										and declaration_prefix_comparison(
											existing,
											named_projection,
										).differences.is_empty()
									)
									changes: List[(ParsedVarHeader, String)] = [
										({ header | name = changed_name }, "stop.header.name.text"),
										(
											{ header | name = { header.name | span = type_span } },
											"stop.header.name.span.start_column",
										),
										(
											{ header | type_expr = Some(
													ParsedQualifiedNamedType(
														qualifier,
														name,
														[
															ParsedNamedType(
																list_name,
																[changed_nested],
																list_span,
															),
															original_dimension,
															dimension_name,
														],
														type_span,
													),
												) },
											"stop.header.type.args[0].args[0].name.text",
										),
										(
											{ header | type_expr = Some(
													ParsedQualifiedNamedType(
														{ qualifier |
															name = changed_name.name,
															text = changed_name.text
														},
														name,
														arguments,
														type_span,
													),
												) },
											"stop.header.type.module.text",
										),
										(
											{ header | type_expr = Some(
													ParsedQualifiedNamedType(
														qualifier,
														name,
														[
															original_list,
															ParsedDimLiteralType(
																"04",
																dimension_span,
															),
															dimension_name,
														],
														type_span,
													),
												) },
											"stop.header.type.args[1].value",
										),
										(
											{ header |
												type_expr = Some(
													ParsedQualifiedNamedType(
														qualifier,
														name,
														arguments,
														header.name.span,
													),
												)
											},
											"stop.header.type.span.start_column",
										),
										({ header | type_expr = None }, "stop.header.type"),
										({ header | is_mutable = False }, "stop.header.is_mutable"),
										(
											{ header | doc = Some("Changed documentation.") },
											"stop.header.doc",
										),
									]

									for (changed, path) in changes:
										comparison = declaration_prefix_comparison(
											existing,
											{ named_projection |
												stop = StoppedAtGlobalInitializer(
													{ preview | header = changed },
												)
											},
										)
										correct = (
											correct
											and comparison.differences.any(
												pure func(difference): difference.path == path,
											)
											and comparison.declaration_kinds == [RecordPrefix]
											and comparison.completed_declarations == 1
										)

									visibility_comparison = declaration_prefix_comparison(
										existing,
										{ named_projection |
											stop = StoppedAtGlobalInitializer(
												{ preview | visibility = PublicVisibility },
											)
										},
									)
									(
										correct
										and visibility_comparison.differences.any(
											pure func(
												difference,
											): difference.path == "stop.visibility",
										)
										and visibility_comparison.declaration_kinds == [
											RecordPrefix,
										]
									)
								_:
									False
						_:
							False
				_:
					False
		None:
			False


func test_global_header_stop_threads_only_selected_header_names_across_modules() -> Bool:
	text = "record Before {}\nglobal: ${GLOBAL_HEADER_TYPE} = " + unread_value("InitializerOnlyName") + "\nrecord LaterOnlyName {}"

	match projected(text, EMPTY_NAME_TABLE):
		Some(first):
			match first.stop:
				StoppedAtGlobalInitializer(preview):
					match projected("record Next { global: ${GLOBAL_HEADER_TYPE} }", first.names):
						Some(second):
							match second.declarations:
								[RecordParsedDecl(next_record)]:
									match next_record.fields:
										[field]:
											(
												name_table_spellings(
													first.names,
												) == [
													"Before",
													"global",
													"m",
													"Box",
													"List",
													"n",
													"Item",
													"#N",
												]
												and name_table_find_id(
													first.names,
													"InitializerOnlyName",
												).is_none()
												and name_table_find_id(
													first.names,
													"LaterOnlyName",
												).is_none()
												and name_spelling(
													first.names,
													preview.header.name.name,
												) == Some("global")
												and field.name.name == preview.header.name.name
												and name_table_spellings(
													second.names,
												) == name_table_spellings(
													first.names,
												).append("Next")
											)
										_:
											False
								_:
									False
						None:
							False
				_:
					False
		None:
			False


func test_function_stop_excludes_a_later_global_header_names() -> Bool:
	text = "record Before {}\nfunc chosen(value: Int) -> Int: " + unread_value("BodyOnlyName") + "\nlater_global: m.LaterType = InitializerOnlyName"

	match projected(text, EMPTY_NAME_TABLE):
		Some(projection):
			match projection.stop:
				StoppedAtFunctionHeader(_):
					(
						projection.declarations.length() == 1
						and name_table_spellings(
							projection.names,
						) == ["Before", "chosen", "value", "Int"]
						and name_table_find_id(projection.names, "later_global").is_none()
						and name_table_find_id(projection.names, "LaterType").is_none()
						and name_table_find_id(projection.names, "m").is_none()
					)
				_:
					False
		None:
			False


func test_prefix_comparison_global_anchor_is_declaration_start_not_grouped_expression_start(

) -> Bool:
	text = "record Before {}\nprivate var value: Int = (" + unread_value("1 + 2") + ")"
	existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

	match projected(text, EMPTY_NAME_TABLE):
		Some(projection):
			match projection.stop:
				StoppedAtGlobalInitializer(preview):
					anchor = preview.initializer.anchor
					wrong_anchor = pack_span(
						anchor.span_source(),
						text.length() - 7,
						text.length() - 6,
					)
					changed = { preview |
						initializer = { preview.initializer | anchor = wrong_anchor }
					}
					comparison = declaration_prefix_comparison(
						existing,
						{ projection | stop = StoppedAtGlobalInitializer(changed) },
					)
					(
						anchor.span_start() == "record Before {}\n".length()
						and comparison.differences.any(
							pure func(difference): difference.path == "stop.start",
						)
						and comparison.declaration_kinds == [RecordPrefix]
					)
				_:
					False
		None:
			False


func test_prefix_comparison_global_initializer_entry_preserves_layout_and_grouping() -> Bool:
	var correct: Bool = True

	for initializer in ["(" + unread_value("1 + 2") + ")", "\n\t(1 + 2)", "-- comment before value\n\t(1 + 2)"]:
		correct = prefix_matches(
			"record Before {}\nprivate var value: Int = ${initializer}",
			1,
			[RecordPrefix, MutableGlobalPrefix],
			GlobalInitializerPrefixStop,
		) and correct

	correct


func test_prefix_comparison_rejects_changed_global_header_evidence() -> Bool:
	text = "record Before {}\n---\nDoc.\n---\nprivate var value: Int = (" + unread_value("1") + ")"
	existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

	match projected(text, EMPTY_NAME_TABLE):
		Some(projection):
			match projection.stop:
				StoppedAtGlobalInitializer(preview):
					header_span = preview.header_span
					wrong_header_start = pack_span(
						header_span.span_source(),
						header_span.span_start() + 1,
						header_span.span_end(),
					)
					wrong_header_end = pack_span(
						header_span.span_source(),
						header_span.span_start(),
						text.length() + 1,
					)
					shortened_header_end = pack_span(
						header_span.span_source(),
						header_span.span_start(),
						header_span.span_end() - 1,
					)
					extended_header_end = pack_span(
						header_span.span_source(),
						header_span.span_start(),
						header_span.span_end() + 2,
					)
					var correct: Bool = True

					for changed_span in [
						wrong_header_start,
						wrong_header_end,
						shortened_header_end,
						extended_header_end,
					]:
						changed = { preview | header_span = changed_span }
						comparison = declaration_prefix_comparison(
							existing,
							{ projection | stop = StoppedAtGlobalInitializer(changed) },
						)
						correct = (
							not comparison.differences.is_empty()
							and comparison.declaration_kinds == [RecordPrefix]
							and correct
						)

					correct
				_:
					False
		None:
			False


func test_prefix_comparison_rejects_changed_global_initializer_entry() -> Bool:
	text = "record Before {}\nprivate var value: Int = (" + unread_value("1 + 2") + ")"
	existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

	match projected(text, EMPTY_NAME_TABLE):
		Some(projection):
			match projection.stop:
				StoppedAtGlobalInitializer(preview):
					var correct: Bool = True
					entry = preview.initializer.initializer_entry
					equal = preview.initializer.assignment_equal

					for initializer in [
						{ preview.initializer | initializer_entry = equal },
						{ preview.initializer |
							initializer_entry = pack_span(
								entry.span_source(),
								entry.span_start() + 1,
								entry.span_end() + 1,
							)
						},
						{ preview.initializer | assignment_equal = entry },
					]:
						changed = { preview | initializer = initializer }
						comparison = declaration_prefix_comparison(
							existing,
							{ projection | stop = StoppedAtGlobalInitializer(changed) },
						)
						correct = (
							not comparison.differences.is_empty()
							and comparison.declaration_kinds == [RecordPrefix]
							and correct
						)

					correct
				_:
					False
		None:
			False


func test_prefix_comparison_rejects_old_parser_diagnostics() -> Bool:
	text = "record Before {}\n123"
	existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

	match projected("record Before {}", EMPTY_NAME_TABLE):
		Some(projection):
			comparison = declaration_prefix_comparison(existing, projection)
			(
				not existing.diagnostics.is_empty()
				and comparison.differences.any(
					pure func(difference): difference.path == "old.diagnostics",
				)
			)
		None:
			False


func test_prefix_comparison_rejected_and_no_progress_stops_are_always_differences() -> Bool:
	text = "record Before {}"
	existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

	match (
		projected(text, EMPTY_NAME_TABLE),
		projected("record Before {}\nif = 1", EMPTY_NAME_TABLE),
	):
		(Some(projection), Some(rejected)):
			var correct: Bool = True

			for (stop, kind) in [
				(StoppedAtRejectedDeclaration, RejectedDeclarationPrefixStop),
				(StoppedWithoutDeclarationProgress, WithoutProgressPrefixStop),
				(rejected.stop, RejectedGlobalInitializerPrefixStop),
			]:
				comparison = declaration_prefix_comparison(existing, { projection | stop = stop })
				correct = (
					comparison.stop == kind
					and comparison.completed_declarations == 1
					and comparison.declaration_kinds == [RecordPrefix]
					and comparison.differences.any(
						pure func(difference): difference.path == "stop.rejected",
					)
					and correct
				)

			correct
		_:
			False


private TRAIT_HEADER_SOURCE: String = "---\nTrait documentation.\n---\nprivate trait Shape[T: m.Eq + Hashable, #N]: m.Base + Printable:\n\tpure func area(self: T, pair: (Int, Int), _: Int) -> m.Output[#N]\n\tfunc describe(self: T) -> String:\n\t\tfor item in BodyOnlyName concurrently(limit: 2):\n\t\t\titem"

private IMPLEMENTATION_HEADER_SOURCE: String = "---\nImplementation documentation.\n---\nprivate implements Shape for m.Box[List[n.Item], #03, #N]:\n\t@tail_recursive\n\tpure func apply[T: m.Eq, #M](self: m.Box[T], value: T) -> T where #M == #N:\n\t\tfor item in BodyOnlyName concurrently(limit: 2):\n\t\t\titem\n\tfunc describe(self: m.Box[Int]) -> String: into_opaque Count(OtherBodyOnlyName)"


func test_trait_header_projection_preserves_structural_syntax() -> Bool:
	text = "record Before {}\n${TRAIT_HEADER_SOURCE}\nrecord LaterOnlyName {}"
	existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

	match projected(text, EMPTY_NAME_TABLE):
		Some(projection):
			match projection.stop:
				StoppedAtTraitPreview(preview):
					translated: LegacyTraitHeaderPreview = preview
					header: ParsedTraitHeader = legacy_trait_header(translated)
					comparison = declaration_prefix_comparison(existing, projection)
					(
						existing.diagnostics.is_empty()
						and comparison.differences.is_empty()
						and comparison.completed_declarations == 1
						and comparison.declaration_kinds == [RecordPrefix, TraitPrefix]
						and header.name.text == "Shape"
						and header.type_params.length() == 2
						and header.supertraits.length() == 2
						and header.methods.is_empty()
						and header.doc == Some("Trait documentation.")
						and translated.visibility == PrivateVisibility
					)
				_:
					False
		None:
			False


func test_implementation_header_projection_preserves_structural_syntax() -> Bool:
	text = "record Before {}\n${IMPLEMENTATION_HEADER_SOURCE}\nrecord LaterOnlyName {}"
	existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

	match projected(text, EMPTY_NAME_TABLE):
		Some(projection):
			match projection.stop:
				StoppedAtImplementationPreview(preview):
					translated: LegacyImplementationHeaderPreview = preview
					header: ParsedImplHeader = legacy_implementation_header(translated)
					comparison = declaration_prefix_comparison(existing, projection)
					(
						existing.diagnostics.is_empty()
						and comparison.differences.is_empty()
						and comparison.completed_declarations == 1
						and comparison.declaration_kinds == [RecordPrefix, ImplementationPrefix]
						and header.trait_name.text == "Shape"
						and header.methods.is_empty()
						and header.doc == Some("Implementation documentation.")
						and translated.visibility == PrivateVisibility
					)
				_:
					False
		None:
			False


func test_trait_and_implementation_stop_names_follow_header_order_across_modules() -> Bool:
	var correct: Bool = True

	for (header_source, expected) in (
		[
			(
				TRAIT_HEADER_SOURCE,
				[
					"Before",
					"Shape",
					"T",
					"m",
					"Eq",
					"Hashable",
					"#N",
					"Base",
					"Printable",
				],
			),
			(
				IMPLEMENTATION_HEADER_SOURCE,
				[
					"Before",
					"Shape",
					"m",
					"Box",
					"List",
					"n",
					"Item",
					"#N",
				],
			),
		]
	):
		match projected(
			"record Before {}\n${header_source}\nrecord LaterOnlyName {}",
			EMPTY_NAME_TABLE,
		):
			Some(first):
				correct = (
					correct
					and name_table_spellings(first.names) == expected
					and name_table_find_id(first.names, "BodyOnlyName").is_none()
					and name_table_find_id(first.names, "OtherBodyOnlyName").is_none()
					and name_table_find_id(first.names, "LaterOnlyName").is_none()
				)

				-- The owner's methods are not read, so only its header's names are
				-- shared with the next module.
				match projected("record Next { value: Shape }", first.names):
					Some(second):
						match second.declarations:
							[RecordParsedDecl(next_record)]:
								match next_record.fields:
									[field]:
										match field.type_expr:
											ParsedNamedType(target, [], _):
												correct = (
													correct
													and name_table_spellings(
														second.names,
													) == expected.append("Next").append("value")
													and name_table_find_id(
														first.names,
														"value",
													).is_none()
													and name_table_find_id(
														first.names,
														"Shape",
													) == Some(target.name)
												)
											_:
												correct = False
									_:
										correct = False
							_:
								correct = False
					None:
						correct = False
			None:
				correct = False

	correct


func test_trait_and_implementation_comparison_rejects_changed_header_evidence() -> Bool:
	var correct: Bool = True

	for text in [TRAIT_HEADER_SOURCE, IMPLEMENTATION_HEADER_SOURCE]:
		existing = parse_compiler_source(source_file(ROOT_PATH, ROOT_MODULE_NAME, text))

		match projected(text, EMPTY_NAME_TABLE):
			Some(projection):
				correct = (
					correct
					and existing.diagnostics.is_empty()
					and declaration_prefix_comparison(existing, projection).differences.is_empty()
				)

				match projection.stop:
					StoppedAtTraitPreview(preview):
						shifted = pack_span(
							preview.header_span.span_source(),
							preview.header_span.span_start() + 1,
							preview.header_span.span_end(),
						)
						for changed in (
							[
								{ preview | doc = Some("Changed documentation.") },
								{ preview | visibility = PublicVisibility },
								{ preview | header_span = shifted },
								{ preview | supertraits = preview.supertraits.reverse() },
							]
						):
							comparison = declaration_prefix_comparison(
								existing,
								{ projection | stop = StoppedAtTraitPreview(changed) },
							)
							correct = (
								correct
								and not comparison.differences.is_empty()
								and comparison.declaration_kinds.is_empty()
							)
					StoppedAtImplementationPreview(preview):
						shifted = pack_span(
							preview.header_span.span_source(),
							preview.header_span.span_start() + 1,
							preview.header_span.span_end(),
						)
						for changed in (
							[
								{ preview | doc = Some("Changed documentation.") },
								{ preview | visibility = PublicVisibility },
								{ preview | header_span = shifted },
							]
						):
							comparison = declaration_prefix_comparison(
								existing,
								{ projection |
									stop = StoppedAtImplementationPreview(changed)
								},
							)
							correct = (
								correct
								and not comparison.differences.is_empty()
								and comparison.declaration_kinds.is_empty()
							)

						changed_receiver = match preview.for_type:
							ParsedQualifiedNamedType(qualifier, _, arguments, span):
								ParsedQualifiedNamedType(
									qualifier,
									preview.trait_name,
									arguments,
									span,
								)
							written:
								written

						receiver_comparison = declaration_prefix_comparison(
							existing,
							{ projection |
								stop = StoppedAtImplementationPreview(
									{ preview | for_type = changed_receiver },
								)
							},
						)
						correct = (
							correct
							and receiver_comparison.differences.any(
								pure func(
									difference,
								): difference.path == "stop.header.for_type.name.text",
							)
							and receiver_comparison.declaration_kinds.is_empty()
						)
					_:
						correct = False
			None:
				correct = False

	correct


func test_the_stages_seed_names_equal_the_existing_vocabulary() -> Bool:
	SEEDED_NAME_SPELLINGS == name_table_synthesized_spellings()


