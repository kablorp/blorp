func test_record_preview_preserves_wildcard_parameter_spelling_and_span() -> Bool:
	var matches: Bool = True
	prefix: String = "record Box["

	for authored_parameter in ["# _", "# -- comment\n_"]:
		text = "${prefix}${authored_parameter}] {}"

		match preview_record(lex_module(module_id_at_row(0), text)):
			Ok(PreviewedRecord(preview)):
				match legacy_record_preview(preview):
					Ok(adapted):
						match adapted.declaration:
							RecordParsedDecl(record_decl):
								match record_decl.type_params:
									[parameter]:
										spelling_matches = name_spelling(
											adapted.names,
											parameter.name.name,
										) == Some("#_")
										span_matches = (
											source_location_start_offset(
												parameter.name.span,
											) == prefix.length()
											and source_location_end_offset(
												parameter.name.span,
											) == prefix.length() + authored_parameter.length()
										)

										if not spelling_matches or not span_matches:
											print(
												"wildcard parameter spelling=${spelling_matches}, span=${span_matches}: ${text}",
											)

										matches = spelling_matches and span_matches and matches
									_:
										matches = False
							_:
								matches = False
					Err(error):
						matches = False
			_:
				matches = False

	matches


func test_record_preview_rejects_malformed_parameters_and_fields() -> Bool:
	var rejected: Bool = True

	for text in ["record Box[T: ] { value: T }", "record Box { value Int }"]:
		match preview_record(lex_module(module_id_at_row(0), text)):
			Ok(RejectedRecordPreview(rejected_preview)):
				diagnostics = rejected_preview.rejected_diagnostics()
				rejected = not diagnostics.is_empty() and rejected
			_:
				print("expected rejected record preview with diagnostics: ${text}")
				rejected = False

	rejected


func test_record_preview_marks_outside_declaration_boundary_unsupported() -> Bool:
	var unsupported: Bool = True

	for text in [
		"private record Box {}",
		"---\nDocumentation\n---\nrecord Box {}",
		"record Box {}\nrecord Other {}",
	]:
		match preview_record(lex_module(module_id_at_row(0), text)):
			Ok(UnsupportedRecordPreview):
				void
			_:
				print("expected unsupported record preview: ${text}")
				unsupported = False

	unsupported


