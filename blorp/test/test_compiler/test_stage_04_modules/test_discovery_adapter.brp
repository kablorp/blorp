func projection_matches(text: String, count: Int) -> Bool:
	source = source_file(ROOT_PATH, ROOT_MODULE_NAME, text)
	existing = parse_compiler_source(source)

	match projected(text, EMPTY_NAME_TABLE):
		Some(projection):
			match projection.stop:
				ReachedEndOfSource:
					var correct: Bool = (
						existing.diagnostics.is_empty()
						and existing.decls.length() == count
						and projection.declarations.length() == count
					)

					for (wanted, actual) in existing.decls.zip(projection.declarations):
						expected = parsed_decl_to_json(
							ast_json_render(source, SpellingsFromIdentifierText),
							wanted,
						).to_string()
						adapted = parsed_decl_to_json(
							ast_json_render(source, SpellingsFromNameTable(projection.names)),
							actual,
						).to_string()

						if expected != adapted:
							print(
								"declaration projection expected: ${expected}\nactual: ${adapted}",
							)

						correct = correct and expected == adapted

					match (existing.module_doc, projection.module_doc):
						(None, None):
							correct
						(Some(wanted), Some(actual)):
							(
								correct
								and wanted.text == actual.text
								and source_location_start_offset(
									wanted.span,
								) == source_location_start_offset(actual.span)
								and source_location_end_offset(
									wanted.span,
								) == source_location_end_offset(actual.span)
							)
						_:
							False
				_:
					False
		None:
			False


func test_declaration_projection_preserves_all_completed_leaf_forms_in_order() -> Bool:
	projection_matches(
		"record Box[T: m.Eq, #N] { value: T, items: T[#N] }\nrecord Point { x: Float }\nfixed record Pair { value: Box[Int, #03] }\ntype alias Alias[T] = List[T]\nopaque type Hidden = Int\ntype Buffer[T] = builtin\nresource type File = builtin(\"close\\nfile\")\nunion Choice[T]:\n\tBare\n\tPair(T, Int,)\nfixed union Color:\n\tRed\n\tBlue\n",
		9,
	)


func test_declaration_projection_preserves_import_and_foreign_blocks() -> Bool:
	projection_matches(
		"import:\n\t./m as renamed: Value as Renamed, Choice(One, Two)\n\theap\nforeign(include: \"stdio.h\", link: \"m\"):\n\tfunc puts(text: String) -> Int = \"c_puts\"\n\tpure func fabs(value: Float) -> Float\n\tprivate func hidden(value: Int) -> Int\n\nforeign:\n\t@debug_only func other() -> Int\n",
		3,
	)


func test_declaration_projection_normalizes_spaced_import_paths() -> Bool:
	projection_matches(
		"import:\n\tfoo / bar\n\t. / local / mod\n\t.. / .. / parent / mod\n\tpkg / native / mod -- trailing comment\n",
		1,
	)


func test_declaration_projection_preserves_module_docs_leaf_docs_and_visibility() -> Bool:
	projection_matches(
		"---\nModule documentation.\n---\nimport:\n\theap\n---\nRecord documentation.\n---\nprivate record Hidden { value: Int }\n---\nAlias documentation.\n---\nprivate type alias Alias = Hidden\n---\nValue documentation.\n---\nprivate record Point {}\n---\nBuiltin documentation.\n---\nprivate type Buffer = builtin\n---\nResource documentation.\n---\nprivate resource type File = builtin\n---\nUnion documentation.\n---\nprivate union Choice:\n\tOne\n---\nEnum documentation.\n---\nprivate fixed union Color:\n\tRed\n",
		8,
	)


func test_declaration_projection_threads_names_across_declarations_and_modules() -> Bool:
	match projected("record Shared { value: Int }\ntype alias Alias = Shared", EMPTY_NAME_TABLE):
		Some(first):
			match projected("record Next { value: Shared }", first.names):
				Some(second):
					match (first.declarations, second.declarations):
						([RecordParsedDecl(record_value), TypeAliasParsedDecl(alias_value)], [RecordParsedDecl(next_value)]):
							match (alias_value.target, next_value.fields):
								(ParsedNamedType(alias_target, [], _), [field]):
									match field.type_expr:
										ParsedNamedType(field_target, [], _):
											(
												record_value.name.name == alias_target.name
												and alias_target.name == field_target.name
												and record_value.fields
													.get(0)
													.map(
														pure func(
															field,
														): field.name.name,
													) == Some(field.name.name)
												and name_table_spellings(
													first.names,
												) == ["Shared", "value", "Int", "Alias"]
												and name_table_spellings(
													second.names,
												) == ["Shared", "value", "Int", "Alias", "Next"]
											)
										_:
											False
								_:
									False
						_:
							False
				None:
					False
		None:
			False


func test_declaration_projection_preserves_preseeded_name_ids() -> Bool:
	var seeded: NameTable = EMPTY_NAME_TABLE

	for spelling in name_table_synthesized_spellings():
		(extended, _) = name_table_intern(seeded, spelling)
		seeded = extended

	(before, shared_id) = name_table_intern(seeded, "Shared")

	match projected("record Shared { fresh_field: Int }", before):
		Some(projection):
			match (projection.declarations, name_table_find_id(before, "Int")):
				([RecordParsedDecl(record_value)], Some(integer_id)):
					match record_value.fields:
						[field]:
							match field.type_expr:
								ParsedNamedType(integer, [], _):
									(
										name_id_index(record_value.name.name) == shared_id
										and integer.name == integer_id
										and name_table_spellings(
											projection.names,
										) == name_table_spellings(before).append("fresh_field")
									)
								_:
									False
						_:
							False
				_:
					False
		None:
			False


-- The header the scan stopped at, when it stopped at an unread declaration.
private pure func unread_header(scan: ScanStop.ModuleDeclarationScan) -> Option[ScanStop.UnreadHeader]:
	match scan.stop:
		ScanStop.StoppedAtUnreadDeclaration(unread):
			Some(unread.header)
		_:
			None


-- The global the scan stopped at, with its unread declaration.
private pure func unread_global(scan: ScanStop.ModuleDeclarationScan) -> Option[(ScanStop.UnreadDeclaration, GlobalHeaderPreview)]:
	match scan.stop:
		ScanStop.StoppedAtUnreadDeclaration(unread):
			match unread.header:
				ScanStop.UnreadGlobalInitializer(preview):
					Some((unread, preview))
				_:
					None
		_:
			None


-- A stop translates its header names, while the unread body and later
-- declarations stay outside the prefix.
func test_declaration_projection_stops_at_function_trait_and_implementation() -> Bool:
	var correct: Bool = True

	for deferred in [
		"func deferred(): " + unread_value("1"),
		"trait Deferred:\n\tfunc method() -> Int: " + unread_value("1"),
		"implements Eq for Int:\n\tfunc equals(self: Int, other: Int) -> Bool: " + unread_value("True"),
	]:
		text = "record Before {}\n${deferred}\nrecord After {}"
		lexed = lex_module(module_id_at_row(0), text)

		match new_parse_state(lexed):
			Ok(entry):
				(_, scan) = ScanStop.scan_module_declarations(entry)

				match legacy_declaration_projection(preview_source(lexed), scan, EMPTY_NAME_TABLE):
					Ok(projection):
						match (unread_header(scan), projection.stop):
							(Some(ScanStop.UnreadFunction(header)), StoppedAtFunctionHeader(stopped)):
								correct = (
									correct
									and stopped.header_span.span_start() == header.header_span.span_start()
									and stopped.header_span.span_end() == header.header_span.span_end()
								)
								correct = (
									correct
									and name_table_spellings(
										projection.names,
									) == ["Before", "deferred"]
								)
							(Some(ScanStop.UnreadTrait(preview)), StoppedAtTraitPreview(stopped)):
								correct = (
									correct
									and stopped.header_span.span_start() == preview.span.span_start()
									and stopped.header_span.span_end() == preview.span.span_end()
								)
								correct = (
									correct
									and name_table_spellings(
										projection.names,
									) == ["Before", "Deferred"]
								)
							(Some(ScanStop.UnreadImplementation(preview)), StoppedAtImplementationPreview(stopped)):
								correct = (
									correct
									and stopped.header_span.span_start() == preview.span.span_start()
									and stopped.header_span.span_end() == preview.span.span_end()
								)
								correct = (
									correct
									and name_table_spellings(
										projection.names,
									) == ["Before", "Eq", "Int"]
								)
							_:
								correct = False

						correct = correct and projection.declarations.length() == 1
					Err(_):
						correct = False
			Err(_):
				correct = False

	correct


func test_declaration_projection_maps_scan_hard_stops_without_later_names() -> Bool:
	var correct: Bool = True

	for tail in [
		"value: Int = " + unread_value("1") + "\nrecord After {}",
		"if = 1\nrecord After {}",
		"123\nrecord After {}",
	]:
		match projected("record Before {}\n${tail}", EMPTY_NAME_TABLE):
			Some(projection):
				match projection.stop:
					StoppedAtGlobalInitializer(preview):
						correct = (
							correct
							and tail.starts_with("value")
							and preview.initializer.anchor.span_start() == 17
						)
						correct = (
							correct
							and name_table_spellings(projection.names) == ["Before", "value", "Int"]
						)
					StoppedAtRejectedGlobalInitializer(start):
						correct = (
							correct
							and tail.starts_with("if")
							and start.anchor.span_start() == 17
						)
						correct = correct and name_table_spellings(projection.names) == ["Before"]
					StoppedAtRejectedDeclaration:
						correct = correct and tail.starts_with("123")
						correct = correct and name_table_spellings(projection.names) == ["Before"]
					_:
						correct = False

				correct = correct and projection.declarations.length() == 1
			None:
				correct = False

	correct


