		Span,
		pack_span,
		span_end,
		span_source,
		span_start,
	../../../src/lib/source: source_file, source_location_end_offset, source_location_start_offset
	../tools/discovery_adapter_comparison:
		DeclarationPrefixComparison,
		DeclarationPrefixKind(
			ImportBlockPrefix, ForeignBlockPrefix, RecordPrefix, FixedRecordPrefix,
			AliasPrefix, BuiltinTypePrefix, ResourceTypePrefix, UnionPrefix, FixedUnionPrefix,
			FunctionPrefix, TraitPrefix, ImplementationPrefix, ConstantGlobalPrefix,
			MutableGlobalPrefix,
		),
		DeclarationPrefixStopKind(
			EndOfSourcePrefixStop, FunctionHeaderPrefixStop, TraitPreviewPrefixStop,
			ImplementationPreviewPrefixStop, GlobalInitializerPrefixStop,
			RejectedGlobalInitializerPrefixStop, RejectedDeclarationPrefixStop,
			WithoutProgressPrefixStop,
		),
		JsonDifference,
		declaration_prefix_comparison,
		program_differences,
		with_holes_parsed,
	test: TestSuite


LOOKUP_ROOTS: SourceLookupRoots = {
	standard_library_root = "std",
	native_package_roots = ["pkg"],
	source_packages = []
}

NO_IMPLICIT_MODULES: ImplicitModules = {module_names = []}

ROOT_PATH: String = "app/main.brp"

ROOT_MODULE_NAME: String = "main"

NAMING: LegacyModuleNaming = {
	root_module_name = pure func(request_path): ROOT_MODULE_NAME,
	path_module_name = pure func(path): path.remove_suffix(".brp")
}

CONTEXT: FrontendGraphContext = {
	std_dir = Some("std"),
	source_packages = [],
	package_roots = ["pkg"]
}


---
The tables discovery builds for `sources`'s root `app/main.brp`, or `None`
(with the violations printed) when they break an invariant.
---
func discovered(sources: Dict[String, String]) -> Option[FrontendTables]:
	provider: InMemorySourceProvider = {sources = sources}

	match discover(provider, LOOKUP_ROOTS, [ROOT_PATH], NO_IMPLICIT_MODULES):
		FrozenTables(tables):
			Some(tables)
		TableInvariantsViolated(violations):
			print("invariant violations: ${violations.length()}")
			None


---
The reader over `tables`, or `None` (with the error printed).
---
func reader_of(tables: FrontendTables) -> Option[DeclarationReader]:
	match legacy_declaration_reader(tables, NAMING):
		Ok(reader):
			Some(reader)
		Err(error):
			print(legacy_adapter_error_message(error))
			None


---
The program the adapter rebuilds for the first module of `tables`, or `None`
(with the error printed).
---
func adapted_first_module(tables: FrontendTables) -> Option[ParsedProgram]:
	match reader_of(tables):
		Some(reader):
			match legacy_parsed_program(reader, module_id_at_row(0)):
				Ok(adapted):
					Some(adapted)
				Err(error):
					print(legacy_adapter_error_message(error))
					None
		None:
			None


---
The differences between the existing parser's program (with interpolation holes
parsed) for `source` and the adapter's, or `None` when either front end rejects it.
---
func adapter_differences(source: String) -> Option[(Int, List[JsonDifference])]:
	match discovered({ROOT_PATH => source}):
		Some(tables):
			existing: ParsedProgram = parse_compiler_source(
				source_file(
					ROOT_PATH,
					ROOT_MODULE_NAME,
					source,
				),
			)

			match adapted_first_module(tables):
				Some(adapted):
					if existing.diagnostics.is_empty():
						Some(
							(
								adapted.decls.length(),
								program_differences(
									parsed_program_to_json(with_holes_parsed(existing)),
									parsed_program_to_json(adapted),
								),
							),
						)
					else:
						for diagnostic in existing.diagnostics.take(1):
							print(
								"the existing parser rejects the program: ${diagnostic.span.start_line}:${diagnostic.span.start_column} ${diagnostic.message}",
							)

						None
				None:
					None
		None:
			None


---
Whether the adapter rebuilds exactly `declarations` top-level declarations of
`source`, and every field of them equals the existing parser's.
---
func rebuilds(source: String, declarations: Int) -> Bool:
	match adapter_differences(source):
		Some((count, differences)):
			for difference in differences:
				print(
					"${difference.declaration} ${difference.path}: old=${difference.old_text} new=${difference.new_text}",
				)

			if count != declarations:
				print("expected ${declarations} declarations, rebuilt ${count}")

			differences.is_empty() and count == declarations
		None:
			False


---
The standalone preview must preserve the old parser's complete declaration JSON,
including field/type spans and the temporary authored declaration form. Render
adapter identifiers through its own name table so numeric IDs need not match.
---
func both_record_forms_preview_matches(text: String) -> Bool:
	source = source_file(ROOT_PATH, ROOT_MODULE_NAME, text)
	existing: ParsedProgram = parse_compiler_source(source)

	if not existing.diagnostics.is_empty() or existing.decls.length() != 1:
		print("expected one declaration without diagnostics from the existing parser")
		False
	else:
		match existing.decls.get(0):
			None:
				False
			Some(declaration):
				match preview_record(lex_module(module_id_at_row(0), text)):
					Ok(PreviewedRecord(preview)):
						result: Result[LegacyRecordPreview, LegacyDeclarationPreviewError] = legacy_record_preview(
							preview,
						)

						match result:
							Ok(adapted):
								expected = parsed_decl_to_json(
									ast_json_render(source, SpellingsFromIdentifierText),
									declaration,
								).to_string()
								actual = parsed_decl_to_json(
									ast_json_render(source, SpellingsFromNameTable(adapted.names)),
									adapted.declaration,
								).to_string()

								if expected != actual:
									print("expected: ${expected}\nactual: ${actual}")

								expected == actual
							Err(error):
								print("the legacy adapter rejected the record forms preview")
								False
					_:
						print("expected a successful standalone record forms preview")
						False


func test_record_preview_preserves_fields_spans_and_source_form() -> Bool:
	var matches: Bool = True

	for text in [
		"record Pair { first: Int, second: List[Int] }",
		"fixed record Pair { first: Int, second: List[Int] }",
		"fixed record Box[T: m.Eq, #N] { value: T, items: List[T], shaped: T[#N] }",
	]:
		matches = both_record_forms_preview_matches(text) and matches

	matches


func test_record_preview_preserves_empty_fields_and_trailing_comma() -> Bool:
	var matches: Bool = True

	for text in [
		"record Empty {}\n",
		"fixed record Empty {}\n",
		"record Pair { first: Int, second: List[Int], }\n\n",
		"fixed record Pair { first: Int, second: List[Int], }\n\n",
	]:
		matches = both_record_forms_preview_matches(text) and matches

	matches


func test_record_preview_preserves_nested_and_qualified_types() -> Bool:
	var matches: Bool = True

	for text in [
		"record Pair { first: shapes.Point, second: List[List[Int]] }\n",
		"fixed record Pair { first: shapes.Point, second: List[List[Int]] }\n",
	]:
		matches = both_record_forms_preview_matches(text) and matches

	matches


func test_record_preview_preserves_tuple_and_function_types() -> Bool:
	var matches: Bool = True

	for spelling in ["record", "fixed record"]:
		for fields in [
			"pair: (Int, Float), unit: ()",
			"pure_step: pure (Int) -> (), step: (Int, Float) -> List[Int]",
		]:
			matches = both_record_forms_preview_matches("${spelling} Shapes { ${fields} }") and matches

	matches


func test_record_preview_preserves_array_range_and_dimension_types() -> Bool:
	var matches: Bool = True

	for spelling in ["record", "fixed record"]:
		for fields in [
			"array: Float[#N, #Ds...], index: ..#N",
			"dimension: #N",
			"wildcard: Float[#_], variadic: Float[#_...]",
			"arithmetic: Float[(#N + #1) * #2 - #3 / #4], index: ..(#N + 1)",
			"literal: Float[#003, 004], index: ..#005",
		]:
			matches = both_record_forms_preview_matches("${spelling} Shapes { ${fields} }") and matches

	matches


func test_record_preview_preserves_literal_digits_after_hash_whitespace() -> Bool:
	var matches: Bool = True

	-- Both parsers consume a hash token followed by a numeric token; whitespace
	-- between them belongs to the dimension span, not its authored digits.
	for spelling in ["record", "fixed record"]:
		matches = (
			both_record_forms_preview_matches(
				"${spelling} Shapes { array: Float[# 003], index: ..# 005 }",
			)
			and matches
		)

	matches


func test_record_preview_preserves_literal_digits_after_hash_comment() -> Bool:
	var matches: Bool = True

	for spelling in ["record", "fixed record"]:
		matches = (
			both_record_forms_preview_matches("${spelling} Shapes { array: Float[# -- comment\n003] }")
			and matches
		)

	matches


func test_record_preview_preserves_variadic_wildcard_identifier_spans() -> Bool:
	var matches: Bool = True

	for spelling in ["record", "fixed record"]:
		for dimension in ["# _...", "# -- comment\n_..."]:
			matches = (
				both_record_forms_preview_matches("${spelling} Shapes { array: Float[${dimension}] }")
				and matches
			)

	matches


func test_record_preview_populates_authored_identifier_spellings() -> Bool:
	text: String = "record Pair { first: shapes.Point, second: List[Int] }"

	match preview_record(lex_module(module_id_at_row(0), text)):
		Ok(PreviewedRecord(preview)):
			match legacy_record_preview(preview):
				Ok(adapted):
					match adapted.declaration:
						RecordParsedDecl(record_decl):
							match record_decl.fields:
								[first, second]:
									match (first.type_expr, second.type_expr):
										(ParsedQualifiedNamedType(qualifier, point, [], _), ParsedNamedType(list, [ParsedNamedType(integer, [], _)], _)):
											(
												name_spelling(
													adapted.names,
													record_decl.name.name,
												) == Some("Pair")
												and name_spelling(
													adapted.names,
													first.name.name,
												) == Some("first")
												and name_spelling(
													adapted.names,
													second.name.name,
												) == Some("second")
												and name_spelling(
													adapted.names,
													qualifier.name,
												) == Some("shapes")
												and name_spelling(
													adapted.names,
													point.name,
												) == Some("Point")
												and name_spelling(
													adapted.names,
													list.name,
												) == Some("List")
												and name_spelling(
													adapted.names,
													integer.name,
												) == Some("Int")
											)
										_:
											False
								_:
									False
						_:
							False
				Err(error):
					False
		_:
			False


func test_record_preview_rejects_lexical_and_parser_errors_with_diagnostics() -> Bool:
	var rejected: Bool = True

	for text in [
		"record Shapes { value: Int } $",
		"record Shapes { value Int }",
		"record Shapes[T:] { value: T }",
		"fixed record Shapes[T:] { value: T }",
	]:
		match preview_record(lex_module(module_id_at_row(0), text)):
			Ok(RejectedRecordPreview(rejected_preview)):
				diagnostics = rejected_preview.rejected_diagnostics()

				if diagnostics.is_empty():
					print("missing rejection diagnostics: ${text}")

				rejected = not diagnostics.is_empty() and rejected
			_:
				print("expected rejected preview: ${text}")
				rejected = False

	rejected


func test_both_record_forms_preview_marks_outside_declaration_boundary_unsupported() -> Bool:
	var unsupported: Bool = True

	for text in [
		"record Shapes {}\nrecord Other {}",
		"private record Shapes {}",
		"---\nDocumentation\n---\nrecord Shapes {}",
	]:
		match preview_record(lex_module(module_id_at_row(0), text)):
			Ok(UnsupportedRecordPreview):
				void
			_:
				unsupported = False

	unsupported


-- The union oracle compares the complete declaration and spans, with authored
-- names rendered through each parser's own spelling source.
func union_preview_matches(text: String) -> Bool:
	source = source_file(ROOT_PATH, ROOT_MODULE_NAME, text)
	existing: ParsedProgram = parse_compiler_source(source)

	if not existing.diagnostics.is_empty() or existing.decls.length() != 1:
		print("expected one declaration without diagnostics from the existing parser")
		False
	else:
		match existing.decls.get(0):
			None:
				False
			Some(declaration):
				match preview_union(lex_module(module_id_at_row(0), text)):
					Ok(PreviewedUnion(preview)):
						result: Result[LegacyUnionPreview, LegacyDeclarationPreviewError] = legacy_union_preview(
							preview,
						)

						match result:
							Ok(adapted):
								expected = parsed_decl_to_json(
									ast_json_render(source, SpellingsFromIdentifierText),
									declaration,
								).to_string()
								actual = parsed_decl_to_json(
									ast_json_render(source, SpellingsFromNameTable(adapted.names)),
									adapted.declaration,
								).to_string()

								if expected != actual:
									print("expected: ${expected}\nactual: ${actual}")

								expected == actual
							Err(error):
								print("the legacy adapter rejected the union preview")
								False
					_:
						print("expected a successful standalone union preview")
						False




func test_union_preview_preserves_rich_parameters_and_all_variant_forms() -> Bool:
	union_preview_matches(
		"union Choice[T: m.Eq + Hashable, #N, #_]:\n\tBare\n\tEmpty()\n\tPair(T, Int,)\n\tTrue\n\tFalse\n",
	)


func test_fixed_union_preview_preserves_ordinary_payload_rules_and_source_form() -> Bool:
	union_preview_matches(
		"fixed union Response[T, #N]:\n\tAccepted(T)\n\tRejected(String)\n\tEmpty()\n\tSized(Int[#N])\n",
	)


func test_fixed_union_projection_preserves_private_documentation_and_payloads() -> Bool:
	prefix_matches(
		"---\nResponse documentation.\n---\nprivate fixed union Response[T, #N]:\n\tAccepted(T) -- accepted value\n\tRejected(String)\n\tEmpty()\n\tSized(Int[#N])\n",
		1,
		[FixedUnionPrefix],
		EndOfSourcePrefixStop,
	)


func test_union_preview_preserves_shared_payload_type_forms() -> Bool:
	union_preview_matches(
		"union Shapes[T, #N]:\n\tQualified(m.Value[T])\n\tTuple((T, Float))\n\tFunction(pure (T) -> ())\n\tArray(T[#N])\n\tRange(..#N)\n\tDimension(#N)\n",
	)


func test_union_previews_preserve_eof_blocks_blank_lines_and_newlines() -> Bool:
	var matches: Bool = True

	for text in ["union U:\n\tA", "union U:\n\tA\n\t\n\tB\n\n", "union U[]:\n\tA\n"]:
		matches = union_preview_matches(text) and matches

	for text in ["fixed union E:\n\tTrue\n\tFalse\n\tdebug", "fixed union E:\n\tA\n\t\n\tB\n\n"]:
		matches = union_preview_matches(text) and matches

	matches


func test_union_preview_preserves_wildcard_parameter_trivia_json() -> Bool:
	var matches: Bool = True

	for parameter in ["# _", "# -- comment\n_"]:
		matches = union_preview_matches("union U[${parameter}]:\n\tA") and matches

	matches


func test_union_preview_populates_parameter_bound_variant_and_payload_spellings() -> Bool:
	text: String = "union Choice[T: m.Eq + Hashable, #N, #_]:\n\tBare\n\tPair(T)\n\tTrue\n"

	match preview_union(lex_module(module_id_at_row(0), text)):
		Ok(PreviewedUnion(preview)):
			result: Result[LegacyUnionPreview, LegacyDeclarationPreviewError] = legacy_union_preview(
				preview,
			)

			match result:
				Ok(adapted):
					match adapted.declaration:
						UnionParsedDecl(value):
							match (value.type_params, value.variants):
								([parameter, dimension, wildcard], [bare, pair, truth]):
									match (parameter.bounds, pair.fields):
										([qualified, hashable], [ParsedNamedType(payload_name, [], _)]):
											match qualified.qualifier:
												Some(qualifier):
													(
														value.form == OrdinaryUnion
														and value.doc.is_none()
														and bare.fields.is_empty()
														and truth.fields.is_empty()
														and name_spelling(
															adapted.names,
															value.name.name,
														) == Some("Choice")
														and name_spelling(
															adapted.names,
															parameter.name.name,
														) == Some("T")
														and name_spelling(
															adapted.names,
															dimension.name.name,
														) == Some("#N")
														and name_spelling(
															adapted.names,
															wildcard.name.name,
														) == Some("#_")
														and name_spelling(
															adapted.names,
															qualifier.name,
														) == Some("m")
														and name_spelling(
															adapted.names,
															qualified.name.name,
														) == Some("Eq")
														and name_spelling(
															adapted.names,
															hashable.name.name,
														) == Some("Hashable")
														and name_spelling(
															adapted.names,
															bare.name.name,
														) == Some("Bare")
														and name_spelling(
															adapted.names,
															pair.name.name,
														) == Some("Pair")
														and name_spelling(
															adapted.names,
															truth.name.name,
														) == Some("True")
														and name_spelling(
															adapted.names,
															payload_name.name,
														) == Some("T")
													)
												None:
													False
										_:
											False
								_:
									False
						_:
							False
				Err(_):
					False
		_:
			False


func test_fieldless_fixed_union_preview_preserves_spellings() -> Bool:
	text: String = "fixed union Flags:\n\tTrue\n\tFalse\n\tdebug\n"

	match preview_union(lex_module(module_id_at_row(0), text)):
		Ok(PreviewedUnion(preview)):
			result: Result[LegacyUnionPreview, LegacyDeclarationPreviewError] = legacy_union_preview(
				preview,
			)

			match result:
				Ok(adapted):
					match adapted.declaration:
						UnionParsedDecl(value):
							match value.variants:
								[truth, falsity, soft]:
									(
										value.form == FixedUnion
										and value.type_params.is_empty()
										and value.doc.is_none()
										and truth.fields.is_empty()
										and falsity.fields.is_empty()
										and soft.fields.is_empty()
										and name_spelling(
											adapted.names,
											value.name.name,
										) == Some("Flags")
										and name_spelling(
											adapted.names,
											truth.name.name,
										) == Some("True")
										and name_spelling(
											adapted.names,
											falsity.name.name,
										) == Some("False")
										and name_spelling(
											adapted.names,
											soft.name.name,
										) == Some("debug")
									)
								_:
									False
						_:
							False
				Err(_):
					False
		_:
			False


func builtin_type_preview_matches(text: String) -> Bool:
	source = source_file(ROOT_PATH, ROOT_MODULE_NAME, text)
	existing: ParsedProgram = parse_compiler_source(source)

	if not existing.diagnostics.is_empty() or existing.decls.length() != 1:
		print("expected one declaration without diagnostics from the existing parser")
		False
	else:
		match existing.decls.get(0):
			None:
				False
			Some(declaration):
				match preview_builtin_type(lex_module(module_id_at_row(0), text)):
					Ok(PreviewedBuiltinType(preview)):
						result: Result[LegacyBuiltinTypePreview, LegacyDeclarationPreviewError] = legacy_builtin_type_preview(
							preview,
						)

						match result:
							Ok(adapted):
								expected = parsed_decl_to_json(
									ast_json_render(source, SpellingsFromIdentifierText),
									declaration,
								).to_string()
								actual = parsed_decl_to_json(
									ast_json_render(source, SpellingsFromNameTable(adapted.names)),
									adapted.declaration,
								).to_string()

								if expected != actual:
									print("expected: ${expected}\nactual: ${actual}")

								expected == actual
							Err(error):
								print("the legacy adapter rejected the builtin type preview")
								False
					_:
						print("expected a successful standalone builtin type preview")
						False


func test_builtin_type_preview_preserves_three_forms_and_rich_generics() -> Bool:
	(
		builtin_type_preview_matches("type Buffer[T: m.Eq + Hashable, #N, #_] = builtin")
		and builtin_type_preview_matches(
			"resource type Buffer[T: m.Eq + Hashable, #N, #_] = builtin",
		)
		and builtin_type_preview_matches(
			"resource type Buffer[T: m.Eq + Hashable, #N, #_] = builtin(\"close\\nfile\")",
		)
	)


func test_builtin_type_preview_preserves_absent_empty_parameters_and_terminal_newlines() -> Bool:
	var matches: Bool = True

	for prefix in ["type", "resource type"]:
		for suffix in ["Empty = builtin", "Empty[] = builtin", "Empty = builtin\n\n"]:
			matches = builtin_type_preview_matches("${prefix} ${suffix}") and matches

	matches


func test_builtin_type_preview_preserves_all_cleanup_string_forms_and_decoded_contents() -> Bool:
	var matches: Bool = True

	for written in [
		"\"close\\nfile\"",
		"raw\"close\\nfile\"",
		"\n\t|cleanup\n",
		"raw\n\t|cleanup\n",
	]:
		matches = (
			builtin_type_preview_matches("resource type File = builtin(${written})\n")
			and matches
		)

	matches


func test_builtin_type_preview_preserves_wildcard_parameter_trivia_json() -> Bool:
	var matches: Bool = True

	for prefix in ["type", "resource type"]:
		for parameter in ["# _", "# -- comment\n_"]:
			matches = (
				builtin_type_preview_matches("${prefix} Box[${parameter}] = builtin")
				and matches
			)

	matches


func test_builtin_type_preview_populates_generic_identifier_spellings_and_resource_metadata(

) -> Bool:
	var matches: Bool = True

	for prefix in ["type", "resource type"]:
		text: String = "${prefix} Buffer[T: m.Eq + Hashable, #N, #_] = builtin"

		match preview_builtin_type(lex_module(module_id_at_row(0), text)):
			Ok(PreviewedBuiltinType(preview)):
				result: Result[LegacyBuiltinTypePreview, LegacyDeclarationPreviewError] = legacy_builtin_type_preview(
					preview,
				)

				match result:
					Ok(adapted):
						match adapted.declaration:
							BuiltinTypeParsedDecl(value):
								match value.type_params:
									[type_param, dimension, wildcard]:
										match type_param.bounds:
											[qualified, bare]:
												match qualified.qualifier:
													Some(qualifier):
														matches = (
															value.is_resource == (prefix == "resource type")
															and value.cleanup.is_none()
															and value.doc.is_none()
															and name_spelling(
																adapted.names,
																value.name.name,
															) == Some("Buffer")
															and name_spelling(
																adapted.names,
																type_param.name.name,
															) == Some("T")
															and name_spelling(
																adapted.names,
																dimension.name.name,
															) == Some("#N")
															and name_spelling(
																adapted.names,
																wildcard.name.name,
															) == Some("#_")
															and name_spelling(
																adapted.names,
																qualifier.name,
															) == Some("m")
															and name_spelling(
																adapted.names,
																qualified.name.name,
															) == Some("Eq")
															and name_spelling(
																adapted.names,
																bare.name.name,
															) == Some("Hashable")
															and matches
														)
													None:
														matches = False
											_:
												matches = False
									_:
										matches = False
							_:
								matches = False
					Err(_):
						matches = False
			_:
				matches = False

	matches


