CHAIN_SOURCE: String = raw
	|func chains(xs: List[Int], name: String) -> Int:
	|	xs
	|		.map(func(x): x + 1)
	|		.filter(func(x): x > 1)
	|		.length()
	|	ys = xs
	|		.map(func(item): item * 2)
	|	f(func(): 1)
	|		.g()
	|	total = xs.fold(0, func(acc, x):
	|		next = acc + x
	|		next
	|	)
	|	name.length().to_string().length()

ANCHORED_SOURCE: String = raw
	|func anchored(n: Int, items: List[Int]) -> Int:
	|	pick = if n > 0:
	|		"positive"
	|	else:
	|		"other"
	|	kind = match n:
	|		0: "zero"
	|		_: if n > 10:
	|			"big"
	|		else:
	|			"small"
	|	total = items.fold(0, func(acc, x):
	|		if x > 0:
	|			acc + x
	|		else:
	|			acc
	|	)
	|	if n > 1:
	|		1
	|	-- a comment between the branches
	|	else if n > 2:
	|		2
	|	-- and another
	|	else:
	|		3

CONTROL_SOURCE: String = raw
	|func control(n: Int, xs: List[Int], pair: (Int, Int)) -> Int:
	|	var total = 0
	|	while total < n:
	|		total += 1
	|		if total == 3:
	|			continue
	|		if total > 5:
	|			break
	|	for item in xs:
	|		total += item
	|	for (left, right) in pairs:
	|		total += left * right
	|	for i in 0..n:
	|		total -= i
	|	match n:
	|		0 | 1:
	|			"small"
	|		-1:
	|			"negative"
	|		Shape.Circle(r):
	|			r
	|		Some([first, second, ...rest]):
	|			first
	|		Some([_, ..._]):
	|			1
	|		None:
	|			2
	|		(a, -1.5):
	|			a
	|		_:
	|			"other"
	|	total

PATTERN_SOURCE: String = raw
	|func patterns(text: String, number: Int, real: Float, letter: Char, flag: Bool) -> Int:
	|	match text:
	|		"plain":
	|			1
	|		raw"raw\n":
	|			2
	|		_:
	|			3
	|	match number:
	|		-5:
	|			1
	|		-9223372036854775808:
	|			2
	|		0 | 1 | 2:
	|			3
	|		_:
	|			4
	|	match real:
	|		-1.5:
	|			1
	|		2.0:
	|			2
	|		_:
	|			3
	|	match letter:
	|		'a':
	|			1
	|		'\n':
	|			2
	|		_:
	|			3
	|	match flag:
	|		True:
	|			1
	|		False:
	|			2

STATEMENT_SOURCE: String = raw
	|func statements(xs: List[Int], pair: (Int, Int)) -> Int:
	|	var total: Int = 0
	|	limit: Int = 10
	|	var untyped = 5
	|	total += 1
	|	total -= 2
	|	total *= 3
	|	total /= 4
	|	untyped = 7
