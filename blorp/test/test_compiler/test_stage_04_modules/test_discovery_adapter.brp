															adapted.names,
															type_param.name.name,
														) == Some("T")
														and name_spelling(
															adapted.names,
															dimension.name.name,
														) == Some("#N")
														and name_spelling(
															adapted.names,
															wildcard.name.name,
														) == Some("#_")
														and name_spelling(
															adapted.names,
															qualifier.name,
														) == Some("m")
														and name_spelling(
															adapted.names,
															qualified.name.name,
														) == Some("Eq")
														and name_spelling(
															adapted.names,
															hashable.name.name,
														) == Some("Hashable")
														and name_spelling(
															adapted.names,
															field.name.name,
														) == Some("value")
														and name_spelling(
															adapted.names,
															field_type.name,
														) == Some("T")
													)
												None:
