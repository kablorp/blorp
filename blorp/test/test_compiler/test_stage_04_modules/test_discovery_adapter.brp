-- Bodies. Each source is a raw pipe string, so its tabs, quotes and `${` are
-- the program's own.
EXPRESSION_SOURCE: String = raw
	|func operators(a: Int, b: Int, c: Int, xs: List[Int], name: String) -> Int:
	|	sum = a + b * c - a / b % c
	|	flags = a == b and b != c or not (a < b) and b <= c or a > c and b >= c
	|	negated = -a + -(b)
	|	span = a..b
	|	item = xs[0]
	|	cell = xs[a, b]
	|	size = name.length().to_string().length()
	|	call = max(a, b, c)
	|	named = configure(3, xs)
	|	grouped = (a + b) * (c)
	|	tuple = (a, (b, c))
	|	list = [1, 2.5, 'x', True, False, "s"]
	|	nothing = ()
	|	void
	|
	|func literals() -> Int:
	|	lowest = -9223372036854775808
	|	highest = 9223372036854775807
	|	small = -5
	|	real = 1.5e10
	|	letter = '\u{1F600}'
	|	tab = '\t'
	|	size = - 5
	|	lowest

