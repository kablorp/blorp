		("opaque conversions project at the combined limit", test_opaque_conversions_project_at_the_combined_limit),
		("lists project at the limit", test_lists_project_at_the_limit),
		("tuples project at the limit", test_tuples_project_at_the_limit),
		("groupings project at the limit", test_groupings_project_at_the_limit),
		("vectors project at the limit", test_vectors_project_at_the_limit),
		("call arguments project at the limit", test_call_arguments_project_at_the_limit),
		("subscripts project at the limit", test_subscripts_project_at_the_limit),
		("record literals project at the limit", test_record_literals_project_at_the_limit),
		("record updates project at the limit", test_record_updates_project_at_the_limit),
		("dict literals project at the limit", test_dict_literals_project_at_the_limit),
		("expression-bodied lambdas project at the limit", test_expression_bodied_lambdas_project_at_the_limit),
		("not chains project at the limit", test_not_chains_project_at_the_limit),
		("negation chains project at the limit", test_negation_chains_project_at_the_limit),
		("detach chains project at the limit", test_detach_chains_project_at_the_limit),
		("interpolation holes project", test_interpolation_holes_project),
		("value ifs project at the limit", test_value_ifs_project_at_the_limit),
		("with blocks project at the limit", test_with_blocks_project_at_the_limit),
		("concurrent blocks project at the limit", test_concurrent_blocks_project_at_the_limit),
		("debug blocks project at the limit", test_debug_blocks_project_at_the_limit),
		("selects project at the limit", test_selects_project_at_the_limit),
		("operand ifs project at the limit", test_operand_ifs_project_at_the_limit),
		("block lambdas project at the limit", test_block_lambdas_project_at_the_limit),
		("tuple types project at the limit", test_tuple_types_project_at_the_limit),
		("grouped types project at the limit", test_grouped_types_project_at_the_limit),
