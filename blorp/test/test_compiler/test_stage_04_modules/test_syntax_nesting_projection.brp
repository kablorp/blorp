		("parenthesized dimensions project at the limit", test_parenthesized_dimensions_project_at_the_limit),
		("dimension sums project at the limit", test_dimension_sums_project_at_the_limit),
		("dimension products project at the limit", test_dimension_products_project_at_the_limit),
		("array suffixes project at the limit", test_array_suffixes_project_at_the_limit),
		("constructor patterns project at the limit", test_constructor_patterns_project_at_the_limit),
		("tuple patterns project at the limit", test_tuple_patterns_project_at_the_limit),
		("list patterns project at the limit", test_list_patterns_project_at_the_limit),
		("if statement blocks project at the limit", test_if_statement_blocks_project_at_the_limit),
		("while blocks project at the limit", test_while_blocks_project_at_the_limit),
		("for blocks project at the limit", test_for_blocks_project_at_the_limit),
		("local function bodies project at the limit", test_local_function_bodies_project_at_the_limit),
		("match blocks project at the limit", test_match_blocks_project_at_the_limit),
		("else blocks project at the limit", test_else_blocks_project_at_the_limit),
		("holes around brackets project at the limit", test_holes_around_brackets_project_at_the_limit),
		("left spines project", test_left_spines_project),
	]
}
