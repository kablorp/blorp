		parse_declaration_preview, DeclarationPreviewParse(ParsedDeclarationPreview), DeclarationPreview(GlobalDeclarationPreview)
	../../../src/compiler_new/stage_01_discovery/parse/tree_module_declaration_scan:
		ModuleDeclarationScan, ModuleDeclarationScanStop(ReachedEndOfSource)
	../../../src/compiler_new/stage_01_discovery/syntax/dump: dumped_module
	../../../src/compiler_new/stage_01_discovery/syntax/id_census: id_census
	../../../src/compiler_new/stage_01_discovery/syntax/module_syntax: ModuleSyntax, ModuleItem(GlobalItem)
