	var level: Int = 0
	while level < depth:
		text += "{"
		level += 1
	text += "leaf"
	while level > 0:
		text += "}"
		level -= 1
	module = module_id_at_row(0)
	lexed = lex_module(module, text)
	match new_parse_state(lexed):
		Err(_): False
		Ok(entry):
			(completed, result) = parse_declaration_preview(entry)
			match result:
				ParsedDeclarationPreview(GlobalDeclarationPreview(declaration)):
					issued = issued_ids(completed)
					syntax: ModuleSyntax = {
						documentation = None, items = [GlobalItem(declaration)],
						definitions = issued.definitions, imports = issued.imports, counts = issued.counts
					}
					dumped = dumped_module(syntax, spellings(completed))
					var projected_depth: Int = 0
					match legacy_expression_preview(preview_source(lexed), EMPTY_NAME_TABLE, declaration.value):
						Ok((names, projected)):
							var current: ParsedExpr = projected
							var walking: Bool = name_table_spellings(names) == ["leaf"]
							while walking:
								match current:
									ParsedVectorExpr([element], _):
										current = element
										projected_depth += 1
									_: walking = False
						Err(_): void
					(id_census(module, syntax).is_empty()
						and issued.counts.expressions == depth + 1
						and dumped.split("(vector expr").length() == depth + 1
						and projected_depth == depth)
				_: False


-- Records, updates and dicts nest through their fields. The dump recurses
-- there, so this stays well below the nesting limit.
func test_parsed_nested_records_and_dicts_survive_dump_census_and_projection() -> Bool:
	depth = 100
	var text: String = "leaf"
	var level: Int = 0
	while level < depth:
		text = match level % 3:
			0: "{k => " + text + "}"
			1: "{f = " + text + "}"
			_: "{r | f = " + text + "}"
		level += 1
	module = module_id_at_row(0)
	lexed = lex_module(module, "value = " + text)
	match new_parse_state(lexed):
		Err(_): False
		Ok(entry):
			(completed, result) = parse_declaration_preview(entry)
			match result:
				ParsedDeclarationPreview(GlobalDeclarationPreview(declaration)):
					issued = issued_ids(completed)
					syntax: ModuleSyntax = {
						documentation = None, items = [GlobalItem(declaration)],
						definitions = issued.definitions, imports = issued.imports, counts = issued.counts
					}
					dumped = dumped_module(syntax, spellings(completed))
					match legacy_expression_preview(preview_source(lexed), EMPTY_NAME_TABLE, declaration.value):
						Ok(_):
							(id_census(module, syntax).is_empty()
								and dumped.split("(dict expr").length() == 35
								and dumped.split("(record-update expr").length() == 34
								and dumped.split("(record expr").length() == 34)
						Err(_): False
				_: False


func test_wide_list_projects_every_element_in_order() -> Bool:
	var text: String = "value = ["
	var count: Int = 0
	while count < 3000:
		text += "item${count}, "
		count += 1
	text += "last]"
	match projected_expression(text):
		Some((names, ParsedListExpr(items, _))):
			items.length() == count + 1 and name_table_spellings(names).length() == count + 1
		_: False


-- A control expression ends on a dedent, so a global initializer holding one
-- takes more than a line; each equals the frozen parser's declaration.
func test_control_operand_globals_match_old_ast_json() -> Bool:
	var correct: Bool = True
	for text in [
		"value = if flag:\n\tfirst\nelse if other:\n\tsecond\nelse:\n\tthird\n",
		"value = match flag:\n\tTrue: 1\n\t_: 2\n",
		"value = 1 + if flag:\n\t2\nelse:\n\t3\n",
		"value = -match flag:\n\t_: 1\n",
		"value = left and match flag:\n\tSome(inner): inner\n\t_: False\n",
		"value = 1 + 2 * match flag:\n\t_: 3\n",
	]:
		correct = declaration_projection_matches(text) and correct
	correct


func test_deep_postfix_spine_projects_iteratively() -> Bool:
	var text: String = "value = root"
	var steps: Int = 0
	while steps < 5000:
		text += ".member()[index]"
		steps += 1
	match projected_expression(text):
		None: False
		Some((names, value)):
			var current: ParsedExpr = value
			var count: Int = 0
			var walking: Bool = True
			var correct: Bool = name_table_spellings(names) == ["root", "member", "index"]
			while walking:
				match current:
					ParsedSubscriptExpr(ParsedCallExpr(ParsedFieldAccessExpr(receiver, _, _), arguments, _), indices, _):
						correct = correct and arguments.is_empty() and indices.length() == 1
						current = receiver
						count += 1
					ParsedNameExpr(_): walking = False
					_:
						correct = False
						walking = False
			correct and count == steps


func test_deep_binary_left_spine_projects_iteratively() -> Bool:
	var text: String = "value = item"
	var terms: Int = 1
	while terms < 5000:
		text += " + item"
		terms += 1
	match projected_expression(text):
		None: False
		Some((names, value)):
			var current: ParsedExpr = value
			var count: Int = 1
			var walking: Bool = True
			var correct: Bool = name_table_spellings(names) == ["item"]
			while walking:
				match current:
					ParsedBinaryExpr(ParsedAddOp, left, ParsedNameExpr(_), _):
						current = left
						count += 1
					ParsedNameExpr(_): walking = False
					_:
						correct = False
						walking = False
			correct and count == terms


tests: TestSuite = {
	description = "Tree expression legacy projection",
	tests = [
		("soft keyword fields and frozen name atoms match old parser", test_soft_keyword_fields_and_frozen_name_atoms_match_old_parser),
		("builtin markers match frozen literal payloads", test_builtin_markers_match_frozen_literal_payloads),
		("opaque conversions match full frozen type grammar", test_opaque_conversions_match_full_frozen_type_grammar),
		("minted empty call retains raw AST", test_minted_empty_call_projects_raw_ast),
		("supported expression AST JSON parity", test_supported_expressions_match_old_ast_json),
		("completed global full declaration parity", test_completed_global_matches_full_old_declaration),
		("grouped integer preserves authored digits", test_grouped_integer_keeps_exact_digits),
		("missing integer token fails closed", test_missing_integer_token_fails_closed),
		("names follow written order", test_names_follow_written_order_and_reuse_spelling),
		("postfix names follow written order", test_postfix_names_follow_written_order),
		("postfix integer provenance fails closed", test_postfix_integer_provenance_fails_closed),
		("parsed method chain survives dump and ID census", test_parsed_method_chain_dump_and_census),
		("list names follow written order", test_list_names_follow_written_order),
		("100 nested lists survive dump, census and projection", test_parsed_nested_lists_survive_dump_census_and_projection),
		("nested list dump text", test_nested_list_dump_text),
		("mixed tuple and list dump text", test_mixed_tuple_and_list_dump_text),
		("mixed braced dump text", test_mixed_braced_dump_text),
		("100 alternating tuples and lists survive dump, census and projection", test_parsed_alternating_tuples_and_lists_survive_dump_census_and_projection),
		("tuple names follow written order", test_tuple_names_follow_written_order),
		("braced names follow written order", test_braced_names_follow_written_order),
		("100 nested vectors survive dump, census and projection", test_parsed_nested_vectors_survive_dump_census_and_projection),
		("nested records and dicts survive dump, census and projection", test_parsed_nested_records_and_dicts_survive_dump_census_and_projection),
		("3000 element list projects in order", test_wide_list_projects_every_element_in_order),
		("control operand globals match the old AST JSON", test_control_operand_globals_match_old_ast_json),
		("deep postfix projection uses an iterative walk", test_deep_postfix_spine_projects_iteratively),
		("deep binary projection uses an iterative walk", test_deep_binary_left_spine_projects_iteratively)
	]
}
