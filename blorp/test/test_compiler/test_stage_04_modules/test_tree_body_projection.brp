func test_control_flow_matches_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func g(xs: List[Int]) -> Int:",
		"\tvar total: Int = 0",
		"\tfor x in xs:",
		"\t\tif x < 0:",
		"\t\t\tcontinue",
		"\t\telse if x == 7:",
		"\t\t\tbreak",
		"\t\telse:",
		"\t\t\ttotal += x",
		"\twhile total > 100:",
		"\t\ttotal -= 1",
		"\t\tif total == 50:",
		"\t\t\tbreak",
		"\tfor _ in xs:",
		"\t\ttotal += 1",
		"\ttotal"
	]))


