		"\telse:",
		"\t\tlookup(0)",
		"\ttyped: Int ?= match c:",
		"\t\t_: lookup(c)",
		"\tsum = 1 + if c:",
		"\t\t2",
		"\telse:",
		"\t\t3",
		"\tneg = -match c:",
		"\t\t0: 1",
		"\t\t_: 2",
		"\tflag = c == 1 and match c:",
		"\t\t_: True",
		"\tc > 0 or if c:",
