func test_deeply_nested_selects_project() -> Bool:
	depth = 1000
	var lines: List[String] = ["func f(p: Int) -> Int:"]
	var level: Int = 0
	while level < depth:
		lines = lines.append("\t".repeat(2 * level + 1) + "select:")
		lines = lines.append("\t".repeat(2 * level + 2) + "v${level} from p:")
		level += 1
	lines = lines.append("\t".repeat(2 * depth + 1) + "1")
	match projected_function_body(source_lines(lines)):
		Some(body):
			var current: ParsedExpr = body
			var nested: Int = 0
			var walking: Bool = True
			while walking:
				match current:
					ParsedBlockExpr([ParsedSelectExpr([arm], _)], _):
						current = arm.body
						nested += 1
					_:
						walking = False
			nested == depth
		None: False


func test_long_select_projects_every_arm() -> Bool:
	arms = 2000
	var lines: List[String] = ["func f(p: Int) -> Int:", "\tx = select:"]
	var written: Int = 0
	while written < arms:
		lines = lines.append("\t\tv${written} from p:")
		lines = lines.append("\t\t\t${written}")
		written += 1
	lines = lines.append("\tx")
	match projected_function_body(source_lines(lines)):
		Some(ParsedBlockExpr([ParsedAssignExpr(_, ParsedSelectExpr(parsed_arms, _), _), _], _)):
			parsed_arms.length() == arms
		_: False


func test_long_match_value_projects_every_arm() -> Bool:
	arms = 2000
	var lines: List[String] = ["func f(a: Int) -> Int:", "\tx = match a:"]
	var written: Int = 0
	while written < arms:
		lines = lines.append("\t\t${written}: ${written}")
		written += 1
	lines = lines.append("\t\t_: 0")
	lines = lines.append("\tx")
	match projected_function_body(source_lines(lines)):
		Some(ParsedBlockExpr([ParsedAssignExpr(_, ParsedMatchExpr(_, cases, _), _), _], _)):
			cases.length() == arms + 1
		_: False


func test_long_statement_list_projects_in_order() -> Bool:
	count = 5000
	var lines: List[String] = ["func f() -> Int:"]
	var written: Int = 0
	while written < count:
		lines = lines.append("\tvalue${written} = ${written}")
		written += 1
	lines = lines.append("\tvalue0")
	match projected_function_body(source_lines(lines)):
		Some(ParsedBlockExpr(items, _)): items.length() == count + 1
		_: False


