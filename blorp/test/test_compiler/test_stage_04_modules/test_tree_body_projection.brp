func test_interpolated_strings_match_old_parser() -> Bool:
	quote: String = "\""
	first: Bool = bodies_match_old_parser(source_lines([
		"func f(name: String, count: Int) -> String:",
		"\ta = " + quote + "hello " + hole("name") + quote,
		"\tb = " + quote + hole("name") + quote,
		"\tc = " + quote + hole("count + 1") + " items, " + hole("name.length()") + " chars" + quote,
		"\td = " + quote + "nested " + hole("show(" + quote + "inner " + hole("name") + quote + ", 'x')") + " done" + quote,
		"\te = " + quote + "spaced " + hole(" name ") + " and " + hole("count") + hole("count") + quote,
		"\tshow(" + quote + "in a call " + hole("name") + quote + ")",
		"\tmatch name:",
		"\t\t" + quote + "literal" + quote + ": " + quote + "case " + hole("count") + quote,
		"\t\t_: " + quote + quote,
		"\tfor item in [" + quote + hole("name") + quote + "]:",
		"\t\tname += " + quote + hole("item") + quote,
		"\tname"
	]))
	bodies_match_old_parser("greeting = " + quote + "hi " + hole("name") + " and " + hole("other.field") + quote + "\n") and first


func test_character_escapes_and_raw_pipe_strings_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func f() -> String:",
		"\tnewline = '\\n'",
		"\ttab = '\\t'",
		"\tbackslash = '\\\\'",
		"\tquote = '\\''",
		"\tletter = '\\u{41}'",
		"\temoji = '\\u{1F600}'",
		"\tpath = raw",
		"\t\t|C:\\Users",
		"\t\t|" + hole("not_a_hole"),
		"\tpath"
	]))


-- A pipe string or pipe interpolation can only be an indented value, which the
-- statement grammar of this slice leaves to a later one, so the tree's
-- expression is parsed where its token begins and its projection is compared
-- with the old parser's text, form and parts.
func test_pipe_strings_project_like_the_old_parser() -> Bool:
	plain_text = source_lines(["x =", "\t|one", "\t|two"])
	interpolated_text = source_lines(["x =", "\t|a " + hole("b"), "\t|c"])
	match (pipe_expression(plain_text), pipe_expression(interpolated_text)):
		(Some((ParsedStringLiteralExpr(old_text, old_form, _), ParsedStringLiteralExpr(new_text, new_form, _))), Some((ParsedStringInterpolationPartsExpr(old_parts, True, _), ParsedStringInterpolationPartsExpr(new_parts, True, _)))):
			literal_forms: Bool = old_text == new_text and old_text == "one\ntwo" and old_form == new_form and new_form == ParsedPipeStringLiteral
			literal_forms and pipe_parts_match(old_parts, new_parts)
		_: False


private func pipe_parts_match(old_parts: List[ParsedStringInterpolationPart], new_parts: List[ParsedStringInterpolationPart]) -> Bool:
	match (old_parts, new_parts):
		([ParsedInterpolationLiteral(old_first), ParsedInterpolationExpr(ParsedNameExpr(old_name), _), ParsedInterpolationLiteral(old_last)], [ParsedInterpolationLiteral(new_first), ParsedInterpolationExpr(ParsedNameExpr(new_name), _), ParsedInterpolationLiteral(new_last)]):
			old_first == new_first and old_last == new_last and old_first == "a " and old_last == "\nc" and old_name.text == new_name.text
		_: False


-- The old parser's value of the global `x`, and the tree path's, for a value
-- that begins on the line after the `=`: the tree parser starts at that token.
private func pipe_expression(text: String) -> Option[(ParsedExpr, ParsedExpr)]:
	source = source_file("/tmp/tree_body_projection.brp", "tree_body_projection", text)
	old = with_holes_parsed(parse_compiler_source(source))
	lexed = lex_module(module_id_at_row(0), text)
	match (old.decls.get(0), new_parse_state(lexed)):
		(Some(VarParsedDecl(global)), Ok(entry)):
			(at_value, result) = parse_declaration_preview(entry)
			match result:
				DeferredGlobalInitializer(_):
					-- Past the newline and the indent that precede the pipe token.
					-- The recipe entry skips the boundary check, which an indented
					-- value's closing dedent would fail.
					(at_token, parsed) = parse_expression_recipe(at_value.advanced().advanced())
					match parsed:
						ParsedRecipe(recipe):
							(_, value) = mint_recipe(at_token, recipe)
							match legacy_expression_preview(preview_source(lexed), EMPTY_NAME_TABLE, value):
								Ok((_, projected)): Some((global.value, projected))
								Err(_): None
						_: None
				_: None
		_: None


-- Lambdas nest to the depth the source writes them; the projection follows
-- each nesting once and holds nothing per link beyond its own frame.
func test_nested_lambdas_project_to_their_depth() -> Bool:
	depth = NESTED_LAMBDA_DEPTH
	var text: String = "func f() -> Int: "
	var level: Int = 0
	while level < depth:
		text += "func(a${level}): "
		level += 1
	text += "a0\n"
	match projected_function_body(text):
		Some(first):
			var current: ParsedExpr = first
			var lambdas: Int = 0
			var walking: Bool = True
			while walking:
				match current:
					ParsedLambdaExpr(_, _, _, body, _):
						lambdas += 1
						current = body
					_:
						walking = False
			lambdas == depth
		None: False


-- How deep a lambda chain the tests carry. Measured on Linux arm64 after the
-- tuple, braced and control merges: 500 passes and 700 overflows the native
-- stack, so this keeps a margin of 2.5 below the last depth known to pass.
-- The depth that is still owed is open item D7 (section 9).
NESTED_LAMBDA_DEPTH: Int = 200


-- The projected body of the only function of `text`: the old parser's
-- `ParsedFunctionDecl.body`, shaped by the tree path.
private func projected_function_body(text: String) -> Option[ParsedExpr]:
	lexed = lex_module(module_id_at_row(0), text)
	match new_parse_state(lexed):
		Err(_): None
		Ok(entry):
			(_, scan) = scan_module_declaration_prefix_with_bodies(entry)
			match legacy_declaration_projection(preview_source(lexed), scan, EMPTY_NAME_TABLE):
				Err(_): None
				Ok(projected):
					match projected.declarations.get(0):
						Some(FunctionParsedDecl(function)): function.body
						_: None


-- The chain is nested in the else branches, so the walk descends by a loop.
func test_deep_else_if_chain_projects_by_a_loop() -> Bool:
	links = 2000
	var lines: List[String] = ["func f(a: Int) -> Int:", "\tif a:", "\t\t0"]
	var written: Int = 1
	while written < links:
		lines = lines.append("\telse if a:")
		lines = lines.append("\t\t${written}")
		written += 1
	lines = lines.append("\telse:")
	lines = lines.append("\t\t${links}")
	match projected_function_body(source_lines(lines)):
		Some(ParsedBlockExpr([ParsedIfExpr(_, _, first_else, _)], _)):
			var current: Option[ParsedElseBranch] = first_else
			var depth: Int = 1
			var correct: Bool = True
			while current.is_some():
				match current:
					Some(branch):
						match branch.body:
							ParsedIfExpr(_, _, next, _):
								depth += 1
								current = next
							_:
								-- The last arm is the `else:` block, not another `if`.
								current = None
					None:
						correct = False
			correct and depth == links
		_: False


-- Value `if`s nest by indentation, so projection follows that nesting.
func test_deeply_nested_value_ifs_project() -> Bool:
	depth = 1000
	var lines: List[String] = ["func f(a: Int) -> Int:"]
	var level: Int = 0
	while level < depth:
		lines = lines.append("\t".repeat(level + 1) + "v${level} = if a:")
		level += 1
	lines = lines.append("\t".repeat(depth + 1) + "1")
	match projected_function_body(source_lines(lines)):
		Some(body):
			var current: ParsedExpr = body
			var nested: Int = 0
			var walking: Bool = True
			while walking:
				match current:
					ParsedBlockExpr([ParsedAssignExpr(_, ParsedIfExpr(_, then_block, _, _), _)], _):
						current = then_block
						nested += 1
					_:
						walking = False
			nested == depth
		None: False


-- Block forms nest by indentation, so projection follows that nesting. Each
-- test nests `depth` forms, each the only statement of the one around it.
func test_deeply_nested_with_blocks_project() -> Bool:
	depth = 1000
	var lines: List[String] = ["func f(p: Int) -> Int:"]
	var level: Int = 0
	while level < depth:
		lines = lines.append("\t".repeat(level + 1) + "with r${level} = open(p):")
		level += 1
	lines = lines.append("\t".repeat(depth + 1) + "1")
	match projected_function_body(source_lines(lines)):
		Some(body):
			var current: ParsedExpr = body
			var nested: Int = 0
			var walking: Bool = True
			while walking:
				match current:
					ParsedBlockExpr([ParsedWithExpr(_, inner, _)], _):
						current = inner
						nested += 1
					_:
						walking = False
			nested == depth
		None: False


func test_deeply_nested_concurrent_blocks_project() -> Bool:
	depth = 1000
	var lines: List[String] = ["func f(p: Int) -> Int:"]
	var level: Int = 0
	while level < depth:
		lines = lines.append("\t".repeat(level + 1) + "concurrent(max_threads: 2, timeout: p):")
		level += 1
	lines = lines.append("\t".repeat(depth + 1) + "1")
	match projected_function_body(source_lines(lines)):
		Some(body):
			var current: ParsedExpr = body
			var nested: Int = 0
			var walking: Bool = True
			while walking:
				match current:
					ParsedBlockExpr([ParsedConcurrentBlockExpr(_, inner, _)], _):
						current = inner
						nested += 1
					_:
						walking = False
			nested == depth
		None: False


func test_deeply_nested_debug_blocks_project() -> Bool:
	depth = 1000
	var lines: List[String] = ["func f(p: Int) -> Int:"]
	var level: Int = 0
	while level < depth:
		lines = lines.append("\t".repeat(level + 1) + "debug:")
		level += 1
	lines = lines.append("\t".repeat(depth + 1) + "1")
	match projected_function_body(source_lines(lines)):
		Some(body):
			var current: ParsedExpr = body
			var nested: Int = 0
			var walking: Bool = True
			while walking:
				match current:
					ParsedBlockExpr([ParsedDebugBlockExpr(inner, _)], _):
						current = inner
						nested += 1
					_:
						walking = False
			nested == depth
		None: False


func test_deeply_nested_selects_project() -> Bool:
	depth = 1000
	var lines: List[String] = ["func f(p: Int) -> Int:"]
	var level: Int = 0
	while level < depth:
		lines = lines.append("\t".repeat(2 * level + 1) + "select:")
		lines = lines.append("\t".repeat(2 * level + 2) + "v${level} from p:")
		level += 1
	lines = lines.append("\t".repeat(2 * depth + 1) + "1")
	match projected_function_body(source_lines(lines)):
		Some(body):
			var current: ParsedExpr = body
			var nested: Int = 0
			var walking: Bool = True
			while walking:
				match current:
					ParsedBlockExpr([ParsedSelectExpr([arm], _)], _):
						current = arm.body
						nested += 1
					_:
						walking = False
			nested == depth
		None: False


func test_long_select_projects_every_arm() -> Bool:
	arms = 2000
	var lines: List[String] = ["func f(p: Int) -> Int:", "\tx = select:"]
	var written: Int = 0
	while written < arms:
		lines = lines.append("\t\tv${written} from p:")
		lines = lines.append("\t\t\t${written}")
		written += 1
	lines = lines.append("\tx")
	match projected_function_body(source_lines(lines)):
		Some(ParsedBlockExpr([ParsedAssignExpr(_, ParsedSelectExpr(parsed_arms, _), _), _], _)):
			parsed_arms.length() == arms
		_: False


func test_long_match_value_projects_every_arm() -> Bool:
	arms = 2000
	var lines: List[String] = ["func f(a: Int) -> Int:", "\tx = match a:"]
	var written: Int = 0
	while written < arms:
		lines = lines.append("\t\t${written}: ${written}")
		written += 1
	lines = lines.append("\t\t_: 0")
	lines = lines.append("\tx")
	match projected_function_body(source_lines(lines)):
		Some(ParsedBlockExpr([ParsedAssignExpr(_, ParsedMatchExpr(_, cases, _), _), _], _)):
			cases.length() == arms + 1
		_: False


func test_long_statement_list_projects_in_order() -> Bool:
	count = 5000
	var lines: List[String] = ["func f() -> Int:"]
	var written: Int = 0
	while written < count:
		lines = lines.append("\tvalue${written} = ${written}")
		written += 1
	lines = lines.append("\tvalue0")
	match projected_function_body(source_lines(lines)):
		Some(ParsedBlockExpr(items, _)): items.length() == count + 1
		_: False


tests: TestSuite = {
	description = "Tree statement and block legacy projection",
	tests = [
		("expression bodies match the old parser", test_expression_body_matches_old_parser),
		("block statements match the old parser", test_block_statements_match_old_parser),
		("declaration metadata matches the old parser", test_declaration_metadata_matches_old_parser),
		("control flow matches the old parser", test_control_flow_matches_old_parser),
		("question bindings and tuple loops match the old parser", test_question_bindings_and_tuple_loops_match_old_parser),
		("lambdas and local functions match the old parser", test_lambdas_and_local_functions_match_old_parser),
		("match statements match the old parser", test_match_statements_match_old_parser),
		("control expression values match the old parser", test_control_expression_values_match_old_parser),
		("with resources match the old parser", test_with_resources_match_old_parser),
		("concurrent blocks match the old parser", test_concurrent_blocks_match_old_parser),
		("select arms match the old parser", test_select_arms_match_old_parser),
		("debug blocks and detach match the old parser", test_debug_blocks_and_detach_match_old_parser),
		("nested block forms match the old parser", test_nested_block_forms_match_old_parser),
		("lambdas in block form headers match the old parser", test_lambdas_in_block_form_headers_match_old_parser),
		("nested blocks match the old parser", test_nested_blocks_match_old_parser),
		("trait default bodies match the old parser", test_trait_default_bodies_match_old_parser),
		("implementation bodies match the old parser", test_implementation_bodies_match_old_parser),
		("several declarations match the old parser", test_several_declarations_match_old_parser),
		("string and character literals match the old parser", test_string_and_character_literals_match_old_parser),
		("interpolated strings match the old parser", test_interpolated_strings_match_old_parser),
		("character escapes and raw pipe strings match the old parser", test_character_escapes_and_raw_pipe_strings_match_old_parser),
		("pipe strings project like the old parser", test_pipe_strings_project_like_the_old_parser),
		("nested lambdas project to their depth", test_nested_lambdas_project_to_their_depth),
		("a 2000 link else if chain projects by a loop", test_deep_else_if_chain_projects_by_a_loop),
		("1000 nested value ifs project", test_deeply_nested_value_ifs_project),
		("a 2000 arm match value projects every arm", test_long_match_value_projects_every_arm),
		("1000 nested with blocks project", test_deeply_nested_with_blocks_project),
		("1000 nested concurrent blocks project", test_deeply_nested_concurrent_blocks_project),
		("1000 nested debug blocks project", test_deeply_nested_debug_blocks_project),
		("1000 nested selects project", test_deeply_nested_selects_project),
		("a 2000 arm select projects every arm", test_long_select_projects_every_arm),
		("5000 statements project in order", test_long_statement_list_projects_in_order)
	]
}
