		"\t\t1",
		"\telse if c < 0:",
		"\t\t-1",
		"\telse:",
		"\t\t0",
		"\tvar picked: Int = match c:",
		"\t\t0: 1",
		"\t\tSome(inner): inner",
		"\t\t_:",
		"\t\t\tvar local = c",
		"\t\t\tlocal",
		"\tcounted: Int = if c:",
		"\t\tc",
		"\ttotal = 0",
		"\ttotal += if c:",
		"\t\t1",
		"\telse:",
		"\t\t2",
		"\txs[0] = match c:",
		"\t\t_: 5",
		"\t_ = if c:",
		"\t\tvoid",
		"\tfound ?= if c:",
		"\t\tlookup(c)",
		"\telse:",
		"\t\tlookup(0)",
		"\ttyped: Int ?= match c:",
		"\t\t_: lookup(c)",
		"\tsum = 1 + if c:",
		"\t\t2",
		"\telse:",
		"\t\t3",
		"\tneg = -match c:",
		"\t\t0: 1",
		"\t\t_: 2",
		"\tflag = c == 1 and match c:",
		"\t\t_: True",
		"\tc > 0 or if c:",
		"\t\tFalse",
		"\telse:",
		"\t\tTrue",
		"\twide = 1 + 2 * if c:",
		"\t\tvar local = c",
		"\t\tlocal",
		"\telse:",
		"\t\tmatch c:",
		"\t\t\t_: 9",
		"\tnested = if c:",
		"\t\tinner = match c:",
		"\t\t\t_: 1",
		"\t\tinner",
		"\telse:",
		"\t\t0",
		"\tsign"
	]))


func test_with_resources_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func g(path: String) -> Int:",
		"\twith file = open(path):",
		"\t\tfile.read()",
		"\twith typed: File = open(path):",
		"\t\ttyped.read()",
		"\twith _ = open(path):",
		"\t\tvoid",
		"\twith handle ?= open(path):",
		"\t\thandle.read()",
		"\twith handle: File ?= open(path):",
		"\t\thandle.read()",
		"\twith handle ?= open(path) on failure => wrapped(failure):",
		"\t\thandle.read()",
		"\twith handle ?= open(path) on _ => 0:",
		"\t\thandle.read()",
		"\twith outer = open(path):",
		"\t\twith inner = open(path):",
		"\t\t\tinner.read() + outer.read()",
		"\tfor line in lines:",
		"\t\twith file = open(line):",
		"\t\t\tif file.empty():",
		"\t\t\t\tbreak",
		"\t\t\tcontinue",
		"\t0"
	]))


