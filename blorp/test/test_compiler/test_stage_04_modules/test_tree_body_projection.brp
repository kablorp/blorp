-- A block lambda or a `match` as a call argument, closed by its dedent and then
-- the bracket. Its body is indented past the anchor the call is read under.
func test_block_arguments_inside_brackets_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func g(c: Int) -> Int:",
		"\tmapped = each(xs, func(x: Int) -> Int:",
		"\t\tx + 1",
		"\t)",
		"\tif pick(func(y: Int) -> Bool:",
		"\t\ty > 0",
		"\t):",
		"\t\tvoid",
		"\tpicked = choose(match c:",
		"\t\t0: 1",
		"\t\t_: 2",
		"\t)",
		"\tpicked"
	]))


-- Whether the tree scan reads every declaration of `text` and reports nothing.
private func tree_accepts(text: String) -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Err(_): False
		Ok(entry):
			(scanned, scan) = scan_module_declaration_prefix_with_bodies(entry)
			reached_end: Bool = match scan.stop:
				ReachedEndOfSource: True
				_: False
			reached_end and scan.declined.is_empty() and scanned.diagnostic_count() == 0


-- The differential for each named source: where the frozen parser accepts it
-- the tree projection equals its parse, and where it rejects it the tree scan
-- does not accept it either.
private func agrees_with_old_parser(cases: List[(String, String)]) -> Bool:
	var correct: Bool = True
	for (name, text) in cases:
		source = source_file("/tmp/tree_body_projection.brp", "tree_body_projection", text)
		old_accepts: Bool = with_holes_parsed(parse_compiler_source(source)).diagnostics.is_empty()
		agrees: Bool = if old_accepts:
			bodies_match_old_parser(text)
		else:
			not tree_accepts(text)
		if not agrees:
			verdict: String = if old_accepts:
				"accepts"
			else:
				"rejects"
			print("${name}: the tree scan disagrees with the frozen parser, which ${verdict} it")
			correct = False
	correct


-- A block opened inside call arguments, subscripts, lists, tuples, groupings,
-- record fields and dict entries is read only past the frozen parser's anchor, and
-- every shape the frozen parser rejects is not accepted here.
func test_blocks_in_bracketed_items_follow_the_old_anchor() -> Bool:
	agrees_with_old_parser([
		("binary_call_match", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> Int:\n\tx = f(1) + f(match c:\n\t\tTrue: 1\n\t\tFalse: 2\n\t)\n\tx\n"),
		("call_match_next_line", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> Int:\n\tx = f(\n\t\tmatch c:\n\t\t\tTrue: 1\n\t\t\tFalse: 2\n\t)\n\tx\n"),
		("if_arg_plus", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> Int:\n\tf(if c:\n\t\t1\n\telse:\n\t\t2\n\t+ 3)\n"),
		("list_call_match", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> List[Int]:\n\t[f(match c:\n\t\tTrue: 1\n\t\tFalse: 2\n\t)]\n"),
		("list_match_next_line", "pure func g(c: Bool) -> List[Int]:\n\t[\n\t\tmatch c:\n\t\t\tTrue: 1\n\t\t\tFalse: 2\n\t]\n"),
		("mid_if_arg", "pure func f(a: Int, b: Int) -> Int:\n\ta + b\n\n\npure func g(c: Bool) -> Int:\n\tf(if c:\n\t\t1\n\telse:\n\t\t2\n\t, 3)\n"),
		("nested_call_match", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> Int:\n\tx = f(f(match c:\n\t\tTrue: 1\n\t\tFalse: 2\n\t))\n\tx\n"),
		("record_call_match", "record R {\n\ta: Int\n}\n\n\npure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> R:\n\t{a = f(match c:\n\t\tTrue: 1\n\t\tFalse: 2\n\t)}\n"),
		("subscript_if", "pure func g(xs: List[Int], c: Bool) -> Int:\n\txs[if c:\n\t\t0\n\telse:\n\t\t1\n\t]\n"),
		("subscript_if_value", "pure func g(xs: List[Int], c: Bool) -> Int:\n\tv = xs[if c:\n\t\t0\n\telse:\n\t\t1\n\t]\n\tv\n"),
		("tuple_call_match", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> (Int, Int):\n\t(1, f(match c:\n\t\tTrue: 1\n\t\tFalse: 2\n\t))\n"),
		("dict_call_match", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> Dict[Int, Int]:\n\t{1 => f(match c:\n\t\tTrue: 1\n\t\tFalse: 2\n\t)}\n"),
		("operator_newline", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> Int:\n\tvalue = f(1) +\n\t\t2\n\tvalue\n"),
		("tuple_call_match_value", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> Int:\n\ty = 1\n\tx = (y, f(match c:\n\t\tTrue: 1\n\t\tFalse: 2\n\t))\n\ty\n"),
		("call_match_then_op", "pure func g(c: Bool) -> Int:\n\tv = f(match c:\n\t\tTrue: 1\n\t\tFalse: 2\n\t) + 1\n\tv\n\n\npure func f(a: Int) -> Int:\n\ta\n"),
		("empty_brace", "record E {}\n\n\npure func g() -> E:\n\tx = {\n\t}\n\tx\n"),
		("empty_paren", "pure func g() -> Void:\n\tx = (\n\t)\n\tx\n"),
		("lambda_then_postfix", "pure func g(xs: List[Int]) -> Int:\n\tv = xs.map(func(x):\n\t\tx + 1\n\t).length()\n\tv\n"),
		("mid_if_deeper", "pure func g(c: Int) -> Int:\n\tv = f(1, if c > 0:\n\t\t\t1\n\t\telse:\n\t\t\t2\n\t, 3)\n\tv\n\n\npure func f(a: Int, b: Int, d: Int) -> Int:\n\ta\n"),
		("subscript_multi", "pure func g(xs: List[Int]) -> Int:\n\ty = xs[\n\t\t0\n\t]\n\ty\n"),
		("list_match_same_line", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> List[Int]:\n\t[match c:\n\t\tTrue: 1\n\t\tFalse: 2\n\t]\n"),
		("tuple_if_second", "pure func g(c: Bool) -> (Int, Int):\n\t(1, if c:\n\t\t1\n\telse:\n\t\t2\n\t)\n"),
		("group_if", "pure func g(c: Bool) -> Int:\n\t(if c:\n\t\t1\n\telse:\n\t\t2\n\t)\n"),
		("call_if_only_arg", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> Int:\n\tf(if c:\n\t\t1\n\telse:\n\t\t2\n\t)\n"),
		("call_match_only_arg", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> Int:\n\tf(match c:\n\t\tTrue: 1\n\t\tFalse: 2\n\t)\n"),
		("call_if_value", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> Int:\n\tv = f(if c:\n\t\t1\n\telse:\n\t\t2\n\t)\n\tv\n"),
		("brace_lambda_value", "pure func g() -> Int:\n\tr = {a = func(x):\n\t\tx\n\t}\n\t0\n"),
		("dict_value_deep", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> Dict[Int, Int]:\n\t{1 => f(match c:\n\t\t\tTrue: 1\n\t\t\tFalse: 2\n\t)}\n"),
		("record_field_deep", "record R {\n\ta: Int\n}\n\n\npure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> R:\n\t{a = f(match c:\n\t\t\tTrue: 1\n\t\t\tFalse: 2\n\t)}\n"),
		("list_item_call_shallow", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> List[Int]:\n  x = [f(match c:\n      True: 1\n      False: 2\n  )]\n  x\n"),
		("list_item_call_deeper", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> List[Int]:\n  x = [f(match c:\n        True: 1\n        False: 2\n  )]\n  x\n"),
		("tuple_element_shallow", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> (Int, Int):\n  x = (1, f(match c:\n    True: 1\n    False: 2\n  ))\n  x\n"),
		("group_shallow", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> Int:\n  x = (match c:\n    True: 1\n    False: 2\n  )\n  x\n")
	])


-- A block lambda in the header of an `if`, `else if`, `while`, `for` or `match`
-- is anchored at the header expression's first token.
func test_blocks_in_block_headers_follow_the_old_anchor() -> Bool:
	agrees_with_old_parser([
		("elseif_tab", "pure func g(xs: List[Int]) -> Int:\n\tif xs.is_empty():\n\t\t0\n\telse if xs.any(func(x):\n\t\tx > 1\n\t):\n\t\t1\n\telse:\n\t\t2\n"),
		("while_deep", "pure func g(xs: List[Int]) -> Int:\n\twhile xs.any(func(x):\n\t\t\t\tx > 1\n\t):\n\t\tbreak\n\t0\n"),
		("while_tab", "pure func g(xs: List[Int]) -> Int:\n\twhile xs.any(func(x):\n\t\tx > 1\n\t):\n\t\tbreak\n\t0\n"),
		("elseif_deep", "pure func g(xs: List[Int], c: Bool) -> Int:\n\tif c:\n\t\t0\n\telse if xs.any(func(x):\n\t\t\t\tx > 1\n\t):\n\t\t1\n\telse:\n\t\t2\n"),
		("for_deep", "pure func g(xs: List[Int]) -> Int:\n\tfor x in xs.filter(func(y):\n\t\t\t\ty > 1\n\t):\n\t\tbreak\n\t0\n"),
		("lambda_header_multiline", "pure func g(xs: List[Int]) -> List[Int]:\n\txs.map(func(\n\t\tx: Int\n\t) -> Int:\n\t\tx + 1\n\t)\n"),
		("match_paren_multiline", "pure func g(c: Bool) -> Int:\n\tmatch (\n\t\tc\n\t):\n\t\tTrue: 1\n\t\tFalse: 2\n"),
		("while_header_lambda", "pure func g(xs: List[Int]) -> Int:\n\twhile xs.any(func(x):\n\t\tx > 1\n\t):\n\t\tbreak\n\t0\n"),
		("if_header_lambda_tab", "pure func g(xs: List[Int]) -> Int:\n\tif xs.any(func(x):\n\t\tx > 1\n\t):\n\t\t1\n\telse:\n\t\t2\n"),
		("for_header_lambda_tab", "pure func g(xs: List[Int]) -> Int:\n\tfor x in xs.filter(func(y):\n\t\ty > 1\n\t):\n\t\tbreak\n\t0\n"),
		("match_scrutinee_lambda", "pure func g(xs: List[Int]) -> Int:\n\tmatch xs.any(func(x):\n\t\tx > 1\n\t):\n\t\tTrue: 1\n\t\tFalse: 2\n")
	])


-- Spaces and tabs, and a body or closing bracket indented deeper or no deeper
-- than the anchor.
func test_block_indentation_variants_follow_the_old_anchor() -> Bool:
	agrees_with_old_parser([
		("if2sp", "pure func g(xs: List[Int]) -> Int:\n  if xs.any(func(x):\n    x > 1\n  ):\n    1\n  else:\n    2\n"),
		("if4sp", "pure func g(xs: List[Int]) -> Int:\n    if xs.any(func(x):\n        x > 1\n    ):\n        1\n    else:\n        2\n"),
		("if_extra_space", "pure func g(xs: List[Int]) -> Int:\n\tif   xs.any(func(x):\n\t\tx > 1\n\t):\n\t\t1\n\telse:\n\t\t2\n"),
		("if_tab", "pure func g(xs: List[Int]) -> Int:\n\tif xs.any(func(x):\n\t\tx > 1\n\t):\n\t\t1\n\telse:\n\t\t2\n"),
		("lambda_arg_tab", "pure func g(xs: List[Int]) -> List[Int]:\n\tys = xs.map(func(x):\n\t\tx + 1\n\t)\n\tys\n"),
		("lambda_arg_2sp", "pure func g(xs: List[Int]) -> List[Int]:\n  ys = xs.map(func(x):\n    x + 1\n  )\n  ys\n"),
		("lambda_arg_4sp", "pure func g(xs: List[Int]) -> List[Int]:\n    ys = xs.map(func(x):\n        x + 1\n    )\n    ys\n"),
		("lambda_arg_same_col_body", "pure func g(xs: List[Int]) -> List[Int]:\n\tys = xs.map(func(x):\n\tx + 1\n\t)\n\tys\n"),
		("lambda_body_deep", "pure func g(xs: List[Int]) -> List[Int]:\n\tys = xs.map(func(x):\n\t\t\t\tx + 1\n\t)\n\tys\n"),
		("lambda_close_deep", "pure func g(xs: List[Int]) -> List[Int]:\n\tys = xs.map(func(x):\n\t\tx + 1\n\t\t)\n\tys\n"),
		("if_value_2sp", "pure func g(c: Bool) -> Int:\n  v = if c:\n    1\n  else:\n    2\n  v\n"),
		("if_stmt_2sp", "pure func g(c: Bool) -> Int:\n  if c:\n    1\n  else:\n    2\n"),
		("while_2sp", "pure func g(c: Bool) -> Int:\n  while c:\n    break\n  0\n"),
		("match_stmt_2sp", "pure func g(c: Bool) -> Int:\n  match c:\n    True: 1\n    False: 2\n"),
		("call_if_2sp", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> Int:\n  v = f(if c:\n    1\n  else:\n    2\n  )\n  v\n"),
		("call_if_tab_body_deeper", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> Int:\n\tv = f(if c:\n\t\t\t1\n\t\telse:\n\t\t\t2\n\t)\n\tv\n"),
		("call_if_close_same_as_body", "pure func f(a: Int) -> Int:\n\ta\n\n\npure func g(c: Bool) -> Int:\n\tv = f(if c:\n\t\t1\n\telse:\n\t\t2\n\t\t)\n\tv\n")
	])


-- A body written on the header's line, and a global value, are anchored at
-- their own first token.
func test_same_line_bodies_and_globals_follow_the_old_anchor() -> Bool:
	agrees_with_old_parser([
		("same_line_body_block", "pure func g() -> Int: f(func(x):\n\tx\n)\n"),
		("same_line_body_call_block", "pure func g(xs: List[Int]) -> List[Int]: xs.map(func(x):\n\tx\n)\n"),
		("same_line_body_if_arg", "pure func g(c: Bool) -> Int: f(if c:\n\t1\nelse:\n\t2\n)\n"),
		("global_call_lambda", "xs = map(func(x):\n\tx + 1\n)\n"),
		("global_if_value", "v = if True:\n\t1\nelse:\n\t2\n"),
		("same_line_body_deep", "pure func g(c: Bool) -> Int: if c:\n\t\t\t\t\t\t\t\t1\nelse:\n\t\t\t\t\t\t\t\t2\n"),
		("same_line_body_value_deep", "pure func g(c: Bool) -> Int: f(if c:\n\t\t\t\t\t\t\t\t\t1\nelse:\n\t\t\t\t\t\t\t\t\t2\n)\n")
	])


func test_nested_blocks_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func g(value: Int) -> Int:",
		"\tif value > 0:",
		"\t\tif value > 1:",
		"\t\t\tif value > 2:",
		"\t\t\t\tvalue",
		"\t\t\telse:",
		"\t\t\t\t0",
		"\t\telse if value > 3:",
		"\t\t\t1",
		"\telse:",
		"\t\tmatch value:",
		"\t\t\t0:",
		"\t\t\t\tfor item in value:",
		"\t\t\t\t\tif item:",
		"\t\t\t\t\t\tbreak",
		"\t\t\t_: 2",
		"\tvalue"
	]))


func test_trait_default_bodies_match_old_parser() -> Bool:
	first: Bool = bodies_match_old_parser(source_lines([
		"--- A shape.",
		"trait Shape[T]: Equatable + Showable:",
		"\tfunc area(self: T) -> Int",
		"\tpure func twice(self: T) -> Int:",
		"\t\tarea(self) * 2",
		"\tfunc describe(self: T) -> Int:",
		"\t\tvalue = area(self)",
		"\t\tif value > 0:",
		"\t\t\tvalue",
		"\t\telse:",
		"\t\t\t0",
		"",
		"private trait Marker: Equatable"
	]))
	bodies_match_old_parser(source_lines(["trait Empty:", "\tfunc only(x: Int) -> Int: x + 1", "func after() -> Int: 1"])) and first


func test_implementation_bodies_match_old_parser() -> Bool:
	first: Bool = bodies_match_old_parser(source_lines([
		"implements Shape for Circle:",
		"\tfunc area(self: Circle) -> Int:",
		"\t\tself.radius * self.radius",
		"\t@tail_recursive",
		"\tpure func twice(self: Circle) -> Int:",
		"\t\tvar total = 0",
		"\t\tfor item in self.items:",
		"\t\t\ttotal += item",
		"\t\ttotal",
		"\tfunc named[T](self: Circle, value: T) -> T: value"
	]))
	second: Bool = bodies_match_old_parser(source_lines(["implements Marker for List[Int]:", "\tfunc size(self: List[Int]) -> Int: 0", "private implements Marker for Bool:", "\tfunc size(self: Bool) -> Int: 1"]))
	bodies_match_old_parser(source_lines(["implements Shape for Square:", "\tfunc area(self: Square) -> Int: self.side", "", "func after() -> Int: 1"])) and first and second


func test_several_declarations_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"first = 1",
		"",
		"func one() -> Int: first",
		"",
		"func two(x: Int) -> Int:",
		"\tx",
		"",
		"func three():",
		"\tvoid"
	]))


func test_string_and_character_literals_match_old_parser() -> Bool:
	first: Bool = bodies_match_old_parser(source_lines([
		"func f(name: String) -> String:",
		"\tplain = \"plain\"",
		"\tempty = \"\"",
		"\tescaped = \"tab\\t quote\\\" newline\\n\"",
		"\tpath = raw\"C:\\Users\\x\"",
		"\tletter = 'c'",
		"\tnewline = '\\n'",
		"\tgrouped = (\"grouped\")",
		"\tjoined = name + \"suffix\"",
		"\tlength(\"call\", ('d'), [\"list\"])",
		"\tname"
	]))
	bodies_match_old_parser("label = \"a global\"\nmark = 'g'\n") and first


func test_interpolated_strings_match_old_parser() -> Bool:
	quote: String = "\""
	first: Bool = bodies_match_old_parser(source_lines([
		"func f(name: String, count: Int) -> String:",
		"\ta = " + quote + "hello " + hole("name") + quote,
		"\tb = " + quote + hole("name") + quote,
		"\tc = " + quote + hole("count + 1") + " items, " + hole("name.length()") + " chars" + quote,
		"\td = " + quote + "nested " + hole("show(" + quote + "inner " + hole("name") + quote + ", 'x')") + " done" + quote,
		"\te = " + quote + "spaced " + hole(" name ") + " and " + hole("count") + hole("count") + quote,
		"\tshow(" + quote + "in a call " + hole("name") + quote + ")",
		"\tmatch name:",
		"\t\t" + quote + "literal" + quote + ": " + quote + "case " + hole("count") + quote,
		"\t\t_: " + quote + quote,
		"\tfor item in [" + quote + hole("name") + quote + "]:",
		"\t\tname += " + quote + hole("item") + quote,
		"\tname"
	]))
	bodies_match_old_parser("greeting = " + quote + "hi " + hole("name") + " and " + hole("other.field") + quote + "\n") and first


func test_character_escapes_and_raw_pipe_strings_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func f() -> String:",
		"\tnewline = '\\n'",
		"\ttab = '\\t'",
		"\tbackslash = '\\\\'",
		"\tquote = '\\''",
		"\tletter = '\\u{41}'",
		"\temoji = '\\u{1F600}'",
		"\tpath = raw",
		"\t\t|C:\\Users",
		"\t\t|" + hole("not_a_hole"),
		"\tpath"
	]))


-- A pipe string or pipe interpolation can only be an indented value, which the
-- statement grammar of this slice leaves to a later one, so the tree's
-- expression is parsed where its token begins and its projection is compared
-- with the old parser's text, form and parts.
func test_pipe_strings_project_like_the_old_parser() -> Bool:
	plain_text = source_lines(["x =", "\t|one", "\t|two"])
	interpolated_text = source_lines(["x =", "\t|a " + hole("b"), "\t|c"])
	match (pipe_expression(plain_text), pipe_expression(interpolated_text)):
		(Some((ParsedStringLiteralExpr(old_text, old_form, _), ParsedStringLiteralExpr(new_text, new_form, _))), Some((ParsedStringInterpolationPartsExpr(old_parts, True, _), ParsedStringInterpolationPartsExpr(new_parts, True, _)))):
			literal_forms: Bool = old_text == new_text and old_text == "one\ntwo" and old_form == new_form and new_form == ParsedPipeStringLiteral
			literal_forms and pipe_parts_match(old_parts, new_parts)
		_: False


private func pipe_parts_match(old_parts: List[ParsedStringInterpolationPart], new_parts: List[ParsedStringInterpolationPart]) -> Bool:
	match (old_parts, new_parts):
		([ParsedInterpolationLiteral(old_first), ParsedInterpolationExpr(ParsedNameExpr(old_name), _), ParsedInterpolationLiteral(old_last)], [ParsedInterpolationLiteral(new_first), ParsedInterpolationExpr(ParsedNameExpr(new_name), _), ParsedInterpolationLiteral(new_last)]):
			old_first == new_first and old_last == new_last and old_first == "a " and old_last == "\nc" and old_name.text == new_name.text
		_: False


-- The old parser's value of the global `x`, and the tree path's, for a value
-- that begins on the line after the `=`: the tree parser starts at that token.
private func pipe_expression(text: String) -> Option[(ParsedExpr, ParsedExpr)]:
	source = source_file("/tmp/tree_body_projection.brp", "tree_body_projection", text)
	old = with_holes_parsed(parse_compiler_source(source))
	lexed = lex_module(module_id_at_row(0), text)
	match (old.decls.get(0), new_parse_state(lexed)):
		(Some(VarParsedDecl(global)), Ok(entry)):
			(at_value, result) = parse_declaration_preview(entry)
			match result:
				DeferredGlobalInitializer(_):
					-- Past the newline and the indent that precede the pipe token.
					-- The recipe entry skips the boundary check, which an indented
					-- value's closing dedent would fail.
					at_start = at_value.advanced().advanced()
					(at_token, parsed) = parse_expression_recipe(at_start, anchored_at(at_start.current_span()))
					match parsed:
						ParsedRecipe(recipe):
							(_, value) = mint_recipe(at_token, recipe)
							match legacy_expression_preview(preview_source(lexed), EMPTY_NAME_TABLE, value):
								Ok((_, projected)): Some((global.value, projected))
								Err(_): None
						_: None
				_: None
		_: None


-- Lambdas nest to the depth the source writes them; the projection follows
-- each nesting once and holds nothing per link beyond its own frame.
func test_nested_lambdas_project_to_their_depth() -> Bool:
	depth = NESTED_LAMBDA_DEPTH
	var text: String = "func f() -> Int: "
	var level: Int = 0
	while level < depth:
		text += "func(a${level}): "
		level += 1
	text += "a0\n"
	match projected_function_body(text):
		Some(first):
			var current: ParsedExpr = first
			var lambdas: Int = 0
			var walking: Bool = True
			while walking:
				match current:
					ParsedLambdaExpr(_, _, _, body, _):
						lambdas += 1
						current = body
					_:
						walking = False
			lambdas == depth
		None: False


-- How deep a lambda chain the tests carry. Measured on Linux arm64 after the
-- tuple, braced and control merges: 500 passes and 700 overflows the native
-- stack, so this keeps a margin of 2.5 below the last depth known to pass.
-- The depth that is still owed is open item D7 (section 9).
NESTED_LAMBDA_DEPTH: Int = 200


-- The projected body of the only function of `text`: the old parser's
-- `ParsedFunctionDecl.body`, shaped by the tree path.
private func projected_function_body(text: String) -> Option[ParsedExpr]:
	lexed = lex_module(module_id_at_row(0), text)
	match new_parse_state(lexed):
		Err(_): None
		Ok(entry):
			(_, scan) = scan_module_declaration_prefix_with_bodies(entry)
			match legacy_declaration_projection(preview_source(lexed), scan, EMPTY_NAME_TABLE):
				Err(_): None
				Ok(projected):
					match projected.declarations.get(0):
						Some(FunctionParsedDecl(function)): function.body
						_: None


-- The chain is nested in the else branches, so the walk descends by a loop.
func test_deep_else_if_chain_projects_by_a_loop() -> Bool:
	links = 2000
	var lines: List[String] = ["func f(a: Int) -> Int:", "\tif a:", "\t\t0"]
	var written: Int = 1
	while written < links:
		lines = lines.append("\telse if a:")
		lines = lines.append("\t\t${written}")
		written += 1
	lines = lines.append("\telse:")
	lines = lines.append("\t\t${links}")
	match projected_function_body(source_lines(lines)):
		Some(ParsedBlockExpr([ParsedIfExpr(_, _, first_else, _)], _)):
			var current: Option[ParsedElseBranch] = first_else
			var depth: Int = 1
			var correct: Bool = True
			while current.is_some():
				match current:
					Some(branch):
						match branch.body:
							ParsedIfExpr(_, _, next, _):
								depth += 1
								current = next
							_:
								-- The last arm is the `else:` block, not another `if`.
								current = None
					None:
						correct = False
			correct and depth == links
		_: False


-- Value `if`s nest by indentation, so projection follows that nesting.
func test_deeply_nested_value_ifs_project() -> Bool:
	depth = 1000
	var lines: List[String] = ["func f(a: Int) -> Int:"]
	var level: Int = 0
	while level < depth:
		lines = lines.append("\t".repeat(level + 1) + "v${level} = if a:")
		level += 1
	lines = lines.append("\t".repeat(depth + 1) + "1")
	match projected_function_body(source_lines(lines)):
		Some(body):
			var current: ParsedExpr = body
			var nested: Int = 0
			var walking: Bool = True
			while walking:
				match current:
					ParsedBlockExpr([ParsedAssignExpr(_, ParsedIfExpr(_, then_block, _, _), _)], _):
						current = then_block
						nested += 1
					_:
						walking = False
			nested == depth
		None: False


-- Block forms nest by indentation, so projection follows that nesting. Each
-- test nests `depth` forms, each the only statement of the one around it.
func test_deeply_nested_with_blocks_project() -> Bool:
	depth = 1000
	var lines: List[String] = ["func f(p: Int) -> Int:"]
	var level: Int = 0
	while level < depth:
		lines = lines.append("\t".repeat(level + 1) + "with r${level} = open(p):")
		level += 1
	lines = lines.append("\t".repeat(depth + 1) + "1")
	match projected_function_body(source_lines(lines)):
		Some(body):
			var current: ParsedExpr = body
			var nested: Int = 0
			var walking: Bool = True
			while walking:
				match current:
					ParsedBlockExpr([ParsedWithExpr(_, inner, _)], _):
						current = inner
						nested += 1
					_:
						walking = False
			nested == depth
		None: False


func test_deeply_nested_concurrent_blocks_project() -> Bool:
	depth = 1000
	var lines: List[String] = ["func f(p: Int) -> Int:"]
	var level: Int = 0
	while level < depth:
		lines = lines.append("\t".repeat(level + 1) + "concurrent(max_threads: 2, timeout: p):")
		level += 1
	lines = lines.append("\t".repeat(depth + 1) + "1")
	match projected_function_body(source_lines(lines)):
		Some(body):
			var current: ParsedExpr = body
			var nested: Int = 0
			var walking: Bool = True
			while walking:
				match current:
					ParsedBlockExpr([ParsedConcurrentBlockExpr(_, inner, _)], _):
						current = inner
						nested += 1
					_:
						walking = False
			nested == depth
		None: False


func test_deeply_nested_debug_blocks_project() -> Bool:
