-- Completed function bodies: the tree scan's statements and blocks, projected
-- for the frozen parser, equal its own parse; and the walks that follow a
-- source's length are loops.
import:
	../../../src/compiler/discovery_tree_projection:
		legacy_declaration_projection,
		LegacyDeclarationPreviewError(UnsupportedBodyStatement, MissingIntegerLiteralToken, UnsupportedGlobalInitializerExpression),
	../../../src/compiler_new/stage_01_discovery/tables/span: span_start, span_end
	../../../src/compiler/stage_02_lex/name_table: name_table_spellings, EMPTY_NAME_TABLE, IdentifierSpellings(SpellingsFromIdentifierText, SpellingsFromNameTable)
	../../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../../src/compiler/stage_03_parse/parsed_ast:
		ParsedDecl(FunctionParsedDecl, VarParsedDecl), ParsedExpr(ParsedBlockExpr, ParsedIfExpr, ParsedLambdaExpr, ParsedAssignExpr, ParsedMatchExpr, ParsedNameExpr, ParsedStringLiteralExpr, ParsedStringInterpolationPartsExpr, ParsedWithExpr, ParsedSelectExpr, ParsedConcurrentBlockExpr, ParsedConcurrentForExpr, ParsedDebugBlockExpr), ParsedElseBranch,
		ParsedStringInterpolationPart(ParsedInterpolationLiteral, ParsedInterpolationExpr), ParsedStringLiteralForm(ParsedPipeStringLiteral)
	../tools/discovery_adapter_comparison: with_holes_parsed
	../../../src/compiler/stage_03_parse/parsed_ast_json: ast_json_render, parsed_decl_to_json
	../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../src/compiler_new/stage_01_discovery/parse/parse_state: MAX_SYNTAX_NESTING, new_parse_state, issued_ids, spellings, diagnostic_count
	../../../src/compiler_new/stage_01_discovery/parse/preview_source: preview_source
	../../../src/compiler_new/stage_01_discovery/parse/tree_module_declaration_scan:
		scan_module_declarations, ModuleDeclarationScanStop(ReachedEndOfSource)
	../../../src/compiler_new/stage_01_discovery/syntax/dump: dumped_module
	../../../src/compiler_new/stage_01_discovery/syntax/id_census: id_census
	../../../src/compiler_new/stage_01_discovery/syntax/module_syntax: ModuleSyntax, ModuleItem(FunctionItem)
	../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_at_row
	../../../src/lib/source: source_file
	test: TestSuite


-- An interpolation hole, spelled without opening one in this file's own string.
private pure func hole(text: String) -> String:
	"$" + "{" + text + "}"


private pure func source_lines(lines: List[String]) -> String:
	lines.join("\n") + "\n"


-- Whether the tree scan completes every declaration of `text`, and its
-- projection equals the frozen parser's declaration for declaration.
private func bodies_match_old_parser(text: String) -> Bool:
	source = source_file("/tmp/tree_body_projection.brp", "tree_body_projection", text)
	old = with_holes_parsed(parse_compiler_source(source))
	lexed = lex_module(module_id_at_row(0), text)
	match new_parse_state(lexed):
		Err(_): False
		Ok(entry):
			(_, scan) = scan_module_declarations(entry)
			reached_end: Bool = match scan.stop:
				ReachedEndOfSource: True
				_: False
			if not old.diagnostics.is_empty() or not reached_end:
				print("scan stopped or the old parser rejected: ${text}")
				False
			else:
				match legacy_declaration_projection(preview_source(lexed), scan, EMPTY_NAME_TABLE):
					Err(UnsupportedBodyStatement(span)):
						print("unsupported statement at ${span.span_start()}..${span.span_end()}: ${text}")
						False
					Err(MissingIntegerLiteralToken(span)):
						print("integer token missing ${span.span_start()}")
						False
					Err(UnsupportedGlobalInitializerExpression(span)):
						print("unsupported expression ${span.span_start()}..${span.span_end()}")
						False
					Err(_):
						print("projection error: ${text}")
						False
					Ok(projected):
						var correct: Bool = projected.declarations.length() == old.decls.length()
						var index: Int = 0
						while correct and index < old.decls.length():
							match (old.decls.get(index), projected.declarations.get(index)):
								(Some(expected), Some(actual)):
									expected_json = parsed_decl_to_json(ast_json_render(source, SpellingsFromIdentifierText), expected).to_string()
									actual_json = parsed_decl_to_json(ast_json_render(source, SpellingsFromNameTable(projected.names)), actual).to_string()
									if expected_json != actual_json:
										print("declaration ${index} expected: ${expected_json}\nactual: ${actual_json}")
										correct = False
								_: correct = False
							index += 1
						correct


-- Newly completed body fixtures must own exactly their issued syntax ids.
private func bodies_and_ids_match_old_parser(text: String) -> Bool:
	if not bodies_match_old_parser(text):
		False
	else:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(entry):
				(state, scan) = scan_module_declarations(entry)
				issued = state.issued_ids()
				syntax: ModuleSyntax = { documentation = None, items = scan.items, definitions = issued.definitions, imports = issued.imports, counts = issued.counts }
				id_census(module_id_at_row(0), syntax).is_empty()
			Err(_): False


func test_next_line_values_match_frozen_layout_and_anchors() -> Bool:
	var correct = True
	for head in ["value =", "var value =", "value: String =", "value ?=", "value: String ?=", "value +=", "values[0] =", "_ =", "(left, right) ="]:
		for value in ["|hello", "|hello " + hole("name"), "1 + 2", "raw", "if flag:"]:
			lines = if value == "raw":
				["func f():", "\t" + head, "\t\traw", "\t\t\t|hello", "\t1", "func sibling(): 1"]
			else if value == "if flag:":
				["func f():", "\t" + head, "\t\tif flag:", "\t\t\t1", "\t\telse:", "\t\t\t2", "\t1", "func sibling(): 1"]
			else:
				["func f():", "\t" + head, "\t\t" + value, "\t1", "func sibling(): 1"]
			correct = bodies_and_ids_match_old_parser(source_lines(lines)) and correct
	correct = bodies_and_ids_match_old_parser(source_lines(["func f():", "\tvalue =", "\t\t|first " + hole("name"), "\t\t|second", "\tvalue", "func sibling(): 1"])) and correct
	correct = bodies_and_ids_match_old_parser(source_lines(["func f():", "\tvalue =", "\t\tsource", "\t\t\t.first()", "\t\t\t.second()", "\tvalue", "func sibling(): 1"])) and correct
	for value in ["|hello", "|hello " + hole("name"), "1 + 2"]:
		correct = bodies_and_ids_match_old_parser(source_lines(["var greeting =", "\t" + value, "func sibling(): 1"])) and correct
	correct


func test_next_line_control_values_continue_operators() -> Bool:
	var correct = True
	for head in ["value =", "var value =", "value: Int =", "value ?=", "value: Int ?=", "value +=", "values[0] =", "_ =", "(left, right) ="]:
		for operator in ["+ 3", "- 3", "* 3"]:
			for control in [
				["\t\tif flag:", "\t\t\t1", "\t\telse:", "\t\t\t2"],
				["\t\tmatch flag:", "\t\t\tTrue: 1", "\t\t\tFalse: 2"]
			]:
				lines = ["func f():", "\t" + head].concat(control).concat(["\t\t" + operator, "\t1", "func sibling(): 1"])
				correct = bodies_and_ids_match_old_parser(source_lines(lines)) and correct
	for operator in ["+ 3", "- 3", "* 3"]:
		correct = bodies_and_ids_match_old_parser(source_lines(["value =", "\tif flag:", "\t\t1", "\telse:", "\t\t2", "\t" + operator, "func sibling(): 1"])) and correct
	correct


func test_soft_keyword_binding_heads_match_old_parser() -> Bool:
	var correct = True
	for name in ["debug", "select", "with", "concurrent", "concurrently", "after", "sealed", "on"]:
		for tail in [" = 1", " += 1", ": Int = 1", " ?= value", ": Int ?= value"]:
			correct = bodies_and_ids_match_old_parser(source_lines(["func f():", "\t" + name + tail, "\t1", "func sibling(): 1"])) and correct
		for lines in [
			["\tvar " + name + " = 1", "\t1"],
			["\tfor " + name + " in values:", "\t\t1", "\t1"],
			["\twith " + name + " = source:", "\t\t1", "\t1"],
			["\tfunc " + name + "(): 1", "\t1"]
		]:
			correct = bodies_and_ids_match_old_parser(source_lines(["func f():"].concat(lines).concat(["func sibling(): 1"]))) and correct
		if name != "sealed":
			correct = bodies_and_ids_match_old_parser(source_lines([
				"func f():", "\tselect:", "\t\t" + name + " from source:", "\t\t\t1",
				"\t\tsealed source:", "\t\t\t2", "\t\t_ after 1:", "\t\t\t3", "\t1", "func sibling(): 1"
			])) and correct
	correct and bodies_and_ids_match_old_parser(source_lines(["func f():", "\tdebug.print(value)", "\t1", "func sibling(): 1"]))


func test_soft_select_binder_names_follow_authored_order() -> Bool:
	text = source_lines(["func f():", "\tselect:", "\t\tafter from source:", "\t\t\t1", "func sibling(): 1"])
	lexed = lex_module(module_id_at_row(0), text)
	match new_parse_state(lexed):
		Ok(entry):
			(_, scan) = scan_module_declarations(entry)
			match legacy_declaration_projection(preview_source(lexed), scan, EMPTY_NAME_TABLE):
				Ok(projected):
					name_table_spellings(projected.names) == ["f", "after", "source", "sibling"] and bodies_and_ids_match_old_parser(text)
				Err(_): False
		Err(_): False


func test_builtin_values_match_frozen_body_contexts() -> Bool:
	bodies_match_old_parser(source_lines([
		"trait Shape:", "\tfunc value(x: Int) -> Int: builtin(\"trait_helper\")",
		"implements Shape for Int:", "\tfunc value(x: Int) -> Int: builtin",
		"func f():", "\t(a, b) = builtin(\"pair_helper\")",
		"\tvalue = f(builtin, builtin(\"helper\")).field + builtin",
		"\ttext = \"" + hole("builtin(\"helper\")") + "\"", "\tvalue", "func sibling(): builtin"
	]))


func test_opaque_conversion_values_keep_their_own_block_anchor() -> Bool:
	var correct = True
	for value_lines in [
		["\t\tfunc(x):", "\t\t\tx"],
		["\t\tif flag:", "\t\t\tfirst", "\t\telse:", "\t\t\tsecond"],
		["\t\tmatch flag:", "\t\t\t_: first"]
	]:
		correct = bodies_match_old_parser(source_lines([
			"func f():", "\tconverted = into_opaque Handle("
		].concat(value_lines).concat(["\t).finish()", "\tconverted", "func sibling(): 1"]))) and correct
	correct = correct and bodies_match_old_parser(source_lines([
		"trait Shape:", "\tfunc value(x: Int) -> Int: into_opaque Count(x)",
		"implements Shape for Int:", "\tfunc value(x: Int) -> Int: from_opaque Count(x)",
		"func sibling(): 1"
	]))
	correct and bodies_match_old_parser(source_lines([
		"func f():", "\t(a, b) = from_opaque Pair(pair)",
		"\tvalue = \"" + hole("into_opaque Handle(a)") + "\"", "\tvalue", "func sibling(): 1"
	]))


func test_flat_tuple_destructuring_matches_old_parser() -> Bool:
	var correct = True
	for target in ["(a, b)", "(_, b)", "(a, _, c)", "(_, b, c, _)", "(a, b,)", "(a, _, c, d,)", "(\n\t\ta,\n\t\t_,\n\t\tc,\n\t)"]:
		correct = correct and bodies_and_ids_match_old_parser(source_lines([
			"func f():", "\t" + target + " = pair", "\ta", "func sibling(): 1"
		]))
	correct = correct and bodies_and_ids_match_old_parser(source_lines([
		"func f():", "\t(a, b) = if True:", "\t\tpair", "\telse:", "\t\tpair", "\ta", "func sibling(): 1"
	]))
	correct = correct and bodies_and_ids_match_old_parser(source_lines([
		"trait Shape:", "\tfunc value(x: Int) -> Int:", "\t\t(a, b) = x", "\t\ta",
		"implements Shape for Int:", "\tfunc value(x: Int) -> Int:", "\t\t(_, b) = x", "\t\tb"
	]))
	correct and bodies_and_ids_match_old_parser(source_lines([
		"func f():", "\tmapper = func(x):", "\t\t(a, b) = x", "\t\ta",
		"\tfunc local(x):", "\t\t(_, b) = x", "\t\tb", "\tmapper(pair)",
		"func sibling(): (first, second)"
	]))


-- Direct body parsing preserves body-only spelling order and the next owner.
func test_body_completion_keeps_written_spellings_and_following_owner() -> Bool:
	text = source_lines([
		"func f(source):",
		"\tvalue: BodyType = source",
		"\tmapper = func(lambda_arg: LambdaType) -> LambdaResult: lambda_arg",
		"\tfunc local(local_arg: LocalType) -> LocalResult:",
		"\t\tmatch local_arg:",
		"\t\t\tLocalCase(inner): \"value " + hole("inner + hole_only") + "\"",
		"\t\t\t_: value",
		"\tmapper(local(value))",
		"func sibling(sibling_arg: SiblingType): sibling_arg"
	])
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(entry):
			(state, scan) = scan_module_declarations(entry)
			issued = state.issued_ids()
			syntax: ModuleSyntax = { documentation = None, items = scan.items, definitions = issued.definitions, imports = issued.imports, counts = issued.counts }
			dump = syntax.dumped_module(state.spellings())
			var correct = state.diagnostic_count() == 0 and syntax.items.length() == 2 and syntax.definitions.length() == 3 and id_census(module_id_at_row(0), syntax).is_empty()
			for name in ["BodyType", "lambda_arg", "LambdaType", "LambdaResult", "local", "local_arg", "LocalType", "LocalResult", "LocalCase", "inner", "hole_only", "sibling", "SiblingType"]:
				correct = correct and dump.split(name).length() > 1
			correct and bodies_match_old_parser(text)
		Err(_): False


func test_expression_body_matches_old_parser() -> Bool:
	first: Bool = bodies_match_old_parser("func inc(x: Int) -> Int: x + 1\n")
	bodies_match_old_parser("pure func zero() -> Int: 0\n") and first


func test_leading_dot_chains_match_old_parser_with_siblings() -> Bool:
	var correct = True
	for tail in ["", " == 0", " == 0 or ready"]:
		correct = correct and bodies_match_old_parser(source_lines([
			"func f():", "\tx = values", "\t\t.map(func(item): item)", "\t\t.length()${tail}", "\tprint(x)", "\t-other", "\tx", "func g(): 1"
		]))
	for text in [
		source_lines(["func f():", "\tvalues", "\t\t.first()", "\t\t\t.second()", "\t\t.third()", "\tnot other"]),
		source_lines(["func f():", "\tx = values", "\t.first()", "\tx"]),
		source_lines(["func f():", "\tx: Int = values", "\t\t.length()", "\t(", "\t\tx == 1", "\t)"]),
		source_lines(["func f():", "\tif (text", "\t\t.trim()", "\t\t.is_empty()):", "\t\treport()", "\t0"]),
		source_lines(["func f():", "\tx = if flag:", "\t\t1", "\telse:", "\t\t2", "\t\t.abs()", "\tx"]),
		source_lines(["func f():", "\tdetach g(x)", "\t\t.finish()", "\t0"]),
		source_lines(["func f():", "\tfunc local():", "\t\tvalues", "\t\t\t.first()", "\tlocal()"]),
		source_lines(["func f():", "\tx = call(func():", "\t\tvalues", "\t\t\t.first()", "\t)", "\tprint(x)"]),
		source_lines(["func f():", "\tx = (values", "\t\t.first())", "\ty = call(values", "\t\t.second())", "\tx"]),
		source_lines(["func f():", "\tvalue = values", "\t\t.first()", "\t\"value " + hole("value.second()") + "\""])
	]:
		correct = correct and bodies_match_old_parser(text)
	correct


func test_long_continuation_chain_projects_by_a_loop() -> Bool:
	var lines = ["func f():", "\tvalues"]
	var index = 0
	while index < 256:
		lines = lines.append("\t\t.step()")
		index += 1
	lines = lines.append("\t0")
	bodies_match_old_parser(source_lines(lines))


func test_block_statements_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func g(xs: List[Int]) -> Int:",
		"\tvar total: Int = 0",
		"\tcount: Int = 3",
		"\tlater = total + count",
		"\t_ = later",
		"\ttotal += 1",
		"\ttotal -= 2",
		"\ttotal *= 3",
		"\ttotal /= 4",
		"\txs[0] = total",
		"\txs[0, 1] = (total)",
		"\t-total",
		"\ttotal"
	]))


func test_declaration_metadata_matches_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"private pure func hidden(x: Int) -> Int:",
		"\tx",
		"",
		"--- Documented.",
		"@tail_recursive",
		"func documented[T](x: T) -> T:",
		"\tx"
	]))


func test_control_flow_matches_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func g(xs: List[Int]) -> Int:",
		"\tvar total: Int = 0",
		"\tfor x in xs:",
		"\t\tif x < 0:",
		"\t\t\tcontinue",
		"\t\telse if x == 7:",
		"\t\t\tbreak",
		"\t\telse:",
		"\t\t\ttotal += x",
		"\twhile total > 100:",
		"\t\ttotal -= 1",
		"\t\tif total == 50:",
		"\t\t\tbreak",
		"\tfor _ in xs:",
		"\t\ttotal += 1",
		"\ttotal"
	]))


func test_question_bindings_and_tuple_loops_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func g(pairs: List[(Int, Int)]) -> Result[Int, String]:",
		"\tfirst ?= lookup(pairs)",
		"\tsecond: Int ?= lookup(pairs)",
		"\tfor (key, value) in pairs:",
		"\t\tvoid",
		"\tfor (_, value) in pairs:",
		"\t\tvoid",
		"\tfor (a, b, _) in rows:",
		"\t\tfor (a, b, c, d,) in rows:",
		"\t\t\tvoid",
		"\tfirst + second"
	]))


func test_completed_block_lambda_followers_match_old_parser() -> Bool:
	var correct = True
	for prefix in ["", "detach ", "not ", "- ", "1 + "]:
		for head in ["", "value = ", "var value = "]:
			correct = bodies_and_ids_match_old_parser(source_lines([
				"func f():", "\t" + head + prefix + "func(arg: Input) -> Output:",
				"\t\targ", "\tvar next = following", "\tnext", "func sibling(): sibling_value"
			])) and correct
		correct = bodies_and_ids_match_old_parser(source_lines([
			"global = " + prefix + "func(arg: Input) -> Output:", "\targ",
			"var next = following", "func sibling(): sibling_value"
		])) and correct
	correct = bodies_and_ids_match_old_parser(source_lines([
		"func f():", "\tif flag:", "\t\tdetach func():", "\t\t\tfunc(arg):",
		"\t\t\t\targ", "\tvar next = following", "\tnext", "func sibling(): sibling_value"
	])) and correct
	correct = bodies_and_ids_match_old_parser(source_lines([
		"func f():", "\tif flag:", "\t\tleft", "\telse:", "\t\tright",
		"\t+ func(arg):", "\t\targ", "\tvar next = following", "\tnext", "func sibling(): sibling_value"
	])) and correct
	correct


func test_lambdas_and_local_functions_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func g(xs: List[Int]) -> Int:",
		"\tdouble = func(x): x * 2",
		"\ttyped = func(first: Int, _, last: Int,) -> Int: first + last",
		"\tconstant = pure func(): 1",
		"\ttotal = xs.map(func(item): item + 1).map(pure func(item: Int) -> Int: item * 2).length()",
		"\tnested = func(a): func(b): a + b",
		"\tblock = func(x):",
		"\t\tstep = x + 1",
		"\t\tstep",
		"\tfor item in xs:",
		"\t\tlater = func(): item",
		"\t\tchecked = func(y):",
		"\t\t\tvalue ?= lookup(y)",
		"\t\t\tvalue",
		"\tfunc helper(x: Int) -> Int:",
		"\t\tdoubled = double(x)",
		"\t\tdoubled + 1",
		"\tpure func tidy[T](x: T) -> T: x",
		"\tfunc outer():",
		"\t\tfunc inner() -> Int: 1",
		"\t\tinner()",
		"\thelper(double(1)) + tidy(2) + outer()"
	]))


func test_match_statements_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func g(value: Int) -> Int:",
		"\tmatch value:",
		"\t\t0: value",
		"\t\t-1: value + 1",
		"\t\t2.5: value",
		"\t\tTrue: 0",
		"\t\t\"text\": 1",
		"\t\t'c': 2",
		"\t\tSome(inner): inner",
		"\t\tmodule.Circle(radius, _): radius",
		"\t\t(left, right): left",
		"\t\t[first, second, ...rest]: first",
		"\t\t[..._]: 0",
		"\t\t7 | 8 | 9: 3",
		"\t\t_:",
		"\t\t\tvar local = value",
		"\t\t\tlocal",
		"\tvalue"
	]))


func test_control_item_entries_match_old_parser() -> Bool:
	var cases: List[(String, String)] = []
	for (name, opening, closing) in [
		("call control bypass", "f(match c:", "+ 3)"),
		("later call control bypass", "f(0, match c:", "+ 3)"),
		("list control bypass", "[match c:", "+ 3]"),
		("subscript control bypass", "values[match c:", "+ 3]"),
		("call RHS operators", "f(1 + match c:", "+ 3)"),
		("list RHS operators", "[1 + match c:", "+ 3]"),
		("subscript RHS operators", "values[1 + match c:", "+ 3]"),
		("first tuple operators", "(match c:", "+ 3, 2)"),
		("later tuple operators", "(0, match c:", "+ 3)"),
		("record field operators", "{field = match c:", "+ 3}"),
		("dict value operators", "{0 => match c:", "+ 3}"),
		("vector operators", "{match c:", "+ 3, 2}")
	]:
		cases = cases.append((name, source_lines(["func f(c: Int):", "\t" + opening, "\t\t\t\t_: 1", "\t" + closing, "\tfollowing(c)", "func sibling(): 1"])))
	var correct = agrees_with_old_parser(cases)
	for (_, text) in cases:
		source = source_file("/tmp/tree_control_items.brp", "tree_control_items", text)
		if with_holes_parsed(parse_compiler_source(source)).diagnostics.is_empty():
			correct = bodies_and_ids_match_old_parser(text) and correct
	correct


func test_control_operator_tails_match_old_parser() -> Bool:
	var correct = True
	for lines in [
		["\t(if c:", "\t\t1", "\telse:", "\t\t2", "\t+ 3 * 4)"],
		["\t(match c:", "\t\t0: True", "\t\t_: False", "\tand match c:", "\t\t_: True", "\t)"],
		["\tx = 1 + 2 * if c:", "\t\t3", "\telse:", "\t\t4", "\t+ 5 * 6", "\tx"],
		["\tx = c == 1 and match c:", "\t\t_: True", "\tor False and True", "\tx"],
		["\tif c:", "\t\t1", "\telse:", "\t\t2", "\t+ 3"],
		["\t-match c:", "\t\t_: 2", "\t* 3"],
		["\tx = if c:", "\t\t1", "\telse:", "\t\t2", "\t- 3", "\tx"],
		["\t((match c:", "\t\t_: values", "\t) + values).length()"],
		["\tmatch c:", "\t\t0:", "\t\t\t1", "\t\t_:", "\t\t\t2", "\t+ 3"],
		["\tx = 1 + if c:", "\t\t1", "\telse:", "\t\t2", "\t-z", "\tx"],
		["\tx = match c:", "\t\t_: 1", "\t-z", "\tx"],
		["\tmatch c:", "\t\t_: 1", "\tmatch c:", "\t\t_: 2", "\t-z"]
	]:
		text = source_lines(["func f(c: Int):"].concat(lines).concat(["\tfollowing(c)", "func sibling(): 1"]))
		correct = bodies_and_ids_match_old_parser(text) and correct
	correct


func test_control_expression_values_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
