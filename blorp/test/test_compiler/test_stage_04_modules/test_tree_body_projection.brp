func test_deeply_nested_selects_project() -> Bool:
	depth = 100
	var lines: List[String] = ["func f(p: Int) -> Int:"]
	var level: Int = 0
	while level < depth:
		lines = lines.append("\t".repeat(2 * level + 1) + "select:")
		lines = lines.append("\t".repeat(2 * level + 2) + "v${level} from p:")
		level += 1
	lines = lines.append("\t".repeat(2 * depth + 1) + "1")
	match projected_function_body(source_lines(lines)):
		Some(body):
			var current: ParsedExpr = body
			var nested: Int = 0
			var walking: Bool = True
			while walking:
				match current:
					ParsedBlockExpr([ParsedSelectExpr([arm], _)], _):
						current = arm.body
						nested += 1
					_:
						walking = False
			nested == depth
		None: False


func test_long_select_projects_every_arm() -> Bool:
	arms = 2000
	var lines: List[String] = ["func f(p: Int) -> Int:", "\tx = select:"]
	var written: Int = 0
	while written < arms:
		lines = lines.append("\t\tv${written} from p:")
		lines = lines.append("\t\t\t${written}")
		written += 1
	lines = lines.append("\tx")
	match projected_function_body(source_lines(lines)):
		Some(ParsedBlockExpr([ParsedAssignExpr(_, ParsedSelectExpr(parsed_arms, _), _), _], _)):
			parsed_arms.length() == arms
		_: False


func test_long_match_value_projects_every_arm() -> Bool:
	arms = 2000
	var lines: List[String] = ["func f(a: Int) -> Int:", "\tx = match a:"]
	var written: Int = 0
	while written < arms:
		lines = lines.append("\t\t${written}: ${written}")
		written += 1
	lines = lines.append("\t\t_: 0")
	lines = lines.append("\tx")
	match projected_function_body(source_lines(lines)):
		Some(ParsedBlockExpr([ParsedAssignExpr(_, ParsedMatchExpr(_, cases, _), _), _], _)):
			cases.length() == arms + 1
		_: False


func test_long_statement_list_projects_in_order() -> Bool:
	count = 5000
	var lines: List[String] = ["func f() -> Int:"]
	var written: Int = 0
	while written < count:
		lines = lines.append("\tvalue${written} = ${written}")
		written += 1
	lines = lines.append("\tvalue0")
	match projected_function_body(source_lines(lines)):
		Some(ParsedBlockExpr(items, _)): items.length() == count + 1
		_: False



func test_deeply_nested_concurrently_for_projects_every_body() -> Bool:
	depth = 100
	var lines: List[String] = ["func f():"]
	for level in 0..depth:
		lines = lines.append("\t".repeat(level + 1) + "for item in items concurrently(limit: 2, timeout: delay):")
	lines = lines.append("\t".repeat(depth + 1) + "continue")
	match projected_function_body(source_lines(lines)):
		Some(body):
			var current = body
			var nested = 0
			var walking = True
			while walking:
				match current:
					ParsedBlockExpr([ParsedConcurrentForExpr(_, _, _, next, _)], _):
						nested += 1
						current = next
					_: walking = False
			nested == depth
		None: False



func test_concurrently_for_names_follow_authored_order() -> Bool:
	text = source_lines(["func f():", "\tfor item in items concurrently(timeout: delay, limit: 2):", "\t\twork(item)", "func sibling(): 1"])
	lexed = lex_module(module_id_at_row(0), text)
	match new_parse_state(lexed):
		Ok(entry):
			(_, scan) = scan_module_declarations(entry)
			match legacy_declaration_projection(preview_source(lexed), scan, EMPTY_NAME_TABLE):
				Ok(projected): name_table_spellings(projected.names) == ["f", "item", "items", "delay", "work", "sibling"] and bodies_and_ids_match_old_parser(text)
				Err(_): False
		Err(_): False



func test_concurrently_for_matches_the_frozen_parser() -> Bool:
	var correct = True
	for parameters in ["limit: 2", "limit: ((007))", "limit: 2, timeout: delay + 1", "timeout: delay + 1, limit: 2", "limit: 2, timeout: wait(func(): 5),"]:
		for binder in ["item", "_", "debug", "concurrently"]:
			text = source_lines(["func f():", "\tfor " + binder + " in items concurrently(" + parameters + "):", "\t\tfor inner in items:", "\t\t\tcontinue", "\t\tbreak", "\t0", "func following(): 1"])
			correct = correct and bodies_and_ids_match_old_parser(text)
	correct

func test_lambda_holes_and_case_controls_match_frozen_syntax() -> Bool:
	var correct = True
	for text in [
		source_lines(["func f():", "\tvalue = \"" + hole("(pure func(x: Int) -> Int: x + 1)(2)") + " tail\"", "\tvalue", "func sibling(): 1"]),
		source_lines(["func f():", "\tx =", "\t\t|hello " + hole("(func(x): x)(1)"), "\tx", "func sibling(): 1"]),
		source_lines(["func f(value):", "\tmatch value:", "\t\t_: if True:", "\t\t\t1", "\t\telse:", "\t\t\t2", "func sibling(): 1"]),
		source_lines(["func f(value):", "\tmatch value:", "\t\t_: match value:", "\t\t\t_: 1", "func sibling(): 1"])
	]:
		correct = bodies_and_ids_match_old_parser(text) and correct
	correct


func test_call_and_braced_controls_inherit_loop_scope() -> Bool:
	var correct = True
	for exit in ["break", "continue"]:
		for (entry, closing) in [("consume(", ")"), ("consume(0,", ")"), ("-consume(", ")"), ("value = {", "}"), ("value = {field =", "}"), ("value = {0 =>", "}")]:
			text = source_lines(["func f(items):", "\tfor item in items:", "\t\t" + entry, "\t\t\tmatch item:", "\t\t\t\t_: ", "\t\t\t\t\t" + exit, "\t\t\t\t\t0", "\t\t" + closing, "\t0", "func sibling(): 1"])
			correct = bodies_and_ids_match_old_parser(text) and correct
	correct


func test_inline_case_control_leaves_binary_followers_to_the_match_reader() -> Bool:
	var correct = True
	for control in [["\t\t_: if flag:", "\t\t\t1", "\t\telse:", "\t\t\t2"], ["\t\t_: match flag:", "\t\t\t_: 1"]]:
		for follower in ["+ 3", "- 3"]:
			text = source_lines(["func f(flag):", "\tmatch flag:"].concat(control).concat(["\t\t" + follower]))
			source = source_file("/tmp/tree_inline_case_tail.brp", "tree_inline_case_tail", text)
			old = with_holes_parsed(parse_compiler_source(source))
			correct = correct and not old.diagnostics.is_empty()
			match new_parse_state(lex_module(module_id_at_row(0), text)):
				Ok(entry):
					(_, scan) = scan_module_declarations(entry)
					match scan.stop:
						ReachedEndOfSource: correct = False
						_: void
				Err(_): correct = False
	correct


func test_global_lambda_holes_preserve_frozen_syntax_and_ids() -> Bool:
	var correct = True
	for (header, value) in [
		("value: Int =", "\n\t|hello " + hole("(func(x): x)(1)")),
		("value =", " \"" + hole("(func(x): x)(1)") + "\""),
		("private var values: m.Buffer[Int][#N] =", " (\"" + hole("(pure func(x: Int) -> Int: x)(1)") + "\")")
	]:
		correct = bodies_and_ids_match_old_parser(header + value + "\nfunc sibling(): 1\n") and correct
	correct


