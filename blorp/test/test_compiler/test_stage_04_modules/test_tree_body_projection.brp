		"\t\t0: 1",
		"\t\tSome(inner): inner",
		"\t\t_:",
		"\t\t\tvar local = c",
		"\t\t\tlocal",
		"\tcounted: Int = if c:",
		"\t\tc",
		"\ttotal = 0",
		"\ttotal += if c:",
		"\t\t1",
		"\telse:",
		"\t\t2",
		"\txs[0] = match c:",
		"\t\t_: 5",
		"\t_ = if c:",
