func test_nested_block_forms_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func g(path: String, jobs: Channel[Int]) -> Int:",
		"\twith file = open(path):",
		"\t\tconcurrent(max_threads: 2):",
		"\t\t\tselect:",
		"\t\t\t\tjob from jobs:",
		"\t\t\t\t\tdebug:",
		"\t\t\t\t\t\twith inner = open(path):",
		"\t\t\t\t\t\t\tdetach inner.read()",
		"\t\t\t\t_ after 5:",
		"\t\t\t\t\tvoid",
		"\t\tfile.read()",
		"\tif ready:",
		"\t\twith file = open(path):",
		"\t\t\tfile.read()",
		"\telse:",
		"\t\tdebug:",
		"\t\t\tprint(path)",
		"\tmatch path:",
		"\t\t\"a\":",
		"\t\t\twith file = open(path):",
		"\t\t\t\tfile.read()",
		"\t\t_: detach cleanup()",
		"\t0"
	]))


