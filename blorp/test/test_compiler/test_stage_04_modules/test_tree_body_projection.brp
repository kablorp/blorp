	description = "Tree statement and block legacy projection",
	tests = [
		("expression bodies match the old parser", test_expression_body_matches_old_parser),
		("block statements match the old parser", test_block_statements_match_old_parser),
		("declaration metadata matches the old parser", test_declaration_metadata_matches_old_parser),
		("control flow matches the old parser", test_control_flow_matches_old_parser),
		("question bindings and tuple loops match the old parser", test_question_bindings_and_tuple_loops_match_old_parser),
		("lambdas and local functions match the old parser", test_lambdas_and_local_functions_match_old_parser),
		("match statements match the old parser", test_match_statements_match_old_parser),
		("control expression values match the old parser", test_control_expression_values_match_old_parser),
		("with resources match the old parser", test_with_resources_match_old_parser),
		("concurrent blocks match the old parser", test_concurrent_blocks_match_old_parser),
		("select arms match the old parser", test_select_arms_match_old_parser),
		("debug blocks and detach match the old parser", test_debug_blocks_and_detach_match_old_parser),
		("nested block forms match the old parser", test_nested_block_forms_match_old_parser),
		("lambdas in block form headers match the old parser", test_lambdas_in_block_form_headers_match_old_parser),
		("multiline braced forms match the old parser", test_multiline_braced_forms_match_old_parser),
		("multiline braced globals and bodies match the old parser", test_multiline_braced_globals_and_bodies_match_old_parser),
		("multiline calls, lists, tuples and groupings match the old parser", test_multiline_calls_lists_tuples_and_groupings_match_old_parser),
		("block arguments inside brackets match the old parser", test_block_arguments_inside_brackets_match_old_parser),
		("blocks in bracketed items follow the old anchor", test_blocks_in_bracketed_items_follow_the_old_anchor),
		("blocks in block headers follow the old anchor", test_blocks_in_block_headers_follow_the_old_anchor),
		("block indentation variants follow the old anchor", test_block_indentation_variants_follow_the_old_anchor),
		("same line bodies and globals follow the old anchor", test_same_line_bodies_and_globals_follow_the_old_anchor),
		("nested blocks match the old parser", test_nested_blocks_match_old_parser),
		("trait default bodies match the old parser", test_trait_default_bodies_match_old_parser),
		("implementation bodies match the old parser", test_implementation_bodies_match_old_parser),
		("several declarations match the old parser", test_several_declarations_match_old_parser),
		("string and character literals match the old parser", test_string_and_character_literals_match_old_parser),
		("interpolated strings match the old parser", test_interpolated_strings_match_old_parser),
		("character escapes and raw pipe strings match the old parser", test_character_escapes_and_raw_pipe_strings_match_old_parser),
		("pipe strings project like the old parser", test_pipe_strings_project_like_the_old_parser),
		("nested lambdas project to their depth", test_nested_lambdas_project_to_their_depth),
		("a 2000 link else if chain projects by a loop", test_deep_else_if_chain_projects_by_a_loop),
		("1000 nested value ifs project", test_deeply_nested_value_ifs_project),
		("a 2000 arm match value projects every arm", test_long_match_value_projects_every_arm),
		("1000 nested with blocks project", test_deeply_nested_with_blocks_project),
		("1000 nested concurrent blocks project", test_deeply_nested_concurrent_blocks_project),
		("1000 nested debug blocks project", test_deeply_nested_debug_blocks_project),
		("1000 nested selects project", test_deeply_nested_selects_project),
		("a 2000 arm select projects every arm", test_long_select_projects_every_arm),
		("5000 statements project in order", test_long_statement_list_projects_in_order)
	]
}
