import:
	../../../benchmark/compiler/compiler_core_ufcs_name_profile_fixture:
		CompilerCoreUfcsNameProfileConfig,
		compiler_core_ufcs_name_profile_baseline,
		compiler_core_ufcs_name_profile_benchmark,
	test: TestSuite


private TWO_MODULE_PROFILE_OUTPUT_BYTES: Int = 576

private TWO_MODULE_PROFILE_OUTPUT_CHECKSUM: Int = 3503755066375613654


pure func test_ufcs_name_profile_reuses_one_prefix_per_module() -> Bool:
	config: CompilerCoreUfcsNameProfileConfig = {
		iterations = 2,
		module_count = 2,
		names_per_module = 3
	}
	baseline = compiler_core_ufcs_name_profile_baseline(config)
	result = compiler_core_ufcs_name_profile_benchmark(config)

	(
		result.module_prefix_construction_count < baseline.module_prefix_construction_count
		and result.total_output_bytes == TWO_MODULE_PROFILE_OUTPUT_BYTES
		and result.output_checksum == TWO_MODULE_PROFILE_OUTPUT_CHECKSUM
		and baseline.total_output_bytes == result.total_output_bytes
		and baseline.output_checksum == result.output_checksum
		and result.workload_valid
	)


pure func test_ufcs_name_profile_scales_prefixes_by_modules_not_names() -> Bool:
	few_names = compiler_core_ufcs_name_profile_benchmark({
		iterations = 3,
		module_count = 1,
		names_per_module = 2,
	})
	many_names = compiler_core_ufcs_name_profile_benchmark({
		iterations = 3,
		module_count = 1,
		names_per_module = 8,
	})

	(
		many_names.module_prefix_construction_count == few_names.module_prefix_construction_count
		and many_names.full_name_construction_count > few_names.full_name_construction_count
		and few_names.workload_valid
		and many_names.workload_valid
	)


tests: TestSuite = {
	description = "Compiler Core UFCS name profile benchmark",
	tests = [
		("reuses one UFCS prefix per module", test_ufcs_name_profile_reuses_one_prefix_per_module),
		(
			"scales UFCS prefixes by modules rather than names",
			test_ufcs_name_profile_scales_prefixes_by_modules_not_names,
		),
	]
}
