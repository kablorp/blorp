-- A legitimate standard Range provider shared by phase-local tests. Keep
-- existing environments and meta sessions when adopting its record authority.
import:
	typecheck_test_support as TypecheckTestSupport
	../../src/compiler/stage_06_typecheck/graph/range_record:
		ResolvedRangeFields,
	../../src/compiler/stage_06_typecheck/state: TypecheckState
	../../src/compiler/stage_06_typecheck/type_system/accepted_record_authority:
		AcceptedRecordAuthority,
		accepted_record_range_fields,


pure func range_record_test_authority() -> Result[AcceptedRecordAuthority, String]:
	TypecheckTestSupport.range_record_test_authority()


pure func range_record_test_fields() -> Option[ResolvedRangeFields]:
	authority ?= range_record_test_authority().to_option()
	accepted_record_range_fields(authority)


pure func state_with_range_record_test_authority(
	state: TypecheckState,
) -> Result[TypecheckState, String]:
	TypecheckTestSupport.state_with_range_record_test_authority(state)
