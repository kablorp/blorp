import:
	../../src/lib/source:
		Cursor,
		SourceFile,
		SourceLineColumnSpan,
		SourceLocation,
		SourceSpan,
		compiler_prelude_source_location,
		singleton_source_table,
		source_advance,
		source_at_end,
		source_cursor_at,
		source_file,
		source_location,
		source_location_cover,
		source_location_from_offsets,
		source_location_line_column_span,
		source_location_span,
		source_peek,
		source_span,
		source_span_label,
		source_span_text,
		source_start,
		unindexed_source_table_for_file,
	memory:
		MemoryCounter(ManagedAllocations, MemoryStatsActive, OracleStatsActive),
		read_memory_counter,
		reset_mem_stats,
	test: TestSuite


pure func sample_source() -> SourceFile:
	source_file("sample.brp", "sample", "a\nbc\ndef")


-- Independent coordinate oracle: retain the public single-byte transition,
-- rather than reproducing the reconstruction scanner under test.
pure func advanced_cursor_at(src: SourceFile, offset: Int) -> Cursor:
	target = if offset < 0:
		0
	else if offset > src.text.length():
		src.text.length()
	else:
		offset
	var cursor: Cursor = source_start(src)
	while cursor.offset < target:
		cursor = source_advance(src, cursor)
	cursor


func test_reconstructed_coordinates_match_each_byte_transition() -> Bool:
	var matches: Bool = True
	for text in ["", "\n", "a\t\tb\n\tc\r\0é\n", "é\t\r\0z"]:
		src = source_file("bytes.brp", "bytes", text)
		(indexed, file_id) = singleton_source_table(src)
		unindexed = unindexed_source_table_for_file(src)
		var offset: Int = -1
		while offset <= text.length() + 1:
			expected = advanced_cursor_at(src, offset)
			actual = source_cursor_at(src, offset)
			location = source_location_from_offsets(file_id, expected.offset, expected.offset)
			indexed_span = source_location_line_column_span(indexed, location)
			unindexed_span = source_location_line_column_span(unindexed, location)
			matches = matches and (
				actual.offset == expected.offset
				and actual.line == expected.line
				and actual.column == expected.column
				and indexed_span.start_line == expected.line
				and indexed_span.start_column == expected.column
				and indexed_span.end_line == expected.line
				and indexed_span.end_column == expected.column
				and unindexed_span.start_line == expected.line
				and unindexed_span.start_column == expected.column
				and unindexed_span.end_line == expected.line
				and unindexed_span.end_column == expected.column
			)
			offset += 1
	matches


pure func reconstruction_allocation_source() -> SourceFile:
	source_file(
		"allocation.brp",
		"allocation",
		"first\n\tabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz\tend",
	)


-- `Cursor` and `SourceLineColumnSpan` are inline fixed records, so
-- reconstructing coordinates allocates nothing.
func test_cursor_reconstruction_allocates_nothing() -> Bool:
	src = reconstruction_allocation_source()
	expected = advanced_cursor_at(src, src.text.length())
	warm = source_cursor_at(src, src.text.length())
	if warm.column != expected.column or warm.line != expected.line:
		False
	else:
		reset_mem_stats()
		active_before = read_memory_counter(MemoryStatsActive)
		oracle_before = read_memory_counter(OracleStatsActive)
		before = read_memory_counter(ManagedAllocations)
		actual = source_cursor_at(src, src.text.length())
		after = read_memory_counter(ManagedAllocations)
		active_after = read_memory_counter(MemoryStatsActive)
		oracle_after = read_memory_counter(OracleStatsActive)
		(
			active_before == 1 and active_after == 1 and oracle_before == 1 and oracle_after == 1
			and after - before == 0
			and actual.offset == expected.offset
			and actual.line == expected.line
			and actual.column == expected.column
		)


func test_indexed_coordinates_allocate_nothing() -> Bool:
	src = reconstruction_allocation_source()
	(table, file_id) = singleton_source_table(src)
	location = source_location_from_offsets(file_id, src.text.length() - 2, src.text.length())
	expected_start = advanced_cursor_at(src, src.text.length() - 2)
	expected_end = advanced_cursor_at(src, src.text.length())
	warm = source_location_line_column_span(table, location)
	if warm.start_column != expected_start.column or warm.end_column != expected_end.column:
		False
	else:
		reset_mem_stats()
		active_before = read_memory_counter(MemoryStatsActive)
		oracle_before = read_memory_counter(OracleStatsActive)
		before = read_memory_counter(ManagedAllocations)
		actual = source_location_line_column_span(table, location)
		after = read_memory_counter(ManagedAllocations)
		active_after = read_memory_counter(MemoryStatsActive)
		oracle_after = read_memory_counter(OracleStatsActive)
		(
			active_before == 1 and active_after == 1 and oracle_before == 1 and oracle_after == 1
			and after - before == 0
			and actual.start_line == expected_start.line
			and actual.start_column == expected_start.column
			and actual.end_line == expected_end.line
			and actual.end_column == expected_end.column
		)


func test_unindexed_coordinates_allocate_nothing() -> Bool:
	src = reconstruction_allocation_source()
	table = unindexed_source_table_for_file(src)
	(_, file_id) = singleton_source_table(src)
	location = source_location_from_offsets(file_id, src.text.length() - 2, src.text.length())
	expected_start = advanced_cursor_at(src, src.text.length() - 2)
	expected_end = advanced_cursor_at(src, src.text.length())
	warm = source_location_line_column_span(table, location)
	if warm.start_column != expected_start.column or warm.end_column != expected_end.column:
		False
	else:
		reset_mem_stats()
		active_before = read_memory_counter(MemoryStatsActive)
		oracle_before = read_memory_counter(OracleStatsActive)
		before = read_memory_counter(ManagedAllocations)
		actual = source_location_line_column_span(table, location)
		after = read_memory_counter(ManagedAllocations)
		active_after = read_memory_counter(MemoryStatsActive)
		oracle_after = read_memory_counter(OracleStatsActive)
		(
			active_before == 1 and active_after == 1 and oracle_before == 1 and oracle_after == 1
			and after - before == 0
			and actual.start_line == expected_start.line
			and actual.start_column == expected_start.column
			and actual.end_line == expected_end.line
			and actual.end_column == expected_end.column
		)


func test_source_keeps_metadata() -> Bool:
	src: SourceFile = sample_source()
	src.path == "sample.brp" and src.module_name == "sample" and src.text.length() == 8


func test_cursor_tracks_newlines() -> Bool:
	src: SourceFile = sample_source()
	start: Cursor = source_start(src)
	after_a: Cursor = source_advance(src, start)
	after_newline: Cursor = source_advance(src, after_a)

	(
		after_newline.offset == 2
		and after_newline.line == 2
		and after_newline.column == 1
		and source_peek(src, after_newline).get_or('x') == 'b'
	)


func test_cursor_tracks_tabs_as_four_column_stops() -> Bool:
	src: SourceFile = source_file("tabs.brp", "tabs", "\tindent")
	start: Cursor = source_start(src)
	after_tab: Cursor = source_advance(src, start)
	after_i: Cursor = source_advance(src, after_tab)

	after_tab.offset == 1 and after_tab.line == 1 and after_tab.column == 5 and after_i.column == 6


func test_cursor_at_clamps_and_reconstructs_position() -> Bool:
	src: SourceFile = sample_source()
	before_start: Cursor = source_cursor_at(src, -5)
	middle: Cursor = source_cursor_at(src, 5)
	past_end: Cursor = source_cursor_at(src, 99)

	(
		before_start.offset == 0
		and middle.offset == 5
		and middle.line == 3
		and middle.column == 1
		and past_end.offset == src.text.length()
		and source_at_end(src, past_end)
	)


func test_span_text_and_label() -> Bool:
	src: SourceFile = sample_source()
	start: Cursor = source_cursor_at(src, 2)
	finish: Cursor = source_cursor_at(src, 4)
	span: SourceSpan = source_span(src, start, finish)

	source_span_text(src, span) == "bc" and source_span_label(span) == "sample.brp:2:1"


func test_source_table_materializes_compact_location() -> Bool:
	src: SourceFile = sample_source()
	table_and_id = singleton_source_table(src)
	location: SourceLocation = source_location(
		table_and_id[1],
		source_cursor_at(src, 2),
		source_cursor_at(src, 4),
	)
	span: SourceSpan = source_location_span(table_and_id[0], location)

	(
		span.path == "sample.brp"
		and span.module_name == "sample"
		and span.start_offset == 2
		and span.start_line == 2
		and span.start_column == 1
		and span.end_offset == 4
		and span.end_line == 2
		and span.end_column == 3
	)


func test_offset_location_materializes_empty_eof_extent() -> Bool:
	src = source_file("offsets.brp", "offsets", "first\n\tsecond")
	table_and_id = singleton_source_table(src)
	location = source_location_from_offsets(
		table_and_id[1],
		src.text.length(),
		src.text.length(),
	)
	span = source_location_span(table_and_id[0], location)

	(
		span.start_offset == src.text.length()
		and span.end_offset == src.text.length()
		and span.start_line == 2
		and span.start_column == 11
		and span.end_line == 2
		and span.end_column == 11
	)


func test_compact_location_cover_keeps_outer_coordinates() -> Bool:
	src: SourceFile = sample_source()
	table_and_id = singleton_source_table(src)
	left = source_location(
		table_and_id[1],
		source_cursor_at(src, 0),
		source_cursor_at(src, 1),
	)
	right = source_location(
		table_and_id[1],
		source_cursor_at(src, 5),
		source_cursor_at(src, 8),
	)
	span = source_location_span(
		table_and_id[0],
		source_location_cover(left, right),
	)

	span.start_offset == 0 and span.end_offset == 8


func test_compiler_prelude_location_keeps_its_identity_when_covered() -> Bool:
	src: SourceFile = sample_source()
	table_and_id = singleton_source_table(src)
	prelude = compiler_prelude_source_location()
	covered = source_location_cover(prelude, prelude)
	span = source_location_span(table_and_id[0], covered)

	(
		span.path == "<compiler-prelude>"
		and span.module_name == "<compiler-prelude>"
		and span.start_offset == 0
		and span.end_offset == 0
	)


func test_source_table_materializes_locations_after_tabs_and_newlines() -> Bool:
	src = source_file("indexed.brp", "indexed", "first\n\tsecond\nthird")
	table_and_id = singleton_source_table(src)
	location = source_location(
		table_and_id[1],
		source_cursor_at(src, 7),
		source_cursor_at(src, 13),
	)
	span = source_location_span(table_and_id[0], location)

	span.start_line == 2 and span.start_column == 5 and span.end_line == 2 and span.end_column == 11


func test_unindexed_source_table_materializes_locations_on_demand() -> Bool:
	src = source_file("deferred.brp", "deferred", "first\n\tsecond\nthird")
	table_and_id = singleton_source_table(src)
	location = source_location(
		table_and_id[1],
		source_cursor_at(src, 7),
		source_cursor_at(src, 13),
	)
	span = source_location_span(unindexed_source_table_for_file(src), location)

	span.start_line == 2 and span.start_column == 5 and span.end_line == 2 and span.end_column == 11


func test_line_column_span_matches_materialized_multiline_tab_location() -> Bool:
	src = source_file("coordinates.brp", "coordinates", "first\n\tsecond\nthird")
	table_and_id = singleton_source_table(src)
	location = source_location_from_offsets(table_and_id[1], 7, 16)
	coordinates: SourceLineColumnSpan = source_location_line_column_span(table_and_id[0], location)
	span = source_location_span(table_and_id[0], location)

	(
		coordinates.start_line == 2
		and coordinates.start_column == 5
		and coordinates.end_line == 3
		and coordinates.end_column == 3
		and coordinates.start_line == span.start_line
		and coordinates.start_column == span.start_column
		and coordinates.end_line == span.end_line
		and coordinates.end_column == span.end_column
	)


func test_line_column_span_matches_unindexed_and_prelude_locations() -> Bool:
	src = source_file("coordinates.brp", "coordinates", "first\n\tsecond\nthird")
	table = unindexed_source_table_for_file(src)
	location = source_location_from_offsets(singleton_source_table(src)[1], 7, 16)
	coordinates = source_location_line_column_span(table, location)
	span = source_location_span(table, location)
	prelude: SourceLineColumnSpan = source_location_line_column_span(
		table,
		compiler_prelude_source_location(),
	)

	(
		coordinates.start_line == span.start_line
		and coordinates.start_column == span.start_column
		and coordinates.end_line == span.end_line
		and coordinates.end_column == span.end_column
		and prelude.start_line == 1
		and prelude.start_column == 1
		and prelude.end_line == 1
		and prelude.end_column == 1
	)


tests: TestSuite = {
	description = "Shared source foundation",
	tests = [
		(
			"reconstructed coordinates match each byte transition",
			test_reconstructed_coordinates_match_each_byte_transition,
		),
		(
			"cursor reconstruction allocates nothing",
			test_cursor_reconstruction_allocates_nothing,
		),
		(
			"indexed coordinates allocate nothing",
			test_indexed_coordinates_allocate_nothing,
		),
		(
			"unindexed coordinates allocate nothing",
			test_unindexed_coordinates_allocate_nothing,
		),
		("source keeps metadata", test_source_keeps_metadata),
		("cursor tracks newlines", test_cursor_tracks_newlines),
		("cursor tracks tabs as four column stops", test_cursor_tracks_tabs_as_four_column_stops),
		(
			"cursor_at clamps and reconstructs position",
			test_cursor_at_clamps_and_reconstructs_position,
		),
		("span text and label", test_span_text_and_label),
		(
			"source table materializes compact location",
			test_source_table_materializes_compact_location,
		),
		(
			"compact location cover keeps outer coordinates",
			test_compact_location_cover_keeps_outer_coordinates,
		),
		(
			"offset location materializes empty EOF extent",
			test_offset_location_materializes_empty_eof_extent,
		),
		(
			"compiler prelude location keeps its identity when covered",
			test_compiler_prelude_location_keeps_its_identity_when_covered,
		),
		(
			"source table materializes locations after tabs and newlines",
			test_source_table_materializes_locations_after_tabs_and_newlines,
		),
		(
			"unindexed source table materializes locations on demand",
			test_unindexed_source_table_materializes_locations_on_demand,
		),
		(
			"line column span matches materialized multiline tab location",
			test_line_column_span_matches_materialized_multiline_tab_location,
		),
		(
			"line column span matches unindexed and prelude locations",
			test_line_column_span_matches_unindexed_and_prelude_locations,
		),
	]
}
