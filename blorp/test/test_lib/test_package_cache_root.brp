import:
	../../src/lib/package_cache_root: PackageCacheEnvironment, package_cache_root_from
	test: TestSuite


private pure func environment(
	package_cache: Option[String],
	xdg_cache_home: Option[String],
	home: Option[String],
) -> PackageCacheEnvironment:
	{
		package_cache = package_cache,
		xdg_cache_home = xdg_cache_home,
		home = home,
		temporary_root = "/tmp/probe"
	}


pure func test_package_cache_override_is_the_root_itself() -> Bool:
	package_cache_root_from(
		environment(Some("/override"), Some("/xdg"), Some("/home/user")),
	) == "/override"


pure func test_xdg_cache_home_beats_home() -> Bool:
	package_cache_root_from(
		environment(None, Some("/xdg"), Some("/home/user")),
	) == "/xdg/blorp/packages"


pure func test_home_cache_is_the_default() -> Bool:
	package_cache_root_from(
		environment(None, None, Some("/home/user")),
	) == "/home/user/.cache/blorp/packages"


pure func test_temporary_directory_is_the_last_resort() -> Bool:
	package_cache_root_from(environment(None, None, None)) == "/tmp/probe/.cache/blorp/packages"


pure func test_blank_values_count_as_unset() -> Bool:
	package_cache_root_from(
		environment(Some(""), Some("  "), Some("/home/user")),
	) == "/home/user/.cache/blorp/packages" and package_cache_root_from(
		environment(Some(" \t"), Some(""), Some("")),
	) == "/tmp/probe/.cache/blorp/packages"


tests: TestSuite = {
	description = "Package cache root resolution",
	tests = [
		("override is the root itself", test_package_cache_override_is_the_root_itself),
		("XDG cache home beats home", test_xdg_cache_home_beats_home),
		("home cache is the default", test_home_cache_is_the_default),
		("temporary directory is the last resort", test_temporary_directory_is_the_last_resort),
		("blank values count as unset", test_blank_values_count_as_unset),
	]
}
