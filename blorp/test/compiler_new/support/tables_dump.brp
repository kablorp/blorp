-- Renders frozen discovery tables as text for tests and the dump tool: roots,
-- modules (with their import rows and targets) and diagnostics, by id. Two
-- discoveries of the same inputs must render identically.
import:
	../../../src/compiler_new/stage_01_discovery/tables/builder:
		DiagnosticRow,
		ImportItemId,
		ImportRow,
		ModuleId,
		ModuleRow,
		RowRange,
		implicit_request_id_at_row,
		implicit_request_id_index,
		import_id_at_row,
		import_item_id_at_row,
		module_id_at_row,
		module_id_index,
		path_id_at_row,
		root_id_at_row,
		root_id_index,
		source_id_index,
	../../../src/compiler_new/stage_01_discovery/tables/diagnostic_code:
		DiscoveryDiagnosticCode(ImportCaseMismatchDiagnostic, RootCaseMismatchDiagnostic),
		diagnostic_code_name,
	../../../src/compiler_new/stage_01_discovery/tables/frontend_tables:
		FrontendTables,
		diagnostic_argument,
		diagnostic_count,
		diagnostic_row_at,
		implicit_diagnostic_argument,
		implicit_diagnostic_count,
		implicit_diagnostic_row_at,
		implicit_request_count,
		implicit_request_row,
		implicit_target,
		import_alias,
		import_item_alias,
		import_item_row_at,
		import_item_variant_row_at,
		import_path_part,
		import_row,
		import_target,
		module_count,
		module_package,
		module_row,
		name_spelling,
		path_text,
		resolution_diagnostic_count,
		resolution_diagnostic_row_at,
		root_count,
		root_diagnostic_argument,
		root_diagnostic_count,
		root_diagnostic_row_at,
		root_row,
		root_target,
		table_row_counts,
	../../../src/compiler_new/stage_01_discovery/tables/row_kinds:
		ImportRequestKind(BareModuleRequest, NativePackageRequest, RelativeModuleRequest),
		ModuleOriginKind(PackageModule, SourcePackageModule, StdlibModule, UserModule),
		ModuleReach(ImplicitModule, ImportedModule, RootModule),
	../../../src/compiler_new/stage_01_discovery/tables/span:
		span_end,
		span_source_index,
		span_start,


pure func range_text(range: RowRange) -> String:
	"${range.first}+${range.count}"


pure func origin_text(row: ModuleRow) -> String:
	match row.origin:
		StdlibModule:
			"stdlib"
		PackageModule:
			"package"
		SourcePackageModule:
			"source-package"
		UserModule:
			"user"


pure func reach_text(row: ModuleRow) -> String:
	match row.reach:
		RootModule:
			"root"
		ImplicitModule:
			"implicit"
		ImportedModule:
			"imported"


pure func request_kind_text(row: ImportRow) -> String:
	match row.request_kind:
		BareModuleRequest:
			"bare"
		RelativeModuleRequest:
			"relative"
		NativePackageRequest:
			"native-package"


pure func module_label(tables: FrontendTables, module: ModuleId) -> String:
	"m${module.module_id_index()}:${tables.path_text(tables.module_row(module).canonical_path)}"


pure func import_line(tables: FrontendTables, index: Int) -> String:
	import_id = import_id_at_row(index)
	row: ImportRow = tables.import_row(import_id)
	var parts: List[String] = []

	for ordinal in 0..row.path_parts.count:
		match tables.import_path_part(row, ordinal):
			Some(part):
				parts = parts.append(tables.name_spelling(part))
			None:
				parts = parts.append("?")

	alias_text: String = match tables.import_alias(import_id):
		Some(alias_row):
			" as ${tables.name_spelling(alias_row.alias_name)}"
		None:
			""

	var items: List[String] = []

	for item_index in row.items.first..row.items.first + row.items.count:
		item_id: ImportItemId = import_item_id_at_row(item_index)

		match tables.import_item_row_at(item_id):
			Some(item):
				var variants: List[String] = []

				for variant_index in item.variants.first..item.variants.first + item.variants.count:
					match tables.import_item_variant_row_at(variant_index):
						Some(variant):
							variants = variants.append(tables.name_spelling(variant.name))
						None:
							void

				variant_text: String = if variants.is_empty():
					""
				else:
					"(${variants.join(", ")})"

				item_alias_text: String = match tables.import_item_alias(item_id):
					Some(alias_row):
						" as ${tables.name_spelling(alias_row.alias_name)}"
					None:
						""

				items = items.append(
					tables.name_spelling(item.name) + variant_text + item_alias_text,
				)
			None:
				void

	target_text: String = match tables.import_target(import_id):
		Some(target):
			tables.module_label(target)
		None:
			"unresolved"

	"  import i${index} ${row.request_kind_text()} ${tables.path_text(row.request_path)} parents=${row.parent_steps} parts=${parts.join("/")}${alias_text} items=[${items.join(", ")}] -> ${target_text}"


---
A diagnostic argument as text: a stored spelling is shown as `stored=` and the path it
interns, every other argument as its integer.
---
pure func diagnostic_argument_text(
	tables: FrontendTables,
	code: DiscoveryDiagnosticCode,
	ordinal: Int,
	argument: Int,
) -> String:
	match code:
		ImportCaseMismatchDiagnostic:
			if ordinal == 1:
				"stored=${tables.path_text(path_id_at_row(argument))}"
			else:
				"${argument}"
		RootCaseMismatchDiagnostic:
			"stored=${tables.path_text(path_id_at_row(argument))}"
		_:
			"${argument}"


pure func diagnostic_line(tables: FrontendTables, row: DiagnosticRow, label: String) -> String:
	var argument_text: String = ""

	for ordinal in 0..row.arguments.count:
		argument: Int = tables
			.diagnostic_argument(row, ordinal)
			.get_or(-1)
		argument_text = argument_text + " " + tables.diagnostic_argument_text(
			row.code,
			ordinal,
			argument,
		)

	"  ${label} ${row.code.diagnostic_code_name()} s${row.span.span_source_index()}@${row.span.span_start()}-${row.span.span_end()}${argument_text}"


---
Roots, modules with their imports, and diagnostics, one fact per line.
---
pure func tables_dump(tables: FrontendTables) -> String:
	var lines: List[String] = []

	for root_index in 0..root_count(tables):
		root = root_id_at_row(root_index)

		target_text: String = match tables.root_target(root):
			Some(target):
				tables.module_label(target)
			None:
				"unloaded"

		lines = lines.append(
			"root r${root_index} ${tables.path_text(tables.root_row(root).request_path)} -> ${target_text}",
		)

	for root_diagnostic_index in 0..root_diagnostic_count(tables):
		match tables.root_diagnostic_row_at(root_diagnostic_index):
			Some(row):
				argument_text: String = match tables.root_diagnostic_argument(row, 0):
					Some(argument):
						if row.arguments.count > 0:
							" " + tables.diagnostic_argument_text(row.code, 0, argument)
						else:
							""
					None:
						""

				lines = lines.append(
					"root diagnostic r${row.root.root_id_index()} ${row.code.diagnostic_code_name()}${argument_text}",
				)
			None:
				void

	for request_index in 0..implicit_request_count(tables):
		request = implicit_request_id_at_row(request_index)

		target_text: String = match tables.implicit_target(request):
			Some(target):
				tables.module_label(target)
			None:
				"unloaded"

		lines = lines.append(
			"implicit i${request_index} ${tables.path_text(tables.implicit_request_row(request).request_path)} -> ${target_text}",
		)

	for implicit_diagnostic_index in 0..implicit_diagnostic_count(tables):
		match tables.implicit_diagnostic_row_at(implicit_diagnostic_index):
			Some(row):
				argument_text: String = match tables.implicit_diagnostic_argument(row, 0):
					Some(argument):
						if row.arguments.count > 0:
							" " + tables.diagnostic_argument_text(row.code, 0, argument)
						else:
							""
					None:
						""

				lines = lines.append(
					"implicit diagnostic i${row.request.implicit_request_id_index()} ${row.code.diagnostic_code_name()}${argument_text}",
				)
			None:
				void

	for module_index in 0..module_count(tables):
		module = module_id_at_row(module_index)
		row: ModuleRow = tables.module_row(module)

		package_text: String = match tables.module_package(module):
			Some(package):
				" package=${tables.name_spelling(package.name)}"
			None:
				""

		lines = lines.append(
			"module ${tables.module_label(module)} source=s${row.source.source_id_index()} ${row.origin_text()} ${row.reach_text()}${package_text} imports=${row.imports.range_text()} diagnostics=${row.diagnostics.range_text()}",
		)

		for import_index in row.imports.first..row.imports.first + row.imports.count:
			lines = lines.append(tables.import_line(import_index))

	for diagnostic_index in 0..diagnostic_count(tables):
		match tables.diagnostic_row_at(diagnostic_index):
			Some(row):
				lines = lines.append(tables.diagnostic_line(row, "diagnostic"))
			None:
				void

	for resolution_index in 0..resolution_diagnostic_count(tables):
		match tables.resolution_diagnostic_row_at(resolution_index):
			Some(row):
				lines = lines.append(tables.diagnostic_line(row, "resolution diagnostic"))
			None:
				void

	lines.join("\n")


---
`name=count` for every table.
---
pure func table_counts_line(tables: FrontendTables) -> String:
	tables
		.table_row_counts()
		.map(pure func(entry): "${entry[0]}=${entry[1]}")
		.join(" ")
