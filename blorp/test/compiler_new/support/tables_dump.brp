-- Renders frozen discovery tables as text for tests and the dump tool: roots,
-- modules (with their import rows and targets) and diagnostics, by id. Two
-- discoveries of the same inputs must render identically.
import:
	../../../src/compiler_new/stage_01_discovery/tables/diagnostic_code:
		ImplicitDiagnostic(ImplicitSourceTooLarge),
		ResolutionDiagnostic(
			ImportCaseMismatch, ImportSourceTooLarge, ImportTooManySources, UnreadableSource,
			UnresolvedImport, UnverifiableSpelling,
		),
		RootDiagnostic(
			RootCaseMismatch, RootSourceTooLarge, RootTooManySources, UnreadableRootSource,
			UnresolvedRoot, UnverifiableRootSpelling,
		),
		SyntaxDiagnostic(
			ConcurrentDuplicateParameter, ConcurrentForUnknownParameter, ConcurrentUnknownParameter,
			ExpectedToken, IntegerLiteralOverflow, Plain, ReservedKeywordAsName, UnexpectedByte,
			UnknownAnnotation, UnknownEscape,
		),
		implicit_diagnostic_name,
		resolution_diagnostic_name,
		root_diagnostic_name,
		syntax_diagnostic_name,
	../../../src/compiler_new/stage_01_discovery/tables/expected_token:
		ExpectedTokenDiagnostic(
			ExpectedArrow, ExpectedColon, ExpectedComma, ExpectedEqual, ExpectedFatArrow,
			ExpectedIndent, ExpectedKeyword, ExpectedLeftBrace, ExpectedLeftParen, ExpectedName,
			ExpectedNewline, ExpectedRightBrace, ExpectedRightBracket, ExpectedRightParen,
		),
	../../../src/compiler_new/stage_01_discovery/tables/frontend_tables:
		FrontendTables,
		diagnostic_count,
		diagnostic_row_at,
		implicit_rejection,
		implicit_request_count,
		implicit_request_row,
		implicit_target,
		import_alias,
		import_item_alias,
		import_item_row_at,
		import_item_variant_row_at,
		import_path_part,
		import_row,
		import_target,
		module_count,
		module_package,
		module_row,
		name_spelling,
		path_text,
		resolution_diagnostic_count,
		resolution_diagnostic_row_at,
		root_count,
		root_rejection,
		root_row,
		root_target,
		table_row_counts,
	../../../src/compiler_new/stage_01_discovery/tables/ids:
		ImportItemId,
		ModuleId,
		implicit_request_id_at_row,
		implicit_request_id_index,
		import_id_at_row,
		import_id_index,
		import_item_id_at_row,
		literal_id_index,
		module_id_at_row,
		module_id_index,
		name_id_index,
		root_id_at_row,
		root_id_index,
		source_id_index,
	../../../src/compiler_new/stage_01_discovery/tables/row_kinds:
		ImportRequestKind(BareModuleRequest, NativePackageRequest, RelativeModuleRequest),
		ModuleOriginKind(PackageModule, SourcePackageModule, StdlibModule, UserModule),
		ModuleReach(ImplicitModule, ImportedModule, RootModule),
	../../../src/compiler_new/stage_01_discovery/tables/rows:
		ImportRow,
		ModuleRow,
		ResolutionDiagnosticRow,
		RowRange,
		SyntaxDiagnosticRow,
	../../../src/compiler_new/stage_01_discovery/tables/span:
		span_end,
		span_source_index,
		span_start,


pure func range_text(range: RowRange) -> String:
	"${range.first}+${range.count}"


pure func origin_text(row: ModuleRow) -> String:
	match row.origin:
		StdlibModule:
			"stdlib"
		PackageModule:
			"package"
		SourcePackageModule:
			"source-package"
		UserModule:
			"user"


pure func reach_text(row: ModuleRow) -> String:
	match row.reach:
		RootModule:
			"root"
		ImplicitModule:
			"implicit"
		ImportedModule:
			"imported"


pure func request_kind_text(row: ImportRow) -> String:
	match row.request_kind:
		BareModuleRequest:
			"bare"
		RelativeModuleRequest:
			"relative"
		NativePackageRequest:
			"native-package"


pure func module_label(tables: FrontendTables, module: ModuleId) -> String:
	"m${module.module_id_index()}:${tables.path_text(tables.module_row(module).canonical_path)}"


pure func import_line(tables: FrontendTables, index: Int) -> String:
	import_id = import_id_at_row(index)
	row: ImportRow = tables.import_row(import_id)
	var parts: List[String] = []

	for ordinal in 0..row.path_parts.count:
		match tables.import_path_part(row, ordinal):
			Some(part):
				parts = parts.append(tables.name_spelling(part))
			None:
				parts = parts.append("?")

	alias_text: String = match tables.import_alias(import_id):
		Some(alias_row):
			" as ${tables.name_spelling(alias_row.alias_name)}"
		None:
			""

	var items: List[String] = []

	for item_index in row.items.first..row.items.first + row.items.count:
		item_id: ImportItemId = import_item_id_at_row(item_index)

		match tables.import_item_row_at(item_id):
			Some(item):
				var variants: List[String] = []

				for variant_index in item.variants.first..item.variants.first + item.variants.count:
					match tables.import_item_variant_row_at(variant_index):
						Some(variant):
							variants = variants.append(tables.name_spelling(variant.name))
						None:
							void

				variant_text: String = if variants.is_empty():
					""
				else:
					"(${variants.join(", ")})"

				item_alias_text: String = match tables.import_item_alias(item_id):
					Some(alias_row):
						" as ${tables.name_spelling(alias_row.alias_name)}"
					None:
						""

				items = items.append(
					tables.name_spelling(item.name) + variant_text + item_alias_text,
				)
			None:
				void

	target_text: String = match tables.import_target(import_id):
		Some(target):
			tables.module_label(target)
		None:
			"unresolved"

	"  import i${index} ${row.request_kind_text()} ${tables.path_text(row.request_path)} parents=${row.parent_steps} parts=${parts.join("/")}${alias_text} items=[${items.join(", ")}] -> ${target_text}"


---
The arguments of a lexer or parser diagnostic as text, each led by a space:
ids as their integers, a byte as its number, the construct of a missing token
as its position in its code's construct enum.
---
pure func syntax_arguments_text(tables: FrontendTables, diagnostic: SyntaxDiagnostic) -> String:
	match diagnostic:
		Plain(_):
			""
		ExpectedToken(expected):
			" ${expected_construct_text(expected)}"
		UnknownEscape(escaped):
			" ${to_int(escaped)}"
		UnexpectedByte(value):
			" ${to_int(value)}"
		IntegerLiteralOverflow(digits):
			" ${digits.literal_id_index()}"
		ReservedKeywordAsName(name):
			" ${name.name_id_index()}"
		UnknownAnnotation(name):
			" ${name.name_id_index()}"
		ConcurrentDuplicateParameter(name):
			" ${name.name_id_index()}"
		ConcurrentUnknownParameter(name):
			" ${name.name_id_index()}"
		ConcurrentForUnknownParameter(name):
			" ${name.name_id_index()}"


pure func expected_construct_text(expected: ExpectedTokenDiagnostic) -> String:
	match expected:
		ExpectedName(construct):
			to_string(construct)
		ExpectedColon(construct):
			to_string(construct)
		ExpectedComma(construct):
			to_string(construct)
		ExpectedLeftParen(construct):
			to_string(construct)
		ExpectedRightParen(construct):
			to_string(construct)
		ExpectedRightBracket(construct):
			to_string(construct)
		ExpectedLeftBrace(construct):
			to_string(construct)
		ExpectedRightBrace(construct):
			to_string(construct)
		ExpectedArrow(construct):
			to_string(construct)
		ExpectedEqual(construct):
			to_string(construct)
		ExpectedNewline(construct):
			to_string(construct)
		ExpectedIndent(construct):
			to_string(construct)
		ExpectedKeyword(construct):
			to_string(construct)
		ExpectedFatArrow(construct):
			to_string(construct)


---
The arguments of a module graph diagnostic about an import as text.
---
pure func resolution_arguments_text(
	tables: FrontendTables,
	diagnostic: ResolutionDiagnostic,
) -> String:
	match diagnostic:
		UnresolvedImport(import_id):
			" ${import_id.import_id_index()}"
		UnverifiableSpelling(import_id):
			" ${import_id.import_id_index()}"
		UnreadableSource(import_id):
			" ${import_id.import_id_index()}"
		ImportCaseMismatch(import_id, stored_path):
			" ${import_id.import_id_index()} stored=${tables.path_text(stored_path)}"
		ImportSourceTooLarge(byte_length):
			" ${byte_length}"
		ImportTooManySources:
			""


pure func root_arguments_text(tables: FrontendTables, diagnostic: RootDiagnostic) -> String:
	match diagnostic:
		RootCaseMismatch(stored_path):
			" stored=${tables.path_text(stored_path)}"
		RootSourceTooLarge(byte_length):
			" ${byte_length}"
		UnresolvedRoot:
			""
		UnverifiableRootSpelling:
			""
		UnreadableRootSource:
			""
		RootTooManySources:
			""


pure func implicit_arguments_text(diagnostic: ImplicitDiagnostic) -> String:
	match diagnostic:
		ImplicitSourceTooLarge(byte_length):
			" ${byte_length}"
		MissingImplicitModule:
			""
		UnverifiableImplicitSpelling:
			""
		UnreadableImplicitSource:
			""
		ImplicitTooManySources:
			""


pure func diagnostic_line(tables: FrontendTables, row: SyntaxDiagnosticRow) -> String:
	"  diagnostic ${row.diagnostic.syntax_diagnostic_name()} s${row.span.span_source_index()}@${row.span.span_start()}-${row.span.span_end()}${tables.syntax_arguments_text(row.diagnostic)}"


pure func resolution_diagnostic_line(
	tables: FrontendTables,
	row: ResolutionDiagnosticRow,
) -> String:
	"  resolution diagnostic ${row.diagnostic.resolution_diagnostic_name()} s${row.span.span_source_index()}@${row.span.span_start()}-${row.span.span_end()}${tables.resolution_arguments_text(row.diagnostic)}"


---
Roots, modules with their imports, and diagnostics, one fact per line.
---
pure func tables_dump(tables: FrontendTables) -> String:
	var lines: List[String] = []

	for root_index in 0..root_count(tables):
		root = root_id_at_row(root_index)

		target_text: String = match tables.root_target(root):
			Some(target):
				tables.module_label(target)
			None:
				"unloaded"

		lines = lines.append(
			"root r${root_index} ${tables.path_text(tables.root_row(root).request_path)} -> ${target_text}",
		)

	for root_index in 0..root_count(tables):
		match tables.root_rejection(root_id_at_row(root_index)):
			Some(diagnostic):
				lines = lines.append(
					"root diagnostic r${root_index} ${diagnostic.root_diagnostic_name()}${tables.root_arguments_text(diagnostic)}",
				)
			None:
				void

	for request_index in 0..implicit_request_count(tables):
		request = implicit_request_id_at_row(request_index)

		target_text: String = match tables.implicit_target(request):
			Some(target):
				tables.module_label(target)
			None:
				"unloaded"

		lines = lines.append(
			"implicit i${request_index} ${tables.path_text(tables.implicit_request_row(request).request_path)} -> ${target_text}",
		)

	for request_index in 0..implicit_request_count(tables):
		match tables.implicit_rejection(implicit_request_id_at_row(request_index)):
			Some(diagnostic):
				lines = lines.append(
					"implicit diagnostic i${request_index} ${diagnostic.implicit_diagnostic_name()}${implicit_arguments_text(diagnostic)}",
				)
			None:
				void

	for module_index in 0..module_count(tables):
		module = module_id_at_row(module_index)
		row: ModuleRow = tables.module_row(module)

		package_text: String = match tables.module_package(module):
			Some(package):
				" package=${tables.name_spelling(package.name)}"
			None:
				""

		lines = lines.append(
			"module ${tables.module_label(module)} source=s${row.source.source_id_index()} ${row.origin_text()} ${row.reach_text()}${package_text} imports=${row.imports.range_text()} diagnostics=${row.diagnostics.range_text()}",
		)

		for import_index in row.imports.first..row.imports.first + row.imports.count:
			lines = lines.append(tables.import_line(import_index))

	for diagnostic_index in 0..diagnostic_count(tables):
		match tables.diagnostic_row_at(diagnostic_index):
			Some(row):
				lines = lines.append(tables.diagnostic_line(row))
			None:
				void

	for resolution_index in 0..resolution_diagnostic_count(tables):
		match tables.resolution_diagnostic_row_at(resolution_index):
			Some(row):
				lines = lines.append(tables.resolution_diagnostic_line(row))
			None:
				void

	lines.join("\n")


---
`name=count` for every table.
---
pure func table_counts_line(tables: FrontendTables) -> String:
	tables
		.table_row_counts()
		.map(pure func(entry): "${entry[0]}=${entry[1]}")
		.join(" ")
