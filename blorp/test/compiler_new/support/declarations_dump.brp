-- Renders a builder's declaration tables as text, one declaration per line
-- with its members, signature and types beneath it, for declaration parser
-- tests. Written types render as a compact tree, for example
-- `Named(List)[Named(Int)]` or `Array(Named(Float); Dim(N))`.
import:
	../../../src/compiler_new/stage_01_discovery/tables/builder:
		DiscoveryBuilder,
		NodeId,
		NodeRow,
		ParameterRow,
		definition_id_index,
		foreign_block_id_index,
		literal_id_index,
		name_id_index,
		node_id_index,
		parameter_id_index,
	../../../src/compiler_new/stage_01_discovery/tables/row_kinds:
		DefinitionKind(
			BuiltinTypeDefinition,
			ConstantDefinition,
			EnumDefinition,
			FieldDefinition,
			ForeignFunctionDefinition,
			FunctionDefinition,
			ImplDefinition,
			ImplMethodDefinition,
			MutableGlobalDefinition,
			OpaqueTypeDefinition,
			RecordDefinition,
			ResourceTypeDefinition,
			StructDefinition,
			TraitDefinition,
			TraitMethodDefinition,
			TypeAliasDefinition,
			UnionDefinition,
			VariantDefinition,
		),
		FunctionAnnotation(
			DebugOnlyAnnotation,
			NoCopyAnnotation,
			ResourceResultOrdinaryAnnotation,
			TailRecursiveAnnotation,
		),
		NodeKind(
			ArrayTypeNode,
			BoundedTypeNode,
			DimensionAddTypeNode,
			DimensionDivideTypeNode,
			DimensionLiteralTypeNode,
			DimensionMultiplyTypeNode,
			DimensionNameTypeNode,
			DimensionSubtractTypeNode,
			DimensionWildcardTypeNode,
			FunctionTypeNode,
			MissingTypeNode,
			NamedTypeNode,
			PureFunctionTypeNode,
			QualifiedTypeNode,
			RangeTypeNode,
			TupleTypeNode,
			TypeBoundNode,
			TypeQualifierNode,
			VariadicDimensionNameTypeNode,
			VariadicDimensionWildcardTypeNode,
		),
		ParameterBinder(NamedParameterBinder, TupleParameterBinder, WildcardParameterBinder),
		Purity(ImpureFunction, PureFunction),
		TypeParameterKind(DimensionParameter, TypeParameter, WildcardDimensionParameter),
		Visibility(PrivateVisibility, PublicVisibility),
	../../../src/compiler_new/stage_01_discovery/tables/span: Span, span_end, span_start


---
`text` in double quotes. Built by concatenation: the formatter rewrites an
escaped quote that directly follows an interpolation.
---
pure func quoted(text: String) -> String:
	"\"" + text + "\""


pure func span_text(span: Span) -> String:
	"@${span.span_start()}-${span.span_end()}"


pure func spelling(builder: DiscoveryBuilder, index: Int) -> String:
	builder.name_spellings
		.get(index)
		.get_or("?")


pure func literal(builder: DiscoveryBuilder, index: Int) -> String:
	builder.literals
		.get(index)
		.get_or("?")


pure func kind_text(kind: DefinitionKind) -> String:
	match kind:
		FunctionDefinition:
			"func"
		RecordDefinition:
			"record"
		StructDefinition:
			"struct"
		UnionDefinition:
			"union"
		EnumDefinition:
			"enum"
		BuiltinTypeDefinition:
			"builtin-type"
		ResourceTypeDefinition:
			"resource-type"
		TypeAliasDefinition:
			"alias"
		OpaqueTypeDefinition:
			"opaque"
		TraitDefinition:
			"trait"
		ImplDefinition:
			"impl"
		ConstantDefinition:
			"constant"
		MutableGlobalDefinition:
			"var"
		ForeignFunctionDefinition:
			"foreign-func"
		FieldDefinition:
			"field"
		VariantDefinition:
			"variant"
		TraitMethodDefinition:
			"trait-method"
		ImplMethodDefinition:
			"impl-method"
		LocalFunctionDefinition:
			"local-func"


pure func annotation_text(annotation: FunctionAnnotation) -> String:
	match annotation:
		TailRecursiveAnnotation:
			"@tail_recursive"
		NoCopyAnnotation:
			"@no_copy"
		DebugOnlyAnnotation:
			"@debug_only"
		ResourceResultOrdinaryAnnotation:
			"@resource_result_ordinary"


pure func node_at(builder: DiscoveryBuilder, node: NodeId) -> Option[NodeRow]:
	builder.nodes.get(node.node_id_index())


pure func children_text(
	builder: DiscoveryBuilder,
	row: NodeRow,
	first_ordinal: Int,
	separator: String,
) -> String:
	var parts: List[String] = []

	for edge in row.children.first + first_ordinal..row.children.first + row.children.count:
		match builder.node_children.get(edge):
			Some(child):
				parts = parts.append(builder.type_text(child))
			None:
				void

	parts.join(separator)


---
A compact rendering of the type rooted at `node`.
---
pure func type_text(builder: DiscoveryBuilder, node: NodeId) -> String:
	match builder.node_at(node):
		Some(row):
			match row.kind:
				NamedTypeNode:
					arguments: String = builder.children_text(row, 0, ", ")

					if row.children.count == 0:
						"Named(${builder.spelling(row.payload)})"
					else:
						"Named(${builder.spelling(row.payload)})[${arguments}]"
				QualifiedTypeNode:
					"Qualified(${builder.children_text(row, 0, ", ")}.${builder.spelling(row.payload)})"
				TypeQualifierNode:
					builder.spelling(row.payload)
				BoundedTypeNode:
					"Bounded(${builder.spelling(row.payload)}: ${builder.children_text(row, 0, " + ")})"
				TypeBoundNode:
					builder.spelling(row.payload)
				DimensionNameTypeNode:
					"Dim(${builder.spelling(row.payload)})"
				VariadicDimensionNameTypeNode:
					"Dim(${builder.spelling(row.payload)}...)"
				DimensionWildcardTypeNode:
					"Dim(_)"
				VariadicDimensionWildcardTypeNode:
					"Dim(_...)"
				DimensionLiteralTypeNode:
					"Dim(${builder.literal(row.payload)})"
				DimensionAddTypeNode:
					"(${builder.children_text(row, 0, " + ")})"
				DimensionSubtractTypeNode:
					"(${builder.children_text(row, 0, " - ")})"
				DimensionMultiplyTypeNode:
					"(${builder.children_text(row, 0, " * ")})"
				DimensionDivideTypeNode:
					"(${builder.children_text(row, 0, " / ")})"
				RangeTypeNode:
					"Range(${builder.children_text(row, 0, ", ")})"
				TupleTypeNode:
					"Tuple(${builder.children_text(row, 0, ", ")})"
				FunctionTypeNode:
					"Func(${builder.children_text(row, 0, ", ")})"
				PureFunctionTypeNode:
					"PureFunc(${builder.children_text(row, 0, ", ")})"
				ArrayTypeNode:
					first: String = match builder.node_children.get(row.children.first):
						Some(element):
							builder.type_text(element)
						None:
							"?"

					"Array(${first}; ${builder.children_text(row, 1, ", ")})"
				MissingTypeNode:
					"Missing"
				_:
					"Expression"
		None:
			"?"


pure func definition_type_text(builder: DiscoveryBuilder, definition: Int) -> String:
	var text: String = ""

	for row in builder.definition_types:
		if row.definition.definition_id_index() == definition:
			text = " : " + builder.type_text(row.type_root)

	text


pure func parameter_text(builder: DiscoveryBuilder, parameter: ParameterRow, index: Int) -> String:
	var names: List[String] = []

	for binder_index in parameter.binder_names.first..parameter.binder_names.first + parameter.binder_names.count:
		match builder.binder_names.get(binder_index):
			Some(binder):
				names = names.append(builder.spelling(binder.name.name_id_index()))
			None:
				void

	binder_text: String = match parameter.binder:
		NamedParameterBinder:
			names.join("")
		WildcardParameterBinder:
			"_"
		TupleParameterBinder:
			"(${names.join(", ")})"

	var type_part: String = ""

	for row in builder.parameter_types:
		if row.parameter.parameter_id_index() == index:
			type_part = ": " + builder.type_text(row.type_root)

	binder_text + type_part


pure func signature_text(builder: DiscoveryBuilder, definition: Int) -> String:
	var text: String = ""

	for signature in builder.signatures:
		if signature.definition.definition_id_index() == definition:
			var parameters: List[String] = []

			for index in signature.parameters.first..signature.parameters.first + signature.parameters.count:
				match builder.parameters.get(index):
					Some(parameter):
						parameters = parameters.append(builder.parameter_text(parameter, index))
					None:
						void

			purity: String = match signature.purity:
				PureFunction:
					"pure "
				ImpureFunction:
					""

			text = " ${purity}(${parameters.join(", ")})"

	text


pure func type_parameters_text(builder: DiscoveryBuilder, definition: Int) -> String:
	var parameters: List[String] = []

	for parameter in builder.type_parameters:
		if parameter.owner.definition_id_index() == definition:
			var bounds: List[String] = []

			for bound in builder.bounds:
				if (
					bound.owner.definition_id_index() == definition
					and bound.parameter_ordinal == parameter.ordinal
				):
					bounds = bounds.append(builder.spelling(bound.trait_name.name_id_index()))

			prefix: String = match parameter.kind:
				TypeParameter:
					""
				DimensionParameter:
					"#"
				WildcardDimensionParameter:
					"#"

			bound_text: String = if bounds.is_empty():
				""
			else:
				": " + bounds.join(" + ")

			parameters = parameters.append(
				prefix + builder.spelling(parameter.name.name_id_index()) + bound_text,
			)

	if parameters.is_empty():
		""
	else:
		"[${parameters.join(", ")}]"


pure func extras_text(builder: DiscoveryBuilder, definition: Int) -> String:
	var parts: List[String] = []

	for row in builder.annotations:
		if row.definition.definition_id_index() == definition:
			parts = parts.append(row.annotation.annotation_text())

	for row in builder.documentation:
		if row.definition.definition_id_index() == definition:
			parts = parts.append("doc=" + quoted(builder.literal(row.text.literal_id_index())))

	for row in builder.supertraits:
		if row.trait_definition.definition_id_index() == definition:
			parts = parts.append("super=${builder.spelling(row.name.name_id_index())}")

	for row in builder.variant_payloads:
		if row.variant.definition_id_index() == definition:
			parts = parts.append("payload=${builder.type_text(row.type_root)}")

	for row in builder.dimension_constraints:
		if row.owner.definition_id_index() == definition:
			parts = parts.append(
				"where ${builder.type_text(row.left)} == ${builder.type_text(row.right)}",
			)

	for row in builder.foreign_bindings:
		if row.definition.definition_id_index() == definition:
			parts = parts.append("block=${row.block.foreign_block_id_index()}")

	for row in builder.foreign_c_names:
		if row.definition.definition_id_index() == definition:
			parts = parts.append("c_name=" + quoted(builder.literal(row.c_name.literal_id_index())))

	for row in builder.resource_cleanups:
		if row.definition.definition_id_index() == definition:
			parts = parts.append(
				"cleanup=" + quoted(builder.literal(row.builtin_name.literal_id_index())),
			)

	if parts.is_empty():
		""
	else:
		" {" + parts.join(" ") + "}"


pure func owner_of(builder: DiscoveryBuilder, definition: Int) -> Option[Int]:
	var found: Option[Int] = None

	for member in builder.members:
		if member.definition.definition_id_index() == definition:
			found = Some(member.owner.definition_id_index())

	found


---
One line per definition: members indented under their owner, in row
order. Then foreign blocks and diagnostics.
---
pure func declarations_dump(builder: DiscoveryBuilder) -> String:
	var lines: List[String] = []
	var index: Int = 0

	for row in builder.definitions:
		indent: String = if (
			builder
				.owner_of(index)
				.is_some()
		):
			"  "
		else:
			""

		visibility: String = match row.visibility:
			PrivateVisibility:
				"private "
			PublicVisibility:
				""

		lines = lines.append(
			"${indent}${visibility}${row.kind.kind_text()} ${builder.spelling(row.name.name_id_index())}${builder.type_parameters_text(index)}${builder.signature_text(index)}${builder.definition_type_text(index)}${builder.extras_text(index)} ${row.span.span_text()}",
		)
		index += 1

	var block_index: Int = 0

	for block in builder.foreign_blocks:
		var arguments: List[String] = []

		for argument_index in block.arguments.first..block.arguments.first + block.arguments.count:
			match builder.foreign_arguments.get(argument_index):
				Some(argument):
					arguments = arguments.append(
						builder.spelling(
							argument.name.name_id_index(),
						) + "=" + quoted(builder.literal(argument.value.literal_id_index())),
					)
				None:
					void

		lines = lines.append(
			"foreign-block ${block_index} (${arguments.join(", ")}) ${block.span.span_text()}",
		)
		block_index += 1

	lines.join("\n")
