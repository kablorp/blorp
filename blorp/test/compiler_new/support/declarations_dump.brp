-- Renders a builder's declaration tables as text, one declaration per line
-- with its members, signature and types beneath it, for declaration parser
-- tests. Written types render as a compact tree, for example
-- `Named(List)[Named(Int)]` or `Array(Named(Float); Dim(N))`.
import:
	../../../src/compiler_new/stage_01_discovery/discovery_builder:
		DiscoveryBuilder,
		NodeId,
		NodeRow,
		ParameterRow,
		definition_id_index,
		foreign_block_id_index,
		literal_id_index,
		name_id_index,
		node_id_index,
		parameter_id_index,
	../../../src/compiler_new/stage_01_discovery/row_kinds:
		DefinitionKind(
			BuiltinTypeDefinition,
			ConstantDefinition,
			EnumDefinition,
			FieldDefinition,
			ForeignFunctionDefinition,
			FunctionDefinition,
			ImplDefinition,
			ImplMethodDefinition,
			MutableGlobalDefinition,
			OpaqueTypeDefinition,
			RecordDefinition,
			ResourceTypeDefinition,
			StructDefinition,
			TraitDefinition,
			TraitMethodDefinition,
			TypeAliasDefinition,
			UnionDefinition,
			VariantDefinition,
		),
		FunctionAnnotation(
			DebugOnlyAnnotation,
			NoCopyAnnotation,
			ResourceResultOrdinaryAnnotation,
			TailRecursiveAnnotation,
		),
		NodeKind(
			ArrayTypeNode,
			BoundedTypeNode,
			DimensionAddTypeNode,
			DimensionDivideTypeNode,
			DimensionLiteralTypeNode,
			DimensionMultiplyTypeNode,
			DimensionNameTypeNode,
			DimensionSubtractTypeNode,
			DimensionWildcardTypeNode,
			FunctionTypeNode,
			MissingTypeNode,
			NamedTypeNode,
			PureFunctionTypeNode,
			QualifiedTypeNode,
			RangeTypeNode,
			TupleTypeNode,
			TypeBoundNode,
			TypeQualifierNode,
			VariadicDimensionNameTypeNode,
			VariadicDimensionWildcardTypeNode,
		),
		ParameterBinder(NamedParameterBinder, TupleParameterBinder, WildcardParameterBinder),
		Purity(ImpureFunction, PureFunction),
		TypeParameterKind(DimensionParameter, TypeParameter, WildcardDimensionParameter),
		Visibility(PrivateVisibility, PublicVisibility),
	../../../src/compiler_new/stage_01_discovery/span: Span, span_end, span_start


---
`text` in double quotes. Built by concatenation: the formatter rewrites an
escaped quote that directly follows an interpolation.
---
pure func quoted(text: String) -> String:
	"\"" + text + "\""


pure func span_text(span: Span) -> String:
	"@${span_start(span)}-${span_end(span)}"


pure func spelling(builder: DiscoveryBuilder, index: Int) -> String:
	builder.name_spellings
		.get(index)
		.get_or("?")


pure func literal(builder: DiscoveryBuilder, index: Int) -> String:
	builder.literals
		.get(index)
		.get_or("?")


pure func kind_text(kind: DefinitionKind) -> String:
	match kind:
		FunctionDefinition:
			"func"
		RecordDefinition:
			"record"
		StructDefinition:
			"struct"
		UnionDefinition:
			"union"
		EnumDefinition:
			"enum"
		BuiltinTypeDefinition:
			"builtin-type"
		ResourceTypeDefinition:
			"resource-type"
		TypeAliasDefinition:
			"alias"
		OpaqueTypeDefinition:
			"opaque"
		TraitDefinition:
			"trait"
		ImplDefinition:
			"impl"
		ConstantDefinition:
			"constant"
		MutableGlobalDefinition:
			"var"
		ForeignFunctionDefinition:
			"foreign-func"
		FieldDefinition:
			"field"
		VariantDefinition:
			"variant"
		TraitMethodDefinition:
			"trait-method"
		ImplMethodDefinition:
			"impl-method"
		LocalFunctionDefinition:
			"local-func"


pure func annotation_text(annotation: FunctionAnnotation) -> String:
	match annotation:
		TailRecursiveAnnotation:
			"@tail_recursive"
		NoCopyAnnotation:
			"@no_copy"
		DebugOnlyAnnotation:
			"@debug_only"
		ResourceResultOrdinaryAnnotation:
			"@resource_result_ordinary"


pure func node_at(builder: DiscoveryBuilder, node: NodeId) -> Option[NodeRow]:
	builder.nodes.get(node_id_index(node))


pure func children_text(
	builder: DiscoveryBuilder,
	row: NodeRow,
	first_ordinal: Int,
	separator: String,
) -> String:
	var parts: List[String] = []

	for edge in row.children.first + first_ordinal..row.children.first + row.children.count:
		match builder.node_children.get(edge):
			Some(child):
				parts = parts.append(type_text(builder, child))
			None:
				void

	parts.join(separator)


---
A compact rendering of the type rooted at `node`.
---
pure func type_text(builder: DiscoveryBuilder, node: NodeId) -> String:
	match node_at(builder, node):
		Some(row):
			match row.kind:
				NamedTypeNode:
					arguments: String = children_text(builder, row, 0, ", ")

					if row.children.count == 0:
						"Named(${spelling(builder, row.payload)})"
					else:
						"Named(${spelling(builder, row.payload)})[${arguments}]"
				QualifiedTypeNode:
					"Qualified(${children_text(builder, row, 0, ", ")}.${spelling(builder, row.payload)})"
				TypeQualifierNode:
					spelling(builder, row.payload)
				BoundedTypeNode:
					"Bounded(${spelling(builder, row.payload)}: ${children_text(builder, row, 0, " + ")})"
				TypeBoundNode:
					spelling(builder, row.payload)
				DimensionNameTypeNode:
					"Dim(${spelling(builder, row.payload)})"
				VariadicDimensionNameTypeNode:
					"Dim(${spelling(builder, row.payload)}...)"
				DimensionWildcardTypeNode:
					"Dim(_)"
				VariadicDimensionWildcardTypeNode:
					"Dim(_...)"
				DimensionLiteralTypeNode:
					"Dim(${literal(builder, row.payload)})"
				DimensionAddTypeNode:
					"(${children_text(builder, row, 0, " + ")})"
				DimensionSubtractTypeNode:
					"(${children_text(builder, row, 0, " - ")})"
				DimensionMultiplyTypeNode:
					"(${children_text(builder, row, 0, " * ")})"
				DimensionDivideTypeNode:
					"(${children_text(builder, row, 0, " / ")})"
				RangeTypeNode:
					"Range(${children_text(builder, row, 0, ", ")})"
				TupleTypeNode:
					"Tuple(${children_text(builder, row, 0, ", ")})"
				FunctionTypeNode:
					"Func(${children_text(builder, row, 0, ", ")})"
				PureFunctionTypeNode:
					"PureFunc(${children_text(builder, row, 0, ", ")})"
				ArrayTypeNode:
					first: String = match builder.node_children.get(row.children.first):
						Some(element):
							type_text(builder, element)
						None:
							"?"

					"Array(${first}; ${children_text(builder, row, 1, ", ")})"
				MissingTypeNode:
					"Missing"
				_:
					"Expression"
		None:
			"?"


pure func definition_type_text(builder: DiscoveryBuilder, definition: Int) -> String:
	var text: String = ""

	for row in builder.definition_types:
		if definition_id_index(row.definition) == definition:
			text = " : " + type_text(builder, row.type_root)

	text


pure func parameter_text(builder: DiscoveryBuilder, parameter: ParameterRow, index: Int) -> String:
	var names: List[String] = []

	for binder_index in parameter.binder_names.first..parameter.binder_names.first + parameter.binder_names.count:
		match builder.binder_names.get(binder_index):
			Some(binder):
				names = names.append(spelling(builder, name_id_index(binder.name)))
			None:
				void

	binder_text: String = match parameter.binder:
		NamedParameterBinder:
			names.join("")
		WildcardParameterBinder:
			"_"
		TupleParameterBinder:
			"(${names.join(", ")})"

	var type_part: String = ""

	for row in builder.parameter_types:
		if parameter_id_index(row.parameter) == index:
			type_part = ": " + type_text(builder, row.type_root)

	binder_text + type_part


pure func signature_text(builder: DiscoveryBuilder, definition: Int) -> String:
	var text: String = ""

	for signature in builder.signatures:
		if definition_id_index(signature.definition) == definition:
			var parameters: List[String] = []

			for index in signature.parameters.first..signature.parameters.first + signature.parameters.count:
				match builder.parameters.get(index):
					Some(parameter):
						parameters = parameters.append(parameter_text(builder, parameter, index))
					None:
						void

			purity: String = match signature.purity:
				PureFunction:
					"pure "
				ImpureFunction:
					""

			text = " ${purity}(${parameters.join(", ")})"

	text


pure func type_parameters_text(builder: DiscoveryBuilder, definition: Int) -> String:
	var parameters: List[String] = []

	for parameter in builder.type_parameters:
		if definition_id_index(parameter.owner) == definition:
			var bounds: List[String] = []

			for bound in builder.bounds:
				if (
					definition_id_index(bound.owner) == definition
					and bound.parameter_ordinal == parameter.ordinal
				):
					bounds = bounds.append(spelling(builder, name_id_index(bound.trait_name)))

			prefix: String = match parameter.kind:
				TypeParameter:
					""
				DimensionParameter:
					"#"
				WildcardDimensionParameter:
					"#"

			bound_text: String = if bounds.is_empty():
				""
			else:
				": " + bounds.join(" + ")

			parameters = parameters.append(
				prefix + spelling(builder, name_id_index(parameter.name)) + bound_text,
			)

	if parameters.is_empty():
		""
	else:
		"[${parameters.join(", ")}]"


pure func extras_text(builder: DiscoveryBuilder, definition: Int) -> String:
	var parts: List[String] = []

	for row in builder.annotations:
		if definition_id_index(row.definition) == definition:
			parts = parts.append(annotation_text(row.annotation))

	for row in builder.documentation:
		if definition_id_index(row.definition) == definition:
			parts = parts.append("doc=" + quoted(literal(builder, literal_id_index(row.text))))

	for row in builder.supertraits:
		if definition_id_index(row.trait_definition) == definition:
			parts = parts.append("super=${spelling(builder, name_id_index(row.name))}")

	for row in builder.variant_payloads:
		if definition_id_index(row.variant) == definition:
			parts = parts.append("payload=${type_text(builder, row.type_root)}")

	for row in builder.dimension_constraints:
		if definition_id_index(row.owner) == definition:
			parts = parts.append(
				"where ${type_text(builder, row.left)} == ${type_text(builder, row.right)}",
			)

	for row in builder.foreign_bindings:
		if definition_id_index(row.definition) == definition:
			parts = parts.append("block=${foreign_block_id_index(row.block)}")

	for row in builder.foreign_c_names:
		if definition_id_index(row.definition) == definition:
			parts = parts.append("c_name=" + quoted(literal(builder, literal_id_index(row.c_name))))

	for row in builder.resource_cleanups:
		if definition_id_index(row.definition) == definition:
			parts = parts.append(
				"cleanup=" + quoted(literal(builder, literal_id_index(row.builtin_name))),
			)

	if parts.is_empty():
		""
	else:
		" {" + parts.join(" ") + "}"


pure func owner_of(builder: DiscoveryBuilder, definition: Int) -> Option[Int]:
	var found: Option[Int] = None

	for member in builder.members:
		if definition_id_index(member.definition) == definition:
			found = Some(definition_id_index(member.owner))

	found


---
One line per definition: members indented under their owner, in row
order. Then foreign blocks and diagnostics.
---
pure func declarations_dump(builder: DiscoveryBuilder) -> String:
	var lines: List[String] = []
	var index: Int = 0

	for row in builder.definitions:
		indent: String = if owner_of(builder, index).is_some():
			"  "
		else:
			""

		visibility: String = match row.visibility:
			PrivateVisibility:
				"private "
			PublicVisibility:
				""

		lines = lines.append(
			"${indent}${visibility}${kind_text(row.kind)} ${spelling(builder, name_id_index(row.name))}${type_parameters_text(builder, index)}${signature_text(builder, index)}${definition_type_text(builder, index)}${extras_text(builder, index)} ${span_text(row.span)}",
		)
		index += 1

	var block_index: Int = 0

	for block in builder.foreign_blocks:
		var arguments: List[String] = []

		for argument_index in block.arguments.first..block.arguments.first + block.arguments.count:
			match builder.foreign_arguments.get(argument_index):
				Some(argument):
					arguments = arguments.append(
						spelling(
							builder,
							name_id_index(
								argument.name,
							),
						) + "=" + quoted(literal(builder, literal_id_index(argument.value))),
					)
				None:
					void

		lines = lines.append(
			"foreign-block ${block_index} (${arguments.join(", ")}) ${span_text(block.span)}",
		)
		block_index += 1

	lines.join("\n")
