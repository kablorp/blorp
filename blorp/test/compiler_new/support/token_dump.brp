-- Renders the discovery token table as text: one line per token, giving its
-- byte range, kind and (for identifiers and literals) its text. Tests compare
-- these dumps with pinned fixtures, and the corpus parity check compares them
-- with the same rendering of the existing lexer's tokens.
import:
	../../../src/compiler_new/stage_01_discovery/tables/builder:
		BridgedInterpolation,
		BridgedPiece(BridgedHole, BridgedText),
		DiscoveryBuilder,
		bridged_interpolation_at,
	../../../src/compiler_new/stage_01_discovery/tables/diagnostic_code: syntax_diagnostic_name
	../../../src/compiler_new/stage_01_discovery/tables/ids: literal_id_index, source_id_index
	../../../src/compiler_new/stage_01_discovery/tables/span: span_end, span_source, span_start
	../../../src/compiler_new/stage_01_discovery/tables/token:
		Token,
		TokenKind(
			CharLiteralToken, DimensionNameToken, DocStringToken, FloatLiteralToken,
			IdentifierToken, IntLiteralToken, InterpolatedPipeStringToken, InterpolatedStringToken,
			NormalStringToken, PipeStringToken, RawPipeStringToken, RawStringToken,
		),
		token_kind_name,


---
`text` on one line: backslash, newline, tab and carriage return escaped.
---
pure func escaped_dump_text(text: String) -> String:
	text
		.replace("\\", "\\\\")
		.replace("\n", "\\n")
		.replace("\t", "\\t")
		.replace("\r", "\\r")


---
The text a token's payload names, or its codepoint, for the dump.
---
pure func token_payload_text(builder: DiscoveryBuilder, token: Token) -> String:
	match token.kind:
		IdentifierToken | DimensionNameToken:
			" " + escaped_dump_text(
				builder.name_spellings
					.get(token.payload)
					.get_or("?"),
			)
		InterpolatedStringToken | InterpolatedPipeStringToken:
			builder.interpolation_parts_text(token)
		IntLiteralToken | FloatLiteralToken | NormalStringToken | RawStringToken | PipeStringToken | RawPipeStringToken | DocStringToken:
			" " + escaped_dump_text(
				builder.literals
					.get(token.payload)
					.get_or("?"),
			)
		CharLiteralToken:
			" " + token.payload.to_string()
		_:
			""


---
An interpolated string's parts: ` text[...]` for each decoded text piece and
` hole[...]` for each hole's source text.
---
pure func interpolation_parts_text(builder: DiscoveryBuilder, token: Token) -> String:
	interpolation: BridgedInterpolation = builder.bridged_interpolation_at(token.payload)
	source: String = builder.source_texts
		.get(
			token.span
				.span_source()
				.source_id_index(),
		)
		.get_or("")
	var text: String = ""

	for piece in interpolation.pieces:
		match piece:
			BridgedText(scanned):
				decoded: String = builder.literals
					.get(literal_id_index(scanned.text))
					.get_or("?")
				text += " text[" + escaped_dump_text(decoded) + "]"
			BridgedHole(hole):
				text += " hole[" + escaped_dump_text(
					source.substring(
						hole.expression_start,
						hole.expression_end - hole.expression_start,
					),
				) + "]"

	text


pure func token_dump_line(builder: DiscoveryBuilder, token: Token) -> String:
	"${token.span.span_start()} ${token.span.span_end()} ${token.kind.token_kind_name()}${builder.token_payload_text(token)}"


---
Every token of the builder's token table, one per line.
---
pure func token_dump(builder: DiscoveryBuilder) -> String:
	var lines: List[String] = []

	for token in builder.tokens:
		lines = lines.append(builder.token_dump_line(token))

	lines.join("\n")


---
The diagnostics appended since row `first`, one `start end code` per line.
---
pure func diagnostic_dump(builder: DiscoveryBuilder, first: Int) -> String:
	var lines: List[String] = []
	var row: Int = 0

	for diagnostic in builder.diagnostics:
		if row >= first:
			lines = lines.append(
				"${diagnostic.span.span_start()} ${diagnostic.span.span_end()} ${diagnostic.diagnostic.syntax_diagnostic_name()}",
			)

		row += 1

	lines.join("\n")
