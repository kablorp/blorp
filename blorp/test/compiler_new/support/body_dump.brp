-- Renders parsed bodies as trees, one body per line, for body parser tests:
-- `name = (Kind payload child ...)`. A name payload renders as the name, a
-- literal payload as the quoted text, a codepoint as `'<n>'`, and a local
-- function as `def<n>`, as `node_payload_reference` classifies each kind.
import:
	../../../src/compiler_new/stage_01_discovery/discovery_builder:
		DiscoveryBuilder,
		NodeId,
		NodeRow,
		definition_id_index,
		name_id_index,
		node_id_index,
	../../../src/compiler_new/stage_01_discovery/row_kinds:
		NodePayloadReference(
			CodepointPayload,
			DefinitionPayload,
			LiteralPayload,
			NamePayload,
			NoPayload,
		),
		node_kind_name,
		node_payload_reference,
	declarations_dump: literal, quoted, spelling


pure func payload_text(builder: DiscoveryBuilder, row: NodeRow) -> String:
	match node_payload_reference(row.kind):
		NamePayload:
			" " + spelling(builder, row.payload)
		LiteralPayload:
			" " + quoted(literal(builder, row.payload))
		CodepointPayload:
			" '${row.payload}'"
		DefinitionPayload:
			" def${row.payload}"
		NoPayload:
			""


---
The tree rooted at `node`.
---
pure func node_tree(builder: DiscoveryBuilder, node: NodeId) -> String:
	match builder.nodes.get(node_id_index(node)):
		Some(row):
			var text: String = "(" + node_kind_name(row.kind) + payload_text(builder, row)
			var position: Int = 0

			while position < row.children.count:
				match builder.node_children.get(row.children.first + position):
					Some(child):
						text += " " + node_tree(builder, child)
					None:
						text += " ?"

				position += 1

			text + ")"
		None:
			"?"


---
Every body row as `definition-name = tree`, in row order.
---
pure func bodies_dump(builder: DiscoveryBuilder) -> List[String]:
	var lines: List[String] = []

	for body in builder.bodies:
		name: String = match builder.definitions.get(definition_id_index(body.definition)):
			Some(definition):
				spelling(builder, name_id_index(definition.name))
			None:
				"?"

		lines = lines.append(name + " = " + node_tree(builder, body.root))

	lines
