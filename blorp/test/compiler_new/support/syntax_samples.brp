---
The module every sample is built for.
---
SAMPLE_MODULE_INDEX: Int = 2


pure func sample_module() -> ModuleId:
	module_id_at_row(SAMPLE_MODULE_INDEX)


---
A parse in miniature: the mint, the spellings, and the offset the next span
starts at. Every node and name gets the next span, two bytes on from the
last, so spans are distinct and predictable.
---
record SampleBuild {
	mint: IdMint,
	spellings: Spellings,
	offset: Int
}


pure func sample_build() -> SampleBuild:
	{
		mint = new_id_mint(sample_module()),
		spellings = new_spellings(sample_module()),
		offset = 0
	}


pure func sample_span(start: Int, end: Int) -> Span:
	pack_span(source_id_at_row(SAMPLE_MODULE_INDEX), start, end)


---
The build with the next one-byte span taken.
---
pure func next_span(build: SampleBuild) -> (SampleBuild, Span):
	({ build | offset = build.offset + 2 }, sample_span(build.offset, build.offset + 1))


pure func written(build: SampleBuild, text: String) -> (SampleBuild, WrittenName):
	(spellings, spelling) = build.spellings.interned_spelling(text, 0, text.length())
	span: Span = sample_span(build.offset, build.offset + text.length())
	({ build |
			spellings = spellings,
			offset = build.offset + text.length() + 1
		}, {
			spelling = spelling,
			span = span
		})


pure func use(build: SampleBuild, text: String) -> (SampleBuild, NameUse):
	(named, name) = build.written(text)
	(mint, minted) = named.mint.minted_name_use(name)
	({ named | mint = mint }, minted)


pure func binder(build: SampleBuild, text: String) -> (SampleBuild, Binder):
	(named, name) = build.written(text)
	(mint, minted) = named.mint.minted_binder(name)
	({ named | mint = mint }, minted)


pure func type_binder(build: SampleBuild, text: String) -> (SampleBuild, TypeBinder):
	(named, name) = build.written(text)
	(mint, minted) = named.mint.minted_type_binder(name)
	({ named | mint = mint }, minted)


pure func expression(build: SampleBuild, kind: ExpressionKind) -> (SampleBuild, Expression):
	(spanned, span) = build.next_span()
	(mint, minted) = spanned.mint.minted_expression(span, kind)
	({ spanned | mint = mint }, minted)


pure func statement(build: SampleBuild, kind: StatementKind) -> (SampleBuild, Statement):
	(spanned, span) = build.next_span()
	(mint, minted) = spanned.mint.minted_statement(span, kind)
	({ spanned | mint = mint }, minted)


pure func block(
	build: SampleBuild,
	leading: List[Statement],
	last: Statement,
) -> (SampleBuild, Block):
	(spanned, span) = build.next_span()
	(mint, minted) = spanned.mint.minted_block(leading, last, span)
	({ spanned | mint = mint }, minted)


pure func pattern(build: SampleBuild, kind: PatternKind) -> (SampleBuild, Pattern):
	(spanned, span) = build.next_span()
	(mint, minted) = spanned.mint.minted_pattern(span, kind)
	({ spanned | mint = mint }, minted)


pure func written_type(build: SampleBuild, kind: WrittenTypeKind) -> (SampleBuild, WrittenType):
	(spanned, span) = build.next_span()
	(mint, minted) = spanned.mint.minted_written_type(span, kind)
	({ spanned | mint = mint }, minted)


pure func dimension(build: SampleBuild, kind: DimensionKind) -> (SampleBuild, Dimension):
	(spanned, span) = build.next_span()
	(mint, minted) = spanned.mint.minted_dimension(span, kind)
	({ spanned | mint = mint }, minted)


---
The name `text` as an expression.
---
pure func name_expression(build: SampleBuild, text: String) -> (SampleBuild, Expression):
	(named, name) = build.use(text)
	named.expression(NameReference(name))


---
A block whose only statement is the expression `value`.
---
pure func block_of(build: SampleBuild, value: Expression) -> (SampleBuild, Block):
	(stated, only) = build.statement(ExpressionStatement(value))
	stated.block([], only)


---
The type named `text`, without arguments.
---
pure func named_type(build: SampleBuild, text: String) -> (SampleBuild, WrittenType):
	(named, name) = build.use(text)
	named.written_type(NamedType(name, []))


-- Standalone receiver-bound representation: unlike BoundedArgument below,
-- this is itself a WrittenType and can also be a FunctionType's result.
-- This sample exercises the syntax model, never receiver/owner grammar.
pure func sample_bounded_type(build: SampleBuild) -> (SampleBuild, WrittenType):
	(b1, parameter) = build.use("T")
	(b2, qualifier) = b1.use("m")
	(b3, qualified_name) = b2.use("Eq")
	(b4, bare_name) = b3.use("Hash")
	b4.written_type(BoundedType({
		parameter = parameter,
		bounds = {
			first = { qualifier = Some(qualifier), trait_name = qualified_name, span = qualifier.name.span.span_covering(qualified_name.name.span) },
			rest = [{ qualifier = None, trait_name = bare_name, span = bare_name.name.span }]
		},
		span = parameter.name.span.span_covering(bare_name.name.span)
	}))


-- An alias is only a convenient syntax owner for dump/census tests. The
-- parser does not accept these receiver-only bounds as authored aliases.
pure func sample_type_module(build: SampleBuild, target: WrittenType) -> ModuleSyntax:
	(named, name) = build.written("Receiver")
	(spanned, span) = named.next_span()
	(mint, declaration) = spanned.mint.minted_alias(PublicVisibility, None, TransparentAlias, name, [], target, span)
	{ spanned | mint = mint }.module_syntax([AliasItem(declaration)], None)


pure func module_syntax(
	build: SampleBuild,
	items: List[ModuleItem],
	documentation: Option[Documentation],
) -> ModuleSyntax:
	ids = build.mint.issued()
	{
		documentation = documentation,
		items = items,
		definitions = ids.definitions,
		imports = ids.imports,
		counts = ids.counts
	}


---
A module holding every form of the syntax types at least once, and the
spellings its names are in.
---
pure func every_form_module() -> (ModuleSyntax, Spellings):
	(b1, imports) = sample_build().sample_imports()
	(b2, foreign_item) = b1.sample_foreign_block()
	(b3, types) = b2.sample_type_declarations()
	(b4, traits) = b3.sample_traits()
	(b5, function) = b4.sample_function()
	(b6, globals) = b5.sample_globals()
	(with_annotations, annotated_function) = b6.sample_annotation_function()
	(b7, documentation_span) = with_annotations.next_span()
	documentation: Documentation = {
		text = "Every form.",
		span = documentation_span
	}
	items: List[ModuleItem] = [imports, foreign_item]
		.concat(types)
		.concat(traits)
		.concat([function, annotated_function])
		.concat(globals)
	(b7.module_syntax(items, Some(documentation)), b7.spellings)


pure func sample_imports(build: SampleBuild) -> (SampleBuild, ModuleItem):
	(b1, heap) = build.written("heap")
	(b2, list_item) = b1.use("List")
	(b3, option_item) = b2.use("Option")
	(b4, some_constructor) = b3.use("Some")
	(b5, item_alias) = b4.written("Maybe")
	(b6, items_span) = b5.next_span()
	items: List[ImportItem] = [
		{
			name = list_item,
			alias_name = None,
			constructors = [],
			span = items_span
		},
		{
			name = option_item,
			alias_name = Some(item_alias),
			constructors = [some_constructor],
			span = items_span
		},
	]
	bare: ModulePath = {
		anchor = BareAnchor,
		parts = {
			first = heap,
			rest = []
		}
	}
	(b7, first_span) = b6.next_span()
	(m1, first) = b7.mint.minted_import(bare, None, items, first_span, first_span)
	(b8, up) = { b7 | mint = m1 }.written("shared")
	(b9, util) = b8.written("util")
	(b10, alias_name) = b9.written("U")

	steps = match parent_steps(2):
		Some(two):
			ParentDirectoryAnchor(two)
		None:
			BareAnchor

	climbing: ModulePath = {
		anchor = steps,
		parts = {
			first = up,
			rest = [util]
		}
	}
	(m2, second) = b10.mint.minted_import(climbing, Some(alias_name), [], first_span, first_span)
	(b11, sibling) = { b10 | mint = m2 }.written("sibling")
	(m3, third) = b11.mint.minted_import(
		{
			anchor = SameDirectoryAnchor,
			parts = {
				first = sibling,
				rest = []
			}
		},
		None,
		[],
		first_span,
		first_span,
	)
	(b12, native) = { b11 | mint = m3 }.written("sqlite")
	(m4, fourth) = b12.mint.minted_import(
		{
			anchor = NativePackageAnchor,
			parts = {
				first = native,
				rest = []
			}
		},
		None,
		[],
		first_span,
		first_span,
	)
	(b13, block_span) = { b12 | mint = m4 }.next_span()
	(b13, ImportBlockItem({
		imports = [first, second, third, fourth],
		span = block_span,
	}))


pure func sample_foreign_block(build: SampleBuild) -> (SampleBuild, ModuleItem):
	(b1, include) = build.written("include")
	(b2, name) = b1.written("c_sqrt")
	(b3, value) = b2.binder("value")
	(b4, float_type) = b3.named_type("Float")
	(b5, parameter_span) = b4.next_span()
	parameter: Parameter = {
		binding = NamedParameter(value),
		declared_type = Some(float_type),
		span = parameter_span
	}
	(b6, result) = b5.named_type("Float")
	annotation: Annotation = {
		annotation = NoCopyAnnotation,
		span = parameter_span
	}
	(m1, function) = b6.mint.minted_foreign_function(
		PrivateVisibility,
		[annotation],
		PureFunction,
		parameter_span,
		name,
		[parameter],
		result,
		Some({
			name = "sqrt",
			span = parameter_span,
		}),
		parameter_span,
	)
	block: ForeignBlock = {
		arguments = [
			{
				name = include,
				value = "math.h",
				span = parameter_span
			},
		],
		functions = [function],
		span = parameter_span
	}
	({ b6 | mint = m1 }, ForeignBlockItem(block))


pure func sample_type_declarations(build: SampleBuild) -> (SampleBuild, List[ModuleItem]):
	(b1, element) = build.type_binder("T")
	(b2, element_span) = b1.next_span()
	element_parameter: TypeParameter = TypeVariable({
		binder = element,
		bounds = [],
		span = element_span,
	})
	(b3, field_type) = b2.named_type("Int")
	(b4, field_name) = b3.written("count")
	(m1, field) = b4.mint.minted_field(field_name, field_type, element_span)
	(b5, record_name) = { b4 | mint = m1 }.written("Counter")
	(m2, record_declaration) = b5.mint.minted_record(
		PublicVisibility,
		None,
		OrdinaryRecord,
		record_name,
		[element_parameter],
		[field],
		element_span,
	)
	(b6, point_field_type) = { b5 | mint = m2 }.named_type("Float")
	(b7, point_field_name) = b6.written("x")
	(m3, point_field) = b7.mint.minted_field(point_field_name, point_field_type, element_span)
	(b8, point_name) = { b7 | mint = m3 }.written("Point")
	(m4, point_declaration) = b8.mint.minted_record(
		PublicVisibility,
		None,
		OrdinaryRecord,
		point_name,
		[],
		[point_field],
		element_span,
	)
	(b9, payload) = { b8 | mint = m4 }.named_type("String")
	(b10, variant_name) = b9.written("Named")
	(m5, variant) = b10.mint.minted_variant(variant_name, [payload], element_span)
	(b11, empty_name) = { b10 | mint = m5 }.written("Empty")
	(m6, empty) = b11.mint.minted_variant(empty_name, [], element_span)
	(b12, union_name) = { b11 | mint = m6 }.written("Shape")
	(m7, union_declaration) = b12.mint.minted_union(
		PublicVisibility,
		None,
		union_name,
		[],
		[variant, empty],
		element_span,
	)
	(b13, case_name) = { b12 | mint = m7 }.written("Red")
	(m8, red) = b13.mint.minted_enum_case(case_name, element_span)
	(b14, enum_name) = { b13 | mint = m8 }.written("Color")
	(m9, enum_declaration) = b14.mint.minted_enum(
		PrivateVisibility,
		None,
		enum_name,
		[red],
		element_span,
	)
	(b15, alias_target) = { b14 | mint = m9 }.named_type("Int")
	(b16, alias_name) = b15.written("Count")
	(m10, alias_declaration) = b16.mint.minted_alias(
		PublicVisibility,
		None,
		TransparentAlias,
		alias_name,
		[],
		alias_target,
		element_span,
	)
	(b17, opaque_target) = { b16 | mint = m10 }.named_type("Int")
	(b18, opaque_name) = b17.written("Token")
	(m11, opaque_declaration) = b18.mint.minted_alias(
		PublicVisibility,
		None,
		OpaqueAlias,
		opaque_name,
		[],
		opaque_target,
		element_span,
	)
	(b19, builtin_name) = { b18 | mint = m11 }.written("Handle")
	(m12, builtin_declaration) = b19.mint.minted_builtin_type(
		PublicVisibility,
		None,
		builtin_name,
		[],
		element_span,
	)
	(b20, resource_name) = { b19 | mint = m12 }.written("File")
	(m13, resource_declaration) = b20.mint.minted_resource_type(
		PublicVisibility,
		None,
		resource_name,
		[],
		Some({
			name = "close_file",
			span = element_span,
		}),
		element_span,
	)
	(b21, fixed_name) = { b20 | mint = m13 }.written("EmptyFixed")
	(m14, fixed_declaration) = b21.mint.minted_record(
		PublicVisibility,
		None,
		FixedRecord,
		fixed_name,
		[],
		[],
		element_span,
	)
	(
		{ b21 | mint = m14 },
		[
			RecordItem(record_declaration),
			RecordItem(point_declaration),
			RecordItem(fixed_declaration),
			UnionItem(union_declaration),
			EnumItem(enum_declaration),
			AliasItem(alias_declaration),
			AliasItem(opaque_declaration),
			BuiltinTypeItem(builtin_declaration),
			ResourceTypeItem(resource_declaration),
		],
	)


pure func sample_traits(build: SampleBuild) -> (SampleBuild, List[ModuleItem]):
	(b1, module_alias) = build.use("m")
	(b2, super_trait) = b1.use("Equatable")
	(b3, reference_span) = b2.next_span()
	supertrait: TraitReference = {
		qualifier = Some(module_alias),
		trait_name = super_trait,
		span = reference_span
	}
	(b4, self_binder) = b3.binder("self")
	(b5, self_type) = b4.named_type("Self")
	(b6, method_name) = b5.written("describe")
	(b7, string_type) = b6.named_type("String")
	signature: Signature = {
		purity = PureFunction,
		keyword = reference_span,
		name = method_name,
		parameters = [
			{
				binding = NamedParameter(self_binder),
				declared_type = Some(self_type),
				span = reference_span
			},
		],
		return_type = Some(string_type)
	}
	(b8, default_value) = b7.expression(StringLiteral(QuotedString, "thing"))
	(m1, method) = b8.mint.minted_trait_method(
		signature,
		Some(ExpressionBody(default_value)),
		reference_span,
	)
	(b9, other_name) = { b8 | mint = m1 }.written("size")
	(m2, abstract_method) = b9.mint.minted_trait_method(
		{
			purity = ImpureFunction,
			keyword = reference_span,
			name = other_name,
			parameters = [],
			return_type = None
		},
		None,
		reference_span,
	)
	(b10, trait_name) = { b9 | mint = m2 }.written("Describe")
	(m3, trait_declaration) = b10.mint.minted_trait(
		PublicVisibility,
		None,
		trait_name,
		[],
		[supertrait],
		[method, abstract_method],
		reference_span,
	)
	(b11, receiver_binder) = { b10 | mint = m3 }.binder("self")
	(b12, receiver_type) = b11.named_type("Point")
	(b13, implemented_name) = b12.written("describe")
	(b14, body_value) = b13.expression(StringLiteral(RawString, "point"))
	implementation_function: Function = {
		signature = {
			purity = PureFunction,
			keyword = reference_span,
			name = implemented_name,
			parameters = [
				{
					binding = NamedParameter(receiver_binder),
					declared_type = Some(receiver_type),
					span = reference_span
				},
			],
			return_type = None
		},
		type_parameters = [],
		constraints = [],
		body = Some(ExpressionBody(body_value))
	}
	(m4, implementation_method) = b14.mint.minted_implementation_method(
		[],
		implementation_function,
		reference_span,
	)
	(b15, implemented_trait) = { b14 | mint = m4 }.use("Describe")
	-- `Point[V: Eq]`: a bound inside a type is accepted only in a receiver.
	(b15_parameter, value_parameter) = b15.use("V")
	(b15_bound, eq) = b15_parameter.use("Eq")
	(b15_span, bound_span) = b15_bound.next_span()
	(b15_point, point) = b15_span.use("Point")
	(b16, receiver) = b15_point.written_type(NamedType(
		point,
		[
			BoundedArgument({
				parameter = value_parameter,
				bounds = {
					first = {
						qualifier = None,
						trait_name = eq,
						span = bound_span
					},
					rest = []
				},
				span = bound_span,
			}),
		],
	))
	(m5, implementation) = b16.mint.minted_implementation(
		PublicVisibility,
		None,
		reference_span,
		implemented_trait,
		receiver,
		[implementation_method],
		reference_span,
	)
	({ b16 | mint = m5 }, [TraitItem(trait_declaration), ImplementationItem(implementation)])


pure func sample_globals(build: SampleBuild) -> (SampleBuild, List[ModuleItem]):
	(b1, value) = build.expression(IntegerLiteral(to_int128(42)))
	(b2, name) = b1.written("ANSWER")
	(b3, declared) = b2.named_type("Int")
	(b4, span) = b3.next_span()
	(m1, constant) = b4.mint.minted_global(
		PublicVisibility,
		None,
		ConstantGlobal,
		name,
		Some(declared),
		value,
		span,
	)
	(b5, mutable_value) = { b4 | mint = m1 }.expression(VoidValue)
	(b6, mutable_name) = b5.written("state")
	(m2, mutable) = b6.mint.minted_global(
		PrivateVisibility,
		None,
		MutableGlobal,
		mutable_name,
		None,
		mutable_value,
		span,
	)
	({ b6 | mint = m2 }, [GlobalItem(constant), GlobalItem(mutable)])


---
`func sample[T: m.Equatable, #N, #_](x: T, _, (a, b)) -> T where N == 3:` and
a body holding every statement, expression, pattern and type form.
---
pure func sample_function(build: SampleBuild) -> (SampleBuild, ModuleItem):
	(b1, element) = build.type_binder("T")
	(b2, bound_qualifier) = b1.use("m")
	(b3, bound_name) = b2.use("Equatable")
	(b4, span) = b3.next_span()
	(b5, dimension_binder) = b4.type_binder("N")
	type_parameters: List[TypeParameter] = [
		TypeVariable({
			binder = element,
			bounds = [
				{
					qualifier = Some(bound_qualifier),
					trait_name = bound_name,
					span = span
				},
			],
			span = span,
		}),
		DimensionVariable(dimension_binder),
		WildcardDimensionParameter(span),
	]
	(b6, x) = b5.binder("x")
	(b7, x_type) = b6.named_type("T")
	(b8, a) = b7.binder("a")
	(b9, b) = b8.binder("b")
	parameters: List[Parameter] = [
		{
			binding = NamedParameter(x),
			declared_type = Some(x_type),
			span = span
		},
		{
			binding = WildcardParameter(span),
			declared_type = None,
			span = span
		},
		{
			binding = TupleParameter({
				names = Pair(a, b),
				span = span,
			}),
			declared_type = None,
			span = span
		},
	]
	(b10, return_type) = b9.named_type("T")
	(b11, constraint_name) = b10.use("N")
	(b12, constraint_left) = b11.dimension(NamedDimension(constraint_name))
	(b13, constraint_right) = b12.dimension(LiteralDimension(to_int128(3)))
	(b14, function_name) = b13.written("sample")
	(b15, types_statement) = b14.sample_type_statement()
	(b16, pattern_statement) = b15.sample_match_statement()
	(b17, expression_statements) = b16.sample_expression_statements()
	(with_alternatives, alternative_statements) = b17.sample_alternative_statements()
	(b18, binding_statements) = with_alternatives.sample_binding_statements()
	(b19, loop_statements) = b18.sample_loop_statements()
	(b20, local_function) = b19.sample_local_function()
	(b21, last) = b20.name_expression("x")
	(b22, last_statement) = b21.statement(ExpressionStatement(last))
	leading: List[Statement] = [types_statement, pattern_statement]
		.concat(expression_statements)
		.concat(alternative_statements)
		.concat(binding_statements)
		.concat(loop_statements)
		.concat([local_function])
	(b23, body) = b22.block(leading, last_statement)
	function: Function = {
		signature = {
			purity = PureFunction,
			keyword = span,
			name = function_name,
			parameters = parameters,
			return_type = Some(return_type)
		},
		type_parameters = type_parameters,
		constraints = [
			{
				left = constraint_left,
				right = constraint_right,
				span = span
			},
		],
		body = Some(BlockBody(body))
	}
	(b24, documentation_span) = b23.next_span()
	annotation: Annotation = {
		annotation = TailRecursiveAnnotation,
		span = documentation_span
	}
	(m1, declaration) = b24.mint.minted_function(PublicVisibility, Some({
			text = "A sample.",
			span = documentation_span,
		}), [annotation], function, documentation_span)
	({ b24 | mint = m1 }, FunctionItem(declaration))


---
`t: All[(Int, m.Map[K, #N]), (Int) -> Int, Float[#N * 2, #_], ..#N, #R, (), Ts[#Ds..., #_...]] = void`:
a typed binding whose type holds every written type and dimension form.
---
pure func sample_type_statement(build: SampleBuild) -> (SampleBuild, Statement):
	(b1, int_type) = build.named_type("Int")
	(b2, qualifier) = b1.use("m")
	(b3, map_name) = b2.use("Map")
	(b4, key_type) = b3.named_type("K")
	(b5, n_use) = b4.use("N")
	(b6, n_dimension) = b5.dimension(NamedDimension(n_use))
	(b7, map_type) = b6.written_type(
		QualifiedType(
			qualifier,
			map_name,
			[TypeArgumentType(key_type), DimensionArgument(n_dimension)],
		),
	)
	(b8, parameter_type) = b7.named_type("Int")
	(b9, result_type) = b8.named_type("Int")
	(b10, function_type) = b9.written_type(
		FunctionType(
			ImpureFunction,
			[TypeArgumentType(parameter_type)],
			result_type,
		),
	)
	(b11, float_type) = b10.named_type("Float")
	(b12, m_use) = b11.use("N")
	(b13, m_dimension) = b12.dimension(NamedDimension(m_use))
	(b14, two) = b13.dimension(LiteralDimension(to_int128(2)))
	(b15, product) = b14.dimension(DimensionArithmetic(MultiplyDimensions, m_dimension, two))
	(b16, wildcard) = b15.dimension(WildcardDimension)
	(b17, array_type) = b16.written_type(
		ArrayType(
			float_type,
			{
				first = product,
				rest = [wildcard]
			},
		),
	)
	(b18, bound_use) = b17.use("N")
	(b19, bound) = b18.dimension(NamedDimension(bound_use))
	(b20, range_type) = b19.written_type(RangeType(bound))
	(b21, rows_use) = b20.use("R")
	(b22, rows) = b21.dimension(NamedDimension(rows_use))
	(b25, rows_type) = b22.written_type(DimensionType(rows))
	(b26, void_type) = b25.written_type(VoidType)
	(b27, variadic_use) = b26.use("Ds")
	(b28, variadic) = b27.dimension(VariadicNamedDimension(variadic_use))
	(b29, variadic_wildcard) = b28.dimension(VariadicWildcardDimension)
	(b30, shape_name) = b29.use("Ts")
	(b31, shape_type) = b30.written_type(
		NamedType(
			shape_name,
			[DimensionArgument(variadic), DimensionArgument(variadic_wildcard)],
		),
	)
	(b32, tuple_type) = b31.written_type(
		TupleType(Pair(TypeArgumentType(int_type), TypeArgumentType(map_type))),
	)
	(b32_named, all_name) = b32.use("All")
	(b33, all_types) = b32_named.written_type(
		NamedType(
			all_name,
			[
				TypeArgumentType(tuple_type),
				TypeArgumentType(function_type),
				TypeArgumentType(array_type),
				TypeArgumentType(range_type),
				TypeArgumentType(rows_type),
				TypeArgumentType(void_type),
				TypeArgumentType(shape_type),
			],
		),
	)
	(b34, target) = b33.binder("t")
	(b35, value) = b34.expression(VoidValue)
	b35.statement(TypedBinding({
		target = BindsName(target),
		declared_type = all_types,
		value = value,
	}))


---
A `match` on `x` whose cases hold every pattern form, one with a block
body and the rest with a statement on the pattern's line.
---
pure func sample_match_statement(build: SampleBuild) -> (SampleBuild, Statement):
	(b1, subject) = build.name_expression("x")
	(b2, wildcard) = b1.pattern(WildcardPattern)
	(b3, name_use) = b2.use("y")
	(b4, named) = b3.pattern(NamePattern(name_use))
	(b5, integer) = b4.pattern(IntegerPattern(Negative, to_int128(7)))

	digits = match decimal_float("2.5"):
		Some(parsed):
			FloatPattern(NonNegative, parsed)
		None:
			WildcardPattern

	(b6, float_pattern) = b5.pattern(digits)
	(b7, string_pattern) = b6.pattern(StringPattern(QuotedString, "a\"b"))
	(b8, character) = b7.pattern(CharacterPattern('q'))
	(b9, boolean) = b8.pattern(BooleanPattern(True))
	(b10, some_name) = b9.use("Some")
	(b11, constructor) = b10.pattern(ConstructorPattern(some_name, [wildcard]))
	(b12, qualifier) = b11.use("shapes")
	(b13, circle) = b12.use("Circle")
	(b14, qualified) = b13.pattern(QualifiedConstructorPattern(qualifier, circle, [named]))
	(b15, tuple_pattern) = b14.pattern(TuplePattern(Pair(integer, float_pattern)))
	(b16, rest) = b15.binder("rest")
	(b17, spread_span) = b16.next_span()
	spread: ListSpread = {
		target = BindsName(rest),
		span = spread_span
	}
	(b18, list_pattern) = b17.pattern(ListPattern([string_pattern], Some(spread)))
	(b19, alternatives) = b18.pattern(AlternativePatterns({
		first = character,
		second = boolean,
		rest = [constructor],
	}))
	(b20, first_value) = b19.expression(Break)
	(b21, first_block) = b20.block_of(first_value)
	(b22, second_value) = b21.expression(Continue)
	(b23, second_statement) = b22.statement(ExpressionStatement(second_value))
	(b24, third_value) = b23.expression(VoidValue)
	(b25, third_statement) = b24.statement(ExpressionStatement(third_value))
	(b26, fourth_value) = b25.expression(VoidValue)
	(b27, fourth_statement) = b26.statement(ExpressionStatement(fourth_value))
	(b28, case_span) = b27.next_span()
	cases = [
		{
			pattern = qualified,
			body = CaseBlock(first_block),
			span = case_span
		},
		{
			pattern = tuple_pattern,
			body = CaseStatement(second_statement),
			span = case_span
		},
		{
			pattern = list_pattern,
			body = CaseStatement(third_statement),
			span = case_span
		},
		{
			pattern = alternatives,
			body = CaseStatement(fourth_statement),
			span = case_span
		},
	]
	(b29, matched) = b28.expression(Match(subject, cases))
	b29.statement(ExpressionStatement(matched))


---
Expression statements holding every expression form not used elsewhere.
---
pure func sample_expression_statements(build: SampleBuild) -> (SampleBuild, List[Statement]):
	-- `f(1, -2.5, "s").g[i] < 3 and not_done`
	(b1, f) = build.name_expression("f")
	(b2, one) = b1.expression(IntegerLiteral(to_int128(1)))

	float_kind = match decimal_float("2.5"):
		Some(parsed):
			FloatLiteral(parsed)
		None:
			VoidValue

	(b3, float_value) = b2.expression(float_kind)
	(b4, negated) = b3.expression(Unary(Negate, float_value))
	(b6, text) = b4.expression(StringLiteral(QuotedString, "s"))
	(b7, named_span) = b6.next_span()
	(b8, call) = b7.expression(
		Call(
			f,
			[one, negated, text],
		),
	)
	(b9, member) = b8.use("g")
	(b10, field) = b9.expression(FieldAccess(call, member))
	(b11, index) = b10.name_expression("i")
	(b12, subscript) = b11.expression(
		Subscript(
			field,
			{
				first = index,
				rest = []
			},
		),
	)
	(b13, three) = b12.expression(IntegerLiteral(to_int128(3)))
	(b14, less) = b13.expression(Binary(Less, subscript, three))
	(b15, not_done) = b14.name_expression("not_done")
	(b16, both) = b15.expression(ShortCircuit(LogicalAnd, less, not_done))
	(b17, logic_statement) = b16.statement(ExpressionStatement(both))
	-- Aggregates and literals.
	(b18, start) = b17.expression(IntegerLiteral(to_int128(0)))
	(b19, end) = b18.expression(IntegerLiteral(to_int128(9)))
	(b20, range_value) = b19.expression(RangeExpression(start, end))
	(b21, truth) = b20.expression(BooleanLiteral(False))
	(b22, character) = b21.expression(CharacterLiteral('z'))
	(b23, builtin_value) = b22.expression(CompilerBuiltin(Some("list.append")))
	(b24, list_value) = b23.expression(ListLiteral([range_value, truth]))
	(b25, tuple_value) = b24.expression(TupleLiteral(Triple(list_value, character, builtin_value)))
	(b26, vector_element) = b25.expression(IntegerLiteral(to_int128(4)))
	(b27, vector) = b26.expression(VectorLiteral([vector_element]))
	(b28, field_name) = b27.use("count")
	(b29, field_value) = b28.expression(IntegerLiteral(to_int128(5)))
	field_value_named: NamedValue = {
		name = field_name,
		value = field_value,
		span = named_span
	}
	(b30, record_value) = b29.expression(RecordLiteral([field_value_named]))
	(b31, updated_name) = b30.use("count")
	(b32, updated_value) = b31.expression(IntegerLiteral(to_int128(6)))
	update_named: NamedValue = {
		name = updated_name,
		value = updated_value,
		span = named_span
	}
	(b33, update) = b32.expression(RecordUpdate(record_value, [update_named]))
	(b34, dict_key) = b33.expression(StringLiteral(RawString, "k"))
	(b35, dict_value) = b34.expression(
		DictLiteral(
			[
				{
					key = dict_key,
					value = update,
					span = named_span
				},
			],
		),
	)
	(b36, opaque_type) = b35.named_type("Token")
	(b37, converted) = b36.expression(OpaqueConversion(IntoOpaque, opaque_type, vector))
	(b38, hole_value) = b37.name_expression("name")
	(b39, hole_span) = b38.next_span()
	(m1, hole) = b39.mint.minted_hole(hole_value, hole_span)
	(b40, interpolated) = { b39 | mint = m1 }.expression(
		InterpolatedString(
			QuotedInterpolation,
			[InterpolationText("hi "), InterpolationHole(hole), InterpolationText("!")],
		),
	)
	(b41, aggregates) = b40.expression(TupleLiteral(Triple(tuple_value, dict_value, converted)))
	(b42, aggregate_statement) = b41.statement(ExpressionStatement(aggregates))
	(b43, interpolation_statement) = b42.statement(ExpressionStatement(interpolated))
	-- Control flow.
	(b44, if_statement) = b43.sample_if_statement()
	(b45, flow_statement) = b44.sample_flow_statement()
	(
		b45,
		[
			logic_statement,
			aggregate_statement,
			interpolation_statement,
			if_statement,
			flow_statement,
		],
	)


---
`if a: 1 else if b: 2 else: 3`.
---
pure func sample_if_statement(build: SampleBuild) -> (SampleBuild, Statement):
	(b1, condition) = build.name_expression("a")
	(b2, one) = b1.expression(IntegerLiteral(to_int128(1)))
	(b3, then_block) = b2.block_of(one)
	(b4, inner_condition) = b3.name_expression("b")
	(b5, two) = b4.expression(IntegerLiteral(to_int128(2)))
	(b6, inner_then) = b5.block_of(two)
	(b7, three) = b6.expression(IntegerLiteral(to_int128(3)))
	(b8, else_block) = b7.block_of(three)
	(b9, keyword) = b8.next_span()
	(m1, else_if) = b9.mint.minted_else_if(
		keyword,
		{
			condition = inner_condition,
			then_block = inner_then,
			else_branch = Some({
				keyword = keyword,
				body = ElseBlock(else_block),
			})
		},
	)
	(b10, conditional) = { b9 | mint = m1 }.expression(If({
		condition = condition,
		then_block = then_block,
		else_branch = Some({
			keyword = keyword,
			body = ElseIf(else_if),
		}),
	}))
	b10.statement(ExpressionStatement(conditional))


---
`select`, `with`, `debug:`, a lambda, `concurrent:` and `detach`, in one
tuple.
---
pure func sample_flow_statement(build: SampleBuild) -> (SampleBuild, Statement):
	(b1, received) = build.binder("message")
	(b2, channel) = b1.name_expression("inbox")
	(b3, receive_value) = b2.expression(VoidValue)
	(b4, receive_body) = b3.block_of(receive_value)
	(b5, sealed_channel) = b4.name_expression("inbox")
	(b6, sealed_value) = b5.expression(VoidValue)
	(b7, sealed_body) = b6.block_of(sealed_value)
	(b8, timeout) = b7.expression(IntegerLiteral(to_int128(10)))
	(b9, after_value) = b8.expression(VoidValue)
	(b10, after_body) = b9.block_of(after_value)
	(b11, arm_span) = b10.next_span()
	arms: List[SelectArm] = [
		{
			kind = ReceiveArm(BindsName(received), channel),
			body = receive_body,
			span = arm_span
		},
		{
			kind = SealedArm(sealed_channel),
			body = sealed_body,
			span = arm_span
		},
		{
			kind = AfterArm(timeout),
			body = after_body,
			span = arm_span
		},
	]
	(b12, select_value) = b11.expression(Select(arms))
	(b13, resource_binder) = b12.binder("file")
	(b14, opened) = b13.name_expression("open")
	(b15, with_value) = b14.expression(VoidValue)
	(b16, with_body) = b15.block_of(with_value)
	(b17, with_plain) = b16.expression(With({
		acquisition = WithValue({
			target = BindsName(resource_binder),
			declared_type = None,
			value = opened,
			span = arm_span,
		}),
		body = with_body,
	}))
	(b18, tried) = b17.name_expression("open")
	(b19, failure) = b18.binder("error")
	(b20, mapped) = b19.name_expression("error")
	(b21, try_type) = b20.named_type("File")
	(b22, try_value) = b21.expression(VoidValue)
	(b23, try_body) = b22.block_of(try_value)
	(b24, with_try) = b23.expression(With({
		acquisition = WithTry({
			target = DiscardsValue(arm_span),
			declared_type = Some(try_type),
			value = tried,
			on_error = Some({
				target = BindsName(failure),
				value = mapped,
				span = arm_span,
			}),
			span = arm_span,
		}),
		body = try_body,
	}))
	(b25, debug_value) = b24.expression(VoidValue)
	(b26, debug_body) = b25.block_of(debug_value)
	(b27, debug_expression) = b26.expression(DebugBlock(debug_body))
	(b28, lambda_parameter) = b27.binder("item")
	(b29, lambda_value) = b28.name_expression("item")
	(b30, lambda_result) = b29.named_type("Int")
	(b31, lambda_expression) = b30.expression(Lambda({
		purity = PureFunction,
		parameters = [
			{
				target = BindsName(lambda_parameter),
				declared_type = None,
				span = arm_span
			},
		],
		return_type = Some(lambda_result),
		body = ExpressionBody(lambda_value),
	}))
	(b32, task) = b31.expression(VoidValue)
	(b33, detached) = b32.expression(Detach(task))
	(b34, concurrent_body) = b33.block_of(detached)
	(b35, timeout_value) = b34.expression(IntegerLiteral(to_int128(5)))

	threads = match positive_count(to_int128(4)):
		Some(count):
			Some({
				count = count,
				name_span = arm_span,
				span = arm_span,
			})
		None:
			None

	(b36, concurrent_value) = b35.expression(ConcurrentBlock({
		max_threads = threads,
		timeout = Some({
			value = timeout_value,
			name_span = arm_span,
			span = arm_span,
		}),
		body = concurrent_body,
	}))
	(b37, first_group) = b36.expression(TupleLiteral(Triple(select_value, with_plain, with_try)))
	(b38, second_group) = b37.expression(
		TupleLiteral(Triple(debug_expression, lambda_expression, concurrent_value)),
	)
	(b39, both_groups) = b38.expression(TupleLiteral(Pair(first_group, second_group)))
	b39.statement(ExpressionStatement(both_groups))


---
`var total: Int = 0`, `total = 1`, `_ = 2`, `got ?= fetch`, `total += 3`,
`xs[i] = 4` and `(first, _) = pair`.
---
pure func sample_binding_statements(build: SampleBuild) -> (SampleBuild, List[Statement]):
	(b1, total) = build.binder("total")
	(b2, total_type) = b1.named_type("Int")
	(b3, zero) = b2.expression(IntegerLiteral(to_int128(0)))
	(b4, declared) = b3.statement(VariableDeclaration({
		target = BindsName(total),
		declared_type = Some(total_type),
		value = zero,
	}))
	(b5, assigned_name) = b4.use("total")
	(b6, one) = b5.expression(IntegerLiteral(to_int128(1)))
	(b7, assigned) = b6.statement(Assignment({
		target = AssignsName(assigned_name),
		value = one,
	}))
	(b8, discard_span) = b7.next_span()
	(b9, two) = b8.expression(IntegerLiteral(to_int128(2)))
	(b10, discarded) = b9.statement(Assignment({
		target = AssignsDiscard(discard_span),
		value = two,
	}))
	(b11, got) = b10.binder("got")
	(b12, fetch) = b11.name_expression("fetch")
	(b13, questioned) = b12.statement(QuestionBinding({
		binder = got,
		declared_type = None,
		value = fetch,
	}))
	(b14, compound_target) = b13.use("total")
	(b15, three) = b14.expression(IntegerLiteral(to_int128(3)))
	(b16, compounded) = b15.statement(CompoundAssignment({
		target = compound_target,
		operator = AddAssign,
		value = three,
	}))
	(b17, collection) = b16.name_expression("xs")
	(b18, index) = b17.name_expression("i")
	(b19, place_span) = b18.next_span()
	(m1, place) = b19.mint.minted_subscript_place(
		place_span,
		collection,
		{
			first = index,
			rest = []
		},
	)
	(b20, four) = { b19 | mint = m1 }.expression(IntegerLiteral(to_int128(4)))
	(b21, stored) = b20.statement(SubscriptAssignment({
		place = place,
		value = four,
	}))
	(b22, first) = b21.binder("first")
	(b23, pair) = b22.name_expression("pair")
	(b24, destructured) = b23.statement(TupleDestructure({
		targets = Pair(BindsName(first), DiscardsValue(discard_span)),
		value = pair,
	}))
	(b24, [declared, assigned, discarded, questioned, compounded, stored, destructured])


---
`while go: void`, `for item in items: void`, `for (k, _) in pairs: void` and
`for job in jobs concurrently(limit: 2, timeout: 9): void`.
---
pure func sample_loop_statements(build: SampleBuild) -> (SampleBuild, List[Statement]):
	(b1, go) = build.name_expression("go")
	(b2, while_value) = b1.expression(VoidValue)
	(b3, while_body) = b2.block_of(while_value)
	(b4, while_loop) = b3.statement(WhileLoop({
		condition = go,
		body = while_body,
	}))
	(b5, item) = b4.binder("item")
	(b6, items) = b5.name_expression("items")
	(b7, for_value) = b6.expression(VoidValue)
	(b8, for_body) = b7.block_of(for_value)
	(b9, for_loop) = b8.statement(ForLoop({
		binder = LoopVariable(BindsName(item)),
		iterable = items,
		body = for_body,
	}))
	(b10, key) = b9.binder("k")
	(b11, tuple_span) = b10.next_span()
	(b12, pairs) = b11.name_expression("pairs")
	(b13, tuple_value) = b12.expression(VoidValue)
	(b14, tuple_body) = b13.block_of(tuple_value)
	(b15, tuple_loop) = b14.statement(ForLoop({
		binder = LoopTuple(
			Pair(BindsName(key), DiscardsValue(tuple_span)),
			tuple_span,
		),
		iterable = pairs,
		body = tuple_body,
	}))
	(b16, job) = b15.binder("job")
	(b17, jobs) = b16.name_expression("jobs")
	(b18, timeout) = b17.expression(IntegerLiteral(to_int128(9)))
	(b19, task_value) = b18.expression(VoidValue)
	(b20, task_body) = b19.block_of(task_value)
	-- `positive_count(2)` is always a count; were it not, the job's ids would
	-- be held nowhere and the census tests would report them.
	no_statements: List[Statement] = []

	(b21, concurrent_loops) = match positive_count(to_int128(2)):
		Some(count):
			(stated, concurrent_loop) = b20.statement(ConcurrentForLoop({
				binder = job,
				iterable = jobs,
				limit = {
					count = count,
					name_span = tuple_span,
					span = tuple_span
				},
				timeout = Some({
					value = timeout,
					name_span = tuple_span,
					span = tuple_span,
				}),
				body = task_body,
			}))
			(stated, [concurrent_loop])
		None:
			(b20, no_statements)

	(b21, [while_loop, for_loop, tuple_loop].concat(concurrent_loops))


---
`func helper() -> Int: 1`, declared in a body.
---
pure func sample_local_function(build: SampleBuild) -> (SampleBuild, Statement):
	(b1, name) = build.written("helper")
	(b2, result) = b1.named_type("Int")
	(b3, value) = b2.expression(IntegerLiteral(to_int128(1)))
	(b4, span) = b3.next_span()
	function: Function = {
		signature = {
			purity = ImpureFunction,
			keyword = span,
			name = name,
			parameters = [],
			return_type = Some(result)
		},
		type_parameters = [],
		constraints = [],
		body = Some(ExpressionBody(value))
	}
	(m1, local) = b4.mint.minted_local_function(function, span)
	{ b4 | mint = m1 }.statement(LocalFunctionStatement(local))


---
Operator alternatives use distinct operands so the dump proves their order.
---
pure func sample_binary(build: SampleBuild, operator: BinaryOperator) -> (SampleBuild, Expression):
	(b1, left) = build.expression(IntegerLiteral(to_int128(7)))
	(b2, right) = b1.expression(IntegerLiteral(to_int128(2)))
	b2.expression(Binary(operator, left, right))


pure func sample_dimension_arithmetic(
	build: SampleBuild,
	operator: DimensionOperator,
) -> (SampleBuild, Statement):
	(b1, left) = build.dimension(LiteralDimension(to_int128(7)))
	(b2, right) = b1.dimension(LiteralDimension(to_int128(2)))
	(b3, arithmetic) = b2.dimension(DimensionArithmetic(operator, left, right))
	(b4, declared_type) = b3.written_type(DimensionType(arithmetic))
	(b5, target) = b4.binder("size")
	(b6, value) = b5.expression(IntegerLiteral(to_int128(5)))
	b6.statement(TypedBinding({
		target = BindsName(target),
		declared_type = declared_type,
		value = value,
	}))


pure func sample_compound(build: SampleBuild, operator: CompoundOperator) -> (SampleBuild, Statement):
	(b1, target) = build.use("total")
	(b2, value) = b1.expression(IntegerLiteral(to_int128(2)))
	b2.statement(CompoundAssignment({
		target = target,
		operator = operator,
		value = value,
	}))


pure func sample_quadruple(build: SampleBuild) -> (SampleBuild, Expression):
	(b1, first) = build.expression(IntegerLiteral(to_int128(1)))
	(b2, second) = b1.expression(IntegerLiteral(to_int128(2)))
	(b3, third) = b2.expression(IntegerLiteral(to_int128(3)))
	(b4, fourth) = b3.expression(IntegerLiteral(to_int128(4)))
	b4.expression(TupleLiteral(Quadruple(first, second, third, fourth)))


pure func sample_logical_not(build: SampleBuild) -> (SampleBuild, Expression):
	(b1, operand) = build.expression(BooleanLiteral(True))
	b1.expression(Unary(LogicalNot, operand))


pure func sample_logical_or(build: SampleBuild) -> (SampleBuild, Expression):
	(b1, left) = build.expression(BooleanLiteral(False))
	(b2, right) = b1.expression(BooleanLiteral(True))
	b2.expression(ShortCircuit(LogicalOr, left, right))


pure func sample_from_opaque(build: SampleBuild) -> (SampleBuild, Expression):
	(b1, opaque_type) = build.named_type("Token")
	(b2, value) = b1.expression(IntegerLiteral(to_int128(7)))
	b2.expression(OpaqueConversion(FromOpaque, opaque_type, value))


pure func sample_pipe_interpolation(build: SampleBuild) -> (SampleBuild, Expression):
	(b1, value) = build.expression(IntegerLiteral(to_int128(7)))
	(b2, span) = b1.next_span()
	(mint, hole) = b2.mint.minted_hole(value, span)
	{ b2 | mint = mint }.expression(InterpolatedString(PipeInterpolation, [
		InterpolationText("before "),
		InterpolationHole(hole),
		InterpolationText(" after"),
	]))


---
The remaining enum alternatives, retained by the shared module so its census
also verifies that every child is held exactly once.
---
pure func sample_alternative_statements(build: SampleBuild) -> (SampleBuild, List[Statement]):
	var current: SampleBuild = build
	var statements: List[Statement] = []

	for operator in [Subtract, Divide, Modulo, Equal, NotEqual, LessEqual, Greater, GreaterEqual]:
		(with_expression, value) = current.sample_binary(operator)
		(with_statement, stated) = with_expression.statement(ExpressionStatement(value))
		current = with_statement
		statements = statements.append(stated)

	for operator in [AddDimensions, SubtractDimensions, DivideDimensions]:
		(with_statement, stated) = current.sample_dimension_arithmetic(operator)
		current = with_statement
		statements = statements.append(stated)

	for operator in [SubtractAssign, MultiplyAssign, DivideAssign]:
		(with_statement, stated) = current.sample_compound(operator)
		current = with_statement
		statements = statements.append(stated)

	(b1, quadruple) = current.sample_quadruple()
	(b2, tuple_statement) = b1.statement(ExpressionStatement(quadruple))
	(b3, raw_pipe) = b2.expression(StringLiteral(RawPipeString, "raw\\text\nnext"))
	(b4, string_statement) = b3.statement(ExpressionStatement(raw_pipe))
	(b5, logical_not) = b4.sample_logical_not()
	(b6, not_statement) = b5.statement(ExpressionStatement(logical_not))
	(b7, logical_or) = b6.sample_logical_or()
	(b8, or_statement) = b7.statement(ExpressionStatement(logical_or))
	(b9, from_opaque_expression) = b8.sample_from_opaque()
	(b10, opaque_statement) = b9.statement(ExpressionStatement(from_opaque_expression))
	(b11, interpolation) = b10.sample_pipe_interpolation()
	(b12, interpolation_statement) = b11.statement(ExpressionStatement(interpolation))
	(b12, statements.concat([
		tuple_statement, string_statement, not_statement, or_statement,
		opaque_statement, interpolation_statement,
	]))


---
Annotations are syntax records in written order, independent of body parsing.
---
pure func sample_annotation_function(build: SampleBuild) -> (SampleBuild, ModuleItem):
	(b1, name) = build.written("annotated")
	(b2, debug_span) = b1.next_span()
	(b3, resource_span) = b2.next_span()
	(b4, declaration_span) = b3.next_span()
	function: Function = {
		signature = {
			purity = ImpureFunction,
			keyword = declaration_span,
			name = name,
			parameters = [],
			return_type = None
		},
		type_parameters = [],
		constraints = [],
		body = None
	}
	annotations: List[Annotation] = [
		{ annotation = DebugOnlyAnnotation, span = debug_span },
		{ annotation = ResourceResultOrdinaryAnnotation, span = resource_span },
	]
	(mint, declaration) = b4.mint.minted_function(
		PublicVisibility, None, annotations, function, declaration_span,
	)
	({ b4 | mint = mint }, FunctionItem(declaration))
