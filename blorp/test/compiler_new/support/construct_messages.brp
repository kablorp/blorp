---
Whether `code` takes a construct as its argument (it is one of the
`Expected...` codes).
---
pure func takes_construct(code: DiscoveryDiagnosticCode) -> Bool:
	match diagnostic_argument_kinds(code).get(0):
		Some(kind):
			kind == ConstructArgument
		None:
			False


---
Whether `CONSTRUCT_MESSAGES` lists `code` reported in `construct`.
---
pure func pair_is_listed(code: DiscoveryDiagnosticCode, construct: ParsedConstruct) -> Bool:
	CONSTRUCT_MESSAGES.any(pure func(entry): entry[0] == code and entry[1] == construct)


---
For every diagnostic of `builder`'s one parsed module whose code takes a
construct, `CodeName argument` when `CONSTRUCT_MESSAGES` does not list its
(code, construct) pair; the argument is the construct's index in the enum.
Tables that do not freeze give no entries (the fixture suite reports them).
---
pure func unlisted_construct_pairs(builder: DiscoveryBuilder) -> List[String]:
	match builder.freeze():
		FrozenTables(tables):
			var unlisted: List[String] = []

			for index in 0..tables.diagnostic_count():
				match tables.diagnostic_row_at(index):
					Some(row):
						if row.code.takes_construct():
							argument: Int = tables
								.diagnostic_argument(row, 0)
								.get_or(-1)

							listed: Bool = match parsed_construct_at_argument(argument):
								Some(construct):
									pair_is_listed(row.code, construct)
								None:
									False

							if not listed:
								unlisted = unlisted.append(
									"${diagnostic_code_name(row.code)} ${argument}",
								)
					None:
						void

			unlisted
		TableInvariantsViolated(_):
			[]
