-- The first diagnostic of a module parsed alone, as the discovery stage
-- renders it. Shared by the parser fixtures (which compare the text with the
-- existing compiler's) and the corpus dump (which prints it for the parity
-- check), so both read the same rows the same way.
import:
	../../../src/compiler_new/stage_01_discovery/diagnostics/render:
		RenderedDiagnostic,
		diagnostic_display,
		render_diagnostic,
	../../../src/compiler_new/stage_01_discovery/tables/builder: DiscoveryBuilder
	../../../src/compiler_new/stage_01_discovery/tables/frontend_tables:
		FreezeOutcome(FrozenTables, TableInvariantsViolated),
		FrontendTables,
		diagnostic_row_at,
		freeze,
		span_line_column,
	../../../src/compiler_new/stage_01_discovery/tables/rows: SyntaxDiagnosticAt
	../../../src/compiler_new/stage_01_discovery/tables/source_position: LineColumn


---
A diagnostic of frozen tables: the tables its text is read from, and its row.
---
record FrozenDiagnostic {
	tables: FrontendTables,
	row: SyntaxDiagnosticAt
}


---
The first diagnostic of `builder`, which holds one parsed module; `None` when
it has none or its tables do not freeze (a violated invariant is reported by
the fixture suite, not here).
---
pure func first_frozen_diagnostic(builder: DiscoveryBuilder) -> Option[FrozenDiagnostic]:
	match builder.freeze():
		FrozenTables(tables):
			tables
				.diagnostic_row_at(0)
				.map(pure func(row): {
						tables = tables,
						row = row
					})
		TableInvariantsViolated(_):
			None


---
`path:line:column: error: message`, then the help line, of the first
diagnostic; `None` when there is none.
---
pure func first_diagnostic_display(builder: DiscoveryBuilder) -> Option[String]:
	builder
		.first_frozen_diagnostic()
		.map(pure func(found): found.tables.diagnostic_display(found.row))


---
The one-based line of a frozen diagnostic.
---
pure func diagnostic_line(found: FrozenDiagnostic) -> Int:
	found.tables.span_line_column(found.row.span).line + 1


pure func diagnostic_column(found: FrozenDiagnostic) -> Int:
	found.tables.span_line_column(found.row.span).column


pure func diagnostic_text(found: FrozenDiagnostic) -> RenderedDiagnostic:
	found.tables.render_diagnostic(found.row)


---
`path:line:column: error: message` and the help line of a frozen diagnostic.
---
pure func diagnostic_shown(found: FrozenDiagnostic) -> String:
	found.tables.diagnostic_display(found.row)
