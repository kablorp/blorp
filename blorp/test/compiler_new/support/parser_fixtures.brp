-- Runs parser fixtures through the discovery stage's per-module lex and parse
-- and compares what it reports with the expectation pinned in the fixture.
--
-- A should_fail fixture pins its first diagnostic in a line of its own:
--
--     -- EXPECT-DISCOVERY: ExpectedColonDiagnostic 4:12
--
-- (the code's name, then the one-based line and tab-expanded column where its
-- span starts), or one of three explicit forms for a fixture discovery does
-- not reject:
--
--     -- EXPECT-DISCOVERY: accepted-by-discovery <why the old compiler rejects it later>
--     -- EXPECT-DISCOVERY: discovery-gap <what the old parser reports that discovery does not>
--     -- EXPECT-DISCOVERY: pending-spec-decision
--
-- `accepted-by-discovery` is for a fixture the existing compiler rejects only
-- after parsing (type checking, say), so discovery rightly reports nothing.
-- `discovery-gap` records a check the old parser makes and discovery lacks:
-- the suite still requires discovery to report nothing, so closing the gap
-- fails the fixture until its pin is replaced by a real one.
-- `pending-spec-decision` marks a fixture whose expected behaviour is
-- undecided; the suite names it and checks nothing else.
--
-- Every pinned should_fail fixture also pins the text of its first diagnostic,
-- the existing compiler's, so both front ends answer to the same words:
--
--     -- RUN-BLORP-CHECK
--     -- EXPECT-BLORP: error: expected `:` after if condition
--     -- EXPECT-BLORP: help: ...
--     -- EXPECT-BLORP-CONTAINS: :7:9: error:
--
-- The existing compiler's fixture runner checks those lines against its own
-- output (the message and help exactly, the position as a substring), and
-- `rendered_text_failures` checks that the discovery stage prints the same
-- `path:line:column: error: message` and help line. Where the stage words a
-- diagnostic differently on purpose, the fixture says so in lines of its own
-- (and `docs/DISCOVERY_TABLES_DESIGN.md` says why):
--
--     -- EXPECT-DISCOVERY-TEXT: error: expected `:`
--     -- EXPECT-DISCOVERY-TEXT: help: ...
--     -- DISCOVERY-POSITION-DIFFERS: <why the stage reports another position>
--
-- A difference line that no longer differs fails, so the list cannot go stale.
--
-- Only `load_module` runs, not `discover`: a fixture is parsed as one
-- module and its imports are never resolved, so resolution diagnostics
-- (unresolved imports, unreadable sources) cannot appear.
import:
	../../../src/compiler_new/stage_01_discovery/diagnostics/render: RenderedDiagnostic
	../../../src/compiler_new/stage_01_discovery/tables/builder:
		DiscoveryBuilder,
		empty_discovery_builder,
	../../../src/compiler_new/stage_01_discovery/tables/diagnostic_code: diagnostic_code_name
	../../../src/compiler_new/stage_01_discovery/tables/frontend_tables:
		FreezeOutcome(FrozenTables, TableInvariantsViolated),
		freeze,
	../../../src/compiler_new/stage_01_discovery/pipeline: load_module
	../../../src/compiler_new/stage_01_discovery/tables/row_kinds:
		ModuleOriginKind(UserModule),
		ModuleReach(RootModule),
	../../../src/compiler_new/stage_01_discovery/tables/source_position:
		LineColumn,
		span_start_position,
	../../../src/compiler_new/stage_01_discovery/sources/source_provider: PackageMembership(NotInPackage)
	./first_diagnostic:
		FrozenDiagnostic,
		diagnostic_column,
		diagnostic_line,
		diagnostic_shown,
		first_diagnostic_display,
		first_frozen_diagnostic,
	fs: message, read_directory
	system: read_file


---
The prefix of the line that pins a should_fail fixture's discovery expectation.
---
PIN_LINE_PREFIX: String = "-- EXPECT-DISCOVERY: "

---
The pin's first word when discovery accepts a fixture that a later stage of the
existing compiler rejects; the rest of the line is the reason.
---
ACCEPTED_PIN_PREFIX: String = "accepted-by-discovery "


---
The pin's first word when the old parser rejects a fixture that discovery
accepts because it lacks that check; the rest of the line says what the old
parser reports.
---
GAP_PIN_PREFIX: String = "discovery-gap "

---
The pin of a fixture whose expected behaviour is undecided.
---
PENDING_PIN_WORD: String = "pending-spec-decision"


---
The line that makes the existing compiler's fixture runner check a fixture.
---
RUN_MARKER_LINE: String = "-- RUN-BLORP-CHECK"

---
Prefixes of the lines that pin the first diagnostic's text: the existing
compiler's message and help (`error: ...`, `help: ...`), its position (a
substring of its output), and the stage's own text where it differs.
---
BLORP_TEXT_PREFIX: String = "-- EXPECT-BLORP: "

BLORP_POSITION_PREFIX: String = "-- EXPECT-BLORP-CONTAINS: "

DISCOVERY_TEXT_PREFIX: String = "-- EXPECT-DISCOVERY-TEXT: "

POSITION_DIFFERS_PREFIX: String = "-- DISCOVERY-POSITION-DIFFERS: "

ERROR_LINE_PREFIX: String = "error: "

HELP_LINE_PREFIX: String = "help: "

---
The position substring of a pinned existing-compiler position, around the
`line:column`: `:7:9: error:`.
---
POSITION_FRAME_START: String = ":"

POSITION_FRAME_END: String = ": error:"


---
What a should_fail fixture pins about discovery's behaviour.
`ExpectsFirstDiagnostic` holds the label `diagnostic_label` renders;
`AcceptedByDiscovery` and `KnownDiscoveryGap` hold their explanation.
`NoPin` and `ConflictingPins` (the number of pin lines) are not valid
expectations and fail the suite.
---
union FixturePin:
	ExpectsFirstDiagnostic(String)
	AcceptedByDiscovery(String)
	KnownDiscoveryGap(String)
	PendingSpecDecision
	NoPin
	ConflictingPins(Int)


---
The pin of a fixture's source text.
---
pure func fixture_pin(text: String) -> FixturePin:
	pin_texts: List[String] = text
		.lines()
		.filter(pure func(line): line.starts_with(PIN_LINE_PREFIX))
		.map(pure func(line): line.drop_left(PIN_LINE_PREFIX.length()).trim())

	match pin_texts.length():
		0:
			NoPin
		1:
			pin_text: String = pin_texts.get_or(0, "")

			if pin_text.starts_with(ACCEPTED_PIN_PREFIX):
				AcceptedByDiscovery(pin_text.drop_left(ACCEPTED_PIN_PREFIX.length()))
			else if pin_text.starts_with(GAP_PIN_PREFIX):
				KnownDiscoveryGap(pin_text.drop_left(GAP_PIN_PREFIX.length()))
			else if pin_text == PENDING_PIN_WORD:
				PendingSpecDecision
			else:
				ExpectsFirstDiagnostic(pin_text)
		count:
			ConflictingPins(count)


---
One discovery diagnostic of a parsed fixture: its code's name and the
one-based line and column where its span starts.
---
record ReportedDiagnostic {
	code_name: String,
	line: Int,
	column: Int
}


---
`CodeName line:column`, the form a pin is written in.
---
pure func diagnostic_label(reported: ReportedDiagnostic) -> String:
	"${reported.code_name} ${reported.line}:${reported.column}"


---
The module `text` parsed alone, as the discovery stage parses a root.
---
pure func parsed_fixture(path: String, text: String) -> DiscoveryBuilder:
	empty_discovery_builder().load_module(
		{
			path = path,
			trusted_directory = ".",
			origin = UserModule,
			package = NotInPackage
		},
		RootModule,
		text,
	)


---
Every diagnostic of a builder holding one parsed module, in report order.
---
pure func reported_diagnostics(builder: DiscoveryBuilder) -> List[ReportedDiagnostic]:
	var reported: List[ReportedDiagnostic] = []

	for row in builder.diagnostics:
		position: LineColumn = builder.span_start_position(row.span)
		reported = reported.append({
			code_name = row.code.diagnostic_code_name(),
			line = position.line + 1,
			column = position.column
		})

	reported


---
The diagnostics as one label per line, or `(none)`.
---
pure func diagnostics_listing(reported: List[ReportedDiagnostic]) -> String:
	if reported.is_empty():
		"(none)"
	else:
		reported
			.map(diagnostic_label)
			.join("\n")


---
Whether the tables satisfy every table invariant, and so freeze.
---
pure func freezes_with_invariants(builder: DiscoveryBuilder) -> Bool:
	match builder.freeze():
		FrozenTables(_):
			True
		TableInvariantsViolated(_):
			False


---
Fixture paths (`directory` plus each `.brp` file name) in name order, or a
message naming the directory that could not be read.
---
func fixture_paths(directory: String) -> Result[List[String], String]:
	match read_directory(directory):
		Ok(entries):
			Ok(
				entries
					.filter(pure func(entry): entry.name.ends_with(".brp"))
					.map(pure func(entry): directory + entry.name),
			)
		Err(error):
			Err("cannot list fixture directory ${directory}: ${error.message()}")


---
The text of the file at `path`, or an empty string when it cannot be read
(an unreadable fixture then fails its expectations and is named).
---
func fixture_text(path: String) -> String:
	match read_file(path):
		Ok(text):
			text
		Err(_):
			""


---
The failures of a should_pass fixture's source `text`: any diagnostic, or
tables that do not freeze. Empty when it passes.
---
pure func should_pass_failures(path: String, text: String) -> List[String]:
	builder: DiscoveryBuilder = parsed_fixture(path, text)
	reported: List[ReportedDiagnostic] = builder.reported_diagnostics()
	var failures: List[String] = []

	if not reported.is_empty():
		failures = failures.append(
			"${path}: expected no diagnostics, discovery reported:\n${reported.diagnostics_listing()}",
		)

	if not builder.freezes_with_invariants():
		failures = failures.append("${path}: the parsed tables violate a table invariant")

	failures


---
The failures of a should_fail fixture's source `text` against its pin. Empty
when it passes.
---
pure func should_fail_failures(path: String, text: String) -> List[String]:
	builder: DiscoveryBuilder = parsed_fixture(path, text)
	reported: List[ReportedDiagnostic] = builder.reported_diagnostics()
	actual_listing: String = reported.diagnostics_listing()
	var failures: List[String] = []

	match text.fixture_pin():
		NoPin:
			suggestion: String = reported
				.get(0)
				.map(diagnostic_label)
				.get_or("accepted-by-discovery <why the existing compiler rejects it later>")

			failures = failures.append(
				"${path}: no `${PIN_LINE_PREFIX}` line. Add `${PIN_LINE_PREFIX}${suggestion}` after checking it against the existing compiler's diagnostic; discovery reported:\n${actual_listing}",
			)
		ConflictingPins(count):
			failures = failures.append(
				"${path}: ${count} `${PIN_LINE_PREFIX}` lines; a fixture pins exactly one",
			)
		PendingSpecDecision:
			void
		AcceptedByDiscovery(reason):
			failures = failures.concat(unreported_failures(path, reason, "accepted-by-discovery", reported))
		KnownDiscoveryGap(reason):
			failures = failures.concat(unreported_failures(path, reason, "discovery-gap", reported))
		ExpectsFirstDiagnostic(expected):
			actual: String = reported
				.get(0)
				.map(diagnostic_label)
				.get_or("(none)")

			if actual != expected:
				failures = failures.append(
					"${path}: expected first diagnostic ${expected}, got ${actual}; all diagnostics:\n${actual_listing}",
				)

	if not builder.freezes_with_invariants():
		failures = failures.append("${path}: the parsed tables violate a table invariant")

	failures


---
The failures of a pin that says discovery reports nothing: diagnostics after
all. (A pin's reason is non-empty by construction: the text is trimmed and the
pin's first word includes a space.)
---
pure func unreported_failures(
	path: String,
	reason: String,
	pin_word: String,
	reported: List[ReportedDiagnostic],
) -> List[String]:
	if reported.is_empty():
		[]
	else:
		[
			"${path}: pinned ${pin_word} (${reason}), but discovery reported:\n${reported.diagnostics_listing()}. Replace the pin with the first diagnostic.",
		]


---
The failures of the should_pass fixture file at `path`.
---
func should_pass_file_failures(path: String) -> List[String]:
	match read_file(path):
		Ok(text):
			should_pass_failures(path, text)
		Err(message):
			["${path}: unreadable: ${message}"]


---
The failures of the should_fail fixture file at `path`.
---
func should_fail_file_failures(path: String) -> List[String]:
	match read_file(path):
		Ok(text):
			should_fail_failures(path, text).concat(rendered_text_failures(path, text))
		Err(message):
			["${path}: unreadable: ${message}"]


---
The pin of the fixture file at `path`; `NoPin` when it cannot be read.
---
func fixture_file_pin(path: String) -> FixturePin:
	match read_file(path):
		Ok(text):
			text.fixture_pin()
		Err(_):
			NoPin


---
The text pinned by the lines starting `prefix`: the first `error: ` line is the
message and the first `help: ` line the help; `None` when there is no
message line.
---
pure func pinned_text(text: String, prefix: String) -> Option[RenderedDiagnostic]:
	pinned: List[String] = text
		.lines()
		.filter(pure func(line): line.starts_with(prefix))
		.map(pure func(line): line.drop_left(prefix.length()))

	messages: List[String] = pinned
		.filter(pure func(line): line.starts_with(ERROR_LINE_PREFIX))
		.map(pure func(line): line.drop_left(ERROR_LINE_PREFIX.length()))

	helps: List[String] = pinned
		.filter(pure func(line): line.starts_with(HELP_LINE_PREFIX))
		.map(pure func(line): line.drop_left(HELP_LINE_PREFIX.length()))

	match messages.get(0):
		Some(message):
			Some({
				message = message,
				help = helps.get(0)
			})
		None:
			None


---
The line and column the existing compiler is pinned to report, from the
`-- EXPECT-BLORP-CONTAINS: :line:column: error:` line.
---
pure func pinned_existing_position(text: String) -> Option[(Int, Int)]:
	frames: List[String] = text
		.lines()
		.filter(pure func(line): line.starts_with(BLORP_POSITION_PREFIX))
		.map(pure func(line): line.drop_left(BLORP_POSITION_PREFIX.length()).trim())
		.filter(
			pure func(frame): frame.starts_with(POSITION_FRAME_START) and frame.ends_with(POSITION_FRAME_END),
		)

	match frames.get(0):
		Some(frame):
			numbers: List[String] = frame
				.drop_left(POSITION_FRAME_START.length())
				.remove_suffix(POSITION_FRAME_END)
				.split(":")

			match numbers.get_or(0, "").parse_int():
				Some(line):
					match numbers.get_or(1, "").parse_int():
						Some(column):
							Some((line, column))
						None:
							None
				None:
					None
		None:
			None


pure func has_line(text: String, line: String) -> Bool:
	text
		.lines()
		.any(pure func(candidate): candidate.trim() == line)


pure func has_line_starting(text: String, prefix: String) -> Bool:
	text
		.lines()
		.any(pure func(candidate): candidate.starts_with(prefix))


---
`path:line:column: error: message`, then `help: ...`, the way the stage
displays a diagnostic.
---
pure func expected_display(
	path: String,
	line: Int,
	column: Int,
	text: RenderedDiagnostic,
) -> String:
	first_line: String = path + ":" + line.to_string() + ":" + column.to_string() + ": error: " + text.message

	match text.help:
		Some(help):
			first_line + "\nhelp: " + help
		None:
			first_line


---
The failures of a should_fail fixture whose pin names its first diagnostic:
the fixture must be run by the existing compiler's runner with its text and
position pinned, and the stage must display its first diagnostic as that
text (or as the fixture's own `EXPECT-DISCOVERY-TEXT` lines, which must
differ) at that position (or the pinned discovery position when the fixture
says the positions differ on purpose). Empty for other pins.
---
pure func rendered_text_failures(path: String, text: String) -> List[String]:
	match text.fixture_pin():
		ExpectsFirstDiagnostic(label):
			text.pinned_display_failures(path, label)
		_:
			[]


private pure func pinned_display_failures(text: String, path: String, label: String) -> List[String]:
	builder: DiscoveryBuilder = parsed_fixture(path, text)
	existing_text: Option[RenderedDiagnostic] = text.pinned_text(BLORP_TEXT_PREFIX)
	existing_position: Option[(Int, Int)] = text.pinned_existing_position()
	own_text: Option[RenderedDiagnostic] = text.pinned_text(DISCOVERY_TEXT_PREFIX)
	var failures: List[String] = []

	if not text.has_line(RUN_MARKER_LINE):
		failures = failures.append(
			"${path}: add `${RUN_MARKER_LINE}` so the existing compiler's runner checks the pinned text too",
		)

	match (builder.first_frozen_diagnostic(), existing_text, existing_position):
		(Some(found), Some(existing), Some(position)):
			failures = failures.concat(text.display_failures(path, found, existing, position, own_text))
		(None, _, _):
			-- The pin check reports that there is no diagnostic.
			void
		(_, None, _):
			failures = failures.append(
				"${path}: no `${BLORP_TEXT_PREFIX}${ERROR_LINE_PREFIX}` line. Add the existing compiler's first message (and `${BLORP_TEXT_PREFIX}${HELP_LINE_PREFIX}` line, when it prints help) from `bin/blorp check --no-format ${path}`",
			)
		(_, _, None):
			failures = failures.append(
				"${path}: no `${BLORP_POSITION_PREFIX}${POSITION_FRAME_START}line:column${POSITION_FRAME_END}` line. Add the position the existing compiler reports for the first diagnostic",
			)

	failures


private pure func display_failures(
	text: String,
	path: String,
	found: FrozenDiagnostic,
	existing: RenderedDiagnostic,
	existing_position: (Int, Int),
	own_text: Option[RenderedDiagnostic],
) -> List[String]:
	var failures: List[String] = []
	own_position: (Int, Int) = (found.diagnostic_line(), found.diagnostic_column())
	positions_differ: Bool = own_position[0] != existing_position[0] or own_position[1] != existing_position[1]
	says_positions_differ: Bool = text.has_line_starting(POSITION_DIFFERS_PREFIX)

	if positions_differ and not says_positions_differ:
		failures = failures.append(
			"${path}: the stage reports ${own_position[0]}:${own_position[1]} but the existing compiler reports ${existing_position[0]}:${existing_position[1]}. Fix the parser, or say why with `${POSITION_DIFFERS_PREFIX}<reason>`",
		)
	else if says_positions_differ and not positions_differ:
		failures = failures.append(
			"${path}: `${POSITION_DIFFERS_PREFIX}` is stale: both front ends report ${own_position[0]}:${own_position[1]}. Remove the line",
		)

	-- The text compared is the existing compiler's unless the fixture names
	-- the stage's own; a named difference must still differ.
	wanted: RenderedDiagnostic = own_text.get_or(existing)

	match own_text:
		Some(own):
			if own.message == existing.message and own.help == existing.help:
				failures = failures.append(
					"${path}: `${DISCOVERY_TEXT_PREFIX}` lines equal the existing compiler's text. Remove them",
				)
		None:
			void

	expected: String = expected_display(path, own_position[0], own_position[1], wanted)

	actual: String = found.diagnostic_shown()

	if actual != expected:
		failures = failures.append(
			"${path}: the stage displays\n${actual}\nbut the fixture pins\n${expected}\n(the existing compiler prints ${existing.message}). Change the stage's text, or pin the difference with `${DISCOVERY_TEXT_PREFIX}` lines and list it in docs/DISCOVERY_TABLES_DESIGN.md",
		)

	failures
