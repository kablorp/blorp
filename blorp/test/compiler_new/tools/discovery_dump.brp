-- Runs discovery over root source paths on the file system and prints each
-- table's row count, the discovery phase's allocation counters, and with
-- `tables` the roots, modules, imports and diagnostics.
--
-- Usage: discovery_dump.brp <counts|tables|counts-roots-only> <root.brp>...
--
-- `counts` and `tables` load the implicit modules a compile loads (prelude and
-- tuple); `counts-roots-only` loads none, to measure what they add.
--
-- Paths are relative to the working directory (run from the repository
-- root): the standard library is standard_library/src and native packages
-- live under pkg.
import:
	../../../src/compiler_new/stage_01_discovery/pipeline:
		ImplicitModules,
		compiler_implicit_modules,
		discover,
	../../../src/compiler_new/stage_01_discovery/sources/source_provider:
		FILE_SYSTEM_SOURCE_PROVIDER,
		SourceLookupRoots,
	../../../src/compiler_new/stage_01_discovery/tables/frontend_tables:
		FreezeOutcome(FrozenTables, TableInvariantsViolated),
	../support/tables_dump: table_counts_line, tables_dump
	memory: MemStats, get_mem_stats, mem_delta


LOOKUP_ROOTS: SourceLookupRoots = {
	standard_library_root = "standard_library/src",
	native_package_roots = ["pkg"]
}

---
Position of the mode argument; the roots follow it. Position 0 is the program.
---
MODE_ARGUMENT: Int = 1

EXIT_USAGE: Int = 2

EXIT_INVARIANT_VIOLATION: Int = 3


func main(args: List[String]) -> Int:
	mode: String = args
		.get(MODE_ARGUMENT)
		.get_or("")
	roots: List[String] = args.drop(MODE_ARGUMENT + 1)

	if mode != "counts" and mode != "tables" and mode != "counts-roots-only" or roots.is_empty():
		print("usage: discovery_dump.brp <counts|tables|counts-roots-only> <root.brp>...")
		EXIT_USAGE
	else:
		implicit: ImplicitModules = if mode == "counts-roots-only":
			{module_names = []}
		else:
			compiler_implicit_modules()

		before: MemStats = get_mem_stats()
		outcome: FreezeOutcome = discover(
			FILE_SYSTEM_SOURCE_PROVIDER,
			LOOKUP_ROOTS,
			roots,
			implicit,
		)
		after: MemStats = get_mem_stats()
		delta: MemStats = mem_delta(before, after)

		match outcome:
			FrozenTables(tables):
				if mode == "tables":
					print(tables.tables_dump())

				print(tables.table_counts_line())
				print(
					"discovery allocations=${delta.total_allocations} releases=${delta.total_releases} counters_active=${delta.memory_stats_active}",
				)
				0
			TableInvariantsViolated(violations):
				print("table invariants violated: ${violations.length()}")
				EXIT_INVARIANT_VIOLATION
