-- Rule probe: the workaround and plain calling shapes of the builder
-- threading rules, one process per shape; compare allocations across row counts.
-- Usage: builder_rule_probe.brp <shape> <rows>
import:
	../../../src/compiler_new/stage_01_discovery/tables/builder:
		DiscoveryBuilder,
		NodeId,
		NodeRow,
		append_node,
		append_node_child,
		empty_discovery_builder,
		last_node_id,
		node_id_at_row,
	../../../src/compiler_new/stage_01_discovery/tables/row_kinds: NodeKind(IdentifierNode)
	../../../src/compiler_new/stage_01_discovery/tables/span: pack_span
	memory: MemStats, get_mem_stats, mem_delta


record Holder {
	held: DiscoveryBuilder,
	tag: Int
}


pure func node_row_at(index: Int) -> NodeRow:
	{
		kind = IdentifierNode,
		span = pack_span(0, 0, 0),
		payload = index,
		children = {
			first = 0,
			count = 0
		}
	}


pure func maybe_node(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	if i % 2 == 0:
		b.append_node(node_row_at(i))
	else:
		b


pure func step_r1_w_helper(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = maybe_node(b, i)
	out = out.append_node_child(node_id_at_row(0))
	out


pure func run_r1_w_helper(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r1_w_helper(b, i)

	b


pure func step_r1_p_alias_cond(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = b

	if i % 2 == 0:
		out = out.append_node(node_row_at(i))

	out = out.append_node_child(node_id_at_row(0))
	out


pure func run_r1_p_alias_cond(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r1_p_alias_cond(b, i)

	b


pure func step_r1_p_cond_tail(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	if i % 2 == 0:
		b.append_node(node_row_at(i))
	else:
		b


pure func run_r1_p_cond_tail(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r1_p_cond_tail(b, i)

	b


pure func step_r1_w_loop_first(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = b.append_node(node_row_at(i))

	for k in 0..2:
		out = out.append_node(node_row_at(k))

	out


pure func run_r1_w_loop_first(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r1_w_loop_first(b, i)

	b


pure func step_r1_p_loop_first(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = b

	for k in 0..3:
		out = out.append_node(node_row_at(k))

	out


pure func run_r1_p_loop_first(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r1_p_loop_first(b, i)

	b


pure func step_r2_w_assign_return(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = b.append_node(node_row_at(i))

	if i % 2 == 0:
		out = out.append_node(node_row_at(i))

	out = out.append_node_child(node_id_at_row(0))
	out


pure func run_r2_w_assign_return(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r2_w_assign_return(b, i)

	b


pure func step_r2_p_tail_after_if(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = b.append_node(node_row_at(i))

	if i % 2 == 0:
		out = out.append_node(node_row_at(i))

	out.append_node_child(node_id_at_row(0))


pure func run_r2_p_tail_after_if(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r2_p_tail_after_if(b, i)

	b


pure func step_r2_p_tail_after_loop(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = b.append_node(node_row_at(i))

	for k in 0..2:
		out = out.append_node(node_row_at(k))

	out.append_node_child(node_id_at_row(0))


pure func run_r2_p_tail_after_loop(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r2_p_tail_after_loop(b, i)

	b


pure func step_r3_w_local(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	last: NodeId = b.last_node_id()
	b.append_node_child(last)


pure func run_r3_w_local(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r3_w_local(b, i)

	b


pure func step_r3_p_read_arg(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	b.append_node_child(b.last_node_id())


pure func run_r3_p_read_arg(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r3_p_read_arg(b, i)

	b


pure func step_r3_p_read_arg_after_node(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	out: DiscoveryBuilder = b.append_node(node_row_at(i))
	out.append_node_child(out.last_node_id())


pure func run_r3_p_read_arg_after_node(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r3_p_read_arg_after_node(b, i)

	b


pure func step_r4_w_named(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	appended: DiscoveryBuilder = b.append_node(node_row_at(i))
	appended.append_node_child(node_id_at_row(0))


pure func run_r4_w_named(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r4_w_named(b, i)

	b


pure func step_r4_p_chain(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	b
		.append_node(node_row_at(i))
		.append_node_child(node_id_at_row(0))


pure func run_r4_p_chain(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r4_p_chain(b, i)

	b


pure func step_r4_p_nested_arg(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	append_node_child(
		append_node(b, node_row_at(i)),
		node_id_at_row(0),
	)


pure func run_r4_p_nested_arg(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r4_p_nested_arg(b, i)

	b


pure func step_r5_w_direct(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = b.append_node(node_row_at(i))

	for k in 0..2:
		out = out.append_node(node_row_at(k))
		out = out.append_node_child(node_id_at_row(k))

	out


pure func run_r5_w_direct(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r5_w_direct(b, i)

	b


pure func step_r5_p_temp(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = b.append_node(node_row_at(i))

	for k in 0..2:
		t: DiscoveryBuilder = out.append_node(node_row_at(k))
		out = t.append_node_child(node_id_at_row(k))

	out


pure func run_r5_p_temp(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r5_p_temp(b, i)

	b


pure func step_r6_w_locals(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	count: Int = b.nodes.length()
	{ b | node_children = b.node_children.append(node_id_at_row(count)) }


pure func run_r6_w_locals(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r6_w_locals(b, i)

	b


pure func step_r6_p_other_field_scalar(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	{ b | node_children = b.node_children.append(node_id_at_row(b.nodes.length())) }


pure func run_r6_p_other_field_scalar(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r6_p_other_field_scalar(b, i)

	b


pure func step_r6_p_two_fields(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	{ b |
		nodes = b.nodes.append(node_row_at(i)),
		node_children = b.node_children.append(node_id_at_row(0))
	}


pure func run_r6_p_two_fields(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r6_p_two_fields(b, i)

	b


pure func step_r6_p_other_field_list(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	{ b |
		node_children = b.node_children.append(node_id_at_row(b.nodes.length())),
		nodes = b.nodes.append(node_row_at(i))
	}


pure func run_r6_p_other_field_list(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r6_p_other_field_list(b, i)

	b


pure func step_r7_p_alias_dead(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	second_name: DiscoveryBuilder = b
	second_name.append_node(node_row_at(i))


pure func run_r7_p_alias_dead(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r7_p_alias_dead(b, i)

	b


pure func step_r7_p_alias_then_update(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = b
	second_name: DiscoveryBuilder = out
	out = second_name.append_node(node_row_at(i))
	out


pure func run_r7_p_alias_then_update(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r7_p_alias_then_update(b, i)

	b


pure func step_r7_p_closure_dead(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	size: pure () -> Int = pure func() -> Int: b.nodes.length()
	n: Int = size()
	b.append_node(node_row_at(n))


pure func run_r7_p_closure_dead(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r7_p_closure_dead(b, i)

	b


pure func step_r7_p_stored_in_record(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	holder: Holder = {
		held = b,
		tag = i
	}
	holder.held.append_node(node_row_at(holder.tag))


pure func run_r7_p_stored_in_record(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r7_p_stored_in_record(b, i)

	b


pure func step_base_plain_tail(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	b.append_node(node_row_at(i))


pure func run_base_plain_tail(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_base_plain_tail(b, i)

	b


pure func step_base_w_out_return(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	out: DiscoveryBuilder = b.append_node(node_row_at(i))
	out


pure func run_base_w_out_return(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_base_w_out_return(b, i)

	b


pure func step_base_w_var_return(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = b
	out = out.append_node(node_row_at(i))
	out


pure func run_base_w_var_return(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_base_w_var_return(b, i)

	b


pure func step_r1_p_cond_reads_builder(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = b

	if b.nodes.length() % 2 == 0:
		out = out.append_node(node_row_at(i))

	out = out.append_node_child(node_id_at_row(0))
	out


pure func run_r1_p_cond_reads_builder(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r1_p_cond_reads_builder(b, i)

	b


pure func step_r1_p_cond_reads_out(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = b

	if out.nodes.length() % 2 == 0:
		out = out.append_node(node_row_at(i))

	out = out.append_node_child(node_id_at_row(0))
	out


pure func run_r1_p_cond_reads_out(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r1_p_cond_reads_out(b, i)

	b


pure func step_r6_p_two_fields_reversed(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	{ b |
		node_children = b.node_children.append(node_id_at_row(0)),
		nodes = b.nodes.append(node_row_at(i))
	}


pure func run_r6_p_two_fields_reversed(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r6_p_two_fields_reversed(b, i)

	b


pure func step_r6_p_scalar_then_list_same_field(b: DiscoveryBuilder, i: Int) -> DiscoveryBuilder:
	{ b | nodes = b.nodes.append(node_row_at(b.nodes.length())) }


pure func run_r6_p_scalar_then_list_same_field(rows: Int) -> DiscoveryBuilder:
	var b: DiscoveryBuilder = empty_discovery_builder()

	for i in 0..rows:
		b = step_r6_p_scalar_then_list_same_field(b, i)

	b


pure func build(shape: String, rows: Int) -> Option[DiscoveryBuilder]:
	match shape:
		"r1_w_helper":
			Some(run_r1_w_helper(rows))
		"r1_p_alias_cond":
			Some(run_r1_p_alias_cond(rows))
		"r1_p_cond_tail":
			Some(run_r1_p_cond_tail(rows))
		"r1_w_loop_first":
			Some(run_r1_w_loop_first(rows))
		"r1_p_loop_first":
			Some(run_r1_p_loop_first(rows))
		"r2_w_assign_return":
			Some(run_r2_w_assign_return(rows))
		"r2_p_tail_after_if":
			Some(run_r2_p_tail_after_if(rows))
		"r2_p_tail_after_loop":
			Some(run_r2_p_tail_after_loop(rows))
		"r3_w_local":
			Some(run_r3_w_local(rows))
		"r3_p_read_arg":
			Some(run_r3_p_read_arg(rows))
		"r3_p_read_arg_after_node":
			Some(run_r3_p_read_arg_after_node(rows))
		"r4_w_named":
			Some(run_r4_w_named(rows))
		"r4_p_chain":
			Some(run_r4_p_chain(rows))
		"r4_p_nested_arg":
			Some(run_r4_p_nested_arg(rows))
		"r5_w_direct":
			Some(run_r5_w_direct(rows))
		"r5_p_temp":
			Some(run_r5_p_temp(rows))
		"r6_w_locals":
			Some(run_r6_w_locals(rows))
		"r6_p_other_field_scalar":
			Some(run_r6_p_other_field_scalar(rows))
		"r6_p_two_fields":
			Some(run_r6_p_two_fields(rows))
		"r6_p_other_field_list":
			Some(run_r6_p_other_field_list(rows))
		"r7_p_alias_dead":
			Some(run_r7_p_alias_dead(rows))
		"r7_p_alias_then_update":
			Some(run_r7_p_alias_then_update(rows))
		"r7_p_closure_dead":
			Some(run_r7_p_closure_dead(rows))
		"r7_p_stored_in_record":
			Some(run_r7_p_stored_in_record(rows))
		"base_plain_tail":
			Some(run_base_plain_tail(rows))
		"base_w_out_return":
			Some(run_base_w_out_return(rows))
		"base_w_var_return":
			Some(run_base_w_var_return(rows))
		"r1_p_cond_reads_builder":
			Some(run_r1_p_cond_reads_builder(rows))
		"r1_p_cond_reads_out":
			Some(run_r1_p_cond_reads_out(rows))
		"r6_p_two_fields_reversed":
			Some(run_r6_p_two_fields_reversed(rows))
		"r6_p_scalar_then_list_same_field":
			Some(run_r6_p_scalar_then_list_same_field(rows))
		_:
			None


func main(args: List[String]) -> Int:
	shape: String = args
		.get(1)
		.get_or("")
	rows: Int = args
		.get(2)
		.get_or("0")
		.parse_int()
		.get_or(0)
	before: MemStats = get_mem_stats()
	built: Option[DiscoveryBuilder] = build(shape, rows)
	after: MemStats = get_mem_stats()

	match built:
		Some(builder):
			print(
				"${shape} rows=${rows} nodes=${builder.nodes.length()} children=${builder.node_children.length()} allocations=${mem_delta(before, after).total_allocations}",
			)
			0
		None:
			print("unknown shape ${shape}")
			2
