-- Prints what the discovery stage reports for each parser fixture named on
-- the command line: the `-- EXPECT-DISCOVERY:` line it would be pinned with
-- (`accepted-by-discovery` when discovery reports nothing), then every
-- diagnostic. Use it to write or refresh a pin, then compare the position with
-- the existing compiler's (`bin/blorp check --no-format <fixture>`).
--
-- Usage: parser_fixture_pin.brp <fixture.brp>...
import:
	../support/parser_fixtures:
		ReportedDiagnostic,
		diagnostic_label,
		diagnostics_listing,
		fixture_text,
		parsed_fixture,
		reported_diagnostics,
	../../../src/compiler_new/stage_01_discovery/discovery_builder: DiscoveryBuilder


---
Position of the first fixture path; position 0 is the program.
---
FIRST_FIXTURE_ARGUMENT: Int = 1


func main(args: List[String]) -> Int:
	for path in args.drop(FIRST_FIXTURE_ARGUMENT):
		builder: DiscoveryBuilder = parsed_fixture(path, fixture_text(path))
		reported: List[ReportedDiagnostic] = builder.reported_diagnostics()

		pin: String = reported
			.get(0)
			.map(diagnostic_label)
			.get_or("accepted-by-discovery")

		print("${path}\t${pin}\t${reported.length()}")

	0
