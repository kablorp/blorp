-- Dumps the discovery stage's view of each file in a list, in the format of
-- `blorp/test/compiler/tools/legacy_front_end_dump.brp`, for the corpus parity
-- check (`scripts/compiler-new-parity`): per file, the lexer's tokens (byte
-- range, kind and text), the lexer's diagnostic count and the parser's
-- diagnostic count (lexer diagnostics included, as the existing parser's are).
-- The parser's count is the accept/reject verdict.
--
-- Each file is lexed, then parsed alone (imports are not followed), with one
-- builder per purpose shared across files, as discovery shares its builder.
--
-- Usage: corpus_dump.brp <file listing one source path per line>
import:
	../../../src/compiler_new/stage_01_discovery/discovery_builder:
		DiscoveryBuilder,
		SourceId,
		empty_discovery_builder,
		next_source_id,
	../../../src/compiler_new/stage_01_discovery/lexer: lex_source
	../../../src/compiler_new/stage_01_discovery/module_walker: load_module
	../../../src/compiler_new/stage_01_discovery/row_kinds:
		ModuleOriginKind(UserModule),
		ModuleReach(RootModule),
	../../../src/compiler_new/stage_01_discovery/source_admission: admit_source
	../../../src/compiler_new/stage_01_discovery/source_provider: PackageMembership(NotInPackage)
	../support/token_dump: token_dump
	system: read_file


---
Position of the file-list argument; position 0 is the program.
---
LIST_ARGUMENT: Int = 1


func read_paths(list_path: String) -> List[String]:
	match read_file(list_path):
		Ok(listing):
			listing
				.lines()
				.filter(pure func(line): not line.is_empty())
		Err(_):
			[]


func main(args: List[String]) -> Int:
	var lexing: DiscoveryBuilder = empty_discovery_builder()
	var parsing: DiscoveryBuilder = empty_discovery_builder()

	for path in read_paths(
		args
			.get(LIST_ARGUMENT)
			.get_or(""),
	):
		match read_file(path):
			Ok(text):
				source: SourceId = lexing.next_source_id()
				lexing = lexing.admit_source(path, text)
				lexer_diagnostics_before: Int = lexing.diagnostics.length()
				lexing = lexing.lex_source(source)
				parse_diagnostics_before: Int = parsing.diagnostics.length()
				parsing = parsing.load_module(
					{
						path = path,
						trusted_directory = ".",
						origin = UserModule,
						package = NotInPackage
					},
					RootModule,
					text,
				)

				print("== ${path}")
				print(lexing.token_dump())
				print("lexer_diagnostics ${lexing.diagnostics.length() - lexer_diagnostics_before}")
				print("parse_diagnostics ${parsing.diagnostics.length() - parse_diagnostics_before}")
			Err(message):
				print("unreadable ${path}: ${message}")

	0
