-- Dumps the discovery stage's view of each file in a list, in the format of
-- `blorp/test/compiler/tools/legacy_front_end_dump.brp`, for the corpus parity
-- check (`scripts/compiler-new-parity`): per file, the lexer's tokens (byte
-- range, kind and text), the lexer's diagnostic count and the parser's
-- diagnostic count (lexer diagnostics included, as the existing parser's are).
-- The parser's count is the accept/reject verdict.
--
-- Each file is lexed, then parsed alone (imports are not followed), with one
-- builder per purpose shared across files, as discovery shares its builder.
--
-- A file the parser rejects also gets its first diagnostic, rendered as a user
-- would see it (`first_diagnostic <line>:<column> <message>`, then
-- `first_help <help>` when there is one). That one is read from a fresh parse
-- of the file alone, frozen, so the text comes from the same tables a later
-- stage would read.
--
-- Usage: corpus_dump.brp <file listing one source path per line>
import:
	../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_source
	../../../src/compiler_new/stage_01_discovery/pipeline: load_module
	../../../src/compiler_new/stage_01_discovery/sources/source_admission: admit_source
	../../../src/compiler_new/stage_01_discovery/sources/source_provider:
		ModulePlacement(InUserCode),
	../../../src/compiler_new/stage_01_discovery/tables/builder:
		DiscoveryBuilder,
		empty_discovery_builder,
		next_source_id,
	../../../src/compiler_new/stage_01_discovery/tables/ids: SourceId
	../../../src/compiler_new/stage_01_discovery/tables/row_kinds:
		ModuleOriginKind(UserModule),
		ModuleReach(RootModule),
	../support/first_diagnostic:
		FrozenDiagnostic,
		diagnostic_column,
		diagnostic_line,
		diagnostic_text,
		first_frozen_diagnostic,
	../support/token_dump: escaped_dump_text, token_dump
	system: read_file


---
Position of the file-list argument; position 0 is the program.
---
LIST_ARGUMENT: Int = 1


func read_paths(list_path: String) -> List[String]:
	match read_file(list_path):
		Ok(listing):
			listing
				.lines()
				.filter(pure func(line): not line.is_empty())
		Err(_):
			[]


---
Prints the first diagnostic of `text` parsed alone as module `path`.
---
func print_first_diagnostic(path: String, text: String):
	alone: DiscoveryBuilder = empty_discovery_builder().load_module(
		{
			path = path,
			trusted_directory = ".",
			placement = InUserCode
		},
		RootModule,
		text,
	)

	match alone.first_frozen_diagnostic():
		Some(found):
			rendered = found.diagnostic_text()
			print("first_diagnostic ${found.diagnostic_line()}:${found.diagnostic_column()} ${escaped_dump_text(rendered.message)}")

			match rendered.help:
				Some(help):
					print("first_help ${escaped_dump_text(help)}")
				None:
					void
		None:
			print("first_diagnostic none")


func main(args: List[String]) -> Int:
	var lexing: DiscoveryBuilder = empty_discovery_builder()
	var parsing: DiscoveryBuilder = empty_discovery_builder()

	for path in read_paths(
		args
			.get(LIST_ARGUMENT)
			.get_or(""),
	):
		match read_file(path):
			Ok(text):
				source: SourceId = lexing.next_source_id()
				lexing = lexing.admit_source(path, text)
				lexer_diagnostics_before: Int = lexing.diagnostics.length()
				lexing = lexing.lex_source(source)
				parse_diagnostics_before: Int = parsing.diagnostics.length()
				parsing = parsing.load_module(
					{
						path = path,
						trusted_directory = ".",
						placement = InUserCode
					},
					RootModule,
					text,
				)

				print("== ${path}")
				print(lexing.token_dump())
				print("lexer_diagnostics ${lexing.diagnostics.length() - lexer_diagnostics_before}")
				print("parse_diagnostics ${parsing.diagnostics.length() - parse_diagnostics_before}")

				if parsing.diagnostics.length() > parse_diagnostics_before:
					print_first_diagnostic(path, text)
			Err(message):
				print("unreadable ${path}: ${message}")

	0
