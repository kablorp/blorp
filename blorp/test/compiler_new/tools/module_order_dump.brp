-- Prints the modules the discovery stage loads for one root, one canonical
-- path per line in module id order, for the module-order check of
-- `scripts/compiler-new-parity`; `legacy_module_order_dump.brp` prints the
-- existing front end's graph for the same root.
--
-- Usage: module_order_dump.brp <compile|test> <root.brp>
--
-- `compile` loads the implicit modules a compile or check loads; `test` also
-- loads the test runtime, as `blorp test` does. Paths are relative to the
-- working directory (run from the repository root).
import:
	../../../src/compiler_new/stage_01_discovery/pipeline:
		ImplicitModules,
		compiler_implicit_modules,
		discover,
		test_implicit_modules,
	../../../src/compiler_new/stage_01_discovery/sources/source_provider:
		FILE_SYSTEM_SOURCE_PROVIDER,
		SourceLookupRoots,
	../../../src/compiler_new/stage_01_discovery/tables/builder: module_id_at_row
	../../../src/compiler_new/stage_01_discovery/tables/frontend_tables:
		FreezeOutcome(FrozenTables, TableInvariantsViolated),
		module_count,
		module_row,
		path_text,


LOOKUP_ROOTS: SourceLookupRoots = {
	standard_library_root = "standard_library/src",
	native_package_roots = ["pkg"]
}

MODE_ARGUMENT: Int = 1

ROOT_ARGUMENT: Int = 2

TEST_MODE: String = "test"

COMPILE_MODE: String = "compile"

EXIT_USAGE: Int = 2

EXIT_INVARIANT_VIOLATION: Int = 3


func main(args: List[String]) -> Int:
	mode: String = args
		.get(MODE_ARGUMENT)
		.get_or("")
	root: String = args
		.get(ROOT_ARGUMENT)
		.get_or("")

	if mode != TEST_MODE and mode != COMPILE_MODE or root == "":
		print("usage: module_order_dump.brp <compile|test> <root.brp>")
		EXIT_USAGE
	else:
		implicit: ImplicitModules = if mode == TEST_MODE:
			test_implicit_modules()
		else:
			compiler_implicit_modules()

		match discover(FILE_SYSTEM_SOURCE_PROVIDER, LOOKUP_ROOTS, [root], implicit):
			FrozenTables(tables):
				for index in 0..module_count(tables):
					print(
						tables.path_text(
							tables.module_row(module_id_at_row(index)).canonical_path,
						),
					)

				0
			TableInvariantsViolated(violations):
				print("table invariants violated: ${violations.length()}")
				EXIT_INVARIANT_VIOLATION
