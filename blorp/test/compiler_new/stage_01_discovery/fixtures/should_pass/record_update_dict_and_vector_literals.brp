-- Braces are a record update, a dict, a vector and a record literal.
record Point {x: Int, y: Int}

func main(args: List[String]) -> Int:
	p: Point = {
		x = 1,
		y = 2
	}
	moved: Point = {p | x = 3}
	counts: Dict[String, Int] = {"a" => 1, "b" => 2}
	vector: Float[#2] = {1.0, 2.0}
	moved.x + counts.length() + vector.length()
