-- EXPECT-BLORP: help: the field was already declared at 8:5; remove one or give it another name
-- EXPECT-BLORP-CONTAINS: :10:5: error:
-- EXPECT-DISCOVERY: DuplicateFieldDiagnostic 10:5
-- The repeat is reported at the later name and the help gives the earlier one's line.
record Person {
    name: String,
    age: Int,
    name: String
}
