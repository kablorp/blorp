-- String patterns in each spelling: plain, raw, pipe and raw pipe. A pipe
-- pattern runs to the end of its line, so only inside parentheses can a colon
-- follow it.
func classify(text: String) -> Int:
	match text:
		"hello":
			1
		raw"c:\dir":
			2
		_:
			3

func classify_lines(text: Option[String]) -> Int:
	match text:
		Some(
			|first line
			|second line
		):
			1
		Some(
			raw
			|\d+
			|${literal}
		):
			2
		_:
			3
