-- Assignment, compound assignment, `?=` and binding are statements: a
-- statement in a block, or the body of a match arm.
func update(xs: List[Int], found: Option[Int]) -> Int:
	var total: Int = 0
	var items: List[Int] = xs
	total = 1
	total += 2
	total -= 1
	total *= 3
	total /= 2
	items[0] = total
	n: Int ?= found
	match found:
		Some(value):
			total = value
		None:
			total += 1
	total + n
