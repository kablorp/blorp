-- Body parser behaviour: each case parses one module and compares its body
-- trees and diagnostics, then checks that the tables freeze with every
-- invariant. The expectations were checked against the existing parser:
-- every case it accepts is accepted here, and the malformed case reports the
-- diagnostics it reports.
import:
	../../../../src/compiler_new/stage_01_discovery/pipeline: load_module
	../../../../src/compiler_new/stage_01_discovery/sources/source_provider:
		ModulePlacement(InUserCode),
	../../../../src/compiler_new/stage_01_discovery/tables/builder:
		DiscoveryBuilder,
		empty_discovery_builder,
	../../../../src/compiler_new/stage_01_discovery/tables/diagnostic_code: syntax_diagnostic_name
	../../../../src/compiler_new/stage_01_discovery/tables/frontend_tables:
		FreezeOutcome(FrozenTables, TableInvariantsViolated),
		concurrency_count,
		freeze,
		node_count,
		node_row_at,
	../../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_index, node_id_at_row
	../../../../src/compiler_new/stage_01_discovery/tables/row_kinds:
		DefinitionKind(LocalFunctionDefinition),
		ModuleOriginKind(UserModule),
		ModuleReach(ImportedModule, RootModule),
		NodeKind(
			ConcurrentParameterNode, MissingExpressionNode, MissingPatternNode, MissingTypeNode,
		),
	../../../../src/compiler_new/stage_01_discovery/tables/span: span_end, span_start
	../../support/body_dump: bodies_dump
	test: TestSuite


---
`$` then `{`: spelled apart so the test sources can hold interpolation holes
without opening one here.
---
INTERPOLATION_OPENER: String = "$" + "{"


pure func parsed(text: String) -> DiscoveryBuilder:
	load_module(
		empty_discovery_builder(),
		{
			path = "case.brp",
			trusted_directory = ".",
			placement = InUserCode
		},
		RootModule,
		text,
	)


---
Whether `text` parses to the `expected` body trees and diagnostic lines and
its tables freeze with every invariant.
---
pure func bodies_are(text: String, expected: List[String]) -> Bool:
	builder: DiscoveryBuilder = parsed(text)
	var lines: List[String] = builder.bodies_dump()

	for row in builder.diagnostics:
		lines = lines.append(
			"diagnostic ${row.diagnostic.syntax_diagnostic_name()}@${row.span.span_start()}",
		)

	lines.join("\n") == expected.join("\n") and builder.freezes_with_invariants()


pure func freezes_with_invariants(builder: DiscoveryBuilder) -> Bool:
	match builder.freeze():
		FrozenTables(_):
			True
		TableInvariantsViolated(_):
			False


pure func test_binary_operators_nest_by_precedence() -> Bool:
	bodies_are(
		"func f(a, b, c, d, e, g):\n\tx = a + b * c == d and not e or g\n\ty = -a..b % 2\n",
		[
			"f = (BlockNode (AssignmentNode x (OrNode (AndNode (EqualNode (AddNode (IdentifierNode a) (MultiplyNode (IdentifierNode b) (IdentifierNode c))) (IdentifierNode d)) (NotNode (IdentifierNode e))) (IdentifierNode g))) (AssignmentNode y (RangeNode (NegateNode (IdentifierNode a)) (ModuloNode (IdentifierNode b) (IntegerLiteralNode \"2\")))))",
		],
	)


pure func test_type_ascription_is_reported_and_skipped_without_a_node() -> Bool:
	bodies_are(
		"func f(x, xs):\n\ta = x + 1 as Int\n\tb = xs.get(0 as List[Int], 1)\n\tc = 2\n",
		[
			"f = (BlockNode (AssignmentNode a (AddNode (IdentifierNode x) (IntegerLiteralNode \"1\"))) (AssignmentNode b (CallNode (FieldAccessNode get (IdentifierNode xs)) (IntegerLiteralNode \"0\") (IntegerLiteralNode \"1\"))) (AssignmentNode c (IntegerLiteralNode \"2\")))",
			"diagnostic RemovedTypeAscriptionDiagnostic@26",
			"diagnostic RemovedTypeAscriptionDiagnostic@47",
		],
	)


pure func test_type_ascription_in_braces_and_without_a_type_reports_once() -> Bool:
	bodies_are(
		"func f(x):\n\ta = {x as Int}\n\tb = x as\n\tc = 2\n",
		[
			"f = (BlockNode (AssignmentNode a (VectorLiteralNode (IdentifierNode x))) (AssignmentNode b (IdentifierNode x)) (AssignmentNode c (IntegerLiteralNode \"2\")))",
			"diagnostic RemovedTypeAscriptionDiagnostic@19",
			"diagnostic RemovedTypeAscriptionDiagnostic@34",
		],
	)


pure func test_postfix_chains_calls_lambdas_and_leading_dot_continuations() -> Bool:
	bodies_are(
		"func f(xs, d):\n\ta = xs.map(func(x): x + 1).filter(pure func(x: Int) -> Bool: x > 0)[0]\n\tb = d\n\t\t.get(\"k\")\n\t\t.get_or(0)\n\tc = xs.length() + d\n\t\t.size()\n\tc\n",
		[
			"f = (BlockNode (AssignmentNode a (SubscriptNode (CallNode (FieldAccessNode filter (CallNode (FieldAccessNode map (IdentifierNode xs)) (LambdaNode (LambdaParameterNode x) (AddNode (IdentifierNode x) (IntegerLiteralNode \"1\"))))) (PureLambdaNode (LambdaParameterNode x (NamedTypeNode Int)) (NamedTypeNode Bool) (GreaterNode (IdentifierNode x) (IntegerLiteralNode \"0\")))) (IntegerLiteralNode \"0\"))) (AssignmentNode b (CallNode (FieldAccessNode get_or (CallNode (FieldAccessNode get (IdentifierNode d)) (StringLiteralNode \"k\"))) (IntegerLiteralNode \"0\"))) (AssignmentNode c (AddNode (CallNode (FieldAccessNode length (IdentifierNode xs))) (CallNode (FieldAccessNode size (IdentifierNode d))))) (IdentifierNode c))",
		],
	)


pure func test_statements_bind_assign_and_destructure() -> Bool:
	bodies_are(
		"func f(xs):\n\tvar total: Int = 0\n\tlimit: Int = 10\n\ttotal += 1\n\ttotal -= 2\n\ttotal *= 3\n\ttotal /= 4\n\titem ?= xs.first()\n\ttyped: Int ?= xs.last()\n\txs[0] = 5\n\t(a, _) = pair\n\tvar later =\n\t\tcompute()\n\ttotal\n",
		[
			"f = (BlockNode (VarDeclarationNode total (NamedTypeNode Int) (IntegerLiteralNode \"0\")) (TypedBindingNode limit (NamedTypeNode Int) (IntegerLiteralNode \"10\")) (AddAssignNode total (IntegerLiteralNode \"1\")) (SubtractAssignNode total (IntegerLiteralNode \"2\")) (MultiplyAssignNode total (IntegerLiteralNode \"3\")) (DivideAssignNode total (IntegerLiteralNode \"4\")) (QuestionBindNode item (CallNode (FieldAccessNode first (IdentifierNode xs)))) (QuestionBindNode typed (NamedTypeNode Int) (CallNode (FieldAccessNode last (IdentifierNode xs)))) (SubscriptAssignmentNode (SubscriptNode (IdentifierNode xs) (IntegerLiteralNode \"0\")) (IntegerLiteralNode \"5\")) (TupleDestructureNode (DestructureBinderNode a) (DestructureBinderNode _) (IdentifierNode pair)) (VarDeclarationNode later (CallNode (IdentifierNode compute))) (IdentifierNode total))",
		],
	)


pure func test_control_flow_constructs_and_match_patterns() -> Bool:
	bodies_are(
		"func f(xs, ch, n):\n\tif n > 0:\n\t\t1\n\telse if n < 0:\n\t\t2\n\telse:\n\t\t3\n\twhile n > 0:\n\t\tbreak\n\tfor (i, x) in xs:\n\t\tcontinue\n\tmatch n:\n\t\t0 | 1:\n\t\t\t\"small\"\n\t\tShape.Circle(r):\n\t\t\tr\n\t\tSome([first, ...rest]):\n\t\t\tfirst\n\t\t(a, -1):\n\t\t\ta\n\t\t_: \"other\"\n\tselect:\n\t\tmsg from ch:\n\t\t\tmsg\n\t\tsealed ch:\n\t\t\t0\n\t\t_ after 5:\n\t\t\t1\n\twith file ?= open(\"x\") on e => wrap(e):\n\t\tfile.read()\n\tconcurrent(max_threads: 2):\n\t\twork()\n\tfor item in xs concurrently(limit: 4):\n\t\titem\n\tdebug:\n\t\tlog(n)\n",
		[
			"f = (BlockNode (IfNode (GreaterNode (IdentifierNode n) (IntegerLiteralNode \"0\")) (BlockNode (IntegerLiteralNode \"1\")) (IfNode (LessNode (IdentifierNode n) (IntegerLiteralNode \"0\")) (BlockNode (IntegerLiteralNode \"2\")) (BlockNode (IntegerLiteralNode \"3\")))) (WhileNode (GreaterNode (IdentifierNode n) (IntegerLiteralNode \"0\")) (BlockNode (BreakNode))) (ForNode (TupleLoopBinderNode (LoopBinderNode i) (LoopBinderNode x)) (IdentifierNode xs) (BlockNode (ContinueNode))) (MatchNode (IdentifierNode n) (MatchCaseNode (OrPatternNode (IntegerPatternNode \"0\") (IntegerPatternNode \"1\")) (BlockNode (StringLiteralNode \"small\"))) (MatchCaseNode (QualifiedConstructorPatternNode Circle (PatternQualifierNode Shape) (NamePatternNode r)) (BlockNode (IdentifierNode r))) (MatchCaseNode (ConstructorPatternNode Some (ListPatternNode (NamePatternNode first) (ListSpreadNameNode rest))) (BlockNode (IdentifierNode first))) (MatchCaseNode (TuplePatternNode (NamePatternNode a) (NegativeIntegerPatternNode \"1\")) (BlockNode (IdentifierNode a))) (MatchCaseNode (WildcardPatternNode) (StringLiteralNode \"other\"))) (SelectNode (SelectReceiveArmNode msg (IdentifierNode ch) (BlockNode (IdentifierNode msg))) (SelectSealedArmNode (IdentifierNode ch) (BlockNode (IntegerLiteralNode \"0\"))) (SelectAfterArmNode (IntegerLiteralNode \"5\") (BlockNode (IntegerLiteralNode \"1\")))) (WithNode (WithTryBindingNode file (CallNode (IdentifierNode open) (StringLiteralNode \"x\")) (WithErrorMapNode e (CallNode (IdentifierNode wrap) (IdentifierNode e)))) (BlockNode (CallNode (FieldAccessNode read (IdentifierNode file))))) (ConcurrentBlockNode (ConcurrentParameterNode max_threads (IntegerLiteralNode \"2\")) (BlockNode (CallNode (IdentifierNode work)))) (ConcurrentForNode (LoopBinderNode item) (IdentifierNode xs) (ConcurrentParameterNode limit (IntegerLiteralNode \"4\")) (BlockNode (IdentifierNode item))) (DebugBlockNode (BlockNode (CallNode (IdentifierNode log) (IdentifierNode n)))))",
		],
	)


pure func test_literals_brackets_conversions_builtins_and_interpolation() -> Bool:
	bodies_are(
		"func f(r, k, v):\n\tl = [1, 2.5, \"s\", 'c', True, False]\n\tt = (1, 2)\n\tg = (1)\n\trec = {name = \"n\", age = 3}\n\tup = {r | age = 4}\n\td = {k => v, \"a\" => 1}\n\tvec = {1, 2}\n\tempty = {}\n\tu = ()\n\to = into_opaque Email(v)\n\tp = from_opaque Email(o)\n\ts = \"a " + INTERPOLATION_OPENER + "k + 1} b " + INTERPOLATION_OPENER + "v.name}\"\n\tq = raw\"x\\y\"\n\tvoid\n\n\nfunc g() -> Int: builtin(\"helper\")\n\n\nfunc h(): builtin\n",
		[
			"f = (BlockNode (AssignmentNode l (ListLiteralNode (IntegerLiteralNode \"1\") (FloatLiteralNode \"2.5\") (StringLiteralNode \"s\") (CharLiteralNode '99') (TrueLiteralNode) (FalseLiteralNode))) (AssignmentNode t (TupleNode (IntegerLiteralNode \"1\") (IntegerLiteralNode \"2\"))) (AssignmentNode g (IntegerLiteralNode \"1\")) (AssignmentNode rec (RecordLiteralNode (RecordFieldNode name (StringLiteralNode \"n\")) (RecordFieldNode age (IntegerLiteralNode \"3\")))) (AssignmentNode up (RecordUpdateNode (IdentifierNode r) (RecordFieldNode age (IntegerLiteralNode \"4\")))) (AssignmentNode d (DictLiteralNode (DictEntryNode (IdentifierNode k) (IdentifierNode v)) (DictEntryNode (StringLiteralNode \"a\") (IntegerLiteralNode \"1\")))) (AssignmentNode vec (VectorLiteralNode (IntegerLiteralNode \"1\") (IntegerLiteralNode \"2\"))) (AssignmentNode empty (RecordLiteralNode)) (AssignmentNode u (VoidNode)) (AssignmentNode o (IntoOpaqueNode (NamedTypeNode Email) (IdentifierNode v))) (AssignmentNode p (FromOpaqueNode (NamedTypeNode Email) (IdentifierNode o))) (AssignmentNode s (InterpolatedStringNode (InterpolationTextNode \"a \") (InterpolationHoleNode (AddNode (IdentifierNode k) (IntegerLiteralNode \"1\"))) (InterpolationTextNode \" b \") (InterpolationHoleNode (FieldAccessNode name (IdentifierNode v))))) (AssignmentNode q (RawStringLiteralNode \"x\\y\")) (VoidNode))",
			"g = (NamedBuiltinNode \"helper\")",
			"h = (BuiltinNode)",
		],
	)


pure func test_lambda_blocks_and_anchored_if_and_match_values() -> Bool:
	bodies_are(
		"func f(xs, n):\n\ttotal = xs.fold(0, func(acc, x):\n\t\tnext = acc + x\n\t\tnext\n\t)\n\tpick = if n > 0:\n\t\t\"positive\"\n\telse:\n\t\t\"other\"\n\tkind = match n:\n\t\t0: \"zero\"\n\t\t_: if n > 10:\n\t\t\t\"big\"\n\t\telse:\n\t\t\t\"small\"\n\ttotal\n",
		[
			"f = (BlockNode (AssignmentNode total (CallNode (FieldAccessNode fold (IdentifierNode xs)) (IntegerLiteralNode \"0\") (LambdaNode (LambdaParameterNode acc) (LambdaParameterNode x) (BlockNode (AssignmentNode next (AddNode (IdentifierNode acc) (IdentifierNode x))) (IdentifierNode next))))) (AssignmentNode pick (IfNode (GreaterNode (IdentifierNode n) (IntegerLiteralNode \"0\")) (BlockNode (StringLiteralNode \"positive\")) (BlockNode (StringLiteralNode \"other\")))) (AssignmentNode kind (MatchNode (IdentifierNode n) (MatchCaseNode (IntegerPatternNode \"0\") (StringLiteralNode \"zero\")) (MatchCaseNode (WildcardPatternNode) (IfNode (GreaterNode (IdentifierNode n) (IntegerLiteralNode \"10\")) (BlockNode (StringLiteralNode \"big\")) (BlockNode (StringLiteralNode \"small\")))))) (IdentifierNode total))",
		],
	)


pure func test_interpolation_holes_are_parsed_as_nested_expressions() -> Bool:
	bodies_are(
		"func f(user, items):\n\ta = \"name: " + INTERPOLATION_OPENER + "user.name}, count: " + INTERPOLATION_OPENER + "items.length() + 1}, nested: " + INTERPOLATION_OPENER + "\"" + INTERPOLATION_OPENER + "user.id}\"}\"\n\tb = \"{kept} tab\\t" + INTERPOLATION_OPENER + "user}\\{\"\n\tc =\n\t\t|first " + INTERPOLATION_OPENER + "user}\n\t\t||second " + INTERPOLATION_OPENER + "items}!\n\ta\n",
		[
			"f = (BlockNode (AssignmentNode a (InterpolatedStringNode (InterpolationTextNode \"name: \") (InterpolationHoleNode (FieldAccessNode name (IdentifierNode user))) (InterpolationTextNode \", count: \") (InterpolationHoleNode (AddNode (CallNode (FieldAccessNode length (IdentifierNode items))) (IntegerLiteralNode \"1\"))) (InterpolationTextNode \", nested: \") (InterpolationHoleNode (InterpolatedStringNode (InterpolationHoleNode (FieldAccessNode id (IdentifierNode user))))))) (AssignmentNode b (InterpolatedStringNode (InterpolationTextNode \"{kept} tab\t\") (InterpolationHoleNode (IdentifierNode user)) (InterpolationTextNode \"{\"))) (AssignmentNode c (InterpolatedPipeStringNode (InterpolationTextNode \"first \") (InterpolationHoleNode (IdentifierNode user)) (InterpolationTextNode \"",
			"|second \") (InterpolationHoleNode (IdentifierNode items)) (InterpolationTextNode \"!\"))) (IdentifierNode a))",
		],
	)


---
The counts the concurrency parameters of `text` write, in node order, as the
frozen tables read them from each parameter's value.
---
pure func concurrency_counts_of(text: String) -> List[Int]:
	match parsed(text).freeze():
		FrozenTables(tables):
			var counts: List[Int] = []

			for index in 0..tables.node_count():
				match tables.node_row_at(index):
					Some(row):
						if row.kind == ConcurrentParameterNode:
							match tables.concurrency_count(node_id_at_row(index)):
								Some(count):
									counts = counts.append(count)
								None:
									void
					None:
						void

			counts
		TableInvariantsViolated(_):
			[]


pure func test_concurrency_counts_are_kept_as_integers() -> Bool:
	-- Decimal digits only: `0x4` and `1_000` are not integer literals in either
	-- lexer. Leading zeros read as the number, and a literal above `Int` saturates
	-- as `parse_int` does. `timeout: 5` reads as 5 too: a parameter's count is the
	-- integer its value writes, and only `max_threads` and `limit` are asked.
	text: String = "func f(xs):\n\tconcurrent(max_threads: 007, timeout: 5):\n\t\twork()\n\tfor x in xs concurrently(limit: 99999999999999999999):\n\t\twork(x)\n"
	counts: List[Int] = concurrency_counts_of(text)
	counts == [7, 5, 9223372036854775807] and parsed(text).diagnostics.is_empty()


pure func test_a_count_that_is_not_a_positive_literal_is_none() -> Bool:
	text: String = "func f():\n\tconcurrent(max_threads: 0):\n\t\twork()\n\tconcurrent(max_threads: 1 + 1):\n\t\twork()\n"
	concurrency_counts_of(text).is_empty() and parsed(text).diagnostics.length() == 2


pure func test_string_patterns_keep_the_form_they_were_written_in() -> Bool:
	bodies_are(
		"func f(x):\n\tmatch x:\n\t\t\"plain\":\n\t\t\t1\n\t\traw\"raw\\n\":\n\t\t\t2\n\t\t_:\n\t\t\t3\n",
		[
			"f = (BlockNode (MatchNode (IdentifierNode x) (MatchCaseNode (StringPatternNode \"plain\") (BlockNode (IntegerLiteralNode \"1\"))) (MatchCaseNode (RawStringPatternNode \"raw\\n\") (BlockNode (IntegerLiteralNode \"2\"))) (MatchCaseNode (WildcardPatternNode) (BlockNode (IntegerLiteralNode \"3\")))))",
		],
	)


pure func test_holes_nest_to_any_depth_and_a_brace_in_a_nested_string_closes_nothing() -> Bool:
	opener: String = INTERPOLATION_OPENER
	four_levels: String = "p " + opener + "f(\"q " + opener + "g(\"r " + opener + "i(\"s " + opener + "h}\")} t\")} u\")} v"
	braced: String = "p " + opener + "f(\"q " + opener + "g(\"}\")} r\")} s"
	(
		bodies_are(
			"func f(h):\n\tx = \"" + four_levels + "\"\n",
			[
				"f = (BlockNode (AssignmentNode x (InterpolatedStringNode (InterpolationTextNode \"p \") (InterpolationHoleNode (CallNode (IdentifierNode f) (InterpolatedStringNode (InterpolationTextNode \"q \") (InterpolationHoleNode (CallNode (IdentifierNode g) (InterpolatedStringNode (InterpolationTextNode \"r \") (InterpolationHoleNode (CallNode (IdentifierNode i) (InterpolatedStringNode (InterpolationTextNode \"s \") (InterpolationHoleNode (IdentifierNode h))))) (InterpolationTextNode \" t\")))) (InterpolationTextNode \" u\")))) (InterpolationTextNode \" v\"))))",
			],
		)
		and bodies_are(
			"func f(h):\n\tx = \"" + braced + "\"\n",
			[
				"f = (BlockNode (AssignmentNode x (InterpolatedStringNode (InterpolationTextNode \"p \") (InterpolationHoleNode (CallNode (IdentifierNode f) (InterpolatedStringNode (InterpolationTextNode \"q \") (InterpolationHoleNode (CallNode (IdentifierNode g) (StringLiteralNode \"}\"))) (InterpolationTextNode \" r\")))) (InterpolationTextNode \" s\"))))",
			],
		)
	)


pure func test_a_char_literal_in_a_hole_is_opaque_to_the_hole_scan() -> Bool:
	-- The language lets a hole hold any expression, so a char literal whose
	-- character is `}`, `"`, `$` or `\\` is one token of the hole's code; the
	-- existing lexer rejects these, so there is no parity to keep.
	opener: String = INTERPOLATION_OPENER
	(
		bodies_are(
			"func f():\n\tx = \"a " + opener + "'}'} b\"\n",
			[
				"f = (BlockNode (AssignmentNode x (InterpolatedStringNode (InterpolationTextNode \"a \") (InterpolationHoleNode (CharLiteralNode '125')) (InterpolationTextNode \" b\"))))",
			],
		)
		and bodies_are(
			"func f():\n\tx = \"a " + opener + "'\\\"'} b\"\n",
			[
				"f = (BlockNode (AssignmentNode x (InterpolatedStringNode (InterpolationTextNode \"a \") (InterpolationHoleNode (CharLiteralNode '34')) (InterpolationTextNode \" b\"))))",
			],
		)
		and bodies_are(
			"func f():\n\tx = \"a " + opener + "'$'} b\"\n",
			[
				"f = (BlockNode (AssignmentNode x (InterpolatedStringNode (InterpolationTextNode \"a \") (InterpolationHoleNode (CharLiteralNode '36')) (InterpolationTextNode \" b\"))))",
			],
		)
		and bodies_are(
			"func f():\n\tx = \"a " + opener + "'\\\\'} b\"\n",
			[
				"f = (BlockNode (AssignmentNode x (InterpolatedStringNode (InterpolationTextNode \"a \") (InterpolationHoleNode (CharLiteralNode '92')) (InterpolationTextNode \" b\"))))",
			],
		)
		and bodies_are(
			"func f():\n\tx = \"a " + opener + "'\\u{7d}'} b\"\n",
			[
				"f = (BlockNode (AssignmentNode x (InterpolatedStringNode (InterpolationTextNode \"a \") (InterpolationHoleNode (CharLiteralNode '125')) (InterpolationTextNode \" b\"))))",
			],
		)
	)


pure func test_an_unterminated_char_literal_in_a_hole_reports_the_string_and_recovers() -> Bool:
	-- `'}` is no char literal (no closing quote), so the hole never closes and
	-- its scan reaches the line break (byte 25): the string is reported as
	-- crossing a line there. Lexing resumes after the break, as the existing
	-- lexer resumes, so the failed string yields no token and `y = 1` is read
	-- as the value of `x =`: the tree shows it, and only one diagnostic is made.
	opener: String = INTERPOLATION_OPENER
	bodies_are(
		"func f():\n\tx = \"a " + opener + "'} b\"\n\ty = 1\n",
		[
			"f = (BlockNode (AssignmentNode x (AssignmentNode y (IntegerLiteralNode \"1\"))))",
			"diagnostic MultilineInterpolatedStringDiagnostic@25",
		],
	)


pure func test_an_unknown_escape_after_a_hole_keeps_its_pair_as_text() -> Bool:
	-- As the existing lexer keeps the pair, `\$` before `{` opens no hole: the
	-- text after the first hole is `\${b}` and a `\u{41}` is decoded.
	bodies_are(
		"func f(d):\n\ta = \"" + INTERPOLATION_OPENER + "d} \\" + INTERPOLATION_OPENER + "b} \\u{41}\"\n",
		[
			"f = (BlockNode (AssignmentNode a (InterpolatedStringNode (InterpolationHoleNode (IdentifierNode d)) (InterpolationTextNode \" \\" + INTERPOLATION_OPENER + "b} A\"))))",
		],
	)


pure func test_local_functions_global_values_and_trait_default_bodies_get_body_rows() -> Bool:
	bodies_are(
		"func outer(n):\n\tpure func inner(x: Int) -> Int:\n\t\tx * 2\n\tfunc other(y):\n\t\ty\n\tinner(n) + other(n)\n\n\nlimit: Int = 3 + 4\n\n\ntrait Show:\n\tfunc show(x: Self) -> String:\n\t\t\"shown\"\n",
		[
			"inner = (BlockNode (MultiplyNode (IdentifierNode x) (IntegerLiteralNode \"2\")))",
			"other = (BlockNode (IdentifierNode y))",
			(
				"outer = (BlockNode (LocalFunctionNode def1) (LocalFunctionNode def2) (AddNode "
				+ "(CallNode (IdentifierNode inner) (IdentifierNode n)) (CallNode (IdentifierNode "
				+ "other) (IdentifierNode n))))"
			),
			"limit = (AddNode (IntegerLiteralNode \"3\") (IntegerLiteralNode \"4\"))",
			"show = (BlockNode (StringLiteralNode \"shown\"))",
		],
	)


pure func test_named_arguments_are_assignments_inside_a_call() -> Bool:
	bodies_are(
		"func g(xs):\n\tf(a = 1, xs)\n",
		[
			"g = (BlockNode (CallNode (IdentifierNode f) (AssignmentNode a (IntegerLiteralNode \"1\")) (IdentifierNode xs)))",
		],
	)


pure func test_malformed_bodies_are_reported_with_coded_diagnostics() -> Bool:
	bodies_are(
		"func f(x):\n\ta = )\n\t_ ?= x\n\tx.field = 1\n\ts = \"" + INTERPOLATION_OPENER + "a b}\"\n\tmatch x:\n\t\t-foo: 1\n\twith a = x, b = x:\n\t\ta\n",
		[
			"f = (BlockNode (AssignmentNode a (MissingExpressionNode)) (MissingExpressionNode) (MissingExpressionNode) (QuestionBindNode _ (IdentifierNode x)) (MissingExpressionNode (FieldAccessNode field (IdentifierNode x)) (IntegerLiteralNode \"1\")) (AssignmentNode s (InterpolatedStringNode (InterpolationHoleNode (IdentifierNode a)))) (MatchNode (IdentifierNode x) (MatchCaseNode (MissingPatternNode) (IdentifierNode foo)) (MatchCaseNode (MissingPatternNode) (IntegerLiteralNode \"1\"))) (WithNode (WithBindingNode a (IdentifierNode x)) (BlockNode (IdentifierNode a))))",
			"diagnostic ExpectedExpressionDiagnostic@16",
			"diagnostic ExpectedExpressionDiagnostic@16",
			"diagnostic ExpectedExpressionDiagnostic@19",
			"diagnostic DiscardedQuestionBindDiagnostic@19",
			"diagnostic FieldAssignmentDiagnostic@27",
			"diagnostic InterpolationHoleNotExpressionDiagnostic@49",
			"diagnostic ExpectedNumberAfterMinusDiagnostic@65",
			"diagnostic ExpectedColonDiagnostic@66",
			"diagnostic ExpectedPatternDiagnostic@69",
			"diagnostic WithMultipleBindingsDiagnostic@84",
		],
	)


---
Whether `text` reports exactly the `expected` diagnostic lines and its tables
freeze with every invariant.
---
pure func diagnostics_are(text: String, expected: List[String]) -> Bool:
	builder: DiscoveryBuilder = parsed(text)
	var lines: List[String] = []

	for row in builder.diagnostics:
		lines = lines.append(
			"diagnostic ${row.diagnostic.syntax_diagnostic_name()}@${row.span.span_start()}",
		)

	lines.join("\n") == expected.join("\n") and builder.freezes_with_invariants()


pure func test_question_bind_in_a_loop_body_is_reported_at_the_operator() -> Bool:
	(
		diagnostics_are(
			"func f(xs):\n\twhile ready:\n\t\tv ?= xs\n\t\tv\n",
			["diagnostic QuestionBindInLoopDiagnostic@30"],
		)
		and diagnostics_are(
			"func f(xs):\n\tfor x in xs:\n\t\tif x:\n\t\t\tv ?= xs\n\t\t\tv\n",
			["diagnostic QuestionBindInLoopDiagnostic@39"],
		)
		and diagnostics_are(
			"func f(xs):\n\tfor x in xs concurrently(limit: 2):\n\t\tv ?= xs\n\t\tv\n",
			["diagnostic QuestionBindInLoopDiagnostic@53"],
		)
	)


pure func test_question_bind_outside_a_loop_body_is_accepted() -> Bool:
	(
		diagnostics_are("func f(xs):\n\tv ?= xs\n\tfor x in xs:\n\t\tx\n\tv\n", [])
		and diagnostics_are("func f(xs):\n\tfor x in xs:\n\t\tx\n\tv ?= xs\n\tv\n", [])
		and diagnostics_are(
			"func f(xs):\n\twhile ready:\n\t\tfunc g():\n\t\t\tv ?= xs\n\t\t\tv\n\t\tg()\n",
			[],
		)
	)


pure func test_break_and_continue_outside_a_loop_body_are_reported_at_the_keyword() -> Bool:
	(
		diagnostics_are("func f():\n\tbreak\n", ["diagnostic BreakOutsideLoopDiagnostic@11"])
		and diagnostics_are(
			"func f(xs):\n\tfor x in xs:\n\t\tx\n\tcontinue\n",
			["diagnostic ContinueOutsideLoopDiagnostic@31"],
		)
		and diagnostics_are(
			"func f(xs):\n\twhile ready:\n\t\tfunc g():\n\t\t\tbreak\n\t\tg()\n",
			["diagnostic BreakOutsideLoopDiagnostic@41"],
		)
	)


pure func test_break_and_continue_inside_a_loop_body_are_accepted() -> Bool:
	(
		diagnostics_are(
			"func f(xs):\n\twhile ready:\n\t\tif stop:\n\t\t\tbreak\n\t\tcontinue\n\tfor x in xs concurrently(limit: 2):\n\t\tbreak\n",
			[],
		)
		and diagnostics_are(
			"func f(xs):\n\tfor x in xs:\n\t\twhile ready:\n\t\t\tbreak\n\t\tcontinue\n\tx\n",
			[],
		)
	)


pure func test_lambda_and_concurrent_task_bodies_start_outside_every_loop() -> Bool:
	(
		diagnostics_are(
			"func f(xs):\n\tfor x in xs:\n\t\tg = func(y):\n\t\t\tbreak\n\t\tg(x)\n",
			["diagnostic BreakOutsideLoopDiagnostic@44"],
		)
		and diagnostics_are(
			"func f(xs):\n\twhile ready:\n\t\tconcurrent:\n\t\t\ta = continue\n",
			["diagnostic ContinueOutsideLoopDiagnostic@47"],
		)
		and diagnostics_are(
			"func f(xs):\n\tfor x in xs:\n\t\tg = func(y):\n\t\t\tv ?= y\n\t\t\tv\n\t\tg(x)\n",
			[],
		)
		and diagnostics_are(
			"func f(xs):\n\tfor x in xs:\n\t\tg = func(y):\n\t\t\tfor z in y:\n\t\t\t\tbreak\n\t\t\ty\n\t\tg(x)\n\t\tcontinue\n",
			[],
		)
	)


pure func test_loop_context_belongs_to_the_enclosing_body_after_a_nested_body() -> Bool:
	(
		diagnostics_are(
			"func f(xs):\n\tfor x in xs:\n\t\tconcurrent:\n\t\t\ta = 1\n\t\tg = func(y): y\n\t\tbreak\n",
			[],
		)
		and diagnostics_are(
			"func f(xs):\n\tfor x in xs:\n\t\tx\n\tg = func(y): y\n\tbreak\n",
			["diagnostic BreakOutsideLoopDiagnostic@47"],
		)
	)


pure func local_function_modules(builder: DiscoveryBuilder) -> List[Int]:
	var modules: List[Int] = []

	for row in builder.definitions:
		match row.kind:
			LocalFunctionDefinition:
				modules = modules.append(row.module.module_id_index())
			_:
				modules = modules

	modules


pure func test_a_local_function_belongs_to_the_module_that_holds_it() -> Bool:
	first: DiscoveryBuilder = parsed("func f():\n\tfunc g():\n\t\t0\n\tg()\n")
	second: DiscoveryBuilder = load_module(
		first,
		{
			path = "second.brp",
			trusted_directory = ".",
			placement = InUserCode
		},
		ImportedModule,
		"func h(xs):\n\tfor x in xs:\n\t\tk = func(y):\n\t\t\tfunc m():\n\t\t\t\t1\n\t\t\tm()\n\t\tk(x)\n",
	)

	second.local_function_modules() == [0, 1]


---
The diagnostic names a recovery node of `kind` may be linked to: the codes the
parser reports when it records that kind of node.
---
pure func recovery_diagnostic_names(kind: NodeKind) -> List[String]:
	match kind:
		MissingExpressionNode:
			[
				"ExpectedExpressionDiagnostic",
				"ExpectedAssignmentOperatorDiagnostic",
				"FieldAssignmentDiagnostic",
			]
		MissingPatternNode:
			[
				"ExpectedPatternDiagnostic",
				"InterpolatedStringPatternDiagnostic",
				"ExpectedNumberAfterMinusDiagnostic",
			]
		MissingTypeNode:
			["ExpectedTypeDiagnostic", "ExpectedDimensionDiagnostic"]
		_:
			[]


---
Whether every recovery node of `text` is linked to a diagnostic of a code its
kind is reported with, and every such diagnostic is linked once.
---
pure func recovery_nodes_link_to_their_diagnostics(text: String) -> Bool:
	builder: DiscoveryBuilder = parsed(text)
	var linked: List[Int] = []
	var all_match: Bool = True

	for node in builder.nodes:
		allowed: List[String] = recovery_diagnostic_names(node.kind)

		if not allowed.is_empty():
			match builder.diagnostics.get(node.payload):
				Some(row):
					name: String = row.diagnostic.syntax_diagnostic_name()
					all_match = all_match and allowed.contains(name)
					linked = linked.append(node.payload)
				None:
					all_match = False

	(
		all_match
		and not linked.is_empty()
		and linked
			.unique()
			.length() == linked.length()
	)


pure func test_recovery_nodes_are_linked_to_their_diagnostics() -> Bool:
	(
		recovery_nodes_link_to_their_diagnostics(
			"func f(x):\n\ta = )\n\t_ ?= x\n\tx.field = 1\n\tmatch x:\n\t\t-foo: 1\n",
		)
		and recovery_nodes_link_to_their_diagnostics(
			"func f(x):\n\tmatch x:\n\t\t\"a " + INTERPOLATION_OPENER + "b}\": 1\n\t\t+: 2\n",
		)
		and recovery_nodes_link_to_their_diagnostics("func f(x: ):\n\t1\n")
		and recovery_nodes_link_to_their_diagnostics("func f(x: Float[#+]):\n\t1\n")
		and recovery_nodes_link_to_their_diagnostics("func f(x):\n\tx = \n")
	)


pure func test_question_bind_in_a_concurrent_task_inside_a_loop_is_not_a_loop_error() -> Bool:
	diagnostics_are(
		"func f(xs):\n\tfor x in xs:\n\t\tconcurrent:\n\t\t\ta = if x:\n\t\t\t\tv ?= x\n\t\t\t\tv\n\t\t\telse:\n\t\t\t\t0\n",
		[],
	)


NO_DIAGNOSTICS: List[String] = []


---
The diagnostic code names `text` reports, in order.
---
pure func diagnostic_names(text: String) -> List[String]:
	var names: List[String] = []

	for row in parsed(text).diagnostics:
		names = names.append(row.diagnostic.syntax_diagnostic_name())

	names


---
Concurrency parameter rules, matching the existing parser: `concurrent`
takes optional positive-literal `max_threads` and `timeout`; `concurrently`
requires a positive-literal `limit` and takes optional `timeout`; each name
appears once and no other name is accepted.
---
pure func concurrent_case(header: String) -> List[String]:
	diagnostic_names("func f(xs):\n\t${header}:\n\t\ta = 1\n")


pure func concurrently_case(header: String) -> List[String]:
	diagnostic_names("func f(xs):\n\tfor x in xs ${header}:\n\t\tx\n")


---
The byte range of the first diagnostic `text` reports, as `start-end`.
---
pure func first_diagnostic_range(text: String) -> String:
	match parsed(text).diagnostics.get(0):
		Some(row):
			"${row.span.span_start()}-${row.span.span_end()}"
		None:
			"none"


pure func test_non_literal_count_diagnostic_covers_the_whole_value() -> Bool:
	text: String = "func f(xs):\n\tfor x in xs concurrently(limit: xs.length()):\n\t\tx\n"
	expected_start: Int = text
		.index_of("xs.length()")
		.get_or(0)

	first_diagnostic_range(text) == "${expected_start}-${expected_start + 11}"


pure func test_concurrent_block_parameter_rules() -> Bool:
	(
		concurrent_case("concurrent(max_threads: 4, timeout: 5)") == NO_DIAGNOSTICS
		and concurrent_case("concurrent(timeout: 5)") == NO_DIAGNOSTICS
		and concurrent_case(
			"concurrent(max_threads: \"four\")",
		) == ["ConcurrentMaxThreadsNotPositiveLiteralDiagnostic"]
		and concurrent_case(
			"concurrent(max_threads: 2 + 2)",
		) == ["ConcurrentMaxThreadsNotPositiveLiteralDiagnostic"]
		and concurrent_case(
			"concurrent(max_threads: 0)",
		) == ["ConcurrentMaxThreadsNotPositiveLiteralDiagnostic"]
		and concurrent_case(
			"concurrent(max_threads: -2)",
		) == ["ConcurrentMaxThreadsNotPositiveLiteralDiagnostic"]
		and concurrent_case(
			"concurrent(max_threads: 4, max_threads: 8)",
		) == ["ConcurrentDuplicateParameterDiagnostic"]
		and concurrent_case(
			"concurrent(max_threads: 0, max_threads: 0)",
		) == [
			"ConcurrentMaxThreadsNotPositiveLiteralDiagnostic",
			"ConcurrentDuplicateParameterDiagnostic",
		]
		and concurrent_case(
			"concurrent(timeout: 1, timeout: 2)",
		) == ["ConcurrentDuplicateParameterDiagnostic"]
		and concurrent_case("concurrent(priority: 5)") == ["ConcurrentUnknownParameterDiagnostic"]
		and concurrent_case("concurrent(limit: 5)") == ["ConcurrentUnknownParameterDiagnostic"]
	)


pure func test_concurrently_loop_parameter_rules() -> Bool:
	(
		concurrently_case("concurrently(limit: 2)") == NO_DIAGNOSTICS
		and concurrently_case("concurrently(limit: 2, timeout: 5)") == NO_DIAGNOSTICS
		and concurrently_case("concurrently(timeout: 5)") == ["ConcurrentForMissingLimitDiagnostic"]
		and concurrently_case(
			"concurrently(limit: 0)",
		) == ["ConcurrentLimitNotPositiveLiteralDiagnostic"]
		and concurrently_case(
			"concurrently(limit: \"two\")",
		) == ["ConcurrentLimitNotPositiveLiteralDiagnostic"]
		and concurrently_case(
			"concurrently(limit: xs.length())",
		) == ["ConcurrentLimitNotPositiveLiteralDiagnostic"]
		and concurrently_case(
			"concurrently(limit: 2, limit: 3)",
		) == ["ConcurrentDuplicateParameterDiagnostic"]
		and concurrently_case(
			"concurrently(limit: 2, timeout: 1, timeout: 2)",
		) == ["ConcurrentDuplicateParameterDiagnostic"]
		and concurrently_case(
			"concurrently(max_threads: 2)",
		) == ["ConcurrentForMaxThreadsDiagnostic", "ConcurrentForMissingLimitDiagnostic"]
		and concurrently_case(
			"concurrently(limit: 0, limit: xs)",
		) == [
			"ConcurrentLimitNotPositiveLiteralDiagnostic",
			"ConcurrentDuplicateParameterDiagnostic",
		]
		and concurrently_case(
			"concurrently(limit: 0, limit: 0)",
		) == [
			"ConcurrentLimitNotPositiveLiteralDiagnostic",
			"ConcurrentDuplicateParameterDiagnostic",
		]
		and concurrently_case(
			"concurrently(limit: 2, timeout: 1, limit: 0)",
		) == ["ConcurrentDuplicateParameterDiagnostic"]
		and concurrently_case(
			"concurrently(limit: 2, item_timeout: 10)",
		) == ["ConcurrentForUnknownParameterDiagnostic"]
	)


