		ExpectedTokenDiagnostic(ExpectedKeyword, ExpectedEqual, ExpectedName, ExpectedRightBracket, ExpectedRightParen),
		KeywordConstruct(KeywordInBuiltinTypeDeclaration, KeywordInBuiltinTypeMarker), EqualConstruct(EqualInBuiltinTypeMarker),
		NameConstruct(NameInTypeName), RightBracketConstruct(RightBracketInTypeParameters), RightParenConstruct(RightParenInResourceCleanupBuiltinName)
