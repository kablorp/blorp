-- Direct shared builtin/resource leaf; its input cursor is at `type`.
import:
	../../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../../src/compiler_new/stage_01_discovery/parse/parse_state: ParseState, new_parse_state, advanced, current_kind, current_span, diagnostics, diagnostic_count, issued_counts, spellings
	../../../../src/compiler_new/stage_01_discovery/parse/tree_builtin_type_parser: BuiltinTypeForm(PlainBuiltinType, ResourceBuiltinType), BuiltinTypeParse(ParsedBuiltinType, ParsedResourceType, RejectedBuiltinType), parse_builtin_type
	../../../../src/compiler_new/stage_01_discovery/syntax/declarations: TypeParameter(TypeVariable, DimensionVariable, WildcardDimensionParameter)
	../../../../src/compiler_new/stage_01_discovery/syntax/ids: definition_local_index, type_binder_local_index, name_use_local_index
	../../../../src/compiler_new/stage_01_discovery/syntax/module_syntax: Documentation
	../../../../src/compiler_new/stage_01_discovery/syntax/spellings: spelling_text
	../../../../src/compiler_new/stage_01_discovery/syntax/diagnostics: SyntaxDiagnostic(ExpectedToken, Plain, ReservedKeywordAsName)
