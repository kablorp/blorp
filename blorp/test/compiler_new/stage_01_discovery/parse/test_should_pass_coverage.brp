-- Construct coverage of the should_pass corpus: every node kind the parser can
-- produce, and every token kind the lexer can produce, appears in at least one
-- program of `SHOULD_PASS_DIRECTORIES`, or is named in an exemption list with
-- the reason no accepted program can contain it. It is the should_pass twin of
-- the diagnostic-code check of `test_parser_fixtures`: a regression in the
-- parser for a construct then fails a should_pass fixture of this stage, not
-- only a parity run against the existing parser.
--
-- The kinds come from `support/kind_inventory`, which is total over both
-- enums, so a new `NodeKind` or `TokenKind` fails here until a fixture under
-- `fixtures/should_pass/` (named for the construct) produces it.
import:
	../../../../src/compiler_new/stage_01_discovery/tables/row_kinds: NodeKind, node_kind_name
	../../../../src/compiler_new/stage_01_discovery/tables/token: TokenKind, token_kind_name
	../../support/kind_inventory: all_node_kinds, all_token_kinds
	../../support/should_pass_corpus:
		CorpusFiles,
		OWN_FIXTURES,
		SHOULD_PASS_DIRECTORIES,
		read_corpus,
		total_file_count,
	fs: DirectoryEntryKind(EntryDirectory), read_directory
	set: Set, contains, from_list, to_list
	system: read_file
	test: TestSuite


---
A node kind that no accepted program contains, and why.
---
record ExemptNodeKind {
	kind: NodeKind,
	reason: String
}


---
A token kind that no accepted program contains, and why.
---
record ExemptTokenKind {
	kind: TokenKind,
	reason: String
}


EXEMPT_NODE_KINDS: List[ExemptNodeKind] = [
	{
		kind = MissingExpressionNode,
		reason = (
			"recovery only: stands where an expression was required and none was written, "
			+ "always with a diagnostic row"
		)
	},
	{
		kind = MissingPatternNode,
		reason = (
			"recovery only: stands where a pattern was required and none was written, always "
			+ "with a diagnostic row"
		)
	},
	{
		kind = MissingTypeNode,
		reason = (
			"recovery only: stands where a type was required and none was written, always "
			+ "with a diagnostic row"
		)
	},
]

EXEMPT_TOKEN_KINDS: List[ExemptTokenKind] = [
	{
		kind = TryKeyword,
		reason = (
			"reserved only so the parser can diagnose a removed `try:` block; no accepted "
			+ "program contains it"
		)
	},
]

NODE_KIND_SOURCE: String = "blorp/src/compiler_new/stage_01_discovery/tables/row_kinds.brp"

TOKEN_KIND_SOURCE: String = "blorp/src/compiler_new/stage_01_discovery/tables/token.brp"

NODE_ENUM_HEADER: String = "enum NodeKind:\n"

TOKEN_ENUM_HEADER: String = "enum TokenKind:\n"

---
What indents a variant in an enum block.
---
ENUM_VARIANT_INDENT: String = "\t"


---
The variants of the enum whose block starts after `header` in the file `path`,
in declaration order; empty when the file cannot be read or has no block.

This scrape exists only because Blorp has no way to list an enum's variants.
It counts lines and does not interpret them: the block is one variant per line
and ends at the first blank line, as in `test_parser_fixtures`.
---
func enum_variant_names(path: String, header: String) -> List[String]:
	match read_file(path):
		Ok(text):
			match text.split_once(header):
				Some(split):
					split[1]
						.split_once("\n\n")
						.map(pure func(parts): parts[0])
						.get_or("")
						.lines()
						.filter(pure func(line): line.starts_with(ENUM_VARIANT_INDENT))
						.map(pure func(line): line.trim())
				None:
					[]
		Err(_):
			[]


---
The failures of one inventory against its enum's source: its length, and its
first and last kinds. A successor chain that skips a variant, or ends early,
fails here.
---
pure func inventory_failures(
	label: String,
	declared: List[String],
	inventoried: List[String],
) -> List[String]:
	var failures: List[String] = []

	if declared.is_empty():
		failures = failures.append("${label}: no variants were read from the enum source")
	else if declared.length() != inventoried.length():
		failures = failures.append(
			"${label}: the enum declares ${declared.length()} variants but the inventory walks ${inventoried.length()}; the successor chain in support/kind_inventory skips or repeats one",
		)
	else if (
		declared.get_or(0, "") != inventoried.get_or(0, "")
		or declared.get_or(
			declared.length() - 1,
			"",
		) != inventoried.get_or(inventoried.length() - 1, "")
	):
		failures = failures.append("${label}: the inventory's first or last kind is not the enum's")

	failures


func test_the_inventories_match_the_enum_sources() -> Bool:
	failures: List[String] = inventory_failures(
		"NodeKind",
		enum_variant_names(NODE_KIND_SOURCE, NODE_ENUM_HEADER),
		all_node_kinds().map(pure func(kind): kind.node_kind_name()),
	).concat(
		inventory_failures(
			"TokenKind",
			enum_variant_names(TOKEN_KIND_SOURCE, TOKEN_ENUM_HEADER),
			all_token_kinds().map(pure func(kind): kind.token_kind_name()),
		),
	)

	for failure in failures:
		print(failure)

	failures.is_empty()


pure func test_an_inventory_that_skips_a_variant_fails() -> Bool:
	failures: List[String] = inventory_failures(
		"K",
		["A", "B", "C"],
		["A", "C"],
	)
	(
		failures.length() == 1
		and failures
			.get_or(0, "")
			.contains("declares 3 variants but the inventory walks 2")
	)


pure func test_an_inventory_with_another_last_kind_fails() -> Bool:
	inventory_failures(
		"K",
		["A", "B", "C"],
		["A", "C", "B"],
	).length() == 1


func exempt_node_names() -> Set[String]:
	from_list(EXEMPT_NODE_KINDS.map(
		pure func(entry): entry.kind.node_kind_name(),
	))


func exempt_token_names() -> Set[String]:
	from_list(EXEMPT_TOKEN_KINDS.map(
		pure func(entry): entry.kind.token_kind_name(),
	))


---
Every failure of the corpus against the inventories. The corpus is parsed once
for all of them: the failures of a node kind no fixture produces, a token kind
no fixture lexes, an exemption the corpus now covers (so the lists cannot rot
into excuses), a kind the corpus produced that the inventory lacks, an
inventory naming a kind twice, and a directory that contributed no file.
---
func corpus_failures(read: CorpusFiles) -> List[String]:
	node_exempt: Set[String] = exempt_node_names()
	token_exempt: Set[String] = exempt_token_names()
	node_names: List[String] = all_node_kinds().map(pure func(kind): kind.node_kind_name())
	token_names: List[String] = all_token_kinds().map(pure func(kind): kind.token_kind_name())
	node_set: Set[String] = from_list(node_names)
	token_set: Set[String] = from_list(token_names)
	var failures: List[String] = []

	for name in node_names:
		if not read.kinds.node_names.contains(name) and not node_exempt.contains(name):
			failures = failures.append(
				"no should_pass fixture produces ${name}: add a fixture named for the construct under ${OWN_FIXTURES}should_pass/ (or, if no accepted program can contain it, name it in EXEMPT_NODE_KINDS with the reason)",
			)

	for name in token_names:
		if not read.kinds.token_names.contains(name) and not token_exempt.contains(name):
			failures = failures.append(
				"no should_pass fixture lexes ${name}: add a fixture named for the construct under ${OWN_FIXTURES}should_pass/ (or, if no accepted program can contain it, name it in EXEMPT_TOKEN_KINDS with the reason)",
			)

	for entry in EXEMPT_NODE_KINDS:
		if read.kinds.node_names.contains(entry.kind.node_kind_name()):
			failures = failures.append(
				"${entry.kind.node_kind_name()} is produced by the corpus now: remove it from EXEMPT_NODE_KINDS",
			)

	for entry in EXEMPT_TOKEN_KINDS:
		if read.kinds.token_names.contains(entry.kind.token_kind_name()):
			failures = failures.append(
				"${entry.kind.token_kind_name()} is lexed from the corpus now: remove it from EXEMPT_TOKEN_KINDS",
			)

	for name in read.kinds.node_names.to_list():
		if not node_set.contains(name):
			failures = failures.append(
				"the corpus produced ${name}, which the node inventory does not list",
			)

	for name in read.kinds.token_names.to_list():
		if not token_set.contains(name):
			failures = failures.append(
				"the corpus lexed ${name}, which the token inventory does not list",
			)

	if (
		node_set
			.to_list()
			.length() != node_names.length()
		or token_set
			.to_list()
			.length() != token_names.length()
	):
		failures = failures.append(
			"an inventory names a kind twice (a cycle or repeat in the successor chain)",
		)

	for directory in read.directories:
		if directory.file_count == 0:
			failures = failures.append(
				"${directory.directory} contributed no file: it is missing, unlistable or empty",
			)

	failures


func test_the_corpus_covers_every_kind() -> Bool:
	read: CorpusFiles = read_corpus()
	failures: List[String] = corpus_failures(read)

	print(
		"directories: ${read.directories.length()}; files read: ${read.total_file_count()}; node kinds: ${all_node_kinds().length()} (exempt ${EXEMPT_NODE_KINDS.length()}); token kinds: ${all_token_kinds().length()} (exempt ${EXEMPT_TOKEN_KINDS.length()})",
	)

	for failure in failures:
		print(failure)

	failures.is_empty()


func test_every_subdirectory_of_a_corpus_directory_is_listed() -> Bool:
	var unlisted: List[String] = []

	for directory in SHOULD_PASS_DIRECTORIES:
		for entry in read_directory(directory).get_or([]):
			if entry.kind == EntryDirectory:
				nested: String = directory + entry.name + "/"

				if not SHOULD_PASS_DIRECTORIES.contains(nested):
					unlisted = unlisted.append(nested)

	for nested in unlisted:
		print(
			"${nested} is a subdirectory of a corpus directory but is not in SHOULD_PASS_DIRECTORIES: add it so its programs are parsed",
		)

	unlisted.is_empty()


tests: TestSuite = {
	description = "Should-pass corpus construct coverage",
	tests = [
		("the corpus covers every kind", test_the_corpus_covers_every_kind),
		("the inventories match the enum sources", test_the_inventories_match_the_enum_sources),
		("an inventory that skips a variant fails", test_an_inventory_that_skips_a_variant_fails),
		(
			"an inventory with another last kind fails",
			test_an_inventory_with_another_last_kind_fails,
		),
		(
			"every subdirectory of a corpus directory is listed",
			test_every_subdirectory_of_a_corpus_directory_is_listed,
		),
	]
}
