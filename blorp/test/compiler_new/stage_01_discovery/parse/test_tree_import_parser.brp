import:
	../../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../../src/compiler_new/stage_01_discovery/parse/parse_state: new_parse_state, diagnostic_count, diagnostics, current_kind, current_span
	../../../../src/compiler_new/stage_01_discovery/parse/tree_import_parser: parse_import, ImportParse(ParsedImport, RejectedImport)
	../../../../src/compiler_new/stage_01_discovery/syntax/imports: PathAnchor(ParentDirectoryAnchor)
	../../../../src/compiler_new/stage_01_discovery/syntax/checked_values: parent_step_count
	../../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_at_row
	../../../../src/compiler_new/stage_01_discovery/syntax/diagnostics: SyntaxDiagnostic(Plain)
	../../../../src/compiler_new/stage_01_discovery/tables/diagnostic_code: PlainSyntaxCode(ExpectedCommaBetweenImportSymbolsDiagnostic, ExpectedAliasNameDiagnostic, ImportPathCurrentNotLeadingDiagnostic)
	../../../../src/compiler_new/stage_01_discovery/tables/span: span_start, span_end
	../../../../src/compiler_new/stage_01_discovery/tables/token: TokenKind(IfKeyword, EndOfFileToken)
	test: TestSuite


pure func test_relative_import_keeps_alias_and_constructor_selections() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "../../shapes as S: Shape(Circle, Square), origin")):
		Ok(state):
			(parsed_state, parsed) = parse_import(state)

			match parsed:
				ParsedImport(value):
					match value.path.anchor:
						ParentDirectoryAnchor(steps):
							(
								steps.parent_step_count() == 2
								and value.alias_name.is_some()
								and value.items.length() == 2
								and value.items.get(0).map(pure func(item): item.constructors.length()) == Some(2)
								and parsed_state.diagnostic_count() == 0
							)
						_:
							False
				RejectedImport:
					False
		Err(_):
			False


pure func test_a_diagnostic_rejects_the_whole_import() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "shapes: Circle Square")):
		Ok(state):
			(parsed_state, parsed) = parse_import(state)
			match parsed_state.diagnostics().get(0):
				Some(at):
					match (parsed, at.diagnostic):
						(RejectedImport, Plain(ExpectedCommaBetweenImportSymbolsDiagnostic)):
							at.span.span_start() == 15 and at.span.span_end() == 15
						_:
							False
				None:
					False
		Err(_):
			False


pure func test_reserved_alias_is_consumed_without_a_diagnostic_cascade() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "shapes as if: Thing")):
		Ok(state):
			(parsed_state, parsed) = parse_import(state)

			match parsed_state.diagnostics():
				[at]:
					match (parsed, at.diagnostic):
						(RejectedImport, Plain(ExpectedAliasNameDiagnostic)):
							(at.span.span_start() == 10 and at.span.span_end() == 10
								and parsed_state.current_kind() != IfKeyword)
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_invalid_current_directory_prefix_reports_start_then_skips_line() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "./:")):
		Ok(state):
			(parsed_state, parsed) = parse_import(state)

			match (parsed, parsed_state.diagnostics()):
				(RejectedImport, [at]):
					match at.diagnostic:
						Plain(ImportPathCurrentNotLeadingDiagnostic):
							(at.span.span_start() == 0 and at.span.span_end() == 0
								and parsed_state.current_kind() == EndOfFileToken
								and parsed_state.current_span().span_start() == 3)
						_:
							False
				_:
					False
		Err(_):
			False


tests: TestSuite = {
	description = "Direct tree import parser",
	tests = [
		("invalid current directory prefix reports start then skips line", test_invalid_current_directory_prefix_reports_start_then_skips_line),
		("relative import keeps alias and constructor selections", test_relative_import_keeps_alias_and_constructor_selections),
		("a diagnostic rejects the whole import", test_a_diagnostic_rejects_the_whole_import),
		("reserved alias consumed without diagnostic cascade", test_reserved_alias_is_consumed_without_a_diagnostic_cascade)
	]
}
