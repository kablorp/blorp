-- The adapter needs authored digits after grouping widens a literal span.
import:
	../../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../../src/compiler_new/stage_01_discovery/parse/preview_source:
		preview_integer_literal_text,
		preview_source,
	../../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_at_row, source_id_at_row
	../../../../src/compiler_new/stage_01_discovery/tables/span: pack_span
	test: TestSuite


pure func test_authored_integer_digits_survive_exact_grouping() -> Bool:
	var correct: Bool = True

	for text in ["007", "(007)", "((007))", "( ( 007 ) )"]:
		lexed = lex_module(module_id_at_row(0), text)
		correct = correct and preview_integer_literal_text(
			preview_source(lexed),
			pack_span(source_id_at_row(0), 0, text.length()),
		) == Some("007")

	correct


pure func test_extra_or_unbalanced_tokens_never_supply_literal_digits() -> Bool:
	var correct: Bool = True

	for text in [
		"",
		"(007",
		"007)",
		"007 + 008",
		"(007, 008)",
		"(007).field",
		"(007)(008)",
		"(007.0)",
		"(name)",
		"()",
		"(007 -- comment)",
	]:
		lexed = lex_module(module_id_at_row(0), text)
		correct = correct and preview_integer_literal_text(
			preview_source(lexed),
			pack_span(source_id_at_row(0), 0, text.length()),
		).is_none()

	correct


pure func test_wrong_source_or_partial_span_has_no_literal_provenance() -> Bool:
	lexed = lex_module(module_id_at_row(0), "(007)")
	source = preview_source(lexed)
	preview_integer_literal_text(
		source,
		pack_span(source_id_at_row(1), 0, 5),
	).is_none() and preview_integer_literal_text(
		source,
		pack_span(source_id_at_row(0), 0, 4),
	).is_none() and preview_integer_literal_text(
		source,
		pack_span(source_id_at_row(0), 1, 5),
	).is_none()


tests: TestSuite = {
	description = "Exact numeric token provenance",
	tests = [
		(
			"authored integer digits survive exact grouping",
			test_authored_integer_digits_survive_exact_grouping,
		),
		(
			"extra or unbalanced tokens never supply literal digits",
			test_extra_or_unbalanced_tokens_never_supply_literal_digits,
		),
		(
			"wrong source or partial span has no literal provenance",
			test_wrong_source_or_partial_span_has_no_literal_provenance,
		),
	]
}
