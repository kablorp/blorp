			"integer overflow renders the literal digits",
			test_integer_overflow_renders_the_literal_digits,
		),
		(
			"interpolation too deep renders the limit",
			test_interpolation_too_deep_renders_the_depth_limit,
		),
		("an invalid UTF-8 byte renders as hex", test_an_invalid_utf8_byte_renders_as_hex),
		(
			"an invisible character renders as its codepoint",
			test_an_invisible_character_renders_as_its_codepoint,
		),
		(
			"a zero-width space renders as its codepoint",
			test_a_zero_width_space_renders_as_its_codepoint,
		),
		("a visible non-ASCII character is quoted", test_a_visible_non_ascii_character_is_quoted),
		(
			"a reserved keyword is named from the source",
			test_a_reserved_keyword_is_named_from_the_source,
		),
		("an unknown annotation is named", test_an_unknown_annotation_is_named_with_its_at_sign),
		(
			"a duplicate concurrency parameter is named",
			test_a_duplicate_concurrency_parameter_is_named,
		),
		(
			"an unknown concurrency parameter is named",
			test_an_unknown_concurrency_parameter_is_named,
		),
		(
			"an unresolved import names the import text",
			test_an_unresolved_import_names_the_import_text,
