		("an unresolved root names its path", test_an_unresolved_root_names_its_path),
		(
			"a root in another case names the stored file",
			test_a_root_in_another_case_names_the_stored_file,
		),
		(
			"an unlistable directory names the import it could not check",
			test_an_unlistable_directory_names_the_import_it_could_not_check,
