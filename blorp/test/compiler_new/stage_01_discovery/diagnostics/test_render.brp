	DiscardedQuestionBindDiagnostic,
	FieldAssignmentDiagnostic,
	ExpectedBuiltinNameDiagnostic,
	RemovedIntoConversionDiagnostic,
	RemovedFromConversionDiagnostic,
	RemovedTypeAscriptionDiagnostic,
	ExpectedConcurrentParameterDiagnostic,
	ConcurrentForTupleBinderDiagnostic,
	ConcurrentDuplicateParameterDiagnostic,
	ConcurrentUnknownParameterDiagnostic,
	ConcurrentForUnknownParameterDiagnostic,
	ConcurrentForMaxThreadsDiagnostic,
	ConcurrentMaxThreadsNotPositiveLiteralDiagnostic,
	ConcurrentLimitNotPositiveLiteralDiagnostic,
	ConcurrentForMissingLimitDiagnostic,
	WithMultipleBindingsDiagnostic,
	ExpectedFatArrowDiagnostic,
	InterpolationHoleNotExpressionDiagnostic,
	InterpolatedStringPatternDiagnostic,
	QuestionBindInLoopDiagnostic,
	BreakOutsideLoopDiagnostic,
	ContinueOutsideLoopDiagnostic,
]


---
The frozen tables of a one-line source, for rendering a row by hand.
---
pure func plain_tables() -> Option[FrontendTables]:
	match parsed_fixture("t.brp", "x: Int = 1\n").freeze():
		FrozenTables(tables):
			Some(tables)
		TableInvariantsViolated(_):
			None


func test_the_code_list_is_the_enum_block() -> Bool:
	listed: List[String] = ALL_CODES.map(diagnostic_code_name)
	declared: List[String] = declared_code_names()

	for name in declared.filter(pure func(name): not listed.contains(name)):
		print("${name} is declared but missing from ALL_CODES")

	for name in listed.filter(pure func(name): not declared.contains(name)):
		print("${name} is in ALL_CODES but not declared")

	listed == declared and not listed.is_empty()


---
Every code renders a message and a help line, even for a row with none of its
documented arguments (the text then shows `(unknown)` for them): the error
teaches in the shape rule 6 asks for.
---
func test_every_code_renders_a_message_and_a_help_line() -> Bool:
	match plain_tables():
		Some(tables):
			var missing: List[String] = []

			for code in ALL_CODES:
				row: DiagnosticRow = {
					code = code,
					span = pack_span(0, 0, 0),
					arguments = EMPTY_ROW_RANGE
				}

				rendered: RenderedDiagnostic = tables.render_diagnostic(row)

				if (
					rendered.message.is_empty()
					or rendered.help
						.get_or("")
						.is_empty()
				):
					missing = missing.append(diagnostic_code_name(code))

			for name in missing:
				print("${name} renders no message or no help")

			missing.is_empty()
		None:
			False


func test_a_display_is_the_position_line_then_the_help_line() -> Bool:
	text: String = parsed_display("x: Int = 1 &\n")
	lines: List[String] = text.lines()
	(
		lines.length() == 2
		and lines
			.get_or(0, "")
			.starts_with("t.brp:1:12: error: ")
		and lines
			.get_or(1, "")
			.starts_with("help: ")
	)


-- Constructs.
ROW_KINDS_SOURCE: String = "blorp/src/compiler_new/stage_01_discovery/tables/row_kinds.brp"

CONSTRUCT_ENUM_HEADER: String = "enum ParsedConstruct:\n"


---
The variants of the `ParsedConstruct` enum block of the source file, in
declaration order; empty when it cannot be read.
---
func declared_construct_names() -> List[String]:
	match read_file(ROW_KINDS_SOURCE):
		Ok(text):
			match text.split_once(CONSTRUCT_ENUM_HEADER):
				Some(split):
					split[1]
						.split_once("\n\n")
						.map(pure func(parts): parts[0])
						.get_or("")
						.lines()
						.filter(pure func(line): line.starts_with("\t"))
						.map(pure func(line): line.trim())
				None:
					[]
		Err(_):
			[]


---
`ALL_PARSED_CONSTRUCTS` is the enum block: the same number of variants, in
declaration order. (An enum value prints as its declaration index, so a
variant listed out of order, twice or not at all shows up here.)
---
func test_the_construct_list_is_the_enum_block() -> Bool:
	declared: Int = declared_construct_names().length()
	var in_order: Bool = True
	var position: Int = 0

	for construct in ALL_PARSED_CONSTRUCTS:
		if to_string(construct) != position.to_string():
			in_order = False
			print("construct ${position} is listed at the wrong place")

		position += 1

	if position != declared:
		print("ALL_PARSED_CONSTRUCTS lists ${position} constructs, the enum declares ${declared}")

	in_order and position == declared and declared > 0


pure func test_a_construct_survives_its_argument() -> Bool:
	var failures: Int = 0

	for construct in ALL_PARSED_CONSTRUCTS:
		match parsed_construct_at_argument(parsed_construct_argument(construct)):
			Some(found):
				if found != construct:
					failures += 1
			None:
				failures += 1

	failures == 0 and parsed_construct_at_argument(ALL_PARSED_CONSTRUCTS.length()).is_none()


pure func test_the_construct_names_the_text() -> Bool:
	(
		parsed_display("x: Int = [1, 2\n").contains("expected `]` after list literal")
		and parsed_display(
			"func f(a: Int -> Int:\n\t0\n",
		).contains("expected `)` after function parameters")
		and parsed_display(
			"func f() -> Int:\n\tif True\n\t\t1\n",
		).contains("expected `:` after if condition")
	)


pure func test_the_union_field_limit_comes_from_the_row() -> Bool:
	wide: String = "union TooWide:\n\tWide(" + "Int, ".repeat(64) + "Int)\n"

	parsed_display(
		wide,
	).contains("Union variants support at most 64 fields\nhelp: group related fields")


---
The first diagnostic message of frozen tables whose only diagnostic row is
`code` with `construct`.
---
pure func message_with_construct(
	code: DiscoveryDiagnosticCode,
	construct: ParsedConstruct,
) -> String:
	builder: DiscoveryBuilder = parsed_fixture(
		"t.brp",
		"x: Int = 1\n",
	).append_diagnostic_with_argument(
		code,
		pack_span(0, 0, 0),
		parsed_construct_argument(construct),
	)

	match builder.freeze():
		FrozenTables(tables):
			match tables.diagnostic_row_at(builder.diagnostics.length() - 1):
				Some(row):
					tables.render_diagnostic(row).message
				None:
					"(no row)"
		TableInvariantsViolated(_):
			"(does not freeze)"


func test_every_construct_pair_the_parsers_report_renders_its_message() -> Bool:
	var wrong: Int = 0

	for entry in CONSTRUCT_MESSAGES:
		shown: String = message_with_construct(entry[0], entry[1])

		if shown != entry[2]:
			print(
				"${diagnostic_code_name(entry[0])} in construct ${parsed_construct_argument(entry[1])}: ${shown} instead of ${entry[2]}",
			)
			wrong += 1

	wrong == 0


func test_every_construct_is_reported_by_some_pair() -> Bool:
	var unused: Int = 0

	for construct in ALL_PARSED_CONSTRUCTS:
		var used: Bool = False

		for entry in CONSTRUCT_MESSAGES:
			if entry[1] == construct:
				used = True

		if not used:
			print("construct ${parsed_construct_argument(construct)} is in no pair")
			unused += 1

	unused == 0


