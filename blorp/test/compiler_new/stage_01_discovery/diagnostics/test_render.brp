		),
		("columns count bytes, not characters", test_columns_count_bytes_not_characters),
		("the line is one-based", test_the_line_is_one_based_and_counts_newlines),
		(
			"unknown escape renders the escaped character",
			test_unknown_escape_renders_the_escaped_character,
		),
		(
			"an unprintable escaped byte renders as hex",
			test_an_unprintable_escaped_byte_renders_as_hex,
