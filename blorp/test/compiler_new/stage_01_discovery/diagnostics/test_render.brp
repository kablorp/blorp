-- Rendered discovery diagnostics (`diagnostics/render.brp`): the message and
-- help of each argument-carrying code, the position a display shows, and the
-- check that every code has text.
--
-- Parser and lexer codes are reached by parsing a small source alone; module
-- graph codes by discovering in-memory sources. Each expectation is written
-- out in full, so a wording change is a visible edit here and in the design
-- document's table of differences from the existing compiler.
import:
	../../../../src/compiler_new/stage_01_discovery/diagnostics/render:
		RenderedDiagnostic,
		diagnostic_display,
		render_diagnostic,
		render_implicit_diagnostic,
		render_root_diagnostic,
	../../../../src/compiler_new/stage_01_discovery/pipeline: discover
	../../../../src/compiler_new/stage_01_discovery/sources/source_provider:
