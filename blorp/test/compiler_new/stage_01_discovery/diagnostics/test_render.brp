		),
		RightBracketConstruct(
			RightBracketInListPattern, RightBracketInTypeArguments, RightBracketInArrayDimensions,
			RightBracketInTypeParameters, RightBracketInSubscript, RightBracketInListLiteral,
		),
		RightParenConstruct(
			RightParenInConstructorPattern, RightParenInTuplePattern, RightParenInVariantFields,
			RightParenInResourceCleanupBuiltinName, RightParenInForeignBlockArguments,
			RightParenInGroupedType, RightParenInFunctionTypeParameters,
			RightParenInDimensionExpression, RightParenInFunctionParameters,
			RightParenInTupleParameterNames, RightParenInTupleDestructuringNames,
			RightParenInTupleLoopVariables, RightParenInConcurrentParameters,
			RightParenInConcurrentlyParameters, RightParenInLambdaParameters,
			RightParenInCallArguments, RightParenInOpaqueConversionValue, RightParenInBuiltinName,
			RightParenInTupleExpression, RightParenInGroupedExpression,
		),
	../../../../src/compiler_new/stage_01_discovery/tables/frontend_tables:
		FreezeOutcome(FrozenTables, TableInvariantsViolated),
		FrontendTables,
		diagnostic_row_at,
		freeze,
		implicit_rejection,
		resolution_diagnostic_row_at,
		root_rejection,
	../../../../src/compiler_new/stage_01_discovery/tables/ids:
		definition_id_at_row,
		implicit_request_id_at_row,
		import_id_at_row,
		literal_id_at_row,
		name_id_at_row,
		path_id_at_row,
		root_id_at_row,
		source_id_at_row,
	../../../../src/compiler_new/stage_01_discovery/tables/rows:
		ResolutionDiagnosticRow,
		SyntaxDiagnosticRow,
	../../../../src/compiler_new/stage_01_discovery/tables/span: SPAN_OFFSET_LIMIT, pack_span
	../../support/construct_messages: EXPECTED_TOKEN_MESSAGES
	../../support/first_diagnostic:
		FrozenDiagnostic,
		first_diagnostic_display,
		first_frozen_diagnostic,
	../../support/parser_fixtures: parsed_fixture
	../parse/test_parser_fixtures: declared_code_names
	bytes: Bytes, bytes
	fs: DirectoryListing(DirectoryUnreadable)
	string: to_bytes
	system: mkstemp_path, read_file, remove_file, write_bytes
	test: TestSuite


LOOKUP_ROOTS: SourceLookupRoots = {
	standard_library_root = "std",
	native_package_roots = ["pkg"],
	source_packages = []
}


---
The first diagnostic of `text` parsed alone as `t.brp`, as the stage displays
it, or `(none)`.
---
pure func parsed_display(text: String) -> String:
	parsed_fixture("t.brp", text)
		.first_diagnostic_display()
		.get_or("(none)")


---
The tables of discovering `roots` over `sources`; `None` when they do not
freeze.
---
func discovered_over[P:SourceProvider](provider: P, roots: List[String]) -> Option[FrontendTables]:
	match discover(provider, LOOKUP_ROOTS, roots, {module_names = []}):
		FrozenTables(tables):
			Some(tables)
		TableInvariantsViolated(_):
			None


---
The display of the first module graph diagnostic of discovering `roots` over
`sources`.
---
func resolution_display(sources: Dict[String, String], roots: List[String]) -> String:
	provider: InMemorySourceProvider = {sources = sources}

	match discovered_over(provider, roots):
		Some(tables):
			match tables.resolution_diagnostic_row_at(0):
				Some(row):
					tables.resolution_diagnostic_display(row)
				None:
					"(none)"
		None:
			"(tables do not freeze)"


---
The rendered text of the first root diagnostic of discovering `roots` over
`sources`, as `message | help`.
---
func root_text(sources: Dict[String, String], roots: List[String]) -> String:
	provider: InMemorySourceProvider = {sources = sources}
	root_text_of(discovered_over(provider, roots))


private func root_text_of(found: Option[FrontendTables]) -> String:
	match found:
		Some(tables):
			match tables.root_rejection(root_id_at_row(0)):
				Some(diagnostic):
					joined_text(tables.render_root_diagnostic(root_id_at_row(0), diagnostic))
				None:
					"(none)"
		None:
			"(tables do not freeze)"


pure func joined_text(rendered: RenderedDiagnostic) -> String:
	rendered.message + " | " + rendered.help.get_or("(no help)")


-- Positions: the column the existing compiler prints.
pure func test_a_tab_advances_the_column_to_the_next_multiple_of_four() -> Bool:
	-- The tab takes the line to column 5; `&` is the eleventh byte after it.
	parsed_display(
		"func f() -> Int:\n\tx: Int = 1 &\n",
	) == "t.brp:2:16: error: unexpected character '&'\nhelp: Blorp writes boolean operators as words: use `and`, `or` and `not`"


pure func test_columns_count_bytes_not_characters() -> Bool:
	-- `é` is two bytes and `€` three, so the `&` is byte column 21, as the
	-- existing compiler reports it.
	parsed_display(
		"x: String = \"é€\" &\n",
	).starts_with("t.brp:1:21: error: unexpected character '&'")


pure func test_the_line_is_one_based_and_counts_newlines() -> Bool:
	parsed_display("x: Int = 1\ny: Int = 2\nz: Int = 3 &\n").starts_with("t.brp:3:12: error: ")


-- Argument-carrying codes.
pure func test_unknown_escape_renders_the_escaped_character() -> Bool:
	parsed_display(
		"x: String = \"a\\qb\"\n",
	) == "t.brp:1:15: error: unknown escape sequence '\\q'\nhelp: write `\\n`, `\\t`, `\\r`, `\\0`, `\\\\`, `\\\"`, `\\'`, `\\{`, `\\}` or `\\u{...}`; to write a backslash, double it"


pure func test_an_unprintable_escaped_byte_renders_as_hex() -> Bool:
	parsed_display("x: String = \"a\\\tb\"\n").contains("unknown escape sequence '\\x09'")


pure func test_integer_overflow_renders_the_literal_digits() -> Bool:
	parsed_display(
		"x: Int = 99999999999999999999999999999999999999999\n",
	) == "t.brp:1:10: error: Integer literal '99999999999999999999999999999999999999999' exceeds Int128 range\nhelp: write a smaller number, or use a Float literal such as `1.0e40`"


pure func test_interpolation_too_deep_renders_the_depth_limit() -> Bool:
	nested: String = "x: String = \"" + ("$" + "{").repeat(70) + "1" + "}".repeat(70) + "\"\n"
	parsed_display(
		nested,
	).contains(
		"string interpolation nested too deeply\nhelp: interpolation holes can nest at most 64 deep",
	)


func test_an_invalid_utf8_byte_renders_as_hex() -> Bool:
	source: Bytes = "x: Int = 1 "
		.to_bytes()
		.append(bytes(1).set_index(0, 255))
		.append("\n".to_bytes())

	match mkstemp_path("render_invalid_utf8"):
		Ok(path):
			written: Bool = match write_bytes(path, source):
				Ok(_):
					True
				Err(_):
					False

			shown: String = match read_file(path):
				Ok(text):
					parsed_display(text)
				Err(message):
					message

			remove_file(path)
			(
				written
				and shown == "t.brp:1:12: error: unexpected byte 0xFF: the source is not valid UTF-8\nhelp: save the file as UTF-8, or remove the byte"
			)
		Err(message):
			print(message)
			False


pure func test_an_invisible_character_renders_as_its_codepoint() -> Bool:
	-- A carriage return is shown as U+000D, not as the raw character.
	parsed_display(
		"x: Int = 1\r\n",
	).starts_with("t.brp:1:11: error: unexpected character U+000D\nhelp: remove it")


pure func test_a_zero_width_space_renders_as_its_codepoint() -> Bool:
	parsed_display("x: Int = 1 ​\n").contains("unexpected character U+200B")


pure func test_a_visible_non_ascii_character_is_quoted() -> Bool:
	parsed_display("x: Int = 1 é\n").contains("unexpected character 'é'")


-- Codes that name a stretch of source.
pure func test_a_reserved_keyword_is_named_from_the_source() -> Bool:
	parsed_display(
		"where: Int = 1\n",
	) == "t.brp:1:1: error: `where` is a reserved keyword and cannot be used as a name\nhelp: choose another identifier such as `where_name`"


pure func test_an_unknown_annotation_is_named_with_its_at_sign() -> Bool:
	parsed_display(
		"@memoize\nfunc f() -> Int:\n\t1\n",
	) == "t.brp:1:2: error: unknown function annotation `@memoize`\nhelp: use one of @tail_recursive, @debug_only, @no_copy, @resource_result_ordinary, or remove the annotation"


pure func test_a_duplicate_concurrency_parameter_is_named() -> Bool:
	parsed_display(
		"func main(args: List[String]) -> Int:\n\tconcurrent(timeout: 1, timeout: 2):\n\t\ta = 1\n\t0\n",
	).contains("duplicate `timeout` parameter\nhelp: remove the second `timeout`")


pure func test_an_unknown_concurrency_parameter_is_named() -> Bool:
	parsed_display(
		"func main(args: List[String]) -> Int:\n\tconcurrent(priority: 1):\n\t\ta = 1\n\t0\n",
	).contains("unknown concurrent parameter `priority` (expected `max_threads` or `timeout`)")


-- Module graph codes.
func test_an_unresolved_import_names_the_import_text() -> Bool:
	resolution_display(
		{"app/main.brp" => "import:\n\t./gone\n"},
		[
			"app/main.brp",
		],
	) == "app/main.brp:2:5: error: cannot find module `./gone`\nhelp: check the spelling of the import path and that the module exists; relative paths start with `./` or `../`"


func test_a_case_mismatched_import_reads_as_the_existing_compiler_prints_it() -> Bool:
	resolution_display(
		{"app/main.brp" => "import:\n\t./helper\n", "app/Helper.brp" => ""},
		["app/main.brp"],
	) == "app/main.brp:2:5: error: import `./helper` does not match the file's name `Helper.brp`\nhelp: import paths are case-sensitive; write `./Helper`"


func test_a_nested_case_mismatch_respells_only_the_components_that_differ() -> Bool:
	resolution_display(
		{"app/main.brp" => "import:\n\t./sub/helper\n", "app/sub/Helper.brp" => ""},
		["app/main.brp"],
	).ends_with("help: import paths are case-sensitive; write `./sub/Helper`")


func test_an_oversized_source_renders_its_length() -> Bool:
	resolution_display(
		{"app/main.brp" => "import:\n\t./huge\n", "app/huge.brp" => "a".repeat(SPAN_OFFSET_LIMIT)},
		["app/main.brp"],
	) == "app/main.brp:2:5: error: source is too large to compile (16777216 bytes)\nhelp: split it into smaller modules; a source can be at most 16777215 bytes"


func test_too_many_sources_names_the_limit_one_below_the_span_field() -> Bool:
	-- The last source index is `NO_SOURCE`, so a compilation loads 32767 sources,
	-- one fewer than the 15-bit source field numbers.
	match discovered_over({sources = {"main.brp" => ""}}, ["main.brp"]):
		Some(tables):
			joined_text(tables.render_root_diagnostic(root_id_at_row(0), RootTooManySources)) == (
				"too many source files in one compilation | a compilation can load at most 32767 "
				+ "source files; remove unused imports or split the program into packages"
			)
		None:
			False


func test_an_unresolved_root_names_its_path() -> Bool:
	root_text({"app/main.brp" => ""}, ["app/missing.brp"]) == (
		"cannot find source file `app/missing.brp` | check the path and that the file "
		+ "exists"
	)


func test_a_root_in_another_case_names_the_stored_file() -> Bool:
	root_text({"app/main.brp" => ""}, ["app/Main.brp"]) == (
		"`app/Main.brp` does not match the file's name `main.brp` | file names are case-"
		+ "sensitive; write `main.brp`"
	)


---
A provider whose listing of one directory is replaced.
---
record ListingOverrideProvider {
	inner: InMemorySourceProvider,
	directory: String,
	listing: DirectoryListing
}


implements SourceProvider for ListingOverrideProvider:
	func source_exists(self: ListingOverrideProvider, path: String) -> Bool:
		self.inner.source_exists(path)

	func directory_listing(self: ListingOverrideProvider, directory: String) -> DirectoryListing:
		if directory == self.directory:
			self.listing
		else:
			self.inner.directory_listing(directory)

	func read_source(self: ListingOverrideProvider, path: String) -> SourceRead:
		self.inner.read_source(path)


func test_an_unlistable_directory_names_the_import_it_could_not_check() -> Bool:
	provider: ListingOverrideProvider = {
		inner = {sources = {"app/main.brp" => "import:\n\t./sub/a\n", "app/sub/a.brp" => ""}},
		directory = "./app/sub",
		listing = DirectoryUnreadable
	}

	match discovered_over(provider, ["app/main.brp"]):
		Some(tables):
			match tables.resolution_diagnostic_row_at(0):
				Some(row):
					tables.resolution_diagnostic_display(
						row,
					) == "app/main.brp:2:5: error: cannot check the letter case of `./sub/a`\nhelp: a directory on the way to the file could not be listed; check its permissions"
				None:
					False
		None:
			False


func test_an_unlistable_root_directory_names_the_root() -> Bool:
	provider: ListingOverrideProvider = {
		inner = {sources = {"app/main.brp" => ""}},
		directory = "./app",
		listing = DirectoryUnreadable
	}

	root_text_of(discovered_over(provider, ["app/main.brp"])) == (
		"cannot check the letter case of `app/main.brp` | a directory on the way to the "
		+ "file could not be listed; check its permissions"
	)


func test_a_missing_implicit_module_names_it() -> Bool:
	provider: InMemorySourceProvider = {sources = {"app/main.brp" => ""}}

	match discover(provider, LOOKUP_ROOTS, ["app/main.brp"], {module_names = ["nowhere"]}):
		FrozenTables(tables):
			match tables.implicit_rejection(implicit_request_id_at_row(0)):
				Some(diagnostic):
					joined_text(
						tables.render_implicit_diagnostic(
							implicit_request_id_at_row(0),
							diagnostic,
						),
					).starts_with(
						"cannot find implicit module `nowhere` | every compilation loads it",
					)
				None:
					False
		TableInvariantsViolated(_):
			False


---
A provider that finds `unreadable_path` but cannot read it.
---
record UnreadableProvider {
	inner: InMemorySourceProvider,
	unreadable_path: String
}


implements SourceProvider for UnreadableProvider:
	func source_exists(self: UnreadableProvider, path: String) -> Bool:
		self.inner.source_exists(path)

	func directory_listing(self: UnreadableProvider, directory: String) -> DirectoryListing:
		self.inner.directory_listing(directory)

	func read_source(self: UnreadableProvider, path: String) -> SourceRead:
		if path == self.unreadable_path:
			SourceUnreadable
		else:
			self.inner.read_source(path)


func test_an_unreadable_import_and_an_unreadable_root_name_their_path() -> Bool:
	provider: UnreadableProvider = {
		inner = {sources = {"app/main.brp" => "import:\n\t./locked\n", "app/locked.brp" => ""}},
		unreadable_path = "app/locked.brp"
	}

	match discovered_over(provider, ["app/main.brp"]):
		Some(tables):
			match tables.resolution_diagnostic_row_at(0):
				Some(row):
					tables.resolution_diagnostic_display(
						row,
					) == "app/main.brp:2:5: error: cannot read `./locked`\nhelp: check that the file exists and that you may read it"
				None:
					False
		None:
			False


func test_an_unreadable_root_names_its_path() -> Bool:
	provider: UnreadableProvider = {
		inner = {sources = {"app/main.brp" => ""}},
		unreadable_path = "app/main.brp"
	}

	root_text_of(
		discovered_over(
			provider,
			["app/main.brp"],
		),
	) == "cannot read `app/main.brp` | check that the file exists and that you may read it"


-- Every code has text.
---
One value for every syntax diagnostic: each plain code, each missing-token
diagnostic (every construct of every code), then the codes with arguments, each
argument naming row 0 of its table. Blorp has no enum reflection, so
`test_the_code_lists_are_the_declared_codes` keeps the lists equal to the
blocks of `diagnostic_code.brp` and `expected_token.brp`.
---
ALL_SYNTAX: List[SyntaxDiagnostic] = [
	Plain(UnterminatedDocstringDiagnostic),
	Plain(UnterminatedStringDiagnostic),
	Plain(MultilineStringDiagnostic),
	Plain(UnterminatedEscapeDiagnostic),
	Plain(UnicodeEscapeDigitCountDiagnostic),
	Plain(UnicodeEscapeNonHexDiagnostic),
	Plain(UnterminatedUnicodeEscapeDiagnostic),
	Plain(UnicodeCodepointOutOfRangeDiagnostic),
	Plain(MultilineRawStringDiagnostic),
	Plain(UnterminatedRawStringDiagnostic),
	Plain(InterpolatedEscapeAtEndDiagnostic),
	Plain(MultilineInterpolatedStringDiagnostic),
	Plain(UnterminatedInterpolatedStringDiagnostic),
	Plain(InvalidCharLiteralDiagnostic),
	Plain(UnterminatedCharLiteralDiagnostic),
	Plain(UnexpectedCharacterDiagnostic),
	Plain(InconsistentIndentationDiagnostic),
	Plain(ExpectedColonAfterImportDiagnostic),
	Plain(ExpectedNewlineAfterImportHeaderDiagnostic),
	Plain(ExpectedIndentedImportsDiagnostic),
	Plain(ExpectedModulePathDiagnostic),
	Plain(ImportPathCurrentNotLeadingDiagnostic),
	Plain(ImportPathParentNotLeadingDiagnostic),
	Plain(ExpectedImportSymbolDiagnostic),
	Plain(ExpectedCommaBetweenImportSymbolsDiagnostic),
	Plain(ExpectedConstructorNameDiagnostic),
	Plain(ExpectedClosingParenAfterConstructorsDiagnostic),
	Plain(ExpectedAliasNameDiagnostic),
	Plain(ExpectedImportSymbolsAfterColonDiagnostic),
	Plain(ExpectedDimensionDiagnostic),
	Plain(ExpectedTypeDiagnostic),
	Plain(ArrayDimensionsExpectedDiagnostic),
	Plain(TupleArityDiagnostic),
	Plain(ExpectedEqualEqualDiagnostic),
	Plain(ExpectedHashDiagnostic),
	Plain(AnnotationArgumentsDiagnostic),
	Plain(AnnotationWithoutFunctionDiagnostic),
	Plain(DocstringBeforeImportBlockDiagnostic),
	Plain(ExpectedDeclarationDiagnostic),
	Plain(ForeignFunctionOutsideBlockDiagnostic),
	Plain(ExpectedForeignArgumentDiagnostic),
	Plain(ExpectedForeignArgumentValueDiagnostic),
	Plain(ExpectedForeignFunctionDiagnostic),
	Plain(ExpectedForeignCNameDiagnostic),
	Plain(ExpectedCleanupBuiltinNameDiagnostic),
	Plain(BuiltinTypeArgumentsDiagnostic),
	Plain(ExpectedSupertraitOrMethodsDiagnostic),
	Plain(ExpectedImplMethodDiagnostic),
	Plain(ExpectedExpressionDiagnostic),
	Plain(ExpectedPatternDiagnostic),
	Plain(ExpectedNumberAfterMinusDiagnostic),
	Plain(ExpectedSpreadTargetDiagnostic),
	Plain(ExpectedAssignmentOperatorDiagnostic),
	Plain(DiscardedQuestionBindDiagnostic),
	Plain(FieldAssignmentDiagnostic),
	Plain(AssignmentInConditionDiagnostic),
	Plain(AssignmentInExpressionDiagnostic),
	Plain(ExpectedBuiltinNameDiagnostic),
	Plain(RemovedTypeAscriptionDiagnostic),
	Plain(ExpectedConcurrentParameterDiagnostic),
	Plain(ConcurrentForTupleBinderDiagnostic),
	Plain(ConcurrentForMaxThreadsDiagnostic),
	Plain(ConcurrentMaxThreadsNotPositiveLiteralDiagnostic),
	Plain(ConcurrentLimitNotPositiveLiteralDiagnostic),
	Plain(ConcurrentForMissingLimitDiagnostic),
