---
One value for every module graph diagnostic about an import.
---
ALL_RESOLUTION: List[ResolutionDiagnostic] = [
	UnresolvedImport(import_id_at_row(0)),
	ImportCaseMismatch(import_id_at_row(0), path_id_at_row(0)),
	UnverifiableSpelling(import_id_at_row(0)),
	UnreadableSource(import_id_at_row(0)),
	ImportSourceTooLarge(1),
	ImportTooManySources,
]

---
One value for every root diagnostic.
---
ALL_ROOT: List[RootDiagnostic] = [
	UnresolvedRoot,
	RootCaseMismatch(path_id_at_row(0)),
	UnverifiableRootSpelling,
	UnreadableRootSource,
	RootSourceTooLarge(1),
	RootTooManySources,
]

---
One value for every implicit module diagnostic.
---
ALL_IMPLICIT: List[ImplicitDiagnostic] = [
	MissingImplicitModule,
	UnverifiableImplicitSpelling,
	UnreadableImplicitSource,
	ImplicitSourceTooLarge(1),
	ImplicitTooManySources,
]


---
The frozen tables of discovering one root over a source with an import and one
implicit module that does not exist, so root 0, implicit request 0 and the
rows `ALL_*` names exist, for rendering a row by hand.
---
func rendering_tables() -> Option[FrontendTables]:
	provider: InMemorySourceProvider = {
		sources = {"t.brp" => "import:\n\tlist: repeat\n\nx: Int = 1\n"},
	}

	match discover(provider, LOOKUP_ROOTS, ["t.brp"], {module_names = ["nowhere"]}):
		FrozenTables(tables):
			Some(tables)
		TableInvariantsViolated(_):
			None


---
Distinct names in `names`, in order of first appearance.
---
pure func distinct_names(names: List[String]) -> List[String]:
	var seen: List[String] = []

	for name in names:
		if not seen.contains(name):
			seen = seen.append(name)

	seen


func test_the_code_lists_are_the_declared_codes() -> Bool:
	listed: List[String] = distinct_names(
		ALL_SYNTAX
			.map(syntax_diagnostic_name)
			.concat(ALL_RESOLUTION.map(resolution_diagnostic_name))
			.concat(ALL_ROOT.map(root_diagnostic_name))
			.concat(ALL_IMPLICIT.map(implicit_diagnostic_name)),
	)
	declared: List[String] = declared_code_names()

	for name in declared.filter(pure func(name): not listed.contains(name)):
		print("${name} is declared but missing from the ALL_ lists")

	for name in listed.filter(pure func(name): not declared.contains(name)):
		print("${name} is in the ALL_ lists but not declared")

	(
		listed.length() == declared.length()
		and not listed.is_empty()
		and declared.all(pure func(name): listed.contains(name))
	)


---
Every diagnostic renders a message and a help line: the error teaches in the
shape rule 6 asks for.
---
func test_every_code_renders_a_message_and_a_help_line() -> Bool:
	match rendering_tables():
		Some(tables):
			var missing: List[String] = []

			for diagnostic in ALL_SYNTAX:
				row: SyntaxDiagnosticRow = {
					span = pack_span(source_id_at_row(0), 0, 0),
					diagnostic = diagnostic
				}

				missing = missing.concat(
					shown_empty(
						tables.render_diagnostic(row),
						diagnostic.syntax_diagnostic_name(),
					),
				)

			for diagnostic in ALL_RESOLUTION:
				row: ResolutionDiagnosticRow = {
					span = pack_span(source_id_at_row(0), 0, 0),
					diagnostic = diagnostic
				}

				missing = missing.concat(
					shown_empty(
						tables.render_resolution_diagnostic(row),
						diagnostic.resolution_diagnostic_name(),
					),
				)

			for diagnostic in ALL_ROOT:
				missing = missing.concat(
					shown_empty(
						tables.render_root_diagnostic(root_id_at_row(0), diagnostic),
						diagnostic.root_diagnostic_name(),
					),
				)

			for diagnostic in ALL_IMPLICIT:
				missing = missing.concat(
					shown_empty(
						tables.render_implicit_diagnostic(
							implicit_request_id_at_row(0),
							diagnostic,
						),
						diagnostic.implicit_diagnostic_name(),
					),
				)

			for name in missing:
				print("${name} renders no message or no help")

			missing.is_empty()
		None:
			False


---
`name` when `rendered` has no message or no help, else nothing.
---
pure func shown_empty(rendered: RenderedDiagnostic, name: String) -> List[String]:
	if (
		rendered.message.is_empty()
		or rendered.help
			.get_or("")
			.is_empty()
	):
		[name]
	else:
		[]


func test_an_unterminated_char_literal_in_a_hole_is_reported_at_the_line_break() -> Bool:
	-- The hole of `'}` never closes; its scan stops at the line break, column 19
	-- of line 2 (the tab counts to the next stop), where the message points.
	parsed_display(
		"func f():\n\tx = \"a " + "$" + "{'} b\"\n\ty = 1\n",
	).starts_with(
		"t.brp:2:19: error: Unterminated interpolated string. Use aligned pipe strings for multiline text\n",
	)


func test_a_display_is_the_position_line_then_the_help_line() -> Bool:
	text: String = parsed_display("x: Int = 1 &\n")
	lines: List[String] = text.lines()
	(
		lines.length() == 2
		and lines
			.get_or(0, "")
			.starts_with("t.brp:1:12: error: ")
		and lines
			.get_or(1, "")
			.starts_with("help: ")
	)


-- Constructs.
pure func test_the_construct_names_the_text() -> Bool:
	(
		parsed_display("x: Int = [1, 2\n").contains("expected `]` after list literal")
		and parsed_display(
			"func f(a: Int -> Int:\n\t0\n",
		).contains("expected `)` after function parameters")
		and parsed_display(
			"func f() -> Int:\n\tif True\n\t\t1\n",
		).contains("expected `:` after if condition")
	)


pure func test_the_union_field_limit_comes_from_the_row() -> Bool:
	wide: String = "union TooWide:\n\tWide(" + "Int, ".repeat(64) + "Int)\n"

	parsed_display(
		wide,
	).contains("Union variants support at most 64 fields\nhelp: group related fields")


---
The message of frozen tables whose only diagnostic is the missing token
`expected`.
---
pure func message_of(expected: ExpectedTokenDiagnostic) -> String:
	builder: DiscoveryBuilder = parsed_fixture("t.brp", "x: Int = 1\n").append_syntax_diagnostic(
		pack_span(source_id_at_row(0), 0, 0),
		ExpectedToken(expected),
	)

	match builder.freeze():
		FrozenTables(tables):
			match tables.diagnostic_row_at(builder.diagnostics.length() - 1):
				Some(row):
					tables.render_diagnostic(row).message
				None:
					"(no row)"
		TableInvariantsViolated(_):
			"(does not freeze)"


func test_every_pinned_missing_token_renders_its_message() -> Bool:
	var wrong: Int = 0

	for entry in EXPECTED_TOKEN_MESSAGES:
		shown: String = message_of(entry[0])

		if shown != entry[1]:
			print(
				"${syntax_diagnostic_name(ExpectedToken(entry[0]))}: ${shown} instead of ${entry[1]}",
			)
			wrong += 1

	wrong == 0


