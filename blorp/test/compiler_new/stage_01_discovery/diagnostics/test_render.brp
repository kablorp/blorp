		("a missing implicit module names it", test_a_missing_implicit_module_names_it),
		(
			"an unlistable root directory names the root",
			test_an_unlistable_root_directory_names_the_root,
		),
		("the code list is the enum block", test_the_code_list_is_the_enum_block),
		(
