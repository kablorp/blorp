-- Discovery tests (`discover`) over in-memory module graphs. Every discovery here
-- freezes with the table invariants checked, so each test also shows the
-- discovery's output satisfies them.
import:
	../../../src/compiler_new/stage_01_discovery/pipeline:
		ImplicitModules,
		compiler_implicit_modules,
		discover,
		test_implicit_modules,
	../../../src/compiler_new/stage_01_discovery/sources/source_provider:
		InMemorySourceProvider,
		SourceLookupRoots,
		SourceProvider,
		SourceRead(SourceText, SourceUnreadable),
		directory_listing,
		read_source,
		respelled_import_text,
		source_exists,
	../../../src/compiler_new/stage_01_discovery/tables/diagnostic_code:
		RootDiagnostic(RootTooManySources),
	../../../src/compiler_new/stage_01_discovery/tables/frontend_tables:
		FreezeOutcome(FrozenTables, TableInvariantsViolated),
		FrontendTables,
		import_count,
		import_request_text,
		import_row_at,
		module_count,
		module_row,
		root_count,
		root_rejection,
		source_text,
	../../../src/compiler_new/stage_01_discovery/tables/ids:
		module_id_at_row,
		root_id_at_row,
		root_id_index,
	../../../src/compiler_new/stage_01_discovery/tables/rows: RowRange
	../../../src/compiler_new/stage_01_discovery/tables/span:
		MAX_SOURCE_COUNT,
		SPAN_OFFSET_LIMIT,
		span_length,
		span_source,
		span_start,
	../support/tables_dump: tables_dump
	fs: DirectoryListing(DirectoryListed, DirectoryUnreadable)
	test: TestSuite


LOOKUP_ROOTS: SourceLookupRoots = {
	standard_library_root = "std",
	native_package_roots = ["pkg"],
	source_packages = []
}

NO_IMPLICIT_MODULES: ImplicitModules = {module_names = []}


---
Discovers `roots` over `sources` with no implicit modules, or `None` (with the violations printed)
when the result breaks a table invariant.
---
func discovered(sources: Dict[String, String], roots: List[String]) -> Option[FrontendTables]:
	discovered_with(sources, roots, NO_IMPLICIT_MODULES)


---
Discovers `roots` and the `implicit` modules over `sources`, or `None` (with the
violations printed) when the result breaks a table invariant.
---
func discovered_with(
	sources: Dict[String, String],
	roots: List[String],
	implicit: ImplicitModules,
) -> Option[FrontendTables]:
	provider: InMemorySourceProvider = {sources = sources}

	match discover(provider, LOOKUP_ROOTS, roots, implicit):
		FrozenTables(tables):
			Some(tables)
		TableInvariantsViolated(violations):
			print("invariant violations: ${violations.length()}")
			None


---
Whether discovering `roots` over `sources` renders exactly `expected`.
---
func dumps_as(sources: Dict[String, String], roots: List[String], expected: List[String]) -> Bool:
	dumps_as_with(sources, roots, NO_IMPLICIT_MODULES, expected)


---
Whether discovering `roots` and the `implicit` modules over `sources` renders
exactly `expected`.
---
func dumps_as_with(
	sources: Dict[String, String],
	roots: List[String],
	implicit: ImplicitModules,
	expected: List[String],
) -> Bool:
	match discovered_with(sources, roots, implicit):
		Some(tables):
			actual: String = tables.tables_dump()
			matches: Bool = actual == expected.join("\n")

			if not matches:
				print("actual dump:\n${actual}")

			matches
		None:
			False


func test_modules_load_roots_first_then_imports_breadth_first() -> Bool:
	dumps_as(
		{
			"app/main.brp" => "import:\n\t./a\n\t./b\n\nfunc main(args: List[String]) -> Int:\n\t0\n",
			"app/a.brp" => "import:\n\t./c\n",
			"app/b.brp" => "import:\n\t./d\n",
			"app/c.brp" => "x: Int = 1\n",
			"app/d.brp" => "y: Int = 2\n",
		},
		["app/main.brp"],
		[
			"root r0 app/main.brp -> m0:app/main.brp",
			"module m0:app/main.brp source=s0 user root imports=0+2 diagnostics=0+0",
			"  import i0 relative ./a parents=0 parts=a items=[] -> m1:app/a.brp",
			"  import i1 relative ./b parents=0 parts=b items=[] -> m2:app/b.brp",
			"module m1:app/a.brp source=s1 user imported imports=2+1 diagnostics=0+0",
			"  import i2 relative ./c parents=0 parts=c items=[] -> m3:app/c.brp",
			"module m2:app/b.brp source=s2 user imported imports=3+1 diagnostics=0+0",
			"  import i3 relative ./d parents=0 parts=d items=[] -> m4:app/d.brp",
			"module m3:app/c.brp source=s3 user imported imports=4+0 diagnostics=0+0",
			"module m4:app/d.brp source=s4 user imported imports=4+0 diagnostics=0+0",
		],
	)


func test_import_cycle_and_shared_import_load_each_module_once() -> Bool:
	dumps_as(
		{
			"app/main.brp" => "import:\n\t./a\n\t./b\n",
			"app/a.brp" => "import:\n\t./b\n\t./shared\n",
			"app/b.brp" => "import:\n\t./a\n\t./shared\n",
			"app/shared.brp" => "import:\n\t./main\n",
		},
		["app/main.brp"],
		[
			"root r0 app/main.brp -> m0:app/main.brp",
			"module m0:app/main.brp source=s0 user root imports=0+2 diagnostics=0+0",
			"  import i0 relative ./a parents=0 parts=a items=[] -> m1:app/a.brp",
			"  import i1 relative ./b parents=0 parts=b items=[] -> m2:app/b.brp",
			"module m1:app/a.brp source=s1 user imported imports=2+2 diagnostics=0+0",
			"  import i2 relative ./b parents=0 parts=b items=[] -> m2:app/b.brp",
			(
				"  import i3 relative ./shared parents=0 parts=shared items=[] -> m3:app/shared."
				+ "brp"
			),
			"module m2:app/b.brp source=s2 user imported imports=4+2 diagnostics=0+0",
			"  import i4 relative ./a parents=0 parts=a items=[] -> m1:app/a.brp",
			(
				"  import i5 relative ./shared parents=0 parts=shared items=[] -> m3:app/shared."
				+ "brp"
			),
			"module m3:app/shared.brp source=s3 user imported imports=6+1 diagnostics=0+0",
			"  import i6 relative ./main parents=0 parts=main items=[] -> m0:app/main.brp",
		],
	)


func test_duplicate_roots_and_a_missing_root() -> Bool:
	dumps_as(
		{"app/main.brp" => ""},
		["app/main.brp", "app/./main.brp", "app/missing.brp"],
		[
			"root r0 app/main.brp -> m0:app/main.brp",
			"root r1 app/./main.brp -> m0:app/main.brp",
			"root r2 app/missing.brp -> unloaded",
			"root diagnostic r2 UnresolvedRootDiagnostic",
			"module m0:app/main.brp source=s0 user root imports=0+0 diagnostics=0+0",
		],
	)


func test_requests_resolve_by_kind_and_unresolved_imports_are_rows() -> Bool:
	dumps_as(
		{
			"app/main.brp" => "import:\n\tlist_tools\n\tlocal_mod\n\tpkg/net/http as H: get\n\tmissing: thing\n\t../lib/util\n",
			"app/local_mod.brp" => "",
			"lib/util.brp" => "",
			"std/list_tools.brp" => "import:\n\t./helpers\n\tlocal_mod\n",
			"std/helpers.brp" => "",
			"pkg/net/http.brp" => "import:\n\t./codec\n",
			"pkg/net/codec.brp" => "",
		},
		["app/main.brp"],
		[
			"root r0 app/main.brp -> m0:app/main.brp",
			"module m0:app/main.brp source=s0 user root imports=0+5 diagnostics=0+0",
			(
				"  import i0 bare list_tools parents=0 parts=list_tools items=[] -> m1:std/"
				+ "list_tools.brp"
			),
			(
				"  import i1 bare local_mod parents=0 parts=local_mod items=[] -> m2:app/"
				+ "local_mod.brp"
			),
			(
				"  import i2 native-package pkg/net/http parents=0 parts=pkg/net/http as H "
				+ "items=[get] -> m3:pkg/net/http.brp"
			),
			"  import i3 bare missing parents=0 parts=missing items=[thing] -> unresolved",
			(
				"  import i4 relative ../lib/util parents=1 parts=lib/util items=[] -> m4:lib/"
				+ "util.brp"
			),
			(
				"module m1:std/list_tools.brp source=s1 stdlib imported imports=5+2 "
				+ "diagnostics=0+0"
			),
			(
				"  import i5 relative ./helpers parents=0 parts=helpers items=[] -> m5:std/"
				+ "helpers.brp"
			),
			"  import i6 bare local_mod parents=0 parts=local_mod items=[] -> unresolved",
			"module m2:app/local_mod.brp source=s2 user imported imports=7+0 diagnostics=0+0",
			(
				"module m3:pkg/net/http.brp source=s3 package imported package=net imports=7+1 "
				+ "diagnostics=0+0"
			),
			(
				"  import i7 relative ./codec parents=0 parts=codec items=[] -> m6:pkg/net/codec."
				+ "brp"
			),
			"module m4:lib/util.brp source=s4 user imported imports=8+0 diagnostics=0+0",
			"module m5:std/helpers.brp source=s5 stdlib imported imports=8+0 diagnostics=0+0",
			(
				"module m6:pkg/net/codec.brp source=s6 package imported package=net imports=8+0 "
				+ "diagnostics=0+0"
			),
			"  resolution diagnostic UnresolvedImportDiagnostic s0@56-70 3",
			"  resolution diagnostic UnresolvedImportDiagnostic s1@20-29 6",
		],
	)


---
Whether every import row of `tables` has the request text its path span holds in
its source, as the importer wrote it.
---
func import_texts_match_their_source_spelling(tables: FrontendTables) -> Bool:
	var matching: Bool = True

	for index in 0..tables.import_count():
		match tables.import_row_at(index):
			Some(row):
				written: String = tables
					.source_text(row.path_span.span_source())
					.substring(row.path_span.span_start(), row.path_span.span_length())
				matching = matching and tables.import_request_text(row) == written
			None:
				matching = False

	matching


func test_an_import_request_text_built_from_its_structure_is_the_text_the_source_wrote() -> Bool:
	-- Every kind of request, with parents, aliases, items and a deep path.
	match (
		discovered(
			{
				"app/main.brp" => "import:\n\tlist_tools\n\tlocal_mod as L\n\tpkg/net/http as H: get\n\t../lib/util\n\t./sub/deep/leaf: x\n\t../../up/there\n",
				"app/local_mod.brp" => "",
				"app/sub/deep/leaf.brp" => "",
				"lib/util.brp" => "",
				"up/there.brp" => "",
				"std/list_tools.brp" => "",
				"pkg/net/http.brp" => "",
			},
			["app/main.brp"],
		)
	):
		Some(tables):
			tables.import_count() == 6 and tables.import_texts_match_their_source_spelling()
		None:
			False


func test_import_spelled_in_another_case_is_a_case_mismatch_not_a_second_module() -> Bool:
	dumps_as(
		{
			"app/main.brp" => "import:\n\t./sub/Helper\n\t./sub/helper\n\t../lib/util\n\tlocal\n",
			"app/sub/Helper.brp" => "",
			"lib/Util.brp" => "",
			"app/Local.brp" => "",
		},
		["app/main.brp"],
		[
			"root r0 app/main.brp -> m0:app/main.brp",
			"module m0:app/main.brp source=s0 user root imports=0+4 diagnostics=0+0",
			(
				"  import i0 relative ./sub/Helper parents=0 parts=sub/Helper items=[] -> m1:app/"
				+ "sub/Helper.brp"
			),
			(
				"  import i1 relative ./sub/helper parents=0 parts=sub/helper items=[] -> "
				+ "unresolved"
			),
			"  import i2 relative ../lib/util parents=1 parts=lib/util items=[] -> unresolved",
			"  import i3 bare local parents=0 parts=local items=[] -> unresolved",
			"module m1:app/sub/Helper.brp source=s1 user imported imports=4+0 diagnostics=0+0",
			(
				"  resolution diagnostic ImportCaseMismatchDiagnostic s0@23-35 1 stored=sub/"
				+ "Helper.brp"
			),
			(
				"  resolution diagnostic ImportCaseMismatchDiagnostic s0@37-48 2 stored=lib/Util."
				+ "brp"
			),
			"  resolution diagnostic ImportCaseMismatchDiagnostic s0@50-55 3 stored=Local.brp",
		],
	)


func test_a_module_imported_twice_is_one_module_and_a_case_variant_is_a_mismatch() -> Bool:
	dumps_as(
		{"app/main.brp" => "import:\n\t./Helper\n\t./Helper\n\t./helper\n", "app/Helper.brp" => ""},
		["app/main.brp"],
		[
			"root r0 app/main.brp -> m0:app/main.brp",
			"module m0:app/main.brp source=s0 user root imports=0+3 diagnostics=0+0",
			(
				"  import i0 relative ./Helper parents=0 parts=Helper items=[] -> m1:app/Helper."
				+ "brp"
			),
			(
				"  import i1 relative ./Helper parents=0 parts=Helper items=[] -> m1:app/Helper."
				+ "brp"
			),
			"  import i2 relative ./helper parents=0 parts=helper items=[] -> unresolved",
			"module m1:app/Helper.brp source=s1 user imported imports=3+0 diagnostics=0+0",
			(
				"  resolution diagnostic ImportCaseMismatchDiagnostic s0@29-37 2 stored=Helper."
				+ "brp"
			),
		],
	)


func test_an_exactly_spelled_source_wins_over_a_variant_and_a_miss_stays_unresolved() -> Bool:
	dumps_as(
		{"app/main.brp" => "import:\n\t./a\n\t./b\n", "app/a.brp" => "", "app/A.brp" => ""},
		["app/main.brp"],
		[
			"root r0 app/main.brp -> m0:app/main.brp",
			"module m0:app/main.brp source=s0 user root imports=0+2 diagnostics=0+0",
			"  import i0 relative ./a parents=0 parts=a items=[] -> m1:app/a.brp",
			"  import i1 relative ./b parents=0 parts=b items=[] -> unresolved",
			"module m1:app/a.brp source=s1 user imported imports=2+0 diagnostics=0+0",
			"  resolution diagnostic UnresolvedImportDiagnostic s0@14-17 1",
		],
	)


func test_a_root_spelled_in_another_case_is_a_root_case_mismatch() -> Bool:
	dumps_as(
		{"app/main.brp" => ""},
		["app/Main.brp"],
		[
			"root r0 app/Main.brp -> unloaded",
			"root diagnostic r0 RootCaseMismatchDiagnostic stored=main.brp",
		],
	)


func test_respelled_import_text_replaces_the_components_the_provider_spelled_differently() -> Bool:
	respelled_import_text(
		"./sub/helper",
		["sub", "Helper.brp"],
	) == "./sub/Helper" and respelled_import_text(
		"../lib/util",
		["lib", "Util.brp"],
	) == "../lib/Util" and respelled_import_text(
		"local",
		["Local.brp"],
	) == "Local" and respelled_import_text(
		"pkg/net/http",
		["net", "Http.brp"],
	) == "pkg/net/Http" and respelled_import_text(
		"./Main",
		["Extra", "Main.brp"],
	) == "./Main"


---
An in-memory provider whose listing of one directory is replaced, to show how
the module graph treats listings it cannot trust.
---
record ListingOverrideProvider {
	inner: InMemorySourceProvider,
	directory: String,
	listing: DirectoryListing
}


implements SourceProvider for ListingOverrideProvider:
	func source_exists(self: ListingOverrideProvider, path: String) -> Bool:
		self.inner.source_exists(path)

	func directory_listing(self: ListingOverrideProvider, directory: String) -> DirectoryListing:
		if directory == self.directory:
			self.listing
		else:
			self.inner.directory_listing(directory)

	func read_source(self: ListingOverrideProvider, path: String) -> SourceRead:
		self.inner.read_source(path)


---
Discovery of `app/main.brp` over `sources` with the listing of `directory`
replaced, rendered as the test dumps render it.
---
func dump_with_listing_override(directory: String, listing: DirectoryListing) -> Option[String]:
	provider: ListingOverrideProvider = {
		inner = {sources = {"app/main.brp" => "import:\n\t./sub/a\n", "app/sub/a.brp" => ""}},
		directory = directory,
		listing = listing
	}

	match discover(provider, LOOKUP_ROOTS, ["app/main.brp"], NO_IMPLICIT_MODULES):
		FrozenTables(tables):
			Some(tables.tables_dump())
		TableInvariantsViolated(_):
			None


func test_an_unlistable_directory_is_reported_not_trusted() -> Bool:
	match dump_with_listing_override("./app/sub", DirectoryUnreadable):
		Some(dump):
			(
				dump.contains(
					"import i0 relative ./sub/a parents=0 parts=sub/a items=[] -> unresolved",
				)
				and dump.contains("resolution diagnostic UnverifiableSpellingDiagnostic s0@")
			)
		None:
			False


func test_a_component_the_listing_lacks_is_trusted_to_the_provider() -> Bool:
	-- Only a proven case difference is rejected: a name the listing does not
	-- hold (a normalization difference, say) is left to `source_exists`.
	match dump_with_listing_override("./app/sub", DirectoryListed([])):
		Some(dump):
			dump.contains(
				"import i0 relative ./sub/a parents=0 parts=sub/a items=[] -> m1:app/sub/a.brp",
			)
		None:
			False


func test_bare_request_prefers_the_standard_library_over_a_local_module() -> Bool:
	dumps_as(
		{"app/main.brp" => "import:\n\tshadow\n", "app/shadow.brp" => "", "std/shadow.brp" => ""},
		["app/main.brp"],
		[
			"root r0 app/main.brp -> m0:app/main.brp",
			"module m0:app/main.brp source=s0 user root imports=0+1 diagnostics=0+0",
			"  import i0 bare shadow parents=0 parts=shadow items=[] -> m1:std/shadow.brp",
			"module m1:std/shadow.brp source=s1 stdlib imported imports=1+0 diagnostics=0+0",
		],
	)


func test_import_items_symbols_variants_and_aliases_are_rows() -> Bool:
	dumps_as(
		{
			"app/main.brp" => "import:\n\t./kinds as K: Shape(Circle, Square,), area as shape_area, debug\n\t./more:\n\t\tfirst, second\n\t\tthird as last,\n\n",
			"app/kinds.brp" => "",
			"app/more.brp" => "",
		},
		["app/main.brp"],
		[
			"root r0 app/main.brp -> m0:app/main.brp",
			"module m0:app/main.brp source=s0 user root imports=0+2 diagnostics=0+0",
			(
				"  import i0 relative ./kinds parents=0 parts=kinds as K items=[Shape(Circle, "
				+ "Square), area as shape_area, debug] -> m1:app/kinds.brp"
			),
			(
				"  import i1 relative ./more parents=0 parts=more items=[first, second, third as "
				+ "last] -> m2:app/more.brp"
			),
			"module m1:app/kinds.brp source=s1 user imported imports=2+0 diagnostics=0+0",
			"module m2:app/more.brp source=s2 user imported imports=2+0 diagnostics=0+0",
		],
	)


func test_malformed_import_headers_are_diagnostic_rows_of_their_module() -> Bool:
	dumps_as(
		{
			"app/main.brp" => "import\n\t./a\n",
			"app/other.brp" => "import: ./a\n",
			"app/a.brp" => "",
		},
		["app/main.brp", "app/other.brp"],
		[
			"root r0 app/main.brp -> m0:app/main.brp",
			"root r1 app/other.brp -> m1:app/other.brp",
			"module m0:app/main.brp source=s0 user root imports=0+1 diagnostics=0+1",
			"  import i0 relative ./a parents=0 parts=a items=[] -> m2:app/a.brp",
			"module m1:app/other.brp source=s1 user root imports=1+1 diagnostics=1+2",
			"  import i1 relative ./a parents=0 parts=a items=[] -> m2:app/a.brp",
			"module m2:app/a.brp source=s2 user imported imports=2+0 diagnostics=3+0",
			"  diagnostic ExpectedColonAfterImportDiagnostic s0@8-8",
			"  diagnostic ExpectedNewlineAfterImportHeaderDiagnostic s1@8-8",
			"  diagnostic ExpectedIndentedImportsDiagnostic s1@8-8",
		],
	)


func test_malformed_import_items_report_each_problem() -> Bool:
	dumps_as(
		{
			"app/main.brp" => "import:\n\t./a: b c\n\t./a: X()\n\t./a as import\n\t/x\n",
			"app/a.brp" => "",
		},
		["app/main.brp"],
		[
			"root r0 app/main.brp -> m0:app/main.brp",
			"module m0:app/main.brp source=s0 user root imports=0+3 diagnostics=0+4",
			"  import i0 relative ./a parents=0 parts=a items=[b, c] -> m1:app/a.brp",
			"  import i1 relative ./a parents=0 parts=a items=[X] -> m1:app/a.brp",
			"  import i2 relative ./a parents=0 parts=a items=[] -> m1:app/a.brp",
			"module m1:app/a.brp source=s1 user imported imports=3+0 diagnostics=4+0",
			"  diagnostic ExpectedCommaBetweenImportSymbolsDiagnostic s0@16-16",
			"  diagnostic ExpectedConstructorNameDiagnostic s0@26-26",
			"  diagnostic ExpectedAliasNameDiagnostic s0@36-36",
			"  diagnostic ExpectedModulePathDiagnostic s0@44-44",
		],
	)


func test_identical_inputs_produce_identical_tables() -> Bool:
	sources: Dict[String, String] = {
		"app/main.brp" => "import:\n\t./a\n\tlist_tools\n\t./b\n",
		"app/a.brp" => "import:\n\t./b\n",
		"app/b.brp" => "import:\n\t./a\n\tmissing\n",
		"std/list_tools.brp" => "",
	}

	match (discovered(sources, ["app/main.brp"]), discovered(sources, ["app/main.brp"])):
		(Some(first), Some(second)):
			first.tables_dump() == second.tables_dump()
		_:
			False


func test_module_import_blocks_are_contiguous_and_in_module_order() -> Bool:
	sources: Dict[String, String] = {
		"app/main.brp" => "import:\n\t./a\n\t./b\n",
		"app/a.brp" => "import:\n\t./b\n\t./c\n",
		"app/b.brp" => "import:\n\t./c\n",
		"app/c.brp" => "",
	}

	match discovered(sources, ["app/main.brp"]):
		Some(tables):
			var next_first: Int = 0
			var contiguous: Bool = True

			for index in 0..module_count(tables):
				imports: RowRange = tables.module_row(module_id_at_row(index)).imports

				if imports.first != next_first:
					contiguous = False

				next_first = imports.first + imports.count

			contiguous and next_first == tables.import_count()
		None:
			False


func test_source_too_large_to_span_is_rejected_with_a_row() -> Bool:
	huge: String = "a".repeat(SPAN_OFFSET_LIMIT)
	dumps_as(
		{"app/main.brp" => "import:\n\t./huge\n", "app/huge.brp" => huge},
		["app/main.brp"],
		[
			"root r0 app/main.brp -> m0:app/main.brp",
			"module m0:app/main.brp source=s0 user root imports=0+1 diagnostics=0+0",
			"  import i0 relative ./huge parents=0 parts=huge items=[] -> unresolved",
			"  resolution diagnostic ImportSourceTooLargeDiagnostic s0@9-15 16777216",
		],
	)


PRELUDE_SOURCES: Dict[String, String] = {
	"app/main.brp" => "import:\n\t./a\n",
	"app/a.brp" => "",
	"std/prelude.brp" => "import:\n\toption\n",
	"std/tuple.brp" => "import:\n\tresult\n",
	"std/option.brp" => "",
	"std/result.brp" => "",
	"std/test.brp" => "import:\n\toption\n",
}


func test_implicit_modules_load_after_the_roots_and_before_any_import() -> Bool:
	dumps_as_with(
		PRELUDE_SOURCES,
		["app/main.brp"],
		compiler_implicit_modules(),
		[
			"root r0 app/main.brp -> m0:app/main.brp",
			"implicit i0 prelude -> m1:std/prelude.brp",
			"implicit i1 tuple -> m2:std/tuple.brp",
			"module m0:app/main.brp source=s0 user root imports=0+1 diagnostics=0+0",
			"  import i0 relative ./a parents=0 parts=a items=[] -> m3:app/a.brp",
			"module m1:std/prelude.brp source=s1 stdlib implicit imports=1+1 diagnostics=0+0",
			"  import i1 bare option parents=0 parts=option items=[] -> m4:std/option.brp",
			"module m2:std/tuple.brp source=s2 stdlib implicit imports=2+1 diagnostics=0+0",
			"  import i2 bare result parents=0 parts=result items=[] -> m5:std/result.brp",
			"module m3:app/a.brp source=s3 user imported imports=3+0 diagnostics=0+0",
			"module m4:std/option.brp source=s4 stdlib imported imports=3+0 diagnostics=0+0",
			"module m5:std/result.brp source=s5 stdlib imported imports=3+0 diagnostics=0+0",
		],
	)


func test_a_root_that_is_an_implicit_module_is_not_loaded_twice() -> Bool:
	dumps_as_with(
		PRELUDE_SOURCES,
		["std/prelude.brp"],
		compiler_implicit_modules(),
		[
			"root r0 std/prelude.brp -> m0:std/prelude.brp",
			"implicit i0 prelude -> m0:std/prelude.brp",
			"implicit i1 tuple -> m1:std/tuple.brp",
			"module m0:std/prelude.brp source=s0 user root imports=0+1 diagnostics=0+0",
			"  import i0 bare option parents=0 parts=option items=[] -> m2:std/option.brp",
			"module m1:std/tuple.brp source=s1 stdlib implicit imports=1+1 diagnostics=0+0",
			"  import i1 bare result parents=0 parts=result items=[] -> m3:std/result.brp",
			"module m2:std/option.brp source=s2 stdlib imported imports=2+0 diagnostics=0+0",
			"module m3:std/result.brp source=s3 stdlib imported imports=2+0 diagnostics=0+0",
		],
	)


func test_a_missing_implicit_module_is_a_diagnostic_row() -> Bool:
	dumps_as_with(
		{"app/main.brp" => "", "std/prelude.brp" => ""},
		["app/main.brp"],
		compiler_implicit_modules(),
		[
			"root r0 app/main.brp -> m0:app/main.brp",
			"implicit i0 prelude -> m1:std/prelude.brp",
			"implicit i1 tuple -> unloaded",
			"implicit diagnostic i1 MissingImplicitModuleDiagnostic",
			"module m0:app/main.brp source=s0 user root imports=0+0 diagnostics=0+0",
			"module m1:std/prelude.brp source=s1 stdlib implicit imports=0+0 diagnostics=0+0",
		],
	)


func test_the_test_runtime_is_an_implicit_module_when_testing() -> Bool:
	dumps_as_with(
		PRELUDE_SOURCES,
		["app/a.brp"],
		test_implicit_modules(),
		[
			"root r0 app/a.brp -> m0:app/a.brp",
			"implicit i0 prelude -> m1:std/prelude.brp",
			"implicit i1 tuple -> m2:std/tuple.brp",
			"implicit i2 test -> m3:std/test.brp",
			"module m0:app/a.brp source=s0 user root imports=0+0 diagnostics=0+0",
			"module m1:std/prelude.brp source=s1 stdlib implicit imports=0+1 diagnostics=0+0",
			"  import i0 bare option parents=0 parts=option items=[] -> m4:std/option.brp",
			"module m2:std/tuple.brp source=s2 stdlib implicit imports=1+1 diagnostics=0+0",
			"  import i1 bare result parents=0 parts=result items=[] -> m5:std/result.brp",
			"module m3:std/test.brp source=s3 stdlib implicit imports=2+1 diagnostics=0+0",
			"  import i2 bare option parents=0 parts=option items=[] -> m4:std/option.brp",
			"module m4:std/option.brp source=s4 stdlib imported imports=3+0 diagnostics=0+0",
			"module m5:std/result.brp source=s5 stdlib imported imports=3+0 diagnostics=0+0",
		],
	)


---
A provider that finds every source but reads none: the located file cannot be
read (a permission error, a file removed after listing).
---
record UnreadableSourceProvider {
	inner: InMemorySourceProvider
}


implements SourceProvider for UnreadableSourceProvider:
	func source_exists(self: UnreadableSourceProvider, path: String) -> Bool:
		self.inner.source_exists(path)

	func directory_listing(self: UnreadableSourceProvider, directory: String) -> DirectoryListing:
		self.inner.directory_listing(directory)

	func read_source(self: UnreadableSourceProvider, path: String) -> SourceRead:
		SourceUnreadable


func test_a_source_that_exists_but_cannot_be_read_is_an_unreadable_diagnostic() -> Bool:
	provider: UnreadableSourceProvider = {
		inner = {sources = {"app/main.brp" => "import:\n\t./a\n", "app/a.brp" => ""}},
	}

	match discover(provider, LOOKUP_ROOTS, ["app/main.brp"], NO_IMPLICIT_MODULES):
		FrozenTables(tables):
			tables.tables_dump() == [
				"root r0 app/main.brp -> unloaded",
				"root diagnostic r0 UnreadableRootSourceDiagnostic",
			].join("\n")
		TableInvariantsViolated(_):
			False


---
A provider holding an empty source under every `.brp` path, so a test can ask
for more sources than a span can number without building them as a map.
---
record EverySourceProvider {
	nothing: Bool
}


implements SourceProvider for EverySourceProvider:
	func source_exists(self: EverySourceProvider, path: String) -> Bool:
		path.ends_with(".brp")

	func directory_listing(self: EverySourceProvider, directory: String) -> DirectoryListing:
		DirectoryListed([])

	func read_source(self: EverySourceProvider, path: String) -> SourceRead:
		SourceText("")


func test_more_sources_than_a_span_can_number_report_too_many_sources() -> Bool:
	var roots: List[String] = []

	for number in 0..MAX_SOURCE_COUNT + 1:
		roots = roots.append("s${number}.brp")

	provider: EverySourceProvider = {nothing = True}

	match discover(provider, LOOKUP_ROOTS, roots, NO_IMPLICIT_MODULES):
		FrozenTables(tables):
			-- The first MAX_SOURCE_COUNT sources load; the next root is rejected,
			-- and it is the only rejection.
			rejection_is_the_last_root: Bool = match tables.root_rejection(
				root_id_at_row(MAX_SOURCE_COUNT),
			):
				Some(RootTooManySources):
					True
				_:
					False

			(
				tables.module_count() == MAX_SOURCE_COUNT
				and tables.root_count() == MAX_SOURCE_COUNT + 1
				and tables.rejected_root_count() == 1
				and rejection_is_the_last_root
			)
		TableInvariantsViolated(_):
			False


func test_a_seed_spelled_in_another_case_is_a_missing_implicit_module() -> Bool:
	dumps_as_with(
		{"std/Prelude.brp" => ""},
		[],
		{module_names = ["prelude"]},
		[
			"implicit i0 prelude -> unloaded",
			"implicit diagnostic i0 MissingImplicitModuleDiagnostic",
		],
	)


func test_an_unreadable_seed_is_an_unreadable_diagnostic() -> Bool:
	provider: UnreadableSourceProvider = {inner = {sources = {"std/prelude.brp" => ""}}}

	match discover(provider, LOOKUP_ROOTS, [], {module_names = ["prelude"]}):
		FrozenTables(tables):
			tables.tables_dump() == [
				"implicit i0 prelude -> unloaded",
				"implicit diagnostic i0 UnreadableImplicitSourceDiagnostic",
			].join("\n")
		TableInvariantsViolated(_):
			False


