		),
		(
			"import cycle and shared import load each module once",
			test_import_cycle_and_shared_import_load_each_module_once,
		),
		("duplicate roots and a missing root", test_duplicate_roots_and_a_missing_root),
		(
			"requests resolve by kind and unresolved imports are rows",
			test_requests_resolve_by_kind_and_unresolved_imports_are_rows,
		),
		(
			"an import request text built from its structure is the text the source wrote",
			test_an_import_request_text_built_from_its_structure_is_the_text_the_source_wrote,
		),
		(
			"import spelled in another case is a case mismatch, not a second module",
			test_import_spelled_in_another_case_is_a_case_mismatch_not_a_second_module,
		),
		(
			"a module imported twice is one module and a case variant is a mismatch",
