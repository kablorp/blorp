-- `IdMint`: every id is minted with its node, numbered within its module and
-- family from zero; a parent is built after its parts, so it gets the larger
-- id; and definitions and imports are indexed at their ids in the same call.
import:
	../../../../src/compiler_new/stage_01_discovery/syntax/declarations: RecordDeclarationForm(OrdinaryRecord)
	../../../../src/compiler_new/stage_01_discovery/syntax/definitions:
		Definition(FieldDefinition, RecordDefinition),
	../../../../src/compiler_new/stage_01_discovery/syntax/expressions:
		BinaryOperator(Add, Multiply),
		Expression,
		ExpressionKind(Binary, NameReference, VoidValue),
		IfExpression,
		StatementKind(ExpressionStatement),
	../../../../src/compiler_new/stage_01_discovery/syntax/ids:
		SYNTAX_ID_MODULE_BITS,
		binder_local_index,
		block_local_index,
		definition_local_index,
		dimension_local_index,
		expression_local_index,
		expression_module,
		import_local_index,
		issued,
		minted_binder,
		minted_block,
		minted_dimension,
		minted_else_if,
		minted_expression,
		minted_field,
		minted_hole,
		minted_import,
		minted_name_use,
		minted_pattern,
		minted_record,
		minted_statement,
		minted_subscript_place,
		minted_type_binder,
		minted_written_type,
		name_use_local_index,
		name_use_module,
		new_id_mint,
		pattern_local_index,
		statement_local_index,
		type_binder_local_index,
		written_type_local_index,
	../../../../src/compiler_new/stage_01_discovery/syntax/imports:
		ModulePath,
		PathAnchor(BareAnchor),
	../../../../src/compiler_new/stage_01_discovery/syntax/names: WrittenName
	../../../../src/compiler_new/stage_01_discovery/syntax/patterns: PatternKind(WildcardPattern)
	../../../../src/compiler_new/stage_01_discovery/syntax/sequences: AtLeastOne
	../../../../src/compiler_new/stage_01_discovery/syntax/spellings:
		interned_spelling,
		new_spellings,
	../../../../src/compiler_new/stage_01_discovery/syntax/types:
		DimensionKind(WildcardDimension),
		WrittenTypeKind(VoidType),
	../../../../src/compiler_new/stage_01_discovery/tables/ids:
		ModuleId,
		module_id_at_row,
		module_id_index,
		source_id_at_row,
	../../../../src/compiler_new/stage_01_discovery/tables/row_kinds: Visibility(PublicVisibility)
	../../../../src/compiler_new/stage_01_discovery/tables/span: Span, pack_span, power_of_two
	test: TestSuite


MODULE_INDEX: Int = 3


pure func module() -> ModuleId:
	module_id_at_row(MODULE_INDEX)


pure func at(start: Int, end: Int) -> Span:
	pack_span(source_id_at_row(MODULE_INDEX), start, end)


---
The name `text` written at `start`, as a spelling of the test module.
---
pure func name(text: String, start: Int) -> WrittenName:
	(_, spelling) = new_spellings(module()).interned_spelling(text, 0, text.length())
	{
		spelling = spelling,
		span = at(start, start + text.length())
	}


pure func test_each_family_counts_from_zero_within_its_module() -> Bool:
	(m1, first) = new_id_mint(module()).minted_expression(
		at(0, 1),
		VoidValue,
	)
	(m2, second) = m1.minted_expression(
		at(2, 3),
		VoidValue,
	)
	(m3, statement) = m2.minted_statement(
		at(0, 3),
		ExpressionStatement(second),
	)
	(m4, block) = m3.minted_block(
		[],
		statement,
		at(0, 3),
	)
	(m5, pattern) = m4.minted_pattern(
		at(4, 5),
		WildcardPattern,
	)
	(m6, written_type) = m5.minted_written_type(
		at(6, 8),
		VoidType,
	)
	(m7, dimension) = m6.minted_dimension(
		at(9, 11),
		WildcardDimension,
	)
	(m8, use) = m7.minted_name_use(name("x", 12))
	(m9, binder) = m8.minted_binder(name("y", 14))
	(_, type_binder) = m9.minted_type_binder(name("T", 16))
	(
		first.id.expression_local_index() == 0
		and second.id.expression_local_index() == 1
		and statement.id.statement_local_index() == 0
		and block.id.block_local_index() == 0
		and pattern.id.pattern_local_index() == 0
		and written_type.id.written_type_local_index() == 0
		and dimension.id.dimension_local_index() == 0
		and use.use.name_use_local_index() == 0
		and binder.binder.binder_local_index() == 0
		and type_binder.binder.type_binder_local_index() == 0
	)


pure func test_an_id_carries_the_module_of_its_mint() -> Bool:
	(_, here) = new_id_mint(module()).minted_expression(
		at(0, 1),
		VoidValue,
	)
	(_, there) = new_id_mint(module_id_at_row(MODULE_INDEX + 1)).minted_expression(
		at(0, 1),
		VoidValue,
	)
	(
		here.id
			.expression_module()
			.module_id_index() == MODULE_INDEX
		and there.id
			.expression_module()
			.module_id_index() == MODULE_INDEX + 1
		and here.id.expression_local_index() == there.id.expression_local_index()
	)


pure func test_the_largest_module_index_round_trips() -> Bool:
	largest: Int = power_of_two(SYNTAX_ID_MODULE_BITS) - 1
	(m1, _) = new_id_mint(module_id_at_row(largest)).minted_name_use(name("a", 0))
	(_, use) = m1.minted_name_use(name("b", 2))
	(
		use.use
			.name_use_module()
			.module_id_index() == largest
		and use.use.name_use_local_index() == 1
	)


pure func test_the_else_if_hole_and_place_take_expression_ids() -> Bool:
	(m1, condition) = new_id_mint(module()).minted_expression(
		at(0, 1),
		VoidValue,
	)
	(m2, value) = m1.minted_expression(
		at(2, 3),
		VoidValue,
	)
	(m3, statement) = m2.minted_statement(
		at(2, 3),
		ExpressionStatement(value),
	)
	(m4, block) = m3.minted_block(
		[],
		statement,
		at(2, 3),
	)
	conditional: IfExpression = {
		condition = condition,
		then_block = block,
		else_branch = None
	}
	(m5, else_if) = m4.minted_else_if(
		at(0, 3),
		conditional,
	)
	(m6, held) = m5.minted_expression(
		at(4, 5),
		VoidValue,
	)
	(m7, hole) = m6.minted_hole(
		held,
		at(3, 6),
	)
	(m8, collection) = m7.minted_expression(
		at(7, 8),
		VoidValue,
	)
	(m9, index) = m8.minted_expression(
		at(9, 10),
		VoidValue,
	)
	indices: AtLeastOne[Expression] = {
		first = index,
		rest = []
	}
	(m10, place) = m9.minted_subscript_place(
		at(7, 11),
		collection,
		indices,
	)
	(_, next) = m10.minted_expression(
		at(12, 13),
		VoidValue,
	)
	(
		else_if.id.expression_local_index() == 2
		and hole.id.expression_local_index() == 4
		and place.id.expression_local_index() == 7
		and next.id.expression_local_index() == 8
	)


---
`(a + b) * c`, built as the parser builds it: each node after its parts.
---
pure func test_a_node_is_numbered_after_its_parts() -> Bool:
	(m1, a_use) = new_id_mint(module()).minted_name_use(name("a", 1))
	(m2, a) = m1.minted_expression(
		at(1, 2),
		NameReference(a_use),
	)
	(m3, b_use) = m2.minted_name_use(name("b", 5))
	(m4, b) = m3.minted_expression(
		at(5, 6),
		NameReference(b_use),
	)
	(m5, sum) = m4.minted_expression(
		at(0, 7),
		Binary(Add, a, b),
	)
	(m6, c_use) = m5.minted_name_use(name("c", 10))
	(m7, c) = m6.minted_expression(
		at(10, 11),
		NameReference(c_use),
	)
	(_, product) = m7.minted_expression(
		at(0, 11),
		Binary(Multiply, sum, c),
	)
	-- The sum's subtree is 0 ..= 2, ending at its root; the product's is
	-- 0 ..= 4. Name uses are in source order.
	(
		a.id.expression_local_index() == 0
		and b.id.expression_local_index() == 1
		and sum.id.expression_local_index() == 2
		and c.id.expression_local_index() == 3
		and product.id.expression_local_index() == 4
		and c_use.use.name_use_local_index() == 2
	)


pure func test_issued_counts_every_family() -> Bool:
	(m1, use) = new_id_mint(module()).minted_name_use(name("a", 0))
	(m2, a) = m1.minted_expression(
		at(0, 1),
		NameReference(use),
	)
	(m3, statement) = m2.minted_statement(
		at(0, 1),
		ExpressionStatement(a),
	)
	(m4, _) = m3.minted_block(
		[],
		statement,
		at(0, 1),
	)
	(m5, _) = m4.minted_pattern(
		at(2, 3),
		WildcardPattern,
	)
	(m6, _) = m5.minted_pattern(
		at(4, 5),
		WildcardPattern,
	)
	(m7, _) = m6.minted_written_type(
		at(6, 8),
		VoidType,
	)
	(m8, _) = m7.minted_binder(name("x", 9))
	ids = m8.issued()
	(
		ids.counts.expressions == 1
		and ids.counts.statements == 1
		and ids.counts.blocks == 1
		and ids.counts.patterns == 2
		and ids.counts.written_types == 1
		and ids.counts.dimensions == 0
		and ids.counts.name_uses == 1
		and ids.counts.binders == 1
		and ids.counts.type_binders == 0
		and ids.definitions.is_empty()
		and ids.imports.is_empty()
	)


---
`record Point { x: (), y: () }`: the fields are minted first, so they get
the smaller definition ids, and each definition sits in the index at its id.
---
pure func test_definitions_are_indexed_at_their_ids() -> Bool:
	(m1, x_type) = new_id_mint(module()).minted_written_type(
		at(17, 19),
		VoidType,
	)
	(m2, x) = m1.minted_field(
		name("x", 14),
		x_type,
		at(14, 19),
	)
	(m3, y_type) = m2.minted_written_type(
		at(24, 26),
		VoidType,
	)
	(m4, y) = m3.minted_field(
		name("y", 21),
		y_type,
		at(21, 26),
	)
	(m5, point) = m4.minted_record(
		PublicVisibility,
		None,
		OrdinaryRecord,
		name(
			"Point",
			7,
		),
		[],
		[x, y],
		at(
			0,
			28,
		),
	)
	definitions: List[Definition] = m5.issued().definitions
	(
		x.id.definition_local_index() == 0
		and y.id.definition_local_index() == 1
		and point.id.definition_local_index() == 2
		and definitions.length() == 3
		and indexed_field_index(definitions, 0) == Some(0)
		and indexed_field_index(definitions, 1) == Some(1)
		and indexed_record_fields(definitions, 2) == Some(2)
	)


---
The id of the field at `position` of the definitions index, if it is a
field.
---
pure func indexed_field_index(definitions: List[Definition], position: Int) -> Option[Int]:
	match definitions.get(position):
		Some(FieldDefinition(field)):
			Some(field.id.definition_local_index())
		_:
			None


---
How many fields the record at `position` of the definitions index holds, if
it is a record whose id is `position`.
---
pure func indexed_record_fields(definitions: List[Definition], position: Int) -> Option[Int]:
	match definitions.get(position):
		Some(RecordDefinition(declaration)):
			if declaration.id.definition_local_index() == position:
				Some(declaration.fields.length())
			else:
				None
		_:
			None


pure func test_imports_are_indexed_at_their_ids() -> Bool:
	first_path: ModulePath = {
		anchor = BareAnchor,
		parts = {
			first = name("heap", 1),
			rest = []
		}
	}
	second_path: ModulePath = {
		anchor = BareAnchor,
		parts = {
			first = name("list", 7),
			rest = []
		}
	}
	(m1, first) = new_id_mint(module()).minted_import(
		first_path,
		None,
		[],
		at(1, 5),
		at(1, 5),
	)
	(m2, second) = m1.minted_import(
		second_path,
		Some(name("L", 15)),
		[],
		at(7, 11),
		at(7, 16),
	)
	imports = m2.issued().imports
	(
		first.id.import_local_index() == 0
		and second.id.import_local_index() == 1
		and imports.length() == 2
		and imports.map(pure func(row): row.id.import_local_index()) == [0, 1]
	)


tests: TestSuite = {
	description = "Discovery syntax id mint",
	tests = [
		(
			"each family counts from zero within its module",
			test_each_family_counts_from_zero_within_its_module,
		),
		("an id carries the module of its mint", test_an_id_carries_the_module_of_its_mint),
		("the largest module index round trips", test_the_largest_module_index_round_trips),
		(
			"the else if, hole and place take expression ids",
			test_the_else_if_hole_and_place_take_expression_ids,
		),
		("a node is numbered after its parts", test_a_node_is_numbered_after_its_parts),
		("issued counts every family", test_issued_counts_every_family),
		("definitions are indexed at their ids", test_definitions_are_indexed_at_their_ids),
		("imports are indexed at their ids", test_imports_are_indexed_at_their_ids),
	]
}
