-- The checked literal values: an integer's magnitude is exact up to the
-- Int128 maximum, and a float is made only from well-formed, finite digits.
import:
	../../../../src/compiler_new/stage_01_discovery/syntax/checked_values:
		checked_integer,
		decimal_float,
		parent_step_count,
		parent_steps,
		positive_count,
		positive_count_value,
		to_float,
		written_digits,
	test: TestSuite


INT128_MAX_DIGITS: String = "170141183460469231731687303715884105727"

INT128_MAX_PLUS_ONE_DIGITS: String = "170141183460469231731687303715884105728"


pure func integer_of(digits: String) -> Option[Int128]:
	checked_integer(digits, 0, digits.length())


pure func test_small_integers_keep_their_value() -> Bool:
	(
		integer_of("0") == Some(to_int128(0))
		and integer_of("7") == Some(to_int128(7))
		and integer_of("1234567890") == Some(to_int128(1234567890))
	)


pure func test_leading_zeros_are_written_digits_not_value() -> Bool:
	(
		integer_of("007") == Some(to_int128(7))
		and integer_of(
			"000000000000000000000000000000000000000000000000000000012",
		) == Some(to_int128(12))
		and integer_of("0000") == Some(to_int128(0))
	)


pure func test_integers_around_the_int_boundary_are_exact() -> Bool:
	-- 18 digits fit an Int; 19 and more are assembled in Int128.
	eighteen: Option[Int128] = integer_of("999999999999999999")
	nineteen: Option[Int128] = integer_of("1000000000000000000")
	twenty: Option[Int128] = integer_of("12345678901234567890")
	(
		eighteen == Some(to_int128(999999999999999999))
		and nineteen == Some(to_int128(1000000000000000000))
		and twenty.map(
			pure func(value): value / to_int128(10),
		) == Some(to_int128(1234567890123456789))
	)


pure func test_the_int128_maximum_is_accepted_and_one_more_is_not() -> Bool:
	maximum: Option[Int128] = integer_of(INT128_MAX_DIGITS)

	match maximum:
		Some(value):
			(
				value > to_int128(0)
				and value + to_int128(1) < to_int128(0)
				and integer_of(INT128_MAX_PLUS_ONE_DIGITS).is_none()
			)
		None:
			False


pure func test_the_maximum_with_leading_zeros_is_still_accepted() -> Bool:
	(
		integer_of("000" + INT128_MAX_DIGITS).is_some()
		and integer_of("000" + INT128_MAX_PLUS_ONE_DIGITS).is_none()
	)


pure func test_longer_integers_are_rejected() -> Bool:
	(
		integer_of(INT128_MAX_DIGITS + "0").is_none()
		and integer_of("999999999999999999999999999999999999999999").is_none()
	)


pure func test_a_slice_of_a_longer_text_is_read_by_its_bounds() -> Bool:
	text: String = "a 42 b"
	checked_integer(text, 2, 4) == Some(to_int128(42))


pure func test_decimal_float_keeps_its_written_digits() -> Bool:
	match decimal_float("007.50"):
		Some(value):
			value.written_digits() == "007.50" and value.to_float() == 7.5
		None:
			False


pure func test_decimal_float_rejects_malformed_digits() -> Bool:
	(
		decimal_float("").is_none()
		and decimal_float(".5").is_none()
		and decimal_float("5.").is_none()
		and decimal_float("1.2.3").is_none()
		and decimal_float("1e5").is_none()
		and decimal_float("-1.5").is_none()
		and decimal_float("1 .5").is_none()
	)


pure func test_decimal_float_accepts_a_whole_number_of_digits() -> Bool:
	decimal_float("42").is_some()


pure func test_decimal_float_rejects_a_value_that_is_not_finite() -> Bool:
	too_large: String = "1" + "0".repeat(400) + ".0"
	decimal_float(too_large).is_none() and decimal_float("1" + "0".repeat(300) + ".0").is_some()


pure func count_of(value: Int128) -> Option[Int]:
	positive_count(value).map(pure func(count): count.positive_count_value())


pure func test_a_positive_count_is_one_or_more_within_int() -> Bool:
	int_maximum: Int128 = to_int128(9223372036854775807)
	(
		count_of(to_int128(1)) == Some(1)
		and count_of(int_maximum) == Some(9223372036854775807)
		and count_of(to_int128(0)).is_none()
		and count_of(to_int128(-3)).is_none()
		and count_of(int_maximum + to_int128(1)).is_none()
	)


pure func test_parent_steps_are_one_or_more() -> Bool:
	(
		parent_steps(1).map(pure func(steps): steps.parent_step_count()) == Some(1)
		and parent_steps(3).map(pure func(steps): steps.parent_step_count()) == Some(3)
		and parent_steps(0).is_none()
		and parent_steps(-1).is_none()
	)


tests: TestSuite = {
	description = "Discovery checked literal values",
	tests = [
		("small integers keep their value", test_small_integers_keep_their_value),
		(
			"leading zeros are written digits, not value",
			test_leading_zeros_are_written_digits_not_value,
		),
		(
			"integers around the Int boundary are exact",
			test_integers_around_the_int_boundary_are_exact,
		),
		(
			"the Int128 maximum is accepted and one more is not",
			test_the_int128_maximum_is_accepted_and_one_more_is_not,
		),
		(
			"the maximum with leading zeros is still accepted",
			test_the_maximum_with_leading_zeros_is_still_accepted,
		),
		("longer integers are rejected", test_longer_integers_are_rejected),
		(
			"a slice of a longer text is read by its bounds",
			test_a_slice_of_a_longer_text_is_read_by_its_bounds,
		),
		("a decimal float keeps its written digits", test_decimal_float_keeps_its_written_digits),
		("a decimal float rejects malformed digits", test_decimal_float_rejects_malformed_digits),
		(
			"a decimal float accepts a whole number of digits",
			test_decimal_float_accepts_a_whole_number_of_digits,
		),
		(
			"a decimal float rejects a value that is not finite",
			test_decimal_float_rejects_a_value_that_is_not_finite,
		),
		(
			"a positive count is one or more within Int",
			test_a_positive_count_is_one_or_more_within_int,
		),
		("parent steps are one or more", test_parent_steps_are_one_or_more),
	]
}
