pure func sample_span() -> Span:
	pack_span(0, 0, 1)


pure func main_name() -> NameId:
	-- `main` is a seeded spelling, so it names a real row in every builder.
	name_id_at_row(73)


---
The text of every test source: long enough for `sample_span`.
---
SAMPLE_SOURCE_TEXT: String = "f(x)\n"


---
Appends one source over `path_text` and opens the module over it.
---
pure func open_module_over_source(
	builder: DiscoveryBuilder,
	path_text: String,
) -> (DiscoveryBuilder, ModuleOpening):
	path: PathId = builder.next_path_id()
	var out: DiscoveryBuilder = builder.append_path(path_text)
	out = out.append_source(
		SAMPLE_SOURCE_TEXT,
		{
			path = path,
			line_starts = EMPTY_ROW_RANGE
		},
	)
	(out, out.open_module(path, UserModule, RootModule))


---
Appends a function in `module` whose body is `f(x)`: two identifier leaves,
then the call node over them.
---
pure func add_function_with_body(builder: DiscoveryBuilder, module: ModuleId) -> DiscoveryBuilder:
	definition: DefinitionId = builder.next_definition_id()
	var out: DiscoveryBuilder = builder.append_definition({
		module = module,
		kind = FunctionDefinition,
		name = main_name(),
		name_span = sample_span(),
		visibility = PublicVisibility,
		span = sample_span(),
	})
	callee: NodeId = out.next_node_id()
	out = out.append_node({
		kind = IdentifierNode,
		span = sample_span(),
		payload = 0,
		children = EMPTY_ROW_RANGE,
	})
	argument: NodeId = out.next_node_id()
	out = out.append_node({
		kind = IdentifierNode,
		span = sample_span(),
		payload = 0,
		children = EMPTY_ROW_RANGE,
	})
	first_child: Int = out.next_node_child_row()
	out = out.append_node_child(callee)
	out = out.append_node_child(argument)
	out = out.append_node({
		kind = CallNode,
		span = sample_span(),
		payload = 0,
		children = {
			first = first_child,
			count = 2
		},
	})
	out = out.append_signature({
		definition = definition,
		purity = ImpureFunction,
		keyword_span = sample_span(),
		parameters = EMPTY_ROW_RANGE,
	})
	root: NodeId = out.last_node_id()
	out = out.append_body({
		definition = definition,
		root = root,
	})
	out


---
A module at `path_text` holding one function whose body is `f(x)`, closed.
---
pure func add_module_with_function(
	builder: DiscoveryBuilder,
	path_text: String,
) -> DiscoveryBuilder:
	(opened, opening) = builder.open_module_over_source(path_text)
	module: ModuleId = opening.opened_module()
	opened
		.add_function_with_body(module)
		.close_module(opening)


---
One module holding one function with a three-node body: every invariant
holds.
---
pure func well_formed_builder() -> DiscoveryBuilder:
	empty_discovery_builder().add_module_with_function("main.brp")


pure func has_violation(
	violations: List[TableInvariantViolation],
	kind: TableInvariantKind,
	table: DiscoveryTable,
) -> Bool:
	violations.any(pure func(found): found.kind == kind and found.table == table)


pure func violations_of(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	builder.check_table_invariants(ALL_SEEDED_NAME_SPELLINGS)


pure func test_well_formed_builder_has_no_violations() -> Bool:
	violations_of(well_formed_builder()).is_empty()


---
`freeze` moves each list of the builder into the field of the same name, and
four fields hold the same type, so a swap would still type-check. A builder
with a different number of distinct entries in each text table, frozen, must
read each entry back through its own accessor.
---
pure func test_freeze_keeps_each_text_table_in_its_own_field() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder()
	name: NameId = builder.next_name_id()
	builder = builder.append_name("freeze_probe_name")
	literal: LiteralId = literal_id_at_row(builder.literals.length())
	builder = builder.append_literal("freeze_probe_literal")
	builder = builder.append_literal("freeze_probe_literal_two")
	builder = builder.append_literal("freeze_probe_literal_three")
	builder = builder.append_literal("freeze_probe_literal_four")
	path: PathId = builder.next_path_id()
	builder = builder.append_path("freeze/probe/path.brp")
	source: SourceId = builder.next_source_id()
	builder = builder.admit_source("freeze/probe/source.brp", "freeze probe source text")

	match builder.freeze():
		FrozenTables(tables):
			counts: List[Int] = [
				tables.name_count(),
				tables.path_count(),
				tables.literal_count(),
				tables.source_count(),
			]
			distinct: Bool = counts.all(pure func(count): counts
					.filter(pure func(other): other == count)
					.length() == 1)

			(
				distinct
				and tables.name_spelling(name) == "freeze_probe_name"
				and tables.literal_text(literal) == "freeze_probe_literal"
				and tables.path_text(path) == "freeze/probe/path.brp"
				and tables.source_text(source) == "freeze probe source text"
				and tables.name_count() == builder.name_spellings.length()
				and tables.path_count() == builder.paths.length()
				and tables.literal_count() == builder.literals.length()
				and tables.source_count() == builder.sources.length()
			)
		TableInvariantsViolated(_):
			False


pure func test_empty_builder_has_no_violations() -> Bool:
	violations_of(empty_discovery_builder()).is_empty()


pure func test_definition_naming_a_missing_module_is_a_dangling_reference() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder()
	missing_module: ModuleId = builder.next_module_id()
	builder = builder.append_definition({
		module = missing_module,
		kind = FunctionDefinition,
		name = main_name(),
		name_span = sample_span(),
		visibility = PublicVisibility,
		span = sample_span(),
	})
	has_violation(builder.violations_of(), DanglingReference, DefinitionTable)


pure func first_module_of(builder: DiscoveryBuilder) -> ModuleId:
	match builder.definitions.get(0):
		Some(definition):
			definition.module
		None:
			builder.next_module_id()


pure func test_node_whose_child_is_not_appended_first_is_reported() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder()
	parent: NodeId = builder.next_node_id()
	first_child: Int = builder.next_node_child_row()
	-- The parent's only child is the parent itself: not appended before it.
	builder = builder.append_node_child(parent)
	builder = builder.append_node({
		kind = CallNode,
		span = sample_span(),
		payload = 0,
		children = {
			first = first_child,
			count = 1
		},
	})
	has_violation(builder.violations_of(), NodeChildNotBeforeParent, NodeTable)


pure func test_body_root_in_another_module_is_reported() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder()
	builder = builder.add_module_with_function("second.brp")
	-- A body of the first module's function whose root is the second
	-- module's call node.
	root: NodeId = builder.last_node_id()
	builder = builder.append_body({
		definition = builder.first_definition(),
		root = root,
	})
	has_violation(builder.violations_of(), BodyRootOutsideModule, BodyTable)


pure func first_definition(builder: DiscoveryBuilder) -> DefinitionId:
	match builder.bodies.get(0):
		Some(body):
			body.definition
		None:
			builder.next_definition_id()


pure func test_moved_seeded_name_is_reported() -> Bool:
	-- Checked against a vocabulary with its first two spellings swapped.
	reordered: List[String] = ["func", ""].concat(ALL_SEEDED_NAME_SPELLINGS.drop(2))
	has_violation(
		check_table_invariants(well_formed_builder(), reordered),
		SeededNameMoved,
		NameTable,
	)


pure func test_intern_index_pointing_at_the_wrong_row_is_reported() -> Bool:
	builder: DiscoveryBuilder = well_formed_builder()
	-- An index that has lost every entry: no name is found at its row.
	skewed: DiscoveryBuilder = { builder | name_slots = empty_slots(INITIAL_SLOT_COUNT) }
	has_violation(skewed.violations_of(), InternIndexMismatch, NameTable)


pure func test_source_text_without_a_source_row_is_reported() -> Bool:
	builder: DiscoveryBuilder = well_formed_builder()
	skewed: DiscoveryBuilder = { builder | source_texts = builder.source_texts.append("orphan") }
	has_violation(skewed.violations_of(), ParallelTableMismatch, SourceTable)


pure func test_freeze_refuses_a_violating_builder_when_checking() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder()
	parent: NodeId = builder.next_node_id()
	first_child: Int = builder.next_node_child_row()
	builder = builder.append_node_child(parent)
	builder = builder.append_node({
		kind = CallNode,
		span = sample_span(),
		payload = 0,
		children = {
			first = first_child,
			count = 1
		},
	})

	match builder.freeze():
		FrozenTables(_):
			False
		TableInvariantsViolated(violations):
			has_violation(violations, NodeChildNotBeforeParent, NodeTable)


pure func test_freeze_seals_a_well_formed_builder() -> Bool:
	match freeze(well_formed_builder()):
		FrozenTables(_):
			True
		TableInvariantsViolated(_):
			False


pure func with_a_token(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	builder.append_token({
		kind = EndOfFileToken,
		span = sample_span(),
		payload = NO_TOKEN_PAYLOAD,
	})


pure func test_freeze_drops_the_transient_tokens() -> Bool:
	match freeze(with_a_token(well_formed_builder())):
		FrozenTables(_):
			True
		TableInvariantsViolated(_):
			False


pure func test_span_naming_a_missing_source_is_reported() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder()
	-- The well-formed builder has one source; source index 7 names none.
	builder = builder.append_definition({
		module = builder.first_module_of(),
		kind = FunctionDefinition,
		name = main_name(),
		name_span = sample_span(),
		visibility = PublicVisibility,
		span = pack_span(7, 0, 1),
	})
	has_violation(builder.violations_of(), SpanOutsideSources, DefinitionTable)


pure func test_local_function_node_naming_a_top_level_function_is_reported() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder()
	-- Definition 0 of the well-formed builder is a top-level function.
	builder = builder.append_node({
		kind = LocalFunctionNode,
		span = sample_span(),
		payload = 0,
		children = EMPTY_ROW_RANGE,
	})
	has_violation(builder.violations_of(), LocalFunctionNodeMismatch, NodeTable)


---
The well-formed builder with one more leaf node of `kind` carrying `payload`.
---
pure func with_payload_node(kind: NodeKind, payload: Int) -> DiscoveryBuilder:
	append_node(
		well_formed_builder(),
		{
			kind = kind,
			span = sample_span(),
			payload = payload,
			children = EMPTY_ROW_RANGE
		},
	)


---
An index past every table of the well-formed builder.
---
MISSING_ROW: Int = 1000000


pure func test_name_payload_naming_no_name_is_a_dangling_reference() -> Bool:
	has_violation(
		violations_of(with_payload_node(IdentifierNode, MISSING_ROW)),
		DanglingReference,
		NodeTable,
	)


pure func test_literal_payload_naming_no_literal_is_a_dangling_reference() -> Bool:
	has_violation(
		violations_of(with_payload_node(IntegerLiteralNode, MISSING_ROW)),
		DanglingReference,
		NodeTable,
	)


pure func test_codepoint_payload_outside_unicode_is_reported() -> Bool:
	-- A surrogate is no Unicode scalar value.
	has_violation(
		violations_of(with_payload_node(CharLiteralNode, 55296)),
		PayloadOutOfRange,
		NodeTable,
	)


pure func test_definition_payload_naming_no_definition_is_a_dangling_reference() -> Bool:
	has_violation(
		violations_of(with_payload_node(LocalFunctionNode, MISSING_ROW)),
		DanglingReference,
		NodeTable,
	)


pure func test_payload_on_a_kind_without_one_is_reported() -> Bool:
	has_violation(violations_of(with_payload_node(BreakNode, 1)), PayloadOutOfRange, NodeTable)


pure func test_a_node_with_a_child_count_its_kind_forbids_is_reported() -> Bool:
	-- A call has at least its callee, and a `break` has no children: the node
	-- table alone cannot tell, only the kind's arity in `node_schema` can.
	var with_child: DiscoveryBuilder = well_formed_builder()
	first_child: Int = with_child.next_node_child_row()
	with_child = with_child.append_node_child(node_id_at_row(0))
	with_child = with_child.append_node({
		kind = BreakNode,
		span = sample_span(),
		payload = NO_NODE_PAYLOAD,
		children = {
			first = first_child,
			count = 1
		},
	})
	(
		not has_violation(violations_of(well_formed_builder()), NodeArityMismatch, NodeTable)
		and has_violation(
			violations_of(with_payload_node(CallNode, 0)),
			NodeArityMismatch,
			NodeTable,
		)
		and has_violation(violations_of(with_child), NodeArityMismatch, NodeTable)
	)


pure func test_node_no_row_references_is_reported() -> Bool:
	has_violation(violations_of(with_payload_node(BreakNode, 0)), UnreferencedNode, NodeTable)


pure func test_node_that_is_two_nodes_child_is_reported() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder()
	-- The body's callee leaf becomes a child of a second parent too.
	first_child: Int = builder.next_node_child_row()
	builder = builder.append_node_child(node_id_at_row(0))
	builder = builder.append_node({
		kind = CallNode,
		span = sample_span(),
		payload = 0,
		children = {
			first = first_child,
			count = 1
		},
	})
	has_violation(builder.violations_of(), NodeReferencedTwice, NodeTable)


pure func test_second_body_for_a_definition_is_reported() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder()
	-- The definition's body is node 2; a second body row names the callee.
	builder = builder.append_body({
		definition = definition_id_at_row(0),
		root = node_id_at_row(0),
	})
	has_violation(builder.violations_of(), DuplicateSideRow, BodyTable)


pure func test_root_loading_a_missing_module_is_a_dangling_reference() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder()
	builder = builder.append_root({
		request_path = path_id_at_row(0),
		outcome = RootLoaded(module_id_at_row(99)),
	})
	has_violation(builder.violations_of(), DanglingReference, RootTable)


pure func test_a_rejected_root_naming_a_missing_path_is_a_dangling_reference() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder()
	builder = builder.append_root({
		request_path = path_id_at_row(0),
		outcome = RootRejected(RootCaseMismatch(path_id_at_row(99))),
	})
	has_violation(builder.violations_of(), DanglingReference, RootTable)


pure func test_function_without_signature_is_reported() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder()
	builder = builder.append_definition({
		module = builder.first_module_of(),
		kind = FunctionDefinition,
		name = main_name(),
		name_span = sample_span(),
		visibility = PublicVisibility,
		span = sample_span(),
	})
	has_violation(builder.violations_of(), SignatureCountMismatch, DefinitionTable)


pure func test_span_past_the_end_of_its_source_is_reported() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder()
	builder = builder.append_definition({
		module = builder.first_module_of(),
		kind = ConstantDefinition,
		name = main_name(),
		name_span = sample_span(),
		visibility = PublicVisibility,
		span = pack_span(0, 0, 100),
	})
	has_violation(builder.violations_of(), SpanPastSourceEnd, DefinitionTable)


-- Diagnostic references.
pure func with_syntax_diagnostic(diagnostic: SyntaxDiagnostic) -> DiscoveryBuilder:
	well_formed_builder().append_syntax_diagnostic(sample_span(), diagnostic)


pure func with_resolution_diagnostic(diagnostic: ResolutionDiagnostic) -> DiscoveryBuilder:
	well_formed_builder().append_resolution_diagnostic_at(sample_span(), diagnostic)


pure func test_a_construct_diagnostic_has_no_violation() -> Bool:
	violations_of(
		with_syntax_diagnostic(ExpectedToken(ExpectedColon(ColonInIfCondition))),
	).is_empty()


pure func test_a_diagnostic_naming_no_name_is_reported() -> Bool:
	has_violation(
		violations_of(with_syntax_diagnostic(UnknownAnnotation(name_id_at_row(MISSING_ROW)))),
		DanglingReference,
		DiagnosticTable,
	)


pure func test_a_diagnostic_naming_a_name_is_accepted() -> Bool:
	violations_of(with_syntax_diagnostic(UnknownAnnotation(main_name()))).is_empty()


pure func test_a_diagnostic_naming_no_import_is_reported() -> Bool:
	has_violation(
		violations_of(with_resolution_diagnostic(UnresolvedImport(import_id_at_row(MISSING_ROW)))),
		DanglingReference,
		ResolutionDiagnosticTable,
	)


pure func test_a_diagnostic_naming_no_stored_path_is_reported() -> Bool:
	has_violation(
		violations_of(
			with_resolution_diagnostic(
				ImportCaseMismatch(
					import_id_at_row(0),
					path_id_at_row(MISSING_ROW),
				),
			),
		),
		DanglingReference,
		ResolutionDiagnosticTable,
	)


pure func test_a_diagnostic_naming_no_literal_is_reported() -> Bool:
	has_violation(
		violations_of(
			with_syntax_diagnostic(IntegerLiteralOverflow(literal_id_at_row(MISSING_ROW))),
		),
		DanglingReference,
		DiagnosticTable,
	)


---
A bound on the first definition's first type parameter, named `main`.
---
pure func with_bound(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	builder.append_bound({
		owner = definition_id_at_row(0),
		parameter_ordinal = 0,
		trait_name = main_name(),
		name_span = sample_span(),
		span = sample_span(),
	})


---
A supertrait of the first definition, named `main`.
---
pure func with_supertrait(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	builder.append_supertrait({
		trait_definition = definition_id_at_row(0),
		ordinal = 0,
		name = main_name(),
		name_span = sample_span(),
		span = sample_span(),
	})


pure func test_qualifier_of_a_missing_bound_is_a_dangling_reference() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder().with_bound()
	builder = builder.append_bound_qualifier({
		bound = bound_id_at_row(1),
		qualifier = main_name(),
		span = sample_span(),
	})
	has_violation(builder.violations_of(), DanglingReference, BoundQualifierTable)


pure func test_bound_with_two_qualifiers_is_reported() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder().with_bound()
	row: BoundQualifierRow = {
		bound = bound_id_at_row(0),
		qualifier = main_name(),
		span = sample_span()
	}
	builder = builder
		.append_bound_qualifier(row)
		.append_bound_qualifier(row)
	has_violation(builder.violations_of(), DuplicateSideRow, BoundQualifierTable)


pure func test_bound_qualifiers_out_of_bound_order_are_reported() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder()
		.with_bound()
		.with_bound()
	builder = builder.append_bound_qualifier({
		bound = bound_id_at_row(1),
		qualifier = main_name(),
		span = sample_span(),
	})
	builder = builder.append_bound_qualifier({
		bound = bound_id_at_row(0),
		qualifier = main_name(),
		span = sample_span(),
	})
	has_violation(builder.violations_of(), SideTableUnsorted, BoundQualifierTable)


pure func test_supertrait_with_two_qualifiers_is_reported() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder().with_supertrait()
	row: SupertraitQualifierRow = {
		supertrait = supertrait_id_at_row(0),
		qualifier = main_name(),
		span = sample_span()
	}
	builder = builder
		.append_supertrait_qualifier(row)
		.append_supertrait_qualifier(row)
	has_violation(builder.violations_of(), DuplicateSideRow, SupertraitQualifierTable)


pure func test_qualifier_span_past_the_end_of_its_source_is_reported() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder().with_bound()
	builder = builder.append_bound_qualifier({
		bound = bound_id_at_row(0),
		qualifier = main_name(),
		span = pack_span(0, 0, 100),
	})
	has_violation(builder.violations_of(), SpanPastSourceEnd, BoundQualifierTable)


pure func test_bound_qualifier_outside_its_bound_is_reported() -> Bool:
	-- The bound spans bytes 0 to 1; the qualifier spans 1 to 2.
	var builder: DiscoveryBuilder = well_formed_builder().with_bound()
	builder = builder.append_bound_qualifier({
		bound = bound_id_at_row(0),
		qualifier = main_name(),
		span = pack_span(0, 1, 2),
	})
	has_violation(builder.violations_of(), QualifierOutsideReference, BoundQualifierTable)


pure func test_supertrait_qualifier_outside_its_supertrait_is_reported() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder().with_supertrait()
	builder = builder.append_supertrait_qualifier({
		supertrait = supertrait_id_at_row(0),
		qualifier = main_name(),
		span = pack_span(0, 1, 2),
	})
	has_violation(builder.violations_of(), QualifierOutsideReference, SupertraitQualifierTable)


pure func test_qualifier_inside_its_bound_is_accepted() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder().with_bound()
	builder = builder.append_bound_qualifier({
		bound = bound_id_at_row(0),
		qualifier = main_name(),
		span = sample_span(),
	})
	builder
		.violations_of()
		.is_empty()


pure func test_bound_name_outside_its_reference_is_reported() -> Bool:
	-- The bound spans bytes 0 to 1; its name span claims 1 to 2.
	builder: DiscoveryBuilder = well_formed_builder().append_bound({
		owner = definition_id_at_row(0),
		parameter_ordinal = 0,
		trait_name = main_name(),
		name_span = pack_span(0, 1, 2),
		span = sample_span(),
	})
	has_violation(builder.violations_of(), NameSpanOutsideItsSpan, BoundTable)


pure func test_name_inside_its_reference_is_accepted() -> Bool:
	well_formed_builder()
		.with_bound()
		.with_supertrait()
		.violations_of()
		.is_empty()


pure func test_import_path_outside_its_import_is_reported() -> Bool:
	var builder: DiscoveryBuilder = well_formed_builder()
	path: PathId = builder.next_path_id()
	builder = builder.append_path("heap")
	opening: ImportOpening = builder.open_import(
		builder.first_module_of(),
		BareModuleRequest,
		0,
		sample_span(),
	)
	builder = builder.close_import(
		opening,
		path,
		pack_span(0, 1, 2),
		sample_span(),
	)
	has_violation(builder.violations_of(), NameSpanOutsideItsSpan, ImportTable)


pure func test_name_span_of_a_missing_node_is_a_dangling_reference() -> Bool:
	builder: DiscoveryBuilder = well_formed_builder().append_node_name_span({
		node = node_id_at_row(MISSING_ROW),
		name_span = sample_span(),
	})
	has_violation(builder.violations_of(), DanglingReference, NodeNameSpanTable)


pure func test_name_span_on_a_node_without_a_separate_name_is_reported() -> Bool:
	-- Node 0 is an identifier leaf, whose name is the whole node.
	builder: DiscoveryBuilder = well_formed_builder().append_node_name_span({
		node = node_id_at_row(0),
		name_span = sample_span(),
	})
	has_violation(builder.violations_of(), NameSpanOnWrongNodeKind, NodeNameSpanTable)


pure func test_name_spans_of_one_node_twice_are_reported() -> Bool:
	row: NodeNameSpanRow = {
		node = node_id_at_row(0),
		name_span = sample_span()
	}
	builder: DiscoveryBuilder = well_formed_builder()
		.append_node_name_span(row)
		.append_node_name_span(row)
	has_violation(builder.violations_of(), SideTableUnsorted, NodeNameSpanTable)


pure func test_a_dimension_name_needs_its_hash_spelling() -> Bool:
	missing: DiscoveryBuilder = well_formed_builder().append_node({
		kind = DimensionNameTypeNode,
		span = sample_span(),
		payload = main_name().name_id_index(),
		children = EMPTY_ROW_RANGE,
	})
	sigil: NameId = missing.next_name_id()
	spelled: DiscoveryBuilder = missing
		.append_name("#main")
		.append_dimension_name({
			name = main_name(),
			sigil_name = sigil,
		})
	(
		has_violation(missing.violations_of(), DimensionSigilNameMissing, NodeTable)
		and not has_violation(spelled.violations_of(), DimensionSigilNameMissing, NodeTable)
	)


pure func test_a_dimension_name_row_must_spell_the_sigil_and_the_name() -> Bool:
	sigil: NameId = well_formed_builder().next_name_id()
	builder: DiscoveryBuilder = well_formed_builder()
		.append_name("#other")
		.append_dimension_name({
			name = main_name(),
			sigil_name = sigil,
		})
	has_violation(builder.violations_of(), SigilSpellingMismatch, DimensionNameTable)


pure func test_a_named_type_with_arguments_needs_a_name_span() -> Bool:
	-- A leaf argument, then `Name[argument]` over it, without a name span row.
	var builder: DiscoveryBuilder = well_formed_builder()
	argument: NodeId = builder.next_node_id()
	builder = builder.append_node({
		kind = NamedTypeNode,
		span = sample_span(),
		payload = main_name().name_id_index(),
		children = EMPTY_ROW_RANGE,
	})
	first_child: Int = builder.next_node_child_row()
	builder = builder.append_node_child(argument)
	builder = builder.append_node({
		kind = NamedTypeNode,
		span = sample_span(),
		payload = main_name().name_id_index(),
		children = {
			first = first_child,
			count = 1
		},
	})
	generic: NodeId = builder.last_node_id()
	with_row: DiscoveryBuilder = builder.append_node_name_span({
		node = generic,
		name_span = sample_span(),
	})
	(
		has_violation(builder.violations_of(), NodeNameSpanMissing, NodeTable)
		and not has_violation(with_row.violations_of(), NodeNameSpanMissing, NodeTable)
	)


---
`builder` with `count` identifier leaves and an `IfNode` over them: two are the
condition and the then block, a third is an else branch.
---
pure func with_if_over(builder: DiscoveryBuilder, count: Int) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder
	var leaves: List[NodeId] = []

	for position in 0..count:
		leaves = leaves.append(out.next_node_id())
		out = out.append_node({
			kind = IdentifierNode,
			span = sample_span(),
			payload = main_name().name_id_index(),
			children = EMPTY_ROW_RANGE,
		})

	first_child: Int = out.next_node_child_row()

	for leaf in leaves:
		out = out.append_node_child(leaf)

	out.append_node({
		kind = IfNode,
		span = sample_span(),
		payload = 0,
		children = {
			first = first_child,
			count = count
		},
	})


pure func test_an_if_with_an_else_branch_needs_its_else_keyword() -> Bool:
	without_row: DiscoveryBuilder = with_if_over(well_formed_builder(), 3)
	if_node: NodeId = without_row.last_node_id()
	with_row: DiscoveryBuilder = without_row.append_else_keyword({
		node = if_node,
		keyword_span = sample_span(),
	})
	(
		has_violation(without_row.violations_of(), ElseKeywordMismatch, NodeTable)
		and not has_violation(with_row.violations_of(), ElseKeywordMismatch, NodeTable)
		and not has_violation(with_row.violations_of(), ElseKeywordMismatch, ElseKeywordTable)
	)


pure func test_an_else_keyword_belongs_to_an_if_with_an_else_branch() -> Bool:
	-- An `IfNode` with only a condition and a then block has no else keyword,
	-- and neither has a node of another kind.
	without_else: DiscoveryBuilder = with_if_over(well_formed_builder(), 2)
	on_if: DiscoveryBuilder = without_else.append_else_keyword({
		node = without_else.last_node_id(),
		keyword_span = sample_span(),
	})
	on_leaf: DiscoveryBuilder = well_formed_builder().append_else_keyword({
		node = node_id_at_row(0),
		keyword_span = sample_span(),
	})
	(
		has_violation(on_if.violations_of(), ElseKeywordMismatch, ElseKeywordTable)
		and has_violation(on_leaf.violations_of(), ElseKeywordMismatch, ElseKeywordTable)
	)


pure func test_an_else_keyword_of_a_missing_node_is_a_dangling_reference() -> Bool:
	builder: DiscoveryBuilder = well_formed_builder().append_else_keyword({
		node = node_id_at_row(MISSING_ROW),
		keyword_span = sample_span(),
	})
	has_violation(builder.violations_of(), DanglingReference, ElseKeywordTable)


pure func test_else_keywords_of_one_node_twice_are_reported() -> Bool:
	with_if: DiscoveryBuilder = with_if_over(well_formed_builder(), 3)

	row: ElseKeywordRow = {
		node = with_if.last_node_id(),
		keyword_span = sample_span()
	}
	builder: DiscoveryBuilder = with_if
		.append_else_keyword(row)
		.append_else_keyword(row)
	has_violation(builder.violations_of(), SideTableUnsorted, ElseKeywordTable)


---
Whether a childless node of `kind` needs a name span row: `NodeNameSpanMissing`
is there without one and gone with one.
---
pure func name_span_row_is_required(kind: NodeKind) -> Bool:
	without_row: DiscoveryBuilder = well_formed_builder().append_node({
		kind = kind,
		span = sample_span(),
		payload = main_name().name_id_index(),
		children = EMPTY_ROW_RANGE,
	})
	with_row: DiscoveryBuilder = without_row.append_node_name_span({
		node = without_row.last_node_id(),
		name_span = sample_span(),
	})
	(
		has_violation(without_row.violations_of(), NodeNameSpanMissing, NodeTable)
		and not has_violation(with_row.violations_of(), NodeNameSpanMissing, NodeTable)
	)


pure func test_a_body_node_with_a_name_always_narrower_than_it_needs_a_name_span() -> Bool:
	[
		FieldAccessNode,
		RecordFieldNode,
		SelectReceiveArmNode,
		WithBindingNode,
		WithTryBindingNode,
		WithErrorMapNode,
		ConcurrentParameterNode,
		VarDeclarationNode,
		TypedBindingNode,
		AssignmentNode,
		QuestionBindNode,
		AddAssignNode,
		SubtractAssignNode,
		MultiplyAssignNode,
		DivideAssignNode,
		ConstructorPatternNode,
		QualifiedConstructorPatternNode,
		ListSpreadNameNode,
		ListSpreadWildcardNode,
	].all(name_span_row_is_required)


pure func test_an_untyped_lambda_parameter_is_its_name_alone() -> Bool:
	-- Without a child the name is the whole node and has no row; a typed
	-- parameter (one child) needs one.
	untyped: DiscoveryBuilder = well_formed_builder().append_node({
		kind = LambdaParameterNode,
		span = sample_span(),
		payload = main_name().name_id_index(),
		children = EMPTY_ROW_RANGE,
	})
	typed: DiscoveryBuilder = untyped.append_node({
		kind = LambdaParameterNode,
		span = sample_span(),
		payload = main_name().name_id_index(),
		children = {
			first = 0,
			count = 1
		},
	})
	stray: DiscoveryBuilder = untyped.append_node_name_span({
		node = untyped.last_node_id(),
		name_span = sample_span(),
	})
	(
		not has_violation(untyped.violations_of(), NodeNameSpanMissing, NodeTable)
		and has_violation(typed.violations_of(), NodeNameSpanMissing, NodeTable)
		and has_violation(stray.violations_of(), NameSpanOnWrongNodeKind, NodeNameSpanTable)
	)


pure func test_a_concurrency_count_belongs_to_a_parameter_and_is_positive() -> Bool:
	with_parameter: DiscoveryBuilder = well_formed_builder().append_node({
		kind = ConcurrentParameterNode,
		span = sample_span(),
		payload = main_name().name_id_index(),
		children = EMPTY_ROW_RANGE,
	})
	parameter: NodeId = with_parameter.last_node_id()
	good: DiscoveryBuilder = with_parameter.append_concurrency_count({
		parameter = parameter,
		count = 4,
	})
	not_positive: DiscoveryBuilder = with_parameter.append_concurrency_count({
		parameter = parameter,
		count = 0,
	})
	on_leaf: DiscoveryBuilder = well_formed_builder().append_concurrency_count({
		parameter = node_id_at_row(0),
		count = 4,
	})
	missing: DiscoveryBuilder = well_formed_builder().append_concurrency_count({
		parameter = node_id_at_row(MISSING_ROW),
		count = 4,
	})
	(
		not has_violation(good.violations_of(), ConcurrencyCountMismatch, ConcurrencyCountTable)
		and has_violation(
			not_positive.violations_of(),
			ConcurrencyCountMismatch,
			ConcurrencyCountTable,
		)
		and has_violation(on_leaf.violations_of(), ConcurrencyCountMismatch, ConcurrencyCountTable)
		and has_violation(missing.violations_of(), DanglingReference, ConcurrencyCountTable)
	)


