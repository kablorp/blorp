-- Exact per-family pins guard builder threading with managed discovery rows.
-- The fixed tolerance remains far below one extra copy per 2,000 repeats;
-- larger admitted row costs do not increase tolerated table-copy traffic.
import:
	../../support/raw_rows: append_definition
	../../../../src/compiler_new/stage_01_discovery/pipeline: load_module
	../../../../src/compiler_new/stage_01_discovery/sources/source_provider:
		ModulePlacement(InUserCode),
	../../../../src/compiler_new/stage_01_discovery/tables/builder:
		DiscoveryBuilder,
		empty_discovery_builder,
	../../../../src/compiler_new/stage_01_discovery/tables/ids:
		module_id_at_row,
		name_id_at_row,
		source_id_at_row,
	../../../../src/compiler_new/stage_01_discovery/tables/node_builder: append_plain_leaf_node
	../../../../src/compiler_new/stage_01_discovery/tables/node_kind_classes:
		PlainLeafKind(BreakLeaf),
	../../../../src/compiler_new/stage_01_discovery/tables/row_kinds:
		DefinitionKind(FunctionDefinition),
		ModuleOriginKind(UserModule),
		ModuleReach(RootModule),
		Visibility(PublicVisibility),
	../../../../src/compiler_new/stage_01_discovery/tables/span: pack_span
	memory:
		MemoryCounter(ManagedAllocations, MemoryStatsActive, OracleStatsActive),
		read_memory_counter,
		reset_mem_stats,
	test: TestSuite


---
Statements or rows per measured run.
---
REPEATS: Int = 2000

---
A module that is `prefix` followed by `item` repeated `REPEATS` times; the
names and literals it uses are interned by its first copy.
---
pure func repeated_text(prefix: String, item: String) -> String:
	var text: String = prefix
	var index: Int = 0

	while index < REPEATS:
		text += item
		index += 1

	text


---
The allocations parsing `text` as a module made, or `None` when the parse
rejected it or lost its repeated items: either would pass a budget vacuously.
---
func parse_allocations(text: String) -> Option[Int]:
	reset_mem_stats()
	active_before = read_memory_counter(MemoryStatsActive)
	oracle_before = read_memory_counter(OracleStatsActive)
	builder: DiscoveryBuilder = load_module(
		empty_discovery_builder(),
		{
			path = "budget.brp",
			trusted_directory = ".",
			placement = InUserCode
		},
		RootModule,
		text,
	)
	if (
		builder.diagnostics.length() == 0
		and builder.tokens.length() > REPEATS
		and active_before == 1
		and oracle_before == 1
		and read_memory_counter(MemoryStatsActive) == 1
		and read_memory_counter(OracleStatsActive) == 1
	):
		Some(read_memory_counter(ManagedAllocations))
	else:
		None


---
How far from its pinned count a run of a per-use-allocating family may be.
A builder or table copy per use adds at least one allocation per repeat,
`REPEATS` in all, far above this.
---
EXACT_TOLERANCE: Int = 100


-- Two list-growth sequences plus one DefinitionRow, NodeRow, and child span
-- record per iteration: 6,000 owned products and 20 growth allocations.
private ROW_APPEND_ALLOCATIONS: Int = 6020


---
Whether parsing `item` after `prefix`, `REPEATS` times, allocates within
`EXACT_TOLERANCE` of `expected_allocations`, both ways. Managed discovery rows
allocate per use without enlarging the tolerated overhead. The count is measured,
not derived: a drop is as worth noticing as a rise, so tighten the pin when
an allocation goes away.
---
func family_allocates(prefix: String, item: String, expected_allocations: Int) -> Bool:
	match parse_allocations(repeated_text(prefix, item)):
		Some(allocations):
			(
				allocations > expected_allocations - EXACT_TOLERANCE
				and allocations < expected_allocations + EXACT_TOLERANCE
			)
		None:
			False


---
As `family_allocates`, for statements in one function body.
---
func statement_family_allocates(statement: String, expected_allocations: Int) -> Bool:
	family_allocates("func f(a, b, c, x):\n", statement, expected_allocations)


func test_parsing_repeated_expression_statements_copies_no_table() -> Bool:
	statement_family_allocates("\tx = a + b * c\n", 58152)

func test_parsing_repeated_blocks_and_calls_copies_no_table() -> Bool:
	statement_family_allocates("\tif a > b:\n\t\tf(a, [b, c])\n\telse:\n\t\tx\n", 150159)

func test_parsing_repeated_matches_and_patterns_copies_no_table() -> Bool:
	statement_family_allocates(
		"\tx = match a:\n\t\tSome(v) | Other(v): v\n\t\t(l, 1): l\n\t\t[h, ...t]: h\n\t\t_: b\n",
		262172,
	)

func test_parsing_repeated_selects_copies_no_table() -> Bool:
	statement_family_allocates(
		"\tselect:\n\t\tv from a:\n\t\t\tv\n\t\tsealed b:\n\t\t\tx\n\t\t_ after 5:\n\t\t\tc\n",
		170163,
	)

func test_parsing_repeated_concurrent_blocks_copies_no_table() -> Bool:
	statement_family_allocates(
		"\tconcurrent(timeout: 100, max_threads: 2):\n\t\tl = f(a)\n\t\tr = f(b)\n\tfor p in a concurrently(limit: 4):\n\t\tf(p)\n",
		290174,
	)


func test_parsing_repeated_lambdas_copies_no_table() -> Bool:
	statement_family_allocates(
		"\ty = func(p, q: Int) -> Int: p + q\n\tz = pure func(p):\n\t\tw = p\n\t\tw\n",
		206168,
	)

func test_parsing_repeated_interpolations_copies_no_table() -> Bool:
	-- The `${` is split across two literals so this file does not interpolate it.
	statement_family_allocates("\ty = \"a $" + "{a} b $" + "{b + c}\"\n", 164192)


func test_parsing_repeated_record_literals_and_updates_copies_no_table() -> Bool:
	statement_family_allocates("\ty = {k = a, m = b}\n\tz = {y | k = c, m = a}\n", 166165)

func test_parsing_repeated_loops_copies_no_table() -> Bool:
	statement_family_allocates(
		"\tfor i in 0..a:\n\t\tf(i)\n\twhile a > b:\n\t\tbreak\n\tfor (k, v) in c:\n\t\tcontinue\n",
		238160,
	)

func test_parsing_repeated_question_binds_copies_no_table() -> Bool:
	statement_family_allocates("\tv ?= f(a)\n\tvar w = v\n\tw += 1\n", 102163)

func test_parsing_repeated_function_declarations_copies_no_table() -> Bool:
	family_allocates(
		"",
		"---\nAdds.\n---\npure func g[T: Orderable](p: T, q: Int[#N]) -> List[T] where #N == 3:\n\tp\n\n\n",
		232226,
	)


func test_parsing_repeated_type_declarations_copies_no_table() -> Bool:
	family_allocates(
		"",
		"record R {\n\tfirst: Int,\n\tsecond: Int\n}\n\n\nunion U:\n\tA(Int)\n\tB\n\n\nenum E:\n\tX\n\tY\n\n\ntype alias Al = Int\n\n\n",
		300126,
	)

func test_parsing_repeated_trait_and_impl_declarations_copies_no_table() -> Bool:
	family_allocates(
		"",
		"trait Shape:\n\tpure func area(value: Self) -> Int\n\n\nimplements Shape for R:\n\tpure func area(r: R) -> Int:\n\t\t1\n\n\n",
		248186,
	)

func test_parsing_repeated_imports_copies_no_table() -> Bool:
	family_allocates("import:\n", "\tmath: sin, cos\n\tlist as L: List(Cons, Nil)\n", 90126)

func test_parsing_repeated_collection_literals_copies_no_table() -> Bool:
	statement_family_allocates(
		"\ty = {1 => 2, 3 => 4}\n\tz = {a, b}\n\tw = (a, b, c)\n\tv = [a, b]\n\tu = ()\n\tt = (a)\n",
		316179,
	)

func test_parsing_repeated_tuple_list_and_qualified_patterns_copies_no_table() -> Bool:
	statement_family_allocates(
		"\tx = match a:\n\t\t(l, r): l\n\t\tOption.Some(v): v\n\t\tOption.None: b\n\t\t[]: c\n\t\t[h, ...t]: h\n\t\tSome(Some(v)) | Other(v): v\n\t\t-1: a\n\t\t\"s\": b\n\t\t_: c\n",
		474180,
	)

func test_parsing_repeated_with_scopes_copies_no_table() -> Bool:
	statement_family_allocates("\twith r = f(a):\n\t\tr\n\twith t ?= f(b) on e => e:\n\t\tt\n", 182165)

func test_parsing_repeated_conversions_and_builtins_copies_no_table() -> Bool:
	statement_family_allocates(
		"\tz = builtin(\"x\")\n\tq = into_opaque T(a)\n\tp = from_opaque T(b)\n\tr = builtin\n",
		158168,
	)

func test_parsing_repeated_bindings_and_local_functions_copies_no_table() -> Bool:
	statement_family_allocates("\t(p, q) = a\n\tn: Int = a\n\tfunc g(u):\n\t\tu\n\ta[b] = c\n", 206211)

func test_parsing_repeated_postfix_chains_and_unary_operators_copies_no_table() -> Bool:
	statement_family_allocates(
		"\tx = a.b(c)[d]\n\ty = a\n\t\t.b()\n\t\t.c()\n\tz = not a\n\tw = -a\n\tdetach f(a)\n",
		282172,
	)

func test_parsing_repeated_written_types_copies_no_table() -> Bool:
	family_allocates(
		"",
		"func g[V: Orderable + Equatable](p: Dict[String, List[Int]], f: pure (Int) -> Int, t: (Int, Int), m: Int[#N, #M], k: a.B[C], n: Int[#_...], v: V) -> void:\n\tp\n\n\n",
		488217,
	)


func test_parsing_repeated_foreign_blocks_copies_no_table() -> Bool:
	family_allocates(
		"",
		"foreign(include: \"a.h\", link: \"-lm\"):\n\tpure func c_sin(x: Float) -> Float = \"sin\"\n\tfunc c_puts(s: String) -> Int\n\n\n",
		206184,
	)

func test_parsing_repeated_supertraits_copies_no_table() -> Bool:
	family_allocates(
		"",
		"trait Base:\n\tpure func one(value: Self) -> Int\n\n\ntrait Wide: Base:\n\tpure func two(value: Self) -> Int\n\tfunc three(value: Self) -> Int:\n\t\t3\n\n\n",
		310193,
	)


func test_appending_rows_copies_no_table() -> Bool:
	var builder: DiscoveryBuilder = empty_discovery_builder()
	reset_mem_stats()
	active_before = read_memory_counter(MemoryStatsActive) == 1 and read_memory_counter(OracleStatsActive) == 1
	var index: Int = 0

	while index < REPEATS:
		builder = builder.append_definition({
			module = module_id_at_row(0),
			kind = FunctionDefinition,
			name = name_id_at_row(0),
			name_span = pack_span(source_id_at_row(0), 0, 0),
			visibility = PublicVisibility,
			span = pack_span(source_id_at_row(0), 0, 0),
		})
		builder = builder.append_plain_leaf_node(
			BreakLeaf,
			pack_span(source_id_at_row(0), 0, 0),
		)
		index += 1

	allocations = read_memory_counter(ManagedAllocations)

	(
		active_before and read_memory_counter(MemoryStatsActive) == 1
		and read_memory_counter(OracleStatsActive) == 1
		and builder.definitions.length() == REPEATS
		and builder.nodes.length() == REPEATS
		and allocations > ROW_APPEND_ALLOCATIONS - EXACT_TOLERANCE
		and allocations < ROW_APPEND_ALLOCATIONS + EXACT_TOLERANCE
	)


tests: TestSuite = {
	description = "Discovery allocation budgets",
	tests = [
		(
			"parsing repeated expression statements copies no table",
			test_parsing_repeated_expression_statements_copies_no_table,
		),
		(
			"parsing repeated blocks and calls copies no table",
			test_parsing_repeated_blocks_and_calls_copies_no_table,
		),
		(
			"parsing repeated matches and patterns copies no table",
			test_parsing_repeated_matches_and_patterns_copies_no_table,
		),
		("parsing repeated selects copies no table", test_parsing_repeated_selects_copies_no_table),
		(
			"parsing repeated concurrent blocks copies no table",
			test_parsing_repeated_concurrent_blocks_copies_no_table,
		),
		("parsing repeated lambdas copies no table", test_parsing_repeated_lambdas_copies_no_table),
		(
			"parsing repeated interpolations copies no table",
			test_parsing_repeated_interpolations_copies_no_table,
		),
		(
			"parsing repeated record literals and updates copies no table",
			test_parsing_repeated_record_literals_and_updates_copies_no_table,
		),
		("parsing repeated loops copies no table", test_parsing_repeated_loops_copies_no_table),
		(
			"parsing repeated question binds copies no table",
			test_parsing_repeated_question_binds_copies_no_table,
		),
		(
			"parsing repeated function declarations copies no table",
			test_parsing_repeated_function_declarations_copies_no_table,
		),
		(
			"parsing repeated type declarations copies no table",
			test_parsing_repeated_type_declarations_copies_no_table,
		),
		(
			"parsing repeated trait and impl declarations copies no table",
			test_parsing_repeated_trait_and_impl_declarations_copies_no_table,
		),
		("parsing repeated imports copies no table", test_parsing_repeated_imports_copies_no_table),
		(
			"parsing repeated collection literals copies no table",
			test_parsing_repeated_collection_literals_copies_no_table,
		),
		(
			"parsing repeated tuple list and qualified patterns copies no table",
			test_parsing_repeated_tuple_list_and_qualified_patterns_copies_no_table,
		),
		(
			"parsing repeated with scopes copies no table",
			test_parsing_repeated_with_scopes_copies_no_table,
		),
		(
			"parsing repeated conversions and builtins copies no table",
			test_parsing_repeated_conversions_and_builtins_copies_no_table,
		),
		(
			"parsing repeated bindings and local functions copies no table",
			test_parsing_repeated_bindings_and_local_functions_copies_no_table,
		),
		(
			"parsing repeated postfix chains and unary operators copies no table",
			test_parsing_repeated_postfix_chains_and_unary_operators_copies_no_table,
		),
		(
			"parsing repeated written types copies no table",
			test_parsing_repeated_written_types_copies_no_table,
		),
		(
			"parsing repeated foreign blocks copies no table",
			test_parsing_repeated_foreign_blocks_copies_no_table,
		),
		(
			"parsing repeated supertraits copies no table",
			test_parsing_repeated_supertraits_copies_no_table,
		),
		("appending rows copies no table", test_appending_rows_copies_no_table),
	]
}
