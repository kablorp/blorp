import:
	../../../../src/compiler_new/stage_01_discovery/tables/span:
		SPAN_LENGTH_BITS,
		SPAN_LENGTH_LIMIT,
		SPAN_OFFSET_LIMIT,
		SPAN_SOURCE_BITS,
		SPAN_SOURCE_LIMIT,
		SPAN_START_BITS,
		Span,
		SpanOverflow(LengthOverflow, SourceIndexOverflow, StartOffsetOverflow),
		pack_checked_span,
		pack_span,
		source_fits_span_limits,
		source_index_fits_span,
		span_covering,
		span_end,
		span_length,
		span_source_index,
		span_start,
	test: TestSuite


pure func round_trips(source: Int, start: Int, end: Int) -> Bool:
	span: Span = pack_span(source, start, end)
	(
		span.span_source_index() == source
		and span.span_start() == start
		and span.span_end() == end
		and span.span_length() == end - start
	)


pure func test_span_round_trips_small_values() -> Bool:
	round_trips(0, 0, 0) and round_trips(3, 10, 42)


pure func test_span_round_trips_the_largest_admitted_values() -> Bool:
	largest_offset: Int = SPAN_OFFSET_LIMIT - 1
	(
		round_trips(SPAN_SOURCE_LIMIT - 1, largest_offset, largest_offset)
		and round_trips(SPAN_SOURCE_LIMIT - 1, 0, largest_offset)
	)


pure func test_span_fields_fill_sixty_three_bits() -> Bool:
	-- The packed value must stay a non-negative Int.
	SPAN_SOURCE_BITS + SPAN_START_BITS + SPAN_LENGTH_BITS == 63


pure func test_limits_follow_the_bit_widths() -> Bool:
	SPAN_SOURCE_LIMIT == 32768 and SPAN_OFFSET_LIMIT == 16777216 and SPAN_LENGTH_LIMIT == 16777216


pure func test_admission_rejects_a_source_too_large_to_span() -> Bool:
	(
		source_fits_span_limits(SPAN_OFFSET_LIMIT - 1)
		and not source_fits_span_limits(SPAN_OFFSET_LIMIT)
		and not source_fits_span_limits(-1)
	)


pure func test_admission_rejects_a_source_index_past_the_limit() -> Bool:
	(
		source_index_fits_span(0)
		and source_index_fits_span(SPAN_SOURCE_LIMIT - 1)
		and not source_index_fits_span(SPAN_SOURCE_LIMIT)
	)


pure func test_spans_of_adjacent_sources_do_not_alias() -> Bool:
	last_of_first: Span = pack_span(0, SPAN_OFFSET_LIMIT - 1, SPAN_OFFSET_LIMIT - 1)
	first_of_second: Span = pack_span(1, 0, 0)
	last_of_first.span_source_index() == 0 and first_of_second.span_source_index() == 1


pure func test_covering_span_runs_from_first_start_to_last_end() -> Bool:
	covering: Span = span_covering(
		pack_span(2, 5, 9),
		pack_span(2, 20, 31),
	)
	covering.span_source_index() == 2 and covering.span_start() == 5 and covering.span_end() == 31


pure func overflow_is(result: Result[Span, SpanOverflow], expected: SpanOverflow) -> Bool:
	match result:
		Ok(_):
			False
		Err(overflow):
			overflow == expected


pure func test_largest_expected_span_round_trips_through_the_checked_packer() -> Bool:
	-- The largest span discovery produces: a whole admitted source of the
	-- largest admitted size, in the last numbered source.
	largest_end: Int = SPAN_OFFSET_LIMIT - 1

	match pack_checked_span(SPAN_SOURCE_LIMIT - 1, 0, largest_end):
		Ok(span):
			(
				span.span_source_index() == SPAN_SOURCE_LIMIT - 1
				and span.span_start() == 0
				and span.span_end() == largest_end
			)
		Err(_):
			False


pure func test_checked_packer_reports_each_overflowing_field() -> Bool:
	overflow_is(
		pack_checked_span(SPAN_SOURCE_LIMIT, 0, 0),
		SourceIndexOverflow,
	) and overflow_is(
		pack_checked_span(0, SPAN_OFFSET_LIMIT, SPAN_OFFSET_LIMIT),
		StartOffsetOverflow,
	) and overflow_is(
		pack_checked_span(0, 0, SPAN_LENGTH_LIMIT),
		LengthOverflow,
	) and overflow_is(
		pack_checked_span(0, 5, 4),
		LengthOverflow,
	)


tests: TestSuite = {
	description = "Discovery packed spans",
	tests = [
		("span round trips small values", test_span_round_trips_small_values),
		(
			"span round trips the largest admitted values",
			test_span_round_trips_the_largest_admitted_values,
		),
		("span fields fill sixty-three bits", test_span_fields_fill_sixty_three_bits),
		("limits follow the bit widths", test_limits_follow_the_bit_widths),
		(
			"admission rejects a source too large to span",
			test_admission_rejects_a_source_too_large_to_span,
		),
		(
			"admission rejects a source index past the limit",
			test_admission_rejects_a_source_index_past_the_limit,
		),
		("spans of adjacent sources do not alias", test_spans_of_adjacent_sources_do_not_alias),
		(
			"largest expected span round trips through the checked packer",
			test_largest_expected_span_round_trips_through_the_checked_packer,
		),
		(
			"checked packer reports each overflowing field",
			test_checked_packer_reports_each_overflowing_field,
		),
		(
			"covering span runs from first start to last end",
			test_covering_span_runs_from_first_start_to_last_end,
		),
	]
}
