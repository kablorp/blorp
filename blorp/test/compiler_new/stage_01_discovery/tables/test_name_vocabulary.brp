import:
	../../../../src/compiler_new/stage_01_discovery/tables/builder:
		DiscoveryBuilder,
		empty_discovery_builder,
		find_name_id,
	../../../../src/compiler_new/stage_01_discovery/tables/ids: NameId, name_id_index
	../../../../src/compiler_new/stage_01_discovery/tables/intern_index: occupied_slot_count
	../../../../src/compiler_new/stage_01_discovery/tables/name_vocabulary:
		ALL_SEEDED_NAME_SPELLINGS,
		DEBUG_ONLY_NAME,
		DISCARD_NAME,
		EMPTY_NAME,
		LIMIT_NAME,
		MAX_THREADS_NAME,
		NO_COPY_NAME,
		RESOURCE_RESULT_ORDINARY_NAME,
		SEEDED_NAME_SPELLINGS,
		TAIL_RECURSIVE_NAME,
		TIMEOUT_NAME,
		VOID_NAME,
		WILDCARD_DIMENSION_NAME,
	test: TestSuite


---
The seeded vocabulary, pinned. Every spelling's position is its `NameId` in
every discovery name table, and `test_discovery_adapter` asserts this list
equals the existing compiler's synthesized vocabulary; changing the order or
the contents here is a deliberate id change.
---
