pure func test_seeded_spellings_match_the_pinned_order() -> Bool:
	SEEDED_NAME_SPELLINGS == PINNED_SEEDED_SPELLINGS


pure func test_ids_the_old_compiler_pins_by_name_are_unchanged() -> Bool:
	-- Ids the existing compiler names as constants (`NAME_ID_*` in
	-- compiler/stage_02_lex/name_table.brp).
	(
		pinned_id_is("", 0)
		and pinned_id_is("Self", 44)
		and pinned_id_is("_", 48)
		and pinned_id_is("#_", 50)
		and pinned_id_is("main", 73)
		and pinned_id_is("tests", 74)
		and pinned_id_is("length", 75)
		and pinned_id_is("checked_get", 119)
		and pinned_id_is("include", 132)
		and pinned_id_is("link_macos", 135)
		and pinned_id_is("Equatable", 156)
		and pinned_id_is("all", 158)
		and pinned_id_is("HasLength", 228)
		and pinned_id_is("abs", 235)
	)


pure func pinned_id_is(spelling: String, expected: Int) -> Bool:
	builder: DiscoveryBuilder = empty_discovery_builder()

	match builder.find_name_id(spelling):
		Some(id):
			id.name_id_index() == expected
		None:
			False


pure func test_empty_builder_seeds_every_spelling_at_its_position() -> Bool:
	builder: DiscoveryBuilder = empty_discovery_builder()
	var all_pinned: Bool = builder.name_spellings.length() == ALL_SEEDED_NAME_SPELLINGS.length()
	var position: Int = 0

	for spelling in ALL_SEEDED_NAME_SPELLINGS:
		match builder.find_name_id(spelling):
			Some(id):
				if id.name_id_index() != position:
					all_pinned = False
			None:
				all_pinned = False

		position += 1

	all_pinned


pure func test_seeded_spellings_are_distinct() -> Bool:
	builder: DiscoveryBuilder = empty_discovery_builder()
	occupied_slot_count(builder.name_slots) == ALL_SEEDED_NAME_SPELLINGS.length()


pure func pinned_name_spells(name: NameId, spelling: String) -> Bool:
	ALL_SEEDED_NAME_SPELLINGS.get(name.name_id_index()) == Some(spelling)


pure func test_every_seeded_name_constant_names_its_spelling() -> Bool:
	(
		pinned_name_spells(EMPTY_NAME, "")
		and pinned_name_spells(DISCARD_NAME, "_")
		and pinned_name_spells(WILDCARD_DIMENSION_NAME, "#_")
		and pinned_name_spells(VOID_NAME, "Void")
		and pinned_name_spells(LIMIT_NAME, "limit")
		and pinned_name_spells(TIMEOUT_NAME, "timeout")
		and pinned_name_spells(MAX_THREADS_NAME, "max_threads")
		and pinned_name_spells(TAIL_RECURSIVE_NAME, "tail_recursive")
		and pinned_name_spells(NO_COPY_NAME, "no_copy")
		and pinned_name_spells(DEBUG_ONLY_NAME, "debug_only")
		and pinned_name_spells(RESOURCE_RESULT_ORDINARY_NAME, "resource_result_ordinary")
	)


pure func test_discovery_only_spellings_follow_the_shared_vocabulary() -> Bool:
	TAIL_RECURSIVE_NAME.name_id_index() == SEEDED_NAME_SPELLINGS.length()


tests: TestSuite = {
	description = "Discovery seeded name vocabulary",
	tests = [
		("seeded spellings match the pinned order", test_seeded_spellings_match_the_pinned_order),
		(
			"ids the old compiler pins by name are unchanged",
			test_ids_the_old_compiler_pins_by_name_are_unchanged,
		),
		(
			"empty builder seeds every spelling at its position",
			test_empty_builder_seeds_every_spelling_at_its_position,
		),
		("seeded spellings are distinct", test_seeded_spellings_are_distinct),
		(
			"every seeded name constant names its spelling",
			test_every_seeded_name_constant_names_its_spelling,
		),
		(
			"discovery only spellings follow the shared vocabulary",
			test_discovery_only_spellings_follow_the_shared_vocabulary,
		),
	]
}
