-- The builder's openings: a module, an import, an import item and a foreign
-- block have no row until their close appends the one complete row, and a
-- definition's close changes only its span.
import:
	../../../../src/compiler_new/stage_01_discovery/parse/declaration_header: plain_header
	../../../../src/compiler_new/stage_01_discovery/parse/definition_openings:
		RecordForm(RecordType),
		close_field,
		close_function,
		close_record,
		field_opening,
		function_definition,
		function_opening,
		open_field,
		open_function,
		open_record,
		record_opening,
	../../../../src/compiler_new/stage_01_discovery/tables/builder:
		DiscoveryBuilder,
		append_foreign_argument,
		append_implicit_request,
		append_import_path_part,
		append_path,
		append_root,
		append_source,
		close_foreign_block,
		close_import,
		close_import_item,
		close_module,
		empty_discovery_builder,
		find_module_by_path,
		next_path_id,
		open_foreign_block,
		open_import,
		open_import_item,
		open_module,
		opened_import,
		opened_module,
	../../../../src/compiler_new/stage_01_discovery/tables/diagnostic_code:
		ImplicitDiagnostic(MissingImplicitModule),
	../../../../src/compiler_new/stage_01_discovery/tables/ids:
		DefinitionId,
		ModuleId,
		NameId,
		PathId,
		definition_id_index,
		literal_id_at_row,
		module_id_at_row,
		module_id_index,
		name_id_at_row,
		name_id_index,
		path_id_at_row,
		source_id_at_row,
	../../../../src/compiler_new/stage_01_discovery/tables/row_kinds:
		DefinitionKind(FieldDefinition, FunctionDefinition, RecordDefinition),
		ModuleOriginKind(UserModule),
		ModuleReach(RootModule),
		Visibility(PublicVisibility),
		bare_request,
	../../../../src/compiler_new/stage_01_discovery/tables/rows:
		EMPTY_ROW_RANGE,
		ImplicitOutcome(ImplicitLoaded, ImplicitRejected),
		RootOutcome(RootLoaded, RootRejected),
	../../../../src/compiler_new/stage_01_discovery/tables/span: Span, pack_span, spans_equal
	test: TestSuite


pure func at(start: Int, end: Int) -> Span:
	pack_span(source_id_at_row(0), start, end)


---
A builder with one source admitted for `probe.brp`, and the path it is at.
---
pure func builder_with_a_source() -> DiscoveryBuilder:
	var builder: DiscoveryBuilder = empty_discovery_builder()
	path: PathId = builder.next_path_id()
	builder = builder.append_path("probe.brp")
	builder.append_source(
		"f(x)\n",
		{
			path = path,
			line_starts = EMPTY_ROW_RANGE
		},
	)


pure func test_a_module_has_no_row_until_it_closes() -> Bool:
	builder: DiscoveryBuilder = builder_with_a_source()
	path: PathId = path_id_at_row(0)
	opening = builder.open_module(UserModule, RootModule)
	module: ModuleId = opening.opened_module()
	closed: DiscoveryBuilder = builder.close_module(opening)

	closed_row_range_is_empty: Bool = match closed.modules.get(0):
		Some(row):
			row.definitions.count == 0 and row.imports.count == 0 and row.nodes.count == 0
		None:
			False

	(
		builder.modules.length() == 0
		and builder.module_ids_by_path.length() == 0
		and module.module_id_index() == 0
		and closed.modules.length() == 1
		and closed_row_range_is_empty
		and closed
			.find_module_by_path(path)
			.is_some()
	)


pure func test_a_module_row_spans_the_rows_appended_between_open_and_close() -> Bool:
	builder: DiscoveryBuilder = builder_with_a_source()
	opening = builder.open_module(UserModule, RootModule)
	module: ModuleId = opening.opened_module()
	header = plain_header(
		module,
		at(0, 1),
		0,
	)
	definition_start = builder.function_opening(
		header,
		name_id_at_row(0),
		at(0, 1),
	)
	closed: DiscoveryBuilder = builder
		.open_function(definition_start)
		.close_function(
			definition_start,
			at(0, 1),
		)
		.close_module(opening)

	match closed.modules.get(0):
		Some(row):
			row.definitions.first == 0 and row.definitions.count == 1
		None:
			False


pure func test_an_import_has_no_row_until_it_closes_over_its_items() -> Bool:
	builder: DiscoveryBuilder = builder_with_a_source()
	module: ModuleId = module_id_at_row(0)
	import_opening = builder.open_import(
		module,
		bare_request(),
		at(0, 1),
	)
	import_id = import_opening.opened_import()
	item_opening = builder.open_import_item(
		import_id,
		name_id_at_row(0),
		at(2, 3),
	)
	with_item: DiscoveryBuilder = builder.close_import_item(
		item_opening,
		at(2, 3),
	)
	closed: DiscoveryBuilder = with_item.close_import(
		import_opening,
		at(0, 1),
		at(2, 3),
	)

	imported: Bool = match closed.imports.get(0):
		Some(row):
			row.items.first == 0 and row.items.count == 1 and spans_equal(
				row.span,
				at(0, 3),
			)
		None:
			False

	builder.imports.length() == 0 and with_item.imports.length() == 0 and imported


pure func test_an_import_item_row_holds_its_variants_from_the_open() -> Bool:
	builder: DiscoveryBuilder = builder_with_a_source()
	import_opening = builder.open_import(
		module_id_at_row(0),
		bare_request(),
		at(0, 1),
	)
	item_opening = builder.open_import_item(
		import_opening.opened_import(),
		name_id_at_row(0),
		at(2, 3),
	)
	closed: DiscoveryBuilder = builder.close_import_item(
		item_opening,
		at(4, 5),
	)

	match closed.import_items.get(0):
		Some(row):
			row.variants.count == 0 and spans_equal(
				row.name_span,
				at(2, 3),
			) and spans_equal(
				row.span,
				at(2, 5),
			)
		None:
			False


pure func test_a_foreign_block_has_no_row_until_it_closes() -> Bool:
	builder: DiscoveryBuilder = builder_with_a_source()
	opening = builder.open_foreign_block(
		module_id_at_row(0),
		at(0, 1),
	)
	closed: DiscoveryBuilder = builder.close_foreign_block(
		opening,
		at(4, 5),
	)

	match closed.foreign_blocks.get(0):
		Some(row):
			builder.foreign_blocks.length() == 0 and row.arguments.count == 0 and spans_equal(
				row.span,
				at(0, 5),
			)
		None:
			False


pure func test_closing_a_definition_changes_only_its_span() -> Bool:
	builder: DiscoveryBuilder = builder_with_a_source()
	module: ModuleId = module_id_at_row(0)
	name: NameId = name_id_at_row(5)
	opening = builder.function_opening(
		plain_header(
			module,
			at(0, 1),
			0,
		),
		name,
		at(0, 1),
	)
	definition: DefinitionId = opening.function_definition()
	opened: DiscoveryBuilder = builder.open_function(opening)
	closed: DiscoveryBuilder = opened.close_function(
		opening,
		at(7, 9),
	)

	match (opened.definitions.get(0), closed.definitions.get(0)):
		(Some(before), Some(after)):
			definition.definition_id_index() == 0 and spans_equal(
				before.span,
				at(0, 1),
			) and spans_equal(
				after.span,
				at(0, 9),
			) and before.kind == after.kind and before.name.name_id_index() == after.name.name_id_index() and before.module.module_id_index() == after.module.module_id_index() and before.visibility == after.visibility and spans_equal(
				before.name_span,
				after.name_span,
			)
		_:
			False


pure func test_import_path_parts_are_the_rows_appended_between_open_and_close() -> Bool:
	builder: DiscoveryBuilder = builder_with_a_source()
	module: ModuleId = module_id_at_row(0)
	first_opening = builder.open_import(
		module,
		bare_request(),
		at(0, 1),
	)
	var out: DiscoveryBuilder = builder
		.append_import_path_part(name_id_at_row(1))
		.append_import_path_part(name_id_at_row(2))
	out = out.close_import(
		first_opening,
		at(0, 1),
		at(0, 1),
	)
	second_opening = out.open_import(
		module,
		bare_request(),
		at(2, 3),
	)
	out = out.append_import_path_part(name_id_at_row(3))
	out = out.close_import(
		second_opening,
		at(2, 3),
		at(2, 3),
	)

	match (out.imports.get(0), out.imports.get(1)):
		(Some(first), Some(second)):
			(
				first.path_parts.first == 0
				and first.path_parts.count == 2
				and second.path_parts.first == 2
				and second.path_parts.count == 1
			)
		_:
			False


pure func test_a_foreign_block_row_holds_the_arguments_appended_after_it_opened() -> Bool:
	builder: DiscoveryBuilder = builder_with_a_source()
	opening = builder.open_foreign_block(
		module_id_at_row(0),
		at(0, 1),
	)
	var out: DiscoveryBuilder = builder.append_foreign_argument({
		name = name_id_at_row(0),
		value = literal_id_at_row(0),
		name_span = at(1, 2),
		span = at(1, 3),
	})
	out = out.append_foreign_argument({
		name = name_id_at_row(1),
		value = literal_id_at_row(0),
		name_span = at(4, 5),
		span = at(4, 6),
	})
	closed: DiscoveryBuilder = out.close_foreign_block(
		opening,
		at(7, 8),
	)

	match closed.foreign_blocks.get(0):
		Some(row):
			row.arguments.first == 0 and row.arguments.count == 2 and spans_equal(
				row.span,
				at(0, 8),
			)
		None:
			False


pure func test_a_module_closes_around_nested_definitions_and_members() -> Bool:
	builder: DiscoveryBuilder = builder_with_a_source()
	opening = builder.open_module(UserModule, RootModule)
	module: ModuleId = opening.opened_module()
	opened_record = builder.record_opening(
		plain_header(
			module,
			at(0, 1),
			0,
		),
		RecordType,
		name_id_at_row(0),
		at(0, 1),
	)
	var out: DiscoveryBuilder = builder.open_record(opened_record)
	opened_field = out.field_opening(
		plain_header(
			module,
			at(2, 3),
			0,
		),
		opened_record,
		name_id_at_row(1),
		at(2, 3),
	)
	out = out.open_field(opened_field)
	out = out.close_field(
		opened_field,
		at(4, 5),
	)
	out = out.close_record(
		opened_record,
		at(6, 7),
	)
	closed: DiscoveryBuilder = out.close_module(opening)

	match (closed.modules.get(0), closed.definitions.get(0), closed.definitions.get(1)):
		(Some(row), Some(record_row), Some(field_row)):
			row.definitions.first == 0 and row.definitions.count == 2 and spans_equal(
				record_row.span,
				at(0, 7),
			) and spans_equal(
				field_row.span,
				at(2, 5),
			) and closed.members.length() == 1
		_:
			False


pure func test_a_root_holds_the_module_it_loaded() -> Bool:
	builder: DiscoveryBuilder = builder_with_a_source()
	out: DiscoveryBuilder = builder.append_root({
		request_path = builder.next_path_id(),
		outcome = RootLoaded(module_id_at_row(0)),
	})

	match out.roots.get(0):
		Some(row):
			match row.outcome:
				RootLoaded(module):
					module.module_id_index() == 0
				RootRejected(_):
					False
		None:
			False


pure func test_an_implicit_request_holds_the_diagnostic_that_rejected_it() -> Bool:
	builder: DiscoveryBuilder = builder_with_a_source()
	out: DiscoveryBuilder = builder.append_implicit_request({
		request_path = builder.next_path_id(),
		outcome = ImplicitRejected(MissingImplicitModule),
	})

	match out.implicit_requests.get(0):
		Some(row):
			match row.outcome:
				ImplicitLoaded(_):
					False
				ImplicitRejected(MissingImplicitModule):
					True
				ImplicitRejected(_):
					False
		None:
			False


tests: TestSuite = {
	description = "Discovery builder openings",
	tests = [
		("a module has no row until it closes", test_a_module_has_no_row_until_it_closes),
		(
			"a module row spans the rows appended between open and close",
			test_a_module_row_spans_the_rows_appended_between_open_and_close,
		),
		(
			"an import has no row until it closes over its items",
			test_an_import_has_no_row_until_it_closes_over_its_items,
		),
		(
			"an import item row holds its variants from the open",
			test_an_import_item_row_holds_its_variants_from_the_open,
		),
		(
			"a foreign block has no row until it closes",
			test_a_foreign_block_has_no_row_until_it_closes,
		),
		(
			"closing a definition changes only its span",
			test_closing_a_definition_changes_only_its_span,
		),
		(
			"import path parts are the rows appended between open and close",
			test_import_path_parts_are_the_rows_appended_between_open_and_close,
		),
		(
			"a foreign block row holds the arguments appended after it opened",
			test_a_foreign_block_row_holds_the_arguments_appended_after_it_opened,
		),
		(
			"a module closes around nested definitions and members",
			test_a_module_closes_around_nested_definitions_and_members,
		),
		("a root holds the module it loaded", test_a_root_holds_the_module_it_loaded),
		(
			"an implicit request holds the diagnostic that rejected it",
			test_an_implicit_request_holds_the_diagnostic_that_rejected_it,
		),
	]
}
