import:
	../../src/compile/command: execute_compile_command
	../../src/main: run_cli
	../../src/lib/cli_plan: CliRunPlan(CliRunCompile)
	compiler_runtime: RuntimeSources
	system: file_exists, remove_file, temp_dir, write_file
	test: TestSuite


private func write_source(path: String) -> Bool:
	write_file(path, "func main(args: List[String]) -> Int:\n\t0\n").is_ok()


func test_compile_typed_dump_reaches_command_output() -> Bool:
	path: String = temp_dir() + "/blorp_cli_compile_effect_typed_summary.brp"
	output_path: String = temp_dir() + "/blorp_cli_compile_effect_typed_summary.c"
	_ = remove_file(path)
	_ = remove_file(output_path)

	if not write_source(path):
		False
	else:
		plan = run_cli([
			"compile",
			"--no-format",
			"--dump-typed-ast",
			"-o",
			output_path,
			path,
		])
		_ = remove_file(path)

		result: Bool = match plan:
			CliRunCompile(compile_plan):
				runtime_sources: RuntimeSources = {
					runtime = "/* embedded runtime fixture */\n",
					declarations = ""
				}
				handled = execute_compile_command(compile_plan, runtime_sources)

				(
					handled.status == 0
					and handled.stdout.contains("Func main: (List[String]) -> Int")
					and not handled.stdout.contains("\"kind\":\"typed_program\"")
					and file_exists(output_path)
				)
			_:
				False

		_ = remove_file(output_path)
		result


tests: TestSuite = {
	description = "Blorp CLI compile output",
	tests = [
		(
			"compile typed summary reaches command output",
			test_compile_typed_dump_reaches_command_output,
		),
	]
}
