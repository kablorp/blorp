import:
	dict: Dict, contains, dict, get, remove, set, with_capacity
	set as S
	slice: StringSlice, from_string, substring
	test: TestSuite


-- Key types that are Hashable through the standard library or the compiler
-- (enums) find equal keys by value, not by the identity of a fresh value.

enum Suit:
	Hearts
	Spades


opaque type TicketId = Int


pure func ticket(number: Int) -> TicketId:
	into_opaque TicketId(number)


implements Equatable for TicketId:
	pure func equals(left: TicketId, right: TicketId) -> Bool:
		from_opaque TicketId(left) == from_opaque TicketId(right)


implements Hashable for TicketId:
	pure func hash(self: TicketId) -> Int:
		from_opaque TicketId(self).hash()


-- 2^64 as an Int128, built at run time so the keys below are fresh values.
pure func two_to_the_64() -> Int128:
	to_int128(4294967296) * to_int128(4294967296)


pure func test_tuple_keys_compare_by_value() -> Bool:
	var grid: Dict[(Int, Int), String] = {}
	grid = grid.set((1, 2), "a")
	grid = grid.set((1, 2), "b")
	grid = grid.set((2, 1), "c")
	grid.length() == 2 and grid.get((1, 2)) == Some("b") and grid.get((2, 1)) == Some("c")


pure func test_triple_and_quad_tuple_keys_compare_by_value() -> Bool:
	var triples: Set[(Int, String, Bool)] = {}
	triples = triples.add((1, "x", True))
	triples = triples.add((1, "x", True))
	var quads: Set[(Int, Int, Int, Int)] = {}
	quads = quads.add((1, 2, 3, 4))
	quads = quads.add((1, 2, 3, 4))
	quads = quads.add((4, 3, 2, 1))
	triples.length() == 1 and quads.length() == 2 and quads.contains((4, 3, 2, 1))


pure func test_list_keys_compare_by_value() -> Bool:
	var paths: Dict[List[String], Int] = {}
	paths = paths.set(["usr", "bin"], 1)
	paths = paths.set(["usr", "bin"], 2)
	paths = paths.set(["usr"], 3)
	paths.length() == 2 and paths.get(["usr", "bin"]) == Some(2) and not paths.contains(["bin", "usr"])


pure func test_int128_keys_use_both_halves() -> Bool:
	high: Int128 = two_to_the_64() * to_int128(3)
	var wide: Dict[Int128, Int] = {}
	wide = wide.set(high, 1)
	wide = wide.set(two_to_the_64() * to_int128(3), 2)
	wide = wide.set(to_int128(3), 3)
	wide.length() == 2 and wide.get(high) == Some(2) and wide.get(to_int128(3)) == Some(3)


pure func test_negative_int128_keys_compare_by_value() -> Bool:
	low: Int128 = to_int128(0) - to_int128(1)
	high: Int128 = two_to_the_64() - to_int128(1)
	var wide: Dict[Int128, Int] = {}
	wide = wide.set(low, 1)
	wide = wide.set(high, 2)
	wide = wide.set(to_int128(0) - to_int128(1), 3)
	wide.length() == 2 and wide.get(low) == Some(3) and wide.get(high) == Some(2)


pure func test_uint128_keys_compare_by_value() -> Bool:
	var wide: Set[UInt128] = {}
	wide = wide.add(to_uint128(7))
	wide = wide.add(to_uint128(7))
	wide = wide.remove(to_uint128(7))
	wide.is_empty()


pure func test_string_slice_keys_compare_contents() -> Bool:
	var words: Dict[StringSlice, Int] = {}
	words = words.set(from_string("hello"), 1)
	words = words.set(from_string("say hello").substring(4, 5), 2)
	words.length() == 1 and words.get(from_string("hello")) == Some(2)


pure func test_bytes_keys_compare_bytes() -> Bool:
	var blobs: Set[Bytes] = {}
	blobs = blobs.add("ab".to_bytes())
	blobs = blobs.add("ab".to_bytes())
	blobs = blobs.add("ba".to_bytes())
	blobs.length() == 2 and blobs.contains("ab".to_bytes())


pure func test_enum_tuple_keys_compare_by_value() -> Bool:
	var cards: Dict[(Suit, Int), Bool] = {}
	cards = cards.set((Hearts, 1), True)
	cards = cards.set((Hearts, 1), False)
	cards = cards.set((Spades, 1), True)
	cards.length() == 2 and cards.get((Hearts, 1)) == Some(False)


pure func test_nested_option_tuple_keys_compare_by_value() -> Bool:
	var found: Dict[Option[(Int, String)], Int] = {}
	found = found.set(Some((1, "a")), 1)
	found = found.set(Some((1, "a")), 2)
	found = found.set(None, 3)
	found.length() == 2 and found.get(Some((1, "a"))) == Some(2)


pure func test_opaque_keys_with_impls_compare_by_value() -> Bool:
	var tickets: Dict[TicketId, String] = {}
	tickets = tickets.set(ticket(7), "open")
	tickets = tickets.set(ticket(7), "closed")
	tickets = tickets.remove(ticket(8))
	tickets.length() == 1 and tickets.get(ticket(7)) == Some("closed")


-- The bounded constructors learn their key type from the next call in the
-- chain; typecheck must hand that inferred type to Core.
pure func test_bounded_constructors_infer_key_from_chained_call() -> Bool:
	names: Dict[String, Int] = dict().set("a", 1)
	sized: Dict[String, Int] = with_capacity(4).set("b", 2)
	numbers: Set[Int] = S.set().add(1).add(1)
	names.get("a") == Some(1) and sized.get("b") == Some(2) and numbers.length() == 1


tests: TestSuite = {
	description = "Hashable standard-library keys",
	tests = [
		("tuple keys compare by value", test_tuple_keys_compare_by_value),
		("triple and quad tuple keys compare by value", test_triple_and_quad_tuple_keys_compare_by_value),
		("list keys compare by value", test_list_keys_compare_by_value),
		("int128 keys use both halves", test_int128_keys_use_both_halves),
		("negative int128 keys compare by value", test_negative_int128_keys_compare_by_value),
		("uint128 keys compare by value", test_uint128_keys_compare_by_value),
		("string slice keys compare contents", test_string_slice_keys_compare_contents),
		("bytes keys compare bytes", test_bytes_keys_compare_bytes),
		("enum tuple keys compare by value", test_enum_tuple_keys_compare_by_value),
		("nested option tuple keys compare by value", test_nested_option_tuple_keys_compare_by_value),
		("opaque keys with impls compare by value", test_opaque_keys_with_impls_compare_by_value),
		(
			"bounded constructors infer key from chained call",
			test_bounded_constructors_infer_key_from_chained_call,
		),
	]
}
