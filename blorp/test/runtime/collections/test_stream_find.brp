import:
	stream: find, from_list
	test: TestSuite


func test_stream_find_int_some() -> Bool:
	match find(from_list([1, 2, 3, 4]), func(value: Int): value == 3):
		Some(found): found == 3
		None: False


func test_stream_find_int_none() -> Bool:
	match find(from_list([1, 2, 3, 4]), func(value: Int): value > 10):
		Some(found): False
		None: True


tests: TestSuite = {
	description = "Stream find",
	tests = [
		("stream find int Some", test_stream_find_int_some),
		("stream find int None", test_stream_find_int_none),
	]
}
