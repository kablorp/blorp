-- A list literal of structs is written element by element into inline
-- storage. Elements whose fields can execute code (a negation, arithmetic,
-- a call) are not simple C expressions, and the backend used to reject the
-- whole enclosing function instead of emitting those elements as statements.
import:
	test: TestSuite


struct GridPoint {
	x: Int,
	y: Int
}


pure func origin() -> GridPoint:
	{
		x = 0,
		y = 0
	}


pure func shifted(value: Int) -> Int:
	value + 1


func test_negated_literal_field() -> Bool:
	values: List[GridPoint] = [
		{
			x = -3,
			y = 4
		},
	]
	first: GridPoint = values.get_or(0, origin())
	values.length() == 1 and first.x == -3 and first.y == 4


func test_computed_fields_in_every_element() -> Bool:
	base: Int = 5
	values: List[GridPoint] = [
		{
			x = shifted(base),
			y = -base
		},
		{
			x = base * 2,
			y = shifted(-base)
		},
		{
			x = 7,
			y = 8
		},
	]
	first: GridPoint = values.get_or(0, origin())
	second: GridPoint = values.get_or(1, origin())
	third: GridPoint = values.get_or(2, origin())
	(
		values.length() == 3
		and first.x == 6
		and first.y == -5
		and second.x == 10
		and second.y == -4
		and third.x == 7
		and third.y == 8
	)


tests: TestSuite = {
	description = "Inline struct list literal fields",
	tests = [
		("negated literal field", test_negated_literal_field),
		("computed fields in every element", test_computed_fields_in_every_element),
	]
}
