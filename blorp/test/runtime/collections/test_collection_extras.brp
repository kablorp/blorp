import:
	dict as D
	set as S
	test: TestSuite


-- ============================================================================
-- Dict.contains_value
-- ============================================================================
pure func test_contains_value_found() -> Bool:
	d: Dict[String, Int] = D.set(D.dict(), "a", 42)
	D.contains_value(d, 42)


pure func test_contains_value_not_found() -> Bool:
	d: Dict[String, Int] = D.set(D.dict(), "a", 42)
	not D.contains_value(d, 99)


pure func test_contains_value_empty() -> Bool:
	d: Dict[String, Int] = D.dict()
	not D.contains_value(d, 1)


pure func test_contains_value_multiple() -> Bool:
	d: Dict[String, Int] = D.set(
		D.set(
			D.set(D.dict(), "a", 1),
			"b",
			2,
		),
		"c",
		3,
	)
	D.contains_value(d, 2)


pure func test_contains_value_string() -> Bool:
	d: Dict[Int, String] = D.set(D.dict(), 1, "hello")
	D.contains_value(d, "hello") and not D.contains_value(d, "world")


-- ============================================================================
-- Set.symmetric_difference
-- ============================================================================
pure func test_symmetric_diff_basic() -> Bool:
	a: Set[Int] = S.from_list([1, 2, 3])
	b: Set[Int] = S.from_list([2, 3, 4])
	sd: Set[Int] = S.symmetric_difference(a, b)
	S.contains(sd, 1) and S.contains(sd, 4) and not S.contains(sd, 2) and not S.contains(sd, 3)


pure func test_symmetric_diff_equal_sets() -> Bool:
	a: Set[Int] = S.from_list([1, 2, 3])
	b: Set[Int] = S.from_list([1, 2, 3])
	S.is_empty(S.symmetric_difference(a, b))


pure func test_symmetric_diff_disjoint() -> Bool:
	a: Set[Int] = S.from_list([1, 2])
	b: Set[Int] = S.from_list([3, 4])
	sd: Set[Int] = S.symmetric_difference(a, b)
	S
		.to_list(sd)
		.length() == 4


pure func test_symmetric_diff_empty_a() -> Bool:
	a: Set[Int] = S.set()
	b: Set[Int] = S.from_list([1, 2, 3])
	sd: Set[Int] = S.symmetric_difference(a, b)
	S
		.to_list(sd)
		.length() == 3


pure func test_symmetric_diff_empty_b() -> Bool:
	a: Set[Int] = S.from_list([1, 2, 3])
	b: Set[Int] = S.set()
	sd: Set[Int] = S.symmetric_difference(a, b)
	S
		.to_list(sd)
		.length() == 3


pure func test_symmetric_diff_both_empty() -> Bool:
	a: Set[Int] = S.set()
	b: Set[Int] = S.set()
	S.is_empty(S.symmetric_difference(a, b))


pure func test_symmetric_diff_string() -> Bool:
	a: Set[String] = S.from_list(["x", "y", "z"])
	b: Set[String] = S.from_list(["y", "z", "w"])
	sd: Set[String] = S.symmetric_difference(a, b)
	S.contains(sd, "x") and S.contains(sd, "w") and not S.contains(sd, "y")


tests: TestSuite = {
	description = "Collection Extras",
	tests = [
		("contains_value found", test_contains_value_found),
		("contains_value not found", test_contains_value_not_found),
		("contains_value empty", test_contains_value_empty),
		("contains_value multiple", test_contains_value_multiple),
		("contains_value string", test_contains_value_string),
		("symmetric_diff basic", test_symmetric_diff_basic),
		("symmetric_diff equal sets", test_symmetric_diff_equal_sets),
		("symmetric_diff disjoint", test_symmetric_diff_disjoint),
		("symmetric_diff empty a", test_symmetric_diff_empty_a),
		("symmetric_diff empty b", test_symmetric_diff_empty_b),
		("symmetric_diff both empty", test_symmetric_diff_both_empty),
		("symmetric_diff string", test_symmetric_diff_string),
	]
}
