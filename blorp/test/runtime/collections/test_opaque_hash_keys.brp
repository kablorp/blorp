import:
	dict: Dict, contains, dict, get, remove, set, with_capacity
	set as S
	test: TestSuite


-- An opaque key hashes and compares through its own Hashable and Equatable
-- impls even when its representation has a runtime hasher. Each key type
-- here is coarser than its representation, so hashing the representation
-- would keep keys apart that the impls call equal.

--- A tag compared without regard to letter case.
opaque type Tag = String


pure func tag(text: String) -> Tag:
	into_opaque Tag(text)


pure func tag_text(value: Tag) -> String:
	from_opaque Tag(value)


implements Equatable for Tag:
	pure func equals(left: Tag, right: Tag) -> Bool:
		tag_text(left).lower() == tag_text(right).lower()


implements Hashable for Tag:
	pure func hash(self: Tag) -> Int:
		tag_text(self).lower().hash()


--- A clock hour: 3 and 15 name the same hour.
opaque type Hour = Int


pure func hour(value: Int) -> Hour:
	into_opaque Hour(value)


pure func hour_of_day(value: Hour) -> Int:
	from_opaque Hour(value) % 12


implements Equatable for Hour:
	pure func equals(left: Hour, right: Hour) -> Bool:
		hour_of_day(left) == hour_of_day(right)


implements Hashable for Hour:
	pure func hash(self: Hour) -> Int:
		hour_of_day(self).hash()


--- A reading compared by its whole part.
opaque type Reading = Float


pure func reading(value: Float) -> Reading:
	into_opaque Reading(value)


pure func whole_part(value: Reading) -> Int:
	from_opaque Reading(value).to_int()


implements Equatable for Reading:
	pure func equals(left: Reading, right: Reading) -> Bool:
		whole_part(left) == whole_part(right)


implements Hashable for Reading:
	pure func hash(self: Reading) -> Int:
		whole_part(self).hash()


record Version {
	major: Int,
	patch: Int
}


--- A release identified by its major version; the record itself is not Hashable.
opaque type Release = Version


pure func release(major: Int, patch: Int) -> Release:
	into_opaque Release({ major = major, patch = patch })


pure func release_major(value: Release) -> Int:
	from_opaque Release(value).major


implements Equatable for Release:
	pure func equals(left: Release, right: Release) -> Bool:
		release_major(left) == release_major(right)


implements Hashable for Release:
	pure func hash(self: Release) -> Int:
		release_major(self).hash()


union Shade:
	Light
	Dark(Int)


-- Literal values of record and union type are boxed from their canonical
-- types, so the dict owns them after the literal's temporaries are released.
private SHADES: Dict[Tag, Shade] = {tag("Sky") => Light, tag("Ink") => Dark(9)}


pure func test_literal_values_of_record_and_union_type_stay_owned() -> Bool:
	releases: Dict[Tag, Release] = {tag("a") => release(1, 0), tag("B") => release(2, 3)}
	dark: Bool = match SHADES.get(tag("INK")):
		Some(Dark(depth)):
			depth == 9
		_:
			False
	dark and releases.get(tag("b")).map(release_major) == Some(2)


private EMPTY_TAG_COUNTS: Dict[Tag, Int] = {}

private EMPTY_HOURS: Set[Hour] = {}


--- A label over any representation; its String instantiation ignores case.
opaque type Label[T] = T


pure func label(text: String) -> Label[String]:
	into_opaque Label[String](text)


implements Equatable for Label[String]:
	pure func equals(left: Label[String], right: Label[String]) -> Bool:
		from_opaque Label[String](left).lower() == from_opaque Label[String](right).lower()


implements Hashable for Label[String]:
	pure func hash(self: Label[String]) -> Int:
		from_opaque Label[String](self).lower().hash()


pure func test_global_empty_containers_use_its_equals() -> Bool:
	counts: Dict[Tag, Int] = EMPTY_TAG_COUNTS.set(tag("A"), 1).set(tag("a"), 2)
	hours: Set[Hour] = EMPTY_HOURS.add(hour(4)).add(hour(16))
	counts.length() == 1 and hours.length() == 1


pure func test_tuple_key_with_opaque_element_uses_its_equals() -> Bool:
	var cells: Dict[(Tag, Int), String] = {}
	cells = cells.set((tag("Row"), 1), "first")
	cells = cells.set((tag("ROW"), 1), "second")
	cells = cells.set((tag("row"), 2), "third")
	cells.length() == 2 and cells.get((tag("rOw"), 1)) == Some("second")


pure func test_generic_opaque_key_uses_its_equals() -> Bool:
	var labels: Set[Label[String]] = {}
	labels = labels.add(label("Blorp"))
	labels = labels.add(label("BLORP"))
	labels.length() == 1 and labels.contains(label("blorp"))


pure func test_opaque_values_do_not_change_key_hashing() -> Bool:
	var names: Dict[Int, Tag] = {}
	names = names.set(1, tag("one"))
	names = names.set(1, tag("ONE"))
	names.length() == 1 and names.get(1).map(tag_text) == Some("ONE")


pure func test_string_opaque_dict_uses_its_equals() -> Bool:
	var counts: Dict[Tag, Int] = {}
	counts = counts.set(tag("Blorp"), 1)
	counts = counts.set(tag("BLORP"), 2)
	counts = counts.set(tag("other"), 3)
	(
		counts.length() == 2
		and counts.get(tag("blorp")) == Some(2)
		and counts.contains(tag("OTHER"))
		and counts.get_or(tag("missing"), 0) == 0
	)


pure func test_string_opaque_dict_remove_uses_its_equals() -> Bool:
	counts: Dict[Tag, Int] = dict().set(tag("Blorp"), 1).set(tag("other"), 2)
	removed: Dict[Tag, Int] = counts.remove(tag("bLoRp"))
	removed.length() == 1 and not removed.contains(tag("blorp"))


pure func test_string_opaque_set_uses_its_equals() -> Bool:
	var seen: Set[Tag] = {}
	seen = seen.add(tag("Blorp"))
	seen = seen.add(tag("blorp"))
	seen = seen.add(tag("BLORP"))
	seen.length() == 1 and seen.contains(tag("bLORp"))


pure func test_string_opaque_literal_and_from_list_use_its_equals() -> Bool:
	counts: Dict[Tag, Int] = {tag("a") => 1, tag("A") => 2}
	seen: Set[Tag] = S.from_list([tag("x"), tag("X")])
	counts.length() == 1 and counts.get(tag("a")) == Some(2) and seen.length() == 1


pure func test_int_opaque_dict_uses_its_equals() -> Bool:
	var alarms: Dict[Hour, String] = {}
	alarms = alarms.set(hour(3), "wake")
	alarms = alarms.set(hour(15), "tea")
	alarms = alarms.set(hour(7), "walk")
	alarms.length() == 2 and alarms.get(hour(27)) == Some("tea")


pure func test_int_opaque_set_uses_its_equals() -> Bool:
	hours: Set[Hour] = S.set().add(hour(1)).add(hour(13)).add(hour(25))
	hours.length() == 1 and hours.contains(hour(37))


pure func test_int_opaque_dict_with_capacity_uses_its_equals() -> Bool:
	sized: Dict[Hour, Int] = with_capacity(8).set(hour(2), 1).set(hour(14), 2)
	sized.length() == 1 and sized.get(hour(2)) == Some(2)


pure func test_float_opaque_dict_uses_its_equals() -> Bool:
	var readings: Dict[Reading, String] = {}
	readings = readings.set(reading(1.25), "low")
	readings = readings.set(reading(1.75), "still low")
	readings = readings.set(reading(2.5), "high")
	readings.length() == 2 and readings.get(reading(1.0)) == Some("still low")


pure func test_opaque_inside_option_key_uses_its_equals() -> Bool:
	var found: Dict[Option[Tag], Int] = {}
	found = found.set(Some(tag("Blorp")), 1)
	found = found.set(Some(tag("blorp")), 2)
	found = found.set(None, 3)
	found.length() == 2 and found.get(Some(tag("BLORP"))) == Some(2)


pure func test_record_opaque_dict_uses_its_equals() -> Bool:
	var notes: Dict[Release, String] = {}
	notes = notes.set(release(1, 0), "first")
	notes = notes.set(release(1, 4), "patched")
	notes = notes.set(release(2, 0), "second")
	notes.length() == 2 and notes.get(release(1, 9)) == Some("patched")


pure func distinct_count[K: Hashable](items: List[K]) -> Int:
	var seen: Set[K] = {}

	for item in items:
		seen = seen.add(item)

	seen.length()


pure func test_generic_code_uses_the_opaque_impls() -> Bool:
	distinct_count([tag("a"), tag("A"), tag("b")]) == 2 and distinct_count([hour(0), hour(12)]) == 1


pure func test_entries_keep_the_first_inserted_key() -> Bool:
	counts: Dict[Tag, Int] = dict().set(tag("First"), 1).set(tag("FIRST"), 2)

	match counts.entries():
		[(key, value)]:
			tag_text(key) == "First" and value == 2
		_:
			False


tests: TestSuite = {
	description = "Opaque keys hash through their own impls",
	tests = [
		("string opaque dict uses its equals", test_string_opaque_dict_uses_its_equals),
		("string opaque dict remove uses its equals", test_string_opaque_dict_remove_uses_its_equals),
		("string opaque set uses its equals", test_string_opaque_set_uses_its_equals),
		("string opaque literal and from_list use its equals", test_string_opaque_literal_and_from_list_use_its_equals),
		("int opaque dict uses its equals", test_int_opaque_dict_uses_its_equals),
		("int opaque set uses its equals", test_int_opaque_set_uses_its_equals),
		("int opaque dict with capacity uses its equals", test_int_opaque_dict_with_capacity_uses_its_equals),
		("float opaque dict uses its equals", test_float_opaque_dict_uses_its_equals),
		("opaque inside option key uses its equals", test_opaque_inside_option_key_uses_its_equals),
		("record opaque dict uses its equals", test_record_opaque_dict_uses_its_equals),
		(
			"literal values of record and union type stay owned",
			test_literal_values_of_record_and_union_type_stay_owned,
		),
		("global empty containers use its equals", test_global_empty_containers_use_its_equals),
		("tuple key with opaque element uses its equals", test_tuple_key_with_opaque_element_uses_its_equals),
		("generic opaque key uses its equals", test_generic_opaque_key_uses_its_equals),
		("opaque values do not change key hashing", test_opaque_values_do_not_change_key_hashing),
		("generic code uses the opaque impls", test_generic_code_uses_the_opaque_impls),
		("entries keep the first inserted key", test_entries_keep_the_first_inserted_key),
	]
}
