-- Runtime helpers read and write unboxed list elements through one generic
-- accessor that copies elem_size bytes. These cases cover each width the
-- accessor distinguishes (1, 2, 4, 8, other sizes up to 8, wider structs)
-- through equality, reverse and to_string, which go through that accessor.
import:
	test: TestSuite


-- Three one-byte fields: an inline struct element narrower than a pointer
-- whose size is not a power of two.
fixed record Rgb {
	red: Int8,
	green: Int8,
	blue: Int8
}


-- Wider than a pointer, so elements are copied through a slot address.
fixed record Span {
	start: Int,
	finish: Int,
	weight: Int32
}


pure func rgb(red: Int, green: Int, blue: Int) -> Rgb:
	{
		red = to_int8(red),
		green = to_int8(green),
		blue = to_int8(blue)
	}


pure func span(start: Int, finish: Int, weight: Int) -> Span:
	{
		start = start,
		finish = finish,
		weight = to_int32(weight)
	}


func build_bools(length: Int, period: Int) -> List[Bool]:
	var values: List[Bool] = []

	for i in 0..length:
		values = values.append(i % period == 0)

	values


func build_int8s(length: Int) -> List[Int8]:
	var values: List[Int8] = []

	for i in 0..length:
		values = values.append(to_int8(i - 60))

	values


func build_int16s(length: Int) -> List[Int16]:
	var values: List[Int16] = []

	for i in 0..length:
		values = values.append(to_int16(i * 300 - 20000))

	values


func build_int32s(length: Int) -> List[Int32]:
	var values: List[Int32] = []

	for i in 0..length:
		values = values.append(to_int32(i * 70000 - 3000000))

	values


func build_ints(length: Int) -> List[Int]:
	var values: List[Int] = []

	for i in 0..length:
		values = values.append(i * 5000000000 - 7)

	values


func build_rgbs(length: Int) -> List[Rgb]:
	var values: List[Rgb] = []

	for i in 0..length:
		values = values.append(rgb(i, -i, i * 3))

	values


func build_spans(length: Int) -> List[Span]:
	var values: List[Span] = []

	for i in 0..length:
		values = values.append(span(i, i * 9, -i))

	values


func test_bool_lists_compare_every_element() -> Bool:
	same: List[Bool] = build_bools(100, 3)
	other: List[Bool] = build_bools(100, 3).set(98, True)
	build_bools(100, 3) == same and same != other


func test_int8_lists_compare_every_element() -> Bool:
	same: List[Int8] = build_int8s(120)
	other: List[Int8] = build_int8s(120).set(119, to_int8(0))
	build_int8s(120) == same and same != other


func test_int16_lists_compare_every_element() -> Bool:
	same: List[Int16] = build_int16s(120)
	other: List[Int16] = build_int16s(120).set(0, to_int16(1))
	build_int16s(120) == same and same != other


func test_int32_lists_compare_every_element() -> Bool:
	same: List[Int32] = build_int32s(120)
	other: List[Int32] = build_int32s(120).set(60, to_int32(1))
	build_int32s(120) == same and same != other


func test_int_lists_compare_every_element() -> Bool:
	same: List[Int] = build_ints(120)
	other: List[Int] = build_ints(120).set(60, 1)
	build_ints(120) == same and same != other


func test_small_struct_lists_keep_every_field() -> Bool:
	values: List[Rgb] = build_rgbs(40)
	reversed: List[Rgb] = values.reverse()
	first: Rgb = reversed.get_or(
		0,
		rgb(0, 0, 0),
	)
	last: Rgb = reversed.get_or(
		39,
		rgb(1, 1, 1),
	)
	(
		to_int(first.red) == 39
		and to_int(first.green) == -39
		and to_int(first.blue) == 117
		and to_int(last.red) == 0
		and to_int(last.green) == 0
		and to_int(last.blue) == 0
	)


func test_wide_struct_lists_keep_every_field() -> Bool:
	values: List[Span] = build_spans(40)
	reversed: List[Span] = values.reverse()
	first: Span = reversed.get_or(
		0,
		span(0, 0, 0),
	)
	first.start == 39 and first.finish == 351 and to_int(first.weight) == -39


-- The narrow lists stay non-negative: to_string currently prints negative
-- Int16 and Int32 list elements zero-extended, a separate defect.
func test_narrow_lists_print_every_element() -> Bool:
	bools: List[Bool] = build_bools(4, 2)
	int16s: List[Int16] = [to_int16(300), to_int16(20000)]
	int32s: List[Int32] = [to_int32(7), to_int32(70000)]
	(
		bools.to_string() == "[True, False, True, False]"
		and int16s.to_string() == "[300, 20000]"
		and int32s.to_string() == "[7, 70000]"
		and build_ints(2)
			.reverse()
			.to_string() == "[4999999993, -7]"
	)


tests: TestSuite = {
	description = "Inline list element widths",
	tests = [
		("bool lists compare every element", test_bool_lists_compare_every_element),
		("int8 lists compare every element", test_int8_lists_compare_every_element),
		("int16 lists compare every element", test_int16_lists_compare_every_element),
		("int32 lists compare every element", test_int32_lists_compare_every_element),
		("int lists compare every element", test_int_lists_compare_every_element),
		("small struct lists keep every field", test_small_struct_lists_keep_every_field),
		("wide struct lists keep every field", test_wide_struct_lists_keep_every_field),
		("narrow lists print every element", test_narrow_lists_print_every_element),
	]
}
