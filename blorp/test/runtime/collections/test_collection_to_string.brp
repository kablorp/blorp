import:
	int: INT_MAX, INT_MIN
	test: TestSuite


func test_string_list_rendering() -> Bool:
	values: List[String] = ["", "hello", "caf\u{E9}", "100%"]
	values.to_string() == "[\"\", \"hello\", \"caf\u{E9}\", \"100%\"]"


func test_string_list_preserves_embedded_nul_behavior() -> Bool:
	values: List[String] = ["visible\0hidden", "after"]
	values.to_string() == "[\"visible\", \"after\"]"


func test_bool_list_rendering() -> Bool:
	values: List[Bool] = [True, False, False, True]
	values.to_string() == "[True, False, False, True]"


func test_int_list_rendering_and_extrema() -> Bool:
	values: List[Int] = [0, -1, 42, INT_MIN, INT_MAX]
	values.to_string() == "[0, -1, 42, -9223372036854775808, 9223372036854775807]"


func test_int_vector_rendering() -> Bool:
	values: Int[#5] = {0, -1, 42, INT_MIN, INT_MAX}
	values.to_string() == "{0, -1, 42, -9223372036854775808, 9223372036854775807}"


func test_int_matrix_rendering() -> Bool:
	values: Int[#2, #3] = {
		{1, -2, 3},
		{40, 0, -600},
	}
	values.to_string() == "{{1, -2, 3}, {40, 0, -600}}"


func test_int_matrix_preserves_single_dimension_geometry() -> Bool:
	row: Int[#1, #3] = {{1, 2, 3}}
	column: Int[#3, #1] = {{1}, {2}, {3}}
	row.to_string() == "{{1, 2, 3}}" and column.to_string() == "{1, 2, 3}"


func test_empty_collection_rendering() -> Bool:
	strings: List[String] = []
	bools: List[Bool] = []
	ints: List[Int] = []
	(
		strings.to_string() == "[]"
		and bools.to_string() == "[]"
		and ints.to_string() == "[]"
	)


tests: TestSuite = {
	description = "Collection to_string",
	tests = [
		("string lists", test_string_list_rendering),
		("string lists preserve embedded NUL behavior", test_string_list_preserves_embedded_nul_behavior),
		("Bool lists", test_bool_list_rendering),
		("Int lists and extrema", test_int_list_rendering_and_extrema),
		("Int vectors", test_int_vector_rendering),
		("Int matrices", test_int_matrix_rendering),
		("Int matrices preserve single-dimension geometry", test_int_matrix_preserves_single_dimension_geometry),
		("empty collections", test_empty_collection_rendering),
	],
}
