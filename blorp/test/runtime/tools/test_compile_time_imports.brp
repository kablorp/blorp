import:
	./helpers/compile_time_imports as CT:
		BASE_WORDS,
		IMPORTED_BASE as BASE_ALIAS,
		imported_plus,
		imported_reads_private,
		imported_reads_qualified_dependency,
		join_upper,
	test: TestSuite


SELECTIVE_VALUE: Int = BASE_ALIAS + 1

SELECTIVE_CALL: Int = imported_plus(1)

SELECTIVE_PRIVATE_READ: Int = imported_reads_private(41)

SELECTIVE_QUALIFIED_DEPENDENCY_READ: Int = imported_reads_qualified_dependency(41)

SELECTIVE_JOINED: String = join_upper(BASE_WORDS)

QUALIFIED_VALUE: Int = CT.IMPORTED_BASE + 1

QUALIFIED_CALL: Int = CT.imported_plus(1)

QUALIFIED_JOINED: String = CT.join_upper(CT.BASE_WORDS)


func test_compile_time_selective_imports() -> Bool:
	(
		SELECTIVE_VALUE == 42
		and SELECTIVE_CALL == 42
		and SELECTIVE_PRIVATE_READ == 42
		and SELECTIVE_QUALIFIED_DEPENDENCY_READ == 42
		and SELECTIVE_JOINED == "THESEAHHHARGS"
	)


func test_compile_time_qualified_imports() -> Bool:
	QUALIFIED_VALUE == 42 and QUALIFIED_CALL == 42 and QUALIFIED_JOINED == "THESEAHHHARGS"


tests: TestSuite = {
	description = "compile-time imported constants",
	tests = [
		("selective imports", test_compile_time_selective_imports),
		("qualified imports", test_compile_time_qualified_imports),
	]
}
