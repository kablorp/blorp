import:
	../../../../tools/unused_blorp_code/analyzer:
		BlorpSourceFile,
		UnusedDefinition,
		analyze_sources,
		analyze_sources_with_usage,
		format_unused_definition,
	test: TestSuite


pure func source_file(source: String) -> BlorpSourceFile:
	source_file_at("sample.brp", source)


pure func source_file_at(path: String, source: String) -> BlorpSourceFile:
	{
		path = path,
		source = source
	}


pure func unused_names(unused: List[UnusedDefinition]) -> List[String]:
	var names: List[String] = []

	for item in unused:
		names = names.append(item.definition.name)

	names


pure func test_private_unused_function_is_reported() -> Bool:
	source: String = "private pure func unused_helper() -> Int:\n\t1\n\nprivate pure func used_helper() -> Int:\n\t2\n\nfunc main(args: List[String]) -> Int:\n\tused_helper()\n"
	names: List[String] = analyze_sources([source_file(source)], False).unused.unused_names()
	names.contains("unused_helper") and not names.contains("used_helper")


pure func test_comments_and_strings_do_not_count_as_references() -> Bool:
	source: String = "private pure func only_comment_string() -> Int:\n\t1\n\n-- only_comment_string()\nfunc main(args: List[String]) -> Int:\n\tlabel: String = \"only_comment_string\"\n\t0\n"
	names: List[String] = analyze_sources([source_file(source)], False).unused.unused_names()
	names.contains("only_comment_string")


pure func test_string_interpolation_expression_counts_as_reference() -> Bool:
	interpolation: String = "$" + "{value.render_value()}"
	source: String = "private pure func render_value(value: Int) -> String:\n\tvalue.to_string()\n\nfunc main(args: List[String]) -> Int:\n\tvalue: Int = 1\n\tlabel: String = \"value " + interpolation + "\"\n\t0\n"
	names: List[String] = analyze_sources([source_file(source)], False).unused.unused_names()
	not names.contains("render_value")


pure func test_public_definitions_are_ignored_by_default() -> Bool:
	source: String = "pure func public_helper() -> Int:\n\t1\n"
	default_names: List[String] = analyze_sources(
		[source_file(source)],
		False,
	).unused.unused_names()
	public_names: List[String] = analyze_sources([source_file(source)], True).unused.unused_names()
	not default_names.contains("public_helper") and public_names.contains("public_helper")


pure func test_imported_public_definition_is_not_reported_when_used() -> Bool:
	definition_source: BlorpSourceFile = source_file_at(
		"lib/math.brp",
		"pure func public_helper() -> Int:\n\t1\n",
	)
	usage_source: BlorpSourceFile = source_file_at(
		"app/main.brp",
		"import:\n\tlib/math: public_helper\n\nfunc main(args: List[String]) -> Int:\n\tpublic_helper()\n",
	)
	names: List[String] = analyze_sources_with_usage(
		[definition_source],
		[usage_source],
		True,
	).unused.unused_names()
	not names.contains("public_helper")


pure func test_imported_public_definition_is_reported_when_unused() -> Bool:
	definition_source: BlorpSourceFile = source_file_at(
		"lib/math.brp",
		"pure func public_helper() -> Int:\n\t1\n",
	)
	usage_source: BlorpSourceFile = source_file_at(
		"app/main.brp",
		"import:\n\tlib/math: public_helper\n\nfunc main(args: List[String]) -> Int:\n\t0\n",
	)
	names: List[String] = analyze_sources_with_usage(
		[definition_source],
		[usage_source],
		True,
	).unused.unused_names()
	names.contains("public_helper")


pure func test_public_definition_is_reported_when_mentioned_without_import() -> Bool:
	definition_source: BlorpSourceFile = source_file_at(
		"lib/math.brp",
		"pure func public_helper() -> Int:\n\t1\n",
	)
	usage_source: BlorpSourceFile = source_file_at(
		"app/main.brp",
		"func main(args: List[String]) -> Int:\n\tpublic_helper()\n",
	)
	names: List[String] = analyze_sources_with_usage(
		[definition_source],
		[usage_source],
		True,
	).unused.unused_names()
	names.contains("public_helper")


pure func test_qualified_public_definition_is_not_reported_when_used() -> Bool:
	definition_source: BlorpSourceFile = source_file_at(
		"lib/math.brp",
		"pure func public_helper() -> Int:\n\t1\n",
	)
	usage_source: BlorpSourceFile = source_file_at(
		"app/main.brp",
		"import:\n\tlib/math as M\n\nfunc main(args: List[String]) -> Int:\n\tM.public_helper()\n",
	)
	names: List[String] = analyze_sources_with_usage(
		[definition_source],
		[usage_source],
		True,
	).unused.unused_names()
	not names.contains("public_helper")


pure func test_private_constant_is_reported() -> Bool:
	source: String = "private UNUSED_COUNT: Int = 1\nprivate USED_COUNT: Int = 2\n\nfunc main(args: List[String]) -> Int:\n\tUSED_COUNT\n"
	names: List[String] = analyze_sources([source_file(source)], False).unused.unused_names()
	names.contains("UNUSED_COUNT") and not names.contains("USED_COUNT")


pure func test_unused_kind_is_preserved() -> Bool:
	source: String = "private UNUSED_COUNT: Int = 1\nprivate pure func unused_helper() -> Int:\n\t1\n"
	unused: List[UnusedDefinition] = analyze_sources([source_file(source)], False).unused
	var formatted: String = ""

	for item in unused:
		formatted += item.format_unused_definition() + "\n"

	formatted.contains("constant UNUSED_COUNT") and formatted.contains("function unused_helper")


tests: TestSuite = {
	description = "unused Blorp code analyzer",
	tests = [
		("private unused function is reported", test_private_unused_function_is_reported),
		(
			"comments and strings do not count as references",
			test_comments_and_strings_do_not_count_as_references,
		),
		(
			"string interpolation expression counts as reference",
			test_string_interpolation_expression_counts_as_reference,
		),
		(
			"public definitions are ignored by default",
			test_public_definitions_are_ignored_by_default,
		),
		(
			"imported public definition is not reported when used",
			test_imported_public_definition_is_not_reported_when_used,
		),
		(
			"imported public definition is reported when unused",
			test_imported_public_definition_is_reported_when_unused,
		),
		(
			"public definition is reported when mentioned without import",
			test_public_definition_is_reported_when_mentioned_without_import,
		),
		(
			"qualified public definition is not reported when used",
			test_qualified_public_definition_is_not_reported_when_used,
		),
		("private constant is reported", test_private_constant_is_reported),
		("unused kind is preserved", test_unused_kind_is_preserved),
	]
}
