import:
    test: TestSuite
    ../../src/common/codegen/specialize/specialize as specialized
    ../../src/common/codegen/verify/verify: VerifiedProgram, verified_contents
    ./test_record: RuntimeCase, runtime_passes


private SOURCE: String =
    |func main() -> Int:
    |    first = ("left", void, "right")
    |    second = (void, void)
    |    0
    |


private pure func complete_catalogue(program: VerifiedProgram) -> Bool:
    facts = verified_contents(program)
    match facts.records:
        [stored, empty]:
            match (
                specialized.record_fields(stored),
                specialized.record_fields(empty),
                stored,
                empty,
            ):
                ([specialized.StringType, specialized.VoidType, specialized.StringType], [specialized.VoidType, specialized.VoidType], specialized.CountedFields(_), specialized.CountedFields(_)):
                    facts.unions.is_empty()
                _:
                    False
        _:
            False


private CASES: List[RuntimeCase] = [
    { description = "tuple roots retain children until final drop", name = "retain" },
    {
        description = "repeated tuple members release distinct owning occurrences",
        name = "repeated",
    },
    { description = "acquired member outlives its tuple root", name = "escape" },
    { description = "all Void tuple stores only the managed header", name = "void" },
]


func test_runtime_ownership_protocol() -> Bool:
    runtime_passes(SOURCE, complete_catalogue, "blorp/test/runtime/fixtures/tuple_test.c", CASES)


TESTS: TestSuite = {
    description = "Tuple shared record runtime ownership",
    tests = [("native tuple ownership and omitted Void storage", test_runtime_ownership_protocol)],
}
