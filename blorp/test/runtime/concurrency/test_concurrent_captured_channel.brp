import:
	memory: get_mem_stats, reset_mem_stats
	test: TestSuite


func send_from_captured_channel(ch: Channel[Int]) -> Bool:
	concurrent:
		sent = send(ch, 73)

	match sent:
		Ok(ok):
			ok
		Err(_):
			False


func send_and_receive_through_captured_channel() -> Bool:
	ch: Channel[Int] = channel(1)
	send_ok: Bool = send_from_captured_channel(ch)

	if not send_ok:
		False
	else:
		match recv(ch):
			Some(value):
				value == 73
			None:
				False


func test_task_copy_capture_releases_channel_environment() -> Bool:
	reset_mem_stats()
	result: Bool = send_and_receive_through_captured_channel()

	result and get_mem_stats().current_objects == 0


tests: TestSuite = {
	description = "Task Capture Ownership",
	tests = [
		(
			"task copy capture releases its channel environment",
			test_task_copy_capture_releases_channel_environment,
		),
	]
}
