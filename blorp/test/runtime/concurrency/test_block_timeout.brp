-- Block-level timeout semantics tests.
-- concurrent(timeout: N): should use one block-level deadline, not a fresh
-- timeout for each join.
-- Known hole: these are timing guards, not exhaustive scheduler exploration.
-- Keep generous margins so CI load does not turn scheduler latency into a
-- semantic failure.
import:
	system: now_microseconds
	test: TestSuite


block_timeout_short_task_ms: Int = 20

block_timeout_one_expires_ms: Int = 500

block_timeout_long_task_ms: Int = 5000

block_timeout_shared_deadline_ms: Int = 200

-- A per-join timeout bug would take about 6 * 200ms before overhead. The
-- budget stays below that while giving the shared-deadline path wide CI margin.
block_timeout_shared_deadline_budget_ms: Int = 1000


-- Task that sleeps for a given number of ms
func slow_task(ms: Int) -> Int:
	sleep(ms)
	ms


-- Short sibling tasks should complete when the block timeout has clear headroom.
func test_block_timeout_all_succeed() -> Bool:
	concurrent(timeout: 200):
		a = slow_task(30)
		b = slow_task(30)
		c = slow_task(30)

	a_ok: Bool = match a:
		Ok(v): v == 30
		Err(_): False
	b_ok: Bool = match b:
		Ok(v): v == 30
		Err(_): False
	c_ok: Bool = match c:
		Ok(v): v == 30
		Err(_): False
	a_ok and b_ok and c_ok


-- One slow task should time out without forcing independent short siblings to
-- time out. This deliberately avoids a razor-thin deadline; otherwise a loaded
-- CI runner can delay task startup long enough to fail the short-task checks.
func test_block_timeout_one_expires() -> Bool:
	concurrent(timeout: block_timeout_one_expires_ms):
		a = slow_task(block_timeout_short_task_ms)
		b = slow_task(block_timeout_long_task_ms)
		c = slow_task(block_timeout_short_task_ms)

	a_ok: Bool = match a:
		Ok(v): v == block_timeout_short_task_ms
		Err(_): False
	b_timed_out: Bool = match b:
		Ok(_): False
		Err(_): True
	c_ok: Bool = match c:
		Ok(v): v == block_timeout_short_task_ms
		Err(_): False
	a_ok and b_timed_out and c_ok


func timed_out_int(result: Result[Int, ConcurrencyError]) -> Bool:
	match result:
		Ok(_): False
		Err(_): True


func test_block_timeout_shared_deadline() -> Bool:
	start: Int = now_microseconds()

	concurrent(timeout: block_timeout_shared_deadline_ms):
		a = slow_task(block_timeout_long_task_ms)
		b = slow_task(block_timeout_long_task_ms)
		c = slow_task(block_timeout_long_task_ms)
		d = slow_task(block_timeout_long_task_ms)
		e = slow_task(block_timeout_long_task_ms)
		f = slow_task(block_timeout_long_task_ms)

	elapsed_ms: Int = (now_microseconds() - start) / 1000
	all_timed_out: Bool = (
		timed_out_int(a)
		and timed_out_int(b)
		and timed_out_int(c)
		and timed_out_int(d)
		and timed_out_int(e)
		and timed_out_int(f)
	)

	all_timed_out and elapsed_ms < block_timeout_shared_deadline_budget_ms


-- With timeout 0, all tasks should timeout immediately (or nearly)
func test_block_timeout_zero() -> Bool:
	concurrent(timeout: 0):
		a = slow_task(50)

	match a:
		Ok(_): False
		Err(_): True


-- Negative timeouts are immediate timeout requests, not "wait forever".
func test_block_timeout_negative() -> Bool:
	concurrent(timeout: -1):
		a = slow_task(50)

	match a:
		Ok(_): False
		Err(_): True


tests: TestSuite = {
	description = "Concurrency: block-level timeout",
	tests = [
		("block timeout all succeed", test_block_timeout_all_succeed),
		("block timeout one expires", test_block_timeout_one_expires),
		("block timeout shared deadline", test_block_timeout_shared_deadline),
		("block timeout zero", test_block_timeout_zero),
		("block timeout negative", test_block_timeout_negative),
	]
}
