-- Task cancellation tests
-- Tests cooperative cancellation: when a task is cancelled (via timeout or
-- explicit cancel), its blocking operations (sleep, recv, send) return early.
import:
	channel: wait_recv, wait_send
	memory: MemStats, get_mem_stats, reset_mem_stats
	stream: count, repeat
	system: file_exists, now_microseconds, remove_file, write_file
	test: TestSuite


-- A task with a long sleep should be cancelled quickly by timeout,
-- not wait the full sleep duration.
func very_slow_task() -> Int:
	sleep(10000)
	42


pure func cancellation_timeout_ms() -> Int:
	30


pure func cancellation_completion_budget_ms() -> Int:
	2000


func delayed_write_after_timeout(path: String) -> Int:
	sleep(500)
	_ = write_file(path, "late")
	7


func cancellation_probe_path() -> String:
	"/tmp/blorp_timeout_cancel_probe_" + now_microseconds().to_string() + ".txt"


func cancelled_task_with_managed_locals() -> Int:
	prefix: String = "cancel-" + 1.to_string()
	values: List[String] = [
		prefix + "-a",
		prefix + "-b",
		prefix + "-c",
		prefix + "-d",
		prefix + "-e",
		prefix + "-f",
		prefix + "-g",
		prefix + "-h",
	]
	sleep(10000)
	values.length()


-- Shapes that move a managed local's reference to a new owner and are then
-- cancelled while parked. Each reference must be released exactly once by
-- cancellation cleanup: the moved-from local's cleanup slot gives up the
-- reference where the new owner takes it. Under ASan a second release is a
-- heap-use-after-free; the leak counters cannot see it.
record MovedTables {
	rows: List[Int],
	other: List[Int]
}


record MovedWrapper {
	inner: MovedTables,
	tag: Int
}


union MovedHolder:
	MovedHolding(MovedTables)
	MovedEmpty


pure func moved_tables(seed: Int) -> MovedTables:
	{
		rows = [seed],
		other = [seed + 1]
	}


pure func moved_holder_rows(holder: MovedHolder) -> Int:
	match holder:
		MovedHolding(inner):
			inner.rows.length()
		MovedEmpty:
			0


-- A second name keeps the reference while the first is read again later.
func alias_kept_across_cancelled_sleep(seed: Int) -> Int:
	made: MovedTables = moved_tables(seed)
	same: MovedTables = made
	sleep(10000)
	same.rows.length() + made.other.length()


-- The alias is taken after an earlier suspension, so the first name's
-- cleanup slot is still armed when the reference moves.
func alias_after_sleep_then_cancelled(seed: Int) -> Int:
	made: MovedTables = moved_tables(seed)
	sleep(1)
	same: MovedTables = made
	sleep(10000)
	same.rows.length()


-- A constructor takes the reference while the local stays readable.
func constructor_kept_across_cancelled_sleep(seed: Int) -> Int:
	base: MovedTables = moved_tables(seed)
	held: MovedHolder = MovedHolding(base)
	sleep(10000)
	moved_holder_rows(held) + base.rows.length()


func sleep_then_holder_rows(holder: MovedHolder) -> Int:
	sleep(10000)
	moved_holder_rows(holder)


-- The constructor consumes the local and the callee is cancelled.
func constructor_into_cancelled_call(seed: Int) -> Int:
	base: MovedTables = moved_tables(seed)
	sleep_then_holder_rows(MovedHolding(base))


-- A mutable local takes the reference while the first name stays readable.
func var_alias_kept_across_cancelled_sleep(seed: Int) -> Int:
	made: MovedTables = moved_tables(seed)
	var slot: MovedTables = made
	sleep(10000)
	slot.rows.length() + made.rows.length()


-- The mutable local replaces the moved reference before the suspension.
func var_alias_replaced_before_cancelled_sleep(seed: Int) -> Int:
	made: MovedTables = moved_tables(seed)
	var slot: MovedTables = made
	slot = { slot | rows = slot.rows.append(seed) }
	sleep(10000)
	slot.rows.length() + made.rows.length()


-- A record field takes the reference while the local stays readable.
func record_field_kept_across_cancelled_sleep(seed: Int) -> Int:
	base: MovedTables = moved_tables(seed)
	wrapped: MovedWrapper = {
		inner = base,
		tag = seed
	}
	sleep(10000)
	wrapped.inner.rows.length() + base.rows.length()


func count_infinite_stream() -> Int:
	count(repeat(1))


func yield_until_cancelled() -> Int:
	var iterations: Int = 0
	var done: Bool = False

	while not done:
		iterations += 1
		yield_now()

	iterations


func cpu_loop_until_compiler_checkpoint_cancelled() -> Int:
	var iterations: Int = 0
	var done: Bool = False

	while not done:
		iterations += 1

	iterations


@tail_recursive
func tailrec_cpu_loop_until_compiler_checkpoint_cancelled(iterations: Int) -> Int:
	tailrec_cpu_loop_until_compiler_checkpoint_cancelled(iterations + 1)


func test_timeout_cancels_quickly() -> Bool:
	start: Int = now_microseconds()

	concurrent(timeout: cancellation_timeout_ms()):
		a = very_slow_task()

	elapsed_ms: Int = (now_microseconds() - start) / 1000

	timed_out: Bool = match a:
		Ok(_):
			False
		Err(_):
			True

	-- Should complete by timeout cancellation, not by waiting for the 10s sleep.
	timed_out and elapsed_ms < cancellation_completion_budget_ms()


-- A task blocked on recv should be freed by timeout
func recv_task(ch: Channel[Int]) -> Int:
	opt: Option[Int] = recv(ch)

	match opt:
		Some(v):
			v
		None:
			-1


func test_recv_cancelled_by_timeout() -> Bool:
	ch: Channel[Int] = channel(1)
	start: Int = now_microseconds()

	concurrent(timeout: cancellation_timeout_ms()):
		a = recv_task(ch)

	elapsed_ms: Int = (now_microseconds() - start) / 1000

	timed_out: Bool = match a:
		Ok(_):
			False
		Err(_):
			True

	timed_out and elapsed_ms < cancellation_completion_budget_ms()


func wait_recv_task(ch: Channel[Int]) -> Int:
	match wait_recv(ch):
		Ok(v):
			v
		Err(_):
			-1


func test_wait_recv_cancelled_by_timeout() -> Bool:
	ch: Channel[Int] = channel(1)
	start: Int = now_microseconds()

	concurrent(timeout: cancellation_timeout_ms()):
		a = wait_recv_task(ch)

	elapsed_ms: Int = (now_microseconds() - start) / 1000

	timed_out: Bool = match a:
		Ok(_):
			False
		Err(_):
			True

	refill_ok: Bool = send(ch, 7)

	recv_ok: Bool = match recv(ch):
		Some(v):
			v == 7
		None:
			False

	timed_out and elapsed_ms < cancellation_completion_budget_ms() and refill_ok and recv_ok


func send_task(ch: Channel[Int]) -> Int:
	if send(ch, 99):
		1
	else:
		-1


-- A task blocked on send should be cancelled by timeout and removed from the
-- channel wait queue. After cancellation, the channel should still be usable.
func test_send_cancelled_by_timeout() -> Bool:
	ch: Channel[Int] = channel(1)
	_ = send(ch, 1)
	start: Int = now_microseconds()

	concurrent(timeout: cancellation_timeout_ms()):
		a = send_task(ch)

	elapsed_ms: Int = (now_microseconds() - start) / 1000

	timed_out: Bool = match a:
		Ok(_):
			False
		Err(_):
			True

	first_ok: Bool = match recv(ch):
		Some(v):
			v == 1
		None:
			False

	refill_ok: Bool = try_send(ch, 2)

	second_ok: Bool = match recv(ch):
		Some(v):
			v == 2
		None:
			False

	(
		timed_out
		and elapsed_ms < cancellation_completion_budget_ms()
		and first_ok
		and refill_ok
		and second_ok
	)


func wait_send_task(ch: Channel[Int]) -> Int:
	match wait_send(ch, 99):
		Ok(_):
			1
		Err(_):
			-1


func test_wait_send_cancelled_by_timeout() -> Bool:
	ch: Channel[Int] = channel(1)
	_ = send(ch, 1)
	start: Int = now_microseconds()

	concurrent(timeout: cancellation_timeout_ms()):
		a = wait_send_task(ch)

	elapsed_ms: Int = (now_microseconds() - start) / 1000

	timed_out: Bool = match a:
		Ok(_):
			False
		Err(_):
			True

	first_ok: Bool = match recv(ch):
		Some(v):
			v == 1
		None:
			False

	refill_ok: Bool = try_send(ch, 2)

	second_ok: Bool = match recv(ch):
		Some(v):
			v == 2
		None:
			False

	(
		timed_out
		and elapsed_ms < cancellation_completion_budget_ms()
		and first_ok
		and refill_ok
		and second_ok
	)


-- Fast task + slow task: fast completes normally, slow times out
func fast_task() -> Int:
	42


func test_fast_and_slow() -> Bool:
	concurrent(timeout: 50):
		fast = fast_task()
		slow = very_slow_task()

	fast_ok: Bool = match fast:
		Ok(v):
			v == 42
		Err(_):
			False

	slow_timed_out: Bool = match slow:
		Ok(_):
			False
		Err(_):
			True

	fast_ok and slow_timed_out


func test_timeout_cancels_late_side_effect() -> Bool:
	path: String = cancellation_probe_path()
	_ = remove_file(path)

	concurrent(timeout: cancellation_timeout_ms()):
		a = delayed_write_after_timeout(path)

	timed_out: Bool = match a:
		Ok(_):
			False
		Err(_):
			True

	sleep(700)
	no_late_write: Bool = not file_exists(path)
	_ = remove_file(path)
	timed_out and no_late_write


func test_timeout_releases_cancelled_locals() -> Bool:
	reset_mem_stats()

	concurrent(timeout: 10):
		a = cancelled_task_with_managed_locals()

	timed_out: Bool = match a:
		Ok(_):
			False
		Err(_):
			True

	stats: MemStats = get_mem_stats()
	timed_out and stats.current_objects < 12


func test_timeout_releases_moved_references_once() -> Bool:
	reset_mem_stats()

	concurrent(timeout: 10):
		alias_kept = alias_kept_across_cancelled_sleep(1)
		alias_after = alias_after_sleep_then_cancelled(2)
		constructor_kept = constructor_kept_across_cancelled_sleep(3)
		constructor_call = constructor_into_cancelled_call(4)
		record_field = record_field_kept_across_cancelled_sleep(5)
		var_alias = var_alias_kept_across_cancelled_sleep(6)
		var_replaced = var_alias_replaced_before_cancelled_sleep(7)

	all_timed_out: Bool = [
		alias_kept.is_err(),
		alias_after.is_err(),
		constructor_kept.is_err(),
		constructor_call.is_err(),
		record_field.is_err(),
		var_alias.is_err(),
		var_replaced.is_err(),
	].all(func(timed_out): timed_out)

	stats: MemStats = get_mem_stats()
	all_timed_out and stats.current_objects == 0


func test_timeout_cancels_stream_count() -> Bool:
	start: Int = now_microseconds()

	concurrent(timeout: cancellation_timeout_ms()):
		a = count_infinite_stream()

	elapsed_ms: Int = (now_microseconds() - start) / 1000

	timed_out: Bool = match a:
		Ok(_):
			False
		Err(_):
			True

	timed_out and elapsed_ms < cancellation_completion_budget_ms()


func test_timeout_cancels_yield_loop() -> Bool:
	start: Int = now_microseconds()

	concurrent(timeout: cancellation_timeout_ms()):
		a = yield_until_cancelled()

	elapsed_ms: Int = (now_microseconds() - start) / 1000

	timed_out: Bool = match a:
		Ok(_):
			False
		Err(_):
			True

	timed_out and elapsed_ms < cancellation_completion_budget_ms()


func test_timeout_cancels_cpu_loop_without_source_yield() -> Bool:
	start: Int = now_microseconds()

	concurrent(timeout: cancellation_timeout_ms()):
		a = cpu_loop_until_compiler_checkpoint_cancelled()

	elapsed_ms: Int = (now_microseconds() - start) / 1000

	timed_out: Bool = match a:
		Ok(_):
			False
		Err(_):
			True

	timed_out and elapsed_ms < cancellation_completion_budget_ms()


func test_timeout_cancels_tailrec_cpu_loop_without_source_yield() -> Bool:
	start: Int = now_microseconds()

	concurrent(timeout: cancellation_timeout_ms()):
		a = tailrec_cpu_loop_until_compiler_checkpoint_cancelled(0)

	elapsed_ms: Int = (now_microseconds() - start) / 1000

	timed_out: Bool = match a:
		Ok(_):
			False
		Err(_):
			True

	timed_out and elapsed_ms < cancellation_completion_budget_ms()


-- Timeout 0 should immediately cancel all tasks
func test_zero_timeout() -> Bool:
	start: Int = now_microseconds()

	concurrent(timeout: 0):
		a = very_slow_task()

	elapsed_ms: Int = (now_microseconds() - start) / 1000

	timed_out: Bool = match a:
		Ok(_):
			False
		Err(_):
			True

	timed_out and elapsed_ms < cancellation_completion_budget_ms()


-- Cancelled variant is matchable in ConcurrencyError
func test_cancelled_variant_exists() -> Bool:
	-- Verify the Cancelled constructor exists and is matchable
	-- (This tests the type system, not runtime cancellation)
	concurrent(timeout: 1):
		a = very_slow_task()

	match a:
		Ok(_):
			False
		Err(e):
			match e:
				Timeout:
					True
				TaskFailed(_):
					False
				Cancelled:
					False


tests: TestSuite = {
	description = "Concurrency: cancellation",
	tests = [
		("timeout cancels quickly", test_timeout_cancels_quickly),
		("recv cancelled by timeout", test_recv_cancelled_by_timeout),
		("wait_recv cancelled by timeout", test_wait_recv_cancelled_by_timeout),
		("send cancelled by timeout", test_send_cancelled_by_timeout),
		("wait_send cancelled by timeout", test_wait_send_cancelled_by_timeout),
		("fast and slow tasks", test_fast_and_slow),
		("timeout cancels late side effect", test_timeout_cancels_late_side_effect),
		("timeout releases cancelled locals", test_timeout_releases_cancelled_locals),
		(
			"timeout releases moved references once",
			test_timeout_releases_moved_references_once,
		),
		("timeout cancels stream count", test_timeout_cancels_stream_count),
		("timeout cancels yield loop", test_timeout_cancels_yield_loop),
		(
			"timeout cancels CPU loop without source yield",
			test_timeout_cancels_cpu_loop_without_source_yield,
		),
		(
			"timeout cancels tailrec CPU loop without source yield",
			test_timeout_cancels_tailrec_cpu_loop_without_source_yield,
		),
		("zero timeout", test_zero_timeout),
		("cancelled variant exists", test_cancelled_variant_exists),
	]
}
