import:
	test: TestSuite


-- Test that normal fiber operations work correctly with guard page allocator
func compute_fib(n: Int) -> Int:
	if n <= 1:
		n
	else:
		compute_fib(n - 1) + compute_fib(n - 2)


func test_concurrent_basic() -> Bool:
	concurrent:
		a = 21 * 2
		b = 10 + 5
	match a:
		Ok(v):
			match b:
				Ok(w): v == 42 and w == 15
				Err(_): False
		Err(_): False


func test_concurrent_with_recursion() -> Bool:
	-- Moderate recursion should work fine within the default 56KB stack
	concurrent:
		fib_result = compute_fib(20)
	match fib_result:
		Ok(v): v == 6765
		Err(_): False


func test_concurrent_multiple_fibers() -> Bool:
	-- Multiple fibers all using guard page stacks
	concurrent:
		a = compute_fib(10)
		b = compute_fib(12)
		c = compute_fib(15)
	match a:
		Ok(va):
			match b:
				Ok(vb):
					match c:
						Ok(vc): va == 55 and vb == 144 and vc == 610
						Err(_): False
				Err(_): False
		Err(_): False


func test_concurrent_with_strings() -> Bool:
	-- String operations in fibers (exercises memory allocation on fiber stack)
	concurrent:
		greeting = "hello" + " " + "world"
		count = "testing fiber stacks".length()
	match greeting:
		Ok(g):
			match count:
				Ok(c): g == "hello world" and c == 20
				Err(_): False
		Err(_): False


func test_concurrent_timeout_still_works() -> Bool:
	-- Timeouts should work the same with guard pages
	concurrent(timeout: 5000):
		a = 42
	match a:
		Ok(v): v == 42
		Err(_): False


func test_sequential_fiber_reuse() -> Bool:
	-- Run multiple concurrent blocks sequentially — tests that fiber stacks
	-- are properly allocated and deallocated (guard pages unmapped)
	var total: Int = 0
	var i: Int = 0
	while i < 10:
		snapshot: Int = i
		concurrent:
			result = snapshot * snapshot
		match result:
			Ok(v): total += v
			Err(_): void
		i += 1

	-- sum of squares 0..9 = 0+1+4+9+16+25+36+49+64+81 = 285
	total == 285


tests: TestSuite = {
	description = "Fiber Guard Pages",
	tests = [
		("concurrent basic", test_concurrent_basic),
		("concurrent with recursion", test_concurrent_with_recursion),
		("concurrent multiple fibers", test_concurrent_multiple_fibers),
		("concurrent with strings", test_concurrent_with_strings),
		("concurrent timeout works", test_concurrent_timeout_still_works),
		("sequential fiber reuse", test_sequential_fiber_reuse),
	]
}
