-- Scheduler statistics are an instrumentation surface for concurrency
-- hardening. Tests use lower bounds because worker timing can coalesce wakeups.
import:
	instrumentation: SchedulerStats, get_scheduler_stats, reset_scheduler_stats
	memory: refcount
	test: TestSuite


func stats_noop(i: Int) -> Int:
	i


func stats_sleep(i: Int) -> Int:
	sleep(5)
	i


func stats_blocking_recv(ch: Channel[Int]) -> Int:
	match recv(ch):
		Some(v):
			v
		None:
			-1


func stats_delayed_send(ch: Channel[Int]) -> Int:
	sleep(10)

	if send(ch, 11):
		1
	else:
		0


func stats_blocking_send(ch: Channel[Int]) -> Int:
	if send(ch, 22):
		1
	else:
		0


func stats_delayed_recv(ch: Channel[Int]) -> Int:
	sleep(10)

	match recv(ch):
		Some(v):
			v
		None:
			-1


func stats_recv_timeout_poll(ch: Channel[Int]) -> Bool:
	match recv_timeout(ch, 0):
		Some(_):
			False
		None:
			True


func stats_send_timeout_poll(ch: Channel[Int]) -> Bool:
	not send_timeout(ch, 2, 0)


func stats_slow_cancel_probe() -> Int:
	sleep(10000)
	1


func stats_nested_blocking_child(started: Channel[Int], release: Channel[Int]) -> Int:
	_ = send(started, 1)

	match recv(release):
		Some(value):
			value
		None:
			-1


func stats_nested_parent(started: Channel[Int], release: Channel[Int]) -> Int:
	concurrent:
		child = stats_nested_blocking_child(started, release)

	match child:
		Ok(value):
			value
		Err(_):
			-1


func stats_nested_loop_parent(started: Channel[Int], release: Channel[Int]) -> Int:
	for _ in [1, 2] concurrently(limit: 2):
		ignored: Int = stats_nested_blocking_child(started, release)
		void

	1


func stats_active_task_probe() -> Bool:
	stats: SchedulerStats = get_scheduler_stats()
	stats.tracked_active_tasks >= 1


func stats_wait_for_parked_fiber() -> Bool:
	var attempts: Int = 0
	var found: Bool = False

	while attempts < 200 and not found:
		stats: SchedulerStats = get_scheduler_stats()

		if stats.tracked_parked_fibers >= 1:
			found = True
		else:
			sleep(1)

		attempts += 1

	found


func stats_release_after_park(ch: Channel[Int]) -> Bool:
	found: Bool = stats_wait_for_parked_fiber()
	_ = send(ch, 1)
	found


func stats_reset_gauge_probe(ch: Channel[Int]) -> Bool:
	found: Bool = stats_wait_for_parked_fiber()
	reset_scheduler_stats()
	stats: SchedulerStats = get_scheduler_stats()
	_ = send(ch, 1)
	found and stats.tracked_active_tasks >= 1 and stats.tracked_parked_fibers >= 1


func stats_wait_for_no_tracked_active_tasks() -> Bool:
	var attempts: Int = 0
	var done: Bool = False

	while attempts < 200 and not done:
		stats: SchedulerStats = get_scheduler_stats()

		if stats.tracked_active_tasks == 0:
			done = True
		else:
			sleep(1)

		attempts += 1

	done


func result_value_or_zero(result: Result[Int, ConcurrencyError]) -> Int:
	match result:
		Ok(value):
			value
		Err(_):
			0


func result_is_ok(result: Result[Int, ConcurrencyError]) -> Bool:
	match result:
		Ok(_):
			True
		Err(_):
			False


func stats_wait_for_completed_fibers(expected: Int) -> SchedulerStats:
	var stats: SchedulerStats = get_scheduler_stats()
	var attempts: Int = 0

	-- Task join is signalled from the fiber body just before the worker records
	-- the coroutine as dead. Wait for that scheduler postlude before asserting.
	while stats.fibers_completed < expected and attempts < 200:
		sleep(1)
		stats = get_scheduler_stats()
		attempts += 1

	stats


func test_scheduler_stats_count_fibers() -> Bool:
	reset_scheduler_stats()

	concurrent:
		a = stats_noop(1)
		b = stats_noop(2)
		c = stats_noop(3)
		d = stats_noop(4)
		e = stats_noop(5)
		f = stats_noop(6)
		g = stats_noop(7)
		h = stats_noop(8)

	stats: SchedulerStats = stats_wait_for_completed_fibers(8)
	var total: Int = result_value_or_zero(a)
	total += result_value_or_zero(b)
	total += result_value_or_zero(c)
	total += result_value_or_zero(d)
	total += result_value_or_zero(e)
	total += result_value_or_zero(f)
	total += result_value_or_zero(g)
	total += result_value_or_zero(h)
	var ok: Bool = total == 36
	ok = ok and result_is_ok(a)
	ok = ok and result_is_ok(b)
	ok = ok and result_is_ok(c)
	ok = ok and result_is_ok(d)
	ok = ok and result_is_ok(e)
	ok = ok and result_is_ok(f)
	ok = ok and result_is_ok(g)
	ok = ok and result_is_ok(h)
	ok = ok and stats.tasks_spawned >= 8
	ok = ok and stats.fibers_created + stats.fibers_reused >= 8
	ok = ok and stats.fiber_resumes >= 8
	ok = ok and stats.runnable_enqueues >= 8
	ok = ok and stats.run_queue_pops >= 8
	ok = ok and stats.fibers_completed >= 8
	ok


func test_scheduler_stats_count_parks_and_timers() -> Bool:
	reset_scheduler_stats()

	concurrent(max_threads: 2):
		a = stats_sleep(1)
		b = stats_sleep(2)
		c = stats_sleep(3)
		d = stats_sleep(4)

	stats: SchedulerStats = get_scheduler_stats()
	var total: Int = result_value_or_zero(a)
	total += result_value_or_zero(b)
	total += result_value_or_zero(c)
	total += result_value_or_zero(d)
	var ok: Bool = total == 10
	ok = ok and result_is_ok(a)
	ok = ok and result_is_ok(b)
	ok = ok and result_is_ok(c)
	ok = ok and result_is_ok(d)
	ok = ok and stats.tasks_spawned >= 4
	ok = ok and stats.fiber_parks >= 4
	ok = ok and stats.fiber_schedule_transitions >= 4
	ok = ok and stats.timer_inserts >= 4
	ok = ok and stats.timer_expirations >= 4
	ok


func test_scheduler_stats_count_channel_waits() -> Bool:
	reset_scheduler_stats()

	recv_ch: Channel[Int] = channel(1)

	concurrent:
		received = stats_blocking_recv(recv_ch)
		sent = stats_delayed_send(recv_ch)

	send_ch: Channel[Int] = channel(1)
	_ = send(send_ch, 1)

	concurrent:
		blocked_send = stats_blocking_send(send_ch)
		received_first = stats_delayed_recv(send_ch)

	stats: SchedulerStats = get_scheduler_stats()

	recv_ok: Bool = match received:
		Ok(v):
			v == 11
		Err(_):
			False

	delayed_send_ok: Bool = match sent:
		Ok(v):
			v == 1
		Err(_):
			False

	blocked_send_ok: Bool = match blocked_send:
		Ok(v):
			v == 1
		Err(_):
			False

	first_recv_ok: Bool = match received_first:
		Ok(v):
			v == 1
		Err(_):
			False

	second_recv_ok: Bool = match recv(send_ch):
		Some(v):
			v == 22
		None:
			False

	var ok: Bool = recv_ok
	ok = ok and delayed_send_ok
	ok = ok and blocked_send_ok
	ok = ok and first_recv_ok
	ok = ok and second_recv_ok
	ok = ok and stats.channel_recv_parks >= 1
	ok = ok and stats.channel_send_parks >= 1
	ok


func test_scheduler_stats_non_positive_channel_timeouts_do_not_park() -> Bool:
	reset_scheduler_stats()

	recv_ch: Channel[Int] = channel(1)
	send_ch: Channel[Int] = channel(1)
	_ = send(send_ch, 1)

	concurrent:
		recv_poll = stats_recv_timeout_poll(recv_ch)
		send_poll = stats_send_timeout_poll(send_ch)

	stats: SchedulerStats = get_scheduler_stats()

	recv_ok: Bool = match recv_poll:
		Ok(value):
			value
		Err(_):
			False

	send_ok: Bool = match send_poll:
		Ok(value):
			value
		Err(_):
			False

	var ok: Bool = recv_ok and send_ok
	ok = ok and stats.channel_recv_parks == 0
	ok = ok and stats.channel_send_parks == 0
	ok = ok and stats.timer_inserts == 0
	ok


func test_scheduler_stats_count_cancelled_tasks() -> Bool:
	reset_scheduler_stats()

	concurrent(timeout: 10):
		slow = stats_slow_cancel_probe()

	stats: SchedulerStats = get_scheduler_stats()

	timed_out: Bool = match slow:
		Ok(_):
			False
		Err(_):
			True

	timed_out and stats.tasks_cancelled >= 1 and stats.task_timeouts >= 1


func test_scheduler_stats_reports_tracked_active_tasks() -> Bool:
	reset_scheduler_stats()

	concurrent:
		probe = stats_active_task_probe()

	match probe:
		Ok(value):
			value
		Err(_):
			False


func test_scheduler_stats_reports_tracked_parked_fibers() -> Bool:
	reset_scheduler_stats()
	release: Channel[Int] = channel(1)

	concurrent:
		sleeper = stats_blocking_recv(release)
		probe = stats_release_after_park(release)

	probe_ok: Bool = match probe:
		Ok(value):
			value
		Err(_):
			False

	sleeper_ok: Bool = match sleeper:
		Ok(value):
			value == 1
		Err(_):
			False

	probe_ok and sleeper_ok


func test_scheduler_stats_reset_preserves_gauges() -> Bool:
	reset_scheduler_stats()
	release: Channel[Int] = channel(1)

	concurrent:
		sleeper = stats_blocking_recv(release)
		probe = stats_reset_gauge_probe(release)

	probe_ok: Bool = match probe:
		Ok(value):
			value
		Err(_):
			False

	sleeper_ok: Bool = match sleeper:
		Ok(value):
			value == 1
		Err(_):
			False

	probe_ok and sleeper_ok


func test_scheduler_stats_nested_timeout_cleans_child_tasks() -> Bool:
	reset_scheduler_stats()
	started: Channel[Int] = channel(1)
	release: Channel[Int] = channel(1)

	concurrent(timeout: 10):
		parent = stats_nested_parent(started, release)

	timed_out: Bool = match parent:
		Err(_):
			True
		_:
			False

	child_started: Bool = recv_timeout(started, 20) == Some(1)
	no_live_children: Bool = stats_wait_for_no_tracked_active_tasks()
	seal(release)
	timed_out and child_started and no_live_children


func test_scheduler_stats_nested_timeout_cleans_loop_tasks() -> Bool:
	reset_scheduler_stats()
	started: Channel[Int] = channel(2)
	release: Channel[Int] = channel(1)

	concurrent(timeout: 10):
		parent = stats_nested_loop_parent(started, release)

	timed_out: Bool = match parent:
		Err(_):
			True
		_:
			False

	first_started: Bool = recv_timeout(started, 20) == Some(1)
	second_started: Bool = recv_timeout(started, 20) == Some(1)
	no_live_children: Bool = stats_wait_for_no_tracked_active_tasks()
	seal(release)
	timed_out and first_started and second_started and no_live_children


func test_scheduler_stats_reset() -> Bool:
	reset_scheduler_stats()
	stats: SchedulerStats = get_scheduler_stats()
	var ok: Bool = stats.tasks_spawned == 0
	ok = ok and stats.tasks_cancelled == 0
	ok = ok and stats.task_timeouts == 0
	ok = ok and stats.fibers_created == 0
	ok = ok and stats.fibers_reused == 0
	ok = ok and stats.fibers_completed == 0
	ok = ok and stats.fiber_resumes == 0
	ok = ok and stats.channel_send_parks == 0
	ok = ok and stats.channel_recv_parks == 0
	ok = ok and stats.runnable_enqueues == 0
	ok = ok and stats.reactor_control_wakes == 0
	ok = ok and stats.reactor_poll_wakes == 0
	ok = ok and stats.reactor_ready_events == 0
	ok = ok and stats.reactor_waiter_wakes == 0
	ok


func test_scheduler_stats_snapshot_has_value_semantics() -> Bool:
	stats: SchedulerStats = get_scheduler_stats()
	refcount(stats) == 0


func test_scheduler_stats_reset_clears_cooperative_yields() -> Bool:
	reset_scheduler_stats()
	yield_now()
	before: SchedulerStats = get_scheduler_stats()
	reset_scheduler_stats()
	after: SchedulerStats = get_scheduler_stats()
	before.cooperative_yields >= 1 and after.cooperative_yields == 0


tests: TestSuite = {
	description = "Scheduler Stats",
	tests = [
		("counts fiber lifecycle", test_scheduler_stats_count_fibers),
		("counts parking and timers", test_scheduler_stats_count_parks_and_timers),
		("counts channel waits", test_scheduler_stats_count_channel_waits),
		(
			"non-positive channel timeouts do not park",
			test_scheduler_stats_non_positive_channel_timeouts_do_not_park,
		),
		("counts cancelled tasks", test_scheduler_stats_count_cancelled_tasks),
		("reports tracked active tasks", test_scheduler_stats_reports_tracked_active_tasks),
		("reports tracked parked fibers", test_scheduler_stats_reports_tracked_parked_fibers),
		("reset preserves gauges", test_scheduler_stats_reset_preserves_gauges),
		(
			"nested timeout cleans child tasks",
			test_scheduler_stats_nested_timeout_cleans_child_tasks,
		),
		("nested timeout cleans loop tasks", test_scheduler_stats_nested_timeout_cleans_loop_tasks),
		("reset clears counters", test_scheduler_stats_reset),
		(
			"scheduler stats snapshot has value semantics",
			test_scheduler_stats_snapshot_has_value_semantics,
		),
		("reset clears cooperative yields", test_scheduler_stats_reset_clears_cooperative_yields),
	]
}
