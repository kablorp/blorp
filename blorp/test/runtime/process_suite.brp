import:
    bool: and
    dict: Dict
    fs: create_directory, read_text, write_text
    int: Int methods
    io: IOError, IOErrorKind(NotFound, PermissionDenied), to_string, print_error
    list: List methods
    option: Option methods
    process:
        Captured,
        Command,
        Exit(Exited, Signaled, TimedOut),
        ProcessError,
        ProcessErrorKind(
            NotOnPath,
            LaunchFailed,
            NotExecutable,
            DirectoryFailed,
            ContainsNul,
            InvalidVariableName,
            StdoutNotUtf8,
            StderrNotUtf8,
            Unsuccessful,
        ),
        capture,
        command,
        find_program,
        output,
        run_to_files,
    result: Result methods
    string: String methods
    test: TestSuite
    ../../src/compile/runtime/fs: FS_HELPERS_RUNTIME
    ../../src/compile/runtime/list: list_runtime, list_element_key, list_c_type, LIST_SHARED_RUNTIME
    ../../src/compile/runtime/memory: MEMORY_RUNTIME
    ../../src/compile/runtime/process:
        PROCESS_POSIX_PRELUDE,
        PROCESS_HELPERS_RUNTIME,
        PROCESS_FIND_PROGRAM_RUNTIME,
        PROCESS_FAULT_RUNTIME,
        process_capture_runtime,
        process_runtime,
    ../../src/compile/runtime/string: string_runtime
    ../../src/compile/specialize/specialize: TypeRef(StringType)
    ../e2e/self_hosted_reports: verify_accounting


private ENVIRONMENT_TOOL: String = "/usr/bin/env"
private COMPILE_TIMEOUT_MS: Int = 600000
private CHILD_TIMEOUT_MS: Int = 10000
private TIMEOUT_PROBE_MS: Int = 1000


private func invocation(
    program: String,
    arguments: List[String],
    prefix: String,
    timeout: Int,
) -> Result[Int, String]:
    run_to_files(program, arguments, prefix + ".out", prefix + ".err", timeout)


private func isolated(
    child: String,
    arguments: List[String],
    prefix: String,
) -> Result[Int, String]:
    invocation(
        ENVIRONMENT_TOOL,
        ["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", child].concat(arguments),
        prefix,
        CHILD_TIMEOUT_MS,
    )


private func expect_status(actual: Int, expected: Int) -> Result[Void, String]:
    match actual.equals(expected):
        True:
            Ok(void)
        False:
            Err(
                (
                    ("process unit exit: expected " + expected.to_string() + ", got ")
                    + actual.to_string()
                ),
            )


private func empty_output(prefix: String) -> Result[Void, String]:
    out: String ?= read_text(prefix + ".out").map_err(to_string)
    err: String ?= read_text(prefix + ".err").map_err(to_string)
    match and(out.equals(""), err.equals("")):
        True: Ok(void)
        False: Err("process unit expected empty output: " + prefix)


private func child_ready(c_compiler: String, directory: String) -> Result[String, String]:
    key = list_element_key(StringType)
    fragments = (
        PROCESS_POSIX_PRELUDE
        + MEMORY_RUNTIME
        + string_runtime()
        + "\n"
        + LIST_SHARED_RUNTIME
        + list_runtime(
            key,
            "struct blorp_string*",
            "blorp_string_retain(element);",
            "blorp_string_release(element);",
        )
        + FS_HELPERS_RUNTIME
        + PROCESS_HELPERS_RUNTIME
        + process_runtime(list_c_type(key))
        + process_capture_runtime(list_c_type(key))
        + PROCESS_FIND_PROGRAM_RUNTIME
        + PROCESS_FAULT_RUNTIME
    )
    written: Void ?= write_text(directory + "/process_runtime.c", fragments).map_err(to_string)
    source: String ?= read_text("blorp/test/runtime/fixtures/process_child.c").map_err(to_string)
    copied: Void ?= write_text(directory + "/process_child.c", source).map_err(to_string)
    executable = directory + "/process_child"
    prefix = directory + "/runtime-build"
    status: Int ?= isolated(
        c_compiler,
        [
            "-std=c11",
            "-Wall",
            "-Wextra",
            "-Werror",
            "-pedantic",
            "-O0",
            "-fsanitize=address,undefined",
            "-fno-sanitize-recover=all",
            "-DBLORP_MEMORY_DIAGNOSTICS=1",
            directory + "/process_child.c",
            "-o",
            executable,
            "-lm",
            "-lpthread",
        ],
        prefix,
    )
    linked: Void ?= expect_status(status, 0)
    quiet: Void ?= empty_output(prefix)
    Ok(executable)


private func reported(result: Result[Void, String]) -> Bool:
    match result:
        Ok(_):
            True
        Err(error):
            print_error(error)
            False


private func exit_case(child: String, directory: String, status: Int) -> Result[Void, String]:
    prefix = (directory + "/exit-").append_int(status)
    actual: Int ?= isolated(child, ["exit", status.to_string()], prefix)
    matched: Void ?= expect_status(actual, status)
    empty_output(prefix)


private func literal_case(child: String, directory: String) -> Result[Void, String]:
    prefix = directory + "/literal-argv"
    status: Int ?= isolated(child, ["argv", "", "two words", "literal*$;'", "café"], prefix)
    matched: Void ?= expect_status(status, 0)
    empty_output(prefix)


private func stream_case(child: String, directory: String) -> Result[Void, String]:
    prefix = directory + "/streams"
    status: Int ?= isolated(child, ["streams"], prefix)
    matched: Void ?= expect_status(status, 0)
    out: String ?= read_text(prefix + ".out").map_err(to_string)
    err: String ?= read_text(prefix + ".err").map_err(to_string)
    match and(out.equals("stdout text\n"), err.equals("stderr text\n")):
        True: Ok(void)
        False: Err("stdout/stderr captures were not distinct")


private func input_case(child: String, directory: String) -> Result[Void, String]:
    prefix = directory + "/input-eof"
    status: Int ?= isolated(child, ["stdin"], prefix)
    matched: Void ?= expect_status(status, 0)
    empty_output(prefix)


private func error_is(actual: Result[Int, String], expected: String) -> Result[Void, String]:
    match actual:
        Ok(code):
            Err("expected process failure, got exit " + code.to_string())
        Err(error):
            match error.equals(expected):
                True: Ok(void)
                False: Err("wrong process error: " + error)


-- Native errno values are platform-owned; pin the operation that failed.
private func capture_error(
    actual: Result[Int, String],
    expected_prefix: String,
) -> Result[Void, String]:
    match actual:
        Ok(code):
            Err("expected capture failure, got exit " + code.to_string())
        Err(error):
            match error.starts_with(expected_prefix):
                True: Ok(void)
                False: Err("wrong capture error: " + error)


private func signal_case(child: String, directory: String) -> Result[Void, String]:
    error_is(
        isolated(child, ["signal"], directory + "/signal"),
        "process.run_to_files: child terminated by signal",
    )


private func timeout_case(child: String, directory: String) -> Result[Void, String]:
    ready_path = directory + "/timeout.ready"
    timed: Void ?= error_is(
        invocation(child, ["wait", ready_path], directory + "/timeout", TIMEOUT_PROBE_MS),
        "process.run_to_files: timed out",
    )
    ready: String ?= read_text(ready_path).map_err(to_string)
    match ready.equals("ready\n"):
        True: Ok(void)
        False: Err("timeout child never acknowledged readiness")


private func validation_case(child: String, directory: String, kind: Int) -> Result[Void, String]:
    prefix = (directory + "/validation-").append_int(kind)
    out = prefix + ".out"
    err = prefix + ".err"
    actual: Result[Int, String] = match kind.equals(0):
        True:
            run_to_files(child, ["exit", "0"], out, err, 0)
        False:
            match kind.equals(1):
                True:
                    run_to_files(child, ["bad\0argument"], out, err, CHILD_TIMEOUT_MS)
                False:
                    match kind.equals(2):
                        True: run_to_files(child, [], out, "", CHILD_TIMEOUT_MS)
                        False: run_to_files(child, [], out, "bad\0path", CHILD_TIMEOUT_MS)
    expected = match kind.equals(0):
        True:
            "process.run_to_files: timeout must be positive"
        False:
            match kind.equals(1):
                True:
                    "process.run_to_files: argument contains embedded NUL"
                False:
                    match kind.equals(2):
                        True: "process.run_to_files: capture path is empty"
                        False: "process.run_to_files: path contains embedded NUL"
    rejected: Void ?= error_is(actual, expected)
    -- The same paths must remain available after validation failure.
    status: Int ?= run_to_files(child, ["exit", "0"], out, err, CHILD_TIMEOUT_MS)
    expect_status(status, 0)


private func existing_case(child: String, directory: String, second: Bool) -> Result[Void, String]:
    prefix = match second:
        True: directory + "/second-existing"
        False: directory + "/first-existing"
    path = match second:
        True: prefix + ".err"
        False: prefix + ".out"
    written: Void ?= write_text(path, "preserve capture").map_err(to_string)
    expected = match second:
        True: "process.run_to_files: create stderr capture; errno="
        False: "process.run_to_files: create stdout capture; errno="
    failed: Void ?= capture_error(
        invocation(child, ["exit", "0"], prefix, CHILD_TIMEOUT_MS),
        expected,
    )
    unchanged: String ?= read_text(path).map_err(to_string)
    match unchanged.equals("preserve capture"):
        True: Ok(void)
        False: Err("existing capture was overwritten")


private func duplicate_case(child: String, directory: String) -> Result[Void, String]:
    path = directory + "/duplicate.capture"
    capture_error(
        run_to_files(child, ["exit", "0"], path, path, CHILD_TIMEOUT_MS),
        "process.run_to_files: create stderr capture; errno=",
    )


private func alias_case(child: String, directory: String) -> Result[Void, String]:
    out = directory + "/alias.capture"
    err = directory + "/./alias.capture"
    capture_error(
        run_to_files(child, ["exit", "0"], out, err, CHILD_TIMEOUT_MS),
        "process.run_to_files: create stderr capture; errno=",
    )


private func exec_case(child: String, directory: String, invalid: Bool) -> Result[Void, String]:
    path = match invalid:
        True: directory + "/invalid-executable"
        False: directory + "/missing-executable"
    prepared: Void ?= match invalid:
        False:
            Ok(void)
        True:
            match isolated(child, ["invalid-executable", path], directory + "/prepare-invalid"):
                Ok(code): expect_status(code, 0)
                Err(error): Err(error)
    prefix = match invalid:
        True: directory + "/invalid-exec"
        False: directory + "/missing-exec"
    match invocation(path, [], prefix, CHILD_TIMEOUT_MS):
        Ok(code):
            Err("failed exec became ordinary exit " + code.to_string())
        Err(error):
            match error.starts_with("process.run_to_files: exec or child setup; errno="):
                True: Ok(void)
                False: Err("wrong exec error: " + error)


private func unsafe_capture_case(
    child: String,
    directory: String,
    fifo: Bool,
) -> Result[Void, String]:
    prefix = match fifo:
        True: directory + "/fifo"
        False: directory + "/symlink"
    destination = prefix + ".capture"
    preparation: List[String] = match fifo:
        True: ["fifo", destination]
        False: ["symlink", directory + "/symlink-target", destination]
    created: Int ?= isolated(child, preparation, prefix + "-prepare")
    ready: Void ?= expect_status(created, 0)
    capture_error(
        run_to_files(child, [], destination, prefix + ".err", CHILD_TIMEOUT_MS),
        "process.run_to_files: create stdout capture; errno=",
    )


private func native_probe(child: String, directory: String, mode: String) -> Result[Void, String]:
    prefix = directory + "/" + mode
    actual: Int ?= invocation(
        ENVIRONMENT_TOOL,
        [
            "-u",
            "BLORP_MEMORY_STATS",
            "BLORP_LEAK_CHECK=strict",
            child,
            mode,
            child,
            prefix + "-inner.out",
            prefix + "-inner.err",
        ],
        prefix,
        CHILD_TIMEOUT_MS,
    )
    matched: Void ?= expect_status(actual, 0)
    out: String ?= read_text(prefix + ".out").map_err(to_string)
    quiet: Void ?= match out.equals(""):
        True: Ok(void)
        False: Err("runtime probe wrote stdout")
    report: String ?= read_text(prefix + ".err").map_err(to_string)
    verify_accounting(report, True)


-- The capture tests render every outcome as text, independently of
-- ProcessError's Stringable text, and compare it exactly.
private pure func exit_text(exit: Exit) -> String:
    match exit:
        Exited(status): "Exited(${status.to_string()})"
        Signaled(signal): "Signaled(${signal.to_string()})"
        TimedOut: "TimedOut"


private pure func captured_text(captured: Captured) -> String:
    "${captured.exit.exit_text()} [${captured.stdout}] [${captured.stderr}]"


private pure func io_kind_text(kind: IOErrorKind) -> String:
    error: IOError = { path = "", destination = None, kind = kind }
    error.to_string()


private pure func kind_text(kind: ProcessErrorKind) -> String:
    match kind:
        NotOnPath: "NotOnPath"
        LaunchFailed(io): "LaunchFailed(${io.io_kind_text()})"
        NotExecutable: "NotExecutable"
        DirectoryFailed(error): "DirectoryFailed(${error.to_string()})"
        ContainsNul: "ContainsNul"
        InvalidVariableName(name): "InvalidVariableName(${name})"
        StdoutNotUtf8(exit): "StdoutNotUtf8(${exit.exit_text()})"
        StderrNotUtf8(exit): "StderrNotUtf8(${exit.exit_text()})"
        Unsuccessful(captured): "Unsuccessful(${captured.captured_text()})"


private pure func error_text(error: ProcessError) -> String:
    "${error.program}: ${error.kind.kind_text()}"


private pure func outcome(result: Result[Captured, ProcessError]) -> String:
    match result:
        Ok(captured): captured.captured_text()
        Err(error): error.error_text()


private pure func expect_text(actual: String, expected: String) -> Result[Void, String]:
    if actual == expected:
        Ok(void)
    else:
        Err("process capture: expected [${expected}], got [${actual}]")


-- The fixture child reports leaks when these are set, so every child runs
-- without them, which also exercises removal.
private pure func quiet_environment() -> Dict[String, Option[String]]:
    { "BLORP_LEAK_CHECK" => None, "BLORP_MEMORY_STATS" => None }


private pure func child_command(child: String, arguments: List[String]) -> Command:
    { command(child, arguments) |
        environment = quiet_environment(),
        timeout_ms = Some(CHILD_TIMEOUT_MS),
    }


private func captured_as(run: Command, expected: String) -> Result[Void, String]:
    capture(run)
        .outcome()
        .expect_text(expected)


private func exits_case(child: String) -> Result[Void, String]:
    _ ?= child_command(child, ["streams"]).captured_as("Exited(0) [stdout text\n] [stderr text\n]")
    _ ?= child_command(child, ["exit", "23"]).captured_as("Exited(23) [] []")
    _ ?= child_command(child, ["exit", "127"]).captured_as("Exited(127) [] []")
    child_command(child, ["argv", "", "two words", "literal*$;'", "café"]).captured_as(
        "Exited(0) [] []",
    )


private func signaled_case(child: String) -> Result[Void, String]:
    _ ?= child_command(child, ["signal"]).captured_as("Signaled(15) [] []")
    child_command(child, ["partial-signal"]).captured_as("Signaled(15) [ok] []")


private func timed_out_case(child: String, directory: String) -> Result[Void, String]:
    ready_path = directory + "/capture-timeout.ready"
    timed = { child_command(child, ["partial", ready_path]) | timeout_ms = Some(TIMEOUT_PROBE_MS) }
    _ ?= timed.captured_as("TimedOut [ok] [er]")
    ready: String ?= read_text(ready_path).map_err(to_string)
    expect_text(ready, "ready\n")


-- The call returns when the child exits, and the group kill ends the
-- grandchild that still holds both pipes.
private func grandchild_case(child: String, directory: String) -> Result[Void, String]:
    pid_path = directory + "/capture-grandchild.pid"
    _ ?= child_command(child, ["grandchild", pid_path]).captured_as("Exited(0) [parent done\n] []")
    pid: String ?= read_text(pid_path).map_err(to_string)
    child_command(child, ["gone", pid]).captured_as("Exited(0) [] []")


private func utf8_case(child: String) -> Result[Void, String]:
    _ ?= child_command(child, ["cut-off-exit", "4"]).captured_as(
        "${child}: StdoutNotUtf8(Exited(4))",
    )
    child_command(child, ["invalid-stderr", "0"]).captured_as("${child}: StderrNotUtf8(Exited(0))")


-- 256 KiB, four times a pipe buffer, so the child blocks writing unless the
-- call reads while it writes.
private pure func large_text() -> String:
    var text = "abcdefg\n"
    for _ in 0..15:
        text = text + text
    text


private func stdin_case(child: String) -> Result[Void, String]:
    text = large_text()
    echoed = capture({ child_command(child, ["echo-stdin"]) | stdin = Some(text) })
    _ ?= match echoed:
        Ok(captured):
            if captured.stdout == text:
                expect_text(captured.exit.exit_text(), "Exited(0)")
            else:
                Err("stdin was not echoed whole: ${captured.stdout.length().to_string()} bytes")
        Err(error):
            Err(error.error_text())
    _ ?= child_command(child, ["stdin"]).captured_as("Exited(0) [] []")
    { child_command(child, ["stdin"]) | stdin = Some("") }.captured_as("Exited(0) [] []")


private func unread_stdin_case(child: String) -> Result[Void, String]:
    text = large_text() + large_text() + large_text() + large_text()
    _ ?= { child_command(child, ["close-stdin"]) | stdin = Some(text) }.captured_as(
        "Exited(0) [] []",
    )
    { child_command(child, ["exit", "0"]) | stdin = Some(text) }.captured_as("Exited(0) [] []")


private NEWLINE_BYTE: Int = 10


private pure func lines(text: String) -> List[String]:
    var found: List[String] = []
    var start = 0
    for position in 0..text.length():
        match text.byte_at(position):
            Some(byte):
                if byte == NEWLINE_BYTE:
                    found = found.append(
                        text
                            .slice(start, position)
                            .get_or(""),
                    )
                    start = position + 1
            None:
                void
    found


-- The variables of an `env` listing whose entries start with `prefix`.
private pure func entries_named(listing: String, prefix: String) -> String:
    listing
        .lines()
        .filter(pure func(line: String) -> Bool: line.starts_with(prefix))
        .join(",")


-- /usr/bin/env lists the environment it received. The fixture child cannot be
-- used here: AddressSanitizer warns on stderr when PATH is unset.
private func environment_case() -> Result[Void, String]:
    changed = quiet_environment()
        .set("BLORP_PROCESS_SET", Some("one=two"))
        .set("PATH", None)
        .set("HOME", Some("/replaced"))
    listed: Captured ?= capture({ command(ENVIRONMENT_TOOL, []) | environment = changed }).map_err(
        error_text,
    )
    _ ?= expect_text(
        [
            listed.exit.exit_text(),
            listed.stdout.entries_named("BLORP_PROCESS_SET="),
            listed.stdout.entries_named("PATH="),
            listed.stdout.entries_named("HOME="),
            listed.stdout.entries_named("BLORP_LEAK_CHECK="),
        ].join(" | "),
        "Exited(0) | BLORP_PROCESS_SET=one=two |  | HOME=/replaced | ",
    )
    inherited: Captured ?= capture(command(ENVIRONMENT_TOOL, [])).map_err(error_text)
    if (
        inherited.stdout
            .entries_named("PATH=/")
            .length()
        > 0
    ):
        Ok(void)
    else:
        Err("PATH was not inherited")


-- The program does not exist, so an error other than the expected one, such
-- as LaunchFailed, would show that a system call came first.
private func rejection_case(directory: String) -> Result[Void, String]:
    missing = directory + "/no-such-program"
    _ ?= { command(missing, []) | environment = { "" => Some("x") } }.captured_as(
        "${missing}: InvalidVariableName()",
    )
    _ ?= { command(missing, []) | environment = { "A=B" => None } }.captured_as(
        "${missing}: InvalidVariableName(A=B)",
    )
    _ ?= command(missing + "\0", []).captured_as("${missing}\0: ContainsNul")
    _ ?= command(missing, ["a\0b"]).captured_as("${missing}: ContainsNul")
    _ ?= { command(missing, []) | environment = { "NAME" => Some("a\0b") } }.captured_as(
        "${missing}: ContainsNul",
    )
    { command(missing, []) | environment = { "NA\0ME" => None } }.captured_as(
        "${missing}: ContainsNul",
    )


private func directory_case(child: String, directory: String) -> Result[Void, String]:
    place = directory + "/capture-place"
    _ ?= create_directory(place).map_err(to_string)
    _ ?= write_text(place + "/marker.txt", "marked\n").map_err(to_string)
    _ ?= { child_command(child, ["cat-file", "marker.txt"]) | directory = Some(place) }.captured_as(
        "Exited(0) [marked\n] []",
    )
    missing = directory + "/capture-missing"
    _ ?= { child_command(child, []) | directory = Some(missing) }.captured_as(
        "${child}: DirectoryFailed(${missing}: no such file)",
    )
    { child_command(child, []) | directory = Some("bad\0place") }.captured_as(
        "${child}: DirectoryFailed(bad\0place: path contains a NUL byte)",
    )


private func launch_case(child: String, directory: String) -> Result[Void, String]:
    missing = directory + "/capture-missing-program"
    _ ?= command(missing, []).captured_as("${missing}: LaunchFailed(: no such file)")
    plain = directory + "/capture-plain-file"
    _ ?= write_text(plain, "not a program\n").map_err(to_string)
    _ ?= command(plain, []).captured_as("${plain}: LaunchFailed(: permission denied)")
    script = directory + "/capture-invalid-executable"
    _ ?= child_command(child, ["invalid-executable", script]).captured_as("Exited(0) [] []")
    command(script, []).captured_as("${script}: NotExecutable")


private func zero_timeout_case(directory: String) -> Result[Void, String]:
    missing = directory + "/never-started"
    _ ?= { command(missing, []) | timeout_ms = Some(0) }.captured_as("TimedOut [] []")
    { command(missing, []) | timeout_ms = Some(-5) }.captured_as("TimedOut [] []")


private func output_case(child: String) -> Result[Void, String]:
    _ ?= match output(child_command(child, ["streams"])):
        Ok(text): expect_text(text, "stdout text\n")
        Err(error): Err(error.error_text())
    match output(child_command(child, ["fail-streams"])):
        Ok(text):
            Err("Unsuccessful became Ok: " + text)
        Err(error):
            expect_text(error.error_text(), "${child}: Unsuccessful(Exited(7) [out\n] [err\n])")


-- SIGABRT is 6 on macOS and Linux.
private func defect_case(child: String) -> Result[Void, String]:
    _ ?= child_command(child, ["bad-error-code"]).captured_as(
        "Signaled(6) [] [blorp: process runtime defect: an error code outside the tags the library decodes\n]",
    )
    _ ?= child_command(child, ["bad-exit"]).captured_as(
        "Signaled(6) [] [blorp: process runtime defect: an Exit outside the codes the library decodes\n]",
    )
    child_command(child, ["fault"]).captured_as(
        "Signaled(6) [] [blorp: process runtime defect: forced by the probe\n]",
    )


private pure func found_text(result: Result[String, ProcessError]) -> String:
    match result:
        Ok(path): "Ok(${path})"
        Err(error): error.error_text()


private func find_program_case() -> Result[Void, String]:
    _ ?= find_program("blorp-process-suite-missing")
        .found_text()
        .expect_text("blorp-process-suite-missing: NotOnPath")
    _ ?= find_program("../bin/sh")
        .found_text()
        .expect_text("../bin/sh: NotOnPath")
    _ ?= find_program("")
        .found_text()
        .expect_text(": NotOnPath")
    _ ?= find_program("s\0h")
        .found_text()
        .expect_text("s\0h: ContainsNul")
    match find_program("sh"):
        Ok(path):
            if (
                path
                    .starts_with("/")
                    .and(path.ends_with_sh())
            ):
                Ok(void)
            else:
                Err("find_program(sh) gave " + path)
        Err(error):
            Err(error.error_text())


private pure func ends_with_sh(path: String) -> Bool:
    match path.slice(path.length() - 3, path.length()):
        Some(tail): tail == "/sh"
        None: False


private pure func make_error_text(kind: ProcessErrorKind) -> String:
    error: ProcessError = { program = "make", kind = kind }
    error.to_string()


private pure func test_to_string_words_every_kind() -> Bool:
    directory: IOError = { path = "/work", destination = None, kind = NotFound }
    quiet_failure: Captured = { exit = Signaled(9), stdout = "", stderr = "" }
    loud_failure: Captured = { exit = Exited(2), stdout = "partial", stderr = "no rule\n" }
    cases: List[(ProcessErrorKind, String)] = [
        (NotOnPath, "make: not found on PATH"),
        (LaunchFailed(PermissionDenied), "make: permission denied"),
        (NotExecutable, "make: not a program the system can run; a script needs a #! line"),
        (DirectoryFailed(directory), "make: cannot enter /work: no such file"),
        (ContainsNul, "make: the program, an argument or the environment contains a NUL byte"),
        (
            InvalidVariableName("A=B"),
            "make: invalid environment variable name \"A=B\"; a name is nonempty and has no =",
        ),
        (StdoutNotUtf8(Exited(0)), "make: exited 0, and its stdout is not UTF-8"),
        (StderrNotUtf8(TimedOut), "make: timed out, and its stderr is not UTF-8"),
        (Unsuccessful(quiet_failure), "make: killed by signal 9"),
        (Unsuccessful(loud_failure), "make: exited 2\nno rule\n"),
    ]
    cases.all(pure func(case: (ProcessErrorKind, String)) -> Bool:
        match case:
            (kind, expected): kind.make_error_text() == expected
    )


private pure func test_interpolation_and_to_string_agree_on_an_unsuccessful_exit() -> Bool:
    failed: Captured = { exit = Exited(2), stdout = "partial", stderr = "no rule\n" }
    error: ProcessError = { program = "make", kind = Unsuccessful(failed) }
    ("${error}" == "make: exited 2\nno rule\n").and(
        error.to_string() == "make: exited 2\nno rule\n",
    )


private pure func test_succeeded_is_exited_zero() -> Bool:
    cases: List[(Exit, Bool)] = [
        (Exited(0), True),
        (Exited(1), False),
        (Signaled(9), False),
        (TimedOut, False),
    ]
    cases.all(pure func(case: (Exit, Bool)) -> Bool:
        match case:
            (exit, expected): exit.succeeded() == expected
    )


private func capture_tests(child: String, directory: String) -> List[(String, () -> Bool)]:
    [
        (
            "capture: Exited carries 0, 23 and 127, with stdout and stderr kept apart and arguments literal",
            func(): reported(exits_case(child)),
        ),
        (
            "capture: Signaled carries the signal and drops a cut-off character",
            func(): reported(signaled_case(child)),
        ),
        (
            "capture: TimedOut kills the child, keeps its output and drops a cut-off character",
            func(): reported(timed_out_case(child, directory)),
        ),
        (
            "capture: a grandchild holding the pipes open neither hangs the call nor outlives it",
            func(): reported(grandchild_case(child, directory)),
        ),
        (
            "capture: output that is not UTF-8 after Exited is an error carrying the Exit",
            func(): reported(utf8_case(child)),
        ),
        (
            "capture: stdin is written while output is read, then closed; None and empty are end of file",
            func(): reported(stdin_case(child)),
        ),
        (
            "capture: a child that exits without reading its stdin is not an error",
            func(): reported(unread_stdin_case(child)),
        ),
        (
            "capture: the environment sets, removes and inherits variables",
            func(): reported(environment_case()),
        ),
        (
            "capture: an invalid variable name and NUL are rejected before any system call",
            func(): reported(rejection_case(directory)),
        ),
        (
            "capture: directory runs the child there, and DirectoryFailed names it",
            func(): reported(directory_case(child, directory)),
        ),
        (
            "capture: a missing or unexecutable program is LaunchFailed, a file without #! NotExecutable",
            func(): reported(launch_case(child, directory)),
        ),
        (
            "capture: a timeout of zero or less times out at once without starting the program",
            func(): reported(zero_timeout_case(directory)),
        ),
        (
            "output: stdout after Exited(0), and Unsuccessful carrying the capture otherwise",
            func(): reported(output_case(child)),
        ),
        (
            "find_program: finds sh; a missing name, a name with a / or an empty one is NotOnPath, NUL ContainsNul",
            func(): reported(find_program_case()),
        ),
        (
            "a code the library cannot decode, and process.fault, abort with the defect named",
            func(): reported(defect_case(child)),
        ),
        ("to_string words every kind", test_to_string_words_every_kind),
        (
            "interpolation and to_string agree on an unsuccessful exit",
            test_interpolation_and_to_string_agree_on_an_unsuccessful_exit,
        ),
        ("succeeded is Exited(0) alone", test_succeeded_is_exited_zero),
        (
            "capture leaves SIGCHLD and the signal mask as they were and consumes only its own SIGPIPE",
            func(): reported(native_probe(child, directory, "capture-signals")),
        ),
        (
            "capture with SIGCHLD ignored is LaunchFailed(OtherOs(ECHILD)) before forking",
            func(): reported(native_probe(child, directory, "capture-sigchld")),
        ),
        (
            "capture reaps its child after an exit and a timeout, and a zero timeout never forks",
            func(): reported(native_probe(child, directory, "capture-reap")),
        ),
        (
            "capture returns once its child has exited although a stray process holds the exec report open",
            func(): reported(native_probe(child, directory, "capture-stray-report")),
        ),
        (
            "find_program skips empty and relative PATH entries, files it cannot execute and directories",
            func(): reported(native_probe(child, directory, "find-program")),
        ),
    ]


func suite(c_compiler: String, directory: String) -> TestSuite:
    match child_ready(c_compiler, directory):
        Err(error):
            print_error(error)
            {
                description = "Process runtime setup",
                tests = [("native probe build", func(): False)],
            }
        Ok(child):
            {
                description = "Process runtime lifecycle",
                tests = [
                    ("ordinary exit zero", func(): reported(exit_case(child, directory, 0))),
                    ("ordinary exit 23", func(): reported(exit_case(child, directory, 23))),
                    (
                        "ordinary exit 127 differs from exec failure",
                        func(): reported(exit_case(child, directory, 127)),
                    ),
                    (
                        "literal empty spaced metacharacter Unicode argv",
                        func(): reported(literal_case(child, directory)),
                    ),
                    (
                        "stdout and stderr stay distinct",
                        func(): reported(stream_case(child, directory)),
                    ),
                    ("stdin is EOF", func(): reported(input_case(child, directory))),
                    ("signal is an error", func(): reported(signal_case(child, directory))),
                    (
                        "ready child times out and is cleaned",
                        func(): reported(timeout_case(child, directory)),
                    ),
                    (
                        "zero timeout rejects before files",
                        func(): reported(validation_case(child, directory, 0)),
                    ),
                    (
                        "NUL argument rejects before files",
                        func(): reported(validation_case(child, directory, 1)),
                    ),
                    (
                        "empty stderr path rejects before files",
                        func(): reported(validation_case(child, directory, 2)),
                    ),
                    (
                        "NUL path rejects before files",
                        func(): reported(validation_case(child, directory, 3)),
                    ),
                    (
                        "existing stdout preserved",
                        func(): reported(existing_case(child, directory, False)),
                    ),
                    (
                        "second capture creation failure preserves existing stderr",
                        func(): reported(existing_case(child, directory, True)),
                    ),
                    ("duplicate capture fails", func(): reported(duplicate_case(child, directory))),
                    (
                        "distinct spellings of one capture fail",
                        func(): reported(alias_case(child, directory)),
                    ),
                    (
                        "missing executable is an error",
                        func(): reported(exec_case(child, directory, False)),
                    ),
                    (
                        "invalid executable is an error",
                        func(): reported(exec_case(child, directory, True)),
                    ),
                    (
                        "FIFO capture rejected without blocking",
                        func(): reported(unsafe_capture_case(child, directory, True)),
                    ),
                    (
                        "symlink capture rejected",
                        func(): reported(unsafe_capture_case(child, directory, False)),
                    ),
                    (
                        "closed stdio descriptors stay private and balanced",
                        func(): reported(native_probe(child, directory, "closedstdio")),
                    ),
                    (
                        "ordinary exit reaps the direct child",
                        func(): reported(native_probe(child, directory, "reap-exit")),
                    ),
                    (
                        "signal reaps the direct child",
                        func(): reported(native_probe(child, directory, "reap-signal")),
                    ),
                    (
                        "exec handshake timeout reaps the acknowledged child",
                        func(): reported(native_probe(child, directory, "reap-startup")),
                    ),
                    (
                        "timeout reaps the direct child",
                        func(): reported(native_probe(child, directory, "reap-timeout")),
                    ),
                    (
                        "a lost group race still leaves the child leading its group",
                        func(): reported(native_probe(child, directory, "group-race")),
                    ),
                    (
                        "unsupported SIGCHLD fails before files",
                        func(): reported(native_probe(child, directory, "sigchld")),
                    ),
                ].concat(capture_tests(child, directory)),
            }
