import:
    bool: and
    dict: Dict
    io/process:
        Captured,
        Command,
        Exit(Exited, Signaled, TimedOut),
        CaptureError(
            InvalidVariableName,
            ContainsNul,
            LaunchFailed,
            NotExecutable,
            DirectoryFailed,
            StdoutNotUtf8,
            StderrNotUtf8,
        ),
        FindProgramError(NotOnPath, NameContainsNul),
        OutputError(CaptureFailed, Unsuccessful),
        SystemCallError(NotFound, PermissionDenied, NotADirectory, OtherOs),
        capture,
        command,
        decode_capture_error,
        decode_find_program_error,
        decode_system_call_error,
        find_program,
        output,
    list: List methods
    option: Option methods
    path: Path, PathError, to_path
    result: Result methods
    string: String methods
    test: TestSuite
    ../../src/common/codegen/runtime/fs: FS_HELPERS_RUNTIME
    ../../src/common/codegen/runtime/list:
        list_runtime,
        list_element_key,
        list_c_type,
        LIST_SHARED_RUNTIME,
    ../../src/common/codegen/runtime/memory: MEMORY_RUNTIME
    ../../src/common/codegen/runtime/process:
        PROCESS_POSIX_PRELUDE,
        PROCESS_HELPERS_RUNTIME,
        PROCESS_FIND_PROGRAM_RUNTIME,
        PROCESS_FAULT_RUNTIME,
        process_capture_runtime,
    ../../src/common/codegen/runtime/string: string_runtime
    ../../src/common/codegen/specialize/specialize: TypeRef(StringType)
    ../e2e/file_access: make_directories, path_of, read_file, write_file
    ../e2e/self_hosted_harness: run_expecting, strict_leak_check, without_diagnostics
    ../e2e/self_hosted_reports: verify_accounting


private ENVIRONMENT_TOOL: String = "/usr/bin/env"
private COMPILE_TIMEOUT_MS: Int = 600000
private CHILD_TIMEOUT_MS: Int = 10000
private TIMEOUT_PROBE_MS: Int = 1000


private func child_ready(c_compiler: String, directory: String) -> Result[Path, String]:
    key = list_element_key(StringType)
    fragments = (
        PROCESS_POSIX_PRELUDE
        + MEMORY_RUNTIME
        + string_runtime()
        + "\n"
        + LIST_SHARED_RUNTIME
        + list_runtime(
            key,
            "struct blorp_string*",
            "blorp_string_retain(element);",
            "blorp_string_release(element);",
        )
        + FS_HELPERS_RUNTIME
        + PROCESS_HELPERS_RUNTIME
        + process_capture_runtime(list_c_type(key))
        + PROCESS_FIND_PROGRAM_RUNTIME
        + PROCESS_FAULT_RUNTIME
    )
    written: Void ?= write_file(directory + "/process_runtime.c", fragments)
    source: String ?= read_file("blorp/test/runtime/fixtures/process_child.c")
    copied: Void ?= write_file(directory + "/process_child.c", source)
    executable ?= path_of(directory + "/process_child")
    compiler ?= path_of(c_compiler)
    build = child_command(compiler, [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-pedantic",
        "-O0",
        "-fsanitize=address,undefined",
        "-fno-sanitize-recover=all",
        "-DBLORP_MEMORY_DIAGNOSTICS=1",
        directory + "/process_child.c",
        "-o",
        "${executable}",
        "-lm",
        "-lpthread",
    ])
    built ?= run_expecting(
        "process probe build",
        { build | timeout_ms = Some(COMPILE_TIMEOUT_MS) },
        0,
    )
    _ ?= expect_text(built.stdout + built.stderr, "")
    Ok(executable)


private func reported(result: Result[Void, String]) -> Bool:
    match result:
        Ok(_):
            True
        Err(error):
            print_error(error)
            False


-- The probe runs as the program's own path, given `mode`, its own path again,
-- which the probe launches, and a path it may create.
private func native_probe(child: Path, directory: String, mode: String) -> Result[Void, String]:
    probe = child_command(child, [mode, "${child}", directory + "/" + mode])
    ran ?= run_expecting(mode, { probe | environment = strict_leak_check() }, 0)
    _ ?= expect_text(ran.stdout, "")
    verify_accounting(ran.stderr, True)


-- The capture tests render every outcome as text, independently of the
-- errors' Stringable text, and compare it exactly.
private pure func exit_text(exit: Exit) -> String:
    match exit:
        Exited(status): "Exited(${status})"
        Signaled(signal): "Signaled(${signal})"
        TimedOut: "TimedOut"


private pure func captured_text(captured: Captured) -> String:
    "${captured.exit.exit_text()} [${captured.stdout}] [${captured.stderr}]"


private pure func cause_text(cause: SystemCallError) -> String:
    match cause:
        NotFound: "NotFound"
        PermissionDenied: "PermissionDenied"
        NotADirectory: "NotADirectory"
        OtherOs(number): "OtherOs(${number})"


private pure func capture_error_text(error: CaptureError) -> String:
    match error:
        InvalidVariableName(name): "InvalidVariableName(${name})"
        ContainsNul: "ContainsNul"
        LaunchFailed(cause): "LaunchFailed(${cause.cause_text()})"
        NotExecutable: "NotExecutable"
        DirectoryFailed(cause): "DirectoryFailed(${cause.cause_text()})"
        StdoutNotUtf8(exit): "StdoutNotUtf8(${exit.exit_text()})"
        StderrNotUtf8(exit): "StderrNotUtf8(${exit.exit_text()})"


private pure func output_error_text(error: OutputError) -> String:
    match error:
        CaptureFailed(cause): "CaptureFailed(${cause.capture_error_text()})"
        Unsuccessful(captured): "Unsuccessful(${captured.captured_text()})"


private pure func outcome(result: Result[Captured, CaptureError]) -> String:
    match result:
        Ok(captured): captured.captured_text()
        Err(error): error.capture_error_text()


private pure func expect_text(actual: String, expected: String) -> Result[Void, String]:
    if actual == expected:
        Ok(void)
    else:
        Err("process capture: expected [${expected}], got [${actual}]")


-- The fixture child reports leaks and statistics when the diagnostics variables
-- are set, so every child runs without them, which also exercises removal.
private pure func child_command(child: Path, arguments: List[String]) -> Command:
    { command(child, arguments) |
        environment = without_diagnostics(),
        timeout_ms = Some(CHILD_TIMEOUT_MS),
    }


private func captured_as(run: Command, expected: String) -> Result[Void, String]:
    capture(run)
        .outcome()
        .expect_text(expected)


private func exits_case(child: Path) -> Result[Void, String]:
    _ ?= child_command(child, ["streams"]).captured_as("Exited(0) [stdout text\n] [stderr text\n]")
    _ ?= child_command(child, ["exit", "23"]).captured_as("Exited(23) [] []")
    _ ?= child_command(child, ["exit", "127"]).captured_as("Exited(127) [] []")
    child_command(child, ["argv", "", "two words", "literal*$;'", "café"]).captured_as(
        "Exited(0) [] []",
    )


private func signaled_case(child: Path) -> Result[Void, String]:
    _ ?= child_command(child, ["signal"]).captured_as("Signaled(15) [] []")
    child_command(child, ["partial-signal"]).captured_as("Signaled(15) [ok] []")


private func timed_out_case(child: Path, directory: String) -> Result[Void, String]:
    ready_path = directory + "/capture-timeout.ready"
    timed = { child_command(child, ["partial", ready_path]) | timeout_ms = Some(TIMEOUT_PROBE_MS) }
    _ ?= timed.captured_as("TimedOut [ok] [er]")
    ready: String ?= read_file(ready_path)
    expect_text(ready, "ready\n")


-- The call returns when the child exits, and the group kill ends the
-- grandchild that still holds both pipes.
private func grandchild_case(child: Path, directory: String) -> Result[Void, String]:
    pid_path = directory + "/capture-grandchild.pid"
    _ ?= child_command(child, ["grandchild", pid_path]).captured_as("Exited(0) [parent done\n] []")
    pid: String ?= read_file(pid_path)
    child_command(child, ["gone", pid]).captured_as("Exited(0) [] []")


private func utf8_case(child: Path) -> Result[Void, String]:
    _ ?= child_command(child, ["cut-off-exit", "4"]).captured_as("StdoutNotUtf8(Exited(4))")
    child_command(child, ["invalid-stderr", "0"]).captured_as("StderrNotUtf8(Exited(0))")


-- 256 KiB, four times a pipe buffer, so the child blocks writing unless the
-- call reads while it writes.
private pure func large_text() -> String:
    var text = "abcdefg\n"
    for _ in 0..15:
        text = text + text
    text


private func stdin_case(child: Path) -> Result[Void, String]:
    text = large_text()
    echoed = capture({ child_command(child, ["echo-stdin"]) | stdin = Some(text) })
    _ ?= match echoed:
        Ok(captured):
            if captured.stdout == text:
                expect_text(captured.exit.exit_text(), "Exited(0)")
            else:
                Err("stdin was not echoed whole: ${captured.stdout.length()} bytes")
        Err(error):
            Err(error.capture_error_text())
    _ ?= child_command(child, ["stdin"]).captured_as("Exited(0) [] []")
    { child_command(child, ["stdin"]) | stdin = Some("") }.captured_as("Exited(0) [] []")


private func unread_stdin_case(child: Path) -> Result[Void, String]:
    text = large_text() + large_text() + large_text() + large_text()
    _ ?= { child_command(child, ["close-stdin"]) | stdin = Some(text) }.captured_as(
        "Exited(0) [] []",
    )
    { child_command(child, ["exit", "0"]) | stdin = Some(text) }.captured_as("Exited(0) [] []")


-- The variables of an `env` listing whose entries start with `prefix`.
private pure func entries_named(listing: String, prefix: String) -> String:
    listing
        .lines()
        .filter(pure func(line: String) -> Bool: line.starts_with(prefix))
        .join(",")


-- /usr/bin/env lists the environment it received. The fixture child cannot be
-- used here: AddressSanitizer warns on stderr when PATH is unset.
private func environment_case() -> Result[Void, String]:
    changed = without_diagnostics()
        .set("BLORP_PROCESS_SET", Some("one=two"))
        .set("PATH", None)
        .set("HOME", Some("/replaced"))
    env ?= path_of(ENVIRONMENT_TOOL)
    listed: Captured ?= capture({ command(env, []) | environment = changed }).map_err(
        capture_error_text,
    )
    _ ?= expect_text(
        [
            listed.exit.exit_text(),
            listed.stdout.entries_named("BLORP_PROCESS_SET="),
            listed.stdout.entries_named("PATH="),
            listed.stdout.entries_named("HOME="),
            listed.stdout.entries_named("BLORP_LEAK_CHECK="),
        ].join(" | "),
        "Exited(0) | BLORP_PROCESS_SET=one=two |  | HOME=/replaced | ",
    )
    inherited: Captured ?= capture(command(env, [])).map_err(capture_error_text)
    if (
        inherited.stdout
            .entries_named("PATH=/")
            .length()
        > 0
    ):
        Ok(void)
    else:
        Err("PATH was not inherited")


-- The program does not exist, so an error other than the expected one, such
-- as LaunchFailed, would show that a system call came first. A Path holds no
-- NUL, so only an argument or the environment can.
private func rejection_case(directory: String) -> Result[Void, String]:
    missing ?= path_of(directory + "/no-such-program")
    _ ?= { command(missing, []) | environment = { "" => Some("x") } }.captured_as(
        "InvalidVariableName()",
    )
    _ ?= { command(missing, []) | environment = { "A=B" => None } }.captured_as(
        "InvalidVariableName(A=B)",
    )
    _ ?= command(missing, ["a\0b"]).captured_as("ContainsNul")
    _ ?= { command(missing, []) | environment = { "NAME" => Some("a\0b") } }.captured_as(
        "ContainsNul",
    )
    { command(missing, []) | environment = { "NA\0ME" => None } }.captured_as("ContainsNul")


private func directory_case(child: Path, directory: String) -> Result[Void, String]:
    place = directory + "/capture-place"
    _ ?= make_directories(place)
    _ ?= write_file(place + "/marker.txt", "marked\n")
    place_path ?= path_of(place)
    _ ?= { child_command(child, ["cat-file", "marker.txt"]) | directory = Some(place_path) }.captured_as(
        "Exited(0) [marked\n] []",
    )
    missing ?= path_of(directory + "/capture-missing")
    _ ?= { child_command(child, []) | directory = Some(missing) }.captured_as(
        "DirectoryFailed(NotFound)",
    )
    inside_file ?= path_of(place + "/marker.txt")
    { child_command(child, []) | directory = Some(inside_file) }.captured_as(
        "DirectoryFailed(NotADirectory)",
    )


private func launch_case(child: Path, directory: String) -> Result[Void, String]:
    missing ?= path_of(directory + "/capture-missing-program")
    _ ?= command(missing, []).captured_as("LaunchFailed(NotFound)")
    plain = directory + "/capture-plain-file"
    _ ?= write_file(plain, "not a program\n")
    plain_file ?= path_of(plain)
    _ ?= command(plain_file, []).captured_as("LaunchFailed(PermissionDenied)")
    script = directory + "/capture-invalid-executable"
    _ ?= child_command(child, ["invalid-executable", script]).captured_as("Exited(0) [] []")
    script_file ?= path_of(script)
    command(script_file, []).captured_as("NotExecutable")


private func zero_timeout_case(directory: String) -> Result[Void, String]:
    missing ?= path_of(directory + "/never-started")
    _ ?= { command(missing, []) | timeout_ms = Some(0) }.captured_as("TimedOut [] []")
    { command(missing, []) | timeout_ms = Some(-5) }.captured_as("TimedOut [] []")


private pure func expect_output_error(
    result: Result[String, OutputError],
    expected: String,
) -> Result[Void, String]:
    match result:
        Ok(text): Err("expected an OutputError, got Ok: " + text)
        Err(error): expect_text(error.output_error_text(), expected)


private func output_case(child: Path, directory: String) -> Result[Void, String]:
    _ ?= match output(child_command(child, ["streams"])):
        Ok(text): expect_text(text, "stdout text\n")
        Err(error): Err(error.output_error_text())
    missing ?= path_of(directory + "/output-missing-program")
    _ ?= output(command(missing, [])).expect_output_error("CaptureFailed(LaunchFailed(NotFound))")
    output(child_command(child, ["fail-streams"])).expect_output_error(
        "Unsuccessful(Exited(7) [out\n] [err\n])",
    )


-- SIGABRT is 6 on macOS and Linux.
private func defect_case(child: Path) -> Result[Void, String]:
    _ ?= child_command(child, ["bad-error-code"]).captured_as(
        "Signaled(6) [] [blorp: process runtime defect: an error code outside the tags the library decodes\n]",
    )
    _ ?= child_command(child, ["bad-exit"]).captured_as(
        "Signaled(6) [] [blorp: process runtime defect: an Exit outside the codes the library decodes\n]",
    )
    child_command(child, ["fault"]).captured_as(
        "Signaled(6) [] [blorp: process runtime defect: forced by the probe\n]",
    )


private pure func found_text(result: Result[Path, FindProgramError]) -> String:
    match result:
        Ok(found): "Ok(${found})"
        Err(error): error.found_error_text()


private pure func found_error_text(error: FindProgramError) -> String:
    match error:
        NotOnPath: "NotOnPath"
        NameContainsNul: "NameContainsNul"


private func find_program_case() -> Result[Void, String]:
    _ ?= find_program("blorp-process-suite-missing")
        .found_text()
        .expect_text("NotOnPath")
    _ ?= find_program("../bin/sh")
        .found_text()
        .expect_text("NotOnPath")
    _ ?= find_program("")
        .found_text()
        .expect_text("NotOnPath")
    _ ?= find_program("s\0h")
        .found_text()
        .expect_text("NameContainsNul")
    found ?= find_program("sh").map_err(pure func(error: FindProgramError) -> String: "${error}")
    _: Void ?= if (
        "${found}"
            .starts_with("/")
            .and("${found}".ends_with_sh())
    ):
        Ok(void)
    else:
        Err("find_program(sh) gave ${found}")
    -- A found program goes straight to command.
    command(found, ["-c", "printf found"]).captured_as("Exited(0) [found] []")


private pure func ends_with_sh(path: String) -> Bool:
    match path.slice(path.length() - 3, path.length()):
        Some(tail): tail == "/sh"
        None: False


private pure func cases_hold(cases: List[(String, String)]) -> Bool:
    cases.all(pure func(case: (String, String)) -> Bool:
        match case:
            (actual, expected): actual == expected
    )


-- Literal codes bind the decoders to the native protocol independently: the
-- file protocol's NotFound is 1, PermissionDenied 2 and NotADirectory 4, and a
-- process error is its detail times 16 plus its tag.
private pure func test_system_call_decoder_names_three_codes_and_keeps_the_rest() -> Bool:
    cases_hold([
        (decode_system_call_error(1).cause_text(), "NotFound"),
        (decode_system_call_error(2).cause_text(), "PermissionDenied"),
        (decode_system_call_error(4).cause_text(), "NotADirectory"),
        -- A negative code is an unnamed errno, negated by the native.
        (decode_system_call_error(-62).cause_text(), "OtherOs(62)"),
        -- A positive code no constant names is a disagreement, kept visible.
        (decode_system_call_error(5).cause_text(), "OtherOs(-5)"),
        (decode_system_call_error(0).cause_text(), "OtherOs(0)"),
    ])


private pure func decoded_text(code: Int) -> String:
    match decode_capture_error(code):
        Some(error): error.capture_error_text()
        None: "None"


private pure func test_capture_decoder_maps_every_tag() -> Bool:
    cases_hold([
        (decoded_text(1 + 16 * 1), "LaunchFailed(NotFound)"),
        (decoded_text(1 + 16 * (0 - 62)), "LaunchFailed(OtherOs(62))"),
        (decoded_text(2), "NotExecutable"),
        (decoded_text(3 + 16 * 2), "DirectoryFailed(PermissionDenied)"),
        (decoded_text(3 + 16 * 4), "DirectoryFailed(NotADirectory)"),
        (decoded_text(4), "ContainsNul"),
        (decoded_text(5 + 16 * 4), "StdoutNotUtf8(Exited(4))"),
        (decoded_text(6 + 16 * 265), "StderrNotUtf8(Signaled(9))"),
        (decoded_text(5 + 16 * 512), "StdoutNotUtf8(TimedOut)"),
    ])


private pure func test_capture_decoder_refuses_what_the_native_never_sends() -> Bool:
    cases_hold([
        (decoded_text(0), "None"),
        -- A tag that find_program alone sends.
        (decoded_text(7), "None"),
        (decoded_text(8), "None"),
        (decoded_text(15), "None"),
        -- NotExecutable and ContainsNul carry no detail.
        (decoded_text(2 + 16 * 1), "None"),
        (decoded_text(4 + 16 * 1), "None"),
        -- An Exit code outside the three kinds.
        (decoded_text(5 + 16 * 768), "None"),
        (decoded_text(5 + 16 * (0 - 1)), "None"),
    ])


private pure func decoded_find_program_text(code: Int) -> String:
    match decode_find_program_error(code):
        Some(error): error.found_error_text()
        None: "None"


private pure func test_find_program_decoder_maps_two_tags() -> Bool:
    cases_hold([
        (decoded_find_program_text(7), "NotOnPath"),
        (decoded_find_program_text(4), "NameContainsNul"),
        (decoded_find_program_text(0), "None"),
        (decoded_find_program_text(1), "None"),
        (decoded_find_program_text(23), "None"),
    ])


private pure func test_to_string_words_every_cause() -> Bool:
    cases: List[(SystemCallError, String)] = [
        (NotFound, "no such file"),
        (PermissionDenied, "permission denied"),
        (NotADirectory, "not a directory"),
        (OtherOs(62), "operating system error 62"),
    ]
    cases.all(pure func(case: (SystemCallError, String)) -> Bool:
        match case:
            (error, expected): error.to_string() == expected
    )


private pure func test_to_string_words_every_find_program_error() -> Bool:
    cases: List[(FindProgramError, String)] = [
        (NotOnPath, "not found on PATH"),
        (NameContainsNul, "the program name contains a NUL byte"),
    ]
    cases.all(pure func(case: (FindProgramError, String)) -> Bool:
        match case:
            (error, expected): error.to_string() == expected
    )


private pure func test_to_string_words_every_capture_error() -> Bool:
    cases: List[(CaptureError, String)] = [
        (
            InvalidVariableName("A=B"),
            "invalid environment variable name \"A=B\"; a name is nonempty and has no =",
        ),
        (ContainsNul, "an argument or the environment contains a NUL byte"),
        (LaunchFailed(PermissionDenied), "permission denied"),
        (LaunchFailed(OtherOs(7)), "operating system error 7"),
        (NotExecutable, "not a program the system can run; a script needs a #! line"),
        (DirectoryFailed(NotFound), "cannot enter the directory: no such file"),
        (StdoutNotUtf8(Exited(0)), "exited 0, and its stdout is not UTF-8"),
        (StderrNotUtf8(TimedOut), "timed out, and its stderr is not UTF-8"),
        (StdoutNotUtf8(Signaled(9)), "killed by signal 9, and its stdout is not UTF-8"),
    ]
    cases.all(pure func(case: (CaptureError, String)) -> Bool:
        match case:
            (error, expected): error.to_string() == expected
    )


private pure func test_to_string_words_every_output_error() -> Bool:
    quiet_failure: Captured = { exit = Signaled(9), stdout = "", stderr = "" }
    loud_failure: Captured = { exit = Exited(2), stdout = "partial", stderr = "no rule\n" }
    cases: List[(OutputError, String)] = [
        (CaptureFailed(LaunchFailed(NotFound)), "no such file"),
        (
            CaptureFailed(DirectoryFailed(NotADirectory)),
            "cannot enter the directory: not a directory",
        ),
        (Unsuccessful(quiet_failure), "killed by signal 9"),
        (Unsuccessful(loud_failure), "exited 2\nno rule\n"),
    ]
    cases.all(pure func(case: (OutputError, String)) -> Bool:
        match case:
            (error, expected): ("${error}" == expected).and(error.to_string() == expected)
    )


private pure func test_succeeded_is_exited_zero() -> Bool:
    cases: List[(Exit, Bool)] = [
        (Exited(0), True),
        (Exited(1), False),
        (Signaled(9), False),
        (TimedOut, False),
    ]
    cases.all(pure func(case: (Exit, Bool)) -> Bool:
        match case:
            (exit, expected): exit.succeeded() == expected
    )


private func capture_tests(child: Path, directory: String) -> List[(String, () -> Bool)]:
    [
        (
            "capture: Exited carries 0, 23 and 127, with stdout and stderr kept apart and arguments literal",
            func(): reported(exits_case(child)),
        ),
        (
            "capture: Signaled carries the signal and drops a cut-off character",
            func(): reported(signaled_case(child)),
        ),
        (
            "capture: TimedOut kills the child, keeps its output and drops a cut-off character",
            func(): reported(timed_out_case(child, directory)),
        ),
        (
            "capture: a grandchild holding the pipes open neither hangs the call nor outlives it",
            func(): reported(grandchild_case(child, directory)),
        ),
        (
            "capture: output that is not UTF-8 after Exited is an error carrying the Exit",
            func(): reported(utf8_case(child)),
        ),
        (
            "capture: stdin is written while output is read, then closed; None and empty are end of file",
            func(): reported(stdin_case(child)),
        ),
        (
            "capture: a child that exits without reading its stdin is not an error",
            func(): reported(unread_stdin_case(child)),
        ),
        (
            "capture: the environment sets, removes and inherits variables",
            func(): reported(environment_case()),
        ),
        (
            "capture: an invalid variable name and NUL are rejected before any system call",
            func(): reported(rejection_case(directory)),
        ),
        (
            "capture: directory runs the child there, and DirectoryFailed names it",
            func(): reported(directory_case(child, directory)),
        ),
        (
            "capture: a missing or unexecutable program is LaunchFailed, a file without #! NotExecutable",
            func(): reported(launch_case(child, directory)),
        ),
        (
            "capture: a timeout of zero or less times out at once without starting the program",
            func(): reported(zero_timeout_case(directory)),
        ),
        (
            "output: stdout after Exited(0), and Unsuccessful carrying the capture otherwise",
            func(): reported(output_case(child, directory)),
        ),
        (
            "find_program: finds sh, which runs as found; a missing name, a name with a / or an empty one is NotOnPath, NUL ContainsNul",
            func(): reported(find_program_case()),
        ),
        (
            "a code the library cannot decode, and process.fault, abort with the defect named",
            func(): reported(defect_case(child)),
        ),
        (
            "the system call decoder keeps unnamed codes",
            test_system_call_decoder_names_three_codes_and_keeps_the_rest,
        ),
        ("the capture decoder maps every tag", test_capture_decoder_maps_every_tag),
        (
            "the capture decoder refuses what the native never sends",
            test_capture_decoder_refuses_what_the_native_never_sends,
        ),
        ("the find_program decoder maps two tags", test_find_program_decoder_maps_two_tags),
        ("to_string words every cause", test_to_string_words_every_cause),
        ("to_string words every find_program error", test_to_string_words_every_find_program_error),
        ("to_string words every capture error", test_to_string_words_every_capture_error),
        ("to_string words every output error", test_to_string_words_every_output_error),
        ("succeeded is Exited(0) alone", test_succeeded_is_exited_zero),
        (
            "capture leaves SIGCHLD and the signal mask as they were and consumes only its own SIGPIPE",
            func(): reported(native_probe(child, directory, "capture-signals")),
        ),
        (
            "capture with SIGCHLD ignored is LaunchFailed(OtherOs(ECHILD)) before forking",
            func(): reported(native_probe(child, directory, "capture-sigchld")),
        ),
        (
            "capture reports a failed fork as the named kind SystemCallError has, and any other errno as its own number",
            func(): reported(native_probe(child, directory, "capture-fork-failure")),
        ),
        (
            "capture reaps its child after a timeout, an exit and a signal, and a zero timeout never forks",
            func(): reported(native_probe(child, directory, "capture-reap")),
        ),
        (
            "capture times out a child stalled before exec, and reaps it",
            func(): reported(native_probe(child, directory, "capture-startup")),
        ),
        (
            "capture moves its descriptors above closed stdin, stdout and stderr",
            func(): reported(native_probe(child, directory, "capture-closed-stdio")),
        ),
        (
            "capture: a lost group race still leaves the child leading its group",
            func(): reported(native_probe(child, directory, "capture-group-race")),
        ),
        (
            "capture returns once its child has exited although a stray process holds the exec report open",
            func(): reported(native_probe(child, directory, "capture-stray-report")),
        ),
        (
            "find_program skips empty and relative PATH entries, files it cannot execute and directories",
            func(): reported(native_probe(child, directory, "find-program")),
        ),
    ]


func suite(c_compiler: String, directory: String) -> TestSuite:
    match child_ready(c_compiler, directory):
        Err(error):
            print_error(error)
            {
                description = "Process runtime setup",
                tests = [("native probe build", func(): False)],
            }
        Ok(child):
            { description = "Process runtime", tests = capture_tests(child, directory) }
