func test_closure_129_captures_release() -> Bool:
	reset_mem_stats()
	value: Int = call_reader_129(3)
	stats: MemStats = get_mem_stats()
	value == 535 and stats.current_objects == 0


tests: TestSuite = {
	description = "Closure environments wider than one release-mask word",
	tests = [
		("closure with 64 captures releases every managed capture", test_closure_64_captures_release),
		("closure with 65 captures releases every managed capture", test_closure_65_captures_release),
		("closure with 129 captures releases every managed capture", test_closure_129_captures_release),
	]
}
