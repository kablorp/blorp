func call_reader_64(seed: Int) -> Int:
	reader: pure () -> Int = make_reader_64(seed)
	reader()


func test_closure_64_captures_release() -> Bool:
	reset_mem_stats()
	value: Int = call_reader_64(3)
	stats: MemStats = get_mem_stats()
	value == 246 and stats.current_objects == 0


