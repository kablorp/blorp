import:
	string: string
	test: TestSuite


private pure func dynamic_text(label: String) -> String:
	var result: String = string(label.length() + 16)
	result += label
	result += "-sroa"
	result


private pure func direct_tuple_is_valid() -> Bool:
	pair: (String, Int) = (dynamic_text("direct"), 11)
	pair[0] == "direct-sroa" and pair[1] == 11


private pure func conditional_tuple_is_valid(select_left: Bool) -> Bool:
	pair: (String, Int) = if select_left:
		(dynamic_text("left"), 22)
	else:
		(dynamic_text("right"), 0)

	pair[0] == "left-sroa" and pair[1] == 22


func test_managed_local_tuple_sroa() -> Bool:
	direct_tuple_is_valid() and conditional_tuple_is_valid(True)


tests: TestSuite = {
	description = "Managed Local Tuple SROA",
	tests = [("managed local tuple sroa", test_managed_local_tuple_sroa)]
}
