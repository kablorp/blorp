import:
	test: TestSuite


-- Dict literal values box struct values with a fresh heap box that the dict
-- retains on insert; the literal must hand its own reference over instead of
-- leaking one box per entry.

fixed record Point {
	x: Int,
	y: Int
}


fixed record Segment {
	start: Point,
	finish: Point
}


record Tag {
	label: String,
	rank: Int
}


implements Equatable for Point:
	pure func equals(a: Point, b: Point) -> Bool:
		a.x == b.x and a.y == b.y


implements Hashable for Point:
	pure func hash(self: Point) -> Int:
		hash_combine(self.x.hash(), self.y.hash())


implements Equatable for Tag:
	pure func equals(a: Tag, b: Tag) -> Bool:
		a.label == b.label and a.rank == b.rank


implements Hashable for Tag:
	pure func hash(self: Tag) -> Int:
		hash_combine(self.label.hash(), self.rank.hash())


func test_dict_literal_struct_values_release_boxes() -> Bool:
	points: Dict[Int, Point] = {1 => { x = 1, y = 2 }, 2 => { x = 3, y = 4 }}
	first: Point = points.get(1).get_or({ x = 0, y = 0 })
	second: Point = points.get(2).get_or({ x = 0, y = 0 })
	points.length() == 2 and first.x == 1 and first.y == 2 and second.x == 3 and second.y == 4


func test_dict_literal_struct_variable_value_releases_box() -> Bool:
	origin: Point = { x = 5, y = 6 }
	points: Dict[Int, Point] = {1 => origin}
	stored: Point = points.get(1).get_or({ x = 0, y = 0 })
	stored.x == 5 and stored.y == 6 and origin.x == 5


func test_dict_literal_nested_struct_value_releases_box() -> Bool:
	segment: Segment = { start = { x = 1, y = 2 }, finish = { x = 3, y = 4 } }
	segments: Dict[Int, Segment] = {1 => segment}
	stored: Segment = segments.get(1).get_or({ start = { x = 0, y = 0 }, finish = { x = 0, y = 0 } })
	stored.start.x == 1 and stored.finish.y == 4


func test_dict_literal_managed_key_struct_value_releases_both() -> Bool:
	suffix: String = "a".repeat(3)
	points: Dict[String, Point] = {"left-" + suffix => { x = 1, y = 2 }, "right-" + suffix => { x = 3, y = 4 }}
	stored: Point = points.get("right-aaa").get_or({ x = 0, y = 0 })
	points.length() == 2 and stored.x == 3


-- Reads stop at keys: reading a stack-Option value back out of a Dict, by
-- `get` or `values()`, does not emit valid C yet.
func test_dict_literal_stack_option_values_release_boxes() -> Bool:
	missing: Option[Int] = None
	options: Dict[Int, Option[Int]] = {1 => Some(5), 2 => missing}
	options.length() == 2 and options.contains(1) and options.contains(2)


func test_dict_literal_struct_values_in_loop_release_boxes() -> Bool:
	var total: Int = 0

	for index in 0..4:
		points: Dict[Int, Point] = {index => { x = index, y = index }}
		total += points.get(index).get_or({ x = 0, y = 0 }).y

	total == 6


-- Trait-hashed keys are boxed into a key slot the dict releases, so the
-- literal hands those boxes over too. Lookups are left out: the synthesized
-- lookup's own boxed key temp is a separate leak.
func test_dict_literal_struct_keys_release_boxes() -> Bool:
	points: Dict[Point, Int] = {{ x = 1, y = 2 } => 1, { x = 3, y = 4 } => 2, { x = 1, y = 2 } => 3}
	points.length() == 2


func test_dict_literal_record_keys_release_fields() -> Bool:
	suffix: String = "b".repeat(3)
	first: Tag = { label = "x-" + suffix, rank = 1 }
	second: Tag = { label = "y-" + suffix, rank = 2 }
	tags: Dict[Tag, Int] = {first => 1, second => 2}
	tags.length() == 2


func test_dict_literal_stack_option_keys_release_boxes() -> Bool:
	present: Option[Int] = Some(1)
	missing: Option[Int] = None
	options: Dict[Option[Int], Int] = {present => 1, missing => 2, present => 3}
	options.length() == 2


func test_dict_literal_stack_result_keys_release_boxes() -> Bool:
	passed: Result[Int, Int] = Ok(1)
	failed: Result[Int, Int] = Err(2)
	results: Dict[Result[Int, Int], Int] = {passed => 1, failed => 2}
	results.length() == 2


func test_list_literal_struct_values_release_storage() -> Bool:
	points: List[Point] = [{ x = 1, y = 2 }, { x = 3, y = 4 }]
	points.length() == 2 and points.get(1).get_or({ x = 0, y = 0 }).x == 3


tests: TestSuite = {
	description = "Dict Literal Struct Box Ownership",
	tests = [
		("dict literal struct values release boxes", test_dict_literal_struct_values_release_boxes),
		(
			"dict literal struct variable value releases box",
			test_dict_literal_struct_variable_value_releases_box,
		),
		(
			"dict literal nested struct value releases box",
			test_dict_literal_nested_struct_value_releases_box,
		),
		(
			"dict literal managed key struct value releases both",
			test_dict_literal_managed_key_struct_value_releases_both,
		),
		(
			"dict literal stack option values release boxes",
			test_dict_literal_stack_option_values_release_boxes,
		),
		(
			"dict literal struct values in loop release boxes",
			test_dict_literal_struct_values_in_loop_release_boxes,
		),
		("dict literal struct keys release boxes", test_dict_literal_struct_keys_release_boxes),
		(
			"dict literal record keys release fields",
			test_dict_literal_record_keys_release_fields,
		),
		("dict literal stack option keys release boxes", test_dict_literal_stack_option_keys_release_boxes),
		("dict literal stack result keys release boxes", test_dict_literal_stack_result_keys_release_boxes),
		("list literal struct values release storage", test_list_literal_struct_values_release_storage),
	]
}
