enum Action:
	KnownAction


union ParseActionError:
	UnknownAction(String)


private pure func parse_action(name: String) -> Result[Action, ParseActionError]:
	match name:
		"known":
			Ok(KnownAction)
		_:
			Err(UnknownAction(name))


func main(args: List[String]) -> Int:
	match parse_action("known"):
		Ok(KnownAction):
			0
		Err(_):
			1
