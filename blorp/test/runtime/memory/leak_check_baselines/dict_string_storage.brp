import:
	dict as D


func main(args: List[String]) -> Int:
	var d: Dict[String, String] = D.dict()
	d = D.set(d, "alpha", "one")
	d = D.set(d, "alpha", "uno")
	d = D.set(d, "beta", "two")
	if (
		D.get_or(d, "alpha", "") == "uno"
		and D.get_or(d, "beta", "") == "two"
		and d.length() == 2
	):
		0
	else:
		1
