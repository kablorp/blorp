import:
	option: Option(Some, None)


record Token {
	kind: String
}


record ParserState {
	tokens: List[Token],
	index: Int
}


record InfixInfo {
	precedence: Int
}


private pure func current_token(state: ParserState) -> Token:
	match state.tokens.get(state.index):
		Some(token):
			token
		None:
			{kind = "eof"}


private pure func current_kind(state: ParserState) -> Option[InfixInfo]:
	match current_token(state).kind:
		"identifier":
			Some({precedence = 1})
		_:
			None


func main(args: List[String]) -> Int:
	state: ParserState = {
		tokens = [{kind = "identifier"}],
		index = 0
	}

	match current_kind(state):
		Some(info):
			info.precedence - 1
		None:
			1
