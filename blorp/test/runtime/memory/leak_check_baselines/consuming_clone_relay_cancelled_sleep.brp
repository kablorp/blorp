-- A consuming clone hands its record on to a second consuming call, which
-- parks and is cancelled. Each callee owns the record from its own entry, so
-- the first gives up its slot at the hand-off and the second pushes one; the
-- record is released once.
import:
	test: cancel_after_parked_for_test


record Table {
	items: List[Int],
	count: Int
}


func park_then_grow(t: Table, x: Int) -> Table:
	n: Int = t.count
	sleep(10000)
	{ t |
		items = t.items.append(x),
		count = n + 1
	}


func relay(t: Table, x: Int) -> Table:
	marked: Table = { t | count = t.count + 1 }
	marked.park_then_grow(x)


func hold(seed: Int) -> Int:
	var table: Table = {
		items = [seed],
		count = 1
	}
	var spin: Int = 0

	for i in 0..2:
		spin += i

	table = table.relay(spin)
	table.items.length()


func main(args: List[String]) -> Int:
	if cancel_after_parked_for_test(func(): hold(1)):
		0
	else:
		1
