import:
	string: string


pure func build_unique(parts: List[String]) -> String:
	var result: String = ""

	for part in parts:
		result += part

	result


func main(args: List[String]) -> Int:
	unique: String = build_unique(["a", "b", "c"])

	var shared: String = string(8)
	shared += "left"
	saved: String = shared
	shared += " right"

	var self_appended: String = "xy"
	self_appended += self_appended

	if (
		unique == "abc"
		and saved == "left"
		and shared == "left right"
		and self_appended == "xyxy"
	):
		0
	else:
		1
