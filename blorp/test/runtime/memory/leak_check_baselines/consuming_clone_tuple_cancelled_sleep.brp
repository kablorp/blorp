-- A callee that returns its updated record in a tuple builds the tuple and
-- then parks, and the task is cancelled there. The record moves from the
-- callee's parameter into the tuple before the park, so it is released once,
-- through the tuple. `main` shares the record, so a second release would
-- free it under `main`.
import:
	memory: refcount
	test: cancel_after_parked_for_test


record Table {
	items: List[Int],
	count: Int
}


func intern(t: Table, x: Int) -> (Table, Int):
	n: Int = t.count
	var spin: Int = 0

	for i in 0..2:
		spin += i

	result: (Table, Int) = ({ t |
			items = t.items.append(x),
			count = n + 1
		}, n)
	sleep(10000)
	result


func hold(shared: Table) -> Int:
	var table: Table = shared
	var spin: Int = 0

	for i in 0..2:
		spin += i

	(next, id) = table.intern(spin)
	table = next
	table.items.length() + id


---
After the cancelled task is gone, `main` holds the only reference to
`table`. A reference released twice by cancellation cleanup leaves the count
below one, freeing the table while `main` still uses it.
---
func table_survives(table: Table, expected_count: Int, expected_length: Int) -> Bool:
	(
		refcount(table) == 1
		and table.count == expected_count
		and table.items.length() == expected_length
	)


func main(args: List[String]) -> Int:
	table: Table = {
		items = [7],
		count = 1
	}

	if cancel_after_parked_for_test(func(): hold(table)) and table_survives(table, 1, 1):
		0
	else:
		1
