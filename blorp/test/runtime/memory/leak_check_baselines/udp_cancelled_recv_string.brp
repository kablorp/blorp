import:
	net/udp: UdpError, bind, message, recv_from, socket
	string: contains
	test: cancel_after_parked_for_test


pure func is_socket_permission_error(err: UdpError) -> Bool:
	detail: String = message(err)
	detail.contains("Operation not permitted") or detail.contains("Permission denied")


func payload(label: String) -> String:
	label + "-payload"


func socket_probe() -> Result[Bool, UdpError]:
	with sock ?= socket():
		ignored ?= bind(sock, "127.0.0.1", 0)
		Ok(True)


func blocked_recv_result() -> Result[Int, UdpError]:
	marker: String = payload("blocked-recv")
	with sock ?= socket():
		ignored ?= bind(sock, "127.0.0.1", 0)
		datagram ?= recv_from(sock, 64)
		if marker == "blocked-recv-payload":
			Ok(datagram.data.length())
		else:
			Ok(-2)


func blocked_recv() -> Int:
	match blocked_recv_result():
		Ok(value): value
		Err(_): -1


func run_cancelled_recv_case() -> Bool:
	match socket_probe():
		Ok(_): cancel_after_parked_for_test(func(): blocked_recv())
		Err(err): is_socket_permission_error(err)


func main(args: List[String]) -> Int:
	if run_cancelled_recv_case():
		0
	else:
		1
