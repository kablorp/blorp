record NamedValues {
	name: String,
	values: List[String]
}


private pure func named_values_equal(left: NamedValues, right: NamedValues) -> Bool:
	left.name == right.name and left.values == right.values


private pure func maybe_named_values(present: Bool) -> Option[NamedValues]:
	if present:
		Some({
			name = "present",
			values = ["value"],
		})
	else:
		None


func main(args: List[String]) -> Int:
	present_ok: Bool = named_values_equal(
		maybe_named_values(True).get_or({
			name = "default",
			values = [],
		}),
		{
			name = "present",
			values = ["value"]
		},
	)
	default_ok: Bool = named_values_equal(
		maybe_named_values(False).get_or({
			name = "default",
			values = ["fallback"],
		}),
		{
			name = "default",
			values = ["fallback"]
		},
	)

	if present_ok and default_ok:
		0
	else:
		1
