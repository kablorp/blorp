-- Not only consuming clones own a parameter: ownership inference makes `wrap`
-- consume `t` because it stores it. The callee parks and is cancelled after
-- the caller handed `t` over, so `t` is released through the callee's slot.
import:
	test: cancel_after_parked_for_test


record Table {
	items: List[Int],
	count: Int
}


record Box {
	inner: Table
}


func wrap(t: Table) -> Box:
	sleep(10000)
	{inner = t}


func hold(seed: Int) -> Int:
	table: Table = {
		items = [seed],
		count = 1
	}
	b: Box = wrap(table)
	b.inner.count


func main(args: List[String]) -> Int:
	if cancel_after_parked_for_test(func(): hold(1)):
		0
	else:
		1
