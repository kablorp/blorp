import:
	test: TestSuite


-- A match payload is borrowed from the Option that is still alive after the
-- match. Each test builds a record from the payload as the operand of an
-- operator, field read or cast, then checks that the record's release did not
-- free the payload the Option still owns.


record TextHolder {
	text: String
}


pure func holder_length(holder: TextHolder) -> Int:
	holder.text.length()


pure func holder_nonempty(holder: TextHolder) -> Bool:
	holder.text.length() > 0


pure func pass_through(holder: TextHolder) -> TextHolder:
	holder


pure func pair_with_count(holder: TextHolder) -> (TextHolder, Int):
	(holder, 1)


pure func length_plus_one(owner: Option[String]) -> Int:
	match owner:
		Some(text):
			holder_length({ text = text }) + 1
		None:
			0


pure func nonempty_and(owner: Option[String], other: Bool) -> Bool:
	match owner:
		Some(text):
			other and holder_nonempty({ text = text })
		None:
			False


pure func negated_length(owner: Option[String]) -> Int:
	match owner:
		Some(text):
			-holder_length({ text = text })
		None:
			0


pure func is_empty(owner: Option[String]) -> Bool:
	match owner:
		Some(text):
			not holder_nonempty({ text = text })
		None:
			True


pure func length_as_float(owner: Option[String]) -> Float:
	match owner:
		Some(text):
			holder_length({ text = text }).to_float()
		None:
			0.0


pure func text_length_of_passed_record(owner: Option[String]) -> Int:
	match owner:
		Some(text):
			pass_through({ text = text }).text.length()
		None:
			0


pure func count_of_pair(owner: Option[String]) -> Int:
	match owner:
		Some(text):
			pair_with_count({ text = text })[1]
		None:
			0


pure func owner_keeps_payload(owner: Option[String], payload: String) -> Bool:
	match owner:
		Some(text):
			text == payload
		None:
			False


-- Concatenation creates a managed value rather than a pooled literal.
pure func managed_payload(iteration: Int) -> String:
	"managed payload " + iteration.to_string()


pure func test_binary_operand_keeps_payload() -> Bool:
	var valid = True
	for iteration in 0..64:
		payload = managed_payload(iteration)
		owner = Some(payload)
		valid = valid and length_plus_one(owner) == payload.length() + 1
		valid = valid and owner_keeps_payload(owner, payload)
	valid


pure func test_logical_operand_keeps_payload() -> Bool:
	var valid = True
	for iteration in 0..64:
		payload = managed_payload(iteration)
		owner = Some(payload)
		valid = valid and nonempty_and(owner, True)
		-- The record is never built when the left operand is False.
		valid = valid and not nonempty_and(owner, False)
		valid = valid and owner_keeps_payload(owner, payload)
	valid


pure func test_unary_operand_keeps_payload() -> Bool:
	var valid = True
	for iteration in 0..64:
		payload = managed_payload(iteration)
		owner = Some(payload)
		valid = valid and negated_length(owner) == -payload.length()
		valid = valid and not is_empty(owner)
		valid = valid and owner_keeps_payload(owner, payload)
	valid


pure func test_cast_operand_keeps_payload() -> Bool:
	var valid = True
	for iteration in 0..64:
		payload = managed_payload(iteration)
		owner = Some(payload)
		valid = valid and length_as_float(owner) == payload.length().to_float()
		valid = valid and owner_keeps_payload(owner, payload)
	valid


pure func test_record_field_read_keeps_payload() -> Bool:
	var valid = True
	for iteration in 0..64:
		payload = managed_payload(iteration)
		owner = Some(payload)
		valid = valid and text_length_of_passed_record(owner) == payload.length()
		valid = valid and owner_keeps_payload(owner, payload)
	valid


pure func test_tuple_field_read_keeps_payload() -> Bool:
	var valid = True
	for iteration in 0..64:
		payload = managed_payload(iteration)
		owner = Some(payload)
		valid = valid and count_of_pair(owner) == 1
		valid = valid and owner_keeps_payload(owner, payload)
	valid


tests: TestSuite = {
	description = "Borrowed match payload ownership through expression operands",
	tests = [
		("binary operand keeps payload", test_binary_operand_keeps_payload),
		("logical operand keeps payload", test_logical_operand_keeps_payload),
		("unary operand keeps payload", test_unary_operand_keeps_payload),
		("cast operand keeps payload", test_cast_operand_keeps_payload),
		("record field read keeps payload", test_record_field_read_keeps_payload),
		("tuple field read keeps payload", test_tuple_field_read_keeps_payload)
	]
}
