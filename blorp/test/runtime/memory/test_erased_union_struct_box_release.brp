import:
	memory: MemStats, get_mem_stats, reset_mem_stats
	test: TestSuite


struct ErasedPayloadPoint {
	value: Int
}


union ErasedPayload:
	Point(ErasedPayloadPoint)
	Text(String)


pure func payload_value(payload: ErasedPayload) -> Int:
	match payload:
		Point(point):
			point.value
		Text(text):
			text.length()


func test_erased_struct_payload_boxes_are_released() -> Bool:
	reset_mem_stats()
	var total: Int = 0
	var value: Int = 0

	while value < 1000:
		total += payload_value(
			Point({ value = value }),
		)
		value += 1

	stats: MemStats = get_mem_stats()
	total == 499500 and stats.current_objects == 0


tests: TestSuite = {
	description = "Erased union struct-box ownership",
	tests = [
		(
			"erased struct payload boxes are released",
			test_erased_struct_payload_boxes_are_released,
		),
	]
}
