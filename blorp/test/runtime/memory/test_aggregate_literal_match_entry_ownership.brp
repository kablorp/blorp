import:
	test: TestSuite


-- A list literal entry whose value is an owned match result, such as a fused
-- `get_or` on a managed Option payload, must hand that reference to the list.
-- The match arm already dups the payload, so a second retain on append leaks
-- one reference per call. `None` stays clean because the default empty list
-- and literal fallback string are immortal; `Some` exercises the owned path.
--
-- Dict literal keys and values take the same Perceus transfer decision, but a
-- dict entry of this shape needs statement-form C that the backend cannot emit
-- yet. Add the dict cases when that emission lands.
pure func payload_or_empty_in_list(maybe_rows: Option[List[Int]]) -> List[List[Int]]:
	[maybe_rows.get_or([])]


pure func label_or_fallback_in_list(maybe_label: Option[String]) -> List[String]:
	[maybe_label.get_or("fallback")]


pure func owned_label(index: Int) -> String:
	"label-" + index.to_string()


func test_list_literal_some_payload_entry_transfers() -> Bool:
	rows: List[List[Int]] = payload_or_empty_in_list(Some([1, 2, 3]))
	(
		rows.length() == 1
		and rows
			.get(0)
			.get_or([])
			.length() == 3
	)


func test_list_literal_none_payload_entry_uses_default() -> Bool:
	rows: List[List[Int]] = payload_or_empty_in_list(None)
	(
		rows.length() == 1
		and rows
			.get(0)
			.get_or([1])
			.length() == 0
	)


func test_list_literal_some_string_entry_transfers() -> Bool:
	labels: List[String] = label_or_fallback_in_list(Some(owned_label(9)))
	(
		labels.length() == 1
		and labels
			.get(0)
			.get_or("") == "label-9"
	)


func test_list_literal_none_string_entry_uses_fallback() -> Bool:
	labels: List[String] = label_or_fallback_in_list(None)
	(
		labels.length() == 1
		and labels
			.get(0)
			.get_or("") == "fallback"
	)


func test_list_literal_match_entries_in_loop_transfer() -> Bool:
	var total: Int = 0

	for index in 0..8:
		rows: List[List[Int]] = payload_or_empty_in_list(Some([index, index]))
		labels: List[String] = label_or_fallback_in_list(Some(owned_label(index)))
		total += rows
			.get(0)
			.get_or([])
			.length() + labels.length()

	total == 24


tests: TestSuite = {
	description = "Aggregate Literal Match Entry Ownership",
	tests = [
		(
			"list literal some payload entry transfers",
			test_list_literal_some_payload_entry_transfers,
		),
		(
			"list literal none payload entry uses default",
			test_list_literal_none_payload_entry_uses_default,
		),
		("list literal some string entry transfers", test_list_literal_some_string_entry_transfers),
		(
			"list literal none string entry uses fallback",
			test_list_literal_none_string_entry_uses_fallback,
		),
		(
			"list literal match entries in loop transfer",
			test_list_literal_match_entries_in_loop_transfer,
		),
	]
}
