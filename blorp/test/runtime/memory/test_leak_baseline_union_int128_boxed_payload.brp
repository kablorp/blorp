import:
	test: TestSuite


union Wide:
	WideValue(Int128)


func test_union_int128_boxed_payload() -> Bool:
	value: Wide = WideValue(1 as Int128)

	match value:
		WideValue(_):
			True


tests: TestSuite = {
	description = "Union Int128 Boxed Payload",
	tests = [("union int128 boxed payload", test_union_int128_boxed_payload)]
}
