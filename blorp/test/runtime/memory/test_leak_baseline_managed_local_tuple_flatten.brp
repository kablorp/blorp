import:
	string: string
	test: TestSuite


private pure func dynamic_text(label: String) -> String:
	var result: String = string(label.length() + 16)
	result += label
	result += "-flat"
	result


private pure func direct_tuple_is_valid() -> Bool:
	pair: (String, Int) = (dynamic_text("direct"), 11)
	pair[0] == "direct-flat" and pair[1] == 11


private pure func conditional_tuple_is_valid(select_left: Bool) -> Bool:
	pair: (String, Int) = if select_left:
		(dynamic_text("left"), 22)
	else:
		(dynamic_text("right"), 0)

	pair[0] == "left-flat" and pair[1] == 22


-- Managed elements of a match subject, built fresh, bound from both sides,
-- and dropped on the arms that do not use them.
private pure func joined(left: Option[String], right: Option[String]) -> String:
	match (left, right):
		(Some(first), Some(second)):
			first + second
		(Some(only), None) | (None, Some(only)):
			only
		_:
			""


private pure func subject_elements_are_released() -> Bool:
	(
		joined(Some(dynamic_text("a")), Some(dynamic_text("b"))) == "a-flatb-flat"
		and joined(None, Some(dynamic_text("c"))) == "c-flat"
		and joined(Some(dynamic_text("d")), None) == "d-flat"
		and joined(None, None) == ""
	)


-- The whole subject stored on one path and taken apart on the other.
private pure func stored_subject(keep: Bool) -> List[(String, String)]:
	match (keep, dynamic_text("left"), dynamic_text("right")):
		(True, first, second):
			[(first, second)]
		(False, _, _):
			[]


private pure func stored_subject_is_released() -> Bool:
	stored_subject(True).length() == 1 and stored_subject(False).is_empty()


func test_managed_local_tuple_flatten() -> Bool:
	(
		direct_tuple_is_valid()
		and conditional_tuple_is_valid(True)
		and subject_elements_are_released()
		and stored_subject_is_released()
	)


tests: TestSuite = {
	description = "Managed Local Tuple Flattening",
	tests = [("managed local tuple flattening", test_managed_local_tuple_flatten)]
}
