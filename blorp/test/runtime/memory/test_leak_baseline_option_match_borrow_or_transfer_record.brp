import:
	option: Option(Some, None)
	test: TestSuite


record ScanState {
	cursor: Int,
	diagnostics: List[String]
}


private pure func scan_newline(state: ScanState) -> ScanState:
	{ state | cursor = state.cursor + 1 }


private pure func handle_line_start(state: ScanState) -> (ScanState, List[String]):
	(state, [])


private pure func peek(state: ScanState) -> Option[Int]:
	if state.cursor < 32:
		Some(state.cursor)
	else:
		None


private pure func scan_one(state: ScanState) -> (ScanState, List[String]):
	(line_state, line_emissions) = handle_line_start(state)

	match peek(line_state):
		Some(_):
			(scan_newline(line_state), line_emissions)
		None:
			(line_state, line_emissions)


func test_option_match_borrow_or_transfer_record() -> Bool:
	var state: ScanState = {
		cursor = 0,
		diagnostics = ["seed"]
	}
	var index: Int = 0

	while index < 32:
		(next_state, emissions) = scan_one(state)
		state = next_state
		index += 1

	state.cursor == 32


tests: TestSuite = {
	description = "Option Match (Borrow or Transfer Record)",
	tests = [
		("option match borrow or transfer record", test_option_match_borrow_or_transfer_record),
	]
}
