import:
	test: TestSuite


private pure func make_token_pair() -> (Int, String):
	(1, "identifier")


func test_unmanaged_temporary_tuple_field_projection() -> Bool:
	make_token_pair()[0] == 1


tests: TestSuite = {
	description = "Unmanaged Temporary Tuple Field Projection",
	tests = [
		(
			"unmanaged temporary tuple field projection",
			test_unmanaged_temporary_tuple_field_projection,
		),
	]
}
