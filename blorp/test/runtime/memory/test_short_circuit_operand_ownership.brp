--- A logical operator evaluates its right operand only when the left operand
--- has not already decided the result, so a transfer inside that operand runs
--- on one path and not the other. Ownership insertion used to count the
--- transfer on both paths: the enclosing region gave up its reference before
--- the operator, and the short-circuited path kept that reference alive for the
--- rest of the process. These cases take the skipped path, so an unbalanced
--- transfer shows up as a leaked List under `scripts/test leak`.
import:
	test: TestSuite


record ShortCircuitBag {
	items: List[Int]
}


private pure func store(items: List[Int]) -> ShortCircuitBag:
	{ items = items }


--- Consumes `items`: the bag takes the list and the caller's reference goes
--- with it.
private pure func stores_any(items: List[Int]) -> Bool:
	store(items).items.length() > 0


private pure func sample() -> List[Int]:
	[1, 2, 3]


private pure func consumes_in_and(flag: Bool, items: List[Int]) -> Bool:
	flag and stores_any(items)


private pure func consumes_in_or(flag: Bool, items: List[Int]) -> Bool:
	flag or stores_any(items)


pure func test_and_skips_the_right_operand() -> Bool:
	items: List[Int] = sample()
	consumes_in_and(False, items) == False and items.length() == 3


pure func test_and_runs_the_right_operand() -> Bool:
	items: List[Int] = sample()
	consumes_in_and(True, items) and items.length() == 3


pure func test_or_skips_the_right_operand() -> Bool:
	items: List[Int] = sample()
	consumes_in_or(True, items) and items.length() == 3


pure func test_or_runs_the_right_operand() -> Bool:
	items: List[Int] = sample()
	consumes_in_or(False, items) and items.length() == 3


pure func test_local_binding_skips_the_right_operand() -> Bool:
	items: List[Int] = sample()
	result: Bool = False and stores_any(items)
	not result and items.length() == 3


pure func test_local_binding_runs_the_right_operand() -> Bool:
	items: List[Int] = sample()
	result: Bool = True and stores_any(items)
	result and items.length() == 3


pure func test_condition_skips_the_right_operand() -> Bool:
	items: List[Int] = sample()

	if False and stores_any(items):
		False
	else:
		items.length() == 3


pure func test_condition_runs_the_right_operand() -> Bool:
	items: List[Int] = sample()

	if True and stores_any(items):
		items.length() == 3
	else:
		False


pure func test_loop_takes_both_paths() -> Bool:
	items: List[Int] = sample()
	var taken: Int = 0
	var index: Int = 0

	while index < 3:
		if index > 0 and stores_any(items):
			taken += 1
		else:
			void

		index += 1

	taken == 2 and items.length() == 3


pure func test_captured_operand_is_skipped() -> Bool:
	items: List[Int] = sample()
	stored: pure () -> Bool = pure func(): stores_any(items)
	result: Bool = False and stored()
	not result and items.length() == 3


tests: TestSuite = {
	description = "Short-circuit operand ownership",
	tests = [
		("and skips the right operand", test_and_skips_the_right_operand),
		("and runs the right operand", test_and_runs_the_right_operand),
		("or skips the right operand", test_or_skips_the_right_operand),
		("or runs the right operand", test_or_runs_the_right_operand),
		(
			"local binding skips the right operand",
			test_local_binding_skips_the_right_operand,
		),
		(
			"local binding runs the right operand",
			test_local_binding_runs_the_right_operand,
		),
		("condition skips the right operand", test_condition_skips_the_right_operand),
		("condition runs the right operand", test_condition_runs_the_right_operand),
		("loop takes both paths", test_loop_takes_both_paths),
		("captured operand is skipped", test_captured_operand_is_skipped),
	]
}
