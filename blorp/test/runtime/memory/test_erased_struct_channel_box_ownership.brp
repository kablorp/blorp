import:
	channel:
		RecvAttempt(RecvSealed, RecvTimedOut, RecvValue, RecvWouldBlock),
		channel,
		send,
		try_recv_attempt,
	memory: MemoryCounter(LiveManagedObjects, MemoryStatsActive, OracleStatsActive), read_memory_counter, reset_mem_stats
	test: TestSuite


fixed record ChannelBoxPoint {
	value: Int
}


func enqueue_point_and_count_live_objects() -> Int:
	ch: Channel[ChannelBoxPoint] = channel(1)
	_ = send(ch, { value = 42 })
	read_memory_counter(LiveManagedObjects)


func try_recv_point_and_check() -> Bool:
	ch: Channel[ChannelBoxPoint] = channel(1)
	_ = send(ch, { value = 42 })

	-- The channel retains the ordinary managed record before send releases
	-- its temporary reference. No separate product box is required.
	if read_memory_counter(LiveManagedObjects) != 2:
		False
	else:
		match try_recv_attempt(ch):
			RecvValue(point):
				point.value == 42
			_:
				False


func enqueue_int128_and_count_live_objects() -> Int:
	ch: Channel[Int128] = channel(1)
	_ = send(ch, 42)
	read_memory_counter(LiveManagedObjects)


func enqueue_uint128_and_count_live_objects() -> Int:
	ch: Channel[UInt128] = channel(1)
	_ = send(ch, 42)
	read_memory_counter(LiveManagedObjects)


func try_recv_int128_and_check() -> Bool:
	ch: Channel[Int128] = channel(1)
	_ = send(ch, 42)

	if read_memory_counter(LiveManagedObjects) != 2:
		False
	else:
		match try_recv_attempt(ch):
			RecvValue(value):
				expected: Int128 = 42
				value == expected
			_:
				False


func try_recv_uint128_and_check() -> Bool:
	ch: Channel[UInt128] = channel(1)
	_ = send(ch, 42)

	if read_memory_counter(LiveManagedObjects) != 2:
		False
	else:
		match try_recv_attempt(ch):
			RecvValue(value):
				expected: UInt128 = 42
				value == expected
			_:
				False


func test_channel_retains_and_releases_record_on_receive() -> Bool:
	reset_mem_stats()
	active = read_memory_counter(MemoryStatsActive) == 1 and read_memory_counter(OracleStatsActive) == 1
	value_ok: Bool = try_recv_point_and_check()
	stats: Int = read_memory_counter(LiveManagedObjects)
	active and value_ok and stats == 0


func test_channel_drop_releases_buffered_record() -> Bool:
	reset_mem_stats()
	active = read_memory_counter(MemoryStatsActive) == 1 and read_memory_counter(OracleStatsActive) == 1
	queued_objects: Int = enqueue_point_and_count_live_objects()
	stats_after_drop: Int = read_memory_counter(LiveManagedObjects)
	active and queued_objects == 2 and stats_after_drop == 0


func test_channel_retains_and_releases_int128_boxes() -> Bool:
	reset_mem_stats()
	active = read_memory_counter(MemoryStatsActive) == 1 and read_memory_counter(OracleStatsActive) == 1
	int128_value_ok: Bool = try_recv_int128_and_check()
	uint128_value_ok: Bool = try_recv_uint128_and_check()
	stats_after_receive: Int = read_memory_counter(LiveManagedObjects)

	active and int128_value_ok and uint128_value_ok and stats_after_receive == 0


func test_channel_drop_releases_buffered_int128_boxes() -> Bool:
	reset_mem_stats()
	active = read_memory_counter(MemoryStatsActive) == 1 and read_memory_counter(OracleStatsActive) == 1
	queued_int128_objects: Int = enqueue_int128_and_count_live_objects()
	queued_uint128_objects: Int = enqueue_uint128_and_count_live_objects()
	stats_after_drop: Int = read_memory_counter(LiveManagedObjects)

	(
		active and queued_int128_objects == 2
		and queued_uint128_objects == 2
		and stats_after_drop == 0
	)


tests: TestSuite = {
	description = "Managed record channel slot ownership",
	tests = [
		(
			"channel retains and releases record on receive",
			test_channel_retains_and_releases_record_on_receive,
		),
		(
			"channel drop releases buffered record",
			test_channel_drop_releases_buffered_record,
		),
		(
			"channel retains and releases Int128 boxes",
			test_channel_retains_and_releases_int128_boxes,
		),
		(
			"channel drop releases buffered Int128 boxes",
			test_channel_drop_releases_buffered_int128_boxes,
		),
	]
}
