import:
	channel:
		RecvAttempt(RecvSealed, RecvTimedOut, RecvValue, RecvWouldBlock),
		channel,
		send,
		try_recv_attempt,
	memory: MemStats, get_mem_stats, reset_mem_stats
	test: TestSuite


struct ChannelBoxPoint {
	value: Int
}


func enqueue_point_and_count_live_objects() -> Int:
	ch: Channel[ChannelBoxPoint] = channel(1)
	_ = send(ch, { value = 42 })
	get_mem_stats().current_objects


func try_recv_point_and_check() -> Bool:
	ch: Channel[ChannelBoxPoint] = channel(1)
	_ = send(ch, { value = 42 })

	-- A value struct is boxed for the erased channel slot. The channel must
	-- retain that box before send releases its temporary reference.
	if get_mem_stats().current_objects != 2:
		False
	else:
		match try_recv_attempt(ch):
			RecvValue(point):
				point.value == 42
			_:
				False


func enqueue_int128_and_count_live_objects() -> Int:
	ch: Channel[Int128] = channel(1)
	_ = send(ch, 42)
	get_mem_stats().current_objects


func enqueue_uint128_and_count_live_objects() -> Int:
	ch: Channel[UInt128] = channel(1)
	_ = send(ch, 42)
	get_mem_stats().current_objects


func try_recv_int128_and_check() -> Bool:
	ch: Channel[Int128] = channel(1)
	_ = send(ch, 42)

	if get_mem_stats().current_objects != 2:
		False
	else:
		match try_recv_attempt(ch):
			RecvValue(value):
				expected: Int128 = 42
				value == expected
			_:
				False


func try_recv_uint128_and_check() -> Bool:
	ch: Channel[UInt128] = channel(1)
	_ = send(ch, 42)

	if get_mem_stats().current_objects != 2:
		False
	else:
		match try_recv_attempt(ch):
			RecvValue(value):
				expected: UInt128 = 42
				value == expected
			_:
				False


func test_channel_retains_and_releases_struct_box_on_receive() -> Bool:
	reset_mem_stats()
	value_ok: Bool = try_recv_point_and_check()
	stats: MemStats = get_mem_stats()
	value_ok and stats.current_objects == 0


func test_channel_drop_releases_buffered_struct_box() -> Bool:
	reset_mem_stats()
	queued_objects: Int = enqueue_point_and_count_live_objects()
	stats_after_drop: MemStats = get_mem_stats()
	queued_objects == 2 and stats_after_drop.current_objects == 0


func test_channel_retains_and_releases_int128_boxes() -> Bool:
	reset_mem_stats()
	int128_value_ok: Bool = try_recv_int128_and_check()
	uint128_value_ok: Bool = try_recv_uint128_and_check()
	stats_after_receive: MemStats = get_mem_stats()

	int128_value_ok and uint128_value_ok and stats_after_receive.current_objects == 0


func test_channel_drop_releases_buffered_int128_boxes() -> Bool:
	reset_mem_stats()
	queued_int128_objects: Int = enqueue_int128_and_count_live_objects()
	queued_uint128_objects: Int = enqueue_uint128_and_count_live_objects()
	stats_after_drop: MemStats = get_mem_stats()

	(
		queued_int128_objects == 2
		and queued_uint128_objects == 2
		and stats_after_drop.current_objects == 0
	)


tests: TestSuite = {
	description = "Erased struct channel slot ownership",
	tests = [
		(
			"channel retains and releases struct box on receive",
			test_channel_retains_and_releases_struct_box_on_receive,
		),
		(
			"channel drop releases buffered struct box",
			test_channel_drop_releases_buffered_struct_box,
		),
		(
			"channel retains and releases Int128 boxes",
			test_channel_retains_and_releases_int128_boxes,
		),
		(
			"channel drop releases buffered Int128 boxes",
			test_channel_drop_releases_buffered_int128_boxes,
		),
	]
}
