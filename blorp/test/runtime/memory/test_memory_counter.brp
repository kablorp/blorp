import:
	memory:
		MemoryCounter(
			ManagedAllocations, ManagedReleases, LiveManagedObjects, ManagedBytes,
			ManagedBytesAvailable, AllocatorBytesInUse, AllocatorBytesAvailable,
			BackingMallocEvents, RawMallocEvents, RawCallocEvents, RawReallocEvents,
			RawAlignedEvents, CleanupScratchEvents, FiberMapEvents, OracleStatsActive,
			MemoryStatsActive,
		),
		get_mem_stats, read_memory_counter, reset_mem_stats,
	test: TestSuite


func test_scalar_counter_reads_do_not_allocate_or_release() -> Bool:
	reset_mem_stats()
	before_allocations = read_memory_counter(ManagedAllocations)
	before_releases = read_memory_counter(ManagedReleases)
	objects = read_memory_counter(LiveManagedObjects)
	bytes = read_memory_counter(ManagedBytes)
	bytes_available = read_memory_counter(ManagedBytesAvailable)
	allocator_bytes = read_memory_counter(AllocatorBytesInUse)
	allocator_available = read_memory_counter(AllocatorBytesAvailable)
	backing = read_memory_counter(BackingMallocEvents)
	raw_malloc = read_memory_counter(RawMallocEvents)
	raw_calloc = read_memory_counter(RawCallocEvents)
	raw_realloc = read_memory_counter(RawReallocEvents)
	raw_aligned = read_memory_counter(RawAlignedEvents)
	cleanup = read_memory_counter(CleanupScratchEvents)
	fibers = read_memory_counter(FiberMapEvents)
	oracle_active = read_memory_counter(OracleStatsActive)
	memory_active = read_memory_counter(MemoryStatsActive)
	after_releases = read_memory_counter(ManagedReleases)
	after_allocations = read_memory_counter(ManagedAllocations)
	-- Allocate the coherent report only after all scalar endpoints.
	snapshot = get_mem_stats()
	(
		before_allocations == after_allocations and before_releases == after_releases
		and objects == snapshot.current_objects and bytes == snapshot.bytes_allocated
		and bytes_available == snapshot.bytes_available
		and allocator_bytes >= 0 and allocator_available >= 0
		and backing == snapshot.backing_libc_malloc_events
		and raw_malloc == snapshot.raw_buffer_malloc_events
		and raw_calloc == snapshot.raw_buffer_calloc_events
		and raw_realloc == snapshot.raw_buffer_realloc_events
		and raw_aligned == snapshot.raw_buffer_aligned_events
		and cleanup == snapshot.cleanup_scratch_events
		and fibers == snapshot.fiber_mmap_events
		and oracle_active == 1 and snapshot.oracle_stats_active == 1
		and memory_active == 1 and snapshot.memory_stats_active == 1
	)


tests: TestSuite = {
	description = "Nonallocating scalar memory counters",
	tests = [("scalar counter reads do not allocate or release", test_scalar_counter_reads_do_not_allocate_or_release)]
}
