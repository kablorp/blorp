import:
	option: Option(Some, None)
	test: TestSuite


func test_option_match_string() -> Bool:
	value: Option[String] = Some("alpha")

	match value:
		Some(s):
			s == "alpha"
		None:
			False


tests: TestSuite = {
	description = "Option Match (String)",
	tests = [("option match string", test_option_match_string)]
}
