import:
	memory: MemStats, get_mem_stats, reset_mem_stats
	test: TestSuite


record LoopOwnedValue {
	text: String
}


union LoopTokenKind:
	LoopStop
	LoopContinue(String)


record LoopToken {
	kind: LoopTokenKind,
	span: LoopOwnedValue
}


private pure func managed_match_value(value: Int) -> Option[LoopOwnedValue]:
	[{text = "matched-" + value.to_string()}].get(0)


private pure func break_after_managed_local() -> Bool:
	for value in [1]:
		text: String = "managed-" + value.to_string()

		if text == "managed-1":
			break

	True


private pure func break_from_managed_match() -> Bool:
	var result: Option[LoopOwnedValue] = None

	for value in [1]:
		match managed_match_value(value):
			Some(item):
				result = Some(item)
				break
			None:
				void

	match result:
		Some(item):
			item.text == "matched-1"
		None:
			False


private pure func break_after_hidden_branch_local() -> Bool:
	while True:
		value: LoopOwnedValue = {text = "hidden-" + 1.to_string()}
		should_break: Bool = value.text == "hidden-1"

		if should_break:
			break

	True


private pure func loop_token() -> LoopToken:
	{
		kind = LoopStop,
		span = {text = "span-" + 1.to_string()}
	}


private pure func break_from_projected_match() -> Bool:
	while True:
		token: LoopToken = loop_token()

		match token.kind:
			LoopStop:
				break
			LoopContinue(_):
				void

	True


func test_owned_list_iterator_with_break_is_released() -> Bool:
	reset_mem_stats()
	var total: Int = 0
	var i: Int = 0

	while i < 200:
		for n in [1, 2, 3]:
			total += n
			break

		i += 1

	stats: MemStats = get_mem_stats()

	(
		total == 200
		and stats.total_allocations > 0
		and stats.total_releases > 0
		and stats.current_objects < 20
	)


func test_owned_list_iterator_with_continue_is_released() -> Bool:
	reset_mem_stats()
	var total: Int = 0
	var i: Int = 0

	while i < 200:
		for n in [1, 2, 3]:
			if n == 2:
				continue

			total += n

		i += 1

	stats: MemStats = get_mem_stats()

	(
		total == 800
		and stats.total_allocations > 0
		and stats.total_releases > 0
		and stats.current_objects < 20
	)


func test_managed_local_before_break_is_released() -> Bool:
	reset_mem_stats()
	ok: Bool = break_after_managed_local()
	stats: MemStats = get_mem_stats()
	ok and stats.current_objects == 0


func test_managed_match_before_break_is_released() -> Bool:
	reset_mem_stats()
	ok: Bool = break_from_managed_match()
	stats: MemStats = get_mem_stats()
	ok and stats.current_objects == 0


func test_hidden_branch_local_before_break_is_released() -> Bool:
	reset_mem_stats()
	ok: Bool = break_after_hidden_branch_local()
	stats: MemStats = get_mem_stats()
	ok and stats.current_objects == 0


func test_projected_match_local_before_break_is_released() -> Bool:
	reset_mem_stats()
	ok: Bool = break_from_projected_match()
	stats: MemStats = get_mem_stats()
	ok and stats.current_objects == 0


record BorrowedHolder {
	items: List[LoopOwnedValue],
	label: String
}


private pure func sum_borrowed_parameter(items: List[LoopOwnedValue]) -> Int:
	var total: Int = 0

	for item in items:
		total += item.text.length()

	total


private pure func sum_immutable_let(source: List[LoopOwnedValue]) -> Int:
	items: List[LoopOwnedValue] = source
	var total: Int = 0

	for item in items:
		total += item.text.length()

	total


private pure func sum_reassigned_during_loop(source: List[LoopOwnedValue]) -> Int:
	var items: List[LoopOwnedValue] = source
	var total: Int = 0

	for item in items:
		total += item.text.length()
		items = []

	total


private pure func consume_holder(holder: BorrowedHolder) -> Int:
	holder.items.length()


private pure func sum_with_consuming_call(items: List[LoopOwnedValue]) -> Int:
	var total: Int = 0

	for item in items:
		total += item.text.length() + consume_holder({
			items = items,
			label = "held",
		})

	total


private pure func sum_with_lambda_capture(items: List[LoopOwnedValue]) -> Int:
	var total: Int = 0

	for item in items:
		measure: pure () -> Int = pure func() -> Int: items.length()
		total += item.text.length() + measure()

	total


private pure func first_long_text(items: List[LoopOwnedValue]) -> Int:
	var found: Int = 0

	for item in items:
		if item.text.length() > 0:
			found = item.text.length()
			break
		else:
			void

	found


private pure func first_text_with_break(items: List[LoopOwnedValue]) -> Int:
	var total: Int = 0

	for item in items:
		total += item.text.length()
		break

	total


private pure func count_label_code_points(holder: BorrowedHolder) -> Int:
	var total: Int = 0

	for code_point in holder.label:
		total += 1

	total


private pure func borrowed_values(count: Int) -> List[LoopOwnedValue]:
	var values: List[LoopOwnedValue] = []
	var index: Int = 0

	while index < count:
		values = values.append({text = "value-" + index.to_string()})
		index += 1

	values


private pure func borrowed_holder() -> BorrowedHolder:
	{
		items = borrowed_values(3),
		label = "label-" + 1.to_string()
	}


func test_borrowed_parameter_loop_releases_every_value() -> Bool:
	reset_mem_stats()
	total: Int = sum_borrowed_parameter(borrowed_values(3))
	stats: MemStats = get_mem_stats()
	total == 21 and stats.current_objects == 0


func test_immutable_let_loop_releases_every_value() -> Bool:
	reset_mem_stats()
	total: Int = sum_immutable_let(borrowed_values(3))
	stats: MemStats = get_mem_stats()
	total == 21 and stats.current_objects == 0


func test_reassigned_iterable_still_sees_original_elements() -> Bool:
	reset_mem_stats()
	total: Int = sum_reassigned_during_loop(borrowed_values(3))
	stats: MemStats = get_mem_stats()
	total == 21 and stats.current_objects == 0


func test_consuming_call_inside_loop_keeps_iterable_alive() -> Bool:
	reset_mem_stats()
	total: Int = sum_with_consuming_call(borrowed_values(3))
	stats: MemStats = get_mem_stats()
	total == 30 and stats.current_objects == 0


func test_lambda_capture_inside_loop_keeps_iterable_alive() -> Bool:
	reset_mem_stats()
	total: Int = sum_with_lambda_capture(borrowed_values(3))
	stats: MemStats = get_mem_stats()
	total == 30 and stats.current_objects == 0


func test_early_return_inside_borrowed_loop_releases_values() -> Bool:
	reset_mem_stats()
	length: Int = first_long_text(borrowed_values(3))
	stats: MemStats = get_mem_stats()
	length == 7 and stats.current_objects == 0


func test_break_inside_borrowed_loop_releases_values() -> Bool:
	reset_mem_stats()
	length: Int = first_text_with_break(borrowed_values(3))
	stats: MemStats = get_mem_stats()
	length == 7 and stats.current_objects == 0


func test_string_field_loop_releases_holder() -> Bool:
	reset_mem_stats()
	total: Int = count_label_code_points(borrowed_holder())
	stats: MemStats = get_mem_stats()
	total == 7 and stats.current_objects == 0


tests: TestSuite = {
	description = "For Loop Iterator Ownership",
	tests = [
		(
			"owned list iterator with break is released",
			test_owned_list_iterator_with_break_is_released,
		),
		(
			"owned list iterator with continue is released",
			test_owned_list_iterator_with_continue_is_released,
		),
		("managed local before break is released", test_managed_local_before_break_is_released),
		("managed match before break is released", test_managed_match_before_break_is_released),
		(
			"hidden branch local before break is released",
			test_hidden_branch_local_before_break_is_released,
		),
		(
			"projected match local before break is released",
			test_projected_match_local_before_break_is_released,
		),
		(
			"borrowed parameter loop releases every value",
			test_borrowed_parameter_loop_releases_every_value,
		),
		("immutable let loop releases every value", test_immutable_let_loop_releases_every_value),
		(
			"reassigned iterable still sees original elements",
			test_reassigned_iterable_still_sees_original_elements,
		),
		(
			"consuming call inside loop keeps iterable alive",
			test_consuming_call_inside_loop_keeps_iterable_alive,
		),
		(
			"lambda capture inside loop keeps iterable alive",
			test_lambda_capture_inside_loop_keeps_iterable_alive,
		),
		(
			"early return inside borrowed loop releases values",
			test_early_return_inside_borrowed_loop_releases_values,
		),
		(
			"break inside borrowed loop releases values",
			test_break_inside_borrowed_loop_releases_values,
		),
		("string field loop releases holder", test_string_field_loop_releases_holder),
	]
}
