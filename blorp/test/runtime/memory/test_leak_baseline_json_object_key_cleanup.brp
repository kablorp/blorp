import:
	json: parse_json
	test: TestSuite


func test_json_object_key_cleanup() -> Bool:
	match parse_json(
		"{\"schema\":1,\"domain\":\"compiler\",\"action\":\"parse_source\",\"payload\":{\"path\":\"/tmp/tiny.brp\",\"module\":\"bench/tiny\",\"text\":\"func main(args: List[String]): 0\",\"ast_phase\":\"raw_parse\",\"include_comments\":false}}",
	):
		Ok(_):
			True
		Err(_):
			False


tests: TestSuite = {
	description = "JSON Object Key Cleanup",
	tests = [("json object key cleanup", test_json_object_key_cleanup)]
}
