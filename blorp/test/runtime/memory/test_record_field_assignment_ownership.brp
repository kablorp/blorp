import:
	test: TestSuite


record Holder {
	values: List[String]
}


func make_holder() -> Holder:
	{values = ["alpha", "beta", "gamma"]}


func test_assigned_field_survives_owner_release() -> Bool:
	var values: List[String] = []
	holder: Holder = make_holder()
	values = holder.values
	other: List[String] = ["delta", "epsilon"]

	second_ok: Bool = match values.get(1):
		Some(v):
			v == "beta"
		None:
			False

	values.length() == 3 and second_ok and other.length() == 2


tests: TestSuite = {
	description = "Record Field Assignment Ownership",
	tests = [("assigned field survives owner release", test_assigned_field_survives_owner_release)]
}
