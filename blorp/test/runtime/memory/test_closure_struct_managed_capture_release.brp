import:
	memory: MemStats, get_mem_stats, reset_mem_stats
	test: TestSuite


struct Point {
	x: Int
}


func invoke_scoped_point_and_string_closure() -> Int:
	point: Point = {x = 37}
	label: String = point.x.to_string()
	reader: pure () -> Int = func(): point.x + label.length()
	reader()


func test_typed_closure_releases_managed_capture() -> Bool:
	reset_mem_stats()
	value: Int = invoke_scoped_point_and_string_closure()
	stats: MemStats = get_mem_stats()

	value == 39 and stats.current_objects == 0


tests: TestSuite = {
	description = "Closure Struct and Managed Capture Release",
	tests = [
		(
			"typed closure releases its managed capture after owner drop",
			test_typed_closure_releases_managed_capture,
		),
	]
}
