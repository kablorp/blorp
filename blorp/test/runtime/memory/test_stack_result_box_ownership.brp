import:
	test: TestSuite


-- A stack Result stored in generic storage is copied into a fresh box that
-- owns exactly one payload reference. In a list or dict literal a borrowed
-- variable is retained for the box while an owned call result hands its
-- reference over; raw list stores and union payloads always receive a
-- reference that Core already supplied.


func make_label(count: Int) -> Result[String, String]:
	if count > 100:
		Err("too many")
	else:
		Ok("label-" + count.to_string())


func label_or_empty(result: Result[String, String]) -> String:
	match result:
		Ok(label):
			label
		Err(message):
			message


func test_dict_literal_scalar_result_variable_releases_box() -> Bool:
	result: Result[Int, String] = Ok(5)
	results: Dict[Int, Result[Int, String]] = {1 => result}
	results.length() == 1 and results.contains(1)


func test_dict_literal_managed_result_variable_releases_box_and_payload() -> Bool:
	result: Result[String, String] = make_label(3)
	results: Dict[Int, Result[String, String]] = {1 => result}
	results.length() == 1 and label_or_empty(result) == "label-3"


func test_dict_literal_managed_result_call_releases_payload() -> Bool:
	results: Dict[Int, Result[String, String]] = {1 => make_label(4), 2 => make_label(500)}
	results.length() == 2


func test_list_literal_managed_result_call_releases_payload() -> Bool:
	results: List[Result[String, String]] = [make_label(5), make_label(500)]
	var labels: String = ""

	for result in results:
		labels = labels + label_or_empty(result) + ";"

	labels == "label-5;too many;"


func test_list_literal_managed_result_variable_releases_payload() -> Bool:
	result: Result[String, String] = make_label(6)
	results: List[Result[String, String]] = [result, result]
	var labels: String = ""

	for stored in results:
		labels = labels + label_or_empty(stored) + ";"

	labels == "label-6;label-6;" and label_or_empty(result) == "label-6"


func test_list_append_managed_result_call_releases_payload() -> Bool:
	var results: List[Result[String, String]] = []
	results = results.append(make_label(7))
	results.length() == 1


func test_list_append_managed_result_variable_releases_payload() -> Bool:
	result: Result[String, String] = make_label(8)
	var results: List[Result[String, String]] = []
	results = results.append(result)
	results = results.append(result)
	results.length() == 2 and label_or_empty(result) == "label-8"


func test_list_set_managed_result_releases_replaced_and_stored_payloads() -> Bool:
	result: Result[String, String] = make_label(9)
	var results: List[Result[String, String]] = [make_label(1), make_label(2)]
	results = results.set(0, make_label(10))
	results = results.set(1, result)
	labels: String = label_or_empty(results.get(0).get_or(Err("missing"))) + ";" + label_or_empty(
		results.get(1).get_or(Err("missing")),
	)
	labels == "label-10;label-9" and label_or_empty(result) == "label-9"


func test_list_get_managed_result_releases_read_payload() -> Bool:
	results: List[Result[String, String]] = [make_label(11)]

	match results.get(0):
		Some(result):
			label_or_empty(result) == "label-11"
		None:
			False


func test_option_some_managed_result_releases_payload() -> Bool:
	moved: Result[String, String] = make_label(12)
	kept: Result[String, String] = make_label(13)
	moved_option: Option[Result[String, String]] = Some(moved)
	kept_option: Option[Result[String, String]] = Some(kept)
	moved_option.is_some() and kept_option.is_some() and label_or_empty(kept) == "label-13"


func test_literals_retain_borrowed_tuple_slot_result() -> Bool:
	pair: (Result[String, String], Int) = (make_label(14), 1)
	results: List[Result[String, String]] = [pair[0]]
	by_key: Dict[Int, Result[String, String]] = {1 => pair[0]}
	results.length() == 1 and by_key.length() == 1 and label_or_empty(pair[0]) == "label-14"


tests: TestSuite = {
	description = "Stack Result Box Ownership",
	tests = [
		(
			"dict literal scalar result variable releases box",
			test_dict_literal_scalar_result_variable_releases_box,
		),
		(
			"dict literal managed result variable releases box and payload",
			test_dict_literal_managed_result_variable_releases_box_and_payload,
		),
		(
			"dict literal managed result call releases payload",
			test_dict_literal_managed_result_call_releases_payload,
		),
		(
			"list literal managed result call releases payload",
			test_list_literal_managed_result_call_releases_payload,
		),
		(
			"list literal managed result variable releases payload",
			test_list_literal_managed_result_variable_releases_payload,
		),
		(
			"list append managed result call releases payload",
			test_list_append_managed_result_call_releases_payload,
		),
		(
			"list append managed result variable releases payload",
			test_list_append_managed_result_variable_releases_payload,
		),
		(
			"list set managed result releases replaced and stored payloads",
			test_list_set_managed_result_releases_replaced_and_stored_payloads,
		),
		(
			"list get managed result releases read payload",
			test_list_get_managed_result_releases_read_payload,
		),
		(
			"option some managed result releases payload",
			test_option_some_managed_result_releases_payload,
		),
		(
			"literals retain borrowed tuple slot result",
			test_literals_retain_borrowed_tuple_slot_result,
		),
	]
}
