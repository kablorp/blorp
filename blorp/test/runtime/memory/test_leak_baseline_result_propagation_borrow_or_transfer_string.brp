import:
	test: TestSuite


private pure func consume_or_error(key: String, succeeds: Bool) -> Result[Int, String]:
	if succeeds:
		Ok(1)
	else:
		Err(key)


private pure func decode_key(key: String, valid: Bool) -> Result[Int, String]:
	value ?= consume_or_error(key, True)

	if valid:
		Ok(value)
	else:
		Err(key)


func test_result_propagation_borrow_or_transfer_string() -> Bool:
	match decode_key("schema", True):
		Ok(value):
			value == 1
		Err(_):
			False


tests: TestSuite = {
	description = "Result Propagation (Borrow or Transfer String)",
	tests = [
		(
			"result propagation borrow or transfer string",
			test_result_propagation_borrow_or_transfer_string,
		),
	]
}
