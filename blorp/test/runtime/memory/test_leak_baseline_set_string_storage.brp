import:
	set as S
	test: TestSuite


func test_set_string_storage() -> Bool:
	var s: Set[String] = S.set()
	s = S.add(s, "alpha")
	s = S.add(s, "beta")
	s = S.add(s, "alpha")

	S.contains(s, "beta") and s.length() == 2


tests: TestSuite = {
	description = "Set String Storage",
	tests = [("set string storage", test_set_string_storage)]
}
