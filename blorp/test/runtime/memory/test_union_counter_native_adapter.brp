	if (
		value_0 != READ_MISMATCH
		and value_1 != READ_MISMATCH
		and value_2 != READ_MISMATCH
		and value_3 != READ_MISMATCH
		and value_4 != READ_MISMATCH
		and value_5 != READ_MISMATCH
		and value_6 != READ_MISMATCH
		and value_7 != READ_MISMATCH
		and value_8 != READ_MISMATCH
		and value_9 != READ_MISMATCH
		and value_10 != READ_MISMATCH
		and value_11 != READ_MISMATCH
		and value_12 != READ_MISMATCH
		and value_13 != READ_MISMATCH
		and value_14 != READ_MISMATCH
		and value_15 != READ_MISMATCH
	):
		value_0 * 1 + value_1 * 2 + value_2 * 3 + value_3 * 4 + value_4 * 5 + value_5 * 6 + value_6 * 7 + value_7 * 8 + value_8 * 9 + value_9 * 10 + value_10 * 11 + value_11 * 12 + value_12 * 13 + value_13 * 14 + value_14 * 15 + value_15 * 16
	else:
		READ_MISMATCH


func test_fixed_reads_preserve_managed_and_raw_counters() -> Bool:
	reset_mem_stats()
	before_memory: Int = read_memory_counter(MemoryStatsActive)
	before_oracle: Int = read_memory_counter(OracleStatsActive)
	before_0: Int = read_memory_counter(ManagedAllocations)
	before_1: Int = read_memory_counter(ManagedReleases)
	before_7: Int = read_memory_counter(BackingMallocEvents)
	before_8: Int = read_memory_counter(RawMallocEvents)
	before_9: Int = read_memory_counter(RawCallocEvents)
	before_10: Int = read_memory_counter(RawReallocEvents)
	before_11: Int = read_memory_counter(RawAlignedEvents)
	before_12: Int = read_memory_counter(CleanupScratchEvents)
	before_13: Int = read_memory_counter(FiberMapEvents)
	var checksum: Int = 0
	var valid: Bool = True
	var iteration: Int = 0

	-- No container, report or output allocation occurs inside this interval.
	while iteration < READ_ITERATIONS:
		observed: Int = fixed_sweep()
		valid = valid and observed != READ_MISMATCH
		checksum += observed
		iteration += 1

	after_0: Int = read_memory_counter(ManagedAllocations)
	after_1: Int = read_memory_counter(ManagedReleases)
	after_7: Int = read_memory_counter(BackingMallocEvents)
	after_8: Int = read_memory_counter(RawMallocEvents)
	after_9: Int = read_memory_counter(RawCallocEvents)
	after_10: Int = read_memory_counter(RawReallocEvents)
	after_11: Int = read_memory_counter(RawAlignedEvents)
	after_12: Int = read_memory_counter(CleanupScratchEvents)
	after_13: Int = read_memory_counter(FiberMapEvents)
	after_memory: Int = read_memory_counter(MemoryStatsActive)
	after_oracle: Int = read_memory_counter(OracleStatsActive)
	print("fixed checksum: ${checksum.to_string()}")
	print("fixed managed_allocations delta: ${(after_0 - before_0).to_string()}")
	print("fixed managed_releases delta: ${(after_1 - before_1).to_string()}")
	print("fixed backing_malloc delta: ${(after_7 - before_7).to_string()}")
	print("fixed raw_malloc delta: ${(after_8 - before_8).to_string()}")
	print("fixed raw_calloc delta: ${(after_9 - before_9).to_string()}")
	print("fixed raw_realloc delta: ${(after_10 - before_10).to_string()}")
	print("fixed raw_aligned delta: ${(after_11 - before_11).to_string()}")
	print("fixed cleanup_scratch delta: ${(after_12 - before_12).to_string()}")
	print("fixed fiber_map delta: ${(after_13 - before_13).to_string()}")
	(
		before_memory == 1
		and after_memory == 1
		and before_oracle == 1
		and after_oracle == 1
		and valid
		and iteration == READ_ITERATIONS
		and checksum > 0
		and before_0 == after_0
		and before_1 == after_1
		and before_7 == after_7
		and before_8 == after_8
		and before_9 == after_9
		and before_10 == after_10
		and before_11 == after_11
		and before_12 == after_12
		and before_13 == after_13
	)


private pure func counter_parity(
	expected_tag: Int,
	canonical: MemoryCounter,
	ordinary: OrdinaryCounter,
	fixed: FixedCounter,
) -> Bool:
	canonical_value: Int = canonical_repeat(canonical)
	ordinary_value: Int = ordinary_repeat(ordinary)
	fixed_value: Int = fixed_repeat(fixed)
	(
		ordinary_counter_tag(ordinary) == expected_tag
		and fixed_counter_tag(fixed) == expected_tag
		and canonical_value != READ_MISMATCH
		and canonical_value == ordinary_value
		and canonical_value == fixed_value
	)


func test_all_native_tags_and_values_agree_with_canonical_readers() -> Bool:
	reset_mem_stats()
	var correct: Bool = (
		read_memory_counter(MemoryStatsActive) == 1
		and read_memory_counter(OracleStatsActive) == 1
	)

	correct = (
		counter_parity(0, ManagedAllocations, OrdinaryManagedAllocations, FixedManagedAllocations)
		and correct
	)
	correct = (
		counter_parity(1, ManagedReleases, OrdinaryManagedReleases, FixedManagedReleases)
		and correct
	)
	correct = (
		counter_parity(2, LiveManagedObjects, OrdinaryLiveManagedObjects, FixedLiveManagedObjects)
		and correct
	)
	correct = counter_parity(3, ManagedBytes, OrdinaryManagedBytes, FixedManagedBytes) and correct
	correct = (
		counter_parity(
			4,
			ManagedBytesAvailable,
			OrdinaryManagedBytesAvailable,
			FixedManagedBytesAvailable,
		)
		and correct
	)
	correct = (
		counter_parity(
			5,
			AllocatorBytesInUse,
			OrdinaryAllocatorBytesInUse,
			FixedAllocatorBytesInUse,
		)
		and correct
	)
	correct = (
		counter_parity(
			6,
			AllocatorBytesAvailable,
			OrdinaryAllocatorBytesAvailable,
			FixedAllocatorBytesAvailable,
		)
		and correct
	)
	correct = (
		counter_parity(
			7,
			BackingMallocEvents,
			OrdinaryBackingMallocEvents,
			FixedBackingMallocEvents,
		)
		and correct
	)
	correct = (
		counter_parity(8, RawMallocEvents, OrdinaryRawMallocEvents, FixedRawMallocEvents)
		and correct
	)
	correct = (
		counter_parity(9, RawCallocEvents, OrdinaryRawCallocEvents, FixedRawCallocEvents)
		and correct
	)
	correct = (
		counter_parity(10, RawReallocEvents, OrdinaryRawReallocEvents, FixedRawReallocEvents)
		and correct
	)
	correct = (
		counter_parity(11, RawAlignedEvents, OrdinaryRawAlignedEvents, FixedRawAlignedEvents)
		and correct
	)
	correct = (
		counter_parity(
			12,
			CleanupScratchEvents,
			OrdinaryCleanupScratchEvents,
			FixedCleanupScratchEvents,
		)
		and correct
	)
	correct = (
		counter_parity(13, FiberMapEvents, OrdinaryFiberMapEvents, FixedFiberMapEvents)
		and correct
	)
	correct = (
		counter_parity(14, OracleStatsActive, OrdinaryOracleStatsActive, FixedOracleStatsActive)
		and correct
	)
	correct = (
		counter_parity(15, MemoryStatsActive, OrdinaryMemoryStatsActive, FixedMemoryStatsActive)
		and correct
	)

	(
		correct
		and read_memory_counter(MemoryStatsActive) == 1
		and read_memory_counter(OracleStatsActive) == 1
	)


private pure func canonical_selector(seed: Int) -> MemoryCounter:
	-- Normalization is internal: the domain is exactly 0..15. The wildcard
	-- is its remaining valid case 15, not an unknown-native-tag fallback.
	index: Int = (seed % 16 + 16) % 16

	match index:
		0:
			ManagedAllocations
		1:
			ManagedReleases
		2:
			LiveManagedObjects
		3:
			ManagedBytes
		4:
			ManagedBytesAvailable
		5:
			AllocatorBytesInUse
		6:
			AllocatorBytesAvailable
		7:
			BackingMallocEvents
		8:
			RawMallocEvents
		9:
			RawCallocEvents
		10:
			RawReallocEvents
		11:
			RawAlignedEvents
		12:
			CleanupScratchEvents
		13:
			FiberMapEvents
		14:
			OracleStatsActive
		_:
			MemoryStatsActive


private pure func ordinary_selector(seed: Int) -> OrdinaryCounter:
	-- Normalization is internal: the domain is exactly 0..15. The wildcard
	-- is its remaining valid case 15, not an unknown-native-tag fallback.
	index: Int = (seed % 16 + 16) % 16

	match index:
		0:
			OrdinaryManagedAllocations
		1:
			OrdinaryManagedReleases
		2:
			OrdinaryLiveManagedObjects
		3:
			OrdinaryManagedBytes
		4:
			OrdinaryManagedBytesAvailable
		5:
			OrdinaryAllocatorBytesInUse
		6:
			OrdinaryAllocatorBytesAvailable
		7:
			OrdinaryBackingMallocEvents
		8:
			OrdinaryRawMallocEvents
		9:
			OrdinaryRawCallocEvents
		10:
			OrdinaryRawReallocEvents
		11:
			OrdinaryRawAlignedEvents
		12:
			OrdinaryCleanupScratchEvents
		13:
			OrdinaryFiberMapEvents
		14:
			OrdinaryOracleStatsActive
		_:
			OrdinaryMemoryStatsActive


private pure func fixed_selector(seed: Int) -> FixedCounter:
	-- Normalization is internal: the domain is exactly 0..15. The wildcard
	-- is its remaining valid case 15, not an unknown-native-tag fallback.
	index: Int = (seed % 16 + 16) % 16

	match index:
		0:
			FixedManagedAllocations
		1:
			FixedManagedReleases
		2:
			FixedLiveManagedObjects
		3:
			FixedManagedBytes
		4:
			FixedManagedBytesAvailable
		5:
			FixedAllocatorBytesInUse
		6:
			FixedAllocatorBytesAvailable
		7:
			FixedBackingMallocEvents
		8:
			FixedRawMallocEvents
		9:
			FixedRawCallocEvents
		10:
			FixedRawReallocEvents
		11:
			FixedRawAlignedEvents
		12:
			FixedCleanupScratchEvents
		13:
			FixedFiberMapEvents
		14:
			FixedOracleStatsActive
		_:
			FixedMemoryStatsActive


func test_runtime_derived_selectors_preserve_values_and_zero_events() -> Bool:
	reset_mem_stats()
	before_memory: Int = read_memory_counter(MemoryStatsActive)
	before_oracle: Int = read_memory_counter(OracleStatsActive)
	before_0: Int = read_memory_counter(ManagedAllocations)
	before_1: Int = read_memory_counter(ManagedReleases)
	before_7: Int = read_memory_counter(BackingMallocEvents)
	before_8: Int = read_memory_counter(RawMallocEvents)
	before_9: Int = read_memory_counter(RawCallocEvents)
	before_10: Int = read_memory_counter(RawReallocEvents)
	before_11: Int = read_memory_counter(RawAlignedEvents)
	before_12: Int = read_memory_counter(CleanupScratchEvents)
	before_13: Int = read_memory_counter(FiberMapEvents)
	-- A real native observation seeds dynamic singleton selection. Normalize
	-- before adding the bounded iteration, so arithmetic overflow cannot
	-- affect coverage: four consecutive cycles visit all sixteen selectors.
	seed: Int = (read_native_counter(14) % 16 + 16) % 16
	var iteration: Int = 0
	var checksum: Int = 0
	var valid: Bool = True

	while iteration < READ_ITERATIONS:
		index: Int = seed + iteration
		canonical: Int = canonical_repeat(canonical_selector(index))
		ordinary: Int = ordinary_repeat(ordinary_selector(index))
		fixed: Int = fixed_repeat(fixed_selector(index))
		valid = (
			valid
			and canonical != READ_MISMATCH
			and canonical == ordinary
			and canonical == fixed
		)
		checksum += canonical
		iteration += 1

	after_0: Int = read_memory_counter(ManagedAllocations)
	after_1: Int = read_memory_counter(ManagedReleases)
	after_7: Int = read_memory_counter(BackingMallocEvents)
	after_8: Int = read_memory_counter(RawMallocEvents)
	after_9: Int = read_memory_counter(RawCallocEvents)
	after_10: Int = read_memory_counter(RawReallocEvents)
	after_11: Int = read_memory_counter(RawAlignedEvents)
	after_12: Int = read_memory_counter(CleanupScratchEvents)
	after_13: Int = read_memory_counter(FiberMapEvents)
	after_memory: Int = read_memory_counter(MemoryStatsActive)
	after_oracle: Int = read_memory_counter(OracleStatsActive)
	print("dynamic checksum: ${checksum.to_string()}")
	print("dynamic managed_allocations delta: ${(after_0 - before_0).to_string()}")
	print("dynamic managed_releases delta: ${(after_1 - before_1).to_string()}")
	print("dynamic backing_malloc delta: ${(after_7 - before_7).to_string()}")
	print("dynamic raw_malloc delta: ${(after_8 - before_8).to_string()}")
	print("dynamic raw_calloc delta: ${(after_9 - before_9).to_string()}")
	print("dynamic raw_realloc delta: ${(after_10 - before_10).to_string()}")
	print("dynamic raw_aligned delta: ${(after_11 - before_11).to_string()}")
	print("dynamic cleanup_scratch delta: ${(after_12 - before_12).to_string()}")
	print("dynamic fiber_map delta: ${(after_13 - before_13).to_string()}")
	(
		before_memory == 1
		and after_memory == 1
		and before_oracle == 1
		and after_oracle == 1
		and valid
		and iteration == READ_ITERATIONS
		and checksum > 0
		and before_0 == after_0
		and before_1 == after_1
		and before_7 == after_7
		and before_8 == after_8
		and before_9 == after_9
		and before_10 == after_10
		and before_11 == after_11
		and before_12 == after_12
		and before_13 == after_13
	)


tests: TestSuite = {
	description = "Union counter native adapter",
	tests = [
		(
			"canonical readers preserve managed and raw counters",
			test_canonical_reads_preserve_managed_and_raw_counters,
		),
		(
			"ordinary adapters preserve managed and raw counters",
			test_ordinary_reads_preserve_managed_and_raw_counters,
		),
		(
			"fixed adapters preserve managed and raw counters",
			test_fixed_reads_preserve_managed_and_raw_counters,
		),
		(
			"all native tags and values agree",
			test_all_native_tags_and_values_agree_with_canonical_readers,
		),
		(
			"runtime derived selectors preserve values and zero events",
			test_runtime_derived_selectors_preserve_values_and_zero_events,
		),
	]
}
