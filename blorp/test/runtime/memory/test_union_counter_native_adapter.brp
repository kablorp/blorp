	after_memory: Int = read_memory_counter(MemoryStatsActive)
	after_oracle: Int = read_memory_counter(OracleStatsActive)
	print("ordinary checksum: ${checksum.to_string()}")
	print("ordinary managed_allocations delta: ${(after_0 - before_0).to_string()}")
	print("ordinary managed_releases delta: ${(after_1 - before_1).to_string()}")
	print("ordinary backing_malloc delta: ${(after_7 - before_7).to_string()}")
	print("ordinary raw_malloc delta: ${(after_8 - before_8).to_string()}")
	print("ordinary raw_calloc delta: ${(after_9 - before_9).to_string()}")
	print("ordinary raw_realloc delta: ${(after_10 - before_10).to_string()}")
	print("ordinary raw_aligned delta: ${(after_11 - before_11).to_string()}")
	print("ordinary cleanup_scratch delta: ${(after_12 - before_12).to_string()}")
	print("ordinary fiber_map delta: ${(after_13 - before_13).to_string()}")
	(
		before_memory == 1
		and after_memory == 1
		and before_oracle == 1
		and after_oracle == 1
		and valid
		and iteration == READ_ITERATIONS
		and checksum > 0
		and before_0 == after_0
		and before_1 == after_1
		and before_7 == after_7
		and before_8 == after_8
		and before_9 == after_9
		and before_10 == after_10
		and before_11 == after_11
		and before_12 == after_12
		and before_13 == after_13
	)


private pure func fixed_repeat(counter: FixedCounter) -> Int:
	first: Int = read_native_counter(fixed_counter_tag(counter))
	second: Int = read_native_counter(fixed_counter_tag(counter))

	if first == second:
		first
	else:
		READ_MISMATCH


private pure func fixed_sweep() -> Int:
	value_0: Int = fixed_repeat(FixedManagedAllocations)
	value_1: Int = fixed_repeat(FixedManagedReleases)
	value_2: Int = fixed_repeat(FixedLiveManagedObjects)
	value_3: Int = fixed_repeat(FixedManagedBytes)
	value_4: Int = fixed_repeat(FixedManagedBytesAvailable)
	value_5: Int = fixed_repeat(FixedAllocatorBytesInUse)
	value_6: Int = fixed_repeat(FixedAllocatorBytesAvailable)
	value_7: Int = fixed_repeat(FixedBackingMallocEvents)
