import:
	memory:
		MemoryCounter(
			ManagedAllocations, ManagedReleases, LiveManagedObjects, ManagedBytes,
			ManagedBytesAvailable, AllocatorBytesInUse, AllocatorBytesAvailable,
			BackingMallocEvents, RawMallocEvents, RawCallocEvents, RawReallocEvents,
			RawAlignedEvents, CleanupScratchEvents, FiberMapEvents, OracleStatsActive,
			MemoryStatsActive,
		),
		read_memory_counter,
		reset_mem_stats,
	test: TestSuite


-- Native runtime.c pins these selector tags to C long values 0 through 15.
-- This pilot preserves MemoryCounter itself and uses only encode adapters.
union OrdinaryCounter:
	OrdinaryManagedAllocations
	OrdinaryManagedReleases
	OrdinaryLiveManagedObjects
	OrdinaryManagedBytes
	OrdinaryManagedBytesAvailable
	OrdinaryAllocatorBytesInUse
	OrdinaryAllocatorBytesAvailable
	OrdinaryBackingMallocEvents
	OrdinaryRawMallocEvents
	OrdinaryRawCallocEvents
	OrdinaryRawReallocEvents
	OrdinaryRawAlignedEvents
	OrdinaryCleanupScratchEvents
	OrdinaryFiberMapEvents
	OrdinaryOracleStatsActive
	OrdinaryMemoryStatsActive


private pure func ordinary_counter_tag(counter: OrdinaryCounter) -> Int:
	match counter:
		OrdinaryManagedAllocations:
			0
		OrdinaryManagedReleases:
			1
		OrdinaryLiveManagedObjects:
			2
		OrdinaryManagedBytes:
			3
		OrdinaryManagedBytesAvailable:
			4
		OrdinaryAllocatorBytesInUse:
			5
		OrdinaryAllocatorBytesAvailable:
			6
		OrdinaryBackingMallocEvents:
			7
		OrdinaryRawMallocEvents:
			8
		OrdinaryRawCallocEvents:
			9
		OrdinaryRawReallocEvents:
			10
		OrdinaryRawAlignedEvents:
			11
		OrdinaryCleanupScratchEvents:
			12
		OrdinaryFiberMapEvents:
			13
		OrdinaryOracleStatsActive:
			14
		OrdinaryMemoryStatsActive:
			15


fixed union FixedCounter:
	FixedManagedAllocations
	FixedManagedReleases
	FixedLiveManagedObjects
	FixedManagedBytes
	FixedManagedBytesAvailable
	FixedAllocatorBytesInUse
	FixedAllocatorBytesAvailable
	FixedBackingMallocEvents
	FixedRawMallocEvents
	FixedRawCallocEvents
	FixedRawReallocEvents
	FixedRawAlignedEvents
	FixedCleanupScratchEvents
	FixedFiberMapEvents
	FixedOracleStatsActive
	FixedMemoryStatsActive


private pure func fixed_counter_tag(counter: FixedCounter) -> Int:
	match counter:
		FixedManagedAllocations:
			0
		FixedManagedReleases:
			1
		FixedLiveManagedObjects:
			2
		FixedManagedBytes:
			3
		FixedManagedBytesAvailable:
			4
		FixedAllocatorBytesInUse:
			5
		FixedAllocatorBytesAvailable:
			6
		FixedBackingMallocEvents:
			7
		FixedRawMallocEvents:
			8
		FixedRawCallocEvents:
			9
		FixedRawReallocEvents:
			10
		FixedRawAlignedEvents:
			11
		FixedCleanupScratchEvents:
			12
		FixedFiberMapEvents:
			13
		FixedOracleStatsActive:
			14
		FixedMemoryStatsActive:
			15


-- Local checkout-only builtin declaration; same long -> long runtime symbol
-- as memory.read_memory_counter. No managed pointer crosses the native ABI.
private pure func read_native_counter(tag: Int) -> Int:
	builtin("blorp_read_memory_counter")


-- Native counter observations are nonnegative; -1 only marks a failed repeat.
private READ_MISMATCH: Int = -1

private READ_ITERATIONS: Int = 64


private pure func canonical_repeat(counter: MemoryCounter) -> Int:
	first: Int = read_memory_counter(counter)
	second: Int = read_memory_counter(counter)

	if first == second:
		first
	else:
		READ_MISMATCH


private pure func canonical_sweep() -> Int:
	value_0: Int = canonical_repeat(ManagedAllocations)
	value_1: Int = canonical_repeat(ManagedReleases)
	value_2: Int = canonical_repeat(LiveManagedObjects)
	value_3: Int = canonical_repeat(ManagedBytes)
	value_4: Int = canonical_repeat(ManagedBytesAvailable)
	value_5: Int = canonical_repeat(AllocatorBytesInUse)
	value_6: Int = canonical_repeat(AllocatorBytesAvailable)
	value_7: Int = canonical_repeat(BackingMallocEvents)
	value_8: Int = canonical_repeat(RawMallocEvents)
	value_9: Int = canonical_repeat(RawCallocEvents)
	value_10: Int = canonical_repeat(RawReallocEvents)
	value_11: Int = canonical_repeat(RawAlignedEvents)
	value_12: Int = canonical_repeat(CleanupScratchEvents)
	value_13: Int = canonical_repeat(FiberMapEvents)
	value_14: Int = canonical_repeat(OracleStatsActive)
	value_15: Int = canonical_repeat(MemoryStatsActive)

	if (
		value_0 != READ_MISMATCH
		and value_1 != READ_MISMATCH
		and value_2 != READ_MISMATCH
		and value_3 != READ_MISMATCH
		and value_4 != READ_MISMATCH
		and value_5 != READ_MISMATCH
		and value_6 != READ_MISMATCH
		and value_7 != READ_MISMATCH
		and value_8 != READ_MISMATCH
		and value_9 != READ_MISMATCH
		and value_10 != READ_MISMATCH
		and value_11 != READ_MISMATCH
		and value_12 != READ_MISMATCH
		and value_13 != READ_MISMATCH
		and value_14 != READ_MISMATCH
		and value_15 != READ_MISMATCH
	):
		value_0 * 1 + value_1 * 2 + value_2 * 3 + value_3 * 4 + value_4 * 5 + value_5 * 6 + value_6 * 7 + value_7 * 8 + value_8 * 9 + value_9 * 10 + value_10 * 11 + value_11 * 12 + value_12 * 13 + value_13 * 14 + value_14 * 15 + value_15 * 16
	else:
		READ_MISMATCH


func test_canonical_reads_preserve_managed_and_raw_counters() -> Bool:
	reset_mem_stats()
	before_memory: Int = read_memory_counter(MemoryStatsActive)
	before_oracle: Int = read_memory_counter(OracleStatsActive)
	before_0: Int = read_memory_counter(ManagedAllocations)
	before_1: Int = read_memory_counter(ManagedReleases)
	before_7: Int = read_memory_counter(BackingMallocEvents)
	before_8: Int = read_memory_counter(RawMallocEvents)
	before_9: Int = read_memory_counter(RawCallocEvents)
	before_10: Int = read_memory_counter(RawReallocEvents)
	before_11: Int = read_memory_counter(RawAlignedEvents)
	before_12: Int = read_memory_counter(CleanupScratchEvents)
	before_13: Int = read_memory_counter(FiberMapEvents)
	var checksum: Int = 0
	var valid: Bool = True
	var iteration: Int = 0

	-- No container, report or output allocation occurs inside this interval.
	while iteration < READ_ITERATIONS:
		observed: Int = canonical_sweep()
		valid = valid and observed != READ_MISMATCH
		checksum += observed
		iteration += 1

	after_0: Int = read_memory_counter(ManagedAllocations)
	after_1: Int = read_memory_counter(ManagedReleases)
	after_7: Int = read_memory_counter(BackingMallocEvents)
	after_8: Int = read_memory_counter(RawMallocEvents)
	after_9: Int = read_memory_counter(RawCallocEvents)
	after_10: Int = read_memory_counter(RawReallocEvents)
	after_11: Int = read_memory_counter(RawAlignedEvents)
	after_12: Int = read_memory_counter(CleanupScratchEvents)
	after_13: Int = read_memory_counter(FiberMapEvents)
	after_memory: Int = read_memory_counter(MemoryStatsActive)
	after_oracle: Int = read_memory_counter(OracleStatsActive)
	print("canonical checksum: ${checksum.to_string()}")
	print("canonical managed_allocations delta: ${(after_0 - before_0).to_string()}")
	print("canonical managed_releases delta: ${(after_1 - before_1).to_string()}")
	print("canonical backing_malloc delta: ${(after_7 - before_7).to_string()}")
	print("canonical raw_malloc delta: ${(after_8 - before_8).to_string()}")
	print("canonical raw_calloc delta: ${(after_9 - before_9).to_string()}")
	print("canonical raw_realloc delta: ${(after_10 - before_10).to_string()}")
	print("canonical raw_aligned delta: ${(after_11 - before_11).to_string()}")
	print("canonical cleanup_scratch delta: ${(after_12 - before_12).to_string()}")
	print("canonical fiber_map delta: ${(after_13 - before_13).to_string()}")
	(
		before_memory == 1
		and after_memory == 1
		and before_oracle == 1
		and after_oracle == 1
		and valid
		and iteration == READ_ITERATIONS
		and checksum > 0
		and before_0 == after_0
		and before_1 == after_1
		and before_7 == after_7
		and before_8 == after_8
		and before_9 == after_9
		and before_10 == after_10
		and before_11 == after_11
		and before_12 == after_12
		and before_13 == after_13
	)


private pure func ordinary_repeat(counter: OrdinaryCounter) -> Int:
	first: Int = read_native_counter(ordinary_counter_tag(counter))
	second: Int = read_native_counter(ordinary_counter_tag(counter))

	if first == second:
		first
	else:
		READ_MISMATCH


private pure func ordinary_sweep() -> Int:
	value_0: Int = ordinary_repeat(OrdinaryManagedAllocations)
	value_1: Int = ordinary_repeat(OrdinaryManagedReleases)
	value_2: Int = ordinary_repeat(OrdinaryLiveManagedObjects)
	value_3: Int = ordinary_repeat(OrdinaryManagedBytes)
	value_4: Int = ordinary_repeat(OrdinaryManagedBytesAvailable)
	value_5: Int = ordinary_repeat(OrdinaryAllocatorBytesInUse)
	value_6: Int = ordinary_repeat(OrdinaryAllocatorBytesAvailable)
	value_7: Int = ordinary_repeat(OrdinaryBackingMallocEvents)
	value_8: Int = ordinary_repeat(OrdinaryRawMallocEvents)
	value_9: Int = ordinary_repeat(OrdinaryRawCallocEvents)
	value_10: Int = ordinary_repeat(OrdinaryRawReallocEvents)
	value_11: Int = ordinary_repeat(OrdinaryRawAlignedEvents)
	value_12: Int = ordinary_repeat(OrdinaryCleanupScratchEvents)
	value_13: Int = ordinary_repeat(OrdinaryFiberMapEvents)
	value_14: Int = ordinary_repeat(OrdinaryOracleStatsActive)
	value_15: Int = ordinary_repeat(OrdinaryMemoryStatsActive)

	if (
		value_0 != READ_MISMATCH
		and value_1 != READ_MISMATCH
		and value_2 != READ_MISMATCH
		and value_3 != READ_MISMATCH
		and value_4 != READ_MISMATCH
		and value_5 != READ_MISMATCH
		and value_6 != READ_MISMATCH
		and value_7 != READ_MISMATCH
		and value_8 != READ_MISMATCH
		and value_9 != READ_MISMATCH
		and value_10 != READ_MISMATCH
		and value_11 != READ_MISMATCH
		and value_12 != READ_MISMATCH
		and value_13 != READ_MISMATCH
		and value_14 != READ_MISMATCH
		and value_15 != READ_MISMATCH
	):
		value_0 * 1 + value_1 * 2 + value_2 * 3 + value_3 * 4 + value_4 * 5 + value_5 * 6 + value_6 * 7 + value_7 * 8 + value_8 * 9 + value_9 * 10 + value_10 * 11 + value_11 * 12 + value_12 * 13 + value_13 * 14 + value_14 * 15 + value_15 * 16
	else:
		READ_MISMATCH


func test_ordinary_reads_preserve_managed_and_raw_counters() -> Bool:
	reset_mem_stats()
	before_memory: Int = read_memory_counter(MemoryStatsActive)
	before_oracle: Int = read_memory_counter(OracleStatsActive)
	before_0: Int = read_memory_counter(ManagedAllocations)
	before_1: Int = read_memory_counter(ManagedReleases)
	before_7: Int = read_memory_counter(BackingMallocEvents)
	before_8: Int = read_memory_counter(RawMallocEvents)
	before_9: Int = read_memory_counter(RawCallocEvents)
	before_10: Int = read_memory_counter(RawReallocEvents)
	before_11: Int = read_memory_counter(RawAlignedEvents)
	before_12: Int = read_memory_counter(CleanupScratchEvents)
	before_13: Int = read_memory_counter(FiberMapEvents)
	var checksum: Int = 0
	var valid: Bool = True
	var iteration: Int = 0

	-- No container, report or output allocation occurs inside this interval.
	while iteration < READ_ITERATIONS:
		observed: Int = ordinary_sweep()
		valid = valid and observed != READ_MISMATCH
		checksum += observed
		iteration += 1

	after_0: Int = read_memory_counter(ManagedAllocations)
	after_1: Int = read_memory_counter(ManagedReleases)
	after_7: Int = read_memory_counter(BackingMallocEvents)
	after_8: Int = read_memory_counter(RawMallocEvents)
	after_9: Int = read_memory_counter(RawCallocEvents)
	after_10: Int = read_memory_counter(RawReallocEvents)
	after_11: Int = read_memory_counter(RawAlignedEvents)
