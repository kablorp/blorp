import:
	test: TestSuite


private pure func copy_values(values: List[Int]) -> List[Int]:
	var copied: List[Int] = []

	for value in values:
		copied = copied.append(value)

	copied


private pure func copy_projected_values(values: List[List[Int]]) -> List[List[Int]]:
	var copied: List[List[Int]] = []
	var index: Int = 0

	for _ in values:
		copied = copied.append(copy_values(values.get_or(index, [])))
		index += 1

	copied


pure func test_retained_projection_passed_to_borrowed_helper() -> Bool:
	result = copy_projected_values(
		[
			[1, 2],
			[3],
		],
	)

	(
		result.length() == 2
		and result
			.get_or(0, [])
			.get_or(0, 0) == 1
		and result
			.get_or(0, [])
			.get_or(1, 0) == 2
		and result
			.get_or(1, [])
			.get_or(0, 0) == 3
	)


tests: TestSuite = {
	description = "Retained list projection ownership",
	tests = [
		(
			"retained projection passed to borrowed helper",
			test_retained_projection_passed_to_borrowed_helper,
		),
	]
}
