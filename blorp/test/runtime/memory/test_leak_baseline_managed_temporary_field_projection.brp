import:
	test: TestSuite


record Token {
	kind: String
}


private pure func make_token() -> Token:
	{kind = "identifier"}


func test_managed_temporary_field_projection() -> Bool:
	kind: String = make_token().kind

	kind == "identifier"


tests: TestSuite = {
	description = "Managed Temporary Field Projection",
	tests = [("managed temporary field projection", test_managed_temporary_field_projection)]
}
