import:
	string: string
	test: TestSuite


pure func build_unique(parts: List[String]) -> String:
	var result: String = ""

	for part in parts:
		result += part

	result


func test_string_accumulator_cow() -> Bool:
	unique: String = build_unique(["a", "b", "c"])

	var shared: String = string(8)
	shared += "left"
	saved: String = shared
	shared += " right"

	var self_appended: String = "xy"
	self_appended += self_appended

	unique == "abc" and saved == "left" and shared == "left right" and self_appended == "xyxy"


tests: TestSuite = {
	description = "String Accumulator COW",
	tests = [("string accumulator cow", test_string_accumulator_cow)]
}
