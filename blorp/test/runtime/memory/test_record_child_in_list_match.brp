import:
	test: TestSuite


record Tree {
	kind: TreeKind
}


union TreeKind:
	Leaf(Int)
	Branch(Tree)


private pure func completed(state: Int, kind: TreeKind) -> (Int, Tree):
	(state + 1, { kind = kind })


-- The old value becomes a child before its mutable slot is replaced. The
-- list-pattern branch must preserve that child's owner through the hand-off.
private pure func grown(initial: Tree, rounds: Int, dimensions: List[Int]) -> Tree:
	var current: Tree = initial
	var state: Int = 0
	var index: Int = 0

	while index < rounds:
		match dimensions:
			[_, ..._]:
				(next, tree) = completed(state, Branch(current))
				state = next
				current = tree
			_:
				void

		index += 1

	current


private pure func depth(tree: Tree) -> Int:
	match tree.kind:
		Leaf(value):
			value
		Branch(child):
			1 + depth(child)


pure func test_list_match_preserves_child_after_record_reassignment() -> Bool:
	initial: Tree = { kind = Leaf(7) }
	result: Tree = grown(initial, 3, [1])
	depth(result) == 10 and depth(initial) == 7


pure func test_empty_list_match_preserves_the_original_record() -> Bool:
	initial: Tree = { kind = Leaf(7) }
	result: Tree = grown(initial, 3, [])
	depth(result) == 7 and depth(initial) == 7


tests: TestSuite = {
	description = "Record child ownership in a list match",
	tests = [
		("list match preserves child after record reassignment", test_list_match_preserves_child_after_record_reassignment),
		("empty list match preserves the original record", test_empty_list_match_preserves_the_original_record)
	]
}
