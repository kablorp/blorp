import:
	memory: MemStats, get_mem_stats, is_unique, refcount, reset_mem_stats, size_of
	test: TestSuite


record TinyBox {
	value: Int
}


record PairBox {
	left: Int,
	right: Int
}


func test_stats_snapshot_does_not_count_itself() -> Bool:
	reset_mem_stats()
	stats: MemStats = get_mem_stats()
	stats.current_objects == 0 and stats.bytes_allocated == 0


func test_stats_snapshot_has_value_semantics() -> Bool:
	stats: MemStats = get_mem_stats()
	refcount(stats) == 0


func test_string_literals_are_static_program_data() -> Bool:
	reset_mem_stats()
	label: String = "literal accounting"
	stats: MemStats = get_mem_stats()

	(
		label.length() == 18
		and stats.total_allocations == 0
		and stats.current_objects == 0
		and stats.bytes_allocated == 0
		and not is_unique(label)
		and refcount(label) > 1
	)


func test_string_literal_size_matches_dynamic_string_header() -> Bool:
	literal_size: Int = size_of("literal")
	dynamic: String = to_string(7)
	literal_size == size_of(dynamic)


func test_reset_ignores_releases_from_previous_epoch() -> Bool:
	reset_mem_stats()
	var old: Option[String] = Some(to_string(12345))
	reset_mem_stats()
	old = None
	stats: MemStats = get_mem_stats()
	counts_reset: Bool = stats.total_allocations == 0 and stats.total_releases == 0
	live_reset: Bool = stats.current_objects == 0 and stats.bytes_allocated == 0
	old.is_none() and counts_reset and live_reset


func test_small_dynamic_string_uses_compact_header() -> Bool:
	reset_mem_stats()
	s: String = to_string(7)
	stats: MemStats = get_mem_stats()
	s.length() == 1 and stats.current_objects == 1 and stats.bytes_allocated <= 80


func test_small_record_uses_pool_minimum_class() -> Bool:
	reset_mem_stats()
	box: TinyBox = {value = 7}
	stats: MemStats = get_mem_stats()
	box.value == 7 and stats.current_objects == 1 and stats.bytes_allocated <= 32


func test_two_int_record_still_uses_pool_minimum_class() -> Bool:
	reset_mem_stats()
	box: PairBox = {
		left = 7,
		right = 11
	}
	stats: MemStats = get_mem_stats()
	box.left + box.right == 18 and stats.current_objects == 1 and stats.bytes_allocated <= 32


tests: TestSuite = {
	description = "MemStats Observability",
	tests = [
		("stats snapshot does not count itself", test_stats_snapshot_does_not_count_itself),
		("stats snapshot has value semantics", test_stats_snapshot_has_value_semantics),
		("string literals are static program data", test_string_literals_are_static_program_data),
		(
			"string literal size matches dynamic string header",
			test_string_literal_size_matches_dynamic_string_header,
		),
		(
			"reset ignores releases from previous epoch",
			test_reset_ignores_releases_from_previous_epoch,
		),
		("small dynamic string uses compact header", test_small_dynamic_string_uses_compact_header),
		("small record uses pool minimum class", test_small_record_uses_pool_minimum_class),
		(
			"two-int record still uses pool minimum class",
			test_two_int_record_still_uses_pool_minimum_class,
		),
	]
}
