import:
	memory: MemStats, get_mem_stats, reset_mem_stats
	test: TestSuite


record CallbackBox {
	callback: Option[pure (Int) -> Int],
	marker: Int
}


pure func invoke(box: CallbackBox) -> Int:
	match box.callback:
		Some(run): run(40)
		None: 0


func invoke_scoped_optional_closure() -> Int:
	captured: String = 37.to_string()
	callback: pure (Int) -> Int = func(value): value + captured.length()
	box: CallbackBox = { callback = Some(callback), marker = 0 }
	invoke(box)


func invoke_scoped_copied_optional_closure() -> Int:
	captured: String = 37.to_string()
	callback: pure (Int) -> Int = func(value): value + captured.length()
	box: CallbackBox = { callback = Some(callback), marker = 0 }
	copied: CallbackBox = { box | marker = 1 }
	invoke(box) + invoke(copied) + copied.marker


func invoke_scoped_scalar_optional_closure(captured: Int) -> Int:
	callback: pure (Int) -> Int = func(value): value + captured
	box: CallbackBox = { callback = Some(callback), marker = 0 }
	invoke(box)


func invoke_scoped_empty_optional_closure() -> Int:
	box: CallbackBox = { callback = None, marker = 0 }
	invoke(box)


pure func all_allocations_released(stats: MemStats) -> Bool:
	stats.memory_stats_active == 1 and stats.total_allocations > 0 and stats.current_objects == 0 and stats.total_allocations == stats.total_releases


func test_record_releases_optional_closure_and_capture() -> Bool:
	reset_mem_stats()
	value: Int = invoke_scoped_optional_closure()
	stats: MemStats = get_mem_stats()
	value == 42 and all_allocations_released(stats)


func test_copied_record_releases_shared_optional_closure() -> Bool:
	reset_mem_stats()
	value: Int = invoke_scoped_copied_optional_closure()
	stats: MemStats = get_mem_stats()
	value == 85 and all_allocations_released(stats)


func test_record_releases_optional_scalar_closure() -> Bool:
	reset_mem_stats()
	value: Int = invoke_scoped_scalar_optional_closure(2)
	stats: MemStats = get_mem_stats()
	value == 42 and all_allocations_released(stats)


func test_record_releases_empty_optional_closure() -> Bool:
	reset_mem_stats()
	value: Int = invoke_scoped_empty_optional_closure()
	stats: MemStats = get_mem_stats()
	value == 0 and all_allocations_released(stats)


tests: TestSuite = {
	description = "Optional Closure Record Release",
	tests = [
		("record releases optional closure and its managed capture", test_record_releases_optional_closure_and_capture),
		("copied record retains and releases shared optional closure", test_copied_record_releases_shared_optional_closure),
		("record releases optional closure with scalar capture", test_record_releases_optional_scalar_closure),
		("record with absent optional closure releases safely", test_record_releases_empty_optional_closure),
	]
}
