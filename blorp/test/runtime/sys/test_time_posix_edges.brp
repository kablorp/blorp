import:
	test: TestSuite
	time:
		from_iso,
		from_unix_millis,
		from_unix_seconds,
		to_iso,
		to_unix_millis,
		to_unix_seconds,
		try_from_parts,


func test_negative_subsecond_formats_before_epoch() -> Bool:
	to_iso(-1) == "1969-12-31T23:59:59Z"


func test_negative_subsecond_unix_seconds_floor() -> Bool:
	to_unix_seconds(-1) == -1


func test_negative_exact_second_unix_seconds() -> Bool:
	to_unix_seconds(-1000000) == -1


func test_negative_past_exact_second_unix_seconds_floor() -> Bool:
	to_unix_seconds(-1000001) == -2


func test_negative_subsecond_unix_millis_floor() -> Bool:
	to_unix_millis(-1) == -1


func test_negative_exact_millis() -> Bool:
	to_unix_millis(-1000) == -1


func test_negative_past_exact_millis_floor() -> Bool:
	to_unix_millis(-1001) == -2


func test_from_unix_seconds_negative() -> Bool:
	from_unix_seconds(-1) == -1000000


func test_from_unix_millis_negative() -> Bool:
	from_unix_millis(-1) == -1000


func test_from_iso_accepts_pre_epoch_fraction() -> Bool:
	match from_iso("1969-12-31T23:59:59.999999Z"):
		Some(value): value == -1
		None: False


func test_try_from_parts_rejects_invalid_day() -> Bool:
	match try_from_parts(2024, 2, 31, 0, 0, 0):
		None: True
		Some(_): False


func test_try_from_parts_accepts_leap_day() -> Bool:
	match try_from_parts(2024, 2, 29, 0, 0, 0):
		Some(value): to_iso(value) == "2024-02-29T00:00:00Z"
		None: False


func test_try_from_parts_rejects_non_leap_day() -> Bool:
	match try_from_parts(2023, 2, 29, 0, 0, 0):
		None: True
		Some(_): False


func test_from_iso_accepts_date_only_as_calendar_date() -> Bool:
	match from_iso("2024-06-01"):
		Some(value): to_iso(value) == "2024-06-01T00:00:00Z"
		None: False


tests: TestSuite = {
	description = "Time POSIX edge cases",
	tests = [
		("negative subsecond formats before epoch", test_negative_subsecond_formats_before_epoch),
		("negative subsecond unix seconds floor", test_negative_subsecond_unix_seconds_floor),
		("negative exact second unix seconds", test_negative_exact_second_unix_seconds),
		(
			"negative past exact second unix seconds floor",
			test_negative_past_exact_second_unix_seconds_floor,
		),
		("negative subsecond unix millis floor", test_negative_subsecond_unix_millis_floor),
		("negative exact millis", test_negative_exact_millis),
		("negative past exact millis floor", test_negative_past_exact_millis_floor),
		("from unix seconds negative", test_from_unix_seconds_negative),
		("from unix millis negative", test_from_unix_millis_negative),
		("from_iso accepts pre epoch fraction", test_from_iso_accepts_pre_epoch_fraction),
		("try_from_parts rejects invalid day", test_try_from_parts_rejects_invalid_day),
		("try_from_parts accepts leap day", test_try_from_parts_accepts_leap_day),
		("try_from_parts rejects non-leap day", test_try_from_parts_rejects_non_leap_day),
		(
			"from_iso accepts date only as calendar date",
			test_from_iso_accepts_date_only_as_calendar_date,
		),
	]
}
