import:
	test: TestSuite
	time:
		days,
		from_iso,
		from_parts,
		from_unix_millis,
		from_unix_seconds,
		start_of_day,
		start_of_month,
		start_of_year,
		to_day,
		to_hour,
		to_iso,
		to_minute,
		to_month,
		to_second,
		to_unix_millis,
		to_unix_seconds,
		to_year,
		weekday_name,
		weeks,


-- ===== Duration constructors =====
func test_days() -> Bool:
	days(1) == 86400000000


func test_days_7() -> Bool:
	days(7) == 604800000000


func test_weeks() -> Bool:
	weeks(1) == days(7)


func test_weeks_2() -> Bool:
	weeks(2) == days(14)


-- ===== Unix timestamp interop =====
func test_to_unix_seconds() -> Bool:
	t: Int = from_parts(2024, 1, 1, 0, 0, 0)
	to_unix_seconds(t) == 1704067200


func test_from_unix_seconds() -> Bool:
	t: Int = from_unix_seconds(1704067200)
	to_year(t) == 2024 and to_month(t) == 1 and to_day(t) == 1


func test_unix_seconds_roundtrip() -> Bool:
	t: Int = from_parts(2026, 6, 15, 12, 30, 45)
	from_unix_seconds(to_unix_seconds(t)) == t


func test_to_unix_millis() -> Bool:
	t: Int = from_parts(2024, 1, 1, 0, 0, 0)
	to_unix_millis(t) == 1704067200000


func test_from_unix_millis() -> Bool:
	t: Int = from_unix_millis(1704067200000)
	to_year(t) == 2024 and to_month(t) == 1 and to_day(t) == 1


func test_unix_millis_roundtrip() -> Bool:
	t: Int = from_parts(2026, 3, 22, 8, 15, 30)
	from_unix_millis(to_unix_millis(t)) == t


-- ===== ISO 8601 parsing =====
func test_from_iso_basic() -> Bool:
	match from_iso("2024-01-15T10:30:00Z"):
		Some(t):
			to_year(
				t,
			) == 2024 and to_month(
				t,
			) == 1 and to_day(
				t,
			) == 15 and to_hour(t) == 10 and to_minute(t) == 30 and to_second(t) == 0
		None: False


func test_from_iso_date_only() -> Bool:
	match from_iso("2024-06-01"):
		Some(t):
			to_year(
				t,
			) == 2024 and to_month(
				t,
			) == 6 and to_day(t) == 1 and to_hour(t) == 0 and to_minute(t) == 0
		None: False


func test_from_iso_positive_offset() -> Bool:
	-- 2024-01-15T10:30:00+05:30 should be 05:00 UTC
	match from_iso("2024-01-15T10:30:00+05:30"):
		Some(t):
			to_hour(t) == 5 and to_minute(t) == 0
		None: False


func test_from_iso_negative_offset() -> Bool:
	-- 2024-01-15T10:30:00-05:00 should be 15:30 UTC
	match from_iso("2024-01-15T10:30:00-05:00"):
		Some(t):
			to_hour(t) == 15 and to_minute(t) == 30
		None: False


func test_from_iso_fractional_seconds() -> Bool:
	match from_iso("2024-01-15T10:30:00.123456Z"):
		Some(t):
			to_hour(t) == 10 and to_minute(t) == 30 and to_second(t) == 0
		None: False


func test_from_iso_invalid() -> Bool:
	match from_iso("not-a-date"):
		Some(_): False
		None: True


func test_from_iso_invalid_month() -> Bool:
	match from_iso("2024-13-01T00:00:00Z"):
		Some(_): False
		None: True


func test_from_iso_empty() -> Bool:
	match from_iso(""):
		Some(_): False
		None: True


func test_from_iso_roundtrip() -> Bool:
	-- to_iso produces "2024-01-15T10:30:00Z", from_iso should parse it back
	t1: Int = from_parts(2024, 1, 15, 10, 30, 0)
	iso_str: String = to_iso(t1)
	match from_iso(iso_str):
		Some(t2): t1 == t2
		None: False


-- ===== Truncation functions =====
func test_start_of_day() -> Bool:
	t: Int = from_parts(2024, 3, 15, 14, 30, 45)
	s: Int = start_of_day(t)
	to_year(
		s,
	) == 2024 and to_month(
		s,
	) == 3 and to_day(s) == 15 and to_hour(s) == 0 and to_minute(s) == 0 and to_second(s) == 0


func test_start_of_day_already_midnight() -> Bool:
	t: Int = from_parts(2024, 3, 15, 0, 0, 0)
	start_of_day(t) == t


func test_start_of_month() -> Bool:
	t: Int = from_parts(2024, 7, 22, 14, 30, 45)
	s: Int = start_of_month(t)
	to_year(
		s,
	) == 2024 and to_month(s) == 7 and to_day(s) == 1 and to_hour(s) == 0 and to_minute(s) == 0


func test_start_of_month_first_day() -> Bool:
	t: Int = from_parts(2024, 7, 1, 0, 0, 0)
	start_of_month(t) == t


func test_start_of_year() -> Bool:
	t: Int = from_parts(2024, 11, 22, 14, 30, 45)
	s: Int = start_of_year(t)
	to_year(
		s,
	) == 2024 and to_month(s) == 1 and to_day(s) == 1 and to_hour(s) == 0 and to_minute(s) == 0


func test_start_of_year_jan1() -> Bool:
	t: Int = from_parts(2024, 1, 1, 0, 0, 0)
	start_of_year(t) == t


-- ===== Weekday name =====
func test_weekday_name_sunday() -> Bool:
	-- 2024-01-07 is a Sunday
	t: Int = from_parts(2024, 1, 7, 0, 0, 0)
	weekday_name(t) == "Sunday"


func test_weekday_name_monday() -> Bool:
	-- 2024-01-08 is a Monday
	t: Int = from_parts(2024, 1, 8, 0, 0, 0)
	weekday_name(t) == "Monday"


func test_weekday_name_saturday() -> Bool:
	-- 2024-01-06 is a Saturday
	t: Int = from_parts(2024, 1, 6, 0, 0, 0)
	weekday_name(t) == "Saturday"


-- ===== Arithmetic with new duration constructors =====
func test_add_days() -> Bool:
	t: Int = from_parts(2024, 1, 1, 0, 0, 0)
	t2: Int = t + days(1)
	to_day(t2) == 2


func test_add_weeks() -> Bool:
	t: Int = from_parts(2024, 1, 1, 0, 0, 0)
	t2: Int = t + weeks(1)
	to_day(t2) == 8


func test_subtract_days() -> Bool:
	t: Int = from_parts(2024, 1, 15, 0, 0, 0)
	t2: Int = t - days(10)
	to_day(t2) == 5


func test_days_across_month() -> Bool:
	t: Int = from_parts(2024, 1, 30, 0, 0, 0)
	t2: Int = t + days(5)
	to_month(t2) == 2 and to_day(t2) == 4


func test_days_across_year() -> Bool:
	t: Int = from_parts(2024, 12, 30, 0, 0, 0)
	t2: Int = t + days(5)
	to_year(t2) == 2025 and to_month(t2) == 1 and to_day(t2) == 4


tests: TestSuite = {
	description = "Time Extensions",
	tests = [
		("days duration", test_days),
		("days 7", test_days_7),
		("weeks duration", test_weeks),
		("weeks 2", test_weeks_2),
		("to unix seconds", test_to_unix_seconds),
		("from unix seconds", test_from_unix_seconds),
		("unix seconds roundtrip", test_unix_seconds_roundtrip),
		("to unix millis", test_to_unix_millis),
		("from unix millis", test_from_unix_millis),
		("unix millis roundtrip", test_unix_millis_roundtrip),
		("from_iso basic", test_from_iso_basic),
		("from_iso date only", test_from_iso_date_only),
		("from_iso positive offset", test_from_iso_positive_offset),
		("from_iso negative offset", test_from_iso_negative_offset),
		("from_iso fractional seconds", test_from_iso_fractional_seconds),
		("from_iso invalid", test_from_iso_invalid),
		("from_iso invalid month", test_from_iso_invalid_month),
		("from_iso empty", test_from_iso_empty),
		("from_iso roundtrip", test_from_iso_roundtrip),
		("start_of_day", test_start_of_day),
		("start_of_day midnight", test_start_of_day_already_midnight),
		("start_of_month", test_start_of_month),
		("start_of_month first", test_start_of_month_first_day),
		("start_of_year", test_start_of_year),
		("start_of_year jan1", test_start_of_year_jan1),
		("weekday Sunday", test_weekday_name_sunday),
		("weekday Monday", test_weekday_name_monday),
		("weekday Saturday", test_weekday_name_saturday),
		("add days", test_add_days),
		("add weeks", test_add_weeks),
		("subtract days", test_subtract_days),
		("days across month", test_days_across_month),
		("days across year", test_days_across_year),
	]
}
