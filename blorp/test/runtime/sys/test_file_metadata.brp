import:
	fs: IOError(InvalidInput, NotFound), walk_files
	system:
		exec,
		file_exists,
		file_modified,
		file_size,
		mkdir,
		mkstemp_path,
		remove_dir,
		remove_file,
		temp_dir,
		write_file,
	test: TestSuite


-- file_size tests
func test_file_size() -> Bool:
	_ = write_file("/tmp/__blorp_test_fsize", "hello")
	r: Result[Int, String] = file_size("/tmp/__blorp_test_fsize")
	_ = remove_file("/tmp/__blorp_test_fsize")

	match r:
		Ok(n):
			n == 5
		Err(_):
			False


func test_file_size_empty() -> Bool:
	_ = write_file("/tmp/__blorp_test_fsize_e", "")
	r: Result[Int, String] = file_size("/tmp/__blorp_test_fsize_e")
	_ = remove_file("/tmp/__blorp_test_fsize_e")

	match r:
		Ok(n):
			n == 0
		Err(_):
			False


func test_file_size_missing() -> Bool:
	r: Result[Int, String] = file_size("/tmp/__blorp_nonexistent_xyz")

	match r:
		Ok(_):
			False
		Err(_):
			True


-- file_modified tests
func test_file_modified() -> Bool:
	_ = write_file("/tmp/__blorp_test_fmod", "data")
	r: Result[Int, String] = file_modified("/tmp/__blorp_test_fmod")
	_ = remove_file("/tmp/__blorp_test_fmod")

	match r:
		Ok(t):
			t > 1000000000
		Err(_):
			False


func test_file_modified_missing() -> Bool:
	r: Result[Int, String] = file_modified("/tmp/__blorp_nonexistent_xyz")

	match r:
		Ok(_):
			False
		Err(_):
			True


-- temp_dir tests
func test_temp_dir() -> Bool:
	temp_dir().length() > 0


-- mkstemp tests
func test_mkstemp() -> Bool:
	r: Result[String, String] = mkstemp_path("blorp_test_")

	match r:
		Ok(path):
			exists: Bool = file_exists(path)
			_ = remove_file(path)
			exists
		Err(_):
			False


-- walk_files tests
func test_walk_files() -> Bool:
	_ = mkdir("/tmp/__blorp_test_walk")
	_ = write_file("/tmp/__blorp_test_walk/a.txt", "a")
	_ = write_file("/tmp/__blorp_test_walk/b.txt", "b")

	result: Bool = match walk_files("/tmp/__blorp_test_walk"):
		Ok(paths):
			paths == ["/tmp/__blorp_test_walk/a.txt", "/tmp/__blorp_test_walk/b.txt"]
		Err(_):
			False

	_ = remove_file("/tmp/__blorp_test_walk/a.txt")
	_ = remove_file("/tmp/__blorp_test_walk/b.txt")
	_ = remove_dir("/tmp/__blorp_test_walk")
	result


func test_walk_files_empty() -> Bool:
	_ = mkdir("/tmp/__blorp_test_walk_e")

	result: Bool = match walk_files("/tmp/__blorp_test_walk_e"):
		Ok(paths):
			paths.length() == 0
		Err(_):
			False

	_ = remove_dir("/tmp/__blorp_test_walk_e")
	result


func test_walk_files_nested() -> Bool:
	_ = mkdir("/tmp/__blorp_test_walk_n")
	_ = mkdir("/tmp/__blorp_test_walk_n/sub")
	_ = write_file("/tmp/__blorp_test_walk_n/top.txt", "t")
	_ = write_file("/tmp/__blorp_test_walk_n/sub/deep.txt", "d")

	result: Bool = match walk_files("/tmp/__blorp_test_walk_n"):
		Ok(paths):
			paths == ["/tmp/__blorp_test_walk_n/sub/deep.txt", "/tmp/__blorp_test_walk_n/top.txt"]
		Err(_):
			False

	_ = remove_file("/tmp/__blorp_test_walk_n/top.txt")
	_ = remove_file("/tmp/__blorp_test_walk_n/sub/deep.txt")
	_ = remove_dir("/tmp/__blorp_test_walk_n/sub")
	_ = remove_dir("/tmp/__blorp_test_walk_n")
	result


func test_walk_files_missing_root() -> Bool:
	path: String = "/tmp/__blorp_test_walk_missing"

	match walk_files(path):
		Err(NotFound(missing_path)):
			missing_path == path
		_:
			False


func test_walk_files_rejects_symlink_root() -> Bool:
	target: String = "/tmp/__blorp_test_walk_symlink_root_target"
	link_path: String = "/tmp/__blorp_test_walk_symlink_root"
	_ = exec("rm -rf " + target + " " + link_path)
	_ = mkdir(target)
	_ = write_file(target + "/file.txt", "data")
	link_created: Bool = exec("ln -s " + target + " " + link_path) == 0

	result: Bool = if not link_created:
		False
	else:
		match walk_files(link_path):
			Err(InvalidInput(detail)):
				if not detail.contains("symbolic link"):
					False
				else:
					match walk_files(link_path + "/"):
						Err(InvalidInput(trailing_detail)):
							trailing_detail.contains("symbolic link")
						_:
							False
			_:
				False

	_ = exec("rm -rf " + target + " " + link_path)
	result


func test_walk_files_skips_symlinked_directory() -> Bool:
	root: String = "/tmp/__blorp_test_walk_symlink"
	target: String = root + "/target"
	link_path: String = root + "/alias"
	_ = exec("rm -rf " + root)
	_ = mkdir(root)
	_ = mkdir(target)
	_ = write_file(target + "/file.txt", "data")
	link_created: Bool = exec("ln -s target " + link_path) == 0

	result: Bool = if not link_created:
		False
	else:
		match walk_files(root):
			Ok(paths):
				paths == [target + "/file.txt"]
			Err(_):
				False

	_ = exec("rm -rf " + root)
	result


tests: TestSuite = {
	description = "File Metadata",
	tests = [
		("file size", test_file_size),
		("file size empty", test_file_size_empty),
		("file size missing", test_file_size_missing),
		("file modified", test_file_modified),
		("file modified missing", test_file_modified_missing),
		("temp dir", test_temp_dir),
		("mkstemp", test_mkstemp),
		("walk files", test_walk_files),
		("walk files empty", test_walk_files_empty),
		("walk files nested", test_walk_files_nested),
		("walk files missing root", test_walk_files_missing_root),
		("walk files rejects symlink root", test_walk_files_rejects_symlink_root),
		("walk files skips symlinked directory", test_walk_files_skips_symlinked_directory),
	]
}
