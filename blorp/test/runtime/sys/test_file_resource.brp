				None:
					False

			third_ok: Bool = match bytes.get(2):
				Some(byte):
					to_int(byte) == 99
				None:
					False

			bytes.length() == 3 and first_ok and third_ok
		Err(_):
			False

	_ = remove_file(path)
	ok


