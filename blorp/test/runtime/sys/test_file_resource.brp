func test_collect_chunks_inside_with() -> Bool:
	path: String = "/tmp/__blorp_file_resource_chunks"
	_ = write_file(path, "abcdefghijklmnopqrstuvwxyz")

	ok: Bool = match collect_chunks_with_handle(path):
		Ok(parts):
			combined: Bytes = B.concat(parts)
			B.to_string(combined) == "abcdefghijklmnopqrstuvwxyz"
		Err(_):
			False

	_ = remove_file(path)
	ok


func test_collect_chunks_large_file() -> Bool:
	path: String = "/tmp/__blorp_file_resource_chunks_large"
	data: Bytes = B
		.bytes(70000)
		.fill(65)

	wrote: Bool = match write_bytes_with_handle(path, data):
		Ok(_):
			True
		Err(_):
			False

	ok: Bool = if wrote:
		match collect_chunks_with_handle(path):
			Ok(parts):
				if parts.length() > 1:
					combined: Bytes = B.concat(parts)
					combined.length() == 70000
				else:
					False
			Err(_):
				False
	else:
		False

	_ = remove_file(path)
	ok


