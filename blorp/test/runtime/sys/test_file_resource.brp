			is_invalid_input_error(err)
		_:
			False

	any_ok: Bool = match any_chunk_matches(path, 0, "abcd"):
		Err(err):
			is_invalid_input_error(err)
		_:
			False

	all_ok: Bool = match all_chunks_non_empty(path, 0):
		Err(err):
			is_invalid_input_error(err)
		_:
			False

	fold_ok: Bool = match total_chunk_bytes(path, 0):
		Err(err):
			is_invalid_input_error(err)
		_:
			False

	_ = remove_file(path)
	count_ok and any_ok and all_ok and fold_ok


func test_fallible_stream_find_result() -> Bool:
	path: String = "/tmp/__blorp_file_resource_stream_find"
	_ = write_file(path, "abcdefghij")

	found_ok: Bool = match find_chunk_bytes(path, 4, "efgh"):
		Ok(Some(chunk)):
			B.to_string(chunk) == "efgh"
		_:
			False

	missing_ok: Bool = match find_chunk_bytes(path, 4, "zzzz"):
		Ok(None):
			True
		_:
			False

	error_ok: Bool = match find_chunk_bytes(path, 0, "abcd"):
		Err(err):
			is_invalid_input_error(err)
		_:
			False

	_ = remove_file(path)
	found_ok and missing_ok and error_ok


func test_file_lines_stream() -> Bool:
	path: String = "/tmp/__blorp_file_resource_lines"
	long_line: Bytes = B
		.bytes(70000)
		.fill(97)
	_ = write_bytes_with_handle(path, long_line)
	_ = append_file(path, "\ntail\r\nlast\n")

	ok: Bool = match collect_file_lines(path):
		Ok(lines):
			first_ok: Bool = match lines.get(0):
				Some(line):
					line.length() == 70000
				None:
					False

			second_ok: Bool = match lines.get(1):
				Some(line):
					line == "tail"
				None:
					False

			third_ok: Bool = match lines.get(2):
				Some(line):
					line == "last"
				None:
					False

			lines.length() == 3 and first_ok and second_ok and third_ok
		Err(_):
			False

	_ = remove_file(path)
	ok


func test_file_lines_find_result() -> Bool:
	path: String = "/tmp/__blorp_file_resource_lines_find"
	_ = write_file(path, "alpha\nbeta\ngamma\n")

	found_ok: Bool = match find_line(path, "beta"):
		Ok(Some(line)):
			line == "beta"
		_:
			False

	missing_ok: Bool = match find_line(path, "delta"):
		Ok(None):
			True
		_:
			False

	_ = remove_file(path)
	found_ok and missing_ok


func test_file_count_lines() -> Bool:
	empty: String = "/tmp/__blorp_file_resource_count_empty"
	no_trailing: String = "/tmp/__blorp_file_resource_count_notrail"
	trailing: String = "/tmp/__blorp_file_resource_count_trailing"
	large: String = "/tmp/__blorp_file_resource_count_large"
	_ = write_file(empty, "")
	_ = write_file(no_trailing, "one\ntwo")
	_ = write_file(trailing, "one\ntwo\n")
	large_content: Bytes = B
		.bytes(70000)
		.fill(120)
	_ = write_bytes_with_handle(large, large_content)
	_ = append_file(large, "\ny\nz")

	empty_ok: Bool = match count_file_lines(empty):
		Ok(n):
			n == 0
		Err(_):
			False

	no_trailing_ok: Bool = match count_file_lines(no_trailing):
		Ok(n):
			n == 2
		Err(_):
			False

	trailing_ok: Bool = match count_file_lines(trailing):
		Ok(n):
			n == 2
		Err(_):
			False

	large_ok: Bool = match count_file_lines(large):
		Ok(n):
			n == 3
		Err(_):
			False

	_ = remove_file(empty)
	_ = remove_file(no_trailing)
	_ = remove_file(trailing)
	_ = remove_file(large)
	empty_ok and no_trailing_ok and trailing_ok and large_ok


