func test_with_body_question_bind_returns_error() -> Bool:
	path: String = "/tmp/__blorp_file_resource_body_qb"
	_ = write_file(path, "hello")

	ok: Bool = match open_then_short_circuit(path):
		Err(NotFound(p)):
			p == path
		_:
			False

	_ = remove_file(path)
	ok


func test_body_question_bind_cleans_up_reader() -> Bool:
	path: String = "/tmp/__blorp_file_resource_body_qb_cleanup"
	_ = write_file(path, "hello")
	before: Int = open_fd_count()
	var ok: Bool = True
	var i: Int = 0

	while i < 20 and ok:
		ok = match open_then_short_circuit(path):
			Err(NotFound(p)):
				p == path
			_:
				False

		i += 1

	after: Int = open_fd_count()
	_ = remove_file(path)

	if before == 0 or after == 0:
		ok
	else:
		ok and after <= before + 3


func test_loop_break_continue_clean_up_reader() -> Bool:
	path: String = "/tmp/__blorp_file_resource_loop_cleanup"
	_ = write_file(path, "hello")
	before: Int = open_fd_count()
	var ok: Bool = True
	var i: Int = 0

	while i < 20 and ok:
		break_ok: Bool = match break_inside_resource_body(path):
			Ok(total):
				total == 1
			Err(_):
				False

		continue_ok: Bool = match continue_inside_resource_body(path):
			Ok(total):
				total == 4
			Err(_):
				False

		ok = break_ok and continue_ok
		i += 1

	after: Int = open_fd_count()
	_ = remove_file(path)

	if before == 0 or after == 0:
		ok
	else:
		ok and after <= before + 3


func test_timeout_cleans_up_open_reader() -> Bool:
	path: String = "/tmp/__blorp_file_resource_timeout_cleanup"
	_ = write_file(path, "hello")
	before: Int = open_fd_count()
	var ok: Bool = True
	var i: Int = 0

	while i < 20 and ok:
		ok = run_cancelled_open_read(path)
		i += 1

	sleep(20)
	after: Int = open_fd_count()
	_ = remove_file(path)

	if before == 0 or after == 0:
		ok
	else:
		ok and after <= before + 3


tests: TestSuite = {
	description = "typed file resources",
	tests = [
		("open_read missing returns NotFound", test_open_read_missing_not_found),
		("with acquisition maps error", test_with_acquisition_maps_error),
		("open_read existing closes", test_open_read_existing_closes),
		("normal with cleans up file handles", test_normal_with_cleans_up_file_handles),
		("open_write creates and truncates", test_open_write_creates_and_truncates),
		("open_append creates and preserves", test_open_append_creates_and_preserves),
		("file appender append operations", test_file_appender_append_operations),
		("open_read_write existing only", test_open_read_write_existing_only),
		("open_read_append existing only", test_open_read_append_existing_only),
		(
			"read-append handle bytes and chunk append",
			test_read_append_handle_bytes_and_chunk_append,
		),
		(
			"read-append handle appends after partial read",
			test_read_append_handle_appends_after_partial_read,
		),
		("read-write handle reads text", test_read_write_handle_reads_text),
		(
			"read-write handle writes text at current offset",
			test_read_write_handle_writes_text_at_current_offset,
		),
		("read-write handle bytes and chunk", test_read_write_handle_bytes_and_chunk),
		(
			"read-write handle read chunk and count lines",
			test_read_write_handle_read_chunk_and_count_lines,
		),
		("read-write handle size and read_chunk_at", test_read_write_handle_size_and_read_chunk_at),
		("read_chunk_at does not advance offset", test_read_chunk_at_does_not_advance_offset),
		("write_text then read_text", test_write_then_read_text),
		("write_bytes then read_bytes", test_write_then_read_bytes),
		("write_chunk returns count", test_write_chunk_returns_count),
		("write_chunk empty returns zero", test_write_chunk_empty_returns_zero),
		("read_chunk advances reader", test_read_chunk_advances_reader),
		("read_chunk EOF is empty", test_read_chunk_eof_is_empty),
		("read_chunk invalid size", test_read_chunk_invalid_size),
		("collect chunks inside with", test_collect_chunks_inside_with),
		("collect chunks large file", test_collect_chunks_large_file),
		("collect chunks via local", test_collect_chunks_via_local),
		("collect chunks explicit size", test_collect_chunks_with_explicit_size),
		("collect chunks invalid size", test_collect_chunks_with_invalid_size),
		("fallible stream count result", test_fallible_stream_count_result),
		("fallible stream predicate results", test_fallible_stream_predicate_results),
		("fallible stream fold result", test_fallible_stream_fold_result),
		("fallible stream fold result managed acc", test_fallible_stream_fold_result_managed_acc),
		("fallible stream terminal error result", test_fallible_stream_terminal_error_result),
		("fallible stream find result", test_fallible_stream_find_result),
		("file lines stream", test_file_lines_stream),
		("file lines find result", test_file_lines_find_result),
		("file count lines", test_file_count_lines),
		("file bytes stream", test_file_bytes_stream),
		("file bytes stream empty", test_file_bytes_stream_empty),
		("file windows stream", test_file_windows_stream),
		("file windows stream short file", test_file_windows_stream_short_file),
		("file windows stream invalid size", test_file_windows_stream_invalid_size),
		("with body ?= returns error", test_with_body_question_bind_returns_error),
		("with body ?= cleans up reader", test_body_question_bind_cleans_up_reader),
		("loop break and continue clean up reader", test_loop_break_continue_clean_up_reader),
		("timeout cleans up open reader", test_timeout_cleans_up_open_reader),
	]
}
