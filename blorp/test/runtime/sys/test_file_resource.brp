import:
	bytes as B
	fs:
		IOError(NotFound),
		entry_stream,
		message,
		open_append,
		open_directory,
		open_read,
		open_read_append,
		open_read_write,
		open_write,
	list: get
	stream: all_result, any_result, collect_result, count_result, find_result, fold_result
	system: append_file, file_exists, file_size, remove_file, write_file
	test: TestSuite


union AppResourceError:
	MappedIo(String)


pure func is_invalid_input_error(err: IOError) -> Bool:
	message(err).starts_with("invalid input:")


func open_existing(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		Ok(1)


func open_missing_with_mapped_error(path: String) -> Result[Int, AppResourceError]:
	with reader ?= open_read(path) on err => MappedIo(message(err)):
		Ok(1)


func fail_int(path: String) -> Result[Int, IOError]:
	Err(NotFound(path))


func open_then_short_circuit(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		value ?= fail_int(path)
		Ok(value)


func break_inside_resource_body(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		var total: Int = 0

		for n in [1, 2, 3]:
			total += n

			if n == 1:
				break

		Ok(total)


func continue_inside_resource_body(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		var total: Int = 0

		for n in [1, 2, 3]:
			if n == 2:
				continue

			total += n

		Ok(total)


func open_writer(path: String) -> Result[Int, IOError]:
	with writer ?= open_write(path):
		Ok(1)


func open_appender(path: String) -> Result[Int, IOError]:
	with writer ?= open_append(path):
		Ok(1)


func size_with_appender(path: String) -> Result[Int, IOError]:
	with appender ?= open_append(path):
		appender.size()


func append_text_with_appender(path: String, text: String) -> Result[Int, IOError]:
	with appender ?= open_append(path):
		ignored ?= appender.append_text(text)
		Ok(1)


func append_bytes_with_appender(path: String, data: Bytes) -> Result[Int, IOError]:
	with appender ?= open_append(path):
		ignored ?= appender.append_bytes(data)
		Ok(1)


func append_chunk_with_appender(path: String, data: Bytes) -> Result[Int, IOError]:
	with appender ?= open_append(path):
		appender.append_chunk(data)


func open_read_writer(path: String) -> Result[Int, IOError]:
	with file ?= open_read_write(path):
		Ok(1)


func read_text_with_rw_handle(path: String) -> Result[String, IOError]:
	with file ?= open_read_write(path):
		file.read_text()


func overwrite_prefix_then_read_tail(path: String, prefix: String) -> Result[String, IOError]:
	with file ?= open_read_write(path):
		ignored ?= file.write_text(prefix)
		file.read_text()


func write_bytes_with_rw_handle(path: String, data: Bytes) -> Result[Int, IOError]:
	with file ?= open_read_write(path):
		match file.write_bytes(data):
			Ok(_):
				Ok(1)
			Err(err):
				Err(err)


func write_chunk_with_rw_handle(path: String, data: Bytes) -> Result[Int, IOError]:
	with file ?= open_read_write(path):
		file.write_chunk(data)


func read_chunk_with_rw_handle(path: String, size: Int) -> Result[Bytes, IOError]:
	with file ?= open_read_write(path):
		file.read_chunk(size)


func count_lines_with_rw_handle(path: String) -> Result[Int, IOError]:
	with file ?= open_read_write(path):
		file.count_lines()


func read_write_size_and_at(path: String, expected_size: Int) -> Result[Bool, IOError]:
	with file ?= open_read_write(path):
		actual_size ?= file.size()
		at ?= file.read_chunk_at(2, 3)
		first ?= file.read_chunk(1)
		Ok(actual_size == expected_size and B.to_string(at) == "cde" and B.to_string(first) == "a")


func read_at_then_read_start(path: String) -> Result[String, IOError]:
	with file ?= open_read_append(path):
		at ?= file.read_chunk_at(4, 2)
		first ?= file.read_chunk(1)
		Ok(B.to_string(at) + "|" + B.to_string(first))


func size_with_read_append_handle(path: String) -> Result[Int, IOError]:
	with file ?= open_read_append(path):
		file.size()


func append_text_with_read_append_handle(path: String, text: String) -> Result[Int, IOError]:
	with file ?= open_read_append(path):
		appended ?= file.append_text(text)
		Ok(1)


func append_bytes_and_chunk_with_read_append_handle(path: String) -> Result[Int, IOError]:
	with file ?= open_read_append(path):
		ignored ?= file.append_bytes("+bytes".to_bytes())
		file.append_chunk("+chunk".to_bytes())


func append_text_after_read_offset_with_read_append(path: String) -> Result[String, IOError]:
	with file ?= open_read_append(path):
		first ?= file.read_chunk(2)
		ignored ?= file.append_text("+tail")
		Ok(B.to_string(first))


func write_text_with_handle(path: String, text: String) -> Result[Int, IOError]:
	with writer ?= open_write(path):
		match writer.write_text(text):
			Ok(_):
				Ok(1)
			Err(err):
				Err(err)


func read_text_with_handle(path: String) -> Result[String, IOError]:
	with reader ?= open_read(path):
		reader.read_text()


func write_bytes_with_handle(path: String, data: Bytes) -> Result[Int, IOError]:
	with writer ?= open_write(path):
		match writer.write_bytes(data):
			Ok(_):
				Ok(1)
			Err(err):
				Err(err)


func write_chunk_with_handle(path: String, data: Bytes) -> Result[Int, IOError]:
	with writer ?= open_write(path):
		writer.write_chunk(data)


func read_bytes_with_handle(path: String) -> Result[Bytes, IOError]:
	with reader ?= open_read(path):
		reader.read_bytes()


func read_two_chunks(path: String) -> Result[String, IOError]:
	with reader ?= open_read(path):
		first ?= reader.read_chunk(5)
		second ?= reader.read_chunk(20)
		Ok(B.to_string(first) + "|" + B.to_string(second))


func read_past_eof(path: String) -> Result[String, IOError]:
	with reader ?= open_read(path):
		first ?= reader.read_chunk(5)
		second ?= reader.read_chunk(5)
		Ok(B.to_string(first) + "|" + B.to_string(second))


func read_invalid_chunk_size(path: String) -> Result[Bytes, IOError]:
	with reader ?= open_read(path):
		reader.read_chunk(0)


func collect_chunks_with_handle(path: String) -> Result[List[Bytes], IOError]:
	with reader ?= open_read(path):
		reader
			.chunks()
			.collect_result()


func collect_chunks_via_local(path: String) -> Result[List[Bytes], IOError]:
	with reader ?= open_read(path):
		stream = reader.chunks()
		stream.collect_result()


func collect_chunks_with_explicit_size(
	path: String,
	chunk_size: Int,
) -> Result[List[Bytes], IOError]:
	with reader ?= open_read(path):
		reader
			.chunks_with_size(chunk_size)
			.collect_result()


func count_chunks_with_explicit_size(path: String, chunk_size: Int) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		reader
			.chunks_with_size(chunk_size)
			.count_result()


func any_chunk_matches(path: String, chunk_size: Int, text: String) -> Result[Bool, IOError]:
	with reader ?= open_read(path):
		reader
			.chunks_with_size(chunk_size)
			.any_result(func(chunk: Bytes): B.to_string(chunk) == text)


func all_chunks_non_empty(path: String, chunk_size: Int) -> Result[Bool, IOError]:
	with reader ?= open_read(path):
		reader
			.chunks_with_size(chunk_size)
			.all_result(func(chunk: Bytes): chunk.length() > 0)


func total_chunk_bytes(path: String, chunk_size: Int) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		reader
			.chunks_with_size(chunk_size)
			.fold_result(0, func(total: Int, chunk: Bytes): total + chunk.length())


func concat_chunk_bytes(path: String, chunk_size: Int) -> Result[Bytes, IOError]:
	with reader ?= open_read(path):
		reader
			.chunks_with_size(chunk_size)
			.fold_result(
				B.bytes(0),
				func(total: Bytes, chunk: Bytes): total.append(chunk),
			)


func find_chunk_bytes(
	path: String,
	chunk_size: Int,
	text: String,
) -> Result[Option[Bytes], IOError]:
	with reader ?= open_read(path):
		reader
			.chunks_with_size(chunk_size)
			.find_result(func(chunk: Bytes): B.to_string(chunk) == text)


func collect_file_lines(path: String) -> Result[List[String], IOError]:
	with reader ?= open_read(path):
		reader
			.lines()
			.collect_result()


func find_line(path: String, text: String) -> Result[Option[String], IOError]:
	with reader ?= open_read(path):
		reader
			.lines()
			.find_result(func(line: String): line == text)


func count_file_lines(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		reader.count_lines()


func collect_file_bytes(path: String) -> Result[List[UInt8], IOError]:
	with reader ?= open_read(path):
		reader
			.bytes()
			.collect_result()


func collect_file_windows(path: String, size: Int) -> Result[List[Bytes], IOError]:
	with reader ?= open_read(path):
		reader
			.windows(size)
			.collect_result()


func open_read_then_sleep(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		sleep(10000)
		Ok(1)


func run_cancelled_open_read(path: String) -> Bool:
	concurrent(timeout: 5):
		opened = open_read_then_sleep(path)

	match opened:
		Ok(_):
			False
		Err(_):
			True


func directory_entry_count(path: String) -> Int:
	match directory_entry_count_result(path):
		Ok(count):
			count
		Err(_):
			0


func directory_entry_count_result(path: String) -> Result[Int, IOError]:
	with dir ?= open_directory(path):
		dir
			.entry_stream()
			.count_result()


func open_fd_count() -> Int:
	dev_fds: Int = directory_entry_count("/dev/fd")

	if dev_fds > 0:
		dev_fds
	else:
		directory_entry_count("/proc/self/fd")


func size_is(path: String, expected: Int) -> Bool:
	match file_size(path):
		Ok(n):
			n == expected
		Err(_):
			False


func test_open_read_missing_not_found() -> Bool:
	path: String = "/tmp/__blorp_file_resource_missing"
	_ = remove_file(path)

	match open_existing(path):
		Err(NotFound(p)):
			p == path
		_:
			False


func test_with_acquisition_maps_error() -> Bool:
	path: String = "/tmp/__blorp_file_resource_mapped_missing"
	_ = remove_file(path)

	match open_missing_with_mapped_error(path):
		Err(MappedIo(detail)):
			detail.contains("not found") and detail.contains(path)
		_:
			False


func test_open_read_existing_closes() -> Bool:
	path: String = "/tmp/__blorp_file_resource_existing"
	_ = write_file(path, "hello")

	ok: Bool = match open_existing(path):
		Ok(n):
			n == 1
		Err(_):
			False

	_ = remove_file(path)
	ok


func test_normal_with_cleans_up_file_handles() -> Bool:
	path: String = "/tmp/__blorp_file_resource_normal_cleanup"
	_ = write_file(path, "hello")
	before: Int = open_fd_count()
	var ok: Bool = True
	var i: Int = 0

	while i < 20 and ok:
		reader_ok: Bool = match open_existing(path):
			Ok(n):
				n == 1
			Err(_):
				False

		writer_ok: Bool = match open_writer(path):
			Ok(n):
				n == 1
			Err(_):
				False

		_ = write_file(path, "hello")

		read_write_ok: Bool = match open_read_writer(path):
			Ok(n):
				n == 1
			Err(_):
				False

		ok = reader_ok and writer_ok and read_write_ok
		i += 1

	after: Int = open_fd_count()
	_ = remove_file(path)

	if before == 0 or after == 0:
		ok
	else:
		ok and after <= before + 3


func test_open_write_creates_and_truncates() -> Bool:
	path: String = "/tmp/__blorp_file_resource_write"
	_ = write_file(path, "existing")

	opened: Bool = match open_writer(path):
		Ok(n):
			n == 1
		Err(_):
			False

	ok: Bool = opened and file_exists(path) and size_is(path, 0)
	_ = remove_file(path)
	ok


func test_open_append_creates_and_preserves() -> Bool:
	missing: String = "/tmp/__blorp_file_resource_append_missing"
	existing: String = "/tmp/__blorp_file_resource_append_existing"
	_ = remove_file(missing)
	_ = write_file(existing, "data")

	created: Bool = match open_appender(missing):
		Ok(n):
			n == 1
		Err(_):
			False

	preserved: Bool = match open_appender(existing):
		Ok(n):
			n == 1
		Err(_):
			False

	ok: Bool = (
		created
		and file_exists(missing)
		and size_is(missing, 0)
		and preserved
		and size_is(existing, 4)
	)

	_ = remove_file(missing)
	_ = remove_file(existing)
	ok


func test_file_appender_append_operations() -> Bool:
	path: String = "/tmp/__blorp_file_resource_appender_ops"
	_ = write_file(path, "base")

	text_ok: Bool = match append_text_with_appender(path, "+text"):
		Ok(n):
			n == 1
		Err(_):
			False

	bytes_ok: Bool = match append_bytes_with_appender(path, "+bytes".to_bytes()):
		Ok(n):
			n == 1
		Err(_):
			False

	empty_chunk_ok: Bool = match append_chunk_with_appender(
		path,
		B.bytes(0),
	):
		Ok(n):
			n == 0
		Err(_):
			False

	chunk_ok: Bool = match append_chunk_with_appender(path, "+chunk".to_bytes()):
		Ok(n):
			n == 6
		Err(_):
			False

	size_ok: Bool = match size_with_appender(path):
		Ok(n):
			n == 21
		Err(_):
			False

	content_ok: Bool = match read_text_with_handle(path):
		Ok(text):
			text == "base+text+bytes+chunk"
		Err(_):
			False

	_ = remove_file(path)
	text_ok and bytes_ok and empty_chunk_ok and chunk_ok and size_ok and content_ok


func test_open_read_write_existing_only() -> Bool:
	existing: String = "/tmp/__blorp_file_resource_rw_existing"
	missing: String = "/tmp/__blorp_file_resource_rw_missing"
	_ = write_file(existing, "data")
	_ = remove_file(missing)

	opened: Bool = match open_read_writer(existing):
		Ok(n):
			n == 1
		Err(_):
			False

	missing_err: Bool = match open_read_writer(missing):
		Err(NotFound(p)):
			p == missing
		_:
			False

	ok: Bool = opened and size_is(existing, 4) and missing_err
	_ = remove_file(existing)
	ok


func test_open_read_append_existing_only() -> Bool:
	existing: String = "/tmp/__blorp_file_resource_ra_existing"
	missing: String = "/tmp/__blorp_file_resource_ra_missing"
	_ = write_file(existing, "data")
	_ = remove_file(missing)

	opened: Bool = match size_with_read_append_handle(existing):
		Ok(n):
			n == 4
		Err(_):
			False

	missing_err: Bool = match size_with_read_append_handle(missing):
		Err(NotFound(p)):
			p == missing
		_:
			False

	appended: Bool = match append_text_with_read_append_handle(existing, "x"):
		Ok(n):
			n == 1
		Err(_):
			False

	content_ok: Bool = match read_text_with_handle(existing):
		Ok(text):
			text == "datax"
		Err(_):
			False

	_ = remove_file(existing)
	opened and missing_err and appended and content_ok


func test_read_append_handle_bytes_and_chunk_append() -> Bool:
	path: String = "/tmp/__blorp_file_resource_ra_append_bytes_chunk"
	_ = write_file(path, "base")

	wrote: Bool = match append_bytes_and_chunk_with_read_append_handle(path):
		Ok(n):
			n == 6
		Err(_):
			False

	content_ok: Bool = match read_text_with_handle(path):
		Ok(text):
			text == "base+bytes+chunk"
		Err(_):
			False

	_ = remove_file(path)
	wrote and content_ok


func test_read_append_handle_appends_after_partial_read() -> Bool:
	path: String = "/tmp/__blorp_file_resource_ra_append_after_read"
	_ = write_file(path, "abcdef")

	read_ok: Bool = match append_text_after_read_offset_with_read_append(path):
		Ok(text):
			text == "ab"
		Err(_):
			False

	content_ok: Bool = match read_text_with_handle(path):
		Ok(text):
			text == "abcdef+tail"
		Err(_):
			False

	_ = remove_file(path)
	read_ok and content_ok


func test_read_write_handle_reads_text() -> Bool:
	path: String = "/tmp/__blorp_file_resource_rw_read_text"
	_ = write_file(path, "read-write text")

	ok: Bool = match read_text_with_rw_handle(path):
		Ok(text):
			text == "read-write text"
		Err(_):
			False

	_ = remove_file(path)
	ok


func test_read_write_handle_writes_text_at_current_offset() -> Bool:
	path: String = "/tmp/__blorp_file_resource_rw_write_text"
	_ = write_file(path, "abcdef")

	tail_ok: Bool = match overwrite_prefix_then_read_tail(path, "XY"):
		Ok(tail):
			tail == "cdef"
		Err(_):
			False

	file_ok: Bool = match read_text_with_handle(path):
		Ok(text):
			text == "XYcdef"
		Err(_):
			False

	_ = remove_file(path)
	tail_ok and file_ok


func test_read_write_handle_bytes_and_chunk() -> Bool:
	bytes_path: String = "/tmp/__blorp_file_resource_rw_bytes"
	chunk_path: String = "/tmp/__blorp_file_resource_rw_chunk"
	_ = write_file(bytes_path, "abcdef")
	_ = write_file(chunk_path, "abcdef")

	bytes_written: Bool = match write_bytes_with_rw_handle(bytes_path, "12".to_bytes()):
		Ok(n):
			n == 1
		Err(_):
			False

	bytes_read: Bool = match read_text_with_handle(bytes_path):
		Ok(text):
			text == "12cdef"
		Err(_):
			False

	chunk_written: Bool = match write_chunk_with_rw_handle(chunk_path, "XYZ".to_bytes()):
		Ok(n):
			n == 3
		Err(_):
			False

	chunk_read: Bool = match read_text_with_handle(chunk_path):
		Ok(text):
			text == "XYZdef"
		Err(_):
			False

	_ = remove_file(bytes_path)
	_ = remove_file(chunk_path)
	bytes_written and bytes_read and chunk_written and chunk_read


func test_read_write_handle_read_chunk_and_count_lines() -> Bool:
	path: String = "/tmp/__blorp_file_resource_rw_read_chunk"
	_ = write_file(path, "one\ntwo\nthree")

	chunk_ok: Bool = match read_chunk_with_rw_handle(path, 3):
		Ok(data):
			B.to_string(data) == "one"
		Err(_):
			False

	count_ok: Bool = match count_lines_with_rw_handle(path):
		Ok(n):
			n == 3
		Err(_):
			False

	_ = remove_file(path)
	chunk_ok and count_ok


func test_read_write_handle_size_and_read_chunk_at() -> Bool:
	path: String = "/tmp/__blorp_file_resource_rw_size_at"
	_ = write_file(path, "abcdef")

	ok: Bool = match read_write_size_and_at(path, 6):
		Ok(result):
			result
		Err(_):
			False

	_ = remove_file(path)
	ok


func test_read_chunk_at_does_not_advance_offset() -> Bool:
	path: String = "/tmp/__blorp_file_resource_read_at"
	_ = write_file(path, "abcdef")

	ok: Bool = match read_at_then_read_start(path):
		Ok(text):
			text == "ef|a"
		Err(_):
			False

	_ = remove_file(path)
	ok


func test_write_then_read_text() -> Bool:
	path: String = "/tmp/__blorp_file_resource_text"
	_ = remove_file(path)

	wrote: Bool = match write_text_with_handle(path, "hello\nresource"):
		Ok(n):
			n == 1
		Err(_):
			False

	read_back: Bool = match read_text_with_handle(path):
		Ok(text):
			text == "hello\nresource"
		Err(_):
			False

	ok: Bool = wrote and read_back
	_ = remove_file(path)
	ok


func test_write_then_read_bytes() -> Bool:
	path: String = "/tmp/__blorp_file_resource_bytes"
	_ = remove_file(path)
	src: Bytes = "hello bytes".to_bytes()

	wrote: Bool = match write_bytes_with_handle(path, src):
		Ok(n):
			n == 1
		Err(_):
			False

	read_back: Bool = match read_bytes_with_handle(path):
		Ok(data):
			B.to_string(data) == "hello bytes"
		Err(_):
			False

	ok: Bool = wrote and read_back
	_ = remove_file(path)
	ok


func test_write_chunk_returns_count() -> Bool:
	path: String = "/tmp/__blorp_file_resource_write_chunk"
	_ = remove_file(path)

	wrote: Bool = match write_chunk_with_handle(path, "chunked".to_bytes()):
		Ok(n):
			n == 7
		Err(_):
			False

	read_back: Bool = match read_text_with_handle(path):
		Ok(text):
			text == "chunked"
		Err(_):
			False

	_ = remove_file(path)
	wrote and read_back


func test_write_chunk_empty_returns_zero() -> Bool:
	path: String = "/tmp/__blorp_file_resource_write_chunk_empty"
	_ = write_file(path, "existing")

	wrote: Bool = match write_chunk_with_handle(
		path,
		B.bytes(0),
	):
		Ok(n):
			n == 0
		Err(_):
			False

	read_back: Bool = match read_text_with_handle(path):
		Ok(text):
			text == ""
		Err(_):
			False

	_ = remove_file(path)
	wrote and read_back


func test_read_chunk_advances_reader() -> Bool:
	path: String = "/tmp/__blorp_file_resource_chunk"
	_ = write_file(path, "hello world")

	ok: Bool = match read_two_chunks(path):
		Ok(text):
			text == "hello| world"
		Err(_):
			False

	_ = remove_file(path)
	ok


func test_read_chunk_eof_is_empty() -> Bool:
	path: String = "/tmp/__blorp_file_resource_chunk_eof"
	_ = write_file(path, "hello")

	ok: Bool = match read_past_eof(path):
