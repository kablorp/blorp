-- WebSocket resource tests.
--
-- The std WebSocket surface is resource-shaped. Valid connects are covered by
-- the runtime state probe so this source-level test stays deterministic and
-- avoids external network dependencies.
import:
	net/websocket as WS: WebSocketError
	string: contains
	test: TestSuite, websocket_state_probe_for_test


func websocket_connect_result(url: String) -> Result[Bool, WebSocketError]:
	with _ ?= WS.connect(url):
		Ok(False)


func websocket_invalid_url_contains(url: String, expected: String) -> Bool:
	match websocket_connect_result(url):
		Ok(_): False
		Err(err): WS
			.message(err)
			.contains(expected)


func test_websocket_connect_empty_url_is_invalid() -> Bool:
	match websocket_connect_result(""):
		Ok(_): False
		Err(err): WS
			.message(err)
			.contains("url must not be empty")


func test_websocket_connect_bad_scheme_is_invalid() -> Bool:
	match websocket_connect_result("http://example.com/socket"):
		Ok(_): False
		Err(err): WS
			.message(err)
			.contains("scheme must be ws:// or wss://")


func test_websocket_connect_missing_host_is_invalid() -> Bool:
	websocket_invalid_url_contains("ws://", "url must include a host")


func test_websocket_connect_empty_host_with_port_is_invalid() -> Bool:
	websocket_invalid_url_contains("ws://:80/socket", "url must include a host")


func test_websocket_connect_empty_port_is_invalid() -> Bool:
	websocket_invalid_url_contains("ws://example.com:/socket", "port must not be empty")


func test_websocket_connect_non_numeric_port_is_invalid() -> Bool:
	websocket_invalid_url_contains("ws://example.com:abc/socket", "port must contain only digits")


func test_websocket_connect_oversized_port_is_invalid() -> Bool:
	websocket_invalid_url_contains(
		"ws://example.com:65536/socket",
		"port must be between 0 and 65535",
	)


func test_websocket_connect_userinfo_is_invalid() -> Bool:
	websocket_invalid_url_contains("ws://user@example.com/socket", "url must not include user info")


func test_websocket_connect_raw_space_is_invalid() -> Bool:
	websocket_invalid_url_contains(
		"ws://exa mple.com/socket",
		"url must not contain raw control or space characters",
	)


func test_websocket_connect_fragment_is_invalid() -> Bool:
	websocket_invalid_url_contains(
		"ws://example.com/socket#section",
		"url must not include a fragment",
	)


func test_websocket_native_backend_available() -> Bool:
	WS.native_available()


func test_websocket_runtime_state_probe() -> Bool:
	websocket_state_probe_for_test()


tests: TestSuite = {
	description = "WebSocket Resource Tests",
	tests = [
		("WebSocket connect empty URL is invalid", test_websocket_connect_empty_url_is_invalid),
		("WebSocket connect bad scheme is invalid", test_websocket_connect_bad_scheme_is_invalid),
		(
			"WebSocket connect missing host is invalid",
			test_websocket_connect_missing_host_is_invalid,
		),
		(
			"WebSocket connect empty host with port is invalid",
			test_websocket_connect_empty_host_with_port_is_invalid,
		),
		("WebSocket connect empty port is invalid", test_websocket_connect_empty_port_is_invalid),
		(
			"WebSocket connect non-numeric port is invalid",
			test_websocket_connect_non_numeric_port_is_invalid,
		),
		(
			"WebSocket connect oversized port is invalid",
			test_websocket_connect_oversized_port_is_invalid,
		),
		("WebSocket connect userinfo is invalid", test_websocket_connect_userinfo_is_invalid),
		("WebSocket connect raw space is invalid", test_websocket_connect_raw_space_is_invalid),
		("WebSocket connect fragment is invalid", test_websocket_connect_fragment_is_invalid),
		("WebSocket native backend is available", test_websocket_native_backend_available),
		("WebSocket runtime state transitions are typed", test_websocket_runtime_state_probe),
	]
}
