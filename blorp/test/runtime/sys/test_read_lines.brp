-- Test streaming file I/O (Phase 1: list-based)
import:
	list: get
	system: append_file, read_all_lines, write_file, write_lines
	test: TestSuite


tests: TestSuite = {
	description = "Streaming File I/O",
	tests = [
		("write and read lines", test_write_read_lines),
		("read missing file", test_read_missing),
		("append file", test_append_file),
		("empty file", test_empty_file),
		("no trailing newline", test_no_trailing_newline),
		("crlf line endings", test_crlf_endings),
	]
}


func check_line(lines: List[String], idx: Int, expected: String) -> Bool:
	match lines.get(idx):
		Some(s): equals(s, expected)
		_: False


func test_write_read_lines() -> Bool:
	path: String = "/tmp/blorp_test_lines.txt"
	lines: List[String] = ["hello", "world", "foo"]
	write_lines(path, lines)
	result: List[String] = read_all_lines(path)
	if result.length() != 3:
		False
	else:
		check_line(
			result,
			0,
			"hello",
		) and check_line(result, 1, "world") and check_line(result, 2, "foo")


func test_read_missing() -> Bool:
	result: List[String] = read_all_lines("/tmp/blorp_nonexistent_file_xyz.txt")
	result.length() == 0


func test_append_file() -> Bool:
	path: String = "/tmp/blorp_test_append.txt"
	_ = write_file(path, "line1\nline2\n")
	append_file(path, "line3\nline4\n")
	result: List[String] = read_all_lines(path)
	result.length() == 4


func test_empty_file() -> Bool:
	path: String = "/tmp/blorp_test_empty.txt"
	_ = write_file(path, "")
	result: List[String] = read_all_lines(path)
	result.length() == 0


func test_no_trailing_newline() -> Bool:
	path: String = "/tmp/blorp_test_notail.txt"
	_ = write_file(path, "hello\nworld")
	result: List[String] = read_all_lines(path)
	result.length() == 2


func test_crlf_endings() -> Bool:
	path: String = "/tmp/blorp_test_crlf.txt"
	_ = write_file(path, "line1\r\nline2\r\nline3\r\n")
	result: List[String] = read_all_lines(path)
	result.length() == 3
