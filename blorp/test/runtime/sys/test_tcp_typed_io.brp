-- Focused typed TCP error coverage for the resource API.
import:
	net/tcp:
		IpFamily(IPv4),
		TcpError(InvalidInput, Other),
		listen_loopback_any_port,
		message,
		set_timeout,
	string: contains, starts_with
	test: TestSuite


pure func is_invalid_message(message: String, detail: String) -> Bool:
	message.starts_with("invalid input: ") and message.contains(detail)


func test_tcp_error_message() -> Bool:
	invalid: String = message(InvalidInput("bad port"))
	other: String = message(Other("tcp read: timed out"))
	invalid.starts_with("invalid input: ") and other == "tcp error: tcp read: timed out"


func invalid_backlog_result() -> Result[Bool, TcpError]:
	with _ ?= listen_loopback_any_port(IPv4, -1):
		Ok(False)


func test_listen_invalid_backlog_is_typed() -> Bool:
	match invalid_backlog_result():
		Ok(_): False
		Err(err): is_invalid_message(message(err), "backlog")


func invalid_timeout_result() -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 1):
		ignored ?= set_timeout(listener, -1)
		Ok(False)


func test_listener_timeout_invalid_is_typed() -> Bool:
	match invalid_timeout_result():
		Ok(_): False
		Err(err):
			detail_msg: String = message(err)
			is_invalid_message(
				detail_msg,
				"timeout",
			) or detail_msg.contains("Operation not permitted")


tests: TestSuite = {
	description = "TCP Typed Error Tests",
	tests = [
		("TcpError messages are stable", test_tcp_error_message),
		("listen invalid backlog is typed", test_listen_invalid_backlog_is_typed),
		("listener timeout invalid is typed", test_listener_timeout_invalid_is_typed),
	]
}
