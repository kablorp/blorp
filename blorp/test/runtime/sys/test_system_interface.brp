-- Test system interface functions
import:
	system: exec, file_exists
	test: TestSuite


func test_file_exists_existing() -> Bool:
	file_exists("blorp/test/runtime/types/test_if_expr.brp")


func test_file_exists_nonexistent() -> Bool:
	exists: Bool = file_exists("tests/nonexistent.brp")
	exists == False


func test_exec_echo_success() -> Bool:
	exit_code: Int = exec("echo 'test' > /dev/null")
	exit_code == 0


func test_exec_false_fails() -> Bool:
	exit_code: Int = exec("false")
	exit_code != 0


func test_exec_rejects_nul_command() -> Bool:
	exit_code: Int = exec("true\0false")
	exit_code == -1


tests: TestSuite = {
	description = "System Interface",
	tests = [
		("file_exists returns True for existing file", test_file_exists_existing),
		("file_exists returns False for nonexistent file", test_file_exists_nonexistent),
		("exec returns 0 for successful command", test_exec_echo_success),
		("exec returns 1 for false command", test_exec_false_fails),
		("exec rejects NUL command", test_exec_rejects_nul_command),
	]
}
