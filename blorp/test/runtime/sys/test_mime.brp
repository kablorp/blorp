import:
	net/mime: from_extension, is_text, to_extension
	test: TestSuite


func test_html() -> Bool:
	from_extension("html") == "text/html"


func test_json() -> Bool:
	from_extension("json") == "application/json"


func test_css() -> Bool:
	from_extension("css") == "text/css"


func test_js() -> Bool:
	from_extension("js") == "text/javascript"


func test_png() -> Bool:
	from_extension("png") == "image/png"


func test_jpg() -> Bool:
	from_extension("jpg") == "image/jpeg"


func test_pdf() -> Bool:
	from_extension("pdf") == "application/pdf"


func test_unknown() -> Bool:
	from_extension("xyz") == "application/octet-stream"


func test_case_insensitive() -> Bool:
	from_extension("HTML") == "text/html"


func test_to_ext_html() -> Bool:
	match to_extension("text/html"):
		Some(e): e == "html"
		None: False


func test_to_ext_json() -> Bool:
	match to_extension("application/json"):
		Some(e): e == "json"
		None: False


func test_to_ext_unknown() -> Bool:
	match to_extension("application/x-custom"):
		Some(_): False
		None: True


func test_is_text_html() -> Bool:
	is_text("text/html") == True


func test_is_text_json() -> Bool:
	is_text("application/json") == True


func test_is_text_png() -> Bool:
	is_text("image/png") == False


tests: TestSuite = {
	description = "MIME Types",
	tests = [
		("html", test_html),
		("json", test_json),
		("css", test_css),
		("js", test_js),
		("png", test_png),
		("jpg", test_jpg),
		("pdf", test_pdf),
		("unknown", test_unknown),
		("case insensitive", test_case_insensitive),
		("to_extension html", test_to_ext_html),
		("to_extension json", test_to_ext_json),
		("to_extension unknown", test_to_ext_unknown),
		("is_text html", test_is_text_html),
		("is_text json", test_is_text_json),
		("is_text png", test_is_text_png),
	]
}
