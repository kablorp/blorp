-- Stdlib types that are not on the bare-spelling ABI list (`fs.IOError`,
-- `stream.FallibleStream`) written through their module alias reach the
-- typechecker as `alias.Type`, are canonicalized to `module::Type`, and reach
-- Core as `module__Type`. The readers that decide ownership, C type and
-- operation-result layout (`type_policy`, `c_type_layout`, `prepare`,
-- `operation_metadata`) must classify the type in every spelling it can take:
-- here the error type is written `fs.IOError` in a signature, the stream
-- helper is called through its alias, and the error is matched.
import:
	bytes as B
	fs
	stream
	system: remove_file, write_file
	test: TestSuite


func read_total(path: String) -> Result[Int, fs.IOError]:
	with reader ?= fs.open_read(path):
		stream.fold_result(
			fs.chunks_with_size(reader, 4),
			0,
			func(total: Int, chunk: Bytes): total + chunk.length(),
		)


func test_qualified_stream_fold_over_file_reader() -> Bool:
	path: String = "/tmp/__blorp_qualified_type_spelling_read"
	_ = write_file(path, "0123456789")

	ok: Bool = match read_total(path):
		Ok(n):
			n == 10
		Err(_):
			False

	_ = remove_file(path)
	ok


func test_qualified_ioerror_result() -> Bool:
	match read_total("/tmp/__blorp_qualified_type_spelling_missing"):
		Err(fs.NotFound(_)):
			True
		_:
			False


tests: TestSuite = {
	description = "stdlib types written with module-qualified spellings",
	tests = [
		("qualified stream fold over a file reader", test_qualified_stream_fold_over_file_reader),
		("qualified IOError result", test_qualified_ioerror_result),
	]
}
