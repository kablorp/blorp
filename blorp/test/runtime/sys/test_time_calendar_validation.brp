import:
	test: TestSuite
	time: from_iso, from_parts, parse_time, to_iso, try_from_parts


func is_none(value: Option[Int]) -> Bool:
	match value:
		None: True
		Some(_): False


func is_some_iso(value: Option[Int], expected: String) -> Bool:
	match value:
		Some(microseconds): to_iso(microseconds) == expected
		None: False


func test_from_parts_normalizes_invalid_day() -> Bool:
	to_iso(from_parts(2023, 2, 29, 0, 0, 0)) == "2023-03-01T00:00:00Z"


func test_from_parts_normalizes_month_overflow() -> Bool:
	to_iso(from_parts(2024, 13, 1, 0, 0, 0)) == "2025-01-01T00:00:00Z"


func test_try_from_parts_rejects_month_overflow() -> Bool:
	is_none(try_from_parts(2024, 13, 1, 0, 0, 0))


func test_try_from_parts_rejects_hour_overflow() -> Bool:
	is_none(try_from_parts(2024, 1, 1, 24, 0, 0))


func test_try_from_parts_rejects_second_overflow() -> Bool:
	is_none(try_from_parts(2024, 1, 1, 0, 0, 60))


func test_from_iso_rejects_1900_feb_29() -> Bool:
	is_none(from_iso("1900-02-29T00:00:00Z"))


func test_from_iso_accepts_2000_feb_29() -> Bool:
	is_some_iso(from_iso("2000-02-29T00:00:00Z"), "2000-02-29T00:00:00Z")


func test_from_iso_rejects_2100_feb_29() -> Bool:
	is_none(from_iso("2100-02-29T00:00:00Z"))


func test_from_iso_rejects_zero_month() -> Bool:
	is_none(from_iso("2024-00-01T00:00:00Z"))


func test_from_iso_rejects_zero_day() -> Bool:
	is_none(from_iso("2024-01-00T00:00:00Z"))


func test_parse_time_rejects_invalid_day() -> Bool:
	is_none(parse_time("2023-02-29", "%Y-%m-%d"))


func test_parse_time_accepts_century_leap_day() -> Bool:
	is_some_iso(parse_time("2000-02-29", "%Y-%m-%d"), "2000-02-29T00:00:00Z")


func test_parse_time_rejects_non_century_leap_day() -> Bool:
	is_none(parse_time("1900-02-29", "%Y-%m-%d"))


func test_parse_time_rejects_2100_feb_29() -> Bool:
	is_none(parse_time("2100-02-29", "%Y-%m-%d"))


func test_parse_time_rejects_hour_overflow() -> Bool:
	is_none(parse_time("2024-01-01 24:00:00", "%Y-%m-%d %H:%M:%S"))


func test_parse_time_rejects_trailing_input() -> Bool:
	is_none(parse_time("2024-01-01 extra", "%Y-%m-%d"))


tests: TestSuite = {
	description = "Time calendar validation baseline",
	tests = [
		("from_parts normalizes invalid day", test_from_parts_normalizes_invalid_day),
		("from_parts normalizes month overflow", test_from_parts_normalizes_month_overflow),
		("try_from_parts rejects month overflow", test_try_from_parts_rejects_month_overflow),
		("try_from_parts rejects hour overflow", test_try_from_parts_rejects_hour_overflow),
		("try_from_parts rejects second overflow", test_try_from_parts_rejects_second_overflow),
		("from_iso rejects 1900 feb 29", test_from_iso_rejects_1900_feb_29),
		("from_iso accepts 2000 feb 29", test_from_iso_accepts_2000_feb_29),
		("from_iso rejects 2100 feb 29", test_from_iso_rejects_2100_feb_29),
		("from_iso rejects zero month", test_from_iso_rejects_zero_month),
		("from_iso rejects zero day", test_from_iso_rejects_zero_day),
		("parse_time rejects invalid day", test_parse_time_rejects_invalid_day),
		("parse_time accepts century leap day", test_parse_time_accepts_century_leap_day),
		("parse_time rejects non-century leap day", test_parse_time_rejects_non_century_leap_day),
		("parse_time rejects 2100 feb 29", test_parse_time_rejects_2100_feb_29),
		("parse_time rejects hour overflow", test_parse_time_rejects_hour_overflow),
		("parse_time rejects trailing input", test_parse_time_rejects_trailing_input),
	]
}
