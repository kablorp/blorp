-- Test that getcwd doesn't leak memory when called repeatedly
import:
	memory: MemStats, get_mem_stats, reset_mem_stats
	system: getcwd
	test: TestSuite


func test_getcwd_no_leak() -> Bool:
	-- Warm up: first call may allocate
	warmup: String = getcwd()
	_ = warmup
	reset_mem_stats()
	var i: Int = 0

	while i < 100:
		cwd: String = getcwd()
		_ = cwd
		i += 1

	stats: MemStats = get_mem_stats()

	-- With the bug, each getcwd() result loses its owner, so current_objects grows
	-- to 100+. Correctly owned results are released at the end of each iteration.
	stats.current_objects < 5


tests: TestSuite = {
	description = "getcwd memory leak",
	tests = [("getcwd no leak", test_getcwd_no_leak)]
}
