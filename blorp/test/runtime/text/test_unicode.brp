-- Test Unicode string handling
import:
	string: codepoint_length, codepoint_reverse, codepoints
	test: TestSuite


func test_accented_chars() -> Bool:
	s: String = "café"
	s.length() == 5


func test_basic_unicode() -> Bool:
	s: String = "héllo"
	s.length() == 6


-- codepoint_length tests
func test_codepoint_length_ascii() -> Bool:
	codepoint_length("hello") == 5


func test_codepoint_length_multibyte() -> Bool:
	-- "café" is 4 codepoints but 5 bytes (é is 2 bytes)
	codepoint_length("café") == 4


func test_codepoint_length_empty() -> Bool:
	codepoint_length("") == 0


func test_codepoint_length_emoji() -> Bool:
	-- 4-byte emoji codepoint
	codepoint_length("😀") == 1


-- codepoints tests
func test_codepoints_ascii() -> Bool:
	codepoints("AB") == [65, 66]


func test_codepoints_empty() -> Bool:
	empty: List[Int] = []
	codepoints("") == empty


func test_codepoints_multibyte() -> Bool:
	-- é is U+00E9 = 233
	result: List[Int] = codepoints("é")
	result == [233]


-- codepoint_reverse tests
func test_codepoint_reverse_ascii() -> Bool:
	codepoint_reverse("hello") == "olleh"


func test_codepoint_reverse_multibyte() -> Bool:
	-- Should correctly reverse multi-byte chars
	codepoint_reverse("café") == "éfac"


func test_codepoint_reverse_empty() -> Bool:
	codepoint_reverse("") == ""


func test_codepoint_reverse_single() -> Bool:
	codepoint_reverse("a") == "a"


tests: TestSuite = {
	description = "Unicode strings",
	tests = [
		("accented chars", test_accented_chars),
		("basic unicode", test_basic_unicode),
		("codepoint_length ascii", test_codepoint_length_ascii),
		("codepoint_length multibyte", test_codepoint_length_multibyte),
		("codepoint_length empty", test_codepoint_length_empty),
		("codepoint_length emoji", test_codepoint_length_emoji),
		("codepoints ascii", test_codepoints_ascii),
		("codepoints empty", test_codepoints_empty),
		("codepoints multibyte", test_codepoints_multibyte),
		("codepoint_reverse ascii", test_codepoint_reverse_ascii),
		("codepoint_reverse multibyte", test_codepoint_reverse_multibyte),
		("codepoint_reverse empty", test_codepoint_reverse_empty),
		("codepoint_reverse single", test_codepoint_reverse_single),
	]
}
