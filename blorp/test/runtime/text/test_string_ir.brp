import:
	list: get
	string:
		capitalize,
		center,
		contains,
		count,
		drop_left,
		drop_right,
		ends_with,
		equal_ignore_case,
		is_ascii,
		is_blank,
		is_lower,
		is_numeric,
		is_upper,
		last_index_of,
		lower,
		pad_left,
		pad_right,
		repeat,
		replace,
		reverse,
		starts_with,
		substring,
		take_left,
		take_right,
		title_case,
		trim,
		trim_chars,
		trim_left,
		trim_right,
		upper,
	test: TestSuite


-- ============================================================================
-- Substring (IR: string_alloc + string_get_byte + string_set_byte)
-- ============================================================================
func test_substring_basic() -> Bool:
	"hello world".substring(0, 5) == "hello"


func test_substring_middle() -> Bool:
	"hello world".substring(6, 5) == "world"


func test_substring_empty_result() -> Bool:
	"hello".substring(0, 0) == ""


func test_substring_negative_start() -> Bool:
	"hello".substring(-5, 3) == "hel"


func test_substring_negative_len() -> Bool:
	"hello".substring(0, -1) == ""


func test_substring_beyond_end() -> Bool:
	"hello".substring(3, 100) == "lo"


func test_substring_start_beyond() -> Bool:
	"hello".substring(100, 5) == ""


func test_substring_empty_input() -> Bool:
	"".substring(0, 5) == ""


-- ============================================================================
-- Starts/Ends With (IR: string_len + string_get_byte loops)
-- ============================================================================
func test_starts_with_yes() -> Bool:
	"hello".starts_with("hel")


func test_starts_with_no() -> Bool:
	not "hello".starts_with("world")


func test_starts_with_empty_prefix() -> Bool:
	"hello".starts_with("")


func test_starts_with_longer_prefix() -> Bool:
	not "hi".starts_with("hello")


func test_ends_with_yes() -> Bool:
	"hello".ends_with("llo")


func test_ends_with_no() -> Bool:
	not "hello".ends_with("world")


func test_ends_with_empty() -> Bool:
	"hello".ends_with("")


-- ============================================================================
-- Contains / Count / Index (IR: nested byte loops)
-- ============================================================================
func test_contains_yes() -> Bool:
	"hello world".contains("lo wo")


func test_contains_no() -> Bool:
	not "hello".contains("xyz")


func test_contains_empty_needle() -> Bool:
	"hello".contains("")


func test_contains_same() -> Bool:
	"abc".contains("abc")


func test_count_basic() -> Bool:
	count("abcabc", "abc") == 2


func test_count_no_match() -> Bool:
	count("hello", "xyz") == 0


func test_count_empty_needle() -> Bool:
	count("hello", "") == 0


func test_count_nonoverlapping() -> Bool:
	count("aaaa", "aa") == 2


func test_last_index_of_found() -> Bool:
	match last_index_of("hello hello", "hello"):
		Some(i): i == 6
		None: False


func test_last_index_of_not_found() -> Bool:
	match last_index_of("hello", "xyz"):
		Some(_): False
		None: True


-- ============================================================================
-- Predicates (IR: byte iteration with conditions)
-- ============================================================================
func test_equal_ignore_case() -> Bool:
	equal_ignore_case("HeLLo", "hEllO")


func test_equal_ignore_case_diff() -> Bool:
	not equal_ignore_case("abc", "xyz")


func test_equal_ignore_case_diff_len() -> Bool:
	not equal_ignore_case("abc", "ab")


func test_is_numeric_yes() -> Bool:
	is_numeric("12345")


func test_is_numeric_empty() -> Bool:
	not is_numeric("")


func test_is_numeric_mixed() -> Bool:
	not is_numeric("12a")


func test_is_ascii_yes() -> Bool:
	is_ascii("hello")


func test_is_ascii_empty() -> Bool:
	is_ascii("")


func test_is_blank_spaces() -> Bool:
	is_blank("   ")


func test_is_blank_empty() -> Bool:
	is_blank("")


func test_is_blank_not() -> Bool:
	not is_blank(" x ")


func test_is_lower_yes() -> Bool:
	is_lower("hello")


func test_is_lower_digits() -> Bool:
	is_lower("abc123")


func test_is_lower_no() -> Bool:
	not is_lower("Hello")


func test_is_lower_empty() -> Bool:
	not is_lower("")


func test_is_lower_no_letters() -> Bool:
	not is_lower("123")


func test_is_upper_yes() -> Bool:
	is_upper("HELLO")


func test_is_upper_no() -> Bool:
	not is_upper("Hello")


func test_is_upper_empty() -> Bool:
	not is_upper("")


-- ============================================================================
-- Mutation (IR: string_alloc + copy/transform loops)
-- ============================================================================
func test_repeat_basic() -> Bool:
	"ab".repeat(3) == "ababab"


func test_repeat_zero() -> Bool:
	"hi".repeat(0) == ""


func test_repeat_one() -> Bool:
	"hi".repeat(1) == "hi"


func test_repeat_single_character() -> Bool:
	"x".repeat(5) == "xxxxx"


func test_repeat_empty_string() -> Bool:
	"".repeat(100) == ""


func test_reverse_basic() -> Bool:
	reverse("abc") == "cba"


func test_reverse_empty() -> Bool:
	reverse("") == ""


func test_reverse_single() -> Bool:
	reverse("x") == "x"


func test_drop_left_basic() -> Bool:
	drop_left("hello", 2) == "llo"


func test_drop_left_zero() -> Bool:
	drop_left("hello", 0) == "hello"


func test_drop_left_all() -> Bool:
	drop_left("hello", 10) == ""


func test_take_left_basic() -> Bool:
	take_left("hello", 3) == "hel"


func test_take_left_all() -> Bool:
	take_left("hello", 10) == "hello"


func test_take_right_basic() -> Bool:
	take_right("hello", 3) == "llo"


func test_drop_right_basic() -> Bool:
	drop_right("hello", 2) == "hel"


-- ============================================================================
-- Trim (IR: while loops scanning whitespace)
-- ============================================================================
func test_trim_basic() -> Bool:
	trim("  hello  ") == "hello"


func test_trim_empty() -> Bool:
	trim("") == ""


func test_trim_all_spaces() -> Bool:
	trim("   ") == ""


func test_trim_no_spaces() -> Bool:
	trim("hello") == "hello"


func test_trim_left_basic() -> Bool:
	trim_left("  hello") == "hello"


func test_trim_right_basic() -> Bool:
	trim_right("hello  ") == "hello"


func test_trim_chars_basic() -> Bool:
	trim_chars("xxhelloxx", "x") == "hello"


func test_trim_chars_multiple() -> Bool:
	trim_chars("xyzhelloyzx", "xyz") == "hello"


-- ============================================================================
-- Case (IR: byte transform loops)
-- ============================================================================
func test_upper() -> Bool:
	upper("hello") == "HELLO"


func test_upper_mixed() -> Bool:
	upper("Hello123") == "HELLO123"


func test_lower() -> Bool:
	lower("HELLO") == "hello"


func test_lower_mixed() -> Bool:
	lower("Hello123") == "hello123"


func test_capitalize_basic() -> Bool:
	capitalize("hello world") == "Hello world"


func test_capitalize_all_upper() -> Bool:
	capitalize("HELLO WORLD") == "Hello world"


func test_capitalize_leading_digits() -> Bool:
	capitalize("123abc") == "123Abc"


func test_capitalize_empty() -> Bool:
	capitalize("") == ""


func test_title_case_basic() -> Bool:
	title_case("hello world") == "Hello World"


func test_title_case_all_upper() -> Bool:
	title_case("HELLO WORLD") == "Hello World"


-- ============================================================================
-- Pad / Center (IR: alloc + fill loops)
-- ============================================================================
func test_pad_left() -> Bool:
	pad_left("5", 3, '0') == "005"


func test_pad_left_already_wide() -> Bool:
	pad_left("hello", 3, '0') == "hello"


func test_pad_right() -> Bool:
	pad_right("5", 3, '0') == "500"


func test_pad_right_already_wide() -> Bool:
	pad_right("hello", 3, '0') == "hello"


func test_center_even() -> Bool:
	center("hi", 6, '-') == "--hi--"


func test_center_odd() -> Bool:
	center("hi", 5, '-') == "-hi--"


-- ============================================================================
-- List IR (verify list intrinsics still work alongside string)
-- ============================================================================
func test_list_append() -> Bool:
	[1, 2].append(3) == [1, 2, 3]


func test_list_get() -> Bool:
	match get([10, 20, 30], 1):
		Some(v): v == 20
		None: False


func test_list_remove() -> Bool:
	match [1, 2, 3].remove(1):
		Some(r): r == [1, 3]
		None: False


func test_list_length() -> Bool:
	length([1, 2, 3]) == 3


-- String list interop (string ops on list elements)
func test_string_list_interop() -> Bool:
	items: List[String] = ["hello", "world"]
	match get(items, 0):
		Some(s): s.starts_with("hel")
		None: False


func test_string_pipeline_length_composed() -> Bool:
	"  abacad  "
		.trim()
		.take_left(5)
		.replace("a", "xy")
		.length() == 8


func test_string_pipeline_transform_then_trim_length() -> Bool:
	"aa"
		.replace("a", " ")
		.trim()
		.length() == 0


func test_string_pipeline_reverse_then_replace_length() -> Bool:
	"ab"
		.reverse()
		.replace("ab", "x")
		.length() == 2


func test_string_pipeline_reverse_same_width_replace_length() -> Bool:
	"ab"
		.reverse()
		.replace("a", "A")
		.length() == 2


func test_string_pipeline_materialized_window_replace() -> Bool:
	"  abacad  "
		.trim()
		.take_left(5)
		.replace("a", "xy") == "xybxycxy"


func test_string_pipeline_materialized_empty_replace_needle() -> Bool:
	"  abc  "
		.trim()
		.take_left(2)
		.replace("", "x") == "ab"


func test_string_pipeline_materialized_no_match() -> Bool:
	"  abc  "
		.trim()
		.take_left(2)
		.replace("z", "x") == "ab"


func test_string_pipeline_materialized_window_only() -> Bool:
	"  abcdef  "
		.trim()
		.drop_left(1)
		.take_right(3) == "def"


func test_string_pipeline_materialized_window_reverse() -> Bool:
	"  abcdef  "
		.trim()
		.reverse() == "fedcba"


tests: TestSuite = {
	description = "IR Intrinsics Comprehensive",
	tests = [
		("substring basic", test_substring_basic),
		("substring middle", test_substring_middle),
		("substring empty result", test_substring_empty_result),
		("substring negative start", test_substring_negative_start),
		("substring negative len", test_substring_negative_len),
		("substring beyond end", test_substring_beyond_end),
		("substring start beyond", test_substring_start_beyond),
		("substring empty input", test_substring_empty_input),
		("starts_with yes", test_starts_with_yes),
		("starts_with no", test_starts_with_no),
		("starts_with empty", test_starts_with_empty_prefix),
		("starts_with longer", test_starts_with_longer_prefix),
		("ends_with yes", test_ends_with_yes),
		("ends_with no", test_ends_with_no),
		("ends_with empty", test_ends_with_empty),
		("contains yes", test_contains_yes),
		("contains no", test_contains_no),
		("contains empty", test_contains_empty_needle),
		("contains same", test_contains_same),
		("count basic", test_count_basic),
		("count no match", test_count_no_match),
		("count empty", test_count_empty_needle),
		("count nonoverlap", test_count_nonoverlapping),
		("last_index found", test_last_index_of_found),
		("last_index not found", test_last_index_of_not_found),
		("equal_ignore_case", test_equal_ignore_case),
		("equal_ignore_case diff", test_equal_ignore_case_diff),
		("equal_ignore_case len", test_equal_ignore_case_diff_len),
		("is_numeric yes", test_is_numeric_yes),
		("is_numeric empty", test_is_numeric_empty),
		("is_numeric mixed", test_is_numeric_mixed),
		("is_ascii yes", test_is_ascii_yes),
		("is_ascii empty", test_is_ascii_empty),
		("is_blank spaces", test_is_blank_spaces),
		("is_blank empty", test_is_blank_empty),
		("is_blank not", test_is_blank_not),
		("is_lower yes", test_is_lower_yes),
		("is_lower digits", test_is_lower_digits),
		("is_lower no", test_is_lower_no),
		("is_lower empty", test_is_lower_empty),
		("is_lower no letters", test_is_lower_no_letters),
		("is_upper yes", test_is_upper_yes),
		("is_upper no", test_is_upper_no),
		("is_upper empty", test_is_upper_empty),
		("repeat basic", test_repeat_basic),
		("repeat zero", test_repeat_zero),
		("repeat one", test_repeat_one),
		("repeat single character", test_repeat_single_character),
		("repeat empty string", test_repeat_empty_string),
		("reverse basic", test_reverse_basic),
		("reverse empty", test_reverse_empty),
		("reverse single", test_reverse_single),
		("drop_left basic", test_drop_left_basic),
		("drop_left zero", test_drop_left_zero),
		("drop_left all", test_drop_left_all),
		("take_left basic", test_take_left_basic),
		("take_left all", test_take_left_all),
		("take_right", test_take_right_basic),
		("drop_right", test_drop_right_basic),
		("trim basic", test_trim_basic),
		("trim empty", test_trim_empty),
		("trim all spaces", test_trim_all_spaces),
		("trim no spaces", test_trim_no_spaces),
		("trim_left", test_trim_left_basic),
		("trim_right", test_trim_right_basic),
		("trim_chars basic", test_trim_chars_basic),
		("trim_chars multi", test_trim_chars_multiple),
		("upper", test_upper),
		("upper mixed", test_upper_mixed),
		("lower", test_lower),
		("lower mixed", test_lower_mixed),
		("capitalize basic", test_capitalize_basic),
		("capitalize upper", test_capitalize_all_upper),
		("capitalize digits", test_capitalize_leading_digits),
		("capitalize empty", test_capitalize_empty),
		("title_case basic", test_title_case_basic),
		("title_case upper", test_title_case_all_upper),
		("pad_left", test_pad_left),
		("pad_left wide", test_pad_left_already_wide),
		("pad_right", test_pad_right),
		("pad_right wide", test_pad_right_already_wide),
		("center even", test_center_even),
		("center odd", test_center_odd),
		("list append", test_list_append),
		("list get", test_list_get),
		("list remove", test_list_remove),
		("list length", test_list_length),
		("string list interop", test_string_list_interop),
		("string pipeline length composed", test_string_pipeline_length_composed),
		(
			"string pipeline transform then trim length",
			test_string_pipeline_transform_then_trim_length,
		),
		(
			"string pipeline reverse then replace length",
			test_string_pipeline_reverse_then_replace_length,
		),
		(
			"string pipeline reverse same-width replace length",
			test_string_pipeline_reverse_same_width_replace_length,
		),
		(
			"string pipeline materialized window replace",
			test_string_pipeline_materialized_window_replace,
		),
		(
			"string pipeline materialized empty replace needle",
			test_string_pipeline_materialized_empty_replace_needle,
