import:
	test: TestSuite


func test_basic() -> Bool:
	x: String =
		|hello world
	x == "hello world"


func test_multiline() -> Bool:
	x: String =
		|line one
		|line two
		|line three
	x == "line one\nline two\nline three"


func test_embedded_quotes() -> Bool:
	x: String =
		|She said "hello" to me
	x == "She said \"hello\" to me"


func test_interpolation() -> Bool:
	name: String = "world"
	x: String =
		|hello ${name}!
	x == "hello world!"


func test_multiline_interpolation() -> Bool:
	a: Int = 1
	b: Int = 2
	x: String =
		|a = ${a}
		|b = ${b}
	x == "a = 1\nb = 2"


func test_whitespace_preservation() -> Bool:
	x: String =
		|  indented
		|    more indented
	x == "  indented\n    more indented"


func test_escape_sequences() -> Bool:
	x: String =
		|tab	here
	x == "tab\there"


func test_empty() -> Bool:
	x: String =
		|
	x == ""


tests: TestSuite = {
	description = "Triple-Quoted Strings",
	tests = [
		("basic", test_basic),
		("multiline", test_multiline),
		("embedded quotes", test_embedded_quotes),
		("interpolation", test_interpolation),
		("multiline interpolation", test_multiline_interpolation),
		("whitespace preservation", test_whitespace_preservation),
		("escape sequences", test_escape_sequences),
		("empty", test_empty),
	]
}
