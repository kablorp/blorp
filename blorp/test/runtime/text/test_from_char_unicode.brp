-- Test from_char with non-ASCII Unicode codepoints
import:
	string: from_char, from_chars
	test: TestSuite


func test_ascii_char() -> Bool:
	s: String = from_char('A')
	s == "A" and s.length() == 1


func test_e_acute() -> Bool:
	-- U+00E9 (e-acute) requires 2 bytes in UTF-8: 0xC3 0xA9
	s: String = from_char('\u{E9}')
	s.length() == 2


func test_cjk_char() -> Bool:
	-- U+4E16 (CJK character) requires 3 bytes in UTF-8: 0xE4 0xB8 0x96
	s: String = from_char('\u{4E16}')
	s.length() == 3


func test_emoji() -> Bool:
	-- U+1F600 (grinning face) requires 4 bytes in UTF-8: 0xF0 0x9F 0x98 0x80
	s: String = from_char('\u{1F600}')
	s.length() == 4


func test_from_chars_unicode() -> Bool:
	-- from_chars with non-ASCII codepoints should produce valid UTF-8
	chars: List[Char] = ['\u{E9}', '\u{E8}']
	s: String = from_chars(chars)

	-- Two 2-byte chars = 4 bytes total
	s.length() == 4


tests: TestSuite = {
	description = "from_char Unicode",
	tests = [
		("ascii char", test_ascii_char),
		("e-acute (2 bytes)", test_e_acute),
		("CJK char (3 bytes)", test_cjk_char),
		("emoji (4 bytes)", test_emoji),
		("from_chars unicode", test_from_chars_unicode),
	]
}
