import:
	list: length
	test: TestSuite
	xml as X: XmlError, XmlNode(XmlElement, XmlText)


-- Basic parsing
func test_simple_element() -> Bool:
	result: Result[XmlNode, String] = X.parse("<root>hello</root>")
	match result:
		Ok(node): X.get_tag(node) == Some("root")
		Err(_): False


func test_empty_element() -> Bool:
	result: Result[XmlNode, String] = X.parse("<empty></empty>")
	match result:
		Ok(node): X.get_tag(node) == Some("empty")
		Err(_): False


func test_self_closing() -> Bool:
	result: Result[XmlNode, String] = X.parse("<br/>")
	match result:
		Ok(node): X.get_tag(node) == Some("br")
		Err(_): False


func test_self_closing_with_space() -> Bool:
	result: Result[XmlNode, String] = X.parse("<br />")
	match result:
		Ok(node): X.get_tag(node) == Some("br")
		Err(_): False


func test_empty_input() -> Bool:
	result: Result[XmlNode, String] = X.parse("")
	match result:
		Ok(_): False
		Err(_): True


-- Text content
func test_get_text() -> Bool:
	result: Result[XmlNode, String] = X.parse("<root>hello</root>")
	match result:
		Ok(node): X.get_text(node) == "hello"
		Err(_): False


func test_get_text_uses_first_direct_text_child() -> Bool:
	result: Result[XmlNode, String] = X.parse("<root>first<child>nested</child>second</root>")
	match result:
		Ok(node): X.get_text(node) == "first"
		Err(_): False


func test_get_text_does_not_descend() -> Bool:
	result: Result[XmlNode, String] = X.parse("<root><child>nested</child></root>")
	match result:
		Ok(node): X.get_text(node) == ""
		Err(_): False


func test_text_node_direct() -> Bool:
	node: XmlNode = XmlText("direct")
	X.get_text(node) == "direct"


-- Attributes
func test_attributes() -> Bool:
	result: Result[XmlNode, String] = X.parse("<div class=\"main\">text</div>")
	match result:
		Ok(node): X.get_attr(node, "class") == Some("main")
		Err(_): False


func test_multiple_attrs() -> Bool:
	result: Result[XmlNode, String] = X.parse("<input type=\"text\" name=\"field\" />")
	match result:
		Ok(node): X.get_attr(
			node,
			"type",
		) == Some("text") and X.get_attr(node, "name") == Some("field")
		Err(_): False


func test_missing_attr() -> Bool:
	result: Result[XmlNode, String] = X.parse("<div>text</div>")
	match result:
		Ok(node): X.get_attr(node, "class") == None
		Err(_): False


-- Children
func test_children_count() -> Bool:
	result: Result[XmlNode, String] = X.parse("<ul><li>a</li><li>b</li></ul>")
	match result:
		Ok(node): X
			.children(node)
			.length() == 2
		Err(_): False


func test_find_by_tag() -> Bool:
	result: Result[XmlNode, String] = X.parse(
		"<root><item>one</item><other>two</other><item>three</item></root>",
	)
	match result:
		Ok(node): X
			.find(node, "item")
			.length() == 2
		Err(_): False


-- Entity unescaping
func test_entity_lt_gt() -> Bool:
	result: Result[XmlNode, String] = X.parse("<root>&lt;hello&gt;</root>")
	match result:
		Ok(node): X.get_text(node) == "<hello>"
		Err(_): False


func test_entity_amp() -> Bool:
	result: Result[XmlNode, String] = X.parse("<root>a &amp; b</root>")
	match result:
		Ok(node): X.get_text(node) == "a & b"
		Err(_): False


func test_entity_quot() -> Bool:
	result: Result[XmlNode, String] = X.parse("<root>&quot;quoted&quot;</root>")
	match result:
		Ok(node): X.get_text(node) == "\"quoted\""
		Err(_): False


func test_entity_apos() -> Bool:
	result: Result[XmlNode, String] = X.parse("<root>&apos;text&apos;</root>")
	match result:
		Ok(node): X.get_text(node) == "'text'"
		Err(_): False


func test_rejects_unknown_text_entity() -> Bool:
	match X.parse("<root>&bogus;</root>"):
		Ok(_): False
		Err(e): e.contains("line 1") and e.contains("column 7")


func test_rejects_unknown_attribute_entity() -> Bool:
	match X.parse("<root id=\"&bogus;\"></root>"):
		Ok(_): False
		Err(e): e.contains("line 1") and e.contains("column 11")


-- Comments
func test_comments_skipped() -> Bool:
	result: Result[XmlNode, String] = X.parse("<root><!-- comment --><item>text</item></root>")
	match result:
		Ok(node): X
			.children(node)
			.length() == 1
		Err(_): False


-- Tag name from text node
func test_tag_of_text() -> Bool:
	node: XmlNode = XmlText("hello")
	X.get_tag(node) == None


-- Malformed input
func test_not_xml() -> Bool:
	result: Result[XmlNode, String] = X.parse("just text")
	match result:
		Ok(_): False
		Err(_): True


func test_unclosed_tag() -> Bool:
	result: Result[XmlNode, String] = X.parse("<root")
	match result:
		Ok(_): False
		Err(_): True


func is_err[T](result: Result[T, String]) -> Bool:
	match result:
		Ok(_): False
		Err(_): True


func expect_xml_ok(input: String) -> Bool:
	match X.parse_detailed(input):
		Ok(_): True
		Err(_): False


func expect_xml_err(input: String) -> Bool:
	match X.parse_detailed(input):
		Ok(_): False
		Err(_): True


func test_mismatched_closing_tag() -> Bool:
	is_err(X.parse("<root><item></root>"))


func test_trailing_input() -> Bool:
	is_err(X.parse("<root></root><extra></extra>"))


func test_malformed_attributes() -> Bool:
	missing_equals: Bool = is_err(X.parse("<root disabled></root>"))
	unquoted: Bool = is_err(X.parse("<root id=1></root>"))
	unclosed: Bool = is_err(X.parse("<root id=\"1></root>"))
	duplicate: Bool = is_err(X.parse("<root id=\"1\" id=\"2\"></root>"))
	missing_equals and unquoted and unclosed and duplicate


func test_rejects_invalid_xml_names() -> Bool:
	bad_tag_start: Bool = is_err(X.parse("<1root></1root>"))
	bad_attr_start: Bool = is_err(X.parse("<root 1id=\"x\"></root>"))
	colon_attr: Bool = is_err(X.parse("<root ns:id=\"x\"></root>"))
	bad_tag_start and bad_attr_start and colon_attr


func test_unterminated_comment() -> Bool:
	is_err(X.parse("<root><!-- comment</root>"))


func test_rejects_nested_comment_marker() -> Bool:
	is_err(X.parse("<root><!-- outer <!-- inner --> --></root>"))


func test_unsupported_xml_features() -> Bool:
	cdata: Bool = is_err(X.parse("<root><![CDATA[text]]></root>"))
	processing: Bool = is_err(X.parse("<?xml version=\"1.0\"?><root></root>"))
	dtd: Bool = is_err(X.parse("<!DOCTYPE root><root></root>"))
	namespace: Bool = is_err(X.parse("<ns:root></ns:root>"))
	cdata and processing and dtd and namespace


func test_rejects_entity_edge_cases() -> Bool:
	missing_semicolon: Bool = is_err(X.parse("<root>&amp</root>"))
	raw_amp: Bool = is_err(X.parse("<root>a & b</root>"))
	attr_missing_semicolon: Bool = is_err(X.parse("<root id=\"&amp\"></root>"))
	missing_semicolon and raw_amp and attr_missing_semicolon


func test_error_includes_line_and_column_for_mismatch() -> Bool:
	match X.parse("<root>\n  <item></root>\n</root>"):
		Ok(_): False
		Err(e): e.contains("line 2") and e.contains("column 9")


func test_error_includes_line_and_column_for_trailing_input() -> Bool:
	match X.parse("<root></root>\n<extra/>"):
		Ok(_): False
		Err(e): e.contains("line 2") and e.contains("column 1")


func test_parse_detailed_success() -> Bool:
	match X.parse_detailed("<root>hello</root>"):
		Ok(node): X.get_tag(node) == Some("root")
		Err(_): False


func test_parse_detailed_error_fields() -> Bool:
	match X.parse_detailed("<root>\n  <item></root>\n</root>"):
		Ok(_): False
		Err(e):
			e.line == 2 and e.column == 9 and e.message.contains("mismatched closing tag")


func test_format_error() -> Bool:
	err: XmlError = {
		line = 3,
		column = 5,
		message = "bad element"
	}
	X.format_error(err) == "line 3, column 5: bad element"


func test_xml_valid_subset_fixtures() -> Bool:
	values: List[String] = [
		"<root/>",
		"<root attr=\"value\" other='single'>text</root>",
		"<root><child id=\"1\">a</child><child>b</child></root>",
		"<root>&lt;&gt;&amp;&quot;&apos;</root>",
		"<root><!-- comment --><item /></root>",
	]
	var ok: Bool = True
	var i: Int = 0
	while i < values.length() and ok:
		match values.get(i):
			Some(input): ok = expect_xml_ok(input)
			None: ok = False
		i += 1
	ok


func test_xml_invalid_subset_fixtures() -> Bool:
	values: List[String] = [
		"<1root></1root>",
		"<root a=1/>",
		"<root a=\"1\" a=\"2\"/>",
		"<root>&unknown;</root>",
		"<root><!-- outer <!-- inner --> --></root>",
		"<root><?pi?></root>",
	]
	var ok: Bool = True
	var i: Int = 0
	while i < values.length() and ok:
		match values.get(i):
			Some(input): ok = expect_xml_err(input)
			None: ok = False
		i += 1
	ok


-- No entities (fast path)
func test_no_entities() -> Bool:
	result: Result[XmlNode, String] = X.parse("<root>plain text</root>")
	match result:
		Ok(node): X.get_text(node) == "plain text"
		Err(_): False


tests: TestSuite = {
	description = "XML",
	tests = [
		("simple element", test_simple_element),
		("empty element", test_empty_element),
		("self closing", test_self_closing),
		("self closing with space", test_self_closing_with_space),
		("empty input", test_empty_input),
		("get text", test_get_text),
		("get text uses first direct text child", test_get_text_uses_first_direct_text_child),
		("get text does not descend", test_get_text_does_not_descend),
		("text node direct", test_text_node_direct),
		("attributes", test_attributes),
		("multiple attrs", test_multiple_attrs),
		("missing attr", test_missing_attr),
		("children count", test_children_count),
		("find by tag", test_find_by_tag),
		("entity lt gt", test_entity_lt_gt),
		("entity amp", test_entity_amp),
		("entity quot", test_entity_quot),
		("entity apos", test_entity_apos),
		("rejects unknown text entity", test_rejects_unknown_text_entity),
		("rejects unknown attribute entity", test_rejects_unknown_attribute_entity),
		("comments skipped", test_comments_skipped),
		("tag of text", test_tag_of_text),
		("not xml", test_not_xml),
		("unclosed tag", test_unclosed_tag),
		("mismatched closing tag", test_mismatched_closing_tag),
		("trailing input", test_trailing_input),
		("malformed attributes", test_malformed_attributes),
		("rejects invalid xml names", test_rejects_invalid_xml_names),
		("unterminated comment", test_unterminated_comment),
		("rejects nested comment marker", test_rejects_nested_comment_marker),
		("unsupported xml features", test_unsupported_xml_features),
		("rejects entity edge cases", test_rejects_entity_edge_cases),
		(
			"error includes line and column for mismatch",
			test_error_includes_line_and_column_for_mismatch,
		),
		(
			"error includes line and column for trailing input",
			test_error_includes_line_and_column_for_trailing_input,
		),
		("parse_detailed success", test_parse_detailed_success),
		("parse_detailed error fields", test_parse_detailed_error_fields),
		("format error", test_format_error),
		("xml valid subset fixtures", test_xml_valid_subset_fixtures),
		("xml invalid subset fixtures", test_xml_invalid_subset_fixtures),
		("no entities", test_no_entities),
	]
}
