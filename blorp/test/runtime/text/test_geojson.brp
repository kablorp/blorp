import:
	float: approx_eq
	geographic: Coord, coord, line_string, polygon, polygon_with_holes
	geojson:
		Feature,
		FeatureCollection,
		Geometry(GeoLineString, GeoPoint, GeoMultiPolygon, GeoPolygon, GeoMultiPoint),
		parse_geojson,
		to_geojson,
	list: get, length
	result: Result(Ok, Err)
	test: TestSuite


-- ============================================================================
-- Decode tests
-- ============================================================================
pure func test_decode_point() -> Bool:
	json: String = "{\"type\": \"FeatureCollection\", \"features\": [{\"type\": \"Feature\", \"geometry\": {\"type\": \"Point\", \"coordinates\": [-74.006, 40.7128]}, \"properties\": {}}]}"

	match parse_geojson(json):
		Ok(fc):
			match get(fc.features, 0):
				Some(f):
					match f.geometry:
						GeoPoint(c):
							approx_eq(c.lon, -74.006) and approx_eq(c.lat, 40.7128)
						_:
							False
				None:
					False
		Err(_):
			False


pure func test_decode_linestring() -> Bool:
	json: String = "{\"type\": \"FeatureCollection\", \"features\": [{\"type\": \"Feature\", \"geometry\": {\"type\": \"LineString\", \"coordinates\": [[0.0, 0.0], [1.0, 1.0], [2.0, 2.0]]}, \"properties\": {}}]}"

	match parse_geojson(json):
		Ok(fc):
			match get(fc.features, 0):
				Some(f):
					match f.geometry:
						GeoLineString(ls):
							ls.coords.length() == 3
						_:
							False
				None:
					False
		Err(_):
			False


pure func test_decode_polygon() -> Bool:
	json: String = "{\"type\": \"FeatureCollection\", \"features\": [{\"type\": \"Feature\", \"geometry\": {\"type\": \"Polygon\", \"coordinates\": [[[0.0, 0.0], [10.0, 0.0], [10.0, 10.0], [0.0, 10.0], [0.0, 0.0]]]}, \"properties\": {}}]}"

	match parse_geojson(json):
		Ok(fc):
			match get(fc.features, 0):
				Some(f):
					match f.geometry:
						GeoPolygon(poly):
							poly.exterior.length() == 5
						_:
							False
				None:
					False
		Err(_):
			False


pure func test_decode_polygon_with_holes() -> Bool:
	json: String = "{\"type\": \"FeatureCollection\", \"features\": [{\"type\": \"Feature\", \"geometry\": {\"type\": \"Polygon\", \"coordinates\": [[[0.0, 0.0], [20.0, 0.0], [20.0, 20.0], [0.0, 20.0], [0.0, 0.0]], [[5.0, 5.0], [15.0, 5.0], [15.0, 15.0], [5.0, 15.0], [5.0, 5.0]]]}, \"properties\": {}}]}"

	match parse_geojson(json):
		Ok(fc):
			match get(fc.features, 0):
				Some(f):
					match f.geometry:
						GeoPolygon(poly):
							poly.exterior.length() == 5 and poly.holes.length() == 1
						_:
							False
				None:
					False
		Err(_):
			False


pure func test_decode_multiple_features() -> Bool:
	json: String = "{\"type\": \"FeatureCollection\", \"features\": [{\"type\": \"Feature\", \"geometry\": {\"type\": \"Point\", \"coordinates\": [0.0, 0.0]}, \"properties\": {}}, {\"type\": \"Feature\", \"geometry\": {\"type\": \"Point\", \"coordinates\": [1.0, 1.0]}, \"properties\": {}}]}"

	match parse_geojson(json):
		Ok(fc):
			fc.features.length() == 2
		Err(_):
			False


pure func test_decode_multipoint() -> Bool:
	json: String = "{\"type\": \"FeatureCollection\", \"features\": [{\"type\": \"Feature\", \"geometry\": {\"type\": \"MultiPoint\", \"coordinates\": [[0.0, 0.0], [1.0, 1.0]]}, \"properties\": {}}]}"

	match parse_geojson(json):
		Ok(fc):
			match get(fc.features, 0):
				Some(f):
					match f.geometry:
						GeoMultiPoint(mp):
							mp.points.length() == 2
						_:
							False
				None:
					False
		Err(_):
			False


pure func test_decode_properties() -> Bool:
	json: String = "{\"type\": \"FeatureCollection\", \"features\": [{\"type\": \"Feature\", \"geometry\": {\"type\": \"Point\", \"coordinates\": [0.0, 0.0]}, \"properties\": {\"name\": \"Origin\", \"value\": 42.0}}]}"

	match parse_geojson(json):
		Ok(fc):
			match get(fc.features, 0):
				Some(f):
					f.properties.length() == 2
				None:
					False
		Err(_):
			False


pure func test_decode_error_bad_json() -> Bool:
	match parse_geojson("not json at all"):
		Err(_):
			True
		Ok(_):
			False


pure func test_decode_error_trailing_json() -> Bool:
	json: String = "{\"type\": \"FeatureCollection\", \"features\": []} false"

	match parse_geojson(json):
		Err(msg):
			msg.contains("trailing")
		Ok(_):
			False


pure func test_decode_error_missing_features() -> Bool:
	match parse_geojson("{\"type\": \"FeatureCollection\"}"):
		Err(_):
			True
		Ok(_):
			False


pure func test_decode_error_unknown_geometry() -> Bool:
	json: String = "{\"type\": \"FeatureCollection\", \"features\": [{\"type\": \"Feature\", \"geometry\": {\"type\": \"Circle\", \"coordinates\": [0.0, 0.0]}, \"properties\": {}}]}"

	match parse_geojson(json):
		Err(msg):
			msg.length() > 0
		Ok(_):
			False


-- ============================================================================
-- Encode roundtrip tests
-- ============================================================================
pure func test_roundtrip_point() -> Bool:
	feat: Feature = {
		geometry = GeoPoint(coord(1.5, 2.5)),
		properties = []
	}
	fc: FeatureCollection = {features = [feat]}
	json: String = to_geojson(fc)

	-- Parse back
	match parse_geojson(json):
		Ok(fc2):
			match get(fc2.features, 0):
				Some(f):
					match f.geometry:
						GeoPoint(c):
							approx_eq(c.lon, 1.5) and approx_eq(c.lat, 2.5)
						_:
							False
				None:
					False
		Err(_):
			False


pure func test_roundtrip_linestring() -> Bool:
	ls: Feature = {
		geometry = GeoLineString(line_string([coord(0.0, 0.0), coord(1.0, 1.0), coord(2.0, 2.0)])),
		properties = []
	}
	fc: FeatureCollection = {features = [ls]}
	json: String = to_geojson(fc)

	match parse_geojson(json):
		Ok(fc2):
			match get(fc2.features, 0):
				Some(f):
					match f.geometry:
						GeoLineString(l):
							l.coords.length() == 3
						_:
							False
				None:
					False
		Err(_):
			False


pure func test_roundtrip_polygon() -> Bool:
	poly: Feature = {
		geometry = GeoPolygon(polygon([
			coord(0.0, 0.0),
			coord(1.0, 0.0),
			coord(1.0, 1.0),
			coord(0.0, 1.0),
			coord(0.0, 0.0),
		])),
		properties = []
	}
	fc: FeatureCollection = {features = [poly]}
	json: String = to_geojson(fc)

	match parse_geojson(json):
		Ok(fc2):
			match get(fc2.features, 0):
				Some(f):
					match f.geometry:
						GeoPolygon(p):
							p.exterior.length() == 5
						_:
							False
				None:
					False
		Err(_):
			False


pure func test_roundtrip_polygon_with_holes() -> Bool:
	ext: List[Coord] = [
		coord(0.0, 0.0),
		coord(20.0, 0.0),
		coord(20.0, 20.0),
		coord(0.0, 20.0),
		coord(0.0, 0.0),
	]
	hole: List[Coord] = [
		coord(5.0, 5.0),
		coord(15.0, 5.0),
		coord(15.0, 15.0),
		coord(5.0, 15.0),
		coord(5.0, 5.0),
	]
	feat: Feature = {
		geometry = GeoPolygon(polygon_with_holes(ext, [hole])),
		properties = []
	}
	fc: FeatureCollection = {features = [feat]}
	json: String = to_geojson(fc)

	match parse_geojson(json):
		Ok(fc2):
			match get(fc2.features, 0):
				Some(f):
					match f.geometry:
						GeoPolygon(p):
							p.exterior.length() == 5 and p.holes.length() == 1
						_:
							False
				None:
					False
		Err(_):
			False


pure func test_roundtrip_two_features() -> Bool:
	feat1: Feature = {
		geometry = GeoPoint(coord(10.0, 20.0)),
		properties = []
	}
	feat2: Feature = {
		geometry = GeoPoint(coord(30.0, 40.0)),
		properties = []
	}
	fc: FeatureCollection = {features = [feat1, feat2]}
	json: String = to_geojson(fc)

	match parse_geojson(json):
		Ok(fc2):
			fc2.features.length() == 2
		Err(_):
			False


pure func test_roundtrip_empty_collection() -> Bool:
	fc: FeatureCollection = {features = []}
	json: String = to_geojson(fc)

	match parse_geojson(json):
		Ok(fc2):
			fc2.features.length() == 0
		Err(_):
			False


-- ============================================================================
-- Test suite
-- ============================================================================
tests: TestSuite = {
	description = "GeoJSON Module",
	tests = [
		("decode point", test_decode_point),
		("decode linestring", test_decode_linestring),
		("decode polygon", test_decode_polygon),
		("decode polygon with holes", test_decode_polygon_with_holes),
		("decode multiple features", test_decode_multiple_features),
		("decode multipoint", test_decode_multipoint),
		("decode properties", test_decode_properties),
		("decode error bad json", test_decode_error_bad_json),
		("decode error trailing json", test_decode_error_trailing_json),
		("decode error missing features", test_decode_error_missing_features),
		("decode error unknown geometry", test_decode_error_unknown_geometry),
		("roundtrip point", test_roundtrip_point),
		("roundtrip linestring", test_roundtrip_linestring),
		("roundtrip polygon", test_roundtrip_polygon),
		("roundtrip polygon with holes", test_roundtrip_polygon_with_holes),
		("roundtrip two features", test_roundtrip_two_features),
		("roundtrip empty collection", test_roundtrip_empty_collection),
	]
}
