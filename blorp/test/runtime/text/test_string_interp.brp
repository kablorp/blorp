import:
	test: TestSuite


func test_basic_variable() -> Bool:
	name: String = "Alice"
	result: String = "Hello ${name}!"
	result == "Hello Alice!"


func test_int_interpolation() -> Bool:
	x: Int = 42
	result: String = "Value: ${x}"
	result == "Value: 42"


func test_float_interpolation() -> Bool:
	f: Float = 3.14
	result: String = "Pi: ${f}"
	result == "Pi: 3.14"


func test_bool_interpolation() -> Bool:
	b: Bool = True
	result: String = "Flag: ${b}"
	result == "Flag: True"


func test_expression() -> Bool:
	x: Int = 5
	result: String = "Sum: ${x + 3}"
	result == "Sum: 8"


func test_multiple_interpolations() -> Bool:
	name: String = "Bob"
	age: Int = 25
	result: String = "${name} is ${age} years old"
	result == "Bob is 25 years old"


func test_escaped_braces() -> Bool:
	result: String = "Use {braces} for code"
	result == "Use {braces} for code"


func test_mixed_literal_and_interp() -> Bool:
	x: Int = 10
	result: String = "Start ${x} middle ${x + 1} end"
	result == "Start 10 middle 11 end"


func test_single_quote_after_interp() -> Bool:
	x: Int = 1
	s: String = "${x}'s"
	s.length() == 3


func test_single_quote_between_interps() -> Bool:
	x: Int = 1
	y: Int = 2
	s: String = "${x}'${y}"
	s.length() == 3


func test_escapes_between_interps() -> Bool:
	x: Int = 1
	y: Int = 2
	s: String = "${x}\t\n${y}"
	s.length() == 4


tests: TestSuite = {
	description = "String Interpolation",
	tests = [
		("basic variable", test_basic_variable),
		("int interpolation", test_int_interpolation),
		("float interpolation", test_float_interpolation),
		("bool interpolation", test_bool_interpolation),
		("expression", test_expression),
		("multiple interpolations", test_multiple_interpolations),
		("escaped braces", test_escaped_braces),
		("mixed literal and interp", test_mixed_literal_and_interp),
		("single quote after interp", test_single_quote_after_interp),
		("single quote between interps", test_single_quote_between_interps),
		("escapes between interps", test_escapes_between_interps),
	]
}
