-- Test raw string literals
import:
	test: TestSuite


func test_raw_string_backslash_n() -> Bool:
	-- \n should be literal backslash + n, not newline
	s: String = raw"hello\nworld"
	s.length() == 12


func test_raw_string_backslash_t() -> Bool:
	-- \t should be literal backslash + t, not tab
	s: String = raw"hello\tworld"
	s.length() == 12


func test_raw_string_path() -> Bool:
	s: String = raw"C:\Users\foo"
	s.length() == 12


func test_raw_string_regex() -> Bool:
	s: String = raw"\d+\.\d+"
	s.length() == 8


func test_raw_string_single_backslash() -> Bool:
	s: String = raw"\"
	s.length() == 1


func test_raw_string_no_interpolation() -> Bool:
	-- ${} should be literal in raw strings
	s: String = raw"hello ${name}"
	s.length() == 13


tests: TestSuite = {
	description = "Raw string literals",
	tests = [
		("backslash n is literal", test_raw_string_backslash_n),
		("backslash t is literal", test_raw_string_backslash_t),
		("windows path", test_raw_string_path),
		("regex pattern", test_raw_string_regex),
		("single backslash", test_raw_string_single_backslash),
		("no interpolation", test_raw_string_no_interpolation),
	]
}
