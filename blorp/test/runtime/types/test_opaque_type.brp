import:
	test: TestSuite


opaque type Email = String

opaque type UserId = Int


pure func email(raw: String) -> Email:
	into Email(raw)


pure func email_value(value: Email) -> String:
	from Email(value)


pure func user_id(raw: Int) -> UserId:
	into UserId(raw)


pure func bump_user_id(value: UserId) -> UserId:
	into UserId(from UserId(value) + 1)


pure func user_id_value(value: UserId) -> Int:
	from UserId(value)


func test_string_backed_opaque_type() -> Bool:
	value: Email = email("admin@example.com")
	email_value(value) == "admin@example.com"


func test_int_backed_opaque_type() -> Bool:
	value: UserId = bump_user_id(user_id(41))
	user_id_value(value) == 42


tests: TestSuite = {
	description = "Opaque Types",
	tests = [
		("String-backed opaque type converts from inside module", test_string_backed_opaque_type),
		("Int-backed opaque type converts from inside module", test_int_backed_opaque_type),
	]
}
