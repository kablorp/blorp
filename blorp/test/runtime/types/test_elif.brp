-- Test chained else-if (elif) support
import:
	test: TestSuite


func classify(x: Int) -> String:
	if x > 100:
		"huge"
	else if x > 50:
		"large"
	else if x > 10:
		"medium"
	else if x > 0:
		"small"
	else:
		"zero or negative"


func test_huge() -> Bool:
	classify(200) == "huge"


func test_large() -> Bool:
	classify(75) == "large"


func test_medium() -> Bool:
	classify(25) == "medium"


func test_small() -> Bool:
	classify(5) == "small"


func test_zero() -> Bool:
	classify(0) == "zero or negative"


func test_negative() -> Bool:
	classify(-10) == "zero or negative"


tests: TestSuite = {
	description = "Chained else-if",
	tests = [
		("huge", test_huge),
		("large", test_large),
		("medium", test_medium),
		("small", test_small),
		("zero", test_zero),
		("negative", test_negative),
	]
}
