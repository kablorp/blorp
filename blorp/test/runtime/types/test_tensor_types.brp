import:
	debug: type_name
	matrix: transpose
	tensor: get, set_all, set_index
	test: TestSuite
	vector: cumulative_sum, dot, fold, lerp, map, scale, sum, to_list, zip


-- ============================================================================
-- Constructors: verify the type-checker sees correct dims after construction
-- ============================================================================
func test_vector_literal() -> Bool:
	type_name({1, 2, 3}) == "Int[#3]"


func test_vector_float_literal() -> Bool:
	type_name({1.0, 2.0}) == "Float[#2]"


func test_vector_builtin() -> Bool:
	v: Int[#5] = vector(0, 5)
	type_name(v) == "Int[#5]"


func test_matrix_builtin() -> Bool:
	m: Float[#2, #3] = matrix(0.0, 2, 3)
	type_name(m) == "Float[#2, #3]"


func test_tensor3_builtin() -> Bool:
	t: Int[#2, #3, #4] = tensor3(0, 2, 3, 4)
	type_name(t) == "Int[#2, #3, #4]"


-- ============================================================================
-- Postfix array syntax: rank is encoded on the scalar type
-- ============================================================================
func test_one_dim_array_type() -> Bool:
	v: Int[#3] = {1, 2, 3}
	type_name(v) == "Int[#3]"


func test_two_dim_array_type() -> Bool:
	m: Float[#2, #3] = matrix(0.0, 2, 3)
	type_name(m) == "Float[#2, #3]"


-- ============================================================================
-- Element types: different T in T[...]
-- ============================================================================
func test_vector_string() -> Bool:
	v: String[#2] = {"hello", "world"}
	type_name(v) == "String[#2]"


func test_vector_bool() -> Bool:
	v: Bool[#3] = {True, False, True}
	type_name(v) == "Bool[#3]"


-- ============================================================================
-- Operations: verify return types flow through correctly
-- ============================================================================
func test_get_return() -> Bool:
	v: Int[#3] = {1, 2, 3}
	type_name(get(v, 0)) == "Option[Int]"


func test_set_index_return() -> Bool:
	v: Int[#3] = {1, 2, 3}
	type_name(v.set_index(0, 99)) == "Option[Int[#3]]"


func test_sum_return() -> Bool:
	v: Int[#3] = {1, 2, 3}
	type_name(sum(v)) == "Int"


func test_dot_return() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: Int[#3] = {4, 5, 6}
	type_name(dot(a, b)) == "Int"


func test_cumulative_sum_return() -> Bool:
	v: Int[#3] = {1, 2, 3}
	type_name(cumulative_sum(v)) == "Int[#3]"


func test_to_list_return() -> Bool:
	v: Int[#3] = {1, 2, 3}
	type_name(to_list(v)) == "List[Int]"


-- ============================================================================
-- Arithmetic: tensor ops preserve dims
-- ============================================================================
func test_vector_add() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: Int[#3] = {4, 5, 6}
	type_name(a + b) == "Int[#3]"


func test_vector_scalar_mul() -> Bool:
	v: Int[#3] = {1, 2, 3}
	type_name(v * 2) == "Int[#3]"


func test_matrix_add() -> Bool:
	a: Float[#2, #3] = matrix(1.0, 2, 3)
	b: Float[#2, #3] = matrix(2.0, 2, 3)
	type_name(a + b) == "Float[#2, #3]"


-- ============================================================================
-- Matrix-specific: transpose
-- ============================================================================
func test_transpose_dims() -> Bool:
	m: Float[#2, #3] = matrix(1.0, 2, 3)
	type_name(transpose(m)) == "Float[#3, #2]"


-- ============================================================================
-- HOFs: map, fold, zip preserve/transform types
-- ============================================================================
func test_map_type() -> Bool:
	v: Int[#3] = {1, 2, 3}
	r = v.map(func(x: Int): x.to_float())
	type_name(r) == "Float[#3]"


func test_fold_type() -> Bool:
	v: Int[#3] = {1, 2, 3}
	type_name(v.fold("", func(acc: String, x: Int): acc + x.to_string())) == "String"


func test_zip_type() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: String[#3] = {"a", "b", "c"}
	type_name(a.zip(b)) == "(Int, String)[#3]"


-- ============================================================================
-- Variadic dim resolution: #Ds... flows through calls
-- ============================================================================
pure func passthrough(t: Int[#Ds...]) -> Int[#Ds...]:
	t


func test_vardims_1d() -> Bool:
	v: Int[#3] = {1, 2, 3}
	type_name(passthrough(v)) == "Int[#3]"


func test_vardims_2d() -> Bool:
	m: Int[#2, #3] = matrix(0, 2, 3)
	type_name(passthrough(m)) == "Int[#2, #3]"


func test_vardims_3d() -> Bool:
	t: Int[#2, #3, #4] = tensor3(0, 2, 3, 4)
	type_name(passthrough(t)) == "Int[#2, #3, #4]"


-- Two distinct vardim names resolve independently
pure func swap_order(a: Int[#As...], b: Int[#Bs...]) -> (Int[#Bs...], Int[#As...]):
	(b, a)


func test_vardims_distinct_resolution() -> Bool:
	v: Int[#3] = {1, 2, 3}
	m: Int[#2, #4] = matrix(0, 2, 4)
	r = swap_order(v, m)
	type_name(r) == "(Int[#2, #4], Int[#3])"


-- ============================================================================
-- scale/lerp: #N (single dim var) in Vector ops
-- ============================================================================
func test_scale_preserves_dim() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	type_name(scale(v, 2.0)) == "Float[#3]"


func test_lerp_preserves_dim() -> Bool:
	a: Float[#3] = {1.0, 2.0, 3.0}
	b: Float[#3] = {4.0, 5.0, 6.0}
	type_name(lerp(a, b, 0.5)) == "Float[#3]"


-- ============================================================================
-- set_all: #Ds... shared between param and return
-- ============================================================================
func test_set_all_preserves_1d() -> Bool:
	v: Int[#3] = {1, 2, 3}
	r: Int[#3] = set_all(v, 0)
	type_name(r) == "Int[#3]"


tests: TestSuite = {
	description = "Tensor type verification",
	tests = [
		("vector literal", test_vector_literal),
		("vector float literal", test_vector_float_literal),
		("vector()", test_vector_builtin),
		("matrix()", test_matrix_builtin),
		("tensor3()", test_tensor3_builtin),
		("one-dimensional array type", test_one_dim_array_type),
		("two-dimensional array type", test_two_dim_array_type),
		("String", test_vector_string),
		("Bool", test_vector_bool),
		("get return", test_get_return),
		("set_index return", test_set_index_return),
		("sum return", test_sum_return),
		("dot return", test_dot_return),
		("cumulative_sum return", test_cumulative_sum_return),
		("to_list return", test_to_list_return),
		("vector +", test_vector_add),
		("vector * scalar", test_vector_scalar_mul),
		("matrix +", test_matrix_add),
		("transpose dims", test_transpose_dims),
		("map type", test_map_type),
		("fold type", test_fold_type),
		("zip type", test_zip_type),
		("vardims 1D", test_vardims_1d),
		("vardims 2D", test_vardims_2d),
		("vardims 3D", test_vardims_3d),
		("vardims distinct", test_vardims_distinct_resolution),
		("scale preserves dim", test_scale_preserves_dim),
		("lerp preserves dim", test_lerp_preserves_dim),
		("set_all preserves 1D", test_set_all_preserves_1d),
	]
}
-- constructors
-- postfix array syntax
-- element types
-- operations
-- arithmetic
-- matrix ops
-- HOFs
-- variadic dims
-- vector ops with #N
-- set_all
