import:
	test: TestSuite


-- User-defined type with nullary constructor
union Color:
	Red
	Green
	Blue
	Custom(Int)


-- Test repeated None usage in a loop (singleton means no allocation churn)
func test_none_in_loop() -> Bool:
	var count: Int = 0

	for i in 0..100:
		opt: Option[Int] = None

		match opt:
			Some(_):
				void
			None:
				count += 1

	count == 100


-- Test None equality (both point to same singleton)
func test_none_eq() -> Bool:
	a: Option[Int] = None
	b: Option[Int] = None
	a == b


-- Test Some vs None still works
func test_some_vs_none() -> Bool:
	a: Option[Int] = Some(42)
	b: Option[Int] = None
	a != b


-- Test None from runtime function (list.get out of bounds)
func test_none_from_get() -> Bool:
	nums: List[Int] = [1, 2, 3]

	match nums.get(99):
		Some(_):
			False
		None:
			True


-- Test user-defined nullary constructors
func test_user_nullary() -> Bool:
	r: Color = Red
	g: Color = Green
	b: Color = Blue

	ok1: Bool = match r:
		Red:
			True
		Green:
			False
		Blue:
			False
		Custom(_):
			False

	ok2: Bool = match g:
		Red:
			False
		Green:
			True
		Blue:
			False
		Custom(_):
			False

	ok3: Bool = match b:
		Red:
			False
		Green:
			False
		Blue:
			True
		Custom(_):
			False

	ok1 and ok2 and ok3


-- Test user nullary in list
func test_nullary_in_list() -> Bool:
	colors: List[Color] = [Red, Green, Blue, Custom(255)]

	match colors.get(0):
		Some(c):
			match c:
				Red:
					True
				Green:
					False
				Blue:
					False
				Custom(_):
					False
		None:
			False


-- Test mixed nullary and field constructors
func test_mixed_constructors() -> Bool:
	colors: List[Color] = [Red, Custom(100), Green, Custom(200)]
	var red_count: Int = 0
	var custom_total: Int = 0

	for color in colors:
		match color:
			Red:
				red_count += 1
			Green:
				void
			Blue:
				void
			Custom(v):
				custom_total += v

	red_count == 1 and custom_total == 300


tests: TestSuite = {
	description = "Singleton nullary constructors",
	tests = [
		("None in loop", test_none_in_loop),
		("None equality", test_none_eq),
		("Some vs None", test_some_vs_none),
		("None from list.get", test_none_from_get),
		("user nullary constructors", test_user_nullary),
		("nullary in list", test_nullary_in_list),
		("mixed constructors", test_mixed_constructors),
	]
}
