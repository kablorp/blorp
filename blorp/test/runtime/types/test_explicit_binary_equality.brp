import:
	./helpers/explicit_binary_equality_impl: ImportedChoice
	./helpers/unrelated_equality_trait: builtin_scalar_equality
	system: append_file, mkstemp_path, read_file, remove_file
	test: TestSuite
	traits: Equatable


record ExplicitChoice {
	value: Int
}


-- Deliberately distinguish the selected methods from structural equality
-- and from each other: not_equals is an explicit override, not not(equals).
implements Equatable for ExplicitChoice:
	pure func equals(left: ExplicitChoice, right: ExplicitChoice) -> Bool:
		True

	pure func not_equals(left: ExplicitChoice, right: ExplicitChoice) -> Bool:
		True


LEFT: ExplicitChoice = {value = 1}

RIGHT: ExplicitChoice = {value = 2}

FOLDED_EQUAL: Bool = LEFT == RIGHT

FOLDED_NOT_EQUAL: Bool = LEFT != LEFT


pure func selected_equal(left: ExplicitChoice, right: ExplicitChoice) -> Bool:
	left == right


pure func selected_not_equal(left: ExplicitChoice, right: ExplicitChoice) -> Bool:
	left != right


func test_folded_equals_preserves_explicit_method() -> Bool:
	FOLDED_EQUAL


func test_folded_not_equals_preserves_explicit_override() -> Bool:
	FOLDED_NOT_EQUAL


func test_runtime_equals_preserves_explicit_method() -> Bool:
	selected_equal({value = 1}, {value = 2})


func test_runtime_not_equals_preserves_explicit_override() -> Bool:
	selected_not_equal({value = 1}, {value = 1})


IMPORTED_LEFT: ImportedChoice = {value = 1}

IMPORTED_RIGHT: ImportedChoice = {value = 2}

IMPORTED_FOLDED_EQUAL: Bool = IMPORTED_LEFT == IMPORTED_RIGHT

IMPORTED_FOLDED_NOT_EQUAL: Bool = IMPORTED_LEFT != IMPORTED_LEFT


func test_imported_implementation_resolves_receiver_alias() -> Bool:
	left: ImportedChoice = {value = 1}
	right: ImportedChoice = {value = 2}
	IMPORTED_FOLDED_EQUAL and IMPORTED_FOLDED_NOT_EQUAL and left == right and left != left


func trace_choice(path: String, label: String, value: Int) -> ExplicitChoice:
	_ = append_file(path, label)
	{value = value}


func test_binary_operands_run_once_in_source_order() -> Bool:
	match mkstemp_path("blorp_explicit_binary_order_"):
		Ok(path):
			equal: Bool = trace_choice(path, "A", 1) == trace_choice(path, "B", 2)
			unequal: Bool = trace_choice(path, "C", 1) != trace_choice(path, "D", 1)

			ordered = match read_file(path):
				Ok(contents):
					contents == "ABCD"
				Err(_):
					False

			_ = remove_file(path)
			equal and unequal and ordered
		Err(_):
			False


func test_namesake_trait_does_not_replace_builtin_scalar_equality() -> Bool:
	builtin_scalar_equality(1, 1) and not builtin_scalar_equality(1, 2)


union OrdinaryChoice:
	OrdinaryLeft
	OrdinaryRight


fixed union FixedChoice:
	FixedLeft
	FixedRight


implements Equatable for OrdinaryChoice:
	pure func equals(left: OrdinaryChoice, right: OrdinaryChoice) -> Bool:
		True

	pure func not_equals(left: OrdinaryChoice, right: OrdinaryChoice) -> Bool:
		True


implements Equatable for FixedChoice:
	pure func equals(left: FixedChoice, right: FixedChoice) -> Bool:
		True

	pure func not_equals(left: FixedChoice, right: FixedChoice) -> Bool:
		True


ORDINARY_FOLDED_EQUAL: Bool = OrdinaryLeft == OrdinaryRight

ORDINARY_FOLDED_NOT_EQUAL: Bool = OrdinaryLeft != OrdinaryLeft

FIXED_FOLDED_EQUAL: Bool = FixedLeft == FixedRight

FIXED_FOLDED_NOT_EQUAL: Bool = FixedLeft != FixedLeft


pure func ordinary_equal(left: OrdinaryChoice, right: OrdinaryChoice) -> Bool:
	left == right


pure func ordinary_not_equal(left: OrdinaryChoice, right: OrdinaryChoice) -> Bool:
	left != right


pure func fixed_equal(left: FixedChoice, right: FixedChoice) -> Bool:
	left == right


pure func fixed_not_equal(left: FixedChoice, right: FixedChoice) -> Bool:
	left != right


func test_ordinary_union_preserves_explicit_methods() -> Bool:
	(
		ORDINARY_FOLDED_EQUAL
		and ORDINARY_FOLDED_NOT_EQUAL
		and ordinary_equal(OrdinaryLeft, OrdinaryRight)
		and ordinary_not_equal(OrdinaryLeft, OrdinaryLeft)
	)


func test_fixed_union_preserves_explicit_methods() -> Bool:
	(
		FIXED_FOLDED_EQUAL
		and FIXED_FOLDED_NOT_EQUAL
		and fixed_equal(FixedLeft, FixedRight)
		and fixed_not_equal(FixedLeft, FixedLeft)
	)


tests: TestSuite = {
	description = "Explicit binary equality selection",
	tests = [
		("folded equals preserves explicit method", test_folded_equals_preserves_explicit_method),
		(
			"folded not_equals preserves explicit override",
			test_folded_not_equals_preserves_explicit_override,
		),
		("runtime equals preserves explicit method", test_runtime_equals_preserves_explicit_method),
		(
			"runtime not_equals preserves explicit override",
			test_runtime_not_equals_preserves_explicit_override,
		),
		(
			"imported implementation resolves receiver alias",
			test_imported_implementation_resolves_receiver_alias,
		),
		("binary operands run once in source order", test_binary_operands_run_once_in_source_order),
		(
			"namesake leaves builtin scalar equality unchanged",
			test_namesake_trait_does_not_replace_builtin_scalar_equality,
		),
		(
			"ordinary union preserves explicit methods",
			test_ordinary_union_preserves_explicit_methods,
		),
		("fixed union preserves explicit methods", test_fixed_union_preserves_explicit_methods),
	]
}
