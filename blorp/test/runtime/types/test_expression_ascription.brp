import:
	test: TestSuite


func accepts_float32(x: Float32) -> Bool:
	True


func accepts_int32(x: Int32) -> Bool:
	True


func list_len(xs: List[Int]) -> Int:
	xs.length()


func option_len(value: Option[String]) -> Int:
	match value:
		Some(s): s.length()
		None: 0


func test_numeric_argument_ascription() -> Bool:
	accepts_float32(1.5 as Float32) and accepts_int32(42 as Int32)


func test_collection_argument_ascription() -> Bool:
	list_len([] as List[Int]) == 0 and option_len(None as Option[String]) == 0


tests: TestSuite = {
	description = "Expression type ascription",
	tests = [
		("numeric argument ascription", test_numeric_argument_ascription),
		("collection argument ascription", test_collection_argument_ascription),
	]
}
