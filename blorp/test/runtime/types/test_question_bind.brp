import:
	list: get
	test: TestSuite


-- Helper for Result tests
func make_ok(x: Int) -> Result[Int, String]:
	Ok(x)


func make_err(msg: String) -> Result[Int, String]:
	Err(msg)


-- Option tests
func option_sum_first_two(xs: List[Int]) -> Option[Int]:
	a ?= xs.get(0)
	b ?= xs.get(1)
	Some(a + b)


func option_typed_double(xs: List[Int]) -> Option[Int]:
	a: Int ?= xs.get(0)
	Some(a * 2)


func option_plain_computation_value(xs: List[Int]) -> Option[Int]:
	a ?= xs.get(0)
	c: Int = a * 3
	b ?= xs.get(1)
	Some(c + b)


func option_float_sum(xs: List[Float]) -> Option[Float]:
	a ?= xs.get(0)
	b ?= xs.get(1)
	Some(a + b)


func option_string_concat(xs: List[String]) -> Option[String]:
	a ?= xs.get(0)
	b ?= xs.get(1)
	Some(a + b)


func option_first_bool(xs: List[Bool]) -> Option[Bool]:
	a ?= xs.get(0)
	Some(a)


func option_first_plus_one(xs: List[Int]) -> Option[Int]:
	x ?= xs.get(0)
	Some(x + 1)


func test_option_all_succeed() -> Bool:
	xs: List[Int] = [10, 20, 30]
	result: Option[Int] = option_sum_first_two(xs)
	result == Some(30)


func test_option_first_fails() -> Bool:
	xs: List[Int] = []
	result: Option[Int] = option_sum_first_two(xs)
	result == None


func test_option_second_fails() -> Bool:
	xs: List[Int] = [10]
	result: Option[Int] = option_sum_first_two(xs)
	result == None


func test_option_typed_binding() -> Bool:
	xs: List[Int] = [42]
	result: Option[Int] = option_typed_double(xs)
	result == Some(84)


func test_option_plain_computation() -> Bool:
	xs: List[Int] = [5, 10]
	result: Option[Int] = option_plain_computation_value(xs)
	result == Some(25)


func test_option_no_bindings() -> Bool:
	result: Option[Int] = Some(42)
	result == Some(42)


func test_option_float() -> Bool:
	xs: List[Float] = [1.5, 2.5]
	result: Option[Float] = option_float_sum(xs)
	match result:
		Some(x): x == 4.0
		None: False


func test_option_string() -> Bool:
	xs: List[String] = ["hello", " world"]
	result: Option[String] = option_string_concat(xs)
	result == Some("hello world")


func test_option_bool() -> Bool:
	xs: List[Bool] = [True]
	result: Option[Bool] = option_first_bool(xs)
	match result:
		Some(v): v == True
		None: False


-- Result tests
func result_sum_two(
	a_result: Result[Int, String],
	b_result: Result[Int, String],
) -> Result[Int, String]:
	a ?= a_result
	b ?= b_result
	Ok(a + b)


func test_result_all_succeed() -> Bool:
	result: Result[Int, String] = result_sum_two(make_ok(10), make_ok(20))
	match result:
		Ok(x): x == 30
		Err(_): False


func test_result_first_fails() -> Bool:
	result: Result[Int, String] = result_sum_two(make_err("oops"), make_ok(20))
	match result:
		Ok(_): False
		Err(e): e == "oops"


func test_result_propagates_err() -> Bool:
	result: Result[Int, String] = result_sum_two(make_ok(10), make_err("second failed"))
	match result:
		Ok(_): False
		Err(e): e == "second failed"


-- Direct ?= in a helper used from a variable declaration
func test_question_bind_in_var_decl() -> Bool:
	xs: List[Int] = [100]
	r: Option[Int] = option_first_plus_one(xs)
	r == Some(101)


tests: TestSuite = {
	description = "?= propagation tests",
	tests = [
		("option all succeed", test_option_all_succeed),
		("option first fails", test_option_first_fails),
		("option second fails", test_option_second_fails),
		("option typed binding", test_option_typed_binding),
		("option plain computation", test_option_plain_computation),
		("option no bindings", test_option_no_bindings),
		("option float", test_option_float),
		("option string", test_option_string),
		("option bool", test_option_bool),
		("result all succeed", test_result_all_succeed),
		("result first fails", test_result_first_fails),
		("result propagates err", test_result_propagates_err),
		("?= in var decl", test_question_bind_in_var_decl),
	]
}
