import:
	test: TestSuite


enum Direction:
	North
	South
	East
	West


enum Base:
	A
	C
	G
	T


type alias Nucleotide = Base


func test_match() -> Bool:
	d: Direction = North
	result: String = match d:
		North: "north"
		South: "south"
		East: "east"
		West: "west"
	result == "north"


func test_equality() -> Bool:
	A == A and North != South and East == East


func describe_base(b: Base) -> String:
	match b:
		A: "adenine"
		C: "cytosine"
		G: "guanine"
		T: "thymine"


func test_function_param() -> Bool:
	describe_base(G) == "guanine"


func identity_dir(d: Direction) -> Direction:
	d


func test_function_return() -> Bool:
	identity_dir(South) == South


func get_base() -> Base:
	G


func test_match_on_call_result() -> Bool:
	result: String = match get_base():
		A: "a"
		C: "c"
		G: "g"
		T: "t"
	result == "g"


func test_match_on_enum_alias() -> Bool:
	b: Nucleotide = C
	result: String = match b:
		A: "a"
		C: "c"
		G: "g"
		T: "t"
	result == "c"


func test_list_storage() -> Bool:
	bases: List[Base] = [A, C, G, T]
	bases.length() == 4


func test_list_get_set() -> Bool:
	bases: List[Base] = [A, C, G, T]
	updated: List[Base] = bases.set(1, T)
	first_ok: Bool = updated.get_or(0, A) == A
	second_ok: Bool = updated.get_or(1, A) == T
	third_ok: Bool = updated.get_or(2, A) == G
	default_ok: Bool = updated.get_or(99, C) == C
	first_ok and second_ok and third_ok and default_ok


func is_purine(b: Base) -> Bool:
	match b:
		A: True
		G: True
		_: False


func test_or_pattern() -> Bool:
	is_purine(A) and is_purine(G) and not is_purine(C)


func test_closure_capture() -> Bool:
	b: Base = T
	f: (Base) -> Bool = func(x: Base): x == b
	f(T) and not f(A)


tests: TestSuite = {
	description = "Enum Tests",
	tests = [
		("match on enum", test_match),
		("enum equality", test_equality),
		("enum as function parameter", test_function_param),
		("enum function return", test_function_return),
		("match on call result", test_match_on_call_result),
		("match on enum alias", test_match_on_enum_alias),
		("enum in list", test_list_storage),
		("enum list get/set", test_list_get_set),
		("wildcard pattern on enum", test_or_pattern),
		("closure capturing enum", test_closure_capture),
	]
}
