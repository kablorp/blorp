import:
	option: get_or
	test: TestSuite


struct Vec2 {
	x: Float,
	y: Float
}


func test_match_some() -> Bool:
	p: Vec2 = {
		x = 3.0,
		y = 4.0
	}
	opt: Option[Vec2] = Some(p)
	match opt:
		Some(v): v.x == 3.0 and v.y == 4.0
		None: False


func test_match_none() -> Bool:
	opt: Option[Vec2] = None
	match opt:
		Some(_): False
		None: True


func test_get_or() -> Bool:
	opt: Option[Vec2] = Some({
		x = 5.0,
		y = 6.0
	})
	v: Vec2 = opt.get_or({
		x = 0.0,
		y = 0.0
	})
	v.x == 5.0 and v.y == 6.0


func test_get_or_none() -> Bool:
	opt: Option[Vec2] = None
	v: Vec2 = opt.get_or({
		x = 9.0,
		y = 8.0
	})
	v.x == 9.0 and v.y == 8.0


tests: TestSuite = {
	description = "Option[Struct]",
	tests = [
		("match Some(struct)", test_match_some),
		("match None", test_match_none),
		("get_or Some", test_get_or),
		("get_or None", test_get_or_none),
	]
}
