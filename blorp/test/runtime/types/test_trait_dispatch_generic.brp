-- Generic-bound trait dispatch at runtime.
--
-- Companion to [test_trait_dispatch.brp] (which covers direct dispatch on
-- concrete types) and [test_numeric_traits.brp] (which covers stdlib
-- numeric-family bounds via operator desugaring). This file targets
-- user-written trait-method calls through a generic bound, and
-- supertrait-method calls through a subtrait bound — neither of which
-- is exercised elsewhere at runtime.
import:
	test: TestSuite


-- (1) Bounded-generic dispatch: [to_string(x)] where [x: T: Stringable]
-- must resolve through the bound, not error as "unknown function".
pure func show[T:Stringable](x: T) -> String:
	"<" + to_string(x) + ">"


func test_bounded_generic_dispatch() -> Bool:
	show(42) == "<42>" and show("hi") == "<hi>"


-- (2) Bounded-generic dispatch with user trait. Custom [Describe] trait,
-- impl for Int and String — a generic function must dispatch to the
-- right impl based on T's concrete type at the call site.
trait Describe:
	pure func describe_generic(val: Self) -> String


implements Describe for Int:
	pure func describe_generic(val: Int) -> String:
		"int:" + to_string(val)


implements Describe for String:
	pure func describe_generic(val: String) -> String:
		"str:" + val


pure func show_twice[T:Describe](x: T) -> String:
	describe_generic(x) + "," + describe_generic(x)


func test_user_trait_generic_dispatch() -> Bool:
	show_twice(7) == "int:7,int:7" and show_twice("ok") == "str:ok,str:ok"


-- (3) Supertrait dispatch: a function bounded by the subtrait must be
-- able to call supertrait methods on its parameter.
trait Printable:
	pure func show_value(value: Self) -> String


trait Detailed: Printable:
	pure func detail(value: Self) -> String


implements Printable for Int:
	pure func show_value(value: Int) -> String:
		"<" + to_string(value) + ">"


implements Detailed for Int:
	pure func detail(value: Int) -> String:
		"detail-" + to_string(value)


-- [x] has a [Detailed] bound; [show_value] is a [Printable] method,
-- reachable only via Detailed's supertrait relation.
pure func both[T:Detailed](x: T) -> String:
	show_value(x) + "/" + detail(x)


func test_supertrait_dispatch() -> Bool:
	both(5) == "<5>/detail-5"


tests: TestSuite = {
	description = "Generic-bound Trait Dispatch",
	tests = [
		("bounded-generic stdlib trait dispatch", test_bounded_generic_dispatch),
		("bounded-generic user trait dispatch", test_user_trait_generic_dispatch),
		("supertrait method via subtrait bound", test_supertrait_dispatch),
	]
}
