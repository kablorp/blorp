import:
	list: length
	test: TestSuite


-- Basic declarations and conversions
func test_int8_basic() -> Bool:
	x: Int8 = 42
	y: Int8 = -10
	to_int(x) == 42 and to_int(y) == -10


func test_int16_basic() -> Bool:
	x: Int16 = 1000
	y: Int16 = -500
	to_int(x) == 1000 and to_int(y) == -500


func test_int32_basic() -> Bool:
	x: Int32 = 100000
	to_int(x) == 100000


func test_uint8_basic() -> Bool:
	x: UInt8 = 200
	to_int(x) == 200


func test_uint16_basic() -> Bool:
	x: UInt16 = 50000
	to_int(x) == 50000


func test_uint32_basic() -> Bool:
	x: UInt32 = 3000000
	to_int(x) == 3000000


func test_uint64_basic() -> Bool:
	x: UInt64 = 100
	to_int(x) == 100


func test_int64_alias() -> Bool:
	x: Int64 = 42
	y: Int = 42
	to_int(x) == y


-- Same-type arithmetic
func test_int8_arithmetic() -> Bool:
	a: Int8 = 10
	b: Int8 = 3
	sum: Int8 = a + b
	diff: Int8 = a - b
	prod: Int8 = a * b
	quot: Int8 = a / b
	rem: Int8 = a % b
	to_int(
		sum,
	) == 13 and to_int(diff) == 7 and to_int(prod) == 30 and to_int(quot) == 3 and to_int(rem) == 1


func test_uint32_arithmetic() -> Bool:
	a: UInt32 = 100
	b: UInt32 = 30
	sum: UInt32 = a + b
	diff: UInt32 = a - b
	to_int(sum) == 130 and to_int(diff) == 70


-- Wrapping overflow
func test_int8_wrapping() -> Bool:
	x: Int8 = 127
	y: Int8 = 1
	z: Int8 = x + y
	to_int(z) == -128


func test_uint8_wrapping() -> Bool:
	x: UInt8 = 255
	y: UInt8 = 1
	z: UInt8 = x + y
	to_int(z) == 0


-- Conversions
func test_to_int8_truncation() -> Bool:
	x: Int = 256
	y: Int8 = to_int8(x)
	to_int(y) == 0


func test_to_uint8_from_negative() -> Bool:
	x: Int = -1
	y: UInt8 = to_uint8(x)
	to_int(y) == 255


func test_cross_width_conversion() -> Bool:
	x: Int8 = 42
	wide: Int32 = to_int32(x)
	narrow: Int8 = to_int8(wide)
	to_int(wide) == 42 and to_int(narrow) == 42


-- Comparison operators
func test_int8_comparison() -> Bool:
	a: Int8 = 10
	b: Int8 = 20
	a < b and b > a and a <= a and a != b and a == a


func test_uint16_comparison() -> Bool:
	a: UInt16 = 100
	b: UInt16 = 200
	a < b and b >= a


-- Negation on signed types
func test_int16_negation() -> Bool:
	x: Int16 = 42
	y: Int16 = -x
	to_int(y) == -42


-- Safe division by zero
func test_int8_safe_div() -> Bool:
	x: Int8 = 10
	y: Int8 = 0
	z: Int8 = x / y
	to_int(z) == 0


func test_uint32_safe_mod() -> Bool:
	x: UInt32 = 10
	y: UInt32 = 0
	z: UInt32 = x % y
	to_int(z) == 0


-- String interpolation
func test_int8_to_string() -> Bool:
	x: Int8 = 42
	s: String = "${x}"
	s == "42"


func test_uint16_to_string() -> Bool:
	x: UInt16 = 1000
	s: String = "${x}"
	s == "1000"


-- Function params and returns
pure func add_int8(a: Int8, b: Int8) -> Int8:
	a + b


func test_function_params() -> Bool:
	result: Int8 = add_int8(to_int8(10), to_int8(20))
	to_int(result) == 30


-- Option[Int8] pattern matching
func test_option_int8() -> Bool:
	x: Option[Int8] = Some(to_int8(42))
	result: Int = match x:
		Some(v): to_int(v)
		None: -1
	result == 42


func test_option_int8_none() -> Bool:
	x: Option[Int8] = None
	result: Int = match x:
		Some(v): to_int(v)
		None: -1
	result == -1


-- List[Int8] basics
func test_list_int8() -> Bool:
	xs: List[Int8] = [to_int8(1), to_int8(2), to_int8(3)]
	xs.length() == 3


-- Pattern matching on sized int literals
func test_int8_match() -> Bool:
	x: Int8 = 42
	result: Int = match x:
		0: 0
		42: 1
		_: 2
	result == 1


func test_uint8_match() -> Bool:
	x: UInt8 = 0
	result: String = match x:
		0: "zero"
		1: "one"
		_: "other"
	result == "zero"


func test_int8_match_wildcard() -> Bool:
	x: Int8 = 99
	result: Int = match x:
		0: 0
		1: 1
		_: -1
	result == -1


-- Bitwise operations on sized ints
func test_int8_bitwise() -> Bool:
	a: Int8 = 15
	b: Int8 = bit_and(a, to_int8(3))
	to_int(b) == 3


func test_uint8_shift() -> Bool:
	a: UInt8 = 1
	b: UInt8 = shift_left(a, 7)
	to_int(b) == 128


tests: TestSuite = {
	description = "Sized Integer Types",
	tests = [
		("Int8 basic", test_int8_basic),
		("Int16 basic", test_int16_basic),
		("Int32 basic", test_int32_basic),
		("UInt8 basic", test_uint8_basic),
		("UInt16 basic", test_uint16_basic),
		("UInt32 basic", test_uint32_basic),
		("UInt64 basic", test_uint64_basic),
		("Int64 alias", test_int64_alias),
		("Int8 arithmetic", test_int8_arithmetic),
		("UInt32 arithmetic", test_uint32_arithmetic),
		("Int8 wrapping overflow", test_int8_wrapping),
		("UInt8 wrapping overflow", test_uint8_wrapping),
		("to_int8 truncation", test_to_int8_truncation),
		("to_uint8 from negative", test_to_uint8_from_negative),
		("Cross-width conversion", test_cross_width_conversion),
		("Int8 comparison", test_int8_comparison),
		("UInt16 comparison", test_uint16_comparison),
		("Int16 negation", test_int16_negation),
		("Int8 safe div by zero", test_int8_safe_div),
		("UInt32 safe mod by zero", test_uint32_safe_mod),
		("Int8 to_string", test_int8_to_string),
		("UInt16 to_string", test_uint16_to_string),
		("Function params Int8", test_function_params),
		("Option[Int8] Some", test_option_int8),
		("Option[Int8] None", test_option_int8_none),
		("List[Int8] basic", test_list_int8),
		("Int8 pattern match", test_int8_match),
		("UInt8 pattern match", test_uint8_match),
		("Int8 match wildcard", test_int8_match_wildcard),
		("Int8 bitwise", test_int8_bitwise),
		("UInt8 shift", test_uint8_shift),
	]
}
