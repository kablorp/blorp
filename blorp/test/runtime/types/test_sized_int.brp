import:
	list: length
	test: TestSuite


-- Basic declarations and conversions
func test_int8_basic() -> Bool:
	x: Int8 = 42
	y: Int8 = -10
	to_int(x) == 42 and to_int(y) == -10


func test_int16_basic() -> Bool:
	x: Int16 = 1000
	y: Int16 = -500
	to_int(x) == 1000 and to_int(y) == -500


func test_int32_basic() -> Bool:
	x: Int32 = 100000
	to_int(x) == 100000


func test_uint8_basic() -> Bool:
	x: UInt8 = 200
	to_int(x) == 200


func test_uint16_basic() -> Bool:
	x: UInt16 = 50000
	to_int(x) == 50000


func test_uint32_basic() -> Bool:
	x: UInt32 = 3000000
	to_int(x) == 3000000


func test_uint64_basic() -> Bool:
	x: UInt64 = 100
	to_int(x) == 100


func test_int64_alias() -> Bool:
	x: Int64 = 42
	y: Int = 42
	to_int(x) == y


-- Same-type arithmetic
func test_int8_arithmetic() -> Bool:
	a: Int8 = 10
	b: Int8 = 3
	sum: Int8 = a + b
	diff: Int8 = a - b
	prod: Int8 = a * b
	quot: Int8 = a / b
	rem: Int8 = a % b
	(
		to_int(sum) == 13
		and to_int(diff) == 7
		and to_int(prod) == 30
		and to_int(quot) == 3
		and to_int(rem) == 1
	)


func test_uint32_arithmetic() -> Bool:
	a: UInt32 = 100
	b: UInt32 = 30
	sum: UInt32 = a + b
	diff: UInt32 = a - b
	to_int(sum) == 130 and to_int(diff) == 70


-- Wrapping overflow
func test_int8_wrapping() -> Bool:
	x: Int8 = 127
	y: Int8 = 1
	z: Int8 = x + y
	to_int(z) == -128


func test_uint8_wrapping() -> Bool:
	x: UInt8 = 255
	y: UInt8 = 1
	z: UInt8 = x + y
	to_int(z) == 0


-- Conversions
func test_to_int8_truncation() -> Bool:
	x: Int = 256
	y: Int8 = to_int8(x)
	to_int(y) == 0


func test_to_uint8_from_negative() -> Bool:
	x: Int = -1
	y: UInt8 = to_uint8(x)
	to_int(y) == 255


func test_cross_width_conversion() -> Bool:
	x: Int8 = 42
	wide: Int32 = to_int32(x)
	narrow: Int8 = to_int8(wide)
	to_int(wide) == 42 and to_int(narrow) == 42


-- Comparison operators
func test_int8_comparison() -> Bool:
	a: Int8 = 10
	b: Int8 = 20
	a < b and b > a and a <= a and a != b and a == a


func test_uint16_comparison() -> Bool:
	a: UInt16 = 100
	b: UInt16 = 200
	a < b and b >= a


-- Negation on signed types
func test_int16_negation() -> Bool:
	x: Int16 = 42
	y: Int16 = -x
	to_int(y) == -42


-- Safe division by zero
func test_int8_safe_div() -> Bool:
	x: Int8 = 10
	y: Int8 = 0
	z: Int8 = x / y
	to_int(z) == 0


func test_uint32_safe_mod() -> Bool:
	x: UInt32 = 10
	y: UInt32 = 0
	z: UInt32 = x % y
	to_int(z) == 0


-- String interpolation
func test_int8_to_string() -> Bool:
	x: Int8 = 42
	s: String = "${x}"
	s == "42"


func test_uint16_to_string() -> Bool:
	x: UInt16 = 1000
	s: String = "${x}"
	s == "1000"


-- Function params and returns
pure func add_int8(a: Int8, b: Int8) -> Int8:
	a + b


func test_function_params() -> Bool:
	result: Int8 = add_int8(to_int8(10), to_int8(20))
	to_int(result) == 30


-- Option[Int8] pattern matching
func test_option_int8() -> Bool:
	x: Option[Int8] = Some(to_int8(42))

	result: Int = match x:
		Some(v):
			to_int(v)
		None:
			-1

	result == 42


func test_option_int8_none() -> Bool:
	x: Option[Int8] = None

	result: Int = match x:
		Some(v):
			to_int(v)
		None:
			-1

	result == -1


-- List[Int8] basics
func test_list_int8() -> Bool:
	xs: List[Int8] = [to_int8(1), to_int8(2), to_int8(3)]
	xs.length() == 3


-- Narrow list elements are stored inline at their own width; formatting
-- must read them back with the element's signedness, not as raw bits.
func test_list_int8_to_string_negative() -> Bool:
	xs: List[Int8] = [to_int8(-5), to_int8(7), to_int8(-128), to_int8(127)]
	xs.to_string() == "[-5, 7, -128, 127]" and "${xs}" == "[-5, 7, -128, 127]"


func test_list_int16_to_string_negative() -> Bool:
	xs: List[Int16] = [to_int16(-20000), to_int16(3), to_int16(-32768), to_int16(-1)]
	xs.to_string() == "[-20000, 3, -32768, -1]" and "${xs}" == "[-20000, 3, -32768, -1]"


func test_list_int32_to_string_negative() -> Bool:
	xs: List[Int32] = [to_int32(-2000000000), to_int32(1), to_int32(-2147483648), to_int32(-7)]
	xs.to_string() == "[-2000000000, 1, -2147483648, -7]"


func test_list_unsigned_to_string_max() -> Bool:
	bytes: List[UInt8] = [to_uint8(255), to_uint8(0)]
	halves: List[UInt16] = [to_uint16(65535), to_uint16(1)]
	words: List[UInt32] = [to_uint32(4294967295), to_uint32(2)]
	(
		bytes.to_string() == "[255, 0]"
		and halves.to_string() == "[65535, 1]"
		and words.to_string() == "[4294967295, 2]"
	)


-- UInt64 values above Int's range must keep their unsigned value when
-- formatted, whether the value is computed at runtime or at compile time.
UINT64_MAX_CONSTANT: UInt64 = 18446744073709551615

UINT64_MAX_CONSTANT_TEXT: String = UINT64_MAX_CONSTANT.to_string()

UINT64_HALF_RANGE_CONSTANT: UInt64 = 9223372036854775808

UINT64_HALF_RANGE_CONSTANT_TEXT: String = "${UINT64_HALF_RANGE_CONSTANT}"

UINT64_MAX_TEXT: String = "18446744073709551615"

UINT64_TWO_CONSTANT: UInt64 = 2

UINT64_MAX_HALVED_CONSTANT: UInt64 = UINT64_MAX_CONSTANT / UINT64_TWO_CONSTANT

UINT64_MAX_ABOVE_TWO_CONSTANT: Bool = UINT64_MAX_CONSTANT > UINT64_TWO_CONSTANT

UINT64_MAX_PATTERN_CONSTANT: String = match UINT64_MAX_CONSTANT:
	18446744073709551615:
		"matched"
	_:
		"missed"


func uint64_text_through_stringable[T: Stringable](value: T) -> String:
	value.to_string()


func test_uint64_max_to_string() -> Bool:
	big: UInt64 = 18446744073709551615
	(
		big.to_string() == UINT64_MAX_TEXT
		and "${big}" == UINT64_MAX_TEXT
		and uint64_text_through_stringable(big) == UINT64_MAX_TEXT
	)


func test_uint64_compile_time_to_string_matches_runtime() -> Bool:
	(
		UINT64_MAX_CONSTANT.to_string() == UINT64_MAX_TEXT
		and UINT64_MAX_CONSTANT_TEXT == UINT64_MAX_TEXT
		and UINT64_HALF_RANGE_CONSTANT_TEXT == "9223372036854775808"
	)


-- Compile-time UInt64 arithmetic, ordering, and literal patterns read the
-- bits as unsigned, agreeing with the same operations at runtime.
func test_uint64_compile_time_ops_match_runtime() -> Bool:
	big: UInt64 = 18446744073709551615
	two: UInt64 = 2
	(
		UINT64_MAX_HALVED_CONSTANT == big / two
		and UINT64_MAX_HALVED_CONSTANT.to_string() == "9223372036854775807"
		and UINT64_MAX_ABOVE_TWO_CONSTANT
		and big > two
		and UINT64_MAX_PATTERN_CONSTANT == "matched"
	)


func test_list_uint64_to_string_max() -> Bool:
	big: UInt64 = 18446744073709551615
	half: UInt64 = 9223372036854775808
	zero: UInt64 = 0
	xs: List[UInt64] = [big, zero, half]
	expected: String = "[18446744073709551615, 0, 9223372036854775808]"
	xs.to_string() == expected and "${xs}" == expected


func test_list_narrow_signed_sort_to_string() -> Bool:
	bytes: List[Int8] = [to_int8(7), to_int8(-100), to_int8(-5)]
	halves: List[Int16] = [to_int16(3), to_int16(-20000), to_int16(-1)]
	words: List[Int32] = [to_int32(1), to_int32(-7), to_int32(-2000000000)]
	(
		bytes.sort().to_string() == "[-100, -5, 7]"
		and halves.sort().to_string() == "[-20000, -1, 3]"
		and words.sort_desc_by(func(x: Int32): x).to_string() == "[1, -7, -2000000000]"
	)


-- Pattern matching on sized int literals
func test_int8_match() -> Bool:
	x: Int8 = 42

	result: Int = match x:
		0:
			0
		42:
			1
		_:
			2

	result == 1


func test_uint8_match() -> Bool:
	x: UInt8 = 0

	result: String = match x:
		0:
			"zero"
		1:
			"one"
		_:
			"other"

	result == "zero"


func test_int8_match_wildcard() -> Bool:
	x: Int8 = 99

	result: Int = match x:
		0:
			0
		1:
			1
		_:
			-1

	result == -1


-- Bitwise operations on sized ints
func test_int8_bitwise() -> Bool:
	a: Int8 = 15
	b: Int8 = bit_and(a, to_int8(3))
	to_int(b) == 3


func test_uint8_shift() -> Bool:
	a: UInt8 = 1
	b: UInt8 = shift_left(a, 7)
	to_int(b) == 128


tests: TestSuite = {
	description = "Sized Integer Types",
	tests = [
		("Int8 basic", test_int8_basic),
		("Int16 basic", test_int16_basic),
		("Int32 basic", test_int32_basic),
		("UInt8 basic", test_uint8_basic),
		("UInt16 basic", test_uint16_basic),
		("UInt32 basic", test_uint32_basic),
		("UInt64 basic", test_uint64_basic),
		("Int64 alias", test_int64_alias),
		("Int8 arithmetic", test_int8_arithmetic),
		("UInt32 arithmetic", test_uint32_arithmetic),
		("Int8 wrapping overflow", test_int8_wrapping),
		("UInt8 wrapping overflow", test_uint8_wrapping),
		("to_int8 truncation", test_to_int8_truncation),
		("to_uint8 from negative", test_to_uint8_from_negative),
		("Cross-width conversion", test_cross_width_conversion),
		("Int8 comparison", test_int8_comparison),
		("UInt16 comparison", test_uint16_comparison),
		("Int16 negation", test_int16_negation),
		("Int8 safe div by zero", test_int8_safe_div),
		("UInt32 safe mod by zero", test_uint32_safe_mod),
		("Int8 to_string", test_int8_to_string),
		("UInt16 to_string", test_uint16_to_string),
		("Function params Int8", test_function_params),
		("Option[Int8] Some", test_option_int8),
		("Option[Int8] None", test_option_int8_none),
		("List[Int8] basic", test_list_int8),
		("List[Int8] to_string negative", test_list_int8_to_string_negative),
		("List[Int16] to_string negative", test_list_int16_to_string_negative),
		("List[Int32] to_string negative", test_list_int32_to_string_negative),
		("List[UInt*] to_string max", test_list_unsigned_to_string_max),
		("UInt64 max to_string", test_uint64_max_to_string),
		(
			"UInt64 compile-time to_string matches runtime",
			test_uint64_compile_time_to_string_matches_runtime,
		),
		(
			"UInt64 compile-time ops match runtime",
			test_uint64_compile_time_ops_match_runtime,
		),
		("List[UInt64] to_string max", test_list_uint64_to_string_max),
		("Narrow signed sort to_string", test_list_narrow_signed_sort_to_string),
		("Int8 pattern match", test_int8_match),
		("UInt8 pattern match", test_uint8_match),
		("Int8 match wildcard", test_int8_match_wildcard),
		("Int8 bitwise", test_int8_bitwise),
		("UInt8 shift", test_uint8_shift),
	]
}
