-- Test N-ary tuples (3 and 4 elements)
import:
	test: TestSuite


-- 3-tuple creation and indexed access
func test_triple_access() -> Bool:
	t: (Int, Int, Int) = (10, 20, 30)
	t[0] == 10 and t[1] == 20 and t[2] == 30


-- 4-tuple creation and indexed access
func test_quad_access() -> Bool:
	q: (Int, Int, Int, Int) = (1, 2, 3, 4)
	q[0] == 1 and q[1] == 2 and q[2] == 3 and q[3] == 4


-- Mixed types in 3-tuple
func test_mixed_triple() -> Bool:
	t: (Int, String, Bool) = (42, "hello", True)
	t[0] == 42 and t[1] == "hello" and t[2]


-- Mixed types in 4-tuple
func test_mixed_quad() -> Bool:
	q: (Int, String, Bool, Int) = (1, "world", False, 99)
	q[0] == 1 and q[1] == "world" and not q[2] and q[3] == 99


-- 3-tuple destructuring
func test_triple_destruct() -> Bool:
	(a, b, c) = (10, 20, 30)
	a == 10 and b == 20 and c == 30


-- 4-tuple destructuring
func test_quad_destruct() -> Bool:
	(a, b, c, d) = (1, 2, 3, 4)
	a == 1 and b == 2 and c == 3 and d == 4


-- 3-tuple pattern matching
func classify_triple(t: (Int, Int, Int)) -> String:
	match t:
		(0, 0, 0): "origin"
		(0, _, _): "yz-plane"
		(_, _, _): "other"


func test_triple_match() -> Bool:
	classify_triple(
		(0, 0, 0),
	) == "origin" and classify_triple(
		(0, 1, 2),
	) == "yz-plane" and classify_triple((1, 2, 3)) == "other"


-- 3-tuple pattern with binding
func extract_middle(t: (Int, Int, Int)) -> Int:
	match t:
		(_, m, _): m


func test_triple_bind() -> Bool:
	extract_middle((10, 42, 30)) == 42


-- 2-tuple indexed access
func test_pair_compat() -> Bool:
	p: (Int, Int) = (1, 2)
	p[0] == 1 and p[1] == 2


-- Wildcard in destructuring
func test_wildcard_destruct() -> Bool:
	(_, b, _) = (1, 42, 3)
	b == 42


-- 4-tuple destructuring with wildcard
func test_quad_wildcard() -> Bool:
	(_, _, c, _) = (1, 2, 99, 4)
	c == 99


tests: TestSuite = {
	description = "N-ary Tuples",
	tests = [
		("3-tuple access", test_triple_access),
		("4-tuple access", test_quad_access),
		("mixed 3-tuple", test_mixed_triple),
		("mixed 4-tuple", test_mixed_quad),
		("3-tuple destruct", test_triple_destruct),
		("4-tuple destruct", test_quad_destruct),
		("3-tuple match", test_triple_match),
		("3-tuple bind", test_triple_bind),
		("2-tuple compat", test_pair_compat),
		("wildcard destruct", test_wildcard_destruct),
		("4-tuple wildcard", test_quad_wildcard),
	]
}
