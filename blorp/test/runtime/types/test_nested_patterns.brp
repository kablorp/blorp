-- Test nested pattern destructuring at runtime
-- Note: Full nested generic types (Option[Option[Int]]) require monomorphization
-- support which is not yet implemented. These tests verify the pattern binding
-- codegen works correctly with simpler types.
import:
	test: TestSuite


-- Simple pattern with value extraction
func test_some_value() -> Bool:
	opt: Option[Int] = Some(42)
	result: Int = match opt:
		Some(x): x
		None: 0
	result == 42


func test_none_value() -> Bool:
	opt: Option[Int] = None
	result: Int = match opt:
		Some(x): x + 1
		None: -1
	result == -1


-- Wildcard with Some
func test_wildcard_fallback() -> Bool:
	opt: Option[Int] = Some(10)
	result: Int = match opt:
		Some(x): x * 2
		_: 0
	result == 20


-- Match on boolean expressions
func test_bool_match() -> Bool:
	x: Int = 5
	result: String = match x > 3:
		True: "big"
		False: "small"
	result == "big"


-- Integer pattern
func test_int_pattern() -> Bool:
	x: Int = 42
	result: Int = match x:
		0: 0
		1: 1
		_: 100
	result == 100


-- String pattern
func test_string_pattern() -> Bool:
	s: String = "hello"
	result: Int = match s:
		"hello": 1
		"world": 2
		_: 0
	result == 1


tests: TestSuite = {
	description = "Pattern Destructuring",
	tests = [
		("Some value extraction", test_some_value),
		("None fallback", test_none_value),
		("Wildcard fallback", test_wildcard_fallback),
		("Boolean match", test_bool_match),
		("Integer pattern", test_int_pattern),
		("String pattern", test_string_pattern),
	]
}
