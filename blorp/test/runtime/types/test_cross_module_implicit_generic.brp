-- Cross-module qualified calls to functions with implicit generic params.
-- Regression: lookup_module_func_type read from m.exports (parsed decls)
-- which had func_type_params = []. Even though the is_type_variable
-- heuristic worked for single-char names during infer, the TYPED decls
-- (post-typecheck persistence) carry the correct list. The fix switches
-- lookup to prefer m.typed_decls when available.
import:
	./helpers/implicit_generic_mod as M
	list: length
	test: TestSuite


func test_identity_int() -> Bool:
	M.identity(42) == 42


func test_identity_float() -> Bool:
	M.identity(3.14) == 3.14


func test_identity_string() -> Bool:
	M.identity("hello") == "hello"


func test_pick_first() -> Bool:
	M.pick_first(10, 20) == 10


func test_wrap_in_list() -> Bool:
	xs: List[Int] = M.wrap_in_list(99)
	xs.length() == 1


tests: TestSuite = {
	description = "Cross-module implicit generic params",
	tests = [
		("identity Int", test_identity_int),
		("identity Float", test_identity_float),
		("identity String", test_identity_string),
		("pick_first", test_pick_first),
		("wrap_in_list", test_wrap_in_list),
	]
}
