-- Regression: stdlib prelude-shadowed trait methods must not self-recurse.
--
-- Before the shadow guard in trait_resolve, stdlib impls like
-- `impl Stringable for Int` whose bodies call `val.to_string()` (a
-- delegation to the primitive handled by specialize) were rewritten
-- to `Stringable_to_string_Int(val)` — the method itself — producing
-- infinite recursion at runtime.
--
-- The Blorp Core trait resolver skips the rewrite when the target mangled
-- name equals the enclosing function's name.
import:
	test: TestSuite


func test_int_to_string() -> Bool:
	s: String = 42.to_string()
	s == "42"


func test_float_to_string() -> Bool:
	s: String = 3.14.to_string()
	s.starts_with("3.14")


func test_bool_to_string() -> Bool:
	a: String = True.to_string()
	b: String = False.to_string()
	a == "True" and b == "False"


-- Mutual recursion between two impl methods of the same trait must keep
-- working — the rewrite target differs from the enclosing function, so
-- the self-recursion guard must NOT fire.
trait Parity:
	pure func is_even(self: Self) -> Bool
	pure func is_odd(self: Self) -> Bool


record Nat {
	n: Int
}


implements Parity for Nat:
	pure func is_even(self: Nat) -> Bool:
		if self.n == 0:
			True
		else:
			n1: Nat = {n = self.n - 1}
			is_odd(n1)

	pure func is_odd(self: Nat) -> Bool:
		if self.n == 0:
			False
		else:
			n1: Nat = {n = self.n - 1}
			is_even(n1)


func test_mutual_trait_recursion() -> Bool:
	a: Nat = {n = 4}
	b: Nat = {n = 7}
	is_even(a) and is_odd(b)


tests: TestSuite = {
	description = "Trait Shadow Dispatch",
	tests = [
		("int to_string does not self-recurse", test_int_to_string),
		("float to_string does not self-recurse", test_float_to_string),
		("bool to_string does not self-recurse", test_bool_to_string),
		("mutual trait method recursion", test_mutual_trait_recursion),
	]
}
