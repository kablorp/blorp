import:
	float: approx_eq
	math: PI
	test: TestSuite
	units:
		Amplitude,
		DataSize,
		Db,
		Degrees,
		Duration,
		Hz,
		Meters,
		MidiNote,
		Milliseconds,
		Pixels,
		Radians,
		Ratio,
		Samples,
		Seconds,
		amp,
		amp_to_db,
		amplitude_value,
		data_size_bytes,
		days,
		db,
		db_to_amp,
		db_value,
		deg,
		degrees_value,
		dur_to_sec,
		format_duration,
		format_size_iec,
		format_size_si,
		fraction,
		gigabytes,
		hours,
		hz,
		hz_to_midi,
		hz_to_period,
		hz_value,
		kibibytes,
		kilobytes,
		megabytes,
		meters,
		meters_value,
		microseconds,
		midi,
		midi_note_value,
		midi_to_hz,
		milliseconds,
		milliseconds_value,
		minutes,
		ms,
		ms_to_sec,
		percent,
		period_to_hz,
		pixels_value,
		px,
		rad,
		radians_value,
		ratio_value,
		samples,
		samples_to_sec,
		samples_value,
		sec,
		sec_to_dur,
		sec_to_ms,
		sec_to_samples,
		seconds_value,
		to_degrees,
		to_microseconds,
		to_percent,
		to_radians,
		to_timeout_milliseconds,
		weeks,


-- Angle tests
func test_radians_arithmetic() -> Bool:
	a: Radians = rad(1.0)
	b: Radians = rad(2.0)
	c: Radians = a + b
	radians_value(c) == 3.0


func test_degrees_arithmetic() -> Bool:
	a: Degrees = deg(90.0)
	b: Degrees = deg(45.0)
	c: Degrees = a - b
	degrees_value(c) == 45.0


func test_angle_conversion() -> Bool:
	r: Radians = to_radians(deg(90.0))
	d: Degrees = to_degrees(r)
	approx_eq(degrees_value(d), 90.0)


func test_radians_comparison() -> Bool:
	a: Radians = rad(1.0)
	b: Radians = rad(2.0)
	a < b and b > a and a <= a and a == a


func test_degrees_negation() -> Bool:
	d: Degrees = deg(45.0)
	n: Degrees = -d
	degrees_value(n) == -45.0


-- Time tests
func test_seconds_arithmetic() -> Bool:
	a: Seconds = sec(1.5)
	b: Seconds = sec(0.5)
	c: Seconds = a + b
	seconds_value(c) == 2.0


func test_milliseconds_arithmetic() -> Bool:
	a: Milliseconds = ms(100.0)
	b: Milliseconds = ms(50.0)
	c: Milliseconds = a + b
	milliseconds_value(c) == 150.0


func test_time_conversion() -> Bool:
	m: Milliseconds = sec_to_ms(sec(2.5))
	s: Seconds = ms_to_sec(m)
	approx_eq(seconds_value(s), 2.5)


func test_duration_arithmetic() -> Bool:
	a: Duration = milliseconds(100)
	b: Duration = milliseconds(200)
	c: Duration = a + b
	to_microseconds(c) == 300000


func test_duration_larger_constructors() -> Bool:
	minutes(
		2,
	).to_microseconds() == 120000000 and hours(
		1,
	).to_microseconds() == 3600000000 and days(
		1,
	).to_microseconds() == 86400000000 and weeks(1).to_microseconds() == 604800000000


func test_duration_raw_microseconds() -> Bool:
	to_microseconds(milliseconds(3)) == 3000


func test_duration_timeout_milliseconds_rounds_up() -> Bool:
	to_timeout_milliseconds(
		microseconds(
			1,
		),
	) == 1 and to_timeout_milliseconds(
		microseconds(1000),
	) == 1 and to_timeout_milliseconds(microseconds(1001)) == 2


func test_duration_timeout_milliseconds_non_positive() -> Bool:
	to_timeout_milliseconds(microseconds(0)) == 0 and to_timeout_milliseconds(microseconds(-1)) == 0


func test_duration_format() -> Bool:
	format_duration(microseconds(42)) == "42 microseconds"


func test_duration_seconds_roundtrip() -> Bool:
	d: Duration = sec_to_dur(sec(1.5))
	s: Seconds = dur_to_sec(d)
	approx_eq(seconds_value(s), 1.5)


-- Space tests
func test_meters_arithmetic() -> Bool:
	a: Meters = meters(10.0)
	b: Meters = meters(5.0)
	c: Meters = a + b
	meters_value(c) == 15.0


func test_pixels_arithmetic() -> Bool:
	a: Pixels = px(320.0)
	b: Pixels = px(160.0)
	c: Pixels = a - b
	pixels_value(c) == 160.0


-- Audio tests
func test_hz_arithmetic() -> Bool:
	a: Hz = hz(440.0)
	b: Hz = hz(220.0)
	c: Hz = a - b
	hz_value(c) == 220.0


func test_db_amplitude_roundtrip() -> Bool:
	a: Amplitude = amp(0.5)
	d: Db = amp_to_db(a)
	a2: Amplitude = db_to_amp(d)
	approx_eq(amplitude_value(a2), 0.5)


func test_midi_hz_roundtrip() -> Bool:
	n: MidiNote = midi(69)
	f: Hz = midi_to_hz(n)
	n2: MidiNote = hz_to_midi(f)
	midi_note_value(n2) == 69


func test_hz_period_roundtrip() -> Bool:
	f: Hz = hz(1000.0)
	p: Seconds = hz_to_period(f)
	f2: Hz = period_to_hz(p)
	approx_eq(hz_value(f2), 1000.0)


func test_samples_conversion() -> Bool:
	rate: Hz = hz(44100.0)
	s: Samples = sec_to_samples(sec(0.1), rate)
	t: Seconds = samples_to_sec(s, rate)
	samples_value(s) == 4410 and approx_eq(seconds_value(t), 0.1)


func test_samples_arithmetic() -> Bool:
	a: Samples = samples(1000)
	b: Samples = samples(500)
	c: Samples = a + b
	samples_value(c) == 1500


-- Data tests
func test_data_size_arithmetic() -> Bool:
	a: DataSize = kilobytes(10)
	b: DataSize = kilobytes(5)
	c: DataSize = a + b
	data_size_bytes(c) == 15000


func test_data_size_comparison() -> Bool:
	a: DataSize = megabytes(1)
	b: DataSize = kilobytes(500)
	a > b


func test_data_size_format() -> Bool:
	format_size_si(gigabytes(2)) == "2 GB"


func test_data_size_iec_format() -> Bool:
	format_size_iec(kibibytes(1)) == "1 KiB"


-- Ratio tests
func test_ratio_from_percent() -> Bool:
	r: Ratio = percent(75.0)
	approx_eq(ratio_value(r), 0.75)


func test_ratio_to_percent() -> Bool:
	r: Ratio = fraction(0.25)
	to_percent(r) == 25.0


func test_ratio_arithmetic() -> Bool:
	a: Ratio = fraction(0.3)
	b: Ratio = fraction(0.2)
	c: Ratio = a + b
	approx_eq(ratio_value(c), 0.5)


-- Type safety: different unit types should be distinct
-- (These test that the compiler correctly distinguishes types)
func test_type_safety_angles() -> Bool:
	-- Radians and Degrees are different types
	-- Both can coexist without confusion
	r: Radians = rad(PI)
	d: Degrees = deg(180.0)
	radians_value(r) > 3.0 and degrees_value(d) == 180.0


func test_type_safety_space() -> Bool:
	-- Meters and Pixels are different types
	m: Meters = meters(10.0)
	p: Pixels = px(100.0)
	meters_value(m) == 10.0 and pixels_value(p) == 100.0


func test_type_safety_audio() -> Bool:
	-- Hz, Db, Amplitude are distinct
	f: Hz = hz(440.0)
	d: Db = db(-6.0)
	a: Amplitude = amp(0.5)
	hz_value(f) == 440.0 and db_value(d) == -6.0 and amplitude_value(a) == 0.5


tests: TestSuite = {
	description = "Units",
	tests = [
		("radians arithmetic", test_radians_arithmetic),
		("degrees arithmetic", test_degrees_arithmetic),
		("angle conversion roundtrip", test_angle_conversion),
		("radians comparison", test_radians_comparison),
		("degrees negation", test_degrees_negation),
		("seconds arithmetic", test_seconds_arithmetic),
		("milliseconds arithmetic", test_milliseconds_arithmetic),
		("time conversion roundtrip", test_time_conversion),
		("duration arithmetic", test_duration_arithmetic),
		("duration larger constructors", test_duration_larger_constructors),
		("duration raw microseconds", test_duration_raw_microseconds),
		("duration timeout milliseconds rounds up", test_duration_timeout_milliseconds_rounds_up),
		(
			"duration timeout milliseconds non-positive",
			test_duration_timeout_milliseconds_non_positive,
		),
		("duration format", test_duration_format),
		("duration-seconds roundtrip", test_duration_seconds_roundtrip),
		("meters arithmetic", test_meters_arithmetic),
		("pixels arithmetic", test_pixels_arithmetic),
		("hz arithmetic", test_hz_arithmetic),
		("db-amplitude roundtrip", test_db_amplitude_roundtrip),
		("midi-hz roundtrip", test_midi_hz_roundtrip),
		("hz-period roundtrip", test_hz_period_roundtrip),
		("samples conversion", test_samples_conversion),
		("samples arithmetic", test_samples_arithmetic),
		("data size arithmetic", test_data_size_arithmetic),
		("data size comparison", test_data_size_comparison),
		("data size format si", test_data_size_format),
		("data size format iec", test_data_size_iec_format),
		("ratio from percent", test_ratio_from_percent),
		("ratio to percent", test_ratio_to_percent),
		("ratio arithmetic", test_ratio_arithmetic),
		("type safety angles", test_type_safety_angles),
		("type safety space", test_type_safety_space),
		("type safety audio", test_type_safety_audio),
	]
}
