import:
	./helpers/opaque_cycle_ids: edge_sum, link, make_node, node_ids, node_number, renumbered
	./helpers/opaque_cycle_syntax: Edge(Detached), node_id
	test: TestSuite


-- The id module builds values of records and unions declared by a module
-- that imports its opaque type back; the cycle must compile and keep the
-- wrapped value intact through each of them.
func test_record_built_inside_cycle_keeps_id() -> Bool:
	node = renumbered(
		make_node(1, "a"),
		5,
	)
	node_number(node_id(node)) == 5 and node.label == "a'"


func test_union_built_inside_cycle_keeps_ids() -> Bool:
	edge_sum(link(make_node(2, "a"), make_node(3, "b"))) == 5 and edge_sum(Detached) == 0


func test_alias_list_built_inside_cycle_keeps_ids() -> Bool:
	ids = node_ids([make_node(4, "a"), make_node(6, "b")])
	ids.length() == 2 and ids.map(func(id): node_number(id)) == [4, 6]


tests: TestSuite = {
	description = "Opaque Import Cycle",
	tests = [
		("record built inside cycle keeps id", test_record_built_inside_cycle_keeps_id),
		("union built inside cycle keeps ids", test_union_built_inside_cycle_keeps_ids),
		("alias list built inside cycle keeps ids", test_alias_list_built_inside_cycle_keeps_ids),
	]
}
