-- Deterministic test: primitives, operators, control flow, string interpolation
import:
	test: TestSuite


-- Int literals and arithmetic
func test_int_arithmetic() -> Bool:
	a: Int = 10
	b: Int = 3
	a + b == 13 and a - b == 7 and a * b == 30 and a / b == 3 and a % b == 1


-- Float literals and arithmetic
func test_float_arithmetic() -> Bool:
	a: Float = 10.0
	b: Float = 3.0
	a + b == 13.0 and a - b == 7.0 and a * b == 30.0


-- Bool literals and logical operators
func test_bool_logic() -> Bool:
	True and True and not False and (True or False) and not (False and True)


-- Char literals and comparison
func test_char_basics() -> Bool:
	a: Char = 'a'
	b: Char = 'b'
	a != b and a < b and a == 'a'


-- Unary operators
func test_unary_ops() -> Bool:
	x: Int = 42
	y: Float = 3.14
	-x == -42 and -y < 0.0 and not False == True


-- Comparison operators (all 6)
func test_comparisons() -> Bool:
	1 < 2 and 2 > 1 and 1 <= 1 and 2 >= 2 and 1 == 1 and 1 != 2


-- If/else expression
pure func test_if_expr() -> Bool:
	x: Int = if True:
		42
	else:
		0
	y: Int = if False:
		0
	else:
		99
	x == 42 and y == 99


-- Elif chaining
pure func test_elif() -> Bool:
	val: Int = 0
	result: Int = if val > 0:
		1
	else if val < 0:
		-1
	else:
		0
	result == 0


-- While loop with accumulator
func test_while_loop() -> Bool:
	var i: Int = 0
	var total: Int = 0
	while i < 10:
		total += i
		i += 1
	total == 45


-- For-range loop
func test_for_range() -> Bool:
	var total: Int = 0
	for i in 0..5:
		total += i
	total == 10


-- Break in loop
func test_break() -> Bool:
	var total: Int = 0
	for i in 0..100:
		if i == 5:
			break
		total += i
	total == 10


-- Continue in loop
func test_continue() -> Bool:
	var total: Int = 0
	for i in 0..10:
		if i % 2 == 0:
			continue
		total += i
	total == 25


-- Mutable variable assignment
func test_var_assign() -> Bool:
	var x: Int = 0
	x = 10
	x += 5
	x -= 2
	x *= 3
	x == 39


-- Nested control flow
func test_nested_control() -> Bool:
	var count: Int = 0
	for i in 0..5:
		for j in 0..5:
			if i + j > 3:
				count += 1
	count == 15


-- Type conversions
func test_type_conversions() -> Bool:
	to_float(42) == 42.0 and to_int(3.7) == 3 and to_bool(1) == True and to_bool(0) == False


-- abs/min/max
func test_abs_min_max() -> Bool:
	abs(-5) == 5 and abs(5) == 5


-- String interpolation
func test_string_interp() -> Bool:
	x: Int = 42
	s: String = "val=${x}"
	s == "val=42"


-- String comparison and concat
func test_string_ops() -> Bool:
	a: String = "hello"
	b: String = " world"
	a + b == "hello world" and a != b


-- to_string for various types
func test_to_string() -> Bool:
	42.to_string() == "42" and True.to_string() == "True" and 3.14.to_string() == "3.14"


-- Integer division by zero returns 0 (safe)
func test_safe_div() -> Bool:
	10 / 0 == 0 and 10 % 0 == 0


tests: TestSuite = {
	description = "Deterministic: Primitives and Control Flow",
	tests = [
		("Int arithmetic", test_int_arithmetic),
		("Float arithmetic", test_float_arithmetic),
		("Bool logic", test_bool_logic),
		("Char basics", test_char_basics),
		("Unary operators", test_unary_ops),
		("Comparison operators", test_comparisons),
		("If/else expression", test_if_expr),
		("Elif chaining", test_elif),
		("While loop", test_while_loop),
		("For-range loop", test_for_range),
		("Break in loop", test_break),
		("Continue in loop", test_continue),
		("Mutable variable assignment", test_var_assign),
		("Nested control flow", test_nested_control),
		("Type conversions", test_type_conversions),
		("abs/min/max", test_abs_min_max),
		("String interpolation", test_string_interp),
		("String ops", test_string_ops),
		("to_string", test_to_string),
		("Safe division by zero", test_safe_div),
	]
}
