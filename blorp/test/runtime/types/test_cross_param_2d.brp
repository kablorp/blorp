import:
	test: TestSuite


-- 2D cross-parameter constraints: ..#H and ..#W reference grid dimensions
pure func tile_at[T, #H, #W](grid: T[#H, #W], row: ..#H, col: ..#W) -> T:
	grid[row, col]


pure func test_tile_at_basic() -> Bool:
	grid: Int[#3, #4] = matrix(0, 3, 4)
	tile_at(grid, 0, 0) == 0


pure func test_tile_at_loop() -> Bool:
	grid: Int[#3, #4] = matrix(1, 3, 4)
	var sum: Int = 0
	for row in 0..3:
		for col in 0..4:
			sum += tile_at(grid, row, col)
	sum == 12


pure func safe_get[T, #N](arr: T[#N], i: ..#N) -> T:
	arr[i]


pure func test_1d_cross_param() -> Bool:
	v: Int[#5] = {10, 20, 30, 40, 50}
	var ok: Bool = True
	for i in 0..5:
		if safe_get(v, i) != (i + 1) * 10:
			ok = False
	ok


tests: TestSuite = {
	description = "Cross-Parameter Dimension Constraints",
	tests = [
		("2D tile_at basic", test_tile_at_basic),
		("2D tile_at loop sum", test_tile_at_loop),
		("1D safe_get cross-param", test_1d_cross_param),
	]
}
