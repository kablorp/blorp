import:
	dict as D
	memory: MemStats, get_mem_stats, reset_mem_stats
	string: parse_int
	tensor as T
	test: TestSuite


type alias MaybeFloat = Option[Float]


struct StackPoint {
	x: Int,
	y: Int
}


enum StackColor:
	StackRed
	StackBlue


-- ============================================================================
-- Basic: Some/None construction and match for primitive types
-- ============================================================================
func test_option_int_some() -> Bool:
	match Some(42):
		Some(v):
			v == 42
		None:
			False


func test_option_int_none() -> Bool:
	x: Option[Int] = None

	match x:
		Some(_):
			False
		None:
			True


func test_option_float_some() -> Bool:
	match Some(3.14):
		Some(v):
			v == 3.14
		None:
			False


func test_option_bool_some() -> Bool:
	match Some(True):
		Some(v):
			v
		None:
			False


-- ============================================================================
-- Memory: direct match on Some/None should not heap-allocate
-- ============================================================================
func test_option_int_no_alloc() -> Bool:
	reset_mem_stats()
	var i: Int = 0

	while i < 1000:
		-- Direct match on Some — constant folding eliminates the Option
		match Some(i):
			Some(v):
				i = v + 1
			None:
				i += 1

	stats: MemStats = get_mem_stats()
	stats.total_allocations < 10


func test_option_float_no_alloc() -> Bool:
	reset_mem_stats()
	var i: Int = 0

	while i < 1000:
		match Some(to_float(i)):
			Some(_):
				i += 1
			None:
				i += 1

	stats: MemStats = get_mem_stats()
	stats.total_allocations < 10


func test_option_string_allocates_only_payload() -> Bool:
	reset_mem_stats()
	var i: Int = 0

	while i < 1000:
		opt: Option[String] = if i % 2 == 0:
			Some("hello")
		else:
			None

		match opt:
			Some(s):
				if s.length() > 0:
					i += 1
				else:
					i += 1
			None:
				i += 1

	stats: MemStats = get_mem_stats()

	stats.total_allocations == 500 and stats.total_releases == 500 and stats.current_objects == 0


func make_owned_string() -> String:
	"he" + "llo"


func unwrap_owned_string_option() -> String:
	match Some(make_owned_string()):
		Some(s):
			s
		None:
			"fallback"


func test_option_string_owned_payload() -> Bool:
	unwrap_owned_string_option() == "hello"


func first_or_default(xs: Option[List[Int]]) -> Int:
	match xs:
		Some([head, ...rest]):
			head
		Some([]):
			0
		None:
			-1
		_:
			-2


func test_nullable_option_list_nested_pattern() -> Bool:
	(
		first_or_default(Some([7, 8, 9])) == 7
		and first_or_default(Some([])) == 0
		and first_or_default(None) == -1
	)


-- ============================================================================
-- If-expression returning Option
-- ============================================================================
func test_option_if_expr() -> Bool:
	val: Int = 5

	result: Option[Int] = if val > 0:
		Some(val)
	else:
		None

	match result:
		Some(v):
			v == 5
		None:
			False


func test_builtin_parse_int_stack_option() -> Bool:
	match parse_int("42"):
		Some(v):
			v == 42
		None:
			False


func test_list_of_option_int_stack_storage() -> Bool:
	xs: List[Option[Int]] = [Some(1), None, Some(3)]
	var count: Int = 0

	for item in xs:
		match item:
			Some(_):
				count += 1
			None:
				count = count

	count == 2


func test_tuple_of_option_float_stack_storage() -> Bool:
	pair: (Option[Float], Option[Float]) = (Some(1.0), Some(5.0))

	match pair:
		(Some(lo), Some(hi)):
			hi - lo == 4.0
		_:
			False


func test_dict_get_int_stack_option() -> Bool:
	d: Dict[String, Int] = D.set(D.dict(), "answer", 42)

	match D.get(d, "answer"):
		Some(v):
			v == 42
		None:
			False


func test_dict_get_float_stack_option() -> Bool:
	d: Dict[String, Float] = D.set(D.dict(), "pi", 3.5)

	match D.get(d, "pi"):
		Some(v):
			v > 3.4 and v < 3.6
		None:
			False


func test_dict_get_float_alias_stack_option() -> Bool:
	d: Dict[String, Float] = D.set(D.dict(), "pi", 3.5)
	got: MaybeFloat = D.get(d, "pi")

	match got:
		Some(v):
			v > 3.4 and v < 3.6
		None:
			False


func test_dict_get_bool_stack_option() -> Bool:
	d: Dict[String, Bool] = D.set(D.dict(), "ok", True)

	match D.get(d, "ok"):
		Some(v):
			v
		None:
			False


func test_dict_get_char_stack_option() -> Bool:
	d: Dict[String, Char] = D.set(D.dict(), "letter", 'Z')

	match D.get(d, "letter"):
		Some(v):
			v == 'Z'
		None:
			False


func test_dict_get_int32_stack_option() -> Bool:
	d: Dict[String, Int32] = D.set(D.dict(), "answer", to_int32(42))

	match D.get(d, "answer"):
		Some(v):
			v == to_int32(42)
		None:
			False


func test_dict_get_uint8_stack_option() -> Bool:
	d: Dict[String, UInt8] = D.set(D.dict(), "byte", to_uint8(200))

	match D.get(d, "byte"):
		Some(v):
			v == to_uint8(200)
		None:
			False


func test_dict_get_string_nullable_option() -> Bool:
	d: Dict[Int, String] = D.set(D.dict(), 42, "hello")

	match D.get(d, 42):
		Some(v):
			v == "hello"
		None:
			False


func test_list_get_string_nullable_option_no_alloc() -> Bool:
	xs: List[String] = ["hello"]
	reset_mem_stats()
	var i: Int = 0

	while i < 1000:
		match xs.get(0):
			Some(v):
				if v.length() > 0:
					i += 1
				else:
					i += 1
			None:
				i += 1

	stats: MemStats = get_mem_stats()
	stats.total_allocations < 10


func nested_option_list_get_matches(xs: List[Option[String]]) -> Bool:
	match xs.get(0):
		Some(Some(value)):
			value == "hello"
		Some(None):
			False
		None:
			False


func test_nested_option_list_get_preserves_list_owner() -> Bool:
	xs: List[Option[String]] = [Some("hello")]
	nested_option_list_get_matches(xs) and nested_option_list_get_matches(xs)


func apply_option_return(f: (Int) -> Option[Int]) -> Option[Int]:
	f(41)


func test_stack_option_closure_return_releases_box() -> Bool:
	reset_mem_stats()
	result: Option[Int] = apply_option_return(func(x: Int) -> Option[Int]: Some(x + 1))
	stats: MemStats = get_mem_stats()

	match result:
		Some(v):
			v == 42 and stats.current_objects == 0
		None:
			False


func apply_option_arg(f: (Option[Int]) -> Int) -> Int:
	f(Some(41))


func test_stack_option_closure_arg_releases_box() -> Bool:
	reset_mem_stats()
	result: Int = apply_option_arg(func(x: Option[Int]) -> Int:
		match x:
			Some(v):
				v + 1
			None:
				0
	)
	stats: MemStats = get_mem_stats()
	result == 42 and stats.current_objects == 0


tests: TestSuite = {
	description = "Stack-allocated Option",
	tests = [
		("Option[Int] Some", test_option_int_some),
		("Option[Int] None", test_option_int_none),
		("Option[Float] Some", test_option_float_some),
		("Option[Bool] Some", test_option_bool_some),
		("Option[Int] no alloc", test_option_int_no_alloc),
		("Option[Float] no alloc", test_option_float_no_alloc),
		("Option[String] allocates only payload", test_option_string_allocates_only_payload),
		("Option[String] owned payload", test_option_string_owned_payload),
		("Option[List[Int]] nested pattern", test_nullable_option_list_nested_pattern),
		("Option if-expression", test_option_if_expr),
		("Option[Int32]", test_option_int32),
		("Option[Float32]", test_option_float32),
		("Option[Char]", test_option_char),
		("Option[Bool] false", test_option_bool_false),
		("Option[Int128]", test_option_int128),
		("Option[UInt128]", test_option_uint128),
		("Option[range]", test_option_range),
		("Option[enum]", test_option_enum),
		("Option[struct]", test_option_value_record),
		("Option None default", test_option_none_default),
		("Option no alloc sized types", test_option_no_alloc_sized),
		("Option generated stack no alloc", test_option_generated_stack_no_alloc),
		("Vector.get Option[Int128]", test_vector_get_int128_stack_option),
		("Vector.get Option[enum]", test_vector_get_enum_stack_option),
		("Vector.get Option[struct]", test_vector_get_value_record_stack_option),
		("builtin parse_int Option[Int]", test_builtin_parse_int_stack_option),
		("List[Option[Int]] storage", test_list_of_option_int_stack_storage),
		("Tuple[Option[Float]] storage", test_tuple_of_option_float_stack_storage),
		("Dict.get Option[Int]", test_dict_get_int_stack_option),
		("Dict.get Option[Float]", test_dict_get_float_stack_option),
		("Dict.get alias Option[Float]", test_dict_get_float_alias_stack_option),
		("Dict.get Option[Bool]", test_dict_get_bool_stack_option),
		("Dict.get Option[Char]", test_dict_get_char_stack_option),
		("Dict.get Option[Int32]", test_dict_get_int32_stack_option),
		("Dict.get Option[UInt8]", test_dict_get_uint8_stack_option),
		("Dict.get Option[String]", test_dict_get_string_nullable_option),
		("Dict.get Option[Int128]", test_dict_get_int128_stack_option),
		("Dict.get Option[range]", test_dict_get_range_stack_option),
		("Dict.get Option[enum]", test_dict_get_enum_stack_option),
		("Dict.get Option[struct]", test_dict_get_value_record_stack_option),
		(
			"closure returning Option[Int] releases ABI box",
			test_stack_option_closure_return_releases_box,
		),
		(
			"closure argument Option[Int] releases ABI box",
			test_stack_option_closure_arg_releases_box,
		),
		("List.get Option[String] no option alloc", test_list_get_string_nullable_option_no_alloc),
		(
			"nested Option List.get preserves list owner",
			test_nested_option_list_get_preserves_list_owner,
		),
	]
}


-- ============================================================================
-- Sized types: constant fold works for all primitives
-- ============================================================================
func test_option_int32() -> Bool:
	x: Int32 = to_int32(42)

	match Some(x):
		Some(v):
			v == to_int32(42)
		None:
			False


func test_option_float32() -> Bool:
	x: Float32 = to_float32(3.14)

	match Some(x):
		Some(v):
			to_float(v) > 3.0
		None:
			False


func test_option_char() -> Bool:
	match Some('A'):
		Some(c):
			c == 'A'
		None:
			False


func test_option_int128() -> Bool:
	x: Int128 = 999

	match Some(x):
		Some(v):
			v == x
		None:
			False


func test_option_uint128() -> Bool:
	x: UInt128 = 999

	match Some(x):
		Some(v):
			v == x
		None:
			False


func choose_range(idx: ..#10) -> Option[..#10]:
	Some(idx)


func test_option_range() -> Bool:
	var ok: Bool = True

	for i in 0..10:
		match choose_range(i):
			Some(v):
				ok = ok and v >= 0 and v < 10
			None:
				ok = False

	ok


func test_option_enum() -> Bool:
	match Some(StackBlue):
		Some(c):
			c == StackBlue
		None:
			False


func test_option_value_record() -> Bool:
	p: StackPoint = {
		x = 3,
		y = 4
	}

	match Some(p):
		Some(v):
			v.x == 3 and v.y == 4
		None:
			False


func test_option_bool_false() -> Bool:
	match Some(False):
		Some(v):
			not v
		None:
			False


func test_option_none_default() -> Bool:
	var result: Int = -1
	n: Option[Int] = None

	match n:
		Some(v):
			result = v
		None:
			result = 99

	result == 99


func test_option_no_alloc_sized() -> Bool:
	reset_mem_stats()
	var i: Int = 0

	while i < 500:
		match Some(to_int32(i)):
			Some(_):
				i += 1
			None:
				i += 1

		match Some(to_float32(to_float(i))):
			Some(_):
				i = i
			None:
				i = i

		match Some(i > 0):
			Some(_):
				i = i
			None:
				i = i

		match Some('x'):
			Some(_):
				i = i
			None:
				i = i

	stats: MemStats = get_mem_stats()
	stats.total_allocations < 10


func test_option_generated_stack_no_alloc() -> Bool:
	reset_mem_stats()
	var i: Int = 0

	while i < 500:
		wide: Int128 = to_int128(i)

		match Some(wide):
			Some(_):
				i = i
			None:
				i = i

		match choose_range(3):
			Some(_):
				i = i
			None:
				i = i

		match Some(StackRed):
			Some(_):
				i = i
			None:
				i = i

		match Some({
			x = i,
			y = i + 1,
		}):
			Some(p):
				i = p.x + 1
			None:
				i += 1

	stats: MemStats = get_mem_stats()
	stats.total_allocations < 10


func test_vector_get_int128_stack_option() -> Bool:
	x: Int128 = to_int128(77)
	v: Int128[#2] = vector(x, 2)

	match T.get(v, 1):
		Some(got):
			got == x
		None:
			False


func test_vector_get_enum_stack_option() -> Bool:
	v: StackColor[#2] = vector(StackBlue, 2)

	match T.get(v, 1):
		Some(got):
			got == StackBlue
		None:
			False


func test_vector_get_value_record_stack_option() -> Bool:
	p: StackPoint = {
		x = 5,
		y = 8
	}
	v: StackPoint[#2] = vector(p, 2)

	match T.get(v, 1):
		Some(got):
			got.x == 5 and got.y == 8
		None:
			False


func test_dict_get_int128_stack_option() -> Bool:
	x: Int128 = to_int128(1234)
	d: Dict[String, Int128] = D.set(D.dict(), "wide", x)

	match D.get(d, "wide"):
		Some(got):
			got == x
		None:
			False


func test_dict_get_range_stack_option() -> Bool:
	idx: ..#10 = 4
	d: Dict[String, ..#10] = D.set(D.dict(), "idx", idx)

	match D.get(d, "idx"):
		Some(got):
			got == 4
		None:
			False


func test_dict_get_enum_stack_option() -> Bool:
	d: Dict[String, StackColor] = D.set(D.dict(), "color", StackBlue)

	match D.get(d, "color"):
		Some(got):
			got == StackBlue
		None:
			False


func test_dict_get_value_record_stack_option() -> Bool:
	p: StackPoint = {
		x = 13,
		y = 21
	}
	d: Dict[String, StackPoint] = D.set(D.dict(), "point", p)

	match D.get(d, "point"):
		Some(got):
			got.x == 13 and got.y == 21
		None:
			False
