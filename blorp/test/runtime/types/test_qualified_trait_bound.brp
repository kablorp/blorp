-- A generic function whose bound names its trait through a module alias
-- (`T: shapes.Shape`) compiles to the same dispatch as an unqualified bound:
-- each call site runs the implementation of its own type.
import:
	./helpers/qualified_bound_shapes as shapes: area, label, make_rectangle, make_square
	test: TestSuite


pure func total_area[T: shapes.Shape](first: T, second: T) -> Int:
	area(first) + area(second)


-- A multi-bound names two qualified traits.
pure func double_area[T: shapes.Shape + shapes.Labeled](item: T) -> Int:
	area(item) * 2 + label(item).length()


-- A qualified supertrait bound: `Labeled` extends `Shape`, so `area` is
-- available through the subtrait bound.
pure func labeled_area[T: shapes.Labeled](item: T) -> String:
	label(item) + ":" + to_string(area(item))


func test_qualified_bound_dispatches_on_each_type() -> Bool:
	(
		total_area(make_square(2), make_square(3)) == 13
		and total_area(make_rectangle(2, 5), make_rectangle(1, 4)) == 14
	)


func test_qualified_multi_bound_names_two_traits() -> Bool:
	double_area(make_rectangle(2, 3)) == 21


func test_qualified_subtrait_bound_reaches_supertrait_method() -> Bool:
	labeled_area(make_rectangle(3, 4)) == "rectangle:12"


tests: TestSuite = {
	description = "Trait bounds qualified by a module alias",
	tests = [
		("qualified bound dispatches on each type", test_qualified_bound_dispatches_on_each_type),
		(
			"qualified multi bound names two traits",
			test_qualified_multi_bound_names_two_traits,
		),
		(
			"qualified subtrait bound reaches supertrait method",
			test_qualified_subtrait_bound_reaches_supertrait_method,
		),
	]
}
