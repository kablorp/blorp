-- Break and continue tests
import:
	test: TestSuite


func test_break_in_range() -> Bool:
	var total: Int = 0
	for i in 0..100:
		if i == 5:
			break
		total += i
	total == 10


func test_continue_in_range() -> Bool:
	var total: Int = 0
	for i in 0..10:
		if i % 2 == 0:
			continue
		total += i
	total == 25


func test_break_in_while() -> Bool:
	var i: Int = 0
	while i < 100:
		if i == 5:
			break
		i += 1
	i == 5


func test_continue_in_while() -> Bool:
	var i: Int = 0
	var total: Int = 0
	while i < 10:
		i += 1
		if i % 2 == 0:
			continue
		total += i
	total == 25


func test_nested_break() -> Bool:
	var count: Int = 0
	for i in 0..5:
		for j in 0..5:
			if j == 2:
				break
			count += 1
	count == 10


tests: TestSuite = {
	description = "Break and Continue",
	tests = [
		("break exits range loop", test_break_in_range),
		("continue skips iteration in range", test_continue_in_range),
		("break exits while loop", test_break_in_while),
		("continue skips in while loop", test_continue_in_while),
		("break in nested loop breaks inner only", test_nested_break),
	]
}
