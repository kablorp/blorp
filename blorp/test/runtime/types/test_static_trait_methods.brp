import:
	test: TestSuite
	traits: HasOne, HasZero, one, zero


struct Offset {
	value: Int
}


implements HasZero for Offset:
	pure func zero() -> Offset:
		{value = 0}


implements HasOne for Offset:
	pure func one() -> Offset:
		{value = 1}


pure func make_zero[T:HasZero]() -> T:
	value: T = zero()
	value


pure func make_one[T:HasOne]() -> T:
	value: T = one()
	value


pure func test_generic_static_zero() -> Bool:
	value: Offset = make_zero()
	value.value == 0


pure func test_generic_static_one() -> Bool:
	value: Offset = make_one()
	value.value == 1


tests: TestSuite = {
	description = "Static trait methods",
	tests = [
		("generic static zero", test_generic_static_zero),
		("generic static one", test_generic_static_one),
	]
}
