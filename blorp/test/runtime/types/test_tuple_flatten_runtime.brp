import:
	system: append_file, mkstemp_path, read_file, remove_file
	test: TestSuite


union Shape:
	Circle(Int)
	Square(Int)
	Empty


func trace_int(path: String, label: String, value: Int) -> Int:
	_ = append_file(path, label)
	value


func trace_bool(path: String, label: String, value: Bool) -> Bool:
	_ = append_file(path, label)
	value


func trace_shape(path: String, label: String, value: Shape) -> Shape:
	_ = append_file(path, label)
	value


pure func make_pair(first: Int, second: Int) -> (Int, Int):
	(first, second)


func exercise_tuple_evaluation_order(path: String) -> Bool:
	immediate: Int = (trace_int(path, "A", 40), trace_int(path, "B", 2))[0]

	conditional: (Int, Int) = if trace_bool(path, "C", True):
		(trace_int(path, "D", 7), trace_int(path, "E", 8))
	else:
		(trace_int(path, "X", 0), trace_int(path, "Y", 0))

	matched: (Int, Int) = match trace_int(path, "F", 1):
		1:
			(trace_int(path, "G", 9), trace_int(path, "H", 10))
		_:
			(trace_int(path, "X", 0), trace_int(path, "Y", 0))

	returned: Int = make_pair(
		trace_int(path, "I", 11),
		trace_int(path, "J", 12),
	)[0]

	-- A match subject's elements are each evaluated once, left to right,
	-- before any test, even when the tests read them in another order.
	subject: Int = match (trace_shape(path, "K", Square(3)), trace_int(path, "L", 5)):
		(_, 0):
			0
		(Circle(radius), _) | (Square(radius), _):
			radius
		_:
			-1

	match read_file(path):
		Ok(contents):
			(
				contents == "ABCDEFGHIJKL"
				and immediate == 40
				and conditional[0] + conditional[1] == 15
				and matched[0] + matched[1] == 19
				and returned == 11
				and subject == 3
			)
		Err(_):
			False


func test_tuple_flattening_preserves_evaluation_order() -> Bool:
	match mkstemp_path("blorp_tuple_flatten_order_"):
		Ok(path):
			result: Bool = exercise_tuple_evaluation_order(path)
			_ = remove_file(path)
			result
		Err(_):
			False


pure func same_kind(left: Shape, right: Shape) -> Bool:
	match (left, right):
		(Circle(_), Circle(_)) | (Square(_), Square(_)) | (Empty, Empty):
			True
		_:
			False


func test_or_pattern_subject_compares_each_side() -> Bool:
	(
		same_kind(Circle(1), Circle(2))
		and same_kind(Empty, Empty)
		and not same_kind(Circle(1), Square(1))
		and not same_kind(Empty, Square(1))
	)


-- A payload bound from each element, through tests of both.
pure func combined(left: Option[String], right: Option[String]) -> String:
	match (left, right):
		(Some(first), Some(second)):
			first + second
		(Some(only), None) | (None, Some(only)):
			only
		(None, None):
			""


func test_payloads_bound_from_each_element() -> Bool:
	(
		combined(Some("ab"), Some("cd")) == "abcd"
		and combined(Some("ab"), None) == "ab"
		and combined(None, Some("cd")) == "cd"
		and combined(None, None) == ""
	)


-- Literal tests on one element beside constructor tests on another, with a
-- whole-element binding in the fallback.
pure func classify(code: Int, shape: Shape) -> Int:
	match (code, shape):
		(0, Circle(radius)):
			radius
		(0, _):
			100
		(_, Square(side)):
			code + side
		(other, _):
			other * 1000


func test_literal_and_constructor_tests_on_different_elements() -> Bool:
	(
		classify(0, Circle(7)) == 7
		and classify(0, Square(7)) == 100
		and classify(2, Square(5)) == 7
		and classify(3, Empty) == 3000
	)


-- A pattern naming the whole subject, taken apart in one arm and stored
-- whole in another.
pure func whole_subject(left: Shape, right: Shape) -> List[(Shape, Shape)]:
	match (left, right):
		(Empty, _):
			[]
		(Circle(_), shape):
			match shape:
				Square(_):
					[(left, shape)]
				_:
					[]
		both:
			[both, both]


func test_whole_subject_binding_keeps_its_values() -> Bool:
	stored: List[(Shape, Shape)] = whole_subject(Square(1), Circle(2))
	(
		whole_subject(Empty, Square(1)).is_empty()
		and whole_subject(Circle(3), Square(4)).length() == 1
		and stored.length() == 2
		and match stored.get(1):
			Some((Square(1), Circle(2))):
				True
			_:
				False
	)


-- Three elements with a managed one in the middle.
pure func picked(first: Bool, middle: Option[String], last: Int) -> Int:
	match (first, middle, last):
		(True, Some(text), _):
			text.length()
		(False, _, 0):
			-1
		(_, None, value):
			value
		_:
			0


func test_three_element_subject() -> Bool:
	(
		picked(True, Some("four"), 9) == 4
		and picked(False, Some("four"), 0) == -1
		and picked(True, None, 9) == 9
		and picked(False, Some("four"), 9) == 0
	)


-- A local tuple taken apart: element reads, a match, and a destructure.
pure func local_tuple(count: Int, label: String) -> Int:
	pair: (Int, String) = (count, label)
	(first, second) = pair

	match pair:
		(0, text):
			text.length() + first
		_:
			pair[0] + second.length()


func test_local_tuple_taken_apart() -> Bool:
	local_tuple(0, "abc") == 3 and local_tuple(2, "abc") == 5


tests: TestSuite = {
	description = "Tuple flattening runtime semantics",
	tests = [
		(
			"evaluates tuple inputs once and left to right",
			test_tuple_flattening_preserves_evaluation_order,
		),
		("or-pattern subject compares each side", test_or_pattern_subject_compares_each_side),
		("payloads bound from each element", test_payloads_bound_from_each_element),
		(
			"literal and constructor tests on different elements",
			test_literal_and_constructor_tests_on_different_elements,
		),
		("whole-subject binding keeps its values", test_whole_subject_binding_keeps_its_values),
		("three-element subject", test_three_element_subject),
		("local tuple taken apart", test_local_tuple_taken_apart),
	]
}
