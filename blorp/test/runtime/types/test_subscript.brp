-- Test: Compile-time verified subscript syntax for vector element access
import:
	test: TestSuite


-- Direct access tests (all compile-time verified)
func test_subscript_first() -> Bool:
	v: Int[#4] = {10, 20, 30, 40}
	v[0] == 10


func test_subscript_last() -> Bool:
	v: Int[#4] = {10, 20, 30, 40}
	v[3] == 40


func test_subscript_middle() -> Bool:
	v: Int[#5] = {1, 2, 3, 4, 5}
	v[2] == 3


func test_subscript_float() -> Bool:
	v: Float[#3] = {1.5, 2.5, 3.5}
	v[1] == 2.5


func test_subscript_in_arithmetic() -> Bool:
	v: Int[#3] = {10, 20, 30}
	v[0] + v[1] + v[2] == 60


func test_subscript_single_element() -> Bool:
	v: Int[#1] = {42}
	v[0] == 42


func test_subscript_large_vector() -> Bool:
	v: Int[#8] = {1, 2, 3, 4, 5, 6, 7, 8}
	v[0] == 1 and v[7] == 8


func test_subscript_comparison() -> Bool:
	v: Int[#4] = {10, 20, 30, 40}
	v[0] < v[1] and v[1] < v[2] and v[2] < v[3]


-- Loop-based access tests (proven in-bounds via 0..length(v))
func test_subscript_loop_sum() -> Bool:
	v: Int[#4] = {10, 20, 30, 40}
	var sum: Int = 0
	for i in 0..length(v):
		sum += v[i]
	sum == 100


func test_subscript_loop_products() -> Bool:
	v: Int[#3] = {2, 3, 5}
	var product: Int = 1
	for i in 0..length(v):
		product *= v[i]
	product == 30


func test_subscript_loop_float() -> Bool:
	v: Float[#3] = {1.5, 2.5, 3.0}
	var sum: Float = 0.0
	for i in 0..length(v):
		sum += v[i]
	sum == 7.0


tests: TestSuite = {
	description = "Subscript Syntax (compile-time verified)",
	tests = [
		("subscript first element", test_subscript_first),
		("subscript last element", test_subscript_last),
		("subscript middle element", test_subscript_middle),
		("subscript float vector", test_subscript_float),
		("subscript in arithmetic", test_subscript_in_arithmetic),
		("subscript single element", test_subscript_single_element),
		("subscript large vector", test_subscript_large_vector),
		("subscript comparison", test_subscript_comparison),
		("subscript loop sum", test_subscript_loop_sum),
		("subscript loop products", test_subscript_loop_products),
		("subscript loop float", test_subscript_loop_float),
	]
}
