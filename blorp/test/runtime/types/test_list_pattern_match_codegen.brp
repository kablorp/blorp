-- Regression test: list pattern matching compilation
-- Ensures [], [x, ...rest], [a, b] etc. compile via CMatch (decision tree).
import:
	test: TestSuite


func test_empty_match() -> Bool:
	xs: List[Int] = []
	match xs:
		[]: True
		[_, ...rest]: False


func test_single_elem() -> Bool:
	xs: List[Int] = [42]
	match xs:
		[]: False
		[x, ...rest]: x == 42 and rest.length() == 0


func test_head_rest() -> Bool:
	xs: List[Int] = [1, 2, 3]
	match xs:
		[]: False
		[x, ...rest]: x == 1 and rest.length() == 2


func test_exact_two() -> Bool:
	xs: List[Int] = [10, 20]
	match xs:
		[a, b]: a + b == 30
		_: False


func test_exact_mismatch() -> Bool:
	xs: List[Int] = [1, 2, 3]
	match xs:
		[a, b]: False
		_: True


func test_wildcard_default() -> Bool:
	xs: List[Int] = [1, 2, 3, 4, 5]
	match xs:
		[]: False
		[_]: False
		[_, _]: False
		_: True


func test_spread_wildcard() -> Bool:
	xs: List[Int] = [1, 2, 3]
	match xs:
		[x, ..._]: x == 1
		_: False


tests: TestSuite = {
	description = "List pattern match",
	tests = [
		("empty match", test_empty_match),
		("single element", test_single_elem),
		("head and rest", test_head_rest),
		("exact two elements", test_exact_two),
		("exact mismatch falls to default", test_exact_mismatch),
		("wildcard default", test_wildcard_default),
		("spread with wildcard", test_spread_wildcard),
	]
}
