import:
	./helpers/imported_global_source as Source
	test: TestSuite


-- A global whose initializer names another module's global must fold at
-- compile time even when the value's type is owned by that other module.
fixed record Row {kind: Int, extent: Source.Extent, handle: Source.Handle}


REEXPORTED_EXTENT: Source.Extent = Source.EMPTY_EXTENT

REEXPORTED_FRAMED: Source.Framed = Source.FRAMED

REEXPORTED_FLAVOR: Source.Flavor = Source.FANCY

REEXPORTED_CIRCLE: Source.Shape = Source.CIRCLE

REEXPORTED_DOT: Source.Shape = Source.DOT

REEXPORTED_EXTENTS: List[Source.Extent] = Source.EXTENTS

MADE_EXTENT: Source.Extent = Source.make_extent(20)

ROW_WITH_IMPORTED_FIELDS: Row = {
	kind = 7,
	extent = Source.EMPTY_EXTENT,
	handle = Source.make_handle(150)
}


func test_struct_global_from_imported_struct_global() -> Bool:
	REEXPORTED_EXTENT.first == 0 and REEXPORTED_EXTENT.count == 0


func test_nested_struct_global_from_imported_global() -> Bool:
	REEXPORTED_FRAMED.extent.count == 3 and REEXPORTED_FRAMED.tag == 1


func test_enum_global_from_imported_global() -> Bool:
	Source.flavor_code(REEXPORTED_FLAVOR) == 1


func test_union_global_from_imported_global() -> Bool:
	Source.shape_code(REEXPORTED_CIRCLE) == 4 and Source.shape_code(REEXPORTED_DOT) == -1


func test_list_global_from_imported_global() -> Bool:
	REEXPORTED_EXTENTS.length() == 1 and REEXPORTED_EXTENTS.get(0).map(func(extent): extent.first).get_or(-1) == 1


func test_struct_global_with_imported_struct_field() -> Bool:
	ROW_WITH_IMPORTED_FIELDS.kind == 7 and ROW_WITH_IMPORTED_FIELDS.extent.count == 0


func test_opaque_field_built_by_imported_function_reading_its_globals() -> Bool:
	Source.handle_value(ROW_WITH_IMPORTED_FIELDS.handle) == 99


func test_struct_global_from_imported_function_call() -> Bool:
	MADE_EXTENT.first == 20 and MADE_EXTENT.count == 80


tests: TestSuite = {
	description = "Globals initialized from another module's globals",
	tests = [
		("struct global from imported struct global", test_struct_global_from_imported_struct_global),
		("nested struct global from imported global", test_nested_struct_global_from_imported_global),
		("enum global from imported global", test_enum_global_from_imported_global),
		("union global from imported global", test_union_global_from_imported_global),
		("list global from imported global", test_list_global_from_imported_global),
		("struct global from an imported function call", test_struct_global_from_imported_function_call),
		("struct global with imported struct field", test_struct_global_with_imported_struct_field),
		("opaque field built by imported function reading its globals", test_opaque_field_built_by_imported_function_reading_its_globals),
	]
}
