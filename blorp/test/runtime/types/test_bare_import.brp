import:
	test: TestSuite


func test_bare_option() -> Bool:
	x: Option[Int] = Some(42)
	match x:
		Some(v): v == 42
		None: False


func test_bare_list() -> Bool:
	xs: List[Int] = [1, 2, 3]
	xs.length() == 3


tests: TestSuite = {
	description = "Bare std imports (no std/ prefix)",
	tests = [
		("option via bare import", test_bare_option),
		("list via bare qualified import", test_bare_list),
	]
}
