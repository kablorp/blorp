import:
	test: TestSuite


union Shape:
	Circle(Float)
	Rect(Int, Int)


union Color:
	Red
	Green
	Blue


-- Nested match: inner match has different scrutinee type than outer
func test_nested_match_different_types() -> Bool:
	shape: Shape = Rect(3, 4)
	color: Color = Green
	match shape:
		Circle(r):
			match color:
				Red: False
				Green: False
				Blue: False
		Rect(w, h):
			match color:
				Red: False
				Green: w == 3 and h == 4
				Blue: False


-- Triple nested match
func test_triple_nested() -> Bool:
	shape: Shape = Circle(2.5)
	color: Color = Blue
	opt: Option[Int] = Some(42)
	match shape:
		Circle(r):
			match color:
				Red: False
				Green: False
				Blue:
					match opt:
						Some(v): v == 42
						None: False
		Rect(_, _): False


-- Match in arm where outer scrutinee is Option
func test_option_then_union() -> Bool:
	opt: Option[Shape] = Some(Rect(10, 20))
	match opt:
		Some(shape):
			match shape:
				Circle(_): False
				Rect(w, h): w == 10 and h == 20
		None: False


-- Match with same types nested (inner clobbers outer)
func test_same_type_nested() -> Bool:
	a: Option[Int] = Some(1)
	b: Option[Int] = Some(2)
	match a:
		Some(x):
			match b:
				Some(y): x + y == 3
				None: False
		None: False


-- Inner match clobbers scrutinee_type, second arm of outer match needs it
func test_clobber_second_arm() -> Bool:
	opt: Option[Int] = None
	color: Color = Red
	match opt:
		Some(x):
			match color:
				Red: x > 0
				Green: False
				Blue: False
		None:
			-- This arm should still know opt is Option[Int]
			True


tests: TestSuite = {
	description = "Nested match expressions",
	tests = [
		("nested different types", test_nested_match_different_types),
		("triple nested", test_triple_nested),
		("option then union", test_option_then_union),
		("same type nested", test_same_type_nested),
		("clobber second arm", test_clobber_second_arm),
	]
}
