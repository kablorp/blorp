import:
	test: TestSuite


-- A heap record's C struct opens with the runtime's ARC object header, which
-- is spelled `header` there. `header` is an ordinary word for a domain field
-- (a message header, a file header, a column header), so the emitter escapes
-- the collision instead of the language reserving the name. These tests keep
-- a record that declares such a field compiling and round-tripping.
record Probe {
	header: Int,
	name: String,
	tags: List[String]
}


struct Reading {
	header: Float,
	value: Float
}


record Nested {
	header: Probe,
	reading: Reading
}


-- The escape prefix is itself escaped, so a source field already spelled that
-- way keeps its own distinct member.
record Collide {
	header: Int,
	__blorp_field_header: Int
}


union Carrier:
	Loaded(Probe)
	Blank


GLOBAL_PROBE: Probe = {
	header = 99,
	name = "global",
	tags = ["seed"]
}


pure func probe_header(probe: Probe) -> Int:
	probe.header


pure func sample_probe() -> Probe:
	{
		header = 7,
		name = "hi",
		tags = ["x", "y"]
	}


func test_heap_record_header_field_round_trips() -> Bool:
	probe: Probe = sample_probe()

	probe.header == 7 and probe.name == "hi" and probe.tags.length() == 2


func test_header_field_survives_record_update() -> Bool:
	probe: Probe = sample_probe()
	updated: Probe = { probe | header = probe.header + 1 }

	(
		probe.header == 7
		and updated.header == 8
		and updated.name == "hi"
		and updated.tags.length() == 2
	)


func test_header_field_crosses_a_call_boundary() -> Bool:
	probe_header(sample_probe()) == 7


func test_value_record_header_field_round_trips() -> Bool:
	reading: Reading = {
		header = 1.5,
		value = 2.5
	}
	updated: Reading = { reading | header = 3.5 }

	reading.header == 1.5 and updated.header == 3.5 and updated.value == 2.5


func test_nested_header_fields_round_trip() -> Bool:
	nested: Nested = {
		header = sample_probe(),
		reading = {
			header = 1.5,
			value = 2.5
		}
	}

	nested.header.header == 7 and nested.header.name == "hi" and nested.reading.header == 1.5


func test_header_field_round_trips_through_a_union_payload() -> Bool:
	carrier: Carrier = Loaded(sample_probe())

	match carrier:
		Loaded(inner):
			inner.header == 7
		Blank:
			False


func test_header_field_round_trips_through_a_closure_capture() -> Bool:
	captured: Probe = sample_probe()
	totals: List[Int] = [1, 2].map(pure func(step): captured.header + step)

	(
		totals
			.get(0)
			.get_or(0) == 8
		and totals
			.get(1)
			.get_or(0) == 9
	)


func test_global_record_header_field_round_trips() -> Bool:
	GLOBAL_PROBE.header == 99 and GLOBAL_PROBE.name == "global"


func test_escape_prefixed_field_stays_distinct_from_header() -> Bool:
	collide: Collide = {
		header = 1,
		__blorp_field_header = 2
	}
	updated: Collide = { collide | header = 10 }

	(
		collide.header == 1
		and collide.__blorp_field_header == 2
		and updated.header == 10
		and updated.__blorp_field_header == 2
	)


tests: TestSuite = {
	description = "Runtime-Reserved Field Names",
	tests = [
		("heap record header field round trips", test_heap_record_header_field_round_trips),
		("header field survives record update", test_header_field_survives_record_update),
		("header field crosses a call boundary", test_header_field_crosses_a_call_boundary),
		("value record header field round trips", test_value_record_header_field_round_trips),
		("nested header fields round trip", test_nested_header_fields_round_trip),
		(
			"header field round trips through a union payload",
			test_header_field_round_trips_through_a_union_payload,
		),
		(
			"header field round trips through a closure capture",
			test_header_field_round_trips_through_a_closure_capture,
		),
		("global record header field round trips", test_global_record_header_field_round_trips),
		(
			"escape-prefixed field stays distinct from header",
			test_escape_prefixed_field_stays_distinct_from_header,
		),
	]
}
