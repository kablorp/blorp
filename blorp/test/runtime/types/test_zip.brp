-- Test zip for parallel vector iteration
import:
	test: TestSuite


func test_zip_dot_product() -> Bool:
	a: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	b: Float[#4] = {10.0, 20.0, 30.0, 40.0}
	var total: Float = 0.0
	for (x, y) in a.zip(b):
		total += x * y

	-- 10 + 40 + 90 + 160 = 300
	total == 300.0


func test_zip_different_values() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: Int[#3] = {10, 20, 30}
	var sum: Int = 0
	for (x, y) in a.zip(b):
		sum += x + y

	-- (1+10) + (2+20) + (3+30) = 66
	sum == 66


tests: TestSuite = {
	description = "zip iteration",
	tests = [
		("zip dot product", test_zip_dot_product),
		("zip different values", test_zip_different_values),
	]
}
