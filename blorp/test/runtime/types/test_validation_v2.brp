	])
	match validator(sample):
		Err(KeyErrs(pairs)): pairs.length() == 8
		_: False


func test_non_negative_pass() -> Bool:
	match non_negative(0):
		None: True
		Some(_): False


func test_non_negative_fail() -> Bool:
	match non_negative(-1):
		Some(PredicateErr("non_negative", _)): True
		_: False


