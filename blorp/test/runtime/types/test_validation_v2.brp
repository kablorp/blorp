-- Tests for recursive Invalid error types in validation module
import:
	std/codec: Value(VBool, VFloat, VInt, VList, VNull, VRecord, VString)
	std/list: List, get, length
	std/option: Option(Some, None)
	std/result: Result(Ok, Err), is_err, is_ok
	std/string as S
	std/test: TestSuite
	std/validation:
		Check,
		Invalid(
			CoercionErr,
			UnionErrs,
			MissingKey,
			KeyErrs,
			ExtraKeys,
			TypeErr,
			IndexErrs,
			PredicateErr,
			GroupErrs,
		),
		InvalidCheck,
		Validator,
		ValueValidator,
		and_then_validator,
		and_validate,
		at_index,
		at_key,
		bool_validator,
		check,
		collect,
		fail_validator,
		field,
		float_validator,
		format_error,
		group,
		in_range,
		int_validator,
		list_of,
		map_validator,
		max_len,
		max_val,
		min_len,
		non_empty,
		non_negative,
		null_validator,
		object2,
		object3,
		object4,
		object5,
		object6,
		object7,
		object8,
		one_of_str,
		one_of_validator,
		optional_field,
		or_else_validator,
		positive,
		strict_float_validator,
		string_validator,
		succeed_validator,
		validate,
		validate_field,
		validate_list,
		validate_nested,
		value_validator,


record User {
	name: String,
	age: Int,
	email: String
}


record Address {
	street: String,
	city: String,
	zip: String
}


record UserWithAddress {
	name: String,
	age: Int,
	address: Address
}


record SmallUser {
	name: String,
	age: Int
}


record Profile {
	name: String,
	age: Int,
	email: Option[String]
}


record Account {
	name: String,
	age: Int,
	email: Option[String],
	active: Bool
}


record User5 {
	name: String,
	age: Int,
	email: Option[String],
	active: Bool,
	score: Float
}


record User6 {
	name: String,
	age: Int,
	email: Option[String],
	active: Bool,
	score: Float,
	tags: List[String]
}


record User7 {
	name: String,
	age: Int,
	email: Option[String],
	active: Bool,
	score: Float,
	tags: List[String],
	id: String
}


record User8 {
	name: String,
	age: Int,
	email: Option[String],
	active: Bool,
	score: Float,
	tags: List[String],
	id: String,
	city: String
}


-- ============================================================================
-- Leaf error construction
-- ============================================================================
func test_type_err() -> Bool:
	err: Invalid = TypeErr("String", "Int")
	match err:
		TypeErr(expected, got): expected == "String" and got == "Int"
		_: False


func test_predicate_err() -> Bool:
	err: Invalid = PredicateErr("non_empty", "must not be empty")
	match err:
		PredicateErr(code, msg): code == "non_empty" and S.contains(msg, "empty")
		_: False


func test_missing_key() -> Bool:
	err: Invalid = MissingKey("email")
	match err:
		MissingKey(k): k == "email"
		_: False


-- ============================================================================
-- Composing errors with structure
-- ============================================================================
func test_at_key() -> Bool:
	err: Invalid = at_key("name", PredicateErr("non_empty", "required"))
	match err:
		KeyErrs(pairs):
			match get(pairs, 0):
				Some(pair): pair[0] == "name"
				None: False
		_: False


func test_at_index() -> Bool:
	err: Invalid = at_index(3, TypeErr("Int", "String"))
	match err:
		IndexErrs(pairs):
			match get(pairs, 0):
				Some(pair): pair[0] == 3
				None: False
		_: False


func test_group_errs() -> Bool:
	err: Invalid = group("address", [MissingKey("zip"), MissingKey("city")])
	match err:
		GroupErrs(name, children): name == "address" and children.length() == 2
		_: False


-- ============================================================================
-- Core validate
-- ============================================================================
func test_validate_pass() -> Bool:
	result: Result[String, Invalid] = validate("hello", [non_empty, min_len(3)])
	is_ok(result)


func test_validate_single_fail() -> Bool:
	result: Result[String, Invalid] = validate("", [non_empty])
	match result:
		Err(PredicateErr(code, _)): code == "non_empty"
		_: False


func test_validate_accumulates() -> Bool:
	result: Result[String, Invalid] = validate("", [non_empty, min_len(5)])
	match result:
		Err(GroupErrs(_, children)): children.length() == 2
		_: False


func test_validate_no_checks() -> Bool:
	checks: List[pure (String) -> Option[Invalid]] = []
	result: Result[String, Invalid] = validate("anything", checks)
	is_ok(result)


func test_validate_preserves_value() -> Bool:
	result: Result[Int, Invalid] = validate(42, [positive])
	match result:
		Ok(v): v == 42
		Err(_): False


func test_generic_check_alias() -> Bool:
	c: Check[String, Invalid] = non_empty
	match c(""):
		Some(PredicateErr("non_empty", _)): True
		_: False


func test_generic_validator_alias() -> Bool:
	v: Validator[String, Int, String] = pure func(input: String) -> Result[Int, String]:
		Ok(input.length())
	match v("hello"):
		Ok(n): n == 5
		Err(_): False


func test_invalid_check_alias() -> Bool:
	checks: List[InvalidCheck[String]] = [non_empty, min_len(3)]
	result: Result[String, Invalid] = validate("ok", checks)
	match result:
		Err(PredicateErr("min_len", _)): True
		_: False


func test_value_validator_alias() -> Bool:
	v: ValueValidator[String] = string_validator([])
	match v(VString("hello")):
		Ok(s): s == "hello"
		Err(_): False


-- ============================================================================
-- Field validation
-- ============================================================================
func test_validate_field_pass() -> Bool:
	result: Option[Invalid] = validate_field("name", "Alice", [non_empty, min_len(3)])
	match result:
		None: True
		Some(_): False


func test_validate_field_fail() -> Bool:
	result: Option[Invalid] = validate_field("name", "", [non_empty, min_len(3)])
	match result:
		Some(GroupErrs(name, children)): name == "name" and children.length() == 2
		_: False


-- ============================================================================
-- Record validation with collect
-- ============================================================================
pure func validate_user(u: User) -> Result[User, Invalid]:
	collect(
		u,
		[
			validate_field("name", u.name, [non_empty, min_len(2)]),
			validate_field("age", u.age, [positive, max_val(150)]),
		],
	)


func test_record_pass() -> Bool:
	user: User = {
		name = "Alice",
		age = 30,
		email = "a@b.com"
	}
	is_ok(validate_user(user))


func test_record_fail_all() -> Bool:
	user: User = {
		name = "",
		age = -1,
		email = ""
	}
	result: Result[User, Invalid] = validate_user(user)
	match result:
		Err(KeyErrs(pairs)): pairs.length() == 2
		_: False


func test_record_fail_one() -> Bool:
	user: User = {
		name = "Alice",
		age = -1,
		email = ""
	}
	result: Result[User, Invalid] = validate_user(user)
	match result:
		Err(KeyErrs(pairs)): pairs.length() == 1
		_: False


-- ============================================================================
-- Nested record validation
-- ============================================================================
pure func validate_address(a: Address) -> Result[Address, Invalid]:
	collect(
		a,
		[
			validate_field("street", a.street, [non_empty]),
			validate_field("city", a.city, [non_empty]),
			validate_field("zip", a.zip, [non_empty, min_len(5)]),
		],
	)


pure func validate_user_with_address(u: UserWithAddress) -> Result[UserWithAddress, Invalid]:
	collect(
		u,
		[
			validate_field("name", u.name, [non_empty]),
			validate_field("age", u.age, [positive]),
			validate_nested("address", u.address, validate_address),
		],
	)


func test_nested_record_pass() -> Bool:
	u: UserWithAddress = {
		name = "Alice",
		age = 30,
		address = {
			street = "123 Main",
			city = "NYC",
			zip = "10001"
		}
	}
	is_ok(validate_user_with_address(u))


func test_nested_record_fail_deep() -> Bool:
	u: UserWithAddress = {
		name = "Alice",
		age = 30,
		address = {
			street = "",
			city = "NYC",
			zip = "1"
		}
	}
	result: Result[UserWithAddress, Invalid] = validate_user_with_address(u)
	is_err(result)


func test_nested_record_format() -> Bool:
	u: UserWithAddress = {
		name = "",
		age = -1,
		address = {
			street = "",
			city = "",
			zip = ""
		}
	}
	result: Result[UserWithAddress, Invalid] = validate_user_with_address(u)
	match result:
		Err(e):
			formatted: String = format_error(e)
			S.contains(
				formatted,
				"name",
			) and S.contains(formatted, "age") and S.contains(formatted, "address")
		Ok(_): False


-- ============================================================================
-- List validation
-- ============================================================================
func test_validate_list_pass() -> Bool:
	users: List[User] = [{
			name = "Alice",
			age = 30,
			email = ""
		}, {
			name = "Bob",
			age = 25,
			email = ""
		}]
	result: Result[List[User], Invalid] = validate_list(users, validate_user)
	is_ok(result)


func test_validate_list_fail() -> Bool:
	users: List[User] = [{
			name = "Alice",
			age = 30,
			email = ""
		}, {
			name = "",
			age = -1,
			email = ""
		}, {
			name = "Charlie",
			age = 20,
			email = ""
		}]
	result: Result[List[User], Invalid] = validate_list(users, validate_user)
	match result:
		Err(IndexErrs(pairs)):
			if pairs.length() != 1:
				False
			else:
				match get(pairs, 0):
					Some(p): p[0] == 1
					None: False
		_: False


-- ============================================================================
-- and_validate bridge
-- ============================================================================
func test_and_validate_ok() -> Bool:
	result: Result[String, String] = Ok("hello")
	validated: Result[String, Invalid] = and_validate(result, [non_empty])
	is_ok(validated)


func test_and_validate_err_passthrough() -> Bool:
	result: Result[String, String] = Err("parse failed")
	validated: Result[String, Invalid] = and_validate(result, [non_empty])
	match validated:
		Err(CoercionErr(from_type, msg)): from_type == "String" and S.contains(msg, "parse failed")
		_: False


-- ============================================================================
-- String checks
-- ============================================================================
func test_non_empty_pass() -> Bool:
	match non_empty("hello"):
		None: True
		Some(_): False


func test_non_empty_fail() -> Bool:
	match non_empty(""):
		Some(PredicateErr(code, _)): code == "non_empty"
		_: False


func test_min_len_pass() -> Bool:
	c: pure (String) -> Option[Invalid] = min_len(3)
	match c("hello"):
		None: True
		Some(_): False


func test_min_len_fail() -> Bool:
	c: pure (String) -> Option[Invalid] = min_len(5)
	match c("hi"):
		Some(PredicateErr(code, _)): code == "min_len"
		_: False


func test_max_len_pass() -> Bool:
	c: pure (String) -> Option[Invalid] = max_len(10)
	match c("hello"):
		None: True
		Some(_): False


func test_one_of_str_pass() -> Bool:
	c: pure (String) -> Option[Invalid] = one_of_str(["admin", "user", "guest"])
	match c("admin"):
		None: True
		Some(_): False


func test_one_of_str_fail() -> Bool:
	c: pure (String) -> Option[Invalid] = one_of_str(["admin", "user"])
	match c("root"):
		Some(PredicateErr(code, _)): code == "one_of"
		_: False


-- ============================================================================
-- Numeric checks
-- ============================================================================
func test_positive_pass() -> Bool:
	match positive(5):
		None: True
		Some(_): False


func test_positive_fail() -> Bool:
	match positive(-1):
		Some(PredicateErr(code, _)): code == "positive"
		_: False


func test_in_range_pass() -> Bool:
	c: pure (Int) -> Option[Invalid] = in_range(1, 100)
	match c(50):
		None: True
		Some(_): False


func test_in_range_fail() -> Bool:
	c: pure (Int) -> Option[Invalid] = in_range(1, 100)
	match c(200):
		Some(PredicateErr(code, _)): code == "in_range"
		_: False


-- ============================================================================
-- check combinator
-- ============================================================================
func test_check_pass() -> Bool:
	c: pure (String) -> Option[Invalid] = check(
		"has_at",
		"must contain @",
		pure func(s: String): S.contains(s, "@"),
	)
	match c("a@b.com"):
		None: True
		Some(_): False


func test_check_fail() -> Bool:
	c: pure (String) -> Option[Invalid] = check(
		"has_at",
		"must contain @",
		pure func(s: String): S.contains(s, "@"),
	)
	match c("invalid"):
		Some(PredicateErr(code, _)): code == "has_at"
		_: False


-- ============================================================================
-- Validator combinators
-- ============================================================================
func test_map_validator_pass() -> Bool:
	validator: ValueValidator[Int] = map_validator(
		string_validator([]),
		pure func(s: String): s.length(),
	)
	match validator(VString("hello")):
		Ok(n): n == 5
		Err(_): False


func test_map_validator_preserves_error() -> Bool:
	validator: ValueValidator[Int] = map_validator(
		string_validator([]),
		pure func(s: String): s.length(),
	)
	match validator(VBool(True)):
		Err(TypeErr("String", "Bool")): True
		_: False


func test_and_then_validator_pass() -> Bool:
	validator: ValueValidator[Int] = and_then_validator(string_validator(
		[],
	), pure func(s: String) -> Result[Int, Invalid]:
		if s.length() == 0:
			Err(PredicateErr("non_empty", "must not be empty"))
		else:
			Ok(s.length())
	)
	match validator(VString("abc")):
		Ok(n): n == 3
		Err(_): False


func test_and_then_validator_second_error() -> Bool:
	validator: ValueValidator[Int] = and_then_validator(string_validator(
		[],
	), pure func(s: String) -> Result[Int, Invalid]:
		if s.length() == 0:
			Err(PredicateErr("non_empty", "must not be empty"))
		else:
			Ok(s.length())
	)
	match validator(VString("")):
		Err(PredicateErr("non_empty", _)): True
		_: False


func test_or_else_validator_second_success() -> Bool:
	int_as_string: ValueValidator[String] = map_validator(
		int_validator([]),
		pure func(n: Int): n.to_string(),
	)
	validator: ValueValidator[String] = or_else_validator(string_validator([]), int_as_string)
	match validator(VInt(12)):
		Ok(s): s == "12"
		Err(_): False


func test_succeed_validator() -> Bool:
	validator: ValueValidator[String] = succeed_validator("fallback")
	match validator(VInt(12)):
		Ok(s): s == "fallback"
		Err(_): False


func test_fail_validator() -> Bool:
	validator: ValueValidator[String] = fail_validator(TypeErr("String", "Bool"))
	match validator(VBool(True)):
		Err(TypeErr("String", "Bool")): True
		_: False


func test_one_of_validator_second_success() -> Bool:
	int_as_string: ValueValidator[String] = map_validator(
		int_validator([]),
		pure func(n: Int): n.to_string(),
	)
	validator: ValueValidator[String] = one_of_validator([string_validator([]), int_as_string])
	match validator(VInt(12)):
		Ok(s): s == "12"
		Err(_): False


func test_one_of_validator_accumulates_errors() -> Bool:
	int_as_string: ValueValidator[String] = map_validator(
		int_validator([]),
		pure func(n: Int): n.to_string(),
	)
	validator: ValueValidator[String] = one_of_validator([string_validator([]), int_as_string])
	match validator(VBool(True)):
		Err(UnionErrs(errors)): errors.length() == 2
		_: False


func test_one_of_validator_empty() -> Bool:
	validator: ValueValidator[String] = one_of_validator([])
	match validator(VString("anything")):
		Err(UnionErrs(errors)): errors.length() == 0
		_: False


-- ============================================================================
-- Formatting
-- ============================================================================
func test_format_predicate() -> Bool:
	format_error(PredicateErr("non_empty", "must not be empty")) == "must not be empty"


func test_format_type_err() -> Bool:
	formatted: String = format_error(TypeErr("String", "Int"))
	S.contains(formatted, "expected String") and S.contains(formatted, "got Int")


func test_format_missing_key() -> Bool:
	formatted: String = format_error(MissingKey("email"))
	S.contains(formatted, "email")


func test_format_key_errs() -> Bool:
	err: Invalid = KeyErrs([
		("name", PredicateErr("non_empty", "required")),
		("age", PredicateErr("positive", "must be positive"))
	])
	formatted: String = format_error(err)
	S.contains(formatted, "name: required") and S.contains(formatted, "age: must be positive")


func test_format_nested() -> Bool:
	err: Invalid = KeyErrs(
		[
			(
				"address",
				GroupErrs(
					"address",
					[KeyErrs([("zip", PredicateErr("min_len", "too short"))])],
				),
			),
		],
	)
	formatted: String = format_error(err)
	S.contains(
		formatted,
		"address",
	) and S.contains(formatted, "zip") and S.contains(formatted, "too short")


func test_format_index_errs() -> Bool:
	err: Invalid = IndexErrs([
		(1, PredicateErr("positive", "must be positive")),
		(3, TypeErr("Int", "String"))
	])
	formatted: String = format_error(err)
	S.contains(formatted, "[1]") and S.contains(formatted, "[3]")


-- ============================================================================
-- Format path correctness (exact assertions, not just contains)
-- ============================================================================
func test_format_path_exact() -> Bool:
	-- Single field error should produce "field: message", not "field.field: message"
	err: Invalid = KeyErrs([("name", PredicateErr("non_empty", "required"))])
	format_error(err) == "name: required"


func test_format_nested_path_exact() -> Bool:
	-- Nested field: address.zip, not address.address.zip
	err: Invalid = KeyErrs([("address", KeyErrs([("zip", PredicateErr("min_len", "too short"))]))])
	format_error(err) == "address.zip: too short"


func test_format_extra_keys() -> Bool:
	formatted: String = format_error(ExtraKeys(["foo", "bar"]))
	S.contains(
		formatted,
		"unexpected keys",
	) and S.contains(formatted, "foo") and S.contains(formatted, "bar")


func test_format_coercion_err() -> Bool:
	formatted: String = format_error(CoercionErr("String", "Int"))
	S.contains(formatted, "cannot convert String to Int")


func test_format_union_errs() -> Bool:
	err: Invalid = UnionErrs([TypeErr("Int", "String"), TypeErr("Float", "String")])
	formatted: String = format_error(err)
	S.contains(formatted, "none of 2 alternatives matched")


-- ============================================================================
-- validate_nested combinator
-- ============================================================================
func test_validate_nested_pass() -> Bool:
	addr: Address = {
		street = "123 Main",
		city = "NYC",
		zip = "10001"
	}
	result: Option[Invalid] = validate_nested("address", addr, validate_address)
	match result:
		None: True
		Some(_): False


func test_validate_nested_fail() -> Bool:
	addr: Address = {
		street = "",
		city = "",
		zip = "1"
	}
	result: Option[Invalid] = validate_nested("address", addr, validate_address)
	match result:
		Some(GroupErrs("address", _)): True
		_: False


func test_validate_nested_format_path() -> Bool:
	u: UserWithAddress = {
		name = "Alice",
		age = 30,
		address = {
			street = "",
			city = "NYC",
			zip = "10001"
		}
	}
	result: Result[UserWithAddress, Invalid] = validate_user_with_address(u)
	match result:
		Err(e):
			formatted: String = format_error(e)

			-- Should be "address.street: ..." not "address.address.street: ..."
			S.contains(formatted, "address.street") and not S.contains(formatted, "address.address")
		Ok(_): False


func test_validate_list_empty() -> Bool:
	users: List[User] = []
	result: Result[List[User], Invalid] = validate_list(users, validate_user)
	is_ok(result)


func test_validate_list_all_fail() -> Bool:
	users: List[User] = [{
			name = "",
			age = -1,
			email = ""
		}, {
			name = "",
			age = -1,
			email = ""
		}]
	result: Result[List[User], Invalid] = validate_list(users, validate_user)
	match result:
		Err(IndexErrs(pairs)): pairs.length() == 2
		_: False


func test_string_validator_checks() -> Bool:
	validator: ValueValidator[String] = string_validator([non_empty, min_len(3)])
	match validator(VString("")):
		Err(GroupErrs(_, children)): children.length() == 2
		_: False


func test_string_validator_type_error() -> Bool:
	validator: ValueValidator[String] = string_validator([])
	match validator(VInt(12)):
		Err(TypeErr(expected, got)): expected == "String" and got == "Int"
		_: False


func test_int_validator_checks() -> Bool:
	validator: ValueValidator[Int] = int_validator([positive, max_val(10)])
	match validator(VInt(20)):
		Err(PredicateErr("max_val", _)): True
		_: False


func test_bool_validator_pass() -> Bool:
	validator: ValueValidator[Bool] = bool_validator([])
	match validator(VBool(True)):
		Ok(v): v == True
		Err(_): False


func test_float_validator_accepts_int() -> Bool:
	validator: ValueValidator[Float] = float_validator([])
	match validator(VInt(4)):
		Ok(v): v > 3.99 and v < 4.01
		Err(_): False


func test_strict_float_validator_rejects_int() -> Bool:
	validator: ValueValidator[Float] = strict_float_validator([])
	match validator(VInt(4)):
		Err(TypeErr("Float", "Int")): True
		_: False


func test_null_validator_pass() -> Bool:
	validator: ValueValidator[Bool] = null_validator()
	match validator(VNull):
		Ok(v): v == True
		Err(_): False


func test_null_validator_type_error() -> Bool:
	validator: ValueValidator[Bool] = null_validator()
	match validator(VString("x")):
		Err(TypeErr("Null", "String")): True
		_: False


func test_value_validator_checks() -> Bool:
	raw_string: InvalidCheck[Value] = check("raw_string", "must be a raw string value", pure func(
		value: Value,
	) -> Bool:
		match value:
			VString(_): True
			_: False
	)
	validator: ValueValidator[Value] = value_validator([raw_string])
	match validator(VInt(1)):
		Err(PredicateErr("raw_string", _)): True
		_: False


func test_list_of_accumulates_indices() -> Bool:
	validator: ValueValidator[List[Int]] = list_of(int_validator([positive]))
	sample: Value = VList([VInt(1), VInt(-2), VString("bad")])
	match validator(sample):
		Err(IndexErrs(pairs)): pairs.length() == 2
		_: False


func test_field_missing_key() -> Bool:
	validator: ValueValidator[String] = field("name", string_validator([]))
	match validator(VRecord([])):
		Err(KeyErrs(pairs)):
			match get(pairs, 0):
				Some(pair):
					pair[0] == "name" and match pair[1]:
						MissingKey("name"): True
						_: False
				None: False
		_: False


func test_optional_field_missing() -> Bool:
	validator: ValueValidator[Option[String]] = optional_field(
		"email",
		string_validator([non_empty]),
	)
	match validator(VRecord([])):
		Ok(None): True
		_: False


func test_optional_field_null() -> Bool:
	validator: ValueValidator[Option[String]] = optional_field(
		"email",
		string_validator([non_empty]),
	)
	match validator(VRecord([("email", VNull)])):
		Ok(None): True
		_: False


func test_optional_field_invalid_value() -> Bool:
	validator: ValueValidator[Option[String]] = optional_field(
		"email",
		string_validator([non_empty]),
	)
	match validator(VRecord([("email", VString(""))])):
		Err(KeyErrs(pairs)):
			match get(pairs, 0):
				Some(pair): pair[0] == "email"
				None: False
		_: False


pure func build_small_user(name: String, age: Int) -> SmallUser:
	{
		name = name,
		age = age
	}


pure func build_profile(name: String, age: Int, email: Option[String]) -> Profile:
	{
		name = name,
		age = age,
		email = email
	}


pure func build_account(
	name: String,
	age: Int,
	email: Option[String],
	active: Bool,
) -> Account:
	{
		name = name,
		age = age,
		email = email,
		active = active
	}


pure func build_user5(
	name: String,
	age: Int,
	email: Option[String],
	active: Bool,
	score: Float,
) -> User5:
	{
		name = name,
		age = age,
		email = email,
		active = active,
		score = score
	}


pure func build_user6(
	name: String,
	age: Int,
	email: Option[String],
	active: Bool,
	score: Float,
	tags: List[String],
) -> User6:
	{
		name = name,
		age = age,
		email = email,
		active = active,
		score = score,
		tags = tags
	}


pure func build_user7(
	name: String,
	age: Int,
	email: Option[String],
	active: Bool,
	score: Float,
	tags: List[String],
	id: String,
) -> User7:
	{
		name = name,
		age = age,
		email = email,
		active = active,
		score = score,
		tags = tags,
		id = id
	}


pure func build_user8(
	name: String,
	age: Int,
	email: Option[String],
	active: Bool,
	score: Float,
	tags: List[String],
	id: String,
	city: String,
) -> User8:
	{
		name = name,
		age = age,
		email = email,
		active = active,
		score = score,
		tags = tags,
		id = id,
		city = city
	}


func test_object2_pass() -> Bool:
	validator: ValueValidator[SmallUser] = object2(
		field(
			"name",
			string_validator([non_empty]),
		),
		field(
			"age",
			int_validator([positive]),
		),
		build_small_user,
	)
	sample: Value = VRecord([("name", VString("Ada")), ("age", VInt(36))])
	match validator(sample):
		Ok(user): user.name == "Ada" and user.age == 36
		Err(_): False


func test_object2_accumulates_fields() -> Bool:
	validator: ValueValidator[SmallUser] = object2(
		field(
			"name",
			string_validator([non_empty]),
		),
		field(
			"age",
			int_validator([positive]),
		),
		build_small_user,
	)
	sample: Value = VRecord([("name", VString("")), ("age", VInt(-1))])
	match validator(sample):
		Err(KeyErrs(pairs)): pairs.length() == 2
		_: False


func test_object3_optional_pass() -> Bool:
	validator: ValueValidator[Profile] = object3(
		field(
			"name",
			string_validator([non_empty]),
		),
		field(
			"age",
			int_validator([positive]),
		),
		optional_field(
			"email",
			string_validator([non_empty]),
		),
		build_profile,
	)
	sample: Value = VRecord([("name", VString("Ada")), ("age", VInt(36))])
	match validator(sample):
		Ok(profile):
			profile.name == "Ada" and profile.age == 36 and match profile.email:
				None: True
				Some(_): False
		Err(_): False


func test_object3_accumulates_fields() -> Bool:
	validator: ValueValidator[Profile] = object3(
		field(
			"name",
			string_validator([non_empty]),
		),
