import:
	./helpers/constants_mod as CM
	test: TestSuite


MAX_SIZE: Int = 100

NEG_VAL: Int = -42

ZERO = 0

PI: Float = 3.14159

DEBUG: Bool = False

GREETING: String = "hello"

NEWLINE: Char = '\n'


struct Point {
	x: Int,
	y: Int
}


ORIGIN: Point = {
	x = 0,
	y = 0
}

DOUBLE_MAX: Int = MAX_SIZE * 2


pure func circle_area(r: Float) -> Float:
	PI * r * r


func test_int_const() -> Bool:
	MAX_SIZE == 100


func test_neg_const() -> Bool:
	NEG_VAL == -42


func test_zero_const() -> Bool:
	ZERO == 0


func test_float_const() -> Bool:
	PI > 3.14 and PI < 3.15


func test_bool_const() -> Bool:
	not DEBUG


func test_string_const() -> Bool:
	GREETING == "hello"


func test_char_const() -> Bool:
	NEWLINE == '\n'


func test_struct_const() -> Bool:
	ORIGIN.x == 0 and ORIGIN.y == 0


func test_const_in_math() -> Bool:
	DOUBLE_MAX == 200


func test_const_in_func() -> Bool:
	area: Float = circle_area(1.0)
	area > 3.14 and area < 3.15


func test_const_pass_to_func() -> Bool:
	MAX_SIZE.to_string() == "100"


LABEL: String = "Score"

SEPARATOR: String = ": "


func test_global_string_concat() -> Bool:
	result: String = LABEL + SEPARATOR + "100"
	result == "Score: 100"


func test_global_string_in_interp() -> Bool:
	msg: String = "${GREETING} world"
	msg == "hello world"


func test_global_string_concat_chain() -> Bool:
	a: String = GREETING + " " + GREETING
	a == "hello hello"


func test_module_qualified_int_const() -> Bool:
	CM.MY_INT == 42


func test_module_qualified_string_const() -> Bool:
	CM.MY_STRING == "hello"


func test_module_qualified_const_in_expr() -> Bool:
	CM.MY_INT + 8 == 50


tests: TestSuite = {
	description = "Top-Level Declarations",
	tests = [
		("int const", test_int_const),
		("negative const", test_neg_const),
		("inferred const", test_zero_const),
		("float const", test_float_const),
		("bool const", test_bool_const),
		("string const", test_string_const),
		("char const", test_char_const),
		("struct const", test_struct_const),
		("const in math", test_const_in_math),
		("const in function", test_const_in_func),
		("const passed to func", test_const_pass_to_func),
		("global string concat", test_global_string_concat),
		("global string in interpolation", test_global_string_in_interp),
		("global string concat chain", test_global_string_concat_chain),
		("module qualified int const", test_module_qualified_int_const),
		("module qualified string const", test_module_qualified_string_const),
		("module qualified const in expr", test_module_qualified_const_in_expr),
	]
}
