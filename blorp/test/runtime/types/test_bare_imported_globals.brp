import:
	./helpers/imported_global_source: Label, EMPTY_EXTENT, FRAMED, FANCY, CIRCLE, DOT, EXTENTS, HANDLE_LIMIT, LABEL, flavor_code, shape_code
	test: TestSuite


-- Globals imported by bare name must be emitted, not just resolved, whatever
-- their type: the alias form (`import ./m as M`) already worked.
func test_struct_global_by_bare_name() -> Bool:
	EMPTY_EXTENT.first == 0 and EMPTY_EXTENT.count == 0


func test_nested_struct_global_by_bare_name() -> Bool:
	FRAMED.extent.count == 3 and FRAMED.tag == 1


func test_record_global_by_bare_name() -> Bool:
	LABEL.text == "heavy" and LABEL.weight == 7


pure func weight_of_shadowing_parameter(LABEL: Label) -> Int:
	LABEL.weight


func test_local_shadows_bare_imported_global() -> Bool:
	weight_of_shadowing_parameter({text = "light", weight = 1}) == 1 and LABEL.weight == 7


func test_enum_global_by_bare_name() -> Bool:
	flavor_code(FANCY) == 1


func test_union_global_by_bare_name() -> Bool:
	shape_code(CIRCLE) == 4 and shape_code(DOT) == -1


func test_list_global_by_bare_name() -> Bool:
	EXTENTS.length() == 1


func test_int_global_by_bare_name() -> Bool:
	HANDLE_LIMIT == 100


tests: TestSuite = {
	description = "Globals imported by bare name",
	tests = [
		("struct global by bare name", test_struct_global_by_bare_name),
		("nested struct global by bare name", test_nested_struct_global_by_bare_name),
		("record global by bare name", test_record_global_by_bare_name),
		("local shadows bare-imported global", test_local_shadows_bare_imported_global),
		("enum global by bare name", test_enum_global_by_bare_name),
		("union global by bare name", test_union_global_by_bare_name),
		("list global by bare name", test_list_global_by_bare_name),
		("int global by bare name", test_int_global_by_bare_name),
	]
}
