record UnrelatedChoice {
	value: Int
}


trait Equatable:
	pure func equals(left: Self, right: Self) -> Bool


implements Equatable for UnrelatedChoice:
	pure func equals(left: UnrelatedChoice, right: UnrelatedChoice) -> Bool:
		False


pure func builtin_scalar_equality(left: Int, right: Int) -> Bool:
	left == right
