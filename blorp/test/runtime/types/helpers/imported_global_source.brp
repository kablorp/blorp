struct Extent {first: Int, count: Int}


struct Framed {extent: Extent, tag: Int}


enum Flavor:
	Plain
	Fancy


union Shape:
	Circle(Int)
	Dot


opaque type Handle = Int


EMPTY_EXTENT: Extent = {first = 0, count = 0}

FRAMED: Framed = {extent = {first = 2, count = 3}, tag = 1}

FANCY: Flavor = Fancy

CIRCLE: Shape = Circle(4)

DOT: Shape = Dot

EXTENTS: List[Extent] = [{first = 1, count = 1}]

HANDLE_LIMIT: Int = 100


private pure func clamp_to_limit(value: Int, limit: Int) -> Int:
	if value < 0:
		0
	else if value >= limit:
		limit - 1
	else:
		value


pure func make_extent(first: Int) -> Extent:
	{first = first, count = HANDLE_LIMIT - first}


pure func make_handle(value: Int) -> Handle:
	into_opaque Handle(clamp_to_limit(value, HANDLE_LIMIT))


pure func handle_value(handle: Handle) -> Int:
	from_opaque Handle(handle)


pure func flavor_code(flavor: Flavor) -> Int:
	match flavor:
		Plain:
			0
		Fancy:
			1


pure func shape_code(shape: Shape) -> Int:
	match shape:
		Circle(radius):
			radius
		Dot:
			-1


record Label {text: String, weight: Int}


LABEL: Label = {text = "heavy", weight = 7}
