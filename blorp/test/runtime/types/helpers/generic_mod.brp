-- Helper module with generic functions declared in their bracket lists.
-- Used by test_cross_module_generic.brp to verify that qualified calls
-- (M.func(...)) correctly instantiate type params after typecheck persistence.
pure func identity[T](x: T) -> T:
	x


pure func pick_first[T](a: T, b: T) -> T:
	a


pure func wrap_in_list[T](x: T) -> List[T]:
	[x]
