-- Owns `NodeId` and builds the records and unions that
-- `opaque_cycle_syntax` declares over it; that module imports `NodeId` back.
import:
	./opaque_cycle_syntax: Edge(Linked, Detached), Node, NodeIds, Numbered, node_id, number, relabel


opaque type NodeId = Int


pure func node_number(id: NodeId) -> Int:
	from_opaque NodeId(id)


pure func make_node(number: Int, label: String) -> Node:
	{
		id = into_opaque NodeId(number),
		label = label
	}


pure func renumbered(node: Node, number: Int) -> Node:
	relabel(node, into_opaque NodeId(number), node.label + "'")


pure func link(from_node: Node, to_node: Node) -> Edge:
	Linked(from_node.id, node_id(to_node))


pure func edge_sum(edge: Edge) -> Int:
	match edge:
		Linked(from_id, to_id):
			from_id.number() + node_number(to_id)
		Detached:
			0


pure func node_ids(nodes: List[Node]) -> NodeIds:
	nodes.map(func(node): node.id)
