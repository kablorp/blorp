record Thing {
	y: Int
}


struct Point {
	y: Int
}


union Choice:
	BY(Int)


func make() -> Thing:
	{y = 2}


func get(t: Thing) -> Int:
	t.y


func make_point() -> Point:
	{y = 4}


func point_value(p: Point) -> Int:
	p.y


func make_choice() -> Choice:
	BY(6)


func choice_value(c: Choice) -> Int:
	match c:
		BY(v): v
