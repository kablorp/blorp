-- A module that owns a trait and two types implementing it, so the importing
-- test can name the trait only through the module's alias.
trait Shape:
	pure func area(self: Self) -> Int


trait Labeled: Shape:
	pure func label(self: Self) -> String


record Square {
	side: Int
}


record Rectangle {
	width: Int,
	height: Int
}


implements Shape for Square:
	pure func area(self: Square) -> Int:
		self.side * self.side


implements Shape for Rectangle:
	pure func area(self: Rectangle) -> Int:
		self.width * self.height


implements Labeled for Rectangle:
	pure func label(self: Rectangle) -> String:
		"rectangle"


pure func make_square(side: Int) -> Square:
	{side = side}


pure func make_rectangle(width: Int, height: Int) -> Rectangle:
	{width = width, height = height}
