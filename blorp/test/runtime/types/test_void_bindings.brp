-- Void has no C storage, so the backend never declares a Void-typed binding.
-- Each form below binds a Void value and then uses the name; the uses must not
-- refer to an undeclared C variable.
import:
	test: TestSuite


func side_effect_free() -> Void:
	void


func touch() -> Result[Void, String]:
	Ok(void)


func accept_void(value: Void) -> Int:
	_ = value
	1


func test_let_bound_void_is_discarded() -> Bool:
	nothing = side_effect_free()
	_ = nothing
	True


func test_match_bound_void_payload_is_discarded() -> Bool:
	match touch():
		Ok(done):
			_ = done
			True
		Err(_):
			False


func propagate_void_payload() -> Result[Int, String]:
	done ?= touch()
	_ = done
	Ok(1)


func test_propagated_void_payload_is_discarded() -> Bool:
	match propagate_void_payload():
		Ok(value):
			value == 1
		Err(_):
			False


func test_void_binding_passed_as_argument() -> Bool:
	nothing = side_effect_free()
	accept_void(nothing) == 1


func return_void_binding() -> Void:
	nothing = side_effect_free()
	nothing


func test_void_binding_returned() -> Bool:
	return_void_binding()
	True


tests: TestSuite = {
	description = "Void bindings",
	tests = [
		("let-bound Void is discarded", test_let_bound_void_is_discarded),
		("match-bound Void payload is discarded", test_match_bound_void_payload_is_discarded),
		("?=-bound Void payload is discarded", test_propagated_void_payload_is_discarded),
		("Void binding passed as argument", test_void_binding_passed_as_argument),
		("Void binding returned", test_void_binding_returned),
	]
}
