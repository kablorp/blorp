-- Bug #17: to_string on List of tuples prints raw addresses
-- List[(Int, Int)] prints addresses instead of tuple contents
import:
	string: contains
	test: TestSuite


-- to_string of a simple pair
func test_pair_to_string() -> Bool:
	p: (Int, Int) = (1, 2)
	s: String = p.to_string()
	s == "(1, 2)"


-- to_string of a list of pairs
func test_list_of_pairs_to_string() -> Bool:
	pairs: List[(Int, Int)] = [(1, 2), (3, 4)]
	s: String = pairs.to_string()

	-- Should contain actual tuple values, not addresses
	s.contains("(1, 2)") and s.contains("(3, 4)")


-- to_string of list of string-int pairs
func test_list_of_string_int_pairs() -> Bool:
	pairs: List[(String, Int)] = [("hello", 1), ("world", 2)]
	s: String = pairs.to_string()
	s.contains("hello") and s.contains("world")


-- to_string of a triple
func test_triple_to_string() -> Bool:
	t: (Int, String, Bool) = (42, "test", True)
	s: String = t.to_string()
	s.contains("42") and s.contains("test") and s.contains("True")


-- to_string of list of triples
func test_list_of_triples_to_string() -> Bool:
	ts: List[(Int, Int, Int)] = [(1, 2, 3), (4, 5, 6)]
	s: String = ts.to_string()
	s.contains("1") and s.contains("2") and s.contains("3")


tests: TestSuite = {
	description = "to_string for tuples and lists of tuples",
	tests = [
		("pair to_string", test_pair_to_string),
		("list of pairs to_string", test_list_of_pairs_to_string),
		("list of string-int pairs", test_list_of_string_int_pairs),
		("triple to_string", test_triple_to_string),
		("list of triples to_string", test_list_of_triples_to_string),
	]
}
