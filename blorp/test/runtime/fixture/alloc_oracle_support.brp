-- Reporting starts only after callers have captured every scalar endpoint.
pure func heap_activity_failure(
	before_memory_active: Int,
	after_memory_active: Int,
	before_oracle_active: Int,
	after_oracle_active: Int,
	before: List[Int],
	after: List[Int],
) -> Option[String]:
	if before_memory_active == 0 or after_memory_active == 0:
		Some("memory stats inactive: run with --memory-stats or call reset_mem_stats() (needs a runtime built with BLORP_MEMORY_DIAGNOSTICS=1)")
	else if before_oracle_active == 0 or after_oracle_active == 0:
		Some("allocation oracle inactive: run with BLORP_MEMORY_STATS=1 (a disabled gate must fail, not read as zero)")
	else:
		labels = [
			"managed allocation requests", "managed release requests", "backing libc malloc events",
			"raw buffer malloc events", "raw buffer calloc events", "raw buffer realloc events",
			"raw aligned-buffer events", "cleanup scratch events", "fiber stack mmap events",
		]
		var failure: Option[String] = None
		for entry in labels.enumerate():
			match (before.get(entry[0]), after.get(entry[0])):
				(Some(first), Some(last)):
					if first != last:
						failure = Some(entry[1] + " moved by " + (last - first).to_string())
						break
				_:
					failure = Some("allocation oracle endpoint count does not match its counter schema")
					break
		failure
