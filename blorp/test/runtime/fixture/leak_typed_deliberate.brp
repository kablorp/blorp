-- Deliberately leaks one record without a destructor (a tag-only allocation
-- site), one record with a destructor, and one union, so the leak report can
-- be checked for per-type names from generated allocation sites. Retaining
-- through a borrowed foreign call leaves each value with an extra reference
-- that nothing releases.
record LeakPoint {
	x: Int,
	y: Int
}


record LeakLabeled {
	label: String,
	point: LeakPoint
}


union LeakChoice:
	LeakPicked(Int)
	LeakEmpty


foreign:
	@no_copy func retain_point(value: LeakPoint) -> Ptr = "blorp_retain"
	@no_copy func retain_labeled(value: LeakLabeled) -> Ptr = "blorp_retain"
	@no_copy func retain_choice(value: LeakChoice) -> Ptr = "blorp_retain"


func main(args: List[String]):
	point: LeakPoint = {
		x = args.length(),
		y = 2
	}
	labeled: LeakLabeled = {
		label = "hi",
		point = point
	}
	choice: LeakChoice = LeakPicked(args.length())
	_ = retain_point(point)
	_ = retain_labeled(labeled)
	_ = retain_choice(choice)
