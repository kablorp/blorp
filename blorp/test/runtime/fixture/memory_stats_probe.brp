-- Reports whether the managed-allocation counters were on at the program's
-- first snapshot, and whether the linked runtime is a diagnostic one at all
-- (a reset turns counting on only there). Only `run --memory-stats`, which
-- builds a diagnostic child and sets BLORP_MEMORY_STATS, makes both 1; see
-- test_alloc_oracle_blorp_level.sh.
import:
	memory: MemStats, get_mem_stats, reset_mem_stats


func main(args: List[String]):
	first: MemStats = get_mem_stats()
	reset_mem_stats()
	second: MemStats = get_mem_stats()
	print(
		"counters_at_start=${first.memory_stats_active} diagnostic_runtime=${second.memory_stats_active}",
	)
