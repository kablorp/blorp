-- Allocation oracle fixture: xs.map(...) is expected to allocate (a fresh
-- result list, at minimum), so this fixture asserts the OPPOSITE of the
-- other two fixtures: it fails if no heap activity is observed, and
-- reports which counters actually moved. Run with BLORP_ALLOCATOR_STATS=1
-- (see test_alloc_oracle_blorp_level.sh).
import:
	memory: MemStats, get_mem_stats, mem_delta


pure func sum_list(nums: List[Int]) -> Int:
	var total: Int = 0

	for n in nums:
		total += n

	total


func main(args: List[String]):
	nums: List[Int] = [1, 2, 3, 4, 5]

	before: MemStats = get_mem_stats()
	doubled: List[Int] = nums.map(pure func(n: Int) -> Int: n * 2)
	after: MemStats = get_mem_stats()
	delta: MemStats = mem_delta(before, after)

	sum_ok: Bool = doubled.length() == 5 and sum_list(doubled) == 30
	managed_moved: Bool = delta.total_allocations > 0
	raw_moved: Bool = (
		delta.raw_buffer_malloc_events > 0
		or delta.raw_buffer_calloc_events > 0
		or delta.raw_buffer_realloc_events > 0
		or delta.backing_pool_refill_events > 0
		or delta.backing_libc_malloc_events > 0
	)

	if before.oracle_stats_active == 0 or after.oracle_stats_active == 0:
		print("FAIL: allocation oracle inactive: run with BLORP_ALLOCATOR_STATS=1")
	else:
		if sum_ok and managed_moved:
			print(
				"PASS managed_allocations=" + delta.total_allocations.to_string() + " raw_buffer_or_pool_moved=" + raw_moved.to_string(),
			)
		else:
			print(
				"FAIL: sum_ok=" + sum_ok.to_string() + " managed_allocations_delta=" + delta.total_allocations.to_string(),
			)
