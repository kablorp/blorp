-- Allocation fixture for consuming-call specialization: helper shapes that
-- take a record and return it, each driven by `tables = helper(tables, i)`.
-- Every shape must update the record in place, so the allocations for N
-- appends grow only with the row list's capacity doublings, not with N.
-- Before owned parameters were declared, shapes 1-3 copied the record's
-- lists on every call (about 2N allocations); each later shape records the
-- change that made it update in place.
-- Run in its own process with --memory-stats
-- (see test_alloc_oracle_blorp_level.sh).
import:
	memory: MemStats, get_mem_stats, mem_delta


record Tables {
	rows: List[Int],
	other: List[Int]
}


-- The record is built before the measured region; inside it only the row
-- list reallocates, once per capacity doubling (at most ceil(log2(N)) + 1
-- times), plus a small constant for the first buffer.
private CONSTANT_ALLOCATION_ALLOWANCE: Int = 4

private SMALL_ROW_COUNT: Int = 1000

private LARGE_ROW_COUNT: Int = 10000


pure func append_row(tables: Tables, value: Int) -> Tables:
	{ tables | rows = tables.rows.append(value) }


pure func append_row_unless(tables: Tables, value: Int, skip: Bool) -> Tables:
	if skip:
		tables
	else:
		{ tables | rows = tables.rows.append(value) }


pure func append_row_via_helper(tables: Tables, value: Int) -> Tables:
	append_row(tables, value)


pure func append_row_via_var(tables: Tables, value: Int) -> Tables:
	var out: Tables = tables
	out = append_row(out, value)
	out


pure func append_other(tables: Tables, value: Int) -> Tables:
	{ tables | other = tables.other.append(value) }


---
A `var` alias of the parameter whose first update may not run: the branch
is not taken in the driver, so the unconditional update below must still
receive the parameter's own reference.
---
pure func append_row_after_conditional_alias_update(
	tables: Tables,
	value: Int,
	update_other: Bool,
) -> Tables:
	var out: Tables = tables

	if update_other:
		out = append_other(out, value)

	out = append_row(out, value)
	out


---
The loop form of the conditional alias: the driver runs it zero times.
---
pure func append_row_after_loop_alias_update(tables: Tables, value: Int, extra: Int) -> Tables:
	var out: Tables = tables

	for _ in 0..extra:
		out = append_other(out, value)

	out = append_row(out, value)
	out


---
A `var` updated under an if and then handed to a call in tail position: the
call is the slot's last use, so it must receive the slot's own reference.
---
pure func append_row_in_tail_call_after_conditional_update(
	tables: Tables,
	value: Int,
	update_other: Bool,
) -> Tables:
	var out: Tables = tables

	if update_other:
		out = append_other(out, value)

	append_row(out, value)


---
The loop form of the tail call: the driver runs the loop zero times.
---
pure func append_row_in_tail_call_after_loop_update(
	tables: Tables,
	value: Int,
	extra: Int,
) -> Tables:
	var out: Tables = tables

	for _ in 0..extra:
		out = append_other(out, value)

	append_row(out, value)


pure func append_row_checked(tables: Tables, value: Int, expected_length: Int) -> Tables:
	if tables.rows.length() == expected_length:
		append_row(tables, value)
	else:
		tables


---
A binding that reads the slot sits between the conditional update and the
tail call; it runs before the call, so the call is still the last use.
---
pure func append_row_in_tail_call_after_binding(
	tables: Tables,
	value: Int,
	update_other: Bool,
) -> Tables:
	var out: Tables = tables

	if update_other:
		out = append_other(out, value)

	length: Int = out.rows.length()
	append_row_checked(out, value, length)


---
A `var` initialized from a call and then updated with a record update: the
unconditional update is renamed into a fresh binding before ownership
analysis, and it is still the call result's last use.
---
pure func append_row_in_update_after_call(tables: Tables, value: Int) -> Tables:
	var out: Tables = append_row_unless(tables, value, True)
	out = { out | rows = out.rows.append(value) }
	out


---
The same with an immutable binding whose update is the result.
---
pure func append_row_in_update_of_call_result(tables: Tables, value: Int) -> Tables:
	out: Tables = append_row_unless(tables, value, True)
	{ out | rows = out.rows.append(value) }


pure func ceil_log2(value: Int) -> Int:
	var bits: Int = 0
	var capacity: Int = 1

	while capacity < value:
		capacity *= 2
		bits += 1

	bits


pure func growth_allowance(rows: Int) -> Int:
	ceil_log2(rows) + 1 + CONSTANT_ALLOCATION_ALLOWANCE


func appended_allocations(shape: Int, rows: Int) -> Int:
	var tables: Tables = {
		rows = [],
		other = []
	}
	before: MemStats = get_mem_stats()

	for i in 0..rows:
		match shape:
			0:
				tables = append_row(tables, i)
			1:
				tables = append_row_unless(tables, i, False)
			2:
				tables = append_row_via_helper(tables, i)
			3:
				tables = append_row_via_var(tables, i)
			4:
				tables = append_row_after_conditional_alias_update(tables, i, False)
			5:
				tables = append_row_after_loop_alias_update(tables, i, 0)
			6:
				tables = append_row_in_tail_call_after_conditional_update(tables, i, False)
			7:
				tables = append_row_in_tail_call_after_loop_update(tables, i, 0)
			8:
				tables = append_row_in_tail_call_after_binding(tables, i, False)
			9:
				tables = append_row_in_update_after_call(tables, i)
			_:
				tables = append_row_in_update_of_call_result(tables, i)

	after: MemStats = get_mem_stats()

	if tables.rows.length() == rows and tables.rows.get_or(rows - 1, -1) == rows - 1:
		counted_allocations(before, after)
	else:
		-1


---
The managed allocations between two snapshots, or -1 when counting was off
(without `--memory-stats` every count reads 0, which would pass vacuously).
---
func counted_allocations(before: MemStats, after: MemStats) -> Int:
	if before.memory_stats_active == 1 and after.memory_stats_active == 1:
		mem_delta(before, after).total_allocations
	else:
		-1


func main(args: List[String]):
	names: List[String] = [
		"record update",
		"maybe-identity branch",
		"call on parameter",
		"var rebinding",
		"var alias updated under an if first",
		"var alias updated in a loop first",
		"tail call after a conditional update",
		"tail call after a loop update",
		"tail call after a binding that reads the var",
		"record update after a call",
		"record update of a call result",
	]
	var failures: List[String] = []

	for shape in 0..names.length():
		small: Int = appended_allocations(shape, SMALL_ROW_COUNT)
		large: Int = appended_allocations(shape, LARGE_ROW_COUNT)

		if (
			small < 0
			or large < 0
			or small > growth_allowance(SMALL_ROW_COUNT)
			or large > growth_allowance(LARGE_ROW_COUNT)
		):
			failures = failures.append(
				"${names.get_or(shape, "")}: ${small} allocations for ${SMALL_ROW_COUNT} rows, ${large} for ${LARGE_ROW_COUNT}",
			)
		else:
			void

	if failures.length() == 0:
		print("PASS")
	else:
		print("FAIL: ${failures.join("; ")}")
