-- Allocation oracle fixture: a purely scalar computation should touch no
-- allocation path at all, managed or raw. Run with BLORP_ALLOCATOR_STATS=1
-- (see test_alloc_oracle_blorp_level.sh).
import:
	memory: MemStats, assert_no_heap_activity, get_mem_stats


func add3(a: Int, b: Int, c: Int) -> Int:
	a + b + c


func main(args: List[String]):
	before: MemStats = get_mem_stats()
	result: Int = add3(2, 3, 4)
	after: MemStats = get_mem_stats()

	match assert_no_heap_activity(before, after):
		Ok(_):
			if result == 9:
				print("PASS")
			else:
				print("FAIL: unexpected result " + result.to_string())
		Err(reason):
			print("FAIL: " + reason)
