-- Comprehensive SIMD test combining all features
import:
	test: TestSuite


func test_dot_product() -> Bool:
	a: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	b: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	p0: Float = a[0] * b[0]
	p1: Float = a[1] * b[1]
	p2: Float = a[2] * b[2]
	p3: Float = a[3] * b[3]
	result: Float = p0 + p1 + p2 + p3
	result == 30.0


func test_chained_mul_add_0() -> Bool:
	a: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	b: Float[#4] = {2.0, 2.0, 2.0, 2.0}
	c: Float[#4] = {1.0, 1.0, 1.0, 1.0}
	temp: Float[#4] = a * b
	result: Float[#4] = temp + c
	result[0] == 3.0


func test_chained_mul_add_1() -> Bool:
	a: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	b: Float[#4] = {2.0, 2.0, 2.0, 2.0}
	c: Float[#4] = {1.0, 1.0, 1.0, 1.0}
	temp: Float[#4] = a * b
	result: Float[#4] = temp + c
	result[1] == 5.0


func test_chained_mul_add_2() -> Bool:
	a: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	b: Float[#4] = {2.0, 2.0, 2.0, 2.0}
	c: Float[#4] = {1.0, 1.0, 1.0, 1.0}
	temp: Float[#4] = a * b
	result: Float[#4] = temp + c
	result[2] == 7.0


func test_chained_mul_add_3() -> Bool:
	a: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	b: Float[#4] = {2.0, 2.0, 2.0, 2.0}
	c: Float[#4] = {1.0, 1.0, 1.0, 1.0}
	temp: Float[#4] = a * b
	result: Float[#4] = temp + c
	result[3] == 9.0


func test_element_access_x() -> Bool:
	v: Float[#4] = {10.0, 20.0, 30.0, 40.0}
	x: Float = v[0]
	x == 10.0


func test_element_access_y() -> Bool:
	v: Float[#4] = {10.0, 20.0, 30.0, 40.0}
	y: Float = v[1]
	y == 20.0


func test_element_access_z() -> Bool:
	v: Float[#4] = {10.0, 20.0, 30.0, 40.0}
	z: Float = v[2]
	z == 30.0


func test_element_access_w() -> Bool:
	v: Float[#4] = {10.0, 20.0, 30.0, 40.0}
	w: Float = v[3]
	w == 40.0


func test_vec3_add_x() -> Bool:
	a: Float[#3] = {1.0, 0.0, 0.0}
	b: Float[#3] = {0.0, 1.0, 0.0}
	c: Float[#3] = a + b
	c[0] == 1.0


func test_vec3_add_y() -> Bool:
	a: Float[#3] = {1.0, 0.0, 0.0}
	b: Float[#3] = {0.0, 1.0, 0.0}
	c: Float[#3] = a + b
	c[1] == 1.0


func test_vec3_add_z() -> Bool:
	a: Float[#3] = {1.0, 0.0, 0.0}
	b: Float[#3] = {0.0, 1.0, 0.0}
	c: Float[#3] = a + b
	c[2] == 0.0


tests: TestSuite = {
	description = "SIMD Comprehensive",
	tests = [
		("Dot product calculation", test_dot_product),
		("Chained mul+add [0]", test_chained_mul_add_0),
		("Chained mul+add [1]", test_chained_mul_add_1),
		("Chained mul+add [2]", test_chained_mul_add_2),
		("Chained mul+add [3]", test_chained_mul_add_3),
		("Element access x", test_element_access_x),
		("Element access y", test_element_access_y),
		("Element access z", test_element_access_z),
		("Element access w", test_element_access_w),
		("Vec3 add x component", test_vec3_add_x),
		("Vec3 add y component", test_vec3_add_y),
		("Vec3 add z component", test_vec3_add_z),
	]
}
