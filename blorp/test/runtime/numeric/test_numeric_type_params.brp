-- Test #N syntax for numeric type parameters
import:
	test: TestSuite


func test_array_subscript_first() -> Bool:
	arr: Int[#3] = {10, 20, 30}
	first: Int = arr[0]
	first == 10


func test_array_subscript_second() -> Bool:
	arr: Int[#3] = {10, 20, 30}
	second: Int = arr[1]
	second == 20


func test_array_subscript_third() -> Bool:
	arr: Int[#3] = {10, 20, 30}
	third: Int = arr[2]
	third == 30


tests: TestSuite = {
	description = "Numeric Type Params",
	tests = [
		("Vector [0] returns first element", test_array_subscript_first),
		("Vector [1] returns second element", test_array_subscript_second),
		("Vector [2] returns third element", test_array_subscript_third),
	]
}
