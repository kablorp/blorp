import:
	test: TestSuite


-- Test variadic dimensions with runtime execution
-- Function that accepts any Int tensor regardless of dimensionality
func accepts_any_int(t: Int[#Ds...]) -> Bool:
	True


pure func preserve_shape[#N](values: Int[#N, #Ds...]) -> Int[#N, #Ds...]:
	values


-- Test 1D tensor passes to #Ds... param
func test_1d() -> Bool:
	v: Int[#3] = {1, 2, 3}
	accepts_any_int(v)


-- Test 2D tensor passes to #Ds... param
func test_2d() -> Bool:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	accepts_any_int(m)


func test_fixed_prefix_return() -> Bool:
	values: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	result: Int[#2, #3] = preserve_shape(values)
	result.length() == 2


tests: TestSuite = {
	description = "Variadic Dims",
	tests = [
		("1D tensor to #Ds...", test_1d),
		("2D tensor to #Ds...", test_2d),
		("fixed prefix return preserves shape", test_fixed_prefix_return),
	]
}
