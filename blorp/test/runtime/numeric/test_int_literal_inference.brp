import:
	test: TestSuite
	tensor: indices


func takes_int(value: Int) -> Int:
	value + 1


func takes_small(value: Int8) -> Int8:
	value


func takes_refined(value: #42) -> Int:
	value + 0


func var_literal_accumulates() -> Bool:
	var x = 42
	x += 1
	x == 43


func var_literal_accumulates_in_loop() -> Bool:
	var total = 0

	for i in 0..10:
		total += i

	total == 45


func immutable_literal_passes_as_int() -> Bool:
	x = 5
	takes_int(x) == 6


func refined_binding_keeps_its_type() -> Bool:
	y: #42 = 42
	takes_int(y) == 43 and takes_refined(y) == 42


func mutable_refined_binding_reads_back() -> Bool:
	var y: #42 = 42
	y == 42


func unannotated_var_from_refined_name_updates() -> Bool:
	n: #3 = 3
	var z = n
	z += 1
	z == 4


func sized_int_literal_still_targets_its_type() -> Bool:
	small: Int8 = 7
	negative: Int8 = takes_small(-3)
	takes_small(small) == small and negative < small


func literal_subscripts_keep_compile_time_proof() -> Bool:
	v: Int[#3] = {10, 20, 30}
	v[0] + v[2] + v[-1] == 70


func range_and_indices_loops_keep_compile_time_proof() -> Bool:
	v: Int[#3] = {10, 20, 30}
	var total = 0

	for i in 0..3:
		total += v[i]

	for i in indices(v):
		total += v[i]

	total == 120


func modulo_by_literal_indexes_safely() -> Bool:
	v: Int[#3] = {10, 20, 30}
	v[7 % 3] == 20


func literal_slice_keeps_compile_time_proof() -> Bool:
	v: Int[#4] = {1, 2, 3, 4}
	middle = checked_slice(v, 1, 3)
	length(middle) == 2 and v[1] == 2


tests: TestSuite = {
	description = "Integer literal inference",
	tests = [
		("var literal accumulates", var_literal_accumulates),
		("var literal accumulates in loop", var_literal_accumulates_in_loop),
		("immutable literal passes as Int", immutable_literal_passes_as_int),
		("refined binding keeps its type", refined_binding_keeps_its_type),
		("mutable refined binding reads back", mutable_refined_binding_reads_back),
		("unannotated var from refined name updates", unannotated_var_from_refined_name_updates),
		("sized int literal still targets its type", sized_int_literal_still_targets_its_type),
		("literal subscripts keep compile-time proof", literal_subscripts_keep_compile_time_proof),
		(
			"range and indices loops keep compile-time proof",
			range_and_indices_loops_keep_compile_time_proof,
		),
		("modulo by literal indexes safely", modulo_by_literal_indexes_safely),
		(
			"literal slice keeps compile-time proof",
			literal_slice_keeps_compile_time_proof,
		),
	]
}
