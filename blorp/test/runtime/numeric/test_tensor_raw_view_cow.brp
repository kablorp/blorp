import:
	test: TestSuite


func test_raw_view_update_preserves_alias() -> Bool:
	base: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	var xs = base
	snapshot = xs
	for i in 0..length(xs):
		xs[i] = xs[i] + 1.0
	snapshot[0] == 1.0 and xs[0] == 2.0 and xs[3] == 5.0


func test_raw_view_update_unique_result() -> Bool:
	var xs: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	for i in 0..length(xs):
		xs[i] = xs[i] + 2.0
	xs[0] == 3.0 and xs[3] == 6.0


tests: TestSuite = {
	description = "Tensor raw-view COW semantics",
	tests = [
		("raw-view update preserves alias", test_raw_view_update_preserves_alias),
		("raw-view update unique result", test_raw_view_update_unique_result),
	]
}
