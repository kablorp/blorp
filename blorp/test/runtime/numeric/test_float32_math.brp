import:
	test: TestSuite


func approx_eq(a: Float32, b: Float32) -> Bool:
	diff: Float32 = a - b
	threshold: Float32 = 0.001
	abs(diff) < threshold


func test_sin_float32() -> Bool:
	x: Float32 = 0.0
	approx_eq(sin(x), 0.0 as Float32)


func test_cos_float32() -> Bool:
	x: Float32 = 0.0
	approx_eq(cos(x), 1.0 as Float32)


func test_sqrt_float32() -> Bool:
	x: Float32 = 4.0
	approx_eq(sqrt(x), 2.0 as Float32)


func test_floor_float32() -> Bool:
	x: Float32 = 3.7
	approx_eq(floor(x), 3.0 as Float32)


func test_ceil_float32() -> Bool:
	x: Float32 = 3.2
	approx_eq(ceil(x), 4.0 as Float32)


func test_round_float32() -> Bool:
	x: Float32 = 3.5
	approx_eq(round(x), 4.0 as Float32)


func test_exp_float32() -> Bool:
	x: Float32 = 0.0
	approx_eq(exp(x), 1.0 as Float32)


func test_log_float32() -> Bool:
	x: Float32 = 1.0
	approx_eq(log(x), 0.0 as Float32)


func test_pow_float32() -> Bool:
	x: Float32 = 2.0
	y: Float32 = 3.0
	approx_eq(pow(x, y), 8.0 as Float32)


func test_atan2_float32() -> Bool:
	x: Float32 = 1.0
	y: Float32 = 1.0
	approx_eq(atan2(x, y), 0.7853981 as Float32)


func test_trunc_float32() -> Bool:
	x: Float32 = 3.9
	approx_eq(trunc(x), 3.0 as Float32)


func test_tan_float32() -> Bool:
	x: Float32 = 0.0
	approx_eq(tan(x), 0.0 as Float32)


func test_asin_float32() -> Bool:
	x: Float32 = 0.0
	approx_eq(asin(x), 0.0 as Float32)


func test_acos_float32() -> Bool:
	x: Float32 = 1.0
	approx_eq(acos(x), 0.0 as Float32)


func test_cbrt_float32() -> Bool:
	x: Float32 = 27.0
	approx_eq(cbrt(x), 3.0 as Float32)


tests: TestSuite = {
	description = "Float32 Math Tests",
	tests = [
		("sin float32", test_sin_float32),
		("cos float32", test_cos_float32),
		("sqrt float32", test_sqrt_float32),
		("floor float32", test_floor_float32),
		("ceil float32", test_ceil_float32),
		("round float32", test_round_float32),
		("exp float32", test_exp_float32),
		("log float32", test_log_float32),
		("pow float32", test_pow_float32),
		("atan2 float32", test_atan2_float32),
		("trunc float32", test_trunc_float32),
		("tan float32", test_tan_float32),
		("asin float32", test_asin_float32),
		("acos float32", test_acos_float32),
		("cbrt float32", test_cbrt_float32),
	]
}
