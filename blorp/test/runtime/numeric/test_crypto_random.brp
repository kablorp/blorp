import:
	bytes as B
	crypto_random: crypto_random_bytes, random_hex, random_token
	test: TestSuite


-- Test correct length
func test_length_16() -> Bool:
	b: Bytes = crypto_random_bytes(16)
	B.length(b) == 16


func test_length_32() -> Bool:
	b: Bytes = crypto_random_bytes(32)
	B.length(b) == 32


func test_length_0() -> Bool:
	b: Bytes = crypto_random_bytes(0)
	B.length(b) == 0


func test_length_1() -> Bool:
	b: Bytes = crypto_random_bytes(1)
	B.length(b) == 1


-- Test that two calls produce different results (extremely high probability)
func test_uniqueness() -> Bool:
	a: Bytes = crypto_random_bytes(32)
	b: Bytes = crypto_random_bytes(32)
	B.to_hex(a) != B.to_hex(b)


-- Test random_hex length (2 hex chars per byte)
func test_hex_length() -> Bool:
	h: String = random_hex(8)
	h.length() == 16


func test_hex_length_16() -> Bool:
	h: String = random_hex(16)
	h.length() == 32


func test_hex_uniqueness() -> Bool:
	a: String = random_hex(16)
	b: String = random_hex(16)
	a != b


-- Test random_token produces non-empty string
func test_token_nonempty() -> Bool:
	t: String = random_token(16)
	t.length() > 0


func test_token_uniqueness() -> Bool:
	a: String = random_token(16)
	b: String = random_token(16)
	a != b


tests: TestSuite = {
	description = "Crypto Random",
	tests = [
		("length 16", test_length_16),
		("length 32", test_length_32),
		("length 0", test_length_0),
		("length 1", test_length_1),
		("uniqueness", test_uniqueness),
		("hex length 8", test_hex_length),
		("hex length 16", test_hex_length_16),
		("hex uniqueness", test_hex_uniqueness),
		("token nonempty", test_token_nonempty),
		("token uniqueness", test_token_uniqueness),
	]
}
