-- Test negation codegen edge cases
import:
	int: INT_MIN
	test: TestSuite
	traits: negate


func test_negate_negative_int() -> Bool:
	x: Int = -(-1)
	x == 1


func test_negate_negative_float() -> Bool:
	x: Float = -(-1.5)
	x == 1.5


func test_double_negate_var() -> Bool:
	y: Int = 5
	x: Int = -(-y)
	x == 5


func test_minimum_int_wraps() -> Bool:
	negate(INT_MIN) == INT_MIN


func test_minimum_int8_wraps() -> Bool:
	negate(to_int8(-128)) == to_int8(-128)


func test_minimum_int16_wraps() -> Bool:
	negate(to_int16(-32768)) == to_int16(-32768)


func test_minimum_int32_wraps() -> Bool:
	negate(to_int32(-2147483648)) == to_int32(-2147483648)


func test_minimum_int128_wraps() -> Bool:
	var minimum: Int128 = to_int128(-1)
	for _ in 0..127:
		minimum *= to_int128(2)

	negate(minimum) == minimum


tests: TestSuite = {
	description = "Negation tests",
	tests = [
		("negate negative int literal", test_negate_negative_int),
		("negate negative float literal", test_negate_negative_float),
		("double negate variable", test_double_negate_var),
		("minimum Int negation wraps", test_minimum_int_wraps),
		("minimum Int8 negation wraps", test_minimum_int8_wraps),
		("minimum Int16 negation wraps", test_minimum_int16_wraps),
		("minimum Int32 negation wraps", test_minimum_int32_wraps),
		("minimum Int128 negation wraps", test_minimum_int128_wraps),
	]
}
