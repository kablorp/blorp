import:
	float: approx_eq
	geometry: Vec2, vec2
	physics:
		attract_force,
		bounce,
		damping_force,
		euler_step,
		gravity_force,
		move_toward,
		reflect,
		rk4_step,
		separate_circles,
		smooth_damp,
		spring_force,
		verlet_step,
	test: TestSuite


-- Integration tests
pure func test_euler_stationary() -> Bool:
	r: (Vec2, Vec2) = euler_step(vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), 1.0)
	approx_eq(r[0].x, 0.0) and approx_eq(r[0].y, 0.0)


pure func test_euler_constant_velocity() -> Bool:
	r: (Vec2, Vec2) = euler_step(vec2(0.0, 0.0), vec2(5.0, 0.0), vec2(0.0, 0.0), 1.0)
	approx_eq(r[0].x, 5.0) and approx_eq(r[1].x, 5.0)


pure func test_euler_acceleration() -> Bool:
	r: (Vec2, Vec2) = euler_step(vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), 1.0)

	-- After 1s with a=1: v=1, p=1
	approx_eq(r[1].x, 1.0) and approx_eq(r[0].x, 1.0)


pure func test_verlet_constant_velocity() -> Bool:
	-- If prev=(0,0) and curr=(1,0), implicit velocity is (1,0)
	r: (Vec2, Vec2) = verlet_step(vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), 1.0)
	approx_eq(r[0].x, 2.0) and approx_eq(r[0].y, 0.0)


pure func test_rk4_constant_accel() -> Bool:
	acc: pure (Vec2, Vec2) -> Vec2 = pure func(p: Vec2, v: Vec2): vec2(0.0, -10.0)
	r: (Vec2, Vec2) = rk4_step(vec2(0.0, 100.0), vec2(0.0, 0.0), acc, 0.1)

	-- After 0.1s: y should decrease, vy should be negative
	r[0].y < 100.0 and r[1].y < 0.0


-- Force tests
pure func test_gravity_force() -> Bool:
	f: Vec2 = gravity_force(2.0, 9.8)
	approx_eq(f.x, 0.0) and approx_eq(f.y, 19.6)


pure func test_spring_force_stretched() -> Bool:
	-- Spring at (2,0), anchor at (0,0), k=1, rest=0 -> force should pull left
	f: Vec2 = spring_force(vec2(2.0, 0.0), vec2(0.0, 0.0), 1.0, 0.0)
	f.x < 0.0


pure func test_spring_force_at_rest() -> Bool:
	-- When at anchor with rest_length=0, force is zero
	f: Vec2 = spring_force(vec2(0.0, 0.0), vec2(0.0, 0.0), 1.0, 0.0)
	approx_eq(f.x, 0.0) and approx_eq(f.y, 0.0)


pure func test_damping_force() -> Bool:
	f: Vec2 = damping_force(vec2(10.0, 5.0), 0.5)
	approx_eq(f.x, -5.0) and approx_eq(f.y, -2.5)


pure func test_attract_force_direction() -> Bool:
	f: Vec2 = attract_force(vec2(0.0, 0.0), vec2(10.0, 0.0), 5.0)
	approx_eq(f.x, 5.0) and approx_eq(f.y, 0.0)


pure func test_attract_force_at_target() -> Bool:
	f: Vec2 = attract_force(vec2(5.0, 5.0), vec2(5.0, 5.0), 10.0)
	approx_eq(f.x, 0.0) and approx_eq(f.y, 0.0)


-- Collision response tests
pure func test_reflect_horizontal() -> Bool:
	r: Vec2 = reflect(vec2(1.0, -1.0), vec2(0.0, 1.0))
	approx_eq(r.x, 1.0) and approx_eq(r.y, 1.0)


pure func test_reflect_vertical() -> Bool:
	r: Vec2 = reflect(vec2(-1.0, 1.0), vec2(1.0, 0.0))
	approx_eq(r.x, 1.0) and approx_eq(r.y, 1.0)


pure func test_bounce_full_restitution() -> Bool:
	-- restitution=1.0 should be same as reflect
	b: Vec2 = bounce(vec2(1.0, -1.0), vec2(0.0, 1.0), 1.0)
	approx_eq(b.x, 1.0) and approx_eq(b.y, 1.0)


pure func test_bounce_half_restitution() -> Bool:
	b: Vec2 = bounce(vec2(1.0, -1.0), vec2(0.0, 1.0), 0.5)
	approx_eq(b.x, 1.0) and approx_eq(b.y, 0.5)


pure func test_bounce_zero_restitution() -> Bool:
	-- restitution=0 should remove normal component
	b: Vec2 = bounce(vec2(1.0, -1.0), vec2(0.0, 1.0), 0.0)
	approx_eq(b.x, 1.0) and approx_eq(b.y, 0.0)


pure func test_separate_circles_overlapping() -> Bool:
	r: (Vec2, Vec2) = separate_circles(vec2(0.0, 0.0), 1.0, vec2(1.0, 0.0), 1.0)

	-- They should be pushed apart
	r[0].x < 0.0 and r[1].x > 1.0


pure func test_separate_circles_no_overlap() -> Bool:
	r: (Vec2, Vec2) = separate_circles(vec2(0.0, 0.0), 1.0, vec2(5.0, 0.0), 1.0)

	-- No change
	approx_eq(r[0].x, 0.0) and approx_eq(r[1].x, 5.0)


-- Utility tests
pure func test_move_toward_partial() -> Bool:
	v: Vec2 = move_toward(vec2(0.0, 0.0), vec2(10.0, 0.0), 3.0)
	approx_eq(v.x, 3.0) and approx_eq(v.y, 0.0)


pure func test_move_toward_overshoot() -> Bool:
	-- max_delta > distance: should arrive at target
	v: Vec2 = move_toward(vec2(0.0, 0.0), vec2(2.0, 0.0), 10.0)
	approx_eq(v.x, 2.0)


pure func test_move_toward_at_target() -> Bool:
	v: Vec2 = move_toward(vec2(5.0, 5.0), vec2(5.0, 5.0), 1.0)
	approx_eq(v.x, 5.0) and approx_eq(v.y, 5.0)


pure func test_smooth_damp_moves_toward_target() -> Bool:
	r: (Float, Float) = smooth_damp(0.0, 10.0, 0.0, 0.5, 0.016)
	r[0] > 0.0 and r[0] < 10.0


pure func test_smooth_damp_at_target() -> Bool:
	r: (Float, Float) = smooth_damp(10.0, 10.0, 0.0, 0.5, 0.016)
	approx_eq(r[0], 10.0)


tests: TestSuite = {
	description = "Physics Module",
	tests = [
		("euler stationary", test_euler_stationary),
		("euler constant velocity", test_euler_constant_velocity),
		("euler acceleration", test_euler_acceleration),
		("verlet constant velocity", test_verlet_constant_velocity),
		("rk4 constant accel", test_rk4_constant_accel),
		("gravity force", test_gravity_force),
		("spring force stretched", test_spring_force_stretched),
		("spring force at rest", test_spring_force_at_rest),
		("damping force", test_damping_force),
		("attract force direction", test_attract_force_direction),
		("attract force at target", test_attract_force_at_target),
		("reflect horizontal", test_reflect_horizontal),
		("reflect vertical", test_reflect_vertical),
		("bounce full restitution", test_bounce_full_restitution),
		("bounce half restitution", test_bounce_half_restitution),
		("bounce zero restitution", test_bounce_zero_restitution),
		("separate circles overlap", test_separate_circles_overlapping),
		("separate circles no overlap", test_separate_circles_no_overlap),
		("move toward partial", test_move_toward_partial),
		("move toward overshoot", test_move_toward_overshoot),
		("move toward at target", test_move_toward_at_target),
		("smooth damp toward target", test_smooth_damp_moves_toward_target),
		("smooth damp at target", test_smooth_damp_at_target),
	]
}
