import:
	test: TestSuite


func sum_vec(v: Int[#3]) -> Int:
	var total: Int = 0
	for i in 0..length(v):
		total += v[i]
	total


func test_vector_param_call() -> Bool:
	v: Int[#3] = {10, 20, 30}
	sum_vec(v) == 60


func test_matrix_param() -> Bool:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	var sum: Int = 0
	for i in 0..length(m):
		for j in 0..length(m[i]):
			sum += m[i][j]
	sum == 21


tests: TestSuite = {
	description = "Array Params",
	tests = [("vector param call", test_vector_param_call), ("matrix param", test_matrix_param)]
}
