-- Test scalar broadcasting and element-wise tensor arithmetic
import:
	test: TestSuite


-- ============================================================================
-- Scalar broadcast (existing tests)
-- ============================================================================
-- Test v * scalar (Int)
func test_mul_scalar_int() -> Bool:
	v: Int[#3] = {2, 4, 6}
	r: Int[#3] = v * 3
	r[0] == 6 and r[1] == 12 and r[2] == 18


-- Test v * scalar (Float)
func test_mul_scalar_float() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	r: Float[#3] = v * 2.0
	r[0] == 2.0 and r[1] == 4.0 and r[2] == 6.0


-- Test v + scalar
func test_add_scalar() -> Bool:
	v: Int[#3] = {1, 2, 3}
	r: Int[#3] = v + 10
	r[0] == 11 and r[1] == 12 and r[2] == 13


-- Test v - scalar
func test_sub_scalar() -> Bool:
	v: Int[#3] = {10, 20, 30}
	r: Int[#3] = v - 5
	r[0] == 5 and r[1] == 15 and r[2] == 25


-- Test v / scalar (safe div)
func test_div_scalar() -> Bool:
	v: Int[#3] = {10, 20, 30}
	r: Int[#3] = v / 5
	r[0] == 2 and r[1] == 4 and r[2] == 6


-- Test reversed: scalar * v
func test_scalar_mul_reversed() -> Bool:
	v: Int[#3] = {2, 4, 6}
	r: Int[#3] = 3 * v
	r[0] == 6 and r[1] == 12 and r[2] == 18


-- Test reversed: scalar + v
func test_scalar_add_reversed() -> Bool:
	v: Int[#3] = {1, 2, 3}
	r: Int[#3] = 10 + v
	r[0] == 11 and r[1] == 12 and r[2] == 13


-- Test reversed: scalar - v (non-commutative)
func test_scalar_sub_reversed() -> Bool:
	v: Int[#3] = {1, 2, 3}
	r: Int[#3] = 10 - v
	r[0] == 9 and r[1] == 8 and r[2] == 7


-- Test safe div by zero
func test_safe_div_zero() -> Bool:
	v: Int[#3] = {10, 20, 30}
	r: Int[#3] = v / 0
	r[0] == 0 and r[1] == 0 and r[2] == 0


-- ============================================================================
-- Element-wise tensor + tensor arithmetic (new tests)
-- ============================================================================
-- Test v + v (Int)
func test_elemwise_add_int() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: Int[#3] = {4, 5, 6}
	r: Int[#3] = a + b
	r[0] == 5 and r[1] == 7 and r[2] == 9


-- Test v - v (Int)
func test_elemwise_sub_int() -> Bool:
	a: Int[#3] = {10, 20, 30}
	b: Int[#3] = {1, 2, 3}
	r: Int[#3] = a - b
	r[0] == 9 and r[1] == 18 and r[2] == 27


-- Test v * v (Int)
func test_elemwise_mul_int() -> Bool:
	a: Int[#3] = {2, 3, 4}
	b: Int[#3] = {5, 6, 7}
	r: Int[#3] = a * b
	r[0] == 10 and r[1] == 18 and r[2] == 28


-- Test v / v (Int, safe div)
func test_elemwise_div_int() -> Bool:
	a: Int[#3] = {10, 20, 30}
	b: Int[#3] = {2, 4, 5}
	r: Int[#3] = a / b
	r[0] == 5 and r[1] == 5 and r[2] == 6


-- Test v + v (Float)
func test_elemwise_add_float() -> Bool:
	a: Float[#2] = {1.0, 2.0}
	b: Float[#2] = {3.0, 4.0}
	r: Float[#2] = a + b
	r[0] == 4.0 and r[1] == 6.0


tests: TestSuite = {
	description = "Tensor Broadcast & Element-wise",
	tests = [
		("v * scalar int", test_mul_scalar_int),
		("v * scalar float", test_mul_scalar_float),
		("v + scalar", test_add_scalar),
		("v - scalar", test_sub_scalar),
		("v / scalar", test_div_scalar),
		("scalar * v", test_scalar_mul_reversed),
		("scalar + v", test_scalar_add_reversed),
		("scalar - v", test_scalar_sub_reversed),
		("safe div by zero", test_safe_div_zero),
		("v + v int", test_elemwise_add_int),
		("v - v int", test_elemwise_sub_int),
		("v * v int", test_elemwise_mul_int),
		("v / v int", test_elemwise_div_int),
		("v + v float", test_elemwise_add_float),
	]
}
