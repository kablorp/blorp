-- Regression: local functions named like tensor loop producers must not be
-- reclassified as compiler loop views.
import:
	test: TestSuite


func enumerate(v: Int[#3]) -> List[(Int, Int)]:
	[(100, 7)]


func enumerate2(m: Int[#2, #2]) -> List[(Int, Int, Int)]:
	[(9, 8, 7)]


func test_local_enumerate_wins() -> Bool:
	v: Int[#3] = {1, 2, 3}
	var total: Int = 0
	for (i, x) in enumerate(v):
		total += i + x
	total == 107


func test_local_enumerate2_wins() -> Bool:
	m: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	var total: Int = 0
	for (i, j, x) in enumerate2(m):
		total += i + j + x
	total == 24


tests: TestSuite = {
	description = "tensor loop-view shadowing",
	tests = [
		("local enumerate wins", test_local_enumerate_wins),
		("local enumerate2 wins", test_local_enumerate2_wins),
	]
}
