import:
	test: TestSuite


-- Test #12: Vector equality
func test_equal_int_vectors() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: Int[#3] = {1, 2, 3}
	a == b


func test_unequal_int_vectors() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: Int[#3] = {1, 2, 4}
	not (a == b)


func test_equal_float_vectors() -> Bool:
	a: Float[#2] = {1.5, 2.5}
	b: Float[#2] = {1.5, 2.5}
	a == b


func test_unequal_float_vectors() -> Bool:
	a: Float[#2] = {1.5, 2.5}
	b: Float[#2] = {1.5, 3.5}
	not (a == b)


func test_not_equal_operator() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: Int[#3] = {1, 2, 4}
	a != b


func test_equal_int_matrices() -> Bool:
	m1: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	m2: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	m1 == m2


func test_unequal_int_matrices() -> Bool:
	m1: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	m2: Int[#2, #2] = {
		{1, 2},
		{3, 5},
	}
	not (m1 == m2)


tests: TestSuite = {
	description = "Vector equality",
	tests = [
		("equal int vectors", test_equal_int_vectors),
		("unequal int vectors", test_unequal_int_vectors),
		("equal float vectors", test_equal_float_vectors),
		("unequal float vectors", test_unequal_float_vectors),
		("not equal operator", test_not_equal_operator),
		("equal int matrices", test_equal_int_matrices),
		("unequal int matrices", test_unequal_int_matrices),
	]
}
