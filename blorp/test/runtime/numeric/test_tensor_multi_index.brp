import:
	test: TestSuite


-- Test multi-index read on 2D tensors (matrices)
func test_matrix_read() -> Bool:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	m[0, 0] == 1 and m[0, 2] == 3 and m[1, 0] == 4 and m[1, 2] == 6


func test_matrix_float_read() -> Bool:
	m: Float[#2, #2] = {
		{1.5, 2.5},
		{3.5, 4.5},
	}
	m[0, 0] == 1.5 and m[0, 1] == 2.5 and m[1, 0] == 3.5 and m[1, 1] == 4.5


-- Test multi-index write on 2D tensors
func test_matrix_write() -> Bool:
	var m: Int[#2, #3] = {
		{0, 0, 0},
		{0, 0, 0},
	}
	m[0, 1] = 42
	m[1, 2] = 99
	m[0, 1] == 42 and m[1, 2] == 99 and m[0, 0] == 0


func test_matrix_float_write() -> Bool:
	var m: Float[#2, #2] = {
		{0.0, 0.0},
		{0.0, 0.0},
	}
	m[1, 0] = 3.14
	m[1, 0] == 3.14 and m[0, 0] == 0.0


-- Test 1D subscript assignment
func test_vector_write() -> Bool:
	var v: Int[#3] = {10, 20, 30}
	v[1] = 99
	v[0] == 10 and v[1] == 99 and v[2] == 30


tests: TestSuite = {
	description = "Multi-index tensor subscript",
	tests = [
		("matrix read int", test_matrix_read),
		("matrix read float", test_matrix_float_read),
		("matrix write int", test_matrix_write),
		("matrix write float", test_matrix_float_write),
		("vector write", test_vector_write),
	]
}
