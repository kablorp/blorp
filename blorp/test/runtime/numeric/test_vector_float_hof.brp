import:
	test: TestSuite
	vector: fold, map


func test_map_float_double() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	doubled: Float[#3] = v.map(func(x: Float) -> Float: x * 2.0)
	x0: Float = doubled[0]
	x1: Float = doubled[1]
	x2: Float = doubled[2]
	x0 == 2.0 and x1 == 4.0 and x2 == 6.0


func test_fold_float_sum() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	total: Float = v.fold(0.0, func(acc: Float, x: Float) -> Float: acc + x)
	total == 6.0


func test_map_int_still_works() -> Bool:
	v: Int[#3] = {10, 20, 30}
	doubled: Int[#3] = v.map(func(x: Int) -> Int: x * 2)
	doubled[0] == 20 and doubled[1] == 40 and doubled[2] == 60


func test_fold_int_still_works() -> Bool:
	v: Int[#3] = {1, 2, 3}
	total: Int = v.fold(0, func(acc: Int, x: Int) -> Int: acc + x)
	total == 6


tests: TestSuite = {
	description = "Float Vector HOFs",
	tests = [
		("map float double", test_map_float_double),
		("fold float sum", test_fold_float_sum),
		("map int regression", test_map_int_still_works),
		("fold int regression", test_fold_int_still_works),
	]
}
