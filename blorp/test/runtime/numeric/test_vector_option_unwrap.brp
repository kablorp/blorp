import:
	list: get
	test: TestSuite


-- Test #9: Option-unwrapped vectors can be subscripted
func test_unwrap_vector_from_option() -> Bool:
	v: Int[#3] = {10, 20, 30}
	opt: Option[Int[#3]] = Some(v)
	match opt:
		Some(extracted): extracted[0] == 10 and extracted[1] == 20 and extracted[2] == 30
		None: False


func test_unwrap_vector_from_list() -> Bool:
	v1: Int[#3] = {10, 20, 30}
	vecs: List[Int[#3]] = [v1]
	match get(vecs, 0):
		Some(v): v[0] == 10 and v[2] == 30
		None: False


func test_unwrap_float_vector() -> Bool:
	v: Float[#2] = {3.5, 7.5}
	opt: Option[Float[#2]] = Some(v)
	match opt:
		Some(extracted):
			x: Float = extracted[0]
			x == 3.5
		None: False


func test_list_get_second_vec() -> Bool:
	v1: Int[#2] = {10, 20}
	v2: Int[#2] = {30, 40}
	vecs: List[Int[#2]] = [v1, v2]
	match get(vecs, 1):
		Some(vec): vec[0] == 30 and vec[1] == 40
		None: False


tests: TestSuite = {
	description = "Option-unwrapped vector",
	tests = [
		("unwrap vector from option", test_unwrap_vector_from_option),
		("unwrap vector from list", test_unwrap_vector_from_list),
		("unwrap float vector", test_unwrap_float_vector),
		("list get second vec", test_list_get_second_vec),
	]
}
