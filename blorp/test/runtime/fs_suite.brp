import:
    io/process: OutputError, command, output
    list: List methods
    result: Result methods
    string: String methods
    test: TestSuite
    ../../src/common/codegen/runtime/fs:
        FS_HELPERS_RUNTIME,
        FS_READ_TEXT_RUNTIME,
        FS_WRITE_TEXT_RUNTIME,
        FS_ENTRY_KIND_RUNTIME,
        FS_CREATE_DIRECTORY_RUNTIME,
        FS_CREATE_DIRECTORIES_RUNTIME,
        FS_REMOVE_FILE_RUNTIME,
        FS_REMOVE_DIRECTORY_RUNTIME,
        FS_RENAME_RUNTIME,
        fs_list_directory_runtime,
        FS_REMOVE_DIRECTORY_TREE_RUNTIME,
        FS_CREATE_TEMPORARY_DIRECTORY_RUNTIME,
        FS_OPEN_READ_RUNTIME,
        fs_next_lines_runtime,
        FS_CLOSE_RUNTIME,
    ../../src/common/codegen/runtime/list:
        list_runtime,
        list_element_key,
        list_c_type,
        LIST_SHARED_RUNTIME,
    ../../src/common/codegen/runtime/memory: MEMORY_RUNTIME
    ../../src/common/codegen/runtime/process: PROCESS_POSIX_PRELUDE
    ../../src/common/codegen/runtime/string: string_runtime
    ../../src/common/codegen/runtime/system: SYSTEM_CURRENT_DIRECTORY_RUNTIME
    ../../src/common/codegen/specialize/specialize: TypeRef(StringType)
    ../e2e/file_access: path_of, write_file
    ../e2e/self_hosted_harness: isolated, run_expecting, strict_leak_check
    ../e2e/self_hosted_reports: verify_accounting


private IDENTITY_TOOL: String = "/usr/bin/id"
private COMPILE_TIMEOUT_MS: Int = 600000
private CASE_TIMEOUT_MS: Int = 30000


-- Builds blorp/test/runtime/fixtures/<name>_test.c, which includes the
-- fragments as <name>_runtime.c and calls their C functions directly. Each
-- probe gets the fragments in the order a program calling its operations
-- emits them: `aggregates` are the layouts those operations use.
private func ready(
    c_compiler: String,
    directory: String,
    name: String,
    aggregates: String,
    operations: String,
) -> Result[String, String]:
    fragments = (
        PROCESS_POSIX_PRELUDE
        + MEMORY_RUNTIME
        + string_runtime()
        + "\n"
        + aggregates
        + FS_HELPERS_RUNTIME
        + operations
    )
    _ ?= write_file(directory + "/" + name + "_runtime.c", fragments)
    executable = directory + "/" + name + "_test"
    build ?= isolated(
        c_compiler,
        [
            "-std=c11",
            "-O0",
            "-Wall",
            "-Wextra",
            "-Werror",
            "-pedantic",
            "-fsanitize=address,undefined",
            "-fno-sanitize-recover=all",
            "-DBLORP_MEMORY_DIAGNOSTICS=1",
            "-I",
            directory,
            "blorp/test/runtime/fixtures/" + name + "_test.c",
            "-o",
            executable,
            "-lm",
            "-lpthread",
        ],
        COMPILE_TIMEOUT_MS,
    )
    built ?= run_expecting(name + " native build", build, 0)
    if built.stderr == "":
        Ok(executable)
    else:
        Err(name + " native build: " + built.stderr)


-- A case passes with exit 0, nothing on stdout, and one balanced strict
-- allocation report on stderr.
private func native_case(
    executable: String,
    directory: String,
    name: String,
) -> Result[Void, String]:
    case ?= isolated(executable, [name, directory], CASE_TIMEOUT_MS)
    ran ?= run_expecting(name, { case | environment = strict_leak_check() }, 0)
    if ran.stdout != "":
        Err(name + ": wrote stdout: " + ran.stdout)
    else:
        verify_accounting(ran.stderr, True).map_err(
            pure func(message: String): name + ": " + message + ": " + ran.stderr,
        )


-- Root may write a read-only file and create one in a read-only directory, so
-- the permission case cannot provoke PermissionDenied there.
private func running_as_root() -> Result[Bool, String]:
    identity ?= path_of(IDENTITY_TOOL)
    user ?= output({ command(identity, ["-u"]) | timeout_ms = Some(CASE_TIMEOUT_MS) }).map_err(
        pure func(error: OutputError) -> String: "${IDENTITY_TOOL} -u: ${error}",
    )
    Ok(user == "0\n")


private func reported(result: Result[Void, String]) -> Bool:
    match result:
        Ok(_):
            True
        Err(error):
            print_error(error)
            False


private func read_tests(executable: String, directory: String) -> List[(String, () -> Bool)]:
    [
        (
            "each errno maps to its literal code and no named errno becomes OtherOs",
            func(): reported(native_case(executable, directory, "codes")),
        ),
        (
            "the read buffer's growth stops at the largest String without overflow",
            func(): reported(native_case(executable, directory, "growth")),
        ),
        (
            "a NUL in the path is refused before any open",
            func(): reported(native_case(executable, directory, "nul")),
        ),
        (
            "every file size around the buffer boundaries reads whole and closes once",
            func(): reported(native_case(executable, directory, "sizes")),
        ),
        (
            "a missing path, a directory and invalid UTF-8 each report their code and close at most once",
            func(): reported(native_case(executable, directory, "failures")),
        ),
        (
            "a failed read reports its errno and frees its buffer",
            func(): reported(native_case(executable, directory, "read_error")),
        ),
        (
            "entry kinds never follow a link, and absent paths are not failures",
            func(): reported(native_case(executable, directory, "entry_kinds")),
        ),
        (
            "an interrupted open of a FIFO is retried after it returned EINTR",
            func(): reported(native_case(executable, directory, "interrupted_open")),
        ),
        (
            "interrupted reads are retried while a writer appends to a FIFO",
            func(): reported(native_case(executable, directory, "appending_writer")),
        ),
    ]


private func write_tests(executable: String, directory: String) -> List[(String, () -> Bool)]:
    [
        (
            "replacing a file copies its owner, then its mode, then writes, flushes, closes, renames and flushes the directory",
            func(): reported(native_case(executable, directory, "order_replace")),
        ),
        (
            "a new file skips the owner and mode and takes 0666 narrowed by the umask",
            func(): reported(native_case(executable, directory, "order_new")),
        ),
        (
            "empty text replaces a file with an empty one",
            func(): reported(native_case(executable, directory, "empty_text")),
        ),
        (
            "a short write is continued until every byte is written",
            func(): reported(native_case(executable, directory, "short_write")),
        ),
        (
            "EINTR from the write, the flush and the rename is each retried once",
            func(): reported(native_case(executable, directory, "interrupted")),
        ),
        (
            "a failed flush is called once, removes the new file and leaves the target unchanged",
            func(): reported(native_case(executable, directory, "flush_failure")),
        ),
        (
            "a file system without the barrier gets exactly one fsync",
            func(): reported(native_case(executable, directory, "barrier_unsupported")),
        ),
        (
            "a failed close of the new file fails the write and removes the file",
            func(): reported(native_case(executable, directory, "close_failure")),
        ),
        (
            "a failed rename removes the new file and leaves the target unchanged",
            func(): reported(native_case(executable, directory, "rename_failure")),
        ),
        (
            "the directory flush accepts EINVAL and ENOTSUP and reports EIO after the rename",
            func(): reported(native_case(executable, directory, "directory_flush")),
        ),
        (
            "taken temporary names give OtherOs(EEXIST) after the named number of attempts",
            func(): reported(native_case(executable, directory, "temporary_names_exhausted")),
        ),
        (
            "EPERM from fchown copies the group alone, EPERM from that is ignored, and any other failure fails the write",
            func(): reported(native_case(executable, directory, "owner")),
        ),
        (
            "a write past the file-size limit is FileTooLarge and leaves the target unchanged",
            func(): reported(native_case(executable, directory, "file_too_large")),
        ),
        (
            "an empty path and a NUL are refused before any system call",
            func(): reported(native_case(executable, directory, "path_kinds")),
        ),
        (
            "a path ending in a slash is answered by one stat and its mode, and writes nothing",
            func(): reported(native_case(executable, directory, "slashed_paths")),
        ),
        (
            "a directory, a FIFO, a device, a file used as a directory and a missing parent are refused without an open",
            func(): reported(native_case(executable, directory, "entry_kinds")),
        ),
        (
            "a link is written through in its target's directory and stays a link; dangling links and loops fail",
            func(): reported(native_case(executable, directory, "symlinks")),
        ),
        (
            "a failed fstat of the opened target closes it once and creates nothing",
            func(): reported(native_case(executable, directory, "probe_failure")),
        ),
    ]


-- Left out as root, like the fs example, so that it earns no PASS credit.
private func permission_tests(
    root: Result[Bool, String],
    executable: String,
    directory: String,
) -> List[(String, () -> Bool)]:
    match root:
        Err(error):
            [("the user running the fs write probe is known", func(): reported(Err(error)))]
        Ok(True):
            print_error("fs write permission case not run: root can write a read-only file")
            []
        Ok(False):
            [
                (
                    "a read-only file, a file in a read-only directory and a path through a directory it may not search are PermissionDenied",
                    func(): reported(native_case(executable, directory, "permission_kinds")),
                ),
            ]


private func directory_tests(executable: String, directory: String) -> List[(String, () -> Bool)]:
    [
        (
            "an empty directory lists nothing through one descriptor that closedir closes once",
            func(): reported(native_case(executable, directory, "list_empty")),
        ),
        (
            "errno left set by a readdir that returned an entry does not end the listing as a failure",
            func(): reported(native_case(executable, directory, "list_errno_left_set")),
        ),
        (
            "more entries than the initial capacity all list, in order",
            func(): reported(native_case(executable, directory, "list_many")),
        ),
        (
            "names sort by their bytes, a prefix before what extends it",
            func(): reported(native_case(executable, directory, "list_order")),
        ),
        (
            "files, directories and FIFOs list as their kinds, and every link as Symlink",
            func(): reported(native_case(executable, directory, "list_kinds")),
        ),
        (
            "a link to a directory and a path ending in a slash list the directory",
            func(): reported(native_case(executable, directory, "list_paths")),
        ),
        (
            "a missing path, a file, a file with a slash, a loop, an empty path and a NUL fail with their codes",
            func(): reported(native_case(executable, directory, "list_failures")),
        ),
        (
            "an unknown d_type is examined with fstatat on the open directory without following links",
            func(): reported(native_case(executable, directory, "list_unknown_types")),
        ),
        (
            "an entry gone before fstatat is left out, and another fstatat failure fails the listing",
            func(): reported(native_case(executable, directory, "list_vanished")),
        ),
        (
            "a readdir failure part way fails the listing and frees the names",
            func(): reported(native_case(executable, directory, "list_read_failure")),
        ),
        (
            "one name that is not UTF-8 fails the whole listing",
            func(): reported(native_case(executable, directory, "list_invalid_utf8")),
        ),
        (
            "a failed fdopendir closes the descriptor once and never calls closedir",
            func(): reported(native_case(executable, directory, "list_fdopendir_failure")),
        ),
        (
            "EINTR from open, readdir, fstatat, mkdir, rename, rmdir and unlink is each retried once",
            func(): reported(native_case(executable, directory, "interrupted")),
        ),
        (
            "create_directory makes one directory, and an existing path of any kind is AlreadyExists",
            func(): reported(native_case(executable, directory, "create_kinds")),
        ),
        (
            "create_directories makes each missing component and passes existing directories and links to them",
            func(): reported(native_case(executable, directory, "create_all")),
        ),
        (
            "create_directories: a file within is NotADirectory, a file or dangling link last is AlreadyExists",
            func(): reported(native_case(executable, directory, "create_all_conflicts")),
        ),
        (
            "create_directories succeeds when another process makes a component first",
            func(): reported(native_case(executable, directory, "create_all_race")),
        ),
        (
            "remove_file removes files and links, and a directory refused with EPERM or EISDIR is IsADirectory",
            func(): reported(native_case(executable, directory, "remove_file_kinds")),
        ),
        (
            "remove_directory removes an empty directory, and EEXIST or ENOTEMPTY is DirectoryNotEmpty",
            func(): reported(native_case(executable, directory, "remove_directory_kinds")),
        ),
        (
            "rename replaces a file or an empty directory and returns each kind it can",
            func(): reported(native_case(executable, directory, "rename_kinds")),
        ),
    ]


-- Left out as root, like the write probe's permission case.
private func directory_permission_tests(
    root: Result[Bool, String],
    executable: String,
    directory: String,
) -> List[(String, () -> Bool)]:
    match root:
        Err(error):
            [("the user running the fs directory probe is known", func(): reported(Err(error)))]
        Ok(True):
            print_error(
                "fs directory permission case not run: root may list, create and remove anywhere",
            )
            []
        Ok(False):
            [
                (
                    "each operation refused by permissions is PermissionDenied, and a real directory given to remove_file is IsADirectory",
                    func(): reported(native_case(executable, directory, "permission_kinds")),
                ),
            ]


-- Each case scripts getcwd and checks the one code the native returns.
private func current_directory_tests(
    executable: String,
    directory: String,
) -> List[(String, () -> Bool)]:
    [
        ("ENOENT is NotFound", "not_found"),
        ("EACCES is PermissionDenied", "permission_denied"),
        ("another errno is sent negated", "other_errno"),
        ("EINTR is not retried and is sent negated", "interrupted_is_not_retried"),
        ("a short path succeeds", "short_path"),
        ("ERANGE grows the buffer until the path fits", "grows_past_initial"),
        ("a relative path is Unreachable", "relative"),
        ("an empty path is Unreachable", "empty"),
        ("a path that is not UTF-8 is InvalidUtf8", "invalid_utf8"),
        ("ERANGE at the capacity limit is OtherOs(EOVERFLOW)", "capacity_limit"),
    ].map(
        pure func(item): (
            "current_directory: " + item[0],
            func(): reported(native_case(executable, directory, item[1])),
        ),
    )


private func tree_tests(executable: String, directory: String) -> List[(String, () -> Bool)]:
    [
        (
            "remove_directory_tree: a missing path, the empty path and a NUL fail with their codes",
            func(): reported(native_case(executable, directory, "tree_missing")),
        ),
        (
            "remove_directory_tree: a file and a link to anything are NotADirectory and nothing is removed",
            func(): reported(native_case(executable, directory, "tree_not_directories")),
        ),
        (
            "remove_directory_tree: trailing slashes are stripped, so link/ is the link and a/./ names .",
            func(): reported(native_case(executable, directory, "tree_trailing_slashes")),
        ),
        (
            "remove_directory_tree: a final . or .. is refused before any system call",
            func(): reported(native_case(executable, directory, "tree_dot_refusals")),
        ),
        (
            "remove_directory_tree: / and // are CrossesDevices and nothing is read or removed",
            func(): reported(native_case(executable, directory, "tree_slash_root")),
        ),
        (
            "remove_directory_tree: a root whose .. is on another device is CrossesDevices and nothing is removed",
            func(): reported(native_case(executable, directory, "tree_root_mount_point")),
        ),
        (
            "remove_directory_tree removes an empty directory and a tree of files, links, FIFOs and directories",
            func(): reported(native_case(executable, directory, "tree_removed")),
        ),
        (
            "remove_directory_tree removes an empty child that can be read but not searched without entering it",
            func(): reported(native_case(executable, directory, "tree_unsearchable_child")),
        ),
        (
            "remove_directory_tree removes a link out of the tree and keeps its target's contents",
            func(): reported(native_case(executable, directory, "tree_link_out")),
        ),
        (
            "remove_directory_tree removes a chain deeper than 300 levels and longer than PATH_MAX under 32 descriptors, holding at most 3",
            func(): reported(native_case(executable, directory, "tree_deep_chain")),
        ),
        (
            "remove_directory_tree reads each directory's names before removing any of them",
            func(): reported(native_case(executable, directory, "tree_read_order")),
        ),
        (
            "remove_directory_tree enters a directory that unlinkat refuses with EPERM, as on macOS",
            func(): reported(native_case(executable, directory, "tree_directory_eperm")),
        ),
        (
            "remove_directory_tree: EBUSY leads to the device check, which stops at a mount point",
            func(): reported(native_case(executable, directory, "tree_mount_point_ebusy")),
        ),
        (
            "remove_directory_tree: EPERM for a file keeps its own failure, PermissionDenied",
            func(): reported(native_case(executable, directory, "tree_file_eperm")),
        ),
        (
            "remove_directory_tree: an entry removed by another process first is no failure",
            func(): reported(native_case(executable, directory, "tree_vanished_entry")),
        ),
        (
            "remove_directory_tree: a child on another device is CrossesDevices and nothing under it is removed",
            func(): reported(native_case(executable, directory, "tree_child_device")),
        ),
        (
            "remove_directory_tree: a directory moved during the walk is ChangedDuringRemoval and the walk stops",
            func(): reported(native_case(executable, directory, "tree_moved_directory")),
        ),
        (
            "remove_directory_tree: an entry the walk never saw makes the rmdir DirectoryNotEmpty",
            func(): reported(native_case(executable, directory, "tree_hidden_entry")),
        ),
        (
            "remove_directory_tree: failed readdir, fdopendir, fcntl and fstat report their codes and release everything",
            func(): reported(native_case(executable, directory, "tree_read_failures")),
        ),
        (
            "remove_directory_tree retries EINTR from open, openat, unlinkat, fstat, readdir and fcntl",
            func(): reported(native_case(executable, directory, "tree_interrupted")),
        ),
        (
            "remove_directory_tree removes a name that is not UTF-8 by its bytes",
            func(): reported(native_case(executable, directory, "tree_invalid_utf8_name")),
        ),
        (
            "create_temporary_directory makes distinct 0700 directories directly in the parent, relative or absolute",
            func(): reported(native_case(executable, directory, "temporary_created")),
        ),
        (
            "create_temporary_directory adds no second slash after a parent ending in one",
            func(): reported(native_case(executable, directory, "temporary_trailing_slash")),
        ),
        (
            "create_temporary_directory retries mkdtemp after EINTR",
            func(): reported(native_case(executable, directory, "temporary_interrupted")),
        ),
        (
            "create_temporary_directory refuses a prefix holding a slash before any system call",
            func(): reported(native_case(executable, directory, "temporary_prefix_slash")),
        ),
        (
            "create_temporary_directory: a missing, file or empty parent, a NUL and EEXIST fail with their codes",
            func(): reported(native_case(executable, directory, "temporary_failures")),
        ),
    ]


-- Left out as root, like the other probes' permission cases.
private func tree_permission_tests(
    root: Result[Bool, String],
    executable: String,
    directory: String,
) -> List[(String, () -> Bool)]:
    match root:
        Err(error):
            [("the user running the fs tree probe is known", func(): reported(Err(error)))]
        Ok(True):
            print_error("fs tree permission cases not run: root may remove and create anywhere")
            []
        Ok(False):
            [
                (
                    "remove_directory_tree in a parent without write permission is PermissionDenied, with each platform's shape",
                    func(): reported(native_case(executable, directory, "tree_permission")),
                ),
                (
                    "remove_directory_tree removes an empty child that cannot be opened, and one that is not empty is PermissionDenied",
                    func(): reported(native_case(executable, directory, "tree_unopenable_child")),
                ),
                (
                    "create_temporary_directory in a parent without write permission is PermissionDenied",
                    func(): reported(native_case(executable, directory, "temporary_permission")),
                ),
            ]


private func line_tests(executable: String, directory: String) -> List[(String, () -> Bool)]:
    [
        (
            "next_lines returns [], [final] or lines then the unfinished line, and removes one CR before each LF, carried or read",
            func(): reported(native_case(executable, directory, "batches")),
        ),
        (
            "an invalid byte after the last LF fails the batch without a completion read",
            func(): reported(native_case(executable, directory, "invalid_tail")),
        ),
        (
            "a file of short lines larger than three blocks takes one block-sized read per call and delivers every byte",
            func(): reported(native_case(executable, directory, "blocks")),
        ),
        (
            "an LF as a block's last or the next block's first byte, and a CR as a block's last byte, split lines correctly",
            func(): reported(native_case(executable, directory, "block_edges")),
        ),
        (
            "one 3 MiB line comes back whole within the block count plus two reads",
            func(): reported(native_case(executable, directory, "long_line")),
        ),
        (
            "a character split by a read is finished by reads of exactly its missing bytes, and end of file or a non-continuation byte first is InvalidUtf8",
            func(): reported(native_case(executable, directory, "split_characters")),
        ),
        (
            "an invalid line among valid ones and a final line ending in a lead byte are InvalidUtf8 and leave the descriptor open",
            func(): reported(native_case(executable, directory, "invalid_lines")),
        ),
        (
            "EINTR from open, fstat and read is each retried once",
            func(): reported(native_case(executable, directory, "interrupted")),
        ),
        (
            "EINTR from close is returned and never retried",
            func(): reported(native_case(executable, directory, "close_interrupted")),
        ),
        (
            "EIO partway through a line publishes nothing, frees the buffer and leaves the descriptor open",
            func(): reported(native_case(executable, directory, "read_error")),
        ),
        (
            "open_read refuses a directory and closes it once; a missing path, a file used as a directory and a NUL fail with their codes",
            func(): reported(native_case(executable, directory, "open_failures")),
        ),
        (
            "a descriptor that is negative or outside int's range is EBADF with no system call",
            func(): reported(native_case(executable, directory, "descriptor_range")),
        ),
        (
            "a FIFO that delivers part of a line returns the whole line once the LF arrives, with no read after it",
            func(): reported(native_case(executable, directory, "fifo")),
        ),
    ]


-- Left out as root, like the other probes' permission cases.
private func line_permission_tests(
    root: Result[Bool, String],
    executable: String,
    directory: String,
) -> List[(String, () -> Bool)]:
    match root:
        Err(error):
            [("the user running the fs lines probe is known", func(): reported(Err(error)))]
        Ok(True):
            print_error("fs lines permission case not run: root may read any file")
            []
        Ok(False):
            [
                (
                    "open_read of a file this process may not read is PermissionDenied",
                    func(): reported(native_case(executable, directory, "permission")),
                ),
            ]


-- The listing and the line reader build the List[String] layout, so their
-- probes get that layout as a program that calls them does.
private pure func string_list_layout() -> String:
    key = list_element_key(StringType)
    (
        LIST_SHARED_RUNTIME
        + list_runtime(
            key,
            "struct blorp_string*",
            "blorp_string_retain(element);",
            "blorp_string_release(element);",
        )
    )


private pure func line_operations() -> String:
    (
        FS_OPEN_READ_RUNTIME
        + fs_next_lines_runtime(list_c_type(list_element_key(StringType)))
        + FS_CLOSE_RUNTIME
    )


private pure func directory_operations() -> String:
    listing = fs_list_directory_runtime(list_c_type(list_element_key(StringType)))
    (
        listing
        + FS_CREATE_DIRECTORY_RUNTIME
        + FS_CREATE_DIRECTORIES_RUNTIME
        + FS_REMOVE_FILE_RUNTIME
        + FS_REMOVE_DIRECTORY_RUNTIME
        + FS_RENAME_RUNTIME
    )


func suite(c_compiler: String, directory: String) -> TestSuite:
    -- A probe that does not build is one failing test, and the other probe's
    -- cases still run. The user is asked once.
    root = running_as_root()
    read: List[(String, () -> Bool)] = match ready(
        c_compiler,
        directory,
        "fs",
        "",
        FS_READ_TEXT_RUNTIME + FS_ENTRY_KIND_RUNTIME,
    ):
        Err(error): [("the fs read probe builds", func(): reported(Err(error)))]
        Ok(executable): read_tests(executable, directory)
    write: List[(String, () -> Bool)] = match ready(
        c_compiler,
        directory,
        "fs_write",
        "",
        FS_WRITE_TEXT_RUNTIME,
    ):
        Err(error):
            [("the fs write probe builds", func(): reported(Err(error)))]
        Ok(executable):
            write_tests(executable, directory).concat(permission_tests(root, executable, directory))
    directories: List[(String, () -> Bool)] = match ready(
        c_compiler,
        directory,
        "fs_directory",
        string_list_layout(),
        directory_operations(),
    ):
        Err(error):
            [("the fs directory probe builds", func(): reported(Err(error)))]
        Ok(executable):
            directory_tests(executable, directory).concat(
                directory_permission_tests(root, executable, directory),
            )
    tree: List[(String, () -> Bool)] = match ready(
        c_compiler,
        directory,
        "fs_tree",
        "",
        FS_REMOVE_DIRECTORY_TREE_RUNTIME + FS_CREATE_TEMPORARY_DIRECTORY_RUNTIME,
    ):
        Err(error):
            [("the fs tree probe builds", func(): reported(Err(error)))]
        Ok(executable):
            tree_tests(executable, directory).concat(
                tree_permission_tests(root, executable, directory),
            )
    lines: List[(String, () -> Bool)] = match ready(
        c_compiler,
        directory,
        "fs_lines",
        string_list_layout(),
        line_operations(),
    ):
        Err(error):
            [("the fs lines probe builds", func(): reported(Err(error)))]
        Ok(executable):
            line_tests(executable, directory).concat(
                line_permission_tests(root, executable, directory),
            )
    current: List[(String, () -> Bool)] = match ready(
        c_compiler,
        directory,
        "fs_current_directory",
        "",
        SYSTEM_CURRENT_DIRECTORY_RUNTIME,
    ):
        Err(error): [("the current directory probe builds", func(): reported(Err(error)))]
        Ok(executable): current_directory_tests(executable, directory)
    {
        description = "fs runtime",
        tests = read
            .concat(write)
            .concat(directories)
            .concat(tree)
            .concat(lines)
            .concat(current),
    }
