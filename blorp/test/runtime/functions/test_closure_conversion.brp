-- Regression test: closure conversion
-- Ensures lambdas with captures, static closures, nested lambdas,
-- and function references all work after closure conversion.
import:
	option: Option(Some, None)
	test: TestSuite


func test_simple_lambda() -> Bool:
	f: pure (Int) -> Int = func(x: Int): x + 1
	f(5) == 6


func test_lambda_with_capture() -> Bool:
	offset: Int = 10
	f: pure (Int) -> Int = func(x: Int): x + offset
	f(5) == 15


func test_lambda_multi_capture() -> Bool:
	a: Int = 3
	b: Int = 7
	f: pure (Int) -> Int = func(x: Int): x + a + b
	f(0) == 10


func test_nested_lambda() -> Bool:
	adder: pure (Int) -> pure (Int) -> Int = func(a: Int):
		func(b: Int): a + b
	add5: pure (Int) -> Int = adder(5)
	add5(3) == 8


func test_lambda_in_list() -> Bool:
	fns: List[pure (Int) -> Int] = [func(x: Int): x * 2, func(x: Int): x * 3]
	match fns.get(0):
		Some(f): f(5) == 10
		None: False


func test_map_with_lambda() -> Bool:
	xs: List[Int] = [1, 2, 3]
	doubled: List[Int] = xs.map(func(x: Int): x * 2)
	match doubled.get(0):
		Some(v): v == 2
		None: False


func test_closure_over_string() -> Bool:
	greeting: String = "hello"
	f: pure () -> String = func(): greeting
	f() == "hello"


func test_lambda_returning_option() -> Bool:
	f: pure (Int) -> Option[Int] = func(x: Int):
		if x > 0:
			Some(x)
		else:
			None
	match f(5):
		Some(v): v == 5
		None: False


tests: TestSuite = {
	description = "Closure conversion regression",
	tests = [
		("simple lambda", test_simple_lambda),
		("lambda with capture", test_lambda_with_capture),
		("lambda multi capture", test_lambda_multi_capture),
		("nested lambda", test_nested_lambda),
		("lambda in list", test_lambda_in_list),
		("map with lambda", test_map_with_lambda),
		("closure over string", test_closure_over_string),
		("lambda returning option", test_lambda_returning_option),
	]
}
