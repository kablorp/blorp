import:
	float: sqrt
	test: TestSuite


pure func roots(nums: List[Float]) -> List[Float]:
	nums.parallel(pure func(items):
		items.map(sqrt)
	)


func test_parallel_map_imported_builtin_function_ref() -> Bool:
	values: List[Float] = roots([4.0, 9.0, 16.0])
	first_ok: Bool = values.get_or(0, 0.0) == 2.0
	second_ok: Bool = values.get_or(1, 0.0) == 3.0
	third_ok: Bool = values.get_or(2, 0.0) == 4.0
	values.length() == 3 and first_ok and second_ok and third_ok


tests: TestSuite = {
	description = "imported builtin function references",
	tests = [
		(
			"parallel map imported builtin function ref",
			test_parallel_map_imported_builtin_function_ref,
		),
	]
}
