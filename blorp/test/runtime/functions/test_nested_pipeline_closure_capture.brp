-- Regression: a collection pipeline fused inside an outer lambda introduces a
-- source binder (only in scope inside the fused handoff). A closure nested in
-- that pipeline must not capture the binder from the enclosing scope, or the
-- C compile fails with an undeclared `brp_v_*` identifier.
import:
	test: TestSuite


func test_nested_map_inside_map_lambda() -> Bool:
	rows: List[List[Int]] = [[1, 2, 3], [4, 5, 6]]
	counts: List[Int] = rows.map(func(row: List[Int]) -> Int: row.map(func(x: Int) -> Int: x * 2).length())
	counts == [3, 3]


func test_nested_map_captures_outer_local() -> Bool:
	rows: List[List[Int]] = [[1, 2, 3], [4, 5, 6]]
	scale: Int = 10
	sums: List[Int] = rows.map(func(row: List[Int]) -> Int: row.map(func(x: Int) -> Int: x * scale).sum())
	sums == [60, 150]


func test_nested_filter_inside_map_lambda() -> Bool:
	rows: List[List[Int]] = [[1, 2, 3], [4, 5, 6]]
	limit: Int = 2
	kept: List[Int] = rows.map(func(row: List[Int]) -> Int: row.filter(func(x: Int) -> Bool: x > limit).sum())
	kept == [3, 15]


tests: TestSuite = {
	description = "Nested collection pipelines inside lambdas",
	tests = [
		("map inside map lambda", test_nested_map_inside_map_lambda),
		("inner closure captures outer local", test_nested_map_captures_outer_local),
		("filter inside map lambda", test_nested_filter_inside_map_lambda),
	]
}
