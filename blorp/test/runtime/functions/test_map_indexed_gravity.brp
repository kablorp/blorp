import:
	float: sqrt
	tensor: get, set_index
	test: TestSuite
	vector: ParallelVector, parallel


pure func vget_f(v: Float[#100], i: Int) -> Float:
	match get(v, i):
		Some(val): val
		None: 0.0


-- Simulates the octree_gravity pattern: captures vectors, does math, returns tuple
func test_captured_vectors_tuple() -> Bool:
	var px = vector(0.0, 100)
	var py = vector(0.0, 100)
	var alive = vector(0.0, 100)

	-- Set some particles alive with positions
	for i in 0..100:
		match px.set_index(i, to_float(i) * 1.5):
			Some(v): px = v
			None: void
		match py.set_index(i, to_float(i) * 0.5):
			Some(v): py = v
			None: void
		match alive.set_index(i, 1.0):
			Some(v): alive = v
			None: void

	-- Snapshot for capture
	snap_px: Float[#100] = px
	snap_py: Float[#100] = py
	compute: pure (Int, Float) -> (Float, Float, Float) = pure func(i: Int, a_val: Float):
		if a_val > 0.5:
			x: Float = vget_f(snap_px, i)
			y: Float = vget_f(snap_py, i)
			dist: Float = sqrt(x * x + y * y) + 0.001
			(x / dist, y / dist, dist)
		else:
			(0.0, 0.0, 0.0)
	result: (Float, Float, Float)[#100] = alive.parallel(pure func(
		chunk: ParallelVector[Float, #100],
	):
		chunk.map_indexed(pure func(i: ..#100, value: Float): compute(i, value))
	)

	-- Check a few results
	match get(result, 10):
		Some(g):
			g[2] > 0.0
		None: False


-- Test that the apply loop works (mirrors the velocity update pattern)
func test_apply_gravity_results() -> Bool:
	var vx = vector(0.0, 100)
	alive = vector(0.0, 100)
	result: (Float, Float, Float)[#100] = alive.parallel(pure func(
		chunk: ParallelVector[Float, #100],
	):
		chunk.map_indexed(pure func(i: ..#100, a_val: Float): (to_float(i) * 0.1, 0.0, 0.0))
	)
	for i in 0..length(result):
		match get(result, i):
			Some(g):
				match vx.set_index(i, vget_f(vx, i) + g[0]):
					Some(v): vx = v
					None: void
			None: void
	match get(vx, 5):
		Some(val): val > 0.49 and val < 0.51
		None: False


-- Test with large vector (similar to N=2000)
func test_large_vector() -> Bool:
	alive = vector(0.0, 2000)
	result: (Float, Float, Float)[#2000] = alive.parallel(pure func(
		chunk: ParallelVector[Float, #2000],
	):
		chunk.map_indexed(pure func(i: ..#2000, a_val: Float): (to_float(i), 0.0, 0.0))
	)
	match get(result, 1999):
		Some(g):
			g[0] > 1998.9 and g[0] < 1999.1
		None: False


tests: TestSuite = {
	description = "Scoped parallel vector gravity pattern",
	tests = [
		("captured vectors tuple", test_captured_vectors_tuple),
		("apply gravity results", test_apply_gravity_results),
		("large vector", test_large_vector),
	]
}
