-- Test generic Option functions (map, and_then)
import:
	option: Option(Some, None), and_then, get_or, is_none, map
	test: TestSuite


tests: TestSuite = {
	description = "Generic Option Functions",
	tests = [
		("Option.map with Some value", func():
			opt: Option[Int] = Some(5)
			result: Option[Int] = opt.map(func(x: Int): x * 2)
			result.get_or(0) == 10
		),
		("Option.map with None value", func():
			opt: Option[Int] = None
			result: Option[Int] = opt.map(func(x: Int): x * 2)
			is_none(result)
		),
		("Option.map chaining", func():
			opt: Option[Int] = Some(3)
			result: Option[Int] = map(opt.map(func(x: Int): x * 2), func(x: Int): x + 10)
			result.get_or(0) == 16
		),
		("Option.and_then Some->Some", func():
			opt: Option[Int] = Some(5)
			result: Option[Int] = and_then(opt, func(x: Int):
				match x > 0:
					True: Some(x)
					False: None
			)
			result.get_or(0) == 5
		),
		("Option.and_then Some->None", func():
			opt: Option[Int] = Some(5)
			result: Option[Int] = and_then(opt, func(x: Int): None)
			is_none(result)
		),
		("Option.and_then None input", func():
			opt: Option[Int] = None
			result: Option[Int] = and_then(opt, func(x: Int):
				match x > 0:
					True: Some(x)
					False: None
			)
			is_none(result)
		)
	]
}
