-- Test that lambdas in list literals can call generic functions (monomorphization)
import:
	option: Option(Some, None), get_or, is_none, is_some, map
	test: TestSuite


tests: TestSuite = {
	description = "Lambda monomorphization",
	tests = [
		("get_or with Some", func():
			opt: Option[Int] = Some(42)
			opt.get_or(0) == 42
		),
		("get_or with None", func():
			opt: Option[Int] = None
			opt.get_or(99) == 99
		),
		("is_none with None", func():
			opt: Option[Int] = None
			is_none(opt)
		),
		("is_some with Some", func():
			opt: Option[Int] = Some(1)
			is_some(opt)
		),
		("map then unwrap", func():
			opt: Option[Int] = Some(5)
			result: Option[Int] = opt.map(func(x: Int): x * 2)
			result.get_or(0) == 10
		)
	]
}
