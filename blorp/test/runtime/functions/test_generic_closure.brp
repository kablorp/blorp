import:
	test: TestSuite


-- Test generic functions with closure parameters
-- Simple generic container
union Container[T]:
	Value(T)
	Empty


-- Generic map function (like Parser.map)
pure func container_map[A, B](
	c: Container[A],
	f: pure (A) -> B,
) -> Container[B]:
	match c:
		Value(v): Value(f(v))
		Empty: Empty


-- Test using the generic map
func test_map_int_to_string() -> Bool:
	c: Container[Int] = Value(42)
	result: Container[String] = container_map(c, pure func(x: Int): x.to_string())
	match result:
		Value(s): s == "42"
		Empty: False


-- Test with method-style call
func test_method_style() -> Bool:
	c: Container[Int] = Value(10)
	result: Container[Int] = c.container_map(pure func(x: Int): x * 2)
	match result:
		Value(n): n == 20
		Empty: False


tests: TestSuite = {
	description = "Generic Closure Tests",
	tests = [("map int to string", test_map_int_to_string), ("method style map", test_method_style)]
}
