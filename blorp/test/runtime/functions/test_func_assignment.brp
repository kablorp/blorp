import:
	test: TestSuite


-- Test function assignment
func my_test() -> Bool:
	True


tests: TestSuite = {
	description = "Function Assignment",
	tests = [
		("function can be assigned to variable", func():
			func_var: () -> Bool = my_test
			result: Bool = func_var()
			result == True
		),
		("assigned function returns correct value", func(): my_test()),
		("function variable can be called", func():
			func_var: () -> Bool = my_test
			func_var()
		)
	]
}
