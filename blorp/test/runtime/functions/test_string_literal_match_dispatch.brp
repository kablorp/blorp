import:
	test: TestSuite


pure func classify_string(value: String) -> Int:
	match value:
		"":
			101
		"a":
			102
		"if":
			103
		"in":
			104
		"func":
			105
		"pure":
			106
		"record":
			107
		"a\0b":
			108
		_:
			999


pure func observe_void_string_match(value: String) -> Int:
	var result: Int = 0

	match value:
		"":
			result = 101
		"a":
			result = 102
		"if":
			result = 103
		"in":
			result = 104
		"func":
			result = 105
		"pure":
			result = 106
		"record":
			result = 107
		"a\0b":
			result = 108
		_:
			result = 999

	result


pure func iterations_before_dispatch_break(value: String) -> Int:
	var iterations: Int = 0

	while iterations < 3:
		iterations += 1

		match value:
			"a":
				iterations = iterations
			"if":
				iterations = iterations
			"func":
				owned_label: String = value + "!"

				if owned_label == "func!":
					break
			"record":
				iterations = iterations
			_:
				break

	iterations


@tail_recursive
pure func classify_string_tailrec(value: String, remaining: Int) -> Int:
	match value:
		"":
			101
		"a":
			102
		"if":
			103
		"in":
			104
		"func":
			105
		"pure":
			106
		"record":
			107
		"a\0b":
			108
		_:
			if remaining > 0:
				classify_string_tailrec("func", remaining - 1)
			else:
				999


pure func test_string_literal_length_dispatch_cases() -> Bool:
	(
		classify_string("") == 101
		and classify_string("a") == 102
		and classify_string("if") == 103
		and classify_string("in") == 104
		and classify_string("func") == 105
		and classify_string("pure") == 106
		and classify_string("record") == 107
		and classify_string("a\0b") == 108
	)


pure func test_string_literal_length_dispatch_fallbacks() -> Bool:
	classify_string("of") == 999 and classify_string("unmatched-length") == 999


pure func test_void_string_literal_length_dispatch() -> Bool:
	observe_void_string_match("in") == 104 and observe_void_string_match("missing") == 999


pure func test_string_literal_dispatch_preserves_loop_break() -> Bool:
	iterations_before_dispatch_break("func") == 1


pure func test_tailrec_string_literal_length_dispatch() -> Bool:
	(
		classify_string_tailrec("record", 0) == 107
		and classify_string_tailrec("missing", 1) == 105
		and classify_string_tailrec("missing", 0) == 999
	)


tests: TestSuite = {
	description = "String literal match length dispatch",
	tests = [
		("dispatches every literal case", test_string_literal_length_dispatch_cases),
		(
			"preserves same and absent length fallbacks",
			test_string_literal_length_dispatch_fallbacks,
		),
		("preserves void match branches", test_void_string_literal_length_dispatch),
		("preserves enclosing loop break", test_string_literal_dispatch_preserves_loop_break),
		("preserves tail-recursive matches", test_tailrec_string_literal_length_dispatch),
	]
}
