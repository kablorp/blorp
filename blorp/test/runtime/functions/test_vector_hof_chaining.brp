import:
	test: TestSuite
	vector: all, any, fold, map


func test_fold_of_map() -> Bool:
	v: Int[#5] = {1, 2, 3, 4, 5}
	result: Int = fold(v.map(func(x: Int) -> Int: x * 2), 0, func(a: Int, b: Int) -> Int: a + b)
	result == 30


func test_all_of_map() -> Bool:
	v: Int[#3] = {1, 2, 3}
	all(v.map(func(x: Int) -> Int: x * 10), func(x: Int) -> Bool: x >= 10)


func test_any_of_map() -> Bool:
	v: Int[#3] = {1, 2, 3}
	any(v.map(func(x: Int) -> Int: x - 2), func(x: Int) -> Bool: x > 0)


func test_map_of_map() -> Bool:
	v: Int[#3] = {1, 2, 3}
	result: Int[#3] = map(v.map(func(x: Int) -> Int: x + 1), func(x: Int) -> Int: x * 2)
	result[0] == 4 and result[1] == 6 and result[2] == 8


func test_fold_of_map_float() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	result: Float = fold(
		map(
			v,
			func(x: Float) -> Float: x * 2.0,
		),
		0.0,
		func(a: Float, b: Float) -> Float: a + b,
	)
	result == 12.0


tests: TestSuite = {
	description = "HOF inline chaining",
	tests = [
		("fold of map", test_fold_of_map),
		("all of map", test_all_of_map),
		("any of map", test_any_of_map),
		("map of map", test_map_of_map),
		("fold of map float", test_fold_of_map_float),
	]
}
