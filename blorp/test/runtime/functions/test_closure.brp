-- Test closure capture functionality
import:
	test: TestSuite


func make_adder(n: Int) -> (Int) -> Int:
	func(x: Int): x + n


func make_linear(a: Int, b: Int) -> (Int) -> Int:
	func(x: Int): a * x + b


func make_counter(start: Int) -> () -> Int:
	func(): start


tests: TestSuite = {
	description = "Closure Capture",
	tests = [
		("basic capture", func(): make_adder(5)(10) == 15),
		("multi capture", func(): make_linear(2, 3)(10) == 23),
		("return captured value", func(): make_counter(5)() == 5),
		("nested grandparent capture", func():
			x: Int = 10
			outer: () -> Int = func():
				inner: () -> Int = func():
					x
				inner()
			outer() == 10
		),
		("nested multi capture", func():
			a: Int = 3
			b: Int = 7
			outer: () -> Int = func():
				inner: () -> Int = func():
					a + b
				inner()
			outer() == 10
		)
	]
}
