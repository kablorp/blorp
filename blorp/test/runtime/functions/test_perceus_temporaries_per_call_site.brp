-- Perceus names a call's result temporaries from the call node's source
-- location. When graph lowering lost source spans, every node packed to line 1
-- column 1, so two calls in one expression declared the same C temporaries and
-- the program failed C compilation with a redefinition. Fused Option
-- `get_or` calls on dictionary lookups hit the same collision.
import:
	test: TestSuite


pure func rows_of(xs: List[Int], k: Int) -> List[Int]:
	xs.append(k)


func test_two_calls_in_one_interpolation() -> Bool:
	xs: List[Int] = [1, 2]
	"${rows_of(xs, 1).to_string()} ${rows_of(xs, 2).to_string()}" == "[1, 2, 1] [1, 2, 2]"


func test_two_calls_in_one_concatenation() -> Bool:
	xs: List[Int] = [3]
	rows_of(xs, 4).to_string() + rows_of(xs, 5).to_string() == "[3, 4][3, 5]"


func test_two_fused_lookups_in_one_interpolation() -> Bool:
	labels: Dict[String, String] = {"label" => "a"}
	"${labels.get("label").get_or("")} ${labels.get("kind").get_or("-")}" == "a -"


func test_fused_lookups_beside_collection_segments() -> Bool:
	names: List[String] = ["x"]
	labels: Dict[String, String] = {"label" => "a"}
	text: String = "${names} ${labels.get("label").get_or("")} ${labels.get("kind").get_or("-")} ${labels.keys()}"
	text == "[\"x\"] a - [\"label\"]"


tests: TestSuite = {
	description = "Perceus temporaries per call site",
	tests = [
		("two calls in one interpolation", test_two_calls_in_one_interpolation),
		("two calls in one concatenation", test_two_calls_in_one_concatenation),
		("two fused lookups in one interpolation", test_two_fused_lookups_in_one_interpolation),
		("fused lookups beside collection segments", test_fused_lookups_beside_collection_segments),
	]
}
