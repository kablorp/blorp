-- A loop variable updated through a temporary, where the assigned call's
-- argument can leave the iteration with `break` or `continue`. The variable
-- must keep its value from before the first call on that iteration, so the
-- compiler must not forward the temporary into the variable here.
--
-- This lives outside the leak gate: leaving a loop iteration from inside a
-- call argument leaks the already-bound temporary on main as well (see
-- docs/issues/break-in-call-argument-leaks-bound-owner.md).
import:
	test: TestSuite


record Tables {
	rows: List[Int],
	other: List[Int]
}


pure func append_row(t: Tables, v: Int) -> Tables:
	{ t | rows = t.rows.append(v) }


pure func append_other(t: Tables, v: Int) -> Tables:
	{ t | other = t.other.append(v) }


pure func append_through_temporary_with_break(count: Int) -> Tables:
	var out: Tables = {
		rows = [],
		other = []
	}

	for i in 0..count:
		appended: Tables = out.append_row(i)
		out = appended.append_other(
			match i == 2:
				True:
					break
					0
				False:
					i
		)

	out


pure func append_through_temporary_with_continue(count: Int) -> Tables:
	var out: Tables = {
		rows = [],
		other = []
	}

	for i in 0..count:
		appended: Tables = out.append_row(i)
		out = appended.append_other(
			match i == 1:
				True:
					continue
					0
				False:
					i
		)

	out


func test_break_in_assigned_call_keeps_old_value() -> Bool:
	broken: Tables = append_through_temporary_with_break(5)

	broken.rows == [0, 1] and broken.other == [0, 1]


func test_continue_in_assigned_call_keeps_old_value() -> Bool:
	continued: Tables = append_through_temporary_with_continue(3)

	continued.rows == [0, 2] and continued.other == [0, 2]


tests: TestSuite = {
	description = "Loop temporary leaving early",
	tests = [
		("break in assigned call keeps old value", test_break_in_assigned_call_keeps_old_value),
		(
			"continue in assigned call keeps old value",
			test_continue_in_assigned_call_keeps_old_value,
		),
	]
}
