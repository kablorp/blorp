-- Range loops whose bounds are computed expressions rather than literals or
-- variables. The backend used to accept only leaf-shaped bounds, so a call
-- such as `0..xs.length().min(3)` failed to emit the enclosing function.
-- Each bound must be evaluated once, before the loop, and any temporary it
-- owns (a concatenated string, a list literal) released there.
import:
	test: TestSuite


pure func indices_up_to_three(xs: List[Int]) -> List[Int]:
	var seen: List[Int] = []

	for i in 0..xs.length().min(3):
		seen = seen.append(i)

	seen


pure func indices_over_owned_temporary(name: String) -> List[Int]:
	var seen: List[Int] = []

	for i in 0..(name + "cd").length():
		seen = seen.append(i)

	seen


pure func indices_between_computed_bounds(xs: List[Int]) -> List[Int]:
	var seen: List[Int] = []

	for i in xs.length().min(1)..(xs + [50]).length():
		seen = seen.append(i)

	seen


pure func indices_counting_down_between_list_literals() -> List[Int]:
	var seen: List[Int] = []

	for i in [5, 6, 7].length()..[1].length():
		seen = seen.append(i)

	seen


pure func pairs_with_bound_from_outer_index(xs: List[Int]) -> List[Int]:
	var seen: List[Int] = []

	for i in 0..2:
		for j in 0..xs.length().min(i + 1):
			seen = seen.append(i * 10 + j)

	seen


func test_call_chain_end_bound() -> Bool:
	indices_up_to_three([10, 20, 30, 40]) == [0, 1, 2] and indices_up_to_three([10]) == [0]


func test_end_bound_owning_a_temporary() -> Bool:
	indices_over_owned_temporary("ab") == [0, 1, 2, 3]


func test_computed_start_and_end_bounds() -> Bool:
	indices_between_computed_bounds([10, 20, 30, 40]) == [1, 2, 3, 4]


func test_computed_bounds_counting_down() -> Bool:
	indices_counting_down_between_list_literals() == [3, 2]


func test_nested_loop_bound_reads_outer_index() -> Bool:
	pairs_with_bound_from_outer_index([10, 20, 30]) == [0, 10, 11]


tests: TestSuite = {
	description = "Range loop computed bounds",
	tests = [
		("call chain end bound", test_call_chain_end_bound),
		("end bound owning a temporary", test_end_bound_owning_a_temporary),
		("computed start and end bounds", test_computed_start_and_end_bounds),
		("computed bounds counting down", test_computed_bounds_counting_down),
		("nested loop bound reads outer index", test_nested_loop_bound_reads_outer_index),
	]
}
