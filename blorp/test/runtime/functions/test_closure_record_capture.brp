import:
	tensor: get, set_index
	test: TestSuite
	vector: ParallelVector, parallel


record SmallRec {
	data: Float[#100],
	count: Int
}


pure func vget100(v: Float[#100], i: Int) -> Float:
	match get(v, i):
		Some(val): val
		None: 0.0


-- Test 1: capture a simple record
func test_capture_record() -> Bool:
	var d = vector(0.0, 100)
	for i in 0..100:
		match d.set_index(i, to_float(i) * 0.5):
			Some(d2): d = d2
			None: void
	rec: SmallRec = {
		data = d,
		count = 100
	}
	result: Float[#100] = d.parallel(pure func(chunk: ParallelVector[Float, #100]):
		chunk.map_indexed(pure func(i: ..#100, val: Float): vget100(rec.data, i) + 1.0)
	)
	match get(result, 10):
		Some(val): val > 5.9 and val < 6.1
		None: False


-- Test 2: capture a record with multiple vector fields (like Octree)
record BigRec {
	ax: Float[#100],
	ay: Float[#100],
	az: Float[#100],
	bx: Float[#100],
	n: Int
}


func test_capture_big_record() -> Bool:
	var a = vector(0.0, 100)
	var b = vector(0.0, 100)
	for i in 0..100:
		match a.set_index(i, to_float(i)):
			Some(a2): a = a2
			None: void
		match b.set_index(i, to_float(i) * 2.0):
			Some(b2): b = b2
			None: void
	rec: BigRec = {
		ax = a,
		ay = a,
		az = a,
		bx = b,
		n = 100
	}
	sig: Float[#100] = vector(0.0, 100)
	result: Float[#100] = sig.parallel(pure func(chunk: ParallelVector[Float, #100]):
		chunk.map_indexed(pure func(i: ..#100, val: Float): vget100(rec.ax, i) + vget100(rec.bx, i))
	)
	match get(result, 5):
		Some(val): val > 14.9 and val < 15.1
		None: False


-- Test 3: capture record + multiple other vectors (like the gravity pattern)
func test_capture_record_plus_vectors() -> Bool:
	var a = vector(0.0, 100)
	var b = vector(0.0, 100)
	for i in 0..100:
		match a.set_index(i, to_float(i)):
			Some(a2): a = a2
			None: void
		match b.set_index(i, to_float(i) * 3.0):
			Some(b2): b = b2
			None: void
	rec: BigRec = {
		ax = a,
		ay = a,
		az = a,
		bx = b,
		n = 100
	}
	snap_a: Float[#100] = a
	snap_b: Float[#100] = b
	sig: Float[#100] = vector(0.0, 100)
	result: Float[#100] = sig.parallel(pure func(chunk: ParallelVector[Float, #100]):
		chunk.map_indexed(
			pure func(
				i: ..#100,
				val: Float,
			): vget100(snap_a, i) + vget100(snap_b, i) + vget100(rec.ax, i),
		)
	)
	match get(result, 5):
		Some(val): val > 24.9 and val < 25.1
		None: False


-- Test 4: closure with local mutable state (like octree_gravity's stack)
pure func compute_with_stack(rec: BigRec, idx: Int) -> Float:
	var acc: Float = 0.0
	var count: Int = 0
	while count < 5:
		acc = acc + vget100(rec.ax, idx) + to_float(count)
		count += 1
	acc


func test_capture_with_internal_mutation() -> Bool:
	var a = vector(0.0, 100)
	for i in 0..100:
		match a.set_index(i, to_float(i)):
			Some(a2): a = a2
			None: void
	rec: BigRec = {
		ax = a,
		ay = a,
		az = a,
		bx = a,
		n = 100
	}
	sig: Float[#100] = vector(0.0, 100)
	result: Float[#100] = sig.parallel(pure func(chunk: ParallelVector[Float, #100]):
		chunk.map_indexed(pure func(i: ..#100, val: Float): compute_with_stack(rec, i))
	)
	match get(result, 3):
		Some(val): val > 24.9 and val < 25.1
		None: False


tests: TestSuite = {
	description = "Closure record capture with scoped vector parallelism",
	tests = [
		("capture record", test_capture_record),
		("capture big record", test_capture_big_record),
		("capture record plus vectors", test_capture_record_plus_vectors),
		("capture with internal mutation", test_capture_with_internal_mutation),
	]
}
