-- Test that lambdas in list literals can use qualified module calls
import:
	dict as Dict
	set as S
	test: TestSuite


tests: TestSuite = {
	description = "Lambda module alias",
	tests = [
		("dict qualified new+set+get", func():
			var d: Dict[Int, String] = Dict.dict()
			d = Dict.set(d, 1, "hello")
			match Dict.get(d, 1):
				Some(v): v == "hello"
				None: False
		),
		("dict contains", func():
			var d: Dict[Int, Int] = Dict.dict()
			d = Dict.set(d, 42, 100)
			Dict.contains(d, 42) and not Dict.contains(d, 99)
		),
		("set qualified new+add+contains", func():
			var s: Set[Int] = S.set()
			s = S.add(s, 10)
			s = S.add(s, 20)
			S.contains(s, 10) and S.contains(s, 20) and not S.contains(s, 30)
		),
		("set remove", func():
			var s: Set[Int] = S.set()
			s = S.add(s, 1)
			s = S.add(s, 2)
			s = S.remove(s, 1)
			s.length() == 1 and not S.contains(s, 1)
		),
		("dict and set in same lambda", func():
			var d: Dict[String, Int] = Dict.dict()
			d = Dict.set(d, "x", 1)
			var s: Set[Int] = S.set()
			s = S.add(s, 1)
			Dict.contains(d, "x") and S.contains(s, 1)
		)
	]
}
