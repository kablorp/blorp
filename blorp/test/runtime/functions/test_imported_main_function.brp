import:
	./helpers/main_as_function_module: main as helper_main
	test: TestSuite


func test_imported_main_alias_is_callable() -> Bool:
	helper_main(["one", "two"]) == 42


tests: TestSuite = {
	description = "Imported main function",
	tests = [("imported main alias is callable", test_imported_main_alias_is_callable)]
}
