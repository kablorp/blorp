import:
	../../src/lib/cli_args: CliTestArgs, CliTestMode(CliTestAll)
	../../src/lib/function_profile: FunctionProfileConfiguration(FunctionProfileOff)
	../../src/test/environment: CliTestEnvironment, resolve_test_args_environment
	test: TestSuite


private pure func options() -> CliTestArgs:
	{
		profile = FunctionProfileOff,
		debug = False,
		sanitizer = None,
		leak_check = False,
		release = False,
		c_translation_units = 1,
		timeout = None,
		repeat = 1,
		mode = CliTestAll,
		std_dir = None,
		paths = ["tests"]
	}


private pure func environment() -> CliTestEnvironment:
	{
		test_timeout = Some("7"),
		leak_check = Some("1")
	}


pure func test_environment_fills_unspecified_timeout_and_leak_check() -> Bool:
	match resolve_test_args_environment(options(), environment()):
		Ok(resolved):
			resolved.timeout == Some(7) and resolved.leak_check
		Err(_):
			False


pure func test_environment_uses_thirty_second_default() -> Bool:
	empty: CliTestEnvironment = {
		test_timeout = None,
		leak_check = None
	}

	match resolve_test_args_environment(options(), empty):
		Ok(resolved):
			resolved.timeout == Some(30)
		Err(_):
			False


pure func test_cli_options_override_test_environment() -> Bool:
	configured = { options() |
		timeout = Some(0),
		leak_check = True
	}

	match resolve_test_args_environment(configured, environment()):
		Ok(resolved):
			resolved.timeout == Some(0) and resolved.leak_check
		Err(_):
			False


pure func test_invalid_test_environment_is_rejected() -> Bool:
	bad = { environment() | test_timeout = Some("later") }
	resolve_test_args_environment(options(), bad).is_err()


tests: TestSuite = {
	description = "Blorp compiler test environment",
	tests = [
		(
			"environment fills unspecified timeout and leak check",
			test_environment_fills_unspecified_timeout_and_leak_check,
		),
		("uses thirty second default", test_environment_uses_thirty_second_default),
		("CLI options override environment", test_cli_options_override_test_environment),
		("invalid environment is rejected", test_invalid_test_environment_is_rejected),
	]
}
