private pure func parse(source: String) -> ParsedProgram:
	parse_compiler_source(source_file("test.brp", "test", source))


private func process_succeeded(command: Result[ProcessOutput, String]) -> Bool:
	match command:
		Ok(output):
			output.exit_code() == 0
		Err(_):
			False


private func process_failure(command: Result[ProcessOutput, String]) -> String:
	match command:
		Ok(output):
			"exit " + output
				.exit_code()
				.to_string() + ": " + output.stderr()
		Err(error):
			error


private func create_directory_link(target: String, link_path: String) -> Result[Void, IOError]:
	posix_link: Result[ProcessOutput, String] = run(
		"ln",
		["-s", target, link_path],
	)

	if process_succeeded(posix_link):
		Ok(void)
	else:
		windows_link: Result[ProcessOutput, String] = run(
			"cmd.exe",
			["/D", "/C", "mklink", "/J", link_path, target],
		)

		if process_succeeded(windows_link):
			Ok(void)
		else:
			Err(
				Other(
					"failed to create test directory alias; ln: " + process_failure(
						posix_link,
					) + "; mklink: " + process_failure(windows_link),
				),
			)


private pure func canonical_alias_source_matches(
	source: CliDiscoveredTestSource,
	expected_source_path: String,
	expected_canonical_path: String,
) -> Bool:
	path_matches: Bool = (
		source.program.source.path == expected_source_path
		and source.canonical_path == expected_canonical_path
	)

	path_matches


private pure func canonical_alias_sources_match(
	sources: List[CliDiscoveredTestSource],
	expected_source_path: String,
	expected_canonical_path: String,
) -> Bool:
	match sources:
		[source]:
			canonical_alias_source_matches(source, expected_source_path, expected_canonical_path)
		_:
			False


private func expect_features(
	label: String,
	program: ParsedProgram,
	features: CliTestSourceFeatures,
	has_main: Bool,
	has_tests_binding: Bool,
	has_doctests: Bool,
) -> Bool:
	matches: Bool = (
		program.diagnostics.length() == 0
		and features.has_main == has_main
		and features.has_tests_binding == has_tests_binding
		and features.has_doctests == has_doctests
	)

	if not matches:
		message: String = label + ": diagnostics=" + program.diagnostics
			.length()
			.to_string() + ", main=" + features.has_main.to_string() + ", tests=" + features.has_tests_binding.to_string() + ", doctests=" + features.has_doctests.to_string()

		print_error(message)

	matches


func test_classification_uses_top_level_declarations() -> Bool:
	test_suite_type: String = "Test" + "Suite"
	test_import: String = "\ttest: " + test_suite_type + "\n\n\n"
	source: String = "import:\n" + test_import + "tests:" + " " + test_suite_type + " = {\n" + "\tdescription = \"sample\",\n" + "\ttests = []\n" + "}\n\n\n" + "func main(args: List[String]) -> Int:\n" + "\t0\n"

	program = parse(source)
	features = classify_test_source(program)

	expect_features("top-level", program, features, True, True, False)


func test_classification_ignores_source_text_lookalikes() -> Bool:
	lookalike: String = "tests:" + " TestSuite and func main("
	source: String =
		|---
		|This sentence mentions doctests: but does not declare them.
		|---
		|pure func example() -> String:
		|	"${lookalike}"
	program = parse(source)
	features = classify_test_source(program)

	expect_features("lookalike", program, features, False, False, False)


func test_classification_defers_tests_binding_type_identity() -> Bool:
	program = parse("tests: Int = 1")
	features = classify_test_source(program)

	expect_features("deferred type identity", program, features, False, True, False)


func test_classification_ignores_private_tests_and_reads_parsed_docs() -> Bool:
	test_suite_type: String = "Test" + "Suite"
	source: String = "---\n" + "Example.\n\n" + "doctests:\n" + "\t:: returns one\n" + "\texample() == 1\n" + "---\n" + "pure func example() -> Int:\n" + "\t1\n\n\n" + "private tests:" + " " + test_suite_type + " = {\n" + "\tdescription = \"private sample\",\n" + "\ttests = []\n" + "}\n"

	program = parse(source)
	features = classify_test_source(program)

	expect_features("private and docs", program, features, False, False, True)


private func exercise_filesystem_discovery() -> Result[Bool, IOError]:
	with root ?= temporary_directory(getcwd(), "blorp_test_discovery_"):
		root_path: String = root.resource_path()
		canonical_root_path ?= canonical_existing_path(root_path)
		nested: String = root_path.join("nested")
		skipped: String = root_path.join("should_fail")
		leak_baselines: String = root_path.join("blorp/test/test_runtime/test_memory/leak_check_baselines")
		created_nested ?= create_directories(nested)
		created_skipped ?= create_directories(skipped)
		created_leak_baselines ?= create_directories(leak_baselines)

		test_suite_type: String = "Test" + "Suite"
		test_import: String = "import:\n\ttest: " + test_suite_type + "\n\n"
		suite_value: String = "{\n\tdescription = \"suite\",\n\ttests = []\n}\n"
		suite_source: String = test_import + "type alias Suite = " + test_suite_type + "\n\n" + "tests: Suite = " + suite_value
		direct_suite_source: String = test_import + "tests:" + " " + test_suite_type + " = " + suite_value
		doctest_source: String =
			|---
			|Example.
			|
			|doctests:
			|	:: true
			|	True
			|---
			|pure func example() -> Bool:
			|	True
		ignored_source: String = "tests:" + " " + test_suite_type + " = {\n\tdescription = \"ignored\",\n\ttests = []\n}\n"
		same_stem_source: String = test_import + "tests:" + " " + test_suite_type + " = " + suite_value

		wrote_suite ?= write_text_atomic(
			root_path.join("a.brp"),
			suite_source,
		)
		wrote_broken ?= write_text_atomic(
			root_path.join("broken.brp"),
			"pure func broken(",
		)
		wrote_helper ?= write_text_atomic(
			root_path.join("helper.brp"),
			"pure func helper() -> Int: 1\n",
		)
		wrote_doctest ?= write_text_atomic(
			nested.join("b.brp"),
			doctest_source,
		)
		wrote_ignored ?= write_text_atomic(
			skipped.join("ignored.brp"),
			ignored_source,
		)
		wrote_text ?= write_text_atomic(
			root_path.join("notes.txt"),
			suite_source,
		)
		leak_baseline_path: String = leak_baselines.join("standalone.brp")
		wrote_leak_baseline ?= write_text_atomic(
			leak_baseline_path,
			"func main(args: List[String]) -> Int:\n\t0\n",
		)

		explicit_paths: List[String] = [
			root_path.join("a.brp"),
			root_path.join("broken.brp"),
			nested.join("b.brp"),
			root_path.join("helper.brp"),
			root_path.join("a.brp"),
		]
		discovered ?= discover_test_sources(
			explicit_paths,
			root_path,
			False,
		)
		relative_requested_path: String = basename(root_path).join("a.brp")
		relative_discovered ?= discover_test_sources([relative_requested_path], getcwd(), False)
		explicit_skipped ?= discover_test_sources([skipped.join("ignored.brp")], root_path, False)
		explicit_non_blorp ?= discover_test_sources([root_path.join("notes.txt")], root_path, False)
		with_leak_baseline ?= discover_test_sources([leak_baseline_path], root_path, True)
		without_leak_baseline ?= discover_test_sources([leak_baseline_path], root_path, False)
		isolated_directory: String = root_path.join("blorp/test/test_runtime/test_sys")
		created_isolated ?= create_directories(isolated_directory)
		isolated_path: String = isolated_directory.join("canonical_identity.brp")
		wrote_isolated ?= write_text_atomic(isolated_path, direct_suite_source)
		same_stem_left_directory: String = root_path.join("tests/test_blorp/types")
		same_stem_right_directory: String = root_path.join("tests/test_blorp/text")
		created_same_stem_left ?= create_directories(same_stem_left_directory)
		created_same_stem_right ?= create_directories(same_stem_right_directory)
		same_stem_left_path: String = same_stem_left_directory.join("test_format_float.brp")
		same_stem_right_path: String = same_stem_right_directory.join("test_format_float.brp")
		wrote_same_stem_left ?= write_text_atomic(same_stem_left_path, same_stem_source)
		wrote_same_stem_right ?= write_text_atomic(same_stem_right_path, same_stem_source)
		isolated_alias_directory: String = root_path.join("isolated_alias")
		created_isolated_alias ?= create_directory_link(
			isolated_directory,
			isolated_alias_directory,
		)
		isolated_alias: String = isolated_alias_directory.join("canonical_identity.brp")
		canonical_isolated_path ?= canonical_existing_path(isolated_path)

		canonical_alias_sources ?= discover_test_sources(
			[isolated_alias, isolated_path],
			root_path,
			False,
		)
		same_stem_candidate_paths ?= discover_test_source_paths(
			[same_stem_left_path, same_stem_right_path],
			root_path,
			None,
			CliTestAll,
		)
		same_stem_sources ?= discover_test_sources(
			[same_stem_left_path, same_stem_right_path],
			root_path,
			False,
		)

		paths: List[String] = discovered.map(func(source): source.program.source.path)
		suite_found: Bool = discovered.any(func(source):
			(
				source.program.source.path == root_path.join("a.brp")
				and source.canonical_path == canonical_root_path.join("a.brp")
				and source.features.has_tests_binding
				and source.program.source.text == suite_source
			)
		)
		doctest_found: Bool = discovered.any(func(source):
			(
				source.program.source.path == root_path.join("nested/b.brp")
				and source.features.has_doctests
			)
		)
		broken_found: Bool = discovered.any(func(source):
			(
				source.program.source.path == root_path.join("broken.brp")
				and parsed_program_has_errors(source.program)
				and not source.features.has_tests_binding
			)
		)
		leak_baseline_found: Bool = with_leak_baseline.any(func(source):
			if source.program.source.path == root_path.join(
				"blorp/test/test_runtime/test_memory/leak_check_baselines/standalone.brp",
			):
				source.is_leak_baseline_program
			else:
				False
		)
		missing_path: String = root_path.join("missing.brp")
		same_stem_source_paths: List[String] = same_stem_candidate_paths.map(
			func(source): source.source_path,
		)
		same_stem_canonical_paths: List[String] = same_stem_candidate_paths.map(
			func(source): source.canonical_path,
		)
		same_stem_module_names: List[String] = same_stem_candidate_paths.map(
			func(source): source.module_name,
		)
		same_stem_parsed_module_names: List[String] = same_stem_sources.map(
			func(source): source.program.source.module_name,
		)
		same_stem_modules_retained: Bool = (
			same_stem_candidate_paths.length() == 2
			and same_stem_sources.length() == 2
			and same_stem_source_paths == [same_stem_left_path, same_stem_right_path]
			and same_stem_canonical_paths == [
				canonical_root_path.join("tests/test_blorp/types/test_format_float.brp"),
				canonical_root_path.join("tests/test_blorp/text/test_format_float.brp"),
			]
			and same_stem_module_names == [
				"tests/test_blorp/types/test_format_float",
				"tests/test_blorp/text/test_format_float",
			]
			and same_stem_parsed_module_names == same_stem_module_names
		)

		canonical_alias_resolved: Bool = canonical_alias_sources_match(
			canonical_alias_sources,
			isolated_alias,
			canonical_isolated_path,
		)

		relative_path_retained: Bool = match relative_discovered:
			[source]:
				(
					source.program.source.path == relative_requested_path
					and source.canonical_path == canonical_root_path.join("a.brp")
				)
			_:
				False

		missing_rejected: Bool = match discover_test_sources([missing_path], root_path, False):
			Err(NotFound(path)):
				path == missing_path
			_:
				False

		Ok(
			(
				paths == [
					root_path.join("a.brp"),
					root_path.join("broken.brp"),
					root_path.join("nested/b.brp"),
				]
				and suite_found
				and doctest_found
				and broken_found
				and explicit_skipped.length() == 1
				and explicit_non_blorp.length() == 0
				and leak_baseline_found
				and without_leak_baseline.length() == 0
				and canonical_alias_resolved
				and relative_path_retained
				and same_stem_modules_retained
				and missing_rejected
			),
		)


func test_filesystem_discovery_is_structural_and_deterministic() -> Bool:
	match exercise_filesystem_discovery():
		Ok(result):
			result
		Err(err):
			print_error("filesystem discovery failed: " + message(err))
			False


private func exercise_named_directory_discovery() -> Result[Bool, IOError]:
	with root ?= temporary_directory(getcwd(), "blorp_named_discovery_"):
		root_path: String = root.resource_path()
		nested: String = root_path.join("test_nested")
		fixtures: String = root_path.join("fixtures")
		ordinary: String = root_path.join("testish")
		compiler: String = root_path.join("test_compiler")
		skipped: String = root_path.join("should_fail")
		passed: String = root_path.join("should_pass")
		created_nested ?= create_directories(nested)
		created_fixtures ?= create_directories(fixtures)
		created_ordinary ?= create_directories(ordinary)
		created_compiler ?= create_directories(compiler)
		created_skipped ?= create_directories(skipped)
		created_passed ?= create_directories(passed)
		source: String = "tests: Int = 1\n"
		alpha: String = root_path.join("test_alpha.brp")
		beta: String = nested.join("test_beta.brp")
		broken: String = nested.join("test_broken.brp")
		custom: String = fixtures.join("custom.brp")
		compiler_test: String = compiler.join("test_valid.brp")
		wrote_alpha ?= write_text_atomic(alpha, source)
		wrote_beta ?= write_text_atomic(beta, source)
		wrote_broken ?= write_text_atomic(broken, "pure func broken(")
		wrote_custom ?= write_text_atomic(custom, source)
		wrote_compiler ?= write_text_atomic(compiler_test, source)
		wrote_skipped ?= write_text_atomic(skipped.join("test_invalid.brp"), "pure func broken(")
		wrote_passed ?= write_text_atomic(passed.join("test_valid.brp"), source)
		wrote_fixture ?= write_text_atomic(fixtures.join("errors.brp"), "pure func broken(")
		wrote_ordinary ?= write_text_atomic(root_path.join("not_a_test.brp"), "pure func broken(")
		wrote_nested_ordinary ?= write_text_atomic(nested.join("ordinary.brp"), "pure func broken(")
		wrote_false_prefix ?= write_text_atomic(ordinary.join("test_hidden.brp"), source)
		wrote_suffix ?= write_text_atomic(root_path.join("test_notes.brp.txt"), source)
		linked ?= create_directory_link(nested, root_path.join("test_alias"))
		candidates ?= discover_test_source_paths([root_path, alpha], root_path, None, CliTestAll)
		suite_candidates ?= discover_test_source_paths([root_path], root_path, None, CliTestSuiteOnly)
		explicit_candidates ?= discover_test_source_paths([custom], root_path, None, CliTestAll)
		explicit_root ?= discover_test_source_paths([fixtures], root_path, None, CliTestAll)
		explicit_skipped_root ?= discover_test_source_paths([skipped], root_path, None, CliTestAll)
		explicit_passed_root ?= discover_test_source_paths([passed], root_path, None, CliTestAll)
		explicit_compiler_root ?= discover_test_source_paths([compiler], root_path, None, CliTestAll)
		doc_skipped_roots ?= discover_test_source_paths([skipped, passed, compiler], root_path, None, CliTestDocOnly)
		doc_candidates ?= discover_test_source_paths([root_path], root_path, None, CliTestDocOnly)
		discovered ?= discover_test_sources([root_path], root_path, False)
		Ok(
			candidates.map(func(candidate): candidate.source_path) == [alpha, compiler_test, beta, broken]
			and suite_candidates.map(func(candidate): candidate.source_path) == [alpha, compiler_test, beta, broken]
			and explicit_candidates.map(func(candidate): candidate.source_path) == [custom]
			and explicit_root.length() == 0
			and explicit_skipped_root.map(func(candidate): candidate.source_path) == [skipped.join("test_invalid.brp")]
			and explicit_passed_root.map(func(candidate): candidate.source_path) == [passed.join("test_valid.brp")]
			and explicit_compiler_root.map(func(candidate): candidate.source_path) == [compiler_test]
			and doc_skipped_roots.length() == 0
			and doc_candidates.map(func(candidate): candidate.source_path) == [
				custom,
				fixtures.join("errors.brp"),
				root_path.join("not_a_test.brp"),
				alpha,
				nested.join("ordinary.brp"),
				beta,
				broken,
				ordinary.join("test_hidden.brp"),
			]
			and discovered.length() == 4
			and discovered.any(func(source):
				source.program.source.path == broken and parsed_program_has_errors(source.program)
			)
		)


func test_directory_discovery_selects_named_modules_before_parsing() -> Bool:
	match exercise_named_directory_discovery():
		Ok(result):
			result
		Err(err):
			print_error("named directory discovery failed: " + message(err))
			False


private func exercise_standard_library_discovery_identity() -> Result[Bool, IOError]:
	with root ?= temporary_directory(getcwd(), "blorp_std_discovery_"):
		root_path: String = root.resource_path()
		std_root: String = root_path.join("physical-standard-library")
		module_path: String = std_root.join("net/example.brp")
		created ?= create_directories(std_root.join("net"))
		written ?= write_text_atomic(module_path, "pure func value() -> Int: 1\n")
		sources ?= discover_test_source_paths([module_path], root_path, Some(std_root), CliTestAll)

		match sources:
			[source]:
				Ok(source.module_name == "net/example" and source.is_standard_library_source)
			_:
				Ok(False)


func test_standard_library_discovery_uses_bare_identity() -> Bool:
	match exercise_standard_library_discovery_identity():
		Ok(result):
			result
		Err(_):
			False


tests: TestSuite = {
	description = "Blorp CLI test discovery",
	tests = [
		(
			"classification uses top-level declarations",
			test_classification_uses_top_level_declarations,
		),
		(
			"classification ignores source text lookalikes",
			test_classification_ignores_source_text_lookalikes,
		),
		(
			"classification defers tests binding type identity",
			test_classification_defers_tests_binding_type_identity,
		),
		(
			"classification ignores private tests and reads parsed docs",
			test_classification_ignores_private_tests_and_reads_parsed_docs,
		),
		(
			"filesystem discovery is structural and deterministic",
			test_filesystem_discovery_is_structural_and_deterministic,
		),
		(
			"standard-library discovery uses bare identity",
			test_standard_library_discovery_uses_bare_identity,
		),
		(
			"directory discovery selects named modules before parsing",
			test_directory_discovery_selects_named_modules_before_parsing,
		),
	]
}
