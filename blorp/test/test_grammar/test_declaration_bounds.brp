import:
	../../src/lex/lex: lex
	../../src/parse/parse: module_contents, parse_module
	../../src/utils/names: program_names
	../../src/utils/source: module_source, root_module_id
	test: TestSuite


-- union_decl, record_decl and opaque_type take bounded_parameters, as a
-- function signature does; an unbounded parameter keeps no bounds.
pure func test_declarations_take_bounded_parameters() -> Bool:
	source: String =
		|union Tree[T: Orderable]:
		|    Leaf(T)
		|record Table[K: Hashable + Base.Equatable, V] { keys: List[K], values: List[V] }
		|opaque type Index[K: Hashable, V] = Table[K, V]
	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse_module(tokens, root_module_id())):
		Err(_): False
		Ok(parsed):
			contents = module_contents(parsed)
			match (contents.unions, contents.records, contents.opaques):
				([tree], [table], [index]):
					match (tree.type_parameters, table.type_parameters, index.type_parameters):
						([element], [table_key, table_value], [index_key, index_value]):
							element.bounds.length() == 1 and table_key.bounds.length() == 2 and table_value.bounds.is_empty()
								and index_key.bounds.length() == 1 and index_value.bounds.is_empty()
						_: False
				_: False


tests: TestSuite = {
	description = "Declaration bound grammar",
	tests = [
		("declarations take bounded parameters", test_declarations_take_bounded_parameters),
	]
}
