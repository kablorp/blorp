import:
	../../src/lib/cli_args:
		CliRunArgs,
		CliSanitizerMode(CliSanitizeAddressUndefined, CliSanitizeOff, CliSanitizeUndefined),
	../../src/lib/run_environment: CliRunEnvironment, resolve_run_args_environment
	test: TestSuite


private pure func options() -> CliRunArgs:
	{
		profile = False,
		debug = False,
		sanitizer = None,
		leak_check = False,
		release = False,
		no_format = False,
		timeout = None,
		threads = None,
		std_dir = None,
		files = ["main.brp"],
		user_args = []
	}


private pure func environment() -> CliRunEnvironment:
	{
		timeout = Some("9"),
		sanitizer = Some("undefined"),
		leak_check = Some("1"),
		threads = Some("4"),
		no_format = Some("1")
	}


pure func test_environment_fills_unspecified_run_options() -> Bool:
	match resolve_run_args_environment(options(), environment()):
		Ok(resolved):
			(
				resolved.timeout == Some(9)
				and resolved.sanitizer == Some(CliSanitizeUndefined)
				and resolved.leak_check
				and resolved.threads == Some(4)
				and resolved.no_format
			)
		Err(_):
			False


pure func test_cli_run_options_override_environment() -> Bool:
	configured = { options() |
		timeout = Some(0),
		sanitizer = Some(CliSanitizeOff),
		leak_check = True,
		threads = Some(2),
		no_format = True
	}

	match resolve_run_args_environment(configured, environment()):
		Ok(resolved):
			(
				resolved.timeout == Some(0)
				and resolved.sanitizer == Some(CliSanitizeOff)
				and resolved.leak_check
				and resolved.threads == Some(2)
				and resolved.no_format
			)
		Err(_):
			False


pure func test_invalid_run_environment_is_rejected() -> Bool:
	bad_timeout: CliRunEnvironment = { environment() | timeout = Some("later") }
	bad_threads: CliRunEnvironment = { environment() | threads = Some("0") }
	bad_sanitizer: CliRunEnvironment = { environment() | sanitizer = Some("memory") }

	(
		resolve_run_args_environment(options(), bad_timeout).is_err()
		and resolve_run_args_environment(options(), bad_threads).is_err()
		and resolve_run_args_environment(options(), bad_sanitizer).is_err()
	)


tests: TestSuite = {
	description = "Blorp compiler run environment",
	tests = [
		(
			"environment fills unspecified run options",
			test_environment_fills_unspecified_run_options,
		),
		("CLI run options override environment", test_cli_run_options_override_environment),
		("invalid run environment is rejected", test_invalid_run_environment_is_rejected),
	]
}
