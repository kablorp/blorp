import:
	../../src/lib/build_artifact:
		BuildCompatibility,
		BuildOptimization(BuildRelease),
		BuildPlatform(BuildLinux),
		BuildSanitizer(BuildUndefinedSanitizer),
	../../src/lib/host_c: HostCCompilerFamily(HostClang), HostTlsBackend(HostTlsUnsupported)
	../../src/lib/host_environment: HostEnvironment
	../../src/lib/run_effect:
		CliRunEffectConfiguration,
		runtime_cache_configuration_for_compatibility,
	../../src/lib/runtime_sources: RuntimeSources
	test: TestSuite
	units: data_size_bytes, mebibytes, seconds, to_microseconds


private RUNTIME_SOURCES: RuntimeSources = {
	runtime = "runtime",
	declarations = "declarations"
}


private pure func host_environment() -> HostEnvironment:
	{
		toolchain = {
			platform = BuildLinux,
			compiler = {
				program = "cc",
				prefix_arguments = ["wrapper"],
				family = HostClang
			},
			identity = "compiler identity",
			target_identity = "target identity"
		},
		tls = {
			backend = HostTlsUnsupported,
			runtime_arguments = [],
			link_arguments = []
		},
		cache_root = "/cache",
		raylib_prefix = None
	}


pure func test_run_runtime_cache_configuration_preserves_host_and_build_policy() -> Bool:
	compatibility: BuildCompatibility = {
		debug = True,
		profile = False,
		optimization = BuildRelease,
		sanitizer = BuildUndefinedSanitizer,
		leak_check = False
	}
	host: HostEnvironment = host_environment()
	configuration: CliRunEffectConfiguration = {
		runtime_sources = RUNTIME_SOURCES,
		host = host,
		host_timeout = Some(seconds(7)),
		capture_limit = mebibytes(3),
		temporary_root = "/tmp"
	}

	resolved = runtime_cache_configuration_for_compatibility(compatibility, host, configuration)

	(
		resolved.cache_root == host.cache_root
		and resolved.compiler.program == host.toolchain.compiler.program
		and resolved.compiler.prefix_arguments == host.toolchain.compiler.prefix_arguments
		and resolved.compiler.family == host.toolchain.compiler.family
		and resolved.identity == host.toolchain.identity
		and resolved.target_identity == host.toolchain.target_identity
		and resolved.platform == host.toolchain.platform
		and resolved.optimization == compatibility.optimization
		and resolved.sanitizer == compatibility.sanitizer
		and resolved.runtime_sources.runtime == configuration.runtime_sources.runtime
		and resolved.runtime_sources.declarations == configuration.runtime_sources.declarations
		and to_microseconds(
			resolved.timeout.get_or(
				seconds(0),
			),
		) == to_microseconds(configuration.host_timeout.get_or(seconds(0)))
		and data_size_bytes(resolved.capture_limit) == data_size_bytes(configuration.capture_limit)
	)


tests: TestSuite = {
	description = "Run command",
	tests = [
		(
			"runtime cache configuration preserves host and build policy",
			test_run_runtime_cache_configuration_preserves_host_and_build_policy,
		),
	]
}
