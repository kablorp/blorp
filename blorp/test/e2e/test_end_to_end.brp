import:
	./harness: compiler_under_test
	test: TestSuite, run_suite_result
	./test_bindings as Bindings
	./test_binding_names as BindingNames
	./test_calculator as Calculator
	./test_test_entry as TestEntry
	./test_current_directory as CurrentDirectory
	./test_effects as Effects
	./test_frontend as Frontend
	./test_generics as Generics
	./test_imports as Imports
	./test_lists as Lists
	./test_namespace as NamespaceAliases
	./test_argument_input as ArgumentInput
	./test_match as Match
	./test_main_signatures as MainSignatures
	./test_option_input as OptionInput
	./test_owned_prefix as OwnedPrefix
	./test_stored_callables as StoredCallables
	./test_traits as Traits
	./test_trait_bounds as TraitBounds
	./test_result_propagation as ResultPropagation
	./test_source_while as SourceWhile
	./test_value_if as ValueIf
	./test_source_loops as SourceLoops
	./test_structural_patterns as StructuralPatterns
	./test_syntax as Syntax
	./test_ufcs as Ufcs
	./test_unsupported_syntax as UnsupportedSyntax


func run_end_to_end() -> Bool:
	match compiler_under_test():
		Err(error):
			print_error(error)
			False
		Ok(compiler):
			var passed = 0
			var failed = 0

			for group in [
				TestEntry.suite(compiler),
				CurrentDirectory.suite(compiler),
				StoredCallables.suite(compiler),
				Ufcs.suite(compiler),
				Traits.suite(compiler),
				TraitBounds.suite(compiler),
				OwnedPrefix.suite(compiler),
				Match.suite(compiler),
				ResultPropagation.suite(compiler),
				SourceWhile.suite(compiler),
				ValueIf.suite(compiler),
				SourceLoops.suite(compiler),
				StructuralPatterns.suite(compiler),
				Bindings.suite(compiler),
				BindingNames.suite(compiler),
				Syntax.suite(compiler),
				UnsupportedSyntax.suite(compiler),
				Generics.suite(compiler),
				Imports.suite(compiler),
				Effects.suite(compiler),
				MainSignatures.suite(compiler),
				OptionInput.suite(compiler),
				ArgumentInput.suite(compiler),
				Lists.suite(compiler),
				NamespaceAliases.suite(compiler),
				Calculator.suite(compiler),
				Frontend.suite(),
			]:
				result = run_suite_result(group)
				passed += result[0]
				failed += result[1]

			print("E2e cases: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
			failed == 0


tests: TestSuite = {
	description = "Blorp end to end",
	tests = [("build once and run every fixture group", run_end_to_end)]
}
