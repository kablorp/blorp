import:
    io: print
record Entry { count: Int, text: String }
union Message:
    Empty
    Wrapped(Entry)
pure func make() -> Message:
    Wrapped({ count = 7, text = 42.to_string() })
pure func read(value: Message) -> Entry:
    match value:
        Empty: { count = 0, text = "empty" }
        Wrapped(entry): entry
func main() -> Void:
    entry = read(make())
    print(entry.count.to_string())
    print(entry.text)
