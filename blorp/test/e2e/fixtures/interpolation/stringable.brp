import:
    io: print


record Point {
    x: Int,
    y: Int,
}


implements Stringable for Point:
    pure func to_string(value: Self) -> String:
        "(${value.x}, ${value.y})"


pure func bracketed[Value: Stringable](value: Value) -> String:
    "<${value}>"


func main() -> Int:
    count = 3
    ratio = 0.5
    flag: Bool = False
    point: Point = { x = 1, y = -2 }
    print("${count} items, ratio ${ratio}, ${flag}")
    print("${"already a String"} and ${7}")
    print("at ${point}")
    print("${bracketed(point)} ${bracketed(count)} ${bracketed("text")}")
    0
