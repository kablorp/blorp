import:
    path: dirname
    list: get
    string: add
    io: print

pure func parent(path: String) -> String:
    dirname(path)

pure func escaped_parent() -> String:
    dirname(add("a\0b/", "c"))

func main(arguments: List[String]) -> Int:
    match get(arguments, 1):
        Some(path):
            print(parent(path))
            0
        None:
            print(dirname("a\0b/c"))
            print("a\0b//c//".dirname())
            print(dirname("\0/leaf"))
            source = add("é/树/", "leaf///")
            selected = dirname(source)
            kept_parent = selected
            print(selected)
            print(kept_parent)
            print(source)
            print(escaped_parent())
            0
