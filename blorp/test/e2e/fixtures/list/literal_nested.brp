import:
    list: length, get
    io: print
pure func inner_length(values: List[List[Int]], index: Int) -> Int:
    match values.get(index):
        Some(inner): inner.length()
        None: -1
func main() -> Void:
    values = [[1, 2], [], [3]]
    print(values.length().to_string())
    print(inner_length(values, 0).to_string())
    print(inner_length(values, 1).to_string())
    print(inner_length(values, 2).to_string())
