import:
    list: length, get, append, concat
    io: print
pure func first(values: List[Int]) -> Int:
    match values.get(0):
        Some(value): value
        None: -1
func main() -> Void:
    print([1, 2].append(3).length().to_string())
    print(first([7]).to_string())
    print(concat([1], [2, 3]).length().to_string())
