import:
    list: take, remove, repeat
    io: print
pure func at(values: List[Int], index: Int) -> Int:
    match values.get(index):
        Some(value): value
        None: -1
func show(result: Option[List[Int]]) -> Void:
    match result:
        None: print("none")
        Some(values):
            print(values.length().to_string())
            print(at(values, 126).to_string())
            print(at(values, 127).to_string())
            print(at(values, 254).to_string())
            print(at(values, 255).to_string())
func main() -> Void:
    original = repeat(7, 256)
    show(Some(original.take(255)))
    show(original.remove(127))
    show(original.remove(255))
    print(original.length().to_string())
    print(at(original, 255).to_string())
