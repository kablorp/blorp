import:
    list: take, remove, repeat
    io: print
func show(result: Option[List[Void]]) -> Void:
    match result:
        None: print("none")
        Some(values):
            print(values.length().to_string())
            match values.get(0):
                Some(_): print("present")
                None: print("empty")
func main() -> Void:
    original = repeat(void, 3)
    show(Some(original.take(2)))
    show(original.remove(1))
    show([void].remove(0))
    show([void].remove(-1))
    show(original.remove(3))
    show(Some(original.take(0)))
    show(Some(original))
