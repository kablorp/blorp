import:
    list: List methods
    string: String methods


private pure func shown(values: List[Int]) -> String:
    values
        .map(pure func(value: Int) -> String: value.to_string())
        .join(",")


private func show_slice(values: List[Int], start: Int, end: Int) -> Void:
    print("slice(${start}, ${end}): [${values.slice(start, end).shown()}]")


private func show_starts_with(values: List[Int], prefix: List[Int]) -> Void:
    print("[${values.shown()}] starts_with [${prefix.shown()}]: ${values.starts_with(prefix)}")


private pure func shown_index(index: Option[Int]) -> String:
    match index:
        Some(position): "Some(${position})"
        None: "None"


private func show_index_of(values: List[Int], needle: Int) -> Void:
    print("index_of(${needle}): ${values.index_of(needle).shown_index()}")


private func show_less(left: List[Int], right: List[Int]) -> Void:
    print("[${left.shown()}] < [${right.shown()}]: ${left < right}")


func main() -> Int:
    values = [10, 20, 30, 40, 50]
    empty: List[Int] = []
    show_slice(values, 1, 3)
    show_slice(values, 0, 5)
    show_slice(values, -4, 2)
    show_slice(values, 3, 99)
    show_slice(values, 4, 2)
    show_slice(values, 7, 9)
    show_slice(values, 2, 2)
    show_slice(empty, 0, 3)
    print("words: ${["a", "b", "c"].slice(1, 3).join("+")}")
    show_starts_with(values, [10, 20])
    show_starts_with(values, values)
    show_starts_with(values, empty)
    show_starts_with(empty, empty)
    show_starts_with(empty, [10])
    show_starts_with(values, [10, 21])
    show_starts_with(values, [10, 20, 30, 40, 50, 60])
    show_starts_with(values, [20])
    show_index_of(values, 10)
    show_index_of(values, 50)
    show_index_of([7, 7, 7], 7)
    show_index_of(values, 99)
    show_index_of(empty, 1)
    print("nested: ${[[1], [2, 3]].index_of([2, 3]).shown_index()}")
    show_less([1, 2], [1, 3])
    show_less([1, 3], [1, 2])
    show_less([1, 2], [1, 2])
    show_less([1], [1, 2])
    show_less([1, 2], [1])
    show_less(empty, [0])
    show_less(empty, empty)
    show_less([2], [1, 9])
    print("ge: ${[1, 2] >= [1, 2]} ${[1] >= [1, 2]} gt: ${[1, 3] > [1, 2]} le: ${[1] <= [1, 2]}")
    print("floats: ${[1.5] < [1.5, 0.5]} ${[0.5, 9.0] < [1.5]} ${[1.5, 0.5] < [1.5]}")
    0
