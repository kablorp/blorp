import:
    int: Int methods
    io: print
    list: map, filter, reverse, any, all, find, take, drop, remove, join, sort_by, append
    string: String methods


record Item {
    key: Int,
    tag: Int,
}


-- Values 0, 5, 3, 1, 6, 4, 2, 0, 5 ...: repeats from length 8 on, so the keys
-- built from them collide and a sort must keep the earlier tag first.
pure func numbers(count: Int) -> List[Int]:
    var values: List[Int] = []
    for index in 0..count:
        values = values.append((index * 5) % 7)
    values


pure func items(values: List[Int]) -> List[Item]:
    var found: List[Item] = []
    var tag = 0
    for value in values:
        found = found.append({ key = value % 3, tag = tag })
        tag = tag + 1
    found


pure func text(value: Int) -> String:
    value.to_string()


pure func render(values: List[Int]) -> String:
    (
        "["
        + values
            .map(text)
            .join(",")
        + "]"
    )


pure func render_items(values: List[Item]) -> String:
    (
        "["
        + values
            .map(pure func(item: Item): item.key.to_string() + ":" + item.tag.to_string())
            .join(" ")
        + "]"
    )


pure func render_removed(removed: Option[List[Int]]) -> String:
    match removed:
        Some(values): render(values)
        None: "none"


pure func render_found(found: Option[Int]) -> String:
    match found:
        Some(value): value.to_string()
        None: "none"


pure func truth(value: Bool) -> String:
    match value:
        True: "true"
        False: "false"


pure func is_odd(value: Int) -> Bool:
    value % 2 == 1


pure func add_one(value: Int) -> Int:
    value + 1


pure func above_four(value: Int) -> Bool:
    value > 4


pure func below_five(value: Int) -> Bool:
    value < 5


pure func above_two(value: Int) -> Bool:
    value > 2


pure func item_key(item: Item) -> Int:
    item.key


func show(count: Int) -> Void:
    values = numbers(count)
    print(
        (
            count.to_string()
            + " "
            + render(values)
            + " map "
            + render(values.map(add_one))
            + " filter "
            + render(values.filter(is_odd))
        ),
    )
    print(
        (
            "  reverse "
            + render(values.reverse())
            + " take "
            + render(values.take(3))
            + " drop "
            + render(values.drop(3))
        ),
    )
    print(
        (
            "  remove "
            + render_removed(values.remove(2))
            + " last "
            + render_removed(values.remove(count - 1))
            + " past "
            + render_removed(values.remove(count))
        ),
    )
    print(
        (
            "  any "
            + truth(values.any(above_four))
            + " all "
            + truth(values.all(below_five))
            + " find "
            + render_found(values.find(above_two))
        ),
    )
    print("  sort " + render_items(items(values).sort_by(item_key)))


func main() -> Int:
    for count in [0, 1, 2, 3, 4, 5, 8, 9]:
        show(count)
    0
