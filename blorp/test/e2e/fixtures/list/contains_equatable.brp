import:
    list as Lists
    int as IntOps
    string as StringOps
    float as FloatOps
    io: print

record Point { value: Int }
record Tagged { tag: Int, detail: Int }

implements Equatable for Tagged:
    pure func equals(left: Self, right: Self) -> Bool:
        IntOps.equals(left.tag, right.tag)

pure func is_seven(value: Int) -> Bool:
    IntOps.equals(value, 7)

pure func member[Element: Equatable](values: List[Element], needle: Element) -> Bool:
    Lists.contains(values, needle)

func produce_needle() -> Int:
    print("needle")
    7

func main() -> Int:
    first: Point = { value = 7 }
    same: Point = { value = 7 }
    tagged: Tagged = { tag = 7, detail = 1 }
    same_tag: Tagged = { tag = 7, detail = 9 }
    nested: List[List[Int]] = [[1, 2], [3]]
    empty_left: List[Int] = []
    empty_right: List[Int] = []
    infinity = FloatOps.multiply(1.0e308, 1.0e308)
    nan = FloatOps.subtract(infinity, infinity)
    equal_text: pure (String, String) -> Bool = IntOps.equals
    different_int: pure (Int, Int) -> Bool = StringOps.not_equals
    found_once = Lists.contains([7, 9], produce_needle())
    results = [
        member([1, 7], 7),
        Lists.contains(["first", "kept"], "kept"),
        Lists.contains([first], same),
        Lists.contains([tagged], same_tag),
        Lists.contains(nested, [1, 2]),
        Lists.any([7], is_seven),
        IntOps.not_equals(Lists.any([9], is_seven), True),
        IntOps.equals("family", "family"),
        StringOps.equals(7, 7),
        FloatOps.is_nan(nan),
        FloatOps.not_equals(nan, nan),
        found_once,
        equal_text("stored", "stored"),
        different_int(7, 9),
        IntOps.equals(empty_left, empty_right),
        IntOps.not_equals([1], [1, 2]),
        IntOps.not_equals([1, 2], [9, 2]),
        IntOps.not_equals([1, 2], [1, 9]),
        IntOps.not_equals(Lists.contains(nested, [1, 9]), True),
    ]
    match results:
        [True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True]: 23
        _: 0
