import:
    list: take, remove
    io: print
record Entry { text: String, children: List[String] }
pure func entries() -> List[Entry]:
    text = 42.to_string().add("é\0")
    repeated: Entry = { text = text, children = [text, text] }
    [repeated, repeated, { text = 7.to_string(), children = [7.to_string()] }]
pure func text_at(values: List[Entry], index: Int) -> String:
    match values.get(index):
        Some(entry): entry.text
        None: "missing"
pure func child(values: List[Entry]) -> String:
    match values.get(0):
        None: "no-entry"
        Some(entry):
            match entry.children.get(1):
                Some(text): text
                None: "no-child"
pure func escaped_take() -> List[Entry]:
    entries().take(2)
pure func escaped_remove() -> Option[List[Entry]]:
    entries().remove(1)
func show(values: List[Entry]) -> Void:
    print(values.length().to_string())
    print(text_at(values, 0))
    print(text_at(values, 1))
    print(child(values))
func show_removed(result: Option[List[Entry]]) -> Void:
    match result:
        Some(values): show(values)
        None: print("none")
func main() -> Void:
    original = entries()
    taken = original.take(2)
    removed = original.remove(1)
    show(original)
    show(taken)
    show_removed(removed)
    show(escaped_take())
    show_removed(escaped_remove())
