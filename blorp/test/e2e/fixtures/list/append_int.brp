import:
    list: repeat, length, get, append
    io: print
pure func element(values: List[Int], index: Int) -> Int:
    match values.get(index):
        Some(value): value
        None: -1
func show(values: List[Int]) -> Void:
    print(values.length().to_string())
    print(element(values, 0).to_string())
    print(element(values, 2).to_string())
func main() -> Void:
    empty = repeat(0, 0)
    one = empty.append(7)
    three = one.append(8).append(9)
    show(empty)
    show(one)
    show(three)
