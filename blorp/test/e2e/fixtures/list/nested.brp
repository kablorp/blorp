import:
    list: repeat, get
    int: to_string
    io: print
pure func select_inner(value: Option[List[String]]) -> Option[String]:
    match value:
        Some(values): values.get(1)
        None: None
pure func selected_text(value: Option[String]) -> String:
    match value:
        Some(text): text
        None: "missing"
pure func escaped_text() -> String:
    outer = repeat(repeat(to_string(42), 2), 2)
    selected_text(select_inner(outer.get(1)))
func main() -> Void:
    print(escaped_text())
