import:
    list: find, all, reverse, drop, repeat
    int as IntOps
    io: print
pure func even(value: Int) -> Bool:
    IntOps.equals(IntOps.remainder(value, 2), 0)
pure func positive(value: Int) -> Bool:
    IntOps.greater_than(value, 0)
pure func unit(value: Void) -> Bool:
    True
pure func no_unit(value: Void) -> Bool:
    False
pure func forwarded_find[T](values: List[T], predicate: pure (T) -> Bool) -> Option[T]:
    find(values, predicate)
pure func forwarded_all[T](values: List[T], predicate: pure (T) -> Bool) -> Bool:
    values.all(predicate)
func show(result: Option[Int]) -> Void:
    match result:
        Some(value): print(value.to_string())
        None: print("none")
func truth(value: Bool) -> Void:
    match value:
        True: print("true")
        False: print("false")
func presence(value: Option[Void]) -> Void:
    match value:
        Some(_): print("unit-some")
        None: print("unit-none")
func main() -> Void:
    empty: List[Int] = []
    show(find([8, 3, 6, 2], even))
    show([1, 3, 6, 2].find(even))
    show(forwarded_find([1, 3, 6, 2], even))
    show([1, 3, 5].find(even))
    show([2].find(even))
    show([1].find(even))
    show(empty.find(even))
    truth(all(empty, positive))
    truth([1].all(positive))
    truth([0].all(positive))
    truth([1, 2, 3, 4].all(positive))
    truth([0, 2, 3, 4].all(positive))
    truth([1, 2, 3, 0].all(positive))
    truth(forwarded_all([1, 2, 3], positive))
    presence(forwarded_find([void, void], unit))
    presence([void].find(no_unit))
    presence(repeat(void, 0).find(unit))
    truth(forwarded_all([void, void], unit))
    truth([void].all(no_unit))
    truth(repeat(void, 0).all(no_unit))
    presence([void, void].drop(1).reverse().find(unit))
    print([void, void].reverse().length().to_string())
