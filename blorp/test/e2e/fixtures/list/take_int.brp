import:
    list: take
    int: INT_MIN, INT_MAX
    io: print
pure func at(values: List[Int], index: Int) -> Int:
    match values.get(index):
        Some(value): value
        None: -1
func show(values: List[Int]) -> Void:
    print(values.length().to_string())
    print(at(values, 0).to_string())
    print(at(values, 1).to_string())
    print(at(values, 2).to_string())
    print(at(values, 3).to_string())
    print(at(values, 4).to_string())
func main() -> Void:
    values = [0, 10, 20, 30, 40]
    show(take(values, INT_MIN))
    show(values.take(-1))
    show(values.take(0))
    show(values.take(1))
    show(values.take(3))
    show(values.take(4))
    show(values.take(5))
    show(values.take(INT_MAX))
    empty: List[Int] = []
    show(empty.take(1))
    show(values)
