trait Pick:
    pure func pick(value: Self, _: Int, _: String) -> Int


implements Pick for Int:
    pure func pick(value: Self, _: Int, _: String) -> Int:
        value


pure func second(_: Int, value: Int, _: Int) -> Int:
    value


-- The argument is never called, so a function-typed discard is still just a
-- discard.
pure func apply(_: (Int) -> Int, value: Int) -> Int:
    value


pure func double(value: Int) -> Int:
    value * 2


func main() -> Int:
    second(1, 2, 3) + 4.pick(5, "six") + apply(double, 3) + apply(pure func(x): x, 5)
