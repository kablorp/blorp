import:
    int: add, subtract, equals, to_string
    io: print
    list: get
    string: parse_int
@tail_recursive
pure func count(remaining: Int, total: Int) -> Int:
    match equals(remaining, 0):
        True: total
        False: count(subtract(remaining, 1), add(total, 1))
func report(iterations: Int) -> Int:
    print(to_string(count(iterations, 0)))
    0
func parsed(value: Option[Int]) -> Int:
    match value:
        Some(iterations): report(iterations)
        None: 1
func argument(value: Option[String]) -> Int:
    match value:
        Some(text): parsed(parse_int(text))
        None: report(1000000)
func main(args: List[String]) -> Int:
    argument(get(args, 1))
