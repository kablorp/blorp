import:
    int as int_ops


func bound(label: String, value: Int) -> Int:
    print(label)
    value


func items() -> List[Int]:
    print("items")
    [1, 2, 3]


func main() -> Void:
    var total: Int = 0
    empty: List[Int] = []
    for item in empty:
        total = int_ops.add(total, item)
    print(total.to_string())
    for item in 0..0:
        total = int_ops.add(total, 100)
    print(total.to_string())
    for item in 3..3:
        total = int_ops.add(total, 100)
    print(total.to_string())
    for item in 3..1:
        total = int_ops.add(total, 100)
    print(total.to_string())
    -- Both bounds run once, low before high; the upper bound is excluded.
    for item in bound("low", 1)..bound("high", 3):
        print(item.to_string())
    for item in items():
        total = int_ops.add(total, item)
    print(total.to_string())
    var reset: Int = 0
    for outer in 0..2:
        for inner in [1, 2]:
            reset = int_ops.add(reset, inner)
    print(reset.to_string())
    var controlled: Int = 0
    for outer in [1, 2]:
        for inner in 0..4:
            if int_ops.equals(inner, 0):
                continue
            match int_ops.equals(inner, 2):
                True: break
                False: void
            controlled = int_ops.add(controlled, int_ops.add(int_ops.multiply(outer, 10), inner))
            print("inner")
        -- Inner break must still run this suffix and the second outer turn.
        controlled = int_ops.add(controlled, 100)
        print("outer")
    print(controlled.to_string())
