import:
    int as IntOps
    io: print

func main() -> Void:
    var total: Int = 0
    for _ in 0..1:
        for _ in 0..1:
            for _ in 0..1:
                for _ in 0..1:
                    for _ in 0..1:
                        for _ in 0..1:
                            for _ in 0..1:
                                for _ in 0..1:
                                    for _ in 0..1:
                                        for _ in 0..1:
                                            for _ in 0..1:
                                                for _ in 0..1:
                                                    for _ in 0..1:
                                                        for _ in 0..1:
                                                            for _ in 0..1:
                                                                for _ in 0..1:
                                                                    for _ in 0..1:
                                                                        for _ in 0..1:
                                                                            for _ in 0..1:
                                                                                for _ in 0..1:
                                                                                    for _ in 0..1:
                                                                                        for _ in 0..1:
                                                                                            for _ in 0..1:
                                                                                                for _ in 0..1:
                                                                                                    for _ in 0..1:
                                                                                                        for _ in 0..1:
                                                                                                            for _ in 0..1:
                                                                                                                for _ in 0..1:
                                                                                                                    for _ in 0..1:
                                                                                                                        for _ in 0..1:
                                                                                                                            for _ in 0..1:
                                                                                                                                for _ in 0..1:
                                                                                                                                    total = IntOps.add(total, 1)
    print(total.to_string())
