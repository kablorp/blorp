import:
    list: get
    path: Path, parent, to_path


pure func parent_of(path: Path) -> Path:
    parent(path)


-- Exit 2 when the argument is no path, with the reason.
func main(arguments: List[String]) -> Int:
    match get(arguments, 1):
        Some(text):
            match to_path(text):
                Ok(path):
                    print("${parent_of(path)}")
                    0
                Err(error):
                    print("${error}")
                    2
        None:
            match to_path("é/树/leaf///"):
                Ok(source):
                    selected = parent(source)
                    kept_parent = selected
                    print("${selected}")
                    print("${kept_parent}")
                    print("${source}")
                    print("${source.parent().parent()}")
                    0
                Err(_):
                    2
