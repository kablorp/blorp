-- A variant written through its union needs no annotation and no variant import.
union ReadError:
    NotFound
    OtherOs(Int)


DEFAULT_ERROR: ReadError = ReadError.NotFound


pure func code(result: Result[String, ReadError]) -> Int:
    match result:
        Err(ReadError.NotFound): 1
        Err(ReadError.OtherOs(number)): number
        Ok(_): 0


func main() -> Int:
    missing = ReadError.NotFound
    first = code(Err(missing))
    second = code(Err(ReadError.OtherOs(4)))
    first + second + code(Ok("fine")) + code(Err(DEFAULT_ERROR)) - 1
