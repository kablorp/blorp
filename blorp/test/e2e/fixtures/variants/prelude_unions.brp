-- Generic unions take their arguments from the expected type, not from the name.
union Kind:
    Plain
    Counted(Int)


implements Stringable for Kind:
    pure func to_string(value: Self) -> String:
        match value:
            Kind.Plain: "plain"
            Kind.Counted(count): "counted ${count}"


pure func unwrap(value: Option[Int]) -> Int:
    match value:
        Option.Some(inner): inner
        Option.None: 0


pure func settle(result: Result[Int, String]) -> Int:
    match result:
        Result.Ok(value): value
        Result.Err(_): -1


func main() -> Void:
    present: Option[Int] = Option.Some(3)
    absent: Option[Int] = Option.None
    print("${Kind.Plain} ${Kind.Counted(2)}")
    print("${unwrap(present)} ${unwrap(absent)}")
    print("${settle(Result.Ok(5))} ${settle(Result.Err("no"))}")
