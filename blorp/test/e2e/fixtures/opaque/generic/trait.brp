import:
    io: print


-- Pair's automatic equality compares both fields. Box's written equality
-- compares only the key, so boxes whose notes differ can still be equal.
record Pair[T] { key: T, note: String }


opaque type Box[T] = Pair[T]


implements Equatable for Box[T: Equatable]:
    pure func equals(left: Self, right: Self) -> Bool:
        from_opaque Box(left).key == from_opaque Box(right).key


trait Described:
    pure func describe(value: Self) -> String


implements Described for Int:
    pure func describe(value: Self) -> String:
        value.to_string()


implements Described for Box[T: Described]:
    pure func describe(value: Self) -> String:
        "box of ${from_opaque Box(value).key.describe()}"


pure func boxed[T](key: T, note: String) -> Box[T]:
    into_opaque Box({ key = key, note = note })


pure func digit(value: Bool) -> String:
    if value:
        "1"
    else:
        "0"


-- Rows: `==` on Box[Int] and on Box[String], each with an equal key under a
-- different note and then a different key; then describe through UFCS at
-- Box[Int] and Box[Box[Int]].
func main() -> Int:
    one = boxed(1, "first")
    print("${digit(one == boxed(1, "second"))}${digit(one == boxed(2, "first"))}")
    word = boxed("key", "first")
    print("${digit(word == boxed("key", "second"))}${digit(word == boxed("other", "first"))}")
    print(one.describe())
    print(boxed(one, "outer").describe())
    0
