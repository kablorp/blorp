import:
    io/error: IOError
    io/fs: default_if_not_found
    ./fs: answer


-- The user's ./fs and the library's io/fs share the stem fs, and both load.
func main() -> Int:
    read: Result[String, IOError] = Ok("ab")
    match default_if_not_found(read, ""):
        Ok(text): answer() + text.length()
        Err(_): 0
