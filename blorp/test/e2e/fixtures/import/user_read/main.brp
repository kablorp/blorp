import:
    io/fs/read: ReadError, read_text
    path: Path, to_path
    ./read: answer


-- The user's ./read and the library's io/fs/read share the stem read, and both
-- load. A missing file stands in for the value to fall back from.
func main() -> Int:
    match "/blorp-no-such-file".to_path():
        Ok(path):
            match path.read_text():
                Err(ReadError.NotFound): answer() + 2
                _: 0
        Err(_):
            0
