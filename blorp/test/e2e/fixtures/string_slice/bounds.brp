import:
    string: parse_int, slice
    list: get
    io: print

func main(arguments: List[String]) -> Int:
    match get(arguments, 1):
        None: 2
        Some(start_text):
            match parse_int(start_text):
                None: 2
                Some(start):
                    match get(arguments, 2):
                        None: 2
                        Some(end_text):
                            match parse_int(end_text):
                                None: 2
                                Some(end):
                                    text_to_print = match slice("Aé🙂\0Z", start, end):
                                        Some(text): text
                                        None: "none"
                                    print(text_to_print)
                                    0
