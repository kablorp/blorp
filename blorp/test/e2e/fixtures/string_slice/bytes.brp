import:
    string: slice
    io: print

func show(value: String, start: Int, end: Int) -> Void:
    match slice(value, start, end):
        Some(text): print(text)
        None: print("none")

func main() -> Int:
    show("é世🙂", 2, 5)
    show("é世🙂", 5, 9)
    show("\u{80}\u{BF}", 0, 2)
    show("\u{80}\u{BF}", 2, 4)
    show("e\u{301}\u{FEFF}\r\n", 0, 3)
    show("e\u{301}\u{FEFF}\r\n", 3, 6)
    show("e\u{301}\u{FEFF}\r\n", 6, 8)
    show("Aé🙂\0Z", 7, 8)
    show("é", 1, 1)
    0
