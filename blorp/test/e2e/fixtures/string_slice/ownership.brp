import:
    string: add, slice
    io: print

pure func escaped_text() -> String:
    source = add("Aé", "🙂\0Z")
    match slice(source, 1, 7):
        Some(text): text
        None: "none"

func main() -> Int:
    source = add("Aé", "🙂\0Z")
    selected = slice(source, 1, 7)
    kept_option = selected
    ignored_some = slice(source, 0, 0)
    ignored_none = slice(source, 2, 2)
    match selected:
        Some(text): print(text)
        None: print("none")
    match kept_option:
        Some(text): print(text)
        None: print("none")
    print(source)
    print(escaped_text())
    0
