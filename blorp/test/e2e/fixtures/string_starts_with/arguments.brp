import:
    string: starts_with
    list: get
    io: print

pure func matches_prefix(value: String, prefix: String) -> Bool:
    starts_with(value, prefix)

func print_truth(value: Bool) -> Void:
    match value:
        True: print("1")
        False: print("0")

func main(arguments: List[String]) -> Int:
    match get(arguments, 1):
        None: 2
        Some(value):
            match get(arguments, 2):
                None: 2
                Some(prefix):
                    print_truth(matches_prefix(value, prefix))
                    print_truth(value.starts_with(prefix))
                    0
