import:
    io: print


-- A program that calls only process.fault must build as valid C under -Werror.
-- The native aborts, so this run never reaches it: the process suite's probe
-- shows the abort and its message.
func fault_native(message: String) -> Result[Void, Int]:
    builtin("process.fault")


func main(arguments: List[String]) -> Int:
    if arguments.length() > 1:
        match fault_native(arguments.get_or(1, "")):
            Ok(_): print("returned")
            Err(code): print(code.to_string())
    print("not called")
    0
