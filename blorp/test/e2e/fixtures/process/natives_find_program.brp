-- A program that calls only process.find_program must build as valid C under
-- -Werror, although it uses none of the process helpers' functions. An empty
-- name is NotOnPath, tag 7, without a search.
func find_program_native(name: String) -> Result[String, Int]:
    builtin("process.find_program")


func main() -> Int:
    match find_program_native(""):
        Ok(path):
            print(path)
            1
        Err(code):
            print(code.to_string())
            0
