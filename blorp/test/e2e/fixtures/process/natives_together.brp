-- The three process natives share PROCESS_HELPERS_RUNTIME, which a program
-- calling all of them must define once. None starts a program: run_to_files
-- rejects a zero timeout, capture a missing program, find_program an empty name.
func run_to_files_native(
    program: String,
    arguments: List[String],
    stdout_path: String,
    stderr_path: String,
    timeout_ms: Int,
) -> Result[Int, String]:
    builtin("process.run_to_files")


func capture_native(
    program: String,
    arguments: List[String],
    directory: List[String],
    environment: List[String],
    stdin: List[String],
    timeout_ms: Int,
) -> Result[List[String], Int]:
    builtin("process.capture")


func find_program_native(name: String) -> Result[String, Int]:
    builtin("process.find_program")


func main() -> Int:
    match run_to_files_native("/nonexistent/blorp-program", [], "out", "err", 0):
        Ok(_): print("started")
        Err(message): print(message)
    match capture_native("/nonexistent/blorp-program", [], [], [], [], -1):
        Ok(_): print("started")
        Err(code): print(code.to_string())
    match find_program_native(""):
        Ok(path): print(path)
        Err(code): print(code.to_string())
    0
