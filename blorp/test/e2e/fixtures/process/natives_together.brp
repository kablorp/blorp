-- The three process natives share PROCESS_HELPERS_RUNTIME, which a program
-- calling all of them must define once. None starts a program: capture is
-- given a missing one and find_program an empty name, and fault is called only
-- with an argument, which this run does not pass.
func capture_native(
    program: String,
    arguments: List[String],
    directory: List[String],
    environment: List[String],
    stdin: List[String],
    timeout_ms: Int,
) -> Result[List[String], Int]:
    builtin("process.capture")


func find_program_native(name: String) -> Result[String, Int]:
    builtin("process.find_program")


func fault_native(message: String) -> Result[Void, Int]:
    builtin("process.fault")


func main(arguments: List[String]) -> Int:
    match capture_native("/nonexistent/blorp-program", [], [], [], [], -1):
        Ok(_): print("started")
        Err(code): print(code.to_string())
    match find_program_native(""):
        Ok(path): print(path)
        Err(code): print(code.to_string())
    if arguments.length() > 1:
        match fault_native(arguments.get_or(1, "")):
            Ok(_): print("returned")
            Err(code): print(code.to_string())
    0
