import:
    int: INT_MIN, INT_MAX


-- Each row is one result per operator, in the order + - * / %, then the
-- negation of the left operand.
pure func ints(left: Int, right: Int) -> String:
    "${(left + right)} ${(left - right)} ${(left * right)} ${(left / right)} ${(left % right)} ${(-left)}"


pure func floats(left: Float, right: Float) -> String:
    "${(left + right)} ${(left - right)} ${(left * right)} ${(left / right)} ${(left % right)} ${(-left)}"


-- The same six operators through trait bounds; callers spell the results.
pure func generic[Value: Addable + Subtractable + Multipliable + Divisible + Modulable + Negatable](
    left: Value,
    right: Value,
) -> List[Value]:
    [left + right, left - right, left * right, left / right, left % right, -left]


pure func twice[Value: Addable](value: Value) -> Value:
    value + value


-- Marker's members return values no rewrite could produce: `low - high` is
-- `10 * low + high`, while `low + -high` would be 0 - 2 = -2.
record Marker {
    value: Int,
}


implements Subtractable for Marker:
    pure func subtract(left: Self, right: Self) -> Self:
        { value = left.value * 10 + right.value }


implements Addable for Marker:
    pure func add(left: Self, right: Self) -> Self:
        { value = 0 }


implements Negatable for Marker:
    pure func negate(value: Self) -> Self:
        { value = -2 }


-- Rows: Int at concrete types with a positive and a negative dividend, and
-- through the bounds; Float likewise; Int wrapping, zero divisors and the
-- INT_MIN / -1 pair; negative zero; precedence and associativity; String `+`
-- directly and through a bound; Marker's subtract.
func main() -> Int:
    print(ints(7, 2))
    print(ints(-7, 2))
    print(
        generic(7, 2)
            .map(pure func(value: Int): value.to_string())
            .join(" "),
    )
    print(floats(7.5, 2.0))
    print(floats(-7.5, 2.0))
    print(
        generic(7.5, 2.0)
            .map(pure func(value: Float): value.to_string())
            .join(" "),
    )
    print("${(INT_MAX + 1)} ${(INT_MIN - 1)} ${(INT_MAX * 2)} ${(-INT_MIN)}")
    print("${(7 / 0)} ${(7 % 0)} ${(7.5 / 0.0)} ${(7.5 % 0.0)}")
    print("${(INT_MIN / -1)} ${(INT_MIN % -1)}")
    zero = 0.0
    print("${(-0.0)} ${(-zero)} ${(zero - zero)}")
    print("${(10 - 3 - 2)} ${(100 / 10 / 5)} ${(2 + 3 * 4)} ${(-2 * 3)} ${(17 % 5 * 2)}")
    print("a" + "b")
    print(twice("ab"))
    low: Marker = { value = 3 }
    high: Marker = { value = 4 }
    print("marker ${(low - high).value}")
    0
