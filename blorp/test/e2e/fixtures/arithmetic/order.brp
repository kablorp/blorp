import:
    io: print

func produced(label: String, value: Int) -> Int:
    print(label)
    value

-- Each operator evaluates its left operand, then its right, once each;
-- negation evaluates its operand once.
func main() -> Int:
    sum = produced("left", 1) + produced("right", 2)
    difference = produced("left", 5) - produced("right", 2)
    product = produced("left", 3) * produced("right", 2)
    quotient = produced("left", 7) / produced("right", 2)
    remainder = produced("left", 7) % produced("right", 2)
    negated = -produced("operand", 4)
    match [sum == 3, difference == 3, product == 6, quotient == 3, remainder == 1, negated == -4]:
        [True, True, True, True, True, True]: 23
        _: 0
