import:
    bool: and
    io: print
    int: Int methods
    list: List methods

-- The declarations state what a key needs; each function that names an
-- Index restates it.
private record IndexContents[K: Hashable + Equatable, V] { keys: List[K], values: List[V] }

opaque type Index[K: Hashable + Equatable, V] = IndexContents[K, V]

pure func empty_index[K: Hashable + Equatable, V]() -> Index[K, V]:
    no_keys: List[K] = []
    no_values: List[V] = []
    into_opaque Index({ keys = no_keys, values = no_values })

pure func insert[K: Hashable + Equatable, V](index: Index[K, V], key: K, value: V) -> Index[K, V]:
    contents: IndexContents[K, V] = from_opaque Index(index)
    into_opaque Index({ keys = contents.keys.append(key), values = contents.values.append(value) })

-- A key matches when its hash and its value both do.
pure func find[K: Hashable + Equatable, V](index: Index[K, V], key: K) -> Option[V]:
    contents: IndexContents[K, V] = from_opaque Index(index)
    var position = 0
    var found: Option[V] = None
    for candidate in contents.keys:
        if and(candidate.hash() == key.hash(), candidate == key):
            found = contents.values.get(position)
            break
        position = position.add(1)
    found

pure func describe(found: Option[String]) -> String:
    match found:
        Some(name): name
        None: "missing"

func main() -> Int:
    empty: Index[Int, String] = empty_index()
    index = empty.insert(3, "three").insert(7, "seven")
    print(describe(index.find(7)))
    print(describe(index.find(4)))
    print(describe(index.find(3)))
    0
