import:
    string: add, length
    int as IntOps
    io: print

pure func identity(value: String) -> String:
    value

pure func accumulate() -> String:
    var output = ""
    while IntOps.less_than(output.length(), 8):
        output = output.add("x")
    output

func main() -> Int:
    print(accumulate())
    prefix = "é\0"
    retained = identity(prefix)
    result = prefix.add("😀")
    print(retained)
    print(result)
    self = "same"
    print(self.add(self))
    0
