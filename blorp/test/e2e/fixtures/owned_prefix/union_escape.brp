pure func make() -> Option[String]:
    Some(42.to_string())
pure func selected_union(selected: Bool) -> Option[String]:
    owned = make()
    match selected:
        True: owned
        False: owned
func main(arguments: List[String]) -> Int:
    returned = selected_union(arguments.length().equals(1))
    match returned:
        Some(text): text.length()
        None: 0
