union Either[A, B]:
    Left(A)
    Right(B)
record Envelope { payload: Either[Void, String] }
pure func choose(arguments: List[String]) -> Either[Void, String]:
    match arguments.get(1):
        Some(text): Right(text)
        None: Left(void)
pure func wrap(value: Either[Void, String]) -> Envelope:
    { payload = value }
pure func observe_void(value: Void) -> Int:
    0
func main(arguments: List[String]) -> Int:
    parent = wrap(choose(arguments))
    projected = parent.payload
    match projected:
        Left(unit): observe_void(unit)
        Right(text): text.length()
