import:
    path: Path, join, to_path


pure func combine(base: Path, child: Path) -> Path:
    join(base, child)


-- The same Path as both operands, and operands that survive the call.
func main() -> Int:
    match (to_path("é-part"), to_path("a/b")):
        (Ok(segment), Ok(other)):
            print("${combine(segment, segment)}")
            print("${segment}")
            print("${combine(other, segment)}")
            print("${segment.join(other)}")
            0
        _:
            2
