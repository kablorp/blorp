import:
    io: print
    string: add

pure func values(text: String) -> (pure () -> String, List[String]):
    (pure func() -> String: text, [text])

func main() -> Int:
    original = values("cap".add("tured"))
    copy = original
    (callback, saved) = copy
    print(callback())
    for item in saved:
        print(item)
    match original:
        (other, [text]):
            print(other())
            print(text)
        _: print("wrong")
    0
