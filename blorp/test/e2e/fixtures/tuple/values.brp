import:
    io: print
    int: to_string

pure func first[A, B](value: (A, B)) -> A:
    value[0]

pure func nested() -> (Int, (Int, Int)):
    (1, (2, 3))

func main() -> Int:
    pair: (Int, String) = (1, "pair")
    triple: (Int, String, Bool) = (2, "triple", True)
    quad: (Int, String, Bool, Int) = (3, "quad", False, 4)
    print(pair[0].to_string())
    print(triple[0].to_string())
    print(quad[0].to_string())
    print(quad[3].to_string())
    print(first((5, "generic")).to_string())
    print(nested()[1][1].to_string())
    0
