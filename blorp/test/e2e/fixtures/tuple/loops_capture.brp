import:
    int as int_ops
    string: add


pure func capture(value: (String, List[String])) -> pure () -> String:
    pure func() -> String:
        value[0]


func values() -> List[(String, Int)]:
    print("values")
    [("first".add("!"), 1), ("second".add("!"), 2), ("third".add("!"), 3)]


func main() -> Int:
    callback = capture(("ke".add("pt"), ["saved".add("!")]))
    print(callback())
    var total = 0
    for (text, number) in values():
        if int_ops.equals(number, 2):
            continue
        print(text)
        total = int_ops.add(total, number)
        if int_ops.equals(number, 3):
            break
    print(total.to_string())
    0
