import:
    io: print
    int: to_string
    string: add

func effect(label: String) -> Void:
    print(label)

func number() -> Int:
    print("number")
    7

func subject() -> (Void, Int, Void, String):
    (effect("first"), number(), effect("third"), "last".add("!"))

func main() -> Int:
    value = subject()
    value[0]
    print(value[1].to_string())
    value[2]
    print(value[3])
    empty = (effect("empty-first"), effect("empty-second"))
    empty[1]
    print("done")
    0
