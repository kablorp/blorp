import:
    test: TestSuite
    io: print

private func first() -> Bool:
    print("first")
    False

private func second() -> Bool:
    print("second")
    True

private func third() -> Bool:
    print("third")
    False

tests: TestSuite = {
    description = "continued registration",
    tests = [("first case", first), ("second case", second), ("third case", third)]
}
