import:
    list: List methods
    int: Int methods
    string: String methods
    io: print

-- Each update below holds its operand's last owner, so emission calls the
-- operation's in-place helper. A helper the runtime does not define under
-- the name emission calls fails to link.
func main() -> Void:
    var numbers: List[Int] = [1]
    numbers = numbers.append(2)
    numbers = numbers.set(0, 3)
    numbers = numbers.concat([4, 5])
    var text = 6.to_string()
    text = text.add(" and ")
    text = text.append_int(7)
    print(numbers.length().to_string())
    print(text)
