import:
	bool: not, and, or
	io: print

pure func label(value: Bool) -> String:
	match value:
		True: "True"
		False: "False"

func probe(name: String, value: Bool) -> Bool:
	print(name)
	value

func main():
	print(label(not(True)))
	print(label(False.not()))
	print(label(and(False, False)))
	print(label(False.and(True)))
	print(label(and(True, False)))
	print(label(True.and(True)))
	print(label(or(False, False)))
	print(label(False.or(True)))
	print(label(or(True, False)))
	print(label(True.or(True)))
	conjoined = probe("and-left", False).and(probe("and-right", True))
	disjoined = probe("or-left", True).or(probe("or-right", False))
	chosen = match probe("match-left", False):
		True: probe("and-right", True)
		False: False
	void
