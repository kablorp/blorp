import:
    list: get
    path: Path, normalize, to_path


pure func cleaned(path: Path) -> Path:
    normalize(path)


-- Exit 2 when the argument is no path, with the reason.
func main(arguments: List[String]) -> Int:
    match get(arguments, 1):
        Some(text):
            match to_path(text):
                Ok(path):
                    print("${cleaned(path)}")
                    0
                Err(error):
                    print("${error}")
                    2
        None:
            match to_path("é/树/../🙂//./leaf/.."):
                Ok(source):
                    selected = normalize(source)
                    kept_result = selected
                    print("${selected}")
                    print("${kept_result}")
                    print("${source}")
                    print("${source.normalize().normalize()}")
                    0
                Err(_):
                    2
