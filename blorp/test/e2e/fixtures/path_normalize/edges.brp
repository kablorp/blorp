import:
    path: normalize
    list: get
    string: add
    io: print

pure func cleaned(path: String) -> String:
    normalize(path)

pure func escaped_normalized() -> String:
    normalize(add("a\0b/", "./c/.."))

func main(arguments: List[String]) -> Int:
    match get(arguments, 1):
        Some(path):
            print(cleaned(path))
            0
        None:
            print(normalize("a\0b//./c/.."))
            print("a\0b/../c".normalize())
            print(normalize("\0/../\0"))
            source = add("é/树/", "../🙂//./leaf/..")
            selected = normalize(source)
            kept_result = selected
            print(selected)
            print(kept_result)
            print(source)
            print(escaped_normalized())
            0
