-- A program that calls one native and nothing else from fs must still build
-- as valid C under -Werror, so this declares the builtin directly.
func remove_file_native(path: String) -> Result[Void, Int]:
    builtin("fs.remove_file")


func main() -> Int:
    match remove_file_native("/blorp-fs-no-such-path"):
        Ok(_):
            print("removed")
            1
        Err(code):
            print(code.to_string())
            0
