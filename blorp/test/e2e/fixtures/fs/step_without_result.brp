import:
    io/fs/read: ReadError, fold_lines
    path: to_path
    string: String methods


-- A step returns the new accumulator inside a Result, so that it can stop the
-- fold. This one returns the Int alone, as an earlier shape of fold_lines did.
pure func add_length(total: Int, line: String) -> Int:
    total + line.length()


func main() -> Int:
    match "settings.conf".to_path():
        Ok(path):
            match fold_lines(path, 0, add_length, pure func(error: ReadError) -> Int: 0):
                Ok(total): total
                Err(failure): failure
        Err(_):
            0
