import:
    io: print
    list: List methods
    option: Option methods


-- The three line natives, write_text and remove_file in one program, which
-- shows that their shared helpers are emitted once. The first argument is a
-- directory; the program writes one file there and removes it again, so a
-- second run starts as the first did. Each batch is printed with its length
-- and each element in brackets, until a batch has fewer than two elements, as
-- a fold would stop.
func open_native(path: String) -> Result[Int, Int]:
    builtin("fs.open_read")


func next_lines_native(descriptor: Int, carried: String) -> Result[List[String], Int]:
    builtin("fs.next_lines")


func close_native(descriptor: Int) -> Result[Void, Int]:
    builtin("fs.close")


func write_native(path: String, text: String) -> Result[Void, Int]:
    builtin("fs.write_text")


func remove_file_native(path: String) -> Result[Void, Int]:
    builtin("fs.remove_file")


private func show(label: String, result: Result[Void, Int]) -> Void:
    match result:
        Ok(_): print("${label}: ok")
        Err(code): print("${label}: ${code.to_string()}")


-- Every element but a batch's last is a complete line, and the last is
-- carried into the next call.
private func show_batches(descriptor: Int) -> Void:
    var carried = ""
    var reading: Bool = True
    while reading:
        match next_lines_native(descriptor, carried):
            Ok(batch):
                print("batch ${batch.length().to_string()}")
                for line in batch:
                    print("  [${line}]")
                carried = batch
                    .get(batch.length() - 1)
                    .get_or("")
                reading = batch.length() > 1
            Err(code):
                print("next_lines: ${code.to_string()}")
                reading = False
    void


func main(arguments: List[String]) -> Int:
    match arguments.get(1):
        None: 2
        Some(root):
            path = "${root}/fs_native_lines.txt"
            show("write_text", write_native(path, "first\r\nsecond\n\ncafé\nlast"))
            match open_native(path):
                Ok(descriptor):
                    show_batches(descriptor)
                    show("close", close_native(descriptor))
                    show("close", close_native(descriptor))
                Err(code): print("open_read: ${code.to_string()}")
            show("remove_file", remove_file_native(path))
            0
