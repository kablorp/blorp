import:
    io: print

-- A program that calls one native and nothing else from fs must still build
-- as valid C under -Werror, so this declares the builtin directly.
func read_native(path: String) -> Result[String, Int]:
    builtin("fs.read_text")

func main() -> Int:
    match read_native("/blorp-fs-no-such-path"):
        Ok(text):
            print(text)
            1
        Err(code):
            print(code.to_string())
            0
