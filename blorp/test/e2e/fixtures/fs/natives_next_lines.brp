-- A program that calls one native and nothing else from fs must still build
-- as valid C under -Werror, so this declares the builtin directly. Its only
-- List[String] is the batch's payload, so the payload alone must bring that
-- List's layout. A negative descriptor is refused as EBADF without a read,
-- so the program never touches stdin.
func next_lines_native(descriptor: Int, carried: String) -> Result[List[String], Int]:
    builtin("fs.next_lines")


func main() -> Int:
    match next_lines_native(-1, ""):
        Ok(_):
            print("read")
            1
        Err(code):
            print(code.to_string())
            0
