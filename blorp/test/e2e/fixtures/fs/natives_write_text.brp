import:
    io: print


-- A program that calls one native and nothing else from fs must still build
-- as valid C under -Werror, so this declares the builtin directly. An empty
-- path names no file, so the call fails before any operating system call.
func write_native(path: String, text: String) -> Result[Void, Int]:
    builtin("fs.write_text")


func main() -> Int:
    match write_native("", "text"):
        Ok(_):
            print("written")
            1
        Err(code):
            print(code.to_string())
            0
