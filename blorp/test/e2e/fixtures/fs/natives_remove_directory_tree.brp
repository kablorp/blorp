import:
    io: print


-- A program that calls one native and nothing else from fs must still build
-- as valid C under -Werror, so this declares the builtin directly. A missing
-- path is NotFound, and nothing is opened.
func remove_tree_native(path: String) -> Result[Void, Int]:
    builtin("fs.remove_directory_tree")


func main() -> Int:
    match remove_tree_native("/blorp-fs-no-such-path"):
        Ok(_):
            print("removed")
            1
        Err(code):
            print(code.to_string())
            0
