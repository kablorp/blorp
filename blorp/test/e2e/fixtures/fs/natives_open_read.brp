import:
    io: print
    list: get


-- A program that calls one native and nothing else from fs must still build
-- as valid C under -Werror, so this declares the builtin directly. The first
-- argument is a directory, and the path under it names nothing, so the open
-- is NotFound and no descriptor is left open.
func open_native(path: String) -> Result[Int, Int]:
    builtin("fs.open_read")


func main(arguments: List[String]) -> Int:
    match arguments.get(1):
        None:
            2
        Some(root):
            match open_native("${root}/blorp-fs-no-such-file"):
                Ok(_):
                    print("opened")
                    1
                Err(code):
                    print(code.to_string())
                    0
