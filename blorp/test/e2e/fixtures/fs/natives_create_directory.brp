import:
    io: print


-- A program that calls one native and nothing else from fs must still build
-- as valid C under -Werror, so this declares the builtin directly. An empty
-- path names nothing, so mkdir fails without creating anything.
func create_native(path: String) -> Result[Void, Int]:
    builtin("fs.create_directory")


func main() -> Int:
    match create_native(""):
        Ok(_):
            print("created")
            1
        Err(code):
            print(code.to_string())
            0
