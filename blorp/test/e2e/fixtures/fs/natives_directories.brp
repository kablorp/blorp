import:
    io: print
    list: get
    option: Option methods
    string: String methods


-- All eight directory natives and write_text in one program, which shows
-- that their shared helpers are emitted once. Each call prints its code, or
-- "ok"; the temporary directory's random name is never printed. The first
-- argument names a directory this program creates and removes again, so a
-- second run starts as the first did.
func list_native(path: String) -> Result[List[String], Int]:
    builtin("fs.list_directory")


func create_native(path: String) -> Result[Void, Int]:
    builtin("fs.create_directory")


func create_all_native(path: String) -> Result[Void, Int]:
    builtin("fs.create_directories")


func remove_file_native(path: String) -> Result[Void, Int]:
    builtin("fs.remove_file")


func remove_directory_native(path: String) -> Result[Void, Int]:
    builtin("fs.remove_directory")


func rename_native(source: String, destination: String) -> Result[Void, Int]:
    builtin("fs.rename")


func remove_tree_native(path: String) -> Result[Void, Int]:
    builtin("fs.remove_directory_tree")


func temporary_native(parent: String, prefix: String) -> Result[String, Int]:
    builtin("fs.create_temporary_directory")


func write_native(path: String, text: String) -> Result[Void, Int]:
    builtin("fs.write_text")


private func show(label: String, result: Result[Void, Int]) -> Void:
    match result:
        Ok(_): print("${label}: ok")
        Err(code): print("${label}: ${code.to_string()}")


-- Each element is the entry's code byte, then its name.
private func show_listing(path: String) -> Void:
    match list_native(path):
        Ok(entries):
            for entry in entries:
                code = entry
                    .byte_at(0)
                    .get_or(-1)
                name = entry
                    .slice(1, entry.length())
                    .get_or("")
                print("entry ${code.to_string()} ${name}")
            void
        Err(code):
            print("list: ${code.to_string()}")


func main(arguments: List[String]) -> Int:
    match arguments.get(1):
        None:
            2
        Some(root):
            show("create_directories", create_all_native("${root}/outer/inner"))
            show("create_directory", create_native("${root}/outer/inner"))
            show("rename", rename_native("${root}/outer/inner", "${root}/outer/renamed"))
            show_listing("${root}/outer")
            show("remove_file", remove_file_native("${root}/outer/renamed"))
            show("remove_directory", remove_directory_native("${root}/outer"))
            show("remove_directory", remove_directory_native("${root}/outer/renamed"))
            show("remove_directory", remove_directory_native("${root}/outer"))
            match temporary_native(root, "tree-"):
                Ok(temporary):
                    print("create_temporary_directory: ok")
                    show("create_directories", create_all_native("${temporary}/a/b"))
                    show("write_text", write_native("${temporary}/a/b/file", "text"))
                    show("remove_directory_tree", remove_tree_native(temporary))
                    show("remove_directory_tree", remove_tree_native(temporary))
                Err(code):
                    print("create_temporary_directory: ${code.to_string()}")
            show("remove_directory", remove_directory_native(root))
            0
