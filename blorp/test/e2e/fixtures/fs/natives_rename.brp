import:
    io: print


-- A program that calls one native and nothing else from fs must still build
-- as valid C under -Werror, so this declares the builtin directly. A missing
-- source fails before the destination is touched.
func rename_native(source: String, destination: String) -> Result[Void, Int]:
    builtin("fs.rename")


func main() -> Int:
    match rename_native("/blorp-fs-no-such-path", "/blorp-fs-no-such-path-renamed"):
        Ok(_):
            print("renamed")
            1
        Err(code):
            print(code.to_string())
            0
