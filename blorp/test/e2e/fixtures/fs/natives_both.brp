import:
    io: print


-- Both natives share one helper fragment, which is emitted once and set off
-- by a blank line from the aggregates before it.
func read_native(path: String) -> Result[String, Int]:
    builtin("fs.read_text")


func kind_native(path: String) -> Result[Int, Int]:
    builtin("fs.entry_kind")


func main() -> Int:
    match read_native("/blorp-fs-no-such-path"):
        Ok(text):
            print(text)
            1
        Err(code):
            print(code.to_string())
            match kind_native("/"):
                Ok(kind):
                    print(kind.to_string())
                    0
                Err(error):
                    print(error.to_string())
                    2
