import:
    bool: Bool methods
    int: Int methods
    io/error: IOError, IOErrorKind(InvalidUtf8, OtherOs), to_string
    io/fs: fold_lines, write_text, with_temporary_directory
    list: List methods, repeat, get
    option: Option methods
    path: join
    string: String methods, from_codepoint


-- Every fold the example makes reads a file that it writes itself, inside a
-- temporary directory made in the tree prepare.sh built (the first argument),
-- or a file of that tree. The directory is removed again, so the tree is as it
-- was found. Each error is printed with the directory replaced by the entry's
-- name, so the output is the same wherever the directory is, and the number of
-- an OtherOs error is never printed, because it differs between macOS and
-- Linux.

-- The size of the first read of src/compile/runtime/fs.brp: its BLORP_FS_LINE_BLOCK.
-- The three boundary cases place their bytes against it. If the block size
-- changes, the cases still pass but stop testing their boundary.
FIRST_READ_BYTES: Int = 65536

private CARRIAGE_RETURN: Int = 13
private FIRST_CONTINUATION_BYTE: Int = 128
private FIRST_LEAD_BYTE: Int = 192
-- A line longer than this is shown by its size, not its text.
private SHOWN_TEXT_BYTES: Int = 20
-- How many times the leak cases open a file. The harness runs this example
-- with at most 256 open descriptors, so a descriptor that is not closed shows
-- long before the last fold.
private LEAK_FOLDS: Int = 1000
private INVALID_UTF8_FOLDS: Int = 300
private CRLF_LINES: Int = 20000


-- What a step can return besides an IOError: a stop of the example's own.
union Stopped:
    ReadFailed(IOError)
    StoppedAt(Int)


union ScoreError:
    Unreadable(IOError)
    NotANumber(String)


pure func add_score(total: Int, line: String) -> Result[Int, ScoreError]:
    match line.parse_int():
        Some(score): Ok(total + score)
        None: Err(NotANumber(line))


func total_score(path: String) -> Result[Int, ScoreError]:
    fold_lines(path, 0, add_score, pure func(error: IOError) -> ScoreError: Unreadable(error))


-- Prints each line it adds, so the output shows which lines were stepped.
private func traced_add_score(total: Int, line: String) -> Result[Int, ScoreError]:
    print("  step ${line}")
    add_score(total, line)


func traced_total_score(path: String) -> Result[Int, ScoreError]:
    fold_lines(
        path,
        0,
        traced_add_score,
        pure func(error: IOError) -> ScoreError: Unreadable(error),
    )


private pure func keep(error: IOError) -> IOError:
    error


private pure func is_other_os(error: IOError) -> Bool:
    match error.kind:
        OtherOs(_): True
        _: False


-- The error's own path must be the path the caller passed.
private pure func described(path: String, name: String, error: IOError) -> String:
    if is_other_os(error):
        "OtherOs"
    else if error.path == path:
        renamed: IOError = { error | path = name }
        renamed.to_string()
    else:
        "wrong path: ${error.path}"


private pure func repeated(piece: String, count: Int) -> String:
    repeat(piece, count).join("")


-- The characters of a String: every byte that does not continue another.
private pure func character_count(text: String) -> Int:
    var characters = 0
    for index in 0..text.length():
        match text.byte_at(index):
            Some(byte):
                if (byte < FIRST_CONTINUATION_BYTE).or(byte >= FIRST_LEAD_BYTE):
                    characters = characters + 1
            None:
                void
    characters


private pure func ends_in_carriage_return(line: String) -> Bool:
    (
        line
            .byte_at(line.length() - 1)
            .get_or(0)
        == CARRIAGE_RETURN
    )


-- ASCII text with a CR shown as <CR>, or the size of a long line.
private pure func shown(line: String) -> String:
    if line.length() > SHOWN_TEXT_BYTES:
        "${line.length()} bytes ${character_count(line)} characters"
    else:
        var text = ""
        for index in 0..line.length():
            match line.byte_at(index):
                Some(byte):
                    if byte == CARRIAGE_RETURN:
                        text = text + "<CR>"
                    else:
                        text = text + from_codepoint(byte).get_or("?")
                None:
                    void
        text


private pure func collect(lines: List[String], line: String) -> Result[List[String], IOError]:
    Ok(lines.append(line))


private func read_lines(path: String) -> Result[List[String], IOError]:
    start: List[String] = []
    fold_lines(path, start, collect, keep)


private pure func yes_no(answer: Bool) -> String:
    if answer:
        "yes"
    else:
        "no"


private pure func shown_lines(lines: List[String]) -> String:
    lines
        .map(shown)
        .join(" | ")


-- Writes `text` as `name` in the directory, folds its lines and prints them
-- with whether they are the expected ones.
private func show_text(
    directory: String,
    name: String,
    text: String,
    expected: List[String],
) -> Void:
    path = join(directory, name)
    match write_text(path, text):
        Err(error):
            print("${name}: write failed: ${described(path, name, error)}")
        Ok(_):
            match read_lines(path):
                Ok(lines):
                    print(
                        "${name}: ${lines.length()} lines: ${shown_lines(lines)}; as expected ${yes_no(lines == expected)}",
                    )
                Err(error):
                    print("${name}: ${described(path, name, error)}")


-- The totals of a fold over many lines, so the check needs no copy of them.
record Totals {
    lines: Int,
    bytes: Int,
    ending_in_carriage_return: Int,
}


private pure func carriage_return_ending(line: String) -> Int:
    if line.ends_in_carriage_return():
        1
    else:
        0


private pure func add_totals(totals: Totals, line: String) -> Result[Totals, IOError]:
    Ok({
        lines = totals.lines + 1,
        bytes = totals.bytes + line.length(),
        ending_in_carriage_return = totals.ending_in_carriage_return + carriage_return_ending(line),
    })


private pure func totals_of(lines: List[String]) -> Totals:
    var totals: Totals = { lines = 0, bytes = 0, ending_in_carriage_return = 0 }
    for line in lines:
        totals = { totals | lines = totals.lines + 1, bytes = totals.bytes + line.length() }
    totals


private pure func shown_totals(totals: Totals) -> String:
    "${totals.lines} lines ${totals.bytes} bytes ${totals.ending_in_carriage_return} ending in CR"


private pure func crlf_line(number: Int) -> String:
    "line ${number} ${repeated("x", number % 37)}"


-- Twenty thousand lines of varied length, far more than one read holds.
private func show_crlf(directory: String) -> Void:
    path = join(directory, "crlf.txt")
    var lines: List[String] = []
    for number in 0..CRLF_LINES:
        lines = lines.append(crlf_line(number))
    expected = totals_of(lines)
    match write_text(
        path,
        lines
            .map(pure func(line: String) -> String: line + "\r\n")
            .join(""),
    ):
        Err(error):
            print("crlf.txt: write failed: ${described(path, "crlf.txt", error)}")
        Ok(_):
            start: Totals = { lines = 0, bytes = 0, ending_in_carriage_return = 0 }
            match fold_lines(path, start, add_totals, keep):
                Ok(totals):
                    print(
                        "crlf.txt: ${shown_totals(totals)}; as expected ${yes_no((totals.lines == expected.lines).and(totals.bytes == expected.bytes))}",
                    )
                Err(error):
                    print("crlf.txt: ${described(path, "crlf.txt", error)}")


private pure func count_line(count: Int, line: String) -> Result[Int, IOError]:
    Ok(count + 1)


-- One fold over a file of the tree, or over a path that is not valid.
private func show_fold(path: String, name: String) -> Void:
    match fold_lines(path, 0, count_line, keep):
        Ok(count): print("fold_lines ${name}: ok ${count} lines")
        Err(error): print("fold_lines ${name}: ${described(path, name, error)}")


private func show_tree_fold(tree: String, name: String) -> Void:
    show_fold(join(tree, name), name)


private func scored(path: String, trace: Bool) -> Result[Int, ScoreError]:
    if trace:
        traced_total_score(path)
    else:
        total_score(path)


private func show_score(directory: String, name: String, text: String, trace: Bool) -> Void:
    path = join(directory, name)
    match write_text(path, text):
        Err(error):
            print("${name}: write failed: ${described(path, name, error)}")
        Ok(_):
            match scored(path, trace):
                Ok(total):
                    print("total_score ${name}: ok ${total}")
                Err(NotANumber(line)):
                    print("total_score ${name}: not a number ${line}")
                Err(Unreadable(error)):
                    print("total_score ${name}: ${described(path, name, error)}")


private func announce_if(condition: Bool, message: String) -> Void:
    if condition:
        print(message)
    else:
        void


-- The prepared long_not_utf8.txt has many valid lines, the last of them
-- LAST_VALID_LINE, and then a line that is not UTF-8. The failing read returns
-- none of its block's lines, so the first line is stepped and the last valid
-- line, which with blocks of FIRST_READ_BYTES shares the failing block with
-- the bad line, is not. That the output holds the first line's message and not
-- the last's is the check.
private LAST_VALID_LINE: String = "last valid line"


private func announcing_step(count: Int, line: String) -> Result[Int, Stopped]:
    announce_if(count == 0, "  stepped the first line")
    announce_if(line == LAST_VALID_LINE, "  stepped the last valid line")
    Ok(count + 1)


private pure func unreadable(error: IOError) -> Stopped:
    ReadFailed(error)


private pure func stop_at(count: Int, limit: Int) -> Result[Int, Stopped]:
    if count + 1 == limit:
        Err(StoppedAt(limit))
    else:
        Ok(count + 1)


private func show_stopped(path: String, name: String, outcome: Result[Int, Stopped]) -> Void:
    match outcome:
        Ok(count): print("fold_lines ${name}: ok ${count} lines")
        Err(StoppedAt(line)): print("fold_lines ${name}: step stopped at line ${line}")
        Err(ReadFailed(error)): print("fold_lines ${name}: ${described(path, name, error)}")


private func show_long_not_utf8(tree: String) -> Void:
    name = "long_not_utf8.txt"
    path = join(tree, name)
    show_stopped(path, name, fold_lines(path, 0, announcing_step, unreadable))
    show_stopped(
        path,
        name + " with a step stopping at line 5",
        fold_lines(
            path,
            0,
            func(count: Int, line: String) -> Result[Int, Stopped]: stop_at(count, 5),
            unreadable,
        ),
    )


-- Each fold that stops opens and closes one descriptor. A close that does not
-- run exhausts the harness's limit of 256 descriptors (EMFILE, OtherOs) within
-- LEAK_FOLDS. Counting the open descriptors in /dev/fd would need no limit, but
-- the listing's size, and so the example's allocation count, differs between
-- machines.
private func show_early_stops(directory: String) -> Void:
    path = join(directory, "small.txt")
    match write_text(path, "one\ntwo\nthree\n"):
        Err(error):
            print("small.txt: write failed: ${described(path, "small.txt", error)}")
        Ok(_):
            var stopped = 0
            var failed = 0
            for attempt in 0..LEAK_FOLDS:
                match fold_lines(
                    path,
                    0,
                    func(count: Int, line: String) -> Result[Int, Stopped]: stop_at(count, 2),
                    unreadable,
                ):
                    Err(StoppedAt(_)): stopped = stopped + 1
                    _: failed = failed + 1
            print(
                "${LEAK_FOLDS} folds stopped at line 2: ${stopped} stopped by the step, ${failed} otherwise",
            )


private func show_invalid_utf8_folds(tree: String) -> Void:
    path = join(tree, "long_not_utf8.txt")
    var invalid = 0
    var otherwise = 0
    for attempt in 0..INVALID_UTF8_FOLDS:
        match fold_lines(path, 0, count_line, keep):
            Err(error):
                match error.kind:
                    InvalidUtf8: invalid = invalid + 1
                    _: otherwise = otherwise + 1
            Ok(_):
                otherwise = otherwise + 1
    print(
        "${INVALID_UTF8_FOLDS} folds of long_not_utf8.txt: ${invalid} InvalidUtf8, ${otherwise} otherwise",
    )


private func run_leak_folds(tree: String, directory: String) -> Void:
    show_early_stops(directory)
    show_invalid_utf8_folds(tree)


private func run_cases(tree: String, directory: String) -> Result[Void, IOError]:
    show_text(directory, "empty.txt", "", [])
    show_text(directory, "newline.txt", "\n", [""])
    show_text(directory, "mixed.txt", "a\r\nb\rc\n\nlast", ["a", "b\rc", "", "last"])
    show_score(directory, "scores_ok.txt", "3\r\n4\n5", False)
    show_score(directory, "scores_bad.txt", "3\nx\n5", True)
    show_crlf(directory)
    long_line = repeated("é", 100000)
    show_text(directory, "growth.txt", "x" + long_line + "\nend", ["x" + long_line, "end"])
    tail_line = repeated("é", 40000)
    show_text(directory, "tail.txt", "ab\n" + tail_line + "\nend", ["ab", tail_line, "end"])
    carried_line = repeated("x", FIRST_READ_BYTES - 3)
    show_text(directory, "carried.txt", "a\n" + carried_line + "\r\nend", [
        "a",
        carried_line,
        "end",
    ])
    show_tree_fold(tree, "missing.txt")
    show_tree_fold(tree, "folder")
    show_tree_fold(tree, "locked.txt")
    show_tree_fold(tree, "loop")
    show_tree_fold(tree, "not_utf8.bin")
    show_fold("a\0b", "nul")
    show_long_not_utf8(tree)
    run_leak_folds(tree, directory)
    Ok(void)


func main(arguments: List[String]) -> Int:
    match get(arguments, 1):
        None:
            print("missing directory")
            2
        Some(tree):
            match with_temporary_directory(
                tree,
                "lines",
                func(directory: String) -> Result[Void, IOError]: run_cases(tree, directory),
                keep,
            ):
                Ok(_):
                    0
                Err(error):
                    print("temporary directory: ${error}")
                    1
