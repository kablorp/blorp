import:
    bool: and
    int: Int methods
    io/error: IOError, IOErrorKind(PermissionDenied, OtherOs), to_string
    io/fs:
        Entry,
        EntryKind(File, Directory, Symlink, Other),
        list_directory,
        create_directory,
        create_directories,
        remove_file,
        remove_directory,
        remove_directory_tree,
        rename,
        with_temporary_directory,
        entry_kind,
        read_text,
        write_text,
    list: get, List methods
    path: join


-- Every operation runs against the directory that prepare_directories.sh has
-- just rebuilt, given as the first argument, and changes it. Each error is
-- printed with the directory replaced by the entry's name, so the output is
-- the same wherever the directory is, and the number of an OtherOs error is
-- never printed, because it differs between macOS and Linux. A temporary
-- directory's random name is never printed either.
--
-- Not here, each because it cannot be provoked without root or a second
-- device, or differs by platform; the C tests in test/runtime/fs_suite.brp
-- prove them:
--   CrossesDevices and the mount-point rules of remove_directory_tree
--     (a second device);
--   ChangedDuringRemoval (a race with another process);
--   InvalidUtf8 in a name (APFS refuses to create one);
--     list_invalid_utf8 and tree_invalid_utf8_name cover it;
--   create_directory("file/"), which is NotADirectory on macOS and
--     AlreadyExists on Linux.


-- The error's own path must be the path the caller passed.
private pure func described(path: String, name: String, error: IOError) -> String:
    match error.kind:
        OtherOs(_):
            "OtherOs"
        _:
            if error.path == path:
                renamed: IOError = { error | path = name }
                renamed.to_string()
            else:
                "wrong path: ${error.path}"


private pure func outcome(path: String, name: String, result: Result[Void, IOError]) -> String:
    match result:
        Ok(_): "ok"
        Err(error): described(path, name, error)


private func show(
    label: String,
    directory: String,
    name: String,
    operation: (String) -> Result[Void, IOError],
) -> Void:
    path = join(directory, name)
    print("${label} ${name}: ${outcome(path, name, operation(path))}")


private pure func kind_name(kind: Option[EntryKind]) -> String:
    match kind:
        None: "absent"
        Some(found): found.kind_word()


private func show_kind(directory: String, name: String) -> Void:
    path = join(directory, name)
    match entry_kind(path):
        Ok(kind): print("  ${name} is ${kind_name(kind)}")
        Err(error): print("  ${name}: ${described(path, name, error)}")


private func show_contents(directory: String, name: String) -> Void:
    path = join(directory, name)
    match read_text(path):
        Ok(text): print("  ${name} holds \"${text}\"")
        Err(error): print("  ${name}: ${described(path, name, error)}")


-- The expected output is ASCII. The precomposed e with an acute accent, which
-- the script writes as the bytes C3 A9, is shown under a name; any other
-- spelling of it would show as itself and fail the comparison.
private pure func shown(name: String) -> String:
    if name == "\u{e9}":
        "e-acute"
    else:
        name


private pure func kind_word(kind: EntryKind) -> String:
    match kind:
        File: "file"
        Directory: "directory"
        Symlink: "symlink"
        Other: "other"


private func show_listing(directory: String, name: String) -> Void:
    path = join(directory, name)
    match list_directory(path):
        Ok(entries):
            print("list_directory ${name}: ${entries.length().to_string()} entries")
            for entry in entries:
                print("  ${entry.name.shown()} ${entry.kind.kind_word()}")
            void
        Err(error):
            print("list_directory ${name}: ${described(path, name, error)}")


-- A rename error names both paths the caller passed.
private pure func names_both(error: IOError, source: String, destination: String) -> Bool:
    match error.destination:
        Some(second): and(error.path == source, second == destination)
        None: False


private func show_rename(directory: String, source_name: String, destination_name: String) -> Void:
    source = join(directory, source_name)
    destination = join(directory, destination_name)
    label = "rename ${source_name} -> ${destination_name}"
    match rename(source, destination):
        Ok(_):
            print("${label}: ok")
        Err(error):
            if error.kind.is_other_os():
                print("${label}: OtherOs")
            else if error.names_both(source, destination):
                named: IOError = { error |
                    path = source_name,
                    destination = Some(destination_name),
                }
                print("${label}: ${named}")
            else:
                print("${label}: wrong paths: ${error}")


private pure func is_other_os(kind: IOErrorKind) -> Bool:
    match kind:
        OtherOs(_): True
        _: False


-- The tree, with a link out of it to a file and to a directory, must be gone
-- while what the links name survives.
private func show_survivors(directory: String) -> Void:
    show_kind(directory, "tree")
    show_kind(directory, "outside")
    show_contents(directory, "outside/precious.txt")


-- A body that works in the directory it is given.
private func work_in(directory: String) -> Result[Int, IOError]:
    inside = join(directory, "inside.txt")
    _ ?= write_text(inside, "scratch")
    text ?= read_text(inside)
    Ok(text.length())


-- A body that removes its own directory, so the cleanup that follows has
-- nothing to remove. It records the directory it was given in `seen`.
private func remove_itself(seen: String, directory: String) -> Result[Int, IOError]:
    _ ?= write_text(seen, directory)
    _ ?= remove_directory_tree(directory)
    Ok(0)


private func remove_then_fail(directory: String) -> Result[Int, IOError]:
    _ ?= remove_directory_tree(directory)
    Err({ path = "body", destination = None, kind = PermissionDenied })


private func fail_with_text(directory: String) -> Result[Int, String]:
    Err("body failed")


private func unreachable(directory: String) -> Result[Int, String]:
    print("body ran")
    Ok(0)


private func show_scratch_entries(scratch: String) -> Void:
    match list_directory(scratch):
        Ok(entries): print("  scratch holds ${entries.length().to_string()} entries")
        Err(error): print("  scratch: ${described(scratch, "scratch", error)}")


private func show_with_directory(scratch: String) -> Void:
    match with_temporary_directory(
        scratch,
        "run-",
        work_in,
        pure func(error: IOError) -> IOError: error,
    ):
        Ok(size): print("with_temporary_directory ok: ${size.to_string()}")
        Err(error): print("with_temporary_directory ok: ${described(scratch, "scratch", error)}")
    show_scratch_entries(scratch)


private func show_body_text_error(scratch: String) -> Void:
    match with_temporary_directory(scratch, "run-", fail_with_text, to_string):
        Ok(size): print("with_temporary_directory text error: ok ${size.to_string()}")
        Err(text): print("with_temporary_directory text error: ${text}")
    show_scratch_entries(scratch)


-- The cleanup's NotFound names the directory the body was given (D34), not
-- the parent, and the body could not have named it: it reads the record the
-- body left.
private func show_removed_by_body(scratch: String, seen: String) -> Void:
    match with_temporary_directory(
        scratch,
        "run-",
        func(directory: String) -> Result[Int, IOError]: remove_itself(seen, directory),
        pure func(error: IOError) -> IOError: error,
    ):
        Ok(size):
            print("with_temporary_directory removed by body: ok ${size.to_string()}")
        Err(error):
            match read_text(seen):
                Ok(directory):
                    named: IOError = { error | path = "directory" }
                    print("with_temporary_directory removed by body: ${named}")
                    if error.path == directory:
                        print("  path is the directory the body was given")
                    else if error.path == scratch:
                        print("  path is the parent")
                    else:
                        print("  path is neither")
                Err(read_error):
                    print("with_temporary_directory removed by body: no record: ${read_error}")
    show_scratch_entries(scratch)


private func show_body_error_wins(scratch: String) -> Void:
    match with_temporary_directory(
        scratch,
        "run-",
        remove_then_fail,
        pure func(error: IOError) -> IOError: error,
    ):
        Ok(size):
            print("with_temporary_directory body error: ok ${size.to_string()}")
        Err(error):
            print("with_temporary_directory body error: ${described("body", "body", error)}")
    show_scratch_entries(scratch)


-- to_string is the converter, so the text carries the whole path; it is
-- compared with the text that path must give and printed under a name.
private func show_missing_parent(directory: String) -> Void:
    missing = join(directory, "missing")
    match with_temporary_directory(missing, "run-", unreachable, to_string):
        Ok(size):
            print("with_temporary_directory missing parent: ok ${size.to_string()}")
        Err(text):
            if text == "${missing}: no such file":
                print("with_temporary_directory missing parent: missing: no such file")
            else:
                print("with_temporary_directory missing parent: wrong text: ${text}")


private func show_listings(directory: String) -> Void:
    show_listing(directory, "listing")
    show_listing(directory, "listing_link")
    show_listing(directory, "empty")
    show_listing(directory, "missing")
    show_listing(directory, "file.txt")
    show_listing(directory, "locked")
    -- Nothing in the tree can search a mode 000 directory, and removing it
    -- needs only the parent's permission, so the harness's cleanup never
    -- meets it.
    show("remove_directory", directory, "locked", remove_directory)


private func show_creates(directory: String) -> Void:
    show("create_directory", directory, "fresh", create_directory)
    show("create_directory", directory, "fresh", create_directory)
    show("create_directory", directory, "absent/child", create_directory)
    show("create_directory", directory, "slashed/", create_directory)
    show_kind(directory, "slashed")
    show("create_directories", directory, "deep/a/b/c", create_directories)
    show("create_directories", directory, "deep/a/b/c", create_directories)
    show_kind(directory, "deep/a/b/c")
    show("create_directories", directory, "file.txt/x/y", create_directories)
    show("create_directories", directory, "file.txt", create_directories)
    show("create_directories", directory, "dangling", create_directories)


private func show_removals(directory: String) -> Void:
    show("remove_file", directory, "to_remove.txt", remove_file)
    show("remove_file", directory, "to_remove.txt", remove_file)
    show("remove_file", directory, "listing/dir", remove_file)
    show("remove_directory", directory, "removable", remove_directory)
    show("remove_directory", directory, "nonempty", remove_directory)
    show("remove_directory", directory, "removable", remove_directory)
    show("remove_directory", directory, "file.txt", remove_directory)


private func show_renames(directory: String) -> Void:
    show_rename(directory, "old.txt", "new.txt")
    show_kind(directory, "old.txt")
    show_contents(directory, "new.txt")
    show_rename(directory, "old.txt", "again.txt")
    show_rename(directory, "source_dir", "nonempty")


private func show_trees(directory: String) -> Void:
    show("remove_directory_tree", directory, "tree", remove_directory_tree)
    show_survivors(directory)
    show("remove_directory_tree", directory, "tree", remove_directory_tree)
    show("remove_directory_tree", directory, "file.txt", remove_directory_tree)
    show("remove_directory_tree", directory, "listing_link", remove_directory_tree)
    show("remove_directory_tree", directory, "listing_link/", remove_directory_tree)
    show("remove_directory_tree", directory, "listing/.", remove_directory_tree)
    show_listing(directory, "listing")


private func show_temporary_directories(directory: String) -> Void:
    scratch = join(directory, "scratch")
    show_with_directory(scratch)
    show_body_text_error(scratch)
    show_removed_by_body(scratch, join(directory, "seen.txt"))
    show_body_error_wins(scratch)
    show_missing_parent(directory)


func main(arguments: List[String]) -> Int:
    match get(arguments, 1):
        None:
            print("missing directory")
            2
        Some(directory):
            show_listings(directory)
            show_creates(directory)
            show_removals(directory)
            show_renames(directory)
            show_trees(directory)
            show_temporary_directories(directory)
            0
