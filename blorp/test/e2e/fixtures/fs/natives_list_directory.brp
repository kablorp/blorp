import:
    io: print

-- A program that calls one native and nothing else from fs must still build
-- as valid C under -Werror, so this declares the builtin directly. Its only
-- List[String] is the listing's payload, so the payload alone must bring that
-- List's layout. A device is not a directory, on macOS and Linux alike.
func list_native(path: String) -> Result[List[String], Int]:
    builtin("fs.list_directory")

func main() -> Int:
    match list_native("/dev/null"):
        Ok(_):
            print("listed")
            1
        Err(code):
            print(code.to_string())
            0
