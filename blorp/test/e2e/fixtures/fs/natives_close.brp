import:
    io: print

-- A program that calls one native and nothing else from fs must still build
-- as valid C under -Werror, so this declares the builtin directly. A negative
-- descriptor is refused as EBADF without a close, so no standard stream is
-- closed.
func close_native(descriptor: Int) -> Result[Void, Int]:
    builtin("fs.close")

func main() -> Int:
    match close_native(-1):
        Ok(_):
            print("closed")
            1
        Err(code):
            print(code.to_string())
            0
