-- A bound match inside an arm of the tail match yields a prefix or an arm
-- value.
import:
	io: print


func main(arguments: List[String]) -> Int:
	kept = 42.to_string()
	match arguments.get(1):
		Some(text):
			shown = match text.equals("kept"):
				True: kept
				False: text
			print(shown)
			shown.length()
		None:
			print(kept)
			0
