import:
    io: print

record TextPair { left: String, right: String }

pure func choose(flag: Bool) -> TextPair:
    var left = 1.to_string()
    var right = 2.to_string()
    old_left = left
    match flag:
        True:
            left = right
            right = old_left
        False: void
    { left = left, right = right }

func main() -> Int:
    changed = choose(True)
    print(changed.left)
    print(changed.right)
    unchanged = choose(False)
    print(unchanged.left)
    print(unchanged.right)
    0
