-- A statement match runs one arm for its effects; an arm may end with a
-- binding instead of a value.
import:
	io: print


func main(arguments: List[String]) -> Int:
	count = arguments.length()
	match count.equals(1):
		True: print("one")
		False:
			text = count.to_string()
			print(text)
			shown = text.length()
	print("after")
	count
