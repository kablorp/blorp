-- One arm yields a fresh String, the other the prefix `kept`, which stays
-- live and printable after the join.
import:
	io: print


func main(arguments: List[String]) -> Int:
	kept = 42.to_string()
	label = match arguments.get(1):
		Some(text): text.length().to_string()
		None: kept
	print(label)
	print(kept)
	label.length()
