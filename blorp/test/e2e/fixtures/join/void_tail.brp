-- A Void function discards its tail value, so a nested match at the tail
-- discards each arm's value: arms of different types are fine.
import:
	io: print


func main(arguments: List[String]) -> Void:
	match arguments.get(1):
		Some(text):
			match text.equals("say"):
				True: print("said")
				False: text.length()
		None: print("none")
