import:
    list: get
    string: parse_float
    float: to_string
    io: print
pure func parse_argument(argument: Option[String]) -> Result[Float, String]:
    match argument:
        Some(text): parsed_number(parse_float(text))
        None: Err("missing input")
pure func parsed_number(number: Option[Float]) -> Result[Float, String]:
    match number:
        Some(value): Ok(value)
        None: Err("invalid float")
pure func evaluate(args: List[String]) -> Result[Float, String]:
    parse_argument(get(args, 1))
func report(result: Result[Float, String]) -> Int:
    match result:
        Ok(value):
            print(to_string(value))
            0
        Err(message):
            print(message)
            1
func main(args: List[String]) -> Int:
    report(evaluate(args))
