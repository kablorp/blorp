-- A self call at the tail of a nested match parses and checks; no backedge
-- can leave a join until the loops milestone.
union Step:
	Stop
	Once
@tail_recursive
pure func walk(step: Step, flag: Bool, value: Int) -> Int:
	match step:
		Stop: value
		Once:
			match flag:
				True: walk(Stop, False, 7)
				False: value
func main() -> Int:
	walk(Once, True, 9)
