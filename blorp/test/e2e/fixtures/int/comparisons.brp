import:
    int: less_than, greater_than, less_than_or_equal, greater_than_or_equal, not_equals, min, max, to_string, INT_MIN, INT_MAX
    list: get
    string: parse_int
    io: print

func print_truth(value: Bool) -> Void:
    match value:
        True: print("1")
        False: print("0")

func main(arguments: List[String]) -> Int:
    match get(arguments, 1):
        None: 2
        Some(first_text):
            match parse_int(first_text):
                None: 2
                Some(first):
                    match get(arguments, 2):
                        None: 2
                        Some(second_text):
                            match parse_int(second_text):
                                None: 2
                                Some(second):
                                    print_truth(less_than(first, second))
                                    print_truth(first.greater_than(second))
                                    print_truth(less_than_or_equal(first, second))
                                    print_truth(first.greater_than_or_equal(second))
                                    print_truth(not_equals(first, second))
                                    print(min(first, second).to_string())
                                    print(first.max(second).to_string())
                                    print(INT_MIN.to_string())
                                    print(INT_MAX.to_string())
                                    0
