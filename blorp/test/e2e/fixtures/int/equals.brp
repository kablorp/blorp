import:
    int: equals, add, to_string
    io: print
pure func equal_score(value: Bool) -> Int:
    match value:
        True: 1
        False: 0
pure func different_score(value: Bool) -> Int:
    match value:
        True: 0
        False: 1
pure func score() -> Int:
    zero = equal_score(equals(0, 0))
    negative = equal_score(equals(-1, -1))
    minimum = equal_score(equals(-9223372036854775808, -9223372036854775808))
    maximum = equal_score(equals(9223372036854775807, 9223372036854775807))
    limits = different_score(equals(-9223372036854775808, 9223372036854775807))
    width = different_score(equals(4294967296, 0))
    sign = different_score(equals(-1, 1))
    add(add(add(zero, negative), add(minimum, maximum)), add(add(limits, width), sign))
func main() -> Int:
    print(to_string(score()))
    0
