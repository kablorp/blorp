import:
    int as int_ops
    list as list_ops
    string as string_ops


pure func make(value: Int) -> pure () -> Int:
    pure func() -> Int:
        value


pure func main() -> Int:
    base: List[pure () -> Int] = [make(3), make(5)]
    copied: List[pure () -> Int] = list_ops.append(base, make(7))
    measures: List[pure (String) -> Int] = [string_ops.length]
    match base:
        [first, second]:
            match copied:
                [copy_first, copy_second, third]:
                    match measures:
                        [measure]:
                            first_value = first()
                            second_value = second()
                            copy_first_value = copy_first()
                            copy_second_value = copy_second()
                            third_value = third()
                            measured_length = measure("xx")
                            match int_ops.equals(first_value, 3):
                                False:
                                    1
                                True:
                                    match int_ops.equals(second_value, 5):
                                        False:
                                            2
                                        True:
                                            match int_ops.equals(copy_first_value, 3):
                                                False:
                                                    3
                                                True:
                                                    match int_ops.equals(copy_second_value, 5):
                                                        False:
                                                            4
                                                        True:
                                                            match int_ops.equals(third_value, 7):
                                                                False:
                                                                    5
                                                                True:
                                                                    match int_ops.equals(
                                                                        measured_length,
                                                                        2,
                                                                    ):
                                                                        False:
                                                                            6
                                                                        True:
                                                                            original_total = int_ops.add(
                                                                                first_value,
                                                                                second_value,
                                                                            )
                                                                            copied_total = int_ops.add(
                                                                                int_ops.add(
                                                                                    copy_first_value,
                                                                                    copy_second_value,
                                                                                ),
                                                                                third_value,
                                                                            )
                                                                            int_ops.add(
                                                                                int_ops.add(
                                                                                    original_total,
                                                                                    copied_total,
                                                                                ),
                                                                                measured_length,
                                                                            )
                        _:
                            0
                _:
                    0
        _:
            0
