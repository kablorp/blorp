import:
    io: print


func produce_once() -> Result[String, String]:
    print("once")
    Ok("fresh".add("-value"))


pure func succeed(value: String) -> Result[String, String]:
    Ok(value)


pure func complete() -> Result[Void, String]:
    Ok(void)


func success() -> Result[Int, String]:
    retained = "shared".add("-value")
    _ ?= produce_once()
    _: String ?= succeed(retained)
    _ ?= complete()
    _ ?= complete()
    print(retained)
    Ok(7)


func produce_error() -> Result[String, String]:
    print("error-once")
    Err("kept".add("-error"))


func failure() -> Result[Int, String]:
    _ ?= produce_error()
    print("unreachable")
    Ok(0)


func main() -> Int:
    match success():
        Ok(number): print(number.to_string())
        _: print("wrong success")
    match failure():
        Err(error): print(error)
        _: print("wrong failure")
    0
