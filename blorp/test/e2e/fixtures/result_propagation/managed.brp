import:
    int as IntOps
    string as StringOps
    io: print

func decide(value: String, fail: Bool) -> Result[String, String]:
    print("rhs")
    match fail:
        True: Err(value)
        False: Ok(value)

func advance(value: String, fail: Bool) -> Result[Int, String]:
    prefix = StringOps.add("prefix:", value)
    next ?= decide(value, fail)
    print(prefix)
    Ok(StringOps.length(next))

func main() -> Int:
    value = StringOps.add(IntOps.to_string(42), "é\0")
    retained = value
    match advance(value, False):
        Ok(number): print(IntOps.to_string(number))
        Err(error): print(error)
    print(retained)
    match advance(value, True):
        Ok(number): print(IntOps.to_string(number))
        Err(error): print(error)
    print(retained)
    0
