import:
    int as IntOps
    string: add, append_int
    io: print
func condition() -> Bool:
    print("condition")
    True
func main() -> Int:
    var text: String = "old".add(" value")
    var condition_text: String = "condition".add(" old")
    original_text = text
    chosen: String = if match condition():
        True:
            text = "condition".add(" value")
            condition_text = "condition".add(" only")
            True
        False: False
    :
        print("then")
        text = "new".add(" value")
        original_text
    else:
        print("unselected")
        text
    print(chosen)
    print(text)
    print(original_text)
    print(condition_text)
    other: String = if False:
        print("wrong managed arm")
        text = "unselected".add(" value")
        original_text
    else:
        print("else")
        text
    print(other)
    print(text)
    print(original_text)
    number: Int = if False:
        print("wrong")
        13
    else if True:
        print("else if")
        41
    else:
        print("wrong else")
        17
    print("answer ".append_int(IntOps.add(number, 1)))
    0
