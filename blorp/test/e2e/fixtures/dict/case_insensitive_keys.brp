import:
    bool: and
    dict as D
    int: Int methods
    io: print
    list: join, map
    string: String methods


-- A key whose Equatable and Hashable are coarser than its representation:
-- Words that differ only in ASCII case are one key. The Dict keeps the spelling
-- of the first insertion, and the value of the last.

opaque type Word = String


pure func word(letters: String) -> Word:
    into_opaque Word(letters)


pure func spelling(value: Word) -> String:
    spelled: String = from_opaque Word(value)
    spelled


private pure func folded_byte(value: String, position: Int) -> Int:
    match value.byte_at(position):
        Some(byte):
            if and(byte >= 65, byte <= 90):
                byte + 32
            else:
                byte
        None:
            0


implements Equatable for Word:
    pure func equals(left: Self, right: Self) -> Bool:
        left_text = spelling(left)
        right_text = spelling(right)
        var same: Bool = left_text.length() == right_text.length()
        for position in 0..left_text.length():
            same = and(same, folded_byte(left_text, position) == folded_byte(right_text, position))
        same


implements Hashable for Word:
    pure func hash(value: Self) -> Int:
        spelled = spelling(value)
        var folded = 17
        for position in 0..spelled.length():
            folded = (folded + folded_byte(spelled, position)) * 31
        folded


pure func truth(value: Bool) -> String:
    match value:
        True: "true"
        False: "false"


pure func show(dict: D.Dict[Word, Int]) -> String:
    values = D.values(dict)
        .map(pure func(value: Int): value.to_string())
        .join(",")
    (
        "keys "
        + D.keys(dict)
            .map(spelling)
            .join(",")
        + " values "
        + values
        + " length "
        + D.length(dict).to_string()
    )


func main() -> Int:
    empty: D.Dict[Word, Int] = D.empty()
    var dict = empty
        .set(word("Apple"), 1)
        .set(word("pear"), 2)
        .set(word("FIG"), 3)
    print("set " + show(dict))
    dict = dict
        .set(word("APPLE"), 10)
        .set(word("Pear"), 20)
    print("replace keeps position and first spelling " + show(dict))
    print(
        (
            "lookup "
            + dict
                .get_or(word("apple"), -1)
                .to_string()
            + " "
            + dict
                .get_or(word("fig"), -1)
                .to_string()
            + " "
            + truth(dict.contains(word("fi")))
        ),
    )
    dict = dict.remove(word("PEAR"))
    print("remove " + show(dict))
    dict = dict.set(word("pEaR"), 5)
    print("set again goes last with the new spelling " + show(dict))
    print(
        (
            "missing "
            + dict
                .get_or(word("plum"), -1)
                .to_string()
            + " "
            + show(dict.remove(word("plum")))
        ),
    )
    lower = empty
        .set(word("a"), 1)
        .set(word("b"), 2)
    upper = empty
        .set(word("B"), 2)
        .set(word("A"), 1)
    print(
        (
            "equality ignores order and case "
            + truth(lower == upper)
            + " "
            + truth(lower == upper.set(word("a"), 0))
        ),
    )
    copy = dict
    dict = dict
        .set(word("fig"), 0)
        .remove(word("apple"))
    print("copy " + show(copy))
    print("original " + show(dict))
    0
