import:
    int: Int methods


-- A five-entry literal costs what its written chain in call_chain_cost.brp
-- costs: both pin the same allocations, and `build` emits the same C. Five
-- entries outgrow the minimum seven slots, so a literal that did not reserve
-- its entry count would rebuild and allocate more.

pure func build(base: Int) -> Dict[Int, Int]:
    { base => 1, base + 1 => 2, base + 2 => 3, base + 3 => 4, base + 4 => 5 }


func main() -> Int:
    var total = 0
    for round in 0..100:
        total = total + build(round).length()
    print(total.to_string())
    0
