import:
    dict as D
    int: Int methods
    io: print
    list: get_or
    string: String methods


-- A fixed live count of 1,000, then remove the oldest key and set a new one
-- 5,000 times. The design ceiling is at most 2.1 allocations per cycle for a live
-- count of 1,000 or more: 2.02 measured after the 1,000-key build, 2.22 counting
-- it. The harness pins the total, 11,121. A rebuild per cycle would copy 1,000
-- entries each time.
private LIVE: Int = 1000

private CYCLES: Int = 5000


func main() -> Int:
    var dict: D.Dict[Int, Int] = D.empty()
    for key in 0..LIVE:
        dict = dict.set(key, key * 3)
    for cycle in 0..CYCLES:
        dict = dict.remove(cycle).set(LIVE + cycle, (LIVE + cycle) * 3)
    keys = D.keys(dict)
    print(
        (
            D.length(dict).to_string()
            + " "
            + keys.get_or(0, -1).to_string()
            + " "
            + keys.get_or(LIVE - 1, -1).to_string()
        ),
    )
    print(
        (
            dict.get_or(CYCLES, -1).to_string()
            + " "
            + dict.get_or(CYCLES - 1, -1).to_string()
            + " "
            + dict.get_or(CYCLES + LIVE - 1, -1).to_string()
        ),
    )
    0
