import:
    dict as D
    int: Int methods
    io: print


-- The calls literal_cost.brp's literal stands for, written out.

pure func build(base: Int) -> Dict[Int, Int]:
    D.set(
        D.set(D.set(D.set(D.set(D.dict(5), base, 1), base + 1, 2), base + 2, 3), base + 3, 4),
        base + 4,
        5,
    )


func main() -> Int:
    var total = 0
    for round in 0..100:
        total = total + build(round).length()
    print(total.to_string())
    0
