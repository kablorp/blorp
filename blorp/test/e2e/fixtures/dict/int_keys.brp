import:
    dict as D
    int: Int methods
    io: print
    list: join, map
    string: String methods


-- Int keys: order through replace, remove and set again, missing keys,
-- equality that ignores order, and a copy that later updates leave unchanged.

pure func key_text(key: Int) -> String:
    key.to_string()


pure func show(dict: D.Dict[Int, String]) -> String:
    keys = D.keys(dict).map(key_text).join(",")
    "keys " + keys + " values " + D.values(dict).join(",") + " length " + D.length(dict).to_string()


pure func truth(value: Bool) -> String:
    match value:
        True: "true"
        False: "false"


pure func pair_text(pair: (Int, String)) -> String:
    (key, value) = pair
    key.to_string() + "=" + value


pure func pairs(dict: D.Dict[Int, String]) -> String:
    D.entries(dict).map(pair_text).join(" ")


func main() -> Int:
    empty: D.Dict[Int, String] = D.empty()
    print("empty " + show(empty) + " " + truth(D.is_empty(empty)))
    var dict = empty.set(5, "e").set(1, "a").set(9, "i")
    print("set " + show(dict))
    dict = dict.set(1, "A")
    print("replace " + show(dict))
    dict = dict.remove(5)
    print("remove " + show(dict))
    dict = dict.set(5, "E")
    print("set again " + show(dict))
    print("entries " + pairs(dict))
    print(
        (
            "missing "
            + dict.get_or(7, "none")
            + " "
            + truth(dict.contains(7))
            + " "
            + show(dict.remove(7))
        ),
    )
    print("present " + dict.get_or(9, "none") + " " + truth(dict.contains(9)))
    forward = empty.set(1, "x").set(2, "y").set(3, "z")
    backward = empty.set(3, "z").set(2, "y").set(1, "x")
    changed = backward.set(2, "Y")
    print(
        (
            "order ignored "
            + truth(forward == backward)
            + " "
            + truth(forward == changed)
            + " "
            + truth(forward == forward.remove(3))
        ),
    )
    copy = dict
    dict = dict.set(1, "changed").remove(9)
    print("copy " + show(copy))
    print("original " + show(dict))
    0
