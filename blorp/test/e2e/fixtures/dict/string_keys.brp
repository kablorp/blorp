import:
    dict as D
    int: Int methods
    io: print
    list: join, map
    string: String methods


-- String keys: the same scenario as int_keys.brp, with Int values.

pure func show(dict: D.Dict[String, Int]) -> String:
    values = D.values(dict).map(pure func(value: Int): value.to_string()).join(",")
    "keys " + D.keys(dict).join(",") + " values " + values + " length " + D.length(dict).to_string()


pure func truth(value: Bool) -> String:
    match value:
        True: "true"
        False: "false"


pure func pair_text(pair: (String, Int)) -> String:
    (key, value) = pair
    key + "=" + value.to_string()


func main() -> Int:
    empty: D.Dict[String, Int] = D.empty()
    print("empty " + show(empty) + " " + truth(D.is_empty(empty)))
    var dict = empty.set("pear", 5).set("apple", 1).set("fig", 9)
    print("set " + show(dict))
    dict = dict.set("apple", 11)
    print("replace " + show(dict))
    dict = dict.remove("pear")
    print("remove " + show(dict))
    dict = dict.set("pear", 50)
    print("set again " + show(dict))
    print("entries " + D.entries(dict).map(pair_text).join(" "))
    print(
        (
            "missing "
            + dict.get_or("plum", -1).to_string()
            + " "
            + truth(dict.contains("plum"))
            + " "
            + show(dict.remove("plum"))
        ),
    )
    print(
        (
            "prefix and case differ "
            + truth(dict.contains("app"))
            + " "
            + truth(dict.contains("Apple"))
            + " "
            + truth(dict.contains(""))
        ),
    )
    forward = empty.set("a", 1).set("b", 2).set("c", 3)
    backward = empty.set("c", 3).set("b", 2).set("a", 1)
    print(
        (
            "order ignored "
            + truth(forward == backward)
            + " "
            + truth(forward == backward.set("b", 0))
            + " "
            + truth(forward == forward.remove("c"))
        ),
    )
    copy = dict
    dict = dict.set("apple", 0).remove("fig")
    print("copy " + show(copy))
    print("original " + show(dict))
    0
