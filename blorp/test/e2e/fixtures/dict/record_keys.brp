import:
    dict as D: DictKey, combine_hash
    int: Int methods
    io: print
    list: join, map
    string: String methods


-- A two-field record key. It writes only Hashable, combining its fields in
-- order, and takes == from its fields. Swapped field values are
-- different keys, and a union key with a payload works the same way.

record Cell { row: Int, column: Int }


implements Hashable for Cell:
    pure func hash(value: Self) -> Int:
        combine_hash(combine_hash(0, value.row), value.column)


implements DictKey for Cell


union Mark:
    Blank
    Marked(Int)


implements Hashable for Mark:
    pure func hash(value: Self) -> Int:
        match value:
            Blank: 0
            Marked(number): number


implements DictKey for Mark


pure func cell(row: Int, column: Int) -> Cell:
    { row = row, column = column }


pure func cell_text(value: Cell) -> String:
    value.row.to_string() + ":" + value.column.to_string()


pure func show(dict: D.Dict[Cell, Int]) -> String:
    values = D.values(dict)
        .map(pure func(value: Int): value.to_string())
        .join(",")
    (
        "keys "
        + D.keys(dict)
            .map(cell_text)
            .join(",")
        + " values "
        + values
        + " length "
        + D.length(dict).to_string()
    )


pure func truth(value: Bool) -> String:
    match value:
        True: "true"
        False: "false"


func main() -> Int:
    empty: D.Dict[Cell, Int] = D.empty()
    var dict = empty
        .set(cell(1, 2), 12)
        .set(cell(2, 1), 21)
        .set(cell(1, 3), 13)
    print("swapped fields hash apart " + truth(cell(1, 2).hash() != cell(2, 1).hash()))
    print("swapped fields are different keys " + show(dict))
    dict = dict.set(cell(2, 1), 210)
    print("replace keeps position " + show(dict))
    print(
        (
            "lookup "
            + dict
                .get_or(cell(1, 2), -1)
                .to_string()
            + " "
            + dict
                .get_or(cell(2, 1), -1)
                .to_string()
            + " "
            + dict
                .get_or(cell(3, 3), -1)
                .to_string()
            + " "
            + truth(dict.contains(cell(1, 4)))
        ),
    )
    dict = dict.remove(cell(1, 2))
    print("remove " + show(dict))
    marks: D.Dict[Mark, Int] = D.empty()
    marked = marks
        .set(Marked(3), 1)
        .set(Blank, 2)
        .set(Marked(3), 5)
    print(
        (
            "union keys "
            + D.length(marked).to_string()
            + " "
            + marked
                .get_or(Marked(3), -1)
                .to_string()
            + " "
            + marked
                .get_or(Blank, -1)
                .to_string()
            + " "
            + marked
                .get_or(Marked(4), -1)
                .to_string()
        ),
    )
    0
