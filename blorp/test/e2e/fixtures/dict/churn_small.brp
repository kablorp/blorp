import:
    dict as D
    io: print
    int: Int methods
    list: get_or
    string: String methods

-- A fixed live count of 10, then remove the oldest key and set a new one 5,000
-- times. The design ceiling is at most 2.6 allocations per cycle for a live
-- count below 1,000 (about 2.5 measured), and the harness pins the total. A
-- rebuild every cycle, or a copy of the whole Dict per operation, would exceed it.
private LIVE: Int = 10

private CYCLES: Int = 5000

func main() -> Int:
    var dict: D.Dict[Int, Int] = D.empty()
    for key in 0..LIVE:
        dict = dict.set(key, key * 3)
    for cycle in 0..CYCLES:
        dict = dict.remove(cycle).set(LIVE + cycle, (LIVE + cycle) * 3)
    keys = D.keys(dict)
    print(D.length(dict).to_string() + " " + keys.get_or(0, -1).to_string() + " " + keys.get_or(LIVE - 1, -1).to_string())
    print(dict.get_or(CYCLES, -1).to_string() + " " + dict.get_or(CYCLES - 1, -1).to_string() + " " + dict.get_or(CYCLES + LIVE - 1, -1).to_string())
    0
