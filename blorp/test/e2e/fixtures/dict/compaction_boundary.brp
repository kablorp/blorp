import:
    dict as D
    int: Int methods
    io: print
    string: String methods


-- Where `remove` rebuilds, pinned through the strict allocation count: a removal
-- that only marks an entry dead allocates once (the record), and one that
-- rebuilds also allocates the four fresh Lists and the index. A rebuild happens
-- when the dead entries outnumber the live ones (dead > live) and number at
-- least MINIMUM_COMPACTION (8). Each scenario builds `entries` keys, then removes
-- the oldest `removals`:
--   16 entries, 8 removals: dead 8, live 8. Not more dead than live, no rebuild
--   (a `>=` would rebuild here).
--   8 entries, 7 removals: dead 7 > live 1 but under the minimum, no rebuild
--   (a minimum of 7 would rebuild here).
--   10 entries, 8 removals: dead 8 > live 2 and at the minimum, one rebuild
--   (a minimum of 9 would not).
private pure func survivors(entries: Int, removals: Int) -> Int:
    var dict: D.Dict[Int, Int] = D.empty()
    for key in 0..entries:
        dict = dict.set(key, key)
    for key in 0..removals:
        dict = dict.remove(key)
    D.length(dict)


func main() -> Int:
    print(
        (
            survivors(16, 8).to_string()
            + " "
            + survivors(8, 7).to_string()
            + " "
            + survivors(10, 8).to_string()
        ),
    )
    0
