import:
    bool: and
    dict as D
    int: Int methods
    io: print
    list: join, map
    string: String methods


-- Dict literals: `{}` typed by its annotation, Int, String and case-insensitive
-- opaque keys, a repeated key, nested Dicts, and equality with the same Dict
-- built by calls. A literal is successive `set`s, so a repeated key keeps its
-- first position and its last value.

opaque type Word = String


pure func word(letters: String) -> Word:
    into_opaque Word(letters)


pure func spelling(value: Word) -> String:
    spelled: String = from_opaque Word(value)
    spelled


private pure func folded_byte(value: String, position: Int) -> Int:
    match value.byte_at(position):
        Some(byte):
            if and(byte >= 65, byte <= 90):
                byte + 32
            else:
                byte
        None: 0


implements Equatable for Word:
    pure func equals(left: Self, right: Self) -> Bool:
        left_text = spelling(left)
        right_text = spelling(right)
        var same: Bool = left_text.length() == right_text.length()
        for position in 0..left_text.length():
            same = and(same, folded_byte(left_text, position) == folded_byte(right_text, position))
        same


implements Hashable for Word:
    pure func hash(value: Self) -> Int:
        spelled = spelling(value)
        var folded = 17
        for position in 0..spelled.length():
            folded = (folded + folded_byte(spelled, position)) * 31
        folded


implements D.DictKey for Word


pure func truth(value: Bool) -> String:
    match value:
        True: "true"
        False: "false"


pure func key_text(key: Int) -> String:
    key.to_string()


pure func value_text(value: Int) -> String:
    value.to_string()


pure func numbered(dict: Dict[Int, String]) -> String:
    (
        "keys "
        + dict
            .keys()
            .map(key_text)
            .join(",")
        + " values "
        + dict
            .values()
            .join(",")
        + " length "
        + dict
            .length()
            .to_string()
    )


pure func named(dict: Dict[String, Int]) -> String:
    (
        "keys "
        + dict
            .keys()
            .join(",")
        + " values "
        + dict
            .values()
            .map(value_text)
            .join(",")
        + " length "
        + dict
            .length()
            .to_string()
    )


pure func worded(dict: Dict[Word, Int]) -> String:
    (
        "keys "
        + dict
            .keys()
            .map(spelling)
            .join(",")
        + " values "
        + dict
            .values()
            .map(value_text)
            .join(",")
    )


func main() -> Int:
    empty: Dict[String, Int] = {}
    print("empty " + named(empty) + " " + truth(empty.is_empty()))
    print("int " + numbered({ 5 => "e", 1 => "a", 9 => "i" }))
    scores = { "alice" => 95, "bob" => 80, "alice" => 99 }
    print(
        (
            "repeated "
            + named(scores)
            + " alice "
            + scores
                .get_or("alice", -1)
                .to_string()
        ),
    )
    words = { word("Apple") => 1, word("pear") => 2, word("APPLE") => 3 }
    print(
        (
            "case-insensitive "
            + worded(words)
            + " "
            + words
                .get_or(word("apple"), -1)
                .to_string()
        ),
    )
    nested: Dict[String, Dict[String, Int]] = { "a" => { "x" => 1, "y" => 2 }, "b" => {} }
    print(
        (
            "nested "
            + nested
                .keys()
                .join(",")
            + " "
            + named(nested.get_or("a", {}))
            + " "
            + named(nested.get_or("b", { "z" => 0 }))
        ),
    )
    built = D.set(D.set(D.dict(2), "bob", 80), "alice", 99)
    print(
        (
            "equal to calls "
            + truth(scores == built)
            + " "
            + truth({ "alice" => 99 } == built)
            + " "
            + truth({ "bob" => 80, "alice" => 1 } == built)
        ),
    )
    0
