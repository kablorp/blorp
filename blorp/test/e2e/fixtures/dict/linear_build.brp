import:
    dict as D
    int: Int methods
    io: print
    string: String methods


-- Builds 65,536 keys. A build is one allocation per key plus the lookups' none;
-- The design ceiling is at most 1.02 allocations per key. If a rebuild updated
-- a record's List field inside its loop (a known ownership limit), each entry
-- would copy a List and the total would grow roughly with the square of the
-- count, far past the pinned total.
private COUNT: Int = 65536


func main() -> Int:
    var dict: D.Dict[Int, Int] = D.empty()
    for key in 0..COUNT:
        dict = dict.set(key, key + 1)
    var sum = 0
    for key in 0..COUNT:
        sum = sum + dict.get_or(key, 0)
    print(
        (
            D.length(dict).to_string()
            + " "
            + sum.to_string()
            + " "
            + dict
                .get_or(COUNT - 1, -1)
                .to_string()
        ),
    )
    0
