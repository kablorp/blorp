record Leaf { text: String }
record Branch { leaf: Leaf }
record Tree { branch: Branch }
pure func make_tree() -> Tree:
    { branch = { leaf = { text = 42.to_string() } } }
pure func escaped_branch(value: Tree) -> Branch:
    value.branch
pure func escaped_leaf(value: Branch) -> Leaf:
    value.leaf
pure func escaped_text(value: Leaf) -> String:
    value.text
func main() -> Int:
    escaped_text(escaped_leaf(escaped_branch(make_tree()))).length()
