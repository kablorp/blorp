import:
    io: print
record Box[T] { value: T }
pure func box[T](value: T) -> Box[T]:
    { value = value }
pure func unbox[T](value: Box[T]) -> T:
    value.value
func report(value: Option[String]) -> Int:
    match value:
        Some(text):
            print(text)
            0
        None:
            print("missing")
            1
func main(arguments: List[String]) -> Int:
    values = unbox(box(arguments))
    print(values.length().to_string())
    report(unbox(box(values)).get(1))
