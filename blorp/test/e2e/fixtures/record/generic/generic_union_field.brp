import:
    io: print
union Choice[T]:
    Empty
    Value(T)
record Box[T] { value: Choice[T] }
pure func box[T](value: T) -> Box[T]:
    { value = Value(value) }
pure func unbox[T](value: Box[T]) -> T:
    match value.value:
        Empty: unbox(value)
        Value(item): item
func main() -> Void:
    print(unbox(box(42.to_string())))
