import:
    list: repeat, length, get
    int: to_string
    io: print
record Entry { number: Int, text: String, values: List[Int] }
pure func make_entry(number: Int) -> Entry:
    { number = number, text = number.to_string(), values = repeat(number, 2) }
pure func first(values: List[Int]) -> Int:
    match values.get(0):
        Some(value): value
        None: -1
func main() -> Void:
    old = make_entry(42)
    fresh = { old | values = repeat(3, 1), text = 7.to_string() }
    print(fresh.number.to_string())
    print(fresh.text)
    print(first(fresh.values).to_string())
    print(fresh.values.length().to_string())
    print(old.text)
    print(old.values.length().to_string())
