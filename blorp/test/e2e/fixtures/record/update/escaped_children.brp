import:
    list: repeat, length, get
    int: to_string
    io: print
record Entry { number: Int, text: String, values: List[Int] }
pure func make_entry(number: Int) -> Entry:
    { number = number, text = number.to_string(), values = repeat(number, 2) }
pure func changed_values() -> List[Int]:
    old = make_entry(42)
    fresh = { old | text = 7.to_string() }
    fresh.values
pure func changed_text() -> String:
    old = make_entry(42)
    fresh = { old | text = 7.to_string() }
    fresh.text
pure func first(values: List[Int]) -> Int:
    match values.get(0):
        Some(value): value
        None: -1
func main() -> Void:
    values = changed_values()
    print(first(values).to_string())
    print(values.length().to_string())
    print(changed_text())
