import:
    io: print
record Holder { text: String }
pure func make_holder(value: Int) -> Holder:
    { text = value.to_string() }
pure func identity(value: Holder) -> Holder:
    value
func main() -> Void:
    var current = make_holder(42)
    original = current
    current = identity(current)
    print(original.text)
    print(current.text)
    current = make_holder(7)
    print(original.text)
    print(current.text)
