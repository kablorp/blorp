union Token[T]:
    Present
record Entry { text: String }
record Tokens { string_token: Token[String], record_token: Token[Entry] }
pure func make_tokens() -> Tokens:
    { string_token = Present, record_token = Present }
pure func score[T](value: Token[T]) -> Int:
    match value:
        Present: 7
func main() -> Int:
    value = make_tokens()
    score(value.string_token).add(score(value.record_token))
