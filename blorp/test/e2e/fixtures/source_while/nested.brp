import:
    int as IntOps
    string: add
    io: print

pure func count(limit: Int) -> Int:
    var outer: Int = 0
    var total: Int = 0
    while IntOps.less_than(outer, limit):
        var inner: Int = 0
        while IntOps.less_than(inner, 2):
            total = IntOps.add(total, 1)
            inner = IntOps.add(inner, 1)
        outer = IntOps.add(outer, 1)
    total

pure func final_false() -> Int:
    var total: Int = 0
    var outer: Bool = True
    while outer:
        while match outer:
            True:
                total = 7
                False
            False:
                False
        :
            void
        outer = False
    total

func visit(pre: String) -> Void:
    var outer: Int = 0
    while IntOps.less_than(outer, 2):
        local = add(pre, "x")
        var inner: Int = 0
        while IntOps.less_than(inner, 2):
            print(add(local, "y"))
            inner = IntOps.add(inner, 1)
        print(local)
        outer = IntOps.add(outer, 1)
    print(pre)

func main() -> Void:
    print(count(0).to_string())
    print(count(1).to_string())
    print(count(3).to_string())
    print(final_false().to_string())
    pre = add("pre", "!")
    visit(pre)
    retained = pre
    print(retained)
