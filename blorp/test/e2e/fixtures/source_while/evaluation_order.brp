import:
    int as IntOps
    io: print
    string: add, append_int


func condition(value: Int) -> Bool:
    marker = "c".add("".append_int(value))
    print(marker)
    IntOps.less_than(value, 3)


func main() -> Int:
    var cursor: Int = 0
    if False:
        print("unreachable")
    while match condition(cursor):
        True:
            True
        False:
            cursor = IntOps.add(cursor, 100)
            False
    :
        mortal = "b".add("".append_int(cursor))
        mortal_copy = mortal
        print(mortal_copy)
        cursor = IntOps.add(cursor, 1)
    print("done".add("".append_int(cursor)))
    0
