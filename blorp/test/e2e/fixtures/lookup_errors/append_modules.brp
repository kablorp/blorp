import:
    int: Int methods
    io: print
    result: Result methods
    string: String methods
    ../../../../src/lex/lex: lex
    ../../../../src/parse/assemble: ParsedAssembly, append_module, assembly_names, begin_program
    ../../../../src/parse/parse: parse_module
    ../../../../src/utils/source: ModuleId, ModuleKind(LibraryModule), module_id, module_source
    ../../../../src/utils/syntax: Diagnostic, internal_error, compiler_span


-- Appends 64 empty modules to one source bundle. Each append looks up its
-- module's file name, which every path here has. A lookup that built its
-- error before knowing would allocate one Diagnostic per module, plus the
-- error's two String literals on their first use: 66 above the pinned total.
-- The modules' lexing, parsing and rows make up the rest.
private COUNT: Int = 64


pure func appended(assembly: ParsedAssembly, position: Int) -> Result[ParsedAssembly, Diagnostic]:
    module: ModuleId ?= match module_id(position):
        Some(present): Ok(present)
        None: Err(internal_error(compiler_span(), "module position out of range"))
    tokens ?= lex(module_source(module), "", assembly_names(assembly))
    parsed ?= parse_module(tokens, module)
    append_module(
        assembly,
        parsed,
        [],
        LibraryModule,
        "modules/module_".append_int(position) + ".brp",
    )


func main() -> Int:
    var assembly: Result[ParsedAssembly, Diagnostic] = Ok(begin_program())
    for position in 0..COUNT:
        assembly = assembly.and_then(
            pure func(builder: ParsedAssembly): appended(builder, position),
        )
    match assembly:
        Ok(_):
            print(COUNT.to_string() + " modules")
            0
        Err(error):
            print(error.message)
            1
