import:
	io: print
	string: add

union Side:
	Left(String, String)
	Right(String, String)

func selected(value: Side) -> String:
	match value:
		Left(item, _) | Right(_, item):
			print("selected")
			item

func main() -> Int:
	text = "é\0".add("input")
	left: Side = Left(text, "wrong-left")
	right: Side = Right("wrong-right", text)
	left_alias = left
	first = selected(left)
	second = selected(right)
	unused = selected(left_alias)
	print(first)
	print(second)
	print(text)
	0
