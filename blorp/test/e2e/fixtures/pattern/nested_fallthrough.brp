import:
	io: print
	string: add

func choose(value: Option[Option[String]]) -> Void:
	match value:
		Some(Some(text)): print(text)
		Some(None): print("inner-none")
		None: print("outer-none")

func main() -> Int:
	text = "é\0".add("nested")
	original: Option[Option[String]] = Some(Some(text))
	original_copy = original
	choose(original)
	choose(original_copy)
	choose(Some(None))
	choose(None)
	0
