import:
	io: print
	string: add

func classify(value: String) -> Void:
	match value:
		"é\0x": print("exact")
		"é": print("short")
		"": print("empty")
		_: print("other")

func main() -> Int:
	text = "é\0".add("x")
	original_copy = text
	classify(text)
	classify(original_copy)
	classify("é")
	classify("é\0y")
	classify("é\0xmore")
	classify("")
	classify("e\0x")
	0
