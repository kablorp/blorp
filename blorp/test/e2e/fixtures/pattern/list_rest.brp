import:
	io: print
	string: add

pure func suffix(values: List[String]) -> List[String]:
	match values:
		[]: []
		[_, ...rest]: rest

func show(values: List[String]) -> Void:
	match values:
		[]: print("empty")
		[first]: print(first)
		[first, second]:
			print(first)
			print(second)
		[first, second, third]:
			print(first)
			print(second)
			print(third)
		_: print("longer")

func main() -> Int:
	text = "é\0".add("tail")
	original = ["head", text, text]
	original_copy = original
	result = suffix(original)
	result_alias = result
	unused = suffix(original)
	show(result)
	show(result_alias)
	show(original_copy)
	show(suffix([]))
	0
