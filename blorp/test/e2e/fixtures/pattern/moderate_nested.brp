import:
    io: print
    int: to_string

pure func choose(value: Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Int]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]) -> Int:
    match value:
        Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(number)))))))))))))))))))))))))))))))): number
        None: 0
        _: 7

func main() -> Int:
    print(choose(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(42))))))))))))))))))))))))))))))))).to_string())
    print(choose(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(None)))))))))))))))))))))))))))))))).to_string())
    print(choose(None).to_string())
    0
