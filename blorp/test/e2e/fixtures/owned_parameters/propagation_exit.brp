import:
    list: List methods
    int: Int methods
    string: String methods
    io: print

pure func parse(text: String) -> Result[Int, String]:
    match text.parse_int():
        Some(number): Ok(number)
        None: Err("not a number: ${text}")

-- `items` owns: the success path appends to it in place. An early `?=`
-- exit leaves while it is still live, so that exit must drop it.
pure func extend(items: List[Int], text: String) -> Result[List[Int], String]:
    number ?= parse(text)
    Ok(items.append(number))

pure func report(result: Result[List[Int], String]) -> String:
    match result:
        Ok(values): "ok ${values.length().to_string()}"
        Err(error): error

func main() -> Int:
    base: List[Int] = [1, 2]
    print(report(extend(base, "3")))
    print(report(extend(base, "x")))
    print(base.length().to_string())
    print(report(extend([6], "4")))
    print(report(extend([5], "y")))
    0
