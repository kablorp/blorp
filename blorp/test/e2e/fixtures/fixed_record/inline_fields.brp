fixed union Signal:
    Quiet
    Level(Int)
    Ratio(Float)
fixed record Reading { signal: Signal, valid: Bool, count: Int }
fixed record Pair { first: Reading, second: Reading }
pure func level(reading: Reading) -> Int:
    match reading.signal:
        Quiet: 0
        Level(value): value
        Ratio(_): 1
pure func counted(reading: Reading) -> Int:
    if reading.valid:
        reading.count
    else:
        0
func main() -> Int:
    first: Reading = { signal = Level(20), valid = True, count = 2 }
    second: Reading = { first | signal = Ratio(0.5), valid = False }
    pair: Pair = { first = first, second = second }
    same = if pair.first == { second | signal = Level(20), valid = True }:
        10
    else:
        0
    level(pair.first).add(level(pair.second)).add(counted(pair.first)).add(counted(pair.second)).add(same).add(pair.second.count)
