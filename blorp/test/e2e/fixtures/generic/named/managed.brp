import:
    int as Numbers
    io: print
    string: add

pure func identity[T](value: T) -> T:
    value

pure func apply[T, U](value: T, f: pure (T) -> U) -> U:
    f(value)

pure func forward[T, U](value: T, f: pure (T) -> U) -> U:
    apply(value, f)

pure func zero[T](f: pure () -> T) -> T:
    f()

pure func unit() -> Void:
    void

pure func message() -> String:
    "é".add("\0")

pure func absent() -> Option[String]:
    None

pure func map_get[T, U](self: Option[T], f: pure (T) -> U, default_val: U) -> U:
    match self:
        Some(value): f(value)
        None: default_val

func fallback() -> String:
    print("eager")
    "fallback".add("!")

func main() -> Void:
    shared = message()
    saved = shared
    result = Some(shared).map_get(identity, fallback())
    print(forward(result, identity))
    print(saved)
    print(absent().map_get(identity, fallback()))
    print(zero(message))
    forward(void, identity)
    zero(unit)
    print(forward(42, Numbers.to_string))
