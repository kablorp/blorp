union Choice[T]:
    Empty
    Value(T)

pure func empty[T]() -> Choice[T]:
    Empty

pure func identity[T](value: T) -> T:
    value

pure func forward[T]() -> Choice[T]:
    identity(empty())

pure func make_choice() -> Choice[Int]:
    forward()

func main() -> Int:
    match make_choice():
        Empty: 7
        Value(value): value
