import:
    int as int_ops


pure func apply[T, U](callback: pure (T) -> U, value: T) -> U:
    callback(value)


pure func forward[T, U](callback: pure (T) -> U, value: T) -> U:
    apply(callback, value)


pure func offset(value: Int, amount: Int) -> Int:
    forward(pure func(item: Int) -> Int: int_ops.add(item, amount), value)


func main() -> Int:
    offset(offset(39, 1), 2)
