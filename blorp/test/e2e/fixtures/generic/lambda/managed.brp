import:
	io: print
	string: add

pure func apply[T, U](f: pure (T) -> U, value: T) -> U:
	f(value)

func main() -> Void:
	original = "é".add("\0")
	original_alias = original
	returned = apply(pure func(text: String) -> String: text, original)
	unused = apply(pure func(text: String) -> String: text, original)
	print(original)
	print(original_alias)
	print(returned)
