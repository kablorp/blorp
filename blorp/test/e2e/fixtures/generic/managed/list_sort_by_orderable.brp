import:
    list: sort_by
    io: print

record Entry { weight: Float, version: Version, ordinal: Int, label: String }

-- Ordered by major, then minor, through its written less_than only.
record Version { major: Int, minor: Int }

implements Orderable for Version:
    pure func less_than(left: Self, right: Self) -> Bool:
        if left.major == right.major:
            left.minor < right.minor
        else:
            left.major < right.major

pure func weight_key(value: Entry) -> Float:
    value.weight

pure func version_key(value: Entry) -> Version:
    value.version

pure func ordinal_key(value: Entry) -> Int:
    value.ordinal

-- A caller forwards its own Orderable bound to sort_by.
pure func sorted_by[Item, Key: Orderable](values: List[Item], key: pure (Item) -> Key) -> List[Item]:
    sort_by(values, key)

pure func labels(values: List[Entry]) -> String:
    var text = ""
    for value in values:
        text = "${text}${value.label}"
    text

func main() -> Int:
    -- 0.0 and -0.0 compare equal, so C keeps its place before D; ordering -0.0
    -- first would print BDCA.
    values: List[Entry] = [
        { weight = 2.5, version = { major = 1, minor = 2 }, ordinal = 0, label = "A" },
        { weight = -1.0, version = { major = 0, minor = 9 }, ordinal = 1, label = "B" },
        { weight = 0.0, version = { major = 1, minor = 0 }, ordinal = 2, label = "C" },
        { weight = -0.0, version = { major = 1, minor = 2 }, ordinal = 3, label = "D" }
    ]
    print(labels(sort_by(values, weight_key)))
    print(labels(sort_by(values, version_key)))
    print(labels(sorted_by(values, weight_key)))
    print(labels(values))
    -- NaN keys break the total order Orderable assumes. The result is still a
    -- permutation of the input, though its order is unspecified.
    infinity: Float = 1.0e308.multiply(10.0)
    nan: Float = infinity.subtract(infinity)
    unordered: List[Entry] = [
        { weight = nan, version = { major = 0, minor = 0 }, ordinal = 0, label = "W" },
        { weight = 1.0, version = { major = 0, minor = 0 }, ordinal = 1, label = "X" },
        { weight = nan, version = { major = 0, minor = 0 }, ordinal = 2, label = "Y" },
        { weight = 0.0, version = { major = 0, minor = 0 }, ordinal = 3, label = "Z" }
    ]
    print(labels(sort_by(sort_by(unordered, weight_key), ordinal_key)))
    0
