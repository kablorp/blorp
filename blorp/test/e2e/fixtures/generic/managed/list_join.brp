import:
    list: join, repeat, get
    string: add, length
    int as IntOps
    io: print

pure func escaped() -> String:
    join([add("é", "\0"), add("😀", "")], "|")

func main() -> Int:
    print(join(repeat("", 0), ","))
    print(["solo"].join("ignored"))
    print(join(["", "", ""], "/"))
    print(join(["a", "b", "c"], ""))
    print(join(["a", "", "c"], "::"))
    value = add("left", "!")
    original_values = [value, value]
    separator = add("§", "\0")
    print(join(original_values, separator))
    print(escaped())
    print(value)
    print(separator)
    match get(original_values, 0):
        Some(selected): print(selected)
        None: print("missing")
    print(IntOps.to_string(length(join(repeat("x", 1024), ":"))))
    0
