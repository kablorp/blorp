import:
    option: map, get_or
    result as Results
    io: print
    int as Numbers
    string: add

pure func identity[T](value: T) -> T:
    value

pure func forward_map[T, U](value: Option[T], callback: pure (T) -> U) -> Option[U]:
    map(value, callback)

pure func decorate(value: String) -> String:
    value.add("!")

pure func result_text(value: Result[String, String]) -> String:
    match value:
        Ok(payload): payload
        Err(error): error

pure func error_text(value: Result[String, Int]) -> String:
    match value:
        Ok(payload): payload
        Err(error): Numbers.to_string(error)

pure func absent() -> Option[String]:
    None

pure func good() -> Result[Int, String]:
    Ok(7)

pure func failure() -> Result[Int, String]:
    Err("unchanged".add("!"))

pure func failed_unit() -> Result[String, Void]:
    Err(void)

pure func kept() -> Result[String, Void]:
    Ok("kept".add("!"))

pure func error_code(value: Void) -> Int:
    42

pure func chain(value: Int) -> Result[String, String]:
    Err(Numbers.to_string(value).add("!"))

pure func start_chain() -> Result[Int, String]:
    Ok(8)

pure func bad_chain() -> Result[Int, String]:
    Err("bypass".add("!"))

pure func consume(value: String) -> Void:
    void

pure func unit_text(value: Void) -> String:
    "unit".add("!")

pure func escaped(value: String) -> String:
    get_or(forward_map(Some(value), decorate), "fallback")

func evaluated() -> Option[String]:
    print("receiver")
    Some("eager".add("!"))

func main() -> Int:
    shared = Numbers.to_string(42).add("é\0")
    saved = shared
    print(escaped(shared))
    print(saved)
    print(get_or(forward_map(absent(), decorate), "none"))
    print(result_text(Results.map(good(), Numbers.to_string)))
    print(result_text(Results.map(failure(), Numbers.to_string)))
    print(error_text(Results.map_err(failed_unit(), error_code)))
    print(error_text(Results.map_err(kept(), error_code)))
    print(result_text(Results.and_then(start_chain(), chain)))
    print(result_text(Results.and_then(bad_chain(), chain)))
    get_or(map(Some("retire".add("!")), consume), void)
    print(get_or(map(Some(void), unit_text), "no-unit"))
    print(get_or(map(evaluated(), identity), "no-eager"))
    0
