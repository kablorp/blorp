union Box[T]:
	Box(T)
pure func box[T](value: T) -> Box[T]:
	Box(value)
pure func unbox[T](value: Box[T]) -> T:
	match value:
		Box(payload): payload
union Flag:
	Off
	On
pure func off() -> Flag:
	Off
pure func on() -> Flag:
	On
pure func read(value: Flag) -> Int:
	match value:
		Off: 7
		On: 9
func main() -> Int:
	read(unbox(box(on())))
