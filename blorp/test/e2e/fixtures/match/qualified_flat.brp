import:
    ../namespace/shapes as Shapes
    int: add
    io: print

pure func number(shape: Shapes.Shape) -> Int:
    match shape:
        Shapes.Circle(value):
            kept_value = value
            kept_value
        Shapes.Square(value): value

pure func flag_value(value: Shapes.Flag) -> Int:
    match value:
        Shapes.On: 1
        Shapes.Off(): 0

func main() -> Int:
    print(number(Shapes.Circle(42)).to_string())
    print(number(Shapes.Square(7)).to_string())
    print(flag_value(Shapes.On).to_string())
    print(flag_value(Shapes.Off).to_string())
    add(0, 0)
