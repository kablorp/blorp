-- Int literal patterns at the root, in a constructor field, a tuple element
-- and a List element, in alternatives, under a recursive variant and at the
-- Int64 extremes. Each check sets one bit when every arm it reaches returns
-- its expected digit, so the exit status is 127 and names any failed check.
union Exit:
    Exited(Int)
    Signaled(Int)
union Chain:
    Link(Int, Chain)
    End
pure func root(count: Int) -> Int:
    match count:
        0: 1
        -1: 2
        _: 3
pure func code(exit: Exit) -> Int:
    match exit:
        Exited(0): 1000
        Exited(status): status
        Signaled(signal): 128 + signal
pure func first(pair: (Int, Int)) -> Int:
    match pair:
        (0, _): 1
        (_, 0): 2
        _: 3
pure func head(values: List[Int]) -> Int:
    match values:
        [0, ...rest]: rest.length()
        [_, 0]: 7
        _: 9
pure func small(count: Int) -> Int:
    match count:
        0 | 1: 1
        2 | 3: 2
        _: 3
pure func zeros(chain: Chain) -> Int:
    match chain:
        Link(0, rest): 1 + zeros(rest)
        Link(_, rest): zeros(rest)
        End: 0
pure func extreme(value: Int) -> Int:
    match value:
        -9223372036854775808: 1
        9223372036854775807: 2
        _: 3
pure func bit(passed: Bool, weight: Int) -> Int:
    if passed:
        weight
    else:
        0
func main() -> Int:
    roots = root(0) * 100 + root(-1) * 10 + root(7)
    codes = code(Exited(0)) + code(Exited(5)) + code(Signaled(2))
    firsts = first((0, 9)) * 1000 + first((9, 0)) * 100 + first((9, 9)) * 10 + first((0, 0))
    heads = head([0, 4, 5]) * 10000 + head([0]) * 1000 + head([3, 0]) * 100 + head([3]) * 10 + head([])
    smalls = small(0) * 10000 + small(1) * 1000 + small(2) * 100 + small(3) * 10 + small(4)
    chained = zeros(Link(0, Link(5, Link(0, End)))) * 10 + zeros(End)
    extremes = extreme(-9223372036854775808) * 1000 + extreme(9223372036854775807) * 100 + extreme(0) * 10 + extreme(-9223372036854775807)
    bit(roots == 123, 1) + bit(codes == 1135, 2) + bit(firsts == 1231, 4) + bit(heads == 20799, 8) + bit(smalls == 11223, 16) + bit(chained == 20, 32) + bit(extremes == 1233, 64)
