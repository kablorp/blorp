            (
                "generic constant reads preserve NUL bytes and negative zero",
                func(): run_program(
                    prints(
                        "constant_managed_generic",
                        "constant/managed_generic",
                        { allocations = 122162, instructions = 492851149 },
                        "kept λ\0kept λ\0\nkept λ\0kept λ\0\n-0\n",
                        7,
                    ),
                ),
            ),
            (
                "record tuple List and named callback materialize twice",
                func(): run_program(
                    prints(
                        "constant_aggregate",
                        "constant/aggregate",
                        { allocations = 124897, instructions = 499300861 },
                        "seven\nright\n7\n",
