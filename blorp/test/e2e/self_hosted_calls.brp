                        { allocations = 104724, instructions = 596532276 },
                        7,
                        0,
                    ),
                ),
            ),
            (
                "binding self call",
                func(): run_program(
                    exits_with(
                        "recursion_binding",
                        "recursion/binding",
                        { allocations = 104572, instructions = 592474239 },
