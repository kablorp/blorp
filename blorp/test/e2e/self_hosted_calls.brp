            (
                "pipe String constant retains line breaks",
                func(): run_program(
                    prints(
                        "constant_pipe",
                        "constant/pipe",
                        { allocations = 119722, instructions = 485714543 },
                        "hello λ\nsecond line\n",
                        1,
                    ),
                ),
            ),
            (
                "materialized aliases survive reassignment",
                func(): run_program(
                    prints(
                        "constant_aliases",
                        "constant/aliases",
                        { allocations = 120356, instructions = 489110421 },
                        "old λ\nnew λ\nold λ\n",
                        3,
