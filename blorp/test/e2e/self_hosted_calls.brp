-- Native cases for calls, recursion, constants and Int: each program compiles
-- once within its ceiling, then runs with exact stdout, status and strict
-- allocation counts.
import:
    result: Result methods
    string: String methods
    test: TestSuite
    ./file_access: write_file
    ./self_hosted_harness:
        CompileCeiling,
        CompileInput(SingleSource),
        FIXTURES,
        LIBRARY_ROOT,
        NativeRun,
        Program,
        Rejection,
        exits_with,
        fixture_program,
        once,
        prints,
        repeated,
        reported,
        verify_program,
        verify_rejection,
        verify_unpublished_rejection,
        with_arguments,


-- Every program's compile ceiling is its measured cost plus 15%, rounded up to
-- a whole count: allocations from the compiler's strict report, retired
-- instructions (the larger of two serial runs) from /usr/bin/time -l, both for
-- the -O0 compiler under test. The commit that changes a ceiling states the
-- measured cost in its message.


private pure func nines(count: Int) -> String:
    repeated("9", count)


private pure func constant_rejection(
    name: String,
    fixture: String,
    location: String,
    message: String,
    help: String,
) -> Rejection:
    {
        name = name,
        source = FIXTURES + "constant/" + fixture + ".brp",
        diagnostic = ":" + location + ": error: " + message + "\nhelp: " + help + "\n",
    }


-- User-written function names, even ones a C compiler reserves or the emitter
-- numbers, are not C symbols: the program links and returns what it calls.
private WRITTEN_NAMES: String = "func main() -> Int:\n    int()\nfunc int() -> Int:\n    blorp_f_0()\nfunc blorp_f_0() -> Int:\n    1\n"


private func verify_written_names(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
) -> Result[Void, String]:
    source = work_directory + "/written_names.brp"
    _ ?= write_file(source, WRITTEN_NAMES)
    verify_program(compiler, c_compiler, work_directory, check_instructions, {
        name = "written_names",
        input = SingleSource(source),
        library_root = LIBRARY_ROOT,
        ceiling = { allocations = 119095, instructions = 465623628 },
        runs = once(1, "", 0),
    })


-- An integer literal one past the Int64 maximum.
private func verify_out_of_range_literal(
    compiler: String,
    work_directory: String,
) -> Result[Void, String]:
    verify_unpublished_rejection(
        compiler,
        work_directory,
        "overflow",
        "func main() -> Int:\n\t9223372036854775808\n",
        ":2:2: error: integer literal is outside the Int64 range\nhelp: use a value from -9223372036854775808 to 9223372036854775807\n",
    )


func suite(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
) -> TestSuite:
    run_program = func(program: Program) -> Bool: reported(
        verify_program(compiler, c_compiler, work_directory, check_instructions, program),
    )
    reject = func(rejection: Rejection) -> Bool: reported(
        verify_rejection(compiler, work_directory, rejection),
    )
    {
        description = "Blorp calls, recursion, constants and Int",
        tests = [
            (
                "return zero",
                func(): run_program(
                    exits_with(
                        "return_zero",
                        "return/zero",
                        { allocations = 118542, instructions = 466401718 },
                        0,
                        0,
                    ),
                ),
            ),
            (
                "blank lines and comments",
                func(): run_program(
                    exits_with(
                        "lexical_trivia",
                        "syntax/trivia",
                        { allocations = 118542, instructions = 462875908 },
                        0,
                        0,
                    ),
                ),
            ),
            (
                "call one native execution and compilation cost",
                func(): run_program(
                    exits_with(
                        "call_one",
                        "call/one",
                        { allocations = 118827, instructions = 464935621 },
                        1,
                        0,
                    ),
                ),
            ),
            (
                "written names do not become C symbols",
                func(): reported(
                    verify_written_names(compiler, c_compiler, work_directory, check_instructions),
                ),
            ),
            (
                "wrapper order and unused parameters execute natively",
                func(): run_program(
                    exits_with(
                        "nested_order",
                        "nested/order",
                        { allocations = 119383, instructions = 466101598 },
                        0,
                        0,
                    ),
                ),
            ),
            (
                "nested calls native execution and cost",
                func(): run_program(
                    exits_with(
                        "nested_calls",
                        "nested/calls",
                        { allocations = 119242, instructions = 465566124 },
                        1,
                        0,
                    ),
                ),
            ),
            (
                "pure calls native execution and cost",
                func(): run_program(
                    exits_with(
                        "pure_calls",
                        "pure/calls",
                        { allocations = 119112, instructions = 466075768 },
                        1,
                        0,
                    ),
                ),
            ),
            (
                "self call",
                func(): run_program(
                    exits_with(
                        "recursion_self",
                        "recursion/self",
                        { allocations = 119933, instructions = 466845030 },
                        7,
                        0,
                    ),
                ),
            ),
            (
                "mutual calls",
                func(): run_program(
                    exits_with(
                        "recursion_mutual",
                        "recursion/mutual",
                        { allocations = 120920, instructions = 469538739 },
                        7,
                        0,
