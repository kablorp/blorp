                func(): run_program(
                    exits_with(
                        "recursion_argument",
                        "recursion/argument",
                        { allocations = 120337, instructions = 469093102 },
                        7,
                        0,
                    ),
                ),
            ),
            (
                "binding self call",
                func(): run_program(
                    exits_with(
                        "recursion_binding",
                        "recursion/binding",
                        { allocations = 120182, instructions = 468379928 },
                        7,
                        0,
                    ),
                ),
            ),
            (
