private union NativeMode:
    NormalNative
    StrictNative


-- A fixture the compiler must reject with exactly this diagnostic text.
record Rejection {
    name: String,
    source: String,
    diagnostic: String
}


private pure func expect(actual: String, expected: String, description: String) -> Result[Void, String]:
    if actual.equals(expected):
        Ok(void)
    else:
        Err(description + ": expected [" + expected + "], got [" + actual + "]")


func command(arguments: List[String], prefix: String, expected_status: Int, timeout_ms: Int) -> Result[Void, String]:
    actual: Int ?= run_to_files(ENVIRONMENT_TOOL, arguments, prefix + ".stdout", prefix + ".stderr", timeout_ms).map_err(pure func(error: String): prefix + ": " + error)
    if actual.equals(expected_status):
        Ok(void)
    else:
        match read_text(prefix + ".stderr").map_err(describe):
            Ok(captured): Err(prefix + ": expected exit " + expected_status.to_string() + ", got " + actual.to_string() + ": " + captured)
            Err(error): Err(error)


-- Returns the compile's allocations, from its strict report. With
-- `check_instructions` the compiler runs under the process timer, which writes
-- what it cost to `prefix.instructions`. `inputs` are the compiler arguments
-- between the library root and the output.
private func compile_timed(check_instructions: Bool, compiler: String, inputs: List[String], prefix: String) -> Result[Int, String]:
    timer = if check_instructions:
        [PROCESS_TIMER, "-l", "-o", prefix + ".instructions"]
    else:
        []
    _ ?= command(
        ["-u", "BLORP_MEMORY_STATS", "BLORP_LEAK_CHECK=strict"].concat(timer).concat([compiler,
         "--library-root", LIBRARY_ROOT]).concat(inputs).concat([prefix + ".c"]),
        prefix + ".compile", 0, COMPILATION_TIMEOUT_MS,
    )
    output: String ?= read_text(prefix + ".compile.stdout").map_err(describe)
    _ ?= expect(output, "", "compiler stdout")
    report: String ?= read_text(prefix + ".compile.stderr").map_err(describe)
    allocations: Int ?= positive_allocations(report)
    generated: String ?= read_text(prefix + ".c").map_err(describe)
    if generated.length().equals(0):
        Err("successful compilation emitted empty C")
    else:
        Ok(allocations)


private func link_fixture(c_compiler: String, prefix: String, mode: NativeMode) -> Result[Void, String]:
    (suffix, definition) = match mode:
        NormalNative: (".normal", "-DBLORP_MEMORY_DIAGNOSTICS=0")
        StrictNative: (".strict", "-DBLORP_MEMORY_DIAGNOSTICS=1")
    binary = prefix + suffix
    _ ?= command(
        WITHOUT_DIAGNOSTICS.concat([c_compiler,
         "-std=c11", "-Wall", "-Wextra", "-Werror", "-pedantic", "-O0",
         "-fsanitize=address,undefined", "-fno-sanitize-recover=all",
         definition,
         prefix + ".c", "-o", binary, "-lm", "-lpthread"]),
        binary + ".link", 0, COMPILATION_TIMEOUT_MS,
    )
    stdout: String ?= read_text(binary + ".link.stdout").map_err(describe)
    _ ?= expect(stdout, "", "C compiler stdout")
    stderr: String ?= read_text(binary + ".link.stderr").map_err(describe)
    expect(stderr, "", "C compiler stderr")


-- One native invocation. A run that shares its fixture with others has a
-- `label` naming its capture files and error text; `directory` is where the
-- program starts (None keeps the runner's own).
record NativeRun {
    label: Option[String],
    arguments: List[String],
    directory: Option[String],
    status: Int,
    stdout: String,
    allocations: Int
}


-- The shell only changes directory and then replaces itself with the program.
private CHANGE_DIRECTORY: String = "cd \"$1\" && shift && exec \"$@\""


private pure func launch(binary: String, run: NativeRun) -> List[String]:
    match run.directory:
        None: [binary].concat(run.arguments)
        Some(directory): [SHELL, "-c", CHANGE_DIRECTORY, "sh", directory, binary].concat(run.arguments)


private pure func label_suffix(run: NativeRun) -> String:
    match run.label:
        None: ""
        Some(label): "." + label


private func run_normal(prefix: String, run: NativeRun) -> Result[Void, String]:
    capture = prefix + label_suffix(run)
    _ ?= command(
        WITHOUT_DIAGNOSTICS.concat(launch(prefix + ".normal", run)),
        capture + ".normal.run", run.status, NATIVE_TIMEOUT_MS,
    )
    output: String ?= read_text(capture + ".normal.run.stdout").map_err(describe)
    _ ?= expect(output, run.stdout, "native stdout" + label_suffix(run))
    errors: String ?= read_text(capture + ".normal.run.stderr").map_err(describe)
    expect(errors, "", "native stderr" + label_suffix(run))


private func run_strict(prefix: String, run: NativeRun) -> Result[Void, String]:
    capture = prefix + label_suffix(run)
    _ ?= command(
        ["-u", "BLORP_MEMORY_STATS", "BLORP_LEAK_CHECK=strict"].concat(launch(prefix + ".strict", run)),
        capture + ".strict.run", run.status, NATIVE_TIMEOUT_MS,
    )
    strict_output: String ?= read_text(capture + ".strict.run.stdout").map_err(describe)
    _ ?= expect(strict_output, run.stdout, "strict native stdout" + label_suffix(run))
    accounting: String ?= read_text(capture + ".strict.run.stderr").map_err(describe)
    expected = ("blorp: leak check: " + run.allocations.to_string() + " allocs, ") + run.allocations.to_string() + " releases, 0 leaked, 0 bytes\n"
    expect(accounting, expected, "strict native accounting" + label_suffix(run))


private func run_fixture(prefix: String, run: NativeRun) -> Result[Void, String]:
    _ ?= run_normal(prefix, run)
    run_strict(prefix, run)


-- Runs the binaries as every entry of `runs`, in order, until one fails.
private func run_all(prefix: String, runs: List[NativeRun], run_one: (String, NativeRun) -> Result[Void, String]) -> Result[Void, String]:
    var outcome: Result[Void, String] = Ok(void)
    for run in runs:
        match outcome:
            Ok(_): outcome = run_one(prefix, run)
            Err(_): void
    outcome


-- What one compilation may cost the compiler under test. The allocations come
-- from its strict report and are always held; the retired instructions come from
-- the process timer and are held only when the run asks for them. Each ceiling
-- is its program's measured cost plus 15%; a ceiling changes only with a new
-- record in benchmarks/results/blorp_2_e2e_ceilings_2026-11-05.md.
record CompileCeiling {
    allocations: Int,
    instructions: Int
}


-- What the compiler is given: one program, or `--test-suite` roots, whose first
-- root owns the entry and whose later roots follow it in command-line order.
union CompileInput:
    SingleSource(String)
    SuiteRoots(String, List[String])


-- A program that compiles once, within `ceiling`, and then runs as every entry
-- of `runs`, in order.
record Program {
    name: String,
    input: CompileInput,
    ceiling: CompileCeiling,
    runs: List[NativeRun]
}


-- The compiler arguments between the library root and the output.
private pure func compiler_inputs(input: CompileInput) -> List[String]:
    match input:
        SingleSource(source): [source]
        SuiteRoots(entry, grouped): ["--test-suite", entry].concat(grouped)


private func instructions_within(prefix: String, ceiling: CompileCeiling) -> Result[Void, String]:
    timing: String ?= read_text(prefix + ".instructions").map_err(describe)
    instructions: Int ?= parse_instructions(timing)
    within_ceiling("compile retired instructions", instructions, ceiling.instructions)


private func compile_within(compiler: String, check_instructions: Bool, inputs: List[String], prefix: String, ceiling: CompileCeiling) -> Result[Void, String]:
    allocations: Int ?= compile_timed(check_instructions, compiler, inputs, prefix)
    _ ?= within_ceiling("compile allocations", allocations, ceiling.allocations)
    if check_instructions:
        instructions_within(prefix, ceiling)
    else:
        Ok(void)


-- Compiles the program within its ceiling and links it without and with
-- diagnostics, returning the prefix of its files.
private func build_program(compiler: String, c_compiler: String, work_directory: String, check_instructions: Bool, program: Program) -> Result[String, String]:
    prefix = work_directory + "/" + program.name
    _ ?= compile_within(compiler, check_instructions, compiler_inputs(program.input), prefix, program.ceiling)
    _ ?= link_fixture(c_compiler, prefix, NormalNative)
    _ ?= link_fixture(c_compiler, prefix, StrictNative)
    Ok(prefix)


func verify_program(compiler: String, c_compiler: String, work_directory: String, check_instructions: Bool, program: Program) -> Result[Void, String]:
    prefix: String ?= build_program(compiler, c_compiler, work_directory, check_instructions, program)
    run_all(prefix, program.runs, run_fixture)


-- The ways to declare a program's runs. `once` is a program with one run and
-- no arguments, `once_given` one with arguments after the program name;
-- `with_arguments` is one of several runs, and `label` names its captures.
-- `exits_with` prints nothing; `prints` exits 0.
pure func once_given(arguments: List[String], status: Int, stdout: String, allocations: Int) -> List[NativeRun]:
    [{ label = None, arguments = arguments, directory = None, status = status, stdout = stdout, allocations = allocations }]


pure func once(status: Int, stdout: String, allocations: Int) -> List[NativeRun]:
    once_given([], status, stdout, allocations)


pure func with_arguments(label: String, arguments: List[String], status: Int, stdout: String, allocations: Int) -> NativeRun:
    { label = Some(label), arguments = arguments, directory = None, status = status, stdout = stdout, allocations = allocations }


private pure func fixture_path(fixture: String) -> String:
    FIXTURES + fixture + ".brp"


-- `fixture` is a path under FIXTURES, without the extension.
pure func fixture_program(name: String, fixture: String, ceiling: CompileCeiling, runs: List[NativeRun]) -> Program:
    { name = name, input = SingleSource(fixture_path(fixture)), ceiling = ceiling, runs = runs }


-- A `--test-suite` program over fixtures, without the extension; `entry` owns
-- the entry and `grouped` follow it.
pure func suite_program(name: String, entry: String, grouped: List[String], ceiling: CompileCeiling, runs: List[NativeRun]) -> Program:
    { name = name, input = SuiteRoots(fixture_path(entry), grouped.map(fixture_path)), ceiling = ceiling, runs = runs }


pure func exits_with(name: String, fixture: String, ceiling: CompileCeiling, status: Int, allocations: Int) -> Program:
    fixture_program(name, fixture, ceiling, once(status, "", allocations))


pure func prints(name: String, fixture: String, ceiling: CompileCeiling, stdout: String, allocations: Int) -> Program:
    fixture_program(name, fixture, ceiling, once(0, stdout, allocations))


-- A rejected compilation publishes nothing: it creates no C file where there
-- was none, and leaves an existing one as it was. `diagnostic` follows the
-- source path in the compiler's message.
func verify_unpublished_rejection(compiler: String, work_directory: String, name: String, text: String, diagnostic: String) -> Result[Void, String]:
    prefix = work_directory + "/" + name
    source = prefix + ".brp"
    output = prefix + ".c"
    _ ?= write_text(source, text).map_err(describe)
    _ ?= expect_failure(compiler, compile_arguments(source, output), prefix, source + diagnostic)
    created: Option[EntryKind] ?= entry_kind(output).map_err(describe)
    unpublished: Void ?= match created:
        None: Ok(void)
        Some(_): Err("a rejected compilation created " + output)
    _ ?= write_text(output, PRESERVED_OUTPUT).map_err(describe)
    _ ?= expect_failure(compiler, compile_arguments(source, output), prefix + ".existing", source + diagnostic)
    unchanged: String ?= read_text(output).map_err(describe)
    expect(unchanged, PRESERVED_OUTPUT, "rejected output sentinel")


private func rejected_fixture(compiler: String, work_directory: String) -> Result[Void, String]:
    verify_unpublished_rejection(
        compiler, work_directory, "rejected", "func start() -> Int:\n    0\n",
        ":3:1: error: expected a main function\nhelp: declare func main() -> Int: as the entrypoint\n",
    )


-- The compiler, given exactly `arguments`, exits 1 with nothing on stdout and
-- exactly this stderr.
func expect_failure(compiler: String, arguments: List[String], prefix: String, expected_stderr: String) -> Result[Void, String]:
    _ ?= command(
        WITHOUT_DIAGNOSTICS.concat([compiler]).concat(arguments),
        prefix + ".compile", 1, COMPILATION_TIMEOUT_MS,
    )
    stdout: String ?= read_text(prefix + ".compile.stdout").map_err(describe)
    _ ?= expect(stdout, "", "failed compiler stdout")
    stderr: String ?= read_text(prefix + ".compile.stderr").map_err(describe)
    expect(stderr, expected_stderr, "failed compiler diagnostic")


-- The arguments of an ordinary compilation of `source` to `output`.
private pure func compile_arguments(source: String, output: String) -> List[String]:
    ["--library-root", LIBRARY_ROOT, source, output]


-- fs words the failure, naming the output path the compiler was given.
private func directory_output_fixture(compiler: String, work_directory: String) -> Result[Void, String]:
    source = work_directory + "/directory_output.brp"
    _ ?= write_text(source, "func main() -> Int:\n    0\n").map_err(describe)
    expect_failure(
        compiler, compile_arguments(source, work_directory), work_directory + "/directory_output",
        "blorp_2: error: could not write " + work_directory + ": is a directory\nhelp: provide a writable output path\n",
    )


-- fs words the failure, naming the module path the loader resolved.
private func missing_module_fixture(compiler: String, work_directory: String) -> Result[Void, String]:
    source = work_directory + "/missing_module.brp"
    _ ?= write_text(source, "import:\n    ./missing: thing\nfunc main() -> Int:\n    0\n").map_err(describe)
    expect_failure(
        compiler, compile_arguments(source, work_directory + "/missing_module.c"), work_directory + "/missing_module",
        source + ":2:5: error: could not read module " + work_directory + "/missing.brp: no such file\nhelp: check the import path and provide a readable .brp file under its source root\n",
    )


func verify_rejection(compiler: String, work_directory: String, rejection: Rejection) -> Result[Void, String]:
    prefix = work_directory + "/" + rejection.name
    expect_failure(compiler, compile_arguments(rejection.source, prefix + ".c"), prefix, rejection.source + rejection.diagnostic)


private pure func generic_opaque(name: String, diagnostic: String) -> Rejection:
    { name = "opaque_" + name, source = "blorp/test/e2e/fixtures/opaque/generic/" + name + ".brp", diagnostic = diagnostic }


private RECURSIVE_AGGREGATE: String = " error: recursive aggregate types are not supported yet\nhelp: use finite record and union fields; recursion is supported through a record field, a List element or one direct self payload of a non-generic union, such as Next(Node)\n"


private RECURSIVE_OPAQUE: String = " error: recursive opaque representations are not supported yet\nhelp: wrap an independently recursive aggregate instead of referring back to the opaque type\n"


func reported(result: Result[Void, String]) -> Bool:
    match result:
        Ok(_): True
        Err(error):
            print_error(error)
            False


-- The fs examples read, write and change trees that the prepare scripts build,
-- because no fs operation can create a file that is not UTF-8, a symlink, a
-- read-only file, a mode 000 directory or a FIFO. Where prepare.sh cannot build
-- its tree, as root, all three examples are reported as not run and left out,
-- so that they earn no PASS credit: each needs a user that file permissions
-- refuse.
private func fs_tree_tests(compiler: String, c_compiler: String, work_directory: String, check_instructions: Bool) -> List[(String, () -> Bool)]:
    tree = work_directory + "/fs_tree"
    write_tree = work_directory + "/fs_write_tree"
    directories_tree = work_directory + "/fs_directories_tree"
    prefix = work_directory + "/fs_prepare"
    read = fixture_program("fs_read", "fs/read", { allocations = 209287, instructions = 794591798 }, once_given([tree], 0, FS_READ_OUTPUT, 260))
    write = fixture_program("fs_write", "fs/write", { allocations = 201397, instructions = 770280418 }, once_given([write_tree], 0, FS_WRITE_OUTPUT, 223))
    directories = fixture_program("fs_directories", "fs/directories", { allocations = 292110, instructions = 1010595763 }, once_given([directories_tree], 0, FS_DIRECTORIES_OUTPUT, 574))
    match run_to_files(SHELL, [FS_PREPARE_SCRIPT, tree], prefix + ".stdout", prefix + ".stderr", NATIVE_TIMEOUT_MS):
        Err(error): [("the fs example tree is prepared", func(): reported(Err(error)))]
        Ok(status):
            if status.equals(FS_NOT_RUN_STATUS):
                print_error("fs examples not run: their trees need a user that file permissions refuse")
                []
            else if status.equals(0):
                [
                    ("fs read_text and entry_kind return each kind, and describe words each one", func(): reported(verify_program(compiler, c_compiler, work_directory, check_instructions, read))),
                    ("fs write_text replaces, creates and writes through a link, and returns each kind it can", func(): reported(verify_on_rebuilt_tree(compiler, c_compiler, work_directory, check_instructions, write, write_tree, FS_WRITE_PREPARE_SCRIPT))),
                    ("fs directory operations list, create, remove and rename, and return each kind they can", func(): reported(verify_on_rebuilt_tree(compiler, c_compiler, work_directory, check_instructions, directories, directories_tree, FS_DIRECTORIES_PREPARE_SCRIPT))),
                ]
            else:
                [("the fs example tree is prepared", func(): reported(Err(FS_PREPARE_SCRIPT + " exited " + status.to_string())))]


-- Rebuilds the directory a program that changes it is given, from nothing.
private func rebuilt_tree(script: String, directory: String, prefix: String) -> Result[Void, String]:
    status ?= run_to_files(SHELL, [script, directory], prefix + ".stdout", prefix + ".stderr", NATIVE_TIMEOUT_MS)
    if status.equals(0):
        Ok(void)
    else:
        Err(script + " exited " + status.to_string())


-- The write and directories programs change the directory they are given, so
-- each run's two executions get the directory, which is also the program's
-- argument, just rebuilt by its prepare script, and neither sees the other's
-- changes.
private func verify_on_rebuilt_tree(compiler: String, c_compiler: String, work_directory: String, check_instructions: Bool, program: Program, directory: String, script: String) -> Result[Void, String]:
    prefix: String ?= build_program(compiler, c_compiler, work_directory, check_instructions, program)
    run_all(prefix, program.runs, func(files: String, run: NativeRun): run_on_rebuilt_tree(files, run, directory, script))


private func run_on_rebuilt_tree(prefix: String, run: NativeRun, directory: String, script: String) -> Result[Void, String]:
    capture = prefix + label_suffix(run)
    _ ?= rebuilt_tree(script, directory, capture + ".normal.prepare")
    _ ?= run_normal(prefix, run)
    _ ?= rebuilt_tree(script, directory, capture + ".strict.prepare")
    run_strict(prefix, run)


func suite(compiler: String, c_compiler: String, work_directory: String, check_instructions: Bool) -> TestSuite:
    run_program = func(program: Program) -> Bool: reported(verify_program(compiler, c_compiler, work_directory, check_instructions, program))
    passing_suite_output = "\n>> registration Tests\n  [PASS] pure\neffect\n  [PASS] effect\n\nAll 2 tests passed\n"
    failing_suite_output = "\n>> continued registration Tests\nfirst\n  [FAIL] first case\nsecond\n  [PASS] second case\nthird\n  [FAIL] third case\n\n2 of 3 tests failed\n"
    phantom_mismatch = generic_opaque("phantom_mismatch", ":9:5: error: argument type does not match the parameter type\nhelp: use an expression of type Id[User] here\n")
    empty_needs_type = generic_opaque("empty_needs_type", ":3:11: error: cannot infer type parameter V of opaque type Box\nhelp: give into_opaque an expected type, as in value: Box[...] = into_opaque Box(...), or give from_opaque an operand whose Box type is known\n")
    field_access = generic_opaque("field_access", ":4:9: error: field access requires a record value\nhelp: read a declared record field, or use parentheses for a UFCS function call\n")
    method_access = generic_opaque("method_access", ":5:9: error: argument type does not match the parameter type\nhelp: use an expression of type List[Int] here\n")
    arity_missing = generic_opaque("arity_missing", ":2:18: error: generic opaque type requires one type argument\nhelp: write a concrete or symbolic application, such as Box[Int] or Box[T]\n")
    arity_count = generic_opaque("arity_count", ":2:18: error: opaque type argument count does not match its declaration\nhelp: expected 1 type arguments, got 2; supply types in declaration order\n")
    arity_nongeneric = generic_opaque("arity_nongeneric", ":2:19: error: ordinary opaque type does not accept a type argument\nhelp: remove the type argument from this opaque type\n")
    explicit_arguments = generic_opaque("explicit_arguments", ":3:20: error: opaque conversions take no type arguments\nhelp: write into_opaque Name(value) or from_opaque Name(value); the value and the expected type supply the arguments\n")
    foreign_wrap: Rejection = {
        name = "opaque_foreign",
        source = "blorp/test/e2e/fixtures/opaque/generic/foreign/main.brp",
        diagnostic = ":4:33: error: opaque values can be constructed only in their declaring module\nhelp: call a public constructor from the declaring module\n"
    }
    cycle_growing = generic_opaque("cycle_growing", ":3:20:" + RECURSIVE_OPAQUE)
    cycle_record = generic_opaque("cycle_record", ":1:21:" + RECURSIVE_OPAQUE)
    cycle_list = generic_opaque("cycle_list", ":1:20:" + RECURSIVE_OPAQUE)
    cycle_phantom = generic_opaque("cycle_phantom", ":2:20:" + RECURSIVE_OPAQUE)
    cycle_callable = generic_opaque("cycle_callable", ":1:20:" + RECURSIVE_OPAQUE)
    cycle_by_value = generic_opaque("cycle_by_value", ":3:7:" + RECURSIVE_AGGREGATE)
    cycle_two_self_payloads = generic_opaque("cycle_two_self_payloads", ":3:7:" + RECURSIVE_AGGREGATE)
    growing_recursion = generic_opaque("growing_recursion", ":5:16: error: recursive calls grow type arguments without bound\nhelp: pass recursive type arguments unchanged, permute them, or reset them to concrete types\n")
    private_specialization_index: Rejection = { name = "private_specialization_index", source = "blorp/test/e2e/fixtures/namespace/private_specialization_index.brp", diagnostic = ":2:44: error: IndexedList is private to ../../../../src/specialize/specialize\nhelp: remove private or import a public declaration\n" }
    unrestated_bound: Rejection = { name = "unrestated_bound", source = "blorp/test/e2e/fixtures/declaration_bounds/unrestated.brp", diagnostic = ":3:39: error: Keyed[K, V] requires K: Hashable\nhelp: add Hashable to K's bounds\n" }
    non_dict_key: Rejection = { name = "dict_non_dict_key", source = "blorp/test/e2e/fixtures/dict/non_dict_key.brp", diagnostic = ":7:20: error: Dict[Point, Int] requires Point: DictKey\nhelp: implement DictKey for Point, or use a type that implements it\n" }
    {
        description = "Self-hosted native e2e",
        tests = [
            ("nonzero native exit is preserved", func(): run_program(exits_with("nonzero", "return/23", { allocations = 102938, instructions = 588869119 }, 23, 0))),
            ("managed text stdout and strict accounting", func(): run_program(prints("text", "effects/hello", { allocations = 103971, instructions = 590084669 }, "Hello, World!\n", 1))),
            ("discard propagation preserves effects aliases and failures", func(): run_program(prints("discard", "result_propagation/discard", { allocations = 115183, instructions = 617223284 }, "once\nshared-value\n7\nerror-once\nkept-error\n", 12))),
            ("List growth preserves snapshots managed children and nested values", func(): run_program(prints("append_reuse", "list/append_reuse", { allocations = 129885, instructions = 593188164 }, "12\n0\n11\n12\n42 child\n42 child\n13\nnew\ntail\n12\n7\n13\nlast\ndone\n", 27))),
            ("List set and concat preserve snapshots aliases invalid indices and nested values", func(): run_program(prints("update_reuse", "list/update_reuse", { allocations = 125981, instructions = 587923543 }, "42 child\n42 child\n7 replacement\n42 child\n2\n7 replacement\n42 child\n42 child\n7 replacement\n2\n42 child\n4\n7 replacement\n42 child\n2\n4\n42 child\n4\n42 child\ndone\n", 28))),
            ("exact-sized List literal compiles without growth calls", func(): run_program(prints("literal", "list/literal_int", { allocations = 107682, instructions = 536327696 }, "3\n1\n3\n", 4))),
            ("empty literals share an immortal root that updates copy and drops ignore", func(): run_program(prints("static_empty", "list/static_empty", { allocations = 114527, instructions = 554921364 }, "1000\nfirst\n0\nfirst\n0\n5\nx\n0\n", 12))),
            ("inner-loop entry takes dying accumulators and preserves snapshots", func(): run_program(prints("loop_entry_accumulator", "list/loop_entry_accumulator", { allocations = 129524, instructions = 593893033 }, "20\n0\n19\n4\n0\n2\n4\n6\n3\n00\n21\n012012012\n", 29))),
            ("join arms take dying accumulators and preserve snapshots", func(): run_program(prints("branch_accumulator", "list/branch_accumulator", { allocations = 138190, instructions = 613170765 }, "20\n0\n190\n5\n0\n1\n2\n2\n5\n2\nodd\n0003006\n5\n7\n", 30))),
            ("Int and Float order through Orderable, NaN comparing false", func(): run_program(prints("orderable", "orderable/int_float", { allocations = 117585, instructions = 626235443 }, "1010\n0011\n0101\n1010\n0011\n0011\n1010\n0000\n0000\n0000\n0011\n", 24))),
            ("Int, Float and String arithmetic dispatch through the arithmetic traits", func(): run_program(prints("arithmetic_traits", "arithmetic/traits", { allocations = 127603, instructions = 566145065 }, ARITHMETIC_TRAITS_OUTPUT, 31))),
            ("checked Int arithmetic reports overflow and division by zero at each boundary", func(): run_program(prints("arithmetic_checked", "arithmetic/checked", { allocations = 131122, instructions = 663516407 }, ARITHMETIC_CHECKED_OUTPUT, 49))),
            ("each arithmetic operator calls its own canonical trait member", func(): run_program(prints("arithmetic_operators", "arithmetic/operators", { allocations = 139834, instructions = 685793030 }, ARITHMETIC_OPERATORS_OUTPUT, 115))),
            ("arithmetic operators evaluate operands once from left to right", func(): run_program(fixture_program("arithmetic_order", "arithmetic/order", { allocations = 112633, instructions = 613542729 }, once(23, "left\nright\nleft\nright\nleft\nright\nleft\nright\nleft\nright\noperand\n", 12)))),
            ("64 mixed-precedence arithmetic levels match ordinary calls under default limits", func(): run_program(exits_with("arithmetic_nesting", "arithmetic/nesting", { allocations = 184012, instructions = 818669257 }, 23, 1))),
            ("a 2,000-term sum and a 2,000-part String join compile and run", func(): run_program(prints("arithmetic_long_sum", "arithmetic/long_sum", { allocations = 919645, instructions = 4325835159 }, "2001000\n2000\n", 2003))),
            ("each ordering operator calls its own canonical Orderable member", func(): run_program(prints("ordering_operators", "ordering/operators", { allocations = 135980, instructions = 681803779 }, "1010\n0011\n0101\n1010\n0011\n0000\n0000\n0000\n1010\n0011\n0101\n0011\n0000\n1000\n0000\n1010\n0011\n", 36))),
            ("ordering operators evaluate operands once from left to right", func(): run_program(fixture_program("ordering_order", "ordering/order", { allocations = 110195, instructions = 606739024 }, once(23, "left\nright\nleft\nright\nleft\nright\nleft\nright\n", 9)))),
            ("64 grouped ordering comparisons and ordinary calls compile under default limits", func(): run_program(exits_with("ordering_nesting", "ordering/nesting", { allocations = 159126, instructions = 758790130 }, 23, 1))),
            ("an Ordered bound provides ==, equals and a default's supertrait call, dispatching a written Equatable", func(): run_program(prints("supertrait_entailment", "supertraits/entailment", { allocations = 122371, instructions = 615990753 }, "1101\n0011\n0010\n1101\n0011\n0010\n1101\n", 16))),
            ("a bodyless Ring bundle provides both supertraits' methods on Int and a record", func(): run_program(prints("supertrait_bundle", "supertraits/bundle", { allocations = 111357, instructions = 610701410 }, "56\n6,12\n", 5))),
            ("Box[Element: Ordered] entails its automatic equality's bound on Box[Box[Int]]", func(): run_program(prints("supertrait_generic_receiver", "supertraits/generic_receiver", { allocations = 112682, instructions = 530391900 }, "10\n01\n10\n", 5))),
            ("stable Int-key sorting preserves managed aliases and chained keys", func(): run_program(prints("sort_by", "generic/managed/list_sort_by", { allocations = 178691, instructions = 721588978 }, "0\nonly\nonly\nA\nB\nC\nB\nC\nA\nA\nmin1\nmin2\nmax\na\nx\nzz\n2\né\0\nmiddle\nlater\n", 45))),
            ("stable sort preserves every reversed element and nested owned aliases", func(): run_program(prints("sort_by_nested", "generic/managed/list_sort_by_nested_stress", { allocations = 140272, instructions = 604515369 }, SORT_BY_NESTED_OUTPUT, 811))),
