import:
    int: Int methods
    io/fs/entry: EntryKind(File)
    io/process: run_to_files
    list: List methods
    result: Result methods
    string: String methods
    test: TestSuite
    ./file_access: read_file, make_directories, kind_of, remove_tree
    ./self_hosted_harness: command, reported, ENVIRONMENT_TOOL, COMPILATION_TIMEOUT_MS
    ./self_hosted_selection:
        ComponentGroup,
        Tools,
        program_directory,
        compile_arguments,
        link_arguments,
        run_arguments,
        without_final_newline,


-- A component program runs every suite of one phase directory under strict
-- leak checking. Ten minutes is far above any observed run, and bounds a hang.
private COMPONENT_TIMEOUT_MS: Int = 600000
private PROGRAM_NAME: String = "all_suites"


private func require_source(source: String) -> Result[Void, String]:
    kind ?= kind_of(source)
    match kind:
        Some(File): Ok(void)
        Some(_): Err("component source is not a file: " + source)
        None: Err("component source does not exist: " + source)


private func require_sources(sources: List[String]) -> Result[Void, String]:
    var outcome: Result[Void, String] = Ok(void)
    for source in sources:
        match outcome:
            Ok(_): outcome = require_source(source)
            Err(_): void
    outcome


-- Capture files must be new, so a rerun starts from an empty directory. The
-- previous run's C and binary stay until then, for inspection.
private func empty_directory(directory: String) -> Result[Void, String]:
    existing ?= kind_of(directory)
    _ ?= match existing:
        Some(_): remove_tree(directory)
        None: Ok(void)
    make_directories(directory)


-- Prints what the program wrote, however it ended, so a crash or a timeout
-- keeps the output that explains it.
private func relay(prefix: String) -> Result[Void, String]:
    output ?= read_file(prefix + ".stdout")
    errors ?= read_file(prefix + ".stderr")
    if output.length() > 0:
        print(without_final_newline(output))
    if errors.length() > 0:
        print_error(without_final_newline(errors))
    Ok(void)


-- Not `command`: it quotes the program's stderr in its error, and relay has
-- already printed it.
private func run_program(program: String) -> Result[Void, String]:
    prefix = program + ".run"
    outcome = run_to_files(
        ENVIRONMENT_TOOL,
        run_arguments(program),
        prefix + ".stdout",
        prefix + ".stderr",
        COMPONENT_TIMEOUT_MS,
    )
    relayed = relay(prefix)
    status ?= outcome.map_err(pure func(error: String): program + ": " + error)
    if status.equals(0):
        relayed
    else:
        Err(program + ": exit " + status.to_string())


private func run_component(tools: Tools, group: ComponentGroup) -> Result[Void, String]:
    directory ?= program_directory(group)
    _ ?= require_sources(group.sources)
    _ ?= empty_directory(directory)
    program = directory + "/" + PROGRAM_NAME
    _ ?= command(
        compile_arguments(tools, group, program),
        program + ".compile",
        0,
        COMPILATION_TIMEOUT_MS,
    )
    _ ?= command(link_arguments(tools, program), program + ".link", 0, COMPILATION_TIMEOUT_MS)
    run_program(program)


-- One case per group, so a failure names the phase that owns it.
func suite(tools: Tools, groups: List[ComponentGroup]) -> TestSuite:
    {
        description = "Blorp component programs",
        tests = groups.map(
            pure func(group: ComponentGroup): (
                group.directory,
                func(): reported(run_component(tools, group)),
            ),
        ),
    }
