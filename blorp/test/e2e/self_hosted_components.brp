import:
    io/fs/entry: EntryKind(File)
    io/process: CaptureError, Command, Exit(Exited), capture
    list: List methods
    result: Result methods
    string: String methods
    test: TestSuite
    ./file_access: make_directories, kind_of, path_of
    ./self_hosted_harness: COMPILATION_TIMEOUT_MS, ending, isolated, reported, run_expecting
    ./self_hosted_selection:
        ComponentGroup,
        Tools,
        program_directory,
        compile_arguments,
        link_arguments,
        run_command,
        without_final_newline,


private PROGRAM_NAME: String = "all_suites"


private func require_source(source: String) -> Result[Void, String]:
    kind ?= kind_of(source)
    match kind:
        Some(File): Ok(void)
        Some(_): Err("component source is not a file: " + source)
        None: Err("component source does not exist: " + source)


private func require_sources(sources: List[String]) -> Result[Void, String]:
    var outcome: Result[Void, String] = Ok(void)
    for source in sources:
        match outcome:
            Ok(_): outcome = require_source(source)
            Err(_): void
    outcome


-- Not run_expecting: it prints what the program wrote, however it ended, so a
-- crash or a timeout keeps the output that explains it, and its error does not
-- quote that output again.
private func run_program(program: String, invocation: Command) -> Result[Void, String]:
    captured ?= capture(invocation).map_err(
        pure func(error: CaptureError) -> String: "${program}: ${error}",
    )
    if captured.stdout.length() > 0:
        print(without_final_newline(captured.stdout))
    if captured.stderr.length() > 0:
        print_error(without_final_newline(captured.stderr))
    if captured.exit == Exited(0):
        Ok(void)
    else:
        Err("${program}: ${captured.exit.ending(invocation.timeout_ms)}")


-- The previous run's C and binary stay in the program directory until this run
-- replaces them, for inspection.
private func run_component(tools: Tools, group: ComponentGroup) -> Result[Void, String]:
    directory ?= program_directory(group)
    _ ?= require_sources(group.sources)
    _ ?= make_directories(directory)
    program = directory + "/" + PROGRAM_NAME
    compile ?= isolated(tools.compiler, compile_arguments(group, program), COMPILATION_TIMEOUT_MS)
    _ ?= run_expecting(program + ".compile", compile, 0)
    link ?= isolated(tools.c_compiler, link_arguments(tools, program), COMPILATION_TIMEOUT_MS)
    _ ?= run_expecting(program + ".link", link, 0)
    binary ?= path_of(program)
    run_program(program, run_command(binary))


-- One case per group, so a failure names the phase that owns it.
func suite(tools: Tools, groups: List[ComponentGroup]) -> TestSuite:
    {
        description = "Blorp component programs",
        tests = groups.map(
            pure func(group: ComponentGroup): (
                group.directory,
                func(): reported(run_component(tools, group)),
            ),
        ),
    }
