import:
    bool: and
    fs: read_text
    int: Int methods
    io: describe
    process: run_to_files
    result: Result methods
    string: String methods
    test: TestSuite
    ./self_hosted_harness: CompileCeiling, NativeRun, fixture_program, reported, verify_program


private SHELL: String = "/bin/sh"
private SHELL_TIMEOUT_MS: Int = 10000


-- Runs one POSIX shell script with positional arguments and returns its stdout.
-- The shell reports the physical directory (`pwd -P`) independently of the
-- system call under test.
private func shell(
    label: String,
    work_directory: String,
    script: String,
    arguments: List[String],
) -> Result[String, String]:
    prefix = work_directory + "/" + label
    status ?= run_to_files(
        SHELL,
        ["-c", script, "sh"].concat(arguments),
        prefix + ".out",
        prefix + ".err",
        SHELL_TIMEOUT_MS,
    )
    errors ?= read_text(prefix + ".err").map_err(describe)
    if (
        status
            .equals(0)
            .and(errors.equals(""))
    ):
        read_text(prefix + ".out").map_err(describe)
    else:
        Err(label + ": shell exit " + status.to_string() + ": " + errors)


private pure func run_in(
    directory: String,
    label: String,
    stdout: String,
    allocations: Int,
) -> NativeRun:
    {
        label = Some(label),
        arguments = [],
        directory = Some(directory),
        descriptor_limit = None,
        status = 0,
        stdout = stdout,
        stderr = "",
        allocations = allocations,
    }


-- The physical directory, as `pwd -P` reports it, with a trailing newline.
private func current_directory_runs(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
    name: String,
    fixture: String,
    ceiling: CompileCeiling,
    allocations: Int,
) -> Result[Void, String]:
    physical ?= shell(name + "-physical", work_directory, "cd \"$1\" && pwd -P", [work_directory])
    verify_program(
        compiler,
        c_compiler,
        work_directory,
        check_instructions,
        fixture_program(name, fixture, ceiling, [
            run_in("/", "root", "/\n", allocations),
            run_in(work_directory, "temporary", physical, allocations),
        ]),
    )


func current_directory_suite(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
) -> TestSuite:
    {
        description = "Blorp current directory",
        tests = [
            (
                "native Result reaches real main in two CWDs",
                func(): reported(
                    current_directory_runs(
                        compiler,
                        c_compiler,
                        work_directory,
                        check_instructions,
                        "current_directory_basic",
                        "current_directory/basic",
                        { allocations = 105919, instructions = 597739680 },
                        2,
                    ),
                ),
            ),
            (
                "ignored Result and escaping String keep ownership",
                func(): reported(
                    current_directory_runs(
                        compiler,
                        c_compiler,
                        work_directory,
                        check_instructions,
                        "current_directory_ownership",
                        "current_directory/ownership",
                        { allocations = 106223, instructions = 596308264 },
                        4,
                    ),
                ),
            ),
        ],
    }
