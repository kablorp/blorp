                            with_arguments("first mismatch", ["abc", "xbc"], 0, "0\n0\n", 5),
                            with_arguments("middle mismatch", ["abc", "ax"], 0, "0\n0\n", 5),
                            with_arguments("last mismatch", ["ab", "ac"], 0, "0\n0\n", 5),
                            with_arguments("case sensitive", ["Hello", "hello"], 0, "0\n0\n", 5),
                            with_arguments("UTF8 prefix", ["é/树", "é"], 0, "1\n1\n", 5),
                            with_arguments("emoji prefix", ["🙂x", "🙂"], 0, "1\n1\n", 5),
