-- Native cases for Strings and paths: each program compiles once within its
-- ceiling, then runs once per case with exact status, stdout and stderr and
-- strict allocation counts.
import:
    result: Result methods
    string: String methods
    test: TestSuite
    ./file_access: read_file, write_file, make_directories
    ./self_hosted_harness:
        CompileCeiling,
        Program,
        exits_with,
        expect_failure,
        fixture_program,
        once,
        prints,
        repeated,
        reported,
        verify_program,
        with_arguments,
        writes_errors,


-- Every program's compile ceiling is its measured cost plus 15%, rounded up to
-- a whole count: allocations from the compiler's strict report, retired
-- instructions (the larger of the serial runs) from /usr/bin/time -l, both for
-- the -O0 compiler under test. The commit that changes a ceiling states the
-- measured cost in its message.
--
-- The two `*_unreached` string-literal programs are the exception, at measured
-- plus 5%: their literal is never evaluated, so the compile ceiling is their
-- only check, and it must fail a lexer that allocates per decoded byte (about
-- 11 thousand more allocations, more than 15% would allow).


-- A library whose _base.brp declares no String builtin.
private FOUNDATION_WITHOUT_STRING: String = "type Int = builtin\ntype Float = builtin\n"
private FOUNDATION_SOURCE: String = "func main() -> Int:\n    0\n"
private PRESERVED_OUTPUT: String = "preserve output"


-- A foundation error names the library file it is in, and the compile leaves an
-- existing output as it was.
private func verify_foundation_diagnostic(
    compiler: String,
    work_directory: String,
) -> Result[Void, String]:
    library = work_directory + "/foundation"
    types = library + "/_base.brp"
    input = library + "/main.brp"
    output = library + "/program.c"
    _ ?= make_directories(library)
    _ ?= write_file(types, FOUNDATION_WITHOUT_STRING)
    _ ?= write_file(library + "/prelude.brp", "")
    _ ?= write_file(input, FOUNDATION_SOURCE)
    _ ?= write_file(output, PRESERVED_OUTPUT)
    _ ?= expect_failure(
        compiler,
        ["compile", input, "--library-root", library, "-o", output],
        library + "/main",
        (
            types
            + ":3:1: error: missing String builtin declaration\nhelp: add type String = builtin to _base.brp\n"
        ),
    )
    retained: String ?= read_file(output)
    if retained.equals(PRESERVED_OUTPUT):
        Ok(void)
    else:
        Err("a foundation error overwrote the existing output")


-- `$\{` is a literal `${`, which would otherwise start an interpolation hole.
private INTERPOLATION_ORDERED_OUTPUT: String = "first\nsecond\nbeginα\0middleωend\noriginal\nthird\none replacement\ntwo 42 1.5\ngeneric kept\nlambda kept\nliteral $\{kept} yes\nleft\0right\n"


private INTERPOLATION_STRINGABLE_OUTPUT: String = "3 items, ratio 0.5, False\nalready a String and 7\nat (1, -2)\n<(1, -2)> <3> <text>\n"


private pure func string_literal(
    name: String,
    status: Int,
    ceiling: CompileCeiling,
    allocations: Int,
) -> Program:
    exits_with("string_literal_" + name, "string_literal/" + name, ceiling, status, allocations)


func suite(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
) -> TestSuite:
    run_program = func(program: Program) -> Bool: reported(
        verify_program(compiler, c_compiler, work_directory, check_instructions, program),
    )
    {
        description = "Blorp strings and paths",
        tests = [
            (
                "append_int preserves UTF-8 and NUL bytes",
                func(): run_program(
                    fixture_program(
                        "string_append_int",
                        "string_operations/append_int",
                        { allocations = 119875, instructions = 487355850 },
                        once(23, "é\0-42\n", 2),
                    ),
                ),
            ),
            (
                "append_int preserves extrema aliases and unused cleanup",
                func(): run_program(
                    prints(
                        "string_append_int_edges",
                        "string_operations/append_int_edges",
                        { allocations = 121067, instructions = 490248743 },
                        "é\0-9223372036854775808\né\0\n0\nx9223372036854775807\n",
                        7,
                    ),
                ),
            ),
            (
                "arm aliases survive replacement and unused cleanup",
                func(): run_program(
                    exits_with(
                        "string_match_cleanup",
                        "match/string_cleanup",
                        { allocations = 121013, instructions = 472039736 },
                        1,
                        3,
                    ),
                ),
            ),
            (
                "first tail arm returns fresh String",
                func(): run_program(
                    exits_with(
                        "string_match_first",
                        "match/string_first",
                        { allocations = 120505, instructions = 468142343 },
                        1,
                        1,
                    ),
                ),
            ),
            (
                "second tail arm returns fresh String",
                func(): run_program(
                    exits_with(
                        "string_match_second",
                        "match/string_second",
                        { allocations = 120505, instructions = 468039633 },
                        2,
                        1,
                    ),
                ),
            ),
            (
                "Int literal patterns select by value at every depth",
                func(): run_program(
                    exits_with(
                        "int_literal_patterns",
                        "match/int_literals",
                        { allocations = 146318, instructions = 536746966 },
                        127,
                        11,
                    ),
                ),
            ),
            (
                "foundation diagnostic retains source and output",
                func(): reported(verify_foundation_diagnostic(compiler, work_directory)),
            ),
            (
                "conversion and borrowed length",
                func(): run_program(
                    exits_with(
                        "mortal_string_basic",
                        "mortal_string/basic",
                        { allocations = 119202, instructions = 464860000 },
                        1,
                        1,
                    ),
                ),
            ),
            (
                "unused String result returns zero",
                func(): run_program(
                    exits_with(
                        "mortal_string_unused",
                        "mortal_string/unused",
                        { allocations = 118940, instructions = 464197633 },
                        0,
                        1,
                    ),
                ),
            ),
            (
                "owned return may alias borrowed argument",
                func(): run_program(
                    exits_with(
                        "mortal_string_identity",
                        "mortal_string/identity",
                        { allocations = 119695, instructions = 466422684 },
                        1,
                        1,
                    ),
                ),
            ),
            (
                "reassignment preserves live original",
                func(): run_program(
                    exits_with(
                        "mortal_string_alias",
                        "mortal_string/alias",
                        { allocations = 119477, instructions = 465487871 },
                        2,
                        2,
                    ),
                ),
            ),
            (
                "Int64 minimum conversion length",
                func(): run_program(
                    exits_with(
                        "mortal_string_minimum",
                        "mortal_string/minimum",
                        { allocations = 119126, instructions = 464494034 },
                        20,
                        1,
                    ),
                ),
            ),
            (
                "Int64 maximum conversion length",
                func(): run_program(
                    exits_with(
                        "mortal_string_maximum",
                        "mortal_string/maximum",
                        { allocations = 119112, instructions = 465312360 },
