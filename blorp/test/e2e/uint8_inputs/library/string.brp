import:
    _base: Int, UInt8, String, List, Bool, Option, Equatable, Stringable, Addable


implements Equatable for String:
    pure func equals(left: Self, right: Self) -> Bool:
        builtin("string.equals")


implements Stringable for String:
    pure func to_string(value: Self) -> String:
        value


implements Addable for String:
    pure func add(left: Self, right: Self) -> Self:
        builtin("string.add")


pure func length(value: String) -> Int:
    builtin("string.length")


-- The String's UTF-8 bytes, one element each.
pure func to_bytes(text: String) -> List[UInt8]:
    builtin("string.to_bytes")
