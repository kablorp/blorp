-- UInt8 has every arithmetic trait but Negatable: an unsigned value has no
-- negation, and 0 - value is the wrapping result.
import:
    _base:
        Int,
        UInt8,
        String,
        Bool,
        Option(Some, None),
        Equatable,
        Hashable,
        Orderable,
        Stringable,
        Addable,
        Subtractable,
        Multipliable,
        Divisible,
        Modulable,
    int: Int methods


implements Equatable for UInt8:
    pure func equals(left: Self, right: Self) -> Bool:
        builtin("uint8.equals")


implements Hashable for UInt8:
    pure func hash(value: Self) -> Int:
        value.to_int()


implements Orderable for UInt8:
    pure func less_than(left: Self, right: Self) -> Bool:
        builtin("uint8.less_than")


implements Stringable for UInt8:
    pure func to_string(value: Self) -> String:
        builtin("uint8.to_string")


implements Addable for UInt8:
    pure func add(left: Self, right: Self) -> Self:
        builtin("uint8.add")


implements Subtractable for UInt8:
    pure func subtract(left: Self, right: Self) -> Self:
        builtin("uint8.subtract")


implements Multipliable for UInt8:
    pure func multiply(left: Self, right: Self) -> Self:
        builtin("uint8.multiply")


implements Divisible for UInt8:
    pure func divide(left: Self, right: Self) -> Self:
        builtin("uint8.divide")


implements Modulable for UInt8:
    pure func remainder(left: Self, right: Self) -> Self:
        builtin("uint8.remainder")


pure func to_int(value: UInt8) -> Int:
    builtin("uint8.to_int")


-- Called only for a value in 0 to 255, so it never wraps.
private pure func wrap_to_uint8(value: Int) -> UInt8:
    builtin("int.wrap_to_uint8")


pure func to_uint8(value: Int) -> Option[UInt8]:
    if value < 0:
        None
    else if value > 255:
        None
    else:
        Some(value.wrap_to_uint8())
