import:
    _base: Int, UInt8, String, Void, List, Result


func print(value: String) -> Void:
    builtin("string.print")


-- Reads every byte of the file; fails with the fs protocol's Int code.
func read_bytes(path: String) -> Result[List[UInt8], Int]:
    builtin("fs.read_bytes")


-- Replaces the file with exactly these bytes, atomically.
func write_bytes(path: String, data: List[UInt8]) -> Result[Void, Int]:
    builtin("fs.write_bytes")
