import:
    _base: Int, List, Option


pure func length[Element](values: List[Element]) -> Int:
    builtin("list.length")


pure func get[Element](values: List[Element], index: Int) -> Option[Element]:
    builtin("list.get")


pure func append[Element](values: List[Element], value: Element) -> List[Element]:
    builtin("list.append")
