-- A reduced base that declares UInt8, which the standard library cannot until
-- the pinned seed knows the type (UINT8_BYTES_PLAN, L3).
type Int = builtin


type UInt8 = builtin


type Float = builtin


type String = builtin


type Void = builtin


type List[T] = builtin


fixed union Bool:
    True
    False


union Option[A]:
    Some(A)
    None


union Result[Value, Error]:
    Ok(Value)
    Err(Error)


trait Equatable:
    pure func equals(left: Self, right: Self) -> Bool
    pure func not_equals(left: Self, right: Self) -> Bool:
        match left.equals(right):
            True: False
            False: True


trait Orderable:
    pure func less_than(left: Self, right: Self) -> Bool
    pure func greater_than(left: Self, right: Self) -> Bool:
        right.less_than(left)
    pure func less_than_or_equal(left: Self, right: Self) -> Bool:
        match right.less_than(left):
            True: False
            False: True
    pure func greater_than_or_equal(left: Self, right: Self) -> Bool:
        match left.less_than(right):
            True: False
            False: True


trait Hashable: Equatable:
    pure func hash(value: Self) -> Int


trait Stringable:
    pure func to_string(value: Self) -> String


trait Addable:
    pure func add(left: Self, right: Self) -> Self


trait Subtractable:
    pure func subtract(left: Self, right: Self) -> Self


trait Multipliable:
    pure func multiply(left: Self, right: Self) -> Self


trait Divisible:
    pure func divide(left: Self, right: Self) -> Self


trait Modulable:
    pure func remainder(left: Self, right: Self) -> Self


trait Negatable:
    pure func negate(value: Self) -> Self
