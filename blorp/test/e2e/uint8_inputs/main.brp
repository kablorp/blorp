-- UInt8 in use: literals that take UInt8 from their context, wrapping
-- arithmetic, comparisons, conversions, patterns, storage and the byte natives.
-- The first argument names a directory where the program may write a file.
import:
    bytes: to_text
    io: read_bytes, write_bytes
    list: get


-- A fixed record may hold a UInt8 field.
fixed record Pixel {
    red: UInt8,
    alpha: UInt8,
}


pure func larger[T: Orderable](first: T, second: T) -> T:
    if second > first:
        second
    else:
        first


pure func hashed[T: Hashable](value: T) -> Int:
    value.hash()


pure func takes_int(value: Int) -> Int:
    value


pure func describe(byte: UInt8) -> String:
    match byte:
        0: "zero"
        255: "max"
        _: "other"


pure func yes_no(value: Bool) -> String:
    match value:
        True: "yes"
        False: "no"


pure func show(values: List[UInt8]) -> String:
    var text = "["
    for value in values:
        text = text + " " + value.to_string()
    text + " ]"


pure func show_option(value: Option[UInt8]) -> String:
    match value:
        Some(byte): "Some(${byte})"
        None: "None"


pure func show_text(value: Option[String]) -> String:
    match value:
        Some(text): "Some(${text})"
        None: "None"


func literals() -> Void:
    byte: UInt8 = 200
    next = byte + 1
    wrapped = 0 - byte
    is_zero = byte == 0
    maybe: Option[UInt8] = Some(200)
    signature: List[UInt8] = [137, 80]
    count = 5
    print("byte ${byte}, next ${next}, wrapped ${wrapped}, zero ${yes_no(is_zero)}")
    print("maybe ${show_option(maybe)}, signature ${show(signature)}")
    print("larger ${larger(byte, 3)} ${larger(3, byte)}, count ${takes_int(count)}")


func arithmetic() -> Void:
    zero: UInt8 = 0
    under: UInt8 = 0 - 1
    over: UInt8 = 255 + 1
    product: UInt8 = 200 * 2
    byte: UInt8 = 200
    print("wrap ${under} ${over} ${product}")
    print("divide ${byte / 7} ${byte % 7} ${byte / zero} ${byte % zero}")


func comparisons() -> Void:
    byte: UInt8 = 200
    print("equal ${yes_no(byte == 200)} ${yes_no(byte != 201)}")
    print(
        "order ${yes_no(byte < 201)} ${yes_no(byte > 3)} ${yes_no(byte <= 200)} ${yes_no(byte >= 201)}",
    )


func conversions() -> Void:
    byte: UInt8 = 200
    print("to_int ${byte.to_int() + 1000}, hash ${hashed(byte)}")
    print(
        "to_uint8 ${show_option(255.to_uint8())} ${show_option(256.to_uint8())} ${show_option((-1).to_uint8())}",
    )


func storage() -> Void:
    pixel: Pixel = { red = 255, alpha = 0 }
    print("pixel ${pixel.red} ${pixel.alpha}")
    print("patterns ${describe(0)} ${describe(255)} ${describe(7)}")
    values: List[UInt8] = [1, 2]
    grown = values.append(250)
    print("list ${show(grown)} length ${grown.length()}")


func natives(directory: String) -> Void:
    path = directory + "/uint8_round_trip.bin"
    payload: List[UInt8] = [0, 255, 72, 105, 0, 128]
    match write_bytes(path, payload):
        Ok(_): print("write ok")
        Err(code): print("write failed ${code}")
    match read_bytes(path):
        Ok(data): print("read ${show(data)}")
        Err(code): print("read failed ${code}")
    match read_bytes(directory + "/missing.bin"):
        Ok(_): print("missing read")
        Err(code): print("missing ${code}")
    text = "Hé\0"
    print("to_bytes ${show(text.to_bytes())}")
    print("to_text ${show_text(to_text(text.to_bytes()))} ${show_text(to_text(payload))}")
    -- Each refused input breaks UTF-8 one way; U+1F600 is a valid 4-byte character.
    overlong: List[UInt8] = [192, 128]
    surrogate: List[UInt8] = [237, 160, 128]
    above_unicode: List[UInt8] = [244, 144, 128, 128]
    continuation: List[UInt8] = [128]
    truncated: List[UInt8] = [226, 130]
    grinning: List[UInt8] = [240, 159, 152, 128]
    print("overlong ${show_text(to_text(overlong))}")
    print("surrogate ${show_text(to_text(surrogate))}")
    print("above U+10FFFF ${show_text(to_text(above_unicode))}")
    print("lone continuation ${show_text(to_text(continuation))}")
    print("truncated ${show_text(to_text(truncated))}")
    print("four bytes ${show_text(to_text(grinning))}")


func main(arguments: List[String]) -> Int:
    literals()
    arithmetic()
    comparisons()
    conversions()
    storage()
    match get(arguments, 1):
        Some(directory):
            natives(directory)
            0
        None:
            print("missing directory")
            2
