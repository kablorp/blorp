---
The file operations the end-to-end suites use on the text paths they build for
command lines. Each turns its text into a `Path` and reports a failure as
"path: reason", so a suite either keeps the whole message or names which file
it could not use. Nothing is ignored: a text that is not a path is a failure
too.
---
import:
    _base: Void, List, Option
    io/fs/create_directory: CreateDirectoryError, create_directories
    io/fs/entry: Entry, EntryError, EntryKind, entry_kind
    io/fs/list: ListError, list_directory
    io/fs/read: ReadError, read_text
    io/fs/remove_tree: RemoveTreeError, remove_directory_tree
    io/fs/write: WriteError, write_text
    path: Path, PathError, to_path
    result: Result methods


-- A fixture path is built here, so one the constructor refuses is a defect in
-- the test and reads "path: reason".
pure func path_of(text: String) -> Result[Path, String]:
    text
        .to_path()
        .map_err(pure func(error: PathError) -> String: "${text}: ${error}")


func read_file(path: String) -> Result[String, String]:
    file ?= path_of(path)
    file
        .read_text()
        .map_err(pure func(error: ReadError) -> String: "${path}: ${error}")


func write_file(path: String, text: String) -> Result[Void, String]:
    file ?= path_of(path)
    file
        .write_text(text)
        .map_err(pure func(error: WriteError) -> String: "${path}: ${error}")


func kind_of(path: String) -> Result[Option[EntryKind], String]:
    file ?= path_of(path)
    file
        .entry_kind()
        .map_err(pure func(error: EntryError) -> String: "${path}: ${error}")


func make_directories(path: String) -> Result[Void, String]:
    directory ?= path_of(path)
    directory
        .create_directories()
        .map_err(pure func(error: CreateDirectoryError) -> String: "${path}: ${error}")


func remove_tree(path: String) -> Result[Void, String]:
    directory ?= path_of(path)
    directory
        .remove_directory_tree()
        .map_err(pure func(error: RemoveTreeError) -> String: "${path}: ${error}")


func list_entries(path: String) -> Result[List[Entry], String]:
    directory ?= path_of(path)
    directory
        .list_directory()
        .map_err(pure func(error: ListError) -> String: "${path}: ${error}")
