-- Native cases for matches, patterns, conditionals, loops, Result propagation,
-- process input, effects, calculators, main signatures and suite entries: each
-- program compiles once within its ceiling, then runs once per case with exact
-- status, stdout and stderr and strict allocation counts. Rejections check the
-- exact diagnostic and that no C is created or overwritten.
import:
    int: Int methods
    list: List methods, repeat
    result: Result methods
    string: String methods
    test: TestSuite
    ./file_access: write_file
    ./self_hosted_harness:
        CompileCeiling,
        CompileInput(SingleSource),
        LIBRARY_ROOT,
        Program,
        exits_with,
        fixture_program,
        once,
        prints,
        repeated,
        reported,
        suite_program,
        verify_program,
        verify_unpublished_rejection,
        with_arguments,


-- Every program's compile ceiling is its measured cost plus 15%, rounded up to
-- a whole count: allocations from the compiler's strict report, retired
-- instructions (the larger of the serial runs) from /usr/bin/time -l, both for
-- the -O0 compiler under test. The commit that changes a ceiling states the
-- measured cost in its message.


private VALUE_HEADER: String = "union Value:\n\tEmpty\n\tNumber(Int)\n"


private CHOOSE_BODY: String = "pure func choose() -> Value:\n\tEmpty\nfunc main() -> Int:\n\tmatch choose():\n"


private MISSING_PAYLOAD_BODY: String = "pure func unwrap(value: Value) -> Int:\n\tmatch value:\n\t\tEmpty: 0\n\t\tNumber(number): number\nfunc main() -> Int:\n\tunwrap(Number())\n"


private INLINE_EFFECT_BODY: String = "func effect() -> Int:\n\t9\npure func unwrap(value: Value) -> Int:\n\tmatch value:\n\t\tEmpty: effect()\n\t\tNumber(number): number\nfunc main() -> Int:\n\tunwrap(Number(42))\n"


private BLOCK_EFFECT_BODY: String = "func effect() -> Int:\n\t9\npure func unwrap(value: Value) -> Int:\n\tmatch value:\n\t\tEmpty:\n\t\t\tunused = effect()\n\t\t\t0\n\t\tNumber(number): number\nfunc main() -> Int:\n\tunwrap(Number(42))\n"


private IMMUTABLE_CAPTURE_BODY: String = "pure func unwrap(value: Value) -> Int:\n\tmatch value:\n\t\tEmpty: 0\n\t\tNumber(number):\n\t\t\tnumber = 1\n\t\t\tnumber\nfunc main() -> Int:\n\tunwrap(Number(42))\n"


private IMPURE_CALL_HELP: String = "help: mark the callee pure or remove pure from the caller\n"


-- `walk` chains `count` propagations of `next`; `main` prints the result.
private pure func chain_source(count: Int) -> String:
    header: String =
        |import:
        |    int as int_ops
        |    io/console: print
        |pure func next(value: Int) -> Result[Int, String]:
        |    Ok(int_ops.add(value, 1))
        |pure func walk() -> Result[Int, String]:
        |
    var source = header
    var previous = "0"
    for position in 1..(count + 1):
        name = "step" + position.to_string()
        source = source + "    " + name + " ?= next(" + previous + ")\n"
        previous = name
    tail: String =
        |func main() -> Int:
        |    match walk():
        |        Ok(number): print(int_ops.to_string(number))
        |        Err(error): print(error)
        |    0
        |
    source + "    Ok(" + previous + ")\n" + tail


private RHS_CARRIERS_SOURCE: String =
    |import:
    |    int as int_ops
    |    io/console: print
    |pure func advance(flag: Bool) -> Result[Int, String]:
    |    var total = 1
    |    captured: Int ?= match flag:
    |        True:
    |            total = 7
    |            Ok(0)
    |        False: Ok(0)
    |    Ok(total)
    |func main() -> Int:
    |    match advance(True):
    |        Ok(number): print(int_ops.to_string(number))
    |        Err(error): print(error)
    |    match advance(False):
    |        Ok(number): print(int_ops.to_string(number))
    |        Err(error): print(error)
    |    0
    |


-- A program whose source `text` is written to the work directory first.
private func written_program(
    work_directory: String,
    name: String,
    text: String,
    ceiling: CompileCeiling,
    stdout: String,
    allocations: Int,
) -> Result[Program, String]:
    source = work_directory + "/" + name + ".brp"
    _ ?= write_file(source, text)
    Ok({
        name = name,
        input = SingleSource(source),
        library_root = LIBRARY_ROOT,
        ceiling = ceiling,
        runs = once(0, stdout, allocations),
    })


private PASSING_SUITE_OUTPUT: String = "\n>> registration Tests\n  [PASS] pure\neffect\n  [PASS] effect\n\nAll 2 tests passed\n"


private FAILING_SUITE_OUTPUT: String = "\n>> continued registration Tests\nfirst\n  [FAIL] first case\nsecond\n  [PASS] second case\nthird\n  [FAIL] third case\n\n2 of 3 tests failed\n"


func suite(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
) -> TestSuite:
    run_program = func(program: Program) -> Bool: reported(
        verify_program(compiler, c_compiler, work_directory, check_instructions, program),
    )
    reject = func(name: String, text: String, diagnostic: String) -> Bool: reported(
        verify_unpublished_rejection(compiler, work_directory, name, text, diagnostic),
    )
    run_written = func(
        name: String,
        text: String,
        ceiling: CompileCeiling,
        stdout: String,
        allocations: Int,
    ) -> Bool:
        match written_program(work_directory, name, text, ceiling, stdout, allocations):
            Ok(program): run_program(program)
            Err(error): reported(Err(error))
    choose = VALUE_HEADER + CHOOSE_BODY
    {
        description = "Blorp control flow, patterns, process input and entry points",
        tests = [
            (
                "qualified flat patterns preserve captures",
                func(): run_program(
                    prints(
                        "match_qualified_flat",
                        "match/qualified_flat",
                        { allocations = 127369, instructions = 507830766 },
                        "42\n7\n1\n0\n",
                        4,
                    ),
                ),
            ),
            (
                "match returns payload with cost limits",
                func(): run_program(
                    exits_with(
                        "match_value",
                        "match/value",
                        { allocations = 120098, instructions = 467520814 },
                        42,
                        0,
                    ),
                ),
            ),
            (
                "whole value capture",
                func(): run_program(
                    exits_with(
                        "match_values",
                        "match/values",
                        { allocations = 120792, instructions = 470581721 },
                        42,
                        0,
                    ),
                ),
            ),
            (
                "empty constructor",
                func(): run_program(
                    exits_with(
                        "match_empty",
                        "match/empty",
                        { allocations = 119904, instructions = 467840781 },
                        0,
                        0,
                    ),
                ),
            ),
            (
                "whole empty capture",
                func(): run_program(
                    exits_with(
                        "match_whole_empty",
                        "match/whole_empty",
                        { allocations = 120594, instructions = 468830335 },
                        0,
                        0,
                    ),
                ),
            ),
            (
                "wildcard capture",
                func(): run_program(
                    exits_with(
                        "match_wildcard",
                        "match/wildcard",
                        { allocations = 119690, instructions = 466196995 },
                        7,
                        0,
                    ),
                ),
            ),
            (
                "capture preserves parameter",
                func(): run_program(
                    exits_with(
                        "match_shadow",
                        "match/shadow",
                        { allocations = 120372, instructions = 468924052 },
                        42,
                        0,
                    ),
                ),
            ),
            (
                "sibling payload",
                func(): run_program(
                    exits_with(
                        "match_sibling_payload",
                        "match/sibling_payload",
                        { allocations = 120095, instructions = 467661147 },
                        17,
                        0,
                    ),
                ),
            ),
            (
                "sibling empty",
                func(): run_program(
                    exits_with(
                        "match_sibling_empty",
                        "match/sibling_empty",
                        { allocations = 120305, instructions = 473394287 },
                        3,
                        0,
                    ),
                ),
            ),
            (
                "selected arm",
                func(): run_program(
                    exits_with(
                        "match_selected_arm",
                        "match/selected_arm",
                        { allocations = 120645, instructions = 471864020 },
                        42,
                        0,
                    ),
                ),
            ),
            (
                "scalar wildcard preserves scrutinee",
                func(): run_program(
                    exits_with(
                        "match_scalar_capture",
                        "match/scalar_capture",
                        { allocations = 120322, instructions = 467812247 },
                        1,
                        0,
                    ),
                ),
            ),
            (
                "constructor argument",
                func(): run_program(
                    exits_with(
                        "match_constructor_argument",
                        "match/constructor_argument",
                        { allocations = 120237, instructions = 468651754 },
                        42,
