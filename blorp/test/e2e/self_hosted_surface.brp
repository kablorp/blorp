                    prints(
                        "generics_managed_option_result_callbacks",
                        "generic/managed/option_result_callbacks",
                        { allocations = 137624, instructions = 494521662 },
                        "42é\0!\n42é\0\nnone\n7\nunchanged!\n42\nkept!\n8!\nbypass!\nunit!\nreceiver\neager!\n",
                        31,
                    ),
                ),
            ),
            (
                "explicit Option and Result helpers preserve eager defaults and managed values",
                func(): run_program(
                    prints(
                        "generics_managed_option_result_helpers",
                        "generic/managed/option_result_helpers",
                        { allocations = 126774, instructions = 462052385 },
