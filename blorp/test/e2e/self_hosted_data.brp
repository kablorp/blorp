            (
                "List and mortal String outlive updated parents",
                func(): run_program(
                    prints(
                        "record_update_escaped_children",
                        "record/update/escaped_children",
                        { allocations = 117978, instructions = 444311538 },
                        "42\n2\n7\n",
                        12,
