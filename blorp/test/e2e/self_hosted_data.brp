                    ),
                ),
            ),
            (
                "record with unmanaged union handles both active variants",
                func(): run_program(
                    exits_with(
                        "record_unmanaged_union_field",
                        "record/unmanaged_union_field",
                        { allocations = 121767, instructions = 475484194 },
                        42,
                        2,
                    ),
                ),
            ),
            (
                "phantom String and record arguments remain valid record fields",
                func(): run_program(
                    exits_with(
                        "record_phantom_union_fields",
                        "record/phantom_union_fields",
                        { allocations = 122087, instructions = 477695689 },
                        14,
                        1,
                    ),
                ),
            ),
            (
                "Void field is read from its temporary record",
                func(): run_program(
                    exits_with(
                        "record_void_field",
                        "record/void_field",
                        { allocations = 119248, instructions = 466837835 },
                        0,
                        1,
                    ),
                ),
            ),
            (
                "record initializers evaluate once in written field order",
                func(): run_program(
                    prints(
                        "record_field_order",
                        "record/field_order",
                        { allocations = 122499, instructions = 494625546 },
