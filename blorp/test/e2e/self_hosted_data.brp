                        "record/generic/box_string",
                        { allocations = 121651, instructions = 496792463 },
                        "42\n",
                        2,
                    ),
                ),
            ),
            (
                "one reader declaration handles String then Int",
                func(): run_program(
                    prints(
                        "generic_record_same_reader_twice",
                        "record/generic/same_reader_twice",
                        { allocations = 122771, instructions = 497057069 },
                        "42\n7\n",
                        3,
                    ),
                ),
            ),
            (
                "ordered type arguments preserve both Pair applications",
                func(): run_program(
                    prints(
                        "generic_record_swapped_pair",
                        "record/generic/swapped_pair",
                        { allocations = 125106, instructions = 505790483 },
