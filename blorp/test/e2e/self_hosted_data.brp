            ),
            (
                "nested scalar records preserve numeric fields",
                func(): run_program(
                    prints(
                        "record_scalar_nested_field",
                        "record/scalar_nested_field",
                        { allocations = 122104, instructions = 495043873 },
                        "7\n2.5\n9\n",
                        3,
                    ),
