            (
                "managed replacements out of declaration order",
                func(): run_program(
                    prints(
                        "record_update_managed_reorder",
                        "record/update/managed_reorder",
                        { allocations = 126315, instructions = 502400788 },
                        "42\n7\n3\n1\n42\n2\n",
                        10,
                    ),
                ),
            ),
            (
                "nested String List admission preserves owned argument",
                func(): run_program(
                    fixture_program(
                        "generic_record_nested_string_list",
                        "record/generic/admission/nested_string_list",
                        { allocations = 124650, instructions = 510920204 },
                        [
                            with_arguments(
                                "owned Unicode argument",
                                ["kept é🙂"],
                                0,
                                "kept é🙂\n",
                                4,
                            ),
                            with_arguments("absent argument", [], 0, "missing\n", 4),
