-- Native cases for records, unions, tuples, opaque types and equality: each
-- program compiles once within its ceiling, then runs once per case with exact
-- status, stdout and stderr and strict allocation counts. Rejections check the
-- exact diagnostic; those that must publish nothing also check that no C is
-- created and an existing output is left alone.
import:
    result: Result methods
    test: TestSuite
    ./file_access: write_file
    ./self_hosted_harness:
        CompileCeiling,
        CompileInput(SingleSource),
        FIXTURES,
        LIBRARY_ROOT,
        NativeRun,
        Program,
        Rejection,
        exits_with,
        fixture_program,
        once,
        prints,
        reported,
        verify_program,
        verify_rejection,
        verify_unpublished_against,
        verify_unpublished_rejection,
        with_arguments,


-- Every program's compile ceiling is its measured cost plus 15%, rounded up to
-- a whole count: allocations from the compiler's strict report, retired
-- instructions (the larger of the serial runs) from /usr/bin/time -l, both for
-- the -O0 compiler under test. Measurements, commit and commands:
-- benchmarks/results/blorp_2_e2e_ceilings_2026-11-05.md. A ceiling changes only
-- with a new record there.


private TRAIT_INPUTS: String = "blorp/test/e2e/trait_inputs/"

-- A reduced library (the base types, Equatable and a few implementations, and
-- no Dict) that gives the derived-equality inputs a fixed base: their expected
-- diagnostics and costs do not move with the standard library.
private DERIVED_LIBRARY_ROOT: String = "blorp/test/e2e/trait_inputs/derived/library"

private FIELD_NOTE: String = "record field declared here"
private RECURSIVE_AGGREGATE_MESSAGE: String = "recursive aggregate types are not supported yet"


private RECURSIVE_AGGREGATE_HELP: String = "use finite record and union fields; recursion is supported through a record field, a List element or one direct self payload of a non-generic union, such as Next(Node)"


private TRAIT_BOUND_ERROR: String = ": error: type does not satisfy the required trait bound\nhelp: add the required trait to this function's type parameter bounds, or provide an implementation for the concrete receiver\n"


private MEMBER_ERROR: String = ": error: automatic equality is unavailable for a field or payload\nhelp: provide the member's required trait implementation, or write an Equatable implementation for the containing type\n"


private FINITE_ERROR: String = ": error: cannot prove finite generic trait instantiation\nhelp: avoid recursively wrapping generic receivers through trait dispatch; this increment uses a conservative constructor-path proof\n"


-- `location` is line:column; `message` and `help` are the diagnostic's two lines.
private pure func fixture_rejection(
    name: String,
    fixture: String,
    location: String,
    message: String,
    help: String,
) -> Rejection:
    {
        name = name,
        source = FIXTURES + fixture + ".brp",
        diagnostic = ":" + location + ": error: " + message + "\nhelp: " + help + "\n",
    }


-- `input` is a path under trait_inputs, without the extension; `diagnostic`
-- follows the source path.
private pure func trait_rejection(name: String, input: String, diagnostic: String) -> Rejection:
    { name = name, source = TRAIT_INPUTS + input + ".brp", diagnostic = diagnostic }


-- The note the compiler adds after an error, in the same file.
private pure func with_note(rejection: Rejection, location: String, note: String) -> Rejection:
    { rejection |
        diagnostic = (
            rejection.diagnostic
            + rejection.source
            + ":"
            + location
            + ": note: "
            + note
            + "\n"
        ),
    }


private pure func private_rejection(
    name: String,
    fixture: String,
    location: String,
    owner: String,
) -> Rejection:
    {
        name = name,
        source = FIXTURES + "private_type/" + fixture + ".brp",
        diagnostic = (
            ":"
            + location
            + ": error: Secret is private but appears in public declaration "
            + owner
            + "\nhelp: make Secret public, or make "
            + owner
            + " private\n"
        ),
    }


-- A program built from a trait input, against the reduced derived-equality
-- library.
private pure func derived_program(
    name: String,
    input: String,
    ceiling: CompileCeiling,
    runs: List[NativeRun],
) -> Program:
    {
        name = name,
        input = SingleSource(TRAIT_INPUTS + input + ".brp"),
        library_root = DERIVED_LIBRARY_ROOT,
        ceiling = ceiling,
        runs = runs,
    }


private RECORD_MISSING_FIELD_SOURCE: String = "record Pair { first: Int, second: Int }\npure func make_pair() -> Pair:\n\t{ second = 2 }\nfunc main() -> Int:\n\t0\n"


-- The error names the literal, and a note names the record field it omits.
private func verify_missing_field_diagnostic(
    compiler: String,
    work_directory: String,
) -> Result[Void, String]:
    source = work_directory + "/record_missing_field.brp"
    _ ?= write_file(source, RECORD_MISSING_FIELD_SOURCE)
    missing: Rejection = {
        name = "record_missing_field",
        source = source,
        diagnostic = ":3:2: error: missing field in record literal\nhelp: provide every declared record field exactly once\n",
    }
    verify_unpublished_against(
        compiler,
        LIBRARY_ROOT,
        work_directory,
        with_note(missing, "1:15", FIELD_NOTE),
    )


-- Both constructors have ordinal zero. C's enum conversion rules cannot
-- establish the language's nominal type rule; the compiler must reject it.
private NOMINAL_MISMATCH_SOURCE: String = "union Left:\n\tSame\nunion Right:\n\tMatching\nfunc take(value: Right) -> Int:\n\t0\nfunc left() -> Left:\n\tSame\nfunc main() -> Int:\n\ttake(left())\n"


private NOMINAL_MISMATCH_DIAGNOSTIC: String = ":10:2: error: argument type does not match the parameter type\nhelp: use an expression of type Right here\n"


func suite(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
) -> TestSuite:
    run_program = func(program: Program) -> Bool: reported(
        verify_program(compiler, c_compiler, work_directory, check_instructions, program),
    )
    reject = func(rejection: Rejection) -> Bool: reported(
        verify_rejection(compiler, work_directory, rejection),
    )
    reject_unpublished = func(rejection: Rejection) -> Bool: reported(
        verify_unpublished_against(compiler, LIBRARY_ROOT, work_directory, rejection),
    )
    reject_in_derived = func(rejection: Rejection) -> Bool: reported(
        verify_unpublished_against(compiler, DERIVED_LIBRARY_ROOT, work_directory, rejection),
    )
    {
        description = "Blorp records, unions, tuples, opaque types and equality",
        tests = [
            (
                "missing field diagnostic note and output preservation",
                func(): reported(verify_missing_field_diagnostic(compiler, work_directory)),
            ),
            (
                "self-recursive record declaration is admitted",
                func(): run_program(
                    exits_with(
                        "record_recursive_direct",
                        "record/recursive_direct",
                        { allocations = 103086, instructions = 385175264 },
                        0,
                        0,
                    ),
                ),
            ),
            (
                "mutually recursive record declarations are admitted",
                func(): run_program(
                    exits_with(
                        "record_recursive_mutual",
                        "record/recursive_mutual",
                        { allocations = 103392, instructions = 386057537 },
                        0,
                        0,
                    ),
                ),
            ),
            (
                "record recursion through an applied union is admitted",
                func(): run_program(
                    exits_with(
                        "record_recursive_union",
                        "record/recursive_union",
                        { allocations = 103671, instructions = 388857617 },
                        0,
                        0,
                    ),
                ),
            ),
            (
                "pair returns its first field",
                func(): run_program(
                    exits_with(
                        "record_basic",
                        "record/basic",
                        { allocations = 104272, instructions = 389292816 },
                        7,
                        0,
                    ),
                ),
            ),
            (
                "reordered second nominal record",
                func(): run_program(
                    exits_with(
                        "record_reordered",
                        "record/reordered",
                        { allocations = 104394, instructions = 390537176 },
                        9,
                        0,
                    ),
                ),
            ),
            (
                "record alias survives reassignment",
                func(): run_program(
                    exits_with(
                        "record_aliases",
                        "record/aliases",
                        { allocations = 104189, instructions = 388782296 },
                        7,
                        0,
                    ),
                ),
            ),
            (
                "whole record reassignment",
                func(): run_program(
                    exits_with(
                        "record_reassigned",
                        "record/reassigned",
                        { allocations = 104233, instructions = 389771549 },
                        42,
                        0,
                    ),
                ),
            ),
            (
                "generic function with record and mixed postfix",
                func(): run_program(
                    exits_with(
                        "record_generic",
                        "record/generic",
                        { allocations = 105219, instructions = 391110517 },
                        1,
                        1,
                    ),
                ),
            ),
            (
                "nested literals and concrete UFCS context",
                func(): run_program(
                    exits_with(
                        "record_context",
                        "record/context",
                        { allocations = 104161, instructions = 388564988 },
                        7,
                        0,
                    ),
                ),
            ),
            (
                "flat 32 field record",
                func(): run_program(
                    exits_with(
                        "record_wide",
                        "record/wide",
                        { allocations = 107811, instructions = 400217025 },
                        31,
                        0,
                    ),
                ),
            ),
            (
                "unused full width record fields",
                func(): run_program(
                    exits_with(
                        "record_extrema",
                        "record/extrema",
                        { allocations = 103818, instructions = 387264390 },
                        0,
                        0,
