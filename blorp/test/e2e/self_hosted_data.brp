                        { allocations = 114934, instructions = 420135198 },
                        2,
                        4,
                    ),
                ),
            ),
            (
                "record projection acquires an owning inline union",
                func(): run_program(
                    exits_with(
                        "record_owning_union_field",
                        "record/owning_union_field",
                        { allocations = 114376, instructions = 419036747 },
                        2,
                        2,
                    ),
                ),
            ),
            (
                "nested inline union field keeps its String alive",
                func(): run_program(
                    exits_with(
                        "record_nested_union_field",
                        "record/nested_union_field",
                        { allocations = 114916, instructions = 418887713 },
                        2,
                        2,
                    ),
                ),
            ),
            (
                "record with unmanaged union handles both active variants",
                func(): run_program(
                    exits_with(
                        "record_unmanaged_union_field",
                        "record/unmanaged_union_field",
                        { allocations = 113413, instructions = 416029459 },
                        42,
                        2,
                    ),
                ),
            ),
            (
                "phantom String and record arguments remain valid record fields",
                func(): run_program(
                    exits_with(
                        "record_phantom_union_fields",
                        "record/phantom_union_fields",
                        { allocations = 113706, instructions = 416090004 },
                        14,
                        1,
                    ),
                ),
            ),
            (
                "Void field is read from its temporary record",
                func(): run_program(
                    exits_with(
                        "record_void_field",
                        "record/void_field",
                        { allocations = 110900, instructions = 406962332 },
                        0,
                        1,
                    ),
                ),
            ),
            (
                "record initializers evaluate once in written field order",
                func(): run_program(
                    prints(
                        "record_field_order",
                        "record/field_order",
                        { allocations = 114108, instructions = 432347130 },
                        "3\nmiddle\n1\n1\n3\n",
                        6,
                    ),
                ),
            ),
            (
                "record List field and owned lookup survive temporary parents",
                func(): run_program(
                    fixture_program(
                        "record_list_field",
                        "record/list_field",
                        { allocations = 116766, instructions = 438043102 },
                        [
                            with_arguments(
                                "record and lookup preserve argument bytes",
                                ["kept é🙂", "unused"],
                                0,
                                "3\nkept é🙂\n",
                                7,
                            ),
                            with_arguments("empty argument remains present", [""], 0, "2\n\n", 6),
                            with_arguments(
                                "missing argument remains absent",
                                [],
                                1,
                                "1\nmissing\n",
                                6,
                            ),
                        ],
                    ),
                ),
            ),
            (
                "old alias retains its original text",
                func(): run_program(
                    prints(
                        "record_update_aliases",
