import:
    _base: Int, Bool(True, False)
    equality: Equatable

implements Equatable for Int:
    pure func equals(left: Self, right: Self) -> Bool:
        builtin("int.equals")

implements Equatable for Bool:
    pure func equals(left: Self, right: Self) -> Bool:
        match left:
            True:
                match right:
                    True: True
                    False: False
            False:
                match right:
                    True: False
                    False: True
