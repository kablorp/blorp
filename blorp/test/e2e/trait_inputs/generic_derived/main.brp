import:
    int as IntOps: equals, not_equals
    list as ListOps -- Loads the ordinary bounded List equality implementation.
    io: print

record Box[Element] { values: List[List[List[Element]]] }
record Phantom[Element] { tag: Int }
union Choice[Element]:
    Empty
    Value(Element)

trait Visit:
    pure func visit(value: Self) -> Bool

opaque type Marker = Int
record Custom[Element] { tag: Int }
record Holder[Element] { child: Custom[Element] }
implements Visit for Marker:
    pure func visit(value: Self) -> Bool:
        True
implements Equatable for Custom[Element: Visit]:
    pure func equals(left: Self, right: Self) -> Bool:
        False

opaque type First = Int
opaque type Second = Int
record Carrier[Element] { value: Element }
implements Equatable for First:
    pure func equals(left: Self, right: Self) -> Bool:
        IntOps.equals(from_opaque First(left), from_opaque First(right))
implements Equatable for Second:
    pure func equals(left: Self, right: Self) -> Bool:
        False

pure func compare[Value: Equatable](left: Value, right: Value) -> Bool:
    equals(left, right)

pure func factory[Value: Equatable]() -> pure (Value, Value) -> Bool:
    equals

pure func apply(left: Box[Int], right: Box[Int], callback: pure (Box[Int], Box[Int]) -> Bool) -> Bool:
    callback(left, right)

pure func captured(left: Box[Int]) -> pure (Box[Int]) -> Bool:
    pure func(right: Box[Int]): equals(left, right)

func written_left() -> Box[Int]:
    print("left")
    { values = [[[7, 9]]] }

func written_right() -> Box[Int]:
    print("right")
    { values = [[[7, 9]]] }

func main() -> Int:
    value: Box[Int] = { values = [[[7, 9]]] }
    same: Box[Int] = { values = [[[7, 9]]] }
    changed: Box[Int] = { values = [[[7, 11]]] }
    phantom: Phantom[pure (Int) -> Int] = { tag = 7 }
    phantom_same: Phantom[pure (Int) -> Int] = { tag = 7 }
    phantom_changed: Phantom[pure (Int) -> Int] = { tag = 9 }
    choice: Choice[Int] = Value(7)
    choice_same: Choice[Int] = Value(7)
    choice_changed: Choice[Int] = Value(9)
    empty: Choice[Int] = Empty
    holder: Holder[Marker] = { child = { tag = 7 } }
    first: Carrier[First] = { value = into_opaque First(7) }
    second: Carrier[Second] = { value = into_opaque Second(7) }
    returned: pure (Box[Int], Box[Int]) -> Bool = factory()
    stored: pure (Box[Int], Box[Int]) -> Bool = equals
    capture = captured(value)
    results = [
        equals(written_left(), written_right()),
        equals(value, same), equals(value, changed), not_equals(value, changed),
        equals(phantom, phantom_same), equals(phantom, phantom_changed),
        equals(choice, choice_same), equals(choice, choice_changed),
        equals(choice, empty), equals(empty, choice), equals(empty, empty),
        equals(holder, holder),
        equals(first, first), equals(second, second), equals(first, first),
        compare(value, same), compare(value, changed),
        apply(value, same, equals), apply(value, changed, equals),
        returned(value, same), returned(value, changed),
        stored(value, same), stored(value, changed),
        capture(same), capture(changed),
    ]
    match results:
        [True, True, False, True, True, False, True, False, False, False, True, False, True, False, True, True, False, True, False, True, False, True, False, True, False]: 23
        _: 0
