import:
    _base: Int, List, Bool(True, False), Option(Some, None), Equatable
    int as IntOps

pure func length[Element](values: List[Element]) -> Int:
    builtin("list.length")

pure func get[Element](values: List[Element], index: Int) -> Option[Element]:
    builtin("list.get")

implements Equatable for List[Element: Equatable]:
    pure func equals(left: Self, right: Self) -> Bool:
        count = length(left)
        match IntOps.equals(count, length(right)):
            False: False
            True:
                var same: Bool = True
                for index in 0..count:
                    same = match same:
                        False: False
                        True:
                            match get(left, index):
                                None: False
                                Some(element):
                                    match get(right, index):
                                        None: False
                                        Some(other): equals(element, other)
                same
