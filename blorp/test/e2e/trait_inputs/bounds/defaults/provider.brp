import:
    ./trait_ops: Observe

record DefaultValue { value: Int }
record OverrideValue { value: Int }

private pure func marker() -> Int:
    9

implements Observe for DefaultValue

implements Observe for OverrideValue:
    pure func measure(value: Self) -> Int:
        marker()

pure func make_default() -> DefaultValue:
    { value = 1 }

pure func make_override() -> OverrideValue:
    { value = 1 }
