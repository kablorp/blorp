-- The compiler's `--format` and `--check` modes, run as a user runs them, on
-- files in the work directory.
import:
    fs: describe, read_text, write_text
    result: Result methods
    string: String methods
    test: TestSuite
    ./self_hosted_harness: COMPILATION_TIMEOUT_MS, WITHOUT_DIAGNOSTICS, command, reported


private FORMATTED: String = "func main() -> Int:\n    x = 1\n    x + 1\n"
-- Its third line is the first that differs from FORMATTED.
private UNFORMATTED: String = "func main() -> Int:\n    x = 1\n    x+1\n"
private UNPARSABLE: String = "func main( -> Int:\n    0\n"


private UNPARSABLE_DIAGNOSTIC: String = ":1:12: error: expected a parameter name or ')'\nhelp: use an ASCII identifier starting with a letter or underscore; keywords and lone '_' are reserved\n"


-- What one formatter run printed.
private record FormatterOutput { stdout: String, stderr: String }


private pure func expect(
    actual: String,
    expected: String,
    description: String,
) -> Result[Void, String]:
    if actual.equals(expected):
        Ok(void)
    else:
        Err("${description}: expected [${expected}], got [${actual}]")


-- Runs the compiler with `arguments`, requiring `status`, and returns what it
-- printed. The child runs without the leak check, so its stderr is only what
-- a user sees.
private func formatter_run(
    compiler: String,
    arguments: List[String],
    prefix: String,
    status: Int,
) -> Result[FormatterOutput, String]:
    _ ?= command(
        WITHOUT_DIAGNOSTICS
            .concat([compiler])
            .concat(arguments),
        prefix,
        status,
        COMPILATION_TIMEOUT_MS,
    )
    stdout ?= read_text(prefix + ".stdout").map_err(describe)
    stderr ?= read_text(prefix + ".stderr").map_err(describe)
    Ok({ stdout = stdout, stderr = stderr })


private func written_file(
    work_directory: String,
    name: String,
    contents: String,
) -> Result[String, String]:
    path = "${work_directory}/${name}.brp"
    _ ?= write_text(path, contents).map_err(describe)
    Ok(path)


private func unchanged(path: String, contents: String) -> Result[Void, String]:
    now ?= read_text(path).map_err(describe)
    expect(now, contents, "${path} after formatting")


private func check_reports_the_first_changed_line(
    compiler: String,
    work_directory: String,
) -> Result[Void, String]:
    path ?= written_file(work_directory, "format_check_unformatted", UNFORMATTED)
    output ?= formatter_run(
        compiler,
        ["--check", path],
        "${work_directory}/format_check_unformatted",
        1,
    )
    _ ?= expect(output.stdout, "${path}:3: would reformat\n", "--check stdout")
    _ ?= expect(output.stderr, "", "--check stderr")
    unchanged(path, UNFORMATTED)


private func check_prints_the_parser_diagnostic(
    compiler: String,
    work_directory: String,
) -> Result[Void, String]:
    path ?= written_file(work_directory, "format_check_unparsable", UNPARSABLE)
    output ?= formatter_run(
        compiler,
        ["--check", path],
        "${work_directory}/format_check_unparsable",
        1,
    )
    _ ?= expect(output.stdout, "", "--check stdout")
    _ ?= expect(output.stderr, path + UNPARSABLE_DIAGNOSTIC, "--check stderr")
    unchanged(path, UNPARSABLE)


private func check_accepts_a_formatted_file(
    compiler: String,
    work_directory: String,
) -> Result[Void, String]:
    path ?= written_file(work_directory, "format_check_formatted", FORMATTED)
    output ?= formatter_run(
        compiler,
        ["--check", path],
        "${work_directory}/format_check_formatted",
        0,
    )
    _ ?= expect(output.stdout, "", "--check stdout")
    expect(output.stderr, "", "--check stderr")


private func format_keeps_a_formatted_file(
    compiler: String,
    work_directory: String,
) -> Result[Void, String]:
    path ?= written_file(work_directory, "format_formatted", FORMATTED)
    output ?= formatter_run(compiler, ["--format", path], "${work_directory}/format_formatted", 0)
    _ ?= expect(output.stdout, "", "--format stdout")
    _ ?= expect(output.stderr, "", "--format stderr")
    unchanged(path, FORMATTED)


private func format_rewrites_an_unformatted_file(
    compiler: String,
    work_directory: String,
) -> Result[Void, String]:
    path ?= written_file(work_directory, "format_unformatted", UNFORMATTED)
    output ?= formatter_run(compiler, ["--format", path], "${work_directory}/format_unformatted", 0)
    _ ?= expect(output.stdout, "", "--format stdout")
    _ ?= expect(output.stderr, "", "--format stderr")
    unchanged(path, FORMATTED)


-- An unparsable file fails the run but does not stop the others: the
-- unformatted file after it is still rewritten.
private func format_continues_past_an_unparsable_file(
    compiler: String,
    work_directory: String,
) -> Result[Void, String]:
    broken ?= written_file(work_directory, "format_mixed_unparsable", UNPARSABLE)
    loose ?= written_file(work_directory, "format_mixed_unformatted", UNFORMATTED)
    output ?= formatter_run(
        compiler,
        ["--format", broken, loose],
        "${work_directory}/format_mixed",
        1,
    )
    _ ?= expect(output.stdout, "", "--format stdout")
    _ ?= expect(output.stderr, broken + UNPARSABLE_DIAGNOSTIC, "--format stderr")
    _ ?= unchanged(broken, UNPARSABLE)
    unchanged(loose, FORMATTED)


-- Directories are not searched: each path must be a file.
private func format_names_a_path_that_is_not_a_file(
    compiler: String,
    work_directory: String,
) -> Result[Void, String]:
    output ?= formatter_run(
        compiler,
        ["--check", work_directory],
        "${work_directory}/format_directory",
        1,
    )
    _ ?= expect(output.stdout, "", "--check stdout")
    expect(
        output.stderr,
        "blorp: error: could not read ${work_directory}: is a directory\nhelp: pass each .brp source file to format by its path; directories are not searched\n",
        "--check stderr",
    )


func suite(compiler: String, work_directory: String) -> TestSuite:
    {
        description = "Blorp formatter command",
        tests = [
            (
                "--check prints path:line: would reformat at the first changed line and exits 1",
                func(): reported(check_reports_the_first_changed_line(compiler, work_directory)),
            ),
            (
                "--check prints the parser's diagnostic for an unparsable file and exits 1",
                func(): reported(check_prints_the_parser_diagnostic(compiler, work_directory)),
            ),
            (
                "--check prints nothing for a formatted file and exits 0",
                func(): reported(check_accepts_a_formatted_file(compiler, work_directory)),
            ),
            (
                "--format leaves a formatted file's bytes unchanged",
                func(): reported(format_keeps_a_formatted_file(compiler, work_directory)),
            ),
            (
                "--format rewrites an unformatted file to the canonical layout",
                func(): reported(format_rewrites_an_unformatted_file(compiler, work_directory)),
            ),
            (
                "--format reports an unparsable file and still formats the next",
                func(): reported(
                    format_continues_past_an_unparsable_file(compiler, work_directory),
                ),
            ),
            (
                "--check names a path that is not a file",
                func(): reported(format_names_a_path_that_is_not_a_file(compiler, work_directory)),
            ),
        ],
    }
