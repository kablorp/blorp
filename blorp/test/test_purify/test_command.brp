import:
	../../src/purify/command: PurifyCandidate, purify_rewrite_source
	test: TestSuite


pure func test_rewrite_inserts_pure_at_each_candidate_offset() -> Bool:
	source: String = "func first(): 1\nfunc second(): 2\n"
	candidates: List[PurifyCandidate] = [
		{
			callable_id = 2,
			name = "second",
			keyword_offset = 16,
			dependencies = [],
			has_external_blocker = False
		},
		{
			callable_id = 1,
			name = "first",
			keyword_offset = 0,
			dependencies = [],
			has_external_blocker = False
		},
	]

	purify_rewrite_source(source, candidates) == "pure func first(): 1\npure func second(): 2\n"


tests: TestSuite = {
	description = "Purify command",
	tests = [
		(
			"rewrite inserts pure at each candidate offset",
			test_rewrite_inserts_pure_at_each_candidate_offset,
		),
	]
}
