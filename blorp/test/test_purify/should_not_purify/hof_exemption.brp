-- An impure function that takes a pure callback should NOT be purified
-- just because its callback is pure. The function itself does I/O.
func impure_with_callback(xs: List[Int], f: pure (Int) -> Int) -> Int:
	print("processing")
	var total: Int = 0
	for x in xs:
		total += f(x)
	total


-- This function calls impure_with_callback with a pure callback.
-- A pure callback argument should NOT make this purifiable.
func calls_impure_hof(xs: List[Int]) -> Int:
	impure_with_callback(xs, pure func(x: Int): x * 2)
