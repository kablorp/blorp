-- Calling the return value of a function should be checked for purity.
-- get_action is pure (just creates a closure), but calls_returned_closure
-- invokes the returned impure closure, so it should NOT be purified.
-- NOTE: get_action WILL be purified (correctly), so we mark it pure here
-- to ensure calls_returned_closure is the only candidate.
pure func get_action() -> (Int) -> Int:
	func(x: Int):
		print(to_string(x))
		x


func calls_returned_closure(x: Int) -> Int:
	get_action()(x)
