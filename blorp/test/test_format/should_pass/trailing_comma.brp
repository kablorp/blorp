-- Tests trailing comma behavior: flat stays clean, multiline gets trailing commas
pure func add(a: Int, b: Int) -> Int:
	a + b


pure func f8(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int) -> Int:
	a


-- Short call stays flat (no trailing comma)
pure func short_call() -> Int:
	add(1, 2)


-- Long call breaks with trailing comma
pure func long_call() -> Int:
	f8(
		1111111111,
		2222222222,
		3333333333,
		4444444444,
		5555555555,
		6666666666,
		7777777777,
		8888888888,
	)


-- Short list stays flat
pure func short_list() -> List[Int]:
	[1, 2, 3]


-- Long list breaks with trailing comma on last element
pure func long_list() -> List[Int]:
	[
		1111111111,
		2222222222,
		3333333333,
		4444444444,
		5555555555,
		6666666666,
		7777777777,
		88888888889,
	]


-- Short tuple stays flat
pure func short_tuple() -> (Int, Int):
	(1, 2)


func main(args: List[String]) -> Int:
	0
