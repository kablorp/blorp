-- Multibyte bytes survive a round trip through interpolated and pipe strings.
-- The formatter re-splits the byte-indexed literal text, so a run has to be
-- copied as bytes rather than rebuilt one Char at a time.
func caption(count: Int) -> String:
	"café ${count} — für"


func nested(word: String) -> String:
	"a ${word + "—"} b"


func block(name: String) -> String:
	|héllo ${name} — end
	|näxt line


func main(args: List[String]) -> Int:
	print(caption(1))
	print(nested("ü"))
	print(block("wörld"))
	0
