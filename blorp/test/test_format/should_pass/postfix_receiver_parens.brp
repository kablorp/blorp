-- Subscript targets and call callees that bind looser than a postfix operator
-- keep their parentheses. Without them `(left + right)[0]` would format to
-- `left + right[0]`, which subscripts only `right`.
func binary_subscript_target(left: Float[#3], right: Float[#3]) -> Float:
	(left + right)[0]


func unary_subscript_target(values: Float[#3]) -> Float:
	(-values)[0]


func binary_multi_subscript_target(left: Float[#2, #2], right: Float[#2, #2]) -> Float:
	(left + right)[0, 1]


func lambda_callee() -> Int:
	(func(n: Int): n + 1)(2)


func typed_lambda_callee() -> Int:
	(pure func(n: Int) -> Int: n + 1)(2)


pure func add(left: Int, right: Int) -> Int:
	left + right


func parenthesized_callee_as_call_argument() -> Int:
	add((func(n: Int): n + 1)(2), 3)


func unary_field_receiver(values: Float[#3]) -> Int:
	(-values).length()
