-- Comments preserved when file contains string interpolation
func greet(name: String) -> String:
	-- build the greeting string
	"Hello, ${name}!"


-- Another function with interpolation and comments
func describe(x: Int, y: Int) -> String:
	-- format the pair
	sum: Int = x + y

	-- return description
	"sum of ${x} and ${y} is ${sum}"


func main(args: List[String]) -> Int:
	-- print something
	print(greet("world"))
	0
