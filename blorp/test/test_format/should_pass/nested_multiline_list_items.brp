func view():
	article
		.attr("class", "home-page")
		.attrs({
			"href" => path_home,
			"class" => "home-page",
		})
		.scores({1, 2, 3})
		.content([
			section
				.attr("class", "hero")
				.content([
					div
						.attr("class", "hero-copy")
						.content([
							small
								.attr("class", "eyebrow")
								.content("Early-preview programming language"),
							h1.content(brand_name),
							p
								.attr("class", "lede")
								.content(
									"Safe, fast code that is easy to generate, review, debug, and trust.",
								),
						]),
				]),
		])
