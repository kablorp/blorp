-- Comments among function parameters stay with the parameter they precede or
-- end, or above the closing `)`.
func build(
	-- the width
	width: Float,
	height: Float, -- trailing param
	-- depth is not modelled yet
) -> Float:
	width + height


func announce(
	name: String, -- who
	-- no return type follows
):
	-- The body keeps its own leading comment.
	print(name)


trait Shape:
	func area(
		self,
		-- in square units
		scale: Float,
	) -> Float


func outer(value: Int) -> Int:
	func inner(
		-- the inner input
		input: Int,
	) -> Int:
		input + 1

	inner(value)


func main() -> Int:
	build(1.0, 2.0)
	announce("x")
	outer(1)
