-- Comments written inside a `foreign:` block describe the binding below them
-- and stay inside the block; comments above the header stay above it, and
-- adjacent blocks with the same header stay separate blocks.
foreign:
	-- Absolute value.
	pure func c_labs(x: Int) -> Int = "labs"
	-- Process exit status.
	func c_abort() -> Int = "abort"


-- A second block with the same (empty) header.
foreign:
	-- Absolute value of a long long.
	pure func c_llabs(x: Int) -> Int = "llabs"


-- Bindings with link metadata.
foreign(include: "math.h", link: "-lm"): -- the C math library
	-- Cosine in radians.
	-- Spans two comment lines.
	func cos(x: Float) -> Float
	func sin(x: Float) -> Float -- sine in radians


func main(args: List[String]) -> Int:
	c_labs(0)
