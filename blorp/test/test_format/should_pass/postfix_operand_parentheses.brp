-- A block-form expression used as a postfix operand keeps its parentheses,
-- with the closing parenthesis on a line of its own so the output parses.
func suite_field_receiver(flag: Bool, a: List[Int], b: List[Int]) -> Int:
	(
		if flag:
			a
		else:
			b
	).length()


func suite_match_receiver(value: Option[List[Int]], fallback: List[Int]) -> Int:
	(
		match value:
			Some(items):
				items
			None:
				fallback
	).length()


func suite_callee(flag: Bool) -> Int:
	(
		if flag:
			func(x: Int) -> Int: x + 1
		else:
			func(x: Int) -> Int: x + 2
	)(2)


func suite_subscript_target(flag: Bool, a: Int[#3], b: Int[#3]) -> Int:
	(
		if flag:
			a
		else:
			b
	)[0]


func suite_chain_receiver(flag: Bool, a: List[Int], b: List[Int]) -> Int:
	(
		if flag:
			a
		else:
			b
	)
		.reverse()
		.length()


-- A looser-binding receiver keeps its parentheses when the method chain breaks.
func inline_chain_receiver(a: List[Int], b: List[Int]) -> Int:
	(a + b)
		.reverse()
		.length()


func suite_lambda_callee() -> Int:
	(
		func(x: Int) -> Int:
			y: Int = x + 1
			y * 2
	)(2)
