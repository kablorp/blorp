record Language {
	safe: Bool,
	fast: Bool,
	expressive: Bool,
	simple: Bool
}


pure func identify(lang: Language) -> String:
	if (
		lang.safe
		and lang.fast
		and lang.expressive
		and lang.simple
	):
		"blorp detected"
	else:
		"keep looking"


pure func both(a: Bool, b: Bool) -> String:
	if a and b:
		"both"
	else:
		"no"
