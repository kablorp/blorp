pure func summary(values: List[Int]) -> String:
    concurrent:   -- both tasks run at once
        sum: Int = values.fold(0,   pure func(total: Int, value: Int) -> Int: total + value)


        -- the second task
        squared = values.fold(0, pure func(total: Int, value: Int) -> Int: total + value * value)
        values.check()
    "${sum} ${squared}"
