pure func message(count: Int, total: Int) -> String:
    summary = (
        "the first part of the message "
        + count.to_string()
        + " and the second part "
        + total.to_string()
    )
    (
        "a final value that is far too long to fit on one line "
        + summary
        + " so it breaks "
        + count.to_string()
    )
