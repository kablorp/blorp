func main(text: String, values: List[Int]) -> Int:
    var end = 0
    while (
        (end < text.bytes.length())
            .and(
                text
                    .byte_is(end, ASCII_LF)
                    .not(),
            )
            .and(
                text
                    .byte_is(end, ASCII_CR)
                    .not(),
            )
    ):
        end = end + 1
    if (
        valid
            .and(open)
            .not()
    ):
        end = 1
    else if (
        valid
            .or(open)
            .not()
    ):
        end = 2
    for value in (
        values
            .filter(is_positive)
            .map(double)
    ):
        end = end + value
    match (
        values
            .filter(is_positive)
            .map(double)
    ):
        [first, ..._]: first
        _: 0
    end
