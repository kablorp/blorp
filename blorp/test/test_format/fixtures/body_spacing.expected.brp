pure func binding_between_one_liners(entries: List[Int]) -> List[Int]:
    first_with_a_long_name = 1

    var grown: List[Int] = entries.append({
        name = first_with_a_long_name,
        entity = first_with_a_long_name,
        origin = first_with_a_long_name
    })

    second = 2
    grown


pure func every_block_kind(value: Option[Int], count: Int) -> Int:
    total = 0

    if count > 0:
        total = 1
    else if count < 0:
        total = 2
    else:
        total = 3

    match value:
        Some(number):
            total = number
            total
        None:
            total

    var index = 0

    while index < count:
        index = index + 1

    for number in [1, 2]:
        index = index + number

    index


pure func multi_line_call_and_pipe_string(name: String, count: Int) -> String:
    first = 1

    print_line(
        first,
        name,
        count,
        "a long argument that pushes the call past the line width",
        count
    )

    second = 2

    text =
        |first line
        |second ${name}

    third = 3
    text


pure func block_as_final_value(count: Int) -> Int:
    first = 1

    if count > first:
        count
    else:
        first


pure func only_item_is_multi_line(count: Int) -> Int:
    for number in [1, 2]:
        print_line(number)

    count


pure func first_and_last_in_block(count: Int) -> Int:
    for number in [1, 2]:
        print_line(
            number,
            number,
            number,
            number,
            number,
            number,
            number,
            number,
            number,
            number,
            number
        )

    count


pure func adjacent_multi_line_items(count: Int) -> Int:
    var total = 0

    for number in [1, 2]:
        total = total + number

    for number in [3, 4]:
        total = total + number

    total


pure func comments_travel_with_their_statement(count: Int) -> Int:
    var total = 0

    -- Adds the first run.
    for number in [1, 2]:
        total = total + number -- trailing

    -- Adds the second run.
    -- It is longer.
    for number in [3, 4]:
        total = total + number

    -- A comment before the value.
    total


pure func a_users_blank_line_next_to_the_rule_blank(count: Int) -> Int:
    var total = 0

    for number in [1, 2]:
        total = total + number

    -- A comment after a blank.

    for number in [3, 4]:
        total = total + number

    total


pure func lambda_and_match_arm_blocks(values: List[Int]) -> List[Int]:
    values.map(pure func(value: Int) -> Int:
        doubled = value + value

        if doubled > 2:
            print_line(doubled)

        doubled
    )


pure func match_arm_block_body(value: Option[Int]) -> Int:
    match value:
        Some(number):
            first = number

            for step in [1, 2]:
                print_line(step)

            first
        None:
            0


pure func comment_after_last_item(flag: Bool) -> Int:
    var count = 0

    if flag:
        count = count + 1

        if count > 0:
            print_line(count)
        -- A comment at the end of the if block.

    count
