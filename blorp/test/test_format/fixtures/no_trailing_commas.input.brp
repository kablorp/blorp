import:
    list: List methods
    ../shapes/measurements: MeasurementRecord, SensorReading(TemperatureReading, HumidityReading, PressureReading,), combine_all_records, describe_measurement,


record MeasurementSummary { sensor_identifier_value: Int, recorded_temperature_value: Int, recorded_humidity_value: Int, }


union SensorSample:
    Temperature(MeasurementRecord, MeasurementRecord, MeasurementRecord, MeasurementRecord, MeasurementRecord,)
    Humidity(Int,)


func summarize(first_measurement: MeasurementRecord, second_measurement: MeasurementRecord, scale_factor: Int,) -> Int:
    readings = [first_reading_value_name, second_reading_value_name, third_reading_value_name, fourth,]
    pairs = (first_reading_value_name, second_reading_value_name, third_reading_value_name, fourth_one,)
    summary = { sensor_identifier_value = 1, recorded_temperature_value = 2, recorded_humidity_value = 3, }
    updated = { summary | sensor_identifier_value = first_reading_value_name, recorded_temperature_value = 4, }
    names = { "first_sensor" => first_reading_value_name, "second_sensor" => second_reading_value_name, }
    scaler = func(reading_value_name: Int, another_reading_value: Int, third_reading_name: Int, fourth_one: Int,) -> Int: reading_value_name
    hugged = combine_all_records(first_measurement, [first_reading_value_name, second_reading_value_name, third_reading_value_name,])
    total = combine_all_records(first_measurement, second_measurement, scale_factor, readings, pairs, updated,)
    short = [1, 2, 3,]
    total
