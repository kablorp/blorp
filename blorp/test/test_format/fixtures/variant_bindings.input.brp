union UserId:
    private Init(Int)


union Pair:
    Init(Int, Int)


pure func number(id: UserId) -> Int:
    -- The bare variant, spaced loosely.
    Init(  value )   =   id
    UserId.Init(_)=id
    value


pure func first(pair: Pair) -> Int:
    Pair.Init(left ,  right) =
        pair
    left
