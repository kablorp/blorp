-- Match comments survive layout changes: an inline body moves below its
-- pattern with its comment, a comment after a body moves to the next case or
-- closes the match, and blank lines between case comments close up.
func classify(values: List[Int]) -> Int:
	x = match values.get(0):
		Some(v): v -- inline body note
		-- none case

		-- none case, second note
		None:
			0
			-- after the last body
	x


func tail(values: List[Int]) -> Int:
	match values.get(0):
		Some(v):
			v
			-- after the first body
		None: 0
		-- after the last case
	-- after the match


func main() -> Int:
	classify([1]) + tail([2])
