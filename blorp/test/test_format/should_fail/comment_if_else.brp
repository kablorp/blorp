-- If comments survive layout changes: an inline `if` case body moves below its
-- pattern with its header comment, and a comment after a branch body moves
-- above the next `else`.
func nested(values: List[Int]) -> Int:
	match values.get(0):
		Some(value): if value > 0: -- inline header
			value
			-- after the then body
		else:
			0
		None:
			0


func main() -> Int:
	nested([1])
