-- The comment ending a declaration's first line is kept once: on the header, or
-- with the parameter it follows once the parameters break over lines. A comment
-- after a call whose lambda argument ends in a match stays after the call.
items: List[Int] = [1, -- first item
	2]


---
Adds two numbers.
---
func add(a: Int, -- left operand
	b: Int) -> Int:
	a + b


func apply(values: List[Int]) -> List[Int]:
	values.map(func(value):
		match value:
			0:
				1
			_:
				value
	) -- after the call


private limits: List[Int] = [ -- private header
	1,
	2,
]


private func scale(value: Int, -- the input
	factor: Int) -> Int:
	value * factor


trait Sized:
	func size(self, -- the receiver
		unit: Int) -> Int


func main() -> Int:
	add(items.length(), apply([1]).length())
