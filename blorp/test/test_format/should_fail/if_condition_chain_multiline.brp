pure func classify(value: String) -> String:
	if value
		.trim()
		.to_lower()
		.contains("ready"):
		"ready"
	else if value
		.trim()
		.to_lower()
		.contains("pending"):
		"pending"
	else:
		"other"


pure func has_text(value: String) -> Bool:
	if value
		.trim()
		.to_lower()
		.length() > 0:
		True
	else:
		False
