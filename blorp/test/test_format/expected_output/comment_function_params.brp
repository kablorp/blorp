-- Parameter comments survive layout changes: a parameter list with a comment
-- breaks one parameter per line. The declaration renderer handles the comment
-- ending the `func` line. Without a return type, the parser does not locate
-- `)`, so a comment after `):` that a blank line separates from the body moves
-- above `)`, and a comment ending the `):` line attaches to the last parameter.
func build(width: Float, height: Float) -> Float: -- the width
	width + height


func greet(
	name: String,
	-- the greeting
	greeting: String,
	-- above `)` after formatting
):
	print(greeting + name)


func sig(
	a: Int,
	b: Int, -- attaches to the last parameter
):
	a


func main() -> Int:
	build(1.0, 2.0)
	greet("a", "b")
	0
