import:
    ../../src/common/analysis/assemble:
        ParsedAssembly,
        ParsedProgram,
        append_module,
        assembly_names,
        begin_program
    ../../src/common/syntax/lex: lex
    ../../src/common/syntax/parse: parse_module
    ../../src/common/syntax/source:
        ModuleId,
        ModuleKind(LibraryModule, FoundationTypesModule, FoundationPreludeModule, UserModule),
        module_id,
        module_source,
        root_module_id
    ../../src/common/syntax/syntax: Diagnostic, diagnostic
    ./module_input: FOUNDATION_TYPES, sealed


-- A genuine library declaration imports the designated foundation explicitly.
-- Roles are supplied through the same typed assembly boundary as the loader.
LIBRARY_IMPORT: String = "import:\n    _base: Int, UInt8, String, Void, List, Result\n"


private pure func append_source(
    assembly: ParsedAssembly,
    module: ModuleId,
    source: String,
    targets: List[ModuleId],
    role: ModuleKind
) -> Result[ParsedAssembly, Diagnostic]:
    tokens ?= lex(module_source(module), source, assembly_names(assembly)).map_err(
        pure func(failure): failure.error
    )
    parsed ?= parse_module(tokens, module)
    append_module(assembly, parsed, targets, role, "native_fixture")


pure func library_program(source: String) -> Result[ParsedProgram, Diagnostic]:
    invalid = diagnostic(
        { source = module_source(root_module_id()), start = 0, end = 0 },
        "invalid native fixture module identity",
        "use the four explicit fixture module positions"
    )
    library ?= module_id(1).to_result(invalid)
    base ?= module_id(2).to_result(invalid)
    prelude ?= module_id(3).to_result(invalid)
    root ?= append_source(
        begin_program(),
        root_module_id(),
        "import:\n    native as native\nfunc main() -> Int:\n    native.main()\n",
        [library],
        UserModule
    )
    native ?= append_source(root, library, LIBRARY_IMPORT + source, [base], LibraryModule)
    types ?= append_source(native, base, FOUNDATION_TYPES, [], FoundationTypesModule)
    complete ?= append_source(
        types,
        prelude,
        "import:\n    _base: Int\n",
        [base],
        FoundationPreludeModule
    )
    sealed(complete)
