---
The loader's module rows: the root, then the foundation inputs, then each other
module in the order the loader discovers it, each shown by its absolute path.
A suite that needs a discovered module's number or a row's display path takes
it from here, so a new foundation input moves every such suite at once.
---
import:
    io/environment: get_current_directory
    path: join, normalize, to_path
    ../../src/common/syntax/source: ModuleId, ModuleSource, foundation_methods_module_id, module_id


-- The number of the first module the loader discovers. The foundation methods
-- module is the last foundation input the loader queues.
pure func first_discovered_module_number() -> Int:
    foundation_methods_module_id().module_number() + 1


-- `path` as the loader displays it: under the working directory, normalized.
func absolute(path: String) -> String:
    match (get_current_directory(), path.to_path()):
        (Ok(directory), Ok(relative)): "${directory.join(relative).normalize()}"
        (Err(error), _): "${error}"
        (_, Err(error)): "${error}"


-- The module loaded from `path`, by its absolute display path.
pure func module_of(rows: List[ModuleSource], path: String) -> Option[ModuleId]:
    var found: Option[ModuleId] = None
    var position = 0
    for row in rows:
        if row.path == path:
            found = module_id(position)
            break
        position = position + 1
    found
