import:
    option: Option methods
    result: map_err
    ../../src/common/codegen/lower/lower as lower
    ../../src/common/codegen/specialize/specialize as specialized
    ../../src/common/syntax/lex: lex
    ../../src/common/syntax/names: program_names
    ../../src/common/syntax/source: module_source, root_module_id
    ../../src/common/syntax/syntax: Diagnostic
    ./input: check, parse, setup_diagnostic
    ./module_input:
        ModuleInput,
        primitive_base,
        INTEGER_OPERATIONS,
        STRING_OPERATIONS,
        parse_modules_with_base,


BOX_SOURCE: String =
    |import:
    |	int: Int methods
    |	string: String methods
    |union Box[T]:
    |	Box(T)
    |pure func box[T](value: T) -> Box[T]:
    |	Box(value)
    |pure func unbox[T](value: Box[T]) -> T:
    |	match value:
    |		Box(payload): payload
    |func main() -> Int:
    |	unbox(box(42.to_string())).length()
    |


pure func lowered(source: String) -> Result[lower.LoweredProgram, Diagnostic]:
    tokens ?= lex(module_source(root_module_id()), source, program_names().names).map_err(
        pure func(failure): failure.error,
    )
    parsed ?= parse(tokens)
    checked ?= check(parsed).map_err(setup_diagnostic)
    concrete ?= specialized.specialize(checked)
    lower.lower(concrete)


pure func concrete_tail_join(body: specialized.ConcreteBody) -> Option[specialized.ConcreteJoin]:
    match body:
        specialized.ConcreteValueBody(specialized.ReturnExpression(value)):
            match value.form:
                specialized.Match(join): Some(join)
                _: None
        _:
            None


pure func lowered_tail_join(function: lower.LoweredFunction) -> Option[lower.LoweredJoin]:
    match function.steps.last():
        Some(step):
            match (step, function.result):
                (lower.Join(join), returned):
                    if lower.value_number(join.result.id) == lower.value_number(returned):
                        Some(join)
                    else:
                        None
                _:
                    None
        None:
            None


pure func box_inputs() -> List[ModuleInput]:
    [
        { source = BOX_SOURCE, targets = [1, 2] },
        { source = INTEGER_OPERATIONS, targets = [] },
        { source = STRING_OPERATIONS, targets = [] },
    ]


pure func lowered_modules(inputs: List[ModuleInput]) -> Result[lower.LoweredProgram, Diagnostic]:
    parsed ?= parse_modules_with_base(inputs, primitive_base())
    checked ?= check(parsed).map_err(setup_diagnostic)
    concrete ?= specialized.specialize(checked)
    lower.lower(concrete)


NAMED_CALLBACK_SOURCE: String =
    |pure func identity(value: String) -> String:
    |    value
    |pure func apply(f: pure (String) -> String, value: String) -> String:
    |    f(value)
    |func main() -> Int:
    |    saved = apply(identity, "é\0")
    |    0
    |


NONCAPTURING_CALLBACK_SOURCE: String =
    |pure func apply[T, U](f: pure (T) -> U, value: T) -> U:
    |    f(value)
    |func main() -> Int:
    |    saved = apply(pure func(text: String) -> String: text, "é\0")
    |    0
    |
