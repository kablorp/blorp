STRING_INTEGER_SOURCE: String =
    |pure func read_codepoint(value: String, index: Int) -> Option[Int]:
    |    builtin("string.codepoint_at")
    |pure func encode(value: Int) -> Option[String]:
    |    builtin("string.from_codepoint")
    |func main() -> Int:
    |    unused = read_codepoint("é", 1)
    |    unused_text = encode(0)
    |    0
    |


-- Expected quoted-label byte offsets in the literal above, independent of phase IR.
CODEPOINT_AT_LABEL_START: Int = 80
ENCODER_LABEL_START: Int = 163
