-- A root module checked with the module it imports as `./email`, for the
-- namespace and check suites of variant scopes and private variants.
import:
    ../../src/common/analysis/check/check: check
    ../../src/common/analysis/check/render: render_failure
    ../../src/common/syntax/syntax: Diagnostics
    ./marked_rejection: rejects_marked
    ./module_input: ModuleInput, parse_modules


-- `root` checked alone when `email` is empty, else with `email` as its one import.
pure func checked(root: String, email: String) -> Result[Void, Diagnostics]:
    inputs: List[ModuleInput] = if email == "":
        [{ source = root, targets = [] }]
    else:
        [{ source = root, targets = [1] }, { source = email, targets = [] }]

    match parse_modules(inputs):
        Err(error):
            Err({ first = error, remaining = [] })
        Ok(parsed):
            check(parsed)
                .map(pure func(_): void)
                .map_err(render_failure)


func compiles(root: String, email: String) -> Bool:
    match checked(root, email):
        Ok(_):
            True
        Err(diagnostics):
            print_error("${diagnostics.first.message} / ${diagnostics.first.help}")
            False


-- `marked` writes the root with its expected span between `[[` and `]]`; its
-- one diagnostic spans exactly that text, with this message and help.
func rejects(email: String, marked: String, message: String, help: String) -> Bool:
    rejects_marked(
        marked,
        message,
        help,
        pure func(root: String) -> Result[Void, Diagnostics]: checked(root, email)
    )
