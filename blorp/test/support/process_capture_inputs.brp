import:
    list: List methods
    option: Option methods
    result: Result methods
    ../../src/common/analysis/check/check: check
    ../../src/common/analysis/check/render: render_failure
    ../../src/common/analysis/namespace/builtins as builtins
    ../../src/common/codegen/lower/lower as lower
    ../../src/common/codegen/specialize/specialize as specialized
    ../../src/common/syntax/source: compiler_source
    ../../src/common/syntax/syntax:
        Diagnostic,
        DiagnosticKind(ProgramProblem),
        entry_function,
        SystemOperation(ProcessCapture),
    ./module_input: TestFoundation, parse_modules_with_base


-- process.capture is the system operation with the most operands, the only one
-- with List[String] operands, and an Int among them.
PROCESS_HEADER: String = "func query(program: String, arguments: List[String], directory: List[String], environment: List[String], stdin: List[String], timeout: Int) -> Result[List[String], Int]:\n    builtin("


PROCESS_SOURCE: String =
    |func query(program: String, arguments: List[String], directory: List[String], environment: List[String], stdin: List[String], timeout: Int) -> Result[List[String], Int]:
    |    builtin("process.capture")
    |func main() -> Int:
    |    arguments: List[String] = ["argument"]
    |    none: List[String] = []
    |    result = query("/program", arguments, none, none, none, 1000)
    |    0
    |


record ProcessSeed {
    lowered: lower.LoweredProgram,
    query: lower.LoweredFunction,
    query_id: specialized.FunctionInstanceId,
    constructors: builtins.DesignatedResult[specialized.VariantInstanceId],
}


private pure func invalid() -> Diagnostic:
    {
        span = { source = compiler_source(), start = 0, end = 0 },
        message = "invalid process test input",
        help = "retain the ordinary query call",
        kind = ProgramProblem,
        note = None,
    }


private pure func called_function(
    step: lower.LoweredStep,
) -> Option[specialized.FunctionInstanceId]:
    match step:
        lower.Define(definition):
            match definition.operation:
                lower.CallValue(specialized.UserFunction(id), _): Some(id)
                _: None
        _:
            None


pure func process_seed(foundation: TestFoundation) -> Result[ProcessSeed, Diagnostic]:
    parsed ?= parse_modules_with_base([{ source = PROCESS_SOURCE, targets = [] }], foundation)
    checked ?= check(parsed).map_err(pure func(failure): render_failure(failure).first)
    concrete ?= specialized.specialize(checked)
    lowered ?= lower.lower(concrete)
    contents = lower.lowered_functions(lowered)
    main ?= contents.functions
        .get(specialized.function_number(entry_function(contents.entrypoint)))
        .to_result(invalid())
    query_id: specialized.FunctionInstanceId ?= match main.steps.filter(
        pure func(step: lower.LoweredStep) -> Bool: called_function(step).is_some(),
    ):
        [call]: called_function(call).to_result(invalid())
        _: Err(invalid())
    query ?= contents.functions
        .get(specialized.function_number(query_id))
        .to_result(invalid())
    constructors: builtins.DesignatedResult[specialized.VariantInstanceId] ?= match query.steps:
        [_, _, _, _, _, _, lower.Define(result)]:
            match result.operation:
                lower.CallValue(specialized.RuntimeFunction(builtins.SystemCall(ProcessCapture, accepted)), _):
                    Ok(accepted)
                _:
                    Err(invalid())
        _:
            Err(invalid())
    Ok({ lowered = lowered, query = query, query_id = query_id, constructors = constructors })
