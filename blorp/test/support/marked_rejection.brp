-- One rejection checked exactly, for suites whose sources mark the span of
-- their one diagnostic with `[[` and `]]`.
import:
    bool: and
    ../../src/common/syntax/source: module_source, root_module_id
    ../../src/common/syntax/syntax: Diagnostics
    ./text_search: find_text


-- `marked` writes a root with its expected span between `[[` and `]]`, which
-- `diagnose` receives without them. Its one diagnostic spans exactly that text,
-- with this message and help; a mismatch prints what was reported.
func rejects_marked(
    marked: String,
    message: String,
    help: String,
    diagnose: (String) -> Result[Void, Diagnostics]
) -> Bool:
    open = find_text(marked, "[[", 0).get_or(0)
    close = find_text(marked, "]]", open).get_or(0)

    prefix = marked
        .slice(0, open)
        .get_or("")

    span_text = marked
        .slice(open + 2, close)
        .get_or("")

    root = (
        prefix
        + span_text
        + marked
            .slice(close + 2, marked.length())
            .get_or("")
    )

    match diagnose(root):
        Ok(_):
            print_error("checked without a diagnostic")
            False
        Err(diagnostics):
            first = diagnostics.first

            exact = and(
                and(
                    first.span.source == module_source(root_module_id()),
                    and(
                        first.span.start == prefix.length(),
                        first.span.end == prefix.length() + span_text.length()
                    )
                ),
                and(
                    and(diagnostics.remaining.is_empty(), first.message == message),
                    first.help == help
                )
            )

            if exact.not():
                print_error(
                    "reported ${first.span.start}..${first.span.end} ${first.message} / ${first.help}"
                )

            exact
