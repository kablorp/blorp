import:
    test: TestSuite
    ../../../../src/common/analysis/check/check: check
    ../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../src/common/syntax/lex: lex
    ../../../../src/common/syntax/names: program_names
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../src/common/syntax/syntax:
        Diagnostic,
        DiagnosticNote(UnionPayloadDeclaration),
        IntegerFormat(Int64Format)
    ../../../../src/common/utils/text: concat
    ../../../support/input: parse, setup_diagnostic
    ../../../support/module_input:
        INTEGER_OPERATIONS,
        ModuleInput,
        primitive_base,
        STRING_OPERATIONS,
        parse_modules_with_base


-- A second variant keeps Box a tagged union: one variant with one payload
-- would be stored as that payload (rule 8).
private SOURCE: String =
    |import:
    |	int: Int methods
    |	string: String methods
    |union Box[T]:
    |	Boxed(T)
    |	Spare(T)
    |pure func box[T](value: T) -> Box[T]:
    |	Boxed(value)
    |pure func unbox[T](value: Box[T]) -> T:
    |	match value:
    |		Boxed(payload): payload
    |		Spare(payload): payload
    |func main() -> Int:
    |	unbox(box(42.to_string())).length()
    |


private pure func specialized_source(
    source: String
) -> Result[specialized.SpecializedContents, Diagnostic]:
    tokens ?= lex(module_source(root_module_id()), source, program_names().names).map_err(
        pure func(failure): failure.error
    )

    parsed ?= parse(tokens)
    checked ?= check(parsed).map_err(setup_diagnostic)
    program ?= specialized.specialize(checked)
    Ok(specialized.specialized_contents(program))


private pure func specialized_modules(
    inputs: List[ModuleInput]
) -> Result[specialized.SpecializedContents, Diagnostic]:
    parsed ?= parse_modules_with_base(inputs, primitive_base())
    checked ?= check(parsed).map_err(setup_diagnostic)
    program ?= specialized.specialize(checked)
    Ok(specialized.specialized_contents(program))


-- Retain the exact first-red diagnostic in the recorded TestSuite output.
-- This remains useful failure output after String payload support is admitted.
private func report(error: Diagnostic) -> Bool:
    print_error(error.message)
    print_error(error.help)

    print_error(
        "span="
            .append_int(error.span.start)
            .concat("..")
            .append_int(error.span.end)
    )

    match error.note:
        Some(UnionPayloadDeclaration(span)):
            print_error(
                "payload="
                    .append_int(span.start)
                    .concat("..")
                    .append_int(span.end)
            )
        Some(_) | None:
            print_error("payload=none")

    False


func test_string_union_payload_has_concrete_string_type() -> Bool:
    match (specialized_modules([
        { source = SOURCE, targets = [1, 2] },
        { source = INTEGER_OPERATIONS, targets = [] },
        { source = STRING_OPERATIONS, targets = [] }
    ])):
        Err(error):
            report(error)
        Ok(program):
            match program.unions:
                [box]:
                    match specialized.union_variants(box):
                        [[specialized.StringType], [specialized.StringType]]: True
                        _: False
                _:
                    False


func test_unused_managed_variant_controls_the_complete_summary() -> Bool:
    source: String =
        |union Choice[T]:
        |	Empty
        |	Text(T)
        |	Number(Int)
        |pure func ignore(value: Choice[String]) -> Int:
        |	0
        |func main() -> Int:
        |	ignore(Empty)
        |

    match specialized_source(source):
        Err(error):
            report(error)
        Ok(program):
            match program.unions:
                [row]:
                    match row:
                        specialized.OwningCases(_):
                            match specialized.union_variants(row):
                                [[], [specialized.StringType], [specialized.IntegerType(Int64Format)]]:
                                    True
                                _:
                                    False
                        _:
                            False
                _:
                    False


-- Box's second variant keeps it a tagged union rather than its payload (rule 8).
func test_nested_summary_uses_the_earlier_child_layout() -> Bool:
    source: String =
        |union Choice[T]:
        |	Empty
        |	Text(T)
        |union Box[T]:
        |	Boxed(T)
        |	Unused
        |pure func ignore(value: Box[Choice[String]]) -> Int:
        |	0
        |func main() -> Int:
        |	ignore(Boxed(Empty))
        |

    match specialized_source(source):
        Err(error):
            report(error)
        Ok(program):
            match program.unions:
                [child, parent]:
                    match child:
                        specialized.OwningCases(_):
                            match parent:
                                specialized.OwningCases(_):
                                    match specialized.union_variants(parent):
                                        [[specialized.UnionType(id)], []]:
                                            specialized.union_number(id) == 0
                                        _:
                                            False
                                _:
                                    False
                        _:
                            False
                _:
                    False


func test_phantom_string_argument_creates_no_stored_obligation() -> Bool:
    source: String =
        |union Phantom[T]:
        |	Empty
        |pure func ignore(value: Phantom[String]) -> Int:
        |	0
        |func main() -> Int:
        |	ignore(Empty)
        |

    match specialized_source(source):
        Err(error):
            report(error)
        Ok(program):
            match program.unions:
                [row]:
                    match row:
                        specialized.PlainCases(_):
                            match specialized.union_variants(row):
                                [[]]: True
                                _: False
                        _:
                            False
                _:
                    False


-- Outer reaches Inner only through Tag's argument, which Tag never stores, so
-- no layout on the cycle owns anything. A second variant keeps each union a
-- tagged layout of its own, whatever single-payload unions become.
private PHANTOM_CYCLE: String =
    |union Tag[T]:
    |	Marked(Int)
    |	Unmarked
    |union Outer:
    |	Wrap(Tag[Inner])
    |	Bare
    |union Inner:
    |	Hold(Outer)
    |	Loose
    |pure func keep_outer(value: Outer) -> Int:
    |	0
    |pure func keep_inner(value: Inner) -> Int:
    |	0
    |pure func keep_tag(value: Tag[Inner]) -> Int:
    |	0
    |


private pure func every_layout_plain(layouts: List[specialized.ConcreteUnion]) -> Bool:
    var plain: Bool = True

    for layout in layouts:
        match layout:
            specialized.PlainCases(_): void
            specialized.OwningCases(_) | specialized.BoxedCases(_): plain = False

    plain


-- Whether `main` specializes to `count` unions, none of which owns anything.
private func specializes_plain(main: String, count: Int) -> Bool:
    match specialized_source(PHANTOM_CYCLE + main):
        Err(error): report(error)
        Ok(program): (program.unions.length() == count).and(program.unions.every_layout_plain())


-- Building Outer first prepares Inner while Outer is still in progress, so
-- Inner's payload is read before Outer's payloads are known.
func test_a_cycle_through_a_phantom_argument_owns_nothing_whichever_layout_comes_first() -> Bool:
    outer_first: String =
        |func main() -> Int:
        |	keep_outer(Wrap(Marked(2)))
        |

    inner_first: String =
        |func main() -> Int:
        |	keep_inner(Hold(Wrap(Marked(2))))
        |

    tag_first: String =
        |func main() -> Int:
        |	keep_tag(Marked(2))
        |

    specializes_plain(outer_first, 3)
        .and(specializes_plain(inner_first, 3))
        .and(specializes_plain(tag_first, 3))


-- Middle is first read as owning while Root is in progress; once Root is
-- plain, Middle is, and so is Leaf, which holds Middle.
func test_a_union_holding_a_union_on_a_phantom_cycle_is_plain() -> Bool:
    source: String =
        |union Tag[T]:
        |	Marked(Int)
        |	Unmarked
        |union Root:
        |	Grow(Tag[Middle])
        |	Seed
        |union Middle:
        |	Join(Root, Tag[Leaf])
        |union Leaf:
        |	Hang(Middle)
        |	Fall
        |pure func keep(value: Root) -> Int:
        |	0
        |func main() -> Int:
        |	keep(Grow(Marked(1)))
        |

    match specialized_source(source):
        Err(error): report(error)
        Ok(program): (program.unions.length() == 5).and(program.unions.every_layout_plain())


-- Wrapped is an inline record, so Holder, which holds it, owns nothing.
func test_a_union_holding_a_record_on_a_phantom_cycle_is_plain() -> Bool:
    source: String =
        |union Tag[T]:
        |	Marked(Int)
        |	Unmarked
        |record Wrapped { tag: Tag[Holder] }
        |union Holder:
        |	Hold(Wrapped)
        |	Empty
        |pure func keep(value: Wrapped) -> Int:
        |	0
        |func main() -> Int:
        |	keep({ tag = Marked(1) })
        |

    match specialized_source(source):
        Err(error): report(error)
        Ok(program): (program.unions.length() == 2).and(program.unions.every_layout_plain())


TESTS: TestSuite = {
    description = "Blorp managed union specialization",
    tests = [
        (
            "String union payload has its exact concrete type",
            test_string_union_payload_has_concrete_string_type
        ),
        (
            "unused managed variant controls complete summary",
            test_unused_managed_variant_controls_the_complete_summary
        ),
        (
            "nested summary uses earlier child layout",
            test_nested_summary_uses_the_earlier_child_layout
        ),
        (
            "phantom String argument creates no stored obligation",
            test_phantom_string_argument_creates_no_stored_obligation
        ),
        (
            "a cycle through a phantom argument owns nothing whichever layout comes first",
            test_a_cycle_through_a_phantom_argument_owns_nothing_whichever_layout_comes_first
        ),
        (
            "a union holding a union on a phantom cycle is plain",
            test_a_union_holding_a_union_on_a_phantom_cycle_is_plain
        ),
        (
            "a union holding a record on a phantom cycle is plain",
            test_a_union_holding_a_record_on_a_phantom_cycle_is_plain
        )
    ]
}
