---
Each constant a reached body reads has one instance, numbered in order of
first reach, whichever bodies read it; an unread constant has none. Each
instance's row, its type and the instances it holds as callables, is published
beside its value, the closed template translated; a function a constant holds
is an instance of its own.
---
import:
    bool: and
    test: TestSuite
    ../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../src/common/syntax/source: label_text
    ../../../support/input: checked_source


-- `main` reads NAMES and HANDLERS, in that order, and calls `first`, which
-- reads NAMES again. Nothing reads UNREAD.
private SOURCE: String =
    |pure func double(value: Int) -> Int:
    |    value
    |UNREAD: List[Int] = [5]
    |NAMES: List[String] = ["one", "two"]
    |HANDLERS: List[pure (Int) -> Int] = [double]
    |pure func first() -> List[String]:
    |    NAMES
    |func main() -> Int:
    |    names = first()
    |    again = NAMES
    |    handlers = HANDLERS
    |    0
    |


private pure func specialized_source() -> Option[specialized.SpecializedContents]:
    match checked_source(SOURCE).and_then(specialized.specialize):
        Err(_): None
        Ok(concrete): Some(specialized.specialized_contents(concrete))


-- The instance of the constant `first` returns, by number.
private pure func first_reads(contents: specialized.SpecializedContents) -> Option[Int]:
    match contents.functions.find(pure func(function: specialized.ConcreteFunction) -> Bool:
        label_text(function.label) == "module_0.first"
    ):
        Some(function):
            match function.body:
                specialized.ConcreteValueBody(specialized.ReturnExpression(value)):
                    match value.form:
                        specialized.ReadConstant(id): Some(specialized.constant_instance_number(id))
                        _: None
                _:
                    None
        None:
            None


pure func test_each_read_constant_has_one_instance() -> Bool:
    match specialized_source():
        None:
            False
        Some(contents):
            types_match: Bool = match contents.constants.map(
                pure func(row: specialized.ConcreteConstant) -> specialized.TypeRef: row.value_type
            ):
                [specialized.ListType(specialized.StringType), specialized.ListType(specialized.CallableType(_, _))]:
                    True
                _:
                    False

            first: Option[Int] = Some(0)
            types_match.and(first_reads(contents) == first)


pure func test_instance_values_are_translated_templates() -> Bool:
    match specialized_source():
        None:
            False
        Some(contents):
            match specialized.constant_values(contents.constant_values):
                [specialized.ListConstant([specialized.StringConstant(one), specialized.StringConstant(two)]), specialized.ListConstant([specialized.FunctionConstant(body)])]:
                    held = contents.functions.get(specialized.function_number(body))

                    -- The row indexes the callables the value holds.
                    callables = contents.constants.map(
                        pure func(row: specialized.ConcreteConstant) -> List[Int]:
                            row.callables.map(specialized.function_number)
                    )

                    expected_callables: List[List[Int]] = [[], [specialized.function_number(body)]]

                    double: Option[String] = Some("module_0.double")

                    (one == "one")
                        .and(two == "two")
                        .and(held.map(pure func(function): label_text(function.label)) == double)
                        .and(callables == expected_callables)
                _:
                    False


TESTS: TestSuite = {
    description = "Constant instances",
    tests = [
        (
            "each read constant has one instance and an unread one none",
            test_each_read_constant_has_one_instance
        ),
        (
            "instance values are translated templates beside their types",
            test_instance_values_are_translated_templates
        )
    ]
}
