---
A record's storage follows its fields' own layouts, and `fixed` takes no part:
inline when a copy acquires no counted pointer, by value when it acquires
exactly one, and a counted cell when it would acquire more, or when Check
found that the record contains itself. A String, a List, a callable, a boxed
union and any record that is not inline count one; an owning union counts its
widest case, whichever layout on a cycle specialization meets first.
---
import:
    bool: and
    test: TestSuite
    ../../../../src/common/analysis/check/check: check
    ../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../src/common/syntax/syntax: IntegerFormat(Int64Format)
    ../../../support/module_input: parse_modules


-- Each record has its own field shape, so its layout is found by shape.
private SOURCE: String =
    |fixed union Signal:
    |    Quiet
    |    Level(Int)
    |union Toggle:
    |    On
    |    Off
    |union Text:
    |    Blank
    |    Words(String)
    |union Both:
    |    Neither
    |    Two(String, String)
    |record Flagged { signal: Signal }
    |record Switched { set: Bool, value: Int }
    |record Toggled { value: Int, toggle: Toggle }
    |record Labelled { text: Text, value: Int, count: Int }
    |record Named { name: String, count: Int }
    |record Pair { first: String, second: String }
    |record Wrapped { inner: Named, weight: Float }
    |record Doubled { inner: Named, label: String }
    |record Holder { pair: Pair, flag: Bool }
    |record Twice { both: Both, weight: Float }
    |record Chain { next: Option[Chain], weight: Float, count: Int }
    |record Box[T] { value: T, weight: Float }
    |pure func flagged(item: Flagged) -> Int:
    |    0
    |pure func switched(item: Switched) -> Int:
    |    item.value
    |pure func toggled(item: Toggled) -> Int:
    |    item.value
    |pure func labelled(item: Labelled) -> Int:
    |    item.value
    |pure func named(item: Named) -> Int:
    |    item.count
    |pure func paired(item: Pair) -> Int:
    |    0
    |pure func wrapped(item: Wrapped) -> Int:
    |    item.inner.count
    |pure func doubled(item: Doubled) -> Int:
    |    item.inner.count
    |pure func held(item: Holder) -> Int:
    |    0
    |pure func twice(item: Twice) -> Int:
    |    0
    |pure func chained(item: Chain) -> Int:
    |    item.count
    |pure func boxed[T](item: Box[T]) -> Int:
    |    0
    |func main() -> Int:
    |    named_item: Named = { name = "five", count = 5 }
    |    pair: Pair = { first = "six", second = "seven" }
    |    first = flagged({ signal = Level(1) })
    |    second = switched({ set = True, value = 2 })
    |    third = toggled({ value = 3, toggle = On })
    |    fourth = labelled({ text = Words("four"), value = 4, count = 4 })
    |    fifth = named(named_item)
    |    sixth = paired(pair)
    |    seventh = wrapped({ inner = named_item, weight = 7.0 })
    |    eighth = doubled({ inner = named_item, label = "eight" })
    |    ninth = held({ pair = pair, flag = True })
    |    tenth = twice({ both = Neither, weight = 10.0 })
    |    eleventh = chained({ next = None, weight = 11.0, count = 11 })
    |    void_box: Box[Void] = { value = void, weight = 12.0 }
    |    text_box: Box[String] = { value = "thirteen", weight = 13.0 }
    |    twelfth = boxed(void_box)
    |    thirteenth = boxed(text_box)
    |    0
    |


-- Shape's widest case holds two Strings and Shape reaches Wrapper through a
-- List, so specialization prepares one of them while the other is in
-- progress; main's first binding decides which.
private WRAPPER_CYCLE: String =
    |union Shape:
    |    Pair(String, String)
    |    Many(List[Wrapper])
    |record Wrapper { shape: Shape }
    |pure func shape_size(shape: Shape) -> Int:
    |    0
    |pure func wrapper_size(item: Wrapper) -> Int:
    |    0
    |


-- Holder reaches the in-progress Shape only through Outer's payload.
private HOLDER_CYCLE: String =
    |union Shape:
    |    Pair(String, String)
    |    Many(List[Holder])
    |union Outer:
    |    Hold(Shape)
    |    Empty
    |record Holder { outer: Outer }
    |pure func shape_size(shape: Shape) -> Int:
    |    0
    |pure func holder_size(item: Holder) -> Int:
    |    0
    |


-- Holder reaches the in-progress Shape through Middle's payload, which holds
-- Outer while Outer still refers back to Shape.
private MIDDLE_CYCLE: String =
    |union Shape:
    |    Pair(String, String)
    |    Many(List[Holder])
    |union Outer:
    |    Hold(Shape)
    |    Empty
    |union Middle:
    |    Keep(Outer)
    |    Nothing
    |record Holder { middle: Middle }
    |pure func shape_size(shape: Shape) -> Int:
    |    0
    |pure func holder_size(item: Holder) -> Int:
    |    0
    |


-- Top is in progress around Shape, so when Shape completes, Link still refers
-- back to Top and stays pending while Holder's cost reads it.
private NESTED_CYCLE: String =
    |union Shape:
    |    Pair(String, String)
    |    Many(List[Holder])
    |union Link:
    |    Hold(Shape)
    |    Up(List[Top])
    |record Holder { link: Link }
    |record Top { shape: Shape, weight: Float }
    |pure func top_size(item: Top) -> Int:
    |    0
    |func main() -> Int:
    |    item: Top = { shape = Pair("a", "b"), weight = 1.0 }
    |    top_size(item)
    |


-- Back, published while Inner is in progress, refers back to Inner, so it
-- precedes Inner; when Outer completes, Inner's cost rises and Back's must
-- follow it.
private INNER_HEAD_CYCLE: String =
    |union Outer:
    |    Pair(List[Inner], String)
    |    Blank
    |union Inner:
    |    Wrap(Outer)
    |    Many(List[Back])
    |union Back:
    |    Hold(Inner)
    |    Empty
    |record Holder { back: Back }
    |pure func outer_size(item: Outer) -> Int:
    |    0
    |pure func holder_size(item: Holder) -> Int:
    |    0
    |


private OUTER_THEN_HOLDER: String =
    |func main() -> Int:
    |    outer: Outer = Blank
    |    first = outer_size(outer)
    |    item: Holder = { back = Empty }
    |    holder_size(item)
    |


private BACK_HOLDER_FIRST: String =
    |func main() -> Int:
    |    item: Holder = { back = Empty }
    |    holder_size(item)
    |


private SHAPE_FIRST: String =
    |func main() -> Int:
    |    shape: Shape = Pair("a", "b")
    |    shape_size(shape)
    |


private WRAPPER_FIRST: String =
    |func main() -> Int:
    |    item: Wrapper = { shape = Pair("a", "b") }
    |    wrapper_size(item)
    |


private HOLDER_FIRST: String =
    |func main() -> Int:
    |    item: Holder = { outer = Empty }
    |    holder_size(item)
    |


-- Root reaches Middle, and Middle reaches Leaf, only through Tag's argument,
-- which Tag never stores, so neither record holds a counted value. A second
-- variant keeps each union a tagged layout of its own, whatever
-- single-payload unions become.
private PHANTOM_CYCLE: String =
    |union Tag[T]:
    |    Marked(Int)
    |    Unmarked
    |union Root:
    |    Grow(Tag[Middle])
    |    Seed
    |record Middle { root: Root, tag: Tag[Leaf] }
    |record Leaf { middle: Middle, count: Int }
    |pure func root_size(value: Root) -> Int:
    |    0
    |pure func leaf_size(item: Leaf) -> Int:
    |    0
    |


-- Building Root first prepares Middle, and then Leaf, while Root is in progress.
private ROOT_FIRST: String =
    |func main() -> Int:
    |    root_size(Grow(Marked(1)))
    |


private LEAF_FIRST: String =
    |func main() -> Int:
    |    item: Leaf = { middle = { root = Grow(Marked(1)), tag = Marked(2) }, count = 3 }
    |    leaf_size(item)
    |


private MIDDLE_HOLDER_FIRST: String =
    |func main() -> Int:
    |    item: Holder = { middle = Nothing }
    |    holder_size(item)
    |


private union Storage:
    Inline
    ByValue
    Counted


private pure func specialized_records(source: String) -> List[specialized.ConcreteRecord]:
    match parse_modules([{ source = source, targets = [] }]):
        Err(_):
            []
        Ok(parsed):
            match check(parsed):
                Err(_):
                    []
                Ok(accepted):
                    match specialized.specialize(accepted):
                        Err(_): []
                        Ok(program): specialized.specialized_contents(program).records


-- The storage of the one record of `source` whose fields have this shape;
-- None when no record, or more than one, has the shape.
private pure func storage_with_shape(
    source: String,
    shape: pure (List[specialized.TypeRef]) -> Bool
) -> Option[Storage]:
    var found: Option[Storage] = None
    var matches = 0

    for layout in specialized_records(source):
        if shape(specialized.record_fields(layout)):
            matches = matches + 1

            found = match layout:
                specialized.InlineFields(_): Some(Inline)
                specialized.ValueFields(_): Some(ByValue)
                specialized.CountedFields(_): Some(Counted)

    if matches == 1:
        found
    else:
        None


pure func test_fixed_union_field_keeps_a_record_inline() -> Bool:
    (
        storage_with_shape(SOURCE, pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.UnionType(_)]: True
                _: False
        )
        == Some(Inline)
    )


pure func test_bool_field_keeps_a_record_inline() -> Bool:
    (
        storage_with_shape(SOURCE, pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.UnionType(_), specialized.IntegerType(Int64Format)]: True
                _: False
        )
        == Some(Inline)
    )


-- Toggle has no payload, so it is unmanaged although it is not declared fixed.
pure func test_ordinary_unmanaged_union_field_keeps_a_record_inline() -> Bool:
    (
        storage_with_shape(SOURCE, pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.IntegerType(Int64Format), specialized.UnionType(_)]: True
                _: False
        )
        == Some(Inline)
    )


pure func test_void_field_keeps_a_record_inline() -> Bool:
    (
        storage_with_shape(SOURCE, pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.VoidType, specialized.FloatType]: True
                _: False
        )
        == Some(Inline)
    )


pure func test_owning_union_with_one_pointer_stores_a_record_by_value() -> Bool:
    (
        storage_with_shape(SOURCE, pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.UnionType(_), specialized.IntegerType(Int64Format), specialized.IntegerType(Int64Format)]:
                    True
                _:
                    False
        )
        == Some(ByValue)
    )


pure func test_one_string_stores_a_record_by_value() -> Bool:
    (
        storage_with_shape(SOURCE, pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.StringType, specialized.IntegerType(Int64Format)]: True
                _: False
        )
        == Some(ByValue)
    )


-- Box[String] is a value at the instance Box[Void] is inline at.
pure func test_a_generic_record_with_one_string_is_stored_by_value() -> Bool:
    (
        storage_with_shape(SOURCE, pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.StringType, specialized.FloatType]: True
                _: False
        )
        == Some(ByValue)
    )


pure func test_two_strings_keep_a_record_counted() -> Bool:
    (
        storage_with_shape(SOURCE, pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.StringType, specialized.StringType]: True
                _: False
        )
        == Some(Counted)
    )


-- Named is a value with one String, which Wrapped holds by value.
pure func test_a_value_record_counts_its_one_pointer() -> Bool:
    (
        storage_with_shape(SOURCE, pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.RecordType(_), specialized.FloatType]: True
                _: False
        )
        == Some(ByValue)
    )


pure func test_a_value_record_beside_a_string_is_over_the_bound() -> Bool:
    (
        storage_with_shape(SOURCE, pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.RecordType(_), specialized.StringType]: True
                _: False
        )
        == Some(Counted)
    )


-- Pair is a counted cell, so holding it costs one count, as a String does.
pure func test_a_counted_record_counts_one() -> Bool:
    (
        storage_with_shape(SOURCE, pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.RecordType(_), specialized.UnionType(_)]: True
                _: False
        )
        == Some(ByValue)
    )


-- Both's case Two holds two Strings, so a copy of Twice may acquire two.
pure func test_an_owning_union_counts_its_widest_case() -> Bool:
    (
        storage_with_shape(SOURCE, pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.UnionType(_), specialized.FloatType]: True
                _: False
        )
        == Some(Counted)
    )


-- Chain holds one counted pointer, within the bound, but contains itself.
pure func test_a_record_that_contains_itself_is_counted() -> Bool:
    (
        storage_with_shape(SOURCE, pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.UnionType(_), specialized.FloatType, specialized.IntegerType(Int64Format)]:
                    True
                _:
                    False
        )
        == Some(Counted)
    )


private pure func only_a_union(fields: List[specialized.TypeRef]) -> Bool:
    match fields:
        [specialized.UnionType(_)]: True
        _: False


-- A copy of Wrapper acquires both of Pair's Strings, so Wrapper is a counted
-- cell whether Shape or Wrapper is prepared first.
pure func test_a_record_on_a_cycle_is_counted_whichever_layout_comes_first() -> Bool:
    and(
        storage_with_shape(WRAPPER_CYCLE + SHAPE_FIRST, only_a_union) == Some(Counted),
        storage_with_shape(WRAPPER_CYCLE + WRAPPER_FIRST, only_a_union) == Some(Counted)
    )


-- Holder's cost reads Outer, which holds Shape while Shape is in progress.
pure func test_a_record_beside_a_cycle_is_counted_whichever_layout_comes_first() -> Bool:
    and(
        storage_with_shape(HOLDER_CYCLE + SHAPE_FIRST, only_a_union) == Some(Counted),
        storage_with_shape(HOLDER_CYCLE + HOLDER_FIRST, only_a_union) == Some(Counted)
    )


-- Leaf is first stored by value because Middle is, and Middle because Root is
-- in progress; Middle is inline once Root is, and then so is Leaf.
pure func test_records_on_a_phantom_cycle_are_inline_whichever_layout_comes_first() -> Bool:
    middle = pure func(fields: List[specialized.TypeRef]) -> Bool:
        match fields:
            [specialized.UnionType(_), specialized.UnionType(_)]: True
            _: False

    leaf = pure func(fields: List[specialized.TypeRef]) -> Bool:
        match fields:
            [specialized.RecordType(_), specialized.IntegerType(Int64Format)]: True
            _: False

    and(
        and(
            storage_with_shape(PHANTOM_CYCLE + ROOT_FIRST, middle) == Some(Inline),
            storage_with_shape(PHANTOM_CYCLE + ROOT_FIRST, leaf) == Some(Inline)
        ),
        and(
            storage_with_shape(PHANTOM_CYCLE + LEAF_FIRST, middle) == Some(Inline),
            storage_with_shape(PHANTOM_CYCLE + LEAF_FIRST, leaf) == Some(Inline)
        )
    )


-- Holder is read while Outer is in progress, which owns nothing.
pure func test_a_record_holding_a_union_on_a_phantom_cycle_is_inline() -> Bool:
    source: String =
        |union Tag[T]:
        |    Marked(Int)
        |    Unmarked
        |union Outer:
        |    Wrap(Tag[Holder])
        |    Bare
        |record Holder { outer: Outer, count: Int }
        |pure func outer_size(value: Outer) -> Int:
        |    0
        |func main() -> Int:
        |    outer_size(Wrap(Marked(1)))
        |

    (
        storage_with_shape(source, pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.UnionType(_), specialized.IntegerType(Int64Format)]: True
                _: False
        )
        == Some(Inline)
    )


-- Middle's cost reads Outer's, so when Shape completes, Middle is costed
-- again before Holder is.
pure func test_a_record_two_unions_beside_a_cycle_is_counted_whichever_layout_comes_first() -> Bool:
    and(
        storage_with_shape(MIDDLE_CYCLE + SHAPE_FIRST, only_a_union) == Some(Counted),
        storage_with_shape(MIDDLE_CYCLE + MIDDLE_HOLDER_FIRST, only_a_union) == Some(Counted)
    )


-- Link is costed again when Shape completes, though it is still pending.
pure func test_a_record_beside_a_pending_union_is_counted_when_its_cycle_completes() -> Bool:
    storage_with_shape(NESTED_CYCLE, only_a_union) == Some(Counted)


-- Back's cost reads Inner's, which Outer's completion raises after Back is
-- derived again, so the layouts are derived again until none changes.
pure func test_a_union_before_the_layout_it_refers_back_to_is_costed_again() -> Bool:
    and(
        storage_with_shape(INNER_HEAD_CYCLE + OUTER_THEN_HOLDER, only_a_union) == Some(Counted),
        storage_with_shape(INNER_HEAD_CYCLE + BACK_HOLDER_FIRST, only_a_union) == Some(Counted)
    )


TESTS: TestSuite = {
    description = "Record storage from field layouts",
    tests = [
        ("a fixed union field keeps a record inline", test_fixed_union_field_keeps_a_record_inline),
        ("a Bool field keeps a record inline", test_bool_field_keeps_a_record_inline),
        (
            "an ordinary unmanaged union field keeps a record inline",
            test_ordinary_unmanaged_union_field_keeps_a_record_inline
        ),
        ("a Void field keeps a record inline", test_void_field_keeps_a_record_inline),
        (
            "an owning union with one pointer stores a record by value",
            test_owning_union_with_one_pointer_stores_a_record_by_value
        ),
        ("one String stores a record by value", test_one_string_stores_a_record_by_value),
        (
            "a generic record with one String is stored by value",
            test_a_generic_record_with_one_string_is_stored_by_value
        ),
        ("two Strings keep a record counted", test_two_strings_keep_a_record_counted),
        ("a value record counts its one pointer", test_a_value_record_counts_its_one_pointer),
        (
            "a value record beside a String is over the bound",
            test_a_value_record_beside_a_string_is_over_the_bound
        ),
        ("a counted record counts one", test_a_counted_record_counts_one),
        ("an owning union counts its widest case", test_an_owning_union_counts_its_widest_case),
        ("a record that contains itself is counted", test_a_record_that_contains_itself_is_counted),
        (
            "a record on a cycle is counted whichever layout comes first",
            test_a_record_on_a_cycle_is_counted_whichever_layout_comes_first
        ),
        (
            "a record beside a cycle is counted whichever layout comes first",
            test_a_record_beside_a_cycle_is_counted_whichever_layout_comes_first
        ),
        (
            "records on a phantom cycle are inline whichever layout comes first",
            test_records_on_a_phantom_cycle_are_inline_whichever_layout_comes_first
        ),
        (
            "a record holding a union on a phantom cycle is inline",
            test_a_record_holding_a_union_on_a_phantom_cycle_is_inline
        ),
        (
            "a record two unions beside a cycle is counted whichever layout comes first",
            test_a_record_two_unions_beside_a_cycle_is_counted_whichever_layout_comes_first
        ),
        (
            "a record beside a pending union is counted when its cycle completes",
            test_a_record_beside_a_pending_union_is_counted_when_its_cycle_completes
        ),
        (
            "a union before the layout it refers back to is costed again",
            test_a_union_before_the_layout_it_refers_back_to_is_costed_again
        )
    ]
}
