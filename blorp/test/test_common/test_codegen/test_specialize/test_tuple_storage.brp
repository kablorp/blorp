---
A structural tuple follows the record storage rule: inline when a copy
acquires no counted pointer, by value when it acquires one, and counted when
it would acquire more. An element whose layout is still in progress lies on a
cycle, which passes through a pointer, so it counts one.
---
import:
    test: TestSuite
    ../../../../src/common/analysis/check/check: check
    ../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../src/common/syntax/syntax: IntegerFormat(Int64Format)
    ../../../support/module_input: parse_modules


-- Each layout has its own element shape, so a tuple is found by shape.
private SOURCE: String =
    |record Point { x: Float, y: Int }
    |record Node { children: List[(Node, Float)] }
    |pure func numbers() -> (Int, Int):
    |    (1, 2)
    |pure func labelled() -> (Int, String):
    |    (1, "one")
    |pure func named() -> (String, String):
    |    ("one", "two")
    |pure func located() -> (Point, Int):
    |    ({ x = 1.5, y = 2 }, 3)
    |pure func descendants(node: Node) -> (Node, Float):
    |    (node, 0.5)
    |func main() -> Int:
    |    first = numbers()
    |    second = labelled()
    |    named_pair = named()
    |    third = located()
    |    fourth = descendants({ children = [] })
    |    0
    |


private pure func specialized_records() -> List[specialized.ConcreteRecord]:
    match parse_modules([{ source = SOURCE, targets = [] }]):
        Err(_):
            []
        Ok(parsed):
            match check(parsed):
                Err(_):
                    []
                Ok(accepted):
                    match specialized.specialize(accepted):
                        Err(_): []
                        Ok(program): specialized.specialized_contents(program).records


private union Storage:
    Inline
    ByValue
    Counted


-- The storage of the one layout whose fields have this shape; None when no
-- layout, or more than one, has the shape.
private pure func storage_with_shape(
    shape: pure (List[specialized.TypeRef]) -> Bool
) -> Option[Storage]:
    var found: Option[Storage] = None
    var matches = 0
    for layout in specialized_records():
        if shape(specialized.record_fields(layout)):
            matches = matches + 1
            found = match layout:
                specialized.InlineFields(_): Some(Inline)
                specialized.ValueFields(_): Some(ByValue)
                specialized.CountedFields(_): Some(Counted)
    if matches == 1:
        found
    else:
        None


pure func test_number_tuple_is_inline() -> Bool:
    (
        storage_with_shape(pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.IntegerType(Int64Format), specialized.IntegerType(Int64Format)]: True
                _: False
        )
        == Some(Inline)
    )


pure func test_tuple_with_a_string_is_stored_by_value() -> Bool:
    (
        storage_with_shape(pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.IntegerType(Int64Format), specialized.StringType]: True
                _: False
        )
        == Some(ByValue)
    )


pure func test_tuple_with_two_strings_is_counted() -> Bool:
    (
        storage_with_shape(pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.StringType, specialized.StringType]: True
                _: False
        )
        == Some(Counted)
    )


pure func test_tuple_holding_an_inline_record_is_inline() -> Bool:
    (
        storage_with_shape(pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.RecordType(_), specialized.IntegerType(Int64Format)]: True
                _: False
        )
        == Some(Inline)
    )


-- While (Node, Float) is prepared, Node's layout is still in progress. A
-- layout referred back to lies on a cycle, which passes through a pointer
-- (here Node's List), so it counts one, as the value Node turns out to be does.
pure func test_tuple_closing_a_recursive_cycle_is_stored_by_value() -> Bool:
    (
        storage_with_shape(pure func(fields: List[specialized.TypeRef]) -> Bool:
            match fields:
                [specialized.RecordType(_), specialized.FloatType]: True
                _: False
        )
        == Some(ByValue)
    )


TESTS: TestSuite = {
    description = "Structural tuple storage",
    tests = [
        ("a tuple of numbers is inline", test_number_tuple_is_inline),
        ("a tuple with a String is stored by value", test_tuple_with_a_string_is_stored_by_value),
        ("a tuple with two Strings is counted", test_tuple_with_two_strings_is_counted),
        (
            "a tuple holding an inline record is inline",
            test_tuple_holding_an_inline_record_is_inline
        ),
        (
            "a tuple closing a recursive cycle is stored by value",
            test_tuple_closing_a_recursive_cycle_is_stored_by_value
        )
    ]
}
