---
UInt8 is its own concrete type: it hashes apart from Int, and a fixed record
stores a UInt8 field inline.
---
import:
    bool: Bool methods
    test: TestSuite
    ../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../src/common/syntax/syntax: IntegerFormat(Int64Format, UInt8Format)
    ../../../support/uint8_inputs: checked_uint8


pure func test_uint8_hashes_apart_from_int() -> Bool:
    uint8: specialized.TypeRef = specialized.IntegerType(UInt8Format)
    int: specialized.TypeRef = specialized.IntegerType(Int64Format)
    (uint8.hash() != int.hash()).and(uint8 != int)


pure func test_a_fixed_record_stores_a_uint8_field_inline() -> Bool:
    source: String =
        |fixed record Pixel { red: UInt8, alpha: UInt8 }
        |func main() -> Int:
        |    pixel: Pixel = { red = 255, alpha = 0 }
        |    0
        |
    match checked_uint8(source):
        Err(_):
            False
        Ok(checked):
            match specialized.specialize(checked):
                Err(_):
                    False
                Ok(program):
                    match specialized.specialized_contents(program).records:
                        [specialized.InlineFields(fields)]:
                            (
                                fields
                                == [
                                    specialized.IntegerType(UInt8Format),
                                    specialized.IntegerType(UInt8Format),
                                ]
                            )
                        _:
                            False


TESTS: TestSuite = {
    description = "Blorp UInt8 concrete types",
    tests = [
        ("UInt8 hashes apart from Int", test_uint8_hashes_apart_from_int),
        (
            "a fixed record stores a UInt8 field inline",
            test_a_fixed_record_stores_a_uint8_field_inline,
        ),
    ],
}
