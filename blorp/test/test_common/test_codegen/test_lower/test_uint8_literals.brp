import:
    bool: Bool methods
    list: List methods
    test: TestSuite
    ../../../../src/common/codegen/lower/lower as lower
    ../../../../src/common/syntax/source: label_text
    ../../../../src/common/syntax/syntax: IntegerFormat(UInt8Format)
    ../../../support/uint8_inputs: UINT8_LITERAL, lowered_uint8


-- Lowering reads the literal's format from its checked type, so verification
-- and emission read it from the operation.
func test_a_uint8_literal_lowers_with_its_format() -> Bool:
    match lowered_uint8(UINT8_LITERAL):
        Err(error):
            print_error("${error.message} / ${error.help} at ${error.span.start}")
            False
        Ok(program):
            var found: Bool = False
            for function in lower.lowered_functions(program).functions:
                if label_text(function.label) == "module_0.byte":
                    for step in function.steps:
                        match step:
                            lower.Define(definition):
                                match definition.operation:
                                    lower.IntegerValue(UInt8Format, 200): found = True
                                    _: void
                            _:
                                void
            found


TESTS: TestSuite = {
    description = "Blorp UInt8 literal lowering",
    tests = [
        ("a UInt8 literal lowers with its format", test_a_uint8_literal_lowers_with_its_format),
    ],
}
