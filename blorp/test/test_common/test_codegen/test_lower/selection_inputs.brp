-- Observe published edge projections without rebuilding pattern facts.
import:
    ../../../../src/common/analysis/check/model: MatchArmId, match_arm_number
    ../../../../src/common/codegen/lower/lower as lower
    ../../../../src/common/codegen/specialize/specialize: VariantFieldInstanceId


record SelectedField {
    parameter: lower.ValueParameter,
    field: VariantFieldInstanceId,
    parent: lower.ValueId,
}


pure func selected_field(
    selection: lower.LoweredSelection,
    arm: MatchArmId,
) -> Option[SelectedField]:
    var found: Option[SelectedField] = None
    for node in selection.nodes:
        match node:
            lower.EnterArm(edge):
                if match_arm_number(edge.arm) == match_arm_number(arm):
                    match edge.definitions:
                        [lower.BorrowUnionField(parameter, field, parent)]:
                            found = Some({ parameter = parameter, field = field, parent = parent })
                        _:
                            void
            _:
                void
    found
