import:
    bool: Bool methods
    int: Int methods
    list: List methods
    string: String methods
    test: TestSuite
    ../../../../src/common/analysis/namespace/builtins as builtins
    ../../../../src/common/codegen/lower/lower as lower
    ../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../src/common/syntax/syntax: SystemOperation(ProcessCapture)
    ../../../support/module_input: test_base
    ../../../support/process_capture_inputs: PROCESS_HEADER, process_seed


pure func test_ordered_six_operands_and_operator_span_are_preserved() -> Bool:
    match process_seed(test_base()):
        Err(_):
            False
        Ok(seed):
            match seed.query.steps:
                [lower.Define(program), lower.Define(arguments), lower.Define(directory), lower.Define(environment), lower.Define(stdin), lower.Define(timeout), lower.Define(result)]:
                    match result.operation:
                        lower.CallValue(specialized.RuntimeFunction(builtins.SystemCall(ProcessCapture, _)), operands):
                            parameters = [
                                program,
                                arguments,
                                directory,
                                environment,
                                stdin,
                                timeout,
                            ].map(
                                pure func(parameter: lower.ValueDefinition) -> Int: lower.value_number(
                                    parameter.id,
                                ),
                            )
                            (operands.map(lower.value_number) == parameters)
                                .and(result.span.start.equals(PROCESS_HEADER.length()))
                                .and(
                                    result.span.end.equals(
                                        PROCESS_HEADER.length() + ("\"process.capture\"".length()),
                                    ),
                                )
                        _:
                            False
                _:
                    False


TESTS: TestSuite = {
    description = "Process builtin lowering",
    tests = [
        (
            "six operand identities and builtin span",
            test_ordered_six_operands_and_operator_span_are_preserved,
        ),
    ],
}
