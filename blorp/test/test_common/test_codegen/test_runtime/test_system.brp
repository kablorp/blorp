import:
    bool: Bool methods, not
    test: TestSuite
    ../../../../src/common/codegen/runtime/system: SYSTEM_CURRENT_DIRECTORY_RUNTIME
    ../../../support/text_search: has_text


pure func test_current_directory_fragment_publishes_its_out_pointer_and_code_abi() -> Bool:
    has_text(
        SYSTEM_CURRENT_DIRECTORY_RUNTIME,
        "uint8_t blorp_system_current_directory(struct blorp_string **directory,int64_t *error)",
    ).and(not(has_text(SYSTEM_CURRENT_DIRECTORY_RUNTIME, "struct blorp_Result")))


TESTS: TestSuite = {
    description = "Blorp system runtime fragment",
    tests = [
        (
            "current directory publishes String out-pointer and Int code ABI",
            test_current_directory_fragment_publishes_its_out_pointer_and_code_abi,
        ),
    ],
}
