import:
    test: TestSuite
    ../../../../src/common/codegen/runtime/blocking: BLOCKING_RUNTIME
    ../../../../src/common/codegen/runtime/console:
        CONSOLE_FLUSH_RUNTIME,
        CONSOLE_HELPERS_RUNTIME,
        CONSOLE_INPUT_RUNTIME,
        console_jobs_runtime,
        console_read_exact_runtime,
        console_read_line_runtime,
        console_write_error_runtime,
        console_write_runtime
    ../../../../src/common/codegen/runtime/fiber: FIBER_RUNTIME
    ../../../../src/common/codegen/runtime/fs: FS_HELPERS_RUNTIME
    ../../../../src/common/codegen/runtime/list:
        list_runtime,
        list_element_key,
        list_c_type,
        LIST_SHARED_RUNTIME
    ../../../../src/common/codegen/runtime/memory: MEMORY_RUNTIME
    ../../../../src/common/codegen/runtime/process: PROCESS_HELPERS_RUNTIME, PROCESS_POSIX_PRELUDE
    ../../../../src/common/codegen/runtime/sigpipe: SIGPIPE_GUARD_RUNTIME
    ../../../../src/common/codegen/runtime/string:
        STRING_PRINT_ERROR_RUNTIME,
        STRING_PRINT_RUNTIME,
        STRING_RUNTIME
    ../../../../src/common/codegen/runtime/thread: THREAD_RUNTIME
    ../../../../src/common/codegen/specialize/specialize: TypeRef(IntegerType)
    ../../../../src/common/syntax/syntax: IntegerFormat(UInt8Format)
    ../../../driver/file_access: write_file
    ../../../driver/harness: isolated, run_expecting, strict_leak_check
    ../../../driver/reports: verify_accounting


private COMPILE_TIMEOUT_MS: Int = 600000
private CASE_TIMEOUT_MS: Int = 60000


-- As the blocking suite's probes: the sanitized one runs under ASan and UBSan,
-- and the optimized one is built as a program is. Both keep the memory
-- diagnostics, for every case's strict allocation report.
private SANITIZED: List[String] = [
    "-O0",
    "-fsanitize=address,undefined",
    "-fno-sanitize-recover=all"
]


private OPTIMIZED: List[String] = ["-O2"]


private record Probes {
    sanitized: String,
    optimized: String
}


private func build_probe(
    c_compiler: String,
    directory: String,
    name: String,
    flags: List[String]
) -> Result[String, String]:
    executable = directory + "/" + name

    build ?= isolated(
        c_compiler,
        [
            "-std=c11",
            "-Wall",
            "-Wextra",
            "-Werror",
            "-pedantic",
            "-pthread",
            "-DBLORP_MEMORY_DIAGNOSTICS=1"
        ]
            .concat(flags)
            .concat([
                "-I",
                directory,
                "blorp/test/test_common/test_codegen/test_runtime/fixtures/console_test.c",
                "-o",
                executable,
                "-lm"
            ]),
        COMPILE_TIMEOUT_MS
    )

    built ?= run_expecting("console native build", build, 0)

    if built.stderr == "":
        Ok(executable)
    else:
        Err("console native build: " + built.stderr)


-- Builds fixtures/console_test.c, which includes the fragments as
-- console_runtime.c in the order a program calling all five operations, print
-- and print_error emits them, then the pool's fragments and the console's
-- jobs, and calls their C functions directly.
private func ready(c_compiler: String, directory: String) -> Result[Probes, String]:
    byte_list_type = list_c_type(list_element_key(IntegerType(UInt8Format)))

    fragments = (
        PROCESS_POSIX_PRELUDE
        + MEMORY_RUNTIME
        + STRING_RUNTIME
        + STRING_PRINT_RUNTIME
        + STRING_PRINT_ERROR_RUNTIME
        + "\n"
        + LIST_SHARED_RUNTIME
        + list_runtime(list_element_key(IntegerType(UInt8Format)), "uint8_t", "", "", None)
        + FS_HELPERS_RUNTIME
        + SIGPIPE_GUARD_RUNTIME
        + CONSOLE_HELPERS_RUNTIME
        + CONSOLE_INPUT_RUNTIME
        + console_write_runtime(byte_list_type)
        + console_write_error_runtime(byte_list_type)
        + CONSOLE_FLUSH_RUNTIME
        + console_read_line_runtime(byte_list_type)
        + console_read_exact_runtime(byte_list_type)
        + THREAD_RUNTIME
        + FIBER_RUNTIME
        + PROCESS_HELPERS_RUNTIME
        + BLOCKING_RUNTIME
        + console_jobs_runtime(byte_list_type)
    )

    _ ?= write_file(directory + "/console_runtime.c", fragments)
    sanitized ?= build_probe(c_compiler, directory, "console_test", SANITIZED)
    optimized ?= build_probe(c_compiler, directory, "console_test_optimized", OPTIMIZED)
    Ok({ sanitized = sanitized, optimized = optimized })


-- A case passes with exit 0, nothing on stdout, and one balanced strict
-- allocation report on stderr.
private func native_case(
    executable: String,
    directory: String,
    name: String
) -> Result[Void, String]:
    case ?= isolated(executable, [name, directory], CASE_TIMEOUT_MS)
    ran ?= run_expecting(name, { case | environment = strict_leak_check() }, 0)

    if ran.stdout != "":
        Err(name + ": wrote stdout: " + ran.stdout)
    else:
        verify_accounting(ran.stderr, True).map_err(
            pure func(message: String): name + ": " + message + ": " + ran.stderr
        )


private func reported(result: Result[Void, String]) -> Bool:
    match result:
        Ok(_):
            True
        Err(error):
            print_error(error)
            False


-- `name` passes on both probes; each reports its own failure.
private func passes(probes: Probes, directory: String, name: String) -> Bool:
    reported(native_case(probes.sanitized, directory, name)).and(
        reported(native_case(probes.optimized, directory, name))
    )


private func console_tests(probes: Probes, directory: String) -> List[(String, () -> Bool)]:
    [
        (
            "read_line returns a line with its LF, one line at a time, and empty at the end",
            func(): passes(probes, directory, "line_lf")
        ),
        ("read_line keeps the CR of a CRLF line", func(): passes(probes, directory, "line_crlf")),
        (
            "read_line returns an empty line as a lone LF, distinct from the end",
            func(): passes(probes, directory, "line_empty")
        ),
        (
            "read_line returns a last line without an LF as it is",
            func(): passes(probes, directory, "line_last_without_lf")
        ),
        (
            "read_line at end of input is empty, however often it is asked",
            func(): passes(probes, directory, "line_end_of_input")
        ),
        ("read_line keeps a lone CR", func(): passes(probes, directory, "line_lone_cr")),
        (
            "read_line returns bytes that are not UTF-8, a NUL and a long line unchanged",
            func(): passes(probes, directory, "line_raw_bytes")
        ),
        (
            "both reads of standard input that is a directory fail with the IsADirectory code",
            func(): passes(probes, directory, "read_directory")
        ),
        (
            "read_exact returns the count asked for, then what remains, then empty",
            func(): passes(probes, directory, "exact_counts")
        ),
        (
            "read_exact returns fewer bytes at end of input",
            func(): passes(probes, directory, "exact_short")
        ),
        (
            "read_exact of zero or less reads nothing",
            func(): passes(probes, directory, "exact_non_positive")
        ),
        (
            "read_exact of a count far beyond the input holds only what arrived",
            func(): passes(probes, directory, "exact_huge_count")
        ),
        (
            "read_exact crosses its growth steps without losing a byte",
            func(): passes(probes, directory, "exact_growth")
        ),
        (
            "read_exact returns bytes that are not UTF-8 unchanged",
            func(): passes(probes, directory, "exact_raw_bytes")
        ),
        (
            "read_line and read_exact share one buffer, header lines then the exact body",
            func(): passes(probes, directory, "shared_buffer")
        ),
        (
            "input that arrives after an end of input is read",
            func(): passes(probes, directory, "input_after_end")
        ),
        (
            "a read interrupted by a signal is retried and returns the line",
            func(): passes(probes, directory, "interrupted_read")
        ),
        (
            "print-style output and console writes keep their order",
            func(): passes(probes, directory, "output_order")
        ),
        (
            "print, print_error and the console's write keep every line whole on four threads",
            func(): passes(probes, directory, "whole_lines")
        ),
        (
            "a read flushes standard output before it waits",
            func(): passes(probes, directory, "flush_before_read")
        ),
        (
            "a write larger than the buffer to a closed reader is EPIPE and the process lives",
            func(): passes(probes, directory, "closed_write")
        ),
        (
            "flush to a closed reader is EPIPE and the process lives",
            func(): passes(probes, directory, "closed_flush")
        ),
        (
            "write_error to a closed reader is EPIPE and the process lives",
            func(): passes(probes, directory, "closed_write_error")
        ),
        (
            "a program that wrote, with its reader gone, exits 0 without SIGPIPE",
            func(): passes(probes, directory, "closed_exit")
        ),
        (
            "a program that printed and only flushed, with its reader gone, exits 0 without SIGPIPE",
            func(): passes(probes, directory, "closed_flush_exit")
        ),
        (
            "a program that printed and only read, with its reader gone, exits 0 without SIGPIPE",
            func(): passes(probes, directory, "closed_read_exit")
        ),
        (
            "one chunk of input gives each read its line and keeps the rest for the next",
            func(): passes(probes, directory, "pending_rest")
        ),
        (
            "a read of an empty pipe that the parent made non-blocking waits for its line",
            func(): passes(probes, directory, "nonblocking_input")
        ),
        (
            "a cancel ends both reads waiting on an open pipe with the end of input",
            func(): passes(probes, directory, "cancel_while_waiting")
        ),
        (
            "a cancelled read keeps what it took for the next read, line and exact",
            func(): passes(probes, directory, "cancel_keeps_partial")
        ),
        (
            "a line already buffered is returned before a cancel ends the read",
            func(): passes(probes, directory, "pending_line_beats_cancel")
        ),
        (
            "a cancelled partial larger than the buffer is kept whole",
            func(): passes(probes, directory, "cancel_partial_grows")
        ),
        (
            "a cancel reaches a read waiting on a terminal's partial line, which is then read whole",
            func(): passes(probes, directory, "terminal_cancel")
        ),
        (
            "two threads reading lines in place each get whole lines, every line once",
            func(): passes(probes, directory, "whole_reads")
        ),
        (
            "a cancellable read that finds the line lock held stops the program",
            func(): passes(probes, directory, "line_lock_refusal")
        ),
        (
            "each console job has its kind and, run on a helper, gives what its native gives in place",
            func(): passes(probes, directory, "jobs_on_helpers")
        ),
        (
            "a cancel reaches a read_line job waiting on a pipe, which ends with the end of input and keeps its partial",
            func(): passes(probes, directory, "job_cancel_reaches_read")
        )
    ]


func suite(c_compiler: String, directory: String) -> TestSuite:
    -- A probe that does not build is one failing test.
    tests: List[(String, () -> Bool)] = match ready(c_compiler, directory):
        Err(error): [("the console probe builds", func(): reported(Err(error)))]
        Ok(probes): console_tests(probes, directory)

    { description = "console runtime", tests = tests }
