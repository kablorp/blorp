-- The cases of fixtures/string_codepoints_test.c that end normally.
private CODEPOINT_CASES: List[String] = [
    "lengths",
    "codepoint_at",
    "codepoint_slice",
    "byte_slice",
    "word_count",
]


-- Builds blorp/test/test_common/test_codegen/test_runtime/fixtures/<name>_test.c, which includes
-- `fragments` as <name>_runtime.c. The probes share a subdirectory so that
-- their file names cannot meet another suite's.
private func ready(
    c_compiler: String,
    directory: String,
    name: String,
    fragments: String,
) -> Result[String, String]:
    _ ?= write_file(directory + "/" + name + "_runtime.c", MEMORY_RUNTIME + fragments)
    executable = directory + "/" + name + "_test"
    build ?= isolated(
        c_compiler,
        [
            "-std=c11",
            "-O0",
            "-Wall",
            "-Wextra",
            "-Werror",
            "-pedantic",
            "-fsanitize=address,undefined",
            "-fno-sanitize-recover=all",
            "-DBLORP_MEMORY_DIAGNOSTICS=1",
            "-I",
            directory,
            "blorp/test/test_common/test_codegen/test_runtime/fixtures/" + name + "_test.c",
            "-o",
            executable,
        ],
        COMPILE_TIMEOUT_MS,
    )
    built ?= run_expecting(name + " native build", build, 0)
    if built.stderr == "":
        Ok(executable)
    else:
        Err(name + " native build: " + built.stderr)


-- A case passes with exit 0, exactly `stdout`, and a balanced report from the
-- strict check, under which every String freed is recounted.
private func native_case(executable: String, name: String, stdout: String) -> Result[Void, String]:
    case ?= isolated(executable, [name], CASE_TIMEOUT_MS)
    ran ?= run_expecting(name, { case | environment = strict_leak_check() }, 0)
    if ran.stdout != stdout:
        Err(name + ": expected stdout [" + stdout + "] got [" + ran.stdout + "]")
    else:
        verify_accounting(ran.stderr, False).map_err(
            pure func(message: String): name + ": " + message + ": " + ran.stderr,
        )


-- The recount must stop a String whose count disagrees with its bytes at its
-- release, with the named fault and nothing else.
private func wrong_count_faults(executable: String) -> Result[Void, String]:
    case ?= isolated(executable, ["wrong_count_faults"], CASE_TIMEOUT_MS)
    ran ?= capture({ case | environment = strict_leak_check() }).map_err(
        pure func(error: CaptureError) -> String: "wrong_count_faults: ${error}",
    )
    if (
        (ran.exit == Signaled(ABORT_SIGNAL))
            .and(ran.stdout == "")
            .and(ran.stderr == WRONG_COUNT_FAULT)
    ):
        Ok(void)
    else:
        Err("wrong_count_faults: expected the code point fault; got " + ran.stderr)


private func reported(result: Result[Void, String]) -> Bool:
    match result:
        Ok(_):
            True
        Err(error):
            print_error(error)
            False


-- One test per (case, stdout), or one failing test when the probe did not build.
private func case_tests(
    built: Result[String, String],
    name: String,
    cases: List[(String, String)],
) -> List[(String, () -> Bool)]:
    match built:
        Err(error):
            [("the ${name} probe builds", func(): reported(Err(error)))]
        Ok(executable):
            var tests: List[(String, () -> Bool)] = []
            for entry in cases:
                match entry:
                    (label, stdout):
                        tests = tests.append(
                            (
                                "${name} ${label}",
                                func(): reported(native_case(executable, label, stdout)),
                            ),
                        )
            tests


private pure func silent(cases: List[String]) -> List[(String, String)]:
    cases.map(pure func(label: String) -> (String, String): (label, ""))


func suite(c_compiler: String, work_directory: String) -> TestSuite:
    directory = work_directory + "/strings"
    match make_directories(directory):
        Err(error):
            print_error(error)
            {
                description = "String runtime setup",
                tests = [("the probe directory is made", func(): False)],
            }
        Ok(_):
            strings = ready(
                c_compiler,
                directory,
                "string",
                (
                    string_runtime()
                    + STRING_SLICE_RUNTIME
                    + string_print_runtime()
                    + string_parse_int_runtime()
                    + string_equals_runtime()
                ),
            )
            concatenation = ready(
                c_compiler,
                directory,
                "string_concat",
                string_runtime() + string_concat_runtime() + string_append_int_runtime(),
            )
            codepoints = ready(
                c_compiler,
                directory,
                "string_codepoints",
                string_runtime() + STRING_SLICE_RUNTIME,
            )
            fault: List[(String, () -> Bool)] = match codepoints:
                Err(_):
                    []
                Ok(executable):
                    [
                        (
                            "string_codepoints a wrong count faults at release",
                            func(): reported(wrong_count_faults(executable)),
                        ),
                    ]
            {
                description = "String runtime",
                tests = case_tests(strings, "string", silent(STRING_CASES).concat(PRINT_CASES))
                    .concat(case_tests(concatenation, "string_concat", silent(CONCAT_CASES)))
                    .concat(case_tests(codepoints, "string_codepoints", silent(CODEPOINT_CASES)))
                    .concat(fault),
            }
