import:
    bool: Bool methods
    io/process: CaptureError, Exit(Signaled), capture
    list: List methods
    result: Result methods
    string: String methods
    test: TestSuite
    ../../../../src/common/codegen/runtime/memory: MEMORY_RUNTIME
    ../../../../src/common/codegen/runtime/string:
        string_equals_runtime,
        string_parse_int_runtime,
        string_print_runtime,
        string_runtime,
        STRING_SLICE_RUNTIME,
    ../../../../src/common/codegen/runtime/string_concat:
        string_append_int_runtime,
        string_concat_runtime,
    ../../../driver/file_access: make_directories, write_file
    ../../../driver/harness: isolated, run_expecting, strict_leak_check
    ../../../driver/reports: verify_accounting


private COMPILE_TIMEOUT_MS: Int = 600000
private CASE_TIMEOUT_MS: Int = 30000
-- abort() raises SIGABRT, which is 6 on macOS and Linux.
private ABORT_SIGNAL: Int = 6


private WRONG_COUNT_FAULT: String = "error: target String code point count disagrees with its bytes\n"


