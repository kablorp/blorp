import:
    bool: Bool methods
    test: TestSuite
    ../../../../src/common/codegen/runtime/list:
        callable_suffix,
        list_c_type,
        list_child_key,
        list_element_key,
        list_key_depth,
        list_suffix,
    ../../../../src/common/codegen/specialize/specialize: TypeRef(IntegerType, ListType)
    ../../../../src/common/syntax/syntax: IntegerFormat(Int64Format, UInt8Format)


pure func test_int64_list_keeps_its_element_key_and_c_type() -> Bool:
    key = list_element_key(IntegerType(Int64Format))
    (list_suffix(key) == "0_i").and(list_c_type(key) == "struct blorp_l_0_i*")


pure func test_nested_int64_lists_keep_their_depth_and_child_key() -> Bool:
    element: TypeRef = IntegerType(Int64Format)
    key = list_element_key(ListType(ListType(element)))
    (list_key_depth(key) == 2)
        .and(list_suffix(key) == "2_i")
        .and(list_child_key(list_child_key(key)) == list_element_key(element))


pure func test_int64_callable_suffix_keeps_its_scalar_and_list_spellings() -> Bool:
    element: TypeRef = IntegerType(Int64Format)
    callable_suffix([element, ListType(element)], element) == "p2_i_lie_r_i_e"


-- `b`, not `u8`: `u` followed by digits names a union instance.
pure func test_uint8_list_has_its_own_element_key_and_c_type() -> Bool:
    key = list_element_key(IntegerType(UInt8Format))
    (list_suffix(key) == "0_b")
        .and(list_c_type(key) == "struct blorp_l_0_b*")
        .and(key != list_element_key(IntegerType(Int64Format)))


pure func test_uint8_callable_suffix_differs_from_int64() -> Bool:
    element: TypeRef = IntegerType(UInt8Format)
    callable_suffix([element, ListType(element)], element) == "p2_b_lbe_r_b_e"


TESTS: TestSuite = {
    description = "Blorp integer storage identities",
    tests = [
        (
            "Int64 List keeps its element key and C type",
            test_int64_list_keeps_its_element_key_and_c_type,
        ),
        (
            "nested Int64 Lists keep their depth and child key",
            test_nested_int64_lists_keep_their_depth_and_child_key,
        ),
        (
            "Int64 callable suffix keeps its scalar and List spellings",
            test_int64_callable_suffix_keeps_its_scalar_and_list_spellings,
        ),
        (
            "UInt8 List has its own element key and C type",
            test_uint8_list_has_its_own_element_key_and_c_type,
        ),
        ("UInt8 callable suffix differs from Int64", test_uint8_callable_suffix_differs_from_int64),
    ],
}
