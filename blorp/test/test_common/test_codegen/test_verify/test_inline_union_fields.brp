---
Verification accepts an inline record whose fields are numbers, Void or
PlainCases unions, whether or not a union was declared fixed, and rejects one
whose union field owns a child. It sees only concrete layouts, so it checks
"no counted child", not a declared promise.
---
import:
    bool: and
    test: TestSuite
    ../../../../src/common/codegen/own/own as own
    ../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../src/common/codegen/verify/verify: verify
    ../../../../src/common/syntax/syntax: IntegerFormat(Int64Format)
    ../../../support/list_update_inputs: lowered


private SOURCE: String =
    |fixed union Signal:
    |    Quiet
    |    Level(Int)
    |union Text:
    |    Blank
    |    Words(String)
    |union Toggle:
    |    On
    |    Off
    |record Flagged { value: Int, signal: Signal }
    |record Labelled { value: Int, text: Text }
    |record Toggled { value: Int, toggle: Toggle }
    |record Box[T] { held: T, count: Int }
    |pure func flagged(item: Flagged) -> Int:
    |    item.value
    |pure func labelled(item: Labelled) -> Int:
    |    item.value
    |pure func toggled(item: Toggled) -> Int:
    |    item.value
    |pure func counted(item: Box[Void]) -> Int:
    |    item.count
    |func main() -> Int:
    |    first = flagged({ value = 1, signal = Level(1) })
    |    second = labelled({ value = 2, text = Words("two") })
    |    third = toggled({ value = 3, toggle = On })
    |    unit: Box[Void] = { held = void, count = 4 }
    |    fourth = counted(unit)
    |    0
    |


private pure func owned_program() -> Option[own.OwnershipProgram]:
    match lowered(SOURCE).and_then(own.own):
        Ok(program): Some(program)
        Err(_): None


-- Whether every field is Int or a PlainCases union.
private pure func numbers_and_plain_unions(
    fields: List[specialized.TypeRef],
    unions: List[specialized.ConcreteUnion]
) -> Bool:
    fields.all(pure func(field: specialized.TypeRef) -> Bool:
        match field:
            specialized.IntegerType(Int64Format):
                True
            specialized.UnionType(id):
                match unions.get(specialized.union_number(id)):
                    Some(specialized.PlainCases(_)): True
                    _: False
            _:
                False
    )


-- Flagged's Signal is declared fixed and Toggled's Toggle is not; both are
-- PlainCases, so both records are inline and verify.
pure func test_inline_records_with_plain_union_fields_verify() -> Bool:
    match owned_program():
        None:
            False
        Some(program):
            inline_with_unions = program.records.filter(
                pure func(layout: specialized.ConcreteRecord) -> Bool:
                    match layout:
                        specialized.InlineFields(fields):
                            and(
                                fields.length() == 2,
                                numbers_and_plain_unions(fields, program.unions)
                            )
                        specialized.ValueFields(_) | specialized.CountedFields(_):
                            False
            )
            and(inline_with_unions.length() == 2, verify(program).is_ok())


-- Void stores nothing, so Box[Void] holds only plain data.
pure func test_inline_record_with_a_void_field_verifies() -> Bool:
    match owned_program():
        None:
            False
        Some(program):
            void_box = program.records.any(pure func(layout: specialized.ConcreteRecord) -> Bool:
                match layout:
                    specialized.InlineFields([specialized.VoidType, specialized.IntegerType(Int64Format)]):
                        True
                    _:
                        False
            )
            and(void_box, verify(program).is_ok())


-- Labelled's Text owns a String, so Labelled cannot claim inline storage.
pure func test_inline_record_with_an_owning_union_field_is_rejected() -> Bool:
    match owned_program():
        None:
            False
        Some(program):
            records = program.records.map(
                pure func(layout: specialized.ConcreteRecord) -> specialized.ConcreteRecord:
                    specialized.InlineFields(specialized.record_fields(layout))
            )
            match verify({ program | records = records }):
                Ok(_):
                    False
                Err(error):
                    and(
                        (
                            error.message
                            == "ownership verification failed: record storage summary does not match its fields"
                        ),
                        error.help == "report this compiler error with the input program"
                    )


TESTS: TestSuite = {
    description = "Verified inline records with union fields",
    tests = [
        (
            "inline records with plain union fields verify",
            test_inline_records_with_plain_union_fields_verify
        ),
        (
            "an inline record with a Void field verifies",
            test_inline_record_with_a_void_field_verifies
        ),
        (
            "an inline record with an owning union field is rejected",
            test_inline_record_with_an_owning_union_field_is_rejected
        )
    ]
}
