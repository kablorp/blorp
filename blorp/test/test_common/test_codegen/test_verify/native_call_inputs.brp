-- Programs for the suites that verify the callables a native calls, a join's
-- tasks and a parallel map's callback: a source checked, specialized, lowered
-- and given ownership with the library on disk, as `make test` loads it, and
-- the instances it calls.
import:
    ../../../../src/common/analysis/assemble: ParsedProgram
    ../../../../src/common/analysis/check/check: check
    ../../../../src/common/analysis/check/render: render_failure
    ../../../../src/common/analysis/load/load:
        LibrarySource(LibraryDirectory),
        load_program_with_sources
    ../../../../src/common/codegen/lower/lower: LoweredProgram, lower
    ../../../../src/common/codegen/own/own as own
    ../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../src/common/syntax/syntax: Diagnostic


-- `source`, the program's root at `root`, with ownership inserted as
-- `labelling` says.
func owned_program(
    root: String,
    source: String,
    labelling: own.Labelling
) -> Option[own.OwnershipProgram]:
    match load_program_with_sources(root, LibraryDirectory("blorp/standard_library"), [
        { path = root, contents = source }
    ]):
        Ok(loaded):
            match loaded.program.checked_and_lowered():
                Ok(program):
                    match own.insert_ownership(program, labelling):
                        Ok(inserted): Some(inserted)
                        Err(_): None
                Err(_):
                    None
        Err(_):
            None


private pure func checked_and_lowered(program: ParsedProgram) -> Result[LoweredProgram, Diagnostic]:
    checked ?= check(program).map_err(pure func(failure): render_failure(failure).first)
    concrete ?= specialized.specialize(checked)
    lower(concrete)


-- An instance the program calls whose row `matches`, by one of its calls.
pure func called_instance(
    program: own.OwnershipProgram,
    matches: pure (own.OwnedFunction) -> Bool
) -> Option[specialized.FunctionInstanceId]:
    var found: Option[specialized.FunctionInstanceId] = None

    for function in program.functions:
        for operation in function.operations:
            match operation:
                own.DefineValue(definition):
                    match definition.operation:
                        own.CallDefinition(specialized.UserFunction(id), _):
                            match program.functions.get(specialized.function_number(id)):
                                Some(callee):
                                    if matches(callee):
                                        found = Some(id)
                                None:
                                    void
                        _:
                            void
                _:
                    void

    found


pure func borrows(function: own.OwnedFunction) -> Bool:
    function.parameters
        .any(own.parameter_owned)
        .not()
