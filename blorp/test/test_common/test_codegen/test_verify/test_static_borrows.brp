---
Verification pairs static borrows as it pairs every borrow source: only a
constant read's definition may borrow static storage, a managed read must, and
a use may claim a static borrow only of a value whose definition does. A read
names a constant of the program's catalogue, and each function a constant
holds is pinned. Each malformed program below is a verified one with one claim
changed.
---
import:
    bool: and
    test: TestSuite
    ../../../../src/common/codegen/own/own as own
    ../../../../src/common/codegen/verify/verify: verify
    ../../../../src/common/syntax/source: label_text
    ../../../../src/common/syntax/syntax: Diagnostic
    ../../../support/list_update_inputs: lowered


-- `made` is owned, and `size` borrows it. GROWERS holds `grow`, so ownership
-- pins `grow`'s parameter borrowed.
private SOURCE: String =
    |pure func append[T](values: List[T], element: T) -> List[T]:
    |    builtin("list.append")
    |pure func make() -> List[Int]:
    |    [1]
    |pure func size(values: List[Int]) -> Int:
    |    0
    |pure func grow(values: List[Int]) -> List[Int]:
    |    append(values, 1)
    |GROWERS: List[pure (List[Int]) -> List[Int]] = [grow]
    |func main() -> Int:
    |    made = make()
    |    growers = GROWERS
    |    size(made)
    |


-- The verified program with `rewrite` applied to each of main's operations.
private pure func rewritten(
    rewrite: pure (own.OwnershipOperation) -> own.OwnershipOperation
) -> Result[own.OwnershipProgram, Diagnostic]:
    owned ?= lowered(SOURCE).and_then(own.own)

    functions = owned.functions.map(pure func(function: own.OwnedFunction) -> own.OwnedFunction:
        if label_text(function.label) == "module_0.main":
            { function | operations = function.operations.map(rewrite) }
        else:
            function
    )

    Ok({ owned | functions = functions })


private pure func rejects(
    program: Result[own.OwnershipProgram, Diagnostic],
    message: String
) -> Bool:
    match program.and_then(verify):
        Ok(_): False
        Err(error): error.message == "ownership verification failed: " + message


private pure func rejected_with(
    rewrite: pure (own.OwnershipOperation) -> own.OwnershipOperation,
    message: String
) -> Bool:
    rewritten(rewrite).rejects(message)


-- The read of KINDS claims an owner instead of its static storage.
private pure func read_claims_an_owner(operation: own.OwnershipOperation) -> own.OwnershipOperation:
    match operation:
        own.DefineValue(definition):
            match definition.operation:
                own.ReadConstantDefinition(_):
                    own.DefineValue({ definition | result = own.OwnedResult(own.owner_id(9)) })
                _:
                    operation
        _:
            operation


-- `grow` claims to own its parameter, though GROWERS holds it.
private pure func owned_held_parameter(function: own.OwnedFunction) -> own.OwnedFunction:
    if label_text(function.label) == "module_0.grow":
        parameters = function.parameters.map(pure func(parameter) -> own.OwnedParameter:
            match parameter:
                own.ManagedParameter(passing): own.ManagedParameter({ passing | owned = True })
                own.UnmanagedParameter(_): parameter
        )

        { function | parameters = parameters }
    else:
        function


-- `make`'s call result claims a static borrow instead of its owner.
private pure func call_claims_static_borrow(
    operation: own.OwnershipOperation
) -> own.OwnershipOperation:
    match operation:
        own.DefineValue(definition):
            match (definition.operation, definition.result):
                (own.CallDefinition(_, []), own.OwnedResult(_)):
                    own.DefineValue({ definition | result = own.BorrowedResult(own.StaticBorrow) })
                _:
                    operation
        _:
            operation


-- `size` claims a static borrow of the owned `made`.
private pure func owned_used_as_static_borrow(
    operation: own.OwnershipOperation
) -> own.OwnershipOperation:
    match operation:
        own.DefineValue(definition):
            match definition.operation:
                own.CallDefinition(target, [own.BorrowedArgument(borrow)]):
                    static_argument = own.BorrowedArgument({ borrow | source = own.StaticBorrow })

                    own.DefineValue(
                        { definition | operation = own.CallDefinition(target, [static_argument]) }
                    )
                _:
                    operation
        _:
            operation


pure func test_unchanged_program_verifies() -> Bool:
    unchanged = rewritten(
        pure func(operation: own.OwnershipOperation) -> own.OwnershipOperation: operation
    )

    match unchanged.and_then(verify):
        Ok(_): True
        Err(_): False


pure func test_call_result_cannot_claim_a_static_borrow() -> Bool:
    rejected_with(call_claims_static_borrow, "managed result requires an owner")


pure func test_owned_value_cannot_be_used_as_a_static_borrow() -> Bool:
    rejected_with(owned_used_as_static_borrow, "static borrow requires a constant read")


pure func test_managed_read_must_borrow_static_storage() -> Bool:
    rejected_with(read_claims_an_owner, "managed constant read must borrow its static storage")


pure func test_held_callable_must_be_pinned() -> Bool:
    lowered(SOURCE)
        .and_then(own.own)
        .map(
            pure func(program: own.OwnershipProgram) -> own.OwnershipProgram: { program |
                functions = program.functions.map(owned_held_parameter)
            }
        )
        .rejects("pinned instance has an owned parameter")


pure func test_read_must_name_a_constant() -> Bool:
    lowered(SOURCE)
        .and_then(own.own)
        .map(
            pure func(program: own.OwnershipProgram) -> own.OwnershipProgram: { program |
                constants = []
            }
        )
        .rejects("constant read names no constant")


TESTS: TestSuite = {
    description = "Static borrow pairing",
    tests = [
        ("the unchanged program verifies", test_unchanged_program_verifies),
        (
            "a call result cannot claim a static borrow",
            test_call_result_cannot_claim_a_static_borrow
        ),
        (
            "an owned value cannot be used as a static borrow",
            test_owned_value_cannot_be_used_as_a_static_borrow
        ),
        (
            "a managed constant read must borrow its static storage",
            test_managed_read_must_borrow_static_storage
        ),
        ("a function a constant holds must be pinned", test_held_callable_must_be_pinned),
        ("a constant read must name a constant", test_read_must_name_a_constant)
    ]
}
