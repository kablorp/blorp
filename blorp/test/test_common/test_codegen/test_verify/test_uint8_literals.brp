---
Verification derives an integer literal's type from its format and checks that
the value fits, independently of checking. Each rejection replaces the one
UInt8 literal of an otherwise valid program.
---
import:
    bool: Bool methods
    option: Option methods
    result: Result methods
    string: String methods
    test: TestSuite
    ../../../../src/common/codegen/own/own as own
    ../../../../src/common/codegen/verify/verify: verify
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../src/common/syntax/syntax: IntegerFormat(Int64Format, UInt8Format)
    ../../../support/text_search: find_text
    ../../../support/uint8_inputs: UINT8_LITERAL, owned_uint8


-- The program with its UInt8 literal replaced by `replacement`.
private pure func replaced(
    program: own.OwnershipProgram,
    replacement: own.OwnedValueOperation,
) -> own.OwnershipProgram:
    functions = program.functions.map(pure func(function: own.OwnedFunction) -> own.OwnedFunction:
        operations = function.operations.map(
            pure func(operation: own.OwnershipOperation) -> own.OwnershipOperation:
                match operation:
                    own.DefineValue(definition):
                        match definition.operation:
                            own.IntegerDefinition(UInt8Format, _):
                                own.DefineValue({ definition | operation = replacement })
                            _:
                                operation
                    _:
                        operation
        )
        { function | operations = operations }
    )
    { program | functions = functions }


-- The one verification error, at the literal.
private pure func rejects(replacement: own.OwnedValueOperation, message: String) -> Bool:
    match (owned_uint8(UINT8_LITERAL), find_text(UINT8_LITERAL, "200", 0)):
        (Ok(program), Some(start)):
            match verify(program.replaced(replacement)):
                Ok(_):
                    False
                Err(error):
                    (error.message == "ownership verification failed: " + message)
                        .and(error.help == "report this compiler error with the input program")
                        .and(
                            (
                                error.span
                                == {
                                    source = module_source(root_module_id()),
                                    start = start,
                                    end = start + 3,
                                }
                            ),
                        )
        _:
            False


pure func test_a_uint8_literal_verifies() -> Bool:
    owned_uint8(UINT8_LITERAL)
        .and_then(verify)
        .is_ok()


pure func test_a_uint8_literal_outside_its_format_is_rejected() -> Bool:
    own.IntegerDefinition(UInt8Format, 300).rejects("integer literal does not fit its format")


-- The operation's format, not the declared type, decides the literal's type.
pure func test_a_literal_whose_format_disagrees_with_its_type_is_rejected() -> Bool:
    own.IntegerDefinition(Int64Format, 200).rejects("definition type does not match its operation")


TESTS: TestSuite = {
    description = "Blorp UInt8 literal verification",
    tests = [
        ("a UInt8 literal verifies", test_a_uint8_literal_verifies),
        (
            "a UInt8 literal outside its format is rejected",
            test_a_uint8_literal_outside_its_format_is_rejected,
        ),
        (
            "a literal whose format disagrees with its type is rejected",
            test_a_literal_whose_format_disagrees_with_its_type_is_rejected,
        ),
    ],
}
