---
A record stored by value has no cell of its own, but it owns the counted
pointer it holds, so verification treats each value as an owned value like a
counted one: it must have an owner, and that owner must be discharged.
---
import:
    bool: and
    test: TestSuite
    ../../../../src/common/codegen/own/own as own
    ../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../src/common/codegen/verify/verify: verify
    ../../../../src/common/syntax/syntax: Diagnostic, IntegerFormat(Int64Format)
    ../../../support/list_update_inputs: lowered


private CONSTRUCTED: String =
    |record Named { name: String, count: Int }
    |func main() -> Int:
    |    named: Named = { name = "one", count = 1 }
    |    named.count
    |


-- The value is copied into a call, updated, stored in a List and captured.
private SHAPES: String =
    |record Named { name: String, count: Int }
    |pure func renamed(item: Named, name: String) -> Named:
    |    { item | name = name }
    |func main() -> Int:
    |    first: Named = { name = "one", count = 1 }
    |    second = renamed(first, "two")
    |    names: List[Named] = [first, second]
    |    callback: pure (Int) -> Int = pure func(extra: Int) -> Int: second.count
    |    callback(1)
    |


private pure func owned_program(source: String) -> Option[own.OwnershipProgram]:
    match lowered(source).and_then(own.own):
        Ok(program): Some(program)
        Err(_): None


-- Whether `value_type` is a record the program stores by value.
private pure func value_record(
    program: own.OwnershipProgram,
    value_type: specialized.TypeRef
) -> Bool:
    match value_type:
        specialized.RecordType(id):
            match program.records.get(specialized.record_number(id)):
                Some(specialized.ValueFields(_)): True
                _: False
        _:
            False


-- The first definition in `main`'s top level that constructs a value record.
private pure func value_construction(program: own.OwnershipProgram) -> Option[own.OwnedDefinition]:
    var found: Option[own.OwnedDefinition] = None
    for function in program.functions:
        for operation in function.operations:
            match operation:
                own.DefineValue(definition):
                    match definition.operation:
                        own.ConstructRecordDefinition(_, _):
                            if (
                                found
                                    .is_none()
                                    .and(program.value_record(definition.value_type))
                            ):
                                found = Some(definition)
                        _:
                            void
                _:
                    void
    found


-- `program` with `edit` applied to every top-level operation list.
private pure func edited(
    program: own.OwnershipProgram,
    edit: pure (List[own.OwnershipOperation]) -> List[own.OwnershipOperation]
) -> own.OwnershipProgram:
    { program |
        functions = program.functions.map(
            pure func(function: own.OwnedFunction) -> own.OwnedFunction:
                { function | operations = edit(function.operations) }
        )
    }


private pure func rejected_with(outcome: Result[Void, Diagnostic], message: String) -> Bool:
    match outcome:
        Ok(_):
            False
        Err(error):
            and(
                error.message == "ownership verification failed: " + message,
                error.help == "report this compiler error with the input program"
            )


pure func test_value_records_verify_through_calls_updates_lists_and_captures() -> Bool:
    match owned_program(SHAPES):
        None:
            False
        Some(program):
            stored = program.records.any(pure func(layout: specialized.ConcreteRecord) -> Bool:
                match layout:
                    specialized.ValueFields([specialized.StringType, specialized.IntegerType(Int64Format)]):
                        True
                    _:
                        False
            )
            and(
                stored,
                verify(program)
                    .map(pure func(_) -> Void: void)
                    .is_ok()
            )


pure func test_a_value_record_without_an_owner_is_rejected() -> Bool:
    match owned_program(CONSTRUCTED):
        None:
            False
        Some(program):
            match program.value_construction():
                None:
                    False
                Some(construction):
                    unowned = program.edited(
                        pure func(
                            operations: List[own.OwnershipOperation]
                        ) -> List[own.OwnershipOperation]:
                            operations.map(
                                pure func(
                                    operation: own.OwnershipOperation
                                ) -> own.OwnershipOperation:
                                    match operation:
                                        own.DefineValue(definition):
                                            if definition.id == construction.id:
                                                own.DefineValue(
                                                    { definition | result = own.UnmanagedResult }
                                                )
                                            else:
                                                operation
                                        _:
                                            operation
                            )
                    )
                    rejected_with(
                        verify(unowned).map(pure func(_) -> Void: void),
                        "managed result requires an owner"
                    )


pure func test_a_value_record_owner_left_undropped_is_rejected() -> Bool:
    match owned_program(CONSTRUCTED):
        None:
            False
        Some(program):
            owner: Option[own.OwnerId] = match program.value_construction():
                Some(construction):
                    match construction.result:
                        own.OwnedResult(id): Some(id)
                        _: None
                None:
                    None
            match owner:
                None:
                    False
                Some(id):
                    kept = program.edited(
                        pure func(
                            operations: List[own.OwnershipOperation]
                        ) -> List[own.OwnershipOperation]:
                            operations.filter(pure func(operation: own.OwnershipOperation) -> Bool:
                                match operation:
                                    own.DropOwner(dropped, _):
                                        own.owner_number(dropped) != own.owner_number(id)
                                    _:
                                        True
                            )
                    )
                    dropped_once = program.functions.any(
                        pure func(function: own.OwnedFunction) -> Bool:
                            function.operations.any(
                                pure func(operation: own.OwnershipOperation) -> Bool:
                                    match operation:
                                        own.DropOwner(dropped, _):
                                            own.owner_number(dropped) == own.owner_number(id)
                                        _:
                                            False
                            )
                    )
                    and(
                        and(
                            dropped_once,
                            verify(program)
                                .map(pure func(_) -> Void: void)
                                .is_ok()
                        ),
                        rejected_with(
                            verify(kept).map(pure func(_) -> Void: void),
                            "owner ${own.owner_number(id)} remains live at return"
                        )
                    )


TESTS: TestSuite = {
    description = "Verified ownership of records stored by value",
    tests = [
        (
            "value records verify through calls, updates, Lists and captures",
            test_value_records_verify_through_calls_updates_lists_and_captures
        ),
        (
            "a value record without an owner is rejected",
            test_a_value_record_without_an_owner_is_rejected
        ),
        (
            "a value record owner left undropped is rejected",
            test_a_value_record_owner_left_undropped_is_rejected
        )
    ]
}
