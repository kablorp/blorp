import:
    bool: Bool methods, not
    option: Option methods
    result: Result methods
    test: TestSuite
    ../../../../src/common/analysis/namespace/builtins as builtins
    ../../../../src/common/codegen/lower/lower as lower
    ../../../../src/common/codegen/own/own as own
    ../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../src/common/codegen/verify/verify: verify
    ../../../../src/common/syntax/syntax:
        IntegerFormat(Int64Format),
        Diagnostic,
        entry_function,
        FunctionExecution(OrdinaryCalls),
        Entrypoint(NoArguments),
        EntryResult(IntegerExitStatus),
        SystemOperation(CurrentDirectory),
    ../../../support/current_directory_inputs:
        CurrentDirectorySeed,
        current_directory_seed,
        current_directory_seed_from_source,
        called_function,
    ../../../support/list_update_inputs: placeholder_label
    ../../../support/module_input: test_base
    ../../../support/ownership_inputs: InputIds, input_ids, span


private pure func raw_result(
    ids: InputIds,
    constructors: builtins.DesignatedResult[specialized.VariantInstanceId],
    ownership: own.ResultOwnership,
    drops: List[own.OwnershipOperation],
    unions: List[specialized.ConcreteUnion],
) -> own.OwnershipProgram:
    call: specialized.CallTarget = specialized.RuntimeFunction(
        builtins.SystemCall(CurrentDirectory, constructors),
    )
    result: own.OwnedDefinition = {
        id = ids.first,
        value_type = specialized.UnionType(specialized.variant_owner(constructors.ok)),
        operation = own.CallDefinition(call, []),
        result = ownership,
        span = span(30),
    }
    zero: own.OwnedDefinition = {
        id = ids.second,
        value_type = specialized.IntegerType(Int64Format),
        operation = own.IntegerDefinition(Int64Format, 0),
        result = own.UnmanagedResult,
        span = span(50),
    }
    function: own.OwnedFunction = {
        label = placeholder_label("main"),
        parameters = [],
        return_type = specialized.IntegerType(Int64Format),
        operations = [own.DefineValue(result)]
            .concat(drops)
            .append(own.DefineValue(zero)),
        result = own.UnmanagedReturn(ids.second),
    }
    {
        records = [],
        unions = unions,
        functions = [function],
        entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
    }


private pure func rejection_is(error: Diagnostic, message: String, at: Int) -> Bool:
    (error.message == "ownership verification failed: " + message)
        .and(error.help == "report this compiler error with the input program")
        .and(error.span.source == span(at).source)
        .and(error.span.start == at)
        .and(error.span.end == at + 1)
        .and(error.note.is_none())


private pure func rejects(program: own.OwnershipProgram, message: String, at: Int) -> Bool:
    match verify(program):
        Ok(_): False
        Err(error): rejection_is(error, message, at)


private pure func valid_result(seed: CurrentDirectorySeed, ids: InputIds) -> own.OwnershipProgram:
    raw_result(
        ids,
        seed.constructors,
        own.OwnedResult(own.owner_id(0)),
        [own.DropOwner(own.owner_id(0), span(40))],
        lower.lowered_functions(seed.lowered).unions,
    )


pure func test_raw_result_has_one_owner_and_drop() -> Bool:
    match (current_directory_seed(test_base()), input_ids()):
        (Ok(seed), Ok(ids)): verify(valid_result(seed, ids)).is_ok()
        _: False


pure func test_verifier_rejects_wrong_error_payload() -> Bool:
    match (current_directory_seed(test_base()), input_ids()):
        (Ok(seed), Ok(ids)):
            program = valid_result(seed, ids)
            wrong: List[specialized.ConcreteUnion] = [
                specialized.OwningCases([[specialized.StringType], [specialized.StringType]]),
            ]
            rejects(
                { program | unions = wrong },
                "variant payload does not match its operation",
                30,
            )
        _:
            False


-- A designated Bool result whose two constructors are one variant: the union has
-- the right shape and payloads, so only the distinctness condition rejects it.
pure func test_verifier_rejects_duplicate_bool_result_constructor() -> Bool:
    match (current_directory_seed(test_base()), input_ids()):
        (Ok(seed), Ok(ids)):
            same = seed.constructors.ok
            call: specialized.CallTarget = specialized.RuntimeFunction(
                builtins.IntegerEquals(Int64Format, { true_variant = same, false_variant = same }),
            )
            integer_type = specialized.IntegerType(Int64Format)
            left: own.OwnedDefinition = {
                id = ids.first,
                value_type = integer_type,
                operation = own.IntegerDefinition(Int64Format, 0),
                result = own.UnmanagedResult,
                span = span(10),
            }
            right: own.OwnedDefinition = { left | id = ids.second, span = span(20) }
            comparison: own.OwnedDefinition = {
                id = ids.third,
                value_type = specialized.UnionType(specialized.variant_owner(same)),
                operation = own.CallDefinition(call, [
                    own.UnmanagedArgument(ids.first),
                    own.UnmanagedArgument(ids.second),
                ]),
                result = own.UnmanagedResult,
                span = span(30),
            }
            function: own.OwnedFunction = {
                label = placeholder_label("main"),
                parameters = [],
                return_type = integer_type,
                operations = [
                    own.DefineValue(left),
                    own.DefineValue(right),
                    own.DefineValue(comparison),
                ],
                result = own.UnmanagedReturn(ids.first),
            }
            program: own.OwnershipProgram = {
                records = [],
                unions = [specialized.PlainCases([[], []])],
                functions = [function],
                entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
            }
            rejects(program, "runtime Bool constructors do not cover one result union", 30)
        _:
            False


pure func test_verifier_rejects_unmanaged_result() -> Bool:
    match (current_directory_seed(test_base()), input_ids()):
        (Ok(seed), Ok(ids)):
            rejects(
                raw_result(
                    ids,
                    seed.constructors,
                    own.UnmanagedResult,
                    [],
                    lower.lowered_functions(seed.lowered).unions,
                ),
                "managed result requires an owner",
                30,
            )
        _:
            False


pure func test_verifier_rejects_missing_result_drop() -> Bool:
    match (current_directory_seed(test_base()), input_ids()):
        (Ok(seed), Ok(ids)):
            rejects(
                raw_result(
                    ids,
                    seed.constructors,
                    own.OwnedResult(own.owner_id(0)),
                    [],
                    lower.lowered_functions(seed.lowered).unions,
                ),
                "owner 0 remains live at return",
                50,
            )
        _:
            False


pure func test_verifier_rejects_missing_result_constructor() -> Bool:
    match (current_directory_seed(test_base()), input_ids()):
        (Ok(seed), Ok(ids)):
            program = valid_result(seed, ids)
            missing: List[specialized.ConcreteUnion] = [
                specialized.OwningCases([[specialized.StringType]]),
            ]
            rejects({ program | unions = missing }, "unknown variant identity", 30)
        _:
            False


pure func test_verifier_rejects_duplicate_result_drop() -> Bool:
    match (current_directory_seed(test_base()), input_ids()):
        (Ok(seed), Ok(ids)):
            drops = [
                own.DropOwner(own.owner_id(0), span(40)),
                own.DropOwner(own.owner_id(0), span(41)),
            ]
            program = raw_result(
                ids,
                seed.constructors,
                own.OwnedResult(own.owner_id(0)),
                drops,
                lower.lowered_functions(seed.lowered).unions,
            )
            rejects(program, "owner 0 has already been discharged", 41)
        _:
            False


func test_verifier_rejects_cross_owner_error_constructor() -> Bool:
    source: String =
        |union Other:
        |    Outside(Int)
        |func query() -> Result[String, Int]:
        |    builtin("system.current_directory")
        |func escape() -> String:
        |    match query():
        |        Ok(path): path
        |        Err(_): ""
        |pure func make_other() -> Other:
        |    Outside(0)
        |func main() -> Int:
        |    unused = query()
        |    escaped = escape()
        |    other_value = make_other()
        |    0
        |
    match (current_directory_seed_from_source(source, test_base()), input_ids()):
        (Err(error), _):
            print_error("cross-owner fixture: " + error.message)
            print_error(error.help)
            False
        (Ok(seed), Ok(ids)):
            contents = lower.lowered_functions(seed.lowered)
            match contents.functions.get(
                specialized.function_number(entry_function(contents.entrypoint)),
            ):
                Some(main):
                    result_owner = specialized.union_number(
                        specialized.variant_owner(seed.constructors.ok),
                    )
                    other_calls = main.steps.filter(pure func(step):
                        match step:
                            lower.Define(definition):
                                match definition.value_type:
                                    specialized.UnionType(owner):
                                        specialized.union_number(owner) != result_owner
                                    _:
                                        False
                            _:
                                False
                    )
                    match other_calls:
                        [lower.Define(other_call)]:
                            match called_function(other_call).map(
                                pure func(id): contents.functions.get(
                                    specialized.function_number(id),
                                ),
                            ):
                                Ok(Some(maker)):
                                    match maker.steps:
                                        [lower.Define(_), lower.Define(other_definition)]:
                                            match other_definition.operation:
                                                lower.ConstructValue(constructor, [_]):
                                                    program = raw_result(
                                                        ids,
                                                        { seed.constructors | err = constructor },
                                                        own.OwnedResult(own.owner_id(0)),
                                                        [own.DropOwner(own.owner_id(0), span(40))],
                                                        contents.unions,
                                                    )
                                                    match verify(program):
                                                        Err(error):
                                                            rejection_is(
                                                                error,
                                                                "runtime Result constructors do not cover one result union",
                                                                30,
                                                            )
                                                        Ok(_):
                                                            False
                                                _:
                                                    False
                                        _:
                                            False
                                _:
                                    False
                        _:
                            False
                None:
                    False
        _:
            False


TESTS: TestSuite = {
    description = "Blorp independent Result verification",
    tests = [
        ("raw Result owner and drop are valid", test_raw_result_has_one_owner_and_drop),
        ("Result error payload must match", test_verifier_rejects_wrong_error_payload),
        ("missing Result constructor rejects", test_verifier_rejects_missing_result_constructor),
        ("duplicate Result drop rejects", test_verifier_rejects_duplicate_result_drop),
        (
            "Bool constructors must be distinct",
            test_verifier_rejects_duplicate_bool_result_constructor,
        ),
        ("Result must own its String", test_verifier_rejects_unmanaged_result),
        ("Result owner must be dropped", test_verifier_rejects_missing_result_drop),
        (
            "Result error constructor must share its owner",
            test_verifier_rejects_cross_owner_error_constructor,
        ),
    ],
}
