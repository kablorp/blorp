---
A join's trampolines call each task's instance directly, lending it the
job's environment, and store its result in the pair, so own pins each task
to the borrowed ABI and verification checks each task against its slot. A
join that names the wrong instance is rejected at the call. The program
loads the library on disk, as `make test` does, for its block.
---
import:
    test: TestSuite
    ../../../../src/common/analysis/assemble: ParsedProgram
    ../../../../src/common/analysis/check/check: check
    ../../../../src/common/analysis/check/render: render_failure
    ../../../../src/common/analysis/load/load:
        LibrarySource(LibraryDirectory),
        load_program_with_sources
    ../../../../src/common/codegen/lower/lower: LoweredProgram, lower
    ../../../../src/common/codegen/own/own as own
    ../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../src/common/codegen/verify/verify: verify
    ../../../../src/common/syntax/syntax: Diagnostic, Span


private ROOT: String = "build/task-joins/root.brp"


-- Both tasks capture `values`, and their results differ in type, so
-- swapping them changes the pair.
private SOURCE: String =
    |func main() -> Int:
    |    values = [1, 2, 3]
    |
    |    concurrent:
    |        longer = values.append(4)
    |        size = values.length()
    |
    |    longer.length() + size
    |


private func lowered_program() -> Option[LoweredProgram]:
    match load_program_with_sources(ROOT, LibraryDirectory("blorp/standard_library"), [
        { path = ROOT, contents = SOURCE }
    ]):
        Ok(loaded):
            match loaded.program.checked_and_lowered():
                Ok(program): Some(program)
                Err(_): None
        Err(_):
            None


private pure func checked_and_lowered(program: ParsedProgram) -> Result[LoweredProgram, Diagnostic]:
    checked ?= check(program).map_err(pure func(failure): render_failure(failure).first)
    concrete ?= specialized.specialize(checked)
    lower(concrete)


-- `lowered` with ownership inserted as `labelling` says.
private pure func owned(
    lowered: Option[LoweredProgram],
    labelling: own.Labelling
) -> Option[own.OwnershipProgram]:
    match lowered:
        Some(program):
            match own.insert_ownership(program, labelling):
                Ok(inserted): Some(inserted)
                Err(_): None
        None:
            None


-- The program's one join, and the span of its call.
private record FoundJoin {
    tasks: specialized.TaskJoin,
    span: Span
}


private pure func found_join(program: own.OwnershipProgram) -> Option[FoundJoin]:
    var found: Option[FoundJoin] = None

    for function in program.functions:
        for operation in function.operations:
            match operation:
                own.DefineValue(definition):
                    match definition.operation:
                        own.CallDefinition(specialized.JoinTasks(tasks), _):
                            found = Some({ tasks = tasks, span = definition.span })
                        _:
                            void
                _:
                    void

    found


-- An instance the program calls whose row `matches`, by one of its calls.
private pure func called_instance(
    program: own.OwnershipProgram,
    matches: pure (own.OwnedFunction) -> Bool
) -> Option[specialized.FunctionInstanceId]:
    var found: Option[specialized.FunctionInstanceId] = None

    for function in program.functions:
        for operation in function.operations:
            match operation:
                own.DefineValue(definition):
                    match definition.operation:
                        own.CallDefinition(specialized.UserFunction(id), _):
                            match program.functions.get(specialized.function_number(id)):
                                Some(callee):
                                    if matches(callee):
                                        found = Some(id)
                                None:
                                    void
                        _:
                            void
                _:
                    void

    found


-- The program with its one join naming `tasks` instead.
private pure func rejoined(
    program: own.OwnershipProgram,
    tasks: specialized.TaskJoin
) -> own.OwnershipProgram:
    var functions: List[own.OwnedFunction] = []

    for function in program.functions:
        var operations: List[own.OwnershipOperation] = []

        for operation in function.operations:
            next: own.OwnershipOperation = match operation:
                own.DefineValue(definition):
                    match definition.operation:
                        own.CallDefinition(specialized.JoinTasks(_), arguments):
                            own.DefineValue(
                                { definition |
                                    operation = own.CallDefinition(
                                        specialized.JoinTasks(tasks),
                                        arguments
                                    )
                                }
                            )
                        _:
                            operation
                _:
                    operation

            operations = operations.append(next)

        functions = functions.append({ function | operations = operations })

    { program | functions = functions }


-- Whether verifying `program` with its join naming `tasks` fails at the
-- join's call with `message`.
private pure func rejected(
    program: own.OwnershipProgram,
    join: FoundJoin,
    tasks: specialized.TaskJoin,
    message: String
) -> Bool:
    match verify(program.rejoined(tasks)):
        Ok(_):
            False
        Err(error):
            (error.message == "ownership verification failed: " + message).and(
                error.span == join.span
            )


private pure func borrows(function: own.OwnedFunction) -> Bool:
    function.parameters
        .any(own.parameter_owned)
        .not()


func test_a_join_naming_its_tasks_in_order_verifies() -> Bool:
    match owned(lowered_program(), own.InferredLabels):
        None: False
        Some(program): verify(program).is_ok()


-- Labels that own every other parameter still lend each task its environment.
func test_each_task_borrows_its_environment_when_every_other_parameter_owns() -> Bool:
    match owned(lowered_program(), own.AllOwnedExceptPinned):
        None:
            False
        Some(program):
            match program.found_join():
                None:
                    False
                Some(join):
                    match (
                        program.functions.get(specialized.function_number(join.tasks.left)),
                        program.functions.get(specialized.function_number(join.tasks.right))
                    ):
                        (Some(left), Some(right)):
                            (left.parameters.length() == 1)
                                .and(right.parameters.length() == 1)
                                .and(borrows(left))
                                .and(borrows(right))
                                .and(verify(program).is_ok())
                        _:
                            False


func test_a_join_naming_its_tasks_the_wrong_way_round_is_rejected() -> Bool:
    match owned(lowered_program(), own.InferredLabels):
        None:
            False
        Some(program):
            match program.found_join():
                None:
                    False
                Some(join):
                    program.rejected(
                        join,
                        { left = join.tasks.right, right = join.tasks.left },
                        "a join's result does not hold its tasks' results"
                    )


-- Every unpinned parameter owns, so `length`'s List parameter does.
func test_a_join_naming_an_instance_that_owns_a_parameter_is_rejected() -> Bool:
    match owned(lowered_program(), own.AllOwnedExceptPinned):
        None:
            False
        Some(program):
            match (
                program.found_join(),
                program.called_instance(pure func(callee) -> Bool: borrows(callee).not())
            ):
                (Some(join), Some(owning)):
                    program.rejected(
                        join,
                        { join.tasks | left = owning },
                        "pinned instance has an owned parameter"
                    )
                _:
                    False


-- `+` calls Int's add, which takes two borrowed Ints.
func test_a_join_naming_an_instance_with_two_parameters_is_rejected() -> Bool:
    match owned(lowered_program(), own.InferredLabels):
        None:
            False
        Some(program):
            match (
                program.found_join(),
                program.called_instance(pure func(callee) -> Bool: callee.parameters.length() == 2)
            ):
                (Some(join), Some(two)):
                    program.rejected(
                        join,
                        { join.tasks | left = two },
                        "a joined task takes no argument but its environment"
                    )
                _:
                    False


TESTS: TestSuite = {
    description = "Verified task joins",
    tests = [
        (
            "a join naming its tasks in order verifies",
            test_a_join_naming_its_tasks_in_order_verifies
        ),
        (
            "each task borrows its environment when every other parameter owns",
            test_each_task_borrows_its_environment_when_every_other_parameter_owns
        ),
        (
            "a join naming its tasks the wrong way round is rejected",
            test_a_join_naming_its_tasks_the_wrong_way_round_is_rejected
        ),
        (
            "a join naming an instance that owns a parameter is rejected",
            test_a_join_naming_an_instance_that_owns_a_parameter_is_rejected
        ),
        (
            "a join naming an instance with two parameters is rejected",
            test_a_join_naming_an_instance_with_two_parameters_is_rejected
        )
    ]
}
