import:
    bool: Bool methods
    int: Int methods
    list: List methods
    string: String methods
    test: TestSuite
    ../../../../src/common/codegen/lower/lower as lower
    ../../../../src/common/codegen/own/own as own
    ../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../src/common/codegen/verify/verify: verify
    ../../../support/module_input: test_base
    ../../../support/process_capture_inputs: process_seed


pure func test_inserted_process_call_verifies() -> Bool:
    match process_seed(test_base()):
        Err(_):
            False
        Ok(seed):
            match own.own(seed.lowered):
                Err(_):
                    False
                Ok(program):
                    match verify(program):
                        Ok(_): True
                        Err(_): False


pure func test_independent_verifier_rejects_string_in_list_slot() -> Bool:
    match process_seed(test_base()):
        Err(_):
            False
        Ok(seed):
            match own.own(seed.lowered):
                Err(_):
                    False
                Ok(program):
                    match program.functions.get(specialized.function_number(seed.query_id)):
                        None:
                            False
                        Some(query):
                            match query.operations.last():
                                Some(own.DefineValue(result)):
                                    match result.operation:
                                        own.CallDefinition(target, [program_arg, _, directory, environment, stdin, timeout]):
                                            wrong = { result |
                                                operation = own.CallDefinition(target, [
                                                    program_arg,
                                                    program_arg,
                                                    directory,
                                                    environment,
                                                    stdin,
                                                    timeout,
                                                ]),
                                            }
                                            changed = { query |
                                                operations = query.operations
                                                    .take(query.operations.length() - 1)
                                                    .append(own.DefineValue(wrong)),
                                            }
                                            functions = program.functions.set(
                                                specialized.function_number(seed.query_id),
                                                changed,
                                            )
                                            match verify({ program | functions = functions }):
                                                Ok(_):
                                                    False
                                                Err(error):
                                                    error.message
                                                        .equals(
                                                            "ownership verification failed: call argument type does not match its contract",
                                                        )
                                                        .and(
                                                            error.span.start.equals(
                                                                result.span.start,
                                                            ),
                                                        )
                                                        .and(error.span.end.equals(result.span.end))
                                        _:
                                            False
                                _:
                                    False


TESTS: TestSuite = {
    description = "Process builtin independent verification",
    tests = [
        ("ordinary inserted process call verifies", test_inserted_process_call_verifies),
        (
            "String cannot replace String list in raw owned IR",
            test_independent_verifier_rejects_string_in_list_slot,
        ),
    ],
}
