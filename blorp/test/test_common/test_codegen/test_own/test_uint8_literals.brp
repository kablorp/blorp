import:
    bool: Bool methods
    list: List methods
    test: TestSuite
    ../../../../src/common/codegen/own/own as own
    ../../../../src/common/syntax/source: label_text
    ../../../../src/common/syntax/syntax: IntegerFormat(UInt8Format)
    ../../../support/uint8_inputs: UINT8_LITERAL, owned_uint8


pure func test_a_uint8_literal_keeps_its_format_in_ownership() -> Bool:
    match owned_uint8(UINT8_LITERAL):
        Err(_):
            False
        Ok(program):
            var found: Bool = False
            for function in program.functions:
                if label_text(function.label) == "module_0.byte":
                    for operation in function.operations:
                        match operation:
                            own.DefineValue(definition):
                                match definition.operation:
                                    own.IntegerDefinition(UInt8Format, 200): found = True
                                    _: void
                            _:
                                void
            found


TESTS: TestSuite = {
    description = "Blorp UInt8 literal ownership",
    tests = [
        (
            "a UInt8 literal keeps its format in ownership",
            test_a_uint8_literal_keeps_its_format_in_ownership,
        ),
    ],
}
