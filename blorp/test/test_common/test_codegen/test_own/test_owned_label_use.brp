import:
    int: Int methods
    result: Result methods
    string: String methods
    test: TestSuite
    ../../../../src/common/analysis/check/check: check
    ../../../../src/common/analysis/load/load: LibrarySource(LibraryDirectory), load_program
    ../../../../src/common/codegen/lower/lower: lower
    ../../../../src/common/codegen/own/own: unconsumed_owned_labels
    ../../../../src/common/codegen/specialize/specialize: specialize


private LIBRARY_ROOT: String = "blorp/standard_library"


-- Every owned label is consumed on some path of its function's final
-- insertion: a label that is only dropped would cost each caller an
-- acquisition for no in-place update. The gate checks the compiler itself
-- and the programs written to exercise owned parameters.
private func labels_consumed(path: String) -> Bool:
    match load_program(path, LibraryDirectory(LIBRARY_ROOT)):
        Err(failure):
            print_error("${path}: ${failure.diagnostic.message}")
            False
        Ok(loaded):
            match check(loaded.program):
                Err(_):
                    print_error("${path}: does not check")
                    False
                Ok(checked):
                    match (
                        specialize(checked)
                            .and_then(lower)
                            .and_then(unconsumed_owned_labels)
                    ):
                        Err(error):
                            print_error("${path}: ${error.message}")
                            False
                        Ok(count):
                            if count == 0:
                                True
                            else:
                                print_error("${path}: ${count} owned labels are never consumed")
                                False


func test_the_compiler_consumes_every_owned_label() -> Bool:
    labels_consumed("blorp/src/main.brp")


func test_the_helper_benchmark_consumes_every_owned_label() -> Bool:
    labels_consumed("benchmarks/blorp/helper_accumulators.brp")


func test_the_loop_accumulator_consumes_every_owned_label() -> Bool:
    labels_consumed("blorp/test/test_compile/fixtures/owned_parameters/loop_accumulator.brp")


func test_the_propagation_exit_consumes_every_owned_label() -> Bool:
    labels_consumed("blorp/test/test_compile/fixtures/owned_parameters/propagation_exit.brp")


TESTS: TestSuite = {
    description = "Owned parameter labels are consumed",
    tests = [
        ("the compiler consumes every owned label", test_the_compiler_consumes_every_owned_label),
        (
            "the helper benchmark consumes every owned label",
            test_the_helper_benchmark_consumes_every_owned_label,
        ),
        (
            "the loop accumulator consumes every owned label",
            test_the_loop_accumulator_consumes_every_owned_label,
        ),
        (
            "the propagation exit consumes every owned label",
            test_the_propagation_exit_consumes_every_owned_label,
        ),
    ],
}
