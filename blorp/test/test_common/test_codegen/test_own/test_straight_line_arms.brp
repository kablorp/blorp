import:
    test: TestSuite
    ../../../../src/common/codegen/own/own as own
    ../../../../src/common/codegen/verify/verify: verify
    ../../../../src/common/syntax/source: label_text
    ../../../support/list_update_inputs: lowered, UPDATE_DECLARATIONS


-- Each straight-line arm beside the destructuring it replaces. `Stem` is
-- erased, so its arm binder is the scrutinee itself.
private PROGRAM: String =
    |union Stem:
    |    Init(List[Int])
    |pure func matched(stem: Stem) -> Int:
    |    match stem:
    |        Stem.Init(items): length(items)
    |pure func destructured(stem: Stem) -> Int:
    |    Stem.Init(items) = stem
    |    length(items)
    |pure func returned(stem: Stem) -> List[Int]:
    |    match stem:
    |        Stem.Init(items): items
    |pure func returned_destructured(stem: Stem) -> List[Int]:
    |    Stem.Init(items) = stem
    |    items
    |pure func pushed(stem: Stem, value: Int) -> Stem:
    |    items = match stem:
    |        Stem.Init(items): items
    |    Stem.Init(append(items, value))
    |func main() -> Int:
    |    stem = Stem.Init([1])
    |    sizes = [matched(stem), destructured(stem), length(returned(stem)), length(returned_destructured(stem)), matched(pushed(stem, 2))]
    |    length(sizes)
    |


-- The function `name` of the verified insertion, or None when insertion or
-- verification fails.
private pure func owned_function(name: String) -> Option[own.OwnedFunction]:
    match lowered(UPDATE_DECLARATIONS + PROGRAM).and_then(own.own):
        Err(_):
            None
        Ok(program):
            match verify(program):
                Err(_):
                    None
                Ok(_):
                    program.functions.find(
                        pure func(function): label_text(function.label) == "module_0." + name
                    )


private record OperationCounts {
    acquires: Int,
    drops: Int,
    joins: Int
}


private pure func counts(name: String) -> Option[OperationCounts]:
    owned_function(name).map(pure func(function) -> OperationCounts:
        var found: OperationCounts = { acquires = 0, drops = 0, joins = 0 }

        for operation in function.operations:
            match operation:
                own.AcquireOwner(_, _, _): found = { found | acquires = found.acquires + 1 }
                own.DropOwner(_, _): found = { found | drops = found.drops + 1 }
                own.ExecuteJoin(_): found = { found | joins = found.joins + 1 }
                _: void

        found
    )


-- Whether `matched` and `destructured` insert the same operations, `acquires`
-- of them acquisitions, and neither inserts a join.
private pure func same_as_destructuring(
    matched: String,
    destructured: String,
    acquires: Int
) -> Bool:
    match (counts(matched), counts(destructured)):
        (Some(arm), Some(binding)):
            (arm == binding)
                .and(arm.acquires == acquires)
                .and(arm.joins == 0)
        _:
            False


func test_a_borrowed_scrutinee_binder_acquires_nothing() -> Bool:
    same_as_destructuring("matched", "destructured", 0)


func test_a_returned_binder_acquires_once() -> Bool:
    same_as_destructuring("returned", "returned_destructured", 1)


-- The owned parameter moves into `append` through the binder, with no
-- acquisition that would leave the List shared.
func test_an_owned_scrutinee_moves_through_its_binder_into_an_update() -> Bool:
    match (owned_function("pushed"), counts("pushed")):
        (Some(function), Some(inserted)):
            match (function.parameters, function.operations):
                ([own.ManagedParameter(passing), _], [own.DefineValue(parameter), ..._]):
                    moved = function.operations.any(
                        pure func(operation: own.OwnershipOperation) -> Bool:
                            match operation:
                                own.DefineValue(definition):
                                    match definition.operation:
                                        own.CallDefinition(_, [own.ConsumedArgument(value, _), _]):
                                            value == parameter.id
                                        _:
                                            False
                                _:
                                    False
                    )

                    passing.owned
                        .and(moved)
                        .and(inserted.acquires == 0)
                        .and(inserted.joins == 0)
                _:
                    False
        _:
            False


TESTS: TestSuite = {
    description = "Ownership of straight-line arm binders",
    tests = [
        (
            "a borrowed scrutinee's binder acquires nothing, as destructuring does",
            test_a_borrowed_scrutinee_binder_acquires_nothing
        ),
        (
            "a returned binder acquires once, as destructuring does",
            test_a_returned_binder_acquires_once
        ),
        (
            "an owned scrutinee moves through its binder into an in-place update",
            test_an_owned_scrutinee_moves_through_its_binder_into_an_update
        )
    ]
}
