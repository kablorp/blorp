import:
    string: lines, slice, starts_with
    test: TestSuite
    ../../../support/compilation: compile_modules
    ../../../support/list_update_inputs: UPDATE_DECLARATIONS
    ../../../support/module_input: test_base
    ../../../support/text_search: find_text


-- Each `match` on the erased `Stem` beside the same function written over the
-- payload type itself, which an erased union is represented as: the arm form
-- at a function's end, and the binding form before more statements.
private PROGRAM: String =
    |union Stem:
    |    Init(List[Int])
    |pure func add(left: Int, right: Int) -> Int:
    |    builtin("int.add")
    |pure func size_of_payload(stem: List[Int]) -> Int:
    |    length(stem)
    |pure func size_matched(stem: Stem) -> Int:
    |    match stem:
    |        Stem.Init(items): length(items)
    |pure func bound_of_payload(stem: List[Int]) -> Int:
    |    count = length(stem)
    |    add(count, 1)
    |pure func bound_matched(stem: Stem) -> Int:
    |    items = match stem:
    |        Stem.Init(found): found
    |    count = length(items)
    |    add(count, 1)
    |func main() -> Int:
    |    stem = Stem.Init([1])
    |    sizes = [size_of_payload([1]), size_matched(stem), bound_of_payload([1]), bound_matched(stem)]
    |    length(sizes)
    |


-- The C of function `name` after its own symbol: its parameters and body.
private pure func body_of(output: String, name: String) -> Option[String]:
    label = "/* module_0." + name + " */ "
    var found: Option[String] = None

    for line in output.lines():
        if line.starts_with(label):
            found = match find_text(line, "(", 0):
                Some(open): line.slice(open, line.length())
                None: None

            break

    found


private pure func same_body(matched: String, over_payload: String) -> Bool:
    match compile_modules([{ source = UPDATE_DECLARATIONS + PROGRAM, targets = [] }], test_base()):
        Ok(output):
            match (output.body_of(matched), output.body_of(over_payload)):
                (Some(arm), Some(binding)): arm == binding
                _: False
        Err(_):
            False


func test_an_erased_arm_emits_its_payload_function() -> Bool:
    same_body("size_matched", "size_of_payload")


func test_an_erased_match_binding_emits_its_payload_function() -> Bool:
    same_body("bound_matched", "bound_of_payload")


TESTS: TestSuite = {
    description = "C of straight-line arms",
    tests = [
        (
            "an erased arm emits the C of the function over its payload",
            test_an_erased_arm_emits_its_payload_function
        ),
        (
            "an erased match binding emits the C of the function over its payload",
            test_an_erased_match_binding_emits_its_payload_function
        )
    ]
}
