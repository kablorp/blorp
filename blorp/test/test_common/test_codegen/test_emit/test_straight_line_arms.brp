import:
    string: lines, slice, starts_with
    test: TestSuite
    ../../../support/compilation: compile_modules
    ../../../support/list_update_inputs: UPDATE_DECLARATIONS
    ../../../support/module_input: test_base
    ../../../support/text_search: find_text


-- Each `match` on the erased `Stem` beside the destructuring it replaces: the
-- arm form at a function's end, and the binding form before more statements.
private PROGRAM: String =
    |union Stem:
    |    Init(List[Int])
    |pure func add(left: Int, right: Int) -> Int:
    |    builtin("int.add")
    |pure func size_destructured(stem: Stem) -> Int:
    |    Stem.Init(items) = stem
    |    length(items)
    |pure func size_matched(stem: Stem) -> Int:
    |    match stem:
    |        Stem.Init(items): length(items)
    |pure func bound_destructured(stem: Stem) -> Int:
    |    Stem.Init(items) = stem
    |    count = length(items)
    |    add(count, 1)
    |pure func bound_matched(stem: Stem) -> Int:
    |    items = match stem:
    |        Stem.Init(found): found
    |    count = length(items)
    |    add(count, 1)
    |func main() -> Int:
    |    stem = Stem.Init([1])
    |    sizes = [size_destructured(stem), size_matched(stem), bound_destructured(stem), bound_matched(stem)]
    |    length(sizes)
    |


-- The C of function `name` after its own symbol: its parameters and body.
private pure func body_of(output: String, name: String) -> Option[String]:
    label = "/* module_0." + name + " */ "
    var found: Option[String] = None

    for line in output.lines():
        if line.starts_with(label):
            found = match find_text(line, "(", 0):
                Some(open): line.slice(open, line.length())
                None: None

            break

    found


private pure func same_body(matched: String, destructured: String) -> Bool:
    match compile_modules([{ source = UPDATE_DECLARATIONS + PROGRAM, targets = [] }], test_base()):
        Ok(output):
            match (output.body_of(matched), output.body_of(destructured)):
                (Some(arm), Some(binding)): arm == binding
                _: False
        Err(_):
            False


func test_an_erased_arm_emits_its_destructuring() -> Bool:
    same_body("size_matched", "size_destructured")


func test_an_erased_match_binding_emits_its_destructuring() -> Bool:
    same_body("bound_matched", "bound_destructured")


TESTS: TestSuite = {
    description = "C of straight-line arms",
    tests = [
        ("an erased arm emits its destructuring's C", test_an_erased_arm_emits_its_destructuring),
        (
            "an erased match binding emits its destructuring's C",
            test_an_erased_match_binding_emits_its_destructuring
        )
    ]
}
