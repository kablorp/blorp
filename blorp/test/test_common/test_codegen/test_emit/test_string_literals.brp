import:
    test: TestSuite
    ../../../../src/common/codegen/emit/emit: emit
    ../../../../src/common/codegen/own/own as own
    ../../../../src/common/codegen/verify/verify: verify
    ../../../support/list_update_inputs: input_ids, span, raw_append_text, append_arguments
    ../../../support/text_search: has_text, occurrences


private pure func emits_with(text: String, check: pure (String) -> Bool) -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            program = raw_append_text(ids, text, append_arguments(ids), [
                own.DropOwner(own.owner_id(1), span(40))
            ])

            match verify(program).and_then(emit):
                Err(_): False
                Ok(code): check(code)


-- "child" is five ASCII bytes, so its code points are its bytes.
pure func test_literal_is_one_static_object_at_the_base_count() -> Bool:
    emits_with(
        "child",
        pure func(code: String) -> Bool: occurrences(
            code,
            "BLORP_STATIC_STRING(blorp_literal_1,5,5,{99,104,105,108,100});"
        ).equals(1)
    )


-- An accented e is two bytes and one code point, and "" is an empty String whose
-- initializer is the lone zero ISO C requires.
pure func test_literal_counts_code_points_apart_from_bytes() -> Bool:
    emits_with(
        "é",
        pure func(code: String) -> Bool: has_text(
            code,
            "BLORP_STATIC_STRING(blorp_literal_1,2,1,{195,169});"
        )
    ).and(
        emits_with(
            "",
            pure func(code: String) -> Bool: has_text(
                code,
                "BLORP_STATIC_STRING(blorp_literal_1,0,0,{0});"
            )
        )
    )


-- A read is the static object's address: nothing builds a String, so nothing
-- tests for or publishes a first use, and the finish takes no table.
pure func test_literal_read_is_the_objects_address() -> Bool:
    emits_with(
        "child",
        pure func(code: String) -> Bool: has_text(
            code,
            "=blorp_string_literal_acquire(&blorp_literal_1.value);"
        )
            .and(has_text(code, "blorp_string_literal_site").not())
            .and(has_text(code, "blorp_string_literal(").not())
            .and(has_text(code, "blorp_string_literals_finish(status)"))
    )


TESTS: TestSuite = {
    description = "Static String literal emission",
    tests = [
        (
            "a literal is one static object at the base count",
            test_literal_is_one_static_object_at_the_base_count
        ),
        (
            "a literal's code points are counted apart from its bytes",
            test_literal_counts_code_points_apart_from_bytes
        ),
        ("a literal read is the object's address", test_literal_read_is_the_objects_address)
    ]
}
