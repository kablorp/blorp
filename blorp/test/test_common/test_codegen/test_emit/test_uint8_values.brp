---
UInt8 values in C: a literal is a uint8_t value, a conversion is a cast, a List
stores uint8_t elements, and arithmetic calls the wrapping helpers only when a
program uses them.
---
import:
    bool: Bool methods
    int: Int methods
    result: Result methods
    test: TestSuite
    ../../../../src/common/codegen/generate_c: generate_c
    ../../../../src/common/codegen/runtime/fs: FS_READ_RUNTIME, FS_READ_TEXT_RUNTIME
    ../../../../src/common/codegen/runtime/list: list_c_type, list_element_key
    ../../../../src/common/codegen/runtime/string: string_to_bytes_runtime
    ../../../../src/common/codegen/specialize/specialize: TypeRef(IntegerType)
    ../../../../src/common/syntax/syntax: IntegerFormat(UInt8Format)
    ../../../support/text_search: find_text, has_text, occurrences
    ../../../support/uint8_inputs: UINT8_LITERAL, uint8_program


private pure func emitted(source: String) -> String:
    match uint8_program(source):
        Ok(parsed):
            match generate_c(parsed):
                Ok(c): c
                Err(_): ""
        Err(_):
            ""


private ARITHMETIC: String =
    |pure func to_int(value: UInt8) -> Int:
    |    builtin("uint8.to_int")
    |pure func next(byte: UInt8) -> UInt8:
    |    byte + 1
    |func main() -> Int:
    |    next(255).to_int()
    |


-- The helper's head: its wrapping is the e2e fixture's to prove, not its source text.
private ADD_HELPER: String = "uint8_t blorp_uint8_add(uint8_t first,uint8_t second){"


pure func test_a_uint8_literal_is_a_uint8_t_value() -> Bool:
    c = emitted(UINT8_LITERAL)
    c
        .has_text("=((uint8_t)200);")
        .and(
            c
                .has_text("INT64_C(200)")
                .not(),
        )


pure func test_a_conversion_to_int_is_a_c_cast() -> Bool:
    emitted(UINT8_LITERAL).has_text("=(int64_t)blorp_vl_")


pure func test_uint8_arithmetic_selects_its_wrapping_helpers_once() -> Bool:
    (emitted(ARITHMETIC).occurrences(ADD_HELPER) == 1).and(
        emitted(UINT8_LITERAL).occurrences(ADD_HELPER) == 0,
    )


pure func test_a_uint8_list_stores_uint8_t_elements() -> Bool:
    source: String =
        |pure func first(values: List[UInt8]) -> Int:
        |    0
        |func main() -> Int:
        |    values: List[UInt8] = [1, 2]
        |    first(values)
        |
    c = emitted(source)
    c
        .has_text("struct blorp_l_0_b{")
        .and(c.has_text("uint8_t values[];}"))


private READS: String =
    |func read_text(path: String) -> Result[String, Int]:
    |    builtin("fs.read_text")
    |func read_bytes(path: String) -> Result[List[UInt8], Int]:
    |    builtin("fs.read_bytes")
    |func main() -> Int:
    |    text = read_text("a")
    |    bytes = read_bytes("b")
    |    0
    |


-- Both reads call the one shared reading fragment, emitted once.
pure func test_two_reads_share_one_reading_fragment() -> Bool:
    c = emitted(READS)
    (c.occurrences(FS_READ_RUNTIME) == 1)
        .and(c.occurrences(FS_READ_TEXT_RUNTIME) == 1)
        .and(c.occurrences("uint8_t blorp_fs_read_bytes(") == 1)


-- A program that only converts text to bytes still gets the List[UInt8]
-- layout, and the native's fragment follows it.
pure func test_to_bytes_follows_the_uint8_list_layout() -> Bool:
    source: String =
        |pure func to_bytes(text: String) -> List[UInt8]:
        |    builtin("string.to_bytes")
        |func main() -> Int:
        |    bytes = "text".to_bytes()
        |    0
        |
    c = emitted(source)
    native = string_to_bytes_runtime(list_c_type(list_element_key(IntegerType(UInt8Format))))
    match (find_text(c, "struct blorp_l_0_b{", 0), find_text(c, native, 0)):
        (Some(layout), Some(fragment)): (layout < fragment).and(c.occurrences(native) == 1)
        _: False


-- The UInt8 byte read fills a uint8_t scratch through its own C function; it
-- needs no Int scratch.
pure func test_byte_at_uint8_fills_a_uint8_scratch() -> Bool:
    source: String =
        |pure func read_byte(value: String, index: Int) -> Option[UInt8]:
        |    builtin("string.byte_at_uint8")
        |func main() -> Int:
        |    unused = read_byte("é", 1)
        |    0
        |
    c = emitted(source)
    c
        .has_text("uint8_t blorp_runtime_")
        .and(c.occurrences("_some=blorp_string_byte_at_uint8(") == 1)
        .and(c.occurrences("int64_t blorp_runtime_") == 0)


TESTS: TestSuite = {
    description = "Blorp UInt8 emission",
    tests = [
        ("a UInt8 literal is a uint8_t value", test_a_uint8_literal_is_a_uint8_t_value),
        ("a conversion to Int is a C cast", test_a_conversion_to_int_is_a_c_cast),
        (
            "UInt8 arithmetic selects its wrapping helpers once",
            test_uint8_arithmetic_selects_its_wrapping_helpers_once,
        ),
        ("a UInt8 List stores uint8_t elements", test_a_uint8_list_stores_uint8_t_elements),
        ("two reads share one reading fragment", test_two_reads_share_one_reading_fragment),
        ("to_bytes follows the UInt8 List layout", test_to_bytes_follows_the_uint8_list_layout),
        ("byte_at_uint8 fills a uint8_t scratch", test_byte_at_uint8_fills_a_uint8_scratch),
    ],
}
