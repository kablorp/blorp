---
How emitted code releases a counted value. A counted record's, List's or boxed
union's drop only decrements and calls a separate release body, which drops
the children and frees the object, so the C compiler can inline the decrement
where a value is dropped and keep the release out of line.
---
import:
    bool: Bool methods
    result: Result methods
    test: TestSuite
    ../../../../src/common/analysis/check/check: check
    ../../../../src/common/analysis/check/render: render_failure
    ../../../../src/common/codegen/emit/emit: emit
    ../../../../src/common/codegen/lower/lower: lower
    ../../../../src/common/codegen/own/own: own
    ../../../../src/common/codegen/specialize/specialize: specialize
    ../../../../src/common/codegen/verify/verify: verify
    ../../../../src/common/syntax/syntax: Diagnostic
    ../../../support/module_input: parse_modules
    ../../../support/text_search: has_text


-- Specialization numbers the layouts: record 0 is `Label`, record 1 is
-- `Node`, record 2 is the closure's environment, which holds a `Label`;
-- union 0 is `Option[Node]`, stored inline, and union 1 is `Nat`, boxed.
private PROGRAM: String =
    |record Label { text: String }
    |record Node { value: Int, next: Option[Node] }
    |union Nat:
    |    Zero
    |    Succ(Nat)
    |pure func pick(item: Int, label: Label) -> Int:
    |    item
    |pure func count(nodes: List[Node], texts: List[String], callbacks: List[pure (Int) -> Int], value: Nat) -> Int:
    |    match value:
    |        Zero: 0
    |        Succ(_): 1
    |func main() -> Int:
    |    label: Label = { text = "text" }
    |    nodes: List[Node] = [{ value = 1, next = None }]
    |    texts: List[String] = [label.text]
    |    callbacks: List[pure (Int) -> Int] = [pure func(item: Int) -> Int: pick(item, label)]
    |    count(nodes, texts, callbacks, Succ(Zero))
    |


private DECREMENT: String = "if(atomic_fetch_sub_explicit(&value->references,UINT64_C(1),memory_order_acq_rel)!=UINT64_C(1))return;"


private LIST_DECREMENT: String = "if(atomic_fetch_sub_explicit(&value->references,1,memory_order_acq_rel)!=1)return;"


private pure func stage_failure(stage: String, diagnostic: Diagnostic) -> String:
    "${stage}: ${diagnostic.message}"


private pure func emitted() -> Result[String, String]:
    parsed ?= parse_modules([{ source = PROGRAM, targets = [] }]).map_err(
        pure func(error: Diagnostic) -> String: stage_failure("parse", error),
    )
    checked ?= check(parsed).map_err(
        pure func(failure) -> String: stage_failure("check", render_failure(failure).first),
    )
    specialized ?= specialize(checked).map_err(
        pure func(error: Diagnostic) -> String: stage_failure("specialize", error),
    )
    lowered ?= lower(specialized).map_err(
        pure func(error: Diagnostic) -> String: stage_failure("lower", error),
    )
    owned ?= own(lowered).map_err(
        pure func(error: Diagnostic) -> String: stage_failure("own", error),
    )
    verified ?= verify(owned).map_err(
        pure func(error: Diagnostic) -> String: stage_failure("verify", error),
    )
    emit(verified).map_err(pure func(error: Diagnostic) -> String: stage_failure("emit", error))


private func with_code(check_code: pure (String) -> Bool) -> Bool:
    match emitted():
        Ok(code):
            check_code(code)
        Err(message):
            print_error("the release program was rejected at ${message}")
            False


private pure func record_drop_calls_release(code: String) -> Bool:
    has_text(
        code,
        "void blorp_record_drop_1(blorp_r_1 value){${DECREMENT}blorp_record_release_1(value);}",
    ).and(
        has_text(
            code,
            "void blorp_record_release_1(blorp_r_1 value){blorp_union_drop_0(value->blorp_rf_1_1);blorp_memory_release(value);}",
        ),
    )


private pure func list_drop_calls_release(code: String) -> Bool:
    has_text(
        code,
        "void blorp_list_drop_0_r1(struct blorp_l_0_r1* value){if(value==&blorp_list_empty_0_r1){blorp_list_empty_release();return;}${LIST_DECREMENT}blorp_list_release_0_r1(value);}",
    ).and(
        has_text(
            code,
            "void blorp_list_release_0_r1(struct blorp_l_0_r1* value){for(int64_t index=0;index<value->length;index++){blorp_r_1 element=value->values[index];(void)element;blorp_record_drop_1(element);}blorp_memory_release(value);}",
        ),
    )


private pure func boxed_drop_calls_release(code: String) -> Bool:
    has_text(
        code,
        "void blorp_union_drop_1(struct blorp_u_1* value){${DECREMENT}blorp_union_release_1(value);}",
    ).and(has_text(code, "void blorp_union_release_1(struct blorp_u_1* value){"))


func test_record_drop_decrements_and_calls_its_release() -> Bool:
    with_code(record_drop_calls_release)


func test_list_drop_decrements_and_calls_its_release() -> Bool:
    with_code(list_drop_calls_release)


func test_boxed_union_drop_decrements_and_calls_its_release() -> Bool:
    with_code(boxed_drop_calls_release)


TESTS: TestSuite = {
    description = "Emitted release of counted values",
    tests = [
        (
            "a counted record's drop decrements and calls its release body",
            test_record_drop_decrements_and_calls_its_release,
        ),
        (
            "a List's drop decrements and calls its release body",
            test_list_drop_decrements_and_calls_its_release,
        ),
        (
            "a boxed union's drop decrements and calls its release body",
            test_boxed_union_drop_decrements_and_calls_its_release,
        ),
    ],
}
