import:
    ../../../../src/common/codegen/emit/emit: emit
    ../../../../src/common/codegen/specialize/specialize: NO_CONSTANT_VALUES
    ../../../../src/common/codegen/verify/verify: VerifiedProgram
    ../../../../src/common/syntax/syntax: Diagnostic


-- The C of a program that reads no constant, whose table is empty.
pure func emit_without_constants(program: VerifiedProgram) -> Result[String, Diagnostic]:
    emit(program, NO_CONSTANT_VALUES)
