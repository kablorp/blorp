import:
    bool: and, not
    string as string_ops
    test: TestSuite
    ../../../src/common/utils/text: byte_order_before, concat


pure func test_concatenation_preserves_both_values() -> Bool:
    match string_ops.equals(concat("left", "right"), "leftright"):
        False:
            False
        True:
            match string_ops.equals(concat("", "right"), "right"):
                False: False
                True: string_ops.equals(concat("left", ""), "left")


-- `.` (0x2E) sorts before `/` (0x2F), so `io.brp` precedes `io/status.brp`;
-- a prefix sorts first and equal strings sort before neither.
pure func test_byte_order_compares_bytes_with_a_prefix_first() -> Bool:
    and(
        and(byte_order_before("io.brp", "io/status.brp"), byte_order_before("io", "io.brp")),
        and(not(byte_order_before("io.brp", "io")), not(byte_order_before("same", "same"))),
    )


TESTS: TestSuite = {
    description = "Blorp text primitives",
    tests = [
        ("concatenation preserves both values", test_concatenation_preserves_both_values),
        (
            "byte order compares bytes with a prefix first",
            test_byte_order_compares_bytes_with_a_prefix_first,
        ),
    ],
}
