import:
    bool: and
    int: Int methods
    option: Option methods
    result: Result methods
    string: String methods
    test: TestSuite
    ../../../../src/common/analysis/check/check: CheckedProgram, check
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../src/common/syntax/syntax: Diagnostic
    ../../../support/input: setup_diagnostic
    ../../../support/module_input: parse_modules


pure func test_resource_parameter_keeps_owner_only_opaque_representation() -> Bool:
    source: String =
        |resource type Token = Int
        |func consume(token: Token) -> Int:
        |    from_opaque Token(token)
        |func main() -> Int:
        |    consume(into_opaque Token(7))
        |
    checked_source(source).is_ok()


pure func test_immutable_scoped_closure_forwards_synchronously() -> Bool:
    source: String =
        |resource type Token = Int
        |func with_token[T](body: scoped (Token) -> T) -> T:
        |    body(into_opaque Token(7))
        |func consume(token: Token) -> Int:
        |    from_opaque Token(token)
        |func invoke(body: scoped () -> Int) -> Int:
        |    body()
        |func forward(body: scoped () -> Int) -> Int:
        |    invoke(body)
        |func during(token: Token) -> Int:
        |    read_more = func() -> Int: consume(token)
        |    forward(read_more)
        |func main() -> Int:
        |    with_token(during)
        |
    checked_source(source).is_ok()


private pure func rejects_at(
    before: String,
    marked: String,
    after: String,
    message: String,
    help: String,
) -> Bool:
    source = before + marked + after
    match checked_source(source):
        Ok(_):
            False
        Err(error):
            (error.message == message)
                .and(error.help == help)
                .and(error.span.source == module_source(root_module_id()))
                .and(error.span.start == before.length())
                .and(error.span.end == before.length() + marked.length())
                .and(error.note.is_none())


pure func test_resource_result_is_rejected_at_its_annotation() -> Bool:
    declaration: String =
        |resource type Token = Int
        |
    before = declaration + "func escape(token: Token) -> "
    after: String =
        |:
        |    token
        |func main() -> Int:
        |    0
        |
    rejects_at(
        before,
        "Token",
        after,
        "resource types cannot be returned",
        "consume the resource inside its scope and return an ordinary value instead",
    )


pure func test_closure_result_cannot_hide_resource_capture() -> Bool:
    declaration: String =
        |resource type Token = Int
        |func consume(token: Token) -> Void:
        |    void
        |func escape(token: Token) -> () -> Void:
        |
    before = declaration + "    "
    after: String =
        |
        |func main() -> Int:
        |    0
        |
    rejects_at(
        before,
        "func(): consume(token)",
        after,
        "scoped callables cannot be returned",
        "invoke the callable during this call, or return a closure that captures only ordinary values",
    )


private pure func checked_source(source: String) -> Result[CheckedProgram, Diagnostic]:
    parsed ?= parse_modules([{ source = source, targets = [] }])
    check(parsed).map_err(setup_diagnostic)


private RESOURCE: String =
    |resource type Token = Int
    |func consume(token: Token) -> Int:
    |    from_opaque Token(token)
    |


private MAIN: String =
    |func main() -> Int:
    |    0
    |


private pure func rejects_loan(
    before: String,
    marked: String,
    after: String,
    message: String,
    help: String,
) -> Bool:
    rejects_at(RESOURCE + before, marked, after + MAIN, message, help)


