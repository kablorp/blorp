-- What a rejection with one note says: its message, its help and the note.
private record NotedRejection {
    message: String,
    help: String,
    note: String
}


-- The single rejection, at `marked`, with one note at `noted`, which the
-- source writes first: `before + noted + between + marked + after`.
private pure func rejects_noted(
    before: String,
    noted: String,
    between: String,
    marked: String,
    after: String,
    expected: NotedRejection
) -> Bool:
    root = module_source(root_module_id())
    start = before.length() + noted.length() + between.length()
    span: Span = { source = root, start = start, end = start + marked.length() }

    note: NoteLine = {
        span = { source = root, start = before.length(), end = before.length() + noted.length() },
        text = expected.note
    }

    match checked_source(before + noted + between + marked + after):
        Ok(_):
            False
        Err(error):
            (error.message == expected.message)
                .and(error.help == expected.help)
                .and(error.span == span)
                .and(error.note == Some(NoteLines([note])))


-- Token implements Marked, whose `head + noted + between` declares the
-- rejected method; the rejection is at Token and the note at `noted`.
private pure func rejects_contract(
    head: String,
    noted: String,
    between: String,
    help: String,
    note: String
) -> Bool:
    rejects_noted(
        RESOURCE + "trait Marked:\n" + head,
        noted,
        between + "\nimplements Marked for ",
        "Token",
        "\n" + MAIN,
        { message = "the resource type Token cannot implement Marked", help = help, note = note }
    )


private INSTEAD: String = ", or write an impure function that takes the Token instead"


private PURE_PARAMETER: String = "pure functions cannot take the resource type Token"


-- The two interim tests: each trait has a pure method that Token would be
-- Self of, the first authored and the second inherited.
pure func test_resource_cannot_be_self_of_a_pure_method() -> Bool:
    after: String =
        |
        |    pure func describe(self: Self) -> String:
        |        "token"
        |

    rejects_noted(
        RESOURCE + "trait Described:\n    pure func describe(self: ",
        "Self",
        ") -> String\nimplements Described for ",
        "Token",
        ":" + after + MAIN,
        {
            message = "the resource type Token cannot implement Described",
            help = "declare describe without pure in Described, or write an impure function that takes the Token instead",
            note = "in Described.describe: " + PURE_PARAMETER
        }
    )


pure func test_resource_cannot_inherit_a_pure_default() -> Bool:
    rejects_contract(
        "    pure func mark(self: ",
        "Self",
        ") -> Int:\n        0",
        "declare mark without pure in Marked, or write an impure function that takes the Token instead",
        "in Marked.mark: " + PURE_PARAMETER
    )


pure func test_resource_cannot_implement_a_trait_above_a_pure_method() -> Bool:
    rejects_noted(
        RESOURCE + "trait Described:\n    pure func describe(self: ",
        "Self",
        ") -> String\ntrait Marked: Described:\n    func mark(self: Self) -> Int\nimplements Marked for ",
        "Token",
        ":\n    func mark(self: Self) -> Int:\n        0\n" + MAIN,
        {
            message = "the resource type Token cannot implement Marked",
            help = "declare describe without pure in Described, or write an impure function that takes the Token instead",
            note = "in describe, inherited from Described via Marked: " + PURE_PARAMETER
        }
    )


pure func test_resource_cannot_be_returned_by_its_method() -> Bool:
    rejects_contract(
        "    func copy(self: Self) -> ",
        "Self",
        "",
        "change copy in Marked so that the Token is not its result" + INSTEAD,
        "in Marked.copy: the resource type Token cannot be returned"
    )


-- The method is impure, so the help does not suggest dropping pure from it.
pure func test_resource_cannot_be_taken_by_a_pure_callable_result() -> Bool:
    rejects_contract(
        "    func handler(self: Self) -> ",
        "pure (Self) -> Int",
        "",
        (
            "change handler in Marked so that no pure callable in its signature takes or captures the Token"
            + INSTEAD
        ),
        "in Marked.handler: " + PURE_PARAMETER
    )


pure func test_resource_cannot_be_held_by_its_method_result() -> Bool:
    rejects_contract(
        "    func all(self: Self) -> ",
        "List[Self]",
        "",
        (
            "change all in Marked so that the Token is not part of a List, tuple, record or generic type"
            + INSTEAD
        ),
        "in Marked.all: the resource type Token cannot be a type argument"
    )


-- Marked's default `mark`, which Token inherits, is written by each test
-- after these declarations.
private MARKED: String =
    |pure func measure[T](value: T) -> Int:
    |    0
    |func run(body: () -> Int) -> Int:
    |    body()
    |trait Marked:
    |    func size(self: Self) -> Int
    |


-- Token inherits `mark`, written `head + noted + tail`, which misuses Self
-- at `noted` once Self is read as Token.
private pure func rejects_default(
    head: String,
    noted: String,
    tail: String,
    misuse: String,
    fix: String
) -> Bool:
    implemented: String =
        |
        |    func size(self: Self) -> Int:
        |        consume(self)
        |

    rejects_noted(
        RESOURCE + MARKED + head,
        noted,
        tail + "\n",
        "implements Marked for Token:",
        implemented + MAIN,
        {
            message = "the resource type Token cannot use Marked's default mark",
            help = "write mark in this implementation ${fix}, or do not implement Marked for Token",
            note = "in Marked's default, with Self as Token: ${misuse}"
        }
    )


private VOID_MARK: String = "    func mark(self: Self) -> Void:\n        "


private STORED: String = "without returning or storing the Token"


private CAPTURED: String = "without a closure that captures the Token"


private PASSED: String = "and pass the Token only to functions that take a Token"


private MENTIONED: String = "generic parameters and containers cannot mention the resource type Token"


private CLOSURE: String = "func() -> Int: self.size()"


pure func test_inherited_default_cannot_bind_self() -> Bool:
    rejects_default(
        VOID_MARK + "kept = ",
        "self",
        "\n        void",
        "the resource type Token cannot be stored",
        STORED
    )


pure func test_inherited_default_cannot_put_self_in_a_list() -> Bool:
    rejects_default(VOID_MARK, "[self]", "", MENTIONED, PASSED)


pure func test_inherited_default_cannot_give_self_to_a_generic_function() -> Bool:
    rejects_default(VOID_MARK, "measure", "(self)", MENTIONED, PASSED)


pure func test_inherited_default_cannot_take_a_generic_function_value() -> Bool:
    rejects_default(
        VOID_MARK + "measured: (Self) -> Int = ",
        "measure",
        "\n        void",
        MENTIONED,
        PASSED
    )


pure func test_inherited_default_cannot_return_a_capturing_closure() -> Bool:
    rejects_default(
        "    func mark(self: Self) -> () -> Int:\n        ",
        CLOSURE,
        "",
        "scoped callables cannot be returned",
        CAPTURED
    )


pure func test_inherited_default_cannot_return_a_capturing_closure_from_a_match() -> Bool:
    rejects_default(
        "    func mark(self: Self) -> () -> Int:\n        ",
        "match self.size():\n            0: " + CLOSURE + "\n            _: func() -> Int: 0",
        "",
        "scoped callables cannot be returned",
        CAPTURED
    )


pure func test_inherited_default_cannot_store_a_capturing_closure() -> Bool:
    rejects_default(
        VOID_MARK + "later = [",
        CLOSURE,
        "]\n        void",
        "scoped callables cannot be stored here",
        CAPTURED
    )


pure func test_inherited_default_cannot_pass_a_capturing_closure_unscoped() -> Bool:
    rejects_default(
        VOID_MARK + "run(",
        CLOSURE,
        ")",
        "scoped callables require a scoped parameter",
        CAPTURED
    )


pure func test_inherited_default_cannot_capture_self_in_a_pure_closure() -> Bool:
    rejects_default(
        VOID_MARK,
        "pure func() -> Int: measure(self)",
        "",
        "pure closures cannot capture the resource type Token",
        CAPTURED
    )


pure func test_inherited_default_cannot_return_self_from_a_lambda() -> Bool:
