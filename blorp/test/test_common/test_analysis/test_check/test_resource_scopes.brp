    )


pure func test_inherited_default_pure_lambda_cannot_take_self() -> Bool:
    rejects_default(
        VOID_MARK + "pure func(",
        "value",
        ": Self) -> Int: 0",
        PURE_PARAMETER,
        "without a pure lambda that takes the Token"
    )


-- A receiver that is a whole resource is Self of a body walked with it in
-- view: an authored method, a default walked again, or a defaults-only
-- implementation. A method value takes the receiver the same way.
pure func test_resource_receives_impure_trait_methods() -> Bool:
    source: String =
        |trait Sized:
        |    func size(self: Self) -> Int
        |trait Marked: Sized:
        |    func mark(self: Self) -> Int
        |    func doubled(self: Self) -> Int:
        |        marked = self.mark()
        |        self.size()
        |trait Counted:
        |    func count(self: Self) -> Int:
        |        0
        |implements Sized for Token:
        |    func size(self: Self) -> Int:
        |        consume(self)
        |implements Marked for Token:
        |    func mark(self: Self) -> Int:
        |        self.size()
        |implements Counted for Token
        |func apply(token: Token, measure: (Token) -> Int) -> Int:
        |    measure(token)
        |func during(token: Token) -> Int:
        |    twice = token.doubled()
        |    none = token.count()
        |    apply(token, mark)
        |

    checked_source(RESOURCE + source + MAIN).is_ok()


-- The walk again views only the default's own Self: nested lambdas, a method
-- value and a generic call at another type each read every type it tests.
pure func test_inherited_default_views_only_its_own_self() -> Bool:
    source: String =
        |    func mark(self: Self) -> Int:
        |        outer = func(count: Int) -> Int:
        |            inner = func() -> Int: self.size()
        |            measured = measure(count)
        |            inner()
        |        sized: (Self) -> Int = size
        |        text = measure("text")
        |        outer(sized(self))
        |implements Marked for Token:
        |    func size(self: Self) -> Int:
        |        consume(self)
        |

    checked_source(RESOURCE + MARKED + source + MAIN).is_ok()


-- One default, inherited by two resources, is walked once for each.
pure func test_inherited_default_is_walked_for_each_resource() -> Bool:
    source: String =
        |    func mark(self: Self) -> Int:
        |        self.size()
        |implements Marked for Token:
        |    func size(self: Self) -> Int:
        |        consume(self)
        |resource union Ticket:
        |    private Init(Int)
        |implements Marked for Ticket:
        |    func size(self: Self) -> Int:
        |        Ticket.Init(value) = self
        |        value
        |

    checked_source(RESOURCE + MARKED + source + MAIN).is_ok()


-- A generic function still never takes a resource, bounded or not.
pure func test_bounded_generic_cannot_take_a_resource() -> Bool:
    opening: String =
        |trait Marked:
        |    func mark(self: Self) -> Int
        |implements Marked for Token:
        |    func mark(self: Self) -> Int:
        |        consume(self)
        |func announce[T: Marked](value: T) -> Int:
        |    value.mark()
        |func during(token: Token) -> Int:
        |

    rejects_loan(
        opening + "    ",
        "announce",
        "(token)\n",
        MENTIONED,
        "the inferred type here is Token; call functions that take a Token directly instead"
    )


-- Each trait below is called on a Token that does not implement it. Where the
-- trait declares a pure method, D35 means no implementation could exist.
private MISSING_IMPLEMENTATION_HELP: String = "declare a matching implementation; generic functions must declare their required trait bounds"


private PURE_MARKED: String =
    |trait Marked:
    |    pure func mark(self: Self) -> Int
    |func during(token: Token) -> Int:
    |    token.


pure func test_missing_implementation_of_pure_trait_for_resource() -> Bool:
    rejects_loan(
        PURE_MARKED,
        "mark",
        "()\n",
        "receiver does not implement Marked",
        "Marked.mark is pure, so a Token cannot implement Marked; call a function that takes the Token instead"
    )


pure func test_missing_implementation_of_pure_trait_for_ordinary_type() -> Bool:
    source: String =
        |trait Marked:
        |    pure func mark(self: Self) -> Int
        |record Point { x: Int }
        |func during(point: Point) -> Int:
        |    point.

    rejects_at(
        source,
        "mark",
        "()\n" + MAIN,
        "receiver does not implement Marked",
        MISSING_IMPLEMENTATION_HELP
    )


pure func test_missing_implementation_of_impure_trait_for_resource() -> Bool:
    source: String =
        |trait Marked:
        |    func mark(self: Self) -> Int
        |func during(token: Token) -> Int:
        |    token.

    rejects_loan(
        source,
        "mark",
        "()\n",
        "receiver does not implement Marked",
        MISSING_IMPLEMENTATION_HELP
    )


-- RenderContext holds no accepted traits, so a pure method that is only in a
-- supertrait is not named; implementing Marked reports `ResourceContract`
-- (test_resource_cannot_implement_a_trait_above_a_pure_method).
pure func test_missing_implementation_with_supertrait_pure_method() -> Bool:
    source: String =
        |trait Described:
        |    pure func describe(self: Self) -> String
        |trait Marked: Described:
        |    func mark(self: Self) -> Int
        |func during(token: Token) -> Int:
        |    token.

    rejects_loan(
        source,
        "mark",
        "()\n",
        "receiver does not implement Marked",
        MISSING_IMPLEMENTATION_HELP
    )


