        |func during(token: Token) -> Int:
        |    var latest = func() -> Int: 0
        |    var running: Bool = True
        |    while running:
        |

    before = opening + "        latest = "

    after: String =
        |
        |        running = False
        |    latest()
        |

    rejects_loan(
        before,
        "func() -> Int: consume(token)",
        after,
        "scoped callables cannot be stored here",
        "keep the callable in an immutable local binding and invoke or forward it synchronously"
    )


