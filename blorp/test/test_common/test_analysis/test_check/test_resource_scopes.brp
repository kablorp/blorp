pure func test_resource_used_in_while_and_for_loops() -> Bool:
    source: String =
        |func during(token: Token) -> Int:
        |    body = func() -> Int: consume(token)
        |    var latest = 0
        |    var running: Bool = True
        |    while running:
        |        latest = consume(token)
        |        latest = body()
        |        running = False
        |    for _ in [1, 2]:
        |        latest = consume(token)
        |        latest = body()
        |    latest
        |

    checked_source(RESOURCE + source + MAIN).is_ok()


pure func test_scoped_closure_cannot_leave_a_while_body() -> Bool:
