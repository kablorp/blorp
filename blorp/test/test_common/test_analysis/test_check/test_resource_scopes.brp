        "measure",
        "(self))\n        Ok(count)",
        MENTIONED,
        PASSED
    )


-- Elaboration admits written types and a pure lambda's parameters with Self
-- rigid; read as Token, each binding type, lambda result and pure lambda
-- parameter is admitted again.
pure func test_inherited_default_binding_type_is_admitted_as_written() -> Bool:
    rejects_default(
        VOID_MARK,
        "kept",
        ": pure (Self) -> Int = pure func(value: Self) -> Int: 0\n        void",
        PURE_PARAMETER,
        "without a pure lambda that takes the Token"
    )


pure func test_inherited_default_lambda_binding_type_is_admitted_as_written() -> Bool:
    rejects_default(
        VOID_MARK + "func() -> Int:\n            ",
        "kept",
        ": List[Self] = []\n            0",
        "the resource type Token cannot be a type argument",
        PASSED
    )


pure func test_inherited_default_lambda_result_is_admitted_as_written() -> Bool:
    rejects_default(
