private pure func checked_with_owner(
    source: String,
    owner: String,
) -> Result[CheckedProgram, Diagnostic]:
    parsed ?= parse_modules([{ source = source, targets = [1] }, { source = owner, targets = [] }])
    check(parsed).map_err(setup_diagnostic)


private pure func rejects_with_owner(
    before: String,
    marked: String,
    after: String,
    owner: String,
    message: String,
    help: String,
) -> Bool:
    match checked_with_owner(before + marked + after, owner):
        Ok(_):
            False
        Err(error):
            (error.message == message)
                .and(error.help == help)
                .and(error.span.source == module_source(root_module_id()))
                .and(error.span.start == before.length())
                .and(error.span.end == before.length() + marked.length())
                .and(error.note.is_none())


private OWNER: String =
    |resource type Token = Int
    |func consume(token: Token) -> Int:
    |    from_opaque Token(token)
    |func invoke(body: scoped () -> Int) -> Int:
    |    body()
    |


pure func test_resource_projection_stays_in_owner_module() -> Bool:
    prefix: String =
        |import:
        |    ./owner: Token
        |func during(token: Token) -> Int:
        |
    before = prefix + "    from_opaque "
    after: String =
        |(token)
        |func main() -> Int:
        |    0
        |
    rejects_with_owner(
        before,
        "Token",
        after,
        OWNER,
        "opaque values can be projected only in their declaring module",
        "call a public accessor from the declaring module",
    )


pure func test_resource_construction_stays_in_owner_module() -> Bool:
    prefix: String =
        |import:
        |    ./owner as owner: Token
        |func main() -> Int:
        |
    before = prefix + "    owner.consume(into_opaque "
    after: String =
        |(7))
        |
    rejects_with_owner(
        before,
        "Token",
        after,
        OWNER,
        "opaque values can be constructed only in their declaring module",
        "call a public constructor from the declaring module",
    )


pure func test_scoped_qualified_direct_call() -> Bool:
    source: String =
        |import:
        |    ./owner as owner: Token
        |func during(token: Token) -> Int:
        |    owner.invoke(func() -> Int: owner.consume(token))
        |func main() -> Int:
        |    0
        |
    checked_with_owner(source, OWNER).is_ok()


pure func test_scoped_qualified_ordinary_argument() -> Bool:
    owner: String =
        |resource type Token = Int
        |func consume(token: Token) -> Int:
        |    from_opaque Token(token)
        |func invoke(body: () -> Int) -> Int:
        |    body()
        |
    prefix: String =
        |import:
        |    ./owner as owner: Token
        |func during(token: Token) -> Int:
        |
    before = prefix + "    owner.invoke("
    after: String =
        |)
        |func main() -> Int:
        |    0
        |
    rejects_with_owner(
        before,
        "func() -> Int: owner.consume(token)",
        after,
        owner,
        "scoped callables require a scoped parameter",
        "declare the receiving callback parameter scoped and call the function directly",
    )


pure func test_trait_default_resource_parameter_rejected_before_body() -> Bool:
    prefix: String =
        |trait Uses:
        |
    before = prefix + "    pure func use(self: Self, token: "
    after: String =
        |) -> Int:
        |        0
        |
    rejects_loan(
        before,
        "Token",
        after,
        "pure functions cannot take resource parameters",
        "remove pure and consume the resource synchronously",
    )


pure func test_trait_default_resource_result_rejected_before_body() -> Bool:
    prefix: String =
        |trait Uses:
        |
    before = prefix + "    pure func use(self: Self) -> "
    after: String =
        |:
        |        0
        |
    rejects_loan(
        before,
        "Token",
        after,
        "resource types cannot be returned",
        "consume the resource inside its scope and return an ordinary value instead",
    )


pure func test_match_join_preserves_later_scoped_arm() -> Bool:
    prefix: String =
        |func ordinary(body: () -> Int) -> Int:
        |    body()
        |func during(token: Token) -> Int:
        |    body = match 0:
        |        0: func() -> Int: 0
        |        _: func() -> Int: consume(token)
        |
    before = prefix + "    ordinary("
    after: String =
        |)
        |
    rejects_loan(
        before,
        "body",
        after,
        "scoped callables require a scoped parameter",
        "declare the receiving callback parameter scoped and call the function directly",
    )


pure func test_inferred_list_cannot_store_resource_taking_callable() -> Bool:
    prefix: String =
        |func during() -> Int:
        |
    before = prefix + "    bodies = "
    after: String =
        |
        |    0
        |
    rejects_loan(
        before,
        "[consume]",
        after,
        "resource types cannot be type arguments",
        "use a whole resource parameter on an impure function instead",
    )


TESTS: TestSuite = {
    description = "Synchronous resource loans",
    tests = [
        (
            "inferred containers reject resource-taking callables",
            test_inferred_list_cannot_store_resource_taking_callable,
        ),
        ("match joins preserve later scoped arms", test_match_join_preserves_later_scoped_arm),
        ("resource projection remains owner only", test_resource_projection_stays_in_owner_module),
        (
            "resource construction remains owner only",
            test_resource_construction_stays_in_owner_module,
        ),
        ("qualified direct call preserves scoped promise", test_scoped_qualified_direct_call),
        ("qualified ordinary call rejects scoped actual", test_scoped_qualified_ordinary_argument),
        (
            "trait default rejects resource parameter before body",
            test_trait_default_resource_parameter_rejected_before_body,
        ),
        (
            "trait default rejects resource result before body",
            test_trait_default_resource_result_rejected_before_body,
        ),
        (
            "a resource result is rejected at its annotation",
            test_resource_result_is_rejected_at_its_annotation,
        ),
        (
            "a closure result cannot hide a resource capture",
            test_closure_result_cannot_hide_resource_capture,
        ),
        (
            "a resource uses owner-only opaque conversion",
            test_resource_parameter_keeps_owner_only_opaque_representation,
        ),
        (
            "an immutable scoped closure forwards synchronously",
            test_immutable_scoped_closure_forwards_synchronously,
        ),
        ("resource local alias", test_resource_local_alias),
        ("resource record field", test_resource_record_field),
        ("resource union payload", test_resource_union_payload),
        ("resource opaque representation", test_resource_opaque_representation),
        ("resource list type", test_resource_list_type),
        ("resource tuple type", test_resource_tuple_type),
        ("resource callable in aggregate", test_resource_callable_in_aggregate),
        ("resource callable type argument", test_resource_callable_type_argument),
        ("resource pure parameter", test_resource_pure_parameter),
        ("scoped non callable", test_scoped_non_callable),
        ("scoped parameter result", test_scoped_parameter_result),
        ("scoped closure mutable binding", test_scoped_closure_mutable_binding),
        ("scoped closure reassignment", test_scoped_closure_reassignment),
        ("scoped closure list", test_scoped_closure_list),
        ("scoped closure tuple", test_scoped_closure_tuple),
        ("scoped closure record", test_scoped_closure_record),
        ("scoped closure opaque", test_scoped_closure_opaque),
        ("scoped closure union", test_scoped_closure_union),
        ("scoped ordinary direct argument", test_scoped_ordinary_direct_argument),
        ("scoped indirect erasure", test_scoped_indirect_erasure),
        ("scoped ufcs ordinary argument", test_scoped_ufcs_ordinary_argument),
        ("scoped transitive capture", test_scoped_transitive_capture),
        (
            "callable match rejects binding a scoped value",
            test_callable_match_cannot_bind_scoped_value,
        ),
        ("scoped if join", test_scoped_if_join),
        ("resource inferred generic identity", test_resource_inferred_generic_identity),
        ("resource pure capture", test_resource_pure_capture),
        ("resource constant", test_resource_constant),
        ("resource generic declaration", test_resource_generic_declaration),
        ("pure written resource lambda", test_pure_written_resource_lambda),
        ("pure inferred resource lambda", test_pure_inferred_resource_lambda),
        ("trait resource parameter", test_trait_resource_parameter),
        ("trait resource result", test_trait_resource_result),
        ("trait scoped parameter", test_trait_scoped_parameter),
        ("scoped some payload", test_scoped_some_payload),
        ("scoped ok payload", test_scoped_ok_payload),
        ("scoped propagation payload", test_scoped_propagation_payload),
        ("resource generic callable actual", test_resource_generic_callable_actual),
        ("scoped parameter forward alias", test_scoped_parameter_forward_alias),
        ("scoped void tail discard", test_scoped_void_tail_discard),
        ("scoped discard then invoke", test_scoped_discard_then_invoke),
        ("scoped calls in match branches", test_scoped_calls_in_match_branches),
        ("scoped nested capture forward", test_scoped_nested_capture_forward),
        ("scoped ufcs direct", test_scoped_ufcs_direct),
        ("sequential resource alias arguments", test_sequential_resource_alias_arguments),
        ("pure scoped callback capture", test_pure_scoped_callback_capture),
        ("scoped if alias invoke", test_scoped_if_alias_invoke),
    ],
}
