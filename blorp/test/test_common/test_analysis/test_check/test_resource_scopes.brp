private FIXTURES: String = "blorp/test/test_common/test_analysis/test_check/fixtures/resource_scopes/"


func test_temporary_directory_body_may_capture_a_reader() -> Bool:
    fixture = FIXTURES + "temporary_directory_reader.brp"

    match load_program(fixture, LibraryDirectory("blorp/standard_library")):
        Err(_): False
        Ok(loaded): check(loaded.program).is_ok()


-- The library's Writer implements an impure trait, inheriting a default.
func test_writer_implements_an_impure_trait() -> Bool:
    match load_program(FIXTURES + "writer_sink.brp", LibraryDirectory("blorp/standard_library")):
        Err(_): False
        Ok(loaded): check(loaded.program).is_ok()


-- The text `span` covers in its module, with `before` bytes ahead of it.
private pure func spanned(sources: SourceInputs, span: Span, before: Int) -> Option[String]:
    match span.source.source_module():
        Some(module):
            match sources.modules.get(module.module_number()):
                Some(file): file.contents.slice(span.start - before, span.end)
                None: None
        None:
            None


-- A library trait cannot drop pure, so the help offers only an impure
-- function; the note is at Self in the library's Stringable.
func test_resource_cannot_implement_a_library_trait() -> Bool:
    before = "resource union Token:\n    private Init(Int)\n\n\nimplements Stringable for "
    signature = "pure func to_string(value: "

    match load_program(
        FIXTURES + "stringable_token.brp",
        LibraryDirectory("blorp/standard_library")
    ):
        Err(_):
            False
        Ok(loaded):
            match check(loaded.program):
                Ok(_):
                    False
                Err(failure):
                    error = setup_diagnostic(failure)

                    match error.note:
                        Some(NoteLines([note])):
                            (error.message == "the resource type Token cannot implement Stringable")
                                .and(
                                    (
                                        error.help
                                        == "write an impure function that takes the Token instead"
                                    )
                                )
                                .and(error.span.source == module_source(root_module_id()))
                                .and(error.span.start == before.length())
                                .and(error.span.end == before.length() + "Token".length())
                                .and(note.text == "in Stringable.to_string: " + PURE_PARAMETER)
                                .and(
                                    (
                                        loaded.sources.spanned(note.span, signature.length())
                                        == Some(signature + "Self")
                                    )
                                )
                        _:
                            False


-- Interpolation needs the library's Stringable, so this loads a fixture.
func test_interpolating_a_resource_names_pure_to_string() -> Bool:
    before = (
        "resource union Token:\n    private Init(Int)\n\n\nfunc show(token: Token) -> String:\n    \""
        + "$"
        + "{"
    )

    match load_program(
        FIXTURES + "interpolated_token.brp",
        LibraryDirectory("blorp/standard_library")
    ):
        Err(_):
            False
        Ok(loaded):
            match check(loaded.program):
                Ok(_):
                    False
                Err(failure):
                    error = setup_diagnostic(failure)

                    (error.message == "interpolation hole has type Token, which does not implement Stringable")
                        .and(
                            (
                                error.help
                                == "Stringable.to_string is pure, so a Token cannot implement Stringable; interpolate a value read from the Token instead"
                            )
                        )
                        .and(error.span.source == module_source(root_module_id()))
                        .and(error.span.start == before.length())
                        .and(error.span.end == before.length() + "token".length())
                        .and(error.note.is_none())


-- A default declared in another module is walked again for Token.
pure func test_inherited_default_from_another_module() -> Bool:
    owner: String =
        |trait Marked:
        |    func size(self: Self) -> Int
        |    func mark(self: Self) -> Int:
        |        self.size()
        |

    source: String =
        |import:
        |    ./owner: Marked
        |implements Marked for Token:
        |    func size(self: Self) -> Int:
        |        consume(self)
        |

    checked_with_owner(source + RESOURCE + MAIN, owner).is_ok()


