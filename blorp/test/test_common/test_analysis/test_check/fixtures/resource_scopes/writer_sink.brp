import:
    bytes: Bytes
    io/files/write: Writer, WriteError, write_all


-- A Writer is Self of an impure trait: it implements one method and
-- inherits a default that calls it.
trait Sink:
    func send(self: Self, data: Bytes) -> Result[Void, WriteError]
    func send_twice(self: Self, data: Bytes) -> Result[Void, WriteError]:
        _ ?= self.send(data)
        self.send(data)


implements Sink for Writer:
    func send(self: Self, data: Bytes) -> Result[Void, WriteError]:
        self.write_all(data)


func main() -> Int:
    0
