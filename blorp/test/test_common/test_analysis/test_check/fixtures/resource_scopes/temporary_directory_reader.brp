import:
    io/files/read: Reader, ReadError, read_chunk
    io/files/temporary_directory: TemporaryDirectoryError, with_temporary_directory
    path: Path


union ScratchError:
    ReadFailed(ReadError)
    ScratchFailed(TemporaryDirectoryError)


func chunk_count(reader: Reader) -> Result[Int, ScratchError]:
    match read_chunk(reader):
        Ok(_): Ok(1)
        Err(error): Err(ReadFailed(error))


-- The body captures the lent Reader, so only a scoped parameter accepts it.
func count_in_scratch(reader: Reader, parent: Path) -> Result[Int, ScratchError]:
    with_temporary_directory(
        parent,
        "scratch-",
        func(_: Path) -> Result[Int, ScratchError]: chunk_count(reader),
        pure func(error: TemporaryDirectoryError) -> ScratchError: ScratchFailed(error)
    )


func main() -> Int:
    0
