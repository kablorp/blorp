resource union Reader:
    private Init(Int)


func open_reader(handle: Int, body: scoped (Reader) -> Int) -> Int:
    body(Reader.Init(handle))


-- The handle is plain data, so the closure that captures it may be returned.
func adder(reader: Reader) -> (Int) -> Int:
    match reader:
        Reader.Init(handle): func(amount: Int) -> Int: handle + amount


func add_two(reader: Reader) -> Int:
    add = adder(reader)
    add(2)


func main() -> Int:
    open_reader(40, func(reader: Reader) -> Int: add_two(reader))
