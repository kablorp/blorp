record Box {
    content: Int
}


pure func is_some(box: Box) -> Bool:
    box.content > 0


pure func map(box: Box, callback: pure (Int) -> Int) -> Box:
    { content = callback(box.content) }


func main() -> Int:
    box: Box = { content = 2 }
    match (
        box
            .map(pure func(value: Int): value + 1)
            .is_some()
    ):
        True: 3
        False: 0
