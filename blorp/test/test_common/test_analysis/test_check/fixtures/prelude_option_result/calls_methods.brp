pure func parse_argument(argument: Option[String]) -> Result[Int, String]:
    argument
        .to_result("missing input")
        .and_then(
            pure func(text: String): text
                .parse_int()
                .to_result("invalid integer")
        )


func main(args: List[String]) -> Int:
    argument = args.get(1)
    length = argument
        .map(pure func(text: String): text.length())
        .get_or(0)
    parsed = parse_argument(argument)
        .map(pure func(value: Int): value + length)
        .map_err(pure func(message: String): message.length())
    match parsed:
        Ok(value):
            value
        Err(code):
            match parsed.is_ok() == argument.is_some():
                True: 0
                False: code
