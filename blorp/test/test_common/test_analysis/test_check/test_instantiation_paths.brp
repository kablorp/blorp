import:
    bool: and
    int as int_ops
    option: is_none
    test: TestSuite
    ../../../../src/common/analysis/check/instantiation_paths:
        InstantiationPath,
        PathOperation(KeepPath, PushPath, PopPath),
        PathBoundedness(BoundedPaths, UnboundedPaths),
        bound_instantiation_paths,
        strong_components,


-- These are analysis-local controls/symbols, not fabricated semantic IDs.
private pure func bounded(count: Int, paths: List[InstantiationPath]) -> Bool:
    match bound_instantiation_paths(count, paths):
        Some(BoundedPaths): True
        Some(UnboundedPaths(_)): False
        None: False


private pure func marks_all(count: Int, paths: List[InstantiationPath]) -> Bool:
    match bound_instantiation_paths(count, paths):
        Some(BoundedPaths):
            False
        Some(UnboundedPaths(marked)):
            var complete: Bool = int_ops.equals(marked.length(), paths.length())
            for position in 0..paths.length():
                complete = and(
                    complete,
                    marked.any(pure func(found): int_ops.equals(found, position)),
                )
            complete
        None:
            False


pure func test_empty_and_epsilon_paths_are_bounded() -> Bool:
    and(
        bounded(0, []),
        bounded(2, [
            { source = 0, target = 1, operation = KeepPath },
            { source = 1, target = 0, operation = KeepPath },
        ]),
    )


pure func test_an_unmatched_push_cycle_is_unbounded() -> Bool:
    marks_all(1, [{ source = 0, target = 0, operation = PushPath(0) }])


pure func test_a_pop_cycle_only_consumes_finite_input() -> Bool:
    bounded(1, [{ source = 0, target = 0, operation = PopPath(0) }])


pure func test_matching_push_pop_cycle_is_bounded() -> Bool:
    bounded(2, [
        { source = 0, target = 1, operation = PushPath(0) },
        { source = 1, target = 0, operation = PopPath(0) },
    ])


pure func test_a_default_peek_is_not_unconditional_epsilon() -> Bool:
    bounded(2, [
        { source = 0, target = 1, operation = PopPath(0) },
        { source = 1, target = 0, operation = PushPath(0) },
    ])


pure func test_different_constructor_slots_cannot_cancel() -> Bool:
    bounded(3, [
        { source = 0, target = 1, operation = PushPath(0) },
        { source = 1, target = 2, operation = PopPath(1) },
        { source = 2, target = 0, operation = PushPath(2) },
    ])


pure func test_guarded_wrapping_retains_the_unmatched_push() -> Bool:
    marks_all(3, [
        { source = 0, target = 1, operation = PopPath(1) },
        { source = 1, target = 2, operation = PushPath(0) },
        { source = 2, target = 0, operation = PushPath(1) },
    ])


pure func test_three_list_field_dispatch_does_not_select_box_head() -> Bool:
    bounded(3, [
        { source = 0, target = 1, operation = PushPath(0) },
        { source = 1, target = 2, operation = PushPath(0) },
        { source = 2, target = 0, operation = PopPath(1) },
        { source = 2, target = 2, operation = PopPath(0) },
    ])


pure func test_phantom_default_and_list_dispatch_have_finite_paths() -> Bool:
    bounded(5, [
        { source = 0, target = 1, operation = KeepPath },
        { source = 1, target = 2, operation = KeepPath },
        { source = 2, target = 3, operation = PushPath(0) },
        { source = 3, target = 2, operation = PopPath(0) },
        { source = 3, target = 4, operation = PopPath(1) },
        { source = 4, target = 0, operation = PushPath(1) },
    ])


pure func test_all_overlapping_pumps_are_marked_in_both_orders() -> Bool:
    forward: List[InstantiationPath] = [
        { source = 0, target = 1, operation = PushPath(0) },
        { source = 1, target = 0, operation = KeepPath },
        { source = 1, target = 2, operation = PushPath(0) },
        { source = 2, target = 1, operation = KeepPath },
    ]
    var reverse: List[InstantiationPath] = []
    for path in forward:
        reverse = [path].concat(reverse)
    and(marks_all(3, forward), marks_all(3, reverse))


pure func test_every_alternative_balanced_derivation_is_marked() -> Bool:
    paths: List[InstantiationPath] = [
        { source = 0, target = 1, operation = PushPath(0) },
        { source = 1, target = 0, operation = KeepPath },
        { source = 1, target = 3, operation = PushPath(1) },
        { source = 3, target = 4, operation = KeepPath },
        { source = 4, target = 0, operation = PopPath(1) },
    ]
    var reverse: List[InstantiationPath] = []
    for path in paths:
        reverse = [path].concat(reverse)
    and(marks_all(5, paths), marks_all(5, reverse))


pure func test_compact_composition_has_no_expanded_numeric_weights() -> Bool:
    var paths: List[InstantiationPath] = []
    for level in 1..66:
        paths = paths.append({
            source = level,
            target = level - 1,
            operation = PushPath(level - 1),
        })
    for head in 0..66:
        paths = paths.append({ source = 0, target = head, operation = PopPath(head) })
    bounded(66, paths)


pure func test_a_pair_found_only_through_closure_exposes_the_pump() -> Bool:
    marks_all(3, [
        { source = 0, target = 1, operation = KeepPath },
        { source = 1, target = 2, operation = KeepPath },
        { source = 2, target = 0, operation = PushPath(0) },
    ])


-- Marks come back in the order the analysis discovers them, and the recursion
-- check collects unavailable origins in that order, so the order is a result.
pure func test_marks_follow_discovery_order_of_each_pump() -> Bool:
    paths: List[InstantiationPath] = [
        { source = 0, target = 1, operation = PushPath(0) },
        { source = 1, target = 0, operation = KeepPath },
        { source = 1, target = 3, operation = PushPath(1) },
        { source = 3, target = 4, operation = KeepPath },
        { source = 4, target = 0, operation = PopPath(1) },
    ]
    match bound_instantiation_paths(5, paths):
        Some(UnboundedPaths(marked)): marked == [0, 1, 2, 4, 3]
        _: False


pure func test_unrelated_nonpump_transitions_are_not_marked() -> Bool:
    paths: List[InstantiationPath] = [
        { source = 0, target = 0, operation = PushPath(0) },
        { source = 1, target = 2, operation = KeepPath },
    ]
    match bound_instantiation_paths(3, paths):
        Some(UnboundedPaths([position])): int_ops.equals(position, 0)
        _: False


-- Transitions on no cycle never enter the closure, yet marks still name the
-- original positions, in the whole graph's order.
pure func test_marks_keep_positions_around_acyclic_transitions() -> Bool:
    paths: List[InstantiationPath] = [
        { source = 3, target = 0, operation = PushPath(1) },
        { source = 0, target = 1, operation = PushPath(0) },
        { source = 2, target = 3, operation = KeepPath },
        { source = 1, target = 0, operation = KeepPath },
        { source = 1, target = 4, operation = PopPath(0) },
    ]
    match bound_instantiation_paths(5, paths):
        Some(UnboundedPaths(marked)): marked == [1, 3]
        _: False


-- Two pumps in separate components joined by an edge on no cycle: both are
-- marked in transition order and the joining edge is not.
pure func test_pumps_in_separate_components_keep_transition_order() -> Bool:
    paths: List[InstantiationPath] = [
        { source = 1, target = 1, operation = PushPath(0) },
        { source = 0, target = 1, operation = KeepPath },
        { source = 0, target = 0, operation = PushPath(0) },
    ]
    match bound_instantiation_paths(2, paths):
        Some(UnboundedPaths(marked)): marked == [0, 2]
        _: False


-- Controls on one cycle share a component; a chain into it and a self loop
-- elsewhere do not join it.
pure func test_components_group_cycles_and_separate_chains() -> Bool:
    components = strong_components(5, [
        { source = 0, target = 1, operation = KeepPath },
        { source = 1, target = 2, operation = PushPath(0) },
        { source = 2, target = 1, operation = KeepPath },
        { source = 3, target = 3, operation = PopPath(0) },
    ])
    match components:
        [entry, cycle_start, cycle_end, looped, alone]:
            [
                cycle_start == cycle_end,
                entry != cycle_start,
                looped != cycle_start,
                alone != cycle_start,
                alone != looped,
                entry != alone,
            ].all(pure func(holds): holds)
        _:
            False


pure func test_a_three_control_cycle_is_one_component() -> Bool:
    components = strong_components(4, [
        { source = 0, target = 1, operation = KeepPath },
        { source = 1, target = 2, operation = PushPath(0) },
        { source = 2, target = 0, operation = PopPath(0) },
        { source = 2, target = 3, operation = KeepPath },
    ])
    match components:
        [cycle_a, cycle_b, cycle_c, outside]:
            [cycle_a == cycle_b, cycle_b == cycle_c, outside != cycle_a].all(
                pure func(holds): holds,
            )
        _:
            False


-- From 0 the search finishes {1, 2} first and then reaches 1 again from 3.
-- That edge crosses into a finished component, so it must not pull 3 into
-- 0's component.
pure func test_a_cross_edge_into_a_finished_component_joins_nothing() -> Bool:
    components = strong_components(4, [
        { source = 0, target = 1, operation = KeepPath },
        { source = 1, target = 2, operation = KeepPath },
        { source = 2, target = 1, operation = KeepPath },
        { source = 0, target = 3, operation = KeepPath },
        { source = 3, target = 1, operation = KeepPath },
    ])
    match components:
        [root, cycle_a, cycle_b, crossing]:
            [cycle_a == cycle_b, root != cycle_a, crossing != cycle_a, crossing != root].all(
                pure func(holds): holds,
            )
        _:
            False


-- Only 3's back edge reaches 1, so 2 learns its low link from 3, and 1
-- closes all three; 0 above and 4 below stay alone.
pure func test_a_nested_back_edge_propagates_its_low_link() -> Bool:
    components = strong_components(5, [
        { source = 0, target = 1, operation = KeepPath },
        { source = 1, target = 2, operation = KeepPath },
        { source = 2, target = 3, operation = KeepPath },
        { source = 3, target = 1, operation = KeepPath },
        { source = 3, target = 4, operation = KeepPath },
    ])
    match components:
        [above, cycle_a, cycle_b, cycle_c, below]:
            [
                cycle_a == cycle_b,
                cycle_b == cycle_c,
                above != cycle_a,
                below != cycle_a,
                above != below,
            ].all(pure func(holds): holds)
        _:
            False


-- Longer than the 50,000 frames at which a recursive search overflows the
-- host stack (see load.brp's load_queue), so this cycle proves the search is
-- iterative.
private LONG_CYCLE: Int = 100000


pure func test_a_long_cycle_is_one_component_without_recursion() -> Bool:
    var paths: List[InstantiationPath] = []
    for control in 0..LONG_CYCLE:
        paths = paths.append({
            source = control,
            target = (control + 1) % LONG_CYCLE,
            operation = KeepPath,
        })
    components = strong_components(LONG_CYCLE, paths)
    root = components.get_or(0, -1)
    and(
        int_ops.equals(components.length(), LONG_CYCLE),
        components.all(pure func(component): component == root),
    )


pure func test_matching_cancellation_exposes_a_growing_cycle() -> Bool:
    marks_all(3, [
        { source = 0, target = 1, operation = PushPath(0) },
        { source = 1, target = 2, operation = PopPath(0) },
        { source = 2, target = 0, operation = PushPath(2) },
    ])


pure func test_malformed_local_domains_do_not_produce_a_bound() -> Bool:
    validations: List[Bool] = [
        bound_instantiation_paths(-1, []).is_none(),
        bound_instantiation_paths(int_ops.INT_MAX, []).is_none(),
        bound_instantiation_paths(1, [{ source = 1, target = 0, operation = KeepPath }]).is_none(),
        bound_instantiation_paths(1, [{ source = 0, target = -1, operation = KeepPath }]).is_none(),
        bound_instantiation_paths(1, [{ source = 0, target = 0, operation = PushPath(-1) }]).is_none(),
    ]
    validations.all(pure func(valid): valid)


TESTS: TestSuite = {
    description = "Constructor-path instantiation boundedness",
    tests = [
        ("empty and epsilon paths are bounded", test_empty_and_epsilon_paths_are_bounded),
        ("an unmatched push cycle grows", test_an_unmatched_push_cycle_is_unbounded),
        ("a pop cycle consumes finite input", test_a_pop_cycle_only_consumes_finite_input),
        ("matching push and pop stay bounded", test_matching_push_pop_cycle_is_bounded),
        ("a default peek retains its guard", test_a_default_peek_is_not_unconditional_epsilon),
        (
            "distinct constructor slots cannot cancel",
            test_different_constructor_slots_cannot_cancel,
        ),
        (
            "matching cancellation exposes a growing cycle",
            test_matching_cancellation_exposes_a_growing_cycle,
        ),
        (
            "malformed local domains are rejected",
            test_malformed_local_domains_do_not_produce_a_bound,
        ),
        ("guarded wrapping still grows", test_guarded_wrapping_retains_the_unmatched_push),
        (
            "a three-List field cannot select Box prematurely",
            test_three_list_field_dispatch_does_not_select_box_head,
        ),
        (
            "Phantom default dispatch has finite paths",
            test_phantom_default_and_list_dispatch_have_finite_paths,
        ),
        (
            "all overlapping pumps are order independent",
            test_all_overlapping_pumps_are_marked_in_both_orders,
        ),
        (
            "all balanced derivations contribute provenance",
            test_every_alternative_balanced_derivation_is_marked,
        ),
        (
            "compact 65-level composition remains bounded",
            test_compact_composition_has_no_expanded_numeric_weights,
        ),
        ("unrelated transitions are not marked", test_unrelated_nonpump_transitions_are_not_marked),
        (
            "a pair found only through closure exposes the pump",
            test_a_pair_found_only_through_closure_exposes_the_pump,
        ),
        ("marks follow discovery order", test_marks_follow_discovery_order_of_each_pump),
        (
            "marks keep positions around acyclic transitions",
            test_marks_keep_positions_around_acyclic_transitions,
        ),
        (
            "pumps in separate components keep transition order",
            test_pumps_in_separate_components_keep_transition_order,
        ),
        (
            "components group cycles and separate chains",
            test_components_group_cycles_and_separate_chains,
        ),
        ("a three-control cycle is one component", test_a_three_control_cycle_is_one_component),
        (
            "a cross edge into a finished component joins nothing",
            test_a_cross_edge_into_a_finished_component_joins_nothing,
        ),
        (
            "a nested back edge propagates its low link",
            test_a_nested_back_edge_propagates_its_low_link,
        ),
        (
            "a long cycle is one component without recursion",
            test_a_long_cycle_is_one_component_without_recursion,
        ),
    ],
}
