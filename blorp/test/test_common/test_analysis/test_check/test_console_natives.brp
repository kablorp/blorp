import:
    bool: Bool methods
    list: List methods
    option: Option methods
    string: String methods
    test: TestSuite
    ../../../../src/common/analysis/check/check: check
    ../../../../src/common/analysis/check/render: render_failure
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../support/module_input: parse_modules_with_base, test_base


private record ConsoleDeclaration {
    label: String,
    header: String,
    help: String,
}


-- Unlike the raw fs handles, these take no handle, so any module may declare them.
private CONSOLE_NATIVES: List[ConsoleDeclaration] = [
    {
        label = "console.write",
        header = "func native(data: List[UInt8]) -> Result[Void, Int]:",
        help = "declare an impure nongeneric function with one List[UInt8] parameter returning Result[Void, Int]",
    },
    {
        label = "console.write_error",
        header = "func native(data: List[UInt8]) -> Result[Void, Int]:",
        help = "declare an impure nongeneric function with one List[UInt8] parameter returning Result[Void, Int]",
    },
    {
        label = "console.flush",
        header = "func native() -> Result[Void, Int]:",
        help = "declare an impure nongeneric function with no parameters returning Result[Void, Int]",
    },
    {
        label = "console.read_line",
        header = "func native() -> Result[List[UInt8], Int]:",
        help = "declare an impure nongeneric function with no parameters returning Result[List[UInt8], Int]",
    },
    {
        label = "console.read_exact",
        header = "func native(byte_count: Int) -> Result[List[UInt8], Int]:",
        help = "declare an impure nongeneric function with one Int parameter returning Result[List[UInt8], Int]",
    },
]


private pure func accepted(source: String) -> Bool:
    foundation = test_base()
    match parse_modules_with_base(
        [{ source = source, targets = [] }],
        { foundation | prelude_selections = foundation.prelude_selections + ", UInt8" },
    ):
        Err(_):
            False
        Ok(program):
            match check(program):
                Ok(_): True
                Err(_): False


pure func test_a_user_module_declares_each_console_native_with_its_exact_contract() -> Bool:
    CONSOLE_NATIVES.all(pure func(native: ConsoleDeclaration) -> Bool:
        accepted(native.header + "\n    builtin(\"${native.label}\")\nfunc main() -> Int:\n    0\n")
    )


pure func test_a_wrong_contract_gets_the_runtime_contract_message_and_help() -> Bool:
    CONSOLE_NATIVES.all(pure func(native: ConsoleDeclaration) -> Bool:
        before = "func native() -> Void:\n    builtin("
        foundation = test_base()
        match parse_modules_with_base(
            [
                {
                    source = before + "\"${native.label}\")\nfunc main() -> Int:\n    0\n",
                    targets = [],
                },
            ],
            { foundation | prelude_selections = foundation.prelude_selections + ", UInt8" },
        ):
            Err(_):
                False
            Ok(program):
                match check(program):
                    Ok(_):
                        False
                    Err(failure):
                        errors = render_failure(failure)
                        actual = errors.first
                        (actual.message == "builtin declaration does not match its runtime contract")
                            .and(actual.help == native.help)
                            .and(actual.span.source == module_source(root_module_id()))
                            .and(actual.span.start == before.length())
                            .and(actual.span.end == before.length() + native.label.length() + 2)
                            .and(actual.note.is_none())
                            .and(errors.remaining.is_empty())
    )


TESTS: TestSuite = {
    description = "console native declarations",
    tests = [
        (
            "a user module accepts each of the five console labels with its exact contract",
            test_a_user_module_declares_each_console_native_with_its_exact_contract,
        ),
        (
            "a declaration with the wrong contract gets the contract message and its exact help",
            test_a_wrong_contract_gets_the_runtime_contract_message_and_help,
        ),
    ],
}
