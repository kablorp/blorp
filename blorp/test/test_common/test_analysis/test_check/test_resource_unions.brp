---
Resource unions in check (rule 9, decision 1). A `resource union` follows the
resource rules of a `resource type`: it is never stored, returned, captured by
a pure closure or taken by a pure function, and a default it inherits is
walked with Self as the resource. That it has no value equality needs the
library's Equatable, so an e2e rejection tests it. Its module reads its
handle by destructuring; nothing matches it, and no other module can name its
variant. Each root marks the span its one diagnostic covers with `[[` and `]]`.
---
import:
    test: TestSuite
    ../../../support/variant_inputs: compiles, rejects


-- The module, which the cross-module root imports as `./email`.
private READER: String =
    |resource union Reader:
    |    private Init(Int)
    |func read_chunk(reader: Reader) -> Int:
    |    Reader.Init(handle) = reader
    |    handle
    |


private ENTRY: String =
    |func main() -> Int:
    |    0
    |


private STORED: String = "the resource type Reader cannot be stored"


private STORED_HELP: String = "pass the resource directly to an impure function instead of binding or wrapping it"


func test_its_module_reads_the_handle_by_destructuring() -> Bool:
    compiles(READER + ENTRY, "")


func test_a_resource_union_cannot_be_matched() -> Bool:
    uses: String =
        |func examine(reader: Reader) -> Int:
        |    match [[reader]]:
        |        Init(handle): handle
        |

    rejects(
        "",
        READER + uses + ENTRY,
        "a resource cannot be matched",
        "destructure the Reader in its module instead"
    )


func test_a_resource_union_cannot_be_bound_to_a_name() -> Bool:
    uses: String =
        |func keep(reader: Reader) -> Int:
        |    saved = [[reader]]
        |    0
        |

    rejects("", READER + uses + ENTRY, STORED, STORED_HELP)


func test_a_resource_union_cannot_be_a_payload() -> Bool:
    uses: String =
        |union Wrapper:
        |    Holds([[Reader]])
        |

    rejects("", READER + uses + ENTRY, STORED, STORED_HELP)


func test_a_resource_union_cannot_be_returned() -> Bool:
    uses: String =
        |func keep(reader: Reader) -> [[Reader]]:
        |    reader
        |

    rejects(
        "",
        READER + uses + ENTRY,
        "the resource type Reader cannot be returned",
        "consume the resource inside its scope and return an ordinary value instead"
    )


func test_a_pure_closure_cannot_capture_a_resource_union() -> Bool:
    uses: String =
        |func during(reader: Reader) -> Int:
        |    body = [[pure func() -> Int:
        |        Reader.Init(handle) = reader
        |        handle]]
        |    0
        |

    rejects(
        "",
        READER + uses + ENTRY,
        "pure closures cannot capture the resource type Reader",
        "remove pure and invoke the closure inside the resource scope"
    )


func test_a_pure_function_cannot_take_a_resource_union() -> Bool:
    uses: String =
        |pure func peek(reader: [[Reader]]) -> Int:
        |    0
        |

    rejects(
        "",
        READER + uses + ENTRY,
        "pure functions cannot take the resource type Reader",
        "remove pure and consume the resource synchronously"
    )


func test_another_module_cannot_destructure_a_resource_union() -> Bool:
    root: String =
        |import:
        |    ./email: Reader
        |func peek(reader: Reader) -> Int:
        |    Reader.[[Init]](handle) = reader
        |    handle
        |

    rejects(
        READER,
        root + ENTRY,
        "Reader.Init is private to module ./email",
        "build the Reader with a function ./email exports"
    )


-- The default stores Self, which is fine for Self rigid and a misuse once
-- Self is read as the resource union that inherits it.
func test_an_inherited_default_is_walked_with_the_resource_union() -> Bool:
    uses: String =
        |trait Marked:
        |    func size(self: Self) -> Int
        |    func mark(self: Self) -> Void:
        |        kept = self
        |        void
        |[[implements Marked for Reader:]]
        |    func size(self: Self) -> Int:
        |        read_chunk(self)
        |

    rejects(
        "",
        READER + uses + ENTRY,
        "the resource type Reader cannot use Marked's default mark",
        "write mark in this implementation without returning or storing the Reader, or do not implement Marked for Reader"
    )


TESTS: TestSuite = {
    description = "Resource unions in check",
    tests = [
        (
            "its module reads the handle by destructuring",
            test_its_module_reads_the_handle_by_destructuring
        ),
        ("a resource union cannot be matched", test_a_resource_union_cannot_be_matched),
        (
            "a resource union cannot be bound to a name",
            test_a_resource_union_cannot_be_bound_to_a_name
        ),
        ("a resource union cannot be a payload", test_a_resource_union_cannot_be_a_payload),
        ("a resource union cannot be returned", test_a_resource_union_cannot_be_returned),
        (
            "a pure closure cannot capture a resource union",
            test_a_pure_closure_cannot_capture_a_resource_union
        ),
        (
            "a pure function cannot take a resource union",
            test_a_pure_function_cannot_take_a_resource_union
        ),
        (
            "another module cannot destructure a resource union",
            test_another_module_cannot_destructure_a_resource_union
        ),
        (
            "an inherited default is walked with the resource union",
            test_an_inherited_default_is_walked_with_the_resource_union
        )
    ]
}
