import:
    bool: and
    test: TestSuite
    ../../../../src/common/analysis/check/errors:
        CheckErrorKind(TypeTermRejection),
        TypeTermError(UnknownType),
    ../../../support/input: checked_source, rejects_at


pure func test_wrong_return_type_diagnostic() -> Bool:
    source: String =
        |func main() -> Foo:
        |	0
        |
    rejects_at(source, 15, 18, pure func(kind: CheckErrorKind) -> Bool:
        match kind:
            TypeTermRejection(UnknownType(_)): True
            _: False
    )


pure func test_unknown_helper_return_type_diagnostic() -> Bool:
    source: String =
        |func main() -> Int:
        |	0
        |func one() -> Nope:
        |	1
        |
    rejects_at(source, 37, 41, pure func(kind: CheckErrorKind) -> Bool:
        match kind:
            TypeTermRejection(UnknownType(_)): True
            _: False
    )


pure func test_unknown_parameter_type_diagnostic() -> Bool:
    source: String =
        |func identity(value: Nope) -> Int:
        |	value
        |func main() -> Int:
        |	identity(1)
        |
    rejects_at(source, 21, 25, pure func(kind: CheckErrorKind) -> Bool:
        match kind:
            TypeTermRejection(UnknownType(_)): True
            _: False
    )


-- The help names the parameter's own spelling and never proposes another name,
-- because a suggested name may itself be a type.
pure func test_type_parameter_with_a_type_name_is_refused_without_a_suggestion() -> Bool:
    source: String =
        |record T { value: Int }
        |func first[T](value: Int) -> Int:
        |	value
        |func main() -> Int:
        |	first(0)
        |
    match checked_source(source):
        Ok(_):
            False
        Err(diagnostic):
            and(
                diagnostic.message == "type parameter `T` has the name of a type",
                (
                    diagnostic.help
                    == "`T` already names a type here; give the type parameter another name"
                ),
            )


TESTS: TestSuite = {
    description = "Blorp written type resolution",
    tests = [
        (
            "a type parameter named like a type is refused without a suggestion",
            test_type_parameter_with_a_type_name_is_refused_without_a_suggestion,
        ),
        ("unknown parameter type diagnostic", test_unknown_parameter_type_diagnostic),
        ("unknown helper return type diagnostic", test_unknown_helper_return_type_diagnostic),
        ("wrong return type diagnostic", test_wrong_return_type_diagnostic),
    ],
}
