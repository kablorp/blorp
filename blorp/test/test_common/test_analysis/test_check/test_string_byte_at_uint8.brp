import:
    bool: Bool methods
    list: List methods
    option: Option methods
    result: Result methods
    string: String methods
    test: TestSuite
    ../../../support/uint8_inputs: checked_uint8, uint8_rejection


private HELP: String = "declare a pure nongeneric function with String and Int parameters returning Option[UInt8]"


private pure func program_with(header: String) -> String:
    "${header}\n    builtin(\"string.byte_at_uint8\")\nfunc main() -> Int:\n    0\n"


private pure func rejects(header: String) -> Bool:
    match uint8_rejection(program_with(header)):
        None:
            False
        Some(errors):
            errors.first.message
                .equals("builtin declaration does not match its runtime contract")
                .and(errors.first.help.equals(HELP))


pure func test_exact_contract_is_accepted() -> Bool:
    checked_uint8(program_with("pure func read_byte(value: String, index: Int) -> Option[UInt8]:")).is_ok()


-- Option[Int] is the contract of string.codepoint_at; this label returns the byte as a UInt8.
pure func test_other_shapes_are_refused() -> Bool:
    [
        "pure func read_byte(value: String, index: Int) -> Option[Int]:",
        "pure func read_byte(value: String) -> Option[UInt8]:",
        "pure func read_byte(value: String, index: Int) -> UInt8:",
        "func read_byte(value: String, index: Int) -> Option[UInt8]:",
    ].all(rejects)


TESTS: TestSuite = {
    description = "string.byte_at_uint8 builtin contract",
    tests = [
        ("the exact contract is accepted", test_exact_contract_is_accepted),
        (
            "an Int payload, another arity, a bare result or an impure function is refused",
            test_other_shapes_are_refused,
        ),
    ],
}
