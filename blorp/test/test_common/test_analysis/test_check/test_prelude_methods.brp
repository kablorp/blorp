import:
    test: TestSuite
    ../../../../src/common/analysis/check/check: check
    ../../../../src/common/analysis/check/render: render_failure
    ../../../../src/common/analysis/load/load: LibrarySource(LibraryDirectory), load_program
    ../../../../src/common/syntax/source: module_source, root_module_id


-- The prelude selects the methods of `option`, `result` and `bool`, so a user
-- module calls them without an import, and a user function those methods'
-- receivers could fit is the same overlap any prelude method rejects.
private FIXTURES: String = "blorp/test/test_common/test_analysis/test_check/fixtures/prelude_methods/"


private LIBRARY_ROOT: String = "blorp/standard_library"


-- Whether the fixture checks without a diagnostic.
private func accepted(name: String) -> Bool:
    match load_program(FIXTURES + name + ".brp", LibraryDirectory(LIBRARY_ROOT)):
        Err(_):
            False
        Ok(loaded):
            match check(loaded.program):
                Ok(_): True
                Err(_): False


-- The single diagnostic, in the fixture itself, compared exactly, with the
-- notes that point at the two receivers.
private func rejects(name: String, start: Int, end: Int, message: String, help: String) -> Bool:
    match load_program(FIXTURES + name + ".brp", LibraryDirectory(LIBRARY_ROOT)):
        Err(_):
            False
        Ok(loaded):
            match check(loaded.program):
                Ok(_):
                    False
                Err(failure):
                    diagnostics = render_failure(failure)
                    first = diagnostics.first
                    (first.span.source == module_source(root_module_id()))
                        .and(first.span.start == start)
                        .and(first.span.end == end)
                        .and(first.message == message)
                        .and(first.help == help)
                        .and(first.note.is_some())
                        .and(diagnostics.remaining.is_empty())


-- Option's and Result's `map`, and Option's `get_or`, sit beside List's and
-- Dict's; each call is chosen by its receiver.
func test_a_user_module_calls_option_result_and_bool_methods_without_an_import() -> Bool:
    accepted("calls_methods")


-- Selecting what the prelude already supplies enters once.
func test_selecting_prelude_methods_again_enters_once() -> Bool:
    accepted("imports_methods")


func test_a_user_get_or_on_option_overlaps_the_prelude_method() -> Bool:
    rejects(
        "declares_option_method",
        10,
        16,
        "two functions named get_or can accept the same receiver",
        "rename one of them, or change a first parameter so that no value fits both receivers, Option[T] and Option[T]"
    )


-- A generic first parameter fits a Result, so it overlaps Result's `is_ok`.
func test_a_generic_user_is_ok_overlaps_the_prelude_method() -> Bool:
    rejects(
        "declares_generic_method",
        10,
        15,
        "two functions named is_ok can accept the same receiver",
        "rename one of them, or change a first parameter so that no value fits both receivers, T and Result[T, E]"
    )


func test_a_user_not_on_bool_overlaps_the_prelude_method() -> Bool:
    rejects(
        "declares_bool_method",
        10,
        13,
        "two functions named not can accept the same receiver",
        "rename one of them, or change a first parameter so that no value fits both receivers, Bool and Bool"
    )


-- The names stay free for receivers that none of Option, Result or Bool fits.
func test_same_named_methods_on_a_user_record_are_accepted() -> Bool:
    accepted("declares_other_receiver")


TESTS: TestSuite = {
    description = "Option, Result and Bool methods in the prelude",
    tests = [
        (
            "a user module calls Option, Result and Bool methods without an import",
            test_a_user_module_calls_option_result_and_bool_methods_without_an_import
        ),
        (
            "selecting prelude methods again enters once",
            test_selecting_prelude_methods_again_enters_once
        ),
        (
            "a user get_or on Option overlaps the prelude method",
            test_a_user_get_or_on_option_overlaps_the_prelude_method
        ),
        (
            "a generic user is_ok overlaps the prelude method",
            test_a_generic_user_is_ok_overlaps_the_prelude_method
        ),
        (
            "a user not on Bool overlaps the prelude method",
            test_a_user_not_on_bool_overlaps_the_prelude_method
        ),
        (
            "same-named methods on a user record are accepted",
            test_same_named_methods_on_a_user_record_are_accepted
        )
    ]
}
