import:
    bool: Bool methods
    test: TestSuite
    ../../../../src/common/analysis/check/check: check
    ../../../../src/common/analysis/check/render: render_failure
    ../../../../src/common/syntax/source: module_source, root_module_id, module_id
    ../../../support/fs_native_inputs: LIBRARY_IMPORT, library_program
    ../../../support/module_input: parse_modules_with_base, test_base


private record NativeDeclaration {
    label: String,
    header: String,
    help: String
}


private RAW_NATIVES: List[NativeDeclaration] = [
    {
        label = "fs.open_read",
        header = "func native(path: String) -> Result[Int, Int]:",
        help = "declare an impure nongeneric function with one String parameter returning Result[Int, Int]"
    },
    {
        label = "fs.next_lines",
        header = "func native(handle: Int, carried: String) -> Result[List[String], Int]:",
        help = "declare an impure nongeneric function with Int and String parameters returning Result[List[String], Int]"
    },
    {
        label = "fs.close",
        header = "func native(handle: Int) -> Result[Void, Int]:",
        help = "declare an impure nongeneric function with one Int parameter returning Result[Void, Int]"
    },
    {
        label = "fs.read_chunk",
        header = "func native(handle: Int) -> Result[List[UInt8], Int]:",
        help = "declare an impure nongeneric function with one Int parameter returning Result[List[UInt8], Int]"
    },
    {
        label = "fs.writer_begin",
        header = "func native(path: String) -> Result[Int, Int]:",
        help = "declare an impure nongeneric function with one String parameter returning Result[Int, Int]"
    },
    {
        label = "fs.writer_write_all",
        header = "func native(handle: Int, data: List[UInt8]) -> Result[Void, Int]:",
        help = "declare an impure nongeneric function with Int and List[UInt8] parameters returning Result[Void, Int]"
    },
    {
        label = "fs.writer_finish",
        header = "func native(handle: Int) -> Result[Void, Int]:",
        help = "declare an impure nongeneric function with one Int parameter returning Result[Void, Int]"
    },
    {
        label = "fs.writer_discard",
        header = "func native(handle: Int) -> Result[Void, Int]:",
        help = "declare an impure nongeneric function with one Int parameter returning Result[Void, Int]"
    }
]


private ACCESS_MESSAGE: String = "raw filesystem builtin is restricted to library modules"


private ACCESS_HELP: String = "use the io/files library operations instead of declaring this builtin"


private pure func rejects_at(before: String, label: String, after: String) -> Bool:
    foundation = test_base()
    parsed = parse_modules_with_base(
        [{ source = before + "\"${label}\"" + after, targets = [] }],
        { foundation | prelude_selections = foundation.prelude_selections + ", UInt8" }
    )
    match parsed:
        Err(_):
            False
        Ok(program):
            match check(program):
                Ok(_):
                    False
                Err(failure):
                    errors = render_failure(failure)
                    actual = errors.first
                    (actual.message == ACCESS_MESSAGE)
                        .and(actual.help == ACCESS_HELP)
                        .and(actual.span.source == module_source(root_module_id()))
                        .and(actual.span.start == before.length())
                        .and(actual.span.end == before.length() + label.length() + 2)
                        .and(actual.note.is_none())
                        .and(errors.remaining.is_empty())


pure func test_every_raw_native_requires_library_authority() -> Bool:
    RAW_NATIVES.all(pure func(native: NativeDeclaration) -> Bool:
        rejects_at(
            native.header + "\n    builtin(",
            native.label,
            ")\nfunc main() -> Int:\n    0\n"
        )
    )


pure func test_resource_and_private_names_cannot_grant_authority() -> Bool:
    RAW_NATIVES.all(pure func(native: NativeDeclaration) -> Bool:
        rejects_at(
            "resource type Writer = Int\nprivate " + native.header + "\n    builtin(",
            native.label,
            ")\nfunc main() -> Int:\n    0\n"
        )
    )


pure func test_implementation_and_trait_default_cannot_grant_authority() -> Bool:
    implementation: String =
        |trait Closing:
        |    pure func close(value: Self) -> Result[Void, Int]
        |implements Closing for Int:
        |    pure func close(value: Self) -> Result[Void, Int]:
        |
    default_body: String =
        |trait Closing:
        |    pure func close(value: Self) -> Result[Void, Int]:
        |
    rejects_at(implementation + "        builtin(", "fs.close", ")\nfunc main() -> Int:\n    0\n").and(
        rejects_at(
            default_body + "        builtin(",
            "fs.close",
            ")\nfunc main() -> Int:\n    0\n"
        )
    )


pure func test_library_accepts_each_exact_contract() -> Bool:
    RAW_NATIVES.all(pure func(native: NativeDeclaration) -> Bool:
        match library_program(
            native.header + "\n    builtin(\"${native.label}\")\nfunc main() -> Int:\n    0\n"
        ):
            Err(_):
                False
            Ok(program):
                match check(program):
                    Ok(_): True
                    Err(_): False
    )


pure func test_library_preserves_each_contract_rejection() -> Bool:
    RAW_NATIVES.all(pure func(native: NativeDeclaration) -> Bool:
        before = "func native() -> Void:\n    builtin("
        match library_program(before + "\"${native.label}\")\nfunc main() -> Int:\n    0\n"):
            Err(_):
                False
            Ok(program):
                match check(program):
                    Ok(_):
                        False
                    Err(failure):
                        errors = render_failure(failure)
                        actual = errors.first
                        (actual.message == "builtin declaration does not match its runtime contract")
                            .and(actual.help == native.help)
                            .and(
                                (
                                    Some(actual.span.source)
                                    == module_id(1).map(pure func(module): module_source(module))
                                )
                            )
                            .and(actual.span.start == LIBRARY_IMPORT.length() + before.length())
                            .and(
                                (
                                    actual.span.end
                                    == LIBRARY_IMPORT.length() + before.length() + native.label.length() + 2
                                )
                            )
                            .and(actual.note.is_none())
                            .and(errors.remaining.is_empty())
    )


TESTS: TestSuite = {
    description = "raw filesystem native declaration authority",
    tests = [
        (
            "all eight raw handle labels reject ordinary users exactly",
            test_every_raw_native_requires_library_authority
        ),
        (
            "private names and fabricated resource types do not grant authority",
            test_resource_and_private_names_cannot_grant_authority
        ),
        (
            "implementation and trait default bodies reject raw declarations",
            test_implementation_and_trait_default_cannot_grant_authority
        ),
        (
            "genuine library modules accept every exact contract",
            test_library_accepts_each_exact_contract
        ),
        (
            "genuine library modules preserve exact contract diagnostics",
            test_library_preserves_each_contract_rejection
        )
    ]
}
