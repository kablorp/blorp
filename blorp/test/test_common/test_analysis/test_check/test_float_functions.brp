import:
    test: TestSuite
    ../../../../src/common/analysis/check/check: check
    ../../../../src/common/analysis/check/render: render_failure
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../support/module_input: parse_modules_with_base, test_base


private record FloatDeclaration {
    label: String,
    header: String,
    help: String
}


private UNARY_HEADER: String = "pure func native(value: Float) -> Float:"


private UNARY_HELP: String = "declare a pure nongeneric function with one Float parameter returning Float"


private BINARY_HEADER: String = "pure func native(first: Float, second: Float) -> Float:"


private BINARY_HELP: String = "declare a pure nongeneric function with two Float parameters returning Float"


private pure func unary(label: String) -> FloatDeclaration:
    { label = label, header = UNARY_HEADER, help = UNARY_HELP }


-- Every Float function label, and the two conversions, with its exact contract.
private pure func float_functions() -> List[FloatDeclaration]:
    [
        unary("float.sqrt"),
        unary("float.floor"),
        unary("float.ceil"),
        unary("float.round"),
        unary("float.trunc"),
        unary("float.sin"),
        unary("float.cos"),
        unary("float.tan"),
        unary("float.exp"),
        unary("float.log"),
        { label = "float.atan2", header = BINARY_HEADER, help = BINARY_HELP },
        { label = "float.pow", header = BINARY_HEADER, help = BINARY_HELP },
        {
            label = "float.to_int",
            header = "pure func native(value: Float) -> Int:",
            help = "declare a pure nongeneric function with one Float parameter returning Int"
        },
        {
            label = "int.to_float",
            header = "pure func native(value: Int) -> Float:",
            help = "declare a pure nongeneric function with one Int parameter returning Float"
        }
    ]


private pure func accepted(source: String) -> Bool:
    match parse_modules_with_base([{ source = source, targets = [] }], test_base()):
        Err(_):
            False
        Ok(program):
            match check(program):
                Ok(_): True
                Err(_): False


pure func test_each_float_function_is_declared_with_its_exact_contract() -> Bool:
    float_functions().all(pure func(native: FloatDeclaration) -> Bool:
        accepted(native.header + "\n    builtin(\"${native.label}\")\nfunc main() -> Int:\n    0\n")
    )


-- An impure header is the mistake a header copied from a system native makes.
pure func test_a_wrong_contract_gets_the_runtime_contract_message_and_help() -> Bool:
    float_functions().all(pure func(native: FloatDeclaration) -> Bool:
        before = "func native(value: Float) -> Float:\n    builtin("

        match parse_modules_with_base(
            [
                {
                    source = before + "\"${native.label}\")\nfunc main() -> Int:\n    0\n",
                    targets = []
                }
            ],
            test_base()
        ):
            Err(_):
                False
            Ok(program):
                match check(program):
                    Ok(_):
                        False
                    Err(failure):
                        errors = render_failure(failure)
                        actual = errors.first

                        (actual.message == "builtin declaration does not match its runtime contract")
                            .and(actual.help == native.help)
                            .and(actual.span.source == module_source(root_module_id()))
                            .and(actual.span.start == before.length())
                            .and(actual.span.end == before.length() + native.label.length() + 2)
                            .and(actual.note.is_none())
                            .and(errors.remaining.is_empty())
    )


TESTS: TestSuite = {
    description = "Float function declarations",
    tests = [
        (
            "each Float function and conversion label is accepted with its exact contract",
            test_each_float_function_is_declared_with_its_exact_contract
        ),
        (
            "an impure declaration gets the contract message and its exact help",
            test_a_wrong_contract_gets_the_runtime_contract_message_and_help
        )
    ]
}
