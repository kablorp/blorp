---
The entry function is optional for analysis and required for checking: a module
without `main` analyses, `check` reports `MissingMain` only once everything else
checks, and a malformed `main` fails both.
---
import:
    bool: and
    int: Int methods
    list: List methods
    string: String methods
    test: TestSuite
    ../../../../src/common/analysis/assemble: ParsedProgram
    ../../../../src/common/analysis/check/check: analyze, check, check_errors, CheckFailure
    ../../../../src/common/analysis/check/errors as errors
    ../../../../src/common/analysis/check/render: render_failure
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../support/module_input: ModuleInput, parse_modules


private LIBRARY_FUNCTION: String =
    |pure func keep(value: Int) -> Int:
    |    value
    |


private VALID_MAIN: String =
    |pure func keep(value: Int) -> Int:
    |    value
    |func main() -> Int:
    |    0
    |


private STRING_MAIN: String =
    |pure func keep(value: Int) -> Int:
    |    value
    |func main() -> String:
    |    ""
    |


private MISSING_MAIN_MESSAGE: String = "expected a main function"


private MISSING_MAIN_HELP: String = "declare func main() -> Int: as the entrypoint"


-- A failure is exactly one error with this message and help, spanning
-- `start` to `end` in the root module.
private pure func is_rejection(
    failure: CheckFailure,
    message: String,
    help: String,
    start: Int,
    end: Int,
) -> Bool:
    rendered = render_failure(failure).first
    check_errors(failure).remaining
        .is_empty()
        .and(rendered.message == message)
        .and(rendered.help == help)
        .and(rendered.span.source == module_source(root_module_id()))
        .and(rendered.span.start == start)
        .and(rendered.span.end == end)


private pure func is_missing_main(failure: CheckFailure, source: String) -> Bool:
    names_missing_main: Bool = match check_errors(failure).first.kind:
        errors.SignatureRejection(errors.MissingMain): True
        _: False
    names_missing_main.and(
        failure.is_rejection(
            MISSING_MAIN_MESSAGE,
            MISSING_MAIN_HELP,
            source.length(),
            source.length(),
        ),
    )


pure func test_module_without_main_analyses() -> Bool:
    match parse_modules([{ source = LIBRARY_FUNCTION, targets = [] }]):
        Err(_):
            False
        Ok(parsed):
            match analyze(parsed):
                Ok(_): True
                Err(_): False


pure func test_check_reports_missing_main_at_the_end() -> Bool:
    match parse_modules([{ source = LIBRARY_FUNCTION, targets = [] }]):
        Err(_):
            False
        Ok(parsed):
            match check(parsed):
                Ok(_): False
                Err(failure): failure.is_missing_main(LIBRARY_FUNCTION)


pure func test_module_with_main_passes_both() -> Bool:
    match parse_modules([{ source = VALID_MAIN, targets = [] }]):
        Err(_):
            False
        Ok(parsed):
            match (analyze(parsed), check(parsed)):
                (Ok(_), Ok(_)): True
                _: False


pure func test_malformed_main_fails_both() -> Bool:
    match parse_modules([{ source = STRING_MAIN, targets = [] }]):
        Err(_):
            False
        Ok(parsed):
            expected = "main must return Int or Void"
            help = "return an Int exit status, or omit the return type for exit status 0"
            match (analyze(parsed), check(parsed)):
                (Err(analysis), Err(checking)):
                    names_return: Bool = match check_errors(checking).first.kind:
                        errors.SignatureRejection(errors.MainReturnType(_)): True
                        _: False
                    -- The span is the declared return type, `String`.
                    start = LIBRARY_FUNCTION.length() + "func main() -> ".length()
                    names_return
                        .and(analysis.is_rejection(expected, help, start, start + 6))
                        .and(checking.is_rejection(expected, help, start, start + 6))
                _:
                    False


pure func test_main_in_an_imported_module_is_not_the_entry() -> Bool:
    root = "import:\n    ./provider: main\n" + LIBRARY_FUNCTION
    provider = "func main() -> Int:\n    0\n"
    match parse_modules([{ source = root, targets = [1] }, { source = provider, targets = [] }]):
        Err(_):
            False
        Ok(parsed):
            match (analyze(parsed), check(parsed)):
                (Ok(_), Err(failure)): failure.is_missing_main(root)
                _: False


pure func test_body_error_is_reported_before_missing_main() -> Bool:
    source = "pure func broken() -> Int:\n    \"text\"\n"
    match parse_modules([{ source = source, targets = [] }]):
        Err(_):
            False
        Ok(parsed):
            match check(parsed):
                Ok(_):
                    False
                Err(failure):
                    failure.is_rejection(
                        "expression does not match the expected type",
                        "use an expression of type Int here",
                        source.length() - 7,
                        source.length() - 1,
                    )


TESTS: TestSuite = {
    description = "the entry function is optional for analysis",
    tests = [
        ("a module without main analyses", test_module_without_main_analyses),
        (
            "check reports a missing main at the end of the root",
            test_check_reports_missing_main_at_the_end,
        ),
        ("a module with main passes analysis and check", test_module_with_main_passes_both),
        ("a malformed main fails analysis and check alike", test_malformed_main_fails_both),
        (
            "main in an imported module is not the entry",
            test_main_in_an_imported_module_is_not_the_entry,
        ),
        (
            "a body error is reported before a missing main",
            test_body_error_is_reported_before_missing_main,
        ),
    ],
}
