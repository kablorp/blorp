---
A constant read publishes `ReadConstant` with the constant's identity, never a
copy of its template, which the checked program keeps in the constant's row
for specialization to read. A callable constant's call keeps its template as
the stored callee, so its C is a direct call's, as before.
---
import:
    test: TestSuite
    ../../../../src/common/analysis/check/check: checked_functions
    ../../../../src/common/analysis/check/model as checked
    ../../../../src/common/analysis/ids: constant_number
    ../../../support/input: checked_source, elaborated_bodies


private SOURCE: String =
    |record Limits { low: Int, high: Int }
    |pure func double(value: Int) -> Int:
    |    value
    |LIMITS: Limits = { low = 1, high = 9 }
    |NAMES: List[String] = ["one", "two"]
    |DOUBLE: pure (Int) -> Int = double
    |pure func limits() -> Limits:
    |    LIMITS
    |pure func names() -> List[String]:
    |    NAMES
    |pure func twice() -> Int:
    |    DOUBLE(2)
    |func main() -> Int:
    |    0
    |


-- The returned value of the function declared at this position in SOURCE.
private pure func returned_value(position: Int) -> Option[checked.CheckedExpr]:
    match checked_source(SOURCE):
        Err(_):
            None
        Ok(program):
            match elaborated_bodies(checked_functions(program).functions).get(position):
                Some(function):
                    match function.body:
                        checked.CheckedValueBody(checked.ReturnExpression(value)): Some(value)
                        _: None
                None:
                    None


-- `limits` and `names` read the first and second constant by identity.
pure func test_constant_read_publishes_its_identity() -> Bool:
    reads = [1, 2].map(pure func(position: Int) -> Option[Int]:
        match returned_value(position).map(
            pure func(value: checked.CheckedExpr) -> checked.CheckedForm: value.form
        ):
            Some(checked.ReadConstant(id)): Some(constant_number(id))
            _: None
    )

    expected: List[Option[Int]] = [Some(0), Some(1)]
    reads == expected


-- A called constant's callee is still its template, a named callable.
pure func test_called_constant_keeps_its_template_as_callee() -> Bool:
    match returned_value(3):
        Some(value):
            match value.form:
                checked.InvokeFunction(call):
                    match call.target:
                        checked.ValueCall(callee):
                            match callee.form:
                                checked.MakeCallable(checked.NamedCallable(_, _)): True
                                _: False
                        _:
                            False
                _:
                    False
        None:
            False


TESTS: TestSuite = {
    description = "Constant reads",
    tests = [
        ("a constant read publishes its identity", test_constant_read_publishes_its_identity),
        (
            "a called constant keeps its template as callee",
            test_called_constant_keeps_its_template_as_callee
        )
    ]
}
