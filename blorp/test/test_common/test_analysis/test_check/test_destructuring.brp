---
Destructuring a union with one variant (rule 7). The variant resolves as a
construction's does, so the access and ambiguity rules of private variants
apply unchanged. A union with several variants needs `match`, and until
landing 7 only a union stored as its payload is destructured. Each root marks
the span its one diagnostic covers with `[[` and `]]`.
---
import:
    test: TestSuite
    ../../../support/variant_inputs: compiles, rejects


-- The module the roots import as `./email`.
private EMAIL: String =
    |union Token:
    |    private Init(Int)
    |pure func token(value: Int) -> Token:
    |    Init(value)
    |


private USER_ID: String =
    |union UserId:
    |    private Init(Int)
    |union Email:
    |    Checked(String)
    |    Unchecked(String)
    |


private ENTRY: String =
    |func main() -> Int:
    |    0
    |


func test_a_bare_or_qualified_variant_destructures_in_its_module() -> Bool:
    uses: String =
        |pure func number(id: UserId) -> Int:
        |    Init(value) = id
        |    value
        |pure func qualified(id: UserId) -> Int:
        |    UserId.Init(value) = id
        |    value
        |pure func discarded(id: UserId) -> Int:
        |    UserId.Init(_) = id
        |    0
        |

    compiles(USER_ID + uses + ENTRY, "")


func test_a_generic_union_destructures_at_its_arguments() -> Bool:
    root: String =
        |record User { name: String }
        |union Id[T]:
        |    private Init(Int)
        |pure func number(id: Id[User]) -> Int:
        |    Id.Init(value) = id
        |    value
        |

    compiles(root + ENTRY, "")


func test_a_union_with_several_variants_needs_match() -> Bool:
    uses: String =
        |pure func text(address: Email) -> String:
        |    [[Email.Checked(text)]] = address
        |    text
        |

    rejects(
        "",
        USER_ID + uses + ENTRY,
        "Email has 2 variants, so destructuring Email.Checked could fail to match",
        "use match to handle each variant"
    )


-- The variant count is reported alone, not with the arity as well.
func test_several_variants_are_reported_before_the_arity() -> Bool:
    uses: String =
        |pure func text(address: Email) -> String:
        |    [[Email.Checked(text, extra)]] = address
        |    text
        |

    rejects(
        "",
        USER_ID + uses + ENTRY,
        "Email has 2 variants, so destructuring Email.Checked could fail to match",
        "use match to handle each variant"
    )


func test_a_destructuring_binds_one_name_per_payload() -> Bool:
    uses: String =
        |pure func number(id: UserId) -> Int:
        |    [[UserId.Init(value, extra)]] = id
        |    value
        |

    rejects(
        "",
        USER_ID + uses + ENTRY,
        "UserId.Init has 1 payload, but this binding names 2",
        "bind one name or _ for each payload of UserId.Init"
    )


func test_a_destructuring_needs_a_value_of_its_union() -> Bool:
    uses: String =
        |pure func number(address: Email) -> Int:
        |    UserId.Init(value) = [[address]]
        |    value
        |

    rejects(
        "",
        USER_ID + uses + ENTRY,
        "this binding destructures UserId.Init, but the value is of type Email",
        "destructure the value's own union"
    )


func test_a_union_with_two_payloads_cannot_be_destructured_yet() -> Bool:
    root: String =
        |union Pair:
        |    Init(Int, Int)
        |pure func first(pair: Pair) -> Int:
        |    [[Pair.Init(left, _)]] = pair
        |    left
        |

    rejects(
        "",
        root + ENTRY,
        "destructuring Pair.Init is not supported yet, because Pair is not stored as its payload",
        "read the payloads with match"
    )


-- Its storage is reported alone, before the arity, which is also wrong.
func test_a_union_not_stored_as_its_payload_is_reported_before_the_arity() -> Bool:
    root: String =
        |union Pair:
        |    Init(Int, Int)
        |pure func first(pair: Pair) -> Int:
        |    [[Pair.Init(left)]] = pair
        |    left
        |

    rejects(
        "",
        root + ENTRY,
        "destructuring Pair.Init is not supported yet, because Pair is not stored as its payload",
        "read the payloads with match"
    )


-- A rose tree's payload reaches the tree again, so it is not erased.
func test_a_rose_tree_cannot_be_destructured_yet() -> Bool:
    root: String =
        |union Tree:
        |    Node(List[Tree])
        |pure func children(tree: Tree) -> Int:
        |    [[Tree.Node(nodes)]] = tree
        |    nodes.length()
        |

    rejects(
        "",
        root + ENTRY,
        "destructuring Tree.Node is not supported yet, because Tree is not stored as its payload",
        "read the payloads with match"
    )


func test_a_private_variant_is_destructured_only_in_its_module() -> Bool:
    root: String =
        |import:
        |    ./email: Token, token
        |pure func number(value: Token) -> Int:
        |    Token.[[Init]](inner) = value
        |    inner
        |

    rejects(
        EMAIL,
        root + ENTRY,
        "Token.Init is private to module ./email",
        "build the Token with a function ./email exports, such as token"
    )


func test_a_bare_name_several_variants_share_is_ambiguous() -> Bool:
    root: String =
        |union FunctionId:
        |    Init(Int)
        |union TypeId:
        |    Init(Int)
        |pure func number(id: TypeId) -> Int:
        |    [[Init]](value) = id
        |    value
        |

    rejects(
        "",
        root + ENTRY,
        "Init is a variant of several unions in scope: FunctionId, TypeId",
        "write it through one of them: FunctionId.Init, TypeId.Init"
    )


TESTS: TestSuite = {
    description = "Destructuring a union with one variant",
    tests = [
        (
            "a bare or qualified variant destructures in its module",
            test_a_bare_or_qualified_variant_destructures_in_its_module
        ),
        (
            "a generic union destructures at its arguments",
            test_a_generic_union_destructures_at_its_arguments
        ),
        (
            "a union with several variants needs match",
            test_a_union_with_several_variants_needs_match
        ),
        (
            "several variants are reported before the arity",
            test_several_variants_are_reported_before_the_arity
        ),
        (
            "a destructuring binds one name per payload",
            test_a_destructuring_binds_one_name_per_payload
        ),
        (
            "a destructuring needs a value of its union",
            test_a_destructuring_needs_a_value_of_its_union
        ),
        (
            "a union with two payloads cannot be destructured yet",
            test_a_union_with_two_payloads_cannot_be_destructured_yet
        ),
        (
            "a union not stored as its payload is reported before the arity",
            test_a_union_not_stored_as_its_payload_is_reported_before_the_arity
        ),
        ("a rose tree cannot be destructured yet", test_a_rose_tree_cannot_be_destructured_yet),
        (
            "a private variant is destructured only in its module",
            test_a_private_variant_is_destructured_only_in_its_module
        ),
        (
            "a bare name several variants share is ambiguous",
            test_a_bare_name_several_variants_share_is_ambiguous
        )
    ]
}
