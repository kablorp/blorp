---
`substitute_parameters` replaces every rigid parameter of one declaration at
once by the value at its position, and names a parameter that has no value.
---
import:
    test: TestSuite
    ../../../../src/common/analysis/check/check: check, checked_functions
    ../../../../src/common/analysis/check/model as model
    ../../../../src/common/syntax/syntax: IntegerFormat(Int64Format), Purity(Pure)
    ../../../support/module_input: parse_modules


private SOURCE: String =
    |pure func inspect[T](
    |    plain: T,
    |    listed: List[T],
    |    pair: (T, Int),
    |    call: pure (T, Int) -> List[T],
    |) -> Int:
    |    0
    |func main() -> Int:
    |    0
    |


-- The checked parameter types of `inspect`, the source's first function.
private pure func parameter_types() -> List[model.TypeRef]:
    match parse_modules([{ source = SOURCE, targets = [] }]):
        Err(_):
            []
        Ok(parsed):
            match check(parsed):
                Err(_):
                    []
                Ok(accepted):
                    match checked_functions(accepted).functions.get(0):
                        None:
                            []
                        Some(function):
                            function.signature.parameters.map(
                                pure func(parameter): parameter.value_type,
                            )


pure func test_every_occurrence_is_replaced_at_once() -> Bool:
    match parameter_types():
        [model.ParameterType(id), listed, pair, call]:
            int: model.TypeRef = model.IntegerType(Int64Format)
            owner = model.parameter_owner(id)
            text: model.TypeRef = model.StringType
            expected_list: Result[model.TypeRef, model.TypeParameterId] = Ok(model.ListType(int))
            expected_pair: Result[model.TypeRef, model.TypeParameterId] = Ok(
                model.TupleType([int, int]),
            )
            expected_call: Result[model.TypeRef, model.TypeParameterId] = Ok(
                model.CallableType(Pure, [text, int], model.ListType(text)),
            )
            listed_ok = model.substitute_parameters(listed, owner, [int]) == expected_list
            pair_ok = model.substitute_parameters(pair, owner, [int]) == expected_pair
            call_ok = model.substitute_parameters(call, owner, [text]) == expected_call
            [listed_ok, pair_ok, call_ok].all(pure func(holds: Bool) -> Bool: holds)
        _:
            False


pure func test_a_parameter_without_a_value_is_named() -> Bool:
    match parameter_types():
        [model.ParameterType(id), listed, _, _]:
            none: List[model.TypeRef] = []
            model.substitute_parameters(listed, model.parameter_owner(id), none) == Err(id)
        _:
            False


TESTS: TestSuite = {
    description = "Parameter substitution",
    tests = [
        ("every occurrence is replaced at once", test_every_occurrence_is_replaced_at_once),
        ("a parameter without a value is named", test_a_parameter_without_a_value_is_named),
    ],
}
