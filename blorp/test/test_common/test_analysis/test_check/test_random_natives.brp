import:
    test: TestSuite
    ../../../../src/common/analysis/check/check: check
    ../../../../src/common/analysis/check/render: render_failure
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../support/module_input: parse_modules_with_base, test_base


private LABEL: String = "system.random_seed"


private pure func accepted(source: String) -> Bool:
    match parse_modules_with_base([{ source = source, targets = [] }], test_base()):
        Err(_):
            False
        Ok(program):
            match check(program):
                Ok(_): True
                Err(_): False


-- It takes no handle, so any module may declare it.
pure func test_a_user_module_declares_the_seed_native_with_its_exact_contract() -> Bool:
    accepted(
        "func native() -> Result[Int, Int]:\n    builtin(\"${LABEL}\")\nfunc main() -> Int:\n    0\n"
    )


-- A pure header is the mistake an author who thinks of a seed as a value makes.
pure func test_a_pure_declaration_gets_the_contract_message_and_help() -> Bool:
    before = "pure func native() -> Result[Int, Int]:\n    builtin("

    match parse_modules_with_base(
        [{ source = before + "\"${LABEL}\")\nfunc main() -> Int:\n    0\n", targets = [] }],
        test_base()
    ):
        Err(_):
            False
        Ok(program):
            match check(program):
                Ok(_):
                    False
                Err(failure):
                    errors = render_failure(failure)
                    actual = errors.first

                    (actual.message == "builtin declaration does not match its runtime contract")
                        .and(
                            (
                                actual.help
                                == "declare an impure nongeneric function with no parameters returning Result[Int, Int]"
                            )
                        )
                        .and(actual.span.source == module_source(root_module_id()))
                        .and(actual.span.start == before.length())
                        .and(actual.span.end == before.length() + LABEL.length() + 2)
                        .and(actual.note.is_none())
                        .and(errors.remaining.is_empty())


TESTS: TestSuite = {
    description = "random seed native declarations",
    tests = [
        (
            "a user module declares the seed native with its exact contract",
            test_a_user_module_declares_the_seed_native_with_its_exact_contract
        ),
        (
            "a pure declaration gets the contract message and its exact help",
            test_a_pure_declaration_gets_the_contract_message_and_help
        )
    ]
}
