import:
    bool: and
    option: Option methods
    test: TestSuite
    ../../../../src/common/analysis/check/check: check
    ../../../../src/common/analysis/check/render: render_failure
    ../../../../src/common/analysis/load/load: LibrarySource(LibraryDirectory), load_program
    ../../../../src/common/syntax/source: module_source, root_module_id


-- The prelude supplies console output, so a user module needs no import for it,
-- and declaring either name is the same conflict a prelude constructor gets.
private FIXTURES: String = "blorp/test/test_common/test_analysis/test_check/fixtures/prelude_print/"


private LIBRARY_ROOT: String = "blorp/standard_library"


-- Whether the fixture checks without a diagnostic.
private func accepted(name: String) -> Bool:
    match load_program(FIXTURES + name + ".brp", LibraryDirectory(LIBRARY_ROOT)):
        Err(_):
            False
        Ok(loaded):
            match check(loaded.program):
                Ok(_): True
                Err(_): False


-- The single diagnostic, in the fixture itself, compared exactly. `noted` says
-- whether it carries a note pointing at the prelude's selection.
private func rejects(
    name: String,
    start: Int,
    end: Int,
    message: String,
    help: String,
    noted: Bool,
) -> Bool:
    match load_program(FIXTURES + name + ".brp", LibraryDirectory(LIBRARY_ROOT)):
        Err(_):
            False
        Ok(loaded):
            match check(loaded.program):
                Ok(_):
                    False
                Err(failure):
                    diagnostics = render_failure(failure)
                    first = diagnostics.first
                    (first.span.source == module_source(root_module_id()))
                        .and(first.span.start == start)
                        .and(first.span.end == end)
                        .and(first.message == message)
                        .and(first.help == help)
                        .and(first.note.is_some() == noted)
                        .and(diagnostics.remaining.is_empty())


func test_a_user_module_prints_without_an_import() -> Bool:
    accepted("calls_print")


func test_a_user_function_cannot_be_named_print() -> Bool:
    rejects(
        "declares_print",
        5,
        10,
        "print is provided by the prelude",
        "give this function another name; the prelude's function print is always in scope",
        True,
    )


func test_a_user_function_cannot_be_named_print_error() -> Bool:
    rejects(
        "declares_print_error",
        5,
        16,
        "print_error is provided by the prelude",
        "give this function another name; the prelude's function print_error is always in scope",
        True,
    )


-- Selecting what the prelude already supplies enters once, as for every other
-- prelude entity, so the redundant import is accepted rather than rejected.
func test_selecting_print_from_io_enters_once() -> Bool:
    accepted("imports_print")


func test_a_pure_function_cannot_print() -> Bool:
    rejects(
        "pure_print",
        34,
        39,
        "pure functions cannot call impure functions",
        "mark the callee pure or remove pure from the caller",
        False,
    )


TESTS: TestSuite = {
    description = "console output in the prelude",
    tests = [
        ("a user module prints without an import", test_a_user_module_prints_without_an_import),
        ("a user function cannot be named print", test_a_user_function_cannot_be_named_print),
        (
            "a user function cannot be named print_error",
            test_a_user_function_cannot_be_named_print_error,
        ),
        ("selecting print from io enters once", test_selecting_print_from_io_enters_once),
        ("a pure function cannot print", test_a_pure_function_cannot_print),
    ],
}
