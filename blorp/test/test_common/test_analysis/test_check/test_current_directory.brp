import:
    bool: Bool methods
    int as int_ops
    list: List methods
    option: Option methods
    result: and_then, map_err
    string: String methods
    test: TestSuite
    ../../../../src/common/analysis/check/check: check, checked_functions
    ../../../../src/common/analysis/check/model as model
    ../../../../src/common/analysis/check/render: render_failure
    ../../../../src/common/analysis/ids: union_number, variant_owner
    ../../../../src/common/analysis/namespace/builtins as builtins
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../src/common/syntax/syntax: IntegerFormat(Int64Format), Purity(Impure)
    ../../../../src/common/utils/text: concat
    ../../../support/current_directory_inputs: checked_current_directory
    ../../../support/module_input: parse_modules, test_base
    ../../../support/text_search: find_text


private HELP: String = "declare an impure nongeneric function with no parameters returning Result[String, Int]"


func test_current_directory_checks_as_designated_result() -> Bool:
    match checked_current_directory(test_base()):
        Err(error):
            print_error(error.message)
            print_error(error.help)
            print_error(
                int_ops.to_string(error.span.start)
                    .concat("..")
                    .concat(int_ops.to_string(error.span.end)),
            )
            False
        Ok(_):
            True


private BODY: String =
    |    builtin("system.current_directory")
    |func main() -> Int:
    |    0
    |


pure func test_current_directory_contract_keeps_string_success_and_code_error() -> Bool:
    match checked_current_directory(test_base()):
        Err(_):
            False
        Ok(program):
            match checked_functions(program).functions.get(0):
                Some(function):
                    match function.body:
                        model.CheckedValueBody(model.ReturnExpression(value)):
                            match value.form:
                                model.InvokeFunction(call):
                                    match call.operands:
                                        []:
                                            match call.target:
                                                model.RuntimeFunction(operation):
                                                    contract = builtins.runtime_contract(operation)
                                                    match (
                                                        function.signature.return_type.value_type,
                                                        contract.return_type,
                                                    ):
                                                        (model.NominalType(model.AggregateNominal(model.UnionAggregate(owner)), [model.StringType, model.IntegerType(Int64Format)]), builtins.ResultResult(success, error, designated)):
                                                            match (success, error):
                                                                (builtins.PrimitiveRuntimeType(builtins.BuiltinString), builtins.PrimitiveRuntimeType(builtins.BuiltinInt)):
                                                                    (contract.purity == Impure)
                                                                        .and(
                                                                            contract.parameters.is_empty(),
                                                                        )
                                                                        .and(
                                                                            (
                                                                                union_number(owner)
                                                                                == union_number(
                                                                                    variant_owner(
                                                                                        designated.ok,
                                                                                    ),
                                                                                )
                                                                            ),
                                                                        )
                                                                        .and(
                                                                            (
                                                                                union_number(owner)
                                                                                == union_number(
                                                                                    variant_owner(
                                                                                        designated.err,
                                                                                    ),
                                                                                )
                                                                            ),
                                                                        )
                                                                _:
                                                                    False
                                                        _:
                                                            False
                                                _:
                                                    False
                                        _:
                                            False
                                _:
                                    False
                        _:
                            False
                None:
                    False


private pure func diagnostic_is(
    source: String,
    message: String,
    help: String,
    start: Int,
    end: Int,
) -> Bool:
    match parse_modules([{ source = source, targets = [] }]):
        Err(_):
            False
        Ok(parsed):
            match check(parsed):
                Ok(_):
                    False
                Err(failure):
                    diagnostics = render_failure(failure)
                    error = diagnostics.first
                    diagnostics.remaining
                        .is_empty()
                        .and(error.note.is_none())
                        .and(error.message == message)
                        .and(error.help == help)
                        .and(error.span.source == module_source(root_module_id()))
                        .and(error.span.start == start)
                        .and(error.span.end == end)


private pure func header_rejected(header: String) -> Bool:
    label_start = header.length() + "\n    builtin(".length()
    diagnostic_is(
        header + "\n" + BODY,
        "builtin declaration does not match its runtime contract",
        HELP,
        label_start,
        label_start + "\"system.current_directory\"".length(),
    )


pure func test_current_directory_rejects_pure_header() -> Bool:
    header_rejected("pure func query() -> Result[String, String]:")


pure func test_current_directory_rejects_generic_header() -> Bool:
    header_rejected("func query[T]() -> Result[String, String]:")


pure func test_current_directory_rejects_parameters() -> Bool:
    header_rejected("func query(value: Int) -> Result[String, String]:")


pure func test_current_directory_rejects_wrong_success_payload() -> Bool:
    header_rejected("func query() -> Result[Int, Int]:")


pure func test_current_directory_rejects_wrong_error_payload() -> Bool:
    header_rejected("func query() -> Result[String, String]:")


pure func test_current_directory_rejects_ordinary_result() -> Bool:
    header: String =
        |union Other[A, B]:
        |    Yes(A)
        |    No(B)
        |func query() -> Other[String, Int]:
    header_rejected(header)


pure func test_current_directory_rejects_pure_caller() -> Bool:
    source: String =
        |func query() -> Result[String, Int]:
        |    builtin("system.current_directory")
        |pure func illegal() -> Result[String, Int]:
        |    query()
        |func main() -> Int:
        |    0
        |
    match find_text(source, "    query()", 0):
        None:
            False
        Some(line):
            start = line + "    ".length()
            diagnostic_is(
                source,
                "pure functions cannot call impure functions",
                "mark the callee pure or remove pure from the caller",
                start,
                start + "query".length(),
            )


pure func test_current_directory_rejects_tail_annotation() -> Bool:
    source: String =
        |@tail_recursive
        |func query() -> Result[String, Int]:
        |    builtin("system.current_directory")
        |func main() -> Int:
        |    0
        |
    diagnostic_is(
        source,
        "builtin bodies cannot have a tail-recursion annotation",
        "remove @tail_recursive from the builtin declaration",
        0,
        "@tail_recursive".length(),
    )


TESTS: TestSuite = {
    description = "Blorp current directory contract",
    tests = [
        (
            "current directory checks as designated Result",
            test_current_directory_checks_as_designated_result,
        ),
        (
            "current directory carries a String success and an Int code error",
            test_current_directory_contract_keeps_string_success_and_code_error,
        ),
        ("pure header rejects", test_current_directory_rejects_pure_header),
        ("generic header rejects", test_current_directory_rejects_generic_header),
        ("parameters reject", test_current_directory_rejects_parameters),
        ("wrong success payload rejects", test_current_directory_rejects_wrong_success_payload),
        ("wrong error payload rejects", test_current_directory_rejects_wrong_error_payload),
        ("ordinary result rejects", test_current_directory_rejects_ordinary_result),
        ("pure caller rejects", test_current_directory_rejects_pure_caller),
        ("tail annotation rejects", test_current_directory_rejects_tail_annotation),
    ],
}
