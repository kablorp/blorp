---
A record or union type is one nominal application: its declaration and its
type arguments. A nongeneric declaration applies to no arguments, so its type
has exactly the form a generic declaration's type has.
---
import:
    bool: and, not
    test: TestSuite
    ../../../../src/common/analysis/check/check: check, checked_functions
    ../../../../src/common/analysis/check/model as model
    ../../../../src/common/syntax/syntax: IntegerFormat(Int64Format)
    ../../../support/module_input: parse_modules


private SOURCE: String =
    |record Point {
    |    x: Int
    |}
    |union Flag:
    |    Off
    |    On
    |union Box[T]:
    |    Box(T)
    |pure func inspect(point: Point, flag: Flag, box: Box[Int], text: Box[String]) -> Int:
    |    0
    |func main() -> Int:
    |    0
    |


-- The checked parameter types of `inspect`, the source's first function.
private pure func parameter_types() -> List[model.TypeRef]:
    match parse_modules([{ source = SOURCE, targets = [] }]):
        Err(_):
            []
        Ok(parsed):
            match check(parsed):
                Err(_):
                    []
                Ok(accepted):
                    match checked_functions(accepted).functions.get(0):
                        None:
                            []
                        Some(function):
                            function.signature.parameters.map(
                                pure func(parameter): parameter.value_type,
                            )


pure func test_nongeneric_declarations_apply_to_no_arguments() -> Bool:
    match parameter_types():
        [point, flag, box, _]:
            shapes: Bool = match (point, flag, box):
                (model.NominalType(model.AggregateNominal(model.RecordAggregate(_)), []), model.NominalType(model.AggregateNominal(model.UnionAggregate(_)), []), model.NominalType(model.AggregateNominal(model.UnionAggregate(_)), [model.IntegerType(Int64Format)])):
                    True
                _:
                    False
            and(shapes, and(point == point, flag == flag))
        _:
            False


pure func test_nominal_types_differ_by_declaration_and_arguments() -> Bool:
    match parameter_types():
        [point, flag, box, text]: and(not(point == flag), and(not(flag == box), not(box == text)))
        _: False


TESTS: TestSuite = {
    description = "Nominal type applications",
    tests = [
        (
            "a nongeneric record and union apply to no arguments and equal themselves",
            test_nongeneric_declarations_apply_to_no_arguments,
        ),
        (
            "nominal types differ by declaration and by arguments",
            test_nominal_types_differ_by_declaration_and_arguments,
        ),
    ],
}
