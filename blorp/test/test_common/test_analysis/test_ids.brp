import:
    bool: and
    int as int_ops
    test: TestSuite
    ../../../src/common/analysis/assemble: parsed_contents
    ../../../src/common/analysis/ids:
        DeclarationInventory,
        NominalRow(RecordDeclarationRow, UnionDeclarationRow),
        function_number,
        inventory_functions,
        inventory_records,
        inventory_unions,
        issue_inventory,
        next_nominal,
        record_number,
        union_number,
        variant_number,
        variant_owner
    ../../../src/common/syntax/source: module_number
    ../../../src/common/syntax/syntax: Visibility(Public, Private)
    ../../support/module_input: parse_modules
    ./declaration_inputs: sample_inventory


pure func test_declaration_ordinals_retain_their_identity_domain() -> Bool:
    inventory = sample_inventory()

    match (
        inventory_functions(inventory),
        inventory_records(inventory),
        inventory_unions(inventory)
    ):
        ([_, _, _, function], [_, _, record_row, _], [_, union_row, _, _, _]):
            and(
                int_ops.equals(function_number(function.id), 3),
                and(
                    int_ops.equals(record_number(record_row.id), 2),
                    int_ops.equals(union_number(union_row.id), 1)
                )
            )
        _:
            False


pure func test_variant_identity_retains_owner_and_position() -> Bool:
    match inventory_unions(sample_inventory()):
        [_, _, _, _, owner]:
            match owner.variants:
                [_, _, variant]:
                    and(
                        int_ops.equals(union_number(variant_owner(variant.id)), 4),
                        int_ops.equals(variant_number(variant.id), 2)
                    )
                _:
                    False
        _:
            False


pure func test_declaration_ids_are_equal_exactly_when_their_identities_are() -> Bool:
    inventory = sample_inventory()

    match (
        inventory_functions(inventory),
        inventory_records(inventory),
        inventory_unions(inventory)
    ):
        ([first_function, second_function, _, _], [first_record, second_record, _, _], [first_union, second_union, third_union, _, _]):
            match (first_union.variants, second_union.variants):
                ([first_variant, second_variant, _], [other_owner_variant, _, _]):
                    same_ordinals = and(
                        and(
                            first_function.id == first_function.id,
                            first_record.id == first_record.id
                        ),
                        first_union.id == first_union.id
                    )

                    different_ordinals = and(
                        and(
                            first_function.id != second_function.id,
                            first_record.id != second_record.id
                        ),
                        first_union.id != third_union.id
                    )

                    -- Same position under another owner, and another position under the same owner.
                    variants = and(
                        and(
                            first_variant.id == first_variant.id,
                            first_variant.id != second_variant.id
                        ),
                        first_variant.id != other_owner_variant.id
                    )

                    and(
                        and(same_ordinals, different_ordinals),
                        and(variants, second_union.id != first_union.id)
                    )
                _:
                    False
        _:
            False


pure func test_inventory_is_dense_in_each_domain_across_modules() -> Bool:
    inventory = sample_inventory()
    functions = inventory_functions(inventory)
    records = inventory_records(inventory)
    unions = inventory_unions(inventory)
    var variants_correct: Bool = True

    for row in unions:
        if variants_correct:
            variants_correct = match row.variants.map(
                pure func(variant): variant_number(variant.id)
            ):
                [first_ordinal, second_ordinal, third_ordinal]:
                    if and(
                        int_ops.equals(first_ordinal, 0),
                        and(int_ops.equals(second_ordinal, 1), int_ops.equals(third_ordinal, 2))
                    ):
                        row.variants.all(
                            pure func(variant): int_ops.equals(
                                union_number(variant_owner(variant.id)),
                                union_number(row.id)
                            )
                        )
                    else:
                        False
                _:
                    False

    correct: Bool = match (
        functions.map(pure func(row): function_number(row.id)),
        records.map(pure func(row): record_number(row.id)),
        unions.map(pure func(row): union_number(row.id))
    ):
        ([first_function, second_function, third_function, fourth_function], [first_record, second_record, third_record, fourth_record], [first_union, second_union, third_union, fourth_union, fifth_union]):
            and(
                and(
                    int_ops.equals(first_function, 0),
                    and(
                        int_ops.equals(second_function, 1),
                        and(int_ops.equals(third_function, 2), int_ops.equals(fourth_function, 3))
                    )
                ),
                and(
                    and(
                        int_ops.equals(first_record, 0),
                        and(
                            int_ops.equals(second_record, 1),
                            and(int_ops.equals(third_record, 2), int_ops.equals(fourth_record, 3))
                        )
                    ),
                    and(
                        and(
                            int_ops.equals(first_union, 0),
                            and(
                                int_ops.equals(second_union, 1),
                                and(
                                    int_ops.equals(third_union, 2),
                                    int_ops.equals(fourth_union, 3)
                                )
                            )
                        ),
                        and(int_ops.equals(fifth_union, 4), variants_correct)
                    )
                )
            )
        _:
            False

    match (functions.get(2), records.get(2), unions.get(2)):
        (Some(function), Some(record_row), Some(union_row)):
            and(
                correct,
                and(
                    int_ops.equals(module_number(function.declaration.module), 2),
                    and(
                        int_ops.equals(module_number(record_row.declaration.module), 2),
                        int_ops.equals(module_number(union_row.module), 2)
                    )
                )
            )
        _:
            False


pure func test_empty_inventory_has_no_rows_or_nominal_successor() -> Bool:
    inventory = issue_inventory([], [], [], [], [])

    and(
        inventory_functions(inventory).is_empty(),
        and(
            inventory_records(inventory).is_empty(),
            and(inventory_unions(inventory).is_empty(), next_nominal(inventory, 0, 0).is_none())
        )
    )


pure func test_nominal_projection_preserves_module_and_source_order() -> Bool:
    inventory = sample_inventory()
    var records_seen = 0
    var unions_seen = 0
    var sequence: List[String] = []

    for _ in [0, 1, 2, 3, 4, 5, 6, 7, 8]:
        match next_nominal(inventory, records_seen, unions_seen):
            Some(RecordDeclarationRow(row)):
                sequence = sequence.append("record" + record_number(row.id).to_string())
                records_seen = records_seen + 1
            Some(UnionDeclarationRow(row)):
                sequence = sequence.append("union" + union_number(row.id).to_string())
                unions_seen = unions_seen + 1
            None:
                sequence = sequence.append("missing")

    match sequence:
        ["record0", "union0", "record1", "union1", "union2", "record2", "union3", "record3", "union4"]:
            next_nominal(inventory, records_seen, unions_seen).is_none()
        _:
            False


private pure func is_private(visibility: Visibility) -> Bool:
    match visibility:
        Private(_): True
        Public: False


-- A variant's effective privacy is its own mark, or else its union's: an
-- unmarked variant of a public union is public, and of a private union private.
pure func test_a_variants_privacy_is_its_mark_or_else_its_unions() -> Bool:
    source: String =
        |union Email:
        |    private Checked(String)
        |    Unchecked(String)
        |private union Step:
        |    Stay
        |func main() -> Int:
        |    0
        |

    match parse_modules([{ source = source, targets = [] }]):
        Err(_):
            False
        Ok(parsed):
            unions = parsed_contents(parsed).declarations.inventory_unions()

            match (unions.get(0), unions.get(1)):
                (Some(email), Some(step)):
                    match (email.variants, step.variants):
                        ([checked, unchecked], [stay]):
                            and(
                                and(
                                    checked.visibility.is_private(),
                                    unchecked.visibility
                                        .is_private()
                                        .not()
                                ),
                                stay.visibility.is_private()
                            )
                        _:
                            False
                _:
                    False


TESTS: TestSuite = {
    description = "Blorp declaration identities",
    tests = [
        (
            "declaration ordinals retain their identity domain",
            test_declaration_ordinals_retain_their_identity_domain
        ),
        (
            "a variant's privacy is its mark or else its union's",
            test_a_variants_privacy_is_its_mark_or_else_its_unions
        ),
        (
            "variant identity retains owner and position",
            test_variant_identity_retains_owner_and_position
        ),
        (
            "declaration IDs are equal exactly when their identities are",
            test_declaration_ids_are_equal_exactly_when_their_identities_are
        ),
        (
            "inventory is dense across modules and domains",
            test_inventory_is_dense_in_each_domain_across_modules
        ),
        (
            "empty inventory has no rows or successor",
            test_empty_inventory_has_no_rows_or_nominal_successor
        ),
        (
            "nominal projection preserves module and source order",
            test_nominal_projection_preserves_module_and_source_order
        )
    ]
}
