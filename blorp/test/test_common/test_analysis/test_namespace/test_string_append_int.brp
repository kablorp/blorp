import:
    test: TestSuite
    ../../../../src/common/analysis/namespace/builtins as builtins
    ../../../../src/common/syntax/syntax:
        Purity(Pure),
        ParsedRuntimeOperation(StringAppendIntBuiltin),


pure func test_append_contract_is_pure_string_and_int_to_string() -> Bool:
    operation: builtins.RuntimeOperation[Int, Int] = builtins.StringAppendInt
    contract = builtins.runtime_contract(operation)
    match (contract.purity, contract.parameters, contract.return_type):
        (Pure, [builtins.PrimitiveRuntimeType(builtins.BuiltinString), builtins.PrimitiveRuntimeType(builtins.BuiltinInt)], builtins.ValueResult(builtins.PrimitiveRuntimeType(builtins.BuiltinString))):
            True
        _:
            False


pure func test_parsed_append_selects_the_typed_operation() -> Bool:
    operation: Option[builtins.RuntimeOperation[String, Int]] = builtins.primitive_operation(
        StringAppendIntBuiltin,
    )
    match operation:
        Some(builtins.StringAppendInt): True
        _: False


TESTS: TestSuite = {
    description = "Blorp integer append runtime contract",
    tests = [
        (
            "pure nongeneric String and Int contract returns String",
            test_append_contract_is_pure_string_and_int_to_string,
        ),
        (
            "parsed builtin selects typed runtime operation",
            test_parsed_append_selects_the_typed_operation,
        ),
    ],
}
