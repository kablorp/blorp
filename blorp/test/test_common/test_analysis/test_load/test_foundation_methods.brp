import:
    test: TestSuite
    ../../../../src/common/analysis/load/load:
        LibrarySource(LibraryDirectory),
        SourceLoadFailure(LoadingFailed),
        load_program,
        load_program_with_sources
    ../../../../src/common/syntax/source: ModuleId, ModuleSource, root_module_id
    ../../../support/loader_rows: absolute, module_of


-- The loader reads `_methods.brp` as the third foundation input. Library
-- modules receive its selections, so no module may import it, it is never an
-- application root, and a module it imports cannot reach a library module
-- that receives it.
private LIBRARY_ROOT: String = "blorp/standard_library"


private ROOT: String = "build/foundation-methods/main.brp"


private IMPORT_CYCLE_HELP: String = "move the declarations both modules need into a third module that both import"


func test_an_explicit_methods_import_is_rejected() -> Bool:
    contents = "import:\n    _methods: unused\n"
    match load_program_with_sources(ROOT, LibraryDirectory(LIBRARY_ROOT), [
        { path = ROOT, contents = contents }
    ]):
        Err(LoadingFailed(failure)):
            error = failure.diagnostic
            (error.message == "_methods cannot be imported explicitly")
                .and(
                    (
                        error.help
                        == "remove this import; library modules receive its methods automatically"
                    )
                )
                .and(
                    (
                        error.span
                        == { source = root_module_id().module_source(), start = 12, end = 28 }
                    )
                )
        _:
            False


func test_the_methods_module_is_not_an_application_root() -> Bool:
    match load_program(LIBRARY_ROOT + "/_methods.brp", LibraryDirectory(LIBRARY_ROOT)):
        Err(failure):
            error = failure.diagnostic
            (error.message == "foundation modules cannot be application roots")
                .and(
                    (
                        error.help
                        == "choose an application module; foundation inputs come from the standard library"
                    )
                )
                .and(
                    error.span == { source = root_module_id().module_source(), start = 0, end = 0 }
                )
        _:
            False


-- `option` is one of the modules `_methods` imports, so it does not receive
-- `_methods`. When it imports `order`, which does, the three close a cycle.
-- The edge that closes it is `order`'s implicit one, so the cycle is reported
-- at the end of `order`, as a cycle through the prelude would be.
func test_a_member_importing_a_receiving_module_closes_a_cycle() -> Bool:
    option = LIBRARY_ROOT + "/option.brp"
    contents = "import:\n    _base: Option()\n    order: max\n"
    match load_program_with_sources(ROOT, LibraryDirectory(LIBRARY_ROOT), [
        { path = ROOT, contents = "func main() -> Int:\n    0\n" },
        { path = option, contents = contents }
    ]):
        Err(LoadingFailed(failure)):
            error = failure.diagnostic
            methods = absolute(LIBRARY_ROOT + "/_methods.brp")
            order = absolute(LIBRARY_ROOT + "/order.brp")
            rows = failure.sources.modules
            match rows.module_of(order):
                Some(id):
                    order_length = rows
                        .get(id.module_number())
                        .map(pure func(row: ModuleSource) -> Int: row.contents.length())
                        .get_or(0)
                    (error.message == "import cycle: ${methods} -> ${absolute(option)} -> ${order} -> ${methods}")
                        .and(error.help == IMPORT_CYCLE_HELP)
                        .and(
                            (
                                error.span
                                == {
                                    source = id.module_source(),
                                    start = order_length,
                                    end = order_length
                                }
                            )
                        )
                None:
                    False
        _:
            False


TESTS: TestSuite = {
    description = "the foundation methods module in the loader",
    tests = [
        ("an explicit methods import is rejected", test_an_explicit_methods_import_is_rejected),
        (
            "the methods module is not an application root",
            test_the_methods_module_is_not_an_application_root
        ),
        (
            "a member importing a receiving module closes a cycle",
            test_a_member_importing_a_receiving_module_closes_a_cycle
        )
    ]
}
