import:
    bool: and
    option: get_or
    test: TestSuite
    ../../../../src/common/syntax/lex: lex
    ../../../../src/common/syntax/names: name_spelling, program_names
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../src/common/syntax/syntax: TokenKind(IdentifierToken)
    ../../../../src/common/utils/text as text_utils: concat


private pure func opener() -> String:
    text_utils.concat("$", "{")


pure func test_quoted_hole_identifiers_use_the_normal_name_table() -> Bool:
    source = "\"a"
        .concat(opener())
        .concat("value}b\"")
    match lex(module_source(root_module_id()), source, program_names().names):
        Err(_):
            False
        Ok(program):
            var found: Bool = False
            for token in program.tokens:
                match token.kind:
                    IdentifierToken(id, _):
                        found = and(
                            name_spelling(program.names, id) == Some("value"),
                            and(token.span.start == 4, token.span.end == 9),
                        )
                    _:
                        void
            found


pure func test_pipe_holes_keep_original_line_offsets() -> Bool:
    source = "|a"
        .concat(opener())
        .concat("value}\n|b")
        .concat(opener())
        .concat("other}")
    match lex(module_source(root_module_id()), source, program_names().names):
        Err(_):
            False
        Ok(program):
            var names: List[String] = []
            var starts: List[Int] = []
            for token in program.tokens:
                match token.kind:
                    IdentifierToken(id, _):
                        names = names.append(name_spelling(program.names, id).get_or(""))
                        starts = starts.append(token.span.start)
                    _:
                        void
            and(names == ["value", "other"], starts == [4, 15])


TESTS: TestSuite = {
    description = "Blorp interpolation token boundaries",
    tests = [
        (
            "quoted hole identifiers use the normal name table",
            test_quoted_hole_identifiers_use_the_normal_name_table,
        ),
        ("pipe holes keep original line offsets", test_pipe_holes_keep_original_line_offsets),
    ],
}
