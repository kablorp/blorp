import:
    string as string_ops
    test: TestSuite
    ../../../../src/common/syntax/lex: lex
    ../../../../src/common/syntax/names: name_spelling, program_names
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../src/common/syntax/syntax: LexedProgram, TokenKind(IdentifierToken)
    ../../../../src/common/utils/text as text_utils: concat
    ./test_lex: program_trace, span_text


-- The host reads `${` in a quoted String as interpolation; the source under
-- test is built from two halves.
private pure func opener() -> String:
    text_utils.concat("$", "{")


-- Each comment of a program as `comment@start:end`, one per line.
private pure func comments_trace(program: LexedProgram) -> String:
    var text: String = ""

    for comment in program.comments:
        text = ((text + "comment@") + span_text(comment.span)) + "\n"

    text


-- A lexed program's tokens and comments, as traces.
private pure func program_text(program: LexedProgram) -> String:
    text_utils.concat(program_trace(program), "\n").concat(comments_trace(program))


-- A rejected source as its message, then the prefix lexed before the error;
-- a source that lexes as `lexed`, then the program.
private pure func outcome_of(source: String) -> String:
    match lex(module_source(root_module_id()), source, program_names().names):
        Err(failure):
            "error: "
                .concat(failure.error.message)
                .concat("\n")
                .concat(program_text(failure.prefix))
        Ok(program):
            "lexed\n".concat(program_text(program))


pure func test_unclosed_string_keeps_the_tokens_before_it() -> Bool:
    string_ops.equals(
        outcome_of("a = 1\nb = \"abc"),
        "error: unterminated String literal\nname=a@0:1\n=@2:3\ninteger=1@4:5\nLF@5:6\nname=b@6:7\n=@8:9\nEOF@14:14\n",
    )


pure func test_unclosed_interpolation_hole_keeps_no_string_or_hole_token() -> Bool:
    source = "x = 1\ny = \"a"
        .concat(opener())
        .concat("b")
    string_ops.equals(
        outcome_of(source),
        "error: unterminated interpolation hole\nname=x@0:1\n=@2:3\ninteger=1@4:5\nLF@5:6\nname=y@6:7\n=@8:9\nEOF@15:15\n",
    )


pure func test_pipe_string_with_a_bad_hole_keeps_only_the_tokens_before_it() -> Bool:
    source = "x = 1\n|a"
        .concat(opener())
        .concat("b\n")
    string_ops.equals(
        outcome_of(source),
        "error: unterminated interpolation hole\nname=x@0:1\n=@2:3\ninteger=1@4:5\nLF@5:6\nEOF@12:12\n",
    )


pure func test_bad_indentation_keeps_the_comment_line_skipped_before_it() -> Bool:
    string_ops.equals(
        outcome_of("f:\n\tx = 1\n-- kept\n\t  y"),
        "error: invalid indentation\nname=f@0:1\n:@1:2\nLF@2:3\nINDENT@3:4\nname=x@4:5\n=@6:7\ninteger=1@8:9\nLF@9:10\nEOF@22:22\ncomment@10:17\n",
    )


pure func test_a_comment_before_a_bad_first_line_is_kept() -> Bool:
    string_ops.equals(
        outcome_of("-- kept\n\t  x = 1"),
        "error: invalid indentation\nEOF@16:16\ncomment@0:7\n",
    )


pure func test_an_unterminated_doc_block_keeps_the_comments_before_it() -> Bool:
    string_ops.equals(
        outcome_of("a = 1\n-- kept\n---\nunclosed"),
        "error: unterminated documentation block\nname=a@0:1\n=@2:3\ninteger=1@4:5\nLF@5:6\nEOF@26:26\ncomment@6:13\n",
    )


pure func test_trailing_comment_is_kept_when_the_next_line_fails() -> Bool:
    string_ops.equals(
        outcome_of("a = 1 -- note\nb = \"x"),
        "error: unterminated String literal\nname=a@0:1\n=@2:3\ninteger=1@4:5\nLF@13:14\nname=b@14:15\n=@16:17\nEOF@20:20\ncomment@6:13\n",
    )


pure func test_prefix_identifiers_are_interned_in_the_prefix_names() -> Bool:
    match lex(module_source(root_module_id()), "ab = cd\nab = \"x", program_names().names):
        Ok(_):
            False
        Err(failure):
            var spellings: List[String] = []
            for token in failure.prefix.tokens:
                match token.kind:
                    IdentifierToken(id, _):
                        match name_spelling(failure.prefix.names, id):
                            Some(name): spellings = spellings.append(name)
                            None: spellings = spellings.append("?")
                    _:
                        void

            string_ops.equals(spellings.join(","), "ab,cd,ab")


pure func test_a_source_that_lexes_is_still_ok() -> Bool:
    string_ops.equals(
        outcome_of("a = 1 -- note\nb"),
        "lexed\nname=a@0:1\n=@2:3\ninteger=1@4:5\nLF@13:14\nname=b@14:15\nLF@15:15\nEOF@15:15\ncomment@6:13\n",
    )


TESTS: TestSuite = {
    description = "Blorp lexer failure prefix",
    tests = [
        (
            "unclosed string keeps the tokens before it",
            test_unclosed_string_keeps_the_tokens_before_it,
        ),
        (
            "unclosed interpolation hole keeps no string or hole token",
            test_unclosed_interpolation_hole_keeps_no_string_or_hole_token,
        ),
        (
            "pipe string with a bad hole keeps only the tokens before it",
            test_pipe_string_with_a_bad_hole_keeps_only_the_tokens_before_it,
        ),
        (
            "bad indentation keeps the comment line skipped before it",
            test_bad_indentation_keeps_the_comment_line_skipped_before_it,
        ),
        (
            "a comment before a bad first line is kept",
            test_a_comment_before_a_bad_first_line_is_kept,
        ),
        (
            "an unterminated doc block keeps the comments before it",
            test_an_unterminated_doc_block_keeps_the_comments_before_it,
        ),
        (
            "trailing comment is kept when the next line fails",
            test_trailing_comment_is_kept_when_the_next_line_fails,
        ),
        (
            "prefix identifiers are interned in the prefix names",
            test_prefix_identifiers_are_interned_in_the_prefix_names,
        ),
        ("a source that lexes is still Ok", test_a_source_that_lexes_is_still_ok),
    ],
}
