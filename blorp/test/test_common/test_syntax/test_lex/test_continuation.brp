import:
    int as int_ops
    string as string_ops
    test: TestSuite
    ../../../../src/common/syntax/lex: lex
    ../../../../src/common/syntax/names: program_names
    ../../../../src/common/syntax/source: module_source, root_module_id
    ./test_lex: trace


-- Inside an open bracket a line break and the next line's indentation are
-- not layout: no Newline, Indent or Dedent is produced until the bracket
-- depth returns to zero.
pure func test_line_break_inside_parentheses_produces_no_layout_tokens() -> Bool:
    string_ops.equals(
        trace("f(\n1,\n2)"),
        "name=f@0:1\n(@1:2\ninteger=1@3:4\n,@4:5\ninteger=2@6:7\n)@7:8\nLF@8:8\nEOF@8:8",
    )


pure func test_indentation_inside_brackets_is_not_layout() -> Bool:
    string_ops.equals(
        trace("f(\n\t\t\t1\n)"),
        "name=f@0:1\n(@1:2\ninteger=1@6:7\n)@8:9\nLF@9:9\nEOF@9:9",
    )


pure func test_mixed_indentation_inside_brackets_is_accepted() -> Bool:
    string_ops.equals(
        trace("f(\n \t1)"),
        "name=f@0:1\n(@1:2\ninteger=1@5:6\n)@6:7\nLF@7:7\nEOF@7:7",
    )


pure func test_blank_and_comment_lines_inside_brackets_are_trivia() -> Bool:
    string_ops.equals(
        trace("f( -- open\n\n\t-- inside\n1)"),
        "name=f@0:1\n(@1:2\ninteger=1@23:24\n)@24:25\nLF@25:25\nEOF@25:25",
    )


pure func test_every_bracket_kind_counts_toward_depth() -> Bool:
    string_ops.equals(
        trace("{\n[\n(\n0\n)\n]\n}"),
        "{@0:1\n[@2:3\n(@4:5\ninteger=0@6:7\n)@8:9\n]@10:11\n}@12:13\nLF@13:13\nEOF@13:13",
    )


pure func test_layout_resumes_after_the_closing_bracket() -> Bool:
    string_ops.equals(
        trace("f(\n1)\n\tx"),
        "name=f@0:1\n(@1:2\ninteger=1@3:4\n)@4:5\nLF@5:6\nINDENT@6:7\nname=x@7:8\nLF@8:8\nDEDENT@8:8\nEOF@8:8",
    )


pure func test_closing_bracket_at_depth_zero_keeps_layout() -> Bool:
    string_ops.equals(trace(")\nx"), ")@0:1\nLF@1:2\nname=x@2:3\nLF@3:3\nEOF@3:3")


pure func test_unclosed_bracket_ends_at_eof_without_dedent_errors() -> Bool:
    string_ops.equals(trace("f(\n\t1"), "name=f@0:1\n(@1:2\ninteger=1@4:5\nLF@5:5\nEOF@5:5")


-- As on any line, a `|` first on a continuation line starts a pipe String;
-- the host reads a pipe String argument the same way.
pure func test_bar_first_on_a_continuation_line_starts_a_pipe_string() -> Bool:
    string_ops.equals(
        trace("f(\n\t|a\n\t|b\n)"),
        "name=f@0:1\n(@1:2\npipe=a\nb@4:10\n)@11:12\nLF@12:12\nEOF@12:12",
    )


pure func test_fence_inside_brackets_is_rejected() -> Bool:
    match lex(module_source(root_module_id()), "f(\n---\ndoc\n---\n1)", program_names().names):
        Ok(_):
            False
        Err(failure):
            match int_ops.equals(failure.error.span.start, 3):
                False:
                    False
                True:
                    match int_ops.equals(failure.error.span.end, 6):
                        False:
                            False
                        True:
                            match string_ops.equals(
                                failure.error.message,
                                "documentation block inside brackets",
                            ):
                                False:
                                    False
                                True:
                                    string_ops.equals(
                                        failure.error.help,
                                        "close the bracket before the --- fence, or put the block before a declaration",
                                    )


-- A block lambda in a call: the `:` that ends a line inside brackets opens a block,
-- and the `)` on its own line at the base closes it with DEDENT first.
pure func test_colon_ending_a_line_inside_brackets_opens_a_block() -> Bool:
    string_ops.equals(
        trace("f(func(x):\n\ty\n)\nz\n"),
        "name=f@0:1\n(@1:2\nfunc@2:6\n(@6:7\nname=x@7:8\n)@8:9\n:@9:10\nLF@10:11\nINDENT@11:12\nname=y@12:13\nLF@13:14\nDEDENT@14:14\n)@14:15\nLF@15:16\nname=z@16:17\nLF@17:18\nEOF@18:18",
    )


-- A closing bracket on the block's last line stays inside the block; the DEDENT
-- comes with the next line.
pure func test_closing_bracket_does_not_close_the_block() -> Bool:
    string_ops.equals(
        trace("f(func(x):\n\tx)\nz\n"),
        "name=f@0:1\n(@1:2\nfunc@2:6\n(@6:7\nname=x@7:8\n)@8:9\n:@9:10\nLF@10:11\nINDENT@11:12\nname=x@12:13\n)@13:14\nLF@14:15\nDEDENT@15:15\nname=z@15:16\nLF@16:17\nEOF@17:17",
    )


-- A closing bracket on a nested block's last line leaves the bracket depth below
-- the nested block's group, so the next line breaks are trivia until a dedent
-- closes both blocks.
pure func test_closing_bracket_on_a_nested_last_line_suspends_layout() -> Bool:
    string_ops.equals(
        trace("f(func(x):\n\tg(func(y):\n\t\ty)\n\tx)\nz\n"),
        "name=f@0:1\n(@1:2\nfunc@2:6\n(@6:7\nname=x@7:8\n)@8:9\n:@9:10\nLF@10:11\nINDENT@11:12\nname=g@12:13\n(@13:14\nfunc@14:18\n(@18:19\nname=y@19:20\n)@20:21\n:@21:22\nLF@22:23\nINDENT@23:25\nname=y@25:26\n)@26:27\nname=x@29:30\n)@30:31\nLF@31:32\nDEDENT@32:32\nDEDENT@32:32\nname=z@32:33\nLF@33:34\nEOF@34:34",
    )


-- After a block closes, the enclosing brackets are still open, so line breaks
-- there are trivia again until the bracket closes.
pure func test_breaks_are_trivia_again_after_the_block_closes() -> Bool:
    string_ops.equals(
        trace("f(func(x):\n\tx\n, 1\n, 2)\n"),
        "name=f@0:1\n(@1:2\nfunc@2:6\n(@6:7\nname=x@7:8\n)@8:9\n:@9:10\nLF@10:11\nINDENT@11:12\nname=x@12:13\nLF@13:14\nDEDENT@14:14\n,@14:15\ninteger=1@16:17\n,@18:19\ninteger=2@20:21\n)@21:22\nLF@22:23\nEOF@23:23",
    )


-- A line at the block's bracket depth indented strictly between the block's base
-- and its level closes the block, with no INDENT of its own.
pure func test_line_between_base_and_block_level_closes_the_block() -> Bool:
    string_ops.equals(
        trace("f(func(x):\n\t\t\ty\n\t)\n"),
        "name=f@0:1\n(@1:2\nfunc@2:6\n(@6:7\nname=x@7:8\n)@8:9\n:@9:10\nLF@10:11\nINDENT@11:14\nname=y@14:15\nLF@15:16\nDEDENT@16:17\n)@17:18\nLF@18:19\nEOF@19:19",
    )


-- The end of the input closes an open bracketed block like any level.
pure func test_end_of_input_closes_an_open_block() -> Bool:
    string_ops.equals(
        trace("f(func(x):\n\tx"),
        "name=f@0:1\n(@1:2\nfunc@2:6\n(@6:7\nname=x@7:8\n)@8:9\n:@9:10\nLF@10:11\nINDENT@11:12\nname=x@12:13\nLF@13:13\nDEDENT@13:13\nEOF@13:13",
    )


TESTS: TestSuite = {
    description = "Blorp bracket continuation lines",
    tests = [
        (
            "line break inside parentheses produces no layout tokens",
            test_line_break_inside_parentheses_produces_no_layout_tokens,
        ),
        (
            "indentation inside brackets is not layout",
            test_indentation_inside_brackets_is_not_layout,
        ),
        (
            "mixed indentation inside brackets is accepted",
            test_mixed_indentation_inside_brackets_is_accepted,
        ),
        (
            "blank and comment lines inside brackets are trivia",
            test_blank_and_comment_lines_inside_brackets_are_trivia,
        ),
        ("every bracket kind counts toward depth", test_every_bracket_kind_counts_toward_depth),
        ("layout resumes after the closing bracket", test_layout_resumes_after_the_closing_bracket),
        (
            "closing bracket at depth zero keeps layout",
            test_closing_bracket_at_depth_zero_keeps_layout,
        ),
        (
            "unclosed bracket ends at EOF without dedent errors",
            test_unclosed_bracket_ends_at_eof_without_dedent_errors,
        ),
        (
            "bar first on a continuation line starts a pipe string",
            test_bar_first_on_a_continuation_line_starts_a_pipe_string,
        ),
        ("fence inside brackets is rejected", test_fence_inside_brackets_is_rejected),
        (
            "colon ending a line inside brackets opens a block",
            test_colon_ending_a_line_inside_brackets_opens_a_block,
        ),
        ("closing bracket does not close the block", test_closing_bracket_does_not_close_the_block),
        (
            "closing bracket on a nested last line suspends layout",
            test_closing_bracket_on_a_nested_last_line_suspends_layout,
        ),
        (
            "breaks are trivia again after the block closes",
            test_breaks_are_trivia_again_after_the_block_closes,
        ),
        (
            "line between base and block level closes the block",
            test_line_between_base_and_block_level_closes_the_block,
        ),
        ("end of input closes an open block", test_end_of_input_closes_an_open_block),
    ],
}
