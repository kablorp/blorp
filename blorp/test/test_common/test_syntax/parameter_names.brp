import:
    ../../../src/common/syntax/names: NameId
    ../../../src/common/syntax/syntax: ParsedBinder(NamedBinder, DiscardBinder), ParsedParameter


-- The name a parameter binds, or None for a `_` discard, which binds none.
pure func parameter_id(parameter: ParsedParameter) -> Option[NameId]:
    match parameter.binder:
        NamedBinder(name): Some(name.id)
        DiscardBinder(_): None
