import:
    bool: Bool methods
    list: List methods
    option: Option methods
    test: TestSuite
    ../../../../src/common/analysis/assemble: parsed_contents
    ../../../../src/common/analysis/ids: inventory_functions
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../src/common/syntax/syntax:
        ParsedBody(ParsedBuiltinBody),
        ParsedRuntimeOperation(
            StringByteLengthBuiltin,
            StringByteSliceBuiltin,
            StringCodepointLengthBuiltin,
            StringCodepointSliceBuiltin,
            StringCodepointAtBuiltin,
        ),
    ../../../support/module_input: parse_modules


private BUILTIN_LABEL_HELP: String = "use system.current_directory, process.capture, process.run, process.find_program, process.fault, process.exit_interrupted, fs.read_text, fs.read_bytes, fs.write_text, fs.write_bytes, fs.entry_kind, fs.list_directory, fs.create_directory, fs.create_directories, fs.remove_file, fs.remove_directory, fs.rename, fs.remove_directory_tree, fs.create_temporary_directory, fs.open_read, fs.next_lines, fs.close, int.equals, int.less_than, int.add, int.subtract, int.multiply, int.divide, int.remainder, int.to_string, int.wrap_to_uint8, uint8.equals, uint8.less_than, uint8.add, uint8.subtract, uint8.multiply, uint8.divide, uint8.remainder, uint8.to_string, uint8.to_int, float.add, float.subtract, float.multiply, float.divide, float.remainder, float.to_string, float.copysign, float.equals, float.less_than, string.length, string.add, string.append_int, string.print, string.print_error, string.parse_int, string.parse_float, string.byte_at, string.byte_at_uint8, string.from_codepoint, string.slice, string.byte_length, string.byte_slice, string.codepoint_length, string.codepoint_slice, string.codepoint_at, string.equals, string.to_bytes, bytes.to_text, list.repeat, list.length, list.get, list.append, list.set or list.concat"


-- The parser reads only the label, so one declaration shape serves every label.
private HEADER: String = "pure func operation(value: String) -> Int:\n    builtin("


private pure func source_for(label: String) -> String:
    "${HEADER}\"${label}\")\n"


private pure func parses_to(label: String, expected: ParsedRuntimeOperation) -> Bool:
    match parse_modules([{ source = source_for(label), targets = [] }]):
        Err(_):
            False
        Ok(program):
            match inventory_functions(parsed_contents(program).declarations).get(0):
                Some(row):
                    match row.declaration.body:
                        ParsedBuiltinBody(operation, _): operation == expected
                        _: False
                None:
                    False


pure func test_each_unit_label_names_its_own_operation() -> Bool:
    parses_to("string.byte_length", StringByteLengthBuiltin)
        .and(parses_to("string.byte_slice", StringByteSliceBuiltin))
        .and(parses_to("string.codepoint_length", StringCodepointLengthBuiltin))
        .and(parses_to("string.codepoint_slice", StringCodepointSliceBuiltin))
        .and(parses_to("string.codepoint_at", StringCodepointAtBuiltin))


-- "codepoint" is one word, as in from_codepoint; the two-word spelling is
-- refused where it is written, and the help lists every label.
pure func test_a_two_word_codepoint_label_is_rejected() -> Bool:
    label = "\"string.code_point_length\""
    match parse_modules([{ source = source_for("string.code_point_length"), targets = [] }]):
        Ok(_):
            False
        Err(error):
            (error.message == "unknown builtin operation")
                .and(error.help == BUILTIN_LABEL_HELP)
                .and(error.span.source == module_source(root_module_id()))
                .and(error.span.start == HEADER.length())
                .and(error.span.end == HEADER.length() + label.length())
                .and(error.note.is_none())


TESTS: TestSuite = {
    description = "String byte and code point labels",
    tests = [
        ("each unit label names its own operation", test_each_unit_label_names_its_own_operation),
        (
            "a two-word codepoint label is rejected with every label",
            test_a_two_word_codepoint_label_is_rejected,
        ),
    ],
}
