import:
    int as int_ops
    string as string_ops
    test: TestSuite
    ../../../../src/common/analysis/assemble: parsed_contents
    ../../../../src/common/analysis/ids: inventory_functions
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../src/common/syntax/syntax:
        ParsedBody(ParsedBuiltinBody),
        ParsedRuntimeOperation(StringSliceBuiltin),
    ../../../support/module_input: parse_modules


func test_slice_builtin_label_is_accepted() -> Bool:
    source: String =
        |pure func slice_text(value: String, start: Int, end: Int) -> Option[String]:
        |    builtin("string.slice")
        |func main() -> Int:
        |    0
        |
    match parse_modules([{ source = source, targets = [] }]):
        Err(error):
            print_error(error.message)
            print_error(error.help)
            print_error(
                (int_ops.to_string(error.span.start) + "..") + int_ops.to_string(error.span.end),
            )
            False
        Ok(program):
            match inventory_functions(parsed_contents(program).declarations).get(0):
                Some(row):
                    match row.declaration.body:
                        ParsedBuiltinBody(StringSliceBuiltin, span):
                            match span.source == module_source(root_module_id()):
                                False:
                                    False
                                True:
                                    match int_ops.equals(span.start, 89):
                                        False: False
                                        True: int_ops.equals(span.end, 103)
                        _:
                            False
                None:
                    False


TESTS: TestSuite = {
    description = "Checked String slice label acceptance",
    tests = [
        (
            "string.slice accepts the checked slice declaration",
            test_slice_builtin_label_is_accepted,
        ),
    ],
}
