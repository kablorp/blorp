import:
    int as int_ops
    string as string_ops
    test: TestSuite
    ../../../../src/common/analysis/assemble: parsed_contents
    ../../../../src/common/analysis/ids: inventory_functions
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../src/common/syntax/syntax:
        ParsedBody(ParsedBuiltinBody),
        ParsedRuntimeOperation(StringConcatBuiltin),
    ../../../support/module_input: parse_modules


func test_string_add_label_is_accepted_at_its_exact_span() -> Bool:
    header = "pure func concatenate(left: String, right: String) -> String:\n    builtin("
    source: String =
        |pure func concatenate(left: String, right: String) -> String:
        |    builtin("string.add")
        |func main() -> Int:
        |    0
        |
    match parse_modules([{ source = source, targets = [] }]):
        Err(error):
            print_error((error.message + "\nhelp: ") + error.help)
            print_error(
                (int_ops.to_string(error.span.start) + "..") + int_ops.to_string(error.span.end),
            )
            False
        Ok(program):
            match inventory_functions(parsed_contents(program).declarations).get(0):
                Some(row):
                    match row.declaration.body:
                        ParsedBuiltinBody(StringConcatBuiltin, at):
                            match at.source == module_source(root_module_id()):
                                False:
                                    False
                                True:
                                    match int_ops.equals(at.start, string_ops.length(header)):
                                        False:
                                            False
                                        True:
                                            int_ops.equals(
                                                at.end,
                                                (
                                                    string_ops.length(header)
                                                    + string_ops.length("\"string.add\"")
                                                ),
                                            )
                        _:
                            False
                None:
                    False


TESTS: TestSuite = {
    description = "Blorp String concat label acceptance",
    tests = [
        (
            "string.add accepts its quoted operation span",
            test_string_add_label_is_accepted_at_its_exact_span,
        ),
    ],
}
