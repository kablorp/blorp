-- One module parsed on its own, and the parser's rejection of a source whose
-- expected span is marked, for the variant binding and resource union suites.
import:
    bool: and
    ../../../../src/common/syntax/lex: lex
    ../../../../src/common/syntax/names: program_names
    ../../../../src/common/syntax/parse: ParsedModule, parse_module
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../src/common/syntax/syntax: Diagnostic
    ../../../support/text_search: find_text


pure func parsed(source: String) -> Result[ParsedModule, Diagnostic]:
    match lex(module_source(root_module_id()), source, program_names().names):
        Err(failure): Err(failure.error)
        Ok(tokens): parse_module(tokens, root_module_id())


-- `marked` writes the source with its expected span between `[[` and `]]`,
-- which the parsed source omits. The parser rejects it there, in the root
-- module, with this message and help and no note.
pure func parse_rejects(marked: String, message: String, help: String) -> Bool:
    open = find_text(marked, "[[", 0).get_or(0)
    close = find_text(marked, "]]", open).get_or(0)

    prefix = marked
        .slice(0, open)
        .get_or("")

    span_text = marked
        .slice(open + 2, close)
        .get_or("")

    source = (
        prefix
        + span_text
        + marked
            .slice(close + 2, marked.length())
            .get_or("")
    )

    match parsed(source):
        Ok(_):
            False
        Err(error):
            and(
                and(
                    and(
                        error.span.source == module_source(root_module_id()),
                        error.span.start == prefix.length()
                    ),
                    error.span.end == open + span_text.length()
                ),
                and(and(error.message == message, error.help == help), error.note.is_none())
            )
