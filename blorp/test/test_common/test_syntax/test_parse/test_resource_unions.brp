---
`resource union` declares a resource (rule 9, decision 1). The parser checks
its shape, which one declaration decides: no type parameters, and exactly one
variant, private by its mark or through a private union, with exactly one
payload. Breaking any of these, or several at once, is one error at the
union's name. Each rejection marks that span with `[[` and `]]`.
---
import:
    test: TestSuite
    ../../../../src/common/syntax/parse: module_contents
    ../../../../src/common/syntax/syntax: ParsedUnion, UnionKind(ResourceUnion)
    ./parse_rejection: parse_rejects, parsed


private SHAPE: String = "a resource union has no type parameters and exactly one private variant with one payload"


private PUBLIC_HELP: String = "declare resource union Reader: private Init(Int)"
private PRIVATE_HELP: String = "declare private resource union Writer: Init(Int)"


private pure func declared_unions(source: String) -> List[ParsedUnion]:
    match parsed(source):
        Ok(module): module_contents(module).unions
        Err(_): []


pure func test_a_resource_union_with_a_private_variant_parses() -> Bool:
    source: String =
        |resource union Reader:
        |    private Init(Int)
        |

    match declared_unions(source):
        [reader]: reader.kind == ResourceUnion
        _: False


pure func test_a_private_resource_union_parses() -> Bool:
    source: String =
        |private resource union Writer:
        |    Init(Int)
        |

    match declared_unions(source):
        [writer]: writer.kind == ResourceUnion
        _: False


pure func test_a_second_variant_is_rejected() -> Bool:
    marked: String =
        |resource union [[Reader]]:
        |    private Init(Int)
        |    private Closed
        |

    parse_rejects(marked, SHAPE, PUBLIC_HELP)


pure func test_a_second_payload_is_rejected() -> Bool:
    marked: String =
        |resource union [[Reader]]:
        |    private Init(Int, Int)
        |

    parse_rejects(marked, SHAPE, PUBLIC_HELP)


pure func test_a_variant_without_a_payload_is_rejected() -> Bool:
    marked: String =
        |resource union [[Reader]]:
        |    private Init
        |

    parse_rejects(marked, SHAPE, PUBLIC_HELP)


pure func test_a_public_variant_is_rejected() -> Bool:
    marked: String =
        |resource union [[Reader]]:
        |    Init(Int)
        |

    parse_rejects(marked, SHAPE, PUBLIC_HELP)


pure func test_type_parameters_are_rejected() -> Bool:
    marked: String =
        |resource union [[Reader]][T]:
        |    private Init(Int)
        |

    parse_rejects(marked, SHAPE, PUBLIC_HELP)


pure func test_a_private_resource_union_gets_the_private_help() -> Bool:
    marked: String =
        |private resource union [[Writer]]:
        |    Init(Int, Int)
        |

    parse_rejects(marked, SHAPE, PRIVATE_HELP)


-- The help names the declaration itself.
pure func test_several_shape_problems_are_one_error() -> Bool:
    marked: String =
        |resource union [[Bad]][T]:
        |    Open(Int, Int)
        |    Closed
        |

    parse_rejects(marked, SHAPE, "declare resource union Bad: private Init(Int)")


TESTS: TestSuite = {
    description = "Resource union syntax",
    tests = [
        (
            "a resource union with a private variant parses",
            test_a_resource_union_with_a_private_variant_parses
        ),
        ("a private resource union parses", test_a_private_resource_union_parses),
        ("a second variant is rejected", test_a_second_variant_is_rejected),
        ("a second payload is rejected", test_a_second_payload_is_rejected),
        ("a variant without a payload is rejected", test_a_variant_without_a_payload_is_rejected),
        ("a public variant is rejected", test_a_public_variant_is_rejected),
        ("type parameters are rejected", test_type_parameters_are_rejected),
        (
            "a private resource union gets the private help",
            test_a_private_resource_union_gets_the_private_help
        ),
        ("several shape problems are one error", test_several_shape_problems_are_one_error)
    ]
}
