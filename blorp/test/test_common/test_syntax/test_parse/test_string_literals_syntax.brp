import:
    bool: Bool methods
    int as int_ops
    option: Option methods
    result: Result methods
    string: from_codepoint
    test: TestSuite
    ../../../../src/common/analysis/assemble: parsed_contents
    ../../../../src/common/analysis/ids: inventory_functions
    ../../../../src/common/syntax/lex: lex
    ../../../../src/common/syntax/names: program_names
    ../../../../src/common/syntax/parse: parse_module
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../src/common/syntax/syntax:
        Diagnostic,
        DiagnosticKind(ProgramProblem),
        ExpressionBase(StringExpression),
        ParsedBody(ParsedValueBody, ParsedBuiltinBody),
        ParsedRuntimeOperation(StringByteAtBuiltin, StringFromCodepointBuiltin, SystemBuiltin),
        SystemOperation(CurrentDirectory),
        TokenKind(QuotedString),
    ../../../support/current_directory_inputs: CURRENT_DIRECTORY_SOURCE
    ../../../support/input: parse
    ../../../support/module_input: parse_modules
    ../../../support/string_integer_inputs:
        STRING_INTEGER_SOURCE,
        BYTE_LABEL_START,
        ENCODER_LABEL_START,


private ESCAPE_HELP: String = "use \\n, \\r, \\t, \\0, \\\\, \\\", \\', \\{, \\}, or a Unicode scalar escape such as \\u{E9}"


private UNICODE_HELP: String = "write \\u{H} with one to six hexadecimal digits for a scalar from 0 to 10FFFF, excluding D800 through DFFF"


private pure func decoded(raw: String) -> Result[String, Diagnostic]:
    tokens ?= lex(
        module_source(root_module_id()),
        "func main() -> String:\n    \"" + raw + "\"\n",
        program_names().names,
    ).map_err(pure func(failure): failure.error)
    parsed ?= parse(tokens)
    missing: Result[String, Diagnostic] = Err({
        span = tokens.end,
        kind = ProgramProblem,
        note = None,
        message = "missing literal in parser test",
        help = "fix test",
    })

    functions = inventory_functions(parsed_contents(parsed).declarations).filter(
        pure func(row): row.declaration.module == root_module_id(),
    )
    match functions:
        [row]:
            match row.declaration.body:
                ParsedValueBody(value):
                    match value.base:
                        StringExpression(bytes): Ok(bytes)
                        _: missing
                _:
                    missing
        _:
            missing


private pure func parse_rejects(
    raw: String,
    start: Int,
    end: Int,
    message: String,
    help: String,
) -> Bool:
    match decoded(raw):
        Err(error):
            (error.span.start == start + 28)
                .and(error.span.end == end + 28)
                .and(error.message == message)
                .and(error.help == help)
        Ok(_):
            False


private pure func decoded_is(raw: String, expected: String) -> Bool:
    match decoded(raw):
        Ok(bytes): bytes == expected
        Err(_): False


private pure func lex_rejects(
    source: String,
    start: Int,
    end: Int,
    message: String,
    help: String,
) -> Bool:
    match lex(module_source(root_module_id()), source, program_names().names):
        Err(failure):
            (failure.error.span.start == start)
                .and(failure.error.span.end == end)
                .and(failure.error.message == message)
                .and(failure.error.help == help)
        Ok(_):
            False


-- The target String is valid UTF-8, so a scalar's raw bytes come from its code point.
private pure func scalar_text(scalar: Int) -> String:
    from_codepoint(scalar).get_or("")


private pure func repeated(text: String, count: Int) -> String:
    var joined: String = ""
    for _ in 0..count:
        joined = joined + text
    joined


pure func test_parser_decodes_all_fixed_escapes_once() -> Bool:
    decoded_is("\\n\\r\\t\\0\\\\\\\"\\'\\{\\}", "\n\r\t\0\\\"'{}")
        .and(decoded_is("\\\\n", "\\n"))
        .and(decoded_is("$\\{", "$" + "{"))


pure func test_raw_utf8_and_unicode_escape_have_identical_bytes() -> Bool:
    decoded_is("é😀", "é😀").and(decoded_is("\\u{E9}\\u{1f600}", "é😀"))


pure func test_unicode_preserves_normalization_and_noncharacters() -> Bool:
    decoded_is("é", "é")
        .and(decoded_is("é", "é"))
        .and(decoded_is("\\u{FDD0}\\u{10FFFF}", "﷐􏿿"))


pure func test_unicode_escape_scalar_boundaries() -> Bool:
    decoded_is(
        "\\u{0}\\u{7FF}\\u{800}\\u{D7FF}\\u{E000}\\u{FFFF}\\u{10000}\\u{10FFFF}",
        "\0߿ࠀ퟿￿𐀀􏿿",
    )


pure func test_parser_rejects_unknown_escape_with_whole_character_span() -> Bool:
    parse_rejects("a\\q", 1, 3, "unknown String escape", ESCAPE_HELP).and(
        parse_rejects("\\é", 0, 3, "unknown String escape", ESCAPE_HELP),
    )


pure func test_parser_rejects_forged_trailing_escape_with_backslash_span() -> Bool:
    source: String =
        |func main() -> String:
        |    "abcX"
        |

    match lex(module_source(root_module_id()), source, program_names().names):
        Err(_):
            False
        Ok(program):
            match program.tokens.get(9):
                Some(token):
                    match token.kind:
                        QuotedString(raw):
                            tokens = program.tokens.set(9, { token | kind = QuotedString("abc\\") })
                            match parse({ program | tokens = tokens }):
                                Err(error):
                                    (raw == "abcX")
                                        .and(token.span.start == 27)
                                        .and(token.span.end == 33)
                                        .and(error.span.source == token.span.source)
                                        .and(error.span.source == module_source(root_module_id()))
                                        .and(error.span.start == 31)
                                        .and(error.span.end == 32)
                                        .and(error.message == "unknown String escape")
                                        .and(error.help == ESCAPE_HELP)
                                        .and(error.note.is_none())
                                Ok(_):
                                    False
                        _:
                            False
                None:
                    False


pure func test_parser_rejects_unicode_escape_shape_and_invalid_scalars() -> Bool:
    var passed: Bool = True

    for raw in [
        "\\u{}",
        "\\u{G}",
        "\\u{é}",
        "\\ué",
        "\\u{D800}",
        "\\u{DFFF}",
        "\\u{110000}",
        "\\u{1234567}",
        "\\u{12",
        "\\uE9",
    ]:
        end = if raw == "\\u{G}":
            4
        else if raw == "\\u{1234567}":
            10
        else if raw == "\\uE9":
            3
        else if raw == "\\u{é}":
            5
        else:
            raw.length()

        passed = passed.and(parse_rejects(raw, 0, end, "invalid Unicode escape", UNICODE_HELP))

    passed


private pure func interpolation_accepts(raw: String) -> Bool:
    lex(
        module_source(root_module_id()),
        "func main() -> String:\n    \"" + raw + "\"\n",
        program_names().names,
    )
        .map_err(pure func(failure): failure.error)
        .and_then(pure func(tokens): parse(tokens))
        .is_ok()


pure func test_parser_accepts_interpolation_opener() -> Bool:
    interpolation_accepts("a$" + "{value}")


pure func test_raw_runs_and_escapes_keep_their_order() -> Bool:
    decoded_is("", "")
        .and(decoded_is("\\n", "\n"))
        .and(decoded_is("\\n\\n", "\n\n"))
        .and(decoded_is("a\\nb", "a\nb"))
        .and(decoded_is("x\\t", "x\t"))
        .and(decoded_is("\\tx", "\tx"))
        .and(decoded_is("é\\tü\\u{E9}😀\\\\z", "é\tüé😀\\z"))
        .and(decoded_is(repeated("a\\n", 2000), repeated("a\n", 2000)))


pure func test_dollar_without_an_opening_brace_is_literal() -> Bool:
    decoded_is("$", "$")
        .and(decoded_is("a$b", "a$b"))
        .and(decoded_is("cost$", "cost$"))
        .and(decoded_is("$$", "$$"))
        .and(decoded_is("$\\n$", "$\n$"))


pure func test_parser_accepts_interpolation_after_other_content() -> Bool:
    interpolation_accepts("$" + "{x}")
        .and(interpolation_accepts("$$" + "{x}"))
        .and(interpolation_accepts("é\\n$" + "{x}"))


pure func test_later_escape_errors_report_byte_offsets_after_earlier_content() -> Bool:
    parse_rejects("é\\n\\q", 4, 6, "unknown String escape", ESCAPE_HELP).and(
        parse_rejects("a\\u{41}\\u{G}", 7, 11, "invalid Unicode escape", UNICODE_HELP),
    )


pure func test_lexer_rejects_raw_controls() -> Bool:
    var passed: Bool = True

    for control in [0, 9, 13, 31, 127]:
        passed = passed.and(
            lex_rejects(
                "\"a" + scalar_text(control) + "\"",
                2,
                3,
                "unsupported raw byte in String literal",
                "use printable text and fixed escapes for control bytes",
            ),
        )

    passed.and(
        lex_rejects(
            "\"a\n",
            2,
            3,
            "String literals must stay on one line",
            "close the quote before LF; write \\n for a newline byte",
        ),
    )


pure func test_lexer_rejects_missing_quote_and_trailing_backslash() -> Bool:
    lex_rejects(
        "\"abc",
        0,
        4,
        "unterminated String literal",
        "add a closing double quote on the same line",
    ).and(
        lex_rejects(
            "\"abc\\",
            4,
            5,
            "unterminated String escape",
            "complete the escape and close the double quote on the same line",
        ),
    )


-- Each pair is a scalar and the width of its UTF-8 encoding, so a rejected
-- scalar (which `scalar_text` would turn into "") cannot pass as an empty literal.
pure func test_lexer_accepts_raw_utf8_scalar_boundaries() -> Bool:
    var passed: Bool = True

    for (scalar, width) in [
        (128, 2),
        (2047, 2),
        (2048, 3),
        (55295, 3),
        (57344, 3),
        (64976, 3),
        (65535, 3),
        (65536, 4),
        (1114111, 4),
    ]:
        raw = scalar_text(scalar)
        passed = passed
            .and(raw.length() == width)
            .and(decoded_is(raw, raw))

    passed


pure func test_builtin_labels_match_raw_bytes_without_escape_aliases() -> Bool:
    prefix = "pure func add(a: Int, b: Int) -> Int:\n    builtin("
    raw = "int\\u{2E}add"

    match (
        lex(module_source(root_module_id()), prefix + "\"" + raw + "\")", program_names().names)
            .map_err(pure func(failure): failure.error)
            .and_then(pure func(tokens): parse_module(tokens, root_module_id()))
    ):
        Err(error):
            (error.message == "unknown builtin operation")
                .and(
                    (
                        error.help
                        == "use system.current_directory, process.capture, process.run, process.find_program, process.fault, process.exit_interrupted, fs.read_text, fs.read_bytes, fs.write_text, fs.write_bytes, fs.entry_kind, fs.list_directory, fs.create_directory, fs.create_directories, fs.remove_file, fs.remove_directory, fs.rename, fs.remove_directory_tree, fs.create_temporary_directory, fs.open_read, fs.next_lines, fs.close, int.equals, int.less_than, int.add, int.subtract, int.multiply, int.divide, int.remainder, int.to_string, int.wrap_to_uint8, uint8.equals, uint8.less_than, uint8.add, uint8.subtract, uint8.multiply, uint8.divide, uint8.remainder, uint8.to_string, uint8.to_int, float.add, float.subtract, float.multiply, float.divide, float.remainder, float.to_string, float.copysign, float.equals, float.less_than, string.length, string.add, string.append_int, string.print, string.print_error, string.parse_int, string.parse_float, string.byte_at, string.byte_at_uint8, string.from_codepoint, string.slice, string.byte_length, string.byte_slice, string.codepoint_length, string.codepoint_slice, string.codepoint_at, string.equals, string.to_bytes, bytes.to_text, list.repeat, list.length, list.get, list.append, list.set or list.concat"
                    ),
                )
                .and(error.span.start == prefix.length())
                .and(error.span.end == prefix.length() + raw.length() + 2)
        Ok(_):
            False


pure func test_lexer_preserves_quoted_contents_and_full_span() -> Bool:
    source = "\"hello -- world\""

    match lex(module_source(root_module_id()), source, program_names().names):
        Ok(program):
            match program.tokens:
                [token, _]:
                    match token.kind:
                        QuotedString(raw):
                            (raw == "hello -- world")
                                .and(token.span.start == 0)
                                .and(token.span.end == 16)
                        _:
                            False
                _:
                    False
        Err(_):
            False


pure func test_lexer_keeps_escape_bytes_without_decoding() -> Bool:
    match lex(module_source(root_module_id()), "\"a\\\"b\\n\"", program_names().names):
        Ok(program):
            match program.tokens:
                [token, _]:
                    match token.kind:
                        QuotedString(raw): (raw == "a\\\"b\\n").and(token.span.end == 8)
                        _: False
                _:
                    False
        Err(_):
            False


pure func test_parser_accepts_a_quoted_expression_with_its_source_span() -> Bool:
    source: String =
        |func main() -> String:
        |    "hello"
        |

    match (
        lex(module_source(root_module_id()), source, program_names().names)
            .map_err(pure func(failure): failure.error)
            .and_then(pure func(tokens): parse(tokens))
    ):
        Ok(parsed):
            functions = inventory_functions(parsed_contents(parsed).declarations).filter(
                pure func(row): row.declaration.module == root_module_id(),
            )
            match functions:
                [row]:
                    match row.declaration.body:
                        ParsedValueBody(value):
                            (value.base_span.start == 27)
                                .and(value.base_span.end == 34)
                                .and(value.applications.length() == 0)
                        _:
                            False
                _:
                    False
        Err(_):
            False


pure func test_string_integer_labels_publish_operations_and_exact_spans() -> Bool:
    match parse_modules([{ source = STRING_INTEGER_SOURCE, targets = [] }]):
        Err(_):
            False
        Ok(program):
            match inventory_functions(parsed_contents(program).declarations).map(
                pure func(row): row.declaration,
            ):
                [byte, encoder, _]:
                    match (byte.body, encoder.body):
                        (ParsedBuiltinBody(StringByteAtBuiltin, byte_span), ParsedBuiltinBody(StringFromCodepointBuiltin, encoder_span)):
                            (byte_span.source == module_source(root_module_id()))
                                .and(encoder_span.source == module_source(root_module_id()))
                                .and(int_ops.equals(byte_span.start, BYTE_LABEL_START))
                                .and(
                                    int_ops.equals(
                                        byte_span.end,
                                        BYTE_LABEL_START + "\"string.byte_at\"".length(),
                                    ),
                                )
                                .and(int_ops.equals(encoder_span.start, ENCODER_LABEL_START))
                                .and(
                                    int_ops.equals(
                                        encoder_span.end,
                                        ENCODER_LABEL_START + "\"string.from_codepoint\"".length(),
                                    ),
                                )
                                .and(byte.statements.is_empty())
                                .and(encoder.statements.is_empty())
                        _:
                            False
                _:
                    False


pure func test_current_directory_label_keeps_its_operation_and_span() -> Bool:
    match parse_modules([{ source = CURRENT_DIRECTORY_SOURCE, targets = [] }]):
        Err(_):
            False
        Ok(program):
            match inventory_functions(parsed_contents(program).declarations).get(0):
                Some(row):
                    match row.declaration.body:
                        ParsedBuiltinBody(SystemBuiltin(CurrentDirectory), span):
                            (span.start == 49).and(span.end == 75)
                        _:
                            False
                None:
                    False


TESTS: TestSuite = {
    description = "Blorp quoted String syntax",
    tests = [
        (
            "current directory label preserves operation and span",
            test_current_directory_label_keeps_its_operation_and_span,
        ),
        (
            "String integer labels publish exact operations and spans",
            test_string_integer_labels_publish_operations_and_exact_spans,
        ),
        (
            "lexer accepts raw UTF-8 scalar boundaries",
            test_lexer_accepts_raw_utf8_scalar_boundaries,
        ),
        ("parser decodes all fixed escapes once", test_parser_decodes_all_fixed_escapes_once),
        (
            "raw UTF-8 and Unicode escapes have identical bytes",
            test_raw_utf8_and_unicode_escape_have_identical_bytes,
        ),
        (
            "Unicode preserves normalization and noncharacters",
            test_unicode_preserves_normalization_and_noncharacters,
        ),
        ("Unicode escape scalar boundaries", test_unicode_escape_scalar_boundaries),
        (
            "parser rejects unknown escape with whole character span",
            test_parser_rejects_unknown_escape_with_whole_character_span,
        ),
        (
            "parser rejects forged trailing escape with backslash span",
            test_parser_rejects_forged_trailing_escape_with_backslash_span,
        ),
        (
            "parser rejects Unicode escape shapes and invalid scalars",
            test_parser_rejects_unicode_escape_shape_and_invalid_scalars,
        ),
        ("parser accepts interpolation opener", test_parser_accepts_interpolation_opener),
        ("raw runs and escapes keep their order", test_raw_runs_and_escapes_keep_their_order),
        (
            "a dollar without an opening brace is literal",
            test_dollar_without_an_opening_brace_is_literal,
        ),
        (
            "parser accepts interpolation after other content",
            test_parser_accepts_interpolation_after_other_content,
        ),
        (
            "later escape errors report byte offsets after earlier content",
            test_later_escape_errors_report_byte_offsets_after_earlier_content,
        ),
        ("lexer rejects raw controls", test_lexer_rejects_raw_controls),
        (
            "lexer rejects missing quote and trailing backslash",
            test_lexer_rejects_missing_quote_and_trailing_backslash,
        ),
        (
            "builtin spelling decodes only as an expression",
            test_builtin_labels_match_raw_bytes_without_escape_aliases,
        ),
        (
            "lexer preserves quoted contents and full span",
            test_lexer_preserves_quoted_contents_and_full_span,
        ),
        (
            "lexer keeps escape bytes without decoding",
            test_lexer_keeps_escape_bytes_without_decoding,
        ),
        (
            "parser accepts quoted expression and source span",
            test_parser_accepts_a_quoted_expression_with_its_source_span,
        ),
    ],
}
