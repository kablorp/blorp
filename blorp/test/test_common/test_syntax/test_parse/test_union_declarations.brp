import:
    bool: and
    test: TestSuite
    ../../../../src/common/syntax/lex: lex
    ../../../../src/common/syntax/names: name_spelling, program_names
    ../../../../src/common/syntax/parse: ParsedModule, module_contents, module_names, parse_module
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../src/common/syntax/syntax:
        Diagnostic,
        DiagnosticNote(PreviousDeclaration),
        ParsedUnion,
        Visibility(Public, Private)


private pure func parsed(source: String) -> Result[ParsedModule, Diagnostic]:
    match lex(module_source(root_module_id()), source, program_names().names):
        Err(failure): Err(failure.error)
        Ok(tokens): parse_module(tokens, root_module_id())


private pure func rejects(
    source: String,
    start: Int,
    end: Int,
    message: String,
    help: String
) -> Bool:
    match parsed(source):
        Ok(_):
            False
        Err(error):
            and(
                and(
                    error.span.source == module_source(root_module_id()),
                    and(error.span.start == start, error.span.end == end)
                ),
                and(and(error.message == message, error.help == help), error.note.is_none())
            )


private pure func is_private(declaration: ParsedUnion) -> Bool:
    match declaration.visibility:
        Public: False
        Private(_): True


-- `union` and `fixed union` both declare a union, public or private, in
-- source order; only the second records that it was written `fixed`.
pure func test_union_and_fixed_union_declare_unions() -> Bool:
    source = "union First:\n    A\nprivate union Second:\n    B\nfixed union Third:\n    C\nprivate fixed union Fourth:\n    D\n"

    match parsed(source):
        Err(_):
            False
        Ok(module):
            names = module_names(module)

            match module_contents(module).unions:
                [first, second, third, fourth]:
                    and(
                        and(
                            and(
                                name_spelling(names, first.type_name.id) == Some("First"),
                                first
                                    .is_private()
                                    .not()
                            ),
                            and(
                                name_spelling(names, second.type_name.id) == Some("Second"),
                                second.is_private()
                            )
                        ),
                        and(
                            and(
                                name_spelling(names, third.type_name.id) == Some("Third"),
                                third
                                    .is_private()
                                    .not()
                            ),
                            and(
                                name_spelling(names, fourth.type_name.id) == Some("Fourth"),
                                fourth.is_private()
                            )
                        )
                    )
                        .and(and(first.fixed.not(), second.fixed.not()))
                        .and(and(third.fixed, fourth.fixed))
                _:
                    False


-- A fixed union is stored inline at one known size, so it has no type
-- parameters; the whole written list is reported.
pure func test_fixed_union_rejects_type_parameters() -> Bool:
    rejects(
        "fixed union Box[T, U]:\n    Full(T)\n    Empty\n",
        15,
        21,
        "a fixed union cannot declare type parameters",
        "remove fixed to declare an ordinary generic union, or remove the type parameters"
    )


pure func test_union_declares_type_parameters() -> Bool:
    match parsed("union Box[T]:\n    Full(T)\n    Empty\n"):
        Err(_):
            False
        Ok(module):
            match module_contents(module).unions:
                [declaration]: declaration.type_parameters.length() == 1
                _: False


-- `fixed` is contextual, so a function may still be named `fixed`.
pure func test_fixed_remains_a_function_name() -> Bool:
    match parsed("func fixed() -> Int:\n    1\n"):
        Err(_): False
        Ok(module): module_contents(module).functions.length() == 1


-- At column 1 `fixed:` is still read as a constant, which must be upper-snake.
pure func test_fixed_at_column_one_is_a_constant_name_in_the_wrong_form() -> Bool:
    rejects("fixed: Int = 1\n", 0, 5, "a constant is written in UPPER_SNAKE_CASE", "write `FIXED`")


pure func test_private_fixed_requires_record_or_union() -> Bool:
    rejects(
        "private fixed Choice:\n    First\n",
        14,
        20,
        "expected 'record' or 'union' after 'fixed'",
        "write fixed record Name { field: Int } or fixed union Choice:"
    )


pure func test_fixed_requires_record_or_union() -> Bool:
    rejects(
        "fixed Choice:\n    First\n",
        6,
        12,
        "expected 'record' or 'union' after 'fixed'",
        "write fixed record Name { field: Int } or fixed union Choice:"
    )


pure func test_union_header_requires_colon() -> Bool:
    rejects(
        "union Choice\n    First\n",
        12,
        13,
        "expected ':' after the union type name",
        "write union Choice: or union Box[T]:"
    )


-- `private` before a variant is read as its mark, keeping the keyword's
-- span; an unmarked variant is public as written.
pure func test_a_variant_may_be_marked_private() -> Bool:
    match parsed("union UserId:\n    private Init(Int)\n    Other\n"):
        Err(_):
            False
        Ok(module):
            match module_contents(module).unions:
                [declaration]:
                    match declaration.variants:
                        [marked, unmarked]:
                            marked_at: Bool = match marked.visibility:
                                Private(mark): and(mark.start == 18, mark.end == 25)
                                Public: False

                            unmarked_public: Bool = match unmarked.visibility:
                                Public: True
                                Private(_): False

                            and(and(marked_at, unmarked_public), marked.fields.length() == 1)
                        _:
                            False
                _:
                    False


-- The second variant of one name is reported, with a note at the first.
pure func test_a_union_rejects_a_duplicate_variant() -> Bool:
    match parsed("union UserId:\n    Init(Int)\n    Init\n"):
        Ok(_):
            False
        Err(error):
            noted_first: Bool = match error.note:
                Some(PreviousDeclaration(first)): and(first.start == 18, first.end == 22)
                _: False

            and(
                and(and(error.span.start == 32, error.span.end == 36), noted_first),
                and(
                    error.message == "UserId already has a variant named Init",
                    error.help == "rename one of them"
                )
            )


pure func test_a_variant_cannot_share_its_unions_name() -> Bool:
    rejects(
        "union UserId:\n    UserId(Int)\n",
        18,
        24,
        "variant UserId shares its union's name",
        "name the variant, for example UserId.Init, so that UserId always means the type"
    )


-- A private union's variants are already private, so the mark is reported.
pure func test_a_private_unions_variant_carries_no_private_mark() -> Bool:
    rejects(
        "private union Step:\n    Stay\n    private Shift\n",
        33,
        40,
        "Step is private, so its variants already are",
        "remove private from Shift"
    )


TESTS: TestSuite = {
    description = "Blorp union declarations",
    tests = [
        ("union and fixed union declare unions", test_union_and_fixed_union_declare_unions),
        ("fixed union rejects type parameters", test_fixed_union_rejects_type_parameters),
        ("union declares type parameters", test_union_declares_type_parameters),
        ("fixed remains a function name", test_fixed_remains_a_function_name),
        (
            "fixed at column 1 is a constant name in the wrong form",
            test_fixed_at_column_one_is_a_constant_name_in_the_wrong_form
        ),
        ("private fixed requires record or union", test_private_fixed_requires_record_or_union),
        ("fixed requires record or union", test_fixed_requires_record_or_union),
        ("union header requires a colon", test_union_header_requires_colon),
        ("a variant may be marked private", test_a_variant_may_be_marked_private),
        ("a union rejects a duplicate variant", test_a_union_rejects_a_duplicate_variant),
        ("a variant cannot share its union's name", test_a_variant_cannot_share_its_unions_name),
        (
            "a private union's variant carries no private mark",
            test_a_private_unions_variant_carries_no_private_mark
        )
    ]
}
