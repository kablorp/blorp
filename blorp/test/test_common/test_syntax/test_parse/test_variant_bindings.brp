---
`Name(binders) = value` and `Union.Name(binders) = value` destructure a union
with one variant (rule 7). The parser commits once the variant's `)` is
followed by `=`, as a line that starts with `(` commits to a tuple binding, so
a line that starts with a variant and has no `) =` is still a value. Each
rejection marks the span of its one diagnostic with `[[` and `]]`.
---
import:
    test: TestSuite
    ../../../../src/common/syntax/names: NameTable, NameId, name_spelling
    ../../../../src/common/syntax/parse: module_contents, module_names
    ../../../../src/common/syntax/syntax:
        DestructuredVariant(BareVariant, UnionVariant),
        ParsedBinder(NamedBinder, DiscardBinder),
        ParsedFunctionGroup(FreeFunction),
        ParsedStatement(VariantBinding),
        ParsedVariantBinding
    ./parse_rejection: parse_rejects, parsed


private pure func spelled(names: NameTable, id: NameId) -> String:
    name_spelling(names, id).get_or("?")


-- A destructuring written back from its syntax, then the source its span
-- covers and its initializer's source: `Pair.Init(left, _) | Pair.Init(left, _) | pair`.
private pure func written_back(
    binding: ParsedVariantBinding,
    names: NameTable,
    source: String
) -> String:
    head = match binding.variant:
        BareVariant(name):
            names.spelled(name.id)
        UnionVariant(written):
            "${names.spelled(written.union_name.id)}.${names.spelled(written.variant.id)}"

    binders = binding.binders.map(pure func(binder: ParsedBinder) -> String:
        match binder:
            NamedBinder(name): names.spelled(name.id)
            DiscardBinder(_): "_"
    )

    covered = source
        .slice(binding.span.start, binding.span.end)
        .get_or("")

    value = source
        .slice(binding.initializer.span.start, binding.initializer.span.end)
        .get_or("")

    "${head}(${binders.join(", ")}) | ${covered} | ${value}"


-- Each destructuring among the first function's statements, written back.
private pure func destructurings(source: String) -> List[String]:
    match parsed(source):
        Err(_):
            []
        Ok(module):
            match module_contents(module).functions:
                [FreeFunction(function), ..._]:
                    var found: List[String] = []

                    for statement in function.statements:
                        match statement:
                            VariantBinding(binding):
                                found = found.append(
                                    binding.written_back(module_names(module), source)
                                )
                            _:
                                void

                    found
                _:
                    []


private BINDER_MESSAGE: String = "destructuring binds a name or '_' for each payload"
private BINDER_HELP: String = "bind the payload to a name, then compare or use that name"


pure func test_a_bare_variant_binds_one_name() -> Bool:
    source: String =
        |pure func number(id: UserId) -> Int:
        |    Init(value) = id
        |    value
        |

    destructurings(source) == ["Init(value) | Init(value) | id"]


pure func test_a_variant_through_its_union_binds_one_name() -> Bool:
    source: String =
        |pure func number(id: UserId) -> Int:
        |    UserId.Init(value) = id
        |    value
        |

    destructurings(source) == ["UserId.Init(value) | UserId.Init(value) | id"]


pure func test_several_names_and_a_discard_are_bound_in_order() -> Bool:
    source: String =
        |pure func left(pair: Pair) -> Int:
        |    Pair.Init(first, _, third) = pair.swapped()
        |    first
        |

    (
        destructurings(source)
        == ["Pair.Init(first, _, third) | Pair.Init(first, _, third) | pair.swapped()"]
    )


pure func test_the_value_may_start_on_the_next_line() -> Bool:
    source: String =
        |pure func number(id: UserId) -> Int:
        |    Init(value) =
        |        id
        |    value
        |

    destructurings(source) == ["Init(value) | Init(value) | id"]


-- Without `) =`, a line that starts with a variant is a value, as before.
pure func test_a_variant_line_without_equals_is_a_value() -> Bool:
    source: String =
        |pure func same(id: UserId) -> Bool:
        |    Init(value) == id
        |

    match parsed(source):
        Ok(_): destructurings(source).is_empty()
        Err(_): False


pure func test_a_literal_is_not_a_payload_name() -> Bool:
    marked: String =
        |pure func number(id: UserId) -> Int:
        |    Init([[1]]) = id
        |    1
        |

    parse_rejects(marked, BINDER_MESSAGE, BINDER_HELP)


pure func test_a_field_read_is_not_a_payload_name() -> Bool:
    marked: String =
        |pure func number(id: UserId) -> Int:
        |    Init([[other.value]]) = id
        |    1
        |

    parse_rejects(marked, BINDER_MESSAGE, BINDER_HELP)


pure func test_a_destructuring_binds_at_least_one_name() -> Bool:
    marked: String =
        |pure func number(id: UserId) -> Int:
        |    [[Init()]] = id
        |    1
        |

    parse_rejects(marked, BINDER_MESSAGE, "name the payload, or write _ to discard it")


pure func test_a_payload_name_takes_no_annotation() -> Bool:
    marked: String =
        |pure func number(id: UserId) -> Int:
        |    Init(value[[:]] Int) = id
        |    value
        |

    parse_rejects(
        marked,
        "destructuring names cannot have type annotations",
        "annotate the value before destructuring it"
    )


-- A tuple destructuring shares the message, which no longer names tuples.
pure func test_a_tuple_name_takes_no_annotation() -> Bool:
    marked: String =
        |pure func left(pair: (Int, Int)) -> Int:
        |    (first[[:]] Int, second) = pair
        |    first
        |

    parse_rejects(
        marked,
        "destructuring names cannot have type annotations",
        "annotate the value before destructuring it"
    )


pure func test_a_destructuring_does_not_propagate() -> Bool:
    marked: String =
        |func number(id: Result[UserId, Int]) -> Result[Int, Int]:
        |    Init(value) [[?=]] id
        |    Ok(value)
        |

    parse_rejects(
        marked,
        "destructuring requires '='",
        "propagate into a name first, then destructure the result"
    )


TESTS: TestSuite = {
    description = "Variant destructuring syntax",
    tests = [
        ("a bare variant binds one name", test_a_bare_variant_binds_one_name),
        (
            "a variant through its union binds one name",
            test_a_variant_through_its_union_binds_one_name
        ),
        (
            "several names and a discard are bound in order",
            test_several_names_and_a_discard_are_bound_in_order
        ),
        ("the value may start on the next line", test_the_value_may_start_on_the_next_line),
        ("a variant line without '=' is a value", test_a_variant_line_without_equals_is_a_value),
        ("a literal is not a payload name", test_a_literal_is_not_a_payload_name),
        ("a field read is not a payload name", test_a_field_read_is_not_a_payload_name),
        ("a destructuring binds at least one name", test_a_destructuring_binds_at_least_one_name),
        ("a payload name takes no annotation", test_a_payload_name_takes_no_annotation),
        ("a tuple name takes no annotation", test_a_tuple_name_takes_no_annotation),
        ("a destructuring does not propagate", test_a_destructuring_does_not_propagate)
    ]
}
