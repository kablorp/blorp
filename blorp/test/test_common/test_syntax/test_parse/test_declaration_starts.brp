import:
    bool: and
    int: Int methods
    result: and_then, map_err
    string: String methods
    test: TestSuite
    ../../../../src/common/syntax/lex: lex
    ../../../../src/common/syntax/names: program_names
    ../../../../src/common/syntax/parse: ParsedModuleContents, module_contents, parse_module
    ../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../src/common/syntax/syntax:
        ParsedBuiltinType(ListBuiltin),
        ParsedFunctionGroup(FreeFunction, ImplementationGroup),
        ParsedTraitMethod(DefaultTraitMethod),
        Span,


-- Each declaration's `start` spans its first token, which the formatter uses
-- to place blank lines and documentation. Offsets are into the source text.
private pure func contents_of(source: String) -> Option[ParsedModuleContents]:
    match (
        lex(module_source(root_module_id()), source, program_names().names)
            .map_err(pure func(failure): failure.error)
            .and_then(pure func(tokens): parse_module(tokens, root_module_id()))
    ):
        Ok(parsed): Some(module_contents(parsed))
        Err(_): None


private pure func starts_at(start: Span, offset: Int, text: String) -> Bool:
    and(start.start == offset, start.end == offset + text.length())


pure func test_private_pure_function_starts_at_private() -> Bool:
    match contents_of("private pure func answer() -> Int:\n\t42\n"):
        Some(contents):
            match contents.functions:
                [FreeFunction(function)]: starts_at(function.start, 0, "private")
                _: False
        None:
            False


pure func test_pure_function_starts_at_pure_and_a_bare_one_at_func() -> Bool:
    match contents_of("pure func one() -> Int:\n\t1\nfunc two() -> Int:\n\t2\n"):
        Some(contents):
            match contents.functions:
                [FreeFunction(first), FreeFunction(second)]:
                    and(starts_at(first.start, 0, "pure"), starts_at(second.start, 27, "func"))
                _:
                    False
        None:
            False


pure func test_annotated_function_starts_at_the_annotation() -> Bool:
    match contents_of("@tail_recursive\nfunc loop(n: Int) -> Int:\n\tloop(n)\n"):
        Some(contents):
            match contents.functions:
                [FreeFunction(function)]: starts_at(function.start, 0, "@")
                _: False
        None:
            False


pure func test_fixed_record_starts_at_fixed_and_private_union_at_private() -> Bool:
    source: String =
        |fixed record Pair { first: Int }
        |private fixed union Choice:
        |	One
        |

    match contents_of(source):
        Some(contents):
            match (contents.records, contents.unions):
                ([pair], [choice]):
                    and(starts_at(pair.start, 0, "fixed"), starts_at(choice.start, 33, "private"))
                _:
                    False
        None:
            False


pure func test_bare_keywords_start_at_the_keyword() -> Bool:
    source: String =
        |record Box { value: Int }
        |opaque type Handle = Int
        |union Choice:
        |	One
        |trait Showy:
        |	func show(value: Self) -> String
        |COUNT: Int = 3
        |

    match contents_of(source):
        Some(contents):
            match (
                (contents.records, contents.opaques),
                (contents.unions, contents.traits),
                contents.constants,
            ):
                (([box], [handle]), ([choice], [showy]), [count]):
                    and(
                        and(
                            starts_at(box.start, 0, "record"),
                            and(
                                starts_at(handle.start, 26, "opaque"),
                                starts_at(choice.start, 51, "union"),
                            ),
                        ),
                        and(
                            starts_at(showy.start, 70, "trait"),
                            starts_at(count.start, 117, "COUNT"),
                        ),
                    )
                _:
                    False
        None:
            False


-- An implementation's methods each start at their own first token, not at the
-- implementation's `private` or keyword.
pure func test_implementation_and_its_methods_start_at_their_own_tokens() -> Bool:
    source: String =
        |private implements Showy for Int:
        |	pure func show(value: Int) -> String:
        |		"int"
        |

    match contents_of(source):
        Some(contents):
            match contents.functions:
                [ImplementationGroup(header, [method])]:
                    and(starts_at(header.start, 0, "private"), starts_at(method.start, 35, "pure"))
                _:
                    False
        None:
            False


pure func test_default_trait_method_starts_at_its_first_token() -> Bool:
    source: String =
        |trait Showy:
        |	pure func show(value: Self) -> String:
        |		"x"
        |

    match contents_of(source):
        Some(contents):
            match contents.traits:
                [showy]:
                    match showy.methods:
                        [DefaultTraitMethod(method, _)]: starts_at(method.start, 14, "pure")
                        _: False
                _:
                    False
        None:
            False


pure func test_private_annotated_function_starts_at_private() -> Bool:
    match contents_of("private @tail_recursive\nfunc loop(n: Int) -> Int:\n\tloop(n)\n"):
        Some(contents):
            match contents.functions:
                [FreeFunction(function)]: starts_at(function.start, 0, "private")
                _: False
        None:
            False


pure func test_private_constant_starts_at_private() -> Bool:
    match contents_of("private COUNT: Int = 3\n"):
        Some(contents):
            match contents.constants:
                [count]: starts_at(count.start, 0, "private")
                _: False
        None:
            False


pure func test_builtin_type_declaration_starts_at_type() -> Bool:
    match contents_of("type Int = builtin\ntype Float = builtin\n"):
        Some(contents):
            match contents.builtin_types:
                [integer, float]:
                    and(starts_at(integer.start, 0, "type"), starts_at(float.start, 19, "type"))
                _:
                    False
        None:
            False


-- A List declaration records its element parameter's name, which the
-- formatter prints.
pure func test_list_builtin_records_its_element_parameter() -> Bool:
    match contents_of("type List[Element] = builtin\n"):
        Some(contents):
            match contents.builtin_types:
                [declaration]:
                    match declaration.kind:
                        ListBuiltin(name, parameter):
                            and(
                                starts_at(name.span, 5, "List"),
                                starts_at(parameter.span, 10, "Element"),
                            )
                        _:
                            False
                _:
                    False
        None:
            False


TESTS: TestSuite = {
    description = "Blorp declaration starts",
    tests = [
        ("private pure function starts at private", test_private_pure_function_starts_at_private),
        (
            "pure function starts at pure and a bare one at func",
            test_pure_function_starts_at_pure_and_a_bare_one_at_func,
        ),
        (
            "annotated function starts at the annotation",
            test_annotated_function_starts_at_the_annotation,
        ),
        (
            "fixed record starts at fixed and private union at private",
            test_fixed_record_starts_at_fixed_and_private_union_at_private,
        ),
        ("bare keywords start at the keyword", test_bare_keywords_start_at_the_keyword),
        (
            "implementation and its methods start at their own tokens",
            test_implementation_and_its_methods_start_at_their_own_tokens,
        ),
        (
            "private annotated function starts at private",
            test_private_annotated_function_starts_at_private,
        ),
        ("private constant starts at private", test_private_constant_starts_at_private),
        ("builtin type declaration starts at type", test_builtin_type_declaration_starts_at_type),
        (
            "default trait method starts at its first token",
            test_default_trait_method_starts_at_its_first_token,
        ),
        (
            "List builtin records its element parameter",
            test_list_builtin_records_its_element_parameter,
        ),
    ],
}
