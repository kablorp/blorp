import:
    test: TestSuite
    ../driver/file_access: path_of, read_file


-- A failure reads "path: reason", with the operation's fixed phrase.
func test_a_missing_file_reads_as_path_and_reason() -> Bool:
    read_file("blorp/build/no-such-file.txt") == Err("blorp/build/no-such-file.txt: no such file")


pure func test_an_empty_text_reads_as_path_and_reason() -> Bool:
    path_of("") == Err(": a path cannot be empty")


TESTS: TestSuite = {
    description = "The end-to-end suites' file access",
    tests = [
        ("a missing file reads as path and reason", test_a_missing_file_reads_as_path_and_reason),
        ("an empty text reads as path and reason", test_an_empty_text_reads_as_path_and_reason),
    ],
}
