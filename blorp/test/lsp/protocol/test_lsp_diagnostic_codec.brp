import:
	../../../src/lsp/analysis/diagnostic_model:
		Diagnostic,
		DiagnosticPublication,
		DiagnosticSeverity(ErrorDiagnostic),
	../../../src/lsp/protocol/diagnostic_codec:
		encode_lsp_clear_diagnostics,
		encode_lsp_diagnostic_publication,
	../../../src/lsp/protocol/identity: DocumentUri, document_uri
	../../../src/lsp/protocol/position: position
	../../../src/lsp/workspace/document_model: document_version
	../../../src/lsp/workspace/snapshot_model:
		INITIAL_CONFIGURATION_EPOCH,
		INITIAL_WORKSPACE_REVISION,
		snapshot_identity,
	json: JsonValue, as_array, as_number, as_string, get_field, parse_json
	test: TestSuite


private pure func uri() -> DocumentUri:
	document_uri("file:///workspace/main.brp")


private pure func publication() -> Option[DiagnosticPublication]:
	match document_version(7):
		None:
			None
		Some(version):
			diagnostic: Diagnostic = {
				range = {
					start = position(2, 3),
					end = position(2, 5)
				},
				severity = ErrorDiagnostic,
				code = Some("parse"),
				message = "expected expression"
			}
			Some({
				identity = snapshot_identity(
					uri(),
					Some(version),
					INITIAL_WORKSPACE_REVISION,
					INITIAL_CONFIGURATION_EPOCH,
				),
				diagnostics = [diagnostic],
			})


private pure func decode(body: String) -> Option[JsonValue]:
	match parse_json(body):
		Ok(value):
			Some(value)
		Err(_):
			None


private pure func first_diagnostic(value: JsonValue) -> Option[JsonValue]:
	params ?= get_field(value, "params")
	diagnostics ?= get_field(params, "diagnostics")
	items ?= diagnostics.as_array()
	items.get(0)


private record DecodedDiagnosticPublication {
	message: JsonValue,
	params: JsonValue,
	diagnostic: JsonValue,
	start: JsonValue
}


private pure func decoded_publication(body: String) -> Option[DecodedDiagnosticPublication]:
	message ?= decode(body)
	params ?= get_field(message, "params")
	diagnostic ?= first_diagnostic(message)
	range ?= get_field(diagnostic, "range")
	start ?= get_field(range, "start")
	Some({
		message = message,
		params = params,
		diagnostic = diagnostic,
		start = start,
	})


private pure func decoded_diagnostic_items(body: String) -> Option[(JsonValue, List[JsonValue])]:
	message ?= decode(body)
	params ?= get_field(message, "params")
	diagnostics ?= get_field(params, "diagnostics")
	items ?= diagnostics.as_array()
	Some((params, items))


private pure func string_field(value: JsonValue, name: String) -> Option[String]:
	field ?= get_field(value, name)
	field.as_string()


private pure func number_field(value: JsonValue, name: String) -> Option[Float]:
	field ?= get_field(value, name)
	field.as_number()


func test_encode_versioned_diagnostic_publication() -> Bool:
	match publication():
		None:
			False
		Some(value):
			body = encode_lsp_diagnostic_publication(value, True)

			match decoded_publication(body):
				None:
					False
				Some(decoded):
					(
						string_field(decoded.message, "jsonrpc") == Some("2.0")
						and string_field(
							decoded.message,
							"method",
						) == Some("textDocument/publishDiagnostics")
						and string_field(
							decoded.params,
							"uri",
						) == Some("file:///workspace/main.brp")
						and number_field(decoded.params, "version") == Some(7.0)
						and number_field(decoded.diagnostic, "severity") == Some(1.0)
						and string_field(decoded.diagnostic, "source") == Some("blorp")
						and string_field(decoded.diagnostic, "code") == Some("parse")
						and string_field(
							decoded.diagnostic,
							"message",
						) == Some("expected expression")
						and number_field(decoded.start, "line") == Some(2.0)
						and number_field(decoded.start, "character") == Some(3.0)
					)


func test_unversioned_client_omits_diagnostic_version() -> Bool:
	match publication():
		None:
			False
		Some(value):
			match decode(encode_lsp_diagnostic_publication(value, False)):
				None:
					False
				Some(json):
					match get_field(json, "params"):
						Some(params):
							get_field(params, "version") == None
						None:
							False


func test_encode_clear_diagnostics() -> Bool:
	match decoded_diagnostic_items(encode_lsp_clear_diagnostics(uri())):
		None:
			False
		Some((params, items)):
			(
				string_field(params, "uri") == Some("file:///workspace/main.brp")
				and get_field(params, "version") == None
				and items.is_empty()
			)


tests: TestSuite = {
	description = "Compiler LSP diagnostic codec",
	tests = [
		("encode versioned diagnostic publication", test_encode_versioned_diagnostic_publication),
		("omit versions for unsupported clients", test_unversioned_client_omits_diagnostic_version),
		("encode diagnostic clearing", test_encode_clear_diagnostics),
	]
}
