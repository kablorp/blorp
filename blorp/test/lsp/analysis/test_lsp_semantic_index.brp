	test: TestSuite


private SOURCE: String =
	|ANSWER = 41
	|private OFFSET = 1
	|
	|pure func helper(value: Int) -> Int:
	|	value
	|
	|private pure func hidden(value: Int) -> Int:
	|	value + OFFSET
	|
	|pure func shadows(ANSWER: Int) -> Int:
	|	ANSWER
	|
	|func main(args: List[String]):
	|	result = helper(hidden(ANSWER))
	|	print(result.to_string())


private pure func graph_request() -> TypecheckGraphRequest:
	target: TypecheckImportModule = {
		path = "/workspace/main.brp",
		module_name = "main",
		module_path = "main",
		text = SOURCE,
		typecheck_program = None,
		origin = UserModule
	}
	{
		target = target,
		modules = [],
		module_targets = [],
		resolved_imports = [],
		include_comments = False,
		allow_debug_only_calls = False
	}


private pure func graph_request_for_source(source: String) -> TypecheckGraphRequest:
	request = graph_request()
	{ request | target = { request.target | text = source } }


private pure func graph_with_failed_dependency() -> TypecheckedGraph:
	base = typecheck_graph(graph_request())
	dependency = { base.target |
		path = "/workspace/broken.brp",
		module_name = "broken",
		module_path = "broken",
		module_identity = ANONYMOUS_IDENTITY,
		errors = ["dependency analysis failed"]
	}
	{ base | modules = [dependency] }


private pure func exported_name(symbol: SemanticSymbolId) -> Option[String]:
	match symbol:
		ExportedSemanticSymbol(exported):
			exported_id: ExportedSymbolId = exported
			Some(exported_symbol_key_name(exported_id.key))
		ArtifactLocalSemanticSymbol(_):
			None


private pure func local_id(symbol: SemanticSymbolId) -> Option[Int]:
	match symbol:
		ArtifactLocalSemanticSymbol(local):
			local_id: ArtifactLocalSymbolId = local
			Some(local_id.definition_id)
		ExportedSemanticSymbol(_):
			None


private pure func local_field_id(symbol: SemanticSymbolId) -> Option[Int]:
	match symbol:
		ArtifactLocalSemanticSymbol(local):
			local_id: ArtifactLocalSymbolId = local

			if local_id.kind == SemanticField:
				Some(local_id.definition_id)
			else:
				None
		ExportedSemanticSymbol(_):
			None


private pure func definition_named(
	definitions: List[DefinitionEntry],
	name: String,
) -> Option[DefinitionEntry]:
	definitions.find(func(definition): exported_name(definition.symbol) == Some(name))


private pure func same_selection_range(left: DefinitionEntry, right: DefinitionEntry) -> Bool:
	(
		left.selection_range.start.line == right.selection_range.start.line
		and left.selection_range.start.utf16_character == right.selection_range.start.utf16_character
		and left.selection_range.end.line == right.selection_range.end.line
		and left.selection_range.end.utf16_character == right.selection_range.end.utf16_character
	)


func test_extracts_callable_definitions_and_references() -> Bool:
	graph = typecheck_graph(graph_request())
	artifact_id: SemanticArtifactId = semantic_artifact_id_from_value("semantic-index-test")

	match semantic_index_for_target(artifact_id, document_uri("file:///workspace/main.brp"), graph):
		Err(_):
			False
		Ok(index):
			semantic_index: ModuleSemanticIndex = index
			definitions = module_semantic_index_definitions(semantic_index)
			references = module_semantic_index_references(semantic_index)

			match (
				(
					definition_named(definitions, "helper"),
					definition_named(definitions, "main"),
					definitions.find(func(definition):
						(
							local_id(definition.symbol).is_some()
							and definition.selection_range.start.line == 6
						)
					),
				)
			):
				(Some(helper), Some(main), Some(hidden)):
					helper_references = references.filter(func(reference):
						exported_name(reference.symbol) == Some("helper")
					)
					hidden_references = references.filter(func(reference):
						local_id(reference.symbol) == local_id(hidden.symbol)
					)
					declaration_symbol = module_semantic_index_symbol_at(
						semantic_index,
						document_uri("file:///workspace/main.brp"),
						position(3, 12),
					)
					call_symbol = module_semantic_index_symbol_at(
						semantic_index,
						document_uri("file:///workspace/main.brp"),
						position(13, 12),
					)

					(
						graph.target.errors.length() == 0
						and helper.hover_contents == "helper: pure (Int) -> Int"
						and definitions.length() == 6
						and module_semantic_index_supports(
							semantic_index,
							FunctionSemanticIndexCapability,
						)
						and module_semantic_index_supports(
							semantic_index,
							GlobalSemanticIndexCapability,
						)
						and helper.location.range.start.line == 3
						and helper.selection_range.start.utf16_character == 10
						and helper.location.range.end.line == 4
						and main.location.range.start.line == 12
						and helper_references.length() == 2
						and helper_references.any(func(reference): not reference.is_declaration)
						and helper_references.any(func(reference): reference.is_declaration)
						and hidden_references.length() == 2
						and hidden_references.any(func(reference): not reference.is_declaration)
						and hidden_references.any(func(reference): reference.is_declaration)
						and declaration_symbol
							.map(func(symbol):
								semantic_symbol_ids_equal(symbol, helper.symbol)
							)
							.get_or(False)
						and call_symbol
							.map(func(symbol):
								semantic_symbol_ids_equal(symbol, helper.symbol)
							)
							.get_or(False)
						and module_semantic_index_symbol_at(
							semantic_index,
							document_uri("file:///workspace/main.brp"),
							position(13, 9),
						).is_none()
						and module_semantic_index_definition(semantic_index, helper.symbol)
							.map(func(found):
								same_selection_range(found, helper)
							)
							.get_or(False)
						and module_semantic_index_references_for_symbol(
							semantic_index,
							helper.symbol,
						).length() == 2
					)
				_:
					False


func test_extracts_global_definitions_and_references() -> Bool:
	graph = typecheck_graph(graph_request())
	artifact_id: SemanticArtifactId = semantic_artifact_id_from_value("semantic-global-index-test")

	match semantic_index_for_target(artifact_id, document_uri("file:///workspace/main.brp"), graph):
		Err(_):
			False
		Ok(index):
			definitions = module_semantic_index_definitions(index)
			references = module_semantic_index_references(index)

			match (
				(
					definition_named(definitions, "ANSWER"),
					definitions.find(func(definition):
						(
							local_id(definition.symbol).is_some()
							and definition.selection_range.start.line == 1
						)
					),
				)
			):
				(Some(answer), Some(offset)):
					answer_references = references.filter(func(reference):
						exported_name(reference.symbol) == Some("ANSWER")
					)
					offset_references = references.filter(func(reference):
						local_id(reference.symbol) == local_id(offset.symbol)
					)

					(
						answer.hover_contents == "ANSWER: #41"
						and answer.selection_range.start.line == 0
						and answer_references.length() == 2
						and answer_references.any(func(reference): reference.is_declaration)
						and answer_references.any(func(reference): not reference.is_declaration)
						and offset_references.length() == 2
						and offset_references.any(func(reference): reference.is_declaration)
						and offset_references.any(func(reference): not reference.is_declaration)
						and not answer_references.any(func(reference):
							reference.location.range.start.line == 10
						)
					)
				_:
					False


func test_preserves_initializer_and_assignment_references() -> Bool:
	source: String =
		|FIRST = 1
		|SECOND = FIRST + 1
		|var COUNTER: Int = 0
		|
		|func increment():
		|	COUNTER = COUNTER + 1
	graph = typecheck_graph(graph_request_for_source(source))

	artifact_id: SemanticArtifactId = semantic_artifact_id_from_value("semantic-global-write-test")

	match semantic_index_for_target(artifact_id, document_uri("file:///workspace/main.brp"), graph):
		Err(_):
			False
		Ok(index):
			definitions = module_semantic_index_definitions(index)
			references = module_semantic_index_references(index)

			match (
				definition_named(definitions, "FIRST"),
				definition_named(definitions, "COUNTER"),
			):
				(Some(first), Some(counter)):
					first_references = references.filter(func(reference):
						semantic_symbol_ids_equal(reference.symbol, first.symbol)
					)
					counter_references = references.filter(func(reference):
						semantic_symbol_ids_equal(reference.symbol, counter.symbol)
					)

					(
						first_references.length() == 2
						and first_references.any(func(reference):
							(
								not reference.is_declaration
								and reference.location.range.start.line == 1
							)
						)
						and counter_references.length() == 3
						and counter_references
							.filter(func(reference):
								(
									not reference.is_declaration
									and reference.location.range.start.line == 5
								)
							)
							.length() == 2
					)
				_:
					False


func test_extracts_constructor_definitions_and_references() -> Bool:
	source: String =
		|union Choice:
		|	None
		|	Some(Int)
		|
		|pure func choose(has_value: Bool) -> Choice:
		|	if has_value:
		|		Some(1)
		|	else:
		|		None
		|
		|pure func read(choice: Choice) -> Int:
		|	match choice:
		|		Some(value): value
		|		None: 0
	graph = typecheck_graph(graph_request_for_source(source))

	match semantic_index_for_target(
		semantic_artifact_id_from_value("semantic-constructor-index-test"),
		document_uri("file:///workspace/main.brp"),
		graph,
	):
		Err(_):
			False
		Ok(index):
			definitions = module_semantic_index_definitions(index)
			references = module_semantic_index_references(index)

			match (definition_named(definitions, "Some"), definition_named(definitions, "None")):
				(Some(some), Some(none)):
					some_references = references.filter(func(reference):
						semantic_symbol_ids_equal(reference.symbol, some.symbol)
					)
					none_references = references.filter(func(reference):
						semantic_symbol_ids_equal(reference.symbol, none.symbol)
					)

					(
						graph.target.errors.is_empty()
						and module_semantic_index_supports(
							index,
							ConstructorSemanticIndexCapability,
						)
						and some.selection_range.start.line == 2
						and none.selection_range.start.line == 1
						and some_references.length() == 3
						and none_references.length() == 3
						and some_references.any(func(reference):
							(
								not reference.is_declaration
								and reference.location.range.start.line == 6
							)
						)
						and some_references.any(func(reference):
							(
								not reference.is_declaration
								and reference.location.range.start.line == 12
							)
						)
						and none_references.any(func(reference):
							(
								not reference.is_declaration
								and reference.location.range.start.line == 8
							)
						)
						and none_references.any(func(reference):
							(
								not reference.is_declaration
								and reference.location.range.start.line == 13
							)
						)
					)
				_:
					False


func test_extracts_type_definitions_and_references() -> Bool:
	source: String =
		|record Box {value: Int}
		|private type alias Hidden = Box
		|union Choice:
		|	None
		|	Some(Box)
		|
		|pure func choose(value: Box) -> Choice:
		|	Some(value)
	graph = typecheck_graph(graph_request_for_source(source))

	match semantic_index_for_target(
		semantic_artifact_id_from_value("semantic-type-index-test"),
		document_uri("file:///workspace/main.brp"),
		graph,
	):
		Err(_):
			False
		Ok(index):
			definitions = module_semantic_index_definitions(index)
			references = module_semantic_index_references(index)
			hidden = definitions.find(func(definition):
				local_id(definition.symbol).is_some() and definition.selection_range.start.line == 1
			)

			match (
				definition_named(definitions, "Box"),
				definition_named(definitions, "Choice"),
				hidden,
			):
				(Some(box), Some(choice), Some(hidden_type)):
					box_references = references.filter(func(reference):
						semantic_symbol_ids_equal(reference.symbol, box.symbol)
					)
					choice_references = references.filter(func(reference):
						semantic_symbol_ids_equal(reference.symbol, choice.symbol)
					)
					hidden_references = references.filter(func(reference):
						semantic_symbol_ids_equal(reference.symbol, hidden_type.symbol)
					)

					(
						graph.target.errors.is_empty()
						and box.hover_contents == "type Box"
						and choice.hover_contents == "type Choice"
						and module_semantic_index_supports(index, TypeSemanticIndexCapability)
						and box_references.length() == 4
						and choice_references.length() == 2
						and hidden_references.length() == 1
						and box_references.any(func(reference):
							(
								not reference.is_declaration
								and reference.location.range.start.line == 1
							)
						)
						and box_references.any(func(reference):
							(
								not reference.is_declaration
								and reference.location.range.start.line == 4
							)
						)
						and box_references.any(func(reference):
							(
								not reference.is_declaration
								and reference.location.range.start.line == 6
							)
						)
						and choice_references.any(func(reference):
							(
								not reference.is_declaration
								and reference.location.range.start.line == 6
							)
						)
					)
				_:
					False


func test_extracts_distinct_record_field_definitions_and_references() -> Bool:
	source: String =
		|record Left[T] {value: T}
		|record Right {value: Int}
		|
		|pure func make_left() -> Left[Int]:
		|	{value = 1}
		|
		|pure func read_left(item: Left[Int]) -> Int:
		|	item.value
		|
		|pure func update_left(item: Left[Int]) -> Left[Int]:
		|	{ item | value = 2 }
		|
		|pure func make_right() -> Right:
		|	{value = 3}
		|
		|pure func read_right(item: Right) -> Int:
		|	item.value
	graph = typecheck_graph(graph_request_for_source(source))

	match semantic_index_for_target(
		semantic_artifact_id_from_value("semantic-field-index-test"),
		document_uri("file:///workspace/main.brp"),
		graph,
	):
		Err(_):
			False
		Ok(index):
			definitions = module_semantic_index_definitions(index)
			references = module_semantic_index_references(index)
			left = definitions.find(func(definition):
				(
					definition.selection_range.start.line == 0
					and definition.selection_range.start.utf16_character == 16
				)
			)
			right = definitions.find(func(definition):
				(
					definition.selection_range.start.line == 1
					and definition.selection_range.start.utf16_character == 14
				)
			)

			match (left, right):
				(Some(left_field), Some(right_field)):
					left_references = references.filter(func(reference):
						semantic_symbol_ids_equal(reference.symbol, left_field.symbol)
					)
					right_references = references.filter(func(reference):
						semantic_symbol_ids_equal(reference.symbol, right_field.symbol)
					)

					(
						graph.target.errors.is_empty()
						and module_semantic_index_supports(index, FieldSemanticIndexCapability)
						and left_field.hover_contents == "value: T"
						and right_field.hover_contents == "value: Int"
						and not semantic_symbol_ids_equal(left_field.symbol, right_field.symbol)
						and left_references.length() == 4
						and right_references.length() == 3
						and left_references.any(func(reference):
							(
								not reference.is_declaration
								and reference.location.range.start.line == 4
							)
						)
						and left_references.any(func(reference):
							(
								not reference.is_declaration
								and reference.location.range.start.line == 7
							)
						)
						and left_references.any(func(reference):
							(
								not reference.is_declaration
								and reference.location.range.start.line == 10
							)
						)
					)
				_:
					False


func test_extracts_callable_record_field_reference() -> Bool:
	source: String =
		|record Runner {run: pure (Int) -> Int}
		|
		|pure func invoke(runner: Runner) -> Int:
		|	runner.run(5)
	graph = typecheck_graph(graph_request_for_source(source))

	match semantic_index_for_target(
		semantic_artifact_id_from_value("semantic-callable-field-index-test"),
		document_uri("file:///workspace/main.brp"),
		graph,
	):
		Err(_):
			False
		Ok(index):
			match definition_named(module_semantic_index_definitions(index), "run"):
				Some(field):
					references = module_semantic_index_references_for_symbol(index, field.symbol)

					(
						graph.target.errors.is_empty()
						and field.hover_contents == "run: pure (Int) -> Int"
						and references.length() == 2
						and references.any(func(reference):
							(
								not reference.is_declaration
								and reference.location.range.start.line == 3
							)
						)
					)
				None:
					False


func test_private_constructor_uses_artifact_local_identity() -> Bool:
	source: String =
		|private union Hidden:
		|	Secret(Int)
		|
		|pure func reveal(value: Int) -> Hidden:
		|	Secret(value)
	graph = typecheck_graph(graph_request_for_source(source))

	match semantic_index_for_target(
		semantic_artifact_id_from_value("semantic-private-constructor-index-test"),
		document_uri("file:///workspace/main.brp"),
		graph,
	):
		Err(_):
			False
		Ok(index):
			definitions = module_semantic_index_definitions(index)
			secret = definitions.find(func(definition):
				local_id(definition.symbol).is_some() and definition.selection_range.start.line == 1
			)

			match secret:
				Some(found):
					is_constructor = match found.symbol:
						ArtifactLocalSemanticSymbol(local):
							local.kind == SemanticConstructor
						_:
							False

					callable_rejection = match callable_module_semantic_index(
						module_semantic_index_module_identity(index),
						module_semantic_index_artifact_id(index),
						document_uri("file:///workspace/main.brp"),
						[found],
						[],
					):
						Err(SemanticIndexInvalidCallableKind(symbol)):
							semantic_symbol_ids_equal(symbol, found.symbol)
						_:
							False

					references = module_semantic_index_references_for_symbol(index, found.symbol)

					(
						graph.target.errors.is_empty()
						and found.hover_contents == "Hidden.Secret(Int)"
						and is_constructor
						and callable_rejection
						and references.length() == 2
						and references.any(func(reference): reference.is_declaration)
						and references.any(func(reference):
							(
								not reference.is_declaration
								and reference.location.range.start.line == 4
							)
						)
					)
				None:
					False


func test_private_record_field_uses_artifact_local_identity() -> Bool:
	source: String =
		|private record Hidden {value: Int}
		|
		|pure func make() -> Hidden:
		|	{value = 1}
		|
		|pure func read(hidden: Hidden) -> Int:
		|	hidden.value
	graph = typecheck_graph(graph_request_for_source(source))

	match semantic_index_for_target(
		semantic_artifact_id_from_value("semantic-private-field-index-test"),
		document_uri("file:///workspace/main.brp"),
		graph,
	):
		Err(_):
			False
		Ok(index):
			definition = module_semantic_index_definitions(index).find(func(candidate):
				(
					local_field_id(candidate.symbol).is_some()
					and candidate.selection_range.start.line == 0
				)
			)

			match definition:
				Some(field):
					references = module_semantic_index_references_for_symbol(index, field.symbol)

					(
						graph.target.errors.is_empty()
						and field.hover_contents == "value: Int"
						and references.length() == 3
						and references.any(func(reference):
							(
								not reference.is_declaration
								and reference.location.range.start.line == 3
							)
						)
						and references.any(func(reference):
							(
								not reference.is_declaration
								and reference.location.range.start.line == 6
							)
						)
					)
				None:
					False


private func semantic_index_constructor_rejects_ambiguous_indexes() -> Option[Bool]:
	graph = typecheck_graph(graph_request())
	artifact_id: SemanticArtifactId = semantic_artifact_id_from_value("semantic-index-validation")
	index ?= semantic_index_for_target(
		artifact_id,
		document_uri("file:///workspace/main.brp"),
		graph,
	).to_option()
	definitions = module_semantic_index_definitions(index)
	first ?= definition_named(definitions, "helper")
	second ?= definition_named(definitions, "main")
	first_reference ?= module_semantic_index_references(index).find(func(reference):
		not reference.is_declaration and semantic_symbol_ids_equal(reference.symbol, first.symbol)
	)
	private_callable ?= definitions.find(func(definition):
		local_id(definition.symbol).is_some() and definition.selection_range.start.line == 6
	)
	private_reference ?= module_semantic_index_references(index).find(func(reference):
		(
			not reference.is_declaration
			and semantic_symbol_ids_equal(reference.symbol, private_callable.symbol)
		)
	)
	conflicting_second: DefinitionEntry = { second |
		location = first.location,
		selection_range = first.selection_range
	}
	module_identity = module_semantic_index_module_identity(index)
	index_artifact_id = module_semantic_index_artifact_id(index)
	revision ?= workspace_revision(0)
	snapshot: SemanticIndexSnapshot = {
		workspace_revision = revision,
		modules = [index],
		coverage = CompleteIndexCoverage
	}
	capability_coverage = semantic_index_coverage_for_capability(
		snapshot,
		ParameterSemanticIndexCapability,
	)
	partial_graph = graph_with_failed_dependency()
	partial_artifact_id: SemanticArtifactId = semantic_artifact_id_from_value(
		"semantic-index-partial-capability-test",
	)
	partial_index ?= semantic_index_for_target(
		partial_artifact_id,
		document_uri("file:///workspace/main.brp"),
		partial_graph,
	).to_option()
	partial_snapshot: SemanticIndexSnapshot = { snapshot | modules = [partial_index] }
	partial_capability_coverage = semantic_index_coverage_for_capability(
		partial_snapshot,
		FunctionSemanticIndexCapability,
	)
	already_partial_snapshot: SemanticIndexSnapshot = { partial_snapshot |
		coverage = PartialIndexCoverageState(
			{missing_modules = [
					{
						uri = document_uri("file:///workspace/main.brp"),
						module_identity = module_semantic_index_module_identity(partial_index),
						reason = IndexExtractionFailed
					},
				]},
		)
	}
	already_partial_coverage = semantic_index_coverage_for_capability(
		already_partial_snapshot,
		FunctionSemanticIndexCapability,
	)

	uri = document_uri("file:///workspace/main.brp")
	missing_module_ok = semantic_index_module_for_uri(
		snapshot,
		document_uri("file:///workspace/missing.brp"),
	).is_none()
	stale_index = StaleSemanticIndex(snapshot, revision)
	unavailable_index = SemanticIndexUnavailable(revision)
	all_unavailable_queries_return_none = definition_query_snapshot(
		stale_index,
		uri,
		position(3, 12),
	).is_none() and references_query_snapshot(
		None,
		uri,
		position(3, 12),
		True,
	).is_none() and hover_query_snapshot(
		stale_index,
		uri,
		position(3, 12),
	).is_none() and document_highlights_query_snapshot(
		stale_index,
		uri,
		position(3, 12),
	).is_none() and document_symbols_query_snapshot(
		stale_index,
		uri,
	).is_none() and definition_query_snapshot(
		unavailable_index,
		uri,
		position(3, 12),
	).is_none() and references_query_snapshot(
		None,
		uri,
		position(3, 12),
		True,
	).is_none() and hover_query_snapshot(
		unavailable_index,
		uri,
		position(3, 12),
	).is_none() and document_highlights_query_snapshot(
		unavailable_index,
		uri,
		position(3, 12),
	).is_none() and document_symbols_query_snapshot(unavailable_index, uri).is_none()

	duplicate_definition_ok = match (
		callable_module_semantic_index(
			module_identity,
			index_artifact_id,
			uri,
			[first, first],
			[],
		)
	):
		Err(SemanticIndexDuplicateDefinition(_)):
			True
		_:
			False

	position_conflict_ok = match (
		callable_module_semantic_index(
			module_identity,
			index_artifact_id,
			uri,
			[first, conflicting_second],
			[],
		)
	):
		Err(SemanticIndexPositionConflict(_, _, _)):
			True
		_:
			False

	outside: DefinitionEntry = { first | selection_range = {
			start = position(20, 0),
			end = position(20, 1)
		} }

	invalid_range_ok = match callable_module_semantic_index(
		module_identity,
		index_artifact_id,
		uri,
		[outside],
		[],
	):
		Err(SemanticIndexInvalidSelectionRange(_)):
			True
		_:
			False

	wrong_uri_definition: DefinitionEntry = { first |
		location = { first.location | uri = document_uri("file:///workspace/other.brp") }
	}

	wrong_uri_ok = match callable_module_semantic_index(
		module_identity,
		index_artifact_id,
		uri,
		[wrong_uri_definition],
		[],
	):
		Err(SemanticIndexLocationUriMismatch(_, _)):
			True
		_:
			False

	negative_declaration: DefinitionEntry = { first |
		location = { first.location | range = { first.location.range | start = position(-1, 0) } }
	}

	invalid_declaration_ok = match callable_module_semantic_index(
		module_identity,
		index_artifact_id,
		uri,
		[negative_declaration],
		[],
	):
		Err(SemanticIndexInvalidSelectionRange(_)):
			True
		_:
			False

	dangling_local_reference_ok = match callable_module_semantic_index(
		module_identity,
		index_artifact_id,
		uri,
		[],
		[private_reference],
	):
		Err(SemanticIndexMissingOwnedDefinition(symbol)):
			semantic_symbol_ids_equal(symbol, private_callable.symbol)
		_:
			False

	dangling_owned_export_reference_ok = match callable_module_semantic_index(
		module_identity,
		index_artifact_id,
		uri,
		[],
		[first_reference],
	):
		Err(SemanticIndexMissingOwnedDefinition(symbol)):
			semantic_symbol_ids_equal(symbol, first.symbol)
		_:
			False

	imported_export_reference_ok = match callable_module_semantic_index(
		ANONYMOUS_IDENTITY,
		index_artifact_id,
		uri,
		[],
		[first_reference],
	):
		Ok(_):
			True
		_:
			False

	imported_reference_index ?= callable_module_semantic_index(
		ANONYMOUS_IDENTITY,
		index_artifact_id,
		uri,
		[],
		[first_reference],
	).to_option()
	complete_missing_definition_snapshot: SemanticIndexSnapshot = { snapshot |
		modules = [imported_reference_index]
	}
	definition_only_index ?= callable_module_semantic_index(
		module_identity,
		index_artifact_id,
		uri,
		[first],
		[],
	).to_option()
	definition_only_snapshot: SemanticIndexSnapshot = { snapshot |
		modules = [definition_only_index]
	}
	empty_index ?= empty_module_semantic_index(module_identity, index_artifact_id, uri).to_option()
	empty_snapshot: SemanticIndexSnapshot = { snapshot | modules = [empty_index] }

	capability_coverage_ok = match capability_coverage:
		PartialIndexCoverageState(partial):
			match partial.missing_modules.get(0):
				Some(missing):
					(
						partial.missing_modules.length() == 1
						and missing.reason == IndexCapabilityUnavailable
					)
				None:
					False
		_:
			False

	partial_capability_coverage_ok = match partial_capability_coverage:
		PartialIndexCoverageState(partial):
			match partial.missing_modules.get(0):
				Some(missing):
					(
						partial.missing_modules.length() == 1
						and missing.reason == IndexExtractionFailed
					)
				None:
					False
		_:
			False

	already_partial_coverage_ok = match already_partial_coverage:
		PartialIndexCoverageState(partial):
			partial.missing_modules.length() == 1
		_:
			False

	partial_reference_query_ok = references_query_snapshot(
		None,
		uri,
		position(3, 12),
		True,
	).is_none()

	complete_reference_query_ok = references_query_snapshot(
		None,
		uri,
		position(3, 12),
		True,
	).is_none()
	complete_empty_reference_query_ok = references_query_snapshot(
		None,
		uri,
		second.selection_range.start,
		False,
	).is_none()
	complete_missing_definition_ok = definition_query_snapshot(
		CurrentSemanticIndex(complete_missing_definition_snapshot),
		uri,
		first_reference.location.range.start,
	)
		.map(func(locations): locations.is_empty())
		.get_or(False)
	complete_empty_highlight_ok = document_highlights_query_snapshot(
		CurrentSemanticIndex(definition_only_snapshot),
		uri,
		first.selection_range.start,
	)
		.map(func(highlights): highlights.is_empty())
		.get_or(False)
	complete_empty_document_symbols_ok = document_symbols_query_snapshot(
		CurrentSemanticIndex(empty_snapshot),
		uri,
	)
		.map(func(symbols): symbols.is_empty())
		.get_or(False)

	definition_without_identity_ok = definition_query_snapshot(
		CurrentSemanticIndex(snapshot),
		uri,
		position(2, 0),
	).is_none()

	Some(
		(
			duplicate_definition_ok
			and position_conflict_ok
			and invalid_range_ok
			and wrong_uri_ok
			and invalid_declaration_ok
			and dangling_local_reference_ok
			and dangling_owned_export_reference_ok
			and imported_export_reference_ok
			and missing_module_ok
			and all_unavailable_queries_return_none
			and capability_coverage_ok
			and partial_capability_coverage_ok
			and already_partial_coverage_ok
			and partial_reference_query_ok
			and complete_reference_query_ok
			and complete_empty_reference_query_ok
			and complete_missing_definition_ok
			and complete_empty_highlight_ok
			and complete_empty_document_symbols_ok
			and definition_without_identity_ok
		),
	)


func test_semantic_index_constructor_rejects_ambiguous_indexes() -> Bool:
	semantic_index_constructor_rejects_ambiguous_indexes().get_or(False)


private func position_bucket_case() -> Option[Bool]:
	graph = typecheck_graph(graph_request())
	artifact_id: SemanticArtifactId = semantic_artifact_id_from_value(
		"semantic-index-position-buckets",
	)
	uri = document_uri("file:///workspace/main.brp")
	index ?= semantic_index_for_target(artifact_id, uri, graph).to_option()
	definitions = module_semantic_index_definitions(index)
	first ?= definition_named(definitions, "helper")
	second ?= definition_named(definitions, "main")
	reference ?= module_semantic_index_references(index).find(func(candidate):
		not candidate.is_declaration and semantic_symbol_ids_equal(candidate.symbol, first.symbol)
	)

	nested_range: ProtocolRange = {
		start = position(3, 0),
		end = position(3, 12)
	}
	nested_reference: ReferenceEntry = { reference | location = {
			uri = uri,
			range = nested_range
		} }
	nested_index ?= callable_module_semantic_index(
		module_semantic_index_module_identity(index),
		module_semantic_index_artifact_id(index),
		uri,
		[first],
		[nested_reference],
	).to_option()
	nested_hit = module_semantic_index_symbol_at(
		nested_index,
		uri,
		position(3, 2),
	)
		.map(func(symbol): semantic_symbol_ids_equal(symbol, first.symbol))
		.get_or(False)

	first_range: ProtocolRange = {
		start = position(3, 0),
		end = position(3, 8)
	}
	first_selection_range: ProtocolRange = {
		start = position(3, 0),
		end = position(3, 5)
	}
	adjacent_first: DefinitionEntry = { first |
		location = { first.location | range = first_range },
		selection_range = first_selection_range
	}
	second_range: ProtocolRange = {
		start = position(3, 8),
		end = position(3, 16)
	}
	second_selection_range: ProtocolRange = {
		start = position(3, 8),
		end = position(3, 13)
	}
	adjacent_second: DefinitionEntry = { second |
		location = { second.location | range = second_range },
		selection_range = second_selection_range
	}
	adjacent_index ?= callable_module_semantic_index(
		module_semantic_index_module_identity(index),
		module_semantic_index_artifact_id(index),
		uri,
		[adjacent_first, adjacent_second],
		[],
	).to_option()
	first_hit = module_semantic_index_symbol_at(
		adjacent_index,
		uri,
		position(3, 2),
	)
		.map(func(symbol): semantic_symbol_ids_equal(symbol, first.symbol))
		.get_or(False)
	second_hit = module_semantic_index_symbol_at(
		adjacent_index,
		uri,
		position(3, 10),
	)
		.map(func(symbol): semantic_symbol_ids_equal(symbol, second.symbol))
		.get_or(False)

	Some(nested_hit and first_hit and second_hit)


func test_position_buckets_preserve_nested_and_adjacent_ranges() -> Bool:
	position_bucket_case().get_or(False)


func test_unresolved_dependency_marks_target_index_partial() -> Bool:
	graph = graph_with_failed_dependency()
	artifact_id: SemanticArtifactId = semantic_artifact_id_from_value(
		"semantic-index-partial-dependency-test",
	)

	match semantic_index_for_target(artifact_id, document_uri("file:///workspace/main.brp"), graph):
		Err(_):
			False
		Ok(index):
			module_semantic_index_coverage(index) == PartialModuleSemanticIndex


private pure func document_symbols_case() -> Option[Bool]:
	graph = typecheck_graph(graph_request())
	artifact_id: SemanticArtifactId = semantic_artifact_id_from_value(
		"semantic-index-document-symbols",
	)
	uri = document_uri("file:///workspace/main.brp")
	index ?= semantic_index_for_target(artifact_id, uri, graph).to_option()
	revision ?= workspace_revision(0)
	snapshot: SemanticIndexSnapshot = {
		workspace_revision = revision,
		modules = [index],
		coverage = CompleteIndexCoverage
	}

	match document_symbols_query_snapshot(CurrentSemanticIndex(snapshot), uri):
		Some(symbols):
			names = symbols.map(func(symbol): symbol.name)
			kinds = symbols.map(func(symbol): symbol.kind)

			Some((
					names == ["ANSWER", "OFFSET", "helper", "hidden", "shadows", "main"]
					and kinds.get(0) == Some(DocumentSymbolVariable)
					and kinds.get(2) == Some(DocumentSymbolFunction)
					and symbols
						.get(2)
						.map(func(symbol):
							(
								symbol.selection_range.start.line == 3
								and symbol.selection_range.start.utf16_character == 10
							)
						)
						.get_or(False)
				))
		None:
			Some(False)


func test_document_symbols_preserve_names_and_source_order() -> Bool:
	document_symbols_case().get_or(False)


private pure func document_symbol_kind_case() -> Option[Bool]:
	source: String =
		|record Box {value: Int}
		|union Choice:
		| None
		| Some(Box)
	graph = typecheck_graph(graph_request_for_source(source))
	artifact_id: SemanticArtifactId = semantic_artifact_id_from_value(
		"semantic-index-document-symbol-kinds",
	)
	uri = document_uri("file:///workspace/main.brp")
	index ?= semantic_index_for_target(artifact_id, uri, graph).to_option()
	revision ?= workspace_revision(0)
	snapshot: SemanticIndexSnapshot = {
		workspace_revision = revision,
		modules = [index],
		coverage = CompleteIndexCoverage
	}

	match document_symbols_query_snapshot(CurrentSemanticIndex(snapshot), uri):
		Some(symbols):
			Some(symbols.any(func(symbol):
					symbol.name == "Box" and symbol.kind == DocumentSymbolClass
				) and symbols.any(func(symbol):
					symbol.name == "value" and symbol.kind == DocumentSymbolField
				) and symbols.any(func(symbol):
					symbol.name == "None" and symbol.kind == DocumentSymbolConstructor
				) and symbols.any(func(symbol):
					symbol.name == "Some" and symbol.kind == DocumentSymbolConstructor
				))
		None:
			Some(False)


func test_document_symbols_map_declaration_kinds() -> Bool:
	document_symbol_kind_case().get_or(False)


tests: TestSuite = {
	description = "Compiler LSP semantic index extraction",
	tests = [
		(
			"extract callable definitions and references",
			test_extracts_callable_definitions_and_references,
		),
		(
			"extract global definitions and references",
			test_extracts_global_definitions_and_references,
		),
		(
			"preserve initializer and assignment references",
			test_preserves_initializer_and_assignment_references,
		),
		(
			"extract constructor definitions and references",
			test_extracts_constructor_definitions_and_references,
		),
		("extract type definitions and references", test_extracts_type_definitions_and_references),
		(
			"extract distinct record field definitions and references",
			test_extracts_distinct_record_field_definitions_and_references,
		),
		("extract callable record field reference", test_extracts_callable_record_field_reference),
		(
			"private constructor uses artifact-local identity",
			test_private_constructor_uses_artifact_local_identity,
		),
		(
			"private record field uses artifact-local identity",
			test_private_record_field_uses_artifact_local_identity,
		),
		(
			"reject ambiguous semantic indexes",
			test_semantic_index_constructor_rejects_ambiguous_indexes,
		),
		(
			"position buckets preserve nested and adjacent ranges",
			test_position_buckets_preserve_nested_and_adjacent_ranges,
		),
		(
			"unresolved dependency marks target index partial",
			test_unresolved_dependency_marks_target_index_partial,
		),
		(
			"document symbols preserve names and source order",
			test_document_symbols_preserve_names_and_source_order,
		),
		("document symbols map declaration kinds", test_document_symbols_map_declaration_kinds),
	]
}
