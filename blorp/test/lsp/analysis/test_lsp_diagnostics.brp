		workspace_revision_value,
	test: TestSuite


private LSP_TEST_URI_TEXT: String = "file:///workspace/main.brp"


private pure func test_uri() -> DocumentUri:
	document_uri(LSP_TEST_URI_TEXT)


private pure func source(text: String) -> SourceFile:
	source_file("/workspace/main.brp", "main", text)


private pure func unicode_source_text() -> String:
	"a" + from_char(to_char(128512)) + "b\r\n" + from_char(to_char(233)) + "x"


private pure func position_result_is(
	result: Result[ProtocolPosition, PositionMappingError],
	line: Int,
	utf16_character: Int,
) -> Bool:
	match result:
		Ok(position):
			position.line == line and position.utf16_character == utf16_character
		Err(_):
			False


private pure func source_offset_result_is(
	result: Result[SourceByteOffset, PositionMappingError],
	expected: Int,
) -> Bool:
	match result:
		Ok(offset):
			source_byte_offset_value(offset) == expected
		Err(_):
			False


func test_source_offsets_map_to_utf16_positions() -> Bool:
	src = source(unicode_source_text())

	position_result_is(
		source_offset_to_position(test_uri(), src, 0),
		0,
		0,
	) and position_result_is(
		source_offset_to_position(test_uri(), src, 1),
		0,
		1,
	) and position_result_is(
		source_offset_to_position(test_uri(), src, 5),
		0,
		3,
	) and position_result_is(
		source_offset_to_position(test_uri(), src, 6),
		0,
		4,
	) and position_result_is(
		source_offset_to_position(test_uri(), src, 7),
		0,
		4,
	) and position_result_is(
		source_offset_to_position(test_uri(), src, 8),
		1,
		0,
	) and position_result_is(
		source_offset_to_position(test_uri(), src, 10),
		1,
		1,
	) and position_result_is(
		source_offset_to_position(test_uri(), src, 11),
		1,
		2,
	)


func test_source_offset_rejects_utf8_interior() -> Bool:
	src = source(unicode_source_text())

	match source_offset_to_position(test_uri(), src, 3):
		Err(SourceOffsetSplitsCodePoint(uri, offset)):
			uri == test_uri() and offset == 3
		_:
			False


func test_utf16_positions_map_to_source_offsets_and_clamp_columns() -> Bool:
	src = source(unicode_source_text())

	source_offset_result_is(
		position_to_source_offset(
			test_uri(),
			src,
			position(0, 0),
		),
		0,
	) and source_offset_result_is(
		position_to_source_offset(
			test_uri(),
			src,
			position(0, 1),
		),
		1,
	) and source_offset_result_is(
		position_to_source_offset(
			test_uri(),
			src,
			position(0, 3),
		),
		5,
	) and source_offset_result_is(
		position_to_source_offset(
			test_uri(),
			src,
			position(0, 99),
		),
		6,
	) and source_offset_result_is(
		position_to_source_offset(
			test_uri(),
			src,
			position(1, 1),
		),
		10,
	) and source_offset_result_is(
		position_to_source_offset(
			test_uri(),
			src,
			position(1, 99),
		),
		11,
	)


func test_utf16_position_rejects_surrogate_interior() -> Bool:
	src = source(unicode_source_text())
	position = position(0, 2)

	match position_to_source_offset(test_uri(), src, position):
		Err(PositionSplitsSurrogatePair(uri, line, utf16_character)):
			(
				uri == test_uri()
				and line == position.line
				and utf16_character == position.utf16_character
			)
		_:
			False


func test_source_span_mapping_checks_source_identity() -> Bool:
	src = source("VALUE = 1\n")
	other = source_file("/workspace/other.brp", "other", src.text)
	span = source_span(
		other,
		source_cursor_at(other, 0),
		source_cursor_at(other, 5),
	)

	match source_span_to_range(test_uri(), src, span):
		Err(SpanSourceMismatch(uri, _)):
			uri == test_uri()
		_:
			False


private pure func snapshot_identity_for_version(version_value: Int) -> Option[SnapshotIdentity]:
	match (document_version(version_value), workspace_revision(4), configuration_epoch(2)):
		(Some(version), Some(revision), Some(epoch)):
			Some(snapshot_identity(test_uri(), Some(version), revision, epoch))
		_:
			None


private pure func analyze(version_value: Int, text: String) -> Option[DiagnosticPublication]:
	match snapshot_identity_for_version(version_value):
		None:
			None
		Some(identity):
			match identity.document_version:
				None:
					None
				Some(version):
					request = document_analysis_request(
						{
							uri = identity.uri,
							version = version,
							text = text
						},
						identity.workspace_revision,
						identity.configuration_epoch,
					)

					match analyze_syntax_diagnostics(request):
						Ok(publication):
							Some(publication)
						Err(_):
							None


private pure func snapshot_identities_match(
	left: SnapshotIdentity,
	right: SnapshotIdentity,
) -> Bool:
	versions_match: Bool = match (left.document_version, right.document_version):
		(Some(left_version), Some(right_version)):
			document_version_value(left_version) == document_version_value(right_version)
		(None, None):
			True
		_:
			False

	(
		left.uri == right.uri
		and versions_match
		and workspace_revision_value(
			left.workspace_revision,
		) == workspace_revision_value(right.workspace_revision)
		and configuration_epoch_value(
			left.configuration_epoch,
		) == configuration_epoch_value(right.configuration_epoch)
	)


func test_syntax_analysis_uses_production_parser_diagnostics() -> Bool:
	match (snapshot_identity_for_version(7), analyze(7, "func broken(:\n")):
		(Some(identity), Some(publication)):
			match publication.diagnostics.get(0):
				Some(diagnostic):
					(
						snapshot_identities_match(publication.identity, identity)
						and publication.diagnostics.length() > 0
						and diagnostic.severity == ErrorDiagnostic
						and diagnostic.message.length() > 0
					)
				None:
					False
		_:
			False


func test_valid_syntax_analysis_publishes_empty_diagnostics() -> Bool:
	match (snapshot_identity_for_version(8), analyze(8, "func main(): 0\n")):
		(Some(identity), Some(publication)):
			(
				snapshot_identities_match(publication.identity, identity)
				and publication.diagnostics.is_empty()
			)
		_:
			False


func test_typecheck_diagnostics_publish_only_exact_structured_spans() -> Bool:
	text: String = "alpha\nbeta"
	src: SourceFile = source(text)
	span = source_span(
		src,
		source_cursor_at(src, 6),
		source_cursor_at(src, 10),
	)

	match snapshot_identity_for_version(9):
		None:
			False
		Some(identity):
			match (
				typecheck_diagnostic_publication(
					identity,
					src,
					[
						typecheck_diagnostic("located type error", Some(span)),
						typecheck_diagnostic("unlocated type error", None),
					],
				)
			):
				Err(_):
					False
				Ok(publication):
					match publication.diagnostics:
						[diagnostic]:
							(
								diagnostic.message == "located type error"
								and diagnostic.code == Some("typecheck")
								and diagnostic.range.start.line == 1
								and diagnostic.range.start.utf16_character == 0
								and diagnostic.range.end.line == 1
								and diagnostic.range.end.utf16_character == 4
							)
						_:
							False


private pure func diagnostic(
	message: String,
	line: Int,
	severity: DiagnosticSeverity,
	code: Option[String],
) -> Diagnostic:
	{
		range = {
			start = position(line, 1),
			end = position(line, 4)
		},
		severity = severity,
		code = code,
		message = message
	}


func test_diagnostic_fragments_have_canonical_phase_order_and_exact_deduplication() -> Bool:
	match snapshot_identity_for_version(10):
		None:
			False
		Some(identity):
			duplicate = diagnostic("duplicate", 2, ErrorDiagnostic, Some("shared"))
			fragments: List[DiagnosticFragment] = [
				{
					phase = TypecheckDiagnosticPhase,
					diagnostics = [
						duplicate,
						diagnostic("typecheck", 5, ErrorDiagnostic, Some("typecheck")),
					]
				},
				{
					phase = DeclarationDiagnosticPhase,
					diagnostics = [diagnostic("declaration", 4, ErrorDiagnostic, None)]
				},
				{
					phase = ParseDiagnosticPhase,
					diagnostics = [duplicate, diagnostic("parse", 1, ErrorDiagnostic, None)]
				},
				{
					phase = SourceLoadingDiagnosticPhase,
					diagnostics = [diagnostic("source loading", 0, WarningDiagnostic, None)]
				},
				{
					phase = ImportDiagnosticPhase,
					diagnostics = [diagnostic("import", 3, ErrorDiagnostic, Some("import"))]
				},
			]
			publication = merge_diagnostic_fragments(identity, fragments)

			(
				publication.identity == identity
				and publication.diagnostics.map(
					func(
						value,
					): value.message,
				) == ["source loading", "duplicate", "parse", "import", "declaration", "typecheck"]
			)


func test_empty_diagnostic_fragments_create_clear_publication() -> Bool:
	match snapshot_identity_for_version(11):
		None:
			False
		Some(identity):
			publication = merge_diagnostic_fragments(identity, [])
			publication.identity == identity and publication.diagnostics.is_empty()


private pure func open_document_store(version_value: Int, text: String) -> Option[DocumentStore]:
	match document_version(version_value):
		None:
			None
		Some(version):
			document: VersionedDocumentText = {
				uri = test_uri(),
				version = version,
				text = text
			}
			opened: OpenedDocument = {
				document = document,
				language_id = "blorp"
			}

			match document_store_open(DOCUMENT_STORE_EMPTY, opened):
				Ok(store):
					Some(store)
				Err(_):
					None


func test_diagnostic_publication_requires_current_snapshot() -> Bool:
	match (
		open_document_store(7, "func broken(:\n"),
		analyze(7, "func broken(:\n"),
		workspace_revision(4),
		configuration_epoch(2),
	):
		(Some(store), Some(publication), Some(revision), Some(epoch)):
			diagnostic_publication_is_current(store, revision, epoch, publication)
		_:
			False


func test_newer_document_version_rejects_stale_diagnostics() -> Bool:
	match (
		open_document_store(7, "func broken(:\n"),
		analyze(7, "func broken(:\n"),
		document_version(8),
		workspace_revision(4),
	):
		(Some(store), Some(publication), Some(newer_version), Some(revision)):
			match configuration_epoch(2):
				None:
					False
				Some(epoch):
					match (
						document_store_change(
							store,
							{
								uri = test_uri(),
								version = newer_version,
								replacement_text = Some("func main(): 0\n")
							},
						)
					):
						Ok(changed_store):
							not diagnostic_publication_is_current(
								changed_store,
								revision,
								epoch,
								publication,
							)
						Err(_):
							False
		_:
			False


tests: TestSuite = {
	description = "Compiler LSP diagnostics",
	tests = [
		("source offsets map to UTF-16 positions", test_source_offsets_map_to_utf16_positions),
		("source offsets reject UTF-8 interiors", test_source_offset_rejects_utf8_interior),
		(
			"UTF-16 positions map to source offsets and clamp columns",
			test_utf16_positions_map_to_source_offsets_and_clamp_columns,
		),
		(
			"UTF-16 positions reject surrogate interiors",
			test_utf16_position_rejects_surrogate_interior,
		),
		(
			"source span mapping checks source identity",
			test_source_span_mapping_checks_source_identity,
		),
		(
			"syntax analysis uses production parser diagnostics",
			test_syntax_analysis_uses_production_parser_diagnostics,
		),
		(
			"valid syntax analysis publishes empty diagnostics",
			test_valid_syntax_analysis_publishes_empty_diagnostics,
		),
		(
			"typecheck diagnostics publish only exact structured spans",
			test_typecheck_diagnostics_publish_only_exact_structured_spans,
		),
		(
			"diagnostic fragments use canonical phase order and exact deduplication",
			test_diagnostic_fragments_have_canonical_phase_order_and_exact_deduplication,
		),
		(
			"empty diagnostic fragments create a clear publication",
			test_empty_diagnostic_fragments_create_clear_publication,
		),
		(
			"diagnostic publication requires current snapshot",
			test_diagnostic_publication_requires_current_snapshot,
		),
		(
			"newer document versions reject stale diagnostics",
			test_newer_document_version_rejects_stale_diagnostics,
		),
	]
}
