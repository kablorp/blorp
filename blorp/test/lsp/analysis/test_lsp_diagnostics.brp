import:
	../../../src/lib/source: SourceFile, source_cursor_at, source_file, source_span
	../../../src/compiler/stage_06_typecheck/diagnostic: typecheck_diagnostic
	../../../src/lsp/analysis/diagnostic:
		DiagnosticFragment,
		DiagnosticPhase(
			DeclarationDiagnosticPhase,
			ImportDiagnosticPhase,
			ParseDiagnosticPhase,
			SourceLoadingDiagnosticPhase,
			TypecheckDiagnosticPhase,
		),
		analyze_syntax_diagnostics,
		merge_diagnostic_fragments,
		typecheck_diagnostic_publication,
	../../../src/lsp/analysis/diagnostic_model:
		Diagnostic,
		DiagnosticPublication,
		DiagnosticSeverity(ErrorDiagnostic, WarningDiagnostic),
		diagnostic_publication_is_current,
	../../../src/lsp/protocol/identity: DocumentUri, document_uri
	../../../src/lsp/protocol/position:
		PositionMappingError(
			PositionSplitsSurrogatePair,
			SourceOffsetSplitsCodePoint,
			SpanSourceMismatch,
		),
		ProtocolPosition,
		SourceByteOffset,
		position,
		position_to_source_offset,
		source_byte_offset_value,
		source_offset_to_position,
		source_span_to_range,
	../../../src/lsp/server/server_work: document_analysis_request
	../../../src/lsp/workspace/document_model:
		OpenedDocument,
		VersionedDocumentText,
		document_version,
		document_version_value,
	../../../src/lsp/workspace/document_store:
		DOCUMENT_STORE_EMPTY,
		DocumentStore,
