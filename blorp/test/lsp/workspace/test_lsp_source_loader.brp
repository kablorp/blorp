private pure func initialization(
	workspace_folders: Option[List[DocumentUri]],
	root_uri: Option[DocumentUri],
) -> InitializeParameters:
	{
		process_id = None,
		workspace_folders = workspace_folders,
		root_uri = root_uri,
		supports_definition_links = False,
		supports_declaration_links = False,
		supports_type_definition_links = False,
		supports_versioned_diagnostics = False
	}


private pure func request(
	working_directory: String,
	parameters: InitializeParameters,
) -> SourceLoadRequest:
	{
		working_directory = working_directory,
		initialization = parameters,
		std_override = None,
		package_cache_root = working_directory.join(".package-cache"),
		policy = DEFAULT_SOURCE_DISCOVERY_POLICY
	}


private func write_source(path: String, text: String) -> Result[Void, String]:
	_created ?= create_directories(path.dirname()).map_err(func(error): message(error))
	write_text_atomic(path, text).map_err(func(error): message(error))


private func report_case(result: Result[Bool, String]) -> Bool:
	match result:
		Ok(passed):
			passed
		Err(detail):
			print_error(detail)
			False


private pure func package_manifest() -> String:
	|[package]
	|name = "math_core"
	|
	|[compat]
	|std = "preview-1"
	|
	|[exports]
	|modules = ["math_core/stats"]


private pure func project_configuration() -> String:
	|[std]
	|path = "toolchain/std"
	|
	|[packages.math]
	|path = "vendor/math"


private func load_workspace_case() -> Result[Bool, String]:
	with directory ?= temporary_directory(
		temp_dir(),
		"blorp_lsp_source_loader_",
	) on error => message(error):
		root: String = resource_path(directory)
		main_path: String = root.join("main.brp")
		dependency_path: String = root.join("lib/dep.brp")
		ignored_path: String = root.join("build/generated.brp")
		_written_main ?= write_source(
			main_path,
			"import:\n\tlib/dep as Dep\n\nfunc main(args: List[String]) -> Int:\n\tDep.value()\n",
		)
		_written_dependency ?= write_source(dependency_path, "pure func value() -> Int: 42\n")
		_written_ignored ?= write_source(ignored_path, "VALUE = 0\n")
		canonical_main ?= canonical_existing_path(main_path).map_err(func(error): message(error))
		canonical_dependency ?= canonical_existing_path(
			dependency_path,
		).map_err(
			func(error): message(error),
		)
		root_uri ?= file_uri_from_path(root).map_err(func(_): "could not encode root URI")
		main_uri ?= file_uri_from_path(main_path).map_err(func(_): "could not encode main URI")
		loaded ?= load_sources(
			request(
				root,
				initialization(Some([root_uri]), None),
			),
		).map_err(
			func(_): "source loading failed",
		)

		local_sources = loaded.sources.filter(func(source):
			match source.layer.provenance:
				DiskSource:
					True
				_:
					False
		)
		local_modules = local_sources.map(func(source): source.layer.source.module_name)
		local_paths = local_sources.map(func(source): source.layer.source.path)
		has_client_main_uri: Bool = local_sources.any(func(source):
			source.layer.source.module_name == "main" and source.uri == main_uri
		)
		has_embedded_std: Bool = loaded.sources.any(func(source):
			match source.layer.provenance:
				StandardLibrarySource:
					True
				_:
					False
		)

		Ok(
			(
				local_modules == ["lib/dep", "main"]
				and local_paths == [canonical_dependency, canonical_main].sort()
				and not local_modules.contains("build/generated")
				and has_client_main_uri
				and has_embedded_std
				and loaded.issues.length() == 0
				and workspace(loaded.configuration, loaded.sources).is_ok()
			),
		)


func test_loads_canonical_multi_module_workspace() -> Bool:
	load_workspace_case().get_or(False)


private func empty_folders_fallback_case() -> Result[Bool, String]:
	with directory ?= temporary_directory(
		temp_dir(),
		"blorp_lsp_source_loader_fallback_",
	) on error => message(error):
		root: String = resource_path(directory)
		_written ?= write_source(
			root.join("selected.brp"),
			"VALUE = 1\n",
		)
		root_uri ?= file_uri_from_path(root).map_err(func(_): "could not encode root URI")
		loaded ?= load_sources(
			request(
				root,
				initialization(Some([]), Some(root_uri)),
			),
		).map_err(
			func(_): "source loading failed",
		)
		local_modules = loaded.sources.filter_map(func(source):
			match source.layer.provenance:
				DiskSource:
					Some(source.layer.source.module_name)
				_:
					None
		)

		Ok(local_modules == ["selected"])


func test_empty_workspace_folders_use_root_uri() -> Bool:
	empty_folders_fallback_case().get_or(False)


private func workspace_folders_precedence_case() -> Result[Bool, String]:
	with directory ?= temporary_directory(
		temp_dir(),
		"blorp_lsp_source_loader_precedence_",
	) on error => message(error):
		root: String = resource_path(directory)
		selected: String = root.join("selected")
		ignored: String = root.join("ignored")
		_written_selected ?= write_source(
			selected.join("selected.brp"),
			"SELECTED = 1\n",
		)
		_written_ignored ?= write_source(
			ignored.join("ignored.brp"),
			"IGNORED = 2\n",
		)
		selected_uri ?= file_uri_from_path(
			selected,
		).map_err(
			func(_): "could not encode selected URI",
		)
		ignored_uri ?= file_uri_from_path(ignored).map_err(func(_): "could not encode ignored URI")
		loaded ?= load_sources(
			request(
				root,
				initialization(Some([selected_uri]), Some(ignored_uri)),
			),
		).map_err(
			func(_): "source loading failed",
		)
		local_modules = loaded.sources.filter_map(func(source):
			match source.layer.provenance:
				DiskSource:
					Some(source.layer.source.module_name)
				_:
					None
		)

		Ok(local_modules == ["selected"])


func test_workspace_folders_override_root_uri() -> Bool:
	report_case(workspace_folders_precedence_case())


