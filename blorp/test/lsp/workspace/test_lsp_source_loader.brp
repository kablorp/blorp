private func file_uri_round_trip_case() -> Result[Bool, String]:
	with directory ?= temporary_directory(temp_dir(), "blorp lsp uri ") on error => message(error):
		path: String = resource_path(directory).join("café file.brp")
		uri ?= file_uri_from_path(path).map_err(func(_): "could not encode URI")
		decoded ?= file_uri_to_path(uri).map_err(func(_): "could not decode URI")
		Ok(decoded == normalize(path))


func test_file_uri_round_trips_non_ascii_and_spaces() -> Bool:
	file_uri_round_trip_case().get_or(False)


func test_file_uri_encodes_reserved_characters_once() -> Bool:
	path: String = "/workspace/literal%20?#.brp"

	match file_uri_from_path(path):
		Err(_):
			False
		Ok(uri):
			(
				document_uri_value(uri).ends_with("literal%2520%3F%23.brp")
				and file_uri_to_path(uri) == Ok(path)
			)


func test_file_uri_rejects_malformed_escape_and_scheme() -> Bool:
	malformed: Bool = match file_uri_to_path(document_uri("file:///workspace/bad%2.brp")):
		Err(FileUriInvalidPercentEncoding(_)):
			True
		_:
			False

	unsupported: Bool = match file_uri_to_path(document_uri("https://example.com/main.brp")):
		Err(FileUriUnsupportedScheme(_)):
			True
		_:
			False

	localhost: Bool = file_uri_to_path(
		document_uri("file://localhost/workspace/main.brp"),
	) == Ok("/workspace/main.brp")

	malformed and unsupported and localhost


func test_rejects_non_local_file_uri_authority() -> Bool:
	match file_uri_to_path(document_uri("file://example.com/workspace/main.brp")):
		Err(FileUriNonLocalAuthority(authority)):
			authority == "example.com"
		_:
			False


private func configured_sources_case() -> Result[Bool, String]:
	with directory ?= temporary_directory(
		temp_dir(),
		"blorp_lsp_source_loader_configured_",
	) on error => message(error):
		root: String = resource_path(directory)
		std_root: String = root.join("toolchain/std")
		package_root: String = root.join("vendor/math")
		native_root: String = root.join("pkg")
		_written_main ?= write_source(
			root.join("main.brp"),
			"func main(args: List[String]): void\n",
		)
		_written_std ?= write_source(
			std_root.join("list.brp"),
			"LIST_VALUE = 1\n",
		)
		_written_package ?= write_source(
			package_root.join("src/math_core/stats.brp"),
			"STATS_VALUE = 2\n",
		)
		_written_manifest ?= write_source(
			package_root.join("package.toml"),
			package_manifest(),
		)
		_written_native ?= write_source(
			native_root.join("net/http.brp"),
			"HTTP_VALUE = 3\n",
		)
		_written_config ?= write_source(
			root.join("blorp.toml"),
			project_configuration(),
		)
		canonical_std ?= canonical_existing_path(std_root).map_err(func(error): message(error))
		canonical_native ?= canonical_existing_path(
			native_root,
		).map_err(
			func(error): message(error),
		)
		root_uri ?= file_uri_from_path(root).map_err(func(_): "could not encode root URI")
		loaded ?= load_sources(
			request(
				root,
				initialization(Some([root_uri]), None),
			),
		).map_err(
			func(_): "source loading failed",
		)

		standard_modules = loaded.sources.filter_map(func(source):
			match source.layer.provenance:
				StandardLibrarySource:
					Some(source.layer.source.module_name)
				_:
					None
		)
		source_package_modules = loaded.sources.filter_map(func(source):
			match source.layer.provenance:
				SourcePackageSource(_):
					Some(source.layer.source.module_name)
				_:
					None
		)
		native_package_modules = loaded.sources.filter_map(func(source):
			match source.layer.provenance:
				NativePackageSource(_):
					Some(source.layer.source.module_name)
				_:
					None
		)
		native_package_ids = loaded.sources.filter_map(func(source):
			match source.layer.provenance:
				NativePackageSource(package_id):
					Some(package_id)
				_:
					None
		)

		selected_std: Bool = match loaded.configuration.std_provider:
			ProjectFilesystemStd(path):
				path == canonical_std
			ProjectEmbeddedStd:
				False

		passed: Bool = (
			selected_std
			and standard_modules == ["list"]
			and source_package_modules == ["math_core/stats"]
			and native_package_modules == ["pkg/net/http"]
			and native_package_ids == ["net"]
			and loaded.configuration.source_packages.length() == 1
			and loaded.configuration.native_package_roots == [canonical_native]
			and loaded.issues.length() == 0
		)

		if passed:
			Ok(True)
		else:
			standard_text: String = standard_modules.join(",")
			source_text: String = source_package_modules.join(",")
			native_text: String = native_package_modules.join(",")
			native_roots_text: String = loaded.configuration.native_package_roots.join(",")
			Err(
				"selected_std=${selected_std}; std=${standard_text}; " + "source=${source_text}; native=${native_text}; " + "layouts=${loaded.configuration.source_packages.length()}; " + "native_roots=${native_roots_text}; issues=${loaded.issues.length()}",
			)


func test_loads_configured_std_source_and_native_packages() -> Bool:
	report_case(configured_sources_case())


private func overlapping_roots_case() -> Result[Bool, String]:
	with directory ?= temporary_directory(
		temp_dir(),
		"blorp_lsp_source_loader_overlap_",
	) on error => message(error):
		root: String = resource_path(directory)
		nested: String = root.join("nested")
		_written_root ?= write_source(
			root.join("root.brp"),
			"ROOT = 1\n",
		)
		_written_nested ?= write_source(
			nested.join("child.brp"),
			"CHILD = 2\n",
		)
		root_uri ?= file_uri_from_path(root).map_err(func(_): "could not encode root URI")
		nested_uri ?= file_uri_from_path(nested).map_err(func(_): "could not encode nested URI")
		canonical_root ?= canonical_existing_path(root).map_err(func(error): message(error))
		loaded ?= load_sources(
			request(
				root,
				initialization(Some([nested_uri, root_uri]), None),
			),
		).map_err(
			func(_): "source loading failed",
		)
		local_modules = loaded.sources.filter_map(func(source):
			match source.layer.provenance:
				DiskSource:
					Some(source.layer.source.module_name)
				_:
					None
		)
		selected_root_matches: Bool = (
			loaded.configuration.workspace_roots.length() == 1
			and loaded.configuration.workspace_roots.any(
				func(candidate): candidate.canonical_path == canonical_root,
			)
		)

		passed: Bool = (
			selected_root_matches
			and local_modules == ["nested/child", "root"]
			and loaded.issues.length() == 0
		)

		if passed:
			Ok(True)
		else:
			module_text: String = local_modules.join(",")
			Err(
				"roots=${loaded.configuration.workspace_roots.length()}; " + "modules=${module_text}; issues=${loaded.issues.length()}",
			)


func test_overlapping_workspace_roots_keep_broader_root() -> Bool:
	report_case(overlapping_roots_case())


private func conflicting_multi_root_identity_case() -> Result[Bool, String]:
	with directory ?= temporary_directory(
		temp_dir(),
		"blorp_lsp_source_loader_identity_",
	) on error => message(error):
		root: String = resource_path(directory)
		first: String = root.join("first")
		second: String = root.join("second")
		_written_first ?= write_source(
			first.join("main.brp"),
			"FIRST = 1\n",
		)
		_written_second ?= write_source(
			second.join("main.brp"),
			"SECOND = 2\n",
		)
		first_uri ?= file_uri_from_path(first).map_err(func(_): "could not encode first URI")
		second_uri ?= file_uri_from_path(second).map_err(func(_): "could not encode second URI")
		first_source_uri ?= file_uri_from_path(
			first.join("main.brp"),
		).map_err(
			func(_): "could not encode first source URI",
		)
		second_source_uri ?= file_uri_from_path(
			second.join("main.brp"),
		).map_err(
			func(_): "could not encode second source URI",
		)

		match load_workspace(request(root, initialization(Some([first_uri, second_uri]), None))):
			Err(SourceLoadWorkspaceRejected(WorkspaceModuleIdentityConflict(uri))):
				Ok(uri == first_source_uri or uri == second_source_uri)
			_:
				Err("duplicate module identity was accepted")


func test_rejects_conflicting_module_identity_across_roots() -> Bool:
	report_case(conflicting_multi_root_identity_case())


private func resolve_unsaved_source_case() -> Result[Bool, String]:
	with directory ?= temporary_directory(
		temp_dir(),
		"blorp_lsp_source_loader_unsaved_",
	) on error => message(error):
		root: String = resource_path(directory)
		_written ?= write_source(
			root.join("main.brp"),
			"MAIN = 1\n",
		)
		root_uri ?= file_uri_from_path(root).map_err(func(_): "could not encode root URI")
		loaded ?= load_workspace(
			request(
				root,
				initialization(Some([root_uri]), None),
			),
		).map_err(
			func(_): "source loading failed",
		)
		new_path: String = root.join("src/new_file.brp")
		canonical_root ?= canonical_existing_path(root).map_err(func(error): message(error))
		expected_path: String = canonical_root.join("src/new_file.brp")
		new_uri ?= file_uri_from_path(new_path).map_err(func(_): "could not encode source URI")
		document_version ?= document_version(1).to_result("could not create document version")
		initial_snapshot = workspace_snapshot(loaded.workspace)
		document: VersionedDocumentText = {
			uri = new_uri,
			version = document_version,
			text = "import:\n\t../main\n\nNEW_VALUE = 2\n"
		}
		opened: OpenedDocument = {
			document = document,
			language_id = "blorp"
		}
		resolved ?= resolve_open_document(
			initial_snapshot.compiler.configuration,
			opened,
		).map_err(
			func(_): "could not resolve unsaved source",
		)
		applied ?= apply_workspace_event(
			loaded.workspace,
			ResolvedDocumentOpened(resolved),
		).map_err(
			func(_): "could not open resolved source",
		)
		snapshot = workspace_snapshot(applied[0])
		selected ?= source_for_uri(
			snapshot,
			new_uri,
		).map_err(
			func(_): "could not select opened source",
		)
		selected_source = source_snapshot_source(selected)
		graph ?= frontend_graph_for_sources(
			snapshot.compiler.sources,
		).map_err(
			func(_): "could not construct frontend graph",
		)
		import_resolved: Bool = frontend_graph_import_edges(graph.graph).any(func(edge):
			if edge.requested_path != "../main":
				False
			else:
				match edge.resolution:
					FrontendResolvedImport(identity):
						resolved_module_canonical_path(identity) == "main"
					_:
						False
		)

		path_matches: Bool = selected_source.path == expected_path
		module_matches: Bool = selected_source.module_name == "src/new_file"
		text_matches: Bool = selected_source.text == "import:\n\t../main\n\nNEW_VALUE = 2\n"

		provenance_matches: Bool = match resolved.provenance:
			DiskSource:
				True
			_:
				False

		if (
			path_matches
			and module_matches
			and text_matches
			and import_resolved
			and provenance_matches
		):
			Ok(True)
		else:
			Err(
				"path=${path_matches}; module=${module_matches}; text=${text_matches}; " + "import=${import_resolved}; provenance=${provenance_matches}",
			)


func test_resolves_new_unsaved_source_without_disk_snapshot() -> Bool:
	report_case(resolve_unsaved_source_case())


private func reject_outside_source_case() -> Result[Bool, String]:
	with directory ?= temporary_directory(
		temp_dir(),
		"blorp_lsp_source_loader_outside_",
	) on error => message(error):
		root: String = resource_path(directory)
		_written ?= write_source(
			root.join("main.brp"),
			"MAIN = 1\n",
		)
		root_uri ?= file_uri_from_path(root).map_err(func(_): "could not encode root URI")
		loaded ?= load_sources(
			request(
				root,
				initialization(Some([root_uri]), None),
			),
		).map_err(
			func(_): "source loading failed",
		)
		outside_uri ?= file_uri_from_path(
			root + "_outside/main.brp",
		).map_err(
			func(_): "could not encode outside URI",
		)

		match resolve_open_source(loaded.configuration, outside_uri, "OUTSIDE = 1\n"):
			Err(OpenSourceOutsideCatalog(uri)):
				Ok(uri == outside_uri)
			_:
				Err("outside source was accepted")


func test_rejects_open_source_outside_catalog() -> Bool:
	report_case(reject_outside_source_case())


private func apply_open_document(
	workspace: Workspace,
	configuration: WorkspaceConfiguration,
	uri: DocumentUri,
	text: String,
) -> Result[Workspace, String]:
	version ?= document_version(1).to_result("could not create document version")
	resolved ?= resolve_open_document(
		configuration,
		{
			document = {
				uri = uri,
				version = version,
				text = text
			},
			language_id = "blorp"
		},
	).map_err(func(_): "could not resolve opened document")
	applied ?= apply_workspace_event(
		workspace,
		ResolvedDocumentOpened(resolved),
	).map_err(
		func(_): "could not apply opened document",
	)
	Ok(applied[0])


private func selected_text(workspace: Workspace, uri: DocumentUri) -> Result[String, String]:
	snapshot = workspace_snapshot(workspace)
	selected ?= source_for_uri(snapshot, uri).map_err(func(_): "source was unavailable")
	Ok(source_snapshot_source(selected).text)


private func saved_source_refresh_case() -> Result[Bool, String]:
	with directory ?= temporary_directory(
		temp_dir(),
		"blorp_lsp_source_refresh_",
	) on error => message(error):
		root: String = resource_path(directory)
		path: String = root.join("main.brp")
		_written ?= write_source(path, "DISK = 1\n")
		root_uri ?= file_uri_from_path(root).map_err(func(_): "could not encode root URI")
		source_uri ?= file_uri_from_path(path).map_err(func(_): "could not encode source URI")
		loaded ?= load_workspace(
			request(
				root,
				initialization(Some([root_uri]), None),
			),
		).map_err(
			func(_): "source loading failed",
		)
		initial = workspace_snapshot(loaded.workspace)
		opened ?= apply_open_document(
			loaded.workspace,
			initial.compiler.configuration,
			source_uri,
			"OVERLAY = 2\n",
		)
		_rewritten ?= write_source(path, "DISK = 3\n")
		refresh ?= refresh_saved_source(
			initial.compiler.configuration,
			source_uri,
		).map_err(
			func(_error: SavedSourceRefreshError): "save refresh failed",
		)
		refreshed ?= apply_workspace_event(
			opened,
			saved_source_refresh_event(refresh),
		).map_err(
			func(_): "could not apply disk refresh",
		)
		overlay_text ?= selected_text(refreshed[0], source_uri)
		closed ?= apply_workspace_event(
			refreshed[0],
			WorkspaceDocumentClosed(source_uri),
		).map_err(
			func(_): "could not close document",
		)
		disk_text ?= selected_text(closed[0], source_uri)

		Ok(overlay_text == "OVERLAY = 2\n" and disk_text == "DISK = 3\n")


func test_saved_source_refresh_stays_hidden_until_close() -> Bool:
	report_case(saved_source_refresh_case())


private func deleted_saved_source_refresh_case() -> Result[Bool, String]:
	with directory ?= temporary_directory(
		temp_dir(),
		"blorp_lsp_source_refresh_deleted_",
	) on error => message(error):
		root: String = resource_path(directory)
		path: String = root.join("main.brp")
		_written ?= write_source(path, "DISK = 1\n")
		root_uri ?= file_uri_from_path(root).map_err(func(_): "could not encode root URI")
		source_uri ?= file_uri_from_path(path).map_err(func(_): "could not encode source URI")
		loaded ?= load_workspace(
			request(
				root,
				initialization(Some([root_uri]), None),
			),
		).map_err(
			func(_): "source loading failed",
		)
		initial = workspace_snapshot(loaded.workspace)
		opened ?= apply_open_document(
			loaded.workspace,
			initial.compiler.configuration,
			source_uri,
			"OVERLAY = 2\n",
		)
		_ = remove_file(path)
		refresh ?= refresh_saved_source(
			initial.compiler.configuration,
			source_uri,
		).map_err(
			func(_error: SavedSourceRefreshError): "save refresh failed",
		)
		refreshed ?= apply_workspace_event(
			opened,
			saved_source_refresh_event(refresh),
		).map_err(
			func(_): "could not apply disk removal",
		)
		overlay_text ?= selected_text(refreshed[0], source_uri)
		closed ?= apply_workspace_event(
			refreshed[0],
			WorkspaceDocumentClosed(source_uri),
		).map_err(
			func(_): "could not close document",
		)

		Ok(
			(
				overlay_text == "OVERLAY = 2\n"
				and source_for_uri(workspace_snapshot(closed[0]), source_uri).is_err()
			),
		)


func test_deleted_saved_source_is_removed_after_close() -> Bool:
	report_case(deleted_saved_source_refresh_case())


private func newly_saved_source_refresh_case() -> Result[Bool, String]:
	with directory ?= temporary_directory(
		temp_dir(),
		"blorp_lsp_source_refresh_new_",
	) on error => message(error):
		root: String = resource_path(directory)
		base_path: String = root.join("base.brp")
		new_path: String = root.join("new.brp")
		_written_base ?= write_source(base_path, "BASE = 1\n")
		root_uri ?= file_uri_from_path(root).map_err(func(_): "could not encode root URI")
		new_uri ?= file_uri_from_path(new_path).map_err(func(_): "could not encode source URI")
		loaded ?= load_workspace(
			request(
				root,
				initialization(Some([root_uri]), None),
			),
		).map_err(
			func(_): "source loading failed",
		)
		initial = workspace_snapshot(loaded.workspace)
		opened ?= apply_open_document(
			loaded.workspace,
			initial.compiler.configuration,
			new_uri,
			"OVERLAY = 2\n",
		)
		_written_new ?= write_source(new_path, "DISK = 3\n")
		refresh ?= refresh_saved_source(
			initial.compiler.configuration,
			new_uri,
		).map_err(
			func(_error: SavedSourceRefreshError): "save refresh failed",
		)
		refreshed ?= apply_workspace_event(
			opened,
			saved_source_refresh_event(refresh),
		).map_err(
			func(_): "could not apply disk refresh",
		)
		overlay_text ?= selected_text(refreshed[0], new_uri)
		closed ?= apply_workspace_event(
			refreshed[0],
			WorkspaceDocumentClosed(new_uri),
		).map_err(
			func(_): "could not close document",
		)
		selected ?= source_for_uri(
			workspace_snapshot(closed[0]),
			new_uri,
		).map_err(
			func(_): "saved source was unavailable after close",
		)
		source = source_snapshot_source(selected)
		canonical_path ?= canonical_existing_path(new_path).map_err(func(error): message(error))

		Ok(
			(
				overlay_text == "OVERLAY = 2\n"
				and source.text == "DISK = 3\n"
				and source.path == canonical_path
				and source.module_name == "new"
			),
		)


func test_newly_saved_source_is_retained_after_close() -> Bool:
	report_case(newly_saved_source_refresh_case())


tests: TestSuite = {
	description = "Compiler LSP production source loader",
	tests = [
		("load canonical multi-module workspace", test_loads_canonical_multi_module_workspace),
		("empty workspace folders use root URI", test_empty_workspace_folders_use_root_uri),
		("workspace folders override root URI", test_workspace_folders_override_root_uri),
		("missing roots use working directory", test_missing_roots_use_working_directory),
		(
			"file URI round trips non-ASCII and spaces",
			test_file_uri_round_trips_non_ascii_and_spaces,
		),
		(
			"file URI encodes reserved characters once",
			test_file_uri_encodes_reserved_characters_once,
		),
		(
			"file URI rejects malformed escape and scheme",
			test_file_uri_rejects_malformed_escape_and_scheme,
		),
		("reject non-local file URI authority", test_rejects_non_local_file_uri_authority),
		(
			"load configured std, source package, and native package",
			test_loads_configured_std_source_and_native_packages,
		),
		(
			"overlapping workspace roots keep broader root",
			test_overlapping_workspace_roots_keep_broader_root,
		),
		(
			"reject conflicting module identity across roots",
			test_rejects_conflicting_module_identity_across_roots,
		),
		(
			"resolve new unsaved source without disk snapshot",
			test_resolves_new_unsaved_source_without_disk_snapshot,
		),
		("reject open source outside catalog", test_rejects_open_source_outside_catalog),
		(
			"saved source refresh stays hidden until close",
			test_saved_source_refresh_stays_hidden_until_close,
		),
		(
			"deleted saved source is removed after close",
			test_deleted_saved_source_is_removed_after_close,
		),
		(
			"newly saved source is retained after close",
			test_newly_saved_source_is_retained_after_close,
		),
	]
}
