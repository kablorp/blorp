import:
    io/fs/entry: EntryKind
    io/process: Captured, CaptureError, Command, Exit(Exited, Signaled, TimedOut), capture, command
    list: List methods, repeat
    path: Path
    result: Result methods
    ../../src/common/cli/usage: EXIT_REJECTED
    ./file_access: read_file, write_file, kind_of, path_of
    ./reports: compile_allocations, parse_instructions, within_ceiling, without_peak_heap


private SHELL: String = "/bin/sh"
LIBRARY_ROOT: String = "blorp/standard_library"
FIXTURES: String = "blorp/test/test_compile/fixtures/"
-- Compilation includes C sanitizer linking; native fixtures should finish quickly.
COMPILATION_TIMEOUT_MS: Int = 600000
private NATIVE_TIMEOUT_MS: Int = 10000
-- macOS reports a child's retired instructions with `-l`, into the `-o` file so
-- that the compiler's own stderr stays its strict allocation report.
private PROCESS_TIMER: String = "/usr/bin/time"
private PRESERVED_OUTPUT: String = "preserve this rejected output"


private union NativeMode:
    NormalNative
    StrictNative


-- A fixture the compiler must reject with exactly this diagnostic text.
record Rejection {
    name: String,
    source: String,
    diagnostic: String,
}


-- `text` written `count` times, for expected output too long to type.
pure func repeated(text: String, count: Int) -> String:
    repeat(text, count).join("")


private pure func expect(
    actual: String,
    expected: String,
    description: String,
) -> Result[Void, String]:
    if actual.equals(expected):
        Ok(void)
    else:
        Err(description + ": expected [" + expected + "], got [" + actual + "]")


-- Children that must not inherit a leak-check or statistics setting run with
-- these removed, so their output is the same wherever the driver runs.
pure func without_diagnostics() -> Dict[String, Option[String]]:
    { "BLORP_LEAK_CHECK" => None, "BLORP_MEMORY_STATS" => None }


-- A program under test reports its allocations on stderr, and fails on a leak.
pure func strict_leak_check() -> Dict[String, Option[String]]:
    { "BLORP_LEAK_CHECK" => Some("strict"), "BLORP_MEMORY_STATS" => None }


-- `program`, a path the suites build or are given as text, with `arguments`,
-- without the settings of without_diagnostics, and stopped after `timeout_ms`.
pure func isolated(
    program: String,
    arguments: List[String],
    timeout_ms: Int,
) -> Result[Command, String]:
    binary ?= path_of(program)
    Ok(
        { command(binary, arguments) |
            environment = without_diagnostics(),
            timeout_ms = Some(timeout_ms),
        },
    )


-- How a child ended, for a failure: "exited 2", "killed by signal 9" or
-- "timed out after 10000 ms".
pure func ending(exit: Exit, timeout_ms: Option[Int]) -> String:
    match (exit, timeout_ms):
        (Exited(status), _): "exited ${status}"
        (Signaled(signal), _): "killed by signal ${signal}"
        (TimedOut, Some(limit)): "timed out after ${limit} ms"
        (TimedOut, None): "timed out"


-- Runs `invocation` and returns what it printed when it exits with `status`.
-- Anything else is an error that starts with `name` and ends with the child's
-- stderr, so a crash or a timeout keeps the output that explains it.
func run_expecting(name: String, invocation: Command, status: Int) -> Result[Captured, String]:
    captured ?= capture(invocation).map_err(
        pure func(error: CaptureError) -> String: "${name}: ${error}",
    )
    if captured.exit == Exited(status):
        Ok(captured)
    else:
        Err(
            "${name}: expected exit ${status}; ${captured.exit.ending(invocation.timeout_ms)}: ${captured.stderr}",
        )


-- Returns the compile's allocations, from its strict report. With
-- `check_instructions` the compiler runs under the process timer, which writes
-- what it cost to `prefix.instructions`. `inputs` are the compiler arguments
-- between the command and the library root.
func compile_timed(
    check_instructions: Bool,
    compiler: String,
    library_root: String,
    inputs: List[String],
    prefix: String,
) -> Result[Int, String]:
    arguments = ["compile"]
        .concat(inputs)
        .concat(["--library-root", library_root, "-o", prefix + ".c"])
    compile ?= if check_instructions:
        isolated(
            PROCESS_TIMER,
            ["-l", "-o", prefix + ".instructions", compiler].concat(arguments),
            COMPILATION_TIMEOUT_MS,
        )
    else:
        isolated(compiler, arguments, COMPILATION_TIMEOUT_MS)
    compiled ?= run_expecting(
        prefix + ".compile",
        { compile | environment = strict_leak_check() },
        0,
    )
    _ ?= expect(compiled.stdout, "", "compiler stdout")
    allocations: Int ?= compile_allocations(compiled.stderr)
    generated: String ?= read_file(prefix + ".c")
    if (
        generated
            .length()
            .equals(0)
    ):
        Err("successful compilation emitted empty C")
    else:
        Ok(allocations)


private func link_fixture(
    c_compiler: String,
    prefix: String,
    mode: NativeMode,
) -> Result[Void, String]:
    (suffix, definition) = match mode:
        NormalNative: (".normal", "-DBLORP_MEMORY_DIAGNOSTICS=0")
        StrictNative: (".strict", "-DBLORP_MEMORY_DIAGNOSTICS=1")
    binary = prefix + suffix
    link ?= isolated(
        c_compiler,
        [
            "-std=c11",
            "-Wall",
            "-Wextra",
            "-Werror",
            "-pedantic",
            "-O0",
            "-fsanitize=address,undefined",
            "-fno-sanitize-recover=all",
            definition,
            prefix + ".c",
            "-o",
            binary,
            "-lm",
            "-lpthread",
        ],
        COMPILATION_TIMEOUT_MS,
    )
    linked ?= run_expecting(binary + ".link", link, 0)
    _ ?= expect(linked.stdout, "", "C compiler stdout")
    expect(linked.stderr, "", "C compiler stderr")


-- One native invocation. A run that shares its fixture with others has a
-- `label` naming it in error text; `directory` is where the program starts
-- (None keeps the runner's own), and `descriptor_limit` the most files it may
-- hold open (None keeps the runner's own). `stderr` is everything the program
-- itself writes to stderr, byte for byte.
record NativeRun {
    label: Option[String],
    arguments: List[String],
    directory: Option[String],
    descriptor_limit: Option[Int],
    status: Int,
    stdout: String,
    stderr: String,
    allocations: Int,
}


-- The shell only lowers its open-file limit, which the program inherits, and
-- then replaces itself with the program. The process API sets no limits.
private LIMIT_DESCRIPTORS: String = "ulimit -n \"$1\" && shift && exec \"$@\""


-- One run of `binary`, isolated; a strict run changes its environment.
private pure func launch(binary: String, run: NativeRun) -> Result[Command, String]:
    started ?= match run.descriptor_limit:
        None:
            isolated(binary, run.arguments, NATIVE_TIMEOUT_MS)
        Some(limit):
            isolated(
                SHELL,
                ["-c", LIMIT_DESCRIPTORS, "sh", limit.to_string(), binary].concat(run.arguments),
                NATIVE_TIMEOUT_MS,
            )
    directory: Option[Path] ?= match run.directory:
        None: Ok(None)
        Some(text): path_of(text).map(pure func(place: Path) -> Option[Path]: Some(place))
    Ok({ started | directory = directory })


private pure func label_suffix(run: NativeRun) -> String:
    match run.label:
        None: ""
        Some(label): "." + label


private func run_normal(prefix: String, run: NativeRun) -> Result[Void, String]:
    launched ?= launch(prefix + ".normal", run)
    ran ?= run_expecting(prefix + label_suffix(run) + ".normal.run", launched, run.status)
    _ ?= expect(ran.stdout, run.stdout, "native stdout" + label_suffix(run))
    expect(ran.stderr, run.stderr, "native stderr" + label_suffix(run))


private func run_strict(prefix: String, run: NativeRun) -> Result[Void, String]:
    launched ?= launch(prefix + ".strict", run)
    ran ?= run_expecting(
        prefix + label_suffix(run) + ".strict.run",
        { launched | environment = strict_leak_check() },
        run.status,
    )
    _ ?= expect(ran.stdout, run.stdout, "strict native stdout" + label_suffix(run))
    -- The runtime writes its report as the program's last act, after everything
    -- the program wrote to the same stream. Its peak heap line, last, varies
    -- with the fixture; the peak heap runtime suite checks its value.
    report = (
        ("blorp: leak check: " + run.allocations.to_string() + " allocs, ")
        + run.allocations.to_string()
        + " releases, 0 leaked, 0 bytes\n"
    )
    before_peak: String ?= without_peak_heap(ran.stderr).map_err(
        pure func(error: String): "strict native stderr" + label_suffix(run) + ": " + error,
    )
    expect(
        before_peak,
        run.stderr + report,
        "strict native stderr and accounting" + label_suffix(run),
    )


private func run_fixture(prefix: String, run: NativeRun) -> Result[Void, String]:
    _ ?= run_normal(prefix, run)
    run_strict(prefix, run)


-- Runs the binaries as every entry of `runs`, in order, until one fails.
private func run_all(
    prefix: String,
    runs: List[NativeRun],
    run_one: (String, NativeRun) -> Result[Void, String],
) -> Result[Void, String]:
    var outcome: Result[Void, String] = Ok(void)
    for run in runs:
        match outcome:
            Ok(_): outcome = run_one(prefix, run)
            Err(_): void
    outcome


-- What one compilation may cost the compiler under test. The allocations come
-- from its strict report and are always held; the retired instructions come from
-- the process timer and are held only when the run asks for them. Each ceiling
-- is its program's measured cost plus 15%; the commit that changes a ceiling
-- states the measured cost in its message.
record CompileCeiling {
    allocations: Int,
    instructions: Int,
}


-- What the compiler is given: one program, or `--test-suite` roots, whose first
-- root owns the entry and whose later roots follow it in command-line order.
union CompileInput:
    SingleSource(String)
    SuiteRoots(String, List[String])


-- A program that compiles once against `library_root`, within `ceiling`, and
-- then runs as every entry of `runs`, in order. The constructors below use the
-- standard library.
record Program {
    name: String,
    input: CompileInput,
    library_root: String,
    ceiling: CompileCeiling,
    runs: List[NativeRun],
}


-- The compiler arguments that name the inputs, between `compile` and the options.
private pure func compiler_inputs(input: CompileInput) -> List[String]:
    match input:
        SingleSource(source): [source]
        SuiteRoots(entry, grouped): ["--test-suite", entry].concat(grouped)


private func instructions_within(prefix: String, ceiling: CompileCeiling) -> Result[Void, String]:
    timing: String ?= read_file(prefix + ".instructions")
    instructions: Int ?= parse_instructions(timing)
    within_ceiling("compile retired instructions", instructions, ceiling.instructions)


private func compile_within(
    compiler: String,
    check_instructions: Bool,
    library_root: String,
    inputs: List[String],
    prefix: String,
    ceiling: CompileCeiling,
) -> Result[Void, String]:
    allocations: Int ?= compile_timed(check_instructions, compiler, library_root, inputs, prefix)
    _ ?= within_ceiling("compile allocations", allocations, ceiling.allocations)
    if check_instructions:
        instructions_within(prefix, ceiling)
    else:
        Ok(void)


-- Compiles the program within its ceiling and links it without and with
-- diagnostics, returning the prefix of its files.
private func build_program(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
    program: Program,
) -> Result[String, String]:
    prefix = work_directory + "/" + program.name
    _ ?= compile_within(
        compiler,
        check_instructions,
        program.library_root,
        compiler_inputs(program.input),
        prefix,
        program.ceiling,
    )
    _ ?= link_fixture(c_compiler, prefix, NormalNative)
    _ ?= link_fixture(c_compiler, prefix, StrictNative)
    Ok(prefix)


func verify_program(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
    program: Program,
) -> Result[Void, String]:
    prefix: String ?= build_program(
        compiler,
        c_compiler,
        work_directory,
        check_instructions,
        program,
    )
    run_all(prefix, program.runs, run_fixture)


-- The ways to declare a program's runs. `once` is a program with one run and
-- no arguments, `once_given` one with arguments after the program name;
-- `with_arguments` is one of several runs, and `label` names its captures.
-- `exits_with` prints nothing; `prints` exits 0.
pure func once_given(
    arguments: List[String],
    status: Int,
    stdout: String,
    allocations: Int,
) -> List[NativeRun]:
    [
        {
            label = None,
            arguments = arguments,
            directory = None,
            descriptor_limit = None,
            status = status,
            stdout = stdout,
            stderr = "",
            allocations = allocations,
        },
    ]


pure func once(status: Int, stdout: String, allocations: Int) -> List[NativeRun]:
    once_given([], status, stdout, allocations)


pure func with_arguments(
    label: String,
    arguments: List[String],
    status: Int,
    stdout: String,
    allocations: Int,
) -> NativeRun:
    {
        label = Some(label),
        arguments = arguments,
        directory = None,
        descriptor_limit = None,
        status = status,
        stdout = stdout,
        stderr = "",
        allocations = allocations,
    }


private pure func fixture_path(fixture: String) -> String:
    FIXTURES + fixture + ".brp"


-- `fixture` is a path under FIXTURES, without the extension.
pure func fixture_program(
    name: String,
    fixture: String,
    ceiling: CompileCeiling,
    runs: List[NativeRun],
) -> Program:
    {
        name = name,
        input = SingleSource(fixture_path(fixture)),
        library_root = LIBRARY_ROOT,
        ceiling = ceiling,
        runs = runs,
    }


-- A `--test-suite` program over fixtures, without the extension; `entry` owns
-- the entry and `grouped` follow it.
pure func suite_program(
    name: String,
    entry: String,
    grouped: List[String],
    ceiling: CompileCeiling,
    runs: List[NativeRun],
) -> Program:
    {
        name = name,
        input = SuiteRoots(fixture_path(entry), grouped.map(fixture_path)),
        library_root = LIBRARY_ROOT,
        ceiling = ceiling,
        runs = runs,
    }


pure func exits_with(
    name: String,
    fixture: String,
    ceiling: CompileCeiling,
    status: Int,
    allocations: Int,
) -> Program:
    fixture_program(name, fixture, ceiling, once(status, "", allocations))


pure func prints(
    name: String,
    fixture: String,
    ceiling: CompileCeiling,
    stdout: String,
    allocations: Int,
) -> Program:
    fixture_program(name, fixture, ceiling, once(0, stdout, allocations))


-- A program that prints nothing to stdout and `stderr` to stderr.
pure func writes_errors(
    name: String,
    fixture: String,
    ceiling: CompileCeiling,
    status: Int,
    stderr: String,
    allocations: Int,
) -> Program:
    fixture_program(name, fixture, ceiling, [
        {
            label = None,
            arguments = [],
            directory = None,
            descriptor_limit = None,
            status = status,
            stdout = "",
            stderr = stderr,
            allocations = allocations,
        },
    ])


-- A rejected compilation publishes nothing: it creates no C file where there
-- was none, and leaves an existing one as it was. `rejection.diagnostic` follows
-- the source path in the compiler's message.
func verify_unpublished_against(
    compiler: String,
    library_root: String,
    work_directory: String,
    rejection: Rejection,
) -> Result[Void, String]:
    verify_unpublished_expecting(
        compiler,
        library_root,
        work_directory,
        rejection.name,
        rejection.source,
        rejection.source + rejection.diagnostic,
    )


-- The same, for a message that does not begin with the source's own path, such
-- as an error located in an imported module.
func verify_unpublished_expecting(
    compiler: String,
    library_root: String,
    work_directory: String,
    name: String,
    source: String,
    expected: String,
) -> Result[Void, String]:
    prefix = work_directory + "/" + name
    output = prefix + ".c"
    _ ?= expect_failure(compiler, compile_arguments(library_root, source, output), prefix, expected)
    created: Option[EntryKind] ?= kind_of(output)
    unpublished: Void ?= match created:
        None: Ok(void)
        Some(_): Err("a rejected compilation created " + output)
    _ ?= write_file(output, PRESERVED_OUTPUT)
    _ ?= expect_failure(
        compiler,
        compile_arguments(library_root, source, output),
        prefix + ".existing",
        expected,
    )
    unchanged: String ?= read_file(output)
    expect(unchanged, PRESERVED_OUTPUT, "rejected output sentinel")


-- The same, for `text` written to a source in the work directory.
func verify_unpublished_rejection(
    compiler: String,
    work_directory: String,
    name: String,
    text: String,
    diagnostic: String,
) -> Result[Void, String]:
    source = work_directory + "/" + name + ".brp"
    _ ?= write_file(source, text)
    verify_unpublished_against(compiler, LIBRARY_ROOT, work_directory, {
        name = name,
        source = source,
        diagnostic = diagnostic,
    })


-- The compiler, given exactly `arguments`, exits with `status`, nothing on
-- stdout and exactly this stderr.
func expect_status(
    compiler: String,
    arguments: List[String],
    prefix: String,
    status: Int,
    expected_stderr: String,
) -> Result[Void, String]:
    invocation ?= isolated(compiler, arguments, COMPILATION_TIMEOUT_MS)
    compiled ?= run_expecting(prefix + ".compile", invocation, status)
    _ ?= expect(compiled.stdout, "", "failed compiler stdout")
    expect(compiled.stderr, expected_stderr, "failed compiler diagnostic")


-- The same, for a rejection: status 1, the code needs fixing.
func expect_failure(
    compiler: String,
    arguments: List[String],
    prefix: String,
    expected_stderr: String,
) -> Result[Void, String]:
    expect_status(compiler, arguments, prefix, EXIT_REJECTED, expected_stderr)


-- The arguments of an ordinary compilation of `source` to `output`.
pure func compile_arguments(library_root: String, source: String, output: String) -> List[String]:
    ["compile", source, "--library-root", library_root, "-o", output]


func verify_rejection(
    compiler: String,
    work_directory: String,
    rejection: Rejection,
) -> Result[Void, String]:
    prefix = work_directory + "/" + rejection.name
    expect_failure(
        compiler,
        compile_arguments(LIBRARY_ROOT, rejection.source, prefix + ".c"),
        prefix,
        rejection.source + rejection.diagnostic,
    )


func reported(result: Result[Void, String]) -> Bool:
    match result:
        Ok(_):
            True
        Err(error):
            print_error(error)
            False


-- A prepare script, which builds on `directory` a tree no fs operation can.
pure func preparation(script: String, directory: String) -> Result[Command, String]:
    isolated(SHELL, [script, directory], NATIVE_TIMEOUT_MS)


-- Rebuilds the directory a program that changes it is given, from nothing.
private func rebuilt_tree(script: String, directory: String) -> Result[Void, String]:
    invocation ?= preparation(script, directory)
    _ ?= run_expecting(script, invocation, 0)
    Ok(void)


-- The write and directories programs change the directory they are given, so
-- each run's two executions get the directory, which is also the program's
-- argument, just rebuilt by its prepare script, and neither sees the other's
-- changes.
func verify_on_rebuilt_tree(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
    program: Program,
    directory: String,
    script: String,
) -> Result[Void, String]:
    prefix: String ?= build_program(
        compiler,
        c_compiler,
        work_directory,
        check_instructions,
        program,
    )
    run_all(
        prefix,
        program.runs,
        func(files: String, run: NativeRun): run_on_rebuilt_tree(files, run, directory, script),
    )


private func run_on_rebuilt_tree(
    prefix: String,
    run: NativeRun,
    directory: String,
    script: String,
) -> Result[Void, String]:
    _ ?= rebuilt_tree(script, directory)
    _ ?= run_normal(prefix, run)
    _ ?= rebuilt_tree(script, directory)
    run_strict(prefix, run)
