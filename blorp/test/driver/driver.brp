-- The whole test tree: test_*.brp files sit in the test_* folders that mirror
-- src/, and every one below it must be listed in COMPONENT_SOURCES, or the full
-- run fails before it builds anything. Scanning the root, not a list of folders,
-- means a new folder cannot escape the check.
private TEST_TREE: String = "blorp/test"


private TEMPORARY_PREFIX: String = "blorp-test."
private USAGE_STATUS: Int = 2


private func test_sources_under(directory: String) -> Result[List[String], String]:
    entries ?= list_entries(directory)
    scan = scan_entries(directory, entries)
    var found: Result[List[String], String] = Ok(scan.test_sources)
    for subdirectory in scan.subdirectories:
        found = match found:
            Ok(sources):
                test_sources_under(subdirectory).map(
                    pure func(nested: List[String]): sources.concat(nested),
                )
            Err(error):
                Err(error)
    found


-- 0 only when every test source below the test tree is in COMPONENT_SOURCES.
private func check_selection() -> Int:
    match test_sources_under(TEST_TREE):
        Ok(found):
            unselected = unselected_sources(found, COMPONENT_SOURCES)
            if (
                unselected
                    .is_empty()
                    .not()
            ):
                print_error(unselected_message(unselected))
                1
            else:
                0
        Err(error):
            print_error(error)
            1


-- 0 only when every suite passed.
private func run_native_suites(run: EndToEndRun, work_directory: String) -> Int:
    compiler = run.compiler
    c_compiler = run.c_compiler
    process_status = run_suite(process_tests.suite(c_compiler, work_directory))
    fs_status = run_suite(fs_tests.suite(c_compiler, work_directory))
    list_status = run_suite(list_tests.suite(c_compiler, work_directory))
    sites_status = run_suite(allocation_site_tests.suite(c_compiler, work_directory))
    literal_status = run_suite(string_literal_tests.suite(c_compiler, work_directory))
    string_runtime_status = run_suite(string_runtime_tests.suite(c_compiler, work_directory))
    directory_e2e_status = run_suite(
        current_directory_tests.suite(compiler, c_compiler, work_directory, run.check_instructions),
    )
    list_e2e_status = run_suite(
        list_e2e_tests.suite(compiler, c_compiler, work_directory, run.check_instructions),
    )
    operator_status = run_suite(
        operator_tests.suite(compiler, c_compiler, work_directory, run.check_instructions),
    )
    dict_status = run_suite(
        dict_tests.suite(compiler, c_compiler, work_directory, run.check_instructions),
    )
    fs_e2e_status = run_suite(
        fs_e2e_tests.suite(compiler, c_compiler, work_directory, run.check_instructions),
    )
    process_e2e_status = run_suite(
        process_e2e_tests.suite(compiler, c_compiler, work_directory, run.check_instructions),
    )
    calls_status = run_suite(
        calls_tests.suite(compiler, c_compiler, work_directory, run.check_instructions),
    )
    strings_status = run_suite(
        strings_tests.suite(compiler, c_compiler, work_directory, run.check_instructions),
    )
    data_status = run_suite(
        data_tests.suite(compiler, c_compiler, work_directory, run.check_instructions),
    )
    control_status = run_suite(
        control_tests.suite(compiler, c_compiler, work_directory, run.check_instructions),
    )
    cli_status = run_suite(cli_tests.suite(compiler, work_directory))
    surface_status = run_suite(
        surface_tests.suite(compiler, c_compiler, work_directory, run.check_instructions),
    )
    if (
        process_status
            .equals(0)
            .and(fs_status.equals(0))
            .and(list_status.equals(0))
            .and(sites_status.equals(0))
            .and(literal_status.equals(0))
            .and(string_runtime_status.equals(0))
            .and(directory_e2e_status.equals(0))
            .and(list_e2e_status.equals(0))
            .and(operator_status.equals(0))
            .and(dict_status.equals(0))
            .and(fs_e2e_status.equals(0))
            .and(process_e2e_status.equals(0))
            .and(calls_status.equals(0))
            .and(strings_status.equals(0))
            .and(data_status.equals(0))
            .and(control_status.equals(0))
            .and(cli_status.equals(0))
            .and(surface_status.equals(0))
    ):
        0
    else:
        1


-- The work directory is removed when the suites end, pass or fail; failing to
-- remove it fails the run.
private func run_native(run: EndToEndRun) -> Int:
    match run.temporary_parent.to_path():
        Err(error):
            print_error("${run.temporary_parent}: ${error}")
            1
        Ok(parent):
            outcome = with_temporary_directory(
                parent,
                TEMPORARY_PREFIX,
                func(work_directory: Path): Ok(run_native_suites(run, "${work_directory}")),
                pure func(error: TemporaryDirectoryError) -> String: "${error}",
            )
            match outcome:
                Ok(status):
                    status
                Err(error):
                    print_error(error)
                    1


-- This ordinary entrypoint runs real suites with the explicit configuration Make
-- passes as arguments; the driver reads no environment.
func main(arguments: List[String]) -> Int:
    match parse_invocation(arguments):
        Err(message):
            print_error(message)
            USAGE_STATUS
        Ok(invocation):
            match invocation:
                Components(run):
                    match component_selection(run.sources, COMPONENT_SOURCES):
                        Ok(selected):
                            -- Only the full run checks the selection: a narrow
                            -- run names its own sources.
                            status = if run.sources.is_empty():
                                check_selection()
                            else:
                                0
                            if status.equals(0):
                                run_suite(component_tests.suite(run.tools, group_sources(selected)))
                            else:
                                status
                        Err(message):
                            print_error(message)
                            1
                EndToEnd(run):
                    run_native(run)
