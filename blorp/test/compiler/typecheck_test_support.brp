private record ValidatedTypeHeaderFixture {
	bound: BoundModuleGraph,
	headers: TypeHeaderGraph,
	importable_graph: ImportableModuleGraph
}


private record ValidatedTypecheckFixture {
	type_headers: ValidatedTypeHeaderFixture,
	accepted_graph: AcceptedTypecheckGraph
}


pure func finalized_typecheck_program_fixture(
	path: String,
	module_name: String,
	text: String,
) -> FinalizedTypecheckProgram:
	finalized_typecheck_program(parse_compiler_source(source_file(path, module_name, text)))


pure func module_id_fixture(module_paths: List[String]) -> Option[PreparedModuleScope]:
	candidates = module_paths.map(func(module_path):
		module_load_candidate(
			resolved_module_identity_from_resolver(module_path, UserModule),
			finalized_typecheck_program_fixture(module_path + ".brp", module_path, ""),
		)
	)

	match module_table(candidates.map(module_load_candidate_resolved_identity)):
		Err(_):
			None
		Ok(table):
			match candidates.get(0):
				None:
					None
				Some(target):
					indexed_graph_build_for_module_table(table, candidates, target)
						.to_option()
						.map(indexed_graph_target_scope)


pure func definition_backed_source_fixture(
	module_path: String,
	source: String,
) -> Option[PreparedModuleScope]:
	candidate = module_load_candidate(
		resolved_module_identity_from_resolver(module_path, UserModule),
		finalized_typecheck_program_fixture(module_path + ".brp", module_path, source),
	)

	match module_table([module_load_candidate_resolved_identity(candidate)]):
		Err(_):
			None
		Ok(table):
			indexed_graph_build_for_module_table(table, [candidate], candidate)
				.to_option()
				.map(indexed_graph_target_scope)


pure func module_id_fixture_find(
	fixture: PreparedModuleScope,
	module_path: String,
) -> Option[ModuleId]:
	prepared_module_scope_find_module(fixture, module_path).map(prepared_module_scope_id)


record DefinitionBackedTypeFixtureModule {
	module_path: String,
	type_names: List[String]
}


record DefinitionBackedRecordFixture {
	name: String,
	field_names: List[String]
}


record DefinitionBackedRecordFixtureModule {
	module_path: String,
	records: List[DefinitionBackedRecordFixture]
}


pure func definition_backed_type_fixture_for_origin(
	modules: List[DefinitionBackedTypeFixtureModule],
	origin: ModuleOrigin,
) -> Option[PreparedModuleScope]:
	candidates = modules.map(func(module):
		source = module.type_names
			.map(func(name):
				"record " + name + " {value: Int}"
			)
			.join("\n")
		module_load_candidate(
			resolved_module_identity_from_resolver(module.module_path, origin),
			finalized_typecheck_program_fixture(
				module.module_path + ".brp",
				module.module_path,
				source,
			),
		)
	)

	match module_table(candidates.map(module_load_candidate_resolved_identity)):
		Err(_):
			None
		Ok(table):
			match candidates.get(0):
				None:
					None
				Some(target):
					indexed_graph_build_for_module_table(table, candidates, target)
						.to_option()
						.map(indexed_graph_target_scope)


pure func definition_backed_type_fixture(
	modules: List[DefinitionBackedTypeFixtureModule],
) -> Option[PreparedModuleScope]:
	definition_backed_type_fixture_for_origin(modules, UserModule)


pure func definition_backed_record_fixture(
	modules: List[DefinitionBackedRecordFixtureModule],
) -> Option[PreparedModuleScope]:
	candidates = modules.map(func(module):
		source = module.records
			.map(func(record_fixture):
				"record " + record_fixture.name + " {" + record_fixture.field_names
					.map(func(name): name + ": Int")
					.join(", ") + "}"
			)
			.join("\n")
		module_load_candidate(
			resolved_module_identity_from_resolver(module.module_path, UserModule),
			finalized_typecheck_program_fixture(
				module.module_path + ".brp",
				module.module_path,
				source,
			),
		)
	)

	match module_table(candidates.map(module_load_candidate_resolved_identity)):
		Err(_):
			None
		Ok(table):
			match candidates.get(0):
				None:
					None
				Some(target):
					indexed_graph_build_for_module_table(table, candidates, target)
						.to_option()
						.map(indexed_graph_target_scope)


pure func definition_backed_type_fixture_definition_table(
	fixture: PreparedModuleScope,
) -> DefinitionTable:
	definition_index_definition_table(prepared_module_scope_definition_index(fixture))


pure func definition_backed_type_fixture_type_id(
	fixture: PreparedModuleScope,
	module_path: String,
	name: String,
) -> Option[TypeId]:
	module_id ?= module_id_fixture_find(fixture, module_path)
	index = prepared_module_scope_definition_index(fixture)
	table = prepared_module_scope_module_table(fixture)
	runtime_id ?= definition_index_find_type_definition_id(index, table, module_id, name)
	type_id_from_definition_table(definition_index_definition_table(index), runtime_id)


pure func definition_backed_record_fixture_field_id(
	fixture: PreparedModuleScope,
	module_path: String,
	record_name: String,
	field_name: String,
) -> Option[FieldId]:
	module_id ?= module_id_fixture_find(fixture, module_path)
	index = prepared_module_scope_definition_index(fixture)
	definition_table = definition_index_definition_table(index)
	var result: Option[FieldId] = None
	var match_count: Int = 0

	for (key, definition_id) in definition_index_source_definition_bindings(index, field_name):
		if (
			source_definition_key_kind(key) == FieldDefinition
			and module_ids_equal(source_definition_key_module_id(key), module_id)
			and source_definition_key_owner(key) == Some(record_name)
		):
			result = definition_table_field_id(definition_table, definition_id)
			match_count += 1

	if match_count == 1:
		result
	else:
		None


private pure func module_candidate_from_program(
	program: ParsedProgram,
	origin: ModuleOrigin,
) -> ModuleLoadCandidate:
	module_load_candidate(
		resolved_module_identity_from_resolver(program.source.module_name, origin),
		finalized_typecheck_program(program),
	)


private pure func module_candidate_from_import(module: ImportableModule) -> ModuleLoadCandidate:
	scope = importable_module_prepared_scope(module)
	prepared = prepared_module_scope_module(scope)
	module_load_candidate(
		resolved_module_identity_from_resolver(
			prepared_module_canonical_path(prepared),
			prepared_module_origin(prepared),
		),
		finalized_typecheck_program(prepared_module_program(prepared)),
	)


private pure func bind_test_module(
	import_index: ImportableModuleIndex,
	scope: PreparedModuleScope,
) -> BoundModuleViewBinding:
	prepared = prepared_module_scope_module(scope)
	typecheck_bind_program_module_view(
		typecheck_state_for_origin(prepared_module_origin(prepared)),
		prepared_module_program(prepared),
		import_index,
		prepared_module_canonical_path(prepared),
	)


private pure func validated_type_header_fixture(
	state: TypecheckState,
	program: ParsedProgram,
	import_modules: List[ImportableModule],
) -> Result[ValidatedTypeHeaderFixture, String]:
	target = module_candidate_from_program(program, typecheck_state_module_origin(state))
	dependencies = import_modules.map(module_candidate_from_import)
	indexed ?= indexed_graph_build(
		target,
		dependencies,
	).map_err(
		func(_): "indexed graph construction failed",
	)
	importable_graph = importable_module_graph(indexed)
	all_importable_index = importable_module_graph_all_index(importable_graph)
	bound ?= bound_module_graph_build(
		indexed,
		import_modules.map(importable_module_path),
		func(scope): bind_test_module(all_importable_index, scope),
	).map_err(func(_): "bound module graph construction failed")
	skeletons ?= declaration_skeleton_graph_build(
		bound,
	).map_err(
		func(errors): "declaration skeleton graph construction failed: " + errors
			.map(declaration_skeleton_graph_error_message)
			.join("; "),
	)
	aliases ?= type_alias_dependency_graph_validate(
		skeletons,
	).map_err(
		func(_): "type alias dependency validation failed",
	)
	parameters ?= resolved_type_parameter_graph_build(
		aliases,
	).map_err(
		func(_): "resolved type parameter graph construction failed",
	)
	headers ?= type_header_graph_build(
		parameters,
	).map_err(
		func(_): "type header graph construction failed",
	)
	Ok({
		bound = bound,
		headers = headers,
		importable_graph = importable_graph,
	})


private pure func validated_typecheck_fixture(
	state: TypecheckState,
	program: ParsedProgram,
	import_modules: List[ImportableModule],
) -> Result[ValidatedTypecheckFixture, String]:
	type_headers ?= validated_type_header_fixture(state, program, import_modules)
	topology ?= trait_topology_graph_build(
		type_headers.headers,
	).map_err(
		func(_): "trait topology graph construction failed",
	)
	callables ?= callable_header_graph_build(
		topology,
	).map_err(
		func(_): "callable header graph construction failed",
	)
	implementations ?= implementation_header_graph_build(
		callables,
	).map_err(
		func(_): "implementation header graph construction failed",
	)

	accepted ?= match complete_typecheck_graph(
		implementations,
		type_headers.importable_graph,
		False,
	):
		TypecheckGraphAccepted(graph):
			Ok(graph)
		TypecheckGraphRecoverable(graph):
			Err(
				recoverable_typecheck_graph_diagnostics(graph)
					.map(func(diagnostic): diagnostic.message)
					.join("; "),
			)
		TypecheckGraphCompletionRejected(errors):
			Err(errors.join("; "))

	Ok({
		type_headers = type_headers,
		accepted_graph = accepted,
	})


private pure func rejected_typecheck_fixture_result(
	state: TypecheckState,
	program: ParsedProgram,
	reason: String,
) -> TypecheckProgramResult:
	rejected_typecheck_program(
		state,
		program,
		"test fixture could not build a validated type-header graph: ${reason}",
	)


-- Phase-local tests often accumulate environment facts before they ask for
-- type headers. Preserve those facts while adopting the graph-owned definition
-- scope. Production enters this scope before any typecheck state is populated.
private pure func test_state_in_prepared_scope(
	state: TypecheckState,
	scope: PreparedModuleScope,
) -> TypecheckState:
	prepared_state = typecheck_state_enter_prepared_module_scope(
		typecheck_state_for_origin(typecheck_state_module_origin(state)),
		scope,
	)

	next_def_id = if state.env.next_def_id > prepared_state.env.next_def_id:
		state.env.next_def_id
	else:
		prepared_state.env.next_def_id

	{ state |
		env = { state.env | next_def_id = next_def_id },
		module_scope = prepared_state.module_scope
	}


pure func typecheck_test_program_with_import_modules(
	state: TypecheckState,
	program: ParsedProgram,
	import_modules: List[ImportableModule],
) -> TypecheckProgramResult:
	match validated_typecheck_fixture(state, program, import_modules):
		Err(reason):
			rejected_typecheck_fixture_result(state, program, reason)
		Ok(fixture):
			target = bound_module_graph_target(fixture.type_headers.bound)
			scoped_state = test_state_in_prepared_scope(state, bound_module_scope(target))

			match accepted_graph_typecheck_module(
				fixture.accepted_graph,
				bound_module_scope(target),
				state.allow_debug_only_calls,
			):
				Some(input):
					typecheck_program_with_type_header_module(input)
				None:
					rejected_typecheck_fixture_result(
						scoped_state,
						program,
						"accepted graph does not own target module",
					)


pure func typecheck_test_accepted_module(
	state: TypecheckState,
	program: ParsedProgram,
	import_modules: List[ImportableModule],
) -> Result[AcceptedTypecheckModule, String]:
	fixture ?= validated_typecheck_fixture(state, program, import_modules)
	target = bound_module_graph_target(fixture.type_headers.bound)

	accepted_graph_typecheck_module(
		fixture.accepted_graph,
		bound_module_scope(target),
		state.allow_debug_only_calls,
	).to_result("accepted graph does not own target module")


pure func typecheck_test_accepted_graph(
	state: TypecheckState,
	program: ParsedProgram,
	import_modules: List[ImportableModule],
) -> Result[AcceptedTypecheckGraph, String]:
	fixture ?= validated_typecheck_fixture(state, program, import_modules)
	Ok(fixture.accepted_graph)


pure func typecheck_test_program(
	state: TypecheckState,
	program: ParsedProgram,
) -> TypecheckProgramResult:
	typecheck_test_program_with_import_modules(state, program, [])


pure func typecheck_test_install_validated_type_headers(
	state: TypecheckState,
	program: ParsedProgram,
) -> TypecheckState:
	match validated_type_header_fixture(state, program, []):
		Err(reason):
			rejected_typecheck_fixture_result(state, program, reason).state
		Ok(fixture):
			target: BoundModule = bound_module_graph_target(fixture.bound)
			module_scope = bound_module_scope(target)
			module_path = prepared_module_canonical_path(prepared_module_scope_module(module_scope))
			scoped_state = test_state_in_prepared_scope(state, module_scope)
			with_builtins = typecheck_install_local_builtin_headers(
				scoped_state,
				fixture.headers,
				module_scope,
				module_path,
			)
			with_records = typecheck_install_local_record_headers(
				with_builtins,
				fixture.headers,
				module_scope,
				module_path,
			)
			with_unions = typecheck_install_local_union_headers(
				with_records,
				fixture.headers,
				module_scope,
				module_path,
			)
			typecheck_install_local_alias_headers(
				with_unions,
				fixture.headers,
				module_scope,
				module_path,
			)
