-- Test fixtures for entering typecheck through the same validated type-header
-- graph used by production compilation. Phase-local tests may stop after local
-- header installation, but they must not reconstruct type facts from ParsedDecl.
import:
	../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../src/compiler/stage_03_parse/parsed_ast: ParsedProgram
	../../src/compiler/stage_03_parse/source_ast_finalize:
		FinalizedTypecheckProgram,
		finalized_typecheck_program,
	../../src/compiler/stage_04_modules/loaded_module:
		ModuleLoadCandidate,
		ModuleOrigin,
		module_load_candidate,
		resolved_module_identity_from_resolver,
	../../src/compiler/stage_06_typecheck/decl:
		AcceptedTypecheckGraph,
		AcceptedTypecheckModule,
		TypecheckGraphCompletion(
			TypecheckGraphAccepted,
			TypecheckGraphCompletionRejected,
			TypecheckGraphRecoverable,
		),
		TypecheckProgramResult,
		accepted_graph_typecheck_module,
		complete_typecheck_graph,
		recoverable_typecheck_graph_diagnostics,
		rejected_typecheck_program,
		typecheck_bind_program_module_view,
		typecheck_program_with_type_header_module,
	../../src/compiler/stage_06_typecheck/graph/indexed_graph:
		PreparedModuleScope,
		indexed_graph_build,
		prepared_module_canonical_path,
		prepared_module_origin,
		prepared_module_program,
		prepared_module_scope_module,
	../../src/compiler/stage_06_typecheck/headers/callable_headers: callable_header_graph_build
	../../src/compiler/stage_06_typecheck/headers/declaration_skeleton:
		declaration_skeleton_graph_build,
		declaration_skeleton_graph_error_message,
	../../src/compiler/stage_06_typecheck/headers/implementation_headers:
		implementation_header_graph_build,
	../../src/compiler/stage_06_typecheck/headers/trait_headers: trait_topology_graph_build
	../../src/compiler/stage_06_typecheck/headers/type_header_dependencies:
		type_alias_dependency_graph_validate,
	../../src/compiler/stage_06_typecheck/headers/type_header_graph:
		TypeHeaderGraph,
		type_header_graph_build,
	../../src/compiler/stage_06_typecheck/headers/type_header_install:
		typecheck_install_local_alias_headers,
