import:
	../../../benchmark/compiler/compiler_callable_name_registry_profile_fixture:
		CompilerCallableNameRegistryProfileShape(
			ImplCallableProfileShape,
			PrivateCallableProfileShape,
		),
		compiler_callable_name_registry_profile,
		compiler_callable_name_registry_profile_for_shape,
	test: TestSuite


private func test_callable_name_registry_profile_single_module_counts_work() -> Bool:
	result = compiler_callable_name_registry_profile({
		iterations = 1,
		module_count = 1,
		total_callables = 16,
	})

	(
		result.workload_valid
		and result.registered_callables == 16
		and result.output_declarations >= 16
		and result.checksum > 0
	)


private func test_callable_name_registry_profile_multi_module_counts_work() -> Bool:
	result = compiler_callable_name_registry_profile({
		iterations = 2,
		module_count = 4,
		total_callables = 18,
	})

	(
		result.workload_valid
		and result.registered_callables == 18
		and result.output_declarations >= 18
		and result.checksum > 0
	)


private func test_callable_name_registry_profile_private_counts_work() -> Bool:
	result = compiler_callable_name_registry_profile_for_shape(
		{
			iterations = 1,
			module_count = 4,
			total_callables = 24
		},
		PrivateCallableProfileShape,
	)

	(
		result.workload_valid
		and result.registered_callables == 24
		and result.output_declarations >= 24
		and result.checksum > 0
	)


private func test_callable_name_registry_profile_impl_counts_work() -> Bool:
	result = compiler_callable_name_registry_profile_for_shape(
		{
			iterations = 1,
			module_count = 4,
			total_callables = 24
		},
		ImplCallableProfileShape,
	)

	(
		result.workload_valid
		and result.registered_callables == 24
		and result.output_declarations >= 4
		and result.checksum > 0
	)


tests: TestSuite = {
	description = "Compiler callable-name registry profile benchmark",
	tests = [
		(
			"single module counts work",
			test_callable_name_registry_profile_single_module_counts_work,
		),
		("multi module counts work", test_callable_name_registry_profile_multi_module_counts_work),
		(
			"private declarations count work",
			test_callable_name_registry_profile_private_counts_work,
		),
		("impl methods count work", test_callable_name_registry_profile_impl_counts_work),
	]
}
