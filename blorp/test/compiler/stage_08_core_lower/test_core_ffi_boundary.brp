import:
	../../../src/compiler/stage_08_core_lower/ffi_boundary:
		CoreFfiBoundaryError(CoreFfiManagedDefaultArg),
		annotate_ffi_boundaries,
	../../../src/compiler/stage_09_core/ir:
		CoreDecl(FunctionDecl),
		CoreForeignArgPassing(ForeignBorrowArgs, ForeignDefaultArgs),
		CoreForeignDefaultArgPolicy(ForeignDefensiveCopy, ForeignScalarByValue),
		CoreFunctionKind(ForeignFunction),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType),
	test: TestSuite


pure func foreign_program(arg_passing: CoreForeignArgPassing) -> CoreProgram:
	{
		decls = [
			FunctionDecl({
				name = "mix",
				source_module = None,
				type_params = [],
				params = [
					{
						name = {
							name = "text",
							uniq = 0,
							def_id = None
						},
						typ = NamedType("String", []),
						loc = SyntheticSourceLoc
					},
					{
						name = {
							name = "count",
							uniq = 0,
							def_id = None
						},
						typ = NamedType("Int", []),
						loc = SyntheticSourceLoc
					},
					{
						name = {
							name = "bytes",
							uniq = 0,
							def_id = None
						},
						typ = NamedType("Bytes", []),
						loc = SyntheticSourceLoc
					},
				],
				return_type = NamedType("Void", []),
				body = None,
				is_pure = False,
				function_kind = ForeignFunction({
					c_name = "c_mix",
					includes = ["native.h"],
					link_flags = [],
					arg_passing = arg_passing,
				}),
				def_id = 1,
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}


pure func test_attaches_default_policies() -> Bool:
	match annotate_ffi_boundaries(foreign_program(ForeignDefaultArgs([]))):
		Ok(annotated):
			match annotated.decls:
				[FunctionDecl(function_info)]:
					match function_info.function_kind:
						ForeignFunction(foreign_info):
							match foreign_info.arg_passing:
								ForeignDefaultArgs([ForeignDefensiveCopy(ForeignStringCopy), ForeignScalarByValue, ForeignDefensiveCopy(ForeignBytesCopy)]):
									(
										foreign_info.c_name == "c_mix"
										and foreign_info.includes == ["native.h"]
									)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_preserves_explicit_borrow() -> Bool:
	match annotate_ffi_boundaries(foreign_program(ForeignBorrowArgs)):
		Ok(annotated):
			match annotated.decls:
				[FunctionDecl(function_info)]:
					match function_info.function_kind:
						ForeignFunction(foreign_info):
							match foreign_info.arg_passing:
								ForeignBorrowArgs:
									True
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_rejects_managed_default_arg() -> Bool:
	program: CoreProgram = foreign_program(ForeignDefaultArgs([]))
	managed_param: CoreParam = {
		name = {
			name = "items",
			uniq = 0,
			def_id = None
		},
		typ = NamedType("List", [NamedType("Int", [])]),
		loc = SyntheticSourceLoc
	}

	match program.decls:
		[FunctionDecl(function_info)]:
			match annotate_ffi_boundaries(
				{ program |
					decls = [FunctionDecl({ function_info | params = [managed_param] })]
				},
			):
				Err(CoreFfiManagedDefaultArg(name, _)):
					name == "items"
				_:
					False
		_:
			False


pure func test_large_declaration_program_is_stack_bounded() -> Bool:
	base: CoreProgram = foreign_program(ForeignBorrowArgs)

	match base.decls.get(0):
		Some(decl):
			expected_count: Int = 16384
			var decls: List[CoreDecl] = []
			var index: Int = 0

			while index < expected_count:
				decls = decls.append(decl)
				index += 1

			match annotate_ffi_boundaries({ base | decls = decls }):
				Ok(annotated):
					annotated.decls.length() == expected_count
				Err(_):
					False
		None:
			False


tests: TestSuite = {
	description = "Blorp compiler Core FFI boundary",
	tests = [
		("attaches default policies", test_attaches_default_policies),
		("preserves explicit borrow", test_preserves_explicit_borrow),
		("rejects managed default arg", test_rejects_managed_default_arg),
		(
			"large declaration program is stack bounded",
			test_large_declaration_program_is_stack_bounded,
		),
	]
}
