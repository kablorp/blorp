pure func argument_concretization_program(
	argument_type: CoreType,
	expected_type: String,
	specialized_def_id: Option[Int],
) -> CoreProgram:
	call_kind: CoreCallKind = match specialized_def_id:
		Some(def_id):
			SelectedDirectCall(def_id)
		None:
			SelectedDirectCall(10)

	callee_name: String = match specialized_def_id:
		Some(_):
			"identity__mono_${expected_type}"
		None:
			"identity"

	callee_def_id: Option[Int] = match specialized_def_id:
		Some(_):
			None
		None:
			Some(10)

	call: CoreExpr = CallExpr(
		call_kind,
		VarExpr(
			named_var(callee_name, callee_def_id),
			function_type(named_type(expected_type), named_type(expected_type)),
			synthetic_core_source_loc(),
		),
		[LiteralExpr(IntLiteral(1), argument_type, synthetic_core_source_loc())],
		named_type(expected_type),
		synthetic_core_source_loc(),
	)
	var decls: List[CoreDecl] = [
		FunctionDecl(identity_function("identity", 10, ["T"], type_parameter("T"))),
		FunctionDecl(main_function(call)),
	]

	match specialized_def_id:
		Some(def_id):
			decls = decls.append(
				FunctionDecl(
					mono_instance(
						identity_function(
							"identity__mono_${expected_type}",
							def_id,
							[],
							named_type(expected_type),
						),
						10,
						"T",
						expected_type,
					),
				),
			)
		None:
			void

	{
		decls = decls,
		foreign_includes = [],
		source_files = []
	}


func test_concretizes_argument_types_from_return_evidence() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		argument_concretization_program(type_parameter("T"), "Int", None),
		100,
	)

	actual.next_def_id == 101 and programs_equal(
		actual.program,
		argument_concretization_program(named_type("Int"), "Int", Some(100)),
	)


pure func tensor_type(element_type: CoreType, dims: List[CoreTensorDim]) -> CoreType:
	TensorType({
		element_type = element_type,
		dims = dims,
	})


pure func tensor_function(
	name: String,
	def_id: Int,
	type_params: List[String],
	params: List[CoreParam],
) -> CoreFunction:
	{
		name = name,
		source_module = None,
		type_params = type_params,
		params = params,
		return_type = named_type("Int"),
		body = Some(LiteralExpr(IntLiteral(1), named_type("Int"), synthetic_core_source_loc())),
		is_pure = True,
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = UserFunction,
		def_id = def_id,
		loc = synthetic_core_source_loc()
	}


pure func tensor_param(name: String, typ: CoreType) -> CoreParam:
	{
		name = named_var(name, None),
		typ = typ,
		loc = synthetic_core_source_loc()
	}


pure func tensor_call_program(function: CoreFunction, args: List[CoreExpr]) -> CoreProgram:
	callee_type: CoreType = FunctionType(
		True,
		function.params.map(func(param): param.typ),
		function.return_type,
	)
	call: CoreExpr = CallExpr(
		SelectedDirectCall(function.def_id),
		VarExpr(
			named_var(function.name, Some(function.def_id)),
			callee_type,
			synthetic_core_source_loc(),
		),
		args,
		function.return_type,
		synthetic_core_source_loc(),
	)

	{
		decls = [FunctionDecl(function), FunctionDecl(main_function(call))],
		foreign_includes = [],
		source_files = []
	}


pure func program_has_function(program: CoreProgram, name: String) -> Bool:
	var found: Bool = False

	for decl in program.decls:
		match decl:
			FunctionDecl(function):
				if function.name == name:
					found = True
					break
			_:
				void

	found


pure func program_has_function_with_prefix(program: CoreProgram, prefix: String) -> Bool:
	program.decls.any(pure func(decl):
		match decl:
			FunctionDecl(function):
				function.name.starts_with(prefix)
			_:
				False
	)


