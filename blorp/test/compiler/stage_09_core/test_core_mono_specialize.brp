func test_recursive_specialization_is_deduplicated() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		recursive_source_program("Int"),
		100,
	)

	actual.next_def_id == 101 and programs_equal(
		actual.program,
		recursive_expected_program("Int", 100),
	)


func test_duplicate_heavy_requests_keep_first_seen_order() -> Bool:
	int_type: CoreType = named_type("Int")
	bool_type: CoreType = named_type("Bool")
	var body: CoreExpr = identity_call("recur", int_type, SelectedDirectCall(13), Some(13))
	var duplicate_count: Int = 0

	while duplicate_count < 64:
		body = SeqExpr(
			identity_call("recur", bool_type, SelectedDirectCall(13), Some(13)),
			body,
		)
		duplicate_count += 1

	source: CoreProgram = {
		decls = [
			FunctionDecl(
				generic_function(
					"recur",
					13,
					["T"],
					type_parameter("T"),
					call_with_argument(
						"recur",
						type_parameter("T"),
						"value",
						SelectedDirectCall(13),
						Some(13),
					),
				),
			),
			FunctionDecl(main_function(body)),
		],
		foreign_includes = [],
		source_files = []
	}
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(source, 100)

	match (actual.program.decls.get(2), actual.program.decls.get(3)):
		(Some(FunctionDecl(first)), Some(FunctionDecl(second))):
			(
				actual.next_def_id == 102
				and actual.program.decls.length() == 4
				and first.name == "recur__mono_Bool"
				and first.def_id == 100
				and second.name == "recur__mono_Int"
				and second.def_id == 101
			)
		_:
			False


func test_request_order_survives_many_unique_requests_with_transitive_duplicate() -> Bool:
	last_request_index: Int = 256
	unique_request_count: Int = last_request_index + 1
	source_def_id_start: Int = 1000
	generated_def_id_start: Int = 2000
	int_type: CoreType = named_type("Int")
	var decls: List[CoreDecl] = []
	var source_index: Int = 0

	while source_index < unique_request_count:
		name: String = "identity_${source_index}"
		def_id: Int = source_def_id_start + source_index
		function: CoreFunction = if source_index == last_request_index:
			generic_function(
				name,
				def_id,
				["T"],
				type_parameter("T"),
				call_with_argument(
					"identity_0",
					type_parameter("T"),
					"value",
					SelectedDirectCall(source_def_id_start),
					Some(source_def_id_start),
				),
			)
		else:
			identity_function(name, def_id, ["T"], type_parameter("T"))
		decls = decls.append(FunctionDecl(function))
		source_index += 1

	var call_index: Int = unique_request_count - 1
	var body: CoreExpr = identity_call(
		"identity_${call_index}",
		int_type,
		SelectedDirectCall(source_def_id_start + call_index),
		Some(source_def_id_start + call_index),
	)
	call_index -= 1
	while call_index >= 0:
		body = SeqExpr(
			identity_call(
				"identity_${call_index}",
				int_type,
				SelectedDirectCall(source_def_id_start + call_index),
				Some(source_def_id_start + call_index),
			),
			body,
		)
		call_index -= 1

	decls = decls.append(FunctionDecl(main_function(body)))
	program: CoreProgram = { decls = decls, foreign_includes = [], source_files = [] }
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		program,
		generated_def_id_start,
	)
	generated_start: Int = unique_request_count + 1
	var ordered: Bool = True
	var generated_index: Int = 0
	while generated_index < unique_request_count:
		match actual.program.decls.get(generated_start + generated_index):
			Some(FunctionDecl(function)):
				if (
					function.name != "identity_${generated_index}__mono_Int"
					or function.def_id != generated_def_id_start + generated_index
				):
					ordered = False
					break
			_:
				ordered = False
				break
		generated_index += 1

	last_rewrites_first: Bool = match actual.program.decls.get(generated_start + last_request_index):
		Some(FunctionDecl(function)):
			match function.body:
				Some(CallExpr(SelectedDirectCall(target_def_id), VarExpr(variable, _, _), _, _, _)):
					(
						variable.name == "identity_0__mono_Int"
						and variable.def_id.is_none()
						and target_def_id == generated_def_id_start
					)
				_:
					False
		_:
			False

	(
		actual.next_def_id == generated_def_id_start + unique_request_count
		and actual.program.decls.length() == generated_start + unique_request_count
		and ordered
		and last_rewrites_first
	)


pure func conflicting_source_program(argument_type: String, result_type: String) -> CoreProgram:
	conflicting_call: CoreExpr = CallExpr(
		SelectedDirectCall(10),
		VarExpr(
			named_var("identity", Some(10)),
			function_type(named_type(argument_type), named_type(result_type)),
			synthetic_core_source_loc(),
		),
		[VarExpr(
				named_var("argument", None),
				named_type(argument_type),
				synthetic_core_source_loc(),
			)],
		named_type(result_type),
		synthetic_core_source_loc(),
	)

	{
		decls = [
			FunctionDecl(identity_function("identity", 10, ["T"], type_parameter("T"))),
			FunctionDecl(main_function(conflicting_call)),
		],
		foreign_includes = [],
		source_files = []
	}


---
Two calls at different types plus a repeat of the first: one generic function
yields two instances, each with its own fresh id and the shared base in its
origin, and the repeat resolves to the first instance's id.
---
pure func repeated_request_source_program() -> CoreProgram:
	int_type: CoreType = named_type("Int")
	bool_type: CoreType = named_type("Bool")
	body: CoreExpr = SeqExpr(
		identity_call("identity", int_type, SelectedDirectCall(10), Some(10)),
		SeqExpr(
			identity_call("identity", bool_type, SelectedDirectCall(10), Some(10)),
			identity_call("identity", int_type, SelectedDirectCall(10), Some(10)),
		),
	)

	{
		decls = [
			FunctionDecl(identity_function("identity", 10, ["T"], type_parameter("T"))),
			FunctionDecl(main_function(body)),
		],
		foreign_includes = [],
		source_files = []
	}


pure func instance_base_def_id(function: CoreFunction) -> Option[Int]:
	match core_function_declared_origin(function.origin):
		MonoInstance(base_def_id, _):
			Some(base_def_id)
		_:
			None


pure func main_call_target_ids(program: CoreProgram) -> List[Int]:
	var ids: List[Int] = []

	for decl in program.decls:
		match decl:
			FunctionDecl(function):
				if function.name == "main":
					match function.body:
						Some(SeqExpr(first, SeqExpr(second, third))):
							for call in [first, second, third]:
								match call:
									CallExpr(SelectedDirectCall(target_def_id), VarExpr(variable, _, _), _, _, _):
										if variable.def_id.is_none():
											ids = ids.append(target_def_id)
									_:
										void
						_:
							void
			_:
				void

	ids


func test_instances_of_one_generic_have_distinct_ids_and_the_same_base() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		repeated_request_source_program(),
		100,
	)

	match (actual.program.decls.get(2), actual.program.decls.get(3)):
		(Some(FunctionDecl(first)), Some(FunctionDecl(second))):
			(
				actual.program.decls.length() == 4
				and first.def_id == 100
				and second.def_id == 101
				and instance_base_def_id(first) == Some(10)
				and instance_base_def_id(second) == Some(10)
				and actual.next_def_id == 102
			)
		_:
			False


func test_repeated_request_reuses_the_first_instance_id() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		repeated_request_source_program(),
		100,
	)

	main_call_target_ids(actual.program) == [100, 101, 100]


pure func int_binding(parameter: String) -> (String, CoreMonoSubstitutionValue):
	(parameter, TypeSubstitution(named_type("Int")))


pure func bool_binding(parameter: String) -> (String, CoreMonoSubstitutionValue):
	(parameter, TypeSubstitution(named_type("Bool")))


pure func key_base_function(def_id: Int, type_params: List[String]) -> CoreFunction:
	identity_function("keyed", def_id, type_params, type_parameter("A"))


pure func key_for(base: CoreFunction, substitution: CoreMonoSubstitution) -> Option[CoreMonoInstanceKey]:
	arguments ?= closed_substitution_arguments(substitution, base.type_params)
	Some(core_mono_instance_key(base.def_id, arguments))


pure func with_instance(
	index: CoreMonoInstanceIndex,
	base: CoreFunction,
	substitution: CoreMonoSubstitution,
	def_id: Int,
) -> CoreMonoInstanceIndex:
	match key_for(base, substitution):
		Some(key):
			add_core_mono_instance(index, key, { def_id = def_id, name = "keyed__mono" })
		None:
			index


pure func instance_id_for(
	index: CoreMonoInstanceIndex,
	base: CoreFunction,
	substitution: CoreMonoSubstitution,
) -> Option[Int]:
	key ?= key_for(base, substitution)
	find_core_mono_instance(index, key).map(pure func(instance: CoreMonoInstance) -> Int: instance.def_id)


func test_instance_key_ignores_binding_order() -> Bool:
	base: CoreFunction = key_base_function(7, ["A", "B"])
	index = with_instance(
		empty_core_mono_instance_index(),
		base,
		[int_binding("A"), bool_binding("B")],
		55,
	)

	instance_id_for(index, base, [bool_binding("B"), int_binding("A")]) == Some(55)


func test_instance_key_is_positional_in_the_base_parameters() -> Bool:
	base: CoreFunction = key_base_function(7, ["A", "B"])
	index = with_instance(
		empty_core_mono_instance_index(),
		base,
		[int_binding("A"), bool_binding("B")],
		55,
	)

	instance_id_for(index, base, [bool_binding("A"), int_binding("B")]).is_none()


func test_instance_key_distinguishes_arguments_and_base() -> Bool:
	base: CoreFunction = key_base_function(7, ["T"])
	index = with_instance(empty_core_mono_instance_index(), base, [int_binding("T")], 55)

	(
		instance_id_for(index, base, [bool_binding("T")]).is_none()
		and instance_id_for(index, key_base_function(8, ["T"]), [int_binding("T")]).is_none()
		and instance_id_for(index, base, [int_binding("T")]) == Some(55)
	)


func test_instance_key_requires_every_parameter_bound() -> Bool:
	base: CoreFunction = key_base_function(7, ["A", "B"])

	closed_substitution_arguments([int_binding("A")], base.type_params).is_none()


func test_equal_hashes_with_different_arguments_do_not_merge() -> Bool:
	int_key: CoreMonoInstanceKey = {
		base_def_id = 7,
		arguments = [TypeSubstitution(named_type("Int"))],
		structural_hash = 42
	}
	bool_key: CoreMonoInstanceKey = {
		base_def_id = 7,
		arguments = [TypeSubstitution(named_type("Bool"))],
		structural_hash = 42
	}
	index = add_core_mono_instance(
		add_core_mono_instance(
			empty_core_mono_instance_index(),
			int_key,
			{ def_id = 1, name = "one" },
		),
		bool_key,
		{ def_id = 2, name = "two" },
	)

	(
		find_core_mono_instance(index, int_key).map(pure func(i: CoreMonoInstance) -> Int: i.def_id) == Some(1)
		and find_core_mono_instance(index, bool_key).map(pure func(i: CoreMonoInstance) -> Int: i.def_id) == Some(2)
	)


func test_instance_key_normalizes_equal_dimensions() -> Bool:
	base: CoreFunction = key_base_function(7, ["N"])
	product_dim: CoreTensorDim = TensorDimOperation(
		DimMultiply,
		TensorStaticDim(2),
		TensorStaticDim(3),
	)
	folded: CoreMonoSubstitutionValue = DimSubstitution(TensorStaticDim(6))
	unfolded: CoreMonoSubstitutionValue = DimSubstitution(product_dim)
	index = with_instance(empty_core_mono_instance_index(), base, [("N", folded)], 55)

	instance_id_for(index, base, [("N", unfolded)]) == Some(55)


