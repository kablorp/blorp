pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


pure func type_parameter(name: String) -> CoreType:
	TypeParameterType(name)


pure func named_var(name: String, def_id: Option[Int]) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = def_id,
		origin = AuthoredBinder
	}


pure func function_type(param_type: CoreType, return_type: CoreType) -> CoreType:
	FunctionType(True, [param_type], return_type)


pure func generic_function(
	name: String,
	def_id: Int,
	type_params: List[String],
	value_type: CoreType,
	body: CoreExpr,
) -> CoreFunction:
	{
		name = name,
		source_module = None,
		type_params = type_params,
		params = [
			{
				name = named_var("value", None),
				typ = value_type,
				loc = synthetic_core_source_loc()
			},
		],
		return_type = value_type,
		body = Some(body),
		is_pure = True,
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = UserFunction,
		def_id = def_id,
		loc = synthetic_core_source_loc()
	}


pure func identity_function(
	name: String,
	def_id: Int,
	type_params: List[String],
	value_type: CoreType,
) -> CoreFunction:
	generic_function(
		name,
		def_id,
		type_params,
		value_type,
		VarExpr(
			named_var("value", None),
			value_type,
			synthetic_core_source_loc(),
		),
	)


pure func generic_builtin_function(
	name: String,
	module_name: String,
	def_id: Int,
	type_params: List[String],
	value_type: CoreType,
) -> CoreFunction:
	{
		name = name,
		source_module = Some(module_name),
		type_params = type_params,
		params = [
			{
				name = named_var("value", None),
				typ = value_type,
				loc = synthetic_core_source_loc()
			},
		],
		return_type = value_type,
		body = None,
		is_pure = True,
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = UnresolvedBuiltinFunction,
		def_id = def_id,
		loc = synthetic_core_source_loc()
	}


pure func call_with_argument(
	target_name: String,
	target_type: CoreType,
	argument_name: String,
	call_kind: CoreCallKind,
	callee_def_id: Option[Int],
) -> CoreExpr:
	CallExpr(
		call_kind,
		VarExpr(
			named_var(target_name, callee_def_id),
			function_type(target_type, target_type),
			synthetic_core_source_loc(),
		),
		[VarExpr(
				named_var(argument_name, None),
				target_type,
				synthetic_core_source_loc(),
			)],
		target_type,
		synthetic_core_source_loc(),
	)


pure func identity_call(
	target_name: String,
	target_type: CoreType,
	call_kind: CoreCallKind,
	callee_def_id: Option[Int],
) -> CoreExpr:
	call_with_argument(target_name, target_type, "argument", call_kind, callee_def_id)


pure func main_function(body: CoreExpr) -> CoreFunction:
	{
		name = "main",
		source_module = None,
		type_params = [],
		params = [],
		return_type = named_type("Int"),
		body = Some(body),
		is_pure = True,
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = UserFunction,
		def_id = 20,
		loc = synthetic_core_source_loc()
	}


pure func decoder_type(value_type: CoreType) -> CoreType:
	FunctionType(
		True,
		[named_type("Value")],
		NamedType(
			"Result",
			[value_type, named_type("DecodeError")],
		),
	)


pure func field_function() -> CoreFunction:
	value_type = type_parameter("T")
	{
		name = "codec__field",
		source_module = Some("codec"),
		type_params = ["T"],
		params = [
			{
				name = named_var("name", None),
				typ = named_type("String"),
				loc = synthetic_core_source_loc()
			},
			{
				name = named_var("decoder", None),
				typ = decoder_type(value_type),
				loc = synthetic_core_source_loc()
			},
		],
		return_type = decoder_type(value_type),
		body = Some(
			VarExpr(
				named_var("decoder", None),
				decoder_type(value_type),
				synthetic_core_source_loc(),
			),
		),
		is_pure = True,
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = UserFunction,
		def_id = 199,
		loc = synthetic_core_source_loc()
	}


---
The expected instance of `function`: the specialization of the generic
`base_def` that binds `parameter` to `target_type`.
---
pure func mono_instance(
	function: CoreFunction,
	base_def: Int,
	parameter: String,
	target_type: String,
) -> CoreFunction:
	{ function |
		origin = Declared(
			MonoInstance(base_def, [(parameter, TypeSubstitution(named_type(target_type)))]),
		)
	}


pure func programs_equal(left: CoreProgram, right: CoreProgram) -> Bool:
	core_program_to_json(left).to_string() == core_program_to_json(right).to_string()


pure func source_program(target_type: String) -> CoreProgram:
	{
		decls = [
			FunctionDecl(identity_function("identity", 10, ["T"], type_parameter("T"))),
			FunctionDecl(
				main_function(
					identity_call(
						"identity",
						named_type(target_type),
						SelectedDirectCall(10),
						Some(10),
					),
				),
			),
		],
		foreign_includes = [],
		source_files = []
	}


pure func expected_program(target_type: String, specialized_def_id: Int) -> CoreProgram:
	{
		decls = [
			FunctionDecl(identity_function("identity", 10, ["T"], type_parameter("T"))),
			FunctionDecl(
				main_function(
					identity_call(
						"identity__mono_${target_type}",
						named_type(target_type),
						SelectedDirectCall(specialized_def_id),
						None,
					),
				),
			),
			FunctionDecl(
				mono_instance(
					identity_function(
						"identity__mono_${target_type}",
						specialized_def_id,
						[],
						named_type(target_type),
					),
					10,
					"T",
					target_type,
				),
			),
		],
		foreign_includes = [],
		source_files = []
	}


func test_specializes_selected_generic_call() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		source_program("Int"),
		100,
	)

	actual.next_def_id == 101 and programs_equal(
		actual.program,
		expected_program("Int", 100),
	)


func test_specializes_generic_function_used_as_returned_callee() -> Bool:
	int_decoder = decoder_type(named_type("Int"))
	factory_call = CallExpr(
		SelectedDirectCall(199),
		VarExpr(
			named_var(
				"codec__field",
				Some(199),
			),
			FunctionType(
				True,
				[named_type("String"), int_decoder],
				int_decoder,
			),
			synthetic_core_source_loc(),
		),
		[VarExpr(
				named_var("name", None),
				named_type("String"),
				synthetic_core_source_loc(),
			), VarExpr(
				named_var("d_int", None),
				int_decoder,
				synthetic_core_source_loc(),
			)],
		int_decoder,
		synthetic_core_source_loc(),
	)
	body = CallExpr(
		UnknownCall,
		factory_call,
		[VarExpr(
				named_var("obj", None),
				named_type("Value"),
				synthetic_core_source_loc(),
			)],
		NamedType(
			"Result",
			[named_type("Int"), named_type("DecodeError")],
		),
		synthetic_core_source_loc(),
	)
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		{
			decls = [FunctionDecl(field_function()), FunctionDecl(main_function(body))],
			foreign_includes = [],
			source_files = []
		},
		100,
	)
	rendered = core_program_to_json(actual.program).to_string()

	(
		actual.next_def_id == 101
		and rendered.contains("codec__field__mono_Int")
		and not rendered.contains("\"kind\":\"selected_direct\",\"def_id\":199")
	)


func test_full_mono_accepts_generic_function_used_as_returned_callee() -> Bool:
	int_decoder = decoder_type(named_type("Int"))
	factory_call = CallExpr(
		SelectedDirectCall(199),
		VarExpr(
			named_var(
				"codec__field",
				Some(199),
			),
			FunctionType(
				True,
				[named_type("String"), int_decoder],
				int_decoder,
			),
			synthetic_core_source_loc(),
		),
		[VarExpr(
				named_var("name", None),
				named_type("String"),
				synthetic_core_source_loc(),
			), VarExpr(
				named_var("d_int", None),
				int_decoder,
				synthetic_core_source_loc(),
			)],
		int_decoder,
		synthetic_core_source_loc(),
	)
	body = CallExpr(
		UnknownCall,
		factory_call,
		[VarExpr(
				named_var("obj", None),
				named_type("Value"),
				synthetic_core_source_loc(),
			)],
		NamedType(
			"Result",
			[named_type("Int"), named_type("DecodeError")],
		),
		synthetic_core_source_loc(),
	)

	match (
		monomorphize_program(
			{
				decls = [FunctionDecl(field_function()), FunctionDecl(main_function(body))],
				foreign_includes = [],
				source_files = []
			},
			100,
		)
	):
		Ok(actual):
			actual.next_def_id == 101
		Err(_):
			False


pure func transitive_source_program(target_type: String) -> CoreProgram:
	{
		decls = [
			FunctionDecl(identity_function("inner", 11, ["U"], type_parameter("U"))),
			FunctionDecl(
				generic_function(
					"outer",
					12,
					["T"],
					type_parameter("T"),
					call_with_argument(
						"inner",
						type_parameter("T"),
						"value",
						SelectedDirectCall(11),
						Some(11),
					),
				),
			),
			FunctionDecl(
				main_function(
					identity_call(
						"outer",
						named_type(target_type),
						SelectedDirectCall(12),
						Some(12),
					),
				),
			),
		],
		foreign_includes = [],
		source_files = []
	}


pure func transitive_expected_program(
	target_type: String,
	outer_def_id: Int,
	inner_def_id: Int,
) -> CoreProgram:
	{
		decls = [
			FunctionDecl(identity_function("inner", 11, ["U"], type_parameter("U"))),
			FunctionDecl(
				generic_function(
					"outer",
					12,
					["T"],
					type_parameter("T"),
					call_with_argument(
						"inner",
						type_parameter("T"),
						"value",
						SelectedDirectCall(11),
						Some(11),
					),
				),
			),
			FunctionDecl(
				main_function(
					identity_call(
						"outer__mono_${target_type}",
						named_type(target_type),
						SelectedDirectCall(outer_def_id),
						None,
					),
				),
			),
			FunctionDecl(
				mono_instance(
					generic_function(
						"outer__mono_${target_type}",
						outer_def_id,
						[],
						named_type(target_type),
						call_with_argument(
							"inner__mono_${target_type}",
							named_type(target_type),
							"value",
							SelectedDirectCall(inner_def_id),
							None,
						),
					),
					12,
					"T",
					target_type,
				),
			),
			FunctionDecl(
				mono_instance(
					identity_function(
						"inner__mono_${target_type}",
						inner_def_id,
						[],
						named_type(target_type),
					),
					11,
					"U",
					target_type,
				),
			),
		],
		foreign_includes = [],
		source_files = []
	}


func test_drains_transitive_worklist() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		transitive_source_program("Int"),
		100,
	)

	actual.next_def_id == 102 and programs_equal(
		actual.program,
		transitive_expected_program("Int", 100, 101),
	)


func test_initial_request_keeps_order_when_transitive_body_rediscovers_it() -> Bool:
	int_type: CoreType = named_type("Int")
	var source: CoreProgram = transitive_source_program("Int")
	var expected: CoreProgram = transitive_expected_program("Int", 100, 101)
	source_body: CoreExpr = SeqExpr(
		identity_call("outer", int_type, SelectedDirectCall(12), Some(12)),
		identity_call("inner", int_type, SelectedDirectCall(11), Some(11)),
	)
	expected_body: CoreExpr = SeqExpr(
		identity_call("outer__mono_Int", int_type, SelectedDirectCall(100), None),
		identity_call("inner__mono_Int", int_type, SelectedDirectCall(101), None),
	)
	source = { source | decls = source.decls.set(2, FunctionDecl(main_function(source_body))) }
	expected = {
		expected | decls = expected.decls.set(2, FunctionDecl(main_function(expected_body)))
	}
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(source, 100)

	actual.next_def_id == 102 and programs_equal(actual.program, expected)


