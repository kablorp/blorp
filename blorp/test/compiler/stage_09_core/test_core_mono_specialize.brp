pure func recursive_collision_program(body_callee_name: String) -> CoreProgram:
	{
		decls = [
			FunctionDecl(
				generic_function(
					"recur",
					13,
					["T"],
					type_parameter("T"),
					call_with_argument(
						body_callee_name,
						type_parameter("T"),
						"value",
						SelectedDirectCall(13),
						Some(13),
					),
				),
			),
			FunctionDecl(
				main_function(
					identity_call(
						"recur",
						named_type("Int"),
						SelectedDirectCall(13),
						Some(13),
					),
				),
			),
		],
		foreign_includes = [],
		source_files = []
	}


pure func generated_function_recurses_into_itself(program: CoreProgram, function_name: String) -> Bool:
	var found: Bool = False

	for decl in program.decls:
		match decl:
			FunctionDecl(function):
				if function.name == function_name:
					match function.body:
						Some(CallExpr(SelectedDirectCall(def_id), _, _, _, _)):
							found = def_id == function.def_id
						_:
							void
			_:
				void

	found


func test_recursive_rewrite_follows_the_selected_id_not_the_spelling() -> Bool:
	-- The recursive call is spelled `other`, but its id is `recur`'s: the id
	-- names the callee exactly, so it is retargeted to the instance itself.
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		recursive_collision_program("other"),
		100,
	)

	(
		actual.next_def_id == 101
		and generated_function_recurses_into_itself(actual.program, "recur__mono_Int")
	)


pure func deep_sequence(depth: Int, final_expr: CoreExpr) -> CoreExpr:
	var result: CoreExpr = final_expr
	var index: Int = 0

	while index < depth:
		result = SeqExpr(
			VoidExpr(VoidType, synthetic_core_source_loc()),
			result,
		)
		index += 1

	result


pure func deep_sequence_program(depth: Int) -> CoreProgram:
	tail: CoreExpr = identity_call("identity", named_type("Int"), SelectedDirectCall(10), Some(10))

	{
		decls = [
			FunctionDecl(identity_function("identity", 10, ["T"], type_parameter("T"))),
			FunctionDecl(main_function(deep_sequence(depth, tail))),
		],
		foreign_includes = [],
		source_files = []
	}


pure func deep_recursive_logical_program(depth: Int) -> CoreProgram:
	bool_type: CoreType = named_type("Bool")
	self_type: CoreType = type_parameter("T")
	var recursive_body: CoreExpr = identity_call(
		"recursive",
		self_type,
		SelectedDirectCall(10),
		Some(10),
	)
	var index: Int = 0

	while index < depth:
		recursive_body = LogicalExpr(
			AndOp,
			recursive_body,
			LiteralExpr(BoolLiteral(True), bool_type, synthetic_core_source_loc()),
			bool_type,
			synthetic_core_source_loc(),
		)
		index += 1

	entry_call: CoreExpr = identity_call("recursive", bool_type, SelectedDirectCall(10), Some(10))

	{
		decls = [
			FunctionDecl(generic_function("recursive", 10, ["T"], self_type, recursive_body)),
			FunctionDecl({ main_function(entry_call) | return_type = bool_type }),
		],
		foreign_includes = [],
		source_files = []
	}


pure func imported_selected_program(
	module_path: String,
	declaration_name: String,
	callee_name: String,
	target_type: String,
) -> CoreProgram:
	module_function: CoreFunction = { identity_function(
		declaration_name,
		40,
		["T"],
		type_parameter("T"),
	) |
		source_module = Some(module_path)
	}

	{
		decls = [
			FunctionDecl(module_function),
			FunctionDecl(
				main_function(
					identity_call(
						callee_name,
						named_type(target_type),
						SelectedDirectCall(40),
						Some(40),
					),
				),
			),
		],
		foreign_includes = [],
		source_files = []
	}


pure func program_function_def_id(program: CoreProgram, name: String) -> Option[Int]:
	var found: Option[Int] = None

	for decl in program.decls:
		match decl:
			FunctionDecl(function):
				if function.name == name:
					found = Some(function.def_id)
			_:
				void

	found


---
`main` calls the function `callee_name` by that function's own `def_id`,
by that function's id in the call kind, and the callee variable carries no id.
---
pure func program_main_calls_instance(program: CoreProgram, callee_name: String) -> Bool:
	var found: Bool = False

	for decl in program.decls:
		match decl:
			FunctionDecl(function):
				if function.name == "main":
					match function.body:
						Some(CallExpr(SelectedDirectCall(target_def_id), VarExpr(variable, _, _), _, _, _)):
							found = (
								variable.name == callee_name
								and variable.def_id.is_none()
								and program_function_def_id(program, callee_name) == Some(target_def_id)
							)
						_:
							void
			_:
				void

	found


func test_specializes_explicit_imported_identity() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		imported_selected_program(
			"list",
			core_module_member_name("list", "identity"),
			"__ufcs_list__identity",
			"Int",
		),
		100,
	)

	(
		actual.next_def_id == 101
		and program_has_function(actual.program, "list__identity__mono_Int")
		and program_main_calls_instance(actual.program, "list__identity__mono_Int")
	)


func test_specializes_explicit_imported_pure_overload_identity() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		imported_selected_program(
			"list",
			core_module_member_name("list", "identity__pure"),
			"__ufcs_list__identity",
			"Int",
		),
		100,
	)

	(
		actual.next_def_id == 101
		and program_has_function(actual.program, "list__identity__pure__mono_Int")
		and program_main_calls_instance(actual.program, "list__identity__pure__mono_Int")
	)


func test_specializes_by_selected_id_whatever_the_alias_spelling() -> Bool:
	-- The call is spelled as another module's alias; the id alone names the
	-- callee, so it is specialized.
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		imported_selected_program(
			"list",
			core_module_member_name("list", "identity"),
			"__ufcs_option__identity",
			"Int",
		),
		100,
	)

	actual.next_def_id == 101 and program_has_function(actual.program, "list__identity__mono_Int")


func test_imported_identity_preserves_double_underscore_module_segment() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		imported_selected_program(
			"pkg/my__module",
			core_module_member_name("pkg/my__module", "identity"),
			"__ufcs_pkg$my__module__identity",
			"Int",
		),
		100,
	)

	(
		actual.next_def_id == 101
		and program_has_function(actual.program, "pkg_my__module__identity__mono_Int")
	)


func test_imported_identity_preserves_double_underscore_source_name() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		imported_selected_program(
			"list",
			core_module_member_name("list", "identity__checked"),
			"__ufcs_list__identity__checked",
			"Int",
		),
		100,
	)

	(
		actual.next_def_id == 101
		and program_has_function(actual.program, "list__identity__checked__mono_Int")
	)


func test_long_sequence_is_stack_bounded() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		deep_sequence_program(2048),
		100,
	)

	actual.next_def_id == 101 and program_has_function(actual.program, "identity__mono_Int")


func test_deep_recursive_logical_tree_is_stack_bounded() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		deep_recursive_logical_program(2048),
		100,
	)

	actual.next_def_id == 101 and program_has_function(actual.program, "recursive__mono_Bool")


tests: TestSuite = {
	description = "Blorp compiler selected-call monomorphization",
	tests = [
		("specializes selected generic call", test_specializes_selected_generic_call),
		(
			"specializes generic function used as returned callee",
			test_specializes_generic_function_used_as_returned_callee,
		),
		(
			"full mono accepts generic function used as returned callee",
			test_full_mono_accepts_generic_function_used_as_returned_callee,
		),
		("drains transitive worklist", test_drains_transitive_worklist),
		(
			"initial request keeps order when transitive body rediscovers it",
			test_initial_request_keeps_order_when_transitive_body_rediscovers_it,
		),
		("recursive specialization is deduplicated", test_recursive_specialization_is_deduplicated),
		(
			"duplicate-heavy requests keep first-seen order",
			test_duplicate_heavy_requests_keep_first_seen_order,
		),
		(
			"request order survives many unique requests with transitive duplicate",
			test_request_order_survives_many_unique_requests_with_transitive_duplicate,
		),
		(
			"instances of one generic have distinct ids and the same base",
			test_instances_of_one_generic_have_distinct_ids_and_the_same_base,
		),
		("repeated request reuses the first instance id", test_repeated_request_reuses_the_first_instance_id),
		("instance key ignores binding order", test_instance_key_ignores_binding_order),
		(
			"instance key is positional in the base parameters",
			test_instance_key_is_positional_in_the_base_parameters,
		),
		(
			"equal hashes with different arguments do not merge",
			test_equal_hashes_with_different_arguments_do_not_merge,
		),
		(
			"instance key requires every parameter bound",
			test_instance_key_requires_every_parameter_bound,
		),
		(
			"instance key distinguishes arguments and base",
			test_instance_key_distinguishes_arguments_and_base,
		),
		("instance key normalizes equal dimensions", test_instance_key_normalizes_equal_dimensions),
		(
			"conflicting selected call is left unchanged",
			test_conflicting_selected_call_is_left_unchanged,
		),
		(
			"missing selected identity is left unchanged",
			test_missing_selected_identity_is_left_unchanged,
		),
		("specializes bodyless generic builtin", test_specializes_bodyless_generic_builtin),
		(
			"concretizes argument types from return evidence",
			test_concretizes_argument_types_from_return_evidence,
		),
		(
			"accepts dimension operation resolved by other evidence",
			test_accepts_dimension_operation_resolved_by_other_evidence,
		),
		("accepts implicit trailing dimension pack", test_accepts_implicit_trailing_dimension_pack),
		("accepts existential return dimension", test_accepts_existential_return_dimension),
		("accepts runtime dimension wildcard", test_accepts_runtime_dimension_wildcard),
		("specializes Range return called as Int", test_specializes_range_return_called_as_int),
		("infers dimension from value literal", test_infers_dimension_from_value_literal),
		(
			"recursive rewrite follows the selected id not the spelling",
			test_recursive_rewrite_follows_the_selected_id_not_the_spelling,
		),
		("specializes explicit imported identity", test_specializes_explicit_imported_identity),
		(
			"specializes explicit imported pure overload identity",
			test_specializes_explicit_imported_pure_overload_identity,
		),
		(
			"specializes by selected id whatever the alias spelling",
			test_specializes_by_selected_id_whatever_the_alias_spelling,
		),
		(
			"imported identity preserves double underscore module segment",
			test_imported_identity_preserves_double_underscore_module_segment,
		),
		(
			"imported identity preserves double underscore source name",
			test_imported_identity_preserves_double_underscore_source_name,
		),
		("long sequence is stack bounded", test_long_sequence_is_stack_bounded),
