func test_accepts_existential_return_dimension() -> Bool:
	parameter_type: CoreType = tensor_type(named_type("Float"), [TensorRuntimeDim("#N")])
	return_type: CoreType = tensor_type(named_type("Float"), [TensorVariadicDim("#Ds")])
	function: CoreFunction = { tensor_function(
		"erase_dims",
		32,
		["#N"],
		[tensor_param("values", parameter_type)],
	) |
		return_type = return_type
	}
	call: CoreExpr = CallExpr(
		SelectedDirectCall(function.def_id),
		VarExpr(
			named_var(function.name, Some(function.def_id)),
			FunctionType(True, [parameter_type], return_type),
			synthetic_core_source_loc(),
		),
		[VarExpr(
				named_var("values", None),
				tensor_type(named_type("Float"), [TensorStaticDim(5)]),
				synthetic_core_source_loc(),
			)],
		return_type,
		synthetic_core_source_loc(),
	)
	source: CoreProgram = {
		decls = [FunctionDecl(function), FunctionDecl(main_function(call))],
		foreign_includes = [],
		source_files = []
	}

	match monomorphize_program(source, 100):
		Ok(actual):
			(
				actual.next_def_id == 101
				and program_has_function(actual.program, "erase_dims__mono_5")
				and program_main_calls_instance(actual.program, "erase_dims__mono_5")
			)
		Err(_):
			False


