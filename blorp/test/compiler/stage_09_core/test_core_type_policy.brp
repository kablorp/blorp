record ManagedTypeCase {
	label: String,
	typ: CoreType,
	expected: Bool
}


private pure func int_type() -> CoreType:
	NamedType("Int", [])


private pure func string_type() -> CoreType:
	NamedType("String", [])


private pure func bool_type() -> CoreType:
	NamedType("Bool", [])


private pure func managed_decl_program() -> CoreProgram:
	{
		decls = [HeapRecordDecl({
				abi_type = None,
				name = "Box",
				type_params = [],
				fields = [],
				loc = synthetic_core_source_loc(),
			}), HeapRecordDecl({
				abi_type = None,
				name = "Box",
				type_params = [],
				fields = [],
				loc = synthetic_core_source_loc(),
			}), UnionDecl({
				abi_type = None,
				name = "Choice",
				type_params = [],
				payload_storage = TypedUnionPayloadStorage,
				variants = [],
				loc = synthetic_core_source_loc(),
			}), UnionDecl({
				abi_type = None,
				name = "Choice",
				type_params = [],
				payload_storage = TypedUnionPayloadStorage,
				variants = [],
				loc = synthetic_core_source_loc(),
			}), ValueRecordDecl({
				abi_type = None,
				origin = LegacyStructOrigin,
				name = "Pair",
				type_params = [],
				fields = [],
				loc = synthetic_core_source_loc(),
			}), EnumDecl({
				abi_type = None,
				name = "Color",
				type_params = [],
				variants = [],
				loc = synthetic_core_source_loc(),
			})],
		foreign_includes = [],
		source_files = []
	}


private pure func legacy_is_managed_type(managed_names: List[String], typ: CoreType) -> Bool:
	match typ:
		NamedType("Option", [payload_type]):
			match payload_type:
				NamedType("Option", _):
					True
				StackResultType(_, _):
					True
				BoxedResultType(_, _):
					True
				_:
					legacy_is_managed_type(managed_names, payload_type)
		NamedType(name, _):
			(
				managed_names.contains(name)
				or is_core_one_shot_stream_type_name(name)
				or is_core_resource_source_type_name(name)
			)
		TypeParameterType(_) | SelfType:
			False
		HeapRecordType(_) | UnionType(_) | BoxedResultType(_, _):
			True
		FunctionType(_, _, _) | TupleType(_) | TensorType(_):
			True
		StackResultType(ok_type, err_type):
			(
				legacy_is_managed_type(managed_names, ok_type)
				or legacy_is_managed_type(managed_names, err_type)
			)
		VoidType | EnumType(_) | ValueRecordType(_) | RangeType:
			False


private pure func managed_type_cases() -> List[ManagedTypeCase]:
	[
		{
			label = "named builtin managed",
			typ = string_type(),
			expected = True
		},
		{
			label = "named scalar unmanaged",
			typ = int_type(),
			expected = False
		},
		{
			label = "named heap declaration",
			typ = NamedType("Box", []),
			expected = True
		},
		{
			label = "named union declaration",
			typ = NamedType("Choice", []),
			expected = True
		},
		{
			label = "named value record declaration",
			typ = NamedType("Pair", []),
			expected = False
		},
		{
			label = "named enum declaration",
			typ = NamedType("Color", []),
			expected = False
		},
		{
			label = "one-shot stream name",
			typ = NamedType("Stream", []),
			expected = True
		},
		{
			label = "fallible stream name",
			typ = NamedType(
				"FallibleStream",
				[int_type(), string_type()],
			),
			expected = True
		},
		{
			label = "resource source name",
			typ = NamedType(
				"stream__ResourceSource",
				[string_type(), string_type()],
			),
			expected = True
		},
		{
			label = "type parameter",
			typ = TypeParameterType("T"),
			expected = False
		},
		{
			label = "self type",
			typ = SelfType,
			expected = False
		},
		{
			label = "heap record type",
			typ = HeapRecordType("AnyRecord"),
			expected = True
		},
		{
			label = "union type",
			typ = UnionType("AnyUnion"),
			expected = True
		},
		{
			label = "boxed result",
			typ = BoxedResultType(int_type(), bool_type()),
			expected = True
		},
		{
			label = "function type",
			typ = FunctionType(True, [int_type()], string_type()),
			expected = True
		},
		{
			label = "tuple type",
			typ = TupleType([int_type()]),
			expected = True
		},
		{
			label = "tensor type",
			typ = TensorType({
				element_type = int_type(),
				dims = [TensorStaticDim(4)],
			}),
			expected = True
		},
		{
			label = "stack result with managed value",
			typ = StackResultType(string_type(), int_type()),
			expected = True
		},
		{
			label = "stack result with managed error",
			typ = StackResultType(
				int_type(),
				NamedType("Box", []),
			),
			expected = True
		},
		{
			label = "stack result unmanaged payloads",
			typ = StackResultType(int_type(), bool_type()),
			expected = False
		},
		{
			label = "void type",
			typ = VoidType,
			expected = False
		},
		{
			label = "enum type",
			typ = EnumType("Color"),
			expected = False
		},
		{
			label = "value record type",
			typ = ValueRecordType("Pair"),
			expected = False
		},
		{
			label = "range type",
			typ = RangeType,
			expected = False
		},
		{
			label = "option of unmanaged scalar",
			typ = NamedType("Option", [int_type()]),
			expected = False
		},
		{
			label = "option of managed name",
			typ = NamedType("Option", [string_type()]),
			expected = True
		},
		{
			label = "nested option of unmanaged scalar",
			typ = NamedType("Option", [NamedType("Option", [int_type()])]),
			expected = True
		},
		{
			label = "option of stack result",
			typ = NamedType("Option", [StackResultType(int_type(), int_type())]),
			expected = True
		},
		{
			label = "option of boxed result",
			typ = NamedType("Option", [BoxedResultType(int_type(), int_type())]),
			expected = True
		},
	]


private pure func legacy_managed_type_names(program: CoreProgram) -> List[String]:
	var names: List[String] = CORE_MANAGED_TYPE_NAMES

	for decl in program.decls:
		match decl:
			HeapRecordDecl(record_decl):
				if not names.contains(record_decl.name):
					names = names.append(record_decl.name)
				else:
					void
			UnionDecl(union_decl):
				if not names.contains(union_decl.name):
					names = names.append(union_decl.name)
				else:
					void
			_:
				void

	names


func test_managed_type_index_matches_legacy_policy() -> Bool:
	program: CoreProgram = managed_decl_program()
	legacy_names: List[String] = legacy_managed_type_names(program)
	index: ManagedTypeIndex = managed_type_index(program)
	var valid: Bool = True

	for test_case in managed_type_cases():
		legacy_result: Bool = legacy_is_managed_type(legacy_names, test_case.typ)
		indexed_result: Bool = is_managed_type(index, test_case.typ)
		case_valid: Bool = (
			legacy_result == test_case.expected
			and indexed_result == test_case.expected
			and legacy_result == indexed_result
		)

		if not case_valid:
			print_error("managed type policy mismatch: " + test_case.label)
			print_error(
				"expected=" + test_case.expected.to_string() + " legacy=" + legacy_result.to_string() + " indexed=" + indexed_result.to_string(),
			)
			valid = False
		else:
			void

	valid


pure func test_optional_function_requires_arc_cleanup() -> Bool:
	function_type: CoreType = FunctionType(True, [int_type()], int_type())
	cleanup_release_policy_for_type(NamedType("Option", [function_type])) == ArcReleasePolicy


private pure func owned_header_program(
	origin: CoreValueRecordOrigin,
	name_type: CoreType,
	name_ownership: CoreInlineFieldOwnership,
) -> CoreProgram:
	{
		decls = [ValueRecordDecl({
				abi_type = None,
				origin = origin,
				name = "Header",
				type_params = [],
				fields = [
					{name = "name", ref = core_field_ref(1), typ = name_type, ownership = name_ownership},
					{name = "code", ref = core_field_ref(2), typ = int_type(), ownership = TrivialInlineField},
				],
				loc = synthetic_core_source_loc(),
			})],
		foreign_includes = [],
		source_files = [],
	}


pure func test_owned_fixed_header_is_inline_owned_not_an_arc_pointer() -> Bool:
	program: CoreProgram = owned_header_program(FixedRecordOrigin, string_type(), OwnedArcInlineField)
	match build_core_inline_ownership_index(program):
		Ok(index):
			named_owned: Bool = match core_ownership_kind(index, managed_type_index(program), NamedType("Header", [])):
				InlineOwnedValue("Header"): True
				_: False
			value_owned: Bool = match core_ownership_kind(index, managed_type_index(program), ValueRecordType("Header")):
				InlineOwnedValue("Header"): True
				_: False
			int_trivial: Bool = match core_ownership_kind(index, managed_type_index(program), int_type()):
				TrivialValue: True
				_: False
			(
				named_owned
				and value_owned
				and int_trivial
				and not is_managed_type(managed_type_index(program), NamedType("Header", []))
			)
		Err(_):
			False


pure func test_legacy_struct_cannot_gain_owned_inline_field() -> Bool:
	match build_core_inline_ownership_index(owned_header_program(LegacyStructOrigin, string_type(), OwnedArcInlineField)):
		Err(LegacyStructOwnedField(record_name, field_name)):
			record_name == "Header" and field_name == "name"
		_:
			False


pure func test_string_field_cannot_be_falsely_tagged_trivial() -> Bool:
	match build_core_inline_ownership_index(owned_header_program(FixedRecordOrigin, string_type(), TrivialInlineField)):
		Err(ManagedInlineFieldMissingOwnership(record_name, field_name)):
			record_name == "Header" and field_name == "name"
		_:
			False


pure func test_list_field_cannot_be_falsely_tagged_trivial() -> Bool:
	match build_core_inline_ownership_index(
		owned_header_program(FixedRecordOrigin, NamedType("List", [int_type()]), TrivialInlineField),
	):
		Err(ManagedInlineFieldMissingOwnership(record_name, field_name)):
			record_name == "Header" and field_name == "name"
		_:
			False


pure func test_literal_string_field_cannot_be_falsely_tagged_trivial() -> Bool:
	match build_core_inline_ownership_index(
		owned_header_program(FixedRecordOrigin, NamedType("LiteralString", []), TrivialInlineField),
	):
		Err(ManagedInlineFieldMissingOwnership(record_name, field_name)):
			record_name == "Header" and field_name == "name"
		_:
			False


pure func test_prefixed_resource_field_cannot_be_falsely_tagged_trivial() -> Bool:
	match build_core_inline_ownership_index(
		owned_header_program(FixedRecordOrigin, NamedType("net_tls__TlsSession", []), TrivialInlineField),
	):
		Err(ManagedInlineFieldMissingOwnership(record_name, field_name)):
			record_name == "Header" and field_name == "name"
		_:
			False


pure func test_existing_releasable_types_classify_as_managed() -> Bool:
	program: CoreProgram = owned_header_program(FixedRecordOrigin, int_type(), TrivialInlineField)
	match build_core_inline_ownership_index(program):
		Ok(index):
			literal_managed: Bool = match core_ownership_kind(index, managed_type_index(program), NamedType("LiteralString", [])):
				ExistingManagedValue: True
				_: False
			handle_managed: Bool = match core_ownership_kind(index, managed_type_index(program), NamedType("net_tls__TlsSession", [])):
				ExistingManagedValue: True
				_: False
			list_managed: Bool = match core_ownership_kind(index, managed_type_index(program), NamedType("List", [int_type()])):
				ExistingManagedValue: True
				_: False
			literal_managed and handle_managed and list_managed
		Err(_):
			False


pure func test_owned_inline_core_is_rejected_before_production_perceus() -> Bool:
	program: CoreProgram = owned_header_program(FixedRecordOrigin, string_type(), OwnedArcInlineField)
	state = core_pass_state(program, 3)
	contracts_rejected: Bool = match run_ownership_contracts_pass(state):
		Err(CorePassMessage(message)):
			message == "owned inline fixed record `Header` is not supported by the current Core ownership/emission pipeline"
		_:
			False
	fused_rejected: Bool = match run_fused_ownership_perceus_pass(state):
		Err(CorePassMessage(message)):
			message == "owned inline fixed record `Header` is not supported by the current Core ownership/emission pipeline"
		_:
			False
	contracts_rejected and fused_rejected


pure func test_owned_inline_core_is_rejected_by_direct_and_prepared_emitters() -> Bool:
	program: CoreProgram = owned_header_program(FixedRecordOrigin, string_type(), OwnedArcInlineField)
	direct_rejected: Bool = match try_emit_core_program_c_artifact_with_profile(program, FunctionProfileOff):
		Err(UnsupportedOwnedInlineCore(_)): True
		_:
			False
	prepared_rejected: Bool = match try_emit_prepared_core_program_c_artifact_with_profile(
		prepared_core_program(program),
		FunctionProfileOff,
	):
		Err(UnsupportedOwnedInlineCore(_)): True
		_:
			False
	direct_rejected and prepared_rejected


pure func test_split_emitter_rejects_owned_and_mistagged_managed_fields() -> Bool:
	owned: CoreProgram = owned_header_program(FixedRecordOrigin, string_type(), OwnedArcInlineField)
	mistagged: CoreProgram = owned_header_program(FixedRecordOrigin, string_type(), TrivialInlineField)
	owned_rejected: Bool = match try_emit_prepared_core_program_c_split_artifact_with_profile(
		prepared_core_program(owned), FunctionProfileOff, 2, "shared.h",
	):
		Err(UnsupportedOwnedInlineCore(_)): True
		_:
			False
	mistagged_rejected: Bool = match try_emit_prepared_core_program_c_split_artifact_with_profile(
		prepared_core_program(mistagged), FunctionProfileOff, 2, "shared.h",
	):
		Err(UnsupportedOwnedInlineCore(_)): True
		_:
			False
	owned_rejected and mistagged_rejected


tests: TestSuite = {
	description = "Blorp compiler Core type policy",
	tests = [
		("optional function fields require ARC cleanup", test_optional_function_requires_arc_cleanup),
		(
			"managed type index matches legacy policy",
			test_managed_type_index_matches_legacy_policy,
		),
		("owned fixed fields classify as inline ownership", test_owned_fixed_header_is_inline_owned_not_an_arc_pointer),
		("legacy structs reject owned inline fields", test_legacy_struct_cannot_gain_owned_inline_field),
		("String inline fields cannot be tagged trivial", test_string_field_cannot_be_falsely_tagged_trivial),
		("List inline fields cannot be tagged trivial", test_list_field_cannot_be_falsely_tagged_trivial),
		("LiteralString inline fields cannot be tagged trivial", test_literal_string_field_cannot_be_falsely_tagged_trivial),
		("prefixed resource fields cannot be tagged trivial", test_prefixed_resource_field_cannot_be_falsely_tagged_trivial),
		("existing releasable types classify as managed", test_existing_releasable_types_classify_as_managed),
		("owned inline Core is rejected before production Perceus", test_owned_inline_core_is_rejected_before_production_perceus),
		("owned inline Core is rejected by direct and prepared emitters", test_owned_inline_core_is_rejected_by_direct_and_prepared_emitters),
		("split emitter rejects owned and mistagged managed fields", test_split_emitter_rejects_owned_and_mistagged_managed_fields),
	]
}
