import:
	../../../src/compiler/stage_02_lex/name_table: synthesized_name_id
	../../../src/compiler/stage_04_modules/loaded_module:
		ModuleOrigin(StdlibModule, UserModule),
		resolved_module_identity_from_resolver,
	../../../src/compiler/stage_04_modules/module_table: ModuleTable, singleton_module_table
	../../../src/compiler/stage_09_core/function_origin_fixture: fixture_source_module
	../../../src/compiler/stage_09_core/ir:
		CoreDecl(FunctionDecl, ImplDecl, TraitDecl),
		CoreEntrypointKind(ProgramWrapperEntrypoint, UserMainEntrypoint),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreDeclaredOrigin(Entrypoint, EtaExpansion, HoistedLambda, HoistedTask, ImplMethod, MonoInstance, PureVariant, SourceFunction),
		CoreFunctionOrigin(Declared, Synthesized),
		CoreModuleOrigin(NoSourceModule, SourceModule),
		CoreMonoSubstitutionValue(TypeSubstitution),
		CoreProgram,
		CoreSynthesisKind(TensorSynthesis),
		CoreType(NamedType),
		synthetic_core_source_loc,
	../../../src/compiler/stage_09_core/origin_name_agreement:
		ModuleCheckScope(CheckAgainstModuleTable, CheckWithoutModuleTable),
		OriginNameAgreement,
		origin_name_agreement,
		origin_name_agreement_summary,
	test: TestSuite


SOURCE_ORIGIN: CoreDeclaredOrigin = SourceFunction(synthesized_name_id("_"))

INT_TYPE: CoreType = NamedType("Int", [])


pure func module_for(source_module: Option[String]) -> CoreModuleOrigin:
	match source_module:
		Some(path):
			fixture_source_module(path, UserModule)
		None:
			NoSourceModule


pure func source_origin_in(source_module: Option[String]) -> CoreFunctionOrigin:
	Declared(SourceFunction(synthesized_name_id("_")))


pure func function_in_module(
	name: String,
	source_module: Option[String],
	origin: CoreFunctionOrigin,
) -> CoreFunction:
	{
		name = name,
		source_module = source_module,
		module = module_for(source_module),
		type_params = [],
		params = [],
		return_type = INT_TYPE,
		body = None,
		is_pure = False,
		function_kind = UserFunction,
		origin = origin,
		def_id = 1,
		loc = synthetic_core_source_loc()
	}


pure func function_with(name: String, declared: CoreDeclaredOrigin) -> CoreFunction:
	function_in_module(name, None, Declared(declared))


pure func synthesized_function_with(name: String, origin: CoreFunctionOrigin) -> CoreFunction:
	function_in_module(name, None, origin)


pure func program_of(decls: List[CoreDecl]) -> CoreProgram:
	{
		decls = decls,
		foreign_includes = [],
		source_files = []
	}


pure func agreement_for(functions: List[CoreFunction]) -> OriginNameAgreement:
	origin_name_agreement(fn_program(functions), CheckWithoutModuleTable)


pure func string_contains_all(text: String, needles: List[String]) -> Bool:
	needles.all(pure func(needle: String) -> Bool: text.contains(needle))


pure func mono_origin() -> CoreDeclaredOrigin:
	MonoInstance(5, [("T", TypeSubstitution(INT_TYPE))])


pure func test_functions_whose_names_and_origins_agree_report_nothing() -> Bool:
	agreement = agreement_for([
		function_with("list__map", SOURCE_ORIGIN),
		function_with("list__map__mono_Int", mono_origin()),
		function_with("list__map__pure", PureVariant(5)),
		function_with("_blorp_clambda_3", HoistedLambda(9, 3)),
		function_with("_blorp_task_0", HoistedTask(9, 0)),
		function_with("_blorp_eta_2", EtaExpansion(5)),
		function_with("$blorp$program", Entrypoint(ProgramWrapperEntrypoint)),
		function_with("$blorp$user_main_12", Entrypoint(UserMainEntrypoint)),
	])

	agreement.checked == 8 and agreement.violations.is_empty()


pure func test_mono_named_function_with_source_origin_is_reported() -> Bool:
	agreement = agreement_for([function_with("list__map__mono_Int", SOURCE_ORIGIN)])

	match agreement.violations:
		[message]:
			string_contains_all(
				message,
				["list__map__mono_Int", "a mono instance", "origin is SourceFunction"],
			)
		_:
			False


pure func test_plain_named_function_with_mono_origin_is_reported() -> Bool:
	agreement = agreement_for([function_with("list__map", mono_origin())])

	match agreement.violations:
		[message]:
			string_contains_all(message, ["a plain source or impl function", "MonoInstance"])
		_:
			False


pure func test_pure_suffix_without_pure_variant_origin_is_reported() -> Bool:
	agreement = agreement_for([function_with("list__map__pure", SOURCE_ORIGIN)])

	agreement.violations.length() == 1


pure func test_hoisted_lambda_ordinal_must_match_the_name() -> Bool:
	agreement = agreement_for([
		function_with("_blorp_clambda_4", HoistedLambda(9, 3)),
		function_with("_blorp_task_1", HoistedTask(9, 1)),
	])

	match agreement.violations:
		[message]:
			string_contains_all(message, ["_blorp_clambda_4", "a hoisted lambda"])
		_:
			False


pure func test_entrypoint_names_require_matching_entrypoint_kind() -> Bool:
	agreement = agreement_for([
		function_with("$blorp$program", Entrypoint(UserMainEntrypoint)),
		function_with("$blorp$user_main_3", Entrypoint(ProgramWrapperEntrypoint)),
	])

	agreement.violations.length() == 2


pure func test_ufcs_named_function_is_always_reported() -> Bool:
	agreement = agreement_for([function_with("__ufcs_list__map", SOURCE_ORIGIN)])

	match agreement.violations:
		[message]:
			message.contains("a UFCS wrapper")
		_:
			False


pure func test_synthesized_function_is_judged_by_its_declared_origin() -> Bool:
	agreement = agreement_for([
		synthesized_function_with("list__map__mono_Int", Synthesized(TensorSynthesis, mono_origin())),
		synthesized_function_with("list__length", Synthesized(TensorSynthesis, SOURCE_ORIGIN)),
		synthesized_function_with("list__map", Synthesized(TensorSynthesis, mono_origin())),
	])

	agreement.violations.length() == 1 and agreement.checked == 3


pure func test_member_named_mono_something_is_not_a_mono_instance() -> Bool:
	-- `src_compiler_synth_name__mono_name_base` is member `mono_name_base` of
	-- module `src/compiler/synth_name`: the marker sits inside the module prefix.
	agreement = agreement_for([
		function_in_module(
			"src_compiler_synth_name__mono_name_base",
			Some("src/compiler/synth_name"),
			source_origin_in(Some("src/compiler/synth_name")),
		),
		function_in_module(
			"src_compiler_synth_name__mono_name_base__mono_Int",
			Some("src/compiler/synth_name"),
			Declared(mono_origin()),
		),
	])

	agreement.violations.is_empty()


pure func impl_program(method_origin: CoreFunctionOrigin) -> CoreProgram:
	program_of([
		ImplDecl({
			trait_name = "Display",
			for_type = INT_TYPE,
			type_params = [],
			methods = [function_in_module("show", None, method_origin)],
			loc = synthetic_core_source_loc()
		}),
	])


pure func test_impl_methods_must_carry_an_impl_method_origin() -> Bool:
	good = origin_name_agreement(
		impl_program(Declared(ImplMethod(synthesized_name_id("_"), synthesized_name_id("_")))),
		CheckWithoutModuleTable,
	)
	wrapped = origin_name_agreement(
		impl_program(
			Synthesized(TensorSynthesis, ImplMethod(synthesized_name_id("_"), synthesized_name_id("_"))),
		),
		CheckWithoutModuleTable,
	)
	bad = origin_name_agreement(impl_program(Declared(SOURCE_ORIGIN)), CheckWithoutModuleTable)

	good.violations.is_empty() and wrapped.violations.is_empty() and bad.violations.length() == 1


pure func test_trait_named_functions_are_projected_impl_methods() -> Bool:
	trait_decl: CoreDecl = TraitDecl({
		name = "Display",
		type_params = [],
		supertraits = [],
		methods = [],
		loc = synthetic_core_source_loc()
	})
	projected: CoreDecl = FunctionDecl(
		function_with(
			"Display_show_Int",
			ImplMethod(synthesized_name_id("_"), synthesized_name_id("_")),
		),
	)
	misattributed: CoreDecl = FunctionDecl(function_with("Display_show_Bool", SOURCE_ORIGIN))

	projected_agreement = origin_name_agreement(program_of([trait_decl, projected]), CheckWithoutModuleTable)
	misattributed_agreement = origin_name_agreement(program_of([trait_decl, misattributed]), CheckWithoutModuleTable)

	projected_agreement.violations.is_empty() and misattributed_agreement.violations.length() == 1


pure func test_source_module_without_a_path_is_the_target_module() -> Bool:
	target_module: CoreFunction = function_in_module(
		"main",
		None,
		Declared(SourceFunction(synthesized_name_id("_"))),
	)
	target_module_function: CoreFunction = { target_module | module = fixture_source_module("main", UserModule) }

	agreement_for([target_module_function]).violations.is_empty()


pure func test_path_without_a_source_module_is_reported() -> Bool:
	function_info: CoreFunction = { function_in_module("list__map", Some("list"), Declared(SourceFunction(synthesized_name_id("_")))) |
		module = NoSourceModule
	}

	match agreement_for([function_info]).violations:
		[message]:
			message.contains("module origin NoSourceModule")
		_:
			False


pure func module_table_of(path: String, origin: ModuleOrigin) -> ModuleTable:
	(table, _) = singleton_module_table(resolved_module_identity_from_resolver(path, origin))
	table


pure func list_function_in(path: String, module: CoreModuleOrigin) -> CoreFunction:
	{ function_in_module("list__map", Some(path), Declared(SOURCE_ORIGIN)) | module = module }


pure func test_module_table_accepts_a_function_whose_path_and_origin_match() -> Bool:
	table: ModuleTable = module_table_of("list", StdlibModule)
	matching: CoreFunction = list_function_in("list", fixture_source_module("list", StdlibModule))

	origin_name_agreement(fn_program([matching]), CheckAgainstModuleTable(table)).violations.is_empty()


pure func test_module_table_reports_a_path_the_module_id_does_not_name() -> Bool:
	table: ModuleTable = module_table_of("list", StdlibModule)
	wrong_path: CoreFunction = list_function_in("elsewhere", fixture_source_module("list", StdlibModule))

	match origin_name_agreement(fn_program([wrong_path]), CheckAgainstModuleTable(table)).violations:
		[message]:
			message.contains("another path in the table")
		_:
			False


pure func test_module_table_reports_an_origin_the_table_does_not_give() -> Bool:
	table: ModuleTable = module_table_of("list", StdlibModule)
	wrong_origin: CoreFunction = list_function_in("list", fixture_source_module("list", UserModule))

	match origin_name_agreement(fn_program([wrong_origin]), CheckAgainstModuleTable(table)).violations:
		[message]:
			message.contains("origin the table does not give")
		_:
			False


pure func test_late_passes_without_a_table_still_apply_the_path_rule_but_skip_table_rules() -> Bool:
	no_module_with_path: CoreFunction = list_function_in("list", NoSourceModule)
	path_the_id_does_not_name: CoreFunction = list_function_in(
		"elsewhere",
		fixture_source_module("list", StdlibModule),
	)

	path_rule_fires: Bool = origin_name_agreement(
		fn_program([no_module_with_path]),
		CheckWithoutModuleTable,
	).violations.length() == 1
	table_rule_skipped: Bool = origin_name_agreement(
		fn_program([path_the_id_does_not_name]),
		CheckWithoutModuleTable,
	).violations.is_empty()

	path_rule_fires and table_rule_skipped


pure func fn_program(functions: List[CoreFunction]) -> CoreProgram:
	program_of(functions.map(pure func(function: CoreFunction) -> CoreDecl: FunctionDecl(function)))


pure func test_summary_reports_totals_and_counts_per_origin_case() -> Bool:
	agreement = agreement_for([
		function_with("list__map", SOURCE_ORIGIN),
		function_with("list__filter", SOURCE_ORIGIN),
		function_with("list__map__mono_Int", mono_origin()),
		function_with("list__bad__mono_Int", SOURCE_ORIGIN),
	])

	origin_name_agreement_summary(agreement).starts_with(
		"4 functions, 1 disagree; SourceFunction=3 ImplMethod=0 PureVariant=0 MonoInstance=1",
	)


tests: TestSuite = {
	description = "Compiler Core origin and name agreement",
	tests = [
		(
			"functions whose names and origins agree report nothing",
			test_functions_whose_names_and_origins_agree_report_nothing,
		),
		(
			"mono named function with source origin is reported",
			test_mono_named_function_with_source_origin_is_reported,
		),
		(
			"plain named function with mono origin is reported",
			test_plain_named_function_with_mono_origin_is_reported,
		),
		(
			"pure suffix without pure variant origin is reported",
			test_pure_suffix_without_pure_variant_origin_is_reported,
		),
		(
			"hoisted lambda ordinal must match the name",
			test_hoisted_lambda_ordinal_must_match_the_name,
		),
		(
			"entrypoint names require matching entrypoint kind",
			test_entrypoint_names_require_matching_entrypoint_kind,
		),
		("ufcs named function is always reported", test_ufcs_named_function_is_always_reported),
		(
			"synthesized function is judged by its declared origin",
			test_synthesized_function_is_judged_by_its_declared_origin,
		),
		(
			"member named mono something is not a mono instance",
			test_member_named_mono_something_is_not_a_mono_instance,
		),
		(
			"impl methods must carry an impl method origin",
			test_impl_methods_must_carry_an_impl_method_origin,
		),
		(
			"trait named functions are projected impl methods",
			test_trait_named_functions_are_projected_impl_methods,
		),
		(
			"source module without a path is the target module",
			test_source_module_without_a_path_is_the_target_module,
		),
		("path without a source module is reported", test_path_without_a_source_module_is_reported),
		(
			"module table accepts a function whose path and origin match",
			test_module_table_accepts_a_function_whose_path_and_origin_match,
		),
		(
			"module table reports a path the module id does not name",
			test_module_table_reports_a_path_the_module_id_does_not_name,
		),
		(
			"module table reports an origin the table does not give",
			test_module_table_reports_an_origin_the_table_does_not_give,
		),
		(
			"late passes without a table still apply the path rule but skip table rules",
			test_late_passes_without_a_table_still_apply_the_path_rule_but_skip_table_rules,
		),
		(
			"summary reports totals and counts per origin case",
			test_summary_reports_totals_and_counts_per_origin_case,
		),
	]
}
