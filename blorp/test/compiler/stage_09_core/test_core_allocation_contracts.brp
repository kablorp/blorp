private pure func union_construct(has_payload: Bool) -> CoreExpr:
	args: List[CoreBoxedStorageValue] = if has_payload:
		[
			{
				kind = PrimBox,
				value = int_literal(1),
				needs_release = False,
				transfers_ownership = False
			},
		]
	else:
		[]

	constructor_name: String = if has_payload:
		"Some"
	else:
		"None"

	constructor_c_name: String = if has_payload:
		"maybe_some"
	else:
		"maybe_none"

	UnionConstructExpr(
		{
			type_name = "MaybeInt",
			constructor_name = constructor_name,
			constructor_c_name = constructor_c_name,
			representation = GenericUnionRepresentation,
			payload_storage = TypedUnionPayloadStorage,
			uses_release_mask = False,
			release_mask = 0,
			args = args
		},
		UnionType("MaybeInt"),
		SyntheticSourceLoc,
	)


private pure func test_generic_union_construction_distinguishes_nullary_payload() -> Bool:
	nullary: CoreAllocationContract = core_expr_allocation_contract(union_construct(False))
	payload: CoreAllocationContract = core_expr_allocation_contract(union_construct(True))

	(
		allocation_facts_are_free(nullary.facts)
		and payload.facts.may_allocate == [ManagedObjectAllocation]
		and payload.facts.unknown.is_empty()
	)


private pure func stack_union_construct(kind: CoreBoxKind) -> CoreExpr:
	UnionConstructExpr(
		{
			type_name = "MaybeValue",
			constructor_name = "Some",
			constructor_c_name = "maybe_value_some",
			representation = StackOptionRepresentation({
				option_type = "blorp_MaybeValue",
				tag = 1,
				none_value = "0",
			}),
			payload_storage = TypedUnionPayloadStorage,
			uses_release_mask = False,
			release_mask = 0,
			args = [
				{
					kind = kind,
					value = int_literal(1),
					needs_release = False,
					transfers_ownership = False
				},
			]
		},
		UnionType("MaybeValue"),
		SyntheticSourceLoc,
	)


private pure func test_stack_union_elides_implicit_boxes() -> Bool:
	primitive: CoreAllocationContract = core_expr_allocation_contract(
		stack_union_construct(PrimBox),
	)
	wide: CoreAllocationContract = core_expr_allocation_contract(stack_union_construct(Int128Box))
	structure: CoreAllocationContract = core_expr_allocation_contract(
		stack_union_construct(StructBox("Point")),
	)

	(
		allocation_facts_are_free(primitive.facts)
		and allocation_facts_are_free(wide.facts)
		and allocation_facts_are_free(structure.facts)
	)


private pure func generic_struct_union(erased: Bool) -> CoreExpr:
	payload_storage: CoreUnionPayloadStorage = if erased:
		ErasedUnionPayloadStorage
	else:
		TypedUnionPayloadStorage

	UnionConstructExpr(
		{
			type_name = "WrappedPoint",
			constructor_name = "WrappedPoint",
			constructor_c_name = "wrapped_point",
			representation = GenericUnionRepresentation,
			payload_storage = payload_storage,
			uses_release_mask = False,
			release_mask = 0,
			args = [
				{
					kind = StructBox("Point"),
					value = int_literal(1),
					needs_release = False,
					transfers_ownership = False
				},
			]
		},
		UnionType("WrappedPoint"),
		SyntheticSourceLoc,
	)


private pure func nullable_struct_union() -> CoreExpr:
	UnionConstructExpr(
		{
			type_name = "MaybePoint",
			constructor_name = "Some",
			constructor_c_name = "maybe_point_some",
			representation = NullableOptionRepresentation,
			payload_storage = TypedUnionPayloadStorage,
			uses_release_mask = False,
			release_mask = 0,
			args = [
				{
					kind = StructBox("Point"),
					value = int_literal(1),
					needs_release = False,
					transfers_ownership = False
				},
			]
		},
		UnionType("MaybePoint"),
		SyntheticSourceLoc,
	)


private pure func test_union_box_facts_follow_payload_emission() -> Bool:
	typed: CoreAllocationContract = core_expr_allocation_contract(generic_struct_union(False))
	erased: CoreAllocationContract = core_expr_allocation_contract(generic_struct_union(True))
	nullable: CoreAllocationContract = core_expr_allocation_contract(nullable_struct_union())

	(
		typed.facts.may_allocate == [ManagedObjectAllocation]
		and erased.facts.may_allocate == [ManagedObjectAllocation, HeapBoxAllocation]
		and allocation_facts_are_free(nullable.facts)
	)


private pure func tuple_construct(struct_element: Bool) -> CoreExpr:
	elements: List[CoreTupleElement] = if struct_element:
		[TupleStructElement(int_literal(1), "Point")]
	else:
		[TuplePrimElement(int_literal(1))]

	TupleConstructExpr(
		{
			elements = elements,
			release_mask = 0,
			retain_mask = 0
		},
		TupleType([NamedType("Int", [])]),
		SyntheticSourceLoc,
	)


private pure func test_tuple_construction_preserves_storage_and_implicit_box_facts() -> Bool:
	primitive: CoreAllocationContract = core_expr_allocation_contract(tuple_construct(False))
	structure: CoreAllocationContract = core_expr_allocation_contract(tuple_construct(True))
	stack_result: CoreAllocationContract = core_expr_allocation_contract(
		TupleConstructExpr(
			{
				elements = [TupleStackResultElement(int_literal(1))],
				release_mask = 0,
				retain_mask = 0
			},
			TupleType([NamedType("Result", [])]),
			SyntheticSourceLoc,
		),
	)

	(
		primitive.facts.may_allocate == [TupleStorageAllocation]
		and primitive.facts.unknown.is_empty()
		and structure.facts.may_allocate == [TupleStorageAllocation, HeapBoxAllocation]
		and structure.facts.unknown.is_empty()
		and stack_result.facts.may_allocate == [TupleStorageAllocation, HeapBoxAllocation]
		and stack_result.facts.unknown.is_empty()
	)


private pure func drop_expr(value_type: CoreType, policy: CoreReleasePolicy) -> CoreExpr:
	DropExpr(
		{
			name = "value",
			id = 4,
			def_id = None
		},
		value_type,
		policy,
		int_literal(0),
		NamedType(
			"Int",
			[],
		),
		SyntheticSourceLoc,
	)


private pure func test_drop_policies_publish_exact_cleanup_dependencies() -> Bool:
	no_release: CoreAllocationContract = core_expr_allocation_contract(
		drop_expr(
			NamedType("Int", []),
			NoReleasePolicy,
		),
	)
	arc_release_only: CoreAllocationContract = core_expr_allocation_contract(
		drop_expr(
			NamedType("String", []),
			ArcReleaseOnlyPolicy,
		),
	)
	arc: CoreAllocationContract = core_expr_allocation_contract(
		drop_expr(
			NamedType("String", []),
			ArcReleasePolicy,
		),
	)
	stack: CoreAllocationContract = core_expr_allocation_contract(
		drop_expr(
			NamedType("Result", []),
			StackResultReleasePolicy,
		),
	)

	match (arc.dependencies, stack.dependencies):
		([CleanupAllocationDependency(NamedType("String", []), ArcReleasePolicy)], [CleanupAllocationDependency(NamedType("Result", []), StackResultReleasePolicy)]):
			(
				allocation_facts_are_free(no_release.facts)
				and no_release.dependencies.is_empty()
				and allocation_facts_are_free(arc_release_only.facts)
				and arc_release_only.dependencies.is_empty()
				and allocation_facts_are_free(arc.facts)
				and allocation_facts_are_free(stack.facts)
			)
		_:
			False


