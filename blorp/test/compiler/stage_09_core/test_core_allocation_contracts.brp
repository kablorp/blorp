	ListGetExpr(
		{
			layout = layout,
			list = int_literal(0),
			index = int_literal(0),
			bounds = CheckedListAccess
		},
		NamedType(
			"Int",
			[],
		),
		SyntheticSourceLoc,
	)


private pure func test_list_get_layouts_are_locally_allocation_free() -> Bool:
	(
		allocation_facts_are_free(core_expr_allocation_contract(list_get(PointerListStorage)).facts)
		and allocation_facts_are_free(
			core_expr_allocation_contract(list_get(InlineListStorage(8))).facts,
		)
		and allocation_facts_are_free(
			core_expr_allocation_contract(list_get(InlineStructListStorage("Point"))).facts,
		)
	)


-- blorp_cooperative_checkpoint's fast path only decrements a thread-local
-- budget (runtime.c:26007-26013); its slow path resets the budget, polls
-- cancellation, and calls blorp_yield_now, which is a coroutine stack switch
-- (runtime.c:25947-25971, runtime.c:25988-26001) -- no heap allocation on
-- either path, so the checkpoint the fairness pass inserts at loop
-- back-edges must not make an otherwise allocation-free loop unknown.
private pure func test_scheduler_checkpoint_is_allocation_free() -> Bool:
	contract: CoreAllocationContract = core_expr_allocation_contract(
		CooperativeCheckpointExpr(
			NamedType("Void", []),
			SyntheticSourceLoc,
		),
	)

	allocation_facts_are_free(contract.facts) and contract.dependencies.is_empty()


private pure func loop_binder() -> CoreLoopBinder:
	{
		variable = {
			name = "item",
			id = 12,
			def_id = None
		},
		typ = NamedType("Int", []),
		range_direction = RangeMayRunBackward
	}


private pure func test_loop_contracts_publish_hidden_runtime_and_cleanup() -> Bool:
	iterable: CoreExpr = LiteralExpr(IntLiteral(0), UnionType("Node"), SyntheticSourceLoc)
	list_loop: CoreAllocationContract = core_expr_allocation_contract(
		ForListExpr(
			{
				binder = loop_binder(),
				layout = PointerListStorage,
				iterable = iterable,
				iterable_release_policy = ArcReleasePolicy,
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			SyntheticSourceLoc,
		),
	)
	resource_loop: CoreAllocationContract = core_expr_allocation_contract(
		ForResourceSourceExpr(
			{
				binder = loop_binder(),
				iterable = iterable,
				iterable_release_policy = NoReleasePolicy,
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			SyntheticSourceLoc,
		),
	)
	raw_tensor: CoreAllocationContract = core_expr_allocation_contract(
		ForTensorExpr(
			{
				binder = loop_binder(),
				element_storage = TensorForRawScalarElement(TensorInt64Elements),
				iterable = iterable,
				iterable_release_policy = NoReleasePolicy,
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			SyntheticSourceLoc,
		),
	)
	row_tensor: CoreAllocationContract = core_expr_allocation_contract(
		ForTensorExpr(
			{
				binder = loop_binder(),
				element_storage = TensorForRowSliceElement({
					row_size = "4",
					result_first_dim = "4",
					runtime_derived = False,
				}),
				iterable = iterable,
				iterable_release_policy = NoReleasePolicy,
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			SyntheticSourceLoc,
		),
	)

	match (list_loop.dependencies, resource_loop.dependencies):
		([CleanupAllocationDependency(UnionType("Node"), ArcReleasePolicy)], [RuntimeAllocationDependency]):
			(
				resource_loop.facts.unknown == [RuntimeCallbackBoundary]
				and allocation_facts_are_free(raw_tensor.facts)
				and row_tensor.facts.may_allocate == [ManagedObjectAllocation]
			)
		_:
			False


private pure func test_accessor_match_publishes_scrutinee_cleanup() -> Bool:
	scrutinee: CoreExpr = LiteralExpr(IntLiteral(0), UnionType("Node"), SyntheticSourceLoc)
	contract: CoreAllocationContract = core_expr_allocation_contract(
		AccessorLiteralMatchExpr(
			scrutinee,
			ArcReleasePolicy,
			{
				accessor = RootAccessor,
				scrutinee_type = UnionType("Node"),
				cases = [],
				fallback = LiteralMatchFallbackFail,
				result_type = NamedType("Int", []),
				loc = SyntheticSourceLoc
			},
			NamedType(
				"Int",
				[],
			),
			SyntheticSourceLoc,
		),
	)

	match contract.dependencies:
		[CleanupAllocationDependency(UnionType("Node"), ArcReleasePolicy)]:
			True
		_:
			False


private pure func struct_boxed_value() -> CoreBoxedStorageValue:
	{
		kind = StructBox("Point"),
		value = int_literal(1),
		needs_release = False,
		transfers_ownership = False
	}


private pure func test_container_construction_preserves_payload_risks() -> Bool:
	list_contract: CoreAllocationContract = core_expr_allocation_contract(
		ListConstructExpr(
			{
				layout = PointerListStorage,
				elements = [struct_boxed_value()],
				elem_needs_release = False
			},
			NamedType(
				"List",
				[],
			),
			SyntheticSourceLoc,
		),
	)
	tensor_contract: CoreAllocationContract = core_expr_allocation_contract(
		TensorBoxedLiteralExpr(
			{
				shape = TensorVectorLength(1),
				elements = [struct_boxed_value()],
				elem_needs_release = False
			},
			NamedType(
				"Tensor",
				[],
			),
			SyntheticSourceLoc,
		),
	)
	dict_contract: CoreAllocationContract = core_expr_allocation_contract(
		DictConstructExpr(
			{
				constructor = CustomHashContainerConstructor("hash_point", "equal_point", False),
				entries = [
					{
						key = struct_boxed_value(),
						value = struct_boxed_value()
					},
				],
				value_needs_release = False
			},
			NamedType(
				"Dict",
				[],
			),
			SyntheticSourceLoc,
		),
	)

	match dict_contract.dependencies:
		[UnknownCallAllocationDependency]:
			(
				list_contract.facts.may_allocate == [RawBufferAllocation, HeapBoxAllocation]
				and tensor_contract.facts.may_allocate == [RawBufferAllocation, HeapBoxAllocation]
				and dict_contract.facts.may_allocate == [ManagedObjectAllocation, HeapBoxAllocation]
				-- A custom hash/equals pair is a named, unresolved call target
				-- (the user's hash function), not an opaque runtime boundary.
				and dict_contract.facts.unknown == [UnknownCallTarget]
			)
		_:
			False


private pure func test_list_to_string_preserves_known_and_unknown_risks() -> Bool:
	contract: CoreAllocationContract = core_call_allocation_contract(
		ListToStringCall("element_to_string"),
	)

	match contract.dependencies:
		[RuntimeAllocationDependency]:
			(
				contract.facts.may_allocate == [RawBufferAllocation]
				and contract.facts.unknown == [RuntimeCallbackBoundary]
			)
		_:
			False


private pure func test_channel_and_select_publish_received_value_cleanup() -> Bool:
	channel: CoreAllocationContract = core_expr_allocation_contract(
		ForChannelExpr(
			{
				binder = {
					variable = {
						name = "value",
						id = 30,
						def_id = None
					},
					typ = UnionType("Node"),
					range_direction = RangeMayRunBackward
				},
				iterable = int_literal(0),
				body = int_literal(0)
			},
			NamedType(
				"Void",
				[],
			),
			SyntheticSourceLoc,
		),
	)
	select_contract: CoreAllocationContract = core_expr_allocation_contract(
		SelectExpr(
			[
				{
					kind = SelectRecvArm({
						binder = {
							name = "value",
							id = 31,
							def_id = None
						},
						elem_type = UnionType("Node"),
						channel = int_literal(0),
					}),
					body = int_literal(0),
					loc = SyntheticSourceLoc
				},
			],
			NamedType(
				"Void",
				[],
			),
			SyntheticSourceLoc,
		),
	)

	match (channel.dependencies, select_contract.dependencies):
		([RuntimeAllocationDependency, CleanupAllocationDependency(UnionType("Node"), ArcReleasePolicy)], [RuntimeAllocationDependency, CleanupAllocationDependency(UnionType("Node"), ArcReleasePolicy)]):
			True
		_:
			False


private pure func test_capture_and_reuse_contracts_preserve_hidden_causes() -> Bool:
	captured: CoreAllocationContract = core_expr_allocation_contract(
		ClosureCreateExpr(
			{
				function_name = "capture_point",
				def_id = 101,
				c_name = "capture_point_101",
				static_name = "capture_point_static_101",
				captures = [
					{
						name = "point",
						id = 0,
						typ = ValueRecordType("Point")
					},
				]
			},
			NamedType(
				"Closure",
				[],
			),
			SyntheticSourceLoc,
		),
	)
	record_reuse: CoreAllocationContract = core_expr_allocation_contract(
		RecordReuseExpr(
			int_literal(0),
			[],
			HeapRecordType("Node"),
			SyntheticSourceLoc,
		),
	)
	union_reuse: CoreAllocationContract = core_expr_allocation_contract(
		UnionReuseConstructExpr(
			{
				source = int_literal(0),
				type_name = "Node",
				constructor_name = "Next",
				constructor_c_name = "node_next",
				reuse_constructor_c_name = "node_next_reuse",
				representation = GenericUnionRepresentation,
				payload_storage = ErasedUnionPayloadStorage,
				uses_release_mask = False,
				release_mask = 0,
				args = [struct_boxed_value()]
			},
			UnionType("Node"),
			SyntheticSourceLoc,
		),
	)

	match (record_reuse.dependencies, union_reuse.dependencies):
		([CleanupAllocationDependency(HeapRecordType("Node"), ArcReleasePolicy)], [CleanupAllocationDependency(UnionType("Node"), ArcReleasePolicy)]):
			(
				captured.facts.may_allocate == [ClosureEnvironmentAllocation, HeapBoxAllocation]
				and union_reuse.facts.may_allocate == [CowFallbackAllocation, HeapBoxAllocation]
			)
		_:
			False


private pure func test_closed_intrinsic_catalog_admits_only_audited_names() -> Bool:
	var valid: Bool = True
	audited_names: List[String] = [
		"bit_and",
		"bit_or",
		"bit_xor",
		"bit_not",
		"shift_left",
		"shift_right",
		"list_len",
		"list_capacity",
		"string_len",
		"bytes_len",
		"dict_len",
		"set_len",
		"set_capacity",
		"set_mask",
		"dict_capacity",
		"dict_mask",
		"dict_grow_at",
		"dict_order_len",
		"slice_start",
		"slice_len",
		"memory_is_unique_heap",
		"memory_is_unique_stack",
		"memory_refcount_heap",
		"memory_refcount_stack",
		"memory_size_of_heap",
		"memory_size_of_stack",
		"memory_same_object_heap",
		"memory_same_object_stack",
		"tensor_len",
		"tensor_capacity",
		"fixed_value",
		"fixed_scale",
		"fixed_precision",
		"fixed_pow10",
	]

	for name in audited_names:
		contract: CoreAllocationContract = core_call_allocation_contract(IntrinsicCall(name))

		if not allocation_facts_are_free(contract.facts) or not contract.dependencies.is_empty():
			valid = False
		else:
			void

	near_miss: CoreAllocationContract = core_call_allocation_contract(
		IntrinsicCall("string_length"),
	)

	match near_miss.dependencies:
		[RuntimeAllocationDependency]:
			valid and near_miss.facts.unknown == [RuntimeOperationAllocation]
		_:
			False


private pure func test_closed_runtime_catalog_distinguishes_safe_and_allocating() -> Bool:
	var valid: Bool = True

	for name in [
		"blorp_min",
		"blorp_max",
		"blorp_hash_combine",
		"blorp_length",
		"blorp_codepoint_length",
	]:
		contract: CoreAllocationContract = core_call_allocation_contract(DirectRuntimeCall({
			name = name,
			args = DirectRuntimeArgsAsWritten,
			result = DirectRuntimeResultAsWritten,
		}))

		if not allocation_facts_are_free(contract.facts) or not contract.dependencies.is_empty():
			valid = False
		else:
			void

	levenshtein: CoreAllocationContract = core_call_allocation_contract(DirectRuntimeCall({
		name = "blorp_string_levenshtein",
		args = DirectRuntimeArgsAsWritten,
		result = DirectRuntimeResultAsWritten,
	}))
	unregistered: CoreAllocationContract = core_call_allocation_contract(DirectRuntimeCall({
		name = "blorp_length_unregistered",
		args = DirectRuntimeArgsAsWritten,
		result = DirectRuntimeResultAsWritten,
	}))

	match unregistered.dependencies:
		[RuntimeAllocationDependency]:
			(
				valid
				and levenshtein.facts.may_allocate == [RawBufferAllocation]
				and levenshtein.facts.unknown.is_empty()
				and levenshtein.dependencies.is_empty()
				and unregistered.facts.unknown == [RuntimeOperationAllocation]
			)
		_:
			False


private pure func test_fact_merging_is_stable_and_deduplicated() -> Bool:
	merged: CoreLocalAllocationFacts = merge_allocation_facts(
		{
			may_allocate = [TupleStorageAllocation, HeapBoxAllocation],
			unknown = [RuntimeOperationAllocation]
		},
		{
			may_allocate = [HeapBoxAllocation, ManagedObjectAllocation],
			unknown = [RuntimeOperationAllocation, ForeignCallBoundary]
		},
	)

	(
		merged.may_allocate == [TupleStorageAllocation, HeapBoxAllocation, ManagedObjectAllocation]
		and merged.unknown == [RuntimeOperationAllocation, ForeignCallBoundary]
	)


private pure func test_call_site_detail_names_the_matched_operation() -> Bool:
	(
		core_call_kind_operation_name(BuiltinCall("blorp_list_to_string")) == "blorp_list_to_string"
		and core_call_kind_operation_name(
			DirectRuntimeCall({
				name = "blorp_string_levenshtein",
				args = DirectRuntimeArgsAsWritten,
				result = DirectRuntimeResultAsWritten,
			}),
		) == "blorp_string_levenshtein"
		and core_call_kind_operation_name(UnknownCall) == "unknown_call"
		and core_expr_operation_detail(
			CallExpr(
				BuiltinCall("blorp_list_to_string"),
				int_literal(0),
				[],
				NamedType("Int", []),
				SyntheticSourceLoc,
			),
		) == "blorp_list_to_string"
	)


private pure func test_cleanup_and_loop_site_detail_names_the_type() -> Bool:
	(
		core_expr_operation_detail(drop_expr(NamedType("List", [NamedType("Int", [])]), ArcReleasePolicy)) == "List[Int]"
		and core_expr_operation_detail(
			ForListExpr(
				{
					binder = loop_binder(),
					layout = PointerListStorage,
					iterable = LiteralExpr(IntLiteral(0), NamedType("String", []), SyntheticSourceLoc),
					iterable_release_policy = ArcReleaseOnlyPolicy,
					body = int_literal(0)
				},
				NamedType("Void", []),
				SyntheticSourceLoc,
			),
		) == "String"
	)


tests: TestSuite = {
	description = "Blorp compiler Core allocation contracts",
	tests = [
		("bit-packed boxes are allocation-free", test_bit_packed_boxes_are_allocation_free),
		("wide and struct boxes allocate", test_wide_and_struct_boxes_allocate),
		("union cleanup plans are explicit", test_union_cleanup_plans_are_explicit),
		("mixed risks are preserved", test_mixed_risks_are_preserved),
		("reason codes are stable", test_reason_codes_are_stable),
		(
			"direct call dependencies use exact definition IDs",
			test_direct_call_dependencies_use_exact_definition_ids,
		),
		(
			"unknown and named runtime calls fail closed",
			test_unknown_and_named_runtime_calls_fail_closed,
		),
		(
			"expr coverage is separate from semantic facts",
			test_expr_coverage_is_separate_from_semantic_facts,
		),
		(
			"dict iteration distinguishes pair binders",
			test_dict_iteration_distinguishes_pair_binders,
		),
		(
			"foreign defensive copy preserves may and unknown",
			test_foreign_defensive_copy_preserves_may_and_unknown,
		),
		(
			"closure creation distinguishes capture environments",
			test_closure_creation_distinguishes_capture_environments,
		),
		(
			"record construction distinguishes value and heap layouts",
			test_record_construction_distinguishes_value_and_heap_layouts,
		),
		(
			"generic union construction distinguishes nullary payload",
			test_generic_union_construction_distinguishes_nullary_payload,
		),
		("stack union elides implicit boxes", test_stack_union_elides_implicit_boxes),
		("union box facts follow payload emission", test_union_box_facts_follow_payload_emission),
		(
			"tuple construction preserves storage and implicit box facts",
			test_tuple_construction_preserves_storage_and_implicit_box_facts,
		),
		(
			"drop policies publish exact cleanup dependencies",
			test_drop_policies_publish_exact_cleanup_dependencies,
		),
		(
			"list get layouts are locally allocation-free",
			test_list_get_layouts_are_locally_allocation_free,
		),
		("scheduler checkpoint is allocation-free", test_scheduler_checkpoint_is_allocation_free),
		(
			"loop contracts publish hidden runtime and cleanup",
			test_loop_contracts_publish_hidden_runtime_and_cleanup,
		),
		(
			"accessor match publishes scrutinee cleanup",
			test_accessor_match_publishes_scrutinee_cleanup,
		),
		(
			"container construction preserves payload risks",
			test_container_construction_preserves_payload_risks,
		),
		(
			"list to string preserves known and unknown risks",
			test_list_to_string_preserves_known_and_unknown_risks,
		),
		(
			"channel and select publish received value cleanup",
			test_channel_and_select_publish_received_value_cleanup,
		),
		(
			"capture and reuse contracts preserve hidden causes",
			test_capture_and_reuse_contracts_preserve_hidden_causes,
		),
		(
			"closed intrinsic catalog admits only audited names",
			test_closed_intrinsic_catalog_admits_only_audited_names,
		),
		(
			"closed runtime catalog distinguishes safe and allocating",
			test_closed_runtime_catalog_distinguishes_safe_and_allocating,
		),
		("fact merging is stable and deduplicated", test_fact_merging_is_stable_and_deduplicated),
		(
			"call site detail names the matched operation",
			test_call_site_detail_names_the_matched_operation,
		),
		(
			"cleanup and loop site detail names the type",
			test_cleanup_and_loop_site_detail_names_the_type,
		),
	]
}
