import:
	../../../src/compiler/stage_09_core/backend_helper_catalog:
		ALL_BACKEND_HELPER_KINDS,
		BACKEND_HELPER_CATALOG_REVISION,
		BACKEND_HELPER_KIND_COUNT,
		BackendHelperContract,
		BackendHelperKind,
		backend_helper_contract,
	test: TestSuite


-- Every BackendHelperKind must have a row: backend_helper_contract is an
-- exhaustive match, so an uncataloged variant fails the build, not this
-- test. This test instead pins the *count* and checks ALL_BACKEND_HELPER_KINDS
-- (a separately hand-populated list) has not drifted from that count and that
-- every entry actually resolves to a contract without contradicting itself.
private pure func test_catalog_is_total_and_counted() -> Bool:
	kinds: List[BackendHelperKind] = ALL_BACKEND_HELPER_KINDS

	kinds.length() == BACKEND_HELPER_KIND_COUNT and BACKEND_HELPER_KIND_COUNT == 383


private pure func contract_is_self_consistent(contract: BackendHelperContract) -> Bool:
	-- A helper that calls no runtime function contributing scratch cleanup
	-- growth should not claim cleanup_scratch; today no catalog row does
	-- (that class of allocation lives in the emitter's iterative-destructor
	-- work-stack growth, tracked by the existing CleanupPlan, not here).
	not contract.cleanup_scratch


private pure func test_every_cataloged_kind_resolves() -> Bool:
	var ok: Bool = True

	for kind in ALL_BACKEND_HELPER_KINDS:
		contract: BackendHelperContract = backend_helper_contract(kind)

		if not contract_is_self_consistent(contract):
			ok = False
		else:
			void

	ok


private pure func test_revision_is_positive() -> Bool:
	BACKEND_HELPER_CATALOG_REVISION > 0


tests: TestSuite = {
	description = "Backend helper allocation/ownership catalog",
	tests = [
		("Catalog is total and its count is pinned", test_catalog_is_total_and_counted),
		(
			"Every cataloged kind resolves to a self-consistent contract",
			test_every_cataloged_kind_resolves,
		),
		("Catalog revision is a positive version number", test_revision_is_positive),
	]
}
