import:
	../../../benchmark/compiler/compiler_closure_function_index_profile_fixture:
		CompilerClosureFunctionIndexProfileConfig,
		compiler_closure_function_index_profile_execute,
		compiler_closure_function_index_profile_fixture,
		compiler_closure_function_index_profile_measure_construction,
	test: TestSuite


private SMALL_PROFILE_CHECKSUM: Int = 657851618425634224


pure func small_profile_config() -> CompilerClosureFunctionIndexProfileConfig:
	{
		iterations = 2,
		top_level_functions = 5,
		impl_blocks = 2,
		methods_per_impl = 3,
		duplicate_name_interval = 4,
		duplicate_id_interval = 5
	}


pure func test_closure_function_index_profile_contents_are_deterministic() -> Bool:
	fixture = compiler_closure_function_index_profile_fixture(small_profile_config())
	result = compiler_closure_function_index_profile_execute(fixture)

	(
		result.checksum == SMALL_PROFILE_CHECKSUM
		and result.workload_valid
	)


pure func test_closure_function_index_construction_measurement_matches_contents() -> Bool:
	fixture = compiler_closure_function_index_profile_fixture(small_profile_config())
	contents = compiler_closure_function_index_profile_execute(fixture)
	result = compiler_closure_function_index_profile_measure_construction(fixture)

	(
		result.function_count == contents.function_count
		and result.by_id_count == contents.by_id_count
		and result.by_name_count == contents.by_name_count
		and result.collision_id_count == contents.collision_id_count
		and result.total_collision_entries == contents.total_collision_entries
		and result.checksum == 0
		and result.workload_valid
	)


tests: TestSuite = {
	description = "Compiler closure function index benchmark",
	tests = [
		(
			"reports deterministic index contents",
			test_closure_function_index_profile_contents_are_deterministic,
		),
		(
			"construction measurement matches contents without diagnostic lookups",
			test_closure_function_index_construction_measurement_matches_contents,
		),
	]
}
