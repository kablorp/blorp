import:
	../../../../compiler/benchmarks/compiler_core_call_resolve_profile_fixture:
		CompilerCoreCallResolveBenchmarkResult,
		CompilerCoreCallResolveProfileConfig,
		compiler_core_call_resolve_benchmark,
		compiler_core_call_resolve_benchmark_input,
		compiler_core_call_resolve_benchmark_with_input,
	memory: get_mem_stats, reset_mem_stats
	test: TestSuite


private INDEX_FIXTURE_MODULE_PATH_ORDER_CHECKSUM: Int = 6701649995124992104

private ALLOCATION_FIXTURE_MAX_TOTAL_ALLOCATIONS: Int = 13600


private pure func index_fixture_config() -> CompilerCoreCallResolveProfileConfig:
	{
		iterations = 1,
		function_count = 8,
		module_count = 2,
		constructors_per_type = 3,
		duplicate_id_interval = 4,
		imports_per_module = 2
	}


private pure func allocation_fixture_config() -> CompilerCoreCallResolveProfileConfig:
	{
		iterations = 1,
		function_count = 512,
		module_count = 32,
		constructors_per_type = 4,
		duplicate_id_interval = 64,
		imports_per_module = 4
	}


private func test_call_resolve_fixture_counts_all_logical_indexes() -> Bool:
	result: CompilerCoreCallResolveBenchmarkResult = compiler_core_call_resolve_benchmark(
		index_fixture_config(),
	)
	observation = result.observation

	(
		result.declaration_count == 22
		and result.module_path_membership_check_count == 16
		and result.error_count == 0
		and observation.user_function_count == 11
		and observation.user_function_by_id_count == 11
		and observation.colliding_user_function_id_count == 1
		and observation.module_function_count == 8
		and observation.global_type_count == 2
		and observation.foreign_function_count == 2
		and observation.builtin_function_count == 5
		and observation.constructor_name_count == 3
		and observation.constructor_target_count == 6
		and observation.import_binding_count == 4
		and observation.module_import_count == 2
		and observation.module_import_binding_count == 4
		and observation.module_path_count == 8
		and observation.module_path_order_checksum == INDEX_FIXTURE_MODULE_PATH_ORDER_CHECKSUM
		and result.workload_valid
	)


private func test_call_resolve_construction_allocations_are_bounded() -> Bool:
	input = compiler_core_call_resolve_benchmark_input(allocation_fixture_config())

	reset_mem_stats()
	result = compiler_core_call_resolve_benchmark_with_input(input)
	stats = get_mem_stats()

	(
		result.error_count == 0
		and result.workload_valid
		and stats.total_allocations <= ALLOCATION_FIXTURE_MAX_TOTAL_ALLOCATIONS
	)


tests: TestSuite = {
	description = "Compiler Core call-resolution profile benchmark",
	tests = [
		(
			"fixture counts all logical indexes",
			test_call_resolve_fixture_counts_all_logical_indexes,
		),
		(
			"construction allocations are bounded",
			test_call_resolve_construction_allocations_are_bounded,
		),
	]
}
