						field_accessor(0),
						[{ constructor = "Some", body = SemanticMatchLeaf([], int_literal(1)) }],
						Some(SemanticMatchLeaf([], int_literal(2))),
					)
				},
			],
			Some(SemanticMatchLeaf([], int_literal(3))),
