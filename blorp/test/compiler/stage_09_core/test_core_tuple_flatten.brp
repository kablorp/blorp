	memory: same_object
	test: TestSuite


TY_INT: CoreType = NamedType("Int", [])

TY_BOOL: CoreType = NamedType("Bool", [])

TY_STRING: CoreType = NamedType("String", [])

TY_PAIR: CoreType = TupleType([TY_INT, TY_INT])

TY_STRING_PAIR: CoreType = TupleType([TY_STRING, TY_INT])

TY_BOX: CoreType = HeapRecordType("Box")

TY_OPTION_INT: CoreType = NamedType("Option", [TY_INT])

TY_TWO_OPTIONS: CoreType = TupleType([TY_OPTION_INT, TY_OPTION_INT])

TY_THREE_OPTIONS: CoreType = TupleType([TY_OPTION_INT, TY_OPTION_INT, TY_OPTION_INT])

TY_PAIR_AND_INT: CoreType = TupleType([TY_PAIR, TY_INT])

DEEP_LOGICAL_LENGTH: Int = 512


private pure func core_var(name: String) -> CoreVar:
	core_var_with_id(name, 0)


private pure func core_var_with_id(name: String, id: Int) -> CoreVar:
	{
		name = name,
		id = id,
		def_id = None,
		origin = AuthoredBinder
	}


private pure func variable(name: String, typ: CoreType) -> CoreExpr:
	variable_with_identity(core_var(name), typ)


private pure func variable_with_identity(variable_name: CoreVar, typ: CoreType) -> CoreExpr:
	VarExpr(variable_name, typ, synthetic_core_source_loc())


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), TY_INT, synthetic_core_source_loc())


private pure func bool_literal(value: Bool) -> CoreExpr:
	LiteralExpr(BoolLiteral(value), TY_BOOL, synthetic_core_source_loc())


private pure func string_literal(value: String) -> CoreExpr:
	LiteralExpr(StringLiteral(value), TY_STRING, synthetic_core_source_loc())


private pure func tuple_field(owner: CoreExpr, index: Int, typ: CoreType) -> CoreExpr:
	TupleFieldExpr(owner, index, typ, synthetic_core_source_loc())


private pure func tuple_of(items: List[CoreExpr], typ: CoreType) -> CoreExpr:
	TupleExpr(items, typ, synthetic_core_source_loc())


private pure func immutable_let(
	name: String,
	typ: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	LetExpr(core_var(name), False, typ, rhs, body)


private pure func tuple_let(
	name: String,
	tuple_type: CoreType,
	elements: List[CoreExpr],
	body: CoreExpr,
) -> CoreExpr:
	immutable_let(name, tuple_type, tuple_of(elements, tuple_type), body)


private pure func add(left: CoreExpr, right: CoreExpr) -> CoreExpr:
	BinaryExpr(AddOp, left, right, TY_INT, synthetic_core_source_loc())


private pure func function_type(params: List[CoreType], return_type: CoreType) -> CoreType:
	FunctionType(True, params, return_type)


-- A call of a function the pass knows nothing about.
private pure func call_of(name: String, args: List[CoreExpr], result_type: CoreType) -> CoreExpr:
	CallExpr(
		UserCall(name, None, []),
		variable(name, function_type([], result_type)),
		args,
		result_type,
		synthetic_core_source_loc(),
	)


private pure func param(name: String, typ: CoreType) -> CoreParam:
	{
		name = core_var(name),
		typ = typ,
		loc = synthetic_core_source_loc()
	}


private pure func function_decl(
	name: String,
	def_id: Int,
	params: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = None,
		type_params = [],
		params = params,
		return_type = return_type,
		body = Some(body),
		is_pure = True,
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = UserFunction,
		def_id = def_id,
		loc = synthetic_core_source_loc(),
	})


private pure func program(decls: List[CoreDecl]) -> CoreProgram:
	{
		decls = decls,
		foreign_includes = [],
		source_files = []
	}


private pure func flattened(expr: CoreExpr) -> Result[CoreExpr, TupleFlattenFault]:
	flatten_tuples_expr(expr, FIRST_MINTED_BINDER_ID)


-- Whether `expr` flattens and the result satisfies `check`. A fault fails.
private pure func flattens_to(expr: CoreExpr, check: pure (CoreExpr) -> Bool) -> Bool:
	match flattened(expr):
		Ok(rewritten):
			check(rewritten)
		Err(_):
			False


private pure func flattened_program(input: CoreProgram) -> Option[TupleFlattenedProgram]:
	match flatten_tuples_program(input, FIRST_MINTED_BINDER_ID):
		Ok(result):
			Some(result)
		Err(_):
			None


private pure func contains_expr(
	expr: CoreExpr,
	predicate: pure (CoreExpr) -> Bool,
) -> Bool:
	if predicate(expr):
		True
	else:
		immediate_core_expr_children(
			expr,
		).any(
			pure func(child: CoreExpr): contains_expr(child, predicate),
		)


private pure func is_tuple_expr(expr: CoreExpr) -> Bool:
	match expr:
		TupleExpr(_, _, _):
			True
		_:
			False


private pure func contains_tuple(expr: CoreExpr) -> Bool:
	contains_expr(expr, is_tuple_expr)


private pure func field_is_owned_by(owner: CoreVar, expr: CoreExpr) -> Bool:
	match expr:
		TupleFieldExpr(VarExpr(variable, _, _), _, _, _):
			core_var_equal(variable, owner)
		_:
			False


private pure func contains_field_of(expr: CoreExpr, owner: CoreVar) -> Bool:
	contains_expr(expr, pure func(node: CoreExpr): field_is_owned_by(owner, node))


private pure func names_variable(variable_name: CoreVar, expr: CoreExpr) -> Bool:
	match expr:
		VarExpr(variable, _, _):
			core_var_equal(variable, variable_name)
		_:
			False


private pure func mentions(expr: CoreExpr, variable_name: CoreVar) -> Bool:
	contains_expr(expr, pure func(node: CoreExpr): names_variable(variable_name, node))


private pure func call_targets(name: String, expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(UserCall(callee, _, _), _, _, _, _):
			callee == name
		_:
			False


private pure func contains_call_to(expr: CoreExpr, name: String) -> Bool:
	contains_expr(expr, pure func(node: CoreExpr): call_targets(name, node))


private pure func is_flatten_binder(variable: CoreVar) -> Bool:
	match variable.origin:
		PassTemporary(TupleFlattenTemp, _):
			True
		_:
			False


-- The ids of the locals the pass minted, in binding order.
private pure func minted_binder_ids(expr: CoreExpr) -> List[Int]:
	var ids: List[Int] = []

	match expr:
		LetExpr(variable, _, _, _, _):
			if is_flatten_binder(variable):
				ids = ids.append(variable.id)
		_:
			void

	for child in immediate_core_expr_children(expr):
		ids = ids.concat(minted_binder_ids(child))

	ids


private pure func int_literals_in_expr(expr: CoreExpr) -> List[Int]:
	current: List[Int] = match expr:
		LiteralExpr(IntLiteral(value), _, _):
			[value]
		_:
			[]

	var values: List[Int] = current

	for child in immediate_core_expr_children(expr):
		values = values.concat(int_literals_in_expr(child))

	values


private pure func int_literals_in_semantic_tree(tree: CoreSemanticMatchTree) -> List[Int]:
	match tree:
		SemanticMatchLeaf(_, body):
			int_literals_in_expr(body)
		SemanticLiteralMatch(_, cases, fallback):
			var values: List[Int] = []

			for match_case in cases:
				values = values.concat(int_literals_in_semantic_tree(match_case.body))

			values.concat(int_literals_in_semantic_tree(fallback))
		SemanticLengthMatch(_, cases, geq, fallback):
			var values: List[Int] = []

			for match_case in cases:
				values = values.concat(int_literals_in_semantic_tree(match_case.body))

			match geq:
				Some(geq_case):
					values = values.concat(int_literals_in_semantic_tree(geq_case.body))
				None:
					void

			match fallback:
				Some(fallback_tree):
					values.concat(int_literals_in_semantic_tree(fallback_tree))
				None:
					values
		_:
			[]


private pure func first_semantic_leaf_ints(expr: CoreExpr) -> Option[List[Int]]:
	match expr:
		SemanticMatchExpr(_, tree, _, _):
			Some(int_literals_in_semantic_tree(tree))
		_:
			var found: Option[List[Int]] = None

			for child in immediate_core_expr_children(expr):
				match first_semantic_leaf_ints(child):
					Some(values):
						found = Some(values)
						break
					None:
						void

			found


private pure func function_body_at(program_value: CoreProgram, index: Int) -> Option[CoreExpr]:
	match program_value.decls.get(index):
		Some(FunctionDecl(function_info)):
			function_info.body
		_:
			None


private pure func field_accessor(index: Int) -> CoreSemanticMatchAccessor:
	TupleFieldSemanticMatchAccessor(RootSemanticMatchAccessor, index)


private pure func borrow_binding(
	variable_name: CoreVar,
	accessor: CoreSemanticMatchAccessor,
) -> CoreSemanticMatchBinding:
	{
		variable = variable_name,
		accessor = accessor,
		mode = MatchBorrowBindingMode
	}


private pure func subject_match(
	subject: CoreExpr,
	tree: CoreSemanticMatchTree,
	result_type: CoreType,
) -> CoreExpr:
	SemanticMatchExpr(subject, tree, result_type, synthetic_core_source_loc())


private pure func two_options_subject() -> CoreExpr:
	tuple_of(
		[variable("left", TY_OPTION_INT), variable("right", TY_OPTION_INT)],
		TY_TWO_OPTIONS,
	)


-- Single-column accessors: the pinned bootstrap tests only the first
-- non-trivial payload column of a pattern (match lowering, fixed in
-- 65341398d, not yet pinned), so the shape checks below take one step at a
-- time instead of nesting patterns.
private pure func let_binder(expr: CoreExpr) -> Option[CoreVar]:
	match expr:
		LetExpr(variable, _, _, _, _):
			Some(variable)
		_:
			None


private pure func let_rhs(expr: CoreExpr) -> Option[CoreExpr]:
	match expr:
		LetExpr(_, _, _, rhs, _):
			Some(rhs)
		_:
			None


private pure func let_body(expr: CoreExpr) -> Option[CoreExpr]:
	match expr:
		LetExpr(_, _, _, _, body):
			Some(body)
		_:
			None


private pure func match_subject_variable(expr: CoreExpr) -> Option[CoreVar]:
	match expr:
		SemanticMatchExpr(scrutinee, _, _, _):
			match scrutinee:
				VarExpr(variable, _, _):
					Some(variable)
				_:
					None
		_:
			None


private pure func match_tree(expr: CoreExpr) -> Option[CoreSemanticMatchTree]:
	match expr:
		SemanticMatchExpr(_, tree, _, _):
			Some(tree)
		_:
			None


private pure func constructor_cases(tree: CoreSemanticMatchTree) -> List[CoreSemanticConstructorMatchCase]:
	match tree:
		SemanticConstructorMatch(_, cases, _):
			cases
		_:
			[]


private pure func constructor_fallback(tree: CoreSemanticMatchTree) -> Option[CoreSemanticMatchTree]:
	match tree:
		SemanticConstructorMatch(_, _, fallback):
			fallback
		_:
			None


private pure func tests_root(tree: CoreSemanticMatchTree) -> Bool:
	match tree:
		SemanticConstructorMatch(accessor, _, _):
			is_root(accessor)
		SemanticLiteralMatch(accessor, _, _):
			is_root(accessor)
		_:
			False


private pure func is_root(accessor: CoreSemanticMatchAccessor) -> Bool:
	match accessor:
		RootSemanticMatchAccessor:
			True
		_:
			False


private pure func leaf_bindings(tree: CoreSemanticMatchTree) -> List[CoreSemanticMatchBinding]:
	match tree:
		SemanticMatchLeaf(bindings, _):
			bindings
		_:
			[]


private pure func subject_is(expr: CoreExpr, name: String) -> Bool:
	match match_subject_variable(expr):
		Some(variable):
			core_var_equal(variable, core_var(name))
		None:
			False


private pure func leaf_ints_are(expr: CoreExpr, expected: List[Int]) -> Bool:
	match first_semantic_leaf_ints(expr):
		Some(values):
			values == expected
		None:
			False


private pure func leaf_body(tree: CoreSemanticMatchTree) -> Option[CoreExpr]:
	match tree:
		SemanticMatchLeaf(_, body):
			Some(body)
		_:
			None


-- Locals ----------------------------------------------------------------------


func test_local_field_access_is_flattened() -> Bool:
	pair: CoreExpr = variable("pair", TY_PAIR)
	body: CoreExpr = add(tuple_field(pair, 0, TY_INT), tuple_field(pair, 1, TY_INT))

	flattens_to(
		tuple_let("pair", TY_PAIR, [int_literal(20), int_literal(22)], body),
		pure func(rewritten: CoreExpr):
			not contains_tuple(rewritten) and not contains_field_of(rewritten, core_var("pair"))
	)


func test_tuple_used_whole_keeps_its_box() -> Bool:
	flattens_to(
		tuple_let(
			"pair",
			TY_PAIR,
			[int_literal(1), int_literal(2)],
			variable("pair", TY_PAIR),
		),
		contains_tuple,
	)


func test_tuple_passed_to_a_call_keeps_its_box() -> Bool:
	pair: CoreExpr = variable("pair", TY_PAIR)
	body: CoreExpr = add(tuple_field(pair, 0, TY_INT), call_of("consume", [pair], TY_INT))

	flattens_to(
		tuple_let("pair", TY_PAIR, [int_literal(1), int_literal(2)], body),
		pure func(rewritten: CoreExpr):
			contains_tuple(rewritten) and contains_field_of(rewritten, core_var("pair"))
	)


func test_mutable_tuple_keeps_its_box() -> Bool:
	pair: CoreExpr = variable("pair", TY_PAIR)
	expr: CoreExpr = LetExpr(
		core_var("pair"),
		True,
		TY_PAIR,
		tuple_of([int_literal(1), int_literal(2)], TY_PAIR),
		tuple_field(pair, 0, TY_INT),
	)

	flattens_to(expr, contains_tuple)


func test_managed_local_tuple_is_flattened() -> Bool:
	pair: CoreExpr = variable("pair", TY_STRING_PAIR)

	flattens_to(
		tuple_let(
			"pair",
			TY_STRING_PAIR,
			[string_literal("hello"), int_literal(2)],
			tuple_field(pair, 0, TY_STRING),
		),
		pure func(rewritten: CoreExpr):
			not contains_tuple(rewritten) and not contains_field_of(rewritten, core_var("pair"))
	)


func test_alias_of_flattened_local_is_the_same_group() -> Bool:
	pair: CoreVar = core_var_with_id("pair", 1)
	again: CoreVar = core_var_with_id("again", 2)
	expr: CoreExpr = LetExpr(
		pair,
		False,
		TY_PAIR,
		tuple_of([int_literal(1), int_literal(2)], TY_PAIR),
		LetExpr(
			again,
			False,
			TY_PAIR,
			variable_with_identity(pair, TY_PAIR),
			tuple_field(variable_with_identity(again, TY_PAIR), 1, TY_INT),
		),
	)

	flattens_to(
		expr,
		pure func(rewritten: CoreExpr):
			(
				not contains_tuple(rewritten)
				and not mentions(rewritten, pair)
				and not mentions(rewritten, again)
				and minted_binder_ids(rewritten) == [-1, -2]
			)
	)


func test_alias_used_whole_keeps_its_source_boxed() -> Bool:
	pair: CoreVar = core_var_with_id("pair", 1)
	again: CoreVar = core_var_with_id("again", 2)
	expr: CoreExpr = LetExpr(
		pair,
		False,
		TY_PAIR,
		tuple_of([int_literal(1), int_literal(2)], TY_PAIR),
		LetExpr(
			again,
			False,
			TY_PAIR,
			variable_with_identity(pair, TY_PAIR),
			call_of("consume", [variable_with_identity(again, TY_PAIR)], TY_INT),
		),
	)

	flattens_to(expr, contains_tuple)


func test_source_keeps_its_box() -> Bool:
	-- A tuple returned by a call the pass cannot expand comes out of a box:
	-- its element reads stay projections of that box.
	pair: CoreVar = core_var_with_id("pair", 1)
	expr: CoreExpr = LetExpr(
		pair,
		False,
		TY_PAIR,
		call_of("opaque_pair", [], TY_PAIR),
		tuple_field(variable_with_identity(pair, TY_PAIR), 0, TY_INT),
	)

	flattens_to(expr, pure func(rewritten: CoreExpr): contains_field_of(rewritten, pair))


func test_immediate_tuple_field_is_flattened() -> Bool:
	expr: CoreExpr = tuple_field(tuple_of([int_literal(3), int_literal(4)], TY_PAIR), 1, TY_INT)

	flattens_to(
		expr,
		pure func(rewritten: CoreExpr):
			not contains_tuple(rewritten) and minted_binder_ids(rewritten).length() == 2
	)


private pure func immediate_tuple_field_value() -> CoreExpr:
	tuple_field(tuple_of([int_literal(3), int_literal(4)], TY_PAIR), 1, TY_INT)


func test_flattening_traverses_record_update_fields() -> Bool:
	flattens_to(
		RecordUpdateExpr(
			variable("box", TY_BOX),
			[
				{
					name = "value",
					ref = core_field_ref(0),
					value = immediate_tuple_field_value()
				},
			],
			TY_BOX,
			synthetic_core_source_loc(),
		),
		pure func(rewritten: CoreExpr): not contains_tuple(rewritten),
	)


func test_flattening_traverses_record_reuse_fields() -> Bool:
	flattens_to(
		RecordReuseExpr(
			variable("box", TY_BOX),
			[
				{
					name = "value",
					ref = core_field_ref(0),
					value = immediate_tuple_field_value()
				},
			],
			TY_BOX,
			synthetic_core_source_loc(),
		),
		pure func(rewritten: CoreExpr): not contains_tuple(rewritten),
	)


func test_flattening_traverses_tensor_raw_read_index() -> Bool:
	flattens_to(
		TensorRawReadExpr(
			{
				view = core_var("view"),
				kind = TensorInt64Elements,
				index = tuple_field(tuple_of([int_literal(1), int_literal(2)], TY_PAIR), 0, TY_INT)
			},
			TY_INT,
			synthetic_core_source_loc(),
		),
		pure func(rewritten: CoreExpr): not contains_tuple(rewritten),
	)


func test_tuple_if_is_flattened() -> Bool:
	pair: CoreExpr = variable("pair", TY_PAIR)
	rhs: CoreExpr = IfExpr(
		bool_literal(True),
		tuple_of([int_literal(1), int_literal(2)], TY_PAIR),
		tuple_of([int_literal(3), int_literal(4)], TY_PAIR),
		TY_PAIR,
		synthetic_core_source_loc(),
	)

	flattens_to(
		immutable_let("pair", TY_PAIR, rhs, tuple_field(pair, 0, TY_INT)),
		pure func(rewritten: CoreExpr):
			not contains_tuple(rewritten) and not contains_field_of(rewritten, core_var("pair"))
	)


func test_tuple_if_with_mismatched_element_type_keeps_its_box() -> Bool:
	pair: CoreExpr = variable("pair", TY_PAIR)
	rhs: CoreExpr = IfExpr(
		bool_literal(True),
		tuple_of([int_literal(1), int_literal(2)], TY_PAIR),
		tuple_of([string_literal("wrong"), int_literal(4)], TY_STRING_PAIR),
		TY_PAIR,
		synthetic_core_source_loc(),
	)

	flattens_to(
		immutable_let("pair", TY_PAIR, rhs, tuple_field(pair, 0, TY_INT)),
		pure func(rewritten: CoreExpr):
			contains_tuple(rewritten) and contains_field_of(rewritten, core_var("pair"))
	)


func test_alias_bound_in_two_branches_keeps_its_source_boxed() -> Bool:
	-- One alias binder bound in two sibling branches, naming the local in one
	-- and another box in the other. A binder bound twice keeps its box, and an
	-- alias that keeps its box keeps its source boxed too, so every read stays
	-- a read of the value it was written against.
	pair: CoreVar = core_var_with_id("pair", 1)
	other: CoreVar = core_var_with_id("other", 2)
	branch_alias: CoreVar = core_var_with_id("branch_alias", 3)
	then_branch: CoreExpr = LetExpr(
		branch_alias,
		False,
		TY_PAIR,
		variable_with_identity(pair, TY_PAIR),
		tuple_field(variable_with_identity(branch_alias, TY_PAIR), 0, TY_INT),
	)
	else_branch: CoreExpr = LetExpr(
		branch_alias,
		False,
		TY_PAIR,
		variable_with_identity(other, TY_PAIR),
		tuple_field(variable_with_identity(branch_alias, TY_PAIR), 0, TY_INT),
	)
	expr: CoreExpr = LetExpr(
		pair,
		False,
		TY_PAIR,
		tuple_of([int_literal(1), int_literal(2)], TY_PAIR),
		IfExpr(bool_literal(True), then_branch, else_branch, TY_INT, synthetic_core_source_loc()),
	)

	flattens_to(
		expr,
		pure func(rewritten: CoreExpr):
			contains_tuple(rewritten) and contains_field_of(rewritten, branch_alias)
	)


func test_element_index_outside_the_tuple_is_an_internal_error() -> Bool:
	pair: CoreVar = core_var_with_id("pair", 1)
	expr: CoreExpr = LetExpr(
		pair,
		False,
		TY_PAIR,
		tuple_of([int_literal(1), int_literal(2)], TY_PAIR),
		tuple_field(variable_with_identity(pair, TY_PAIR), 2, TY_INT),
	)

	match flattened(expr):
		Err(SubjectAccessorOutsideElements(_)):
			True
		_:
			False


func test_tuple_match_with_non_tuple_leaf_keeps_its_box() -> Bool:
	pair: CoreVar = core_var_with_id("pair", 1)
	match_rhs: CoreExpr = subject_match(
		variable("choice", TY_INT),
		SemanticLiteralMatch(
			RootSemanticMatchAccessor,
			[
				{
					literal = IntLiteral(0),
					body = SemanticMatchLeaf([], tuple_of([int_literal(1), int_literal(2)], TY_PAIR))
				},
			],
			SemanticMatchLeaf([], variable("fallback", TY_PAIR)),
		),
		TY_PAIR,
	)

	flattens_to(
		LetExpr(
			pair,
			False,
			TY_PAIR,
			match_rhs,
			tuple_field(variable_with_identity(pair, TY_PAIR), 0, TY_INT),
		),
		pure func(rewritten: CoreExpr):
			contains_tuple(rewritten) and contains_field_of(rewritten, pair)
	)


func test_tuple_match_leaf_collection_preserves_case_order() -> Bool:
	pair: CoreVar = core_var_with_id("pair", 1)
	match_rhs: CoreExpr = subject_match(
		variable("choice", TY_INT),
