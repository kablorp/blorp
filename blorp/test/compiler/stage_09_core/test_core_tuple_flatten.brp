			variable_with_identity(x, TY_INT),
		),
		TY_INT,
	)

	match flattened(match_expr):
		Err(ElementBindingWithoutTest(variable)):
			core_var_equal(variable, x)
		_:
			False


func test_flattened_local_match_is_split() -> Bool:
