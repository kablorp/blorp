				and not contains_field_of(rewritten, pair)
				and leaf_ints_are(rewritten, [10, 20, 30])
			)
	)


func test_tuple_length_match_leaf_collection_preserves_geq_and_fallback_order() -> Bool:
	pair: CoreVar = core_var_with_id("pair", 1)
	length_case: CoreSemanticLengthMatchCase = {
		length = 2,
		body = SemanticMatchLeaf([], tuple_of([int_literal(40), int_literal(41)], TY_PAIR))
	}
	geq_case: CoreSemanticLengthMatchGeq = {
		minimum_length = 3,
		body = SemanticMatchLeaf([], tuple_of([int_literal(50), int_literal(51)], TY_PAIR))
	}
	match_rhs: CoreExpr = subject_match(
		variable("choice", TY_INT),
		SemanticLengthMatch(
			RootSemanticMatchAccessor,
			[length_case],
			Some(geq_case),
			Some(SemanticMatchLeaf([], tuple_of([int_literal(60), int_literal(61)], TY_PAIR))),
		),
