	)

	flattens_to(
		LetExpr(
			pair,
			False,
			TY_PAIR,
			match_rhs,
			tuple_field(variable_with_identity(pair, TY_PAIR), 0, TY_INT),
		),
		pure func(rewritten: CoreExpr):
			(
				not contains_tuple(rewritten)
				and not contains_field_of(rewritten, pair)
				and leaf_ints_are(rewritten, [40, 50, 60])
			)
	)


-- Match subjects --------------------------------------------------------------


func test_nested_option_subject_is_split() -> Bool:
	first: CoreVar = core_var_with_id("first", 1)
	second: CoreVar = core_var_with_id("second", 2)
	match_expr: CoreExpr = subject_match(
		two_options_subject(),
		SemanticConstructorMatch(
			field_accessor(0),
			[
				{
					constructor = "Some",
					body = SemanticConstructorMatch(
						field_accessor(1),
						[
							{
								constructor = "Some",
								body = SemanticMatchLeaf(
									[
										borrow_binding(
											first,
											VariantFieldSemanticMatchAccessor(field_accessor(0), "Some", 0),
										),
										borrow_binding(
											second,
											VariantFieldSemanticMatchAccessor(field_accessor(1), "Some", 0),
										),
									],
									add(
										variable_with_identity(first, TY_INT),
										variable_with_identity(second, TY_INT),
									),
								)
							},
						],
						Some(SemanticMatchLeaf([], int_literal(0))),
					)
				},
			],
			Some(SemanticMatchLeaf([], int_literal(0))),
		),
		TY_INT,
	)

	flattens_to(
		match_expr,
		pure func(rewritten: CoreExpr):
			(
				not contains_tuple(rewritten)
				and minted_binder_ids(rewritten).is_empty()
				and subject_is(rewritten, "left")
			)
	)


-- The bindings of the first case of a tree's first test, when that case is a leaf.
private pure func first_case_bindings(tree: CoreSemanticMatchTree) -> List[CoreSemanticMatchBinding]:
	match tree:
		SemanticConstructorMatch(_, [first_case, ..._], _):
			match first_case.body:
				SemanticMatchLeaf(bindings, _):
					bindings
				_:
					[]
		_:
			[]


private pure func each_element_has_its_own_match(rewritten: CoreExpr) -> Option[Bool]:
	-- Both elements are parameters, so each is matched as itself.
	outer_subject ?= match_subject_variable(rewritten)
	outer_tree ?= match_tree(rewritten)
	cases: List[CoreSemanticConstructorMatchCase] = constructor_cases(outer_tree)
	inner_subjects: List[Option[CoreVar]] = cases.map(pure func(match_case: CoreSemanticConstructorMatchCase):
		leaf_body(match_case.body).and_then(match_subject_variable)
	)
	Some(
		core_var_equal(outer_subject, core_var("left"))
		and tests_root(outer_tree)
		and constructor_fallback(outer_tree).is_some()
		and cases.length() == 2
		and inner_subjects.all(pure func(inner: Option[CoreVar]):
			inner.map(pure func(variable: CoreVar): core_var_equal(variable, core_var("right"))).get_or(
				False,
			)
		)
	)


func test_or_pattern_subject_tests_each_element_with_its_own_match() -> Bool:
	-- `(Some(_), Some(_)) | (None, None) => True; _ => False` after or-pattern
	-- expansion: the second element is tested below each case of the first.
	shared_fallback: CoreSemanticMatchTree = SemanticMatchLeaf([], bool_literal(False))
	match_expr: CoreExpr = subject_match(
		two_options_subject(),
		SemanticConstructorMatch(
			field_accessor(0),
			[
				{
					constructor = "Some",
					body = SemanticConstructorMatch(
						field_accessor(1),
						[{ constructor = "Some", body = SemanticMatchLeaf([], bool_literal(True)) }],
						Some(shared_fallback),
					)
				},
				{
					constructor = "None",
					body = SemanticConstructorMatch(
						field_accessor(1),
						[{ constructor = "None", body = SemanticMatchLeaf([], bool_literal(True)) }],
						Some(shared_fallback),
					)
				},
			],
			Some(shared_fallback),
		),
		TY_BOOL,
	)

	flattens_to(match_expr, pure func(rewritten: CoreExpr):
		each_element_has_its_own_match(rewritten).get_or(False)
	)


func test_payload_binding_is_bound_below_the_test_that_proves_it() -> Bool:
	-- `(Some(x), True) => x`: the binding of `x` reads the first element's
	-- payload, so it moves to the first element's `Some` case, above the test
	-- of the second element.
	x: CoreVar = core_var_with_id("x", 1)
	subject: CoreExpr = tuple_of(
		[variable("maybe", TY_OPTION_INT), variable("flag", TY_BOOL)],
		TupleType([TY_OPTION_INT, TY_BOOL]),
	)
	match_expr: CoreExpr = subject_match(
		subject,
		SemanticConstructorMatch(
			field_accessor(0),
			[
				{
					constructor = "Some",
					body = SemanticLiteralMatch(
						field_accessor(1),
						[
							{
								literal = BoolLiteral(True),
								body = SemanticMatchLeaf(
									[
										borrow_binding(
											x,
											VariantFieldSemanticMatchAccessor(field_accessor(0), "Some", 0),
										),
									],
									variable_with_identity(x, TY_INT),
								)
							},
						],
						SemanticMatchLeaf([], int_literal(0)),
					)
				},
			],
			Some(SemanticMatchLeaf([], int_literal(0))),
		),
		TY_INT,
	)

	match flattened(match_expr):
		Ok(SemanticMatchExpr(_, outer_tree, _, _)):
			match first_case_bindings(outer_tree):
				[binding]:
					(
						core_var_equal(binding.variable, x)
						and match binding.accessor:
							VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Some", 0):
								True
							_:
								False
					)
				_:
					False
		_:
			False


private pure func body_is_second_element(rewritten: CoreExpr) -> Option[Bool]:
	-- The first element is a parameter and needs no binding; the second is a
	-- call, bound once to a minted local the body then names.
	second ?= let_binder(rewritten)
	second_rhs ?= let_rhs(rewritten)
	body ?= let_body(rewritten)
	Some(
		is_flatten_binder(second)
		and call_targets("right", second_rhs)
		and names_variable(second, body)
	)


func test_whole_element_binding_names_the_element() -> Bool:
	-- `(_, result) => result`: `result` is the second element itself.
	result: CoreVar = core_var_with_id("result", 1)
	match_expr: CoreExpr = subject_match(
		tuple_of([variable("left", TY_INT), call_of("right", [], TY_INT)], TY_PAIR),
		SemanticMatchLeaf(
			[borrow_binding(result, field_accessor(1))],
			variable_with_identity(result, TY_INT),
		),
		TY_INT,
	)

	flattens_to(match_expr, pure func(rewritten: CoreExpr):
		body_is_second_element(rewritten).get_or(False)
	)


func test_whole_subject_binding_only_taken_apart_leaves_no_tuple() -> Bool:
	whole_tuple: CoreVar = core_var_with_id("whole_tuple", 3)
	match_expr: CoreExpr = subject_match(
		two_options_subject(),
		SemanticConstructorMatch(
			field_accessor(0),
			[{ constructor = "Some", body = SemanticMatchLeaf([], int_literal(1)) }],
			Some(
				SemanticMatchLeaf(
					[borrow_binding(whole_tuple, RootSemanticMatchAccessor)],
					subject_match(
						tuple_field(variable_with_identity(whole_tuple, TY_TWO_OPTIONS), 1, TY_OPTION_INT),
						SemanticConstructorMatch(
							RootSemanticMatchAccessor,
							[{ constructor = "Some", body = SemanticMatchLeaf([], int_literal(2)) }],
							Some(SemanticMatchLeaf([], int_literal(0))),
						),
						TY_INT,
					),
				),
			),
		),
		TY_INT,
	)

	flattens_to(
		match_expr,
		pure func(rewritten: CoreExpr):
			not contains_tuple(rewritten) and not mentions(rewritten, whole_tuple)
	)


private pure func boxed_only_in_fallback(rewritten: CoreExpr) -> Option[Bool]:
	tree ?= match_tree(rewritten)
	some_case ?= constructor_cases(tree).get(0)
	some_body ?= leaf_body(some_case.body)
	fallback ?= constructor_fallback(tree)
	fallback_body ?= leaf_body(fallback)
	Some(not contains_tuple(some_body) and contains_tuple(fallback_body))


func test_whole_subject_binding_used_whole_is_boxed_only_where_it_is_used() -> Bool:
	whole_tuple: CoreVar = core_var_with_id("whole_tuple", 3)
	match_expr: CoreExpr = subject_match(
