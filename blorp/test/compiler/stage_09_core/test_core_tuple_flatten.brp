func test_resource_binding_shadow_keeps_the_box() -> Bool:
	-- A resource scope that binds `pair` again: a binder bound twice is never
	-- flattened, so the scoped read keeps meaning the scoped value.
	pair: CoreVar = core_var_with_id("pair", 1)
	expr: CoreExpr = LetExpr(
		pair,
		False,
		TY_PAIR,
		tuple_of([int_literal(1), int_literal(2)], TY_PAIR),
		ResourceScopeExpr(
			{
				variable = pair,
				typ = TY_PAIR,
				acquire = variable("open_pair", TY_PAIR),
				body = tuple_field(variable_with_identity(pair, TY_PAIR), 0, TY_INT),
				cleanup = int_literal(0)
			},
			TY_INT,
			synthetic_core_source_loc(),
		),
	)

	flattens_to(expr, pure func(rewritten: CoreExpr):
		contains_tuple(rewritten) and contains_field_of(rewritten, pair)
	)


func test_loop_binding_shadow_keeps_the_box() -> Bool:
	pair: CoreVar = core_var_with_id("pair", 1)
	expr: CoreExpr = LetExpr(
		pair,
		False,
		TY_PAIR,
		tuple_of([int_literal(1), int_literal(2)], TY_PAIR),
		ForListExpr(
			{
				binder = {
					variable = pair,
					typ = TY_PAIR,
					range_direction = RangeForwardOnly
				},
				layout = PointerListStorage,
				iterable = variable("pairs", NamedType("List", [TY_PAIR])),
				iterable_release_policy = NoReleasePolicy,
				body = tuple_field(variable_with_identity(pair, TY_PAIR), 0, TY_INT)
			},
			TY_INT,
			synthetic_core_source_loc(),
		),
	)

	flattens_to(expr, pure func(rewritten: CoreExpr):
		contains_tuple(rewritten) and contains_field_of(rewritten, pair)
	)


func test_whole_binding_of_a_matched_local_keeps_its_box() -> Bool:
	-- `match pair: whole => consume(whole)`: `whole` is `pair` again, so `pair`
	-- is used whole and keeps the box it was built into, instead of a box being
	-- rebuilt each time the leaf runs.
	pair: CoreVar = core_var_with_id("pair", 1)
	whole: CoreVar = core_var_with_id("whole", 2)
	expr: CoreExpr = LetExpr(
		pair,
		False,
		TY_PAIR,
		tuple_of([int_literal(1), int_literal(2)], TY_PAIR),
		subject_match(
			variable_with_identity(pair, TY_PAIR),
			SemanticMatchLeaf(
				[borrow_binding(whole, RootSemanticMatchAccessor)],
				call_of("consume", [variable_with_identity(whole, TY_PAIR)], TY_INT),
			),
			TY_INT,
		),
	)

	flattens_to(expr, pure func(rewritten: CoreExpr):
		match let_rhs(rewritten):
			Some(rhs):
				is_tuple_expr(rhs) and minted_binder_ids(rewritten).is_empty()
			None:
				False
	)


-- The message the pass fails with on `body`, as the body of function `broken`.
private pure func failure_message(body: CoreExpr) -> String:
	match flatten_tuples_program(program([function_decl("broken", 71, [], TY_INT, body)]), FIRST_MINTED_BINDER_ID):
		Ok(_):
			"no fault"
		Err(failure):
			tuple_flatten_failure_message(failure)


func test_tree_that_always_fails_is_an_internal_error() -> Bool:
	failure_message(subject_match(two_options_subject(), SemanticMatchFail, TY_INT)) == "tuple flattening in `broken`: a match on a tuple subject fails before testing anything"


func test_flattened_local_used_whole_is_an_internal_error() -> Bool:
	-- A use the analysis cannot see as a tuple (it is typed `Int` here) and the
	-- rewrite meets whole.
	pair: CoreVar = core_var_with_id("pair", 1)
	failure_message(
		LetExpr(
			pair,
			False,
			TY_PAIR,
			tuple_of([int_literal(1), int_literal(2)], TY_PAIR),
			add(variable_with_identity(pair, TY_INT), int_literal(1)),
		),
	) == "tuple flattening in `broken`: flattened tuple local `pair` is used whole"


func test_missing_element_type_is_an_internal_error() -> Bool:
	failure_message(
		tuple_field(tuple_of([int_literal(1), int_literal(2)], TY_INT), 0, TY_INT),
	) == "tuple flattening in `broken`: a built tuple's type has no element 0"


func test_fault_messages_name_the_binding_and_the_shape() -> Bool:
	x: CoreVar = core_var_with_id("x", 1)
	unproven: String = failure_message(
		subject_match(
			two_options_subject(),
			SemanticMatchLeaf(
				[borrow_binding(x, VariantFieldSemanticMatchAccessor(field_accessor(0), "Some", 0))],
				variable_with_identity(x, TY_INT),
			),
			TY_INT,
		),
	)
	outside: String = failure_message(
		LetExpr(
			core_var_with_id("pair", 2),
			False,
			TY_PAIR,
			tuple_of([int_literal(1), int_literal(2)], TY_PAIR),
			tuple_field(variable_with_identity(core_var_with_id("pair", 2), TY_PAIR), 2, TY_INT),
		),
	)
	(
		unproven == "tuple flattening in `broken`: match binding `x` reads into one element of a tuple subject with no test of that element above it"
		and outside == "tuple flattening in `broken`: a match on a tuple subject tests or binds the tuple outside its elements"
	)


-- Call expansion --------------------------------------------------------------


private pure func tuple_return_call_program(
	param_type: CoreType,
	return_type: CoreType,
	element: CoreExpr,
) -> CoreProgram:
	make_pair: CoreDecl = function_decl(
		"make_pair",
		42,
		[param("value", param_type)],
		return_type,
		tuple_of([element, int_literal(2)], return_type),
	)

	arg: CoreExpr = if param_type == TY_STRING:
		string_literal("hello")
	else:
		int_literal(1)

	call: CoreExpr = CallExpr(
		UserCall("make_pair", Some(42), []),
		variable("make_pair", function_type([param_type], return_type)),
		[arg],
		return_type,
		synthetic_core_source_loc(),
	)
	caller: CoreDecl = function_decl(
		"caller",
		43,
		[],
		param_type,
		immutable_let(
			"pair",
			return_type,
			call,
			tuple_field(variable("pair", return_type), 0, param_type),
		),
	)

	program([make_pair, caller])


private pure func tuple_return_call_with_local_program() -> CoreProgram:
	return_type: CoreType = TY_PAIR
	make_pair: CoreDecl = function_decl(
		"make_pair_with_local",
		44,
		[param("value", TY_INT)],
		return_type,
		immutable_let(
			"next",
			TY_INT,
			add(variable("value", TY_INT), int_literal(1)),
			tuple_of([variable("next", TY_INT), int_literal(2)], return_type),
		),
	)
	call: CoreExpr = CallExpr(
		UserCall("make_pair_with_local", Some(44), []),
		variable("make_pair_with_local", function_type([TY_INT], return_type)),
		[int_literal(1)],
		return_type,
		synthetic_core_source_loc(),
	)
	caller: CoreDecl = function_decl(
		"caller",
		45,
		[],
		TY_INT,
		immutable_let(
			"pair",
			return_type,
			call,
			tuple_field(variable("pair", return_type), 0, TY_INT),
		),
	)

	program([make_pair, caller])


private pure func caller_body(input: CoreProgram) -> Option[CoreExpr]:
	result ?= flattened_program(input)
	function_body_at(result.program, 1)


func test_unmanaged_tuple_return_call_is_expanded() -> Bool:
	match caller_body(tuple_return_call_program(TY_INT, TY_PAIR, variable("value", TY_INT))):
		Some(body):
			(
				not contains_tuple(body)
				and not contains_call_to(body, "make_pair")
				and not contains_field_of(body, core_var("pair"))
			)
		None:
			False


func test_unmanaged_tuple_return_with_local_is_expanded() -> Bool:
	match caller_body(tuple_return_call_with_local_program()):
		Some(body):
			(
				not contains_tuple(body)
				and not contains_call_to(body, "make_pair_with_local")
				and not contains_field_of(body, core_var("pair"))
			)
		None:
			False


func test_managed_tuple_return_call_keeps_its_box() -> Bool:
	match caller_body(
		tuple_return_call_program(TY_STRING, TY_STRING_PAIR, variable("value", TY_STRING)),
	):
		Some(body):
			contains_call_to(body, "make_pair") and contains_field_of(body, core_var("pair"))
		None:
			False


func test_expansion_reserves_the_ids_it_minted() -> Bool:
	-- The caller binds the argument and the literal second element; the first
	-- element is the argument's local itself. The callee mints none.
	match flattened_program(tuple_return_call_program(TY_INT, TY_PAIR, variable("value", TY_INT))):
		Some(result):
			result.ids_used == 2
		None:
			False


private pure func tuple_return_after_scalar_let_program() -> CoreProgram:
	local: CoreVar = core_var("local")
	make_pair: CoreDecl = function_decl(
		"make_pair_after_let",
		44,
		[],
		TY_PAIR,
		LetExpr(
			local,
			False,
			TY_INT,
			int_literal(40),
			tuple_of([variable_with_identity(local, TY_INT), int_literal(2)], TY_PAIR),
		),
	)
	call: CoreExpr = CallExpr(
		UserCall("make_pair_after_let", Some(44), []),
		variable("make_pair_after_let", function_type([], TY_PAIR)),
		[],
		TY_PAIR,
		synthetic_core_source_loc(),
	)
	caller: CoreDecl = function_decl(
		"caller_after_let",
		45,
		[],
		TY_INT,
		immutable_let(
			"pair",
			TY_PAIR,
			call,
			tuple_field(variable("pair", TY_PAIR), 0, TY_INT),
		),
	)

	program([make_pair, caller])


private pure func is_int_literal(expr: CoreExpr, value: Int) -> Bool:
	match expr:
		LiteralExpr(literal, _, _):
			match literal:
				IntLiteral(found):
					found == value
				_:
					False
		_:
			False


private pure func expanded_scalar_let(body: CoreExpr) -> Option[Bool]:
	-- `let local = 40; let second = 2; local`: the first element is the
	-- callee's local itself, and the read of it is that local.
	local ?= let_binder(body)
	local_rhs ?= let_rhs(body)
	after_local ?= let_body(body)
	second_rhs ?= let_rhs(after_local)
	result ?= let_body(after_local)
	Some(
		is_int_literal(local_rhs, 40)
		and is_int_literal(second_rhs, 2)
		and names_variable(local, result)
	)


func test_tuple_return_summary_traverses_scalar_let() -> Bool:
	match caller_body(tuple_return_after_scalar_let_program()):
		Some(body):
			expanded_scalar_let(body).get_or(False)
		None:
			False


-- Ownership contracts -----------------------------------------------------------


private pure func consumed_parameters(env: PerceusEnv, name: String, def_id: Int) -> Option[List[Int]]:
	callable_id ?= lookup_ownership_callable_id(env.callables, name, Some(def_id))
	callable_consumed_args(env, callable_id)


private pure func contract_program() -> CoreProgram:
	text: CoreExpr = variable("text", TY_STRING)
	-- A parameter placed in a tuple the function returns: the tuple is a box
	-- in increment 1, so the parameter is stored and owned before and after.
	result_element: CoreDecl = function_decl(
		"result_element",
		61,
		[param("text", TY_STRING)],
		TY_STRING_PAIR,
		tuple_of([text, int_literal(1)], TY_STRING_PAIR),
	)
	-- A parameter placed in a match subject: before flattening the subject
	-- tuple stores it; after, the match reads the parameter itself.
	subject_element: CoreDecl = function_decl(
		"subject_element",
		62,
		[param("text", TY_STRING), param("flag", TY_INT)],
		TY_INT,
		subject_match(
			tuple_of([text, variable("flag", TY_INT)], TY_STRING_PAIR),
			SemanticLiteralMatch(
				field_accessor(1),
				[{ literal = IntLiteral(0), body = SemanticMatchLeaf([], int_literal(1)) }],
				SemanticMatchLeaf([], int_literal(2)),
			),
			TY_INT,
		),
	)
	program([result_element, subject_element])


-- The result element's parameter keeps its contract (owned, index 0); the
-- subject element's parameter shifts from owned to borrowed, the shift
-- increment 1 expects (docs/VALUE_TUPLES_AND_STATE_HANDOFF.md, section 8).
private pure func contracts_shift_only_for_subject_elements() -> Option[Bool]:
	before: CoreProgram = contract_program()
	after ?= flattened_program(before)
	before_env: PerceusEnv = infer_ownership_contracts(before).env
	after_env: PerceusEnv = infer_ownership_contracts(after.program).env
	result_before ?= consumed_parameters(before_env, "result_element", 61)
	result_after ?= consumed_parameters(after_env, "result_element", 61)
	subject_before ?= consumed_parameters(before_env, "subject_element", 62)
	subject_after ?= consumed_parameters(after_env, "subject_element", 62)
	Some(
		result_before == [0]
		and result_after == [0]
		and subject_before == [0]
		and subject_after.is_empty()
	)


func test_result_element_keeps_its_contract_and_subject_element_is_borrowed() -> Bool:
	contracts_shift_only_for_subject_elements().get_or(False)


-- Traversal -------------------------------------------------------------------


private pure func deep_left_logical_expr() -> CoreExpr:
	var result: CoreExpr = bool_literal(True)
	var index: Int = 0

	while index < DEEP_LOGICAL_LENGTH:
		result = LogicalExpr(
			AndOp,
			result,
			bool_literal(index % 2 == 0),
			TY_BOOL,
			synthetic_core_source_loc(),
		)
		index += 1

	result


private pure func left_logical_depth(expr: CoreExpr) -> Int:
	var current: CoreExpr = expr
	var depth: Int = 0
	var valid: Bool = True

	while valid:
		match current:
			LogicalExpr(AndOp, left, _, _, _):
				depth += 1
				current = left
			LiteralExpr(BoolLiteral(_), _, _):
				break
			_:
				valid = False

	if valid:
		depth
	else:
		-1


func test_deep_logical_rewrite_is_stack_bounded() -> Bool:
	flattens_to(
		deep_left_logical_expr(),
		pure func(rewritten: CoreExpr): left_logical_depth(rewritten) == DEEP_LOGICAL_LENGTH,
	)


func test_logical_rewrite_mints_left_to_right() -> Bool:
	bool_pair_type: CoreType = TupleType([TY_BOOL, TY_BOOL])
	left: CoreExpr = tuple_field(
		tuple_of([bool_literal(True), bool_literal(False)], bool_pair_type),
		0,
		TY_BOOL,
	)
	right: CoreExpr = tuple_field(
		tuple_of([bool_literal(False), bool_literal(True)], bool_pair_type),
		1,
		TY_BOOL,
	)

	flattens_to(
		LogicalExpr(AndOp, left, right, TY_BOOL, synthetic_core_source_loc()),
		pure func(rewritten: CoreExpr): minted_binder_ids(rewritten) == [-1, -2, -3, -4],
	)


func test_deep_logical_chain_is_rewritten_iteratively() -> Bool:
	var expression: CoreExpr = bool_literal(True)

	for index in 0..256:
		expression = LogicalExpr(
			AndOp,
			expression,
			bool_literal(index >= 0),
			TY_BOOL,
			synthetic_core_source_loc(),
		)

	match flattened(expression):
		Ok(LogicalExpr(_, _, _, _, _)):
			True
		_:
			False


func test_reuses_expression_without_tuple_shapes() -> Bool:
	-- No tuple to flatten, so the whole tree comes back as the same allocation.
	body: CoreExpr = immutable_let(
		"total",
		TY_INT,
		add(int_literal(1), int_literal(2)),
		SeqExpr(int_literal(3), variable("total", TY_INT)),
	)

	flattens_to(body, pure func(rewritten: CoreExpr): same_object(rewritten, body))


func test_rebuilds_only_the_spine_to_a_flattened_tuple() -> Bool:
	untouched: CoreExpr = int_literal(7)
	replaced: CoreExpr = tuple_let(
		"pair",
		TY_PAIR,
		[int_literal(1), int_literal(2)],
		tuple_field(variable("pair", TY_PAIR), 0, TY_INT),
	)

	match flattened(SeqExpr(untouched, replaced)):
		Ok(SeqExpr(rewritten_first, rewritten_second)):
			same_object(rewritten_first, untouched) and not same_object(rewritten_second, replaced)
		_:
			False


