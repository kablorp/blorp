func test_subject_elements_are_bound_in_written_order() -> Bool:
	match_expr: CoreExpr = subject_match(
		tuple_of([call_of("first", [], TY_INT), call_of("second", [], TY_INT)], TY_PAIR),
		SemanticLiteralMatch(
			field_accessor(1),
			[{ literal = IntLiteral(0), body = SemanticMatchLeaf([], int_literal(1)) }],
			SemanticMatchLeaf([], int_literal(2)),
		),
		TY_INT,
	)

	match flattened(match_expr):
		Ok(LetExpr(first_binder, _, _, first_rhs, LetExpr(second_binder, _, _, second_rhs, _))):
			(
				call_targets("first", first_rhs)
				and call_targets("second", second_rhs)
				and first_binder.id == -1
				and second_binder.id == -2
			)
		_:
			False


private pure func boxed_element_read_at_leaf(rewritten: CoreExpr, a: CoreVar) -> Option[Bool]:
	subject ?= match_subject_variable(rewritten)
	tree ?= match_tree(rewritten)
	binding ?= leaf_bindings(tree).get(0)
	Some(
		core_var_equal(subject, core_var("boxed"))
		and core_var_equal(binding.variable, a)
		and match binding.accessor:
			TupleFieldSemanticMatchAccessor(parent, 0):
				is_root(parent)
			_:
				False
	)


func test_read_of_a_boxed_element_is_bound_at_its_leaf() -> Bool:
	-- `((a, _), _) => a` where the first element is a parameter holding a
	-- boxed pair: `a` reads that box with no test, so it is bound at the leaf.
	a: CoreVar = core_var_with_id("a", 1)
	match_expr: CoreExpr = subject_match(
		tuple_of([variable("boxed", TY_PAIR), variable("other", TY_INT)], TY_PAIR_AND_INT),
		SemanticMatchLeaf(
			[borrow_binding(a, TupleFieldSemanticMatchAccessor(field_accessor(0), 0))],
			variable_with_identity(a, TY_INT),
		),
		TY_INT,
	)

	flattens_to(match_expr, pure func(rewritten: CoreExpr):
		boxed_element_read_at_leaf(rewritten, a).get_or(False)
	)


func test_mutable_element_is_bound_to_a_copy() -> Bool:
	-- `var count = 0; match (count, flag):` keeps the value `count` had when
	-- the subject was built, so it is copied; `flag` never changes and is
	-- matched as itself.
	count: CoreVar = core_var_with_id("count", 1)
	expr: CoreExpr = LetExpr(
		count,
		True,
		TY_INT,
		int_literal(0),
		subject_match(
			tuple_of([variable_with_identity(count, TY_INT), variable("flag", TY_INT)], TY_PAIR),
			SemanticLiteralMatch(
				field_accessor(1),
				[{ literal = IntLiteral(0), body = SemanticMatchLeaf([], int_literal(1)) }],
				SemanticMatchLeaf([], int_literal(2)),
			),
			TY_INT,
		),
	)

	flattens_to(expr, pure func(rewritten: CoreExpr):
		(
			minted_binder_ids(rewritten) == [-1]
			and let_body(rewritten)
				.and_then(let_rhs)
				.map(pure func(copied: CoreExpr): names_variable(count, copied))
				.get_or(False)
		)
	)


func test_repeated_row_binding_is_bound_once() -> Bool:
	-- `(Err(e), _) => e` repeated below both outcomes of the second element's
	-- test reads the same place: one binding at the first element's case.
	e: CoreVar = core_var_with_id("e", 1)
	payload: CoreSemanticMatchAccessor = VariantFieldSemanticMatchAccessor(field_accessor(0), "Err", 0)
	repeated_leaf: CoreSemanticMatchTree = SemanticMatchLeaf(
		[borrow_binding(e, payload)],
		variable_with_identity(e, TY_INT),
	)
	match_expr: CoreExpr = subject_match(
		two_options_subject(),
		SemanticConstructorMatch(
			field_accessor(0),
			[
				{
					constructor = "Err",
					body = SemanticConstructorMatch(
						field_accessor(1),
						[{ constructor = "Err", body = repeated_leaf }],
						Some(repeated_leaf),
					)
				},
			],
			Some(SemanticMatchLeaf([], int_literal(0))),
		),
		TY_INT,
	)

	flattens_to(match_expr, pure func(rewritten: CoreExpr):
		match match_tree(rewritten):
			Some(tree):
				first_case_bindings(tree).length() == 1
			None:
				False
	)


-- How many matches with a single leaf, which bind at a leaf, `expr` contains.
private pure func leaf_only_matches(expr: CoreExpr) -> Int:
	var count: Int = match expr:
		SemanticMatchExpr(_, tree, _, _):
			match tree:
				SemanticMatchLeaf(bindings, _):
					if bindings.is_empty():
						0
					else:
						1
				_:
					0
		_:
			0

	for child in immediate_core_expr_children(expr):
		count += leaf_only_matches(child)

	count


private pure func first_case_binds_nothing(expr: CoreExpr) -> Bool:
	match match_tree(expr):
		Some(tree):
			first_case_bindings(tree).is_empty()
		None:
			False


func test_or_pattern_binder_at_two_places_is_bound_at_its_leaves() -> Bool:
	-- `(Some((a, _)), 0) | (Some((_, a)), _) => a`: `a` reads two places of the
	-- first element, so it cannot share the `Some` case; each leaf binds it.
	a: CoreVar = core_var_with_id("a", 1)
	pair_payload: CoreSemanticMatchAccessor = VariantFieldSemanticMatchAccessor(field_accessor(0), "Some", 0)
	subject: CoreExpr = tuple_of(
		[variable("maybe_pair", NamedType("Option", [TY_PAIR])), variable("flag", TY_INT)],
		TupleType([NamedType("Option", [TY_PAIR]), TY_INT]),
	)
	match_expr: CoreExpr = subject_match(
		subject,
		SemanticConstructorMatch(
			field_accessor(0),
			[
				{
					constructor = "Some",
					body = SemanticLiteralMatch(
						field_accessor(1),
						[
							{
								literal = IntLiteral(0),
								body = SemanticMatchLeaf(
									[borrow_binding(a, TupleFieldSemanticMatchAccessor(pair_payload, 0))],
									variable_with_identity(a, TY_INT),
								)
							},
						],
						SemanticMatchLeaf(
							[borrow_binding(a, TupleFieldSemanticMatchAccessor(pair_payload, 1))],
							variable_with_identity(a, TY_INT),
						),
					)
				},
			],
			Some(SemanticMatchLeaf([], int_literal(0))),
		),
		TY_INT,
	)

	flattens_to(match_expr, pure func(rewritten: CoreExpr):
		first_case_binds_nothing(rewritten) and leaf_only_matches(rewritten) == 2
	)


func test_payload_binding_with_no_test_of_its_element_is_an_internal_error() -> Bool:
	x: CoreVar = core_var_with_id("x", 1)
	match_expr: CoreExpr = subject_match(
