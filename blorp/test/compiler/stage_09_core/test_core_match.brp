			), raw_match_case(
				ConstructorPattern("Some", [ListPattern([], None)]),
				int_expr(20),
			), raw_match_case(
				ConstructorPattern("None", []),
				int_expr(30),
			), raw_match_case(WildcardPattern, int_expr(40))],
	)

	match result:
		Some(SemanticConstructorMatch(_, cases, Some(_))):
			match cases.get(0):
				Some(first_case):
					match first_case.body:
						SemanticLengthMatch(VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Some", 0), _, _, _):
							True
						_:
							False
				None:
					False
		_:
			False


pure func test_program_compiles_nested_matches_bottom_up() -> Bool:
	inner_match = RawMatchExpr(
		variable_expr(
			"inner",
			int_type(),
		),
		[
			raw_match_case(LiteralPattern(IntLiteral(1)), int_expr(10)),
			raw_match_case(WildcardPattern, int_expr(20)),
		],
		int_type(),
		SyntheticSourceLoc,
	)
	outer_match = RawMatchExpr(
		variable_expr(
			"outer",
			int_type(),
		),
		[
			raw_match_case(LiteralPattern(IntLiteral(0)), inner_match),
			raw_match_case(WildcardPattern, int_expr(30)),
		],
		int_type(),
		SyntheticSourceLoc,
	)
	body = first_function_body(compile_program(program_with_body(outer_match)))

	match body:
		Some(SemanticMatchExpr(_, SemanticLiteralMatch(_, cases, _), _, _)):
			match cases.get(0):
				Some(first_case):
					match first_case.body:
						SemanticMatchLeaf(_, SemanticMatchExpr(_, SemanticLiteralMatch(_, _, _), _, _)):
							True
						_:
							False
				None:
					False
		_:
			False


pure func test_program_normalizes_before_direct_constructor_fusion() -> Bool:
	raw_match = RawMatchExpr(
		constructor_call(
			"None",
			[],
		),
		[
			raw_match_case(NamePattern("None"), int_expr(7)),
			raw_match_case(WildcardPattern, int_expr(9)),
		],
		int_type(),
		SyntheticSourceLoc,
	)

	match first_function_body(compile_program(program_with_body(raw_match))):
		Some(LiteralExpr(IntLiteral(7), _, _)):
			True
		_:
			False


tests: TestSuite = {
	description = "Blorp compiler Core match",
	tests = [
		("normalizes nested builtin constructors", test_normalizes_nested_builtin_constructors),
		("fuses direct constructor binding", test_fuses_direct_constructor_binding),
		(
			"fuses direct constructor wildcard fallback",
			test_fuses_direct_constructor_wildcard_fallback,
		),
		(
			"non-simple matching constructor blocks fusion",
			test_non_simple_matching_constructor_blocks_fusion,
		),
		("expands or-pattern before direct fusion", test_expands_or_pattern_before_direct_fusion),
		("does not fuse non-constructor call", test_does_not_fuse_non_constructor_call),
		("compiles catchall binding leaf", test_compiles_catchall_binding_leaf),
		("compiles literal switch with fallback", test_compiles_literal_switch_with_fallback),
		("compiles flat constructor switch", test_compiles_flat_constructor_switch),
		(
			"constructor grouping preserves first occurrence order",
			test_constructor_grouping_preserves_first_occurrence_order,
		),
		("compiles constructor literal payload", test_compiles_constructor_literal_payload),
		("compiles nested constructor payload", test_compiles_nested_constructor_payload),
		(
			"constructor payload catchall shadows later cases",
			test_constructor_payload_catchall_shadows_later_cases,
		),
		("compiles constructor tuple payload", test_compiles_constructor_tuple_payload),
		("compiles simple tuple bindings", test_compiles_simple_tuple_bindings),
		(
			"preserves all-pattern binding order and modes",
			test_preserves_all_pattern_binding_order_and_modes,
		),
		("compiles tuple literal columns", test_compiles_tuple_literal_columns),
		("compiles tuple constructor columns", test_compiles_tuple_constructor_columns),
		(
			"compiles tuple constructor and list columns",
			test_compiles_tuple_constructor_and_list_columns,
		),
		("compiles tuple with two list columns", test_compiles_tuple_with_two_list_columns),
		("preserves list spread source order", test_preserves_list_spread_source_order),
		("compiles list literal elements", test_compiles_list_literal_elements),
		("compiles list constructor elements", test_compiles_list_constructor_elements),
		("compiles list tuple elements", test_compiles_list_tuple_elements),
		(
			"ordered list match current fallback duplication count",
			test_ordered_list_match_current_fallback_duplication_count,
		),
		("omits unused list spread binding", test_omits_unused_list_spread_binding),
		("preserves used list spread binding", test_preserves_used_list_spread_binding),
		("omits list spread shadowed by let body", test_omits_list_spread_shadowed_by_let_body),
		("preserves list spread used by let rhs", test_preserves_list_spread_used_by_let_rhs),
		(
			"compiles constructor wrapped list pattern",
			test_compiles_constructor_wrapped_list_pattern,
		),
		(
			"program compiles nested matches bottom up",
			test_program_compiles_nested_matches_bottom_up,
		),
		(
			"program normalizes before direct constructor fusion",
			test_program_normalizes_before_direct_constructor_fusion,
		),
	]
}
