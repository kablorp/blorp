				]), int_expr(10)), raw_match_case(WildcardPattern, int_expr(20))],
	)

	match result:
		Some(SemanticConstructorMatch(TupleFieldSemanticMatchAccessor(RootSemanticMatchAccessor, 0), cases, _)):
			match cases.get(0):
				Some(first_case):
					first_case.constructor == "Some"
				None:
					False
		_:
			False


