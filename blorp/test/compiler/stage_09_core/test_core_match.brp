import:
	../../../src/compiler/stage_09_core/ir:
		CoreCallKind(UnknownCall),
		CoreDecl(FunctionDecl),
		CoreExpr(CallExpr, LetExpr, LiteralExpr, RawMatchExpr, SemanticMatchExpr, SeqExpr, VarExpr),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreLiteral(IntLiteral),
		CoreMatchBindingMode(MatchBorrowBindingMode, MatchOwnBindingMode),
		CorePattern(
			ConstructorPattern,
			ListPattern,
			LiteralPattern,
			NamePattern,
			OrPattern,
			QualifiedConstructorPattern,
			TuplePattern,
			WildcardPattern,
		),
		CoreProgram,
		CoreRawMatchCase,
		CoreSemanticMatchAccessor(
			ListElementSemanticMatchAccessor,
			ListSpreadSemanticMatchAccessor,
			RootSemanticMatchAccessor,
			TupleFieldSemanticMatchAccessor,
			VariantFieldSemanticMatchAccessor,
		),
		CoreSemanticMatchTree(
			SemanticConstructorMatch,
			SemanticLengthMatch,
			SemanticLiteralMatch,
			SemanticMatchFail,
			SemanticMatchLeaf,
		),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(FunctionType, NamedType),
		CoreVar,
	../../../src/compiler/stage_09_core/match_lowering:
		collect_match_constructor_names,
		compile_match_cases,
		compile_program,
		normalize_match_pattern,
		try_fuse_direct_constructor_match,
	test: TestSuite


private pure func int_type() -> CoreType:
	NamedType("Int", [])


private pure func option_int_type() -> CoreType:
	NamedType("Option", [int_type()])


private pure func list_int_type() -> CoreType:
	NamedType("List", [int_type()])


private pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


private pure func int_expr(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), int_type(), SyntheticSourceLoc)


private pure func variable_expr(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, SyntheticSourceLoc)


private pure func constructor_call(name: String, args: List[CoreExpr]) -> CoreExpr:
	callee_type: CoreType = FunctionType(
		False,
		args.map(func(_): int_type()),
		option_int_type(),
	)
	CallExpr(
		UnknownCall,
		VarExpr(core_var(name), callee_type, SyntheticSourceLoc),
		args,
		option_int_type(),
		SyntheticSourceLoc,
	)


private pure func empty_program() -> CoreProgram:
	{
		decls = [],
		foreign_includes = []
	}


private pure func raw_match_case(pattern: CorePattern, body: CoreExpr) -> CoreRawMatchCase:
	{
		pattern = pattern,
		body = body
	}


private pure func program_with_body(body: CoreExpr) -> CoreProgram:
	function_info: CoreFunction = {
		name = "match_test",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 1,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(function_info)],
		foreign_includes = []
	}


private pure func leaf_has_single_binding_named(tree: CoreSemanticMatchTree, name: String) -> Bool:
	match tree:
		SemanticMatchLeaf(bindings, _):
			match bindings:
				[binding]:
					binding.variable.name == name
				_:
					False
		_:
			False


private pure func tree_has_list_spread_binding(tree: CoreSemanticMatchTree, name: String) -> Bool:
	match tree:
		SemanticMatchLeaf(bindings, _):
			var found: Bool = False

			for binding in bindings:
				if binding.variable.name == name:
					match binding.accessor:
						ListSpreadSemanticMatchAccessor(_, _):
							found = True
							break
						_:
							void

			found
		SemanticConstructorMatch(_, cases, fallback):
			var found: Bool = False

			for match_case in cases:
				if tree_has_list_spread_binding(match_case.body, name):
					found = True
					break

			match fallback:
				Some(fallback_tree):
					found or tree_has_list_spread_binding(fallback_tree, name)
				None:
					found
		SemanticLiteralMatch(_, cases, fallback):
			var found: Bool = False

			for match_case in cases:
				if tree_has_list_spread_binding(match_case.body, name):
					found = True
					break

			found or tree_has_list_spread_binding(fallback, name)
		SemanticLengthMatch(_, cases, geq, fallback):
			var found: Bool = False

			for match_case in cases:
				if tree_has_list_spread_binding(match_case.body, name):
					found = True
					break

			if not found:
				match geq:
					Some(geq_case):
						found = tree_has_list_spread_binding(geq_case.body, name)
					None:
						void

			if not found:
				match fallback:
					Some(fallback_tree):
						found = tree_has_list_spread_binding(fallback_tree, name)
					None:
						void

			found
		SemanticMatchFail:
			False


private pure func leaf_has_all_pattern_binding_order(tree: CoreSemanticMatchTree) -> Bool:
	match tree:
		SemanticMatchLeaf(bindings, _):
			first_matches: Bool = match bindings.get(0):
				Some(first):
					match first.accessor:
						VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Outer", 0):
							first.variable.name == "first" and first.mode == MatchBorrowBindingMode
						_:
							False
				None:
					False

			second_matches: Bool = match bindings.get(4):
				Some(second):
					match second.accessor:
						VariantFieldSemanticMatchAccessor(VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Outer", 1), "Inner", 0):
							(
								second.variable.name == "second"
								and second.mode == MatchBorrowBindingMode
							)
						_:
							False
				None:
					False

			third_matches: Bool = match bindings.get(1):
				Some(third):
					match third.accessor:
						TupleFieldSemanticMatchAccessor(VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Outer", 2), 0):
							third.variable.name == "third" and third.mode == MatchBorrowBindingMode
						_:
							False
				None:
					False

			fourth_matches: Bool = match bindings.get(2):
				Some(fourth):
					match fourth.accessor:
						ListElementSemanticMatchAccessor(VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Outer", 3), 0):
							(
								fourth.variable.name == "fourth"
								and fourth.mode == MatchBorrowBindingMode
							)
						_:
							False
				None:
					False

			rest_matches: Bool = match bindings.get(3):
				Some(rest):
					match rest.accessor:
						ListSpreadSemanticMatchAccessor(VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Outer", 3), 1):
							rest.variable.name == "rest" and rest.mode == MatchOwnBindingMode
						_:
							False
				None:
					False

			(
				bindings.length() == 5
				and bindings.map(
					func(
						binding,
					): binding.variable.name,
				) == ["first", "third", "fourth", "rest", "second"]
				and first_matches
				and second_matches
				and third_matches
				and fourth_matches
				and rest_matches
			)
		SemanticMatchFail:
			False
		SemanticConstructorMatch(_, cases, fallback):
			var found: Bool = cases.any(
				func(match_case): leaf_has_all_pattern_binding_order(match_case.body),
			)

			match fallback:
				Some(fallback_tree):
					found or leaf_has_all_pattern_binding_order(fallback_tree)
				None:
					found
		SemanticLiteralMatch(_, cases, fallback):
			(
				cases.any(func(match_case): leaf_has_all_pattern_binding_order(match_case.body))
				or leaf_has_all_pattern_binding_order(fallback)
			)
		SemanticLengthMatch(_, cases, geq, fallback):
			var found: Bool = cases.any(
				func(match_case): leaf_has_all_pattern_binding_order(match_case.body),
			)

			match geq:
				Some(geq_case):
					found = found or leaf_has_all_pattern_binding_order(geq_case.body)
				None:
					void

			match fallback:
				Some(fallback_tree):
					found or leaf_has_all_pattern_binding_order(fallback_tree)
				None:
					found


private pure func exact_prefix_list_pattern(length: Int) -> CorePattern:
	var patterns: List[CorePattern] = []
	var index: Int = 0

	while index < length:
		patterns = patterns.append(LiteralPattern(IntLiteral(index)))
		index += 1

	ListPattern(patterns, None)


private pure func ordered_list_match_cases(
	arm_count: Int,
	fallback_value: Int,
) -> List[CoreRawMatchCase]:
	var cases: List[CoreRawMatchCase] = []
	var index: Int = 0

	while index < arm_count:
		cases = cases.append(raw_match_case(exact_prefix_list_pattern(index), int_expr(index)))
		index += 1

	cases.append(raw_match_case(WildcardPattern, int_expr(fallback_value)))


private pure func count_semantic_leaf_int_body(tree: CoreSemanticMatchTree, value: Int) -> Int:
	match tree:
		SemanticMatchLeaf(_, LiteralExpr(IntLiteral(found), _, _)):
			if found == value:
				1
			else:
				0
		SemanticMatchLeaf(_, _):
			0
		SemanticMatchFail:
			0
		SemanticConstructorMatch(_, cases, fallback):
			var count: Int = 0

			for match_case in cases:
				count += count_semantic_leaf_int_body(match_case.body, value)

			match fallback:
				Some(fallback_tree):
					count + count_semantic_leaf_int_body(fallback_tree, value)
				None:
					count
		SemanticLiteralMatch(_, cases, fallback):
			var count: Int = count_semantic_leaf_int_body(fallback, value)

			for match_case in cases:
				count += count_semantic_leaf_int_body(match_case.body, value)

			count
		SemanticLengthMatch(_, cases, geq, fallback):
			var count: Int = 0

			for match_case in cases:
				count += count_semantic_leaf_int_body(match_case.body, value)

			match geq:
				Some(geq_case):
					count += count_semantic_leaf_int_body(geq_case.body, value)
				None:
					void

			match fallback:
				Some(fallback_tree):
					count + count_semantic_leaf_int_body(fallback_tree, value)
				None:
					count


private pure func ordered_list_fallback_leaf_count(
	arm_count: Int,
	fallback_value: Int,
) -> Option[Int]:
	match compile_match_cases(
		collect_match_constructor_names(empty_program()),
		ordered_list_match_cases(arm_count, fallback_value),
	):
		Some(tree):
			Some(count_semantic_leaf_int_body(tree, fallback_value))
		None:
			None


private pure func first_function_body(program: CoreProgram) -> Option[CoreExpr]:
	match program.decls.get(0):
		Some(FunctionDecl(function_info)):
			function_info.body
		_:
			None


pure func test_normalizes_nested_builtin_constructors() -> Bool:
	normalized: CorePattern = normalize_match_pattern(
		collect_match_constructor_names(empty_program()),
		ListPattern(
			[NamePattern("Some"), NamePattern("value")],
			Some(NamePattern("None")),
		),
	)

	match normalized:
		ListPattern([ConstructorPattern("Some", []), NamePattern("value")], Some(ConstructorPattern("None", []))):
			True
		_:
			False


pure func test_fuses_direct_constructor_binding() -> Bool:
	arg: CoreExpr = int_expr(42)
	body: CoreExpr = int_expr(7)
	result: Option[CoreExpr] = try_fuse_direct_constructor_match(
		collect_match_constructor_names(empty_program()),
		constructor_call(
			"Some",
			[arg],
		),
		[raw_match_case(
				ConstructorPattern("Some", [NamePattern("value")]),
				body,
			), raw_match_case(WildcardPattern, int_expr(0))],
	)

	match result:
		Some(LetExpr(variable, False, NamedType("Int", []), LiteralExpr(IntLiteral(42), _, _), LiteralExpr(IntLiteral(7), _, _))):
			variable.name == "value"
		_:
			False


pure func test_fuses_direct_constructor_wildcard_fallback() -> Bool:
	result: Option[CoreExpr] = try_fuse_direct_constructor_match(
		collect_match_constructor_names(empty_program()),
		constructor_call(
			"Some",
			[int_expr(42)],
		),
		[raw_match_case(
				ConstructorPattern("None", []),
				int_expr(1),
			), raw_match_case(WildcardPattern, int_expr(2))],
	)

	match result:
		Some(SeqExpr(LiteralExpr(IntLiteral(42), _, _), LiteralExpr(IntLiteral(2), _, _))):
			True
		_:
			False


pure func test_non_simple_matching_constructor_blocks_fusion() -> Bool:
	result: Option[CoreExpr] = try_fuse_direct_constructor_match(
		collect_match_constructor_names(empty_program()),
		constructor_call(
			"Some",
			[int_expr(42)],
		),
		[raw_match_case(
				ConstructorPattern("Some", [LiteralPattern(IntLiteral(42))]),
				int_expr(1),
			), raw_match_case(WildcardPattern, int_expr(2))],
	)

	match result:
		None:
			True
		Some(_):
			False


pure func test_expands_or_pattern_before_direct_fusion() -> Bool:
	result: Option[CoreExpr] = try_fuse_direct_constructor_match(
		collect_match_constructor_names(empty_program()),
		constructor_call("Some", [int_expr(42)]),
		[raw_match_case(OrPattern([
					ConstructorPattern("None", []),
					ConstructorPattern("Some", [NamePattern("value")]),
				]), int_expr(7))],
	)

	match result:
		Some(LetExpr(variable, False, _, _, _)):
			variable.name == "value"
		_:
			False


pure func test_does_not_fuse_non_constructor_call() -> Bool:
	result: Option[CoreExpr] = try_fuse_direct_constructor_match(
		collect_match_constructor_names(empty_program()),
		constructor_call("make_value", [int_expr(42)]),
		[raw_match_case(
				ConstructorPattern("Some", [NamePattern("value")]),
				int_expr(7),
			)],
	)

	match result:
		None:
			True
		Some(_):
			False


pure func test_compiles_catchall_binding_leaf() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(NamePattern("value"), int_expr(7))],
	)

	match result:
		Some(SemanticMatchLeaf([binding], LiteralExpr(IntLiteral(7), _, _))):
			match binding.accessor:
				RootSemanticMatchAccessor:
					binding.variable.name == "value"
				_:
					False
		_:
			False


pure func test_compiles_literal_switch_with_fallback() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[
			raw_match_case(LiteralPattern(IntLiteral(1)), int_expr(10)),
			raw_match_case(LiteralPattern(IntLiteral(2)), int_expr(20)),
			raw_match_case(WildcardPattern, int_expr(30)),
		],
	)

	match result:
		Some(SemanticLiteralMatch(RootSemanticMatchAccessor, cases, fallback)):
			first_matches: Bool = match cases.get(0):
				Some(first_case):
					match first_case.literal:
						IntLiteral(1):
							match first_case.body:
								SemanticMatchLeaf([], LiteralExpr(IntLiteral(10), _, _)):
									True
								_:
									False
						_:
							False
				None:
					False

			fallback_matches: Bool = match fallback:
				SemanticMatchLeaf([], LiteralExpr(IntLiteral(30), _, _)):
					True
				_:
					False

			cases.length() == 2 and first_matches and fallback_matches
		_:
			False


pure func test_compiles_flat_constructor_switch() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(
				ConstructorPattern("Some", [NamePattern("value")]),
				int_expr(1),
			), raw_match_case(
				ConstructorPattern("None", []),
				int_expr(2),
			), raw_match_case(WildcardPattern, int_expr(3))],
	)

	match result:
		Some(SemanticConstructorMatch(RootSemanticMatchAccessor, cases, Some(_))):
			match cases.get(0):
				Some(first_case):
					if first_case.constructor != "Some":
						False
					else:
						match first_case.body:
							SemanticMatchLeaf([binding], LiteralExpr(IntLiteral(1), _, _)):
								match binding.accessor:
									VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Some", 0):
										binding.variable.name == "value"
									_:
										False
							_:
								False
				None:
					False
		_:
			False


pure func test_constructor_grouping_preserves_first_occurrence_order() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(
				ConstructorPattern("None", []),
				int_expr(1),
			), raw_match_case(
				ConstructorPattern("Some", [LiteralPattern(IntLiteral(0))]),
				int_expr(2),
			), raw_match_case(
				ConstructorPattern("None", []),
				int_expr(3),
			), raw_match_case(
				ConstructorPattern("Some", [NamePattern("value")]),
				int_expr(4),
			)],
	)

	match result:
		Some(SemanticConstructorMatch(RootSemanticMatchAccessor, cases, None)):
			match (cases.get(0), cases.get(1)):
				(Some(first), Some(second)):
					(
						first.constructor == "None"
						and second.constructor == "Some"
						and cases.length() == 2
					)
				_:
					False
		_:
			False


pure func test_compiles_constructor_literal_payload() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(
				ConstructorPattern("Some", [LiteralPattern(IntLiteral(1))]),
				int_expr(10),
			), raw_match_case(
				ConstructorPattern("Some", [NamePattern("value")]),
				int_expr(20),
			), raw_match_case(
				ConstructorPattern("None", []),
				int_expr(30),
			)],
	)

	match result:
		Some(SemanticConstructorMatch(_, cases, None)):
			match cases.get(0):
				Some(some_case):
					match some_case.body:
						SemanticLiteralMatch(VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Some", 0), literal_cases, SemanticMatchLeaf([binding], LiteralExpr(IntLiteral(20), _, _))):
							literal_cases.length() == 1 and binding.variable.name == "value"
						_:
							False
				None:
					False
		_:
			False


pure func test_compiles_nested_constructor_payload() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(
				ConstructorPattern("Some", [ConstructorPattern("Some", [NamePattern("value")])]),
				int_expr(10),
			), raw_match_case(
				ConstructorPattern("Some", [ConstructorPattern("None", [])]),
				int_expr(20),
			), raw_match_case(
				ConstructorPattern("None", []),
				int_expr(30),
			)],
	)

	match result:
		Some(SemanticConstructorMatch(_, outer_cases, None)):
			match outer_cases.get(0):
				Some(some_case):
					match some_case.body:
						SemanticConstructorMatch(VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Some", 0), inner_cases, Some(_)):
							match inner_cases.get(0):
								Some(inner_some_case):
									(
										inner_some_case.constructor == "Some"
										and leaf_has_single_binding_named(
											inner_some_case.body,
											"value",
										)
									)
								None:
									False
						_:
							False
				None:
					False
		_:
			False


pure func test_constructor_payload_catchall_shadows_later_cases() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(
				ConstructorPattern("Some", [NamePattern("value")]),
				int_expr(10),
			), raw_match_case(
				ConstructorPattern("Some", [ConstructorPattern("None", [])]),
				int_expr(20),
			), raw_match_case(
				ConstructorPattern("None", []),
				int_expr(30),
			)],
	)

	match result:
		Some(SemanticConstructorMatch(_, cases, None)):
			match cases.get(0):
				Some(some_case):
					match some_case.body:
						SemanticMatchLeaf([binding], LiteralExpr(IntLiteral(10), _, _)):
							binding.variable.name == "value"
						_:
							False
				None:
					False
		_:
			False


pure func test_compiles_constructor_tuple_payload() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(
				ConstructorPattern(
					"Ok",
					[TuplePattern([NamePattern("value"), NamePattern("rest")])],
				),
				int_expr(10),
			), raw_match_case(
				ConstructorPattern("Err", [NamePattern("error")]),
				int_expr(20),
			)],
	)

	match result:
		Some(SemanticConstructorMatch(_, cases, None)):
			match cases.get(0):
				Some(ok_case):
					match ok_case.body:
						SemanticMatchLeaf(bindings, _):
							match bindings:
								[first, second]:
									match (first.accessor, second.accessor):
										(TupleFieldSemanticMatchAccessor(VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Ok", 0), 0), TupleFieldSemanticMatchAccessor(VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Ok", 0), 1)):
											(
												first.variable.name == "value"
												and second.variable.name == "rest"
											)
										_:
											False
								_:
									False
						_:
							False
				None:
					False
		_:
			False


pure func test_compiles_simple_tuple_bindings() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(TuplePattern([NamePattern("left"), NamePattern("right")]), int_expr(1))],
	)

	match result:
		Some(SemanticMatchLeaf(bindings, _)):
			first_matches: Bool = match bindings.get(0):
				Some(binding):
					match binding.accessor:
						TupleFieldSemanticMatchAccessor(RootSemanticMatchAccessor, 0):
							binding.variable.name == "left"
						_:
							False
				None:
					False

			second_matches: Bool = match bindings.get(1):
				Some(binding):
					match binding.accessor:
						TupleFieldSemanticMatchAccessor(RootSemanticMatchAccessor, 1):
							binding.variable.name == "right"
						_:
							False
				None:
					False

			bindings.length() == 2 and first_matches and second_matches
		_:
			False


pure func test_preserves_all_pattern_binding_order_and_modes() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[
			raw_match_case(
				ConstructorPattern(
					"Outer",
					[
						NamePattern("first"),
						QualifiedConstructorPattern("profile", "Inner", [NamePattern("second")]),
						TuplePattern([
							NamePattern("third"),
							WildcardPattern,
							LiteralPattern(IntLiteral(3)),
						]),
						ListPattern([NamePattern("fourth")], Some(NamePattern("rest"))),
					],
				),
				variable_expr(
					"rest",
					list_int_type(),
				),
			),
		],
	)

	match result:
		Some(tree):
			leaf_has_all_pattern_binding_order(tree)
		None:
			False


pure func test_compiles_tuple_literal_columns() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(TuplePattern([
					LiteralPattern(IntLiteral(0)),
					LiteralPattern(IntLiteral(0)),
				]), int_expr(
					10,
				)), raw_match_case(
				TuplePattern([LiteralPattern(IntLiteral(0)), WildcardPattern]),
				int_expr(
					20,
				),
			), raw_match_case(
				TuplePattern([WildcardPattern, LiteralPattern(IntLiteral(0))]),
				int_expr(30),
			), raw_match_case(WildcardPattern, int_expr(40))],
	)

	match result:
		Some(SemanticLiteralMatch(TupleFieldSemanticMatchAccessor(RootSemanticMatchAccessor, 0), first_cases, _)):
			match first_cases.get(0):
				Some(first_case):
					match first_case.body:
						SemanticLiteralMatch(TupleFieldSemanticMatchAccessor(RootSemanticMatchAccessor, 1), _, _):
							True
						_:
							False
				None:
					False
		_:
			False


pure func test_compiles_tuple_constructor_columns() -> Bool:
