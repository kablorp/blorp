pure func test_compiles_list_tuple_elements() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(
				ListPattern(
					[TuplePattern([NamePattern("key"), NamePattern("value")])],
					Some(NamePattern("rest")),
				),
				variable_expr("value", int_type()),
			), raw_match_case(WildcardPattern, int_expr(20))],
	)

	match result:
		Some(SemanticLengthMatch(_, _, Some(geq), Some(_))):
			match geq.body:
				SemanticMatchLeaf(bindings, _):
					var found: Bool = False

					for binding in bindings:
						if binding.variable.name == "value":
							match binding.accessor:
								TupleFieldSemanticMatchAccessor(ListElementSemanticMatchAccessor(RootSemanticMatchAccessor, 0), 1):
									found = True
									break
								_:
									void

					found
				_:
					False
		_:
			False


