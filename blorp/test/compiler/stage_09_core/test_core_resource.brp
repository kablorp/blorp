import:
	../../../src/compiler/stage_09_core/fairness: insert_cooperative_checkpoints_expr
	../../../src/compiler/stage_09_core/ir:
		CoreAccessor(RootAccessor),
		CoreCallKind(UserCall),
		CoreConstructorMatchBody(ConstructorMatchBodyExpr),
		CoreConstructorMatchFallback(ConstructorMatchFallbackBody),
		CoreExpr(
			AccessorLiteralMatchExpr,
			BreakExpr,
			CallExpr,
			ConstructorMatchExpr,
			ContinueExpr,
			DropExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LengthMatchExpr,
			PreClosureDetachExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SelectExpr,
			VarExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreLiteral(BoolLiteral),
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(LiteralMatchFallbackBody),
		CoreReleasePolicy(ArcReleasePolicy),
		CoreResourceExit(ResourceBreakExit, ResourceContinueExit),
		CoreSelectArm,
		CoreSelectArmKind(SelectAfterArm),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
		CoreVar,
		core_expr_to_json,
	../../../src/compiler/stage_09_core/resource_management: rewrite_resource_expr
	test: TestSuite


pure func resource_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func resource_func_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 1,
		def_id = None
	}


pure func test_resource_type() -> CoreType:
	NamedType("TestResource", [])


pure func closure_type() -> CoreType:
	NamedType("Closure", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func resource_open(name: String) -> CoreExpr:
	VarExpr(resource_func_var("open_" + name), test_resource_type(), SyntheticSourceLoc)


pure func cleanup_call(name: String) -> CoreExpr:
	CallExpr(
		UserCall("close_" + name, None, []),
		VarExpr(resource_func_var("close_" + name), closure_type(), SyntheticSourceLoc),
		[VarExpr(resource_var(name), test_resource_type(), SyntheticSourceLoc)],
		VoidType,
		SyntheticSourceLoc,
	)


pure func resource_scope(name: String, body: CoreExpr) -> CoreExpr:
	ResourceScopeExpr(
		{
			variable = resource_var(name),
			typ = test_resource_type(),
			acquire = resource_open(name),
			body = body,
			cleanup = cleanup_call(name)
		},
		VoidType,
		SyntheticSourceLoc,
	)


pure func bool_literal(value: Bool) -> CoreExpr:
	LiteralExpr(BoolLiteral(value), bool_type(), SyntheticSourceLoc)


pure func cleanup_exit_break(cleanups: List[CoreExpr]) -> CoreExpr:
	ResourceCleanupExitExpr(
		{
			cleanups = cleanups,
			exit = ResourceBreakExit
		},
		VoidType,
		SyntheticSourceLoc,
	)


pure func cleanup_exit_continue(cleanups: List[CoreExpr]) -> CoreExpr:
	ResourceCleanupExitExpr(
		{
			cleanups = cleanups,
			exit = ResourceContinueExit
		},
		VoidType,
		SyntheticSourceLoc,
	)


pure func match_owner_drop() -> CoreExpr:
	DropExpr(
		resource_var("match_owner"),
		test_resource_type(),
		ArcReleasePolicy,
		VoidExpr(VoidType, SyntheticSourceLoc),
		VoidType,
		SyntheticSourceLoc,
	)


pure func core_exprs_equal(left: CoreExpr, right: CoreExpr) -> Bool:
	core_expr_to_json(left).to_string() == core_expr_to_json(right).to_string()


pure func test_rewrites_direct_break_to_cleanup_exit() -> Bool:
	core_exprs_equal(
		rewrite_resource_expr(resource_scope("handle", BreakExpr(VoidType, SyntheticSourceLoc))),
		resource_scope("handle", cleanup_exit_break([cleanup_call("handle")])),
	)


pure func test_nested_loop_local_break_stays_plain_break() -> Bool:
	loop: CoreExpr = WhileExpr(
		bool_literal(True),
		BreakExpr(VoidType, SyntheticSourceLoc),
		VoidType,
		SyntheticSourceLoc,
	)

	core_exprs_equal(
		rewrite_resource_expr(resource_scope("handle", loop)),
		resource_scope("handle", loop),
	)


pure func test_releasing_match_cleans_scrutinee_before_break() -> Bool:
	match_expr: CoreExpr = ConstructorMatchExpr(
		VarExpr(resource_var("match_owner"), test_resource_type(), SyntheticSourceLoc),
		ArcReleasePolicy,
		[],
		ConstructorMatchFallbackBody(BreakExpr(VoidType, SyntheticSourceLoc)),
		VoidType,
		SyntheticSourceLoc,
	)
	expected_match: CoreExpr = ConstructorMatchExpr(
		VarExpr(resource_var("match_owner"), test_resource_type(), SyntheticSourceLoc),
		ArcReleasePolicy,
		[],
		ConstructorMatchFallbackBody(cleanup_exit_break([match_owner_drop()])),
		VoidType,
		SyntheticSourceLoc,
	)

	core_exprs_equal(
		rewrite_resource_expr(
			WhileExpr(
				bool_literal(True),
				match_expr,
				VoidType,
				SyntheticSourceLoc,
			),
		),
		WhileExpr(bool_literal(True), expected_match, VoidType, SyntheticSourceLoc),
	)


pure func test_releasing_match_cleans_scrutinee_before_continue() -> Bool:
	match_expr: CoreExpr = ConstructorMatchExpr(
		VarExpr(resource_var("match_owner"), test_resource_type(), SyntheticSourceLoc),
		ArcReleasePolicy,
		[],
		ConstructorMatchFallbackBody(ContinueExpr(VoidType, SyntheticSourceLoc)),
		VoidType,
		SyntheticSourceLoc,
	)
	expected_match: CoreExpr = ConstructorMatchExpr(
		VarExpr(resource_var("match_owner"), test_resource_type(), SyntheticSourceLoc),
		ArcReleasePolicy,
		[],
		ConstructorMatchFallbackBody(cleanup_exit_continue([match_owner_drop()])),
		VoidType,
		SyntheticSourceLoc,
	)

	core_exprs_equal(
		rewrite_resource_expr(
			WhileExpr(
				bool_literal(True),
				match_expr,
				VoidType,
				SyntheticSourceLoc,
			),
		),
		WhileExpr(bool_literal(True), expected_match, VoidType, SyntheticSourceLoc),
	)


pure func test_accessor_match_cleanup_precedes_outer_resource_on_break() -> Bool:
	match_expr: CoreExpr = AccessorLiteralMatchExpr(
		VarExpr(
			resource_var("match_owner"),
			test_resource_type(),
			SyntheticSourceLoc,
		),
		ArcReleasePolicy,
		{
			accessor = RootAccessor,
			scrutinee_type = test_resource_type(),
			cases = [],
			fallback = LiteralMatchFallbackBody(BreakExpr(VoidType, SyntheticSourceLoc)),
			result_type = VoidType,
			loc = SyntheticSourceLoc
		},
		VoidType,
		SyntheticSourceLoc,
	)
	expected_match: CoreExpr = AccessorLiteralMatchExpr(
		VarExpr(
			resource_var("match_owner"),
			test_resource_type(),
			SyntheticSourceLoc,
		),
		ArcReleasePolicy,
		{
			accessor = RootAccessor,
			scrutinee_type = test_resource_type(),
			cases = [],
			fallback = LiteralMatchFallbackBody(
				cleanup_exit_break([match_owner_drop(), cleanup_call("handle")]),
			),
			result_type = VoidType,
			loc = SyntheticSourceLoc
		},
		VoidType,
		SyntheticSourceLoc,
	)

	core_exprs_equal(
		rewrite_resource_expr(
			WhileExpr(
				bool_literal(True),
				resource_scope("handle", match_expr),
				VoidType,
				SyntheticSourceLoc,
			),
		),
		WhileExpr(
			bool_literal(True),
			resource_scope("handle", expected_match),
			VoidType,
			SyntheticSourceLoc,
		),
	)


pure func test_length_match_cleanup_precedes_outer_resource_on_continue() -> Bool:
	match_expr: CoreExpr = LengthMatchExpr(
		VarExpr(
			resource_var("match_owner"),
			test_resource_type(),
			SyntheticSourceLoc,
		),
		ArcReleasePolicy,
		{
			accessor = RootAccessor,
			cases = [],
			geq = None,
			fallback = Some({
				bindings = [],
				body = ConstructorMatchBodyExpr(ContinueExpr(VoidType, SyntheticSourceLoc)),
			}),
			result_type = VoidType,
			loc = SyntheticSourceLoc
		},
		VoidType,
		SyntheticSourceLoc,
	)
	expected_match: CoreExpr = LengthMatchExpr(
		VarExpr(
			resource_var("match_owner"),
			test_resource_type(),
			SyntheticSourceLoc,
		),
		ArcReleasePolicy,
		{
			accessor = RootAccessor,
			cases = [],
			geq = None,
			fallback = Some({
				bindings = [],
				body = ConstructorMatchBodyExpr(
					cleanup_exit_continue([match_owner_drop(), cleanup_call("handle")]),
				),
			}),
			result_type = VoidType,
			loc = SyntheticSourceLoc
		},
		VoidType,
		SyntheticSourceLoc,
	)

	core_exprs_equal(
		rewrite_resource_expr(
			WhileExpr(
				bool_literal(True),
				resource_scope("handle", match_expr),
				VoidType,
				SyntheticSourceLoc,
			),
		),
		WhileExpr(
			bool_literal(True),
			resource_scope("handle", expected_match),
			VoidType,
			SyntheticSourceLoc,
		),
	)


pure func test_nested_resources_cleanup_in_reverse_order() -> Bool:
	rewritten: CoreExpr = rewrite_resource_expr(
		resource_scope(
			"outer",
			resource_scope(
				"inner",
				ContinueExpr(VoidType, SyntheticSourceLoc),
			),
		),
	)
	expected: CoreExpr = resource_scope(
		"outer",
		resource_scope(
			"inner",
			cleanup_exit_continue([cleanup_call("inner"), cleanup_call("outer")]),
		),
	)

	core_exprs_equal(rewritten, expected)


pure func test_literal_match_branches_own_independent_cleanups() -> Bool:
	match_case: CoreLiteralMatchCase = {
		literal = BoolLiteral(True),
		bindings = [],
		body = BreakExpr(VoidType, SyntheticSourceLoc)
	}
	match_expr: CoreExpr = LiteralMatchExpr(
		bool_literal(True),
		[match_case],
		LiteralMatchFallbackBody(ContinueExpr(VoidType, SyntheticSourceLoc)),
		VoidType,
		SyntheticSourceLoc,
	)
	expected_case: CoreLiteralMatchCase = {
		literal = BoolLiteral(True),
		bindings = [],
		body = cleanup_exit_break([cleanup_call("handle")])
	}
	expected_match: CoreExpr = LiteralMatchExpr(
		bool_literal(True),
		[expected_case],
		LiteralMatchFallbackBody(cleanup_exit_continue([cleanup_call("handle")])),
		VoidType,
		SyntheticSourceLoc,
	)

	core_exprs_equal(
		rewrite_resource_expr(resource_scope("handle", match_expr)),
		resource_scope("handle", expected_match),
	)


pure func test_independent_cleanup_lists_survive_following_pass() -> Bool:
	match_case: CoreLiteralMatchCase = {
		literal = BoolLiteral(True),
		bindings = [],
		body = BreakExpr(VoidType, SyntheticSourceLoc)
	}
	match_expr: CoreExpr = LiteralMatchExpr(
		bool_literal(True),
		[match_case],
		LiteralMatchFallbackBody(ContinueExpr(VoidType, SyntheticSourceLoc)),
		VoidType,
		SyntheticSourceLoc,
	)
	expected_case: CoreLiteralMatchCase = {
		literal = BoolLiteral(True),
		bindings = [],
		body = cleanup_exit_break([cleanup_call("handle")])
	}
	expected_match: CoreExpr = LiteralMatchExpr(
		bool_literal(True),
		[expected_case],
		LiteralMatchFallbackBody(cleanup_exit_continue([cleanup_call("handle")])),
		VoidType,
		SyntheticSourceLoc,
	)

	rewritten: CoreExpr = rewrite_resource_expr(resource_scope("handle", match_expr))
	after_fairness: CoreExpr = insert_cooperative_checkpoints_expr(rewritten)

	core_exprs_equal(
		after_fairness,
		resource_scope("handle", expected_match),
	)


pure func test_detached_body_does_not_inherit_parent_cleanup() -> Bool:
	detached: CoreExpr = PreClosureDetachExpr(
		BreakExpr(VoidType, SyntheticSourceLoc),
		VoidType,
		SyntheticSourceLoc,
	)

	core_exprs_equal(
		rewrite_resource_expr(resource_scope("handle", detached)),
		resource_scope("handle", detached),
	)


pure func test_select_arm_owns_independent_cleanup_scope() -> Bool:
	arm: CoreSelectArm = {
		kind = SelectAfterArm(bool_literal(True)),
		body = resource_scope(
			"inner",
			BreakExpr(VoidType, SyntheticSourceLoc),
		),
		loc = SyntheticSourceLoc
	}
	expected_arm: CoreSelectArm = { arm |
		body = resource_scope("inner", cleanup_exit_break([cleanup_call("inner")]))
	}

	core_exprs_equal(
		rewrite_resource_expr(
			resource_scope(
				"handle",
				SelectExpr([arm], VoidType, SyntheticSourceLoc),
			),
		),
		resource_scope(
			"handle",
			SelectExpr([expected_arm], VoidType, SyntheticSourceLoc),
		),
	)


tests: TestSuite = {
	description = "Blorp compiler Core resource",
	tests = [
		("rewrites direct break to cleanup exit", test_rewrites_direct_break_to_cleanup_exit),
		(
			"nested loop local break stays plain break",
			test_nested_loop_local_break_stays_plain_break,
		),
		(
			"releasing match cleans scrutinee before break",
			test_releasing_match_cleans_scrutinee_before_break,
		),
		(
			"releasing match cleans scrutinee before continue",
			test_releasing_match_cleans_scrutinee_before_continue,
		),
		(
			"accessor match cleanup precedes outer resource on break",
			test_accessor_match_cleanup_precedes_outer_resource_on_break,
		),
		(
			"length match cleanup precedes outer resource on continue",
			test_length_match_cleanup_precedes_outer_resource_on_continue,
		),
		(
			"nested resources clean up in reverse order",
			test_nested_resources_cleanup_in_reverse_order,
		),
		(
			"literal match branches own independent cleanups",
			test_literal_match_branches_own_independent_cleanups,
		),
		(
			"independent cleanup lists survive the following pass",
			test_independent_cleanup_lists_survive_following_pass,
		),
		(
			"detached body does not inherit parent cleanup",
			test_detached_body_does_not_inherit_parent_cleanup,
		),
		(
			"select arm owns independent cleanup scope",
			test_select_arm_owns_independent_cleanup_scope,
		),
	]
}
