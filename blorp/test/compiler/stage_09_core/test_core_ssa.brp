import:
	../../../src/compiler/stage_09_core/ir:
		CoreAccessor(RootAccessor),
		CoreBinaryOp(AddOp),
		CoreConstructorMatchBody(ConstructorMatchBodyExpr),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(ConstructorMatchFallbackFail),
		CoreConstructorMatchTest(BoolTrueConstructorTest),
		CoreDecl(FunctionDecl, GlobalDecl),
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			ConstructorMatchExpr,
			ForRangeExpr,
			IfExpr,
			LambdaExpr,
			LetExpr,
			LiteralExpr,
			LogicalExpr,
			RawMatchExpr,
			ResourceScopeExpr,
			SeqExpr,
			TupleExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreGlobal,
		CoreLiteral(BoolLiteral, IntLiteral),
		CoreLogicalOp(AndOp),
		CoreLoopBinder,
		CoreLoopRangeDirection(RangeMayRunBackward),
		CoreMatchBinding,
		CoreMatchBindingMode(MatchBorrowBindingMode),
		CoreParam,
		CorePattern(NamePattern, WildcardPattern),
		CoreProgram,
		CoreRawMatchCase,
		CoreReleasePolicy(NoReleasePolicy),
		CoreResourceScope,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
		CoreVar,
		core_expr_to_json,
	../../../src/compiler/stage_09_core/ssa:
		CoreAssignmentShape(ControlFlowAssignment, NoAssignment, StraightLineAssignment),
		classify_assignment_shape,
		desugar_expr,
		desugar_program,
	test: TestSuite


DEEP_LOGICAL_COUNT: Int = 4096


pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


pure func int_type() -> CoreType:
	named_type("Int")


pure func bool_type() -> CoreType:
	named_type("Bool")


pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func named_var_with_uniq(name: String, uniq: Int) -> CoreVar:
	{
		name = name,
		uniq = uniq,
		def_id = Some(uniq)
	}


pure func int_lit(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), int_type(), SyntheticSourceLoc)


pure func bool_lit(value: Bool) -> CoreExpr:
	LiteralExpr(BoolLiteral(value), bool_type(), SyntheticSourceLoc)


pure func bool_var(name: String) -> CoreExpr:
	VarExpr(named_var(name), bool_type(), SyntheticSourceLoc)


pure func versioned_bool(name: String) -> CoreExpr:
	LetExpr(
		named_var(name),
		True,
		bool_type(),
		bool_lit(True),
		SeqExpr(
			AssignExpr(named_var(name), bool_lit(False), VoidType, SyntheticSourceLoc),
			bool_var(name),
		),
	)


pure func deep_logical_expr() -> CoreExpr:
	var result: CoreExpr = versioned_bool("left")

	for index in 0..DEEP_LOGICAL_COUNT:
		right: CoreExpr = if index == DEEP_LOGICAL_COUNT - 1:
			versioned_bool("right")
		else:
			bool_lit(True)

		result = LogicalExpr(AndOp, result, right, bool_type(), SyntheticSourceLoc)

	result


pure func int_var(name: String) -> CoreExpr:
	VarExpr(named_var(name), int_type(), SyntheticSourceLoc)


pure func int_var_with_uniq(name: String, uniq: Int) -> CoreExpr:
	VarExpr(
		named_var_with_uniq(name, uniq),
		int_type(),
		SyntheticSourceLoc,
	)


pure func assign(name: String, rhs: CoreExpr) -> CoreExpr:
	AssignExpr(named_var(name), rhs, VoidType, SyntheticSourceLoc)


pure func mutable_let(name: String, rhs: CoreExpr, body: CoreExpr) -> CoreExpr:
	LetExpr(named_var(name), True, int_type(), rhs, body)


pure func immutable_let(name: String, rhs: CoreExpr, body: CoreExpr) -> CoreExpr:
	LetExpr(named_var(name), False, int_type(), rhs, body)


pure func core_exprs_equal(left: CoreExpr, right: CoreExpr) -> Bool:
	core_expr_to_json(left).to_string() == core_expr_to_json(right).to_string()


pure func var_name(expr: CoreExpr) -> Option[String]:
	match expr:
		VarExpr(variable, _, _):
			Some(variable.name)
		_:
			None


pure func raw_match_case_body_name(cases: List[CoreRawMatchCase], index: Int) -> Option[String]:
	match cases.get(index):
		Some(match_case):
			var_name(match_case.body)
		None:
			None


func test_classifies_no_assignment() -> Bool:
	classify_assignment_shape("x", int_var("x")) == NoAssignment


func test_classifies_straight_line_assignment() -> Bool:
	body = SeqExpr(
		assign("x", int_lit(2)),
		int_var("x"),
	)
	classify_assignment_shape("x", body) == StraightLineAssignment


func test_classifies_control_flow_assignment() -> Bool:
	body = IfExpr(
		bool_lit(True),
		assign("x", int_lit(2)),
		VoidExpr(VoidType, SyntheticSourceLoc),
		VoidType,
		SyntheticSourceLoc,
	)
	classify_assignment_shape("x", body) == ControlFlowAssignment


func test_no_assignment_makes_binding_immutable() -> Bool:
	match desugar_expr(mutable_let("x", int_lit(1), int_var("x"))):
		LetExpr(variable, is_mutable, _, _, body):
			variable.name == "x" and not is_mutable and var_name(body) == Some("x")
		_:
			False


func test_unrelated_assignment_does_not_version_binding() -> Bool:
	source = mutable_let(
		"x",
		int_lit(1),
		SeqExpr(
			assign("y", int_lit(2)),
			int_var("x"),
		),
	)

	match desugar_expr(source):
		LetExpr(variable, is_mutable, _, _, SeqExpr(AssignExpr(target, _, _, _), tail)):
			(
				variable.name == "x"
				and not is_mutable
				and target.name == "y"
				and var_name(tail) == Some("x")
			)
		_:
			False


func test_straight_line_assignment_versions_binding() -> Bool:
	source = mutable_let(
		"x",
		int_lit(1),
		SeqExpr(
			assign("x", int_lit(2)),
			int_var("x"),
		),
	)

	match desugar_expr(source):
		LetExpr(initial, initial_mutable, _, _, LetExpr(next, next_mutable, _, _, tail)):
			(
				initial.name == "x__v0"
				and next.name == "x__v1"
				and not initial_mutable
				and not next_mutable
				and var_name(tail) == Some("x__v1")
			)
		_:
			False


func test_assignment_rhs_uses_previous_version() -> Bool:
	rhs = BinaryExpr(AddOp, int_var("x"), int_lit(1), int_type(), SyntheticSourceLoc)
	source = mutable_let(
		"x",
		int_lit(1),
		SeqExpr(
			assign("x", rhs),
			int_var("x"),
		),
	)

	match desugar_expr(source):
		LetExpr(_, _, _, _, LetExpr(_, _, _, next_rhs, _)):
			match next_rhs:
				BinaryExpr(AddOp, left, LiteralExpr(IntLiteral(1), _, _), _, _):
					var_name(left) == Some("x__v0")
				_:
					False
		_:
			False


func test_multiple_assignments_form_version_chain() -> Bool:
	source = mutable_let(
		"x",
		int_lit(1),
		SeqExpr(
			assign("x", int_lit(2)),
			SeqExpr(
				assign("x", int_lit(3)),
				int_var("x"),
			),
		),
	)

	match desugar_expr(source):
		LetExpr(initial, _, _, _, LetExpr(second, _, _, _, LetExpr(third, _, _, _, tail))):
			(
				initial.name == "x__v0"
				and second.name == "x__v1"
				and third.name == "x__v2"
				and var_name(tail) == Some("x__v2")
			)
		_:
			False


func test_terminal_assignment_versions_binding_and_returns_void() -> Bool:
	source = mutable_let(
		"x",
		int_lit(1),
		assign("x", int_lit(2)),
	)

	match desugar_expr(source):
		LetExpr(initial, initial_mutable, _, _, LetExpr(next, next_mutable, _, _, VoidExpr(VoidType, _))):
			(
				initial.name == "x__v0"
				and next.name == "x__v1"
				and not initial_mutable
				and not next_mutable
			)
		_:
			False


func test_nested_let_shadowing_preserves_inner_body() -> Bool:
	inner = immutable_let("x", int_var("x"), int_var("x"))
	source = mutable_let(
		"x",
		int_lit(1),
		SeqExpr(
			assign("x", int_lit(2)),
			inner,
		),
	)

	match desugar_expr(source):
		LetExpr(_, _, _, _, LetExpr(_, _, _, _, LetExpr(inner_var, _, _, inner_rhs, inner_body))):
			(
				inner_var.name == "x"
				and var_name(inner_rhs) == Some("x__v1")
				and var_name(inner_body) == Some("x")
			)
		_:
			False


func test_lambda_param_shadowing_preserves_body() -> Bool:
	param: CoreParam = {
		name = named_var("x"),
		typ = int_type(),
		loc = SyntheticSourceLoc
	}
	lambda = LambdaExpr(
		[param],
		int_type(),
		int_var("x"),
		True,
		named_type("Function"),
		SyntheticSourceLoc,
	)
	source = mutable_let(
		"x",
		int_lit(1),
		SeqExpr(
			assign("x", int_lit(2)),
			lambda,
		),
	)

	match desugar_expr(source):
		LetExpr(_, _, _, _, LetExpr(_, _, _, _, LambdaExpr(_, _, body, _, _, _))):
			var_name(body) == Some("x")
		_:
			False


func test_loop_binder_shadowing_preserves_body() -> Bool:
	binder: CoreLoopBinder = {
		variable = named_var("x"),
		typ = int_type(),
		range_direction = RangeMayRunBackward
	}
	loop = ForRangeExpr(binder, int_lit(0), int_lit(3), int_var("x"), VoidType, SyntheticSourceLoc)
	source = mutable_let(
		"x",
		int_lit(1),
		SeqExpr(
			assign("x", int_lit(2)),
			loop,
		),
	)

	match desugar_expr(source):
		LetExpr(_, _, _, _, LetExpr(_, _, _, _, ForRangeExpr(lowered, _, _, body, _, _))):
			lowered.variable.name == "x" and var_name(body) == Some("x")
		_:
			False


func test_pattern_shadowing_preserves_match_arm_body() -> Bool:
	source = mutable_let(
		"x",
		int_lit(1),
		SeqExpr(
			assign(
				"x",
				int_lit(2),
			),
			RawMatchExpr(
				int_var("x"),
				[
					{
						pattern = NamePattern("x"),
						body = int_var("x")
					},
					{
						pattern = WildcardPattern,
						body = int_var("x")
					},
				],
				int_type(),
				SyntheticSourceLoc,
			),
		),
	)

	match desugar_expr(source):
		LetExpr(_, _, _, _, LetExpr(_, _, _, _, RawMatchExpr(scrutinee, cases, _, _))):
			(
				var_name(scrutinee) == Some("x__v1")
				and raw_match_case_body_name(cases, 0) == Some("x")
				and raw_match_case_body_name(cases, 1) == Some("x__v1")
			)
		_:
			False


pure func match_binding(name: String) -> CoreMatchBinding:
	{
		variable = named_var(name),
		typ = int_type(),
		accessor = RootAccessor,
		mode = MatchBorrowBindingMode
	}


pure func constructor_case(
	bindings: List[CoreMatchBinding],
	body: CoreExpr,
) -> CoreConstructorMatchCase:
	{
		constructor = "True",
		accessor = RootAccessor,
		test = BoolTrueConstructorTest,
		bindings = bindings,
		body = ConstructorMatchBodyExpr(body)
	}


pure func constructor_case_body_name(
	cases: List[CoreConstructorMatchCase],
	index: Int,
) -> Option[String]:
	match cases.get(index):
		Some(match_case):
			match match_case.body:
				ConstructorMatchBodyExpr(body):
					var_name(body)
				_:
					None
		None:
			None


pure func constructor_case_initial_version(
	cases: List[CoreConstructorMatchCase],
	index: Int,
) -> Option[String]:
	match cases.get(index):
		Some(match_case):
			match match_case.body:
				ConstructorMatchBodyExpr(body):
					initial_version_name(body)
				_:
					None
		None:
			None


func test_constructor_match_binding_shadowing() -> Bool:
	match_expr = ConstructorMatchExpr(
		int_var("x"),
		NoReleasePolicy,
		[constructor_case([match_binding("x")], int_var("x")), constructor_case([], int_var("x"))],
		ConstructorMatchFallbackFail,
		int_type(),
		SyntheticSourceLoc,
	)
	source = mutable_let(
		"x",
		int_lit(1),
		SeqExpr(
			assign("x", int_lit(2)),
			match_expr,
		),
	)

	match desugar_expr(source):
		LetExpr(_, _, _, _, LetExpr(_, _, _, _, ConstructorMatchExpr(scrutinee, _, cases, _, _, _))):
			(
				var_name(scrutinee) == Some("x__v1")
				and constructor_case_body_name(cases, 0) == Some("x")
				and constructor_case_body_name(cases, 1) == Some("x__v1")
			)
		_:
			False


func test_constructor_match_descends_into_case_body() -> Bool:
	inner = mutable_let(
		"y",
		int_lit(1),
		SeqExpr(
			assign("y", int_lit(2)),
			int_var("y"),
		),
	)
	source = ConstructorMatchExpr(
		bool_lit(True),
		NoReleasePolicy,
		[constructor_case([], inner)],
		ConstructorMatchFallbackFail,
		int_type(),
		SyntheticSourceLoc,
	)

	match desugar_expr(source):
		ConstructorMatchExpr(_, _, cases, _, _, _):
			constructor_case_initial_version(cases, 0) == Some("y__v0")
		_:
			False


func test_resource_scope_shadowing_preserves_body_and_cleanup() -> Bool:
	scope: CoreResourceScope = {
		variable = named_var("x"),
		typ = int_type(),
		acquire = int_var("x"),
		body = int_var("x"),
		cleanup = int_var("x")
	}
	source = mutable_let(
		"x",
		int_lit(1),
		SeqExpr(
			assign("x", int_lit(2)),
			ResourceScopeExpr(scope, int_type(), SyntheticSourceLoc),
		),
	)

	match desugar_expr(source):
		LetExpr(_, _, _, _, LetExpr(_, _, _, _, ResourceScopeExpr(lowered, _, _))):
			(
				lowered.variable.name == "x"
				and var_name(lowered.acquire) == Some("x__v1")
				and var_name(lowered.body) == Some("x")
				and var_name(lowered.cleanup) == Some("x")
			)
		_:
			False


func test_shadowed_resource_assignment_does_not_version_outer() -> Bool:
	scope: CoreResourceScope = {
		variable = named_var("x"),
		typ = int_type(),
		acquire = int_lit(0),
		body = SeqExpr(
			assign("x", int_lit(2)),
			int_var("x"),
		),
		cleanup = VoidExpr(VoidType, SyntheticSourceLoc)
	}
	source = mutable_let(
		"x",
		int_lit(1),
		ResourceScopeExpr(scope, int_type(), SyntheticSourceLoc),
	)

	match desugar_expr(source):
		LetExpr(variable, is_mutable, _, _, ResourceScopeExpr(lowered, _, _)):
			match lowered.body:
				SeqExpr(AssignExpr(target, _, _, _), tail):
					(
						variable.name == "x"
						and not is_mutable
						and target.name == "x"
						and var_name(tail) == Some("x")
					)
				_:
					False
		_:
			False


func test_control_flow_assignment_survives() -> Bool:
	body = IfExpr(
		bool_lit(True),
		assign("x", int_lit(2)),
		VoidExpr(VoidType, SyntheticSourceLoc),
		VoidType,
		SyntheticSourceLoc,
	)

	match desugar_expr(mutable_let("x", int_lit(1), body)):
		LetExpr(variable, is_mutable, _, _, IfExpr(_, AssignExpr(target, _, _, _), _, _, _)):
			variable.name == "x" and is_mutable and target.name == "x"
		_:
			False


pure func sample_function(name: String, def_id: Int, body: CoreExpr) -> CoreFunction:
	{
		name = name,
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc
	}


pure func sample_global(name: String, def_id: Int, init: CoreExpr) -> CoreGlobal:
	{
		name = named_var(name),
		source_module = None,
		typ = int_type(),
		init = init,
		is_mutable = False,
		is_const = False,
		is_private = False,
		def_id = def_id,
		loc = SyntheticSourceLoc
	}


pure func initial_version_name(expr: CoreExpr) -> Option[String]:
	match expr:
		LetExpr(variable, _, _, _, _):
			Some(variable.name)
		_:
			None


pure func initial_version_name_at(items: List[CoreExpr], index: Int) -> Option[String]:
	match items.get(index):
		Some(expr):
			initial_version_name(expr)
		None:
			None


func test_expression_siblings_thread_one_counter() -> Bool:
	first = mutable_let(
		"x",
		int_lit(1),
		SeqExpr(
			assign("x", int_lit(2)),
			int_var("x"),
		),
	)
	second = mutable_let(
		"y",
		int_lit(3),
		SeqExpr(
			assign("y", int_lit(4)),
			int_var("y"),
		),
	)

	match (
		desugar_expr(
			TupleExpr(
				[first, second],
				named_type("Pair"),
				SyntheticSourceLoc,
			),
		)
	):
		TupleExpr(items, _, _):
			(
				initial_version_name_at(items, 0) == Some("x__v0")
				and initial_version_name_at(items, 1) == Some("y__v2")
			)
		_:
			False


func test_program_threads_one_counter_across_declarations() -> Bool:
	first_body = mutable_let(
		"x",
		int_lit(1),
		SeqExpr(
			assign("x", int_lit(2)),
			int_var("x"),
		),
	)
	second_body = mutable_let(
		"y",
		int_lit(3),
		SeqExpr(
			assign("y", int_lit(4)),
			int_var("y"),
		),
	)
	source: CoreProgram = {
		decls = [
			FunctionDecl(sample_function("first", 1, first_body)),
			GlobalDecl(sample_global("second", 2, second_body)),
		],
		foreign_includes = []
	}

	match desugar_program(source).decls:
		[FunctionDecl(first), GlobalDecl(second)]:
			match first.body:
				Some(first_lowered):
					(
						initial_version_name(first_lowered) == Some("x__v0")
						and initial_version_name(second.init) == Some("y__v2")
					)
				None:
					False
		_:
			False


func test_fresh_versions_drop_source_identity() -> Bool:
	source = LetExpr(
		named_var_with_uniq("x", 41),
		True,
		int_type(),
		int_lit(1),
		SeqExpr(
			AssignExpr(
				named_var_with_uniq("x", 41),
				int_lit(2),
				VoidType,
				SyntheticSourceLoc,
			),
			int_var_with_uniq("x", 41),
		),
	)

	match desugar_expr(source):
		LetExpr(initial, _, _, _, LetExpr(next, _, _, _, VarExpr(tail, _, _))):
			(
				initial.name == "x__v0"
				and initial.uniq == 0
				and initial.def_id.is_none()
				and next.name == "x__v1"
				and next.uniq == 0
				and next.def_id.is_none()
				and tail.name == "x__v1"
				and tail.uniq == 0
				and tail.def_id.is_none()
			)
		_:
			False


func test_long_sequence_is_stack_bounded() -> Bool:
	assignment_count: Int = 2048
	var body: CoreExpr = int_var("x")
	var index: Int = assignment_count

	while index > 0:
		body = SeqExpr(
			assign("x", int_lit(index)),
			body,
		)
		index -= 1

	var current: CoreExpr = desugar_expr(mutable_let("x", int_lit(0), body))
	var binding_count: Int = 0
	var valid: Bool = True

	while True:
		match current:
			LetExpr(variable, is_mutable, _, _, next):
				if is_mutable:
					valid = False
					break

				expected_name = "x__v${binding_count}"

				if variable.name != expected_name:
					valid = False
					break

				binding_count += 1
				current = next
			_:
				if var_name(current) != Some("x__v${assignment_count}"):
					valid = False

				break

	valid and binding_count == assignment_count + 1


pure func sequence_vars_are_named(
	expr: CoreExpr,
	expected_name: String,
	expected_count: Int,
) -> Bool:
	var current: CoreExpr = expr
	var count: Int = 0
	var valid: Bool = True

	while True:
		match current:
			SeqExpr(first, second):
				if var_name(first) != Some(expected_name):
					valid = False
					break

				count += 1
				current = second
			_:
				if var_name(current) != Some(expected_name):
					valid = False

				count += 1
				break

	valid and count == expected_count


func test_nested_sequence_substitution_is_stack_bounded() -> Bool:
	sequence_depth: Int = 2048
	var branch: CoreExpr = int_var("x")
	var index: Int = 0

	while index < sequence_depth:
		branch = SeqExpr(int_var("x"), branch)
		index += 1

	control_flow = IfExpr(bool_lit(True), branch, int_var("x"), int_type(), SyntheticSourceLoc)
	source = mutable_let(
		"x",
		int_lit(1),
		SeqExpr(
			assign("x", int_lit(2)),
			control_flow,
		),
	)

	match desugar_expr(source):
		LetExpr(_, _, _, _, LetExpr(_, _, _, _, IfExpr(_, then_expr, else_expr, _, _))):
			(
				sequence_vars_are_named(then_expr, "x__v1", sequence_depth + 1)
				and var_name(else_expr) == Some("x__v1")
			)
		_:
			False


func test_deep_binary_spine_is_stack_bounded() -> Bool:
	spine_depth: Int = 2048
	var source: CoreExpr = int_lit(0)
	var index: Int = 0

	while index < spine_depth:
		source = BinaryExpr(AddOp, source, int_lit(index), int_type(), SyntheticSourceLoc)
		index += 1

	var current: CoreExpr = desugar_expr(source)
	var remaining: Int = spine_depth
	var valid: Bool = True

	while remaining > 0:
		match current:
			BinaryExpr(AddOp, left, LiteralExpr(IntLiteral(_), _, _), _, _):
				current = left
				remaining -= 1
			_:
				valid = False
				break

	valid and remaining == 0 and core_exprs_equal(current, int_lit(0))


pure func test_deep_logical_chain_is_stack_bounded() -> Bool:
	var current: CoreExpr = desugar_expr(deep_logical_expr())
	var logical_count: Int = 0
	var final_right_versions_are_ordered: Bool = False
	var valid: Bool = True

	while valid:
		match current:
			LogicalExpr(AndOp, left, right, _, _):
				if logical_count == 0:
					final_right_versions_are_ordered = match right:
						LetExpr(initial, False, _, _, LetExpr(next, False, _, _, tail)):
							(
								initial.name == "right__v2"
								and next.name == "right__v3"
								and var_name(tail) == Some("right__v3")
							)
						_:
							False

				logical_count += 1
				current = left
			LetExpr(initial, False, _, _, LetExpr(next, False, _, _, tail)):
				valid = (
					initial.name == "left__v0"
					and next.name == "left__v1"
					and var_name(tail) == Some("left__v1")
				)

				break
			_:
				valid = False

	valid and final_right_versions_are_ordered and logical_count == DEEP_LOGICAL_COUNT


tests: TestSuite = {
	description = "Blorp compiler Core SSA",
	tests = [
		("classifies no assignment", test_classifies_no_assignment),
		("classifies straight line assignment", test_classifies_straight_line_assignment),
		("classifies control flow assignment", test_classifies_control_flow_assignment),
		("no assignment makes binding immutable", test_no_assignment_makes_binding_immutable),
		(
			"unrelated assignment does not version binding",
			test_unrelated_assignment_does_not_version_binding,
		),
		(
			"straight line assignment versions binding",
			test_straight_line_assignment_versions_binding,
		),
		("assignment rhs uses previous version", test_assignment_rhs_uses_previous_version),
		("multiple assignments form version chain", test_multiple_assignments_form_version_chain),
		(
			"terminal assignment versions binding and returns void",
			test_terminal_assignment_versions_binding_and_returns_void,
		),
		(
			"nested let shadowing preserves inner body",
			test_nested_let_shadowing_preserves_inner_body,
		),
		("lambda param shadowing preserves body", test_lambda_param_shadowing_preserves_body),
		("loop binder shadowing preserves body", test_loop_binder_shadowing_preserves_body),
		(
			"pattern shadowing preserves match arm body",
			test_pattern_shadowing_preserves_match_arm_body,
		),
		("constructor match binding shadowing", test_constructor_match_binding_shadowing),
		(
			"constructor match descends into case body",
			test_constructor_match_descends_into_case_body,
		),
		(
			"resource scope shadowing preserves body and cleanup",
			test_resource_scope_shadowing_preserves_body_and_cleanup,
		),
		(
			"shadowed resource assignment does not version outer",
			test_shadowed_resource_assignment_does_not_version_outer,
		),
		("control flow assignment survives", test_control_flow_assignment_survives),
		(
			"program threads one counter across declarations",
			test_program_threads_one_counter_across_declarations,
		),
		("fresh versions drop source identity", test_fresh_versions_drop_source_identity),
		("expression siblings thread one counter", test_expression_siblings_thread_one_counter),
		("long sequence is stack bounded", test_long_sequence_is_stack_bounded),
		(
			"nested sequence substitution is stack bounded",
			test_nested_sequence_substitution_is_stack_bounded,
		),
		("deep binary spine is stack bounded", test_deep_binary_spine_is_stack_bounded),
		("deep logical chain is stack bounded", test_deep_logical_chain_is_stack_bounded),
	]
}
