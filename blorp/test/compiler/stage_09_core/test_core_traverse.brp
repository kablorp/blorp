	test: TestSuite


record TraversalContext {
	replacement: CoreExpr,
	replacement_type: CoreType
}


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func var_expr(name: String) -> CoreExpr:
	VarExpr(named_var(name), int_type(), SyntheticSourceLoc)


pure func replacement_expr() -> CoreExpr:
	LiteralExpr(IntLiteral(99), int_type(), SyntheticSourceLoc)


pure func replace_vars(expr: CoreExpr) -> CoreExpr:
	match expr:
		VarExpr(_, _, _):
			replacement_expr()
		_:
			expr


pure func replace_vars_from_context(context: TraversalContext, expr: CoreExpr) -> CoreExpr:
	match expr:
		VarExpr(_, _, _):
			context.replacement
		_:
			expr


pure func replace_types_from_context(context: TraversalContext, _: CoreType) -> CoreType:
	context.replacement_type


pure func core_exprs_equal(left: CoreExpr, right: CoreExpr) -> Bool:
	core_expr_to_json(left).to_string() == core_expr_to_json(right).to_string()


pure func test_maps_pre_closure_detach_body() -> Bool:
	expr: CoreExpr = PreClosureDetachExpr(var_expr("captured"), VoidType, SyntheticSourceLoc)
	expected: CoreExpr = PreClosureDetachExpr(replacement_expr(), VoidType, SyntheticSourceLoc)

	core_exprs_equal(
		map_core_expr_children(expr, replace_vars),
		expected,
	)


pure func test_maps_record_cow_replacements_and_source_without_materializing_inherited_fields(

) -> Bool:
	record_type: CoreType = HeapRecordType("Pair")
	fields: List[CoreRecordCowField] = [
		{
			field = {
				name = "changed",
				typ = int_type(),
				release_policy = NoReleasePolicy
			},
			replacement = Some(var_expr("replacement"))
		},
		{
			field = {
				name = "inherited",
				typ = int_type(),
				release_policy = NoReleasePolicy
			},
			replacement = None
		},
	]
	expr: CoreExpr = RecordCowUpdateExpr(
		VarExpr(named_var("source"), record_type, SyntheticSourceLoc),
		fields,
		record_type,
		SyntheticSourceLoc,
	)
	expected: CoreExpr = RecordCowUpdateExpr(
		replacement_expr(),
		[
			{
				field = {
					name = "changed",
					typ = int_type(),
					release_policy = NoReleasePolicy
				},
				replacement = Some(replacement_expr())
			},
			{
				field = {
					name = "inherited",
					typ = int_type(),
					release_policy = NoReleasePolicy
				},
				replacement = None
			},
		],
		record_type,
		SyntheticSourceLoc,
	)

	core_exprs_equal(
		map_core_expr_children(expr, replace_vars),
		expected,
	)


pure func test_context_mapper_releases_managed_capture() -> Bool:
	context: TraversalContext = {
		replacement = replacement_expr(),
		replacement_type = NamedType("Mapped", [])
	}
	expr: CoreExpr = PreClosureDetachExpr(var_expr("captured"), VoidType, SyntheticSourceLoc)
	expected: CoreExpr = PreClosureDetachExpr(replacement_expr(), VoidType, SyntheticSourceLoc)

	core_exprs_equal(
		map_core_expr_children_with_context(expr, context, replace_vars_from_context),
		expected,
	)


pure func test_context_expr_and_type_mappers_release_managed_capture() -> Bool:
	mapped_type: CoreType = NamedType("Mapped", [])
	context: TraversalContext = {
		replacement = replacement_expr(),
		replacement_type = mapped_type
	}
	expr: CoreExpr = PreClosureDetachExpr(var_expr("captured"), VoidType, SyntheticSourceLoc)
	expected: CoreExpr = PreClosureDetachExpr(replacement_expr(), mapped_type, SyntheticSourceLoc)

	core_exprs_equal(
		map_core_expr_children_and_types_with_context(
			expr,
			context,
			replace_vars_from_context,
			replace_types_from_context,
		),
		expected,
	)


pure func test_maps_every_select_child() -> Bool:
	recv_arm: CoreSelectArm = {
		kind = SelectRecvArm({
			binder = named_var("item"),
			elem_type = int_type(),
			channel = var_expr("channel"),
		}),
		body = var_expr("recv_body"),
		loc = SyntheticSourceLoc
	}
	after_arm: CoreSelectArm = {
		kind = SelectAfterArm(var_expr("timeout")),
		body = var_expr("after_body"),
		loc = SyntheticSourceLoc
	}
	expected_recv_arm: CoreSelectArm = {
		kind = SelectRecvArm({
			binder = named_var("item"),
			elem_type = int_type(),
			channel = replacement_expr(),
		}),
		body = replacement_expr(),
		loc = SyntheticSourceLoc
	}
	expected_after_arm: CoreSelectArm = {
		kind = SelectAfterArm(replacement_expr()),
		body = replacement_expr(),
		loc = SyntheticSourceLoc
	}
	expr: CoreExpr = SelectExpr(
		[recv_arm, after_arm],
		VoidType,
		SyntheticSourceLoc,
	)
	expected: CoreExpr = SelectExpr(
		[expected_recv_arm, expected_after_arm],
		VoidType,
		SyntheticSourceLoc,
	)

	core_exprs_equal(
		map_core_expr_children(expr, replace_vars),
		expected,
	)


pure func test_maps_semantic_match_scrutinee_and_tree_bodies() -> Bool:
	tree = SemanticLiteralMatch(
		RootSemanticMatchAccessor,
		[
			{
				literal = IntLiteral(1),
				body = SemanticMatchLeaf([], var_expr("case_body"))
			},
		],
		SemanticMatchLeaf(
			[],
			var_expr("fallback_body"),
		),
	)
	expected_tree = SemanticLiteralMatch(
		RootSemanticMatchAccessor,
		[
			{
				literal = IntLiteral(1),
				body = SemanticMatchLeaf([], replacement_expr())
			},
		],
		SemanticMatchLeaf(
			[],
			replacement_expr(),
		),
	)
	expr = SemanticMatchExpr(var_expr("scrutinee"), tree, int_type(), SyntheticSourceLoc)
	expected = SemanticMatchExpr(replacement_expr(), expected_tree, int_type(), SyntheticSourceLoc)

	core_exprs_equal(
		map_core_expr_children(expr, replace_vars),
		expected,
	)


pure func test_splits_and_rebuilds_sequence_spine() -> Bool:
	expr: CoreExpr = SeqExpr(
		var_expr("first"),
		SeqExpr(var_expr("second"), var_expr("final")),
	)
	spine = split_core_sequence(expr)

	(
		spine.preceding_items.length() == 2
		and core_exprs_equal(spine.final_item, var_expr("final"))
		and core_exprs_equal(rebuild_core_sequence(spine), expr)
	)


pure func identity_expr(expr: CoreExpr) -> CoreExpr:
	expr


pure func replace_middle_var(expr: CoreExpr) -> CoreExpr:
	match expr:
		VarExpr(variable, _, _):
			if variable.name == "middle":
				replacement_expr()
			else:
				expr
		_:
			expr


-- One expression per traversal family: a leaf, a plain child-and-type node, an
-- expression list, a dictionary-entry list, a record-field list, a COW-field
-- list, a literal-match case list with a fallback, a select-arm list, and a
-- semantic match tree.
pure func reusable_expr_shapes() -> List[CoreExpr]:
	dict_entry: CoreDictLiteralEntry = {
		key = var_expr("key"),
		value = var_expr("value")
	}
	record_field: CoreRecordFieldValue = {
		name = "field",
		value = var_expr("field_value")
	}
	cow_field: CoreRecordCowField = {
		field = {
			name = "changed",
			typ = int_type(),
			release_policy = NoReleasePolicy
		},
		replacement = Some(var_expr("replacement"))
	}
	match_case: CoreLiteralMatchCase = {
		literal = IntLiteral(1),
		bindings = [],
		body = var_expr("case_body")
	}
	select_arm: CoreSelectArm = {
		kind = SelectAfterArm(var_expr("timeout")),
		body = var_expr("after_body"),
		loc = SyntheticSourceLoc
	}

	[
		var_expr("leaf"),
		LiteralExpr(IntLiteral(7), int_type(), SyntheticSourceLoc),
		SeqExpr(var_expr("first"), var_expr("second")),
		IfExpr(
			var_expr("cond"),
			var_expr("then_branch"),
			var_expr("else_branch"),
			int_type(),
			SyntheticSourceLoc,
		),
		CallExpr(
			BuiltinCall("blorp_print"),
			var_expr("callee"),
			[var_expr("first_arg"), var_expr("second_arg")],
			int_type(),
			SyntheticSourceLoc,
		),
		DictExpr([dict_entry], int_type(), SyntheticSourceLoc),
		RecordExpr([record_field], HeapRecordType("Pair"), SyntheticSourceLoc),
		RecordCowUpdateExpr(
			var_expr("source"),
			[cow_field],
			HeapRecordType("Pair"),
			SyntheticSourceLoc,
		),
		LiteralMatchExpr(
			var_expr("scrutinee"),
			[match_case],
			LiteralMatchFallbackBody(var_expr("fallback_body")),
			int_type(),
			SyntheticSourceLoc,
		),
		SelectExpr([select_arm], VoidType, SyntheticSourceLoc),
		SemanticMatchExpr(
			var_expr("scrutinee"),
			SemanticLiteralMatch(
				RootSemanticMatchAccessor,
				[
					{
						literal = IntLiteral(1),
						body = SemanticMatchLeaf([], var_expr("case_body"))
					},
				],
				SemanticMatchFail,
			),
			int_type(),
			SyntheticSourceLoc,
		),
		PreClosureDetachExpr(var_expr("captured"), VoidType, SyntheticSourceLoc),
	]


pure func test_identity_mapper_reuses_every_node_shape() -> Bool:
	var reused: Int = 0
	shapes: List[CoreExpr] = reusable_expr_shapes()

	for shape in shapes:
		if same_object(
			map_core_expr_children(shape, identity_expr),
			shape,
		):
			reused += 1

	reused == shapes.length()


pure func test_identity_mapper_reuses_logical_tree_and_sequence() -> Bool:
	logical: CoreExpr = LogicalExpr(
		AndOp,
		LogicalExpr(AndOp, var_expr("a"), var_expr("b"), int_type(), SyntheticSourceLoc),
		var_expr("c"),
		int_type(),
		SyntheticSourceLoc,
	)
	sequence: CoreExpr = SeqExpr(
		var_expr("first"),
		SeqExpr(var_expr("second"), var_expr("final")),
	)

	same_object(
		map_core_logical_tree(logical, identity_expr),
		logical,
	) and same_object(
		map_core_sequence_items(sequence, identity_expr),
		sequence,
	)


pure func test_changed_leaf_rebuilds_only_the_spine() -> Bool:
	first_arg: CoreExpr = var_expr("first")
	middle_arg: CoreExpr = var_expr("middle")
	last_arg: CoreExpr = var_expr("last")
	callee: CoreExpr = var_expr("callee")
	call: CoreExpr = CallExpr(
		BuiltinCall("blorp_print"),
		callee,
		[first_arg, middle_arg, last_arg],
		int_type(),
		SyntheticSourceLoc,
	)
	outer: CoreExpr = SeqExpr(var_expr("untouched"), call)
	mapped_outer: CoreExpr = map_core_expr_children(
		outer,
		pure func(child: CoreExpr): map_core_expr_children(child, replace_middle_var),
	)

	match mapped_outer:
		SeqExpr(mapped_first, mapped_call):
			match outer:
				SeqExpr(original_first, _):
					match mapped_call:
						CallExpr(_, mapped_callee, mapped_args, _, _):
							(
								not same_object(mapped_outer, outer)
								and not same_object(mapped_call, call)
								and same_object(mapped_first, original_first)
								and same_object(mapped_callee, callee)
								and same_object(
									mapped_args.get_or(0, callee),
									first_arg,
								)
								and not same_object(
									mapped_args.get_or(1, callee),
									middle_arg,
								)
								and same_object(
									mapped_args.get_or(2, callee),
									last_arg,
								)
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_pattern_binding_membership_matches_ordered_projection() -> Bool:
	patterns = [
		NamePattern("direct"),
		ConstructorPattern(
			"Outer",
			[
				NamePattern("early"),
				QualifiedConstructorPattern(
					"module",
					"Inner",
					[
						TuplePattern([
							NamePattern("duplicate"),
							ListPattern(
								[
									WildcardPattern,
									LiteralPattern(IntLiteral(1)),
									NamePattern("late"),
								],
								Some(NamePattern("spread")),
							),
						]),
					],
				),
				NamePattern("duplicate"),
			],
		),
		OrPattern([NamePattern("left"), NamePattern("right")]),
		ListPattern([], Some(ConstructorPattern("Spread", [NamePattern("nested_spread")]))),
		WildcardPattern,
		LiteralPattern(IntLiteral(2)),
	]
	targets = [
		"direct",
		"early",
		"duplicate",
		"late",
		"spread",
		"left",
		"right",
		"nested_spread",
		"missing",
	]
	var equivalent: Bool = True

	for pattern in patterns:
		for target in targets:
			if core_pattern_binds_name(
				pattern,
				target,
			) != core_pattern_bound_names(pattern).contains(target):
				equivalent = False

	equivalent


-- ============================================================================
-- Stateful traversal: sibling order and state threading, per node family.

pure func record_visit_order(
	state: List[String],
	expr: CoreExpr,
) -> CoreMapState[List[String], CoreExpr]:
	match expr:
		VarExpr(variable, _, _):
			{ state = state.append(variable.name), value = replacement_expr() }
		_:
			{ state = state, value = expr }


pure func state_identity_expr(state: Int, expr: CoreExpr) -> CoreMapState[Int, CoreExpr]:
	{ state = state, value = expr }


pure func test_state_leaf_family_passes_state_through_unchanged() -> Bool:
	shapes: List[CoreExpr] = [
		var_expr("leaf"),
		LiteralExpr(IntLiteral(7), int_type(), SyntheticSourceLoc),
		VoidExpr(VoidType, SyntheticSourceLoc),
	]
	var all_ok: Bool = True

	for shape in shapes:
		result: CoreMapState[Int, CoreExpr] = map_core_leaf_children_with_state(
			3,
			state_identity_expr,
			shape,
		)

		if not (same_object(result.value, shape) and result.state == 3):
			all_ok = False

	all_ok


pure func test_state_operator_family_threads_binary_sibling_order() -> Bool:
	expr: CoreExpr = BinaryExpr(
		AddOp,
		var_expr("left"),
		var_expr("right"),
		int_type(),
		SyntheticSourceLoc,
	)
	result: CoreMapState[List[String], CoreExpr] = map_core_operator_children_with_state(
		[],
		record_visit_order,
		expr,
	)
	expected: CoreExpr = BinaryExpr(AddOp, replacement_expr(), replacement_expr(), int_type(), SyntheticSourceLoc)

	result.state == ["left", "right"] and core_exprs_equal(result.value, expected)


pure func test_state_operator_family_threads_if_sibling_order() -> Bool:
	expr: CoreExpr = IfExpr(
		var_expr("cond"),
		var_expr("then_branch"),
		var_expr("else_branch"),
		int_type(),
		SyntheticSourceLoc,
	)
	result: CoreMapState[List[String], CoreExpr] = map_core_operator_children_with_state(
		[],
		record_visit_order,
		expr,
	)

	result.state == ["cond", "then_branch", "else_branch"]


pure func test_state_operator_family_identity_mapper_reuses_shape() -> Bool:
	shapes: List[CoreExpr] = [
		SeqExpr(var_expr("first"), var_expr("second")),
		IfExpr(
			var_expr("cond"),
			var_expr("then_branch"),
			var_expr("else_branch"),
			int_type(),
			SyntheticSourceLoc,
		),
	]
	var reused: Int = 0

	for shape in shapes:
		result: CoreMapState[Int, CoreExpr] = map_core_operator_children_with_state(
			0,
			state_identity_expr,
			shape,
		)

		if same_object(result.value, shape):
			reused += 1

	reused == shapes.length()


pure func test_state_aggregate_family_threads_call_args_order() -> Bool:
	expr: CoreExpr = CallExpr(
		BuiltinCall("blorp_print"),
		var_expr("callee"),
		[var_expr("a"), var_expr("b"), var_expr("c")],
		int_type(),
		SyntheticSourceLoc,
	)
	result: CoreMapState[List[String], CoreExpr] = map_core_aggregate_children_with_state(
		[],
		record_visit_order,
		expr,
	)

	result.state == ["callee", "a", "b", "c"]


pure func test_state_aggregate_family_threads_record_cow_update_order() -> Bool:
	cow_field: CoreRecordCowField = {
		field = {
			name = "changed",
			typ = int_type(),
			release_policy = NoReleasePolicy
		},
		replacement = Some(var_expr("replacement"))
	}
	expr: CoreExpr = RecordCowUpdateExpr(
		var_expr("source"),
		[cow_field],
		HeapRecordType("Pair"),
		SyntheticSourceLoc,
	)
	result: CoreMapState[List[String], CoreExpr] = map_core_aggregate_children_with_state(
		[],
		record_visit_order,
		expr,
	)

	-- Fields visit before source, matching `immediate_core_expr_children`'s
	-- `fields...concat([source])` order.
	result.state == ["replacement", "source"]


pure func test_state_aggregate_family_threads_select_arm_order() -> Bool:
	recv_arm: CoreSelectArm = {
		kind = SelectRecvArm({
			binder = named_var("item"),
			elem_type = int_type(),
			channel = var_expr("channel"),
		}),
		body = var_expr("recv_body"),
		loc = SyntheticSourceLoc
	}
	after_arm: CoreSelectArm = {
		kind = SelectAfterArm(var_expr("timeout")),
		body = var_expr("after_body"),
		loc = SyntheticSourceLoc
	}
	expr: CoreExpr = SelectExpr([recv_arm, after_arm], VoidType, SyntheticSourceLoc)
	result: CoreMapState[List[String], CoreExpr] = map_core_aggregate_children_with_state(
		[],
		record_visit_order,
		expr,
	)

	-- Each arm's kind visits before its body, matching
	-- `immediate_core_expr_children`'s `select_arm_kind_items(arm.kind).append(arm.body)`.
	result.state == ["channel", "recv_body", "timeout", "after_body"]


pure func test_state_aggregate_family_identity_mapper_reuses_shape() -> Bool:
	dict_entry: CoreDictLiteralEntry = {
		key = var_expr("key"),
		value = var_expr("value")
	}
	record_field: CoreRecordFieldValue = {
		name = "field",
		value = var_expr("field_value")
	}
	shapes: List[CoreExpr] = [
		CallExpr(
			BuiltinCall("blorp_print"),
			var_expr("callee"),
			[var_expr("first_arg"), var_expr("second_arg")],
			int_type(),
			SyntheticSourceLoc,
		),
		DictExpr([dict_entry], int_type(), SyntheticSourceLoc),
		RecordExpr([record_field], HeapRecordType("Pair"), SyntheticSourceLoc),
		SelectExpr(
			[{
				kind = SelectAfterArm(var_expr("timeout")),
				body = var_expr("after_body"),
				loc = SyntheticSourceLoc
			}],
			VoidType,
			SyntheticSourceLoc,
		),
	]
	var reused: Int = 0

	for shape in shapes:
		result: CoreMapState[Int, CoreExpr] = map_core_aggregate_children_with_state(
			0,
			state_identity_expr,
			shape,
		)

		if same_object(result.value, shape):
			reused += 1

	reused == shapes.length()


