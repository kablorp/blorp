pure func test_state_concurrency_family_threads_pre_closure_block_order() -> Bool:
	binding_one: CorePreClosureConcurrentBinding = {
		variable = named_var("b1"),
		typ = int_type(),
		rhs = var_expr("rhs1")
	}
	binding_two: CorePreClosureConcurrentBinding = {
		variable = named_var("b2"),
		typ = int_type(),
		rhs = var_expr("rhs2")
	}
	expr: CoreExpr = PreClosureConcurrentExpr(
		{
			bindings = [binding_one, binding_two],
			body = var_expr("body"),
			timeout = Some(var_expr("timeout")),
			max_threads = None
		},
		VoidType,
		SyntheticSourceLoc,
	)
	result: CoreMapState[List[String], CoreExpr] = map_core_concurrency_children_with_state(
		[],
		record_visit_order,
		expr,
	)

	-- Matches `immediate_core_expr_children`'s
	-- `block.bindings.map(rhs).append(body).concat(optional_expr_items(timeout))`.
	result.state == ["rhs1", "rhs2", "body", "timeout"]


pure func test_state_concurrency_family_identity_mapper_reuses_shape() -> Bool:
	binding: CorePreClosureConcurrentBinding = {
		variable = named_var("b1"),
		typ = int_type(),
		rhs = var_expr("rhs1")
	}
	shapes: List[CoreExpr] = [
		PreClosureConcurrentExpr(
