pure func test_state_storage_family_threads_string_byte_copy_order() -> Bool:
	expr: CoreExpr = StringByteCopyExpr(
		{
			dst = var_expr("dst"),
			dst_pos = var_expr("dst_pos"),
			src = var_expr("src"),
			src_pos = var_expr("src_pos"),
			len = var_expr("len")
		},
		int_type(),
		SyntheticSourceLoc,
	)
	result: CoreMapState[List[String], CoreExpr] = map_core_storage_children_with_state(
		[],
		record_visit_order,
		expr,
	)

	result.state == ["dst", "dst_pos", "src", "src_pos", "len"]


pure func test_state_storage_family_threads_tensor_raw_fill_order() -> Bool:
	expr: CoreExpr = TensorRawFillExpr(
		{
			raw_kind = TensorFloat64Elements,
			value = var_expr("value"),
			dims = [var_expr("dim0"), var_expr("dim1")]
		},
		int_type(),
		SyntheticSourceLoc,
	)
	result: CoreMapState[List[String], CoreExpr] = map_core_storage_children_with_state(
		[],
		record_visit_order,
		expr,
	)

	-- The fill value visits before its dims, matching
	-- `immediate_core_expr_children`'s `[fill.value].concat(fill.dims)`.
	result.state == ["value", "dim0", "dim1"]


pure func test_state_storage_family_identity_mapper_reuses_shape() -> Bool:
	shapes: List[CoreExpr] = [
		StringByteCopyExpr(
			{
				dst = var_expr("dst"),
				dst_pos = var_expr("dst_pos"),
				src = var_expr("src"),
				src_pos = var_expr("src_pos"),
				len = var_expr("len")
			},
			int_type(),
			SyntheticSourceLoc,
		),
		TensorRawFillExpr(
			{
				raw_kind = TensorFloat64Elements,
				value = var_expr("value"),
				dims = [var_expr("dim0")]
			},
			int_type(),
			SyntheticSourceLoc,
		),
	]
	var reused: Int = 0

	for shape in shapes:
		result: CoreMapState[Int, CoreExpr] = map_core_storage_children_with_state(
			0,
			state_identity_expr,
			shape,
		)

		if same_object(result.value, shape):
			reused += 1

	reused == shapes.length()


pure func range_binder(name: String) -> CoreLoopBinder:
	{
		variable = named_var(name),
		typ = int_type(),
		range_direction = RangeForwardOnly
	}


pure func test_state_loop_family_threads_for_range_order() -> Bool:
	expr: CoreExpr = ForRangeExpr(
		range_binder("i"),
		var_expr("start"),
		var_expr("end_value"),
		var_expr("body"),
		int_type(),
		SyntheticSourceLoc,
	)
	result: CoreMapState[List[String], CoreExpr] = map_core_loop_children_with_state(
		[],
		record_visit_order,
		expr,
	)

	-- Matches `immediate_core_expr_children`'s `[start, end_value, body]`.
	result.state == ["start", "end_value", "body"]


