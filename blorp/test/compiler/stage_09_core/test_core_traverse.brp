pure func test_state_match_family_threads_raw_match_case_order() -> Bool:
	expr: CoreExpr = RawMatchExpr(
		var_expr("scrutinee"),
		[
			{ pattern = WildcardPattern, body = var_expr("case_one") },
			{ pattern = WildcardPattern, body = var_expr("case_two") },
		],
		int_type(),
		SyntheticSourceLoc,
	)
	result: CoreMapState[List[String], CoreExpr] = map_core_match_children_with_state(
		[],
		record_visit_order,
		expr,
	)

	-- Matches `immediate_core_expr_children`'s
	-- `[scrutinee].concat(cases.map(body))`.
	result.state == ["scrutinee", "case_one", "case_two"]


pure func test_state_match_family_identity_mapper_reuses_shape() -> Bool:
	shapes: List[CoreExpr] = [
		RawMatchExpr(
			var_expr("scrutinee"),
			[{ pattern = WildcardPattern, body = var_expr("case_one") }],
			int_type(),
			SyntheticSourceLoc,
		),
	]
	var reused: Int = 0

	for shape in shapes:
		result: CoreMapState[Int, CoreExpr] = map_core_match_children_with_state(
