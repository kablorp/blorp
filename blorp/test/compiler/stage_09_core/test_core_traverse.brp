pure func test_state_dispatcher_routes_every_family() -> Bool:
	binary: CoreExpr = BinaryExpr(
		AddOp,
		var_expr("left"),
		var_expr("right"),
		int_type(),
		SyntheticSourceLoc,
	)
	call: CoreExpr = CallExpr(
		BuiltinCall("blorp_print"),
		var_expr("callee"),
		[var_expr("arg")],
		int_type(),
		SyntheticSourceLoc,
	)
	string_copy: CoreExpr = StringByteCopyExpr(
		{
			dst = var_expr("dst"),
			dst_pos = var_expr("dst_pos"),
			src = var_expr("src"),
			src_pos = var_expr("src_pos"),
			len = var_expr("len")
		},
		int_type(),
		SyntheticSourceLoc,
	)
	for_range: CoreExpr = ForRangeExpr(
		range_binder("i"),
		var_expr("start"),
		var_expr("end_value"),
		var_expr("body"),
		int_type(),
		SyntheticSourceLoc,
	)
	raw_match: CoreExpr = RawMatchExpr(
		var_expr("scrutinee"),
		[{ pattern = WildcardPattern, body = var_expr("case_body") }],
		int_type(),
		SyntheticSourceLoc,
	)
	logical: CoreExpr = LogicalExpr(
		AndOp,
		var_expr("a"),
		var_expr("b"),
		int_type(),
		SyntheticSourceLoc,
	)
	leaf: CoreExpr = var_expr("leaf")

	var all_ok: Bool = True

	for shape in [binary, call, string_copy, for_range, raw_match, logical, leaf]:
		result: CoreMapState[Int, CoreExpr] = map_core_expr_children_with_state(
			0,
			state_identity_expr,
			shape,
		)

		if not same_object(result.value, shape):
			all_ok = False

	all_ok


