import:
	../../../src/compiler/stage_05_types/language_surface_manifest:
		DeclaredAbiType(DeclaredAbiOption, DeclaredAbiResult),
	../../../src/compiler/stage_09_core/ir:
		CoreDecl(
			FunctionDecl,
			GlobalDecl,
			HeapRecordDecl,
			ImplDecl,
			TraitDecl,
			TypeAliasDecl,
			UnionDecl,
			ValueRecordDecl,
		),
		CoreExpr(RecordExpr, VarExpr, VoidExpr),
		CoreFunction,
		CoreFunctionKind(UnresolvedBuiltinFunction, UserFunction),
		CoreProgram,
		CoreReleasePolicy(ArcReleasePolicy, NoReleasePolicy),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(
			BoxedResultType,
			HeapRecordType,
			NamedType,
			StackResultType,
			TypeParameterType,
			VoidType,
		),
		CoreUnionField,
		CoreUnionPayloadStorage(ErasedUnionPayloadStorage, TypedUnionPayloadStorage),
		CoreUnionVariant,
		CoreVar,
		core_type_to_json,
	../../../src/compiler/stage_09_core/runtime_projection:
		CoreRuntimeProjectionError,
		core_runtime_projection_error_message,
		project_runtime_program,
	test: TestSuite


pure func boundary_function(
	name: String,
	type_params: List[String],
	has_body: Bool,
) -> CoreFunction:
	body: Option[CoreExpr] = if has_body:
		Some(VoidExpr(VoidType, SyntheticSourceLoc))
	else:
		None

	function_kind: CoreFunctionKind = if has_body:
		UserFunction
	else:
		UnresolvedBuiltinFunction

	{
		name = name,
		source_module = None,
		type_params = type_params,
		params = [],
		return_type = VoidType,
		body = body,
		is_pure = True,
		function_kind = function_kind,
		def_id = 1,
		loc = SyntheticSourceLoc
	}


pure func boundary_union(name: String, type_params: List[String]) -> CoreDecl:
	payload_storage: CoreUnionPayloadStorage = if type_params.is_empty():
		TypedUnionPayloadStorage
	else:
		ErasedUnionPayloadStorage

	UnionDecl({
		abi_type = None,
		name = name,
		type_params = type_params,
		payload_storage = payload_storage,
		variants = [],
		loc = SyntheticSourceLoc,
	})


pure func abi_union_variant(
	name: String,
	tag: Int,
	payload_type_parameter: Option[String],
) -> CoreUnionVariant:
	fields: List[CoreUnionField] = match payload_type_parameter:
		Some(type_parameter):
			[
				{
					typ = TypeParameterType(type_parameter),
					release_policy = NoReleasePolicy
				},
			]
		None:
			[]

	{
		name = name,
		c_name = name,
		tag_c_name = "TAG_${name}",
		tag = tag,
		fields = fields,
		def_id = None
	}


pure func runtime_option_union() -> CoreDecl:
	UnionDecl({
		abi_type = Some(DeclaredAbiOption),
		name = "Option",
		type_params = ["T"],
		payload_storage = ErasedUnionPayloadStorage,
		variants = [abi_union_variant("Some", 0, Some("T")), abi_union_variant("None", 1, None)],
		loc = SyntheticSourceLoc,
	})


pure func runtime_result_union() -> CoreDecl:
	UnionDecl({
		abi_type = Some(DeclaredAbiResult),
		name = "Result",
		type_params = ["T", "E"],
		payload_storage = ErasedUnionPayloadStorage,
		variants = [abi_union_variant("Ok", 0, Some("T")), abi_union_variant("Err", 1, Some("E"))],
		loc = SyntheticSourceLoc,
	})


pure func boundary_decl_name(decl: CoreDecl) -> String:
	match decl:
		FunctionDecl(function_info):
			"function:${function_info.name}"
		UnionDecl(union_decl):
			"union:${union_decl.name}"
		ValueRecordDecl(record_decl):
			"value_record:${record_decl.name}"
		HeapRecordDecl(record_decl):
			"heap_record:${record_decl.name}"
		TypeAliasDecl(alias_decl):
			"alias:${alias_decl.name}"
		TraitDecl(trait_decl):
			"trait:${trait_decl.name}"
		ImplDecl(impl_decl):
			"impl:${impl_decl.trait_name}"
		_:
			"other"


pure func test_projects_only_runtime_declarations() -> Bool:
	t: CoreType = TypeParameterType("T")
	source: CoreProgram = {
		decls = [
			FunctionDecl(boundary_function("generic", ["T"], True)),
			FunctionDecl(boundary_function("main", [], True)),
			FunctionDecl(boundary_function("deferred", [], False)),
			boundary_union("Container", ["T"]),
			boundary_union("std_channel__RecvAttempt", ["T"]),
			runtime_option_union(),
			runtime_result_union(),
			boundary_union("Container__mono_Int", []),
			ValueRecordDecl({
				abi_type = None,
				name = "Box",
				type_params = ["T"],
				fields = [],
				loc = SyntheticSourceLoc,
			}),
			HeapRecordDecl({
				abi_type = None,
				name = "Node",
				type_params = ["T"],
				fields = [],
				loc = SyntheticSourceLoc,
			}),
			TypeAliasDecl({
				abi_type = None,
				name = "Alias",
				type_params = ["T"],
				target = t,
				is_opaque = False,
				loc = SyntheticSourceLoc,
			}),
			TraitDecl({
				name = "Display",
				type_params = [],
				supertraits = [],
				methods = [],
				loc = SyntheticSourceLoc,
			}),
			ImplDecl({
				trait_name = "GenericDisplay",
				for_type = t,
				type_params = [
					{
						name = "T",
						bounds = []
					},
				],
				methods = [],
				loc = SyntheticSourceLoc,
			}),
			ImplDecl({
				trait_name = "UnresolvedDisplay",
				for_type = t,
				type_params = [],
				methods = [],
				loc = SyntheticSourceLoc,
			}),
			ImplDecl({
				trait_name = "GenericMethodDisplay",
				for_type = NamedType("Int", []),
				type_params = [],
				methods = [boundary_function("display", ["T"], True)],
				loc = SyntheticSourceLoc,
			}),
			ImplDecl({
				trait_name = "Display",
				for_type = NamedType("Int", []),
				type_params = [],
				methods = [boundary_function("to_string", [], True)],
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = ["runtime.h"]
	}

	match project_runtime_program(source):
		Ok(projected):
			(
				projected.decls.map(
					boundary_decl_name,
				) == [
					"function:main",
					"function:deferred",
					"union:Option",
					"union:Result",
					"union:Container__mono_Int",
					"function:Display_to_string_Int",
				]
				and projected.foreign_includes == ["runtime.h"]
			)
		Err(_):
			False


pure func test_rejects_malformed_runtime_abi_templates() -> Bool:
	source: CoreProgram = {
		decls = [
			UnionDecl({
				abi_type = Some(DeclaredAbiOption),
				name = "Option",
				type_params = ["T"],
				payload_storage = ErasedUnionPayloadStorage,
				variants = [
					abi_union_variant("Some", 1, Some("T")),
					abi_union_variant("None", 0, None),
				],
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}

	match project_runtime_program(source):
		Err(error):
			core_runtime_projection_error_message(error).contains("`Option`")
		_:
			False


pure func test_runtime_abi_payloads_use_dynamic_release_masks() -> Bool:
	source: CoreProgram = {
		decls = [runtime_option_union(), runtime_result_union()],
		foreign_includes = []
	}

	match project_runtime_program(source):
		Ok(projected):
			var payload_fields: Int = 0
			var releasable_fields: Int = 0

			for decl in projected.decls:
				match decl:
					UnionDecl(union_decl):
						for variant in union_decl.variants:
							for field in variant.fields:
								payload_fields += 1

								match field.release_policy:
									ArcReleasePolicy:
										releasable_fields += 1
									_:
										void
					_:
						void

			payload_fields == 3 and releasable_fields == payload_fields
		Err(_):
			False


pure func test_canonicalizes_declared_runtime_types() -> Bool:
	config_type: CoreType = NamedType("Config", [])
	source: CoreProgram = {
		decls = [
			HeapRecordDecl({
				abi_type = None,
				name = "Config",
				type_params = [],
				fields = [],
				loc = SyntheticSourceLoc,
			}),
			GlobalDecl({
				name = {
					name = "config",
					uniq = 0,
					def_id = Some(2)
				},
				source_module = None,
				typ = config_type,
				init = RecordExpr([], config_type, SyntheticSourceLoc),
				is_mutable = False,
				is_const = True,
				is_private = False,
				def_id = 2,
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}

	match project_runtime_program(source):
		Ok(projected):
			match projected.decls:
				[HeapRecordDecl(_), GlobalDecl(global)]:
					match (global.typ, global.init):
						(HeapRecordType("Config"), RecordExpr(_, HeapRecordType("Config"), _)):
							True
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_canonicalizes_union_field_release_policy() -> Bool:
	source: CoreProgram = {
		decls = [
			HeapRecordDecl({
				abi_type = None,
				name = "Config",
				type_params = [],
				fields = [],
				loc = SyntheticSourceLoc,
			}),
			UnionDecl({
				abi_type = None,
				name = "Payload",
				type_params = [],
				payload_storage = ErasedUnionPayloadStorage,
				variants = [
					{
						name = "WithConfig",
						c_name = "WithConfig",
						tag_c_name = "TAG_Payload_WithConfig",
						tag = 0,
						fields = [
							{
								typ = NamedType("Config", []),
								release_policy = NoReleasePolicy
							},
						],
						def_id = Some(3)
					},
				],
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}

	match project_runtime_program(source):
		Ok(projected):
			match projected.decls:
				[HeapRecordDecl(_), UnionDecl(union_decl)]:
					match union_decl.variants:
						[variant]:
							match variant.fields:
								[field]:
									match (field.typ, field.release_policy):
										(HeapRecordType("Config"), ArcReleasePolicy):
											True
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_canonicalizes_heap_record_field_release_policy() -> Bool:
	source: CoreProgram = {
		decls = [
			HeapRecordDecl({
				abi_type = None,
				name = "Config",
				type_params = [],
				fields = [],
				loc = SyntheticSourceLoc,
			}),
			HeapRecordDecl({
				abi_type = None,
				name = "Registration",
				type_params = [],
				fields = [
					{
						name = "state",
						typ = NamedType("Config", []),
						release_policy = NoReleasePolicy
					},
				],
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}

	match project_runtime_program(source):
		Ok(projected):
			match projected.decls:
				[HeapRecordDecl(_), HeapRecordDecl(registration)]:
					match registration.fields:
						[field]:
							match (field.typ, field.release_policy):
								(HeapRecordType("Config"), ArcReleasePolicy):
									True
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func result_boundary_function(name: String, result_type: CoreType) -> CoreFunction:
	result_var: CoreVar = {
		name = "result",
		uniq = 0,
		def_id = None
	}

	{ boundary_function(name, [], True) |
		return_type = result_type,
		body = Some(VarExpr(result_var, result_type, SyntheticSourceLoc))
	}


pure func function_and_body_have_type(function_info: CoreFunction, expected_type: CoreType) -> Bool:
	expected_json: String = core_type_to_json(expected_type).to_string()

	if core_type_to_json(function_info.return_type).to_string() != expected_json:
		False
	else:
		match function_info.body:
			Some(VarExpr(_, body_type, _)):
				core_type_to_json(body_type).to_string() == expected_json
			_:
				False


pure func projected_function_has_type(
	projected: CoreProgram,
	name: String,
	expected_type: CoreType,
) -> Bool:
	projected.decls.any(func(decl):
		match decl:
			FunctionDecl(function_info):
				(
					function_info.name == name
					and function_and_body_have_type(function_info, expected_type)
				)
			_:
				False
	)


pure func result_representation_program() -> CoreProgram:
	int_type: CoreType = NamedType("Int", [])
	string_type: CoreType = NamedType("String", [])
	config_type: CoreType = NamedType("Config", [])
	concurrency_error_type: CoreType = NamedType("ConcurrencyError", [])
	unknown_type: CoreType = NamedType("UnknownPayload", [])
	stack_result_type: CoreType = NamedType(
		"Result",
		[config_type, string_type],
	)
	boxed_result_type: CoreType = NamedType(
		"Result",
		[unknown_type, int_type],
	)
	{
		decls = [
			runtime_result_union(),
			HeapRecordDecl({
				abi_type = None,
				name = "Config",
				type_params = [],
				fields = [],
				loc = SyntheticSourceLoc,
			}),
			FunctionDecl(result_boundary_function("known_result", stack_result_type)),
			FunctionDecl(
				result_boundary_function(
					"concurrency_result",
					NamedType(
						"Result",
						[int_type, concurrency_error_type],
					),
				),
			),
			FunctionDecl(result_boundary_function("unknown_result", boxed_result_type)),
		],
		foreign_includes = []
	}


pure func test_projects_known_result_to_stack_representation() -> Bool:
	match project_runtime_program(result_representation_program()):
		Ok(projected):
			projected_function_has_type(
				projected,
				"known_result",
				StackResultType(
					HeapRecordType("Config"),
					NamedType("String", []),
				),
			)
		Err(_):
			False


pure func test_preserves_unknown_result_as_boxed_representation() -> Bool:
	match project_runtime_program(result_representation_program()):
		Ok(projected):
			projected_function_has_type(
				projected,
				"unknown_result",
				BoxedResultType(
					NamedType("UnknownPayload", []),
					NamedType("Int", []),
				),
			)
		Err(_):
			False


pure func test_projects_builtin_concurrency_error_result_to_stack_representation() -> Bool:
	match project_runtime_program(result_representation_program()):
		Ok(projected):
			projected_function_has_type(
				projected,
				"concurrency_result",
				StackResultType(
					NamedType("Int", []),
					NamedType("ConcurrencyError", []),
				),
			)
		Err(_):
			False


tests: TestSuite = {
	description = "Blorp Core runtime projection",
	tests = [
		("projects only runtime declarations", test_projects_only_runtime_declarations),
		("rejects malformed runtime ABI templates", test_rejects_malformed_runtime_abi_templates),
		(
			"runtime ABI payloads use dynamic release masks",
			test_runtime_abi_payloads_use_dynamic_release_masks,
		),
		("canonicalizes declared runtime types", test_canonicalizes_declared_runtime_types),
		("canonicalizes union field release policy", test_canonicalizes_union_field_release_policy),
		(
			"canonicalizes heap-record field release policy",
			test_canonicalizes_heap_record_field_release_policy,
		),
		("projects known Result to stack ABI", test_projects_known_result_to_stack_representation),
		(
			"projects builtin ConcurrencyError Result to stack ABI",
			test_projects_builtin_concurrency_error_result_to_stack_representation,
		),
		(
			"preserves unknown Result as boxed ABI",
			test_preserves_unknown_result_as_boxed_representation,
		),
	]
}
