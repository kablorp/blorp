import:
	../../../src/compiler/stage_09_core/ir:
		CoreBinaryOp(
			AddOp,
			DivideOp,
			EqualOp,
			GreaterEqualOp,
			GreaterOp,
			LessEqualOp,
			LessOp,
			ModuloOp,
			MultiplyOp,
			NotEqualOp,
			SubtractOp,
		),
		CoreDecl(FunctionDecl, ImplDecl, ValueRecordDecl),
		CoreExpr(BinaryExpr, UnaryExpr),
		CoreFunction,
		CoreFunctionKind(BuiltinFunction, UnresolvedBuiltinFunction),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreTensorDim(TensorStaticDim),
		CoreType(FunctionType, NamedType, TensorType),
		CoreUnaryOp(NegateOp),
		CoreVar,
	../../../src/compiler/stage_09_core/synth: synthesize_program
	../../../src/compiler/stage_09_core/synth_error:
		CoreSynthError(UnsupportedTensorReductionElement),
	../../../src/compiler/stage_09_core/synth_scalar_operator: synthesize_scalar_operator_impl_body
	test: TestSuite


private INT_TYPE: CoreType = NamedType("Int", [])

private INT16_TYPE: CoreType = NamedType("Int16", [])

private UINT8_TYPE: CoreType = NamedType("UInt8", [])

private FLOAT_TYPE: CoreType = NamedType("Float", [])

private BOOL_TYPE: CoreType = NamedType("Bool", [])

private BYTES_TYPE: CoreType = NamedType("Bytes", [])

private STRING_TYPE: CoreType = NamedType("String", [])

private FIXED_TYPE: CoreType = NamedType("Fixed", [])

private LIST_INT_TYPE: CoreType = NamedType("List", [INT_TYPE])

private DICT_INT_TYPE: CoreType = NamedType(
	"Dict",
	[INT_TYPE, INT_TYPE],
)


pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func param(name: String, typ: CoreType) -> CoreParam:
	{
		name = core_var(name),
		typ = typ,
		loc = SyntheticSourceLoc
	}


pure func builtin_function(
	module_name: String,
	source_name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> CoreFunction:
	{
		name = module_name.replace("/", "_") + "__" + source_name + "__mono_fixture",
		source_module = Some(module_name),
		type_params = [],
		params = params,
		return_type = return_type,
		body = None,
		is_pure = True,
		function_kind = UnresolvedBuiltinFunction,
		def_id = 1,
		loc = SyntheticSourceLoc
	}


private pure func function_was_synthesized_kind(kind: CoreFunctionKind) -> Bool:
	match kind:
		UnresolvedBuiltinFunction:
			False
		_:
			True


pure func function_was_promoted(program: CoreProgram, expected_name: String) -> Bool:
	match program.decls:
		[FunctionDecl(function_info)]:
			(
				function_info.name == expected_name
				and function_info.body.is_some()
				and function_was_synthesized_kind(function_info.function_kind)
			)
		_:
			False


pure func program_with(function_info: CoreFunction) -> CoreProgram:
	{
		decls = [FunctionDecl(function_info)],
		foreign_includes = []
	}


pure func function_is_promoted(function_info: CoreFunction) -> Bool:
	match synthesize_program(program_with(function_info)):
		Ok(program):
			function_was_promoted(program, function_info.name)
		Err(_):
			False


pure func test_synthesis_promotes_successful_family_body() -> Bool:
	function_info = builtin_function("bytes", "length", [param("bytes", BYTES_TYPE)], INT_TYPE)
	program: CoreProgram = {
		decls = [FunctionDecl(function_info)],
		foreign_includes = []
	}

	match synthesize_program(program):
		Ok(result):
			function_was_promoted(result, function_info.name)
		Err(_):
			False


pure func test_synthesis_dispatches_across_families() -> Bool:
	function_info = builtin_function("float", "is_finite", [param("value", FLOAT_TYPE)], BOOL_TYPE)
	program: CoreProgram = {
		decls = [FunctionDecl(function_info)],
		foreign_includes = []
	}

	match synthesize_program(program):
		Ok(result):
			function_was_promoted(result, function_info.name)
		Err(_):
			False


pure func test_synthesis_dispatches_new_family_modules() -> Bool:
	tensor_type: CoreType = TensorType({
		element_type = INT_TYPE,
		dims = [TensorStaticDim(4)],
	})

	[
		builtin_function("string", "length", [param("value", STRING_TYPE)], INT_TYPE),
		builtin_function("list", "length", [param("values", LIST_INT_TYPE)], INT_TYPE),
		builtin_function("dict", "length", [param("values", DICT_INT_TYPE)], INT_TYPE),
		builtin_function(
			"vector",
			"parallel",
			[param("values", tensor_type), param(
					"body",
					FunctionType(True, [tensor_type], tensor_type),
				)],
			tensor_type,
		),
	].all(function_is_promoted)


pure func test_synthesis_uses_program_declarations_for_hash_layout() -> Bool:
	widget_type: CoreType = NamedType("Widget", [])
	dict_type: CoreType = NamedType(
		"Dict",
		[widget_type, INT_TYPE],
	)
	function_info: CoreFunction = builtin_function(
		"dict",
		"set",
		[param("self", dict_type), param("key", widget_type), param("value", INT_TYPE)],
		dict_type,
	)
	program: CoreProgram = {
		decls = [ValueRecordDecl({
				abi_type = None,
				name = "Widget",
				type_params = [],
				fields = [],
				loc = SyntheticSourceLoc,
			}), FunctionDecl(function_info)],
		foreign_includes = []
	}

	match synthesize_program(program):
		Ok(result):
			match result.decls:
				[ValueRecordDecl(_), FunctionDecl(synthesized)]:
					(
						synthesized.body.is_some()
						and function_was_synthesized_kind(synthesized.function_kind)
					)
				_:
					False
		Err(_):
			False


pure func test_synthesis_propagates_family_error() -> Bool:
	tensor_type: CoreType = TensorType({
		element_type = STRING_TYPE,
		dims = [TensorStaticDim(4)],
	})
	function_info: CoreFunction = builtin_function(
		"vector",
		"sum",
		[param("values", tensor_type)],
		STRING_TYPE,
	)

	match synthesize_program(program_with(function_info)):
		Err(UnsupportedTensorReductionElement(name, element_type, _)):
			name == "sum" and element_type == STRING_TYPE
		_:
			False


pure func test_synthesis_records_registry_owned_runtime_identity() -> Bool:
	tensor_type: CoreType = TensorType({
		element_type = INT_TYPE,
		dims = [TensorStaticDim(4)],
	})
	function_info: CoreFunction = builtin_function(
		"vector",
		"max",
		[param("values", tensor_type)],
		INT_TYPE,
	)

	match synthesize_program(program_with(function_info)):
		Ok(program):
			match program.decls:
				[FunctionDecl(synthesized)]:
					match synthesized.function_kind:
						BuiltinFunction(runtime_name):
							synthesized.body.is_some() and runtime_name == "blorp_max"
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_synthesis_preserves_unhandled_builtin() -> Bool:
	function_info = builtin_function("unported", "operation", [param("value", INT_TYPE)], INT_TYPE)
	program: CoreProgram = {
		decls = [FunctionDecl(function_info)],
		foreign_includes = ["example.h"]
	}

	match synthesize_program(program):
		Ok(result):
			match result.decls:
				[FunctionDecl(unchanged)]:
					(
						unchanged.name == function_info.name
						and unchanged.source_module == function_info.source_module
						and unchanged.params.length() == function_info.params.length()
						and unchanged.return_type == function_info.return_type
						and unchanged.body.is_none()
						and unchanged.function_kind == function_info.function_kind
						and result.foreign_includes == ["example.h"]
					)
				_:
					False
		Err(_):
			False


pure func test_synthesis_preserves_multi_decl_order() -> Bool:
	first: CoreFunction = builtin_function(
		"unported",
		"operation",
		[param("value", INT_TYPE)],
		INT_TYPE,
	)
	second: CoreFunction = builtin_function(
		"bytes",
		"length",
		[param("bytes", BYTES_TYPE)],
		INT_TYPE,
	)
	third: CoreFunction = builtin_function(
		"float",
		"is_finite",
		[param("value", FLOAT_TYPE)],
		BOOL_TYPE,
	)
	program: CoreProgram = {
		decls = [FunctionDecl(first), FunctionDecl(second), FunctionDecl(third)],
		foreign_includes = []
	}

	match synthesize_program(program):
		Ok(result):
			match result.decls:
				[FunctionDecl(a), FunctionDecl(b), FunctionDecl(c)]:
					(
						a.name == first.name
						and b.name == second.name
						and c.name == third.name
						and a.body.is_none()
						and b.body.is_some()
						and c.body.is_some()
					)
				_:
					False
		Err(_):
			False


pure func test_synthesis_promotes_concrete_impl_method() -> Bool:
	builtin_method: CoreFunction = builtin_function(
		"string",
		"length",
		[param("self", STRING_TYPE)],
		INT_TYPE,
	)
	method: CoreFunction = { builtin_method | name = "length" }
	program: CoreProgram = {
		decls = [ImplDecl({
				trait_name = "HasLength",
				for_type = STRING_TYPE,
				type_params = [],
				methods = [method],
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}

	match synthesize_program(program):
		Ok(result):
			match result.decls:
				[ImplDecl(impl_info)]:
					match impl_info.methods:
						[synthesized]:
							(
								synthesized.name == "length"
								and synthesized.body.is_some()
								and function_was_synthesized_kind(synthesized.function_kind)
							)
						_:
							False
				_:
					False
		Err(_):
			False


private pure func synthesis_promotes_scalar_operator(
	module_name: String,
	for_type: CoreType,
	trait_name: String,
	method_name: String,
	expected_op: CoreBinaryOp,
	return_type: CoreType,
) -> Bool:
	builtin_method: CoreFunction = builtin_function(
		module_name,
		method_name,
		[param("left", for_type), param("right", for_type)],
		return_type,
	)
	method: CoreFunction = { builtin_method | name = method_name }
	program: CoreProgram = {
		decls = [ImplDecl({
				trait_name = trait_name,
				for_type = for_type,
				type_params = [],
				methods = [method],
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}

	match synthesize_program(program):
		Ok(result):
			match result.decls:
				[ImplDecl(impl_info)]:
					match impl_info.methods:
						[synthesized]:
							match synthesized.body:
								Some(BinaryExpr(op, _, _, result_type, _)):
									op == expected_op and result_type == return_type
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


private pure func synthesis_promotes_scalar_negation(
	module_name: String,
	for_type: CoreType,
) -> Bool:
	builtin_method: CoreFunction = builtin_function(
		module_name,
		"negate",
		[param("value", for_type)],
		for_type,
	)
	method: CoreFunction = { builtin_method | name = "negate" }
	program: CoreProgram = {
		decls = [ImplDecl({
				trait_name = "Negatable",
				for_type = for_type,
				type_params = [],
				methods = [method],
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}

	match synthesize_program(program):
		Ok(result):
			match result.decls:
				[ImplDecl(impl_info)]:
					match impl_info.methods:
						[synthesized]:
							match synthesized.body:
								Some(UnaryExpr(NegateOp, _, result_type, _)):
									result_type == for_type
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_synthesis_promotes_int16_add_impl_to_native_operator() -> Bool:
	synthesis_promotes_scalar_operator("int16", INT16_TYPE, "Addable", "add", AddOp, INT16_TYPE)


pure func test_synthesis_promotes_int16_subtract_impl_to_native_operator() -> Bool:
	synthesis_promotes_scalar_operator(
		"int16",
		INT16_TYPE,
		"Subtractable",
		"subtract",
		SubtractOp,
		INT16_TYPE,
	)


pure func test_synthesis_promotes_int16_multiply_impl_to_native_operator() -> Bool:
	synthesis_promotes_scalar_operator(
		"int16",
		INT16_TYPE,
		"Multipliable",
		"multiply",
		MultiplyOp,
		INT16_TYPE,
	)


pure func test_synthesis_promotes_int16_divide_impl_to_native_operator() -> Bool:
	synthesis_promotes_scalar_operator(
		"int16",
		INT16_TYPE,
		"Divisible",
		"divide",
		DivideOp,
		INT16_TYPE,
	)


pure func test_synthesis_promotes_int16_remainder_impl_to_native_operator() -> Bool:
	synthesis_promotes_scalar_operator(
		"int16",
		INT16_TYPE,
		"Modulable",
		"remainder",
		ModuloOp,
		INT16_TYPE,
	)


pure func test_synthesis_promotes_int16_negate_impl_to_native_operator() -> Bool:
	synthesis_promotes_scalar_negation("int16", INT16_TYPE)


pure func test_synthesis_promotes_scalar_equality_impls_to_native_operators() -> Bool:
	(
		synthesis_promotes_scalar_operator(
			"int16",
			INT16_TYPE,
			"Equatable",
			"equals",
			EqualOp,
			BOOL_TYPE,
		)
		and synthesis_promotes_scalar_operator(
			"int16",
			INT16_TYPE,
			"Equatable",
			"not_equals",
			NotEqualOp,
			BOOL_TYPE,
		)
	)


pure func test_synthesis_promotes_scalar_ordering_impls_to_native_operators() -> Bool:
	[
		("less_than", LessOp),
		("greater_than", GreaterOp),
		("less_than_or_equal", LessEqualOp),
		("greater_than_or_equal", GreaterEqualOp),
	].all(pure func(case):
		synthesis_promotes_scalar_operator(
			"int16",
			INT16_TYPE,
			"Orderable",
			case[0],
			case[1],
			BOOL_TYPE,
		)
	)


pure func test_synthesis_promotes_string_add_impl_to_native_operator() -> Bool:
	synthesis_promotes_scalar_operator("string", STRING_TYPE, "Addable", "add", AddOp, STRING_TYPE)


pure func test_synthesis_promotes_fixed_arithmetic_impls_to_native_operators() -> Bool:
	[
		("Addable", "add", AddOp),
		("Subtractable", "subtract", SubtractOp),
		("Multipliable", "multiply", MultiplyOp),
		("Divisible", "divide", DivideOp),
	].all(pure func(case):
		synthesis_promotes_scalar_operator(
			"fixed",
			FIXED_TYPE,
			case[0],
			case[1],
			case[2],
			FIXED_TYPE,
		)
	)


pure func test_scalar_operator_synthesis_rejects_malformed_candidates() -> Bool:
	params: List[CoreParam] = [param("left", INT16_TYPE), param("right", INT16_TYPE)]
	canonical: CoreFunction = builtin_function("int16", "multiply", params, INT16_TYPE)
	wrong_owner: CoreFunction = builtin_function("int8", "multiply", params, INT16_TYPE)
	wrong_arity: CoreFunction = { canonical | params = [param("left", INT16_TYPE)] }
	wrong_operand: CoreFunction = { canonical |
		params = [param("left", INT16_TYPE), param("right", INT_TYPE)]
	}
	wrong_result: CoreFunction = { canonical | return_type = INT_TYPE }
	canonical_negate: CoreFunction = builtin_function(
		"int16",
		"negate",
		[param("value", INT16_TYPE)],
		INT16_TYPE,
	)
	wrong_negate_owner: CoreFunction = { canonical_negate | source_module = Some("int8") }
	wrong_negate_arity: CoreFunction = { canonical_negate |
		params = [param("left", INT16_TYPE), param("right", INT16_TYPE)]
	}
	wrong_negate_operand: CoreFunction = { canonical_negate | params = [param("value", INT_TYPE)] }
	wrong_negate_result: CoreFunction = { canonical_negate | return_type = INT_TYPE }

	(
		synthesize_scalar_operator_impl_body("Multipliable", INT16_TYPE, canonical).is_some()
		and [wrong_owner, wrong_arity, wrong_operand, wrong_result].all(pure func(candidate):
			synthesize_scalar_operator_impl_body("Multipliable", INT16_TYPE, candidate).is_none()
		)
		and synthesize_scalar_operator_impl_body(
			"Subtractable",
			STRING_TYPE,
			builtin_function(
				"string",
				"subtract",
				[param("left", STRING_TYPE), param("right", STRING_TYPE)],
				STRING_TYPE,
			),
		).is_none()
		and synthesize_scalar_operator_impl_body(
			"Modulable",
			FIXED_TYPE,
			builtin_function(
				"fixed",
				"remainder",
				[param("left", FIXED_TYPE), param("right", FIXED_TYPE)],
				FIXED_TYPE,
			),
		).is_none()
		and synthesize_scalar_operator_impl_body(
			"Negatable",
			INT16_TYPE,
			canonical_negate,
		).is_some()
		and [
			wrong_negate_owner,
			wrong_negate_arity,
			wrong_negate_operand,
			wrong_negate_result,
		].all(pure func(candidate):
			synthesize_scalar_operator_impl_body("Negatable", INT16_TYPE, candidate).is_none()
		)
		and synthesize_scalar_operator_impl_body(
			"Negatable",
			UINT8_TYPE,
			builtin_function("uint8", "negate", [param("value", UINT8_TYPE)], UINT8_TYPE),
		).is_none()
	)


tests: TestSuite = {
	description = "Compiler Core synthesis orchestrator",
	tests = [
		(
			"synthesis promotes successful family body",
			test_synthesis_promotes_successful_family_body,
		),
		("synthesis dispatches across families", test_synthesis_dispatches_across_families),
		("synthesis dispatches new family modules", test_synthesis_dispatches_new_family_modules),
		(
			"synthesis uses declarations for hash layouts",
			test_synthesis_uses_program_declarations_for_hash_layout,
		),
		("synthesis propagates family errors", test_synthesis_propagates_family_error),
		(
			"synthesis records registry-owned runtime identity",
			test_synthesis_records_registry_owned_runtime_identity,
		),
		("synthesis preserves unhandled builtin", test_synthesis_preserves_unhandled_builtin),
		("synthesis preserves multi-decl order", test_synthesis_preserves_multi_decl_order),
		("synthesis promotes concrete impl method", test_synthesis_promotes_concrete_impl_method),
		(
			"synthesis promotes Int16 add impl to native operator",
			test_synthesis_promotes_int16_add_impl_to_native_operator,
		),
		(
			"synthesis promotes Int16 subtract impl to native operator",
			test_synthesis_promotes_int16_subtract_impl_to_native_operator,
		),
		(
			"synthesis promotes Int16 multiply impl to native operator",
			test_synthesis_promotes_int16_multiply_impl_to_native_operator,
		),
		(
			"synthesis promotes Int16 divide impl to native operator",
			test_synthesis_promotes_int16_divide_impl_to_native_operator,
		),
		(
			"synthesis promotes Int16 remainder impl to native operator",
			test_synthesis_promotes_int16_remainder_impl_to_native_operator,
		),
		(
			"synthesis promotes Int16 negate impl to native operator",
			test_synthesis_promotes_int16_negate_impl_to_native_operator,
		),
		(
			"synthesis promotes scalar equality impls to native operators",
			test_synthesis_promotes_scalar_equality_impls_to_native_operators,
		),
		(
			"synthesis promotes scalar ordering impls to native operators",
			test_synthesis_promotes_scalar_ordering_impls_to_native_operators,
		),
		(
			"synthesis promotes String add impl to native operator",
			test_synthesis_promotes_string_add_impl_to_native_operator,
		),
		(
			"synthesis promotes Fixed arithmetic impls to native operators",
			test_synthesis_promotes_fixed_arithmetic_impls_to_native_operators,
		),
		(
			"scalar operator synthesis rejects malformed candidates",
			test_scalar_operator_synthesis_rejects_malformed_candidates,
		),
	]
}
