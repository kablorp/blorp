pure func shadowed_choice_union_decl() -> CoreUnionDecl:
	{
		abi_type = None,
		name = "Choice",
		type_params = [],
		payload_storage = TypedUnionPayloadStorage,
		variants = [
			{
				name = "Picked",
				c_name = "__def_45_Picked",
				tag_c_name = "TAG_Choice_Picked",
				tag = 0,
				fields = [no_release_union_field(int_type())],
				def_id = Some(45)
			},
		],
		loc = synthetic_core_source_loc()
	}


pure func program_with_duplicate_choice_body(body: CoreExpr) -> CoreProgram:
	{
		decls = [
			UnionDecl(choice_union_decl()),
			UnionDecl(shadowed_choice_union_decl()),
			FunctionDecl(identity_function(body, choice_type())),
		],
		foreign_includes = [],
		source_files = []
	}


pure func test_prepare_uses_first_declared_union_of_a_name() -> Bool:
	first_declared: CoreProgram = program_with_duplicate_choice_body(choice_constructor_call())
	shadowed: CoreProgram = program_with_duplicate_choice_body(
		constructor_alias_call(
			"__def_45_Picked",
			45,
			int_literal(7),
			choice_type(),
		),
	)

	-- The first "Choice" declaration owns the name, so its variant converts.

	(
		programs_equal(
			prepare_program(first_declared),
			program_with_duplicate_choice_body(prepared_choice_constructor()),
		)
		and programs_equal(prepare_program(shadowed), shadowed)
	)


