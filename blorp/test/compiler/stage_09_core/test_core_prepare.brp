pure func test_prepare_reboxes_inline_struct_list_after_ownership() -> Bool:
	list_type: CoreType = NamedType("List", [point_type()])
	point_value: CoreExpr = VarExpr(named_var("point"), point_type(), synthetic_core_source_loc())
	body: CoreExpr = ListConstructExpr(
		{
			layout = InlineStructListStorage("Point"),
			elements = [
				{
					kind = PointerBox,
					value = point_value,
					needs_release = False,
					transfers_ownership = False
				},
			],
			elem_needs_release = False
		},
		list_type,
		synthetic_core_source_loc(),
	)
	actual: CoreProgram = prepare_program({
		decls = [
			ValueRecordDecl(point_record_decl()),
			FunctionDecl(identity_function(body, list_type)),
		],
		foreign_includes = [],
		source_files = []
	})

	match actual.decls:
		[ValueRecordDecl(_), FunctionDecl(function_info)]:
			match function_info.body:
				Some(ListConstructExpr(construct, _, _)):
					match construct.elements:
						[element]:
							match element.kind:
								StructBox("Point"):
									not element.needs_release
								_:
									False
						_:
							False
				_:
					False
		_:
			False


