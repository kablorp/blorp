	CallExpr(
		IntrinsicCall("tensor_is_i64_storage"),
		VarExpr(named_var("tensor_is_i64_storage"), closure_type(), synthetic_core_source_loc()),
		[source],
		bool_type(),
		synthetic_core_source_loc(),
	)


pure func tensor_guard_body() -> CoreExpr:
	values_var: CoreVar = named_var("values")
	guard_var: CoreVar = named_var("storage_ok")

	LetExpr(
		values_var,
		False,
		tensor_type(),
		tensor_i64_literal(),
		LetExpr(
			guard_var,
			False,
			bool_type(),
			tensor_storage_guard_call(VarExpr(values_var, tensor_type(), synthetic_core_source_loc())),
			IfExpr(
				VarExpr(guard_var, bool_type(), synthetic_core_source_loc()),
				int_literal(1),
				int_literal(2),
				int_type(),
				synthetic_core_source_loc(),
			),
		),
	)


pure func tensor_guard_body_simplified() -> CoreExpr:
	values_var: CoreVar = named_var("values")

	LetExpr(values_var, False, tensor_type(), tensor_i64_literal(), int_literal(1))


