pure func programs_equal(left: CoreProgram, right: CoreProgram) -> Bool:
	core_program_to_json(left).to_string() == core_program_to_json(right).to_string()


pure func prepared_constructor_name(program: CoreProgram) -> Option[String]:
	var result: Option[String] = None

	for decl in prepare_program(program).decls:
		match decl:
			FunctionDecl(function_info):
				match function_info.body:
					Some(UnionConstructExpr(construct, _, _)):
						result = Some(construct.constructor_name)
						break
					_:
						void
			_:
				void

	result


pure func constructor_alias_call(
	name: String,
	def_id: Int,
	arg: CoreExpr,
	typ: CoreType,
) -> CoreExpr:
	CallExpr(
		UserCall(
			name,
			Some(def_id),
			[],
		),
		VarExpr(
			{
				name = name,
				id = 0,
				def_id = Some(def_id)
			},
			typ,
			synthetic_core_source_loc(),
		),
		[arg],
		typ,
		synthetic_core_source_loc(),
	)


