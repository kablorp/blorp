pure func test_erased_struct_union_storage_cleanup_policy() -> Bool:
	point_field: CoreUnionField = no_release_union_field(ValueRecordType("CleanupPlanPoint"))
	variant: CoreUnionVariant = {
		name = "Point",
		c_name = "CleanupPlanErasedPoint_Point",
		tag_c_name = "TAG_CleanupPlanErasedPoint_Point",
		tag = 0,
		fields = [point_field],
		def_id = None
	}
	erased_decl: CoreUnionDecl = {
		abi_type = None,
		name = "CleanupPlanErasedPoint",
		type_params = [],
		payload_storage = ErasedUnionPayloadStorage,
		variants = [variant],
		loc = synthetic_core_source_loc()
	}
	typed_decl: CoreUnionDecl = {
		erased_decl |
			name = "CleanupPlanTypedPoint",
			payload_storage = TypedUnionPayloadStorage
	}
	program: CoreProgram = {
		decls = [UnionDecl(erased_decl), UnionDecl(typed_decl)],
		foreign_includes = [],
		source_files = []
	}
	layout = build_specialize_layout(program)
	plan: CleanupPlan = build_cleanup_plan(program)
	erased_row: CleanupTypePlan = cleanup_plan_row(plan, 0)
	typed_row: CleanupTypePlan = cleanup_plan_row(plan, 1)

	erased_strategy_ok: Bool = match erased_row:
		UnionTypeCleanup(union_plan):
			union_plan.strategy == DirectCleanup
		HeapRecordTypeCleanup(_) | NotACleanupType:
			False
	erased_field_ok: Bool = match union_cleanup_field_plan(erased_row, 0, 0):
		Some(field_plan):
			field_plan.needs_release
		None:
			False
	typed_strategy_ok: Bool = match typed_row:
		UnionTypeCleanup(union_plan):
			union_plan.strategy == NoCleanup
		HeapRecordTypeCleanup(_) | NotACleanupType:
			False
	typed_field_ok: Bool = match union_cleanup_field_plan(typed_row, 0, 0):
		Some(field_plan):
			not field_plan.needs_release
		None:
			False

	(
		erased_strategy_ok
		and erased_field_ok
		and typed_strategy_ok
		and typed_field_ok
		and union_variant_requires_release_mask(layout, ErasedUnionPayloadStorage, [point_field])
		and not union_variant_requires_release_mask(layout, TypedUnionPayloadStorage, [point_field])
	)


---
Builds the cleanup plan for a program with a non-recursive union (direct
cleanup), a self-recursive union (iterative cleanup, and the only case that
may allocate scratch), and a heap record with one released field and one
unreleased field (direct cleanup) -- the three shapes step 1 of the emitter
migration needs to distinguish. Asserts the row for each declaration and the
per-field facts the emitter used to recompute while printing.
---
pure func test_build_cleanup_plan_rows() -> Bool:
	program: CoreProgram = {
		decls = [
			UnionDecl(cleanup_plan_test_direct_union_decl()),
			UnionDecl(cleanup_plan_test_iterative_union_decl()),
			HeapRecordDecl(box_heap_record_decl()),
		],
		foreign_includes = [],
		source_files = []
	}
	plan: CleanupPlan = build_cleanup_plan(program)

	direct_row: CleanupTypePlan = cleanup_plan_row(plan, 0)
	iterative_row: CleanupTypePlan = cleanup_plan_row(plan, 1)
	heap_row: CleanupTypePlan = cleanup_plan_row(plan, 2)

	direct_ok: Bool = match direct_row:
		UnionTypeCleanup(union_plan):
			union_plan.strategy == DirectCleanup and not union_plan.may_allocate_scratch
		HeapRecordTypeCleanup(_) | NotACleanupType:
			False

	iterative_ok: Bool = match iterative_row:
		UnionTypeCleanup(union_plan):
			union_plan.strategy == IterativeCleanup and union_plan.may_allocate_scratch
		HeapRecordTypeCleanup(_) | NotACleanupType:
			False

	iterative_field_ok: Bool = match union_cleanup_field_plan(iterative_row, 0, 0):
		Some(field_plan):
			field_plan.needs_release and field_plan.uses_iterative_cleanup
		None:
			False

	heap_ok: Bool = match heap_row:
		HeapRecordTypeCleanup(record_plan):
			record_plan.strategy == DirectCleanup
		UnionTypeCleanup(_) | NotACleanupType:
			False

	heap_count_field_ok: Bool = match heap_record_cleanup_field_plan(heap_row, 0):
		Some(field_plan):
			not field_plan.needs_release
		None:
			False

	heap_label_field_ok: Bool = match heap_record_cleanup_field_plan(heap_row, 1):
		Some(field_plan):
			field_plan.needs_release and not field_plan.uses_iterative_cleanup
		None:
			False

	direct_ok and iterative_ok and iterative_field_ok and heap_ok and heap_count_field_ok and heap_label_field_ok


pure func cancellation_plan_test_function_with_body(def_id: Int) -> CoreFunction:
	{
		name = "with_body",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(int_literal(1)),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = synthetic_core_source_loc()
	}


pure func cancellation_plan_test_function_without_body(def_id: Int) -> CoreFunction:
	{
		name = "without_body",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = None,
		is_pure = True,
		function_kind = BuiltinFunction("without_body"),
		def_id = def_id,
		loc = synthetic_core_source_loc()
	}


pure func cancellation_plan_test_global(def_id: Int) -> CoreGlobal:
	{
		name = {
			name = "cancellation_plan_test_global",
			id = 0,
			def_id = Some(def_id)
		},
		source_module = None,
		typ = int_type(),
		init = int_literal(1),
		is_mutable = False,
		is_const = True,
		is_private = False,
		def_id = def_id,
		loc = synthetic_core_source_loc()
	}


---
Builds the cancellation plan table for a program with a function that has a
body, a function with no body, and a global -- the row shapes step 2 of the
emitter migration needs to distinguish. A function with a body and a global
each get `Some(plan)` built from the same `CancellationPlan` builders the
emitter used to call at print time; a function with no body gets `None`, and
the row for a declaration kind that is never a cancellation callable (checked
here through the out-of-range default) is `None` too.
---
pure func test_build_cancellation_plan_table_rows() -> Bool:
	program: CoreProgram = {
		decls = [
			FunctionDecl(cancellation_plan_test_function_with_body(1)),
			FunctionDecl(cancellation_plan_test_function_without_body(2)),
			GlobalDecl(cancellation_plan_test_global(3)),
		],
		foreign_includes = [],
		source_files = []
	}
	table: CancellationPlanTable = build_cancellation_plan_table(program)

	function_with_body_ok: Bool = match cancellation_plan_table_row(table, 0):
		Some(plan):
			plan.expression_visits > 0
		None:
			False

	function_without_body_ok: Bool = cancellation_plan_table_row(table, 1).is_none()

	global_ok: Bool = match cancellation_plan_table_row(table, 2):
		Some(plan):
			plan.expression_visits > 0
		None:
			False

	out_of_range_ok: Bool = cancellation_plan_table_row(table, 99).is_none()

	function_with_body_ok and function_without_body_ok and global_ok and out_of_range_ok


