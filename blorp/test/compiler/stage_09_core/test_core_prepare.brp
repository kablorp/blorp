	)
	source: CoreProgram = program_with_choice_body(call)
	programs_equal(prepare_program(source), source)


pure func test_prepare_canonicalizes_constructor_c_name_aliases() -> Bool:
	option_name: String = prepared_constructor_name(
		program_with_option_body(
			constructor_alias_call("__def_42259_Some", 42259, int_literal(7), option_int_type()),
			option_int_type(),
		),
	).get_or("")
	stack_result_name: String = prepared_constructor_name(
		program_with_result_body(
			constructor_alias_call(
				"__def_42261_Ok",
				42261,
				int_literal(7),
				result_int_string_type(),
			),
			result_int_string_type(),
		),
	).get_or("")
	boxed_result_name: String = prepared_constructor_name(
		program_with_result_body(
			constructor_alias_call(
				"__def_42261_Ok",
				42261,
				int_literal(7),
				boxed_result_int_string_type(),
			),
			boxed_result_int_string_type(),
		),
	).get_or("")
	union_name: String = prepared_constructor_name(
		program_with_choice_body(
			constructor_alias_call(
				"__def_44_Picked",
				44,
				int_literal(7),
				choice_type(),
			),
		),
	).get_or("")

	(
		option_name == "Some"
		and stack_result_name == "Ok"
		and boxed_result_name == "Ok"
		and union_name == "Picked"
	)


