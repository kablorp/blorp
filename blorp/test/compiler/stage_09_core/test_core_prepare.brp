pure func test_prepare_preserves_resolved_nonconstructor_named_none() -> Bool:
	source: CoreProgram = program_with_option_body(
		VarExpr(
			{
				name = "None",
				id = 0,
				def_id = Some(999)
			},
			option_string_type(),
			synthetic_core_source_loc(),
		),
		option_string_type(),
	)
	programs_equal(prepare_program(source), source)


pure func test_prepare_preserves_option_call_with_wrong_definition() -> Bool:
	call: CoreExpr = CallExpr(
		UserCall(
			"Some",
			Some(999),
			[],
		),
		VarExpr(
			{
				name = "Some",
				id = 0,
				def_id = Some(999)
			},
			option_int_type(),
			synthetic_core_source_loc(),
		),
		[int_literal(7)],
		option_int_type(),
		synthetic_core_source_loc(),
	)
	source: CoreProgram = program_with_option_body(call, option_int_type())
	programs_equal(prepare_program(source), source)


pure func test_prepare_preserves_result_calls_with_wrong_definition() -> Bool:
	stack_call: CoreExpr = CallExpr(
		UserCall(
			"Ok",
			Some(999),
			[],
		),
		VarExpr(
			{
				name = "Ok",
				id = 0,
				def_id = Some(999)
			},
			result_int_string_type(),
			synthetic_core_source_loc(),
		),
		[int_literal(7)],
		result_int_string_type(),
		synthetic_core_source_loc(),
	)
	boxed_call: CoreExpr = CallExpr(
		UserCall(
			"Ok",
			Some(999),
			[],
		),
		VarExpr(
			{
				name = "Ok",
				id = 0,
				def_id = Some(999)
			},
			boxed_result_int_string_type(),
			synthetic_core_source_loc(),
		),
		[int_literal(7)],
		boxed_result_int_string_type(),
		synthetic_core_source_loc(),
	)
	stack_source: CoreProgram = program_with_result_body(stack_call, result_int_string_type())
	boxed_source: CoreProgram = program_with_result_body(boxed_call, boxed_result_int_string_type())

	(
		programs_equal(prepare_program(stack_source), stack_source)
		and programs_equal(prepare_program(boxed_source), boxed_source)
	)


pure func test_prepare_converts_result_builtins_without_source_decl() -> Bool:
	stack_type: CoreType = stack_result_int_string_type()
	boxed_type: CoreType = boxed_result_int_string_type()
	stack_source: CoreProgram = program_with_body(
		CallExpr(
			BuiltinCall("blorp_result_err"),
			VoidExpr(VoidType, synthetic_core_source_loc()),
			[string_literal("stack")],
			stack_type,
			synthetic_core_source_loc(),
		),
		stack_type,
	)
	boxed_source: CoreProgram = program_with_body(
		CallExpr(
			BuiltinCall("blorp_result_err"),
			VoidExpr(VoidType, synthetic_core_source_loc()),
			[string_literal("boxed")],
			boxed_type,
			synthetic_core_source_loc(),
		),
		boxed_type,
	)

	stack_prepared: Bool = match prepare_program(stack_source).decls:
		[FunctionDecl(function_info)]:
			match function_info.body:
				Some(UnionConstructExpr(construct, _, _)):
					construct.constructor_name == "Err"
				_:
					False
		_:
			False

	boxed_prepared: Bool = match prepare_program(boxed_source).decls:
		[FunctionDecl(function_info)]:
			match function_info.body:
				Some(UnionConstructExpr(construct, _, _)):
					construct.constructor_name == "Err"
				_:
					False
		_:
			False

	stack_prepared and boxed_prepared


pure func test_prepare_preserves_union_call_with_wrong_definition() -> Bool:
	call: CoreExpr = CallExpr(
		UserCall(
			"Picked",
