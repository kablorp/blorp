				receiver_type,
			),
		],
	)


pure func addable_impl(receiver_type: CoreType) -> CoreDecl:
	impl_decl(
		"Addable",
		receiver_type,
		[
			function(
				"add",
				11,
				[param("left", receiver_type), param("right", receiver_type)],
				receiver_type,
				var_expr(
					"left",
					receiver_type,
				),
			),
		],
	)


