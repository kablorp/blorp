	main: CoreDecl = FunctionDecl(
		function(
			"main",
			20,
			[param("value", widget_type())],
			string_type(),
			body,
		),
	)

	match resolved_main_body(program([
		stringable_trait(widget_type()),
		stringable_impl(widget_type()),
		main,
	])):
		Some(resolved):
			call_targets(resolved, True, "Stringable_to_string_Widget")
		None:
			False


pure func test_selected_trait_registry_miss_is_an_error() -> Bool:
	value: CoreExpr = var_expr("value", widget_type())
	body: CoreExpr = call(
		SelectedTraitCall("Stringable", "to_string", "app", 99),
		"__ufcs_app__to_string",
		[value],
		string_type(),
	)
	main: CoreDecl = FunctionDecl(
		function(
			"main",
			20,
			[param("value", widget_type())],
			string_type(),
			body,
		),
	)

	resolve_core_traits(program([stringable_trait(widget_type()), main])).is_err()


pure func test_selected_direct_call_is_not_trait_dispatch() -> Bool:
	value: CoreExpr = var_expr("value", widget_type())
	body: CoreExpr = call(SelectedDirectCall(99), "to_string", [value], string_type())
	main: CoreDecl = FunctionDecl(
		function(
			"main",
			20,
			[param("value", widget_type())],
			string_type(),
			body,
		),
	)

	match resolved_main_body(program([
		stringable_trait(widget_type()),
		stringable_impl(widget_type()),
		main,
	])):
		Some(CallExpr(SelectedDirectCall(99), VarExpr(variable, _, _), _, _, _)):
			variable.name == "to_string"
		None:
			False
		_:
			False


