pure func test_prelude_builtin_trait_method_falls_through() -> Bool:
	list_type: CoreType = NamedType("List", [widget_type()])
	body: CoreExpr = call(
		DeferredTraitCall("HasLength", "length"),
		"length",
		[var_expr("items", list_type)],
		named_type("Int"),
	)
	main: CoreDecl = FunctionDecl(
		function(
			"main",
			20,
			[param("items", list_type)],
