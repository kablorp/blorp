pure func test_equals_without_impl_uses_builtin_fallback() -> Bool:
	enum_type: CoreType = named_type("TypeKind")
	left: CoreExpr = var_expr("left", enum_type)
	right: CoreExpr = var_expr("right", enum_type)
	body: CoreExpr = call(
		DeferredTraitCall(
			"Equatable",
			"equals",
		),
		"equals",
		[left, right],
		named_type("Bool"),
	)
	main: CoreDecl = FunctionDecl(
		function(
			"main",
			20,
			[param("left", enum_type), param("right", enum_type)],
			named_type("Bool"),
			body,
		),
	)

	match (
		resolved_main_body(program([
			trait_decl(
				"Equatable",
				[
					trait_method(
						"equals",
						[param("left", SelfType), param("right", SelfType)],
						named_type("Bool"),
					),
				],
			),
			equatable_impl(widget_type()),
			main,
		]))
	):
		Some(CallExpr(UnknownCall, VarExpr(variable, _, _), _, _, _)):
			variable.name == "equals"
		_:
			False


pure func test_aliased_equals_builtin_fallback_uses_canonical_name() -> Bool:
	enum_type: CoreType = named_type("TypeKind")
	left: CoreExpr = var_expr("left", enum_type)
	right: CoreExpr = var_expr("right", enum_type)
	body: CoreExpr = call(
		DeferredTraitCall(
			"Equatable",
			"equals",
		),
		"eq",
		[left, right],
		named_type("Bool"),
	)
	main: CoreDecl = FunctionDecl(
		function(
			"main",
			20,
			[param("left", enum_type), param("right", enum_type)],
			named_type("Bool"),
			body,
		),
	)

	match (
		resolved_main_body(program([
			trait_decl(
				"Equatable",
				[
					trait_method(
						"equals",
						[param("left", SelfType), param("right", SelfType)],
						named_type("Bool"),
					),
				],
			),
			equatable_impl(widget_type()),
			main,
		]))
	):
		Some(CallExpr(UnknownCall, VarExpr(variable, _, _), _, _, _)):
			variable.name == "equals"
		_:
			False


pure func addable_trait(receiver_type: CoreType) -> CoreDecl:
