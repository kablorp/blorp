pure func test_unmaterialized_generic_source_target_is_an_error() -> Bool:
	list_type: CoreType = NamedType("List", [widget_type()])
	value: CoreExpr = var_expr("value", list_type)
	body: CoreExpr = call(
		SelectedTraitCall("Stringable", "to_string", "app", 10),
		"__ufcs_app__to_string",
		[value],
		string_type(),
	)
	main: CoreDecl = FunctionDecl(
		function(
			"main",
			20,
			[param("value", list_type)],
			string_type(),
			body,
		),
	)

	match resolve_core_traits(program([
		stringable_trait(list_type),
		generic_source_stringable_impl(),
		main,
	])):
		Err(_):
			True
		Ok(_):
			False


pure func test_generic_function_keeps_selected_trait_identity() -> Bool:
	body: CoreExpr = call(
		SelectedTraitCall("Stringable", "to_string", "app", 99),
		"to_string",
		[var_expr("value", TypeParameterType("T"))],
		string_type(),
	)
	generic: CoreDecl = FunctionDecl(
		{ function("generic", 20, [param("value", TypeParameterType("T"))], string_type(), body) |
			type_params = ["T"]
		},
	)

	match resolve_core_traits(program([generic])):
		Ok(resolved):
			match resolved.decls.get(0):
				Some(FunctionDecl(function_info)):
					match function_info.body:
						Some(CallExpr(SelectedTraitCall("Stringable", "to_string", "app", 99), _, _, _, _)):
							True
						_:
							False
				_:
					False
		Err(_):
			False


