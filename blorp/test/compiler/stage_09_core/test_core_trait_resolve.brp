pure func test_non_trait_builtin_is_preserved() -> Bool:
	body: CoreExpr = call(
		BuiltinCall("blorp_runtime_helper"),
		"blorp_runtime_helper",
		[],
		named_type("Bool"),
	)
	main: CoreDecl = FunctionDecl(function("main", 20, [], named_type("Bool"), body))

	match resolved_main_body(program([main])):
		Some(CallExpr(BuiltinCall(name), _, _, _, _)):
			name == "blorp_runtime_helper"
