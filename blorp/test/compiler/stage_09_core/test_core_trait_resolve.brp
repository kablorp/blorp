					[param("value", widget_type())],
					named_type("Int"),
					var_expr("zero", named_type("Int")),
				)]),
		main,
	])):
		Some(CallExpr(UnknownCall, VarExpr(variable, _, _), _, _, _)):
			variable.name == "length"
		_:
			False


pure func test_resolved_direct_binding_is_not_a_missing_impl() -> Bool:
	sheep_type: CoreType = named_type("Sheep")
	value: CoreExpr = var_expr("value", sheep_type)
	callee: CoreExpr = VarExpr(
		{ named_var("to_string") | def_id = Some(99) },
		function_type([sheep_type], string_type()),
		SyntheticSourceLoc,
	)
	body: CoreExpr = CallExpr(
		DeferredTraitCall("Stringable", "to_string"),
		callee,
		[value],
		string_type(),
		SyntheticSourceLoc,
	)
	main: CoreDecl = FunctionDecl(
		function(
			"main",
			20,
			[param("value", sheep_type)],
			string_type(),
			body,
		),
	)

	match resolved_main_body(program([
		stringable_trait(widget_type()),
		stringable_impl(widget_type()),
		main,
	])):
		Some(resolved):
			call_targets(resolved, True, "to_string")
		None:
			False


pure func test_resource_binding_shadows_body_not_acquire() -> Bool:
	value: CoreExpr = var_expr("value", widget_type())
	trait_call: CoreExpr = call(
		DeferredTraitCall("Stringable", "to_string"),
		"to_string",
		[value],
		string_type(),
	)
	body: CoreExpr = ResourceScopeExpr(
		{
			variable = named_var("to_string"),
			typ = function_type([widget_type()], string_type()),
			acquire = trait_call,
			body = trait_call,
			cleanup = VoidExpr(VoidType, SyntheticSourceLoc)
		},
		string_type(),
		SyntheticSourceLoc,
	)
	main: CoreDecl = FunctionDecl(
		function(
			"main",
			20,
			[param("value", widget_type())],
			string_type(),
			body,
		),
	)

	match resolved_main_body(program([
		stringable_trait(widget_type()),
		stringable_impl(widget_type()),
		main,
	])):
		Some(ResourceScopeExpr(scope, _, _)):
			call_targets(scope.acquire, True, "Stringable_to_string_Widget") and match scope.body:
				CallExpr(UnknownCall, VarExpr(variable, _, _), _, _, _):
					variable.name == "to_string"
				_:
					False
		_:
			False


pure func static_default_trait() -> CoreDecl:
	trait_decl("Default", [trait_method("default", [], SelfType)])


pure func static_default_impl() -> CoreDecl:
	impl_decl("Default", widget_type(), [function(
				"default",
				12,
				[],
				widget_type(),
				var_expr("value", widget_type()),
			)])


pure func test_static_self_dispatch_uses_return_type() -> Bool:
	body: CoreExpr = call(
		DeferredTraitCall("Default", "default"),
		"default",
		[],
		widget_type(),
	)
	main: CoreDecl = FunctionDecl(function("main", 20, [], widget_type(), body))

	match resolved_main_body(program([static_default_trait(), static_default_impl(), main])):
		Some(resolved):
			call_targets(resolved, True, "Default_default_Widget")
		None:
			False


pure func test_parameterized_type_keys_do_not_collide() -> Bool:
	core_trait_impl_type_key(
		NamedType(
			"Result",
			[named_type("Int"), string_type()],
		),
	) == Some(
		"Result_Int_String",
	) and core_trait_impl_type_key(
		TupleType(
			[
				named_type("Int"),
				string_type(),
			],
		),
	) == Some(
		"Tuple2_Int_String",
	) and core_trait_impl_type_key(
		TupleType(
			[

			],
		),
	) == Some(
		"Tuple0_",
	) and core_trait_impl_type_key(
		VoidType,
	) == Some(
		"Void",
	) and core_trait_impl_type_key(RangeType).is_none() and core_trait_impl_type_key(TensorType({
		element_type = named_type("Int"),
		dims = [TensorStaticDim(4)],
	})) == Some("__Array_Int_4") and core_trait_impl_type_key(TensorType({
		element_type = named_type("Int"),
		dims = [TensorDimOperation(DimDivide, TensorStaticDim(4), TensorStaticDim(2))],
	})) == Some("__Array_Int_2") and core_trait_impl_type_key(TensorType({
		element_type = named_type("Int"),
		dims = [TensorDimOperation(DimDivide, TensorStaticDim(5), TensorStaticDim(2))],
	})).is_none() and core_trait_impl_type_key(TensorType({
		element_type = named_type("Int"),
		dims = [TensorDimOperation(DimDivide, TensorStaticDim(4), TensorStaticDim(0))],
	})).is_none() and core_trait_impl_type_key(TensorType({
		element_type = named_type("Int"),
		dims = [TensorDimOperation(DimDivide, TensorStaticDim(0), TensorStaticDim(0))],
	})) == Some("__Array_Int_0") and core_trait_impl_type_key(TensorType({
		element_type = named_type("Int"),
		dims = [TensorDimOperation(DimDivide, TensorStaticDim(0), TensorRuntimeDim("N"))],
	})) == Some("__Array_Int_0") and core_trait_impl_type_key(TensorType({
		element_type = named_type("Int"),
		dims = [TensorDimOperation(DimMultiply, TensorStaticDim(0), TensorRuntimeDim("N"))],
	})) == Some("__Array_Int_0") and core_trait_impl_type_key(TensorType({
		element_type = named_type("Int"),
		dims = [TensorDimOperation(DimMultiply, TensorRuntimeDim("N"), TensorStaticDim(0))],
	})) == Some("__Array_Int_0") and core_trait_impl_type_key(TensorType({
		element_type = named_type("Int"),
		dims = [TensorDimOperation(DimSubtract, TensorRuntimeDim("N"), TensorRuntimeDim("N"))],
	})) == Some(
		"__Array_Int_0",
	) and core_trait_impl_type_key(
		NamedType(
			"Wrapper",
			[RangeType],
		),
	).is_none() and core_trait_impl_type_key(TypeParameterType("T")).is_none()


pure func missing_impl_diagnostic() -> Option[CoreTraitResolveDiagnostic]:
	value: CoreExpr = var_expr("value", named_type("Sheep"))
	body: CoreExpr = call(
		DeferredTraitCall("Renderable", "render"),
		"render",
		[value],
		string_type(),
	)
	main: CoreDecl = FunctionDecl(
		function(
			"main",
			20,
			[param("value", named_type("Sheep"))],
			string_type(),
			body,
		),
	)

	match resolve_core_traits(program([
		trait_decl(
			"Renderable",
			[trait_method("render", [param("value", widget_type())], string_type())],
		),
		impl_decl(
			"Renderable",
			widget_type(),
			[
				function(
					"render",
					10,
					[param("value", widget_type())],
					string_type(),
					string_literal("rendered"),
				),
			],
		),
		main,
	])):
		Err(diagnostic):
			Some(diagnostic)
		Ok(_):
			None


pure func test_missing_impl_has_structured_diagnostic() -> Bool:
	match missing_impl_diagnostic():
		Some(diagnostic):
			message: String = core_trait_resolve_diagnostic_message(diagnostic)
			hint: String = core_trait_resolve_diagnostic_hint(diagnostic)

			message == "no impl of `render` for type `Sheep` in scope" and hint.contains("Widget")
		None:
			False


pure func test_deep_left_logical_tree_is_stack_bounded() -> Bool:
	logical_depth: Int = 2048
	var body: CoreExpr = bool_literal(True)
	var index: Int = 0

	while index < logical_depth:
		body = LogicalExpr(AndOp, body, bool_literal(True), named_type("Bool"), SyntheticSourceLoc)
		index += 1

	main: CoreDecl = FunctionDecl(function("main", 20, [], named_type("Bool"), body))

	match resolved_main_body(program([main])):
		Some(resolved_body):
			var current: CoreExpr = resolved_body
			var logical_nodes: Int = 0
			var valid: Bool = True

			while True:
				match current:
					LogicalExpr(AndOp, left, LiteralExpr(BoolLiteral(True), _, _), _, _):
						logical_nodes += 1
						current = left
					LiteralExpr(BoolLiteral(True), _, _):
						break
					_:
						valid = False
						break

			valid and logical_nodes == logical_depth
		None:
			False


tests: TestSuite = {
	description = "Blorp compiler Core trait resolution",
	tests = [
		("deferred trait call resolves", test_deferred_trait_call_resolves),
		(
			"selected trait call resolves by trait identity",
			test_selected_trait_call_resolves_by_trait_identity,
		),
		("selected trait registry miss is an error", test_selected_trait_registry_miss_is_an_error),
		(
			"selected direct call is not trait dispatch",
			test_selected_direct_call_is_not_trait_dispatch,
		),
		("generic impl is not a dispatch target", test_generic_impl_is_not_a_dispatch_target),
		(
			"selected generic impl target defers to direct resolution",
			test_selected_generic_impl_target_defers_to_direct_resolution,
		),
		(
			"unmaterialized generic source target is an error",
			test_unmaterialized_generic_source_target_is_an_error,
		),
		(
			"generic function keeps selected trait identity",
			test_generic_function_keeps_selected_trait_identity,
		),
		("StringSlice builtin uses impl", test_string_slice_builtin_uses_impl),
		("synthetic to_string builtin uses impl", test_synthetic_to_string_builtin_uses_impl),
		("non-trait builtin is preserved", test_non_trait_builtin_is_preserved),
		(
			"equals without impl uses builtin fallback",
			test_equals_without_impl_uses_builtin_fallback,
		),
		(
			"aliased equals builtin fallback uses canonical name",
			test_aliased_equals_builtin_fallback_uses_canonical_name,
		),
		("record operator resolves", test_operator_resolves_for_record_type),
		("primitive operator keeps fast path", test_primitive_operator_keeps_fast_path),
		(
			"unregistered trait call falls through",
			test_unregistered_trait_call_falls_through_to_later_resolution,
		),
		(
			"prelude builtin trait method falls through",
			test_prelude_builtin_trait_method_falls_through,
		),
		(
			"resolved direct binding is not a missing impl",
			test_resolved_direct_binding_is_not_a_missing_impl,
		),
		("resource binding shadows body only", test_resource_binding_shadows_body_not_acquire),
		("static Self uses return type", test_static_self_dispatch_uses_return_type),
		("parameterized type keys do not collide", test_parameterized_type_keys_do_not_collide),
		("missing impl diagnostic is structured", test_missing_impl_has_structured_diagnostic),
		("deep left logical tree is stack bounded", test_deep_left_logical_tree_is_stack_bounded),
	]
}
