import:
	../../../src/compiler/stage_09_core/ir:
		CoreBinaryOp(AddOp),
		CoreCallKind(
			BuiltinCall,
			DeferredTraitCall,
			SelectedDirectCall,
			SelectedTraitCall,
			UnknownCall,
		),
		CoreDecl(FunctionDecl, ImplDecl, TraitDecl),
		CoreDimOp(DimDivide, DimMultiply, DimSubtract),
		CoreExpr(
			BinaryExpr,
			CallExpr,
			LiteralExpr,
			LogicalExpr,
			ResourceScopeExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunction,
		CoreFunctionKind(UnresolvedBuiltinFunction, UserFunction),
		CoreImplDecl,
		CoreLiteral(BoolLiteral, StringLiteral),
		CoreLogicalOp(AndOp),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreTensorDim(TensorDimOperation, TensorRuntimeDim, TensorStaticDim),
		CoreTraitDecl,
		CoreTraitMethod,
		CoreType(
			FunctionType,
			NamedType,
			RangeType,
			SelfType,
			TensorType,
			TupleType,
			TypeParameterType,
			VoidType,
		),
		CoreVar,
		core_expr_type,
	../../../src/compiler/stage_09_core/trait_resolve:
		CoreTraitResolveDiagnostic,
		core_trait_impl_type_key,
		core_trait_resolve_diagnostic_hint,
		core_trait_resolve_diagnostic_message,
		resolve_core_traits,
	test: TestSuite


pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


pure func string_type() -> CoreType:
	named_type("String")


pure func widget_type() -> CoreType:
	named_type("Widget")


pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func var_expr(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(named_var(name), typ, SyntheticSourceLoc)


pure func param(name: String, typ: CoreType) -> CoreParam:
	{
		name = named_var(name),
		typ = typ,
		loc = SyntheticSourceLoc
	}


pure func function_type(params: List[CoreType], return_type: CoreType) -> CoreType:
	FunctionType(True, params, return_type)


pure func string_literal(value: String) -> CoreExpr:
	LiteralExpr(StringLiteral(value), string_type(), SyntheticSourceLoc)


pure func bool_literal(value: Bool) -> CoreExpr:
	LiteralExpr(BoolLiteral(value), named_type("Bool"), SyntheticSourceLoc)


pure func call(
	kind: CoreCallKind,
	name: String,
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(
		kind,
		var_expr(
			name,
			function_type(
				args.map(core_expr_type),
				return_type,
			),
		),
		args,
		return_type,
		SyntheticSourceLoc,
	)


pure func function(
	name: String,
	def_id: Int,
	params: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
) -> CoreFunction:
	{
		name = name,
		source_module = None,
		type_params = [],
		params = params,
		return_type = return_type,
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc
	}


pure func trait_method(
	name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> CoreTraitMethod:
	{
		name = name,
		params = params,
		return_type = return_type,
		is_pure = True,
		loc = SyntheticSourceLoc
	}


pure func trait_decl(trait_name: String, methods: List[CoreTraitMethod]) -> CoreDecl:
	TraitDecl({
		name = trait_name,
		type_params = [],
		supertraits = [],
		methods = methods,
		loc = SyntheticSourceLoc,
	})


pure func impl_decl(
	trait_name: String,
	for_type: CoreType,
	methods: List[CoreFunction],
) -> CoreDecl:
	ImplDecl({
		trait_name = trait_name,
		for_type = for_type,
		type_params = [],
		methods = methods,
		loc = SyntheticSourceLoc,
	})


pure func stringable_trait(receiver_type: CoreType) -> CoreDecl:
	trait_decl(
		"Stringable",
		[trait_method("to_string", [param("value", receiver_type)], string_type())],
	)


pure func has_length_trait(receiver_type: CoreType) -> CoreDecl:
	trait_decl(
		"HasLength",
		[trait_method("length", [param("value", receiver_type)], named_type("Int"))],
	)


pure func stringable_impl(receiver_type: CoreType) -> CoreDecl:
	impl_decl(
		"Stringable",
		receiver_type,
		[
			function(
				"to_string",
				10,
				[param("value", receiver_type)],
				string_type(),
				string_literal("resolved"),
			),
		],
	)


pure func equatable_impl(receiver_type: CoreType) -> CoreDecl:
	impl_decl(
		"Equatable",
		receiver_type,
		[
			function(
				"equals",
				11,
				[param("left", receiver_type), param("right", receiver_type)],
				named_type("Bool"),
				bool_literal(True),
			),
		],
	)


pure func generic_stringable_impl() -> CoreDecl:
	ImplDecl({
		trait_name = "Stringable",
		for_type = NamedType("List", [TypeParameterType("T")]),
		type_params = [
			{
				name = "T",
				bounds = []
			},
		],
		methods = [
			{ function("to_string", 10, [param(
						"value",
						NamedType("List", [TypeParameterType("T")]),
					)], string_type(), string_literal("unused")) |
				source_module = Some("list"),
				type_params = ["T"],
				body = None,
				function_kind = UnresolvedBuiltinFunction
			},
		],
		loc = SyntheticSourceLoc,
	})


pure func generic_source_stringable_impl() -> CoreDecl:
	ImplDecl({
		trait_name = "Stringable",
		for_type = NamedType("List", [TypeParameterType("T")]),
		type_params = [
			{
				name = "T",
				bounds = []
			},
		],
		methods = [{ function("to_string", 10, [param(
						"value",
						NamedType("List", [TypeParameterType("T")]),
					)], string_type(), string_literal("generic")) | type_params = ["T"] }],
		loc = SyntheticSourceLoc,
	})


pure func program(decls: List[CoreDecl]) -> CoreProgram:
	{
		decls = decls,
		foreign_includes = []
	}


pure func resolved_main_body(source: CoreProgram) -> Option[CoreExpr]:
	match resolve_core_traits(source):
		Err(_):
			None
		Ok(resolved):
			match resolved.decls.get(resolved.decls.length() - 1):
				Some(FunctionDecl(info)):
					info.body
				_:
					None


pure func call_targets(expr: CoreExpr, expected_kind_unknown: Bool, expected_name: String) -> Bool:
	match expr:
		CallExpr(kind, VarExpr(variable, _, _), _, _, _):
			kind_ok: Bool = if expected_kind_unknown:
				match kind:
					UnknownCall:
						True
					_:
						False
			else:
				match kind:
					SelectedDirectCall(99):
						True
					_:
						False

			kind_ok and variable.name == expected_name
		_:
			False


pure func test_deferred_trait_call_resolves() -> Bool:
	value: CoreExpr = var_expr("value", widget_type())
	body: CoreExpr = call(
		DeferredTraitCall("Stringable", "to_string"),
		"to_string",
		[value],
		string_type(),
	)
	main: CoreDecl = FunctionDecl(
		function(
			"main",
			20,
			[param("value", widget_type())],
			string_type(),
			body,
		),
	)

	match resolved_main_body(program([
		stringable_trait(widget_type()),
		stringable_impl(widget_type()),
		main,
	])):
		Some(resolved):
			call_targets(resolved, True, "Stringable_to_string_Widget")
		None:
			False


pure func test_selected_trait_call_resolves_by_trait_identity() -> Bool:
	value: CoreExpr = var_expr("value", widget_type())
	body: CoreExpr = call(
		SelectedTraitCall("Stringable", "to_string", "app", 10),
		"__ufcs_app__to_string",
