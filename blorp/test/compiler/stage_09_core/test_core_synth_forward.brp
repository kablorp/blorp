import:
	../../../src/compiler/stage_09_core/ir:
		CoreCallKind(BuiltinCall, IntrinsicCall),
		CoreExpr(CallExpr, LiteralExpr, VarExpr),
		CoreFunction,
		CoreFunctionKind(UnresolvedBuiltinFunction),
		CoreLiteral(IntLiteral),
		CoreParam,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreTensorDim(TensorStaticDim),
		CoreType(FunctionType, NamedType, TensorType, VoidType),
		CoreVar,
	../../../src/compiler/stage_09_core/synth_forward: synthesize_forward_body
	test: TestSuite


private INT_TYPE: CoreType = NamedType("Int", [])

private FLOAT_TYPE: CoreType = NamedType("Float", [])

private STRING_TYPE: CoreType = NamedType("String", [])

private BYTES_TYPE: CoreType = NamedType("Bytes", [])

private FIXED_TYPE: CoreType = NamedType("Fixed", [])


pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func named_type(name: String, args: List[CoreType]) -> CoreType:
	NamedType(name, args)


pure func tensor_type(element_type: CoreType) -> CoreType:
	TensorType({
		element_type = element_type,
		dims = [TensorStaticDim(4)],
	})


pure func param(name: String, typ: CoreType) -> CoreParam:
	{
		name = core_var(name),
		typ = typ,
		loc = SyntheticSourceLoc
	}


pure func builtin_function(
	module_name: String,
	source_name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> CoreFunction:
	{
		name = module_name.replace("/", "_") + "__" + source_name + "__mono_fixture",
		source_module = Some(module_name),
		type_params = [],
		params = params,
		return_type = return_type,
		body = None,
		is_pure = True,
		function_kind = UnresolvedBuiltinFunction,
		def_id = 1,
		loc = SyntheticSourceLoc
	}


pure func builtin_forward_matches(
	function_info: CoreFunction,
	expected_name: String,
	expected_arity: Int,
) -> Bool:
	match synthesize_forward_body(function_info):
		Some(CallExpr(BuiltinCall(name), _, args, _, _)):
			name == expected_name and args.length() == expected_arity and args.all(func(arg):
				match arg:
					VarExpr(_, _, _):
						True
					_:
						False
			)
		_:
			False


pure func test_bytes_codec_forwards_to_runtime() -> Bool:
	builtin_forward_matches(
		builtin_function(
			"bytes",
			"from_hex",
			[param("text", STRING_TYPE)],
			named_type("Option", [BYTES_TYPE]),
		),
		"blorp_bytes_from_hex",
		1,
	)


pure func test_fixed_default_precision_is_explicit() -> Bool:
	function_info = builtin_function(
		"fixed",
		"fixed",
		[param("value", FLOAT_TYPE), param("scale", INT_TYPE)],
		FIXED_TYPE,
	)

	match synthesize_forward_body(function_info):
		Some(CallExpr(BuiltinCall("blorp_fixed_new"), _, [VarExpr(_, _, _), VarExpr(_, _, _), LiteralExpr(IntLiteral(18), _, _)], _, _)):
			True
		_:
			False


pure func test_stream_operation_forwards_to_runtime() -> Bool:
	stream_type = named_type("Stream", [INT_TYPE])
	mapper_type = FunctionType(True, [INT_TYPE], STRING_TYPE)
	consumer_type = FunctionType(False, [INT_TYPE], VoidType)

	builtin_forward_matches(
		builtin_function(
			"stream",
			"map",
			[param("stream", stream_type), param("mapper", mapper_type)],
			named_type("Stream", [STRING_TYPE]),
		),
		"blorp_stream_map",
		2,
	) and builtin_forward_matches(
		builtin_function(
			"stream",
			"for_each",
			[param("stream", stream_type), param("consumer", consumer_type)],
			VoidType,
		),
		"blorp_stream_for_each",
		2,
	)


pure func test_tensor_operations_use_their_intended_call_kinds() -> Bool:
	tensor = tensor_type(FLOAT_TYPE)
	checked_set = builtin_function(
		"tensor",
		"checked_set",
		[param("tensor", tensor), param("index", INT_TYPE), param("value", FLOAT_TYPE)],
		tensor,
	)
	length = builtin_function("tensor", "length", [param("tensor", tensor)], INT_TYPE)

	builtin_matches: Bool = builtin_forward_matches(checked_set, "blorp_checked_set", 3)

	intrinsic_matches: Bool = match synthesize_forward_body(length):
		Some(CallExpr(IntrinsicCall("tensor_len"), _, [VarExpr(_, _, _)], _, _)):
			True
		_:
			False

	matrix_matches: Bool = builtin_forward_matches(
		builtin_function("matrix", "transpose", [param("matrix", tensor)], tensor),
		"blorp_tensor_transpose",
		1,
	)

	builtin_matches and intrinsic_matches and matrix_matches


pure func test_forward_synthesis_rejects_wrong_module_and_signature() -> Bool:
	wrong_module = builtin_function(
		"app/bytes",
		"from_hex",
		[param("text", STRING_TYPE)],
		named_type("Option", [BYTES_TYPE]),
	)
	wrong_signature = builtin_function(
		"bytes",
		"from_hex",
		[param("text", BYTES_TYPE)],
		named_type("Option", [BYTES_TYPE]),
	)

	(
		synthesize_forward_body(wrong_module) == None
		and synthesize_forward_body(wrong_signature) == None
	)


tests: TestSuite = {
	description = "Compiler Core runtime-forward synthesis",
	tests = [
		("bytes codec forwards to runtime", test_bytes_codec_forwards_to_runtime),
		("Fixed default precision is explicit", test_fixed_default_precision_is_explicit),
		("stream operation forwards to runtime", test_stream_operation_forwards_to_runtime),
		(
			"tensor operations use intended call kinds",
			test_tensor_operations_use_their_intended_call_kinds,
		),
		(
			"forward synthesis rejects wrong module and signature",
			test_forward_synthesis_rejects_wrong_module_and_signature,
		),
	]
}
