pure func test_managed_string_source_access_is_borrowed() -> Bool:
	match collection_same_type_source_access_policy(
		collection_pipeline_model(fixture_list_program()),
		TY_STRING,
		[TY_STRING],
	):
		CollectionEligible(policy):
			policy.source_access == CollectionBorrowManagedAlias
		CollectionIneligible(_):
			False


pure func test_managed_string_is_not_unknown_layout() -> Bool:
	match collection_same_type_source_access_policy(
		collection_pipeline_model(fixture_list_program()),
		TY_STRING,
		[TY_STRING],
	):
		CollectionIneligible(CollectionUnknownLayout("String")):
			False
		_:
			True


pure func test_managed_string_collect_borrows_source_elements() -> Bool:
	source: CoreExpr = variable("items", LIST_STRING)
	predicate: CoreExpr = callback("predicate", [TY_STRING], TY_BOOL)
	fused: CoreExpr = fuse(filter_call(source, predicate, LIST_STRING))

	(
		count_handoffs(fused) == 1
		and count_unbox_let_bindings(fused, TY_STRING) == 0
		and count_intrinsic("list_handoff_set_source_slot", fused) == 1
	)


pure func test_managed_length_borrows_source_without_allocation() -> Bool:
	source: CoreExpr = variable("items", LIST_STRING)
	predicate: CoreExpr = callback("predicate", [TY_STRING], TY_BOOL)
	fused: CoreExpr = fuse(length_call(filter_call(source, predicate, LIST_STRING)))

	(
		count_loops(fused) == 1
		and count_list_call("filter", fused) == 0
		and count_list_call("length", fused) == 0
		and count_intrinsic("list_alloc", fused) == 0
		and count_unbox_let_bindings(fused, TY_STRING) == 0
	)


pure func test_stack_option_collect_binds_unboxed_values() -> Bool:
	option_int: CoreType = NamedType("Option", [TY_INT])
	source: CoreExpr = variable("items", LIST_OPTION_INT)
	predicate: CoreExpr = callback("predicate", [option_int], TY_BOOL)
	fused: CoreExpr = fuse(filter_call(source, predicate, LIST_OPTION_INT))

	count_handoffs(fused) == 1 and count_unbox_let_bindings(fused, option_int) == 1


pure func test_stack_option_collect_policy_is_available() -> Bool:
	option_int: CoreType = NamedType("Option", [TY_INT])
	source: CoreExpr = variable("items", LIST_OPTION_INT)
	predicate: CoreExpr = callback("predicate", [option_int], TY_BOOL)

	match collection_pipeline_plan(fixture_copy_names(), filter_call(source, predicate, LIST_OPTION_INT)):
		Some(plan):
			collection_collect_policy_for_plan(
				collection_pipeline_model(fixture_list_program()),
				plan,
			).is_some()
		None:
			False


pure func test_stack_option_source_access_is_unboxed() -> Bool:
	option_int: CoreType = NamedType("Option", [TY_INT])

	match collection_same_type_source_access_policy(
		collection_pipeline_model(fixture_list_program()),
		option_int,
		[option_int],
	):
		CollectionEligible(policy):
			policy.source_access == CollectionBindUnboxedValue
		CollectionIneligible(_):
			False


pure func test_stack_option_types_compare_equal() -> Bool:
	option_int: CoreType = NamedType("Option", [TY_INT])

	match collection_same_type_source_access_policy(
		collection_pipeline_model(fixture_list_program()),
		option_int,
		[option_int],
	):
		CollectionIneligible(CollectionTypesDiffer):
			False
		_:
			True


pure func test_arc_boxed_int128_collect_is_not_lowered() -> Bool:
	source: CoreExpr = variable("items", LIST_INT128)
	predicate: CoreExpr = callback("predicate", [TY_INT128], TY_BOOL)
	mapper: CoreExpr = callback("mapper", [TY_INT128], TY_INT128)
	fused: CoreExpr = fuse(
		map_call(
			filter_call(source, predicate, LIST_INT128),
			mapper,
			LIST_INT128,
		),
	)

	count_handoffs(fused) == 0 and count_list_call("map", fused) == 1


