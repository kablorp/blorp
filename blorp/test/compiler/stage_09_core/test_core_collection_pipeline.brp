pure func test_no_capture_lambda_is_inlined() -> Bool:
	param: CoreParam = {
		name = core_var("value"),
		typ = TY_INT,
		loc = synthetic_core_source_loc()
	}
	lambda: CoreExpr = LambdaExpr(
		[param],
		TY_INT,
		VarExpr(param.name, TY_INT, synthetic_core_source_loc()),
		True,
		FunctionType(True, [TY_INT], TY_INT),
		synthetic_core_source_loc(),
	)
	fused: CoreExpr = fuse(map_call(variable("items", LIST_INT), lambda, LIST_INT))

	count_handoffs(fused) == 1 and count_closure_calls(fused) == 0


pure func test_generated_names_use_compiler_namespace() -> Bool:
	source: CoreExpr = variable("$blorp$collection_pipeline$6$source$1", LIST_INT)
	predicate: CoreExpr = callback("predicate", [TY_INT], TY_BOOL)
	fused: CoreExpr = fuse(filter_call(source, predicate, LIST_INT))

	count_expr(fused, pure func(candidate):
		match candidate:
			ListHandoffExpr(handoff, _, _):
				handoff.source_var.name.starts_with("$blorp$collection_pipeline$")
			_:
				False
	) == 1


tests: TestSuite = {
	description = "Core collection pipeline",
	tests = [
		("bare source is not a pipeline", test_rejects_bare_list_source),
		("pipeline stages are nonempty", test_exposes_nonempty_pipeline_stages),
		("pipeline stages fold in order", test_folds_nonempty_pipeline_stages_in_order),
		(
			"pure mono instance is read through its declaration",
			test_reads_a_pure_mono_instance_through_its_declaration,
		),
		("mono marker in a name is not read", test_does_not_read_a_mono_marker_from_a_name),
		("filter map fold fuses", test_lowers_filter_map_fold_without_intermediate_lists),
		("bare fold fuses", test_lowers_bare_fold),
		("filter length avoids allocation", test_lowers_filter_length_without_result_allocation),
		("impure pipeline is unchanged", test_impure_pipeline_is_not_lowered),
		("impure reducer is unchanged", test_impure_terminal_reducer_is_not_lowered),
		("range pipeline fuses", test_lowers_range_pipeline_without_materializing_range),
		(
			"range length avoids materialization",
			test_lowers_range_length_without_materializing_range,
		),
		("range fold avoids materialization", test_lowers_range_fold_without_materializing_range),
		("list collect uses owned scalar store", test_list_collect_uses_owned_scalar_store),
		("filter map collect uses owned store", test_filter_map_collect_uses_owned_store),
		("filter map policy tracks payload", test_filter_map_policy_tracks_borrowed_payload),
		("managed filter map uses owned store", test_managed_filter_map_collect_uses_owned_store),
		("managed filter map plan is recognized", test_managed_filter_map_plan_is_recognized),
		("managed filter map policy is available", test_managed_filter_map_policy_is_available),
		("managed string source access is borrowed", test_managed_string_source_access_is_borrowed),
		("managed string is not unknown layout", test_managed_string_is_not_unknown_layout),
		(
			"managed string elements are borrowed",
			test_managed_string_collect_borrows_source_elements,
		),
		(
			"managed length borrows without allocation",
			test_managed_length_borrows_source_without_allocation,
		),
		("stack options are unboxed values", test_stack_option_collect_binds_unboxed_values),
		("stack option collect policy is available", test_stack_option_collect_policy_is_available),
		("stack option source access is unboxed", test_stack_option_source_access_is_unboxed),
		("stack option types compare equal", test_stack_option_types_compare_equal),
		("arc boxed int128 is unchanged", test_arc_boxed_int128_collect_is_not_lowered),
		("unknown layout is ineligible", test_unknown_layout_has_no_collect_policy),
		("heap record uses borrow policy", test_registered_heap_record_uses_borrow_policy),
		(
			"heap record alias handoff preserves release metadata",
			test_heap_record_alias_handoff_preserves_release_metadata,
		),
		("alias policy uses canonical type", test_alias_policy_uses_canonical_type),
		("alias pipeline plan is recognized", test_alias_pipeline_plan_is_recognized),
		("alias type is canonicalized", test_alias_type_is_canonicalized),
		("no capture lambda is inlined", test_no_capture_lambda_is_inlined),
		("generated names use compiler namespace", test_generated_names_use_compiler_namespace),
	]
}
