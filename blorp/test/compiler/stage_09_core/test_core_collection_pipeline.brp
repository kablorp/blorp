pure func test_registered_heap_record_uses_borrow_policy() -> Bool:
	widget_decl: CoreHeapRecordDecl = {
		abi_type = None,
		name = "Widget",
		type_params = [],
		fields = [],
		loc = synthetic_core_source_loc()
	}
	program: CoreProgram = {
		decls = [HeapRecordDecl(widget_decl)],
		foreign_includes = [],
		source_files = []
	}
	source: CoreExpr = variable("items", LIST_WIDGET)
	predicate: CoreExpr = callback("predicate", [TY_WIDGET], TY_BOOL)

	match collection_pipeline_plan(fixture_copy_names(), filter_call(source, predicate, LIST_WIDGET)):
		Some(plan):
			match collection_collect_policy_for_plan(collection_pipeline_model(program), plan):
				Some(policy):
					policy.source_access == CollectionBorrowManagedAlias
				None:
					False
		None:
			False


pure func test_heap_record_alias_handoff_preserves_release_metadata() -> Bool:
	alias_type: CoreType = NamedType("WidgetAlias", [])
	program: CoreProgram = {
		decls = fixture_list_program().decls.concat([TypeAliasDecl({
				abi_type = None,
				name = "WidgetAlias",
				type_params = [],
				target = TY_WIDGET,
				is_opaque = False,
				loc = synthetic_core_source_loc(),
			}), HeapRecordDecl({
				abi_type = None,
				name = "Widget",
				type_params = [],
				fields = [],
				loc = synthetic_core_source_loc(),
			})]),
		foreign_includes = [],
		source_files = []
	}
	source_type: CoreType = NamedType("List", [alias_type])
	source: CoreExpr = variable("items", source_type)
	predicate: CoreExpr = callback("predicate", [alias_type], TY_BOOL)
	fused: CoreExpr = fuse_collection_expr(
		collection_pipeline_model(program),
		filter_call(source, predicate, source_type),
	)

	count_expr(fused, pure func(candidate):
		match candidate:
			ListHandoffExpr(handoff, _, _):
				match handoff.layout:
					PointerListStorage:
						handoff.elem_needs_release
					_:
						False
			_:
				False
	) == 1


pure func test_alias_policy_uses_canonical_type() -> Bool:
	alias_decl: CoreTypeAliasDecl = {
		abi_type = None,
		name = "Count",
		type_params = [],
		target = TY_INT,
		is_opaque = False,
		loc = synthetic_core_source_loc()
	}
	program: CoreProgram = {
		decls = [TypeAliasDecl(alias_decl)],
		foreign_includes = [],
		source_files = []
	}
	source: CoreExpr = variable(
		"items",
		NamedType("List", [TY_COUNT]),
	)
	mapper: CoreExpr = callback("mapper", [TY_COUNT], TY_INT)

	match collection_pipeline_plan(fixture_copy_names(), map_call(source, mapper, LIST_INT)):
		Some(plan):
			match collection_collect_policy_for_plan(collection_pipeline_model(program), plan):
				Some(policy):
					(
						policy.source_access == CollectionBindUnboxedValue
						and core_mono_type_equal(policy.result_element_type, TY_INT)
						and policy.filter_map_payload_policy == CollectionNoFilterMapPayload
					)
				None:
					False
		None:
			False


