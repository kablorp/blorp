		and count_list_call("length", fused) == 0
		and count_intrinsic("list_alloc", fused) == 0
	)


pure func test_lowers_range_fold_without_materializing_range() -> Bool:
	mapper: CoreExpr = callback("mapper", [TY_INT], TY_INT)
