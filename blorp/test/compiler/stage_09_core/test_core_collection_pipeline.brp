TY_INT: CoreType = NamedType("Int", [])

TY_BOOL: CoreType = NamedType("Bool", [])

TY_STRING: CoreType = NamedType("String", [])

TY_INT128: CoreType = NamedType("Int128", [])

TY_COUNT: CoreType = NamedType("Count", [])

TY_WIDGET: CoreType = NamedType("Widget", [])

LIST_INT: CoreType = NamedType("List", [TY_INT])

LIST_STRING: CoreType = NamedType("List", [TY_STRING])

LIST_INT128: CoreType = NamedType("List", [TY_INT128])

LIST_OPTION_INT: CoreType = NamedType("List", [NamedType("Option", [TY_INT])])

LIST_WIDGET: CoreType = NamedType("List", [TY_WIDGET])

-- The `list` declarations the fixture calls reach, by member name, each with
-- the mono instance the call site names. A call's declared name is read through
-- the instance's origin, so the instance's own spelling can be anything.
private LIST_FIXTURE_DECLARATIONS: List[(String, String)] = [
	("filter", "list__filter__mono_Value"),
	("map", "list__map__mono_Value_Value"),
	("filter_map", "list__filter_map__mono_Value_Value"),
	("fold_left", "list__fold_left__mono_Value_Value"),
	("length", "list__length__mono_Value"),
	("range", "list__range"),
]

private FIXTURE_DECLARATION_ID_BASE: Int = 100

private FIXTURE_INSTANCE_ID_BASE: Int = 200

-- The pure overload of `list__filter` and its `Int` instance: an instance of a
-- pure variant reaches the declaration through both origins.
private FIXTURE_PURE_FILTER_VARIANT_ID: Int = 300

private FIXTURE_PURE_FILTER_INSTANCE_ID: Int = 301

private FIXTURE_PURE_FILTER_INSTANCE_NAME: String = "list__filter__pure__mono_Int"


private pure func fixture_list_function(member: String, def_id: Int) -> CoreFunction:
	{
		name = "list__" + member,
		source_module = Some("list"),
		module = FIXTURE_NO_SOURCE_MODULE,
		type_params = [],
		params = [],
		return_type = VoidType,
		body = None,
		is_pure = True,
		origin = fixture_source_function_origin_named(member),
		function_kind = UnresolvedBuiltinFunction,
		def_id = def_id,
		loc = synthetic_core_source_loc()
	}


private pure func fixture_list_program() -> CoreProgram:
	var decls: List[CoreDecl] = []
	var index: Int = 0

	for entry in LIST_FIXTURE_DECLARATIONS:
		declaration: CoreFunction = fixture_list_function(entry[0], FIXTURE_DECLARATION_ID_BASE + index)
		instance_id: Int = FIXTURE_INSTANCE_ID_BASE + index

		decls = decls
			.append(FunctionDecl(declaration))
			.append(FunctionDecl(fixture_mono_instance_of(declaration, entry[1], instance_id)))
		index += 1

	filter_declaration: CoreFunction = fixture_list_function("filter", FIXTURE_DECLARATION_ID_BASE)
	pure_filter: CoreFunction = fixture_pure_variant_of(
		filter_declaration,
		"list__filter__pure",
		FIXTURE_PURE_FILTER_VARIANT_ID,
	)

	{
		decls = decls
			.append(FunctionDecl(pure_filter))
			.append(
				FunctionDecl(
					fixture_mono_instance_of(
						pure_filter,
						FIXTURE_PURE_FILTER_INSTANCE_NAME,
						FIXTURE_PURE_FILTER_INSTANCE_ID,
					),
				),
			),
		foreign_includes = [],
		source_files = []
	}


-- The fixture program's mono instances and pure variants, by def id.
pure func collection_pipeline_model(program: CoreProgram) -> CoreCollectionPipelineModel:
	collection_pipeline_model_with_names(fixture_declarations(program), program)


private pure func fixture_declarations(program: CoreProgram) -> CoreDeclarationIndex:
	fixture_declaration_index(SYNTHESIZED_NAME_TABLE, program)


private pure func fixture_copy_names() -> CoreDeclarationIndex:
	fixture_declarations(fixture_list_program())


private pure func fixture_callee_def_id(name: String) -> Int:
	var index: Int = 0
	var found: Int = 1

	for entry in LIST_FIXTURE_DECLARATIONS:
		if entry[1] == name:
			found = FIXTURE_INSTANCE_ID_BASE + index

		index += 1

	found


EMPTY_PROGRAM: CoreProgram = {
	decls = [],
	foreign_includes = [],
	source_files = []
}


private pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = None,
		origin = AuthoredBinder
	}


private pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, synthetic_core_source_loc())


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), TY_INT, synthetic_core_source_loc())


private pure func callback(name: String, params: List[CoreType], return_type: CoreType) -> CoreExpr:
	variable(
		name,
		FunctionType(True, params, return_type),
	)


private pure func impure_callback(
	name: String,
	params: List[CoreType],
	return_type: CoreType,
) -> CoreExpr:
	variable(
		name,
		FunctionType(False, params, return_type),
	)


private pure func user_call(name: String, args: List[CoreExpr], return_type: CoreType) -> CoreExpr:
	CallExpr(
		UserCall(name, Some(fixture_callee_def_id(name)), []),
		variable(
			name,
			FunctionType(
				True,
				args.map(core_expr_type),
				return_type,
			),
		),
		args,
		return_type,
		synthetic_core_source_loc(),
	)


private pure func range_call(start: CoreExpr, stop: CoreExpr) -> CoreExpr:
	user_call(
		"list__range",
		[start, stop],
		LIST_INT,
	)


private pure func filter_call(
	source: CoreExpr,
	predicate: CoreExpr,
	result_type: CoreType,
) -> CoreExpr:
	user_call(
		"list__filter__mono_Value",
		[source, predicate],
		result_type,
	)


private pure func map_call(source: CoreExpr, mapper: CoreExpr, result_type: CoreType) -> CoreExpr:
	user_call(
		"list__map__mono_Value_Value",
		[source, mapper],
		result_type,
	)


private pure func filter_map_call(
	source: CoreExpr,
	mapper: CoreExpr,
	result_type: CoreType,
) -> CoreExpr:
	user_call(
		"list__filter_map__mono_Value_Value",
		[source, mapper],
		result_type,
	)


private pure func fold_call(
	source: CoreExpr,
	initial: CoreExpr,
	reducer: CoreExpr,
	result_type: CoreType,
) -> CoreExpr:
	user_call(
		"list__fold_left__mono_Value_Value",
		[source, initial, reducer],
		result_type,
	)


private pure func length_call(source: CoreExpr) -> CoreExpr:
	user_call("list__length__mono_Value", [source], TY_INT)


private pure func filter_map_fold_expr() -> CoreExpr:
	source: CoreExpr = variable("xs", LIST_INT)
	predicate: CoreExpr = callback("predicate", [TY_INT], TY_BOOL)
	mapper: CoreExpr = callback("mapper", [TY_INT], TY_INT)
	reducer: CoreExpr = callback(
		"reducer",
		[TY_INT, TY_INT],
		TY_INT,
	)

	fold_call(
		map_call(
			filter_call(source, predicate, LIST_INT),
			mapper,
			LIST_INT,
		),
		int_literal(0),
		reducer,
		TY_INT,
	)


private pure func count_expr(
	expr: CoreExpr,
	predicate: pure (CoreExpr) -> Bool,
) -> Int:
	var count: Int = if predicate(expr):
		1
	else:
		0

	for child in immediate_core_expr_children(expr):
		count += count_expr(child, predicate)

	count


private pure func known_list_function(member: String) -> Option[CoreKnownFunction]:
	match member:
		"range":
			Some(ListRange)
		"filter":
			Some(ListFilter)
		"filter_map":
			Some(ListFilterMap)
		"map":
			Some(ListMap)
		"fold_left":
			Some(ListFoldLeft)
		"length":
			Some(ListLength)
		_:
			None


private pure func count_list_call(member: String, expr: CoreExpr) -> Int:
	count_expr(expr, pure func(candidate):
		match collection_pipeline_known_call(fixture_copy_names(), candidate):
			Some(call):
				known_list_function(member) == Some(call.function)
			None:
				False
	)


private pure func count_intrinsic(name: String, expr: CoreExpr) -> Int:
	count_expr(expr, pure func(candidate):
		match candidate:
			CallExpr(IntrinsicCall(actual), _, _, _, _):
				actual == name
			_:
				False
	)


private pure func count_loops(expr: CoreExpr) -> Int:
	count_expr(expr, pure func(candidate):
		match candidate:
			ForRangeExpr(_, _, _, _, _, _):
				True
			_:
				False
	)


private pure func count_handoffs(expr: CoreExpr) -> Int:
	count_expr(expr, pure func(candidate):
		match candidate:
			ListHandoffExpr(_, _, _):
				True
			_:
				False
	)


private pure func count_closure_calls(expr: CoreExpr) -> Int:
	count_expr(expr, pure func(candidate):
		match candidate:
			CallExpr(ClosureCall, _, _, _, _):
				True
			_:
				False
	)


private pure func count_borrow_bindings(expr: CoreExpr) -> Int:
	count_expr(expr, pure func(candidate):
		match candidate:
			BorrowLetExpr(_, _, _, _):
				True
			_:
				False
	)


private pure func count_unbox_let_bindings(expr: CoreExpr, element_type: CoreType) -> Int:
	count_expr(expr, pure func(candidate):
		match candidate:
			LetExpr(_, _, typ, UnboxExpr(_, _, _, _), _):
				core_mono_type_equal(typ, element_type)
			_:
				False
	)


private pure func fuse(expr: CoreExpr) -> CoreExpr:
	fuse_collection_expr(collection_pipeline_model(fixture_list_program()), expr)


pure func test_rejects_bare_list_source() -> Bool:
	collection_pipeline_plan(fixture_copy_names(), variable("xs", LIST_INT)).is_none()


pure func test_exposes_nonempty_pipeline_stages() -> Bool:
	match collection_pipeline_plan(fixture_copy_names(), filter_map_fold_expr()):
		Some(plan):
			match (plan.source, collection_pipeline_stages(plan), plan.sink):
				(CollectionListSource(_, _), [CollectionFilterStage(_, _), CollectionMapStage(_, _, _)], CollectionFoldSink(_, _, _)):
					True
				_:
					False
		None:
			False


pure func test_folds_nonempty_pipeline_stages_in_order() -> Bool:
	match collection_pipeline_plan(fixture_copy_names(), filter_map_fold_expr()):
		Some(plan):
			fold_collection_pipeline_stages(plan, "", pure func(acc, stage):
				match stage:
					CollectionFilterStage(_, _):
						acc + "F"
					CollectionMapStage(_, _, _):
						acc + "M"
					_:
						acc + "?"
			) == "FM"
		None:
			False


-- A call to a mono instance of a pure variant is read through both origins to the
-- declaration, whatever the instance is called.
pure func test_reads_a_pure_mono_instance_through_its_declaration() -> Bool:
	call: CoreExpr = CallExpr(
		UserCall(FIXTURE_PURE_FILTER_INSTANCE_NAME, Some(FIXTURE_PURE_FILTER_INSTANCE_ID), []),
		variable(FIXTURE_PURE_FILTER_INSTANCE_NAME, FunctionType(True, [LIST_INT, TY_BOOL], LIST_INT)),
		[variable("xs", LIST_INT), variable("predicate", TY_BOOL)],
		LIST_INT,
		synthetic_core_source_loc(),
	)

	match collection_pipeline_known_call(fixture_copy_names(), call):
		Some(recognized):
			recognized.function == ListFilter
		None:
			False


-- The marker in a name is no longer evidence: a call the origin table does not
-- list as a copy is read by its own name, which here names no list function.
pure func test_does_not_read_a_mono_marker_from_a_name() -> Bool:
	call: CoreExpr = CallExpr(
		UserCall("list__filter__mono_Int", Some(1), []),
		variable("list__filter__mono_Int", FunctionType(True, [LIST_INT, TY_BOOL], LIST_INT)),
		[variable("xs", LIST_INT), variable("predicate", TY_BOOL)],
		LIST_INT,
		synthetic_core_source_loc(),
	)

	collection_pipeline_known_call(fixture_copy_names(), call).is_none()


pure func test_lowers_filter_map_fold_without_intermediate_lists() -> Bool:
	fused: CoreExpr = fuse(filter_map_fold_expr())

	(
		count_loops(fused) == 1
		and count_list_call("filter", fused) == 0
		and count_list_call("map", fused) == 0
		and count_list_call("fold_left", fused) == 0
		and count_handoffs(fused) == 0
		and count_borrow_bindings(fused) == 1
	)


pure func test_lowers_bare_fold() -> Bool:
	source: CoreExpr = variable("xs", LIST_INT)
	reducer: CoreExpr = callback(
		"reducer",
		[TY_INT, TY_INT],
		TY_INT,
	)
	fused: CoreExpr = fuse(fold_call(source, int_literal(0), reducer, TY_INT))

	count_loops(fused) == 1 and count_list_call("fold_left", fused) == 0


pure func test_lowers_filter_length_without_result_allocation() -> Bool:
	source: CoreExpr = variable("xs", LIST_INT)
	predicate: CoreExpr = callback("predicate", [TY_INT], TY_BOOL)
	fused: CoreExpr = fuse(length_call(filter_call(source, predicate, LIST_INT)))

	(
		count_loops(fused) == 1
		and count_list_call("filter", fused) == 0
		and count_list_call("length", fused) == 0
		and count_handoffs(fused) == 0
		and count_intrinsic("list_alloc", fused) == 0
	)


pure func test_impure_pipeline_is_not_lowered() -> Bool:
	source: CoreExpr = variable("xs", LIST_INT)
	predicate: CoreExpr = impure_callback("predicate", [TY_INT], TY_BOOL)
	fused: CoreExpr = fuse(length_call(filter_call(source, predicate, LIST_INT)))

	count_loops(fused) == 0 and count_list_call("filter", fused) == 1


pure func test_impure_terminal_reducer_is_not_lowered() -> Bool:
	source: CoreExpr = variable("xs", LIST_INT)
	predicate: CoreExpr = callback("predicate", [TY_INT], TY_BOOL)
	reducer: CoreExpr = impure_callback(
		"reducer",
		[TY_INT, TY_INT],
		TY_INT,
	)
	fused: CoreExpr = fuse(
		fold_call(
			filter_call(source, predicate, LIST_INT),
			int_literal(0),
			reducer,
			TY_INT,
		),
	)

	count_list_call("fold_left", fused) == 1


pure func test_lowers_range_pipeline_without_materializing_range() -> Bool:
	mapper: CoreExpr = callback("mapper", [TY_INT], TY_INT)
	predicate: CoreExpr = callback("predicate", [TY_INT], TY_BOOL)
	range: CoreExpr = range_call(
		int_literal(0),
		variable("stop", TY_INT),
	)
	fused: CoreExpr = fuse(filter_call(map_call(range, mapper, LIST_INT), predicate, LIST_INT))

	(
		count_loops(fused) == 1
		and count_list_call("range", fused) == 0
		and count_list_call("map", fused) == 0
		and count_list_call("filter", fused) == 0
		and count_intrinsic("list_alloc", fused) == 1
	)


