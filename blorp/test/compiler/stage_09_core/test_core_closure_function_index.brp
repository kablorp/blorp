import:
	../../../src/compiler/stage_09_core/closure:
		ClosureFunctionIndexDiagnosticSnapshot,
		closure_function_index_diagnostic_snapshot,
	../../../src/compiler/stage_09_core/ir:
		CoreClosureAbi,
		CoreDecl(FunctionDecl, ImplDecl),
		CoreFunction,
		CoreFunctionKind(ClosureBodyFunction, UserFunction),
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType),
	test: TestSuite


private INT_TYPE: CoreType = NamedType("Int", [])


private pure func closure_abi(name: String) -> CoreClosureAbi:
	{
		c_name = name + "_c",
		params = [],
		captures = [],
		moved_captures = [],
		task_abi = False
	}


private pure func user_function(name: String, def_id: Int) -> CoreFunction:
	{
		name = name,
		source_module = None,
		type_params = [],
		params = [],
		return_type = INT_TYPE,
		body = None,
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc
	}


private pure func generated_function(name: String, def_id: Int) -> CoreFunction:
	{ user_function(name, def_id) | function_kind = ClosureBodyFunction(closure_abi(name)) }


private pure func test_program() -> CoreProgram:
	{
		decls = [
			FunctionDecl(user_function("shared", 10)),
			FunctionDecl(user_function("ordinary", 20)),
			ImplDecl({
				trait_name = "Example",
				for_type = INT_TYPE,
				type_params = [],
				methods = [user_function("shared", 30), user_function("duplicate_id_impl", 10)],
				loc = SyntheticSourceLoc,
			}),
			FunctionDecl(generated_function("generated", 40)),
			FunctionDecl(generated_function("duplicate_id_generated", 10)),
			FunctionDecl(user_function("shared", 50)),
		],
		foreign_includes = []
	}


private pure func unique_test_program() -> CoreProgram:
	{
		decls = [FunctionDecl(user_function("alpha", 1)), ImplDecl({
				trait_name = "UniqueExample",
				for_type = INT_TYPE,
				type_params = [],
				methods = [user_function("beta", 2)],
				loc = SyntheticSourceLoc,
			}), FunctionDecl(generated_function("gamma", 3))],
		foreign_includes = []
	}


private pure func diagnostic_names(entries: List[(String, Int)]) -> List[String]:
	var names: List[String] = []

	for (name, _) in entries:
		names = names.append(name)

	names


private pure func diagnostic_def_ids(entries: List[(String, Int)]) -> List[Int]:
	var def_ids: List[Int] = []

	for (_, def_id) in entries:
		def_ids = def_ids.append(def_id)

	def_ids


private pure func test_snapshot() -> ClosureFunctionIndexDiagnosticSnapshot:
	closure_function_index_diagnostic_snapshot(
		test_program(),
		["shared", "generated", "duplicate_id_impl", "duplicate_id_generated"],
		[10],
	)


private pure func unique_test_snapshot() -> ClosureFunctionIndexDiagnosticSnapshot:
	closure_function_index_diagnostic_snapshot(
		unique_test_program(),
		["alpha", "beta", "gamma"],
		[1, 2, 3],
	)


private pure func test_closure_function_indexes_count_unique_functions() -> Bool:
	snapshot: ClosureFunctionIndexDiagnosticSnapshot = unique_test_snapshot()
	alpha_def_ids: List[Int] = snapshot.names
		.get(0)
		.map(func(diagnostic):
			diagnostic_def_ids(diagnostic[1])
		)
		.get_or([])
	beta_def_ids: List[Int] = snapshot.names
		.get(1)
		.map(func(diagnostic):
			diagnostic_def_ids(diagnostic[1])
		)
		.get_or([])
	gamma_def_ids: List[Int] = snapshot.names
		.get(2)
		.map(func(diagnostic):
			diagnostic_def_ids(diagnostic[1])
		)
		.get_or([])
	first_names: List[String] = snapshot.ids.map(func(diagnostic):
		diagnostic[1]
			.map(func(entry): entry[0])
			.get_or("")
	)

	(
		snapshot.by_id_count == 3
		and snapshot.by_name_count == 3
		and snapshot.collision_id_count == 0
		and snapshot.total_collision_entries == 0
		and alpha_def_ids == [1]
		and beta_def_ids == [2]
		and gamma_def_ids == [3]
		and first_names == ["alpha", "beta", "gamma"]
	)


private pure func test_closure_function_indexes_preserve_ordering() -> Bool:
	snapshot: ClosureFunctionIndexDiagnosticSnapshot = test_snapshot()
	shared_names: List[String] = snapshot.names
		.get(0)
		.map(func(diagnostic):
			diagnostic_names(diagnostic[1])
		)
		.get_or([])
	collision_names: List[String] = snapshot.ids
		.get(0)
		.map(func(diagnostic):
			diagnostic_names(diagnostic[2])
		)
		.get_or([])

	(
		snapshot.by_id_count == 5
		and snapshot.by_name_count == 5
		and snapshot.collision_id_count == 1
		and snapshot.total_collision_entries == 3
		and snapshot.ids
			.get(0)
			.map(func(diagnostic):
				diagnostic[1]
					.map(func(entry): entry[0] == "shared")
					.get_or(False)
			)
			.get_or(False)
		and shared_names == ["shared", "shared", "shared"]
		and collision_names == ["shared", "duplicate_id_impl", "duplicate_id_generated"]
	)


private pure func test_closure_function_indexes_include_impl_and_generated_functions() -> Bool:
	snapshot: ClosureFunctionIndexDiagnosticSnapshot = test_snapshot()
	shared_def_ids: List[Int] = snapshot.names
		.get(0)
		.map(func(diagnostic):
			diagnostic_def_ids(diagnostic[1])
		)
		.get_or([])
	generated_def_ids: List[Int] = snapshot.names
		.get(1)
		.map(func(diagnostic):
			diagnostic_def_ids(diagnostic[1])
		)
		.get_or([])
	duplicate_id_impl_def_ids: List[Int] = snapshot.names
		.get(2)
		.map(func(diagnostic):
			diagnostic_def_ids(diagnostic[1])
		)
		.get_or([])
	duplicate_id_generated_def_ids: List[Int] = snapshot.names
		.get(3)
		.map(func(diagnostic):
			diagnostic_def_ids(diagnostic[1])
		)
		.get_or([])
	collision_def_ids: List[Int] = snapshot.ids
		.get(0)
		.map(func(diagnostic):
			diagnostic_def_ids(diagnostic[2])
		)
		.get_or([])

	(
		shared_def_ids == [10, 30, 50]
		and collision_def_ids == [10, 10, 10]
		and generated_def_ids == [40]
		and duplicate_id_impl_def_ids == [10]
		and duplicate_id_generated_def_ids == [10]
	)


tests: TestSuite = {
	description = "Compiler Core closure function indexes",
	tests = [
		(
			"count unique top-level, impl, and generated functions",
			test_closure_function_indexes_count_unique_functions,
		),
		(
			"preserve duplicate id and duplicate name ordering",
			test_closure_function_indexes_preserve_ordering,
		),
		(
			"include implementation methods and generated functions",
			test_closure_function_indexes_include_impl_and_generated_functions,
		),
	]
}
