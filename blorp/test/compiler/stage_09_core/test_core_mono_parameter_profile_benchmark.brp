import:
	../../../benchmark/compiler/compiler_mono_parameter_profile_fixture:
		compiler_mono_parameter_profile_execute,
		compiler_mono_parameter_profile_fixture,
	test: TestSuite


pure func test_mono_parameter_profile_counts_wide_no_hit_work() -> Bool:
	result = compiler_mono_parameter_profile_execute({
		parameter_count = 8,
		queries_per_shape = 2,
		nesting_depth = 3,
		hit_position = -1,
	})

	(
		result.parameter_count == 8
		and result.top_level_queries == 18
		and result.legacy_type_nodes == result.indexed_type_nodes
		and result.legacy_parameter_leaves == result.indexed_parameter_leaves
		and result.legacy_names_compared > result.indexed_membership_queries
		and result.index_build_work == 8
		and result.legacy_checksum == result.indexed_checksum
		and result.legacy_checksum == result.production_checksum
		and result.workload_valid
	)


pure func test_mono_parameter_profile_counts_late_hit_work() -> Bool:
	result = compiler_mono_parameter_profile_execute({
		parameter_count = 8,
		queries_per_shape = 1,
		nesting_depth = 2,
		hit_position = 7,
	})

	(
		result.top_level_queries == 9
		and result.legacy_true_count == result.indexed_true_count
		and result.legacy_true_count == result.production_true_count
		and result.legacy_names_compared > result.indexed_membership_queries
		and result.workload_valid
	)


pure func test_mono_parameter_profile_normalizes_small_config() -> Bool:
	fixture = compiler_mono_parameter_profile_fixture({
		parameter_count = 0,
		queries_per_shape = 0,
		nesting_depth = 0,
		hit_position = 10,
	})

	(
		fixture.config.parameter_count == 1
		and fixture.config.queries_per_shape == 1
		and fixture.config.nesting_depth == 1
		and fixture.query_type_count == 9
		and fixture.top_level_queries == 9
	)


tests: TestSuite = {
	description = "Compiler Core monomorphization parameter profile benchmark",
	tests = [
		(
			"mono parameter profile counts wide no-hit work",
			test_mono_parameter_profile_counts_wide_no_hit_work,
		),
		(
			"mono parameter profile counts late-hit work",
			test_mono_parameter_profile_counts_late_hit_work,
		),
		(
			"mono parameter profile normalizes small config",
			test_mono_parameter_profile_normalizes_small_config,
		),
	]
}
