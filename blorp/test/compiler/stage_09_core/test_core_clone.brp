import:
	../../../src/compiler/stage_09_core/clone:
		clone_core_accessor,
		clone_core_literal,
		clone_core_source_loc,
		clone_core_type,
		clone_core_var,
	../../../src/compiler/stage_09_core/ir:
		CoreAccessor(
			RootAccessor,
			StackOptionPayloadAccessor,
			TupleFieldAccessor,
			VariantFieldAccessor,
		),
		CoreLiteral(StringLiteral),
		CoreSourceLoc(KnownSourceLoc),
		CoreType(NamedType, StackResultType, TensorType, TupleType),
		CoreVar,
		core_accessor_to_json,
		core_type_to_json,
	memory: is_unique
	test: TestSuite


pure func test_clones_recursive_core_type() -> Bool:
	original = StackResultType(
		TupleType([NamedType("List", [NamedType("String", [])]), TensorType({
				element_type = NamedType("Float", []),
				dims = [],
			})]),
		NamedType("Error", [NamedType("String", [])]),
	)
	cloned = clone_core_type(original)

	core_type_to_json(original).to_string() == core_type_to_json(cloned).to_string()


pure func test_clones_core_var() -> Bool:
	original: CoreVar = {
		name = "value",
		uniq = 7,
		def_id = Some(11)
	}
	cloned = clone_core_var(original)

	(
		original.name == cloned.name
		and original.uniq == cloned.uniq
		and original.def_id == cloned.def_id
	)


pure func test_clones_managed_literal() -> Bool:
	original = StringLiteral("managed")
	cloned = clone_core_literal(original)

	match cloned:
		StringLiteral(value):
			value == "managed"
		_:
			False


pure func test_clones_known_source_location() -> Bool:
	original = KnownSourceLoc("example.brp", 2, 3, 4, 5)
	cloned = clone_core_source_loc(original)

	match cloned:
		KnownSourceLoc(file, line, column, end_line, end_column):
			(
				file == "example.brp"
				and line == 2
				and column == 3
				and end_line == 4
				and end_column == 5
			)
		_:
			False


pure func test_clones_recursive_core_accessor() -> Bool:
	original = StackOptionPayloadAccessor(VariantFieldAccessor(RootAccessor, "Option", "Some", 0))
	cloned = clone_core_accessor(original)
	tuple_original = TupleFieldAccessor(
		RootAccessor,
		1,
		NamedType("List", [NamedType("String", [])]),
	)
	tuple_cloned = clone_core_accessor(tuple_original)

	(
		core_accessor_to_json(original).to_string() == core_accessor_to_json(cloned).to_string()
		and core_accessor_to_json(
			tuple_original,
		).to_string() == core_accessor_to_json(tuple_cloned).to_string()
	)


pure func test_recursive_accessor_clone_has_independent_owner() -> Bool:
	original = StackOptionPayloadAccessor(RootAccessor)
	cloned = clone_core_accessor(original)

	is_unique(original) and is_unique(cloned)


pure func test_tuple_accessor_clone_has_independent_owner() -> Bool:
	original = TupleFieldAccessor(
		RootAccessor,
		1,
		NamedType("String", []),
	)
	cloned = clone_core_accessor(original)

	is_unique(original) and is_unique(cloned)


tests: TestSuite = {
	description = "Blorp compiler Core cloning",
	tests = [
		("clones recursive Core type", test_clones_recursive_core_type),
		("clones Core variable", test_clones_core_var),
		("clones managed literal", test_clones_managed_literal),
		("clones known source location", test_clones_known_source_location),
		("clones recursive Core accessor", test_clones_recursive_core_accessor),
		(
			"recursive accessor clone has independent owner",
			test_recursive_accessor_clone_has_independent_owner,
		),
		(
			"tuple accessor clone has independent owner",
			test_tuple_accessor_clone_has_independent_owner,
		),
	]
}
