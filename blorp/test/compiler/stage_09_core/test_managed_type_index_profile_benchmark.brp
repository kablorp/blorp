import:
	../../../benchmark/compiler/compiler_managed_type_index_profile_fixture:
		compiler_managed_type_index_profile_benchmark,
		compiler_managed_type_index_profile_fixture,
	test: TestSuite


pure func test_managed_type_index_profile_counts_deterministic_work() -> Bool:
	result = compiler_managed_type_index_profile_benchmark({
		managed_count = 4,
		queries_per_name = 2,
		hit_ratio_percent = 50,
		nesting_depth = 4,
	})

	(
		result.hit_count == 2
		and result.query_type_count == 20
		and result.query_count == 40
		and result.expected_successful_classifications == 20
		and result.legacy_successful_classifications == 20
		and result.indexed_successful_classifications == 20
		and result.legacy_checksum == result.indexed_checksum
		and result.workload_valid
	)


pure func test_managed_type_index_profile_scales_queries_per_name() -> Bool:
	result = compiler_managed_type_index_profile_benchmark({
		managed_count = 3,
		queries_per_name = 5,
		hit_ratio_percent = 0,
		nesting_depth = 1,
	})

	(
		result.hit_count == 0
		and result.query_type_count == 15
		and result.query_count == 75
		and result.expected_successful_classifications == 15
		and result.legacy_successful_classifications == 15
		and result.indexed_successful_classifications == 15
		and result.legacy_checksum == result.indexed_checksum
		and result.workload_valid
	)


pure func test_managed_type_index_profile_normalizes_invalid_config() -> Bool:
	fixture = compiler_managed_type_index_profile_fixture({
		managed_count = 0,
		queries_per_name = 0,
		hit_ratio_percent = 120,
		nesting_depth = 0,
	})

	(
		fixture.config.managed_count == 1
		and fixture.config.queries_per_name == 1
		and fixture.config.hit_ratio_percent == 100
		and fixture.config.nesting_depth == 1
		and fixture.hit_count == 1
		and fixture.query_type_count == 5
		and fixture.query_count == 5
		and fixture.expected_successful_classifications == 4
	)


tests: TestSuite = {
	description = "Compiler managed type index profile benchmark",
	tests = [
		(
			"managed type index profile counts deterministic work",
			test_managed_type_index_profile_counts_deterministic_work,
		),
		(
			"managed type index profile scales queries per name",
			test_managed_type_index_profile_scales_queries_per_name,
		),
		(
			"managed type index profile normalizes invalid config",
			test_managed_type_index_profile_normalizes_invalid_config,
		),
	]
}
