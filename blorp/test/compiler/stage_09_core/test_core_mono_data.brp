import:
	../../../src/compiler/stage_05_types/language_surface_manifest:
		DeclaredAbiType(DeclaredAbiOption, DeclaredAbiResult),
	../../../src/compiler/stage_09_core/ir:
		CoreCallKind(SelectedDirectCall, UnknownCall),
		CoreDecl(FunctionDecl, HeapRecordDecl, ImplDecl, TypeAliasDecl, UnionDecl, ValueRecordDecl),
		CoreExpr(CallExpr, FieldExpr, LiteralExpr, SeqExpr, VarExpr, VoidExpr),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreLiteral(IntLiteral),
		CoreParam,
		CoreProgram,
		CoreReleasePolicy(ArcReleaseOnlyPolicy, NoReleasePolicy),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(FunctionType, NamedType, TypeParameterType, VoidType),
		CoreUnionPayloadStorage(ErasedUnionPayloadStorage, TypedUnionPayloadStorage),
		CoreVar,
		core_program_to_json,
	../../../src/compiler/stage_09_core/mono: mangle_generic_data_name
	../../../src/compiler/stage_09_core/mono_data:
		CoreMonoDataSpecialization,
		specialize_generic_data,
	../../../src/compiler/stage_09_core/monomorphize: specialize_generic_functions_and_data
	test: TestSuite


pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


pure func type_parameter(name: String) -> CoreType:
	TypeParameterType(name)


pure func applied_type(name: String, args: List[CoreType]) -> CoreType:
	NamedType(name, args)


pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), named_type("Int"), SyntheticSourceLoc)


pure func named_param(param: (String, CoreType)) -> CoreParam:
	match param:
		(name, typ):
			{
				name = named_var(name),
				typ = typ,
				loc = SyntheticSourceLoc
			}


pure func function_decl(
	name: String,
	def_id: Int,
	type_params: List[String],
	params: List[(String, CoreType)],
	return_type: CoreType,
	body: CoreExpr,
) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = None,
		type_params = type_params,
		params = params.map(named_param),
		return_type = return_type,
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func value_record_template(name: String, field_type: CoreType) -> CoreDecl:
	ValueRecordDecl({
		abi_type = None,
		name = name,
		type_params = ["T"],
		fields = [
			{
				name = "value",
				typ = field_type
			},
		],
		loc = SyntheticSourceLoc,
	})


pure func heap_record_template(name: String, field_type: CoreType) -> CoreDecl:
	HeapRecordDecl({
		abi_type = None,
		name = name,
		type_params = ["T"],
		fields = [
			{
				name = "value",
				typ = field_type,
				release_policy = NoReleasePolicy
			},
		],
		loc = SyntheticSourceLoc,
	})


pure func union_template(name: String, abi_type: Option[DeclaredAbiType]) -> CoreDecl:
	UnionDecl({
		abi_type = abi_type,
		name = name,
		type_params = ["T"],
		payload_storage = ErasedUnionPayloadStorage,
		variants = [
			{
				name = "Picked",
				c_name = "__def_10_Picked",
				tag_c_name = "TAG_${name}_Picked",
				tag = 0,
				fields = [
					{
						typ = type_parameter("T"),
						release_policy = NoReleasePolicy
					},
				],
				def_id = Some(10)
			},
			{
				name = "Empty",
				c_name = "__def_11_Empty",
				tag_c_name = "TAG_${name}_Empty",
				tag = 1,
				fields = [],
				def_id = Some(11)
			},
		],
		loc = SyntheticSourceLoc,
	})


pure func result_union_template() -> CoreDecl:
	UnionDecl({
		abi_type = Some(DeclaredAbiResult),
		name = "Result",
		type_params = ["T", "E"],
		payload_storage = ErasedUnionPayloadStorage,
		variants = [
			{
				name = "Ok",
				c_name = "__def_12_Ok",
				tag_c_name = "TAG_Result_Ok",
				tag = 0,
				fields = [
					{
						typ = type_parameter("T"),
						release_policy = NoReleasePolicy
					},
				],
				def_id = Some(12)
			},
			{
				name = "Err",
				c_name = "__def_13_Err",
				tag_c_name = "TAG_Result_Err",
				tag = 1,
				fields = [
					{
						typ = type_parameter("E"),
						release_policy = NoReleasePolicy
					},
				],
				def_id = Some(13)
			},
		],
		loc = SyntheticSourceLoc,
	})


pure func alias_decl(name: String, target: CoreType) -> CoreDecl:
	TypeAliasDecl({
		abi_type = None,
		name = name,
		type_params = ["T"],
		target = target,
		is_opaque = False,
		loc = SyntheticSourceLoc,
	})


pure func program(decls: List[CoreDecl]) -> CoreProgram:
	{
		decls = decls,
		foreign_includes = []
	}


pure func programs_equal(left: CoreProgram, right: CoreProgram) -> Bool:
	core_program_to_json(left).to_string() == core_program_to_json(right).to_string()


pure func concrete_value_record(name: String, field_type: CoreType) -> CoreDecl:
	ValueRecordDecl({
		abi_type = None,
		name = name,
		type_params = [],
		fields = [
			{
				name = "value",
				typ = field_type
			},
		],
		loc = SyntheticSourceLoc,
	})


pure func concrete_heap_record(name: String, field_type: CoreType) -> CoreDecl:
	HeapRecordDecl({
		abi_type = None,
		name = name,
		type_params = [],
		fields = [
			{
				name = "value",
				typ = field_type,
				release_policy = ArcReleaseOnlyPolicy
			},
		],
		loc = SyntheticSourceLoc,
	})


pure func concrete_union(
	concrete_name: String,
	payload_storage: CoreUnionPayloadStorage,
) -> CoreDecl:
	UnionDecl({
		abi_type = None,
		name = concrete_name,
		type_params = [],
		payload_storage = payload_storage,
		variants = [
			{
				name = "Picked",
				c_name = "__def_100_Picked",
				tag_c_name = "TAG_${concrete_name}_Picked",
				tag = 0,
				fields = [
					{
						typ = named_type("String"),
						release_policy = ArcReleaseOnlyPolicy
					},
				],
				def_id = Some(100)
			},
			{
				name = "Empty",
				c_name = "__def_101_Empty",
				tag_c_name = "TAG_${concrete_name}_Empty",
				tag = 1,
				fields = [],
				def_id = Some(101)
			},
		],
		loc = SyntheticSourceLoc,
	})


pure func pass_function(name: String, def_id: Int, typ: CoreType) -> CoreDecl:
	function_decl(
		name,
		def_id,
		[],
		[("value", typ)],
		typ,
		VarExpr(named_var("value"), typ, SyntheticSourceLoc),
	)


pure func function_type(param_type: CoreType, return_type: CoreType) -> CoreType:
	FunctionType(True, [param_type], return_type)


pure func direct_call(
	target_name: String,
	target_def_id: Option[Int],
	call_kind: CoreCallKind,
	param_type: CoreType,
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(
		call_kind,
		VarExpr(
			{
				name = target_name,
				uniq = 0,
				def_id = target_def_id
			},
			function_type(
				param_type,
				return_type,
			),
			SyntheticSourceLoc,
		),
		[VarExpr(named_var("argument"), param_type, SyntheticSourceLoc)],
		return_type,
		SyntheticSourceLoc,
	)


func test_mangles_generic_data_name_in_argument_order() -> Bool:
	mangle_generic_data_name(
		"pkg/value::Pair",
		[named_type("String"), named_type("Int")],
	) == Some("pkg_value__Pair__mono_String_Int")


func test_generic_data_names_are_structurally_injective() -> Bool:
	left: Option[String] = mangle_generic_data_name(
		"Pair",
		[named_type("A_B"), named_type("C")],
	)
	right: Option[String] = mangle_generic_data_name(
		"Pair",
		[named_type("A"), named_type("B_C")],
	)
	nested: Option[String] = mangle_generic_data_name("Box", [applied_type("A", [named_type("B")])])
	flat: Option[String] = mangle_generic_data_name("Box", [named_type("A_B")])

	left != right and nested != flat


func test_materializes_value_record_and_rewrites_function_types() -> Bool:
	box_int: CoreType = applied_type("Box", [named_type("Int")])
	input: CoreProgram = program([
		value_record_template("Box", type_parameter("T")),
		function_decl(
			"read",
			20,
			[],
			[("box", box_int)],
			named_type("Int"),
			FieldExpr(
				VarExpr(named_var("box"), box_int, SyntheticSourceLoc),
				"value",
				named_type("Int"),
				SyntheticSourceLoc,
			),
		),
	])
	result: CoreMonoDataSpecialization = specialize_generic_data(input, 100)
	concrete_type: CoreType = named_type("Box__mono_Int")
	expected: CoreProgram = program([
		value_record_template("Box", type_parameter("T")),
		function_decl(
			"read",
			20,
			[],
			[("box", concrete_type)],
			named_type("Int"),
			FieldExpr(
				VarExpr(named_var("box"), concrete_type, SyntheticSourceLoc),
				"value",
				named_type("Int"),
				SyntheticSourceLoc,
			),
		),
		concrete_value_record("Box__mono_Int", named_type("Int")),
	])

	result.next_def_id == 100 and programs_equal(result.program, expected)


func test_materializes_heap_record_with_concrete_release_policy() -> Bool:
	box_string: CoreType = applied_type("Box", [named_type("String")])
	result: CoreMonoDataSpecialization = specialize_generic_data(program([
			heap_record_template("Box", type_parameter("T")),
			pass_function("pass_box", 20, box_string),
		]), 100)
	concrete_type: CoreType = named_type("Box__mono_String")
	expected: CoreProgram = program([
		heap_record_template("Box", type_parameter("T")),
		pass_function("pass_box", 20, concrete_type),
		concrete_heap_record("Box__mono_String", named_type("String")),
	])

	result.next_def_id == 100 and programs_equal(result.program, expected)


func test_materializes_typed_union_with_fresh_variant_identities() -> Bool:
	choice_string: CoreType = applied_type("Choice", [named_type("String")])
	result: CoreMonoDataSpecialization = specialize_generic_data(program([
			union_template("Choice", None),
			pass_function("pass_choice", 20, choice_string),
		]), 100)
	concrete_type: CoreType = named_type("Choice__mono_String")
	expected: CoreProgram = program([
		union_template("Choice", None),
		pass_function("pass_choice", 20, concrete_type),
		concrete_union("Choice__mono_String", TypedUnionPayloadStorage),
	])

	result.next_def_id == 102 and programs_equal(result.program, expected)


func test_runtime_bridge_union_keeps_erased_payload_storage() -> Bool:
	attempt_string: CoreType = applied_type("std_channel__RecvAttempt", [named_type("String")])
	result: CoreMonoDataSpecialization = specialize_generic_data(program([
			union_template("std_channel__RecvAttempt", None),
			pass_function("pass_attempt", 20, attempt_string),
		]), 100)
	concrete_name: String = "std_channel__RecvAttempt__mono_String"
	concrete_type: CoreType = named_type(concrete_name)
	expected: CoreProgram = program([
		union_template("std_channel__RecvAttempt", None),
		pass_function("pass_attempt", 20, concrete_type),
		concrete_union(concrete_name, ErasedUnionPayloadStorage),
	])

	result.next_def_id == 102 and programs_equal(result.program, expected)


func test_does_not_materialize_global_abi_unions() -> Bool:
	option_int: CoreType = applied_type("Option", [named_type("Int")])
	result_string_int: CoreType = applied_type(
		"Result",
		[named_type("String"), named_type("Int")],
	)
	input: CoreProgram = program([
		union_template("Option", Some(DeclaredAbiOption)),
		result_union_template(),
		pass_function("pass_option", 20, option_int),
		pass_function("pass_result", 21, result_string_int),
	])
	result: CoreMonoDataSpecialization = specialize_generic_data(input, 100)

	result.next_def_id == 100 and programs_equal(result.program, input)


func test_materializes_nested_data_once() -> Bool:
	outer_string: CoreType = applied_type("Outer", [named_type("String")])
	result: CoreMonoDataSpecialization = specialize_generic_data(program([
			value_record_template("Inner", type_parameter("T")),
			value_record_template(
				"Outer",
				applied_type("Inner", [type_parameter("T")]),
			),
			pass_function("first", 20, outer_string),
			pass_function("second", 21, outer_string),
		]), 100)
	concrete_outer: CoreType = named_type("Outer__mono_String")
	expected: CoreProgram = program([
		value_record_template("Inner", type_parameter("T")),
		value_record_template(
			"Outer",
			applied_type("Inner", [type_parameter("T")]),
		),
		pass_function("first", 20, concrete_outer),
		pass_function("second", 21, concrete_outer),
		concrete_value_record("Inner__mono_String", named_type("String")),
		concrete_value_record("Outer__mono_String", named_type("Inner__mono_String")),
	])

	result.next_def_id == 100 and programs_equal(result.program, expected)


func test_nested_heap_record_has_managed_release_policy() -> Bool:
	holder_string: CoreType = applied_type("Holder", [named_type("String")])
	result: CoreMonoDataSpecialization = specialize_generic_data(program([
			heap_record_template("Box", type_parameter("T")),
			heap_record_template(
				"Holder",
				applied_type("Box", [type_parameter("T")]),
			),
			pass_function("pass_holder", 20, holder_string),
		]), 100)
	concrete_holder: CoreType = named_type("Holder__mono_String")
	expected: CoreProgram = program([
		heap_record_template("Box", type_parameter("T")),
		heap_record_template(
			"Holder",
			applied_type("Box", [type_parameter("T")]),
		),
		pass_function("pass_holder", 20, concrete_holder),
		concrete_heap_record("Box__mono_String", named_type("String")),
		HeapRecordDecl({
			abi_type = None,
			name = "Holder__mono_String",
			type_params = [],
			fields = [
				{
					name = "value",
					typ = named_type("Box__mono_String"),
					release_policy = ArcReleasePolicy
				},
			],
			loc = SyntheticSourceLoc,
		}),
	])

	result.next_def_id == 100 and programs_equal(result.program, expected)


func test_generic_alias_exposes_data_specialization() -> Bool:
	box_t: CoreType = applied_type("Box", [type_parameter("T")])
	alias_string: CoreType = applied_type("Alias", [named_type("String")])
	result: CoreMonoDataSpecialization = specialize_generic_data(program([
			value_record_template("Box", type_parameter("T")),
			alias_decl("Alias", box_t),
			pass_function("pass_alias", 20, alias_string),
		]), 100)
	concrete_box: CoreType = named_type("Box__mono_String")
	expected: CoreProgram = program([
		value_record_template("Box", type_parameter("T")),
		alias_decl("Alias", box_t),
		pass_function("pass_alias", 20, concrete_box),
		concrete_value_record("Box__mono_String", named_type("String")),
	])

	result.next_def_id == 100 and programs_equal(result.program, expected)


func test_materializes_two_concrete_record_instances() -> Bool:
	box_int: CoreType = applied_type("Box", [named_type("Int")])
	box_string: CoreType = applied_type("Box", [named_type("String")])
	result: CoreMonoDataSpecialization = specialize_generic_data(program([
			value_record_template("Box", type_parameter("T")),
			pass_function("pass_int", 20, box_int),
			pass_function("pass_string", 21, box_string),
		]), 100)
	expected: CoreProgram = program([
		value_record_template("Box", type_parameter("T")),
		pass_function("pass_int", 20, named_type("Box__mono_Int")),
		pass_function("pass_string", 21, named_type("Box__mono_String")),
		concrete_value_record("Box__mono_Int", named_type("Int")),
		concrete_value_record("Box__mono_String", named_type("String")),
	])

	result.next_def_id == 100 and programs_equal(result.program, expected)


func test_expression_result_type_roots_local_specialization() -> Bool:
	box_string: CoreType = applied_type("Box", [named_type("String")])
	main: CoreDecl = function_decl(
		"main",
		20,
		[],
		[],
		named_type("Int"),
		SeqExpr(
			VoidExpr(box_string, SyntheticSourceLoc),
			int_literal(0),
		),
	)
	result: CoreMonoDataSpecialization = specialize_generic_data(
		program([value_record_template("Box", type_parameter("T")), main]),
		100,
	)
	concrete_type: CoreType = named_type("Box__mono_String")
	expected_main: CoreDecl = function_decl(
		"main",
		20,
		[],
		[],
		named_type("Int"),
		SeqExpr(
			VoidExpr(concrete_type, SyntheticSourceLoc),
			int_literal(0),
		),
	)
	expected: CoreProgram = program([
		value_record_template("Box", type_parameter("T")),
		expected_main,
		concrete_value_record("Box__mono_String", named_type("String")),
	])

	result.next_def_id == 100 and programs_equal(result.program, expected)


func test_recursive_data_specialization_terminates() -> Bool:
	node_t: CoreType = applied_type("Node", [type_parameter("T")])
	node_string: CoreType = applied_type("Node", [named_type("String")])
	result: CoreMonoDataSpecialization = specialize_generic_data(program([
			heap_record_template("Node", node_t),
			pass_function("pass_node", 20, node_string),
		]), 100)
	concrete_node: CoreType = named_type("Node__mono_String")
	expected: CoreProgram = program([
		heap_record_template("Node", node_t),
		pass_function("pass_node", 20, concrete_node),
		HeapRecordDecl({
			abi_type = None,
			name = "Node__mono_String",
			type_params = [],
			fields = [
				{
					name = "value",
					typ = concrete_node,
					release_policy = ArcReleasePolicy
				},
			],
			loc = SyntheticSourceLoc,
		}),
	])

	result.next_def_id == 100 and programs_equal(result.program, expected)


func test_unresolved_generic_scope_does_not_materialize_data() -> Bool:
	box_t: CoreType = applied_type("Box", [type_parameter("T")])
	generic: CoreDecl = function_decl(
		"keep",
		20,
		["T"],
		[("box", box_t)],
		box_t,
		VarExpr(named_var("box"), box_t, SyntheticSourceLoc),
	)
	result: CoreMonoDataSpecialization = specialize_generic_data(
		program([value_record_template("Box", type_parameter("T")), generic]),
		100,
	)

	result.next_def_id == 100 and result.program.decls.length() == 2


func test_unresolved_generic_impl_scope_does_not_materialize_data() -> Bool:
	box_t: CoreType = applied_type("Box", [type_parameter("T")])
	method_decl: CoreFunction = {
		name = "identity",
		source_module = None,
		type_params = ["T"],
		params = [named_param(("value", box_t))],
		return_type = box_t,
		body = Some(VarExpr(named_var("value"), box_t, SyntheticSourceLoc)),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 30,
		loc = SyntheticSourceLoc
	}
	input: CoreProgram = program([
		value_record_template("Box", type_parameter("T")),
		ImplDecl({
			trait_name = "Identity",
			for_type = box_t,
			type_params = [
				{
					name = "T",
					bounds = []
				},
			],
			methods = [method_decl],
			loc = SyntheticSourceLoc,
		}),
	])
	result: CoreMonoDataSpecialization = specialize_generic_data(input, 100)

	result.next_def_id == 100 and programs_equal(result.program, input)


func test_specializes_function_before_materializing_return_data() -> Bool:
	box_t: CoreType = applied_type("Box", [type_parameter("T")])
	box_string: CoreType = applied_type("Box", [named_type("String")])
	wrap: CoreDecl = function_decl(
		"wrap",
		10,
		["T"],
		[("value", type_parameter("T"))],
		box_t,
		VoidExpr(box_t, SyntheticSourceLoc),
	)
	main: CoreDecl = function_decl(
		"main",
		20,
		[],
		[],
		box_string,
		direct_call("wrap", Some(10), SelectedDirectCall(10), named_type("String"), box_string),
	)
	result: CoreMonoDataSpecialization = specialize_generic_functions_and_data(program([
			value_record_template("Box", type_parameter("T")),
			wrap,
			main,
		]), 100)
	concrete_box: CoreType = named_type("Box__mono_String")
	expected: CoreProgram = program([
		value_record_template("Box", type_parameter("T")),
		function_decl(
			"wrap",
			10,
			["T"],
			[("value", type_parameter("T"))],
			box_t,
			VoidExpr(box_t, SyntheticSourceLoc),
		),
		function_decl(
			"main",
			20,
			[],
			[],
			concrete_box,
			direct_call("wrap__mono_String", None, UnknownCall, named_type("String"), concrete_box),
		),
		function_decl(
			"wrap__mono_String",
			100,
			[],
			[("value", named_type("String"))],
			concrete_box,
			VoidExpr(concrete_box, SyntheticSourceLoc),
		),
		concrete_value_record("Box__mono_String", named_type("String")),
	])

	result.next_def_id == 101 and programs_equal(result.program, expected)


tests: TestSuite = {
	description = "Compiler Core generic data monomorphization",
	tests = [
		(
			"mangles generic data name in argument order",
			test_mangles_generic_data_name_in_argument_order,
		),
		(
			"generic data names are structurally injective",
			test_generic_data_names_are_structurally_injective,
		),
		(
			"materializes value record and rewrites function types",
			test_materializes_value_record_and_rewrites_function_types,
		),
		(
			"materializes heap record with concrete release policy",
			test_materializes_heap_record_with_concrete_release_policy,
		),
		(
			"materializes typed union with fresh variant identities",
			test_materializes_typed_union_with_fresh_variant_identities,
		),
		(
			"runtime bridge union keeps erased payload storage",
			test_runtime_bridge_union_keeps_erased_payload_storage,
		),
		("does not materialize global ABI unions", test_does_not_materialize_global_abi_unions),
		("materializes nested data once", test_materializes_nested_data_once),
		(
			"nested heap record has managed release policy",
			test_nested_heap_record_has_managed_release_policy,
		),
		(
			"generic alias exposes data specialization",
			test_generic_alias_exposes_data_specialization,
