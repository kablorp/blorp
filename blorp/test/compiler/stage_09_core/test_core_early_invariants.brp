import:
	../../../src/compiler/stage_09_core/early_invariants:
		CoreEarlyInvariantViolation(
			DebugBlockSurvived,
			MonoBoxSourceTypeUnresolved,
			MonoUnboxTargetTypeUnresolved,
			MonoUserCallArgumentTypeUnresolved,
			MonoUserCallReturnTypeUnresolved,
			MutableLocalWithoutAssignmentSurvived,
			StraightLineMutableAssignmentSurvived,
			StringOperatorSugarSurvived,
			SelectedDirectCallSurvived,
		),
		check_debug_invariants,
		check_desugar_invariants,
		check_mono_invariants,
		check_resolve_invariants,
		check_synth_invariants,
		core_early_invariant_hint,
		core_early_invariant_message,
	../../../src/compiler/stage_09_core/early_stages: run_debug_stage, run_desugar_stage
	../../../src/compiler/stage_09_core/ir:
		CoreBinaryOp(AddOp, EqualOp),
		CoreBoxKind(PrimBox),
		CoreCallKind(SelectedDirectCall, UserCall),
		CoreDecl(FunctionDecl, GlobalDecl, ImplDecl),
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			BoxExpr,
			CallExpr,
			DebugBlockExpr,
			LetExpr,
			SeqExpr,
			UnboxExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreProgram,
		CoreSourceLoc,
		synthetic_core_source_loc,
		CoreTensorDim(TensorRuntimeDim, TensorVariadicDim),
		CoreType(FunctionType, NamedType, SelfType, TensorType, TypeParameterType, VoidType),
		CoreTypeParam,
		CoreUnboxKind(PrimUnbox),
		CoreVar,
	test: TestSuite


pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


pure func type_parameter(name: String) -> CoreType:
	TypeParameterType(name)


pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = None
	}


pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(named_var(name), typ, synthetic_core_source_loc())


pure func function_info(
	name: String,
	def_id: Int,
	body: CoreExpr,
	return_type: CoreType,
	type_params: List[String],
) -> CoreFunction:
	{
		name = name,
		source_module = None,
		type_params = type_params,
		params = [],
		return_type = return_type,
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = synthetic_core_source_loc()
	}


pure func function_decl(
	name: String,
	def_id: Int,
	body: CoreExpr,
	return_type: CoreType,
	type_params: List[String],
) -> CoreDecl:
	FunctionDecl(function_info(name, def_id, body, return_type, type_params))


pure func unresolved_call(name: String, def_id: Int, typ: CoreType) -> CoreExpr:
	CallExpr(
		UserCall(name, Some(def_id), []),
		variable(
			name,
			FunctionType(True, [typ], typ),
		),
		[variable("value", typ)],
		typ,
		synthetic_core_source_loc(),
	)


pure func string_equality_expr() -> CoreExpr:
	string_type: CoreType = named_type("String")
	BinaryExpr(
		EqualOp,
		variable("left", string_type),
		variable("right", string_type),
		named_type("Bool"),
		synthetic_core_source_loc(),
	)


pure func debug_expr() -> CoreExpr:
	DebugBlockExpr(
		VoidExpr(VoidType, synthetic_core_source_loc()),
		VoidType,
		synthetic_core_source_loc(),
	)


pure func type_param(name: String) -> CoreTypeParam:
	{
		name = name,
		bounds = []
	}


pure func violation_kind(violation: CoreEarlyInvariantViolation) -> String:
	match violation:
		DebugBlockSurvived(_):
			"debug"
		StringOperatorSugarSurvived(op, _):
			"string:${op}"
		MutableLocalWithoutAssignmentSurvived(_):
			"mutable-no-assignment"
		StraightLineMutableAssignmentSurvived(_):
			"mutable-straight-line"
		MonoUserCallArgumentTypeUnresolved(name, _):
			"mono-argument:${name}"
		MonoUserCallReturnTypeUnresolved(name, _):
			"mono-return:${name}"
		MonoBoxSourceTypeUnresolved(_):
			"mono-box"
		MonoUnboxTargetTypeUnresolved(_):
			"mono-unbox"
		SelectedDirectCallSurvived(_, _):
			"selected-direct-call"
		_:
			"other"


pure func program(body: CoreExpr, return_type: CoreType) -> CoreProgram:
	program_with_type_params(body, return_type, [])


pure func program_with_type_params(
	body: CoreExpr,
	return_type: CoreType,
	type_params: List[String],
) -> CoreProgram:
	{
		decls = [function_decl("main", 10, body, return_type, type_params)],
		foreign_includes = [],
		source_files = []
	}


func test_debug_invariant_tracks_debug_lowering() -> Bool:
	source: CoreProgram = program(
		DebugBlockExpr(
			VoidExpr(VoidType, synthetic_core_source_loc()),
			VoidType,
			synthetic_core_source_loc(),
		),
		VoidType,
	)

	violations: List[CoreEarlyInvariantViolation] = check_debug_invariants(source)

	(
		violations.length() == 1
		and violations
			.get(0)
			.map(pure func(violation):
				match violation:
					DebugBlockSurvived(_):
						True
					_:
						False
			)
			.get_or(False)
		and check_synth_invariants(source).length() == 1
		and check_debug_invariants(run_debug_stage(source, False)).is_empty()
	)


func test_desugar_invariant_tracks_string_lowering() -> Bool:
	string_type: CoreType = named_type("String")
	source: CoreProgram = program(
		BinaryExpr(
			AddOp,
			variable("left", string_type),
			variable("right", string_type),
			string_type,
			synthetic_core_source_loc(),
		),
		string_type,
	)

	violations: List[CoreEarlyInvariantViolation] = check_desugar_invariants(source)

	(
		violations.length() == 1
		and violations
			.get(0)
			.map(pure func(violation):
				match violation:
					StringOperatorSugarSurvived("+", _):
						True
					_:
						False
			)
			.get_or(False)
		and check_synth_invariants(source).is_empty()
		and not check_resolve_invariants(source).is_empty()
		and check_desugar_invariants(run_desugar_stage(source)).is_empty()
	)


func test_desugar_invariant_tracks_unassigned_mutable_local() -> Bool:
	int_type: CoreType = named_type("Int")
	source: CoreProgram = program(
		LetExpr(
			named_var("value"),
			True,
			int_type,
			variable("initial", int_type),
			variable("value", int_type),
		),
		int_type,
	)

	violations: List[CoreEarlyInvariantViolation] = check_desugar_invariants(source)

	(
		violations.length() == 1
		and violations
			.get(0)
			.map(pure func(violation):
				match violation:
					MutableLocalWithoutAssignmentSurvived(_):
						True
					_:
						False
			)
			.get_or(False)
		and check_desugar_invariants(run_desugar_stage(source)).is_empty()
	)


func test_synth_invariant_accepts_late_mutable_state() -> Bool:
	int_type: CoreType = named_type("Int")
	source: CoreProgram = program(
		LetExpr(
			named_var("value"),
			True,
			int_type,
			variable("initial", int_type),
			variable("value", int_type),
		),
		int_type,
	)

	not check_desugar_invariants(source).is_empty() and check_synth_invariants(source).is_empty()


func test_desugar_invariant_tracks_straight_line_assignment() -> Bool:
	int_type: CoreType = named_type("Int")
	value: CoreVar = named_var("value")
	source: CoreProgram = program(
		LetExpr(
			value,
			True,
			int_type,
			variable("initial", int_type),
			SeqExpr(
				AssignExpr(
					value,
					variable("replacement", int_type),
					VoidType,
					synthetic_core_source_loc(),
				),
				VarExpr(value, int_type, synthetic_core_source_loc()),
			),
		),
		int_type,
	)
	violations: List[CoreEarlyInvariantViolation] = check_desugar_invariants(source)

	(
		violations.length() == 1
		and violations
			.get(0)
			.map(pure func(violation):
				match violation:
					StraightLineMutableAssignmentSurvived(_):
						True
					_:
						False
			)
			.get_or(False)
		and check_desugar_invariants(run_desugar_stage(source)).is_empty()
	)


func test_mono_invariant_rejects_unresolved_user_call_types() -> Bool:
	t: CoreType = type_parameter("T")
	call: CoreExpr = CallExpr(
		UserCall("identity", Some(20), []),
		variable(
			"identity",
			FunctionType(True, [t], t),
		),
		[variable("value", t)],
		t,
		synthetic_core_source_loc(),
	)
	violations: List[CoreEarlyInvariantViolation] = check_mono_invariants(program(call, t))

	violations.any(pure func(violation):
		match violation:
			MonoUserCallArgumentTypeUnresolved("identity", _):
				True
			_:
				False
	) and violations.any(pure func(violation):
		match violation:
			MonoUserCallReturnTypeUnresolved("identity", _):
				True
			_:
				False
	)


func test_mono_invariant_rejects_unresolved_self_call_types() -> Bool:
	call: CoreExpr = CallExpr(
		UserCall("clone_self", Some(20), []),
		variable(
			"clone_self",
			FunctionType(True, [SelfType], SelfType),
		),
		[variable("value", SelfType)],
		SelfType,
		synthetic_core_source_loc(),
	)
	violations: List[CoreEarlyInvariantViolation] = check_mono_invariants(program(call, SelfType))

	violations.any(pure func(violation):
		match violation:
			MonoUserCallArgumentTypeUnresolved("clone_self", _):
				True
			_:
				False
	) and violations.any(pure func(violation):
		match violation:
			MonoUserCallReturnTypeUnresolved("clone_self", _):
				True
			_:
				False
	)


