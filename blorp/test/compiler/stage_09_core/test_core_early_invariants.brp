func test_mono_invariant_accepts_runtime_tensor_shapes() -> Bool:
	runtime_tensor: CoreType = TensorType({
		element_type = named_type("Float"),
		dims = [TensorRuntimeDim("#_")],
	})
	variadic_tensor: CoreType = TensorType({
		element_type = named_type("Float"),
		dims = [TensorVariadicDim("#Ds")],
	})
	runtime_call: CoreExpr = CallExpr(
		UserCall("runtime_length", Some(20), []),
		variable(
			"runtime_length",
			FunctionType(True, [runtime_tensor], named_type("Int")),
		),
		[variable("runtime_values", runtime_tensor)],
		named_type("Int"),
		synthetic_core_source_loc(),
	)
	variadic_call: CoreExpr = CallExpr(
		UserCall("variadic_length", Some(21), []),
		variable(
			"variadic_length",
			FunctionType(True, [variadic_tensor], named_type("Int")),
		),
		[variable("variadic_values", variadic_tensor)],
		named_type("Int"),
		synthetic_core_source_loc(),
	)

	check_mono_invariants(
		program(
			SeqExpr(runtime_call, variadic_call),
			named_type("Int"),
		),
	).is_empty()


func test_mono_invariant_checks_global_and_concrete_impl_roots() -> Bool:
	t: CoreType = type_parameter("T")
	any_type: CoreType = named_type("Any")
	box: CoreExpr = BoxExpr(
		{
			kind = PrimBox,
			value = variable("value", t),
			source_type = t
		},
		any_type,
		synthetic_core_source_loc(),
	)
	method: CoreFunction = {
		name = "box_value",
		source_module = None,
		type_params = [],
		params = [],
		return_type = any_type,
		body = Some(box),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 20,
		loc = synthetic_core_source_loc()
	}
	source: CoreProgram = {
		decls = [GlobalDecl({
				name = named_var("boxed"),
				source_module = None,
				typ = any_type,
				init = box,
				is_mutable = False,
				is_const = False,
				is_private = False,
				def_id = 10,
				loc = synthetic_core_source_loc(),
			}), ImplDecl({
				trait_name = "Boxable",
				for_type = named_type("Int"),
				type_params = [],
				methods = [method],
				loc = synthetic_core_source_loc(),
			})],
		foreign_includes = [],
		source_files = []
	}
	violations: List[CoreEarlyInvariantViolation] = check_mono_invariants(source)

	violations
		.filter(pure func(violation):
			match violation:
				MonoBoxSourceTypeUnresolved(_):
					True
				_:
					False
		)
		.length() == 2


func test_resolve_invariant_preserves_family_priority_over_traversal_order() -> Bool:
	string_type: CoreType = named_type("String")
	int_type: CoreType = named_type("Int")
	string_add: CoreExpr = BinaryExpr(
		AddOp,
		variable("left", string_type),
		variable("right", string_type),
		string_type,
		synthetic_core_source_loc(),
	)
	direct_call: CoreExpr = CallExpr(
		SelectedDirectCall(20),
		variable(
			"callee",
			FunctionType(True, [], int_type),
		),
		[],
		int_type,
		synthetic_core_source_loc(),
	)

	source: CoreProgram = {
		decls = [
			function_decl("string_first", 10, string_add, string_type, []),
			function_decl("direct_second", 11, direct_call, int_type, []),
		],
		foreign_includes = [],
		source_files = []
	}

	check_resolve_invariants(source).map(violation_kind) == ["selected-direct-call", "string:+"]


func test_synth_invariant_preserves_family_priority_over_traversal_order() -> Bool:
	t: CoreType = type_parameter("T")

	check_synth_invariants(
		program(
			SeqExpr(
				string_equality_expr(),
				SeqExpr(
					unresolved_call("identity", 20, t),
					debug_expr(),
				),
			),
			VoidType,
		),
	).map(
		violation_kind,
	) == ["debug", "string:==", "mono-argument:identity", "mono-return:identity"]


func test_synth_invariant_keeps_mono_checks_out_of_generic_roots() -> Bool:
	t: CoreType = type_parameter("T")

	check_synth_invariants(
		program_with_type_params(
			SeqExpr(
				string_equality_expr(),
				SeqExpr(
					unresolved_call("identity", 20, t),
					debug_expr(),
				),
			),
			VoidType,
			["T"],
		),
	).map(violation_kind) == ["debug", "string:=="]


func test_synth_invariant_preserves_impl_root_eligibility() -> Bool:
	t: CoreType = type_parameter("T")
	any_type: CoreType = named_type("Any")
	source: CoreProgram = {
		decls = [ImplDecl({
				trait_name = "GenericTrait",
				for_type = any_type,
				type_params = [type_param("T")],
				methods = [function_info(
						"generic_method",
						20,
						unresolved_call("generic_identity", 20, t),
						t,
						[],
					)],
				loc = synthetic_core_source_loc(),
			}), ImplDecl({
				trait_name = "ConcreteTrait",
				for_type = any_type,
				type_params = [],
				methods = [function_info(
						"concrete_method",
						21,
						unresolved_call("concrete_identity", 21, t),
						t,
						[],
					)],
				loc = synthetic_core_source_loc(),
			})],
		foreign_includes = [],
		source_files = []
	}

	check_synth_invariants(
		source,
	).map(violation_kind) == ["mono-argument:concrete_identity", "mono-return:concrete_identity"]


func test_invariant_diagnostics_include_actionable_guidance() -> Bool:
	violation: CoreEarlyInvariantViolation = DebugBlockSurvived(synthetic_core_source_loc())

	(
		core_early_invariant_message(violation).contains("debug block")
		and core_early_invariant_hint(violation).is_some()
	)


tests: TestSuite = {
	description = "Blorp compiler early Core invariants",
	tests = [
		("debug invariant tracks debug lowering", test_debug_invariant_tracks_debug_lowering),
		("desugar invariant tracks string lowering", test_desugar_invariant_tracks_string_lowering),
		(
			"desugar invariant tracks unassigned mutable local",
			test_desugar_invariant_tracks_unassigned_mutable_local,
		),
		(
			"synth invariant accepts late mutable state",
			test_synth_invariant_accepts_late_mutable_state,
		),
		(
			"desugar invariant tracks straight-line assignment",
			test_desugar_invariant_tracks_straight_line_assignment,
		),
		(
			"mono invariant rejects unresolved user call types",
			test_mono_invariant_rejects_unresolved_user_call_types,
		),
		(
			"mono invariant rejects unresolved Self call types",
			test_mono_invariant_rejects_unresolved_self_call_types,
		),
		(
			"mono invariant rejects unresolved box source",
			test_mono_invariant_rejects_unresolved_box_source,
		),
		(
			"mono invariant rejects unresolved unbox target",
			test_mono_invariant_rejects_unresolved_unbox_target,
		),
		(
			"mono invariant accepts concrete user call",
			test_mono_invariant_accepts_concrete_user_call,
		),
		(
			"mono invariant accepts one-letter nominal type",
			test_mono_invariant_accepts_one_letter_nominal_type,
		),
		(
			"mono invariant accepts unresolved call in generic owner",
			test_mono_invariant_accepts_unresolved_call_in_generic_owner,
		),
		(
			"mono invariant accepts runtime tensor shapes",
			test_mono_invariant_accepts_runtime_tensor_shapes,
		),
		(
			"mono invariant checks global and concrete impl roots",
			test_mono_invariant_checks_global_and_concrete_impl_roots,
		),
		(
			"resolve invariant preserves family priority over traversal order",
			test_resolve_invariant_preserves_family_priority_over_traversal_order,
		),
		(
			"synth invariant preserves family priority over traversal order",
			test_synth_invariant_preserves_family_priority_over_traversal_order,
		),
		(
			"synth invariant keeps mono checks out of generic roots",
			test_synth_invariant_keeps_mono_checks_out_of_generic_roots,
		),
		(
			"synth invariant preserves impl root eligibility",
			test_synth_invariant_preserves_impl_root_eligibility,
		),
		(
			"invariant diagnostics include actionable guidance",
			test_invariant_diagnostics_include_actionable_guidance,
		),
	]
}
