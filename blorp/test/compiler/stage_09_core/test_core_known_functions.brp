import:
	../../../src/compiler/stage_02_lex/name_table:
		NameId,
		SYNTHESIZED_NAME_TABLE,
		name_ids_equal,
		synthesized_name_id,
	../../../src/compiler/stage_09_core/function_origin_fixture:
		fixture_declaration_index,
		FIXTURE_NO_SOURCE_MODULE,
		fixture_mono_instance_of,
		fixture_pure_variant_of,
		fixture_source_function_origin_named,
	../../../src/compiler/stage_09_core/ir:
		CoreDecl(FunctionDecl),
		CoreDeclarationIndex,
		CoreDeclaredOrigin(ImplMethod),
		CoreFunction,
		CoreFunctionKind(UnresolvedBuiltinFunction),
		CoreFunctionOrigin(Declared),
		CoreImplMethodRole(OrdinaryImplMethod),
		CoreKnownFunctions,
		CoreProgram,
		CoreType(VoidType),
		core_declared_member,
		core_declared_member_spelling,
		core_known_callee,
		core_known_functions,
		synthetic_core_source_loc,
	../../../src/compiler/stage_09_core/known_functions:
		CORE_KNOWN_FUNCTION_ROWS,
		CORE_KNOWN_IMPL_METHOD_ROWS,
		CoreKnownFunction(
			ListFilter,
			ListFilterMap,
			ListFoldLeft,
			ListLength,
			ListMap,
			ListRange,
			MatrixParallel,
			OptionGetOr,
			OptionGetOrElse,
			OptionIsNone,
			OptionIsSome,
			ParallelMatrixMap,
			ParallelMatrixMapIndexed,
			ParallelMatrixZipMap,
			ParallelVectorMap,
			ParallelVectorMapIndexed,
			ParallelVectorZipMap,
			StringDropLeft,
			StringDropRight,
			StringLength,
			StringReplace,
			StringReverse,
			StringSubstring,
			StringTakeLeft,
			StringTakeRight,
			StringTrim,
			StringTrimLeft,
			StringTrimRight,
			VectorAbs,
			VectorExp,
			VectorLog,
			VectorNorm,
			VectorParallel,
			VectorSqrt,
			FloatAbs,
			FloatExp,
			FloatLog,
			FloatSqrt,
		),
		CoreKnownFunctionRow,
		CoreKnownImplMethodRow,
		core_known_function,
		core_known_impl_method,
	list: range
	test: TestSuite


private pure func member(spelling: String) -> NameId:
	synthesized_name_id(spelling)


private pure func known(module_path: String, spelling: String) -> Option[CoreKnownFunction]:
	core_known_function(module_path, member(spelling))


pure func test_list_members_are_recognised_in_the_list_module() -> Bool:
	(
		known("list", "range") == Some(ListRange)
		and known("list", "filter") == Some(ListFilter)
		and known("list", "filter_map") == Some(ListFilterMap)
		and known("list", "map") == Some(ListMap)
		and known("list", "fold_left") == Some(ListFoldLeft)
		and known("list", "length") == Some(ListLength)
	)


pure func test_string_members_are_recognised_in_the_string_module() -> Bool:
	(
		known("string", "drop_left") == Some(StringDropLeft)
		and known("string", "drop_right") == Some(StringDropRight)
		and known("string", "replace") == Some(StringReplace)
		and known("string", "reverse") == Some(StringReverse)
		and known("string", "substring") == Some(StringSubstring)
		and known("string", "take_left") == Some(StringTakeLeft)
		and known("string", "take_right") == Some(StringTakeRight)
		and known("string", "trim") == Some(StringTrim)
		and known("string", "trim_left") == Some(StringTrimLeft)
		and known("string", "trim_right") == Some(StringTrimRight)
		and known("string", "length") == Some(StringLength)
	)


pure func test_parallel_members_are_recognised_in_their_own_modules() -> Bool:
	(
		known("vector", "parallel") == Some(VectorParallel)
		and known("matrix", "parallel") == Some(MatrixParallel)
		and known("parallel_vector", "map") == Some(ParallelVectorMap)
		and known("parallel_vector", "map_indexed") == Some(ParallelVectorMapIndexed)
		and known("parallel_vector", "zip_map") == Some(ParallelVectorZipMap)
		and known("parallel_matrix", "map") == Some(ParallelMatrixMap)
		and known("parallel_matrix", "map_indexed") == Some(ParallelMatrixMapIndexed)
		and known("parallel_matrix", "zip_map") == Some(ParallelMatrixZipMap)
	)


pure func test_option_members_are_recognised_in_the_option_module() -> Bool:
	(
		known("option", "is_some") == Some(OptionIsSome)
		and known("option", "is_none") == Some(OptionIsNone)
		and known("option", "get_or") == Some(OptionGetOr)
		and known("option", "get_or_else") == Some(OptionGetOrElse)
		and known("list", "get_or").is_none()
	)


-- `sqrt`, `exp`, `log` and `abs` exist in both `vector` and `float`; `norm` only in
-- `vector`. The module says which function a math call reaches.
pure func test_math_members_are_recognised_per_module() -> Bool:
	(
		known("vector", "norm") == Some(VectorNorm)
		and known("vector", "sqrt") == Some(VectorSqrt)
		and known("vector", "exp") == Some(VectorExp)
		and known("vector", "log") == Some(VectorLog)
		and known("vector", "abs") == Some(VectorAbs)
		and known("float", "sqrt") == Some(FloatSqrt)
		and known("float", "exp") == Some(FloatExp)
		and known("float", "log") == Some(FloatLog)
		and known("float", "abs") == Some(FloatAbs)
		and known("float", "norm").is_none()
	)


-- `map` and `length` are members of several modules; the module decides which
-- function is meant, and a module that does not declare the member matches nothing.
pure func test_a_member_spelling_alone_does_not_identify_a_function() -> Bool:
	(
		known("list", "map") != known("parallel_vector", "map")
		and known("list", "length") != known("string", "length")
		and known("vector", "map").is_none()
		and known("matrix", "map").is_none()
		and known("string", "map").is_none()
	)


pure func test_a_module_path_that_only_looks_like_a_known_module_matches_nothing() -> Bool:
	(
		known("./list", "map").is_none()
		and known("list/extras", "map").is_none()
		and known("app__list", "map").is_none()
		and known("", "map").is_none()
	)


pure func test_a_flattened_member_spelling_is_not_a_member() -> Bool:
	-- The seeded vocabulary has no `list__map`, so the lookup yields the unseeded
	-- sentinel, which no pinned member equals.
	known("list", "list__map").is_none() and known("list", "map__pure").is_none()


pure func test_has_length_is_the_length_method_of_the_list_and_string_modules() -> Bool:
	has_length: NameId = member("HasLength")
	length: NameId = member("length")

	(
		core_known_impl_method("list", has_length, length) == Some(ListLength)
		and core_known_impl_method("string", has_length, length) == Some(StringLength)
		and core_known_impl_method("dict", has_length, length).is_none()
		and core_known_impl_method("slice", has_length, length).is_none()
		and core_known_impl_method("list", member("Hashable"), length).is_none()
		and core_known_impl_method("list", has_length, member("hash")).is_none()
	)


private pure func fixture_function(
	module_path: String,
	member_spelling: String,
	def_id: Int,
) -> CoreFunction:
	{
		name = "flattened_name_that_no_reader_may_parse_${def_id.to_string()}",
		source_module = Some(module_path),
		module = FIXTURE_NO_SOURCE_MODULE,
		type_params = [],
		params = [],
		return_type = VoidType,
		body = None,
		is_pure = True,
		origin = fixture_source_function_origin_named(member_spelling),
		function_kind = UnresolvedBuiltinFunction,
		def_id = def_id,
		loc = synthetic_core_source_loc()
	}


private pure func program_of(functions: List[CoreFunction]) -> CoreProgram:
	{
		decls = functions.map(pure func(function_info): FunctionDecl(function_info)),
		foreign_includes = [],
		source_files = []
	}


private pure func index_of(functions: List[CoreFunction]) -> CoreDeclarationIndex:
	fixture_declaration_index(SYNTHESIZED_NAME_TABLE, program_of(functions))


private LIST_MAP_DEF: Int = 10

private LIST_MAP_INSTANCE_DEF: Int = 11

private LIST_MAP_PURE_DEF: Int = 12

private LIST_MAP_PURE_INSTANCE_DEF: Int = 13

private USER_MAP_DEF: Int = 20

private LIST_LENGTH_IMPL_DEF: Int = 30

private FLOAT_SQRT_DEF: Int = 40


pure func test_the_index_recognises_a_function_by_its_module_and_origin_not_its_name() -> Bool:
	list_map: CoreFunction = fixture_function("list", "map", LIST_MAP_DEF)
	user_map: CoreFunction = fixture_function("app/util", "map", USER_MAP_DEF)
	index: CoreDeclarationIndex = index_of([list_map, user_map])

	(
		core_known_callee(index, Some(LIST_MAP_DEF)) == Some(ListMap)
		and core_known_callee(index, Some(USER_MAP_DEF)).is_none()
		and core_known_callee(index, None).is_none()
		and core_known_callee(index, Some(999)).is_none()
	)


-- Mono instances and pure variants (and instances of variants) are recognised
-- through the declaration they copy, whatever they are named.
pure func test_the_index_recognises_copies_through_their_declaration() -> Bool:
	list_map: CoreFunction = fixture_function("list", "map", LIST_MAP_DEF)
	instance: CoreFunction = fixture_mono_instance_of(
		list_map,
		"instance_spelling",
		LIST_MAP_INSTANCE_DEF,
	)
	pure_variant: CoreFunction = fixture_pure_variant_of(
		list_map,
		"variant_spelling",
		LIST_MAP_PURE_DEF,
	)
	pure_instance: CoreFunction = fixture_mono_instance_of(
		pure_variant,
		"pure_instance_spelling",
		LIST_MAP_PURE_INSTANCE_DEF,
	)
	index: CoreDeclarationIndex = index_of([
		list_map,
		instance,
		pure_variant,
		pure_instance,
	])

	(
		core_known_callee(index, Some(LIST_MAP_INSTANCE_DEF)) == Some(ListMap)
		and core_known_callee(index, Some(LIST_MAP_PURE_DEF)) == Some(ListMap)
		and core_known_callee(index, Some(LIST_MAP_PURE_INSTANCE_DEF)) == Some(ListMap)
		and core_declared_member_spelling(index, instance) == Some("map")
		and core_declared_member_spelling(index, pure_instance) == Some("map")
	)


-- A copy whose declaration is not in the program is not guessed from its name.
pure func test_a_copy_without_its_declaration_has_no_member() -> Bool:
	list_map: CoreFunction = fixture_function("list", "map", LIST_MAP_DEF)
	orphan: CoreFunction = fixture_mono_instance_of(list_map, "list__map", LIST_MAP_INSTANCE_DEF)
	index: CoreDeclarationIndex = index_of([orphan])

	(
		core_declared_member(index, orphan).is_none()
		and core_known_callee(index, Some(LIST_MAP_INSTANCE_DEF)).is_none()
	)


pure func test_the_index_recognises_the_has_length_method_of_a_module() -> Bool:
	length_method: CoreFunction = { fixture_function("list", "length", LIST_LENGTH_IMPL_DEF) |
		origin = Declared(
			ImplMethod(
				synthesized_name_id("HasLength"),
				synthesized_name_id("length"),
				OrdinaryImplMethod,
			),
		)
	}
	index: CoreDeclarationIndex = index_of([length_method])

	(
		core_known_callee(index, Some(LIST_LENGTH_IMPL_DEF)) == Some(ListLength)
		and core_declared_member_spelling(index, length_method) == Some("length")
	)


-- An exhaustive match with no wildcard: adding a `CoreKnownFunction` variant is a
-- compile error here until it is given the next ordinal, and
-- `test_every_known_function_variant_has_exactly_one_row` then fails until it is
-- listed in `ALL_KNOWN_FUNCTIONS`.
private pure func known_function_ordinal(known: CoreKnownFunction) -> Int:
	match known:
		ListRange:
			0
		ListFilter:
			1
		ListFilterMap:
			2
		ListMap:
			3
		ListFoldLeft:
			4
		ListLength:
			5
		StringDropLeft:
			6
		StringDropRight:
			7
		StringReplace:
			8
		StringReverse:
			9
		StringSubstring:
			10
		StringTakeLeft:
			11
		StringTakeRight:
			12
		StringTrim:
			13
		StringTrimLeft:
			14
		StringTrimRight:
			15
		StringLength:
			16
		VectorParallel:
			17
		ParallelVectorMap:
			18
		ParallelVectorMapIndexed:
			19
		ParallelVectorZipMap:
			20
		MatrixParallel:
			21
		ParallelMatrixMap:
			22
		ParallelMatrixMapIndexed:
			23
		ParallelMatrixZipMap:
			24
		OptionIsSome:
			25
		OptionIsNone:
			26
		OptionGetOr:
			27
		OptionGetOrElse:
			28
		VectorNorm:
			29
		VectorSqrt:
			30
		VectorExp:
			31
		VectorLog:
			32
		VectorAbs:
			33
		FloatSqrt:
			34
		FloatExp:
			35
		FloatLog:
			36
		FloatAbs:
			37


private KNOWN_FUNCTION_VARIANT_COUNT: Int = 38

private ALL_KNOWN_FUNCTIONS: List[CoreKnownFunction] = [
	ListRange,
	ListFilter,
	ListFilterMap,
	ListMap,
	ListFoldLeft,
	ListLength,
	StringDropLeft,
	StringDropRight,
	StringReplace,
	StringReverse,
	StringSubstring,
	StringTakeLeft,
	StringTakeRight,
	StringTrim,
	StringTrimLeft,
	StringTrimRight,
	StringLength,
	VectorParallel,
	ParallelVectorMap,
	ParallelVectorMapIndexed,
	ParallelVectorZipMap,
	MatrixParallel,
	ParallelMatrixMap,
	ParallelMatrixMapIndexed,
	ParallelMatrixZipMap,
	OptionIsSome,
	OptionIsNone,
	OptionGetOr,
	OptionGetOrElse,
	VectorNorm,
	VectorSqrt,
	VectorExp,
	VectorLog,
	VectorAbs,
	FloatSqrt,
	FloatExp,
	FloatLog,
	FloatAbs,
]


private pure func rows_naming(known: CoreKnownFunction) -> Int:
	CORE_KNOWN_FUNCTION_ROWS.count(func(row): row.known == known)


pure func test_every_known_function_variant_has_exactly_one_row() -> Bool:
	listed_ordinals: List[Int] = ALL_KNOWN_FUNCTIONS.map(known_function_ordinal)
	ordinals_are_dense: Bool = range(
		0,
		KNOWN_FUNCTION_VARIANT_COUNT,
	).all(
		func(ordinal): listed_ordinals.count(func(listed): listed == ordinal) == 1,
	)

	(
		ALL_KNOWN_FUNCTIONS.length() == KNOWN_FUNCTION_VARIANT_COUNT
		and ordinals_are_dense
		and ALL_KNOWN_FUNCTIONS.all(func(known): rows_naming(known) == 1)
		and CORE_KNOWN_FUNCTION_ROWS.length() == KNOWN_FUNCTION_VARIANT_COUNT
	)


-- An impl-method row names a function the free-function table also knows, so the
-- two tables cannot drift apart on what `ListLength` is.
pure func test_every_impl_method_row_names_a_known_function() -> Bool:
	CORE_KNOWN_IMPL_METHOD_ROWS.all(func(row): rows_naming(row.known) == 1)


pure func test_every_row_round_trips_through_the_lookup() -> Bool:
	CORE_KNOWN_FUNCTION_ROWS.all(
		func(row): core_known_function(row.module_path, row.member) == Some(row.known),
	)


-- The fused tensor_specialize/specialize walk has no pass state, so it builds its
-- known functions from the late program alone (`core_known_functions({}, program)`).
-- That must be the index's answer restricted to the functions that are their own
-- declaration: same variant for each, and none for a mono instance or pure variant
-- (which the index alone recognises through the declaration it copies).
pure func test_the_late_program_known_functions_agree_with_the_published_index() -> Bool:
	list_map: CoreFunction = fixture_function("list", "map", LIST_MAP_DEF)
	float_sqrt: CoreFunction = fixture_function("float", "sqrt", FLOAT_SQRT_DEF)
	user_map: CoreFunction = fixture_function("app/util", "map", USER_MAP_DEF)
	instance: CoreFunction = fixture_mono_instance_of(list_map, "instance", LIST_MAP_INSTANCE_DEF)
	program: CoreProgram = program_of([
		list_map,
		float_sqrt,
		user_map,
		instance,
	])
	index: CoreDeclarationIndex = fixture_declaration_index(SYNTHESIZED_NAME_TABLE, program)
	late: CoreKnownFunctions = core_known_functions({}, program)

	(
		late.get(LIST_MAP_DEF) == Some(ListMap)
		and late.get(FLOAT_SQRT_DEF) == Some(FloatSqrt)
		and late.get(LIST_MAP_DEF) == index.known_functions.get(LIST_MAP_DEF)
		and late.get(FLOAT_SQRT_DEF) == index.known_functions.get(FLOAT_SQRT_DEF)
		and late
			.get(USER_MAP_DEF)
			.is_none()
		and late
			.get(LIST_MAP_INSTANCE_DEF)
			.is_none()
		and index.known_functions.get(LIST_MAP_INSTANCE_DEF) == Some(ListMap)
		and late.length() == 2
	)


private pure func function_row_pair_count(row: CoreKnownFunctionRow) -> Int:
	CORE_KNOWN_FUNCTION_ROWS.count(func(other):
		name_ids_equal(other.member, row.member) and other.module_path == row.module_path
	)


private pure func impl_row_triple_count(row: CoreKnownImplMethodRow) -> Int:
	CORE_KNOWN_IMPL_METHOD_ROWS.count(func(other):
		(
			name_ids_equal(other.trait_name, row.trait_name)
			and name_ids_equal(other.method, row.method)
			and other.module_path == row.module_path
		)
	)


-- `core_known_function` returns the first matching row, so a duplicated key would
-- silently shadow the later row.
pure func test_row_keys_are_unique() -> Bool:
	(
		CORE_KNOWN_FUNCTION_ROWS.all(func(row): function_row_pair_count(row) == 1)
		and CORE_KNOWN_IMPL_METHOD_ROWS.all(func(row): impl_row_triple_count(row) == 1)
	)


tests: TestSuite = {
	description = "Core known functions",
	tests = [
		("list members", test_list_members_are_recognised_in_the_list_module),
		("string members", test_string_members_are_recognised_in_the_string_module),
		("parallel members", test_parallel_members_are_recognised_in_their_own_modules),
		("option members", test_option_members_are_recognised_in_the_option_module),
		("math members", test_math_members_are_recognised_per_module),
		("module decides", test_a_member_spelling_alone_does_not_identify_a_function),
		(
			"module path spelling matters",
			test_a_module_path_that_only_looks_like_a_known_module_matches_nothing,
		),
		("flattened spelling is not a member", test_a_flattened_member_spelling_is_not_a_member),
		("HasLength length", test_has_length_is_the_length_method_of_the_list_and_string_modules),
		(
			"index by module and origin",
			test_the_index_recognises_a_function_by_its_module_and_origin_not_its_name,
		),
		(
			"index reads copies through declarations",
			test_the_index_recognises_copies_through_their_declaration,
		),
		("orphan copy has no member", test_a_copy_without_its_declaration_has_no_member),
		("index HasLength method", test_the_index_recognises_the_has_length_method_of_a_module),
		(
			"late program agrees with index",
			test_the_late_program_known_functions_agree_with_the_published_index,
		),
		("one row per variant", test_every_known_function_variant_has_exactly_one_row),
		("impl rows are known", test_every_impl_method_row_names_a_known_function),
		("row keys are unique", test_row_keys_are_unique),
		("rows round trip", test_every_row_round_trips_through_the_lookup),
	]
}
