import:
	../../../benchmark/compiler/compiler_definition_index_profile_fixture:
		CompilerDefinitionIndexBenchmarkConfig,
		compiler_definition_index_benchmark,
	test: TestSuite


pure func test_definition_index_benchmark_is_valid_and_checksummed() -> Bool:
	config: CompilerDefinitionIndexBenchmarkConfig = {
		iterations = 2,
		module_count = 2,
		functions_per_module = 3,
		source_query_count = 0,
		source_name_query_count = 0,
		source_query_same_name_matches = 0,
		owner_type_query_count = 0
	}
	result = compiler_definition_index_benchmark(config)

	(
		result.checksum == 284
		and result.query_checksum == 0
		and result.exact_source_lookup_count == 0
		and result.source_name_query_count == 0
		and result.workload_valid
	)


pure func test_definition_index_benchmark_repeats_without_id_drift() -> Bool:
	result = compiler_definition_index_benchmark({
		iterations = 5,
		module_count = 3,
		functions_per_module = 2,
		source_query_count = 0,
		source_name_query_count = 0,
		source_query_same_name_matches = 0,
		owner_type_query_count = 0,
	})
	single_iteration = compiler_definition_index_benchmark({
		iterations = 1,
		module_count = 3,
		functions_per_module = 2,
		source_query_count = 0,
		source_name_query_count = 0,
		source_query_same_name_matches = 0,
		owner_type_query_count = 0,
	})

	(
		result.func_callable_id_count == single_iteration.func_callable_id_count
		and result.source_definition_id_count == single_iteration.source_definition_id_count
		and result.allocated_definition_count == single_iteration.allocated_definition_count
		and result.checksum == 890
		and result.query_checksum == 0
		and result.exact_source_lookup_count == 0
		and result.source_name_query_count == 0
		and result.workload_valid
	)


pure func test_definition_index_benchmark_accounts_exact_source_queries() -> Bool:
	result = compiler_definition_index_benchmark({
		iterations = 2,
		module_count = 4,
		functions_per_module = 1,
		source_query_count = 5,
		source_name_query_count = 0,
		source_query_same_name_matches = 3,
		owner_type_query_count = 0,
	})

	(
		result.exact_source_lookup_hits == result.exact_source_lookup_count
		and result.source_name_query_count == 0
		and result.source_name_query_module_buckets_visited == 0
		and result.source_name_query_sort_calls == 0
		and result.source_name_query_returned_matches == 0
		and result.query_checksum == 27124
		and result.workload_valid
	)


pure func test_definition_index_benchmark_accounts_exact_source_query_misses() -> Bool:
	result = compiler_definition_index_benchmark({
		iterations = 2,
		module_count = 4,
		functions_per_module = 1,
		source_query_count = 5,
		source_name_query_count = 0,
		source_query_same_name_matches = 0,
		owner_type_query_count = 0,
	})

	(
		result.exact_source_lookup_hits == 0
		and result.source_name_query_count == 0
		and result.source_name_query_module_buckets_visited == 0
		and result.source_name_query_sort_calls == 0
		and result.source_name_query_returned_matches == 0
		and result.query_checksum == 370
		and result.workload_valid
	)


pure func test_definition_index_benchmark_accounts_broad_source_name_queries() -> Bool:
	config: CompilerDefinitionIndexBenchmarkConfig = {
		iterations = 2,
		module_count = 4,
		functions_per_module = 1,
		source_query_count = 0,
		source_name_query_count = 5,
		source_query_same_name_matches = 3,
		owner_type_query_count = 0
	}
	result = compiler_definition_index_benchmark(config)
	expected_queries: Int = config.source_name_query_count * config.iterations

	(
		result.exact_source_lookup_count == 0
		and result.exact_source_lookup_hits == 0
		and result.source_name_query_count == expected_queries
		and result.source_name_query_sort_calls == expected_queries
		and result.source_name_query_returned_matches == expected_queries * config.source_query_same_name_matches
		and result.query_checksum == 48420
		and result.workload_valid
	)


pure func test_definition_index_benchmark_accounts_owner_directed_type_queries() -> Bool:
	config: CompilerDefinitionIndexBenchmarkConfig = {
		iterations = 2,
		module_count = 4,
		functions_per_module = 1,
		source_query_count = 0,
		source_name_query_count = 0,
		source_query_same_name_matches = 3,
		owner_type_query_count = 5
	}
	result = compiler_definition_index_benchmark(config)
	expected_queries: Int = config.owner_type_query_count * config.iterations

	(
		result.owner_type_query_count == expected_queries
		and result.owner_type_query_hits == expected_queries
		and result.owner_type_query_module_bucket_probes == expected_queries
		and result.owner_type_query_collision_entries_examined == expected_queries
		and result.owner_type_query_temporary_entries == 0
		and result.owner_type_query_sort_calls == 0
		and result.workload_valid
	)


pure func test_owner_directed_type_query_work_ignores_unrelated_modules() -> Bool:
	small = compiler_definition_index_benchmark({
		iterations = 1,
		module_count = 4,
		functions_per_module = 1,
		source_query_count = 0,
		source_name_query_count = 0,
		source_query_same_name_matches = 3,
		owner_type_query_count = 20,
	})
	large = compiler_definition_index_benchmark({
		iterations = 1,
		module_count = 40,
		functions_per_module = 1,
		source_query_count = 0,
		source_name_query_count = 0,
		source_query_same_name_matches = 3,
		owner_type_query_count = 20,
	})

	(
		small.owner_type_query_module_bucket_probes == large.owner_type_query_module_bucket_probes
		and small.owner_type_query_collision_entries_examined
			== large.owner_type_query_collision_entries_examined
		and small.owner_type_query_temporary_entries == 0
		and large.owner_type_query_temporary_entries == 0
		and small.owner_type_query_sort_calls == 0
		and large.owner_type_query_sort_calls == 0
		and small.workload_valid
		and large.workload_valid
	)


tests: TestSuite = {
	description = "Compiler definition index benchmark",
	tests = [
		("builds a valid checksummed index", test_definition_index_benchmark_is_valid_and_checksummed),
		(
			"repeats without definition id drift",
			test_definition_index_benchmark_repeats_without_id_drift,
		),
		(
			"accounts exact source queries without broad name scans",
			test_definition_index_benchmark_accounts_exact_source_queries,
		),
		(
			"accounts exact source query misses",
			test_definition_index_benchmark_accounts_exact_source_query_misses,
		),
		(
			"accounts broad source name queries",
			test_definition_index_benchmark_accounts_broad_source_name_queries,
		),
		(
			"accounts owner-directed type queries",
			test_definition_index_benchmark_accounts_owner_directed_type_queries,
		),
		(
			"owner-directed type query work ignores unrelated modules",
			test_owner_directed_type_query_work_ignores_unrelated_modules,
		),
	]
}
