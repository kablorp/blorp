private pure func global_name(table: DefinitionTable, id: GlobalId) -> String:
	global_id_name(table, id).get_or("<unknown global>")


private pure func global_module_is(table: DefinitionTable, id: GlobalId, module_id: ModuleId) -> Bool:
	global_id_module_id(table, id).map(func(owner): module_ids_equal(owner, module_id)).get_or(False)


private pure func global_span_start(table: DefinitionTable, id: GlobalId) -> Int:
	global_id_source_span(table, id).map(func(span): span.start_offset).get_or(-1)


private pure func accept_empty_view(scope: PreparedModuleScope) -> BoundModuleViewBinding:
	BoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private pure func callable_graph(source: String) -> Option[CallableHeaderGraph]:
	program = TypecheckTestSupport.finalized_typecheck_program_fixture(
		"global_header_completion.brp",
		"main",
		source,
	)
	indexed ?= indexed_graph_build(
		module_load_candidate(
			resolved_module_identity_from_resolver("main", UserModule),
			program,
		),
		[],
	).to_option()
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	types ?= type_header_graph_build(parameters).to_option()
	traits ?= trait_topology_graph_build(types).to_option()
	callable_header_graph_build(traits).to_option()


private pure func callable_graph_with_dependency(
	target_source: String,
	dependency_source: String,
) -> Option[CallableHeaderGraph]:
	target_program = TypecheckTestSupport.finalized_typecheck_program_fixture(
		"main.brp",
		"main",
		target_source,
	)
	dependency_program = TypecheckTestSupport.finalized_typecheck_program_fixture(
		"dep.brp",
		"dep",
		dependency_source,
	)
	indexed ?= indexed_graph_build(
		module_load_candidate(
			resolved_module_identity_from_resolver("main", UserModule),
			target_program,
		),
		[module_load_candidate(
				resolved_module_identity_from_resolver("dep", UserModule),
				dependency_program,
			)],
	).to_option()
	importable = importable_module_graph(indexed)
	all_importable_index = importable_module_graph_all_index(importable)
	bound ?= bound_module_graph_build(
		indexed,
		["dep"],
		func(scope): typecheck_bind_program_module_view(
			typecheck_state_for_prepared_module_scope(scope, False),
			prepared_module_program(prepared_module_scope_module(scope)),
			all_importable_index,
			prepared_module_scope_canonical_path(scope),
		),
	).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	types ?= type_header_graph_build(parameters).to_option()
	traits ?= trait_topology_graph_build(types).to_option()
	callable_header_graph_build(traits).to_option()


private pure func callable_graph_with_same_named_dependencies(

) -> Option[(CallableHeaderGraph, ModuleId, ModuleId)]:
	target_program = TypecheckTestSupport.finalized_typecheck_program_fixture(
		"main.brp",
		"main",
		"import:\n\tleft as L\n\tright as R\nderived = L.base + R.base",
	)
	left_program = TypecheckTestSupport.finalized_typecheck_program_fixture(
		"left.brp",
		"left",
		"base = 40",
	)
	right_program = TypecheckTestSupport.finalized_typecheck_program_fixture(
		"right.brp",
		"right",
		"base = 2",
	)
	indexed ?= indexed_graph_build(
		module_load_candidate(
			resolved_module_identity_from_resolver("main", UserModule),
			target_program,
		),
		[module_load_candidate(
				resolved_module_identity_from_resolver("left", UserModule),
				left_program,
			), module_load_candidate(
				resolved_module_identity_from_resolver("right", UserModule),
				right_program,
			)],
	).to_option()
	importable = importable_module_graph(indexed)
	all_importable_index = importable_module_graph_all_index(importable)
	bound ?= bound_module_graph_build(
		indexed,
		["left", "right"],
		func(scope): typecheck_bind_program_module_view(
			typecheck_state_for_prepared_module_scope(scope, False),
			prepared_module_program(prepared_module_scope_module(scope)),
			all_importable_index,
			prepared_module_scope_canonical_path(scope),
		),
	).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	types ?= type_header_graph_build(parameters).to_option()
	traits ?= trait_topology_graph_build(types).to_option()
	graph ?= callable_header_graph_build(traits).to_option()
	left_scope ?= indexed_graph_find_dependency_scope(indexed, "left")
	right_scope ?= indexed_graph_find_dependency_scope(indexed, "right")
	Some((graph, prepared_module_scope_id(left_scope), prepared_module_scope_id(right_scope)))


private pure func completion_graph(source: String) -> Option[TypecheckGraphCompletion]:
	program = TypecheckTestSupport.finalized_typecheck_program_fixture(
		"global_header_completion.brp",
		"main",
		source,
	)
	indexed ?= indexed_graph_build(
		module_load_candidate(
			resolved_module_identity_from_resolver("main", UserModule),
			program,
		),
		[],
	).to_option()
	importable = importable_module_graph(indexed)
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	types ?= type_header_graph_build(parameters).to_option()
	traits ?= trait_topology_graph_build(types).to_option()
	callables ?= callable_header_graph_build(traits).to_option()
	implementations ?= implementation_header_graph_build(callables).to_option()
	Some(complete_typecheck_graph(implementations, importable, False))


private pure func accepted_graph(source: String) -> Option[AcceptedTypecheckGraph]:
	completion ?= completion_graph(source)

	match completion:
		TypecheckGraphAccepted(graph):
			Some(graph)
		_:
			None


private pure func dependencies_order_forward_references() -> Option[Bool]:
	graph ?= callable_graph("first = second + 1\nsecond = 41")

	match global_header_completion_plan_build(graph):
		GlobalHeaderCompletionPlanReady(plan):
			Some(
				global_header_completion_plan_pending(
					plan,
				).map(global_header_name) == ["second", "first"],
			)
		GlobalHeaderCompletionPlanBlocked(_, _, _):
			Some(False)


pure func test_dependencies_order_forward_references() -> Bool:
	dependencies_order_forward_references().get_or(False)


private pure func imported_global_dependency_is_exact(target_source: String) -> Option[Bool]:
	graph ?= callable_graph_with_dependency(target_source, "base = 41")
	base ?= callable_header_graph_globals(
		graph,
	).find(
		func(header): global_header_name(header) == "base",
	)

	match global_header_completion_plan_build(graph):
		GlobalHeaderCompletionPlanReady(plan):
			ordered = global_header_completion_plan_pending(plan)
			dependencies = global_header_completion_plan_pending_dependencies(plan)
			derived_index ?= ordered.find_index(
				func(header): global_header_name(header) == "derived",
			)
			derived_dependencies ?= dependencies.get(derived_index)

			Some((
					ordered.map(global_header_name) == ["base", "derived"]
					and derived_dependencies.length() == 1
					and derived_dependencies
						.get(0)
						.map(func(id): global_ids_equal(id, global_header_id(base))) == Some(True)
				))
		GlobalHeaderCompletionPlanBlocked(_, _, _):
			Some(False)


pure func test_selective_import_dependency_is_exact() -> Bool:
	imported_global_dependency_is_exact("import:\n\tdep: base\nderived = base + 1").get_or(False)


pure func test_qualified_import_dependency_is_exact() -> Bool:
	imported_global_dependency_is_exact("import:\n\tdep as D\nderived = D.base + 1").get_or(False)


private pure func same_named_imported_dependencies_use_exact_module_rows() -> Option[Bool]:
	fixture ?= callable_graph_with_same_named_dependencies()
	(graph, left_module_id, right_module_id) = fixture
	definition_table = callable_header_graph_definition_table(graph)
	globals = callable_header_graph_globals(graph)
	left ?= globals.find(func(header):
		id = global_header_id(header)

		global_name(definition_table, id) == "base" and global_module_is(
			definition_table,
			id,
			left_module_id,
		)
	)
	right ?= globals.find(func(header):
		id = global_header_id(header)

		global_name(definition_table, id) == "base" and global_module_is(
			definition_table,
			id,
			right_module_id,
		)
	)

	match global_header_completion_plan_build(graph):
		GlobalHeaderCompletionPlanReady(plan):
			ordered = global_header_completion_plan_pending(plan)
			dependencies = global_header_completion_plan_pending_dependencies(plan)
			derived_index ?= ordered.find_index(
				func(header): global_header_name(header) == "derived",
			)
			derived_dependencies ?= dependencies.get(derived_index)

			Some((
					derived_dependencies.length() == 2
					and derived_dependencies
						.get(0)
						.map(func(id): global_ids_equal(id, global_header_id(left))) == Some(True)
					and derived_dependencies
						.get(1)
						.map(func(id): global_ids_equal(id, global_header_id(right))) == Some(True)
				))
		GlobalHeaderCompletionPlanBlocked(_, _, _):
			Some(False)


pure func test_same_named_imported_dependencies_use_exact_module_rows() -> Bool:
	same_named_imported_dependencies_use_exact_module_rows().get_or(False)


private pure func completed_dependency_summary(source: String) -> Option[List[String]]:
	graph ?= accepted_graph(source)
	definition_table = accepted_typecheck_graph_definition_table(graph)
	headers = accepted_typecheck_graph_completed_globals(graph)
	var identities_are_exact: Bool = True
	var summary: List[String] = []

	for header in headers:
		dependencies = completed_global_header_global_dependencies(header)

		for dependency in dependencies:
			if (
				not headers.any(func(candidate):
					global_ids_equal(completed_global_header_id(candidate), dependency)
				)
			):
				identities_are_exact = False

		summary = summary.append(
			global_name(definition_table, completed_global_header_id(header)) + ":" + dependencies
				.map(func(id): global_name(definition_table, id))
				.sort()
				.join(","),
		)

	if identities_are_exact:
		Some(summary.sort())
	else:
		None


private pure func acyclic_permutations_complete_identically() -> Option[Bool]:
	forward ?= completed_dependency_summary("base = 1\nmiddle = base + 1\nleaf = middle + base")
	reversed ?= completed_dependency_summary("leaf = middle + base\nmiddle = base + 1\nbase = 1")
	shuffled ?= completed_dependency_summary("middle = base + 1\nbase = 1\nleaf = middle + base")

	Some(forward == reversed and reversed == shuffled)


pure func test_acyclic_permutations_complete_identically() -> Bool:
	acyclic_permutations_complete_identically().get_or(False)


