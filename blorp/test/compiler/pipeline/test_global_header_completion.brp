private pure func assignment_targets_order_headers() -> Option[Bool]:
	graph ?= callable_graph(
		"derived = func():\n\tbase = 2\ncompound = func():\n\tbase += 1\nvar base = 1",
	)
	definition_table = callable_header_graph_definition_table(graph)

	match global_header_completion_plan_build(graph):
		GlobalHeaderCompletionPlanReady(plan):
			ordered = global_header_completion_plan_pending(plan)
			dependencies = global_header_completion_plan_pending_dependencies(plan)
			var aligned: List[String] = []

			for index in 0..ordered.length():
				match (ordered.get(index), dependencies.get(index)):
					(Some(header), Some(header_dependencies)):
						aligned = aligned.append(
							global_header_name(header) + ":" + header_dependencies
								.map(func(id): global_name(definition_table, id))
								.join(","),
						)
					_:
						void

			Some(aligned == ["base:", "derived:base", "compound:base"])
		GlobalHeaderCompletionPlanBlocked(_, _, _):
			Some(False)


pure func test_assignment_targets_order_headers() -> Bool:
	assignment_targets_order_headers().get_or(False)


