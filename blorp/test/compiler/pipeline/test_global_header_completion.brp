private pure func blocked_dependents_are_not_cycle_members() -> Option[Bool]:
	graph ?= callable_graph("dependent = first\nfirst = second\nsecond = first")
	definition_table = callable_header_graph_definition_table(graph)

	Some(
		match global_header_completion_plan_build(graph):
			GlobalHeaderCompletionPlanBlocked(_, components, blocked):
				(
					components
						.flat_map(func(component): component)
						.map(func(id): global_name(definition_table, id))
						.sort() == ["first", "second"]
					and blocked.map(func(id): global_name(definition_table, id)) == ["dependent"]
				)
			GlobalHeaderCompletionPlanReady(_):
				False
	)


pure func test_blocked_dependents_are_not_cycle_members() -> Bool:
	blocked_dependents_are_not_cycle_members().get_or(False)


private pure func disjoint_cycles_remain_distinct_components() -> Option[Bool]:
	graph ?= callable_graph("a = b\nb = a\nc = d\nd = c")
	definition_table = callable_header_graph_definition_table(graph)

	Some(
		match global_header_completion_plan_build(graph):
			GlobalHeaderCompletionPlanBlocked(_, components, blocked):
				components.map(func(component):
					component
						.map(func(id): global_name(definition_table, id))
						.sort()
						.join(",")
				) == ["a,b", "c,d"] and blocked.is_empty()
			GlobalHeaderCompletionPlanReady(_):
				False
	)


pure func test_disjoint_cycles_remain_distinct_components() -> Bool:
	disjoint_cycles_remain_distinct_components().get_or(False)


private pure func cycle_source(global_count: Int) -> String:
	var declarations: List[String] = []

	for index in 0..global_count:
		next_index = (index + 1) % global_count
		declarations = declarations.append(
			"global_${index.to_string()} = global_${next_index.to_string()}",
		)

	declarations.join("\n")


private pure func large_cycle_is_classified_without_recursive_search() -> Option[Bool]:
	global_count: Int = 256
	graph ?= callable_graph(cycle_source(global_count))

	Some(
		match global_header_completion_plan_build(graph):
			GlobalHeaderCompletionPlanBlocked(_, components, blocked):
				(
					components.length() == 1
					and components
						.get_or(0, [])
						.length() == global_count
					and blocked.is_empty()
				)
			GlobalHeaderCompletionPlanReady(_):
				False
	)


pure func test_large_cycle_is_classified_without_recursive_search() -> Bool:
	large_cycle_is_classified_without_recursive_search().get_or(False)


private pure func reverse_chain_source(global_count: Int) -> String:
	var declarations: List[String] = []

	for index in 0..global_count:
		value = if index + 1 == global_count:
			"1"
		else:
			"global_${(index + 1).to_string()}"

		declarations = declarations.append("global_${index.to_string()} = ${value}")

	declarations.join("\n")


private pure func large_reverse_chain_uses_dependency_order() -> Option[Bool]:
	global_count: Int = 256
	graph ?= callable_graph(reverse_chain_source(global_count))

	Some(
		match global_header_completion_plan_build(graph):
			GlobalHeaderCompletionPlanReady(plan):
				ordered = global_header_completion_plan_pending(plan)

				(
					ordered.length() == global_count
					and ordered
						.get(0)
						.map(global_header_name) == Some("global_${(global_count - 1).to_string()}")
				)
			GlobalHeaderCompletionPlanBlocked(_, _, _):
				False
	)


pure func test_large_reverse_chain_uses_dependency_order() -> Bool:
	large_reverse_chain_uses_dependency_order().get_or(False)


private pure func failed_completion_is_recoverable_not_accepted() -> Option[Bool]:
	completion ?= completion_graph("first = second\nsecond = first")

	Some(
		match completion:
			TypecheckGraphRecoverable(_):
				True
			_:
				False
	)


pure func test_failed_completion_is_recoverable_not_accepted() -> Bool:
	failed_completion_is_recoverable_not_accepted().get_or(False)


private pure func repeated_diagnostics_preserve_distinct_spans() -> Option[Bool]:
	completion ?= completion_graph("first = missing\nsecond = missing")

	Some(
		match completion:
			TypecheckGraphRecoverable(graph):
				diagnostics = recoverable_typecheck_graph_diagnostics(graph)
				diagnostics.length() == 2 and diagnostics.all(func(diagnostic):
					diagnostic.span.is_some()
				)
			_:
				False
	)


pure func test_repeated_diagnostics_preserve_distinct_spans() -> Bool:
	repeated_diagnostics_preserve_distinct_spans().get_or(False)


private pure func result_uses_declaration_authority(result: TypecheckProgramResult) -> Bool:
	match (
		module_view_accepted_alias_authority(result.state.module_view),
		module_view_accepted_record_authority(result.state.module_view),
		module_view_accepted_union_authority(result.state.module_view),
	):
		(Some(alias_authority), Some(record_authority), Some(union_index)):
			match (
				accepted_alias_find_transparent(alias_authority, "UserId"),
				accepted_record_find(record_authority, "Box"),
				accepted_union_find(union_index, "Mode"),
			):
				(Some(alias_entry), Some(record_entry), Some(union_entry)):
					(
						result.state.errors.is_empty()
						and env_get_alias(result.state.env, "UserId").is_none()
						and env_get_record(result.state.env, "Box").is_none()
						and env_get_type_decl(result.state.env, "Mode").is_none()
						and env_get_constructor(result.state.env, "Fast").is_none()
						and accepted_union_find_constructor(union_index, "Fast").is_some()
						and types_equal(alias_entry.target, TYPE_INT)
						and record_entry.fields.length() == 1
						and union_entry.is_enum
						and union_entry.variants.length() == 2
					)
				_:
					False
		_:
			False


private pure func recoverable_dependency_declaration_authority_is_shared_with_ctfe(

) -> Option[Bool]:
	target_program = TypecheckTestSupport.finalized_typecheck_program_fixture(
		"main.brp",
		"main",
		"import:\n\tdep\nfirst = second\nsecond = first",
	)
	dependency_program = TypecheckTestSupport.finalized_typecheck_program_fixture(
		"dep.brp",
		"dep",
		"type alias UserId = Int\nrecord Box {value: Int}\nenum Mode:\n\tFast\n\tSlow\nanswer = 41\npure func answer_value() -> Int: answer\npure func identity(value: UserId) -> UserId: value\npure func make_box() -> Box: {value = answer}\npure func read_box(box: Box) -> Int: box.value\npure func update_box(box: Box) -> Box: { box | value = box.value + 1 }\npure func mode_value(mode: Mode) -> Int:\n\tmatch mode:\n\t\tFast: 1\n\t\tSlow: 0",
	)
	indexed ?= indexed_graph_build(
		module_load_candidate(
			resolved_module_identity_from_resolver("main", UserModule),
			target_program,
		),
		[module_load_candidate(
				resolved_module_identity_from_resolver("dep", UserModule),
				dependency_program,
			)],
	).to_option()
	target_scope = indexed_graph_target_scope(indexed)
	dependency_scope ?= indexed_graph_find_dependency_scope(indexed, "dep")
	importable = importable_module_graph(indexed)
	all_importable_index = importable_module_graph_all_index(importable)
	bound ?= bound_module_graph_build(
		indexed,
		["dep"],
		func(scope): typecheck_bind_program_module_view(
			typecheck_state_for_prepared_module_scope(scope, False),
			prepared_module_program(prepared_module_scope_module(scope)),
			all_importable_index,
			prepared_module_scope_canonical_path(scope),
		),
	).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	types ?= type_header_graph_build(parameters).to_option()
	traits ?= trait_topology_graph_build(types).to_option()
	callables ?= callable_header_graph_build(traits).to_option()
	implementations ?= implementation_header_graph_build(callables).to_option()
	completion = complete_typecheck_graph(implementations, importable, False)

	match completion:
		TypecheckGraphRecoverable(graph):
			failed_target_is_excluded = recoverable_graph_typecheck_module(
				graph,
				target_scope,
				False,
			).is_none()
			module_option = recoverable_graph_typecheck_module(graph, dependency_scope, False)
			state = typecheck_state_for_prepared_module_scope(dependency_scope, False)
			artifact_option = recoverable_ctfe_artifact_typecheck_module(
				graph,
				dependency_scope,
				state,
			)
			module ?= module_option
			artifact ?= artifact_option
			module_result = typecheck_program_with_type_header_module_for_policy(
				module,
				IgnoreMainName,
			)
			artifact_result = typecheck_program_with_type_header_module_for_policy(
				artifact,
				IgnoreMainName,
			)
			Some(
				(
					failed_target_is_excluded
					and result_uses_declaration_authority(module_result)
					and result_uses_declaration_authority(artifact_result)
				),
			)
		_:
			Some(False)


pure func test_recoverable_dependency_declaration_authority_is_shared_with_ctfe() -> Bool:
	recoverable_dependency_declaration_authority_is_shared_with_ctfe().get_or(False)


pure func test_empty_completion_graph_releases_context() -> Bool:
	accepted_graph("pure func answer() -> Int: 1").is_some()


pure func test_single_completed_global_releases() -> Bool:
	accepted_graph("value = 1").is_some()


private pure func accepted_graph_checks_each_initializer_once() -> Option[Bool]:
	graph ?= accepted_graph(
		"base = 40\npure func first() -> Int: base + 1\npure func second() -> Int: base + 2",
	)
	metrics = accepted_typecheck_graph_global_completion_metrics(graph)

	Some(metrics.initializer_checks == 1 and metrics.duplicate_initializer_requests == 0)


pure func test_accepted_graph_checks_each_initializer_once() -> Bool:
	accepted_graph_checks_each_initializer_once().get_or(False)


private pure func completed_headers_preserve_annotation_origin() -> Option[Bool]:
	graph ?= accepted_graph("base = 40\nannotated: Int = base + 1\ninferred = annotated + 1")
	definition_table = accepted_typecheck_graph_definition_table(graph)
	headers = accepted_typecheck_graph_completed_globals(graph)
	annotated ?= headers.find(func(header):
		global_name(definition_table, completed_global_header_id(header)) == "annotated"
	)
	inferred ?= headers.find(func(header):
		global_name(definition_table, completed_global_header_id(header)) == "inferred"
	)

	Some(
		match (annotated, inferred):
			(CompletedAnnotatedGlobalHeader(_, _, _, _, _, _), CompletedInferredGlobalHeader(_, _, _, _, _, _)):
				(
					types_equal(completed_global_header_canonical_binding_type(annotated), TYPE_INT)
					and completed_global_header_global_dependencies(
						annotated,
					).map(func(id): global_name(definition_table, id)) == ["base"]
					and types_equal(
						completed_global_header_canonical_binding_type(inferred),
						TYPE_INT,
					)
				)
			_:
				False
	)


pure func test_completed_headers_preserve_annotation_origin() -> Bool:
	completed_headers_preserve_annotation_origin().get_or(False)


private pure func annotated_dependencies_remain_aligned() -> Option[Bool]:
	graph ?= callable_graph("base = 40\nannotated: Int = base + 1")
	definition_table = callable_header_graph_definition_table(graph)

	match global_header_completion_plan_build(graph):
		GlobalHeaderCompletionPlanReady(plan):
			annotated ?= global_header_completion_plan_annotated(plan).get(0)
			dependencies ?= global_header_completion_plan_annotated_dependencies(plan).get(0)

			Some(
				(
					global_header_name(annotated) == "annotated"
					and dependencies.map(func(id): global_name(definition_table, id)) == ["base"]
				),
			)
		GlobalHeaderCompletionPlanBlocked(_, _, _):
			Some(False)


pure func test_annotated_dependencies_remain_aligned() -> Bool:
	annotated_dependencies_remain_aligned().get_or(False)


private pure func completed_headers_retain_exact_dependencies() -> Option[Bool]:
	graph ?= accepted_graph("pure func answer() -> Int: 1\nbase = 41\nderived = base + answer()")
	definition_table = accepted_typecheck_graph_definition_table(graph)
	headers = accepted_typecheck_graph_completed_globals(graph)
	derived ?= headers.find(func(header):
		global_name(definition_table, completed_global_header_id(header)) == "derived"
	)

	Some(
		(
			headers.length() == 2
			and completed_global_header_global_dependencies(derived).map(
				func(id): global_name(definition_table, id),
			) == ["base"]
			and completed_global_header_callable_dependencies(derived).length() == 1
		),
	)


pure func test_completed_headers_retain_exact_dependencies() -> Bool:
	completed_headers_retain_exact_dependencies().get_or(False)


private pure func completed_dependencies_distinguish_lambda_captures_and_calls() -> Option[Bool]:
	graph ?= accepted_graph(
		"pure func answer() -> Int: 1\nlater = 41\ndeferred = func(): later + answer()",
	)
	definition_table = accepted_typecheck_graph_definition_table(graph)
	headers = accepted_typecheck_graph_completed_globals(graph)
	deferred ?= headers.find(func(header):
		global_name(definition_table, completed_global_header_id(header)) == "deferred"
	)
	Some(
		(
			completed_global_header_global_dependencies(deferred).map(
				func(id): global_name(definition_table, id),
			) == ["later"]
			and completed_global_header_callable_dependencies(deferred).is_empty()
		),
	)


pure func test_completed_dependencies_distinguish_lambda_captures_and_calls() -> Bool:
	completed_dependencies_distinguish_lambda_captures_and_calls().get_or(False)


private pure func duplicate_named_globals_keep_exact_planned_dependencies() -> Option[Bool]:
	graph ?= callable_graph("base_one = 1\nsame = base_one\nbase_two = 2\nsame = base_two")
	definition_table = callable_header_graph_definition_table(graph)
	same_headers = callable_header_graph_globals(
		graph,
	).filter(
		func(header): global_header_name(header) == "same",
	)
	Some(
		match global_header_completion_plan_build(graph):
			GlobalHeaderCompletionPlanReady(plan):
				ordered = global_header_completion_plan_pending(plan)
				dependencies = global_header_completion_plan_pending_dependencies(plan)
				var aligned: List[String] = []

				for index in 0..ordered.length():
					match (ordered.get(index), dependencies.get(index)):
						(Some(header), Some(header_dependencies)):
							aligned = aligned.append(
								global_header_name(header) + ":" + header_dependencies
									.map(func(id): global_name(definition_table, id))
									.join(","),
							)
						_:
							void

				(
					same_headers.length() == 2
					and aligned == ["base_one:", "same:base_one", "base_two:", "same:base_two"]
				)
			GlobalHeaderCompletionPlanBlocked(_, _, _):
				False
	)


pure func test_duplicate_named_globals_keep_exact_planned_dependencies() -> Bool:
	duplicate_named_globals_keep_exact_planned_dependencies().get_or(False)


private pure func pending_shadowed_by_annotated_duplicate_keeps_baseline_cycle() -> Option[Bool]:
	graph ?= callable_graph("same = same\nsame: Int = 1")
	definition_table = callable_header_graph_definition_table(graph)

	Some(
		match global_header_completion_plan_build(graph):
			GlobalHeaderCompletionPlanBlocked(plan, components, blocked):
				(
					global_header_completion_plan_pending(plan).is_empty()
					and blocked.is_empty()
					and components.length() == 1
					and components
						.get(0)
						.get_or([])
						.map(func(id): global_span_start(definition_table, id)) == [0]
				)
			GlobalHeaderCompletionPlanReady(_):
				False
	)


pure func test_pending_shadowed_by_annotated_duplicate_keeps_baseline_cycle() -> Bool:
	pending_shadowed_by_annotated_duplicate_keeps_baseline_cycle().get_or(False)


private pure func blocked_duplicate_sharing_cycle_name_keeps_baseline_classification(

) -> Option[Bool]:
	graph ?= callable_graph("first = second\nsecond = first\nfirst = second")
	definition_table = callable_header_graph_definition_table(graph)

	Some(
		match global_header_completion_plan_build(graph):
			GlobalHeaderCompletionPlanBlocked(plan, components, blocked):
				(
					global_header_completion_plan_pending(plan).is_empty()
					and blocked.is_empty()
					and components.length() == 1
					and components
						.get(0)
						.get_or([])
						.map(func(id): global_span_start(definition_table, id)) == [15, 30]
				)
			GlobalHeaderCompletionPlanReady(_):
				False
	)


pure func test_blocked_duplicate_sharing_cycle_name_keeps_baseline_classification() -> Bool:
	blocked_duplicate_sharing_cycle_name_keeps_baseline_classification().get_or(False)


tests: TestSuite = {
	description = "Compiler global header completion",
	tests = [
		("orders forward dependencies", test_dependencies_order_forward_references),
		(
			"resolves selective import dependencies exactly",
			test_selective_import_dependency_is_exact,
		),
		(
			"resolves qualified import dependencies exactly",
			test_qualified_import_dependency_is_exact,
		),
		(
			"same-named imported dependencies use exact module rows",
			test_same_named_imported_dependencies_use_exact_module_rows,
		),
		(
			"completes acyclic source permutations identically",
			test_acyclic_permutations_complete_identically,
		),
		("orders lambda body type dependencies", test_lambda_body_type_dependencies_order_headers),
		("scopes question bindings lexically", test_question_binding_is_lexically_scoped),
		("orders assignment-target dependencies", test_assignment_targets_order_headers),
		(
			"field access depends on its global receiver",
			test_field_access_depends_on_its_global_receiver,
		),
		("represents unannotated cycles explicitly", test_unannotated_cycles_are_explicit),
		(
			"cycles preserve independent completion work",
			test_cycles_preserve_independent_completion_work,
		),
		("separates blocked dependents from cycles", test_blocked_dependents_are_not_cycle_members),
		("keeps disjoint cycles separate", test_disjoint_cycles_remain_distinct_components),
		(
			"classifies a large cycle without recursive search",
			test_large_cycle_is_classified_without_recursive_search,
		),
		("orders a large reverse dependency chain", test_large_reverse_chain_uses_dependency_order),
		("failed completion is recoverable", test_failed_completion_is_recoverable_not_accepted),
		(
			"preserves repeated diagnostics at distinct spans",
			test_repeated_diagnostics_preserve_distinct_spans,
		),
		(
			"recoverable dependency declaration authority is shared with CTFE",
			test_recoverable_dependency_declaration_authority_is_shared_with_ctfe,
		),
		("empty graph releases prepared context", test_empty_completion_graph_releases_context),
		("single completed global releases", test_single_completed_global_releases),
		(
			"checks each initializer once across body consumers",
			test_accepted_graph_checks_each_initializer_once,
		),
		(
			"preserves annotated and inferred origins",
			test_completed_headers_preserve_annotation_origin,
		),
		("keeps annotated dependencies aligned", test_annotated_dependencies_remain_aligned),
		(
			"retains exact global and callable dependencies",
			test_completed_headers_retain_exact_dependencies,
		),
		(
			"retains lambda captures but excludes deferred calls",
			test_completed_dependencies_distinguish_lambda_captures_and_calls,
		),
		(
			"duplicate named globals keep exact planned dependencies",
			test_duplicate_named_globals_keep_exact_planned_dependencies,
		),
		(
			"pending shadowed by annotated duplicate keeps baseline cycle",
			test_pending_shadowed_by_annotated_duplicate_keeps_baseline_cycle,
		),
		(
			"blocked duplicate sharing cycle name keeps baseline classification",
			test_blocked_duplicate_sharing_cycle_name_keeps_baseline_classification,
		),
	]
}
