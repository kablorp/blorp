		("scopes question bindings lexically", test_question_binding_is_lexically_scoped),
		("orders assignment-target dependencies", test_assignment_targets_order_headers),
		(
			"field access depends on its global receiver",
			test_field_access_depends_on_its_global_receiver,
		),
		("represents unannotated cycles explicitly", test_unannotated_cycles_are_explicit),
		(
			"cycles preserve independent completion work",
			test_cycles_preserve_independent_completion_work,
		),
		("separates blocked dependents from cycles", test_blocked_dependents_are_not_cycle_members),
		("keeps disjoint cycles separate", test_disjoint_cycles_remain_distinct_components),
		(
			"classifies a large cycle without recursive search",
			test_large_cycle_is_classified_without_recursive_search,
		),
		("orders a large reverse dependency chain", test_large_reverse_chain_uses_dependency_order),
		("failed completion is recoverable", test_failed_completion_is_recoverable_not_accepted),
		(
			"preserves repeated diagnostics at distinct spans",
			test_repeated_diagnostics_preserve_distinct_spans,
		),
		(
			"recoverable dependency declaration authority is shared with CTFE",
			test_recoverable_dependency_declaration_authority_is_shared_with_ctfe,
		),
		("empty graph releases prepared context", test_empty_completion_graph_releases_context),
		("single completed global releases", test_single_completed_global_releases),
		(
			"checks each initializer once across body consumers",
			test_accepted_graph_checks_each_initializer_once,
		),
		(
			"preserves annotated and inferred origins",
			test_completed_headers_preserve_annotation_origin,
		),
		(
			"retains exact global and callable dependencies",
			test_completed_headers_retain_exact_dependencies,
		),
		(
			"retains lambda captures but excludes deferred calls",
			test_completed_dependencies_distinguish_lambda_captures_and_calls,
		),
		(
			"duplicate named globals keep exact planned dependencies",
			test_duplicate_named_globals_keep_exact_planned_dependencies,
		),
	]
}
