private pure func assignment_targets_order_headers() -> Option[Bool]:
	graph ?= callable_graph(
		"derived = func():\n\tbase = 2\ncompound = func():\n\tbase += 1\nvar base = 1",
	)

	match global_header_completion_plan_build(graph):
		GlobalHeaderCompletionPlanReady(plan):
			ordered = global_header_completion_plan_pending(plan)
			derived ?= ordered.find(func(header): global_header_name(header) == "derived")
			compound ?= ordered.find(func(header): global_header_name(header) == "compound")

			Some(
				(
					global_header_completion_plan_dependencies(
						plan,
						global_header_id(derived),
					).map(global_id_name) == ["base"]
					and global_header_completion_plan_dependencies(
						plan,
						global_header_id(compound),
					).map(global_id_name) == ["base"]
				),
			)
		GlobalHeaderCompletionPlanBlocked(_, _, _):
			Some(False)


pure func test_assignment_targets_order_headers() -> Bool:
	assignment_targets_order_headers().get_or(False)


