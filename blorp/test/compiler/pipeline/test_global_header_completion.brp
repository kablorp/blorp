private pure func accept_empty_view(scope: PreparedModuleScope) -> BoundModuleViewBinding:
	BoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private pure func callable_graph(source: String) -> Option[CallableHeaderGraph]:
	program = TypecheckTestSupport.finalized_typecheck_program_fixture(
		"global_header_completion.brp",
		"main",
		source,
	)
	indexed ?= indexed_graph_build(
		module_load_candidate(
			resolved_module_identity_from_resolver("main", UserModule),
			program,
		),
		[],
	).to_option()
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	types ?= type_header_graph_build(parameters).to_option()
	traits ?= trait_topology_graph_build(types).to_option()
	callable_header_graph_build(traits).to_option()


private pure func completion_graph(source: String) -> Option[TypecheckGraphCompletion]:
	program = TypecheckTestSupport.finalized_typecheck_program_fixture(
		"global_header_completion.brp",
		"main",
		source,
	)
	indexed ?= indexed_graph_build(
		module_load_candidate(
			resolved_module_identity_from_resolver("main", UserModule),
			program,
		),
		[],
	).to_option()
	importable = importable_module_graph(indexed)
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	types ?= type_header_graph_build(parameters).to_option()
	traits ?= trait_topology_graph_build(types).to_option()
	callables ?= callable_header_graph_build(traits).to_option()
	implementations ?= implementation_header_graph_build(callables).to_option()
	Some(complete_typecheck_graph(implementations, importable, False))


private pure func accepted_graph(source: String) -> Option[AcceptedTypecheckGraph]:
	completion ?= completion_graph(source)

	match completion:
		TypecheckGraphAccepted(graph):
			Some(graph)
		_:
			None


private pure func dependencies_order_forward_references() -> Option[Bool]:
	graph ?= callable_graph("first = second + 1\nsecond = 41")

	match global_header_completion_plan_build(graph):
		GlobalHeaderCompletionPlanReady(plan):
			Some(
				global_header_completion_plan_pending(
					plan,
				).map(global_header_name) == ["second", "first"],
			)
		GlobalHeaderCompletionPlanBlocked(_, _, _):
			Some(False)


pure func test_dependencies_order_forward_references() -> Bool:
	dependencies_order_forward_references().get_or(False)


private pure func completed_dependency_summary(source: String) -> Option[List[String]]:
	graph ?= accepted_graph(source)
	headers = accepted_typecheck_graph_completed_globals(graph)
	var identities_are_exact: Bool = True
	var summary: List[String] = []

	for header in headers:
		dependencies = completed_global_header_global_dependencies(header)

		for dependency in dependencies:
			if (
				not headers.any(func(candidate):
					global_ids_equal(completed_global_header_id(candidate), dependency)
				)
			):
				identities_are_exact = False

		summary = summary.append(
			global_id_name(completed_global_header_id(header)) + ":" + dependencies
				.map(global_id_name)
				.sort()
				.join(","),
		)

	if identities_are_exact:
		Some(summary.sort())
	else:
		None


private pure func acyclic_permutations_complete_identically() -> Option[Bool]:
	forward ?= completed_dependency_summary("base = 1\nmiddle = base + 1\nleaf = middle + base")
	reversed ?= completed_dependency_summary("leaf = middle + base\nmiddle = base + 1\nbase = 1")
	shuffled ?= completed_dependency_summary("middle = base + 1\nbase = 1\nleaf = middle + base")

	Some(forward == reversed and reversed == shuffled)


pure func test_acyclic_permutations_complete_identically() -> Bool:
	acyclic_permutations_complete_identically().get_or(False)


