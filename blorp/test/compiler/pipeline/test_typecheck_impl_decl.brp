import:
	../../../src/compiler/stage_02_lex/name_table: synthesized_name_id
	../../../src/compiler/stage_03_parse/parsed_ast:
		ParsedTypeParamKind(ParsedTypeParameter),
		ParsedDecl(
			FunctionParsedDecl,
			ImplParsedDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
		),
		ParsedExpr(ParsedCallExpr, ParsedIntLiteralExpr, ParsedNameExpr, ParsedStringLiteralExpr),
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder),
		ParsedProgram,
		ParsedStringLiteralForm(ParsedPlainStringLiteral),
		ParsedTraitMethodDecl,
		ParsedTypeExpr(ParsedBoundedType, ParsedNamedType),
		parsed_identifier,
	../../../src/compiler/stage_06_typecheck/decl:
		TypedDecl(TypedImplDecl, TypedPrivateDecl),
		TypedImplInfo,
	../../../src/compiler/stage_06_typecheck/modules/module_view:
		module_view_accepted_trait_implementation_authority,
	../../../src/compiler/stage_06_typecheck/state:
		TYPECHECK_USER_ORIGIN,
		TypecheckState,
		typecheck_state_for_origin,
		typecheck_state_record_type_home,
	../../../src/compiler/stage_06_typecheck/type_system/accepted_trait_implementation_authority:
		accepted_trait_find,
	../../../src/compiler/stage_06_typecheck/type_system/generic_params: bound_type_param_name
	../../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticType(SemanticNamedType, SemanticTypeVar),
		SemanticTypeVarKind(SemanticTypeParameter),
		types_equal,
	../../../src/lib/source:
		Cursor,
		SourceFile,
		SourceLocation,
		source_cursor_at,
		source_file,
		source_location_for_file,
	../typecheck_test_support: typecheck_test_program
	test: TestSuite


pure func source_file_named(module_name: String) -> SourceFile:
	source_file(module_name + ".brp", module_name, "func main(): 1")


pure func fixture_source_span() -> SourceLocation:
	src: SourceFile = source_file_named("decl")
	cursor: Cursor = source_cursor_at(src, 0)
	source_location_for_file(src, cursor, cursor)


pure func fixture_source_span_at(offset: Int) -> SourceLocation:
	src: SourceFile = source_file_named("decl")
	cursor: Cursor = source_cursor_at(src, offset)
	source_location_for_file(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(synthesized_name_id(text), text, fixture_source_span())


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], fixture_source_span())


pure func generic_named_type(name: String, args: List[ParsedTypeExpr]) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), args, fixture_source_span())


pure func bounded_type(name: String, bounds: List[String]) -> ParsedTypeExpr:
	ParsedBoundedType(
		ident(name),
		bounds.map(ident),
		fixture_source_span(),
	)


pure func int_type() -> ParsedTypeExpr:
	named_type("Int")


pure func string_type() -> ParsedTypeExpr:
	named_type("String")


pure func int_expr() -> ParsedExpr:
	ParsedIntLiteralExpr("1", fixture_source_span())


pure func string_expr() -> ParsedExpr:
	ParsedStringLiteralExpr("text", ParsedPlainStringLiteral, fixture_source_span())


pure func name_expr(name: String) -> ParsedExpr:
	ParsedNameExpr(ident(name))


pure func call_expr(name: String, args: List[ParsedExpr]) -> ParsedExpr:
	ParsedCallExpr(name_expr(name), args, fixture_source_span())


pure func named_param(name: String, type_expr: ParsedTypeExpr) -> ParsedParam:
	{
		binder = ParsedParamNameBinder(ident(name)),
		type_expr = Some(type_expr),
		span = fixture_source_span()
	}


pure func function_decl_with_body(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: ParsedExpr,
	is_pure: Bool,
) -> ParsedFunctionDecl:
	{
		name = ident(name),
		keyword_span = Some(fixture_source_span()),
		type_params = [],
		params = params,
		return_type = return_type,
		dim_constraints = [],
		body = Some(body),
		is_pure = is_pure,
		annotations = [],
		doc = None,
		span = fixture_source_span()
	}


pure func function_decl_parsed(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: ParsedExpr,
	is_pure: Bool,
) -> ParsedDecl:
	FunctionParsedDecl(function_decl_with_body(name, params, return_type, body, is_pure))


pure func record_decl(name: String) -> ParsedDecl:
	RecordParsedDecl({
		name = ident(name),
		type_params = [],
		fields = [],
		is_struct = False,
		doc = None,
		span = fixture_source_span(),
	})


pure func generic_record_decl(name: String, type_param_name: String) -> ParsedDecl:
	RecordParsedDecl({
		name = ident(name),
		type_params = [{
				name = ident(type_param_name),
				kind = ParsedTypeParameter,
				bounds = [],
				span = fixture_source_span()
			}],
		fields = [],
		is_struct = False,
		doc = None,
		span = fixture_source_span(),
	})


pure func trait_decl(name: String) -> ParsedDecl:
	trait_decl_with_details(name, [], [])


pure func trait_method_decl(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	is_pure: Bool,
	has_default: Bool,
) -> ParsedTraitMethodDecl:
	body: Option[ParsedExpr] = if has_default:
		Some(int_expr())
	else:
		None

	{
		name = ident(name),
		params = params,
		return_type = return_type,
		body = body,
		is_pure = is_pure,
		span = fixture_source_span()
	}


pure func trait_decl_with_details(
	name: String,
	supertraits: List[String],
	methods: List[ParsedTraitMethodDecl],
) -> ParsedDecl:
	TraitParsedDecl({
		name = ident(name),
		type_params = [],
		supertraits = supertraits.map(ident),
		methods = methods,
		doc = None,
		span = fixture_source_span(),
	})


pure func impl_decl_with_methods(
	trait_name: String,
	for_type: ParsedTypeExpr,
	methods: List[ParsedFunctionDecl],
) -> ParsedDecl:
	impl_decl_with_methods_at(trait_name, for_type, methods, 2)


pure func impl_decl_with_methods_at(
	trait_name: String,
	for_type: ParsedTypeExpr,
	methods: List[ParsedFunctionDecl],
	span_offset: Int,
) -> ParsedDecl:
	ImplParsedDecl({
		trait_name = ident(trait_name),
		for_type = for_type,
		methods = methods,
		doc = None,
		span = fixture_source_span_at(span_offset),
	})


pure func impl_decl(trait_name: String, for_type: ParsedTypeExpr) -> ParsedDecl:
	impl_decl_with_methods(trait_name, for_type, [])


pure func impl_decl_at(
	trait_name: String,
	for_type: ParsedTypeExpr,
	span_offset: Int,
) -> ParsedDecl:
	impl_decl_with_methods_at(trait_name, for_type, [], span_offset)


pure func private_impl_decl(trait_name: String, for_type: ParsedTypeExpr) -> ParsedDecl:
	PrivateParsedDecl(
		impl_decl(trait_name, for_type),
		fixture_source_span(),
	)


pure func private_impl_decl_at(
	trait_name: String,
	for_type: ParsedTypeExpr,
	span_offset: Int,
) -> ParsedDecl:
	PrivateParsedDecl(
		impl_decl_at(trait_name, for_type, span_offset),
		fixture_source_span(),
	)


pure func program_named(module_name: String, decls: List[ParsedDecl]) -> ParsedProgram:
	{
		source = source_file_named(module_name),
		decls = decls,
		diagnostics = []
	}


pure func program(decls: List[ParsedDecl]) -> ParsedProgram:
	program_named("decl", decls)



pure func typed_impl_decls(decls: List[TypedDecl]) -> List[TypedImplInfo]:
	var found: List[TypedImplInfo] = []

	for decl in decls:
		match decl:
			TypedImplDecl(info):
				found = found.append(info)
			TypedPrivateDecl(TypedImplDecl(info)):
				found = found.append(info)
			_:
				void

	found


func test_registers_public_and_private_impl_headers() -> Bool:
	source_program = program([
		trait_decl("CheckpointDisplay"),
		trait_decl("CheckpointHidden"),
		record_decl("CheckpointWidget"),
		record_decl("CheckpointSecret"),
		impl_decl("CheckpointDisplay", named_type("CheckpointWidget")),
		private_impl_decl("CheckpointHidden", named_type("CheckpointSecret")),
	])
	result = typecheck_test_program(typecheck_state_for_origin(TYPECHECK_USER_ORIGIN), source_program)
	impls = typed_impl_decls(result.program.decls)

	trait_home_ok: Bool = match module_view_accepted_trait_implementation_authority(
		result.state.module_view,
	).and_then(func(authority): accepted_trait_find(authority, "CheckpointDisplay")):
		Some(trait_def):
			trait_def.module_path == Some("decl")
		None:
			False

	(
		result.state.errors.length() == 0
		and impls.length() == 2
		and trait_home_ok
		and impls.any(func(info): (
				info.decl.trait_name.text == "CheckpointDisplay"
				and types_equal(info.for_type, SemanticNamedType("CheckpointWidget", []))
			))
		and impls.any(func(info): (
				info.decl.trait_name.text == "CheckpointHidden"
				and types_equal(info.for_type, SemanticNamedType("CheckpointSecret", []))
			))
	)


func test_registers_generic_impl_bounds_from_for_type() -> Bool:
	source_program = program([
		trait_decl("CheckpointPrintable"),
		generic_record_decl("CheckpointBox", "T"),
		impl_decl(
			"CheckpointPrintable",
			generic_named_type("CheckpointBox", [named_type("T")]),
		),
	])
	result = typecheck_test_program(typecheck_state_for_origin(TYPECHECK_USER_ORIGIN), source_program)

	result.state.errors.length() == 0 and typed_impl_decls(result.program.decls).any(func(info): (
			types_equal(
				info.for_type,
				SemanticNamedType("CheckpointBox", [SemanticTypeVar("T", SemanticTypeParameter)]),
			)
			and info.type_params.map(bound_type_param_name) == ["T"]
		))


func test_registers_generic_impl_inline_trait_bounds() -> Bool:
	source_program = program([
		trait_decl("CheckpointPrintable"),
		trait_decl("CheckpointShowable"),
		generic_record_decl("CheckpointBox", "T"),
		impl_decl(
			"CheckpointPrintable",
			generic_named_type("CheckpointBox", [bounded_type("T", ["CheckpointShowable"])]),
		),
	])
	result = typecheck_test_program(typecheck_state_for_origin(TYPECHECK_USER_ORIGIN), source_program)

	result.state.errors.length() == 0 and typed_impl_decls(result.program.decls).any(func(info): (
			types_equal(
				info.for_type,
				SemanticNamedType("CheckpointBox", [SemanticTypeVar("T", SemanticTypeParameter)]),
			)
			and info.type_params.map(bound_type_param_name) == ["T"]
			and info.type_params.all(func(param): param.bounds == ["CheckpointShowable"])
		))


func test_impl_registration_reports_public_and_private_conflicts() -> Bool:
	public_program = program([
		trait_decl("CheckpointDisplay"),
		record_decl("CheckpointWidget"),
		impl_decl("CheckpointDisplay", named_type("CheckpointWidget")),
		impl_decl_at("CheckpointDisplay", named_type("CheckpointWidget"), 3),
	])
	public_state = typecheck_test_program(typecheck_state_for_origin(TYPECHECK_USER_ORIGIN), public_program).state

	private_program = program([
		trait_decl("CheckpointHidden"),
		record_decl("CheckpointSecret"),
		private_impl_decl("CheckpointHidden", named_type("CheckpointSecret")),
		private_impl_decl_at("CheckpointHidden", named_type("CheckpointSecret"), 3),
	])
	private_state = typecheck_test_program(typecheck_state_for_origin(TYPECHECK_USER_ORIGIN), private_program).state

	(
		public_state.errors.length() == 1
		and public_state.errors
			.get_or(0, "")
			.contains("conflicting implementation of trait 'CheckpointDisplay'")
		and private_state.errors.length() == 1
		and private_state.errors
			.get_or(0, "")
			.contains("conflicting implementation of trait 'CheckpointHidden'")
	)


func test_impl_method_body_reports_wrong_return_type() -> Bool:
	source_program = program([
		trait_decl("CheckpointDisplay"),
		record_decl("CheckpointWidget"),
		impl_decl_with_methods(
			"CheckpointDisplay",
			named_type("CheckpointWidget"),
			[
				function_decl_with_body(
					"show",
					[named_param("value", named_type("CheckpointWidget"))],
					Some(int_type()),
					string_expr(),
					False,
				),
			],
		),
	])
	state = typecheck_test_program(typecheck_state_for_origin(TYPECHECK_USER_ORIGIN), source_program).state

	(
		state.errors.length() == 1
		and state.errors
			.get_or(0, "")
			.contains("Function 'show' returns wrong type")
	)


func test_core_trait_is_visible_for_user_owned_impl() -> Bool:
	source_program = program([
		record_decl("CheckpointWidget"),
		impl_decl_with_methods(
			"Stringable",
			named_type("CheckpointWidget"),
			[
				function_decl_with_body(
					"to_string",
					[named_param("value", named_type("CheckpointWidget"))],
					Some(string_type()),
					string_expr(),
					True,
				),
			],
		),
	])
	state = typecheck_test_program(typecheck_state_for_origin(TYPECHECK_USER_ORIGIN), source_program).state

	state.errors.length() == 0


func test_pure_impl_method_body_rejects_impure_call() -> Bool:
	source_program = program([
		trait_decl("CheckpointDisplay"),
		record_decl("CheckpointWidget"),
		function_decl_parsed("impure_value", [], Some(int_type()), int_expr(), False),
		impl_decl_with_methods(
			"CheckpointDisplay",
			named_type("CheckpointWidget"),
			[function_decl_with_body(
					"show",
					[named_param("value", named_type("CheckpointWidget"))],
					Some(int_type()),
					call_expr("impure_value", []),
					True,
				)],
		),
	])
	state = typecheck_test_program(typecheck_state_for_origin(TYPECHECK_USER_ORIGIN), source_program).state

	(
		state.errors.length() == 1
		and state.errors
			.get_or(0, "")
			.contains("Pure function 'show' cannot call impure function 'impure_value'")
	)


func test_impl_validation_reports_unsatisfied_supertrait() -> Bool:
	source_program = program([
		trait_decl("CheckpointStringable"),
		trait_decl_with_details("CheckpointDisplay", ["CheckpointStringable"], []),
		record_decl("CheckpointWidget"),
		impl_decl("CheckpointDisplay", named_type("CheckpointWidget")),
	])
	state = typecheck_test_program(typecheck_state_for_origin(TYPECHECK_USER_ORIGIN), source_program).state

	(
		state.errors.length() == 1
		and state.errors
			.get_or(0, "")
			.contains((
					"impl CheckpointDisplay for CheckpointWidget: supertrait 'CheckpointStringable' "
					+ "is not implemented"
				))
	)


func test_impl_validation_accepts_explicit_supertrait_impl() -> Bool:
	source_program = program([
		trait_decl("CheckpointStringable"),
		trait_decl_with_details("CheckpointDisplay", ["CheckpointStringable"], []),
		record_decl("CheckpointWidget"),
		impl_decl("CheckpointStringable", named_type("CheckpointWidget")),
		impl_decl("CheckpointDisplay", named_type("CheckpointWidget")),
	])
	state = typecheck_test_program(typecheck_state_for_origin(TYPECHECK_USER_ORIGIN), source_program).state

	state.errors.length() == 0


func test_impl_validation_accepts_supertrait_from_inline_bound() -> Bool:
	source_program = program([
		trait_decl("CheckpointStringable"),
		trait_decl_with_details("CheckpointDisplay", ["CheckpointStringable"], []),
		impl_decl(
			"CheckpointDisplay",
			bounded_type("T", ["CheckpointStringable"]),
		),
	])
	state = typecheck_test_program(typecheck_state_for_origin(TYPECHECK_USER_ORIGIN), source_program).state

	state.errors.length() == 0


func test_impl_validation_reports_method_signature_mismatch() -> Bool:
	source_program = program([
		trait_decl_with_details(
			"CheckpointDisplay",
			[],
			[
				trait_method_decl(
					"show",
					[named_param("value", named_type("Self"))],
					Some(string_type()),
					True,
					False,
				),
			],
		),
		record_decl("CheckpointWidget"),
		impl_decl_with_methods(
			"CheckpointDisplay",
			named_type("CheckpointWidget"),
			[
				function_decl_with_body(
					"show",
					[named_param("value", int_type())],
					Some(string_type()),
					string_expr(),
					False,
				),
			],
		),
	])
	state = typecheck_test_program(typecheck_state_for_origin(TYPECHECK_USER_ORIGIN), source_program).state

	(
		state.errors.length() == 2
		and state.errors
			.get_or(0, "")
			.contains("impl CheckpointDisplay for CheckpointWidget: method 'show' must be pure")
		and state.errors
			.get_or(1, "")
			.contains((
					"impl CheckpointDisplay for CheckpointWidget: method 'show' parameter 'value' "
					+ "has type Int, trait requires CheckpointWidget"
				))
	)


tests: TestSuite = {
	description = "Compiler typecheck impl declaration indexing",
	tests = [
		(
			"registers public and private impl headers",
			test_registers_public_and_private_impl_headers,
		),
		(
			"registers generic impl bounds from for type",
			test_registers_generic_impl_bounds_from_for_type,
		),
		(
			"registers generic impl inline trait bounds",
			test_registers_generic_impl_inline_trait_bounds,
		),
		(
			"impl registration reports public and private conflicts",
			test_impl_registration_reports_public_and_private_conflicts,
		),
		(
			"impl method body reports wrong return type",
			test_impl_method_body_reports_wrong_return_type,
		),
		(
			"core trait is visible for user-owned impl",
			test_core_trait_is_visible_for_user_owned_impl,
		),
		(
			"pure impl method body rejects impure call",
			test_pure_impl_method_body_rejects_impure_call,
		),
		(
			"impl validation reports unsatisfied supertrait",
			test_impl_validation_reports_unsatisfied_supertrait,
		),
		(
			"impl validation accepts explicit supertrait impl",
			test_impl_validation_accepts_explicit_supertrait_impl,
		),
		(
			"impl validation accepts supertrait from inline bound",
			test_impl_validation_accepts_supertrait_from_inline_bound,
		),
		(
			"impl validation reports method signature mismatch",
			test_impl_validation_reports_method_signature_mismatch,
		),
	]
}
