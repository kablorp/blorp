import:
	../../../src/compiler/stage_06_typecheck/type_system/builtins: env_with_builtins
	../../../src/compiler/stage_06_typecheck/type_system/env:
		ENV_EMPTY,
		SymbolKind(ConstructorSymbolKind),
		env_add_symbol,
	../../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticType(SemanticNamedType, SemanticTypeVar),
		TYPE_INT,
		TYPE_STRING,
		types_equal,
	../../../src/compiler/stage_06_typecheck/type_system/union_type_index:
		AcceptedUnionEntry,
		AcceptedUnionVariantEntry,
		UNION_TYPE_INDEX_EMPTY,
		UnionTypeIndex,
		union_type_index_add,
		union_type_index_add_module,
		union_type_index_contains,
		union_type_index_entry_count,
		union_type_index_find,
		union_type_index_find_constructor,
		union_type_index_find_constructor_for_parent,
		union_type_index_find_module_constructor,
		union_type_index_find_module_constructor_symbol,
		union_type_index_find_module_constructor_symbol_for_parent,
		union_type_index_with_builtins_from_env,
		union_type_index_with_fallback,
		union_type_index_with_visible_constructor_bindings,
	test: TestSuite


private pure func variant(
	name: String,
	fields: List[SemanticType],
	tag: Int,
) -> AcceptedUnionVariantEntry:
	{
		name = name,
		constructor_id = tag + 100,
		fields = fields,
		tag = tag
	}


private pure func entry(
	type_params: List[String],
	variants: List[AcceptedUnionVariantEntry],
	is_enum: Bool,
) -> AcceptedUnionEntry:
	{
		type_params = type_params,
		variants = variants,
		is_enum = is_enum,
		contains_resource = False,
		may_contain_function = False,
		may_contain_one_shot_stream = False,
		may_contain_resource_source = False
	}


private pure func local_unions_shadow_fallback_for_exact_lookup() -> Bool:
	fallback = union_type_index_add(
		UNION_TYPE_INDEX_EMPTY,
		"Result",
		entry([], [variant("Old", [TYPE_INT], 0)], False),
	).get_or(UNION_TYPE_INDEX_EMPTY)
	local = union_type_index_add(
		UNION_TYPE_INDEX_EMPTY,
		"Result",
		entry([], [variant("Current", [TYPE_STRING], 1)], False),
	).get_or(UNION_TYPE_INDEX_EMPTY)
	index = union_type_index_with_fallback(local, fallback)

	match union_type_index_find(index, "Result"):
		Some(union_entry):
			match union_entry.variants.get(0):
				Some(found_variant):
					(
						found_variant.name == "Current"
						and found_variant.tag == 1
						and match found_variant.fields.get(0):
							Some(field_type):
								types_equal(field_type, TYPE_STRING)
							None:
								False
					)
				None:
					False
		None:
			False


private pure func generic_variant_fields_and_order_are_preserved() -> Bool:
	index = union_type_index_add(
		UNION_TYPE_INDEX_EMPTY,
		"Outcome",
		entry(
			["T"],
			[
				variant(
					"Success",
					[SemanticTypeVar("T"), TYPE_INT],
					4,
				),
				variant("Failure", [TYPE_STRING], 9),
			],
			False,
		),
	).get_or(UNION_TYPE_INDEX_EMPTY)

	match union_type_index_find(index, "Outcome"):
		Some(union_entry):
			(
				union_entry.type_params == ["T"]
				and union_entry.variants.length() == 2
				and match union_entry.variants.get(0):
					Some(success):
						(
							success.name == "Success"
							and success.tag == 4
							and success.fields.length() == 2
							and match success.fields.get(0):
								Some(field_type):
									types_equal(field_type, SemanticTypeVar("T"))
								None:
									False
						)
					None:
						False
				and match union_entry.variants.get(1):
					Some(failure):
						failure.name == "Failure" and failure.tag == 9
					None:
						False
			)
		None:
			False


private pure func enum_layout_is_preserved() -> Bool:
	index = union_type_index_add(
		UNION_TYPE_INDEX_EMPTY,
		"Color",
		entry(
			[],
			[variant("Red", [], 0), variant("Blue", [], 1)],
			True,
		),
	).get_or(UNION_TYPE_INDEX_EMPTY)

	match union_type_index_find(index, "Color"):
		Some(union_entry):
			(
				union_entry.is_enum
				and union_entry.variants.map(func(item): item.name) == ["Red", "Blue"]
			)
		None:
			False


private pure func duplicate_unions_fail_closed() -> Bool:
	index = union_type_index_add(
		UNION_TYPE_INDEX_EMPTY,
		"Choice",
		entry([], [variant("A", [], 0)], True),
	).get_or(UNION_TYPE_INDEX_EMPTY)

	union_type_index_add(
		index,
		"Choice",
		entry([], [variant("B", [], 1)], True),
	).is_none()


private pure func fallback_supports_exact_lookup_and_counting() -> Bool:
	fallback = union_type_index_add(
		UNION_TYPE_INDEX_EMPTY,
		"Shared",
		entry([], [variant("SharedValue", [], 0)], True),
	).get_or(UNION_TYPE_INDEX_EMPTY)
	index = union_type_index_with_fallback(UNION_TYPE_INDEX_EMPTY, fallback)

	(
		union_type_index_contains(index, "Shared")
		and not union_type_index_contains(index, "Missing")
		and union_type_index_entry_count(index) == 1
		and union_type_index_find(index, "Shared").is_some()
	)


private pure func containment_booleans_are_preserved() -> Bool:
	index = union_type_index_add(
		UNION_TYPE_INDEX_EMPTY,
		"Carrier",
		{
			type_params = [],
			variants = [variant("Payload", [SemanticNamedType("Fn", [])], 0)],
			is_enum = False,
			contains_resource = True,
			may_contain_function = True,
			may_contain_one_shot_stream = True,
			may_contain_resource_source = True
		},
	).get_or(UNION_TYPE_INDEX_EMPTY)

	match union_type_index_find(index, "Carrier"):
		Some(union_entry):
			(
				union_entry.contains_resource
				and union_entry.may_contain_function
				and union_entry.may_contain_one_shot_stream
				and union_entry.may_contain_resource_source
			)
		None:
			False


private pure func local_constructor_identity_and_shape_are_indexed() -> Bool:
	index = union_type_index_add(
		UNION_TYPE_INDEX_EMPTY,
		"Outcome",
		entry(["T"], [variant("Success", [SemanticTypeVar("T")], 4)], False),
	).get_or(UNION_TYPE_INDEX_EMPTY)

	match (
		union_type_index_find_constructor(index, "Success"),
		union_type_index_find_constructor_for_parent(index, "Outcome", "Success"),
	):
		(Some(constructor), Some(parent_constructor)):
			(
				constructor.constructor_id == 104
				and constructor.parent_type == "Outcome"
				and constructor.type_params == ["T"]
				and constructor.field_types.length() == 1
				and match constructor.field_types.get(0):
					Some(field_type):
						types_equal(field_type, SemanticTypeVar("T"))
					None:
						False
				and constructor.tag == 4
				and parent_constructor.constructor_id == constructor.constructor_id
			)
		_:
			False


private pure func qualified_constructor_lookup_uses_module_path() -> Bool:
	index = union_type_index_add_module(
		UNION_TYPE_INDEX_EMPTY,
		"dep",
		"dep__Mode",
		entry([], [variant("Ready", [], 2)], True),
	).get_or(UNION_TYPE_INDEX_EMPTY)

	(
		union_type_index_find_module_constructor(index, "dep", "Ready")
			.map(func(constructor): constructor.parent_type == "dep__Mode")
			.get_or(False)
		and union_type_index_find_module_constructor(index, "other", "Ready").is_none()
	)


private pure func visible_constructor_collisions_preserve_parent_candidates() -> Bool:
	with_fs = union_type_index_add_module(
		UNION_TYPE_INDEX_EMPTY,
		"fs",
		"fs::IOError",
		entry([], [variant("TimedOut", [], 1)], True),
	).get_or(UNION_TYPE_INDEX_EMPTY)
	with_tcp = union_type_index_add_module(
		with_fs,
		"net/tcp",
		"net/tcp::TcpError",
		entry([], [variant("TimedOut", [], 2)], True),
	).get_or(UNION_TYPE_INDEX_EMPTY)

	match (
		union_type_index_find_module_constructor_symbol(with_tcp, "fs", "TimedOut"),
		union_type_index_find_module_constructor_symbol(with_tcp, "net/tcp", "TimedOut"),
	):
		(Some(fs_symbol), Some(tcp_symbol)):
			visible = union_type_index_with_visible_constructor_bindings(
				with_tcp,
				[
					("TimedOut", "FsError", fs_symbol),
					("TimedOut", "TcpError", tcp_symbol),
					("TimedOut", "TcpError", tcp_symbol),
				],
			)

			(
				union_type_index_find_constructor(visible, "TimedOut")
					.map(func(constructor): constructor.parent_type == "fs::IOError")
					.get_or(False)
				and union_type_index_find_constructor_for_parent(
					visible,
					"FsError",
					"TimedOut",
				).is_some()
				and union_type_index_find_constructor_for_parent(
					visible,
					"TcpError",
					"TimedOut",
				).is_some()
			)
		_:
			False


private pure func module_constructor_parent_lookup_disambiguates_same_name() -> Bool:
	with_first = union_type_index_add_module(
		UNION_TYPE_INDEX_EMPTY,
		"errors",
		"errors::FirstError",
		entry([], [variant("Shared", [TYPE_INT], 1)], False),
	).get_or(UNION_TYPE_INDEX_EMPTY)
	with_second = union_type_index_add_module(
		with_first,
		"errors",
		"errors::SecondError",
		entry([], [variant("Shared", [TYPE_STRING], 2)], False),
	).get_or(UNION_TYPE_INDEX_EMPTY)

	match union_type_index_find_module_constructor_symbol_for_parent(
		with_second,
		"errors",
		"errors::FirstError",
		"Shared",
	):
		Some(symbol):
			match symbol.kind:
				ConstructorSymbolKind(constructor):
					(
						constructor.parent_type == "errors::FirstError"
						and constructor.constructor_id == 101
						and constructor.field_types
							.get(0)
							.map(func(field_type): types_equal(field_type, TYPE_INT))
							.get_or(False)
					)
				_:
					False
		None:
			False


private pure func builtin_union_projection_is_complete() -> Bool:
	match (
		union_type_index_with_builtins_from_env(
			UNION_TYPE_INDEX_EMPTY,
			env_with_builtins(ENV_EMPTY),
			["Option", "Result", "ConcurrencyError"],
		)
	):
		Ok(index):
			(
				union_type_index_find(index, "Option").is_some()
				and union_type_index_find_constructor_for_parent(index, "Option", "Some").is_some()
				and union_type_index_find_constructor_for_parent(index, "Result", "Err").is_some()
				and union_type_index_find_constructor_for_parent(
					index,
					"ConcurrencyError",
					"TaskFailed",
				).is_some()
			)
		Err(_):
			False


private pure func builtin_union_projection_rejects_missing_metadata() -> Bool:
	match union_type_index_with_builtins_from_env(
		UNION_TYPE_INDEX_EMPTY,
		env_with_builtins(ENV_EMPTY),
		["MissingBuiltinUnion"],
	):
		Err(message):
			message.contains("missing its builtin type declaration")
		Ok(_):
			False


private pure func builtin_union_projection_rejects_malformed_constructor() -> Bool:
	malformed_env = env_add_symbol(
		env_with_builtins(ENV_EMPTY),
		{
			name = "Some",
			kind = ConstructorSymbolKind({
				parent_type = "Option",
				constructor_id = 99999,
				type_params = ["T"],
				field_types = [TYPE_STRING],
				tag = 0,
			})
		},
	)

	match union_type_index_with_builtins_from_env(
		UNION_TYPE_INDEX_EMPTY,
		malformed_env,
		["Option"],
	):
		Err(message):
			message == "bootstrap constructor 'Option.Some' does not match its type declaration"
		Ok(_):
			False


private pure func source_intrinsic_shape_preserves_graph_constructor_ids() -> Bool:
	bootstrap_env = env_with_builtins(ENV_EMPTY)

	match union_type_index_with_builtins_from_env(
		UNION_TYPE_INDEX_EMPTY,
		bootstrap_env,
		["Option"],
	):
		Ok(bootstrap_index):
			match union_type_index_find(bootstrap_index, "Option"):
				Some(bootstrap_entry):
					source_entry = { bootstrap_entry |
						variants = bootstrap_entry.variants.map(
							func(
								variant,
							): { variant | constructor_id = variant.constructor_id + 10000 },
						)
					}
					source_index = union_type_index_add(
						UNION_TYPE_INDEX_EMPTY,
						"Option",
						source_entry,
					).get_or(UNION_TYPE_INDEX_EMPTY)

					match union_type_index_with_builtins_from_env(
						source_index,
						bootstrap_env,
						["Option"],
					):
						Ok(validated):
							match (
								union_type_index_find_constructor_for_parent(
									validated,
									"Option",
									"Some",
								),
								union_type_index_find_constructor_for_parent(
									validated,
									"Option",
									"None",
								),
							):
								(Some(some), Some(none)):
									match (
										source_entry.variants.get(0),
										source_entry.variants.get(1),
									):
										(Some(expected_some), Some(expected_none)):
											(
												some.constructor_id == expected_some.constructor_id
												and none.constructor_id == expected_none.constructor_id
											)
										_:
											False
								_:
									False
						Err(_):
							False
				None:
					False
		Err(_):
			False


tests: TestSuite = {
	description = "Compiler union type index",
	tests = [
		(
			"local unions shadow fallback for exact lookup",
			local_unions_shadow_fallback_for_exact_lookup,
		),
		(
			"generic variant fields and order are preserved",
			generic_variant_fields_and_order_are_preserved,
		),
		("enum layout is preserved", enum_layout_is_preserved),
		("duplicate unions fail closed", duplicate_unions_fail_closed),
		(
			"fallback supports exact lookup and counting",
			fallback_supports_exact_lookup_and_counting,
		),
		("containment booleans are preserved", containment_booleans_are_preserved),
		(
			"local constructor identity and shape are indexed",
			local_constructor_identity_and_shape_are_indexed,
		),
		(
			"qualified constructor lookup uses module path",
			qualified_constructor_lookup_uses_module_path,
		),
		(
			"visible constructor collisions preserve parent candidates",
			visible_constructor_collisions_preserve_parent_candidates,
		),
		(
			"module constructor parent lookup disambiguates same name",
			module_constructor_parent_lookup_disambiguates_same_name,
		),
		("builtin union projection is complete", builtin_union_projection_is_complete),
		(
			"builtin union projection rejects missing metadata",
			builtin_union_projection_rejects_missing_metadata,
		),
		(
			"builtin union projection rejects malformed constructor",
			builtin_union_projection_rejects_malformed_constructor,
		),
		(
			"source intrinsic shape preserves graph constructor IDs",
			source_intrinsic_shape_preserves_graph_constructor_ids,
		),
	]
}
