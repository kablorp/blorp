import:
	../../../src/lib/source:
		SourceSpan,
		source_advance,
		source_file,
		source_span,
		source_start,
	../../../src/compiler/stage_03_parse/parser_bridge as ParserBridge
	../../../src/compiler/stage_03_parse/source_ast_finalize: finalized_typecheck_program_ast
	../../../src/compiler/stage_04_modules/loaded_module:
		ANONYMOUS_IDENTITY,
		ModuleIdentity,
		ModuleOrigin(UserModule),
		loaded_module_identity,
		loaded_module_set,
		loaded_module_set_target,
		module_identity_for_program,
		module_load_candidate,
		resolved_module_identity_from_resolver,
	../../../src/compiler/stage_05_types/env: ENV_EMPTY
	../../../src/compiler/stage_05_types/generic_params: BoundTypeParam
	../../../src/compiler/stage_05_types/semantic_type:
		SemanticType(SemanticFunctionType, SemanticMetaType, SemanticNamedType, SemanticTypeVar),
	../../../src/compiler/stage_06_typecheck/graph/definition_identity:
		ExportedCallableKind(ExportedCallableFunction),
		ExportedSymbolKey,
		SourceDefinitionKind(FieldDefinition, TraitDefinition, TypeDefinition),
		exported_callable_symbol_key,
		exported_symbol_key_storage_key,
		exported_symbol_keys_equal,
		func_callable_key,
		func_callable_keys_equal,
		source_definition_key,
	../../../src/compiler/stage_06_typecheck/graph/definition_index:
		DefinitionIndex,
		DefinitionIndexConflict,
		definition_index_conflict_message,
		definition_index_empty,
		definition_index_find_func_callable_id,
		definition_index_find_source_definition_id,
		definition_index_func_callable_bindings,
		definition_index_func_callable_id_count,
		definition_index_initial_seed,
		definition_index_insert_func_callable_id,
		definition_index_insert_source_definition_id,
		definition_index_next_def_id,
	test: TestSuite


private pure func module_identity(canonical_path: String) -> ModuleIdentity:
	program = ParserBridge.parsed_typecheck_source_bridge_artifact(
		"shared.brp",
		canonical_path,
		"pure func render() -> Int:\n\t1",
		False,
	).program

	match loaded_module_set(
		module_load_candidate(
			resolved_module_identity_from_resolver(canonical_path, UserModule),
			program,
		),
		[],
	):
		Ok(modules):
			loaded_module_identity(loaded_module_set_target(modules))
		Err(_):
			ANONYMOUS_IDENTITY


private pure func shared_span() -> SourceSpan:
	source = source_file("shared.brp", "shared", "pure func render() -> Int:\n\t1")
	start = source_start(source)
	source_span(source, start, start)


private pure func shifted_span() -> SourceSpan:
	source = source_file("shared.brp", "shared", "pure func render() -> Int:\n\t1")
	start = source_start(source)
	shifted = source_advance(source, start)
	source_span(source, shifted, shifted)


private pure func direct_module_identity_with_name(
	path: String,
	module_name: String,
) -> ModuleIdentity:
	program = ParserBridge.parsed_typecheck_source_bridge_artifact(
		path,
		module_name,
		"pure func render() -> Int:\n\t1",
		False,
	).program
	module_identity_for_program(finalized_typecheck_program_ast(program))


private pure func direct_module_identity(path: String) -> ModuleIdentity:
	direct_module_identity_with_name(path, "shared")


private pure func empty_index() -> DefinitionIndex:
	seed = definition_index_initial_seed(ENV_EMPTY)
	definition_index_empty(seed)


private pure func conflict_message(error: DefinitionIndexConflict) -> String:
	definition_index_conflict_message(error)


pure func test_definition_keys_include_canonical_module_identity() -> Bool:
	span = shared_span()
	left = func_callable_key(module_identity("pkg/left"), "render", span)
	right = func_callable_key(module_identity("pkg/right"), "render", span)

	not func_callable_keys_equal(left, right)


private pure func type_param(name: String, bounds: List[String]) -> BoundTypeParam:
	{
		name = name,
		bounds = bounds
	}


private pure func callable_key(
	name: String,
	type_parameters: List[BoundTypeParam],
	function_type: SemanticType,
) -> Option[ExportedSymbolKey]:
	exported_callable_symbol_key(
		module_identity("pkg/render"),
		ExportedCallableFunction,
		None,
		name,
		type_parameters,
		function_type,
	)


private pure func export_keys_distinguish_semantic_overloads() -> Option[Bool]:
	int_type = SemanticNamedType("Int", [])
	string_type = SemanticNamedType("String", [])
	int_signature = SemanticFunctionType(True, [int_type], string_type)
	first ?= callable_key("render", [], int_signature)
	rebuilt ?= callable_key("render", [], int_signature)
	overload ?= callable_key(
		"render",
		[],
		SemanticFunctionType(True, [string_type], string_type),
	)
	Some(
		(
			exported_symbol_keys_equal(first, rebuilt)
			and not exported_symbol_keys_equal(first, overload)
			and exported_symbol_key_storage_key(first) == exported_symbol_key_storage_key(rebuilt)
			and exported_symbol_key_storage_key(first) != exported_symbol_key_storage_key(overload)
		),
	)


pure func test_export_keys_distinguish_semantic_overloads() -> Bool:
	export_keys_distinguish_semantic_overloads().get_or(False)


private pure func export_keys_alpha_normalize_generic_names_and_bounds() -> Option[Bool]:
	generic_t ?= callable_key(
		"identity",
		[
			type_param(
				"T",
				["Orderable", "Equatable"],
			),
		],
		SemanticFunctionType(
			True,
			[SemanticTypeVar("T")],
			SemanticTypeVar("T"),
		),
	)
	generic_u ?= callable_key(
		"identity",
		[
			type_param(
				"U",
				["Equatable", "Orderable"],
			),
		],
		SemanticFunctionType(
			True,
			[SemanticTypeVar("U")],
			SemanticTypeVar("U"),
		),
	)

	Some(
		(
			exported_symbol_keys_equal(generic_t, generic_u)
			and exported_symbol_key_storage_key(
				generic_t,
			) == exported_symbol_key_storage_key(generic_u)
		),
	)


pure func test_export_keys_alpha_normalize_generic_names_and_bounds() -> Bool:
	export_keys_alpha_normalize_generic_names_and_bounds().get_or(False)


pure func test_export_keys_reject_unresolved_semantic_types() -> Bool:
	callable_key(
		"unresolved",
		[],
		SemanticFunctionType(
			True,
			[SemanticMetaType(1)],
			SemanticNamedType("String", []),
		),
	).is_none()


pure func test_definition_index_accepts_repeated_identical_binding() -> Bool:
	key = func_callable_key(module_identity("pkg/render"), "render", shared_span())
	empty = empty_index()
	def_id = definition_index_next_def_id(empty)

	match definition_index_insert_func_callable_id(empty, key, def_id):
		Err(_):
			False
		Ok(first):
			match definition_index_insert_func_callable_id(first, key, def_id):
				Err(_):
					False
				Ok(repeated):
					(
						definition_index_func_callable_id_count(repeated) == 1
						and definition_index_find_func_callable_id(repeated, key) == Some(def_id)
					)


pure func test_definition_index_module_bucket_collision_preserves_exact_identity() -> Bool:
	span = shared_span()
	left = func_callable_key(direct_module_identity("pkg/left/shared.brp"), "render", span)
	right = func_callable_key(direct_module_identity("pkg/right/shared.brp"), "render", span)
	empty = empty_index()
	left_id = definition_index_next_def_id(empty)

	match definition_index_insert_func_callable_id(empty, left, left_id):
		Err(_):
			False
		Ok(with_left):
			right_id = definition_index_next_def_id(with_left)

			match definition_index_insert_func_callable_id(with_left, right, right_id):
				Err(_):
					False
				Ok(with_both):
					(
						definition_index_find_func_callable_id(with_both, left) == Some(left_id)
						and definition_index_find_func_callable_id(
							with_both,
							right,
						) == Some(right_id)
					)


pure func test_definition_index_name_bucket_preserves_callable_overloads() -> Bool:
	identity = module_identity("pkg/render")
	first = func_callable_key(identity, "render", shared_span())
	second = func_callable_key(identity, "render", shifted_span())
	empty = empty_index()
	first_id = definition_index_next_def_id(empty)

	match definition_index_insert_func_callable_id(empty, first, first_id):
		Err(_):
			False
		Ok(with_first):
			second_id = definition_index_next_def_id(with_first)

			match definition_index_insert_func_callable_id(with_first, second, second_id):
				Err(_):
					False
				Ok(index):
					(
						definition_index_find_func_callable_id(with_first, second).is_none()
						and definition_index_find_func_callable_id(index, first) == Some(first_id)
						and definition_index_find_func_callable_id(index, second) == Some(second_id)
					)


pure func test_definition_index_name_bucket_preserves_source_identity() -> Bool:
	identity = module_identity("pkg/source")
	type_key = source_definition_key(identity, TypeDefinition, "Entry", None, shared_span())
	field_key = source_definition_key(
		identity,
		FieldDefinition,
		"Entry",
		Some("Container"),
		shared_span(),
	)
	other_owner_key = source_definition_key(
		identity,
		FieldDefinition,
		"Entry",
		Some("Other"),
		shared_span(),
	)
	empty = empty_index()
	type_id = definition_index_next_def_id(empty)

	match definition_index_insert_source_definition_id(empty, type_key, type_id):
		Err(_):
			False
		Ok(with_type):
			field_id = definition_index_next_def_id(with_type)

			match definition_index_insert_source_definition_id(with_type, field_key, field_id):
				Err(_):
					False
				Ok(index):
					(
						definition_index_find_source_definition_id(index, type_key) == Some(type_id)
						and definition_index_find_source_definition_id(
							index,
							field_key,
						) == Some(field_id)
						and definition_index_find_source_definition_id(
							index,
							other_owner_key,
						).is_none()
					)


pure func test_definition_index_name_bindings_preserve_insertion_order() -> Bool:
	span = shared_span()
	first = func_callable_key(
		direct_module_identity_with_name("pkg/first-a.brp", "group-a"),
		"render",
		span,
	)
	middle = func_callable_key(
		direct_module_identity_with_name("pkg/middle.brp", "group-b"),
		"render",
		span,
	)
	last = func_callable_key(
		direct_module_identity_with_name("pkg/last-a.brp", "group-a"),
		"render",
		span,
	)
	empty = empty_index()
	first_id = definition_index_next_def_id(empty)

	match definition_index_insert_func_callable_id(empty, first, first_id):
		Err(_):
			False
		Ok(with_first):
			middle_id = definition_index_next_def_id(with_first)

			match definition_index_insert_func_callable_id(with_first, middle, middle_id):
				Err(_):
					False
				Ok(with_middle):
					last_id = definition_index_next_def_id(with_middle)

					match definition_index_insert_func_callable_id(with_middle, last, last_id):
						Err(_):
							False
						Ok(index):
							definition_index_func_callable_bindings(
								index,
								"render",
							).map(
								func(binding): binding[1],
							) == [first_id, middle_id, last_id]


pure func test_definition_index_rejects_key_remapping() -> Bool:
	key = func_callable_key(module_identity("pkg/render"), "render", shared_span())
	empty = empty_index()
	def_id = definition_index_next_def_id(empty)

	match definition_index_insert_func_callable_id(empty, key, def_id):
		Err(_):
			False
		Ok(first):
			match definition_index_insert_func_callable_id(first, key, def_id + 1):
				Ok(_):
					False
				Err(error):
					(
						conflict_message(
							error,
						).contains("already maps to definition ID " + def_id.to_string())
						and definition_index_find_func_callable_id(first, key) == Some(def_id)
					)


pure func test_definition_index_rejects_definition_id_reuse() -> Bool:
	span = shared_span()
	left = func_callable_key(module_identity("pkg/left"), "render", span)
	right = func_callable_key(module_identity("pkg/right"), "render", span)
	empty = empty_index()
	def_id = definition_index_next_def_id(empty)

	match definition_index_insert_func_callable_id(empty, left, def_id):
		Err(_):
			False
		Ok(first):
			match definition_index_insert_func_callable_id(first, right, def_id):
				Ok(_):
					False
				Err(error):
					(
						conflict_message(
							error,
						).contains(
							"definition ID " + def_id.to_string() + " is below allocation frontier " + (def_id + 1).to_string(),
						)
						and definition_index_find_func_callable_id(first, left) == Some(def_id)
						and definition_index_find_func_callable_id(first, right).is_none()
					)


pure func test_definition_index_rejects_source_definition_id_reuse() -> Bool:
	span = shared_span()
	left = source_definition_key(
		module_identity("pkg/left"),
		TraitDefinition,
		"Renderable",
		None,
		span,
	)
	right = source_definition_key(
		module_identity("pkg/right"),
		TraitDefinition,
		"Renderable",
		None,
		span,
	)
	empty = empty_index()
	def_id = definition_index_next_def_id(empty)

	match definition_index_insert_source_definition_id(empty, left, def_id):
		Err(_):
			False
		Ok(first):
			definition_index_insert_source_definition_id(first, right, def_id).is_err()


pure func test_definition_index_rejects_cross_kind_id_reuse() -> Bool:
	span = shared_span()
	callable = func_callable_key(module_identity("pkg/callable"), "render", span)
	source = source_definition_key(
		module_identity("pkg/source"),
		TraitDefinition,
		"Renderable",
		None,
		span,
	)
	empty = empty_index()
	def_id = definition_index_next_def_id(empty)

	callable_then_source = match definition_index_insert_func_callable_id(empty, callable, def_id):
		Err(_):
			False
		Ok(first):
			definition_index_insert_source_definition_id(first, source, def_id).is_err()

	source_then_callable = match definition_index_insert_source_definition_id(
		empty,
		source,
		def_id,
	):
		Err(_):
			False
		Ok(first):
			definition_index_insert_func_callable_id(first, callable, def_id).is_err()

	callable_then_source and source_then_callable


tests: TestSuite = {
	description = "Compiler definition index module identity",
	tests = [
		(
			"definition keys include canonical module identity",
			test_definition_keys_include_canonical_module_identity,
		),
		(
			"export keys distinguish semantic overloads",
			test_export_keys_distinguish_semantic_overloads,
		),
		(
			"export keys alpha-normalize generic names and bounds",
			test_export_keys_alpha_normalize_generic_names_and_bounds,
		),
		(
			"export keys reject unresolved semantic types",
			test_export_keys_reject_unresolved_semantic_types,
		),
		(
			"repeated identical bindings are idempotent",
			test_definition_index_accepts_repeated_identical_binding,
		),
		(
			"module lookup buckets preserve exact identity under display-name collisions",
			test_definition_index_module_bucket_collision_preserves_exact_identity,
		),
		(
			"name buckets preserve callable overloads",
			test_definition_index_name_bucket_preserves_callable_overloads,
		),
		(
			"name buckets preserve source-definition identity",
			test_definition_index_name_bucket_preserves_source_identity,
		),
		(
			"name-wide bindings preserve insertion order across module buckets",
			test_definition_index_name_bindings_preserve_insertion_order,
		),
		("definition keys cannot be remapped", test_definition_index_rejects_key_remapping),
		("definition IDs cannot be reused", test_definition_index_rejects_definition_id_reuse),
		(
			"source definition IDs cannot be reused",
			test_definition_index_rejects_source_definition_id_reuse,
		),
		(
			"definition IDs cannot be reused across key kinds",
			test_definition_index_rejects_cross_kind_id_reuse,
		),
	]
}
