private pure func module_identity(canonical_path: String) -> ModuleIdentity:
	program = TypecheckTestSupport.finalized_typecheck_program_fixture(
		"shared.brp",
		canonical_path,
		"pure func render() -> Int:\n\t1",
	)

	match loaded_module_set(
		module_load_candidate(
			resolved_module_identity_from_resolver(canonical_path, UserModule),
			program,
		),
		[],
	):
		Ok(modules):
			loaded_module_identity(loaded_module_set_target(modules))
		Err(_):
			ANONYMOUS_IDENTITY


private pure func shared_span() -> SourceSpan:
	source = source_file("shared.brp", "shared", "pure func render() -> Int:\n\t1")
	start = source_start(source)
	source_span(source, start, start)


private pure func shifted_span() -> SourceSpan:
	source = source_file("shared.brp", "shared", "pure func render() -> Int:\n\t1")
	start = source_start(source)
	shifted = source_advance(source, start)
	source_span(source, shifted, shifted)


private record DefinitionTestDomain {
	module_table: ModuleTable,
	left: ModuleId,
	right: ModuleId,
	render: ModuleId,
	source: ModuleId,
	callable: ModuleId,
	first: ModuleId,
	middle: ModuleId,
	last: ModuleId
}


private pure func definition_test_domain() -> Option[DefinitionTestDomain]:
	paths = [
		"pkg/left",
		"pkg/right",
		"pkg/render",
		"pkg/source",
		"pkg/callable",
		"pkg/first",
		"pkg/middle",
		"pkg/last",
	]
	module_table ?= module_table(
		paths.map(func(path):
			resolved_module_identity_from_resolver(path, UserModule)
		),
	).to_option()
	left ?= module_table_find_id_by_canonical_path(module_table, "pkg/left")
	right ?= module_table_find_id_by_canonical_path(module_table, "pkg/right")
	render ?= module_table_find_id_by_canonical_path(module_table, "pkg/render")
	source ?= module_table_find_id_by_canonical_path(module_table, "pkg/source")
	callable ?= module_table_find_id_by_canonical_path(module_table, "pkg/callable")
	first ?= module_table_find_id_by_canonical_path(module_table, "pkg/first")
	middle ?= module_table_find_id_by_canonical_path(module_table, "pkg/middle")
	last ?= module_table_find_id_by_canonical_path(module_table, "pkg/last")
	Some({
		module_table = module_table,
		left = left,
		right = right,
		render = render,
		source = source,
		callable = callable,
		first = first,
		middle = middle,
		last = last,
	})


private pure func empty_index(domain: DefinitionTestDomain) -> DefinitionIndex:
	seed = definition_index_initial_seed(ENV_EMPTY)
	definition_index_empty(seed, domain.module_table)


private pure func insert_func_callable_id(
	index: DefinitionIndex,
	key: FuncCallableKey,
	def_id: Int,
) -> Result[DefinitionIndex, DefinitionIndexConflict]:
	definition_index_insert_func_callable_id(
		index,
		definition_index_module_table(index),
		key,
		def_id,
	)


private pure func insert_source_definition_id(
	index: DefinitionIndex,
	key: SourceDefinitionKey,
	def_id: Int,
) -> Result[DefinitionIndex, DefinitionIndexConflict]:
	definition_index_insert_source_definition_id(
		index,
		definition_index_module_table(index),
		key,
		def_id,
	)


private pure func find_func_callable_id(
	index: DefinitionIndex,
	key: FuncCallableKey,
) -> Option[Int]:
	definition_index_find_func_callable_id(index, definition_index_module_table(index), key)


private pure func find_source_definition_id(
	index: DefinitionIndex,
	key: SourceDefinitionKey,
) -> Option[Int]:
	definition_index_find_source_definition_id(index, definition_index_module_table(index), key)


private pure func conflict_message(
	index: DefinitionIndex,
	error: DefinitionIndexConflict,
) -> String:
	definition_index_conflict_message(index, error)


private pure func definition_keys_include_canonical_module_identity() -> Option[Bool]:
	domain ?= definition_test_domain()
	span = shared_span()
	left = func_callable_key(domain.left, "render", span)
	right = func_callable_key(domain.right, "render", span)

	Some(not func_callable_keys_equal(left, right))


pure func test_definition_keys_include_canonical_module_identity() -> Bool:
	definition_keys_include_canonical_module_identity().get_or(False)


private pure func type_param(name: String, bounds: List[String]) -> BoundTypeParam:
	make_bound_type_param(name, bounds)


private pure func callable_key(
	name: String,
	type_parameters: List[BoundTypeParam],
	function_type: SemanticType,
) -> Option[ExportedSymbolKey]:
	exported_callable_symbol_key(
		module_identity("pkg/render"),
		ExportedCallableFunction,
		None,
		name,
		type_parameters,
		function_type,
	)


private pure func export_keys_distinguish_semantic_overloads() -> Option[Bool]:
	int_type = SemanticNamedType("Int", [])
	string_type = SemanticNamedType("String", [])
	int_signature = SemanticFunctionType(True, [int_type], string_type)
	first ?= callable_key("render", [], int_signature)
	rebuilt ?= callable_key("render", [], int_signature)
	overload ?= callable_key(
		"render",
		[],
		SemanticFunctionType(True, [string_type], string_type),
	)
	Some(
		(
			exported_symbol_keys_equal(first, rebuilt)
			and not exported_symbol_keys_equal(first, overload)
			and exported_symbol_key_storage_key(first) == exported_symbol_key_storage_key(rebuilt)
			and exported_symbol_key_storage_key(first) != exported_symbol_key_storage_key(overload)
		),
	)


pure func test_export_keys_distinguish_semantic_overloads() -> Bool:
	export_keys_distinguish_semantic_overloads().get_or(False)


private pure func export_keys_alpha_normalize_generic_names_and_bounds() -> Option[Bool]:
	generic_t ?= callable_key(
		"identity",
		[
			type_param(
				"T",
				["Orderable", "Equatable"],
			),
		],
		SemanticFunctionType(
			True,
			[SemanticTypeVar("T")],
			SemanticTypeVar("T"),
		),
	)
	generic_u ?= callable_key(
		"identity",
		[
			type_param(
				"U",
				["Equatable", "Orderable"],
			),
		],
		SemanticFunctionType(
			True,
			[SemanticTypeVar("U")],
			SemanticTypeVar("U"),
		),
	)

	Some(
		(
			exported_symbol_keys_equal(generic_t, generic_u)
			and exported_symbol_key_storage_key(
				generic_t,
			) == exported_symbol_key_storage_key(generic_u)
		),
	)


pure func test_export_keys_alpha_normalize_generic_names_and_bounds() -> Bool:
	export_keys_alpha_normalize_generic_names_and_bounds().get_or(False)


pure func test_export_keys_reject_unresolved_semantic_types() -> Bool:
	callable_key(
		"unresolved",
		[],
		SemanticFunctionType(
			True,
			[SemanticMetaType(1)],
			SemanticNamedType("String", []),
		),
	).is_none()


private pure func definition_index_accepts_repeated_identical_binding() -> Option[Bool]:
	domain ?= definition_test_domain()
	key = func_callable_key(domain.render, "render", shared_span())
	empty = empty_index(domain)
	def_id = definition_index_next_def_id(empty)

	match insert_func_callable_id(empty, key, def_id):
		Err(_):
			Some(False)
		Ok(first):
			match insert_func_callable_id(first, key, def_id):
				Err(_):
					Some(False)
				Ok(repeated):
					Some(
						(
							definition_index_func_callable_id_count(repeated) == 1
							and find_func_callable_id(repeated, key) == Some(def_id)
						),
					)


pure func test_definition_index_accepts_repeated_identical_binding() -> Bool:
	definition_index_accepts_repeated_identical_binding().get_or(False)


private pure func definition_index_module_bucket_collision_preserves_exact_identity(

) -> Option[Bool]:
	domain ?= definition_test_domain()
	span = shared_span()
	left = func_callable_key(domain.left, "render", span)
	right = func_callable_key(domain.right, "render", span)
	empty = empty_index(domain)
	left_id = definition_index_next_def_id(empty)

	match insert_func_callable_id(empty, left, left_id):
		Err(_):
			Some(False)
		Ok(with_left):
			right_id = definition_index_next_def_id(with_left)

			match insert_func_callable_id(with_left, right, right_id):
				Err(_):
					Some(False)
				Ok(with_both):
					Some(
						(
							find_func_callable_id(with_both, left) == Some(left_id)
							and find_func_callable_id(with_both, right) == Some(right_id)
						),
					)


pure func test_definition_index_module_bucket_collision_preserves_exact_identity() -> Bool:
	definition_index_module_bucket_collision_preserves_exact_identity().get_or(False)


private pure func definition_index_name_bucket_preserves_callable_overloads() -> Option[Bool]:
	domain ?= definition_test_domain()
	first = func_callable_key(domain.render, "render", shared_span())
	second = func_callable_key(domain.render, "render", shifted_span())
	empty = empty_index(domain)
	first_id = definition_index_next_def_id(empty)

	match insert_func_callable_id(empty, first, first_id):
		Err(_):
			Some(False)
		Ok(with_first):
			second_id = definition_index_next_def_id(with_first)

			match insert_func_callable_id(with_first, second, second_id):
				Err(_):
					Some(False)
				Ok(index):
					Some(
						(
							find_func_callable_id(with_first, second).is_none()
							and find_func_callable_id(index, first) == Some(first_id)
							and find_func_callable_id(index, second) == Some(second_id)
						),
					)


pure func test_definition_index_name_bucket_preserves_callable_overloads() -> Bool:
	definition_index_name_bucket_preserves_callable_overloads().get_or(False)


private pure func definition_index_name_bucket_preserves_source_identity() -> Option[Bool]:
	domain ?= definition_test_domain()
	type_key = source_definition_key(domain.source, TypeDefinition, "Entry", None, shared_span())
	field_key = source_definition_key(
		domain.source,
		FieldDefinition,
		"Entry",
		Some("Container"),
		shared_span(),
	)
	other_owner_key = source_definition_key(
		domain.source,
		FieldDefinition,
		"Entry",
		Some("Other"),
		shared_span(),
	)
	empty = empty_index(domain)
	type_id = definition_index_next_def_id(empty)

	match insert_source_definition_id(empty, type_key, type_id):
		Err(_):
			Some(False)
		Ok(with_type):
			field_id = definition_index_next_def_id(with_type)

			match insert_source_definition_id(with_type, field_key, field_id):
				Err(_):
					Some(False)
				Ok(index):
					Some(
						(
							find_source_definition_id(index, type_key) == Some(type_id)
							and find_source_definition_id(index, field_key) == Some(field_id)
							and find_source_definition_id(index, other_owner_key).is_none()
						),
					)


pure func test_definition_index_name_bucket_preserves_source_identity() -> Bool:
	definition_index_name_bucket_preserves_source_identity().get_or(False)


private pure func definition_index_name_bindings_preserve_insertion_order() -> Option[Bool]:
	domain ?= definition_test_domain()
	span = shared_span()
	first = func_callable_key(domain.first, "render", span)
	middle = func_callable_key(domain.middle, "render", span)
	last = func_callable_key(domain.last, "render", shifted_span())
	empty = empty_index(domain)
	first_id = definition_index_next_def_id(empty)

	match insert_func_callable_id(empty, first, first_id):
		Err(_):
			Some(False)
		Ok(with_first):
			middle_id = definition_index_next_def_id(with_first)

			match insert_func_callable_id(with_first, middle, middle_id):
				Err(_):
					Some(False)
				Ok(with_middle):
					last_id = definition_index_next_def_id(with_middle)

					match insert_func_callable_id(with_middle, last, last_id):
						Err(_):
							Some(False)
						Ok(index):
							Some(
								definition_index_func_callable_bindings(
									index,
									"render",
								).map(
									func(binding): binding[1],
								) == [first_id, middle_id, last_id],
							)


pure func test_definition_index_name_bindings_preserve_insertion_order() -> Bool:
	definition_index_name_bindings_preserve_insertion_order().get_or(False)


private pure func definition_index_rejects_key_remapping() -> Option[Bool]:
	domain ?= definition_test_domain()
	key = func_callable_key(domain.render, "render", shared_span())
	empty = empty_index(domain)
	def_id = definition_index_next_def_id(empty)

	match insert_func_callable_id(empty, key, def_id):
		Err(_):
			Some(False)
		Ok(first):
			match insert_func_callable_id(first, key, def_id + 1):
				Ok(_):
					Some(False)
				Err(error):
					default_message = conflict_message(first, error)
					direct_message = definition_index_conflict_message_for_module(
						first,
						error,
						domain.render,
						"app",
					)
					Some(
						(
							default_message.contains("callable 'render' in module 'pkg/render'")
							and direct_message.contains("callable 'render' in module 'app'")
							and not direct_message.contains("pkg/render")
							and direct_message.contains(
								"already maps to definition ID " + def_id.to_string(),
							)
							and find_func_callable_id(first, key) == Some(def_id)
						),
					)


pure func test_definition_index_rejects_key_remapping() -> Bool:
	definition_index_rejects_key_remapping().get_or(False)


private pure func definition_index_rejects_definition_id_reuse() -> Option[Bool]:
	domain ?= definition_test_domain()
	span = shared_span()
	left = func_callable_key(domain.left, "render", span)
	right = func_callable_key(domain.right, "render", span)
	empty = empty_index(domain)
	def_id = definition_index_next_def_id(empty)

	match insert_func_callable_id(empty, left, def_id):
		Err(_):
			Some(False)
		Ok(first):
			match insert_func_callable_id(first, right, def_id):
				Ok(_):
					Some(False)
				Err(error):
					Some(
						(
							conflict_message(
								first,
								error,
							).contains(
								"definition ID " + def_id.to_string() + " is below allocation frontier " + (def_id + 1).to_string(),
							)
							and find_func_callable_id(first, left) == Some(def_id)
							and find_func_callable_id(first, right).is_none()
						),
					)


pure func test_definition_index_rejects_definition_id_reuse() -> Bool:
	definition_index_rejects_definition_id_reuse().get_or(False)


private pure func definition_index_rejects_source_definition_id_reuse() -> Option[Bool]:
	domain ?= definition_test_domain()
	span = shared_span()
	left = source_definition_key(domain.left, TraitDefinition, "Renderable", None, span)
	right = source_definition_key(domain.right, TraitDefinition, "Renderable", None, span)
	empty = empty_index(domain)
	def_id = definition_index_next_def_id(empty)

	match insert_source_definition_id(empty, left, def_id):
		Err(_):
			Some(False)
		Ok(first):
			Some(insert_source_definition_id(first, right, def_id).is_err())


pure func test_definition_index_rejects_source_definition_id_reuse() -> Bool:
	definition_index_rejects_source_definition_id_reuse().get_or(False)


private pure func definition_index_rejects_cross_kind_id_reuse() -> Option[Bool]:
	domain ?= definition_test_domain()
	span = shared_span()
	callable = func_callable_key(domain.callable, "render", span)
	source = source_definition_key(domain.source, TraitDefinition, "Renderable", None, span)
	empty = empty_index(domain)
	def_id = definition_index_next_def_id(empty)

	callable_then_source = match insert_func_callable_id(empty, callable, def_id):
		Err(_):
			False
		Ok(first):
			insert_source_definition_id(first, source, def_id).is_err()

	source_then_callable = match insert_source_definition_id(empty, source, def_id):
		Err(_):
			False
		Ok(first):
			insert_func_callable_id(first, callable, def_id).is_err()

	Some(callable_then_source and source_then_callable)


pure func test_definition_index_rejects_cross_kind_id_reuse() -> Bool:
	definition_index_rejects_cross_kind_id_reuse().get_or(False)


tests: TestSuite = {
	description = "Compiler definition index module identity",
	tests = [
		(
			"definition keys include canonical module identity",
			test_definition_keys_include_canonical_module_identity,
		),
		(
			"export keys distinguish semantic overloads",
			test_export_keys_distinguish_semantic_overloads,
		),
		(
			"export keys alpha-normalize generic names and bounds",
			test_export_keys_alpha_normalize_generic_names_and_bounds,
		),
		(
			"export keys reject unresolved semantic types",
			test_export_keys_reject_unresolved_semantic_types,
		),
		(
			"repeated identical bindings are idempotent",
			test_definition_index_accepts_repeated_identical_binding,
		),
		(
			"module lookup buckets preserve exact identity under display-name collisions",
			test_definition_index_module_bucket_collision_preserves_exact_identity,
		),
		(
			"name buckets preserve callable overloads",
			test_definition_index_name_bucket_preserves_callable_overloads,
		),
		(
			"name buckets preserve source-definition identity",
			test_definition_index_name_bucket_preserves_source_identity,
		),
		(
			"name-wide bindings preserve insertion order across module buckets",
			test_definition_index_name_bindings_preserve_insertion_order,
		),
		("definition keys cannot be remapped", test_definition_index_rejects_key_remapping),
		("definition IDs cannot be reused", test_definition_index_rejects_definition_id_reuse),
		(
			"source definition IDs cannot be reused",
			test_definition_index_rejects_source_definition_id_reuse,
		),
		(
			"definition IDs cannot be reused across key kinds",
			test_definition_index_rejects_cross_kind_id_reuse,
		),
	]
}
