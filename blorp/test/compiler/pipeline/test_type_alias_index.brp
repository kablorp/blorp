import:
	../../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticType(SemanticNamedType),
		TYPE_INT,
		TYPE_STRING,
		types_equal,
	../../../src/compiler/stage_06_typecheck/type_system/type_alias_index:
		TYPE_ALIAS_INDEX_EMPTY,
		type_alias_index_add_opaque,
		type_alias_index_add_transparent,
		type_alias_index_entry_count,
		type_alias_index_find_opaque,
		type_alias_index_resolve,
		type_alias_index_resolve_head,
		type_alias_index_with_fallback,
	test: TestSuite


private pure func transparent_aliases_expand_with_substitution() -> Bool:
	with_box = type_alias_index_add_transparent(
		TYPE_ALIAS_INDEX_EMPTY,
		"Box",
		["T"],
		SemanticNamedType("List", [SemanticNamedType("T", [])]),
	).get_or(TYPE_ALIAS_INDEX_EMPTY)
	index = type_alias_index_add_transparent(
		with_box,
		"Name",
		[],
		TYPE_STRING,
	).get_or(TYPE_ALIAS_INDEX_EMPTY)

	type_alias_index_entry_count(index) == 2 and types_equal(
		type_alias_index_resolve(
			index,
			SemanticNamedType("Box", [TYPE_INT]),
		),
		SemanticNamedType("List", [TYPE_INT]),
	) and types_equal(
		type_alias_index_resolve_head(
			index,
			SemanticNamedType("Name", []),
		),
		TYPE_STRING,
	)


private pure func opaque_aliases_do_not_expand() -> Bool:
	index = type_alias_index_add_opaque(
		TYPE_ALIAS_INDEX_EMPTY,
		"Secret",
		[],
		TYPE_STRING,
		Some("pkg/secret"),
	).get_or(TYPE_ALIAS_INDEX_EMPTY)
	opaque_entry = type_alias_index_find_opaque(index, "Secret")

	types_equal(
		type_alias_index_resolve(
			index,
			SemanticNamedType("Secret", []),
		),
		SemanticNamedType("Secret", []),
	) and match opaque_entry:
		Some(alias_entry):
			alias_entry.home_module == Some("pkg/secret")
		None:
			False


private pure func duplicate_alias_names_fail_closed() -> Bool:
	index = type_alias_index_add_transparent(
		TYPE_ALIAS_INDEX_EMPTY,
		"Alias",
		[],
		TYPE_INT,
	).get_or(TYPE_ALIAS_INDEX_EMPTY)

	(
		type_alias_index_add_transparent(index, "Alias", [], TYPE_STRING).is_none()
		and type_alias_index_add_opaque(index, "Alias", [], TYPE_STRING, None).is_none()
	)


private pure func alias_cycles_stop_at_the_original_shape() -> Bool:
	with_left = type_alias_index_add_transparent(
		TYPE_ALIAS_INDEX_EMPTY,
		"Left",
		[],
		SemanticNamedType("Right", []),
	).get_or(TYPE_ALIAS_INDEX_EMPTY)
	index = type_alias_index_add_transparent(
		with_left,
		"Right",
		[],
		SemanticNamedType("Left", []),
	).get_or(TYPE_ALIAS_INDEX_EMPTY)

	types_equal(
		type_alias_index_resolve(
			index,
			SemanticNamedType("Left", []),
		),
		SemanticNamedType("Left", []),
	)


private pure func local_aliases_resolve_through_shared_canonical_fallback() -> Bool:
	canonical = type_alias_index_add_transparent(
		TYPE_ALIAS_INDEX_EMPTY,
		"pkg__Name",
		[],
		TYPE_STRING,
	).get_or(TYPE_ALIAS_INDEX_EMPTY)
	local = type_alias_index_add_transparent(
		TYPE_ALIAS_INDEX_EMPTY,
		"Name",
		[],
		SemanticNamedType("pkg__Name", []),
	).get_or(TYPE_ALIAS_INDEX_EMPTY)
	index = type_alias_index_with_fallback(local, canonical)

	type_alias_index_entry_count(index) == 2 and types_equal(
		type_alias_index_resolve(
			index,
			SemanticNamedType("Name", []),
		),
		TYPE_STRING,
	)


tests: TestSuite = {
	description = "Compiler type alias index",
	tests = [
		(
			"transparent aliases expand with substitution",
			transparent_aliases_expand_with_substitution,
		),
		("opaque aliases do not expand", opaque_aliases_do_not_expand),
		("duplicate alias names fail closed", duplicate_alias_names_fail_closed),
		("alias cycles stop at the original shape", alias_cycles_stop_at_the_original_shape),
		(
			"local aliases resolve through shared canonical fallback",
			local_aliases_resolve_through_shared_canonical_fallback,
		),
	]
}
