import:
	../../../../compiler/benchmarks/compiler_infer_session_reconstruction_profile:
		compiler_infer_session_reconstruction_profile,
	test: TestSuite


private func test_fresh_body_state_construction_counters_are_equivalent() -> Bool:
	result = compiler_infer_session_reconstruction_profile(5)

	(
		result.iterations == 5
		and result.session_reconstruction_count == 5
		and result.direct_state_construction_count == 5
		and result.baseline.checksum == result.direct.checksum
		and result.workload_valid
	)


tests: TestSuite = {
	description = "Compiler infer session reconstruction profile benchmark",
	tests = [
		(
			"fresh body state construction counters are equivalent",
			test_fresh_body_state_construction_counters_are_equivalent,
		),
	]
}
