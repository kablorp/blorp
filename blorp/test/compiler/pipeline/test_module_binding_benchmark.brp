import:
	../../../benchmark/compiler/compiler_module_binding_profile_fixture:
		CompilerModuleBindingBenchmarkConfig,
		compiler_module_binding_benchmark,
	../../../benchmark/compiler/compiler_visibility_width_profile_fixture:
		VisibilityWidthConfig,
		visibility_width_run,
		visibility_width_run_with_foreign_current_module_for_test,
	test: TestSuite


private func test_module_binding_fixture_counts_exact_workload() -> Bool:
	result = compiler_module_binding_benchmark({
		iterations = 1,
		module_count = 4,
		exports_per_module = 3,
	})

	(
		result.module_path_probe_count == 4
		and result.exact_path_probe_count == 2
		and result.alternate_name_probe_count == 2
		and result.baseline_alternate_name_candidate_pressure == 8
		and result.baseline_surface_symbol_comparison_pressure == 12
		and result.baseline_import_binding_comparison_pressure == 28
		and result.exported_symbol_count == 12
		and result.module_alias_count == 4
		and result.imported_name_count == 4
		and result.import_binding_count == 8
		and result.error_count == 0
		and result.checksum == 84
		and result.workload_valid
	)


private func test_module_binding_fixture_is_deterministic_when_repeated() -> Bool:
	result = compiler_module_binding_benchmark({
		iterations = 3,
		module_count = 3,
		exports_per_module = 2,
	})

	result.workload_valid and result.error_count == 0 and result.checksum == 144


private func test_graph_visibility_width_fixture_counts_rows_and_decisions() -> Bool:
	match visibility_width_run({
		iterations = 2,
		module_count = 3,
		alias_count = 4,
		selective_count = 5,
		local_count = 2,
		duplicate_attempts = 6,
		query_count = 12,
		overlap_selectives_with_aliases = False,
		batch_initial_locals = False,
		batch_graph_imports = False,
	}):
		Some(result):
			(
				result.final_bound_rows == 11
				and result.final_import_bindings == 9
				and result.final_duplicate_aliases == 3
				and result.final_duplicate_selectives == 3
				and result.final_query_hits == 12
				and result.valid
			)
		None:
			False


private func test_graph_visibility_width_fixture_keeps_overlap_in_one_row() -> Bool:
	match visibility_width_run({
		iterations = 1,
		module_count = 3,
		alias_count = 4,
		selective_count = 4,
		local_count = 2,
		duplicate_attempts = 2,
		query_count = 12,
		overlap_selectives_with_aliases = True,
		batch_initial_locals = False,
		batch_graph_imports = False,
	}):
		Some(result):
			(
				result.final_bound_rows == 6
				and result.final_import_bindings == 8
				and result.final_query_hits == 12
				and result.valid
			)
		None:
			False


private func test_graph_visibility_width_batch_locals_preserves_results() -> Bool:
	config: VisibilityWidthConfig = {
		iterations = 1,
		module_count = 3,
		alias_count = 4,
		selective_count = 4,
		local_count = 40,
		duplicate_attempts = 4,
		query_count = 24,
		overlap_selectives_with_aliases = True,
		batch_initial_locals = False,
		batch_graph_imports = False
	}

	match (
		visibility_width_run(config),
		visibility_width_run({ config | batch_initial_locals = True }),
	):
		(Some(sequential), Some(batched)):
			(
				sequential.valid
				and batched.valid
				and sequential.final_bound_rows == batched.final_bound_rows
				and sequential.final_import_bindings == batched.final_import_bindings
				and sequential.final_duplicate_aliases == batched.final_duplicate_aliases
				and sequential.final_duplicate_selectives == batched.final_duplicate_selectives
				and sequential.final_query_hits == batched.final_query_hits
				and sequential.total_bound_query_checksum == batched.total_bound_query_checksum
			)
		_:
			False


private func test_graph_visibility_width_batch_imports_preserves_results() -> Bool:
	config: VisibilityWidthConfig = {
		iterations = 1,
		module_count = 3,
		alias_count = 4,
		selective_count = 4,
		local_count = 2,
		duplicate_attempts = 4,
		query_count = 24,
		overlap_selectives_with_aliases = True,
		batch_initial_locals = True,
		batch_graph_imports = False
	}

	match (
		visibility_width_run(config),
		visibility_width_run({ config | batch_graph_imports = True }),
	):
		(Some(sequential), Some(batched)):
			(
				sequential.valid
				and batched.valid
				and sequential.final_bound_rows == batched.final_bound_rows
				and sequential.final_import_bindings == batched.final_import_bindings
				and sequential.final_duplicate_aliases == batched.final_duplicate_aliases
				and sequential.final_duplicate_selectives == batched.final_duplicate_selectives
				and sequential.final_query_hits == batched.final_query_hits
				and sequential.total_bound_query_checksum == batched.total_bound_query_checksum
			)
		_:
			False


private func test_graph_visibility_width_stops_on_unexpected_registration_failure() -> Bool:
	config: VisibilityWidthConfig = {
		iterations = 1,
		module_count = 2,
		alias_count = 2,
		selective_count = 2,
		local_count = 2,
		duplicate_attempts = 2,
		query_count = 6,
		overlap_selectives_with_aliases = False,
		batch_initial_locals = True,
		batch_graph_imports = True
	}
	(
		visibility_width_run_with_foreign_current_module_for_test(config).is_none()
		and visibility_width_run_with_foreign_current_module_for_test({ config |
				batch_initial_locals = False,
				batch_graph_imports = False
			}).is_none()
	)


tests: TestSuite = {
	description = "Compiler module binding benchmark",
	tests = [
		(
			"fixture counts exact and alternate-name binding work",
			test_module_binding_fixture_counts_exact_workload,
		),
		(
			"repeated fixture remains deterministic",
			test_module_binding_fixture_is_deterministic_when_repeated,
		),
		(
			"graph visibility width fixture counts rows and decisions",
			test_graph_visibility_width_fixture_counts_rows_and_decisions,
		),
		(
			"graph visibility width fixture keeps overlap in one row",
			test_graph_visibility_width_fixture_keeps_overlap_in_one_row,
		),
		(
			"graph visibility width batch locals preserves results",
			test_graph_visibility_width_batch_locals_preserves_results,
		),
		(
			"graph visibility width batch imports preserves results",
			test_graph_visibility_width_batch_imports_preserves_results,
		),
		(
			"graph visibility width stops after unexpected registration failure",
			test_graph_visibility_width_stops_on_unexpected_registration_failure,
		),
	]
}
