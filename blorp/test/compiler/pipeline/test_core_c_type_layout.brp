pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func canonical_bool_type() -> CoreType:
	EnumType("Bool")


pure func string_type() -> CoreType:
	NamedType("String", [])


pure func list_type(elem_type: CoreType) -> CoreType:
	NamedType("List", [elem_type])


pure func dict_type(key_type: CoreType, value_type: CoreType) -> CoreType:
	NamedType(
		"Dict",
		[key_type, value_type],
	)


pure func channel_type(elem_type: CoreType) -> CoreType:
	NamedType("Channel", [elem_type])


pure func stack_result_type() -> CoreType:
	StackResultType(int_type(), string_type())


pure func option_string_is(value: Option[String], expected: String) -> Bool:
	match value:
		Some(actual):
			actual == expected
		None:
			False


pure func option_string_is_none(value: Option[String]) -> Bool:
	match value:
		Some(actual):
			False
		None:
			True


pure func option_type_c_name_is(value: Option[CoreType], expected_c_type: String) -> Bool:
	match value:
		Some(typ):
			c_type_name(typ) == expected_c_type
		None:
			False


pure func option_type_is_none(value: Option[CoreType]) -> Bool:
	match value:
		Some(typ):
			False
		None:
			True


pure func test_c_type_names() -> Bool:
	(
		c_type_name(int_type()) == "long"
		and c_type_name(bool_type()) == "int"
		and c_type_name(canonical_bool_type()) == "int"
		and c_type_name(string_type()) == "blorp_String*"
		and c_type_name(NamedType("Option", [int_type()])) == "blorp_StackOption_Int"
		and c_type_name(stack_result_type()) == "blorp_StackResult"
		and c_type_name(BoxedResultType(int_type(), string_type())) == "blorp_Result*"
		and c_type_name(HeapRecordType("MemStats")) == "blorp_MemStats*"
		and c_type_name(HeapRecordType("UserRecord")) == "UserRecord*"
	)


pure func test_stack_option_layout_facts() -> Bool:
	int_stack_option_ok: Bool = option_string_is(
		stack_option_c_type(int_type()),
		"blorp_StackOption_Int",
	)
	record_stack_option_ok: Bool = option_string_is(
		stack_option_c_type(ValueRecordType("Point")),
		"blorp_StackOption_Point",
	)
	unsupported_stack_option_ok: Bool = option_string_is_none(stack_option_c_type(string_type()))

	(
		int_stack_option_ok
		and record_stack_option_ok
		and unsupported_stack_option_ok
		and generated_stack_option_c_type_name("Range") == "blorp_StackOption_RangeValue"
		and generated_stack_option_c_type_name("Color") == "blorp_StackOption_Color"
		and runtime_owned_stack_option_payload_name("Int")
		and not runtime_owned_stack_option_payload_name("String")
	)


pure func test_nullable_managed_option_layout_facts() -> Bool:
	string_payload_ok: Bool = option_type_c_name_is(
		nullable_managed_option_payload_type(NamedType("Option", [string_type()])),
		"blorp_String*",
	)
	stream_payload_ok: Bool = option_type_c_name_is(
		nullable_managed_option_payload_type(
			NamedType(
				"Option",
				[NamedType("std/stream::Stream", [int_type()])],
			),
		),
		"blorp_Stream*",
	)

	(
		string_payload_ok
		and stream_payload_ok
		and option_type_is_none(
			nullable_managed_option_payload_type(NamedType("Option", [int_type()])),
		)
		and option_type_is_none(
			nullable_managed_option_payload_type(NamedType("Option", [ValueRecordType("Point")])),
		)
		and option_type_is_none(
			nullable_managed_option_payload_type(
				NamedType(
					"Option",
					[NamedType("Option", [string_type()])],
				),
			),
		)
		and option_type_is_none(
			nullable_managed_option_payload_type(
				NamedType(
					"Option",
					[
						NamedType(
							"Result",
							[int_type(), string_type()],
						),
					],
				),
			),
		)
		and option_type_is_none(
			nullable_managed_option_payload_type(NamedType("Option", [NamedType("Ptr", [])])),
		)
		and option_type_is_none(
			nullable_managed_option_payload_type(NamedType("Option", [TypeParameterType("T")])),
		)
		and option_type_is_none(
			nullable_managed_option_payload_type(NamedType("Option", [SelfType])),
		)
	)


pure func test_release_facts() -> Bool:
	closure_type: CoreType = NamedType("Closure", [])

	(
		boxed_value_needs_release_type(string_type())
		and boxed_value_needs_release_type(list_type(int_type()))
		and not boxed_value_needs_release_type(int_type())
		and type_requires_release(HeapRecordType("UserRecord"))
		and type_requires_release(TupleType([int_type(), string_type()]))
		and type_requires_release(closure_type)
		and not type_requires_release(int_type())
		and cleanup_release_policy_for_type(string_type()) == ArcReleaseOnlyPolicy
		and cleanup_release_policy_for_type(list_type(int_type())) == ArcReleasePolicy
		and cleanup_release_policy_for_type(
			NamedType(
				"Option",
				[string_type()],
			),
		) == ArcReleaseOnlyPolicy
		and cleanup_release_policy_for_type(
			NamedType(
				"Option",
				[list_type(int_type())],
			),
		) == ArcReleasePolicy
		and cleanup_release_policy_for_type(NamedType("Option", [int_type()])) == NoReleasePolicy
		and cleanup_release_policy_for_type(closure_type) == ArcReleasePolicy
		and cleanup_release_policy_for_type(stack_result_type()) == StackResultReleasePolicy
		and cleanup_release_policy_for_type(int_type()) == NoReleasePolicy
	)


pure func test_collection_element_facts() -> Bool:
	channel_ok: Bool = option_type_c_name_is(
		channel_element_type(channel_type(string_type())),
		"blorp_String*",
	)
	non_channel_ok: Bool = option_type_is_none(channel_element_type(list_type(string_type())))

	(
		boxed_value_needs_release_type(dict_type(string_type(), list_type(string_type())))
		and channel_ok
		and non_channel_ok
	)


pure func test_result_layout_facts() -> Bool:
	is_stack_result_type(stack_result_type()) and is_stack_result_type(
		NamedType(
			"Result",
			[int_type(), string_type()],
		),
	) and not is_stack_result_type(
		BoxedResultType(
			int_type(),
			string_type(),
		),
	) and not is_stack_result_type(NamedType("Result", [int_type()]))


pure func value_record_decl(name: String, fields: List[CoreValueRecordField]) -> CoreDecl:
	ValueRecordDecl({
		abi_type = None,
		name = name,
		type_params = [],
		fields = fields,
		loc = SyntheticSourceLoc,
	})


pure func byte_enum_decl(name: String, max_tag: Int) -> CoreDecl:
	EnumDecl({
		abi_type = None,
		name = name,
		type_params = [],
		variants = [
			{
				name = "First",
				c_name = name + "_First",
				tag = 0,
				def_id = None
			},
			{
				name = "Last",
				c_name = name + "_Last",
				tag = max_tag,
				def_id = None
			},
		],
		loc = SyntheticSourceLoc,
	})


pure func foreign_function_decl(param_types: List[CoreType], return_type: CoreType) -> CoreDecl:
	var params: List[CoreParam] = []
	var index: Int = 0

	for typ in param_types:
		params = params.append({
			name = {
				name = "arg" + index.to_string(),
				uniq = index,
				def_id = None
			},
			typ = typ,
			loc = SyntheticSourceLoc,
		})
		index += 1

	FunctionDecl({
		name = "foreign_layout_probe",
		source_module = None,
		type_params = [],
		params = params,
		return_type = return_type,
		body = None,
		is_pure = True,
		function_kind = ForeignFunction({
			c_name = "foreign_layout_probe",
			includes = [],
			link_flags = [],
			arg_passing = ForeignBorrowArgs,
		}),
		def_id = 2,
		loc = SyntheticSourceLoc,
	})


pure func test_foreign_abi_record_layout_classification() -> Bool:
	program: CoreProgram = {
		decls = [
			value_record_decl(
				"InternalFlags",
				[
					{
						name = "flag",
						typ = bool_type()
					},
				],
			),
			value_record_decl(
				"NestedFlags",
				[
					{
						name = "flag",
						typ = bool_type()
					},
				],
			),
			value_record_decl(
				"ForeignOuter",
				[
					{
						name = "nested",
						typ = NamedType("NestedFlags", [])
					},
				],
			),
			value_record_decl(
				"ForeignReturn",
				[
					{
						name = "flag",
						typ = bool_type()
					},
				],
			),
			value_record_decl(
				"HeapNestedFlags",
				[
					{
						name = "flag",
						typ = bool_type()
					},
				],
			),
			HeapRecordDecl({
				abi_type = None,
				name = "InternalHeapEnvelope",
				type_params = [],
				fields = [
					{
						name = "flags",
						typ = NamedType("InternalFlags", []),
						release_policy = NoReleasePolicy
					},
				],
				loc = SyntheticSourceLoc,
			}),
			HeapRecordDecl({
				abi_type = None,
				name = "ForeignHeapEnvelope",
				type_params = [],
				fields = [
					{
						name = "nested",
						typ = NamedType("HeapNestedFlags", []),
						release_policy = NoReleasePolicy
					},
					{
						name = "next",
						typ = NamedType("ForeignHeapEnvelope", []),
						release_policy = ArcReleasePolicy
					},
				],
				loc = SyntheticSourceLoc,
			}),
			value_record_decl(
				"UnionNestedFlags",
				[
					{
						name = "flag",
						typ = bool_type()
					},
				],
			),
			UnionDecl({
				abi_type = None,
				name = "ForeignUnionEnvelope",
				type_params = [],
				payload_storage = TypedUnionPayloadStorage,
				variants = [
					{
						name = "Value",
						c_name = "ForeignUnionEnvelope_Value",
						tag_c_name = "FOREIGN_UNION_ENVELOPE_VALUE",
						tag = 0,
						fields = [
							{
								typ = NamedType("UnionNestedFlags", []),
								release_policy = NoReleasePolicy
							},
						],
						def_id = None
					},
					{
						name = "Next",
						c_name = "ForeignUnionEnvelope_Next",
						tag_c_name = "FOREIGN_UNION_ENVELOPE_NEXT",
						tag = 1,
						fields = [
							{
								typ = NamedType("ForeignUnionEnvelope", []),
								release_policy = ArcReleasePolicy
							},
						],
						def_id = None
					},
				],
				loc = SyntheticSourceLoc,
			}),
			TypeAliasDecl({
				abi_type = None,
				name = "IdentityAlias",
				type_params = ["T"],
				target = TypeParameterType("T"),
				is_opaque = False,
				loc = SyntheticSourceLoc,
			}),
			TypeAliasDecl({
				abi_type = None,
				name = "ForeignOuterAlias",
				type_params = [],
				target = NamedType("IdentityAlias", [NamedType("ForeignOuter", [])]),
				is_opaque = False,
				loc = SyntheticSourceLoc,
			}),
			FunctionDecl({
				name = "main",
				source_module = None,
				type_params = [],
				params = [],
				return_type = NamedType("InternalHeapEnvelope", []),
				body = Some(VoidExpr(NamedType("InternalHeapEnvelope", []), SyntheticSourceLoc)),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 1,
				loc = SyntheticSourceLoc,
			}),
			foreign_function_decl(
				[
					NamedType("ForeignOuterAlias", []),
					NamedType("ForeignHeapEnvelope", []),
					NamedType("ForeignUnionEnvelope", []),
				],
				NamedType(
					"ForeignReturn",
					[],
				),
			),
		],
		foreign_includes = []
	}

	var internal_flags_retained: Bool = False
	var internal_heap_retained: Bool = False

	prepared: CoreProgram = prepared_core_program_value(run_pre_dce_tail(program))
	internal_flags_retained = prepared.decls.any(func(decl):
		match decl:
			ValueRecordDecl(record_decl):
				record_decl.name == "InternalFlags"
			_:
				False
	)
	internal_heap_retained = prepared.decls.any(func(decl):
		match decl:
			HeapRecordDecl(record_decl):
				record_decl.name == "InternalHeapEnvelope"
			_:
				False
	)
	-- DCE may remove the deliberately unreferenced foreign declaration.
	-- Retention and ABI classification are independent facts in this test.
	layouts: CRecordLayoutRegistry = classify_c_record_layouts(program)

	(
		internal_flags_retained
		and internal_heap_retained
		and c_record_layout(layouts, "InternalFlags") == InternalLayout
		and c_heap_record_layout(layouts, "InternalHeapEnvelope") == InternalLayout
		and c_record_layout(layouts, "ForeignOuter") == ForeignAbiLayout
		and c_record_layout(layouts, "NestedFlags") == ForeignAbiLayout
		and c_record_layout(layouts, "ForeignReturn") == ForeignAbiLayout
		and c_heap_record_layout(layouts, "ForeignHeapEnvelope") == ForeignAbiLayout
		and c_record_layout(layouts, "HeapNestedFlags") == ForeignAbiLayout
		and c_record_layout(layouts, "UnionNestedFlags") == ForeignAbiLayout
	)


pure func test_consecutive_internal_value_record_boolean_field_storage() -> Bool:
	c_value_record_field_storage(
		InternalLayout,
		canonical_bool_type(),
		True,
	) == PackedBooleanCValueRecordField


pure func test_isolated_internal_value_record_boolean_field_storage() -> Bool:
	match c_value_record_field_storage(InternalLayout, canonical_bool_type(), False):
		OrdinaryCValueRecordField(c_type):
			c_type == "_Bool"
		PackedBooleanCValueRecordField:
			False


pure func test_foreign_value_record_boolean_field_storage() -> Bool:
	match c_value_record_field_storage(ForeignAbiLayout, canonical_bool_type(), True):
		OrdinaryCValueRecordField(c_type):
			c_type == "int"
		PackedBooleanCValueRecordField:
			False


pure func test_internal_value_record_non_boolean_field_storage() -> Bool:
	match c_value_record_field_storage(InternalLayout, int_type(), True):
		OrdinaryCValueRecordField(c_type):
			c_type == "long"
		PackedBooleanCValueRecordField:
			False


pure func test_consecutive_internal_heap_record_boolean_field_storage() -> Bool:
	layouts: CRecordLayoutRegistry = classify_c_record_layouts({
		decls = [],
		foreign_includes = [],
	})

	c_heap_record_field_storage(
		layouts,
		"InternalFlags",
		InternalLayout,
		canonical_bool_type(),
		True,
	) == PackedBooleanCHeapRecordField


pure func test_isolated_internal_heap_record_boolean_field_storage() -> Bool:
	layouts: CRecordLayoutRegistry = classify_c_record_layouts({
		decls = [],
