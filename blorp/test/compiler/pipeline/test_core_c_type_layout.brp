pure func foreign_identity_call(typ: CoreType) -> CoreExpr:
	CallExpr(
		ForeignCall("live_foreign_flags", ForeignBorrowArgs),
		VoidExpr(VoidType, SyntheticSourceLoc),
		[VoidExpr(typ, SyntheticSourceLoc)],
		typ,
		SyntheticSourceLoc,
	)


pure func test_retained_foreign_call_record_layout_classification() -> Bool:
	foreign_record_type: CoreType = NamedType("LiveForeignFlags", [])
	program: CoreProgram = {
		decls = [
			value_record_decl(
				"LiveForeignFlags",
				[
					{
						name = "flag",
						typ = bool_type()
					},
				],
			),
			FunctionDecl({
				name = "main",
				source_module = None,
				type_params = [],
				params = [],
				return_type = foreign_record_type,
				body = Some(foreign_identity_call(foreign_record_type)),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 3,
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}
	layouts: CRecordLayoutRegistry = classify_c_record_layouts(program)

	c_record_layout(layouts, "LiveForeignFlags") == ForeignAbiLayout


pure func test_non_function_foreign_call_record_layout_classification() -> Bool:
	global_record_type: CoreType = NamedType("GlobalForeignFlags", [])
	impl_record_type: CoreType = NamedType("ImplForeignFlags", [])
	program: CoreProgram = {
		decls = [
			value_record_decl(
				"GlobalForeignFlags",
				[
					{
						name = "flag",
						typ = bool_type()
					},
				],
			),
			value_record_decl(
				"ImplForeignFlags",
				[
					{
						name = "flag",
						typ = bool_type()
					},
				],
			),
			GlobalDecl({
				name = {
					name = "global_foreign_flags",
					uniq = 4,
					def_id = Some(4)
				},
				source_module = None,
				typ = global_record_type,
				init = foreign_identity_call(global_record_type),
				is_mutable = False,
				is_const = False,
				is_private = True,
				def_id = 4,
				loc = SyntheticSourceLoc,
			}),
			ImplDecl({
				trait_name = "ForeignLayoutProbe",
				for_type = int_type(),
				type_params = [],
				methods = [
					{
						name = "impl_foreign_flags",
						source_module = None,
						type_params = [],
						params = [],
						return_type = impl_record_type,
						body = Some(foreign_identity_call(impl_record_type)),
						is_pure = True,
						function_kind = UserFunction,
						def_id = 5,
						loc = SyntheticSourceLoc
					},
				],
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}
	layouts: CRecordLayoutRegistry = classify_c_record_layouts(program)

	(
		c_record_layout(layouts, "GlobalForeignFlags") == ForeignAbiLayout
		and c_record_layout(layouts, "ImplForeignFlags") == ForeignAbiLayout
	)


