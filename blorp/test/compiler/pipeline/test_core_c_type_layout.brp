pure func test_internal_heap_record_non_boolean_field_storage() -> Bool:
	layouts: CRecordLayoutRegistry = classify_c_record_layouts({
		decls = [],
		foreign_includes = [],
	})

	match c_heap_record_field_storage(layouts, "InternalValues", InternalLayout, int_type(), True):
