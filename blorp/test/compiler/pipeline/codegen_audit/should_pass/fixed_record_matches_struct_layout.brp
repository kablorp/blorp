-- Both source spellings use the same unmanaged value-record C layout in R1.
-- EXPECT-C: typedef struct { long f0; long f1; } brp_ty1;
-- EXPECT-C: typedef struct { long f0; long f1; } brp_ty2;
-- EXPECT-C: static inline brp_ty1 brp_ty1_make(long f0, long f1)
-- EXPECT-C: static inline brp_ty2 brp_ty2_make(long f0, long f1)
-- EXPECT-C: typedef struct { long f0; } brp_ty3;
-- EXPECT-C: typedef struct { brp_ty3 f0; long f1; } brp_ty4;
-- EXPECT-C: typedef struct { long f0; } brp_ty5;
-- EXPECT-C: typedef struct { brp_ty5 f0; long f1; } brp_ty6;
-- EXPECT-C: static inline brp_ty4 brp_ty4_make(brp_ty3 f0, long f1)
-- EXPECT-C: static inline brp_ty6 brp_ty6_make(brp_ty5 f0, long f1)
-- EXPECT-NOT-C-REGEX: brp_ty(3|4|5|6)_(retain|release)
struct LegacyPoint {x: Int, y: Int}
fixed record FixedPoint {x: Int, y: Int}
struct LegacyInner {value: Int}
struct LegacyOuter {inner: LegacyInner, other: Int}
fixed record FixedInner {value: Int}
fixed record FixedOuter {inner: FixedInner, other: Int}


pure func legacy_sum(value: Int) -> Int:
	point: LegacyPoint = {x = value, y = 3}
	updated: LegacyPoint = {point | x = point.x + 4}
	updated.x + updated.y


pure func fixed_sum(value: Int) -> Int:
	point: FixedPoint = {x = value, y = 3}
	updated: FixedPoint = {point | x = point.x + 4}
	updated.x + updated.y


pure func legacy_nested_sum(value: Int) -> Int:
	inner: LegacyInner = {value = value}
	point: LegacyOuter = {inner = inner, other = 3}
	updated: LegacyOuter = {point | other = point.other + 4}
	updated.inner.value + updated.other


pure func fixed_nested_sum(value: Int) -> Int:
	inner: FixedInner = {value = value}
	point: FixedOuter = {inner = inner, other = 3}
	updated: FixedOuter = {point | other = point.other + 4}
	updated.inner.value + updated.other


func main(args: List[String]) -> Int:
	if legacy_sum(2) == fixed_sum(2) and legacy_nested_sum(2) == fixed_nested_sum(2):
		0
	else:
		1
