-- Raw scalar fills cross the Blorp specialization boundary and select typed
-- runtime ABIs. Float16 stores each element as encoded bits, with no
-- element destructor.
-- EXPECT-C: blorp_Vector* float_values = blorp_vector_new_fill_f64(
-- EXPECT-C: blorp_Vector* float32_values = blorp_vector_new_fill_f32(
-- EXPECT-C: blorp_Vector* __fill_vector_tensor_fill = blorp_vector_new(
-- EXPECT-C: __fill_vector_tensor_fill->data[__fill_index_tensor_fill] = blorp_box_float16(__fill_value_tensor_fill);
-- EXPECT-NOT-C: blorp_Vector* float16_values = blorp_vector_new_fill_f
-- EXPECT-NOT-C: blorp_vector_new_fill(__t0_0, __t0_1);
-- EXPECT-NOT-C: blorp_vector_init_elem_release(__fill_vector_tensor_fill, blorp_elem_release_fn);
import:
	tensor: vector


func main(args: List[String]) -> Int:
	float_values: Float[#2] = vector(1.5, 2)
	float32_values: Float32[#2] = vector(1.5, 2)
	float16_values: Float16[#2] = vector(to_float16(1.5), 2)

	if length(float_values) + length(float32_values) + length(float16_values) == 6:
		0
	else:
		1
