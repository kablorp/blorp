-- Resource-source concurrent loops should move each accepted stream into one
-- child task and let that task own scoped cleanup.
-- EXPECT-C: blorp_resource_source_next_raw(
-- EXPECT-C: blorp_thread_pool_ensure_initialized();
-- EXPECT-C: blorp_concurrent_task_window_begin(&__conc_task_window_
-- EXPECT-C: blorp_concurrent_task_window_spawn_owned(&__conc_task_window_
-- EXPECT-C: BLORP_CONCURRENT_TASK_FLUSH_IMMEDIATE
-- EXPECT-C: blorp_concurrent_task_window_join_release(&__conc_task_window_
-- EXPECT-C: blorp_concurrent_task_window_end(&__conc_task_window_
-- EXPECT-NOT-C: blorp_TaskBatch __conc_batch_
-- EXPECT-NOT-C: blorp_task_batch_flush(&__conc_batch_
-- EXPECT-NOT-C: blorp_thread_pool_init((int)__conc_limit_
-- EXPECT-NOT-C: .tasks[
-- EXPECT-NOT-C: .cleanups[
-- EXPECT-C: __e[0] = NULL;
-- EXPECT-C: blorp_task_cleanup_push(&__blorp_cleanup_conn, &conn, (void*)conn, (blorp_CancelCleanupFn)blorp_tcp_close_stream);
-- EXPECT-C: (void)(blorp_tcp_close_stream(conn));
import:
	net/tcp as Tcp: IpFamily(IPv4), TcpError


func serve_once() -> Result[Int, TcpError]:
	with listener ?= Tcp.listen_loopback_any_port(IPv4, 1):
		for conn in Tcp.connections_stop_on_error(listener) concurrently(limit: 1):
			_ = Tcp.stream_local_port(conn)
		Ok(0)


func main(args: List[String]) -> Int:
	match serve_once():
		Ok(value): value
		Err(_): 1
