-- Managed elements still need correct ownership when a non-escaping tuple is
-- flattened. Immortal literal elements need neither cleanup nor release.
-- EXPECT-C: BLORP_STATIC_STRING(__blorp_string_literal_0, 5L, "hello");
-- EXPECT-NOT-C: blorp_tuple_new(
-- EXPECT-C-REGEX: blorp_String\* brp_vn_[0-9A-Za-z]+ = \(blorp_String\*\)&__blorp_string_literal_0;
-- EXPECT-NOT-C-REGEX: blorp_task_cleanup_push_with_task\(&__blorp_cleanup_brp_vn_
-- EXPECT-NOT-C-REGEX: blorp_release\(brp_vn_
func main(args: List[String]) -> Int:
	pair: (String, Int) = ("hello", 5)

	if pair[0].length() == pair[1]:
		0
	else:
		1
