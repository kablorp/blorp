-- Regression: concrete Int vector reductions should expose typed raw i64
-- storage while retaining the generic runtime fallback for unusual vector
-- representations.
-- EXPECT-C: ->storage_mode == BLORP_VECTOR_STORAGE_I64
-- EXPECT-C: ->elem_size == (int16_t)sizeof(long)
-- EXPECT-C: long* __tensor_raw = (long*)((blorp_Vector*)__tensor)->data
-- EXPECT-C: __tensor_raw[__i]
-- EXPECT-C: blorp_vector_read_i64((blorp_Vector*)__tensor, __i)
import:
	vector: sum


func main(args: List[String]) -> Int:
	arr: Int[#4] = {1, 2, 3, 4}
	sum(arr)
