-- Regression: a range bound that is a call chain, not a literal or variable,
-- must be evaluated once into a scoped temporary before the loop header
-- instead of failing to emit the whole function.
-- EXPECT-NOT-C-REGEX: could not emit function body
-- EXPECT-C-REGEX: long __t1j_[0-9]+;
-- EXPECT-C-REGEX: long __tp_[0-9]+ = __t1j_[0-9]+;
func main(args: List[String]) -> Int:
	xs: List[Int] = [10, 20, 30, 40]
	var total: Int = 0
	for audit_i in 0..xs.length().min(3):
		total += audit_i
	total
