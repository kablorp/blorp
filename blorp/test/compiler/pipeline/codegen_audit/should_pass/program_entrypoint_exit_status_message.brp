-- EXPECT-C: int main(int argc, char** argv)
-- Semantic callable expectation: ExitStatusAble_resolve_exit_status_CustomStatus
-- EXPECT-C-REGEX: static long brp_[0-9A-Za-z]+\(CustomStatus\* value\)
-- Semantic callable expectation: std_io__print_error__mono_String
-- EXPECT-C-REGEX: brp_[0-9A-Za-z]+\(message\)
-- EXPECT-NOT-C: CustomStatus* main(
import:
	exit as Exit: ExitStatus, ExitStatusAble
	option: Option(Some, None)


record CustomStatus {
	code: Int,
	message: Option[String]
}


implements ExitStatusAble for CustomStatus:
	pure func to_exit_status(value: CustomStatus) -> Exit.ExitStatus:
		{
			code = value.code,
			message = value.message
		}


func main(args: List[String]) -> CustomStatus:
	{
		code = 3,
		message = Some("invalid configuration")
	}
