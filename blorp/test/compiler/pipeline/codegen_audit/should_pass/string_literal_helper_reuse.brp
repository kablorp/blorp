-- Passing one literal several times must create ordinary ARC-managed arguments
-- and clean each one up after the borrowing call. It must not emit the old
-- cached-literal assignment shape.
-- EXPECT-C: blorp_string_create("\n")
-- EXPECT-NOT-C: (__sl_0 ? __sl_0 : (__sl_0 = blorp_string_create
func same(a: String, b: String, c: String) -> Bool:
	a == b and b == c


func main(args: List[String]) -> Int:
	if same("\n", "\n", "\n"):
		0
	else:
		1
