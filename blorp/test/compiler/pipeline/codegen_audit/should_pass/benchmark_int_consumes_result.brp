-- Generated-C shape audit for result-consuming integer benchmarks.
--
-- A benchmark that returns Int must feed the callback result through
-- blorp_black_box_int so optimized C builds cannot erase pure numeric work
-- whose value is otherwise only used for timing.
--
-- EXPECT-C: blorp_black_box_int
-- EXPECT-C: checksum
-- Semantic callable expectation: fib_tailrec((n - 1L)
-- EXPECT-NOT-C-REGEX: brp_[0-9A-Za-z]+\(\(n - 1L\)
import:
	../../../../../../benchmarks/blorp/support/benchmark: BenchmarkResult, bench_int


@tail_recursive
pure func fib_tailrec(n: Int, a: Int, b: Int) -> Int:
	match n <= 0:
		True: a
		False: fib_tailrec(n - 1, b, a + b)


func main(args: List[String]) -> Int:
	result: BenchmarkResult = bench_int(10, func(i: Int) -> Int: fib_tailrec(i + 5, 0, 1))
	result.checksum
