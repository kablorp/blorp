-- EXPECT-C: static blorp_Tuple* STATIC_PAIR;
-- EXPECT-C: BLORP_STATIC_STRING(__blorp_string_literal_0, 5L, "seven");
-- EXPECT-C: STATIC_PAIR = ({ blorp_Tuple* __tup_tuple = blorp_tuple_new(3, (void*)(long)(7), (void*)(blorp_String*)&__blorp_string_literal_0, (void*)Counter_make(7));
-- EXPECT-C: blorp_tuple_set_rc(__tup_tuple, 6UL);
-- EXPECT-C: blorp_release(STATIC_PAIR);
-- EXPECT-C: blorp_register_global_cleanup(__blorp_drop_globals);
-- EXPECT-NOT-C: blorp_string_create("seven")
-- EXPECT-NOT-C: blorp_make_immortal_
record Counter {
	value: Int
}


STATIC_PAIR: (Int, String, Counter) = (7, "seven", {value = 7})


func main(args: List[String]) -> Int:
	value = STATIC_PAIR[1]
	counter = STATIC_PAIR[2]
	print(value + ":" + counter.value.to_string())
	0
