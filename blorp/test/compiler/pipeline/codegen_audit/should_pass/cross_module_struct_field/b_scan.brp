--- Helper module declaring a struct whose field type comes from `z_base`.
import:
	z_base: Cursor, make_cursor


struct Scan {
	end: Cursor,
	saw_dot: Bool
}


pure func make_scan(offset: Int) -> Scan:
	{
		end = make_cursor(offset),
		saw_dot = True
	}


pure func scan_offset(scan: Scan) -> Int:
	scan.end.offset
