-- Managed fields still need correct ownership when a non-escaping tuple is
-- scalar-replaced. Immortal literal fields need neither cleanup nor release.
-- EXPECT-C: BLORP_STATIC_STRING(__blorp_string_literal_0, 5L, "hello");
-- EXPECT-C: blorp_String* __blorp_internal_tuple_sroa_
-- EXPECT-NOT-C: blorp_task_cleanup_push(&__blorp_cleanup___blorp_internal_tuple_sroa_
-- EXPECT-NOT-C: blorp_release(__blorp_internal_tuple_sroa_
func main(args: List[String]) -> Int:
	pair: (String, Int) = ("hello", 5)

	if pair[0].length() == pair[1]:
		0
	else:
		1
