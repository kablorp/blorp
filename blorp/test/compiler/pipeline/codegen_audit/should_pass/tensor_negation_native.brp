-- Concrete tensor negation must lower directly to the native tensor helper.
-- EXPECT-C: return blorp_vector_scalar_op_rev_int(1, values, 0);
-- EXPECT-NOT-CALLABLE: Negatable_negate_Int
pure func negate_tensor(values: Int[#3]) -> Int[#3]:
	-values


func main(args: List[String]) -> Int:
	values: Int[#3] = {1, -2, 3}
	negated = negate_tensor(values)

	if (
		negated[0] == -1
		and negated[1] == 2
		and negated[2] == -3
	):
		0
	else:
		1
