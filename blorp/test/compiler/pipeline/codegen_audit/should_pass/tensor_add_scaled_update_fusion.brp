-- Regression: tensor update assignment should fuse `target += input * scalar`
-- into one ownership-aware update call, without materializing the scaled input.
-- EXPECT-C-REGEX: = \(\(blorp_Vector\*\)blorp_tensor_add_scaled_f64_cow\(brp_vn?_[A-Za-z0-9]+, brp_vn?_[A-Za-z0-9]+, 0\.5\)\);
-- EXPECT-C-REGEX: = \(\(blorp_Vector\*\)blorp_tensor_add_scaled_f32_cow\(brp_vn?_[A-Za-z0-9]+, brp_vn?_[A-Za-z0-9]+, brp_vn?_[A-Za-z0-9]+\)\);
-- EXPECT-NOT-C-REGEX: blorp_vector_scalar_op_float\(2L, brp_vn?_[A-Za-z0-9]+, 0\.5\)
-- EXPECT-NOT-C-REGEX: blorp_simd_vector_op\(0L, 1L, brp_vn?_[A-Za-z0-9]+
import:
	float: to_float32


func main(args: List[String]) -> Int:
	var positions: Float[#4, #3] = matrix(1.0, 4, 3)
	velocities: Float[#4, #3] = matrix(2.0, 4, 3)
	var f32_positions: Float32[#4] = vector(to_float32(1.0), 4)
	f32_velocities: Float32[#4] = vector(to_float32(2.0), 4)
	half: Float32 = to_float32(0.5)
	var i: Int = 0
	while i < 1:
		positions += velocities * 0.5
		f32_positions += f32_velocities * half
		i += 1
	if positions[0, 0] == 2.0:
		0
	else:
		1
