-- EXPECT-C: static blorp_StackResult STATIC_RESULT;
-- EXPECT-C: BLORP_STATIC_STRING(__blorp_string_literal_0, 6L, "answer");
-- EXPECT-C: STATIC_RESULT = ((blorp_StackResult){ .tag = 0, .release_mask = 1UL, .data.Ok.field0 = (void*)Payload_make(42, (blorp_String*)&__blorp_string_literal_0) });
-- EXPECT-C: static blorp_StackResult STATIC_INT_RESULT = { .tag = 0, .release_mask = 0UL, .data.Ok.field0 = (void*)(long)(7L) };
-- EXPECT-C: static blorp_StackResult STATIC_ERR_RESULT;
-- EXPECT-C: BLORP_STATIC_STRING(__blorp_string_literal_1, 4L, "nope");
-- EXPECT-C: STATIC_ERR_RESULT = ((blorp_StackResult){ .tag = 1, .release_mask = 1UL, .data.Err.field0 = (void*)(blorp_String*)&__blorp_string_literal_1 });
-- EXPECT-C: blorp_stack_result_release(STATIC_ERR_RESULT);
-- EXPECT-C: blorp_stack_result_release(STATIC_RESULT);
-- EXPECT-C: blorp_register_global_cleanup(__blorp_drop_globals);
-- EXPECT-NOT-C: blorp_string_create("answer")
-- EXPECT-NOT-C: blorp_string_create("nope")
-- EXPECT-NOT-C: blorp_make_immortal_
import:
	result: Result(Ok, Err)


record Payload {
	value: Int,
	label: String
}


STATIC_RESULT: Result[Payload, String] = Ok({
	value = 42,
	label = "answer",
})

STATIC_INT_RESULT: Result[Int, String] = Ok(7)

STATIC_ERR_RESULT: Result[Int, String] = Err("nope")


func main(args: List[String]) -> Int:
	match STATIC_RESULT:
		Ok(payload):
			if payload.value == 42 and STATIC_INT_RESULT.get_or(0) == 7:
				0
			else:
				1
		Err(_):
			1
