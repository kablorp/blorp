-- Replacing a mutable String with itself plus a suffix must use the
-- COW-consuming append primitive instead of copying the accumulated prefix.
--
-- EXPECT-C-REGEX: = blorp_string_append\(brp_vn?_[A-Za-z0-9]+, brp_vn?_[A-Za-z0-9]+\);
-- EXPECT-NOT-C-REGEX: = blorp_string_concat\(brp_vn?_[A-Za-z0-9]+, brp_vn?_[A-Za-z0-9]+\);
pure func render(parts: List[String]) -> String:
	var result: String = ""

	for part in parts:
		result += part

	result


func main(args: List[String]) -> Int:
	if render(["a", "b", "c"]) == "abc":
		0
	else:
		1
