-- Inline List[Int] mutation should use emitted direct slot stores. The
-- monomorphized list layout is a Core invariant, not a runtime branch.
--
-- EXPECT-C: blorp_List* __list_cap
-- EXPECT-C: blorp_List* __list_unique
-- EXPECT-C: blorp_List* __list_store_
-- EXPECT-C: blorp_is_unique(__list_cap
-- EXPECT-C: blorp_is_unique(__list_unique
-- EXPECT-C: ->capacity >= __list_cap_min
-- EXPECT-C: memcpy((char*)__list_store_
-- EXPECT-NOT-C: ->storage_mode == BLORP_LIST_STORAGE_INLINE
-- EXPECT-NOT-C: blorp_list_set_raw(__list_store_
import:
	list: List, append, set


func push_int(xs: List[Int], x: Int) -> List[Int]:
	append(xs, x)


func replace_int(xs: List[Int], i: Int, x: Int) -> List[Int]:
	set(xs, i, x)


func main(args: List[String]) -> Int:
	xs: List[Int] = [1, 2, 3]
	ys: List[Int] = push_int(xs, 4)
	zs: List[Int] = replace_int(ys, 0, 9)
	zs.length()
