-- Value-record construction should stay on the default Blorp final-Core-to-C
-- emitter with the matching declaration and field access path.
--
-- EXPECT-C: /* Blorp final Core C artifact */
-- EXPECT-C-REGEX: typedef struct \{ long x; long y; \} [A-Za-z0-9_]+;
-- EXPECT-C-REGEX: static inline [A-Za-z0-9_]+ [A-Za-z0-9_]+_make\(long x, long y\)
-- Semantic callable expectation: Point make_point(long x, long y)
-- EXPECT-C-REGEX: [A-Za-z0-9_]+ brp_[0-9A-Za-z]+\(long x, long y\)
-- EXPECT-C-REGEX: return [A-Za-z0-9_]+_make\(x, y\);
-- Semantic callable expectation: long point_sum(Point point)
-- EXPECT-C-REGEX: long brp_[0-9A-Za-z]+\([A-Za-z0-9_]+ point\)
-- EXPECT-C: return (point.x + point.y);
struct Point {
	x: Int,
	y: Int
}


pure func make_point(x: Int, y: Int) -> Point:
	{
		y = y,
		x = x
	}


pure func point_sum(point: Point) -> Int:
	point.x + point.y


func main(args: List[String]) -> Int:
	point: Point = make_point(20, 22)

	if point_sum(point) == 42:
		0
	else:
		1
