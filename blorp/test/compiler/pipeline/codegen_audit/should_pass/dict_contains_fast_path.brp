-- Generated-C shape audit for Dict.contains.
--
-- contains should probe the dict directly instead of calling get() and
-- allocating an Option only to pattern-match it into Bool.
--
-- EXPECT-C: __dict_contains_hash
-- EXPECT-C: __dict_contains_found
-- EXPECT-C: blorp_hash_int((long)(intptr_t)__dict_contains_key)
-- EXPECT-NOT-C: blorp_dict_get((blorp_Dict*)
import:
	dict: Dict, contains, dict, set


func main(args: List[String]) -> Int:
	d: Dict[Int, Int] = dict()
		.set(1, 10)
		.set(2, 20)
	if contains(d, 2):
		0
	else:
		1
