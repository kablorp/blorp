-- An opaque key hashes and compares through its own impls, not its
-- representation's word hash: the dict is built with the impls' slot
-- adapters and synthesized probes dispatch through the dict's callbacks,
-- while the key slot still stores the representation.
--
-- EXPECT-C: blorp_dict_new_custom(
-- EXPECT-C: ((blorp_Dict*)__result)->hash_fn(__dict_insert_key)
-- EXPECT-C-REGEX: ->hash_fn\(__dict_contains_key\)
-- EXPECT-NOT-C: blorp_hash_int((long)(intptr_t)__dict_insert_key)
-- EXPECT-NOT-C: blorp_hash_int((long)(intptr_t)__dict_contains_key)
import:
	dict: Dict, contains, dict, set


opaque type UserId = Int


pure func user_id(value: Int) -> UserId:
	into_opaque UserId(value)


-- Keys must be Hashable; an opaque type opts in with its own impls.
implements Equatable for UserId:
	pure func equals(left: UserId, right: UserId) -> Bool:
		from_opaque UserId(left) == from_opaque UserId(right)


implements Hashable for UserId:
	pure func hash(self: UserId) -> Int:
		from_opaque UserId(self).hash()


func main(args: List[String]) -> Int:
	id: UserId = user_id(7)
	values: Dict[UserId, Int] = dict().set(id, 70)

	if contains(values, id):
		0
	else:
		1
