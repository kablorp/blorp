-- Regression: concrete Int tensor arithmetic should lower to operation-specific
-- i64 kernels instead of generic tagged vector dispatch.
-- EXPECT-C: blorp_vector_add_i64(a, b)
-- EXPECT-C: blorp_vector_scalar_mul_i64(combined, 3)
-- EXPECT-NOT-C: blorp_vector_op(0L, 0L
-- EXPECT-NOT-C: blorp_vector_scalar_op_int(2L
import:
	vector: sum


func main(args: List[String]) -> Int:
	a: Int[#4] = {1, 2, 3, 4}
	b: Int[#4] = {5, 6, 7, 8}
	combined: Int[#4] = a + b
	scaled: Int[#4] = combined * 3
	sum(scaled)
