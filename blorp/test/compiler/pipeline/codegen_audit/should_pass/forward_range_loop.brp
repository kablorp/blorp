-- Regression: loops proven to be forward-only should emit C loops with
-- `< end` and `++`, not the generic bidirectional step form.
-- EXPECT-C-REGEX: for \(long brp_vn?_[A-Za-z0-9]+ = __tq_
-- EXPECT-C-REGEX: brp_vn?_[A-Za-z0-9]+ < __tp_
-- EXPECT-C-REGEX: brp_vn?_[A-Za-z0-9]+\+\+\) \{
-- EXPECT-NOT-C-REGEX: brp_vn?_[A-Za-z0-9]+ \+= __tr_
func main(args: List[String]) -> Int:
	var total: Int = 0
	for audit_i in 0..10:
		total += audit_i
	total
