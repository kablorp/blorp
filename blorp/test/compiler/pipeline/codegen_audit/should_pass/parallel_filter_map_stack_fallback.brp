-- Managed Point Options use nullable dispatch; wide scalar Options retain
-- the Core loop fallback rather than the boxed or primitive runtime callback ABI.
-- EXPECT-C-REGEX: return \(\(blorp_List\*\)blorp_filter_map_parallel_nullable\(.*1, BLORP_LIST_STORAGE_POINTER, sizeof\(void\*\), BLORP_LIST_CALLBACK_BITS\)\);
-- EXPECT-C: blorp_StackOption_Int128 __mapped =
-- EXPECT-C: blorp_StackOption_Int128 __to_1 = __mapped;
-- EXPECT-C: if (__to_1.tag == BLORP_TAG_SOME) {
-- EXPECT-C: __int128 __value = __to_1.value;
-- EXPECT-C: blorp_list_set_raw((blorp_List*)__result, __out, blorp_box_int128(__value));
-- EXPECT-C: (((blorp_List*)__result)->len = __out)
-- EXPECT-NOT-C: return ((blorp_List*)blorp_filter_map_parallel(
-- EXPECT-NOT-C: return ((blorp_List*)blorp_filter_map_parallel_int(
import:
	option: Option(Some, None)


fixed record ParallelPoint {
	x: Int,
	y: Int
}


pure func keep_point(x: Int) -> Option[ParallelPoint]:
	if x % 2 == 0:
		Some({
			x = x,
			y = x + 1
		})
	else:
		None


pure func keep_wide(x: Int) -> Option[Int128]:
	value: Int128 = 3
	if x % 2 == 0:
		Some(value)
	else:
		None


func main(args: List[String]) -> Int:
	nums: List[Int] = [1, 2, 3, 4]
	points: List[ParallelPoint] = nums.parallel(pure func(chunk: ParallelList[Int]):
		chunk.filter_map(keep_point)
	)
	wide_values: List[Int128] = nums.parallel(pure func(chunk: ParallelList[Int]):
		chunk.filter_map(keep_wide)
	)
	var points_preserved: Bool = True
	var expected_x: Int = 2
	for point in points:
		points_preserved = points_preserved and point.x == expected_x and point.y == expected_x + 1
		expected_x += 2
	var wide_preserved: Bool = True
	for value in wide_values:
		wide_preserved = wide_preserved and value == to_int128(3)
	if points_preserved and expected_x == 6 and points.length() == 2 and wide_preserved and wide_values.length() == 2:
		0
	else:
		1
