-- Proven compiler-owned tensor storage should let bounds-proven subscripts use
-- direct raw reads without a runtime storage-layout guard. Parameter tensors
-- remain guarded because static type alone is not a storage proof.
--
-- EXPECT-C: double* __tensor_raw_view_
-- EXPECT-C: total = (total + __tensor_raw_view_
-- EXPECT-NOT-C: __tensor_layout_
-- EXPECT-NOT-C: blorp_vector_read_f64((blorp_Vector*)
import:
	float: round, to_int


pure func sum_known_subscript() -> Float:
	values: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	var total: Float = 0.0
	for i in 0..length(values):
		total += values[i]
	total


func main(args: List[String]) -> Int:
	to_int(round(sum_known_subscript()))
