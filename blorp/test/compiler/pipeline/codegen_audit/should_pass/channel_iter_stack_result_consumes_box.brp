-- for value in Channel[Result[...]] receives an owned boxed stack Result from
-- the channel. The loop binding must consume the box, then release the stack
-- Result payload after the iteration body.
-- EXPECT-C: blorp_stack_result_from_boxed((blorp_Result*)__chan_val_
-- EXPECT-C: blorp_stack_result_release(value);

func main(args: List[String]) -> Int:
	ch: Channel[Result[String, String]] = channel(1)
	item: Result[String, String] = Ok("iter")
	_ = send(ch, item)
	seal(ch)
	var total: Int = 0
	for value in ch:
		match value:
			Ok(text): total = total + text.length()
			Err(err): total = total + err.length()
	total
