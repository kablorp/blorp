-- EXPECT-C: static blorp_List* TO_PREPEND;
-- EXPECT-C: TO_PREPEND = ({
-- EXPECT-C: blorp_list_append_owned(__lst, (void*)blorp_string_create("these"));
-- EXPECT-C: blorp_list_append_owned(__lst, (void*)blorp_string_create("args"));
-- EXPECT-C: blorp_release(TO_PREPEND);
-- EXPECT-C: static blorp_String* PREPEND_STR;
-- EXPECT-C: blorp_release_arc_only(PREPEND_STR);
-- EXPECT-C: blorp_register_global_cleanup(__blorp_drop_globals);
-- EXPECT-C: blorp_string_create("these,args")
-- EXPECT-NOT-C: __blorp_static_string_
-- EXPECT-NOT-C: blorp_make_immortal_
TO_PREPEND = ["these", "args"]

PREPEND_STR = TO_PREPEND.join(",")


pure func transform_args(args: List[String]) -> String:
	PREPEND_STR + args
		.join("AHHH")
		.upper()


func main(args: List[String]):
	print(transform_args(args))
