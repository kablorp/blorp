-- EXPECT-C: TO_PREPEND = ({
-- EXPECT-C: BLORP_STATIC_STRING(__blorp_string_literal_1, 5L, "these");
-- EXPECT-C: BLORP_STATIC_STRING(__blorp_string_literal_2, 4L, "args");
-- EXPECT-C: blorp_list_append_owned(__lst, (void*)(blorp_String*)&__blorp_string_literal_1);
-- EXPECT-C: blorp_list_append_owned(__lst, (void*)(blorp_String*)&__blorp_string_literal_2);
-- EXPECT-C: blorp_release(TO_PREPEND);
-- EXPECT-C: BLORP_STATIC_STRING(__blorp_string_literal_3, 10L, "these,args");
-- EXPECT-C: static blorp_String* PREPEND_STR = (blorp_String*)&__blorp_string_literal_3;
-- EXPECT-NOT-C: blorp_release_arc_only(PREPEND_STR);
-- EXPECT-C: blorp_register_global_cleanup(__blorp_drop_globals);
-- EXPECT-NOT-C: blorp_string_create("these,args")
-- EXPECT-NOT-C: blorp_make_immortal_
TO_PREPEND = ["these", "args"]

PREPEND_STR = TO_PREPEND.join(",")


pure func transform_args(args: List[String]) -> String:
	PREPEND_STR + args
		.join("AHHH")
		.upper()


func main(args: List[String]):
	print(transform_args(args))
