-- Local tuple matches that bind direct fields should scalar-replace the tuple
-- allocation before ownership insertion.
-- EXPECT-C: __blorp_internal_tuple_sroa_
-- EXPECT-NOT-C: blorp_tuple_new(2, (void*)(long)(3L), (void*)(long)(7L))
func main(args: List[String]) -> Int:
	pair: (Int, Int) = (3, 7)

	result: Int = match pair:
		(a, b):
			a + b

	if result == 10:
		0
	else:
		1
