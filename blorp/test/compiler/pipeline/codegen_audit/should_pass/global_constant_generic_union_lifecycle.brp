-- EXPECT-C: static Choice__mono_String* CHOSEN;
-- EXPECT-C: CHOSEN = __def_
-- EXPECT-C: Picked(blorp_string_create("static"));
-- EXPECT-C: static Wrapper__mono_String* WRAPPED;
-- EXPECT-C: WRAPPED = __def_
-- EXPECT-C: WrappedValue(Box__mono_String_make(blorp_string_create("nested")));
-- EXPECT-C: blorp_release(WRAPPED);
-- EXPECT-C: blorp_release(CHOSEN);
-- EXPECT-C: blorp_register_global_cleanup(__blorp_drop_globals);
-- EXPECT-NOT-C: __blorp_static_string_
-- EXPECT-NOT-C: blorp_make_immortal_
union Choice[T]:
	Picked(T)
	Missing


record Box[T] {
	value: T
}


union Wrapper[T]:
	WrappedValue(Box[T])
	WrappedMissing


CHOSEN: Choice[String] = Picked("static")

WRAPPED: Wrapper[String] = WrappedValue({value = "nested"})


func main(args: List[String]) -> Int:
	match CHOSEN:
		Picked(value):
			print(value)
		Missing:
			print("missing")

	match WRAPPED:
		WrappedValue(box):
			print(box.value)
		WrappedMissing:
			print("missing")

	0
