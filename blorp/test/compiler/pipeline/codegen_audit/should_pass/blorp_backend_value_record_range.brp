-- EXPECT-C: /* Blorp final Core C artifact */
-- EXPECT-C: typedef struct { long start; long end; } Range;
-- EXPECT-C: static inline Range Range_make(long start, long end)
-- EXPECT-C: Range __range_
-- EXPECT-C-REGEX: brp_vn?_[A-Za-z0-9]+\.start
import:
	range: length


pure func count_range() -> Int:
	r: Range = 1..4
	r.length()


func main(args: List[String]) -> Int:
	if count_range() == 3:
		0
	else:
		1
