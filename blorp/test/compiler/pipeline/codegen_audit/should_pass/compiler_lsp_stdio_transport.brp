-- The compiler-private LSP transport uses the shared typed operation-result
-- bridge. Reads transfer the runtime-owned Bytes payload into the data variant;
-- writes borrow that payload while the operation may park the current fiber.
-- EXPECT-C: blorp_compiler_stdin_read_raw(max_bytes)
-- EXPECT-C: BLORP_COMPILER_STDIN_READ_DATA
-- EXPECT-C: CompilerStdinRawData
-- EXPECT-C: __stdin_op_0.data
-- EXPECT-C: BLORP_COMPILER_STDIN_READ_EOF
-- EXPECT-C: CompilerStdinRawEof;
-- EXPECT-C: blorp_compiler_stdout_write_all_raw(data)
import:
	../../../../../src/compiler/stage_12_lsp/lsp_stdio_transport:
		CompilerStdinReadOutcome(
			CompilerStdinReadData,
			CompilerStdinReadEof,
			CompilerStdinReadFailed,
		),
		compiler_stdin_read,
		compiler_stdout_write_all,


func echo_one_chunk(max_bytes: Int) -> Bool:
	match compiler_stdin_read(max_bytes):
		CompilerStdinReadData(data):
			compiler_stdout_write_all(data).is_ok()
		CompilerStdinReadEof:
			True
		CompilerStdinReadFailed(_):
			False


func main(args: List[String]) -> Int:
	if echo_one_chunk(64):
		0
	else:
		1
