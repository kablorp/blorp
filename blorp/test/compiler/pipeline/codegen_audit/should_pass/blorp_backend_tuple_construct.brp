-- Escaping tuples should stay on the default Blorp final-Core-to-C emitter
-- through the production backend.
--
-- EXPECT-C: /* Blorp final Core C artifact */
-- Semantic callable expectation: blorp_Tuple* make_pair(long a, long b)
-- EXPECT-C-REGEX: blorp_Tuple\* brp_[0-9A-Za-z]+\(long brp_vn?_[A-Za-z0-9]+, long brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C-REGEX: return blorp_tuple_new\(2, \(void\*\)\(long\)\(brp_vn?_[A-Za-z0-9]+\), \(void\*\)\(long\)\(brp_vn?_[A-Za-z0-9]+\)\);
-- Semantic callable expectation: long pair_sum(blorp_Tuple* pair)
-- EXPECT-C-REGEX: long brp_[0-9A-Za-z]+\(blorp_Tuple\* brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C-REGEX: \(\(blorp_Tuple\*\)brp_vn?_[A-Za-z0-9]+\)->elem\[0\]
-- EXPECT-C-REGEX: \(\(blorp_Tuple\*\)brp_vn?_[A-Za-z0-9]+\)->elem\[1\]
pure func make_pair(a: Int, b: Int) -> (Int, Int):
	(a, b)


pure func pair_sum(pair: (Int, Int)) -> Int:
	pair[0] + pair[1]


func main(args: List[String]) -> Int:
	pair: (Int, Int) = make_pair(20, 22)

	if pair_sum(pair) == 42:
		0
	else:
		1
