-- Regression: primitive tensor reads inside a loop whose index range is
-- statically proven in-bounds should lower to raw typed storage reads instead
-- of the checked runtime getter.
--
-- EXPECT-C: double* __tensor_raw_view_
-- EXPECT-C: total = (total + __tensor_raw_view_
-- EXPECT-NOT-C: blorp_checked_get_f64
import:
	float: round, to_int


pure func sum_loop(values: Float[#4]) -> Float:
	var total: Float = 0.0
	for i in 0..length(values):
		total += values[i]
	total


func main(args: List[String]) -> Int:
	to_int(round(sum_loop({1.0, 2.0, 3.0, 4.0})))
