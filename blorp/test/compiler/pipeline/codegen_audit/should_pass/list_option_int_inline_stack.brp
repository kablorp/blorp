-- Generated-C shape audit for List[Option[Int]] storage.
-- EXPECT-C: blorp_list_new_inline(4, sizeof(blorp_StackOption_Int))
-- EXPECT-C: blorp_list_set_raw_copy(__lst,
-- EXPECT-C: memcpy(&item, (char*)__iter_
-- EXPECT-C: ->storage_mode == BLORP_LIST_STORAGE_INLINE
-- EXPECT-NOT-C: blorp_box_struct(&
-- EXPECT-NOT-C: blorp_list_get(__lg_list_
import:
	option: Option(Some, None)


func main(args: List[String]) -> Int:
	items: List[Option[Int]] = [Some(1), None, Some(3), None]
	var total: Int = 0

	for item in items:
		match item:
			Some(n):
				total += n
			None:
				void

	if total == 4:
		0
	else:
		1
