-- Generated-C shape audit for unmanaged @tail_recursive lowering.
--
-- Tail-recursive calls over unmanaged scalar parameters should lower to a
-- local loop. Leaving a C self-call here makes benchmark results depend on the
-- C compiler's optional tail-call optimization.
--
-- EXPECT-C: while (1) {
-- EXPECT-C: continue;
-- Semantic callable expectation: sum_to((n - 1L)
-- EXPECT-NOT-C-REGEX: brp_[0-9A-Za-z]+\(\(n - 1L\)
@tail_recursive
pure func sum_to(n: Int, acc: Int) -> Int:
	if n <= 0:
		acc
	else:
		sum_to(n - 1, acc + n)


func main(args: List[String]) -> Int:
	sum_to(10, 0)
