-- EXPECT-C: blorp_stream_repeat(value, 1)
-- EXPECT-C: void* __call_arg_0 = (void*)(long)(1);
-- EXPECT-C: long __call_arg_1 = 0;
-- EXPECT-C: blorp_stream_repeat(__call_arg_0, __call_arg_1);
import:
	stream: collect, count, repeat, take


func main(args: List[String]) -> Int:
	value: String = "h" + "a"
	items: List[String] = repeat(value)
		.take(3)
		.collect()
	ones: Int = repeat(1)
		.take(3)
		.count()

	if items.length() == 3 and ones == 3:
		0
	else:
		1
