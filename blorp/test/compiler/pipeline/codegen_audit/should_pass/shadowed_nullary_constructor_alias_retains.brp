-- EXPECT-C: blorp_retain(ConstructorShadowEmpty);
union ConstructorShadowValue:
	ConstructorShadowEmpty
	ConstructorShadowPayload(String)


func copy_constructor_shadow(
	ConstructorShadowEmpty: ConstructorShadowValue,
) -> ConstructorShadowValue:
	copied: ConstructorShadowValue = ConstructorShadowEmpty
	copied


func main(args: List[String]) -> Int:
	original: ConstructorShadowValue = ConstructorShadowPayload("retained")
	copied: ConstructorShadowValue = copy_constructor_shadow(original)

	original_ok: Bool = match original:
		ConstructorShadowPayload(value):
			value == "retained"
		ConstructorShadowEmpty:
			False

	copied_ok: Bool = match copied:
		ConstructorShadowPayload(value):
			value == "retained"
		ConstructorShadowEmpty:
			False

	if original_ok and copied_ok:
		0
	else:
		1
