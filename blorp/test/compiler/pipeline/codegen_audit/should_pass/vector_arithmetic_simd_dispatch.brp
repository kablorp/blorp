-- Regression: Float and Float32 vector arithmetic should use direct SIMD kernels
-- and discarded vector results must release the returned owned value.
-- EXPECT-C-REGEX: blorp_simd_vector_add_f64\(brp_vn?_[A-Za-z0-9]+, brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C-REGEX: blorp_simd_vector_add_f32\(brp_vn?_[A-Za-z0-9]+, brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C-REGEX: blorp_release\(blorp_simd_vector_add_f64\(brp_vn?_[A-Za-z0-9]+, brp_vn?_[A-Za-z0-9]+\)\)
-- EXPECT-C-REGEX: blorp_release\(blorp_simd_vector_add_f32\(brp_vn?_[A-Za-z0-9]+, brp_vn?_[A-Za-z0-9]+\)\)
-- EXPECT-NOT-C: blorp_simd_vector_op(0L, 1L
-- EXPECT-NOT-C: blorp_simd_vector_op(0L, 0L
import:
	float: to_float32


func main(args: List[String]) -> Int:
	a64: Float[#64] = vector(1.0, 64)
	b64: Float[#64] = vector(2.0, 64)
	a32: Float32[#64] = vector(to_float32(1.0), 64)
	b32: Float32[#64] = vector(to_float32(2.0), 64)
	_ = a64 + b64
	_ = a32 + b32
	0
