-- Generated-C shape audit for UDP datagram streams using the generic fallible-stream terminal bridge.
-- EXPECT-C: blorp_udp_datagrams_raw(sock, 64)
-- EXPECT-C: blorp_fallible_stream_find_raw_nullable(
-- EXPECT-C: BLORP_FALLIBLE_STREAM_ERROR_DOMAIN_UDP
-- EXPECT-C: net_udp__UdpError*
import:
	net/udp: Datagram, UdpError, datagrams, socket
	stream: find_result


func find_loopback_payload() -> Result[Option[Datagram], UdpError]:
	with sock ?= socket():
		sock
			.datagrams(64)
			.find_result(func(datagram: Datagram): datagram.host == "127.0.0.1")


func main(args: List[String]) -> Int:
	_ = find_loopback_payload()
	0
