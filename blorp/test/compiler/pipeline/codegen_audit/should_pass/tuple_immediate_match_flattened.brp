-- An immediate tuple match subject is a group of values: each element is
-- bound once and tested by its own match, with no tuple allocated.
-- EXPECT-NOT-C: blorp_tuple_new(
-- EXPECT-C-REGEX: brp_vn_[0-9A-Za-z]+ =
func main(args: List[String]) -> Int:
	result: Int = match (0, 5):
		(0, y):
			y
		(_, _):
			99

	if result == 5:
		0
	else:
		1
