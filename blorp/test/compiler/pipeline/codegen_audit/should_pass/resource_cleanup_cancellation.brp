-- EXPECT-C: blorp_task_cleanup_push_with_task(&__blorp_cleanup_reader, &reader, (void*)reader, (blorp_CancelCleanupFn)blorp_file_close_reader, __blorp_task);
-- EXPECT-C: blorp_task_cleanup_pop_slot_with_task(&reader, __blorp_task);
-- EXPECT-C: (void)(blorp_file_close_reader(reader));
import:
	fs: IOError, open_read


func hold_reader_until_cancel(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		sleep(1000)
		Ok(1)


func main(args: List[String]) -> Int:
	_ = hold_reader_until_cancel("")
	0
