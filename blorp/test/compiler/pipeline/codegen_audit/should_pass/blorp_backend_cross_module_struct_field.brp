-- A struct field typed as a struct from another module embeds that struct by
-- value, so its typedef has to be written after the one it depends on. The
-- helper modules land in declaration order `Scan` then `Cursor`, so an emitter
-- that follows declaration order alone writes C that does not compile.
--
-- EXPECT-C-REGEX: ^typedef struct \{ long offset; long line; \} [A-Za-z0-9_]*z_base__Cursor;$
-- EXPECT-C-REGEX: ^typedef struct \{ [A-Za-z0-9_]*z_base__Cursor end; _Bool saw_dot; \} [A-Za-z0-9_]*b_scan__Scan;$
import:
	cross_module_struct_field/b_scan: Scan, make_scan, scan_offset


func main(_: List[String]) -> Int:
	scan: Scan = make_scan(7)
	print(scan_offset(scan).to_string())
	0
