-- A managed record field from another module stores a typed owned pointer.
-- Scan is declared before Cursor; a forward declaration makes that legal,
-- while Scan's destructor releases the imported child.
--
-- EXPECT-C: typedef struct brp_ty2 brp_ty2;
-- EXPECT-C: brp_ty2* f0;
-- EXPECT-C: _Bool f1;
-- EXPECT-C: brp_ty0* brp_ty0_make(brp_ty2* f0, int f1)
-- EXPECT-C: brp_ty2* brp_ty2_make(long f0, long f1)
-- EXPECT-C: if (__rec->f0) blorp_release((blorp_Object*)__rec->f0);
import:
	cross_module_struct_field/b_scan: Scan, make_scan, scan_offset


func main(_: List[String]) -> Int:
	scan: Scan = make_scan(7)
	print(scan_offset(scan).to_string())
	0
