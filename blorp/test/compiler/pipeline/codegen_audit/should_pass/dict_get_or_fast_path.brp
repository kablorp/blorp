-- Generated-C shape audit for Dict.get_or.
--
-- get_or should probe the dict directly and return either the retained slot
-- value or the default, without allocating an intermediate Option.
--
-- EXPECT-C: __dict_get_or_value
-- EXPECT-C: __dict_lookup_hash
-- EXPECT-C: __dict_lookup_found_slot
-- EXPECT-C: blorp_hash_int((long)(intptr_t)__dict_lookup_key)
-- EXPECT-NOT-C: blorp_dict_get((blorp_Dict*)
import:
	dict: Dict, dict, get_or, set


func main(args: List[String]) -> Int:
	d: Dict[Int, Int] = dict()
		.set(1, 10)
		.set(2, 20)
	value: Int = get_or(d, 2, 0)
	if value == 20:
		0
	else:
		1
