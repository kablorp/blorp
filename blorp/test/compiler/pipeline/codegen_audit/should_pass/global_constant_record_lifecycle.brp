-- EXPECT-C: static CounterBox* NESTED_COUNTER;
-- EXPECT-C: Counter* __record_field_0 = Counter_make(3);
-- EXPECT-C: BLORP_STATIC_STRING(__blorp_string_literal_0, 6L, "nested");
-- EXPECT-C: blorp_String* __record_field_1 = (blorp_String*)&__blorp_string_literal_0;
-- EXPECT-C: CounterBox* __record_result_2 = CounterBox_make(__record_field_0, __record_field_1);
-- EXPECT-C: NESTED_COUNTER = __record_result_2;
-- EXPECT-C: blorp_release(NESTED_COUNTER);
-- EXPECT-C: blorp_register_global_cleanup(__blorp_drop_globals);
-- EXPECT-NOT-C: blorp_string_create("nested")
-- EXPECT-NOT-C: blorp_make_immortal_
record Counter {
	value: Int
}


record CounterBox {
	counter: Counter,
	text: String
}


NESTED_COUNTER: CounterBox = {
	counter = {value = 3},
	text = "nested"
}


func main(args: List[String]) -> Int:
	if NESTED_COUNTER.counter.value == 3 and NESTED_COUNTER.text == "nested":
		0
	else:
		1
