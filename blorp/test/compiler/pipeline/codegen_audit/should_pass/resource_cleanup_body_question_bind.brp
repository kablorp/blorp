-- EXPECT-C: (void)(blorp_file_close_reader(reader));
-- EXPECT-C: __tn_1 = __tu_
import:
	fs: IOError(NotFound), open_read


func fail_int(path: String) -> Result[Int, IOError]:
	Err(NotFound(path))


func open_then_fail(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		value ?= fail_int(path)
		Ok(value)


func main(args: List[String]) -> Int:
	_ = open_then_fail("")
	0
