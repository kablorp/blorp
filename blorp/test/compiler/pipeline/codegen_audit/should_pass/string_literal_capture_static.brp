-- An immutable local literal used by a lambda should become a direct pooled
-- reference. The closure is static and has no literal capture environment.
-- EXPECT-C: BLORP_STATIC_STRING(__blorp_string_literal_0, 8L, "captured");
-- EXPECT-C-REGEX: blorp_String\* brp_vn?_[A-Za-z0-9]+ = \(blorp_String\*\)&__blorp_string_literal_0;
-- EXPECT-C: return (void*)(blorp_String*)&__blorp_string_literal_0;
-- EXPECT-C: static blorp_Closure
-- EXPECT-NOT-C-REGEX: blorp_retain\(\(blorp_Object\*\)brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-NOT-C: blorp_closure_new_inline
func main(args: List[String]) -> Int:
	label: String = "captured"
	read: () -> String = func(): label

	if read() == "captured":
		0
	else:
		1
