-- Erased union storage boxes value structs in heap objects. Those
-- representation-created objects need a release-mask bit even though their
-- source values are unmanaged.
-- EXPECT-C: struct { void* field0; } StructPayload;
-- EXPECT-C-REGEX: brp_ty2\* __def_[0-9]+_StructPayload\(void\* field0, unsigned long release_mask\)
-- EXPECT-C-REGEX: __def_[0-9]+_StructPayload\(.*blorp_box_struct.*1UL\)
-- EXPECT-C-REGEX: static inline brp_ty2\* __blorp_reuse_ErasedMixedPayload___def_[0-9]+_StructPayload\(brp_ty2\* __old, void\* field0, unsigned long release_mask\)
-- EXPECT-C: __old->release_mask = release_mask;
-- EXPECT-C-REGEX: brp_ty2\* __fresh = __def_[0-9]+_StructPayload\(field0, release_mask\);
-- EXPECT-C-REGEX: if \(\(self->release_mask & 1UL\) && self->data\.StructPayload\.field0\) blorp_release\(self->data\.StructPayload\.field0\);

struct Point {
	value: Int
}


union ErasedMixedPayload:
	StructPayload(Point)
	TextPayload(String)


pure func make_point(value: Int) -> Point:
	{ value = value }


pure func payload_score(payload: ErasedMixedPayload) -> Int:
	match payload:
		StructPayload(point):
			point.value
		TextPayload(text):
			text.length()


func main(args: List[String]) -> Int:
	if (
		payload_score(StructPayload(make_point(7))) == 7
		and payload_score(TextPayload("managed")) == 7
	):
		0
	else:
		1
