-- EXPECT-C: static struct { blorp_Object header; long len; long capacity; void (*elem_release)(void*); int16_t elem_size; uint8_t storage_mode; char __pad[5]; float data[2]; } __blorp_static_list_WEIGHTS32 =
-- EXPECT-C: BLORP_LIST_STORAGE_INLINE,
-- EXPECT-C: ((float)(1.25)),
-- EXPECT-C: ((float)(2.5)),
-- EXPECT-C: static blorp_List* WEIGHTS32 = (blorp_List*)&__blorp_static_list_WEIGHTS32;
