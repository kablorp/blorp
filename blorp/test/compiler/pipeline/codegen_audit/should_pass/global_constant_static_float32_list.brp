WEIGHTS32: List[Float32] = [to_float32(1.25), to_float32(2.5)]


func main(args: List[String]) -> Int:
	var total: Float32 = to_float32(0.0)

	for weight in WEIGHTS32:
		total += weight

	if total == to_float32(3.75):
		0
	else:
		1
