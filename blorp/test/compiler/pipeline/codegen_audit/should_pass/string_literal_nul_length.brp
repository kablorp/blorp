-- EXPECT-C: BLORP_STATIC_STRING(__blorp_string_literal_0, 3L, "a\000b");
-- EXPECT-C: blorp_String* value = (blorp_String*)&__blorp_string_literal_0;
-- EXPECT-NOT-C: blorp_string_create_len("a\000b", 3L)
-- EXPECT-NOT-C: blorp_string_create("a\000b")
func main(args: List[String]) -> Int:
	value: String = "a\0b"

	if value.length() == 3:
		0
	else:
		1
