-- String length consumers should fuse through known string producers without
-- materializing intermediate strings.
-- EXPECT-C: __blorp_internal_string_pipeline_10_trim_start_
-- EXPECT-C: __blorp_internal_string_pipeline_13_replace_count_
-- EXPECT-C: ((blorp_String*)__blorp_internal_string_pipeline_6_source_
import:
	string: replace, take_left, trim


pure func fused_len(s: String) -> Int:
	s
		.trim()
		.take_left(5)
		.replace("a", "xy")
		.length()


func main(args: List[String]) -> Int:
	if fused_len("  abacad  ") == 8:
		0
	else:
		1
