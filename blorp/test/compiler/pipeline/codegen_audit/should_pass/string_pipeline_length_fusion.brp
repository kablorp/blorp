-- String length consumers should fuse through known string producers without
-- materializing intermediate strings.
-- EXPECT-C-REGEX: \(\(blorp_String\*\)brp_vn?_[A-Za-z0-9]+
import:
	string: replace, take_left, trim


pure func fused_len(s: String) -> Int:
	s
		.trim()
		.take_left(5)
		.replace("a", "xy")
		.length()


func main(args: List[String]) -> Int:
	if fused_len("  abacad  ") == 8:
		0
	else:
		1
