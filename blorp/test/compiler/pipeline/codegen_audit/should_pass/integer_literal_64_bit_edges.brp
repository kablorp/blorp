-- 64-bit integer literals at the edges of their types must be C constants of
-- the right signedness. UInt64 values above Int's maximum carry an unsigned
-- suffix, and Int's minimum, whether written as one literal or reaching Core
-- as the negation of its magnitude, is spelled without an out-of-range
-- signed literal. The audit's clang sweep rejects implicitly unsigned literals.
-- EXPECT-C-REGEX: return 18446744073709551615ULL;
-- EXPECT-C-REGEX: return \(-9223372036854775807L - 1L\);
-- EXPECT-C-REGEX: == 18446744073709551615ULL
-- EXPECT-C-REGEX: == \(-9223372036854775807L - 1L\)
-- EXPECT-C-REGEX: = 18446744073709551615ULL;
-- EXPECT-C-REGEX: = \(-9223372036854775807L - 1L\);
-- EXPECT-NOT-C: 18446744073709551615L;
-- EXPECT-NOT-C: 9223372036854775808
private LARGEST_WORD: UInt64 = 18446744073709551615

private SMALLEST_INT: Int = -9223372036854775808


pure func word_max() -> UInt64:
	18446744073709551615


pure func int_min() -> Int:
	-9223372036854775808


pure func is_word_max(value: UInt64) -> Bool:
	match value:
		18446744073709551615:
			True
		_:
			False


pure func is_int_min(value: Int) -> Bool:
	match value:
		-9223372036854775808:
			True
		_:
			False


func main(args: List[String]) -> Int:
	print(word_max().to_string())
	print(int_min().to_string())
	print(is_word_max(LARGEST_WORD).to_string())
	print(is_int_min(SMALLEST_INT).to_string())
	0
