-- TCP chunk streams should use the shared fallible-stream terminal ABI with a
-- TCP error domain instead of protocol-specific terminal builtins.
-- EXPECT-C: blorp_tcp_chunks_raw(stream, 64)
-- EXPECT-C: blorp_fallible_stream_find_raw_nullable(
-- EXPECT-C: BLORP_FALLIBLE_STREAM_ERROR_DOMAIN_TCP
-- EXPECT-C: std_net_tcp__TcpError*
import:
	net/tcp: IpFamily(IPv4), TcpError, chunks, connect_loopback, port
	stream: find_result


func has_chunk() -> Result[Bool, TcpError]:
	remote ?= port(1)

	with stream ?= connect_loopback(IPv4, remote):
		found ?= chunks(stream, 64).find_result(func(chunk: Bytes): chunk.length() > 0)

		match found:
			Some(_):
				Ok(True)
			None:
				Ok(False)


func main(args: List[String]) -> Int:
	match has_chunk():
		Ok(ok):
			if ok:
				0
			else:
				1
		Err(_):
			0
