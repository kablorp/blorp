-- Generated-C shape audit for source unions with struct and fieldless-enum
-- payload fields (docs/STRUCT_PAYLOAD_ROADMAP.md step S1). A union whose
-- every field is a scalar, a struct, or a fieldless enum gets
-- TypedUnionPayloadStorage: the struct is held by value, the enum by its
-- int tag, no `blorp_box_struct` and no `release_mask`.
-- EXPECT-C-REGEX: typedef struct [A-Za-z0-9_]+ \{
-- EXPECT-C-REGEX: struct \{ [A-Za-z0-9_]+ field0; double field1; \} Circle;
-- EXPECT-C: struct { long field0; long field1; } Tagged;
-- EXPECT-NOT-C: blorp_box_struct(&__box_struct_value, sizeof(Vec2))
-- EXPECT-NOT-C: Shape_destroy
struct Vec2 {
	x: Float,
	y: Float
}


enum Color:
	Red
	Green
	Blue


union Shape:
	Circle(Vec2, Float)
	Tagged(Color, Int)


func area(shape: Shape) -> Float:
	match shape:
		Circle(_, radius):
			radius * radius
		Tagged(_, n):
			n.to_float()


func main(args: List[String]) -> Int:
	shapes: List[Shape] = [
		Circle({ x = 1.0, y = 2.0 }, 3.0),
		Tagged(Green, 4),
	]
	var total: Float = 0.0

	for shape in shapes:
		total = total + area(shape)

	if total > 0.0:
		0
	else:
		1
