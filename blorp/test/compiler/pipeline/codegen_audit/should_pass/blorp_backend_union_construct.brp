-- Primitive-payload heap unions should stay on the Blorp final-Core-to-C
-- backend. This guards against treating union constructors as raw user calls.
--
-- EXPECT-C: /* Blorp final Core C artifact */
-- EXPECT-C-REGEX: typedef struct [A-Za-z0-9_]+ \{
-- EXPECT-C: struct { long field0; } Picked;
-- EXPECT-C: #define TAG_Choice_Picked 0
-- EXPECT-C-REGEX: [A-Za-z0-9_]+\* __def_
-- Semantic callable expectation: Choice* make_choice(long n)
-- EXPECT-C-REGEX: [A-Za-z0-9_]+\* brp_[0-9A-Za-z]+\(long brp_vn?_[A-Za-z0-9]+\)
-- EXPECT-C: return __def_
-- Semantic callable expectation: Choice* choice = make_choice(42);
-- EXPECT-C-REGEX: [A-Za-z0-9_]+\* brp_vn?_[A-Za-z0-9]+ = brp_[0-9A-Za-z]+\(42\);
-- EXPECT-C-REGEX: blorp_release\(brp_vn?_[A-Za-z0-9]+\);
union Choice:
	Picked(Int)


pure func make_choice(n: Int) -> Choice:
	Picked(n)


func main(args: List[String]) -> Int:
	choice: Choice = make_choice(42)
	0
