-- Generated-C shape audit for Stream[T] for-loop lowering.
-- EXPECT-C: blorp_Stream* __tF_
-- EXPECT-C: blorp_stream_next_raw(__tF_
-- EXPECT-C: blorp_stream_release_pulled_if_owned(__tF_
import:
	stream as S


func main(args: List[String]) -> Int:
	var total: Int = 0
	for n in S.from_list([1, 2, 3]):
		total += n
	total
