-- EXPECT-C: BLORP_STATIC_STRING(__blorp_string_literal_0, 7L, "rounded");
-- EXPECT-C: static blorp_String* ROUNDING_LABEL = (blorp_String*)&__blorp_string_literal_0;
-- EXPECT-NOT-C: blorp_release_arc_only(ROUNDING_LABEL);
-- EXPECT-NOT-C: blorp_string_create("rounded")
-- EXPECT-NOT-C: not-yet
ROUNDING_LABEL: String = if to_float16(1.0001) == to_float16(1.0):
	"rounded"
else:
	"not-yet"


func main(args: List[String]) -> Int:
	if ROUNDING_LABEL == "rounded":
		0
	else:
		1
