-- Erased union slots for Int128 and UInt128 must store allocated boxes and
-- set their release-mask bits; integer bit patterns are not object pointers.
-- EXPECT-C-REGEX: WideBoxProbe\* __def_[0-9]+_SignedValue\(void\* field0, unsigned long release_mask\)
-- EXPECT-C-REGEX: WideBoxProbe\* __def_[0-9]+_UnsignedValue\(void\* field0, unsigned long release_mask\)
-- EXPECT-C-REGEX: __def_[0-9]+_SignedValue\(blorp_box_int128\(.*\), 1UL\)
-- EXPECT-C-REGEX: __def_[0-9]+_UnsignedValue\(blorp_box_uint128\(.*\), 1UL\)
-- EXPECT-C-REGEX: if \(\(self->release_mask & 1UL\) && self->data\.SignedValue\.field0\) blorp_release\(self->data\.SignedValue\.field0\);
-- EXPECT-C-REGEX: if \(\(self->release_mask & 1UL\) && self->data\.UnsignedValue\.field0\) blorp_release\(self->data\.UnsignedValue\.field0\);

union WideBoxProbe:
	SignedValue(Int128)
	UnsignedValue(UInt128)
	Text(String)


pure func matches_signed(payload: WideBoxProbe) -> Bool:
	match payload:
		SignedValue(value):
			expected: Int128 = 42
			value == expected
		_:
			False


pure func matches_unsigned(payload: WideBoxProbe) -> Bool:
	match payload:
		UnsignedValue(value):
			expected: UInt128 = 43
			value == expected
		_:
			False


func main(args: List[String]) -> Int:
	if matches_signed(SignedValue(42)) and matches_unsigned(UnsignedValue(43)):
		0
	else:
		1
