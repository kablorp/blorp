-- EXPECT-C: return (operator_left + operator_right);
-- EXPECT-C: return (explicit_left + explicit_right);
-- EXPECT-C: return (generic_left + generic_right);
-- EXPECT-C: return (operator_left - operator_right);
-- EXPECT-C: return (explicit_left - explicit_right);
-- EXPECT-C: return (generic_left - generic_right);
-- EXPECT-C: return (operator_left * operator_right);
-- EXPECT-C: return (explicit_left * explicit_right);
-- EXPECT-C: return (generic_left * generic_right);
-- EXPECT-CALLABLE: Divisible_divide_Pair16
-- EXPECT-CALLABLE: Modulable_remainder_Pair16
-- EXPECT-CALLABLE: Addable_add_Pair16
-- EXPECT-CALLABLE: Subtractable_subtract_Pair16
-- EXPECT-CALLABLE: Multipliable_multiply_Pair16
-- EXPECT-NOT-CALLABLE: Addable_add_Int16
-- EXPECT-NOT-CALLABLE: Subtractable_subtract_Int16
-- EXPECT-NOT-CALLABLE: Multipliable_multiply_Int16
-- EXPECT-NOT-CALLABLE: Divisible_divide_Int16
-- EXPECT-NOT-CALLABLE: Modulable_remainder_Int16
-- EXPECT-NOT-CALLABLE: Addable_add_String
-- EXPECT-NOT-CALLABLE: Addable_add_Fixed
-- EXPECT-NOT-CALLABLE: Subtractable_subtract_Fixed
-- EXPECT-NOT-CALLABLE: Multipliable_multiply_Fixed
-- EXPECT-NOT-CALLABLE: Divisible_divide_Fixed
import:
	fixed: fixed
	int: INT_MIN
	traits: FloatingPoint, add, divide, multiply, remainder, subtract


record Pair16 {
	left: Int16,
	right: Int16
}


var arithmetic_operand_calls: Int = 0


func counted_dividend() -> Int16:
	arithmetic_operand_calls += 1
	84


func counted_divisor() -> Int16:
	arithmetic_operand_calls += 1
	2


implements Addable for Pair16:
	pure func add(a: Pair16, b: Pair16) -> Pair16:
		{
			left = a.left + b.left,
			right = a.right + b.right
		}


implements Subtractable for Pair16:
	pure func subtract(a: Pair16, b: Pair16) -> Pair16:
		{
			left = a.left - b.left,
			right = a.right - b.right
		}


implements Multipliable for Pair16:
	pure func multiply(a: Pair16, b: Pair16) -> Pair16:
		{
			left = a.left * b.left,
			right = a.right * b.right
		}


implements Divisible for Pair16:
	pure func divide(a: Pair16, b: Pair16) -> Pair16:
		{
			left = a.left / b.left,
			right = a.right / b.right
		}


implements Modulable for Pair16:
	pure func remainder(a: Pair16, b: Pair16) -> Pair16:
		{
			left = a.left % b.left,
			right = a.right % b.right
		}


pure func operator_add(operator_left: Int16, operator_right: Int16) -> Int16:
	operator_left + operator_right


pure func explicit_add(explicit_left: Int16, explicit_right: Int16) -> Int16:
	add(explicit_left, explicit_right)


pure func generic_add[T:Addable](generic_left: T, generic_right: T) -> T:
	generic_left + generic_right


pure func record_add(left: Pair16, right: Pair16) -> Pair16:
	left + right


pure func operator_subtract(operator_left: Int16, operator_right: Int16) -> Int16:
	operator_left - operator_right


pure func explicit_subtract(explicit_left: Int16, explicit_right: Int16) -> Int16:
	subtract(explicit_left, explicit_right)


pure func generic_subtract[T:Subtractable](generic_left: T, generic_right: T) -> T:
	generic_left - generic_right


pure func record_subtract(left: Pair16, right: Pair16) -> Pair16:
	left - right


pure func operator_multiply(operator_left: Int16, operator_right: Int16) -> Int16:
	operator_left * operator_right


pure func explicit_multiply(explicit_left: Int16, explicit_right: Int16) -> Int16:
	multiply(explicit_left, explicit_right)


pure func generic_multiply[T:Multipliable](generic_left: T, generic_right: T) -> T:
	generic_left * generic_right


pure func record_multiply(left: Pair16, right: Pair16) -> Pair16:
	left * right


pure func operator_divide(operator_left: Int16, operator_right: Int16) -> Int16:
	operator_left / operator_right


pure func explicit_divide(explicit_left: Int16, explicit_right: Int16) -> Int16:
	divide(explicit_left, explicit_right)


pure func generic_divide[T:Divisible](generic_left: T, generic_right: T) -> T:
	generic_left / generic_right


pure func record_divide(left: Pair16, right: Pair16) -> Pair16:
	left / right


pure func operator_remainder(operator_left: Int16, operator_right: Int16) -> Int16:
	operator_left % operator_right


pure func explicit_remainder(explicit_left: Int16, explicit_right: Int16) -> Int16:
	remainder(explicit_left, explicit_right)


pure func generic_remainder[T:Modulable](generic_left: T, generic_right: T) -> T:
	generic_left % generic_right


pure func floating_point_remainder[T:FloatingPoint](left: T, right: T) -> T:
	left % right


pure func record_remainder(left: Pair16, right: Pair16) -> Pair16:
	left % right


pure func explicit_string_add(left: String, right: String) -> String:
	add(left, right)


pure func explicit_fixed_add(left: Fixed, right: Fixed) -> Fixed:
	add(left, right)


pure func explicit_fixed_subtract(left: Fixed, right: Fixed) -> Fixed:
	subtract(left, right)


pure func explicit_fixed_multiply(left: Fixed, right: Fixed) -> Fixed:
	multiply(left, right)


pure func explicit_fixed_divide(left: Fixed, right: Fixed) -> Fixed:
	divide(left, right)


pure func all_numeric_explicit_adds() -> Bool:
	(
		add(1, 2) == 3
		and add(to_int8(1), to_int8(2)) == to_int8(3)
		and add(to_int16(1), to_int16(2)) == to_int16(3)
		and add(to_int32(1), to_int32(2)) == to_int32(3)
		and add(to_int128(1), to_int128(2)) == to_int128(3)
		and add(to_uint8(1), to_uint8(2)) == to_uint8(3)
		and add(to_uint16(1), to_uint16(2)) == to_uint16(3)
		and add(to_uint32(1), to_uint32(2)) == to_uint32(3)
		and add(to_uint64(1), to_uint64(2)) == to_uint64(3)
		and add(to_uint128(1), to_uint128(2)) == to_uint128(3)
		and add(1.0, 2.0) == 3.0
		and add(to_float16(1.0), to_float16(2.0)) == to_float16(3.0)
		and add(to_float32(1.0), to_float32(2.0)) == to_float32(3.0)
	)


pure func all_numeric_explicit_subtracts() -> Bool:
	(
		subtract(3, 2) == 1
		and subtract(to_int8(3), to_int8(2)) == to_int8(1)
		and subtract(to_int16(3), to_int16(2)) == to_int16(1)
		and subtract(to_int32(3), to_int32(2)) == to_int32(1)
		and subtract(to_int128(3), to_int128(2)) == to_int128(1)
		and subtract(to_uint8(3), to_uint8(2)) == to_uint8(1)
		and subtract(to_uint16(3), to_uint16(2)) == to_uint16(1)
		and subtract(to_uint32(3), to_uint32(2)) == to_uint32(1)
		and subtract(to_uint64(3), to_uint64(2)) == to_uint64(1)
		and subtract(to_uint128(3), to_uint128(2)) == to_uint128(1)
		and subtract(3.0, 2.0) == 1.0
		and subtract(to_float16(3.0), to_float16(2.0)) == to_float16(1.0)
		and subtract(to_float32(3.0), to_float32(2.0)) == to_float32(1.0)
	)


pure func all_numeric_explicit_multiplies() -> Bool:
	(
		multiply(6, 7) == 42
		and multiply(to_int8(6), to_int8(7)) == to_int8(42)
		and multiply(to_int16(6), to_int16(7)) == to_int16(42)
		and multiply(to_int32(6), to_int32(7)) == to_int32(42)
		and multiply(to_int128(6), to_int128(7)) == to_int128(42)
		and multiply(to_uint8(6), to_uint8(7)) == to_uint8(42)
		and multiply(to_uint16(6), to_uint16(7)) == to_uint16(42)
		and multiply(to_uint32(6), to_uint32(7)) == to_uint32(42)
		and multiply(to_uint64(6), to_uint64(7)) == to_uint64(42)
		and multiply(to_uint128(6), to_uint128(7)) == to_uint128(42)
		and multiply(6.0, 7.0) == 42.0
		and multiply(to_float16(6.0), to_float16(7.0)) == to_float16(42.0)
		and multiply(to_float32(6.0), to_float32(7.0)) == to_float32(42.0)
	)


pure func all_numeric_explicit_divides() -> Bool:
	(
		divide(84, 2) == 42
		and divide(to_int8(84), to_int8(2)) == to_int8(42)
		and divide(to_int16(84), to_int16(2)) == to_int16(42)
		and divide(to_int32(84), to_int32(2)) == to_int32(42)
		and divide(to_int128(84), to_int128(2)) == to_int128(42)
		and divide(to_uint8(84), to_uint8(2)) == to_uint8(42)
		and divide(to_uint16(84), to_uint16(2)) == to_uint16(42)
		and divide(to_uint32(84), to_uint32(2)) == to_uint32(42)
		and divide(to_uint64(84), to_uint64(2)) == to_uint64(42)
		and divide(to_uint128(84), to_uint128(2)) == to_uint128(42)
		and divide(84.0, 2.0) == 42.0
		and divide(to_float16(84.0), to_float16(2.0)) == to_float16(42.0)
		and divide(to_float32(84.0), to_float32(2.0)) == to_float32(42.0)
	)


pure func int128_minimum() -> Int128:
	var result: Int128 = to_int128(-1)

	for _ in 0..127:
		result *= to_int128(2)

	result


pure func all_signed_minimum_divisions_wrap() -> Bool:
	min_int128: Int128 = int128_minimum()

	(
		divide(INT_MIN, -1) == INT_MIN
		and divide(to_int8(-128), to_int8(-1)) == to_int8(-128)
		and divide(to_int16(-32768), to_int16(-1)) == to_int16(-32768)
		and divide(to_int32(-2147483648), to_int32(-1)) == to_int32(-2147483648)
		and divide(min_int128, to_int128(-1)) == min_int128
	)


pure func all_numeric_explicit_remainders() -> Bool:
	(
		remainder(85, 43) == 42
		and remainder(to_int8(85), to_int8(43)) == to_int8(42)
		and remainder(to_int16(85), to_int16(43)) == to_int16(42)
		and remainder(to_int32(85), to_int32(43)) == to_int32(42)
		and remainder(to_int128(85), to_int128(43)) == to_int128(42)
		and remainder(to_uint8(85), to_uint8(43)) == to_uint8(42)
		and remainder(to_uint16(85), to_uint16(43)) == to_uint16(42)
		and remainder(to_uint32(85), to_uint32(43)) == to_uint32(42)
		and remainder(to_uint64(85), to_uint64(43)) == to_uint64(42)
		and remainder(to_uint128(85), to_uint128(43)) == to_uint128(42)
		and remainder(85.0, 43.0) == 42.0
		and remainder(to_float16(85.0), to_float16(43.0)) == to_float16(42.0)
		and remainder(to_float32(85.0), to_float32(43.0)) == to_float32(42.0)
	)


pure func all_signed_minimum_remainders_are_zero() -> Bool:
	min_int128: Int128 = int128_minimum()

	(
		remainder(INT_MIN, -1) == 0
		and remainder(to_int8(-128), to_int8(-1)) == to_int8(0)
		and remainder(to_int16(-32768), to_int16(-1)) == to_int16(0)
		and remainder(to_int32(-2147483648), to_int32(-1)) == to_int32(0)
		and remainder(min_int128, to_int128(-1)) == to_int128(0)
	)


func division_evaluates_operands_once() -> Bool:
	arithmetic_operand_calls = 0
	result: Int16 = counted_dividend() / counted_divisor()
	result == to_int16(42) and arithmetic_operand_calls == 2


func remainder_evaluates_operands_once() -> Bool:
	arithmetic_operand_calls = 0
	result: Int16 = counted_dividend() % counted_divisor()
	result == to_int16(0) and arithmetic_operand_calls == 2


func main(args: List[String]) -> Int:
	left_pair: Pair16 = {
		left = 52,
		right = 62
	}
	right_pair: Pair16 = {
		left = 10,
		right = 20
	}
	multiply_left_pair: Pair16 = {
		left = 6,
		right = 7
	}
	multiply_right_pair: Pair16 = {
		left = 7,
		right = 6
	}
	added_pair: Pair16 = record_add(
		{
			left = 20,
			right = 30
		},
		{
			left = 22,
			right = 12
		},
	)
	subtracted_pair: Pair16 = record_subtract(left_pair, right_pair)
	multiplied_pair: Pair16 = record_multiply(multiply_left_pair, multiply_right_pair)
	divided_pair: Pair16 = record_divide(
		{
			left = 84,
			right = 126
		},
		{
			left = 2,
			right = 3
		},
	)
	remainder_pair: Pair16 = record_remainder(
		{
			left = 85,
			right = 127
		},
		{
			left = 43,
			right = 85
		},
	)

	if (
		explicit_string_add("trait ", "target") == "trait target"
		and generic_add("trait ", "target") == "trait target"
		and explicit_fixed_add(
			fixed(20.0, 0),
			fixed(22.0, 0),
		) == fixed(42.0, 0)
		and explicit_fixed_subtract(
			fixed(52.0, 0),
			fixed(10.0, 0),
		) == fixed(42.0, 0)
		and explicit_fixed_multiply(
			fixed(6.0, 0),
			fixed(7.0, 0),
		) == fixed(42.0, 0)
		and explicit_fixed_divide(
			fixed(84.0, 0),
			fixed(2.0, 0),
		) == fixed(42.0, 0)
		and generic_add(
			fixed(20.0, 0),
			fixed(22.0, 0),
		) == fixed(42.0, 0)
		and generic_subtract(
			fixed(52.0, 0),
			fixed(10.0, 0),
		) == fixed(42.0, 0)
		and generic_multiply(
			fixed(6.0, 0),
			fixed(7.0, 0),
		) == fixed(42.0, 0)
		and generic_divide(
			fixed(84.0, 0),
			fixed(2.0, 0),
		) == fixed(42.0, 0)
		and to_int(operator_add(20, 22)) == 42
		and to_int(explicit_add(20, 22)) == 42
		and to_int(generic_add(to_int16(20), to_int16(22))) == 42
		and to_int(operator_add(32767, 1)) == -32768
		and to_int(added_pair.left) == 42
		and to_int(added_pair.right) == 42
		and all_numeric_explicit_adds()
		and to_int(operator_subtract(52, 10)) == 42
		and to_int(explicit_subtract(52, 10)) == 42
		and to_int(generic_subtract(to_int16(52), to_int16(10))) == 42
		and to_int(operator_subtract(-32768, 1)) == 32767
		and to_int(subtracted_pair.left) == 42
		and to_int(subtracted_pair.right) == 42
		and all_numeric_explicit_subtracts()
		and to_int(operator_multiply(6, 7)) == 42
		and to_int(explicit_multiply(6, 7)) == 42
		and to_int(generic_multiply(to_int16(6), to_int16(7))) == 42
		and to_int(operator_multiply(32767, 2)) == -2
		and to_int(multiplied_pair.left) == 42
		and to_int(multiplied_pair.right) == 42
		and all_numeric_explicit_multiplies()
		and to_int(operator_divide(84, 2)) == 42
		and to_int(explicit_divide(84, 2)) == 42
		and to_int(generic_divide(to_int16(84), to_int16(2))) == 42
		and to_int(operator_divide(84, 0)) == 0
		and to_int(operator_divide(-32768, -1)) == -32768
		and to_int(divided_pair.left) == 42
		and to_int(divided_pair.right) == 42
		and all_numeric_explicit_divides()
		and all_signed_minimum_divisions_wrap()
		and division_evaluates_operands_once()
		and to_int(operator_remainder(85, 43)) == 42
		and to_int(explicit_remainder(85, 43)) == 42
		and to_int(generic_remainder(to_int16(85), to_int16(43))) == 42
		and to_int(operator_remainder(85, 0)) == 0
		and to_int(remainder_pair.left) == 42
		and to_int(remainder_pair.right) == 42
		and all_numeric_explicit_remainders()
		and floating_point_remainder(85.0, 43.0) == 42.0
		and floating_point_remainder(to_float16(85.0), to_float16(43.0)) == to_float16(42.0)
		and floating_point_remainder(to_float32(85.0), to_float32(43.0)) == to_float32(42.0)
		and all_signed_minimum_remainders_are_zero()
		and remainder_evaluates_operands_once()
	):
		0
	else:
		1
