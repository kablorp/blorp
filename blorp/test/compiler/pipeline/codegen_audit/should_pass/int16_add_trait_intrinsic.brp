-- EXPECT-CALLABLE: Addable_add_Pair16
-- EXPECT-CALLABLE: Subtractable_subtract_Pair16
-- EXPECT-CALLABLE: Multipliable_multiply_Pair16
-- EXPECT-CALLABLE: Negatable_negate_Pair16
