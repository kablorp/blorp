-- Runtime builtins may return runtime-declared ABI layouts such as
-- blorp_Result* and blorp_MemStats. Generated std wrappers must preserve each layout.
-- EXPECT-C: return blorp_stack_result_from_boxed((blorp_Result*)blorp_read_file(path));
-- EXPECT-C: static inline blorp_MemStats MemStats_make(
-- EXPECT-C: return blorp_get_mem_stats();
import:
	memory: get_mem_stats, mem_delta
	system: read_file


func main(args: List[String]) -> Int:
	before = get_mem_stats()
	after = get_mem_stats()
	_ = mem_delta(before, after)

	match read_file("/tmp/blorp_codegen_audit_missing_file"):
		Ok(_):
			1
		Err(_):
			0
