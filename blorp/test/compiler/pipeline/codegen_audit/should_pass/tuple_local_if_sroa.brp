-- A local tuple binding whose RHS is a tuple-valued if should scalar-replace
-- when the binding is used only through tuple fields. The condition must still
-- be evaluated once, and each selected tuple element should stay explicit.
-- EXPECT-C: __blorp_internal_tuple_sroa_cond_
-- EXPECT-C: __blorp_internal_tuple_sroa_
-- Semantic callable expectation: mark(20
-- EXPECT-C-REGEX: brp_[0-9A-Za-z]+\(20
-- Semantic callable expectation: mark(22
-- EXPECT-C-REGEX: brp_[0-9A-Za-z]+\(22
-- EXPECT-NOT-C: blorp_tuple_new(2, (void*)(long)(
func mark(x: Int) -> Int:
	x


func main(args: List[String]) -> Int:
	pair: (Int, Int) = if True:
		(mark(20), mark(22))
	else:
		(mark(1), mark(2))

	if pair[0] + pair[1] == 42:
		0
	else:
		1
