-- List.contains should scan directly instead of allocating a predicate closure
-- and routing through the pure/impure any overloads.
-- Semantic callable expectation: int list__contains__mono_String(blorp_List* self, blorp_String* elem)
-- EXPECT-CALLABLE: list__contains__mono_String
-- EXPECT-C-REGEX: int brp_[0-9A-Za-z]+\(blorp_List\* self, blorp_String\* elem\)
-- Semantic callable expectation: list__any__mono_String
-- EXPECT-NOT-CALLABLE: list__any__mono_String
import:
	list: List


func main(args: List[String]) -> Int:
	var sections: List[String] = []
	name: String = "section"

	if sections.contains(name):
		1
	else:
		sections = sections.append(name)
		sections.length() - 1
