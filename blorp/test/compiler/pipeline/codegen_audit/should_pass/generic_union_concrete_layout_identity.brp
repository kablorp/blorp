-- EXPECT-NOT-C: struct { void* field0; } Picked;
-- EXPECT-NOT-C: typedef struct Choice {
union Choice[T]:
	Picked(T)
	Empty


func string_choice() -> Choice[String]:
	Picked("hello")


func int_choice() -> Choice[Int]:
	Picked(42)


func main(args: List[String]) -> Int:
	chosen_text: Choice[String] = string_choice()
	chosen_number: Choice[Int] = int_choice()

	match chosen_text:
		Picked(value):
			match chosen_number:
				Picked(n):
					if value == "hello" and n == 42:
						0
					else:
						1
				Empty:
					2
		Empty:
			3
