-- Regression: concrete Float vector reductions may use raw storage only after
-- checking both storage mode and element size, matching the runtime-safe reader
-- contract.
-- EXPECT-C: ->storage_mode == BLORP_VECTOR_STORAGE_F64 &&
-- EXPECT-C: ->elem_size == (int16_t)sizeof(double)
-- EXPECT-C: double* __tensor_raw = (double*)((blorp_Vector*)__tensor)->data
-- EXPECT-C: __tensor_raw[__i]
-- EXPECT-C: blorp_vector_read_f64((blorp_Vector*)__tensor, __i)
import:
	vector: sum


func main(args: List[String]) -> Int:
	arr: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	_ = sum(arr)
	0
