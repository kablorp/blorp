private pure func new_ctfe_test_domain() -> (ModuleTable, ModuleId):
	target_identity = resolved_module_identity_from_resolver("target", UserModule)
	identities = [
		"target",
		"dep",
		"broken/dep",
		"self/dep",
		"later/dep",
		"left",
		"right",
		"base",
	].map(
		func(module_path): resolved_module_identity_from_resolver(module_path, UserModule),
	)

	match module_table(identities):
		Ok(table):
			match module_table_find_id_by_canonical_path(table, "target"):
				Some(module_id):
					(table, module_id)
				None:
					singleton_module_table(target_identity)
		Err(_):
			singleton_module_table(target_identity)


private pure func ctfe_test_module_id(context: CtfeContext, module_path: String) -> ModuleId:
	module_table_find_id_by_canonical_path(
		context.module_table,
		module_path,
	).get_or(context.target_module_id)


private pure func ctfe_test_context() -> CtfeContext:
	match ctfe_global_definition_fixture():
		Some(fixture):
			ctfe_context_empty(fixture.definitions, fixture.target)
		None:
			domain = new_ctfe_test_domain()
			definitions = definition_index_definition_table(
				definition_index_empty(
					definition_index_initial_seed(ENV_EMPTY),
					domain[0],
				),
			)
			ctfe_context_empty(definitions, domain[1])


private pure func ctfe_test_context_from_program(
	base_context: CtfeContext,
	program: TypedProgram,
	imported_programs: List[CtfeImportedProgram],
) -> CtfeContext:
	imported_program_set = ctfe_imported_program_set(
		base_context.definition_table,
		imported_programs,
	)
	ctfe_context_from_program(
		base_context.definition_table,
		base_context.target_module_id,
		program,
		[],
		imported_program_set,
	).get_or(base_context)


private pure func ctfe_test_imported_program_set(
	context: CtfeContext,
	programs: List[CtfeImportedProgram],
) -> CtfeImportedProgramSet:
	ctfe_imported_program_set(context.definition_table, programs)


private pure func ctfe_test_module_global_value(
	context: CtfeContext,
	module_path: String,
	name: String,
) -> Option[CtfeValue]:
	ctfe_context_module_global_value(
		context,
		ctfe_test_module_id(context, module_path),
		name,
	)


private pure func ctfe_test_imported_program(
	context: CtfeContext,
	module_path: String,
	decls: List[TypedDecl],
	import_bindings: List[CtfeImportBinding],
) -> CtfeImportedProgram:
	complete_ctfe_imported_program(
		context.definition_table,
		ctfe_test_module_id(context, module_path),
		decls,
		import_bindings,
	)


pure func fixture_source_file() -> SourceFile:
	source_file("ctfe_global_eval.brp", "ctfe_global_eval", "VALUE = 1")


pure func fixture_source_span() -> SourceSpan:
	src: SourceFile = fixture_source_file()
	cursor: Cursor = source_cursor_at(src, 0)
	source_span(src, cursor, cursor)


private record CtfeGlobalDefinitionFixture {
	table: ModuleTable,
	definitions: DefinitionTable,
	target: ModuleId,
	read_first_id: Int,
	read_self_id: Int,
	read_later_id: Int,
	left_reader_id: Int,
	right_reader_id: Int
}


private pure func ctfe_global_definition_fixture() -> Option[CtfeGlobalDefinitionFixture]:
	domain = new_ctfe_test_domain()
	var index = definition_index_empty(definition_index_initial_seed(ENV_EMPTY), domain[0])
	var ids: List[Int] = []
	specs = [
		("dep", "read_first"),
		("self/dep", "read_self"),
		("later/dep", "read_later"),
		("left", "read_value"),
		("right", "read_value"),
	]

	for (module_path, name) in specs:
		match module_table_find_id_by_canonical_path(domain[0], module_path):
			Some(module_id):
				definition_id = definition_index_next_def_id(index)

				match definition_index_insert_func_callable_id(
					index,
					domain[0],
					func_callable_key(module_id, name, fixture_source_span()),
					definition_id,
				):
					Ok(updated):
						index = updated
						ids = ids.append(definition_id)
					Err(_):
						void
			None:
				void

	read_first_id ?= ids.get(0)
	read_self_id ?= ids.get(1)
	read_later_id ?= ids.get(2)
	left_reader_id ?= ids.get(3)
	right_reader_id ?= ids.get(4)
	Some({
		table = domain[0],
		definitions = definition_index_definition_table(index),
		target = domain[1],
		read_first_id = read_first_id,
		read_self_id = read_self_id,
		read_later_id = read_later_id,
		left_reader_id = left_reader_id,
		right_reader_id = right_reader_id,
	})


private pure func ctfe_test_definition_table() -> DefinitionTable:
	match ctfe_global_definition_fixture():
		Some(fixture):
			fixture.definitions
		None:
			domain = new_ctfe_test_domain()
			definition_index_definition_table(
				definition_index_empty(
					definition_index_initial_seed(ENV_EMPTY),
					domain[0],
				),
			)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, fixture_source_span())


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], fixture_source_span())


pure func parsed_var(name: String, is_mutable: Bool) -> ParsedVarDecl:
	{
		name = ident(name),
		type_expr = Some(named_type("Int")),
		value = ParsedIntLiteralExpr("0", fixture_source_span()),
		is_mutable = is_mutable,
		span = fixture_source_span()
	}


pure func expr_info() -> TypedExprInfo:
	{
		source_type = None,
		origin = SynthesizedOrigin("ctfe_global_eval_test"),
		value_slot = KeptValueSlot(TYPE_INT),
		proofs = UNREFINED_BINDING,
		resolved_call = None,
		resolved_definition_id = None,
		resource_dependencies = []
	}


pure func int_expr(text: String) -> TypedExpr:
	TypedIntLiteralExpr(text, fixture_source_span(), expr_info())


pure func name_expr(name: String) -> TypedExpr:
	TypedNameExpr(ident(name), expr_info())


pure func add_expr(left: TypedExpr, right: TypedExpr) -> TypedExpr:
	TypedBinaryExpr(ParsedAddOp, left, right, fixture_source_span(), expr_info())


pure func typed_global(name: String, is_mutable: Bool, value: TypedExpr) -> TypedGlobalVarInfo:
	{
		decl = parsed_var(name, is_mutable),
		definition_id = None,
		binding_type = TYPE_INT,
		source_type = Some(TYPE_INT),
		value = value
	}


pure func typed_global_decl(name: String, is_mutable: Bool, value: TypedExpr) -> TypedDecl:
	TypedGlobalVarDecl(typed_global(name, is_mutable, value))


pure func parsed_function(name: String) -> ParsedFunctionDecl:
	{
		name = ident(name),
		keyword_span = Some(fixture_source_span()),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = None,
		is_pure = True,
		annotations = [],
		doc = None,
		span = fixture_source_span()
	}


pure func typed_pure_function_decl(callable_id: Int, name: String, body: TypedExpr) -> TypedDecl:
	info: TypedFunctionInfo = {
		decl = parsed_function(name),
		callable_id = Some(callable_id),
		effective_type_params = [],
		param_types = [],
		source_return_type = None,
		semantic_return_type = TYPE_INT,
		body = Some(body)
	}
	TypedFunctionDecl(info)


pure func local_pure_call(callable_id: Int, name: String) -> TypedExpr:
	resolved_target = match callable_id_from_definition_table(
		ctfe_test_definition_table(),
		callable_id,
	):
		Some(resolved_id):
			ResolvedGraphCallableCall(resolved_id, ResolvedSourceFunctionCall)
		None:
			ResolvedCompilerBuiltinCall(-1)

	call: ResolvedCallInfo = {
		callee_name = name,
		source_name = name,
		purity = Pure,
		target = resolved_target,
		trait_identity = None,
		bound_type_params = [],
		debug_only = False,
		instantiated_params = [],
		instantiated_return = TYPE_INT,
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}
	callee_info: TypedExprInfo = { expr_info() | resolved_call = Some(call) }
	TypedCallExpr(
		TypedNameExpr(ident(name), callee_info),
		[],
		fixture_source_span(),
		callee_info,
	)


pure func private_typed_global_decl(name: String, is_mutable: Bool, value: TypedExpr) -> TypedDecl:
	TypedPrivateDecl(typed_global_decl(name, is_mutable, value))


pure func typed_program(decls: List[TypedDecl]) -> TypedProgram:
	{
		source = fixture_source_file(),
		decls = decls,
		diagnostics = [],
		type_definitions = [],
		type_references = []
	}


pure func name_binding_match_expr(binding_name: String, value: TypedExpr) -> TypedExpr:
	case: TypedMatchCase = {
		pattern = TypedNamePattern(ident(binding_name), TYPE_INT),
		body = int_expr("42"),
		span = fixture_source_span()
	}
	TypedMatchExpr(value, [case], fixture_source_span(), expr_info())


pure func target_with_nullary_ready_constructor() -> TypedProgram:
	variant: ParsedVariantDecl = {
		name = ident("Ready"),
		fields = [],
		span = fixture_source_span()
	}
	union_decl: ParsedUnionDecl = {
		name = ident("Status"),
		type_params = [],
		variants = [variant],
		is_enum = False,
		doc = None,
		span = fixture_source_span()
	}
	typed_program([TypedParsedDecl(UnionParsedDecl(union_decl))])


pure func selective_import_binding(
	context: CtfeContext,
	local_name: String,
	module_path: String,
	source_name: String,
) -> CtfeImportBinding:
	CtfeStandaloneSelectiveDefinitionBinding(
		local_name,
		ctfe_test_module_id(context, module_path),
		source_name,
	)


pure func lookup_equals(env: CtfeEnv, name: String, expected: Int) -> Bool:
	match ctfe_lookup_value(env, name):
		Ok(value):
			ctfe_values_equal(
				value,
				ctfe_int(fixture_source_span(), expected),
			)
		Err(_):
			False


pure func result_error_message(result: Result[CtfeEnv, CtfeEvalError]) -> String:
	match result:
		Err(error):
			ctfe_eval_error_message(error)
		Ok(_):
			""


pure func imported_module_env_error_message(
	result: Result[CtfeContext, CtfeEvalError],
	expected_module_path: String,
) -> String:
	match result:
		Err(CtfeEvalInModule(module_path, cause)):
			match cause:
				CtfeEvalEnvError(_):
					if module_path == expected_module_path:
						ctfe_eval_error_message(CtfeEvalInModule(module_path, cause))
					else:
						""
				_:
					""
		Err(_):
			""
		Ok(_):
			""


func test_eval_program_globals_in_source_order() -> Bool:
	program = typed_program([
		typed_global_decl("A", False, int_expr("1")),
		typed_global_decl(
			"B",
			False,
			add_expr(name_expr("A"), int_expr("2")),
		),
	])
	result = ctfe_eval_program_global_env(ctfe_test_context(), CTFE_ENV_EMPTY, program)

	match result:
		Ok(env):
			lookup_equals(env, "A", 1) and lookup_equals(env, "B", 3)
		Err(_):
			False


func test_eval_program_rejects_later_global_reference() -> Bool:
	program = typed_program([
		typed_global_decl("A", False, name_expr("B")),
		typed_global_decl("B", False, int_expr("2")),
	])

	result_error_message(
		ctfe_eval_program_global_env(
			ctfe_test_context(),
			CTFE_ENV_EMPTY,
			program,
		),
	) == "global constant initializer cannot reference later global constant 'B'"


func test_eval_program_rejects_self_reference() -> Bool:
	program = typed_program([typed_global_decl("A", False, name_expr("A"))])

	result_error_message(
		ctfe_eval_program_global_env(
			ctfe_test_context(),
			CTFE_ENV_EMPTY,
			program,
		),
	) == "global constant initializer cannot reference itself: 'A'"


func test_eval_program_keeps_mutable_global_runtime_initialized() -> Bool:
	program = typed_program([
		typed_global_decl("RUNTIME", True, int_expr("1")),
		typed_global_decl("A", False, name_expr("RUNTIME")),
	])

	result_error_message(
		ctfe_eval_program_global_env(
			ctfe_test_context(),
			CTFE_ENV_EMPTY,
			program,
		),
	) == (
		"global constant initializer cannot reference global 'RUNTIME' because it is not "
		+ "a compile-time constant"
	)


func test_eval_program_evaluates_private_globals() -> Bool:
	program = typed_program([
		private_typed_global_decl("HIDDEN", False, int_expr("5")),
		typed_global_decl(
			"PUBLIC",
			False,
			add_expr(name_expr("HIDDEN"), int_expr("1")),
		),
	])
	result = ctfe_eval_program_global_env(ctfe_test_context(), CTFE_ENV_EMPTY, program)

	match result:
		Ok(env):
			lookup_equals(env, "HIDDEN", 5) and lookup_equals(env, "PUBLIC", 6)
		Err(_):
			False


func test_eval_imported_program_global_envs_attach_to_context() -> Bool:
	base_context = ctfe_test_context()
	imported_programs: List[CtfeImportedProgram] = [
		ctfe_test_imported_program(
			base_context,
			"dep",
			[typed_global_decl("VALUE", False, int_expr("42"))],
			[],
		),
	]
	result: Result[CtfeContext, CtfeEvalError] = ctfe_eval_imported_program_global_envs(
		base_context,
		ctfe_test_imported_program_set(base_context, imported_programs),
	)

	match result:
		Ok(context):
			match ctfe_test_module_global_value(context, "dep", "VALUE"):
				Some(value):
					ctfe_values_equal(
						value,
						ctfe_int(fixture_source_span(), 42),
					)
				None:
					False
		Err(_):
			False


func test_eval_imported_program_global_envs_rejects_foreign_program_set() -> Bool:
	context = ctfe_test_context()
	foreign_context = ctfe_test_context()
	dependency = ctfe_test_imported_program(
		foreign_context,
		"dep",
		[typed_global_decl("VALUE", False, int_expr("42"))],
		[],
	)

	match ctfe_eval_imported_program_global_envs(
		context,
		ctfe_test_imported_program_set(foreign_context, [dependency]),
	):
		Err(error):
			ctfe_eval_error_message(
				error,
			) == "CTFE inputs do not belong to one definition and module identity domain"
		Ok(_):
			False


private pure func eval_imported_global_pure_call_reads_prior_global(
	fixture: CtfeGlobalDefinitionFixture,
) -> Bool:
	read_first_id = fixture.read_first_id
	base_context = ctfe_context_empty(fixture.definitions, fixture.target)
	imported_programs: List[CtfeImportedProgram] = [
		ctfe_test_imported_program(
			base_context,
			"dep",
			[typed_global_decl("FIRST", False, int_expr("40")), typed_pure_function_decl(
					read_first_id,
					"read_first",
					add_expr(name_expr("FIRST"), int_expr("2")),
				), typed_global_decl(
					"SECOND",
					False,
					local_pure_call(read_first_id, "read_first"),
				)],
			[],
		),
	]
	context = ctfe_test_context_from_program(base_context, typed_program([]), imported_programs)
	result = ctfe_eval_imported_program_global_envs(
		context,
		ctfe_test_imported_program_set(context, imported_programs),
	)

	match result:
		Ok(context):
			match ctfe_test_module_global_value(context, "dep", "SECOND"):
				Some(value):
					ctfe_values_equal(
						value,
						ctfe_int(fixture_source_span(), 42),
					)
				None:
					False
		Err(_):
			False


func test_eval_imported_global_pure_call_reads_prior_global() -> Bool:
	match ctfe_global_definition_fixture():
		Some(fixture):
			eval_imported_global_pure_call_reads_prior_global(fixture)
		None:
			False


func test_eval_imported_global_error_names_module() -> Bool:
	base_context = ctfe_test_context()
	imported_programs: List[CtfeImportedProgram] = [
		ctfe_test_imported_program(
			base_context,
			"broken/dep",
			[typed_global_decl("VALUE", False, name_expr("MISSING"))],
			[],
		),
	]
	context = ctfe_test_context_from_program(base_context, typed_program([]), imported_programs)

	imported_module_env_error_message(
		ctfe_eval_imported_program_global_envs(
			context,
			ctfe_test_imported_program_set(context, imported_programs),
		),
		"broken/dep",
	) == (
		"while evaluating global constants in imported module 'broken/dep': global "
		+ "constant initializer cannot reference 'MISSING' before it is evaluated"
	)


private pure func eval_imported_global_pure_call_rejects_self_reference(
	fixture: CtfeGlobalDefinitionFixture,
) -> Bool:
	read_self_id = fixture.read_self_id
	base_context = ctfe_context_empty(fixture.definitions, fixture.target)
	imported_programs: List[CtfeImportedProgram] = [
		ctfe_test_imported_program(
			base_context,
			"self/dep",
			[
				typed_pure_function_decl(read_self_id, "read_self", name_expr("SELF")),
				typed_global_decl(
					"SELF",
					False,
					local_pure_call(read_self_id, "read_self"),
				),
			],
			[],
		),
	]
	context = ctfe_test_context_from_program(base_context, typed_program([]), imported_programs)

	imported_module_env_error_message(
		ctfe_eval_imported_program_global_envs(
			context,
			ctfe_test_imported_program_set(context, imported_programs),
		),
		"self/dep",
	) == (
		"while evaluating global constants in imported module 'self/dep': global "
		+ "constant initializer cannot reference itself: 'SELF'"
	)


func test_eval_imported_global_pure_call_rejects_self_reference() -> Bool:
	match ctfe_global_definition_fixture():
		Some(fixture):
			eval_imported_global_pure_call_rejects_self_reference(fixture)
		None:
			False


private pure func eval_imported_global_pure_call_rejects_later_reference(
	fixture: CtfeGlobalDefinitionFixture,
) -> Bool:
	read_later_id = fixture.read_later_id
	base_context = ctfe_context_empty(fixture.definitions, fixture.target)
	imported_programs: List[CtfeImportedProgram] = [
		ctfe_test_imported_program(
			base_context,
			"later/dep",
			[
				typed_pure_function_decl(read_later_id, "read_later", name_expr("LATER")),
				typed_global_decl(
					"FIRST",
					False,
					local_pure_call(read_later_id, "read_later"),
				),
				typed_global_decl("LATER", False, int_expr("42")),
			],
			[],
		),
	]
	context = ctfe_test_context_from_program(base_context, typed_program([]), imported_programs)

	imported_module_env_error_message(
		ctfe_eval_imported_program_global_envs(
			context,
			ctfe_test_imported_program_set(context, imported_programs),
		),
		"later/dep",
	) == (
		"while evaluating global constants in imported module 'later/dep': global "
		+ "constant initializer cannot reference later global constant 'LATER'"
	)


