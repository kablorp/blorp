private pure func evaluate_program_globals_builds_context_and_rewrites_target(
	fixture: CtfeGlobalDefinitionFixture,
) -> Bool:
	base_context = ctfe_context_empty(fixture.definitions, fixture.target)
	imported_programs: List[CtfeImportedProgram] = [
		ctfe_test_imported_program(
			base_context,
			"dep",
			[typed_global_decl("OFFSET", False, int_expr("40"))],
			[],
		),
	]
	program = typed_program([typed_global_decl(
				"ANSWER",
				False,
				add_expr(name_expr("OFFSET"), int_expr("2")),
			)])
	result = ctfe_evaluate_program_globals(
		fixture.definitions,
		fixture.target,
		program,
		ctfe_imported_program_set(fixture.definitions, imported_programs),
		[selective_import_binding(base_context, "OFFSET", "dep", "OFFSET")],
	)

	match result:
		Ok(rewritten):
			match rewritten.decls.get(0):
				Some(TypedGlobalVarDecl(info)):
					match info.value:
						TypedIntLiteralExpr(text, _, _):
							text == "42"
						_:
							False
				_:
					False
		Err(_):
			False


