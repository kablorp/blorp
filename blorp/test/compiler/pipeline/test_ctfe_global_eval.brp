private pure func eval_imported_global_pure_calls_keep_module_environments_isolated(
	fixture: CtfeGlobalDefinitionFixture,
) -> Bool:
	left_reader_id = fixture.left_reader_id
	right_reader_id = fixture.right_reader_id
	base_context = ctfe_context_empty(fixture.definitions, fixture.target)
	imported_programs: List[CtfeImportedProgram] = [
		ctfe_test_imported_program(
			base_context,
			"left",
			[
				typed_global_decl("VALUE", False, int_expr("1")),
				typed_pure_function_decl(left_reader_id, "read_value", name_expr("VALUE")),
				typed_global_decl(
					"RESULT",
					False,
					local_pure_call(left_reader_id, "read_value"),
				),
			],
			[],
		),
		ctfe_test_imported_program(
			base_context,
			"right",
			[
				typed_global_decl("VALUE", False, int_expr("2")),
				typed_pure_function_decl(right_reader_id, "read_value", name_expr("VALUE")),
				typed_global_decl(
					"RESULT",
					False,
					local_pure_call(right_reader_id, "read_value"),
				),
			],
			[],
		),
	]
	context = ctfe_test_context_from_program(base_context, typed_program([]), imported_programs)

	match ctfe_eval_imported_program_global_envs(
		context,
		ctfe_test_imported_program_set(context, imported_programs),
	):
		Ok(result_context):
			left_value = ctfe_test_module_global_value(result_context, "left", "RESULT")
			right_value = ctfe_test_module_global_value(result_context, "right", "RESULT")

			match (left_value, right_value):
				(Some(left), Some(right)):
					ctfe_values_equal(
						left,
						ctfe_int(fixture_source_span(), 1),
					) and ctfe_values_equal(
						right,
						ctfe_int(fixture_source_span(), 2),
					)
				_:
					False
		Err(_):
			False


func test_eval_imported_global_pure_calls_keep_module_environments_isolated() -> Bool:
