		Some(fixture):
			evaluate_program_globals_builds_context_and_rewrites_target(fixture)
		None:
			False


private pure func rewritten_global_int(program: TypedProgram, name: String) -> Option[String]:
	var result: Option[String] = None

	for decl in program.decls:
		match decl:
			TypedGlobalVarDecl(info):
				if info.decl.name.text == name:
					match info.value:
						TypedIntLiteralExpr(text, _, _):
							result = Some(text)
						_:
							void
			_:
				void

	result


func test_dependency_global_graph_evaluates_shared_module_once() -> Bool:
	base_context = ctfe_test_context()
	dependency = ctfe_test_imported_program(
		base_context,
		"dep",
		[typed_global_decl("OFFSET", False, int_expr("40"))],
		[],
	)
	first_target = typed_program([typed_global_decl(
				"FIRST",
				False,
				add_expr(name_expr("OFFSET"), int_expr("1")),
			)])
	second_target = typed_program([typed_global_decl(
				"SECOND",
				False,
				add_expr(name_expr("OFFSET"), int_expr("2")),
			)])
	bindings = [selective_import_binding(base_context, "OFFSET", "dep", "OFFSET")]

	match ctfe_evaluate_dependency_global_graph(
		base_context.definition_table,
		base_context.target_module_id,
		ctfe_imported_program_set(base_context.definition_table, [dependency]),
	):
		Err(_):
			False
		Ok(graph):
			metrics = ctfe_evaluated_global_graph_metrics(graph)
			first = ctfe_rewrite_program_globals_with_evaluated_dependencies(
				graph,
				base_context.target_module_id,
				first_target,
				ctfe_imported_program_set(base_context.definition_table, [dependency]),
				bindings,
			)
			second = ctfe_rewrite_program_globals_with_evaluated_dependencies(
				graph,
				base_context.target_module_id,
				second_target,
				ctfe_imported_program_set(base_context.definition_table, [dependency]),
				bindings,
			)

			match (first, second):
				(Ok(first_program), Ok(second_program)):
					(
						metrics.planned_unique_modules == 1
						and metrics.module_global_evaluation_starts == 1
						and metrics.duplicate_module_global_evaluations == 0
						and metrics.global_declaration_evaluations == 1
						and rewritten_global_int(first_program, "FIRST") == Some("41")
						and rewritten_global_int(second_program, "SECOND") == Some("42")
					)
				_:
					False


