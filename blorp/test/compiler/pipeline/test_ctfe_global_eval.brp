				typed_program([typed_global_decl("RESULT", False, name_expr("DEPENDENT"))]),
				ctfe_imported_program_set(base_context.definition_table, [dependent]),
				[selective_import_binding(base_context, "DEPENDENT", "dep", "DEPENDENT")],
			)

			match result:
				Err(error):
					ctfe_eval_error_message(error) == (
						"while evaluating global constants in imported module 'left': compile-time "
						+ "dependency global evaluation contains a cycle"
					)
				Ok(_):
					False


func test_dependency_global_graph_keeps_disjoint_cycle_errors_separate() -> Bool:
	base_context = ctfe_test_context()
	left = ctfe_test_imported_program(
		base_context,
		"left",
		[typed_global_decl("LEFT", False, name_expr("RIGHT"))],
		[selective_import_binding(base_context, "RIGHT", "right", "RIGHT")],
	)
	right = ctfe_test_imported_program(
		base_context,
		"right",
		[typed_global_decl("RIGHT", False, name_expr("LEFT"))],
		[selective_import_binding(base_context, "LEFT", "left", "LEFT")],
	)
	base = ctfe_test_imported_program(
		base_context,
		"base",
		[typed_global_decl("BASE", False, name_expr("DEP"))],
		[selective_import_binding(base_context, "DEP", "dep", "DEP")],
	)
	dep = ctfe_test_imported_program(
		base_context,
		"dep",
		[typed_global_decl("DEP", False, name_expr("BASE"))],
		[selective_import_binding(base_context, "BASE", "base", "BASE")],
	)

	match (
		ctfe_evaluate_dependency_global_graph(
			base_context.definition_table,
			base_context.target_module_id,
			ctfe_imported_program_set(
				base_context.definition_table,
				[right, left, base, dep],
			),
		)
	):
		Err(_):
			False
		Ok(graph):
			left_result = ctfe_rewrite_program_globals_with_evaluated_dependencies(
				graph,
				base_context.target_module_id,
				typed_program([typed_global_decl("RESULT", False, name_expr("LEFT"))]),
				ctfe_imported_program_set(base_context.definition_table, [left]),
				[selective_import_binding(base_context, "LEFT", "left", "LEFT")],
			)
			dep_result = ctfe_rewrite_program_globals_with_evaluated_dependencies(
				graph,
				base_context.target_module_id,
				typed_program([typed_global_decl("RESULT", False, name_expr("DEP"))]),
				ctfe_imported_program_set(base_context.definition_table, [dep]),
				[selective_import_binding(base_context, "DEP", "dep", "DEP")],
			)

			match (left_result, dep_result):
				(Err(left_error), Err(dep_error)):
					(
						ctfe_eval_error_message(left_error).contains("imported module 'left'")
						and ctfe_eval_error_message(dep_error).contains("imported module 'dep'")
					)
				_:
					False


func test_dependency_global_graph_counts_only_attempted_declarations() -> Bool:
	base_context = ctfe_test_context()
	broken = ctfe_test_imported_program(
		base_context,
		"broken/dep",
		[
			typed_global_decl("BROKEN", False, name_expr("MISSING")),
			typed_global_decl("NEVER_REACHED", False, int_expr("42")),
		],
		[],
	)

	match ctfe_evaluate_dependency_global_graph(
		base_context.definition_table,
		base_context.target_module_id,
		ctfe_imported_program_set(base_context.definition_table, [broken]),
	):
		Err(_):
			False
		Ok(graph):
			metrics = ctfe_evaluated_global_graph_metrics(graph)
			metrics.global_declaration_evaluations == 1 and metrics.rejected_module_evaluations == 1


func test_dependency_global_graph_retains_rejection_and_continues_independent_root() -> Bool:
	base_context = ctfe_test_context()
	broken = ctfe_test_imported_program(
		base_context,
		"broken/dep",
		[typed_global_decl("BROKEN", False, name_expr("MISSING"))],
		[],
	)
	independent = ctfe_test_imported_program(
		base_context,
		"right",
		[typed_global_decl("VALUE", False, int_expr("42"))],
		[],
	)
	broken_target = typed_program([typed_global_decl("RESULT", False, name_expr("BROKEN"))])
	independent_target = typed_program([typed_global_decl("RESULT", False, name_expr("VALUE"))])

	match (
		ctfe_evaluate_dependency_global_graph(
			base_context.definition_table,
			base_context.target_module_id,
			ctfe_imported_program_set(
				base_context.definition_table,
				[broken, independent],
			),
		)
	):
		Err(_):
			False
		Ok(graph):
			broken_bindings = [
				selective_import_binding(base_context, "BROKEN", "broken/dep", "BROKEN"),
			]
			first_broken = ctfe_rewrite_program_globals_with_evaluated_dependencies(
				graph,
				base_context.target_module_id,
				broken_target,
				ctfe_imported_program_set(base_context.definition_table, [broken]),
				broken_bindings,
			)
			second_broken = ctfe_rewrite_program_globals_with_evaluated_dependencies(
				graph,
				base_context.target_module_id,
				broken_target,
				ctfe_imported_program_set(base_context.definition_table, [broken]),
				broken_bindings,
			)
			independent_result = ctfe_rewrite_program_globals_with_evaluated_dependencies(
				graph,
				base_context.target_module_id,
				independent_target,
				ctfe_imported_program_set(base_context.definition_table, [independent]),
				[selective_import_binding(base_context, "VALUE", "right", "VALUE")],
			)
			metrics = ctfe_evaluated_global_graph_metrics(graph)

			match (first_broken, second_broken, independent_result):
				(Err(first_error), Err(second_error), Ok(independent_program)):
					expected_error = (
						"while evaluating global constants in imported module 'broken/dep': global "
						+ "constant initializer cannot reference 'MISSING' before it is evaluated"
					)

					(
						ctfe_eval_error_message(first_error) == expected_error
						and ctfe_eval_error_message(second_error) == expected_error
						and rewritten_global_int(independent_program, "RESULT") == Some("42")
						and metrics.module_global_evaluation_starts == 2
						and metrics.rejected_module_evaluations == 1
					)
				_:
					False


func test_dependency_global_graph_does_not_install_unimported_sibling() -> Bool:
	base_context = ctfe_test_context()
	left = ctfe_test_imported_program(
		base_context,
		"left",
		[typed_global_decl("VALUE", False, int_expr("1"))],
		[],
	)
	right = ctfe_test_imported_program(
		base_context,
		"right",
		[typed_global_decl("VALUE", False, int_expr("2"))],
		[],
	)
	target = typed_program([typed_global_decl("RESULT", False, name_expr("VALUE"))])

	match (
		ctfe_evaluate_dependency_global_graph(
			base_context.definition_table,
			base_context.target_module_id,
			ctfe_imported_program_set(
				base_context.definition_table,
				[left, right],
			),
		)
	):
		Err(_):
			False
		Ok(graph):
			match ctfe_rewrite_program_globals_with_evaluated_dependencies(
				graph,
				base_context.target_module_id,
				target,
				ctfe_imported_program_set(base_context.definition_table, [left]),
				[selective_import_binding(base_context, "VALUE", "right", "VALUE")],
			):
				Err(error):
					ctfe_eval_error_message(
						error,
					) == "global constant initializer cannot reference 'VALUE' before it is evaluated"
				Ok(_):
					False


