func test_dependency_global_graph_discovers_reversed_global_dependency() -> Bool:
	base_context = ctfe_test_context()
	base = ctfe_test_imported_program(
		base_context,
		"base",
		[typed_global_decl("VALUE", False, int_expr("41"))],
		[],
	)
	middle = ctfe_test_imported_program(
		base_context,
		"left",
		[typed_global_decl("MIDDLE", False, name_expr("VALUE"))],
		[selective_import_binding(base_context, "VALUE", "base", "VALUE")],
	)
	dependency = ctfe_test_imported_program(
		base_context,
		"dep",
		[typed_global_decl("ANSWER", False, name_expr("MIDDLE"))],
		[selective_import_binding(base_context, "MIDDLE", "left", "MIDDLE")],
	)

	match (
		ctfe_evaluate_dependency_global_graph(
			base_context.definition_table,
			base_context.target_module_id,
			ctfe_imported_program_set(
				base_context.definition_table,
				[dependency, middle, base],
			),
		)
	):
		Err(_):
			False
		Ok(graph):
			result = ctfe_rewrite_program_globals_with_evaluated_dependencies(
				graph,
				base_context.target_module_id,
				typed_program([typed_global_decl("RESULT", False, name_expr("ANSWER"))]),
				ctfe_imported_program_set(base_context.definition_table, [dependency]),
				[selective_import_binding(base_context, "ANSWER", "dep", "ANSWER")],
			)
			metrics = ctfe_evaluated_global_graph_metrics(graph)

			match result:
				Ok(program):
					(
						rewritten_global_int(program, "RESULT") == Some("41")
						and metrics.planned_unique_modules == 3
						and metrics.module_global_evaluation_starts == 3
						and metrics.duplicate_module_global_evaluations == 0
						and metrics.global_declaration_evaluations == 5
						and metrics.import_binding_applications == 6
						and metrics.rejected_module_evaluations == 0
					)
				Err(_):
					False


func test_dependency_global_graph_rejects_global_cycle_once() -> Bool:
	base_context = ctfe_test_context()
	left = ctfe_test_imported_program(
		base_context,
		"left",
		[typed_global_decl("LEFT", False, name_expr("RIGHT"))],
		[selective_import_binding(base_context, "RIGHT", "right", "RIGHT")],
	)
	right = ctfe_test_imported_program(
		base_context,
		"right",
		[typed_global_decl("RIGHT", False, name_expr("LEFT"))],
		[selective_import_binding(base_context, "LEFT", "left", "LEFT")],
	)

	match (
		ctfe_evaluate_dependency_global_graph(
			base_context.definition_table,
			base_context.target_module_id,
			ctfe_imported_program_set(
				base_context.definition_table,
				[right, left],
			),
		)
	):
		Err(_):
			False
		Ok(graph):
			left_result = ctfe_rewrite_program_globals_with_evaluated_dependencies(
				graph,
				base_context.target_module_id,
				typed_program([typed_global_decl("RESULT", False, name_expr("LEFT"))]),
				ctfe_imported_program_set(base_context.definition_table, [left]),
				[selective_import_binding(base_context, "LEFT", "left", "LEFT")],
			)
			right_result = ctfe_rewrite_program_globals_with_evaluated_dependencies(
				graph,
				base_context.target_module_id,
				typed_program([typed_global_decl("RESULT", False, name_expr("RIGHT"))]),
				ctfe_imported_program_set(base_context.definition_table, [right]),
				[selective_import_binding(base_context, "RIGHT", "right", "RIGHT")],
			)
			metrics = ctfe_evaluated_global_graph_metrics(graph)

			match (left_result, right_result):
				(Err(left_error), Err(right_error)):
					expected = (
						"while evaluating global constants in imported module 'left': compile-time "
						+ "dependency global evaluation contains a cycle"
					)

					(
						ctfe_eval_error_message(left_error) == expected
						and ctfe_eval_error_message(right_error) == expected
						and metrics.module_global_evaluation_starts == 2
						and metrics.rejected_module_evaluations == 2
					)
				_:
					False


