private pure func dependency_name_binding_value(target: TypedProgram) -> Option[CtfeValue]:
	base_context = ctfe_test_context()
	dependency = ctfe_test_imported_program(base_context, "dep", [typed_global_decl(
				"VALUE",
				False,
				name_binding_match_expr("Ready", int_expr("1")),
			)], [])
	context = ctfe_test_context_from_program(base_context, target, [dependency])

	match ctfe_eval_imported_program_global_envs(
		context,
		ctfe_test_imported_program_set(context, [dependency]),
	):
		Ok(evaluated):
			ctfe_test_module_global_value(evaluated, "dep", "VALUE")
		Err(_):
			None


func test_dependency_name_binding_is_not_contaminated_by_target_constructors() -> Bool:
	plain_target = typed_program([])
	colliding_target = target_with_nullary_ready_constructor()
	expected = ctfe_int(fixture_source_span(), 42)

	plain_then_colliding = match (
		dependency_name_binding_value(plain_target),
		dependency_name_binding_value(colliding_target),
	):
		(Some(plain), Some(colliding)):
			ctfe_values_equal(plain, expected) and ctfe_values_equal(colliding, expected)
		_:
			False

	colliding_then_plain = match (
		dependency_name_binding_value(colliding_target),
		dependency_name_binding_value(plain_target),
	):
		(Some(colliding), Some(plain)):
			ctfe_values_equal(colliding, expected) and ctfe_values_equal(plain, expected)
		_:
			False

	plain_then_colliding and colliding_then_plain


