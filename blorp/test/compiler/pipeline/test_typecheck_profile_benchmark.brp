import:
	../../../benchmark/compiler/compiler_alias_resolution_profile_fixture:
		CompilerAliasRegistrationBenchmarkConfig,
		CompilerAliasResolutionBenchmarkConfig,
		compiler_alias_registration_benchmark,
		compiler_alias_resolution_benchmark,
	../../../benchmark/compiler/compiler_type_header_mixed_profile_fixture:
		CompilerMixedTypeHeaderBenchmarkConfig,
		compiler_mixed_type_header_benchmark,
	../../../benchmark/compiler/compiler_typecheck_profile_fixture:
		CompilerTypecheckBenchmarkConfig,
		compiler_typecheck_benchmark,
	test: TestSuite


private func test_small_typecheck_profile_fixture() -> Bool:
	config: CompilerTypecheckBenchmarkConfig = {
		iterations = 1,
		module_count = 2,
		type_depth = 3,
		probes_per_module = 4,
		retain_parsed_programs = False
	}
	result = compiler_typecheck_benchmark(config)

	(
		result.typed_declaration_count == result.source_declaration_count
		and result.error_count == 0
		and result.checksum == 33
		and result.workload_valid
	)


private func test_repeated_typecheck_profile_fixture() -> Bool:
	result = compiler_typecheck_benchmark({
		iterations = 2,
		module_count = 2,
		type_depth = 3,
		probes_per_module = 4,
		retain_parsed_programs = True,
	})

	result.workload_valid and result.error_count == 0 and result.checksum == 66


private func test_mixed_type_header_fixture_validates_semantic_work() -> Bool:
	result = compiler_mixed_type_header_benchmark({
		iterations = 1,
		module_count = 3,
		shapes_per_module = 2,
		probes_per_module = 3,
		import_fanout = 2,
		retain_parsed_programs = True,
	})

	(
		result.typed_declaration_count == result.source_declaration_count
		and result.error_count == 0
		and result.checksum == 142
		and result.workload_valid
	)


private func test_alias_resolution_profile_fixture_is_valid_and_checksummed() -> Bool:
	config: CompilerAliasResolutionBenchmarkConfig = {
		iterations = 2,
		alias_depth = 3,
		type_depth = 4,
		resolutions_per_iteration = 5
	}
	result = compiler_alias_resolution_benchmark(config)

	(
		result.checksum == 90
		and result.workload_valid
	)


private func test_alias_registration_profile_fixture_is_valid_and_checksummed() -> Bool:
	config: CompilerAliasRegistrationBenchmarkConfig = {
		iterations = 2,
		alias_count = 3,
		type_depth = 4
	}
	result = compiler_alias_registration_benchmark(config)

	(
		result.checksum == 18
		and result.workload_valid
	)


tests: TestSuite = {
	description = "Compiler typecheck profile benchmark",
	tests = [
		("small fixture is deterministic", test_small_typecheck_profile_fixture),
		("repeated fixture validates every iteration", test_repeated_typecheck_profile_fixture),
		(
			"mixed type header fixture validates semantic work",
			test_mixed_type_header_fixture_validates_semantic_work,
		),
		(
			"alias fixture is valid and checksummed",
			test_alias_resolution_profile_fixture_is_valid_and_checksummed,
		),
		(
			"alias registration fixture is valid and checksummed",
			test_alias_registration_profile_fixture_is_valid_and_checksummed,
		),
	]
}
