import:
	../../../src/compiler/stage_03_parse/parsed_ast: ParsedProgram
	../../../src/compiler/stage_03_parse/source_ast_finalize:
		finalized_typecheck_program,
		finalized_typecheck_program_ast,
	../../../src/compiler/stage_04_modules/loaded_module:
		LoadedModuleSet,
		ModuleLoadCandidate,
		ModuleOrigin(StdlibModule, UserModule),
		loaded_module_canonical_path,
		loaded_module_origin,
		loaded_module_set,
		loaded_module_set_modules,
		loaded_module_set_target,
		module_load_candidate,
		resolved_module_identity_from_resolver,
	../../../src/compiler/stage_04_modules/module_table: ModuleTable, module_table
	../../../src/compiler/stage_06_typecheck/graph/definition_identity: source_definition_key_owner
	../../../src/compiler/stage_06_typecheck/graph/definition_index:
		DefinitionIndex,
		DefinitionIndexSeed,
		definition_index_find_source_definition_id,
		definition_index_for_loaded_modules,
		definition_index_func_callable_bindings,
		definition_index_func_callable_id_count,
		definition_index_initial_seed,
		definition_index_module_table,
		definition_index_next_def_id,
		definition_index_source_definition_bindings,
		definition_index_source_definition_id_count,
	../../../src/compiler/stage_06_typecheck/type_system/env: ENV_EMPTY
	../typecheck_test_support as TypecheckTestSupport
	test: TestSuite


private pure func parsed_program(
	path: String,
	module_name: String,
	source: String,
) -> ParsedProgram:
	finalized_typecheck_program_ast(
		TypecheckTestSupport.finalized_typecheck_program_fixture(
			path,
			module_name,
			source,
		),
	)


private pure func empty_program() -> ParsedProgram:
	parsed_program("empty.brp", "empty", "")


private pure func target_program() -> ParsedProgram:
	parsed_program("main.brp", "main", "func main(args: List[String]) -> Int:\n\t0")


private pure func dependency_program() -> ParsedProgram:
	parsed_program(
		"dependency.brp",
		"dependency",
		"foreign:\n\tfunc native_count(value: Int) -> Int = \"native_count\"\n\nunion Signal:\n\tReady\n\tBusy(Int)\n\npure func answer() -> Int:\n\t42\n\nprivate pure func hidden(value: Int) -> Int:\n\tvalue\n\ntrait Measure:\n\tpure func measure(value: Self) -> Int: 0\n\nimplements Measure for Int:\n\tpure func measure(value: Int) -> Int:\n\t\tvalue",
	)


private pure func definition_index_seed() -> DefinitionIndexSeed:
	definition_index_initial_seed(ENV_EMPTY)


private pure func load_candidate(program: ParsedProgram) -> ModuleLoadCandidate:
	load_candidate_with_origin(program, UserModule)


private pure func load_candidate_with_origin(
	program: ParsedProgram,
	origin: ModuleOrigin,
) -> ModuleLoadCandidate:
	load_candidate_with_identity(program, program.source.module_name, origin)


private pure func load_candidate_with_identity(
	program: ParsedProgram,
	canonical_path: String,
	origin: ModuleOrigin,
) -> ModuleLoadCandidate:
	module_load_candidate(
		resolved_module_identity_from_resolver(canonical_path, origin),
		finalized_typecheck_program(program),
	)


private pure func definition_index_for_programs(
	seed: DefinitionIndexSeed,
	target: ParsedProgram,
	modules: List[ParsedProgram],
) -> Option[DefinitionIndex]:
	module_table ?= module_table(
		([target] + modules).map(func(program):
			resolved_module_identity_from_resolver(program.source.module_name, UserModule)
		),
	).to_option()

	match loaded_module_set(
		load_candidate(target),
		modules.map(load_candidate),
	):
		Ok(loaded_modules):
			definition_index_for_loaded_modules(seed, module_table, loaded_modules)
		Err(_):
			None


private pure func module_table_for_loaded_modules(
	loaded_modules: LoadedModuleSet,
) -> Option[ModuleTable]:
	modules = [loaded_module_set_target(loaded_modules)] + loaded_module_set_modules(loaded_modules)
	module_table(
		modules.map(func(module):
			resolved_module_identity_from_resolver(
				loaded_module_canonical_path(module),
				loaded_module_origin(module),
			)
		),
	).to_option()


private pure func callable_ids(index: DefinitionIndex, name: String) -> List[Int]:
	definition_index_func_callable_bindings(index, name).map(pure func(binding): binding[1])


private pure func source_definition_ids(index: DefinitionIndex, name: String) -> List[Int]:
	definition_index_source_definition_bindings(index, name).map(pure func(binding): binding[1])


private pure func definition_index_reserves_each_definition_kind() -> Option[Bool]:
	seed = definition_index_seed()
	base ?= definition_index_for_programs(seed, empty_program(), [])
	base_next = definition_index_next_def_id(base)
	index ?= definition_index_for_programs(seed, target_program(), [dependency_program()])

	Some(
		(
			definition_index_func_callable_id_count(index) == 5
			and definition_index_source_definition_id_count(index) == 5
			and definition_index_next_def_id(index) == base_next + 10
			and callable_ids(index, "main") == [base_next]
			and callable_ids(index, "native_count") == [base_next + 1]
			and source_definition_ids(index, "Signal") == [base_next + 2]
			and source_definition_ids(index, "Ready") == [base_next + 3]
			and source_definition_ids(index, "Busy") == [base_next + 4]
			and callable_ids(index, "answer") == [base_next + 5]
			and callable_ids(index, "hidden") == [base_next + 6]
			and source_definition_ids(index, "Measure") == [base_next + 7, base_next + 8]
			and callable_ids(index, "measure") == [base_next + 9]
		),
	)


pure func test_definition_index_reserves_each_definition_kind() -> Bool:
	definition_index_reserves_each_definition_kind().get_or(False)


pure func test_loaded_module_set_rejects_repeated_programs() -> Bool:
	target = target_program()
	dependency = dependency_program()
	loaded_module_set(
		load_candidate(target),
		[load_candidate(target), load_candidate(dependency), load_candidate(dependency)],
	).is_err()


private pure func definition_index_keeps_overload_ids_distinct() -> Option[Bool]:
	seed = definition_index_seed()
	base ?= definition_index_for_programs(seed, empty_program(), [])
	base_next = definition_index_next_def_id(base)
	overloads = parsed_program(
		"overloads.brp",
		"overloads",
		"pure func convert(value: Int) -> Int:\n\tvalue\n\npure func convert(value: String) -> Int:\n\tvalue.length()",
	)
	index ?= definition_index_for_programs(seed, overloads, [])

	Some(
		(
			definition_index_func_callable_id_count(index) == 2
			and definition_index_source_definition_id_count(index) == 0
			and callable_ids(index, "convert") == [base_next, base_next + 1]
		),
	)


pure func test_definition_index_keeps_overload_ids_distinct() -> Bool:
	definition_index_keeps_overload_ids_distinct().get_or(False)


private pure func definition_index_bulk_build_preserves_same_name_field_owners() -> Option[Bool]:
	seed = definition_index_seed()
	base ?= definition_index_for_programs(seed, empty_program(), [])
	base_next = definition_index_next_def_id(base)
	program = parsed_program(
		"fields.brp",
		"fields",
		"record First {value: Int}\n\nrecord Second {value: String}",
	)
	index ?= definition_index_for_programs(seed, program, [])
	value_bindings = definition_index_source_definition_bindings(index, "value")
	owners = value_bindings.map(func(binding):
		source_definition_key_owner(binding[0]).get_or("")
	)
	ids = value_bindings.map(func(binding): binding[1])
	found = value_bindings.map(func(binding):
		definition_index_find_source_definition_id(
			index,
			definition_index_module_table(index),
			binding[0],
		).get_or(-1)
	)

	Some(
		(
			definition_index_func_callable_id_count(index) == 0
			and definition_index_source_definition_id_count(index) == 4
			and definition_index_next_def_id(index) == base_next + 4
			and owners == ["First", "Second"]
			and ids == [base_next + 1, base_next + 3]
			and found == [base_next + 1, base_next + 3]
		),
	)


pure func test_definition_index_bulk_build_preserves_same_name_field_owners() -> Bool:
	definition_index_bulk_build_preserves_same_name_field_owners().get_or(False)


private pure func definition_index_reserves_only_applicable_default_methods() -> Option[Bool]:
	seed = definition_index_seed()
	base ?= definition_index_for_programs(seed, empty_program(), [])
	base_next = definition_index_next_def_id(base)
	program = parsed_program(
		"defaults.brp",
		"defaults",
		"trait LeftDefault:\n\tpure func left_core(value: Self) -> Int\n\tpure func left_default(value: Self) -> Int: left_core(value)\n\ntrait RightDefault:\n\tpure func right_core(value: Self) -> Int\n\tpure func right_default(value: Self) -> Int: right_core(value)\n\nimplements LeftDefault for Int:\n\tpure func left_core(value: Int) -> Int:\n\t\tvalue\n\nimplements RightDefault for String:\n\tpure func right_core(value: String) -> Int:\n\t\tvalue.length()",
	)
	index ?= definition_index_for_programs(seed, program, [])

	Some(
		(
			definition_index_func_callable_id_count(index) == 4
			and definition_index_source_definition_id_count(index) == 4
			and definition_index_next_def_id(index) == base_next + 8
			and callable_ids(index, "left_default") == [base_next + 3]
			and callable_ids(index, "left_core") == [base_next + 4]
			and callable_ids(index, "right_default") == [base_next + 6]
			and callable_ids(index, "right_core") == [base_next + 7]
		),
	)


pure func test_definition_index_reserves_only_applicable_default_methods() -> Bool:
	definition_index_reserves_only_applicable_default_methods().get_or(False)


private pure func definition_index_dependency_order_does_not_change_ids() -> Option[Bool]:
	seed = definition_index_seed()
	base ?= definition_index_for_programs(seed, empty_program(), [])
	base_next = definition_index_next_def_id(base)
	target = target_program()
	alpha = parsed_program("alpha.brp", "pkg/alpha", "pure func alpha() -> Int:\n\t1")
	zeta = parsed_program("zeta.brp", "pkg/zeta", "pure func zeta() -> Int:\n\t2")
	alpha_first ?= definition_index_for_programs(
		seed,
		target,
		[alpha, zeta],
	)
	zeta_first ?= definition_index_for_programs(
		seed,
		target,
		[zeta, alpha],
	)

	Some(
		(
			callable_ids(alpha_first, "main") == [base_next]
			and callable_ids(zeta_first, "main") == [base_next]
			and callable_ids(alpha_first, "alpha") == callable_ids(zeta_first, "alpha")
			and callable_ids(alpha_first, "zeta") == callable_ids(zeta_first, "zeta")
			and callable_ids(alpha_first, "alpha") == [base_next + 1]
			and callable_ids(alpha_first, "zeta") == [base_next + 2]
		),
	)


pure func test_definition_index_dependency_order_does_not_change_ids() -> Bool:
	definition_index_dependency_order_does_not_change_ids().get_or(False)


private pure func definition_index_resolves_aliased_imported_trait_defaults() -> Option[Bool]:
	seed = definition_index_seed()
	base ?= definition_index_for_programs(seed, empty_program(), [])
	base_next = definition_index_next_def_id(base)
	target = parsed_program(
		"main.brp",
		"main",
		"import:\n\tdep: ImportedDefault as LocalDefault\n\nrecord Box {value: Int}\n\nimplements LocalDefault for Box:\n\tpure func imported_core(value: Box) -> Int:\n\t\tvalue.value",
	)
	dependency = parsed_program(
		"dep.brp",
		"dep",
		"trait ImportedDefault:\n\tpure func imported_core(value: Self) -> Int\n\tpure func imported_default(value: Self) -> Int: imported_core(value)",
	)
	index ?= definition_index_for_programs(seed, target, [dependency])

	Some(
		(
			definition_index_func_callable_id_count(index) == 2
			and definition_index_source_definition_id_count(index) == 4
			and definition_index_next_def_id(index) == base_next + 6
			and source_definition_ids(index, "Box") == [base_next]
			and source_definition_ids(index, "value") == [base_next + 1]
			and callable_ids(index, "imported_default") == [base_next + 3]
			and callable_ids(index, "imported_core") == [base_next + 4]
		),
	)


pure func test_definition_index_resolves_aliased_imported_trait_defaults() -> Bool:
	definition_index_resolves_aliased_imported_trait_defaults().get_or(False)


private pure func definition_index_uses_only_prelude_traits_module_defaults() -> Option[Bool]:
	seed = definition_index_seed()
	base ?= definition_index_for_programs(seed, empty_program(), [])
	base_next = definition_index_next_def_id(base)
	target = parsed_program(
		"main.brp",
		"main",
		"record Box {value: Int}\n\nimplements Equatable for Box:\n\tpure func equals(left: Box, right: Box) -> Bool:\n\t\tleft.value == right.value",
	)
	unrelated_std = parsed_program(
		"other.brp",
		"other",
		"trait Equatable:\n\tpure func wrong_default(value: Self) -> Bool: True",
	)
	unrelated_user = parsed_program(
		"user/traits.brp",
		"traits",
		"trait Equatable:\n\tpure func user_default(value: Self) -> Bool: True",
	)
	prelude_traits = parsed_program(
		"traits.brp",
		"traits",
		"trait Equatable:\n\tpure func equals(left: Self, right: Self) -> Bool\n\tpure func not_equals(left: Self, right: Self) -> Bool: not equals(left, right)",
	)

	match (
		loaded_module_set(
			load_candidate(target),
			[
				load_candidate_with_identity(unrelated_user, "aaa/user-traits", UserModule),
				load_candidate_with_origin(unrelated_std, StdlibModule),
				load_candidate_with_origin(prelude_traits, StdlibModule),
			],
		)
	):
		Err(_):
			Some(False)
		Ok(loaded_modules):
			module_table ?= module_table_for_loaded_modules(loaded_modules)
			index ?= definition_index_for_loaded_modules(seed, module_table, loaded_modules)

			Some(
				(
					definition_index_func_callable_id_count(index) == 2
					and definition_index_source_definition_id_count(index) == 6
					and definition_index_next_def_id(index) == base_next + 8
					and source_definition_ids(index, "Box") == [base_next]
					and source_definition_ids(index, "value") == [base_next + 1]
					and callable_ids(index, "not_equals") == [base_next + 3]
					and callable_ids(index, "equals") == [base_next + 4]
					and callable_ids(index, "wrong_default").length() == 0
					and callable_ids(index, "user_default").length() == 0
				),
			)


pure func test_definition_index_uses_only_prelude_traits_module_defaults() -> Bool:
	definition_index_uses_only_prelude_traits_module_defaults().get_or(False)


tests: TestSuite = {
	description = "Compiler definition index reservations",
	tests = [
		(
			"reserves every definition kind in source order",
			test_definition_index_reserves_each_definition_kind,
		),
		(
			"rejects repeated programs before indexing",
			test_loaded_module_set_rejects_repeated_programs,
		),
		("keeps overload ids distinct", test_definition_index_keeps_overload_ids_distinct),
		(
			"bulk build preserves same-name field owners",
			test_definition_index_bulk_build_preserves_same_name_field_owners,
		),
		(
			"reserves only applicable default methods",
			test_definition_index_reserves_only_applicable_default_methods,
		),
		(
			"dependency order does not change definition ids",
			test_definition_index_dependency_order_does_not_change_ids,
		),
		(
			"resolves aliased imported trait defaults for planning",
			test_definition_index_resolves_aliased_imported_trait_defaults,
		),
		(
			"uses only prelude traits module defaults",
			test_definition_index_uses_only_prelude_traits_module_defaults,
		),
	]
}
