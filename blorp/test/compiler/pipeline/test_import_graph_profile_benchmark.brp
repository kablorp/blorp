import:
	../../../benchmark/compiler/compiler_import_graph_profile_fixture:
		CompilerImportGraphBenchmarkConfig,
		compiler_import_graph_benchmark,
		compiler_import_graph_direct_benchmark,
	test: TestSuite


private func test_import_graph_fixture_exercises_resolved_edges() -> Bool:
	result = compiler_import_graph_benchmark({
		iterations = 1,
		module_count = 3,
		functions_per_module = 2,
		import_fanout = 2,
		retain_parsed_programs = False,
	})

	(
		result.artifact_count == 4
		and result.source_declaration_count == 13
		and result.typed_declaration_count == 13
		and result.resolved_import_count == 6
		and result.import_binding_count == 6
		and result.imported_function_registration_pressure == 12
		and result.error_count == 0
		and result.checksum == 42
		and result.workload_valid
	)


private func test_import_graph_fixture_is_deterministic_when_repeated() -> Bool:
	result = compiler_import_graph_benchmark({
		iterations = 2,
		module_count = 3,
		functions_per_module = 2,
		import_fanout = 2,
		retain_parsed_programs = True,
	})

	result.workload_valid and result.error_count == 0 and result.checksum == 84


private func test_direct_import_graph_fixture_matches_replay() -> Bool:
	config: CompilerImportGraphBenchmarkConfig = {
		iterations = 2,
		module_count = 3,
		functions_per_module = 2,
		import_fanout = 2,
		retain_parsed_programs = True
	}
	replay = compiler_import_graph_benchmark(config)
	direct = compiler_import_graph_direct_benchmark(config)

	(
		direct.artifact_count == replay.artifact_count
		and direct.source_declaration_count == replay.source_declaration_count
		and direct.typed_declaration_count == replay.typed_declaration_count
		and direct.resolved_import_count == replay.resolved_import_count
		and direct.import_binding_count == replay.import_binding_count
		and direct.imported_function_registration_pressure == replay.imported_function_registration_pressure
		and direct.error_count == replay.error_count
		and direct.checksum == replay.checksum
		and direct.workload_valid
		and replay.workload_valid
	)


tests: TestSuite = {
	description = "Compiler import graph profile benchmark",
	tests = [
		(
			"fixture exercises resolved import edges",
			test_import_graph_fixture_exercises_resolved_edges,
		),
		(
			"repeated fixture remains deterministic",
			test_import_graph_fixture_is_deterministic_when_repeated,
		),
		(
			"direct fixture matches descriptive replay",
			test_direct_import_graph_fixture_matches_replay,
		),
	]
}
