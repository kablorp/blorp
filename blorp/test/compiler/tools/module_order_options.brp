-- The command line both module-order dumpers share, so the existing front end
-- and the discovery stage are run on exactly the same input by
-- `scripts/compiler-new-parity`:
--
--   <dumper> <compile|test> <root.brp> [--embedded-std] [--package <spec>]...
--
-- `compile` is the graph `check` and `compile` build; `test` also seeds the test
-- runtime, as `blorp test` does. `--embedded-std` reads the standard library
-- from the texts embedded in the compiler instead of `standard_library/src`.
-- `--package` adds a source package, as `blorp.toml` would:
-- `<alias>:<name>:<source_dir>:<export>,<export>...`.
--
-- Each dumper prints one line per module, in graph order: its origin, a space
-- and its source path (`stdlib`, `user`, `native-package:<id>`,
-- `source-package:<alias>`), so the two sides compare modules, order and
-- origins. An embedded module's path is `<embedded:<name>>`, as the existing
-- front end names it.
enum ModuleOrderMode:
	CompileMode
	TestMode


union StandardLibrarySource:
	StandardLibraryOnDisk
	StandardLibraryEmbedded


record SourcePackageSpec {
	package_alias: String,
	package_name: String,
	source_dir: String,
	exports: List[String]
}


record ModuleOrderOptions {
	mode: ModuleOrderMode,
	root: String,
	standard_library: StandardLibrarySource,
	source_packages: List[SourcePackageSpec]
}


MODE_ARGUMENT: Int = 1

ROOT_ARGUMENT: Int = 2

FIRST_OPTION_ARGUMENT: Int = 3

COMPILE_MODE_NAME: String = "compile"

TEST_MODE_NAME: String = "test"

EMBEDDED_STANDARD_LIBRARY_FLAG: String = "--embedded-std"

PACKAGE_FLAG: String = "--package"

PACKAGE_SPEC_SEPARATOR: String = ":"

EXPORT_SEPARATOR: String = ","

PACKAGE_SPEC_FIELD_COUNT: Int = 4

USAGE: String = (
	"usage: <dumper> <compile|test> <root.brp> [--embedded-std] [--package alias:"
	+ "name:source_dir:export,export]..."
)


pure func module_order_line(origin: String, path: String) -> String:
	origin + " " + path


private pure func parse_package_spec(spec: String) -> Option[SourcePackageSpec]:
	match spec.split(PACKAGE_SPEC_SEPARATOR):
		[package_alias, package_name, source_dir, exports]:
			Some({
				package_alias = package_alias,
				package_name = package_name,
				source_dir = source_dir,
				exports = exports.split(EXPORT_SEPARATOR),
			})
		_:
			None


---
The options in `args`, or the usage text when they are malformed.
---
pure func parse_module_order_options(args: List[String]) -> Result[ModuleOrderOptions, String]:
	mode_name: String = args
		.get(MODE_ARGUMENT)
		.get_or("")
	root: String = args
		.get(ROOT_ARGUMENT)
		.get_or("")
	var standard_library: StandardLibrarySource = StandardLibraryOnDisk
	var source_packages: List[SourcePackageSpec] = []
	var problem: Option[String] = None
	var index: Int = FIRST_OPTION_ARGUMENT

	while index < args.length():
		argument: String = args.get_or(index, "")

		if argument == EMBEDDED_STANDARD_LIBRARY_FLAG:
			standard_library = StandardLibraryEmbedded
			index += 1
		else if argument == PACKAGE_FLAG:
			match parse_package_spec(args.get_or(index + 1, "")):
				Some(spec):
					source_packages = source_packages.append(spec)
				None:
					problem = Some(USAGE)

			index += 2
		else:
			problem = Some(USAGE)
			index += 1

	if problem.is_some() or root == "":
		Err(USAGE)
	else if mode_name == COMPILE_MODE_NAME:
		Ok({
			mode = CompileMode,
			root = root,
			standard_library = standard_library,
			source_packages = source_packages,
		})
	else if mode_name == TEST_MODE_NAME:
		Ok({
			mode = TestMode,
			root = root,
			standard_library = standard_library,
			source_packages = source_packages,
		})
	else:
		Err(USAGE)
