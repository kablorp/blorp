-- Prints the modules the discovery stage loads for one root, one line per
-- module in module id order, for the module-order check of
-- `scripts/compiler-new-parity`; `legacy_module_order_dump.brp` prints the
-- existing front end's graph for the same root. The command line and the
-- line format are `module_order_options`.
--
-- With `--embedded-std` the standard library comes from the compiler's
-- embedded texts (`CompilerEmbeddedTexts`, the composition the legacy adapter
-- owns), and an embedded module's path is printed as the existing
-- front end spells it. This tool imports the compiler's generated inputs, so
-- it lives outside `compiler_new`, whose sources and tests must not.
import:
	../../../src/compiler/discovery_adapter:
		COMPILER_EMBEDDED_TEXTS,
		CompilerEmbeddedTexts,
		legacy_embedded_path,
	../../../src/compiler_new/stage_01_discovery/pipeline:
		ImplicitModules,
		compiler_implicit_modules,
		discover,
		test_implicit_modules,
	../../../src/compiler_new/stage_01_discovery/sources/embedded_standard_library:
		EmbeddedStandardLibraryProvider,
		embedded_lookup_roots,
		embedded_module_name,
	../../../src/compiler_new/stage_01_discovery/sources/source_provider:
		FILE_SYSTEM_SOURCE_PROVIDER,
		FileSystemSourceProvider,
		SourceLookupRoots,
		SourcePackageRoot,
		SourceProvider,
	../../../src/compiler_new/stage_01_discovery/tables/frontend_tables:
		FreezeOutcome(FrozenTables, TableInvariantsViolated),
		FrontendTables,
		module_count,
		module_package,
		module_row,
		name_spelling,
		path_text,
	../../../src/compiler_new/stage_01_discovery/tables/ids: ModuleId, module_id_at_row
	../../../src/compiler_new/stage_01_discovery/tables/row_kinds:
		ModuleOriginKind(PackageModule, SourcePackageModule, StdlibModule, UserModule),
	module_order_options:
		ModuleOrderMode(TestMode),
		ModuleOrderOptions,
		SourcePackageSpec,
		StandardLibrarySource(StandardLibraryEmbedded, StandardLibraryOnDisk),
		module_order_line,
		parse_module_order_options,


STANDARD_LIBRARY_ROOT: String = "standard_library/src"

NATIVE_PACKAGE_ROOT: String = "pkg"

STANDARD_LIBRARY_ORIGIN: String = "stdlib"

USER_ORIGIN: String = "user"

NATIVE_PACKAGE_ORIGIN_PREFIX: String = "native-package:"

SOURCE_PACKAGE_ORIGIN_PREFIX: String = "source-package:"

EXIT_USAGE: Int = 2

EXIT_INVARIANT_VIOLATION: Int = 3


pure func source_package_root(spec: SourcePackageSpec) -> SourcePackageRoot:
	{
		package_alias = spec.package_alias,
		package_name = spec.package_name,
		source_dir = spec.source_dir,
		exports = spec.exports
	}


---
The origin text of a module (see `module_order_options`): the package, when
there is one, is its name for a native package and its alias for a source
package.
---
pure func origin_text(tables: FrontendTables, module: ModuleId) -> String:
	package_name: String = match tables.module_package(module):
		Some(package):
			tables.name_spelling(package.name)
		None:
			""

	match tables.module_row(module).origin:
		StdlibModule:
			STANDARD_LIBRARY_ORIGIN
		UserModule:
			USER_ORIGIN
		PackageModule:
			NATIVE_PACKAGE_ORIGIN_PREFIX + package_name
		SourcePackageModule:
			SOURCE_PACKAGE_ORIGIN_PREFIX + package_name


---
A module's path in the existing front end's spelling: the stage's path, or for
an embedded module `<embedded:name>`.
---
pure func printed_path(tables: FrontendTables, module: ModuleId) -> String:
	path: String = tables.path_text(tables.module_row(module).canonical_path)

	match embedded_module_name(path):
		Some(module_name):
			legacy_embedded_path(module_name)
		None:
			path


func print_modules(tables: FrontendTables) -> Int:
	for index in 0..module_count(tables):
		module = module_id_at_row(index)
		print(module_order_line(tables.origin_text(module), tables.printed_path(module)))

	0


func discovered[Provider:SourceProvider](
	provider: Provider,
	roots: SourceLookupRoots,
	options: ModuleOrderOptions,
) -> Int:
	implicit: ImplicitModules = if options.mode == TestMode:
		test_implicit_modules()
	else:
		compiler_implicit_modules()

	match discover(provider, roots, [options.root], implicit):
		FrozenTables(tables):
			print_modules(tables)
		TableInvariantsViolated(violations):
			print("table invariants violated: ${violations.length()}")
			EXIT_INVARIANT_VIOLATION


func main(args: List[String]) -> Int:
	match parse_module_order_options(args):
		Ok(options):
			source_packages: List[SourcePackageRoot] = options.source_packages.map(
				source_package_root,
			)

			match options.standard_library:
				StandardLibraryOnDisk:
					roots: SourceLookupRoots = {
						standard_library_root = STANDARD_LIBRARY_ROOT,
						native_package_roots = [NATIVE_PACKAGE_ROOT],
						source_packages = source_packages
					}
					discovered(FILE_SYSTEM_SOURCE_PROVIDER, roots, options)
				StandardLibraryEmbedded:
					roots: SourceLookupRoots = embedded_lookup_roots(
						[NATIVE_PACKAGE_ROOT],
						source_packages,
					)
					provider: EmbeddedStandardLibraryProvider[CompilerEmbeddedTexts, FileSystemSourceProvider] = {
						texts = COMPILER_EMBEDDED_TEXTS,
						inner = FILE_SYSTEM_SOURCE_PROVIDER
					}
					discovered(provider, roots, options)
		Err(usage):
			print(usage)
			EXIT_USAGE
