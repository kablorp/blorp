---
The token dump's spelling of a string literal kind, which the new lexer
makes separate token kinds.
---
pure func string_kind_name(k: StringLiteralKind) -> String:
	match k:
		NormalStringLiteral:
			"NormalStringToken"
		RawStringLiteral:
			"RawStringToken"
		InterpolatedStringLiteral:
			"InterpolatedStringToken"
		PipeStringLiteral:
			"PipeStringToken"
		RawPipeStringLiteral:
			"RawPipeStringToken"
		InterpolatedPipeStringLiteral:
			"InterpolatedPipeStringToken"


---
An interpolated string's parts: ` text[...]` for each literal piece and
` hole[...]` for each expression, as the existing splitter makes them.
---
pure func interpolation_parts_text(source: SourceFile, token: Token, body: String) -> String:
	(table, file_id) = singleton_source_table(source)
	location = source_location_from_offsets(file_id, token.start_offset, token.end_offset)

	match split_interpolated_string(table, location, body):
		Ok(parts):
			var out: String = ""

			for part in parts:
				match part:
					InterpolationLiteralText(value):
						out += " text[" + escaped_dump_text(value) + "]"
					InterpolationExprText(value, _):
						out += " hole[" + escaped_dump_text(value) + "]"

			out
		Err(_):
			" split-error"


---
The dump text of a token's kind and payload.
---
pure func kind_text(result: LexResult, token: Token, source: SourceFile) -> String:
	match token_kind_of(result.texts, token):
		IdentifierToken(text):
			"IdentifierToken " + escaped_dump_text(text)
		KeywordToken(k):
			keyword_name(k)
		SymbolToken(s):
			symbol_name(s)
		IntLiteralToken(text):
			"IntLiteralToken " + escaped_dump_text(text)
		FloatLiteralToken(text):
			"FloatLiteralToken " + escaped_dump_text(text)
		StringLiteralToken(k, text):
			if k == InterpolatedStringLiteral or k == InterpolatedPipeStringLiteral:
				string_kind_name(k) + interpolation_parts_text(source, token, text)
			else:
				string_kind_name(k) + " " + escaped_dump_text(text)
		CharLiteralToken(cp):
			"CharLiteralToken " + cp.to_string()
		DocStringToken(text):
			"DocStringToken " + escaped_dump_text(text)
		NewlineToken:
			"NewlineToken"
		IndentToken:
			"IndentToken"
		DedentToken:
			"DedentToken"
		EndOfFileToken:
			"EndOfFileToken"


---
Position of the file-list argument; position 0 is the program.
---
LIST_ARGUMENT: Int = 1


func read_paths(list_path: String) -> List[String]:
	match read_file(list_path):
		Ok(listing):
			listing
				.lines()
				.filter(pure func(line): not line.is_empty())
		Err(_):
			[]


func main(args: List[String]) -> Int:
	for path in read_paths(
		args
			.get(LIST_ARGUMENT)
			.get_or(""),
	):
		match read_file(path):
			Ok(text):
				source: SourceFile = source_file(path, path, text)
				result: LexResult = lex(source, SYNTHESIZED_NAME_TABLE)
				program: ParsedProgram = finalize_interpolation_program(parse_compiler_source(source))
				var lines: List[String] = []

				for token in result.tokens:
					lines = lines.append(
						"${token.start_offset} ${token.end_offset} ${kind_text(result, token, source)}",
					)

				print("== ${path}")
				print(lines.join("\n"))
				print("lexer_diagnostics ${result.diagnostics.length()}")
				print("parse_diagnostics ${program.diagnostics.length()}")

				match program.diagnostics.get(0):
					Some(first):
						print("first_diagnostic ${first.span.start_line}:${first.span.start_column} ${escaped_dump_text(first.message)}")

						match first.help:
							Some(help):
								print("first_help ${escaped_dump_text(help)}")
							None:
								void
					None:
						void
			Err(message):
				print("unreadable ${path}: ${message}")

	0
