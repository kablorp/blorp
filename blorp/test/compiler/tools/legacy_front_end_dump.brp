		DetachKeyword:
			"DetachKeyword"
		SelectKeyword:
			"SelectKeyword"
		IntoOpaqueKeyword:
			"IntoOpaqueKeyword"
		FromKeyword:
			"FromKeyword"
		FromOpaqueKeyword:
			"FromOpaqueKeyword"
