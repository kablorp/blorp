-- Dumps the existing front end's view of each file in a list, in the format
-- of the new discovery stage's `corpus_dump.brp`, for the corpus parity check
-- (`scripts/compiler-new-parity`): per file, the lexer's tokens (byte range,
-- kind and text), the lexer's diagnostic count and the parser's diagnostic
-- count. The parser's count is the accept/reject verdict.
--
-- A file the parser rejects also gets its first diagnostic in the same format
-- as the discovery dump: `first_diagnostic <line>:<column> <message>`, then
-- `first_help <help>` when there is one.
--
-- Usage: legacy_front_end_dump.brp <file listing one source path per line>
--
-- This tool imports the existing compiler, so it lives outside
-- `compiler_new`, whose sources and tests must not.
import:
	../../../src/compiler/stage_02_lex/lexer: LexResult, lex
	../../../src/compiler/stage_02_lex/name_table: SYNTHESIZED_NAME_TABLE
	../../../src/compiler/stage_02_lex/token:
		Keyword(
			FuncKeyword,
			PureKeyword,
			VarKeyword,
			UnionKeyword,
			RecordKeyword,
			VoidKeyword,
			WhileKeyword,
			ForKeyword,
			InKeyword,
			IfKeyword,
			ElseKeyword,
			AndKeyword,
			OrKeyword,
			NotKeyword,
			OnKeyword,
			MatchKeyword,
			TrueKeyword,
			FalseKeyword,
			BreakKeyword,
			ContinueKeyword,
			DebugKeyword,
			StructKeyword,
			EnumKeyword,
			WithKeyword,
			ResourceKeyword,
			ForeignKeyword,
			PrivateKeyword,
			BuiltinKeyword,
			ConcurrentKeyword,
			ConcurrentlyKeyword,
			DetachKeyword,
			SelectKeyword,
			IntoOpaqueKeyword,
			FromKeyword,
			FromOpaqueKeyword,
			AfterKeyword,
			SealedKeyword,
			OpaqueKeyword,
			TryKeyword,
			ImportKeyword,
			AsKeyword,
			TraitKeyword,
			ImplementsKeyword,
			SelfKeyword,
			TypeKeyword,
			AliasKeyword,
			WhereKeyword,
		),
		StringLiteralKind(
			InterpolatedPipeStringLiteral,
			InterpolatedStringLiteral,
			NormalStringLiteral,
			PipeStringLiteral,
			RawPipeStringLiteral,
			RawStringLiteral,
		),
		Symbol(
			LeftParenSymbol,
			RightParenSymbol,
			LeftBracketSymbol,
			RightBracketSymbol,
			LeftBraceSymbol,
			RightBraceSymbol,
			CommaSymbol,
			ColonSymbol,
			DotSymbol,
			DotDotSymbol,
			DotDotDotSymbol,
			ArrowSymbol,
			FatArrowSymbol,
			EqualSymbol,
			QuestionEqualsSymbol,
			PlusSymbol,
			MinusSymbol,
			StarSymbol,
			SlashSymbol,
			PlusEqualSymbol,
			MinusEqualSymbol,
			StarEqualSymbol,
			SlashEqualSymbol,
			UnderscoreSymbol,
			PercentSymbol,
			HashSymbol,
			AtSymbol,
			PipeSymbol,
			EqualEqualSymbol,
			NotEqualSymbol,
			LessSymbol,
			LessEqualSymbol,
			GreaterSymbol,
			GreaterEqualSymbol,
		),
		Token,
		TokenKind(
			CharLiteralToken,
			DedentToken,
			DocStringToken,
			EndOfFileToken,
			FloatLiteralToken,
			IdentifierToken,
			IndentToken,
			IntLiteralToken,
			KeywordToken,
			NewlineToken,
			StringLiteralToken,
			SymbolToken,
		),
		token_kind_of,
	../../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../../src/compiler/stage_03_parse/parsed_ast: ParsedProgram
	../../../src/compiler/stage_03_parse/source_ast_finalize:
		StringInterpolationRawPart(InterpolationExprText, InterpolationLiteralText),
		finalize_interpolation_program,
		split_interpolated_string,
	../../../src/lib/source:
		SourceFile,
		singleton_source_table,
		source_file,
		source_location_from_offsets,
	system: read_file


---
`text` on one line: backslash, newline, tab and carriage return escaped.
---
pure func escaped_dump_text(text: String) -> String:
	text
		.replace("\\", "\\\\")
		.replace("\n", "\\n")
		.replace("\t", "\\t")
		.replace("\r", "\\r")


---
The token dump's spelling of a keyword kind.
---
pure func keyword_name(k: Keyword) -> String:
	match k:
		FuncKeyword:
			"FuncKeyword"
		PureKeyword:
			"PureKeyword"
		VarKeyword:
			"VarKeyword"
		UnionKeyword:
			"UnionKeyword"
		RecordKeyword:
			"RecordKeyword"
		VoidKeyword:
			"VoidKeyword"
		WhileKeyword:
			"WhileKeyword"
		ForKeyword:
			"ForKeyword"
		InKeyword:
			"InKeyword"
		IfKeyword:
			"IfKeyword"
		ElseKeyword:
			"ElseKeyword"
		AndKeyword:
			"AndKeyword"
		OrKeyword:
			"OrKeyword"
		NotKeyword:
