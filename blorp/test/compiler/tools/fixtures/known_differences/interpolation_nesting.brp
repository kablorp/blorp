-- Inputs the existing parser reads wrongly and the discovery stage reads as the
-- language says. The adapter differential reports them, and
-- `ADAPTER_DIFFERENCES` in `scripts/compiler-new-parity` lists each with its
-- reason (`docs/issues/interpolation_nesting_in_the_existing_lexer.md`).
-- Do not run the formatter on this file: it re-reads the strings through the same
-- lexer and rewrites them as the lexer misreads them.
func nesting(h: Int) -> String:
	third_level = "a ${f("b ${g("c ${h}")}")} d"
	pipe_braces =
		|{kept} ${h} {kept}
		|more {text}
	third_level
