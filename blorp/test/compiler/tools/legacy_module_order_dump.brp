-- Prints the existing front end's module graph for one root, one line per
-- module in graph order, for the module-order check of
-- `scripts/compiler-new-parity`: the new discovery stage must load the same
-- modules, in the same order (roots, then the implicit seeds, then imports),
-- with the same origins. The command line and the line format are
-- `module_order_options`.
--
-- This tool imports the existing compiler, so it lives outside
-- `compiler_new`, whose sources and tests must not.
import:
	../../../src/compiler/frontend_request: FrontendSourcePackage
	../../../src/compiler/stage_03_parse/parsed_ast: ParsedProgram
	../../../src/compiler/stage_03_parse/source_ast_finalize: finalized_typecheck_program_ast
	../../../src/compiler/stage_04_modules/frontend_graph: FrontendModule, frontend_graph_modules
	../../../src/compiler/stage_04_modules/loaded_module:
		ModuleOrigin(NativePackageModule, SourcePackageModule, StdlibModule, UserModule),
		resolved_module_origin,
	../../../src/lib/cli_plan: CliParsedSourceFile
	../../../src/lib/source_graph:
		CliSourceGraphSetup,
		frontend_compilation_graph_for_roots_with_setup_and_test_runtime,
		parse_cli_source_with_setup,
	module_order_options:
		ModuleOrderMode(TestMode),
		ModuleOrderOptions,
		SourcePackageSpec,
		StandardLibrarySource(StandardLibraryEmbedded, StandardLibraryOnDisk),
		module_order_line,
		parse_module_order_options,
	system: read_file


ROOT_MODULE_NAME: String = "main"

EXIT_USAGE: Int = 2

EXIT_GRAPH_FAILED: Int = 1

STANDARD_LIBRARY_ROOT: String = "standard_library/src"

NATIVE_PACKAGE_ROOT: String = "pkg"

STANDARD_LIBRARY_ORIGIN: String = "stdlib"

USER_ORIGIN: String = "user"

NATIVE_PACKAGE_ORIGIN_PREFIX: String = "native-package:"

SOURCE_PACKAGE_ORIGIN_PREFIX: String = "source-package:"


pure func origin_text(origin: ModuleOrigin) -> String:
	match origin:
		StdlibModule:
			STANDARD_LIBRARY_ORIGIN
		UserModule:
			USER_ORIGIN
		NativePackageModule(package_id):
			NATIVE_PACKAGE_ORIGIN_PREFIX + package_id
		SourcePackageModule(package_alias):
			SOURCE_PACKAGE_ORIGIN_PREFIX + package_alias


pure func frontend_source_package(spec: SourcePackageSpec) -> FrontendSourcePackage:
	{
		package_alias = spec.package_alias,
		package_name = spec.package_name,
		package_root = spec.source_dir,
		source_dir = spec.source_dir,
		exports = spec.exports
	}


func module_line(module: FrontendModule) -> String:
	program: ParsedProgram = finalized_typecheck_program_ast(module.program)
	module_order_line(resolved_module_origin(module.identity).origin_text(), program.source.path)


func dump(options: ModuleOrderOptions) -> Int:
	match read_file(options.root):
		Ok(text):
			std_dir: Option[String] = match options.standard_library:
				StandardLibraryOnDisk:
					Some(STANDARD_LIBRARY_ROOT)
				StandardLibraryEmbedded:
					None

			setup: CliSourceGraphSetup = {
				context = {
					std_dir = std_dir,
					source_packages = options.source_packages.map(frontend_source_package),
					package_roots = [NATIVE_PACKAGE_ROOT]
				},
				diagnostics = []
			}
			root: CliParsedSourceFile = parse_cli_source_with_setup(
				setup,
				{
					path = options.root,
					module_name = ROOT_MODULE_NAME,
					source_text = text
				},
			)

			match frontend_compilation_graph_for_roots_with_setup_and_test_runtime(
				setup,
				[root],
				options.mode == TestMode,
			):
				Ok(graph):
					for module in frontend_graph_modules(graph.graph):
						print(module_line(module))

					0
				Err(message):
					print(message)
					EXIT_GRAPH_FAILED
		Err(message):
			print(message)
			EXIT_GRAPH_FAILED


func main(args: List[String]) -> Int:
	match parse_module_order_options(args):
		Ok(options):
			dump(options)
		Err(usage):
			print(usage)
			EXIT_USAGE
