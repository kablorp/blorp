-- Prints the existing front end's module graph for one root, one module path
-- per line in graph order, for the module-order check of
-- `scripts/compiler-new-parity`: the new discovery stage must load the same
-- modules in the same order (roots, then the implicit seeds, then imports).
--
-- Usage: legacy_module_order_dump.brp <compile|test> <root.brp>
--
-- `compile` is the graph `check` and `compile` build; `test` also seeds the
-- test runtime, as `blorp test` does. The root's module name is `main`; a
-- standard-library module is its bare module name and any other module its
-- path without `.brp`.
--
-- This tool imports the existing compiler, so it lives outside
-- `compiler_new`, whose sources and tests must not.
import:
	../../../src/compiler/stage_04_modules/frontend_graph: frontend_graph_modules
	../../../src/compiler/stage_04_modules/loaded_module: resolved_module_canonical_path
	../../../src/lib/cli_plan: CliParsedSourceFile
	../../../src/lib/source_graph:
		CliSourceGraphSetup,
		frontend_compilation_graph_for_roots_with_setup_and_test_runtime,
		parse_cli_source_with_setup,
	system: read_file


MODE_ARGUMENT: Int = 1

ROOT_ARGUMENT: Int = 2

TEST_MODE: String = "test"

COMPILE_MODE: String = "compile"

ROOT_MODULE_NAME: String = "main"

EXIT_USAGE: Int = 2

EXIT_GRAPH_FAILED: Int = 1

STANDARD_LIBRARY_ROOT: String = "standard_library/src"

NATIVE_PACKAGE_ROOT: String = "pkg"


func main(args: List[String]) -> Int:
	mode: String = args
		.get(MODE_ARGUMENT)
		.get_or("")
	path: String = args
		.get(ROOT_ARGUMENT)
		.get_or("")

	if mode != TEST_MODE and mode != COMPILE_MODE or path == "":
		print("usage: legacy_module_order_dump.brp <compile|test> <root.brp>")
		EXIT_USAGE
	else:
		match read_file(path):
			Ok(text):
				setup: CliSourceGraphSetup = {
					context = {
						std_dir = Some(STANDARD_LIBRARY_ROOT),
						source_packages = [],
						package_roots = [NATIVE_PACKAGE_ROOT]
					},
					diagnostics = []
				}
				root: CliParsedSourceFile = parse_cli_source_with_setup(
					setup,
					{
						path = path,
						module_name = ROOT_MODULE_NAME,
						source_text = text
					},
				)

				match frontend_compilation_graph_for_roots_with_setup_and_test_runtime(
					setup,
					[root],
					mode == TEST_MODE,
				):
					Ok(graph):
						for module in frontend_graph_modules(graph.graph):
							print(resolved_module_canonical_path(module.identity))

						0
					Err(message):
						print(message)
						EXIT_GRAPH_FAILED
			Err(message):
				print(message)
				EXIT_GRAPH_FAILED
