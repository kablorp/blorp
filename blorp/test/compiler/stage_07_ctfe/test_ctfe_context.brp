pure func fixture_source_file() -> SourceFile:
	source_file("context.brp", "context", "func main(): 0")


pure func fixture_source_span() -> SourceSpan:
	src: SourceFile = fixture_source_file()
	cursor: Cursor = source_cursor_at(src, 0)
	source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, fixture_source_span())


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], fixture_source_span())


pure func parsed_function(name: String) -> ParsedFunctionDecl:
	{
		name = ident(name),
		keyword_span = Some(fixture_source_span()),
		type_params = [],
		params = [],
		return_type = Some(named_type("Int")),
		dim_constraints = [],
		body = None,
		is_pure = True,
		annotations = [],
		doc = None,
		span = fixture_source_span()
	}


pure func optional_ident(text: Option[String]) -> Option[ParsedIdentifier]:
	match text:
		Some(value):
			Some(ident(value))
		None:
			None


pure func parsed_import(module_path: String, alias_name: Option[String]) -> ParsedImportDecl:
	{
		module_path = module_path,
		module_path_span = fixture_source_span(),
		module_alias = optional_ident(alias_name),
		symbols = None,
		span = fixture_source_span()
	}


pure func typed_function(name: String, callable_id: Option[Int]) -> TypedFunctionInfo:
	{
		decl = parsed_function(name),
		callable_id = callable_id,
		effective_type_params = [],
		param_types = [],
		source_return_type = Some(TYPE_INT),
		semantic_return_type = TYPE_INT,
		body = None
	}


pure func typed_program(decls: List[TypedDecl]) -> TypedProgram:
	{
		source = fixture_source_file(),
		decls = decls,
		diagnostics = [],
		type_definitions = [],
		type_references = []
	}


pure func int_value(value: Int) -> CtfeValue:
	ctfe_int(fixture_source_span(), value)


private pure func generated_function_program(
	function_count: Int,
	shared_source_name: Bool,
) -> TypedProgram:
	var decls: List[TypedDecl] = []
	var index: Int = 0

	while index < function_count:
		source_name: String = if shared_source_name:
			"overloaded"
		else:
			index.to_string()

		decls = decls.append(TypedFunctionDecl(typed_function(source_name, Some(index + 1))))
		index += 1

	typed_program(decls)


private record CtfeModuleIdFixture {
	table: ModuleTable,
	definitions: DefinitionTable,
	target: ModuleId,
	dependency: ModuleId,
	foreign_table: ModuleTable,
	foreign_definitions: DefinitionTable,
	foreign_id: ModuleId
}


private pure func ctfe_module_id_fixture() -> Option[CtfeModuleIdFixture]:
	target_identity = resolved_module_identity_from_resolver("target", UserModule)
	dependency_identity = resolved_module_identity_from_resolver("dep", UserModule)
	other_identity = resolved_module_identity_from_resolver("other", UserModule)
	foreign_identity = resolved_module_identity_from_resolver("foreign", UserModule)
	table ?= module_table([
		target_identity,
		dependency_identity,
		other_identity,
		resolved_module_identity_from_resolver("generated/module", UserModule),
		resolved_module_identity_from_resolver("list", UserModule),
		resolved_module_identity_from_resolver("dep/math", UserModule),
		resolved_module_identity_from_resolver("dep/first", UserModule),
		resolved_module_identity_from_resolver("dep/second", UserModule),
		resolved_module_identity_from_resolver("dep/first_value", UserModule),
		resolved_module_identity_from_resolver("dep/second_value", UserModule),
	]).to_option()
	foreign_table ?= module_table([
		target_identity,
		dependency_identity,
		other_identity,
		foreign_identity,
	]).to_option()
	target ?= module_table_find_id_by_canonical_path(table, "target")
	dependency ?= module_table_find_id_by_canonical_path(table, "dep")
	foreign_id ?= module_table_find_id_by_canonical_path(foreign_table, "foreign")
	Some({
		table = table,
		definitions = definition_index_definition_table(
			definition_index_empty(
				definition_index_initial_seed(ENV_EMPTY),
				table,
			),
		),
		target = target,
		dependency = dependency,
		foreign_table = foreign_table,
		foreign_definitions = definition_index_definition_table(
			definition_index_empty(
				definition_index_initial_seed(ENV_EMPTY),
				foreign_table,
			),
		),
		foreign_id = foreign_id,
	})


private pure func ctfe_fixture_context(program: TypedProgram) -> Option[CtfeContext]:
	fixture ?= ctfe_module_id_fixture()
	context_from_programs(fixture.definitions, fixture.target, program, [], [])


private pure func context_from_programs(
	definition_table: DefinitionTable,
	target_module_id: ModuleId,
	program: TypedProgram,
	import_bindings: List[CtfeImportBinding],
	imported_programs: List[CtfeImportedProgram],
) -> Option[CtfeContext]:
	ctfe_context_from_program(
		definition_table,
		target_module_id,
		program,
		import_bindings,
		ctfe_imported_program_set(definition_table, imported_programs),
	)


private pure func ctfe_fixture_imported_context(
	program: TypedProgram,
	module_path: String,
	imported_decls: List[List[TypedDecl]],
) -> Option[CtfeContext]:
	match ctfe_module_id_fixture():
		Some(fixture):
			match module_table_find_id_by_canonical_path(fixture.table, module_path):
				Some(module_id):
					var imported_programs: List[CtfeImportedProgram] = []

					for decls in imported_decls:
						imported_programs = imported_programs.append(
							complete_ctfe_imported_program(
								fixture.definitions,
								module_id,
								decls,
								[],
							),
						)

					context_from_programs(
						fixture.definitions,
						fixture.target,
						program,
						[],
						imported_programs,
					)
				None:
					None
		None:
			None


private pure func ctfe_fixture_module_id(
	context: CtfeContext,
	module_path: String,
) -> Option[ModuleId]:
	module_table_find_id_by_canonical_path(context.module_table, module_path)


private pure func ctfe_fixture_imported_functions_by_source(
	context: CtfeContext,
	module_path: String,
	source_name: String,
) -> List[CtfeFunction]:
	match ctfe_fixture_module_id(context, module_path):
		Some(module_id):
			ctfe_context_imported_functions_by_source(context, module_id, source_name)
		None:
			[]


private pure func context_uses_one_aligned_module_id_domain() -> Option[Bool]:
	fixture ?= ctfe_module_id_fixture()
	generated_module_id ?= module_table_find_id_by_canonical_path(fixture.table, "generated/module")
	first = complete_ctfe_imported_program(
		fixture.definitions,
		fixture.dependency,
		[TypedFunctionDecl(typed_function("render", Some(20)))],
		[],
	)
	second = complete_ctfe_imported_program(
		fixture.definitions,
		fixture.dependency,
		[TypedFunctionDecl(typed_function("render", Some(21)))],
		[],
	)
	context ?= context_from_programs(
		fixture.definitions,
		fixture.target,
		typed_program([]),
		[CtfeQualifiedModuleBinding("Dep", fixture.dependency)],
		[first, second],
	)
	functions = ctfe_context_imported_functions_by_source(context, fixture.dependency, "render")
	with_value = ctfe_context_with_module_global_env(
		context,
		fixture.table,
		fixture.dependency,
		ctfe_bind_global_value(CTFE_ENV_EMPTY, "VALUE", int_value(42)),
	)
	with_foreign = ctfe_context_with_module_global_env(
		with_value,
		fixture.foreign_table,
		fixture.foreign_id,
		ctfe_bind_global_value(CTFE_ENV_EMPTY, "VALUE", int_value(99)),
	)

	alias_matches = match ctfe_context_module_alias(context, "Dep"):
		Some(module_id):
			module_ids_equal(module_id, fixture.dependency)
		None:
			False

	foreign_value_was_rejected = not ctfe_context_module_has_global_binding(
		with_foreign,
		generated_module_id,
		"VALUE",
	)

	functions_match = match (functions.get(0), functions.get(1)):
		(Some(first_function), Some(second_function)):
			(
				functions.length() == 2
				and first_function.info.callable_id == Some(20)
				and second_function.info.callable_id == Some(21)
				and module_ids_equal(first_function.module_id, fixture.dependency)
				and module_ids_equal(second_function.module_id, fixture.dependency)
			)
		_:
			False

	value_matches = match ctfe_context_module_global_value(
		with_foreign,
		fixture.dependency,
		"VALUE",
	):
		Some(value):
			ctfe_values_equal(value, int_value(42))
		None:
			False

	Some(
		(
			module_tables_are_compatible(context.module_table, fixture.table)
			and context.module_global_envs.length() == module_table_count(fixture.table)
			and alias_matches
			and functions_match
			and value_matches
			and foreign_value_was_rejected
		),
	)


pure func test_context_uses_one_aligned_module_id_domain() -> Bool:
	context_uses_one_aligned_module_id_domain().get_or(False)


private pure func context_rejects_imported_program_from_incompatible_domain() -> Option[Bool]:
	fixture ?= ctfe_module_id_fixture()
	foreign_program = complete_ctfe_imported_program(
		fixture.foreign_definitions,
		fixture.foreign_id,
		[TypedFunctionDecl(typed_function("foreign", Some(30)))],
		[],
	)

	foreign_program_set = ctfe_imported_program_set(fixture.foreign_definitions, [foreign_program])
	Some(
		ctfe_context_from_program(
			fixture.definitions,
			fixture.target,
			typed_program([]),
			[],
			foreign_program_set,
		).is_none(),
	)


pure func test_context_rejects_imported_program_from_incompatible_domain() -> Bool:
	context_rejects_imported_program_from_incompatible_domain().get_or(False)


private pure func context_rejects_imported_program_from_different_definition_snapshot(

) -> Option[Bool]:
	fixture ?= ctfe_module_id_fixture()
	other_definitions = definition_index_definition_table(
		definition_index_empty(
			definition_index_initial_seed(ENV_EMPTY),
			fixture.table,
		),
	)
	imported_program = complete_ctfe_imported_program(other_definitions, fixture.dependency, [], [])

	local_program_set = ctfe_imported_program_set(fixture.definitions, [imported_program])
	Some(
		ctfe_context_from_program(
			fixture.definitions,
			fixture.target,
			typed_program([]),
			[],
			local_program_set,
		).is_none(),
	)


pure func test_context_rejects_different_definition_snapshot() -> Bool:
	context_rejects_imported_program_from_different_definition_snapshot().get_or(False)


private func imported_context_allocation_bytes(
	function_count: Int,
	shared_source_name: Bool,
) -> Int:
	imported_program = generated_function_program(function_count, shared_source_name)
	reset_mem_stats()
	context = ctfe_fixture_imported_context(
		typed_program([]),
		"generated/module",
		[imported_program.decls],
	)

	match context:
		Some(value):
			group_count: Int = value.imported_functions.length()
			allocated_bytes: Int = get_mem_stats().bytes_allocated

			expected_group_count: Int = if shared_source_name:
				1
			else:
				function_count

			if group_count == expected_group_count:
				allocated_bytes
			else:
				-1
		None:
			-1


func test_context_imported_function_index_has_bounded_allocation_growth() -> Bool:
	unique_shallow_bytes: Int = imported_context_allocation_bytes(128, False)
	unique_deep_bytes: Int = imported_context_allocation_bytes(512, False)
	overload_shallow_bytes: Int = imported_context_allocation_bytes(128, True)
	overload_deep_bytes: Int = imported_context_allocation_bytes(512, True)
	growth_is_bounded: Bool = (
		unique_shallow_bytes > 0
		and overload_shallow_bytes > 0
		and unique_deep_bytes <= unique_shallow_bytes * 8
		and overload_deep_bytes <= overload_shallow_bytes * 8
	)

	if not growth_is_bounded:
		print(
			"CTFE imported function context bytes: unique=${unique_shallow_bytes.to_string()}/${unique_deep_bytes.to_string()}, overload=${overload_shallow_bytes.to_string()}/${overload_deep_bytes.to_string()}",
		)
	else:
		void

	growth_is_bounded


func test_context_collects_functions_by_callable_id() -> Bool:
	program = typed_program([
		TypedFunctionDecl(typed_function("top", Some(10))),
		TypedFunctionDecl(typed_function("ignored", None)),
		TypedPrivateDecl(TypedFunctionDecl(typed_function("hidden", Some(11)))),
	])

	match ctfe_fixture_context(program):
		Some(context):
			match (
				ctfe_context_function_by_callable_id(context, 10),
				ctfe_context_function_by_callable_id(context, 11),
				ctfe_context_function_by_callable_id(context, 12),
			):
				(Some(top), Some(hidden), None):
					top.source_name == "top" and hidden.source_name == "hidden"
				_:
					False
		None:
			False


func test_context_groups_imported_functions_by_module_and_source() -> Bool:
	imported_program = typed_program([
		TypedFunctionDecl(typed_function("render", Some(20))),
		TypedFunctionDecl(typed_function("render", Some(21))),
		TypedFunctionDecl(typed_function("parse", Some(22))),
	])
	context = ctfe_fixture_imported_context(typed_program([]), "dep", [imported_program.decls])

	match context:
		Some(value):
			render_functions = ctfe_fixture_imported_functions_by_source(value, "dep", "render")
			missing_functions = ctfe_fixture_imported_functions_by_source(value, "other", "render")

			first_function_matches = match render_functions.get(0):
				Some(ctfe_function):
					(
						ctfe_function.source_name == "render"
						and ctfe_context_module_path(value, ctfe_function.module_id) == Some("dep")
					)
				None:
					False

			(
				render_functions.length() == 2
				and missing_functions.length() == 0
				and first_function_matches
			)
		None:
			False


func test_context_groups_private_imported_functions() -> Bool:
	imported_program = typed_program(
		[TypedPrivateDecl(TypedFunctionDecl(typed_function("helper", Some(23))))],
	)
	context = ctfe_fixture_imported_context(typed_program([]), "dep", [imported_program.decls])

	match context:
		Some(value):
			helper_functions = ctfe_fixture_imported_functions_by_source(value, "dep", "helper")

			match helper_functions.get(0):
				Some(ctfe_function):
					(
						helper_functions.length() == 1
						and ctfe_context_module_path(value, ctfe_function.module_id) == Some("dep")
					)
				None:
					False
		None:
			False


func test_context_merges_duplicate_imported_module_groups() -> Bool:
	context = ctfe_fixture_imported_context(
		typed_program([]),
		"dep",
		[
			[TypedFunctionDecl(typed_function("render", Some(24)))],
			[TypedFunctionDecl(typed_function("render", Some(25)))],
		],
	)

	match context:
		Some(value):
			functions = ctfe_fixture_imported_functions_by_source(value, "dep", "render")

			match (functions.get(0), functions.get(1)):
				(Some(first), Some(second)):
					(
						functions.length() == 2
						and first.info.callable_id == Some(24)
						and second.info.callable_id == Some(25)
					)
				_:
					False
		None:
			False


private func context_collects_module_aliases_from_import_blocks() -> Option[Bool]:
	fixture ?= ctfe_module_id_fixture()
	list_id ?= module_table_find_id_by_canonical_path(fixture.table, "list")
	math_id ?= module_table_find_id_by_canonical_path(fixture.table, "dep/math")
	program = typed_program([
		TypedParsedDecl(
			ImportBlockParsedDecl(
				[parsed_import("list", None), parsed_import("dep/math", Some("Math"))],
				fixture_source_span(),
			),
		),
	])
	context ?= context_from_programs(
		fixture.definitions,
		fixture.target,
		program,
		[CtfeQualifiedModuleBinding("list", list_id), CtfeQualifiedModuleBinding("Math", math_id)],
		[],
	)

	default_ok = match ctfe_context_module_alias(context, "list"):
		Some(module_id):
			module_ids_equal(module_id, list_id)
		None:
			False

	explicit_ok = match ctfe_context_module_alias(context, "Math"):
		Some(module_id):
			module_ids_equal(module_id, math_id)
		None:
			False

	missing_ok = ctfe_context_module_alias(context, "dep").is_none()

	Some(default_ok and explicit_ok and missing_ok)


func test_context_collects_module_aliases_from_import_blocks() -> Bool:
	context_collects_module_aliases_from_import_blocks().get_or(False)


private func context_scopes_module_aliases_to_importing_module() -> Option[Bool]:
	fixture ?= ctfe_module_id_fixture()
	first_id ?= module_table_find_id_by_canonical_path(fixture.table, "dep/first")
	second_id ?= module_table_find_id_by_canonical_path(fixture.table, "dep/second")
	first_value_id ?= module_table_find_id_by_canonical_path(fixture.table, "dep/first_value")
	second_value_id ?= module_table_find_id_by_canonical_path(fixture.table, "dep/second_value")
	first_program = typed_program(
		[
			TypedParsedDecl(
				ImportBlockParsedDecl(
					[parsed_import("dep/first_value", Some("Dep"))],
					fixture_source_span(),
				),
			),
		],
	)
	second_program = typed_program(
		[
			TypedParsedDecl(
				ImportBlockParsedDecl(
					[parsed_import("dep/second_value", Some("Dep"))],
					fixture_source_span(),
				),
			),
		],
	)
	context ?= context_from_programs(
		fixture.definitions,
		fixture.target,
		typed_program([]),
		[],
		[
			complete_ctfe_imported_program(
				fixture.definitions,
				first_id,
				first_program.decls,
				[CtfeQualifiedModuleBinding("Dep", first_value_id)],
			),
			complete_ctfe_imported_program(
				fixture.definitions,
				second_id,
				second_program.decls,
				[CtfeQualifiedModuleBinding("Dep", second_value_id)],
			),
		],
	)
	first_context = { context | active_module_id = first_id }
	second_context = { context | active_module_id = second_id }

	first_ok = match ctfe_context_module_alias(first_context, "Dep"):
		Some(module_id):
			module_ids_equal(module_id, first_value_id)
		None:
			False

	second_ok = match ctfe_context_module_alias(second_context, "Dep"):
		Some(module_id):
			module_ids_equal(module_id, second_value_id)
		None:
			False

	Some(first_ok and second_ok and ctfe_context_module_alias(context, "Dep").is_none())


func test_context_scopes_module_aliases_to_importing_module() -> Bool:
	context_scopes_module_aliases_to_importing_module().get_or(False)


private func context_module_global_env_lookup() -> Option[Bool]:
	fixture ?= ctfe_module_id_fixture()
	env = ctfe_bind_global_value(CTFE_ENV_EMPTY, "LIMIT", int_value(42))
	context = ctfe_context_with_module_global_env(
		ctfe_context_empty(fixture.definitions, fixture.target),
		fixture.table,
		fixture.dependency,
		env,
	)

	match ctfe_context_module_global_value(context, fixture.dependency, "LIMIT"):
		Some(value):
			Some(
				(
					ctfe_values_equal(value, int_value(42))
					and ctfe_context_module_has_global_binding(context, fixture.dependency, "LIMIT")
					and not ctfe_context_module_has_global_binding(
						context,
						fixture.dependency,
						"MISSING",
					)
				),
			)
		None:
			Some(False)


func test_context_module_global_env_lookup() -> Bool:
	context_module_global_env_lookup().get_or(False)


tests: TestSuite = {
	description = "Compiler CTFE context",
	tests = [
		(
			"context uses one aligned module id domain",
			test_context_uses_one_aligned_module_id_domain,
		),
		(
			"context rejects imported program from incompatible module domain",
			test_context_rejects_imported_program_from_incompatible_domain,
		),
		(
			"context rejects imported program from a different definition snapshot",
			test_context_rejects_different_definition_snapshot,
		),
		(
			"context collects functions by callable id",
			test_context_collects_functions_by_callable_id,
		),
		(
			"context groups imported functions by module and source",
