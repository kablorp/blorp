import:
	../../../src/compiler/stage_03_parse/parsed_ast:
		ParsedIdentifier,
		ParsedListPatternSpread(ParsedListSpreadName),
		parsed_identifier,
	../../../src/compiler/stage_04_modules/loaded_module:
		ModuleOrigin(UserModule),
		resolved_module_identity_from_resolver,
	../../../src/compiler/stage_04_modules/module_table: singleton_module_table
	../../../src/compiler/stage_06_typecheck/infer:
		TypedPattern(
			TypedConstructorPattern,
			TypedIntPattern,
			TypedListPattern,
			TypedNamePattern,
			TypedOrPattern,
			TypedQualifiedConstructorPattern,
			TypedTuplePattern,
			TypedWildcardPattern,
		),
	../../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticType(SemanticNamedType),
		TYPE_INT,
		type_list,
	../../../src/compiler/stage_07_ctfe/context: CtfeContext, ctfe_context_empty
	../../../src/compiler/stage_07_ctfe/pattern: ctfe_pattern_bind
	../../../src/compiler/stage_07_ctfe/value:
		CtfeValue,
		CtfeValueDesc(CtfeConstructorValue, CtfeListValue, CtfeTupleValue),
		ctfe_constructor_info,
		ctfe_int,
		ctfe_resolved_constructor_info,
		ctfe_value,
		ctfe_values_equal,
	../../../src/lib/source:
		Cursor,
		SourceFile,
		SourceSpan,
		source_cursor_at,
		source_file,
		source_span,
	test: TestSuite


private pure func ctfe_test_context() -> CtfeContext:
	(table, module_id) = singleton_module_table(
		resolved_module_identity_from_resolver(
			"test",
			UserModule,
		),
	)
	ctfe_context_empty(table, module_id)


pure func fixture_source_file() -> SourceFile:
	source_file("pattern.brp", "pattern", "VALUE = 1")


pure func fixture_source_span() -> SourceSpan:
	src: SourceFile = fixture_source_file()
	cursor: Cursor = source_cursor_at(src, 0)
	source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, fixture_source_span())


pure func option_int_type() -> SemanticType:
	SemanticNamedType("Option", [TYPE_INT])


pure func constructor_context() -> CtfeContext:
	ctfe_test_context()


pure func int_value(value: Int) -> CtfeValue:
	ctfe_int(fixture_source_span(), value)


pure func list_value(values: List[CtfeValue]) -> CtfeValue:
	ctfe_value(type_list(TYPE_INT), CtfeListValue(values), fixture_source_span())


pure func tuple_value(values: List[CtfeValue]) -> CtfeValue:
	ctfe_value(
		SemanticNamedType(
			"Tuple",
			[TYPE_INT, TYPE_INT],
		),
		CtfeTupleValue(values),
		fixture_source_span(),
	)


pure func constructor_value(name: String, args: List[CtfeValue]) -> CtfeValue:
	ctfe_value(option_int_type(), CtfeConstructorValue({
			name = name,
			args = args,
			constructor_info = ctfe_constructor_info("Option", args.length()),
		}), fixture_source_span())


pure func resolved_constructor_value(
	context: CtfeContext,
	name: String,
	args: List[CtfeValue],
	definition_id: Int,
) -> CtfeValue:
	ctfe_value(option_int_type(), CtfeConstructorValue({
			name = name,
			args = args,
			constructor_info = ctfe_resolved_constructor_info(
				"Option",
				args.length(),
				context.module_table,
				definition_id,
			),
		}), fixture_source_span())


pure func pattern_matches(
	context: CtfeContext,
	pattern: TypedPattern,
	value: CtfeValue,
) -> Bool:
	match ctfe_pattern_bind(context, pattern, value):
		Ok(Some(_)):
			True
		_:
			False


pure func binding_value(bindings: List[(String, CtfeValue)], name: String) -> Option[CtfeValue]:
	var result: Option[CtfeValue] = None

	for (binding_name, value) in bindings:
		if result.is_none() and binding_name == name:
			result = Some(value)
			break

	result


pure func binding_matches(
	bindings: List[(String, CtfeValue)],
	name: String,
	expected: CtfeValue,
) -> Bool:
	match binding_value(bindings, name):
		Some(value):
			ctfe_values_equal(value, expected)
		None:
			False


func test_binds_wildcard_name_and_literal_patterns() -> Bool:
	value = int_value(7)
	wildcard = ctfe_pattern_bind(
		ctfe_test_context(),
		TypedWildcardPattern(fixture_source_span()),
		value,
	)
	name = ctfe_pattern_bind(
		ctfe_test_context(),
		TypedNamePattern(ident("value"), TYPE_INT),
		value,
	)
	literal = ctfe_pattern_bind(
		ctfe_test_context(),
		TypedIntPattern("7", fixture_source_span()),
		value,
	)

	var wildcard_ok: Bool = False

	match wildcard:
		Ok(Some(bindings)):
			wildcard_ok = bindings.length() == 0
		_:
			void

	var name_ok: Bool = False

	match name:
		Ok(Some(bindings)):
			name_ok = binding_matches(bindings, "value", value)
		_:
			void

	var literal_ok: Bool = False

	match literal:
		Ok(Some(bindings)):
			literal_ok = bindings.length() == 0
		_:
			void

	wildcard_ok and name_ok and literal_ok


func test_binds_tuple_list_and_spread_patterns() -> Bool:
	tuple_result = ctfe_pattern_bind(
		ctfe_test_context(),
		TypedTuplePattern(
			[
				TypedNamePattern(ident("left"), TYPE_INT),
				TypedIntPattern("2", fixture_source_span()),
			],
			fixture_source_span(),
		),
		tuple_value([int_value(1), int_value(2)]),
	)
	list_result = ctfe_pattern_bind(
		ctfe_test_context(),
		TypedListPattern(
			[TypedNamePattern(ident("head"), TYPE_INT)],
			Some(ParsedListSpreadName(ident("tail"))),
			fixture_source_span(),
		),
		list_value([int_value(1), int_value(2), int_value(3)]),
	)

	var tuple_ok: Bool = False

	match tuple_result:
		Ok(Some(bindings)):
			tuple_ok = binding_matches(bindings, "left", int_value(1))
		_:
			void

	var list_ok: Bool = False

	match list_result:
		Ok(Some(bindings)):
			match binding_value(bindings, "tail"):
				Some(value):
					match value.desc:
						CtfeListValue(values):
							list_ok = (
								binding_matches(bindings, "head", int_value(1))
								and values.length() == 2
								and ctfe_values_equal(
									values.get_or(0, int_value(0)),
									int_value(2),
								)
							)
						_:
							void
				None:
					void
		_:
			void

	tuple_ok and list_ok


func test_matches_constructor_and_or_patterns() -> Bool:
	some_value = constructor_value("Some", [int_value(42)])
	none_value = constructor_value("None", [])
	constructor_result = ctfe_pattern_bind(
		constructor_context(),
		TypedConstructorPattern(
			ident("Some"),
			[TypedNamePattern(ident("value"), TYPE_INT)],
			fixture_source_span(),
			"Option",
			42,
		),
		some_value,
	)
	nullary_name_result = ctfe_pattern_bind(
		constructor_context(),
		TypedNamePattern(ident("None"), option_int_type()),
		none_value,
	)
	or_result = ctfe_pattern_bind(
		constructor_context(),
		TypedOrPattern(
			[
				TypedConstructorPattern(
					ident("None"),
					[],
					fixture_source_span(),
					"Option",
					41,
				),
				TypedConstructorPattern(
					ident("Some"),
					[TypedNamePattern(ident("value"), TYPE_INT)],
					fixture_source_span(),
					"Option",
					42,
				),
			],
			fixture_source_span(),
		),
		some_value,
	)

	var constructor_ok: Bool = False

	match constructor_result:
		Ok(Some(bindings)):
			constructor_ok = binding_matches(bindings, "value", int_value(42))
		_:
			void

	var nullary_name_ok: Bool = False

	match nullary_name_result:
		Ok(Some(bindings)):
			nullary_name_ok = binding_matches(bindings, "None", none_value)
		_:
			void

	var or_ok: Bool = False

	match or_result:
		Ok(Some(bindings)):
			or_ok = binding_matches(bindings, "value", int_value(42))
		_:
			void

	constructor_ok and nullary_name_ok and or_ok


func test_constructor_patterns_require_same_resolved_identity_domain() -> Bool:
	context = ctfe_test_context()
	foreign_context = ctfe_test_context()
	pattern = TypedConstructorPattern(
		ident("Some"),
		[TypedNamePattern(ident("value"), TYPE_INT)],
		fixture_source_span(),
		"Option",
		42,
	)

	same = resolved_constructor_value(context, "Some", [int_value(1)], 42)
	different_id = resolved_constructor_value(context, "Some", [int_value(1)], 43)
	different_domain = resolved_constructor_value(foreign_context, "Some", [int_value(1)], 42)

	(
		pattern_matches(context, pattern, same)
		and not pattern_matches(context, pattern, different_id)
		and not pattern_matches(context, pattern, different_domain)
	)


func test_qualified_nested_patterns_keep_exact_constructor_identity() -> Bool:
	context = ctfe_test_context()
	none_pattern = TypedQualifiedConstructorPattern(
		ident("OptionModule"),
		ident("None"),
		[],
		fixture_source_span(),
		"Option",
		41,
	)
	pattern = TypedQualifiedConstructorPattern(
		ident("OptionModule"),
		ident("Some"),
		[none_pattern],
		fixture_source_span(),
		"Option",
		42,
	)
	value = resolved_constructor_value(
		context,
		"Some",
		[resolved_constructor_value(context, "None", [], 41)],
		42,
	)
	wrong_nested = resolved_constructor_value(
		context,
		"Some",
		[resolved_constructor_value(context, "None", [], 99)],
		42,
	)

	pattern_matches(context, pattern, value) and not pattern_matches(context, pattern, wrong_nested)


func test_synthesized_constructor_fallback_checks_parent_and_name() -> Bool:
	context = ctfe_test_context()
	pattern = TypedConstructorPattern(
		ident("Some"),
		[TypedWildcardPattern(fixture_source_span())],
		fixture_source_span(),
		"Option",
		42,
	)
	correct = constructor_value("Some", [int_value(1)])
	wrong_name = constructor_value("Other", [int_value(1)])
	wrong_parent = ctfe_value(option_int_type(), CtfeConstructorValue({
			name = "Some",
			args = [int_value(1)],
			constructor_info = ctfe_constructor_info("Result", 1),
		}), fixture_source_span())

	(
		pattern_matches(context, pattern, correct)
		and not pattern_matches(context, pattern, wrong_name)
		and not pattern_matches(context, pattern, wrong_parent)
	)


tests: TestSuite = {
	description = "Compiler CTFE pattern",
	tests = [
		("binds wildcard name and literal patterns", test_binds_wildcard_name_and_literal_patterns),
		("binds tuple list and spread patterns", test_binds_tuple_list_and_spread_patterns),
		("uses typed constructor decisions and preserves name bindings", test_matches_constructor_and_or_patterns),
		(
			"requires constructor identity and definition domains to match",
			test_constructor_patterns_require_same_resolved_identity_domain,
		),
		(
			"keeps exact identity in qualified nested constructor patterns",
			test_qualified_nested_patterns_keep_exact_constructor_identity,
		),
		(
			"limits synthesized constructor fallback to matching parent and name",
			test_synthesized_constructor_fallback_checks_parent_and_name,
		),
	]
}
