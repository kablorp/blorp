private pure func translates_resolved_trait_method_as_imported_call(
	fixture: CtfeIrFixture,
) -> Bool:
	callable_id = callable_id_definition_id(fixture.trait_length)
	call: ResolvedCallInfo = {
		callee_name = "length",
		source_name = "length#${callable_id}",
		purity = Pure,
		target = ResolvedSelectedTraitMethodCall("Length", fixture.trait_length),
		trait_identity = None,
		bound_type_params = [],
		debug_only = False,
		instantiated_params = [TYPE_INT],
		instantiated_return = TYPE_INT,
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}
	typed = TypedCallExpr(
		name_expr_with_call("length", call),
		[int_expr("1")],
		fixture_source_span(),
		expr_info_with_call(call),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrCallExpr(ctfe_call):
					match ctfe_call.kind:
						CtfeIrImportedCall(direct, module_id):
							(
								direct.callable_id == callable_id
								and direct.source_name == "length"
								and module_ids_equal(module_id, ctfe_test_module_id())
							)
						_:
							False
				_:
					False
		Err(_):
			False


