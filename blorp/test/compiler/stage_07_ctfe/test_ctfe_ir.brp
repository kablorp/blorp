private record CtfeIrFixture {
	table: ModuleTable,
	definitions: DefinitionTable,
	target: ModuleId,
	list_module: ModuleId,
	helper: CallableId,
	write_value: CallableId,
	map: CallableId,
	trait_length: CallableId,
	none_constructor: ConstructorId,
	some_constructor: ConstructorId
}


private pure func insert_callable(
	index: DefinitionIndex,
	table: ModuleTable,
	module_id: ModuleId,
	name: String,
) -> Option[(DefinitionIndex, Int)]:
	definition_id = definition_index_next_def_id(index)
	updated ?= definition_index_insert_func_callable_id(
		index,
		table,
		func_callable_key(module_id, name, fixture_source_span()),
		definition_id,
	).to_option()
	Some((updated, definition_id))


private pure func insert_constructor(
	index: DefinitionIndex,
	table: ModuleTable,
	module_id: ModuleId,
	name: String,
) -> Option[(DefinitionIndex, Int)]:
	definition_id = definition_index_next_def_id(index)
	updated ?= definition_index_insert_source_definition_id(
		index,
		table,
		source_definition_key(
			module_id,
			ConstructorDefinition,
			name,
			Some("Option"),
			fixture_source_span(),
		),
		definition_id,
	).to_option()
	Some((updated, definition_id))


private pure func ctfe_ir_fixture() -> Option[CtfeIrFixture]:
	table ?= module_table([
		resolved_module_identity_from_resolver("target", UserModule),
		resolved_module_identity_from_resolver("list", UserModule),
	]).to_option()
	target ?= module_table_find_id_by_canonical_path(table, "target")
	list_module ?= module_table_find_id_by_canonical_path(table, "list")
	empty = definition_index_empty(definition_index_initial_seed(ENV_EMPTY), table)
	helper_result ?= insert_callable(empty, table, target, "helper")
	with_helper = helper_result[0]
	helper_id = helper_result[1]
	write_result ?= insert_callable(with_helper, table, target, "write_value")
	with_write = write_result[0]
	write_id = write_result[1]
	map_result ?= insert_callable(with_write, table, list_module, "map")
	with_map = map_result[0]
	map_id = map_result[1]
	trait_result ?= insert_callable(with_map, table, list_module, "length")
	with_trait = trait_result[0]
	trait_id = trait_result[1]
	none_result ?= insert_constructor(with_trait, table, target, "None")
	with_none = none_result[0]
	none_id = none_result[1]
	some_result ?= insert_constructor(with_none, table, target, "Some")
	complete = some_result[0]
	some_id = some_result[1]
	definitions = definition_index_definition_table(complete)
	helper ?= callable_id_from_definition_table(definitions, helper_id)
	write_value ?= callable_id_from_definition_table(definitions, write_id)
	map ?= callable_id_from_definition_table(definitions, map_id)
	trait_length ?= callable_id_from_definition_table(definitions, trait_id)
	none_constructor ?= constructor_id_from_definition_table(definitions, none_id)
	some_constructor ?= constructor_id_from_definition_table(definitions, some_id)
	Some({
		table = table,
		definitions = definitions,
		target = target,
		list_module = list_module,
		helper = helper,
		write_value = write_value,
		map = map,
		trait_length = trait_length,
		none_constructor = none_constructor,
		some_constructor = some_constructor,
	})


private pure func ctfe_test_context() -> CtfeContext:
	match ctfe_ir_fixture():
		Some(fixture):
			ctfe_context_empty(fixture.definitions, fixture.target)
		None:
			(table, module_id) = singleton_module_table(
				resolved_module_identity_from_resolver(
					"target",
					UserModule,
				),
			)
			definitions = definition_index_definition_table(
				definition_index_empty(
					definition_index_initial_seed(ENV_EMPTY),
					table,
				),
			)
			ctfe_context_empty(definitions, module_id)


private pure func ctfe_test_module_id() -> ModuleId:
	match ctfe_ir_fixture():
		Some(fixture):
			fixture.list_module
		None:
			singleton_module_table(resolved_module_identity_from_resolver("list", UserModule))[1]


private pure func empty_definition_table(table: ModuleTable) -> DefinitionTable:
	definition_index_definition_table(
		definition_index_empty(
			definition_index_initial_seed(ENV_EMPTY),
			table,
		),
	)


private pure func ctfe_ir_from_typed_expr_without_context(
	expr: TypedExpr,
) -> Result[CtfeIrExpr, CtfeIrTranslateError]:
	ctfe_ir_from_typed_expr(ctfe_test_context(), expr)


pure func fixture_source_file() -> SourceFile:
	source_file("ir.brp", "ir", "VALUE = 1")


pure func fixture_source_span() -> SourceSpan:
	src: SourceFile = fixture_source_file()
	cursor: Cursor = source_cursor_at(src, 0)
	source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, fixture_source_span())


pure func expr_info_for(typ: SemanticType) -> TypedExprInfo:
	{
		source_type = None,
		origin = SynthesizedOrigin("ctfe_ir_test"),
		value_slot = KeptValueSlot(typ),
		proofs = UNREFINED_BINDING,
		resolved_call = None,
		resolved_definition_id = None,
		resource_dependencies = []
	}


pure func expr_info() -> TypedExprInfo:
	expr_info_for(TYPE_INT)


pure func void_expr_info() -> TypedExprInfo:
	expr_info_for(TYPE_VOID)


pure func string_expr_info() -> TypedExprInfo:
	expr_info_for(TYPE_STRING)


pure func resolved_call(
	callable_id: CallableId,
	source_name: String,
	purity: Purity,
) -> ResolvedCallInfo:
	{
		callee_name = source_name,
		source_name = source_name,
		purity = purity,
		target = ResolvedGraphCallableCall(callable_id, ResolvedSourceFunctionCall),
		trait_identity = None,
		bound_type_params = [],
		debug_only = False,
		instantiated_params = [],
		instantiated_return = TYPE_INT,
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}


pure func resolved_constructor_call(
	constructor_id: ConstructorId,
	source_name: String,
	parent_type: String,
) -> ResolvedCallInfo:
	{ resolved_call_template(source_name, Pure) |
		target = ResolvedConstructorCall(constructor_id, parent_type)
	}


pure func resolved_builtin_call(callable_id: Int, source_name: String) -> ResolvedCallInfo:
	{ resolved_call_template(source_name, Pure) |
		target = ResolvedCompilerBuiltinCall(callable_id)
	}


private pure func resolved_call_template(source_name: String, purity: Purity) -> ResolvedCallInfo:
	{
		callee_name = source_name,
		source_name = source_name,
		purity = purity,
		target = ResolvedCompilerBuiltinCall(-1),
		trait_identity = None,
		bound_type_params = [],
		debug_only = False,
		instantiated_params = [],
		instantiated_return = TYPE_INT,
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}


pure func expr_info_with_call(call: ResolvedCallInfo) -> TypedExprInfo:
	{ expr_info() | resolved_call = Some(call) }


pure func expr_info_for_with_call(typ: SemanticType, call: ResolvedCallInfo) -> TypedExprInfo:
	{ expr_info_for(typ) | resolved_call = Some(call) }


pure func int_expr(text: String) -> TypedExpr:
	TypedIntLiteralExpr(text, fixture_source_span(), expr_info())


pure func bool_expr(value: Bool) -> TypedExpr:
	TypedBoolLiteralExpr(value, fixture_source_span(), expr_info_for(TYPE_BOOL))


pure func name_expr(name: String) -> TypedExpr:
	TypedNameExpr(ident(name), expr_info())


pure func name_expr_with_call(name: String, call: ResolvedCallInfo) -> TypedExpr:
	TypedNameExpr(ident(name), expr_info_with_call(call))


pure func constructor_context() -> CtfeContext:
	ctfe_test_context()


pure func is_int_literal(expr: CtfeIrExpr, expected: String) -> Bool:
	match expr.desc:
		CtfeIrLiteralExpr(CtfeIrIntLiteral(text)):
			text == expected
		_:
			False


pure func matches_value_reference(expr: CtfeIrExpr) -> Bool:
	match expr.desc:
		CtfeIrIdentExpr(identifier):
			match identifier.reference_kind:
				CtfeIrValueReference:
					True
				_:
					False
		_:
			False


func test_translates_literals_and_binary_exprs() -> Bool:
	typed = TypedBinaryExpr(
		ParsedAddOp,
		int_expr("1"),
		int_expr("2"),
		fixture_source_span(),
		expr_info(),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrBinaryExpr(ParsedAddOp, left, right):
					(
						is_int_literal(left, "1")
						and is_int_literal(right, "2")
						and types_equal(expr.value_type, TYPE_INT)
					)
				_:
					False
		Err(_):
			False


func test_translates_transparent_and_collection_exprs() -> Bool:
	list_expr = TypedListExpr(
		[int_expr("1"), int_expr("2")],
		fixture_source_span(),
		expr_info(),
	)
	typed = TypedAscriptionExpr(list_expr, TYPE_INT, fixture_source_span(), expr_info())

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrTransparentExpr(inner):
					match inner.desc:
						CtfeIrListExpr(items):
							items.length() == 2
						_:
							False
				_:
					False
		Err(_):
			False


func test_translates_record_and_dict_exprs() -> Bool:
	record_field: TypedRecordField = {
		name = ident("value"),
		value = int_expr("1"),
		span = fixture_source_span(),
		definition_id = None
	}
	dict_entry: TypedDictEntry = {
		key = int_expr("1"),
		value = int_expr("2")
	}
	record_result = ctfe_ir_from_typed_expr_without_context(
		TypedRecordExpr(
			[record_field],
			fixture_source_span(),
			expr_info(),
		),
	)
	dict_result = ctfe_ir_from_typed_expr_without_context(
		TypedDictExpr(
			[dict_entry],
			fixture_source_span(),
			expr_info(),
		),
	)

	var record_ok: Bool = False

	match record_result:
		Ok(record_expr):
			match record_expr.desc:
				CtfeIrRecordExpr(fields):
					match fields.get(0):
						Some(field):
							record_ok = field.name == "value"
						None:
							void
				_:
					void
		Err(_):
			void

	var dict_ok: Bool = False

	match dict_result:
		Ok(dict_expr):
			match dict_expr.desc:
				CtfeIrDictExpr(entries):
					dict_ok = entries.length() == 1
				_:
					void
		Err(_):
			void

	record_ok and dict_ok


func test_translates_field_access_kinds() -> Bool:
	record_field: TypedRecordField = {
		name = ident("value"),
		value = int_expr("1"),
		span = fixture_source_span(),
		definition_id = None
	}
	record_expr = TypedRecordExpr(
		[record_field],
		fixture_source_span(),
		expr_info_for(SemanticNamedType("Box", [])),
	)
	tuple_type = SemanticTupleType([TYPE_INT, TYPE_INT])
	tuple_expr = TypedTupleExpr(
		[int_expr("1"), int_expr("2")],
		fixture_source_span(),
		expr_info_for(tuple_type),
	)
	range_expr = TypedRangeExpr(
		int_expr("0"),
		int_expr("3"),
		fixture_source_span(),
		expr_info_for(SemanticNamedType("Range", [])),
	)

	record_result = ctfe_ir_from_typed_expr_without_context(
		TypedFieldAccessExpr(
			record_expr,
			ident("value"),
			fixture_source_span(),
			expr_info(),
		),
	)
	tuple_result = ctfe_ir_from_typed_expr_without_context(
		TypedFieldAccessExpr(
			tuple_expr,
			ident("1"),
			fixture_source_span(),
			expr_info(),
		),
	)
	range_result = ctfe_ir_from_typed_expr_without_context(
		TypedFieldAccessExpr(
			range_expr,
			ident("start"),
			fixture_source_span(),
			expr_info(),
		),
	)

	var record_ok: Bool = False

	match record_result:
		Ok(expr):
			match expr.desc:
				CtfeIrFieldAccessExpr(access):
					match access.kind:
						CtfeIrRecordField(field):
							record_ok = field == "value"
						_:
							void
				_:
					void
		Err(_):
			void

	var tuple_ok: Bool = False

	match tuple_result:
		Ok(expr):
			match expr.desc:
				CtfeIrFieldAccessExpr(access):
					match access.kind:
						CtfeIrTupleField(index, field):
							tuple_ok = index == 1 and field == "1"
						_:
							void
				_:
					void
		Err(_):
			void

	var range_ok: Bool = False

	match range_result:
		Ok(expr):
			match expr.desc:
				CtfeIrFieldAccessExpr(access):
					match access.kind:
						CtfeIrRangeStartField:
							range_ok = True
						_:
							void
				_:
					void
		Err(_):
			void

	record_ok and tuple_ok and range_ok


func test_translates_imported_global_field_access() -> Bool:
	alias_domain = singleton_module_table(
		resolved_module_identity_from_resolver(
			"dep/math",
			UserModule,
		),
	)
	context = ctfe_context_with_module_alias(
		ctfe_context_empty(empty_definition_table(alias_domain[0]), alias_domain[1]),
		"Dep",
		alias_domain[1],
	)
	typed = TypedFieldAccessExpr(
		name_expr("Dep"),
		ident("OFFSET"),
		fixture_source_span(),
		expr_info(),
	)

	match ctfe_ir_from_typed_expr(context, typed):
		Ok(expr):
			match expr.desc:
				CtfeIrImportedGlobalExpr(imported):
					(
						module_ids_equal(imported.module_id, alias_domain[1])
						and imported.name == "OFFSET"
					)
				_:
					False
		Err(_):
			False


private pure func translates_qualified_constructor_only_from_resolved_call(
	fixture: CtfeIrFixture,
) -> Bool:
	constructor_id = constructor_id_definition_id(fixture.none_constructor)
	context = ctfe_context_with_module_alias(
		ctfe_context_empty(fixture.definitions, fixture.target),
		"Dep",
		fixture.target,
	)
	constructor_call = resolved_constructor_call(
		fixture.none_constructor,
		"None#${constructor_id}",
		"Option",
	)
	resolved = TypedFieldAccessExpr(
		name_expr("Dep"),
		ident("None"),
		fixture_source_span(),
		expr_info_for_with_call(
			SemanticNamedType("Option", [TYPE_INT]),
			constructor_call,
		),
	)
	unresolved = TypedFieldAccessExpr(
		name_expr("Dep"),
		ident("None"),
		fixture_source_span(),
		expr_info_for(SemanticNamedType("Option", [TYPE_INT])),
	)

	resolved_ok = match ctfe_ir_from_typed_expr(context, resolved):
		Ok(expr):
			match expr.desc:
				CtfeIrIdentExpr(identifier):
					match identifier.reference_kind:
						CtfeIrNullaryConstructorReference(constructor):
							(
								constructor.name == "None"
								and constructor.parent_type == "Option"
								and ctfe_resolved_constructor_definition_id(
									constructor.constructor_id,
								) == constructor_id
							)
						_:
							False
				_:
					False
		Err(_):
			False

	unresolved_ok = match ctfe_ir_from_typed_expr(context, unresolved):
		Ok(expr):
			match expr.desc:
				CtfeIrImportedGlobalExpr(imported):
					imported.name == "None"
				_:
					False
		Err(_):
			False

	resolved_ok and unresolved_ok


func test_translates_qualified_constructor_only_from_resolved_call() -> Bool:
	match ctfe_ir_fixture():
		Some(fixture):
			translates_qualified_constructor_only_from_resolved_call(fixture)
		None:
			False


func test_translates_block_local_bindings() -> Bool:
	payload: TypedVarDeclPayload = {
		name = ident("x"),
		annotation = Some(TYPE_INT),
		initializer = int_expr("1"),
		is_mutable = False,
		span = fixture_source_span()
	}
	typed = TypedBlockExpr(
		[TypedVarDeclExpr(payload, void_expr_info()), int_expr("2")],
		fixture_source_span(),
		expr_info(),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrBlockExpr(block):
					match block.items.get(0):
						Some(item):
							match item:
								CtfeIrBindValueItem(name, _, init, is_mutable):
									(
										name == "x"
										and not is_mutable
										and is_int_literal(init, "1")
										and is_int_literal(block.result, "2")
									)
								_:
									False
						None:
							False
				_:
					False
		Err(_):
			False


func test_translates_block_local_assignment_items() -> Bool:
	payload: TypedVarDeclPayload = {
		name = ident("x"),
		annotation = Some(TYPE_INT),
		initializer = int_expr("1"),
		is_mutable = True,
		span = fixture_source_span()
	}
	typed = TypedBlockExpr(
		[
			TypedVarDeclExpr(payload, void_expr_info()),
			TypedAssignExpr(
				ident("x"),
				LocalAssignScope,
				int_expr("2"),
				fixture_source_span(),
				void_expr_info(),
			),
			name_expr("x"),
		],
		fixture_source_span(),
		expr_info(),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrBlockExpr(block):
					match block.items.get(1):
						Some(item):
							match item:
								CtfeIrAssignItem(target, value, _):
									match target:
										CtfeIrLocalAssign(name):
											name == "x" and is_int_literal(value, "2")
										_:
											False
								_:
									False
						None:
							False
				_:
					False
		Err(_):
			False


