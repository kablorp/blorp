pure func fixture_source_file() -> SourceFile:
	source_file("ir.brp", "ir", "VALUE = 1")


pure func fixture_source_span() -> SourceSpan:
	src: SourceFile = fixture_source_file()
	cursor: Cursor = source_cursor_at(src, 0)
	source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, fixture_source_span())


pure func expr_info_for(typ: SemanticType) -> TypedExprInfo:
	{
		source_type = None,
		origin = SynthesizedOrigin("ctfe_ir_test"),
		value_slot = KeptValueSlot(typ),
		proofs = UNREFINED_BINDING,
		resolved_call = None,
		resolved_definition_id = None,
		resource_dependencies = []
	}


pure func expr_info() -> TypedExprInfo:
	expr_info_for(TYPE_INT)


pure func void_expr_info() -> TypedExprInfo:
	expr_info_for(TYPE_VOID)


pure func string_expr_info() -> TypedExprInfo:
	expr_info_for(TYPE_STRING)


pure func resolved_call(callable_id: Int, source_name: String, purity: Purity) -> ResolvedCallInfo:
	resolved_call_with_origin(callable_id, source_name, purity, CallableLocal)


pure func resolved_call_with_origin(
	callable_id: Int,
	source_name: String,
	purity: Purity,
	origin: CallableOrigin,
) -> ResolvedCallInfo:
	{
		callee_name = source_name,
		source_name = source_name,
		purity = purity,
		target = ResolvedDirectCall(callable_id, origin),
		bound_type_params = [],
		debug_only = False,
		instantiated_params = [],
		instantiated_return = TYPE_INT,
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}


pure func expr_info_with_call(call: ResolvedCallInfo) -> TypedExprInfo:
	{ expr_info() | resolved_call = Some(call) }


pure func expr_info_for_with_call(typ: SemanticType, call: ResolvedCallInfo) -> TypedExprInfo:
	{ expr_info_for(typ) | resolved_call = Some(call) }


pure func int_expr(text: String) -> TypedExpr:
	TypedIntLiteralExpr(text, fixture_source_span(), expr_info())


pure func bool_expr(value: Bool) -> TypedExpr:
	TypedBoolLiteralExpr(value, fixture_source_span(), expr_info_for(TYPE_BOOL))


pure func name_expr(name: String) -> TypedExpr:
	TypedNameExpr(ident(name), expr_info())


pure func name_expr_with_call(name: String, call: ResolvedCallInfo) -> TypedExpr:
	TypedNameExpr(ident(name), expr_info_with_call(call))


pure func constructor_context() -> CtfeContext:
	{
		functions = [],
		imported_functions = [],
		constructors = [("None", ctfe_constructor_info("Option", 0, None))],
		module_aliases = [],
		module_global_envs = [],
		active_module_path = None
	}


pure func is_int_literal(expr: CtfeIrExpr, expected: String) -> Bool:
	match expr.desc:
		CtfeIrLiteralExpr(CtfeIrIntLiteral(text)):
			text == expected
		_:
			False


pure func matches_value_reference(expr: CtfeIrExpr) -> Bool:
	match expr.desc:
		CtfeIrIdentExpr(identifier):
			match identifier.reference_kind:
				CtfeIrValueReference:
					True
				_:
					False
		_:
			False


func test_translates_literals_and_binary_exprs() -> Bool:
	typed = TypedBinaryExpr(
		ParsedAddOp,
		int_expr("1"),
		int_expr("2"),
		fixture_source_span(),
		expr_info(),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrBinaryExpr(ParsedAddOp, left, right):
					(
						is_int_literal(left, "1")
						and is_int_literal(right, "2")
						and types_equal(expr.value_type, TYPE_INT)
					)
				_:
					False
		Err(_):
			False


func test_translates_transparent_and_collection_exprs() -> Bool:
	list_expr = TypedListExpr(
		[int_expr("1"), int_expr("2")],
		fixture_source_span(),
		expr_info(),
	)
	typed = TypedAscriptionExpr(list_expr, TYPE_INT, fixture_source_span(), expr_info())

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrTransparentExpr(inner):
					match inner.desc:
						CtfeIrListExpr(items):
							items.length() == 2
						_:
							False
				_:
					False
		Err(_):
			False


func test_translates_record_and_dict_exprs() -> Bool:
	record_field: TypedRecordField = {
		name = ident("value"),
		value = int_expr("1"),
		span = fixture_source_span(),
		definition_id = None
	}
	dict_entry: TypedDictEntry = {
		key = int_expr("1"),
		value = int_expr("2")
	}
	record_result = ctfe_ir_from_typed_expr_without_context(
		TypedRecordExpr(
			[record_field],
			fixture_source_span(),
			expr_info(),
		),
	)
	dict_result = ctfe_ir_from_typed_expr_without_context(
		TypedDictExpr(
			[dict_entry],
			fixture_source_span(),
			expr_info(),
		),
	)

	var record_ok: Bool = False

	match record_result:
		Ok(record_expr):
			match record_expr.desc:
				CtfeIrRecordExpr(fields):
					match fields.get(0):
						Some(field):
							record_ok = field.name == "value"
						None:
							void
				_:
					void
		Err(_):
			void

	var dict_ok: Bool = False

	match dict_result:
		Ok(dict_expr):
			match dict_expr.desc:
				CtfeIrDictExpr(entries):
					dict_ok = entries.length() == 1
				_:
					void
		Err(_):
			void

	record_ok and dict_ok


func test_translates_field_access_kinds() -> Bool:
	record_field: TypedRecordField = {
		name = ident("value"),
		value = int_expr("1"),
		span = fixture_source_span(),
		definition_id = None
	}
	record_expr = TypedRecordExpr(
		[record_field],
		fixture_source_span(),
		expr_info_for(SemanticNamedType("Box", [])),
	)
	tuple_type = SemanticTupleType([TYPE_INT, TYPE_INT])
	tuple_expr = TypedTupleExpr(
		[int_expr("1"), int_expr("2")],
		fixture_source_span(),
		expr_info_for(tuple_type),
	)
	range_expr = TypedRangeExpr(
		int_expr("0"),
		int_expr("3"),
		fixture_source_span(),
		expr_info_for(SemanticNamedType("Range", [])),
	)

	record_result = ctfe_ir_from_typed_expr_without_context(
		TypedFieldAccessExpr(
			record_expr,
			ident("value"),
			fixture_source_span(),
			expr_info(),
		),
	)
	tuple_result = ctfe_ir_from_typed_expr_without_context(
		TypedFieldAccessExpr(
			tuple_expr,
			ident("1"),
			fixture_source_span(),
			expr_info(),
		),
	)
	range_result = ctfe_ir_from_typed_expr_without_context(
		TypedFieldAccessExpr(
			range_expr,
			ident("start"),
			fixture_source_span(),
			expr_info(),
		),
	)

	var record_ok: Bool = False

	match record_result:
		Ok(expr):
			match expr.desc:
				CtfeIrFieldAccessExpr(access):
					match access.kind:
						CtfeIrRecordField(field):
							record_ok = field == "value"
						_:
							void
				_:
					void
		Err(_):
			void

	var tuple_ok: Bool = False

	match tuple_result:
		Ok(expr):
			match expr.desc:
				CtfeIrFieldAccessExpr(access):
					match access.kind:
						CtfeIrTupleField(index, field):
							tuple_ok = index == 1 and field == "1"
						_:
							void
				_:
					void
		Err(_):
			void

	var range_ok: Bool = False

	match range_result:
		Ok(expr):
			match expr.desc:
				CtfeIrFieldAccessExpr(access):
					match access.kind:
						CtfeIrRangeStartField:
							range_ok = True
						_:
							void
				_:
					void
		Err(_):
			void

	record_ok and tuple_ok and range_ok


func test_translates_imported_global_field_access() -> Bool:
	context = ctfe_context_with_module_alias(CTFE_CONTEXT_EMPTY, "Dep", "dep/math")
	typed = TypedFieldAccessExpr(
		name_expr("Dep"),
		ident("OFFSET"),
		fixture_source_span(),
		expr_info(),
	)

	match ctfe_ir_from_typed_expr(context, typed):
		Ok(expr):
			match expr.desc:
				CtfeIrImportedGlobalExpr(imported):
					imported.module_path == "dep/math" and imported.name == "OFFSET"
				_:
					False
		Err(_):
			False


func test_translates_block_local_bindings() -> Bool:
	payload: TypedVarDeclPayload = {
		name = ident("x"),
		annotation = Some(TYPE_INT),
		initializer = int_expr("1"),
		is_mutable = False,
		span = fixture_source_span()
	}
	typed = TypedBlockExpr(
		[TypedVarDeclExpr(payload, void_expr_info()), int_expr("2")],
		fixture_source_span(),
		expr_info(),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrBlockExpr(block):
					match block.items.get(0):
						Some(item):
							match item:
								CtfeIrBindValueItem(name, _, init, is_mutable):
									(
										name == "x"
										and not is_mutable
										and is_int_literal(init, "1")
										and is_int_literal(block.result, "2")
									)
								_:
									False
						None:
							False
				_:
					False
		Err(_):
			False


func test_translates_block_local_assignment_items() -> Bool:
	payload: TypedVarDeclPayload = {
		name = ident("x"),
		annotation = Some(TYPE_INT),
		initializer = int_expr("1"),
		is_mutable = True,
		span = fixture_source_span()
	}
	typed = TypedBlockExpr(
		[
			TypedVarDeclExpr(payload, void_expr_info()),
			TypedAssignExpr(
				ident("x"),
				LocalAssignScope,
				int_expr("2"),
				fixture_source_span(),
				void_expr_info(),
			),
			name_expr("x"),
		],
		fixture_source_span(),
		expr_info(),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrBlockExpr(block):
					match block.items.get(1):
						Some(item):
							match item:
								CtfeIrAssignItem(target, value, _):
									match target:
										CtfeIrLocalAssign(name):
											name == "x" and is_int_literal(value, "2")
										_:
											False
								_:
									False
						None:
							False
				_:
					False
		Err(_):
			False


func test_translates_block_tuple_destructuring_items() -> Bool:
	typed = TypedBlockExpr(
		[
			TypedTupleDestructExpr(
				[ident("left"), ident("right")],
				TypedTupleExpr(
					[int_expr("1"), int_expr("2")],
					fixture_source_span(),
					expr_info(),
				),
				fixture_source_span(),
				void_expr_info(),
			),
			name_expr("left"),
		],
		fixture_source_span(),
		expr_info(),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrBlockExpr(block):
					match block.items.get(0):
						Some(item):
							match item:
								CtfeIrBindTupleItem(names, init):
									match init.desc:
										CtfeIrTupleExpr(items):
											(
												names.length() == 2
												and names.get(0) == Some("left")
												and names.get(1) == Some("right")
												and items.length() == 2
											)
										_:
											False
								_:
									False
						None:
							False
				_:
					False
		Err(_):
			False


func test_translates_block_question_bind_items() -> Bool:
	typed = TypedBlockExpr(
		[
			TypedQuestionBindExpr(
				ident("value"),
				Some(TYPE_INT),
				name_expr("maybe"),
				fixture_source_span(),
				void_expr_info(),
			),
			name_expr("value"),
		],
		fixture_source_span(),
		expr_info(),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrBlockExpr(block):
					match block.items.get(0):
						Some(item):
							match item:
								CtfeIrBindQuestionItem(name, annotation, rhs):
									match annotation:
										Some(typ):
											(
												name == "value"
												and types_equal(typ, TYPE_INT)
												and matches_value_reference(rhs)
											)
										None:
											False
								_:
									False
						None:
							False
				_:
					False
		Err(_):
			False


func test_translates_string_interpolation_parts() -> Bool:
	typed = TypedStringInterpolationPartsExpr(
		[TypedInterpolationLiteral("n="), TypedInterpolationExpr(int_expr("42"))],
		False,
		fixture_source_span(),
		string_expr_info(),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrStringInterpolationExpr(parts, is_multiline):
					match parts.get(0):
						Some(CtfeIrStringText(text)):
							match parts.get(1):
								Some(CtfeIrStringExpr(value)):
									(
										text == "n="
										and is_int_literal(value, "42")
										and not is_multiline
										and types_equal(expr.value_type, TYPE_STRING)
									)
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


func test_translates_match_exprs() -> Bool:
	case_zero: TypedMatchCase = {
		pattern = TypedIntPattern("0", fixture_source_span()),
		body = int_expr("0"),
		span = fixture_source_span()
	}
	case_value: TypedMatchCase = {
		pattern = TypedNamePattern(ident("value"), TYPE_INT),
		body = name_expr("value"),
		span = fixture_source_span()
	}
	typed = TypedMatchExpr(
		int_expr("1"),
		[case_zero, case_value],
		fixture_source_span(),
		expr_info(),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrMatchExpr(scrutinee, cases):
					match cases.get(1):
						Some(case):
							(
								is_int_literal(scrutinee, "1")
								and cases.length() == 2
								and matches_value_reference(case.body)
							)
						None:
							False
				_:
					False
		Err(_):
			False


func test_translates_while_and_loop_control() -> Bool:
	typed = TypedWhileExpr(
		bool_expr(True),
		TypedBreakExpr(fixture_source_span(), void_expr_info()),
		fixture_source_span(),
		void_expr_info(),
	)
	while_result = ctfe_ir_from_typed_expr_without_context(typed)
	break_result = ctfe_ir_from_typed_expr_without_context(
		TypedBreakExpr(
			fixture_source_span(),
			void_expr_info(),
		),
	)
	continue_result = ctfe_ir_from_typed_expr_without_context(
		TypedContinueExpr(
			fixture_source_span(),
			void_expr_info(),
		),
	)

	var while_ok: Bool = False

	match while_result:
		Ok(expr):
			match expr.desc:
				CtfeIrWhileExpr(condition, body):
					var condition_ok: Bool = False
					var body_ok: Bool = False

					match condition.desc:
						CtfeIrLiteralExpr(CtfeIrBoolLiteral(value)):
							condition_ok = value
						_:
							void

					match body.desc:
						CtfeIrBreakExpr:
							body_ok = True
						_:
							void

					while_ok = types_equal(expr.value_type, TYPE_VOID) and condition_ok and body_ok
				_:
					void
		Err(_):
			void

	var control_ok: Bool = False

	match break_result:
		Ok(break_expr):
			match continue_result:
				Ok(continue_expr):
					var break_ok: Bool = False
					var continue_ok: Bool = False

					match break_expr.desc:
						CtfeIrBreakExpr:
							break_ok = True
						_:
							void

					match continue_expr.desc:
						CtfeIrContinueExpr:
							continue_ok = True
						_:
							void

					control_ok = break_ok and continue_ok
				Err(_):
					void
		Err(_):
			void

	while_ok and control_ok


func test_translates_for_loops() -> Bool:
	iterable = TypedListExpr([int_expr("1")], fixture_source_span(), expr_info())
	name_result = ctfe_ir_from_typed_expr_without_context(
		TypedForExpr(
			ParsedForNameBinder(ident("item")),
			iterable,
			None,
			TypedContinueExpr(fixture_source_span(), void_expr_info()),
			fixture_source_span(),
			void_expr_info(),
		),
	)
	tuple_result = ctfe_ir_from_typed_expr_without_context(
		TypedForExpr(
			ParsedForTupleBinder(
				[ident("left"), ident("right")],
				fixture_source_span(),
			),
			iterable,
			None,
			TypedBreakExpr(
				fixture_source_span(),
				void_expr_info(),
			),
			fixture_source_span(),
			void_expr_info(),
		),
	)

	var name_ok: Bool = False

	match name_result:
		Ok(expr):
			match expr.desc:
				CtfeIrForExpr(name, _, body):
					var body_ok: Bool = False

					match body.desc:
						CtfeIrContinueExpr:
							body_ok = True
						_:
							void

					name_ok = name == "item" and body_ok
				_:
					void
		Err(_):
			void

	var tuple_ok: Bool = False

	match tuple_result:
		Ok(expr):
			match expr.desc:
				CtfeIrForTupleExpr(names, _, body):
					var body_ok: Bool = False

					match body.desc:
						CtfeIrBreakExpr:
							body_ok = True
						_:
							void

					tuple_ok = (
						names.length() == 2
						and names.get_or(0, "") == "left"
						and names.get_or(1, "") == "right"
						and body_ok
					)
				_:
					void
		Err(_):
			void

	name_ok and tuple_ok


func test_translates_name_references() -> Bool:
	value_result = ctfe_ir_from_typed_expr(constructor_context(), name_expr("value"))
	constructor_result = ctfe_ir_from_typed_expr(constructor_context(), name_expr("None"))

	var value_ok: Bool = False

	match value_result:
		Ok(value_expr):
			match value_expr.desc:
				CtfeIrIdentExpr(value_ident):
					match value_ident.reference_kind:
						CtfeIrValueReference:
							value_ok = True
						_:
							void
				_:
					void
		Err(_):
			void

	var constructor_ok: Bool = False

	match constructor_result:
		Ok(constructor_expr):
			match constructor_expr.desc:
				CtfeIrIdentExpr(constructor_ident):
					match constructor_ident.reference_kind:
						CtfeIrNullaryConstructorReference(constructor):
							constructor_ok = (
								constructor.name == "None"
								and constructor.parent_type == "Option"
							)
						_:
							void
				_:
					void
		Err(_):
			void

	value_ok and constructor_ok


func test_translates_resolved_nullary_constructor_reference_without_context() -> Bool:
	constructor_call = resolved_call_with_origin(41, "None#41", Pure, CallableConstructor("Option"))

	match ctfe_ir_from_typed_expr_without_context(name_expr_with_call("None", constructor_call)):
		Ok(expr):
			match expr.desc:
				CtfeIrIdentExpr(identifier):
					match identifier.reference_kind:
						CtfeIrNullaryConstructorReference(constructor):
							(
								constructor.name == "None"
								and constructor.parent_type == "Option"
								and constructor.callable_id == Some(41)
							)
						_:
							False
				_:
					False
		Err(_):
			False


func test_translates_local_function_references() -> Bool:
	pure_typed = name_expr_with_call(
		"helper",
		resolved_call(7, "helper#7", Pure),
	)
	impure_typed = name_expr_with_call(
		"write_value",
		resolved_call(8, "write_value#8", Impure),
	)

	pure_ok = match ctfe_ir_from_typed_expr_without_context(pure_typed):
		Ok(expr):
			match expr.desc:
				CtfeIrIdentExpr(identifier):
					match identifier.reference_kind:
						CtfeIrLocalFunctionReference(call):
							call.callable_id == 7 and call.source_name == "helper" and call.is_pure
						_:
							False
				_:
					False
		Err(_):
			False

	impure_ok = match ctfe_ir_from_typed_expr_without_context(impure_typed):
		Ok(expr):
			match expr.desc:
				CtfeIrIdentExpr(identifier):
					match identifier.reference_kind:
						CtfeIrLocalFunctionReference(call):
							(
								call.callable_id == 8
								and call.source_name == "write_value"
								and not call.is_pure
							)
						_:
							False
				_:
					False
		Err(_):
			False

	pure_ok and impure_ok


func test_translates_call_kinds() -> Bool:
	local_call = resolved_call(7, "helper#7", Pure)
	constructor_call = resolved_call_with_origin(8, "Some#8", Pure, CallableConstructor("Option"))
	imported_call = resolved_call_with_origin(9, "map#9", Pure, CallableImported("list"))
	local_typed = TypedCallExpr(
		name_expr_with_call("helper", local_call),
		[int_expr("1")],
		fixture_source_span(),
		expr_info_with_call(local_call),
	)
	constructor_typed = TypedCallExpr(
		name_expr_with_call("Some", constructor_call),
		[int_expr("2")],
		fixture_source_span(),
		expr_info_for_with_call(
			SemanticNamedType("Option", [TYPE_INT]),
			constructor_call,
		),
	)
	imported_typed = TypedCallExpr(
		name_expr_with_call("map", imported_call),
		[int_expr("3")],
		fixture_source_span(),
		expr_info_with_call(imported_call),
	)

	local_result = ctfe_ir_from_typed_expr_without_context(local_typed)
	constructor_result = ctfe_ir_from_typed_expr_without_context(constructor_typed)
	imported_result = ctfe_ir_from_typed_expr_without_context(imported_typed)

	var local_ok: Bool = False

	match local_result:
		Ok(expr):
			match expr.desc:
				CtfeIrCallExpr(call):
					match call.kind:
						CtfeIrLocalCall(direct):
							local_ok = (
								direct.callable_id == 7
								and direct.source_name == "helper"
								and call.args.length() == 1
							)
						_:
							void
				_:
					void
		Err(_):
			void

	var constructor_ok: Bool = False

	match constructor_result:
		Ok(expr):
			match expr.desc:
				CtfeIrCallExpr(call):
					match call.kind:
						CtfeIrConstructorCall(direct, parent_type):
							constructor_ok = (
								direct.callable_id == 8
								and direct.source_name == "Some"
								and parent_type == "Option"
								and call.args.length() == 1
							)
						_:
							void
				_:
					void
		Err(_):
			void

	var imported_ok: Bool = False

	match imported_result:
		Ok(expr):
			match expr.desc:
				CtfeIrCallExpr(call):
					match call.kind:
						CtfeIrImportedCall(direct, module_path):
							imported_ok = (
								direct.callable_id == 9
								and direct.source_name == "map"
								and module_path == "list"
								and call.args.length() == 1
							)
						_:
							void
				_:
					void
		Err(_):
			void

	local_ok and constructor_ok and imported_ok


func test_translates_supported_builtin_call() -> Bool:
	builtin_call = resolved_call_with_origin(10, "to_float32", Pure, CallableBuiltin)
	typed = TypedCallExpr(
		name_expr_with_call("to_float32", builtin_call),
		[int_expr("1")],
		fixture_source_span(),
		expr_info_for_with_call(
			SemanticNamedType("Float32", []),
			builtin_call,
		),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrCallExpr(call):
					match call.kind:
						CtfeIrBuiltinCall(direct, _):
							(
								direct.callable_id == 10
								and direct.source_name == "to_float32"
								and direct.is_pure
								and call.args.length() == 1
							)
						_:
							False
				_:
					False
		Err(_):
			False


func test_keeps_unadmitted_builtin_call_unsupported() -> Bool:
	builtin_call = resolved_call_with_origin(11, "hash_combine", Pure, CallableBuiltin)
	typed = TypedCallExpr(
		name_expr_with_call(
			"hash_combine",
			builtin_call,
		),
		[int_expr("1"), int_expr("2")],
		fixture_source_span(),
		expr_info_with_call(builtin_call),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrCallExpr(call):
					match call.kind:
						CtfeIrUnsupportedCall(form):
							form == "hash_combine"
						_:
							False
				_:
					False
		Err(_):
			False


func test_translates_resolved_trait_method_as_imported_call() -> Bool:
	call: ResolvedCallInfo = {
		callee_name = "length",
		source_name = "length#17",
		purity = Pure,
		target = ResolvedTraitMethodCall("Length", Some({
				callable_id = 17,
				module_path = "list",
		})),
		bound_type_params = [],
		debug_only = False,
		instantiated_params = [TYPE_INT],
		instantiated_return = TYPE_INT,
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}
	typed = TypedCallExpr(
		name_expr_with_call("length", call),
		[int_expr("1")],
		fixture_source_span(),
		expr_info_with_call(call),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrCallExpr(ctfe_call):
					match ctfe_call.kind:
						CtfeIrImportedCall(direct, module_path):
							(
								direct.callable_id == 17
								and direct.source_name == "length"
								and module_path == "list"
							)
						_:
							False
				_:
					False
		Err(_):
			False


func test_rejects_unsupported_forms_at_translation_boundary() -> Bool:
	typed = TypedSubscriptExpr(
		name_expr("items"),
		[int_expr("0")],
		fixture_source_span(),
		expr_info(),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Err(error):
			(
				error.form == "subscript expressions"
				and error.span.path == "ir.brp"
				and error.span.module_name == "ir"
				and error.span.start_offset == 0
				and error.span.end_offset == 0
				and ctfe_ir_translate_error_message(
					error,
				) == "compile-time constant evaluation does not support subscript expressions yet"
			)
		Ok(_):
			False


func test_translates_lambda_as_explicit_ctfe_ir() -> Bool:
	typed = TypedLambdaExpr(
		True,
		[],
		Some(TYPE_INT),
		int_expr("42"),
		fixture_source_span(),
		expr_info_for(SemanticFunctionType(True, [], TYPE_INT)),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrLambdaExpr(lambda):
					(
						lambda.is_pure
						and lambda.params.length() == 0
						and lambda.return_annotation.is_some()
						and types_equal(typed_expr_value_type(lambda.body), TYPE_INT)
					)
				_:
					False
		Err(_):
			False


tests: TestSuite = {
	description = "Compiler CTFE IR",
	tests = [
		("translates literals and binary exprs", test_translates_literals_and_binary_exprs),
		(
			"translates transparent and collection exprs",
			test_translates_transparent_and_collection_exprs,
		),
		("translates record and dict exprs", test_translates_record_and_dict_exprs),
		("translates lambdas as explicit CTFE IR", test_translates_lambda_as_explicit_ctfe_ir),
		("translates field access kinds", test_translates_field_access_kinds),
		("translates imported global field access", test_translates_imported_global_field_access),
		("translates block local bindings", test_translates_block_local_bindings),
		("translates block local assignment items", test_translates_block_local_assignment_items),
		(
			"translates block tuple destructuring items",
			test_translates_block_tuple_destructuring_items,
		),
		("translates block question bind items", test_translates_block_question_bind_items),
		("translates string interpolation parts", test_translates_string_interpolation_parts),
		("translates match exprs", test_translates_match_exprs),
		("translates while and loop control", test_translates_while_and_loop_control),
		("translates for loops", test_translates_for_loops),
		("translates name references", test_translates_name_references),
		(
			"translates resolved nullary constructor reference without context",
			test_translates_resolved_nullary_constructor_reference_without_context,
		),
		("translates local function references", test_translates_local_function_references),
		("translates call kinds", test_translates_call_kinds),
		("translates supported builtin call", test_translates_supported_builtin_call),
		(
			"keeps unadmitted builtin call unsupported",
			test_keeps_unadmitted_builtin_call_unsupported,
		),
		(
			"translates resolved trait method as imported call",
			test_translates_resolved_trait_method_as_imported_call,
		),
		(
			"rejects unsupported forms at translation boundary",
			test_rejects_unsupported_forms_at_translation_boundary,
		),
	]
}
