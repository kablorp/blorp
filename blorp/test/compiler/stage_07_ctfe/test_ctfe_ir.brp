func test_translates_match_exprs() -> Bool:
	case_zero: TypedMatchCase = {
		pattern = TypedIntPattern("0", fixture_source_span()),
		body = int_expr("0"),
		span = fixture_source_span()
	}
	case_value: TypedMatchCase = {
		pattern = TypedNamePattern(ident("value"), TYPE_INT),
		body = name_expr("value"),
		span = fixture_source_span()
	}
	typed = TypedMatchExpr(
		int_expr("1"),
		[case_zero, case_value],
		fixture_source_span(),
		expr_info(),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrMatchExpr(scrutinee, cases):
					match cases.get(1):
						Some(case):
							(
								is_int_literal(scrutinee, "1")
								and cases.length() == 2
								and matches_value_reference(case.body)
							)
						None:
							False
				_:
					False
		Err(_):
			False


func test_translates_while_and_loop_control() -> Bool:
	typed = TypedWhileExpr(
		bool_expr(True),
		TypedBreakExpr(fixture_source_span(), void_expr_info()),
		fixture_source_span(),
		void_expr_info(),
	)
	while_result = ctfe_ir_from_typed_expr_without_context(typed)
	break_result = ctfe_ir_from_typed_expr_without_context(
		TypedBreakExpr(
			fixture_source_span(),
			void_expr_info(),
		),
	)
	continue_result = ctfe_ir_from_typed_expr_without_context(
		TypedContinueExpr(
			fixture_source_span(),
			void_expr_info(),
		),
	)

	var while_ok: Bool = False

	match while_result:
		Ok(expr):
			match expr.desc:
				CtfeIrWhileExpr(condition, body):
					var condition_ok: Bool = False
					var body_ok: Bool = False

					match condition.desc:
						CtfeIrLiteralExpr(CtfeIrBoolLiteral(value)):
							condition_ok = value
						_:
							void

					match body.desc:
						CtfeIrBreakExpr:
							body_ok = True
						_:
							void

					while_ok = types_equal(expr.value_type, TYPE_VOID) and condition_ok and body_ok
				_:
					void
		Err(_):
			void

	var control_ok: Bool = False

	match break_result:
		Ok(break_expr):
			match continue_result:
				Ok(continue_expr):
					var break_ok: Bool = False
					var continue_ok: Bool = False

					match break_expr.desc:
						CtfeIrBreakExpr:
							break_ok = True
						_:
							void

					match continue_expr.desc:
						CtfeIrContinueExpr:
							continue_ok = True
						_:
							void

					control_ok = break_ok and continue_ok
				Err(_):
					void
		Err(_):
			void

	while_ok and control_ok


func test_translates_for_loops() -> Bool:
	iterable = TypedListExpr([int_expr("1")], fixture_source_span(), expr_info())
	name_result = ctfe_ir_from_typed_expr_without_context(
		TypedForExpr(
			ParsedForNameBinder(ident("item")),
			iterable,
			None,
			TypedContinueExpr(fixture_source_span(), void_expr_info()),
			fixture_source_span(),
			void_expr_info(),
		),
	)
	tuple_result = ctfe_ir_from_typed_expr_without_context(
		TypedForExpr(
			ParsedForTupleBinder(
				[ident("left"), ident("right")],
				fixture_source_span(),
			),
			iterable,
			None,
			TypedBreakExpr(
				fixture_source_span(),
				void_expr_info(),
			),
			fixture_source_span(),
			void_expr_info(),
		),
	)

	var name_ok: Bool = False

	match name_result:
		Ok(expr):
			match expr.desc:
				CtfeIrForExpr(name, _, body):
					var body_ok: Bool = False

					match body.desc:
						CtfeIrContinueExpr:
							body_ok = True
						_:
							void

					name_ok = name == "item" and body_ok
				_:
					void
		Err(_):
			void

	var tuple_ok: Bool = False

	match tuple_result:
		Ok(expr):
			match expr.desc:
				CtfeIrForTupleExpr(names, _, body):
					var body_ok: Bool = False

					match body.desc:
						CtfeIrBreakExpr:
							body_ok = True
						_:
							void

					tuple_ok = (
						names.length() == 2
						and names.get_or(0, "") == "left"
						and names.get_or(1, "") == "right"
						and body_ok
					)
				_:
					void
		Err(_):
			void

	name_ok and tuple_ok


func test_translates_name_references() -> Bool:
	value_result = ctfe_ir_from_typed_expr(constructor_context(), name_expr("value"))
	constructor_result = ctfe_ir_from_typed_expr(constructor_context(), name_expr("None"))

	var value_ok: Bool = False

	match value_result:
		Ok(value_expr):
			match value_expr.desc:
				CtfeIrIdentExpr(value_ident):
					match value_ident.reference_kind:
						CtfeIrValueReference:
							value_ok = True
						_:
							void
				_:
					void
		Err(_):
			void

	var unresolved_name_ok: Bool = False

	match constructor_result:
		Ok(unresolved_expr):
			match unresolved_expr.desc:
				CtfeIrIdentExpr(identifier):
					match identifier.reference_kind:
						CtfeIrValueReference:
							unresolved_name_ok = True
						_:
							void
				_:
					void
		Err(_):
			void

	value_ok and unresolved_name_ok


private pure func translates_resolved_nullary_constructor_reference_without_context(
	fixture: CtfeIrFixture,
) -> Bool:
	constructor_id = constructor_id_definition_id(fixture.none_constructor)
	constructor_call = resolved_constructor_call(
		fixture.none_constructor,
		"None#${constructor_id}",
		"Option",
	)

	match ctfe_ir_from_typed_expr_without_context(name_expr_with_call("None", constructor_call)):
		Ok(expr):
			match expr.desc:
				CtfeIrIdentExpr(identifier):
					match identifier.reference_kind:
						CtfeIrNullaryConstructorReference(constructor):
							(
								constructor.name == "None"
								and constructor.parent_type == "Option"
								and ctfe_resolved_constructor_definition_id(
									constructor.constructor_id,
								) == constructor_id
							)
						_:
							False
				_:
					False
		Err(_):
			False


