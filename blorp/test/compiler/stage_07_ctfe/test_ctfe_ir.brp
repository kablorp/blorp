private pure func translates_local_function_references(fixture: CtfeIrFixture) -> Bool:
	pure_id = callable_id_definition_id(fixture.helper)
	impure_id = callable_id_definition_id(fixture.write_value)
	pure_typed = name_expr_with_call(
		"helper",
		resolved_call(fixture.helper, "helper#${pure_id}", Pure),
	)
	impure_typed = name_expr_with_call(
		"write_value",
		resolved_call(fixture.write_value, "write_value#${impure_id}", Impure),
	)

	pure_ok = match ctfe_ir_from_typed_expr_without_context(pure_typed):
		Ok(expr):
			match expr.desc:
				CtfeIrIdentExpr(identifier):
					match identifier.reference_kind:
						CtfeIrLocalFunctionReference(callable_id, call):
							(
								callable_id_definition_id(callable_id) == pure_id
								and call.callable_id == pure_id
								and call.source_name == "helper"
								and call.is_pure
							)
						_:
							False
				_:
					False
		Err(_):
			False

	impure_ok = match ctfe_ir_from_typed_expr_without_context(impure_typed):
		Ok(expr):
			match expr.desc:
				CtfeIrIdentExpr(identifier):
					match identifier.reference_kind:
						CtfeIrLocalFunctionReference(callable_id, call):
							(
								callable_id_definition_id(callable_id) == impure_id
								and call.callable_id == impure_id
								and call.source_name == "write_value"
								and not call.is_pure
							)
						_:
							False
				_:
					False
		Err(_):
			False

	pure_ok and impure_ok


func test_translates_local_function_references() -> Bool:
	match ctfe_ir_fixture():
		Some(fixture):
			translates_local_function_references(fixture)
		None:
			False


private pure func translates_call_kinds(fixture: CtfeIrFixture) -> Bool:
	local_id = callable_id_definition_id(fixture.helper)
	constructor_id = constructor_id_definition_id(fixture.some_constructor)
	imported_id = callable_id_definition_id(fixture.map)
	local_call = resolved_call(fixture.helper, "helper#${local_id}", Pure)
	constructor_call = resolved_constructor_call(
		fixture.some_constructor,
		"Some#${constructor_id}",
		"Option",
	)
	imported_call = resolved_call(fixture.map, "map#${imported_id}", Pure)
	local_typed = TypedCallExpr(
		name_expr_with_call("helper", local_call),
		[int_expr("1")],
		fixture_source_span(),
		expr_info_with_call(local_call),
	)
	constructor_typed = TypedCallExpr(
		name_expr_with_call("Some", constructor_call),
		[int_expr("2")],
		fixture_source_span(),
		expr_info_for_with_call(
			SemanticNamedType("Option", [TYPE_INT]),
			constructor_call,
		),
	)
	imported_typed = TypedCallExpr(
		name_expr_with_call("map", imported_call),
		[int_expr("3")],
		fixture_source_span(),
		expr_info_with_call(imported_call),
	)

	local_result = ctfe_ir_from_typed_expr_without_context(local_typed)
	constructor_result = ctfe_ir_from_typed_expr_without_context(constructor_typed)
	imported_result = ctfe_ir_from_typed_expr_without_context(imported_typed)

	var local_ok: Bool = False

	match local_result:
		Ok(expr):
			match expr.desc:
				CtfeIrCallExpr(call):
					match call.kind:
						CtfeIrLocalCall(direct):
							local_ok = (
								direct.callable_id == local_id
								and direct.source_name == "helper"
								and call.args.length() == 1
							)
						_:
							void
				_:
					void
		Err(_):
			void

	var constructor_ok: Bool = False

	match constructor_result:
		Ok(expr):
			match expr.desc:
				CtfeIrCallExpr(call):
					match call.kind:
						CtfeIrConstructorCall(direct, parent_type, resolved_id):
							constructor_ok = (
								direct.callable_id == constructor_id
								and direct.source_name == "Some"
								and parent_type == "Option"
								and ctfe_resolved_constructor_definition_id(resolved_id) == constructor_id
								and call.args.length() == 1
							)
						_:
							void
				_:
					void
		Err(_):
			void

	var imported_ok: Bool = False

	match imported_result:
		Ok(expr):
			match expr.desc:
				CtfeIrCallExpr(call):
					match call.kind:
						CtfeIrImportedCall(direct, module_id):
							imported_ok = (
								direct.callable_id == imported_id
								and direct.source_name == "map"
								and module_ids_equal(module_id, ctfe_test_module_id())
								and call.args.length() == 1
							)
						_:
							void
				_:
					void
		Err(_):
			void

	local_ok and constructor_ok and imported_ok


func test_translates_call_kinds() -> Bool:
	match ctfe_ir_fixture():
		Some(fixture):
			translates_call_kinds(fixture)
		None:
			False


private pure func rejects_definition_backed_call_outside_context_table(
	fixture: CtfeIrFixture,
) -> Bool:
	callable_id = callable_id_definition_id(fixture.helper)
	call = resolved_call(fixture.helper, "helper#${callable_id}", Pure)
	typed = TypedCallExpr(
		name_expr_with_call("helper", call),
		[int_expr("1")],
		fixture_source_span(),
		expr_info_with_call(call),
	)
	context = ctfe_context_empty(
		empty_definition_table(fixture.table),
		fixture.target,
	)

	match ctfe_ir_from_typed_expr(context, typed):
		Err(error):
			(
				error.kind == CtfeIrInvalidGraphIdentity
				and ctfe_ir_translate_error_message(error) == "internal compiler error: compile-time evaluation received a definition-backed call outside the canonical definition table"
			)
		Ok(_):
			False


func test_rejects_definition_backed_call_outside_context_table() -> Bool:
	match ctfe_ir_fixture():
		Some(fixture):
			rejects_definition_backed_call_outside_context_table(fixture)
		None:
			False


private pure func graph_context_rejects_unindexed_call_target(
	fixture: CtfeIrFixture,
	target: ResolvedCallTarget,
) -> Bool:
	call = { resolved_call_template("helper", Pure) | target = target }
	typed = TypedCallExpr(
		name_expr_with_call("helper", call),
		[int_expr("1")],
		fixture_source_span(),
		expr_info_with_call(call),
	)
	context = { ctfe_context_empty(fixture.definitions, fixture.target) |
		identity_domain = CtfeGraphIdentityDomain
	}

	match ctfe_ir_from_typed_expr(context, typed):
		Err(error):
			error.kind == CtfeIrInvalidGraphIdentity
		Ok(_):
			False


private pure func rejects_unindexed_calls_in_graph_context(fixture: CtfeIrFixture) -> Bool:
	(
		graph_context_rejects_unindexed_call_target(
			fixture,
			ResolvedUnindexedCallableCall(999, ResolvedSourceFunctionCall),
		)
		and graph_context_rejects_unindexed_call_target(
			fixture,
			ResolvedUnindexedSelectedTraitMethodCall("Sized", 999),
		)
	)


func test_rejects_unindexed_calls_in_graph_context() -> Bool:
	match ctfe_ir_fixture():
		Some(fixture):
			rejects_unindexed_calls_in_graph_context(fixture)
		None:
			False


