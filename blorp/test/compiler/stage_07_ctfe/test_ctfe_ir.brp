		None:
			False

func test_rejects_unsupported_forms_at_translation_boundary() -> Bool:
	typed = TypedSubscriptExpr(
		name_expr("items"),
		[int_expr("0")],
		fixture_source_span(),
		expr_info(),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Err(error):
			(
				error.form == "subscript expressions"
				and error.span.path == "ir.brp"
				and error.span.module_name == "ir"
				and error.span.start_offset == 0
				and error.span.end_offset == 0
				and ctfe_ir_translate_error_message(
					error,
				) == "compile-time constant evaluation does not support subscript expressions yet"
			)
		Ok(_):
			False


func test_translates_lambda_as_explicit_ctfe_ir() -> Bool:
	typed = TypedLambdaExpr(
		True,
		[],
		Some(TYPE_INT),
		int_expr("42"),
		fixture_source_span(),
		expr_info_for(SemanticFunctionType(True, [], TYPE_INT)),
	)

	match ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CtfeIrLambdaExpr(lambda):
					(
						lambda.is_pure
						and lambda.params.length() == 0
						and lambda.return_annotation.is_some()
						and types_equal(typed_expr_value_type(lambda.body), TYPE_INT)
					)
				_:
					False
		Err(_):
			False


tests: TestSuite = {
	description = "Compiler CTFE IR",
	tests = [
		("translates literals and binary exprs", test_translates_literals_and_binary_exprs),
		(
			"translates transparent and collection exprs",
			test_translates_transparent_and_collection_exprs,
		),
		("translates record and dict exprs", test_translates_record_and_dict_exprs),
		("translates lambdas as explicit CTFE IR", test_translates_lambda_as_explicit_ctfe_ir),
