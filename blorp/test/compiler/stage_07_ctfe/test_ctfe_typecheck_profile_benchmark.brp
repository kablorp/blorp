import:
	../../../../compiler/benchmarks/compiler_ctfe_typecheck_profile_fixture:
		CompilerCtfeTypecheckBenchmarkConfig,
		compiler_ctfe_typecheck_benchmark,
		compiler_ctfe_typecheck_benchmark_request,
	../../../src/compiler/stage_06_typecheck/bridge:
		CtfeEagerFallbackKind(
			CtfeNoCallableRootsFallback,
			CtfeNoEagerFallback,
			CtfeUnresolvedTraitDispatchFallback,
		),
		typecheck_graph_with_metrics,
	test: TestSuite


private func test_ctfe_typecheck_fixture_exercises_function_only_dependency_chain() -> Bool:
	result = compiler_ctfe_typecheck_benchmark({
		iterations = 1,
		module_count = 3,
		functions_per_module = 2,
		retain_parsed_programs = False,
	})

	(
		result.artifact_count == 1
		and result.dependency_declaration_count == 8
		and result.ctfe_dependency_body_check_count == 3
		and result.target_declaration_count == 3
		and result.resolved_import_count == 3
		and result.evaluated_answer == 3
		and result.error_count == 0
		and result.ctfe_evaluated_count == 1
		and result.checksum == 18
		and result.workload_valid
	)


private func test_ctfe_typecheck_fixture_is_deterministic_when_repeated() -> Bool:
	result = compiler_ctfe_typecheck_benchmark({
		iterations = 2,
		module_count = 3,
		functions_per_module = 2,
		retain_parsed_programs = True,
	})

	(
		result.workload_valid
		and result.error_count == 0
		and result.ctfe_evaluated_count == 2
		and result.checksum == 36
	)


private func test_ctfe_typecheck_fixture_models_reachable_and_irrelevant_bodies() -> Bool:
	narrow = compiler_ctfe_typecheck_benchmark({
		iterations = 1,
		module_count = 3,
		functions_per_module = 1,
		retain_parsed_programs = False,
	})
	wide = compiler_ctfe_typecheck_benchmark({
		iterations = 1,
		module_count = 3,
		functions_per_module = 8,
		retain_parsed_programs = False,
	})

	(
		narrow.expected_ctfe_reachable_function_body_count == 3
		and wide.expected_ctfe_reachable_function_body_count == 3
		and narrow.expected_ctfe_irrelevant_function_body_count == 0
		and wide.expected_ctfe_irrelevant_function_body_count == 21
		and narrow.ctfe_dependency_body_check_count == 3
		and wide.ctfe_dependency_body_check_count == 3
		and narrow.evaluated_answer == wide.evaluated_answer
	)


private func test_ctfe_checked_body_is_reused_for_selected_module_output() -> Bool:
	config: CompilerCtfeTypecheckBenchmarkConfig = {
		iterations = 1,
		module_count = 3,
		functions_per_module = 2,
		retain_parsed_programs = True
	}
	request = compiler_ctfe_typecheck_benchmark_request(config)
	run = typecheck_graph_with_metrics(
		{ request | module_targets = ["bench/ctfe_typecheck_profile_2"] },
	)

	(
		run.graph.target.errors.is_empty()
		and run.graph.modules.length() == 1
		and run.graph.modules
			.get(0)
			.map(func(module): module.errors.is_empty())
			.get_or(False)
		and run.ctfe.dependency_body_checks == 3
		and run.ctfe.target_discovery_body_checks == 0
		and run.ctfe.reused_body_checks == 1
		and run.ctfe.selective_dependency_modules == 3
		and run.ctfe.eager_dependency_modules == 0
		and run.ctfe.eager_fallback == CtfeNoEagerFallback
	)


private func test_recursive_ctfe_body_is_checked_once() -> Bool:
	config: CompilerCtfeTypecheckBenchmarkConfig = {
		iterations = 1,
		module_count = 1,
		functions_per_module = 1,
		retain_parsed_programs = False
	}
	request = compiler_ctfe_typecheck_benchmark_request(config)
	recursive_source = "pure func ctfe_m0_function_0(value: Int) -> Int:\n" + "\tif value == 0:\n" + "\t\t0\n" + "\telse:\n" + "\t\tctfe_m0_function_0(value - 1)\n"

	recursive_module = request.modules
		.get(0)
		.map(func(module): { module |
				text = recursive_source,
				typecheck_program = None
			})

	match recursive_module:
		Some(module):
			run = typecheck_graph_with_metrics({ request | modules = [module] })

			(
				run.graph.target.errors.is_empty()
				and run.graph.target.ctfe_evaluated
				and run.ctfe.dependency_body_checks == 1
			)
		None:
			False


private func test_repeated_ctfe_roots_share_one_body_check() -> Bool:
	config: CompilerCtfeTypecheckBenchmarkConfig = {
		iterations = 1,
		module_count = 1,
		functions_per_module = 1,
		retain_parsed_programs = False
	}
	request = compiler_ctfe_typecheck_benchmark_request(config)
	target_source = "import:\n" + "\tbench/ctfe_typecheck_profile_0 as Dependency\n\n" + "first: Int = Dependency.ctfe_m0_function_0(0)\n" + "second: Int = Dependency.ctfe_m0_function_0(1)\n\n" + "func main(args: List[String]) -> Int:\n" + "\tfirst + second\n"

	run = typecheck_graph_with_metrics(
		{ request | target = { request.target |
				text = target_source,
				typecheck_program = None
			} },
	)

	(
		run.graph.target.errors.is_empty()
		and run.graph.target.ctfe_evaluated
		and run.ctfe.dependency_body_checks == 1
	)


private func test_ctfe_lambda_callback_checks_only_owning_function_body() -> Bool:
	config: CompilerCtfeTypecheckBenchmarkConfig = {
		iterations = 1,
		module_count = 1,
		functions_per_module = 1,
		retain_parsed_programs = False
	}
	request = compiler_ctfe_typecheck_benchmark_request(config)
	module_source = "pure func apply(value: Int, callback: pure (Int) -> Int) -> Int:\n" + "\tcallback(value)\n\n" + "pure func increment(value: Int) -> Int:\n" + "\tvalue + 1\n\n" + "pure func unused(value: Int) -> Int:\n" + "\tvalue + 100\n"

	target_source = "import:\n" + "\tbench/ctfe_typecheck_profile_0 as Dependency\n\n" + "answer: Int = Dependency.apply(0, func(value): value + 1)\n\n" + "func main(args: List[String]) -> Int:\n" + "\tanswer\n"

	module = request.modules
		.get(0)
		.map(func(found): { found |
				text = module_source,
				typecheck_program = None
			})

	match module:
		Some(dependency):
			run = typecheck_graph_with_metrics(
				{ request |
					modules = [dependency],
					target = { request.target |
						text = target_source,
						typecheck_program = None
					}
				},
			)
			(
				run.graph.target.errors.is_empty()
				and run.graph.target.ctfe_evaluated
				and run.ctfe.dependency_body_checks == 1
			)
		None:
			False


private func test_ctfe_impl_method_uses_selected_callable_artifact() -> Bool:
	config: CompilerCtfeTypecheckBenchmarkConfig = {
		iterations = 1,
		module_count = 1,
		functions_per_module = 1,
		retain_parsed_programs = False
	}
	request = compiler_ctfe_typecheck_benchmark_request(config)
	module_source = "record Tagged {value: Int}\n\n" + "trait Taggable:\n" + "\tpure func tag_value(self: Self) -> Int\n\n" + "implements Taggable for Tagged:\n" + "\tpure func tag_value(self: Tagged) -> Int:\n" + "\t\tself.value\n\n" + "pure func selected() -> Int:\n" + "\t{value = 42}.tag_value()\n\n" + "pure func unused() -> Int:\n" + "\t100\n"

	target_source = "import:\n" + "\tbench/ctfe_typecheck_profile_0 as Dependency\n\n" + "answer: Int = Dependency.selected()\n\n" + "func main(args: List[String]) -> Int:\n" + "\tanswer\n"

	module = request.modules
		.get(0)
		.map(func(found): { found |
				text = module_source,
				typecheck_program = None
			})

	match module:
		Some(dependency):
			run = typecheck_graph_with_metrics(
				{ request |
					modules = [dependency],
					target = { request.target |
						text = target_source,
						typecheck_program = None
					}
				},
			)

			(
				run.graph.target.errors.is_empty()
				and run.graph.target.ctfe_evaluated
				and run.ctfe.dependency_body_checks == 2
				and run.ctfe.target_discovery_body_checks == 0
				and run.ctfe.selective_dependency_modules == 1
				and run.ctfe.eager_dependency_modules == 0
			)
		None:
			False


