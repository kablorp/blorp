			False


private func test_imported_constructor_requires_no_source_body() -> Bool:
	config: CompilerCtfeTypecheckBenchmarkConfig = {
		iterations = 1,
		module_count = 1,
		functions_per_module = 1,
		retain_parsed_programs = False
	}
	request = compiler_ctfe_typecheck_benchmark_request(config)
	module_source = "union Wrapped:\n" + "\tValue(Int)\n\n" + "pure func selected() -> Int: 7\n"
	target_source = "import:\n" + "\tbench/ctfe_typecheck_profile_0 as Dependency\n\n" + "answer: Dependency.Wrapped = Dependency.Value(42)\n" + "selected: Int = Dependency.selected()\n\n" + "func main(args: List[String]) -> Int:\n" + "\tmatch answer:\n" + "\t\tDependency.Value(value): value + selected\n"
	module = request.modules
		.get(0)
		.map(func(found): { found |
				text = module_source,
				typecheck_program = None
			})

	match module:
		Some(dependency):
			run = typecheck_graph_with_metrics(
				{ request |
					modules = [dependency],
					target = { request.target |
						text = target_source,
						typecheck_program = None
					}
				},
			)

			(
				run.graph.target.errors.is_empty()
				and run.graph.target.ctfe_evaluated
				and run.ctfe.dependency_body_checks == 1
				and run.ctfe.selective_dependency_modules == 1
				and run.ctfe.eager_dependency_modules == 0
			)
		None:
			False


private func test_no_callable_roots_use_explicit_eager_mode() -> Bool:
	config: CompilerCtfeTypecheckBenchmarkConfig = {
		iterations = 1,
		module_count = 1,
		functions_per_module = 1,
		retain_parsed_programs = False
	}
	request = compiler_ctfe_typecheck_benchmark_request(config)
	module_source = "ANSWER: Int = 42\n"
	target_source = "import:\n" + "\tbench/ctfe_typecheck_profile_0: ANSWER\n\n" + "RESULT: Int = ANSWER\n\n" + "func main(args: List[String]) -> Int:\n" + "\tRESULT\n"
	module = request.modules
		.get(0)
		.map(func(found): { found |
				text = module_source,
				typecheck_program = None
			})

	match module:
		Some(dependency):
			run = typecheck_graph_with_metrics(
				{ request |
					modules = [dependency],
					target = { request.target |
						text = target_source,
						typecheck_program = None
					}
				},
			)

			(
				run.graph.target.errors.is_empty()
				and run.graph.target.ctfe_evaluated
				and run.ctfe.dependency_body_checks == 0
				and run.ctfe.selective_dependency_modules == 0
				and run.ctfe.eager_dependency_modules == 1
				and run.ctfe.eager_fallback == CtfeNoCallableRootsFallback
			)
		None:
			False


private func test_unresolved_trait_dispatch_uses_eager_mode() -> Bool:
	config: CompilerCtfeTypecheckBenchmarkConfig = {
		iterations = 1,
		module_count = 1,
		functions_per_module = 1,
		retain_parsed_programs = False
	}
	request = compiler_ctfe_typecheck_benchmark_request(config)
	module_source = "record Box {value: Int}\n\n" + "trait Measurable:\n" + "\tpure func measure(self: Self) -> Int\n\n" + "implements Measurable for Box:\n" + "\tpure func measure(self: Box) -> Int: self.value\n\n" + "pure func generic_measure[T: Measurable](value: T) -> Int: value.measure()\n\n" + "pure func selected() -> Int: generic_measure({value = 42})\n"
	target_source = "import:\n" + "\tbench/ctfe_typecheck_profile_0 as Dependency\n\n" + "answer: Int = Dependency.selected()\n\n" + "func main(args: List[String]) -> Int:\n" + "\tanswer\n"
	module = request.modules
		.get(0)
		.map(func(found): { found |
				text = module_source,
				typecheck_program = None
			})

	match module:
		Some(dependency):
			run = typecheck_graph_with_metrics(
				{ request |
					modules = [dependency],
					target = { request.target |
						text = target_source,
						typecheck_program = None
					}
				},
			)
			(
				run.ctfe.selective_dependency_modules == 0
				and run.ctfe.eager_dependency_modules == 1
				and run.ctfe.eager_fallback == CtfeUnresolvedTraitDispatchFallback
			)
		None:
			False


private func test_unresolved_target_dispatch_preserves_target_check_metrics() -> Bool:
	config: CompilerCtfeTypecheckBenchmarkConfig = {
		iterations = 1,
		module_count = 1,
		functions_per_module = 1,
		retain_parsed_programs = False
	}
	request = compiler_ctfe_typecheck_benchmark_request(config)
	module_source = "pure func dependency_value() -> Int: 40\n"
	target_source = "import:\n" + "\tbench/ctfe_typecheck_profile_0 as Dependency\n\n" + "record Box {value: Int}\n\n" + "trait Measurable:\n" + "\tpure func measure(self: Self) -> Int\n\n" + "implements Measurable for Box:\n" + "\tpure func measure(self: Box) -> Int: self.value\n\n" + "pure func generic_measure[T: Measurable](value: T) -> Int: value.measure()\n\n" + "pure func local_answer() -> Int: generic_measure({value = Dependency.dependency_value()})\n\n" + "answer: Int = local_answer()\n\n" + "func main(args: List[String]) -> Int:\n" + "\tanswer\n"
	module = request.modules
		.get(0)
		.map(func(found): { found |
				text = module_source,
				typecheck_program = None
			})

	match module:
		Some(dependency):
			run = typecheck_graph_with_metrics(
				{ request |
					modules = [dependency],
					target = { request.target |
						text = target_source,
						typecheck_program = None
					}
				},
			)
			(
				run.ctfe.eager_dependency_modules == 1
				and run.ctfe.target_discovery_body_checks == 2
				and run.ctfe.eager_fallback == CtfeUnresolvedTraitDispatchFallback
			)
		None:
			False


private func test_ctfe_checked_main_keeps_entrypoint_validation() -> Bool:
	config: CompilerCtfeTypecheckBenchmarkConfig = {
		iterations = 1,
		module_count = 1,
		functions_per_module = 1,
		retain_parsed_programs = False
	}
	request = compiler_ctfe_typecheck_benchmark_request(config)
	module_source = "pure func dependency_value() -> Int: 42\n"
	target_source = "import:\n" + "\tbench/ctfe_typecheck_profile_0 as Dependency\n\n" + "pure func main() -> Int: Dependency.dependency_value()\n\n" + "answer: Int = main()\n"
	module = request.modules
		.get(0)
		.map(func(found): { found |
				text = module_source,
				typecheck_program = None
			})

	match module:
		Some(dependency):
			run = typecheck_graph_with_metrics(
				{ request |
					modules = [dependency],
					target = { request.target |
						text = target_source,
						typecheck_program = None
					}
				},
			)
			run.graph.target.errors.any(
				func(error): error.contains("main must have one parameter of type List[String]"),
			)
		None:
			False


tests: TestSuite = {
	description = "Compiler CTFE typecheck profile benchmark",
	tests = [
		(
			"fixture follows function-only dependency chain",
			test_ctfe_typecheck_fixture_exercises_function_only_dependency_chain,
		),
		(
			"repeated fixture remains deterministic",
			test_ctfe_typecheck_fixture_is_deterministic_when_repeated,
		),
		(
			"fixture models reachable and irrelevant bodies",
			test_ctfe_typecheck_fixture_models_reachable_and_irrelevant_bodies,
		),
		(
			"selected module reuses its CTFE checked body",
			test_ctfe_checked_body_is_reused_for_selected_module_output,
		),
		("recursive body is checked once", test_recursive_ctfe_body_is_checked_once),
		("repeated CTFE roots share one body check", test_repeated_ctfe_roots_share_one_body_check),
		(
			"lambda callback checks only its owning function body",
			test_ctfe_lambda_callback_checks_only_owning_function_body,
		),
		(
			"implementation method uses selected callable artifact",
			test_ctfe_impl_method_uses_selected_callable_artifact,
		),
		(
			"target helper discovers imported CTFE body",
			test_target_helper_discovers_imported_ctfe_body,
		),
		(
			"imported constructor requires no source body",
			test_imported_constructor_requires_no_source_body,
		),
		(
			"no callable roots use explicit eager mode",
			test_no_callable_roots_use_explicit_eager_mode,
		),
		(
			"unresolved trait dispatch uses eager mode",
			test_unresolved_trait_dispatch_uses_eager_mode,
		),
		(
			"unresolved target dispatch preserves target check metrics",
			test_unresolved_target_dispatch_preserves_target_check_metrics,
		),
		(
			"CTFE checked main keeps entrypoint validation",
			test_ctfe_checked_main_keeps_entrypoint_validation,
		),
	]
}
