	target_source = "import:\n" + "\tbench/ctfe_typecheck_profile_0 as Dependency\n\n" + "pure func helper() -> Int: Dependency.value()\n\n" + "answer: Int = helper()\n\n" + "func main(args: List[String]) -> Int:\n" + "\tanswer\n"
