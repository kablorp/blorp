import:
	../../src/compiler/output: render_compile_timings, render_core_observations
	../../src/compiler/pipeline:
		CompilerPhase(BackendEmissionPhase, CoreLoweringPhase, TypedFrontendPhase),
	../../src/lib/compilation: CompileObservation
	../../src/lib/compilation_timing: CompileTiming
	test: TestSuite


pure func test_observations_have_one_header_and_stage_boundaries() -> Bool:
	observations: List[CompileObservation] = [
		{
			stage_name = "lower",
			rendered = "lower body\n"
		},
		{
			stage_name = "resolve",
			rendered = "resolved body"
		},
	]
	rendered: String = render_core_observations("src/main.brp", observations)

	(
		rendered.starts_with("-- blorp src/main.brp\n")
		and rendered.contains("===== after lower =====\nlower body\n")
		and rendered.contains("===== after resolve =====\nresolved body\n")
		and rendered.count("-- blorp") == 1
	)


pure func test_compile_timings_include_phases_and_total() -> Bool:
	timings: List[CompileTiming] = [
		{
			phase = TypedFrontendPhase,
			microseconds = 1250
		},
		{
			phase = CoreLoweringPhase,
			microseconds = 750
		},
		{
			phase = BackendEmissionPhase,
			microseconds = 2750
		},
	]
	rendered: String = render_compile_timings(timings, 5000)

	(
		rendered.contains("typed_frontend\t1.25 ms")
		and rendered.contains("core_lowering\t0.75 ms")
		and rendered.contains("backend_emission\t2.75 ms")
		and rendered.contains("phase_total\t4.75")
		and rendered.contains("outer_total\t5")
	)


tests: TestSuite = {
	description = "Blorp compiler CLI effect output",
	tests = [
		(
			"observations have one header and stage boundaries",
			test_observations_have_one_header_and_stage_boundaries,
		),
		(
			"compile timings include phases and total",
			test_compile_timings_include_phases_and_total,
		),
	]
}
