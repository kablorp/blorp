import:
	../../../../src/compiler/stage_12_cli/test_session_counter: TestSessionCounters, render_test_session_totals
	test: TestSuite


pure func sample_counters() -> TestSessionCounters:
	{
		discovered_runnable_files = 7,
		unique_discovered_runnable_source_identities = 6,
		retained_runnable_source_bytes = 4096,
		declared_test_suites = 5,
		planned_aggregate_suite_harnesses = 3,
		planned_combined_suite_files = 5,
		planned_combined_native_executions = 4,
		planned_individual_source_files = 2
	}


pure func test_session_totals_have_stable_versioned_json() -> Bool:
	render_test_session_totals(
		sample_counters(),
	) == "BLORP_TEST_SESSION_COUNTER " + "{\"schema_version\":2,\"event\":\"session_totals\"," + "\"scope\":{\"kind\":\"session\"},\"counters\":{" + "\"discovered_runnable_files\":7," + "\"unique_discovered_runnable_source_identities\":6," + "\"retained_runnable_source_bytes\":4096,\"declared_test_suites\":5," + "\"planned_aggregate_suite_harnesses\":3," + "\"planned_combined_suite_files\":5," + "\"planned_combined_native_executions\":4," + "\"planned_individual_source_files\":2}}"


pure func test_session_totals_are_one_line() -> Bool:
	not render_test_session_totals(sample_counters()).contains("\n")


pure func test_session_totals_preserve_large_integers() -> Bool:
	counters: TestSessionCounters = { sample_counters() |
		retained_runnable_source_bytes = 9007199254740993
	}
	render_test_session_totals(
		counters,
	).contains("\"retained_runnable_source_bytes\":9007199254740993")


tests: TestSuite = {
	description = "Blorp test session counter protocol",
	tests = [
		(
			"session totals have stable versioned JSON",
			test_session_totals_have_stable_versioned_json,
		),
		("session totals are one line", test_session_totals_are_one_line),
		("session totals preserve large integers", test_session_totals_preserve_large_integers),
	]
}
