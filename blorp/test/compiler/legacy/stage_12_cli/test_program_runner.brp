	test: TestSuite
	units: Duration, data_size_bytes, mebibytes, milliseconds, seconds


private pure func build_artifact(code: String, leak_check: Bool) -> BuildArtifact:
	compatibility: BuildCompatibility = {
		debug = False,
		profile = False,
		optimization = BuildFast,
		sanitizer = BuildNoSanitizer,
		leak_check = leak_check
	}
	{
		c_code = code,
		link_arguments = [],
		include_dirs = [],
		runtime_requirement = BuildEmbeddedRuntime,
		native_features = [],
		source = {
			path = "runner-test.brp",
			module_name = "RunnerTest"
		},
		compatibility = compatibility
	}


private pure func host_configuration() -> HostCConfiguration:
	{
		platform = BuildLinux,
		compiler = {
			program = "cc",
			prefix_arguments = [],
			family = HostClang
		},
		tls = {
			backend = HostTlsUnsupported,
			runtime_arguments = [],
			link_arguments = []
		},
		raylib_prefix = None,
		timeout = Some(seconds(10)),
		capture_limit = mebibytes(4)
	}


private func run_request(
	code: String,
	arguments: List[String],
	timeout: Option[Duration],
	threads: Option[Int],
	leak_check: Bool,
) -> ProgramRunRequest:
	sources: RuntimeSources = {
		runtime = "\n",
		declarations = ""
	}
	{
		artifact = build_artifact(code, leak_check),
		host = host_configuration(),
		runtime = HostEmbeddedRuntime(sources),
		temporary_root = temp_dir(),
		user_arguments = arguments,
		timeout = timeout,
		threads = threads,
		mode = InteractiveProgramRun
	}


pure func test_program_command_preserves_argv_and_child_environment() -> Bool:
	request = prepare_program_command(
		"/tmp/program with spaces",
		["", "two words", "quote'\""],
		Some(seconds(3)),
		Some(7),
		True,
		InteractiveProgramRun,
	)

	stdin_inherited: Bool = match request.stdin:
		InheritStdin:
			True
		_:
			False

	stdout_inherited: Bool = match request.stdout:
		InheritStream:
			True
		_:
			False

	stderr_inherited: Bool = match request.stderr:
		InheritStream:
			True
		_:
			False

	environment_is_exact: Bool = match request.environment:
		[threads, leak_check]:
			(
				threads.name == "BLORP_THREADS"
				and threads.value == Some("7")
				and leak_check.name == "BLORP_LEAK_CHECK"
				and leak_check.value == Some("strict")
			)
		_:
			False

	(
		request.program == "/tmp/program with spaces"
		and request.args == ["", "two words", "quote'\""]
		and environment_is_exact
		and stdin_inherited
		and stdout_inherited
		and stderr_inherited
	)


pure func test_captured_program_command_is_isolated_and_bounded() -> Bool:
	request = prepare_program_command(
		"/tmp/program",
		[],
		Some(seconds(3)),
		None,
		False,
		CapturedProgramRun(Some("/tmp/test-cwd"), BoundedCapture(mebibytes(2))),
	)

	stdin_is_closed: Bool = match request.stdin:
		NullStdin:
			True
		_:
			False

	stdout_is_captured: Bool = match request.stdout:
		CaptureStream:
			True
		_:
			False

	stderr_is_captured: Bool = match request.stderr:
		CaptureStream:
			True
		_:
			False

	capture_limit_is_exact: Bool = match request.capture_limit:
		BoundedCapture(limit):
			data_size_bytes(limit) == data_size_bytes(mebibytes(2))
		_:
			False

	(
		request.cwd == Some("/tmp/test-cwd")
		and capture_limit_is_exact
		and stdin_is_closed
		and stdout_is_captured
		and stderr_is_captured
	)


pure func test_captured_program_command_can_be_unbounded() -> Bool:
	request = prepare_program_command(
		"/tmp/program",
		[],
		None,
		None,
		False,
		CapturedProgramRun(None, UnboundedCapture),
	)

	match request.capture_limit:
		UnboundedCapture:
			True
		_:
			False


pure func test_program_exit_status_is_conventional() -> Bool:
	(
		program_exit_status(Exited(17)) == 17
		and program_exit_status(Signaled(15)) == 143
		and program_exit_status(TimedOut) == 124
	)


private func test_program_execution_preserves_args_env_and_cleans_up() -> Bool:
	before_threads: Option[String] = getenv("BLORP_THREADS")
	before_leak_check: Option[String] = getenv("BLORP_LEAK_CHECK")
	code: String =
		|#include <stdlib.h>
		|#include <string.h>
		|int main(int argc, char** argv) {
		|  const char* threads = getenv("BLORP_THREADS");
		|  const char* leak = getenv("BLORP_LEAK_CHECK");
		|  if (argc != 4) return 10;
		|  if (strcmp(argv[1], "") != 0) return 11;
		|  if (strcmp(argv[2], "two words") != 0) return 12;
		|  if (strcmp(argv[3], "quote'\"") != 0) return 13;
		|  if (!threads || strcmp(threads, "3") != 0) return 14;
		|  if (!leak || strcmp(leak, "strict") != 0) return 15;
		|  return 0;
		|}
	request = run_request(
		code,
		["", "two words", "quote'\""],
		Some(seconds(5)),
		Some(3),
		True,
	)

	match run_build_artifact(request):
		Err(_):
			False
		Ok(result):
			(
				result.exit == Exited(0)
				and not file_exists(result.executable_path)
				and getenv("BLORP_THREADS") == before_threads
				and getenv("BLORP_LEAK_CHECK") == before_leak_check
			)


private func exercise_captured_program_in_working_directory() -> Result[Bool, IOError]:
	with working_directory ?= temporary_directory(temp_dir(), "blorp_program_runner_test_"):
		code: String =
			|#include <stdio.h>
			|#include <unistd.h>
			|int main(void) {
			|  char cwd[4096];
			|  if (!getcwd(cwd, sizeof(cwd))) return 10;
			|  printf("%s\n", cwd);
			|  fprintf(stderr, "captured stderr\n");
			|  return 0;
			|}
		request = { run_request(code, [], Some(seconds(5)), None, False) |
			mode = CapturedProgramRun(
				Some(working_directory.resource_path()),
				BoundedCapture(mebibytes(1)),
			)
		}

		match run_build_artifact(request):
			Ok(result):
				Ok((
						result.exit == Exited(0)
						and result.stdout
							.to_string()
							.trim()
							.ends_with(working_directory.resource_path())
						and result.stderr
							.to_string()
							.trim() == "captured stderr"
					))
			Err(_):
				Ok(False)


private func test_program_execution_captures_separate_streams_in_working_directory() -> Bool:
	match exercise_captured_program_in_working_directory():
		Ok(result):
			result
		Err(_):
			False


private func test_program_timeout_is_distinct() -> Bool:
	code: String =
		|#include <signal.h>
		|#include <unistd.h>
		|static void terminate(int signal_number) {
		|  (void)signal_number;
		|  (void)write(1, "terminated\n", 11);
		|  _exit(0);
		|}
		|int main(void) {
		|  signal(SIGTERM, terminate);
		|  for (;;) pause();
		|}
	request = { run_request(code, [], Some(seconds(2)), None, False) |
		mode = CapturedProgramRun(None, BoundedCapture(mebibytes(1)))
	}

	match run_build_artifact(request):
		Ok(result):
			(
				result.exit == TimedOut
				and result.stdout
					.to_string()
					.trim() == "terminated"
				and not file_exists(result.executable_path)
			)
		Err(_):
			False


private func test_current_runtime_supports_captured_program_sessions() -> Bool:
	captured_program_session_is_supported()


tests: TestSuite = {
	description = "Blorp compiler program runner",
	tests = [
		(
			"program command preserves argv and child environment",
			test_program_command_preserves_argv_and_child_environment,
		),
		(
			"captured command is isolated, closed-input, and bounded",
			test_captured_program_command_is_isolated_and_bounded,
		),
		("captured command can be unbounded", test_captured_program_command_can_be_unbounded),
		("program exit status is conventional", test_program_exit_status_is_conventional),
		(
			"program execution preserves args, env, and cleanup",
			test_program_execution_preserves_args_env_and_cleans_up,
		),
		(
			"program execution captures separate streams in working directory",
			test_program_execution_captures_separate_streams_in_working_directory,
		),
		(
			"current runtime supports captured program sessions",
			test_current_runtime_supports_captured_program_sessions,
		),
		("program timeout is distinct", test_program_timeout_is_distinct),
	]
}
