		BuildOptimization(BuildFast),
		BuildPlatform(BuildLinux),
		BuildRuntimeRequirement(BuildEmbeddedRuntime),
		BuildSanitizer(BuildNoSanitizer),
	../../../../src/compiler/stage_12_cli/host_c:
		HostCCompilerFamily(HostClang),
		HostCConfiguration,
		HostRuntimeInput(HostEmbeddedRuntime),
		HostTlsBackend(HostTlsUnsupported),
	../../../../src/compiler/stage_12_cli/program_runner:
		ProgramRunMode(CapturedProgramRun, InteractiveProgramRun),
		ProgramRunRequest,
		prepare_program_command,
		program_exit_status,
		run_build_artifact,
	../../../../src/compiler/stage_12_cli/program_session_runner: captured_program_session_is_supported
	compiler_runtime: RuntimeSources
	fs: IOError, resource_path, temporary_directory
	process:
		ProcessCaptureLimit(BoundedCapture, UnboundedCapture),
		ProcessExit(Exited, Signaled, TimedOut),
