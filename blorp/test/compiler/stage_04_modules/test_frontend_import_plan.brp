import:
	../../../src/compiler/stage_04_modules/frontend_graph_service: FrontendSourceCandidate
	../../../src/compiler/stage_04_modules/frontend_import_plan:
		FrontendImportLookup(
			FrontendLocalPathLookup,
			FrontendNativePackageLookup,
			FrontendRelativePathLookup,
			FrontendSourcePackageAliasLookup,
			FrontendSourcePackageInternalLookup,
			FrontendStandardLibraryLookup,
		),
		frontend_import_lookup_plan,
	../../../src/compiler/stage_04_modules/loaded_module:
		ModuleOrigin(SourcePackageModule, StdlibModule, UserModule),
		module_origins_equal,
		resolved_module_identity_from_resolver,
	../../../src/lib/source: source_file
	test: TestSuite


private pure func candidate(origin: ModuleOrigin) -> FrontendSourceCandidate:
	{
		identity = resolved_module_identity_from_resolver("main", origin),
		source = source_file("/workspace/app/main.brp", "main", "")
	}


pure func test_user_import_precedence_is_package_then_std_then_local() -> Bool:
	match frontend_import_lookup_plan(candidate(UserModule), "dep"):
		[FrontendSourcePackageAliasLookup("dep"), FrontendStandardLibraryLookup("dep"), FrontendLocalPathLookup("/workspace/app/dep.brp")]:
			True
		_:
			False


pure func test_source_package_import_falls_back_to_standard_library() -> Bool:
	match frontend_import_lookup_plan(candidate(SourcePackageModule("math")), "math_core/vector"):
		[FrontendSourcePackageInternalLookup("math", "math_core/vector"), FrontendStandardLibraryLookup("math_core/vector")]:
			True
		_:
			False


pure func test_standard_library_import_stays_inside_standard_library() -> Bool:
	match frontend_import_lookup_plan(candidate(StdlibModule), "option"):
		[FrontendStandardLibraryLookup("option")]:
			True
		_:
			False


pure func test_std_path_has_no_special_namespace_behavior() -> Bool:
	match frontend_import_lookup_plan(candidate(UserModule), "std/option"):
		[FrontendSourcePackageAliasLookup("std/option"), FrontendStandardLibraryLookup("std/option"), FrontendLocalPathLookup("/workspace/app/std/option.brp")]:
			True
		_:
			False


pure func test_relative_import_retains_confinement_origin() -> Bool:
	match frontend_import_lookup_plan(candidate(SourcePackageModule("math")), "../shared"):
		[FrontendRelativePathLookup("/workspace/shared.brp", origin)]:
			module_origins_equal(origin, SourcePackageModule("math"))
		_:
			False


pure func test_explicit_native_import_is_forbidden_from_std_and_source_packages() -> Bool:
	(
		frontend_import_lookup_plan(candidate(StdlibModule), "pkg/sqlite").is_empty()
		and frontend_import_lookup_plan(
			candidate(SourcePackageModule("math")),
			"pkg/sqlite",
		).is_empty()
		and match frontend_import_lookup_plan(candidate(UserModule), "pkg/sqlite"):
			[FrontendNativePackageLookup("pkg/sqlite")]:
				True
			_:
				False
	)


tests: TestSuite = {
	description = "Compiler frontend import lookup plan",
	tests = [
		(
			"user import precedence is package then std then local",
			test_user_import_precedence_is_package_then_std_then_local,
		),
		(
			"source package import falls back to standard library",
			test_source_package_import_falls_back_to_standard_library,
		),
		(
			"standard-library import stays inside standard library",
			test_standard_library_import_stays_inside_standard_library,
		),
		(
			"std path has no special namespace behavior",
			test_std_path_has_no_special_namespace_behavior,
		),
		(
			"relative import retains confinement origin",
			test_relative_import_retains_confinement_origin,
		),
		(
			"explicit native import is forbidden from std and source packages",
			test_explicit_native_import_is_forbidden_from_std_and_source_packages,
		),
	]
}
