import:
	../../../src/compiler/stage_01_file_io/source: source_file
	../../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../../src/compiler/stage_03_parse/source_ast_finalize: finalized_typecheck_program
	../../../src/compiler/stage_04_modules/frontend_graph:
		FrontendGraphError(
			DuplicateCompilerFrontendModule,
			MissingCompilerFrontendEdgeImporter,
			MissingCompilerFrontendEdgeTarget,
			MissingCompilerFrontendRoot,
		),
		FrontendImportEdge,
		FrontendImportResolution(FrontendResolvedImport, FrontendUnresolvedImport),
		FrontendModule,
		frontend_graph,
		frontend_graph_direct_dependents,
		frontend_graph_import_edges,
	../../../src/compiler/stage_04_modules/loaded_module:
		ModuleOrigin(SourcePackageModule, UserModule),
		ResolvedModuleIdentity,
		resolved_module_identities_equal,
		resolved_module_identity_from_resolver,
	test: TestSuite


private pure func identity(canonical_path: String, origin: ModuleOrigin) -> ResolvedModuleIdentity:
	resolved_module_identity_from_resolver(canonical_path, origin)


private pure func module(
	canonical_path: String,
	module_name: String,
	origin: ModuleOrigin,
) -> FrontendModule:
	source = source_file("/workspace/" + module_name + ".brp", module_name, "VALUE = 1\n")
	{
		identity = identity(canonical_path, origin),
		program = finalized_typecheck_program(parse_compiler_source(source))
	}


pure func test_graph_retains_exact_requested_import_and_identity() -> Bool:
	app = module("app/main", "main", UserModule)
	dependency = module("packages/math/stats", "stats", SourcePackageModule("math"))
	edge: FrontendImportEdge = {
		importer = app.identity,
		requested_path = "math/stats",
		resolution = FrontendResolvedImport(dependency.identity)
	}

	match (
		frontend_graph(
			[app, dependency],
			[app.identity],
			[edge],
		)
	):
		Err(_):
			False
		Ok(graph):
			match frontend_graph_import_edges(graph):
				[found]:
					match found.resolution:
						FrontendResolvedImport(target):
							(
								found.requested_path == "math/stats"
								and resolved_module_identities_equal(found.importer, app.identity)
								and resolved_module_identities_equal(target, dependency.identity)
							)
						_:
							False
				_:
					False


pure func test_graph_retains_explicit_unresolved_outcome() -> Bool:
	app = module("app/main", "main", UserModule)
	edge: FrontendImportEdge = {
		importer = app.identity,
		requested_path = "missing/module",
		resolution = FrontendUnresolvedImport
	}

	match frontend_graph([app], [app.identity], [edge]):
		Err(_):
			False
		Ok(graph):
			match frontend_graph_import_edges(graph):
				[found]:
					(
						found.requested_path == "missing/module"
						and found.resolution == FrontendUnresolvedImport
					)
				_:
					False


pure func test_graph_rejects_duplicate_canonical_module() -> Bool:
	first = module("shared", "first", UserModule)
	second = module("shared", "second", SourcePackageModule("pkg"))

	match (
		frontend_graph(
			[first, second],
			[first.identity],
			[],
		)
	):
		Err([DuplicateCompilerFrontendModule(first_identity, second_identity)]):
			(
				resolved_module_identities_equal(first_identity, first.identity)
				and resolved_module_identities_equal(second_identity, second.identity)
			)
		_:
			False


pure func test_graph_keeps_duplicate_path_separate_from_full_identity_membership() -> Bool:
	first = module("shared", "first", UserModule)
	second = module("shared", "second", SourcePackageModule("pkg"))

	duplicate_rejected: Bool = match (
		frontend_graph(
			[first, second],
			[first.identity],
			[],
		)
	):
		Err([DuplicateCompilerFrontendModule(first_identity, second_identity)]):
			(
				resolved_module_identities_equal(first_identity, first.identity)
				and resolved_module_identities_equal(second_identity, second.identity)
			)
		_:
			False

	missing_origin_root: Bool = match frontend_graph([first], [second.identity], []):
		Err([MissingCompilerFrontendRoot(found)]):
			resolved_module_identities_equal(found, second.identity)
		_:
			False

	duplicate_rejected and missing_origin_root


pure func test_graph_rejects_missing_edge_endpoints() -> Bool:
	app = module("app/main", "main", UserModule)
	missing = identity("missing", UserModule)
	missing_importer: FrontendImportEdge = {
		importer = missing,
		requested_path = "dep",
		resolution = FrontendUnresolvedImport
	}
	missing_target: FrontendImportEdge = {
		importer = app.identity,
		requested_path = "dep",
		resolution = FrontendResolvedImport(missing)
	}

	importer_error: Bool = match frontend_graph([app], [app.identity], [missing_importer]):
		Err([MissingCompilerFrontendEdgeImporter(found)]):
			resolved_module_identities_equal(found, missing)
		_:
			False

	target_error: Bool = match frontend_graph([app], [app.identity], [missing_target]):
		Err([MissingCompilerFrontendEdgeTarget(found)]):
			resolved_module_identities_equal(found, missing)
		_:
			False

	importer_error and target_error


pure func test_graph_derives_reverse_dependency_lookup() -> Bool:
	app = module("app/main", "main", UserModule)
	middle = module("app/middle", "middle", UserModule)
	leaf = module("app/leaf", "leaf", UserModule)
	edges = [
		{
			importer = app.identity,
			requested_path = "middle",
			resolution = FrontendResolvedImport(middle.identity)
		},
		{
			importer = middle.identity,
			requested_path = "leaf",
			resolution = FrontendResolvedImport(leaf.identity)
		},
	]

	match (
		frontend_graph(
			[app, middle, leaf],
			[app.identity],
			edges,
		)
	):
		Err(_):
			False
		Ok(graph):
			dependents = frontend_graph_direct_dependents(graph, leaf.identity)

			match dependents:
				[found]:
					resolved_module_identities_equal(found, middle.identity)
				_:
					False


pure func test_graph_direct_dependents_deduplicate_without_reordering() -> Bool:
	app = module("app/main", "main", UserModule)
	middle = module("app/middle", "middle", UserModule)
	leaf = module("app/leaf", "leaf", UserModule)
	edges = [
		{
			importer = app.identity,
			requested_path = "leaf",
			resolution = FrontendResolvedImport(leaf.identity)
		},
		{
			importer = app.identity,
			requested_path = "leaf_again",
			resolution = FrontendResolvedImport(leaf.identity)
		},
		{
			importer = middle.identity,
			requested_path = "leaf",
			resolution = FrontendResolvedImport(leaf.identity)
		},
	]

	match (
		frontend_graph(
			[app, middle, leaf],
			[app.identity],
			edges,
		)
	):
		Err(_):
			False
		Ok(graph):
			match frontend_graph_direct_dependents(graph, leaf.identity):
				[first, second]:
					(
						resolved_module_identities_equal(first, app.identity)
						and resolved_module_identities_equal(second, middle.identity)
					)
				_:
					False


tests: TestSuite = {
	description = "Compiler frontend graph model",
	tests = [
		(
			"retain exact requested import and identity",
			test_graph_retains_exact_requested_import_and_identity,
		),
		("retain explicit unresolved outcome", test_graph_retains_explicit_unresolved_outcome),
		("reject duplicate canonical module", test_graph_rejects_duplicate_canonical_module),
		(
			"keep duplicate path separate from full identity membership",
			test_graph_keeps_duplicate_path_separate_from_full_identity_membership,
		),
		("reject missing import edge endpoints", test_graph_rejects_missing_edge_endpoints),
		("derive reverse dependency lookup", test_graph_derives_reverse_dependency_lookup),
		(
			"direct dependents deduplicate without reordering",
			test_graph_direct_dependents_deduplicate_without_reordering,
		),
	]
}
