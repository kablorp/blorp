private func projected_expression(text: String) -> Option[(NameTable, ParsedExpr)]:
	lexed = lex_module(module_id_at_row(0), text)
	match new_parse_state(lexed):
		Err(_): None
		Ok(entry):
			(at_value, result) = parse_declaration_preview(entry)
			match result:
				DeferredGlobalInitializer(preview):
					(_, completion) = complete_expression_global(at_value, preview)
					match completion:
						CompletedExpressionGlobal(declaration):
							match legacy_expression_preview(preview_source(lexed), EMPTY_NAME_TABLE, declaration.value):
								Ok(projected): Some(projected)
								Err(_): None
						_: None
				_: None


-- Mint this independently of the bounded parser, so its missing postfix
-- support cannot mask the adapter's current unsupported-expression failure.
func test_minted_empty_call_projects_raw_ast() -> Bool:
	lexed = lex_module(module_id_at_row(0), "void()")
	(mint, callee) = new_id_mint(module_id_at_row(0)).minted_expression(
		pack_span(source_id_at_row(0), 0, 4), VoidValue
	)
	(_, value) = mint.minted_expression(pack_span(source_id_at_row(0), 0, 6), Call(callee, []))
	match legacy_expression_preview(preview_source(lexed), EMPTY_NAME_TABLE, value):
		Ok((names, ParsedCallExpr(ParsedVoidExpr(_), arguments, _))):
			name_table_spellings(names).is_empty() and arguments.is_empty()
		_: False


func test_supported_expressions_match_old_ast_json() -> Bool:
	var correct: Bool = True
	for expression in [
		"left + right * 007 - third / 2 % 3", "-left + not right",
		"left == right or left != other and left < last",
		"left <= right and left > other or left >= last", "left..right",
		"((007)) + (007.500)", "(left) + ((right))", "True", "False", "(True)", "void", "((void))", "_", "()",
		"(left + right) * third", "not (left or right)", "-(-007)",
		"f()", "f(a,)", "f(a, b)", "target.member", "target[index]", "target[first, second,]",
		"f(a).b[c](d)", "(f)(x)", "((f(x))).member", "((target)).member",
		"-f(x).member", "(-f(x)).member", "not f(x).member",
		"root.member(nested(007, other.field), (third + fourth))[index * 2, last,]().tail",
		"f((007), ((007.500)))[007].member + other[index] * last()",
		"(left + right)(argument)", "((target[first]))[second]",
		"[]", "[a]", "[a, b,]", "[007, (007.500), [c, [d]], []]", "[f(x), y.z, w[0]]", "[a + b, not c, -d]",
		"[a, b].member", "[a][0]", "([a])", "(([007]))", "f([a], [b,])", "-[1]", "[a] + [b] * [c]", "[(a)] .. [(b)]",
	]:
		correct = declaration_projection_matches("value = ${expression}") and correct
	correct


func test_completed_global_matches_full_old_declaration() -> Bool:
	declaration_projection_matches("private var total: Int = (007 + left) * right")


private func declaration_projection_matches(text: String) -> Bool:
	source = source_file("/tmp/tree_expression_projection.brp", "tree_expression_projection", text)
	old = parse_compiler_source(source)
	lexed = lex_module(module_id_at_row(0), text)
	match new_parse_state(lexed):
		Err(_): False
		Ok(entry):
			(at_value, result) = parse_declaration_preview(entry)
			match result:
				DeferredGlobalInitializer(preview):
					(_, completion) = complete_expression_global(at_value, preview)
					match completion:
						CompletedExpressionGlobal(declaration):
							scan: ModuleDeclarationPreviewScan = {
								documentation = None, declarations = [GlobalDeclarationPreview(declaration)], stop = ReachedEndOfSource
							}
							match legacy_declaration_projection(preview_source(lexed), scan, EMPTY_NAME_TABLE):
								Err(_): False
								Ok(projected):
									match (old.decls.get(0), projected.declarations.get(0)):
										(Some(expected), Some(actual)):
											expected_json = parsed_decl_to_json(ast_json_render(source, SpellingsFromIdentifierText), expected).to_string()
											actual_json = parsed_decl_to_json(ast_json_render(source, SpellingsFromNameTable(projected.names)), actual).to_string()
											if expected_json != actual_json:
												print("declaration expected: ${expected_json}\nactual: ${actual_json}")
											old.diagnostics.is_empty() and expected_json == actual_json
										_: False
						_: False
				_: False


func test_grouped_integer_keeps_exact_digits() -> Bool:
	match projected_expression("value = ((007))"):
		Some((_, ParsedIntLiteralExpr(digits, _))): digits == "007"
		_: False


func test_missing_integer_token_fails_closed() -> Bool:
	lexed = lex_module(module_id_at_row(0), "value = ((007))")
	match new_parse_state(lexed):
		Err(_): False
		Ok(entry):
			(at_value, result) = parse_declaration_preview(entry)
			match result:
				DeferredGlobalInitializer(preview):
					(_, completion) = complete_expression_global(at_value, preview)
					match completion:
						CompletedExpressionGlobal(declaration):
							original = preview_source(lexed)
							broken = { original | tokens = [] }
							match legacy_expression_preview(broken, EMPTY_NAME_TABLE, declaration.value):
								Err(MissingIntegerLiteralToken(_)): True
								_: False
						_: False
				_: False


func test_names_follow_written_order_and_reuse_spelling() -> Bool:
	match projected_expression("value = first + (second * third) + first + fourth"):
		Some((names, _)): name_table_spellings(names) == ["first", "second", "third", "fourth"]
		None: False


func test_postfix_names_follow_written_order() -> Bool:
	match projected_expression("value = root.first(second.third(fourth))[fifth, sixth].seventh(eighth)"):
		Some((names, _)):
			name_table_spellings(names) == ["root", "first", "second", "third", "fourth", "fifth", "sixth", "seventh", "eighth"]
		None: False


func test_postfix_integer_provenance_fails_closed() -> Bool:
	var correct: Bool = True
	for text in ["value = f((007)).member", "value = target[((007))]"]:
		lexed = lex_module(module_id_at_row(0), text)
		match new_parse_state(lexed):
			Err(_): correct = False
			Ok(entry):
				(at_value, result) = parse_declaration_preview(entry)
				match result:
					DeferredGlobalInitializer(preview):
						(_, completion) = complete_expression_global(at_value, preview)
						match completion:
							CompletedExpressionGlobal(declaration):
								original = preview_source(lexed)
								broken = { original | tokens = [] }
								match legacy_expression_preview(broken, EMPTY_NAME_TABLE, declaration.value):
									Err(MissingIntegerLiteralToken(_)): void
									_: correct = False
							_: correct = False
					_: correct = False
	correct


-- Assemble only a test fixture from the preview's actual issued indexes.
-- This does not publish a production accepted module or imply body support.
func test_parsed_method_chain_dump_and_census() -> Bool:
	var text: String = "value = root"
	var steps: Int = 0
	while steps < 2000:
		text += ".member()"
		steps += 1
	module = module_id_at_row(0)
	lexed = lex_module(module, text)
	match new_parse_state(lexed):
		Err(_): False
		Ok(entry):
			(at_value, result) = parse_declaration_preview(entry)
			match result:
				DeferredGlobalInitializer(preview):
					(completed, completion) = complete_expression_global(at_value, preview)
					match completion:
						CompletedExpressionGlobal(declaration):
							issued = issued_ids(completed)
							syntax: ModuleSyntax = {
								documentation = None, items = [GlobalItem(declaration)],
								definitions = issued.definitions, imports = issued.imports, counts = issued.counts
							}
							dumped = dumped_module(syntax, spellings(completed))
							(id_census(module, syntax).is_empty()
								and issued.counts.expressions == 1 + steps * 2
								and issued.counts.name_uses == 1 + steps
								and issued.definitions.length() == 1
								and dumped.split("(call expr").length() == steps + 1
								and dumped.split("(field expr").length() == steps + 1)
						_: False
				_: False


func test_list_names_follow_written_order() -> Bool:
	match projected_expression("value = [first, [second, third.fourth], fifth(sixth), seventh]"):
		Some((names, _)):
			name_table_spellings(names) == ["first", "second", "third", "fourth", "fifth", "sixth", "seventh"]
		None: False


-- Dump and census walk the parsed tree, so this also proves nested lists
-- survive both. Each list contributes its own expression after its element.
func test_parsed_nested_lists_survive_dump_census_and_projection() -> Bool:
	depth = 1000
	var text: String = "value = "
	var level: Int = 0
	while level < depth:
		text += "["
		level += 1
	text += "leaf"
	while level > 0:
		text += "]"
		level -= 1
	module = module_id_at_row(0)
	lexed = lex_module(module, text)
	match new_parse_state(lexed):
		Err(_): False
		Ok(entry):
			(at_value, result) = parse_declaration_preview(entry)
			match result:
				DeferredGlobalInitializer(preview):
					(completed, completion) = complete_expression_global(at_value, preview)
					match completion:
						CompletedExpressionGlobal(declaration):
							issued = issued_ids(completed)
							syntax: ModuleSyntax = {
								documentation = None, items = [GlobalItem(declaration)],
								definitions = issued.definitions, imports = issued.imports, counts = issued.counts
							}
							dumped = dumped_module(syntax, spellings(completed))
							var projected_depth: Int = 0
							match legacy_expression_preview(preview_source(lexed), EMPTY_NAME_TABLE, declaration.value):
								Ok((names, projected)):
									var current: ParsedExpr = projected
									var walking: Bool = name_table_spellings(names) == ["leaf"]
									while walking:
										match current:
											ParsedListExpr([element], _):
												current = element
												projected_depth += 1
											_: walking = False
								Err(_): void
							(id_census(module, syntax).is_empty()
								and issued.counts.expressions == depth + 1
								and issued.counts.name_uses == 1
								and issued.definitions.length() == 1
								and dumped.split("(list expr").length() == depth + 1
								and projected_depth == depth)
						_: False
				_: False


-- The dump walks directly nested lists with an explicit stack; its text must
-- stay exactly the nested parenthesized form, in id order child-first.
func test_nested_list_dump_text() -> Bool:
	lexed = lex_module(module_id_at_row(0), "value = [first, [second, []], [], 007]")
	match new_parse_state(lexed):
		Err(_): False
		Ok(entry):
			(at_value, result) = parse_declaration_preview(entry)
			match result:
				DeferredGlobalInitializer(preview):
					(completed, completion) = complete_expression_global(at_value, preview)
					match completion:
						CompletedExpressionGlobal(declaration):
							issued = issued_ids(completed)
							syntax: ModuleSyntax = {
								documentation = None, items = [GlobalItem(declaration)],
								definitions = issued.definitions, imports = issued.imports, counts = issued.counts
							}
							dumped_module(syntax, spellings(completed)) == "(module\n  (global def0 public @0..38 constant \"value\"@0..5 - (list expr6 @8..38 (name expr0 @9..14 use0:\"first\"@9..14) (list expr3 @16..28 (name expr1 @17..23 use1:\"second\"@17..23) (list expr2 @25..27)) (list expr4 @30..32) (integer expr5 @34..37 7))))"
						_: False
				_: False


func test_wide_list_projects_every_element_in_order() -> Bool:
	var text: String = "value = ["
	var count: Int = 0
	while count < 3000:
		text += "item${count}, "
		count += 1
	text += "last]"
	match projected_expression(text):
		Some((names, ParsedListExpr(items, _))):
			items.length() == count + 1 and name_table_spellings(names).length() == count + 1
		_: False


func test_deep_postfix_spine_projects_iteratively() -> Bool:
	var text: String = "value = root"
	var steps: Int = 0
	while steps < 5000:
		text += ".member()[index]"
		steps += 1
	match projected_expression(text):
		None: False
		Some((names, value)):
			var current: ParsedExpr = value
			var count: Int = 0
			var walking: Bool = True
			var correct: Bool = name_table_spellings(names) == ["root", "member", "index"]
			while walking:
				match current:
					ParsedSubscriptExpr(ParsedCallExpr(ParsedFieldAccessExpr(receiver, _, _), arguments, _), indices, _):
						correct = correct and arguments.is_empty() and indices.length() == 1
						current = receiver
						count += 1
					ParsedNameExpr(_): walking = False
					_:
						correct = False
						walking = False
			correct and count == steps


func test_deep_binary_left_spine_projects_iteratively() -> Bool:
	var text: String = "value = item"
	var terms: Int = 1
	while terms < 5000:
		text += " + item"
		terms += 1
	match projected_expression(text):
		None: False
		Some((names, value)):
			var current: ParsedExpr = value
			var count: Int = 1
			var walking: Bool = True
			var correct: Bool = name_table_spellings(names) == ["item"]
			while walking:
				match current:
					ParsedBinaryExpr(ParsedAddOp, left, ParsedNameExpr(_), _):
						current = left
						count += 1
					ParsedNameExpr(_): walking = False
					_:
						correct = False
						walking = False
			correct and count == terms


tests: TestSuite = {
	description = "Tree expression legacy projection",
	tests = [
		("minted empty call retains raw AST", test_minted_empty_call_projects_raw_ast),
		("supported expression AST JSON parity", test_supported_expressions_match_old_ast_json),
		("completed global full declaration parity", test_completed_global_matches_full_old_declaration),
		("grouped integer preserves authored digits", test_grouped_integer_keeps_exact_digits),
		("missing integer token fails closed", test_missing_integer_token_fails_closed),
		("names follow written order", test_names_follow_written_order_and_reuse_spelling),
		("postfix names follow written order", test_postfix_names_follow_written_order),
		("postfix integer provenance fails closed", test_postfix_integer_provenance_fails_closed),
		("parsed method chain survives dump and ID census", test_parsed_method_chain_dump_and_census),
		("list names follow written order", test_list_names_follow_written_order),
		("1000 nested lists survive dump, census and projection", test_parsed_nested_lists_survive_dump_census_and_projection),
		("nested list dump text", test_nested_list_dump_text),
		("3000 element list projects in order", test_wide_list_projects_every_element_in_order),
		("deep postfix projection uses an iterative walk", test_deep_postfix_spine_projects_iteratively),
		("deep binary projection uses an iterative walk", test_deep_binary_left_spine_projects_iteratively)
	]
}
