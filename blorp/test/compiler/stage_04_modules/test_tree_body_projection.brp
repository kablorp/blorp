-- Completed function bodies: the tree scan's statements and blocks, projected
-- for the frozen parser, equal its own parse; and the walks that follow a
-- source's length are loops.
import:
	../../../src/compiler/discovery_adapter: legacy_declaration_projection, legacy_expression_preview, LegacyDeclarationPreviewError(UnsupportedBodyStatement, MissingIntegerLiteralToken, UnsupportedGlobalInitializerExpression)
	../../../src/compiler_new/stage_01_discovery/tables/span: span_start, span_end
	../../../src/compiler/stage_02_lex/name_table: EMPTY_NAME_TABLE, IdentifierSpellings(SpellingsFromIdentifierText, SpellingsFromNameTable)
	../../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../../src/compiler/stage_03_parse/parsed_ast:
		ParsedDecl(FunctionParsedDecl, VarParsedDecl), ParsedExpr(ParsedBlockExpr, ParsedIfExpr, ParsedNameExpr, ParsedStringLiteralExpr, ParsedStringInterpolationPartsExpr), ParsedElseBranch,
		ParsedStringInterpolationPart(ParsedInterpolationLiteral, ParsedInterpolationExpr), ParsedStringLiteralForm(ParsedPipeStringLiteral)
	../tools/discovery_adapter_comparison: with_holes_parsed
	../../../src/compiler/stage_03_parse/parsed_ast_json: ast_json_render, parsed_decl_to_json
	../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../src/compiler_new/stage_01_discovery/parse/parse_state: new_parse_state, issued_ids, spellings, advanced
	../../../src/compiler_new/stage_01_discovery/parse/tree_expression_parser: parse_expression_recipe, mint_recipe, RecipeParse(ParsedRecipe)
	../../../src/compiler_new/stage_01_discovery/parse/preview_source: preview_source
	../../../src/compiler_new/stage_01_discovery/parse/tree_declaration_preview_parser:
		DeclarationPreview(CompletedFunctionPreview), DeclarationPreviewParse(DeferredGlobalInitializer), parse_declaration_preview
	../../../src/compiler_new/stage_01_discovery/parse/tree_module_declaration_scan:
		scan_module_declaration_prefix_with_bodies, ModuleDeclarationScanStop(ReachedEndOfSource)
	../../../src/compiler_new/stage_01_discovery/syntax/dump: dumped_module
	../../../src/compiler_new/stage_01_discovery/syntax/id_census: id_census
	../../../src/compiler_new/stage_01_discovery/syntax/module_syntax: ModuleSyntax, ModuleItem(FunctionItem)
	../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_at_row
	../../../src/lib/source: source_file
	test: TestSuite


-- An interpolation hole, spelled without opening one in this file's own string.
private pure func hole(text: String) -> String:
	"$" + "{" + text + "}"


private pure func source_lines(lines: List[String]) -> String:
	lines.join("\n") + "\n"


-- Whether the tree scan completes every declaration of `text`, and its
-- projection equals the frozen parser's declaration for declaration.
private func bodies_match_old_parser(text: String) -> Bool:
	source = source_file("/tmp/tree_body_projection.brp", "tree_body_projection", text)
	old = with_holes_parsed(parse_compiler_source(source))
	lexed = lex_module(module_id_at_row(0), text)
	match new_parse_state(lexed):
		Err(_): False
		Ok(entry):
			(_, scan) = scan_module_declaration_prefix_with_bodies(entry)
			reached_end: Bool = match scan.stop:
				ReachedEndOfSource: True
				_: False
			if not old.diagnostics.is_empty() or not reached_end:
				print("scan stopped or the old parser rejected: ${text}")
				False
			else:
				match legacy_declaration_projection(preview_source(lexed), scan, EMPTY_NAME_TABLE):
					Err(UnsupportedBodyStatement(span)):
						print("unsupported statement at ${span.span_start()}..${span.span_end()}: ${text}")
						False
					Err(MissingIntegerLiteralToken(span)):
						print("integer token missing ${span.span_start()}")
						False
					Err(UnsupportedGlobalInitializerExpression(span)):
						print("unsupported expression ${span.span_start()}..${span.span_end()}")
						False
					Err(_):
						print("projection error: ${text}")
						False
					Ok(projected):
						var correct: Bool = projected.declarations.length() == old.decls.length()
						var index: Int = 0
						while correct and index < old.decls.length():
							match (old.decls.get(index), projected.declarations.get(index)):
								(Some(expected), Some(actual)):
									expected_json = parsed_decl_to_json(ast_json_render(source, SpellingsFromIdentifierText), expected).to_string()
									actual_json = parsed_decl_to_json(ast_json_render(source, SpellingsFromNameTable(projected.names)), actual).to_string()
									if expected_json != actual_json:
										print("declaration ${index} expected: ${expected_json}\nactual: ${actual_json}")
										correct = False
								_: correct = False
							index += 1
						correct


func test_expression_body_matches_old_parser() -> Bool:
	first: Bool = bodies_match_old_parser("func inc(x: Int) -> Int: x + 1\n")
	bodies_match_old_parser("pure func zero() -> Int: 0\n") and first


func test_block_statements_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func g(xs: List[Int]) -> Int:",
		"\tvar total: Int = 0",
		"\tcount: Int = 3",
		"\tlater = total + count",
		"\t_ = later",
		"\ttotal += 1",
		"\ttotal -= 2",
		"\ttotal *= 3",
		"\ttotal /= 4",
		"\txs[0] = total",
		"\txs[0, 1] = (total)",
		"\t-total",
		"\ttotal"
	]))


func test_declaration_metadata_matches_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"private pure func hidden(x: Int) -> Int:",
		"\tx",
		"",
		"--- Documented.",
		"@tail_recursive",
		"func documented[T](x: T) -> T:",
		"\tx"
	]))


func test_control_flow_matches_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func g(xs: List[Int]) -> Int:",
		"\tvar total: Int = 0",
		"\tfor x in xs:",
		"\t\tif x < 0:",
		"\t\t\tcontinue",
		"\t\telse if x == 7:",
		"\t\t\tbreak",
		"\t\telse:",
		"\t\t\ttotal += x",
		"\twhile total > 100:",
		"\t\ttotal -= 1",
		"\t\tif total == 50:",
		"\t\t\tbreak",
		"\tfor _ in xs:",
		"\t\ttotal += 1",
		"\ttotal"
	]))


func test_match_statements_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func g(value: Int) -> Int:",
		"\tmatch value:",
		"\t\t0: value",
		"\t\t-1: value + 1",
		"\t\t2.5: value",
		"\t\tTrue: 0",
		"\t\t\"text\": 1",
		"\t\t'c': 2",
		"\t\tSome(inner): inner",
		"\t\tmodule.Circle(radius, _): radius",
		"\t\t(left, right): left",
		"\t\t[first, second, ...rest]: first",
		"\t\t[..._]: 0",
		"\t\t7 | 8 | 9: 3",
		"\t\t_:",
		"\t\t\tvar local = value",
		"\t\t\tlocal",
		"\tvalue"
	]))


func test_nested_blocks_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func g(value: Int) -> Int:",
		"\tif value > 0:",
		"\t\tif value > 1:",
		"\t\t\tif value > 2:",
		"\t\t\t\tvalue",
		"\t\t\telse:",
		"\t\t\t\t0",
		"\t\telse if value > 3:",
		"\t\t\t1",
		"\telse:",
		"\t\tmatch value:",
		"\t\t\t0:",
		"\t\t\t\tfor item in value:",
		"\t\t\t\t\tif item:",
		"\t\t\t\t\t\tbreak",
		"\t\t\t_: 2",
		"\tvalue"
	]))


func test_several_declarations_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"first = 1",
		"",
		"func one() -> Int: first",
		"",
		"func two(x: Int) -> Int:",
		"\tx",
		"",
		"func three():",
		"\tvoid"
	]))


func test_string_and_character_literals_match_old_parser() -> Bool:
	first: Bool = bodies_match_old_parser(source_lines([
		"func f(name: String) -> String:",
		"\tplain = \"plain\"",
		"\tempty = \"\"",
		"\tescaped = \"tab\\t quote\\\" newline\\n\"",
		"\tpath = raw\"C:\\Users\\x\"",
		"\tletter = 'c'",
		"\tnewline = '\\n'",
		"\tgrouped = (\"grouped\")",
		"\tjoined = name + \"suffix\"",
		"\tlength(\"call\", ('d'), [\"list\"])",
		"\tname"
	]))
	bodies_match_old_parser("label = \"a global\"\nmark = 'g'\n") and first


func test_interpolated_strings_match_old_parser() -> Bool:
	quote: String = "\""
	first: Bool = bodies_match_old_parser(source_lines([
		"func f(name: String, count: Int) -> String:",
		"\ta = " + quote + "hello " + hole("name") + quote,
		"\tb = " + quote + hole("name") + quote,
		"\tc = " + quote + hole("count + 1") + " items, " + hole("name.length()") + " chars" + quote,
		"\td = " + quote + "nested " + hole("show(" + quote + "inner " + hole("name") + quote + ", 'x')") + " done" + quote,
		"\te = " + quote + "spaced " + hole(" name ") + " and " + hole("count") + hole("count") + quote,
		"\tshow(" + quote + "in a call " + hole("name") + quote + ")",
		"\tmatch name:",
		"\t\t" + quote + "literal" + quote + ": " + quote + "case " + hole("count") + quote,
		"\t\t_: " + quote + quote,
		"\tfor item in [" + quote + hole("name") + quote + "]:",
		"\t\tname += " + quote + hole("item") + quote,
		"\tname"
	]))
	bodies_match_old_parser("greeting = " + quote + "hi " + hole("name") + " and " + hole("other.field") + quote + "\n") and first


func test_character_escapes_and_raw_pipe_strings_match_old_parser() -> Bool:
	bodies_match_old_parser(source_lines([
		"func f() -> String:",
		"\tnewline = '\\n'",
		"\ttab = '\\t'",
		"\tbackslash = '\\\\'",
		"\tquote = '\\''",
		"\tletter = '\\u{41}'",
		"\temoji = '\\u{1F600}'",
		"\tpath = raw",
		"\t\t|C:\\Users",
		"\t\t|" + hole("not_a_hole"),
		"\tpath"
	]))


-- A pipe string or pipe interpolation can only be an indented value, which the
-- statement grammar of this slice leaves to a later one, so the tree's
-- expression is parsed where its token begins and its projection is compared
-- with the old parser's text, form and parts.
func test_pipe_strings_project_like_the_old_parser() -> Bool:
	plain_text = source_lines(["x =", "\t|one", "\t|two"])
	interpolated_text = source_lines(["x =", "\t|a " + hole("b"), "\t|c"])
	match (pipe_expression(plain_text), pipe_expression(interpolated_text)):
		(Some((ParsedStringLiteralExpr(old_text, old_form, _), ParsedStringLiteralExpr(new_text, new_form, _))), Some((ParsedStringInterpolationPartsExpr(old_parts, True, _), ParsedStringInterpolationPartsExpr(new_parts, True, _)))):
			literal_forms: Bool = old_text == new_text and old_text == "one\ntwo" and old_form == new_form and new_form == ParsedPipeStringLiteral
			literal_forms and pipe_parts_match(old_parts, new_parts)
		_: False


private func pipe_parts_match(old_parts: List[ParsedStringInterpolationPart], new_parts: List[ParsedStringInterpolationPart]) -> Bool:
	match (old_parts, new_parts):
		([ParsedInterpolationLiteral(old_first), ParsedInterpolationExpr(ParsedNameExpr(old_name), _), ParsedInterpolationLiteral(old_last)], [ParsedInterpolationLiteral(new_first), ParsedInterpolationExpr(ParsedNameExpr(new_name), _), ParsedInterpolationLiteral(new_last)]):
			old_first == new_first and old_last == new_last and old_first == "a " and old_last == "\nc" and old_name.text == new_name.text
		_: False


-- The old parser's value of the global `x`, and the tree path's, for a value
-- that begins on the line after the `=`: the tree parser starts at that token.
private func pipe_expression(text: String) -> Option[(ParsedExpr, ParsedExpr)]:
	source = source_file("/tmp/tree_body_projection.brp", "tree_body_projection", text)
	old = with_holes_parsed(parse_compiler_source(source))
	lexed = lex_module(module_id_at_row(0), text)
	match (old.decls.get(0), new_parse_state(lexed)):
		(Some(VarParsedDecl(global)), Ok(entry)):
			(at_value, result) = parse_declaration_preview(entry)
			match result:
				DeferredGlobalInitializer(_):
					-- Past the newline and the indent that precede the pipe token.
					-- The recipe entry skips the boundary check, which an indented
					-- value's closing dedent would fail.
					(at_token, parsed) = parse_expression_recipe(at_value.advanced().advanced())
					match parsed:
						ParsedRecipe(recipe):
							(_, value) = mint_recipe(at_token, recipe)
							match legacy_expression_preview(preview_source(lexed), EMPTY_NAME_TABLE, value):
								Ok((_, projected)): Some((global.value, projected))
								Err(_): None
						_: None
				_: None
		_: None


-- The projected body of the only function of `text`: the old parser's
-- `ParsedFunctionDecl.body`, shaped by the tree path.
private func projected_function_body(text: String) -> Option[ParsedExpr]:
	lexed = lex_module(module_id_at_row(0), text)
	match new_parse_state(lexed):
		Err(_): None
		Ok(entry):
			(_, scan) = scan_module_declaration_prefix_with_bodies(entry)
			match legacy_declaration_projection(preview_source(lexed), scan, EMPTY_NAME_TABLE):
				Err(_): None
				Ok(projected):
					match projected.declarations.get(0):
						Some(FunctionParsedDecl(function)): function.body
						_: None


-- The chain is nested in the else branches, so the walk descends by a loop.
func test_deep_else_if_chain_projects_by_a_loop() -> Bool:
	links = 2000
	var lines: List[String] = ["func f(a: Int) -> Int:", "\tif a:", "\t\t0"]
	var written: Int = 1
	while written < links:
		lines = lines.append("\telse if a:")
		lines = lines.append("\t\t${written}")
		written += 1
	lines = lines.append("\telse:")
	lines = lines.append("\t\t${links}")
	match projected_function_body(source_lines(lines)):
		Some(ParsedBlockExpr([ParsedIfExpr(_, _, first_else, _)], _)):
			var current: Option[ParsedElseBranch] = first_else
			var depth: Int = 1
			var correct: Bool = True
			while current.is_some():
				match current:
					Some(branch):
						match branch.body:
							ParsedIfExpr(_, _, next, _):
								depth += 1
								current = next
							_:
								-- The last arm is the `else:` block, not another `if`.
								current = None
					None:
						correct = False
			correct and depth == links
		_: False


func test_long_statement_list_projects_in_order() -> Bool:
	count = 5000
	var lines: List[String] = ["func f() -> Int:"]
	var written: Int = 0
	while written < count:
		lines = lines.append("\tvalue${written} = ${written}")
		written += 1
	lines = lines.append("\tvalue0")
	match projected_function_body(source_lines(lines)):
		Some(ParsedBlockExpr(items, _)): items.length() == count + 1
		_: False


tests: TestSuite = {
	description = "Tree statement and block legacy projection",
	tests = [
		("expression bodies match the old parser", test_expression_body_matches_old_parser),
		("block statements match the old parser", test_block_statements_match_old_parser),
		("declaration metadata matches the old parser", test_declaration_metadata_matches_old_parser),
		("control flow matches the old parser", test_control_flow_matches_old_parser),
		("match statements match the old parser", test_match_statements_match_old_parser),
		("nested blocks match the old parser", test_nested_blocks_match_old_parser),
		("several declarations match the old parser", test_several_declarations_match_old_parser),
		("string and character literals match the old parser", test_string_and_character_literals_match_old_parser),
		("interpolated strings match the old parser", test_interpolated_strings_match_old_parser),
		("character escapes and raw pipe strings match the old parser", test_character_escapes_and_raw_pipe_strings_match_old_parser),
		("pipe strings project like the old parser", test_pipe_strings_project_like_the_old_parser),
		("a 2000 link else if chain projects by a loop", test_deep_else_if_chain_projects_by_a_loop),
		("5000 statements project in order", test_long_statement_list_projects_in_order)
	]
}
