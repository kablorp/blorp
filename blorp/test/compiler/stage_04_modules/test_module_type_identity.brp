import:
	../../../src/lib/source:
		Cursor,
		SourceFile,
		SourceSpan,
		source_cursor_at,
		source_file,
		source_span,
	../../../src/compiler/stage_03_parse/parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ParsedErrorDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
		),
		ParsedIdentifier,
		ParsedTypeExpr(ParsedNamedType),
		parsed_identifier,
	../../../src/compiler/stage_04_modules/module_type_identity: local_type_names_from_decls
	test: TestSuite


pure func fixture_source_file() -> SourceFile:
	source_file("module_identity.brp", "module_identity", "")


pure func fixture_source_span(src: SourceFile) -> SourceSpan:
	cursor: Cursor = source_cursor_at(src, 0)
	source_span(src, cursor, cursor)


pure func identifier(src: SourceFile, text: String) -> ParsedIdentifier:
	parsed_identifier(text, fixture_source_span(src))


pure func named_type(src: SourceFile, text: String) -> ParsedTypeExpr:
	ParsedNamedType(
		identifier(src, text),
		[],
		fixture_source_span(src),
	)


pure func record_decl(src: SourceFile, name: String) -> ParsedDecl:
	RecordParsedDecl({
		name = identifier(src, name),
		type_params = [],
		fields = [],
		is_struct = False,
		doc = None,
		span = fixture_source_span(src),
	})


pure func union_decl(src: SourceFile, name: String) -> ParsedDecl:
	UnionParsedDecl({
		name = identifier(src, name),
		type_params = [],
		variants = [],
		is_enum = False,
		doc = None,
		span = fixture_source_span(src),
	})


pure func type_alias_decl(src: SourceFile, name: String) -> ParsedDecl:
	TypeAliasParsedDecl({
		name = identifier(src, name),
		type_params = [],
		target = named_type(src, "Int"),
		is_opaque = False,
		doc = None,
		span = fixture_source_span(src),
	})


pure func builtin_type_decl(src: SourceFile, name: String) -> ParsedDecl:
	BuiltinTypeParsedDecl({
		name = identifier(src, name),
		type_params = [],
		is_resource = False,
		cleanup = None,
		doc = None,
		span = fixture_source_span(src),
	})


func test_local_type_names_are_sorted_unique_and_private_transparent() -> Bool:
	src: SourceFile = fixture_source_file()
	span: SourceSpan = fixture_source_span(src)
	decls: List[ParsedDecl] = [
		record_decl(src, "Zoo"),
		ParsedErrorDecl(span),
		type_alias_decl(src, "Alias"),
		PrivateParsedDecl(
			union_decl(src, "Hidden"),
			span,
		),
		builtin_type_decl(src, "Native"),
		record_decl(src, "Alias"),
		union_decl(src, "Choice"),
	]

	local_type_names_from_decls(decls) == ["Alias", "Choice", "Hidden", "Native", "Zoo"]


tests: TestSuite = {
	description = "Compiler module type identity",
	tests = [
		(
			"local type names are sorted unique and private transparent",
			test_local_type_names_are_sorted_unique_and_private_transparent,
		),
	]
}
