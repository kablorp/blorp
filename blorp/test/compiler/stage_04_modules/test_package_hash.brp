import:
	../../../src/compiler/stage_04_modules/package_hash:
		PackageHashEntry,
		blake3_hash_bytes_hex,
		hash_package_entries,
		hash_package_files,
		normalize_package_hash_path,
		package_hash_join_for_platform,
		package_hash_matches_pin,
		package_hash_relative_path_from,
		read_package_hash_entries,
		validate_package_hash_pin,
	../../../src/compiler/stage_04_modules/package_manifest: package_manifest_error_text
	../../../src/lib/path_identity: path_is_absolute_for_platform
	bytes: bytes, concat as concat_bytes
	fs: IOError, resource_path, temporary_directory
	process: ProcessOutput, exit_code, run
	system: mkdir, temp_dir, write_bytes, write_file
