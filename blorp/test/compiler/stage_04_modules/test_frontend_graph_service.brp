private pure func identity(module_name: String) -> ResolvedModuleIdentity:
	resolved_module_identity_from_resolver(module_name, UserModule)


private pure func module(module_name: String, text: String) -> FrontendModule:
	source = source_file("/workspace/" + module_name + ".brp", module_name, text)
	program = finalized_typecheck_program(parse_compiler_source(source))
	{
		identity = identity(module_name),
		program = program,
		surface = module_surface_for_program(finalized_typecheck_program_ast(program))
	}


pure func test_service_requires_an_outcome_for_each_parsed_import() -> Bool:
	app = module("app", "import:\n\tdep\n\nVALUE = 1\n")

	match validated_frontend_graph_for_modules([app], [app.identity], []):
		Err([MissingCompilerFrontendImportOutcome(importer, requested_path)]):
			resolved_module_identities_equal(importer, app.identity) and requested_path == "dep"
		_:
			False


pure func test_service_preserves_repeated_import_diagnostic_order() -> Bool:
	app = module("app", "import:\n\tdep\n\tdep\n\nVALUE = 1\n")

	match validated_frontend_graph_for_modules([app], [app.identity], []):
		Err([MissingCompilerFrontendImportOutcome(first_importer, first_path), MissingCompilerFrontendImportOutcome(second_importer, second_path)]):
			(
				resolved_module_identities_equal(first_importer, app.identity)
				and resolved_module_identities_equal(second_importer, app.identity)
				and first_path == "dep"
				and second_path == "dep"
			)
		_:
			False


pure func test_service_rejects_duplicate_outcomes_for_one_import() -> Bool:
	app = module("app", "import:\n\tdep\n\nVALUE = 1\n")
	edges = [
		{
			importer = app.identity,
			requested_path = "dep",
			resolution = FrontendUnresolvedImport
		},
		{
			importer = app.identity,
			requested_path = "dep",
			resolution = FrontendUnresolvedImport
		},
	]

	match validated_frontend_graph_for_modules([app], [app.identity], edges):
		Err([DuplicateCompilerFrontendImportOutcome(importer, requested_path)]):
			resolved_module_identities_equal(importer, app.identity) and requested_path == "dep"
		_:
			False


pure func test_service_accepts_one_outcome_for_each_repeated_import() -> Bool:
	app = module("app", "import:\n\tdep\n\tdep\n\nVALUE = 1\n")
	edges = [
		{
			importer = app.identity,
			requested_path = "dep",
			resolution = FrontendUnresolvedImport
		},
		{
			importer = app.identity,
			requested_path = "dep",
			resolution = FrontendUnresolvedImport
		},
	]

	match validated_frontend_graph_for_modules([app], [app.identity], edges):
		Err(_):
			False
		Ok(graph):
			frontend_graph_import_edges(graph).length() == 2


pure func test_service_rejects_an_edge_without_a_parsed_import() -> Bool:
	app = module("app", "VALUE = 1\n")
	edge: FrontendImportEdge = {
		importer = app.identity,
		requested_path = "dep",
		resolution = FrontendUnresolvedImport
	}

	match validated_frontend_graph_for_modules([app], [app.identity], [edge]):
		Err([UndeclaredCompilerFrontendImportOutcome(importer, requested_path)]):
			resolved_module_identities_equal(importer, app.identity) and requested_path == "dep"
		_:
			False


pure func test_service_preserves_outcome_then_undeclared_error_order() -> Bool:
	app = module("app", "import:\n\tmissing\n\tduplicate\n\nVALUE = 1\n")
	edges: List[FrontendImportEdge] = [
		{
			importer = app.identity,
			requested_path = "duplicate",
			resolution = FrontendUnresolvedImport
		},
		{
			importer = app.identity,
			requested_path = "duplicate",
			resolution = FrontendUnresolvedImport
		},
		{
			importer = app.identity,
			requested_path = "undeclared_first",
			resolution = FrontendUnresolvedImport
		},
		{
			importer = app.identity,
			requested_path = "undeclared_second",
			resolution = FrontendUnresolvedImport
		},
	]

	match validated_frontend_graph_for_modules([app], [app.identity], edges):
		Err([MissingCompilerFrontendImportOutcome(missing_importer, "missing"), DuplicateCompilerFrontendImportOutcome(duplicate_importer, "duplicate"), UndeclaredCompilerFrontendImportOutcome(first_importer, "undeclared_first"), UndeclaredCompilerFrontendImportOutcome(second_importer, "undeclared_second")]):
			(
				resolved_module_identities_equal(missing_importer, app.identity)
				and resolved_module_identities_equal(duplicate_importer, app.identity)
				and resolved_module_identities_equal(first_importer, app.identity)
				and resolved_module_identities_equal(second_importer, app.identity)
			)
		_:
			False


pure func test_service_accepts_cycles_with_exact_resolved_edges() -> Bool:
	app = module("app", "import:\n\tdep\n\nVALUE = 1\n")
	dep = module("dep", "import:\n\tapp\n\nVALUE = 2\n")
	edges = [
		{
			importer = app.identity,
			requested_path = "dep",
			resolution = FrontendResolvedImport(dep.identity)
		},
		{
			importer = dep.identity,
			requested_path = "app",
			resolution = FrontendResolvedImport(app.identity)
		},
	]

	match (
		validated_frontend_graph_for_modules(
			[app, dep],
			[app.identity],
			edges,
		)
	):
		Err(_):
			False
		Ok(graph):
			frontend_graph_import_edges(graph).length() == 2


private pure func cycle_source(
	module_name: String,
	imported_module: String,
) -> FrontendSourceCandidate:
	{
		identity = identity(module_name),
		input = RawFrontendSource(
			source_file(
				"/workspace/" + module_name + ".brp",
				module_name,
				"import:\n\t" + imported_module + "\n\nVALUE = 1\n",
			),
		)
	}


private pure func resolve_cycle_source(
	importer: FrontendSourceCandidate,
	requested_path: String,
) -> Result[FrontendSourceResolution, String]:
	if frontend_source_candidate_source(importer).module_name == "app" and requested_path == "dep":
		Ok(FrontendSourceResolved(frontend_source_location(cycle_source("dep", "app"))))
	else if (
		frontend_source_candidate_source(importer).module_name == "dep"
		and requested_path == "app"
	):
		Ok(FrontendSourceResolved(frontend_source_location(cycle_source("app", "dep"))))
	else:
		Ok(FrontendSourceUnresolved)


private pure func load_cycle_source(location: FrontendSourceLocation) -> Result[SourceFile, String]:
	imported_module: String = if location.module_name == "app":
		"dep"
	else:
		"app"

	Ok(frontend_source_candidate_source(cycle_source(location.module_name, imported_module)))


--- This mixes roots, a seed, fan-out, a diamond, and a cycle. The graph
--- order is discovery order: initial roots and seeds, then each module the
--- first time its identity is reached from the growing worklist.
private pure func ordered_graph_source(module_name: String) -> SourceFile:
	match module_name:
		"first_root":
			source_file(
				"/workspace/first_root.brp",
				"first_root",
				"import:\n\tleft\n\tshared\n\nVALUE = 1\n",
			)
		"second_root":
			source_file(
				"/workspace/second_root.brp",
				"second_root",
				"import:\n\tright\n\nVALUE = 1\n",
			)
		"seed":
			source_file("/workspace/seed.brp", "seed", "import:\n\tshared\n\nVALUE = 1\n")
		"left":
			source_file("/workspace/left.brp", "left", "import:\n\tleaf\n\nVALUE = 1\n")
		"shared":
			source_file("/workspace/shared.brp", "shared", "import:\n\ttail\n\nVALUE = 1\n")
		"right":
			source_file("/workspace/right.brp", "right", "import:\n\tleaf\n\nVALUE = 1\n")
		"leaf":
			source_file("/workspace/leaf.brp", "leaf", "import:\n\tfirst_root\n\nVALUE = 1\n")
		_:
			source_file("/workspace/tail.brp", "tail", "VALUE = 1\n")


private pure func ordered_graph_candidate(module_name: String) -> FrontendSourceCandidate:
	{
		identity = identity(module_name),
		input = RawFrontendSource(ordered_graph_source(module_name))
	}


private pure func resolve_ordered_graph(
	_importer: FrontendSourceCandidate,
	requested_path: String,
) -> Result[FrontendSourceResolution, String]:
	Ok(FrontendSourceResolved(frontend_source_location(ordered_graph_candidate(requested_path))))


func test_discovery_preserves_growing_worklist_order_across_graph_shapes() -> Bool:
	first_root = ordered_graph_candidate("first_root")
	second_root = ordered_graph_candidate("second_root")
	seed = ordered_graph_candidate("seed")
	load_calls: Channel[String] = channel(8)
	load_with_observation = func(location: FrontendSourceLocation):
		_ = send(load_calls, location.module_name)
		Ok(ordered_graph_source(location.module_name))

	match (
		frontend_graph_discover(
			[first_root, second_root],
			[seed],
			resolve_ordered_graph,
			load_with_observation,
		)
	):
		Err(_):
			False
		Ok(graph):
			match [
				try_recv(load_calls),
				try_recv(load_calls),
				try_recv(load_calls),
				try_recv(load_calls),
				try_recv(load_calls),
				try_recv(load_calls),
			]:
				[Some("left"), Some("shared"), Some("right"), Some("leaf"), Some("tail"), None]:
					(
						frontend_graph_modules(
							graph,
						).map(
							func(
								found,
							): found.surface.module_name,
						) == [
							"first_root",
							"second_root",
							"seed",
							"left",
							"shared",
							"right",
							"leaf",
							"tail",
						]
						and frontend_graph_import_edges(
							graph,
						).map(
							func(
								edge,
							): edge.requested_path,
						) == [
							"left",
							"shared",
							"right",
							"shared",
							"leaf",
							"tail",
							"leaf",
							"first_root",
						]
					)
				_:
					False


private pure func first_provider_failure_source() -> FrontendSourceCandidate:
	{
		identity = identity("failure_root"),
		input = RawFrontendSource(
			source_file(
				"/workspace/failure_root.brp",
				"failure_root",
				"import:\n\tbroken\n\tlater\n\nVALUE = 1\n",
			),
		)
	}


private pure func resolve_first_provider_failure(
	_importer: FrontendSourceCandidate,
	requested_path: String,
) -> Result[FrontendSourceResolution, String]:
	if requested_path == "broken":
		Ok(FrontendSourceResolved(frontend_source_location({
			identity = identity("broken"),
			input = RawFrontendSource(
				source_file(
					"/workspace/broken.brp",
					"broken",
					"VALUE = 1\n",
				),
			),
		})))
	else:
		Err("later resolution should not run")


private pure func load_first_provider_failure(
	_location: FrontendSourceLocation,
) -> Result[SourceFile, String]:
	Err("first load failed")


func test_discovery_reports_the_first_provider_failure() -> Bool:
	match frontend_graph_discover(
		[first_provider_failure_source()],
		[],
		resolve_first_provider_failure,
		load_first_provider_failure,
	):
		Err(FrontendDiscoveryProviderFailed(importer, requested_path, message)):
			(
				resolved_module_identities_equal(importer, identity("failure_root"))
				and requested_path == "broken"
				and message == "first load failed"
			)
		_:
			False


func test_discovery_owns_parsing_resolution_edges_and_cycle_termination() -> Bool:
	app = cycle_source("app", "dep")

	match frontend_graph_discover([app], [], resolve_cycle_source, load_cycle_source):
		Err(_):
			False
		Ok(graph):
			(
				frontend_graph_import_edges(graph).length() == 2
				and frontend_graph_modules(graph).length() == 2
			)


private pure func conflicting_dep_location(path: String) -> FrontendSourceResolution:
	candidate: FrontendSourceCandidate = {
		identity = identity("dep"),
		input = RawFrontendSource(source_file(path, "dep", "VALUE = 1\n"))
	}
	FrontendSourceResolved(frontend_source_location(candidate))


private pure func resolve_conflicting_dep(
	_importer: FrontendSourceCandidate,
	requested_path: String,
) -> Result[FrontendSourceResolution, String]:
	if requested_path == "a":
		Ok(conflicting_dep_location("/workspace/dep_a.brp"))
	else if requested_path == "b":
		Ok(conflicting_dep_location("/workspace/dep_b.brp"))
	else:
		Ok(FrontendSourceUnresolved)


private pure func load_conflicting_dep(
	location: FrontendSourceLocation,
) -> Result[SourceFile, String]:
	Ok(source_file(location.path, location.module_name, "VALUE = 1\n"))


func test_discovery_rejects_identity_conflict_with_different_paths() -> Bool:
	app: FrontendSourceCandidate = {
		identity = identity("app"),
		input = RawFrontendSource(
			source_file(
				"/workspace/app.brp",
				"app",
				"import:\n\ta\n\tb\n\nVALUE = 1\n",
			),
		)
	}

	match frontend_graph_discover([app], [], resolve_conflicting_dep, load_conflicting_dep):
		Err(FrontendDiscoveryIdentityConflict(first, second)):
			(
				resolved_module_identities_equal(first.identity, identity("dep"))
				and resolved_module_identities_equal(second.identity, identity("dep"))
				and first.path != second.path
			)
		_:
			False


func test_discovery_retains_exact_module_surface() -> Bool:
	app: FrontendSourceCandidate = {
		identity = identity("app"),
		input = RawFrontendSource(
			source_file(
				"/workspace/app.brp",
				"app",
				"import:\n\tdep\n\nVALUE = 1\nprivate HIDDEN = 2\nprivate trait Internal:\n\tfunc apply(value: Int) -> Int\n",
			),
		)
	}

	match (
		frontend_graph_discover(
			[app],
			[],
			func(_importer, _requested): Ok(FrontendSourceUnresolved),
			func(_location): Err("not reached"),
		)
	):
		Err(_):
			False
		Ok(graph):
			match frontend_graph_modules(graph):
				[module]:
					(
						module.surface.module_name == "app"
						and module.surface.import_paths == ["dep"]
						and module.surface.exports.map(func(symbol): symbol.name) == ["VALUE"]
						and module.surface.private_names.map(
							func(symbol): symbol.name,
						) == ["HIDDEN", "Internal", "apply"]
						and module.surface.private_traits == ["Internal"]
					)
				_:
					False


pure func test_implicit_module_paths_are_explicit_constant() -> Bool:
	COMPILER_FRONTEND_IMPLICIT_MODULE_PATHS == ["prelude", "tuple"]


tests: TestSuite = {
	description = "Compiler frontend graph service",
	tests = [
		(
			"require one outcome for each parsed import",
			test_service_requires_an_outcome_for_each_parsed_import,
		),
		(
			"preserve repeated import diagnostic order",
			test_service_preserves_repeated_import_diagnostic_order,
		),
		(
			"reject duplicate outcomes for one parsed import",
			test_service_rejects_duplicate_outcomes_for_one_import,
		),
		(
			"accept one outcome for each repeated import",
			test_service_accepts_one_outcome_for_each_repeated_import,
		),
		(
			"reject an outcome without a parsed import",
			test_service_rejects_an_edge_without_a_parsed_import,
		),
		(
			"preserve outcome then undeclared error order",
			test_service_preserves_outcome_then_undeclared_error_order,
		),
		(
			"accept cycles with exact resolved edges",
			test_service_accepts_cycles_with_exact_resolved_edges,
		),
		(
			"own parsing resolution edges and cycle termination",
			test_discovery_owns_parsing_resolution_edges_and_cycle_termination,
		),
		(
			"preserves growing worklist order across graph shapes",
			test_discovery_preserves_growing_worklist_order_across_graph_shapes,
		),
		("reports the first provider failure", test_discovery_reports_the_first_provider_failure),
		(
			"reject identity conflict with different paths",
			test_discovery_rejects_identity_conflict_with_different_paths,
		),
		("retain exact module surface", test_discovery_retains_exact_module_surface),
		(
			"implicit module paths are explicit constant",
			test_implicit_module_paths_are_explicit_constant,
		),
	]
}
