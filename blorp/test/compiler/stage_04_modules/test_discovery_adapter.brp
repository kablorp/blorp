ESCAPE_SOURCE: String = raw
	|func escapes(d: Int) -> String:
	|	after_hole = "${d} \u{41} \u{1F600}x"
	|	before_hole = "x\u{41}{y}${d}"
	|	around = "\u{41} ${d} \u{42}"
	|	braces_first = "{kept} ${d}"
	|	braces_after = "kept ${d} \{ \} } {"
	|	backslashes = "\\n ${d} \\{ \\}"
	|	unknown = "${d} \q \$ \${d}"
	|	after_hole


func test_escapes_and_braces_around_holes_match() -> Bool:
	rebuilds(ESCAPE_SOURCE, 1)


---
Interpolation nested three levels deep is interpolated at every level here. The
existing lexer leaves the innermost string a plain literal (`"c {h}"`), a known
difference (`docs/issues/interpolation_nesting_in_the_existing_lexer.md`, listed
in `ADAPTER_DIFFERENCES` through the `known_differences` fixture).
---
func test_interpolation_three_levels_deep_is_interpolated_at_every_level() -> Bool:
	source: String = "func f(h: Int) -> String:\n\t\"a " + HOLE_OPENER + "f(\"b " + HOLE_OPENER + "g(\"c " + HOLE_OPENER + "h}\")}\")} d\"\n"

	match adapter_differences(source):
		Some((_, differences)):
			differences.any(
				pure func(
					difference,
				): (
					difference.path.ends_with(".kind")
					and difference.old_text == "\"string_literal\""
					and difference.new_text == "\"string_interp\""
				),
			)
		None:
			False


---
A chain of `DEEP_OPERANDS` operands nests that many levels deep, and a body the
adapter rebuilds does not recurse over them.
---
func test_a_deeply_nested_body_is_rebuilt_without_recursion() -> Bool:
	var chain: String = "1"

	for operand in 0..DEEP_OPERANDS:
		chain += " + ${operand}"

	match discovered({ROOT_PATH => "func deep() -> Int:\n\t${chain}\n"}):
		Some(tables):
			match reader_of(tables):
				Some(reader):
					match legacy_parsed_program(reader, module_id_at_row(0)):
						Ok(program):
							(
								program.decls.length() == 1
								and first_body_spine_length(program) == DEEP_OPERANDS
							)
						Err(_):
							False
				None:
					False
		None:
			False


---
How many binary operations the left spine of the first function's body holds:
the chain's depth, followed one level at a time.
---
func first_body_spine_length(program: ParsedProgram) -> Int:
	var spine: Int = 0

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			var current: Option[ParsedExpr] = function_decl.body

			-- The body is a block of one expression.
			match current:
				Some(ParsedBlockExpr(items, _)):
					current = items.get(0)
				_:
					void

			var following: Bool = True

			while following:
				match current:
					Some(ParsedBinaryExpr(_, left, _, _)):
						spine += 1
						current = Some(left)
					_:
						following = False
		_:
			void

	spine


DEEP_OPERANDS: Int = 6000

---
`$` then `{`: spelled apart so a test source can hold an interpolation hole
without opening one here.
---
HOLE_OPENER: String = "$" + "{"


---
A `concurrently` loop with no `limit` is something the parser reports, and the
tables then hold a loop without the parameter the existing AST requires: the
adapter reports the node, and does not invent a limit.
---
func test_a_concurrently_loop_without_a_limit_is_a_malformed_node() -> Bool:
	match discovered(
		{
			ROOT_PATH => "func f(xs: List[Int]) -> Int:\n\tfor x in xs concurrently():\n\t\tx\n\t0\n",
		},
	):
		Some(tables):
			match reader_of(tables):
				Some(reader):
					match legacy_parsed_program(reader, module_id_at_row(0)):
						Err(MalformedNode(_, ConcurrentForNode)):
							True
						_:
							False
				None:
					False
		None:
			False


func test_the_comparison_reports_a_changed_field() -> Bool:
	source: String = "func f(value: Int) -> Int:\n\tvalue\n"
	existing: ParsedProgram = parse_compiler_source(
		source_file(
			ROOT_PATH,
			ROOT_MODULE_NAME,
			source,
		),
	)
	changed: ParsedProgram = { existing | decls = existing.decls.drop(1) }
	differences: List[JsonDifference] = program_differences(
		parsed_program_to_json(with_holes_parsed(existing)),
		parsed_program_to_json(changed),
	)

	(
		differences.length() == 1
		and differences.any(pure func(difference): difference.path == "decls.length")
	)


func test_the_adapter_names_modules_as_the_existing_front_end_does() -> Bool:
	match discovered({
		ROOT_PATH => "import:\n\t./helper\n\tstd_item\n",
		"app/helper.brp" => "x: Int = 1\n",
		"std/std_item.brp" => "y: Int = 2\n",
	}):
		Some(tables):
			match reader_of(tables):
				Some(reader):
					reader.module_names == ["main", "app/helper", "std_item"]
				None:
					False
		None:
			False


func test_a_native_package_module_is_named_by_its_request() -> Bool:
	match discovered({
		ROOT_PATH => "import:\n\tpkg/toolkit/format\n",
		"pkg/toolkit/format.brp" => "y: Int = 2\n",
	}):
		Some(tables):
			match reader_of(tables):
				Some(reader):
					reader.module_names == ["main", "pkg/toolkit/format"]
				None:
					False
		None:
			False


func test_a_table_the_parser_left_incomplete_is_an_error_not_a_default() -> Bool:
	-- A `#` with no name after it: the parser reports it and records a dimension
	-- parameter with no name, which has no sigil name row to read.
	match discovered({ROOT_PATH => "func f[#](x: Int) -> Int: x\n"}):
		Some(tables):
			match reader_of(tables):
				Some(reader):
					match legacy_parsed_program(reader, module_id_at_row(0)):
						Err(MissingTableRow(DimensionNameTable, _)):
							True
						_:
							False
				None:
					False
		None:
			False


func test_the_graph_has_the_modules_roots_and_edges_of_the_sources() -> Bool:
	match discovered({
		ROOT_PATH => "import:\n\t./helper\n\tstd_item\n\tmissing_module\n",
		"app/helper.brp" => "import:\n\tstd_item\n\nx: Int = 1\n",
		"std/std_item.brp" => "y: Int = 2\n",
	}):
		Some(tables):
			match legacy_frontend_graph(tables, NAMING, CONTEXT):
				Ok(compilation):
					paths: List[String] = frontend_graph_modules(
						compilation.graph,
					).map(
						pure func(module): resolved_module_canonical_path(module.identity),
					)
					roots: List[String] = frontend_graph_root_modules(
						compilation.graph,
					).map(
						pure func(module): resolved_module_canonical_path(module.identity),
					)
					edges: List[String] = frontend_graph_import_edges(
						compilation.graph,
					).map(
						pure func(edge): edge_text(edge.requested_path, edge.resolution),
					)
					(
						paths == ["main", "app/helper", "std_item"]
						and roots == ["main"]
						and edges == [
							"./helper -> app/helper",
							"std_item -> std_item",
							"missing_module -> unresolved",
							"std_item -> std_item",
						]
					)
				Err(_):
					False
		None:
			False


private pure func edge_text(requested_path: String, resolution: FrontendImportResolution) -> String:
	match resolution:
		FrontendResolvedImport(target):
			"${requested_path} -> ${resolved_module_canonical_path(target)}"
		FrontendUnresolvedImport:
			"${requested_path} -> unresolved"


func test_graph_identifiers_are_spelled_by_the_stages_name_table() -> Bool:
	match discovered({ROOT_PATH => "func spelled(value: Int) -> Int:\n\tvalue\n"}):
		Some(tables):
			match legacy_frontend_graph(tables, NAMING, CONTEXT):
				Ok(compilation):
					names = frontend_graph_name_table(compilation.graph)

					match frontend_graph_root_modules(compilation.graph).get(0):
						Some(module):
							match finalized_typecheck_program_ast(module.program).decls.get(0):
								Some(FunctionParsedDecl(function_decl)):
									(
										name_spelling(
											names,
											function_decl.name.name,
										) == Some("spelled")
										and function_decl.name.text == "spelled"
									)
								_:
									False
						None:
							False
				Err(_):
					False
		None:
			False


func test_the_stages_seed_names_equal_the_existing_vocabulary() -> Bool:
	SEEDED_NAME_SPELLINGS == name_table_synthesized_spellings()


