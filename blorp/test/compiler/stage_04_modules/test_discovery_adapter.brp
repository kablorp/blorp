		"func apply(step: (Int, Int) -> Int, pair: (Int, Float), later: pure (Int) -> Int, nothing: ()) -> (Int, (Int, Float)):\n\t(1, (2, 3.0))\n\nfunc grouped(point: (Int)) -> Int:\n\t0\n",
