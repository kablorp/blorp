func test_non_ascii_text_spans_match() -> Bool:
	rebuilds(
		"-- café ☃\n---\nDocumentation with über and ☃.\n---\nfunc plain(value: Int) -> Int:\n\t0\n\n-- 日本語\nrecord Point {x: Int}\n",
		2,
	)


-- Bodies. Each source is a raw pipe string, so its tabs, quotes and `${` are
-- the program's own.
EXPRESSION_SOURCE: String = raw
	|func operators(a: Int, b: Int, c: Int, xs: List[Int], name: String) -> Int:
	|	sum = a + b * c - a / b % c
	|	flags = a == b and b != c or not (a < b) and b <= c or a > c and b >= c
	|	negated = -a + -(b)
	|	span = a..b
	|	item = xs[0]
	|	cell = xs[a, b]
	|	size = name.length().to_string().length()
	|	call = max(a, b, c)
	|	named = configure(retries = 3, xs)
	|	grouped = (a + b) * (c)
	|	tuple = (a, (b, c))
	|	list = [1, 2.5, 'x', True, False, "s"]
	|	nothing = ()
	|	void
	|
	|func literals() -> Int:
	|	lowest = -9223372036854775808
	|	highest = 9223372036854775807
	|	small = -5
	|	real = 1.5e10
	|	letter = '\u{1F600}'
	|	tab = '\t'
	|	size = - 5
	|	lowest

GROUPED_NAME_SOURCE: String = raw
	|func grouped(a, b):
	|	c = (a) + b
	|	d = ((a)) + b
	|	e = f((a), (b + 1))
	|	g = (a).field
	|	h = (a)[0]
	|	i = -(a)
	|	j = (a)..(b)
	|	k = not (a)
	|	a

STRING_SOURCE: String = raw
	|func strings(name: String, count: Int) -> String:
	|	plain = "plain \n \t \u{1F600} \" \\ ünï"
	|	raw_text = raw"raw \n ${not} a hole"
	|	pipe =
	|		|first line
	|		||second line
	|	raw_pipe = raw
	|		|raw \n pipe
	|		|second ${x}
	|	interpolated = "hello ${name}, ${count + 1} and ${"nested ${name} here"} done"
	|	pipe_interpolated =
	|		|value ${name}
	|		|next ${count}
	|	deep = "a ${f("b ${g}")} d"
	|	only_hole = "${name}"
	|	brace_text = "kept ${name} \{ \} } {"
	|	empty = ""
	|	unicode = "héllo ${name} wörld ünï"
	|	after_hole = "${name} \n \t \\ \" \q \${count} end"
	|	plain

BRACE_SOURCE: String = raw
	|record Point {
	|	x: Int,
	|	y: Int
	|}
	|
	|func braces(x: Int, r: Point) -> Int:
	|	record_literal = {x = 1}
	|	empty = {}
	|	vector = {x}
	|	vectors = {1, 2, 3,}
	|	dict = {"a" => 1}
	|	dicts = {"a" => 1, "b" => 2,}
	|	updated = {r | x = 1}
	|	updates = {r | x = 1, y = 2}
	|	nested = {{}}
	|	keyed = {(1, 2) => {3}}
	|	fields = {
	|		x = 1,
	|		y = 2,
	|	}
	|	entries = {
	|		"a" => 1,
	|		"b" => 2,
	|	}
	|	x

CHAIN_SOURCE: String = raw
	|func chains(xs: List[Int], name: String) -> Int:
	|	xs
	|		.map(func(x): x + 1)
	|		.filter(func(x): x > 1)
	|		.length()
	|	ys = xs
	|		.map(func(item): item * 2)
	|	f(func(): 1)
	|		.g()
	|	total = xs.fold(0, func(acc, x):
	|		next = acc + x
	|		next
	|	)
	|	name.length().to_string().length()

ANCHORED_SOURCE: String = raw
	|func anchored(n: Int, items: List[Int]) -> Int:
	|	pick = if n > 0:
	|		"positive"
	|	else:
	|		"other"
	|	kind = match n:
	|		0: "zero"
	|		_: if n > 10:
	|			"big"
	|		else:
	|			"small"
	|	total = items.fold(0, func(acc, x):
	|		if x > 0:
	|			acc + x
	|		else:
	|			acc
	|	)
	|	if n > 1:
	|		1
	|	-- a comment between the branches
	|	else if n > 2:
	|		2
	|	-- and another
	|	else:
	|		3

CONTROL_SOURCE: String = raw
	|func control(n: Int, xs: List[Int], pair: (Int, Int)) -> Int:
	|	var total = 0
	|	while total < n:
	|		total += 1
	|		if total == 3:
	|			continue
	|		if total > 5:
	|			break
	|	for item in xs:
	|		total += item
	|	for (left, right) in pairs:
	|		total += left * right
	|	for i in 0..n:
	|		total -= i
	|	match n:
	|		0 | 1:
	|			"small"
	|		-1:
	|			"negative"
	|		Shape.Circle(r):
	|			r
	|		Some([first, second, ...rest]):
	|			first
	|		Some([_, ..._]):
	|			1
	|		None:
	|			2
	|		(a, -1.5):
	|			a
	|		_:
	|			"other"
	|	total

PATTERN_SOURCE: String = raw
	|func patterns(text: String, number: Int, real: Float, letter: Char, flag: Bool) -> Int:
	|	match text:
	|		"plain":
	|			1
	|		raw"raw\n":
	|			2
	|		_:
	|			3
	|	match number:
	|		-5:
	|			1
	|		-9223372036854775808:
	|			2
	|		0 | 1 | 2:
	|			3
	|		_:
	|			4
	|	match real:
	|		-1.5:
	|			1
	|		2.0:
	|			2
	|		_:
	|			3
	|	match letter:
	|		'a':
	|			1
	|		'\n':
	|			2
	|		_:
	|			3
	|	match flag:
	|		True:
	|			1
	|		False:
	|			2

STATEMENT_SOURCE: String = raw
	|func statements(xs: List[Int], pair: (Int, Int)) -> Int:
	|	var total: Int = 0
	|	limit: Int = 10
	|	var untyped = 5
	|	total += 1
	|	total -= 2
	|	total *= 3
	|	total /= 4
	|	untyped = 7
	|	item ?= xs.first()
	|	typed: Int ?= xs.last()
	|	xs[0] = 5
	|	grid[1, 2] = 6
	|	(a, _) = pair
	|	(b, c, d) = triple
	|	var later =
	|		compute()
	|	o = into_opaque Email(total)
	|	p = from_opaque Email(o)
	|	grid: Float[#3, #4] = zeros()
	|	box: Wrapper[Int, #N] = make()
	|	void
	|
	|func builtins() -> Int: builtin("helper")
	|
	|func bare(): builtin
	|
	|limit: Int = 3 + 4
	|
	|var counter: Int = 0

LAMBDA_SOURCE: String = raw
	|func lambdas(xs: List[Int]) -> Int:
	|	a = func(): 1
	|	b = func(x): x + 1
	|	c = func(x: Int, y: Int) -> Int: x + y
	|	d = pure func(x: Int) -> Int: x
	|	e = func(x, y):
	|		z = x + y
	|		z
	|	pure func local(x: Int) -> Int:
	|		x * 2
	|	func other(y):
	|		y
	|	func outer[T](m: T) -> T where #N == 3:
	|		func inner(k: Int) -> Int:
	|			k
	|		m
	|	xs.map(func(v): v + 1).filter(pure func(v: Int) -> Bool: v > 0)[0]
	|	local(1) + other(2)

CONCURRENCY_SOURCE: String = raw
	|func concurrency(xs: List[Int], ch: Channel[Int]) -> Int:
	|	for item in xs concurrently(limit: 4):
	|		work(item)
	|	for item in xs concurrently(limit: 2, timeout: 5):
	|		work(item)
	|	concurrent(max_threads: 2, timeout: 10):
	|		work()
	|	concurrent:
	|		work()
	|	concurrent(timeout: 3):
	|		work()
	|	concurrent(max_threads: 007):
	|		work()
	|	for item in xs concurrently(limit: 99999999999999999999):
	|		work(item)
	|	select:
	|		msg from ch:
	|			msg
	|		sealed ch:
	|			0
	|		_ after 5:
	|			1
	|	with file ?= open("x") on e => wrap(e):
	|		file.read()
	|	with handle: Handle = open("y"):
	|		handle.read()
	|	with other ?= open("z"):
	|		other.read()
	|	debug:
	|		log(1)
	|	detach work()
	|	0

MEMBER_SOURCE: String = raw
	|---
	|A module.
	|---
	|import:
	|	./a
	|
	|---
	|A documented function.
	|---
	|func documented() -> Int:
	|	1
	|
	|-- not a docstring
	|func undocumented() -> Int:
	|	2
	|
	|---
	|A documented, annotated function.
	|---
	|@tail_recursive
	|func annotated(n: Int) -> Int:
	|	n
	|
	|---
	|A docstring, then a comment.
	|---
	|-- the comment
	|func commented() -> Int:
	|	4
	|
	|---
	|A private documented function.
	|---
	|private pure func quiet() -> Int:
	|	5
	|
	|record Point {x: Int}
	|
	|trait Shape[T]:
	|	pure func area(self: T) -> Float
	|	func describe(self: T) -> String:
	|		"shape"
	|
	|implements Shape for Point:
	|	pure func area(self: Point) -> Float:
	|		self.x
	|
	|	@tail_recursive
	|	func describe(self: Point) -> String:
	|		"point"
	|
	|private func hidden() -> Int:
	|	3
	|
	|private limit: Int = 4


