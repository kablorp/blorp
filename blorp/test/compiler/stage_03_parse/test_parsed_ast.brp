		and text.contains("\"text\":\"left\"")
		and text.contains("\"text\":\"right\"")
		and text.contains("\"type\"")
	)


pure func replace_name_child_with_int(expr: ParsedExpr) -> ParsedExpr:
	match expr:
		ParsedNameExpr(_):
			ParsedIntLiteralExpr(
				"99",
				span_between(fixture_source_file(), 0, 1),
			)
		_:
			expr


func test_map_parsed_expr_children_rewrites_select_kind_and_body() -> Bool:
	src: SourceFile = fixture_source_file()
	channel_name: ParsedIdentifier = parsed_identifier(name_id_pending_dynamic_intern(), 
		"ch",
		span_between(src, 0, 2),
	)
	item_name: ParsedIdentifier = parsed_identifier(name_id_pending_dynamic_intern(), 
		"item",
		span_between(src, 3, 7),
	)
	body_name: ParsedIdentifier = parsed_identifier(name_id_pending_dynamic_intern(), 
		"body",
		span_between(src, 8, 12),
	)
	arm: ParsedSelectArm = {
		kind = ParsedSelectReceiveArm(item_name, ParsedNameExpr(channel_name)),
		body = ParsedNameExpr(body_name),
		span = span_between(src, 0, 12)
	}
	mapped: ParsedExpr = map_parsed_expr_children(
		ParsedSelectExpr(
			[arm],
			span_between(src, 0, 12),
		),
		replace_name_child_with_int,
	)

	match mapped:
		ParsedSelectExpr([mapped_arm], _):
			kind_ok: Bool = match mapped_arm.kind:
				ParsedSelectReceiveArm(_, ParsedIntLiteralExpr("99", _)):
					True
				_:
					False

			body_ok: Bool = match mapped_arm.body:
				ParsedIntLiteralExpr("99", _):
					True
				_:
					False

			kind_ok and body_ok
		_:
			False


func test_map_parsed_expr_children_rewrites_function_decl_body() -> Bool:
	src: SourceFile = fixture_source_file()
	decl: ParsedFunctionDecl = {
		name = parsed_identifier(name_id_pending_dynamic_intern(), 
			"inner",
			span_between(src, 0, 5),
		),
		keyword_span = Some(span_between(src, 0, 4)),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = Some(ParsedNameExpr(parsed_identifier(name_id_pending_dynamic_intern(), "value", span_between(src, 6, 11)))),
		is_pure = False,
		annotations = [],
		doc = None,
		span = span_between(src, 0, 11)
	}
	mapped: ParsedExpr = map_parsed_expr_children(
		ParsedFunctionDeclExpr(decl),
		replace_name_child_with_int,
	)

	match mapped:
		ParsedFunctionDeclExpr(mapped_decl):
			match mapped_decl.body:
				Some(ParsedIntLiteralExpr("99", _)):
					True
				_:
					False
		_:
			False


private pure func collect_literal_children(
	result: List[String],
	expr: ParsedExpr,
	prefix: String,
) -> List[String]:
	with_self = match expr:
		ParsedIntLiteralExpr(value, _):
			result.append(prefix + value)
		_:
			result

	fold_parsed_expr_children(expr, with_self, prefix, collect_literal_children)


func test_fold_parsed_expr_children_preserves_context_and_nested_order() -> Bool:
	src = fixture_source_file()
	span = span_between(src, 0, 1)
	literal_one: ParsedExpr = ParsedIntLiteralExpr("1", span)
	literal_two: ParsedExpr = ParsedIntLiteralExpr("2", span)
	literal_three: ParsedExpr = ParsedIntLiteralExpr("3", span)
	literal_four: ParsedExpr = ParsedIntLiteralExpr("4", span)
	root: ParsedExpr = ParsedListExpr(
		[
			literal_one,
			ParsedCallExpr(literal_two, [literal_three], span),
			ParsedAscriptionExpr(literal_four, ParsedMissingType(span), span),
		],
		span,
	)

	(
		collect_literal_children([], root, "leaf-") == ["leaf-1", "leaf-2", "leaf-3", "leaf-4"]
		and fold_parsed_expr_children(literal_one, ["unchanged"], "ignored", collect_literal_children)
			== ["unchanged"]
	)


-- The `z` -> `ease_out_quart` shape: the identifier's id names a different
-- spelling in the table than the identifier's own text.
pure func dumped_identifier_text(spellings: IdentifierSpellings) -> String:
	src: SourceFile = fixture_source_file()
	identifier: ParsedIdentifier = parsed_identifier(
		name_id_from_interned_index(0),
		"z",
		span_between(src, 5, 9),
	)

	parsed_identifier_to_json(ast_json_render(src, spellings), identifier).to_string()


pure func test_dumped_identifier_reads_its_spelling_from_the_table_for_a_discovery_graph() -> Bool:
	(table, _) = name_table_intern(EMPTY_NAME_TABLE, "from_table")

	dumped_identifier_text(SpellingsFromNameTable(table)).contains("\"text\":\"from_table\"")


pure func test_dumped_identifier_reads_its_text_for_a_standalone_graph() -> Bool:
	dumped_identifier_text(SpellingsFromIdentifierText).contains("\"text\":\"z\"")


tests: TestSuite = {
	description = "Compiler parsed AST foundation",
	tests = [
		(
			"dumped identifier reads its spelling from the table for a discovery graph",
			test_dumped_identifier_reads_its_spelling_from_the_table_for_a_discovery_graph,
		),
		(
			"dumped identifier reads its text for a standalone graph",
			test_dumped_identifier_reads_its_text_for_a_standalone_graph,
		),
		("parsed program phase names round trip", test_parsed_program_phase_names_round_trip),
		("parsed program without diagnostics is ok", test_parsed_program_without_diagnostics_is_ok),
		("parsed program with error is not ok", test_parsed_program_with_error_is_not_ok),
		(
			"parsed program JSON includes source decl and diagnostics",
			test_parsed_program_json_includes_source_decl_and_diagnostics,
		),
		(
			"parsed program JSON includes ascription expr",
			test_parsed_program_json_includes_ascription_expr,
		),
		(
			"parsed program JSON includes char literal expr",
			test_parsed_program_json_includes_char_literal_expr,
		),
		(
			"parsed program JSON includes rich patterns",
			test_parsed_program_json_includes_rich_patterns,
		),
		(
