func test_concurrent_task_labels_are_not_ordinary_assignment_reads() -> Bool:
	src = source()
	common_span = span(src, 0, 5)
	label = parsed_identifier("task_label", common_span)
	value = ParsedNameExpr(parsed_identifier("source", common_span))
	ordinary = ParsedAssignExpr(label, value, common_span)
	concurrent_expr = ParsedConcurrentBlockExpr(
		[],
		ParsedBlockExpr([ordinary], common_span),
		common_span,
	)
	legacy_ordinary = parsed_expr_free_identifier_references(ordinary)
	legacy_concurrent = parsed_expr_free_identifier_references(concurrent_expr)

	match (
		compact_expression_oracle_from_parsed_roots(
			src,
			[ordinary, concurrent_expr],
		)
	):
		Ok(product):
			compact = compact_expression_oracle_free_identifier_references(product)
			(
				legacy_ordinary.map(func(reference): reference.name) == ["task_label", "source"]
				and legacy_concurrent.map(func(reference): reference.name) == ["source"]
				and compact.map(
					func(reference): reference.name,
				) == ["task_label", "source", "source"]
			)
		Err(_):
			False


