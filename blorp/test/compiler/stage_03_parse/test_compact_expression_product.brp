	roots = callable_roots(src).concat([
		ParsedNameExpr(parsed_identifier("shadow", common_span)),
		ParsedNameExpr(parsed_identifier("nested", common_span)),
	])
	legacy = roots.flat_map(func(root): parsed_expr_free_identifier_references(root))

	match compact_expression_oracle_from_parsed_roots(src, roots):
		Ok(product):
			compact = compact_expression_oracle_free_identifier_references(product)
			(
				reference_lists_equal(legacy, compact)
				and compact.map(
					func(reference): reference.name,
				) == ["consume", "outside", "shadow", "nested"]
			)
		Err(_):
			False


