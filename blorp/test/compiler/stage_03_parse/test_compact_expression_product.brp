pure func source() -> SourceFile:
	source_file("compact.brp", "compact", "alpha beta gamma delta 123 4.5 raw text")


pure func span(src: SourceFile, start: Int, end: Int) -> SourceLocation:
	source_location_for_file(
		src,
		source_cursor_at(src, start),
		source_cursor_at(src, end),
	)


pure func expression_roots(src: SourceFile) -> List[ParsedExpr]:
	alpha = ParsedNameExpr(parsed_identifier("alpha", span(src, 0, 5)))
	beta = ParsedNameExpr(parsed_identifier("beta", span(src, 6, 10)))
	gamma = ParsedNameExpr(parsed_identifier("gamma", span(src, 11, 16)))
	delta = ParsedNameExpr(parsed_identifier("delta", span(src, 17, 22)))

	[
		ParsedIntLiteralExpr(
			"123",
			span(src, 23, 26),
		),
		ParsedFloatLiteralExpr(
			"4.5",
			span(src, 27, 30),
		),
		ParsedStringLiteralExpr(
			"raw",
			ParsedRawStringLiteral,
			span(src, 31, 34),
		),
		ParsedStringInterpolationExpr(
			"{alpha}",
			False,
			span(src, 31, 39),
		),
		ParsedBoolLiteralExpr(
			True,
			span(src, 0, 5),
		),
		ParsedCharLiteralExpr(
			97,
			span(src, 0, 5),
		),
		ParsedVoidExpr(span(src, 0, 5)),
		ParsedBuiltinExpr(
			Some("demo_builtin"),
			span(src, 0, 5),
		),
		ParsedBuiltinExpr(
			None,
			span(src, 0, 5),
		),
		ParsedBreakExpr(span(src, 0, 5)),
		ParsedContinueExpr(span(src, 0, 5)),
		ParsedUnaryExpr(
			ParsedNegateOp,
			alpha,
			span(src, 0, 5),
		),
		ParsedLogicalExpr(
			ParsedOrOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedSubtractOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedDivideOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedModuloOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedEqualOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedNotEqualOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedLessOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedLessEqualOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedGreaterOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedGreaterEqualOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedMissingExpr(span(src, 5, 5)),
		ParsedCallExpr(
			alpha,
			[ParsedBinaryExpr(
					ParsedAddOp,
					ParsedUnaryExpr(
						ParsedNotOp,
						beta,
						span(src, 6, 10),
					),
					ParsedBinaryExpr(
						ParsedMultiplyOp,
						gamma,
						ParsedIntLiteralExpr(
							"123",
							span(src, 23, 26),
						),
						span(src, 11, 26),
					),
					span(src, 6, 26),
				), ParsedLogicalExpr(
					ParsedAndOp,
					delta,
					alpha,
					span(src, 0, 22),
				)],
			span(
				src,
				0,
				26,
			),
		),
	]


pure func collections_access_roots(src: SourceFile) -> List[ParsedExpr]:
	alpha = ParsedNameExpr(parsed_identifier("alpha", span(src, 0, 5)))
	beta = ParsedNameExpr(parsed_identifier("beta", span(src, 6, 10)))
	gamma = ParsedNameExpr(parsed_identifier("gamma", span(src, 11, 16)))
	delta = ParsedNameExpr(parsed_identifier("delta", span(src, 17, 22)))
	first_field: ParsedRecordExprField = {
		name = parsed_identifier(
			"beta",
			span(src, 6, 10),
		),
		value = alpha,
		span = span(src, 0, 10)
	}
	repeated_field: ParsedRecordExprField = {
		name = parsed_identifier(
			"beta",
			span(src, 6, 10),
		),
		value = gamma,
		span = span(src, 6, 16)
	}
	first_entry: ParsedDictEntry = {
		key = ParsedListExpr(
			[alpha, beta],
			span(
				src,
				0,
				10,
			),
		),
		value = ParsedTupleExpr(
			[gamma, delta],
			span(
				src,
				11,
				22,
			),
		),
		span = span(src, 0, 22)
	}
	second_entry: ParsedDictEntry = {
		key = ParsedFieldAccessExpr(
			alpha,
			parsed_identifier(
				"beta",
				span(src, 6, 10),
			),
			span(src, 0, 10),
		),
		value = ParsedSubscriptExpr(
			alpha,
			[beta, gamma],
			span(
				src,
				0,
				16,
			),
		),
		span = span(src, 0, 16)
	}

	[
		ParsedFieldAccessExpr(
			alpha,
			parsed_identifier(
				"beta",
				span(src, 6, 10),
			),
			span(src, 0, 10),
		),
		ParsedFieldAccessExpr(
			ParsedFieldAccessExpr(
				alpha,
				parsed_identifier(
					"beta",
					span(src, 6, 10),
				),
				span(src, 0, 10),
			),
			parsed_identifier(
				"gamma",
				span(src, 11, 16),
			),
			span(src, 0, 16),
		),
		ParsedFieldAccessExpr(
			ParsedCallExpr(
				alpha,
				[beta],
				span(src, 0, 10),
			),
			parsed_identifier(
				"gamma",
				span(src, 11, 16),
			),
			span(src, 0, 16),
		),
		ParsedFieldAccessExpr(
			ParsedSubscriptExpr(
				alpha,
				[beta, gamma],
				span(
					src,
					0,
					16,
				),
			),
			parsed_identifier(
				"delta",
				span(src, 17, 22),
			),
			span(
				src,
				0,
				22,
			),
		),
		ParsedSubscriptExpr(
			alpha,
			[beta, gamma],
			span(
				src,
				0,
				16,
			),
		),
		ParsedListExpr(
			[],
			span(src, 0, 0),
		),
		ParsedListExpr(
			[alpha, beta, alpha],
			span(
				src,
				0,
				10,
			),
		),
		ParsedTupleExpr(
			[],
			span(src, 0, 0),
		),
		ParsedTupleExpr(
			[alpha, beta],
			span(
				src,
				0,
				10,
			),
		),
		ParsedRecordExpr(
			[],
			span(src, 0, 0),
		),
		ParsedRecordExpr(
			[first_field, repeated_field],
			span(
				src,
				0,
				16,
			),
		),
		ParsedRecordUpdateExpr(
			alpha,
			[first_field, repeated_field],
			span(
				src,
				0,
				16,
			),
		),
		ParsedDictExpr(
			[],
			span(src, 0, 0),
		),
		ParsedDictExpr(
			[first_entry, second_entry],
			span(
				src,
				0,
				22,
			),
		),
		ParsedVectorExpr(
			[],
			span(src, 0, 0),
		),
		ParsedVectorExpr(
			[alpha, beta, gamma],
			span(
				src,
				0,
				16,
			),
		),
	]


pure func expressions_equal(left: ParsedExpr, right: ParsedExpr) -> Bool:
	match left:
		ParsedNameExpr(left_name):
			match right:
				ParsedNameExpr(right_name):
					left_name.text == right_name.text and left_name.span == right_name.span
				_:
					False
		ParsedIntLiteralExpr(left_text, left_span):
			match right:
				ParsedIntLiteralExpr(right_text, right_span):
					left_text == right_text and left_span == right_span
				_:
					False
		ParsedFloatLiteralExpr(left_text, left_span):
			match right:
				ParsedFloatLiteralExpr(right_text, right_span):
					left_text == right_text and left_span == right_span
				_:
					False
		ParsedStringLiteralExpr(left_text, left_form, left_span):
			match right:
				ParsedStringLiteralExpr(right_text, right_form, right_span):
					left_text == right_text and left_form == right_form and left_span == right_span
				_:
					False
		ParsedStringInterpolationExpr(left_text, left_multiline, left_span):
			match right:
				ParsedStringInterpolationExpr(right_text, right_multiline, right_span):
					(
						left_text == right_text
						and left_multiline == right_multiline
						and left_span == right_span
					)
				_:
					False
		ParsedBoolLiteralExpr(left_value, left_span):
			match right:
				ParsedBoolLiteralExpr(right_value, right_span):
					left_value == right_value and left_span == right_span
				_:
					False
		ParsedCharLiteralExpr(left_value, left_span):
			match right:
				ParsedCharLiteralExpr(right_value, right_span):
					left_value == right_value and left_span == right_span
				_:
					False
		ParsedUnaryExpr(left_op, left_value, left_span):
			match right:
				ParsedUnaryExpr(right_op, right_value, right_span):
					(
						left_op == right_op
						and expressions_equal(left_value, right_value)
						and left_span == right_span
					)
				_:
					False
		ParsedBinaryExpr(left_op, left_lhs, left_rhs, left_span):
			match right:
				ParsedBinaryExpr(right_op, right_lhs, right_rhs, right_span):
					(
						left_op == right_op
						and expressions_equal(left_lhs, right_lhs)
						and expressions_equal(left_rhs, right_rhs)
						and left_span == right_span
					)
				_:
					False
		ParsedLogicalExpr(left_op, left_lhs, left_rhs, left_span):
			match right:
				ParsedLogicalExpr(right_op, right_lhs, right_rhs, right_span):
					(
						left_op == right_op
						and expressions_equal(left_lhs, right_lhs)
						and expressions_equal(left_rhs, right_rhs)
						and left_span == right_span
					)
				_:
					False
		ParsedCallExpr(left_callee, left_args, left_span):
			match right:
				ParsedCallExpr(right_callee, right_args, right_span):
					var equal = left_args.length() == right_args.length()
					var index: Int = 0

					while index < left_args.length() and equal:
						equal = expressions_equal(
							left_args
								.get(index)
								.get_or(ParsedMissingExpr(left_span)),
							right_args
								.get(index)
								.get_or(ParsedMissingExpr(right_span)),
						)
						index += 1

					(
						expressions_equal(left_callee, right_callee)
						and equal
						and left_span == right_span
					)
				_:
					False
		ParsedFieldAccessExpr(left_target, left_field, left_span):
			match right:
				ParsedFieldAccessExpr(right_target, right_field, right_span):
					(
						expressions_equal(left_target, right_target)
						and left_field.text == right_field.text
						and left_field.span == right_field.span
						and left_span == right_span
					)
				_:
					False
		ParsedSubscriptExpr(left_target, left_indices, left_span):
			match right:
				ParsedSubscriptExpr(right_target, right_indices, right_span):
					(
						expressions_equal(left_target, right_target)
						and expression_lists_equal(left_indices, right_indices)
						and left_span == right_span
					)
				_:
					False
		ParsedListExpr(left_items, left_span):
			match right:
				ParsedListExpr(right_items, right_span):
					expression_lists_equal(left_items, right_items) and left_span == right_span
				_:
					False
		ParsedTupleExpr(left_items, left_span):
			match right:
				ParsedTupleExpr(right_items, right_span):
					expression_lists_equal(left_items, right_items) and left_span == right_span
				_:
					False
		ParsedRecordExpr(left_fields, left_span):
			match right:
				ParsedRecordExpr(right_fields, right_span):
					record_fields_equal(left_fields, right_fields) and left_span == right_span
				_:
					False
		ParsedRecordUpdateExpr(left_base, left_fields, left_span):
			match right:
				ParsedRecordUpdateExpr(right_base, right_fields, right_span):
					(
						expressions_equal(left_base, right_base)
						and record_fields_equal(left_fields, right_fields)
						and left_span == right_span
					)
				_:
					False
		ParsedDictExpr(left_entries, left_span):
			match right:
				ParsedDictExpr(right_entries, right_span):
					dict_entries_equal(left_entries, right_entries) and left_span == right_span
				_:
					False
		ParsedVectorExpr(left_items, left_span):
			match right:
				ParsedVectorExpr(right_items, right_span):
					expression_lists_equal(left_items, right_items) and left_span == right_span
				_:
					False
		ParsedVoidExpr(left_span):
			match right:
				ParsedVoidExpr(right_span):
					left_span == right_span
				_:
					False
		ParsedBreakExpr(left_span):
			match right:
				ParsedBreakExpr(right_span):
					left_span == right_span
				_:
					False
		ParsedContinueExpr(left_span):
			match right:
				ParsedContinueExpr(right_span):
					left_span == right_span
				_:
					False
		ParsedBuiltinExpr(left_name, left_span):
			match right:
				ParsedBuiltinExpr(right_name, right_span):
					left_name == right_name and left_span == right_span
				_:
					False
		ParsedMissingExpr(left_span):
			match right:
				ParsedMissingExpr(right_span):
					left_span == right_span
				_:
					False
		_:
			False


pure func expression_lists_equal(left: List[ParsedExpr], right: List[ParsedExpr]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_value), Some(right_value)):
					equal = expressions_equal(left_value, right_value)
				_:
					equal = False

			index += 1

		equal


pure func record_fields_equal(
	left: List[ParsedRecordExprField],
	right: List[ParsedRecordExprField],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_field), Some(right_field)):
					equal = (
						left_field.name.text == right_field.name.text
						and left_field.name.span == right_field.name.span
						and expressions_equal(left_field.value, right_field.value)
						and left_field.span == right_field.span
					)
				_:
					equal = False

			index += 1

		equal


pure func dict_entries_equal(left: List[ParsedDictEntry], right: List[ParsedDictEntry]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_entry), Some(right_entry)):
					equal = (
						expressions_equal(left_entry.key, right_entry.key)
						and expressions_equal(left_entry.value, right_entry.value)
						and left_entry.span == right_entry.span
					)
				_:
					equal = False

			index += 1

		equal


pure func reference_lists_equal(
	left: List[IdentifierReference],
	right: List[IdentifierReference],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			left_reference = left.get(index)
			right_reference = right.get(index)

			match left_reference:
				Some(left_value):
					match right_reference:
						Some(right_value):
							equal = (
								left_value.name == right_value.name
								and left_value.qualified_member == right_value.qualified_member
								and left_value.span == right_value.span
							)
						None:
							equal = False
				None:
					equal = False

			index += 1

		equal


record ReferenceLifetimeOutputs {
	legacy: List[IdentifierReference],
	compact: List[IdentifierReference]
}


pure func reference_outputs_after_all_inputs_release() -> ReferenceLifetimeOutputs:
	src = source()
	dynamic_name = src.text.substring(0, 5)
	expr = ParsedCallExpr(
		ParsedNameExpr(parsed_identifier(dynamic_name, span(src, 0, 5))),
		[
			ParsedNameExpr(parsed_identifier("beta", span(src, 6, 10))),
			ParsedNameExpr(parsed_identifier(dynamic_name, span(src, 0, 5))),
		],
		span(
			src,
			0,
			10,
		),
	)
	legacy = parsed_expr_free_identifier_references(expr)

	match compact_expression_oracle_from_parsed_roots(src, [expr]):
		Ok(product):
			{
				legacy = legacy,
				compact = compact_expression_oracle_free_identifier_references(product)
			}
		Err(_):
			{
				legacy = legacy,
				compact = []
			}


func test_scalar_operator_call_family_round_trips_exactly() -> Bool:
	src = source()
	roots = expression_roots(src)

	match compact_expression_oracle_from_parsed_roots(src, roots):
		Ok(product):
			match compact_expression_oracle_project(product):
				Ok(projected):
					var equal = projected.length() == roots.length()
					var index: Int = 0

					while index < roots.length() and equal:
						equal = expressions_equal(
							roots
								.get(index)
								.get_or(ParsedMissingExpr(span(src, 0, 0))),
							projected
								.get(index)
								.get_or(ParsedMissingExpr(span(src, 0, 0))),
						)
						index += 1

					equal
				Err(_):
					False
		Err(_):
			False


func test_collections_access_family_round_trips_exactly() -> Bool:
	src = source()
	roots = collections_access_roots(src)

	match compact_expression_oracle_from_parsed_roots(src, roots):
		Ok(product):
			match compact_expression_oracle_project(product):
				Ok(projected):
					expression_lists_equal(roots, projected)
				Err(_):
					False
		Err(_):
			False


func test_collections_access_reference_order_matches_production_consumer() -> Bool:
	src = source()
	roots = collections_access_roots(src)
	var legacy: List[IdentifierReference] = []

	for root in roots:
		legacy = legacy.concat(parsed_expr_free_identifier_references(root))

	match compact_expression_oracle_from_parsed_roots(src, roots):
		Ok(product):
			compact = compact_expression_oracle_free_identifier_references(product)
			first_references = compact
				.map(func(reference):
					reference.name + ":" + reference.qualified_member.get_or("-")
				)
				.take(9)
			(
				reference_lists_equal(legacy, compact)
				and first_references == [
					"alpha:beta",
					"alpha:beta",
					"alpha:-",
					"beta:-",
					"alpha:-",
					"beta:-",
					"gamma:-",
					"alpha:-",
					"beta:-",
				]
			)
		Err(_):
			False


func test_direct_reference_oracle_preserves_order_duplicates_and_lifetime() -> Bool:
	outputs = reference_outputs_after_all_inputs_release()
	name_offsets = outputs.compact.map(func(reference):
		reference.name + ":" + source_location_start_offset(reference.span).to_string()
	)

	(
		reference_lists_equal(outputs.legacy, outputs.compact)
		and name_offsets == ["alpha:0", "beta:6", "alpha:0"]
	)


func test_unsupported_form_is_rejected_explicitly() -> Bool:
	src = source()

	match compact_expression_oracle_from_parsed_roots(src, [ParsedRangeExpr(
				ParsedNameExpr(parsed_identifier("alpha", span(src, 0, 5))),
				ParsedNameExpr(parsed_identifier("beta", span(src, 6, 10))),
				span(src, 0, 10),
			)]):
		Err(UnsupportedCompactExpressionOracleForm):
			True
		_:
			False


func test_validator_rejects_corrupt_products() -> Bool:
	src = source()
	probes = [
		CompactChildIdOutOfRange,
		CompactChildSliceOverlap,
		CompactDuplicateRoot,
		CompactForeignSourceOwner,
		CompactNodeBackEdge,
		CompactNegativeCallArity,
		CompactOrphanNode,
		CompactOrphanPayload,
		CompactPayloadFamilyMismatch,
		CompactSharedChild,
		CompactTextIndexAlias,
		CompactWrongArity,
		CompactMetadataSliceAlias,
		CompactAbsurdMetadataCount,
	]
	var rejected = True

	for probe in probes:
		rejected = rejected and compact_expression_oracle_rejects_corruption(src, probe)

	rejected


func test_empty_and_small_layout_counts_are_explicit() -> Bool:
	src = source()

	match compact_expression_oracle_from_parsed_roots(src, []):
		Ok(empty_product):
			empty_counts = compact_expression_oracle_counts(empty_product)

			match compact_expression_oracle_from_parsed_roots(
				src,
				[ParsedNameExpr(parsed_identifier("alpha", span(src, 0, 5)))],
			):
				Ok(scalar_product):
					scalar_counts = compact_expression_oracle_counts(scalar_product)

					match compact_expression_oracle_from_parsed_roots(src, [ParsedBinaryExpr(
								ParsedAddOp,
								ParsedNameExpr(parsed_identifier("alpha", span(src, 0, 5))),
								ParsedNameExpr(parsed_identifier("beta", span(src, 6, 10))),
								span(src, 0, 10),
							)]):
						Ok(binary_product):
							binary_counts = compact_expression_oracle_counts(binary_product)
							(
								empty_counts.source_owner_count == 1
								and empty_counts.node_count == 0
								and empty_counts.child_count == 0
								and empty_counts.root_count == 0
								and scalar_counts.source_owner_count == 1
								and scalar_counts.node_count == 1
								and scalar_counts.child_count == 0
								and scalar_counts.text_payload_count == 1
								and scalar_counts.root_count == 1
								and binary_counts.source_owner_count == 1
								and binary_counts.node_count == 3
								and binary_counts.child_count == 2
								and binary_counts.text_payload_count == 2
								and binary_counts.operator_payload_count == 1
								and binary_counts.root_count == 1
								and size_of(empty_product) > 0
								and size_of(scalar_product) >= size_of(empty_product)
								and size_of(binary_product) >= size_of(scalar_product)
							)
						Err(_):
							False
				Err(_):
					False
		Err(_):
			False


func test_collection_metadata_counts_are_explicit() -> Bool:
	src = source()

	match compact_expression_oracle_from_parsed_roots(src, collections_access_roots(src)):
		Ok(product):
			counts = compact_expression_oracle_counts(product)
			(
				counts.field_access_payload_count == 6
				and counts.record_payload_count == 3
				and counts.record_field_count == 4
				and counts.dict_payload_count == 2
				and counts.dict_entry_count == 2
				and counts.root_count == 16
			)
		Err(_):
			False


tests: TestSuite = {
	description = "Compact expression product schema oracle",
	tests = [
		(
			"scalar/operator/call family round trips exactly",
			test_scalar_operator_call_family_round_trips_exactly,
		),
		(
			"collections/access family round trips exactly",
			test_collections_access_family_round_trips_exactly,
		),
		(
			"collections/access reference order matches production consumer",
			test_collections_access_reference_order_matches_production_consumer,
		),
		(
			"direct reference oracle preserves order duplicates and lifetime",
			test_direct_reference_oracle_preserves_order_duplicates_and_lifetime,
		),
		("validator rejects corrupt products", test_validator_rejects_corrupt_products),
		("unsupported form is rejected explicitly", test_unsupported_form_is_rejected_explicitly),
		(
			"empty and small layout counts are explicit",
			test_empty_and_small_layout_counts_are_explicit,
		),
		("collection metadata counts are explicit", test_collection_metadata_counts_are_explicit),
	]
}
