func test_concurrency_real_parser_and_recovery_round_trip_exactly() -> Bool:
	program_text = "func run(items: List[Int]):\n\tconcurrent(max_threads: 4, timeout: 5000):\n\t\tfirst = launch()\n\t\tvar second = launch()\n\tfor item in items concurrently(limit: 2, timeout: 5000):\n\t\tconsume(item)\n\tdetach launch()"
	program_source = source_file("concurrency.brp", "concurrency", program_text)
	recovery_text = "func run():\n\tconcurrent(timeout: ):\n\t\tdetach"
	recovery_source = source_file("concurrency_recovery.brp", "concurrency_recovery", recovery_text)
	recovery_program = parse_compiler_source(recovery_source)

	match (
		first_function_body(parse_compiler_source(program_source)),
		first_function_body(recovery_program),
		recovery_program.diagnostics.get(0),
		recovery_program.diagnostics.get(1),
	):
		(Some(body), Some(recovery_body), Some(first_diagnostic), Some(second_diagnostic)):
			match compact_expression_oracle_from_parsed_roots(program_source, [body]):
				Ok(product):
					match compact_expression_oracle_project(product):
						Ok([projected]):
							match compact_expression_oracle_from_parsed_roots(
								recovery_source,
								[recovery_body],
							):
								Ok(recovery_product):
									match compact_expression_oracle_project(recovery_product):
										Ok([projected_recovery]):
											(
												expressions_equal(body, projected)
												and expressions_equal(
													recovery_body,
													projected_recovery,
												)
												and recovery_program.diagnostics.length() == 2
												and first_diagnostic.message == "expected expression"
												and first_diagnostic.expected == ["expression"]
												and first_diagnostic.help == None
												and source_span_text(
													recovery_source,
													first_diagnostic.span,
												) == ")"
												and second_diagnostic.message == "expected expression"
												and second_diagnostic.expected == ["expression"]
												and second_diagnostic.help == None
												and second_diagnostic.span.start_offset == recovery_text.length()
												and second_diagnostic.span.end_offset == recovery_text.length()
											)
										_:
											False
								Err(_):
									False
						_:
							False
				Err(_):
					False
		_:
			False


