pure func wide_scope_root(src: SourceFile, binding_count: Int) -> ParsedExpr:
	var items: List[ParsedExpr] = []
	var index: Int = 0
	shared_span = span(src, 0, 5)

	while index < binding_count:
		items = items.append(
			ParsedVarDeclExpr(
				parsed_identifier("local" + index.to_string(), shared_span),
				None,
				ParsedNameExpr(parsed_identifier("seed", shared_span)),
				False,
				shared_span,
			),
		)
		index += 1

	index = 0

	while index < binding_count:
		items = items.append(ParsedNameExpr(parsed_identifier("local0", shared_span)))
		index += 1

	ParsedBlockExpr(items, shared_span)


pure func baseline_wide_scope_comparison_count(binding_count: Int) -> Int:
	var count: Int = 0
	var bound_count: Int = 0

	while bound_count < binding_count:
		-- Each unbound initializer scans all names already introduced by earlier
		-- statements, matching the current List.contains baseline.
		count += bound_count
		bound_count += 1

	-- Repeated references to the first binding each stop after one comparison.
	count + binding_count


func test_wide_scope_reference_work_matches_baseline() -> Bool:
	src = source()
	binding_count: Int = 64
	root = wide_scope_root(src, binding_count)
	legacy = parsed_expr_free_identifier_references(root)

	match compact_expression_oracle_from_parsed_roots(src, [root]):
		Ok(product):
			compact = compact_expression_oracle_free_identifier_references(product)
			counts = compact_expression_oracle_reference_traversal_counts(product)
			(
				reference_lists_equal(legacy, compact)
				and counts.reference_count == binding_count
				and counts.bound_name_comparison_count == baseline_wide_scope_comparison_count(
					binding_count,
				)
			)
		Err(_):
			False


func test_interpolation_comparison_detects_nested_field_changes() -> Bool:
	src = source()
	original = nested_field_interpolation(
		src,
		parsed_identifier(
			"alpha",
			span(src, 0, 5),
		),
		parsed_identifier(
			"beta",
			span(src, 6, 10),
		),
		span(src, 0, 10),
	)
	changed_name = nested_field_interpolation(
		src,
		parsed_identifier(
			"alpha",
			span(src, 0, 5),
		),
		parsed_identifier(
			"gamma",
			span(src, 6, 10),
		),
		span(src, 0, 10),
	)
	changed_target_span = nested_field_interpolation(
		src,
		parsed_identifier(
			"alpha",
			span(src, 0, 4),
		),
		parsed_identifier(
			"beta",
			span(src, 6, 10),
		),
		span(src, 0, 10),
	)
	changed_field_span = nested_field_interpolation(
		src,
		parsed_identifier(
			"alpha",
			span(src, 0, 5),
		),
		parsed_identifier(
			"beta",
			span(src, 6, 9),
		),
		span(src, 0, 10),
	)
	changed_access_span = nested_field_interpolation(
		src,
		parsed_identifier(
			"alpha",
			span(src, 0, 5),
		),
		parsed_identifier(
			"beta",
			span(src, 6, 10),
		),
		span(src, 0, 9),
	)

	match compact_expression_oracle_from_parsed_roots(src, [original]):
		Ok(product):
			match compact_expression_oracle_project(product):
				Ok([projected]):
					(
						expressions_equal(original, projected)
						and not expressions_equal(changed_name, projected)
						and not expressions_equal(changed_target_span, projected)
						and not expressions_equal(changed_field_span, projected)
						and not expressions_equal(changed_access_span, projected)
					)
				_:
					False
		Err(_):
			False


pure func first_function_body(program: ParsedProgram) -> Option[ParsedExpr]:
	match program.decls:
		[FunctionParsedDecl(decl)]:
			decl.body
		_:
			None


func test_finalized_interpolation_preserves_authored_rebased_provenance() -> Bool:
	program_text = "func message(name: String): \"prefix " + "$" + "{name}" + "$" + "{name}\""
	program_source = source_file("interpolation.brp", "interpolation", program_text)
	program = finalize_interpolation_program(parse_compiler_source(program_source))

	match first_function_body(program):
		Some(body):
			match compact_expression_oracle_from_parsed_roots(program.source, [body]):
				Ok(product):
					counts = compact_expression_oracle_counts(product)

					match compact_expression_oracle_project(product):
						Ok([projected]):
							legacy_refs = parsed_expr_free_identifier_references(body)
							compact_refs = compact_expression_oracle_free_identifier_references(
								product,
							)
							(
								expressions_equal(body, projected)
								and reference_lists_equal(legacy_refs, compact_refs)
								and compact_refs.map(func(reference):
									reference.name + ":" + source_location_start_offset(
										reference.span,
									).to_string()
								) == ["name:38", "name:45"]
								and counts.source_owner_count == 1
							)
						_:
							False
				Err(_):
					False
		None:
			False


