func test_validator_rejects_corrupt_products() -> Bool:
	src = source()
	probes = [
		CompactChildIdOutOfRange,
		CompactChildSliceOverlap,
		CompactDuplicateRoot,
		CompactForeignSourceOwner,
		CompactNodeBackEdge,
		CompactNegativeCallArity,
		CompactOrphanNode,
		CompactOrphanPayload,
		CompactPayloadFamilyMismatch,
		CompactSharedChild,
		CompactTextIndexAlias,
		CompactWrongArity,
		CompactMetadataSliceAlias,
		CompactAbsurdMetadataCount,
		CompactTypePayloadFamilyMismatch,
		CompactInterpolationPartOrdinalAlias,
		CompactAbsurdInterpolationPartCount,
		CompactControlIdentifierAlias,
		CompactTypedBinderTypeRootOutOfRange,
		CompactTypedBinderInvalidAbsentTypeRoot,
		CompactTypedBinderSharedTypeRoot,
		CompactForBinderSliceOutOfRange,
		CompactForBinderSliceAlias,
		CompactIdentifierSliceForeignSourceOwner,
		CompactPatternChildBackEdge,
		CompactPatternSharedChild,
		CompactPatternOrphanNode,
		CompactPatternPayloadFamilyMismatch,
		CompactPatternIdentifierSliceAlias,
		CompactPatternIdentifierSliceOutOfRange,
		CompactPatternIdentifierSliceForeignSourceOwner,
		CompactPatternRootAlias,
		CompactMatchCaseBindingCountMismatch,
		CompactSelectArmBinderMismatch,
		CompactSelectArmUnexpectedBinder,
		CompactSelectArmSliceAlias,
		CompactSelectArmForeignSourceOwner,
		CompactWithBindingAlias,
		CompactWithPlainBindingHasErrorMap,
		CompactWithTypeRootOutOfRange,
		CompactWithErrorMapOutOfRange,
		CompactWithErrorMapAlias,
		CompactWithErrorMapForeignSourceOwner,
		CompactWithWrongArity,
		CompactWithOrphanErrorMap,
		CompactLambdaPayloadAlias,
		CompactLambdaSharedTypeRoot,
		CompactFunctionPayloadAlias,
		CompactCallableParamSliceAlias,
		CompactCallableWildcardNonemptySlice,
		CompactCallableParamTypeRootOutOfRange,
		CompactCallableTypeParamBoundsAlias,
		CompactCallableDimTypeRootAlias,
		CompactFunctionAnnotationSliceAlias,
		CompactFunctionKeywordForeignSourceOwner,
		CompactFunctionAbsentKeywordLocation,
		CompactFunctionDocTextOutOfRange,
		CompactFunctionWrongArity,
		CompactFunctionOrphanAnnotation,
		CompactConcurrentParamSliceAlias,
		CompactConcurrentOrphanParam,
		CompactConcurrentParamForeignSourceOwner,
		CompactConcurrentParamIdentifierAlias,
		CompactConcurrentForPayloadAlias,
		CompactConcurrentForOrphanPayload,
		CompactConcurrentForBinderAlias,
		CompactConcurrentBlockWrongArity,
		CompactConcurrentForWrongArity,
		CompactDetachWrongArity,
		CompactConcurrentPayloadFamilyMismatch,
	]
	var rejected = True

	for probe in probes:
		rejected = rejected and compact_expression_oracle_rejects_corruption(src, probe)

	rejected


func test_empty_and_small_layout_counts_are_explicit() -> Bool:
	src = source()

	match compact_expression_oracle_from_parsed_roots(src, []):
		Ok(empty_product):
			empty_counts = compact_expression_oracle_counts(empty_product)

			match compact_expression_oracle_from_parsed_roots(
				src,
				[ParsedNameExpr(parsed_identifier("alpha", span(src, 0, 5)))],
			):
				Ok(scalar_product):
					scalar_counts = compact_expression_oracle_counts(scalar_product)

					match compact_expression_oracle_from_parsed_roots(src, [ParsedBinaryExpr(
								ParsedAddOp,
								ParsedNameExpr(parsed_identifier("alpha", span(src, 0, 5))),
								ParsedNameExpr(parsed_identifier("beta", span(src, 6, 10))),
								span(src, 0, 10),
							)]):
						Ok(binary_product):
							binary_counts = compact_expression_oracle_counts(binary_product)
							(
								empty_counts.source_owner_count == 1
								and empty_counts.node_count == 0
								and empty_counts.child_count == 0
								and empty_counts.root_count == 0
								and scalar_counts.source_owner_count == 1
								and scalar_counts.node_count == 1
								and scalar_counts.child_count == 0
								and scalar_counts.text_payload_count == 1
								and scalar_counts.root_count == 1
								and binary_counts.source_owner_count == 1
								and binary_counts.node_count == 3
								and binary_counts.child_count == 2
								and binary_counts.text_payload_count == 2
								and binary_counts.operator_payload_count == 1
								and binary_counts.root_count == 1
								and size_of(empty_product) > 0
								and size_of(scalar_product) >= size_of(empty_product)
								and size_of(binary_product) >= size_of(scalar_product)
							)
						Err(_):
							False
				Err(_):
					False
		Err(_):
			False


