func test_simple_control_scope_matches_production() -> Bool:
	src = source()
	item_outer = parsed_identifier(
		"item",
		span(src, 0, 5),
	)
	item_inner = parsed_identifier(
		"item",
		span(src, 6, 10),
	)
	first_pair = parsed_identifier(
		"pair",
		span(src, 11, 16),
	)
	second_pair = parsed_identifier(
		"pair",
		span(src, 17, 22),
	)
	member = parsed_identifier(
		"member",
		span(src, 23, 26),
	)
	root = ParsedBlockExpr(
		[
			ParsedVarDeclExpr(
				item_outer,
				None,
				ParsedNameExpr(parsed_identifier("seed", span(src, 27, 30))),
				False,
				span(src, 0, 30),
			),
			ParsedForExpr(
				ParsedForNameBinder(item_inner),
				ParsedNameExpr(item_outer),
				ParsedFieldAccessExpr(
					ParsedNameExpr(item_inner),
					member,
					span(src, 6, 26),
				),
				span(src, 0, 26),
			),
			ParsedFieldAccessExpr(
				ParsedNameExpr(item_outer),
				member,
				span(src, 0, 26),
			),
			ParsedFieldAccessExpr(
				ParsedNameExpr(parsed_identifier("outside", span(src, 31, 34))),
				member,
				span(src, 23, 34),
			),
			ParsedForExpr(
				ParsedForTupleBinder(
					[first_pair, second_pair],
					span(
						src,
						10,
						22,
					),
				),
				ParsedNameExpr(parsed_identifier("pairs", span(src, 31, 34))),
				ParsedNameExpr(first_pair),
				span(
					src,
					10,
					34,
				),
			),
			ParsedNameExpr(first_pair),
		],
		span(
			src,
			0,
			34,
		),
	)
	roots = [root, ParsedFieldAccessExpr(
			ParsedNameExpr(item_inner),
			member,
			span(src, 6, 26),
		)]
	var legacy: List[IdentifierReference] = []

	for value in roots:
		legacy = legacy.concat(parsed_expr_free_identifier_references(value))

	match compact_expression_oracle_from_parsed_roots(src, roots):
		Ok(product):
			compact = compact_expression_oracle_free_identifier_references(product)
			encoded = compact.map(func(reference):
				reference.name + ":" + reference.qualified_member.get_or("-")
			)
			(
				reference_lists_equal(legacy, compact)
				and encoded == ["seed:-", "outside:member", "pairs:-", "pair:-", "item:member"]
			)
		Err(_):
			False


