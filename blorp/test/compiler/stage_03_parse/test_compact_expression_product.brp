pure func source() -> SourceFile:
	source_file("compact.brp", "compact", "alpha beta gamma delta 123 4.5 raw text")


pure func span(src: SourceFile, start: Int, end: Int) -> SourceLocation:
	source_location_for_file(
		src,
		source_cursor_at(src, start),
		source_cursor_at(src, end),
	)


pure func expression_roots(src: SourceFile) -> List[ParsedExpr]:
	alpha = ParsedNameExpr(parsed_identifier("alpha", span(src, 0, 5)))
	beta = ParsedNameExpr(parsed_identifier("beta", span(src, 6, 10)))
	gamma = ParsedNameExpr(parsed_identifier("gamma", span(src, 11, 16)))
	delta = ParsedNameExpr(parsed_identifier("delta", span(src, 17, 22)))

	[
		ParsedIntLiteralExpr(
			"123",
			span(src, 23, 26),
		),
		ParsedFloatLiteralExpr(
			"4.5",
			span(src, 27, 30),
		),
		ParsedStringLiteralExpr(
			"raw",
			ParsedRawStringLiteral,
			span(src, 31, 34),
		),
		ParsedStringInterpolationExpr(
			"{alpha}",
			False,
			span(src, 31, 39),
		),
		ParsedBoolLiteralExpr(
			True,
			span(src, 0, 5),
		),
		ParsedCharLiteralExpr(
			97,
			span(src, 0, 5),
		),
		ParsedVoidExpr(span(src, 0, 5)),
		ParsedBuiltinExpr(
			Some("demo_builtin"),
			span(src, 0, 5),
		),
		ParsedBuiltinExpr(
			None,
			span(src, 0, 5),
		),
		ParsedBreakExpr(span(src, 0, 5)),
		ParsedContinueExpr(span(src, 0, 5)),
		ParsedUnaryExpr(
			ParsedNegateOp,
			alpha,
			span(src, 0, 5),
		),
		ParsedLogicalExpr(
			ParsedOrOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedSubtractOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedDivideOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedModuloOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedEqualOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedNotEqualOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedLessOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedLessEqualOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedGreaterOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedBinaryExpr(
			ParsedGreaterEqualOp,
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedMissingExpr(span(src, 5, 5)),
		ParsedCallExpr(
			alpha,
			[ParsedBinaryExpr(
					ParsedAddOp,
					ParsedUnaryExpr(
						ParsedNotOp,
						beta,
						span(src, 6, 10),
					),
					ParsedBinaryExpr(
						ParsedMultiplyOp,
						gamma,
						ParsedIntLiteralExpr(
							"123",
							span(src, 23, 26),
						),
						span(src, 11, 26),
					),
					span(src, 6, 26),
				), ParsedLogicalExpr(
					ParsedAndOp,
					delta,
					alpha,
					span(src, 0, 22),
				)],
			span(
				src,
				0,
				26,
			),
		),
	]


pure func collections_access_roots(src: SourceFile) -> List[ParsedExpr]:
	alpha = ParsedNameExpr(parsed_identifier("alpha", span(src, 0, 5)))
	beta = ParsedNameExpr(parsed_identifier("beta", span(src, 6, 10)))
	gamma = ParsedNameExpr(parsed_identifier("gamma", span(src, 11, 16)))
	delta = ParsedNameExpr(parsed_identifier("delta", span(src, 17, 22)))
	first_field: ParsedRecordExprField = {
		name = parsed_identifier(
			"beta",
			span(src, 6, 10),
		),
		value = alpha,
		span = span(src, 0, 10)
	}
	repeated_field: ParsedRecordExprField = {
		name = parsed_identifier(
			"beta",
			span(src, 6, 10),
		),
		value = gamma,
		span = span(src, 6, 16)
	}
	first_entry: ParsedDictEntry = {
		key = ParsedListExpr(
			[alpha, beta],
			span(
				src,
				0,
				10,
			),
		),
		value = ParsedTupleExpr(
			[gamma, delta],
			span(
				src,
				11,
				22,
			),
		),
		span = span(src, 0, 22)
	}
	second_entry: ParsedDictEntry = {
		key = ParsedFieldAccessExpr(
			alpha,
			parsed_identifier(
				"beta",
				span(src, 6, 10),
			),
			span(src, 0, 10),
		),
		value = ParsedSubscriptExpr(
			alpha,
			[beta, gamma],
			span(
				src,
				0,
				16,
			),
		),
		span = span(src, 0, 16)
	}

	[
		ParsedFieldAccessExpr(
			alpha,
			parsed_identifier(
				"beta",
				span(src, 6, 10),
			),
			span(src, 0, 10),
		),
		ParsedFieldAccessExpr(
			ParsedFieldAccessExpr(
				alpha,
				parsed_identifier(
					"beta",
					span(src, 6, 10),
				),
				span(src, 0, 10),
			),
			parsed_identifier(
				"gamma",
				span(src, 11, 16),
			),
			span(src, 0, 16),
		),
		ParsedFieldAccessExpr(
			ParsedCallExpr(
				alpha,
				[beta],
				span(src, 0, 10),
			),
			parsed_identifier(
				"gamma",
				span(src, 11, 16),
			),
			span(src, 0, 16),
		),
		ParsedFieldAccessExpr(
			ParsedSubscriptExpr(
				alpha,
				[beta, gamma],
				span(
					src,
					0,
					16,
				),
			),
			parsed_identifier(
				"delta",
				span(src, 17, 22),
			),
			span(
				src,
				0,
				22,
			),
		),
		ParsedSubscriptExpr(
			alpha,
			[beta, gamma],
			span(
				src,
				0,
				16,
			),
		),
		ParsedListExpr(
			[],
			span(src, 0, 0),
		),
		ParsedListExpr(
			[alpha, beta, alpha],
			span(
				src,
				0,
				10,
			),
		),
		ParsedTupleExpr(
			[],
			span(src, 0, 0),
		),
		ParsedTupleExpr(
			[alpha, beta],
			span(
				src,
				0,
				10,
			),
		),
		ParsedRecordExpr(
			[],
			span(src, 0, 0),
		),
		ParsedRecordExpr(
			[first_field, repeated_field],
			span(
				src,
				0,
				16,
			),
		),
		ParsedRecordUpdateExpr(
			alpha,
			[first_field, repeated_field],
			span(
				src,
				0,
				16,
			),
		),
		ParsedDictExpr(
			[],
			span(src, 0, 0),
		),
		ParsedDictExpr(
			[first_entry, second_entry],
			span(
				src,
				0,
				22,
			),
		),
		ParsedVectorExpr(
			[],
			span(src, 0, 0),
		),
		ParsedVectorExpr(
			[alpha, beta, gamma],
			span(
				src,
				0,
				16,
			),
		),
	]


pure func nested_field_interpolation(
	src: SourceFile,
	target: ParsedIdentifier,
	field: ParsedIdentifier,
	access_span: SourceLocation,
) -> ParsedExpr:
	ParsedStringInterpolationPartsExpr(
		[
			ParsedInterpolationLiteral("before"),
			ParsedInterpolationExpr(
				ParsedFieldAccessExpr(
					ParsedNameExpr(target),
					field,
					access_span,
				),
			),
			ParsedInterpolationLiteral("between"),
			ParsedInterpolationExpr(ParsedNameExpr(parsed_identifier("beta", span(src, 6, 10)))),
		],
		False,
		span(
			src,
			0,
			16,
		),
	)


pure func type_bearing_roots(src: SourceFile) -> List[ParsedExpr]:
	alpha = ParsedNameExpr(parsed_identifier("alpha", span(src, 0, 5)))
	beta = ParsedNameExpr(parsed_identifier("beta", span(src, 6, 10)))
	name_int = ParsedNamedType(
		parsed_identifier(
			"Int",
			span(src, 0, 5),
		),
		[],
		span(src, 0, 5),
	)
	dim_name = ParsedDimNameType(
		parsed_identifier(
			"N",
			span(src, 6, 10),
		),
		True,
		span(src, 6, 10),
	)
	dim_literal = ParsedDimLiteralType(
		"4",
		span(src, 11, 16),
	)
	dim_expression = ParsedDimBinaryType(
		ParsedDimDivideOp,
		ParsedDimBinaryType(
			ParsedDimMultiplyOp,
			ParsedDimBinaryType(
				ParsedDimAddOp,
				dim_name,
				dim_literal,
				span(src, 6, 16),
			),
			ParsedDimBinaryType(
				ParsedDimSubtractOp,
				dim_literal,
				dim_name,
				span(src, 6, 16),
			),
			span(src, 6, 16),
		),
		dim_literal,
		span(src, 6, 16),
	)
	array_type = ParsedArrayType(
		name_int,
		[dim_expression, dim_name],
		span(
			src,
			0,
			16,
		),
	)
	qualified_type = ParsedQualifiedNamedType(
		parsed_identifier(
			"alpha",
			span(src, 0, 5),
		),
		parsed_identifier(
			"beta",
			span(src, 6, 10),
		),
		[name_int],
		span(src, 0, 10),
	)
	bounded_type = ParsedBoundedType(
		parsed_identifier(
			"gamma",
			span(src, 11, 16),
		),
		[parsed_identifier(
				"alpha",
				span(src, 0, 5),
			), parsed_identifier(
				"beta",
				span(src, 6, 10),
			)],
		span(
			src,
			0,
			16,
		),
	)
	tuple_type = ParsedTupleType(
		[array_type, ParsedRangeType(
				name_int,
				span(src, 0, 5),
			), ParsedMissingType(span(src, 16, 16))],
		span(
			src,
			0,
			16,
		),
	)
	function_type = ParsedFunctionType(
		True,
		[tuple_type, qualified_type, bounded_type],
		array_type,
		span(
			src,
			0,
			16,
		),
	)
	interpolation = nested_field_interpolation(
		src,
		parsed_identifier(
			"alpha",
			span(src, 0, 5),
		),
		parsed_identifier(
			"beta",
			span(src, 6, 10),
		),
		span(src, 0, 10),
	)

	[ParsedAscriptionExpr(
			alpha,
			function_type,
			span(src, 0, 16),
		), ParsedRangeExpr(
			alpha,
			beta,
			span(src, 0, 10),
		), ParsedOpaqueIntoExpr(
			qualified_type,
			alpha,
			span(src, 0, 10),
		), ParsedOpaqueFromExpr(
			bounded_type,
			beta,
			span(src, 6, 16),
		), interpolation]


pure func scope_skeleton_roots(src: SourceFile) -> List[ParsedExpr]:
	alpha_identifier = parsed_identifier(
		"alpha",
		span(src, 0, 5),
	)
	beta_identifier = parsed_identifier(
		"beta",
		span(src, 6, 10),
	)
	gamma_identifier = parsed_identifier(
		"gamma",
		span(src, 11, 16),
	)
	delta_identifier = parsed_identifier(
		"delta",
		span(src, 17, 22),
	)
	int_type = ParsedNamedType(
		parsed_identifier(
			"Int",
			span(src, 23, 26),
		),
		[],
		span(src, 23, 26),
	)
	alpha = ParsedNameExpr(alpha_identifier)
	beta = ParsedNameExpr(beta_identifier)
	gamma = ParsedNameExpr(gamma_identifier)
	delta = ParsedNameExpr(delta_identifier)
	block = ParsedBlockExpr(
		[
			ParsedVarDeclExpr(
				alpha_identifier,
				None,
				beta,
				False,
				span(src, 0, 10),
			),
			ParsedVarDeclExpr(
				beta_identifier,
				Some(int_type),
				alpha,
				True,
				span(src, 0, 26),
			),
			ParsedAssignExpr(
				alpha_identifier,
				gamma,
				span(src, 0, 16),
			),
			ParsedCompoundAssignExpr(
				beta_identifier,
				ParsedAssignAddOp,
				delta,
				span(src, 6, 22),
			),
			ParsedCompoundAssignExpr(
				beta_identifier,
				ParsedAssignSubtractOp,
				gamma,
				span(src, 6, 16),
			),
			ParsedCompoundAssignExpr(
				beta_identifier,
				ParsedAssignMultiplyOp,
				delta,
				span(src, 6, 22),
			),
			ParsedCompoundAssignExpr(
				beta_identifier,
				ParsedAssignDivideOp,
				gamma,
				span(src, 6, 16),
			),
			ParsedSubscriptAssignExpr(
				alpha,
				[gamma, beta],
				delta,
				span(
					src,
					0,
					22,
				),
			),
			ParsedTupleDestructExpr(
				[gamma_identifier, delta_identifier],
				alpha,
				span(
					src,
					0,
					22,
				),
			),
			ParsedQuestionBindExpr(
				parsed_identifier(
					"handle",
					span(src, 27, 33),
				),
				Some(int_type),
				ParsedNameExpr(parsed_identifier("outside", span(src, 34, 38))),
				span(src, 27, 38),
			),
			ParsedNameExpr(parsed_identifier("handle", span(src, 27, 33))),
			ParsedFieldAccessExpr(
				gamma,
				beta_identifier,
				span(src, 6, 16),
			),
		],
		span(
			src,
			0,
			38,
		),
	)

	[block, ParsedTupleDestructExpr(
			[],
			alpha,
			span(src, 0, 5),
		), ParsedQuestionBindExpr(
			delta_identifier,
			None,
			gamma,
			span(src, 11, 22),
		)]


pure func simple_control_roots(src: SourceFile) -> List[ParsedExpr]:
	alpha_identifier = parsed_identifier(
		"alpha",
		span(src, 0, 5),
	)
	beta_identifier = parsed_identifier(
		"beta",
		span(src, 6, 10),
	)
	first_gamma = parsed_identifier(
		"gamma",
		span(src, 11, 16),
	)
	second_gamma = parsed_identifier(
		"gamma",
		span(src, 17, 22),
	)
	alpha = ParsedNameExpr(alpha_identifier)
	beta = ParsedNameExpr(beta_identifier)
	gamma = ParsedNameExpr(first_gamma)
	delta = ParsedNameExpr(parsed_identifier("delta", span(src, 17, 22)))

	[
		ParsedIfExpr(
			alpha,
			beta,
			None,
			span(src, 0, 10),
		),
		ParsedIfExpr(
			alpha,
			beta,
			Some(gamma),
			span(src, 0, 16),
		),
		ParsedDebugBlockExpr(
			delta,
			span(src, 17, 22),
		),
		ParsedWhileExpr(
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedForExpr(
			ParsedForNameBinder(beta_identifier),
			alpha,
			beta,
			span(src, 0, 10),
		),
		ParsedForExpr(
			ParsedForTupleBinder(
				[first_gamma, second_gamma],
				span(
					src,
					10,
					22,
				),
			),
			alpha,
			gamma,
			span(
				src,
				0,
				22,
			),
		),
	]


pure func match_pattern_root(src: SourceFile) -> ParsedExpr:
	common_span = span(src, 0, 5)
	name: pure (String) -> ParsedIdentifier = pure func(text):
		parsed_identifier(text, common_span)
	pattern = ParsedTuplePattern(
		[
			ParsedWildcardPattern(common_span),
			ParsedNamePattern(name("bound")),
			ParsedIntPattern("123", common_span),
			ParsedFloatPattern("4.5", common_span),
			ParsedStringPattern("raw", ParsedRawStringLiteral, common_span),
			ParsedCharPattern(97, common_span),
			ParsedBoolPattern(True, common_span),
			ParsedConstructorPattern(name("Some"), [ParsedNamePattern(name("value"))], common_span),
			ParsedQualifiedConstructorPattern(
				name("Result"),
				name("Ok"),
				[ParsedWildcardPattern(common_span)],
				common_span,
			),
			ParsedTuplePattern(
				[ParsedNamePattern(name("tuple_item")), ParsedIntPattern("123", common_span)],
				common_span,
			),
			ParsedListPattern([ParsedNamePattern(name("list_item"))], None, common_span),
			ParsedListPattern(
				[ParsedNamePattern(name("head")), ParsedIntPattern("123", common_span)],
				Some(ParsedListSpreadName(name("tail"))),
				common_span,
			),
			ParsedListPattern(
				[ParsedWildcardPattern(common_span)],
				Some(ParsedListSpreadWildcard(common_span)),
				common_span,
			),
			ParsedOrPattern(
				[ParsedNamePattern(name("choice")), ParsedMissingPattern(common_span)],
				common_span,
			),
			ParsedMissingPattern(common_span),
		],
		common_span,
	)

	ParsedMatchExpr(
		ParsedNameExpr(name("subject")),
		[
			{
				pattern = pattern,
				body = ParsedCallExpr(
					ParsedNameExpr(name("consume")),
					[
						ParsedNameExpr(name("bound")),
						ParsedNameExpr(name("tail")),
						ParsedNameExpr(name("outside")),
					],
					common_span,
				),
				span = common_span
			},
		],
		common_span,
	)


pure func select_with_roots(src: SourceFile) -> List[ParsedExpr]:
	common_span = span(src, 0, 5)
	name: pure (String) -> ParsedIdentifier = pure func(text):
		parsed_identifier(text, common_span)
	int_type = ParsedNamedType(name("Int"), [], common_span)

	[
		ParsedSelectExpr(
			[
				{
					kind = ParsedSelectReceiveArm(
						name("received"),
						ParsedNameExpr(name("receive_source")),
					),
					body = ParsedNameExpr(name("received")),
					span = common_span
				},
				{
					kind = ParsedSelectSealedArm(ParsedNameExpr(name("sealed_source"))),
					body = ParsedNameExpr(name("sealed_body")),
					span = common_span
				},
				{
					kind = ParsedSelectAfterArm(ParsedNameExpr(name("timeout_source"))),
					body = ParsedNameExpr(name("timeout_body")),
					span = common_span
				},
			],
			common_span,
		),
		ParsedWithExpr(
			{
				name = name("plain_resource"),
				type_expr = None,
				value = ParsedNameExpr(name("plain_value")),
				kind = ParsedWithPlainBinding,
				error_map = None,
				span = common_span
			},
			ParsedNameExpr(name("plain_resource")),
			common_span,
		),
		ParsedWithExpr(
			{
				name = name("resource"),
				type_expr = Some(int_type),
				value = ParsedNameExpr(name("resource_value")),
				kind = ParsedWithTryBinding,
				error_map = Some({
					name = name("map_error"),
					value = ParsedCallExpr(
						ParsedNameExpr(name("map_value")),
						[ParsedNameExpr(name("map_error")), ParsedNameExpr(name("resource"))],
						common_span,
					),
					span = common_span,
				}),
				span = common_span
			},
			ParsedCallExpr(
				ParsedNameExpr(name("body_value")),
				[ParsedNameExpr(name("resource")), ParsedNameExpr(name("map_error"))],
				common_span,
			),
			common_span,
		),
		ParsedWithExpr(
			{
				name = name("try_resource"),
				type_expr = None,
				value = ParsedNameExpr(name("try_value")),
				kind = ParsedWithTryBinding,
				error_map = None,
				span = common_span
			},
			ParsedNameExpr(name("try_resource")),
			common_span,
		),
	]


pure func callable_roots(src: SourceFile) -> List[ParsedExpr]:
	common_span = span(src, 0, 5)
	name: pure (String) -> ParsedIdentifier = pure func(text):
		parsed_identifier(text, common_span)
	type_named: pure (String) -> ParsedTypeExpr = pure func(text):
		ParsedNamedType(name(text), [], common_span)

	[
		ParsedLambdaExpr(
			True,
			[
				{
					name = name("shadow"),
					type_expr = Some(type_named("Int")),
					span = common_span
				},
				{
					name = name("other"),
					type_expr = None,
					span = common_span
				},
			],
			Some(type_named("Result")),
			ParsedCallExpr(
				ParsedNameExpr(name("consume")),
				[ParsedNameExpr(name("shadow")), ParsedNameExpr(name("outside"))],
				common_span,
			),
			common_span,
		),
		ParsedLambdaExpr(False, [], None, ParsedVoidExpr(common_span), common_span),
		ParsedFunctionDeclExpr({
			name = name("nested"),
			keyword_span = Some(common_span),
			type_params = [
				{
					name = name("T"),
					bounds = [name("Eq"), name("Eq")],
					span = common_span
				},
			],
			params = [
				{
					binder = ParsedParamNameBinder(name("value")),
					type_expr = Some(type_named("T")),
					span = common_span
				},
				{
					binder = ParsedParamWildcardBinder(common_span),
					type_expr = None,
					span = common_span
				},
				{
					binder = ParsedParamTupleBinder([], common_span),
					type_expr = None,
					span = common_span
				},
				{
					binder = ParsedParamTupleBinder([name("only")], common_span),
					type_expr = Some(type_named("Pair")),
					span = common_span
				},
			],
			return_type = Some(type_named("Output")),
			dim_constraints = [
				{
					left = type_named("Left"),
					right = type_named("Right"),
					span = common_span
				},
			],
			body = Some(ParsedBuiltinExpr(None, common_span)),
			is_pure = False,
			annotations = [
				ParsedTailRecursiveAnnotation,
				ParsedNoCopyAnnotation,
				ParsedDebugOnlyAnnotation,
				ParsedResourceResultOrdinaryAnnotation,
				ParsedNoCopyAnnotation,
			],
			doc = Some("docs"),
			span = common_span,
		}),
		ParsedFunctionDeclExpr({
			name = name("empty_doc"),
			keyword_span = None,
			type_params = [],
			params = [],
			return_type = None,
			dim_constraints = [],
			body = Some(
				ParsedBlockExpr(
					[ParsedBuiltinExpr(Some("named_builtin"), common_span)],
					common_span,
				),
			),
			is_pure = True,
			annotations = [],
			doc = Some(""),
			span = common_span,
		}),
		ParsedFunctionDeclExpr({
			name = name("forward"),
			keyword_span = Some(common_span),
			type_params = [],
			params = [],
			return_type = None,
			dim_constraints = [],
			body = None,
			is_pure = False,
			annotations = [],
			doc = None,
			span = common_span,
		}),
	]


pure func concurrency_roots(src: SourceFile) -> List[ParsedExpr]:
	common_span = span(src, 0, 5)
	name: pure (String) -> ParsedIdentifier = pure func(text):
		parsed_identifier(text, common_span)
	ref: pure (String) -> ParsedExpr = pure func(text):
		ParsedNameExpr(name(text))

	[
		ParsedConcurrentBlockExpr(
			[
				{
					name = name("limit"),
					value = ref("param_source"),
					span = common_span
				},
				{
					name = name("limit"),
					value = ref("limit"),
					span = common_span
				},
			],
			ParsedBlockExpr(
				[
					ParsedAssignExpr(name("assigned_task"), ref("assigned_source"), common_span),
					ParsedVarDeclExpr(
						name("immutable_task"),
						None,
						ref("immutable_source"),
						False,
						common_span,
					),
					ParsedVarDeclExpr(
						name("mutable_task"),
						None,
						ref("mutable_source"),
						True,
						common_span,
					),
					ref("assigned_task"),
					ref("immutable_task"),
					ref("mutable_task"),
				],
				common_span,
			),
			common_span,
		),
		ParsedConcurrentBlockExpr([], ref("non_block_body"), common_span),
		ParsedConcurrentForExpr(
			name("item"),
			ref("items"),
			[
				{
					name = name("limit"),
					value = ref("item"),
					span = common_span
				},
				{
					name = name("timeout"),
					value = ref("timeout_value"),
					span = common_span
				},
			],
			ParsedCallExpr(
				ref("consume"),
				[ref("item"), ref("outside")],
				common_span,
			),
			common_span,
		),
		ParsedDetachExpr(
			ParsedCallExpr(ref("launch"), [ref("payload")], common_span),
			common_span,
		),
		ParsedConcurrentBlockExpr(
			[
				{
					name = name("missing_param"),
					value = ParsedMissingExpr(common_span),
					span = common_span
				},
			],
			ParsedMissingExpr(common_span),
			common_span,
		),
		ParsedConcurrentForExpr(
			name("missing_item"),
			ParsedMissingExpr(common_span),
			[
				{
					name = name("missing_param"),
					value = ParsedMissingExpr(common_span),
					span = common_span
				},
			],
			ParsedMissingExpr(common_span),
			common_span,
		),
		ParsedDetachExpr(ParsedMissingExpr(common_span), common_span),
	]


pure func optional_expressions_equal(left: Option[ParsedExpr], right: Option[ParsedExpr]) -> Bool:
	match left:
		Some(left_expr):
			match right:
				Some(right_expr):
					expressions_equal(left_expr, right_expr)
				None:
					False
		None:
			right.is_none()


pure func optional_type_expressions_equal(
	left: Option[ParsedTypeExpr],
	right: Option[ParsedTypeExpr],
) -> Bool:
	match left:
		Some(left_type):
			match right:
				Some(right_type):
					type_expressions_equal(left_type, right_type)
				None:
					False
		None:
			right.is_none()


pure func pattern_lists_equal(left: List[ParsedPattern], right: List[ParsedPattern]) -> Bool:
	var equal = left.length() == right.length()
	var index: Int = 0

	while index < left.length() and equal:
		match (left.get(index), right.get(index)):
			(Some(left_pattern), Some(right_pattern)):
				equal = patterns_equal(left_pattern, right_pattern)
			_:
				equal = False

		index += 1

	equal


pure func optional_list_spreads_equal(
	left: Option[ParsedListPatternSpread],
	right: Option[ParsedListPatternSpread],
) -> Bool:
	match left:
		Some(ParsedListSpreadName(left_name)):
			match right:
				Some(ParsedListSpreadName(right_name)):
					identifiers_equal(left_name, right_name)
				_:
					False
		Some(ParsedListSpreadWildcard(left_span)):
			match right:
				Some(ParsedListSpreadWildcard(right_span)):
					left_span == right_span
				_:
					False
		None:
			right.is_none()


pure func patterns_equal(left: ParsedPattern, right: ParsedPattern) -> Bool:
	match left:
		ParsedWildcardPattern(left_span):
			match right:
				ParsedWildcardPattern(right_span):
					left_span == right_span
				_:
					False
		ParsedNamePattern(left_name):
			match right:
				ParsedNamePattern(right_name):
					identifiers_equal(left_name, right_name)
				_:
					False
		ParsedIntPattern(left_text, left_span):
			match right:
				ParsedIntPattern(right_text, right_span):
					left_text == right_text and left_span == right_span
				_:
					False
		ParsedFloatPattern(left_text, left_span):
			match right:
				ParsedFloatPattern(right_text, right_span):
					left_text == right_text and left_span == right_span
				_:
					False
		ParsedStringPattern(left_text, left_form, left_span):
			match right:
				ParsedStringPattern(right_text, right_form, right_span):
					left_text == right_text and left_form == right_form and left_span == right_span
				_:
					False
		ParsedCharPattern(left_value, left_span):
			match right:
				ParsedCharPattern(right_value, right_span):
					left_value == right_value and left_span == right_span
				_:
					False
		ParsedBoolPattern(left_value, left_span):
			match right:
				ParsedBoolPattern(right_value, right_span):
					left_value == right_value and left_span == right_span
				_:
					False
		ParsedConstructorPattern(left_name, left_args, left_span):
			match right:
				ParsedConstructorPattern(right_name, right_args, right_span):
					(
						identifiers_equal(left_name, right_name)
						and pattern_lists_equal(left_args, right_args)
						and left_span == right_span
					)
				_:
					False
		ParsedQualifiedConstructorPattern(left_module, left_name, left_args, left_span):
			match right:
				ParsedQualifiedConstructorPattern(right_module, right_name, right_args, right_span):
					(
						identifiers_equal(left_module, right_module)
						and identifiers_equal(left_name, right_name)
						and pattern_lists_equal(left_args, right_args)
						and left_span == right_span
					)
				_:
					False
		ParsedTuplePattern(left_items, left_span):
			match right:
				ParsedTuplePattern(right_items, right_span):
					pattern_lists_equal(left_items, right_items) and left_span == right_span
				_:
					False
		ParsedListPattern(left_items, left_spread, left_span):
			match right:
				ParsedListPattern(right_items, right_spread, right_span):
					(
						pattern_lists_equal(left_items, right_items)
						and optional_list_spreads_equal(left_spread, right_spread)
						and left_span == right_span
					)
				_:
					False
		ParsedOrPattern(left_items, left_span):
			match right:
				ParsedOrPattern(right_items, right_span):
					pattern_lists_equal(left_items, right_items) and left_span == right_span
				_:
					False
		ParsedMissingPattern(left_span):
			match right:
				ParsedMissingPattern(right_span):
					left_span == right_span
				_:
					False


pure func match_cases_equal(left: List[ParsedMatchCase], right: List[ParsedMatchCase]) -> Bool:
	var equal = left.length() == right.length()
	var index: Int = 0

	while index < left.length() and equal:
		match (left.get(index), right.get(index)):
			(Some(left_case), Some(right_case)):
				equal = (
					patterns_equal(left_case.pattern, right_case.pattern)
					and expressions_equal(left_case.body, right_case.body)
					and left_case.span == right_case.span
				)
			_:
				equal = False

		index += 1

	equal


pure func select_arms_equal(left: List[ParsedSelectArm], right: List[ParsedSelectArm]) -> Bool:
	var equal = left.length() == right.length()
	var index: Int = 0

	while index < left.length() and equal:
		match (left.get(index), right.get(index)):
			(Some(left_arm), Some(right_arm)):
				var kinds_equal = False

				match left_arm.kind:
					ParsedSelectReceiveArm(left_name, left_source):
						match right_arm.kind:
							ParsedSelectReceiveArm(right_name, right_source):
								kinds_equal = (
									identifiers_equal(left_name, right_name)
									and expressions_equal(left_source, right_source)
								)
							_:
								void
					ParsedSelectSealedArm(left_source):
						match right_arm.kind:
							ParsedSelectSealedArm(right_source):
								kinds_equal = expressions_equal(left_source, right_source)
							_:
								void
					ParsedSelectAfterArm(left_source):
						match right_arm.kind:
							ParsedSelectAfterArm(right_source):
								kinds_equal = expressions_equal(left_source, right_source)
							_:
								void

				equal = (
					kinds_equal
					and expressions_equal(left_arm.body, right_arm.body)
					and left_arm.span == right_arm.span
				)
			_:
				equal = False

		index += 1

	equal


pure func optional_with_error_maps_equal(
	left: Option[ParsedWithErrorMap],
	right: Option[ParsedWithErrorMap],
) -> Bool:
	match left:
		Some(left_map):
			match right:
				Some(right_map):
					(
						identifiers_equal(left_map.name, right_map.name)
						and expressions_equal(left_map.value, right_map.value)
						and left_map.span == right_map.span
					)
				None:
					False
		None:
			right.is_none()


pure func lambda_params_equal(
	left: List[ParsedLambdaParam],
	right: List[ParsedLambdaParam],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_param), Some(right_param)):
					equal = (
						identifiers_equal(left_param.name, right_param.name)
						and optional_type_expressions_equal(
							left_param.type_expr,
							right_param.type_expr,
						)
						and left_param.span == right_param.span
					)
				_:
					equal = False

			index += 1

		equal


pure func param_binders_equal(left: ParsedParamBinder, right: ParsedParamBinder) -> Bool:
	match left:
		ParsedParamNameBinder(left_name):
			match right:
				ParsedParamNameBinder(right_name):
					identifiers_equal(left_name, right_name)
				_:
					False
		ParsedParamWildcardBinder(left_span):
			match right:
				ParsedParamWildcardBinder(right_span):
					left_span == right_span
				_:
					False
		ParsedParamTupleBinder(left_names, left_span):
			match right:
				ParsedParamTupleBinder(right_names, right_span):
					identifier_lists_equal(left_names, right_names) and left_span == right_span
				_:
					False


pure func function_params_equal(left: List[ParsedParam], right: List[ParsedParam]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_param), Some(right_param)):
					equal = (
						param_binders_equal(left_param.binder, right_param.binder)
						and optional_type_expressions_equal(
							left_param.type_expr,
							right_param.type_expr,
						)
						and left_param.span == right_param.span
					)
				_:
					equal = False

			index += 1

		equal


pure func type_params_equal(
	left: List[ParsedTypeParamDecl],
	right: List[ParsedTypeParamDecl],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_param), Some(right_param)):
					equal = (
						identifiers_equal(left_param.name, right_param.name)
						and identifier_lists_equal(left_param.bounds, right_param.bounds)
						and left_param.span == right_param.span
					)
				_:
					equal = False

			index += 1

		equal


pure func dim_constraints_equal(
	left: List[ParsedDimConstraint],
	right: List[ParsedDimConstraint],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_constraint), Some(right_constraint)):
					equal = (
						type_expressions_equal(left_constraint.left, right_constraint.left)
						and type_expressions_equal(left_constraint.right, right_constraint.right)
						and left_constraint.span == right_constraint.span
					)
				_:
					equal = False

			index += 1

		equal


pure func function_decls_equal(left: ParsedFunctionDecl, right: ParsedFunctionDecl) -> Bool:
	(
		identifiers_equal(left.name, right.name)
		and left.keyword_span == right.keyword_span
		and type_params_equal(left.type_params, right.type_params)
		and function_params_equal(left.params, right.params)
		and optional_type_expressions_equal(left.return_type, right.return_type)
		and dim_constraints_equal(left.dim_constraints, right.dim_constraints)
		and optional_expressions_equal(left.body, right.body)
		and left.is_pure == right.is_pure
		and left.annotations == right.annotations
		and left.doc == right.doc
		and left.span == right.span
	)


pure func expressions_equal(left: ParsedExpr, right: ParsedExpr) -> Bool:
	match left:
		ParsedNameExpr(left_name):
			match right:
				ParsedNameExpr(right_name):
					left_name.text == right_name.text and left_name.span == right_name.span
				_:
					False
		ParsedIntLiteralExpr(left_text, left_span):
			match right:
				ParsedIntLiteralExpr(right_text, right_span):
					left_text == right_text and left_span == right_span
				_:
					False
		ParsedFloatLiteralExpr(left_text, left_span):
			match right:
				ParsedFloatLiteralExpr(right_text, right_span):
					left_text == right_text and left_span == right_span
				_:
					False
		ParsedStringLiteralExpr(left_text, left_form, left_span):
			match right:
				ParsedStringLiteralExpr(right_text, right_form, right_span):
					left_text == right_text and left_form == right_form and left_span == right_span
				_:
					False
		ParsedStringInterpolationExpr(left_text, left_multiline, left_span):
			match right:
				ParsedStringInterpolationExpr(right_text, right_multiline, right_span):
					(
						left_text == right_text
						and left_multiline == right_multiline
						and left_span == right_span
					)
				_:
					False
		ParsedBoolLiteralExpr(left_value, left_span):
			match right:
				ParsedBoolLiteralExpr(right_value, right_span):
					left_value == right_value and left_span == right_span
				_:
					False
		ParsedCharLiteralExpr(left_value, left_span):
			match right:
				ParsedCharLiteralExpr(right_value, right_span):
					left_value == right_value and left_span == right_span
				_:
					False
		ParsedUnaryExpr(left_op, left_value, left_span):
			match right:
				ParsedUnaryExpr(right_op, right_value, right_span):
					(
						left_op == right_op
						and expressions_equal(left_value, right_value)
						and left_span == right_span
					)
				_:
					False
		ParsedBinaryExpr(left_op, left_lhs, left_rhs, left_span):
			match right:
				ParsedBinaryExpr(right_op, right_lhs, right_rhs, right_span):
					(
						left_op == right_op
						and expressions_equal(left_lhs, right_lhs)
						and expressions_equal(left_rhs, right_rhs)
						and left_span == right_span
					)
				_:
					False
		ParsedLogicalExpr(left_op, left_lhs, left_rhs, left_span):
			match right:
				ParsedLogicalExpr(right_op, right_lhs, right_rhs, right_span):
					(
						left_op == right_op
						and expressions_equal(left_lhs, right_lhs)
						and expressions_equal(left_rhs, right_rhs)
						and left_span == right_span
					)
				_:
					False
		ParsedAscriptionExpr(left_value, left_type, left_span):
			match right:
				ParsedAscriptionExpr(right_value, right_type, right_span):
					(
						expressions_equal(left_value, right_value)
						and type_expressions_equal(left_type, right_type)
						and left_span == right_span
					)
				_:
					False
		ParsedRangeExpr(left_start, left_finish, left_span):
			match right:
				ParsedRangeExpr(right_start, right_finish, right_span):
					(
						expressions_equal(left_start, right_start)
						and expressions_equal(left_finish, right_finish)
						and left_span == right_span
					)
				_:
					False
		ParsedCallExpr(left_callee, left_args, left_span):
			match right:
				ParsedCallExpr(right_callee, right_args, right_span):
					var equal = left_args.length() == right_args.length()
					var index: Int = 0

					while index < left_args.length() and equal:
						equal = expressions_equal(
							left_args
								.get(index)
								.get_or(ParsedMissingExpr(left_span)),
							right_args
								.get(index)
								.get_or(ParsedMissingExpr(right_span)),
						)
						index += 1

					(
						expressions_equal(left_callee, right_callee)
						and equal
						and left_span == right_span
					)
				_:
					False
		ParsedFieldAccessExpr(left_target, left_field, left_span):
			match right:
				ParsedFieldAccessExpr(right_target, right_field, right_span):
					(
						expressions_equal(left_target, right_target)
						and left_field.text == right_field.text
						and left_field.span == right_field.span
						and left_span == right_span
					)
				_:
					False
		ParsedSubscriptExpr(left_target, left_indices, left_span):
			match right:
				ParsedSubscriptExpr(right_target, right_indices, right_span):
					(
						expressions_equal(left_target, right_target)
						and expression_lists_equal(left_indices, right_indices)
						and left_span == right_span
					)
				_:
					False
		ParsedListExpr(left_items, left_span):
			match right:
				ParsedListExpr(right_items, right_span):
					expression_lists_equal(left_items, right_items) and left_span == right_span
				_:
					False
		ParsedTupleExpr(left_items, left_span):
			match right:
				ParsedTupleExpr(right_items, right_span):
					expression_lists_equal(left_items, right_items) and left_span == right_span
				_:
					False
		ParsedRecordExpr(left_fields, left_span):
			match right:
				ParsedRecordExpr(right_fields, right_span):
					record_fields_equal(left_fields, right_fields) and left_span == right_span
				_:
					False
		ParsedRecordUpdateExpr(left_base, left_fields, left_span):
			match right:
				ParsedRecordUpdateExpr(right_base, right_fields, right_span):
					(
						expressions_equal(left_base, right_base)
						and record_fields_equal(left_fields, right_fields)
						and left_span == right_span
					)
				_:
					False
		ParsedDictExpr(left_entries, left_span):
			match right:
				ParsedDictExpr(right_entries, right_span):
					dict_entries_equal(left_entries, right_entries) and left_span == right_span
				_:
					False
		ParsedVectorExpr(left_items, left_span):
			match right:
				ParsedVectorExpr(right_items, right_span):
					expression_lists_equal(left_items, right_items) and left_span == right_span
				_:
					False
		ParsedOpaqueIntoExpr(left_type, left_value, left_span):
			match right:
				ParsedOpaqueIntoExpr(right_type, right_value, right_span):
					(
						type_expressions_equal(left_type, right_type)
						and expressions_equal(left_value, right_value)
						and left_span == right_span
					)
				_:
					False
		ParsedOpaqueFromExpr(left_type, left_value, left_span):
			match right:
				ParsedOpaqueFromExpr(right_type, right_value, right_span):
					(
						type_expressions_equal(left_type, right_type)
						and expressions_equal(left_value, right_value)
						and left_span == right_span
					)
				_:
					False
		ParsedStringInterpolationPartsExpr(left_parts, left_multiline, left_span):
			match right:
				ParsedStringInterpolationPartsExpr(right_parts, right_multiline, right_span):
					(
						interpolation_parts_equal(left_parts, right_parts)
						and left_multiline == right_multiline
						and left_span == right_span
					)
				_:
					False
		ParsedBlockExpr(left_items, left_span):
			match right:
				ParsedBlockExpr(right_items, right_span):
					expression_lists_equal(left_items, right_items) and left_span == right_span
				_:
					False
		ParsedVarDeclExpr(left_name, left_type, left_value, left_mutable, left_span):
			match right:
				ParsedVarDeclExpr(right_name, right_type, right_value, right_mutable, right_span):
					(
						identifiers_equal(left_name, right_name)
						and optional_type_expressions_equal(left_type, right_type)
						and expressions_equal(left_value, right_value)
						and left_mutable == right_mutable
						and left_span == right_span
					)
				_:
					False
		ParsedAssignExpr(left_name, left_value, left_span):
			match right:
				ParsedAssignExpr(right_name, right_value, right_span):
					(
						identifiers_equal(left_name, right_name)
						and expressions_equal(left_value, right_value)
						and left_span == right_span
					)
				_:
					False
		ParsedCompoundAssignExpr(left_name, left_op, left_value, left_span):
			match right:
				ParsedCompoundAssignExpr(right_name, right_op, right_value, right_span):
					(
						identifiers_equal(left_name, right_name)
						and left_op == right_op
						and expressions_equal(left_value, right_value)
						and left_span == right_span
					)
				_:
					False
		ParsedSubscriptAssignExpr(left_target, left_indices, left_value, left_span):
			match right:
				ParsedSubscriptAssignExpr(right_target, right_indices, right_value, right_span):
					(
						expressions_equal(left_target, right_target)
						and expression_lists_equal(left_indices, right_indices)
						and expressions_equal(left_value, right_value)
						and left_span == right_span
					)
				_:
					False
		ParsedTupleDestructExpr(left_names, left_value, left_span):
			match right:
				ParsedTupleDestructExpr(right_names, right_value, right_span):
					(
						identifier_lists_equal(left_names, right_names)
						and expressions_equal(left_value, right_value)
						and left_span == right_span
					)
				_:
					False
		ParsedQuestionBindExpr(left_name, left_type, left_value, left_span):
			match right:
				ParsedQuestionBindExpr(right_name, right_type, right_value, right_span):
					(
						identifiers_equal(left_name, right_name)
						and optional_type_expressions_equal(left_type, right_type)
						and expressions_equal(left_value, right_value)
						and left_span == right_span
					)
				_:
					False
		ParsedIfExpr(left_condition, left_then, left_else, left_span):
			match right:
				ParsedIfExpr(right_condition, right_then, right_else, right_span):
					(
						expressions_equal(left_condition, right_condition)
						and expressions_equal(left_then, right_then)
						and optional_expressions_equal(left_else, right_else)
						and left_span == right_span
					)
				_:
					False
		ParsedMatchExpr(left_scrutinee, left_cases, left_span):
			match right:
				ParsedMatchExpr(right_scrutinee, right_cases, right_span):
					(
						expressions_equal(left_scrutinee, right_scrutinee)
						and match_cases_equal(left_cases, right_cases)
						and left_span == right_span
					)
				_:
					False
		ParsedSelectExpr(left_arms, left_span):
			match right:
				ParsedSelectExpr(right_arms, right_span):
					select_arms_equal(left_arms, right_arms) and left_span == right_span
				_:
					False
		ParsedWithExpr(left_binding, left_body, left_span):
			match right:
				ParsedWithExpr(right_binding, right_body, right_span):
					(
						identifiers_equal(left_binding.name, right_binding.name)
						and optional_type_expressions_equal(
							left_binding.type_expr,
							right_binding.type_expr,
						)
						and expressions_equal(left_binding.value, right_binding.value)
						and left_binding.kind == right_binding.kind
						and optional_with_error_maps_equal(
							left_binding.error_map,
							right_binding.error_map,
						)
						and left_binding.span == right_binding.span
						and expressions_equal(left_body, right_body)
						and left_span == right_span
					)
				_:
					False
		ParsedLambdaExpr(left_pure, left_params, left_return, left_body, left_span):
			match right:
				ParsedLambdaExpr(right_pure, right_params, right_return, right_body, right_span):
					(
						left_pure == right_pure
						and lambda_params_equal(left_params, right_params)
						and optional_type_expressions_equal(left_return, right_return)
						and expressions_equal(left_body, right_body)
						and left_span == right_span
					)
				_:
					False
		ParsedFunctionDeclExpr(left_decl):
			match right:
				ParsedFunctionDeclExpr(right_decl):
					function_decls_equal(left_decl, right_decl)
				_:
					False
		ParsedDebugBlockExpr(left_body, left_span):
			match right:
				ParsedDebugBlockExpr(right_body, right_span):
					expressions_equal(left_body, right_body) and left_span == right_span
				_:
					False
		ParsedWhileExpr(left_condition, left_body, left_span):
			match right:
				ParsedWhileExpr(right_condition, right_body, right_span):
					(
						expressions_equal(left_condition, right_condition)
						and expressions_equal(left_body, right_body)
						and left_span == right_span
					)
				_:
					False
		ParsedForExpr(left_binder, left_iterable, left_body, left_span):
			match right:
				ParsedForExpr(right_binder, right_iterable, right_body, right_span):
					(
						for_binders_equal(left_binder, right_binder)
						and expressions_equal(left_iterable, right_iterable)
						and expressions_equal(left_body, right_body)
						and left_span == right_span
					)
				_:
					False
		ParsedConcurrentBlockExpr(left_params, left_body, left_span):
			match right:
				ParsedConcurrentBlockExpr(right_params, right_body, right_span):
					(
						concurrent_params_equal(left_params, right_params)
						and expressions_equal(left_body, right_body)
						and left_span == right_span
					)
				_:
					False
		ParsedConcurrentForExpr(left_name, left_iterable, left_params, left_body, left_span):
			match right:
				ParsedConcurrentForExpr(right_name, right_iterable, right_params, right_body, right_span):
					(
						identifiers_equal(left_name, right_name)
						and expressions_equal(left_iterable, right_iterable)
						and concurrent_params_equal(left_params, right_params)
						and expressions_equal(left_body, right_body)
						and left_span == right_span
					)
				_:
					False
		ParsedDetachExpr(left_body, left_span):
			match right:
				ParsedDetachExpr(right_body, right_span):
					expressions_equal(left_body, right_body) and left_span == right_span
				_:
					False
		ParsedVoidExpr(left_span):
			match right:
				ParsedVoidExpr(right_span):
					left_span == right_span
				_:
					False
		ParsedBreakExpr(left_span):
			match right:
				ParsedBreakExpr(right_span):
					left_span == right_span
				_:
					False
		ParsedContinueExpr(left_span):
			match right:
				ParsedContinueExpr(right_span):
					left_span == right_span
				_:
					False
		ParsedBuiltinExpr(left_name, left_span):
			match right:
				ParsedBuiltinExpr(right_name, right_span):
					left_name == right_name and left_span == right_span
				_:
					False
		ParsedMissingExpr(left_span):
			match right:
				ParsedMissingExpr(right_span):
					left_span == right_span
				_:
					False
		_:
			False


pure func identifiers_equal(left: ParsedIdentifier, right: ParsedIdentifier) -> Bool:
	left.text == right.text and left.span == right.span


pure func concurrent_params_equal(
	left: List[ParsedConcurrentParam],
	right: List[ParsedConcurrentParam],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_param), Some(right_param)):
					equal = (
						identifiers_equal(left_param.name, right_param.name)
						and expressions_equal(left_param.value, right_param.value)
						and left_param.span == right_param.span
					)
				_:
					equal = False

			index += 1

		equal


pure func for_binders_equal(left: ParsedForBinder, right: ParsedForBinder) -> Bool:
	match left:
		ParsedForNameBinder(left_name):
			match right:
				ParsedForNameBinder(right_name):
					identifiers_equal(left_name, right_name)
				_:
					False
		ParsedForTupleBinder(left_names, left_span):
			match right:
				ParsedForTupleBinder(right_names, right_span):
					identifier_lists_equal(left_names, right_names) and left_span == right_span
				_:
					False


pure func identifier_lists_equal(
	left: List[ParsedIdentifier],
	right: List[ParsedIdentifier],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_value), Some(right_value)):
					equal = identifiers_equal(left_value, right_value)
				_:
					equal = False

			index += 1

		equal


pure func type_expression_lists_equal(
	left: List[ParsedTypeExpr],
	right: List[ParsedTypeExpr],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_value), Some(right_value)):
					equal = type_expressions_equal(left_value, right_value)
				_:
					equal = False

			index += 1

		equal


pure func type_expressions_equal(left: ParsedTypeExpr, right: ParsedTypeExpr) -> Bool:
	match left:
		ParsedNamedType(left_name, left_args, left_span):
			match right:
				ParsedNamedType(right_name, right_args, right_span):
					(
						identifiers_equal(left_name, right_name)
						and type_expression_lists_equal(left_args, right_args)
						and left_span == right_span
					)
				_:
					False
		ParsedQualifiedNamedType(left_qualifier, left_name, left_args, left_span):
			match right:
				ParsedQualifiedNamedType(right_qualifier, right_name, right_args, right_span):
					(
						identifiers_equal(left_qualifier, right_qualifier)
						and identifiers_equal(left_name, right_name)
						and type_expression_lists_equal(left_args, right_args)
						and left_span == right_span
					)
				_:
					False
		ParsedBoundedType(left_name, left_bounds, left_span):
			match right:
				ParsedBoundedType(right_name, right_bounds, right_span):
					(
						identifiers_equal(left_name, right_name)
						and identifier_lists_equal(left_bounds, right_bounds)
						and left_span == right_span
					)
				_:
					False
		ParsedDimNameType(left_name, left_splat, left_span):
			match right:
				ParsedDimNameType(right_name, right_splat, right_span):
					(
						identifiers_equal(left_name, right_name)
						and left_splat == right_splat
						and left_span == right_span
					)
				_:
					False
		ParsedDimLiteralType(left_text, left_span):
			match right:
				ParsedDimLiteralType(right_text, right_span):
					left_text == right_text and left_span == right_span
				_:
					False
		ParsedDimBinaryType(left_op, left_lhs, left_rhs, left_span):
			match right:
				ParsedDimBinaryType(right_op, right_lhs, right_rhs, right_span):
					(
						left_op == right_op
						and type_expressions_equal(left_lhs, right_lhs)
						and type_expressions_equal(left_rhs, right_rhs)
						and left_span == right_span
					)
				_:
					False
		ParsedRangeType(left_value, left_span):
			match right:
				ParsedRangeType(right_value, right_span):
					type_expressions_equal(left_value, right_value) and left_span == right_span
				_:
					False
		ParsedTupleType(left_fields, left_span):
			match right:
				ParsedTupleType(right_fields, right_span):
					(
						type_expression_lists_equal(left_fields, right_fields)
						and left_span == right_span
					)
				_:
					False
		ParsedFunctionType(left_pure, left_params, left_result, left_span):
			match right:
				ParsedFunctionType(right_pure, right_params, right_result, right_span):
					(
						left_pure == right_pure
						and type_expression_lists_equal(left_params, right_params)
						and type_expressions_equal(left_result, right_result)
						and left_span == right_span
					)
				_:
					False
		ParsedArrayType(left_element, left_dimensions, left_span):
			match right:
				ParsedArrayType(right_element, right_dimensions, right_span):
					(
						type_expressions_equal(left_element, right_element)
						and type_expression_lists_equal(left_dimensions, right_dimensions)
						and left_span == right_span
					)
				_:
					False
		ParsedMissingType(left_span):
			match right:
				ParsedMissingType(right_span):
					left_span == right_span
				_:
					False


pure func interpolation_parts_equal(
	left: List[ParsedStringInterpolationPart],
	right: List[ParsedStringInterpolationPart],
) -> Bool:
	-- Keep these matches nested. The equivalent simultaneous match currently
	-- mishandles a later managed-union payload after mixed part variants; see
	-- compiler_managed_union_tuple_match_repro.brp.
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			match left.get(index):
				Some(ParsedInterpolationLiteral(left_text)):
					match right.get(index):
						Some(ParsedInterpolationLiteral(right_text)):
							equal = left_text == right_text
						_:
							equal = False
				Some(ParsedInterpolationExpr(left_expr)):
					match right.get(index):
						Some(ParsedInterpolationExpr(right_expr)):
							equal = expressions_equal(left_expr, right_expr)
						_:
							equal = False
				None:
					equal = False

			index += 1

		equal


pure func expression_lists_equal(left: List[ParsedExpr], right: List[ParsedExpr]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_value), Some(right_value)):
					equal = expressions_equal(left_value, right_value)
				_:
					equal = False

			index += 1

		equal


pure func record_fields_equal(
	left: List[ParsedRecordExprField],
	right: List[ParsedRecordExprField],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_field), Some(right_field)):
					equal = (
						left_field.name.text == right_field.name.text
						and left_field.name.span == right_field.name.span
						and expressions_equal(left_field.value, right_field.value)
						and left_field.span == right_field.span
					)
				_:
					equal = False

			index += 1

		equal


pure func dict_entries_equal(left: List[ParsedDictEntry], right: List[ParsedDictEntry]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_entry), Some(right_entry)):
					equal = (
						expressions_equal(left_entry.key, right_entry.key)
						and expressions_equal(left_entry.value, right_entry.value)
						and left_entry.span == right_entry.span
					)
				_:
					equal = False

			index += 1

		equal


pure func reference_lists_equal(
	left: List[IdentifierReference],
	right: List[IdentifierReference],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			left_reference = left.get(index)
			right_reference = right.get(index)

			match left_reference:
				Some(left_value):
					match right_reference:
						Some(right_value):
							equal = (
								left_value.name == right_value.name
								and left_value.qualified_member == right_value.qualified_member
								and left_value.span == right_value.span
							)
						None:
							equal = False
				None:
					equal = False

			index += 1

		equal


record ReferenceLifetimeOutputs {
	legacy: List[IdentifierReference],
	compact: List[IdentifierReference]
}


pure func reference_outputs_after_all_inputs_release() -> ReferenceLifetimeOutputs:
	src = source()
	dynamic_name = src.text.substring(0, 5)
	expr = ParsedCallExpr(
		ParsedNameExpr(parsed_identifier(dynamic_name, span(src, 0, 5))),
		[
			ParsedNameExpr(parsed_identifier("beta", span(src, 6, 10))),
			ParsedNameExpr(parsed_identifier(dynamic_name, span(src, 0, 5))),
		],
		span(
			src,
			0,
			10,
		),
	)
	legacy = parsed_expr_free_identifier_references(expr)

	match compact_expression_oracle_from_parsed_roots(src, [expr]):
		Ok(product):
			{
				legacy = legacy,
				compact = compact_expression_oracle_free_identifier_references(product)
			}
		Err(_):
			{
				legacy = legacy,
				compact = []
			}


func test_scalar_operator_call_family_round_trips_exactly() -> Bool:
	src = source()
	roots = expression_roots(src)

	match compact_expression_oracle_from_parsed_roots(src, roots):
		Ok(product):
			match compact_expression_oracle_project(product):
				Ok(projected):
					var equal = projected.length() == roots.length()
					var index: Int = 0

					while index < roots.length() and equal:
						equal = expressions_equal(
							roots
								.get(index)
								.get_or(ParsedMissingExpr(span(src, 0, 0))),
							projected
								.get(index)
								.get_or(ParsedMissingExpr(span(src, 0, 0))),
						)
						index += 1

					equal
				Err(_):
					False
		Err(_):
			False


