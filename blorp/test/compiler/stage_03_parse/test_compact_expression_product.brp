func test_callable_real_parser_round_trip_and_scopes_match() -> Bool:
	program_text = "func run(outer: Int):\n\tpure func(x: Int) -> Int: x + outer\n\tfunc nested[T: Eq](value: T) -> T:\n\t\tvalue\n\tnested(outer)"
	program_source = source_file("callables.brp", "callables", program_text)

	match first_function_body(parse_compiler_source(program_source)):
		Some(body):
			match compact_expression_oracle_from_parsed_roots(program_source, [body]):
				Ok(product):
					match compact_expression_oracle_project(product):
						Ok([projected]):
							(
								expressions_equal(body, projected)
								and reference_lists_equal(
									parsed_expr_free_identifier_references(body),
									compact_expression_oracle_free_identifier_references(product),
								)
							)
						_:
							False
				Err(_):
					False
		None:
			False


func test_callable_reference_scopes_match_production() -> Bool:
