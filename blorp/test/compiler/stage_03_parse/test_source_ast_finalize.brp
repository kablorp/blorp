import:
	../../../src/compiler/stage_02_lex/parse_diagnostic: parse_diagnostic_to_string
	../../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../../src/compiler/stage_03_parse/parsed_ast:
		ParsedDecl(FunctionParsedDecl, ImplParsedDecl, ImportBlockParsedDecl, PrivateParsedDecl),
		ParsedExpr(
			ParsedBinaryExpr,
			ParsedBlockExpr,
			ParsedBoolLiteralExpr,
			ParsedCallExpr,
			ParsedLogicalExpr,
			ParsedNameExpr,
			ParsedStringInterpolationPartsExpr,
			ParsedSubscriptAssignExpr,
			ParsedSubscriptExpr,
			ParsedVoidExpr,
		),
		ParsedProgram,
		ParsedStringInterpolationPart(ParsedInterpolationExpr, ParsedInterpolationLiteral),
	../../../src/compiler/stage_03_parse/source_ast_finalize:
		FinalizedImportPathRewrite,
		StringInterpolationRawPart(InterpolationExprText, InterpolationLiteralText),
		finalize_interpolation_program,
		finalize_nested_functions_program,
		finalize_typecheck_source_program,
		finalized_typecheck_program,
		finalized_typecheck_program_ast,
		finalized_typecheck_program_rewrite_import_paths,
		split_interpolated_string,
	../../../src/lib/source:
		SourceFile,
		SourceLocation,
		source_cursor_at,
		source_file,
		source_location_for_file,
		source_location_span,
		source_span_text,
		source_table_for_file,
	test: TestSuite


DEEP_LOGICAL_TERM_COUNT: Int = 4096


pure func source(text: String) -> SourceFile:
	source_file("demo.brp", "demo", text)


pure func full_span(src: SourceFile) -> SourceLocation:
	source_location_for_file(
		src,
		source_cursor_at(src, 0),
		source_cursor_at(src, src.text.length()),
	)


pure func first_function_body(program: ParsedProgram) -> Option[ParsedExpr]:
	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			function_decl.body
		_:
			None


pure func function_name_at(program: ParsedProgram, index: Int) -> String:
	match program.decls.get(index):
		Some(FunctionParsedDecl(function_decl)):
			function_decl.name.text
		_:
			""


pure func function_body_at(program: ParsedProgram, index: Int) -> Option[ParsedExpr]:
	match program.decls.get(index):
		Some(FunctionParsedDecl(function_decl)):
			function_decl.body
		_:
			None


pure func function_body_item_at(
	program: ParsedProgram,
	function_index: Int,
	item_index: Int,
) -> Option[ParsedExpr]:
	match function_body_at(program, function_index):
		Some(ParsedBlockExpr(items, _)):
			items.get(item_index)
		_:
			None


pure func private_function_name_at(program: ParsedProgram, index: Int) -> String:
	match program.decls.get(index):
		Some(PrivateParsedDecl(FunctionParsedDecl(function_decl), _)):
			function_decl.name.text
		_:
			""


pure func private_function_body_item_at(
	program: ParsedProgram,
	function_index: Int,
	item_index: Int,
) -> Option[ParsedExpr]:
	match program.decls.get(function_index):
		Some(PrivateParsedDecl(FunctionParsedDecl(function_decl), _)):
			match function_decl.body:
				Some(ParsedBlockExpr(items, _)):
					items.get(item_index)
				_:
					None
		_:
			None


pure func impl_method_body_item_at(
	program: ParsedProgram,
	impl_index: Int,
	method_index: Int,
	item_index: Int,
) -> Option[ParsedExpr]:
	match program.decls.get(impl_index):
		Some(ImplParsedDecl(impl_decl)):
			match impl_decl.methods.get(method_index):
				Some(method):
					match method.body:
						Some(ParsedBlockExpr(items, _)):
							items.get(item_index)
						_:
							None
				None:
					None
		_:
			None


pure func call_callee_name(expr: ParsedExpr) -> String:
	match expr:
		ParsedCallExpr(ParsedNameExpr(name), _, _):
			name.text
		_:
			""


pure func raw_literal_at(parts: List[StringInterpolationRawPart], index: Int) -> String:
	match parts.get(index):
		Some(InterpolationLiteralText(value)):
			value
		_:
			""


pure func raw_expr_at(parts: List[StringInterpolationRawPart], index: Int) -> String:
	match parts.get(index):
		Some(InterpolationExprText(value, _)):
			value
		_:
			""


pure func interpolation_literal_at(
	parts: List[ParsedStringInterpolationPart],
	index: Int,
) -> String:
	match parts.get(index):
		Some(ParsedInterpolationLiteral(value)):
			value
		_:
			""


pure func interpolation_expr_name_at(
	parts: List[ParsedStringInterpolationPart],
	index: Int,
) -> String:
	match parts.get(index):
		Some(ParsedInterpolationExpr(ParsedNameExpr(name))):
			name.text
		_:
			""


pure func diagnostic_string_at(program: ParsedProgram, index: Int) -> String:
	match program.diagnostics.get(index):
		Some(diagnostic):
			parse_diagnostic_to_string(diagnostic)
		None:
			""


func test_split_interpolated_string_splits_literal_and_expr() -> Bool:
	src: SourceFile = source("demo")

	match split_interpolated_string(source_table_for_file(src), full_span(src), "Hello {name}!"):
		Ok(parts):
			(
				parts.length() == 3
				and raw_literal_at(parts, 0) == "Hello "
				and raw_expr_at(parts, 1) == "name"
				and raw_literal_at(parts, 2) == "!"
			)
		Err(_):
			False


func test_split_interpolated_string_unescapes_literal_braces() -> Bool:
	src: SourceFile = source("demo")

	match split_interpolated_string(
		source_table_for_file(src),
		full_span(src),
		"Hello \\{name\\} {value}",
	):
		Ok(parts):
			(
				parts.length() == 2
				and raw_literal_at(parts, 0) == "Hello {name} "
				and raw_expr_at(parts, 1) == "value"
			)
		Err(_):
			False


-- The token text is a byte-indexed copy of the source, so the split has to copy
-- verbatim runs as bytes. Rebuilding them one Char at a time re-encodes every
-- byte of a multibyte character as its own codepoint, which corrupts both the
-- literal parts and the expression source handed back to the lexer.
func test_split_interpolated_string_preserves_multibyte_literals() -> Bool:
	dash: String = "—"
	src: SourceFile = source("demo")

	match split_interpolated_string(
		source_table_for_file(src),
		full_span(src),
		"café " + dash + " {name} ünd",
	):
		Ok(parts):
			(
				parts.length() == 3
				and raw_literal_at(parts, 0) == "café " + dash + " "
				and raw_expr_at(parts, 1) == "name"
				and raw_literal_at(parts, 2) == " ünd"
			)
		Err(_):
			False


func test_split_interpolated_string_preserves_multibyte_expr_text() -> Bool:
	src: SourceFile = source("demo")

	match split_interpolated_string(
		source_table_for_file(src),
		full_span(src),
		"a {\"é\".length()} b",
	):
		Ok(parts):
			(
				parts.length() == 3
				and raw_literal_at(parts, 0) == "a "
				and raw_expr_at(parts, 1) == "\"é\".length()"
				and raw_literal_at(parts, 2) == " b"
			)
		Err(_):
			False


func test_split_interpolated_string_reports_unclosed_expr() -> Bool:
	src: SourceFile = source("demo")

	match split_interpolated_string(source_table_for_file(src), full_span(src), "Hello {name"):
		Ok(_):
			False
		Err(diagnostic):
			diagnostic.message.contains("Unclosed")


func test_finalize_interpolation_program_rewrites_raw_string() -> Bool:
	program_source: String = "func message(name: String): \"Hello " + "$" + "{name}!\""
	program: ParsedProgram = finalize_interpolation_program(
		parse_compiler_source(source(program_source)),
	)

	match first_function_body(program):
		Some(ParsedStringInterpolationPartsExpr(parts, is_multiline, _)):
			(
				not is_multiline
				and parts.length() == 3
				and interpolation_literal_at(parts, 0) == "Hello "
				and interpolation_expr_name_at(parts, 1) == "name"
				and interpolation_literal_at(parts, 2) == "!"
				and program.diagnostics.length() == 0
			)
		_:
			False


func test_finalize_interpolation_rebases_nested_locations_to_authored_source() -> Bool:
	program_source: String = "func message(): \"prefix\\n " + "$" + "{missing_name}\""
	program: ParsedProgram = finalize_interpolation_program(
		parse_compiler_source(source(program_source)),
	)

	match first_function_body(program):
		Some(ParsedStringInterpolationPartsExpr(parts, _, _)):
			match parts.get(1):
				Some(ParsedInterpolationExpr(ParsedNameExpr(name))):
					span = source_location_span(source_table_for_file(program.source), name.span)
					(
						span.path == "demo.brp"
						and span.start_line == 1
						and source_span_text(program.source, span) == "missing_name"
					)
				_:
					False
		_:
			False


func test_finalize_interpolation_program_preserves_duplicate_hole_order() -> Bool:
	program_source: String = "func message(name: String): \"" + "$" + "{name}" + "$" + "{name}\""
	program: ParsedProgram = finalize_interpolation_program(
		parse_compiler_source(source(program_source)),
	)

	match first_function_body(program):
		Some(ParsedStringInterpolationPartsExpr(parts, _, _)):
			(
				parts.length() == 2
				and interpolation_expr_name_at(parts, 0) == "name"
				and interpolation_expr_name_at(parts, 1) == "name"
				and program.diagnostics.length() == 0
			)
		_:
			False


func test_finalize_interpolation_program_preserves_sibling_diagnostic_order() -> Bool:
	path: String = "interp_siblings.brp"
	module_name: String = "interp_siblings"
	program_source: String = "func message():\n" + "\t\"first " + "$" + "{1 +}\"\n" + "\t\"clean\"\n" + "\t\"second " + "$" + "{2 +}\"\n" + "\t\"third " + "$" + "{3 +}" + "$" + "{4 +}\""

	program: ParsedProgram = finalize_interpolation_program(
		parse_compiler_source(source_file(path, module_name, program_source)),
	)

	expected_prefix: String = path + ":"

	(
		program.diagnostics.length() == 4
		and diagnostic_string_at(
			program,
			0,
		) == expected_prefix + "2:5: error: Parse error in interpolated expression: expected expression"
		and diagnostic_string_at(
			program,
			1,
		) == expected_prefix + "4:5: error: Parse error in interpolated expression: expected expression"
		and diagnostic_string_at(
			program,
			2,
		) == expected_prefix + "5:5: error: Parse error in interpolated expression: expected expression"
		and diagnostic_string_at(
			program,
			3,
		) == expected_prefix + "5:5: error: Parse error in interpolated expression: expected expression"
	)


func test_finalize_interpolation_diagnostic_keeps_source_path() -> Bool:
	path: String = "interp_origin.brp"
	module_name: String = "interp_origin"
	program_source: String = "func message(): \"bad " + "$" + "{1 +}\""
	program: ParsedProgram = finalize_interpolation_program(
		parse_compiler_source(source_file(path, module_name, program_source)),
	)

	match program.diagnostics.get(0):
		Some(diagnostic):
			expected: String = path + ":1:17: error: Parse error in interpolated expression: expected expression"
			(
				parse_diagnostic_to_string(diagnostic) == expected
				and diagnostic.span.start_offset == 16
				and diagnostic.span.end_offset == program_source.length()
				and diagnostic.span.start_line == 1
				and diagnostic.span.start_column == 17
				and diagnostic.span.end_line == 1
				and diagnostic.span.end_column == program_source.length() + 1
			)
		None:
			False


func test_finalize_interpolation_program_is_stack_bounded_for_deep_binary_spine() -> Bool:
	var expression: String = "\"" + "$" + "{name}\""
	var depth: Int = 0

	while depth < 2048:
		expression += " + \"\""
		depth += 1

	program_source: String = "func message(name: String): " + expression
	program: ParsedProgram = finalize_interpolation_program(
		parse_compiler_source(source(program_source)),
	)
	var current: Option[ParsedExpr] = first_function_body(program)
	var found_interpolation: Bool = False

	while current.is_some():
		match current:
			Some(ParsedBinaryExpr(_, left, _, _)):
				current = Some(left)
			Some(ParsedStringInterpolationPartsExpr(_, _, _)):
				found_interpolation = True
				current = None
			_:
				current = None

	program.diagnostics.is_empty() and found_interpolation


func test_finalize_interpolation_program_is_stack_bounded_for_deep_logical_spine() -> Bool:
	var expression: String = "True"
	var depth: Int = 0

	while depth < 2048:
		expression += " and True"
		depth += 1

	program_source: String = "pure func predicate() -> Bool: " + expression
	program: ParsedProgram = finalize_interpolation_program(
		parse_compiler_source(source(program_source)),
	)
	var current: Option[ParsedExpr] = first_function_body(program)
	var reached_leaf: Bool = False

	while current.is_some():
		match current:
			Some(ParsedLogicalExpr(_, left, _, _)):
				current = Some(left)
			Some(_):
				reached_leaf = True
				current = None
			None:
				current = None

	program.diagnostics.is_empty() and reached_leaf


func test_finalize_nested_functions_program_hoists_simple_nested_function() -> Bool:
	program_source: String = "func outer(x: Int) -> Int:\n\tfunc inner(y: Int) -> Int:\n\t\ty + 1\n\tinner(x)"
	program: ParsedProgram = finalize_nested_functions_program(
		parse_compiler_source(source(program_source)),
	)

	first_body_ok: Bool = match function_body_item_at(program, 1, 0):
		Some(ParsedVoidExpr(_)):
			True
		_:
			False

	call_ok: Bool = match function_body_item_at(program, 1, 1):
		Some(expr):
			call_callee_name(expr) == "__nested_outer_inner_0"
		_:
			False

	(
		program.diagnostics.length() == 0
		and program.decls.length() == 2
		and function_name_at(program, 0) == "__nested_outer_inner_0"
		and function_name_at(program, 1) == "outer"
		and first_body_ok
		and call_ok
	)


func test_finalize_nested_functions_program_hoists_nested_inside_nested() -> Bool:
	program_source: String = "func outer() -> Int:\n\tfunc middle() -> Int:\n\t\tfunc inner() -> Int:\n\t\t\t1\n\t\tinner()\n\tmiddle()"
	program: ParsedProgram = finalize_nested_functions_program(
		parse_compiler_source(source(program_source)),
	)

	middle_calls_inner: Bool = match function_body_item_at(program, 1, 1):
		Some(expr):
			call_callee_name(expr) == "__nested___nested_outer_middle_0_inner_1"
		_:
			False

	outer_calls_middle: Bool = match function_body_item_at(program, 2, 1):
		Some(expr):
			call_callee_name(expr) == "__nested_outer_middle_0"
		_:
			False

	(
		program.diagnostics.length() == 0
		and program.decls.length() == 3
		and function_name_at(program, 0) == "__nested___nested_outer_middle_0_inner_1"
		and function_name_at(program, 1) == "__nested_outer_middle_0"
		and function_name_at(program, 2) == "outer"
		and middle_calls_inner
		and outer_calls_middle
	)


func test_finalize_nested_functions_program_reports_parent_capture() -> Bool:
	program_source: String = "func outer() -> String:\n\tgreeting: String = \"hello\"\n\tfunc shout() -> String:\n\t\tgreeting + \"!\"\n\tshout()"
	program: ParsedProgram = finalize_nested_functions_program(
		parse_compiler_source(source(program_source)),
	)

	match program.diagnostics.get(0):
		Some(diagnostic):
			diagnostic.message.contains(
				"Nested function 'shout' cannot capture parent-scope identifier 'greeting'",
			)
		None:
			False


func test_finalize_nested_functions_program_allows_parameter_shadowing_parent_local() -> Bool:
	program_source: String = "func outer() -> String:\n\tvalue: String = \"parent\"\n\tfunc inner(value: String) -> String:\n\t\tvalue\n\tinner(\"child\")"
	program: ParsedProgram = finalize_nested_functions_program(
		parse_compiler_source(source(program_source)),
	)

	program.diagnostics.length() == 0 and program.decls.length() == 2


func test_finalize_nested_functions_program_rewrites_self_and_prior_sibling_once() -> Bool:
	program_source: String = "func outer() -> Int:\n\tfunc first() -> Int:\n\t\tfirst()\n\tfunc second() -> Int:\n\t\tfirst()\n\tsecond()"
	program: ParsedProgram = finalize_nested_functions_program(
		parse_compiler_source(source(program_source)),
	)

	first_calls_self: Bool = match function_body_item_at(program, 0, 0):
		Some(expr):
			call_callee_name(expr) == "__nested_outer_first_0"
		_:
			False

	second_calls_first: Bool = match function_body_item_at(program, 1, 0):
		Some(expr):
			call_callee_name(expr) == "__nested_outer_first_0"
		_:
			False

	outer_calls_second: Bool = match function_body_item_at(program, 2, 2):
		Some(expr):
			call_callee_name(expr) == "__nested_outer_second_1"
		_:
			False

	(
		program.diagnostics.length() == 0
		and first_calls_self
		and second_calls_first
		and outer_calls_second
	)


func test_finalize_nested_functions_program_preserves_ordered_rewrite_chains() -> Bool:
	program_source: String = "func outer() -> Int:\n\tfunc first() -> Int:\n\t\t1\n\tfunc __nested_outer_first_0() -> Int:\n\t\tfirst()\n\tfunc third() -> Int:\n\t\tfirst()\n\tthird()"
	program: ParsedProgram = finalize_nested_functions_program(
		parse_compiler_source(source(program_source)),
	)

	second_calls_self: Bool = match function_body_item_at(program, 1, 0):
		Some(expr):
			call_callee_name(expr) == "__nested_outer___nested_outer_first_0_1"
		_:
			False

	third_uses_composed_prior_rewrite: Bool = match function_body_item_at(program, 2, 0):
		Some(expr):
			call_callee_name(expr) == "__nested_outer_first_0"
		_:
			False

	second_calls_self and third_uses_composed_prior_rewrite


func test_finalize_typecheck_source_program_composes_interpolation_and_hoist() -> Bool:
	program_source: String = "func outer(name: String) -> String:\n\tfunc message(value: String) -> String:\n\t\t\"Hello " + "$" + "{value}!\"\n\tmessage(name)"
	program: ParsedProgram = finalize_typecheck_source_program(
		parse_compiler_source(source(program_source)),
	)

	helper_body_ok: Bool = match function_body_item_at(program, 0, 0):
		Some(ParsedStringInterpolationPartsExpr(parts, _, _)):
			parts.length() == 3
		_:
			False

	outer_call_ok: Bool = match function_body_item_at(program, 1, 1):
		Some(expr):
			call_callee_name(expr) == "__nested_outer_message_0"
		_:
			False

	(
		program.diagnostics.length() == 0
		and function_name_at(program, 0) == "__nested_outer_message_0"
		and function_name_at(program, 1) == "outer"
		and helper_body_ok
		and outer_call_ok
	)


func test_finalize_nested_functions_program_hoists_mixed_top_level_kinds() -> Bool:
	program_source: String = "record Box {value: Int}\ntrait BoxTrait:\n\tfunc value(self: Self) -> Int\nfunc outer() -> Int:\n\tfunc helper() -> Int:\n\t\t1\n\thelper()\nprivate func hidden() -> Int:\n\tfunc secret() -> Int:\n\t\t2\n\tsecret()\nimplements BoxTrait for Box:\n\tfunc value(self: Box) -> Int:\n\t\tfunc method_helper() -> Int:\n\t\t\t3\n\t\tmethod_helper()"
	program: ParsedProgram = finalize_nested_functions_program(
		parse_compiler_source(source(program_source)),
	)

	outer_calls_helper: Bool = match function_body_item_at(program, 3, 1):
		Some(expr):
			call_callee_name(expr) == "__nested_outer_helper_0"
		_:
			False

	hidden_calls_secret: Bool = match private_function_body_item_at(program, 5, 1):
		Some(expr):
			call_callee_name(expr) == "__nested_hidden_secret_1"
		_:
			False

	method_first_body_ok: Bool = match impl_method_body_item_at(program, 7, 0, 0):
		Some(ParsedVoidExpr(_)):
			True
		_:
			False

	method_calls_helper: Bool = match impl_method_body_item_at(program, 7, 0, 1):
		Some(expr):
			call_callee_name(expr) == "__nested_value_method_helper_2"
		_:
			False

	(
		program.diagnostics.length() == 0
		and program.decls.length() == 8
		and function_name_at(program, 2) == "__nested_outer_helper_0"
		and function_name_at(program, 3) == "outer"
		and function_name_at(program, 4) == "__nested_hidden_secret_1"
		and private_function_name_at(program, 5) == "hidden"
		and function_name_at(program, 6) == "__nested_value_method_helper_2"
		and outer_calls_helper
		and hidden_calls_secret
		and method_first_body_ok
		and method_calls_helper
	)


func test_finalize_interpolation_program_handles_deep_logical_chain() -> Bool:
	var expression: String = "\"" + "$" + "{1}\" == \"1\""

	for _ in 0..DEEP_LOGICAL_TERM_COUNT:
		expression += " and True"

	program: ParsedProgram = finalize_interpolation_program(
		parse_compiler_source(source("func deep() -> Bool:\n\t${expression}")),
	)

	match function_body_item_at(program, 0, 0):
		Some(body):
			var current: ParsedExpr = body
			var logical_count: Int = 0
			var valid: Bool = True

			while valid:
				match current:
					ParsedLogicalExpr(_, left, ParsedBoolLiteralExpr(True, _), _):
						logical_count += 1
						current = left
					ParsedBinaryExpr(_, ParsedStringInterpolationPartsExpr(parts, _, _), _, _):
						valid = match parts:
							[ParsedInterpolationExpr(_)]:
								True
							_:
								False

						break
					_:
						valid = False

			program.diagnostics.length() == 0 and valid and logical_count == DEEP_LOGICAL_TERM_COUNT
		None:
			False


func test_finalize_typecheck_source_program_rewrites_one_index_subscript_read() -> Bool:
	program_source: String = "func first(values: Int[#3]) -> Int:\n\tvalues[0]"
	program: ParsedProgram = finalize_typecheck_source_program(
		parse_compiler_source(source(program_source)),
	)

	match function_body_item_at(program, 0, 0):
		Some(expr):
			call_callee_name(expr) == "checked_get"
		_:
			False


func test_finalize_typecheck_source_program_rewrites_range_subscript_read() -> Bool:
	program_source: String = "func part(values: Int[#4]) -> Int[#2]:\n\tvalues[1..3]"
	program: ParsedProgram = finalize_typecheck_source_program(
		parse_compiler_source(source(program_source)),
	)

	match function_body_item_at(program, 0, 0):
		Some(expr):
			call_callee_name(expr) == "checked_slice"
		_:
			False


func test_finalize_typecheck_source_program_rewrites_matrix_subscript_read() -> Bool:
	program_source: String = "func cell(values: Int[#2, #2]) -> Int:\n\tvalues[0, 1]"
	program: ParsedProgram = finalize_typecheck_source_program(
		parse_compiler_source(source(program_source)),
	)

	match function_body_item_at(program, 0, 0):
		Some(expr):
			call_callee_name(expr) == "matrix_checked_get"
		_:
			False


func test_finalize_typecheck_source_program_keeps_subscript_assignment() -> Bool:
	program_source: String = "func write(values: Int[#3]):\n\tvalues[0] = 1"
	program: ParsedProgram = finalize_typecheck_source_program(
		parse_compiler_source(source(program_source)),
	)

	match function_body_item_at(program, 0, 0):
		Some(ParsedSubscriptAssignExpr(_, indices, _, _)):
			indices.length() == 1
		Some(ParsedSubscriptExpr(_, _, _)):
			False
		_:
			False


func test_finalized_program_rewrites_import_path_without_losing_phase() -> Bool:
	program_source: String = "import:\n\tutil\n\nfunc main(args: List[String]) -> Int:\n\t0"
	rewrites: List[FinalizedImportPathRewrite] = [
		{
			from_path = "demo.brp",
			from_module = "demo",
			import_path = "util",
			resolved_module = "pkg/util"
		},
	]
	finalized = finalized_typecheck_program(parse_compiler_source(source(program_source)))
	rewritten = finalized_typecheck_program_rewrite_import_paths(
		finalized,
		"demo.brp",
		"demo",
		rewrites,
	)
	program = finalized_typecheck_program_ast(rewritten)

	match program.decls.get(0):
		Some(ImportBlockParsedDecl(imports, _)):
			imports
				.get(0)
				.map(func(import_decl): import_decl.module_path) == Some("pkg/util")
		_:
			False


