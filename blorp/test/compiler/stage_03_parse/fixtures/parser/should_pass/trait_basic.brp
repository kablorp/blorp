-- Test: basic trait declaration with methods
-- Method names are intentionally non-standard (not `equals`, `show`, etc.)
-- so this parser-focused test doesn't collide with the builtin trait
-- method registry; see `Env.trait_function_collision` /
-- `add_trait_function_checked`.
trait Renderable:
	pure func render(value: Self) -> String


trait Comparable:
	pure func same(a: Self, b: Self) -> Bool
	pure func different(a: Self, b: Self) -> Bool:
		not same(a, b)


trait Rankable: Comparable:
	pure func rank(a: Self, b: Self) -> Int
