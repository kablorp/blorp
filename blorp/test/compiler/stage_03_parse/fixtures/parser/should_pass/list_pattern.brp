-- List pattern parsing: all forms of list patterns in match
func empty_match(xs: List[Int]) -> String:
	match xs:
		[]: "empty"
		_: "non-empty"


func single_match(xs: List[Int]) -> Int:
	match xs:
		[x]: x
		_: 0


func exact_two(xs: List[Int]) -> Int:
	match xs:
		[a, b]: a + b
		_: 0


func head_rest(xs: List[Int]) -> Int:
	match xs:
		[]: 0
		[x, ...rest]: x


func spread_wildcard(xs: List[Int]) -> Int:
	match xs:
		[]: 0
		[x, ..._]: x


func spread_only(xs: List[Int]) -> Int:
	match xs:
		[...rest]: 0


func spread_discard(xs: List[Int]) -> String:
	match xs:
		[..._]: "any"


func two_plus_rest(xs: List[Int]) -> Int:
	match xs:
		[]: 0
		[x]: x
		[a, b, ...rest]: a + b
