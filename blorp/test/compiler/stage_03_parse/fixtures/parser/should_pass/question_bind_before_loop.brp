-- Test: `?=` before a loop, `?=` in a lambda outside a loop, and loop control in a nested function's own loop
func sum_after_first(values: List[Int]) -> Option[Int]:
	first ?= values.get(0)
	var total: Int = first
	for value in values:
		if value < 0:
			continue
		if value > 100:
			break
		total += value
	Some(total)


func lambda_bind(value: Option[Int]) -> Option[Int]:
	bind = func(item: Option[Int]) -> Option[Int]:
		inner ?= item
		Some(inner + 1)
	bind(value)


func loop_inside_nested_function(limit: Int) -> Int:
	func count_to(bound: Int) -> Int:
		var index: Int = 0
		while True:
			if index >= bound:
				break
			index += 1
		index
	count_to(limit)
