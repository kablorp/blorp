-- Test: foreign block declarations parse correctly
foreign(include: "math.h", link: "-lm"):
	func sin(x: Float) -> Float
	func cos(x: Float) -> Float
	func sqrt(x: Float) -> Float


-- Foreign block with mixed default and explicit C names
foreign(include: "stdlib.h"):
	func abs(x: Int) -> Int
	func my_exit(code: Int) -> Void = "exit"


-- Foreign block without args
foreign:
	func my_puts(s: String) -> Int = "puts"
	private pure func hidden_abs(x: Int) -> Int = "abs"


func main(args: List[String]) -> Int:
	0
