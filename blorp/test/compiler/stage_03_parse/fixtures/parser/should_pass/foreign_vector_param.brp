-- Test: foreign function declarations with Vector/Tensor parameters parse correctly
-- Foreign with Float parameter (variadic dims, auto-expands to data_ptr + len)
foreign:
	@no_copy func process_floats(data: Float[#Ds...]) -> Float
	-- Foreign with Int parameter (variadic dims)
	@no_copy func sum_ints(data: Int[#Ds...]) -> Int
	-- Foreign with Float32 parameter (variadic dims)
	@no_copy func process_f32(data: Float32[#Ds...]) -> Float32
	-- Foreign with fixed-dim vector parameter
	@no_copy func dot3(a: Float[#3]) -> Float
	-- Foreign with multiple Tensor params and other params
	@no_copy func weighted_sum(weights: Float[#Ds...], values: Float[#Ds...], scale: Float) -> Float
	-- Foreign with Tensor param and String param (both auto-converted)
	@no_copy func save_data(path: String, data: Float[#Ds...]) -> Int


func main(args: List[String]) -> Int:
	0
