func test_basic(x: Int) -> Int:
	if x > 0:
		1
	else:
		0


-- comment between if and else
func test_else_if(x: Int) -> Int:
	if x > 10:
		2
	else if x > 0:
		1
	else:
		0


-- comment
func test_multiple_comments(x: Int) -> Int:
	if x > 0:
		1
	else:
		0


-- first comment
-- second comment
func test_nested(x: Int, y: Int) -> Int:
	if x > 0:
		if y > 0:
			2
		else:
			1
	else:
		0
-- inner comment
-- outer comment
