-- Regression test: multiline function calls inside lambda bodies must parse.
func apply(
	f: (Int) -> Int,
	x: Int,
) -> Int:
	f(x)


func multi_arg(a: Int, b: Int, c: Int) -> Int:
	a + b + c


func main(args: List[String]) -> Int:
	result: Int = apply(func(x: Int): multi_arg(x, x + 1, x + 2), 10)
	result
