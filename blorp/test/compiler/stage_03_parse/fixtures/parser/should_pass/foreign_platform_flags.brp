-- Test: per-platform link flags parse on every host.
-- The parser must NOT shell out to `uname` — platform filtering
-- belongs to the pipeline/codegen so cross-compilation stays possible.
foreign(include: "stdio.h", link_linux: "-ldl", link_macos: "-framework CoreFoundation"):
	func my_puts(s: String) -> Int = "puts"


func main(args: List[String]) -> Int:
	0
