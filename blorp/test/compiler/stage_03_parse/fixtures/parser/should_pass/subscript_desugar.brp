-- Phase 2.3 regression: subscript syntax parses fine AND typechecks
-- after Subscript_desugar rewrites it into call form at the typecheck
-- entry point (not at parse time — the formatter still sees raw
-- subscripts).
-- 1-D read — desugar produces `checked_get(v, i)`
func one_d(v: Int[#3]) -> Int:
	v[0] + v[1] + v[2]


-- 1-D range slice — desugar produces `checked_slice(v, s, e)`
func one_d_slice(v: Int[#5]) -> Int[#3]:
	v[1..4]


-- 2-D read — desugar produces `matrix_checked_get(m, i, j)`
func two_d(m: Int[#2, #3]) -> Int:
	m[0, 0] + m[1, 2]


-- 3-D read — desugar produces `tensor3_checked_get(t, i, j, k)`
func three_d(t: Int[#2, #2, #2]) -> Int:
	t[0, 0, 0] + t[1, 1, 1]


-- 2-D assignment — ESubscriptAssign stays in infer (mutability check)
func two_d_assign() -> Int[#2, #2]:
	var m: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	m[0, 0] = 99
	m


-- Edge cases: verify the pass recurses into every scope that could
-- legally contain a subscript. If expr_map_children ever regresses,
-- these would fail with "subscript-read node reached typecheck".
-- Inside a lambda body — literal index so the bounds prover is
-- satisfied. The point is that expr_map_children recurses into
-- lam_body; the index value itself is incidental.
func subscript_in_lambda(v: Int[#3]) -> Int:
	f: () -> Int = func(): v[0]
	f()


-- Inside a match case body
func subscript_in_match(v: Int[#3], x: Int) -> Int:
	match x:
		0: v[0]
		_: v[1]
