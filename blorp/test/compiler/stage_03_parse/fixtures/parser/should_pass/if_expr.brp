-- Test if/else expression parsing
func test_if_simple() -> Int:
	if True:
		1
	else:
		0


func test_if_comparison() -> Int:
	x: Int = 5
	if x > 0:
		1
	else:
		0


func test_nested() -> String:
	x: Int = 5
	if x > 0:
		"positive"
	else if x < 0:
		"negative"
	else:
		"zero"


func test_if_in_var() -> Int:
	result: Int = if True:
		42
	else:
		0
	result


func test_if_inline() -> Int:
	if 1 > 0:
		100
	else:
		200
