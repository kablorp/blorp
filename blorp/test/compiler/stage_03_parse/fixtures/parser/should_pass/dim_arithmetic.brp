-- Test: Dimension arithmetic in type expressions
-- #M + #N and #M * #N should parse as TyDimOp
-- Addition of two dimension variables
pure func concat_dims[T, #M, #N](a: T[#M], b: T[#N]) -> T[#M + #N]:
	builtin


-- Multiplication of two dimension variables
pure func tile_dims[T, #M, #N](a: T[#M]) -> T[#M * #N]:
	builtin


-- Dimension variable + constant
pure func pad_one[T, #N](a: T[#N]) -> T[#N + #1]:
	builtin


-- Dimension variable * constant
pure func double_dim[T, #N](a: T[#N]) -> T[#N * #2]:
	builtin


-- Constant + dimension variable
pure func prepend[T, #N](a: T[#N]) -> T[#1 + #N]:
	builtin


-- In function parameter types
pure func process[T, #M, #N](input: T[#M + #N]) -> Int:
	0


-- Multiple dimension arithmetic in same type
pure func reshape2d[T, #M, #N](input: T[#M * #N, #M + #N]) -> Int:
	0
