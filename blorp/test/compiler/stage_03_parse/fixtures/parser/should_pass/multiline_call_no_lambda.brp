-- Test that basic multiline function calls (no lambdas) parse correctly.
-- These should work regardless of lambda handling.
import:
	list as L
	option: Option(Some, None)


-- Simple multiline call
func test_multiline_call() -> Bool:
	L.fold_left([1, 2, 3], 0, func(a: Int, b: Int): a + b) == 6


-- Call with trailing comma
func test_trailing_comma() -> Int:
	L.fold_left([10, 20, 30], 0, func(a: Int, b: Int): a + b)


func main(args: List[String]) -> Int:
	if test_multiline_call():
		0
	else:
		1
