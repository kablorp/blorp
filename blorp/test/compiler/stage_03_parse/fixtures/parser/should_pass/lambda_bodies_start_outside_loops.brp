-- RUN-BLORP-CHECK
-- TEST: `?=` in an Option-returning lambda inside a `for`, and a loop inside a lambda inside a loop
func bind_each(values: List[Int]) -> Int:
	var count: Int = 0
	for value in values:
		bind = func(item: Option[Int]) -> Option[Int]:
			inner ?= item
			Some(inner + 1)
		if bind(Some(value)).is_some():
			count += 1
	count


func nested_loop_in_lambda(values: List[Int]) -> Int:
	var total: Int = 0
	for value in values:
		count_up = func(bound: Int) -> Int:
			var index: Int = 0
			for step in [1, 2, 3]:
				if step > bound:
					break
				index += 1
			index
		total += count_up(value)
	total
