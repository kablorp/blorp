-- RUN-BLORP-CHECK
-- EXPECT-BLORP: error: `break` can only be used inside a loop
-- EXPECT-BLORP: help: move `break` into a `while` or `for` body, or remove it
-- EXPECT-DISCOVERY: BreakOutsideLoopDiagnostic 8:9
-- TEST: `break` at function level is rejected by the parser
func stop(flag: Bool) -> Int:
	if flag:
		break
	0
