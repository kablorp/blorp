-- RUN-BLORP-CHECK
-- EXPECT-BLORP: error: a string with `${...}` holes cannot be a match pattern
-- EXPECT-BLORP: help: match the plain string, or bind it and compare with `==` in the arm
-- EXPECT-DISCOVERY: InterpolatedStringPatternDiagnostic 8:9
-- A string with holes has no fixed value to compare with, so it cannot be a pattern.
func main(args: List[String]) -> Int:
	match "s":
		"a${x}": 1
		_: 0
	0
