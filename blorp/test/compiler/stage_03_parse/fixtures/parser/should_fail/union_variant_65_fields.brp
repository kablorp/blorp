-- RUN-BLORP-CHECK
-- EXPECT-BLORP: error: Union variants support at most 64 fields
-- EXPECT-BLORP: help: group related fields into a record and use the record as one field
-- EXPECT-DISCOVERY: UnionVariantTooManyFieldsDiagnostic 7:5
-- A variant payload's ownership bitmask has one bit per field, so a 65th field is rejected
union TooWide:
	Wide(Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int)
	Narrow(Int)
