-- RUN-BLORP-CHECK
-- EXPECT-BLORP: error: `match` is a reserved keyword and cannot be used as a name; choose another identifier such as `match_name`
-- EXPECT-BLORP-NOT-CONTAINS: expected expression
-- TEST: a keyword as a match pattern binding reports the keyword once
func classify(value: Int) -> Int:
	match value:
		0:
			0
		match:
			1


func main(args: List[String]) -> Int:
	classify(1)
