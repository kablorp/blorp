-- RUN-BLORP-CHECK
-- EXPECT-BLORP: error: `?=` cannot be used inside a loop body
-- EXPECT-BLORP: help: bind it before the loop, or use `match` inside the loop
-- EXPECT-BLORP-CONTAINS: :10:15: error:
-- EXPECT-DISCOVERY: QuestionBindInLoopDiagnostic 10:15
-- TEST: `?=` in a while body is rejected by the parser
func first(values: List[Int]) -> Option[Int]:
	var index = 0
	while index < 3:
		value ?= values.get(index)
		index += 1
	Some(index)
