-- RUN-BLORP-CHECK
-- EXPECT-BLORP: error: `?=` cannot be used inside a loop body
-- EXPECT-BLORP: help: bind it before the loop, or use `match` inside the loop
-- EXPECT-DISCOVERY: QuestionBindInLoopDiagnostic 9:19
-- TEST: `?=` in an if block nested in a loop body is rejected by the parser
func first(values: List[Int], flag: Bool) -> Option[Int]:
	for index in values:
		if flag:
			value ?= values.get(index)
	Some(0)
