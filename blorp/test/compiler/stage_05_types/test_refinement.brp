import:
	../../../src/compiler/stage_05_types/refinement:
		CollectionIdentity,
		DimensionIdentity,
		NarrowedSubject(NarrowedAlias, NarrowedBinding),
		OffsetRejection(OffsetNoMatchingBound, OffsetOutOfBounds),
		OffsetSubscriptProof(OffsetProven, OffsetRejected),
		PROOF_ENV_EMPTY,
		ProofSource(
			ProofSourceCondition,
			ProofSourceLoopEnumerate,
			ProofSourceLoopIndices,
			ProofSourceLoopRange,
		),
		ProvenCollection,
		RangeUpper,
		SubscriptBound,
		UNREFINED_BINDING,
		ValueProofs(NoValueProofs, RangeAndSubscriptValueProofs, SubscriptValueProofs),
		binding_add_range_proof,
		binding_add_subscript_proof,
		binding_direct_collection_vars,
		binding_proves_direct_range,
		binding_proves_offset_range,
		binding_proves_subscript,
		branch_range_proof,
		branch_range_subject,
		collection_dim,
		collection_dim_at_most,
		collection_identity,
		collection_identity_name,
		collection_length_bound,
		collection_subscript,
		collection_var,
		constant_dim_bound,
		covers_const_dim,
		covers_const_dim_with_offset,
		covers_same_collection,
		covers_same_collection_with_offset,
		dimension_bound,
		dimension_identity,
		dimension_identity_name,
		immutable_alias_subject,
		immutable_subject,
		make_branch_range_proof,
		make_range_proof,
		make_range_proof_with_source,
		make_subscript_proof,
		mutable_subject,
		proof_env_add_range_bounds,
		proof_env_add_subscript,
		proof_env_apply_subscript_to_binding,
		proof_env_find_range,
		proof_env_without_range,
		proof_env_without_subscript,
		proof_sources_equal,
		proven_collections_equal,
		proves_direct_subscript,
		proves_direct_subscript_with_bounds,
		proves_offset_subscript,
		range_binding,
		range_proof_source,
		range_upper_at_most_length,
		range_upper_dimension,
		range_upper_length_minus,
		range_upper_lit,
		subscript_bounds,
		subscript_proof_source,
	test: TestSuite


func test_unrefined_binding_is_allocation_free_empty_proofs() -> Bool:
	match UNREFINED_BINDING:
		NoValueProofs:
			True
		_:
			False


func test_proof_updates_preserve_the_other_proof_kind() -> Bool:
	match (upper_lit(4), upper_lit(10)):
		(Some(lit4), Some(lit10)):
			match (coll_var("xs"), coll_var("ys"), bound_const(4), bound_const(10)):
				(Some(xs), Some(ys), Some(bound4), Some(bound10)):
					match (make_range_proof(0, lit4), make_range_proof(0, lit10)):
						(Some(range4), Some(range10)):
							subscript_only = UNREFINED_BINDING.binding_add_subscript_proof(
								xs,
								ProofSourceLoopIndices,
							)
							combined = subscript_only.binding_add_range_proof(range4)
							replaced_subscript = combined.binding_add_subscript_proof(
								ys,
								ProofSourceLoopEnumerate,
							)
							replaced_range = replaced_subscript.binding_add_range_proof(range10)

							match (subscript_only, combined, replaced_subscript, replaced_range):
								(SubscriptValueProofs(_), RangeAndSubscriptValueProofs(_, _), RangeAndSubscriptValueProofs(_, _), RangeAndSubscriptValueProofs(_, _)):
									(
										binding_proves_subscript(combined, xs)
										and binding_proves_direct_range(combined, [bound4])
										and binding_proves_subscript(replaced_subscript, ys)
										and not binding_proves_subscript(replaced_subscript, xs)
										and binding_proves_direct_range(
											replaced_subscript,
											[bound4],
										)
										and binding_proves_subscript(replaced_range, ys)
										and binding_proves_direct_range(replaced_range, [bound10])
										and not binding_proves_direct_range(
											replaced_range,
											[bound4],
										)
									)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


func coll_id(name: String) -> Option[CollectionIdentity]:
	collection_identity(name)


func dim_id(name: String) -> Option[DimensionIdentity]:
	dimension_identity(name)


func coll_var(name: String) -> Option[ProvenCollection]:
	match coll_id(name):
		Some(identity):
			Some(collection_var(identity))
		None:
			None


func upper_lit(value: Int) -> Option[RangeUpper]:
	range_upper_lit(value)


func bound_const(value: Int) -> Option[SubscriptBound]:
	constant_dim_bound(value)


func bound_coll(name: String) -> Option[SubscriptBound]:
	match coll_id(name):
		Some(identity):
			Some(collection_length_bound(identity))
		None:
			None


func bound_dim(name: String) -> Option[SubscriptBound]:
	match dim_id(name):
		Some(identity):
			Some(dimension_bound(identity))
		None:
			None


func upper_dim(name: String) -> Option[RangeUpper]:
	match dim_id(name):
		Some(identity):
			Some(range_upper_dimension(identity))
		None:
			None


func upper_length_minus(name: String, end_offset: Int) -> Option[RangeUpper]:
	match coll_id(name):
		Some(identity):
			range_upper_length_minus(identity, end_offset)
		None:
			None


func upper_at_most(name: String) -> Option[RangeUpper]:
	match coll_id(name):
		Some(identity):
			Some(range_upper_at_most_length(identity))
		None:
			None


func test_collection_identity_and_proofs() -> Bool:
	match (coll_id("matrix"), coll_id("row"), coll_var("matrix")):
		(Some(matrix), Some(row), Some(matrix_collection)):
			match (collection_dim(4), collection_dim(8)):
				(Some(dim4), Some(dim8)):
					a = collection_subscript(matrix_collection, row)
					b = collection_subscript(collection_var(matrix), row)

					(
						collection_identity_name(matrix) == "matrix"
						and collection_identity(" ").is_none()
						and collection_dim(-1).is_none()
						and proven_collections_equal(a, b)
						and collection_dim_at_most(dim4, 8)
						and not collection_dim_at_most(dim8, 4)
					)
				_:
					False
		_:
			False


func test_identity_names_preserve_validated_input() -> Bool:
	match (coll_id("matrix"), dim_id("#N")):
		(Some(collection), Some(dimension)):
			(
				collection_identity_name(collection) == "matrix"
				and dimension_identity_name(dimension) == "#N"
			)
		_:
			False


func test_range_upper_and_direct_bounds() -> Bool:
	match (upper_lit(5), upper_lit(-1), upper_length_minus("xs", 1), upper_length_minus("xs", -1)):
		(Some(lit5), None, Some(length_minus), None):
			match upper_at_most("xs"):
				Some(at_most):
					literal_proof_opt = make_range_proof(0, lit5)
					length_proof_opt = make_range_proof(0, length_minus)
					at_most_proof_opt = make_range_proof(0, at_most)

					match (literal_proof_opt, length_proof_opt, at_most_proof_opt, coll_id("xs")):
						(Some(literal_proof), Some(length_proof), Some(at_most_proof), Some(xs)):
							(
								covers_const_dim(literal_proof, 5)
								and not covers_const_dim(literal_proof, 4)
								and covers_same_collection(length_proof, xs)
								and covers_same_collection(at_most_proof, xs)
							)
						_:
							False
				None:
					False
		_:
			False


func test_dimension_bounds_and_offsets() -> Bool:
	match (upper_dim("#N"), bound_dim("#N"), bound_dim("#M"), upper_lit(5)):
		(Some(dim_upper), Some(bound_n), Some(bound_m), Some(lit5)):
			match (upper_length_minus("xs", 1), coll_id("xs")):
				(Some(length_minus), Some(xs)):
					dim_proof_opt = make_range_proof(0, dim_upper)
					literal_proof_opt = make_range_proof(0, lit5)
					symbolic_proof_opt = make_range_proof(0, length_minus)

					match (dim_proof_opt, literal_proof_opt, symbolic_proof_opt):
						(Some(dim_proof), Some(literal_proof), Some(symbolic_proof)):
							(
								proves_direct_subscript(dim_proof, [bound_n])
								and not proves_direct_subscript(dim_proof, [bound_m])
								and match proves_offset_subscript(dim_proof, [bound_n], 1):
									OffsetRejected(OffsetNoMatchingBound):
										True
									_:
										False
								and match covers_const_dim_with_offset(literal_proof, 6, 1):
									Ok(_):
										True
									Err(_):
										False
								and match covers_const_dim_with_offset(literal_proof, 5, 1):
									Err(message):
										message.length() > 0
									Ok(_):
										False
								and covers_same_collection_with_offset(symbolic_proof, xs, 1)
								and not covers_same_collection_with_offset(symbolic_proof, xs, 2)
							)
						_:
							False
				_:
					False
		_:
			False


func test_bounds_grouping_and_dispatch() -> Bool:
	match (bound_const(4), bound_coll("xs"), upper_lit(4), upper_at_most("xs")):
		(Some(const4), Some(xs_bound), Some(lit4), Some(at_most)):
			bounds = subscript_bounds([const4, xs_bound])
			literal_proof_opt = make_range_proof(0, lit4)
			symbolic_proof_opt = make_range_proof(0, at_most)

			match (literal_proof_opt, symbolic_proof_opt):
				(Some(literal_proof), Some(symbolic_proof)):
					(
						proves_direct_subscript_with_bounds(literal_proof, bounds)
						and proves_direct_subscript(
							symbolic_proof,
							[const4, xs_bound],
						)
						and match proves_offset_subscript(literal_proof, [const4], 1):
							OffsetRejected(OffsetOutOfBounds(message)):
								message.length() > 0
							_:
								False
						and bound_const(-1).is_none()
					)
				_:
					False
		_:
			False


func test_proof_env_replaces_shadowed_proofs() -> Bool:
	match (coll_id("i"), coll_var("xs"), coll_var("ys"), upper_lit(4)):
		(Some(i), Some(xs), Some(ys), Some(lit4)):
			match (upper_lit(8), bound_const(8), bound_const(4)):
				(Some(lit8), Some(bound8), Some(bound4)):
					env = PROOF_ENV_EMPTY
						.proof_env_add_subscript(i, xs, ProofSourceLoopRange)
						.proof_env_add_subscript(i, ys, ProofSourceLoopIndices)
						.proof_env_add_range_bounds(i, 0, lit4, ProofSourceLoopRange)
						.proof_env_add_range_bounds(i, 0, lit8, ProofSourceLoopIndices)
					binding = proof_env_apply_subscript_to_binding(env, i, UNREFINED_BINDING)
					forgotten = env
						.proof_env_without_subscript(i)
						.proof_env_without_range(i)
					forgotten_binding = proof_env_apply_subscript_to_binding(
						forgotten,
						i,
						UNREFINED_BINDING,
					)

					match proof_env_find_range(env, i):
						Some(latest_range):
							(
								binding_proves_subscript(binding, ys)
								and not binding_proves_subscript(binding, xs)
								and proves_direct_subscript(latest_range, [bound8])
								and not proves_direct_subscript(latest_range, [bound4])
								and not binding_proves_subscript(forgotten_binding, ys)
								and proof_env_find_range(forgotten, i).is_none()
							)
						None:
							False
				_:
					False
		_:
			False


func test_sources_and_binding_metadata() -> Bool:
	match (upper_lit(4), coll_var("xs"), coll_var("ys"), bound_const(4)):
		(Some(lit4), Some(xs), Some(ys), Some(bound4)):
			range_opt = make_range_proof_with_source(0, lit4, ProofSourceLoopRange)
			subscript_proof = make_subscript_proof(xs, ProofSourceLoopEnumerate)

			match range_opt:
				Some(range):
					binding = UNREFINED_BINDING
						.binding_add_range_proof(range)
						.binding_add_subscript_proof(xs, ProofSourceLoopIndices)
					direct_vars = binding_direct_collection_vars(binding)

					(
						proof_sources_equal(range_proof_source(range), ProofSourceLoopRange)
						and proof_sources_equal(
							subscript_proof_source(subscript_proof),
							ProofSourceLoopEnumerate,
						)
						and binding_proves_subscript(binding, xs)
						and not binding_proves_subscript(binding, ys)
						and direct_vars.length() == 1
						and match direct_vars.get(0):
							Some(identity):
								collection_identity_name(identity) == "xs"
							None:
								False
						and binding_proves_direct_range(binding, [bound4])
					)
				None:
					False
		_:
			False


func test_offset_binding_and_branch_narrowing() -> Bool:
	match (upper_lit(4), upper_lit(10), bound_const(4), bound_const(10)):
		(Some(lit4), Some(lit10), Some(bound4), Some(bound10)):
			offset_range_opt = make_range_proof(1, lit4)
			immutable_opt = immutable_subject("i")
			alias_opt = immutable_alias_subject("j", "i")
			mutable_opt = mutable_subject("i")

			match offset_range_opt:
				Some(offset_range):
					match (immutable_opt, alias_opt):
						(Some(immutable), Some(alias_subject)):
							match mutable_opt:
								Some(subject_value):
									offset_binding = range_binding(offset_range)
									immutable_proof_result = make_branch_range_proof(
										immutable,
										0,
										lit10,
									)
									alias_proof_result = make_branch_range_proof(
										alias_subject,
										0,
										lit10,
									)
									mutable_result = make_branch_range_proof(
										subject_value,
										0,
										lit10,
									)

									negative_offset_proven: Bool = match binding_proves_offset_range(
										offset_binding,
										[bound4],
										-1,
									):
										OffsetProven:
											True
										_:
											False

									positive_offset_rejected: Bool = match binding_proves_offset_range(
										offset_binding,
										[bound4],
										1,
									):
										OffsetRejected(OffsetOutOfBounds(_)):
											True
										_:
											False

									immutable_narrowed: Bool = match immutable_proof_result:
										Ok(proof):
											match branch_range_subject(proof):
												NarrowedBinding(identity):
													(
														collection_identity_name(identity) == "i"
														and proves_direct_subscript(
															branch_range_proof(proof),
															[bound10],
														)
													)
												_:
													False
										Err(_):
											False

									alias_narrowed: Bool = match alias_proof_result:
										Ok(proof):
											match branch_range_subject(proof):
												NarrowedAlias(alias_id, target_id):
													(
														collection_identity_name(alias_id) == "j"
														and collection_identity_name(
															target_id,
														) == "i"
													)
												_:
													False
										Err(_):
											False

									mutable_rejected: Bool = match mutable_result:
										Err(MutableSubjectCannotNarrow):
											True
										_:
											False

									(
										negative_offset_proven
										and positive_offset_rejected
										and immutable_narrowed
										and alias_narrowed
										and mutable_rejected
										and immutable_subject("").is_none()
									)
								None:
									False
						_:
							False
				None:
					False
		_:
			False


tests: TestSuite = {
	description = "Compiler refinement proofs",
	tests = [
		(
			"unrefined binding is allocation-free empty proofs",
			test_unrefined_binding_is_allocation_free_empty_proofs,
		),
		(
			"proof updates preserve the other proof kind",
			test_proof_updates_preserve_the_other_proof_kind,
		),
		("collection identity and proofs", test_collection_identity_and_proofs),
		("identity names preserve validated input", test_identity_names_preserve_validated_input),
		("range upper and direct bounds", test_range_upper_and_direct_bounds),
		("dimension bounds and offsets", test_dimension_bounds_and_offsets),
		("bounds grouping and dispatch", test_bounds_grouping_and_dispatch),
		("proof env replaces shadowed proofs", test_proof_env_replaces_shadowed_proofs),
		("sources and binding metadata", test_sources_and_binding_metadata),
		("offset binding and branch narrowing", test_offset_binding_and_branch_narrowing),
	]
}
