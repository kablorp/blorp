func test_lex_interpolated_pipe_string_literal() -> Bool:
	src: SourceFile = source("|hello $" + "{name}\n")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	lex_ok(result) and token_kind_is(result, 0, "interpolated pipe string literal:hello {name}")


func test_lex_raw_pipe_string_literal() -> Bool:
	src: SourceFile = source("raw\n  |hello $" + "{name}\n  |world")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)
	expected: String = "raw pipe string literal:hello $" + "{name}\nworld"

	lex_ok(result) and token_kind_is(result, 0, expected)


func test_lex_aligned_pipe_markers_preserve_edges() -> Bool:
	aligned_src: SourceFile = source("-- header\nraw\n  |first\n  |second")
	aligned: LexResult = lex(aligned_src, EMPTY_NAME_TABLE)
	wrong_margin: LexResult = lex(source("raw\n  |first\n |second"), EMPTY_NAME_TABLE)
	malformed: LexResult = lex(source("raw\n  first"), EMPTY_NAME_TABLE)

	aligned_trivia_ok: Bool = match aligned.tokens.get(0):
		Some(token):
			(leading, trailing) = token_trivia_of(aligned.trivia, token)

			match (leading.get(0), trailing.get(0)):
				(Some(trivia), None):
					trivia.kind == CommentTrivia and trivia.text == "-- header"
				_:
					False
		None:
			False

	(
		aligned.tokens.length() == 2
		and aligned.trivia.length() == 1
		and lex_ok(aligned)
		and token_kind_is(aligned, 0, "raw pipe string literal:first\nsecond")
		and token_span_is(aligned, 0, 10, 2, 1, 32, 4, 10)
		and token_kind_is(aligned, 1, "end of file")
		and aligned_trivia_ok
		and wrong_margin.diagnostics.length() == 0
		and wrong_margin.trivia.length() == 0
		and wrong_margin.tokens.length() == 6
		and token_kind_is(wrong_margin, 0, "raw pipe string literal:first")
		and token_span_is(wrong_margin, 0, 0, 1, 1, 13, 3, 1)
		and token_kind_is(wrong_margin, 1, "newline")
		and token_span_is(wrong_margin, 1, 14, 3, 2, 14, 3, 2)
		and token_kind_is(wrong_margin, 2, "indent")
		and token_span_is(wrong_margin, 2, 13, 3, 1, 14, 3, 2)
		and token_kind_is(wrong_margin, 3, "pipe string literal:second")
		and token_span_is(wrong_margin, 3, 14, 3, 2, 21, 3, 9)
		and token_kind_is(wrong_margin, 4, "dedent")
		and token_span_is(wrong_margin, 4, 21, 3, 9, 21, 3, 9)
		and token_kind_is(wrong_margin, 5, "end of file")
		and token_span_is(wrong_margin, 5, 21, 3, 9, 21, 3, 9)
		and malformed.diagnostics.length() == 0
		and malformed.trivia.length() == 0
		and malformed.tokens.length() == 6
		and token_kind_is(malformed, 0, "identifier:raw")
		and token_span_is(malformed, 0, 0, 1, 1, 3, 1, 4)
		and token_kind_is(malformed, 1, "newline")
		and token_span_is(malformed, 1, 6, 2, 3, 6, 2, 3)
		and token_kind_is(malformed, 2, "indent")
		and token_span_is(malformed, 2, 4, 2, 1, 6, 2, 3)
		and token_kind_is(malformed, 3, "identifier:first")
		and token_span_is(malformed, 3, 6, 2, 3, 11, 2, 8)
		and token_kind_is(malformed, 4, "dedent")
		and token_span_is(malformed, 4, 11, 2, 8, 11, 2, 8)
		and token_kind_is(malformed, 5, "end of file")
		and token_span_is(malformed, 5, 11, 2, 8, 11, 2, 8)
	)


-- Source text is scanned by byte, so a literal body has to be copied as bytes.
-- Rebuilding it one Char at a time re-encodes every byte of a multibyte
-- character as its own codepoint, which corrupts the token text.
func test_lex_raw_string_literal_preserves_multibyte_bytes() -> Bool:
	dash: String = "—"
	result: LexResult = lex(source("raw\"em " + dash + " dash\""), EMPTY_NAME_TABLE)

	lex_ok(result) and token_kind_is(result, 0, "raw string literal:em " + dash + " dash")


func test_lex_pipe_string_literal_preserves_multibyte_bytes() -> Bool:
	dash: String = "—"
	result: LexResult = lex(source("|em " + dash + " dash\n"), EMPTY_NAME_TABLE)

	lex_ok(result) and token_kind_is(result, 0, "pipe string literal:em " + dash + " dash")


func test_lex_raw_pipe_string_literal_preserves_multibyte_bytes() -> Bool:
	dash: String = "—"
	result: LexResult = lex(source("raw\n  |em " + dash + " dash"), EMPTY_NAME_TABLE)

	lex_ok(result) and token_kind_is(result, 0, "raw pipe string literal:em " + dash + " dash")


func test_lex_interpolated_string_tail_preserves_multibyte_bytes() -> Bool:
	dash: String = "—"
	result: LexResult = lex(source("\"pre $" + "{x} " + dash + " post\""), EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(result, 0, "interpolated string literal:pre {x} " + dash + " post")
	)


func test_lex_interpolated_pipe_string_literal_preserves_multibyte_bytes() -> Bool:
	dash: String = "—"
	result: LexResult = lex(source("|em " + dash + " $" + "{x} café\n"), EMPTY_NAME_TABLE)
	expected: String = "interpolated pipe string literal:em " + dash + " {x} café"

	lex_ok(result) and token_kind_is(result, 0, expected)


func test_lex_rejects_bad_string_escape() -> Bool:
	result: LexResult = lex(source("\"\\x\""), EMPTY_NAME_TABLE)

	match result.diagnostics.get(0):
		Some(diag):
			parse_diagnostic_to_string(diag).contains("unknown escape sequence")
		None:
			False


func test_lex_rejects_invalid_char_and_unicode_literals() -> Bool:
	bad_char: LexResult = lex(source("'ab'"), EMPTY_NAME_TABLE)
	surrogate: LexResult = lex(source("\"\\u{D800}\""), EMPTY_NAME_TABLE)
	too_large: LexResult = lex(source("'\\u{110000}'"), EMPTY_NAME_TABLE)

	match bad_char.diagnostics.get(0):
		Some(bad_char_diag):
			match surrogate.diagnostics.get(0):
				Some(surrogate_diag):
					match too_large.diagnostics.get(0):
						Some(too_large_diag):
							(
								parse_diagnostic_to_string(
									bad_char_diag,
								).contains("Invalid character literal")
								and parse_diagnostic_to_string(
									surrogate_diag,
								).contains("Unicode codepoint is out of range or a surrogate")
								and parse_diagnostic_to_string(
									too_large_diag,
								).contains("Unicode codepoint is out of range or a surrogate")
							)
						None:
							False
				None:
					False
		None:
			False


func test_lex_inconsistent_indent_diagnostic() -> Bool:
	src: SourceFile = source("if True:\n\t42\n  7\n")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	match result.diagnostics.get(0):
		Some(diag):
			parse_diagnostic_to_string(diag).contains("inconsistent indentation")
		None:
			False


func test_lex_rejects_integer_literal_over_int128() -> Bool:
	max_int128: String = "170141183460469231731687303715884105727"
	too_large: String = "9999999999999999999999999999999999999999"
	max_result: LexResult = lex(source(max_int128), EMPTY_NAME_TABLE)
	padded_result: LexResult = lex(source("0" + max_int128), EMPTY_NAME_TABLE)
	too_large_result: LexResult = lex(source(too_large), EMPTY_NAME_TABLE)

	match too_large_result.diagnostics.get(0):
		Some(diag):
			(
				lex_ok(max_result)
				and lex_ok(padded_result)
				and token_kind_is(max_result, 0, "int:" + max_int128)
				and not lex_ok(too_large_result)
				and parse_diagnostic_to_string(
					diag,
				).contains("Integer literal '" + too_large + "' exceeds Int128 range")
			)
		None:
			False


-- Protecting tests for the literal-scanner conversion: each scanner now
-- returns only what it found (end cursor, kind, span, diagnostics) instead
-- of threading a `LexerState`. These pin the exact span and diagnostic
-- shape for every literal form the conversion touched.
func test_lex_string_literal_escape_span_is_precise() -> Bool:
	src: SourceFile = source("\"a\\tb\"")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(result, 0, "string literal:a\tb")
		and token_span_is(result, 0, 0, 1, 1, 6, 1, 7)
	)


func test_lex_unicode_escape_span_is_precise() -> Bool:
	src: SourceFile = source("\"\\u{41}\"")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(result, 0, "string literal:A")
		and token_span_is(result, 0, 0, 1, 1, 8, 1, 9)
	)


func test_lex_unicode_escape_surrogate_diagnostic_span_is_precise() -> Bool:
	result: LexResult = lex(source("\"\\u{D800}\""), EMPTY_NAME_TABLE)

	match result.diagnostics.get(0):
		Some(diag):
			(
				not lex_ok(result)
				and parse_diagnostic_to_string(
					diag,
				).contains("Unicode codepoint is out of range or a surrogate")
				and diag.span.start_offset == 9
				and diag.span.end_offset == 9
				and diag.span.start_line == 1
				and diag.span.start_column == 10
			)
		None:
			False


func test_lex_interpolated_string_brace_escape_span_is_precise() -> Bool:
	src_text: String = "\"Value: $" + "{42}, literal: {not interpolated}\""
	result: LexResult = lex(source(src_text), EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(
			result,
			0,
			"interpolated string literal:Value: {42}, literal: \\{not interpolated\\}",
		)
		and token_span_is(result, 0, 0, 1, 1, 43, 1, 44)
	)


func test_lex_raw_string_multibyte_span_is_precise() -> Bool:
	dash: String = "—"
	result: LexResult = lex(source("raw\"em " + dash + " dash\""), EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(result, 0, "raw string literal:em " + dash + " dash")
		and token_span_is(result, 0, 0, 1, 1, 16, 1, 17)
	)


-- A raw pipe block whose interior lines use a tab for the aligned margin, with
-- a blank line encoded as a marker line with no body between two content
-- lines.
func test_lex_raw_pipe_block_with_tabs_and_interior_blank_line() -> Bool:
	result: LexResult = lex(source("raw\n\t|first\n\t|\n\t|third"), EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(result, 0, "raw pipe string literal:first\n\nthird")
		and token_span_is(result, 0, 0, 1, 1, 22, 4, 11)
	)


func test_lex_char_literal_span_is_precise() -> Bool:
	result: LexResult = lex(source("'a'"), EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(result, 0, "char:" + to_int('a').to_string())
		and token_span_is(result, 0, 0, 1, 1, 3, 1, 4)
	)


func test_lex_docstring_span_is_precise() -> Bool:
	result: LexResult = lex(source("---\nhi\n---\n"), EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(result, 0, "docstring:hi")
		and token_span_is(result, 0, 0, 1, 1, 11, 4, 1)
	)


-- A source with no comments at all: every token's leading and trailing
-- trivia runs are empty, and the flat `result.trivia` table itself is
-- empty (the `trivia_start`/`trivia_count` sentinel case, not a `None`
-- special case).
func test_lex_file_with_no_trivia_produces_empty_runs() -> Bool:
	src: SourceFile = source("func add(a: Int, b: Int) -> Int:\n\ta + b\n")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)
	var all_empty: Bool = True

	for token in result.tokens:
		(leading, trailing) = token_trivia_of(result.trivia, token)

		if leading.length() != 0 or trailing.length() != 0:
			all_empty = False

	lex_ok(result) and result.trivia.length() == 0 and all_empty


-- A single-token line preceded by an own-line comment and followed by a
-- trailing comment: that one token (the int literal `1`, the only token
-- on its line) carries both a leading trivia run and a trailing trivia
-- run, both recovered from the same flat `result.trivia` table.
private pure func is_int_literal(texts: List[String], token: Token) -> Bool:
	match token_kind_of(texts, token):
		IntLiteralToken(_):
			True
		_:
			False


private pure func find_int_literal_token(result: LexResult) -> Option[Token]:
	result.tokens.find(func(token): is_int_literal(result.texts, token))


func test_lex_single_token_has_both_leading_and_trailing_trivia() -> Bool:
	src: SourceFile = source("func compute() -> Int:\n\t-- comment above\n\t1 -- comment after\n")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	match find_int_literal_token(result):
		Some(one_token):
			(leading, trailing) = token_trivia_of(result.trivia, one_token)

			(
				lex_ok(result)
				and token_kind_name(token_kind_of(result.texts, one_token)) == "integer literal"
				and leading.length() == 1
				and trailing.length() == 1
				and match leading.get(0):
					Some(item):
						item.text == "-- comment above"
					None:
						False
				and match trailing.get(0):
					Some(item):
						item.text == "-- comment after"
					None:
						False
			)
		None:
			False


---
Discovery threads one `NameTable` through every file so the same spelling
anywhere in a compilation gets the same id, with no remap step: the second
file's lex starts from the first file's table and reuses its id for a
spelling both files already share, while a spelling new to the second file
gets the next unused id after the first file's.
---
func test_lex_threads_name_table_across_files() -> Bool:
	first: LexResult = lex(source("shared_name other_name"), EMPTY_NAME_TABLE)
	second: LexResult = lex(source("shared_name second_only"), first.names)

	shared_id_first = name_table_find_id(first.names, "shared_name")
	shared_id_second = name_table_find_id(second.names, "shared_name")
	second_only_id = name_table_find_id(second.names, "second_only")

	(
		name_table_count(first.names) == 2
		and name_table_count(second.names) == 3
		and shared_id_first == shared_id_second
		and second_only_id != shared_id_first
		and match second_only_id:
			Some(id):
				name_spelling(second.names, id) == Some("second_only")
			None:
				False
	)


---
A table not threaded in (`EMPTY_NAME_TABLE`) starts fresh: two
independent files that happen to share a spelling get independent ids
scoped to their own lex, matching the pre-existing single-file behavior.
---
func test_lex_without_threading_starts_a_fresh_table_per_file() -> Bool:
	first: LexResult = lex(source("alpha"), EMPTY_NAME_TABLE)
	second: LexResult = lex(source("alpha"), EMPTY_NAME_TABLE)

	name_table_count(first.names) == 1 and name_table_count(second.names) == 1


func test_lex_interns_a_hash_prefixed_spelling_beside_each_dimension_name() -> Bool:
	result: LexResult = lex(source("f[#N](x: T[#N, #M])\n"), EMPTY_NAME_TABLE)

	(
		name_table_find_id(result.names, "#N").is_some()
		and name_table_find_id(result.names, "#M").is_some()
		and name_table_find_id(result.names, "N").is_some()
		and name_table_find_id(result.names, "#T").is_none()
	)


func test_lex_hash_prefixed_spelling_needs_the_identifier_to_directly_follow_the_hash() -> Bool:
	-- A newline token separates the `#` from `Q`, so `Q` is not a dimension name.
	separated: LexResult = lex(source("#\nQ\n"), EMPTY_NAME_TABLE)
	-- An earlier `#N` must not make a later identifier at the same position count.
	later: LexResult = lex(source("f[#N](x, R)\n"), EMPTY_NAME_TABLE)

	(
		name_table_find_id(separated.names, "#Q").is_none()
		and name_table_find_id(later.names, "#N").is_some()
		and name_table_find_id(later.names, "#R").is_none()
	)


func test_synthesized_vocabulary_seeds_builtin_callees_bridge_names_and_tuple_fields() -> Bool:
	var seeded_digits: Bool = True
	var index: Int = 0

	while index < TUPLE_FIELD_SEEDED_COUNT:
		if name_table_find_id(SYNTHESIZED_NAME_TABLE, index.to_string()).is_none():
			seeded_digits = False

		index += 1

	(
		seeded_digits
		and name_table_find_id(
			SYNTHESIZED_NAME_TABLE,
			TUPLE_FIELD_SEEDED_COUNT.to_string(),
		).is_none()
		and name_spelling(
			SYNTHESIZED_NAME_TABLE,
			synthesized_name_id("tensor5_checked_set"),
		) == Some("tensor5_checked_set")
		and name_spelling(
			SYNTHESIZED_NAME_TABLE,
			synthesized_name_id("link_macos"),
		) == Some("link_macos")
		and name_spelling(SYNTHESIZED_NAME_TABLE, tuple_field_name_id(3)) == Some("3")
		and name_spelling(
			SYNTHESIZED_NAME_TABLE,
			tuple_field_name_id(TUPLE_FIELD_SEEDED_COUNT),
		).is_none()
	)


