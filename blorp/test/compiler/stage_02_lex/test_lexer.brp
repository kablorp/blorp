pure func source(text: String) -> SourceFile:
	source_file("lexer.brp", "lexer", text)


pure func token_signature(kind: TokenKind) -> String:
	match kind:
		IdentifierToken(name):
			"identifier:" + name
		IntLiteralToken(text):
			"int:" + text
		StringLiteralToken(kind, text):
			token_kind_name(StringLiteralToken(kind, text)) + ":" + text
		CharLiteralToken(codepoint):
			"char:" + codepoint.to_string()
		DocStringToken(text):
			"docstring:" + text
		KeywordToken(keyword):
			token_kind_name(KeywordToken(keyword))
		SymbolToken(symbol):
			token_kind_name(SymbolToken(symbol))
		NewlineToken:
			"newline"
		IndentToken:
			"indent"
		DedentToken:
			"dedent"
		EndOfFileToken:
			"end of file"
		_:
			token_kind_name(kind)


pure func token_kind_is(result: LexResult, index: Int, expected: String) -> Bool:
	match result.tokens.get(index):
		Some(token):
			token_signature(token_kind_of(result.texts, token)) == expected
		None:
			False


pure func token_span_is(
	result: LexResult,
	index: Int,
	start_offset: Int,
	start_line: Int,
	start_column: Int,
	end_offset: Int,
	end_line: Int,
	end_column: Int,
) -> Bool:
	match result.tokens.get(index):
		Some(token):
			span: SourceSpan = span_of(token, result.path, result.module_name)

			(
				span.path == "lexer.brp"
				and span.module_name == "lexer"
				and span.start_offset == start_offset
				and span.start_line == start_line
				and span.start_column == start_column
				and span.end_offset == end_offset
				and span.end_line == end_line
				and span.end_column == end_column
			)
		None:
			False


---
Pins the facts the symbol emission path owns: the cursor and column that a
multi-character symbol leaves behind (including across a tab), and the group
depth that decides whether a newline inside parentheses produces a token.
---
func test_lex_symbol_emission_spans_and_group_depth() -> Bool:
	src: SourceFile = source("a\t->b...c\n")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	grouped: LexResult = lex(source("f(\n\ta,\n\tb,\n)\n"), EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(result, 0, "identifier:a")
		and token_span_is(result, 0, 0, 1, 1, 1, 1, 2)
		and token_kind_is(result, 1, token_kind_name(SymbolToken(ArrowSymbol)))
		and token_span_is(result, 1, 2, 1, 5, 4, 1, 7)
		and token_kind_is(result, 2, "identifier:b")
		and token_span_is(result, 2, 4, 1, 7, 5, 1, 8)
		and token_kind_is(result, 3, token_kind_name(SymbolToken(DotDotDotSymbol)))
		and token_span_is(result, 3, 5, 1, 8, 8, 1, 11)
		and token_kind_is(result, 4, "identifier:c")
		and token_span_is(result, 4, 8, 1, 11, 9, 1, 12)
		and token_kind_is(result, 5, "end of file")
		and lex_ok(grouped)
		and grouped.tokens.map(
			func(
				token,
			): token_signature(
				token_kind_of(
					grouped.texts,
					token,
				),
			),
		) == [
			"identifier:f",
			token_kind_name(SymbolToken(LeftParenSymbol)),
			"identifier:a",
			token_kind_name(SymbolToken(CommaSymbol)),
			"identifier:b",
			token_kind_name(SymbolToken(CommaSymbol)),
			token_kind_name(SymbolToken(RightParenSymbol)),
			"end of file",
		]
	)


func test_lex_identifier_boundaries_preserve_exact_spans() -> Bool:
	long_name: String = (
		"identifier_that_is_deliberately_long_enough_to_exercise_the_complete_scanning_lo"
		+ "op"
	)
	src: SourceFile = source("first second,third\n_four record_value " + long_name)
	result: LexResult = lex(src, EMPTY_NAME_TABLE)
	long_start: Int = 38
	long_end: Int = long_start + long_name.length()

	(
		lex_ok(result)
		and result.tokens.length() == 9
		and token_kind_is(result, 0, "identifier:first")
		and token_span_is(result, 0, 0, 1, 1, 5, 1, 6)
		and token_kind_is(result, 1, "identifier:second")
		and token_span_is(result, 1, 6, 1, 7, 12, 1, 13)
		and token_kind_is(result, 3, "identifier:third")
		and token_span_is(result, 3, 13, 1, 14, 18, 1, 19)
		and token_kind_is(result, 5, "identifier:_four")
		and token_span_is(result, 5, 19, 2, 1, 24, 2, 6)
		and token_kind_is(result, 6, "identifier:record_value")
		and token_span_is(result, 6, 25, 2, 7, 37, 2, 19)
		and token_kind_is(result, 7, "identifier:" + long_name)
		and token_span_is(result, 7, long_start, 2, 20, long_end, 2, 20 + long_name.length())
		and token_kind_is(result, 8, "end of file")
	)


pure func token_source_text_is(
	src: SourceFile,
	result: LexResult,
	index: Int,
	expected: String,
) -> Bool:
	match result.tokens.get(index):
		Some(token):
			source_span_text(
				src,
				span_of(token, result.path, result.module_name),
			) == expected
		None:
			False


-- Tabs advance the column to the next multiple of COMPILER_SOURCE_TAB_WIDTH,
-- so space and indentation runs cannot be measured in characters alone.
func test_lex_tab_runs_preserve_indent_and_columns() -> Bool:
	src: SourceFile = source("a\tb\n\tc  d\te\n")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and result.tokens.length() == 9
		and token_kind_is(result, 0, "identifier:a")
		and token_span_is(result, 0, 0, 1, 1, 1, 1, 2)
		and token_kind_is(result, 1, "identifier:b")
		and token_span_is(result, 1, 2, 1, 5, 3, 1, 6)
		and token_kind_is(result, 2, "newline")
		and token_kind_is(result, 3, "indent")
		and token_span_is(result, 3, 4, 2, 1, 5, 2, 5)
		and token_kind_is(result, 4, "identifier:c")
		and token_span_is(result, 4, 5, 2, 5, 6, 2, 6)
		and token_kind_is(result, 5, "identifier:d")
		and token_span_is(result, 5, 8, 2, 8, 9, 2, 9)
		and token_kind_is(result, 6, "identifier:e")
		and token_span_is(result, 6, 10, 2, 13, 11, 2, 14)
		and token_kind_is(result, 7, "dedent")
		and token_kind_is(result, 8, "end of file")
	)


-- Source text is scanned by byte, so a multibyte character occupies several
-- offsets and columns. Comments, string bodies, and following tokens all have
-- to agree about that.
func test_lex_multibyte_text_preserves_byte_offsets_and_columns() -> Bool:
	cafe: String = "café"
	grin: String = from_char(to_char(128512))
	src: SourceFile = source("-- " + cafe + " " + grin + "\nname \"" + cafe + "\" tail\n")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and result.tokens.length() == 4
		and token_kind_is(result, 0, "identifier:name")
		and token_span_is(result, 0, 14, 2, 1, 18, 2, 5)
		and token_kind_is(result, 1, "string literal:" + cafe)
		and token_span_is(result, 1, 19, 2, 6, 26, 2, 13)
		and token_kind_is(result, 2, "identifier:tail")
		and token_span_is(result, 2, 27, 2, 14, 31, 2, 18)
		and token_kind_is(result, 3, "end of file")
	)


-- A number run ends at the first character that cannot continue it, and a dot
-- only continues the run when a digit follows it.
func test_lex_number_literals_preserve_exact_spans() -> Bool:
	src: SourceFile = source("1 42.5 007 3.0e\n")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and result.tokens.length() == 6
		and token_kind_is(result, 0, "int:1")
		and token_span_is(result, 0, 0, 1, 1, 1, 1, 2)
		and token_source_text_is(src, result, 1, "42.5")
		and token_span_is(result, 1, 2, 1, 3, 6, 1, 7)
		and token_kind_is(result, 2, "int:007")
		and token_span_is(result, 2, 7, 1, 8, 10, 1, 11)
		and token_source_text_is(src, result, 3, "3.0")
		and token_span_is(result, 3, 11, 1, 12, 14, 1, 15)
		and token_kind_is(result, 4, "identifier:e")
		and token_span_is(result, 4, 14, 1, 15, 15, 1, 16)
		and token_kind_is(result, 5, "end of file")
	)


-- Escapes before an interpolation are decoded into the literal prefix, while
-- escapes inside the interpolated tail are carried through untouched.
func test_lex_interpolated_string_preserves_escapes() -> Bool:
	src: SourceFile = source("\"a\\tb $" + "{x}\\n c\"\n")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(result, 0, "interpolated string literal:a\tb {x}\\n c")
		and token_span_is(result, 0, 0, 1, 1, 15, 1, 16)
	)


func test_lex_basic_function_tokens() -> Bool:
	src: SourceFile = source("func main():\n\t42\n")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(result, 0, "keyword func")
		and token_kind_is(result, 1, "identifier:main")
		and token_kind_is(result, 2, "symbol (")
		and token_kind_is(result, 3, "symbol )")
		and token_kind_is(result, 4, "symbol :")
		and token_kind_is(result, 5, "newline")
		and token_kind_is(result, 6, "indent")
		and token_kind_is(result, 7, "int:42")
		and token_kind_is(result, 8, "dedent")
		and token_kind_is(result, 9, "end of file")
	)


func test_lex_export_is_identifier() -> Bool:
	src: SourceFile = source("export")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(result, 0, "identifier:export")
		and token_kind_is(result, 1, "end of file")
	)


func test_lex_opaque_conversion_bridge_keywords() -> Bool:
	result: LexResult = lex(source("into into_opaque from from_opaque"), EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(result, 0, "identifier:into")
		and token_kind_is(result, 1, "keyword into_opaque")
		and token_kind_is(result, 2, "keyword from")
		and token_kind_is(result, 3, "keyword from_opaque")
		and token_kind_is(result, 4, "end of file")
	)


func test_lex_raw_prefix_near_misses_are_identifiers() -> Bool:
	src: SourceFile = source("r raw raw_value rawish raw\nnot_pipe")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(result, 0, "identifier:r")
		and token_kind_is(result, 1, "identifier:raw")
		and token_kind_is(result, 2, "identifier:raw_value")
		and token_kind_is(result, 3, "identifier:rawish")
		and token_kind_is(result, 4, "identifier:raw")
		and token_kind_is(result, 5, "newline")
		and token_kind_is(result, 6, "identifier:not_pipe")
		and token_kind_is(result, 7, "end of file")
	)


func test_lex_comment_as_trivia() -> Bool:
	src: SourceFile = source("-- header\nfunc main")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	match result.tokens.get(0):
		Some(first):
			(leading, _) = token_trivia_of(result.trivia, first)

			match leading.get(0):
				Some(trivia):
					(
						lex_ok(result)
						and trivia.kind == CommentTrivia
						and trivia.text == "-- header"
						and source_span_text(
							src,
							span_of(first, result.path, result.module_name),
						) == "func"
					)
				None:
					False
		None:
			False


func test_lex_distinguishes_trailing_and_leading_comment_trivia() -> Bool:
	src: SourceFile = source("func main -- trailing\n-- leading\nvar value")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	match (result.tokens.get(1), result.tokens.get(3)):
		(Some(main_token), Some(var_token)):
			(_, main_trailing) = token_trivia_of(result.trivia, main_token)
			(var_leading, _) = token_trivia_of(result.trivia, var_token)

			match (main_trailing.get(0), var_leading.get(0)):
				(Some(trailing), Some(leading)):
					(
						lex_ok(result)
						and trailing.kind == CommentTrivia
						and trailing.text == "-- trailing"
						and leading.kind == CommentTrivia
						and leading.text == "-- leading"
					)
				_:
					False
		_:
			False


---
Pins the scanning-step dispatch: a step that emits a token, a step that emits
only trailing trivia, and a step that emits neither must reach the token list
differently, and the end-of-file token must still arrive after a file whose
last scanning step produced trivia rather than a token.
---
func test_lex_scanning_step_dispatch_routes_tokens_and_trivia() -> Bool:
	src: SourceFile = source("a b -- tail\n-- own line\nc -- end")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	signatures: List[String] = result.tokens.map(
		func(token): token_signature(token_kind_of(result.texts, token)),
	)

	match (result.tokens.get(1), result.tokens.get(3)):
		(Some(b_token), Some(c_token)):
			(b_leading, b_trailing) = token_trivia_of(result.trivia, b_token)
			(c_leading, c_trailing) = token_trivia_of(result.trivia, c_token)

			(
				lex_ok(result)
				and signatures == [
					"identifier:a",
					"identifier:b",
					"newline",
					"identifier:c",
					"end of file",
				]
				and b_trailing.length() == 1
				and b_leading.length() == 0
				and match b_trailing.get(0):
					Some(trailing):
						trailing.text == "-- tail"
					None:
						False
				and c_leading.length() == 1
				and match c_leading.get(0):
					Some(leading):
						leading.text == "-- own line"
					None:
						False
				and match c_trailing.get(0):
					Some(tail):
						tail.text == "-- end"
					None:
						False
			)
		_:
			False


func test_lex_nested_indentation() -> Bool:
	src: SourceFile = source("if True:\n\tif True:\n\t\t42\n\t7\n")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)
	var indents: Int = 0
	var dedents: Int = 0

	for token in result.tokens:
		match token.kind:
			IndentTag:
				indents += 1
			DedentTag:
				dedents += 1
			_:
				void

	lex_ok(result) and indents == 2 and dedents == 2


func test_lex_orders_multiple_dedents_before_following_token() -> Bool:
	result: LexResult = lex(source("if True:\n\tif True:\n\t\t42\n7"), EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(result, 10, "int:42")
		and token_kind_is(result, 11, "dedent")
		and token_kind_is(result, 12, "dedent")
		and token_kind_is(result, 13, "int:7")
		and token_kind_is(result, 14, "end of file")
	)


func test_lex_preserves_line_start_tokens_when_scanning_fails() -> Bool:
	result: LexResult = lex(source("if True:\n\t!"), EMPTY_NAME_TABLE)

	(
		not lex_ok(result)
		and token_kind_is(result, 3, "newline")
		and token_kind_is(result, 4, "indent")
		and token_kind_is(result, 5, "dedent")
		and token_kind_is(result, 6, "end of file")
	)


func test_lex_current_symbol_surface() -> Bool:
	src: SourceFile = source("-> => ?= ... .. += -= *= /= _ _name # @ | - <= < >= > == = !=")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(result, 0, "symbol ->")
		and token_kind_is(result, 1, "symbol =>")
		and token_kind_is(result, 2, "symbol ?=")
		and token_kind_is(result, 3, "symbol ...")
		and token_kind_is(result, 4, "symbol ..")
		and token_kind_is(result, 5, "symbol +=")
		and token_kind_is(result, 6, "symbol -=")
		and token_kind_is(result, 7, "symbol *=")
		and token_kind_is(result, 8, "symbol /=")
		and token_kind_is(result, 9, "symbol _")
		and token_kind_is(result, 10, "identifier:_name")
		and token_kind_is(result, 11, "symbol #")
		and token_kind_is(result, 12, "symbol @")
		and token_kind_is(result, 13, "symbol |")
		and token_kind_is(result, 14, "symbol -")
		and token_kind_is(result, 15, "symbol <=")
		and token_kind_is(result, 16, "symbol <")
		and token_kind_is(result, 17, "symbol >=")
		and token_kind_is(result, 18, "symbol >")
		and token_kind_is(result, 19, "symbol ==")
		and token_kind_is(result, 20, "symbol =")
		and token_kind_is(result, 21, "symbol !=")
	)


func test_lex_unexpected_symbol_diagnostics_are_byte_for_byte() -> Bool:
	result: LexResult = lex(source("! ? ;"), EMPTY_NAME_TABLE)

	first_ok: Bool = match result.diagnostics.get(0):
		Some(diag):
			parse_diagnostic_to_string(diag) == "lexer.brp:1:1: error: unexpected character '!'"
		None:
			False

	second_ok: Bool = match result.diagnostics.get(1):
		Some(diag):
			parse_diagnostic_to_string(diag) == "lexer.brp:1:3: error: unexpected character '?'"
		None:
			False

	third_ok: Bool = match result.diagnostics.get(2):
		Some(diag):
			parse_diagnostic_to_string(diag) == "lexer.brp:1:5: error: unexpected character ';'"
		None:
			False

	result.diagnostics.length() == 3 and first_ok and second_ok and third_ok


-- A non-ASCII character is several source bytes. Reporting each byte on its own
-- renders it as its own codepoint, so the sequence is reported once as the
-- character it is, and a byte that starts no sequence is reported by value.
func test_lex_unexpected_multibyte_character_is_one_diagnostic() -> Bool:
	dash: String = "—"
	result: LexResult = lex(source("a " + dash + " b"), EMPTY_NAME_TABLE)
	expected: String = "lexer.brp:1:3: error: unexpected character '" + dash + "'"

	message_ok: Bool = match result.diagnostics.get(0):
		Some(diag):
			parse_diagnostic_to_string(diag) == expected
		None:
			False

	result.diagnostics.length() == 1 and message_ok


func test_lex_unexpected_incomplete_utf8_byte_reports_value() -> Bool:
	dash: String = "—"
	stray: String = dash.substring(1, 1)
	truncated: String = dash.substring(0, 1)

	stray_ok: Bool = match lex(source("a " + stray + " b"), EMPTY_NAME_TABLE).diagnostics.get(0):
		Some(diag):
			parse_diagnostic_to_string(diag) == "lexer.brp:1:3: error: unexpected byte 0x80"
		None:
			False

	truncated_ok: Bool = match lex(
		source("a " + truncated + " b"),
		EMPTY_NAME_TABLE,
	).diagnostics.get(0):
		Some(diag):
			parse_diagnostic_to_string(diag) == "lexer.brp:1:3: error: unexpected byte 0xe2"
		None:
			False

	stray_ok and truncated_ok


func test_lex_suppresses_newlines_inside_grouping() -> Bool:
	src: SourceFile = source("items = [\n\t1,\n\t2,\n]\nnext")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)
	var newlines: Int = 0
	var indents: Int = 0
	var dedents: Int = 0

	for token in result.tokens:
		match token.kind:
			NewlineTag:
				newlines += 1
			IndentTag:
				indents += 1
			DedentTag:
				dedents += 1
			_:
				void

	(
		lex_ok(result)
		and newlines == 1
		and indents == 0
		and dedents == 0
		and token_kind_is(result, 0, "identifier:items")
		and token_kind_is(result, 2, "symbol [")
		and token_kind_is(result, 7, "symbol ]")
		and token_kind_is(result, 9, "identifier:next")
	)


func test_lex_preserves_lambda_body_newlines_inside_grouping() -> Bool:
	src: SourceFile = source("items = [func(x):\n\tx + 1\n]\nnext")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)
	var newlines: Int = 0
	var indents: Int = 0
	var dedents: Int = 0

	for token in result.tokens:
		match token.kind:
			NewlineTag:
				newlines += 1
			IndentTag:
				indents += 1
			DedentTag:
				dedents += 1
			_:
				void

	(
		lex_ok(result)
		and newlines == 2
		and indents == 1
		and dedents == 1
		and token_kind_is(result, 8, "newline")
		and token_kind_is(result, 9, "indent")
		and token_kind_is(result, 13, "dedent")
		and token_kind_is(result, 14, "symbol ]")
	)


func test_lex_group_close_after_lambda_body_inside_call() -> Bool:
	src: SourceFile = source(
		"result = Ok(\n\titems\n\t\t.filter_map(func(x):\n\t\t\tmatch x:\n\t\t\t\t0:\n\t\t\t\t\tNone\n\t\t\t\t_:\n\t\t\t\t\tSome(x)\n\t\t),\n)\nnext",
	)
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	lex_ok(result)


func test_lex_grouped_match_block_continuation() -> Bool:
	src: SourceFile = source(
		"func main() -> Int:\n\tif (\n\t\tTrue\n\t\tand match Some(1):\n\t\t\tSome(index):\n\t\t\t\tindex == 1\n\t\t\tNone:\n\t\t\t\tFalse\n\t\tand match None:\n\t\t\tSome(_):\n\t\t\t\tFalse\n\t\t\tNone:\n\t\t\t\tTrue\n\t):\n\t\t0\n\telse:\n\t\t1",
	)
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	lex_ok(result)


func test_lex_preserves_newline_across_blank_line() -> Bool:
	src: SourceFile = source("value = args.is_empty()\n\n(\n\tTrue\n)\n")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)
	var newlines: Int = 0

	for token in result.tokens:
		match token.kind:
			NewlineTag:
				newlines += 1
			_:
				void

	lex_ok(result) and newlines >= 1


func test_lex_string_and_raw_string_literals() -> Bool:
	src: SourceFile = source("\"hi\\n\\t\\\\\\\"\\'\\0\\{\\}\" raw\"c\\d\"")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	(
		lex_ok(result)
		and token_kind_is(result, 0, "string literal:" + "hi\n\t\\\"'\0{}")
		and token_kind_is(result, 1, "raw string literal:c\\d")
	)


func test_lex_unicode_escape_string_literal() -> Bool:
	src: SourceFile = source("\"\\u{41}\\u{1F600}\"")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)
	expected: String = from_char(to_char(65)) + from_char(to_char(128512))

	lex_ok(result) and token_kind_is(result, 0, "string literal:" + expected)


