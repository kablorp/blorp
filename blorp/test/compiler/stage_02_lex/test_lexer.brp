	round_trips


func test_synthesized_vocabulary_has_no_duplicate_spellings() -> Bool:
	name_table_count(SYNTHESIZED_NAME_TABLE) == name_table_synthesized_spellings().length()


func test_pinned_name_id_constants_hold_their_seeded_positions() -> Bool:
	(
		name_id_index(NAME_ID_EMPTY) == 0
		and name_table_synthesized_spellings().index_of(
			"_",
		) == Some(name_id_index(NAME_ID_WILDCARD))
		and name_spelling(SYNTHESIZED_NAME_TABLE, tuple_field_name_id(0)) == Some("0")
		and name_spelling(SYNTHESIZED_NAME_TABLE, tuple_field_name_id(15)) == Some("15")
		and name_id_index(tuple_field_name_id(0)) == NAME_ID_TUPLE_FIELD_ZERO_INDEX
	)


func test_unseeded_spelling_resolves_to_a_sentinel_that_equals_no_real_id() -> Bool:
	missing: NameId = synthesized_name_id("definitely_not_seeded")

	(
		name_ids_equal(missing, name_id_unseeded_spelling())
		and not name_ids_equal(missing, NAME_ID_EMPTY)
		and name_spelling(SYNTHESIZED_NAME_TABLE, missing).is_none()
	)


func test_boundary_spelling_helpers_render_the_table_spelling_or_the_fallback_text() -> Bool:
	base: NameTable = lex(source("alpha beta"), SYNTHESIZED_NAME_TABLE).names

	(
		match name_table_find_id(base, "alpha"):
			Some(alpha_id):
				name_spelling_or_text(base, alpha_id, "ignored") == "alpha"
			None:
				False
		and name_spelling_or_text(base, name_id_unseeded_spelling(), "fallback") == "fallback"
		and name_spelling_or_text(EMPTY_NAME_TABLE, NAME_ID_MAIN, "main") == "main"
		and name_spelling_of_text(base, "beta") == "beta"
		and name_spelling_of_text(base, "unseen") == "unseen"
	)


func test_name_table_extension_continues_ids_above_the_base() -> Bool:
	base: NameTable = lex(source("alpha beta"), SYNTHESIZED_NAME_TABLE).names
	empty: NameTableExtension = name_table_extension_empty(base)
	(after_gamma, gamma_id) = name_table_extension_intern(base, empty, "gamma")
	(after_alpha, alpha_id) = name_table_extension_intern(base, after_gamma, "alpha")
	(after_again, gamma_again_id) = name_table_extension_intern(base, after_alpha, "gamma")
	(after_delta, delta_id) = name_table_extension_intern(base, after_again, "delta")

	(
		name_table_extension_count(after_delta) == 2
		and name_spelling(base, alpha_id) == Some("alpha")
		and name_ids_equal(gamma_id, gamma_again_id)
		and name_spelling_in_extension(base, after_delta, gamma_id) == Some("gamma")
		and name_spelling_in_extension(base, after_delta, delta_id) == Some("delta")
		and name_spelling_in_extension(base, after_delta, alpha_id) == Some("alpha")
		and name_spelling(base, gamma_id).is_none()
	)


