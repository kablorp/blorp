	src: SourceFile = source("---\nα\n\n終\n---")
	result: LexResult = lex(src, EMPTY_NAME_TABLE)

	lex_ok(result) and token_kind_is(result, 0, "docstring:α\n\n終")


func test_lex_pipe_string_literal() -> Bool:
	src: SourceFile = source("|hello\n|world\nnext")
