import:
	../../../src/compiler/stage_02_lex/parse_diagnostic:
		ParseDiagnostic,
		parse_diagnostic_to_string,
		parse_error,
		parse_error_expected,
	../../../src/lib/source:
		Cursor,
		SourceFile,
		SourceSpan,
		source_cursor_at,
		source_file,
		source_span,
	test: TestSuite


pure func fixture_source_file() -> SourceFile:
	source_file("demo.brp", "demo", "func main\n\tbad")


pure func bad_span() -> SourceSpan:
	src: SourceFile = fixture_source_file()
	start: Cursor = source_cursor_at(src, 11)
	finish: Cursor = source_cursor_at(src, 14)
	source_span(src, start, finish)


func test_parse_error_has_expected_labels() -> Bool:
	diag: ParseDiagnostic = parse_error_expected(
		bad_span(),
		"expected expression",
		["identifier", "literal"],
		Some("insert an expression after the indentation"),
	)

	(
		diag.expected.length() == 2
		and diag.help.get_or("") == "insert an expression after the indentation"
	)


func test_diagnostic_formatting() -> Bool:
	diag: ParseDiagnostic = parse_error(bad_span(), "expected expression")
	parse_diagnostic_to_string(diag) == "demo.brp:2:5: error: expected expression"


func test_diagnostic_formatting_with_multiple_expected_labels() -> Bool:
	diag: ParseDiagnostic = parse_error_expected(
		bad_span(),
		"expected expression",
		["identifier", "literal"],
		Some("insert an expression after the indentation"),
	)
	parse_diagnostic_to_string(
		diag,
	) == "demo.brp:2:5: error: expected expression (expected identifier, literal)\nhelp: insert an expression after the indentation"


tests: TestSuite = {
	description = "Compiler parse diagnostics",
	tests = [
		("parse error has expected labels", test_parse_error_has_expected_labels),
		("diagnostic formatting", test_diagnostic_formatting),
		(
			"diagnostic formatting with multiple expected labels",
			test_diagnostic_formatting_with_multiple_expected_labels,
		),
	]
}
