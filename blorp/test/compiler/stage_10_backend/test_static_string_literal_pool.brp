import:
	../../../src/compiler/stage_09_core/ir:
		CoreDecl(GlobalDecl),
		CoreExpr(LiteralExpr, StaticStringLiteralExpr),
		CoreGlobal,
		CoreLiteral(StringLiteral),
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType),
		static_string_literal_id,
	../../../src/compiler/stage_10_backend/static_string_literal_pool:
		StaticStringLiteralPoolError(
			StaticStringLiteralIdConflict,
			StaticStringLiteralValueConflict,
			UnpooledValueStringLiteral,
		),
		collect_backend_static_string_literals,
	test: TestSuite


private STRING_TYPE: CoreType = NamedType("String", [])


pure func string_global(name: String, def_id: Int, expr: CoreExpr) -> CoreDecl:
	GlobalDecl({
		name = {
			name = name,
			uniq = 0,
			def_id = Some(def_id)
		},
		source_module = None,
		typ = STRING_TYPE,
		init = expr,
		is_mutable = False,
		is_const = True,
		is_private = False,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func static_string(id: Int, value: String) -> CoreExpr:
	StaticStringLiteralExpr(static_string_literal_id(id), value, STRING_TYPE, SyntheticSourceLoc)


pure func program_with(exprs: List[CoreExpr]) -> CoreProgram:
	var def_id: Int = 1
	var decls: List[CoreDecl] = []

	for expr in exprs:
		decls = decls.append(string_global("value_${def_id}", def_id, expr))
		def_id += 1

	{
		decls = decls,
		foreign_includes = []
	}


pure func test_pool_preserves_ids_and_allows_gaps() -> Bool:
	match collect_backend_static_string_literals(
		program_with([static_string(7, "later"), static_string(2, "earlier")]),
	):
		Ok(entries):
			entries.map(func(entry): entry.value) == ["earlier", "later"]
		Err(_):
			False


pure func test_pool_rejects_conflicting_id() -> Bool:
	match collect_backend_static_string_literals(
		program_with([static_string(1, "first"), static_string(1, "second")]),
	):
		Err(StaticStringLiteralIdConflict(1, "first", "second")):
			True
		_:
			False


pure func test_pool_rejects_conflicting_value() -> Bool:
	match collect_backend_static_string_literals(
		program_with([static_string(1, "same"), static_string(2, "same")]),
	):
		Err(StaticStringLiteralValueConflict("same", 1, 2)):
			True
		_:
			False


pure func test_pool_rejects_unclassified_value_literal() -> Bool:
	match collect_backend_static_string_literals(
		program_with([LiteralExpr(StringLiteral("raw"), STRING_TYPE, SyntheticSourceLoc)]),
	):
		Err(UnpooledValueStringLiteral("raw")):
			True
		_:
			False


tests: TestSuite = {
	description = "Static string literal backend pool",
	tests = [
		("preserves IDs and allows gaps", test_pool_preserves_ids_and_allows_gaps),
		("rejects conflicting ID", test_pool_rejects_conflicting_id),
		("rejects conflicting value", test_pool_rejects_conflicting_value),
		("rejects unclassified value literal", test_pool_rejects_unclassified_value_literal),
	]
}
