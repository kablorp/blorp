pure func test_variant_symbols_are_spelled_from_definition_identity() -> Bool:
	(
		variant_constructor_symbol("Circle", Some(0)) == "brp_c_0"
		and variant_tag_symbol("Shape", "Circle", Some(0)) == "brp_t_0"
		and variant_constructor_symbol("Circle", Some(62)) == "brp_c_10"
		and variant_tag_symbol("Shape", "Circle", Some(62)) == "brp_t_10"
		and variant_constructor_symbol("Circle", Some(3)) != variant_constructor_symbol("Circle", Some(4))
	)


pure func test_variant_without_definition_identity_keeps_source_spelling() -> Bool:
	(
		variant_constructor_symbol("Circle", None) == "Circle"
		and variant_tag_symbol("Shape", "Circle", None) == "TAG_Shape_Circle"
	)


pure func test_variant_symbols_cannot_spell_a_callable() -> Bool:
	-- A callable is `brp_` followed directly by a base-62 digit; a variant
	-- symbol has `_` there, so no def id makes the two families meet.
	var disjoint: Bool = True

	for id in 0..200:
		disjoint = (
			disjoint
			and variant_constructor_symbol("V", Some(id)) != projected_callable_base_symbol(id)
			and variant_tag_symbol("T", "V", Some(id)) != projected_callable_base_symbol(id)
			and variant_constructor_symbol("V", Some(id)) != variant_tag_symbol("T", "V", Some(id))
		)

	disjoint


private pure func enum_program_with_variant_symbols(
	first_symbol: String,
	second_symbol: String,
	foreign_name: Option[String],
) -> CoreProgram:
	enum_decl: CoreDecl = EnumDecl({
		abi_type = None,
		name = "Shade",
		type_params = [],
		variants = [
			{
				name = "Light",
				c_name = first_symbol,
				tag = 0,
				def_id = Some(7)
			},
			{
				name = "Dark",
				c_name = second_symbol,
				tag = 1,
				def_id = Some(8)
			},
		],
		loc = synthetic_core_source_loc()
	})

	foreign_decls: List[CoreDecl] = match foreign_name:
		Some(name):
			[
				FunctionDecl({
					name = "foreign_named_like_variant",
					source_module = None,
					type_params = [],
					params = [],
					return_type = int_type(),
					body = None,
					is_pure = True,
					origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
					module = FIXTURE_NO_SOURCE_MODULE,
					function_kind = ForeignFunction({
						c_name = name,
						includes = [],
						link_flags = [],
						arg_passing = ForeignBorrowArgs,
					}),
					def_id = 9,
					loc = synthetic_core_source_loc(),
				}),
			]
		None:
			[]

	{
		decls = [enum_decl].concat(foreign_decls),
		foreign_includes = [],
		source_files = []
	}


pure func test_variant_symbol_clashing_with_foreign_name_fails_closed() -> Bool:
	match prepare_c_emission_symbols(
		enum_program_with_variant_symbols("brp_c_7", "brp_c_8", Some("brp_c_7")),
	):
		Err(VariantSymbolCollision(name)):
			name == "brp_c_7"
		_:
			False


pure func test_duplicate_variant_symbols_fail_closed() -> Bool:
	match prepare_c_emission_symbols(enum_program_with_variant_symbols("brp_c_7", "brp_c_7", None)):
		Err(VariantSymbolCollision(name)):
			name == "brp_c_7"
		_:
			False


pure func test_distinct_variant_symbols_are_accepted() -> Bool:
	match prepare_c_emission_symbols(enum_program_with_variant_symbols("brp_c_7", "brp_c_8", None)):
		Ok(_):
			True
		_:
			False


pure func origin_test_var(name: String, id: Int, origin: CoreBinderOrigin) -> CoreVar:
	{
		name = name,
		id = id,
		def_id = None,
		origin = origin
	}


pure func perceus_test_var(kind: PerceusTempKind, id: Int, ordinal: Int) -> CoreVar:
	origin_test_var(perceus_temporary_spelling(kind, id, ordinal), id, PerceusTemporary(kind, ordinal))


pure func borrowed_result_test_var(
	kind: PerceusBorrowedResultKind,
	id: Int,
	ordinal: Int,
	owner_id: Int,
) -> CoreVar:
	origin_test_var(
		perceus_borrowed_result_spelling(kind, id, ordinal, owner_id),
		id,
		PerceusBorrowedResultTemporary(kind, ordinal, owner_id),
	)


pure func derived_test_var(anchor: CoreVar, id: Int, kind: DerivedTempKind, ordinal: Int) -> CoreVar:
	anchor_key: String = derived_anchor_key(anchor)

	origin_test_var(
		derived_temporary_spelling(anchor_key, kind, ordinal),
		id,
		DerivedFrom(anchor_key, kind, ordinal),
	)


-- The producer builds the spelling once from (id, kind, ordinal); the emitter
-- passes the variable's name through unchanged.
func test_perceus_temporary_spelling_reads_id_kind_and_ordinal_only() -> Bool:
	first: CoreVar = perceus_test_var(PerceusBorrowArg, -61, 0)
	second: CoreVar = perceus_test_var(PerceusBorrowArg, -61, 1)
	result: CoreVar = perceus_test_var(PerceusOwnedResult, -61, 0)

	(
		c_variable_spelling(first) == "brp_vt_Z_b0"
		and c_variable_spelling(second) == "brp_vt_Z_b1"
		and c_variable_spelling(result) == "brp_vt_Z_j0"
	)


-- Two borrowed owners protected at one call argument share node, kind and
-- ordinal; the owner id in the spelling keeps their temporaries apart.
func test_borrowed_result_spelling_separates_owners_at_one_argument() -> Bool:
	first: CoreVar = borrowed_result_test_var(BorrowedResultCallArg, -61, 0, 7)
	second: CoreVar = borrowed_result_test_var(BorrowedResultCallArg, -61, 0, 8)
	negative_owner: CoreVar = borrowed_result_test_var(BorrowedResultAlias, -61, 0, -3)

	(
		c_variable_spelling(first) == "brp_vt_Z_l0_7"
		and c_variable_spelling(second) == "brp_vt_Z_l0_8"
		and c_variable_spelling(negative_owner) == "brp_vt_Z_k0_n3"
	)


func test_derived_temporary_spelling_keys_on_its_anchor() -> Bool:
	authored: CoreVar = origin_test_var("value", 1, AuthoredBinder)
	temporary: CoreVar = perceus_test_var(PerceusBorrowArg, -61, 0)
	dropped: CoreVar = derived_test_var(authored, 1, DropTemp, 0)
	dropped_temporary: CoreVar = derived_test_var(temporary, -61, DropTemp, 0)
	closure_dropped: CoreVar = derived_test_var(dropped, -2, ClosureDropTemp, 2)

	(
		c_variable_spelling(dropped) == "brp_vd_p1_d0"
		and c_variable_spelling(dropped_temporary) == "brp_vd_tZ_b0_d0"
		and c_variable_spelling(closure_dropped) == "brp_vd_dp1_d0_c2"
		and c_variable_spelling({ dropped | name = "renamed" }) == "__blorp_invalid_projected_temporary"
	)


-- The identity contract compares a stored name with this recomputation.
func test_projected_temporary_spelling_recomputes_from_id_and_origin() -> Bool:
	authored: CoreVar = origin_test_var("value", 1, AuthoredBinder)
	temporary: CoreVar = perceus_test_var(PerceusBorrowArg, -61, 1)
	borrowed: CoreVar = borrowed_result_test_var(BorrowedResultEqualityArg, -61, 0, 4)
	derived: CoreVar = derived_test_var(authored, 1, AssignTemp, 3)

	(
		projected_temporary_spelling(temporary) == Some(temporary.name)
		and projected_temporary_spelling(borrowed) == Some(borrowed.name)
		and projected_temporary_spelling(derived) == Some(derived.name)
		and projected_temporary_spelling(authored) == None
		and projected_temporary_spelling({ temporary | name = "other" }) == Some(temporary.name)
	)


-- The member of a non-ABI record's field is `f<ordinal>`, spelled from its position.
func test_record_member_names_come_from_field_positions() -> Bool:
	(
		c_record_member_name(0) == "f0"
		and c_record_member_name(12) == "f12"
		and c_record_member_name(3) != c_record_member_name(4)
		and not c_record_member_name(3).starts_with("brp_")
	)


pure func distinct_spelling_count(spellings: List[String]) -> Int:
	var distinct: List[String] = []

	for spelling in spellings:
		if not distinct.contains(spelling):
			distinct = distinct.append(spelling)

	distinct.length()


func test_local_families_are_disjoint_from_each_other() -> Bool:
	authored: CoreVar = origin_test_var("a", 5, AuthoredBinder)
	minted: CoreVar = origin_test_var("m", -5, AuthoredBinder)
	temporary: CoreVar = perceus_test_var(PerceusBorrowArg, -5, 0)
	derived: CoreVar = derived_test_var(authored, 5, DropTemp, 0)
	spellings: List[String] = [
		c_variable_spelling(authored),
		c_variable_spelling(minted),
		c_variable_spelling(temporary),
		c_variable_spelling(derived),
	]

	(
		c_variable_spelling(authored).starts_with("brp_v_")
		and c_variable_spelling(minted).starts_with("brp_vn_")
		and c_variable_spelling(temporary).starts_with("brp_vt_")
		and c_variable_spelling(derived).starts_with("brp_vd_")
		and distinct_spelling_count(spellings) == 4
	)


