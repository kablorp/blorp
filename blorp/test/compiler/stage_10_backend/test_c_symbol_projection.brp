		c_name = c_name,
		static_name = static_closure_name(c_name),
		captures = [],
		return_type = VoidType
	}
	loop: CoreConcurrentlyLoop = {
		variable = {
			name = "item",
			id = 0,
			def_id = None
		},
		item_type = int_type(),
		item_mode = ConcurrentlyLoopCopyItem,
		iterable = VoidExpr(VoidType, synthetic_core_source_loc()),
		body = VoidExpr(VoidType, synthetic_core_source_loc()),
		timeout = None,
		limit = LiteralExpr(IntLiteral(1), int_type(), synthetic_core_source_loc()),
		output = ConcurrentlyLoopDiscard,
		task = task
	}
	host = user_function(
		"fixture_concurrently_loop_host",
		12,
		ConcurrentlyLoopExpr(loop, VoidType, synthetic_core_source_loc()),
	)
	{
		decls = [FunctionDecl(body), FunctionDecl(host)],
		foreign_includes = [],
		source_files = []
	}


