	body: CoreFunction = {
		closure_body_function(semantic_name, 14, c_name, False) |
		return_type = int_type(),
		body = Some(VarExpr(
			{ name = "base", id = 0, def_id = None, origin = AuthoredBinder },
			int_type(),
			synthetic_core_source_loc(),
		)),
		origin = FIXTURE_SOURCE_FUNCTION_ORIGIN,
		module = FIXTURE_NO_SOURCE_MODULE,
		function_kind = ClosureBodyFunction({ closure_abi(c_name, False) | captures = [capture] })
	}
	host: CoreFunction = {
		user_function(
			"fixture_captured_closure_host",
			15,
			ClosureCreateExpr(
				{
					def_id = 14,
					captures = [capture]
				},
				function_type(),
				synthetic_core_source_loc(),
			),
		) |
		return_type = function_type(),
		params = [{
			name = { name = "base", id = 0, def_id = None, origin = AuthoredBinder },
			typ = int_type(),
			loc = synthetic_core_source_loc()
		}]
	}
	{
		decls = [FunctionDecl(body), FunctionDecl(host)],
		foreign_includes = [],
		source_files = []
	}


