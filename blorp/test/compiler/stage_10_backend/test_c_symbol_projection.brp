pure func test_production_emits_direct_call_from_original_core() -> Bool:
	callee: String = projected_callable_base_symbol(2)
	caller: String = projected_callable_base_symbol(3)

	match try_emit_prepared_core_program_c_artifact_with_profile(
		prepared_core_program(direct_call_program(Some(2))),
		FunctionProfileOff,
	):
		Ok(artifact):
			(
				artifact.c_code.contains("static long ${callee}(void);")
				and artifact.c_code.contains("static long ${caller}(void);")
				and artifact.c_code.contains("return ${callee}();")
				and not artifact.c_code.contains("fixture_long_identity_function(")
			)
		Err(_):
			False


pure func test_production_emits_closure_and_task_helpers_from_original_core() -> Bool:
	closure_name: String = projected_callable_base_symbol(4)
	closure_static: String = static_closure_name(closure_name)
	task_name: String = projected_callable_base_symbol(6)
	task_static: String = static_closure_name(task_name)

	closure_ok: Bool = match try_emit_prepared_core_program_c_artifact_with_profile(
		prepared_core_program(
			closure_create_program(static_closure_name("fixture_long_closure_body")),
		),
		FunctionProfileOff,
	):
		Ok(artifact):
			(
				artifact.c_code.contains("static void ${closure_name}(void* __env);")
				and artifact.c_code.contains("static blorp_Closure ${closure_static}")
				and artifact.c_code.contains("((void*)&${closure_static})")
			)
		Err(_):
			False

	task_ok: Bool = match try_emit_prepared_core_program_c_artifact_with_profile(
		prepared_core_program(task_program()),
		FunctionProfileOff,
	):
		Ok(artifact):
			(
				artifact.c_code.contains("static void* ${task_name}(void* __env);")
				and artifact.c_code.contains("static blorp_Closure ${task_static}")
				and artifact.c_code.contains("((void*)&${task_static})")
			)
		Err(_):
			False

	closure_ok and task_ok


pure func test_production_emits_concurrent_task_helpers_from_original_core() -> Bool:
	loop_task_name: String = projected_callable_base_symbol(11)
	block_task_name: String = projected_callable_base_symbol(13)

	loop_task_ok: Bool = match try_emit_prepared_core_program_c_artifact_with_profile(
		prepared_core_program(concurrently_loop_program()),
		FunctionProfileOff,
	):
		Ok(artifact):
			(
				artifact.c_code.contains(loop_task_name)
				and not artifact.c_code.contains("fixture_long_concurrently_loop_task_body")
			)
		Err(_):
			False

	block_task_ok: Bool = match try_emit_prepared_core_program_c_artifact_with_profile(
		prepared_core_program(concurrent_block_program()),
		FunctionProfileOff,
	):
		Ok(artifact):
			(
				artifact.c_code.contains(block_task_name)
				and not artifact.c_code.contains("fixture_long_concurrent_block_task_body")
			)
		Err(_):
			False

	loop_task_ok and block_task_ok


