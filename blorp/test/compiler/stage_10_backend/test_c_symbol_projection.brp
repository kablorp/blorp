pure func test_production_emits_canonical_empty_list_from_plan() -> Bool:
	list_type: CoreType = NamedType("List", [int_type()])
	function_info: CoreFunction = { user_function(
		"fixture_empty_list",
		34,
		ListConstructExpr(
			{
				layout = PointerListStorage,
				elements = [],
				elem_needs_release = False
			},
			list_type,
			synthetic_core_source_loc(),
		),
	) | return_type = list_type }
	program: CoreProgram = {
		decls = [FunctionDecl(function_info)],
		foreign_includes = [],
		source_files = []
	}
	symbol_name: String = "__blorp_canonical_empty_list_pointer_plain"

	match try_emit_prepared_core_program_c_artifact_with_profile(
		prepared_core_program(program),
		FunctionProfileOff,
	):
		Ok(artifact):
			(
				artifact.c_code.contains("void* data[1]; } ${symbol_name} = {")
				and artifact.c_code.contains("return (blorp_List*)&${symbol_name};")
			)
		Err(_):
			False


tests: TestSuite = {
	description = "Compiler C symbol projection Tests",
	tests = [
		("callable ID contract fixed vectors", test_callable_id_contract_fixed_vectors),
		(
			"callable ID contract uses compact portable identifiers",
			test_callable_id_contract_uses_compact_portable_identifiers,
		),
		("callable plan is order independent", test_callable_plan_is_order_independent),
		(
			"similar callable names have distinct symbols",
			test_similar_callable_names_have_distinct_symbols,
		),
		(
			"callable plan coalesces repeated identity",
			test_callable_plan_coalesces_repeated_identity,
		),
		(
			"callable plan rejects disagreeing repeated identity",
			test_callable_plan_rejects_disagreeing_repeated_identity,
		),
		(
			"callable plan rejects definition ID owned by two callables",
			test_callable_plan_rejects_definition_id_owned_by_two_callables,
		),
		(
			"callable plan escapes preserved compact name",
			test_callable_plan_escapes_preserved_compact_name,
		),
		(
			"callable plan escapes preserved closure static name",
			test_callable_plan_escapes_preserved_closure_static_name,
		),
		(
			"callable plan rejects negative definition ID",
			test_callable_plan_rejects_negative_definition_id,
		),
		(
			"projection boundary rejects duplicate final definition ID",
			test_projection_boundary_rejects_duplicate_final_definition_id,
		),
		(
			"projects user definition and exact direct call together",
			test_projects_user_definition_and_exact_direct_call_together,
		),
		(
			"rejects user call without exact definition identity",
			test_rejects_user_call_without_exact_definition_identity,
		),
		("rejects unresolved final call kind", test_rejects_unresolved_final_call_kind),
		(
			"rejects top-level function value without closure conversion",
			test_rejects_top_level_function_value_without_closure_conversion,
		),
		(
			"projection preserves breadth-first first-error selection",
			test_projection_preserves_breadth_first_first_error_selection,
		),
		(
			"projection validates closure callee before arguments",
			test_projection_validates_closure_callee_before_arguments,
		),
		(
			"projection rejects malformed global initializer",
			test_projection_rejects_malformed_global_initializer,
		),
		(
			"projects closure body create and static object together",
			test_projects_closure_body_create_and_static_object_together,
		),
		("rejects stale closure static name", test_rejects_stale_closure_static_name),
		("projects detached task closure", test_projects_detached_task_closure),
		("projects concurrently loop task closure", test_projects_concurrently_loop_task_closure),
		("projects concurrent block task closure", test_projects_concurrent_block_task_closure),
		("projects list to string callback", test_projects_list_to_string_callback),
		("projects custom collection callbacks", test_projects_custom_collection_callbacks),
		("projects dict with capacity callbacks", test_projects_dict_with_capacity_callbacks),
		("projects dict construct callbacks", test_projects_dict_construct_callbacks),
		(
			"rejects missing custom collection callback",
			test_rejects_missing_custom_collection_callback,
		),
		(
			"production emits direct call from original Core",
			test_production_emits_direct_call_from_original_core,
		),
		(
			"production emits closure and task helpers from original Core",
			test_production_emits_closure_and_task_helpers_from_original_core,
		),
		(
			"production emits concurrent task helpers from original Core",
			test_production_emits_concurrent_task_helpers_from_original_core,
		),
		(
			"production emits custom callbacks from original Core",
			test_production_emits_custom_callbacks_from_original_core,
		),
		(
			"production emits dict construct callbacks from original Core",
			test_production_emits_dict_construct_callbacks_from_original_core,
