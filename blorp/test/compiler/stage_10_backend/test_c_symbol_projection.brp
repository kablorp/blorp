private pure func resource_cleanup_program() -> CoreProgram:
	cleanup_name: String = "fixture_close_resource"
	cleanup: CoreFunction = { user_function(
		cleanup_name,
		35,
		VoidExpr(VoidType, synthetic_core_source_loc()),
	) | return_type = VoidType }
	resource_variable: CoreVar = {
		name = "resource",
		id = 0,
		def_id = None
	}
	host = user_function(
		"fixture_resource_host",
		36,
		ResourceScopeExpr(
			{
				variable = resource_variable,
				typ = int_type(),
				acquire = LiteralExpr(IntLiteral(7), int_type(), synthetic_core_source_loc()),
				body = LiteralExpr(IntLiteral(11), int_type(), synthetic_core_source_loc()),
				cleanup = CallExpr(
					UserCall(cleanup_name, Some(35), []),
					VoidExpr(VoidType, synthetic_core_source_loc()),
					[VarExpr(resource_variable, int_type(), synthetic_core_source_loc())],
					VoidType,
					synthetic_core_source_loc(),
				)
			},
			int_type(),
			synthetic_core_source_loc(),
		),
	)
	{
		decls = [FunctionDecl(cleanup), FunctionDecl(host)],
		foreign_includes = [],
		source_files = []
	}


pure func test_callable_id_contract_fixed_vectors() -> Bool:
	(
		projected_callable_base_symbol(0) == "brp_0"
		and projected_callable_base_symbol(1) == "brp_1"
		and projected_callable_base_symbol(61) == "brp_Z"
		and projected_callable_base_symbol(62) == "brp_10"
		and projected_callable_base_symbol(3843) == "brp_ZZ"
		and projected_callable_base_symbol(3844) == "brp_100"
	)


pure func test_callable_id_contract_uses_compact_portable_identifiers() -> Bool:
	name: String = projected_callable_base_symbol(1450)

	name == "brp_no" and not name.starts_with("__") and not name.starts_with("_[A-Z]")


pure func test_callable_plan_is_order_independent() -> Bool:
	first = candidate("module_alpha_first", 7, ProjectedUserFunction)
	second = candidate("module_beta_second", 3, ProjectedClosureBody)

	match (
		(
			build_callable_symbol_plan(
				[first, second],
				["main"],
			),
			build_callable_symbol_plan(
				[second, first],
				["main"],
			),
		)
	):
		(Ok(left), Ok(right)):
			(
				projected_callable_name(
					left,
					"module_alpha_first",
					7,
				) == projected_callable_name(right, "module_alpha_first", 7)
				and projected_callable_name(
					left,
					"module_beta_second",
					3,
				) == projected_callable_name(right, "module_beta_second", 3)
			)
		_:
			False


pure func test_similar_callable_names_have_distinct_symbols() -> Bool:
	projected_callable_base_symbol(1) != projected_callable_base_symbol(2)


pure func test_callable_plan_coalesces_repeated_identity() -> Bool:
	item = candidate("module_repeat", 9, ProjectedUserFunction)

	match (
		build_callable_symbol_plan(
			[item, item],
			["main"],
		)
	):
		Ok(plan):
			projected_callable_name(
				plan,
				"module_repeat",
				9,
			) == Some(projected_callable_base_symbol(9))
		Err(_):
			False


pure func test_callable_plan_rejects_disagreeing_repeated_identity() -> Bool:
	first = candidate("module_repeat", 9, ProjectedUserFunction)
	second = { first | original_c_spelling = "different_c_spelling" }

	match (
		build_callable_symbol_plan(
			[first, second],
			[],
		)
	):
		Err(DuplicateCallableIdentity(name, def_id)):
			name == "module_repeat" and def_id == 9
		_:
			False


pure func test_callable_plan_rejects_definition_id_owned_by_two_callables() -> Bool:
	match (
		build_callable_symbol_plan(
			[
				candidate("module_first", 9, ProjectedUserFunction),
				candidate("module_second", 9, ProjectedUserFunction),
			],
			[],
		)
	):
		Err(DuplicateCallableDefinitionId(9, first, second)):
			first == "module_first" and second == "module_second"
		_:
			False


pure func test_callable_plan_escapes_preserved_compact_name() -> Bool:
	match (
		build_callable_symbol_plan(
			[candidate("module_first", 0, ProjectedUserFunction)],
			["main", "brp_0"],
		)
	):
		Ok(plan):
			projected_callable_name(plan, "module_first", 0) == Some("brp_0_")
		Err(_):
			False


pure func test_callable_plan_escapes_preserved_closure_static_name() -> Bool:
	match (
		build_callable_symbol_plan(
			[candidate("module_first", 0, ProjectedClosureBody)],
			["__sc_brp_0", "__sc_brp_0_"],
		)
	):
		Ok(plan):
			projected_callable_name(plan, "module_first", 0) == Some("brp_0__")
		Err(_):
			False


pure func test_callable_plan_rejects_negative_definition_id() -> Bool:
	match build_callable_symbol_plan([candidate("module_first", -1, ProjectedUserFunction)], []):
		Err(InvalidCallableDefinitionId(-1, name)):
			name == "module_first"
		_:
			False


pure func test_projection_boundary_rejects_duplicate_final_definition_id() -> Bool:
	first: CoreFunction = user_function(
		"first",
		42,
		LiteralExpr(IntLiteral(1), int_type(), synthetic_core_source_loc()),
	)
	second: CoreFunction = { user_function(
		"second",
		42,
		LiteralExpr(IntLiteral(2), int_type(), synthetic_core_source_loc()),
	) | body = None }
	program: CoreProgram = {
		decls = [FunctionDecl(first), FunctionDecl(second)],
		foreign_includes = [],
		source_files = []
	}

	match prepare_c_emission_symbols(program):
		Err(InvalidCoreDefinitionIdentity(detail)):
			detail.contains("definition ID 42")
		Ok(_):
			False
		Err(_):
			False


pure func test_projects_user_definition_and_exact_direct_call_together() -> Bool:
	callee_name: String = "fixture_long_identity_function"
	caller_name: String = "fixture_long_caller_function"

	match prepare_c_emission_symbols(direct_call_program(Some(2))):
		Ok(plan):
			(
				planned_emitted_callable_name(
					plan,
					callee_name,
					2,
				) == Some(projected_callable_base_symbol(2))
				and planned_emitted_callable_name(
					plan,
					caller_name,
					3,
				) == Some(projected_callable_base_symbol(3))
			)
		Err(_):
			False


