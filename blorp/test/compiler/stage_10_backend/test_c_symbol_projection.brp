private pure func breadth_first_error_program() -> CoreProgram:
	target_name: String = "fixture_breadth_first_target"
	target = user_function(
		target_name,
		28,
		LiteralExpr(IntLiteral(7), int_type(), synthetic_core_source_loc()),
	)
	deep_error = CallExpr(
		UnknownCall,
		VoidExpr(VoidType, synthetic_core_source_loc()),
		[],
		int_type(),
		synthetic_core_source_loc(),
	)
	shallow_error = VarExpr(
		{
			name = target_name,
			id = 0,
			def_id = Some(28)
		},
		function_type(),
		synthetic_core_source_loc(),
	)
	host = user_function(
		"fixture_breadth_first_host",
		29,
		SeqExpr(
			SeqExpr(
				VoidExpr(VoidType, synthetic_core_source_loc()),
				deep_error,
			),
			shallow_error,
		),
	)
	{
		decls = [FunctionDecl(target), FunctionDecl(host)],
		foreign_includes = [],
		source_files = []
	}


