private pure func candidate(
	name: String,
	def_id: Int,
	kind: CProjectedCallableKind,
) -> CCallableSymbolCandidate:
	{
		kind = kind,
		qualified_name = name,
		def_id = def_id,
		original_c_spelling = name
	}


private pure func int_type() -> CoreType:
	NamedType("Int", [])


private pure func function_type() -> CoreType:
	FunctionType(True, [], int_type())


private pure func user_function(name: String, def_id: Int, body: CoreExpr) -> CoreFunction:
	{
		name = name,
		source_module = Some("fixture"),
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = synthetic_core_source_loc()
	}


private pure func direct_call_program(call_def_id: Option[Int]) -> CoreProgram:
	callee_name: String = "fixture_long_identity_function"
	callee: CoreFunction = user_function(
		callee_name,
		2,
		LiteralExpr(IntLiteral(7), int_type(), synthetic_core_source_loc()),
	)
	caller: CoreFunction = user_function(
		"fixture_long_caller_function",
		3,
		CallExpr(
			UserCall(
				callee_name,
				call_def_id,
				[],
			),
			VarExpr(
				{
					name = callee_name,
					id = 0,
					def_id = call_def_id
				},
				function_type(),
				synthetic_core_source_loc(),
			),
			[],
			int_type(),
			synthetic_core_source_loc(),
		),
	)
	{
		decls = [FunctionDecl(callee), FunctionDecl(caller)],
		foreign_includes = [],
		source_files = []
	}


