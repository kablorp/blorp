-- `backend_helper_kind_of_*_op` is a total match already enforced by the
-- compiler (an unhandled op variant, or a reference to a `BackendHelperKind`
-- variant that does not exist, fails the build). What the compiler cannot
-- catch is a *wrong but valid* mapping -- citing an existing kind that is
-- not the one the op variant actually describes. That risk concentrates in
-- the nine `prepared_backend_renderer.brp` op variants whose secondary flag
-- the catalog split into two or three rows instead of a boolean field
-- (`ElemReleaseArg`, `DictKeyReleasePolicy`, `ChannelRetainingSendRuntime`,
-- `ChannelRetainingSendTimeoutRuntime`); everywhere else the kind name is
-- mechanically "renderer prefix + variant name", so a typo there is a
-- missing-variant compile error, not a silent mismatch. This suite
-- exhaustively covers the nine flag-split cases and spot-checks a sample of
-- the mechanical 1:1 cases across all five renderers; it does not construct
-- all 383 op variants (most of the value of doing so is already provided by
-- the compiler's own exhaustiveness check).
import:
	../../../src/compiler/stage_09_core/backend_helper_catalog as Catalog:
		BackendHelperKind(
			BackendChannelRetainingSendSend,
			BackendChannelRetainingSendTrySend,
			BackendChannelRetainingSendTrySendStatus,
			BackendChannelRetainingSendWithTimeoutSendTimeout,
			BackendChannelRetainingSendWithTimeoutSendTimeoutStatus,
			BackendDictCtorCustomNoElemRelease,
			BackendDictCtorCustomWithElemRelease,
			BackendDictStackOptionInt128GetKeepKey,
			BackendDictStackOptionInt128GetReleaseKey,
			BackendDictStackOptionLongGetKeepKey,
			BackendDictStackOptionLongGetReleaseKey,
			BackendDictStackOptionUInt128GetKeepKey,
			BackendDictStackOptionUInt128GetReleaseKey,
			BackendDictStackOptionValueRecordGetKeepKey,
			BackendDictStackOptionValueRecordGetReleaseKey,
			BackendDictWithCapacityCustomNoElemRelease,
			BackendDictWithCapacityCustomWithElemRelease,
			BackendSetCtorCustomNoElemRelease,
			BackendSetCtorCustomWithElemRelease,
			IntrinsicFixedAlloc,
			IntrinsicMathSin,
			ListListConstruct,
			ListPointerGet,
			TensorRawViewDecl,
			TensorTensorLiteralBoxedBorrowedWrite,
			TupleTupleConstruct,
			TupleTupleName,
		),
	../../../src/compiler/stage_10_backend/backend_helper_kind_mapping:
		backend_helper_kind_of_intrinsic_renderer_op,
		backend_helper_kind_of_prepared_backend_renderer_op,
		backend_helper_kind_of_prepared_list_renderer_op,
		backend_helper_kind_of_prepared_tensor_renderer_op,
		backend_helper_kind_of_prepared_tuple_renderer_op,
	../../../src/compiler/stage_10_backend/prepared_backend_renderer:
		ChannelRetainingSendArgs,
		ChannelRetainingSendWithTimeoutArgs,
		DictKeyReleasePolicy(DictKeepKey, DictReleaseKey),
		ElemReleaseArg(ElemReleaseFn, NoElemRelease),
		StackOptionScalarGetArgs,
		StackOptionValueRecordGetArgs,
		ChannelRetainingSendRuntime(
			ChannelSendRuntime,
			ChannelTrySendRuntime,
			ChannelTrySendStatusRuntime,
		),
		ChannelRetainingSendTimeoutRuntime(
			ChannelSendTimeoutRuntime,
			ChannelSendTimeoutStatusRuntime,
		),
		PreparedBackendOp(
			BackendChannelRetainingSend,
			BackendChannelRetainingSendWithTimeout,
			BackendDictCtorCustom,
			BackendDictStackOptionInt128Get,
			BackendDictStackOptionLongGet,
			BackendDictStackOptionUInt128Get,
			BackendDictStackOptionValueRecordGet,
			BackendDictWithCapacityCustom,
			BackendSetCtorCustom,
			BackendStringByteRead,
		),
	../../../src/compiler/stage_10_backend/prepared_list_renderer: PreparedListOp(ListConstruct, PointerGet),
	../../../src/compiler/stage_10_backend/prepared_tensor_renderer: PreparedTensorOp(
		RawViewDecl,
		TensorLiteralBoxedBorrowedWrite,
	),
	../../../src/compiler/stage_10_backend/prepared_tuple_renderer: PreparedTupleOp(TupleConstruct, TupleName),
	../../../src/compiler/stage_10_backend/intrinsic_renderer:
		Intrinsic(OneArg, ThreeArgs),
		OneArgIntrinsic(MathSin),
		ThreeArgIntrinsic(FixedAlloc),
	test: TestSuite


-- The nine flag-split backend variants: every flag value maps to the
-- distinct row the catalog gives it.
func test_dict_ctor_custom_flag_split() -> Bool:
	no_release: BackendHelperKind = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendDictCtorCustom({ hash_fn = "h", equals_fn = "e" }, NoElemRelease),
	)
	with_release: BackendHelperKind = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendDictCtorCustom({ hash_fn = "h", equals_fn = "e" }, ElemReleaseFn),
	)

	no_release == BackendDictCtorCustomNoElemRelease and with_release == BackendDictCtorCustomWithElemRelease


func test_set_ctor_custom_flag_split() -> Bool:
	no_release: BackendHelperKind = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendSetCtorCustom({ hash_fn = "h", equals_fn = "e" }, NoElemRelease),
	)
	with_release: BackendHelperKind = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendSetCtorCustom({ hash_fn = "h", equals_fn = "e" }, ElemReleaseFn),
	)

	no_release == BackendSetCtorCustomNoElemRelease and with_release == BackendSetCtorCustomWithElemRelease


func test_dict_with_capacity_custom_flag_split() -> Bool:
	no_release: BackendHelperKind = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendDictWithCapacityCustom({ capacity = "8", hash_fn = "h", equals_fn = "e" }, NoElemRelease),
	)
	with_release: BackendHelperKind = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendDictWithCapacityCustom({ capacity = "8", hash_fn = "h", equals_fn = "e" }, ElemReleaseFn),
	)

	no_release == BackendDictWithCapacityCustomNoElemRelease and with_release == BackendDictWithCapacityCustomWithElemRelease


func test_dict_stack_option_key_release_flag_splits() -> Bool:
	value_record_args: StackOptionValueRecordGetArgs = {
		dict = "d",
		key = "k",
		temp_seed = "0",
		option_c_type = "T",
		payload_c_type = "P",
		none_value = "0",
	}
	scalar_args: StackOptionScalarGetArgs = {
		dict = "d",
		key = "k",
		temp_seed = "0",
		option_c_type = "T",
		none_value = "0",
	}

	value_record_keep: Bool = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendDictStackOptionValueRecordGet(value_record_args, DictKeepKey),
	) == BackendDictStackOptionValueRecordGetKeepKey
	value_record_release: Bool = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendDictStackOptionValueRecordGet(value_record_args, DictReleaseKey),
	) == BackendDictStackOptionValueRecordGetReleaseKey
	long_keep: Bool = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendDictStackOptionLongGet(scalar_args, DictKeepKey),
	) == BackendDictStackOptionLongGetKeepKey
	long_release: Bool = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendDictStackOptionLongGet(scalar_args, DictReleaseKey),
	) == BackendDictStackOptionLongGetReleaseKey
	int128_keep: Bool = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendDictStackOptionInt128Get(scalar_args, DictKeepKey),
	) == BackendDictStackOptionInt128GetKeepKey
	int128_release: Bool = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendDictStackOptionInt128Get(scalar_args, DictReleaseKey),
	) == BackendDictStackOptionInt128GetReleaseKey
	uint128_keep: Bool = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendDictStackOptionUInt128Get(scalar_args, DictKeepKey),
	) == BackendDictStackOptionUInt128GetKeepKey
	uint128_release: Bool = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendDictStackOptionUInt128Get(scalar_args, DictReleaseKey),
	) == BackendDictStackOptionUInt128GetReleaseKey

	value_record_keep and value_record_release and long_keep and long_release and int128_keep and int128_release and uint128_keep and uint128_release


func test_channel_retaining_send_flag_splits() -> Bool:
	send_args: ChannelRetainingSendArgs = {
		result_type = "T",
		channel = "c",
		value = "v",
		temp_seed = "0",
	}
	timeout_args: ChannelRetainingSendWithTimeoutArgs = {
		result_type = "T",
		channel = "c",
		value = "v",
		timeout = "t",
		temp_seed = "0",
	}

	send: Bool = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendChannelRetainingSend(send_args, ChannelSendRuntime),
	) == BackendChannelRetainingSendSend
	try_send: Bool = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendChannelRetainingSend(send_args, ChannelTrySendRuntime),
	) == BackendChannelRetainingSendTrySend
	try_send_status: Bool = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendChannelRetainingSend(send_args, ChannelTrySendStatusRuntime),
	) == BackendChannelRetainingSendTrySendStatus
	send_timeout: Bool = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendChannelRetainingSendWithTimeout(timeout_args, ChannelSendTimeoutRuntime),
	) == BackendChannelRetainingSendWithTimeoutSendTimeout
	send_timeout_status: Bool = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendChannelRetainingSendWithTimeout(timeout_args, ChannelSendTimeoutStatusRuntime),
	) == BackendChannelRetainingSendWithTimeoutSendTimeoutStatus

	send and try_send and try_send_status and send_timeout and send_timeout_status


-- Spot checks of the mechanical "renderer prefix + variant name" mappings,
-- one per renderer, including the double-prefix shape (`List`+`ListConstruct`,
-- `Tensor`+`TensorLiteralBoxedBorrowedWrite`) and a no-payload variant.
func test_mechanical_prefix_mappings_spot_check() -> Bool:
	tuple_name: Bool = backend_helper_kind_of_prepared_tuple_renderer_op(TupleName("0")) == TupleTupleName
	tuple_construct: Bool = backend_helper_kind_of_prepared_tuple_renderer_op(
		TupleConstruct({ arity = "0", args = "" }),
	) == TupleTupleConstruct
	list_pointer_get: Bool = backend_helper_kind_of_prepared_list_renderer_op(
		PointerGet("l", "0"),
	) == ListPointerGet
	list_construct: Bool = backend_helper_kind_of_prepared_list_renderer_op(
		ListConstruct({ list = "l", alloc_expr = "a", statements = "" }),
	) == ListListConstruct
	tensor_raw_view_decl: Bool = backend_helper_kind_of_prepared_tensor_renderer_op(
		RawViewDecl({ pointer_c_type = "T*", view = "v", source = "s" }),
	) == TensorRawViewDecl
	tensor_literal_boxed_borrowed_write: Bool = backend_helper_kind_of_prepared_tensor_renderer_op(
		TensorLiteralBoxedBorrowedWrite({ tensor = "t", index = "0", value = "v", temp_seed = "0" }),
	) == TensorTensorLiteralBoxedBorrowedWrite
	backend_string_byte_read: Bool = backend_helper_kind_of_prepared_backend_renderer_op(
		BackendStringByteRead("s", "0"),
	) == Catalog.BackendStringByteRead
	intrinsic_one_arg: Bool = backend_helper_kind_of_intrinsic_renderer_op(OneArg(MathSin)) == IntrinsicMathSin
	intrinsic_three_arg: Bool = backend_helper_kind_of_intrinsic_renderer_op(
		ThreeArgs(FixedAlloc),
	) == IntrinsicFixedAlloc

	tuple_name and tuple_construct and list_pointer_get and list_construct and tensor_raw_view_decl and tensor_literal_boxed_borrowed_write and backend_string_byte_read and intrinsic_one_arg and intrinsic_three_arg


tests: TestSuite = {
	description = "Backend helper kind mapping (op union -> BackendHelperKind)",
	tests = [
		("Dict ctor custom flag split maps to the right kind", test_dict_ctor_custom_flag_split),
		("Set ctor custom flag split maps to the right kind", test_set_ctor_custom_flag_split),
		(
			"Dict with-capacity custom flag split maps to the right kind",
			test_dict_with_capacity_custom_flag_split,
		),
		(
			"Dict stack-option key-release-policy flag splits map to the right kind",
			test_dict_stack_option_key_release_flag_splits,
		),
		(
			"Channel retaining-send runtime flag splits map to the right kind",
			test_channel_retaining_send_flag_splits,
		),
		("Mechanical prefix+variant-name mappings spot check", test_mechanical_prefix_mappings_spot_check),
	]
}
