	)
	plan = region_plan(body)

	cancellation_let_protection(plan, variable)
		.map(func(protection): protection.tracks_cleanup)
		.get_or(False)


pure func unresolved_consumed_call_does_not_establish_entry_handoff() -> Bool:
	variable: CoreVar = local_var("value", 52)
	body: CoreExpr = LetExpr(
		variable,
		False,
		STRING_TYPE,
		owned_string(),
		CallExpr(
			UserCall("missing", None, [0]),
			VOID_EXPR,
			[VarExpr(variable, STRING_TYPE, SyntheticSourceLoc)],
			VoidType,
			SyntheticSourceLoc,
		),
	)
	plan = region_plan(body)

	cancellation_let_protection(plan, variable)
		.map(func(protection): protection.tracks_cleanup)
		.get_or(False)


pure func known_builtin_and_runtime_effects_are_authoritative() -> Bool:
	builtin_summary: CancellationSummary = summary_for(
		program_with([function_decl("builtin_wait", 1, call_expr(BuiltinCall("yield_now")))]),
		"builtin_wait",
		1,
	).get_or({reasons = []})
	runtime_summary: CancellationSummary = summary_for(
		program_with([function_decl("runtime_wait", 2, call_expr(DirectRuntimeCall({
					name = "yield_now",
					args = DirectRuntimeArgsAsWritten,
					result = DirectRuntimeResultAsWritten,
				})))]),
		"runtime_wait",
		2,
	).get_or({reasons = []})
	nonwaiting_summary: CancellationSummary = summary_for(
		program_with([function_decl("nonwaiting", 3, call_expr(BuiltinCall("print")))]),
		"nonwaiting",
		3,
	).get_or({reasons = []})

	(
		builtin_summary.reasons.contains(BuiltinCancellationPoint("yield_now"))
		and runtime_summary.reasons.contains(BuiltinCancellationPoint("yield_now"))
		and not cancellation_effect_may_cancel(nonwaiting_summary)
	)


pure func user_call_effects_propagate_transitively() -> Bool:
	program: CoreProgram = program_with([
		function_decl("entry", 1, call_expr(UserCall("middle", Some(2), []))),
		function_decl("middle", 2, call_expr(UserCall("leaf", Some(3), []))),
		function_decl(
			"leaf",
			3,
			CooperativeCheckpointExpr(VoidType, SyntheticSourceLoc),
		),
	])
	summary: CancellationSummary = summary_for(program, "entry", 1).get_or({reasons = []})

	cancellation_effect_may_cancel(summary) and summary.reasons.contains(TransitiveCallBoundary)


pure func recursive_call_effects_converge() -> Bool:
	safe_program: CoreProgram = program_with([
		function_decl("safe_a", 1, call_expr(UserCall("safe_b", Some(2), []))),
		function_decl("safe_b", 2, call_expr(UserCall("safe_a", Some(1), []))),
	])
	cancelling_program: CoreProgram = program_with([
		function_decl("cancel_a", 3, call_expr(UserCall("cancel_b", Some(4), []))),
		function_decl(
			"cancel_b",
			4,
			SeqExpr(
				CooperativeCheckpointExpr(VoidType, SyntheticSourceLoc),
				call_expr(UserCall("cancel_a", Some(3), [])),
			),
		),
	])

	(
		not summary_for(safe_program, "safe_a", 1)
			.map(cancellation_effect_may_cancel)
			.get_or(True)
		and summary_for(cancelling_program, "cancel_a", 3)
			.map(cancellation_effect_may_cancel)
			.get_or(False)
	)


pure func unresolved_calls_fail_closed() -> Bool:
	summary: CancellationSummary = summary_for(
		program_with([function_decl("unknown", 1, call_expr(UnknownCall))]),
		"unknown",
		1,
	).get_or({reasons = []})

	cancellation_effect_may_cancel(summary) and summary.reasons.contains(UnknownCallBoundary)


pure func dynamic_global_initializers_are_summarized() -> Bool:
	program: CoreProgram = program_with([
		function_decl(
			"wait",
			1,
			CooperativeCheckpointExpr(VoidType, SyntheticSourceLoc),
		),
		global_decl("dynamic", 2, call_expr(UserCall("wait", Some(1), []))),
	])
	summary: CancellationSummary = cancellation_global_initializer_summary(
		analyze_program_cancellation(program),
		{
			name = "dynamic",
			def_id = 2
		},
	).get_or({reasons = []})

	cancellation_effect_may_cancel(summary)


pure func unresolved_and_external_call_forms_fail_closed() -> Bool:
	foreign_summary: CancellationSummary = summary_for(
		program_with(
			[
				function_decl(
					"foreign_caller",
					1,
					call_expr(ForeignCall("foreign_work", ForeignBorrowArgs)),
				),
			],
		),
		"foreign_caller",
		1,
	).get_or({reasons = []})
	closure_summary: CancellationSummary = summary_for(
		program_with([function_decl("closure_caller", 2, call_expr(ClosureCall))]),
		"closure_caller",
		2,
	).get_or({reasons = []})
	trait_summary: CancellationSummary = summary_for(
		program_with(
			[function_decl("trait_caller", 3, call_expr(DeferredTraitCall("Trait", "method")))],
		),
		"trait_caller",
		3,
	).get_or({reasons = []})

	(
		foreign_summary.reasons.contains(ForeignCallBoundary)
		and closure_summary.reasons.contains(ClosureCallBoundary)
		and trait_summary.reasons.contains(DeferredTraitCallBoundary)
	)


pure func selected_and_compiler_internal_calls_are_classified() -> Bool:
	program: CoreProgram = program_with([
		function_decl("direct", 1, call_expr(SelectedDirectCall(4))),
		function_decl("trait", 2, call_expr(SelectedTraitCall("Trait", "method", "module", 4))),
		function_decl("user", 3, call_expr(UserCall("safe", Some(4), []))),
		function_decl("safe", 4, call_expr(BuiltinCall("print"))),
	])
	summaries = analyze_program_cancellation(program)

	(
		not cancellation_function_summary(
			summaries,
			{
				name = "direct",
				def_id = 1
			},
		)
			.map(cancellation_effect_may_cancel)
			.get_or(True)
		and not cancellation_function_summary(
			summaries,
			{
				name = "trait",
				def_id = 2
			},
		)
			.map(cancellation_effect_may_cancel)
			.get_or(True)
		and not cancellation_function_summary(
			summaries,
			{
				name = "user",
				def_id = 3
			},
		)
			.map(cancellation_effect_may_cancel)
			.get_or(True)
		and not call_may_cancel(IntrinsicCall("sqrt"))
		and not call_may_cancel(ListToStringCall("to_string"))
		and not call_may_cancel(DictWithCapacityCall(GenericHashContainerConstructor))
	)


pure func specialized_runtime_bridge_calls_fail_closed() -> Bool:
	operation_call: CoreCallKind = OperationResultCall({
		builtin_name = "operation",
		runtime_c_name = "runtime_operation",
		runtime_result_c_type = "void*",
		temp_prefix = "operation",
		result_layout_policy = DefaultResultLayoutPolicy,
		success = {
			runtime_payload = RuntimeNoPayload,
			release_mask = 0
		},
		error = {
			none_tag = "none",
			detail_field = "detail",
			other_constructor = "Other",
			other_constructor_c_name = "Other",
			cases = []
		},
	})
	fallible_call: CoreCallKind = FallibleStreamTerminalCall({
		builtin_name = "stream",
		runtime_c_name = "runtime_stream",
		runtime_result_c_type = "void*",
		payload = FallibleStreamPayloadInt,
		error_domain = {
			domain_tag = "stream",
			other_constructor = "Other",
			other_constructor_c_name = "Other",
			cases = []
		},
	})

	(
		call_may_cancel(operation_call)
		and call_may_cancel(fallible_call)
		and call_may_cancel(TensorParallelCall("parallel", TensorParallelPointerLayout))
	)


