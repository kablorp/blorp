	test: TestSuite


private VOID_EXPR: CoreExpr = VoidExpr(VoidType, SyntheticSourceLoc)

private STRING_TYPE: CoreType = NamedType("String", [])


pure func call_expr(kind: CoreCallKind) -> CoreExpr:
	CallExpr(kind, VOID_EXPR, [], VoidType, SyntheticSourceLoc)


pure func function_decl(name: String, def_id: Int, body: CoreExpr) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = None,
		type_params = [],
		params = [],
		return_type = VoidType,
		body = Some(body),
		is_pure = False,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func global_decl(name: String, def_id: Int, init: CoreExpr) -> CoreDecl:
	GlobalDecl({
		name = {
			name = name,
			uniq = 0,
			def_id = Some(def_id)
		},
		source_module = None,
		typ = VoidType,
		init = init,
		is_mutable = False,
		is_const = False,
		is_private = True,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func program_with(decls: List[CoreDecl]) -> CoreProgram:
	{
		decls = decls,
		foreign_includes = []
	}


pure func summary_for(
	program: CoreProgram,
	name: String,
	def_id: Int,
) -> Option[CancellationSummary]:
	cancellation_function_summary(
		analyze_program_cancellation(program),
		{
			name = name,
			def_id = def_id
		},
	)


pure func call_may_cancel(kind: CoreCallKind) -> Bool:
	summary_for(program_with([function_decl("caller", 1, call_expr(kind))]), "caller", 1)
		.map(cancellation_effect_may_cancel)
		.get_or(True)


pure func release_policy_actions_are_closed() -> Bool:
	no_release_ok: Bool = cancellation_cleanup_action_for_release_policy(NoReleasePolicy).is_none()

	arc_ok: Bool = match cancellation_cleanup_action_for_release_policy(ArcReleasePolicy):
		Some(ReleaseArcCancellationOwner):
			True
		_:
			False

	arc_only_ok: Bool = match cancellation_cleanup_action_for_release_policy(ArcReleaseOnlyPolicy):
		Some(ReleaseArcOnlyCancellationOwner):
			True
		_:
			False

	stack_result_ok: Bool = match cancellation_cleanup_action_for_release_policy(
		StackResultReleasePolicy,
	):
		Some(ReleaseStackResultCancellationOwner):
			True
		_:
			False

	no_release_ok and arc_ok and arc_only_ok and stack_result_ok


pure func backend_temporary_owner_has_stable_site_identity() -> Bool:
	owner: CancellationOwnerIdentity = BackendTemporaryCancellationOwner(
		cancellation_site_id(17),
		SelectValueTemporary(3),
	)

	match owner:
		BackendTemporaryCancellationOwner(site, SelectValueTemporary(arm_index)):
			cancellation_site_id_value(site) == 17 and arm_index == 3
		_:
			False


pure func backend_temporary_candidates_are_typed_and_activation_scoped() -> Bool:
	plan = build_current_behavior_cancellation_plan(FunctionCancellationActivation({
			name = "temporary",
			def_id = 19,
		}), VOID_EXPR)
	candidate = cancellation_backend_temporary_candidate(
		plan,
		3,
		CallArgumentTemporary(2),
		ArcReleasePolicy,
		False,
		True,
	)

	match candidate:
		Some(value):
			match (value.activation, value.owner, value.action):
				(FunctionCancellationActivation(identity), BackendTemporaryCancellationOwner(site, CallArgumentTemporary(arg_index)), ReleaseArcCancellationOwner):
					(
						identity.def_id == 19
						and cancellation_site_id_value(site) == 4
						and arg_index == 2
					)
				_:
					False
		None:
			False


pure func callback_identities_round_trip_exactly() -> Bool:
	resource_action: CancellationCleanupAction = ReleaseResourceCancellationOwner(
		resource_cleanup_identity("blorp_file_close_reader"),
	)
	runtime_action: CancellationCleanupAction = RuntimeOwnedCancellationOwner(
		runtime_cleanup_identity("blorp_concurrent_task_window_cleanup"),
	)

	resource_ok: Bool = match resource_action:
		ReleaseResourceCancellationOwner(identity):
			resource_cleanup_identity_value(identity) == "blorp_file_close_reader"
		_:
			False

	runtime_ok: Bool = match runtime_action:
		RuntimeOwnedCancellationOwner(identity):
			runtime_cleanup_identity_value(identity) == "blorp_concurrent_task_window_cleanup"
		_:
			False

	resource_ok and runtime_ok


pure func local_var(name: String, uniq: Int) -> CoreVar:
	{
		name = name,
		uniq = uniq,
		def_id = None
	}


pure func owned_string() -> CoreExpr:
	LiteralExpr(StringLiteral("owned"), STRING_TYPE, SyntheticSourceLoc)


pure func current_behavior_plan_tracks_live_let_in_lexical_order() -> Bool:
	variable: CoreVar = local_var("value", 1)
	body: CoreExpr = LetExpr(variable, False, STRING_TYPE, owned_string(), VOID_EXPR)
	plan = build_current_behavior_cancellation_plan(FunctionCancellationActivation({
			name = "owner",
			def_id = 10,
		}), body)

	match (cancellation_let_protection(plan, variable), plan.sites):
		(Some(decision), [site]):
			match (site.before, site.after):
				([TrackCancellationOwner(_, owner_id, ReleaseArcCancellationOwner)], [UntrackCancellationOwner(_)]):
					(
						decision.tracks_cleanup
						and decision.untracks_after_body
						and cancellation_owner_id_value(owner_id) == 0
					)
				_:
					False
		_:
			False


pure func current_behavior_plan_preserves_consumed_owner_decision() -> Bool:
	variable: CoreVar = local_var("value", 1)
	body: CoreExpr = LetExpr(
		variable,
		False,
		STRING_TYPE,
		owned_string(),
		DropExpr(variable, STRING_TYPE, ArcReleasePolicy, VOID_EXPR, VoidType, SyntheticSourceLoc),
	)
	plan = build_current_behavior_cancellation_plan(FunctionCancellationActivation({
			name = "consume",
			def_id = 11,
		}), body)

	match cancellation_let_protection(plan, variable):
		Some(decision):
			not decision.tracks_cleanup and not decision.untracks_after_body
		None:
			False


pure func current_behavior_plan_uses_semantic_variable_identity() -> Bool:
	outer: CoreVar = local_var("same", 1)
	inner: CoreVar = local_var("same", 2)
	body: CoreExpr = LetExpr(
		outer,
		False,
		STRING_TYPE,
		owned_string(),
		LetExpr(inner, False, STRING_TYPE, owned_string(), VOID_EXPR),
	)
	plan = build_current_behavior_cancellation_plan(FunctionCancellationActivation({
			name = "identity",
			def_id = 12,
		}), body)

	match (cancellation_let_protection(plan, outer), cancellation_let_protection(plan, inner)):
		(Some(outer_decision), Some(inner_decision)):
			(
				outer_decision.owner_id != inner_decision.owner_id
				and outer_decision.variable.uniq == 1
				and inner_decision.variable.uniq == 2
				and plan.expression_visits == 5
			)
		_:
			False


pure func current_behavior_plan_visits_nested_ownership_once() -> Bool:
	depth: Int = 32
	var body: CoreExpr = VOID_EXPR
	var index: Int = 0

	while index < depth:
		body = LetExpr(
			local_var("nested", index),
			False,
			STRING_TYPE,
			owned_string(),
			body,
		)
		index += 1

	plan = build_current_behavior_cancellation_plan(FunctionCancellationActivation({
			name = "nested",
			def_id = 13,
		}), body)
	-- The removed ownership helpers each revisited every remaining body for
	-- tracking and untracking, for a conservative lower bound of 2 * depth^2.
	historical_visit_lower_bound: Int = 2 * depth * depth

	(
		plan.expression_visits == 2 * depth + 1
		and plan.expression_visits * 5 <= historical_visit_lower_bound
	)


pure func current_behavior_plan_carries_authoritative_effect() -> Bool:
	activation = FunctionCancellationActivation({
		name = "effect",
		def_id = 14,
	})
	safe_plan = build_current_behavior_cancellation_plan_with_summary(
		activation,
		VOID_EXPR,
		{reasons = []},
	)
	cancelling_plan = build_current_behavior_cancellation_plan_with_summary(
		activation,
		VOID_EXPR,
		{reasons = [ExplicitCancellationCheckpoint]},
	)

	safe_plan.effect == CannotCancelCurrentTask and cancelling_plan.effect == MayCancelCurrentTask


pure func noncancelling_activation_suppresses_local_cleanup_candidates() -> Bool:
	variable: CoreVar = local_var("value", 1)
	body: CoreExpr = LetExpr(variable, False, STRING_TYPE, owned_string(), VOID_EXPR)
	plan = build_current_behavior_cancellation_plan_with_summary(FunctionCancellationActivation({
			name = "safe_owner",
			def_id = 15,
		}), body, {reasons = []})
	candidate = cancellation_backend_temporary_candidate(
		plan,
		3,
		CallArgumentTemporary(0),
		ArcReleasePolicy,
		True,
		False,
	)

	match (cancellation_let_protection(plan, variable), plan.sites):
		(Some(decision), [site]):
			(
				plan.effect == CannotCancelCurrentTask
				and decision.tracks_cleanup
				and decision.untracks_after_body
				and site.before.length() == 1
				and site.after.length() == 1
				and candidate.is_some()
				and not cancellation_plan_requires_local_owner_protection(plan)
			)
		_:
			False


pure func cancelling_activation_retains_local_cleanup_candidates() -> Bool:
	plan = build_current_behavior_cancellation_plan_with_summary(
		FunctionCancellationActivation({
			name = "cancelling_owner",
			def_id = 16,
		}),
		CooperativeCheckpointExpr(VoidType, SyntheticSourceLoc),
		{reasons = [ExplicitCancellationCheckpoint]},
	)

	(
		cancellation_plan_requires_local_owner_protection(plan)
		and cancellation_backend_temporary_candidate(
			plan,
			3,
			CallArgumentTemporary(0),
			ArcReleasePolicy,
			True,
			False,
		).is_some()
	)


pure func known_builtin_and_runtime_effects_are_authoritative() -> Bool:
	builtin_summary: CancellationSummary = summary_for(
		program_with([function_decl("builtin_wait", 1, call_expr(BuiltinCall("yield_now")))]),
		"builtin_wait",
		1,
	).get_or({reasons = []})
	runtime_summary: CancellationSummary = summary_for(
		program_with([function_decl("runtime_wait", 2, call_expr(DirectRuntimeCall({
					name = "yield_now",
					args = DirectRuntimeArgsAsWritten,
					result = DirectRuntimeResultAsWritten,
				})))]),
		"runtime_wait",
		2,
	).get_or({reasons = []})
	nonwaiting_summary: CancellationSummary = summary_for(
		program_with([function_decl("nonwaiting", 3, call_expr(BuiltinCall("print")))]),
		"nonwaiting",
		3,
	).get_or({reasons = []})

	(
		builtin_summary.reasons.contains(BuiltinCancellationPoint("yield_now"))
		and runtime_summary.reasons.contains(BuiltinCancellationPoint("yield_now"))
		and not cancellation_effect_may_cancel(nonwaiting_summary)
	)


pure func user_call_effects_propagate_transitively() -> Bool:
	program: CoreProgram = program_with([
		function_decl("entry", 1, call_expr(UserCall("middle", Some(2), []))),
		function_decl("middle", 2, call_expr(UserCall("leaf", Some(3), []))),
		function_decl(
			"leaf",
			3,
			CooperativeCheckpointExpr(VoidType, SyntheticSourceLoc),
		),
	])
	summary: CancellationSummary = summary_for(program, "entry", 1).get_or({reasons = []})

	cancellation_effect_may_cancel(summary) and summary.reasons.contains(TransitiveCallBoundary)


pure func recursive_call_effects_converge() -> Bool:
	safe_program: CoreProgram = program_with([
		function_decl("safe_a", 1, call_expr(UserCall("safe_b", Some(2), []))),
		function_decl("safe_b", 2, call_expr(UserCall("safe_a", Some(1), []))),
	])
	cancelling_program: CoreProgram = program_with([
		function_decl("cancel_a", 3, call_expr(UserCall("cancel_b", Some(4), []))),
		function_decl(
			"cancel_b",
			4,
			SeqExpr(
				CooperativeCheckpointExpr(VoidType, SyntheticSourceLoc),
				call_expr(UserCall("cancel_a", Some(3), [])),
			),
		),
	])

	(
		not summary_for(safe_program, "safe_a", 1)
			.map(cancellation_effect_may_cancel)
			.get_or(True)
		and summary_for(cancelling_program, "cancel_a", 3)
			.map(cancellation_effect_may_cancel)
			.get_or(False)
	)


pure func unresolved_calls_fail_closed() -> Bool:
	summary: CancellationSummary = summary_for(
		program_with([function_decl("unknown", 1, call_expr(UnknownCall))]),
		"unknown",
		1,
	).get_or({reasons = []})

	cancellation_effect_may_cancel(summary) and summary.reasons.contains(UnknownCallBoundary)


pure func dynamic_global_initializers_are_summarized() -> Bool:
	program: CoreProgram = program_with([
		function_decl(
			"wait",
			1,
			CooperativeCheckpointExpr(VoidType, SyntheticSourceLoc),
		),
		global_decl("dynamic", 2, call_expr(UserCall("wait", Some(1), []))),
	])
	summary: CancellationSummary = cancellation_global_initializer_summary(
		analyze_program_cancellation(program),
		{
			name = "dynamic",
			def_id = 2
		},
	).get_or({reasons = []})

	cancellation_effect_may_cancel(summary)


pure func unresolved_and_external_call_forms_fail_closed() -> Bool:
	foreign_summary: CancellationSummary = summary_for(
		program_with(
			[
				function_decl(
					"foreign_caller",
					1,
					call_expr(ForeignCall("foreign_work", ForeignBorrowArgs)),
				),
			],
		),
		"foreign_caller",
		1,
	).get_or({reasons = []})
	closure_summary: CancellationSummary = summary_for(
		program_with([function_decl("closure_caller", 2, call_expr(ClosureCall))]),
		"closure_caller",
		2,
	).get_or({reasons = []})
	trait_summary: CancellationSummary = summary_for(
		program_with(
			[function_decl("trait_caller", 3, call_expr(DeferredTraitCall("Trait", "method")))],
		),
		"trait_caller",
		3,
	).get_or({reasons = []})

	(
		foreign_summary.reasons.contains(ForeignCallBoundary)
		and closure_summary.reasons.contains(ClosureCallBoundary)
		and trait_summary.reasons.contains(DeferredTraitCallBoundary)
	)


pure func selected_and_compiler_internal_calls_are_classified() -> Bool:
	program: CoreProgram = program_with([
		function_decl("direct", 1, call_expr(SelectedDirectCall(4))),
		function_decl("trait", 2, call_expr(SelectedTraitCall("Trait", "method", "module", 4))),
		function_decl("user", 3, call_expr(UserCall("safe", Some(4), []))),
		function_decl("safe", 4, call_expr(BuiltinCall("print"))),
	])
	summaries = analyze_program_cancellation(program)

	(
		not cancellation_function_summary(
			summaries,
			{
				name = "direct",
				def_id = 1
			},
		)
			.map(cancellation_effect_may_cancel)
			.get_or(True)
		and not cancellation_function_summary(
			summaries,
			{
				name = "trait",
				def_id = 2
			},
		)
			.map(cancellation_effect_may_cancel)
			.get_or(True)
		and not cancellation_function_summary(
			summaries,
			{
				name = "user",
				def_id = 3
			},
		)
			.map(cancellation_effect_may_cancel)
			.get_or(True)
		and not call_may_cancel(IntrinsicCall("sqrt"))
		and not call_may_cancel(ListToStringCall("to_string"))
		and not call_may_cancel(DictWithCapacityCall(GenericHashContainerConstructor))
	)


pure func specialized_runtime_bridge_calls_fail_closed() -> Bool:
	operation_call: CoreCallKind = OperationResultCall({
		builtin_name = "operation",
		runtime_c_name = "runtime_operation",
		runtime_result_c_type = "void*",
		temp_prefix = "operation",
		result_layout_policy = DefaultResultLayoutPolicy,
		success = {
			runtime_payload = RuntimeNoPayload,
			release_mask = 0
		},
		error = {
			none_tag = "none",
			detail_field = "detail",
			other_constructor = "Other",
			other_constructor_c_name = "Other",
			cases = []
		},
	})
	fallible_call: CoreCallKind = FallibleStreamTerminalCall({
		builtin_name = "stream",
		runtime_c_name = "runtime_stream",
		runtime_result_c_type = "void*",
		payload = FallibleStreamPayloadInt,
		error_domain = {
			domain_tag = "stream",
			other_constructor = "Other",
			other_constructor_c_name = "Other",
			cases = []
		},
	})

	(
		call_may_cancel(operation_call)
		and call_may_cancel(fallible_call)
		and call_may_cancel(TensorParallelCall("parallel", TensorParallelPointerLayout))
	)


tests: TestSuite = {
	description = "Cancellation cleanup planning",
	tests = [
		("release policies map to closed cleanup actions", release_policy_actions_are_closed),
		(
			"backend temporary owners include stable site identity",
			backend_temporary_owner_has_stable_site_identity,
		),
		(
			"backend temporary candidates are typed and activation scoped",
			backend_temporary_candidates_are_typed_and_activation_scoped,
		),
		(
			"callback identities preserve exact prepared callbacks",
			callback_identities_round_trip_exactly,
		),
		(
			"current behavior plans order live let protection",
			current_behavior_plan_tracks_live_let_in_lexical_order,
		),
		(
			"current behavior plans preserve consumed owners",
			current_behavior_plan_preserves_consumed_owner_decision,
		),
		(
			"current behavior plans use semantic variable identity",
			current_behavior_plan_uses_semantic_variable_identity,
		),
		(
			"current behavior planning visits nested ownership once",
			current_behavior_plan_visits_nested_ownership_once,
		),
		(
			"current behavior plans carry authoritative cancellation effects",
			current_behavior_plan_carries_authoritative_effect,
		),
		(
			"noncancelling activations suppress local cleanup candidates",
			noncancelling_activation_suppresses_local_cleanup_candidates,
		),
		(
			"cancelling activations retain local cleanup candidates",
			cancelling_activation_retains_local_cleanup_candidates,
		),
		(
			"known builtin and runtime effects use the builtin authority",
			known_builtin_and_runtime_effects_are_authoritative,
		),
		("user-call effects propagate transitively", user_call_effects_propagate_transitively),
		("recursive call effects converge", recursive_call_effects_converge),
		("unresolved calls fail closed", unresolved_calls_fail_closed),
		("dynamic global initializers are summarized", dynamic_global_initializers_are_summarized),
		(
			"unresolved and external call forms fail closed",
			unresolved_and_external_call_forms_fail_closed,
		),
		(
			"selected and compiler-internal calls are classified",
			selected_and_compiler_internal_calls_are_classified,
		),
		(
			"specialized runtime bridge calls fail closed",
			specialized_runtime_bridge_calls_fail_closed,
		),
	]
}
