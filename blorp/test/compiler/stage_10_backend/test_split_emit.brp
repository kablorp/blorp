import:
	../../../src/compiler/stage_09_core/ir:
		CoreBinaryOp(AddOp),
		CoreDecl(EnumDecl, FunctionDecl, GlobalDecl, HeapRecordDecl, UnionDecl),
		CoreEnumDecl,
		CoreExpr(BinaryExpr, LiteralExpr, ListConstructExpr),
		CoreFunction,
		CoreFunctionKind(ProgramEntrypointFunction, UserFunction),
		CoreGlobal,
		CoreHeapRecordDecl,
		CoreListStorageLayout(InlineListStorage, PointerListStorage),
		CoreLiteral(IntLiteral, StringLiteral),
		CoreProgram,
		CoreReleasePolicy(ArcReleasePolicy, NoReleasePolicy),
		CoreSourceLoc,
		synthetic_core_source_loc,
		CoreType(NamedType),
		CoreUnionDecl,
		CoreUnionPayloadStorage(ErasedUnionPayloadStorage, TypedUnionPayloadStorage),
		CoreVar,
	../../../src/compiler/stage_09_core/pipeline: run_pre_dce_tail
	../../../src/compiler/stage_10_backend/c_symbol_projection:
		projected_callable_base_symbol,
		projected_type_base_symbol,
	../../../src/compiler/stage_10_backend/emit:
		CTranslationUnitSet,
		CoreEmitError,
		static_string_literal_macro,
		try_emit_prepared_core_program_c_artifact_with_profile,
		try_emit_prepared_core_program_c_split_artifact_with_profile,
	../../../src/lib/function_profile: FunctionProfileConfiguration(FunctionProfileOff)
	test: TestSuite


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func string_type() -> CoreType:
	NamedType("String", [])


pure func list_int_type() -> CoreType:
	NamedType("List", [int_type()])


---
A trivial user function `name() -> Int { return <value> }`, used to populate
`function_definitions` with several small, distinctly named functions so
`bin_function_definitions` has more than one function to spread across
translation units.
---
pure func trivial_int_function(name: String, def_id: Int, value: Int) -> CoreFunction:
	{
		name = name,
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(LiteralExpr(IntLiteral(value), int_type(), synthetic_core_source_loc())),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = synthetic_core_source_loc()
	}


pure func entrypoint_function() -> CoreFunction:
	{
		name = "main",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(LiteralExpr(IntLiteral(0), int_type(), synthetic_core_source_loc())),
		is_pure = False,
		function_kind = ProgramEntrypointFunction,
		def_id = 1,
		loc = synthetic_core_source_loc()
	}


---
A heap record with a releasable field, so it emits a destroy function (not
just a make function) -- the split-only prototype/definition pair this
suite's prototype-agreement test exercises.
---
pure func box_heap_record_decl() -> CoreHeapRecordDecl:
	{
		abi_type = None,
		name = "Box",
		type_params = [],
		fields = [
			{
				name = "count",
				typ = int_type(),
				release_policy = NoReleasePolicy
			},
			{
				name = "label",
				typ = string_type(),
				release_policy = ArcReleasePolicy
			},
		],
		loc = synthetic_core_source_loc()
	}


---
A union with both an owner-data (zero-field) variant and a releasable
non-empty variant, so it exercises the owner-data extern/define split, the
union destroy function, and a non-empty variant's constructor prototype.
---
pure func doc_union_decl() -> CoreUnionDecl:
	{
		abi_type = None,
		name = "Doc",
		type_params = [],
		payload_storage = TypedUnionPayloadStorage,
		variants = [
			{
				name = "Nil",
				c_name = "__def_700_Nil",
				tag_c_name = "TAG_Doc_Nil",
				tag = 0,
				fields = [],
				def_id = Some(700)
			},
			{
				name = "Text",
				c_name = "__def_701_Text",
				tag_c_name = "TAG_Doc_Text",
				tag = 1,
				fields = [
					{
						typ = string_type(),
						release_policy = ArcReleasePolicy
					},
				],
				def_id = Some(701)
			},
		],
		loc = synthetic_core_source_loc()
	}


pure func erased_doc_split_program() -> CoreProgram:
	{
		decls = [
			UnionDecl({ doc_union_decl() | payload_storage = ErasedUnionPayloadStorage }),
		],
		foreign_includes = [],
		source_files = []
	}


pure func color_enum_decl() -> CoreEnumDecl:
	{
		abi_type = None,
		name = "Color",
		type_params = [],
		variants = [
			{
				name = "Red",
				c_name = "__def_101_Red",
				tag = 0,
				def_id = Some(101)
			},
			{
				name = "Blue",
				c_name = "__def_102_Blue",
				tag = 1,
				def_id = Some(102)
			},
		],
		loc = synthetic_core_source_loc()
	}


pure func answer_var() -> CoreVar:
	{
		name = "ANSWER",
		id = 0,
		def_id = Some(70)
	}


pure func answer_global() -> CoreGlobal:
	{
		name = answer_var(),
		source_module = None,
		typ = int_type(),
		init = LiteralExpr(IntLiteral(42), int_type(), synthetic_core_source_loc()),
		is_mutable = False,
		is_const = True,
		is_private = False,
		def_id = 70,
		loc = synthetic_core_source_loc()
	}


pure func greeting_var() -> CoreVar:
	{
		name = "GREETING",
		id = 0,
		def_id = Some(80)
	}


---
A `const String` global whose initializer is a plain string literal --
today's pipeline classifies this into the backend static-string-literal
pool, so this is what puts at least one literal through the split path's
`BLORP_EXTERN_STRING` macro.
---
pure func greeting_global() -> CoreGlobal:
	{
		name = greeting_var(),
		source_module = None,
		typ = string_type(),
		init = LiteralExpr(StringLiteral("hello, split"), string_type(), synthetic_core_source_loc()),
		is_mutable = False,
		is_const = True,
		is_private = False,
		def_id = 80,
		loc = synthetic_core_source_loc()
	}


---
An empty-list-construct function, so the program has at least one canonical
empty list -- the split path's named-storage-type rewrite of
`canonical_empty_list_definition`.
---
pure func empty_ints_function() -> CoreFunction:
	{
		name = "empty_ints",
		source_module = None,
		type_params = [],
		params = [],
		return_type = list_int_type(),
		body = Some(
			ListConstructExpr(
				{
					layout = InlineListStorage(8),
					elements = [],
					elem_needs_release = False
				},
				list_int_type(),
				synthetic_core_source_loc(),
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 6,
		loc = synthetic_core_source_loc()
	}


---
No `ProgramEntrypointFunction` here, deliberately: `run_pre_dce_tail` prunes
anything unreachable from an entrypoint once one is present, and wiring a
realistic, resource-correct call chain from `main` down through a heap
record, a union, and five functions is exactly the fragile hand-IR-building
this suite wants to avoid. Every decl below is a program-level root when
there is no entrypoint, so all of them survive to the emitter untouched;
`entrypoint_only_program` below covers the entrypoint prototype/definition
case on its own.
---
pure func split_test_program() -> CoreProgram:
	{
		decls = [
			HeapRecordDecl(box_heap_record_decl()),
			UnionDecl(doc_union_decl()),
			EnumDecl(color_enum_decl()),
			GlobalDecl(answer_global()),
			GlobalDecl(greeting_global()),
			FunctionDecl(empty_ints_function()),
			FunctionDecl(trivial_int_function("alpha", 10, 1)),
			FunctionDecl(trivial_int_function("beta", 11, 2)),
			FunctionDecl(trivial_int_function("gamma", 12, 3)),
			FunctionDecl(trivial_int_function("delta", 13, 4)),
		],
		foreign_includes = [],
		source_files = []
	}


pure func entrypoint_only_program() -> CoreProgram:
	{
		decls = [FunctionDecl(entrypoint_function())],
		foreign_includes = [],
		source_files = []
	}


pure func count_occurrences(text: String, needle: String) -> Int:
	text
		.split(needle)
		.length() - 1


pure func count_occurrences_across(bodies: List[String], needle: String) -> Int:
	var total: Int = 0

	for body in bodies:
		total += count_occurrences(body, needle)

	total


pure func split_result() -> Result[CTranslationUnitSet, CoreEmitError]:
	try_emit_prepared_core_program_c_split_artifact_with_profile(
		run_pre_dce_tail(split_test_program()),
		FunctionProfileOff,
		3,
		"blorp_shared.h",
	)


pure func entrypoint_split_result() -> Result[CTranslationUnitSet, CoreEmitError]:
	try_emit_prepared_core_program_c_split_artifact_with_profile(
		run_pre_dce_tail(entrypoint_only_program()),
		FunctionProfileOff,
		3,
		"blorp_shared.h",
	)


---
Test 1: at `unit_count == 1`, the split entry point returns exactly the
single-file path's output as the sole body, with no header, and adds no
extra units.
---
pure func test_unit_count_one_matches_single_file_path() -> Bool:
	match (
		try_emit_prepared_core_program_c_split_artifact_with_profile(
			run_pre_dce_tail(split_test_program()),
			FunctionProfileOff,
			1,
			"blorp_shared.h",
		),
		try_emit_prepared_core_program_c_artifact_with_profile(
			run_pre_dce_tail(split_test_program()),
			FunctionProfileOff,
		),
	):
		(Ok(split), Ok(single)):
			split.shared_header == "" and split.bodies == [single.c_code]
		_:
			False


---
Test 2: at `unit_count == 3`, every function definition appears in exactly
one body and never in the header, every function (entrypoint, destroys,
enum_to_string included) has exactly one prototype in the header, and no
body contains a `typedef`.
---
pure func trivial_function_signature(def_id: Int) -> String:
	"long " + projected_callable_base_symbol(def_id) + "(void)"


pure func test_header_body_partition_at_three_units() -> Bool:
	match split_result():
		Ok(result):
			function_signatures: List[String] = [
				trivial_function_signature(10),
				trivial_function_signature(11),
				trivial_function_signature(12),
				trivial_function_signature(13),
			]
			destroy_signatures: List[String] = [
				"void " + projected_type_base_symbol(0) + "_destroy(void* obj)",
				"void " + projected_type_base_symbol(1) + "_destroy(void* obj)",
			]

			var functions_ok: Bool = True

			for signature in function_signatures:
				definition_count: Int = count_occurrences_across(result.bodies, signature + " {")
				prototype_count: Int = count_occurrences(result.shared_header, signature + ";")

				if definition_count != 1 or prototype_count != 1:
					functions_ok = False

			var destroys_ok: Bool = True

			for signature in destroy_signatures:
				definition_count: Int = count_occurrences_across(result.bodies, signature + " {")
				prototype_count: Int = count_occurrences(result.shared_header, signature + ";")

				if definition_count != 1 or prototype_count != 1:
					destroys_ok = False

			var no_body_defines_prototype_text: Bool = True

			for signature in function_signatures:
				if result.shared_header.contains(signature + " {"):
					no_body_defines_prototype_text = False

			var no_typedef_in_bodies: Bool = True

			for body in result.bodies:
				if body.contains("typedef"):
					no_typedef_in_bodies = False

			(
				result.bodies.length() == 3
				and functions_ok
				and destroys_ok
				and no_body_defines_prototype_text
				and no_typedef_in_bodies
			)
		Err(_):
			False


---
Projected split output must use one artifact-local C type symbol consistently
for the erased union typedef, its constructor prototype, and its definition;
the field and cleanup mask must also agree across the prototype/definition
boundary.
---
pure func test_projected_erased_union_constructor_abi_matches() -> Bool:
	match try_emit_prepared_core_program_c_split_artifact_with_profile(
		run_pre_dce_tail(erased_doc_split_program()),
		FunctionProfileOff,
		3,
		"blorp_shared.h",
	):
		Ok(result):
			type_symbol: String = projected_type_base_symbol(0)
			constructor_signature: String = (
				type_symbol + "* __def_701_Text(void* field0, unsigned long release_mask)"
			)
			(
				result.shared_header.contains("typedef struct " + type_symbol + " {")
					and result.shared_header.contains("struct { void* field0; } Text;")
					and result.shared_header.contains(constructor_signature + ";")
					and count_occurrences_across(result.bodies, constructor_signature + " {") == 1
			)
		Err(_):
			False


---
Test 3: each `BLORP_EXTERN_STRING(<sym>,` appears exactly once across all
bodies; each `extern blorp_String <sym>;` appears exactly once in the
header; `BLORP_STATIC_STRING(` appears zero times anywhere in split output.
A duplicated or mis-declared literal is a *silent* failure at link time (it
still links and runs, but breaks `same_object` pointer identity), which is
exactly why this invariant needs a dedicated test rather than relying on
the compiler to catch it.
---
pure func test_string_literal_defined_once_and_declared_once() -> Bool:
	match split_result():
		Ok(result):
			extern_definition_count: Int = count_occurrences_across(
				result.bodies,
				"BLORP_EXTERN_STRING(__blorp_string_literal_0,",
			)
			extern_decl_count: Int = count_occurrences(
				result.shared_header,
				"extern blorp_String __blorp_string_literal_0;",
			)
			static_macro_uses: Int = count_occurrences_across(
				result.bodies,
				"BLORP_STATIC_STRING(",
			) + count_occurrences(result.shared_header, "BLORP_STATIC_STRING(")

			extern_definition_count == 1 and extern_decl_count == 1 and static_macro_uses == 0
		Err(_):
			False


---
Test 4: no body other than TU 0 defines the global; no cross-TU global
definition begins with `static`; the global is defined exactly once across
bodies.
---
pure func test_global_defined_once_by_tu_zero() -> Bool:
	match split_result():
		Ok(result):
			definition_count: Int = count_occurrences_across(result.bodies, "long ANSWER = 42L;")
			tu_zero_defines_it: Bool = result.bodies
				.get(0)
				.map(func(body): body.contains("long ANSWER = 42L;")) == Some(True)
			no_static_definition: Bool = count_occurrences_across(
				result.bodies,
				"static long ANSWER = 42L;",
			) == 0

			var other_tus_empty_of_it: Bool = True
			var index: Int = 0

			for body in result.bodies:
				if index > 0 and body.contains("ANSWER = 42L;"):
					other_tus_empty_of_it = False

				index += 1

			(
				definition_count == 1
				and tu_zero_defines_it
				and no_static_definition
				and other_tus_empty_of_it
			)
		Err(_):
			False


---
Test 5: every canonical-empty-list symbol has a named
`typedef struct { ... } <sym>__storage;` in the header (not an anonymous
struct repeated per TU, which is a distinct incompatible type in every TU
that declares it), and `extern struct {` -- the anonymous-extern shape this
step replaces -- appears nowhere in split output.
---
pure func test_canonical_empty_list_has_named_storage_type() -> Bool:
	match split_result():
		Ok(result):
			symbol: String = "__blorp_canonical_empty_list_inline_8"

			(
				result.shared_header.contains("typedef struct { ")
				and result.shared_header.contains("} " + symbol + "__storage;")
				and result.shared_header.contains("extern " + symbol + "__storage " + symbol + ";")
				and not result.shared_header.contains("extern struct {")
				and count_occurrences_across(result.bodies, "extern struct {") == 0
			)
		Err(_):
			False


---
Test 6: rendering the same program twice yields identical header and bodies.
---
pure func test_split_rendering_is_deterministic() -> Bool:
	match (split_result(), split_result()):
		(Ok(first), Ok(second)):
			first.shared_header == second.shared_header and first.bodies == second.bodies
		_:
			False


---
Test 7: for each function this suite tracks, the header prototype text
equals the definition's signature text plus ";".
---
pure func test_prototype_matches_definition_signature() -> Bool:
	match split_result():
		Ok(result):
			signatures: List[String] = [
				trivial_function_signature(10),
				trivial_function_signature(11),
				"void " + projected_type_base_symbol(0) + "_destroy(void* obj)",
				"void " + projected_type_base_symbol(1) + "_destroy(void* obj)",
			]

			var ok: Bool = True

			for signature in signatures:
				has_prototype: Bool = result.shared_header.contains(signature + ";")
				has_definition: Bool = count_occurrences_across(
					result.bodies,
					signature + " {",
				) == 1

				if not (has_prototype and has_definition):
					ok = False

			ok
		Err(_):
			False


---
The program entrypoint is the one function `emit_function_forward_decl`
never prototypes (it always returns `""` for `ProgramEntrypointFunction`,
single-file path included) -- split adds its prototype via
`entrypoint_forward_decl_for_split`, so it needs its own check.
---
pure func test_entrypoint_has_prototype_and_definition() -> Bool:
	match entrypoint_split_result():
		Ok(result):
			(
				result.shared_header.contains("int main(void);")
				and count_occurrences_across(result.bodies, "int main(void) {") == 1
			)
		Err(_):
			False


---
The entrypoint calls `__blorp_init_globals`, whose definition belongs to the
first unit, and LPT is free to bin the entrypoint into any unit -- so the
shared header declares it, once, for whichever unit holds the entrypoint.
Without that declaration the call is an implicit declaration at best, and
which bin the entrypoint landed in decides whether the artifact builds.
---
pure func test_global_initializer_is_declared_once_in_the_header() -> Bool:
	match (split_result(), entrypoint_split_result()):
		(Ok(with_globals), Ok(entrypoint_only)):
			(
				count_occurrences(
					with_globals.shared_header,
					"void __blorp_init_globals(void);",
				) == 1
				and count_occurrences_across(
					with_globals.bodies,
					"void __blorp_init_globals(void) {",
				) == 1
				and count_occurrences(
					entrypoint_only.shared_header,
					"void __blorp_init_globals(void);",
				) == 1
			)
		_:
			False


---
Test 8: `static_string_literal_macro("BLORP_STATIC_STRING", "static ")` must
equal the exact text `STATIC_STRING_LITERAL_DECLARATION_MACRO` held before
this step (embedded here verbatim) -- the single-file emission path is
never allowed to drift from this text.
---
pure func previous_static_string_literal_declaration_macro() -> String:
	"#define BLORP_STATIC_STRING(name, length, bytes) \\\n" + "  _Static_assert(sizeof(bytes) == (length) + 1, \"string literal byte length\"); \\\n" + "  static blorp_String name = { \\\n" + "    .header = { BLORP_IMMORTAL_REFCOUNT, BLORP_ALLOC_CLASS_DIRECT, 0 }, \\\n" + "    .len = (length), \\\n" + "    .capacity = (length), \\\n" + "    .data = bytes \\\n" + "  }"


pure func test_single_path_string_literal_macro_is_unchanged() -> Bool:
	static_string_literal_macro(
		"BLORP_STATIC_STRING",
		"static ",
	) == previous_static_string_literal_declaration_macro()


---
A nested chain of `AddOp` additions, `remaining` levels deep, so a function's
body can be made arbitrarily large without adding new declaration shapes --
LPT-binning tests below use this to build one outsized function among many
small ones.
---
pure func nested_add_chain(remaining: Int) -> CoreExpr:
	if remaining <= 0:
		LiteralExpr(IntLiteral(1), int_type(), synthetic_core_source_loc())
	else:
		BinaryExpr(
			AddOp,
			LiteralExpr(IntLiteral(1), int_type(), synthetic_core_source_loc()),
			nested_add_chain(remaining - 1),
			int_type(),
			synthetic_core_source_loc(),
		)


---
A `name() -> Int { return <nested_add_chain(depth)> }` function, so its
emitted text size is controlled by `depth` alone while its declared shape
(an `Int`-returning, parameterless function) stays identical to
`trivial_int_function` -- `trivial_function_signature(def_id)` matches both.
---
pure func sized_int_function(def_id: Int, depth: Int) -> CoreFunction:
	{
		name = "sized_" + def_id.to_string(),
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(nested_add_chain(depth)),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = synthetic_core_source_loc()
	}


---
45 small functions (`depth = index / 2`, so on the order of 20x smaller
than the outlier on average and, at `index = 0`, orders of magnitude
smaller) plus one outlier roughly 20x the average small function's size
(`depth = 225`), all as program-level roots (no entrypoint, same pattern
`split_test_program` uses).

A single atomic function can only ever occupy one bin, so no binning
algorithm can spread it out: the bin holding the outlier is bounded below
by the outlier's own size, and that bound is achievable (within the 1.35x
tolerance the balance test below checks) only once the rest of the program
carries enough total weight to bring the other bins' mean up close to it.
This keeps the size imbalance without making an unrelated recursive Core pass
the limiting factor on a default Linux stack.
---
pure func skewed_program() -> CoreProgram:
	{
		decls = [
			FunctionDecl(
				sized_int_function(
					900,
					225,
				),
			),
		].concat(skewed_small_function_decls(45, 910)),
		foreign_includes = [],
		source_files = []
	}


pure func skewed_small_function_decls(count: Int, start_def_id: Int) -> List[CoreDecl]:
	var decls: List[CoreDecl] = []
	var index: Int = 0

	while index < count:
		def_id: Int = start_def_id + index
		decls = decls.append(FunctionDecl(sized_int_function(def_id, index / 2)))
		index += 1

	decls


pure func mean_body_length(bodies: List[String]) -> Int:
	var total: Int = 0

	for body in bodies:
		total += body.length()

	if bodies.length() == 0:
		0
	else:
		total / bodies.length()


pure func max_body_length(bodies: List[String]) -> Int:
	var longest: Int = 0

	for body in bodies:
		if body.length() > longest:
			longest = body.length()

	longest


---
Test 9: a program with one outlier function, split across 4 units, keeps
every bin within 1.35x the mean bin size -- the `skewed_program` docstring
above works through why that bound needs the rest of the program's total
size to be a couple of times the outlier's, not just "many small
functions." A single sweep in declaration order (the placeholder this step
replaces) has no notion of size at all, so it has no way to guarantee this
regardless of how the program is shaped; this is LPT binning's balance
guarantee, exercised end to end.
---
pure func test_skewed_program_balances_within_bound() -> Bool:
	match try_emit_prepared_core_program_c_split_artifact_with_profile(
		run_pre_dce_tail(skewed_program()),
		FunctionProfileOff,
		4,
		"blorp_shared.h",
	):
		Ok(result):
			mean_len: Int = mean_body_length(result.bodies)
			longest_len: Int = max_body_length(result.bodies)

			-- longest <= 1.35 * mean, in integer arithmetic: longest * 100 <= mean * 135.
			longest_len * 100 <= mean_len * 135
		Err(_):
			False


---
Five differently sized functions with def_ids assigned in an order that
does not track size (the middle-sized function has the lowest def_id, the
largest has a middle def_id, and so on), so a bin that merely preserved LPT
assignment order -- largest function first -- would fail this test. Used by
the emission-order test below.
---
pure func scrambled_size_program() -> CoreProgram:
	{
		decls = [
			FunctionDecl(sized_int_function(522, 90)),
			FunctionDecl(sized_int_function(520, 10)),
			FunctionDecl(sized_int_function(524, 70)),
			FunctionDecl(sized_int_function(521, 30)),
			FunctionDecl(sized_int_function(523, 50)),
		],
		foreign_includes = [],
		source_files = []
	}


pure func scrambled_size_def_ids() -> List[Int]:
	[520, 521, 522, 523, 524]


---
Every def_id in `def_ids` that this body defines, paired with the byte
offset of its definition, so emission order inside the body can be checked
against def_id order.
---
pure func def_id_offsets_in_body(body: String, def_ids: List[Int]) -> List[(Int, Int)]:
	var pairs: List[(Int, Int)] = []

	for def_id in def_ids:
		match body.index_of(trivial_function_signature(def_id) + " {"):
			Some(offset):
				pairs = pairs.append((offset, def_id))
			None:
				void

	pairs


pure func def_id_order_is_strictly_increasing(body: String, def_ids: List[Int]) -> Bool:
	offsets_ascending: List[(Int, Int)] = def_id_offsets_in_body(
		body,
		def_ids,
	).sort_by(
		func(pair: (Int, Int)): pair[0],
	)

	var ok: Bool = True
	var previous_def_id: Int = -1
	var seen_any: Bool = False

	for pair in offsets_ascending:
		def_id: Int = pair[1]

		if seen_any and def_id <= previous_def_id:
			ok = False

		previous_def_id = def_id
		seen_any = True

	ok


---
Test 10: within every body, the def_ids of the functions it defines appear
in strictly increasing order -- the re-sort step after LPT assignment, not
whatever order the greedy bin-packing itself produced.
---
pure func test_order_within_bin_is_by_def_id() -> Bool:
	match try_emit_prepared_core_program_c_split_artifact_with_profile(
		run_pre_dce_tail(scrambled_size_program()),
		FunctionProfileOff,
		2,
		"blorp_shared.h",
	):
		Ok(result):
			var ok: Bool = True

			for body in result.bodies:
				if not def_id_order_is_strictly_increasing(body, scrambled_size_def_ids()):
					ok = False

			ok
		Err(_):
			False


---
Two functions asked to split across 5 units: `unit_count` exceeds the
function count, so the split path must clamp to the function count rather
than padding with empty bodies.
---
pure func few_functions_program() -> CoreProgram:
	{
		decls = [
			FunctionDecl(trivial_int_function("only_a", 950, 1)),
			FunctionDecl(trivial_int_function("only_b", 951, 2)),
		],
		foreign_includes = [],
		source_files = []
	}


---
Test 11: `unit_count` greater than the function count yields exactly as many
bodies as there are functions, each non-empty, rather than padding with
empty bodies up to `unit_count`.
---
pure func test_unit_count_exceeding_function_count_has_no_empty_bodies() -> Bool:
	match try_emit_prepared_core_program_c_split_artifact_with_profile(
		run_pre_dce_tail(few_functions_program()),
		FunctionProfileOff,
		5,
		"blorp_shared.h",
	):
		Ok(result):
			has_a: Bool = count_occurrences_across(
				result.bodies,
				trivial_function_signature(950) + " {",
			) == 1
			has_b: Bool = count_occurrences_across(
				result.bodies,
				trivial_function_signature(951) + " {",
			) == 1

			var no_body_is_empty: Bool = True

			for body in result.bodies:
				if body.length() == 0:
					no_body_is_empty = False

			result.bodies.length() == 2 and has_a and has_b and no_body_is_empty
		Err(_):
			False


---
A heap record with a field literally named `header`, colliding with the
runtime object header every heap record's C struct opens with. Mirrors
`test_core_emit.brp`'s `runtime_member_box_heap_record_decl` fixture, but
exercised through the split path instead of the single-file path.
---
pure func header_field_box_heap_record_decl() -> CoreHeapRecordDecl:
	{
		abi_type = None,
		name = "HeaderBox",
		type_params = [],
		fields = [
			{
				name = "header",
				typ = int_type(),
				release_policy = NoReleasePolicy
			},
			{
				name = "label",
				typ = string_type(),
				release_policy = ArcReleasePolicy
			},
		],
		loc = synthetic_core_source_loc()
	}


pure func runtime_reserved_field_split_program() -> CoreProgram:
	{
		decls = [
			HeapRecordDecl(header_field_box_heap_record_decl()),
			FunctionDecl(trivial_int_function("alpha", 910, 1)),
			FunctionDecl(trivial_int_function("beta", 911, 2)),
		],
		foreign_includes = [],
		source_files = []
	}


---
Test 12: the split path reuses the exact per-declaration emission records
the single-file path builds (`value_record_emissions` / `heap_record_
emissions` / `enum_emissions` / `union_emissions` on `CEmissionSections`),
so a field named `header` must be escaped identically on both paths: the
typedef routed to the shared header spells the member `__blorp_field_header`,
the make function's assignment (a type-support definition, balanced across
units like any other function) assigns through the same escaped name, and
the raw collision (an unescaped
`  long header;` member or `__rec->header =` assignment) never appears in
the header or any body.
---
pure func test_split_path_escapes_runtime_reserved_field_names() -> Bool:
	match try_emit_prepared_core_program_c_split_artifact_with_profile(
		run_pre_dce_tail(runtime_reserved_field_split_program()),
		FunctionProfileOff,
		2,
		"blorp_shared.h",
	):
		Ok(result):
			has_escaped_typedef: Bool = result.shared_header.contains(
				"  blorp_Object header;\n  long __blorp_field_header;\n  blorp_String* label;",
			)
			has_escaped_make_assignment: Bool = count_occurrences_across(
				result.bodies,
				"  __rec->__blorp_field_header = __blorp_field_header;",
			) == 1
			no_raw_field_decl: Bool = not result.shared_header.contains("  long header;\n")
			no_raw_assignment: Bool = count_occurrences_across(result.bodies, "__rec->header =") == 0

			has_escaped_typedef and has_escaped_make_assignment and no_raw_field_decl and no_raw_assignment
		Err(_):
			False


pure func indexed_heap_record_decl(index: Int) -> CoreHeapRecordDecl:
	{
		abi_type = None,
		name = "Box" + index.to_string(),
		type_params = [],
		fields = [
			{
				name = "count",
				typ = int_type(),
				release_policy = NoReleasePolicy
			},
			{
				name = "label",
				typ = string_type(),
				release_policy = ArcReleasePolicy
			},
		],
		loc = synthetic_core_source_loc()
	}


pure func many_heap_record_decls(count: Int) -> List[CoreDecl]:
	var decls: List[CoreDecl] = []
	var index: Int = 0

	while index < count:
		decls = decls.append(HeapRecordDecl(indexed_heap_record_decl(index)))
		index += 1

	decls


---
40 distinct heap records (each with a releasable field, so each emits a
destroy function and a make function) plus two small ordinary functions --
almost all of this program's emitted weight is type-support text, not
`function_definitions`.
---
pure func type_support_heavy_program() -> CoreProgram:
	{
		decls = many_heap_record_decls(40).concat([
			FunctionDecl(trivial_int_function("alpha", 950, 1)),
			FunctionDecl(trivial_int_function("beta", 951, 2)),
		]),
		foreign_includes = [],
		source_files = []
	}


---
Test 13: before this step, every heap record's destroy/make functions
landed unconditionally in TU 0 (see `collect_type_support_function_
emissions`'s docstring), so splitting `type_support_heavy_program` across 4
units would have put nearly all of its weight in body 0 regardless of
`unit_count`. Now that this material is LPT-packed alongside ordinary
functions, no body should dominate by more than the same 1.35x-of-mean
bound `test_skewed_program_balances_within_bound` checks for ordinary
functions.
---
pure func test_type_support_heavy_program_balances_across_units() -> Bool:
	match try_emit_prepared_core_program_c_split_artifact_with_profile(
		run_pre_dce_tail(type_support_heavy_program()),
		FunctionProfileOff,
		4,
		"blorp_shared.h",
	):
		Ok(result):
			mean_len: Int = mean_body_length(result.bodies)
			longest_len: Int = max_body_length(result.bodies)

			-- longest <= 1.35 * mean, in integer arithmetic: longest * 100 <= mean * 135.
			result.bodies.length() == 4 and longest_len * 100 <= mean_len * 135
		Err(_):
			False


tests: TestSuite = {
	description = "Split, multi-translation-unit C emission",
	tests = [
		("unit count one matches single-file path", test_unit_count_one_matches_single_file_path),
		("header/body partition at three units", test_header_body_partition_at_three_units),
		(
			"projected erased union constructor ABI matches",
			test_projected_erased_union_constructor_abi_matches,
		),
		(
			"string literal defined once and declared once",
			test_string_literal_defined_once_and_declared_once,
		),
		("global defined once by TU zero", test_global_defined_once_by_tu_zero),
		(
			"canonical empty list has named storage type",
			test_canonical_empty_list_has_named_storage_type,
		),
		("split rendering is deterministic", test_split_rendering_is_deterministic),
		("prototype matches definition signature", test_prototype_matches_definition_signature),
		("entrypoint has prototype and definition", test_entrypoint_has_prototype_and_definition),
		(
			"global initializer is declared once in the header",
			test_global_initializer_is_declared_once_in_the_header,
		),
		(
			"single-path string literal macro is unchanged",
			test_single_path_string_literal_macro_is_unchanged,
		),
		("skewed program balances within bound", test_skewed_program_balances_within_bound),
		("order within bin is by def_id", test_order_within_bin_is_by_def_id),
		(
			"unit count exceeding function count has no empty bodies",
			test_unit_count_exceeding_function_count_has_no_empty_bodies,
		),
		(
			"split path escapes runtime-reserved field names",
			test_split_path_escapes_runtime_reserved_field_names,
		),
		(
			"type-support-heavy program balances across units",
			test_type_support_heavy_program_balances_across_units,
		),
	]
}
