private record UnionFixture {
	scope: PreparedModuleScope,
	left: ModuleId,
	right: ModuleId,
	unrelated: ModuleId,
	left_node: TypeId,
	right_choice: TypeId,
	alias_only: TypeId,
	extra: TypeId,
	first: TypeId,
	second: TypeId
}


private pure func union_fixture() -> Option[UnionFixture]:
	fixture ?= definition_backed_type_fixture([
		{module_path = "pkg/left", type_names = ["Node", "AliasOnly", "First", "Second"]},
		{module_path = "pkg/right", type_names = ["Choice"]},
		{module_path = "pkg/unrelated", type_names = ["Extra"]},
	])
	left ?= module_id_fixture_find(fixture, "pkg/left")
	right ?= module_id_fixture_find(fixture, "pkg/right")
	unrelated ?= module_id_fixture_find(fixture, "pkg/unrelated")
	left_node ?= definition_backed_type_fixture_type_id(fixture, "pkg/left", "Node")
	right_choice ?= definition_backed_type_fixture_type_id(fixture, "pkg/right", "Choice")
	alias_only ?= definition_backed_type_fixture_type_id(fixture, "pkg/left", "AliasOnly")
	extra ?= definition_backed_type_fixture_type_id(fixture, "pkg/unrelated", "Extra")
	first ?= definition_backed_type_fixture_type_id(fixture, "pkg/left", "First")
	second ?= definition_backed_type_fixture_type_id(fixture, "pkg/left", "Second")
	Some({
		scope = fixture,
		left = left,
		right = right,
		unrelated = unrelated,
		left_node = left_node,
		right_choice = right_choice,
		alias_only = alias_only,
		extra = extra,
		first = first,
		second = second,
	})


private pure func variant(
	name: String,
	constructor_id: Int,
	fields: List[SemanticType],
	tag: Int,
) -> AcceptedUnionVariantEntry:
	{
		name = name,
		constructor_id = constructor_id,
		fields = fields,
		tag = tag
	}


private pure func fixture_union(
	id: TypeId,
	module_path: String,
	name: String,
	canonical_visible: Bool,
	variants: List[AcceptedUnionVariantEntry],
	is_enum: Bool,
) -> AcceptedUnionTableRecord:
	{
		id = id,
		canonical_name = canonical_module_type_name(module_path, name),
		canonical_visible = canonical_visible,
		payload = {
			type_params = [],
			variants = variants,
			is_enum = is_enum,
			contains_resource = True,
			may_contain_function = False,
			may_contain_one_shot_stream = True,
			may_contain_resource_source = False
		}
	}


private pure func table_input(
	fixture: UnionFixture,
	include_unrelated: Bool,
) -> AcceptedUnionTableInput:
	left = fixture_union(
		fixture.left_node,
		"pkg/left",
		"Node",
		True,
		[variant("Next", 101, [SemanticNamedType(
						canonical_module_type_name("pkg/left", "Node"),
						[],
					)], 0)],
		False,
	)
	right = fixture_union(
		fixture.right_choice,
		"pkg/right",
		"Choice",
		True,
		[variant("Other", 202, [TYPE_STRING], 0)],
		True,
	)
	-- The owner-local union is intentionally not table index zero.
	unions = [right, left]

	if include_unrelated:
		unrelated = fixture_union(
			fixture.extra,
			"pkg/unrelated",
			"Extra",
			True,
			[variant("ExtraValue", 303, [TYPE_INT], 0)],
			False,
		)
		{
			definition_table = definition_backed_type_fixture_definition_table(fixture.scope),
			unions = unions.append(unrelated)
		}
	else:
		{
			definition_table = definition_backed_type_fixture_definition_table(fixture.scope),
			unions = unions
		}


private pure func type_identity(id: TypeId, canonical_name: String) -> AcceptedTypeIdentity:
	{
		id = id,
		canonical_name = canonical_name,
		type_params = []
	}


private pure func type_identities(
	fixture: UnionFixture,
	include_unrelated: Bool,
) -> Option[AcceptedAliasTable]:
	var identities = [type_identity(
			fixture.left_node,
			canonical_module_type_name("pkg/left", "Node"),
		), type_identity(
			fixture.right_choice,
			canonical_module_type_name("pkg/right", "Choice"),
		), type_identity(
			fixture.alias_only,
			canonical_module_type_name("pkg/left", "AliasOnly"),
		)]

	if include_unrelated:
		identities = identities.append(
			type_identity(
				fixture.extra,
				canonical_module_type_name("pkg/unrelated", "Extra"),
			),
		)

	input: AcceptedAliasTableInput = {
		definition_table = definition_backed_type_fixture_definition_table(fixture.scope),
		type_identities = identities,
		transparent_aliases = [],
		opaque_aliases = []
	}
	accepted_alias_table(input)


private pure func union_bindings(
	fixture: UnionFixture,
) -> List[AcceptedVisibleUnionBinding]:
	[
		{
			source_name = "Node",
			id = fixture.left_node,
			owner_local = True
		},
		{
			source_name = "Remote",
			id = fixture.right_choice,
			owner_local = False
		},
	]


private pure func constructor_bindings(
	fixture: UnionFixture,
) -> List[AcceptedVisibleConstructorBinding]:
	[
		{
			source_name = "Next",
			parent_source_name = "Node",
			parent_id = fixture.left_node,
			constructor_id = 101,
			owner_local = True
		},
		{
			source_name = "Other",
			parent_source_name = "Remote",
			parent_id = fixture.right_choice,
			constructor_id = 202,
			owner_local = False
		},
	]


private pure func category_table_and_compact_view_are_authoritative_result() -> Option[Bool]:
	module_ids ?= union_fixture()
	identities ?= type_identities(module_ids, False)
	table ?= accepted_union_table(
		table_input(module_ids, False),
		identities,
		ENV_EMPTY,
		[],
	).to_option()
	view ?= accepted_union_module_view(
		table,
		module_ids.left,
		union_bindings(module_ids),
		constructor_bindings(module_ids),
	)
	authority = accepted_union_authority(table, view)
	local ?= accepted_union_find(authority, "Node")
	canonical ?= accepted_union_find(
		authority,
		canonical_module_type_name("pkg/left", "Node"),
	)
	local_field ?= local.variants
		.get(0)
		.and_then(func(item): item.fields.get(0))
	canonical_field ?= canonical.variants
		.get(0)
		.and_then(func(item): item.fields.get(0))
	local_constructor ?= accepted_union_find_constructor_for_parent(authority, "Node", "Next")
	remote_constructor ?= accepted_union_find_constructor_for_parent(authority, "Remote", "Other")
	canonical_only = accepted_union_authority_without_visible_names(authority)
	alias_id = module_ids.alias_only

	alias_is_wrong_kind = match accepted_union_exact(table, identities, alias_id).lookup:
		AcceptedUnionExactWrongKind(id):
			type_ids_equal(id, alias_id)
		AcceptedUnionExactFound(_) | AcceptedUnionExactMissing:
			False

	Some(types_equal(
			local_field,
			SemanticNamedType("Node", []),
		) and types_equal(
			canonical_field,
			SemanticNamedType(
				canonical_module_type_name("pkg/left", "Node"),
				[],
			),
		) and local_constructor.constructor_id == 101 and remote_constructor.constructor_id == 202 and accepted_union_find(
			canonical_only,
			"Node",
		).is_none() and accepted_union_find(
			canonical_only,
			canonical_module_type_name("pkg/left", "Node"),
		).is_some() and accepted_union_table_entry_count(
			table,
		) == 2 and accepted_union_entry_count(
			authority,
		) == 2 and accepted_union_contains_resource(
			authority,
			"Node",
		) == Some(
			True,
		) and accepted_union_is_enum(
			authority,
			"Remote",
		) == Some(
			True,
		) and accepted_union_may_contain_function(
			authority,
			"Node",
		) == Some(False) and alias_is_wrong_kind)


private pure func category_table_and_compact_view_are_authoritative() -> Bool:
	category_table_and_compact_view_are_authoritative_result().get_or(False)


private pure func exact_lookup_cost_is_independent_of_unrelated_entries() -> Bool:
	match union_fixture():
		Some(module_ids):
			left_id = module_ids.left_node

			match (type_identities(module_ids, False), type_identities(module_ids, True)):
				(Some(small_identities), Some(large_identities)):
					match (accepted_union_table(
							table_input(module_ids, False),
							small_identities,
							ENV_EMPTY,
							[],
						), accepted_union_table(
							table_input(module_ids, True),
							large_identities,
							ENV_EMPTY,
							[],
						)):
						(Ok(small), Ok(large)):
							small_probe = accepted_union_exact(small, small_identities, left_id)
							large_probe = accepted_union_exact(large, large_identities, left_id)

							(
								small_probe.candidates_visited == 1
								and large_probe.candidates_visited == 1
								and match (small_probe.lookup, large_probe.lookup):
									(AcceptedUnionExactFound(_), AcceptedUnionExactFound(_)):
										True
									_:
										False
							)
						_:
							False
				_:
					False
		None:
			False


private pure func module_view_rejects_misclassified_owner_binding() -> Bool:
	match union_fixture():
		Some(module_ids):
			match type_identities(module_ids, False):
				Some(identities):
					result = accepted_union_table(
						table_input(module_ids, False),
						identities,
						ENV_EMPTY,
						[],
					)

					match result:
						Ok(table):
							accepted_union_module_view(
								table,
								module_ids.left,
								[
									{
										source_name = "Wrong",
									id = module_ids.right_choice,
										owner_local = True
									},
								],
								[],
							).is_none()
						Err(_):
							False
				None:
					False
		None:
			False


private pure func later_local_constructor_declaration_wins_result() -> Option[Bool]:
	module_ids ?= union_fixture()
	first_id = module_ids.first
	second_id = module_ids.second
	identity_input: AcceptedAliasTableInput = {
		definition_table = definition_backed_type_fixture_definition_table(module_ids.scope),
		type_identities = [type_identity(
				first_id,
				canonical_module_type_name("pkg/left", "First"),
			), type_identity(
				second_id,
				canonical_module_type_name("pkg/left", "Second"),
			)],
		transparent_aliases = [],
		opaque_aliases = []
	}
	identities ?= accepted_alias_table(identity_input)
	input: AcceptedUnionTableInput = {
		definition_table = definition_backed_type_fixture_definition_table(module_ids.scope),
		unions = [
			fixture_union(
				first_id,
				"pkg/left",
				"First",
				True,
				[variant("Shared", 401, [], 0)],
				True,
			),
			fixture_union(
				second_id,
				"pkg/left",
				"Second",
				True,
				[variant("Shared", 402, [], 0)],
				True,
			),
		],
	}
	table ?= accepted_union_table(input, identities, ENV_EMPTY, []).to_option()
	view ?= accepted_union_module_view(
		table,
		module_ids.left,
		[
			{
				source_name = "First",
				id = first_id,
				owner_local = True
			},
			{
				source_name = "Second",
				id = second_id,
				owner_local = True
			},
		],
		[],
	)
	constructor ?= accepted_union_find_constructor(
		accepted_union_authority(table, view),
		"Shared",
	)
	module_constructor ?= accepted_union_find_module_constructor(
		accepted_union_authority(table, view),
		"pkg/left",
		"Shared",
	)
	Some(constructor.constructor_id == 402 and module_constructor.constructor_id == 402)


private pure func later_local_constructor_declaration_wins() -> Bool:
	later_local_constructor_declaration_wins_result().get_or(False)


private pure func builtin_union_is_copied_once_into_the_table_result() -> Option[Bool]:
	fixture ?= union_fixture()
	definition_table = definition_backed_type_fixture_definition_table(fixture.scope)
	input: AcceptedUnionTableInput = {
		definition_table = definition_table,
		unions = []
	}
	identity_input: AcceptedAliasTableInput = {
		definition_table = definition_table,
		type_identities = [],
		transparent_aliases = [],
		opaque_aliases = []
	}
	identities ?= accepted_alias_table(identity_input)
	table ?= accepted_union_table(
		input,
		identities,
		env_with_builtins(ENV_EMPTY),
		["Option"],
	).to_option()
	authority = accepted_union_authority(table, accepted_union_empty_module_view())
	entry ?= accepted_union_find(authority, "Option")
	some ?= accepted_union_find_constructor(authority, "Some")
	Some(
		(
			entry.variants.length() == 2
			and some.parent_type == "Option"
			and accepted_union_table_entry_count(table) == 1
		),
	)


private pure func builtin_union_is_copied_once_into_the_table() -> Bool:
	builtin_union_is_copied_once_into_the_table_result().get_or(False)


private pure func matching_graph_and_builtin_union_share_one_payload_result() -> Option[Bool]:
	fixture ?= definition_backed_type_fixture_for_origin(
		[{module_path = "option", type_names = ["Option"]}],
		StdlibModule,
	)
	option_id ?= definition_backed_type_fixture_type_id(fixture, "option", "Option")
	definition_table = definition_backed_type_fixture_definition_table(fixture)
	empty_identity_input: AcceptedAliasTableInput = {
		definition_table = definition_table,
		type_identities = [],
		transparent_aliases = [],
		opaque_aliases = []
	}
	empty_identities ?= accepted_alias_table(empty_identity_input)
	builtin_table ?= accepted_union_table(
		{definition_table = definition_table, unions = []},
		empty_identities,
		env_with_builtins(ENV_EMPTY),
		["Option"],
	).to_option()
	builtin_entry ?= accepted_union_find(
		accepted_union_authority(builtin_table, accepted_union_empty_module_view()),
		"Option",
	)
	graph_identity_input: AcceptedAliasTableInput = {
		definition_table = definition_table,
		type_identities = [type_identity(option_id, "Option")],
		transparent_aliases = [],
		opaque_aliases = []
	}
	graph_identities ?= accepted_alias_table(graph_identity_input)
	shared_table ?= accepted_union_table(
		{
			definition_table = definition_table,
			unions = [
				{
					id = option_id,
					canonical_name = "Option",
					canonical_visible = True,
					payload = builtin_entry
				},
			]
		},
		graph_identities,
		env_with_builtins(ENV_EMPTY),
		["Option"],
	).to_option()
	shared_authority = accepted_union_authority(
		shared_table,
		accepted_union_empty_module_view(),
	)
	some ?= accepted_union_find_constructor(shared_authority, "Some")

	Some(
		accepted_union_table_entry_count(shared_table) == 1
		and some.parent_type == "Option"
		and (
			match accepted_union_exact(
				shared_table,
				graph_identities,
				option_id,
			).lookup:
				AcceptedUnionExactFound(_): True
				_: False
		),
	)


private pure func matching_graph_and_builtin_union_share_one_payload() -> Bool:
	matching_graph_and_builtin_union_share_one_payload_result().get_or(False)


private pure func table_rejects_forged_canonical_name_result() -> Option[Bool]:
	fixture ?= union_fixture()
	identities ?= type_identities(fixture, False)
	input = table_input(fixture, False)
	union_entry ?= input.unions.get(0)
	forged = { union_entry | canonical_name = "Option" }
	Some(match accepted_union_table(
		{ input | unions = input.unions.set(0, forged) },
		identities,
		ENV_EMPTY,
		[],
	):
		Err(_): True
		Ok(_): False
	)


private pure func table_rejects_forged_canonical_name() -> Bool:
	table_rejects_forged_canonical_name_result().get_or(False)


private pure func independent_definition_domains_are_rejected() -> Bool:
	match (union_fixture(), union_fixture()):
		(Some(identity_fixture), Some(union_fixture_value)):
			match type_identities(identity_fixture, False):
				Some(identities):
					match accepted_union_table(
						table_input(union_fixture_value, False),
						identities,
						ENV_EMPTY,
						[],
					):
						Err(errors):
							errors.contains(
								"accepted union and type identity tables have different origins",
							)
						Ok(_):
							False
				None:
					False
		_:
			False


tests: TestSuite = {
	description = "Accepted union authority",
	tests = [
		("table rejects forged canonical name", table_rejects_forged_canonical_name),
		(
			"category table and compact module view are authoritative",
			category_table_and_compact_view_are_authoritative,
		),
		(
			"exact lookup cost is independent of unrelated entries",
			exact_lookup_cost_is_independent_of_unrelated_entries,
		),
		(
			"module view rejects misclassified owner binding",
			module_view_rejects_misclassified_owner_binding,
		),
		(
			"later local constructor declaration wins bare and module lookup",
			later_local_constructor_declaration_wins,
		),
		(
			"builtin union is copied once into the table",
			builtin_union_is_copied_once_into_the_table,
		),
		(
			"matching graph and builtin union share one payload",
			matching_graph_and_builtin_union_share_one_payload,
		),
		(
			"independent definition domains are rejected",
			independent_definition_domains_are_rejected,
		),
	]
}
