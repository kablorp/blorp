import:
	../../../src/compiler/stage_04_modules/loaded_module:
		ModuleIdentity,
		ModuleOrigin(UserModule),
		module_identity_from_resolved,
		resolved_module_identity_from_resolver,
	../../../src/compiler/stage_06_typecheck/graph/type_identity: TypeId, type_id, type_ids_equal
	../../../src/compiler/stage_06_typecheck/type_system/accepted_alias_authority:
		AcceptedAliasTable,
		AcceptedAliasTableInput,
		AcceptedTypeIdentity,
		accepted_alias_table,
	../../../src/compiler/stage_06_typecheck/type_system/accepted_union_authority:
		AcceptedUnionExactLookup(
			AcceptedUnionExactFound,
			AcceptedUnionExactMissing,
			AcceptedUnionExactWrongKind,
		),
		AcceptedUnionTableInput,
		AcceptedUnionTableRecord,
		AcceptedUnionVariantEntry,
		AcceptedVisibleConstructorBinding,
		AcceptedVisibleUnionBinding,
		accepted_union_authority,
		accepted_union_authority_without_visible_names,
		accepted_union_contains_resource,
		accepted_union_empty_module_view,
		accepted_union_entry_count,
		accepted_union_exact,
		accepted_union_find,
		accepted_union_find_constructor,
		accepted_union_find_constructor_for_parent,
		accepted_union_find_module_constructor,
		accepted_union_is_enum,
		accepted_union_may_contain_function,
		accepted_union_module_view,
		accepted_union_table,
		accepted_union_table_entry_count,
	../../../src/compiler/stage_06_typecheck/type_system/builtins: env_with_builtins
	../../../src/compiler/stage_06_typecheck/type_system/env: ENV_EMPTY
	../../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticType(SemanticNamedType),
		TYPE_INT,
		TYPE_STRING,
		canonical_module_type_name,
		types_equal,
	../../../src/lib/source: SourceSpan, source_empty_span, source_file, source_start
	test: TestSuite


private pure func module_identity(path: String) -> ModuleIdentity:
	module_identity_from_resolved(resolved_module_identity_from_resolver(path, UserModule))


private pure func fixture_span(path: String) -> SourceSpan:
	source = source_file(path, path, "")
	source_empty_span(source, source_start(source))


private pure func fixture_type_id(module_path: String, name: String) -> TypeId:
	type_id(module_identity(module_path), name, fixture_span(module_path + ".brp"))


private pure func variant(
	name: String,
	constructor_id: Int,
	fields: List[SemanticType],
	tag: Int,
) -> AcceptedUnionVariantEntry:
	{name = name, constructor_id = constructor_id, fields = fields, tag = tag}


private pure func fixture_union(
	module_path: String,
	name: String,
	canonical_visible: Bool,
	variants: List[AcceptedUnionVariantEntry],
	is_enum: Bool,
) -> AcceptedUnionTableRecord:
	{
		id = fixture_type_id(module_path, name),
		owner_module_path = module_path,
		canonical_name = canonical_module_type_name(module_path, name),
		canonical_visible = canonical_visible,
		payload = {
			type_params = [],
			variants = variants,
			is_enum = is_enum,
			contains_resource = True,
			may_contain_function = False,
			may_contain_one_shot_stream = True,
			may_contain_resource_source = False
		}
	}


private pure func table_input(include_unrelated: Bool) -> AcceptedUnionTableInput:
	left = fixture_union(
		"pkg/left",
		"Node",
		True,
		[
			variant(
				"Next",
				101,
				[SemanticNamedType(canonical_module_type_name("pkg/left", "Node"), [])],
				0,
			),
		],
		False,
	)
	right = fixture_union(
		"pkg/right",
		"Choice",
		True,
		[variant("Other", 202, [TYPE_STRING], 0)],
		True,
	)
	-- The owner-local union is intentionally not table index zero.
	unions = [right, left]

	if include_unrelated:
		unrelated = fixture_union(
			"pkg/unrelated",
			"Extra",
			True,
			[variant("ExtraValue", 303, [TYPE_INT], 0)],
			False,
		)
		{unions = unions.append(unrelated)}
	else:
		{unions = unions}


private pure func type_identity(id: TypeId, canonical_name: String) -> AcceptedTypeIdentity:
	{id = id, canonical_name = canonical_name, type_params = []}


private pure func type_identities(include_unrelated: Bool) -> Option[AcceptedAliasTable]:
	var identities = [
		type_identity(
			fixture_type_id("pkg/left", "Node"),
			canonical_module_type_name("pkg/left", "Node"),
		),
		type_identity(
			fixture_type_id("pkg/right", "Choice"),
			canonical_module_type_name("pkg/right", "Choice"),
		),
		type_identity(
			fixture_type_id("pkg/left", "AliasOnly"),
			canonical_module_type_name("pkg/left", "AliasOnly"),
		),
	]
	if include_unrelated:
		identities = identities.append(type_identity(
			fixture_type_id("pkg/unrelated", "Extra"),
			canonical_module_type_name("pkg/unrelated", "Extra"),
		))
	input: AcceptedAliasTableInput = {
		type_identities = identities,
		transparent_aliases = [],
		opaque_aliases = []
	}
	accepted_alias_table(input)


private pure func union_bindings() -> List[AcceptedVisibleUnionBinding]:
	[
		{source_name = "Node", id = fixture_type_id("pkg/left", "Node"), owner_local = True},
		{source_name = "Remote", id = fixture_type_id("pkg/right", "Choice"), owner_local = False},
	]


private pure func constructor_bindings() -> List[AcceptedVisibleConstructorBinding]:
	[
		{
			source_name = "Next",
			parent_source_name = "Node",
			parent_id = fixture_type_id("pkg/left", "Node"),
			constructor_id = 101,
			owner_local = True
		},
		{
			source_name = "Other",
			parent_source_name = "Remote",
			parent_id = fixture_type_id("pkg/right", "Choice"),
			constructor_id = 202,
			owner_local = False
		},
	]


private pure func category_table_and_compact_view_are_authoritative_result() -> Option[Bool]:
	identities ?= type_identities(False)
	table ?= accepted_union_table(table_input(False), identities, ENV_EMPTY, []).to_option()
	view ?= accepted_union_module_view(
		table,
		module_identity("pkg/left"),
		union_bindings(),
		constructor_bindings(),
	)
	authority = accepted_union_authority(table, view)
	local ?= accepted_union_find(authority, "Node")
	canonical ?= accepted_union_find(
		authority,
		canonical_module_type_name("pkg/left", "Node"),
	)
	local_field ?= local.variants.get(0).and_then(func(item): item.fields.get(0))
	canonical_field ?= canonical.variants.get(0).and_then(func(item): item.fields.get(0))
	local_constructor ?= accepted_union_find_constructor_for_parent(authority, "Node", "Next")
	remote_constructor ?= accepted_union_find_constructor_for_parent(authority, "Remote", "Other")
	canonical_only = accepted_union_authority_without_visible_names(authority)
	alias_id = fixture_type_id("pkg/left", "AliasOnly")

	Some(
		types_equal(local_field, SemanticNamedType("Node", []))
		and types_equal(
			canonical_field,
			SemanticNamedType(canonical_module_type_name("pkg/left", "Node"), []),
		)
		and local_constructor.constructor_id == 101
		and remote_constructor.constructor_id == 202
		and accepted_union_find(canonical_only, "Node").is_none()
		and accepted_union_find(
			canonical_only,
			canonical_module_type_name("pkg/left", "Node"),
		).is_some()
		and accepted_union_table_entry_count(table) == 2
		and accepted_union_entry_count(authority) == 2
		and accepted_union_contains_resource(authority, "Node") == Some(True)
		and accepted_union_is_enum(authority, "Remote") == Some(True)
		and accepted_union_may_contain_function(authority, "Node") == Some(False)
		and match accepted_union_exact(table, identities, alias_id).lookup:
			AcceptedUnionExactWrongKind(id): type_ids_equal(id, alias_id)
			AcceptedUnionExactFound(_) | AcceptedUnionExactMissing: False
	)


private pure func category_table_and_compact_view_are_authoritative() -> Bool:
	category_table_and_compact_view_are_authoritative_result().get_or(False)


private pure func exact_lookup_cost_is_independent_of_unrelated_entries() -> Bool:
	left_id = fixture_type_id("pkg/left", "Node")
	match (type_identities(False), type_identities(True)):
		(Some(small_identities), Some(large_identities)):
			match (
				accepted_union_table(table_input(False), small_identities, ENV_EMPTY, []),
				accepted_union_table(table_input(True), large_identities, ENV_EMPTY, []),
			):
				(Ok(small), Ok(large)):
					small_probe = accepted_union_exact(small, small_identities, left_id)
					large_probe = accepted_union_exact(large, large_identities, left_id)
					(
						small_probe.candidates_visited == 1
						and large_probe.candidates_visited == 1
						and match (small_probe.lookup, large_probe.lookup):
							(AcceptedUnionExactFound(_), AcceptedUnionExactFound(_)): True
							_: False
					)
				_: False
		_: False


private pure func module_view_rejects_misclassified_owner_binding() -> Bool:
	match type_identities(False):
		Some(identities):
			result = accepted_union_table(table_input(False), identities, ENV_EMPTY, [])
			match result:
				Ok(table):
					accepted_union_module_view(
						table,
						module_identity("pkg/left"),
						[
							{
								source_name = "Wrong",
								id = fixture_type_id("pkg/right", "Choice"),
								owner_local = True
							},
						],
						[],
					).is_none()
				Err(_): False
		None: False


private pure func later_local_constructor_declaration_wins_result() -> Option[Bool]:
	first_id = fixture_type_id("pkg/left", "First")
	second_id = fixture_type_id("pkg/left", "Second")
	identity_input: AcceptedAliasTableInput = {
		type_identities = [
			type_identity(first_id, canonical_module_type_name("pkg/left", "First")),
			type_identity(second_id, canonical_module_type_name("pkg/left", "Second")),
		],
		transparent_aliases = [],
		opaque_aliases = []
	}
	identities ?= accepted_alias_table(identity_input)
	input: AcceptedUnionTableInput = {
		unions = [
			fixture_union("pkg/left", "First", True, [variant("Shared", 401, [], 0)], True),
			fixture_union("pkg/left", "Second", True, [variant("Shared", 402, [], 0)], True),
		]
	}
	table ?= accepted_union_table(input, identities, ENV_EMPTY, []).to_option()
	view ?= accepted_union_module_view(
		table,
		module_identity("pkg/left"),
		[
			{source_name = "First", id = first_id, owner_local = True},
			{source_name = "Second", id = second_id, owner_local = True},
		],
		[],
	)
	constructor ?= accepted_union_find_constructor(
		accepted_union_authority(table, view),
		"Shared",
	)
	module_constructor ?= accepted_union_find_module_constructor(
		accepted_union_authority(table, view),
		"pkg/left",
		"Shared",
	)
	Some(constructor.constructor_id == 402 and module_constructor.constructor_id == 402)


private pure func later_local_constructor_declaration_wins() -> Bool:
	later_local_constructor_declaration_wins_result().get_or(False)


private pure func builtin_union_is_copied_once_into_the_table_result() -> Option[Bool]:
	input: AcceptedUnionTableInput = {unions = []}
	identity_input: AcceptedAliasTableInput = {
		type_identities = [],
		transparent_aliases = [],
		opaque_aliases = []
	}
	identities ?= accepted_alias_table(identity_input)
	table ?= accepted_union_table(
		input,
		identities,
		env_with_builtins(ENV_EMPTY),
		["Option"],
	).to_option()
	authority = accepted_union_authority(
		table,
		accepted_union_empty_module_view(module_identity("app/main")),
	)
	entry ?= accepted_union_find(authority, "Option")
	some ?= accepted_union_find_constructor(authority, "Some")
	Some(
		entry.variants.length() == 2
		and some.parent_type == "Option"
		and accepted_union_table_entry_count(table) == 1
	)


private pure func builtin_union_is_copied_once_into_the_table() -> Bool:
	builtin_union_is_copied_once_into_the_table_result().get_or(False)


tests: TestSuite = {
	description = "Accepted union authority",
	tests = [
		(
			"category table and compact module view are authoritative",
			category_table_and_compact_view_are_authoritative,
		),
		(
			"exact lookup cost is independent of unrelated entries",
			exact_lookup_cost_is_independent_of_unrelated_entries,
		),
		(
			"module view rejects misclassified owner binding",
			module_view_rejects_misclassified_owner_binding,
		),
		(
			"later local constructor declaration wins bare and module lookup",
			later_local_constructor_declaration_wins,
		),
		(
			"builtin union is copied once into the table",
			builtin_union_is_copied_once_into_the_table,
		),
	]
}
