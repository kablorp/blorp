pure func test_direct_graph_preserves_unknown_module_target_diagnostic() -> Bool:
	app = module("/workspace/main.brp", "main", "VALUE = 1\n", UserModule)
	missing = identity("missing", UserModule)

	match frontend_graph([app], [app.identity], []):
		Err(_):
			False
		Ok(graph):
			match typecheck_request_for_frontend_graph(
				graph,
				app.identity,
				[missing],
				False,
				False,
			):
				Err(_):
					False
				Ok(request):
					expected = typecheck_graph(request)

					match typecheck_frontend_graph_direct(
						graph,
						app.identity,
						[missing],
						False,
						False,
					):
						Err(_):
							False
						Ok(direct):
							(
								direct.target.errors == [
									"unknown typecheck module target 'missing'",
								]
								and typechecked_graphs_match(direct, expected)
							)


tests: TestSuite = {
	description = "Compiler frontend graph typecheck request",
	tests = [
		(
			"use exact graph identities and requested import",
			test_request_uses_exact_graph_identities_and_requested_import,
		),
		("reject root outside graph", test_request_rejects_a_root_outside_the_graph),
		(
			"preserve dependencies before other roots",
			test_cli_request_preserves_dependencies_before_other_roots,
		),
		(
			"retain surface through typechecking",
			test_retained_surface_reaches_the_typechecked_module,
		),
		(
			"direct graph typecheck matches descriptive replay",
			test_direct_graph_typecheck_matches_descriptive_replay,
		),
		(
			"direct graph preserves source order with reordered edges",
			test_direct_graph_preserves_source_order_with_reordered_edges,
		),
		(
			"direct graph preserves last resolution for repeated import path",
			test_direct_graph_preserves_last_resolution_for_repeated_import_path,
		),
		(
			"direct graph ignores unresolved duplicate after resolved import",
			test_direct_graph_ignores_unresolved_duplicate_after_resolved_import,
		),
		(
			"direct graph preserves unknown module target diagnostic",
			test_direct_graph_preserves_unknown_module_target_diagnostic,
		),
	]
}
