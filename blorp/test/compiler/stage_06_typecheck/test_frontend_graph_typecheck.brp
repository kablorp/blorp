import:
	../../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../../src/compiler/stage_03_parse/source_ast_finalize:
		finalized_typecheck_program,
		finalized_typecheck_program_ast,
	../../../src/compiler/stage_04_modules/frontend_graph:
		FrontendImportEdge,
		FrontendImportResolution(FrontendResolvedImport, FrontendUnresolvedImport),
		FrontendModule,
		frontend_graph,
	../../../src/compiler/stage_04_modules/loaded_module:
		ModuleOrigin(SourcePackageModule, UserModule),
		ResolvedModuleIdentity,
		module_identities_equal,
		resolved_module_identity_from_resolver,
	../../../src/compiler/stage_04_modules/module_surface:
		ModuleSurface,
		ModuleSurfaceSymbolSource(
			DeclSurfaceSource,
			ImplMethodSurfaceSource,
			PrivateDeclSurfaceSource,
			PrivateImplMethodSurfaceSource,
			PrivateTraitMethodSurfaceSource,
			TraitMethodSurfaceSource,
		),
		module_surface_for_program,
	../../../src/compiler/stage_06_typecheck/bridge:
		TypecheckedGraph,
		TypecheckedModule,
		typecheck_graph,
	../../../src/compiler/stage_06_typecheck/diagnostic: TypecheckDiagnostic
	../../../src/compiler/stage_06_typecheck/frontend_graph_typecheck:
		typecheck_frontend_graph_direct,
		typecheck_request_for_frontend_graph,
		typecheck_request_for_frontend_module,
	../../../src/compiler/stage_06_typecheck/modules/import_binding:
		ImportBinding(QualifiedModuleBinding, SelectiveDefinitionBinding),
	../../../src/compiler/stage_06_typecheck/typed_ast_json: typed_program_to_json
	../../../src/lib/source: SourceSpan, source_file
	test: TestSuite


private pure func identity(module_name: String, origin: ModuleOrigin) -> ResolvedModuleIdentity:
	resolved_module_identity_from_resolver(module_name, origin)


private pure func module(
	path: String,
	module_name: String,
	text: String,
	origin: ModuleOrigin,
) -> FrontendModule:
	program = finalized_typecheck_program(
		parse_compiler_source(source_file(path, module_name, text)),
	)
	{
		identity = identity(module_name, origin),
		program = program,
		surface = module_surface_for_program(finalized_typecheck_program_ast(program))
	}


private pure func source_spans_match(left: SourceSpan, right: SourceSpan) -> Bool:
	(
		left.path == right.path
		and left.module_name == right.module_name
		and left.start_offset == right.start_offset
		and left.start_line == right.start_line
		and left.start_column == right.start_column
		and left.end_offset == right.end_offset
		and left.end_line == right.end_line
		and left.end_column == right.end_column
	)


private pure func surface_symbol_sources_match(
	left: List[ModuleSurfaceSymbolSource],
	right: List[ModuleSurfaceSymbolSource],
) -> Bool:
	(
		left.length() == right.length()
		and left
			.zip(right)
			.all(func(pair):
				match pair:
					(DeclSurfaceSource(left_index), DeclSurfaceSource(right_index)):
						left_index == right_index
					(TraitMethodSurfaceSource(left_decl, left_method), TraitMethodSurfaceSource(right_decl, right_method)):
						left_decl == right_decl and left_method == right_method
					(ImplMethodSurfaceSource(left_decl, left_method), ImplMethodSurfaceSource(right_decl, right_method)):
						left_decl == right_decl and left_method == right_method
					(PrivateDeclSurfaceSource(left_index), PrivateDeclSurfaceSource(right_index)):
						left_index == right_index
					(PrivateTraitMethodSurfaceSource(left_decl, left_method), PrivateTraitMethodSurfaceSource(right_decl, right_method)):
						left_decl == right_decl and left_method == right_method
					(PrivateImplMethodSurfaceSource(left_decl, left_method), PrivateImplMethodSurfaceSource(right_decl, right_method)):
						left_decl == right_decl and left_method == right_method
					_:
						False
			)
	)


private pure func surfaces_match(left: ModuleSurface, right: ModuleSurface) -> Bool:
	(
		left.module_name == right.module_name
		and left.import_paths == right.import_paths
		and left.exports.map(
			func(symbol): symbol.name,
		) == right.exports.map(func(symbol): symbol.name)
		and left.exports.map(
			func(symbol): symbol.kind,
		) == right.exports.map(func(symbol): symbol.kind)
		and surface_symbol_sources_match(
			left.exports.map(func(symbol): symbol.source),
			right.exports.map(func(symbol): symbol.source),
		)
		and left.private_names.map(
			func(symbol): symbol.name,
		) == right.private_names.map(func(symbol): symbol.name)
		and left.private_names.map(
			func(symbol): symbol.kind,
		) == right.private_names.map(func(symbol): symbol.kind)
		and surface_symbol_sources_match(
			left.private_names.map(func(symbol): symbol.source),
			right.private_names.map(func(symbol): symbol.source),
		)
		and left.private_traits == right.private_traits
	)


private pure func diagnostic_spans_match(
	left: Option[SourceSpan],
	right: Option[SourceSpan],
) -> Bool:
	match (left, right):
		(Some(left_span), Some(right_span)):
			source_spans_match(left_span, right_span)
		(None, None):
			True
		_:
			False


private pure func diagnostics_match(
	left: List[TypecheckDiagnostic],
	right: List[TypecheckDiagnostic],
) -> Bool:
	(
		left.length() == right.length()
		and left
			.zip(right)
			.all(func(pair):
				(
					pair[0].message == pair[1].message
					and diagnostic_spans_match(pair[0].span, pair[1].span)
				)
			)
	)


private pure func typechecked_modules_match(
	left: TypecheckedModule,
	right: TypecheckedModule,
) -> Bool:
	(
		left.path == right.path
		and left.module_name == right.module_name
		and left.module_path == right.module_path
		and module_identities_equal(left.module_identity, right.module_identity)
		and surfaces_match(left.module_surface, right.module_surface)
		and typed_program_to_json(
			left.semantic_program,
		).to_string() == typed_program_to_json(right.semantic_program).to_string()
		and typed_program_to_json(
			left.typed_program,
		).to_string() == typed_program_to_json(right.typed_program).to_string()
		and left.errors == right.errors
		and diagnostics_match(left.diagnostics, right.diagnostics)
		and import_bindings_match(left.import_bindings, right.import_bindings)
		and left.ctfe_evaluated == right.ctfe_evaluated
	)


private pure func typechecked_graphs_match(left: TypecheckedGraph, right: TypecheckedGraph) -> Bool:
	(
		typechecked_modules_match(left.target, right.target)
		and left.modules.length() == right.modules.length()
		and left.modules
			.zip(right.modules)
			.all(func(pair): typechecked_modules_match(pair[0], pair[1]))
		and left.next_def_id == right.next_def_id
		and left.analysis_context == right.analysis_context
	)


private pure func import_bindings_match(
	left: List[ImportBinding],
	right: List[ImportBinding],
) -> Bool:
	(
		left.length() == right.length()
		and left
			.zip(right)
			.all(func(pair):
				match pair:
					(QualifiedModuleBinding(left_name, left_path), QualifiedModuleBinding(right_name, right_path)):
						left_name == right_name and left_path == right_path
					(SelectiveDefinitionBinding(left_name, left_path, left_source), SelectiveDefinitionBinding(right_name, right_path, right_source)):
						(
							left_name == right_name
							and left_path == right_path
							and left_source == right_source
						)
					_:
						False
			)
	)


pure func test_request_uses_exact_graph_identities_and_requested_import() -> Bool:
	app = module(
		"/workspace/main.brp",
		"main",
		"import:\n\tstats\n\tmissing\n\nVALUE = 1\nprivate HIDDEN = 2\nprivate trait Internal:\n\tfunc apply(value: Int) -> Int\n",
		UserModule,
	)
	dependency = module(
		"/packages/math/stats.brp",
		"math/stats",
		"VALUE = 2\n",
		SourcePackageModule("math"),
	)
	edges: List[FrontendImportEdge] = [
		{
			importer = app.identity,
			requested_path = "stats",
			resolution = FrontendResolvedImport(dependency.identity)
		},
		{
			importer = app.identity,
			requested_path = "missing",
			resolution = FrontendUnresolvedImport
		},
	]

	match (
		frontend_graph(
			[app, dependency],
			[app.identity],
			edges,
		)
	):
		Err(_):
			False
		Ok(graph):
			match typecheck_request_for_frontend_graph(
				graph,
				app.identity,
				[dependency.identity],
				False,
				False,
			):
				Err(_):
					False
				Ok(request):
					surface_ok: Bool = match request.target.module_surface:
						Some(surface):
							(
								surface.module_name == "main"
								and surface.import_paths == ["math/stats", "missing"]
								and surface.exports.map(func(symbol): symbol.name) == ["VALUE"]
								and surface.exports.map(
									func(
										symbol,
									): symbol.source,
								) == app.surface.exports.map(func(symbol): symbol.source)
								and surface.private_names.map(
									func(symbol): symbol.name,
								) == ["HIDDEN", "Internal", "apply"]
								and surface.private_names.map(
									func(
										symbol,
									): symbol.source,
								) == app.surface.private_names.map(func(symbol): symbol.source)
								and surface.private_traits == ["Internal"]
							)
						None:
							False

					module_ok: Bool = match request.modules:
						[found]:
							origin_ok: Bool = match found.origin:
								SourcePackageModule(package_alias):
									package_alias == "math"
								_:
									False

							(
								found.path == "/packages/math/stats.brp"
								and found.module_name == "math/stats"
								and found.module_path == "math/stats"
								and origin_ok
							)
						_:
							False

					resolved_ok: Bool = match request.resolved_imports:
						[found]:
							(
								found.from_path == "/workspace/main.brp"
								and found.from_module == "main"
								and found.import_path == "stats"
								and found.resolved_module == "math/stats"
							)
						_:
							False

					(
						request.target.module_path == "main"
						and surface_ok
						and request.module_targets == ["math/stats"]
						and module_ok
						and resolved_ok
					)


pure func test_request_rejects_a_root_outside_the_graph() -> Bool:
	app = module("/workspace/main.brp", "main", "VALUE = 1\n", UserModule)
	missing = identity("missing", UserModule)

	match frontend_graph([app], [app.identity], []):
		Err(_):
			False
		Ok(graph):
			typecheck_request_for_frontend_graph(graph, missing, [], False, False).is_err()


pure func test_cli_request_preserves_dependencies_before_other_roots() -> Bool:
	first = module("/workspace/first.brp", "first", "VALUE = 1\n", UserModule)
	second = module("/workspace/second.brp", "second", "VALUE = 2\n", UserModule)
	dependency = module("/workspace/dep.brp", "dep", "VALUE = 3\n", UserModule)

	match (
		frontend_graph(
			[first, second, dependency],
			[first.identity, second.identity],
			[],
		)
	):
		Err(_):
			False
		Ok(graph):
			cli_request = typecheck_request_for_frontend_module(graph, first, [], False, False)

			match typecheck_request_for_frontend_graph(graph, first.identity, [], False, False):
				Err(_):
					False
				Ok(direct_request):
					(
						cli_request.modules.map(func(found): found.module_name) == ["dep", "second"]
						and direct_request.modules.map(
							func(found): found.module_name,
						) == ["second", "dep"]
					)


pure func test_retained_surface_reaches_the_typechecked_module() -> Bool:
	app = module(
		"/workspace/main.brp",
		"main",
		"import:\n\tstats\n\nfunc public_func() -> Int:\n\t1\n\nprivate func hidden_func() -> Int:\n\t2\n\nVALUE = 1\nprivate HIDDEN = 2\n\nunion Maybe:\n\tSome(Int)\n\tNone\n\nprivate union HiddenUnion:\n\tHiddenCase\n\nrecord Box {value: Int}\nprivate record HiddenRecord {value: Int}\n\ntype alias UserId = Int\nprivate type alias HiddenId = Int\n\ntrait Renderable:\n\tpure func render(value: Self) -> String\n\nimplements Renderable for Box:\n\tpure func render(value: Box) -> String:\n\t\t\"box\"\n\nprivate trait Internal:\n\tpure func internal(value: Self) -> String\n\nprivate implements Internal for Box:\n\tpure func internal(value: Box) -> String:\n\t\t\"internal\"\n",
		UserModule,
	)
	dependency = module(
		"/packages/math/stats.brp",
		"math/stats",
		"VALUE = 2\n",
		SourcePackageModule("math"),
	)
	edge: FrontendImportEdge = {
		importer = app.identity,
		requested_path = "stats",
		resolution = FrontendResolvedImport(dependency.identity)
	}

	match (
		frontend_graph(
			[app, dependency],
			[app.identity],
			[edge],
		)
	):
		Err(_):
			False
		Ok(graph):
			request = typecheck_request_for_frontend_module(
				graph,
				app,
				[dependency.identity],
				False,
				False,
			)
			typechecked = typecheck_graph(request)

			match request.target.module_surface:
				Some(expected):
					(
						typechecked.target.errors.length() == 0
						and typechecked.target.module_surface.import_paths == ["math/stats"]
						and expected.exports.length() == 8
						and expected.private_names.length() == 8
						and expected.private_traits == ["Internal"]
						and surfaces_match(typechecked.target.module_surface, expected)
					)
				None:
					False


pure func test_direct_graph_typecheck_matches_descriptive_replay() -> Bool:
	app = module(
		"/workspace/main.brp",
		"main",
		"import:\n\tdep: VALUE, add\n\nfunc main(args: List[String]) -> Int:\n\tadd(VALUE, 1)\n",
		UserModule,
	)
	dependency = module(
		"/packages/pkg/dep.brp",
		"pkg/dep",
		"VALUE = 2\n\npure func add(left: Int, right: Int) -> Int:\n\tleft + right\n",
		SourcePackageModule("pkg"),
	)
	edge: FrontendImportEdge = {
		importer = app.identity,
		requested_path = "dep",
		resolution = FrontendResolvedImport(dependency.identity)
	}

	match (
		frontend_graph(
			[app, dependency],
			[app.identity],
			[edge],
		)
	):
		Err(_):
			False
		Ok(graph):
			match typecheck_request_for_frontend_graph(
				graph,
				app.identity,
				[dependency.identity],
				False,
				False,
			):
				Err(_):
					False
				Ok(request):
					match typecheck_frontend_graph_direct(
						graph,
						app.identity,
						[dependency.identity],
						False,
						False,
					):
						Err(_):
							False
						Ok(direct):
							typechecked_graphs_match(direct, typecheck_graph(request))


pure func test_direct_graph_preserves_source_order_with_reordered_edges() -> Bool:
	app = module(
		"/workspace/main.brp",
		"main",
		"import:\n\tfirst\n\tfirst\n\tsecond\n\nfunc main(args: List[String]) -> Int:\n\t0\n",
		UserModule,
	)
	first = module(
		"/packages/pkg/first.brp",
		"pkg/first",
		"FIRST = 1\n",
		SourcePackageModule("pkg"),
	)
	second = module(
		"/packages/pkg/second.brp",
		"pkg/second",
		"SECOND = 2\n",
		SourcePackageModule("pkg"),
	)
	edges: List[FrontendImportEdge] = [
		{
			importer = app.identity,
			requested_path = "second",
			resolution = FrontendResolvedImport(second.identity)
		},
		{
			importer = app.identity,
			requested_path = "first",
			resolution = FrontendResolvedImport(first.identity)
		},
		{
			importer = app.identity,
			requested_path = "first",
			resolution = FrontendResolvedImport(first.identity)
		},
	]

	match (
		frontend_graph(
			[app, first, second],
			[app.identity],
			edges,
		)
	):
		Err(_):
			False
		Ok(graph):
			match (
				typecheck_request_for_frontend_graph(
					graph,
					app.identity,
					[first.identity, second.identity],
					False,
					False,
				)
			):
				Err(_):
					False
				Ok(request):
					match (
						typecheck_frontend_graph_direct(
							graph,
							app.identity,
							[first.identity, second.identity],
							False,
							False,
						)
					):
						Err(_):
							False
						Ok(direct):
							(
								direct.target.module_surface.import_paths == [
									"pkg/first",
									"pkg/first",
									"pkg/second",
								]
								and typechecked_graphs_match(direct, typecheck_graph(request))
							)


pure func test_direct_graph_preserves_last_resolution_for_repeated_import_path() -> Bool:
	app = module(
		"/workspace/main.brp",
		"main",
		"import:\n\tshared\n\tshared\n\nfunc main(args: List[String]) -> Int:\n\t0\n",
		UserModule,
	)
	first = module(
		"/packages/pkg/first.brp",
		"pkg/first",
		"FIRST = 1\n",
		SourcePackageModule("pkg"),
	)
	second = module(
		"/packages/pkg/second.brp",
		"pkg/second",
		"SECOND = 2\n",
		SourcePackageModule("pkg"),
	)
	edges: List[FrontendImportEdge] = [
		{
			importer = app.identity,
			requested_path = "shared",
			resolution = FrontendResolvedImport(first.identity)
		},
		{
			importer = app.identity,
			requested_path = "shared",
			resolution = FrontendResolvedImport(second.identity)
		},
	]

	match (
		frontend_graph(
			[app, first, second],
			[app.identity],
			edges,
		)
	):
		Err(_):
			False
		Ok(graph):
			match (
				typecheck_request_for_frontend_graph(
					graph,
					app.identity,
					[first.identity, second.identity],
					False,
					False,
				)
			):
				Err(_):
					False
				Ok(request):
					match (
						typecheck_frontend_graph_direct(
							graph,
							app.identity,
							[first.identity, second.identity],
							False,
							False,
						)
					):
						Err(_):
							False
						Ok(direct):
							(
								direct.target.module_surface.import_paths == [
									"pkg/second",
									"pkg/second",
								]
								and typechecked_graphs_match(direct, typecheck_graph(request))
							)


