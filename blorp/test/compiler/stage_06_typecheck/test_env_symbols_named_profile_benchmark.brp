import:
	../../../benchmark/compiler/compiler_env_symbols_named_profile_fixture:
		CompilerEnvSymbolsNamedProfileConfig,
		compiler_env_symbols_named_profile,
		compiler_env_symbols_named_profile_request,
		compiler_env_symbols_named_profile_with_request,
	memory: get_mem_stats, reset_mem_stats
	test: TestSuite


private MAX_PROFILE_WINDOW_ALLOCATIONS: Int = 12


private pure func profile_config() -> CompilerEnvSymbolsNamedProfileConfig:
	{
		iterations = 2,
		scope_count = 5,
		matches_per_scope = 2,
		overloads_per_scope = 1,
		empty_scope_stride = 3,
		noise_per_scope = 1
	}


private func test_env_symbols_named_profile_records_width_and_identity() -> Bool:
	result = compiler_env_symbols_named_profile(profile_config())

	(
		result.workload_valid
		and result.scope_visits == 20
		and result.matches_per_query == 12
		and result.matching_symbols_returned == 24
		and result.absent_symbols_returned == 0
		and result.prefix_elements_recopied == 48
		and result.checksum == result.expected_checksum
		and result.first_identity == 1004000
		and result.last_identity == 1
	)


private func test_env_symbols_named_profile_avoids_scope_prefix_allocations() -> Bool:
	config = profile_config()
	request = compiler_env_symbols_named_profile_request(config)
	reset_mem_stats()
	result = compiler_env_symbols_named_profile_with_request(config, request)
	stats = get_mem_stats()
	allocations_ok: Bool = stats.total_allocations <= MAX_PROFILE_WINDOW_ALLOCATIONS

	if not allocations_ok:
		print("env_symbols_named profile allocations: ${stats.total_allocations}")

	result.workload_valid and allocations_ok


tests: TestSuite = {
	description = "Compiler env_symbols_named profile benchmark",
	tests = [
		(
			"records width and identity",
			test_env_symbols_named_profile_records_width_and_identity,
		),
		(
			"avoids scope prefix allocations",
			test_env_symbols_named_profile_avoids_scope_prefix_allocations,
		),
	]
}
