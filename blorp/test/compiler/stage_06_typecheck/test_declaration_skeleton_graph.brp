						TestRecordTypeSource,
						TestUnionTypeSource,
						TestConstructorSource,
						TestConstructorSource,
						TestBuiltinTypeSource,
						TestAliasTypeSource,
						TestFunctionSource,
						TestForeignFunctionSource,
						TestGlobalSource,
						TestTraitSource,
						TestTraitMethodSource,
						TestTraitMethodSource,
						TestImplementationSource,
						TestDefaultImplementationMethodSource,
						TestImplementationMethodSource,
						TestRecordTypeSource,
					]


func test_constructor_source_owns_exact_parent_type_identity() -> Bool:
	match bound_graph():
		None:
			False
		Some(bound):
			match declaration_skeleton_graph_build(bound):
				Err(_):
					False
				Ok(graph):
					module_scope = bound_module_scope(bound_module_graph_target(bound))
					signal = declaration_skeleton_graph_find_type(graph, module_scope, "Signal")
					busy = skeleton_named(declaration_skeleton_graph_skeletons(graph), "Busy")

					match (signal, busy):
						(Some(signal_type), Some(busy_skeleton)):
							match declaration_skeleton_source(busy_skeleton):
								ConstructorDeclarationSourceValue(parent_type_id, _):
									type_ids_equal(parent_type_id, signal_type.id)
								_:
									False
						_:
							False


func test_skeleton_graph_rejects_duplicate_type_namespace() -> Bool:
	errors = skeleton_graph_errors("record Item {value: Int}\n\nunion Item:\n\tReady")
	messages = errors.map(declaration_skeleton_graph_error_message)

	match errors:
		[DuplicateTypeDeclaration(_, name, _)]:
			(
				name == "Item"
				and messages == ["duplicate type declaration 'Item' in module 'app/main'"]
			)
		_:
			False


func test_skeleton_graph_rejects_duplicate_trait_namespace() -> Bool:
	errors = skeleton_graph_errors(
		"trait Measure:\n\tpure func measure(value: Self) -> Int\n\ntrait Measure:\n\tpure func other(value: Self) -> Int",
	)

	match errors:
		[DuplicateTraitDeclaration(_, name, _)]:
			name == "Measure"
		_:
			False


func test_skeleton_graph_rejects_duplicate_constructor_within_parent() -> Bool:
	errors = skeleton_graph_errors("union Signal:\n\tReady\n\tReady")

	match errors:
		[DuplicateConstructorDeclaration(_, parent, name, span)]:
			(
				parent == "Signal"
				and name == "Ready"
				and span.path == "main.brp"
				and span.module_name == "app/main"
				and span.start_offset == 22
				and span.start_line == 3
				and span.start_column == 5
				and span.end_offset == 27
				and span.end_line == 3
				and span.end_column == 10
			)
		_:
			False


func test_skeleton_graph_preserves_duplicate_diagnostic_order() -> Bool:
	errors = skeleton_graph_errors(
		"record Item {value: Int}\n\nunion Item:\n\tReady\n\ntrait Measure:\n\tpure func measure(value: Self) -> Int\n\ntrait Measure:\n\tpure func other(value: Self) -> Int\n\nunion Signal:\n\tReady\n\tReady",
	)

	match errors:
		[DuplicateTypeDeclaration(_, type_name, _), DuplicateTraitDeclaration(_, trait_name, _), DuplicateConstructorDeclaration(_, parent, constructor_name, _)]:
			(
				type_name == "Item"
				and trait_name == "Measure"
				and parent == "Signal"
				and constructor_name == "Ready"
			)
		_:
			False


func test_skeleton_graph_allows_same_constructor_name_across_parents() -> Bool:
	match bound_graph_from_source("union First:\n\tReady\n\nunion Second:\n\tReady"):
		None:
			False
		Some(bound):
			match declaration_skeleton_graph_build(bound):
				Err(_):
					False
				Ok(graph):
					declaration_skeleton_graph_skeletons(graph)
						.filter(func(skeleton):
							declaration_skeleton_name(skeleton) == "Ready"
						)
						.length() == 2


private pure func exact_constructor_lookup_matches_skeleton(
	graph: DeclarationSkeletonGraph,
	parent_type_id: TypeId,
	name: String,
	expected_visibility: DeclarationVisibility,
) -> Bool:
	var matches: Bool = False

	for skeleton in declaration_skeleton_graph_skeletons(graph):
		match skeleton:
			ConstructorDeclarationSkeleton(id, visibility, parent, source):
				if type_ids_equal(parent, parent_type_id) and source.name.text == name:
					matches = match declaration_skeleton_graph_find_constructor(
						graph,
						parent_type_id,
						name,
						source.span,
					):
						Some(found):
							(
								constructor_id_definition_id(
									found.id,
								) == constructor_id_definition_id(id)
								and type_ids_equal(found.parent_type_id, parent)
								and found.visibility == visibility
								and found.visibility == expected_visibility
								and found.source.name.text == source.name.text
								and source_spans_equal(found.source.span, source.span)
							)
						None:
							False

					break
			_:
				void

	matches


private pure func constructor_id_for_parent(
	graph: DeclarationSkeletonGraph,
	parent_type_id: TypeId,
	name: String,
) -> Option[ConstructorId]:
	var found: Option[ConstructorId] = None

	for skeleton in declaration_skeleton_graph_skeletons(graph):
		match skeleton:
			ConstructorDeclarationSkeleton(id, _, parent, source):
				if type_ids_equal(parent, parent_type_id) and source.name.text == name:
					found = Some(id)
					break
			_:
				void

	found


func test_constructor_lookup_is_exact_across_modules_parents_and_spans() -> Bool:
	target = fixture_module_load_candidate(
		"main.brp",
		"app/main",
		"union PublicSignal:\n\tReady\n\tBusy(Int)\n\nprivate union HiddenSignal:\n\tHidden",
	)
	dependency = fixture_module_load_candidate(
		"dependency.brp",
		"app/dependency",
		"union DependencySignal:\n\tReady",
	)

	match indexed_graph_build(target, [dependency]):
		Err(_):
			False
		Ok(indexed):
			match bound_module_graph_build(indexed, ["app/dependency"], accept_empty_view):
				Err(_):
					False
				Ok(bound):
					match declaration_skeleton_graph_build(bound):
						Err(_):
							False
						Ok(graph):
							target_scope = bound_module_scope(bound_module_graph_target(bound))
							dependency_module = bound_module_graph_modules(bound).get(0)
							public_signal = declaration_skeleton_graph_find_type(
								graph,
								target_scope,
								"PublicSignal",
							)
							hidden_signal = declaration_skeleton_graph_find_type(
								graph,
								target_scope,
								"HiddenSignal",
							)

							match (dependency_module, public_signal, hidden_signal):
								(Some(dependency_bound), Some(public_type), Some(hidden_type)):
									dependency_signal = declaration_skeleton_graph_find_type(
										graph,
										bound_module_scope(dependency_bound),
										"DependencySignal",
									)
									var exact_and_missing_ok: Bool = (
										exact_constructor_lookup_matches_skeleton(
											graph,
											public_type.id,
											"Busy",
											PublicDeclaration,
										)
										and exact_constructor_lookup_matches_skeleton(
											graph,
											hidden_type.id,
											"Hidden",
											PrivateDeclaration,
										)
										and declaration_skeleton_graph_find_constructor(
											graph,
											public_type.id,
											"Missing",
										type_declaration_source_span(public_type.source),
										).is_none()
									)

									match dependency_signal:
										Some(dependency_type):
											target_ready_id = constructor_id_for_parent(
												graph,
												public_type.id,
												"Ready",
											)
											dependency_ready_id = constructor_id_for_parent(
												graph,
												dependency_type.id,
												"Ready",
											)

											ready_ids_distinct = match (
												target_ready_id,
												dependency_ready_id,
											):
												(Some(target_id), Some(dependency_id)):
													constructor_id_definition_id(
														target_id,
													) != constructor_id_definition_id(dependency_id)
												_:
													False

											var same_name_ok: Bool = (
												exact_constructor_lookup_matches_skeleton(
													graph,
													public_type.id,
													"Ready",
													PublicDeclaration,
												)
												and exact_constructor_lookup_matches_skeleton(
													graph,
													dependency_type.id,
													"Ready",
													PublicDeclaration,
												)
												and ready_ids_distinct
											)

											var wrong_identity_ok: Bool = True

											for skeleton in declaration_skeleton_graph_skeletons(
												graph,
											):
												match skeleton:
													ConstructorDeclarationSkeleton(_, _, parent, source):
														if (
															type_ids_equal(parent, public_type.id)
															and source.name.text == "Ready"
														):
															wrong_span = { source.span |
																end_offset = source.span.end_offset + 1
															}
															wrong_identity_ok = (
																declaration_skeleton_graph_constructor_lookup_candidate_count(
																	graph,
																	public_type.id,
																	"Ready",
																	source.span,
																) == 2
																and declaration_skeleton_graph_find_constructor(
																	graph,
																	dependency_type.id,
																	"Ready",
																	source.span,
																).is_none()
																and declaration_skeleton_graph_find_constructor(
																	graph,
																	public_type.id,
																	"Ready",
																	wrong_span,
																).is_none()
															)
													_:
														void

											(
												exact_and_missing_ok
												and same_name_ok
												and wrong_identity_ok
											)
										None:
											False
								_:
									False


func test_skeleton_graph_places_target_before_dependencies() -> Bool:
	target = fixture_module_load_candidate("main.brp", "app/main", "record Target {value: Int}")
	dependency = fixture_module_load_candidate(
		"dependency.brp",
		"app/dependency",
		"record Dependency {value: Int}",
	)

	match indexed_graph_build(target, [dependency]):
		Err(_):
			False
		Ok(indexed):
			match bound_module_graph_build(indexed, ["app/dependency"], accept_empty_view):
				Err(_):
					False
				Ok(bound):
					match declaration_skeleton_graph_build(bound):
						Err(_):
							False
						Ok(graph):
							skeleton_names(
								declaration_skeleton_graph_skeletons(
									graph,
								),
							) == ["Target", "Dependency"]


func test_skeleton_graph_excludes_parser_recovery_modules() -> Bool:
	target = fixture_module_load_candidate("main.brp", "app/main", "record Valid {value: Int}")
	recovery_source = "record RecoveryOnly {value: Int}\n\nfunc broken("
	recovery_program = finalized_program("recovery.brp", "app/recovery", recovery_source)
	recovery = module_load_candidate(
		resolved_module_identity_from_resolver("app/recovery", UserModule),
		recovery_program,
	)

	if not parsed_program_has_errors(finalized_typecheck_program_ast(recovery_program)):
		False
	else:
		match indexed_graph_build(target, [recovery]):
			Err(_):
				False
			Ok(indexed):
				match bound_module_graph_build(indexed, ["app/recovery"], accept_empty_view):
					Err(_):
						False
					Ok(bound):
						match declaration_skeleton_graph_build(bound):
							Err(_):
								False
							Ok(graph):
								skeleton_names(
									declaration_skeleton_graph_skeletons(graph),
								) == ["Valid"]


tests: TestSuite = {
	description = "Compiler declaration skeleton graph",
	tests = [
		(
			"preserves category and source order",
			test_skeleton_graph_preserves_category_and_source_order,
		),
		(
			"round trips exact identity and visibility",
			test_skeleton_graph_round_trips_exact_identity_and_visibility,
		),
		(
			"accepted global IDs are product and layout safe",
			test_accepted_global_ids_are_product_and_layout_safe,
		),
		("rejects foreign module scope", test_skeleton_graph_rejects_foreign_module_scope),
		(
			"preserves category-aligned source",
			test_skeleton_graph_preserves_category_aligned_source,
		),
		(
			"constructor source owns exact parent type identity",
			test_constructor_source_owns_exact_parent_type_identity,
		),
		("rejects duplicate type namespace", test_skeleton_graph_rejects_duplicate_type_namespace),
		(
			"rejects duplicate trait namespace",
			test_skeleton_graph_rejects_duplicate_trait_namespace,
		),
		(
			"rejects duplicate constructor within parent",
			test_skeleton_graph_rejects_duplicate_constructor_within_parent,
		),
		(
			"preserves duplicate diagnostic order",
			test_skeleton_graph_preserves_duplicate_diagnostic_order,
		),
		(
			"allows same constructor name across parents",
			test_skeleton_graph_allows_same_constructor_name_across_parents,
		),
		(
			"constructor lookup is exact across modules, parents, and spans",
			test_constructor_lookup_is_exact_across_modules_parents_and_spans,
		),
		(
			"places target before dependencies",
			test_skeleton_graph_places_target_before_dependencies,
		),
		("excludes parser recovery modules", test_skeleton_graph_excludes_parser_recovery_modules),
	]
}
