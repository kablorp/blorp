private enum TestDeclarationSourceKind:
	TestRecordTypeSource
	TestUnionTypeSource
	TestBuiltinTypeSource
	TestAliasTypeSource
	TestConstructorSource
	TestFunctionSource
	TestForeignFunctionSource
	TestGlobalSource
	TestTraitSource
	TestTraitMethodSource
	TestImplementationSource
	TestImplementationMethodSource
	TestDefaultImplementationMethodSource


private pure func finalized_program(
	path: String,
	module_name: String,
	source: String,
) -> FinalizedTypecheckProgram:
	TypecheckTestSupport.finalized_typecheck_program_fixture(path, module_name, source)


private pure func fixture_module_load_candidate(
	path: String,
	module_path: String,
	source: String,
) -> ModuleLoadCandidate:
	module_load_candidate(
		resolved_module_identity_from_resolver(module_path, UserModule),
		finalized_program(path, module_path, source),
	)


private pure func accept_empty_view(scope: PreparedModuleScope) -> BoundModuleViewBinding:
	BoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private pure func bound_graph() -> Option[BoundModuleGraph]:
	bound_graph_from_source(
		"record Box {value: Int}\n\nunion Signal:\n\tReady\n\tBusy(Int)\n\ntype NativeWord = builtin\n\ntype alias BoxAlias = Box\n\npure func answer() -> Int:\n\t42\n\nforeign:\n\tpure func native_floor(value: Float) -> Float = \"floor\"\n\ncount: Int = 1\n\ntrait Measure:\n\tpure func measure(value: Self) -> Int\n\tpure func doubled(value: Self) -> Int: measure(value) * 2\n\nimplements Measure for Box:\n\tpure func measure(value: Box) -> Int:\n\t\tvalue.value\n\nprivate record Hidden {value: Int}",
	)


private pure func bound_graph_from_source(source: String) -> Option[BoundModuleGraph]:
	target = fixture_module_load_candidate("main.brp", "app/main", source)

	match indexed_graph_build(target, []):
		Err(_):
			None
		Ok(indexed):
			match bound_module_graph_build(indexed, [], accept_empty_view):
				Err(_):
					None
				Ok(bound):
					Some(bound)


private pure func skeleton_graph_errors(source: String) -> List[DeclarationSkeletonGraphError]:
	match bound_graph_from_source(source):
		None:
			[]
		Some(bound):
			match declaration_skeleton_graph_build(bound):
				Ok(_):
					[]
				Err(errors):
					errors


private pure func skeleton_kinds(
	skeletons: List[DeclarationSkeleton],
) -> List[DeclarationSkeletonKind]:
	skeletons.map(declaration_skeleton_kind)


private pure func skeleton_names(skeletons: List[DeclarationSkeleton]) -> List[String]:
	skeletons.map(declaration_skeleton_name)


private pure func skeleton_source_kind(skeleton: DeclarationSkeleton) -> TestDeclarationSourceKind:
	match declaration_skeleton_source(skeleton):
		TypeDeclarationSourceValue(RecordTypeSource(_)):
			TestRecordTypeSource
		TypeDeclarationSourceValue(UnionTypeSource(_)):
			TestUnionTypeSource
		TypeDeclarationSourceValue(BuiltinTypeSource(_)):
			TestBuiltinTypeSource
		TypeDeclarationSourceValue(AliasTypeSource(_)):
			TestAliasTypeSource
		ConstructorDeclarationSourceValue(_, _):
			TestConstructorSource
		CallableDeclarationSourceValue(FunctionCallableSource(_)):
			TestFunctionSource
		CallableDeclarationSourceValue(ForeignCallableSource(_)):
			TestForeignFunctionSource
		CallableDeclarationSourceValue(ImplementationMethodCallableSource(_, _)):
			TestImplementationMethodSource
		CallableDeclarationSourceValue(DefaultImplementationMethodCallableSource(_, _, _)):
			TestDefaultImplementationMethodSource
		GlobalDeclarationSourceValue(_):
			TestGlobalSource
		TraitDeclarationSourceValue(_):
			TestTraitSource
		TraitMethodDeclarationSourceValue(_):
			TestTraitMethodSource
		ImplementationDeclarationSourceValue(_):
			TestImplementationSource


private pure func skeleton_named(
	skeletons: List[DeclarationSkeleton],
	name: String,
) -> Option[DeclarationSkeleton]:
	var result: Option[DeclarationSkeleton] = None

	for skeleton in skeletons:
		if declaration_skeleton_name(skeleton) == name:
			result = Some(skeleton)
			break

	result


func test_skeleton_graph_preserves_category_and_source_order() -> Bool:
	match bound_graph():
		None:
			False
		Some(bound):
			match declaration_skeleton_graph_build(bound):
				Err(_):
					False
				Ok(graph):
					definition_table = declaration_skeleton_graph_definition_table(graph)
					skeletons = declaration_skeleton_graph_skeletons(graph)

					(
						skeleton_kinds(
							skeletons,
						) == [
							TypeSkeletonKind,
							TypeSkeletonKind,
							ConstructorSkeletonKind,
							ConstructorSkeletonKind,
							TypeSkeletonKind,
							TypeSkeletonKind,
							CallableSkeletonKind,
							CallableSkeletonKind,
							GlobalSkeletonKind,
							TraitSkeletonKind,
							TraitMethodSkeletonKind,
							TraitMethodSkeletonKind,
							ImplementationSkeletonKind,
							CallableSkeletonKind,
							CallableSkeletonKind,
							TypeSkeletonKind,
						]
						and skeleton_names(
							skeletons,
						) == [
							"Box",
							"Signal",
							"Ready",
							"Busy",
							"NativeWord",
							"BoxAlias",
							"answer",
							"native_floor",
							"count",
							"Measure",
							"measure",
							"doubled",
							"Measure",
							"doubled",
							"measure",
							"Hidden",
						]
					)


func test_skeleton_graph_round_trips_exact_identity_and_visibility() -> Bool:
	match bound_graph():
		None:
			False
		Some(bound):
			match declaration_skeleton_graph_build(bound):
				Err(_):
					False
				Ok(graph):
					definition_table = declaration_skeleton_graph_definition_table(graph)
					skeletons = declaration_skeleton_graph_skeletons(graph)
					type_skeletons = declaration_skeleton_graph_type_skeletons(graph)
					callable_skeletons = declaration_skeleton_graph_callable_skeletons(graph)
					global_skeletons = declaration_skeleton_graph_global_skeletons(graph)
					implementation_skeletons = declaration_skeleton_graph_implementation_skeletons(
						graph,
					)
					first = skeletons.get(0)
					hidden = skeleton_named(skeletons, "Hidden")
					all_type_ids_round_trip = type_skeletons.all(func(type_skeleton):
						owner_scope = bound_module_scope(bound_module_graph_target(bound))

						(
							type_id_module_id(definition_table, type_skeleton.id) == Some(
								prepared_module_scope_id(owner_scope),
							)
							and declaration_skeleton_graph_find_type(
								graph,
								owner_scope,
								type_id_name(definition_table, type_skeleton.id).get_or("<unknown type>"),
							).is_some()
						)
					)
					all_global_ids_round_trip = global_skeletons.all(func(global_skeleton):
						id = global_skeleton.id
						(
							global_id_from_definition_table(
								definition_table,
								global_id_definition_id(id),
							) == Some(id)
							and global_id_module_id(definition_table, id) == Some(
								prepared_module_scope_id(
									bound_module_scope(bound_module_graph_target(bound)),
								),
							)
							and global_id_name(definition_table, id) == Some("count")
							and global_id_source_span(definition_table, id).map(func(span):
								source_spans_equal(span, global_skeleton.source.span)
							).get_or(False)
						)
					)
					wrong_kind_is_rejected = type_skeletons.get(0).map(func(type_skeleton):
						global_id_from_definition_table(
							definition_table,
							type_id_definition_id(type_skeleton.id),
						).is_none()
					).get_or(False)

					match (first, hidden):
						(Some(first_skeleton), Some(hidden_skeleton)):
							(
								all_type_ids_round_trip
								and all_global_ids_round_trip
								and wrong_kind_is_rejected
								and type_skeletons.length() == 5
								and callable_skeletons.length() == 4
								and global_skeletons.length() == 1
								and implementation_skeletons.length() == 1
								and declaration_skeleton_visibility(
									first_skeleton,
								) == PublicDeclaration
								and declaration_skeleton_visibility(
									hidden_skeleton,
								) == PrivateDeclaration
								and declaration_skeleton_name(first_skeleton) == "Box"
							)
						_:
							False


private pure func accepted_global_binding(id: GlobalId) -> AcceptedGlobalBinding:
	{
		id = id,
		binding_type = TYPE_INT,
		source_type = Some(TYPE_INT),
		is_mutable = False
	}


private pure func accepted_global_record(
	skeleton: GlobalDeclarationSkeletonInfo,
) -> AcceptedGlobalTableRecord:
	{
		id = skeleton.id,
		visibility = skeleton.visibility,
		declared_binding = Some(accepted_global_binding(skeleton.id))
	}


private pure func accepted_global_ids_are_product_and_layout_safe() -> Option[Bool]:
	owner ?= bound_graph_from_source("first: Int = 1\n\nsecond: Int = 2")
	foreign_graph ?= bound_graph_from_source("first: Int = 3\n\nsecond: Int = 4")
	owner_skeletons ?= declaration_skeleton_graph_build(owner).to_option()
	foreign_skeletons ?= declaration_skeleton_graph_build(foreign_graph).to_option()
	owner_globals = declaration_skeleton_graph_global_skeletons(owner_skeletons)
	foreign_globals = declaration_skeleton_graph_global_skeletons(foreign_skeletons)
	first ?= owner_globals.get(0)
	second ?= owner_globals.get(1)
	foreign_first ?= foreign_globals.get(0)
	definition_table = declaration_skeleton_graph_definition_table(owner_skeletons)
	foreign_definition_table = declaration_skeleton_graph_definition_table(foreign_skeletons)
	initial ?= accepted_global_table({
		definition_table = definition_table,
		globals = [accepted_global_record(first), accepted_global_record(second)]
	})
	reordered ?= accepted_global_table({
		definition_table = definition_table,
		globals = [accepted_global_record(second), accepted_global_record(first)]
	})
	completed ?= accepted_global_table_complete(
		reordered,
		definition_table,
		[accepted_global_binding(first.id), accepted_global_binding(second.id)],
	)
	authority ?= accepted_global_authority(initial, "app/main", [])
	completed_authority ?= accepted_global_authority_with_completed_table(authority, completed)

	by_name = accepted_global_find(completed_authority, "first")
	exact = accepted_global_exact(
		completed_authority,
		definition_table,
		GlobalDeclarationId(first.id),
	)
	foreign_exact = accepted_global_exact(
		completed_authority,
		foreign_definition_table,
		GlobalDeclarationId(foreign_first.id),
	)

	Some(
		global_id_definition_id(foreign_first.id) == global_id_definition_id(first.id)
			and by_name.map(func(binding):
			global_ids_equal(binding.id, first.id) and types_equal(binding.binding_type, TYPE_INT)
		).get_or(False)
			and match exact.lookup:
				AcceptedGlobalExactFound(binding): global_ids_equal(binding.id, first.id)
				_:
					False
			and match foreign_exact.lookup:
				AcceptedGlobalExactMissing:
					foreign_exact.candidates_visited == 0
				_:
					False
	)


func test_accepted_global_ids_are_product_and_layout_safe() -> Bool:
	accepted_global_ids_are_product_and_layout_safe().get_or(False)


func test_skeleton_graph_rejects_foreign_module_scope() -> Bool:
	match (
		bound_graph_from_source("record First {value: Int}"),
		bound_graph_from_source("record Second {value: Int}"),
	):
		(Some(first), Some(second)):
			match declaration_skeleton_graph_build(first):
				Err(_):
					False
				Ok(first_skeletons):
					second_scope = bound_module_scope(bound_module_graph_target(second))
					declaration_skeleton_graph_find_type(
						first_skeletons,
						second_scope,
						"First",
					).is_none()
		_:
			False


