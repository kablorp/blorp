import:
	../../../benchmark/compiler/compiler_implementation_method_parameter_profile_fixture:
		CompilerImplementationMethodParameterProfileConfig,
		compiler_implementation_method_parameter_profile_execute,
		compiler_implementation_method_parameter_profile_fixture,
		compiler_implementation_method_parameter_profile_observe,
	test: TestSuite


private func test_profile_fixture_models_ordered_candidate_batches() -> Bool:
	config: CompilerImplementationMethodParameterProfileConfig = {
		method_parameter_count = 3,
		occurrences_per_type = 2,
		return_type_occurrences = 2,
		constraint_count = 2,
		duplicate_percent = 50
	}

	match compiler_implementation_method_parameter_profile_fixture(config):
		None:
			False
		Some(fixture):
			observation = compiler_implementation_method_parameter_profile_observe(
				fixture,
				compiler_implementation_method_parameter_profile_execute(fixture, 1),
			)

			(
				fixture.discovery_batches == 8
				and fixture.candidates_discovered == 16
				and fixture.admission_probes == 16
				and fixture.unique_admissions == 8
				and fixture.duplicate_candidates == 8
				and fixture.expected_effective_parameters == 9
				and observation.header_count == 1
				and observation.method_count == 2
				and observation.effective_parameters == 9
				and observation.resolved_constraints == 2
				and observation.graph_ready
				and observation.workload_valid
			)


private func test_profile_fixture_supports_small_no_return_control() -> Bool:
	config: CompilerImplementationMethodParameterProfileConfig = {
		method_parameter_count = 1,
		occurrences_per_type = 1,
		return_type_occurrences = 0,
		constraint_count = 0,
		duplicate_percent = 0
	}

	match compiler_implementation_method_parameter_profile_fixture(config):
		None:
			False
		Some(fixture):
			observation = compiler_implementation_method_parameter_profile_observe(
				fixture,
				compiler_implementation_method_parameter_profile_execute(fixture, 1),
			)

			(
				fixture.discovery_batches == 1
				and fixture.candidates_discovered == 1
				and fixture.unique_admissions == 1
				and observation.effective_parameters == 2
				and observation.resolved_constraints == 0
				and observation.workload_valid
			)


tests: TestSuite = {
	description = "Compiler implementation method parameter profile benchmark",
	tests = [
		("models ordered candidate batches", test_profile_fixture_models_ordered_candidate_batches),
		(
			"supports small no-return control",
			test_profile_fixture_supports_small_no_return_control,
		),
	]
}
