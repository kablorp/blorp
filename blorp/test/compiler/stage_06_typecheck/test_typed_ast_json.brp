pure func json_values_equal(left: JsonValue, right: JsonValue) -> Bool:
	left.to_string() == right.to_string()


pure func fixture_source_file() -> SourceFile:
	source_file("typed_ast_json.brp", "typed_ast_json", "func main(): 1")


pure func fixture_source_span() -> SourceSpan:
	src: SourceFile = fixture_source_file()
	cursor: Cursor = source_cursor_at(src, 0)
	source_span(src, cursor, cursor)


private record ResolvedCallJsonFixture {
	module_table: ModuleTable,
	current_module_id: ModuleId,
	definition_table: DefinitionTable,
	file_callable_id: CallableId,
	dict_callable_id: CallableId,
	has_length_trait_id: TraitId,
	callable_only_definition_table: DefinitionTable
}


private pure func resolved_call_json_fixture() -> Option[ResolvedCallJsonFixture]:
	identities = ["typed_ast_json", "file", "dict"].map(func(module_path):
		resolved_module_identity_from_resolver(module_path, UserModule)
	)
	table ?= module_table(identities).to_option()
	current_module_id ?= module_table_find_id_by_canonical_path(table, "typed_ast_json")
	file_module_id ?= module_table_find_id_by_canonical_path(table, "file")
	dict_module_id ?= module_table_find_id_by_canonical_path(table, "dict")
	empty = definition_index_empty(definition_index_initial_seed(ENV_EMPTY), table)
	file_definition_id = definition_index_next_def_id(empty)
	with_file ?= definition_index_insert_func_callable_id(
		empty,
		table,
		func_callable_key(file_module_id, "read_chunk_at", fixture_source_span()),
		file_definition_id,
	).to_option()
	dict_definition_id = definition_index_next_def_id(with_file)
	with_dict ?= definition_index_insert_func_callable_id(
		with_file,
		table,
		func_callable_key(dict_module_id, "length", fixture_source_span()),
		dict_definition_id,
	).to_option()
	callable_only_definition_table = definition_index_definition_table(with_dict)
	trait_definition_id = definition_index_next_def_id(with_dict)
	complete ?= definition_index_insert_source_definition_id(
		with_dict,
		table,
		source_definition_key(
			dict_module_id,
			TraitDefinition,
			"HasLength",
			None,
			fixture_source_span(),
		),
		trait_definition_id,
	).to_option()
	definitions = definition_index_definition_table(complete)
	file_callable_id ?= callable_id_from_definition_table(definitions, file_definition_id)
	dict_callable_id ?= callable_id_from_definition_table(definitions, dict_definition_id)
	has_length_trait_id ?= trait_id_from_definition_table(definitions, trait_definition_id)
	Some({
		module_table = table,
		current_module_id = current_module_id,
		definition_table = definitions,
		file_callable_id = file_callable_id,
		dict_callable_id = dict_callable_id,
		has_length_trait_id = has_length_trait_id,
		callable_only_definition_table = callable_only_definition_table,
	})


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, fixture_source_span())


pure func sample_resolved_call() -> ResolvedCallInfo:
	{
		callee_name = "read_chunk_at",
		source_name = "read_chunk_at",
		purity = Impure,
		target = ResolvedCompilerBuiltinCall(42),
		trait_identity = None,
		bound_type_params = [],
		debug_only = False,
		instantiated_params = [TYPE_STRING, TYPE_INT],
		instantiated_return = TYPE_STRING,
		resource_args = AllowResourceArgs(ResourceResultDependent),
		dim_constraints = [(SemanticVarDimsType("#N"), SemanticConstIntType(4096))],
		loop_producer = None
	}


pure func sample_value_slot() -> ValueSlot:
	WidenedValueSlot(SemanticConstIntType(1), TYPE_INT, ArgumentSlot)


pure func sample_expr_info() -> TypedExprInfo:
	{
		source_type = None,
		origin = SynthesizedOrigin("test"),
		value_slot = KeptValueSlot(TYPE_INT),
		proofs = UNREFINED_BINDING,
		resolved_call = None,
		resolved_definition_id = None,
		resource_dependencies = []
	}


pure func sample_expr_info_with_call() -> TypedExprInfo:
	{ sample_expr_info() | resolved_call = Some(sample_resolved_call()) }


pure func sample_expr_info_for_type(typ: SemanticType) -> TypedExprInfo:
	{ sample_expr_info() | value_slot = KeptValueSlot(typ) }


