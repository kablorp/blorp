func test_widening_reason_json_preserves_payloads() -> Bool:
	numeric = widening_reason_to_json(NumericOperator(ParsedMultiplyOp))
	collection = widening_reason_to_json(CollectionElement(ListLiteral))

	json_values_equal(numeric, JsonObject([
			("kind", JsonString("numeric_operator")),
			("op", JsonString("multiply")),
		])) and json_values_equal(collection, JsonObject([
			("kind", JsonString("collection_element")),
			("collection", JsonString("list")),
		]))


func test_widening_decision_json_preserves_source_target_and_reason() -> Bool:
	decision = TypeWiden(SemanticConstIntType(1), TYPE_INT, NumericOperator(ParsedAddOp))
	expected = JsonObject([
		("kind", JsonString("widen")),
		("from_type", type_to_json(SemanticConstIntType(1))),
		("to_type", type_to_json(TYPE_INT)),
		("reason", widening_reason_to_json(NumericOperator(ParsedAddOp))),
	])

	json_values_equal(widening_decision_to_json(decision), expected)


private pure func resolved_call_json_preserves_origin_policy_and_dim_constraints(
	fixture: ResolvedCallJsonFixture,
) -> Bool:
	info = { sample_resolved_call() |
		target = ResolvedGraphCallableCall(fixture.file_callable_id, ResolvedSourceFunctionCall)
	}
	expected = JsonObject([
		("callee_name", JsonString("read_chunk_at")),
		("source_name", JsonString("read_chunk_at")),
		("purity", JsonString("impure")),
		("target", JsonObject([
			("kind", JsonString("direct")),
			(
				"callable_id",
				JsonNumber(to_float(callable_id_definition_id(fixture.file_callable_id))),
			),
			("origin", JsonObject([
				("kind", JsonString("imported")),
				("module", JsonString("file")),
			])),
		])),
		("instantiated_params", JsonVector([type_to_json(TYPE_STRING), type_to_json(TYPE_INT)])),
		("instantiated_return", type_to_json(TYPE_STRING)),
		("resource_args", JsonObject([
			("kind", JsonString("allow")),
			("result_policy", JsonString("dependent")),
		])),
		("dim_constraints", JsonVector([JsonObject([
				("left", type_to_json(SemanticVarDimsType("#N"))),
				("right", type_to_json(SemanticConstIntType(4096))),
			])])),
	])

	json_values_equal(
		resolved_call_to_json_in_graph(
			fixture.current_module_id,
			fixture.module_table,
			fixture.definition_table,
			info,
		).get_or(JsonNull),
		expected,
	)


func test_resolved_call_json_preserves_origin_policy_and_dim_constraints() -> Bool:
	match resolved_call_json_fixture():
		Some(fixture):
			resolved_call_json_preserves_origin_policy_and_dim_constraints(fixture)
		None:
			False


private pure func rejects_resolved_call_json_with_incompatible_module_table(
	fixture: ResolvedCallJsonFixture,
) -> Bool:
	(incompatible_table, incompatible_module_id) = singleton_module_table(
		resolved_module_identity_from_resolver(
			"typed_ast_json",
			UserModule,
		),
	)
	info = { sample_resolved_call() |
		target = ResolvedGraphCallableCall(fixture.file_callable_id, ResolvedSourceFunctionCall)
	}

	match resolved_call_to_json_in_graph(
		incompatible_module_id,
		incompatible_table,
		fixture.definition_table,
		info,
	):
		Err(message):
			message == "definition-backed resolved call is outside the typed-AST projection table"
		Ok(_):
			False


func test_rejects_resolved_call_json_with_incompatible_module_table() -> Bool:
	match resolved_call_json_fixture():
		Some(fixture):
			rejects_resolved_call_json_with_incompatible_module_table(fixture)
		None:
			False


private pure func rejects_resolved_call_json_with_wrong_definition_kind(
	fixture: ResolvedCallJsonFixture,
) -> Bool:
	wrong_kind = constructor_id_from_reserved_graph_definition(
		callable_id_definition_id(fixture.file_callable_id),
	)
	info = { sample_resolved_call() |
		target = ResolvedConstructorCall(wrong_kind, "NotAConstructor")
	}

	match resolved_call_to_json_in_graph(
		fixture.current_module_id,
		fixture.module_table,
		fixture.definition_table,
		info,
	):
		Err(message):
			message == "definition-backed resolved call is outside the typed-AST projection table"
		Ok(_):
			False


func test_rejects_resolved_call_json_with_wrong_definition_kind() -> Bool:
	match resolved_call_json_fixture():
		Some(fixture):
			rejects_resolved_call_json_with_wrong_definition_kind(fixture)
		None:
			False


func test_resolved_call_json_encodes_closure_target() -> Bool:
	info: ResolvedCallInfo = {
		callee_name = "<closure>",
		source_name = "<closure>",
		purity = Pure,
		target = ResolvedClosureCall,
		trait_identity = None,
		bound_type_params = [],
		debug_only = False,
		instantiated_params = [TYPE_INT],
		instantiated_return = TYPE_INT,
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}
	expected = JsonObject([
		("callee_name", JsonString("<closure>")),
		("source_name", JsonString("<closure>")),
		("purity", JsonString("pure")),
		("target", JsonObject([("kind", JsonString("closure"))])),
		("instantiated_params", JsonVector([type_to_json(TYPE_INT)])),
		("instantiated_return", type_to_json(TYPE_INT)),
		("resource_args", JsonObject([("kind", JsonString("reject"))])),
		("dim_constraints", JsonVector([])),
	])

	json_values_equal(resolved_call_to_json(info), expected)


private pure func resolved_call_json_encodes_trait_impl_target(
	fixture: ResolvedCallJsonFixture,
) -> Bool:
	info: ResolvedCallInfo = {
		callee_name = "length",
		source_name = "length",
		purity = Pure,
		target = ResolvedAcceptedTraitMethodCall(
			fixture.has_length_trait_id,
			fixture.dict_callable_id,
		),
		trait_identity = None,
		bound_type_params = [],
		debug_only = False,
		instantiated_params = [TYPE_STRING],
		instantiated_return = TYPE_INT,
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}
	expected = JsonObject([
		("callee_name", JsonString("length")),
		("source_name", JsonString("length")),
		("purity", JsonString("pure")),
		("target", JsonObject([
			("kind", JsonString("trait_method")),
			("trait_name", JsonString("HasLength")),
			("impl_target", JsonObject([
				(
					"callable_id",
					JsonNumber(to_float(callable_id_definition_id(fixture.dict_callable_id))),
				),
				("module_path", JsonString("dict")),
			])),
		])),
		("instantiated_params", JsonVector([type_to_json(TYPE_STRING)])),
		("instantiated_return", type_to_json(TYPE_INT)),
		("resource_args", JsonObject([("kind", JsonString("reject"))])),
		("dim_constraints", JsonVector([])),
	])

	json_values_equal(
		resolved_call_to_json_in_graph(
			fixture.current_module_id,
			fixture.module_table,
			fixture.definition_table,
			info,
		).get_or(JsonNull),
		expected,
	)


func test_resolved_call_json_encodes_trait_impl_target() -> Bool:
	match resolved_call_json_fixture():
		Some(fixture):
			resolved_call_json_encodes_trait_impl_target(fixture)
		None:
			False


private pure func rejects_accepted_trait_target_outside_definition_table(
	fixture: ResolvedCallJsonFixture,
) -> Bool:
	info = { sample_resolved_call() |
		target = ResolvedAcceptedTraitMethodCall(
			fixture.has_length_trait_id,
			fixture.dict_callable_id,
		)
	}

	match resolved_call_to_json_in_graph(
		fixture.current_module_id,
		fixture.module_table,
		fixture.callable_only_definition_table,
		info,
	):
		Err(message):
			message == "definition-backed resolved call is outside the typed-AST projection table"
		Ok(_):
			False


func test_rejects_accepted_trait_target_outside_definition_table() -> Bool:
	match resolved_call_json_fixture():
		Some(fixture):
			rejects_accepted_trait_target_outside_definition_table(fixture)
		None:
			False


func test_resolved_call_json_encodes_intrinsic_target() -> Bool:
	info: ResolvedCallInfo = {
		callee_name = "__checked_get",
		source_name = "__checked_get",
		purity = Pure,
		target = ResolvedIntrinsicCall,
		trait_identity = None,
		bound_type_params = [],
		debug_only = False,
		instantiated_params = [TYPE_STRING, TYPE_INT],
		instantiated_return = TYPE_STRING,
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}
	expected = JsonObject([
		("callee_name", JsonString("__checked_get")),
		("source_name", JsonString("__checked_get")),
		("purity", JsonString("pure")),
		("target", JsonObject([("kind", JsonString("intrinsic"))])),
		("instantiated_params", JsonVector([type_to_json(TYPE_STRING), type_to_json(TYPE_INT)])),
		("instantiated_return", type_to_json(TYPE_STRING)),
		("resource_args", JsonObject([("kind", JsonString("reject"))])),
		("dim_constraints", JsonVector([])),
	])

	json_values_equal(resolved_call_to_json(info), expected)


pure func value_proofs_json_matches(
	collection: CollectionIdentity,
	child: CollectionIdentity,
) -> Bool:
	proofs: ValueProofs = RangeAndSubscriptValueProofs(
		{
			range_start = 0,
			range_upper = RangeUpperLengthMinus(collection, 1),
			range_source = ProofSourceLoopRange
		},
		{
			subscript_collection = CollSubscript(CollVar(collection), child),
			subscript_source = ProofSourceCondition
		},
	)
	expected = JsonObject([("range", JsonObject([("start", JsonNumber(0.0)), ("upper", JsonObject([
				("kind", JsonString("length_minus")),
				("identity", JsonObject([("name", JsonString("items"))])),
				("offset", JsonNumber(1.0)),
			])), (
				"source",
				JsonString(
					"loop_range",
				),
			)])), ("subscript", JsonObject([
			("collection", JsonObject([("kind", JsonString("subscript")), ("parent", JsonObject([
					("kind", JsonString("var")),
					("identity", JsonObject([("name", JsonString("items"))])),
				])), ("identity", JsonObject([("name", JsonString("items_row"))]))])),
			("source", JsonString("condition")),
		]))])

	json_values_equal(value_proofs_to_json(proofs), expected)


func test_value_proofs_json_preserves_range_and_subscript() -> Bool:
	match (collection_identity("items"), collection_identity("items_row")):
		(Some(collection), Some(child)):
			value_proofs_json_matches(collection, child)
		_:
			False


