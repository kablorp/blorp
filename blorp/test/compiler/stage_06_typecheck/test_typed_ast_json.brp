func test_typed_decl_json_encodes_declaration_variants() -> Bool:
	record_info = typed_record_info()
	alias_info = typed_type_alias_info()
	union_info = typed_union_info()
	impl_info = typed_impl_info()
	parsed_trait = TraitParsedDecl(parsed_trait_decl())
	trait_info: TypedTraitInfo = {
		decl = parsed_trait_decl(),
		methods = []
	}
	parsed_imports = ImportBlockParsedDecl([parsed_import_decl("option")], fixture_source_span())

	record_ok = json_values_equal(typed_decl_to_json(TypedRecordDecl(record_info)), JsonObject([
			("kind", JsonString("record")),
			("info", typed_record_info_to_json(record_info)),
		]))
	alias_ok = json_values_equal(typed_decl_to_json(TypedTypeAliasDecl(alias_info)), JsonObject([
			("kind", JsonString("type_alias")),
			("info", typed_type_alias_info_to_json(alias_info)),
		]))
	union_ok = json_values_equal(typed_decl_to_json(TypedUnionDecl(union_info)), JsonObject([
			("kind", JsonString("union")),
			("info", typed_union_info_to_json(union_info)),
		]))
	impl_ok = json_values_equal(typed_decl_to_json(TypedImplDecl(impl_info)), JsonObject([
			("kind", JsonString("impl")),
			("info", typed_impl_info_to_json(impl_info)),
		]))
	private_ok = json_values_equal(
		typed_decl_to_json(TypedPrivateDecl(TypedTypeAliasDecl(alias_info))),
		JsonObject([
			("kind", JsonString("private")),
			("inner", typed_decl_to_json(TypedTypeAliasDecl(alias_info))),
		]),
	)
	typed_trait_bridge_ok = json_values_equal(
		typed_decl_to_json(TypedTraitDecl(trait_info)),
		JsonObject([
			("kind", JsonString("parsed")),
			("decl", parsed_decl_to_json(parsed_trait)),
		]),
	)
	parsed_import_ok = json_values_equal(
		typed_decl_to_json(TypedParsedDecl(parsed_imports)),
		JsonObject([
			("kind", JsonString("parsed")),
			("decl", parsed_decl_to_json(parsed_imports)),
		]),
	)

	(
		record_ok
		and alias_ok
		and union_ok
		and impl_ok
		and private_ok
		and typed_trait_bridge_ok
		and parsed_import_ok
	)


