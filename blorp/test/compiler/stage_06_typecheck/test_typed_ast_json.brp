	])

	json_values_equal(typed_expr_to_json(expr), expected)


private pure func typed_field_access_json_projects_definition_identity_result() -> Option[Bool]:
	fixture ?= definition_backed_record_fixture([
		{
			module_path = "typed_ast_json",
			records = [
				{
					name = "Box",
					field_names = ["value"]
				},
			]
		},
	])
	field_id ?= definition_backed_record_fixture_field_id(fixture, "typed_ast_json", "Box", "value")
	definition_id = field_id_definition_id(field_id)
	span = fixture_source_span()
	receiver = TypedNameExpr(ident("box"), sample_expr_info())
	expr = TypedFieldAccessExpr(
		receiver,
		ident("value"),
		resolved_field_identity(field_id),
		span,
		sample_expr_info(),
	)
	expected_info = { sample_expr_info() | resolved_definition_id = Some(definition_id) }
	expected = JsonObject([
		("kind", JsonString("field_access")),
		("span", parsed_source_span_to_json(span)),
		("info", typed_expr_info_to_json(expected_info)),
		("receiver", typed_expr_to_json(receiver)),
		("field", parsed_identifier_to_json(ident("value"))),
	])

	Some(json_values_equal(typed_expr_to_json(expr), expected))


func test_typed_field_access_json_projects_definition_identity() -> Bool:
	typed_field_access_json_projects_definition_identity_result().get_or(False)


func test_typed_for_json_encodes_windows_loop_view() -> Bool:
	span = fixture_source_span()
	source_type = SemanticArrayType(TYPE_INT, [SemanticConstIntType(4)])
	window_type = SemanticArrayType(TYPE_INT, [SemanticConstIntType(2)])
	source = TypedNameExpr(ident("values"), sample_expr_info_for_type(source_type))
	size = TypedIntLiteralExpr("2", span, sample_expr_info())
	callee = TypedNameExpr(ident("windows"), sample_expr_info_with_call())
	iterable = TypedCallExpr(
		callee,
		[source, size],
		span,
		sample_expr_info_for_type(type_list(TYPE_INT)),
	)
	expr = TypedForExpr(
		ParsedForNameBinder(ident("window")),
		iterable,
		Some(TypedWindowsLoopView(2, window_type)),
		TypedVoidExpr(span, sample_expr_info_for_type(TYPE_VOID)),
		span,
		sample_expr_info_for_type(TYPE_VOID),
	)
	rendered = typed_expr_to_json(expr).to_string()

	(
		rendered.contains("\"loop_view\":{\"kind\":\"windows\"")
		and rendered.contains("\"size\":2")
		and rendered.contains("\"size_arg\":{\"kind\":\"int_literal\"")
		and rendered.contains("\"element_type\":{\"kind\":\"array\"")
	)


func test_resource_for_json_projects_original_loop_body() -> Bool:
	span = fixture_source_span()
	item_name = ident("__resource_item")
	binding: TypedWithBinding = {
		name = ident("peer"),
		annotation = None,
		value = TypedNameExpr(item_name, sample_expr_info()),
		kind = ParsedWithPlainBinding,
		error_map = None,
		cleanup_function = Some("close_peer"),
		resource_loop_item_name = Some(item_name.text),
		span = span
	}
	body = TypedWithExpr(
		binding,
		TypedVoidExpr(span, sample_expr_info_for_type(TYPE_VOID)),
		span,
		sample_expr_info_for_type(TYPE_VOID),
	)
	expr = TypedForExpr(
		ParsedForNameBinder(item_name),
		TypedNameExpr(ident("connections"), sample_expr_info()),
		None,
		body,
		span,
		sample_expr_info_for_type(TYPE_VOID),
	)
	rendered = typed_expr_to_json(expr).to_string()

	(
		rendered.contains("\"binder\":{\"kind\":\"name\",\"name\":{\"text\":\"peer\"")
		and rendered.contains("\"body\":{\"kind\":\"void\"")
		and not rendered.contains("__resource_item")
		and not rendered.contains("close_peer")
	)


func test_concurrent_resource_for_json_projects_original_loop_body() -> Bool:
	span = fixture_source_span()
