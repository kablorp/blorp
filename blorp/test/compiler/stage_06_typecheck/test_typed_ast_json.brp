		and not rendered.contains("close_peer")
	)


func test_typed_expr_json_encodes_match_patterns() -> Bool:
	span = fixture_source_span()
	scrutinee = TypedNameExpr(ident("value"), sample_expr_info())
	body = TypedBlockExpr(
		[TypedIntLiteralExpr("7", span, sample_expr_info())],
		span,
		sample_expr_info(),
	)
	case: TypedMatchCase = {
		pattern = TypedIntPattern("7", span),
		body = body,
		span = span
	}
	expr = TypedMatchExpr(scrutinee, [case], span, sample_expr_info())
	expected = JsonObject([
		("kind", JsonString("match")),
		("span", parsed_source_span_to_json(span)),
		("info", typed_expr_info_to_json(sample_expr_info())),
		("scrutinee", typed_expr_to_json(scrutinee)),
		("cases", JsonVector([JsonObject([("pattern", JsonObject([
					("kind", JsonString("int")),
					("value", JsonString("7")),
					("span", parsed_source_span_to_json(span)),
				])), (
					"body",
					typed_expr_to_json(body),
				), ("span", parsed_source_span_to_json(span))])])),
	])

	json_values_equal(typed_expr_to_json(expr), expected)


func test_typed_expr_json_encodes_concurrent_block_bindings() -> Bool:
	span = fixture_source_span()
	value = TypedIntLiteralExpr("1", span, sample_expr_info())
	binding: TypedConcurrentBinding = {
		name = ident("answer"),
		annotation = None,
		value = value,
		span = span,
		info = sample_expr_info()
	}
	param: TypedConcurrentParam = {
		name = ident("max_threads"),
		value = TypedIntLiteralExpr("2", span, sample_expr_info()),
		span = span
	}
	expr = TypedConcurrentBlockExpr([param], [binding], span, sample_expr_info())
	expected = JsonObject([
		("kind", JsonString("concurrent_block")),
		("span", parsed_source_span_to_json(span)),
		("info", typed_expr_info_to_json(sample_expr_info())),
		("params", JsonVector([JsonObject([
				("name", parsed_identifier_to_json(ident("max_threads"))),
				("value", typed_expr_to_json(param.value)),
				("span", parsed_source_span_to_json(span)),
			])])),
		("bindings", JsonVector([JsonObject([
				("kind", JsonString("concurrent_bind")),
				("span", parsed_source_span_to_json(span)),
				("info", typed_expr_info_to_json(binding.info)),
				("name", parsed_identifier_to_json(ident("answer"))),
				("annotation", JsonNull),
				("value", typed_expr_to_json(value)),
			])])),
	])

	json_values_equal(typed_expr_to_json(expr), expected)


