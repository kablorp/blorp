import:
	../../../src/compiler/stage_06_typecheck/graph/indexed_graph: PreparedModuleScope
	../../../src/compiler/stage_06_typecheck/graph/type_identity: TypeId, type_ids_equal
	../../../src/compiler/stage_06_typecheck/type_system/accepted_alias_authority:
		AcceptedAliasExactLookup(
			AcceptedAliasExactFound,
			AcceptedAliasExactMissing,
			AcceptedAliasExactWrongKind,
		),
		AcceptedAliasTableInput,
		AcceptedOpaqueAlias,
		AcceptedTransparentAlias,
		AcceptedTypeIdentity,
		AcceptedVisibleTypeBinding,
		accepted_alias_authority,
		accepted_alias_exact_transparent,
		accepted_alias_find_opaque,
		accepted_alias_find_transparent,
		accepted_alias_module_view,
		accepted_alias_module_view_binding_count,
		accepted_alias_resolve,
		accepted_alias_table,
		accepted_alias_table_alias_count,
	../../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticType(SemanticNamedType),
		TYPE_INT,
		TYPE_STRING,
		canonical_module_type_name,
		types_equal,
	../typecheck_test_support:
		DefinitionBackedTypeFixtureModule,
		definition_backed_type_fixture,
		definition_backed_type_fixture_definition_table,
		definition_backed_type_fixture_type_id,
		module_id_fixture_find,
	test: TestSuite


private FIXTURE_MODULES: List[DefinitionBackedTypeFixtureModule] = [
	{module_path = "app/main", type_names = ["Box"]},
	{module_path = "app/left", type_names = []},
	{module_path = "pkg/left", type_names = ["Name"]},
	{module_path = "pkg/right", type_names = ["Name"]},
	{module_path = "pkg/unrelated", type_names = ["Other"]},
]


private pure func fixture_type_id(
	fixture: PreparedModuleScope,
	module_path: String,
	name: String,
) -> Option[TypeId]:
	definition_backed_type_fixture_type_id(fixture, module_path, name)


private pure func table_input(
	fixture: PreparedModuleScope,
	include_unrelated: Bool,
) -> Option[AcceptedAliasTableInput]:
	left_alias_id ?= fixture_type_id(fixture, "pkg/left", "Name")
	right_alias_id ?= fixture_type_id(fixture, "pkg/right", "Name")
	record_id ?= fixture_type_id(fixture, "app/main", "Box")
	base_types: List[AcceptedTypeIdentity] = [
		{
			id = left_alias_id,
			canonical_name = canonical_module_type_name("pkg/left", "Name"),
			type_params = []
		},
		{
			id = right_alias_id,
			canonical_name = canonical_module_type_name("pkg/right", "Name"),
			type_params = []
		},
		{
			id = record_id,
			canonical_name = canonical_module_type_name("app/main", "Box"),
			type_params = []
		},
	]

	type_identities ?= if include_unrelated:
		fixture_type_id(fixture, "pkg/unrelated", "Other").map(func(unrelated_id):
			base_types.append({
				id = unrelated_id,
				canonical_name = canonical_module_type_name("pkg/unrelated", "Other"),
				type_params = [],
			})
		)
	else:
		Some(base_types)

	Some({
		definition_table = definition_backed_type_fixture_definition_table(fixture),
		type_identities = type_identities,
		transparent_aliases = [
			{
				id = left_alias_id,
				canonical_name = canonical_module_type_name("pkg/left", "Name"),
				canonical_visible = True,
				payload = {
					type_params = [],
					target = TYPE_STRING
				}
			},
		],
		opaque_aliases = [
			{
				id = right_alias_id,
				canonical_name = canonical_module_type_name("pkg/right", "Name"),
				canonical_visible = False,
				payload = {
					canonical_name = canonical_module_type_name("pkg/right", "Name"),
					type_params = [],
					target = TYPE_INT,
					home_module = "pkg/right"
				}
			},
		],
	})


private pure func alias_authority_is_category_safe_and_identity_exact_result() -> Option[Bool]:
	fixture ?= definition_backed_type_fixture(FIXTURE_MODULES)
	input ?= table_input(fixture, False)
	table ?= accepted_alias_table(input)
	left_alias_id ?= fixture_type_id(fixture, "pkg/left", "Name")
	record_id ?= fixture_type_id(fixture, "app/main", "Box")
	owner ?= module_id_fixture_find(fixture, "app/main")
	view ?= accepted_alias_module_view(
		table,
		owner,
		[
			{
				source_name = "DisplayName",
				id = left_alias_id,
				owner_local = False
			},
			{
				source_name = "Box",
				id = record_id,
				owner_local = True
			},
		],
	)
	authority = accepted_alias_authority(table, view)

	Some(
		(
			accepted_alias_table_alias_count(table) == 2
			and accepted_alias_module_view_binding_count(view) == 2
			and accepted_alias_find_transparent(authority, "Box").is_none()
			and types_equal(
				accepted_alias_resolve(
					authority,
					SemanticNamedType("DisplayName", []),
				),
				TYPE_STRING,
			)
			and accepted_alias_find_opaque(
				authority,
				canonical_module_type_name("pkg/right", "Name"),
			).is_none()
			and match accepted_alias_exact_transparent(table, record_id).lookup:
				AcceptedAliasExactWrongKind(id):
					type_ids_equal(id, record_id)
				AcceptedAliasExactFound(_) | AcceptedAliasExactMissing:
					False
		),
	)


private pure func alias_authority_is_category_safe_and_identity_exact() -> Bool:
	alias_authority_is_category_safe_and_identity_exact_result().get_or(False)


private pure func table_rejects_forged_canonical_name_result() -> Option[Bool]:
	fixture ?= definition_backed_type_fixture(FIXTURE_MODULES)
	input ?= table_input(fixture, False)
	identity ?= input.type_identities.get(0)
	forged = { identity | canonical_name = "Option" }
	Some(accepted_alias_table({ input |
		type_identities = input.type_identities.set(0, forged)
	}).is_none())


private pure func table_rejects_forged_canonical_name() -> Bool:
	table_rejects_forged_canonical_name_result().get_or(False)


private pure func module_view_rejects_forged_private_visibility_result() -> Option[Bool]:
	fixture ?= definition_backed_type_fixture(FIXTURE_MODULES)
	input ?= table_input(fixture, False)
	table ?= accepted_alias_table(input)
	private_alias_id ?= fixture_type_id(fixture, "pkg/right", "Name")
	main_owner ?= module_id_fixture_find(fixture, "app/main")
	imported_private = accepted_alias_module_view(
		table,
		main_owner,
		[
			{
				source_name = "PrivateName",
				id = private_alias_id,
				owner_local = False
			},
		],
	)
	false_local = accepted_alias_module_view(
		table,
		main_owner,
		[
			{
				source_name = "FalseLocal",
				id = private_alias_id,
				owner_local = True
			},
		],
	)

	Some(imported_private.is_none() and false_local.is_none())


private pure func module_view_rejects_forged_private_visibility() -> Bool:
	module_view_rejects_forged_private_visibility_result().get_or(False)


private pure func exact_alias_queries_ignore_unrelated_modules_result() -> Option[Bool]:
	fixture ?= definition_backed_type_fixture(FIXTURE_MODULES)
	base_input ?= table_input(fixture, False)
	expanded_input ?= table_input(fixture, True)
	base ?= accepted_alias_table(base_input)
	expanded ?= accepted_alias_table(expanded_input)
	id ?= fixture_type_id(fixture, "pkg/left", "Name")
	base_probe = accepted_alias_exact_transparent(base, id)
	expanded_probe = accepted_alias_exact_transparent(expanded, id)

	Some(
		(
			base_probe.candidates_visited == 1
			and expanded_probe.candidates_visited == 1
			and match (base_probe.lookup, expanded_probe.lookup):
				(AcceptedAliasExactFound(left), AcceptedAliasExactFound(right)):
					types_equal(left.target, right.target)
				_:
					False
		),
	)


private pure func exact_alias_queries_ignore_unrelated_modules() -> Bool:
	exact_alias_queries_ignore_unrelated_modules_result().get_or(False)


private pure func same_spelling_aliases_remain_owner_distinct_result() -> Option[Bool]:
	fixture ?= definition_backed_type_fixture(FIXTURE_MODULES)
	input ?= table_input(fixture, False)
	table ?= accepted_alias_table(input)
	left_id ?= fixture_type_id(fixture, "pkg/left", "Name")
	right_id ?= fixture_type_id(fixture, "pkg/right", "Name")
	left_owner ?= module_id_fixture_find(fixture, "app/left")
	right_owner ?= module_id_fixture_find(fixture, "pkg/right")
	left_view ?= accepted_alias_module_view(
		table,
		left_owner,
		[
			{
				source_name = "Name",
				id = left_id,
				owner_local = False
			},
		],
	)
	right_view ?= accepted_alias_module_view(
		table,
		right_owner,
		[
			{
				source_name = "Name",
				id = right_id,
				owner_local = True
			},
		],
	)
	left = accepted_alias_find_transparent(
		accepted_alias_authority(table, left_view),
		"Name",
	)
	right = accepted_alias_find_opaque(
		accepted_alias_authority(table, right_view),
		"Name",
	)

	Some(left.is_some() and right.is_some())


private pure func same_spelling_aliases_remain_owner_distinct() -> Bool:
	same_spelling_aliases_remain_owner_distinct_result().get_or(False)


tests: TestSuite = {
	description = "Accepted alias authority",
	tests = [
		("table rejects forged canonical name", table_rejects_forged_canonical_name),
		(
			"alias authority is category safe and identity exact",
			alias_authority_is_category_safe_and_identity_exact,
		),
		(
			"module view rejects forged private visibility",
			module_view_rejects_forged_private_visibility,
		),
		(
			"exact alias queries ignore unrelated modules",
			exact_alias_queries_ignore_unrelated_modules,
		),
		(
			"same spelling aliases remain owner distinct",
			same_spelling_aliases_remain_owner_distinct,
		),
	]
}
