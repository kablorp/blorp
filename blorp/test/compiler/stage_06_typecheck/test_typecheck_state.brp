pure func callable_span(start_line: Int, end_line: Int) -> SourceSpan:
	{
		path = "app.brp",
		module_name = "app",
		start_offset = start_line,
		start_line = start_line,
		start_column = 2,
		end_offset = end_line,
		end_line = end_line,
		end_column = 1
	}


private pure func finalized_program(
	path: String,
	module_name: String,
	source: String,
) -> FinalizedTypecheckProgram:
	TypecheckTestSupport.finalized_typecheck_program_fixture(path, module_name, source)


private pure func parsed_program(
	path: String,
	module_name: String,
	source: String,
) -> ParsedProgram:
	finalized_typecheck_program_ast(finalized_program(path, module_name, source))


private pure func prepared_module(
	path: String,
	module_name: String,
	source: String,
) -> Option[PreparedModuleScope]:
	prepared_module_with_origin(path, module_name, source, UserModule)


private pure func prepared_module_with_origin(
	path: String,
	module_name: String,
	source: String,
	origin: ModuleOrigin,
) -> Option[PreparedModuleScope]:
	candidate = module_load_candidate(
		resolved_module_identity_from_resolver(module_name, origin),
		finalized_program(path, module_name, source),
	)

	match indexed_graph_build(candidate, []):
		Ok(graph):
			Some(indexed_graph_target_scope(graph))
		Err(_):
			None


private pure func direct_state(module_name: String) -> TypecheckState:
	typecheck_state_scope_to_program(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		parsed_program(module_name + ".brp", module_name, ""),
	)


private pure func graph_with_dependency() -> Option[IndexedGraph]:
	target = module_load_candidate(
		resolved_module_identity_from_resolver("app", UserModule),
		finalized_program("app.brp", "app", "pure func app_value() -> Int:\n\t0"),
	)
	dependency = module_load_candidate(
		resolved_module_identity_from_resolver("dep", UserModule),
		finalized_program(
			"dep.brp",
			"dep",
			"pure func render() -> Int:\n\t1\n\nunion Signal:\n\tReady",
		),
	)

	match indexed_graph_build(target, [dependency]):
		Ok(graph):
			Some(graph)
		Err(_):
			None


func test_state_initialization_and_origin_policy() -> Bool:
	user_state = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN)
	std_state = typecheck_state_for_origin(TYPECHECK_STDLIB_ORIGIN)
	source_package_state = typecheck_state_for_origin(SourcePackageModule("pkg/demo"))
	debug_state = typecheck_state_with_debug_calls(user_state, True)

	(
		not typecheck_state_allows_builtin(user_state)
		and typecheck_state_allows_foreign(user_state)
		and typecheck_state_allows_builtin(std_state)
		and not typecheck_state_allows_foreign(std_state)
		and not typecheck_state_allows_builtin(source_package_state)
		and not typecheck_state_allows_foreign(source_package_state)
		and not user_state.allow_debug_only_calls
		and debug_state.allow_debug_only_calls
		and typecheck_state_is_stdlib(std_state)
	)


func test_imported_modules_and_import_bindings_are_deduped() -> Bool:
	state = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN)
	var with_modules = typecheck_state_add_imported_module(state, "list")
	with_modules = typecheck_state_add_imported_module(with_modules, "list")
	with_modules = typecheck_state_add_imported_module(with_modules, "string")

	with_alias = typecheck_state_register_module_alias(with_modules, "List", "list")
	with_duplicate_alias = typecheck_state_register_module_alias(with_alias, "List", "list")
	with_name = typecheck_state_register_imported_name(with_duplicate_alias, "map", "list", "map")
	with_bindings = with_name.state

	(
		module_view_imported_modules(with_bindings.module_view).length() == 2
		and typecheck_state_has_imported_module(with_bindings, "list")
		and typecheck_state_has_imported_module(with_bindings, "string")
		and module_view_import_bindings(with_bindings.module_view).length() == 2
		and typecheck_state_has_qualified_module_binding(with_bindings, "List", "list")
		and typecheck_state_has_selective_definition_binding(with_bindings, "map", "list", "map")
	)


func test_import_binding_kind_is_explicit() -> Bool:
	qualified: ImportBinding = QualifiedModuleBinding("List", "list")
	selective: ImportBinding = SelectiveDefinitionBinding("map", "list", "map")

	qualified_shape = match qualified:
		QualifiedModuleBinding(local_name, module_path):
			local_name == "List" and module_path == "list"
		SelectiveDefinitionBinding(_, _, _):
			False

	selective_shape = match selective:
		QualifiedModuleBinding(_, _):
			False
		SelectiveDefinitionBinding(local_name, module_path, source_name):
			local_name == "map" and module_path == "list" and source_name == "map"

	qualified_shape and selective_shape


func test_module_alias_and_imported_name_namespace_collisions() -> Bool:
	with_top_level = typecheck_state_remember_top_level_name(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		"Result",
		TopLevelType,
	)
	alias_conflict = typecheck_state_register_module_alias(with_top_level, "Result", "result")
	alias_ok = typecheck_state_register_module_alias(with_top_level, "List", "list")
	alias_repeat = typecheck_state_register_module_alias(alias_ok, "List", "list")
	alias_rebind = typecheck_state_register_module_alias(alias_repeat, "List", "other/list")
	same_module_import = typecheck_state_register_imported_name(alias_ok, "List", "list", "List")
	import_conflict = typecheck_state_register_imported_name(alias_ok, "List", "other/list", "List")
	import_ok = typecheck_state_register_imported_name(alias_ok, "map", "list", "map")
	import_duplicate = typecheck_state_register_imported_name(import_ok.state, "map", "list", "map")

	(
		typecheck_state_find_top_level_name(with_top_level, "Result") == Some(TopLevelType)
		and top_level_name_kind_label(TopLevelTrait) == "trait"
		and alias_conflict.errors.length() == 1
		and typecheck_state_find_module_alias(alias_ok, "List") == Some("list")
		and alias_repeat.errors.length() == 0
		and module_view_module_aliases(alias_repeat.module_view).length() == 1
		and alias_rebind.errors.length() == 1
		and same_module_import.registered
		and same_module_import.state.errors.is_empty()
		and typecheck_state_has_qualified_module_binding(same_module_import.state, "List", "list")
		and typecheck_state_has_selective_definition_binding(
			same_module_import.state,
			"List",
			"list",
			"List",
		)
		and import_conflict.registered == False
		and import_conflict.state.errors.length() == 1
		and import_ok.registered
		and module_view_imported_names(import_ok.state.module_view).length() == 1
		and import_duplicate.registered == False
		and import_duplicate.state.errors.length() == 1
	)


func test_name_lookup_indexes_are_complete_and_state_local() -> Bool:
	base = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN)
	with_top_level = typecheck_state_remember_top_level_name(base, "Widget", TopLevelType)
	duplicate_top_level = typecheck_state_remember_top_level_name(
		with_top_level,
		"Widget",
		TopLevelFunction,
	)
	imported = typecheck_state_register_imported_name(with_top_level, "map", "list", "map")
	duplicate_import = typecheck_state_register_imported_name(
		imported.state,
		"map",
		"other/list",
		"different_map",
	)
	cleared = typecheck_state_clear_module_name_indexes(imported.state)

	(
		typecheck_state_find_top_level_name(base, "Widget").is_none()
		and module_view_imported_names(base.module_view).length() == 0
		and typecheck_state_find_top_level_name(with_top_level, "Widget") == Some(TopLevelType)
		and typecheck_state_find_top_level_name(duplicate_top_level, "Widget") == Some(TopLevelType)
		and module_view_imported_names(imported.state.module_view).length() == 1
		and typecheck_state_find_imported_name(
			imported.state,
			"map",
		).map(
			func(binding): binding.module_path,
		) == Some("list")
		and not duplicate_import.registered
		and module_view_imported_names(duplicate_import.state.module_view).length() == 1
		and typecheck_state_find_imported_name(
			duplicate_import.state,
			"map",
		).map(
			func(binding): binding.original_name,
		) == Some("map")
		and module_view_imported_names(with_top_level.module_view).is_empty()
		and module_view_imported_names(cleared.module_view).is_empty()
		and module_view_import_bindings(cleared.module_view).is_empty()
		and typecheck_state_find_top_level_name(cleared, "Widget").is_none()
		and module_view_imported_names(imported.state.module_view).length() == 1
		and typecheck_state_find_top_level_name(imported.state, "Widget") == Some(TopLevelType)
	)


func test_known_names_and_type_home_precedence() -> Bool:
	var state = typecheck_state_add_known_type_name(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		"Widget",
	)
	state = typecheck_state_add_known_type_name(state, "Widget")
	state = typecheck_state_add_known_type_name(state, "Reader")
	state = typecheck_state_add_known_resource_type_name(state, "Reader")
	state = typecheck_state_add_known_type_name(state, "Reader")
	state = typecheck_state_add_known_resource_type_name(state, "Reader")
	state = typecheck_state_remember_top_level_name(state, "main", TopLevelFunction)
	imported_home = typecheck_state_record_type_home(state, "Widget", "pkg/widgets", True)
	ignored_import = typecheck_state_record_type_home(
		imported_home,
		"Widget",
		"pkg/other_widgets",
		True,
	)
	local_home = typecheck_state_record_type_home(ignored_import, "Widget", "app/main", False)
	cleared = typecheck_state_clear_known_type_index(local_home)

	(
		typecheck_state_has_known_type_name(local_home, "Widget")
		and typecheck_state_has_known_type_name(local_home, "Reader")
		and typecheck_state_has_known_resource_type_name(local_home, "Reader")
		and not typecheck_state_has_known_resource_type_name(local_home, "Widget")
		and not typecheck_state_has_known_type_name(cleared, "Widget")
		and not typecheck_state_has_known_type_name(cleared, "Reader")
		and not typecheck_state_has_known_resource_type_name(cleared, "Reader")
		and typecheck_state_find_top_level_name(local_home, "main") == Some(TopLevelFunction)
		and typecheck_state_find_type_home(imported_home, "Widget") == Some("pkg/widgets")
		and typecheck_state_find_type_home(ignored_import, "Widget") == Some("pkg/widgets")
		and typecheck_state_find_type_home(local_home, "Widget") == Some("app/main")
		and typecheck_state_type_home_matches(local_home, "Widget", "app/main")
	)


func test_callable_ids_and_private_impls_are_state_local() -> Bool:
	base = direct_state("app")
	key = func_callable_key(
		typecheck_state_module_identity(base),
		"render",
		callable_span(10, 12),
	)
	other_key = func_callable_key(
		typecheck_state_module_identity(base),
		"render",
		callable_span(20, 22),
	)
	instance = impl_instance(7, "Display", TYPE_INT, [], False)

	match typecheck_state_claim_func_callable_id(base, key):
		DefinitionIdMissing(_):
			False
		DefinitionIdClaimed(with_first, first_id):
			match typecheck_state_claim_func_callable_id(with_first, key):
				DefinitionIdMissing(_):
					False
				DefinitionIdClaimed(with_repeat, repeated_id):
					match typecheck_state_claim_func_callable_id(with_repeat, other_key):
						DefinitionIdMissing(_):
							False
						DefinitionIdClaimed(with_other, other_id):
							with_impl = typecheck_state_add_private_impl(with_other, instance)
							conflict = typecheck_state_find_private_impl_conflict(
								with_impl,
								instance,
							)

							(
								repeated_id == first_id
								and other_id == first_id + 1
								and typecheck_state_func_callable_bindings(
									with_impl,
									"render",
								).length() == 2
								and with_impl.errors.length() == 0
								and with_impl.private_impls.length() == 1
								and conflict.is_some()
							)


func test_unscoped_definition_claim_is_rejected() -> Bool:
	base = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN)
	key = func_callable_key(
		typecheck_state_module_identity(base),
		"render",
		callable_span(10, 12),
	)

	match typecheck_state_claim_func_callable_id(base, key):
		DefinitionIdClaimed(_, _):
			False
		DefinitionIdMissing(with_error):
			(
				with_error.errors.length() == 1
				and with_error.errors
					.get_or(0, "")
					.contains("before selecting a module")
			)


func test_reserved_definition_ids_are_read_only_and_graph_owned() -> Bool:
	match prepared_module(
		"render.brp",
		"pkg/render",
		"pure func render(value: Int) -> Int:\n\tvalue\n\npure func render(value: String) -> Int:\n\tvalue.length()",
	):
		None:
			False
		Some(module):
			reserved = typecheck_state_enter_prepared_module_scope(
				typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				module,
			)
			missing_key = func_callable_key(
				typecheck_state_module_identity(reserved),
				"not_planned",
				callable_span(30, 32),
			)

			match typecheck_state_claim_func_callable_id(reserved, missing_key):
				DefinitionIdClaimed(_, _):
					False
				DefinitionIdMissing(with_error):
					(
						typecheck_state_func_callable_bindings(reserved, "render").length() == 2
						and typecheck_state_find_func_callable_id(with_error, missing_key).is_none()
						and with_error.errors.length() == 1
						and with_error.errors
							.get_or(0, "")
							.contains("missing reserved definition ID")
					)


func test_reserved_source_definition_ids_are_precise() -> Bool:
	match prepared_module("types.brp", "types", "union A:\n\tLeft\n\nunion B:\n\tRight"):
		None:
			False
		Some(module):
			reserved = typecheck_state_enter_prepared_module_scope(
				typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				module,
			)

			(
				definition_index_source_definition_bindings(
					typecheck_state_definition_index(reserved),
					"Left",
				).length() == 1
				and definition_index_source_definition_bindings(
					typecheck_state_definition_index(reserved),
					"Right",
				).length() == 1
				and reserved.env.next_def_id == definition_index_next_def_id(
					typecheck_state_definition_index(reserved),
				)
			)


func test_definition_keys_reuse_source_spans() -> Bool:
	module_identity = typecheck_state_module_identity(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
	)
	source = source_file("app.brp", "app", "func render(): 0")
	start = source_start(source)
	span = source_span(source, start, start)
	callable_key = func_callable_key(module_identity, "render", span)
	definition_key = source_definition_key(
		module_identity,
		ConstructorDefinition,
		"Render",
		None,
		span,
	)
	callable_span = func_callable_key_span(callable_key)
	definition_span = source_definition_key_span(definition_key)

	(
		callable_span.path == "app.brp"
		and callable_span.module_name == "app"
		and callable_span.start_offset == 0
		and definition_span.path == "app.brp"
		and definition_span.module_name == "app"
		and definition_span.end_offset == 0
	)


func test_definition_index_installation_never_lowers_env_frontier() -> Bool:
	match prepared_module("empty.brp", "empty", ""):
		None:
			False
		Some(module):
			base = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN)
			advanced_next_def_id = base.env.next_def_id + 20
			advanced = { base | env = { base.env | next_def_id = advanced_next_def_id } }
			installed = typecheck_state_enter_prepared_module_scope(advanced, module)

			(
				installed.env.next_def_id == advanced_next_def_id
				and definition_index_next_def_id(
					typecheck_state_definition_index(installed),
				) == advanced_next_def_id
			)


func test_prepared_scope_switches_and_restores_identity_and_origin_together() -> Bool:
	target = direct_state("app")

	match prepared_module_with_origin(
		"dependency.brp",
		"dependency",
		"pure func value() -> Int:\n\t1",
		SourcePackageModule("pkg/dependency"),
	):
		None:
			False
		Some(module):
			scoped = typecheck_state_scope_to_imported_module(target, module)
			restored = typecheck_state_restore_definition_scope(scoped, target)

			(
				module_identity_display_name(
					typecheck_state_module_identity(scoped),
				) == "dependency"
				and not typecheck_state_allows_foreign(scoped)
				and module_identity_display_name(typecheck_state_module_identity(restored)) == "app"
				and typecheck_state_allows_foreign(restored)
			)


func test_reserved_scope_rejects_replacement_from_another_graph() -> Bool:
	match (
		prepared_module("first.brp", "shared", "pure func first() -> Int:\n\t1"),
		prepared_module("second.brp", "shared", "pure func second() -> Int:\n\t2"),
	):
		(Some(first_scope), Some(second_scope)):
			first_state = typecheck_state_enter_prepared_module_scope(
				typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				first_scope,
			)
			rejected = typecheck_state_enter_prepared_module_scope(first_state, second_scope)

			(
				rejected.errors.length() == 1
				and rejected.errors
					.get_or(0, "")
					.contains("cannot replace an indexed graph scope")
				and typecheck_state_func_callable_bindings(rejected, "first").length() == 1
				and typecheck_state_func_callable_bindings(rejected, "second").length() == 0
			)
		_:
			False


func test_reserved_scope_rejects_definition_ids_owned_by_another_module() -> Bool:
	match graph_with_dependency():
		None:
			False
		Some(graph):
			state = typecheck_state_enter_prepared_module_scope(
				typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				indexed_graph_target_scope(graph),
			)

			match (
				typecheck_state_func_callable_bindings(state, "render").get(0),
				definition_index_source_definition_bindings(
					typecheck_state_definition_index(state),
					"Ready",
				).get(0),
			):
				(Some(callable_binding), Some(source_binding)):
					callable_claim = typecheck_state_claim_func_callable_id(
						state,
						callable_binding[0],
					)
					source_claim = typecheck_state_claim_source_definition_id(
						state,
						source_binding[0],
					)

					match (callable_claim, source_claim):
						(DefinitionIdMissing(callable_error), DefinitionIdMissing(source_error)):
							(
								callable_error.errors
									.get_or(0, "")
									.contains("callable definition ID owned by a different module")
								and source_error.errors
									.get_or(0, "")
									.contains("source definition ID owned by a different module")
							)
						_:
							False
				_:
					False


func test_initial_definition_index_seed_matches_typecheck_environment() -> Bool:
	definition_index_seed_next_def_id(
		definition_index_initial_seed(
			ENV_EMPTY,
		),
	) == typecheck_state_for_origin(TYPECHECK_USER_ORIGIN).env.next_def_id


func test_add_diagnostic_preserves_structured_span() -> Bool:
	span = callable_span(7, 11)
	state = typecheck_state_add_diagnostic(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		typecheck_diagnostic("located failure", Some(span)),
	)

	match (state.errors, state.diagnostics):
		([message], [diagnostic]):
			match diagnostic.span:
				Some(preserved):
					(
						message == "located failure"
						and diagnostic.message == message
						and source_spans_equal(preserved, span)
					)
				None:
					False
		_:
			False


func test_type_shape_memo_reset_preserves_semantic_state() -> Bool:
	base = typecheck_state_add_known_type_name(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		"Widget",
	)
	memo = { TYPE_SHAPE_MEMO_EMPTY | contains_target = [
			{
				typ = TYPE_INT,
				contains_one_shot_stream = True,
				contains_resource_source = False
			},
		] }
	seeded = { base | type_shape_memo = memo }
	reset = typecheck_state_reset_type_shape_memo(seeded)

	(
		typecheck_state_has_known_type_name(reset, "Widget")
		and reset.type_shape_memo.contains_target.length() == 0
		and reset.type_shape_memo.function_carrier.length() == 0
	)


pure func test_infer_session_round_trip_preserves_module_facts() -> Bool:
	scoped = typecheck_state_scope_to_program(
		typecheck_state_for_origin(UserModule),
		parsed_program("session.brp", "session", ""),
	)
	restored = typecheck_state_from_infer_session(infer_session_from_typecheck_state(scoped))

	(
		module_identities_equal(
			typecheck_state_module_identity(restored),
			typecheck_state_module_identity(scoped),
		)
		and restored.errors == scoped.errors
		and restored.diagnostics == scoped.diagnostics
	)


