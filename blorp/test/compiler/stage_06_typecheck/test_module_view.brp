							"Token",
						) == Some(module_id)
						and module_view_has_selective_binding(with_both, "Token", "dep", "Token")
						and bindings.length() == 2
						and qualified_first
						and selective_second
					)
				_:
					False
		_:
			False

	Some(result)


func test_graph_alias_then_selective_share_one_row() -> Bool:
	graph_alias_then_selective_share_one_row_result().get_or(False)


private pure func graph_view_rejects_equal_layout_foreign_table_result() -> Option[Bool]:
	local_scope ?= definition_backed_source_fixture("app/main", "func GraphAlias() -> Int: 1")
	foreign_scope ?= definition_backed_source_fixture("app/main", "func GraphAlias() -> Int: 1")
	view = module_view_for_graph(prepared_module_scope_graph_module_name_scope(local_scope))
	foreign_table = prepared_module_scope_module_table(foreign_scope)
	foreign_id = prepared_module_scope_id(foreign_scope)

	result = match module_view_register_module_alias_target(
		view,
		foreign_table,
		foreign_id,
		"GraphAlias",
		"app/main",
		foreign_table,
		foreign_id,
	):
		ModuleAliasInvalidTarget:
			module_view_graph_bound_name_count(view) == 0
		_:
			False

	Some(result)


func test_graph_view_rejects_equal_layout_foreign_table() -> Bool:
	graph_view_rejects_equal_layout_foreign_table_result().get_or(False)


private pure func graph_conflicts_leave_bound_rows_unchanged_result() -> Option[Bool]:
	scope ?= module_id_fixture(["first", "second"])
	table = prepared_module_scope_module_table(scope)
	first_id ?= module_id_fixture_find(scope, "first")
	second_id ?= module_id_fixture_find(scope, "second")
	definition_table = definition_backed_type_fixture_definition_table(scope)
	view = module_view_for_graph(
		graph_module_name_scope(
			graph_source_name_table(
				table,
				["Shared", "Trait"],
			),
			first_id,
		),
	)

	wrong_owner_selective = match module_view_register_graph_selective_trait_method(
		view,
		second_id,
		definition_table,
		definition_table,
		"Shared",
		"first",
		"Trait",
		first_id,
		[],
	):
		SelectiveNameInvalidTarget:
			module_view_graph_bound_name_count(view) == 0
		_:
			False

	with_alias = match module_view_register_module_alias_target(
		view,
		table,
		first_id,
		"Shared",
		"first",
		table,
		first_id,
	):
		ModuleAliasAdded(next):
			Some(next)
		_:
			None

	alias_view ?= with_alias

	alias_duplicate = match module_view_register_module_alias_target(
		alias_view,
		table,
		first_id,
		"Shared",
		"first",
		table,
		first_id,
	):
		ModuleAliasAlreadyPresent:
			True
		_:
			False

	alias_conflict = match module_view_register_module_alias_target(
		alias_view,
		table,
		first_id,
		"Shared",
		"second",
		table,
		second_id,
	):
		ModuleAliasConflictsWithAlias(path):
			path == "first"
		_:
			False

	selective_conflict = match module_view_register_graph_selective_trait_method(
		alias_view,
		first_id,
		definition_table,
		definition_table,
		"Shared",
		"second",
		"Trait",
		second_id,
		[],
	):
		SelectiveNameConflictsWithAlias(path):
			path == "first"
		_:
			False

	local_conflict = match module_view_register_local_name_for_graph(
		alias_view,
		table,
		first_id,
		"Shared",
		TopLevelFunction,
	):
		LocalNameConflictsWithAlias(path):
			path == "first"
		_:
			False

	with_selective = match module_view_register_graph_selective_trait_method(
		view,
		first_id,
		definition_table,
		definition_table,
		"Shared",
		"first",
		"Trait",
		first_id,
		[],
	):
		SelectiveNameAdded(next):
			Some(next)
		_:
			None

	selective_view ?= with_selective

	selective_duplicate = match module_view_register_graph_selective_trait_method(
		selective_view,
		first_id,
		definition_table,
		definition_table,
		"Shared",
		"first",
		"Trait",
		first_id,
		[],
	):
		SelectiveNameConflictsWithImportedName(binding):
			binding.module_path == "first" and binding.original_name == "Trait"
		_:
			False

	selective_alias_conflict = match module_view_register_module_alias_target(
		selective_view,
		table,
		first_id,
		"Shared",
		"second",
		table,
		second_id,
	):
		ModuleAliasConflictsWithImportedName(binding):
			binding.module_path == "first"
		_:
			False

	Some(
		(
			wrong_owner_selective
			and alias_duplicate
			and alias_conflict
			and selective_conflict
			and local_conflict
			and selective_duplicate
			and selective_alias_conflict
			and module_view_graph_bound_name_count(alias_view) == 1
			and module_view_import_bindings(alias_view).length() == 1
			and module_view_graph_bound_name_count(selective_view) == 1
			and module_view_import_bindings(selective_view).length() == 1
		),
	)


func test_graph_conflicts_leave_bound_rows_unchanged() -> Bool:
	graph_conflicts_leave_bound_rows_unchanged_result().get_or(False)


private pure func without_unqualified_names_keeps_canonical_alias_authority_result(

) -> Option[Bool]:
	definition_table ?= empty_definition_table()
	input: AcceptedAliasTableInput = {
		definition_table = definition_table,
		type_identities = [],
		transparent_aliases = [],
		opaque_aliases = []
	}

	result = match accepted_alias_table(input):
		Some(table):
			owner = module_identity_from_resolved(
				resolved_module_identity_from_resolver(
					"app/main",
					UserModule,
				),
			)
			authority = accepted_alias_authority(table, accepted_alias_empty_module_view())
			view = module_view_with_accepted_alias_authority(COMPILER_MODULE_VIEW_EMPTY, authority)

			match module_view_accepted_alias_authority(module_view_without_unqualified_names(view)):
				Some(canonical):
					canonical.visible_types_by_source_name.is_empty()
				None:
					False
		None:
			False

	Some(result)


func test_without_unqualified_names_keeps_canonical_alias_authority() -> Bool:
