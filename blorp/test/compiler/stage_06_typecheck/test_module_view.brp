func test_module_view_rejects_namespace_conflicts() -> Bool:
	with_alias = accepted_alias_view(COMPILER_MODULE_VIEW_EMPTY, "List", "list")
	with_name = accepted_selective_view(COMPILER_MODULE_VIEW_EMPTY, "map", "list", "map")

	match (with_alias, with_name):
		(Some(alias_view), Some(name_view)):
			alias_rebind_conflicts = match module_view_register_standalone_module_alias(
				alias_view,
				"List",
				"other/list",
			):
				ModuleAliasConflictsWithAlias(existing):
					existing == "list"
				_:
					False

			alias_name_conflicts = match module_view_register_selective_name(
				alias_view,
				"List",
				"other/list",
				"List",
			):
				SelectiveNameConflictsWithAlias(existing):
					existing == "list"
				_:
					False

			selective_alias_conflicts = match module_view_register_standalone_module_alias(
				name_view,
				"map",
				"other/list",
			):
				ModuleAliasConflictsWithImportedName(existing):
					existing.module_path == "list" and existing.original_name == "map"
				_:
					False

			selective_duplicate_conflicts = match module_view_register_selective_name(
				name_view,
				"map",
				"other/list",
				"other_map",
			):
				SelectiveNameConflictsWithImportedName(existing):
					existing.module_path == "list" and existing.original_name == "map"
				_:
					False

			(
				alias_rebind_conflicts
				and alias_name_conflicts
				and selective_alias_conflicts
				and selective_duplicate_conflicts
			)
		_:
			False


func test_same_module_alias_and_imported_name_can_coexist() -> Bool:
	match accepted_selective_view(COMPILER_MODULE_VIEW_EMPTY, "Dict", "dict", "Dict"):
		Some(with_name):
			match module_view_register_standalone_module_alias(with_name, "Dict", "dict"):
				ModuleAliasAdded(view):
					(
						module_view_find_standalone_module_alias(view, "Dict") == Some("dict")
						and module_view_find_imported_name(
							view,
							"Dict",
						).map(
							func(binding): binding.original_name,
						) == Some("Dict")
					)
				_:
					False
		None:
			False


func test_local_and_imported_names_cannot_coexist() -> Bool:
	local_result = module_view_register_local_name(
		COMPILER_MODULE_VIEW_EMPTY,
		"Widget",
		TopLevelType,
	)

	match local_result:
		LocalNameAdded(local_view):
			repeated_local = match module_view_register_local_name(
				local_view,
				"Widget",
				TopLevelFunction,
			):
				LocalNameAlreadyPresent(TopLevelType):
					True
				_:
					False

			alias_after_local = match module_view_register_standalone_module_alias(
				local_view,
				"Widget",
				"pkg/widget",
			):
				ModuleAliasConflictsWithLocalName(TopLevelType):
					True
				_:
					False

			selective_after_local = match module_view_register_selective_name(
				local_view,
				"Widget",
				"pkg/widget",
				"Widget",
			):
				SelectiveNameConflictsWithLocalName(TopLevelType):
					True
				_:
					False

			with_alias = accepted_alias_view(COMPILER_MODULE_VIEW_EMPTY, "Pkg", "pkg/widget")
			with_selective = accepted_selective_view(
				COMPILER_MODULE_VIEW_EMPTY,
				"ImportedWidget",
				"pkg/widget",
				"Widget",
			)

			reverse_alias_conflict = match with_alias:
				Some(view):
					match module_view_register_local_name(view, "Pkg", TopLevelType):
						LocalNameConflictsWithAlias(path):
							path == "pkg/widget"
						_:
							False
				None:
					False

			reverse_selective_conflict = match with_selective:
				Some(view):
					match module_view_register_local_name(view, "ImportedWidget", TopLevelType):
						LocalNameConflictsWithImportedName(binding):
							binding.module_path == "pkg/widget"
						_:
							False
				None:
					False

			(
				repeated_local
				and alias_after_local
				and selective_after_local
				and reverse_alias_conflict
				and reverse_selective_conflict
			)
		_:
			False


func test_clearing_unqualified_names_keeps_view_consistent() -> Bool:
	with_alias = accepted_alias_view(COMPILER_MODULE_VIEW_EMPTY, "List", "list")

	match with_alias:
		Some(alias_view):
			with_local = module_view_register_local_name(alias_view, "local_map", TopLevelFunction)

			match with_local:
				LocalNameAdded(local_view):
					with_name = accepted_selective_view(local_view, "map", "list", "map")

					match with_name:
						Some(view):
							cleared = module_view_without_unqualified_names(view)
							bindings = module_view_import_bindings(cleared)

							qualified_matches = match bindings.get(0):
								Some(StandaloneQualifiedModuleBinding(local_name, module_path)):
									local_name == "List" and module_path == "list"
								_:
									False

							(
								module_view_find_local_name(cleared, "local_map").is_none()
								and module_view_find_imported_name(cleared, "map").is_none()
								and module_view_find_standalone_module_alias(
									cleared,
									"List",
								) == Some("list")
								and bindings.length() == 1
								and qualified_matches
							)
						None:
							False
				_:
					False
		None:
			False


