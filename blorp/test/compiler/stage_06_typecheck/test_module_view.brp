private pure func graph_import_admission_publishes_once_result() -> Option[Bool]:
	scope ?= definition_backed_type_fixture(
		[
			{
				module_path = "dep",
				type_names = ["Token"]
			},
		],
	)
	module_table = prepared_module_scope_module_table(scope)
	module_id = prepared_module_scope_id(scope)
	definition_index = prepared_module_scope_definition_index(scope)
	definition_table = definition_backed_type_fixture_definition_table(scope)
	raw_id ?= definition_index_find_type_definition_id(
		definition_index,
		module_table,
		module_id,
		"Token",
	)
	definition_id ?= definition_table_definition_id(definition_table, raw_id)
	initial = module_view_for_graph(prepared_module_scope_graph_module_name_scope(scope))
	admission ?= graph_import_admission_begin(initial, module_table, module_id)

	selected = match graph_import_admission_register_selective_definition(
		admission,
		module_id,
		definition_table,
		definition_table,
		"Token",
		"dep",
		"Token",
		module_id,
		[definition_id],
	):
		GraphSelectiveAdded(next):
			Some(next)
		_:
			None

	with_selective ?= selected

	aliased = match graph_import_admission_register_alias(
		with_selective,
		module_table,
		module_id,
		"Token",
		"dep",
		module_table,
		module_id,
	):
		GraphModuleAliasAdded(next):
			Some(next)
		_:
			None

	with_both ?= aliased

	duplicate_alias = match graph_import_admission_register_alias(
		with_both,
		module_table,
		module_id,
		"Token",
		"dep",
		module_table,
		module_id,
	):
		GraphModuleAliasAlreadyPresent(_):
			True
		_:
			False

	duplicate_selective = match graph_import_admission_register_selective_definition(
		with_both,
		module_id,
		definition_table,
		definition_table,
		"Token",
		"dep",
		"Token",
		module_id,
		[definition_id],
	):
		GraphSelectiveConflictsWithImportedName(_, _):
			True
		_:
			False

	published = graph_import_admission_finish(with_both)
	bindings = module_view_import_bindings(published)

	first_is_selective = match bindings.get(0):
		Some(GraphSelectiveDefinitionBinding(name, target, _)):
			name == "Token" and module_ids_equal(target, module_id)
		_:
			False

	second_is_alias = match bindings.get(1):
		Some(GraphQualifiedModuleBinding(name, target)):
			name == "Token" and module_ids_equal(target, module_id)
		_:
			False

	Some(
		(
			module_view_graph_bound_name_count(initial) == 0
			and module_view_import_bindings(initial).is_empty()
			and module_view_graph_bound_name_count(published) == 1
			and module_view_has_selective_binding(published, "Token", "dep", "Token")
			and module_view_find_graph_module_alias(published, "Token") == Some(module_id)
			and bindings.length() == 2
			and first_is_selective
			and second_is_alias
			and duplicate_alias
			and duplicate_selective
		),
	)


func test_graph_import_admission_publishes_once() -> Bool:
	graph_import_admission_publishes_once_result().get_or(False)


private pure func graph_candidate_log_owns_order_and_outcomes_result() -> Option[Bool]:
	scope ?= definition_backed_type_fixture(
		[
			{
				module_path = "dep",
				type_names = ["Token"]
			},
		],
	)
	module_table = prepared_module_scope_module_table(scope)
	module_id = prepared_module_scope_id(scope)
	definition_index = prepared_module_scope_definition_index(scope)
	definition_table = definition_backed_type_fixture_definition_table(scope)
	raw_id ?= definition_index_find_type_definition_id(
		definition_index,
		module_table,
		module_id,
		"Token",
	)
	definition_id ?= definition_table_definition_id(definition_table, raw_id)
	initial = module_view_for_graph(
		graph_module_name_scope(
			graph_source_name_table(
				module_table,
				["Local", "Token"],
			),
			module_id,
		),
	)
	with_locals ?= module_view_bind_initial_graph_local_names(
		initial,
		module_table,
		module_id,
		[("Local", TopLevelFunction), ("Local", TopLevelType)],
	)
	admission ?= graph_import_admission_begin(with_locals, module_table, module_id)

	with_selective ?= match graph_import_admission_register_selective_definition(
		admission,
		module_id,
		definition_table,
		definition_table,
		"Token",
		"dep",
		"Token",
		module_id,
		[definition_id],
	):
		GraphSelectiveAdded(next):
			Some(next)
		_:
			None

	with_alias ?= match graph_import_admission_register_alias(
		with_selective,
		module_table,
		module_id,
		"Token",
		"dep",
		module_table,
		module_id,
	):
		GraphModuleAliasAdded(next):
			Some(next)
		_:
			None

	with_duplicate_alias ?= match graph_import_admission_register_alias(
		with_alias,
		module_table,
		module_id,
		"Token",
		"dep",
		module_table,
		module_id,
	):
		GraphModuleAliasAlreadyPresent(next):
			Some(next)
		_:
			None

	with_duplicate_selective ?= match graph_import_admission_register_selective_definition(
		with_duplicate_alias,
		module_id,
		definition_table,
		definition_table,
		"Token",
		"dep",
		"Token",
		module_id,
		[definition_id],
	):
		GraphSelectiveConflictsWithImportedName(next, _):
			Some(next)
		_:
			None

	published = graph_import_admission_finish(with_duplicate_selective)
	candidates = module_view_bound_candidates(published)

	local_first = match candidates.get(0):
		Some(BoundLocalNameAcceptedCandidate(row_id, "Local", TopLevelFunction)):
			bound_candidate_row_index(row_id) == 0
		_:
			False

	local_duplicate = match candidates.get(1):
		Some(BoundLocalNameAlreadyPresentCandidate(row_id, "Local", TopLevelType, winner_id)):
			bound_candidate_row_index(row_id) == 1 and bound_candidate_row_index(winner_id) == 0
		_:
			False

	selective_accepted = match candidates.get(2):
		Some(BoundSelectiveDefinitionAcceptedCandidate(row_id, "Token", _, _)):
			bound_candidate_row_index(row_id) == 2
		_:
			False

	alias_accepted = match candidates.get(3):
		Some(BoundQualifiedImportAcceptedCandidate(row_id, "Token", _)):
			bound_candidate_row_index(row_id) == 3
		_:
			False

	alias_duplicate = match candidates.get(4):
		Some(BoundQualifiedImportAlreadyPresentCandidate(row_id, "Token", _, winner_id)):
			bound_candidate_row_index(row_id) == 4 and bound_candidate_row_index(winner_id) == 3
		_:
			False

	selective_conflict = match candidates.get(5):
		Some(BoundSelectiveDefinitionSelectiveConflictCandidate(row_id, "Token", _, _, winner_id)):
			bound_candidate_row_index(row_id) == 5 and bound_candidate_row_index(winner_id) == 2
		_:
			False

	Some(
		(
			candidates.length() == 6
			and module_view_import_bindings(published).length() == 2
			and local_first
			and local_duplicate
			and selective_accepted
			and alias_accepted
			and alias_duplicate
			and selective_conflict
		),
	)


func test_graph_candidate_log_owns_order_and_outcomes() -> Bool:
	graph_candidate_log_owns_order_and_outcomes_result().get_or(False)


-- This low-level fixture uses a real constructor ID; the full source-level
-- and accepted-union join is also covered by the declaration suite.
private pure func graph_constructor_annotation_requires_admitted_name_result() -> Option[Bool]:
	scope ?= definition_backed_source_fixture("dep", "union Choice:\n\tDone")
	module_table = prepared_module_scope_module_table(scope)
	module_id = prepared_module_scope_id(scope)
	definition_index = prepared_module_scope_definition_index(scope)
	definition_table = definition_backed_type_fixture_definition_table(scope)
	constructor_ids ?= definition_index_constructor_definition_ids_for_export(
		definition_index,
		module_table,
		module_id,
		"Done",
		"Choice",
	)
	initial = module_view_for_graph(prepared_module_scope_graph_module_name_scope(scope))
	admission ?= graph_import_admission_begin(initial, module_table, module_id)
	binding: ImportedConstructorBinding = {
		local_name = "Done",
		module_path = "dep",
		parent_local_name = "Choice",
		parent_name = "Choice",
		original_name = "Done"
	}
	invalid_before_admission = graph_import_admission_record_constructor(
		admission,
		binding,
	).is_none()
	invalid_scalar_before_admission = module_view_record_imported_constructor(
		initial,
		binding,
	).is_none()

	wrong_constructor_target = match graph_import_admission_register_constructor(
		admission,
		module_id,
		definition_table,
		definition_table,
		{ binding | module_path = "other" },
		module_id,
		constructor_ids,
	):
		GraphSelectiveInvalidTarget(_):
			True
		_:
			False

	trait_selected = match graph_import_admission_register_selective_trait_method(
		admission,
		module_id,
		definition_table,
		definition_table,
		"Done",
		"dep",
		"Done",
		module_id,
		[],
	):
		GraphSelectiveAdded(next):
			Some(next)
		_:
			None

	trait_admission ?= trait_selected
	trait_annotation_rejected = graph_import_admission_record_constructor(
		trait_admission,
		binding,
	).is_none()

	selected = match graph_import_admission_register_selective_definition(
		admission,
		module_id,
		definition_table,
		definition_table,
		"Done",
		"dep",
		"Done",
		module_id,
		constructor_ids,
	):
		GraphSelectiveAdded(next):
			Some(next)
		_:
			None

	with_selective ?= selected
	annotated ?= graph_import_admission_record_constructor(with_selective, binding)

	with_alias = match graph_import_admission_register_alias(
		annotated,
		module_table,
		module_id,
		"Done",
		"dep",
		module_table,
		module_id,
	):
		GraphModuleAliasAdded(next):
			Some(next)
		_:
			None

	aliased ?= with_alias
	published = graph_import_admission_finish(aliased)
	qualified_only = module_view_without_unqualified_names(published)
	projected ?= module_view_imported_constructors(published).get(0)
	exact_constructor ?= module_view_accepted_constructor_bindings(published).get(0)
	exact_constructor_id ?= exact_constructor.definition_ids.get(0)
	expected_constructor_id ?= constructor_ids.get(0)

	first_alias = match graph_import_admission_register_alias(
		admission,
		module_table,
		module_id,
		"Done",
		"dep",
		module_table,
		module_id,
	):
		GraphModuleAliasAdded(next):
			Some(next)
		_:
			None

	alias_admission ?= first_alias

	second_selective = match graph_import_admission_register_constructor(
		alias_admission,
		module_id,
		definition_table,
		definition_table,
		binding,
		module_id,
		constructor_ids,
	):
		GraphSelectiveAdded(next):
			Some(next)
		_:
			None

	alias_then_constructor ?= second_selective

	duplicate_constructor_rejected = match graph_import_admission_register_constructor(
		alias_then_constructor,
		module_id,
		definition_table,
		definition_table,
		binding,
		module_id,
		constructor_ids,
	):
		GraphSelectiveConflictsWithImportedName(_, _):
			True
		_:
			False

	alias_first_view = graph_import_admission_finish(alias_then_constructor)
	alias_first_projected ?= module_view_imported_constructors(alias_first_view).get(0)
	Some(
		(
			invalid_before_admission
			and invalid_scalar_before_admission
			and wrong_constructor_target
			and duplicate_constructor_rejected
			and trait_annotation_rejected
			and module_view_imported_constructors(alias_first_view).length() == 1
			and alias_first_projected.parent_name == binding.parent_name
			and alias_first_projected.original_name == binding.original_name
			and module_view_imported_constructors(initial).is_empty()
			and module_view_imported_constructors(published).length() == 1
			and module_view_accepted_constructor_bindings(published).length() == 1
			and module_view_accepted_constructor_bindings(qualified_only).is_empty()
			and bound_candidate_row_index(exact_constructor.candidate_row_id) == 0
			and exact_constructor.local_name == binding.local_name
			and exact_constructor.parent_local_name == binding.parent_local_name
			and module_ids_equal(exact_constructor.module_id, module_id)
			and definition_ids_equal(exact_constructor_id, expected_constructor_id)
			and module_view_imported_constructors(qualified_only).is_empty()
			and module_view_find_graph_module_alias(published, "Done") == Some(module_id)
			and projected.local_name == binding.local_name
			and projected.module_path == binding.module_path
			and projected.parent_local_name == binding.parent_local_name
			and projected.parent_name == binding.parent_name
			and projected.original_name == binding.original_name
		),
	)


func test_graph_constructor_annotation_requires_admitted_name() -> Bool:
	graph_constructor_annotation_requires_admitted_name_result().get_or(False)


private pure func graph_import_admission_rejects_invalid_candidates_result() -> Option[Bool]:
	scope ?= definition_backed_type_fixture([
		{
			module_path = "dep",
			type_names = ["Token"]
		},
		{
			module_path = "other",
			type_names = ["Token"]
		},
	])
	foreign_scope ?= definition_backed_type_fixture([
		{
			module_path = "dep",
			type_names = ["Token"]
		},
		{
			module_path = "other",
			type_names = ["Token"]
		},
	])
	module_table = prepared_module_scope_module_table(scope)
	current_id = prepared_module_scope_id(scope)
	other_id ?= module_id_fixture_find(scope, "other")
	definition_index = prepared_module_scope_definition_index(scope)
	definition_table = definition_backed_type_fixture_definition_table(scope)
	other_raw_id ?= definition_index_find_type_definition_id(
		definition_index,
		module_table,
		other_id,
		"Token",
	)
	other_definition_id ?= definition_table_definition_id(definition_table, other_raw_id)
	view = module_view_for_graph(prepared_module_scope_graph_module_name_scope(scope))
	initial ?= graph_import_admission_begin(view, module_table, current_id)

	with_alias = match graph_import_admission_register_alias(
		initial,
		module_table,
		current_id,
		"Token",
		"dep",
		module_table,
		current_id,
	):
		GraphModuleAliasAdded(next):
			Some(next)
		_:
			None

	admission ?= with_alias

	after_other_target_conflict ?= match graph_import_admission_register_selective_definition(
		admission,
		current_id,
		definition_table,
		definition_table,
		"Token",
		"other",
		"Token",
		other_id,
		[other_definition_id],
	):
		GraphSelectiveConflictsWithAlias(next, _):
			Some(next)
		_:
			None

	after_uncataloged ?= match graph_import_admission_register_selective_definition(
		after_other_target_conflict,
		current_id,
		definition_table,
		definition_table,
		"Missing",
		"other",
		"Token",
		other_id,
		[other_definition_id],
	):
		GraphSelectiveInvalidSourceName(next):
			Some(next)
		_:
			None

	after_wrong_path ?= match graph_import_admission_register_selective_definition(
		after_uncataloged,
		current_id,
		definition_table,
		definition_table,
		"Token",
		"wrong/path",
		"Token",
		other_id,
		[other_definition_id],
	):
		GraphSelectiveInvalidTarget(next):
			Some(next)
		_:
			None

	foreign_table = definition_backed_type_fixture_definition_table(foreign_scope)

	after_foreign_provenance ?= match graph_import_admission_register_selective_definition(
		after_wrong_path,
		current_id,
		definition_table,
		foreign_table,
		"Token",
		"other",
		"Token",
		other_id,
		[other_definition_id],
	):
		GraphSelectiveInvalidTarget(next):
			Some(next)
		_:
			None

	published = graph_import_admission_finish(after_foreign_provenance)
	candidates = module_view_bound_candidates(published)

	alias_conflict = match candidates.get(1):
		Some(BoundSelectiveDefinitionAliasConflictCandidate(row_id, "Token", _, _, winner_id)):
			bound_candidate_row_index(row_id) == 1 and bound_candidate_row_index(winner_id) == 0
		_:
			False

	invalid_source = match candidates.get(2):
		Some(BoundSelectiveDefinitionInvalidSourceCandidate(row_id, "Missing", _, _)):
			bound_candidate_row_index(row_id) == 2
		_:
			False

	invalid_path = match candidates.get(3):
		Some(BoundSelectiveDefinitionInvalidTargetCandidate(row_id, "Token", _, _)):
			bound_candidate_row_index(row_id) == 3
		_:
			False

	invalid_provenance = match candidates.get(4):
		Some(BoundSelectiveDefinitionInvalidTargetCandidate(row_id, "Token", _, _)):
			bound_candidate_row_index(row_id) == 4
		_:
			False

	Some(
		(
			module_view_graph_bound_name_count(view) == 0
			and module_view_graph_bound_name_count(published) == 1
			and module_view_import_bindings(published).length() == 1
			and candidates.length() == 5
			and alias_conflict
			and invalid_source
			and invalid_path
			and invalid_provenance
			and module_view_find_graph_module_alias(published, "Token") == Some(current_id)
			and module_view_find_imported_name(published, "Token").is_none()
		),
	)


func test_graph_import_admission_rejects_invalid_candidates() -> Bool:
	graph_import_admission_rejects_invalid_candidates_result().get_or(False)


