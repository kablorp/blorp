func test_graph_local_name_has_one_bound_row_and_clears() -> Bool:
	match definition_backed_source_fixture("app/main", "func GraphLocal() -> Int: 1"):
		Some(scope):
			view = module_view_for_graph(prepared_module_scope_graph_module_name_scope(scope))

			match module_view_register_local_name_for_graph(
				view,
				prepared_module_scope_module_table(scope),
				prepared_module_scope_id(scope),
				"GraphLocal",
				TopLevelFunction,
			):
				LocalNameAdded(with_local):
					cleared = module_view_without_unqualified_names(with_local)

					(
						module_view_graph_bound_name_count(with_local) == 1
						and module_view_find_local_name(
							with_local,
							"GraphLocal",
						) == Some(TopLevelFunction)
						and module_view_graph_bound_name_count(cleared) == 0
						and module_view_find_local_name(cleared, "GraphLocal").is_none()
					)
				_:
					False
		None:
			False


func test_graph_local_names_span_wide_source_indexes_and_clear() -> Bool:
	match (
		definition_backed_type_fixture(
			[
				{
					module_path = "app/main",
					type_names = []
				},
			],
		)
	):
		None:
			False
		Some(scope):
			-- Forty names expose wide-index mistakes that one-row fixtures miss.
			var candidates: List[String] = []

			for index in 0..40:
				candidates = candidates.append("Local_" + index.to_string())

			table = prepared_module_scope_module_table(scope)
			module_id = prepared_module_scope_id(scope)
			var view = module_view_for_graph(
				graph_module_name_scope(
					graph_source_name_table(table, candidates),
					module_id,
				),
			)
			var registered_all: Bool = True

			for name in candidates:
				match module_view_register_local_name_for_graph(
					view,
					table,
					module_id,
					name,
					TopLevelFunction,
				):
					LocalNameAdded(next):
						view = next
					_:
						registered_all = False

			cleared = module_view_without_unqualified_names(view)

			(
				registered_all
				and module_view_graph_bound_name_count(view) == candidates.length()
				and module_view_find_local_name(view, "Local_31") == Some(TopLevelFunction)
				and module_view_find_local_name(view, "Local_32") == Some(TopLevelFunction)
				and module_view_graph_bound_name_count(cleared) == 0
				and module_view_find_local_name(cleared, "Local_31").is_none()
				and module_view_find_local_name(cleared, "Local_32").is_none()
			)


private pure func graph_binding_log_preserves_interleaved_admission_order_result() -> Option[Bool]:
	scope ?= definition_backed_type_fixture([
		{
			module_path = "app/main",
			type_names = []
		},
		{
			module_path = "dep/first",
			type_names = ["Token"]
		},
		{
			module_path = "dep/second",
			type_names = []
		},
	])
	table = prepared_module_scope_module_table(scope)
	current_id = prepared_module_scope_id(scope)
	first_id ?= module_id_fixture_find(scope, "dep/first")
	second_id ?= module_id_fixture_find(scope, "dep/second")
	definition_index = prepared_module_scope_definition_index(scope)
	definition_table = definition_backed_type_fixture_definition_table(scope)
	raw_id ?= definition_index_find_type_definition_id(definition_index, table, first_id, "Token")
	definition_id ?= definition_table_definition_id(definition_table, raw_id)
	initial = module_view_for_graph(
		graph_module_name_scope(
			graph_source_name_table(
				table,
				["Second", "Selected", "First", "Method", "Token", "method"],
			),
			current_id,
		),
	)

	first = match module_view_register_module_alias_target(
		initial,
		table,
		current_id,
		"First",
		"dep/first",
		table,
		first_id,
	):
		ModuleAliasAdded(view):
			Some(view)
		_:
			None

	first_view ?= first

	selected = match module_view_register_selective_name_for_graph(
		first_view,
		current_id,
		definition_table,
		definition_table,
		"Selected",
		"dep/first",
		"Token",
		first_id,
		[definition_id],
	):
		SelectiveNameAdded(view):
			Some(view)
		_:
			None

	selected_view ?= selected

	second = match module_view_register_module_alias_target(
		selected_view,
		table,
		current_id,
		"Second",
		"dep/second",
		table,
		second_id,
	):
		ModuleAliasAdded(view):
			Some(view)
		_:
			None

	second_view ?= second

	method = match module_view_register_graph_selective_trait_method(
		second_view,
		current_id,
		definition_table,
		definition_table,
		"Method",
		"dep/first",
		"method",
		first_id,
		[],
	):
		SelectiveNameAdded(view):
			Some(view)
		_:
			None

	method_view ?= method
	bindings = module_view_import_bindings(method_view)

	first_matches = match bindings.get(0):
		Some(GraphQualifiedModuleBinding(name, module_id)):
			name == "First" and module_ids_equal(module_id, first_id)
		_:
			False

	selected_matches = match bindings.get(1):
		Some(GraphSelectiveDefinitionBinding(name, module_id, ids)):
			name == "Selected" and module_ids_equal(module_id, first_id) and ids.length() == 1
		_:
			False

	second_matches = match bindings.get(2):
		Some(GraphQualifiedModuleBinding(name, module_id)):
			name == "Second" and module_ids_equal(module_id, second_id)
		_:
			False

	method_matches = match bindings.get(3):
		Some(GraphSelectiveTraitMethodBinding(name, module_id, source_name, ids)):
			(
				name == "Method"
				and module_ids_equal(module_id, first_id)
				and source_name == "method"
				and ids.is_empty()
			)
		_:
			False

	selected_names = module_view_imported_names(selected_view)
	second_names = module_view_imported_names(second_view)
	method_names = module_view_imported_names(method_view)
	Some((
			module_view_import_bindings(initial).is_empty()
			and module_view_imported_names(initial).is_empty()
			and module_view_import_bindings(first_view).length() == 1
			and module_view_imported_names(first_view).is_empty()
			and module_view_import_bindings(selected_view).length() == 2
			and selected_names.length() == 1
			and selected_names
				.get(0)
				.map(func(item):
					(
						item.local_name == "Selected"
						and item.module_path == "dep/first"
						and item.original_name == "Token"
					)
				)
				.get_or(False)
			and module_view_import_bindings(second_view).length() == 3
			and bindings.length() == 4
			and second_names.length() == 1
			and second_names
				.get(0)
				.map(func(item):
					(
						item.local_name == "Selected"
						and item.module_path == "dep/first"
						and item.original_name == "Token"
					)
				)
				.get_or(False)
			and method_names.length() == 2
			and method_names
				.get(0)
				.map(func(item):
					(
						item.local_name == "Selected"
						and item.module_path == "dep/first"
						and item.original_name == "Token"
					)
				)
				.get_or(False)
			and method_names
				.get(1)
				.map(func(item):
					(
						item.local_name == "Method"
						and item.module_path == "dep/first"
						and item.original_name == "method"
					)
				)
				.get_or(False)
			and first_matches
			and selected_matches
			and second_matches
			and method_matches
			and module_view_find_graph_module_alias(second_view, "First") == Some(first_id)
			and module_view_find_graph_module_alias(second_view, "Second") == Some(second_id)
		))


func test_graph_binding_log_preserves_interleaved_admission_order() -> Bool:
	graph_binding_log_preserves_interleaved_admission_order_result().get_or(False)


private pure func qualified_alias_resolution_requires_exact_view_owner_result() -> Option[Bool]:
	scope ?= definition_backed_type_fixture([
		{
			module_path = "app/main",
			type_names = []
		},
		{
			module_path = "dep/target",
			type_names = []
		},
	])
	table = prepared_module_scope_module_table(scope)
	current_id = prepared_module_scope_id(scope)
	target_id ?= module_id_fixture_find(scope, "dep/target")
	graph_names = graph_source_name_table(table, ["Target"])
	name_scope = graph_module_name_scope(graph_names, current_id)
	view = module_view_for_graph(name_scope)

	with_alias = match module_view_register_module_alias_target(
		view,
		table,
		current_id,
		"Target",
		"dep/target",
		table,
		target_id,
	):
		ModuleAliasAdded(next):
			Some(next)
		_:
			None

	alias_view ?= with_alias
	foreign_scope ?= definition_backed_type_fixture([
		{
			module_path = "app/main",
			type_names = []
		},
		{
			module_path = "dep/target",
			type_names = []
		},
	])
	foreign_table = prepared_module_scope_module_table(foreign_scope)
	source_type: SemanticType = SemanticNamedType("Target.Token", [])
	valid = resolve_graph_qualified_type_names(
		Some(graph_names),
		Some(current_id),
		alias_view,
		source_type,
	)
	sibling = resolve_graph_qualified_type_names(
		Some(graph_names),
		Some(target_id),
		alias_view,
		source_type,
	)
	foreign_resolution = resolve_graph_qualified_type_names(
		Some(prepared_module_scope_graph_source_name_table(foreign_scope)),
		Some(prepared_module_scope_id(foreign_scope)),
		alias_view,
		source_type,
	)
	reminted_resolution = resolve_graph_qualified_type_names(
		Some(graph_source_name_table(table, ["Target"])),
		Some(current_id),
		alias_view,
		source_type,
	)

	valid_matches = match valid:
		SemanticNamedType(name, args):
			name == canonical_module_type_name("dep/target", "Token") and args.is_empty()
		_:
			False

	Some(
		(
			valid_matches
			and sibling == source_type
			and foreign_resolution == source_type
			and reminted_resolution == source_type
		),
	)


func test_qualified_alias_resolution_requires_exact_view_owner() -> Bool:
	qualified_alias_resolution_requires_exact_view_owner_result().get_or(False)


func test_initial_graph_local_batch_publishes_one_immutable_view() -> Bool:
	match (
		definition_backed_type_fixture(
			[
				{
					module_path = "app/main",
					type_names = []
				},
			],
		)
	):
		None:
			False
		Some(scope):
			var source_names: List[String] = []
			var local_names: List[(String, TopLevelNameKind)] = []

			for index in 0..40:
				name = "Local_" + index.to_string()
				source_names = source_names.append(name)
				local_names = local_names.append((name, TopLevelFunction))

			local_names = local_names.append(("Local_31", TopLevelType))
			table = prepared_module_scope_module_table(scope)
			module_id = prepared_module_scope_id(scope)
			initial = module_view_for_graph(
				graph_module_name_scope(
					graph_source_name_table(table, source_names),
					module_id,
				),
			)

			match module_view_bind_initial_graph_local_names(
				initial,
				table,
				module_id,
				local_names,
			):
				Some(published):
					(
						module_view_graph_bound_name_count(initial) == 0
						and module_view_graph_bound_name_count(published) == 40
						and module_view_find_local_name(
							published,
							"Local_31",
						) == Some(TopLevelFunction)
						and module_view_find_local_name(
							published,
							"Local_32",
						) == Some(TopLevelFunction)
						and module_view_bind_initial_graph_local_names(
							published,
							table,
							module_id,
							local_names,
						).is_none()
						and module_view_bind_initial_graph_local_names(
							initial,
							table,
							module_id,
							local_names.append(("Missing", TopLevelFunction)),
						).is_none()
						and module_view_graph_bound_name_count(initial) == 0
					)
				None:
					False


private pure func graph_selective_then_alias_share_one_row_result() -> Option[Bool]:
	scope ?= definition_backed_type_fixture(
		[
			{
				module_path = "dep",
				type_names = ["Token"]
			},
		],
	)
	module_table = prepared_module_scope_module_table(scope)
	module_id = prepared_module_scope_id(scope)
	definition_index = prepared_module_scope_definition_index(scope)
	definition_table = definition_backed_type_fixture_definition_table(scope)
	raw_definition_id ?= definition_index_find_type_definition_id(
		definition_index,
		module_table,
		module_id,
		"Token",
	)
	definition_id ?= definition_table_definition_id(definition_table, raw_definition_id)
	view = module_view_for_graph(prepared_module_scope_graph_module_name_scope(scope))

	result = match module_view_register_selective_name_for_graph(
		view,
		module_id,
		definition_table,
		definition_table,
		"Token",
		"dep",
		"Token",
		module_id,
		[definition_id],
	):
		SelectiveNameAdded(with_selective):
			match module_view_register_module_alias_target(
				with_selective,
				module_table,
				module_id,
				"Token",
				"dep",
				module_table,
				module_id,
			):
				ModuleAliasAdded(with_both):
					cleared = module_view_without_unqualified_names(with_both)
					bindings = module_view_import_bindings(with_both)
					cleared_candidates = module_view_bound_candidates(cleared)

					selective_first = match bindings.get(0):
						Some(GraphSelectiveDefinitionBinding(name, target, ids)):
							matches_id = match ids.get(0):
								Some(id):
									definition_ids_equal(id, definition_id)
								None:
									False

							(
								name == "Token"
								and module_ids_equal(target, module_id)
								and ids.length() == 1
								and matches_id
							)
						_:
							False

					qualified_second = match bindings.get(1):
						Some(GraphQualifiedModuleBinding(name, target)):
							name == "Token" and module_ids_equal(target, module_id)
						_:
							False

					qualified_keeps_issued_row = match cleared_candidates.get(0):
						Some(BoundQualifiedImportAcceptedCandidate(row_id, name, target)):
							(
								bound_candidate_row_index(row_id) == 1
								and name == "Token"
								and module_ids_equal(target, module_id)
							)
						_:
							False

					(
						module_view_graph_bound_name_count(with_both) == 1
						and module_view_find_graph_module_alias(
							with_both,
							"Token",
						) == Some(module_id)
						and module_view_has_selective_binding(with_both, "Token", "dep", "Token")
						and bindings.length() == 2
						and selective_first
						and qualified_second
						and cleared_candidates.length() == 1
						and qualified_keeps_issued_row
						and module_view_graph_bound_name_count(cleared) == 1
						and module_view_find_graph_module_alias(cleared, "Token") == Some(module_id)
						and module_view_find_imported_name(cleared, "Token").is_none()
					)
				_:
					False
		_:
			False

	Some(result)


func test_graph_selective_then_alias_share_one_row() -> Bool:
