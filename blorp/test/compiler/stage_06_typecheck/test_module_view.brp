							False
					selective_second = match bindings.get(1):
						Some(GraphSelectiveDefinitionBinding(name, target, ids)):
							name == "Token" and module_ids_equal(target, module_id) and ids.length() == 1
						_:
							False
					(
						module_view_graph_bound_name_count(with_both) == 1
						and module_view_find_graph_module_alias(with_both, "Token") == Some(module_id)
						and module_view_has_selective_binding(with_both, "Token", "dep", "Token")
						and bindings.length() == 2
						and qualified_first
						and selective_second
