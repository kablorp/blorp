private pure func empty_definition_table() -> Option[DefinitionTable]:
	fixture ?= definition_backed_type_fixture(
		[
			{
				module_path = "app/main",
				type_names = []
			},
		],
	)
	Some(definition_backed_type_fixture_definition_table(fixture))


pure func accepted_alias_view(
	view: ModuleView,
	local_name: String,
	module_path: String,
) -> Option[ModuleView]:
	match module_view_register_standalone_module_alias(view, local_name, module_path):
		ModuleAliasAdded(next):
			Some(next)
		ModuleAliasAlreadyPresent:
			Some(view)
		_:
			None


pure func accepted_selective_view(
	view: ModuleView,
	local_name: String,
	module_path: String,
	source_name: String,
) -> Option[ModuleView]:
	match module_view_register_selective_name(view, local_name, module_path, source_name):
		SelectiveNameAdded(next):
			Some(next)
		_:
			None


func test_module_view_preserves_order_and_exact_indexes() -> Bool:
	with_alias = accepted_alias_view(COMPILER_MODULE_VIEW_EMPTY, "List", "list")

	match with_alias:
		Some(alias_view):
			with_name = accepted_selective_view(alias_view, "map", "list", "map")

			match with_name:
				Some(view):
					bindings = module_view_import_bindings(view)

					qualified_matches = match bindings.get(0):
						Some(StandaloneQualifiedModuleBinding(local_name, module_path)):
							local_name == "List" and module_path == "list"
						_:
							False

					selective_matches = match bindings.get(1):
						Some(StandaloneSelectiveDefinitionBinding(local_name, module_path, source_name)):
							local_name == "map" and module_path == "list" and source_name == "map"
						_:
							False

					(
						module_view_find_standalone_module_alias(view, "List") == Some("list")
						and module_view_find_imported_name(
							view,
							"map",
						).map(
							func(binding): binding.original_name,
						) == Some("map")
						and module_view_has_selective_binding(view, "map", "list", "map")
						and bindings.length() == 2
						and qualified_matches
						and selective_matches
					)
				None:
					False
		None:
			False


func test_module_view_preserves_imported_constructor_parent() -> Bool:
	binding: ImportedConstructorBinding = {
		local_name = "Done",
		module_path = "process",
		parent_local_name = "Exit",
		parent_name = "ProcessExit",
		original_name = "Exited"
	}
	view = module_view_record_imported_constructor(COMPILER_MODULE_VIEW_EMPTY, binding)

	module_view_imported_constructors(view) == [binding]


func test_fresh_graph_view_rejects_standalone_module_alias() -> Bool:
	view = module_view_for_graph(source_name_table(["GraphAlias"]))

	match module_view_register_standalone_module_alias(view, "Standalone", "pkg/standalone"):
		ModuleAliasInvalidTarget:
			(
				module_view_find_standalone_module_alias(view, "Standalone").is_none()
				and module_view_import_bindings(view).is_empty()
			)
		_:
			False


func test_fresh_graph_view_rejects_standalone_selective_name() -> Bool:
	view = module_view_for_graph(source_name_table(["GraphAlias"]))

	match module_view_register_selective_name(view, "map", "list", "map"):
		SelectiveNameInvalidTarget:
			(
				module_view_find_imported_name(view, "map").is_none()
				and module_view_import_bindings(view).is_empty()
			)
		_:
			False


func test_fresh_graph_view_rejects_standalone_local_name() -> Bool:
	view = module_view_for_graph(source_name_table(["GraphLocal"]))

	match module_view_register_local_name(view, "GraphLocal", TopLevelFunction):
		LocalNameInvalidSourceName:
			module_view_find_local_name(view, "GraphLocal").is_none()
		_:
			False


private pure func without_unqualified_names_keeps_canonical_alias_authority_result(

) -> Option[Bool]:
	definition_table ?= empty_definition_table()
	input: AcceptedAliasTableInput = {
		definition_table = definition_table,
		type_identities = [],
		transparent_aliases = [],
		opaque_aliases = []
	}

	result = match accepted_alias_table(input):
		Some(table):
			owner = module_identity_from_resolved(
				resolved_module_identity_from_resolver(
					"app/main",
					UserModule,
				),
			)
			authority = accepted_alias_authority(table, accepted_alias_empty_module_view())
			view = module_view_with_accepted_alias_authority(COMPILER_MODULE_VIEW_EMPTY, authority)

			match module_view_accepted_alias_authority(module_view_without_unqualified_names(view)):
				Some(canonical):
					canonical.visible_types_by_source_name.is_empty()
				None:
					False
		None:
			False

	Some(result)


func test_without_unqualified_names_keeps_canonical_alias_authority() -> Bool:
	without_unqualified_names_keeps_canonical_alias_authority_result().get_or(False)


private pure func without_unqualified_names_keeps_canonical_record_authority_result(

) -> Option[Bool]:
	definition_table ?= empty_definition_table()
	input: AcceptedRecordTableInput = {
		definition_table = definition_table,
		known_type_ids = [],
		records = []
	}

	result = match accepted_record_table(input):
		Some(table):
			owner = module_identity_from_resolved(
				resolved_module_identity_from_resolver(
					"app/main",
					UserModule,
				),
			)
			authority = accepted_record_authority(table, accepted_record_empty_module_view())
			view = module_view_with_accepted_record_authority(COMPILER_MODULE_VIEW_EMPTY, authority)

			module_view_accepted_record_authority(
				module_view_without_unqualified_names(view),
			).is_some()
		None:
			False

	Some(result)


func test_without_unqualified_names_keeps_canonical_record_authority() -> Bool:
	without_unqualified_names_keeps_canonical_record_authority_result().get_or(False)


private pure func without_unqualified_names_keeps_canonical_union_authority_result(

) -> Option[Bool]:
	definition_table ?= empty_definition_table()
	input: AcceptedUnionTableInput = {
		definition_table = definition_table,
		unions = []
	}
	identity_input: AcceptedAliasTableInput = {
		definition_table = definition_table,
		type_identities = [],
		transparent_aliases = [],
		opaque_aliases = []
	}

	accepted = match accepted_alias_table(identity_input):
		Some(type_identities):
			result = accepted_union_table(input, type_identities, ENV_EMPTY, [])

			match result:
				Ok(table):
					owner = module_identity_from_resolved(
						resolved_module_identity_from_resolver(
							"app/main",
							UserModule,
						),
					)
					authority = accepted_union_authority(table, accepted_union_empty_module_view())
					view = module_view_with_accepted_union_authority(
						COMPILER_MODULE_VIEW_EMPTY,
						authority,
					)

					module_view_accepted_union_authority(
						module_view_without_unqualified_names(view),
					).is_some()
				Err(_):
					False
		None:
			False

	Some(accepted)


func test_without_unqualified_names_keeps_canonical_union_authority() -> Bool:
	without_unqualified_names_keeps_canonical_union_authority_result().get_or(False)


func test_module_view_rejects_namespace_conflicts() -> Bool:
	with_alias = accepted_alias_view(COMPILER_MODULE_VIEW_EMPTY, "List", "list")
	with_name = accepted_selective_view(COMPILER_MODULE_VIEW_EMPTY, "map", "list", "map")

	match (with_alias, with_name):
		(Some(alias_view), Some(name_view)):
			alias_rebind_conflicts = match module_view_register_standalone_module_alias(
				alias_view,
				"List",
				"other/list",
			):
				ModuleAliasConflictsWithAlias(existing):
					existing == "list"
				_:
					False

			alias_name_conflicts = match module_view_register_selective_name(
				alias_view,
				"List",
				"other/list",
				"List",
			):
				SelectiveNameConflictsWithAlias(existing):
					existing == "list"
				_:
					False

			selective_alias_conflicts = match module_view_register_standalone_module_alias(
				name_view,
				"map",
				"other/list",
			):
				ModuleAliasConflictsWithImportedName(existing):
					existing.module_path == "list" and existing.original_name == "map"
				_:
					False

			selective_duplicate_conflicts = match module_view_register_selective_name(
				name_view,
				"map",
				"other/list",
				"other_map",
			):
				SelectiveNameConflictsWithImportedName(existing):
					existing.module_path == "list" and existing.original_name == "map"
				_:
					False

			(
				alias_rebind_conflicts
				and alias_name_conflicts
				and selective_alias_conflicts
				and selective_duplicate_conflicts
			)
		_:
			False


func test_same_module_alias_and_imported_name_can_coexist() -> Bool:
	match accepted_selective_view(COMPILER_MODULE_VIEW_EMPTY, "Dict", "dict", "Dict"):
		Some(with_name):
			match module_view_register_standalone_module_alias(with_name, "Dict", "dict"):
				ModuleAliasAdded(view):
					(
						module_view_find_standalone_module_alias(view, "Dict") == Some("dict")
						and module_view_find_imported_name(
							view,
							"Dict",
						).map(
							func(binding): binding.original_name,
						) == Some("Dict")
					)
				_:
					False
		None:
			False


func test_local_and_imported_names_cannot_coexist() -> Bool:
	local_result = module_view_register_local_name(
		COMPILER_MODULE_VIEW_EMPTY,
		"Widget",
		TopLevelType,
	)

	match local_result:
		LocalNameAdded(local_view):
			repeated_local = match module_view_register_local_name(
				local_view,
				"Widget",
				TopLevelFunction,
			):
				LocalNameAlreadyPresent(TopLevelType):
					True
				_:
					False

			alias_after_local = match module_view_register_standalone_module_alias(
				local_view,
				"Widget",
				"pkg/widget",
			):
				ModuleAliasConflictsWithLocalName(TopLevelType):
					True
				_:
					False

			selective_after_local = match module_view_register_selective_name(
				local_view,
				"Widget",
				"pkg/widget",
				"Widget",
			):
				SelectiveNameConflictsWithLocalName(TopLevelType):
					True
				_:
					False

			with_alias = accepted_alias_view(COMPILER_MODULE_VIEW_EMPTY, "Pkg", "pkg/widget")
			with_selective = accepted_selective_view(
				COMPILER_MODULE_VIEW_EMPTY,
				"ImportedWidget",
				"pkg/widget",
				"Widget",
			)

			reverse_alias_conflict = match with_alias:
				Some(view):
					match module_view_register_local_name(view, "Pkg", TopLevelType):
						LocalNameConflictsWithAlias(path):
							path == "pkg/widget"
						_:
							False
				None:
					False

			reverse_selective_conflict = match with_selective:
				Some(view):
					match module_view_register_local_name(view, "ImportedWidget", TopLevelType):
						LocalNameConflictsWithImportedName(binding):
							binding.module_path == "pkg/widget"
						_:
							False
				None:
					False

			(
				repeated_local
				and alias_after_local
				and selective_after_local
				and reverse_alias_conflict
				and reverse_selective_conflict
			)
		_:
			False


func test_clearing_unqualified_names_keeps_view_consistent() -> Bool:
	with_alias = accepted_alias_view(COMPILER_MODULE_VIEW_EMPTY, "List", "list")

	match with_alias:
		Some(alias_view):
			with_local = module_view_register_local_name(alias_view, "local_map", TopLevelFunction)

			match with_local:
				LocalNameAdded(local_view):
					with_name = accepted_selective_view(local_view, "map", "list", "map")

					match with_name:
						Some(view):
							cleared = module_view_without_unqualified_names(view)
							bindings = module_view_import_bindings(cleared)

							qualified_matches = match bindings.get(0):
								Some(StandaloneQualifiedModuleBinding(local_name, module_path)):
									local_name == "List" and module_path == "list"
								_:
									False

							(
								module_view_find_local_name(cleared, "local_map").is_none()
								and module_view_find_imported_name(cleared, "map").is_none()
								and module_view_find_standalone_module_alias(
									cleared,
									"List",
								) == Some("list")
								and bindings.length() == 1
								and qualified_matches
							)
						None:
							False
				_:
					False
		None:
			False


tests: TestSuite = {
	description = "Opaque compiler module view",
	tests = [
		("preserves order and exact indexes", test_module_view_preserves_order_and_exact_indexes),
		(
			"preserves imported constructor parent",
			test_module_view_preserves_imported_constructor_parent,
		),
		(
			"fresh graph view rejects standalone module alias",
			test_fresh_graph_view_rejects_standalone_module_alias,
		),
		(
			"fresh graph view rejects standalone selective name",
			test_fresh_graph_view_rejects_standalone_selective_name,
		),
		(
			"fresh graph view rejects standalone local name",
			test_fresh_graph_view_rejects_standalone_local_name,
		),
		(
			"clearing unqualified names keeps canonical alias authority",
			test_without_unqualified_names_keeps_canonical_alias_authority,
		),
		(
			"clearing unqualified names keeps canonical record authority",
			test_without_unqualified_names_keeps_canonical_record_authority,
		),
		(
			"clearing unqualified names keeps canonical union authority",
			test_without_unqualified_names_keeps_canonical_union_authority,
		),
		("rejects namespace conflicts", test_module_view_rejects_namespace_conflicts),
		(
			"same module alias and imported name can coexist",
			test_same_module_alias_and_imported_name_can_coexist,
		),
		("local and imported names cannot coexist", test_local_and_imported_names_cannot_coexist),
		(
			"clearing unqualified names keeps the view consistent",
			test_clearing_unqualified_names_keeps_view_consistent,
		),
	]
}
