import:
	../../../benchmark/compiler/compiler_implementation_method_skeleton_bucket_profile_fixture:
		CompilerImplementationMethodSkeletonBucketProfileConfig,
		compiler_implementation_method_skeleton_bucket_profile_execute,
		compiler_implementation_method_skeleton_bucket_profile_fixture,
		compiler_implementation_method_skeleton_bucket_profile_observe,
	test: TestSuite


private func test_profile_fixture_models_multi_implementation_workload() -> Bool:
	config: CompilerImplementationMethodSkeletonBucketProfileConfig = {
		implementation_count = 6,
		methods_per_implementation = 3,
		default_methods_per_implementation = 2,
		unrelated_callable_count = 10
	}

	match compiler_implementation_method_skeleton_bucket_profile_fixture(config):
		None:
			False
		Some(fixture):
			observation = compiler_implementation_method_skeleton_bucket_profile_observe(
				fixture,
				compiler_implementation_method_skeleton_bucket_profile_execute(fixture, 1),
			)

			(
				fixture.expected_methods_per_header == 6
				and fixture.expected_explicit_methods == 24
				and fixture.expected_default_methods == 12
				and observation.header_count == 6
				and observation.method_count == 36
				and observation.explicit_method_count == 24
				and observation.default_method_count == 12
				and observation.graph_ready
				and observation.workload_valid
			)


private func test_profile_fixture_supports_single_implementation_control() -> Bool:
	config: CompilerImplementationMethodSkeletonBucketProfileConfig = {
		implementation_count = 1,
		methods_per_implementation = 0,
		default_methods_per_implementation = 0,
		unrelated_callable_count = 0
	}

	match compiler_implementation_method_skeleton_bucket_profile_fixture(config):
		None:
			False
		Some(fixture):
			observation = compiler_implementation_method_skeleton_bucket_profile_observe(
				fixture,
				compiler_implementation_method_skeleton_bucket_profile_execute(fixture, 1),
			)

			(
				fixture.expected_methods_per_header == 1
				and observation.header_count == 1
				and observation.method_count == 1
				and observation.explicit_method_count == 1
				and observation.default_method_count == 0
				and observation.workload_valid
			)


private func test_profile_fixture_rejects_negative_configuration() -> Bool:
	config: CompilerImplementationMethodSkeletonBucketProfileConfig = {
		implementation_count = 0,
		methods_per_implementation = 0,
		default_methods_per_implementation = 0,
		unrelated_callable_count = 0
	}

	compiler_implementation_method_skeleton_bucket_profile_fixture(config).is_none()


tests: TestSuite = {
	description = "Compiler implementation method skeleton bucket profile benchmark",
	tests = [
		(
			"models multi-implementation workload",
			test_profile_fixture_models_multi_implementation_workload,
		),
		(
			"supports single implementation control",
			test_profile_fixture_supports_single_implementation_control,
		),
		(
			"rejects a non-positive implementation count",
			test_profile_fixture_rejects_negative_configuration,
		),
	]
}
