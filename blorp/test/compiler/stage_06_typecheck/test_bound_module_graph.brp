private pure func accepted_ctfe_artifact_uses_alias_authority() -> Option[Bool]:
	target = fixture_module_load_candidate(
		"main.brp",
		"main",
		"import:\n\tdependency: identity\n\nfunc main() -> Int: identity(1)",
	)
	dependency = fixture_module_load_candidate(
		"dependency.brp",
		"dependency",
		"type alias Wrapped[T] = T\n\npure func identity(value: Wrapped[Int]) -> Int: value",
	)
	indexed ?= indexed_graph_build(target, [dependency]).to_option()
	importable_graph = importable_module_graph(indexed)
	all_importable_index = importable_module_graph_all_index(importable_graph)
	bound ?= bound_module_graph_build(
		indexed,
		["dependency"],
		func(
			scope,
		): typecheck_bind_program_module_view(
			graph_state(scope),
			prepared_module_program(prepared_module_scope_module(scope)),
			all_importable_index,
			scope,
		),
	).to_option()
	headers ?= accepted_callable_headers(bound)
	dependency_scope ?= indexed_graph_module_scopes(indexed).get(0)
	accepted_graph ?= accepted_graph_for(headers, importable_graph)
	accepted_module ?= accepted_ctfe_artifact_typecheck_module(
		accepted_graph,
		dependency_scope,
		graph_state(dependency_scope),
	)
	result = typecheck_program_with_type_header_module_for_policy(accepted_module, IgnoreMainName)

	Some(
		(
			result.state.errors.is_empty()
			and module_view_accepted_alias_authority(result.state.module_view).is_some()
			and env_get_alias(result.state.env, "Wrapped").is_none()
		),
	)


func test_accepted_ctfe_artifact_uses_alias_authority() -> Bool:
	accepted_ctfe_artifact_uses_alias_authority().get_or(False)


private pure func diagnostic_matches_message_and_path(
	diagnostic: TypecheckDiagnostic,
	message: String,
	path: String,
) -> Bool:
	diagnostic.message == message and match diagnostic.span:
		Some(span):
			span.path == path
		None:
			False


private pure func cross_module_global_cycles_are_recoverable() -> Option[Bool]:
	target = fixture_module_load_candidate(
		"main.brp",
		"main",
		"import:\n\tdependency: dependency_value\n\nmain_value = dependency_value",
	)
	dependency = fixture_module_load_candidate(
		"dependency.brp",
		"dependency",
		"import:\n\tmain: main_value\n\ndependency_value = main_value",
	)
	indexed ?= indexed_graph_build(target, [dependency]).to_option()
	dependency_scope ?= indexed_graph_module_scopes(indexed).get(0)
	importable_graph = importable_module_graph(indexed)
	all_importable_index = importable_module_graph_all_index(importable_graph)
	bound ?= bound_module_graph_build(
		indexed,
		["dependency"],
		func(
			scope,
		): typecheck_bind_program_module_view(
			graph_state(scope),
			prepared_module_program(prepared_module_scope_module(scope)),
			all_importable_index,
			scope,
		),
	).to_option()
	headers ?= accepted_callable_headers(bound)
	expected = (
		"Cannot infer global initializer types because these globals form a cycle: "
		+ "dependency::dependency_value, main::main_value"
	)

	Some(
		match complete_typecheck_graph(headers, importable_graph, False):
			TypecheckGraphRecoverable(graph):
				target_diagnostics = recoverable_typecheck_graph_diagnostics_for_module(
					graph,
					prepared_module_scope_identity(indexed_graph_target_scope(indexed)),
				)
				dependency_diagnostics = recoverable_typecheck_graph_diagnostics_for_module(
					graph,
					prepared_module_scope_identity(dependency_scope),
				)

				(
					target_diagnostics.length() == 1
					and dependency_diagnostics.length() == 1
					and target_diagnostics.all(func(diagnostic):
						diagnostic_matches_message_and_path(diagnostic, expected, "main.brp")
					)
					and dependency_diagnostics.all(func(diagnostic):
						diagnostic_matches_message_and_path(diagnostic, expected, "dependency.brp")
					)
				)
			_:
				False
	)


func test_cross_module_global_cycles_are_recoverable() -> Bool:
	cross_module_global_cycles_are_recoverable().get_or(False)


private func build_and_release_bound_graph() -> Bool:
	match test_indexed_graph():
		None:
			False
		Some(indexed):
			match (
				bound_module_graph_build(
					indexed,
					["pkg/first", "pkg/second"],
					accept_empty_view,
				)
			):
				Err(_):
					False
				Ok(graph):
					bound_module_graph_modules(graph).length() == 2


private func build_and_release_bound_graph_inputs() -> Bool:
	match test_indexed_graph():
		Some(indexed):
			indexed_graph_module_scopes(indexed).length() == 2
		None:
			False


private func build_and_release_importable_graph() -> Bool:
	match test_indexed_graph():
		Some(indexed):
			graph = importable_module_graph(indexed)

			(
				importable_module_index_modules(
					importable_module_graph_all_index(graph),
				).length() == 3
				and importable_module_graph_dependencies(graph).length() == 2
			)
		None:
			False


func test_bound_graph_releases_owned_values() -> Bool:
	reset_mem_stats()
	inputs_built = build_and_release_bound_graph_inputs()
	input_stats = get_mem_stats()

	reset_mem_stats()
	built = build_and_release_bound_graph()
	stats = get_mem_stats()
	released = (
		stats.current_objects == input_stats.current_objects
		and stats.total_allocations - stats.total_releases == input_stats.total_allocations - input_stats.total_releases
	)

	if not released:
		print(
			"bound graph memory delta: input_current=" + input_stats.current_objects.to_string() + " graph_current=" + stats.current_objects.to_string() + " input_net=" + (input_stats.total_allocations - input_stats.total_releases).to_string() + " graph_net=" + (stats.total_allocations - stats.total_releases).to_string(),
		)

	inputs_built and built and released


func test_importable_graph_releases_owned_values() -> Bool:
	reset_mem_stats()
	inputs_built = build_and_release_bound_graph_inputs()
	input_stats = get_mem_stats()

	reset_mem_stats()
	built = build_and_release_importable_graph()
	stats = get_mem_stats()
	released = (
		stats.current_objects == input_stats.current_objects
		and stats.total_allocations - stats.total_releases == input_stats.total_allocations - input_stats.total_releases
	)

	if not released:
		print(
			"importable graph memory delta: input_current=" + input_stats.current_objects.to_string() + " graph_current=" + stats.current_objects.to_string() + " input_net=" + (input_stats.total_allocations - input_stats.total_releases).to_string() + " graph_net=" + (stats.total_allocations - stats.total_releases).to_string(),
		)

	inputs_built and built and released


tests: TestSuite = {
	description = "Compiler bound module graph",
	tests = [
		(
			"preserves order and exact identity lookup",
			test_bound_graph_preserves_order_and_exact_identity_lookup,
		),
		(
			"selects exact modules by compatible prepared scope",
			test_bound_graph_selects_exact_modules_by_prepared_scope,
		),
		(
			"rejects all modules in deterministic order",
			test_bound_graph_rejects_all_modules_in_deterministic_order,
		),
		(
			"rejects invalid selection before binding",
			test_bound_graph_rejects_invalid_selection_before_binding,
		),
		(
			"visibility rejects invalid relationships",
			test_bound_module_visibility_rejects_invalid_relationships,
		),
		(
			"visibility rejects IDs issued by another graph",
			test_bound_module_visibility_rejects_foreign_module_ids,
		),
		(
			"visibility rejects IDs issued by a separately built equal graph",
			test_bound_module_visibility_rejects_separately_issued_equal_graph,
		),
		(
			"visibility rejects a direct ID issued by another graph",
			test_bound_module_visibility_rejects_foreign_direct_module_id,
		),
		(
			"preserves recoverable binding diagnostics",
			test_bound_graph_preserves_recoverable_binding_diagnostics,
		),
		(
			"requires every prepared module to be bound",
			test_bound_graph_requires_every_prepared_module_to_be_bound,
		),
		(
			"reuses completed binding for typecheck",
			test_bound_graph_reuses_completed_binding_for_typecheck,
		),
		(
			"partial bound graph completes only bound modules",
			test_partial_bound_graph_completes_only_bound_modules,
		),
		(
			"accepted graph rejects unowned module or state",
			test_accepted_graph_rejects_unowned_module_or_state,
		),
		(
			"publishes one coherent accepted semantic catalog",
			test_accepted_graph_publishes_semantic_catalog,
		),
		(
			"recovery dependency has no semantic inventory",
			test_recovery_dependency_has_no_semantic_inventory,
		),
		(
			"CTFE artifact binding excludes target imports",
			test_ctfe_artifact_binding_excludes_target,
		),
		(
			"CTFE artifact binding excludes target aliases",
			test_ctfe_artifact_binding_excludes_target_alias,
		),
		(
			"accepted CTFE artifact uses alias authority",
			test_accepted_ctfe_artifact_uses_alias_authority,
		),
		(
			"cross-module global cycles are recoverable",
			test_cross_module_global_cycles_are_recoverable,
		),
		("releases owned values", test_bound_graph_releases_owned_values),
		("importable graph releases owned values", test_importable_graph_releases_owned_values),
	]
}
