import:
	../../../benchmark/compiler/compiler_frontend_declaration_catalog_profile_fixture:
		CompilerFrontendDeclarationCatalogProfileConfig,
		FrontendDeclarationCatalogGraphShape(
			FrontendCatalogChainGraph,
			FrontendCatalogDenseGraph,
			FrontendCatalogLayeredGraph,
			FrontendCatalogStarGraph,
		),
		compiler_frontend_declaration_catalog_profile,
	test: TestSuite


private pure func config(
	shape: FrontendDeclarationCatalogGraphShape,
	module_count: Int,
	import_fanout: Int,
	body_count_per_module: Int,
) -> CompilerFrontendDeclarationCatalogProfileConfig:
	{
		iterations = 1,
		module_count = module_count,
		declarations_per_module = 8,
		import_fanout = import_fanout,
		graph_shape = shape,
		body_count_per_module = body_count_per_module,
		ctfe_body_selection = False
	}


private fixed record CanonicalGraphRow {
	shape_id: Int,
	module_count: Int,
	import_fanout: Int
}


private func test_category_denominators_are_canonical() -> Bool:
	result = compiler_frontend_declaration_catalog_profile(
		config(
			FrontendCatalogChainGraph,
			4,
			1,
			0,
		),
	)
	observation = result.canonical_observation

	(
		result.workload_valid
		and result.setup_error_count == 0
		and observation.error_count == 0
		and observation.unique_graph_declarations == observation.unique_type_declarations + observation.unique_constructors + observation.unique_fields + observation.unique_callables + observation.unique_globals + observation.unique_traits + observation.unique_implementations
		and observation.unique_type_declarations > 0
		and observation.unique_constructors > 0
		and observation.unique_fields > 0
		and observation.unique_callables > 0
		and observation.unique_globals > 0
		and observation.unique_traits > 0
		and observation.unique_implementations > 0
	)


private func test_ctfe_artifact_and_initializer_rows_are_separate() -> Bool:
	module_count = 3
	result = compiler_frontend_declaration_catalog_profile(
		config(
			FrontendCatalogChainGraph,
			module_count,
			1,
			1,
		),
	)

	(
		result.workload_valid
		and result.initializer_observation.accepted_modules_prepared == module_count + 1
		and result.initializer_observation.error_count == 0
		and result.ctfe_artifact_observation.accepted_modules_prepared == module_count
		and result.ctfe_artifact_observation.error_count == 0
		and result.canonical_observation.error_count == 0
		and result.canonical_observation.unique_type_declarations > result.ctfe_artifact_observation.unique_type_declarations
		and result.canonical_observation.unique_constructors > result.ctfe_artifact_observation.unique_constructors
		and result.canonical_observation.unique_fields > result.ctfe_artifact_observation.unique_fields
		and result.canonical_observation.unique_callables > result.ctfe_artifact_observation.unique_callables
		and result.canonical_observation.unique_globals > result.ctfe_artifact_observation.unique_globals
		and result.canonical_observation.unique_traits > result.ctfe_artifact_observation.unique_traits
		and result.canonical_observation.unique_implementations > result.ctfe_artifact_observation.unique_implementations
		and result.canonical_observation.unique_graph_declarations > result.ctfe_artifact_observation.unique_graph_declarations
		and result.ctfe_artifact_observation.checksum != result.canonical_observation.checksum
	)


private func test_canonical_module_bases_are_reused_for_body_preparation() -> Bool:
	body_counts = [0, 1, 8, 32]
	shapes = [FrontendCatalogChainGraph, FrontendCatalogDenseGraph]
	var valid: Bool = True

	for shape in shapes:
		var baseline_body_sessions: Int = 0

		for body_count in body_counts:
			result = compiler_frontend_declaration_catalog_profile(config(shape, 4, 4, body_count))
			canonical = result.canonical_observation
			initializer = result.initializer_observation

			if body_count == 0:
				baseline_body_sessions = canonical.body_sessions_created

			if (
				not result.workload_valid
				or canonical.canonical_module_base_builds != canonical.accepted_modules_prepared
				or initializer.canonical_module_base_builds != initializer.accepted_modules_prepared
				or canonical.body_sessions_created != baseline_body_sessions + 4 * body_count
			):
				valid = False

	valid


private func test_shape_dimensions_are_consistent() -> Bool:
	rows = [
		{ shape_id = 0, module_count = 4, import_fanout = 1 },
		{ shape_id = 1, module_count = 8, import_fanout = 1 },
		{ shape_id = 2, module_count = 8, import_fanout = 8 },
		{ shape_id = 3, module_count = 4, import_fanout = 2 },
	]
	var valid: Bool = True

	for row in rows:
		shape = match row.shape_id:
			0:
				FrontendCatalogChainGraph
			1:
				FrontendCatalogStarGraph
			2:
				FrontendCatalogDenseGraph
			_:
				FrontendCatalogLayeredGraph

		result = compiler_frontend_declaration_catalog_profile(
			config(
				shape,
				row.module_count,
				row.import_fanout,
				0,
			),
		)
		observation = result.initializer_observation

		if (
			not result.workload_valid
			or observation.error_count != 0
			or observation.accepted_modules_prepared != row.module_count + 1
			or observation.body_contexts_created != observation.accepted_modules_prepared
			or observation.direct_module_edges < row.module_count
			or observation.visible_module_edges < observation.direct_module_edges
		):
			valid = False

	valid


tests: TestSuite = {
	description = "Compiler frontend declaration catalog profile benchmark",
	tests = [
		("category denominators are canonical", test_category_denominators_are_canonical),
		(
			"CTFE artifact and initializer rows are separate",
			test_ctfe_artifact_and_initializer_rows_are_separate,
		),
		(
			"canonical module bases are reused for body preparation",
			test_canonical_module_bases_are_reused_for_body_preparation,
		),
		("shape dimensions are consistent", test_shape_dimensions_are_consistent),
	]
}
