import:
	../../../benchmark/compiler/compiler_frontend_declaration_catalog_profile_fixture:
		CompilerFrontendDeclarationCatalogProfileConfig,
		FrontendDeclarationCatalogGraphShape(
			FrontendCatalogChainGraph,
			FrontendCatalogDenseGraph,
			FrontendCatalogLayeredGraph,
			FrontendCatalogStarGraph,
		),
		compiler_frontend_declaration_catalog_profile,
		compiler_frontend_declaration_catalog_profile_representation_model,
	../../../src/compiler/stage_06_typecheck/decl: frontend_preparation_initializer_error_count
	test: TestSuite


private pure func config(
	shape: FrontendDeclarationCatalogGraphShape,
	module_count: Int,
	import_fanout: Int,
	body_count_per_module: Int,
) -> CompilerFrontendDeclarationCatalogProfileConfig:
	{
		iterations = 1,
		module_count = module_count,
		declarations_per_module = 8,
		import_fanout = import_fanout,
		graph_shape = shape,
		body_count_per_module = body_count_per_module,
		ctfe_body_selection = False
	}


private struct ExpectedCanonicalGraphRow {
	shape_id: Int,
	module_count: Int,
	import_fanout: Int,
	expected_modules_prepared: Int,
	expected_visible_edges: Int,
	expected_direct_edges: Int
}


private func test_category_denominators_are_canonical() -> Bool:
	result = compiler_frontend_declaration_catalog_profile(
		config(
			FrontendCatalogChainGraph,
			4,
			1,
			0,
		),
	)
	observation = result.canonical_observation

	(
		result.workload_valid
		and result.setup_error_count == 0
		and observation.error_count == 0
		and observation.unique_graph_declarations == observation.unique_type_declarations + observation.unique_constructors + observation.unique_callables + observation.unique_globals + observation.unique_traits + observation.unique_implementations
		and observation.unique_type_declarations > 0
		and observation.unique_constructors > 0
		and observation.unique_callables > 0
		and observation.unique_globals > 0
		and observation.unique_traits > 0
		and observation.unique_implementations > 0
		and observation.total_graph_declaration_installations == 0
		and observation.environment_publications == 0
		and observation.body_checks_started == 0
		and frontend_preparation_initializer_error_count(0, 1) == 1
	)


private func test_ctfe_artifact_and_initializer_rows_are_separate() -> Bool:
	result = compiler_frontend_declaration_catalog_profile(
		config(
			FrontendCatalogChainGraph,
			3,
			1,
			1,
		),
	)
	(
		result.workload_valid
		and result.initializer_observation.accepted_modules_prepared == 4
		and result.initializer_observation.error_count == 0
		and result.ctfe_artifact_observation.accepted_modules_prepared == 3
		and result.ctfe_artifact_observation.error_count == 0
		and result.canonical_observation.error_count == 0
		and result.canonical_observation.unique_type_declarations == result.ctfe_artifact_observation.unique_type_declarations + 2
		and result.canonical_observation.unique_constructors == result.ctfe_artifact_observation.unique_constructors + 2
		and result.canonical_observation.unique_callables == result.ctfe_artifact_observation.unique_callables + 4
		and result.canonical_observation.unique_globals == result.ctfe_artifact_observation.unique_globals + 1
		and result.canonical_observation.unique_traits == result.ctfe_artifact_observation.unique_traits + 1
		and result.canonical_observation.unique_implementations == result.ctfe_artifact_observation.unique_implementations + 1
		and result.canonical_observation.unique_graph_declarations == result.ctfe_artifact_observation.unique_graph_declarations + 11
		and result.ctfe_artifact_observation.checksum != result.canonical_observation.checksum
	)


private func test_canonical_module_bases_are_reused_for_body_preparation() -> Bool:
	body_counts = [0, 1, 8, 32]
	shapes = [FrontendCatalogChainGraph, FrontendCatalogDenseGraph]
	var valid: Bool = True

	for shape in shapes:
		var baseline_body_sessions: Int = 0

		for body_count in body_counts:
			result = compiler_frontend_declaration_catalog_profile(
				config(shape, 4, 4, body_count),
			)
			canonical = result.canonical_observation
			initializer = result.initializer_observation

			if body_count == 0:
				baseline_body_sessions = canonical.body_sessions_created

			if (
				not result.workload_valid
				or canonical.canonical_module_base_builds != canonical.accepted_modules_prepared
				or initializer.canonical_module_base_builds != initializer.accepted_modules_prepared
				or canonical.ordinary_body_environment_rebuilds != 0
				or canonical.body_sessions_created != baseline_body_sessions + 4 * body_count
			):
				valid = False

	valid


private func test_shape_dimensions_and_direct_api_model_are_exact() -> Bool:
	rows = [
		{
			shape_id = 0,
			module_count = 4,
			import_fanout = 1,
			expected_modules_prepared = 5,
			expected_visible_edges = 10,
			expected_direct_edges = 7
		},
		{
			shape_id = 1,
			module_count = 8,
			import_fanout = 1,
			expected_modules_prepared = 9,
			expected_visible_edges = 8,
			expected_direct_edges = 8
		},
		{
			shape_id = 2,
			module_count = 8,
			import_fanout = 8,
			expected_modules_prepared = 9,
			expected_visible_edges = 36,
			expected_direct_edges = 36
		},
		{
			shape_id = 3,
			module_count = 4,
			import_fanout = 2,
			expected_modules_prepared = 5,
			expected_visible_edges = 10,
			expected_direct_edges = 9
		},
	]
	var valid: Bool = True

	for row in rows:
		shape = match row.shape_id:
			0:
				FrontendCatalogChainGraph
			1:
				FrontendCatalogStarGraph
			2:
				FrontendCatalogDenseGraph
			_:
				FrontendCatalogLayeredGraph

		result = compiler_frontend_declaration_catalog_profile(
			config(
				shape,
				row.module_count,
				row.import_fanout,
				0,
			),
		)
		observation = result.initializer_observation

		if (
			not result.workload_valid
			or observation.error_count != 0
			or observation.accepted_modules_prepared != row.expected_modules_prepared
			or observation.body_contexts_created != row.expected_modules_prepared
			or observation.visible_module_edges != row.expected_visible_edges
			or observation.direct_module_edges != row.expected_direct_edges
		):
			valid = False

	model = compiler_frontend_declaration_catalog_profile_representation_model()

	(
		valid
		and model.workload_valid
		and model.expected_scope_update_windows == 4
		and model.expected_symbols_appended == 8
		and model.expected_env_values_published == 9
		and model.expected_index_entries == 9
		and model.expected_auxiliary_publications == 6
		and model.semantic_checksum != 0
	)


tests: TestSuite = {
	description = "Compiler frontend declaration catalog profile benchmark",
	tests = [
		("category denominators are canonical", test_category_denominators_are_canonical),
		(
			"CTFE artifact and initializer rows are separate",
			test_ctfe_artifact_and_initializer_rows_are_separate,
		),
		(
			"canonical module bases are reused for body preparation",
			test_canonical_module_bases_are_reused_for_body_preparation,
		),
		(
			"shape dimensions and direct API model are exact",
			test_shape_dimensions_and_direct_api_model_are_exact,
		),
	]
}
