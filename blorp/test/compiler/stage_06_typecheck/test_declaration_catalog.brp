			"retained record authority has one table and compact views",
			test_retained_record_authority_has_one_table_and_compact_views,
		),
		(
			"retained union authority has one table and compact views",
			test_retained_union_authority_has_one_table_and_compact_views,
		),
		(
			"retained global authority has completed entries and no legacy work",
			test_retained_global_authority_has_completed_entries_and_no_legacy_work,
		),
		(
			"retained callable authority has one entry per header and no legacy work",
			test_retained_callable_authority_has_one_entry_per_header_and_no_legacy_work,
		),
		((
				"retained trait and implementation authority has one entry per header and no "
				+ "legacy work"
			), test_retained_trait_implementation_authority_has_one_entry_per_header_and_no_legacy_work),
		(
			"accepted callable table rejects mismatched name and owner",
