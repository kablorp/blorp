private pure func fixture_callable_table_record() -> Option[AcceptedCallableTableRecord]:
	fixture ?= catalog_fixture()
	graph = compiler_typecheck_phase_profile_fixture_accepted_graph(fixture)
	header ?= callable_header_graph_callables(
		implementation_header_graph_callable_headers(
			accepted_typecheck_graph_implementation_headers(graph),
		),
	).get(0)
	id = callable_header_id(header)
	module_path = module_identity_display_name(callable_id_module_identity(id))
	entry: OverloadEntry = {
		def_id = callable_id_definition_id(id),
		func_type = SemanticFunctionType(True, [], TYPE_INT),
		type_params = [],
		param_names = [],
		purity = Pure,
		origin = UserDefinedFunc,
		resource_args = RejectResourceArgs,
		module_path = Some(module_path),
		dim_constraints = [],
		loop_producer = None,
		debug_only = False
	}

	Some({
		id = id,
		owner_module_path = module_path,
		source_name = callable_id_name(id),
		visibility = PublicDeclaration,
		entry = entry,
	})


private pure func accepted_callable_table_rejects_mismatched_name_and_owner() -> Option[Bool]:
	item ?= fixture_callable_table_record()
	wrong_path = "not/the/callable/owner"

	Some(
		(
			accepted_callable_table({callables = [item]}).is_some()
			and accepted_callable_table(
				{callables = [{ item | source_name = "not_the_callable_name" }]},
			).is_none()
			and accepted_callable_table(
				{callables = [
						{ item |
							owner_module_path = wrong_path,
							entry = { item.entry | module_path = Some(wrong_path) }
						},
					]},
			).is_none()
		),
	)


func test_accepted_callable_table_rejects_mismatched_name_and_owner() -> Bool:
	accepted_callable_table_rejects_mismatched_name_and_owner().get_or(False)


private pure func accepted_callable_owner_query_localizes_canonical_types() -> Option[Bool]:
	item ?= fixture_callable_table_record()
	module_path = item.owner_module_path
	canonical_type = SemanticNamedType(
		canonical_module_type_name(module_path, "OwnerType"),
		[],
	)
	entry = { item.entry |
		func_type = SemanticFunctionType(True, [canonical_type], canonical_type)
	}
	canonical_item = { item | entry = entry }
	table ?= accepted_callable_table({callables = [canonical_item]})
	authority ?= accepted_callable_authority(table, callable_id_module_identity(item.id), [], [])
	result ?= accepted_callable_find_exact(authority, item.id)

	Some(result.module_path.is_none() and types_equal(
			result.func_type,
			SemanticFunctionType(
				True,
				[SemanticNamedType("OwnerType", [])],
				SemanticNamedType("OwnerType", []),
			),
		))


func test_accepted_callable_owner_query_localizes_canonical_types() -> Bool:
	accepted_callable_owner_query_localizes_canonical_types().get_or(False)


private pure func accepted_callable_foreign_exact_query_preserves_canonical_types() -> Option[Bool]:
	item ?= fixture_callable_table_record()
	module_path = item.owner_module_path
	canonical_type = SemanticNamedType(
		canonical_module_type_name(module_path, "OwnerType"),
		[],
	)
	entry = { item.entry |
		func_type = SemanticFunctionType(True, [canonical_type], canonical_type)
	}
	canonical_item = { item | entry = entry }
	table ?= accepted_callable_table({callables = [canonical_item]})
	foreign_authority ?= accepted_callable_authority(table, ANONYMOUS_IDENTITY, [], [])
	result ?= accepted_callable_find_exact(foreign_authority, item.id)

	Some(result.module_path == Some(module_path) and types_equal(result.func_type, entry.func_type))


func test_accepted_callable_foreign_exact_query_preserves_canonical_types() -> Bool:
	accepted_callable_foreign_exact_query_preserves_canonical_types().get_or(False)


private pure func accepted_global_authority_availability_is_exact() -> Option[Bool]:
	fixture ?= catalog_fixture()
	graph = compiler_typecheck_phase_profile_fixture_accepted_graph(fixture)
	global_ids ?= two_globals_from_different_modules(graph)
	(first_id, second_id) = global_ids
	table ?= accepted_global_table(
		{globals = [
				{
					id = first_id,
					owner_module_path = "first",
					visibility = PublicDeclaration,
					declared_binding = Some(accepted_global_binding(first_id))
				},
				{
					id = second_id,
					owner_module_path = "second",
					visibility = PublicDeclaration,
					declared_binding = None
				},
			]},
	)
	authority ?= accepted_global_authority(
		table,
		global_id_module_identity(first_id),
		[
			{
				source_name = "imported",
				owner_module_path = "second",
				original_name = global_id_name(second_id)
			},
		],
	)
	completed_binding = accepted_global_binding(second_id)
	completed_table ?= accepted_global_table_complete(table, [completed_binding])
	initializer = accepted_global_authority_for_initializer(authority, [completed_binding])
	ordinary = accepted_global_authority_with_completed_table(authority, completed_table)
	hidden = accepted_global_authority_without_visible_names(initializer)
	callable ?= callable_header_graph_callables(
		implementation_header_graph_callable_headers(
			accepted_typecheck_graph_implementation_headers(graph),
		),
	).get(0)

	initial_exact_missing = match accepted_global_exact(
		authority,
		GlobalDeclarationId(second_id),
	).lookup:
		AcceptedGlobalExactMissing:
			True
		_:
			False

	initializer_exact_found = match accepted_global_exact(
		initializer,
		GlobalDeclarationId(second_id),
	).lookup:
		AcceptedGlobalExactFound(binding):
			types_equal(binding.binding_type, TYPE_INT)
		_:
			False

	wrong_kind = match accepted_global_exact(
		authority,
		CallableDeclarationId(callable_header_id(callable)),
	).lookup:
		AcceptedGlobalExactWrongKind(_):
			True
		_:
			False

	Some(
		(
			accepted_global_find(authority, global_id_name(first_id)).is_none()
			and accepted_global_find(initializer, global_id_name(first_id)).is_some()
			and accepted_global_find(initializer, "imported").is_some()
			and accepted_global_find(ordinary, global_id_name(first_id)).is_none()
			and accepted_global_find(ordinary, "imported").is_some()
			and accepted_global_find(hidden, global_id_name(first_id)).is_none()
			and accepted_global_find(hidden, "imported").is_none()
			and initial_exact_missing
			and initializer_exact_found
			and wrong_kind
		),
	)


func test_accepted_global_authority_availability_is_exact() -> Bool:
	accepted_global_authority_availability_is_exact().get_or(False)


private pure func accepted_global_table_rejects_duplicate_completion() -> Option[Bool]:
	fixture ?= catalog_fixture()
	graph = compiler_typecheck_phase_profile_fixture_accepted_graph(fixture)
	global_ids ?= two_globals_from_different_modules(graph)
	(first_id, _) = global_ids
	table ?= accepted_global_table(
		{globals = [
				{
					id = first_id,
					owner_module_path = "first",
					visibility = PublicDeclaration,
					declared_binding = Some(accepted_global_binding(first_id))
				},
			]},
	)
	binding = accepted_global_binding(first_id)

	Some(accepted_global_table_complete(
			table,
			[binding, binding],
		).is_none())


func test_accepted_global_table_rejects_duplicate_completion() -> Bool:
	accepted_global_table_rejects_duplicate_completion().get_or(False)


private pure func accepted_global_module_view_rejects_private_import() -> Option[Bool]:
	fixture ?= catalog_fixture()
	graph = compiler_typecheck_phase_profile_fixture_accepted_graph(fixture)
	global_ids ?= two_globals_from_different_modules(graph)
	(first_id, second_id) = global_ids
	table ?= accepted_global_table(
		{globals = [
				{
					id = first_id,
					owner_module_path = "first",
					visibility = PublicDeclaration,
					declared_binding = None
				},
				{
					id = second_id,
					owner_module_path = "second",
					visibility = PrivateDeclaration,
					declared_binding = None
				},
			]},
	)

	Some(accepted_global_authority(
			table,
			global_id_module_identity(first_id),
			[
				{
					source_name = "hidden",
					owner_module_path = "second",
					original_name = global_id_name(second_id)
				},
			],
		).is_none())


func test_accepted_global_module_view_rejects_private_import() -> Bool:
	accepted_global_module_view_rejects_private_import().get_or(False)


