private pure func catalog_fixture() -> Option[CompilerTypecheckPhaseProfileFixture]:
	config: CompilerMixedTypeHeaderBenchmarkConfig = {
		iterations = 1,
		module_count = 1,
		shapes_per_module = 1,
		probes_per_module = 1,
		import_fanout = 0,
		retain_parsed_programs = False
	}
	compiler_mixed_type_header_phase_profile_fixture(config).to_option()


private pure func catalog_global_input(
	header: CompletedGlobalHeader,
) -> AcceptedDeclarationCatalogGlobalInput:
	{
		id = completed_global_header_id(header),
		canonical_type = completed_global_header_canonical_binding_type(header),
		visibility = completed_global_header_visibility(header),
		global_dependencies = completed_global_header_global_dependencies(header),
		callable_dependencies = completed_global_header_callable_dependencies(header)
	}


private pure func accepted_global_binding(id: GlobalId) -> AcceptedGlobalBinding:
	{
		id = id,
		binding_type = TYPE_INT,
		source_type = Some(TYPE_INT),
		is_mutable = False,
		definition_id = None
	}


private pure func two_globals_from_different_modules(
	graph: AcceptedTypecheckGraph,
) -> Option[(GlobalId, GlobalId)]:
	headers = accepted_typecheck_graph_completed_globals(graph)
	first ?= headers.get(0)
	first_id = completed_global_header_id(first)
	second ?= headers.find(func(header):
		not module_identities_equal(
			global_id_module_identity(completed_global_header_id(header)),
			global_id_module_identity(first_id),
		)
	)
	Some((first_id, completed_global_header_id(second)))


private pure func catalog_input(graph: AcceptedTypecheckGraph) -> AcceptedDeclarationCatalogInput:
	{
		implementation_headers = accepted_typecheck_graph_implementation_headers(graph),
		importable_graph = accepted_typecheck_graph_importable_graph(graph),
		completed_globals = completed_global_header_graph_headers(
			accepted_typecheck_graph_completed_global_graph(graph),
		).map(catalog_global_input)
	}


private pure func first_constructor_id_in_type_header(
	union_header: TypeHeader,
) -> Option[ConstructorId]:
	match union_header.shape:
		UnionTypeHeader(_, variants):
			match variants.get(0):
				Some(variant):
					Some(variant.id)
				None:
					None
		_:
			None


private pure func catalog_build_projects_every_accepted_category() -> Option[Bool]:
	fixture ?= catalog_fixture()
	accepted_graph = compiler_typecheck_phase_profile_fixture_accepted_graph(fixture)
	implementation_headers = accepted_typecheck_graph_implementation_headers(accepted_graph)
	completed_globals = accepted_typecheck_graph_completed_global_graph(accepted_graph)
	result = accepted_declaration_catalog_build(catalog_input(accepted_graph))

	Some(
		match result:
			Ok(catalog):
				catalog_projection_matches_fixture(
					catalog,
					compiler_typecheck_phase_profile_fixture_type_headers(fixture),
					implementation_headers,
					completed_globals,
				).get_or(False)
			Err(_):
				False
	)


private pure func catalog_projection_matches_fixture(
	catalog: AcceptedDeclarationCatalog,
	type_headers: TypeHeaderGraph,
	implementation_headers: ImplementationHeaderGraph,
	completed_globals: CompletedGlobalHeaderGraph,
) -> Option[Bool]:
	metrics = accepted_declaration_catalog_metrics(catalog)
	type_header ?= type_header_graph_headers(type_headers).get(0)
	union_header ?= type_header_graph_headers(type_headers).find(func(header):
		match header.shape:
			UnionTypeHeader(_, _):
				True
			_:
				False
	)
	constructor_id ?= first_constructor_id_in_type_header(union_header)
	callable_graph = implementation_header_graph_callable_headers(implementation_headers)
	callable ?= callable_header_graph_callables(callable_graph).get(0)
	global ?= completed_global_header_graph_headers(completed_globals).get(0)
	trait_graph = callable_header_graph_trait_topology(callable_graph)
	trait_header ?= trait_topology_graph_headers(trait_graph).get(0)
	trait_method ?= trait_topology_header_methods(trait_header).get(0)
	implementation ?= implementation_header_graph_headers(implementation_headers).get(0)
	implementation_method ?= implementation_header_methods(implementation).get(0)
	type_header_entries = type_header_graph_headers(type_headers)
	callable_header_entries = callable_header_graph_callables(callable_graph)
	global_header_entries = completed_global_header_graph_headers(completed_globals)
	trait_header_entries = trait_topology_graph_headers(trait_graph)
	implementation_header_entries = implementation_header_graph_headers(implementation_headers)
	catalog_type_entries = accepted_declaration_catalog_type_entries(catalog)
	catalog_constructor_entries = accepted_declaration_catalog_constructor_entries(catalog)
	catalog_callable_entries = accepted_declaration_catalog_callable_entries(catalog)
	catalog_global_entries = accepted_declaration_catalog_global_entries(catalog)
	catalog_trait_entries = accepted_declaration_catalog_trait_entries(catalog)
	catalog_trait_method_entries = accepted_declaration_catalog_trait_method_entries(catalog)
	catalog_implementation_entries = accepted_declaration_catalog_implementation_entries(catalog)
	catalog_implementation_method_entries = accepted_declaration_catalog_implementation_method_entries(
		catalog,
	)
	var expected_constructor_entries: Int = 0
	var expected_trait_method_entries: Int = 0
	var expected_implementation_method_entries: Int = 0
	var order_matches_headers: Bool = True
	var type_index: Int = 0
	var constructor_index: Int = 0
	var callable_index: Int = 0
	var global_index: Int = 0
	var trait_index: Int = 0
	var trait_method_index: Int = 0
	var implementation_index: Int = 0
	var implementation_method_index: Int = 0

	for header in type_header_entries:
		order_matches_headers = (
			order_matches_headers
			and catalog_type_entries
				.get(type_index)
				.map(func(entry): type_ids_equal(entry.id, header.id))
				.get_or(False)
		)

		type_index += 1

		match header.shape:
			UnionTypeHeader(_, variants):
				expected_constructor_entries += variants.length()

				for variant in variants:
					order_matches_headers = (
						order_matches_headers
						and catalog_constructor_entries
							.get(constructor_index)
							.map(func(entry): constructor_ids_equal(entry.id, variant.id))
							.get_or(False)
					)

					constructor_index += 1
			_:
				void

	for header in callable_header_entries:
		order_matches_headers = (
			order_matches_headers
			and catalog_callable_entries
				.get(callable_index)
				.map(func(entry): callable_ids_equal(entry.id, callable_header_id(header)))
				.get_or(False)
		)

		callable_index += 1

	for header in global_header_entries:
		order_matches_headers = (
			order_matches_headers
			and catalog_global_entries
				.get(global_index)
				.map(func(entry): global_ids_equal(entry.id, completed_global_header_id(header)))
				.get_or(False)
		)

		global_index += 1

	for header in trait_header_entries:
		order_matches_headers = (
			order_matches_headers
			and catalog_trait_entries
				.get(trait_index)
				.map(func(entry): trait_ids_equal(entry.id, trait_topology_header_id(header)))
				.get_or(False)
		)

		trait_index += 1
		expected_trait_method_entries += trait_topology_header_methods(header).length()

		for method in trait_topology_header_methods(header):
			order_matches_headers = (
				order_matches_headers
				and catalog_trait_method_entries
					.get(trait_method_index)
					.map(
						func(
							entry,
						): trait_method_ids_equal(entry.id, trait_method_slot_id(method)),
					)
					.get_or(False)
			)

			trait_method_index += 1

	for header in implementation_header_entries:
		order_matches_headers = (
			order_matches_headers
			and catalog_implementation_entries
				.get(implementation_index)
				.map(func(entry): impl_ids_equal(entry.id, implementation_header_id(header)))
				.get_or(False)
		)

		implementation_index += 1
		expected_implementation_method_entries += implementation_header_methods(header).length()

		for method in implementation_header_methods(header):
			order_matches_headers = (
				order_matches_headers
				and catalog_implementation_method_entries
					.get(implementation_method_index)
					.map(
						func(
							entry,
						): (
							impl_ids_equal(entry.owner, implementation_header_id(header))
							and callable_ids_equal(
								entry.id,
								implementation_method_header_id(method),
							)
						),
					)
					.get_or(False)
			)

			implementation_method_index += 1

	var all_catalog_entries_resolve: Bool = True

	for entry in accepted_declaration_catalog_type_entries(catalog):
		all_catalog_entries_resolve = (
			all_catalog_entries_resolve
			and accepted_declaration_catalog_find_type(catalog, entry.id).is_some()
		)

	for entry in accepted_declaration_catalog_constructor_entries(catalog):
		all_catalog_entries_resolve = (
			all_catalog_entries_resolve
			and accepted_declaration_catalog_find_constructor(catalog, entry.id).is_some()
		)

	for entry in accepted_declaration_catalog_callable_entries(catalog):
		all_catalog_entries_resolve = (
			all_catalog_entries_resolve
			and accepted_declaration_catalog_find_callable(catalog, entry.id).is_some()
		)

	for entry in accepted_declaration_catalog_global_entries(catalog):
		all_catalog_entries_resolve = (
			all_catalog_entries_resolve
			and accepted_declaration_catalog_find_global(catalog, entry.id).is_some()
		)

	for entry in accepted_declaration_catalog_trait_entries(catalog):
		all_catalog_entries_resolve = (
			all_catalog_entries_resolve
			and accepted_declaration_catalog_find_trait(catalog, entry.id).is_some()
		)

	for entry in accepted_declaration_catalog_trait_method_entries(catalog):
		all_catalog_entries_resolve = (
			all_catalog_entries_resolve
			and accepted_declaration_catalog_find_trait_method(catalog, entry.id).is_some()
		)

	for entry in accepted_declaration_catalog_implementation_entries(catalog):
		all_catalog_entries_resolve = (
			all_catalog_entries_resolve
			and accepted_declaration_catalog_find_implementation(catalog, entry.id).is_some()
		)

	for entry in accepted_declaration_catalog_implementation_method_entries(catalog):
		all_catalog_entries_resolve = (
			all_catalog_entries_resolve
			and accepted_declaration_catalog_find_implementation_method(
				catalog,
				entry.owner,
				entry.id,
			).is_some()
		)

	Some((
			metrics.type_entries == 8
			and metrics.constructor_entries == 5
			and metrics.callable_entries == 3
			and metrics.global_entries == 3
			and metrics.trait_entries == 2
			and metrics.trait_method_entries == 2
			and metrics.implementation_entries == 2
			and metrics.implementation_method_entries == 2
			and metrics.total_entries == 27
			and metrics.checksum == 5542838699410988289
			and order_matches_headers
			and metrics.type_entries == type_header_entries.length()
			and metrics.constructor_entries == expected_constructor_entries
			and metrics.callable_entries == callable_header_entries.length()
			and metrics.global_entries == global_header_entries.length()
			and metrics.trait_entries == trait_header_entries.length()
			and metrics.trait_method_entries == expected_trait_method_entries
			and metrics.implementation_entries == implementation_header_entries.length()
			and metrics.implementation_method_entries == expected_implementation_method_entries
			and all_catalog_entries_resolve
			and metrics.total_entries == metrics.type_entries + metrics.constructor_entries + metrics.callable_entries + metrics.global_entries + metrics.trait_entries + metrics.trait_method_entries + metrics.implementation_entries + metrics.implementation_method_entries
			and metrics.builder_visits == metrics.total_entries
			and metrics.duplicate_checks == metrics.builder_visits
			and metrics.checksum != 0
			and accepted_declaration_catalog_find_type(catalog, type_header.id)
				.map(func(entry): type_ids_equal(entry.id, type_header.id))
				.get_or(False)
			and accepted_declaration_catalog_find_constructor(catalog, constructor_id)
				.map(func(entry): constructor_ids_equal(entry.id, constructor_id))
				.get_or(False)
			and accepted_declaration_catalog_find_callable(catalog, callable_header_id(callable))
				.map(func(entry): callable_ids_equal(entry.id, callable_header_id(callable)))
				.get_or(False)
			and accepted_declaration_catalog_find_global(
				catalog,
				completed_global_header_id(global),
			)
				.map(func(entry): global_ids_equal(entry.id, completed_global_header_id(global)))
				.get_or(False)
			and accepted_declaration_catalog_find_trait(
				catalog,
				trait_topology_header_id(trait_header),
			)
				.map(func(entry): trait_ids_equal(entry.id, trait_topology_header_id(trait_header)))
				.get_or(False)
			and accepted_declaration_catalog_find_trait_method(
				catalog,
				trait_method_slot_id(trait_method),
			)
				.map(
					func(
						entry,
					): trait_method_ids_equal(entry.id, trait_method_slot_id(trait_method)),
				)
				.get_or(False)
			and accepted_declaration_catalog_find_implementation(
				catalog,
				implementation_header_id(implementation),
			)
				.map(
					func(
						entry,
					): impl_ids_equal(entry.id, implementation_header_id(implementation)),
				)
				.get_or(False)
			and accepted_declaration_catalog_find_implementation_method(
				catalog,
				implementation_header_id(implementation),
				implementation_method_header_id(implementation_method),
			)
				.map(func(entry):
					(
						impl_ids_equal(entry.owner, implementation_header_id(implementation))
						and callable_ids_equal(
							entry.id,
							implementation_method_header_id(implementation_method),
						)
					)
				)
				.get_or(False)
			and accepted_declaration_catalog_find_callable(
				catalog,
				implementation_method_header_id(implementation_method),
			).is_none()
			and accepted_declaration_catalog_find_implementation_method(
				catalog,
				implementation_header_id(implementation),
				callable_header_id(callable),
			).is_none()
		))


private pure func duplicate_global_reports_exact_error() -> Option[Bool]:
	fixture ?= catalog_fixture()
	input = catalog_input(compiler_typecheck_phase_profile_fixture_accepted_graph(fixture))
	first ?= input.completed_globals.get(0)
	result = accepted_declaration_catalog_build(
		{ input | completed_globals = input.completed_globals.append(first) },
	)

	Some(
		match result:
			Err([DeclarationCatalogDuplicateGlobalKey(module_identity, name)]):
				(
					module_identities_equal(module_identity, global_id_module_identity(first.id))
					and name == global_id_name(first.id)
				)
			_:
				False
	)


private pure func partial_completed_globals_remain_partial() -> Option[Bool]:
	fixture ?= catalog_fixture()
	input = catalog_input(compiler_typecheck_phase_profile_fixture_accepted_graph(fixture))
	first ?= input.completed_globals.get(0)

	Some(
		match accepted_declaration_catalog_build({ input | completed_globals = [first] }):
			Ok(catalog):
				(
					accepted_declaration_catalog_metrics(catalog).global_entries == 1
					and accepted_declaration_catalog_find_global(catalog, first.id).is_some()
				)
			Err(_):
				False
	)


private pure func inconsistent_global_projection_is_rejected() -> Option[Bool]:
	fixture ?= catalog_fixture()
	input = catalog_input(compiler_typecheck_phase_profile_fixture_accepted_graph(fixture))
	first ?= input.completed_globals.get(0)

	wrong_visibility = match first.visibility:
		PublicDeclaration:
			PrivateDeclaration
		PrivateDeclaration:
			PublicDeclaration

	corrupt = { first | visibility = wrong_visibility }

	Some(
		match accepted_declaration_catalog_build({ input | completed_globals = [corrupt] }):
			Err([DeclarationCatalogProductProvenanceMismatch]):
				True
			_:
				False
	)


func test_catalog_build_projects_every_accepted_category() -> Bool:
	catalog_build_projects_every_accepted_category().get_or(False)


func test_catalog_duplicate_global_reports_exact_error() -> Bool:
	duplicate_global_reports_exact_error().get_or(False)


func test_catalog_accepts_partial_completed_globals() -> Bool:
	partial_completed_globals_remain_partial().get_or(False)


func test_catalog_rejects_inconsistent_global_projection() -> Bool:
	inconsistent_global_projection_is_rejected().get_or(False)


private pure func retained_alias_authority_has_one_table_and_compact_views() -> Option[Bool]:
	fixture ?= catalog_fixture()
	graph = compiler_typecheck_phase_profile_fixture_accepted_graph(fixture)
	type_headers = compiler_typecheck_phase_profile_fixture_type_headers(fixture)
	metrics = accepted_typecheck_graph_alias_metrics(graph)
	alias_count = type_header_graph_headers(type_headers).count(func(header):
		match header.shape:
			AliasTypeHeader(_, _):
				True
			_:
				False
	)
	module_count = 1 + bound_module_graph_modules(
		type_header_graph_bound_graph(type_headers),
	).length()

	Some(
		(
			metrics.accepted_alias_table_builds == 1
			and metrics.alias_entries == alias_count
			and metrics.canonical_module_views_built == module_count
			and metrics.legacy_alias_graph_symbol_installs == 0
		),
	)


func test_retained_alias_authority_has_one_table_and_compact_views() -> Bool:
	retained_alias_authority_has_one_table_and_compact_views().get_or(False)


private pure func retained_record_authority_has_one_table_and_compact_views() -> Option[Bool]:
	fixture ?= catalog_fixture()
	graph = compiler_typecheck_phase_profile_fixture_accepted_graph(fixture)
	type_headers = compiler_typecheck_phase_profile_fixture_type_headers(fixture)
	metrics = accepted_typecheck_graph_record_metrics(graph)
	record_count = type_header_graph_headers(type_headers).count(func(header):
		match header.shape:
			RecordTypeHeader(_, _):
				True
			_:
				False
	)
	module_count = 1 + bound_module_graph_modules(
		type_header_graph_bound_graph(type_headers),
	).length()

	Some(
		(
			metrics.accepted_record_table_builds == 1
			and metrics.record_entries == record_count
			and metrics.canonical_module_views_built == module_count
