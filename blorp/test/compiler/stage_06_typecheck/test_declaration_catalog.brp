private pure func retained_union_authority_has_one_table_and_compact_views() -> Option[Bool]:
	fixture ?= catalog_fixture()
	graph = compiler_typecheck_phase_profile_fixture_accepted_graph(fixture)
	type_headers = compiler_typecheck_phase_profile_fixture_type_headers(fixture)
	metrics = accepted_typecheck_graph_union_metrics(graph)
	union_count = type_header_graph_headers(type_headers).count(func(header):
		match header.shape:
			UnionTypeHeader(_, _):
				True
			_:
				False
	)
	module_count = 1 + bound_module_graph_modules(
		type_header_graph_bound_graph(type_headers),
	).length()

	Some(
		(
			metrics.accepted_union_table_builds == 1
			and metrics.union_entries >= union_count
			and metrics.canonical_module_views_built == module_count
			and metrics.legacy_union_graph_symbol_installs == 0
		),
	)


