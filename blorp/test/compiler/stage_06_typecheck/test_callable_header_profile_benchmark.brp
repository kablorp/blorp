import:
	../../../../compiler/benchmarks/compiler_callable_header_profile_fixture:
		CompilerCallableHeaderBenchmarkConfig,
		compiler_callable_header_benchmark
	test: TestSuite


private func test_callable_header_profile_fixture_counts_valid_headers() -> Bool:
	result = compiler_callable_header_benchmark({
		iterations = 1,
		module_count = 2,
		headers_per_module = 3,
		parameters_per_header = 4,
		dimension_constraints_per_header = 2,
		retain_parsed_programs = True
	})

	(
		result.artifact_count == 3
		and result.valid_header_count == 6
		and result.source_declaration_count == 7
		and result.typed_declaration_count == 7
		and result.error_count == 0
		and result.checksum == 23
		and result.workload_valid
	)


private func test_callable_header_profile_fixture_is_deterministic() -> Bool:
	result = compiler_callable_header_benchmark({
		iterations = 2,
		module_count = 1,
		headers_per_module = 2,
		parameters_per_header = 0,
		dimension_constraints_per_header = 0,
		retain_parsed_programs = False
	})

	(
		result.artifact_count == 2
		and result.valid_header_count == 2
		and result.source_declaration_count == 3
		and result.typed_declaration_count == 3
		and result.error_count == 0
		and result.checksum == 20
		and result.workload_valid
	)


tests: TestSuite = {
	description = "Compiler callable-header profile benchmark",
	tests = [
		("counts valid headers", test_callable_header_profile_fixture_counts_valid_headers),
		("is deterministic", test_callable_header_profile_fixture_is_deterministic),
	]
}
