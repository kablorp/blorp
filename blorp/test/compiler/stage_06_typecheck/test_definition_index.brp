private pure func parsed_program(
	path: String,
	module_name: String,
	source: String,
) -> ParsedProgram:
	finalized_typecheck_program_ast(
		TypecheckTestSupport.finalized_typecheck_program_fixture(
			path,
			module_name,
			source,
		),
	)


private pure func definition_index_seed() -> DefinitionIndexSeed:
	definition_index_initial_seed(ENV_EMPTY)


private record FixtureLoadedDomain {
	module_table: ModuleTable,
	target_id: ModuleId,
	loaded_modules: LoadedModuleSet
}


private pure func fixture_loaded_module_set(
	target: ParsedProgram,
	modules: List[ParsedProgram],
) -> Option[FixtureLoadedDomain]:
	identities = [
		resolved_module_identity_from_resolver(target.source.module_name, UserModule),
	].concat(
		modules.map(func(module):
			resolved_module_identity_from_resolver(module.source.module_name, UserModule)
		),
	)

	match module_table(identities):
		Err(_):
			None
		Ok(table):
			target_id = module_table_find_id_by_canonical_path(table, target.source.module_name)
			loaded = loaded_module_set(
				module_load_candidate(
					resolved_module_identity_from_resolver(target.source.module_name, UserModule),
					finalized_typecheck_program(target),
				),
				modules.map(func(module):
					module_load_candidate(
						resolved_module_identity_from_resolver(
							module.source.module_name,
							UserModule,
						),
						finalized_typecheck_program(module),
					)
				),
			)

			match (target_id, loaded):
				(Some(target_id), Ok(loaded_modules)):
					Some({
						module_table = table,
						target_id = target_id,
						loaded_modules = loaded_modules,
					})
				_:
					None


private pure func insert_callable(
	index: DefinitionIndex,
	key: FuncCallableKey,
	def_id: Int,
) -> DefinitionIndex:
	definition_index_insert_func_callable_id(
		index,
		definition_index_module_table(index),
		key,
		def_id,
	).get_or(index)


private pure func insert_source_definition(
	index: DefinitionIndex,
	key: SourceDefinitionKey,
	def_id: Int,
) -> DefinitionIndex:
	definition_index_insert_source_definition_id(
		index,
		definition_index_module_table(index),
		key,
		def_id,
	).get_or(index)


pure func test_definition_index_uses_explicit_seed_and_exact_keys() -> Bool:
	seed = definition_index_seed()
	source = source_file("index.brp", "index", "func render(): 0")
	start = source_start(source)
	span = source_span(source, start, start)

	match fixture_loaded_module_set(
		parsed_program("index.brp", "index", "func render(): 0"),
		[],
	):
		None:
			False
		Some(domain):
			empty = definition_index_empty(seed, domain.module_table)
			callable_key = func_callable_key(domain.target_id, "render", span)
			source_key = source_definition_key(
				domain.target_id,
				ConstructorDefinition,
				"Ready",
				Some("Signal"),
				span,
			)
			first_id = definition_index_seed_next_def_id(seed)
			with_callable = insert_callable(empty, callable_key, first_id)
			with_source = insert_source_definition(with_callable, source_key, first_id + 1)

			(
				definition_index_next_def_id(empty) == definition_index_seed_next_def_id(seed)
				and definition_index_find_func_callable_id(
					empty,
					domain.module_table,
					callable_key,
				).is_none()
				and definition_index_find_func_callable_id(
					with_source,
					domain.module_table,
					callable_key,
				) == Some(first_id)
				and definition_index_find_source_definition_id(
					with_source,
					domain.module_table,
					source_key,
				) == Some(first_id + 1)
				and definition_index_next_def_id(with_source) == first_id + 2
				and definition_index_func_callable_bindings(with_source, "render").length() == 1
				and definition_index_source_definition_bindings(with_source, "Ready").length() == 1
				and definition_index_all_func_callable_bindings(
					with_source,
				).map(
					func(binding): binding[1],
				) == [first_id]
				and definition_index_all_source_definition_bindings(
					with_source,
				).map(
					func(binding): binding[1],
				) == [first_id + 1]
			)


pure func test_definition_index_plans_programs_without_exposing_maps() -> Bool:
	seed = definition_index_seed()
	target = parsed_program("main.brp", "main", "func main(args: List[String]) -> Int:\n\t0")
	dependency = parsed_program(
		"signal.brp",
		"signal",
		"union Signal:\n\tReady\n\tBusy(Int)\n\npure func answer() -> Int:\n\t42",
	)

	match fixture_loaded_module_set(target, [dependency]):
		None:
			False
		Some(domain):
			match definition_index_for_loaded_modules(
				seed,
				domain.module_table,
				domain.loaded_modules,
			):
				None:
					False
				Some(index):
					(
						definition_index_func_callable_id_count(index) == 2
						and definition_index_source_definition_id_count(index) == 3
						and definition_index_next_def_id(
							index,
						) == definition_index_seed_next_def_id(seed) + 5
						and definition_index_func_callable_bindings(index, "main").length() == 1
						and definition_index_func_callable_bindings(index, "answer").length() == 1
						and definition_index_source_definition_bindings(
							index,
							"Signal",
						).length() == 1
						and definition_index_source_definition_bindings(
							index,
							"Ready",
						).length() == 1
						and definition_index_source_definition_bindings(index, "Busy").length() == 1
						and definition_index_all_func_callable_bindings(index).length() == 2
						and definition_index_all_source_definition_bindings(index).length() == 3
					)


pure func test_definition_index_bootstrap_aligns_environment_and_empty_index() -> Bool:
	bootstrap = definition_index_bootstrap_from_base_env(ENV_EMPTY)
	env = definition_index_bootstrap_env(bootstrap)

	match fixture_loaded_module_set(
		parsed_program("index.brp", "index", "func render(): 0"),
		[],
	):
		None:
			False
		Some(domain):
			index = definition_index_empty(
				definition_index_bootstrap_seed(bootstrap),
				domain.module_table,
			)

			(
				definition_index_func_callable_id_count(index) == 0
				and definition_index_source_definition_id_count(index) == 0
				and definition_index_next_def_id(index) == env.next_def_id
			)


pure func test_source_definition_name_projection_matches_exact_lookup_after_conflict() -> Bool:
	seed = definition_index_seed()
	source = source_file("index.brp", "index", "union Ready:\n\tDone\n")
	start = source_start(source)
	first_span = source_span(source, start, start)
	second_cursor = source_cursor_at(source, 1)
	second_span = source_span(source, second_cursor, second_cursor)

	match fixture_loaded_module_set(
		parsed_program("index.brp", "index", "union Ready:\n\tDone\n"),
		[],
	):
		None:
			False
		Some(domain):
			empty = definition_index_empty(seed, domain.module_table)
			first_key = source_definition_key(
				domain.target_id,
				ConstructorDefinition,
				"Ready",
				None,
				first_span,
			)
			second_key = source_definition_key(
				domain.target_id,
				ConstructorDefinition,
				"Ready",
				Some("Other"),
				second_span,
			)
			first_id = definition_index_seed_next_def_id(seed)
			conflicting_id = first_id - 1
			with_first = insert_source_definition(empty, first_key, first_id)
			conflict = definition_index_insert_source_definition_id(
				with_first,
				domain.module_table,
				second_key,
				conflicting_id,
			)
			bindings = definition_index_source_definition_bindings(with_first, "Ready")
			projected_ids = bindings.map(func(binding): binding[1])
			exact_ids = bindings.map(func(binding):
				definition_index_find_source_definition_id(
					with_first,
					domain.module_table,
					binding[0],
				).get_or(-1)
			)

			(
				conflict.is_err()
				and definition_index_source_definition_bindings(with_first, "Ready").length() == 1
				and projected_ids == [first_id]
				and exact_ids == projected_ids
				and definition_index_find_source_definition_id(
					with_first,
					domain.module_table,
					first_key,
				) == Some(first_id)
				and definition_index_find_source_definition_id(
					with_first,
					domain.module_table,
					second_key,
				).is_none()
				and definition_index_source_definition_id_count(with_first) == 1
			)


pure func test_type_definition_lookup_uses_exact_identity_and_loaded_path() -> Bool:
	target = parsed_program("main.brp", "main", "record Shared {value: Int}")
	dependency = parsed_program("dep.brp", "pkg/dep", "record Shared {value: String}")

	match fixture_loaded_module_set(target, [dependency]):
		None:
			False
		Some(domain):
			match definition_index_for_loaded_modules(
				definition_index_seed(),
				domain.module_table,
				domain.loaded_modules,
			):
				None:
					False
				Some(index):
					target_id = definition_index_find_type_definition_id(
						index,
						domain.module_table,
						domain.target_id,
						"Shared",
					)
					dependency_id = definition_index_find_loaded_type_definition_id(
						index,
						"pkg/dep",
						"Shared",
					)

					(
						target_id.is_some()
						and dependency_id.is_some()
						and target_id != dependency_id
						and definition_index_find_loaded_type_definition_id(
							index,
							"main",
							"Shared",
						) == target_id
					)


pure func test_type_definition_lookup_rejects_wrong_kind_missing_and_duplicate_entries() -> Bool:
	seed = definition_index_seed()
	program = parsed_program("types.brp", "types", "record Shared {value: Int}")
	source = source_file("types.brp", "types", "record Shared {value: Int}")
	start = source_start(source)
	first_span = source_span(source, start, start)
	second_cursor = source_cursor_at(source, 1)
	second_span = source_span(source, second_cursor, second_cursor)

	match fixture_loaded_module_set(program, []):
		None:
			False
		Some(domain):
			empty = definition_index_empty(seed, domain.module_table)
			first_id = definition_index_seed_next_def_id(seed)
			wrong_kind = source_definition_key(
				domain.target_id,
				ConstructorDefinition,
				"Shared",
				Some("Container"),
				first_span,
			)
			first_type = source_definition_key(
				domain.target_id,
				TypeDefinition,
				"Shared",
				None,
				first_span,
			)
			second_type = source_definition_key(
				domain.target_id,
				TypeDefinition,
				"Shared",
				None,
				second_span,
			)
			with_wrong_kind = insert_source_definition(empty, wrong_kind, first_id)
			with_first_type = insert_source_definition(with_wrong_kind, first_type, first_id + 1)
			with_duplicate = insert_source_definition(with_first_type, second_type, first_id + 2)

			(
				definition_index_find_type_definition_id(
					with_wrong_kind,
					domain.module_table,
					domain.target_id,
					"Shared",
				).is_none()
				and definition_index_find_type_definition_id(
					with_first_type,
					domain.module_table,
					domain.target_id,
					"Shared",
				) == Some(first_id + 1)
				and definition_index_find_type_definition_id(
					with_duplicate,
					domain.module_table,
					domain.target_id,
					"Shared",
				).is_none()
				and definition_index_find_loaded_type_definition_id(
					with_first_type,
					"missing",
					"Shared",
				).is_none()
				and definition_index_find_loaded_type_definition_id(
					with_first_type,
					"types",
					"Missing",
				).is_none()
			)


pure func test_definition_index_rejects_module_id_from_independent_table() -> Bool:
	seed = definition_index_seed()
	source = source_file("types.brp", "types", "record Shared {value: Int}")
	start = source_start(source)
	span = source_span(source, start, start)
	program = parsed_program("types.brp", "types", "record Shared {value: Int}")

	match (fixture_loaded_module_set(program, []), fixture_loaded_module_set(program, [])):
		(Some(first), Some(second)):
			index = definition_index_empty(seed, first.module_table)
			key = source_definition_key(first.target_id, TypeDefinition, "Shared", None, span)
			definition_id = definition_index_seed_next_def_id(seed)
			with_entry = insert_source_definition(index, key, definition_id)

			(
				definition_index_insert_source_definition_id(
					with_entry,
					second.module_table,
					key,
					definition_id + 1,
				).is_err()
				and definition_index_find_source_definition_id(
					with_entry,
					second.module_table,
					key,
				).is_none()
				and definition_index_find_source_definition_id(
					with_entry,
					first.module_table,
					key,
				) == Some(definition_id)
			)
		_:
			False


private pure func definition_index_rebases_only_append_only_module_domains() -> Option[Bool]:
	seed = definition_index_seed()
	program = parsed_program("types.brp", "types", "record Shared {value: Int}")
	domain ?= fixture_loaded_module_set(program, [])
	source = source_file("types.brp", "types", "record Shared {value: Int}")
	start = source_start(source)
	key = source_definition_key(
		domain.target_id,
		TypeDefinition,
		"Shared",
		None,
		source_span(source, start, start),
	)
	definition_id = definition_index_seed_next_def_id(seed)
	index = insert_source_definition(
		definition_index_empty(seed, domain.module_table),
		key,
		definition_id,
	)
	types_identity = resolved_module_identity_from_resolver("types", UserModule)
	extra_identity = resolved_module_identity_from_resolver("extra", UserModule)
	appended_table ?= module_table([types_identity, extra_identity]).to_option()
	reordered_table ?= module_table([extra_identity, types_identity]).to_option()
	rebased ?= definition_index_rebase_module_table(index, appended_table)

	Some(
		(
			definition_index_find_source_definition_id(
				rebased,
				appended_table,
				key,
			) == Some(definition_id)
			and definition_index_next_def_id(rebased) == definition_id + 1
			and definition_index_rebase_module_table(index, reordered_table).is_none()
		),
	)


pure func test_definition_index_rebases_only_append_only_module_domains() -> Bool:
	definition_index_rebases_only_append_only_module_domains().get_or(False)


private pure func definition_table_owns_exact_canonical_rows() -> Option[Bool]:
	seed = definition_index_seed()
	program = parsed_program("index.brp", "index", "func render(): 0")
	domain ?= fixture_loaded_module_set(program, [])
	source = source_file("index.brp", "index", "func render(): 0")
	start = source_start(source)
	callable_span = source_span(source, start, start)
	field_cursor = source_cursor_at(source, 1)
	field_span = source_span(source, field_cursor, field_cursor)
	callable_key = func_callable_key(domain.target_id, "render", callable_span)
	field_key = source_definition_key(
		domain.target_id,
		FieldDefinition,
		"value",
		Some("Box"),
		field_span,
	)
	constructor_key = source_definition_key(
		domain.target_id,
		ConstructorDefinition,
		"Ready",
		Some("Signal"),
		field_span,
	)
	first_id = definition_index_seed_next_def_id(seed)
	with_callable = insert_callable(
		definition_index_empty(seed, domain.module_table),
		callable_key,
		first_id,
	)
	with_field = insert_source_definition(with_callable, field_key, first_id + 1)
	index = insert_source_definition(with_field, constructor_key, first_id + 2)
	table = definition_index_definition_table(index)
	callable_id ?= definition_table_definition_id(table, first_id)
	field_id ?= definition_table_definition_id(table, first_id + 1)
	constructor_id ?= definition_table_definition_id(table, first_id + 2)
	callable_row ?= definition_table_row(table, callable_id)
	field_row ?= definition_table_row(table, field_id)
	callable_ids_at_span = definition_index_callable_definition_ids_at_span(
		index,
		domain.module_table,
		domain.target_id,
		callable_span,
	)

	Some(
		(
			definition_id_runtime_value(callable_id) == first_id
			and definition_table_definition_count(table) == 3
			and callable_row.kind == CallableDefinitionKind
			and callable_row.name == "render"
			and callable_row.owner_name.is_none()
			and module_ids_equal(callable_row.module_id, domain.target_id)
			and source_spans_equal(callable_row.span, callable_span)
			and definition_id_runtime_value(field_id) == first_id + 1
			and field_row.kind == FieldDefinitionKind
			and field_row.name == "value"
			and field_row.owner_name == Some("Box")
			and module_ids_equal(field_row.module_id, domain.target_id)
			and source_spans_equal(field_row.span, field_span)
			and definition_table_definition_id(table, first_id - 1).is_none()
			and definition_table_definition_id(table, first_id + 3).is_none()
			and definition_table_callable_definition_id(table, first_id) == Some(callable_id)
			and definition_table_callable_definition_id(table, first_id + 1).is_none()
			and definition_table_constructor_definition_id(table, first_id).is_none()
			and definition_table_constructor_definition_id(
				table,
				first_id + 2,
			) == Some(constructor_id)
			and callable_ids_at_span == [callable_id]
			and definition_index_callable_definition_ids_at_span(
				index,
				domain.module_table,
				domain.target_id,
				field_span,
			).is_empty()
		),
	)


pure func test_definition_table_owns_exact_canonical_rows() -> Bool:
	definition_table_owns_exact_canonical_rows().get_or(False)


private pure func definition_index_rejects_forward_definition_id_gaps() -> Option[Bool]:
	seed = definition_index_seed()
	program = parsed_program("index.brp", "index", "func render(): 0")
	domain ?= fixture_loaded_module_set(program, [])
	source = source_file("index.brp", "index", "func render(): 0")
	start = source_start(source)
	key = func_callable_key(
		domain.target_id,
		"render",
		source_span(source, start, start),
	)
	index = definition_index_empty(seed, domain.module_table)
	frontier = definition_index_next_def_id(index)
	advanced_frontier = frontier + 20
	advanced = definition_index_advance_to_env(
		index,
		{ ENV_EMPTY | next_def_id = advanced_frontier },
	)
	advanced_table = definition_index_definition_table(advanced)
	advanced_insert = definition_index_insert_func_callable_id(
		advanced,
		domain.module_table,
		key,
		advanced_frontier,
	)

	match definition_index_insert_func_callable_id(index, domain.module_table, key, frontier + 1):
		Ok(_):
			Some(False)
		Err(conflict):
			Some(
				(
					definition_index_conflict_message(
						index,
						conflict,
					).contains(
						"definition ID " + (frontier + 1).to_string() + " is above allocation frontier " + frontier.to_string(),
					)
					and definition_index_next_def_id(index) == frontier
					and definition_index_find_func_callable_id(
						index,
						domain.module_table,
						key,
					).is_none()
					and definition_index_next_def_id(advanced) == advanced_frontier
					and definition_table_definition_count(advanced_table) == 0
					and definition_table_definition_id(advanced_table, advanced_frontier).is_none()
					and advanced_insert.is_err()
				),
			)


pure func test_definition_index_rejects_forward_definition_id_gaps() -> Bool:
	definition_index_rejects_forward_definition_id_gaps().get_or(False)


tests: TestSuite = {
	description = "Compiler definition index",
	tests = [
		(
			"uses explicit seed and exact keys",
			test_definition_index_uses_explicit_seed_and_exact_keys,
		),
		(
