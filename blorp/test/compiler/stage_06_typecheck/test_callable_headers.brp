private pure func fixture_module_load_candidate(source: String) -> ModuleLoadCandidate:
	module_load_candidate_at("main", source)


private pure func module_load_candidate_at(
	module_path: String,
	source: String,
) -> ModuleLoadCandidate:
	module_load_candidate(
		resolved_module_identity_from_resolver(module_path, UserModule),
		TypecheckTestSupport.finalized_typecheck_program_fixture(
			module_path + ".brp",
			module_path,
			source,
		),
	)


private pure func accept_empty_view(scope: PreparedModuleScope) -> BoundModuleViewBinding:
	BoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private pure func callable_graph(source: String) -> Option[CallableHeaderGraph]:
	callable_graph_at("main", source)


private pure func callable_graph_at(
	module_path: String,
	source: String,
) -> Option[CallableHeaderGraph]:
	indexed ?= indexed_graph_build(
		module_load_candidate_at(module_path, source),
		[],
	).to_option()
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	topology ?= trait_topology_graph_build(type_headers).to_option()
	callable_header_graph_build(topology).to_option()


private pure func callable_header_by_name(
	graph: CallableHeaderGraph,
	name: String,
) -> Option[CallableHeader]:
	callable_header_graph_callables(graph).find(func(header): callable_header_name(header) == name)


private pure func global_header_by_name(
	graph: CallableHeaderGraph,
	name: String,
) -> Option[GlobalHeader]:
	callable_header_graph_globals(graph).find(func(header): global_header_name(header) == name)


private pure func callable_headers_resolve_exact_signatures() -> Option[Bool]:
	source: String =
		|pure func transform[T: Equatable](value: T, callback: pure (T) -> String) -> String:
		|	callback(value)
		|
		|foreign:
		|	pure func native_size(value: Int) -> Int = "native_size"
	graph ?= callable_graph(source)
	transform ?= callable_header_by_name(graph, "transform")
	native_size ?= callable_header_by_name(graph, "native_size")
	parameter ?= callable_header_parameters(transform).get(0)
	bound ?= callable_type_parameter_bounds(parameter).get(0)
	signature = callable_header_signature(transform)
	params = callable_signature_parameters(signature)
	value ?= params.get(0)
	callback ?= params.get(1)

	Some(
		(
			callable_header_graph_callables(graph).length() == 2
			and callable_header_category(transform) == FunctionCallableHeader
			and callable_header_category(native_size) == ForeignCallableHeader
			and trait_id_name(bound) == "Equatable"
			and callable_type_parameter_id_index(callable_type_parameter_id(parameter)) == 0
			and match (value.typ, callback.typ, callable_signature_return_type(signature)):
				(CallableTypeParameterShape(_), FunctionTypeShape(True, [CallableTypeParameterShape(_)], IntrinsicTypeShape(IntrinsicString, [])), IntrinsicTypeShape(IntrinsicString, [])):
					True
				_:
					False
		),
	)


pure func test_callable_headers_resolve_exact_signatures() -> Bool:
	callable_headers_resolve_exact_signatures().get_or(False)


private pure func prepared_context_rejects_foreign_parameters() -> Option[Bool]:
	source: String =
		|pure func first[T](value: T) -> T: value
		|
		|pure func second[U](value: U) -> U: value
	graph ?= callable_graph(source)
	first ?= callable_header_by_name(graph, "first")
	second ?= callable_header_by_name(graph, "second")
	first_id = callable_header_id(first)
	second_id = callable_header_id(second)
	foreign_parameters = callable_type_parameter_ids(first_id, ["T"])
	type_headers = trait_topology_graph_type_headers(callable_header_graph_trait_topology(graph))
	definition_table = type_header_graph_definition_table(type_headers)
	second_name ?= callable_id_name(definition_table, second_id)
	second_span ?= callable_id_source_span(definition_table, second_id)
	owner_scope = bound_module_scope(
		bound_module_graph_target(type_header_graph_bound_graph(type_headers)),
	)

	Some(
		match prepare_callable_type_resolution_context(
			type_headers,
			owner_scope,
			second_id,
			second_name,
			second_span,
			foreign_parameters,
		):
			Err([TypeShapeForeignCallableParameter(_, parameter, span)]):
				(
					callable_ids_equal(callable_type_parameter_id_owner(parameter), first_id)
					and source_spans_equal(span, second_span)
				)
			_:
				False
	)


pure func test_prepared_context_rejects_foreign_parameters() -> Bool:
	prepared_context_rejects_foreign_parameters().get_or(False)


private pure func prepared_context_rejects_foreign_graph_scope() -> Option[Bool]:
	graph ?= callable_graph("pure func local(value: Int) -> Int: value")
	header ?= callable_header_by_name(graph, "local")
	callable_id = callable_header_id(header)
	type_headers = trait_topology_graph_type_headers(callable_header_graph_trait_topology(graph))
	definition_table = type_header_graph_definition_table(type_headers)
	callable_name ?= callable_id_name(definition_table, callable_id)
	diagnostic_span ?= callable_id_source_span(definition_table, callable_id)
	foreign_graph ?= callable_graph_at("other", "pure func remote(value: Int) -> Int: value")
	foreign_type_headers = trait_topology_graph_type_headers(
		callable_header_graph_trait_topology(foreign_graph),
	)
	foreign_scope = bound_module_scope(
		bound_module_graph_target(type_header_graph_bound_graph(foreign_type_headers)),
	)

	Some(
		match prepare_callable_type_resolution_context(
			type_headers,
			foreign_scope,
			callable_id,
			callable_name,
			diagnostic_span,
			[],
		):
			Err([TypeShapeOwnerModuleMissing(_, span)]):
				source_spans_equal(span, diagnostic_span)
			_:
				False
	)


pure func test_prepared_context_rejects_foreign_graph_scope() -> Bool:
	prepared_context_rejects_foreign_graph_scope().get_or(False)


private pure func prepared_context_rejects_wrong_same_graph_scope() -> Option[Bool]:
	indexed ?= indexed_graph_build(
		module_load_candidate_at("main", "pure func local(value: Int) -> Int: value"),
		[module_load_candidate_at("dep", "pure func remote(value: Int) -> Int: value")],
	).to_option()
	bound ?= bound_module_graph_build(indexed, ["dep"], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	topology ?= trait_topology_graph_build(type_headers).to_option()
	graph ?= callable_header_graph_build(topology).to_option()
	header ?= callable_header_by_name(graph, "local")
	callable_id = callable_header_id(header)
	definition_table = type_header_graph_definition_table(type_headers)
	callable_name ?= callable_id_name(definition_table, callable_id)
	diagnostic_span ?= callable_id_source_span(definition_table, callable_id)
	dependency ?= bound_module_graph_find_canonical_path(bound, "dep")

	Some(
		match prepare_callable_type_resolution_context(
			type_headers,
			bound_module_scope(dependency),
			callable_id,
			callable_name,
			diagnostic_span,
			[],
		):
			Err([TypeShapeOwnerModuleMissing(_, span)]):
				source_spans_equal(span, diagnostic_span)
			_:
				False
	)


pure func test_prepared_context_rejects_wrong_same_graph_scope() -> Bool:
	prepared_context_rejects_wrong_same_graph_scope().get_or(False)


private pure func prepared_context_resolves_dimension_constraints() -> Option[Bool]:
	source: String =
		|pure func constrained[#M, #N, #R](left: Int[#M], right: Int[#N], result: Int[#R]) -> Int where #M + #N == #R:
		|	0
	graph ?= callable_graph(source)
	header ?= callable_header_by_name(graph, "constrained")
	constraint ?= callable_header_dimension_constraints(header).get(0)

	Some(
		match constraint:
			(DimensionBinaryShape(ResolvedDimAdd, CallableDimensionParameterShape(left, False), CallableDimensionParameterShape(right, False)), CallableDimensionParameterShape(result, False)):
				(
					callable_type_parameter_id_index(left) == 0
					and callable_type_parameter_id_index(right) == 1
					and callable_type_parameter_id_index(result) == 2
				)
			_:
				False
	)


pure func test_prepared_context_resolves_dimension_constraints() -> Bool:
	prepared_context_resolves_dimension_constraints().get_or(False)


private pure func callable_and_global_ids_are_exact() -> Option[Bool]:
	source: String =
		|pure func identity(value: Int) -> Int: value
		|
		|foreign:
		|	pure func native_size(value: Int) -> Int = "native_size"
		|
		|answer: Int = 42
	graph ?= callable_graph_at("main", source)
	foreign_graph ?= callable_graph_at("other", source)
	declarations = type_header_graph_declaration_graph(
		trait_topology_graph_type_headers(callable_header_graph_trait_topology(graph)),
	)
	callable_headers = callable_header_graph_callables(graph)
	callable_skeletons = declaration_skeleton_graph_callable_skeletons(declarations)
	global_headers = callable_header_graph_globals(graph)
	global_skeletons = declaration_skeleton_graph_global_skeletons(declarations)
	foreign_callable ?= callable_header_graph_callables(foreign_graph).get(0)
	definition_table = callable_header_graph_definition_table(graph)
	foreign_definition_table = callable_header_graph_definition_table(foreign_graph)

	-- Scalar declaration IDs are exact only within their definition-table domain;
	-- the issuing table carries cross-graph identity at public boundaries.
	Some((
			callable_headers.length() == callable_skeletons.length()
			and callable_headers
				.zip(callable_skeletons)
				.all(
					func(
						pair,
					): (
						callable_ids_equal(callable_header_id(pair[0]), pair[1].id)
						and callable_header_graph_find(graph, callable_header_id(pair[0])).is_some()
					),
				)
			and global_headers.length() == global_skeletons.length()
			and global_headers
				.zip(global_skeletons)
				.all(func(pair):
					global_ids_equal(global_header_id(pair[0]), pair[1].id)
				)
			and callable_header_graph_find(
				foreign_graph,
				callable_header_id(foreign_callable),
			).is_some()
			and not module_tables_are_compatible(
				definition_table_module_table(definition_table),
				definition_table_module_table(foreign_definition_table),
			)
		))


pure func test_callable_and_global_ids_are_exact() -> Bool:
	callable_and_global_ids_are_exact().get_or(False)


private pure func callable_headers_are_indexed_by_module() -> Option[Bool]:
	indexed ?= indexed_graph_build(
		module_load_candidate_at(
			"main",
			"pure func first(value: Int) -> Int: value\n\npure func second(value: Int) -> Int: value",
		),
		[module_load_candidate_at("dep", "pure func remote(value: Int) -> Int: value")],
	).to_option()
	bound ?= bound_module_graph_build(indexed, ["dep"], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	topology ?= trait_topology_graph_build(type_headers).to_option()
	graph ?= callable_header_graph_build(topology).to_option()
	first ?= callable_header_by_name(graph, "first")
	remote ?= callable_header_by_name(graph, "remote")
	definition_table = callable_header_graph_definition_table(graph)
	main_module_id ?= callable_id_module_id(definition_table, callable_header_id(first))
	dependency_module_id ?= callable_id_module_id(definition_table, callable_header_id(remote))

	Some(
		(
			callable_header_graph_callables_for_module(
				graph,
				main_module_id,
			).map(callable_header_name) == ["first", "second"]
			and callable_header_graph_callables_for_module(
				graph,
				dependency_module_id,
			).map(callable_header_name) == ["remote"]
		),
	)


pure func test_callable_headers_are_indexed_by_module() -> Bool:
	callable_headers_are_indexed_by_module().get_or(False)


private pure func callable_headers_infer_implicit_parameters() -> Option[Bool]:
	source: String =
		|pure func identity(value: T) -> T:
		|	value
		|
		|pure func first(values: Int[#N]) -> Int:
		|	values[0]
		|
		|pure func length_of(values: Int[#_]) -> Int:
		|	values.length()
		|
		|pure func prepare_sql(sql: LiteralString) -> String:
		|	sql
		|
		|func receive_one(values: Channel[Int]) -> Int:
		|	0
		|
		|func entry(args: List[String]):
		|	print(args.length().to_string())
	graph ?= callable_graph(source)
	identity ?= callable_header_by_name(graph, "identity")
	first ?= callable_header_by_name(graph, "first")
	length_of ?= callable_header_by_name(graph, "length_of")
	prepare_sql ?= callable_header_by_name(graph, "prepare_sql")
	receive_one ?= callable_header_by_name(graph, "receive_one")
	entry ?= callable_header_by_name(graph, "entry")
	identity_parameter ?= callable_header_parameters(identity).get(0)
	first_parameter ?= callable_header_parameters(first).get(0)
	identity_value ?= callable_signature_parameters(callable_header_signature(identity)).get(0)
	first_values ?= callable_signature_parameters(callable_header_signature(first)).get(0)
	length_values ?= callable_signature_parameters(callable_header_signature(length_of)).get(0)
	prepare_sql_value ?= callable_signature_parameters(
		callable_header_signature(prepare_sql),
	).get(0)
	receive_values ?= callable_signature_parameters(callable_header_signature(receive_one)).get(0)
	entry_signature = callable_header_signature(entry)
	entry_args ?= callable_signature_parameters(entry_signature).get(0)

	prepare_sql_shape_ok = match prepare_sql_value.typ:
		IntrinsicTypeShape(IntrinsicLiteralString, []):
			True
		_:
			False

	Some(
		(
			callable_header_parameters(identity).length() == 1
			and callable_header_parameters(first).length() == 1
			and callable_header_parameters(length_of).is_empty()
			and callable_header_parameters(prepare_sql).is_empty()
			and prepare_sql_shape_ok
			and callable_header_parameters(receive_one).is_empty()
			and callable_header_parameters(entry).is_empty()
			and callable_type_parameter_id_index(
				callable_type_parameter_id(identity_parameter),
			) == 0
			and callable_type_parameter_id_index(callable_type_parameter_id(first_parameter)) == 0
			and match identity_value.typ:
				CallableTypeParameterShape(_):
					match first_values.typ:
						ArrayTypeShape(IntrinsicTypeShape(IntrinsicInt, []), [CallableDimensionParameterShape(_, False)]):
							match length_values.typ:
								ArrayTypeShape(IntrinsicTypeShape(IntrinsicInt, []), [WildcardDimensionShape(False)]):
									match receive_values.typ:
										IntrinsicTypeShape(IntrinsicChannel, [IntrinsicTypeShape(IntrinsicInt, [])]):
											match (
												entry_args.typ,
												callable_signature_return_type(entry_signature),
											):
												(PreludeTypeShape(_, [IntrinsicTypeShape(IntrinsicString, [])]), IntrinsicTypeShape(IntrinsicVoid, [])):
													True
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		),
	)


pure func test_callable_headers_infer_implicit_parameters() -> Bool:
	callable_headers_infer_implicit_parameters().get_or(False)


private pure func global_headers_distinguish_pending_initializers() -> Option[Bool]:
	graph ?= callable_graph("annotated: Int = 1\n\ninferred = 2")
	annotated ?= global_header_by_name(graph, "annotated")
	inferred ?= global_header_by_name(graph, "inferred")

	Some(
		match (annotated, inferred):
			(AnnotatedGlobalHeader(_), PendingGlobalInitializer(_)):
				match annotated_global_header_type(annotated):
					Some(IntrinsicTypeShape(IntrinsicInt, [])):
						True
					_:
						False
			_:
				False
	)


pure func test_global_headers_distinguish_pending_initializers() -> Bool:
	global_headers_distinguish_pending_initializers().get_or(False)


private pure func callable_type_errors_are_precise() -> Option[Bool]:
	source = "pure func broken(value: missing_type):\n\t0"
	indexed ?= indexed_graph_build(fixture_module_load_candidate(source), []).to_option()
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	topology ?= trait_topology_graph_build(type_headers).to_option()

	match callable_header_graph_build(topology):
		Ok(_):
			Some(False)
		Err(errors):
			error ?= errors.get(0)
			span ?= callable_header_graph_error_span(error)
			Some(
				(
					callable_header_graph_error_message(
						error,
					) == "Unknown type 'missing_type' while resolving 'broken'"
					and span.path == "main.brp"
					and span.start_line == 1
				),
			)


pure func test_callable_type_errors_are_precise() -> Bool:
	callable_type_errors_are_precise().get_or(False)


tests: TestSuite = {
	description = "Compiler callable headers",
	tests = [
		("resolve exact signatures", test_callable_headers_resolve_exact_signatures),
		(
			"prepared context rejects foreign parameters",
			test_prepared_context_rejects_foreign_parameters,
		),
		(
			"prepared context rejects foreign graph scope",
			test_prepared_context_rejects_foreign_graph_scope,
		),
		(
			"prepared context rejects wrong same-graph scope",
			test_prepared_context_rejects_wrong_same_graph_scope,
		),
		(
			"prepared context resolves dimension constraints",
			test_prepared_context_resolves_dimension_constraints,
		),
		("callable and global ids are exact", test_callable_and_global_ids_are_exact),
		("index callable headers by module", test_callable_headers_are_indexed_by_module),
		("infer implicit callable parameters", test_callable_headers_infer_implicit_parameters),
		(
			"distinguish pending global initializers",
			test_global_headers_distinguish_pending_initializers,
		),
		("retain callable type error spans", test_callable_type_errors_are_precise),
	]
}
