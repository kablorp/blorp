import:
	../../../../src/compiler/stage_04_modules/loaded_module:
		ModuleOrigin(UserModule),
		resolved_module_identity_from_resolver,
	../../../../src/compiler/stage_04_modules/module_table: singleton_module_table
	../../../../src/compiler/stage_06_typecheck/graph/definition_index:
		DefinitionTable,
		definition_index_definition_table,
		definition_index_empty,
		definition_index_initial_seed,
	../../../../src/compiler/stage_06_typecheck/type_system/env: ENV_EMPTY
	../../../../src/compiler/stage_06_typecheck/type_system/meta_identity:
		BodyMetaSessionPurpose(
			NormalBodyMetaSession,
			CtfeSelectiveBodyMetaSession,
			CtfeEagerBodyMetaSession,
		),
		compilation_run_tokens_equal,
		meta_body_session,
		meta_global_session,
		meta_module_session,
		meta_session_ids_equal,
		new_compilation_run_token,


private pure func meta_session_test_definition_table() -> DefinitionTable:
	issued = singleton_module_table(
		resolved_module_identity_from_resolver(
			"meta_release_probe",
			UserModule,
		),
	)
	definition_index_definition_table(
		definition_index_empty(
			definition_index_initial_seed(ENV_EMPTY),
			issued[0],
		),
	)


func main(args: List[String]) -> Int:
	first_run = new_compilation_run_token()
	second_run = new_compilation_run_token()
	first_copy = first_run
	table = meta_session_test_definition_table()
	other_table = meta_session_test_definition_table()

	if (
		not compilation_run_tokens_equal(first_run, first_copy)
		or compilation_run_tokens_equal(first_run, second_run)
	):
		1
	else:
		match (
			(
				meta_body_session(first_run, table, 7, NormalBodyMetaSession, 0),
				meta_body_session(first_copy, table, 7, NormalBodyMetaSession, 0),
				meta_body_session(first_run, table, 7, CtfeSelectiveBodyMetaSession, 0),
				meta_body_session(first_run, table, 7, CtfeEagerBodyMetaSession, 0),
			),
			meta_body_session(first_run, table, 7, NormalBodyMetaSession, 1),
		):
			((Some(first), Some(same_key), Some(selective), Some(eager)), Some(recheck)):
				match (
					meta_module_session(first_run, table, 7, 0),
					meta_global_session(first_run, table, 7, 0),
					meta_body_session(first_run, other_table, 7, NormalBodyMetaSession, 0),
				):
					(Some(module_session), Some(global_session), Some(other_table_session)):
						if (
							meta_session_ids_equal(first, same_key)
							and not meta_session_ids_equal(first, selective)
							and not meta_session_ids_equal(first, eager)
							and not meta_session_ids_equal(selective, eager)
							and not meta_session_ids_equal(first, recheck)
							and not meta_session_ids_equal(first, module_session)
							and not meta_session_ids_equal(first, global_session)
							and not meta_session_ids_equal(module_session, global_session)
							and not meta_session_ids_equal(first, other_table_session)
						):
							0
						else:
							2
					_:
						3
			_:
				3
