import:
	../../../../src/compiler/stage_06_typecheck/type_system/int_literal_range:
		IntLiteralCheck(
			IntLiteralInFloatPosition,
			IntLiteralOfType,
			IntLiteralOutOfRange,
			IntLiteralRefinement,
		),
		IntLiteralSign(NegativeLiteral, NonNegativeLiteral),
		check_int_literal,
		int_literal_fits,
		int_literal_in_float_position_message,
		int_literal_out_of_range_message,
		int_literal_text,
		int_literal_value,
		int_literal_value_of_int,
		int_literal_value_of_signed_text,
		integer_type_range,
	../../../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticType(SemanticConstIntType, SemanticNamedType),
		TYPE_INT,
		types_equal,
	test: TestSuite


pure func named(name: String) -> SemanticType:
	SemanticNamedType(name, [])


pure func fits(type_name: String, sign: IntLiteralSign, digits: String) -> Bool:
	match integer_type_range(named(type_name)):
		Some(range):
			int_literal_fits(
				range,
				int_literal_value(sign, digits),
			)
		None:
			False


func test_values_are_canonical() -> Bool:
	(
		int_literal_text(int_literal_value(NonNegativeLiteral, "0042")) == "42"
		and int_literal_text(int_literal_value(NegativeLiteral, "0")) == "0"
		and int_literal_text(int_literal_value(NegativeLiteral, "000")) == "0"
		and int_literal_text(
			int_literal_value_of_int(-9223372036854775807 - 1),
		) == "-9223372036854775808"
		and int_literal_text(int_literal_value_of_signed_text("-128")) == "-128"
	)


func test_signed_bounds_are_inclusive() -> Bool:
	(
		fits("Int8", NonNegativeLiteral, "127")
		and not fits("Int8", NonNegativeLiteral, "128")
		and fits("Int8", NegativeLiteral, "128")
		and not fits("Int8", NegativeLiteral, "129")
		and fits("Int", NegativeLiteral, "9223372036854775808")
		and not fits("Int", NonNegativeLiteral, "9223372036854775808")
		and fits("Int64", NonNegativeLiteral, "9223372036854775807")
		and fits("Int128", NonNegativeLiteral, "170141183460469231731687303715884105727")
	)


func test_unsigned_bounds_are_inclusive() -> Bool:
	(
		fits("UInt8", NonNegativeLiteral, "255")
		and not fits("UInt8", NonNegativeLiteral, "256")
		and not fits("UInt8", NegativeLiteral, "1")
		and fits("UInt8", NegativeLiteral, "0")
		and fits("UInt64", NonNegativeLiteral, "18446744073709551615")
		and not fits("UInt64", NonNegativeLiteral, "18446744073709551616")
	)


func test_non_integer_types_have_no_range() -> Bool:
	integer_type_range(named("Float")).is_none() and integer_type_range(named("Char")).is_none()


func test_literal_takes_expected_integer_type() -> Bool:
	match check_int_literal(
		Some(named("UInt8")),
		int_literal_value(NonNegativeLiteral, "255"),
	):
		IntLiteralOfType(typ):
			types_equal(typ, named("UInt8"))
		_:
			False


func test_literal_without_expectation_is_checked_as_int() -> Bool:
	in_range = match check_int_literal(
		None,
		int_literal_value(NonNegativeLiteral, "7"),
	):
		IntLiteralOfType(typ):
			types_equal(typ, TYPE_INT)
		_:
			False

	beyond = match check_int_literal(
		None,
		int_literal_value(NonNegativeLiteral, "9223372036854775808"),
	):
		IntLiteralOutOfRange(range):
			range.type_name == "Int"
		_:
			False

	in_range and beyond


func test_dimension_expectation_keeps_refinement() -> Bool:
	match check_int_literal(
		Some(SemanticConstIntType(3)),
		int_literal_value(NonNegativeLiteral, "2"),
	):
		IntLiteralRefinement:
			True
		_:
			False


func test_float_expectation_is_reported() -> Bool:
	match check_int_literal(
		Some(named("Float32")),
		int_literal_value(NonNegativeLiteral, "3"),
	):
		IntLiteralInFloatPosition(typ):
			types_equal(typ, named("Float32"))
		_:
			False


func test_out_of_range_message_suggests_narrowest_wider_type() -> Bool:
	match integer_type_range(named("Int8")):
		Some(range):
			message = int_literal_out_of_range_message(
				range,
				int_literal_value(NonNegativeLiteral, "40000"),
			)
			message == "Integer literal 40000 does not fit in Int8\n    help: Int8 holds -128 to 127; use a value in that range or a wider type such as Int32"
		None:
			False


func test_negative_into_unsigned_suggests_signed_type() -> Bool:
	match integer_type_range(named("UInt16")):
		Some(range):
			message = int_literal_out_of_range_message(
				range,
				int_literal_value(NegativeLiteral, "200"),
			)
			message == "Integer literal -200 does not fit in UInt16\n    help: UInt16 holds 0 to 65535; use a value in that range or a signed type such as Int16"
		None:
			False


func test_float_position_message_shows_float_spelling() -> Bool:
	int_literal_in_float_position_message(
		"Float",
		int_literal_value(NegativeLiteral, "2"),
	) == "Integer literal -2 is not a Float\n    help: write -2.0 for a Float value"


tests: TestSuite = {
	description = "Integer literal range checks",
	tests = [
		("values are canonical", test_values_are_canonical),
		("signed bounds are inclusive", test_signed_bounds_are_inclusive),
		("unsigned bounds are inclusive", test_unsigned_bounds_are_inclusive),
		("non-integer types have no range", test_non_integer_types_have_no_range),
		("literal takes expected integer type", test_literal_takes_expected_integer_type),
		(
			"literal without expectation is checked as Int",
			test_literal_without_expectation_is_checked_as_int,
		),
		("dimension expectation keeps refinement", test_dimension_expectation_keeps_refinement),
		("float expectation is reported", test_float_expectation_is_reported),
		(
			"out-of-range message suggests narrowest wider type",
			test_out_of_range_message_suggests_narrowest_wider_type,
		),
		(
			"negative into unsigned suggests signed type",
			test_negative_into_unsigned_suggests_signed_type,
		),
		(
			"float position message shows float spelling",
			test_float_position_message_shows_float_spelling,
		),
	]
}
