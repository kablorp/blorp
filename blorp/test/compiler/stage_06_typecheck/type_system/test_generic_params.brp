import:
	../../../../src/compiler/stage_04_modules/loaded_module:
		ModuleOrigin(UserModule),
		resolved_module_identity_from_resolver,
	../../../../src/compiler/stage_04_modules/module_table:
		module_table,
		module_table_find_id_by_canonical_path,
	../../../../src/compiler/stage_06_typecheck/type_system/generic_params:
		BoundTraitIdentity,
		BoundTraitOwner(CompilerBuiltinBoundTraitOwner, GraphBoundTraitOwner),
		bound_trait_identities_equal,
		bound_type_param_name,
		bound_type_param_to_parser_string,
		make_bound_type_param,
	../../../../src/lib/source: SourceSpan, source_file, source_span, source_start
	test: TestSuite


func test_source_spelling() -> Bool:
	bounded = make_bound_type_param(
		"T",
		["Stringable", "Showable"],
	)
	unbounded = make_bound_type_param("U", [])

	(
		bound_type_param_name(bounded) == "T"
		and bounded.bounds == ["Stringable", "Showable"]
		and bound_type_param_to_parser_string(bounded) == "T:Stringable+Showable"
		and bound_type_param_name(unbounded) == "U"
		and unbounded.bounds.length() == 0
		and bound_type_param_to_parser_string(unbounded) == "U"
	)


func test_param_list_helpers() -> Bool:
	params = [make_bound_type_param("T", ["Equatable"]), make_bound_type_param("U", [])]

	(
		params.map(bound_type_param_name) == ["T", "U"]
		and params.map(bound_type_param_to_parser_string) == ["T:Equatable", "U"]
	)


func test_constructor_helpers() -> Bool:
	param = make_bound_type_param(
		"Item",
		["Hashable", "Equatable"],
	)

	bound_type_param_name(param) == "Item" and param.bounds == ["Hashable", "Equatable"]


private pure func test_span() -> SourceSpan:
	source = source_file("traits.brp", "traits", "trait First:\n\tpure func first()")
	start = source_start(source)
	source_span(source, start, start)


private pure func bound_trait_identity_equality_is_exact() -> Option[Bool]:
	table ?= module_table(
		[resolved_module_identity_from_resolver("traits", UserModule)],
	).to_option()
	module_id ?= module_table_find_id_by_canonical_path(table, "traits")
	span = test_span()
	first: BoundTraitIdentity = {
		owner = GraphBoundTraitOwner(module_id),
		definition_id = 10,
		name = "First",
		span = span
	}
	second = { first |
		definition_id = 11,
		name = "Second"
	}
	builtin_first = { first | owner = CompilerBuiltinBoundTraitOwner }
	builtin_second = { second | owner = CompilerBuiltinBoundTraitOwner }

	Some(
		(
			bound_trait_identities_equal(first, first)
			and not bound_trait_identities_equal(first, second)
			and bound_trait_identities_equal(builtin_first, builtin_first)
			and not bound_trait_identities_equal(builtin_first, builtin_second)
		),
	)


func test_bound_trait_identity_equality_is_exact() -> Bool:
	bound_trait_identity_equality_is_exact().get_or(False)


tests: TestSuite = {
	description = "Compiler generic parameter helpers",
	tests = [
		("source spelling", test_source_spelling),
		("param list helpers", test_param_list_helpers),
		("constructor helpers", test_constructor_helpers),
		("bound trait identity equality is exact", test_bound_trait_identity_equality_is_exact),
	]
}
