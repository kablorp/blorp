func test_module_function_lookup_uses_module_path() -> Bool:
	local_func = func_symbol(
		1,
		SemanticFunctionType(True, [TYPE_INT], TYPE_INT),
		[],
		[Some("value")],
		Pure,
		UserDefinedFunc,
		RejectResourceArgs,
		None,
		[],
		None,
		False,
	)
	imported_func = func_symbol(
		2,
		SemanticFunctionType(True, [TYPE_STRING], TYPE_STRING),
		[],
		[Some("value")],
		Pure,
		UserDefinedFunc,
		RejectResourceArgs,
		Some("text"),
		[],
		None,
		False,
	)
	env = env_add_func_with_info(
		env_add_func_with_info(ENV_EMPTY, "trim", local_func),
		"trim",
		imported_func,
	)

	match env_get_module_func_symbol(env, "text", "trim"):
		Some(function_symbol):
			(
				function_symbol.callable_id == 2
				and env_get_module_func_symbol(env, "other", "trim").is_none()
				and env_get_module_func_symbol(env, "text", "missing").is_none()
			)
		None:
			False


func test_function_lookup_uses_name_index_and_callable_id() -> Bool:
	int_func = func_symbol(
		10,
		SemanticFunctionType(True, [TYPE_INT], TYPE_INT),
		[],
		[Some("value")],
		Pure,
		UserDefinedFunc,
		RejectResourceArgs,
		None,
		[],
		None,
		False,
	)
	string_func = func_symbol(
		11,
		SemanticFunctionType(True, [TYPE_STRING], TYPE_STRING),
		[],
		[Some("value")],
		Pure,
		UserDefinedFunc,
		RejectResourceArgs,
		None,
		[],
		None,
		False,
	)
	env = env_add_func_with_info(
		env_add_func_with_info(ENV_EMPTY, "convert", int_func),
		"convert",
		string_func,
	)

	match (
		env_find_func_named_by_def_id(env, "convert", 10),
		env_find_func_named_by_def_id(env, "convert", 11),
	):
		(Some(first), Some(second)):
			(
				types_equal(first.func_type, int_func.func_type)
				and types_equal(second.func_type, string_func.func_type)
				and env_find_func_named_by_def_id(env, "convert", 12).is_none()
				and env_find_func_named_by_def_id(env, "missing", 10).is_none()
			)
		_:
			False


func test_function_lookup_by_callable_id_preserves_scope_and_declaration_order() -> Bool:
	older = func_symbol(
		40,
		SemanticFunctionType(True, [TYPE_INT], TYPE_INT),
		[],
		[Some("value")],
		Pure,
		UserDefinedFunc,
		RejectResourceArgs,
		None,
		[],
		None,
		False,
	)
	newer = func_symbol(
		40,
		SemanticFunctionType(True, [TYPE_STRING], TYPE_STRING),
		[],
		[Some("value")],
		Pure,
		UserDefinedFunc,
		RejectResourceArgs,
		None,
		[],
		None,
		False,
	)
	inner = func_symbol(
		40,
		SemanticFunctionType(True, [TYPE_FLOAT], TYPE_FLOAT),
		[],
		[Some("value")],
		Pure,
		UserDefinedFunc,
		RejectResourceArgs,
		None,
		[],
		None,
		False,
	)
	same_scope = env_add_func_with_info(
		env_add_var(
			env_add_func_with_info(ENV_EMPTY, "older", older),
			"not_a_function",
			TYPE_BOOL,
		),
		"newer",
		newer,
	)
	nested_scope = env_add_func_with_info(env_push_scope(same_scope), "inner", inner)
	unrelated_inner_scope = env_add_var(env_push_scope(same_scope), "inner_value", TYPE_BOOL)
	branched_scope = env_add_func_with_info(same_scope, "branch", inner)

	match (
		env_find_func_by_def_id(same_scope, 40),
		env_find_func_by_def_id(nested_scope, 40),
		env_find_func_by_def_id(unrelated_inner_scope, 40),
		env_find_func_by_def_id(branched_scope, 40),
	):
		(Some(same_scope_match), Some(inner_scope_match), Some(outer_scope_match), Some(branched_scope_match)):
			(
				types_equal(same_scope_match.func_type, newer.func_type)
				and types_equal(inner_scope_match.func_type, inner.func_type)
				and types_equal(outer_scope_match.func_type, newer.func_type)
				and types_equal(branched_scope_match.func_type, inner.func_type)
				and env_find_func_by_def_id(nested_scope, 41).is_none()
			)
		_:
			False


func test_prepared_module_declarations_create_isolated_root_environments() -> Bool:
	function = func_symbol(
		40,
		SemanticFunctionType(True, [TYPE_INT], TYPE_INT),
		[],
		[Some("value")],
		Pure,
		UserDefinedFunc,
		RejectResourceArgs,
		None,
		[],
		None,
		False,
	)
	base = env_add_func_with_info(
		env_add_var(ENV_EMPTY, "root_value", TYPE_INT),
		"root_function",
		function,
	)

	match prepare_module_declaration_env(base):
		None:
			False
		Some(prepared):
			first = env_from_prepared_module_declarations(prepared)
			first_nested = env_set_type_param_bounds(
				env_add_var(env_push_scope(first), "body_local", TYPE_STRING),
				[make_bound_type_param("T", [])],
			)
			(second_after_mint, second_id) = env_mint_def_id(
				env_from_prepared_module_declarations(prepared),
			)
			third = env_from_prepared_module_declarations(prepared)

			match (
				env_get_var_type(first_nested, "body_local"),
				env_get_var_type(third, "body_local"),
				env_find_func_by_def_id(third, 40),
			):
				(Some(local_type), None, Some(root_function)):
					(
						types_equal(local_type, TYPE_STRING)
						and types_equal(root_function.func_type, function.func_type)
						and env_get_type_params(first_nested) == ["T"]
						and env_get_type_params(third).is_empty()
						and prepare_module_declaration_env(first_nested).is_none()
						and prepare_infer_session_env(env_push_scope(first)).is_none()
						and second_id == base.next_def_id
						and second_after_mint.next_def_id == base.next_def_id + 1
						and third.next_def_id == base.next_def_id
					)
				_:
					False


func test_module_ufcs_lookup_filters_module_and_receiver() -> Bool:
	string_entry = { overload_entry(20, TYPE_STRING, TYPE_INT) | module_path = Some("text") }
	int_entry = { overload_entry(21, TYPE_INT, TYPE_FLOAT) | module_path = Some("text") }
	other_module_entry = { overload_entry(22, TYPE_STRING, TYPE_BOOL) |
		module_path = Some("other")
	}
	env = env_add_ufcs_method(
		env_add_ufcs_method(
			env_add_ufcs_method(ENV_EMPTY, "size", string_entry),
			"size",
			int_entry,
		),
		"size",
		other_module_entry,
	)
	matches = env_lookup_module_ufcs_methods(env, "text", "size", TYPE_STRING)
	wrong_receiver = env_lookup_module_ufcs_methods(env, "text", "size", TYPE_BOOL)
	wrong_module = env_lookup_module_ufcs_methods(env, "missing", "size", TYPE_STRING)

	match matches.get(0):
		Some(entry):
			(
				matches.length() == 1
				and entry.def_id == 20
				and wrong_receiver.length() == 0
				and wrong_module.length() == 0
			)
		None:
			False


