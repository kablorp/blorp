		(
			"same-scope lookup preserves latest symbol and full history",
			test_same_scope_lookup_preserves_latest_symbol_and_full_history,
		),
		(
			"symbol history preserves scope and declaration order",
			test_symbol_history_preserves_scope_and_declaration_order,
		),
		(
			"constructor lookup preserves same-name candidates",
			test_constructor_lookup_preserves_same_name_candidates,
		),
		(
			"union constructor batch preserves intra-group order and ids",
			test_union_constructor_batch_preserves_intra_group_order_and_ids,
		),
		(
			"accepted union constructor batch retains containment facts",
			test_accepted_union_constructor_batch_retains_containment_facts,
		),
		(
			"type registration without constructors consumes no ids",
			test_type_registration_without_constructors_consumes_no_ids,
		),
		(
			"issue16 public batch edges preserve env behavior",
			test_issue16_public_batch_edges_preserve_env_behavior,
		),
		(
			"issue16 public batch histories and scope restoration",
			test_issue16_public_batch_histories_and_scope_restoration,
		),
		(
			"union constructor batch preserves scope snapshots",
			test_union_constructor_batch_preserves_scope_snapshots,
		),
		(
			"type record alias and nominal dim resolution",
			test_type_record_alias_and_nominal_dim_resolution,
		),
		(
			"type registration summarizes containment conservatively",
			test_type_registration_summarizes_containment_conservatively,
		),
		(
			"type registration invalidates containment when binding changes",
			test_type_registration_invalidates_containment_when_binding_changes,
		),
		(
			"accepted shadow invalidates only inferred containment",
			test_accepted_shadow_invalidates_only_inferred_containment,
		),
		("accepted containment facts follow scopes", test_accepted_containment_facts_follow_scopes),
		(
			"type registration uses reserved constructor ids",
			test_type_registration_uses_reserved_constructor_ids,
		),
		("nested generic alias resolution", test_nested_generic_alias_resolution),
		("alias resolution terminates cycles", test_alias_resolution_terminates_cycles),
