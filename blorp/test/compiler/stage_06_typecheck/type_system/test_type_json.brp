import:
	../../../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticDimOp(SemanticDimAdd, SemanticDimMultiply),
		SemanticType(
			SemanticArrayType,
			SemanticConstIntType,
			SemanticDimOpType,
			SemanticFunctionType,
			SemanticMetaType,
			SemanticNamedType,
			SemanticRangeType,
			SemanticTypeVar,
			SemanticVarDimsType,
		),
		TYPE_BOOL,
		TYPE_INT,
		TYPE_STRING,
	../../../../src/compiler/stage_06_typecheck/type_system/type_json:
		dim_op_to_json,
		optional_type_to_json,
		type_list_to_json,
		type_to_json,
	json: JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector)
	test: TestSuite


pure func json_values_equal(left: JsonValue, right: JsonValue) -> Bool:
	left.to_string() == right.to_string()


func test_named_type_json_preserves_args() -> Bool:
	encoded = type_to_json(
		SemanticNamedType(
			"Result",
			[TYPE_INT, TYPE_STRING],
		),
	)
	expected = JsonObject([
		("kind", JsonString("named")),
		("name", JsonString("Result")),
		("args", JsonVector([JsonObject([
				("kind", JsonString("named")),
				("name", JsonString("Int")),
				("args", JsonVector([])),
			]), JsonObject([
				("kind", JsonString("named")),
				("name", JsonString("String")),
				("args", JsonVector([])),
			])])),
	])

	json_values_equal(encoded, expected)


func test_function_type_json_preserves_purity_and_return_type() -> Bool:
	encoded = type_to_json(
		SemanticFunctionType(
			True,
			[TYPE_INT, TYPE_STRING],
			TYPE_BOOL,
		),
	)
	expected = JsonObject([
		("kind", JsonString("function")),
		("pure", JsonBool(True)),
		("params", JsonVector([type_to_json(TYPE_INT), type_to_json(TYPE_STRING)])),
		("return_type", type_to_json(TYPE_BOOL)),
	])

	json_values_equal(encoded, expected)


func test_array_type_json_preserves_dimension_expression() -> Bool:
	dim = SemanticDimOpType(SemanticDimAdd, SemanticVarDimsType("#N"), SemanticConstIntType(1))
	encoded = type_to_json(SemanticArrayType(TYPE_INT, [dim]))
	expected = JsonObject([
		("kind", JsonString("array")),
		("element", type_to_json(TYPE_INT)),
		("dims", JsonVector([type_to_json(dim)])),
	])

	json_values_equal(encoded, expected)


func test_type_json_covers_remaining_structural_variants() -> Bool:
	values = type_list_to_json([
		SemanticTypeVar("T"),
		SemanticRangeType(SemanticConstIntType(3)),
		SemanticMetaType(7),
	])
	expected = JsonVector([JsonObject([
			("kind", JsonString("type_var")),
			("name", JsonString("T")),
		]), JsonObject([
			("kind", JsonString("range")),
			("inner", type_to_json(SemanticConstIntType(3))),
		]), JsonObject([("kind", JsonString("meta")), ("id", JsonNumber(7.0))])])

	json_values_equal(values, expected)


func test_optional_type_json_and_dim_op_tags() -> Bool:
	(
		json_values_equal(optional_type_to_json(None), JsonNull)
		and json_values_equal(optional_type_to_json(Some(TYPE_INT)), type_to_json(TYPE_INT))
		and json_values_equal(dim_op_to_json(SemanticDimMultiply), JsonString("multiply"))
	)


func test_const_int_json_is_exact() -> Bool:
	exact_value: Int = 2097152 * 4294967296 + 1
	json_values_equal(type_to_json(SemanticConstIntType(exact_value)), JsonObject([
			("kind", JsonString("const_int")),
			("value", JsonString("9007199254740993")),
		]))


func test_const_int_json_preserves_full_int_range() -> Bool:
	large_value: Int = 2147483648 * 2147483648
	json_values_equal(type_to_json(SemanticConstIntType(large_value)), JsonObject([
			("kind", JsonString("const_int")),
			("value", JsonString("4611686018427387904")),
		]))


tests: TestSuite = {
	description = "Compiler type JSON",
	tests = [
		("named type JSON preserves args", test_named_type_json_preserves_args),
		(
			"function type JSON preserves purity and return type",
			test_function_type_json_preserves_purity_and_return_type,
		),
		(
			"array type JSON preserves dimension expression",
			test_array_type_json_preserves_dimension_expression,
		),
		(
			"type JSON covers remaining structural variants",
			test_type_json_covers_remaining_structural_variants,
		),
		("optional type JSON and dim op tags", test_optional_type_json_and_dim_op_tags),
		("const int JSON is exact", test_const_int_json_is_exact),
		("const int JSON preserves full Int range", test_const_int_json_preserves_full_int_range),
	]
}
