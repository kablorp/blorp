import:
	../../../../src/compiler/stage_04_modules/loaded_module:
		ModuleOrigin(UserModule),
		resolved_module_identity_from_resolver,
	../../../../src/compiler/stage_04_modules/module_table: singleton_module_table
	../../../../src/compiler/stage_06_typecheck/graph/definition_index:
		definition_index_definition_table,
		definition_index_empty,
		definition_index_initial_seed,
	../../../../src/compiler/stage_06_typecheck/type_system/context:
		Context,
		FreshMetaStep,
		PreparedInferContextFacts,
		bind_meta,
		context_empty,
		context_for_meta_session,
		context_from_prepared_infer_facts,
		fresh_meta,
		fresh_meta_with_origin,
		lookup_meta,
		meta_origin_name,
		meta_solver_session,
		occurs_meta,
		reset_meta,
	../../../../src/compiler/stage_06_typecheck/type_system/env: ENV_EMPTY
	../../../../src/compiler/stage_06_typecheck/type_system/meta_identity:
		MetaSessionId,
		meta_module_session,
		new_compilation_run_token,
	../../../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticType(SemanticMetaType, SemanticTypeVar),


func test_meta_context() -> Context:
	module_table = singleton_module_table(
		resolved_module_identity_from_resolver(
			"meta_test_support",
			UserModule,
		),
	)
	definition_table = definition_index_definition_table(
		definition_index_empty(
			definition_index_initial_seed(ENV_EMPTY),
			module_table[0],
		),
	)
	session = meta_module_session(new_compilation_run_token(), definition_table, 0, 0)

	match session:
		Some(issued):
			context_for_meta_session(context_empty(), issued)
		None:
			context_empty()


func test_context_from_prepared(facts: PreparedInferContextFacts) -> Context:
	fresh = test_meta_context()

	match meta_solver_session(fresh):
		Some(session):
			context_from_prepared_infer_facts(facts, session)
		None:
			context_empty()


pure func test_meta(context: Context, slot: Int) -> SemanticType:
	match meta_solver_session(context):
		Some(session):
			SemanticMetaType(session, slot)
		None:
			SemanticTypeVar("<missing test meta session>")


func test_meta_type(slot: Int) -> SemanticType:
	context = test_meta_context()
	test_meta(context, slot)


pure func test_fresh_meta(context: Context) -> FreshMetaStep:
	fresh_meta(context).get_or({
		context = context,
		meta_type = SemanticTypeVar("<failed test meta allocation>"),
	})


pure func test_fresh_meta_with_origin(context: Context, origin: String) -> FreshMetaStep:
	fresh_meta_with_origin(context, origin).get_or({
		context = context,
		meta_type = SemanticTypeVar("<failed test meta allocation>"),
	})


pure func test_bind_meta(context: Context, slot: Int, typ: SemanticType) -> Option[Context]:
	match meta_solver_session(context):
		Some(session):
			bind_meta(context, session, slot, typ)
		None:
			None


pure func test_lookup_meta(context: Context, slot: Int) -> Option[SemanticType]:
	match meta_solver_session(context):
		Some(session):
			lookup_meta(context, session, slot)
		None:
			None


pure func test_meta_origin_name(context: Context, slot: Int) -> String:
	match meta_solver_session(context):
		Some(session):
			meta_origin_name(context, session, slot)
		None:
			"?m" + slot.to_string()


pure func test_occurs_meta(context: Context, slot: Int, typ: SemanticType) -> Bool:
	match meta_solver_session(context):
		Some(session):
			occurs_meta(context, session, slot, typ)
		None:
			False


func test_reset_meta(context: Context) -> Context:
	fresh = test_meta_context()

	match meta_solver_session(fresh):
		Some(session):
			reset_meta(context, session)
		None:
			context
