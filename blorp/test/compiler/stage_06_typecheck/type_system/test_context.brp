func test_module_origin_policies() -> Bool:
	match (
		source_package_origin(" sqlite "),
		source_package_origin("  "),
		native_package_origin(" raylib "),
	):
		(Some(source_origin), None, Some(native_origin)):
			(
				module_origin_is_std(StdlibModule)
				and not module_origin_is_std(UserModule)
				and module_origin_is_package(source_origin)
				and module_origin_is_package(native_origin)
				and module_origin_is_source_package(source_origin)
				and not module_origin_is_source_package(native_origin)
				and module_origin_allows_builtin(StdlibModule)
				and not module_origin_allows_builtin(source_origin)
				and module_origin_allows_foreign(UserModule)
				and module_origin_allows_foreign(native_origin)
				and not module_origin_allows_foreign(source_origin)
				and module_origin_label(source_origin) == "source package 'sqlite'"
				and module_origin_label(native_origin) == "native package 'raylib'"
			)
		_:
			False


func test_resource_cleanup_registration_is_context_local() -> Bool:
	base = CONTEXT_EMPTY
	with_cleanup = register_resource_cleanup(base, "File", "close_file")
	updated = register_resource_cleanup(with_cleanup, "File", "close_file_now")

	match (
		find_resource_cleanup(base, "File"),
		find_resource_cleanup(with_cleanup, "File"),
		find_resource_cleanup(updated, "File"),
	):
		(None, Some(first_cleanup), Some(updated_cleanup)):
			first_cleanup == "close_file" and updated_cleanup == "close_file_now"
		_:
			False


func test_prepared_infer_context_facts_create_fresh_sessions() -> Bool:
	with_cleanup = register_resource_cleanup(CONTEXT_EMPTY, "File", "close_file")
	issued = fresh_meta_with_origin(with_cleanup, "T")
	bound = bind_meta(issued.context, 0, TYPE_INT).get_or(issued.context)
	contaminated = { bound |
		def_id_counter = 7,
		lower_destruct_counter = 2,
		lower_param_counter = 3,
		lower_question_bind_counter = 4,
		lower_resource_counter = 5,
		lower_task_scope_counter = 6,
		lower_current_task_scope_id = 7,
		desugar_counter = 8,
		ssa_mut_counter = 9
	}
	facts = prepared_infer_context_facts(contaminated)
	first = context_from_prepared_infer_facts(facts)
	mutated = fresh_meta(first).context
	second = context_from_prepared_infer_facts(facts)

	(
		find_resource_cleanup(first, "File") == Some("close_file")
		and find_resource_cleanup(second, "File") == Some("close_file")
		and lookup_meta(contaminated, 0) == Some(TYPE_INT)
		and types_equal(fresh_meta(mutated).meta_type, SemanticMetaType(1))
		and meta_origin_name(second, 0) == "?m0"
		and lookup_meta(second, 0).is_none()
		and second.def_id_counter == 0
		and types_equal(fresh_meta(second).meta_type, SemanticMetaType(0))
		and second.lower_destruct_counter == 0
		and second.lower_param_counter == 0
		and second.lower_question_bind_counter == 0
		and second.lower_resource_counter == 0
		and second.lower_task_scope_counter == 1
		and second.lower_current_task_scope_id == 0
		and second.desugar_counter == 0
		and second.ssa_mut_counter == 0
	)


func test_context_counters_and_meta_reset() -> Bool:
	start = CONTEXT_EMPTY
	first_id = mint_def_id(start)
	second_id = mint_def_id(first_id.context)
	first_meta = fresh_meta(second_id.context)
	second_meta = fresh_meta(first_meta.context)
	meta_reset = reset_meta(second_meta.context)
	third_meta = fresh_meta(meta_reset)
	advanced = { third_meta.context |
		def_id_counter = 9,
		lower_destruct_counter = 2,
		lower_param_counter = 3,
		lower_question_bind_counter = 4,
		lower_resource_counter = 5,
		lower_task_scope_counter = 6,
		lower_current_task_scope_id = 7,
		desugar_counter = 8,
		ssa_mut_counter = 9
	}
	core_reset = reset_core_counters(advanced)

	match (first_meta.meta_type, second_meta.meta_type, third_meta.meta_type):
		(SemanticMetaType(first_meta_id), SemanticMetaType(second_meta_id), SemanticMetaType(third_meta_id)):
			(
				first_id.def_id == 0
				and second_id.def_id == 1
				and first_meta_id == 0
				and second_meta_id == 1
				and third_meta_id == 0
				and meta_reset.def_id_counter == 2
				and core_reset.def_id_counter == 0
				and core_reset.lower_destruct_counter == 0
				and core_reset.lower_param_counter == 0
				and core_reset.lower_question_bind_counter == 0
				and core_reset.lower_resource_counter == 0
				and core_reset.lower_task_scope_counter == 1
				and core_reset.lower_current_task_scope_id == 0
				and core_reset.desugar_counter == 0
				and core_reset.ssa_mut_counter == 0
				and types_equal(fresh_meta(core_reset).meta_type, SemanticMetaType(1))
			)
		_:
			False


func test_meta_bindings_head_resolve_and_zonk() -> Bool:
	first_meta = fresh_meta_with_origin(CONTEXT_EMPTY, "T")
	second_meta = fresh_meta_with_origin(first_meta.context, "U")
	third_meta = fresh_meta_with_origin(second_meta.context, "V")
	bound_one = bind_meta(third_meta.context, 1, type_list(TYPE_INT)).get_or(third_meta.context)
	context_with_chain = bind_meta(bound_one, 0, SemanticMetaType(1)).get_or(bound_one)
	nested: SemanticType = SemanticNamedType(
		"Box",
		[SemanticMetaType(0), SemanticMetaType(2), SemanticMetaType(9)],
	)
	zonked: SemanticType = zonk_type(context_with_chain, nested)

	match lookup_meta(context_with_chain, 0):
		Some(bound_zero):
			types_equal(bound_zero, SemanticMetaType(1)) and types_equal(
				head_resolve(context_with_chain, SemanticMetaType(0)),
				type_list(TYPE_INT),
			) and types_equal(
				zonked,
				SemanticNamedType(
					"Box",
					[type_list(TYPE_INT), SemanticTypeVar("V"), SemanticMetaType(9)],
				),
			) and meta_origin_name(
				context_with_chain,
				2,
			) == "V" and meta_origin_name(
				context_with_chain,
				9,
			) == "?m9" and occurs_meta(context_with_chain, 1, SemanticMetaType(0))
		None:
			False


func test_head_resolve_follows_long_issued_chain() -> Bool:
	var context = CONTEXT_EMPTY

	for _ in 0..64:
		context = fresh_meta(context).context

	var valid: Bool = True

	for index in 0..64:
		binding = if index + 1 < 64:
			SemanticMetaType(index + 1)
		else:
			TYPE_INT

		match bind_meta(context, index, binding):
			Some(bound):
				context = bound
			None:
				valid = False

	valid and types_equal(
		head_resolve(context, SemanticMetaType(0)),
		TYPE_INT,
	)


func test_full_resolution_preserves_long_chain_and_unbound_recovery() -> Bool:
	var context = CONTEXT_EMPTY
	var valid: Bool = True

	for _ in 0..64:
		context = fresh_meta(context).context

	for index in 0..64:
		binding = if index + 1 < 64:
			SemanticMetaType(index + 1)
		else:
			TYPE_INT

		match bind_meta(context, index, binding):
			Some(bound):
				context = bound
			None:
				valid = False

	nested = SemanticNamedType(
		"Pair",
		[SemanticMetaType(0), SemanticMetaType(63), SemanticMetaType(64)],
	)
	valid and types_equal(
		zonk_type(context, nested),
		SemanticNamedType(
			"Pair",
			[TYPE_INT, TYPE_INT, SemanticMetaType(64)],
		),
	) and types_equal(
		resolve_type_metas(context, nested),
		SemanticNamedType(
			"Pair",
			[TYPE_INT, TYPE_INT, SemanticMetaType(64)],
		),
	)


func test_zonk_preserves_meta_free_recursive_type() -> Bool:
	meta_free: SemanticType = SemanticFunctionType(
		True,
		[SemanticNamedType("Box", [SemanticTupleType([TYPE_INT, SemanticRangeType(TYPE_STRING)])])],
		SemanticArrayType(
			TYPE_INT,
			[
				SemanticDimOpType(
					SemanticDimMultiply,
					SemanticConstIntType(2),
					SemanticConstIntType(3),
				),
				SemanticVarDimsType("#Ds"),
			],
		),
	)

	types_equal(
		zonk_type(CONTEXT_EMPTY, meta_free),
		meta_free,
	)


func test_resolve_type_metas_reuses_meta_free_recursive_type() -> Bool:
	meta_free: SemanticType = SemanticFunctionType(
		True,
		[SemanticNamedType("Box", [SemanticTupleType([TYPE_INT, SemanticRangeType(TYPE_STRING)])])],
		SemanticArrayType(
			TYPE_INT,
			[
				SemanticDimOpType(
					SemanticDimMultiply,
					SemanticConstIntType(2),
					SemanticConstIntType(3),
				),
			],
		),
	)

	reset_mem_stats()
	resolved = resolve_type_metas(CONTEXT_EMPTY, meta_free)
	stats = get_mem_stats()

	stats.total_allocations == 0 and types_equal(resolved, meta_free)


func test_resolve_type_metas_reuses_unbound_recursive_type() -> Bool:
	issued = fresh_meta(CONTEXT_EMPTY)
	unbound: SemanticType = SemanticNamedType(
		"Box",
		[issued.meta_type, TYPE_INT],
	)

	reset_mem_stats()
	resolved = resolve_type_metas(issued.context, unbound)
	stats = get_mem_stats()

	stats.total_allocations == 0 and types_equal(resolved, unbound)


func test_zonk_keeps_unissued_meta_unresolved_after_reset() -> Bool:
	first = fresh_meta(CONTEXT_EMPTY)
	second = fresh_meta(first.context)
	reset = reset_meta(second.context)

	types_equal(
		zonk_type(first.context, first.meta_type),
		SemanticTypeVar("?"),
	) and types_equal(
		zonk_type(first.context, second.meta_type),
		second.meta_type,
	) and types_equal(
		zonk_type(reset, second.meta_type),
		second.meta_type,
	) and types_equal(
		zonk_type(CONTEXT_EMPTY, SemanticMetaType(-1)),
		SemanticMetaType(-1),
	)


func test_meta_origins_are_dense_by_meta_id() -> Bool:
	first_meta = fresh_meta_with_origin(CONTEXT_EMPTY, "T")
	second_meta = fresh_meta_with_origin(first_meta.context, "U")

	(
		meta_origin_name(second_meta.context, 0) == "T"
		and meta_origin_name(second_meta.context, 1) == "U"
		and meta_origin_name(second_meta.context, 2) == "?m2"
	)


func test_resolve_type_metas_preserves_unbound_inference_identity() -> Bool:
	first_meta = fresh_meta_with_origin(CONTEXT_EMPTY, "T")
	second_meta = fresh_meta_with_origin(first_meta.context, "U")
	bound_context = bind_meta(second_meta.context, 1, TYPE_STRING).get_or(second_meta.context)
	nested: SemanticType = SemanticNamedType(
		"Pair",
		[first_meta.meta_type, second_meta.meta_type],
	)

	types_equal(
		resolve_type_metas(
			bound_context,
			nested,
		),
		SemanticNamedType(
			"Pair",
			[first_meta.meta_type, TYPE_STRING],
		),
	)


func test_meta_reset_clears_bindings_and_origins() -> Bool:
	meta_step = fresh_meta_with_origin(CONTEXT_EMPTY, "T")
	bound_context = bind_meta(meta_step.context, 0, TYPE_INT).get_or(meta_step.context)
	reset_context = reset_meta(bound_context)
	fresh_after_reset = fresh_meta(reset_context)

	match fresh_after_reset.meta_type:
		SemanticMetaType(meta_id):
			(
				meta_id == 0
				and lookup_meta(reset_context, 0).is_none()
				and meta_origin_name(reset_context, 0) == "?m0"
			)
		_:
			False


func subst_has(step: UnifyStep, name: String, expected: SemanticType) -> Bool:
	match unify_subst_lookup(step, name):
		Some(actual):
			types_equal(actual, expected)
		None:
			False


func test_unify_binds_meta_and_rejects_occurs() -> Bool:
	issued = fresh_meta(CONTEXT_EMPTY)
	bind_result = unify(issued.context, issued.meta_type, TYPE_INT)
	occurs_result = unify(issued.context, issued.meta_type, type_list(issued.meta_type))

	match bind_result:
		Some(step):
			match lookup_meta(step.context, 0):
				Some(binding):
					types_equal(binding, TYPE_INT) and occurs_result.is_none()
				None:
					False
		None:
			False


func test_unification_rejects_meta_not_issued_by_session() -> Bool:
	(
		unify(CONTEXT_EMPTY, SemanticMetaType(0), TYPE_INT).is_none()
		and bind_meta(CONTEXT_EMPTY, 0, TYPE_INT).is_none()
		and bind_meta(CONTEXT_EMPTY, -1, TYPE_INT).is_none()
		and lookup_meta(CONTEXT_EMPTY, 0).is_none()
	)


func test_binding_rejects_self_reference() -> Bool:
	issued = fresh_meta(CONTEXT_EMPTY)
	bind_meta(issued.context, 0, SemanticMetaType(0)).is_none()


func test_binding_rejects_unissued_nested_meta() -> Bool:
	issued = fresh_meta(CONTEXT_EMPTY)
	bind_meta(issued.context, 0, type_list(SemanticMetaType(1))).is_none()


func test_unification_rejects_equal_unissued_metas() -> Bool:
	issued = fresh_meta(CONTEXT_EMPTY)

	(
		unify(CONTEXT_EMPTY, SemanticMetaType(0), SemanticMetaType(0)).is_none()
		and unify(
			issued.context,
			type_list(SemanticMetaType(1)),
			type_list(SemanticMetaType(1)),
		).is_none()
		and unify(issued.context, issued.meta_type, issued.meta_type).is_some()
	)


func test_unification_rejects_unissued_meta_in_type_var_substitution() -> Bool:
	issued = fresh_meta(CONTEXT_EMPTY)

	(
		unify(CONTEXT_EMPTY, SemanticTypeVar("T"), type_list(SemanticMetaType(0))).is_none()
		and unify(issued.context, SemanticTypeVar("T"), type_list(issued.meta_type)).is_some()
	)


func test_unification_rejects_unissued_meta_in_variadic_tail() -> Bool:
	variadic = SemanticNamedType(
		"Tensor",
		[TYPE_INT, SemanticVarDimsType("Ds")],
	)
	missing = SemanticNamedType(
		"Tensor",
		[TYPE_INT, SemanticMetaType(0)],
	)
	missing_late = SemanticNamedType(
		"Tensor",
		[TYPE_INT, SemanticConstIntType(4), SemanticMetaType(0)],
	)
	issued = fresh_meta(CONTEXT_EMPTY)
	valid = SemanticNamedType(
		"Tensor",
		[TYPE_INT, issued.meta_type],
	)

	(
		unify(CONTEXT_EMPTY, variadic, missing).is_none()
		and unify_symmetric(CONTEXT_EMPTY, missing_late, variadic).is_none()
		and unify(issued.context, variadic, valid).is_some()
	)


func test_unification_rejects_unissued_meta_in_dimension_identity() -> Bool:
	left = SemanticDimOpType(SemanticDimAdd, SemanticMetaType(0), SemanticConstIntType(1))
	right = SemanticDimOpType(SemanticDimAdd, SemanticConstIntType(1), SemanticMetaType(0))
	issued = fresh_meta(CONTEXT_EMPTY)

	unify(CONTEXT_EMPTY, left, right).is_none() and unify(issued.context, left, right).is_some()


func test_unification_rejects_unissued_meta_in_range_shortcut() -> Bool:
	missing = SemanticRangeType(SemanticMetaType(0))
	issued = fresh_meta(CONTEXT_EMPTY)
	valid = SemanticRangeType(issued.meta_type)

	(
		unify(CONTEXT_EMPTY, TYPE_INT, missing).is_none()
		and unify_symmetric(CONTEXT_EMPTY, missing, TYPE_INT).is_none()
		and unify(issued.context, TYPE_INT, valid).is_some()
	)


func test_binding_rejects_transitive_cycle_and_accepts_issued_reference() -> Bool:
	first = fresh_meta(CONTEXT_EMPTY)
	second = fresh_meta(first.context)
	valid = bind_meta(second.context, 0, type_list(SemanticMetaType(1)))

	match valid:
		Some(bound):
			match lookup_meta(bound, 0):
				Some(binding):
					(
						bind_meta(bound, 1, SemanticMetaType(0)).is_none()
						and types_equal(binding, type_list(SemanticMetaType(1)))
					)
				None:
					False
		None:
			False


func test_binding_shared_acyclic_reference_remains_valid() -> Bool:
	var context = CONTEXT_EMPTY

	for _ in 0..4:
		context = fresh_meta(context).context

	chain = bind_meta(context, 1, SemanticMetaType(2))

	match chain:
		Some(first_bound):
			match bind_meta(first_bound, 2, TYPE_INT):
				Some(second_bound):
					shared = SemanticTupleType([SemanticMetaType(1), SemanticMetaType(1)])

					match bind_meta(second_bound, 0, shared):
						Some(third_bound):
							(
								occurs_meta(third_bound, 2, SemanticMetaType(0))
								and bind_meta(third_bound, 2, SemanticMetaType(0)).is_none()
								and bind_meta(third_bound, 3, SemanticMetaType(0)).is_some()
							)
						None:
							False
				None:
					False
		None:
			False


func test_meta_binding_replaces_one_issued_id_without_mutating_prior_context() -> Bool:
	first = fresh_meta(CONTEXT_EMPTY)
	second = fresh_meta(first.context)

	match bind_meta(second.context, 1, TYPE_INT):
		Some(bound):
			match bind_meta(bound, 1, TYPE_STRING):
				Some(replaced):
					(
						lookup_meta(second.context, 0).is_none()
						and lookup_meta(second.context, 1).is_none()
						and lookup_meta(bound, 1) == Some(TYPE_INT)
						and lookup_meta(replaced, 0).is_none()
						and lookup_meta(replaced, 1) == Some(TYPE_STRING)
					)
				None:
					False
		None:
			False


func test_unify_type_vars_one_way_and_symmetric() -> Bool:
	left_bind = unify(CONTEXT_EMPTY, SemanticTypeVar("T"), TYPE_INT)
	right_bind_one_way = unify(CONTEXT_EMPTY, TYPE_INT, SemanticTypeVar("T"))
	right_bind_symmetric = unify_symmetric(CONTEXT_EMPTY, TYPE_INT, SemanticTypeVar("T"))

	match (left_bind, right_bind_one_way, right_bind_symmetric):
		(Some(left_step), None, Some(right_step)):
			subst_has(left_step, "T", TYPE_INT) and subst_has(right_step, "T", TYPE_INT)
		_:
			False


func test_unify_functions_arrays_and_variadic_dims() -> Bool:
	impure_expected: SemanticType = SemanticFunctionType(False, [TYPE_INT], TYPE_STRING)
	pure_actual: SemanticType = SemanticFunctionType(True, [TYPE_INT], TYPE_STRING)
	pure_expected: SemanticType = SemanticFunctionType(True, [TYPE_INT], TYPE_STRING)
	impure_actual: SemanticType = SemanticFunctionType(False, [TYPE_INT], TYPE_STRING)
	array_type: SemanticType = SemanticArrayType(TYPE_INT, [SemanticTypeVar("#N")])
	tensor_type: SemanticType = SemanticNamedType(
		"Tensor",
		[TYPE_INT, SemanticTypeVar("#N")],
	)
	variadic_expected: SemanticType = SemanticNamedType(
		"Tensor",
		[TYPE_INT, SemanticVarDimsType("#Ds")],
	)
	concrete_tensor: SemanticType = SemanticNamedType(
		"Tensor",
		[TYPE_INT, SemanticConstIntType(3), SemanticConstIntType(4)],
	)

	(
		unify(CONTEXT_EMPTY, impure_expected, pure_actual).is_some()
		and unify(CONTEXT_EMPTY, pure_expected, impure_actual).is_none()
		and unify(CONTEXT_EMPTY, array_type, tensor_type).is_some()
		and unify(CONTEXT_EMPTY, variadic_expected, concrete_tensor).is_some()
		and unify(CONTEXT_EMPTY, concrete_tensor, variadic_expected).is_none()
	)


func test_unify_named_literal_range_and_dim_arithmetic() -> Bool:
	string_type: SemanticType = TYPE_STRING
	literal_type: SemanticType = SemanticNamedType("LiteralString", [])
	dim_expr_left: SemanticType = SemanticDimOpType(
		SemanticDimAdd,
		SemanticConstIntType(2),
		SemanticConstIntType(3),
	)
	dim_expr_right: SemanticType = SemanticConstIntType(5)

	(
		types_compatible_in_context(CONTEXT_EMPTY, string_type, literal_type)
		and types_bidirectional_in_context(CONTEXT_EMPTY, string_type, literal_type)
		and types_compatible_in_context(
			CONTEXT_EMPTY,
			TYPE_INT,
			SemanticRangeType(SemanticConstIntType(5)),
		)
		and types_bidirectional_in_context(
			CONTEXT_EMPTY,
			SemanticRangeType(SemanticConstIntType(5)),
			TYPE_INT,
		)
		and types_bidirectional_in_context(CONTEXT_EMPTY, dim_expr_left, dim_expr_right)
		and not types_compatible_in_context(CONTEXT_EMPTY, TYPE_STRING, TYPE_INT)
	)


func test_unify_dim_solver_binds_vars_and_metas() -> Bool:
	dim_var_expr: SemanticType = SemanticDimOpType(
		SemanticDimAdd,
		SemanticTypeVar("#N"),
		SemanticConstIntType(1),
	)
	var_step = unify_symmetric(CONTEXT_EMPTY, dim_var_expr, SemanticConstIntType(5))
	meta_step = fresh_meta(CONTEXT_EMPTY)
	meta_expr: SemanticType = SemanticDimOpType(
		SemanticDimAdd,
		meta_step.meta_type,
		SemanticConstIntType(2),
	)
	meta_unified = unify_symmetric(meta_step.context, meta_expr, SemanticConstIntType(5))
	distributed_left: SemanticType = SemanticDimOpType(
		SemanticDimMultiply,
		SemanticConstIntType(2),
		SemanticDimOpType(SemanticDimAdd, SemanticTypeVar("#M"), SemanticConstIntType(3)),
	)
	distributed_right: SemanticType = SemanticDimOpType(
		SemanticDimAdd,
		SemanticDimOpType(SemanticDimMultiply, SemanticTypeVar("#M"), SemanticConstIntType(2)),
		SemanticConstIntType(6),
	)

	match (var_step, meta_unified):
		(Some(var_result), Some(meta_result)):
			subst_has(var_result, "#N", SemanticConstIntType(4)) and types_equal(
				head_resolve(meta_result.context, meta_step.meta_type),
				SemanticConstIntType(3),
			) and types_bidirectional_in_context(CONTEXT_EMPTY, distributed_left, distributed_right)
		_:
			False


func test_unify_rigid_vars_do_not_bind_except_dims_to_int() -> Bool:
	(
		not types_compatible_rigid_in_context(CONTEXT_EMPTY, ["T"], SemanticTypeVar("T"), TYPE_INT)
		and types_compatible_rigid_in_context(
			CONTEXT_EMPTY,
			["#N"],
			SemanticTypeVar("#N"),
			TYPE_INT,
		)
	)


func test_unify_named_type_params() -> Bool:
	left_named_param = unify_with_type_params(
		CONTEXT_EMPTY,
		["T:Stringable"],
		SemanticNamedType("T", []),
		TYPE_STRING,
	)
	right_named_param = unify_symmetric_with_type_params(
		CONTEXT_EMPTY,
		["T"],
		TYPE_STRING,
		SemanticNamedType("T", []),
	)

	match (left_named_param, right_named_param):
		(Some(left_step), Some(right_step)):
			(
				subst_has(left_step, "T", TYPE_STRING)
				and subst_has(right_step, "T", TYPE_STRING)
				and types_compatible_with_params_in_context(
					CONTEXT_EMPTY,
					["T"],
					SemanticNamedType("T", []),
					TYPE_INT,
				)
			)
		_:
			False


private pure func meta_session_test_definition_table() -> DefinitionTable:
	issued = singleton_module_table(
		resolved_module_identity_from_resolver(
			"meta_session_test",
			UserModule,
		),
	)
	definition_index_definition_table(
		definition_index_empty(
			definition_index_initial_seed(ENV_EMPTY),
			issued[0],
		),
	)


func test_compilation_run_tokens_preserve_copy_and_distinguish_fresh_runs() -> Bool:
	first_run = new_compilation_run_token()
	second_run = new_compilation_run_token()
	first_copy = first_run

	(
		compilation_run_tokens_equal(first_run, first_copy)
		and not compilation_run_tokens_equal(first_run, second_run)
	)


func test_explicit_body_session_keys_distinguish_runs_purposes_and_rechecks() -> Bool:
	first_run = new_compilation_run_token()
	second_run = new_compilation_run_token()
	table = meta_session_test_definition_table()

	match (
		(
			meta_body_session(first_run, table, 7, NormalBodyMetaSession, 0),
			meta_body_session(first_run, table, 7, NormalBodyMetaSession, 0),
			meta_body_session(first_run, table, 7, NormalBodyMetaSession, 1),
		),
		(
			meta_body_session(first_run, table, 7, CtfeSelectiveBodyMetaSession, 0),
			meta_body_session(first_run, table, 8, NormalBodyMetaSession, 0),
			meta_body_session(second_run, table, 7, NormalBodyMetaSession, 0),
		),
	):
		((Some(first), Some(same_key), Some(recheck)), (Some(ctfe), Some(other_body), Some(other_run))):
			copied = first

			(
				meta_session_ids_equal(first, copied)
				and meta_session_ids_equal(first, same_key)
				and not meta_session_ids_equal(first, recheck)
				and not meta_session_ids_equal(first, ctfe)
				and not meta_session_ids_equal(first, other_body)
				and not meta_session_ids_equal(first, other_run)
				and meta_body_session(first_run, table, -1, NormalBodyMetaSession, 0).is_none()
				and meta_body_session(first_run, table, 7, NormalBodyMetaSession, -1).is_none()
			)
		_:
			False


func test_ctfe_selective_and_eager_fallback_checks_have_distinct_sessions() -> Bool:
	run = new_compilation_run_token()
	table = meta_session_test_definition_table()

	match (
		meta_body_session(run, table, 7, CtfeSelectiveBodyMetaSession, 0),
		meta_body_session(run, table, 7, CtfeEagerBodyMetaSession, 0),
		meta_body_session(run, table, 7, CtfeEagerBodyMetaSession, 1),
	):
		(Some(selective), Some(eager), Some(eager_recheck)):
			(
				not meta_session_ids_equal(selective, eager)
				and not meta_session_ids_equal(eager, eager_recheck)
				and not meta_session_ids_equal(selective, eager_recheck)
			)
		_:
			False


func test_module_global_and_body_meta_sessions_have_distinct_owner_domains() -> Bool:
	run = new_compilation_run_token()
	table = meta_session_test_definition_table()

	match (
		meta_module_session(run, table, 7, 0),
		meta_global_session(run, table, 7, 0),
		meta_body_session(run, table, 7, NormalBodyMetaSession, 0),
	):
		(Some(module_session), Some(global_session), Some(body_session)):
			(
				not meta_session_ids_equal(module_session, body_session)
				and not meta_session_ids_equal(module_session, global_session)
				and not meta_session_ids_equal(global_session, body_session)
				and meta_module_session(run, table, -1, 0).is_none()
				and meta_module_session(run, table, 7, -1).is_none()
				and meta_global_session(run, table, -1, 0).is_none()
				and meta_global_session(run, table, 7, -1).is_none()
			)
		_:
			False


