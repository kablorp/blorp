		argument_target_slot,
		bitwise_operand_target_slot,
		collection_element_slot,
		collection_element_target_slot,
		is_scalar_int_value_type,
		method_receiver_slot,
		mutable_binding_slot,
		numeric_operand_slot,
		range_proof_slot,
		scalar_int_value_type,
		tuple_literal_slot,
		widening_decision,
