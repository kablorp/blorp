		widening_value_type,
	test: TestSuite


func test_value_slot_encodes_widening_without_a_nested_decision() -> Bool:
	kept = mutable_binding_slot(TYPE_INT)
	widened = mutable_binding_slot(SemanticConstIntType(1))

	match (kept, widened):
		(KeptValueSlot(kept_type), WidenedValueSlot(semantic_type, value_type, reason)):
			(
				types_equal(kept_type, TYPE_INT)
				and types_equal(semantic_type, SemanticConstIntType(1))
				and types_equal(value_type, TYPE_INT)
				and widening_reasons_equal(reason, MutableBindingWidening)
			)
		_:
			False


func test_mutable_binding_slot_preserves_semantic_type() -> Bool:
	slot = mutable_binding_slot(SemanticConstIntType(1))

	(
		types_equal(widening_semantic_type(slot), SemanticConstIntType(1))
		and types_equal(widening_value_type(slot), TYPE_INT)
		and match widening_decision(slot):
			TypeWiden(from_type, to_type, reason):
				(
					types_equal(from_type, SemanticConstIntType(1))
					and types_equal(to_type, TYPE_INT)
					and widening_reasons_equal(reason, MutableBindingWidening)
				)
			TypeKeep(_):
				False
	)


func test_non_singleton_value_type_is_kept() -> Bool:
	slot = mutable_binding_slot(TYPE_INT)

	(
		types_equal(widening_semantic_type(slot), TYPE_INT)
		and types_equal(widening_value_type(slot), TYPE_INT)
		and widening_reason(slot).is_none()
		and match widening_decision(slot):
			TypeKeep(kept_type):
				types_equal(kept_type, TYPE_INT)
			TypeWiden(_, _, _):
				False
	)


func test_numeric_operand_slot_preserves_semantic_type() -> Bool:
	semantic_type: SemanticType = SemanticRangeType(SemanticConstIntType(4))
	slot = numeric_operand_slot(ParsedAddOp, semantic_type)

	(
		types_equal(widening_semantic_type(slot), semantic_type)
		and types_equal(widening_value_type(slot), TYPE_INT)
		and match widening_decision(slot):
			TypeWiden(from_type, to_type, reason):
				(
					types_equal(from_type, semantic_type)
					and types_equal(to_type, TYPE_INT)
					and widening_reasons_equal(reason, NumericOperator(ParsedAddOp))
				)
			TypeKeep(_):
				False
	)


func test_method_receiver_slot_preserves_semantic_type() -> Bool:
	slot = method_receiver_slot(SemanticConstIntType(1))

	(
		types_equal(widening_semantic_type(slot), SemanticConstIntType(1))
		and types_equal(widening_value_type(slot), TYPE_INT)
		and match widening_decision(slot):
			TypeWiden(_, _, reason):
				widening_reasons_equal(reason, MethodReceiver)
			TypeKeep(_):
				False
	)


func test_range_proof_slot_erases_only_runtime_type() -> Bool:
	semantic_type: SemanticType = SemanticRangeType(SemanticTypeVar("#N"))
	slot = range_proof_slot(semantic_type)

	(
		types_equal(widening_semantic_type(slot), semantic_type)
		and types_equal(widening_value_type(slot), TYPE_INT)
		and match widening_decision(slot):
			TypeWiden(_, _, reason):
				widening_reasons_equal(reason, RangeProofErasure)
			TypeKeep(_):
				False
	)


func test_tuple_literal_slot_preserves_semantic_items() -> Bool:
	semantic_type: SemanticType = SemanticTupleType([
		SemanticConstIntType(1),
		SemanticRangeType(SemanticConstIntType(10)),
	])
	value_type: SemanticType = SemanticTupleType([TYPE_INT, TYPE_INT])
	slot = tuple_literal_slot(semantic_type, value_type)

	(
		types_equal(widening_semantic_type(slot), semantic_type)
		and types_equal(widening_value_type(slot), value_type)
		and match widening_decision(slot):
			TypeWiden(_, _, reason):
				widening_reasons_equal(reason, TupleLiteral)
			TypeKeep(_):
				False
	)


func test_variadic_dimension_pack_is_kept() -> Bool:
	pack_type: SemanticType = SemanticVarDimsType("#Ds")
	slot = numeric_operand_slot(ParsedAddOp, pack_type)

	(
		types_equal(widening_semantic_type(slot), pack_type)
		and types_equal(widening_value_type(slot), pack_type)
		and match widening_decision(slot):
			TypeKeep(kept_type):
				types_equal(kept_type, pack_type)
			TypeWiden(_, _, _):
				False
	)


func test_scalar_int_value_type_lifts_only_scalar_dims() -> Bool:
	(
		types_equal(scalar_int_value_type(SemanticConstIntType(3)), TYPE_INT)
		and types_equal(scalar_int_value_type(SemanticRangeType(SemanticConstIntType(8))), TYPE_INT)
		and types_equal(
			scalar_int_value_type(SemanticVarDimsType("#Ds")),
			SemanticVarDimsType("#Ds"),
		)
		and is_scalar_int_value_type(SemanticConstIntType(3))
		and not is_scalar_int_value_type(TYPE_STRING)
	)


func test_argument_slot_only_widens_open_value_metas() -> Bool:
	value_meta = fresh_meta_with_origin(CONTEXT_EMPTY, "T")
	dim_meta = fresh_meta_with_origin(value_meta.context, "#N")
	value_slot = argument_slot(dim_meta.context, value_meta.meta_type, SemanticConstIntType(1))
	dim_slot = argument_slot(dim_meta.context, dim_meta.meta_type, SemanticConstIntType(1))
	range_type: SemanticType = SemanticRangeType(SemanticConstIntType(10))
	range_slot = argument_slot(dim_meta.context, value_meta.meta_type, range_type)

	(
		types_equal(widening_value_type(value_slot), TYPE_INT)
		and types_equal(widening_value_type(dim_slot), SemanticConstIntType(1))
		and types_equal(widening_semantic_type(range_slot), range_type)
		and types_equal(widening_value_type(range_slot), TYPE_INT)
	)


func test_argument_target_slot_preserves_semantic_type() -> Bool:
	slot = argument_target_slot(CONTEXT_EMPTY, TYPE_INT, SemanticConstIntType(1))

	(
		types_equal(widening_semantic_type(slot), SemanticConstIntType(1))
		and types_equal(widening_value_type(slot), TYPE_INT)
		and match widening_decision(slot):
			TypeWiden(_, _, reason):
				widening_reasons_equal(reason, ArgumentSlot)
			TypeKeep(_):
				False
	)


func test_argument_target_slot_widens_dimension_to_int() -> Bool:
	semantic_type: SemanticType = SemanticTypeVar("#N")
	slot = argument_target_slot(CONTEXT_EMPTY, TYPE_INT, semantic_type)

	(
		types_equal(widening_semantic_type(slot), semantic_type)
		and types_equal(widening_value_type(slot), TYPE_INT)
		and match widening_decision(slot):
			TypeWiden(_, _, reason):
				widening_reasons_equal(reason, ArgumentSlot)
			TypeKeep(_):
				False
	)


func test_argument_target_slot_widens_literal_to_sized_integer() -> Bool:
	target_type = SemanticNamedType("Int128", [])
	slot = argument_target_slot(CONTEXT_EMPTY, target_type, SemanticConstIntType(123))

	(
		types_equal(widening_semantic_type(slot), SemanticConstIntType(123))
		and types_equal(widening_value_type(slot), target_type)
	)


func test_argument_target_slot_widens_literal_to_sized_float() -> Bool:
	target_type = SemanticNamedType("Float32", [])
	slot = argument_target_slot(
		CONTEXT_EMPTY,
		target_type,
		SemanticNamedType("Float", []),
	)

	types_equal(
		widening_semantic_type(slot),
		SemanticNamedType("Float", []),
	) and types_equal(widening_value_type(slot), target_type)


func test_argument_target_slot_accepts_proven_range_literal() -> Bool:
	target_type: SemanticType = SemanticRangeType(SemanticTypeVar("#N"))
	slot = argument_target_slot(CONTEXT_EMPTY, target_type, SemanticConstIntType(0))

	(
		types_equal(widening_semantic_type(slot), SemanticConstIntType(0))
		and types_equal(widening_value_type(slot), target_type)
	)


func test_argument_target_slot_keeps_type_variable_targets() -> Bool:
	slot = argument_target_slot(CONTEXT_EMPTY, SemanticTypeVar("T"), TYPE_CHAR)

	(
		types_equal(widening_semantic_type(slot), TYPE_CHAR)
		and types_equal(widening_value_type(slot), TYPE_CHAR)
		and match widening_decision(slot):
			TypeKeep(kept_type):
				types_equal(kept_type, TYPE_CHAR)
			TypeWiden(_, _, _):
				False
	)


func test_argument_target_slot_keeps_incompatible_concrete_targets() -> Bool:
	slot = argument_target_slot(CONTEXT_EMPTY, TYPE_INT, TYPE_STRING)

	(
		types_equal(widening_semantic_type(slot), TYPE_STRING)
		and types_equal(widening_value_type(slot), TYPE_STRING)
		and match widening_decision(slot):
			TypeKeep(kept_type):
				types_equal(kept_type, TYPE_STRING)
			TypeWiden(_, _, _):
				False
	)


func test_collection_element_slot_records_collection_kind() -> Bool:
	slot = collection_element_slot(ListLiteral, SemanticConstIntType(1))

	match widening_decision(slot):
		TypeWiden(_, _, reason):
			widening_reasons_equal(reason, CollectionElement(ListLiteral))
		TypeKeep(_):
			False


