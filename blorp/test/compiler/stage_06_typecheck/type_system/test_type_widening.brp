import:
	../../../../src/compiler/stage_03_parse/parsed_ast: ParsedBinaryOp(ParsedAddOp)
	../../../../src/compiler/stage_06_typecheck/type_system/context: CONTEXT_EMPTY, fresh_meta_with_origin
	../../../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticType(
			SemanticConstIntType,
			SemanticNamedType,
			SemanticRangeType,
			SemanticTupleType,
			SemanticTypeVar,
			SemanticVarDimsType,
		),
		TYPE_CHAR,
		TYPE_INT,
		TYPE_STRING,
		types_equal,
	../../../../src/compiler/stage_06_typecheck/type_system/type_widening:
		CollectionKind(ListLiteral, VectorLiteral),
		TypeWideningDecision(TypeKeep, TypeWiden),
		TypeWideningReason(
			ArgumentSlot,
			BitwiseOperator,
			CollectionElement,
			MethodReceiver,
			MutableBindingWidening,
			NumericOperator,
			RangeProofErasure,
			TupleLiteral,
		),
