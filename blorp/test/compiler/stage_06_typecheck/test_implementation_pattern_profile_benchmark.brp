import:
	../../../benchmark/compiler/compiler_implementation_pattern_profile:
		ImplementationPatternProfileConfig,
		ImplementationPatternProfileResult,
		implementation_pattern_profile,
	test: TestSuite


private pure func profile_config(
	bound_parameter_count: Int,
	traits_per_parameter: Int,
) -> ImplementationPatternProfileConfig:
	{
		iterations = 3,
		bound_parameter_count = bound_parameter_count,
		traits_per_parameter = traits_per_parameter,
		duplicate_obligation_stride = 0,
		miss_obligation_index = 1000000
	}


private pure func expected_obligations(config: ImplementationPatternProfileConfig) -> Int:
	config.iterations * config.bound_parameter_count * config.traits_per_parameter


private pure func expected_substitution_comparisons(
	config: ImplementationPatternProfileConfig,
) -> Int:
	config.iterations * config.bound_parameter_count * (config.bound_parameter_count + 1) / 2


private pure func profile_has_expected_counters(
	config: ImplementationPatternProfileConfig,
	result: ImplementationPatternProfileResult,
) -> Bool:
	(
		result.workload_valid
		and result.baseline_scan.pattern_match_requests == config.iterations
		and result.indexed_scan.pattern_match_requests == config.iterations
		and result.production_match.pattern_match_requests == config.iterations
		and result.baseline_scan.bound_parameters_visited == config.iterations * config.bound_parameter_count
		and result.indexed_scan.bound_parameters_visited == result.baseline_scan.bound_parameters_visited
		and result.baseline_scan.trait_obligations_visited == expected_obligations(config)
		and result.indexed_scan.trait_obligations_visited == result.baseline_scan.trait_obligations_visited
		and result.baseline_scan.substitution_entries_compared == expected_substitution_comparisons(
			config,
		)
		and result.indexed_scan.substitution_entries_compared == result.baseline_scan.substitution_entries_compared
		and result.baseline_scan.obligation_satisfied_calls == result.baseline_scan.trait_obligations_visited
		and result.indexed_scan.obligation_satisfied_calls == result.indexed_scan.trait_obligations_visited
		and result.baseline_scan.enumeration_allocations == result.baseline_scan.bound_parameters_visited
		and result.indexed_scan.enumeration_allocations == 0
		and result.baseline_scan.semantic_checksum == result.indexed_scan.semantic_checksum
		and result.production_match.matched_requests == config.iterations
	)


func test_implementation_pattern_profile_counts_necessary_obligations() -> Bool:
	config = profile_config(8, 4)
	result = implementation_pattern_profile(config)
	profile_has_expected_counters(config, result)


func test_implementation_pattern_profile_exposes_lookup_not_obligation_growth() -> Bool:
	narrow_config = profile_config(8, 4)
	wide_config = profile_config(16, 4)
	narrow = implementation_pattern_profile(narrow_config)
	wide = implementation_pattern_profile(wide_config)

	(
		profile_has_expected_counters(narrow_config, narrow)
		and profile_has_expected_counters(wide_config, wide)
		and wide.baseline_scan.trait_obligations_visited == narrow.baseline_scan.trait_obligations_visited * 2
		and wide.baseline_scan.substitution_entries_compared > narrow.baseline_scan.substitution_entries_compared * 3
	)


func test_implementation_pattern_profile_matches_first_failure_result() -> Bool:
	config: ImplementationPatternProfileConfig = {
		iterations = 5,
		bound_parameter_count = 8,
		traits_per_parameter = 4,
		duplicate_obligation_stride = 3,
		miss_obligation_index = 10
	}
	result = implementation_pattern_profile(config)

	(
		result.workload_valid
		and result.baseline_scan.bound_parameters_visited == 15
		and result.indexed_scan.bound_parameters_visited == 15
		and result.baseline_scan.trait_obligations_visited == 55
		and result.indexed_scan.trait_obligations_visited == 55
		and result.baseline_scan.matched_requests == 0
		and result.indexed_scan.matched_requests == 0
		and result.production_match.matched_requests == 0
		and result.baseline_scan.semantic_checksum == result.indexed_scan.semantic_checksum
	)


tests: TestSuite = {
	description = "Compiler implementation pattern profile benchmark Tests",
	tests = [
		(
			"implementation pattern profile counts necessary obligations",
			test_implementation_pattern_profile_counts_necessary_obligations,
		),
		(
			"implementation pattern profile exposes lookup not obligation growth",
			test_implementation_pattern_profile_exposes_lookup_not_obligation_growth,
		),
		(
			"implementation pattern profile matches first failure result",
			test_implementation_pattern_profile_matches_first_failure_result,
		),
	]
}
