-- EXPECT: error: Argument type mismatch: in call to 'neg_result', argument 1 ('v') expected ?m0[?m1 + #5], got Int[#3]
-- Dimension equations that should be REJECTED by the canonical solver
-- #N + 5 = 3 → #N = -2 (negative)
pure func neg_result[T, #N](v: T[#N + #5]) -> Int:
	length(v)


pure func test_negative() -> Int:
	neg_result({1, 2, 3})
