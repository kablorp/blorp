-- EXPECT: error: Cannot iterate over type ParallelVector[Int, #4]. For-in loops work with List, Vector, Set, String, and Range types
import:
	vector: ParallelVector, parallel


func bad(values: Int[#4]) -> Int[#4]:
	values.parallel(pure func(chunk: ParallelVector[Int, #4]):
		var total: Int = 0
		for x in chunk:
			total += x
		chunk.map(pure func(x: Int): x)
	)
