-- EXPECT: error: Dimension arithmetic produces non-positive result: -5 (dimensions must be >= 1)
-- Test: #3 + #2 - #10 = -5 should be rejected after normalization.
pure func bad[T](v: T[#5]) -> T[#3 + #2 - #10]:
	builtin


func main(args: List[String]) -> Int:
	v: Int[#5] = {1, 2, 3, 4, 5}
	bad(v)
	0
