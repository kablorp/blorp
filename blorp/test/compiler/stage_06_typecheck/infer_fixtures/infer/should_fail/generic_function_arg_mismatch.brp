-- EXPECT: error: Argument type mismatch: in call to 'apply', argument 2 ('x') expected Int, got String
-- Test generic function argument type mismatch (should fail)
-- Generic apply function
func apply[T, U](f: (T) -> U, x: T) -> U:
	f(x)


func show_int(x: Int) -> String:
	to_string(x)


-- ERROR: Function expects Int but we pass String
func test_arg_mismatch() -> String:
	result: String = apply(show_int, "not an int")
	result
