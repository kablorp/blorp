-- EXPECT: error: Dimension arithmetic produces non-positive result: -1 in call to 'drop_three' (dimensions must be >= 1)
-- Test: Generic #N - 3 with N=2 should fail at the call site (2 - 3 = -1).
pure func drop_three[T, #N](v: T[#N]) -> T[#N - #3]:
	builtin


func main(args: List[String]) -> Int:
	v: Int[#2] = {1, 2}
	drop_three(v)
	0
