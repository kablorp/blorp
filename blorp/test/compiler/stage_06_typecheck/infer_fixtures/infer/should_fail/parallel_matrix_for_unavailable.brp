-- EXPECT: error: Cannot iterate over type ParallelMatrix[Int, #2, #2]. For-in loops work with Channel, Dict, List, Vector, Set, Stream, String, and Range types
-- RUN-BLORP-CHECK
import:
	matrix: ParallelMatrix, parallel


pure func bad(values: Int[#2, #2]) -> Int[#2, #2]:
	values.parallel(pure func(chunk: ParallelMatrix[Int, #2, #2]):
		for row in chunk:
			row
		chunk
	)
