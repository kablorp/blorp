-- EXPECT: error: Type Cell does not implement trait Hashable (required by add)
-- EXPECT-CONTAINS: help: Dict keys and Set elements are compared by value, so `Cell` must implement Equatable and Hashable
-- RUN-BLORP-CHECK
-- Set functions that hash declare their element Hashable.
import:
	set as S


fixed record Cell {
	row: Int,
	column: Int
}


func main(args: List[String]) -> Int:
	origin: Cell = { row = 0, column = 0 }
	var cells: Set[Cell] = {}
	cells = S.add(cells, origin)
	cells.length()
