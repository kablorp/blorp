-- EXPECT: error: Binding `as_strings` declared as `List[String]` but initializer has type `List[U]`
-- RUN-BLORP-CHECK
-- The annotation solves anything()'s open T to the rigid U rather than
-- accepting the unsolved meta, so the later String annotation is a mismatch
-- instead of silently solving T to String.
pure func anything[T]() -> List[T]:
	[]


pure func same_as[U](sample: U) -> Int:
	value = anything()
	picked: List[U] = value
	as_strings: List[String] = value
	as_strings.length()


func main(args: List[String]) -> Int:
	same_as(1)
