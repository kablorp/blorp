-- EXPECT: error: Cannot use Result ?= in a block returning Option. Convert the Result to Option or return Result from the enclosing function
import:
	list: get
	option: Option(Some, None)
	result: Result(Ok, Err)


func make_ok(x: Int) -> Result[Int, String]:
	Ok(x)


func bad(xs: List[Int]) -> Option[Int]:
	a ?= xs.get(0)
	b ?= make_ok(10)
	Some(a + b)
