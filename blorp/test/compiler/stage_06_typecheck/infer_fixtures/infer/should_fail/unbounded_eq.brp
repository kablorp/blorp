-- EXPECT: error: Type parameter 'T' requires Equatable bound for == and != operators. Add 'T: Equatable' to the function signature
-- ERROR: Using == on unbounded type parameter should require Equatable bound
pure func find_it[T](items: List[T], target: T) -> Bool:
	var found: Bool = False
	for item in items:
		if item == target:
			found = True
	found
