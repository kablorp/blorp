-- EXPECT: error: impl Describable for Int: supertrait 'Printable' is not implemented
-- Test: implementing a trait without implementing its supertrait should fail
trait Printable:
	func show(value: Self) -> String


trait Describable: Printable:
	func describe(value: Self) -> String


-- Implements Describable but NOT Printable — should be rejected
implements Describable for Int:
	func describe(value: Int) -> String:
		"an integer"


func main(args: List[String]) -> Int:
	0
