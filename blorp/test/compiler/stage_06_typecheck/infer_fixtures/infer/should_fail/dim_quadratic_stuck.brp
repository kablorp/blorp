-- EXPECT: error: Argument type mismatch: in call to 'needs_square', argument 1 ('v') expected ?m0[?m1 * ?m1], got Int[#9]
-- #N * #N = 9 is nonlinear — solver can't determine #N
pure func needs_square[T, #N](v: T[#N * #N]) -> Int:
	length(v)


pure func test() -> Int:
	needs_square({1, 2, 3, 4, 5, 6, 7, 8, 9})
