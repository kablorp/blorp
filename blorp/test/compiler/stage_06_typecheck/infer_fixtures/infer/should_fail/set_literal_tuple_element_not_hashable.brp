-- EXPECT-CONTAINS: `(Int, Point)` cannot be a Set element because its element type `Point` does not implement Hashable at
-- EXPECT-CONTAINS: help: Dict keys and Set elements are compared by value, so `Point` must implement Equatable and Hashable
-- A tuple is Hashable only when every element is; the diagnostic names the
-- element that is not.
record Point {
	x: Int,
	y: Int
}


func main(args: List[String]) -> Int:
	seen: Set[(Int, Point)] = {}
	seen.length()
