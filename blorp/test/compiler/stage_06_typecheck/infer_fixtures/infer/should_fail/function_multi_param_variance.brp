-- EXPECT: error: Argument type mismatch: in call to 'apply_binary', argument 1 ('f') expected (Int, Int) -> Int, got (Int, String) -> Int
-- TEST: Should fail - Function with wrong parameter types in multi-param signature
-- Passing (Int, String) -> Int where (Int, Int) -> Int is expected
-- blorp enforces invariant function types (no variance)
func apply_binary(f: (Int, Int) -> Int, a: Int, b: Int) -> Int:
	f(a, b)


func wrong_params(x: Int, s: String) -> Int:
	x + 1


func main(args: List[String]) -> Int:
	result: Int = apply_binary(wrong_params, 5, 10)
	print(to_string(result))
	-- Error: wrong_params expects (Int, String) but apply_binary needs (Int, Int) -> Int
	0
