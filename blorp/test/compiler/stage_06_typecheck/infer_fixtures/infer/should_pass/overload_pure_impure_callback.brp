-- Overload resolution: when both pure and impure overloads of a HOF exist,
-- an impure callback should resolve to the impure overload. This is the
-- paired-pure/impure pattern from the stdlib (list.map, list.filter, etc.).
import:
	list: map


-- A closure whose body calls its impure function-typed parameter is itself
-- impure. Passing it to `map` must select `func map` (not `pure func map`).
func test_impure_callback() -> Int:
	fns: List[(Int) -> Int] = []
	results: List[Int] = fns.map(func(f: (Int) -> Int): f(10))
	results.length()
