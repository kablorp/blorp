-- Test: importing a polymorphic builtin from a module should not shadow it
-- for other types. to_string is a prelude builtin that works on any type.
-- Importing it from list should NOT narrow it to only work on List[T].
import:
	list: to_string


func main(args: List[String]) -> Int:
	xs: List[Int] = [1, 2, 3]
	n: Int = 42
	s1: String = to_string(xs)
	s2: String = to_string(n)
	length(s1) + length(s2)
