-- NAME_RESOLUTION.md §7.5: when a record has a field of a given name and a
-- function of the same name is also in scope, the field wins for
-- expr.name(args). Here Shape.area is a field holding a closure; calling
-- s.area(n) dispatches to the field, NOT the top-level `area` function.
record Shape {
	area: (Int) -> Int
}


pure func area(_s: Shape) -> Int:
	-- Intentionally wrong: returns 0. If UFCS ever shadowed the field,
	-- this would be called and the test would return 0.
	0


func main(args: List[String]) -> Int:
	s: Shape = {area = func(n: Int): n * 2}
	result: Int = s.area(5)

	-- result must be 10 (field's closure applied), not 0 (top-level fn).
	if result == 10:
		0
	else:
		1
