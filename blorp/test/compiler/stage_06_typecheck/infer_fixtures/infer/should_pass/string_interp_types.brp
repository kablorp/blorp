func test_int_interp() -> String:
	x: Int = 42
	"Value: ${x}"


func test_float_interp() -> String:
	f: Float = 3.14
	"Pi is ${f}"


func test_bool_interp() -> String:
	b: Bool = True
	"Flag is ${b}"


func test_string_interp() -> String:
	s: String = "world"
	"Hello ${s}"


func test_char_interp() -> String:
	c: Char = 'A'
	"Letter: ${c}"
