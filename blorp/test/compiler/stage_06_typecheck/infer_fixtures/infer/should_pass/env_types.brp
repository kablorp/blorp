import:
	option: Option(Some, None)
	system: getenv, setenv


-- Middle test: getenv and setenv type check correctly
func test_getenv() -> Bool:
	match getenv("PATH"):
		Some(path): True
		None: True


func test_setenv() -> Bool:
	setenv("TEST_VAR", "value")


func main(args: List[String]) -> Int:
	if test_getenv() and test_setenv():
		0
	else:
		1
