-- TEST: i proven in-bounds for one vector should be valid for same-dim vectors
pure func add_vectors[#N](a: Float[#N], b: Float[#N]) -> Float[#N]:
	var result: Float[#N] = vector(0.0, length(a))
	for i in 0..length(a):
		result[i] = a[i] + b[i]
	result


func main(args: List[String]) -> Int:
	a: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	b: Float[#4] = {10.0, 20.0, 30.0, 40.0}
	c: Float[#4] = add_vectors(a, b)
	print(to_string(c[0]))
	print(to_string(c[3]))
	0
