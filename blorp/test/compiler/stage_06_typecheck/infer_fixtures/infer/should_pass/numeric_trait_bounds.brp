-- Numeric type family traits: Integer, SignedInteger, UnsignedInteger, FloatingPoint
-- These should all type-check successfully.
import:
	option: Option(Some, None)
	traits: FloatingPoint, Integer, SignedInteger, UnsignedInteger


-- Integer trait bound: arithmetic
func double[T:Integer](x: T) -> T:
	x + x


-- Integer trait bound: comparison
func max_of[T:Integer](a: T, b: T) -> T:
	match a > b:
		True: a
		_: b


-- Integer trait bound: trait method (checked_div)
func safe_div[T:Integer](a: T, b: T) -> Option[T]:
	checked_div(a, b)


-- Integer trait bound: bitwise ops
func mask[T:Integer](x: T, m: T) -> T:
	bit_and(x, m)


-- Integer trait bound: shift
func shl[T:Integer](x: T, n: Int) -> T:
	shift_left(x, n)


-- SignedInteger bound
func identity_signed[T:SignedInteger](x: T) -> T:
	x


-- UnsignedInteger bound
func identity_unsigned[T:UnsignedInteger](x: T) -> T:
	x


-- FloatingPoint bound: arithmetic
func half[T:FloatingPoint](x: T) -> T:
	x / x


-- FloatingPoint bound: comparison
func clamp_fp[T:FloatingPoint](val: T, lo: T, hi: T) -> T:
	match val < lo:
		True: lo
		_:
			match val > hi:
				True: hi
				_: val


-- Combined: Integer with multiple ops
func clamp_int[T:Integer](val: T, lo: T, hi: T) -> T:
	match val < lo:
		True: lo
		_:
			match val > hi:
				True: hi
				_: val


-- Transitive: T: Integer satisfies Orderable (supertrait)
func compare[T:Integer](a: T, b: T) -> Bool:
	a < b


-- Transitive: T: Integer satisfies Equatable (supertrait)
func equal[T:Integer](a: T, b: T) -> Bool:
	a == b


-- Call with concrete Int
func test_int() -> Int:
	double(21)


-- Call with concrete Int32
func test_int32() -> Int32:
	double(to_int32(5))


-- Call with concrete Float
func test_float() -> Float:
	half(3.14)


-- Call with concrete Float32
func test_float32() -> Float32:
	half(to_float32(2))


-- Vectors with trait bounds
func vec_add[T:Integer, #N](a: T[#N], b: T[#N]) -> T[#N]:
	a + b


func main(args: List[String]) -> Int:
	0
