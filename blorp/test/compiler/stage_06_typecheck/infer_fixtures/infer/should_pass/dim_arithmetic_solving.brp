-- Test: single-variable dimension solving at call sites
-- When calling a function whose param type is T[#N + 1],
-- the solver should determine #N from the concrete argument size.
pure func needs_at_least_two[T, #N](v: T[#N + #1]) -> Int:
	length(v)


pure func test_solve_add() -> Int:
	v: Int[#5] = {1, 2, 3, 4, 5}
	needs_at_least_two(v)


pure func needs_multiple_of_three[T, #N](v: T[#N * #3]) -> Int:
	length(v)


pure func test_solve_mul() -> Int:
	v: Int[#6] = {1, 2, 3, 4, 5, 6}
	needs_multiple_of_three(v)


-- Test: solving with both add and mul in separate params
pure func two_constraints[T, #N, #M](a: T[#N + #1], b: T[#M * #2]) -> Int:
	length(a) + length(b)


pure func test_solve_mixed() -> Int:
	a: Int[#3] = {1, 2, 3}
	b: Int[#4] = {1, 2, 3, 4}
	two_constraints(a, b)
