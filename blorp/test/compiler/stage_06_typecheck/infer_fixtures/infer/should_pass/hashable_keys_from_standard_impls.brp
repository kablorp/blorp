-- Fieldless enums satisfy Equatable and Hashable bounds without an impl, and
-- tuples, lists, 128-bit integers, StringSlice and Bytes are Hashable through
-- the standard library, so all of them can key a Dict or a Set.
import:
	slice: StringSlice, from_string


enum Color:
	Red
	Green


pure func same[T: Equatable](left: T, right: T) -> Bool:
	left == right


pure func count_all[K: Hashable](items: List[K]) -> Dict[K, Int]:
	var counts: Dict[K, Int] = {}

	for item in items:
		counts = counts.set(item, counts.get_or(item, 0) + 1)

	counts


func main(args: List[String]) -> Int:
	colors: Dict[Color, Int] = count_all([Red, Green, Red])
	pairs: Set[(Color, Int)] = {}
	lists: Dict[List[Int], String] = {[1, 2] => "a"}
	wide: Dict[Int128, Int] = count_all([to_int128(1), to_int128(1)])
	unsigned: Set[UInt128] = {}
	slices: Dict[StringSlice, Int] = count_all([from_string("a")])
	buffers: Set[Bytes] = {}
	optional: Dict[Option[(Int, String)], Int] = {}

	if same(Red, Red):
		colors.length() + pairs.length() + lists.length() + wide.length() + unsigned.length() + slices.length() + buffers.length() + optional.length()
	else:
		0
