-- NAME_RESOLUTION.md §6.4: `#N` in a type parameter list introduces a
-- dim variable, usable inside the body as a value and as a type argument.
-- Resolves as TyVar "#N" (is_dim_var returns true), then monomorphizes to
-- a concrete TyConstInt at the call site.
pure func first_of[#N](v: Float[#N]) -> Float:
	v[0]


func main(args: List[String]) -> Int:
	v: Float[#3] = {1.0, 2.0, 3.0}
	f: Float = first_of(v)
	if f == 1.0:
		0
	else:
		1
