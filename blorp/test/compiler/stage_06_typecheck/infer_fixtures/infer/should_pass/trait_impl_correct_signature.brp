-- Impl with correct signature — [Self] in the trait resolves to
-- [String] in the impl. The [use_hash] call forces the type-checker to
-- verify dispatch, not just signature validation.
trait Hashable:
	pure func hash(value: Self) -> Int


implements Hashable for String:
	pure func hash(value: String) -> Int:
		0


pure func use_hash(s: String) -> Int:
	hash(s)


func main(args: List[String]) -> Int:
	0
