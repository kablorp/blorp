-- Test that list(n) constructs empty lists with capacity reserved.
-- Defined in standard_library/src/list.brp; requires selective import.
-- Type parameter T is inferred from usage context (same as []).
import:
	list: list


func main(args: List[String]) -> Int:
	-- Explicit annotation determines T
	xs: List[Int] = list(64)

	-- Used as a function argument with known element type
	ys: List[String] = list(4)
	_ = ys.append("hello")

	-- In a var with subsequent appends that constrain T
	var zs: List[Float] = list(100)
	zs = zs.append(3.14)
	_ = xs
	_ = ys
	_ = zs
	0
