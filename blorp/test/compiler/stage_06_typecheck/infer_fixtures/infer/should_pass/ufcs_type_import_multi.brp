-- TEST: Importing types from multiple modules — methods don't conflict
-- Both list and option export 'map', but they match on different first-arg types
import:
	list: List
	option: Option(Some, None)


func main(args: List[String]) -> Int:
	data: List[Int] = [1, 2, 3]
	doubled: List[Int] = data.map(func(x: Int): x * 2)
	opt: Option[Int] = Some(5)
	mapped: Option[Int] = opt.map(func(x: Int): x + 1)
	length(doubled)
