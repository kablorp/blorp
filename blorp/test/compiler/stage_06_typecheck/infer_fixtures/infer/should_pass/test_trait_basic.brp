-- Basic trait definition, impl, and dispatch type-checking.
-- Without the [greet(x)] call, this file would pass even if trait
-- dispatch were completely broken — so the call is the load-bearing
-- assertion here, not the declarations.
trait Greetable:
	pure func greet(value: Self) -> String


implements Greetable for Int:
	pure func greet(value: Int) -> String:
		"Hello Int"


pure func use_greet(x: Int) -> String:
	greet(x)


func main(args: List[String]) -> Int:
	0
