-- Test: conversion builtins between sized integer types
func main(args: List[String]) -> Int:
	x: Int = 42
	a: Int8 = to_int8(x)
	b: Int16 = to_int16(x)
	c: Int32 = to_int32(x)
	d: Int128 = to_int128(x)
	e: UInt8 = to_uint8(x)
	f: UInt16 = to_uint16(x)
	g: UInt32 = to_uint32(x)
	h: UInt64 = to_uint64(x)
	i: UInt128 = to_uint128(x)
	0
