-- Pattern matching on sized integer types with literal arms
func test_int8_match(x: Int8) -> Int:
	match x:
		0: 100
		1: 200
		_: 300


func test_uint8_match(x: UInt8) -> Int:
	match x:
		0: 10
		255: 20
		_: 30


func test_int16_match(x: Int16) -> String:
	match x:
		-1: "neg"
		0: "zero"
		1: "pos"
		_: "other"


func main(args: List[String]) -> Int:
	0
