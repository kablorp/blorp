-- Test: multiple sequential calls progressively constrain a generic
-- container's type parameters. Each call's subst must flow into the
-- global substitution so the original allocation site retroactively
-- infers the concrete K, V.
import:
	option: Option(Some, None)
	sorted_map as M


pure func build_map() -> Bool:
	var m = M.sorted_map()
	m = M.set(m, "alpha", 1)
	m = M.set(m, "beta", 2)
	match M.get(m, "alpha"):
		Some(v): v == 1
		None: False


func main(args: List[String]) -> Int:
	if build_map():
		0
	else:
		1
