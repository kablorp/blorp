-- TEST: Set type import provides UFCS methods
-- Note: set.add conflicts with the Addable trait's add (trait methods take priority).
-- Use set { Set, add } to get add as a bare name, or use qualified set as S + S.add.
import:
	set: Set, add


func main(args: List[String]) -> Int:
	var s: Set[Int] = {}
	s = s.add(1)
	s = s.add(2)
	s = s.remove(3)
	b: Bool = s.contains(2)
	lst: List[Int] = s.to_list()
	length(lst)
