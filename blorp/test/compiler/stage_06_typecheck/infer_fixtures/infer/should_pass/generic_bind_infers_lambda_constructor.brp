union Box[T]:
	Full(T)
	Empty


pure func bind_box[T, U](self: Box[T], f: pure (T) -> Box[U]) -> Box[U]:
	match self:
		Full(value):
			f(value)
		Empty:
			Empty


func main(args: List[String]) -> Int:
	result = bind_box(Full(2), func(value: Int): Full(value + 3))
	match result:
		Full(value):
			value
		Empty:
			0
