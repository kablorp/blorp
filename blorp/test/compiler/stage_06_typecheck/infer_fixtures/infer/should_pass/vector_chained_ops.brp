func test_chained_add(a: Int[#3], b: Int[#3], c: Int[#3]) -> Int[#3]:
	a + b + c


func test_scalar_then_add(a: Int[#3], b: Int[#3]) -> Int[#3]:
	a + b * 2


func test_sub_div(a: Int[#3], b: Int[#3], c: Int[#3]) -> Int[#3]:
	a - b / c


func test_float_chained(a: Float[#3], b: Float[#3], c: Float[#3]) -> Float[#3]:
	a + b + c
