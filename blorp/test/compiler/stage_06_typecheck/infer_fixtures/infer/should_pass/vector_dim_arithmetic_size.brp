-- vector() accepts dimension arithmetic when each operand has static dim evidence.
pure func convolve_shape[#S, #K](signal: Float[#S], kernel: Float[#K]) -> Float[#S + #K - #1]:
	sn: #S = signal.length()
	kn: #K = kernel.length()
	vector(0.0, sn + kn - 1)


func main(args: List[String]) -> Int:
	0
