-- Comprehensive dimension arithmetic solving tests
-- ============================================================================
-- Basic solving (TyMeta + constant = constant) — already works
-- ============================================================================
-- Addition: #N + 1 = 5 → #N = 4
pure func add_solve[T, #N](v: T[#N + #1]) -> Int:
	length(v)


pure func test_add() -> Int:
	add_solve({1, 2, 3, 4, 5})


-- Multiplication: #N * 3 = 6 → #N = 2
pure func mul_solve[T, #N](v: T[#N * #3]) -> Int:
	length(v)


pure func test_mul() -> Int:
	mul_solve({1, 2, 3, 4, 5, 6})


-- ============================================================================
-- Symbolic solving: DimOp = DimOp (constant cancellation)
-- ============================================================================
-- #N + 1 = #M + 2 where #M is known → #N = #M + 1
pure func inner_plus1[T, #N](v: T[#N + #1]) -> Int:
	length(v)


pure func outer_plus2[T, #M](v: T[#M + #2]) -> Int:
	inner_plus1(v)


pure func test_nested_transform() -> Int:
	outer_plus2({1, 2, 3, 4, 5})


-- Note: #N + 3 = #M + 1 → #N = #M - 2 is correctly rejected
-- because #M - 2 could be negative without a #M >= 2 constraint.
-- ============================================================================
-- Return type propagation with arithmetic
-- ============================================================================
-- Solved dim flows into return type
pure func identity_sized[T, #N](v: T[#N + #1]) -> T[#N + #1]:
	v


pure func test_return_propagation() -> Int:
	v: Int[#5] = {1, 2, 3, 4, 5}
	result: Int[#5] = identity_sized(v)
	length(result)


-- ============================================================================
-- Multiple params with arithmetic
-- ============================================================================
-- Both params have dim arithmetic
pure func both_arith[T, #N, #M](a: T[#N + #1], b: T[#M * #2]) -> Int:
	length(a) + length(b)


pure func test_both() -> Int:
	a: Int[#3] = {1, 2, 3}
	b: Int[#4] = {1, 2, 3, 4}
	both_arith(a, b)


-- ============================================================================
-- Division solving
-- ============================================================================
-- #N / 2 = concrete → #N = concrete * 2
pure func div_solve[T, #N](v: T[#N / #2]) -> Int:
	length(v)


pure func test_div() -> Int:
	div_solve({1, 2, 3})


-- ============================================================================
-- Subtraction solving
-- ============================================================================
-- #N - 1 = concrete → #N = concrete + 1
pure func sub_solve[T, #N](v: T[#N - #1]) -> Int:
	length(v)


pure func test_sub() -> Int:
	sub_solve({1, 2, 3, 4})
