-- NAME_RESOLUTION.md §4.1: bare identifier `length` resolves to the prelude
-- builtin without any explicit import. Verifies step 4 (prelude symbol) of
-- the bare-name ladder.
func len_of_list(xs: List[Int]) -> Int:
	length(xs)


func main(args: List[String]) -> Int:
	n: Int = len_of_list([1, 2, 3])
	print("${n}")
	0
