-- Type checking for packed enum tensors (EnumType[#N])
enum Color:
	Red
	Green
	Blue


enum Base:
	A
	C
	G
	T


enum Suit:
	Hearts
	Diamonds
	Clubs
	Spades


-- 1D enum tensor literal
func test_enum_literal() -> Color[#3]:
	{Red, Green, Blue}


-- 1D enum tensor with vector() constructor
func test_enum_vector() -> Base[#5]:
	vector(A, 5)


-- Bool tensor literal
func test_bool_literal() -> Bool[#3]:
	{True, False, True}


-- Bool tensor with vector()
func test_bool_vector() -> Bool[#8]:
	vector(True, 8)


-- Enum tensor subscript returns element type
func test_subscript(t: Color[#3]) -> Color:
	t[0]


-- Bool tensor subscript returns Bool
func test_bool_subscript(t: Bool[#4]) -> Bool:
	t[0]


-- Enum tensor subscript set preserves type
func test_subscript_set() -> Color:
	var t: Color[#3] = {Red, Green, Blue}
	t[1] = Red
	t[1]


-- 2D enum tensor literal
func test_2d() -> Base[#2, #3]:
	{
		{A, C, G},
		{T, A, C},
	}


-- 2D enum tensor multi-index returns element
func test_2d_subscript() -> Base:
	m: Base[#2, #3] = {
		{A, C, G},
		{T, A, C},
	}
	m[0, 1]


-- 2D enum tensor multi-index set
func test_2d_set() -> Base:
	var m: Base[#2, #3] = {
		{A, C, G},
		{T, A, C},
	}
	m[1, 0] = C
	m[1, 0]


-- Enum tensor in function parameter
func count_a(seq: Base[#4]) -> Int:
	var count: Int = 0
	for b in seq:
		match b:
			A: count += 1
			_: void
	count


-- Enum tensor as return value
func make_dna() -> Base[#4]:
	{A, C, G, T}


-- Enum tensor equality comparison
func test_enum_eq() -> Bool:
	dna: Base[#4] = {A, C, G, T}
	dna[0] == A


-- Enum tensor in match
func test_enum_match() -> String:
	dna: Base[#3] = {A, C, G}
	match dna[1]:
		A: "adenine"
		C: "cytosine"
		G: "guanine"
		T: "thymine"


-- Enum tensor with different-sized enums
func test_suit_tensor() -> Suit[#4]:
	{Hearts, Diamonds, Clubs, Spades}


-- Enum tensor to_string via interpolation
func test_to_string() -> String:
	dna: Base[#3] = {A, C, G}
	"${dna}"
