-- Prelude trait definitions are globally available: `T: Orderable`
-- transitively satisfies `Equatable` (since `Orderable: Equatable`) even
-- in a file that does NOT import `traits`. This mirrors how the stdlib
-- (e.g. standard_library/src/tuple.brp) relies on prelude trait defs being in scope by
-- the time its impl bodies typecheck.
pure func check_eq[T:Orderable](a: T, b: T) -> Bool:
	a == b


func main(args: List[String]) -> Int:
	if check_eq(1, 2):
		0
	else:
		1
