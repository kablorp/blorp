	../typecheck_test_support as TypecheckTestSupport
	test: TestSuite


private pure func fixture_module_load_candidate(source: String) -> ModuleLoadCandidate:
	module_load_candidate_at("main", source)


private pure func module_load_candidate_at(
	module_path: String,
	source: String,
) -> ModuleLoadCandidate:
	module_load_candidate(
		resolved_module_identity_from_resolver(module_path, UserModule),
		TypecheckTestSupport.finalized_typecheck_program_fixture(
			module_path + ".brp",
			module_path,
			source,
		),
	)


private pure func accept_empty_view(scope: PreparedModuleScope) -> BoundModuleViewBinding:
	BoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private pure func implementation_graph(source: String) -> Option[ImplementationHeaderGraph]:
	implementation_graph_at("main", source)


private pure func implementation_graph_at(
	module_path: String,
	source: String,
) -> Option[ImplementationHeaderGraph]:
	indexed ?= indexed_graph_build(
		module_load_candidate_at(module_path, source),
		[],
	).to_option()
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	topology ?= trait_topology_graph_build(type_headers).to_option()
	callables ?= callable_header_graph_build(topology).to_option()
	implementation_header_graph_build(callables).to_option()


private pure func implementation_headers_are_exact() -> Option[Bool]:
	source: String =
		|trait Renderable:
		|	pure func render(value: Self) -> String
		|
		|record Box[T] {value: T}
		|
		|implements Renderable for Box[T]:
		|	pure func render(value: Box[T]) -> String:
		|		"box"
	graph ?= implementation_graph(source)
	header ?= implementation_header_graph_headers(graph).get(0)
	parameter ?= implementation_header_parameters(header).get(0)
	method ?= implementation_header_methods(header).get(0)
	method_signature ?= explicit_implementation_method_signature(method)
	method_value ?= callable_signature_parameters(method_signature).get(0)
	definition_table = implementation_header_graph_definition_table(graph)

	Some(
		(
			implementation_header_graph_headers(graph).length() == 1
			and trait_id_name(definition_table, implementation_header_trait_id(header)) == "Renderable"
			and implementation_type_parameter_id_index(
				resolved_implementation_type_parameter_id(parameter),
			) == 0
			and match implementation_header_receiver(header):
				DeclaredTypeShape(_, [ImplementationTypeParameterShape(_)]):
					(
						implementation_header_method_ids(header).length() == 1
						and match method_value.typ:
							DeclaredTypeShape(_, [ImplementationTypeParameterShape(_)]):
								True
							_:
								False
					)
				_:
					False
		),
	)


pure func test_implementation_headers_are_exact() -> Bool:
	implementation_headers_are_exact().get_or(False)


private pure func default_method_header_substitutes_receiver() -> Option[Bool]:
	source: String =
		|trait Measure:
		|	pure func measure(value: Self) -> Int
		|	pure func doubled(value: Self) -> Int: measure(value) * 2
		|
		|record Box {value: Int}
		|
		|implements Measure for Box:
		|	pure func measure(value: Box) -> Int:
		|		value.value
	graph ?= implementation_graph(source)
	header ?= implementation_header_graph_headers(graph).get(0)
	method ?= implementation_header_methods(
		header,
	).find(
		func(candidate): default_implementation_method_signature(header, candidate).is_some(),
	)
	signature ?= default_implementation_method_signature(header, method)
	parameter ?= callable_signature_parameters(signature).get(0)

	matches = match (implementation_header_receiver(header), parameter.typ):
		(DeclaredTypeShape(receiver_id, []), DeclaredTypeShape(parameter_id, [])):
			type_ids_equal(receiver_id, parameter_id)
		_:
			False

	Some(matches)


pure func test_default_method_header_substitutes_receiver() -> Bool:
	default_method_header_substitutes_receiver().get_or(False)


private pure func default_method_header_rejects_foreign_implementation() -> Option[Bool]:
	source: String =
		|trait Measure:
		|	pure func measure(value: Self) -> Int
		|	pure func doubled(value: Self) -> Int: measure(value) * 2
		|
		|record First {value: Int}
		|record Second {value: Int}
		|
		|implements Measure for First:
		|	pure func measure(value: First) -> Int: value.value
		|
		|implements Measure for Second:
		|	pure func measure(value: Second) -> Int: value.value
	graph ?= implementation_graph(source)
	first ?= implementation_header_graph_headers(graph).get(0)
	second ?= implementation_header_graph_headers(graph).get(1)
	first_default ?= implementation_header_methods(
		first,
	).find(
		func(candidate): default_implementation_method_signature(first, candidate).is_some(),
	)

	Some(default_implementation_method_signature(second, first_default).is_none())


pure func test_default_method_header_rejects_foreign_implementation() -> Bool:
	default_method_header_rejects_foreign_implementation().get_or(False)


private pure func implementation_headers_reject_missing_required_method() -> Option[Bool]:
	source: String =
		|trait Renderable:
		|	pure func render(value: Self) -> String
		|
		|record Box {value: Int}
		|
		|implements Renderable for Box:
		|	pure func other(value: Box) -> String:
		|		"box"
	indexed ?= indexed_graph_build(fixture_module_load_candidate(source), []).to_option()
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	topology ?= trait_topology_graph_build(type_headers).to_option()
	callables ?= callable_header_graph_build(topology).to_option()

	match implementation_header_graph_build(callables):
		Ok(_):
			Some(False)
		Err(errors):
			Some(
				errors.any(func(error):
					implementation_header_graph_error_message(
						error,
					) == "implementation of 'Renderable' is missing required method 'render'"
				),
			)


pure func test_implementation_headers_reject_missing_required_method() -> Bool:
	implementation_headers_reject_missing_required_method().get_or(False)


private pure func implementation_headers_reject_method_parameter_owner_collision() -> Option[Bool]:
	source: String =
		|trait Renderable:
		|	pure func render(value: Self) -> String
		|
		|record Box[T] {value: T}
		|
		|implements Renderable for Box[T]:
		|	pure func render[T](value: Box[T]) -> String:
		|		"box"
	indexed ?= indexed_graph_build(fixture_module_load_candidate(source), []).to_option()
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	topology ?= trait_topology_graph_build(type_headers).to_option()
	callables ?= callable_header_graph_build(topology).to_option()

	match implementation_header_graph_build(callables):
		Ok(_):
			Some(False)
		Err(errors):
			Some(
				errors.any(func(error):
					implementation_header_graph_error_message(error) == (
						"implementation method 'render' redeclares implementation type parameter 'T'; "
						+ "remove it from the method's type parameter list because implementation "
						+ "parameters are already in scope"
					)
				),
			)


pure func test_implementation_headers_reject_method_parameter_owner_collision() -> Bool:
	implementation_headers_reject_method_parameter_owner_collision().get_or(False)


private pure func implementation_method_type_parameter_names_preserve_discovery_order() -> Option[Bool]:
	source: String =
		|record Declared {value: Int}
		|
		|trait Transform:
		|	pure func anchor(value: Self) -> Int
		|
		|implements Transform for Int:
		|	pure func anchor(value: Int) -> Int:
		|		value
		|
		|	pure func transform[Explicit](declared: Declared, first: (ParameterFirst, Repeated), second: (Repeated, ParameterSecond), dimensioned: Int[#ParameterDimension]) -> (ReturnFirst, Repeated, ReturnSecond) where #ConstraintLeft + #ParameterDimension == #ConstraintRight, #ConstraintRight == #ConstraintTail:
		|		0
	graph ?= implementation_graph(source)
	header ?= implementation_header_graph_headers(graph).get(0)
	method ?= implementation_header_methods(header).find(func(candidate):
		implementation_method_header_name(candidate) == "transform"
	)
	names = explicit_implementation_method_parameters(method).map(func(parameter):
		callable_type_parameter_id_name(
			resolved_implementation_method_type_parameter_id(parameter),
		)
	)

	Some(
		names == [
			"Explicit",
			"ParameterFirst",
			"Repeated",
			"ParameterSecond",
			"#ParameterDimension",
			"ReturnFirst",
			"ReturnSecond",
			"#ConstraintLeft",
			"#ConstraintRight",
			"#ConstraintTail",
		],
	)


pure func test_implementation_method_type_parameter_names_preserve_discovery_order() -> Bool:
	implementation_method_type_parameter_names_preserve_discovery_order().get_or(False)


private pure func implementation_method_type_parameters_preserve_bounds_and_exclude_owner() -> Option[Bool]:
	source: String =
		|trait LocalBound:
		|	pure func local_bound(value: Self) -> Int
		|
		|trait Carrier:
		|	pure func required(value: Self) -> Int
		|
		|record Box[Owner] {value: Owner}
		|
		|implements Carrier for Box[Owner]:
		|	pure func required(value: Box[Owner]) -> Int:
		|		0
		|
		|	pure func choose(owner: Owner, candidate: List[Bounded: LocalBound]) -> Bounded:
		|		candidate[0]
	graph ?= implementation_graph(source)
	header ?= implementation_header_graph_headers(graph).get(0)
	method ?= implementation_header_methods(header).find(func(candidate):
		implementation_method_header_name(candidate) == "choose"
	)
	parameter ?= explicit_implementation_method_parameters(method).get(0)
	bound ?= resolved_implementation_method_type_parameter_bounds(parameter).get(0)
	definition_table = implementation_header_graph_definition_table(graph)

	Some(
		explicit_implementation_method_parameters(method).length() == 1
			and callable_type_parameter_id_name(
				resolved_implementation_method_type_parameter_id(parameter),
			) == "Bounded"
			and trait_id_name(definition_table, bound) == "LocalBound",
	)


pure func test_implementation_method_type_parameters_preserve_bounds_and_exclude_owner() -> Bool:
	implementation_method_type_parameters_preserve_bounds_and_exclude_owner().get_or(False)


private pure func implementation_headers_bucket_methods_by_exact_implementation() -> Option[Bool]:
	source: String =
		|trait Measure:
		|	pure func measure(value: Self) -> Int
		|	pure func doubled(value: Self) -> Int: measure(value) * 2
		|
		|func unrelated_before() -> Int: 1
		|
		|record First {value: Int}
		|record Second {value: Int}
		|
		|implements Measure for First:
		|	pure func measure(value: First) -> Int: value.value
		|	pure func extra(value: First) -> Int: value.value + 1
		|
		|func unrelated_between() -> Int: 2
		|
		|implements Measure for Second:
		|	pure func measure(value: Second) -> Int: value.value * 2
		|
		|func unrelated_after() -> Int: 3
	graph ?= implementation_graph(source)
	first ?= implementation_header_graph_headers(graph).get(0)
	second ?= implementation_header_graph_headers(graph).get(1)
	first_methods = implementation_header_methods(first)
	second_methods = implementation_header_methods(second)
	first_explicit_names = first_methods
		.filter(func(method): explicit_implementation_method_signature(method).is_some())
		.map(implementation_method_header_name)
	second_explicit_names = second_methods
		.filter(func(method): explicit_implementation_method_signature(method).is_some())
		.map(implementation_method_header_name)
	first_default_names = first_methods
		.filter(func(method): explicit_implementation_method_signature(method).is_none())
		.map(implementation_method_header_name)
	second_default_names = second_methods
		.filter(func(method): explicit_implementation_method_signature(method).is_none())
		.map(implementation_method_header_name)

	Some(
		implementation_header_graph_headers(graph).length() == 2
		and first_methods.length() == 3
		and second_methods.length() == 2
		and first_explicit_names == ["measure", "extra"]
		and second_explicit_names == ["measure"]
		and first_default_names == ["doubled"]
		and second_default_names == ["doubled"]
	)


pure func test_implementation_headers_bucket_methods_by_exact_implementation() -> Bool:
	implementation_headers_bucket_methods_by_exact_implementation().get_or(False)


private pure func implementation_headers_preserve_error_order_across_implementations() -> Option[Bool]:
	source: String =
		|trait Renderable:
		|	pure func render(value: Self) -> String
		|
		|record First[T] {value: T}
		|record Second[T] {value: T}
		|
		|implements Renderable for First[T]:
		|	pure func render[T](value: First[T]) -> String:
		|		"first"
		|
		|implements Renderable for Second[T]:
		|	pure func render[T](value: Second[T]) -> String:
		|		"second"
	indexed ?= indexed_graph_build(fixture_module_load_candidate(source), []).to_option()
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	topology ?= trait_topology_graph_build(type_headers).to_option()
	callables ?= callable_header_graph_build(topology).to_option()

	shadow_message: String = (
		"implementation method 'render' redeclares implementation type parameter 'T'; "
		+ "remove it from the method's type parameter list because implementation "
		+ "parameters are already in scope"
	)
	missing_message: String = "implementation of 'Renderable' is missing required method 'render'"

	match implementation_header_graph_build(callables):
		Ok(_):
			Some(False)
		Err(errors):
			messages = errors.map(implementation_header_graph_error_message)

			match (errors.get(0), errors.get(2)):
				(Some(first_shadow_error), Some(second_shadow_error)):
					Some(
						errors.length() == 4
						and messages == [shadow_message, missing_message, shadow_message, missing_message]
						and (
							implementation_header_graph_error_span(first_shadow_error).start_line
							< implementation_header_graph_error_span(second_shadow_error).start_line
						)
					)
				_:
					Some(False)


pure func test_implementation_headers_preserve_error_order_across_implementations() -> Bool:
	implementation_headers_preserve_error_order_across_implementations().get_or(False)


tests: TestSuite = {
	description = "Compiler implementation headers",
	tests = [
		(
			"resolve exact implementation headers",
			test_implementation_headers_are_exact,
		),
		(
			"default method headers substitute the implementation receiver",
			test_default_method_header_substitutes_receiver,
		),
		(
			"default method headers reject a foreign implementation owner",
			test_default_method_header_rejects_foreign_implementation,
		),
		(
			"reject missing required methods",
			test_implementation_headers_reject_missing_required_method,
		),
		(
			"reject method and implementation parameter owner collision",
			test_implementation_headers_reject_method_parameter_owner_collision,
		),
		(
			"method type parameters preserve first discovery order",
			test_implementation_method_type_parameter_names_preserve_discovery_order,
		),
		(
			"bucket methods by exact implementation identity",
			test_implementation_headers_bucket_methods_by_exact_implementation,
		),
		(
			"preserve error order across implementations",
			test_implementation_headers_preserve_error_order_across_implementations,
		),
		(
			"method type parameters preserve bounds and exclude owner parameters",
			test_implementation_method_type_parameters_preserve_bounds_and_exclude_owner,
		),
	]
}
