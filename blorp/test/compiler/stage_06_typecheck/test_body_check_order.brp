	validated_body_table_rejects_different_plan_consumers().get_or(False)


private pure func indexed_body_table_admission_preserves_validation() -> Option[Bool]:
	input ?= accepted_module(
		"incremental",
		"func first() -> Int: 1\nfunc second() -> Int: 2",
	).to_option()
	ids ?= accepted_typecheck_module_callable_body_ids(input)
	first_id ?= ids.get(0)
	second_id ?= ids.get(1)

	first = match body_context(input, first_id):
		BodyContextReady(context):
			Some(context)
		BodyContextRejected(_):
			None

	second = match body_context(input, second_id):
		BodyContextReady(context):
			Some(context)
		BodyContextRejected(_):
			None

	first_context ?= first
	second_context ?= second
	first_outcome = check_body_context(first_context)
	second_outcome = check_body_context(second_context)
	registry = accepted_typecheck_module_body_registry(input)
	outcomes = [second_outcome, first_outcome]
	outcome_at = pure func(index: Int) -> Option[BodyCheckOutcome]: outcomes.get(index)
	var next_row_index: Dict[Int, Int] = {}
	next_row_index = next_row_index.set(0, 1)

	empty = match body_check_registry_outcome_table_from_indexed_rows(
		registry,
		None,
		next_row_index,
		outcome_at,
		0,
	):
		BodyOutcomeTableAccepted(table):
			Some(table)
		BodyOutcomeTableRejected(_):
			None

	second_table = match body_check_registry_outcome_table_from_indexed_rows(
		registry,
		Some(0),
		{},
		outcome_at,
		1,
	):
		BodyOutcomeTableAccepted(table):
			Some(table)
		BodyOutcomeTableRejected(_):
			None

	empty_table ?= empty
	with_second ?= second_table

	complete = match body_check_registry_outcome_table_from_indexed_rows(
		registry,
		Some(0),
		next_row_index,
		outcome_at,
		2,
	):
		BodyOutcomeTableAccepted(table):
			Some(table)
		BodyOutcomeTableRejected(_):
			None

	complete_table ?= complete

	batch = match (
		body_check_registry_outcome_table(
			registry,
			[second_outcome, first_outcome],
		)
	):
		BodyOutcomeTableAccepted(table):
			Some(table)
		BodyOutcomeTableRejected(_):
			None

	batch_table ?= batch

	duplicate_at = pure func(index: Int) -> Option[BodyCheckOutcome]:
		if index == 0 or index == 1:
			Some(first_outcome)
		else:
			None

	duplicate_rejected = match body_check_registry_outcome_table_from_indexed_rows(
		registry,
		Some(0),
		next_row_index,
		duplicate_at,
		2,
	):
		BodyOutcomeTableRejected(errors):
			errors.any(func(error): error.contains("duplicate body outcome for definition"))
		BodyOutcomeTableAccepted(_):
			False

	other ?= accepted_module("incremental", "func first() -> Int: 3").to_option()

	foreign_plan_rejected = match body_check_registry_outcome_table_from_indexed_rows(
		accepted_typecheck_module_body_registry(other),
		Some(1),
		{},
		outcome_at,
		1,
	):
		BodyOutcomeTableRejected(errors):
			errors.any(func(error): error.contains("different body plan"))
		BodyOutcomeTableAccepted(_):
			False

	short_chain_rejected = match body_check_registry_outcome_table_from_indexed_rows(
		registry,
		Some(0),
		{},
		outcome_at,
		2,
	):
		BodyOutcomeTableRejected(errors):
			errors.any(func(error): error.contains("malformed indexed body outcome rows"))
		BodyOutcomeTableAccepted(_):
			False

	var cyclic_next_row_index: Dict[Int, Int] = {}
	cyclic_next_row_index = cyclic_next_row_index.set(0, 0)

	cyclic_chain_rejected = match body_check_registry_outcome_table_from_indexed_rows(
		registry,
		Some(0),
		cyclic_next_row_index,
		outcome_at,
		2,
	):
		BodyOutcomeTableRejected(errors):
			errors.any(func(error): error.contains("malformed indexed body outcome rows"))
		BodyOutcomeTableAccepted(_):
			False

	incremental_subset = body_check_registry_materialize_subset_from_table(registry, complete_table)
	batch_subset = body_check_registry_materialize_subset_from_table(registry, batch_table)

	subsets_match = match (incremental_subset, batch_subset):
		(BodySubsetProgramReady(incremental), BodySubsetProgramReady(batch)):
			body_subset_program_decls(
				incremental,
			).map(
				func(
					decl,
				): typed_decl_to_json(
					decl,
				).to_string(),
			) == body_subset_program_decls(
				batch,
			).map(
				func(decl): typed_decl_to_json(decl).to_string(),
			)
		_:
			False

	Some(
		(
			body_outcome_table_count(empty_table) == 0
			and body_outcome_table_count(with_second) == 1
			and body_outcome_table_count(complete_table) == 2
			and duplicate_rejected
			and foreign_plan_rejected
			and short_chain_rejected
			and cyclic_chain_rejected
			and subsets_match
		),
	)


pure func test_indexed_body_table_admission_preserves_validation() -> Bool:
	indexed_body_table_admission_preserves_validation().get_or(False)


private pure func complete_body_table_proves_source_order_and_coverage() -> Option[Bool]:
	input ?= accepted_module(
		"complete_rows",
		"func first() -> Int: 1\nfunc second() -> Int: 2\nfunc third() -> Bool: 3",
	).to_option()
	ids ?= accepted_typecheck_module_callable_body_ids(input)
	first_id ?= ids.get(0)
	second_id ?= ids.get(1)
	third_id ?= ids.get(2)

	first = match body_context(input, first_id):
		BodyContextReady(context):
			Some(context)
		BodyContextRejected(_):
			None

	second = match body_context(input, second_id):
		BodyContextReady(context):
			Some(context)
		BodyContextRejected(_):
			None

	third = match body_context(input, third_id):
		BodyContextReady(context):
			Some(context)
		BodyContextRejected(_):
			None

	first_context ?= first
	second_context ?= second
	third_context ?= third
	registry = accepted_typecheck_module_body_registry(input)

	shuffled_table = match (
		body_check_registry_outcome_table(
			registry,
			[
				check_body_context(second_context),
				check_body_context(third_context),
				check_body_context(first_context),
			],
		)
	):
		BodyOutcomeTableAccepted(table):
			Some(table)
		BodyOutcomeTableRejected(_):
			None

	table ?= shuffled_table
	complete = body_check_registry_complete_outcome_table_from_table(
		registry,
		table,
		IgnoreMainName,
	)

	partial_table = match body_check_registry_outcome_table(
		registry,
		[check_body_context(first_context)],
	):
		BodyOutcomeTableAccepted(partial):
			Some(partial)
		BodyOutcomeTableRejected(_):
			None

	partial ?= partial_table

	partial_rejected = match body_check_registry_complete_outcome_table_from_table(
		registry,
		partial,
		IgnoreMainName,
	):
		CompleteBodyOutcomeTableRejected(errors):
			errors.any(func(error): error.contains("missing body outcome for definition"))
		CompleteBodyOutcomeTableAccepted(_):
			False

	Some(
		match complete:
			CompleteBodyOutcomeTableAccepted(complete_table):
				source_order = complete_body_outcome_table_source_order(complete_table)

				(
					complete_body_outcome_table_count(complete_table) == 3
					and source_order.length() == 3
					and source_order
						.get(0)
						.map(func(id): callable_ids_equal(id, first_id))
						.get_or(False)
					and source_order
						.get(1)
						.map(func(id): callable_ids_equal(id, second_id))
						.get_or(False)
					and source_order
						.get(2)
						.map(func(id): callable_ids_equal(id, third_id))
						.get_or(False)
					and partial_rejected
				)
			CompleteBodyOutcomeTableRejected(_):
				False
	)


pure func test_complete_body_table_proves_source_order_and_coverage() -> Bool:
	complete_body_table_proves_source_order_and_coverage().get_or(False)


private pure func complete_body_table_rejects_main_policy_mismatch() -> Option[Bool]:
	input ?= accepted_module("complete_main_policy", "func main() -> Int: 1").to_option()
	ids ?= accepted_typecheck_module_callable_body_ids(input)
	id ?= ids.get(0)
	registry = accepted_typecheck_module_body_registry(input)
	context_build ?= body_check_registry_context_for_definition_id(
		registry,
		callable_id_definition_id(id),
	)

	context = match context_build:
		BodyContextReady(ready):
			Some(ready)
		BodyContextRejected(_):
			None

	ready ?= context

	table = match body_check_registry_outcome_table(registry, [check_body_context(ready)]):
		BodyOutcomeTableAccepted(outcomes):
			Some(outcomes)
		BodyOutcomeTableRejected(_):
			None

	outcomes ?= table

	Some(
		match body_check_registry_complete_outcome_table_from_table(
			registry,
			outcomes,
			ValidateProgramMain,
		):
			CompleteBodyOutcomeTableRejected(errors):
				errors.any(func(error): error.contains("main validation policy"))
			CompleteBodyOutcomeTableAccepted(_):
				False
	)


pure func test_complete_body_table_rejects_main_policy_mismatch() -> Bool:
	complete_body_table_rejects_main_policy_mismatch().get_or(False)


private pure func bodyless_complete_body_table_is_valid() -> Option[Bool]:
	input ?= accepted_module("bodyless_complete_rows", "union Wrapped:\n\tValue(Int)").to_option()
	registry = accepted_typecheck_module_body_registry(input)

	empty_table = match body_check_registry_outcome_table(registry, []):
		BodyOutcomeTableAccepted(table):
			Some(table)
		BodyOutcomeTableRejected(_):
			None

	table ?= empty_table

	valid = match body_check_registry_complete_outcome_table_from_table(
		registry,
		table,
		IgnoreMainName,
	):
		CompleteBodyOutcomeTableAccepted(complete):
			(
				complete_body_outcome_table_count(complete) == 0
				and complete_body_outcome_table_source_order(complete).is_empty()
			)
		CompleteBodyOutcomeTableRejected(_):
			False

	Some(valid)


pure func test_bodyless_complete_body_table_is_valid() -> Bool:
	bodyless_complete_body_table_is_valid().get_or(False)


private pure func subset_materialization_rejects_duplicate_body_outcome() -> Option[Bool]:
	input ?= accepted_module("duplicate_body", "func value() -> Int: 1").to_option()
	ids ?= accepted_typecheck_module_callable_body_ids(input)
	id ?= ids.get(0)

	context = match body_context(input, id):
		BodyContextReady(ready):
			Some(ready)
		BodyContextRejected(_):
			None

	ready ?= context
	outcome = check_body_context(ready)

	rejected = match (
		body_check_registry_materialize_subset(
			accepted_typecheck_module_body_registry(input),
			[outcome, outcome],
		)
	):
		BodySubsetProgramRejected(errors):
			errors.any(func(error): error.contains("duplicate body outcome for definition"))
		BodySubsetProgramReady(_):
			False

	Some(rejected)


pure func test_subset_materialization_rejects_duplicate_body_outcome() -> Bool:
	subset_materialization_rejects_duplicate_body_outcome().get_or(False)


