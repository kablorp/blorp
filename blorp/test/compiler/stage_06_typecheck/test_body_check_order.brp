private pure func validated_body_table_rejects_different_plan_consumers() -> Option[Bool]:
	current ?= accepted_module("same", "func current() -> Int: 2").to_option()
	stale ?= accepted_module("same", "func current() -> Int: 1").to_option()
	stale_ids ?= accepted_typecheck_module_callable_body_ids(stale)
	id ?= stale_ids.get(0)

	context = match body_context(stale, id):
		BodyContextReady(ready):
			Some(ready)
		BodyContextRejected(_):
			None

	ready ?= context

	table = match body_check_registry_outcome_table(
		accepted_typecheck_module_body_registry(stale),
		[check_body_context(ready)],
	):
		BodyOutcomeTableAccepted(accepted):
			Some(accepted)
		BodyOutcomeTableRejected(_):
			None

	accepted_table ?= table

	subset_rejects = match body_check_registry_materialize_subset_from_table(
		accepted_typecheck_module_body_registry(current),
		accepted_table,
	):
		BodySubsetProgramRejected(errors):
			errors.any(func(error): error.contains("different body plan"))
		BodySubsetProgramReady(_):
			False

	seeded = body_check_registry_materialize_complete_with_seed_table(
		accepted_typecheck_module_body_registry(current),
		accepted_table,
		IgnoreMainName,
	)

	Some(
		(
			subset_rejects
			and seeded.checked_bodies == 0
			and seeded.reused_bodies == 0
			and seeded.result.state.errors.any(func(error): error.contains("different body plan"))
		),
	)


