import:
	../../../benchmark/compiler/compiler_type_home_index_profile:
		TypeHomeProfileConfig,
		TypeHomeProfileResult,
		compiler_type_home_index_profile,
	test: TestSuite


private PROFILE_MODE_BOTH: Int = 0

private PROFILE_MODE_BASELINE_LOOKUP_ONLY: Int = 1

private PROFILE_MODE_CANDIDATE_LOOKUP_ONLY: Int = 2


private pure func expected_record_requests(visible_name_count: Int) -> Int:
	visible_name_count * 2 + (visible_name_count + 3) / 4 * 2 + (visible_name_count + 7) / 8


private pure func expected_local_write_requests(visible_name_count: Int) -> Int:
	(visible_name_count + 3) / 4 + (visible_name_count + 7) / 8


private pure func expected_index_writes(visible_name_count: Int) -> Int:
	visible_name_count + expected_local_write_requests(visible_name_count)


private pure func expected_find_requests(config: TypeHomeProfileConfig) -> Int:
	config.body_count * config.queries_per_body * 2


private pure func profile_config(visible_name_count: Int) -> TypeHomeProfileConfig:
	{
		visible_name_count = visible_name_count,
		body_count = 8,
		queries_per_body = 16,
		window_order = 0,
		profile_mode = PROFILE_MODE_BOTH
	}


private pure func profile_counters_are_indexed(
	config: TypeHomeProfileConfig,
	result: TypeHomeProfileResult,
) -> Bool:
	(
		result.workload_valid
		and result.visible_name_count == config.visible_name_count
		and result.body_count == config.body_count
		and result.queries_per_body == config.queries_per_body
		and result.window_order == config.window_order
		and result.profile_mode == config.profile_mode
		and result.type_home_record_requests == expected_record_requests(config.visible_name_count)
		and result.type_home_find_requests == result.type_home_record_requests + expected_find_requests(
			config,
		)
		and result.type_home_linear_candidates_visited == 0
		and result.type_home_replacement_list_rebuilds == 0
		and result.type_home_index_reads == result.type_home_find_requests
		and result.type_home_index_writes == expected_index_writes(config.visible_name_count)
		and result.candidate_index_read_requests == result.type_home_index_reads
		and result.candidate_planned_index_writes == expected_index_writes(config.visible_name_count)
		and result.candidate_structural_linear_scan_sites == 0
		and result.candidate_structural_replacement_rebuild_sites == 0
		and result.body_session_index_rebuilds == 0
		and result.baseline_populate.type_home_record_requests == result.candidate_populate.type_home_record_requests
		and result.baseline_populate.type_home_find_requests == result.candidate_populate.type_home_find_requests
		and result.baseline_populate.type_home_linear_candidates_visited > 0
		and result.baseline_lookup.type_home_linear_candidates_visited > 0
		and result.baseline_populate.type_home_replacement_list_rebuilds == expected_local_write_requests(
			config.visible_name_count,
		)
		and result.baseline_populate.type_home_index_reads == 0
		and result.baseline_lookup.type_home_index_reads == 0
		and result.candidate_populate.type_home_linear_candidates_visited == 0
		and result.candidate_lookup.type_home_linear_candidates_visited == 0
		and result.candidate_populate.type_home_replacement_list_rebuilds == 0
		and result.candidate_lookup.type_home_replacement_list_rebuilds == 0
		and result.candidate_lookup.type_home_find_requests == expected_find_requests(config)
		and result.candidate_lookup.type_home_index_reads == expected_find_requests(config)
		and result.candidate_lookup.body_session_index_rebuilds == 0
		and result.baseline_lookup.semantic_checksum == result.candidate_lookup.semantic_checksum
		and result.baseline_final_mapping_checksum == result.candidate_final_mapping_checksum
		and result.semantic_checksum == result.candidate_final_mapping_checksum
		and result.candidate_lookup.total_allocations == result.candidate_lookup.total_releases
		and result.candidate_lookup.retained_objects == 0
		and result.semantic_checksum > 0
	)


private pure func baseline_only_profile_is_isolated(
	config: TypeHomeProfileConfig,
	result: TypeHomeProfileResult,
	expected_checksum: Int,
	expected_lookup_checksum: Int,
) -> Bool:
	(
		result.workload_valid
		and result.profile_mode == PROFILE_MODE_BASELINE_LOOKUP_ONLY
		and result.baseline_populate.elapsed_microseconds == 0
		and result.candidate_populate.elapsed_microseconds == 0
		and result.candidate_lookup.elapsed_microseconds == 0
		and result.baseline_lookup.elapsed_microseconds > 0
		and result.baseline_lookup.type_home_find_requests == expected_find_requests(config)
		and result.baseline_lookup.type_home_linear_candidates_visited > 0
		and result.baseline_lookup.semantic_checksum == expected_lookup_checksum
		and result.baseline_final_mapping_checksum == expected_checksum
		and result.candidate_final_mapping_checksum == 0
		and result.semantic_checksum == expected_checksum
		and result.type_home_find_requests == expected_find_requests(config)
		and result.type_home_linear_candidates_visited == result.baseline_lookup.type_home_linear_candidates_visited
		and result.type_home_index_reads == 0
		and result.candidate_index_read_requests == 0
		and result.candidate_structural_linear_scan_sites == 0
		and result.candidate_structural_replacement_rebuild_sites == 0
		and result.body_session_index_rebuilds == 0
	)


private pure func candidate_only_profile_is_isolated(
	config: TypeHomeProfileConfig,
	result: TypeHomeProfileResult,
	expected_checksum: Int,
	expected_lookup_checksum: Int,
) -> Bool:
	(
		result.workload_valid
		and result.profile_mode == PROFILE_MODE_CANDIDATE_LOOKUP_ONLY
		and result.baseline_populate.elapsed_microseconds == 0
		and result.candidate_populate.elapsed_microseconds == 0
		and result.baseline_lookup.elapsed_microseconds == 0
		and result.candidate_lookup.elapsed_microseconds > 0
		and result.candidate_lookup.type_home_find_requests == expected_find_requests(config)
		and result.candidate_lookup.type_home_index_reads == expected_find_requests(config)
		and result.candidate_lookup.type_home_linear_candidates_visited == 0
		and result.candidate_lookup.type_home_replacement_list_rebuilds == 0
		and result.candidate_lookup.body_session_index_rebuilds == 0
		and result.candidate_lookup.semantic_checksum == expected_lookup_checksum
		and result.baseline_final_mapping_checksum == 0
		and result.candidate_final_mapping_checksum == expected_checksum
		and result.semantic_checksum == expected_checksum
		and result.type_home_find_requests == expected_find_requests(config)
		and result.type_home_linear_candidates_visited == 0
		and result.type_home_index_reads == expected_find_requests(config)
		and result.candidate_index_read_requests == expected_find_requests(config)
		and result.candidate_structural_linear_scan_sites == 0
		and result.candidate_structural_replacement_rebuild_sites == 0
		and result.body_session_index_rebuilds == 0
	)


func test_type_home_profile_scales_visible_names_independently() -> Bool:
	config64 = profile_config(64)
	config256 = profile_config(256)
	config1024 = profile_config(1024)
	alternate_config = { config256 | window_order = 1 }
	result64 = compiler_type_home_index_profile(config64)
	result256 = compiler_type_home_index_profile(config256)
	result1024 = compiler_type_home_index_profile(config1024)
	alternate_result = compiler_type_home_index_profile(alternate_config)

	(
		profile_counters_are_indexed(config64, result64)
		and profile_counters_are_indexed(config256, result256)
		and profile_counters_are_indexed(config1024, result1024)
		and profile_counters_are_indexed(alternate_config, alternate_result)
		and alternate_result.baseline_lookup.semantic_checksum == result256.baseline_lookup.semantic_checksum
		and alternate_result.candidate_lookup.semantic_checksum == result256.candidate_lookup.semantic_checksum
		and alternate_result.baseline_final_mapping_checksum == result256.baseline_final_mapping_checksum
		and alternate_result.candidate_final_mapping_checksum == result256.candidate_final_mapping_checksum
		and result64.candidate_lookup.type_home_find_requests == result256.candidate_lookup.type_home_find_requests
		and result256.candidate_lookup.type_home_find_requests == result1024.candidate_lookup.type_home_find_requests
		and result64.candidate_lookup.body_session_index_rebuilds == result256.candidate_lookup.body_session_index_rebuilds
		and result256.candidate_lookup.body_session_index_rebuilds == result1024.candidate_lookup.body_session_index_rebuilds
		and result64.candidate_lookup.total_allocations == result256.candidate_lookup.total_allocations
		and result256.candidate_lookup.total_allocations == result1024.candidate_lookup.total_allocations
		and result64.candidate_lookup.total_releases == result256.candidate_lookup.total_releases
		and result256.candidate_lookup.total_releases == result1024.candidate_lookup.total_releases
		and result64.baseline_lookup.type_home_linear_candidates_visited < result256.baseline_lookup.type_home_linear_candidates_visited
		and result256.baseline_lookup.type_home_linear_candidates_visited < result1024.baseline_lookup.type_home_linear_candidates_visited
	)


func test_type_home_profile_isolated_modes_share_checksum() -> Bool:
	config = profile_config(256)
	baseline_config = {
		config |
		profile_mode = PROFILE_MODE_BASELINE_LOOKUP_ONLY
	}
	candidate_config = {
		config |
		profile_mode = PROFILE_MODE_CANDIDATE_LOOKUP_ONLY
	}
	both_result = compiler_type_home_index_profile(config)
	baseline_result = compiler_type_home_index_profile(baseline_config)
	candidate_result = compiler_type_home_index_profile(candidate_config)

	(
		profile_counters_are_indexed(config, both_result)
		and baseline_only_profile_is_isolated(
			baseline_config,
			baseline_result,
			both_result.semantic_checksum,
			both_result.baseline_lookup.semantic_checksum,
		)
		and candidate_only_profile_is_isolated(
			candidate_config,
			candidate_result,
			both_result.semantic_checksum,
			both_result.candidate_lookup.semantic_checksum,
		)
		and baseline_result.semantic_checksum == candidate_result.semantic_checksum
		and baseline_result.baseline_lookup.semantic_checksum == candidate_result.candidate_lookup.semantic_checksum
	)


tests: TestSuite = {
	description = "Compiler type-home index profile benchmark Tests",
	tests = [
		(
			"type home profile scales visible names independently",
			test_type_home_profile_scales_visible_names_independently,
		),
		(
			"type home profile isolates selected lookup mode",
			test_type_home_profile_isolated_modes_share_checksum,
		),
	]
}
