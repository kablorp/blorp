-- Generic function bodies returning the correct types should pass
import:
	option: Option(Some, None)


-- Return type param directly: OK
func identity[T](x: T) -> T:
	x


-- Return from match arm: OK
func first[T](a: T, b: T) -> T:
	match True:
		True: a
		_: b


-- Return from if: OK
func pick[T](a: T, b: T, flag: Bool) -> T:
	match flag:
		True: a
		_: b


-- Return Option[T]: OK
func maybe[T](x: T, flag: Bool) -> Option[T]:
	match flag:
		True: Some(x)
		_: None


-- Return List[T] from list operations: OK (same T)
func singleton[T](x: T) -> List[T]:
	[x]


-- Swap is correct when return matches declaration
func swap[T, U](a: T, b: U) -> (T, U):
	(a, b)


-- Same type param equality: OK
func same_eq[T:Equatable](x: T, y: T) -> Bool:
	x == y


func main(args: List[String]) -> Int:
	0
