-- Test: 2D cross-parameter constraints via unification.
-- The ..#H and ..#W reference dimensions from the grid parameter.
pure func tile_at[T, #H, #W](grid: T[#H, #W], row: ..#H, col: ..#W) -> T:
	grid[row, col]


func main(args: List[String]) -> Int:
	grid: Int[#4, #3] = matrix(0, 4, 3)
	var sum: Int = 0
	for row in 0..4:
		for col in 0..3:
			sum += tile_at(grid, row, col)
	sum
