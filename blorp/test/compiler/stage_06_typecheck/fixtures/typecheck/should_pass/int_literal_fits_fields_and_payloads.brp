-- RUN-BLORP-CHECK
-- Struct and record fields, Option payloads and tuple elements check a literal against their type.
fixed record Pixel {level: UInt8, offset: Int8}
record Sample {channel: UInt16}


func main(args: List[String]) -> Int:
	pixel: Pixel = {level = 255, offset = -128}
	sample: Sample = {channel = 65535}
	maybe: Option[Int8] = Some(127)
	pair: (Int8, UInt8) = (-1, 1)
	0
