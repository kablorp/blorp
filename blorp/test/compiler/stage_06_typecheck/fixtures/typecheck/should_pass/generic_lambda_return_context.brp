record Cache[K, V] {
	capacity: Int,
	data: Dict[K, (V, Int)],
	counter: Int
}


func make_with_lambda[K, V](capacity: Int) -> Cache[K, V]:
	f: (Int) -> Cache[K, V] = func(n: Int) -> Cache[K, V]:
		{
			capacity = n,
			data = {},
			counter = 0
		}
	f(capacity)


func identity_with_lambda[T](x: T) -> T:
	f: (T) -> T = func(y: T) -> T:
		y
	f(x)


func main(args: List[String]) -> Int:
	c: Cache[String, Int] = make_with_lambda(4)
	value: Int = identity_with_lambda(8)
	c.capacity + value
