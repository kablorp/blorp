import:
	net/tcp:
		IpFamily(IPv4),
		TcpError,
		accept,
		connect_loopback,
		listen_loopback_any_port,
		local_port,
		message,
		port,
		read_chunk,
		set_reuse_addr,
		set_timeout,
		stream_local_port,
		write_all,


func listener_port() -> Result[Int, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 1):
		local_port(listener)


func configure_listener() -> Result[Void, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 1):
		ignored ?= set_timeout(listener, 1000)
		set_reuse_addr(listener)


func connect_scoped() -> Result[Int, TcpError]:
	remote ?= port(1)
	with stream ?= connect_loopback(IPv4, remote):
		stream_local_port(stream)


func scoped_round_trip_shape() -> Result[Int, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 1):
		port_num ?= local_port(listener)
		remote ?= port(port_num)
		with client ?= connect_loopback(IPv4, remote):
			with peer ?= accept(listener):
				ignored ?= write_all(client, "tcp".to_bytes())
				data ?= read_chunk(peer, 16)
				Ok(data.length())


pure func tcp_error_message(err: TcpError) -> String:
	message(err)
