import:
	fs:
		FileAppendable,
		FileReadAt,
		FileReadable,
		FileSized,
		FileWritable,
		open_read,
		open_read_append,
		open_write,


func requires_read_capabilities[T:FileReadable+FileReadAt+FileSized](value: T) -> Int:
	1


func requires_write_capability[T:FileWritable](value: T) -> Int:
	1


func requires_append_capability[T:FileAppendable](value: T) -> Int:
	1


func read_text_with_trait(path: String) -> Result[String, IOError]:
	with reader: FileReader ?= open_read(path):
		reader.read_text()


func write_text_with_trait(path: String) -> Result[Void, IOError]:
	with writer: FileWriter ?= open_write(path):
		writer.write_text("x")


func read_at_then_append(path: String) -> Result[Int, IOError]:
	with file: FileReadAppender ?= open_read_append(path):
		size ?= file.size()
		chunk ?= file.read_chunk_at(0, 1)
		appended ?= file.append_text("\n")
		Ok(size + chunk.length())
