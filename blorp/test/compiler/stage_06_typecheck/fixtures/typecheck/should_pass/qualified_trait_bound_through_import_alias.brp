-- RUN-BLORP-CHECK
-- A bound may name a trait as `alias.Trait` when the module that declares it
-- is imported under that alias. The alias is resolved like a qualified type's
-- qualifier; the bare name `Shape` is not imported here.
import:
	../helpers/qualified_bound_shapes as shapes: area, make_square


pure func total_area[T: shapes.Shape](first: T, second: T) -> Int:
	area(first) + area(second)


pure func describe[T: shapes.Shape + Equatable](item: T) -> Int:
	area(item)


trait Measured: shapes.Shape:
	pure func name(self: Self) -> String


func main(args: List[String]) -> Int:
	total_area(make_square(2), make_square(3))
