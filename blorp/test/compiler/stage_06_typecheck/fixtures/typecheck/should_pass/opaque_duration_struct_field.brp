import:
	units: Duration, microseconds, to_microseconds


fixed record TimedChecksum {
	elapsed: Duration,
	checksum: Int
}


func main(args: List[String]) -> Int:
	result: TimedChecksum = {
		elapsed = microseconds(42),
		checksum = 7
	}
	if to_microseconds(result.elapsed) == 42 and result.checksum == 7:
		0
	else:
		1
