import:
	bytes as B
	net/websocket as WS: Message(Text), WebSocketError, WebSocketSession


type alias SessionHandle = WebSocketSession


func websocket_types_are_importable() -> Int:
	err: WebSocketError = WS.Unsupported("not built")
	msg: Message = Text("hello")
	if WS
		.message(err)
		.contains("unsupported"):
		match msg:
			Text(_): 1
			_: 0
	else:
		0


func websocket_write_operations_are_resource_operations() -> Result[Int, WebSocketError]:
	with session ?= WS.connect("ws://example.com/socket"):
		payload: Bytes = B.bytes(0)
		_ = WS.receive(session)
		_ = WS.send_text(session, "hello")
		_ = WS.send_binary(session, payload)
		_ = WS.send_ping(session, payload)
		_ = WS.send_pong(session, payload)
		_ = WS.send_close(session, 1000, "done")
		Ok(1)


func main(args: List[String]) -> Int:
	if WS.native_available():
		websocket_types_are_importable()
	else:
		websocket_types_are_importable()
