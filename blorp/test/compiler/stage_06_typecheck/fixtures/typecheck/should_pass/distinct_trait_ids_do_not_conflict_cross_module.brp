-- RUN-BLORP-CHECK
-- Each helper owns a distinct nominal `Show` trait and an implementation for
-- that trait. Equal source names do not make their exact TraitIds coherent,
-- so both modules can participate in one compilation without conflict.
import:
	../helpers/cross_impl_a as A
	../helpers/cross_impl_b as B


func main(args: List[String]) -> Int:
	value: Int = 1
	left: String = A.show(value)
	right: String = B.show(value)
	0
