-- Regression: contextual purity inference for an outer lambda must not inspect
-- an uncalled nested impure lambda body. Creating the closure is pure; calling it
-- would be checked at the call site.
pure func accept(f: pure (Int) -> Int) -> Int:
	f(1)


func test() -> Int:
	accept(func(x: Int) -> Int:
		inner = func() -> Int:
			print("not called")
			0
		x + 1
	)
