-- RUN-BLORP-CHECK
import:
	channel: wait_recv, wait_send


func slow_value() -> Int:
	sleep(10)
	1


func classify_error(error: ConcurrencyError) -> Int:
	match error:
		Timeout:
			0
		TaskFailed(_):
			1
		Cancelled:
			2


func main(args: List[String]) -> Int:
	concurrent(timeout: 1):
		value = slow_value()

	match value:
		Ok(_):
			0
		Err(error):
			classify_error(error)
