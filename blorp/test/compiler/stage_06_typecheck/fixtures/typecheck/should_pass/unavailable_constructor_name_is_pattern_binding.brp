-- A qualified-only constructor with the same spelling must not stop a pattern
-- name from becoming a local binding or from being captured by a closure.
import:
	../helpers/constructor_visibility_mod as CV


union OtherChoice:
	Other


func captured(value: Int) -> Int:
	match value:
		ExternalSome:
			read = func(): ExternalSome
			read()


func bound_on_other_union(value: OtherChoice) -> Int:
	match value:
		ExternalNone:
			match ExternalNone:
				Other:
					1


func bound_on_constructor_union() -> Int:
	match CV.default_choice():
		choice:
			match choice:
				CV.ExternalSome(value):
					value
				CV.ExternalNone:
					1


func main(args: List[String]) -> Int:
	captured(7) + bound_on_other_union(Other) + bound_on_constructor_union()
-- RUN-BLORP-CHECK
