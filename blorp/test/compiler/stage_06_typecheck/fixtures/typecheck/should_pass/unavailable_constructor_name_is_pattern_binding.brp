-- A qualified-only constructor with the same spelling must not stop a pattern
-- name from becoming a local binding or from being captured by a closure.
import:
	../helpers/constructor_visibility_mod as CV


func captured(value: Int) -> Int:
	match value:
		ExternalSome:
			read = func(): ExternalSome
			read()


func main(args: List[String]) -> Int:
	_ = CV.default_choice()
	captured(7) - 7
-- RUN-BLORP-CHECK
