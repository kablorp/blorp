import:
	option: Option(Some, None)
	result: Result(Ok, Err)


-- Test: nested patterns with full coverage are exhaustive
-- Option[Option[Int]] fully covered
func nested_option(x: Option[Option[Int]]) -> Int:
	match x:
		Some(Some(n)): n
		Some(None): 0
		None: -1


-- Result[Option[Int], String] fully covered
func result_option(x: Result[Option[Int], String]) -> Int:
	match x:
		Ok(Some(n)): n
		Ok(None): 0
		Err(_): -1


-- Tuple of bools fully covered
func tuple_bools(x: (Bool, Bool)) -> Int:
	match x:
		(True, True): 1
		(True, False): 2
		(False, True): 3
		(False, False): 4


-- Mixed: some arms use wildcard for inner
func mixed_wildcard(x: Option[Bool]) -> Int:
	match x:
		Some(True): 1
		Some(False): 2
		None: 0
