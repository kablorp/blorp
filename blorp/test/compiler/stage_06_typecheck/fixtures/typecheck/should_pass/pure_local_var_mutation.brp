-- Test: Pure function with local mutable variable reassignment
-- Local mutation is allowed because impurity doesn't escape
pure func swap_and_sum(a: Int, b: Int) -> Int:
	var x: Int = a
	var y: Int = b
	var tmp: Int = x
	x = y
	y = tmp
	x + y


pure func count_down(n: Int) -> Int:
	var i: Int = n
	var result: Int = 0
	while i > 0:
		result += i
		i -= 1
	result
