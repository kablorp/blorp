-- Test: Pure iterator pattern with counter
-- Pure functions can create and consume iterators without side effects
union Iterator[T]:
	Next(T, pure () -> Iterator[T])
	Done


-- Pure: iterate and sum values using match
pure func sum_iter(iter: Iterator[Int]) -> Int:
	match iter:
		Done: 0
		Next(value, next): value + sum_iter(next())


-- Pure: count elements in iterator
pure func count_iter(iter: Iterator[Int]) -> Int:
	match iter:
		Done: 0
		Next(_, next): 1 + count_iter(next())


-- Pure: create a range iterator
pure func range_iter(current: Int, end: Int) -> Iterator[Int]:
	if current >= end:
		Done
	else:
		Next(current, pure func(): range_iter(current + 1, end))


-- Pure: compose iterators
pure func use_iterators() -> Int:
	iter: Iterator[Int] = range_iter(1, 4)
	sum_iter(iter)
