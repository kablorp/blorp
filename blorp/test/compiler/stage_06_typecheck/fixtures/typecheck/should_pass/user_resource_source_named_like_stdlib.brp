-- A module's own `ResourceSource` record is an ordinary value, not the stdlib
-- `stream::ResourceSource`: stdlib importers always spell it qualified (it is
-- not on the ABI list), so the bare spelling names only a local declaration.
record ResourceSource[R, E] {
	payload: R,
	error_label: E
}


func main(args: List[String]) -> Int:
	source: ResourceSource[String, String] = { payload = "r", error_label = "e" }
	pair: (ResourceSource[String, String], Int) = (source, 1)
	0
