-- Control-flow narrowing with length(v) — should be accepted
-- Basic: if i >= 0 and i < length(v), prove v[i] safe
pure func safe_get(v: Int[#10], i: Int) -> Int:
	if i >= 0 and i < length(v):
		v[i]
	else:
		0


-- Method-style length must carry the same dimension refinement as length(v).
pure func safe_get_method(v: Int[#10], i: Int) -> Int:
	if i >= 0 and i < v.length():
		v[i]
	else:
		0


-- With generic dimension
pure func safe_get_generic[#N](v: Float[#N], i: Int) -> Float:
	if i >= 0 and i < length(v):
		v[i]
	else:
		0.0


-- Two tensors, independent narrowing
pure func safe_get_two(a: Int[#5], b: Int[#8], i: Int, j: Int) -> Int:
	if (
		i >= 0
		and i < length(a)
		and j >= 0
		and j < length(b)
	):
		a[i] + b[j]
	else:
		0


-- Reversed comparison: 0 <= i and length(v) > i
pure func safe_get_reversed(v: Int[#10], i: Int) -> Int:
	if 0 <= i and length(v) > i:
		v[i]
	else:
		0


-- With Option return
pure func safe_get_option(v: Int[#10], i: Int) -> Option[Int]:
	if i >= 0 and i < length(v):
		Some(v[i])
	else:
		None
