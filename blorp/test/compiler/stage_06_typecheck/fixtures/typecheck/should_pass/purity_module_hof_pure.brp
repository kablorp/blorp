-- Test: Pure function using std/list HOFs with pure callbacks should compile.
import:
	list: filter, fold_left, map


pure func sum_even_squares(data: List[Int]) -> Int:
	fold_left(
		map(
			filter(
				data,
				pure func(n: Int): n % 2 == 0,
			),
			pure func(n: Int): n * n,
		),
		0,
		pure func(acc: Int, x: Int): acc + x,
	)


func main(args: List[String]) -> Int:
	sum_even_squares([1, 2, 3, 4, 5, 6])
