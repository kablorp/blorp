import:
	bytes as B
	fs: IOError, open_read, open_write, read_bytes, read_text, write_bytes, write_text


func copy_text(src: String, dst: String) -> Result[Int, IOError]:
	with reader ?= open_read(src):
		text ?= reader.read_text()
		with writer ?= open_write(dst):
			match writer.write_text(text):
				Ok(_): Ok(text.length())
				Err(err): Err(err)


func copy_bytes(src: String, dst: String) -> Result[Int, IOError]:
	with reader ?= open_read(src):
		data ?= reader.read_bytes()
		with writer ?= open_write(dst):
			match writer.write_bytes(data):
				Ok(_): Ok(B.length(data))
				Err(err): Err(err)
