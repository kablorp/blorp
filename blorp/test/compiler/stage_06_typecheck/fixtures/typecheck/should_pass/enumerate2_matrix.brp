-- enumerate2 on a 2D matrix gives (i, j, val) for flat 2D iteration
import:
	tensor: matrix


func sum_indexed(m: Float[#3, #4]) -> Float:
	var total: Float = 0.0
	for (i, j, val) in enumerate2(m):
		total += val
	total


func main(args: List[String]) -> Int:
	m: Float[#3, #4] = matrix(1.0, 3, 4)
	to_int(sum_indexed(m))
