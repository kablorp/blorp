private pure func double(value: Int) -> Int:
	value * 2


private pure func is_large(value: Int) -> Bool:
	value > 10


VALUES: List[Int] = [4, 8, 21]

DOUBLED: List[Int] = VALUES.map(double)

FILTERED: List[Int] = DOUBLED.filter(is_large)


func main(args: List[String]) -> Int:
	if FILTERED.length() == 2 and FILTERED.get_or(1, 0) == 42:
		0
	else:
		1
