opaque type Email = String

opaque type UserId = Int


pure func email(raw: String) -> Email:
	into_opaque Email(raw)


pure func email_value(value: Email) -> String:
	from_opaque Email(value)


pure func user_id(raw: Int) -> UserId:
	into_opaque UserId(raw)


pure func next_user_id(value: UserId) -> UserId:
	into_opaque UserId(from_opaque UserId(value) + 1)


func main(args: List[String]) -> Int:
	value: UserId = next_user_id(user_id(41))

	if email_value(email("a@example.com")) == "a@example.com" and from_opaque UserId(value) == 42:
		0
	else:
		1
