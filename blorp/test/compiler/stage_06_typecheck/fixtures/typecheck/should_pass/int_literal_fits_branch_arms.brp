-- RUN-BLORP-CHECK
-- The arms of an if or match expression check a literal against the expected result type.
pure func sign_of(flag: Bool) -> Int8:
	if flag:
		1
	else:
		-1


pure func level_of(value: Option[Int]) -> UInt8:
	match value:
		Some(_):
			255
		None:
			0


func main(args: List[String]) -> Int:
	0
