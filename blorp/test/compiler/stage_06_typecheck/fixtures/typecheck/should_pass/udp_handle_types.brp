import:
	net/udp as UDP: UdpError, UdpSocket


func scoped_udp_shape() -> Result[Int, UdpError]:
	with sock: UdpSocket ?= UDP.socket():
		ignored ?= UDP.bind_numeric(sock, "127.0.0.1", 0)
		port ?= UDP.local_port(sock)
		Ok(port)


func scoped_udp_send_shape() -> Result[Int, UdpError]:
	with sock: UdpSocket ?= UDP.socket():
		ignored ?= UDP.bind(sock, "127.0.0.1", 0)
		sent ?= UDP.send_to_numeric(sock, "ping".to_bytes(), "127.0.0.1", 9)
		waited ?= UDP.send_to_wait_numeric(sock, "pong".to_bytes(), "127.0.0.1", 9)
		Ok(sent + waited)


func scoped_udp_recv_shape() -> Result[Int, UdpError]:
	with sock: UdpSocket ?= UDP.socket():
		datagram ?= UDP.recv_from(sock, 64)
		Ok(datagram.data.length() + datagram.port)


func main(args: List[String]) -> Int:
	0
