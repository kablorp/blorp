-- RUN-BLORP-CHECK
-- An integer literal pattern is checked against the scrutinee's type, including each bound.
pure func describe(byte: UInt8) -> String:
	match byte:
		0:
			"zero"
		255:
			"max"
		_:
			"other"


pure func sign_name(offset: Int8) -> String:
	match offset:
		-128:
			"min"
		127:
			"max"
		_:
			"other"


func main(args: List[String]) -> Int:
	0
