private pure func calc(value: Float) -> Float:
	(value * 2.0 - 1.5) / 2.0


RESULT: Float = calc(3.5)

COMPARISON: Bool = RESULT > 2.0 and -RESULT < -2.0

LABEL: String = "result=${RESULT}"


func main(args: List[String]) -> Int:
	if (
		RESULT == 2.75
		and COMPARISON
		and LABEL == "result=2.75"
	):
		0
	else:
		1
