-- Generic record with dimension parameters should type-check
record Layer[#In, #Out] {
	weights: Float[#In, #Out],
	bias: Float[#Out]
}


func make_layer[#In, #Out](w: Float[#In, #Out], b: Float[#Out]) -> Layer[#In, #Out]:
	{
		weights = w,
		bias = b
	}


func main(args: List[String]) -> Int:
	w: Float[#4, #2] = matrix(0.0, 4, 2)
	b: Float[#2] = vector(0.0, 2)
	layer: Layer[#4, #2] = make_layer(w, b)
	0
