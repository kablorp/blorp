-- Pure functions using list HOFs with pure callbacks should compile and run
import:
	list: all, any, filter, fold_left, map
	test: TestSuite


pure func double_all(items: List[Int]) -> List[Int]:
	items.map(pure func(x: Int): x * 2)


pure func evens_only(items: List[Int]) -> List[Int]:
	items.filter(pure func(x: Int): x % 2 == 0)


pure func sum_all(items: List[Int]) -> Int:
	items.fold_left(0, pure func(acc: Int, x: Int): acc + x)


pure func all_positive(items: List[Int]) -> Bool:
	items.all(pure func(x: Int): x > 0)


pure func has_negative(items: List[Int]) -> Bool:
	items.any(pure func(x: Int): x < 0)


func test_double() -> Bool:
	double_all([1, 2, 3]) == [2, 4, 6]


func test_evens() -> Bool:
	evens_only([1, 2, 3, 4]) == [2, 4]


func test_sum() -> Bool:
	sum_all([1, 2, 3, 4]) == 10


func test_all_positive() -> Bool:
	all_positive([1, 2, 3]) and not all_positive([1, -2, 3])


func test_has_negative() -> Bool:
	has_negative([1, -2, 3]) and not has_negative([1, 2, 3])


tests: TestSuite = {
	description = "Pure List HOFs",
	tests = [
		("double all", test_double),
		("evens only", test_evens),
		("sum all", test_sum),
		("all positive", test_all_positive),
		("has negative", test_has_negative),
	]
}
