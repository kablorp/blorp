-- Verify string UFCS methods produce correct results when called from modules.
import:
	../helpers/uses_string_prelude: find_equals, get_prefix, has_dash, strip


func main(args: List[String]) -> Int:
	-- s.index_of("=") via UFCS
	match find_equals("key=value"):
		Some(pos):
			if pos != 3:
				print("FAIL: expected pos=3, got " + to_string(pos))
				1
			else if get_prefix("abcdef") != "abc":
				1
			else if not has_dash("-flag"):
				1
			else if strip("  ok  ") != "ok":
				1
			else:
				0
		None:
			print("FAIL: expected Some, got None")
			1
