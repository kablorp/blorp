-- RUN-BLORP-CHECK
-- Literal positions that keep their compile-time proofs, and Int bindings that can change.
func main(args: List[String]) -> Int:
	v: Int[#3] = {1, 2, 3}
	last = v[-1]
	parenthesized = v[(2)]
	var total = 0

	for i in 0..(3):
		total += v[i]

	n: #3 = 3
	var z = n
	z += 1
	x: Int8 = 5
	y: Int8 = x
	total + last + parenthesized + z
