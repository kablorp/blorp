import:
	matrix: from_row_major_vector, to_row_major_vector


pure func flatten(values: Int[#2, #3]) -> Int[#6]:
	values.to_row_major_vector()


pure func rebuild(values: Int[#6]) -> Int[#2, #3]:
	from_row_major_vector(values, 2, 3)


pure func roundtrip(values: Int[#2, #3]) -> Bool:
	flat: Int[#6] = values.to_row_major_vector()
	rebuilt: Int[#2, #3] = from_row_major_vector(flat, 2, 3)
	rebuilt[0, 0] == values[0, 0] and rebuilt[1, 2] == values[1, 2]


func main(args: List[String]) -> Int:
	0
