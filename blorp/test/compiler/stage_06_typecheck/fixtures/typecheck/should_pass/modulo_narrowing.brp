-- Modulo narrowing: i % N produces ..#N, enabling safe subscript
-- Ring buffer: i % 256 is always in [0, 256)
pure func ring_buffer(v: Float[#256], i: Int) -> Float:
	v[i % 256]


-- Modulus matches dimension exactly
pure func circular_index(v: Int[#10], i: Int) -> Int:
	v[i % 10]


-- Modulus smaller than dimension: ..#5 fits in #10
pure func smaller_mod(v: Int[#10], i: Int) -> Int:
	v[i % 5]


-- Modulus via length(v) with concrete dimension
pure func circular_via_length(v: Int[#10], i: Int) -> Int:
	v[i % length(v)]


-- In a loop: ring buffer write pattern
pure func fill_ring(v: Float[#64], total: Int) -> Float:
	var sum: Float = 0.0
	for i in 0..total:
		sum += v[i % 64]
	sum
