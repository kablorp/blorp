import:
	tensor: indices


-- indices: for i in indices(v): — i is a proven tensor index
pure func sum_by_index(v: Int[#5]) -> Int:
	var sum: Int = 0
	for i in indices(v):
		sum += v[i]
	sum


pure func sum_by_index_generic[#N](v: Int[#N]) -> Int:
	var sum: Int = 0
	for i in indices(v):
		sum += v[i]
	sum


pure func row_count(m: Int[#3, #4]) -> Int:
	var count: Int = 0
	for i in indices(m):
		count += 1
	count
