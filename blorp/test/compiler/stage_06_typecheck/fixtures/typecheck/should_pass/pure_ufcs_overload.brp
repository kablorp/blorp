-- UFCS should resolve to pure overload when called from pure context
-- List.filter via UFCS in pure function
pure func positives(items: List[Int]) -> List[Int]:
	items.filter(pure func(x: Int): x > 0)


-- List.map via UFCS in pure function
pure func doubled(items: List[Int]) -> List[Int]:
	items.map(pure func(x: Int): x * 2)


-- List.find via UFCS in pure function
pure func first_big(items: List[Int]) -> Option[Int]:
	items.find(pure func(x: Int): x > 100)


-- List.count via UFCS in pure function
pure func count_neg(items: List[Int]) -> Int:
	items.count(pure func(x: Int): x < 0)


-- List.any via UFCS in pure function
pure func has_zero(items: List[Int]) -> Bool:
	items.any(pure func(x: Int): x == 0)
