-- EXPECT: error: resource-source select arms are not implemented yet
-- EXPECT: note: ResourceSource values produce scoped resources one at a time. `select` does not yet have a selected-branch resource ownership model.
import:
	net/tcp as Tcp: IpFamily(IPv4), TcpError, TcpStream
	stream: ResourceSource


func bad() -> Result[Int, TcpError]:
	with listener ?= Tcp.listen_loopback_any_port(IPv4, 1):
		source: ResourceSource[TcpStream, TcpError] = Tcp.connections_stop_on_error(listener)
		select:
			stream from source:
				_ = stream
		Ok(0)
