-- EXPECT: error: Constructor Some (from std/option) belongs to type Option (from std/option), not MyType
-- EXPECT: error: Constructor Some (from std/option) belongs to type Option (from std/option), not MyType
-- Matching a constructor against a scrutinee of the wrong union type
-- should cite the parent type with its home module so the user can
-- tell a local [Foo] from an imported [Option]. Track B: qualified
-- constructor references.
import:
	option: Option(Some, None)


union MyType:
	AA
	BB(Int)


func main(args: List[String]) -> Int:
	x: MyType = AA
	match x:
		Some(_): 1
		_: 0
