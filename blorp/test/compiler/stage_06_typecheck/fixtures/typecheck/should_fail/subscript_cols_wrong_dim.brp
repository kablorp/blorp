-- EXPECT: error: Range type ..#5 does not fit dimension of size 3
-- Using a length-proven variable (rows) as column index should fail when rows > cols
import:
	tensor: matrix


func bad_access(m: Float[#5, #3]) -> Float:
	var total: Float = 0.0

	-- r ranges 0..5 (rows), used as column index where dim is 3 — UNSAFE
	for r in 0..length(m):
		total += m[0, r]
	total


func main(args: List[String]) -> Int:
	0
