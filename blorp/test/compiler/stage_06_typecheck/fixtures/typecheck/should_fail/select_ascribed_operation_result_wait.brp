-- EXPECT: error: operation-result select arms are not implemented yet
-- EXPECT: note: `blorp_tcp_read_raw` parks the current fiber and returns ordinary data through Result.
import:
	bytes: Bytes
	net/tcp as Tcp: IpFamily(IPv4), TcpError


func bad() -> Result[Int, TcpError]:
	remote ?= Tcp.port(1)
	with stream ?= Tcp.connect_loopback(IPv4, remote):
		select:
			chunk from Tcp.read_chunk(stream, 16) as Result[Bytes, TcpError]:
				_ = chunk
		Ok(0)
