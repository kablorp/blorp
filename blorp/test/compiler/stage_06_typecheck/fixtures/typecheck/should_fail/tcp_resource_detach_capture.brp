-- EXPECT: error: detach cannot capture scoped resource: stream
import:
	net/tcp: IpFamily(IPv4), TcpError, connect_loopback, port, read_chunk


func bad(port_num: Int) -> Result[Int, TcpError]:
	remote ?= port(port_num)
	with stream ?= connect_loopback(IPv4, remote):
		detach read_chunk(stream, 1)
		Ok(0)
