-- EXPECT: error: select receive arm requires Channel[T], got Result[Bytes, net/tcp.TcpError]
-- RUN-BLORP-CHECK
import:
	net/tcp as Tcp: IpFamily(IPv4), TcpError


func bad() -> Result[Int, TcpError]:
	remote ?= Tcp.port(1)
	with stream ?= Tcp.connect_loopback(IPv4, remote):
		select:
			chunk from Tcp.read_chunk(stream, 16):
				_ = chunk
		Ok(0)
