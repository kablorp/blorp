-- EXPECT: error: Tuple destructuring would shadow the mutable variable `total` from an enclosing scope
-- EXPECT: help: To update `total`, destructure into a new name and assign it: `(next_total, _) = ...` then `total = next_total`. To keep both, rename the destructured name
-- RUN-BLORP-CHECK
-- Test: Destructuring inside a loop must not silently hide the outer accumulator
func step(total: Int, x: Int) -> (Int, Int):
	(total + x, x)

func main(args: List[String]) -> Int:
	var total: Int = 0

	for x in [1, 2, 3]:
		(total, _) = step(total, x)

	total
