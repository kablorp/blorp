-- EXPECT: error: Pure function 'pure_middle' cannot call impure function 'impure_leaf'
-- Pure function calling pure function calling impure function (3 levels deep).
-- The error should fire at the middle level where purity is violated.
func impure_leaf() -> Int:
	print("side effect")
	42


pure func pure_middle() -> Int:
	impure_leaf()


pure func pure_top() -> Int:
	pure_middle()


func main(args: List[String]) -> Int:
	pure_top()
