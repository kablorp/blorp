-- EXPECT: error: Pure function 'process' cannot call impure function 'impure_double'
-- Test pure function calling impure via method syntax
-- This should fail: method syntax call to impure function from pure
func impure_double(x: Int) -> Int:
	print("doubling")
	x * 2


pure func process(x: Int) -> Int:
	x.impure_double()


func main(args: List[String]) -> Int:
	var result: Int = process(5)
	print(to_string(result))
	0
