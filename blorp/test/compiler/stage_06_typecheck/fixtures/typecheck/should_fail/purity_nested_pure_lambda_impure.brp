-- EXPECT: error: Pure function '<lambda>' cannot call impure function 'print'
-- RUN-BLORP-CHECK
-- Test: Pure lambda inside impure function calls impure builtin.
-- The check_nested_pure_lambdas correctly finds this.
func outer(x: Int) -> Int:
	f = pure func(y: Int) -> Int:
		print(to_string(y))
		y
	f(x)
