-- EXPECT: error: field assignment is not supported
-- EXPECT: help: use record update syntax: { record | field = value }
-- RUN-BLORP-CHECK
-- Test: Field assignment on struct should error, not silently discard
struct Vec2 {x: Float, y: Float}

func main(args: List[String]) -> Int:
    var p: Vec2 = {x = 1.0, y = 2.0}
    p.x = 99.0
    0
