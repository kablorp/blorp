-- EXPECT: error: top-level initializer 'value' cannot assign through a subscript
-- A subscript assignment rooted at a field is not lowered to a checked_set call,
-- so the startup-work check rejects the assignment itself.
record Box {
	items: Int[#2]
}


var value: Int = if True:
	var box: Box = { items = {1, 2} }
	box.items[0] = 5
	7
else:
	8


func main(args: List[String]) -> Int:
	0
