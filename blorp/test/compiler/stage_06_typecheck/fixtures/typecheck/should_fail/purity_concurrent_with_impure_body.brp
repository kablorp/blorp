-- EXPECT: error: Pure function 'bad' cannot call impure function 'print'
-- Test: concurrent block with impure body in pure function.
-- The impure call inside concurrent IS caught, but the concurrent block
-- itself is not flagged as impure (see purity_concurrent_block_in_pure.brp).
pure func bad(x: Int) -> Int:
	concurrent:
		a = print("side effect in thread")
	0
