-- EXPECT: error: @tail_recursive function 'bad_loop' has recursive call not in tail position. The recursive call's result must be returned directly, not used in further computation.
-- ERROR: @tail_recursive with recursive call inside a for loop body
-- Loop body is not tail position
@tail_recursive
func bad_loop(n: Int) -> Int:
	if n <= 0:
		0
	else:
		for i in [1, 2, 3]:
			bad_loop(i)
		0
