-- EXPECT: error: conflicting implementation of trait 'Equatable (from traits)' for type 'Int'
-- standard_library/src/int.brp already provides [implements Equatable for Int]. The
-- [abs] import forces the stdlib int module to load, so its impls are
-- visible at type-check time. A user impl on top of stdlib's must be
-- rejected — otherwise the C compiler surfaces the overlap as a symbol
-- redefinition (not a blorp error), which violates Development Rule 4.
import:
	int: abs


implements Equatable for Int:
	pure func equals(a: Int, b: Int) -> Bool:
		False

	pure func not_equals(a: Int, b: Int) -> Bool:
		True


func main(args: List[String]) -> Int:
	abs(0)
