-- EXPECT: error: resource-producing select arms are not implemented yet
-- EXPECT: note: `blorp_tls_connect_raw` parks the current fiber and returns resource scoped to its parent.
import:
	net/tcp as Tcp: IpFamily(IPv4), TcpError
	net/tls as Tls


func bad() -> Result[Int, TcpError]:
	remote ?= Tcp.port(1)
	with stream ?= Tcp.connect_loopback(IPv4, remote):
		select:
			session from Tls.connect(stream, "localhost"):
				_ = session
		Ok(0)
