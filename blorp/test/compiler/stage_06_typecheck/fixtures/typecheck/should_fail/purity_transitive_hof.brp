-- EXPECT: error: Argument type mismatch: in call to 'apply_twice', argument 2 expected pure (Int) -> Int, got (Int) -> Int at blorp/test/compiler/stage_06_typecheck/fixtures/typecheck/should_fail/purity_transitive_hof.brp:18:20
-- RUN-BLORP-CHECK
-- Pure function passing impure callback through a pure HOF chain.
pure func apply(x: Int, f: pure (Int) -> Int) -> Int:
	f(x)


pure func apply_twice(x: Int, f: pure (Int) -> Int) -> Int:
	apply(apply(x, f), f)


func impure_fn(x: Int) -> Int:
	print(to_string(x))
	x


pure func bad() -> Int:
	apply_twice(5, impure_fn)


func main(args: List[String]) -> Int:
	bad()
