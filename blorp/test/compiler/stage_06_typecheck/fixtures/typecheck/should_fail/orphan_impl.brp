-- EXPECT: error: orphan impl: `Stringable for List[Int]` is not in the trait's module or the type's module
-- TEST: Phase 3.4 — impl of a trait for a type where neither the
-- trait nor the type is owned by this module is rejected as orphan.
-- Stringable lives in std/traits; List lives in std/list; user file
-- owns neither.
import:
	traits: Stringable


implements Stringable for List[Int]:
	pure func to_string(v: List[Int]) -> String:
		"list"


func main(args: List[String]):
	void
