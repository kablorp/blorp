-- EXPECT: error: Record field 'first': expected A, got #42
-- A generic record factory function that returns concrete types instead of
-- the declared generic type should be rejected.
record Pair[A, B] {first: A, second: B}


func bad_pair[A, B](a: A, b: B) -> Pair[A, B]:
	{first = 42, second = "always string"}


func main(args: List[String]) -> Int:
	0
