-- EXPECT: error: Undefined identifier: tensor6_checked_get
-- Phase 2.3: subscripts with arity > 5 synthesize an undefined
-- builtin name so typecheck surfaces a clean error (rather than
-- a misleading arg-count mismatch from a fall-through).
func bad_subscript(t: Int[#2, #2, #2, #2, #2, #2]) -> Int:
	t[0, 0, 0, 0, 0, 0]
