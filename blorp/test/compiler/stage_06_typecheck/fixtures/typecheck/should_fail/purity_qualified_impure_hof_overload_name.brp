-- EXPECT: error: Pure function 'sneaky' cannot call impure function 'map'
-- A pure overload registered under the same function name must not mask the
-- selected qualified callee's impure effect.
import:
	../helpers/impure_hof_mod as H
	list as L


pure func sneaky() -> Int:
	H.map(pure func(x: Int) -> Int: x + 1)


func main(args: List[String]) -> Int:
	sneaky()
