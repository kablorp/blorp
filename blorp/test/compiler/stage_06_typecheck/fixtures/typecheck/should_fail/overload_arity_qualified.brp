-- EXPECT: error: Function 'map (from list)' expects 2 arguments, got 3
-- EXPECT: error: Function 'map (from list)' expects 2 arguments, got 3
-- An overloaded function name — [map] is registered by multiple stdlib
-- modules (list, dict, set, etc.) — should render with its
-- home module in arity-mismatch errors so the user knows which overload
-- the resolver picked. Track B: qualified diagnostics.
import:
	list: map


pure func double(x: Int) -> Int:
	x * 2


func main(args: List[String]) -> Int:
	xs: List[Int] = [1, 2, 3]
	_ = map(xs, double, 99)
	0
