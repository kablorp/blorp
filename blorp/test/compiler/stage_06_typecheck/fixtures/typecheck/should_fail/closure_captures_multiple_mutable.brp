-- EXPECT: error: Closure cannot capture mutable variables: x, y. Use explicit state threading instead.
-- RUN-BLORP-CHECK
-- ERROR: Lambda captures multiple mutable variables
-- Tests that error message handles multiple captured vars
func apply(f: () -> Int) -> Int:
	f()


func bad() -> Int:
	var x: Int = 1
	var y: Int = 2
	apply(func(): x + y)
