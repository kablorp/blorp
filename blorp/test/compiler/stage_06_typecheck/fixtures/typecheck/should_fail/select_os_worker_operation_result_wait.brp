-- EXPECT: error: OS-worker-blocking select arms are not supported
-- EXPECT: note: `blorp_dns_resolve_raw` blocks an OS worker (platform resolver) and returns ordinary data.
import:
	net/dns as DNS: DnsError


func bad() -> Result[Int, DnsError]:
	select:
		addrs from DNS.resolve("localhost"):
			_ = addrs
	Ok(0)
