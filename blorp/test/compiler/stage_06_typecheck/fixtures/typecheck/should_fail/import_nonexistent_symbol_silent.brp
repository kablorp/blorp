-- EXPECT: error: 'totally_fake_function' is not exported by module 'list'
-- BUG: Importing a completely non-existent symbol from a module silently succeeds.
-- 'totally_fake_function' is not in std/list's exports or private names, yet the
-- import produces no error. While some names (like 'List') are silently skipped
-- because they're builtins, clearly non-existent names should be flagged.
import:
	list: totally_fake_function


func main(args: List[String]) -> Int:
	0
