-- EXPECT: error: Equality requires an implementation of Equatable for Option[Point]
-- Option equality compares payloads with the payload type's own ==, so an
-- Option of a record without an Equatable implementation must be rejected
-- at typecheck rather than failing later in Core.
record Point {x: Int, y: Int}


func main(args: List[String]) -> Int:
	left: Option[Point] = Some({x = 1, y = 2})
	right: Option[Point] = Some({x = 1, y = 2})

	if left == right:
		1
	else:
		0
