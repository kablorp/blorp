-- EXPECT: error: Pure function 'bad_pure' cannot call impure function 'print'
-- Test pure function directly calling print
-- This should fail: print is impure
pure func bad_pure(x: Int) -> Int:
	print("hello")
	x + 1


func main(args: List[String]) -> Void:
	result = bad_pure(5)
	print(to_string(result))
