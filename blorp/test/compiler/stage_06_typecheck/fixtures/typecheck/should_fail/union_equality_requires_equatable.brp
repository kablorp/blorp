-- EXPECT: error: Equality requires an implementation of Equatable for Shape
-- A union with payloads has no compiler-provided equality: comparing its
-- payloads is the implementer's decision, so `==` needs an explicit impl.
union Shape:
	Circle(Int)
	Named(String)


func main(args: List[String]) -> Int:
	if Named("a") == Named("a"):
		1
	else:
		0
