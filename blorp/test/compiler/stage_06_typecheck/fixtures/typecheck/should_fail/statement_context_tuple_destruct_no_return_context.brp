-- EXPECT: error: Cannot infer type of empty list. Add an explicit type annotation, e.g. xs: List[Int] = []
func tuple_destruct_context[T](flag: Bool) -> (List[T], List[T]):
	if flag:
		(a, b) = ([], [])
	else:
		([], [])


func main(args: List[String]) -> Int:
	result: (List[Int], List[Int]) = tuple_destruct_context(True)
	result[0].length()
