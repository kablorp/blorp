-- EXPECT: error: one-shot stream values cannot be stored in List literals (found FallibleStream[Int, String])
-- KNOWN BUG, pinned so a fix is visible: `FallibleStream` here is this
-- module's own ordinary record, not the stdlib stream type, so this program
-- should type check. `FallibleStream` is on the ABI list, so the stdlib type
-- is bare everywhere and no spelling separates the two. Move this file to
-- `should_pass` when type references carry the declaring type's identity
-- (docs/NAME_MANGLING_REMOVAL_ROADMAP.md, M5.3 slices Q3 and Q4: the
-- nominal-identity field and the readers that use it).
record FallibleStream[T, E] {
	items: List[T],
	error_label: E
}


func main(args: List[String]) -> Int:
	stream: FallibleStream[Int, String] = { items = [4], error_label = "err" }
	items: List[FallibleStream[Int, String]] = [stream]
	items.length()
