-- EXPECT: error: Integer literal 200 does not fit in Int8
-- EXPECT: help: Int8 holds -128 to 127; use a value in that range or a wider type such as Int16
-- RUN-BLORP-CHECK
-- An argument literal is checked against the parameter type.
pure func takes_small(value: Int8) -> Int8:
	value


func main(args: List[String]) -> Int:
	takes_small(200)
	0
