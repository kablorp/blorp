-- EXPECT: error: Function 'first_of' returns wrong type
-- BUG: Generic function body returns String literal but declared return is T
-- T is treated as wildcard during body checking so String matches T
-- At the call site, T=Int from argument, but body always returns String
func first_of[T](xs: List[T]) -> T:
	"always a string"


func main(args: List[String]) -> Int:
	result: Int = first_of([1, 2, 3])
	result
