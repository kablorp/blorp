-- EXPECT-BLORP: error: Type Int does not implement trait Shape (required by describe)
-- RUN-BLORP-CHECK
-- The qualified bound is the helper's `Shape` trait itself, so a type that
-- does not implement it is rejected at the call.
import:
	../helpers/qualified_bound_shapes as shapes


pure func describe[T: shapes.Shape](item: T) -> Int:
	0


func main(args: List[String]) -> Int:
	describe(1)
