-- EXPECT: error: scoped resource value cannot be passed to ordinary call 'map_err'
import:
	net/tcp as TCP: IpFamily(IPv4), TcpError
	net/tls as TLS: TlsError
	result: map_err


func bad(port: Int) -> Result[Int, TlsError]:
	match TCP.port(port):
		Err(err): Err(TLS.Transport(TCP.message(err)))
		Ok(remote):
			with stream ?= map_err(
				TCP.connect_loopback(
					IPv4,
					remote,
				),
				func(err: TcpError): TLS.Transport(TCP.message(err)),
			):
				Ok(1)
