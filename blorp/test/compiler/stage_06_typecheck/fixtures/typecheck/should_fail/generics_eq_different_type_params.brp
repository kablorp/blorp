-- EXPECT: error: Cannot compare type parameters T and U — equality requires the same type
-- BUG: T == U should be rejected when T and U are different type parameters
-- types_bidirectional with both params as wildcards allows unifying T with U
func eq_different[T, U](x: T, y: U) -> Bool:
	x == y


func main(args: List[String]) -> Int:
	match eq_different(42, "hello"):
		True: 1
		False: 0
