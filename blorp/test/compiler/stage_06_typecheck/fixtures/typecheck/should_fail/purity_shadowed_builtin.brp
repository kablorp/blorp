-- EXPECT: error: Pure function 'bad' cannot call impure function 'length'
-- RUN-BLORP-CHECK
-- Test: User-defined impure function shadows pure builtin 'length'.
-- The checker correctly uses the user-defined version's purity.
func length(x: Int) -> Int:
	print("side effect!")
	x


pure func bad(x: Int) -> Int:
	length(x)
