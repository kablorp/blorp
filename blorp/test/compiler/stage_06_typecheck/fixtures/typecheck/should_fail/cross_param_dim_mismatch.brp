-- EXPECT: error: Argument type mismatch: in call to 'safe_get', argument 2 ('i') expected ..#3, got ..#5
-- Test: Passing a ..#5 index to a function expecting ..#3 should fail.
pure func safe_get[T, #N](arr: T[#N], i: ..#N) -> T:
	arr[i]


func main(args: List[String]) -> Int:
	small: Int[#3] = {10, 20, 30}
	big: Int[#5] = {1, 2, 3, 4, 5}
	-- i is proven ..#5 from the for-loop, but small only has 3 elements
	for i in 0..5:
		safe_get(small, i)
	0
