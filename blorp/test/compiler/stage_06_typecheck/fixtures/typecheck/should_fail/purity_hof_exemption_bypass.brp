-- EXPECT: error: Pure function 'trampoline' has impure callback parameter 'f'. Use 'pure (Int) -> Int' for the parameter type
-- A pure function cannot call an impure HOF just because the callback argument
-- is pure. The pure lambda also calls trampoline with an impure callback, so
-- either path must be rejected before side effects can execute in a pure
-- context.
--
pure func trampoline(x: Int, f: (Int) -> Int) -> Int:
	f(x)


func side_effect(x: Int) -> Int:
	print(to_string(x))
	x


func impure_hof(x: Int, f: (Int) -> Int) -> Int:
	f(x)


pure func sneaky(x: Int) -> Int:
	impure_hof(x, pure func(y: Int) -> Int: trampoline(y, side_effect))
