import:
	option: Option(Some, None)


-- EXPECT: error: Non-exhaustive match on type 'Option'
-- ERROR: Non-exhaustive match nested inside if branch
-- Tests that check_matches_in_expr recurses into nested expressions
func check(flag: Bool, opt: Option[Int]) -> Int:
	if flag:
		match opt:
			Some(x): x
	else:
		0
