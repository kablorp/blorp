-- EXPECT: error: top-level initializer 'value' cannot call function 'checked_set'
-- A subscript assignment to a plain local name lowers to a checked_set call
-- during inference, so the startup-work check reports that call.
var value: Int = if True:
	var xs = {1, 2}
	xs[0] = 5
	7
else:
	8


func main(args: List[String]) -> Int:
	0
