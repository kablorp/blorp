-- EXPECT: error: @tail_recursive function 'bad_sum' has recursive call not in tail position. The recursive call's result must be returned directly, not used in further computation.
-- ERROR: @tail_recursive with recursive call in variable init (not tail position)
-- Tests collect_recursive_calls EVarDecl path
@tail_recursive
func bad_sum(n: Int) -> Int:
	if n <= 0:
		0
	else:
		var partial: Int = bad_sum(n - 1)
		partial + n
