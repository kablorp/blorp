-- EXPECT: error: conflicting implementation of trait 'Show' for type 'Box'
-- RUN-BLORP-CHECK
-- A generic impl and a specific impl of the same trait overlap: Box[T] already
-- covers Box[Int]. The generic-first order is impl_overlap_generic_and_specific.
trait Show:
	pure func show(self: Self) -> String


record Box[T] {
	value: T
}


implements Show for Box[Int]:
	pure func show(self: Box[Int]) -> String:
		"specific"


implements Show for Box[T]:
	pure func show(self: Box[T]) -> String:
		"generic"


func main(args: List[String]) -> Int:
	0
