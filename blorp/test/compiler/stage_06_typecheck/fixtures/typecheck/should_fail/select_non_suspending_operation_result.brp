-- EXPECT: error: select sealed arm requires a waitable operation
-- EXPECT: note: `blorp_tcp_local_port_listener_raw` is an operation-result builtin, but it does not suspend.
import:
	net/tcp as Tcp: IpFamily(IPv4), TcpError


func bad() -> Result[Int, TcpError]:
	with listener ?= Tcp.listen_loopback_any_port(IPv4, 1):
		select:
			sealed Tcp.local_port(listener):
				void
		Ok(0)
