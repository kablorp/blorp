-- EXPECT: error: Type ../helpers/priv_impl_mod.Gadget does not implement trait Stringable (from std/traits) (required by show)
-- Regression: private implements blocks must not satisfy public trait bounds in
-- importing modules. If this compiles, private impl relationships leaked
-- through trait dispatch.
import:
	../helpers/priv_impl_mod: Gadget
	traits: Stringable


func show[T:Stringable](x: T) -> String:
	to_string(x)


func main(args: List[String]) -> Int:
	g: Gadget = {name = "widget"}
	s: String = show(g)
	0
