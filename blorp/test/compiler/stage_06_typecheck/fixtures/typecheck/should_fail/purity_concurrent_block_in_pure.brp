-- EXPECT: error: Pure function 'bad' cannot call impure function 'concurrent'
-- EXPECT: error: Pure function 'bad' cannot call impure function 'concurrent'
-- concurrent: block is inherently impure (spawns threads, non-deterministic)
-- The purity checker correctly rejects this.
pure func bad(x: Int) -> Int:
	concurrent:
		a = x + 1
		b = x + 2
	0
