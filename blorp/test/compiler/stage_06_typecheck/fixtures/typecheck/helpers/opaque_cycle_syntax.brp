-- The syntax half of an import cycle: it declares records, a union, an alias,
-- a global and an implementation over the opaque `NameId` that
-- `opaque_cycle_ids` owns, and that module imports them back.
import:
	./opaque_cycle_ids: NameId, name_number


record Name {
	id: NameId,
	text: String
}


union Binding:
	Bound(NameId)
	Unbound


type alias NameIds = List[NameId]

NO_NAME_IDS: NameIds = []


trait Numbered:
	pure func number(self: Self) -> Int


implements Numbered for NameId:
	pure func number(self: NameId) -> Int:
		name_number(self)


pure func name_id(name: Name) -> NameId:
	name.id


pure func with_id(name: Name, id: NameId) -> Name:
	{ name | id = id }
