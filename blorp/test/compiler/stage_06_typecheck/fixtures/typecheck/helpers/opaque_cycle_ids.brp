-- The id half of an import cycle: it owns `NameId` and builds the syntax
-- records, unions and implementations that `opaque_cycle_syntax` declares
-- over `NameId`. Everything that module exposes must reach this one as the
-- same `NameId` this module writes.
import:
	./opaque_cycle_syntax:
		Binding(Bound, Unbound),
		NO_NAME_IDS,
		Name,
		NameIds,
		Numbered,
		name_id,
		number,
		with_id,


opaque type NameId = Int


pure func name_number(id: NameId) -> Int:
	from_opaque NameId(id)


pure func make_name(number: Int, text: String) -> Name:
	id: NameId = into_opaque NameId(number)
	{
		id = id,
		text = text
	}


pure func renumber(name: Name, number: Int) -> Name:
	with_id(name, into_opaque NameId(number))


pure func bind(name: Name) -> Binding:
	Bound(name.id)


pure func bound_number(binding: Binding) -> Int:
	match binding:
		Bound(id):
			id.number()
		Unbound:
			0


pure func collected_ids(names: List[Name]) -> NameIds:
	var ids: NameIds = NO_NAME_IDS

	for name in names:
		id: NameId = name_id(name)
		ids = ids.append(id)

	ids
