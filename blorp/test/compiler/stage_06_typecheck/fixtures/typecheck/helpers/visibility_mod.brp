-- Helper module for visibility tests.
-- Contains public and private declarations of various kinds.
private func secret_helper(x: Int) -> Int:
	x + 42


func public_func(x: Int) -> Int:
	secret_helper(x)


private record SecretRecord {value: Int}


record PublicRecord {name: String}


private pure func private_pure(x: Int) -> Int:
	x * 2


private top_secret: Int = 42

public_value: Int = 99
