-- Trait identities for hand-built environments in tests.
--
-- A test that installs `trait_def(...)` and `impl_instance(...)` by name needs
-- the `TraitId` production takes from the registry or the header graph. A
-- builtin name gets its registry id; any other name gets a graph id derived from
-- the name alone, so the trait and every impl of it built in one test agree.
import:
	../../../../src/compiler/stage_06_typecheck/headers/declaration_skeleton: builtin_trait_id
	../../../../src/compiler/stage_06_typecheck/type_system/trait_identity: TRAIT_ID_STRINGABLE, TraitId, graph_trait_id


private FIXTURE_TRAIT_ID_BASE: Int = 1000000

private FIXTURE_TRAIT_ID_SPAN: Int = 1099511627776

private FIXTURE_TRAIT_ID_MULTIPLIER: Int = 131


private pure func fixture_name_hash(name: String) -> Int:
	var hash: Int = 7

	for ch in name:
		hash = (hash * FIXTURE_TRAIT_ID_MULTIPLIER + ch.to_int()) % FIXTURE_TRAIT_ID_SPAN

	hash


---
The `TraitId` a fixture gives the trait spelled `name`.
---
pure func test_trait_id(name: String) -> TraitId:
	match builtin_trait_id(name):
		Some(id):
			id
		None:
			-- The id is at least FIXTURE_TRAIT_ID_BASE, so `graph_trait_id` accepts it.
			graph_trait_id(FIXTURE_TRAIT_ID_BASE + fixture_name_hash(name)).get_or(TRAIT_ID_STRINGABLE)
