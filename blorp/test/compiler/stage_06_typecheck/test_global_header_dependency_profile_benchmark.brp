import:
	../../../benchmark/compiler/compiler_global_header_dependency_profile_fixture:
		CompilerGlobalHeaderDependencyProfileConfig,
		compiler_global_header_dependency_effective_unique_references,
		compiler_global_header_dependency_profile_execute,
		compiler_global_header_dependency_profile_fixture,
		compiler_global_header_dependency_profile_observe,
	test: TestSuite


private func test_profile_fixture_models_repeated_reference_work() -> Bool:
	config: CompilerGlobalHeaderDependencyProfileConfig = {
		initializer_count = 2,
		references_per_initializer = 18,
		duplicate_percent = 50,
		module_count = 2,
		fan_in = 9
	}

	match compiler_global_header_dependency_profile_fixture(config):
		None:
			False
		Some(fixture):
			observation = compiler_global_header_dependency_profile_observe(
				fixture,
				compiler_global_header_dependency_profile_execute(fixture, 1),
			)

			(
				fixture.effective_unique_references == 9
				and fixture.reference_visits == 36
				and fixture.modeled_list_comparisons == 162
				and fixture.modeled_dictionary_probes == 36
				and fixture.expected_dependency_edges == 18
				and observation.pending_initializers == 2
				and observation.annotated_dependencies == 18
				and observation.dependency_edges == 18
				and observation.plan_ready
				and observation.workload_valid
			)


private func test_profile_fixture_clamps_unique_references_to_fan_in() -> Bool:
	config: CompilerGlobalHeaderDependencyProfileConfig = {
		initializer_count = 1,
		references_per_initializer = 8,
		duplicate_percent = 0,
		module_count = 4,
		fan_in = 3
	}

	compiler_global_header_dependency_effective_unique_references(config) == 3


tests: TestSuite = {
	description = "Compiler global header dependency profile benchmark",
	tests = [
		("models repeated reference work", test_profile_fixture_models_repeated_reference_work),
		(
			"clamps unique references to fan-in",
			test_profile_fixture_clamps_unique_references_to_fan_in,
		),
	]
}
