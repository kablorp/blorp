import:
	../../../src/compiler/stage_04_modules/module_table: ModuleId
	../../../src/compiler/stage_06_typecheck/graph/indexed_graph: PreparedModuleScope
	../../../src/compiler/stage_06_typecheck/graph/type_identity: TypeId, type_ids_equal
	../../../src/compiler/stage_06_typecheck/type_system/accepted_record_authority:
		AcceptedRecordExactLookup(
			AcceptedRecordExactFound,
			AcceptedRecordExactMissing,
			AcceptedRecordExactWrongKind,
		),
		AcceptedRecordTableInput,
		AcceptedRecordTableRecord,
		AcceptedVisibleRecordBinding,
		accepted_record_authority,
		accepted_record_authority_without_visible_names,
		accepted_record_contains,
		accepted_record_contains_resource,
		accepted_record_exact,
		accepted_record_find,
		accepted_record_find_names_with_fields,
		accepted_record_is_value,
		accepted_record_may_contain_function,
		accepted_record_may_contain_one_shot_stream,
		accepted_record_may_contain_resource_source,
		accepted_record_module_view,
		accepted_record_module_view_binding_count,
		accepted_record_resource_scan_is_proven_unnecessary,
		accepted_record_table,
		accepted_record_table_entry_count,
	../../../src/compiler/stage_06_typecheck/type_system/env: FieldDecl
	../../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticType(SemanticNamedType),
		TYPE_INT,
		TYPE_STRING,
		canonical_module_type_name,
		types_equal,
	../typecheck_test_support:
		DefinitionBackedTypeFixtureModule,
		definition_backed_type_fixture,
		definition_backed_type_fixture_definition_table,
		definition_backed_type_fixture_type_id,
		module_id_fixture_find,
	test: TestSuite


private FIXTURE_MODULES: List[DefinitionBackedTypeFixtureModule] = [
	{module_path = "app/main", type_names = ["Point", "Capabilities", "Plain"]},
	{module_path = "pkg/left", type_names = ["Node", "AliasOnly"]},
	{module_path = "pkg/right", type_names = ["Node"]},
	{module_path = "pkg/unrelated", type_names = ["Other"]},
	{module_path = "pkg/pair", type_names = ["Pair"]},
]


private pure func fixture_type_id(
	fixture: PreparedModuleScope,
	module_path: String,
	name: String,
) -> Option[TypeId]:
	definition_backed_type_fixture_type_id(fixture, module_path, name)


private pure func field(name: String, typ: SemanticType) -> FieldDecl:
	{
		name = name,
		field_type = typ,
		definition_id = None
	}


private pure func fixture_record(
	fixture: PreparedModuleScope,
	module_path: String,
	name: String,
	canonical_visible: Bool,
	fields: List[FieldDecl],
) -> Option[AcceptedRecordTableRecord]:
	id ?= fixture_type_id(fixture, module_path, name)
	Some({
		id = id,
		canonical_name = canonical_module_type_name(module_path, name),
		canonical_visible = canonical_visible,
		payload = {
			type_params = [],
			fields = fields,
			is_value = False,
			contains_resource = False,
			may_contain_function = False,
			may_contain_one_shot_stream = False,
			may_contain_resource_source = False
		}
	})


private pure func table_input(
	fixture: PreparedModuleScope,
	include_unrelated: Bool,
) -> Option[AcceptedRecordTableInput]:
	left ?= fixture_record(fixture, "pkg/left", "Node", True, [field(
				"next",
				SemanticNamedType(
					canonical_module_type_name("pkg/left", "Node"),
					[],
				),
			)])
	right ?= fixture_record(fixture, "pkg/right", "Node", False, [field("text", TYPE_STRING)])
	alias_id ?= fixture_type_id(fixture, "pkg/left", "AliasOnly")
	known_type_ids = [left.id, right.id, alias_id]
	-- Keep the owner-local record away from index zero so module-view bindings
	-- are proven to address the table rather than accidentally assuming zero.
	records = [right, left]

	if include_unrelated:
		fixture_record(
				fixture,
				"pkg/unrelated",
				"Other",
				True,
				[field("value", TYPE_INT)],
			).map(
			func(unrelated): {
				definition_table = definition_backed_type_fixture_definition_table(fixture),
				known_type_ids = known_type_ids.append(unrelated.id),
				records = records.append(unrelated)
			},
		)
	else:
		Some({
			definition_table = definition_backed_type_fixture_definition_table(fixture),
			known_type_ids = known_type_ids,
			records = records,
		})


private pure func record_authority_is_category_safe_and_local_result() -> Option[Bool]:
	fixture ?= definition_backed_type_fixture(FIXTURE_MODULES)
	input ?= table_input(fixture, False)
	table ?= accepted_record_table(input)
	owner ?= module_id_fixture_find(fixture, "pkg/left")
	left_id ?= fixture_type_id(fixture, "pkg/left", "Node")
	alias_id ?= fixture_type_id(fixture, "pkg/left", "AliasOnly")
	view ?= accepted_record_module_view(
		table,
		owner,
		[
			{
				source_name = "Node",
				id = left_id,
				owner_local = True,
				infer_from_fields = True
			},
		],
	)
	authority = accepted_record_authority(table, view)
	entry ?= accepted_record_find(authority, "Node")
	canonical_entry ?= accepted_record_find(
		authority,
		canonical_module_type_name("pkg/left", "Node"),
	)
	next ?= entry.fields.get(0)
	canonical_next ?= canonical_entry.fields.get(0)
	canonical_only = accepted_record_authority_without_visible_names(authority)
	canonical_only_entry ?= accepted_record_find(
		canonical_only,
		canonical_module_type_name("pkg/left", "Node"),
	)
	canonical_only_next ?= canonical_only_entry.fields.get(0)

	alias_is_wrong_kind = match accepted_record_exact(table, alias_id).lookup:
		AcceptedRecordExactWrongKind(id):
			type_ids_equal(id, alias_id)
		AcceptedRecordExactFound(_) | AcceptedRecordExactMissing:
			False

	Some(types_equal(
			next.field_type,
			SemanticNamedType("Node", []),
		) and types_equal(
			canonical_next.field_type,
			SemanticNamedType(
				canonical_module_type_name("pkg/left", "Node"),
				[],
			),
		) and accepted_record_find(canonical_only, "Node").is_none() and types_equal(
			canonical_only_next.field_type,
			SemanticNamedType(
				canonical_module_type_name("pkg/left", "Node"),
				[],
			),
		) and accepted_record_table_entry_count(
			table,
		) == 2 and accepted_record_module_view_binding_count(view) == 1 and alias_is_wrong_kind)


private pure func record_authority_is_category_safe_and_local() -> Bool:
	record_authority_is_category_safe_and_local_result().get_or(False)


private pure func table_rejects_forged_canonical_name_result() -> Option[Bool]:
	fixture ?= definition_backed_type_fixture(FIXTURE_MODULES)
	input ?= table_input(fixture, False)
	record_entry ?= input.records.get(0)
	forged = { record_entry | canonical_name = "Option" }
	Some(accepted_record_table({ input |
		records = input.records.set(0, forged)
	}).is_none())


private pure func table_rejects_forged_canonical_name() -> Bool:
	table_rejects_forged_canonical_name_result().get_or(False)


private pure func module_view_rejects_private_import_result() -> Option[Bool]:
	fixture ?= definition_backed_type_fixture(FIXTURE_MODULES)
	input ?= table_input(fixture, False)
	table ?= accepted_record_table(input)
	left_owner ?= module_id_fixture_find(fixture, "pkg/left")
	main_owner ?= module_id_fixture_find(fixture, "app/main")
	left_id ?= fixture_type_id(fixture, "pkg/left", "Node")
	private_id ?= fixture_type_id(fixture, "pkg/right", "Node")

	Some(accepted_record_module_view(
			table,
			left_owner,
			[
				{
					source_name = "MisclassifiedLocal",
					id = left_id,
					owner_local = False,
					infer_from_fields = False
				},
			],
		).is_none() and accepted_record_module_view(
			table,
			main_owner,
			[
				{
					source_name = "PrivateNode",
					id = private_id,
					owner_local = False,
					infer_from_fields = True
				},
			],
		).is_none())


private pure func module_view_rejects_private_import() -> Bool:
	module_view_rejects_private_import_result().get_or(False)


private pure func exact_record_queries_ignore_unrelated_modules_result() -> Option[Bool]:
	fixture ?= definition_backed_type_fixture(FIXTURE_MODULES)
	base_input ?= table_input(fixture, False)
	expanded_input ?= table_input(fixture, True)
	base ?= accepted_record_table(base_input)
	expanded ?= accepted_record_table(expanded_input)
	left_owner ?= module_id_fixture_find(fixture, "pkg/left")
	id ?= fixture_type_id(fixture, "pkg/left", "Node")
	base_probe = accepted_record_exact(base, id)
	expanded_probe = accepted_record_exact(expanded, id)

	Some(
		(
			base_probe.candidates_visited == 1
			and expanded_probe.candidates_visited == 1
			and match (base_probe.lookup, expanded_probe.lookup):
				(AcceptedRecordExactFound(left), AcceptedRecordExactFound(right)):
					left.fields.length() == right.fields.length()
				_:
					False
		),
	)


private pure func exact_record_queries_ignore_unrelated_modules() -> Bool:
	exact_record_queries_ignore_unrelated_modules_result().get_or(False)


private pure func visible_field_shape_lookup_preserves_binding_order_result() -> Option[Bool]:
	fixture ?= definition_backed_type_fixture(FIXTURE_MODULES)
	owner ?= module_id_fixture_find(fixture, "app/main")
	pair_owner ?= module_id_fixture_find(fixture, "pkg/pair")
	point ?= fixture_record(
		fixture,
		"app/main",
		"Point",
		True,
		[field("x", TYPE_INT), field("y", TYPE_INT)],
	)
	pair ?= fixture_record(
		fixture,
		"pkg/pair",
		"Pair",
		True,
		[field("y", TYPE_STRING), field("x", TYPE_STRING)],
	)
	input: AcceptedRecordTableInput = {
		definition_table = definition_backed_type_fixture_definition_table(fixture),
		known_type_ids = [point.id, pair.id],
		records = [point, pair]
	}
	table ?= accepted_record_table(input)
	view ?= accepted_record_module_view(
		table,
		owner,
		[
			{
				source_name = "Point",
				id = point.id,
				owner_local = True,
				infer_from_fields = True
			},
			{
				source_name = "pkg__pair__Pair",
				id = pair.id,
				owner_local = False,
				infer_from_fields = True
			},
		],
	)
	authority = accepted_record_authority(table, view)

	Some(accepted_record_find_names_with_fields(
			authority,
			["y", "x"],
		) == ["Point", "pkg__pair__Pair"])


private pure func visible_field_shape_lookup_preserves_binding_order() -> Bool:
	visible_field_shape_lookup_preserves_binding_order_result().get_or(False)


private pure func scalar_queries_read_canonical_payload_result() -> Option[Bool]:
	fixture ?= definition_backed_type_fixture(FIXTURE_MODULES)
	owner ?= module_id_fixture_find(fixture, "app/main")
	base ?= fixture_record(fixture, "app/main", "Capabilities", True, [field("value", TYPE_INT)])
	capable_record = { base | payload = { base.payload |
			is_value = True,
			contains_resource = True,
			may_contain_function = True,
			may_contain_one_shot_stream = True,
			may_contain_resource_source = True
		} }
	plain_record ?= fixture_record(fixture, "app/main", "Plain", True, [field("value", TYPE_INT)])
	table ?= accepted_record_table({
		definition_table = definition_backed_type_fixture_definition_table(fixture),
		known_type_ids = [capable_record.id, plain_record.id],
		records = [capable_record, plain_record],
	})
	view ?= accepted_record_module_view(
		table,
		owner,
		[
			{
				source_name = "Capabilities",
				id = capable_record.id,
				owner_local = True,
				infer_from_fields = False
			},
			{
				source_name = "Plain",
				id = plain_record.id,
				owner_local = True,
				infer_from_fields = False
			},
		],
	)
	authority = accepted_record_authority(table, view)

	Some(
		(
			accepted_record_contains(authority, "Capabilities")
			and accepted_record_is_value(authority, "Capabilities").get_or(False)
			and accepted_record_contains_resource(authority, "Capabilities").get_or(False)
			and accepted_record_may_contain_function(authority, "Capabilities").get_or(False)
			and accepted_record_may_contain_one_shot_stream(authority, "Capabilities").get_or(False)
			and accepted_record_may_contain_resource_source(authority, "Capabilities").get_or(False)
			and not accepted_record_resource_scan_is_proven_unnecessary(
				authority,
				"Capabilities",
			).get_or(True)
			and accepted_record_resource_scan_is_proven_unnecessary(
				authority,
				"Plain",
			).get_or(False)
			and not accepted_record_contains(authority, "Missing")
			and accepted_record_is_value(authority, "Missing").is_none()
			and accepted_record_contains_resource(authority, "Missing").is_none()
			and accepted_record_may_contain_function(authority, "Missing").is_none()
			and accepted_record_may_contain_one_shot_stream(authority, "Missing").is_none()
			and accepted_record_may_contain_resource_source(authority, "Missing").is_none()
			and accepted_record_resource_scan_is_proven_unnecessary(authority, "Missing").is_none()
		),
	)


private pure func scalar_queries_read_canonical_payload() -> Bool:
	scalar_queries_read_canonical_payload_result().get_or(False)


tests: TestSuite = {
	description = "Accepted record authority",
	tests = [
		("table rejects forged canonical name", table_rejects_forged_canonical_name),
		(
			"record authority is category safe and localizes owner payloads",
			record_authority_is_category_safe_and_local,
		),
		(
			"module view rejects misclassified and private imported records",
			module_view_rejects_private_import,
		),
		(
			"exact record queries ignore unrelated modules",
			exact_record_queries_ignore_unrelated_modules,
		),
		(
			"visible field-shape lookup preserves binding order",
			visible_field_shape_lookup_preserves_binding_order,
		),
		(
			"scalar queries read canonical payloads and preserve missing results",
			scalar_queries_read_canonical_payload,
		),
	]
}
