private CATALOG_SOURCE: String =
	|type alias Number = Int
	|
	|record Pair {left: Int, right: Int}
	|
	|union Signal:
	|	Ready
	|	Busy(Int)
	|
	|pure func choose(value: Int) -> Int: value
	|
	|answer: Int = 42
	|
	|trait Identity:
	|	pure func identity(value: Self) -> Int
	|
	|implements Identity for Pair:
	|	pure func identity(value: Pair) -> Int:
	|		value.left


private record CatalogComponentFixture {
	implementation_headers: ImplementationHeaderGraph,
	aliases: AcceptedAliasGraph,
	records: AcceptedRecordGraph,
	unions: AcceptedUnionGraph,
	callables: AcceptedCallableTable,
	globals: AcceptedGlobalTable,
	traits_and_implementations: AcceptedTraitImplementationTable
}


private func accepted_graph_for_source(
	module_path: String,
	source: String,
) -> Option[AcceptedTypecheckGraph]:
	program = parse_compiler_source(source_file(module_path + ".brp", module_path, source))
	typecheck_test_accepted_graph(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		program,
		[],
	).to_option()


private func catalog_component_fixture(
	module_path: String,
	source: String,
) -> Option[CatalogComponentFixture]:
	graph ?= accepted_graph_for_source(module_path, source)
	catalog = accepted_typecheck_graph_semantic_catalog(graph)
	Some({
		implementation_headers = accepted_typecheck_graph_implementation_headers(graph),
		aliases = accepted_semantic_catalog_alias_graph(catalog),
		records = accepted_semantic_catalog_record_graph(catalog),
		unions = accepted_semantic_catalog_union_graph(catalog),
		callables = accepted_semantic_catalog_callable_table(catalog),
		globals = accepted_semantic_catalog_global_table(catalog),
		traits_and_implementations = accepted_semantic_catalog_trait_implementation_table(catalog),
	})


private pure func catalog_input(fixture: CatalogComponentFixture) -> AcceptedSemanticCatalogInput:
	{
		implementation_headers = fixture.implementation_headers,
		aliases = fixture.aliases,
		records = fixture.records,
		unions = fixture.unions,
		callables = fixture.callables,
		globals = fixture.globals,
		traits_and_implementations = fixture.traits_and_implementations
	}


private pure func catalog_with_components(
	implementation_headers: ImplementationHeaderGraph,
	aliases: AcceptedAliasGraph,
	records: AcceptedRecordGraph,
	unions: AcceptedUnionGraph,
	callables: AcceptedCallableTable,
	globals: AcceptedGlobalTable,
	traits_and_implementations: AcceptedTraitImplementationTable,
) -> Option[AcceptedSemanticCatalog]:
	accepted_semantic_catalog({
		implementation_headers = implementation_headers,
		aliases = aliases,
		records = records,
		unions = unions,
		callables = callables,
		globals = globals,
		traits_and_implementations = traits_and_implementations,
	})


private func coherent_catalog() -> Option[AcceptedSemanticCatalog]:
	fixture ?= catalog_component_fixture("catalog/main", CATALOG_SOURCE)
	accepted_semantic_catalog(catalog_input(fixture))


private func catalog_accepts_one_coherent_domain() -> Option[Bool]:
	catalog ?= coherent_catalog()
	counts = accepted_semantic_catalog_table_counts(catalog)
	Some(
		(
			counts.type_identities == 3
			and counts.aliases == 1
			and counts.records == 1
			and counts.fields == 2
			and counts.unions == 4
			and counts.constructors == 9
			and counts.callables == 1
			and counts.completed_globals == 1
			and counts.traits == 1
			and counts.implementations == 1
			and accepted_constructor_table_entry_count(
				accepted_semantic_catalog_constructor_table(catalog),
			) == 9
			and accepted_field_table_entry_count(
				accepted_semantic_catalog_field_table(catalog),
			) == 2
		),
	)


func test_catalog_accepts_one_coherent_domain() -> Bool:
	catalog_accepts_one_coherent_domain().get_or(False)


func test_catalog_counts_have_record_identity() -> Bool:
	match coherent_catalog():
		Some(catalog):
			counts = accepted_semantic_catalog_table_counts(catalog)
			same_object(counts, counts)
		None:
			False


private func catalog_rejects_mixed_domains() -> Option[Bool]:
	owner ?= catalog_component_fixture("catalog/owner", CATALOG_SOURCE)
	other ?= catalog_component_fixture("catalog/other", CATALOG_SOURCE)

	Some(
		(
			catalog_with_components(
				other.implementation_headers,
				owner.aliases,
				owner.records,
				owner.unions,
				owner.callables,
				owner.globals,
				owner.traits_and_implementations,
			).is_none()
			and catalog_with_components(
				owner.implementation_headers,
				other.aliases,
				owner.records,
				owner.unions,
				owner.callables,
				owner.globals,
				owner.traits_and_implementations,
			).is_none()
			and catalog_with_components(
				owner.implementation_headers,
				owner.aliases,
				other.records,
				owner.unions,
				owner.callables,
				owner.globals,
				owner.traits_and_implementations,
			).is_none()
			and catalog_with_components(
				owner.implementation_headers,
				owner.aliases,
				owner.records,
				other.unions,
				owner.callables,
				owner.globals,
				owner.traits_and_implementations,
			).is_none()
			and catalog_with_components(
				owner.implementation_headers,
				owner.aliases,
				owner.records,
				owner.unions,
				other.callables,
				owner.globals,
				owner.traits_and_implementations,
			).is_none()
			and catalog_with_components(
				owner.implementation_headers,
				owner.aliases,
				owner.records,
				owner.unions,
				owner.callables,
				other.globals,
				owner.traits_and_implementations,
			).is_none()
			and catalog_with_components(
				owner.implementation_headers,
				owner.aliases,
				owner.records,
				owner.unions,
				owner.callables,
				owner.globals,
				other.traits_and_implementations,
			).is_none()
		),
	)


func test_catalog_rejects_every_mixed_domain() -> Bool:
	catalog_rejects_mixed_domains().get_or(False)


private func catalog_rejects_empty_complete_global_table() -> Option[Bool]:
	fixture ?= catalog_component_fixture("catalog/globals", "answer: Int = 42")
	definition_table = implementation_header_graph_definition_table(fixture.implementation_headers)
	empty_globals ?= accepted_global_table({
		definition_table = definition_table,
		source_name_table = accepted_global_table_source_name_table(fixture.globals),
		globals = [],
	})
	Some(
		catalog_with_components(
			fixture.implementation_headers,
			fixture.aliases,
			fixture.records,
			fixture.unions,
			fixture.callables,
			empty_globals,
			fixture.traits_and_implementations,
		).is_none(),
	)


func test_catalog_rejects_empty_complete_global_table() -> Bool:
	catalog_rejects_empty_complete_global_table().get_or(False)


private record ScopedAuthorityFixture {
	issuer: DefinitionTable,
	authority: AcceptedTraitImplementationAuthority
}


private func scoped_authority_fixture(source: String) -> Option[ScopedAuthorityFixture]:
	fixture ?= catalog_component_fixture("scope/main", source)
	table = fixture.traits_and_implementations
	Some({
		issuer = implementation_header_graph_definition_table(fixture.implementation_headers),
		authority = accepted_trait_implementation_authority(
			table,
			"scope/main",
			accepted_trait_empty_visibility(table),
			[],
		),
	})


private pure func issued_scoped_methods(
	fixture: ScopedAuthorityFixture,
	trait_id: TraitId,
) -> Option[List[(String, TraitMethodId)]]:
	match accepted_scoped_trait_methods(fixture.authority, fixture.issuer, trait_id):
		Ok(IssuedScopedMethods(methods)):
			Some(methods)
		_:
			None


private func scoped_semantic_visibility_survives_hidden_names() -> Option[Bool]:
	fixture ?= scoped_authority_fixture(CATALOG_SOURCE)
	expected ?= accepted_trait_find(fixture.authority, "Identity")
	hidden = accepted_trait_implementation_authority_without_visible_names(fixture.authority)
	methods ?= issued_scoped_methods({ fixture | authority = hidden }, expected.trait_id)
	Some(accepted_trait_find(hidden, "Identity").is_none() and methods.length() == 1)


func test_scoped_semantic_visibility_survives_hidden_names() -> Bool:
	scoped_semantic_visibility_survives_hidden_names().get_or(False)


private func scoped_authority_rejects_foreign_issuer_and_missing_members() -> Option[Bool]:
	fixture ?= scoped_authority_fixture(CATALOG_SOURCE)
	other_fixture ?= scoped_authority_fixture(CATALOG_SOURCE)
	trait_def ?= accepted_trait_find(fixture.authority, "Identity")
	methods ?= issued_scoped_methods(fixture, trait_def.trait_id)
	method ?= methods.get(0)
	empty_table ?= accepted_trait_implementation_table({
		module_table = definition_table_module_table(fixture.issuer),
		definition_table = fixture.issuer,
		traits = [],
		implementations = [],
	})
	empty_authority = accepted_trait_implementation_authority(
		empty_table,
		"scope/main",
		accepted_trait_empty_visibility(empty_table),
		[],
	)

	foreign_trait_rejected = match accepted_scoped_trait_methods(
		fixture.authority,
		other_fixture.issuer,
		trait_def.trait_id,
	):
		Err(message):
			message == "scoped trait method issuer does not match accepted authority"
		_:
			False

	foreign_method_rejected = match accepted_trait_method_binding_for_id(
		fixture.authority,
		other_fixture.issuer,
		method[1],
	):
		Err(message):
			message == "scoped trait method issuer does not match accepted authority"
		_:
			False

	missing_trait_rejected = match accepted_scoped_trait_methods(
		empty_authority,
		fixture.issuer,
		trait_def.trait_id,
	):
		Err(message):
			message == "scoped trait identity is absent from accepted authority"
		_:
			False

	missing_method_rejected = match accepted_trait_method_binding_for_id(
		empty_authority,
		fixture.issuer,
		method[1],
	):
		Err(message):
			message == "scoped trait method identity is absent from accepted authority"
		_:
			False

	Some(
		(
			foreign_trait_rejected
			and foreign_method_rejected
			and missing_trait_rejected
			and missing_method_rejected
		),
	)


func test_scoped_authority_rejects_foreign_issuer_and_missing_members() -> Bool:
	scoped_authority_rejects_foreign_issuer_and_missing_members().get_or(False)


private func concrete_method_lookup_preserves_invalid_and_absent_boundaries() -> Option[Bool]:
	fixture ?= scoped_authority_fixture(CATALOG_SOURCE)
	foreign_fixture ?= scoped_authority_fixture(CATALOG_SOURCE)
	trait_def ?= accepted_trait_find(fixture.authority, "Identity")
	env = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN).env
	receiver = SemanticNamedType("Pair", [])
	ordinary ?= accepted_find_impl_method_info_by_trait_id(
		fixture.authority,
		fixture.issuer,
		env,
		trait_def.trait_id,
		"identity",
		receiver,
	)
	expected ?= ordinary.target

	selected = match accepted_find_concrete_impl_method_by_trait_id(
		fixture.authority,
		fixture.issuer,
		env,
		trait_def.trait_id,
		"identity",
		receiver,
	):
		AcceptedConcreteMethodFound(method):
			method.target
				.map(func(target): target.callable_id == expected.callable_id)
				.get_or(False)
		_:
			False

	foreign_rejected = match accepted_find_concrete_impl_method_by_trait_id(
		fixture.authority,
		foreign_fixture.issuer,
		env,
		trait_def.trait_id,
		"identity",
		receiver,
	):
		AcceptedConcreteMethodInvalid(_):
			True
		_:
			False

	member_rejected = match accepted_find_concrete_impl_method_by_trait_id(
		fixture.authority,
		fixture.issuer,
		env,
		trait_def.trait_id,
		"missing_member",
		receiver,
	):
		AcceptedConcreteMethodInvalid(_):
			True
		_:
			False

	compiler_member_rejected = match accepted_find_concrete_impl_method_by_trait_id(
		fixture.authority,
		fixture.issuer,
		env,
		TRAIT_ID_EQUATABLE,
		"missing_member",
		TYPE_INT,
	):
		AcceptedConcreteMethodInvalid(_):
			True
		_:
			False

	no_method = match accepted_find_concrete_impl_method_by_trait_id(
		fixture.authority,
		fixture.issuer,
		env,
		trait_def.trait_id,
		"identity",
		TYPE_INT,
	):
		AcceptedConcreteMethodAbsent:
			True
		_:
			False

	Some(
		(
			selected
			and foreign_rejected
			and member_rejected
			and compiler_member_rejected
			and no_method
		),
	)


func test_concrete_method_lookup_preserves_invalid_and_absent_boundaries() -> Bool:
	concrete_method_lookup_preserves_invalid_and_absent_boundaries().get_or(False)


private func scoped_inheritance_preserves_declaring_identity() -> Option[Bool]:
	fixture ?= scoped_authority_fixture(
		"trait Parent:\n\tpure func show(value: Self) -> Int\n" + "trait Child: Parent:\n\tpure func show(value: Self) -> Int\n\tpure func detail(value: Self) -> Int\n" + "trait Equatable:\n\tpure func equals(left: Self, right: Self) -> Bool\n",
	)
	child ?= accepted_trait_find(fixture.authority, "Child")
	parent ?= accepted_trait_find(fixture.authority, "Parent")
	namesake ?= accepted_trait_find(fixture.authority, "Equatable")
	methods ?= issued_scoped_methods(fixture, child.trait_id)
	first ?= methods.get(0)
	inherited ?= methods.get(2)
	binding ?= accepted_trait_method_binding_for_id(
		fixture.authority,
		fixture.issuer,
		inherited[1],
	).to_option()
	Some(
		(
			methods.length() == 3
			and first[0] == "show"
			and trait_ids_equal(trait_method_id_owner(first[1]), child.trait_id)
			and inherited[0] == "show"
			and trait_ids_equal(trait_method_id_owner(inherited[1]), parent.trait_id)
			and accepted_trait_method_binding_declaring_trait_name(binding) == "Parent"
			and trait_id_module_id(fixture.issuer, namesake.trait_id).is_some()
		),
	)


func test_scoped_inheritance_preserves_declaring_identity() -> Bool:
	scoped_inheritance_preserves_declaring_identity().get_or(False)


private func compiler_scope_preserves_obligation_and_selected_metadata() -> Option[Bool]:
	fixture ?= scoped_authority_fixture(
		"record Choice {value: Int}\nimplements Equatable for Choice:\n\tpure func equals(left: Choice, right: Choice) -> Bool: True\n",
	)

	compiler_source = match accepted_scoped_trait_methods(
		fixture.authority,
		fixture.issuer,
		TRAIT_ID_EQUATABLE,
	):
		Ok(CompilerProvidedScopedTrait(id)):
			trait_ids_equal(id, TRAIT_ID_EQUATABLE)
		_:
			False

	env = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN).env
	receiver = SemanticNamedType("Choice", [])
	legacy ?= accepted_find_impl_method_info(
		fixture.authority,
		env,
		"Equatable",
		"equals",
		receiver,
	)
	selected ?= accepted_find_impl_method_info_by_trait_id(
		fixture.authority,
		fixture.issuer,
		env,
		TRAIT_ID_EQUATABLE,
		"equals",
		receiver,
	)
	legacy_target ?= legacy.target
	selected_target ?= selected.target
	issued_callable ?= callable_id_from_definition_table(
		fixture.issuer,
		selected_target.callable_id,
	)
	Some(
		(
			compiler_source
			and accepted_trait_find(fixture.authority, "Equatable").is_none()
			and callable_id_name(fixture.issuer, issued_callable) == Some("equals")
			and selected_target.callable_id == legacy_target.callable_id
			and types_equal(selected.func_type, legacy.func_type)
			and selected.param_names == legacy.param_names
			and selected.purity == legacy.purity
			and resource_arg_policies_equal(selected.resource_args, legacy.resource_args)
			and selected.debug_only == legacy.debug_only
			and selected.type_params.is_empty()
			and legacy.type_params.is_empty()
			and selected.dim_constraints.is_empty()
			and legacy.dim_constraints.is_empty()
			and accepted_resolve_trait_id_obligation(
				fixture.authority,
				fixture.issuer,
				env,
				TYPE_INT,
				TRAIT_ID_EQUATABLE,
			) == TraitObligationSatisfied
		),
	)


func test_compiler_scope_preserves_obligation_and_selected_metadata() -> Bool:
	compiler_scope_preserves_obligation_and_selected_metadata().get_or(False)


private func compiler_consumers_reject_foreign_and_unregistered_ids() -> Option[Bool]:
	fixture ?= scoped_authority_fixture(CATALOG_SOURCE)
	other_fixture ?= scoped_authority_fixture(CATALOG_SOURCE)
	env = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN).env
	forged = builtin_trait_id_at_registry_index(BUILTIN_TRAIT_NAMES.length())

	forged_scope_rejected = match accepted_scoped_trait_methods(
		fixture.authority,
		fixture.issuer,
		forged,
	):
		Err(message):
			message == "scoped trait identity is not registered in its issuing domain"
		_:
			False

	Some(
		(
			forged_scope_rejected
			and accepted_resolve_trait_id_obligation(
				fixture.authority,
				other_fixture.issuer,
				env,
				TYPE_INT,
				TRAIT_ID_EQUATABLE,
			) == TraitObligationUnsatisfied
			and accepted_resolve_trait_id_obligation(
				fixture.authority,
				fixture.issuer,
				env,
				TYPE_INT,
				forged,
			) == TraitObligationUnsatisfied
			and accepted_find_impl_method_info_by_trait_id(
				fixture.authority,
				other_fixture.issuer,
				env,
				TRAIT_ID_EQUATABLE,
				"equals",
				TYPE_INT,
			).is_none()
			and accepted_find_impl_method_info_by_trait_id(
				fixture.authority,
				fixture.issuer,
				env,
				forged,
				"equals",
				TYPE_INT,
			).is_none()
		),
	)


func test_compiler_consumers_reject_foreign_and_unregistered_ids() -> Bool:
	compiler_consumers_reject_foreign_and_unregistered_ids().get_or(False)


tests: TestSuite = {
	description = "Accepted semantic catalog",
	tests = [
		("concrete method lookup preserves invalid and absent boundaries", test_concrete_method_lookup_preserves_invalid_and_absent_boundaries),
		(
			"compiler scope preserves obligation and selected metadata",
			test_compiler_scope_preserves_obligation_and_selected_metadata,
		),
		(
			"compiler consumers reject foreign and unregistered IDs",
			test_compiler_consumers_reject_foreign_and_unregistered_ids,
		),
		(
