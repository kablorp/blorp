import:
	../../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../../src/compiler/stage_06_typecheck/decl:
		AcceptedTypecheckGraph,
		accepted_typecheck_graph_implementation_headers,
		accepted_typecheck_graph_semantic_catalog,
	../../../src/compiler/stage_06_typecheck/headers/accepted_alias_graph: AcceptedAliasGraph
	../../../src/compiler/stage_06_typecheck/headers/accepted_record_graph: AcceptedRecordGraph
	../../../src/compiler/stage_06_typecheck/headers/accepted_union_graph: AcceptedUnionGraph
	../../../src/compiler/stage_06_typecheck/headers/implementation_headers:
		ImplementationHeaderGraph,
		implementation_header_graph_definition_table,
	../../../src/compiler/stage_06_typecheck/state:
		TYPECHECK_USER_ORIGIN,
		typecheck_state_for_origin,
	../../../src/compiler/stage_06_typecheck/type_system/accepted_callable_authority:
		AcceptedCallableTable,
	../../../src/compiler/stage_06_typecheck/type_system/accepted_global_authority:
		AcceptedGlobalTable,
		accepted_global_table,
		accepted_global_table_source_name_table,
	../../../src/compiler/stage_06_typecheck/type_system/accepted_semantic_catalog:
		AcceptedSemanticCatalog,
		AcceptedSemanticCatalogInput,
		accepted_constructor_table_entry_count,
		accepted_field_table_entry_count,
		accepted_semantic_catalog,
		accepted_semantic_catalog_alias_graph,
		accepted_semantic_catalog_alias_table,
		accepted_semantic_catalog_callable_table,
		accepted_semantic_catalog_constructor_table,
		accepted_semantic_catalog_field_table,
		accepted_semantic_catalog_global_table,
		accepted_semantic_catalog_record_graph,
		accepted_semantic_catalog_record_table,
		accepted_semantic_catalog_table_counts,
		accepted_semantic_catalog_trait_implementation_table,
		accepted_semantic_catalog_union_graph,
		accepted_semantic_catalog_union_table,
	../../../src/compiler/stage_06_typecheck/type_system/accepted_trait_implementation_authority:
		AcceptedTraitImplementationTable,
		accepted_trait_implementation_table,
	../../../src/lib/source: source_file
	../typecheck_test_support: typecheck_test_accepted_graph
	test: TestSuite


private CATALOG_SOURCE: String =
	|type alias Number = Int
	|
	|record Pair {left: Int, right: Int}
	|
	|union Signal:
	|	Ready
	|	Busy(Int)
	|
	|pure func choose(value: Int) -> Int: value
	|
	|answer: Int = 42
	|
	|trait Identity:
	|	pure func identity(value: Self) -> Int
	|
	|implements Identity for Pair:
	|	pure func identity(value: Pair) -> Int:
	|		value.left


private record CatalogComponentFixture {
	implementation_headers: ImplementationHeaderGraph,
	aliases: AcceptedAliasGraph,
	records: AcceptedRecordGraph,
	unions: AcceptedUnionGraph,
	callables: AcceptedCallableTable,
	globals: AcceptedGlobalTable,
	traits_and_implementations: AcceptedTraitImplementationTable
}


private pure func accepted_graph_for_source(
	module_path: String,
	source: String,
) -> Option[AcceptedTypecheckGraph]:
	program = parse_compiler_source(source_file(module_path + ".brp", module_path, source))
	typecheck_test_accepted_graph(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		program,
		[],
	).to_option()


private pure func catalog_component_fixture(
	module_path: String,
	source: String,
) -> Option[CatalogComponentFixture]:
	graph ?= accepted_graph_for_source(module_path, source)
	catalog = accepted_typecheck_graph_semantic_catalog(graph)
	Some({
		implementation_headers = accepted_typecheck_graph_implementation_headers(graph),
		aliases = accepted_semantic_catalog_alias_graph(catalog),
		records = accepted_semantic_catalog_record_graph(catalog),
		unions = accepted_semantic_catalog_union_graph(catalog),
		callables = accepted_semantic_catalog_callable_table(catalog),
		globals = accepted_semantic_catalog_global_table(catalog),
		traits_and_implementations = accepted_semantic_catalog_trait_implementation_table(catalog),
	})


private pure func catalog_input(fixture: CatalogComponentFixture) -> AcceptedSemanticCatalogInput:
	{
		implementation_headers = fixture.implementation_headers,
		aliases = fixture.aliases,
		records = fixture.records,
		unions = fixture.unions,
		callables = fixture.callables,
		globals = fixture.globals,
		traits_and_implementations = fixture.traits_and_implementations
	}


private pure func catalog_with_components(
	implementation_headers: ImplementationHeaderGraph,
	aliases: AcceptedAliasGraph,
	records: AcceptedRecordGraph,
	unions: AcceptedUnionGraph,
	callables: AcceptedCallableTable,
	globals: AcceptedGlobalTable,
	traits_and_implementations: AcceptedTraitImplementationTable,
) -> Option[AcceptedSemanticCatalog]:
	accepted_semantic_catalog({
		implementation_headers = implementation_headers,
		aliases = aliases,
		records = records,
		unions = unions,
		callables = callables,
		globals = globals,
		traits_and_implementations = traits_and_implementations,
	})


private pure func coherent_catalog() -> Option[AcceptedSemanticCatalog]:
	fixture ?= catalog_component_fixture("catalog/main", CATALOG_SOURCE)
	accepted_semantic_catalog(catalog_input(fixture))


private pure func catalog_accepts_one_coherent_domain() -> Option[Bool]:
	catalog ?= coherent_catalog()
	counts = accepted_semantic_catalog_table_counts(catalog)
	Some(
		(
			counts.type_identities == 3
			and counts.aliases == 1
			and counts.records == 1
			and counts.fields == 2
			and counts.unions == 4
			and counts.constructors == 9
			and counts.callables == 1
			and counts.completed_globals == 1
			and counts.traits == 1
			and counts.implementations == 1
			and accepted_constructor_table_entry_count(
				accepted_semantic_catalog_constructor_table(catalog),
			) == 9
			and accepted_field_table_entry_count(
				accepted_semantic_catalog_field_table(catalog),
			) == 2
		),
	)


func test_catalog_accepts_one_coherent_domain() -> Bool:
	catalog_accepts_one_coherent_domain().get_or(False)


private pure func catalog_rejects_mixed_domains() -> Option[Bool]:
	owner ?= catalog_component_fixture("catalog/owner", CATALOG_SOURCE)
	other ?= catalog_component_fixture("catalog/other", CATALOG_SOURCE)

	Some(
		(
			catalog_with_components(
				other.implementation_headers,
				owner.aliases,
				owner.records,
				owner.unions,
				owner.callables,
				owner.globals,
				owner.traits_and_implementations,
			).is_none()
			and catalog_with_components(
				owner.implementation_headers,
				other.aliases,
				owner.records,
				owner.unions,
				owner.callables,
				owner.globals,
				owner.traits_and_implementations,
			).is_none()
			and catalog_with_components(
				owner.implementation_headers,
				owner.aliases,
				other.records,
				owner.unions,
				owner.callables,
				owner.globals,
				owner.traits_and_implementations,
			).is_none()
			and catalog_with_components(
				owner.implementation_headers,
				owner.aliases,
				owner.records,
				other.unions,
				owner.callables,
				owner.globals,
				owner.traits_and_implementations,
			).is_none()
			and catalog_with_components(
				owner.implementation_headers,
				owner.aliases,
				owner.records,
				owner.unions,
				other.callables,
				owner.globals,
				owner.traits_and_implementations,
			).is_none()
			and catalog_with_components(
				owner.implementation_headers,
				owner.aliases,
				owner.records,
				owner.unions,
				owner.callables,
				other.globals,
				owner.traits_and_implementations,
			).is_none()
			and catalog_with_components(
				owner.implementation_headers,
				owner.aliases,
				owner.records,
				owner.unions,
				owner.callables,
				owner.globals,
				other.traits_and_implementations,
			).is_none()
		),
	)


func test_catalog_rejects_every_mixed_domain() -> Bool:
	catalog_rejects_mixed_domains().get_or(False)


private pure func catalog_rejects_empty_complete_global_table() -> Option[Bool]:
	fixture ?= catalog_component_fixture("catalog/globals", "answer: Int = 42")
	definition_table = implementation_header_graph_definition_table(fixture.implementation_headers)
	empty_globals ?= accepted_global_table({
		definition_table = definition_table,
		source_name_table = accepted_global_table_source_name_table(fixture.globals),
		globals = [],
	})
	Some(
		catalog_with_components(
			fixture.implementation_headers,
			fixture.aliases,
			fixture.records,
			fixture.unions,
			fixture.callables,
			empty_globals,
			fixture.traits_and_implementations,
		).is_none(),
	)


func test_catalog_rejects_empty_complete_global_table() -> Bool:
	catalog_rejects_empty_complete_global_table().get_or(False)


tests: TestSuite = {
	description = "Accepted semantic catalog",
	tests = [
		("accepts one coherent domain", test_catalog_accepts_one_coherent_domain),
		("rejects every mixed domain", test_catalog_rejects_every_mixed_domain),
		("rejects empty complete global table", test_catalog_rejects_empty_complete_global_table),
	]
}
