import:
    float: copysign, is_nan
    int: INT_MAX, INT_MIN
    math: PI, sqrt, floor, ceil, round, trunc, sin, cos, tan, atan2, exp, log, pow, to_int, to_float
    test: TestSuite


private pure func infinity() -> Float:
    1.0e308 * 10.0


private pure func nan() -> Float:
    value = infinity()
    value - value


-- Zero with its sign bit set; `==` cannot tell it from 0.0.
private pure func is_negative_zero(value: Float) -> Bool:
    (value == 0.0).and(copysign(1.0, value) < 0.0)


private pure func is_positive_zero(value: Float) -> Bool:
    (value == 0.0).and(copysign(1.0, value) > 0.0)


-- For the libm functions, whose last bit may differ between platforms.
private pure func near(value: Float, expected: Float) -> Bool:
    difference = value - expected
    (difference < 1.0e-15).and(difference > -1.0e-15)


private pure func test_sqrt_of_known_values() -> Bool:
    (sqrt(4.0) == 2.0)
        .and(sqrt(2.0) == 1.4142135623730951)
        .and(sqrt(0.25) == 0.5)
        .and(sqrt(infinity()) == infinity())


private pure func test_sqrt_below_zero_is_nan_and_keeps_negative_zero() -> Bool:
    is_nan(sqrt(-1.0))
        .and(is_nan(sqrt(nan())))
        .and(is_negative_zero(sqrt(-0.0)))
        .and(is_nan(sqrt(0.0 - infinity())))


private pure func test_floor_and_ceil_round_toward_their_infinities() -> Bool:
    (floor(-1.5) == -2.0)
        .and(floor(1.5) == 1.0)
        .and(ceil(-1.5) == -1.0)
        .and(ceil(1.2) == 2.0)
        .and(is_negative_zero(ceil(-0.5)))
        .and(is_negative_zero(floor(-0.0)))
        .and(floor(infinity()) == infinity())
        .and(is_nan(ceil(nan())))


private pure func test_round_takes_halves_away_from_zero() -> Bool:
    (round(2.5) == 3.0)
        .and(round(-2.5) == -3.0)
        .and(round(0.5) == 1.0)
        .and(round(1.4999999999999998) == 1.0)
        .and(is_positive_zero(round(0.49999999999999994)))
        .and(is_negative_zero(round(-0.4)))
        .and(is_nan(round(nan())))


private pure func test_trunc_rounds_toward_zero() -> Bool:
    (trunc(1.7) == 1.0)
        .and(trunc(-1.7) == -1.0)
        .and(is_negative_zero(trunc(-0.5)))
        .and(trunc(0.0 - infinity()) == 0.0 - infinity())


private pure func test_trigonometry_at_known_angles() -> Bool:
    is_positive_zero(sin(0.0))
        .and(is_negative_zero(sin(-0.0)))
        .and(cos(0.0) == 1.0)
        .and(is_positive_zero(tan(0.0)))
        .and(near(sin(PI / 2.0), 1.0))
        .and(near(cos(PI), -1.0))
        .and(near(tan(PI / 4.0), 1.0))
        .and(is_nan(sin(infinity())))


-- C's Annex F gives atan2 exact results on the axes.
private pure func test_atan2_takes_y_first_and_signs_the_axes() -> Bool:
    (atan2(0.0, -1.0) == PI)
        .and(atan2(-0.0, -1.0) == 0.0 - PI)
        .and(atan2(1.0, 0.0) == PI / 2.0)
        .and(is_positive_zero(atan2(0.0, 1.0)))
        .and(near(atan2(1.0, 1.0), PI / 4.0))
        .and(near(atan2(-1.0, -1.0), -3.0 * PI / 4.0))


private pure func test_exp_and_log_are_inverse_and_meet_their_limits() -> Bool:
    (exp(0.0) == 1.0)
        .and(near(exp(1.0), 2.718281828459045))
        .and(is_positive_zero(log(1.0)))
        .and(near(log(exp(2.0)), 2.0))
        .and(log(0.0) == 0.0 - infinity())
        .and(is_nan(log(-1.0)))
        .and(exp(0.0 - infinity()) == 0.0)
        .and(exp(1000.0) == infinity())


private pure func test_pow_follows_the_ieee_special_cases() -> Bool:
    (pow(2.0, 10.0) == 1024.0)
        .and(pow(2.0, -1.0) == 0.5)
        .and(pow(nan(), 0.0) == 1.0)
        .and(pow(1.0, nan()) == 1.0)
        .and(is_nan(pow(-8.0, 1.0 / 3.0)))
        .and(pow(-2.0, 3.0) == -8.0)


private pure func test_to_int_truncates_toward_zero() -> Bool:
    (to_int(1.9) == 1)
        .and(to_int(-1.9) == -1)
        .and(to_int(-0.0) == 0)
        .and(to_int(9007199254740993.0) == 9007199254740992)


-- 9223372036854774784.0 is the greatest Float below 2^63, and fits.
private pure func test_to_int_saturates_at_both_ends() -> Bool:
    (to_int(1.0e300) == INT_MAX)
        .and(to_int(infinity()) == INT_MAX)
        .and(to_int(9223372036854775808.0) == INT_MAX)
        .and(to_int(9223372036854774784.0) == 9223372036854774784)
        .and(to_int(-1.0e300) == INT_MIN)
        .and(to_int(0.0 - infinity()) == INT_MIN)
        .and(to_int(-9223372036854775808.0) == INT_MIN)
        .and(to_int(-9223372036854774784.0) == -9223372036854774784)


private pure func test_to_int_of_nan_is_zero() -> Bool:
    to_int(nan()) == 0


private pure func test_to_float_is_exact_to_two_to_the_53() -> Bool:
    (to_float(-3) == -3.0)
        .and(to_float(9007199254740992) == 9007199254740992.0)
        .and(to_float(-9007199254740992) == -9007199254740992.0)
        .and(is_positive_zero(to_float(0)))


-- Beyond 2^53 the nearest Float wins, the even one at a tie.
private pure func test_to_float_rounds_to_nearest_beyond_two_to_the_53() -> Bool:
    (to_float(9007199254740993) == 9007199254740992.0)
        .and(to_float(9007199254740995) == 9007199254740996.0)
        .and(to_float(INT_MAX) == 9223372036854775808.0)
        .and(to_float(INT_MIN) == -9223372036854775808.0)
        .and(to_int(to_float(INT_MAX)) == INT_MAX)


TESTS: TestSuite = {
    description = "math Float functions and conversions",
    tests = [
        ("sqrt of known values", test_sqrt_of_known_values),
        (
            "sqrt below zero is NaN and keeps negative zero",
            test_sqrt_below_zero_is_nan_and_keeps_negative_zero
        ),
        (
            "floor and ceil round toward their infinities",
            test_floor_and_ceil_round_toward_their_infinities
        ),
        ("round takes halves away from zero", test_round_takes_halves_away_from_zero),
        ("trunc rounds toward zero", test_trunc_rounds_toward_zero),
        ("sin, cos and tan at known angles", test_trigonometry_at_known_angles),
        ("atan2 takes y first and signs the axes", test_atan2_takes_y_first_and_signs_the_axes),
        (
            "exp and log are inverse and meet their limits",
            test_exp_and_log_are_inverse_and_meet_their_limits
        ),
        ("pow follows the IEEE special cases", test_pow_follows_the_ieee_special_cases),
        ("to_int truncates toward zero", test_to_int_truncates_toward_zero),
        ("to_int saturates at both ends", test_to_int_saturates_at_both_ends),
        ("to_int of NaN is zero", test_to_int_of_nan_is_zero),
        ("to_float is exact up to 2^53", test_to_float_is_exact_to_two_to_the_53),
        (
            "to_float rounds to nearest beyond 2^53",
            test_to_float_rounds_to_nearest_beyond_two_to_the_53
        )
    ]
}
