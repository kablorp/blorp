import:
    bits: bit_and, bit_or, bit_xor, bit_not, shift_left, shift_right
    int: INT_MAX, INT_MIN
    test: TestSuite


private pure func test_bit_and_keeps_the_common_bits() -> Bool:
    (bit_and(12, 10) == 8)
        .and(bit_and(-1, 12345) == 12345)
        .and(bit_and(INT_MIN, -1) == INT_MIN)
        .and(bit_and(INT_MAX, INT_MIN) == 0)


private pure func test_bit_or_keeps_either_bits() -> Bool:
    (bit_or(12, 10) == 14)
        .and(bit_or(INT_MAX, INT_MIN) == -1)
        .and(bit_or(0, -7) == -7)


private pure func test_bit_xor_keeps_the_differing_bits() -> Bool:
    (bit_xor(12, 10) == 6)
        .and(bit_xor(-1, INT_MAX) == INT_MIN)
        .and(bit_xor(12345, 12345) == 0)


private pure func test_bit_not_flips_every_bit() -> Bool:
    (bit_not(0) == -1)
        .and(bit_not(-1) == 0)
        .and(bit_not(INT_MAX) == INT_MIN)
        .and(bit_not(5) == -6)


private pure func test_shift_left_at_each_count() -> Bool:
    (shift_left(3, 0) == 3)
        .and(shift_left(3, 1) == 6)
        .and(shift_left(1, 63) == INT_MIN)
        .and(shift_left(-1, 63) == INT_MIN)
        .and(shift_left(3, 63) == INT_MIN)
        .and(shift_left(-1, 1) == -2)


-- A count outside 0 to 63 shifts every bit out.
private pure func test_shift_left_outside_the_counts_is_zero() -> Bool:
    (shift_left(3, -1) == 0)
        .and(shift_left(3, 64) == 0)
        .and(shift_left(-1, 1000) == 0)
        .and(shift_left(1, INT_MIN) == 0)


private pure func test_shift_right_is_logical_at_each_count() -> Bool:
    (shift_right(12, 0) == 12)
        .and(shift_right(12, 1) == 6)
        .and(shift_right(-1, 1) == INT_MAX)
        .and(shift_right(-1, 63) == 1)
        .and(shift_right(INT_MIN, 63) == 1)
        .and(shift_right(INT_MAX, 63) == 0)
        .and(shift_right(-8, 0) == -8)


private pure func test_shift_right_outside_the_counts_is_zero() -> Bool:
    (shift_right(-1, -1) == 0)
        .and(shift_right(-1, 64) == 0)
        .and(shift_right(INT_MAX, 1000) == 0)
        .and(shift_right(-1, INT_MAX) == 0)


TESTS: TestSuite = {
    description = "bits operations on Int",
    tests = [
        ("bit_and keeps the common bits", test_bit_and_keeps_the_common_bits),
        ("bit_or keeps either bits", test_bit_or_keeps_either_bits),
        ("bit_xor keeps the differing bits", test_bit_xor_keeps_the_differing_bits),
        ("bit_not flips every bit", test_bit_not_flips_every_bit),
        ("shift_left at counts 0, 1 and 63", test_shift_left_at_each_count),
        ("shift_left by -1, 64 or 1,000 is zero", test_shift_left_outside_the_counts_is_zero),
        ("shift_right is logical at counts 0, 1 and 63", test_shift_right_is_logical_at_each_count),
        ("shift_right by -1, 64 or 1,000 is zero", test_shift_right_outside_the_counts_is_zero)
    ]
}
