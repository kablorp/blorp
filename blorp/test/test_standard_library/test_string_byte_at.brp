import:
    _base: UInt8
    bool: and
    bytes: Bytes, String methods
    option: Option methods
    test: TestSuite
    uint8: UInt8 methods


-- The UTF-8 bytes of the accented letter e are C3 A9, both above 0x7F.
private ACCENTED: String = "é"


private pure func test_a_non_ascii_string_reads_its_utf8_bytes_as_uint8() -> Bool:
    first: Option[UInt8] = ACCENTED.byte_at(0)
    second: Option[UInt8] = ACCENTED.byte_at(1)
    and(first == Some(195), second == Some(169))


private pure func test_byte_at_is_none_past_either_end() -> Bool:
    and(
        ACCENTED
            .byte_at(2)
            .is_none(),
        ACCENTED
            .byte_at(-1)
            .is_none(),
    )


private pure func test_byte_at_agrees_with_to_bytes_at_each_index() -> Bool:
    text = "aé\0z"
    bytes = text.to_bytes()
    var agrees = and(
        text
            .byte_at(text.length())
            .is_none(),
        bytes
            .get(text.length())
            .is_none(),
    )
    for index in 0..text.length():
        agrees = and(agrees, text.byte_at(index) == bytes.get(index))
    agrees


TESTS: TestSuite = {
    description = "String.byte_at returns Option[UInt8]",
    tests = [
        (
            "a non-ASCII String reads its UTF-8 bytes as UInt8",
            test_a_non_ascii_string_reads_its_utf8_bytes_as_uint8,
        ),
        ("byte_at is None past either end", test_byte_at_is_none_past_either_end),
        (
            "byte_at agrees with to_bytes at each index",
            test_byte_at_agrees_with_to_bytes_at_each_index,
        ),
    ],
}
