---
The whole standard library checks, every body included. A compile checks a
library body only when its program can reach it, so this suite is where an
error in a body no program uses appears.
---
import:
    test: TestSuite
    ../../build/generated/embedded_library: EMBEDDED_LIBRARY_PATHS
    ../../src/common/analysis/check/check: analyze_whole_library
    ../../src/common/analysis/check/render: render_failure
    ../../src/common/analysis/load/load:
        LibrarySource(LibraryDirectory),
        SourceLoadFailure(LoadingFailed),
        load_program_with_sources
    ../../src/common/cli/report: render_diagnostics
    ../../src/common/syntax/syntax: singleton_diagnostic


-- Supplied as source, so the file never exists.
private ROOT: String = "blorp/build/whole_library/main.brp"


-- A program importing every library module but the foundation and the
-- prelude, which every program loads.
private pure func importing_every_module() -> String:
    var text = "import:\n"
    var position = 0
    for path in EMBEDDED_LIBRARY_PATHS:
        if (path != "_base.brp").and(path != "prelude.brp"):
            -- Every embedded path ends in `.brp`, which the import leaves out.
            stem = path
                .slice(0, path.length() - 4)
                .get_or(path)
            text = text + "    ${stem} as library_module_${position}\n"
            position = position + 1
    text + "\n\nfunc main() -> Int:\n    0\n"


func test_every_library_body_checks() -> Bool:
    match load_program_with_sources(ROOT, LibraryDirectory("blorp/standard_library"), [
        { path = ROOT, contents = importing_every_module() }
    ]):
        Err(LoadingFailed(failure)):
            print_error(
                failure.sources.render_diagnostics(failure.diagnostic.singleton_diagnostic())
            )
            False
        Err(_):
            print_error("the whole-library program's source was not accepted")
            False
        Ok(loaded):
            match analyze_whole_library(loaded.program):
                Err(failure):
                    print_error(loaded.sources.render_diagnostics(failure.render_failure()))
                    False
                Ok(_):
                    True


TESTS: TestSuite = {
    description = "Blorp's whole standard library checks",
    tests = [("every library body checks", test_every_library_body_checks)]
}
