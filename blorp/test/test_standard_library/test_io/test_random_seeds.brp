import:
    io/random: random_seed, random_below, random_float
    test: TestSuite


-- A sanity check, not a proof: two 64-bit seeds collide once in 2^64.
func test_two_seeds_differ() -> Bool:
    random_seed() != random_seed()


func test_random_below_is_below_its_bound() -> Bool:
    var in_range: Bool = True

    for _ in 0..100:
        value = random_below(6)

        in_range = in_range
            .and(value >= 0)
            .and(value < 6)

    in_range
        .and(random_below(0) == 0)
        .and(random_below(-3) == 0)


func test_random_float_is_in_zero_to_one() -> Bool:
    var in_range: Bool = True

    for _ in 0..100:
        value = random_float()

        in_range = in_range
            .and(value >= 0.0)
            .and(value < 1.0)

    in_range


TESTS: TestSuite = {
    description = "io/random seeds",
    tests = [
        ("two seeds differ", test_two_seeds_differ),
        ("random_below is below its bound", test_random_below_is_below_its_bound),
        ("random_float is in [0, 1)", test_random_float_is_in_zero_to_one)
    ]
}
