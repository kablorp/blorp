import:
    bool: Bool methods
    io/environment: CurrentDirectoryError, decode_current_directory_error, get_current_directory
    string: String methods
    test: TestSuite


-- Variants are compared by name, independently of the library's own text.
private pure func variant_name(error: CurrentDirectoryError) -> String:
    match error:
        CurrentDirectoryError.NotFound: "NotFound"
        CurrentDirectoryError.PermissionDenied: "PermissionDenied"
        CurrentDirectoryError.InvalidUtf8: "InvalidUtf8"
        CurrentDirectoryError.Unreachable: "Unreachable"
        CurrentDirectoryError.OtherOs(number): "OtherOs(${number})"


private pure func decodes_to(code: Int, expected: String) -> Bool:
    decode_current_directory_error(code).variant_name() == expected


-- Literal inputs independently bind the library decoder to the native protocol:
-- the file protocol's NotFound is 1, PermissionDenied 2, InvalidUtf8 13 and
-- Unreachable 15.
pure func test_named_native_codes_keep_their_error_variants() -> Bool:
    decodes_to(1, "NotFound")
        .and(decodes_to(2, "PermissionDenied"))
        .and(decodes_to(13, "InvalidUtf8"))
        .and(decodes_to(15, "Unreachable"))


-- An unnamed errno arrives negated and keeps the platform's number. A positive
-- code that no variant names is a disagreement between the two tables, kept
-- visible as a negative number that no real errno produces.
pure func test_unnamed_codes_become_other_os_with_the_code_negated() -> Bool:
    decodes_to(-62, "OtherOs(62)")
        .and(decodes_to(0, "OtherOs(0)"))
        .and(decodes_to(4, "OtherOs(-4)"))
        .and(decodes_to(14, "OtherOs(-14)"))
        .and(decodes_to(16, "OtherOs(-16)"))


pure func test_error_text_shares_the_io_phrases() -> Bool:
    cases: List[(CurrentDirectoryError, String)] = [
        (CurrentDirectoryError.NotFound, "no such file"),
        (CurrentDirectoryError.PermissionDenied, "permission denied"),
        (CurrentDirectoryError.InvalidUtf8, "contents are not valid UTF-8"),
        (CurrentDirectoryError.Unreachable, "the working directory has no usable absolute path"),
        (CurrentDirectoryError.OtherOs(62), "operating system error 62"),
    ]
    cases.all(pure func(case: (CurrentDirectoryError, String)) -> Bool:
        match case:
            (error, expected): "${error}" == expected
    )


-- The native's reply becomes a Path: a nonempty absolute spelling.
func test_get_current_directory_returns_an_absolute_path() -> Bool:
    match get_current_directory():
        Ok(directory): "${directory}".starts_with("/")
        Err(_): False


TESTS: TestSuite = {
    description = "Blorp current directory errors",
    tests = [
        (
            "named native codes keep their error variants",
            test_named_native_codes_keep_their_error_variants,
        ),
        (
            "unnamed codes become OtherOs with the code negated",
            test_unnamed_codes_become_other_os_with_the_code_negated,
        ),
        ("error text shares the io phrases", test_error_text_shares_the_io_phrases),
        (
            "get_current_directory returns an absolute Path",
            test_get_current_directory_returns_an_absolute_path,
        ),
    ],
}
