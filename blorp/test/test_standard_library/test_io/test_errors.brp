import:
    int: INT_MIN, INT_MAX
    io/_errors: NativeErrorKind, native_error_code, native_error_kind, other_os_number
    test: TestSuite


-- Expected codes are literal protocol facts, independently of the encoder.
pure func kind_round_trips(code: Int, kind: NativeErrorKind) -> Bool:
    (native_error_code(kind) == code)
        .and(native_error_kind(code) == Some(kind))
        .and(native_error_kind(native_error_code(kind)) == Some(kind))


pure func unknown_codes_have_no_kind() -> Bool:
    codes: List[Int] = [0, -1, -37, INT_MIN, 16, 99, INT_MAX]
    codes.all(pure func(code: Int) -> Bool: native_error_kind(code) == None)


pure func fallback_numbers_preserve_protocol_disagreements() -> Bool:
    cases: List[(Int, Int)] = [
        (0, 0),
        (-1, 1),
        (-37, 37),
        (12, -12),
        (99, -99),
        (INT_MIN, INT_MIN),
        (INT_MAX, -9223372036854775807)
    ]
    cases.all(pure func(pair: (Int, Int)) -> Bool:
        match pair:
            (code, number): other_os_number(code) == number
    )


pure func not_found_wire_code() -> Bool:
    kind_round_trips(1, NativeErrorKind.NotFound)


pure func permission_denied_wire_code() -> Bool:
    kind_round_trips(2, NativeErrorKind.PermissionDenied)


pure func already_exists_wire_code() -> Bool:
    kind_round_trips(3, NativeErrorKind.AlreadyExists)


pure func not_a_directory_wire_code() -> Bool:
    kind_round_trips(4, NativeErrorKind.NotADirectory)


pure func is_a_directory_wire_code() -> Bool:
    kind_round_trips(5, NativeErrorKind.IsADirectory)


pure func directory_not_empty_wire_code() -> Bool:
    kind_round_trips(6, NativeErrorKind.DirectoryNotEmpty)


pure func not_a_regular_file_wire_code() -> Bool:
    kind_round_trips(7, NativeErrorKind.NotARegularFile)


pure func read_only_filesystem_wire_code() -> Bool:
    kind_round_trips(8, NativeErrorKind.ReadOnlyFilesystem)


pure func no_space_wire_code() -> Bool:
    kind_round_trips(9, NativeErrorKind.NoSpace)


pure func file_too_large_wire_code() -> Bool:
    kind_round_trips(10, NativeErrorKind.FileTooLarge)


pure func crosses_devices_wire_code() -> Bool:
    kind_round_trips(11, NativeErrorKind.CrossesDevices)


pure func path_contains_nul_wire_code() -> Bool:
    kind_round_trips(12, NativeErrorKind.PathContainsNul)


pure func invalid_utf8_wire_code() -> Bool:
    kind_round_trips(13, NativeErrorKind.InvalidUtf8)


pure func changed_during_removal_wire_code() -> Bool:
    kind_round_trips(14, NativeErrorKind.ChangedDuringRemoval)


pure func unreachable_wire_code() -> Bool:
    kind_round_trips(15, NativeErrorKind.Unreachable)


TESTS: TestSuite = {
    description = "Typed native I/O error protocol",
    tests = [
        ("wire 1 NotFound encodes decodes and round trips", not_found_wire_code),
        ("wire 2 PermissionDenied encodes decodes and round trips", permission_denied_wire_code),
        ("wire 3 AlreadyExists encodes decodes and round trips", already_exists_wire_code),
        ("wire 4 NotADirectory encodes decodes and round trips", not_a_directory_wire_code),
        ("wire 5 IsADirectory encodes decodes and round trips", is_a_directory_wire_code),
        ("wire 6 DirectoryNotEmpty encodes decodes and round trips", directory_not_empty_wire_code),
        ("wire 7 NotARegularFile encodes decodes and round trips", not_a_regular_file_wire_code),
        (
            "wire 8 ReadOnlyFilesystem encodes decodes and round trips",
            read_only_filesystem_wire_code
        ),
        ("wire 9 NoSpace encodes decodes and round trips", no_space_wire_code),
        ("wire 10 FileTooLarge encodes decodes and round trips", file_too_large_wire_code),
        ("wire 11 CrossesDevices encodes decodes and round trips", crosses_devices_wire_code),
        ("wire 12 PathContainsNul encodes decodes and round trips", path_contains_nul_wire_code),
        ("wire 13 InvalidUtf8 encodes decodes and round trips", invalid_utf8_wire_code),
        (
            "wire 14 ChangedDuringRemoval encodes decodes and round trips",
            changed_during_removal_wire_code
        ),
        ("wire 15 Unreachable encodes decodes and round trips", unreachable_wire_code),
        ("unnamed signed and out of range codes have no kind", unknown_codes_have_no_kind),
        (
            "fallback numbers retain errno and protocol mismatch signs",
            fallback_numbers_preserve_protocol_disagreements
        )
    ]
}
