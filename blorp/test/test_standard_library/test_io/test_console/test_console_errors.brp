import:
    int: INT_MIN
    io/console/read_exact: ReadExactError, decode_read_exact_error
    io/console/read_line: ReadLineError, decode_read_line_error
    test: TestSuite


-- Literal codes independently bind each decoder to the native protocol of
-- src/common/codegen/runtime/console.brp and io/_errors. A code a union does not
-- name is OtherOs with the code negated: an unnamed errno arrives negated and
-- keeps the platform's number, and a positive code no variant names stays
-- visible as a negative one.
private pure func decodes_all[T: Equatable](decode: pure (Int) -> T, cases: List[(Int, T)]) -> Bool:
    cases.all(pure func(case: (Int, T)) -> Bool:
        match case:
            (code, expected): decode(code) == expected
    )


private pure func texts_all[T: Stringable](cases: List[(T, String)]) -> Bool:
    cases.all(pure func(case: (T, String)) -> Bool:
        match case:
            (value, phrase): "${value}" == phrase
    )


private pure func test_read_line_decoder() -> Bool:
    cases: List[(Int, ReadLineError)] = [
        (5, ReadLineError.IsADirectory),
        (-5, ReadLineError.OtherOs(5)),
        (-37, ReadLineError.OtherOs(37)),
        (0, ReadLineError.OtherOs(0)),
        (1, ReadLineError.OtherOs(-1)),
        (99, ReadLineError.OtherOs(-99)),
        (INT_MIN, ReadLineError.OtherOs(INT_MIN))
    ]

    decodes_all(decode_read_line_error, cases)


private pure func test_read_line_text() -> Bool:
    cases: List[(ReadLineError, String)] = [
        (ReadLineError.IsADirectory, "standard input is a directory"),
        (ReadLineError.OtherOs(37), "operating system error 37")
    ]

    texts_all(cases)


private pure func test_read_exact_decoder() -> Bool:
    cases: List[(Int, ReadExactError)] = [
        (5, ReadExactError.IsADirectory),
        (-5, ReadExactError.OtherOs(5)),
        (-37, ReadExactError.OtherOs(37)),
        (0, ReadExactError.OtherOs(0)),
        (1, ReadExactError.OtherOs(-1)),
        (99, ReadExactError.OtherOs(-99)),
        (INT_MIN, ReadExactError.OtherOs(INT_MIN))
    ]

    decodes_all(decode_read_exact_error, cases)


private pure func test_read_exact_text() -> Bool:
    cases: List[(ReadExactError, String)] = [
        (ReadExactError.EndedEarly(3), "input ended after 3 bytes"),
        (ReadExactError.IsADirectory, "standard input is a directory"),
        (ReadExactError.OtherOs(37), "operating system error 37")
    ]

    texts_all(cases)


TESTS: TestSuite = {
    description = "Exact console error decoding and text",
    tests = [
        ("read_line decoder maps each named code and wraps the rest", test_read_line_decoder),
        ("read_line errors have the fixed text of each variant", test_read_line_text),
        ("read_exact decoder maps each named code and wraps the rest", test_read_exact_decoder),
        ("read_exact errors have the fixed text of each variant", test_read_exact_text)
    ]
}
