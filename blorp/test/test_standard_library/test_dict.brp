import:
    bool: and
    dict as dict_ops
    int: INT_MAX, INT_MIN
    test: TestSuite


-- Every Flat shares one hash, so only equality tells the keys apart.
record Flat {
    id: Int,
}


implements Equatable for Flat:
    pure func equals(left: Self, right: Self) -> Bool:
        left.id == right.id


implements Hashable for Flat:
    pure func hash(value: Self) -> Int:
        7


-- The keys 0..count-1 set to ten times themselves.
private pure func counting(count: Int) -> dict_ops.Dict[Int, Int]:
    var dict: dict_ops.Dict[Int, Int] = dict_ops.empty()
    for key in 0..count:
        dict = dict_ops.set(dict, key, key * 10)
    dict


private pure func test_set_keeps_first_position_and_replaces_value() -> Bool:
    var dict: dict_ops.Dict[Int, Int] = dict_ops.empty()
    dict = dict_ops.set(dict, 5, 50)
    dict = dict_ops.set(dict, 1, 10)
    dict = dict_ops.set(dict, 9, 90)
    dict = dict_ops.set(dict, 1, 11)
    and(dict_ops.keys(dict) == [5, 1, 9], dict_ops.values(dict) == [50, 11, 90])


private pure func test_remove_then_set_goes_last() -> Bool:
    var dict = counting(4)
    dict = dict_ops.remove(dict, 1)
    first = dict_ops.keys(dict) == [0, 2, 3]
    dict = dict_ops.set(dict, 1, 99)
    and(first, and(dict_ops.keys(dict) == [0, 2, 3, 1], dict_ops.values(dict) == [0, 20, 30, 99]))


private pure func test_missing_key_reads_and_removes() -> Bool:
    dict = counting(3)
    removed = dict_ops.remove(dict, 42)
    and(
        and(dict_ops.get_or(dict, 42, -1) == -1, dict_ops.contains(dict, 42) == False),
        and(dict_ops.length(removed) == 3, dict_ops.keys(removed) == [0, 1, 2]),
    )


private pure func test_update_leaves_earlier_copy_unchanged() -> Bool:
    original = counting(3)
    changed = dict_ops.set(dict_ops.remove(original, 0), 7, 70)
    and(
        and(dict_ops.keys(original) == [0, 1, 2], dict_ops.length(original) == 3),
        dict_ops.keys(changed) == [1, 2, 7],
    )


private pure func test_growth_keeps_every_entry_in_order() -> Bool:
    dict = counting(300)
    var intact: Bool = dict_ops.length(dict) == 300
    for key in 0..300:
        intact = and(intact, dict_ops.get_or(dict, key, -1) == key * 10)
    and(intact, dict_ops.keys(dict).length() == 300)


private pure func test_removing_every_key_then_reusing_the_dict() -> Bool:
    var dict = counting(50)
    for key in 0..50:
        dict = dict_ops.remove(dict, key)
    emptied = and(dict_ops.length(dict) == 0, dict_ops.keys(dict).length() == 0)
    dict = dict_ops.set(dict, 7, 1)
    and(emptied, and(dict_ops.keys(dict) == [7], dict_ops.get_or(dict, 7, -1) == 1))


private pure func test_compaction_after_many_removals_keeps_survivors() -> Bool:
    var dict = counting(40)
    for key in 0..30:
        dict = dict_ops.remove(dict, key)
    var intact: Bool = dict_ops.length(dict) == 10
    for key in 30..40:
        intact = and(intact, dict_ops.get_or(dict, key, -1) == key * 10)
    and(intact, dict_ops.get_or(dict, 5, -1) == -1)


private pure func test_strides_of_1024_and_7_and_minimum_int() -> Bool:
    var dict: dict_ops.Dict[Int, Int] = dict_ops.empty()
    for i in 0..200:
        dict = dict_ops.set(dict, i * 1024, i)
    for i in 0..200:
        dict = dict_ops.set(dict, i * 7 + 1, -i)
    dict = dict_ops.set(dict, INT_MIN, 5)
    var intact: Bool = and(dict_ops.length(dict) == 401, dict_ops.get_or(dict, INT_MIN, 0) == 5)
    for i in 1..200:
        intact = and(intact, dict_ops.get_or(dict, i * 1024, -1) == i)
    intact


-- Correctness only: a lookup of an absent key ends. The cost of those lookups is
-- bounded by fixtures/dict/absent_sequential_keys.brp.
private pure func test_absent_sequential_keys_are_not_found() -> Bool:
    dict = counting(2000)
    var absent: Bool = True
    for key in 2000..4000:
        absent = and(absent, dict_ops.contains(dict, key) == False)
    absent


private pure func test_string_keys_keep_order_and_replace() -> Bool:
    var dict: dict_ops.Dict[String, Int] = dict_ops.empty()
    dict = dict_ops.set(dict, "beta", 2)
    dict = dict_ops.set(dict, "alpha", 1)
    dict = dict_ops.set(dict, "beta", 3)
    dict = dict_ops.remove(dict, "alpha")
    dict = dict_ops.set(dict, "alpha", 5)
    and(
        and(dict_ops.keys(dict) == ["beta", "alpha"], dict_ops.values(dict) == [3, 5]),
        dict_ops.get_or(dict, "absent", -1) == -1,
    )


private pure func test_colliding_keys_are_told_apart_by_equality() -> Bool:
    var dict: dict_ops.Dict[Flat, Int] = dict_ops.empty()
    for id in 0..40:
        dict = dict_ops.set(dict, { id = id }, id * 2)
    for id in 0..20:
        dict = dict_ops.remove(dict, { id = id * 2 })
    var intact: Bool = dict_ops.length(dict) == 20
    for id in 0..40:
        expected = if id % 2 == 0:
            -1
        else:
            id * 2
        intact = and(intact, dict_ops.get_or(dict, { id = id }, -1) == expected)
    intact


-- The keys `first`..`first + count - 1` in order, each set to ten times itself.
private pure func holds_run(dict: dict_ops.Dict[Int, Int], first: Int, count: Int) -> Bool:
    var intact: Bool = and(dict_ops.length(dict) == count, dict_ops.keys(dict).length() == count)
    var index = 0
    for key in dict_ops.keys(dict):
        intact = and(intact, and(key == first + index, dict_ops.get_or(dict, key, -1) == key * 10))
        index = index + 1
    and(intact, dict_ops.values(dict).length() == count)


-- Removes the oldest of 16 entries one by one across the compaction trigger and
-- checks the survivors, in order, after every removal. A rebuild is not visible
-- through keys, values or length; where it happens is pinned by the strict
-- allocation count of fixtures/dict/compaction_boundary.brp.
private pure func test_compaction_boundary_holds_survivors_at_every_step() -> Bool:
    var dict = counting(16)
    var intact: Bool = True
    for removed in 0..12:
        dict = dict_ops.remove(dict, removed)
        intact = and(intact, holds_run(dict, removed + 1, 15 - removed))
    intact


-- Fewer dead entries than MINIMUM_COMPACTION, however few survive, keep the
-- survivors; the e2e fixture above pins that none rebuilds.
private pure func test_removals_below_the_compaction_minimum_keep_survivors() -> Bool:
    var dict = counting(8)
    for removed in 0..7:
        dict = dict_ops.remove(dict, removed)
    and(holds_run(dict, 7, 1), dict_ops.get_or(dict, 3, -1) == -1)


-- Removing the oldest key and setting a new one, many times, keeps a sliding run.
private pure func test_churn_keeps_a_sliding_run() -> Bool:
    var dict = counting(10)
    for cycle in 0..500:
        dict = dict_ops.set(dict_ops.remove(dict, cycle), cycle + 10, (cycle + 10) * 10)
    holds_run(dict, 500, 10)


-- n sets after dict(n) leave the keys, values and lookups intact.
private pure func filled_after_capacity(count: Int) -> Bool:
    var dict: dict_ops.Dict[Int, Int] = dict_ops.dict(count)
    for key in 0..count:
        dict = dict_ops.set(dict, key, key * 10)
    holds_run(dict, 0, count)


private pure func test_dict_of_zero_five_and_forty_then_filling() -> Bool:
    and(filled_after_capacity(0), and(filled_after_capacity(5), filled_after_capacity(40)))


-- A request beyond what fits in an index is only a hint: the Dict still works.
private pure func test_dict_of_a_huge_or_negative_capacity_returns_a_working_dict() -> Bool:
    huge: dict_ops.Dict[Int, Int] = dict_ops.dict(INT_MAX)
    negative: dict_ops.Dict[Int, Int] = dict_ops.dict(INT_MIN)
    grown = dict_ops.set(dict_ops.set(huge, 3, 30), 4, 40)
    reused = dict_ops.set(negative, 1, 10)
    and(
        and(dict_ops.is_empty(huge), dict_ops.is_empty(negative)),
        and(dict_ops.keys(grown) == [3, 4], dict_ops.keys(reused) == [1]),
    )


private pure func test_is_empty_and_entries() -> Bool:
    var dict: dict_ops.Dict[String, Int] = dict_ops.empty()
    before = dict_ops.is_empty(dict)
    dict = dict_ops.set(dict_ops.set(dict_ops.set(dict, "b", 2), "a", 1), "c", 3)
    dict = dict_ops.set(dict_ops.remove(dict, "a"), "a", 9)
    in_order = match dict_ops.entries(dict):
        [(first, one), (second, two), (third, three)]:
            and(
                and(first == "b", one == 2),
                and(and(second == "c", two == 3), and(third == "a", three == 9)),
            )
        _:
            False
    and(and(before, dict_ops.is_empty(dict) == False), in_order)


private pure func test_bool_keys() -> Bool:
    var dict: dict_ops.Dict[Bool, String] = dict_ops.empty()
    dict = dict_ops.set(dict_ops.set(dict, True, "yes"), False, "no")
    dict = dict_ops.set(dict, True, "again")
    both: List[Bool] = [True, False]
    and(
        and(dict_ops.keys(dict) == both, dict_ops.get_or(dict, True, "") == "again"),
        dict_ops.get_or(dict_ops.remove(dict, False), False, "gone") == "gone",
    )


private pure func test_equality_ignores_order() -> Bool:
    forward = counting(30)
    var backward: dict_ops.Dict[Int, Int] = dict_ops.empty()
    for index in 0..30:
        backward = dict_ops.set(backward, 29 - index, (29 - index) * 10)
    and(forward == backward, dict_ops.keys(forward) != dict_ops.keys(backward))


private pure func test_equality_compares_values_keys_and_lengths() -> Bool:
    base = counting(5)
    other_value = dict_ops.set(base, 3, 0)
    other_key = dict_ops.set(dict_ops.remove(base, 3), 99, 30)
    shorter = dict_ops.remove(base, 4)
    longer = dict_ops.set(base, 5, 50)
    different = or_any([
        other_value == base,
        other_key == base,
        shorter == base,
        longer == base,
        base != base,
    ])
    and(different == False, base == counting(5))


-- A removed-and-restored key compares like one never removed.
private pure func test_equality_ignores_removal_history() -> Bool:
    var churned = counting(20)
    for key in 0..12:
        churned = dict_ops.set(dict_ops.remove(churned, key), key, key * 10)
    churned == counting(20)


-- combine_hash is (seed + value) * the FNV prime: each part changes the hash,
-- the order of the parts matters, and a sum past INT_MAX wraps.
private pure func test_combine_hash_mixes_parts_in_order() -> Bool:
    prime = 1099511628211
    swapped = (
        dict_ops.combine_hash(dict_ops.combine_hash(0, 2), 1)
        != dict_ops.combine_hash(dict_ops.combine_hash(0, 1), 2)
    )
    wraps = dict_ops.combine_hash(INT_MAX, 1) == INT_MIN * prime
    and(
        and(dict_ops.combine_hash(0, 0) == 0, dict_ops.combine_hash(1, 2) == 3 * prime),
        and(swapped, wraps),
    )


-- A List hash combines its elements in order from 0: order counts, the empty
-- List hashes to 0, and nesting hashes the inner Lists.
private pure func test_list_hash_depends_on_order_and_nesting() -> Bool:
    no_items: List[Int] = []
    ordered = [1, 2].hash() != [2, 1].hash()
    nested = [[1], [2]].hash() != [[2], [1]].hash()
    leading_zero = and([0].hash() != no_items.hash(), [0, 1].hash() != [1].hash())
    and(and(ordered, nested), and(leading_zero, [1].hash() != no_items.hash()))


private pure func test_list_keys_round_trip() -> Bool:
    no_items: List[Int] = []
    var dict: dict_ops.Dict[List[Int], Int] = dict_ops.empty()
    dict = dict_ops.set(dict, [1, 2], 10)
    dict = dict_ops.set(dict, [2, 1], 20)
    dict = dict_ops.set(dict, no_items, 30)
    var nested: dict_ops.Dict[List[List[Int]], Int] = dict_ops.empty()
    nested = dict_ops.set(nested, [[1], [2]], 40)
    nested = dict_ops.set(nested, [[2], [1]], 50)
    and(
        and(dict_ops.get(dict, [1, 2]) == Some(10), dict_ops.get(dict, [2, 1]) == Some(20)),
        and(
            and(dict_ops.get(dict, no_items) == Some(30), dict_ops.get(dict, [1]) == None),
            and(
                dict_ops.get(nested, [[1], [2]]) == Some(40),
                dict_ops.get(nested, [[2], [1]]) == Some(50),
            ),
        ),
    )


private pure func or_any(flags: List[Bool]) -> Bool:
    flags.any(pure func(flag: Bool): flag)


TESTS: TestSuite = {
    description = "Dict: order, removal, growth, collisions, equality and value semantics",
    tests = [
        (
            "set keeps the first position and replaces the value",
            test_set_keeps_first_position_and_replaces_value,
        ),
        ("remove then set goes last", test_remove_then_set_goes_last),
        ("a missing key reads as absent and removes nothing", test_missing_key_reads_and_removes),
        ("an update leaves an earlier copy unchanged", test_update_leaves_earlier_copy_unchanged),
        ("growth keeps every entry in order", test_growth_keeps_every_entry_in_order),
        ("removing every key then reusing the Dict", test_removing_every_key_then_reusing_the_dict),
        (
            "compaction after many removals keeps the survivors",
            test_compaction_after_many_removals_keeps_survivors,
        ),
        ("strides of 1024 and 7 and the minimum Int", test_strides_of_1024_and_7_and_minimum_int),
        ("absent sequential keys are not found", test_absent_sequential_keys_are_not_found),
        ("String keys keep order and replace", test_string_keys_keep_order_and_replace),
        (
            "colliding keys are told apart by equality",
            test_colliding_keys_are_told_apart_by_equality,
        ),
        (
            "the compaction boundary holds the survivors at every step",
            test_compaction_boundary_holds_survivors_at_every_step,
        ),
        (
            "removals below the compaction minimum keep the survivors",
            test_removals_below_the_compaction_minimum_keep_survivors,
        ),
        ("churn keeps a sliding run", test_churn_keeps_a_sliding_run),
        ("dict of 0, 5 and 40 then that many sets", test_dict_of_zero_five_and_forty_then_filling),
        (
            "dict of INT_MAX or INT_MIN returns a working Dict",
            test_dict_of_a_huge_or_negative_capacity_returns_a_working_dict,
        ),
        ("is_empty and entries follow insertion order", test_is_empty_and_entries),
        ("Bool keys", test_bool_keys),
        ("equality ignores order", test_equality_ignores_order),
        (
            "equality compares values, keys and lengths",
            test_equality_compares_values_keys_and_lengths,
        ),
        ("equality ignores removal history", test_equality_ignores_removal_history),
        ("combine_hash mixes parts in order and wraps", test_combine_hash_mixes_parts_in_order),
        ("a List hash depends on order and nesting", test_list_hash_depends_on_order_and_nesting),
        ("List keys round trip", test_list_keys_round_trip),
    ],
}
