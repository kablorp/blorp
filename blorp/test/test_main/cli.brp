-- The `blorp` command, run as a user runs it: exact stdout, stderr and status
-- for compile, format, lsp, help and bad usage, on files in the work directory.
import:
    bool: and, not
    bytes: Bytes, String methods, from_list
    io/files/write: WriteError, write_bytes
    io/process: Captured, FindProgramError, command, find_program
    json: Json(Text, Object), render
    option: Option methods
    path: Path, to_path
    result: Result methods
    test: TestSuite
    ../../src/common/cli/usage: EXIT_PATH, EXIT_REJECTED, EXIT_USAGE
    ../../src/lsp/server: EXIT_ABANDONED
    ../driver/file_access: read_file, write_file, make_directories
    ../driver/harness: COMPILATION_TIMEOUT_MS, LIBRARY_ROOT, isolated, reported, run_expecting


private FORMATTED: String = "func main() -> Int:\n    x = 1\n    x + 1\n"
-- Its third line is the first that differs from FORMATTED.
private UNFORMATTED: String = "func main() -> Int:\n    x = 1\n    x+1\n"
private UNPARSABLE: String = "func main( -> Int:\n    0\n"


private UNPARSABLE_DIAGNOSTIC: String = ":1:12: error: expected a parameter name or ')'\nhelp: use an ASCII identifier starting with a letter; keywords and lone '_' are reserved\n"


private SUITE_ONE: String = "import:\n    test: TestSuite\npure func test_first() -> Bool:\n    True\nTESTS: TestSuite = { description = \"first suite\", tests = [(\"passes\", test_first)] }\n"


private SUITE_TWO: String = "import:\n    test: TestSuite\npure func test_second() -> Bool:\n    True\nTESTS: TestSuite = { description = \"second suite\", tests = [(\"passes\", test_second)] }\n"


private OVERVIEW: String =
    |blorp compiles Blorp programs to C and formats Blorp source.
    |
    |usage: blorp COMMAND [ARGUMENT ...]
    |
    |commands:
    |  compile  write the C for a program
    |  format   put source files in the canonical layout
    |  lsp      serve the Language Server Protocol to an editor
    |  help     show this overview, or the help of one command
    |
    |run blorp help COMMAND for the options of a command
    |
    |exit status: 0 success; 1 the code needs fixing; 2 bad usage;
    |3 a path could not be read or written; 4 a fault in blorp (report it)


private FORMAT_HELP: String =
    |usage: blorp format [--check] [--exclude PATH]... [PATH ...]
    |
    |Puts .brp files in the canonical layout. Each PATH is a .brp file or a
    |directory, which is searched recursively; with no PATH it formats the current
    |directory. While searching, names that begin with a dot and symbolic links
    |are skipped; a PATH written on the command line is always used. A file that
    |does not parse is reported and left as it is, and the command exits with
    |status 1.
    |
    |options:
    |  --check         change nothing; list each file that would be reformatted
    |  --exclude PATH  skip a file, or a directory and everything below it;
    |                  repeat it for several paths
    |  -h, --help      show this help


private COMPILE_HELP: String =
    |usage: blorp compile INPUT.brp [-o OUTPUT.c] [--library-root DIRECTORY]
    |       blorp compile --test-suite SUITE.brp [SUITE.brp ...] -o OUTPUT.c [--library-root DIRECTORY]
    |
    |Writes the C for INPUT.brp and the modules it imports. Without -o the C goes
    |to the input's name with .c, in the current directory: blorp compile
    |src/main.brp writes ./main.c.
    |
    |options:
    |  -o OUTPUT.c              where to write the C (required with --test-suite)
    |  --library-root DIRECTORY use this standard library directory instead of the one
    |                           built into blorp
    |  --test-suite             compile the listed test suite files into one program
    |  -h, --help               show this help


private LSP_HELP: String =
    |usage: blorp lsp
    |
    |Serves the Language Server Protocol on standard input and output, for an
    |editor to start. Each open .brp file is the root of its own program: the
    |file, the modules it imports and the standard library.
    |
    |options:
    |  -h, --help  show this help


private HELP_HELP: String =
    |usage: blorp help [COMMAND]
    |
    |Shows the overview of blorp, or the options of one command.


private pure func expect(
    actual: String,
    expected: String,
    description: String
) -> Result[Void, String]:
    if actual.equals(expected):
        Ok(void)
    else:
        Err("${description}: expected [${expected}], got [${actual}]")


-- Runs the command with `arguments`, requiring `status`, and returns what it
-- printed. The child runs without the leak check, so its stderr is only what
-- a user sees.
private func run(
    compiler: String,
    arguments: List[String],
    name: String,
    status: Int
) -> Result[Captured, String]:
    invocation ?= isolated(compiler, arguments, COMPILATION_TIMEOUT_MS)
    run_expecting(name, invocation, status)


private pure func expect_output(
    output: Captured,
    stdout: String,
    stderr: String
) -> Result[Void, String]:
    _ ?= expect(output.stdout, stdout, "stdout")
    expect(output.stderr, stderr, "stderr")


private func written(path: String, contents: String) -> Result[Void, String]:
    write_file(path, contents)


private func contents_are(path: String, contents: String) -> Result[Void, String]:
    now ?= read_file(path)
    expect(now, contents, "${path} afterwards")


private pure func has_text(haystack: String, needle: String) -> Bool:
    var position = 0
    var found: Bool = False
    while position + needle.length() <= haystack.length():
        if haystack.slice(position, position + needle.length()) == Some(needle):
            found = True
            break
        position = position + 1
    found


-- A system tool found on PATH, such as ln or cp, for what no fs operation does.
private func tool(name: String, arguments: List[String], label: String) -> Result[Void, String]:
    program ?= find_program(name).map_err(
        pure func(error: FindProgramError) -> String: "${name}: ${error}"
    )
    _ ?= run_expecting(
        label,
        { command(program, arguments) | timeout_ms = Some(COMPILATION_TIMEOUT_MS) },
        0
    )
    Ok(void)


-- A symbolic link, which no fs operation can make.
private func linked(target: String, link: String, label: String) -> Result[Void, String]:
    tool("ln", ["-s", target, link], label)


-- Every file is unformatted, so a walk's visits are visible. In walk order:
--   a.brp  dir.brp/e.brp  sub/b.brp  subway/x.brp
-- and the rest are never visited: .hidden/c.brp is hidden, link.brp and linkdir
-- are symbolic links, and sub/note.txt is not a source file.
private func build_tree(root: String) -> Result[Void, String]:
    _ ?= make_directories("${root}/dir.brp")
    _ ?= make_directories("${root}/sub")
    _ ?= make_directories("${root}/subway")
    _ ?= make_directories("${root}/.hidden")
    _ ?= written("${root}/a.brp", UNFORMATTED)
    _ ?= written("${root}/dir.brp/e.brp", UNFORMATTED)
    _ ?= written("${root}/sub/b.brp", UNFORMATTED)
    _ ?= written("${root}/sub/note.txt", "not a source\n")
    _ ?= written("${root}/subway/x.brp", UNFORMATTED)
    _ ?= written("${root}/.hidden/c.brp", UNFORMATTED)
    _ ?= linked("a.brp", "${root}/link.brp", root + ".link_file")
    linked("sub", "${root}/linkdir", root + ".link_directory")


-- compile

private func compile_writes_the_c_named_by_o(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    prefix = "${work_directory}/cli_compile"
    source = prefix + ".brp"
    _ ?= written(source, FORMATTED)
    output ?= run(
        compiler,
        ["compile", source, "--library-root", LIBRARY_ROOT, "-o", prefix + ".c"],
        prefix,
        0
    )
    _ ?= expect_output(output, "", "")
    generated ?= read_file(prefix + ".c")
    if generated.length() > 0:
        Ok(void)
    else:
        Err("compile wrote an empty C file")


private func compile_names_a_missing_input_as_a_path_problem(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    prefix = "${work_directory}/cli_compile_missing"
    output ?= run(
        compiler,
        ["compile", prefix + ".brp", "--library-root", LIBRARY_ROOT, "-o", prefix + ".c"],
        prefix,
        EXIT_PATH
    )
    expect_output(
        output,
        "",
        "blorp: error: could not read module ${prefix}.brp: no such file\nhelp: check the path and provide a readable .brp file\n"
    )


private func compile_test_suite_takes_one_suite_and_then_two(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    first = "${work_directory}/cli_suite_first.brp"
    second = "${work_directory}/cli_suite_second.brp"
    _ ?= written(first, SUITE_ONE)
    _ ?= written(second, SUITE_TWO)
    one_c = "${work_directory}/cli_suite_one.c"
    two_c = "${work_directory}/cli_suite_two.c"
    prefix = "${work_directory}/cli_suite"
    one ?= run(
        compiler,
        ["compile", "--test-suite", first, "--library-root", LIBRARY_ROOT, "-o", one_c],
        prefix + "_one",
        0
    )
    _ ?= expect_output(one, "", "")
    two ?= run(
        compiler,
        ["compile", "--test-suite", first, second, "--library-root", LIBRARY_ROOT, "-o", two_c],
        prefix + "_two",
        0
    )
    _ ?= expect_output(two, "", "")
    one_text ?= read_file(one_c)
    two_text ?= read_file(two_c)
    -- The generated C labels each function with its module and name.
    if (
        one_text
            .has_text("cli_suite_first.test_first")
            .and(two_text.has_text("cli_suite_first.test_first"))
            .and(two_text.has_text("cli_suite_second.test_second"))
            .and(
                one_text
                    .has_text("cli_suite_second.test_second")
                    .not()
            )
    ):
        Ok(void)
    else:
        Err("the generated C does not hold exactly the listed suites")


-- Load owns the rule that each suite is listed once, for foundation inputs too.
private func compile_test_suite_names_a_suite_listed_twice(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    prefix = "${work_directory}/cli_suite_twice"
    suite_file = prefix + ".brp"
    _ ?= written(suite_file, SUITE_ONE)
    output ?= run(
        compiler,
        [
            "compile",
            "--test-suite",
            suite_file,
            suite_file,
            "--library-root",
            LIBRARY_ROOT,
            "-o",
            prefix + ".c"
        ],
        prefix,
        EXIT_REJECTED
    )
    expect_output(
        output,
        "",
        "blorp: error: test suite input ${suite_file} is already part of this compilation\nhelp: list each test suite file once; foundation inputs come from the standard library\n"
    )


-- The embedded library is the one on disk: the C is the same bytes.
private func compile_without_a_library_root_uses_the_embedded_library(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    prefix = "${work_directory}/cli_embedded"
    source = prefix + ".brp"
    _ ?= written(source, FORMATTED)
    embedded ?= run(
        compiler,
        ["compile", source, "-o", prefix + "_embedded.c"],
        prefix + "_embedded",
        0
    )
    _ ?= expect_output(embedded, "", "")
    on_disk ?= run(
        compiler,
        ["compile", source, "--library-root", LIBRARY_ROOT, "-o", prefix + "_disk.c"],
        prefix + "_disk",
        0
    )
    _ ?= expect_output(on_disk, "", "")
    embedded_c ?= read_file(prefix + "_embedded.c")
    disk_c ?= read_file(prefix + "_disk.c")
    if embedded_c.length() > 0:
        expect(embedded_c, disk_c, "C without --library-root")
    else:
        Err("compile wrote an empty C file")


-- A copy of the library with an unparsable list.brp: --library-root reads the
-- copy and fails there, while the embedded library, untouched, compiles.
private func a_library_root_wins_over_the_embedded_library(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    prefix = "${work_directory}/cli_override"
    copy = prefix + "_library"
    _ ?= tool("cp", ["-R", LIBRARY_ROOT, copy], prefix + "_copy")
    original ?= read_file("${copy}/list.brp")
    _ ?= written("${copy}/list.brp", original + "\nfunc broken( -> Int:\n")
    source = prefix + ".brp"
    _ ?= written(source, FORMATTED)
    overridden ?= run(
        compiler,
        ["compile", source, "--library-root", copy, "-o", prefix + "_copy.c"],
        prefix + "_copy_run",
        EXIT_REJECTED
    )
    _: Void ?= if overridden.stderr.has_text("${copy}/list.brp:"):
        Ok(void)
    else:
        Err("the changed copy was not read; stderr: ${overridden.stderr}")
    embedded ?= run(
        compiler,
        ["compile", source, "-o", prefix + "_embedded.c"],
        prefix + "_embedded",
        0
    )
    expect_output(embedded, "", "")


-- format on a file

private func check_reports_the_first_changed_line(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    path = "${work_directory}/cli_check_unformatted.brp"
    _ ?= written(path, UNFORMATTED)
    output ?= run(compiler, ["format", "--check", path], path, EXIT_REJECTED)
    _ ?= expect_output(output, "${path}:3: would reformat\n", "")
    contents_are(path, UNFORMATTED)


private func check_prints_the_parser_diagnostic(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    path = "${work_directory}/cli_check_unparsable.brp"
    _ ?= written(path, UNPARSABLE)
    output ?= run(compiler, ["format", "--check", path], path, EXIT_REJECTED)
    _ ?= expect_output(output, "", path + UNPARSABLE_DIAGNOSTIC)
    contents_are(path, UNPARSABLE)


private func check_accepts_a_formatted_file(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    path = "${work_directory}/cli_check_formatted.brp"
    _ ?= written(path, FORMATTED)
    output ?= run(compiler, ["format", "--check", path], path, 0)
    expect_output(output, "", "")


private func format_keeps_a_formatted_file(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    path = "${work_directory}/cli_format_formatted.brp"
    _ ?= written(path, FORMATTED)
    output ?= run(compiler, ["format", path], path, 0)
    _ ?= expect_output(output, "", "")
    contents_are(path, FORMATTED)


private func format_rewrites_an_unformatted_file(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    path = "${work_directory}/cli_format_unformatted.brp"
    _ ?= written(path, UNFORMATTED)
    output ?= run(compiler, ["format", path], path, 0)
    _ ?= expect_output(output, "", "")
    contents_are(path, FORMATTED)


private func format_reports_the_same_file_given_twice_once(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    path = "${work_directory}/cli_twice/a.brp"
    _ ?= make_directories("${work_directory}/cli_twice")
    _ ?= written(path, UNFORMATTED)
    output ?= run(
        compiler,
        [
            "format",
            "--check",
            path,
            "${work_directory}/cli_twice/./a.brp",
            "${work_directory}/cli_twice"
        ],
        path,
        EXIT_REJECTED
    )
    expect_output(output, "${path}:3: would reformat\n", "")


private func format_names_a_missing_path(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    path = "${work_directory}/cli_missing.brp"
    output ?= run(compiler, ["format", "--check", path], path, EXIT_PATH)
    expect_output(
        output,
        "",
        "blorp: error: could not read ${path}: no such file\nhelp: check that the path exists and can be read\n"
    )


private func format_rejects_a_file_that_is_not_a_source(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    path = "${work_directory}/cli_not_source.txt"
    _ ?= written(path, "text\n")
    output ?= run(compiler, ["format", path], path, EXIT_USAGE)
    expect_output(
        output,
        "",
        "blorp: error: `${path}` is not a .brp source file or a directory\nhelp: pass .brp files and directories to blorp format\n"
    )


-- format on a directory

private func format_walks_a_directory_in_place(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    root = "${work_directory}/cli_walk"
    _ ?= build_tree(root)
    output ?= run(compiler, ["format", root], root, 0)
    _ ?= expect_output(output, "", "")
    _ ?= contents_are("${root}/a.brp", FORMATTED)
    _ ?= contents_are("${root}/dir.brp/e.brp", FORMATTED)
    _ ?= contents_are("${root}/sub/b.brp", FORMATTED)
    _ ?= contents_are("${root}/subway/x.brp", FORMATTED)
    _ ?= contents_are("${root}/sub/note.txt", "not a source\n")
    contents_are("${root}/.hidden/c.brp", UNFORMATTED)


private func check_lists_a_walk_in_byte_order_and_skips_hidden_and_links(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    root = "${work_directory}/cli_walk_check"
    _ ?= build_tree(root)
    output ?= run(compiler, ["format", "--check", root], root, EXIT_REJECTED)
    expect_output(
        output,
        "${root}/a.brp:3: would reformat\n${root}/dir.brp/e.brp:3: would reformat\n${root}/sub/b.brp:3: would reformat\n${root}/subway/x.brp:3: would reformat\n",
        ""
    )


private func check_accepts_a_formatted_tree(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    root = "${work_directory}/cli_walk_formatted"
    _ ?= build_tree(root)
    _ ?= run(compiler, ["format", root], root + ".format", 0)
    output ?= run(compiler, ["format", "--check", root], root, 0)
    expect_output(output, "", "")


private func a_root_is_used_as_given_even_when_hidden_or_a_link(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    root = "${work_directory}/cli_walk_given"
    _ ?= build_tree(root)
    output ?= run(
        compiler,
        ["format", "--check", "${root}/.hidden", "${root}/link.brp"],
        root,
        EXIT_REJECTED
    )
    expect_output(
        output,
        "${root}/.hidden/c.brp:3: would reformat\n${root}/link.brp:3: would reformat\n",
        ""
    )


private func a_file_under_two_roots_is_visited_once_at_its_first_occurrence(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    root = "${work_directory}/cli_walk_twice"
    _ ?= build_tree(root)
    output ?= run(
        compiler,
        ["format", "--check", "${root}/sub/b.brp", root, "${root}/sub"],
        root,
        EXIT_REJECTED
    )
    expect_output(
        output,
        "${root}/sub/b.brp:3: would reformat\n${root}/a.brp:3: would reformat\n${root}/dir.brp/e.brp:3: would reformat\n${root}/subway/x.brp:3: would reformat\n",
        ""
    )


private func an_unparsable_file_in_a_walk_fails_and_the_others_are_still_formatted(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    root = "${work_directory}/cli_walk_unparsable"
    _ ?= make_directories(root)
    _ ?= written("${root}/a.brp", UNPARSABLE)
    _ ?= written("${root}/b.brp", UNFORMATTED)
    output ?= run(compiler, ["format", root], root, EXIT_REJECTED)
    _ ?= expect_output(output, "", "${root}/a.brp" + UNPARSABLE_DIAGNOSTIC)
    _ ?= contents_are("${root}/a.brp", UNPARSABLE)
    contents_are("${root}/b.brp", FORMATTED)


-- --exclude

private func exclude_removes_a_file(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    root = "${work_directory}/cli_exclude_file"
    _ ?= build_tree(root)
    output ?= run(compiler, ["format", "--exclude", "${root}/a.brp", root], root, 0)
    _ ?= expect_output(output, "", "")
    _ ?= contents_are("${root}/a.brp", UNFORMATTED)
    contents_are("${root}/sub/b.brp", FORMATTED)


-- sub is excluded with everything below it, and subway, which shares its
-- prefix, is not.
private func exclude_removes_a_directory_on_component_boundaries(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    root = "${work_directory}/cli_exclude_directory"
    _ ?= build_tree(root)
    output ?= run(compiler, ["format", "--exclude", "${root}/sub/", root], root, 0)
    _ ?= expect_output(output, "", "")
    _ ?= contents_are("${root}/sub/b.brp", UNFORMATTED)
    _ ?= contents_are("${root}/subway/x.brp", FORMATTED)
    contents_are("${root}/a.brp", FORMATTED)


private func exclude_may_repeat(compiler: String, work_directory: String) -> Result[Void, String]:
    root = "${work_directory}/cli_exclude_repeat"
    _ ?= build_tree(root)
    output ?= run(
        compiler,
        ["format", "--check", "--exclude", "${root}/a.brp", "--exclude", "${root}/sub", root],
        root,
        EXIT_REJECTED
    )
    expect_output(
        output,
        "${root}/dir.brp/e.brp:3: would reformat\n${root}/subway/x.brp:3: would reformat\n",
        ""
    )


private func exclude_names_a_path_that_does_not_exist(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    root = "${work_directory}/cli_exclude_missing"
    _ ?= build_tree(root)
    output ?= run(compiler, ["format", "--exclude", "${root}/nope.brp", root], root, EXIT_USAGE)
    _ ?= expect_output(
        output,
        "",
        "blorp: error: the excluded path `${root}/nope.brp` does not exist\nhelp: check the spelling of the path given to --exclude\n"
    )
    contents_are("${root}/a.brp", UNFORMATTED)


private func exclude_names_a_path_outside_the_roots(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    root = "${work_directory}/cli_exclude_outside"
    _ ?= build_tree(root)
    outside = "${work_directory}/cli_exclude_outside_file.brp"
    _ ?= written(outside, UNFORMATTED)
    output ?= run(compiler, ["format", "--exclude", outside, root], root, EXIT_USAGE)
    _ ?= expect_output(
        output,
        "",
        "blorp: error: the excluded path `${outside}` is not inside any path being formatted\nhelp: exclude a file or directory below one of the paths to format, or add a path that contains it\n"
    )
    contents_are("${root}/a.brp", UNFORMATTED)


-- With no PATH the root is the current directory, which `../x` is not inside.
private func exclude_outside_the_default_root_is_a_usage_error(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    output ?= run(
        compiler,
        ["format", "--check", "--exclude", "../x"],
        "${work_directory}/cli_exclude_default",
        EXIT_USAGE
    )
    expect_output(
        output,
        "",
        "blorp: error: the excluded path `../x` is not inside any path being formatted\nhelp: exclude a file or directory below one of the paths to format, or add a path that contains it\n"
    )


-- Containment is lexical: `../../x` is not under `..`, although the directory it
-- names may be, so the exclusion is refused. No file is visited first.
private func exclude_beyond_a_parent_root_is_a_usage_error(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    output ?= run(
        compiler,
        ["format", "--check", "--exclude", "../../x", ".."],
        "${work_directory}/cli_exclude_parent",
        EXIT_USAGE
    )
    expect_output(
        output,
        "",
        "blorp: error: the excluded path `../../x` is not inside any path being formatted\nhelp: exclude a file or directory below one of the paths to format, or add a path that contains it\n"
    )


-- lsp

-- One message as a client frames it: the body's UTF-8 byte count, then the body.
private pure func framed(body: String) -> String:
    "Content-Length: ${body.length()}\r\n\r\n${body}"


private LSP_INITIALIZE: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{\"general\":{\"positionEncodings\":[\"utf-8\"]}}}}"


private LSP_INITIALIZED_REPLY: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"capabilities\":{\"positionEncoding\":\"utf-8\",\"textDocumentSync\":{\"openClose\":true,\"change\":1},\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":[\"namespace\",\"type\",\"interface\",\"enumMember\",\"typeParameter\",\"parameter\",\"variable\",\"property\",\"function\",\"method\",\"keyword\",\"comment\",\"string\",\"number\",\"operator\"],\"tokenModifiers\":[\"declaration\",\"readonly\",\"defaultLibrary\",\"documentation\"]},\"full\":true},\"definitionProvider\":true,\"referencesProvider\":true}}}"


private LSP_EXIT: String = "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}"


private LSP_STOPPED_HELP: String = "help: start blorp lsp from a language client, which frames each message with a Content-Length header\n"


-- `blorp lsp` with `input` as standard input.
private func lsp_session(
    compiler: String,
    input: String,
    name: String,
    status: Int
) -> Result[Captured, String]:
    invocation ?= isolated(compiler, ["lsp"], COMPILATION_TIMEOUT_MS)
    run_expecting(name, { invocation | stdin = Some(input) }, status)


-- The editor opens a file whose name needs percent-encoding and whose string
-- literal holds a two-byte scalar, so the range counts UTF-8 bytes. The file
-- is not on disk: its text is the editor's snapshot, and it imports nothing.
private LSP_ROOT_URI: String = "file:///blorp%20lsp/caf%C3%A9.brp"


private func lsp_serves_a_session_from_initialize_to_exit(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    uri = LSP_ROOT_URI
    document = "{\"uri\":\"${uri}\",\"languageId\":\"blorp\",\"version\":1,\"text\":\"func main() -> Int:\\n    x: Int = \\\"é\\\"\\n    x\\n\"}"
    input = [
        LSP_INITIALIZE,
        "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}",
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\",\"params\":{}}",
        "{x}",
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":${document}}}",
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"${uri}\",\"version\":2},\"contentChanges\":[{\"text\":\"func main() -> Int:\\n    0\\n\"}]}}",
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"${uri}\"}}}",
        "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"shutdown\"}",
        LSP_EXIT
    ]
    expected = [
        LSP_INITIALIZED_REPLY,
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"error\":{\"code\":-32601,\"message\":\"unknown method `textDocument/hover`\"}}",
        "{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-32700,\"message\":\"the message body is not JSON: expected a quoted object name\"}}",
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"${uri}\",\"diagnostics\":[{\"range\":{\"start\":{\"line\":1,\"character\":13},\"end\":{\"line\":1,\"character\":17}},\"severity\":1,\"message\":\"expression does not match the expected type\\nhelp: use an expression of type Int here\"}]}}",
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"${uri}\",\"diagnostics\":[]}}",
        "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":null}"
    ]
    output ?= lsp_session(
        compiler,
        input
            .map(framed)
            .join(""),
        "${work_directory}/cli_lsp_session",
        0
    )
    expect_output(
        output,
        expected
            .map(framed)
            .join(""),
        ""
    )


-- The editor opens a file whose constant is not an Int and asks for its
-- tokens: only the lexer's `=` and `1.5`. It fixes the constant and asks again;
-- the edit is analysed then, which clears the diagnostic, and the answer
-- colours `ONE` as a read-only variable's declaration and `Int` as a library
-- type.
private func lsp_refreshes_tokens_and_diagnostics_after_an_edit(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    uri = "file:///work/one.brp"
    document = "{\"uri\":\"${uri}\",\"languageId\":\"blorp\",\"version\":1,\"text\":\"ONE: Int = 1.5\"}"
    tokens = pure func(id: Int) -> String:
        "{\"jsonrpc\":\"2.0\",\"id\":${id},\"method\":\"textDocument/semanticTokens/full\",\"params\":{\"textDocument\":{\"uri\":\"${uri}\"}}}"
    published = pure func(diagnostics: String) -> String:
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"${uri}\",\"diagnostics\":[${diagnostics}]}}"
    input = [
        LSP_INITIALIZE,
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":${document}}}",
        tokens(2),
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"${uri}\",\"version\":2},\"contentChanges\":[{\"text\":\"ONE: Int = 1\"}]}}",
        tokens(3),
        "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"shutdown\"}",
        LSP_EXIT
    ]
    expected = [
        LSP_INITIALIZED_REPLY,
        published(
            "{\"range\":{\"start\":{\"line\":0,\"character\":11},\"end\":{\"line\":0,\"character\":14}},\"severity\":1,\"message\":\"expression does not match the expected type\\nhelp: use an expression of type Int here\"}"
        ),
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"data\":[0,9,1,14,0,0,2,3,13,0]}}",
        published(""),
        "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"data\":[0,0,3,6,3,0,5,3,1,4,0,4,1,14,0,0,2,1,13,0]}}",
        "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":null}"
    ]
    output ?= lsp_session(
        compiler,
        input
            .map(framed)
            .join(""),
        "${work_directory}/cli_lsp_tokens",
        0
    )
    expect_output(
        output,
        expected
            .map(framed)
            .join(""),
        ""
    )


-- The line, counted from 0, of the library's io/console/output.brp that
-- declares `print`.
private func print_declaration_line() -> Result[Int, String]:
    text ?= read_file("${LIBRARY_ROOT}/io/console/output.brp")
    var found: Option[Int] = None
    var line = 0
    for text_line in text.lines():
        if and(found.is_none(), text_line.starts_with("func print(")):
            found = Some(line)
        line = line + 1
    match found:
        Some(declared): Ok(declared)
        None: Err("the library declares no `func print(`")


private pure func lsp_location(uri: String, line: Int, start: Int, end: Int) -> String:
    "{\"uri\":\"${uri}\",\"range\":{\"start\":{\"line\":${line},\"character\":${start}},\"end\":{\"line\":${line},\"character\":${end}}}}"


-- The editor opens a program that checks, then edits it so that it does not:
-- a line inserted between a call and the call below it. The failed file is
-- served from the last analysis that checked: the names off the edited line
-- keep their classes, and both calls reach `helper`, now one line lower. A
-- position on the edited line gets `null`.
private func lsp_serves_a_failed_file_from_its_last_checked_analysis(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    uri = "file:///work/broken.brp"
    program = "func main() -> Int:\\n    a = helper(1)\\n    print(\\\"hi\\\")\\n"
    declaration = "\\n\\nfunc helper(value: Int) -> Int:\\n    value * 2\\n"
    opened = "${program}    a + helper(2)${declaration}"
    edited = "${program}    x: Int = \\\"nothing here checks\\\"\\n    a + helper(2)${declaration}"
    tokens = pure func(id: Int) -> String:
        "{\"jsonrpc\":\"2.0\",\"id\":${id},\"method\":\"textDocument/semanticTokens/full\",\"params\":{\"textDocument\":{\"uri\":\"${uri}\"}}}"
    definition = pure func(id: Int, line: Int, character: Int) -> String:
        "{\"jsonrpc\":\"2.0\",\"id\":${id},\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"${uri}\"},\"position\":{\"line\":${line},\"character\":${character}}}}"
    input = [
        LSP_INITIALIZE,
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"${uri}\",\"languageId\":\"blorp\",\"version\":1,\"text\":\"${opened}\"}}}",
        tokens(2),
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"${uri}\",\"version\":2},\"contentChanges\":[{\"text\":\"${edited}\"}]}}",
        tokens(3),
        definition(4, 1, 9),
        definition(5, 4, 9),
        definition(6, 3, 10),
        "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"shutdown\"}",
        LSP_EXIT
    ]
    helper = lsp_location(uri, 6, 5, 11)
    expected = [
        LSP_INITIALIZED_REPLY,
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"data\":[0,0,4,10,0,0,5,4,8,1,0,7,2,14,0,0,3,3,1,4,1,4,1,6,3,0,2,1,14,0,0,2,6,8,0,0,7,1,13,0,1,4,5,8,4,0,6,4,12,0,1,4,1,6,2,0,2,1,14,0,0,2,6,8,0,0,7,1,13,0,2,0,4,10,0,0,5,6,8,1,0,7,5,5,3,0,7,3,1,4,0,5,2,14,0,0,3,3,1,4,1,4,5,5,2,0,6,1,14,0,0,2,1,13,0]}}",
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"${uri}\",\"diagnostics\":[{\"range\":{\"start\":{\"line\":3,\"character\":13},\"end\":{\"line\":3,\"character\":34}},\"severity\":1,\"message\":\"expression does not match the expected type\\nhelp: use an expression of type Int here\"}]}}",
        "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"data\":[0,0,4,10,0,0,5,4,8,1,0,7,2,14,0,0,3,3,1,4,1,4,1,6,3,0,2,1,14,0,0,2,6,8,0,0,7,1,13,0,1,4,5,8,4,0,6,4,12,0,1,11,1,14,0,0,2,21,12,0,1,4,1,6,2,0,2,1,14,0,0,2,6,8,0,0,7,1,13,0,2,0,4,10,0,0,5,6,8,1,0,7,5,5,3,0,7,3,1,4,0,5,2,14,0,0,3,3,1,4,1,4,5,5,2,0,6,1,14,0,0,2,1,13,0]}}",
        "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":${helper}}",
        "{\"jsonrpc\":\"2.0\",\"id\":5,\"result\":${helper}}",
        "{\"jsonrpc\":\"2.0\",\"id\":6,\"result\":null}",
        "{\"jsonrpc\":\"2.0\",\"id\":7,\"result\":null}"
    ]
    output ?= lsp_session(
        compiler,
        input
            .map(framed)
            .join(""),
        "${work_directory}/cli_lsp_broken",
        0
    )
    expect_output(
        output,
        expected
            .map(framed)
            .join(""),
        ""
    )


-- A client with LSP 3.18's `workspace.textDocumentContent`, which the server
-- answers by offering the `blorp-library` scheme.
private LSP_INITIALIZE_FETCHING: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{\"general\":{\"positionEncodings\":[\"utf-8\"]},\"workspace\":{\"textDocumentContent\":{}}}}}"


private LSP_FETCHING_REPLY: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"capabilities\":{\"positionEncoding\":\"utf-8\",\"textDocumentSync\":{\"openClose\":true,\"change\":1},\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":[\"namespace\",\"type\",\"interface\",\"enumMember\",\"typeParameter\",\"parameter\",\"variable\",\"property\",\"function\",\"method\",\"keyword\",\"comment\",\"string\",\"number\",\"operator\"],\"tokenModifiers\":[\"declaration\",\"readonly\",\"defaultLibrary\",\"documentation\"]},\"full\":true},\"definitionProvider\":true,\"referencesProvider\":true,\"workspace\":{\"textDocumentContent\":{\"schemes\":[\"blorp-library\"]}}}}}"


-- The editor goes to the definition of a local call, then of `print`, which
-- is a `blorp-library:` location whose text the editor fetches from the
-- server, and lists the references to a parameter with and without its
-- declaration. Shutdown replies at once and `exit` ends with status 0.
private func lsp_goes_to_definitions_in_the_library_and_lists_references(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    uri = "file:///work/navigate.brp"
    document = "{\"uri\":\"${uri}\",\"languageId\":\"blorp\",\"version\":1,\"text\":\"func twice(value: Int) -> Int:\\n    value * 2\\n\\n\\nfunc main() -> Int:\\n    print(\\\"hi\\\")\\n    twice(1)\\n\"}"
    at = pure func(line: Int, character: Int) -> String:
        "\"textDocument\":{\"uri\":\"${uri}\"},\"position\":{\"line\":${line},\"character\":${character}}"
    library_path = "io/console/output.brp"
    library_uri = "blorp-library:///${library_path}"
    input = [
        LSP_INITIALIZE_FETCHING,
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":${document}}}",
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/definition\",\"params\":{${at(6, 6)}}}",
        "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/definition\",\"params\":{${at(5, 6)}}}",
        "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"textDocument/references\",\"params\":{${at(1, 6)},\"context\":{\"includeDeclaration\":true}}}",
        "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"textDocument/references\",\"params\":{${at(0, 13)},\"context\":{\"includeDeclaration\":false}}}",
        "{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"workspace/textDocumentContent\",\"params\":{\"uri\":\"${library_uri}\"}}",
        "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"shutdown\"}",
        LSP_EXIT
    ]
    output ?= lsp_session(
        compiler,
        input
            .map(framed)
            .join(""),
        "${work_directory}/cli_lsp_navigation",
        0
    )
    line ?= print_declaration_line()
    library_text ?= read_file("${LIBRARY_ROOT}/${library_path}")
    content = render(Object({ "text" => Text(library_text) }))
    declaration = lsp_location(uri, 0, 11, 16)
    use = lsp_location(uri, 1, 4, 9)
    expected = [
        LSP_FETCHING_REPLY,
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":${lsp_location(uri, 0, 5, 10)}}",
        "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":${lsp_location(library_uri, line, 5, 10)}}",
        "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":[${declaration},${use}]}",
        "{\"jsonrpc\":\"2.0\",\"id\":5,\"result\":[${use}]}",
        "{\"jsonrpc\":\"2.0\",\"id\":6,\"result\":${content}}",
        "{\"jsonrpc\":\"2.0\",\"id\":7,\"result\":null}"
    ]
    expect_output(
        output,
        expected
            .map(framed)
            .join(""),
        ""
    )


-- Input that ends after `shutdown` still gets the reply, and the status is
-- the one for ending without `exit`.
private func lsp_answers_shutdown_then_exits_1_when_input_ends(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    output ?= lsp_session(
        compiler,
        framed(LSP_INITIALIZE) + framed("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\"}"),
        "${work_directory}/cli_lsp_shutdown_end",
        EXIT_ABANDONED
    )
    expect_output(
        output,
        framed(LSP_INITIALIZED_REPLY) + framed("{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":null}"),
        ""
    )


private func lsp_exit_without_shutdown_exits_1(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    output ?= lsp_session(
        compiler,
        framed(LSP_INITIALIZE) + framed(LSP_EXIT),
        "${work_directory}/cli_lsp_exit",
        EXIT_ABANDONED
    )
    expect_output(output, framed(LSP_INITIALIZED_REPLY), "")


private func lsp_exits_1_when_input_ends_between_messages(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    output ?= lsp_session(
        compiler,
        framed(LSP_INITIALIZE),
        "${work_directory}/cli_lsp_end",
        EXIT_ABANDONED
    )
    expect_output(output, framed(LSP_INITIALIZED_REPLY), "")


private func lsp_exits_1_when_input_ends_inside_a_header(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    output ?= lsp_session(
        compiler,
        framed(LSP_INITIALIZE) + "Content-Length: 5\r\n",
        "${work_directory}/cli_lsp_header",
        EXIT_ABANDONED
    )
    expect_output(
        output,
        framed(LSP_INITIALIZED_REPLY),
        "blorp: error: blorp lsp stopped: input ended inside a message header\n" + LSP_STOPPED_HELP
    )


-- Process stdin is a String, so bytes that are not UTF-8 go through a file the
-- shell redirects. Input then ends inside a body: the server says why on
-- stderr and exits 1.
private func lsp_answers_a_body_that_is_not_utf8_and_stops_inside_a_body(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    prefix = "${work_directory}/cli_lsp_bytes"
    -- The second body is two bytes that are not UTF-8; the third stops short.
    input: Bytes = (
        framed(LSP_INITIALIZE).to_bytes()
        + "Content-Length: 2\r\n\r\n".to_bytes()
        + from_list([255, 254])
        + "Content-Length: 10\r\n\r\n{}".to_bytes()
    )
    input_path: Path ?= "${prefix}.in"
        .to_path()
        .map_err(pure func(error) -> String: "${prefix}.in: ${error}")
    _ ?= input_path
        .write_bytes(input)
        .map_err(pure func(error: WriteError) -> String: "${input_path}: ${error}")
    shell ?= find_program("sh").map_err(
        pure func(error: FindProgramError) -> String: "sh: ${error}"
    )
    invocation ?= isolated(
        "${shell}",
        ["-c", "exec \"$0\" lsp < \"$1\"", compiler, "${input_path}"],
        COMPILATION_TIMEOUT_MS
    )
    output ?= run_expecting(prefix, invocation, EXIT_ABANDONED)
    not_utf8 = "{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-32700,\"message\":\"the message body is not UTF-8\"}}"
    stopped = "blorp: error: blorp lsp stopped: could not read a message body: input ended after 2 bytes\n"
    expect_output(
        output,
        framed(LSP_INITIALIZED_REPLY) + framed(not_utf8),
        stopped + LSP_STOPPED_HELP
    )


private func help_lsp_prints_its_help(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    output ?= run(compiler, ["help", "lsp"], "${work_directory}/cli_help_lsp", 0)
    expect_output(output, LSP_HELP + "\n", "")


-- help and usage

private func help_prints_the_overview_to_stdout(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    prefix = "${work_directory}/cli_help"
    output ?= run(compiler, ["help"], prefix, 0)
    _ ?= expect_output(output, OVERVIEW + "\n", "")
    flag ?= run(compiler, ["-h"], prefix + "_flag", 0)
    expect_output(flag, OVERVIEW + "\n", "")


private func help_format_and_the_flag_print_the_command_help(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    prefix = "${work_directory}/cli_help_format"
    output ?= run(compiler, ["help", "format"], prefix, 0)
    _ ?= expect_output(output, FORMAT_HELP + "\n", "")
    compile_help ?= run(compiler, ["help", "compile"], prefix + "_compile", 0)
    _ ?= expect_output(compile_help, COMPILE_HELP + "\n", "")
    help_help ?= run(compiler, ["help", "help"], prefix + "_help", 0)
    _ ?= expect_output(help_help, HELP_HELP + "\n", "")
    flag ?= run(compiler, ["format", "--check", "--help"], prefix + "_flag", 0)
    expect_output(flag, FORMAT_HELP + "\n", "")


private func no_command_prints_the_overview_to_stderr(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    output ?= run(compiler, [], "${work_directory}/cli_no_command", EXIT_USAGE)
    expect_output(output, "", OVERVIEW + "\n")


private func an_unknown_command_is_named(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    output ?= run(compiler, ["frobnicate"], "${work_directory}/cli_unknown", EXIT_USAGE)
    expect_output(
        output,
        "",
        "blorp: error: unknown command `frobnicate`\nhelp: run blorp help to list the commands\n"
    )


private func an_unknown_option_is_named(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    output ?= run(compiler, ["format", "--bogus"], "${work_directory}/cli_option", EXIT_USAGE)
    expect_output(
        output,
        "",
        "blorp: error: unknown option `--bogus` for blorp format\nhelp: run blorp help format to list its options\n"
    )


private func an_empty_format_path_is_a_usage_error(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    output ?= run(compiler, ["format", ""], "${work_directory}/cli_empty_format", EXIT_USAGE)
    expect_output(output, "", "blorp: error: a path cannot be empty\nhelp: write a nonempty path\n")


private func an_empty_compile_output_is_a_usage_error(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    output ?= run(
        compiler,
        ["compile", "blorp/test/test_compile/fixtures/return/zero.brp", "-o", ""],
        "${work_directory}/cli_empty_output",
        EXIT_USAGE
    )
    expect_output(output, "", "blorp: error: a path cannot be empty\nhelp: write a nonempty path\n")


private func an_empty_compile_input_is_a_usage_error(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    output ?= run(compiler, ["compile", ""], "${work_directory}/cli_empty_input", EXIT_USAGE)
    expect_output(output, "", "blorp: error: a path cannot be empty\nhelp: write a nonempty path\n")


func suite(compiler: String, work_directory: String) -> TestSuite:
    {
        description = "The blorp command",
        tests = [
            (
                "compile writes the C named by -o",
                func(): reported(compile_writes_the_c_named_by_o(compiler, work_directory))
            ),
            (
                "compile names a missing input as a path problem",
                func(): reported(
                    compile_names_a_missing_input_as_a_path_problem(compiler, work_directory)
                )
            ),
            (
                "compile --test-suite takes one suite and then two",
                func(): reported(
                    compile_test_suite_takes_one_suite_and_then_two(compiler, work_directory)
                )
            ),
            (
                "compile --test-suite names a suite listed twice",
                func(): reported(
                    compile_test_suite_names_a_suite_listed_twice(compiler, work_directory)
                )
            ),
            (
                "compile without a library root uses the embedded library",
                func(): reported(
                    compile_without_a_library_root_uses_the_embedded_library(
                        compiler,
                        work_directory
                    )
                )
            ),
            (
                "a library root wins over the embedded library",
