import:
	channel:
		SendAttempt(SendAccepted, SendSealed, SendTimedOut, SendWouldBlock),
		RecvAttempt(RecvValue),
		send_timeout_attempt,
		try_send_attempt,
		try_recv_attempt,
	test: TestSuite


func payload(label: String) -> String:
	label + "-payload"


func test_channel_failed_send_string() -> Bool:
	ch: Channel[String] = channel(1)
	_ = send(ch, payload("stored"))

	try_full_ok: Bool = not try_send(ch, payload("try-full"))
	attempt_full: SendAttempt = try_send_attempt(ch, payload("attempt-full"))

	attempt_full_ok: Bool = match attempt_full:
		SendWouldBlock:
			True
		_:
			False

	timeout_full_ok: Bool = not send_timeout(ch, payload("timeout-full"), 0)
	timeout_attempt_full: SendAttempt = send_timeout_attempt(ch, payload("timeout-attempt-full"), 0)

	timeout_attempt_full_ok: Bool = match timeout_attempt_full:
		SendTimedOut:
			True
		_:
			False

	seal(ch)
	send_sealed_ok: Bool = not send(ch, payload("send-sealed"))
	try_sealed_ok: Bool = not try_send(ch, payload("try-sealed"))
	attempt_sealed: SendAttempt = try_send_attempt(ch, payload("attempt-sealed"))

	attempt_sealed_ok: Bool = match attempt_sealed:
		SendSealed:
			True
		_:
			False

	timeout_sealed_ok: Bool = not send_timeout(ch, payload("timeout-sealed"), 1)
	timeout_attempt_sealed: SendAttempt = send_timeout_attempt(
		ch,
		payload("timeout-attempt-sealed"),
		1,
	)

	timeout_attempt_sealed_ok: Bool = match timeout_attempt_sealed:
		SendSealed:
			True
		_:
			False

	(
		try_full_ok
		and attempt_full_ok
		and timeout_full_ok
		and timeout_attempt_full_ok
		and send_sealed_ok
		and try_sealed_ok
		and attempt_sealed_ok
		and timeout_sealed_ok
		and timeout_attempt_sealed_ok
	)


func test_channel_scalar_send_status_and_receive_string_ownership() -> Bool:
	-- The native receive prevents constant folding of the payload factories.
	seed: Channel[String] = channel(1)
	_ = send(seed, "runtime-seed")
	runtime_label = recv(seed).get_or("missing-seed")
	ch: Channel[String] = channel(1)
	accepted = try_send_attempt(ch, payload(runtime_label))
	would_block = try_send_attempt(ch, payload(runtime_label + "-would-block"))
	timed_out = send_timeout_attempt(ch, payload(runtime_label + "-timed-out"), 0)
	value_ok = match try_recv_attempt(ch):
		RecvValue(value):
			value == "runtime-seed-payload"
		_:
			False
	accepted_timeout = send_timeout_attempt(ch, payload(runtime_label + "-accepted-timeout"), 0)
	seal(ch)
	sealed_try = try_send_attempt(ch, payload(runtime_label + "-sealed-try"))
	sealed_timeout = send_timeout_attempt(ch, payload(runtime_label + "-sealed-timeout"), 0)
	(
		accepted == SendAccepted
		and would_block == SendWouldBlock
		and timed_out == SendTimedOut
		and value_ok
		and accepted_timeout == SendAccepted
		and sealed_try == SendSealed
		and sealed_timeout == SendSealed
	)


tests: TestSuite = {
	description = "Channel Failed Send (String)",
	tests = [
		("channel failed send string", test_channel_failed_send_string),
		("scalar channel status and receive String ownership", test_channel_scalar_send_status_and_receive_string_ownership),
	]
}
