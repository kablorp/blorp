import:
	memory: refcount
	result: Result(Ok, Err)
	test: TestSuite


record Counter {
	value: Int
}


record CounterBox {
	counter: Counter,
	text: String
}


union GlobalPayload:
	WithCounter(Counter)
	WithText(String)


record PayloadBox {
	label: String,
	payload: GlobalPayload
}


ZERO_COUNTER: Counter = {value = 0}

NESTED_COUNTER: CounterBox = {
	counter = {value = 3},
	text = "nested"
}

TUPLE_COUNTER: (Counter, String) = ({value = 5}, "tuple")

UNION_COUNTER: GlobalPayload = WithCounter({value = 11})

DEFAULT_COUNTER_RESULT: Result[CounterBox, String] = Ok({
	counter = {value = 7},
	text = "result",
})

GLOBAL_NAMES: List[String] = ["alpha", "beta"]

GLOBAL_COUNTERS: List[Counter] = [{value = 13}, {value = 21}]

GLOBAL_NAME_SUFFIXES: Dict[String, String] = {"Ada" => "Lovelace", "Grace" => "Hopper"}

LOOP_BODY_UPDATE_PAYLOAD: GlobalPayload = WithText("loop")

RANGE_BODY_RECORD_PAYLOAD: GlobalPayload = WithText("loop")

LOOP_ITERABLE_UPDATE_PAYLOAD: GlobalPayload = WithText("loop")

LOOP_ITERATIONS: Int = 3


pure func counter_value(counter: Counter) -> Int:
	counter.value


pure func returned_zero() -> Counter:
	ZERO_COUNTER


pure func add_counter(left: Counter, right: Counter) -> Counter:
	{value = left.value + right.value}


pure func result_or_default(result: Result[CounterBox, String]) -> CounterBox:
	match result:
		Ok(counter_box):
			counter_box
		Err(_):
			{
				counter = {value = -1},
				text = "err"
			}


func test_direct_global_constant_argument_is_retained() -> Bool:
	first: Int = counter_value(ZERO_COUNTER)
	second: Int = counter_value(ZERO_COUNTER)
	first == 0 and second == 0


func test_returned_global_constant_is_retained() -> Bool:
	first: Int = counter_value(returned_zero())
	second: Int = counter_value(returned_zero())
	first == 0 and second == 0


func test_returned_global_constant_survives_accumulator_consume() -> Bool:
	var total: Counter = returned_zero()
	total = add_counter(total, {value = 1})
	again: Counter = returned_zero()
	total = add_counter(total, again)
	total.value == 1


func test_nested_record_global_constant_is_retained() -> Bool:
	first: Counter = NESTED_COUNTER.counter
	second_text: String = NESTED_COUNTER.text + "!"
	first.value == 3 and second_text == "nested!"


func test_tuple_global_constant_elements_are_retained() -> Bool:
	first: Counter = TUPLE_COUNTER[0]
	second: String = TUPLE_COUNTER[1] + "!"
	first.value == 5 and second == "tuple!"


func test_union_global_constant_payload_is_retained() -> Bool:
	first: Int = match UNION_COUNTER:
		WithCounter(counter):
			counter.value
		WithText(_):
			-1

	second: Int = match UNION_COUNTER:
		WithCounter(counter):
			counter.value
		WithText(_):
			-1

	first == 11 and second == 11


func test_stack_result_global_constant_payload_is_retained() -> Bool:
	first: CounterBox = result_or_default(DEFAULT_COUNTER_RESULT)
	second: CounterBox = result_or_default(DEFAULT_COUNTER_RESULT)
	first.counter.value == 7 and first.text == "result" and second.counter.value == 7


func test_list_string_global_elements_are_retained() -> Bool:
	first: String = GLOBAL_NAMES.get_or(0, "")
	second: String = GLOBAL_NAMES.get_or(1, "")
	extended: List[String] = GLOBAL_NAMES.append("gamma")
	first == "alpha" and second == "beta" and GLOBAL_NAMES.length() == 2 and extended.length() == 3


func test_list_record_global_elements_are_retained() -> Bool:
	first: Counter = GLOBAL_COUNTERS.get_or(0, {value = -1})
	second: Counter = GLOBAL_COUNTERS.get_or(1, {value = -1})
	extended: List[Counter] = GLOBAL_COUNTERS.append({value = 34})

	(
		first.value == 13
		and second.value == 21
		and GLOBAL_COUNTERS.length() == 2
		and extended.length() == 3
	)


func test_dict_string_global_entries_are_retained() -> Bool:
	ada: String = GLOBAL_NAME_SUFFIXES.get_or("Ada", "")
	grace: String = GLOBAL_NAME_SUFFIXES.get_or("Grace", "")
	extended: Dict[String, String] = GLOBAL_NAME_SUFFIXES.set("Katherine", "Johnson")

	(
		ada == "Lovelace"
		and grace == "Hopper"
		and GLOBAL_NAME_SUFFIXES.get_or("Katherine", "") == ""
		and extended.get_or("Katherine", "") == "Johnson"
	)


-- A loop that stores a managed global in a new aggregate must retain it once per
-- stored copy; releasing that aggregate otherwise frees the global. Each test
-- owns its global, and the extra holders keep an over-released global alive
-- long enough for its count to be compared.
private pure func payload_holders(payload: GlobalPayload) -> List[GlobalPayload]:
	[payload, payload, payload, payload]


func test_global_stored_by_record_update_in_list_loop_body_is_retained() -> Bool:
	holders: List[GlobalPayload] = payload_holders(LOOP_BODY_UPDATE_PAYLOAD)
	before: Int = refcount(LOOP_BODY_UPDATE_PAYLOAD)
	base: PayloadBox = {label = "base", payload = WithText("base")}
	var total: Int = 0

	for index in [1, 2, 3]:
		stored: PayloadBox = { base | payload = LOOP_BODY_UPDATE_PAYLOAD }
		total += stored.label.length() + index

	refcount(LOOP_BODY_UPDATE_PAYLOAD) == before and total == 18 and holders.length() == 4


func test_global_stored_in_record_in_range_loop_body_is_retained() -> Bool:
	holders: List[GlobalPayload] = payload_holders(RANGE_BODY_RECORD_PAYLOAD)
	before: Int = refcount(RANGE_BODY_RECORD_PAYLOAD)
	var total: Int = 0

	for _ in 0..LOOP_ITERATIONS:
		stored: PayloadBox = {label = "range", payload = RANGE_BODY_RECORD_PAYLOAD}
		total += stored.label.length()

	refcount(RANGE_BODY_RECORD_PAYLOAD) == before and total == 15 and holders.length() == 4


func test_global_stored_by_record_update_in_loop_iterable_is_retained() -> Bool:
	holders: List[GlobalPayload] = payload_holders(LOOP_ITERABLE_UPDATE_PAYLOAD)
	before: Int = refcount(LOOP_ITERABLE_UPDATE_PAYLOAD)
	base: PayloadBox = {label = "base", payload = WithText("base")}
	var total: Int = 0

	for stored in [{ base | payload = LOOP_ITERABLE_UPDATE_PAYLOAD }, { base | label = "local" }]:
		total += stored.label.length()

	refcount(LOOP_ITERABLE_UPDATE_PAYLOAD) == before and total == 9 and holders.length() == 4


tests: TestSuite = {
	description = "Global Managed Constants",
	tests = [
		(
			"direct global constant argument is retained",
			test_direct_global_constant_argument_is_retained,
		),
		("returned global constant is retained", test_returned_global_constant_is_retained),
		(
			"returned global constant survives accumulator consume",
			test_returned_global_constant_survives_accumulator_consume,
		),
		(
			"nested record global constant is retained",
			test_nested_record_global_constant_is_retained,
		),
		(
			"tuple global constant elements are retained",
			test_tuple_global_constant_elements_are_retained,
		),
		(
			"union global constant payload is retained",
			test_union_global_constant_payload_is_retained,
		),
		(
			"stack result global constant payload is retained",
			test_stack_result_global_constant_payload_is_retained,
		),
		("list string global elements are retained", test_list_string_global_elements_are_retained),
		("list record global elements are retained", test_list_record_global_elements_are_retained),
		("dict string global entries are retained", test_dict_string_global_entries_are_retained),
		(
			"global stored by record update in list loop body is retained",
			test_global_stored_by_record_update_in_list_loop_body_is_retained,
		),
		(
			"global stored in record in range loop body is retained",
			test_global_stored_in_record_in_range_loop_body_is_retained,
		),
		(
			"global stored by record update in loop iterable is retained",
			test_global_stored_by_record_update_in_loop_iterable_is_retained,
		),
	]
}
