import:
	memory: MemoryCounter(ManagedAllocations, MemoryStatsActive), read_memory_counter, reset_mem_stats
	test: TestSuite


record OptionalEntry {
	key: Int,
	value: Option[Int]
}


fixed record Point { x: Int, y: Int }


record PointEntry { point: Point, index: Int }


func tuple_point_entries(value: Int) -> List[(Point, Int)]:
	[
		({ x = value, y = value + 1 }, 0),
		({ x = value + 2, y = value + 3 }, 1),
		({ x = value + 4, y = value + 5 }, 2),
	]


func record_point_entries(value: Int) -> List[PointEntry]:
	[
		{ point = { x = value, y = value + 1 }, index = 0 },
		{ point = { x = value + 2, y = value + 3 }, index = 1 },
		{ point = { x = value + 4, y = value + 5 }, index = 2 },
	]


func tuple_entries(value: Int) -> List[(Int, Option[Int])]:
	[(value, Some(value + 1)), (value + 2, None)]


func record_entries(value: Int) -> List[OptionalEntry]:
	[{ key = value, value = Some(value + 1) }, { key = value + 2, value = None }]


func test_tuple_aggregate_elements_share_record_allocation_cost() -> Bool:
	reset_mem_stats()
	tuple_values = tuple_entries(10)
	tuple_allocations = read_memory_counter(ManagedAllocations)
	tuple_stats_active = read_memory_counter(MemoryStatsActive)

	reset_mem_stats()
	record_values = record_entries(10)
	record_allocations = read_memory_counter(ManagedAllocations)
	record_stats_active = read_memory_counter(MemoryStatsActive)

	match (tuple_values.get(0), tuple_values.get(1), record_values.get(0), record_values.get(1)):
		(Some(first_tuple), Some(second_tuple), Some(first_record), Some(second_record)):
			(
				tuple_stats_active == 1
				and record_stats_active == 1
				and record_allocations > 0
				and tuple_allocations == record_allocations
				and first_tuple[0] == first_record.key
				and first_tuple[1] == first_record.value
				and second_tuple[0] == second_record.key
				and second_tuple[1] == second_record.value
			)
		_:
			False


func test_tuple_fixed_record_elements_share_record_allocation_cost() -> Bool:
	reset_mem_stats()
	tuple_values = tuple_point_entries(10)
	tuple_allocations = read_memory_counter(ManagedAllocations)
	tuple_stats_active = read_memory_counter(MemoryStatsActive)

	reset_mem_stats()
	record_values = record_point_entries(10)
	record_allocations = read_memory_counter(ManagedAllocations)
	record_stats_active = read_memory_counter(MemoryStatsActive)

	match (tuple_values.get(0), tuple_values.get(2), record_values.get(0), record_values.get(2)):
		(Some(first_tuple), Some(last_tuple), Some(first_record), Some(last_record)):
			(
				tuple_stats_active == 1
				and record_stats_active == 1
				and record_allocations > 0
				and tuple_allocations == record_allocations
				and first_tuple[0] == first_record.point
				and first_tuple[1] == first_record.index
				and last_tuple[0] == last_record.point
				and last_tuple[1] == last_record.index
			)
		_:
			False


tests: TestSuite = {
	description = "Tuples through record storage",
	tests = [
		("tuple fixed record elements share record allocation cost", test_tuple_fixed_record_elements_share_record_allocation_cost),
		(
			"tuple aggregate elements share record allocation cost",
			test_tuple_aggregate_elements_share_record_allocation_cost,
		),
	]
}
