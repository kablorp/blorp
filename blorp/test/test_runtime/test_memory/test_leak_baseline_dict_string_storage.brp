import:
	dict as D
	test: TestSuite


func test_dict_string_storage() -> Bool:
	var d: Dict[String, String] = D.dict()
	d = D.set(d, "alpha", "one")
	d = D.set(d, "alpha", "uno")
	d = D.set(d, "beta", "two")

	D.get_or(d, "alpha", "") == "uno" and D.get_or(d, "beta", "") == "two" and d.length() == 2


tests: TestSuite = {
	description = "Dict String Storage",
	tests = [("dict string storage", test_dict_string_storage)]
}
