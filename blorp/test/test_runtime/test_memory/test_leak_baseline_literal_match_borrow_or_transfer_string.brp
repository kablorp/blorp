import:
	test: TestSuite


enum Action:
	KnownAction


union ParseActionError:
	UnknownAction(String)


private pure func parse_action(name: String) -> Result[Action, ParseActionError]:
	match name:
		"known":
			Ok(KnownAction)
		_:
			Err(UnknownAction(name))


func test_literal_match_borrow_or_transfer_string() -> Bool:
	match parse_action("known"):
		Ok(KnownAction):
			True
		Err(_):
			False


tests: TestSuite = {
	description = "Literal Match (Borrow or Transfer String)",
	tests = [
		("literal match borrow or transfer string", test_literal_match_borrow_or_transfer_string),
	]
}
