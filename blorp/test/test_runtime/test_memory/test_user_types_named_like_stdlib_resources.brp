-- User-declared types that share a name with a stdlib resource type must be
-- ordinary managed values: retained, released and copied by their own fields,
-- never by the stdlib type's policy.
--
-- Separated by spelling: `ResourceSource` (not on the ABI list, so the stdlib
-- type is always `stream::ResourceSource` in the typechecker and
-- `stream__ResourceSource` in Core; a bare name is the user's own record).
--
-- Known collisions that this test still passes through because the user type
-- is not a value the stdlib policy mishandles at runtime: `Stream`, `Channel`,
-- `Directory`, `FileReader` and `Port` are on the ABI list, so the stdlib type
-- is bare too and no spelling separates the two. Run under `--leak-check` (the
-- runtime gate) to catch a wrong release policy as a leak or double release.
--
-- Not covered here because it does not compile: a user `record
-- FallibleStream[T, E]` is treated by the typechecker as the stdlib type
-- ("one-shot stream values cannot be stored in List literals"). See typecheck
-- fixture `user_fallible_stream_named_like_stdlib.brp`.
import:
	test: TestSuite


record Stream[T] {
	items: List[T],
	label: String
}


record Channel[T] {
	items: List[T],
	label: String
}


record ResourceSource[R, E] {
	payload: R,
	error_label: E
}


record Directory {
	path: String
}


record FileReader {
	path: String
}


record Port {
	label: String
}


pure func user_stream_total(stream: Stream[Int]) -> Int:
	var total: Int = 0

	for item in stream.items:
		total += item

	total + stream.label.length()


pure func test_user_stream_is_a_record() -> Bool:
	stream: Stream[Int] = { items = [1, 2, 3], label = "abc" }
	copy: Stream[Int] = stream
	user_stream_total(copy) == 9


pure func test_user_channel_is_a_record() -> Bool:
	channel: Channel[String] = { items = ["a", "b"], label = "chan" }
	wrapped: Option[Channel[String]] = Some(channel)

	match wrapped:
		Some(inner):
			inner.items.length() == 2 and inner.label == "chan"
		None:
			False


pure func test_user_resource_source_is_a_record() -> Bool:
	source: ResourceSource[String, String] = { payload = "r", error_label = "e" }
	pair: (ResourceSource[String, String], Int) = (source, 1)

	match pair:
		(inner, _):
			inner.payload == "r" and inner.error_label == "e"


pure func test_user_file_and_directory_records_release_their_strings() -> Bool:
	-- Joined at run time so each path and label is a heap string that the
	-- record must release; a wrong "unmanaged" policy would leak them.
	directory: Directory = { path = ["dir", "name"].join("/") }
	reader: FileReader = { path = ["file", "name"].join("/") }
	port: Port = { label = ["port", "label"].join("-") }
	directory.path.length() == 8 and reader.path.length() == 9 and port.label.length() == 10


tests: TestSuite = {
	description = "User types named like stdlib resource types",
	tests = [
		("user Stream is an ordinary record", test_user_stream_is_a_record),
		("user Channel is an ordinary record", test_user_channel_is_a_record),
		("user ResourceSource is an ordinary record", test_user_resource_source_is_a_record),
		(
			"user Directory, FileReader and Port release their strings",
			test_user_file_and_directory_records_release_their_strings,
		),
	]
}
