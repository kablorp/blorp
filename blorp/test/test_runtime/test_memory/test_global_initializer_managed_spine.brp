	ordinal: Int,
	label: String
}


var FIRST_ITEM: Item = {ordinal = 0, label = "0"}
var SECOND_ITEM: Item = {ordinal = 1, label = "1"}
var THIRD_ITEM: Item = {ordinal = 2, label = "2"}


