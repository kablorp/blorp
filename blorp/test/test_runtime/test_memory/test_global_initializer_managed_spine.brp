func test_global_managed_spine_preserves_element_order() -> Bool:
	var expected: Int = 0
	var valid: Bool = True
	for item in ITEMS:
		ordinal = expected % 3
		if item.ordinal != ordinal or item.label != ordinal.to_string():
			valid = False
		expected = expected + 1
	valid and expected == 300


func test_global_managed_spine_survives_shared_list_copy() -> Bool:
	shared_items = ITEMS
	extended = shared_items.append({ordinal = 300, label = "last"})
	first = shared_items.get_or(0, {ordinal = -1, label = "missing"})
	last = extended.get_or(300, {ordinal = -1, label = "missing"})
	(
		ITEMS.length() == 300
		and shared_items.length() == 300
		and extended.length() == 301
		and first.ordinal == 0 and first.label == "0"
		and last.ordinal == 300 and last.label == "last"
	)


func test_global_managed_spine_retains_extracted_record() -> Bool:
	first = ITEMS.get_or(0, {ordinal = -1, label = "missing"})
	second_copy = ITEMS.get_or(0, {ordinal = -1, label = "missing"})
	updated = {first | label = first.label + "!"}
	(
		updated.label == "0!"
		and first.label == "0"
		and second_copy.label == "0"
		and FIRST_ITEM.label == "0"
	)


tests: TestSuite = {
	description = "Global Managed Initializer Spine",
	tests = [
		(
			"managed global preserves element order",
			test_global_managed_spine_preserves_element_order,
		),
		(
			"managed global survives shared list copy",
			test_global_managed_spine_survives_shared_list_copy,
		),
		(
			"managed global retains extracted record",
			test_global_managed_spine_retains_extracted_record,
		),
	],
}
