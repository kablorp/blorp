import:
	memory: same_object
	test: TestSuite


record Boxed {
	value: Int
}


record Pair {
	left: Int,
	right: Int
}


record NamedPair {
	pair: Pair,
	name: String
}


-- Deliberately impure so equal-looking calls are not shared by the compiler.
func make_box(value: Int) -> Boxed:
	{value = value}


func make_ints(seed: Int) -> List[Int]:
	var values: List[Int] = []
	values = values.append(seed)
	values = values.append(seed + 1)
	values


func test_record_alias_is_the_same_object() -> Bool:
	original: Boxed = make_box(7)
	second_ref: Boxed = original
	same_object(original, second_ref) and second_ref.value == 7


func test_equal_records_are_distinct_objects() -> Bool:
	left: Boxed = make_box(7)
	right: Boxed = make_box(7)
	left.value == right.value and not same_object(left, right)


func test_list_alias_is_the_same_object() -> Bool:
	original: List[Int] = make_ints(1)
	second_ref: List[Int] = original
	same_object(original, second_ref) and second_ref.length() == 2


func test_equal_lists_are_distinct_objects() -> Bool:
	left: List[Int] = make_ints(1)
	right: List[Int] = make_ints(1)
	left == right and not same_object(left, right)


func test_stack_values_are_never_the_same_object() -> Bool:
	value: Int = 7
	not same_object(value, value)


func test_record_of_ints_alias_is_the_same_object() -> Bool:
	pair: Pair = {
		left = 1,
		right = 2
	}
	shared_pair: Pair = pair
	same_object(pair, shared_pair) and shared_pair.left == 1 and shared_pair.right == 2


func test_nested_record_update_preserves_original() -> Bool:
	original: NamedPair = {pair = {left = 1, right = 2}, name = "original"}
	updated: NamedPair = {original | name = "updated"}
	(
		original.name == "original"
		and updated.name == "updated"
		and not same_object(original, updated)
		and same_object(original.pair, updated.pair)
		and updated.pair.right == 2
	)


tests: TestSuite = {
	description = "Allocation Identity",
	tests = [
		("record alias is the same object", test_record_alias_is_the_same_object),
		("equal records are distinct objects", test_equal_records_are_distinct_objects),
		("list alias is the same object", test_list_alias_is_the_same_object),
		("equal lists are distinct objects", test_equal_lists_are_distinct_objects),
		("stack values are never the same object", test_stack_values_are_never_the_same_object),
		("record of Ints alias is the same object", test_record_of_ints_alias_is_the_same_object),
		("nested record update preserves original", test_nested_record_update_preserves_original),
	]
}
