import:
	channel: SendAttempt(SendTimedOut, SendWouldBlock), send_timeout_attempt, try_send_attempt
	test: TestSuite


func payload(label: String) -> String:
	label + "-payload"


func test_channel_failed_send_stack_result() -> Bool:
	ch: Channel[Result[String, String]] = channel(1)
	stored: Result[String, String] = Ok(payload("stored"))
	_ = send(ch, stored)

	attempt_item: Result[String, String] = Ok(payload("attempt-full"))
	attempt: SendAttempt = try_send_attempt(ch, attempt_item)

	attempt_ok: Bool = match attempt:
		SendWouldBlock:
			True
		_:
			False

	timeout_item: Result[String, String] = Ok(payload("timeout-full"))
	timeout_attempt: SendAttempt = send_timeout_attempt(ch, timeout_item, 0)

	timeout_ok: Bool = match timeout_attempt:
		SendTimedOut:
			True
		_:
			False

	attempt_ok and timeout_ok


tests: TestSuite = {
	description = "Channel Failed Send (Stack Result)",
	tests = [("channel failed send stack result", test_channel_failed_send_stack_result)]
}
