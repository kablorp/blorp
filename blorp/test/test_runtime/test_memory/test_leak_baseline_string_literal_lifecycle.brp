import:
	test: TestSuite


record LabelBox {
	label: String
}


GLOBAL_BOX: LabelBox = {label = "shared"}


func accepts(value: String) -> Bool:
	value == "temporary"


func make_label_box() -> LabelBox:
	{label = GLOBAL_BOX.label}


func test_string_literal_lifecycle() -> Bool:
	var index: Int = 0
	var result: Bool = True

	while index < 100:
		if not accepts("temporary"):
			result = False

		box: LabelBox = make_label_box()

		if box.label != "shared":
			result = False

		index += 1

	result


tests: TestSuite = {
	description = "String Literal Lifecycle",
	tests = [("string literal lifecycle", test_string_literal_lifecycle)]
}
