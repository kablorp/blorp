import:
	memory: get_mem_stats, reset_mem_stats
	string as Text
	test: TestSuite


private pure func append_optional(output: String, suffix: Option[String]) -> Result[String, Int]:
	Ok(
		match suffix:
			Some(suffix):
				Text.add(output, suffix)
			None:
				output
	)


private pure func wrap_optional(
	output: String,
	suffix: Option[String],
) -> Option[Result[String, Int]]:
	Some(
		Ok(
			match suffix:
				Some(suffix):
					Text.add(output, suffix)
				None:
					output
		),
	)


private pure func optional_only(output: String, suffix: Option[String]) -> Option[String]:
	Some(
		match suffix:
			Some(suffix):
				Text.add(output, suffix)
			None:
				output
	)


private pure func bound_optional(value: Int, suffix: Option[String]) -> Result[String, Int]:
	output = value.to_string()
	Ok(
		match suffix:
			Some(suffix):
				Text.add(output, suffix)
			None:
				output
	)


private pure func observes_bound_branch(value: Int, suffix: Option[String]) -> Bool:
	match bound_optional(value, suffix):
		Ok(output):
			match suffix:
				Some(_):
					output == Text.add(value.to_string(), "suffix")
				None:
					output == value.to_string()
		Err(_):
			False


private pure func observes_branch(value: Int, suffix: Option[String]) -> Bool:
	match append_optional(value.to_string(), suffix):
		Ok(output):
			match suffix:
				Some(_):
					output == Text.add(value.to_string(), "suffix")
				None:
					output == value.to_string()
		Err(_):
			False


private pure func observes_nested_branch(value: Int, suffix: Option[String]) -> Bool:
	match wrap_optional(value.to_string(), suffix):
		Some(Ok(output)):
			match suffix:
				Some(_):
					output == Text.add(value.to_string(), "suffix")
				None:
					output == value.to_string()
		_:
			False


private pure func observes_option_branch(value: Int, suffix: Option[String]) -> Bool:
	match optional_only(value.to_string(), suffix):
		Some(output):
			match suffix:
				Some(_):
					output == Text.add(value.to_string(), "suffix")
				None:
					output == value.to_string()
		None:
			False


-- The counter read supplies a runtime value, so the owned input cannot become
-- a static String. Observe counters only after all helper results are dropped.
private func observes_balanced_lifetime(exercise: pure (Int) -> Bool) -> Bool:
	reset_mem_stats()
	valid = exercise(get_mem_stats().current_objects)
	stats = get_mem_stats()
	(
		valid
		and stats.memory_stats_active == 1
		and stats.total_allocations >= 2
		and stats.total_allocations == stats.total_releases
		and stats.current_objects == 0
	)


func test_result_append_branch() -> Bool:
	observes_balanced_lifetime(func(value): observes_branch(value, Some("suffix")))


func test_result_identity_branch() -> Bool:
	observes_balanced_lifetime(func(value): observes_branch(value, None))


func test_nested_append_branch() -> Bool:
	observes_balanced_lifetime(func(value): observes_nested_branch(value, Some("suffix")))


func test_nested_identity_branch() -> Bool:
	observes_balanced_lifetime(func(value): observes_nested_branch(value, None))


func test_option_append_branch() -> Bool:
	observes_balanced_lifetime(func(value): observes_option_branch(value, Some("suffix")))


func test_option_identity_branch() -> Bool:
	observes_balanced_lifetime(func(value): observes_option_branch(value, None))


func test_bound_append_branch() -> Bool:
	observes_balanced_lifetime(func(value): observes_bound_branch(value, Some("suffix")))


func test_bound_identity_branch() -> Bool:
	observes_balanced_lifetime(func(value): observes_bound_branch(value, None))


tests: TestSuite = {
	description = "Nested consuming call branch ownership",
	tests = [
		("Result append branch destroys consumed input", test_result_append_branch),
		("Result identity branch transfers consumed input", test_result_identity_branch),
		("nested append branch destroys consumed input", test_nested_append_branch),
		("nested identity branch transfers consumed input", test_nested_identity_branch),
		("Option append branch destroys consumed input", test_option_append_branch),
		("Option identity branch transfers consumed input", test_option_identity_branch),
		("local append branch destroys owned input", test_bound_append_branch),
		("local identity branch transfers owned input", test_bound_identity_branch),
	]
}
