import:
	test: TestSuite


record TextHolder {
	text: String
}


pure func stored_payload(owner: Option[String]) -> Option[TextHolder]:
	match owner:
		Some(text):
			var stored: Option[TextHolder] = None
			for item in [1, 2]:
				stored = Some({ text = text })
			stored
		None:
			None


pure func stored_range_payload(owner: Option[String]) -> Option[TextHolder]:
	match owner:
		Some(text):
			var stored: Option[TextHolder] = None
			for iteration in 0..2:
				stored = Some({ text = text })
			stored
		None:
			None


pure func test_option_and_record_keep_their_payload() -> Bool:
	-- Concatenation creates a managed value rather than a pooled literal.
	var valid = True
	for iteration in 0..64:
		payload = "managed payload " + iteration.to_string()
		owner = Some(payload)
		stored = stored_payload(owner)
		match stored:
			Some(holder):
				valid = valid and holder.text == payload
			None:
				valid = False
		-- The record result is no longer needed; the original Option must
		-- still own the same bytes after its independent record owner dies.
		match owner:
			Some(text):
				valid = valid and text == payload
			None:
				valid = False
	valid


pure func test_range_option_and_record_keep_their_payload() -> Bool:
	var valid = True
	for iteration in 0..64:
		payload = "managed range payload " + iteration.to_string()
		owner = Some(payload)
		stored = stored_range_payload(owner)
		match stored:
			Some(holder):
				valid = valid and holder.text == payload
			None:
				valid = False
		-- Each overwritten record and the final result release their own
		-- reference while the original Option preserves the managed string.
		match owner:
			Some(text):
				valid = valid and text == payload
			None:
				valid = False
	valid


tests: TestSuite = {
	description = "Borrowed match payload ownership through a loop",
	tests = [
		("Option and record preserve their payload", test_option_and_record_keep_their_payload),
		("range Option and record preserve their payload", test_range_option_and_record_keep_their_payload)
	]
}
