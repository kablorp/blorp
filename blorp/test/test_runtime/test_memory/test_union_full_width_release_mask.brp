import:
	memory: MemStats, get_mem_stats, reset_mem_stats
	test: TestSuite


-- One variant with the widest payload the release mask can describe: field 0
-- is unmanaged and fields 1..63 are Strings, so bit 63 (the sign bit of
-- the Int mask) is the last managed field.
union WidePayload:
	Wide(Int, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String, String)
	Narrow(Int)


func make_wide_payload(seed: Int) -> WidePayload:
	s0: Int = seed
	s1: String = seed.to_string() + "-1"
	s2: String = seed.to_string() + "-2"
	s3: String = seed.to_string() + "-3"
	s4: String = seed.to_string() + "-4"
	s5: String = seed.to_string() + "-5"
	s6: String = seed.to_string() + "-6"
	s7: String = seed.to_string() + "-7"
	s8: String = seed.to_string() + "-8"
	s9: String = seed.to_string() + "-9"
	s10: String = seed.to_string() + "-10"
	s11: String = seed.to_string() + "-11"
	s12: String = seed.to_string() + "-12"
	s13: String = seed.to_string() + "-13"
	s14: String = seed.to_string() + "-14"
	s15: String = seed.to_string() + "-15"
	s16: String = seed.to_string() + "-16"
	s17: String = seed.to_string() + "-17"
	s18: String = seed.to_string() + "-18"
	s19: String = seed.to_string() + "-19"
	s20: String = seed.to_string() + "-20"
