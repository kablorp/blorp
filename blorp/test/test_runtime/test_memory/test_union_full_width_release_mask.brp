	s51: String = seed.to_string() + "-51"
	s52: String = seed.to_string() + "-52"
	s53: String = seed.to_string() + "-53"
	s54: String = seed.to_string() + "-54"
	s55: String = seed.to_string() + "-55"
	s56: String = seed.to_string() + "-56"
