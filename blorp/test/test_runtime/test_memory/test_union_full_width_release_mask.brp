	s23: String = seed.to_string() + "-23"
	s24: String = seed.to_string() + "-24"
	s25: String = seed.to_string() + "-25"
	s26: String = seed.to_string() + "-26"
	s27: String = seed.to_string() + "-27"
	s28: String = seed.to_string() + "-28"
	s29: String = seed.to_string() + "-29"
	s30: String = seed.to_string() + "-30"
	s31: String = seed.to_string() + "-31"
	s32: String = seed.to_string() + "-32"
	s33: String = seed.to_string() + "-33"
	s34: String = seed.to_string() + "-34"
	s35: String = seed.to_string() + "-35"
	s36: String = seed.to_string() + "-36"
	s37: String = seed.to_string() + "-37"
	s38: String = seed.to_string() + "-38"
	s39: String = seed.to_string() + "-39"
	s40: String = seed.to_string() + "-40"
	s41: String = seed.to_string() + "-41"
	s42: String = seed.to_string() + "-42"
	s43: String = seed.to_string() + "-43"
	s44: String = seed.to_string() + "-44"
	s45: String = seed.to_string() + "-45"
	s46: String = seed.to_string() + "-46"
	s47: String = seed.to_string() + "-47"
	s48: String = seed.to_string() + "-48"
	s49: String = seed.to_string() + "-49"
