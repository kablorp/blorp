	Wide(s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, s28, s29, s30, s31, s32, s33, s34, s35, s36, s37, s38, s39, s40, s41, s42, s43, s44, s45, s46, s47, s48, s49, s50, s51, s52, s53, s54, s55, s56, s57, s58, s59, s60, s61, s62, s63)


func read_wide_payload(payload: WidePayload) -> Int:
	match payload:
		Wide(s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, s28, s29, s30, s31, s32, s33, s34, s35, s36, s37, s38, s39, s40, s41, s42, s43, s44, s45, s46, s47, s48, s49, s50, s51, s52, s53, s54, s55, s56, s57, s58, s59, s60, s61, s62, s63):
			s0 + s1.length() + s2.length() + s3.length() + s4.length() + s5.length() + s6.length() + s7.length() + s8.length() + s9.length() + s10.length() + s11.length() + s12.length() + s13.length() + s14.length() + s15.length() + s16.length() + s17.length() + s18.length() + s19.length() + s20.length() + s21.length() + s22.length() + s23.length() + s24.length() + s25.length() + s26.length() + s27.length() + s28.length() + s29.length() + s30.length() + s31.length() + s32.length() + s33.length() + s34.length() + s35.length() + s36.length() + s37.length() + s38.length() + s39.length() + s40.length() + s41.length() + s42.length() + s43.length() + s44.length() + s45.length() + s46.length() + s47.length() + s48.length() + s49.length() + s50.length() + s51.length() + s52.length() + s53.length() + s54.length() + s55.length() + s56.length() + s57.length() + s58.length() + s59.length() + s60.length() + s61.length() + s62.length() + s63.length()
		Narrow(value):
			value


func discard_wide_payload(payload: WidePayload) -> Int:
	match payload:
		Narrow(value):
			value
		_:
			7


func test_wide_payload_fields_are_released_after_read() -> Bool:
	reset_mem_stats()
	value: Int = read_wide_payload(make_wide_payload(3))
	stats: MemStats = get_mem_stats()
	value == 246 and stats.current_objects == 0


func test_wide_payload_fields_are_released_when_discarded() -> Bool:
	reset_mem_stats()
	value: Int = discard_wide_payload(make_wide_payload(3))
	stats: MemStats = get_mem_stats()
	value == 7 and stats.current_objects == 0


tests: TestSuite = {
	description = "Union variant with a full-width release mask",
	tests = [
		("64-field variant releases every managed field after a read", test_wide_payload_fields_are_released_after_read),
		("64-field variant releases every managed field when discarded", test_wide_payload_fields_are_released_when_discarded),
	]
}
