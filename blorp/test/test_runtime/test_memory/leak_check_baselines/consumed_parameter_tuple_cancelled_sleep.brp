-- A callee owns its record parameter and moves it into a tuple before it
-- parks. The tuple took the reference before the cancellation point, so the
-- parameter needs no slot of its own; one would release the record a second
-- time when the task is cancelled. `main` keeps its own reference to the
-- record, so a second release frees it under `main` and changes what this
-- program prints and counts even without a sanitizer.
import:
	memory: refcount
	test: cancel_after_parked_for_test


record Table {
	items: List[Int],
	count: Int
}


func pair_then_park(t: Table, x: Int) -> (Table, Int):
	n: Int = t.count
	p: (Table, Int) = (t, n + x)
	sleep(10000)
	p


func hold(t: Table) -> Int:
	(next, id) = t.pair_then_park(2)
	next.items.length() + id


---
After the cancelled task is gone, `main` holds the only reference to
`table`. A reference released twice by cancellation cleanup leaves the count
below one, freeing the table while `main` still uses it.
---
func table_survives(table: Table, expected_count: Int, expected_length: Int) -> Bool:
	(
		refcount(table) == 1
		and table.count == expected_count
		and table.items.length() == expected_length
	)


func main(args: List[String]) -> Int:
	var spin: Int = 0

	for i in 0..2:
		spin += i

	table: Table = {
		items = [7, 8, spin],
		count = 3
	}

	if cancel_after_parked_for_test(func(): hold(table)) and table_survives(table, 3, 3):
		0
	else:
		1
