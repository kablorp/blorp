import:
	channel: wait_send
	test: cancel_after_parked_for_test


func payload(label: String) -> String:
	label + "-payload"


func blocked_send(ch: Channel[String]) -> Int:
	if send(ch, payload("blocked-send")):
		1
	else:
		-1


func blocked_wait_send(ch: Channel[String]) -> Int:
	match wait_send(ch, payload("blocked-wait-send")):
		Ok(_):
			1
		Err(_):
			-1


func blocked_send_timeout(ch: Channel[String]) -> Int:
	if send_timeout(ch, payload("blocked-send-timeout"), 1000):
		1
	else:
		-1


func run_cancelled_send_case() -> Bool:
	ch: Channel[String] = channel(1)
	_ = send(ch, payload("stored-send"))
	cancelled: Bool = cancel_after_parked_for_test(func(): blocked_send(ch))

	stored_ok: Bool = match recv(ch):
		Some(value):
			value == "stored-send-payload"
		None:
			False

	cancelled and stored_ok


func run_cancelled_wait_send_case() -> Bool:
	ch: Channel[String] = channel(1)
	_ = send(ch, payload("stored-wait-send"))
	cancelled: Bool = cancel_after_parked_for_test(func(): blocked_wait_send(ch))

	stored_ok: Bool = match recv(ch):
		Some(value):
			value == "stored-wait-send-payload"
		None:
			False

	cancelled and stored_ok


func run_cancelled_send_timeout_case() -> Bool:
	ch: Channel[String] = channel(1)
	_ = send(ch, payload("stored-send-timeout"))
	cancelled: Bool = cancel_after_parked_for_test(func(): blocked_send_timeout(ch))

	stored_ok: Bool = match recv(ch):
		Some(value):
			value == "stored-send-timeout-payload"
		None:
			False

	cancelled and stored_ok


func main(args: List[String]) -> Int:
	if (
		run_cancelled_send_case()
		and run_cancelled_wait_send_case()
		and run_cancelled_send_timeout_case()
	):
		0
	else:
		1
