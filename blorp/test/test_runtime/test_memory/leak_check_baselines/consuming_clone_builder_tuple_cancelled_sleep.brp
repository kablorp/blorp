-- A builder method moves its table field through a callee that returns the
-- table in a tuple. The callee builds the tuple and then parks, and the task
-- is cancelled there. Each owner along the way is released once: the tuple
-- holds the table, and the builder no longer counts the field it handed on.
import:
	memory: refcount
	test: cancel_after_parked_for_test


record Table {
	items: List[Int],
	count: Int
}


record Builder {
	names: Table,
	steps: Int
}


func intern_parking(t: Table, x: Int) -> (Table, Int):
	n: Int = t.count
	var spin: Int = 0

	for i in 0..2:
		spin += i

	result: (Table, Int) = ({ t |
			items = t.items.append(x),
			count = n + 1
		}, n)
	sleep(10000)
	result


func intern_name(b: Builder, x: Int) -> (Builder, Int):
	(names, id) = intern_parking(b.names, x)
	({ b |
			names = names,
			steps = b.steps + 1
		}, id)


func hold(shared: Builder) -> Int:
	var b: Builder = shared
	var spin: Int = 0

	for i in 0..2:
		spin += i

	(nb, id) = b.intern_name(spin)
	b = nb
	b.names.items.length() + id


---
After the cancelled task is gone, `main` holds the only reference to
`table`. A reference released twice by cancellation cleanup leaves the count
below one, freeing the table while `main` still uses it.
---
func table_survives(table: Table, expected_count: Int, expected_length: Int) -> Bool:
	(
		refcount(table) == 1
		and table.count == expected_count
		and table.items.length() == expected_length
	)


func main(args: List[String]) -> Int:
	b: Builder = {
		names = {
			items = [7],
			count = 1
		},
		steps = 0
	}

	if cancel_after_parked_for_test(func(): hold(b)) and table_survives(b.names, 1, 1):
		0
	else:
		1
