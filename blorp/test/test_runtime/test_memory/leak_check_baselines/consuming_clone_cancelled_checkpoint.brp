-- A pure consuming clone owns its record parameter and is cancelled at one of
-- the compiler's cooperative loop checkpoints. Pure code cannot park, but it
-- can be cancelled there, so the owned parameter needs a cleanup slot exactly
-- as an impure clone's does.
record Table {
	items: List[Int],
	count: Int
}


--- Never returns: the loop ends only through cancellation at a checkpoint.
pure func spin_then_grow(t: Table, x: Int) -> Table:
	n: Int = t.count
	var iterations: Int = 0
	var done: Bool = False

	while not done:
		iterations += 1

	{ t |
		items = t.items.append(x + iterations),
		count = n + 1
	}


func hold(seed: Int) -> Int:
	var table: Table = {
		items = [seed],
		count = 1
	}
	var spin: Int = 0

	for i in 0..2:
		spin += i

	table = table.spin_then_grow(spin)
	table.items.length()


func main(args: List[String]) -> Int:
	concurrent(timeout: 30):
		held = hold(1)

	match held:
		Ok(_):
			1
		Err(_):
			0
