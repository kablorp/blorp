-- A native zip result owns both generated rows and their managed fields while
-- the tensor loop borrows each row. Cancellation must release the iterable.
import:
	io: print_error
	memory:
		MemoryCounter(LiveManagedObjects, ManagedAllocations, MemoryStatsActive),
		read_memory_counter, refcount
	test: cancel_after_parked_for_test


func parked_zip(first: String[#2], second: List[Int][#2]) -> Int:
	var score: Int = 0
	for (key, rows) in first.zip(second):
		sleep(10000)
		score += key.length() + rows.length()
	score


func main(args: List[String]) -> Int:
	seed = read_memory_counter(ManagedAllocations)
	key = ("owned zip " + seed.to_string()).repeat(2)
	rows: List[Int] = [seed, seed + 1]
	first: String[#2] = {key, key}
	second: List[Int][#2] = {rows, rows}
	key_refs_before = refcount(key)
	rows_refs_before = refcount(rows)
	first_refs_before = refcount(first)
	second_refs_before = refcount(second)
	active_before = read_memory_counter(MemoryStatsActive)
	allocations_before = read_memory_counter(ManagedAllocations)
	live_before = read_memory_counter(LiveManagedObjects)
	cancelled = cancel_after_parked_for_test(func(): parked_zip(first, second))
	active_after = read_memory_counter(MemoryStatsActive)
	allocations_after = read_memory_counter(ManagedAllocations)
	live_after = read_memory_counter(LiveManagedObjects)
	key_refs_after = refcount(key)
	rows_refs_after = refcount(rows)
	first_refs_after = refcount(first)
	second_refs_after = refcount(second)
	print_error("cancelled")
	print_error(cancelled)
	print_error("active before/after")
	print_error(active_before)
	print_error(active_after)
	print_error("allocations before/after")
	print_error(allocations_before)
	print_error(allocations_after)
	print_error("live before/after")
	print_error(live_before)
	print_error(live_after)
	print_error("key refs before/after")
	print_error(key_refs_before)
	print_error(key_refs_after)
	print_error("rows refs before/after")
	print_error(rows_refs_before)
	print_error(rows_refs_after)
	print_error("first refs before/after")
	print_error(first_refs_before)
	print_error(first_refs_after)
	print_error("second refs before/after")
	print_error(second_refs_before)
	print_error(second_refs_after)
	if (
		cancelled
		and active_before == 1
		and active_after == 1
		and allocations_after > allocations_before
		and live_after == live_before
		and key_refs_before > 1
		and rows_refs_before > 1
		and first_refs_before > 0
		and second_refs_before > 0
		and key_refs_after == key_refs_before
		and rows_refs_after == rows_refs_before
		and first_refs_after == first_refs_before
		and second_refs_after == second_refs_before
		and first[0] == key
		and second[0] == rows
	):
		0
	else:
		1
