-- A call hands its record to a consuming clone, which parks, and the task is
-- cancelled there. The caller gave up its cleanup slot at the call, so the
-- clone's owned parameter must have a slot of its own, pushed at entry, or no
-- one releases the record and its list.
--
-- The deterministic pin for the slot is
-- `test_emit_owned_parameter_slot_pushed_at_entry` in
-- blorp/test/test_compiler/test_stage_10_backend/test_core_emit.brp; this run checks that
-- allocations and releases balance.
import:
	test: cancel_after_parked_for_test


record Table {
	items: List[Int],
	count: Int
}


func grow(t: Table, x: Int) -> Table:
	n: Int = t.count
	sleep(10000)
	{ t |
		items = t.items.append(x),
		count = n + 1
	}


func hold(seed: Int) -> Int:
	var table: Table = {
		items = [seed],
		count = 1
	}
	var spin: Int = 0

	for i in 0..2:
		spin += i

	table = table.grow(spin)
	table.items.length()


func main(args: List[String]) -> Int:
	if cancel_after_parked_for_test(func(): hold(1)):
		0
	else:
		1
