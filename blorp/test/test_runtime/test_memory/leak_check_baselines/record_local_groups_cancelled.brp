-- Literal record fields and immutable aliases keep a shared child live across
-- a cancellation point. Each field owner must release exactly once when the
-- task is cancelled. Keep this parked-fiber regression in its own process.
import:
	memory: refcount
	test: cancel_after_parked_for_test


record ManagedChild {
	items: List[Int],
	index: Int
}


func child_aliases_across_park(items: List[Int]) -> Int:
	state: ManagedChild = { items = items, index = 7 }
	copy: ManagedChild = state
	sleep(10000)
	state.items.length() + copy.items.length() + state.index


func run_cancelled_group_case() -> Bool:
	items: List[Int] = [7, 8]
	cancelled: Bool = cancel_after_parked_for_test(func(): child_aliases_across_park(items))
	-- The task's parameter, local field owners and closure have all gone.
	-- ASan catches double releases; this also catches an extra surviving owner.
	cancelled and refcount(items) == 1 and items.get(0).get_or(-1) == 7 and items.length() == 2


func main(args: List[String]) -> Int:
	if run_cancelled_group_case():
		0
	else:
		1
