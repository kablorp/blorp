-- A second name takes a let binding's reference, then the task is cancelled
-- while parked. Only the second name may be released by cancellation
-- cleanup; a slot still armed for the first name releases it twice.
--
-- This run only checks that allocations and releases balance: the leak gate
-- cannot see a double free, so on macOS it passes without the fix too, and
-- only ASan (Linux `make test-asan`) catches the double release here. The
-- deterministic pin is `test_emit_cancelling_let_alias_return_tracks_only_the_alias`
-- in blorp/test/test_compiler/test_stage_10_backend/test_core_emit.brp.
import:
	test: cancel_after_parked_for_test


record Tables {
	rows: List[Int],
	other: List[Int]
}


pure func append_row(t: Tables, v: Int) -> Tables:
	{ t | rows = t.rows.append(v) }


pure func append_other(t: Tables, v: Int) -> Tables:
	{ t | other = t.other.append(v) }


func alias_then_sleep(seed: Int) -> Int:
	made: Tables = append_other(
		{
			rows = [seed],
			other = []
		},
		seed,
	)
	same: Tables = made
	sleep(10000)
	append_row(same, 1).rows.length()


func run_cancelled_alias_case() -> Bool:
	cancel_after_parked_for_test(func(): alias_then_sleep(1))


func main(args: List[String]) -> Int:
	if run_cancelled_alias_case():
		0
	else:
		1
