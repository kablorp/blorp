-- Single dispatch binary for the leak-baseline programs that need their own
-- OS process: each imports fiber-parking/cancellation (`cancel_after_parked_for_test`)
-- or real concurrency primitives, so a scheduler/reactor singleton could carry
-- state between programs if they ran in one process. `scripts/test` links this
-- module once and launches it once per case with `argv[1]` selecting which
-- program's `main` runs, so leak accounting stays exactly one OS process per
-- program (unchanged from before) while paying only one clang link for all of
-- them.
import:
	./channel_cancelled_fanout_string as P0
	./channel_cancelled_join_string as P1
	./channel_cancelled_recv_string as P2
	./channel_cancelled_select_string as P3
	./channel_cancelled_send_string as P4
	./concurrent_cancelled_fixed_join_string as P5
	./consumed_parameter_cancelled_sleep as P21
	./consumed_parameter_tuple_cancelled_sleep as P25
	./consuming_clone_builder_tuple_cancelled_sleep as P26
	./consuming_clone_cancelled_checkpoint as P22
	./consuming_clone_cancelled_sleep as P23
	./consuming_clone_relay_cancelled_sleep as P24
	./consuming_clone_tuple_cancelled_sleep as P27
	./let_alias_cancelled_sleep as P19
	./let_tuple_cancelled_sleep as P28
	./list_concurrent_cancelled_join_string as P6
	./list_concurrent_string_results as P7
	./loop_var_cancelled_sleep as P29
	./moved_reference_cancelled_sleep as P20
	./nested_worker_group_cancel_channel as P8
	./select_cancelled_stack_result as P9
	./sleep_cancelled_string as P10
	./stream_cancelled_owned_callback_string as P11
	./tcp_cancelled_accept_string as P12
	./tcp_cancelled_read_string as P13
	./tcp_concurrent_source_cancelled_stream as P14
	./tcp_concurrent_source_timeout_cancelled_read as P18
	./udp_cancelled_recv_string as P15
	./udp_datagram_stream_cancelled_predicate as P16
	./udp_datagram_stream_cancelled_recv as P17


func main(args: List[String]) -> Int:
	rest: List[String] = args.drop(2)

	match args.get(1):
		Some("channel_cancelled_fanout_string"):
			P0.main(rest)
		Some("channel_cancelled_join_string"):
			P1.main(rest)
		Some("channel_cancelled_recv_string"):
			P2.main(rest)
		Some("channel_cancelled_select_string"):
			P3.main(rest)
		Some("channel_cancelled_send_string"):
			P4.main(rest)
		Some("concurrent_cancelled_fixed_join_string"):
			P5.main(rest)
		Some("consumed_parameter_cancelled_sleep"):
			P21.main(rest)
		Some("consumed_parameter_tuple_cancelled_sleep"):
			P25.main(rest)
		Some("consuming_clone_builder_tuple_cancelled_sleep"):
			P26.main(rest)
		Some("consuming_clone_cancelled_checkpoint"):
			P22.main(rest)
		Some("consuming_clone_cancelled_sleep"):
			P23.main(rest)
		Some("consuming_clone_relay_cancelled_sleep"):
			P24.main(rest)
		Some("consuming_clone_tuple_cancelled_sleep"):
			P27.main(rest)
		Some("let_alias_cancelled_sleep"):
			P19.main(rest)
		Some("let_tuple_cancelled_sleep"):
			P28.main(rest)
		Some("list_concurrent_cancelled_join_string"):
			P6.main(rest)
		Some("list_concurrent_string_results"):
			P7.main(rest)
		Some("loop_var_cancelled_sleep"):
			P29.main(rest)
		Some("moved_reference_cancelled_sleep"):
			P20.main(rest)
		Some("nested_worker_group_cancel_channel"):
			P8.main(rest)
		Some("select_cancelled_stack_result"):
			P9.main(rest)
		Some("sleep_cancelled_string"):
			P10.main(rest)
		Some("stream_cancelled_owned_callback_string"):
			P11.main(rest)
		Some("tcp_cancelled_accept_string"):
			P12.main(rest)
		Some("tcp_cancelled_read_string"):
			P13.main(rest)
		Some("tcp_concurrent_source_cancelled_stream"):
			P14.main(rest)
		Some("tcp_concurrent_source_timeout_cancelled_read"):
			P18.main(rest)
		Some("udp_cancelled_recv_string"):
			P15.main(rest)
		Some("udp_datagram_stream_cancelled_predicate"):
			P16.main(rest)
		Some("udp_datagram_stream_cancelled_recv"):
			P17.main(rest)
		Some(other):
			print_error("__isolated_dispatch__: unknown leak-baseline case \"" + other + "\"")
			2
		None:
			print_error("__isolated_dispatch__: missing leak-baseline case argument")
			2
