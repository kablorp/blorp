-- A local owns a reference to a record shared with `main`, stays live across
-- a loop's cancellation checkpoints, and is then moved into a tuple before
-- the park where the task is cancelled. The local's cleanup slot must give
-- the reference up where the tuple takes it, or cancellation releases it
-- through both and frees the record under `main`.
import:
	memory: refcount
	test: cancel_after_parked_for_test


record Table {
	items: List[Int],
	count: Int
}


func pair_between_parks(source: Table, x: Int) -> (Table, Int):
	t: Table = source
	var spin: Int = 0

	for i in 0..2:
		spin += i

	p: (Table, Int) = (t, x + spin)
	sleep(10000)
	p


func hold(source: Table) -> Int:
	(next, id) = pair_between_parks(source, 2)
	next.items.length() + id


---
After the cancelled task is gone, `main` holds the only reference to
`table`. A reference released twice by cancellation cleanup leaves the count
below one, freeing the table while `main` still uses it.
---
func table_survives(table: Table, expected_count: Int, expected_length: Int) -> Bool:
	(
		refcount(table) == 1
		and table.count == expected_count
		and table.items.length() == expected_length
	)


func main(args: List[String]) -> Int:
	var spin: Int = 0

	for i in 0..2:
		spin += i

	table: Table = {
		items = [7, 8, spin],
		count = 3
	}

	if cancel_after_parked_for_test(func(): hold(table)) and table_survives(table, 3, 3):
		0
	else:
		1
