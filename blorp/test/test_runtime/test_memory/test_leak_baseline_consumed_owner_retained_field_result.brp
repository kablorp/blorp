import:
	option: Option(Some, None)
	test: TestSuite


record Token {
	kind: String
}


record ParserState {
	tokens: List[Token],
	index: Int
}


record InfixInfo {
	precedence: Int
}


private pure func current_token(state: ParserState) -> Token:
	match state.tokens.get(state.index):
		Some(token):
			token
		None:
			{kind = "eof"}


private pure func current_kind(state: ParserState) -> Option[InfixInfo]:
	match current_token(state).kind:
		"identifier":
			Some({precedence = 1})
		_:
			None


func test_consumed_owner_retained_field_result() -> Bool:
	state: ParserState = {
		tokens = [{kind = "identifier"}],
		index = 0
	}

	match current_kind(state):
		Some(info):
			info.precedence == 1
		None:
			False


tests: TestSuite = {
	description = "Consumed Owner Retained Field Result",
	tests = [("consumed owner retained field result", test_consumed_owner_retained_field_result)]
}
