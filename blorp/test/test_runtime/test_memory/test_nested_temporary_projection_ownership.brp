import:
	memory: get_mem_stats, reset_mem_stats
	test: TestSuite


fixed union Kind:
	Known(String)
	Other


fixed record Error {
	kind: Kind,
	code: Int
}


fixed record Errors {
	first: Error,
	remaining: List[Error]
}


fixed record Report {
	errors: Errors
}


private pure func make_error() -> Error:
	{
		kind = Known(7.to_string()),
		code = 7
	}


private pure func make_errors() -> Errors:
	{
		first = make_error(),
		remaining = []
	}


private pure func make_report() -> Report:
	{errors = make_errors()}


pure func test_one_temporary_projection() -> Bool:
	match make_error().kind:
		Known(value):
			value == "7"
		Other:
			False


pure func test_two_temporary_projections() -> Bool:
	match make_errors().first.kind:
		Known(value):
			value == "7"
		Other:
			False


pure func test_three_temporary_projections() -> Bool:
	match make_report().errors.first.kind:
		Known(_):
			True
		Other:
			False


pure func test_named_intermediate_projection() -> Bool:
	error = make_errors().first

	match error.kind:
		Known(value):
			value == "7" and error.code == 7
		Other:
			False


pure func test_borrowed_root_remains_live() -> Bool:
	root = make_errors()
	child = root.first.kind

	match child:
		Known(value):
			-- Re-read the root after acquiring its child; ownership cannot move.
			value == "7" and root.first.code == 7
		Other:
			False


pure func test_nested_projection_binding() -> Bool:
	child = make_errors().first.kind

	match child:
		Known(value):
			value == "7"
		Other:
			False


pure func test_unmanaged_leaf_drops_temporary_parents() -> Bool:
	make_report().errors.first.code == 7


func test_owned_children_are_destroyed() -> Bool:
	reset_mem_stats()
	valid = test_three_temporary_projections()
	stats = get_mem_stats()
	-- Three parent records, Kind and its mortal String must all be observed
	-- and destroyed before the helper returns.
	(
		valid
		and stats.memory_stats_active == 1
		and stats.total_allocations >= 5
		and stats.total_allocations == stats.total_releases
		and stats.current_objects == 0
	)


tests: TestSuite = {
	description = "Nested temporary projection ownership",
	tests = [
		("one temporary projection", test_one_temporary_projection),
		("two temporary projections", test_two_temporary_projections),
		("three temporary projections", test_three_temporary_projections),
		("named intermediate projection", test_named_intermediate_projection),
		("borrowed root remains live", test_borrowed_root_remains_live),
		("nested projection binding", test_nested_projection_binding),
		("unmanaged leaf drops temporary parents", test_unmanaged_leaf_drops_temporary_parents),
		("owned children are destroyed", test_owned_children_are_destroyed),
	]
}
