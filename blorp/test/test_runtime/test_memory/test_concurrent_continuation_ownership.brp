import:
	test: TestSuite


-- The statements after a `concurrent:` block are lowered into the block's
-- body, so they sit inside the concurrent node in Core. These tests cover
-- ownership rules that must see through it.


func payload(label: String) -> String:
	label + "-payload"


func double(n: Int) -> Int:
	n * 2


--- `found` borrows from `item`, so returning it needs a retain even though
--- the return follows a concurrent block.
func found_after_concurrent(item: Option[String]) -> String:
	match item:
		Some(found):
			concurrent:
				doubled = double(1)
			found
		None:
			"none"


func test_match_binding_returned_after_concurrent_block_is_retained() -> Bool:
	item: Option[String] = Some(payload("item"))
	first: String = found_after_concurrent(item)
	second: String = found_after_concurrent(item)
	first == "item-payload" and second == "item-payload"


--- `text` is borrowed because only one path returns it; that path still
--- needs its retain after a concurrent block.
func text_or_default_after_concurrent(text: String, keep: Bool) -> String:
	concurrent:
		doubled = double(1)
	if keep:
		text
	else:
		"default"


func test_borrowed_parameter_returned_after_concurrent_block_is_retained() -> Bool:
	text: String = payload("text")
	kept: String = text_or_default_after_concurrent(text, True)
	dropped: String = text_or_default_after_concurrent(text, False)
	kept == "text-payload" and dropped == "default" and text == "text-payload"


--- Reassigning a mutable local after a concurrent block releases the value it
--- replaces.
func relabel_after_concurrent() -> String:
	var label: String = payload("first")
	concurrent:
		doubled = double(1)
	label = payload("second")
	label


func test_assignment_after_concurrent_block_releases_replaced_value() -> Bool:
	relabel_after_concurrent() == "second-payload"


func extend(items: List[String], item: String) -> List[String]:
	items.append(item)


--- Inside a loop, the statements after a concurrent block run on every
--- iteration, so an outer local they consume must be retained each time.
func test_consume_after_concurrent_block_in_loop_retains_local() -> Bool:
	base: List[String] = [payload("base")]
	var seen: List[String] = [payload("seen")]
	var total: Int = 0
	var round: Int = 0

	while round < 2:
		concurrent:
			doubled = double(1)
		from_base: List[String] = extend(base, payload("item"))
		from_seen: List[String] = extend(seen, payload("item"))
		total = total + from_base.length() + from_seen.length()
		round = round + 1

	total == 8 and base.length() == 1 and seen.length() == 1


tests: TestSuite = {
	description = "concurrent continuation ownership",
	tests = [
		(
			"match binding returned after concurrent block is retained",
			test_match_binding_returned_after_concurrent_block_is_retained,
		),
		(
			"borrowed parameter returned after concurrent block is retained",
			test_borrowed_parameter_returned_after_concurrent_block_is_retained,
		),
		(
			"assignment after concurrent block releases replaced value",
			test_assignment_after_concurrent_block_releases_replaced_value,
		),
		(
			"consume after concurrent block in loop retains local",
			test_consume_after_concurrent_block_in_loop_retains_local,
		),
	]
}
