import:
	result: Result(Ok, Err)
	test: TestSuite


private pure func ok_text(text: String) -> Result[String, String]:
	Ok(text)


private pure func err_text(text: String) -> Result[String, String]:
	Err(text)


func test_stack_result_tuple_owned_rvalues() -> Bool:
	pair = (ok_text("left"), err_text("right"))

	match pair:
		(Ok(left), Err(right)):
			left == "left" and right == "right"
		_:
			False


tests: TestSuite = {
	description = "Stack Result Tuple (Owned Rvalues)",
	tests = [("stack result tuple owned rvalues", test_stack_result_tuple_owned_rvalues)]
}
