import:
	test: TestSuite


private pure func make_token_pair() -> (Int, String):
	(1, "identifier")


func test_managed_temporary_tuple_field_projection() -> Bool:
	kind: String = make_token_pair()[1]

	kind == "identifier"


tests: TestSuite = {
	description = "Managed Temporary Tuple Field Projection",
	tests = [
		(
			"managed temporary tuple field projection",
			test_managed_temporary_tuple_field_projection,
		),
	]
}
