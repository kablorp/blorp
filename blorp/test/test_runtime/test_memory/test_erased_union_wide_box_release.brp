import:
	memory: MemStats, get_mem_stats, reset_mem_stats
	test: TestSuite


union ErasedWidePayload:
	SignedValue(Int128)
	UnsignedValue(UInt128)
	Text(String)


pure func signed_payload_value(payload: ErasedWidePayload) -> Int128:
	match payload:
		SignedValue(value):
			value
		_:
			empty: Int128 = 0
			empty


pure func unsigned_payload_value(payload: ErasedWidePayload) -> UInt128:
	match payload:
		UnsignedValue(value):
			value
		_:
			empty: UInt128 = 0
			empty


func test_erased_wide_payload_boxes_are_released() -> Bool:
	reset_mem_stats()
	var count: Int = 0
	var values_match: Bool = True
	expected_signed: Int128 = 42
	expected_unsigned: UInt128 = 43

	while count < 1000:
		values_match = (
			values_match
			and signed_payload_value(SignedValue(expected_signed)) == expected_signed
			and unsigned_payload_value(UnsignedValue(expected_unsigned)) == expected_unsigned
		)
		count += 1

	stats: MemStats = get_mem_stats()
	(values_match and stats.current_objects == 0)


tests: TestSuite = {
	description = "Erased wide union payload box ownership",
	tests = [
		(
			"erased wide payload boxes are released",
			test_erased_wide_payload_boxes_are_released,
		),
	]
}
