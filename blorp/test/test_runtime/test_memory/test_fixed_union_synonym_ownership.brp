import:
	test: TestSuite


union OrdinaryChoice:
	OrdinaryNumber(Int)
	OrdinaryText(String)
	OrdinaryEmpty


-- P1 synonym coverage: String is legal here until P5 checked admission.
fixed union FixedChoice:
	FixedNumber(Int)
	FixedText(String)
	FixedEmpty


union OrdinaryGeneric[T]:
	OrdinaryPicked(T)
	OrdinaryMissing


fixed union FixedGeneric[T]:
	FixedPicked(T)
	FixedMissing


record Label {
	text: String
}


record StoredChoices {
	ordinary: List[OrdinaryChoice],
	fixed: List[FixedChoice]
}


pure func ordinary_value(choice: OrdinaryChoice) -> Int:
	match choice:
		OrdinaryNumber(number):
			number
		OrdinaryText(text):
			text.length()
		OrdinaryEmpty:
			0


pure func fixed_value(choice: FixedChoice) -> Int:
	match choice:
		FixedNumber(number):
			number
		FixedText(text):
			text.length()
		FixedEmpty:
			0


pure func ordinary_return(choice: OrdinaryChoice) -> OrdinaryChoice:
	choice


pure func fixed_return(choice: FixedChoice) -> FixedChoice:
	choice


pure func retained_choices(seed: Int) -> StoredChoices:
	text: String = "kept-${seed.to_string()}"
	ordinary: OrdinaryChoice = ordinary_return(OrdinaryText(text))
	fixed: FixedChoice = fixed_return(FixedText(text))
	ordinary_alias: OrdinaryChoice = ordinary
	fixed_alias: FixedChoice = fixed
	{
		ordinary = [ordinary, ordinary_alias],
		fixed = [fixed, fixed_alias]
	}


pure func churn_payloads() -> Int:
	var labels: List[Label] = []
	var index: Int = 0

	while index < 128:
		labels = labels.append({text = "noise-${index.to_string()}"})
		index += 1

	labels.length()


func test_all_variants_pass_and_return_with_equal_values() -> Bool:
	(
		ordinary_value(
			ordinary_return(OrdinaryNumber(42)),
		) == fixed_value(fixed_return(FixedNumber(42)))
		and ordinary_value(ordinary_return(OrdinaryText("managed"))) == 7
		and fixed_value(fixed_return(FixedText("managed"))) == 7
		and ordinary_value(ordinary_return(OrdinaryEmpty)) == 0
		and fixed_value(fixed_return(FixedEmpty)) == 0
	)


func test_retained_aliases_survive_record_list_storage_and_churn() -> Bool:
	stored: StoredChoices = retained_choices(23)
	churned: Int = churn_payloads()
	var correct: Bool = (
		churned == 128
		and stored.ordinary.length() == 2
		and stored.fixed.length() == 2
	)

	for choice in stored.ordinary:
		match choice:
			OrdinaryText(text):
				correct = correct and text == "kept-23"
			_:
				correct = False

	for choice in stored.fixed:
		match choice:
			FixedText(text):
				correct = correct and text == "kept-23"
			_:
				correct = False

	correct


pure func retained_generic(seed: Int) -> (OrdinaryGeneric[Label], FixedGeneric[Label]):
	label: Label = {text = "generic-${seed.to_string()}"}
	ordinary: OrdinaryGeneric[Label] = OrdinaryPicked(label)
	fixed: FixedGeneric[Label] = FixedPicked(label)
	(ordinary, fixed)


func test_generic_managed_payloads_and_empty_variants_agree() -> Bool:
	(ordinary, fixed) = retained_generic(17)
	ordinary_alias = ordinary
	fixed_alias = fixed
	churned: Int = churn_payloads()

	text_payloads: Bool = match (ordinary, ordinary_alias, fixed, fixed_alias):
		(OrdinaryPicked(ordinary_label), OrdinaryPicked(ordinary_copy), FixedPicked(fixed_label), FixedPicked(fixed_copy)):
			(
				ordinary_label.text == "generic-17"
				and ordinary_label.text == ordinary_copy.text
				and ordinary_label.text == fixed_label.text
				and ordinary_label.text == fixed_copy.text
			)
		_:
			False

	ordinary_empty: OrdinaryGeneric[String] = OrdinaryMissing
	fixed_empty: FixedGeneric[String] = FixedMissing

	match (ordinary_empty, fixed_empty):
		(OrdinaryMissing, FixedMissing):
			churned == 128 and text_payloads
		_:
			False


tests: TestSuite = {
	description = "Fixed union synonym ownership",
	tests = [
		(
			"all variants pass and return with equal values",
			test_all_variants_pass_and_return_with_equal_values,
		),
		(
			"retained aliases survive record List storage and churn",
			test_retained_aliases_survive_record_list_storage_and_churn,
		),
		(
			"generic managed payloads and empty variants agree",
			test_generic_managed_payloads_and_empty_variants_agree,
		),
	]
}
