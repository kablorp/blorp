import:
	int: INT_MAX, INT_MIN
	memory: same_object
	string: from_char, slice, substring
	test: TestSuite


-- Impure bounds keep the endpoint check at runtime.
func runtime_index(value: Int) -> Int:
	value


func test_slice_rejects_end_inside_utf8_scalar() -> Bool:
	match slice("é", runtime_index(0), runtime_index(1)):
		Some(_): False
		None: True


private func selected(value: String, start: Int, end: Int, expected: String) -> Bool:
	match slice(value, runtime_index(start), runtime_index(end)):
		Some(text): text == expected
		None: False


private func rejected(start: Int, end: Int) -> Bool:
	match slice("Aé🙂\0Z", runtime_index(start), runtime_index(end)):
		Some(_): False
		None: True


func test_slice_rejects_full_width_and_reversed_bounds() -> Bool:
	var correct: Bool = True
	for bounds in [(INT_MIN, 0), (-1, 0), (0, -1), (3, 1), (0, 10), (0, INT_MAX), (4294967296, 4294967297)]:
		correct = rejected(bounds[0], bounds[1]) and correct
	correct


func test_slice_preserves_counted_unicode_bytes() -> Bool:
	(
		selected("Aé🙂\0Z", 1, 7, "é🙂")
		and selected("Aé🙂\0Z", 7, 8, "\0")
		and selected("é世🙂", 2, 5, "世")
		and selected("\u{80}\u{BF}", 0, 2, "\u{80}")
		and selected("\u{80}\u{BF}", 2, 4, "\u{BF}")
		and selected("e\u{301}\u{FEFF}\r\n", 0, 3, "e\u{301}")
		and selected("e\u{301}\u{FEFF}\r\n", 3, 6, "\u{FEFF}")
		and selected("e\u{301}\u{FEFF}\r\n", 6, 8, "\r\n")
	)


func test_slice_checks_empty_ranges_at_both_endpoints() -> Bool:
	(
		selected("", 0, 0, "") and selected("Aé🙂\0Z", 0, 0, "")
		and selected("Aé🙂\0Z", 3, 3, "") and selected("Aé🙂\0Z", 9, 9, "")
		and rejected(2, 2) and rejected(2, 3) and rejected(3, 4)
	)


private func runtime_text() -> String:
	"A" + from_char(to_char(runtime_index(233))) + "🙂\0Z"


private func distinct_runtime_copies(value: String, start: Int, end: Int) -> Bool:
	match (slice(value, runtime_index(start), runtime_index(end)), slice(value, runtime_index(start), runtime_index(end))):
		(Some(first), Some(second)):
			(
				first == second and value.length() >= end
				and not same_object(value, first) and not same_object(value, second)
				and not same_object(first, second)
			)
		_: False


func test_slice_full_and_empty_results_have_distinct_runtime_roots() -> Bool:
	empty = substring(runtime_text(), runtime_index(0), runtime_index(0))
	(
		distinct_runtime_copies(runtime_text(), 0, 9) and distinct_runtime_copies(runtime_text(), 0, 0)
		and distinct_runtime_copies(runtime_text(), 3, 3) and distinct_runtime_copies(runtime_text(), 9, 9)
		and distinct_runtime_copies(empty, 0, 0)
	)


private func escaped_slice() -> String:
	match slice(runtime_text(), runtime_index(1), runtime_index(3)):
		Some(text): text
		None: "failure"


func test_slice_payload_outlives_input() -> Bool:
	escaped_slice() == "é"


pure func test_slice_literal_results_match_runtime_values() -> Bool:
	slice("Aé🙂\0Z", 1, 7) == Some("é🙂") and slice("é", 0, 1) == None


tests: TestSuite = {
	description = "Checked String slicing",
	tests = [
		("slice rejects an endpoint inside a UTF-8 scalar", test_slice_rejects_end_inside_utf8_scalar),
		("slice rejects full-width and reversed bounds", test_slice_rejects_full_width_and_reversed_bounds),
		("slice preserves counted Unicode bytes", test_slice_preserves_counted_unicode_bytes),
		("slice checks empty range boundaries", test_slice_checks_empty_ranges_at_both_endpoints),
		("slice runtime full and empty roots are distinct", test_slice_full_and_empty_results_have_distinct_runtime_roots),
		("slice payload outlives its input", test_slice_payload_outlives_input),
		("slice literals agree with runtime values", test_slice_literal_results_match_runtime_values),
	]
}
