-- Test string case conversion functions
import:
	string: capitalize, equal_ignore_case, from_char, lower, title_case, upper
	test: TestSuite


tests: TestSuite = {
	description = "String Case Conversion",
	tests = [
		("upper basic", test_upper_basic),
		("upper mixed", test_upper_mixed),
		("upper unicode expansion", test_upper_unicode_expansion),
		("upper function ref", test_upper_function_ref),
		("lower basic", test_lower_basic),
		("lower mixed", test_lower_mixed),
		("lower unicode expansion", test_lower_unicode_expansion),
		("lower final sigma", test_lower_final_sigma),
		("lower final sigma context", test_lower_final_sigma_context),
		("upper expanding mappings", test_upper_expanding_mappings),
		("case map long non-ascii text", test_case_map_long_non_ascii_text),
		("capitalize basic", test_capitalize_basic),
		("capitalize edge cases", test_capitalize_edge),
		("equal_ignore_case match", test_equal_ignore_case_match),
		("equal_ignore_case no match", test_equal_ignore_case_no_match),
		("title_case basic", test_title_case_basic),
		("empty strings", test_empty_strings),
		("already cased", test_already_cased),
	]
}


func test_upper_basic() -> Bool:
	result: String = upper("hello world")
	equals(result, "HELLO WORLD")


func test_upper_mixed() -> Bool:
	r1: String = upper("Hello World 123!")
	equals(r1, "HELLO WORLD 123!")


func test_upper_unicode_expansion() -> Bool:
	equals(upper("straße"), "STRASSE") and equals(upper("ﬃ"), "FFI")


func test_upper_function_ref() -> Bool:
	words: List[String] = ["straße"]
	result: List[String] = words.map(upper)
	first: String = result.get_or(0, "")
	equals(first, "STRASSE")


func test_lower_basic() -> Bool:
	result: String = lower("HELLO WORLD")
	equals(result, "hello world")


func test_lower_mixed() -> Bool:
	r1: String = lower("Hello World 123!")
	equals(r1, "hello world 123!")


func test_lower_unicode_expansion() -> Bool:
	result: String = lower("İ")
	equals(result, "i̇") and result.length() == 3 and result.codepoint_length() == 2


func test_lower_final_sigma() -> Bool:
	equals(lower("ΟΣ"), "ος") and equals(lower("Σ"), "σ")


---
Final sigma depends on the letters around it: case-ignorable characters such
as the apostrophe are skipped in both directions, and a following letter
keeps the medial form.
---
func test_lower_final_sigma_context() -> Bool:
	(
		equals(lower("ΟΔΥΣΣΕΥΣ ΚΑΙ"), "οδυσσευς και")
		and equals(lower("ΑΣ'"), "ας'")
		and equals(lower("ΑΣ'Β"), "ασ'β")
		and equals(lower("Α'Σ"), "α'ς")
		and equals(lower("'Σ"), "'σ")
		and equals(lower("ΑΣ1"), "ας1")
		and equals(lower("Σ Σ"), "σ σ")
	)


-- The three code points U+0390 upper-cases to (capital iota, combining
-- diaeresis, combining acute), spelled out so no editor can compose them.
pure func upper_iota_dialytika_tonos() -> String:
	from_char(921.to_char()) + from_char(776.to_char()) + from_char(769.to_char())


func test_upper_expanding_mappings() -> Bool:
	(
		equals(upper("ß"), "SS")
		and equals(upper("ŉ"), "ʼN")
		and equals(upper("ǰ"), "J̌")
		and equals(upper("ΐ"), upper_iota_dialytika_tonos())
		and equals(upper("ﬃ ß é"), "FFI SS É")
		and upper("ΐΐΐ").length() == 18
	)


---
Text longer than any fixed-size scratch space the mapper might use.
---
func test_case_map_long_non_ascii_text() -> Bool:
	var text: String = ""
	var expected_upper: String = ""
	var expected_lower: String = ""

	for i in 0..600:
		text = text + "ßé"
		expected_upper = expected_upper + "SSÉ"
		expected_lower = expected_lower + "ßé"

	(
		equals(upper(text), expected_upper)
		and equals(lower(text), expected_lower)
		and equals(lower(upper(text) + "Σ"), "sséssé".repeat(300) + "ς")
	)


func test_capitalize_basic() -> Bool:
	r1: String = capitalize("hello world")
	r2: String = capitalize("hello WORLD")
	equals(r1, "Hello world") and equals(r2, "Hello world")


func test_capitalize_edge() -> Bool:
	r1: String = capitalize("a")
	r2: String = capitalize("A")
	r3: String = capitalize("123abc")
	equals(r1, "A") and equals(r2, "A") and equals(r3, "123Abc")


func test_equal_ignore_case_match() -> Bool:
	(
		equal_ignore_case("Hello", "hello")
		and equal_ignore_case("HELLO", "hello")
		and equal_ignore_case("straße", "STRASSE")
		and equal_ignore_case("ος", "ΟΣ")
		and equal_ignore_case("hello", "hello")
		and equal_ignore_case("", "")
	)


func test_equal_ignore_case_no_match() -> Bool:
	(
		not equal_ignore_case("hello", "world")
		and not equal_ignore_case("hello", "helloo")
		and not equal_ignore_case("a", "")
	)


func test_title_case_basic() -> Bool:
	r1: String = title_case("hello world")
	r2: String = title_case("HELLO WORLD")
	equals(r1, "Hello World") and equals(r2, "Hello World")


func test_empty_strings() -> Bool:
	(
		equals(upper(""), "")
		and equals(lower(""), "")
		and equals(capitalize(""), "")
		and equal_ignore_case("", "")
	)


func test_already_cased() -> Bool:
	equals(upper("HELLO"), "HELLO") and equals(lower("hello"), "hello")
