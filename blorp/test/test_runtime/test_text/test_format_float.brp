import:
	float as F: format_float, to_string as float_string
	test: TestSuite


NON_FINITE_FLOAT: Float = 0.0 / 0.0


pure func test_basic_precision() -> Bool:
	(
		format_float(3.14159, 2) == "3.14"
		and format_float(3.14159, 6) == "3.141590"
		and format_float(1.0, 0) == "1"
	)


pure func test_negative_value() -> Bool:
	format_float(-73.985656, 6) == "-73.985656"


pure func test_zero_decimals() -> Bool:
	format_float(42.9, 0) == "43"


pure func test_high_precision() -> Bool:
	format_float(1.0, 20) == "1.00000000000000000000"


pure func test_negative_decimals_clamped() -> Bool:
	-- Negative decimals should be clamped to 0
	format_float(3.14, -5) == "3"


pure func test_zero() -> Bool:
	format_float(0.0, 4) == "0.0000"


pure func test_to_string_import() -> Bool:
	by_import: String = float_string(3.14)
	by_qualified: String = F.to_string(2.5)
	whole: String = float_string(150.0)
	by_import == "3.14" and by_qualified == "2.5" and whole == "150"


pure func test_to_string_preserves_round_trip_precision() -> Bool:
	pi: Float = 3.141592653589793
	tiny: Float = 0.0000000000000001

	(
		float_string(pi) == "3.141592653589793"
		and to_float(float_string(pi)) == pi
		and to_float(float_string(tiny)) == tiny
	)


---
Pins the fewest-digits search across each precision class: the short `%g`
form, 7 to 14 digits, 15 to 16 digits, the 17-digit fallback, and the powers
of two and large integers that the search checks one precision at a time.
---
pure func test_to_string_uses_fewest_round_trip_digits() -> Bool:
	(
		float_string(1234567.0) == "1234567"
		and float_string(12345678.9) == "12345678.9"
		and float_string(3.14159265) == "3.14159265"
		and float_string(1.0 / 3.0) == "0.3333333333333333"
		and float_string(100.0 / 7.0) == "14.285714285714286"
		and float_string(0.1 + 0.2) == "0.30000000000000004"
		and float_string(0.0000001 / 3.0) == "3.3333333333333334e-08"
		and float_string(to_float("1e22") / 3.0) == "3.3333333333333335e+21"
		and float_string(to_float("-2.5e-300") / 7.0) == "-3.5714285714285716e-301"
		and float_string(0.000000000931322574615478515625) == "9.313225746154785e-10"
		and float_string(4503599627370497.0) == "4503599627370497"
		and float_string(9007199254740991.0) == "9007199254740991"
		and float_string(to_float("5e-324")) == "4.94066e-324"
		and float_string(-0.0) == "-0"
	)


pure func test_to_string_canonicalizes_non_finite_values() -> Bool:
	(
		float_string(1.0 / 0.0) == "inf"
		and float_string(-1.0 / 0.0) == "-inf"
		and float_string(NON_FINITE_FLOAT) == "nan"
	)


pure func test_format_float_canonicalizes_non_finite_values() -> Bool:
	(
		format_float(1.0 / 0.0, 3) == "inf"
		and format_float(-1.0 / 0.0, 3) == "-inf"
		and format_float(NON_FINITE_FLOAT, 3) == "nan"
	)


tests: TestSuite = {
	description = "format_float builtin",
	tests = [
		("basic precision", test_basic_precision),
		("negative value", test_negative_value),
		("zero decimals", test_zero_decimals),
		("high precision", test_high_precision),
		("negative decimals clamped", test_negative_decimals_clamped),
		("zero", test_zero),
		("to_string import", test_to_string_import),
		("to_string preserves round trip precision", test_to_string_preserves_round_trip_precision),
		("to_string uses fewest round trip digits", test_to_string_uses_fewest_round_trip_digits),
		(
			"to_string canonicalizes non-finite values",
			test_to_string_canonicalizes_non_finite_values,
		),
		(
			"format_float canonicalizes non-finite values",
			test_format_float_canonicalizes_non_finite_values,
		),
	]
}
