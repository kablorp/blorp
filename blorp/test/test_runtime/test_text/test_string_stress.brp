import:
	string: string
	test: TestSuite


-- Stress tests for string operations
func test_capacity_append_large() -> Bool:
	-- Build a large string with capacity-aware accumulation.
	var sb: String = string(5000)
	var i: Int = 0

	while i < 1000:
		sb = sb.append_char('x')
		i += 1

	sb.length() == 1000


func test_accumulator_loop() -> Bool:
	-- Mutable accumulation exercises COW-consuming append lowering.
	var s: String = ""
	var i: Int = 0

	while i < 500:
		s += "x"
		i += 1

	s.length() == 500


func test_large_split() -> Bool:
	-- Build a large comma-separated string, then split
	var parts: List[String] = []
	var i: Int = 0

	while i < 100:
		parts = parts.append(i.to_string())
		i += 1

	s: String = parts.join(",")
	result: List[String] = s.split(",")
	result.length() == 100


tests: TestSuite = {
	description = "String stress tests",
	tests = [
		("capacity append large", test_capacity_append_large),
		("accumulator loop", test_accumulator_loop),
		("large split", test_large_split),
	]
}
