-- Test counted String equality and ordering comparison operators.
import:
	string as StringOps: equals
	test: TestSuite


pure func test_named_equality_preserves_exact_content() -> Bool:
	(
		equals("", "")
		and equals("same", "same")
		and not equals("", "x")
		and not equals("x", "")
		and not equals("prefix", "pre")
		and not equals("pre", "prefix")
		and not equals("same", "sane")
		and equals("é", "é")
		and not equals("é", "ê")
	)


pure func test_named_equality_compares_bytes_after_nul() -> Bool:
	(
		equals("é\0same", "é\0same")
		and not equals("a\0b", "a\0c")
		and not equals("a\0b", "a")
		and not equals("\0", "")
	)


pure func test_named_equality_supports_qualified_and_receiver_calls() -> Bool:
	StringOps.equals("same", "same") and not "same".equals("sane")


pure func test_named_equality_borrows_aliased_mortal_strings() -> Bool:
	value = "mortal".substring(1, 4)
	retained = value
	equals(value, retained) and equals(value, "orta") and retained == "orta"


func test_less_than() -> Bool:
	"apple" < "banana"


func test_greater_than() -> Bool:
	"banana" > "apple"


func test_less_or_equal_same() -> Bool:
	"hello" <= "hello"


func test_less_or_equal_less() -> Bool:
	"aaa" <= "bbb"


func test_greater_or_equal_same() -> Bool:
	"world" >= "world"


func test_greater_or_equal_greater() -> Bool:
	"z" >= "a"


func test_prefix_ordering() -> Bool:
	"abc" < "abcd"


func test_equal_strings_not_less() -> Bool:
	not ("same" < "same")


tests: TestSuite = {
	description = "String Comparison",
	tests = [
		("named equality preserves exact content", test_named_equality_preserves_exact_content),
		("named equality compares bytes after NUL", test_named_equality_compares_bytes_after_nul),
		("named equality supports qualified and receiver calls", test_named_equality_supports_qualified_and_receiver_calls),
		("named equality borrows aliased mortal Strings", test_named_equality_borrows_aliased_mortal_strings),
		("less than", test_less_than),
		("greater than", test_greater_than),
		("le same", test_less_or_equal_same),
		("le less", test_less_or_equal_less),
		("ge same", test_greater_or_equal_same),
		("ge greater", test_greater_or_equal_greater),
		("prefix ordering", test_prefix_ordering),
		("equal not less", test_equal_strings_not_less),
	]
}
