-- Regression test: monomorphization must not rename calls to prelude builtins
-- that share a name with the function being monomorphized.
import:
	deque as DQ: Deque
	test: TestSuite


func test_deque_length() -> Bool:
	var d = DQ.deque()
	d = DQ.push_back(d, 1)
	d = DQ.push_back(d, 2)
	d = DQ.push_back(d, 3)
	DQ.length(d) == 3


func test_deque_is_empty() -> Bool:
	d: Deque[Int] = DQ.deque()
	DQ.is_empty(d)


func test_deque_push_pop() -> Bool:
	var d = DQ.deque()
	d = DQ.push_back(d, 10)
	d = DQ.push_back(d, 20)
	DQ.length(d) == 2


tests: TestSuite = {
	description = "Mono Rename Self",
	tests = [
		("deque length", test_deque_length),
		("deque is_empty", test_deque_is_empty),
		("deque push pop", test_deque_push_pop),
	]
}
