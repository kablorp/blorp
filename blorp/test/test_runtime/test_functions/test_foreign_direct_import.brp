import:
	./ffi_direct_helper: c_ceil
	test: TestSuite


-- Test that foreign functions imported directly work
func test_ceil() -> Bool:
	c_ceil(3.2) == 4.0


func test_ceil_negative() -> Bool:
	c_ceil(-2.8) == -2.0


tests: TestSuite = {
	description = "Direct Foreign Import",
	tests = [("ceil", test_ceil), ("ceil negative", test_ceil_negative)]
}
