-- Regression test: closure dispatch must evaluate the callee expression exactly once.
-- Previously, gen_closure_dispatch emitted gen_expr(callee) twice — once for ->func
-- and once for ->env — causing double evaluation, memory leaks, and potential mismatch.
import:
	test: TestSuite


var call_count: Int = 0


func make_adder(n: Int) -> (Int) -> Int:
	func(x: Int): x + n


func get_fn() -> (Int) -> Int:
	call_count += 1
	make_adder(10)


func test_callee_evaluated_once() -> Bool:
	call_count = 0
	result: Int = get_fn()(32)
	result == 42 and call_count == 1


tests: TestSuite = {
	description = "Closure dispatch eval count",
	tests = [("callee evaluated once", test_callee_evaluated_once)]
}
