import:
	list: all, any, fold_left, fold_right, is_empty, zip
	test: TestSuite


func make_zipped_names() -> List[(Int, String)]:
	nums: List[Int] = [1, 2, 3]
	names: List[String] = ["a", "b", "c"]
	nums.zip(names)


func test_zip_string_values_survive_source_scope() -> Bool:
	result: List[(Int, String)] = make_zipped_names()

	match result.get(1):
		Some(pair):
			pair[0] == 2 and pair[1] == "b"
		None:
			False


-- Test List operations: zip, all, any, is_empty, fold_left, fold_right
tests: TestSuite = {
	description = "List Operations",
	tests = [
		("zip same length", func():
			a: List[Int] = [1, 2, 3]
			b: List[String] = ["a", "b", "c"]
			result: List[(Int, String)] = a.zip(b)
			result.length() == 3 and match result.get(0):
				Some(pair):
					pair[0] == 1 and pair[1] == "a"
				None:
					False
		),
		("zip different length", func():
			a: List[Int] = [1, 2, 3, 4]
			b: List[Int] = [10, 20]
			result: List[(Int, Int)] = a.zip(b)
			result.length() == 2 and match result.get(1):
				Some(pair):
					pair[0] == 2 and pair[1] == 20
				None:
					False
		),
		("zip empty", func():
			a: List[Int] = []
			a
				.zip([1, 2, 3])
				.length() == 0
		),
		("zip string values survive source scope", test_zip_string_values_survive_source_scope),
		("all true", func():
			nums: List[Int] = [2, 4, 6, 8]
			nums.all(pure func(x: Int): x % 2 == 0)
		),
		("all false", func():
			nums: List[Int] = [2, 4, 5, 8]
			not nums.all(pure func(x: Int): x % 2 == 0)
		),
		("all empty", func():
			nums: List[Int] = []
			nums.all(pure func(x: Int): x > 0)
		),
		("any true", func():
			nums: List[Int] = [1, 3, 4, 7]
			nums.any(pure func(x: Int): x % 2 == 0)
		),
		("any false", func():
			nums: List[Int] = [1, 3, 5, 7]
			not nums.any(pure func(x: Int): x % 2 == 0)
		),
		("any empty", func():
			nums: List[Int] = []
			not nums.any(pure func(x: Int): x > 0)
		),
		("is_empty true", func():
			nums: List[Int] = []
			nums.is_empty()
		),
		("is_empty false", func():
			nums: List[Int] = [1]
			not nums.is_empty()
		),
		("fold_left sum", func():
			nums: List[Int] = [1, 2, 3, 4]
			total: Int = nums.fold_left(0, pure func(acc: Int, x: Int) -> Int: acc + x)
			total == 10
		),
		("fold_right sum", func():
			nums: List[Int] = [1, 2, 3, 4]
			total: Int = nums.fold_right(0, pure func(x: Int, acc: Int) -> Int: x + acc)
			total == 10
		),
	]
}
