-- Correctness tests for var desugaring (SSA-like immutable binding chains).
-- Verifies that reassigned vars produce correct VALUES after desugaring,
-- not just correct memory behavior. Each test exercises a specific
-- renaming pattern that could go wrong if versions get confused.
import:
	test: TestSuite


-- Basic: value after reassignment is the new value.
func test_simple_reassign_value() -> Bool:
	var x: Int = 10
	x = 20
	x == 20


-- Chain: multiple reassignments, final value correct.
func test_chain_reassign() -> Bool:
	var x: Int = 1
	x += 1
	x *= 3
	x -= 1
	x == 5


-- String reassignment preserves content.
func test_string_reassign() -> Bool:
	var s: String = "hello"
	s += " world"
	s += "!"
	s == "hello world!"


-- List append chain — each append builds on previous.
func test_list_append_chain() -> Bool:
	var items: List[Int] = [1]
	items = items.append(2)
	items = items.append(3)
	items = items.append(4)
	items.length() == 4


-- Reassignment followed by read in expression.
func test_reassign_then_use_in_expr() -> Bool:
	var a: Int = 5
	a = 10
	var b: Int = a + 1
	b == 11


-- Two independent vars reassigned in same scope.
func test_two_vars_independent() -> Bool:
	var x: Int = 1
	var y: Int = 2
	x = 10
	y = 20
	x + y == 30


-- Var used in function call after reassignment.
func test_reassign_then_call() -> Bool:
	var items: List[Int] = [1, 2, 3]
	items = items.append(4)
	items
		.length()
		.to_string() == "4"


-- Immutable binding after mutable — verifies last version used.
func test_immutable_after_mutable() -> Bool:
	var x: Int = 1
	x = 2
	x = 3
	y: Int = x * 10
	y == 30


tests: TestSuite = {
	description = "Var desugaring correctness",
	tests = [
		("simple reassign value", test_simple_reassign_value),
		("chain reassign", test_chain_reassign),
		("string reassign", test_string_reassign),
		("list append chain", test_list_append_chain),
		("reassign then use in expr", test_reassign_then_use_in_expr),
		("two vars independent", test_two_vars_independent),
		("reassign then call", test_reassign_then_call),
		("immutable after mutable", test_immutable_after_mutable),
	]
}
