-- Runtime: built-in Hashable impls for primitive types return
-- deterministic values within a run. Two calls with equal inputs
-- must agree on the hash (contract: a == b ⇒ hash(a) == hash(b)).
-- Absolute values aren't asserted — the runtime seeds its hash
-- function at process start, so hashes vary between runs.
import:
	test: TestSuite


pure func test_int_hash_deterministic() -> Bool:
	42.hash() == 42.hash()


pure func test_int_hash_differs_for_distinct() -> Bool:
	1.hash() != 2.hash() or 1.hash() != 3.hash()


pure func test_string_hash_deterministic() -> Bool:
	"hello".hash() == "hello".hash()


pure func test_string_hash_differs_for_distinct() -> Bool:
	"hello".hash() != "world".hash() or "hello".hash() != "goodbye".hash()


pure func test_bool_hash_deterministic() -> Bool:
	True.hash() == True.hash() and False.hash() == False.hash()


pure func test_hash_through_bound[T:Hashable](a: T, b: T) -> Bool:
	if a == b:
		a.hash() == b.hash()
	else:
		True


pure func test_bound_int_equal_hash() -> Bool:
	test_hash_through_bound(5, 5)


pure func test_bound_string_equal_hash() -> Bool:
	test_hash_through_bound("foo", "foo")


tests: TestSuite = {
	description = "Hashable primitives",
	tests = [
		("int deterministic", test_int_hash_deterministic),
		("int differs", test_int_hash_differs_for_distinct),
		("string deterministic", test_string_hash_deterministic),
		("string differs", test_string_hash_differs_for_distinct),
		("bool deterministic", test_bool_hash_deterministic),
		("bound int equal hash", test_bound_int_equal_hash),
		("bound string equal hash", test_bound_string_equal_hash),
	]
}
