-- Test closure capturing a record with generic fields
import:
	test: TestSuite


record Pair[T] {
	first: T,
	second: T
}


func test_closure_captures_generic_record() -> Bool:
	-- Closure accessing generic record fields should compile correctly
	p: Pair[Float] = {
		first = 3.14,
		second = 2.71
	}
	f: () -> Float = func(): p.first + p.second
	result: Float = f()
	result > 5.0


func test_closure_captures_int_record() -> Bool:
	p: Pair[Int] = {
		first = 10,
		second = 20
	}
	f: () -> Int = func(): p.first + p.second
	f() == 30


tests: TestSuite = {
	description = "Closure generic record capture",
	tests = [
		("closure captures generic float record", test_closure_captures_generic_record),
		("closure captures generic int record", test_closure_captures_int_record),
	]
}
