import:
	./ffi_helper: ffi_floor
	test: TestSuite


-- Test that foreign functions accessed through wrapper imports work
func test_ffi_floor() -> Bool:
	ffi_floor(3.7) == 3.0


func test_ffi_floor_negative() -> Bool:
	ffi_floor(-2.3) == -3.0


tests: TestSuite = {
	description = "Foreign Function Import",
	tests = [("ffi floor", test_ffi_floor), ("ffi floor negative", test_ffi_floor_negative)]
}
