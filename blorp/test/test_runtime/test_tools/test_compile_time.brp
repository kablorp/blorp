import:
	list as L
	option: Option(Some, None)
	result: Result(Ok, Err), from_option
	test: TestSuite


union CompileTimeChoice:
	ChoiceValue(Int)
	ChoiceEmpty


record CompileTimePoint {
	x: Int,
	y: Int
}


private pure func compile_time_double(value: Int) -> Int:
	value * 2


private pure func compile_time_block_value(value: Int) -> Int:
	inner: Int = value + 1
	compile_time_double(inner)


private pure func compile_time_label(prefix: String) -> String:
	prefix + "_call"


SCOPE_GLOBAL_X: Int = 1


private pure func compile_time_read_scope_global() -> Int:
	SCOPE_GLOBAL_X


private pure func compile_time_outer_with_shadowed_param(SCOPE_GLOBAL_X: Int) -> Int:
	compile_time_read_scope_global()


private pure func compile_time_interpolate(prefix: String, suffix: String) -> String:
	"${prefix}_${suffix}"


private pure func choice_score(choice: CompileTimeChoice) -> Int:
	match choice:
		ChoiceValue(value):
			value + 1
		ChoiceEmpty:
			0


private pure func compile_time_list_sum(values: List[Int]) -> Int:
	var total: Int = 0

	for value in values:
		total += value

	total


private pure func compile_time_range_sum(limit: Int) -> Int:
	var total: Int = 0

	for value in 0..limit:
		total += value

	total


private pure func compile_time_while_sum(limit: Int) -> Int:
	var index: Int = 0
	var total: Int = 0

	while index < limit:
		total += index
		index += 1

	total


private pure func compile_time_break_continue_sum(limit: Int) -> Int:
	var total: Int = 0

	for value in 0..limit:
		if value == 6:
			break

		if value % 2 == 0:
			continue

		total += value

	total


private pure func compile_time_reverse_range_sum(start: Int, stop: Int) -> Int:
	var total: Int = 0

	for value in start..stop:
		total += value

	total


private pure func compile_time_nested_break_count() -> Int:
	var count: Int = 0

	for left in 0..3:
		for right in 0..3:
			if right == 2:
				break

			count += left + right

	count


private pure func compile_time_if_statement(values: List[Int]) -> Int:
	var total: Int = 0

	for value in values:
		if value > 0:
			total += value

	total


private pure func compile_time_apply(
	value: Int,
	f: pure (Int) -> Int,
) -> Int:
	f(value)


private pure func compile_time_add_22(value: Int) -> Int:
	value + 22


private pure func compile_time_callback_capture(offset: Int) -> Int:
	compile_time_apply(20, func(value: Int): value + offset)


private pure func compile_time_shift_y(point: CompileTimePoint) -> CompileTimePoint:
	{ point | y = point.y + 1 }


private pure func compile_time_tuple_sum(pair: (Int, Int)) -> Int:
	(left, right) = pair
	left + right


private pure func compile_time_pattern_pair((left, right): (Int, Int)) -> Int:
	left * 2 + right


private pure func compile_time_factorial(value: Int) -> Int:
	if value <= 1:
		1
	else:
		value * compile_time_factorial(value - 1)


private pure func compile_time_float_calc(value: Float) -> Float:
	(value * 2.0 - 1.5) / 2.0


private pure func compile_time_build_list(limit: Int) -> List[Int]:
	var values: List[Int] = L.list(limit)

	for value in 0..limit:
		values = L.append(values, value * 2)

	values
		.set(1, 20)
		.concat([8])


private pure func compile_time_build_dict() -> Dict[String, Int]:
	var base: Dict[String, Int] = {}

	base = base.set("a", 1)
	base = base.set("b", 2)
	base = base.set("a", 40)

	base.set(
		"c",
		base.get_or("missing", 2),
	)


private pure func compile_time_option_question_bind(
	left: Option[Int],
	right: Option[Int],
) -> Option[Int]:
	left_value ?= left
	right_value ?= right
	Some(left_value + right_value)


private pure func compile_time_result_question_bind(
	left: Result[Int, String],
	right: Result[Int, String],
) -> Result[Int, String]:
	left_value ?= left
	right_value ?= right
	Ok(left_value + right_value)


private BASE: Int = 1 + 2

ANSWER: Int = BASE * 14

FLOAT_VALUE: Float = compile_time_float_calc(3.5)

FLOAT_COMPARISON: Bool = FLOAT_VALUE > 2.0 and -FLOAT_VALUE < -2.0

LABEL: String = "compile" + "_time"

LABEL_LENGTH: Int = LABEL.length()

LABEL_PREFIX: Bool = LABEL.starts_with("compile")

LABEL_SUFFIX: Bool = LABEL.ends_with("time")

LABEL_CONTAINS: Bool = LABEL.contains("_")

LABEL_INDEX: Int = LABEL.raw_index_of("_")

LABEL_SLICE: String = LABEL.substring(8, 4)

LABEL_OPTION_INDEX: Option[Int] = LABEL.index_of("_")

LABEL_MISSING_INDEX: Option[Int] = LABEL.index_of("missing")

LABEL_FIRST_CHAR: Option[Char] = LABEL.get(0)

LABEL_MISSING_CHAR: Option[Char] = LABEL.get(99)

LABEL_FALLBACK_CHAR: Char = LABEL.get_or(99, '?')

LABEL_DROP_LEFT: String = LABEL.drop_left(8)

LABEL_TAKE_LEFT: String = LABEL.take_left(7)

LABEL_TRIMMED: String = "\t compile_time \n".trim()

LABEL_TRIMMED_LEFT: String = "\t compile_time ".trim_left()

LABEL_TRIMMED_RIGHT: String = " compile_time \n".trim_right()

LABEL_REVERSED: String = LABEL.reverse()

LABEL_COUNT: Int = "aaaa".count("aa")

LABEL_SPLIT: List[String] = "compile,time,".split(",")

LABEL_SPLIT_EMPTY_DELIM: List[String] = LABEL.split("")

LABEL_REPLACE_LONGER: String = "ab".replace("a", "xyz")

LABEL_REPLACE_SHORTER: String = "aaa".replace("aa", "b")

LABEL_REPLACE_EMPTY: String = "hello".replace("l", "")

LABEL_JOINED_UPPER: String = ["these", "args"]
	.join("AHHH")
	.upper()

LABEL_JOINED_LOWER: String = ["THESE", "ARGS"]
	.join("ahhh")
	.lower()

LABEL_FROM_CHAR: String = from_char('Z')

LABEL_CHARS: List[Char] = "az".chars()

LABEL_FROM_CHARS: String = from_chars(['o', 'k'])

REPEATED_LABEL: String = "ha".repeat(2)

INTERP_LABEL: String = "${LABEL}_value"

INTERP_PRIMITIVES: String = "n=${ANSWER}, flag=${True}, char=${'Z'}"

INTERP_FLOAT: String = "float=${FLOAT_VALUE}"

TO_STRING_VALUES: String = ANSWER.to_string() + "|" + FLOAT_VALUE.to_string() + "|" + True.to_string() + "|" + 'Z'.to_string()

FLAGS: List[Bool] = [True, False, ANSWER == 42]

VECTOR_VALUES: Int[#3] = {1, 2, 3}

VECTOR_SECOND: Int = VECTOR_VALUES[1]

CALL_VALUE: Int = compile_time_block_value(20)

CALL_LABEL: String = compile_time_label("pure")

CALL_INTERP_LABEL: String = compile_time_interpolate("pure", "interp")

CHOICE: CompileTimeChoice = ChoiceValue(41)

EMPTY_CHOICE: CompileTimeChoice = ChoiceEmpty

CHOICE_SCORE: Int = choice_score(CHOICE)

EMPTY_SCORE: Int = choice_score(EMPTY_CHOICE)

MAYBE: Option[Int] = Some(41)

OPTION_SCORE: Int = match MAYBE:
	Some(value):
		value + 1
	None:
		0

NONE_VALUE: Option[Int] = None

NONE_SCORE: Int = match NONE_VALUE:
	Some(value):
		value
	None:
		0

LIST_SUM: Int = compile_time_list_sum([10, 20, 12])

RANGE_SUM: Int = compile_time_range_sum(5)

RANGE_VALUE_START: Int = (2..6).start

RANGE_VALUE_END: Int = (2..6).end

REVERSE_RANGE_VALUE_START: Int = (5..2).start

REVERSE_RANGE_VALUE_END: Int = (5..2).end

WHILE_SUM: Int = compile_time_while_sum(5)

BREAK_CONTINUE_SUM: Int = compile_time_break_continue_sum(10)

REVERSE_RANGE_SUM: Int = compile_time_reverse_range_sum(5, 2)

NESTED_BREAK_COUNT: Int = compile_time_nested_break_count()

IF_STATEMENT_SUM: Int = compile_time_if_statement([-10, 20, 22])

INLINE_CALLBACK: Int = compile_time_apply(20, func(value: Int): value + 22)

CAPTURED_CALLBACK: Int = compile_time_callback_capture(22)

NAMED_CALLBACK: Int = compile_time_apply(20, compile_time_add_22)

LEXICAL_GLOBAL_READ: Int = compile_time_outer_with_shadowed_param(2)

LEXICAL_CALLBACK_VALUES: List[Int] = [2].map(
	func(SCOPE_GLOBAL_X: Int) -> Int: compile_time_read_scope_global(),
)

LEXICAL_FUNCTION_REFERENCE: pure () -> Int = compile_time_read_scope_global

LEXICAL_FUNCTION_REFERENCE_CALL: Int = LEXICAL_FUNCTION_REFERENCE()

POINT: CompileTimePoint = {
	x = 10,
	y = 31
}

SHIFTED_POINT: CompileTimePoint = compile_time_shift_y({ POINT | x = 11 })

TUPLE_SUM: Int = compile_time_tuple_sum((20, 22))

PATTERN_PARAM_SCORE: Int = compile_time_pattern_pair((20, 2))

TUPLE_SECOND: Int = (20, 22)[1]

FACTORIAL_FIVE: Int = compile_time_factorial(5)

BUILT_LIST: List[Int] = compile_time_build_list(3)

BUILT_LIST_SECOND: Int = BUILT_LIST.get_or(1, 0)

BUILT_LIST_LENGTH: Int = BUILT_LIST.length()

BUILT_LIST_HAS_EIGHT: Bool = BUILT_LIST.contains(8)

BUILT_LIST_OPTION: Option[Int] = BUILT_LIST.get(1)

BUILT_LIST_MISSING: Option[Int] = BUILT_LIST.get(99)

BUILT_LIST_MAPPED: List[Int] = BUILT_LIST.map(func(value: Int) -> Int: value + 1)

BUILT_LIST_NAMED_MAPPED: List[Int] = BUILT_LIST.map(compile_time_add_22)

BUILT_LIST_FILTERED: List[Int] = BUILT_LIST.filter(func(value: Int) -> Bool: value > 5)

BUILT_LIST_FILTER_MAPPED: List[String] = BUILT_LIST.filter_map(func(value: Int) -> Option[String]:
	if value > 5:
		Some("large")
	else:
		None
)

BUILT_LIST_FLAT_MAPPED: List[Int] = BUILT_LIST.flat_map(
	func(value: Int) -> List[Int]: [value, value + 1],
)

BUILT_LIST_INDEXED: List[Int] = BUILT_LIST.map_indexed(
	func(index: Int, value: Int) -> Int: index + value,
)

BUILT_LIST_FOLD_LEFT: Int = BUILT_LIST.fold_left(
	0,
	func(total: Int, value: Int) -> Int: total + value,
)

BUILT_LIST_WORDS: List[String] = ["a", "b", "c"]

BUILT_LIST_FOLD_RIGHT: String = BUILT_LIST_WORDS.fold_right(
	"",
	func(value: String, text: String) -> String: text + value,
)

BUILT_LIST_TO_STRING_FOLD: String = [1, 2, 3].fold_right(
	"",
	func(value: Int, text: String) -> String: text + value.to_string(),
)

BUILT_LIST_ALL_NON_NEGATIVE: Bool = BUILT_LIST.all(func(value: Int) -> Bool: value >= 0)

BUILT_LIST_ANY_LARGE: Bool = BUILT_LIST.any(func(value: Int) -> Bool: value > 10)

BUILT_LIST_OPTION_SCORE: Int = match BUILT_LIST_OPTION:
	Some(value):
		value + 22
	None:
		0

BUILT_LIST_MISSING_SCORE: Int = match BUILT_LIST_MISSING:
	Some(value):
		value
	None:
		42

BUILT_DICT: Dict[String, Int] = compile_time_build_dict()

BUILT_DICT_A: Int = BUILT_DICT.get_or("a", 0)

BUILT_DICT_LENGTH: Int = BUILT_DICT.length()

BUILT_DICT_HAS_C: Bool = BUILT_DICT.contains("c")

BUILT_DICT_OPTION: Option[Int] = BUILT_DICT.get("a")

BUILT_DICT_MISSING: Option[Int] = BUILT_DICT.get("missing")

BUILT_DICT_OPTION_SCORE: Int = match BUILT_DICT_OPTION:
	Some(value):
		value + 2
	None:
		0

BUILT_DICT_MISSING_SCORE: Int = match BUILT_DICT_MISSING:
	Some(value):
		value
	None:
		42

RESULT_FROM_SOME: Result[Int, String] = BUILT_DICT_OPTION.to_result("missing")

RESULT_FROM_NONE: Result[Int, String] = BUILT_DICT_MISSING.to_result("missing")

RESULT_FROM_OPTION_SOME: Result[Int, String] = from_option(BUILT_DICT_OPTION, "missing")

RESULT_FROM_OPTION_NONE: Result[Int, String] = from_option(BUILT_DICT_MISSING, "missing")

RESULT_FROM_SOME_SCORE: Int = match RESULT_FROM_SOME:
	Ok(value):
		value + 2
	Err(_):
		0

RESULT_FROM_NONE_TEXT: String = match RESULT_FROM_NONE:
	Ok(_):
		"bad"
	Err(value):
		value

RESULT_FROM_OPTION_SOME_SCORE: Int = match RESULT_FROM_OPTION_SOME:
	Ok(value):
		value + 2
	Err(_):
		0

RESULT_FROM_OPTION_NONE_TEXT: String = match RESULT_FROM_OPTION_NONE:
	Ok(_):
		"bad"
	Err(value):
		value

RESULT_FROM_SOME_OR: Int = RESULT_FROM_SOME.get_or(0)

RESULT_FROM_NONE_OR: Int = RESULT_FROM_NONE.get_or(42)

RESULT_FROM_SOME_IS_OK: Bool = RESULT_FROM_SOME.is_ok()

RESULT_FROM_NONE_IS_ERR: Bool = RESULT_FROM_NONE.is_err()

RESULT_TO_OPTION_SOME: Option[Int] = RESULT_FROM_SOME.to_option()

RESULT_TO_OPTION_NONE: Option[Int] = RESULT_FROM_NONE.to_option()

RESULT_TO_OPTION_SOME_SCORE: Int = match RESULT_TO_OPTION_SOME:
	Some(value):
		value + 2
	None:
		0

RESULT_TO_OPTION_NONE_SCORE: Int = match RESULT_TO_OPTION_NONE:
	Some(value):
		value
	None:
		42

OPTION_MAP_SCORE: Int = match BUILT_LIST_OPTION.map(func(value: Int) -> Int: value + 22):
	Some(value):
		value
	None:
		0

OPTION_FILTER_KEEP_SCORE: Int = match BUILT_DICT_OPTION.filter(
	func(value: Int) -> Bool: value > 30,
):
	Some(value):
		value + 2
	None:
		0

OPTION_FILTER_DROP_SCORE: Int = match BUILT_LIST_OPTION.filter(
	func(value: Int) -> Bool: value > 40,
):
	Some(value):
		value
	None:
		42

OPTION_AND_THEN_SCORE: Int = match BUILT_LIST_OPTION.and_then(
	func(value: Int) -> Option[Int]: Some(value + 22),
):
	Some(value):
		value
	None:
		0

OPTION_DEFAULT_LAZY: Int = BUILT_LIST_MISSING.get_or_else(func() -> Int: 42)

RESULT_MAP_SCORE: Int = match RESULT_FROM_SOME.map(func(value: Int) -> Int: value + 2):
	Ok(value):
		value
	Err(_):
		0

RESULT_MAP_ERR_TEXT: String = match RESULT_FROM_NONE.map_err(
	func(value: String) -> String: value + "!",
):
	Ok(_):
		"bad"
	Err(value):
		value

RESULT_AND_THEN_SCORE: Int = match RESULT_FROM_SOME.and_then(
	func(value: Int) -> Result[Int, String]: Ok(value + 2),
):
	Ok(value):
		value
	Err(_):
		0

RESULT_DEFAULT_LAZY: Int = RESULT_FROM_NONE.get_or_else(func(error: String) -> Int:
	if error == "missing":
		42
	else:
		0
)

BUILT_LIST_OPTION_IS_SOME: Bool = BUILT_LIST_OPTION.is_some()

BUILT_LIST_MISSING_IS_NONE: Bool = BUILT_LIST_MISSING.is_none()

QUESTION_OPTION_SOME: Option[Int] = compile_time_option_question_bind(Some(20), Some(22))

QUESTION_OPTION_NONE: Option[Int] = compile_time_option_question_bind(Some(20), None)

QUESTION_RESULT_OK: Result[Int, String] = compile_time_result_question_bind(Ok(20), Ok(22))

QUESTION_RESULT_ERR: Result[Int, String] = compile_time_result_question_bind(Ok(20), Err("stop"))


func test_compile_time_arithmetic() -> Bool:
	ANSWER == 42


func test_compile_time_float_arithmetic() -> Bool:
	FLOAT_VALUE == 2.75 and FLOAT_COMPARISON


func test_compile_time_string() -> Bool:
	(
		LABEL == "compile_time"
		and LABEL_LENGTH == 12
		and LABEL_PREFIX
		and LABEL_SUFFIX
		and LABEL_CONTAINS
		and LABEL_INDEX == 7
		and LABEL_SLICE == "time"
		and match LABEL_OPTION_INDEX:
			Some(index):
				index == 7
			None:
				False
		and match LABEL_MISSING_INDEX:
			Some(_):
				False
			None:
				True
		and match LABEL_FIRST_CHAR:
			Some(char):
				char == 'c'
			None:
				False
		and match LABEL_MISSING_CHAR:
			Some(_):
				False
			None:
				True
		and LABEL_FALLBACK_CHAR == '?'
		and LABEL_DROP_LEFT == "time"
		and LABEL_TAKE_LEFT == "compile"
		and LABEL_TRIMMED == "compile_time"
		and LABEL_TRIMMED_LEFT == "compile_time "
		and LABEL_TRIMMED_RIGHT == " compile_time"
		and LABEL_REVERSED == "emit_elipmoc"
		and LABEL_COUNT == 2
		and LABEL_SPLIT == ["compile", "time", ""]
		and LABEL_SPLIT_EMPTY_DELIM == ["compile_time"]
		and LABEL_REPLACE_LONGER == "xyzb"
		and LABEL_REPLACE_SHORTER == "ba"
		and LABEL_REPLACE_EMPTY == "heo"
		and LABEL_JOINED_UPPER == "THESEAHHHARGS"
		and LABEL_JOINED_LOWER == "theseahhhargs"
		and LABEL_FROM_CHAR == "Z"
		and LABEL_CHARS == ['a', 'z']
		and LABEL_FROM_CHARS == "ok"
		and REPEATED_LABEL == "haha"
	)


func test_compile_time_string_interp() -> Bool:
	(
		INTERP_LABEL == "compile_time_value"
		and CALL_INTERP_LABEL == "pure_interp"
		and INTERP_PRIMITIVES == "n=42, flag=True, char=Z"
		and INTERP_FLOAT == "float=2.75"
		and TO_STRING_VALUES == "42|2.75|True|Z"
	)


func test_compile_time_list() -> Bool:
	FLAGS.length() == 3


func test_compile_time_vector_literal() -> Bool:
	VECTOR_VALUES[0] == 1 and VECTOR_VALUES[1] == 2 and VECTOR_VALUES[2] == 3 and VECTOR_SECOND == 2


func test_compile_time_pure_call() -> Bool:
	CALL_VALUE == 42


func test_compile_time_pure_string_call() -> Bool:
	CALL_LABEL == "pure_call"


func test_compile_time_union_match() -> Bool:
	CHOICE_SCORE == 42 and EMPTY_SCORE == 0 and choice_score(CHOICE) == 42


func test_compile_time_option_match() -> Bool:
	OPTION_SCORE == 42 and NONE_SCORE == 0


func test_compile_time_for_list() -> Bool:
	LIST_SUM == 42


func test_compile_time_for_range() -> Bool:
	RANGE_SUM == 10


func test_compile_time_range_value_fields() -> Bool:
	expected_ascending_start: Int = 2
	expected_ascending_end: Int = 6
	expected_descending_start: Int = 5
	expected_descending_end: Int = 2

	(
		RANGE_VALUE_START == expected_ascending_start
		and RANGE_VALUE_END == expected_ascending_end
		and REVERSE_RANGE_VALUE_START == expected_descending_start
		and REVERSE_RANGE_VALUE_END == expected_descending_end
	)


func test_compile_time_while() -> Bool:
	WHILE_SUM == 10


func test_compile_time_loop_control() -> Bool:
	expected_break_continue_sum: Int = 1 + 3 + 5
	expected_reverse_range_sum: Int = 5 + 4 + 3
	expected_nested_break_count: Int = 0 + 1 + 1 + 2 + 2 + 3

	(
		BREAK_CONTINUE_SUM == expected_break_continue_sum
		and REVERSE_RANGE_SUM == expected_reverse_range_sum
		and NESTED_BREAK_COUNT == expected_nested_break_count
	)


func test_compile_time_if_statement() -> Bool:
	IF_STATEMENT_SUM == 42


func test_compile_time_lambda_callback() -> Bool:
	INLINE_CALLBACK == 42 and CAPTURED_CALLBACK == 42 and NAMED_CALLBACK == 42


func test_compile_time_lexical_scope() -> Bool:
	(
		LEXICAL_GLOBAL_READ == 1
		and LEXICAL_CALLBACK_VALUES.get_or(0, 0) == 1
		and LEXICAL_FUNCTION_REFERENCE_CALL == 1
	)


func test_compile_time_record_update() -> Bool:
	SHIFTED_POINT.x == 11 and SHIFTED_POINT.y == 32


func test_compile_time_tuple_destructure() -> Bool:
	TUPLE_SUM == 42 and PATTERN_PARAM_SCORE == 42 and TUPLE_SECOND == 22


func test_compile_time_recursion() -> Bool:
	FACTORIAL_FIVE == 120


func test_compile_time_collection_builders() -> Bool:
	(
		BUILT_LIST_SECOND == 20
		and BUILT_LIST_LENGTH == 4
		and BUILT_LIST_HAS_EIGHT
		and BUILT_LIST_MAPPED.get_or(1, 0) == 21
		and BUILT_LIST_NAMED_MAPPED.get_or(1, 0) == 42
		and BUILT_LIST_FILTERED.length() == 2
		and BUILT_LIST_FILTER_MAPPED.get_or(0, "") == "large"
		and BUILT_LIST_FLAT_MAPPED.length() == 8
		and BUILT_LIST_INDEXED.get_or(1, 0) == 21
		and BUILT_LIST_FOLD_LEFT == 32
		and BUILT_LIST_FOLD_RIGHT == "cba"
		and BUILT_LIST_TO_STRING_FOLD == "321"
		and BUILT_LIST_ALL_NON_NEGATIVE
		and BUILT_LIST_ANY_LARGE
		and BUILT_LIST_OPTION_SCORE == 42
		and BUILT_LIST_MISSING_SCORE == 42
		and BUILT_DICT_A == 40
		and BUILT_DICT_LENGTH == 3
		and BUILT_DICT_HAS_C
		and BUILT_DICT_OPTION_SCORE == 42
		and BUILT_DICT_MISSING_SCORE == 42
		and BUILT_DICT.get_or("b", 0) == 2
		and BUILT_DICT.get_or("c", 0) == 2
		and RESULT_FROM_SOME_SCORE == 42
		and RESULT_FROM_NONE_TEXT == "missing"
		and RESULT_FROM_SOME_OR == 40
		and RESULT_FROM_NONE_OR == 42
		and RESULT_FROM_SOME_IS_OK
		and RESULT_FROM_NONE_IS_ERR
		and RESULT_FROM_OPTION_SOME_SCORE == 42
		and RESULT_FROM_OPTION_NONE_TEXT == "missing"
		and RESULT_TO_OPTION_SOME_SCORE == 42
		and RESULT_TO_OPTION_NONE_SCORE == 42
		and OPTION_MAP_SCORE == 42
		and OPTION_FILTER_KEEP_SCORE == 42
		and OPTION_FILTER_DROP_SCORE == 42
		and OPTION_AND_THEN_SCORE == 42
		and OPTION_DEFAULT_LAZY == 42
		and RESULT_MAP_SCORE == 42
		and RESULT_MAP_ERR_TEXT == "missing!"
		and RESULT_AND_THEN_SCORE == 42
		and RESULT_DEFAULT_LAZY == 42
		and BUILT_LIST_OPTION_IS_SOME
		and BUILT_LIST_MISSING_IS_NONE
	)


func test_compile_time_question_bind() -> Bool:
	option_some_ok: Bool = match QUESTION_OPTION_SOME:
		Some(value):
			value == 42
		None:
			False

	option_none_ok: Bool = match QUESTION_OPTION_NONE:
		Some(_):
			False
		None:
			True

	result_ok_ok: Bool = match QUESTION_RESULT_OK:
		Ok(value):
			value == 42
		Err(_):
			False

	result_err_ok: Bool = match QUESTION_RESULT_ERR:
		Ok(_):
			False
		Err(value):
			value == "stop"

	option_some_ok and option_none_ok and result_ok_ok and result_err_ok


tests: TestSuite = {
	description = "constant evaluation",
	tests = [
		("arithmetic", test_compile_time_arithmetic),
		("float_arithmetic", test_compile_time_float_arithmetic),
