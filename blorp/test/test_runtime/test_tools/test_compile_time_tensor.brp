import:
	matrix: column_count, row_count
	test: TestSuite


VALUES: Int[#2, #3] = {
	{1, 2, 3},
	{4, 5, 6},
}

ROW: Int[#3] = VALUES[1]

CELL: Int = VALUES[1, 2]

VALUES_3D: Int[#2, #2, #2] = {
	{
		{1, 2},
		{3, 4},
	},
	{
		{5, 6},
		{7, 8},
	},
}

PLANE_3D: Int[#2, #2] = VALUES_3D[1]

ROW_3D: Int[#2] = VALUES_3D[1][0]

CELL_3D: Int = VALUES_3D[1, 0, 1]

VECTOR_FILLED: Int[#3] = vector(7, 3)

MATRIX_FILLED: Int[#2, #3] = matrix(9, 2, 3)

TENSOR3_FILLED: Int[#2, #2, #2] = tensor3(4, 2, 2, 2)

TENSOR3_FILLED_CELL: Int = TENSOR3_FILLED[1, 0, 1]

TENSOR5_FILLED: Int[#2, #1, #1, #1, #2] = tensor5(8, 2, 1, 1, 1, 2)

TENSOR5_FILLED_CELL: Int = TENSOR5_FILLED[1, 0, 0, 0, 1]

NEGATIVE_MATRIX_CELL: Int = VALUES[-1, -1]

NEGATIVE_TENSOR3_CELL: Int = VALUES_3D[-1, -1, -1]

NEGATIVE_TENSOR5_CELL: Int = TENSOR5_FILLED[-1, -1, -1, -1, -1]

VECTOR_LENGTH: Int = VECTOR_FILLED.length()

MATRIX_LENGTH: Int = MATRIX_FILLED.length()

TENSOR3_LENGTH: Int = TENSOR3_FILLED.length()

MATRIX_ROWS: Int = MATRIX_FILLED.row_count()

MATRIX_COLUMNS: Int = MATRIX_FILLED.column_count()

COMPILE_TIME_ROW: Int[#3] = VALUES[0]

COMPILE_TIME_CELL: Int = VALUES[0, 1]

COMPILE_TIME_CELL_3D: Int = VALUES_3D[0, 1, 1]

COMPILE_TIME_VECTOR_FILLED: Int[#3] = vector(5, 3)

COMPILE_TIME_MATRIX_FILLED: Int[#2, #3] = matrix(6, 2, 3)

COMPILE_TIME_VECTOR_LENGTH: Int = COMPILE_TIME_VECTOR_FILLED.length()

COMPILE_TIME_MATRIX_LENGTH: Int = COMPILE_TIME_MATRIX_FILLED.length()

COMPILE_TIME_MATRIX_ROWS: Int = COMPILE_TIME_MATRIX_FILLED.row_count()

COMPILE_TIME_MATRIX_COLUMNS: Int = COMPILE_TIME_MATRIX_FILLED.column_count()


func test_global_matrix_subscripts() -> Bool:
	ROW[0] == 4 and ROW[2] == 6 and CELL == 6


func test_compile_time_matrix_subscripts() -> Bool:
	COMPILE_TIME_ROW[0] == 1 and COMPILE_TIME_ROW[2] == 3 and COMPILE_TIME_CELL == 2


func test_global_tensor3_subscripts() -> Bool:
	PLANE_3D[1, 1] == 8 and ROW_3D[0] == 5 and CELL_3D == 6


func test_compile_time_tensor3_subscripts() -> Bool:
	COMPILE_TIME_CELL_3D == 4


func test_global_tensor_constructors() -> Bool:
	(
		VECTOR_FILLED[2] == 7
		and MATRIX_FILLED[1, 2] == 9
		and TENSOR3_FILLED_CELL == 4
		and TENSOR5_FILLED_CELL == 8
	)


func test_global_negative_tensor_subscripts() -> Bool:
	NEGATIVE_MATRIX_CELL == 6 and NEGATIVE_TENSOR3_CELL == 8 and NEGATIVE_TENSOR5_CELL == 8


func test_compile_time_tensor_constructors() -> Bool:
	COMPILE_TIME_VECTOR_FILLED[2] == 5 and COMPILE_TIME_MATRIX_FILLED[1, 2] == 6


func test_global_tensor_lengths() -> Bool:
	VECTOR_LENGTH == 3 and MATRIX_LENGTH == 2 and TENSOR3_LENGTH == 2


func test_compile_time_tensor_lengths() -> Bool:
	COMPILE_TIME_VECTOR_LENGTH == 3 and COMPILE_TIME_MATRIX_LENGTH == 2


func test_global_matrix_shape_counts() -> Bool:
	MATRIX_ROWS == 2 and MATRIX_COLUMNS == 3


func test_compile_time_matrix_shape_counts() -> Bool:
	COMPILE_TIME_MATRIX_ROWS == 2 and COMPILE_TIME_MATRIX_COLUMNS == 3


tests: TestSuite = {
	description = "constant evaluation tensor",
	tests = [
		("global_matrix_subscripts", test_global_matrix_subscripts),
		("compile_time_matrix_subscripts", test_compile_time_matrix_subscripts),
		("global_tensor3_subscripts", test_global_tensor3_subscripts),
		("compile_time_tensor3_subscripts", test_compile_time_tensor3_subscripts),
		("global_tensor_constructors", test_global_tensor_constructors),
		("global_negative_tensor_subscripts", test_global_negative_tensor_subscripts),
		("compile_time_tensor_constructors", test_compile_time_tensor_constructors),
		("global_tensor_lengths", test_global_tensor_lengths),
		("compile_time_tensor_lengths", test_compile_time_tensor_lengths),
		("global_matrix_shape_counts", test_global_matrix_shape_counts),
		("compile_time_matrix_shape_counts", test_compile_time_matrix_shape_counts),
	]
}
