import:
	./helpers/compile_time_imports as CT:
		BASE_WORDS,
		IMPORTED_BASE as IMPORTED_BASE_ALIAS,
		imported_plus,
		imported_reads_private,
		imported_reads_qualified_dependency,
		join_upper,
	float: to_float16, to_float32
	list as L
	matrix: column_count, row_count
	option: Option(Some, None)
	test: TestSuite


union EquivalenceChoice:
	EquivalenceValue(Int)
	EquivalenceEmpty


union EquivalenceImportCollision:
	SharedName


record EquivalencePoint {
	x: Int,
	y: Int
}


private pure func equivalent_int_arithmetic(seed: Int) -> Int:
	((seed + 7) * 3 - 4) / 2 + seed % 5


private pure func equivalent_float_arithmetic(value: Float) -> Float:
	(value * 2.0 - 1.5) / 2.0


private pure func equivalent_float32_precision() -> Float32:
	to_float32(16777216.0) + to_float32(1.0)


private pure func equivalent_float16_precision() -> Float16:
	to_float16(2048.0) + to_float16(1.0)


private pure func equivalent_loop_total(limit: Int) -> Int:
	var total: Int = 0

	for value in 0..limit:
		if value % 2 == 0:
			continue

		total += value

	total


private pure func equivalent_match_score(choice: EquivalenceChoice) -> Int:
	match choice:
		EquivalenceValue(value):
			value + 1
		EquivalenceEmpty:
			0


private pure func equivalent_question_bind(left: Option[Int], right: Option[Int]) -> Option[Int]:
	left_value ?= left
	right_value ?= right
	Some(left_value + right_value)


private pure func equivalent_string_summary(text: String) -> String:
	text
		.trim()
		.replace(",", "|")
		.split("|")
		.join("-")
		.upper()


private pure func equivalent_list_total(values: List[Int]) -> Int:
	values
		.map(func(value: Int) -> Int: value * 2)
		.filter(func(value: Int) -> Bool: value > 4)
		.fold_left(0, func(total: Int, value: Int) -> Int: total + value)


private pure func equivalent_list_builder_total(limit: Int) -> Int:
	var values: List[Int] = L.list(limit)

	for value in 0..limit:
		values = L.append(values, value + 1)

	values.fold_left(0, func(total: Int, value: Int) -> Int: total + value)


private pure func equivalent_dict_score() -> Int:
	var values: Dict[String, Int] = {}

	values = values.set("left", 20)
	values = values.set("right", 22)
	values = values.set("left", 21)

	values.get_or("left", 0) + values.get_or("right", 0) - values.length()


private pure func equivalent_record_score(point: EquivalencePoint) -> Int:
	shifted: EquivalencePoint = { point | y = point.y + 1 }
	shifted.x + shifted.y


private pure func equivalent_tensor_score(values: Int[#2, #3]) -> Int:
	row: Int[#3] = values[1]
	values.length() + values.row_count() + values.column_count() + values[0, 1] + row[2]


private pure func equivalent_selective_import_score() -> Int:
	IMPORTED_BASE_ALIAS + imported_plus(
		1,
	) + imported_reads_private(
		41,
	) + imported_reads_qualified_dependency(41) + join_upper(BASE_WORDS).length()


private pure func equivalent_qualified_import_score() -> Int:
	CT.IMPORTED_BASE + CT.imported_plus(1) + CT
		.join_upper(CT.BASE_WORDS)
		.length()


private pure func equivalent_qualified_import_collision_score() -> Int:
	CT.SharedName + 1


INT_ARITHMETIC_CTFE: Int = equivalent_int_arithmetic(11)

FLOAT_ARITHMETIC_CTFE: Float = equivalent_float_arithmetic(3.5)

FLOAT32_PRECISION_CTFE: Bool = equivalent_float32_precision() == to_float32(16777216.0)

FLOAT16_PRECISION_CTFE: Bool = equivalent_float16_precision() == to_float16(2048.0)

LOOP_TOTAL_CTFE: Int = equivalent_loop_total(8)

MATCH_SCORE_CTFE: Int = equivalent_match_score(EquivalenceValue(41))

QUESTION_BIND_CTFE: Option[Int] = equivalent_question_bind(Some(20), Some(22))

STRING_SUMMARY_CTFE: String = equivalent_string_summary(" compile,time ")

LIST_TOTAL_CTFE: Int = equivalent_list_total([1, 2, 3, 4])

LIST_BUILDER_TOTAL_CTFE: Int = equivalent_list_builder_total(4)

DICT_SCORE_CTFE: Int = equivalent_dict_score()

RECORD_SCORE_CTFE: Int = equivalent_record_score({
	x = 20,
	y = 21,
})

TENSOR_SCORE_CTFE: Int = equivalent_tensor_score(
	{
		{1, 2, 3},
		{4, 5, 6},
	},
)

SELECTIVE_IMPORT_SCORE_CTFE: Int = equivalent_selective_import_score()

QUALIFIED_IMPORT_SCORE_CTFE: Int = equivalent_qualified_import_score()

QUALIFIED_IMPORT_COLLISION_SCORE_CTFE: Int = equivalent_qualified_import_collision_score()


func runtime_int_arithmetic() -> Int:
	equivalent_int_arithmetic(11)


func runtime_float_arithmetic() -> Float:
	equivalent_float_arithmetic(3.5)


func runtime_float32_precision() -> Bool:
	equivalent_float32_precision() == to_float32(16777216.0)


func runtime_float16_precision() -> Bool:
	equivalent_float16_precision() == to_float16(2048.0)


func runtime_loop_total() -> Int:
	equivalent_loop_total(8)


func runtime_match_score() -> Int:
	equivalent_match_score(EquivalenceValue(41))


func runtime_question_bind() -> Option[Int]:
	equivalent_question_bind(Some(20), Some(22))


func runtime_string_summary() -> String:
	equivalent_string_summary(" compile,time ")


func runtime_list_total() -> Int:
	equivalent_list_total([1, 2, 3, 4])


func runtime_list_builder_total() -> Int:
	equivalent_list_builder_total(4)


func runtime_dict_score() -> Int:
	equivalent_dict_score()


func runtime_record_score() -> Int:
	equivalent_record_score({
		x = 20,
		y = 21,
	})


func runtime_tensor_score() -> Int:
	equivalent_tensor_score(
		{
			{1, 2, 3},
			{4, 5, 6},
		},
	)


func runtime_selective_import_score() -> Int:
	equivalent_selective_import_score()


func runtime_qualified_import_score() -> Int:
	equivalent_qualified_import_score()


func runtime_qualified_import_collision_score() -> Int:
	equivalent_qualified_import_collision_score()


func test_int_arithmetic_equivalence() -> Bool:
	INT_ARITHMETIC_CTFE == runtime_int_arithmetic()


func test_float_arithmetic_equivalence() -> Bool:
	FLOAT_ARITHMETIC_CTFE == runtime_float_arithmetic()


func test_float32_precision_equivalence() -> Bool:
	FLOAT32_PRECISION_CTFE == runtime_float32_precision()


func test_float16_precision_equivalence() -> Bool:
	FLOAT16_PRECISION_CTFE == runtime_float16_precision()


func test_loop_equivalence() -> Bool:
	LOOP_TOTAL_CTFE == runtime_loop_total()


func test_match_equivalence() -> Bool:
	MATCH_SCORE_CTFE == runtime_match_score()


func test_question_bind_equivalence() -> Bool:
	match QUESTION_BIND_CTFE:
		Some(ctfe_value):
			match runtime_question_bind():
				Some(runtime_value):
					ctfe_value == runtime_value
				None:
					False
		None:
			False


func test_string_equivalence() -> Bool:
	STRING_SUMMARY_CTFE == runtime_string_summary()


func test_list_equivalence() -> Bool:
	(
		LIST_TOTAL_CTFE == runtime_list_total()
		and LIST_BUILDER_TOTAL_CTFE == runtime_list_builder_total()
	)


func test_dict_equivalence() -> Bool:
	DICT_SCORE_CTFE == runtime_dict_score()


func test_record_equivalence() -> Bool:
	RECORD_SCORE_CTFE == runtime_record_score()


func test_tensor_equivalence() -> Bool:
	TENSOR_SCORE_CTFE == runtime_tensor_score()


func test_import_equivalence() -> Bool:
	(
		SELECTIVE_IMPORT_SCORE_CTFE == runtime_selective_import_score()
		and QUALIFIED_IMPORT_SCORE_CTFE == runtime_qualified_import_score()
		and QUALIFIED_IMPORT_COLLISION_SCORE_CTFE == runtime_qualified_import_collision_score()
	)


tests: TestSuite = {
	description = "compile-time/runtime equivalence",
	tests = [
		("int arithmetic", test_int_arithmetic_equivalence),
		("float arithmetic", test_float_arithmetic_equivalence),
		("float32 precision", test_float32_precision_equivalence),
		("float16 precision", test_float16_precision_equivalence),
		("loop", test_loop_equivalence),
		("match", test_match_equivalence),
		("question bind", test_question_bind_equivalence),
		("string", test_string_equivalence),
		("list", test_list_equivalence),
		("dict", test_dict_equivalence),
		("record", test_record_equivalence),
		("tensor", test_tensor_equivalence),
		("imports", test_import_equivalence),
	]
}
