import:
	test: TestSuite


func test_vector_constructor() -> Bool:
	v: Int[#4] = vector(1, 4)
	length(v) == 4 and v[0] == 1 and v[3] == 1


func test_matrix_peel() -> Bool:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	row: Int[#3] = m[1]
	row[0] == 4 and row[2] == 6


func test_elementwise_arithmetic() -> Bool:
	v: Int[#3] = {1, 2, 3}
	w: Int[#3] = v + 2
	w[0] == 3 and w[1] == 4 and w[2] == 5


tests: TestSuite = {
	description = "Postfix array type syntax",
	tests = [
		("vector constructor", test_vector_constructor),
		("matrix peel", test_matrix_peel),
		("elementwise arithmetic", test_elementwise_arithmetic),
	]
}
