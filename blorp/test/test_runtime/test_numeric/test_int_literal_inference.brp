import:
	test: TestSuite
	tensor: indices


func takes_int(value: Int) -> Int:
	value + 1


func takes_small(value: Int8) -> Int8:
	value


func takes_refined(value: #42) -> Int:
	value + 0


func var_literal_accumulates() -> Bool:
	var x = 42
	x += 1
	x == 43


func var_literal_accumulates_in_loop() -> Bool:
	var total = 0

	for i in 0..10:
		total += i

	total == 45


func immutable_literal_passes_as_int() -> Bool:
	x = 5
	takes_int(x) == 6


func refined_binding_keeps_its_type() -> Bool:
	y: #42 = 42
	takes_int(y) == 43 and takes_refined(y) == 42


func mutable_refined_binding_reads_back() -> Bool:
	var y: #42 = 42
	y == 42


func unannotated_var_from_refined_name_updates() -> Bool:
	n: #3 = 3
	var z = n
	z += 1
	z == 4


func sized_int_literal_still_targets_its_type() -> Bool:
	small: Int8 = 7
	negative: Int8 = takes_small(-3)
	takes_small(small) == small and negative < small


func literal_subscripts_keep_compile_time_proof() -> Bool:
	v: Int[#3] = {10, 20, 30}
	v[0] + v[2] + v[-1] == 70


func range_and_indices_loops_keep_compile_time_proof() -> Bool:
	v: Int[#3] = {10, 20, 30}
	var total = 0

	for i in 0..3:
		total += v[i]

	for i in indices(v):
		total += v[i]

	total == 120


func modulo_by_literal_indexes_safely() -> Bool:
	v: Int[#3] = {10, 20, 30}
	v[7 % 3] == 20


func literal_slice_keeps_compile_time_proof() -> Bool:
	v: Int[#4] = {1, 2, 3, 4}
	middle = checked_slice(v, 1, 3)
	length(middle) == 2 and v[1] == 2


func sized_bounds_hold_their_values() -> Bool:
	small_min: Int8 = -128
	small_max: Int8 = 127
	byte_max: UInt8 = 255
	word_max: UInt64 = 18446744073709551615
	int_min: Int = -9223372036854775808
	(
		small_min.to_string() == "-128"
		and small_max.to_string() == "127"
		and byte_max.to_string() == "255"
		and word_max.to_string() == "18446744073709551615"
		and int_min.to_string() == "-9223372036854775808"
	)


pure func next_small(value: Int8) -> Int8:
	value + 1


pure func before_small(value: Int8) -> Int8:
	0 - value


func literal_operand_takes_sized_type() -> Bool:
	-- The literal is an Int8, so the sum wraps within Int8.
	next_small(127) == -128 and before_small(-127) == 127


func literal_compared_with_sized_value() -> Bool:
	byte: UInt8 = 200
	byte > 100 and 255 >= byte and byte != 0


func compound_assignment_with_literal() -> Bool:
	var level: UInt8 = 250
	level += 5
	level -= 1
	level == 254


func all_literal_arithmetic_takes_expected_type() -> Bool:
	sum: Int8 = 100 + 27
	nested: UInt8 = 2 * (3 + 4)
	sum == 127 and nested == 14


func collection_literals_take_element_type() -> Bool:
	bytes: List[UInt8] = [0, 128, 255]
	offsets: Int8[#3] = {-128, 0, 127}
	limits: Dict[String, Int16] = {"low" => -32768, "high" => 32767}
	total_offsets: Int8 = offsets[0] + offsets[2]
	(
		bytes.get_or(2, 0) == 255
		and total_offsets == -1
		and limits.get_or("low", 0) == -32768
		and limits.get_or("high", 0) == 32767
	)


pure func signed_step(forward: Bool) -> Int8:
	if forward:
		1
	else:
		-1


func branch_arms_take_expected_type() -> Bool:
	signed_step(True) + signed_step(False) == 0


tests: TestSuite = {
	description = "Integer literal inference",
	tests = [
		("var literal accumulates", var_literal_accumulates),
		("var literal accumulates in loop", var_literal_accumulates_in_loop),
		("immutable literal passes as Int", immutable_literal_passes_as_int),
		("refined binding keeps its type", refined_binding_keeps_its_type),
		("mutable refined binding reads back", mutable_refined_binding_reads_back),
		("unannotated var from refined name updates", unannotated_var_from_refined_name_updates),
		("sized int literal still targets its type", sized_int_literal_still_targets_its_type),
		("literal subscripts keep compile-time proof", literal_subscripts_keep_compile_time_proof),
		(
			"range and indices loops keep compile-time proof",
			range_and_indices_loops_keep_compile_time_proof,
		),
		("modulo by literal indexes safely", modulo_by_literal_indexes_safely),
		(
			"literal slice keeps compile-time proof",
			literal_slice_keeps_compile_time_proof,
		),
		("sized bounds hold their values", sized_bounds_hold_their_values),
		("literal operand takes sized type", literal_operand_takes_sized_type),
		("literal compared with sized value", literal_compared_with_sized_value),
		("compound assignment with literal", compound_assignment_with_literal),
		(
			"all-literal arithmetic takes expected type",
			all_literal_arithmetic_takes_expected_type,
		),
		("collection literals take element type", collection_literals_take_element_type),
		("branch arms take expected type", branch_arms_take_expected_type),
	]
}
