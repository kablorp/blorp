-- Phase 2.7 cluster 2: set_all's body must monomorphize cleanly when
-- called from test_type_name.brp-style sites. Previously, the #Ds...
-- variadic in the signature left the inner `result[i] = val` call to
-- `checked_set` unsubstituted, surfacing the Phase 2.7 post-mono
-- diagnostic.
import:
	tensor: length, set_all
	test: TestSuite


func test_set_all_int_3() -> Bool:
	v: Int[#3] = {1, 2, 3}
	r: Int[#3] = set_all(v, 0)
	r.length() == 3


func test_set_all_int_5() -> Bool:
	v: Int[#5] = {1, 2, 3, 4, 5}
	r: Int[#5] = set_all(v, 9)
	r.length() == 5


func test_set_all_float() -> Bool:
	v: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	r: Float[#4] = set_all(v, 0.5)
	r.length() == 4


tests: TestSuite = {
	description = "set_all post-mono dispatch (Phase 2.7 cluster 2)",
	tests = [
		("set_all Int #3", test_set_all_int_3),
		("set_all Int #5", test_set_all_int_5),
		("set_all Float #4", test_set_all_float),
	]
}
