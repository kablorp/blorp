import:
	fixed_point as F
	test: TestSuite


-- Test basic fixed creation
func test_fixed_point_create() -> Bool:
	price: FixedPoint = F.fixed_point(19.99, 2)
	F.to_string(price) == "19.99"


-- Test fixed addition with same scale
func test_fixed_point_add_same_scale() -> Bool:
	a: FixedPoint = F.fixed_point(10.5, 2)
	b: FixedPoint = F.fixed_point(5.25, 2)
	result: FixedPoint = a + b
	F.to_string(result) == "15.75"


-- Test fixed addition with different scales (auto-normalize)
func test_fixed_point_add_diff_scale() -> Bool:
	price: FixedPoint = F.fixed_point(19.99, 2)
	tax_rate: FixedPoint = F.fixed_point(0.0825, 4)
	result: FixedPoint = price + tax_rate

	-- Result should be at scale 4
	F.get_scale(result) == 4


-- Test fixed multiplication
func test_fixed_point_mul() -> Bool:
	price: FixedPoint = F.fixed_point(10.0, 2)
	quantity: FixedPoint = F.fixed_point(3.0, 1)
	result: FixedPoint = price * quantity

	-- 10.00 * 3.0 = 30.000 (scale 3)
	F.get_scale(result) == 3


-- Test fixed subtraction
func test_fixed_point_sub() -> Bool:
	a: FixedPoint = F.fixed_point(100.0, 2)
	b: FixedPoint = F.fixed_point(25.5, 2)
	result: FixedPoint = a - b
	F.to_string(result) == "74.50"


-- Test fixed division
func test_fixed_point_div() -> Bool:
	a: FixedPoint = F.fixed_point(10.0, 2)
	b: FixedPoint = F.fixed_point(2.0, 2)
	result: FixedPoint = a / b
	F.to_string(result) == "5.0000000000"


-- Test fixed division by zero preserves infallible arithmetic
func test_fixed_point_div_by_zero() -> Bool:
	a: FixedPoint = F.fixed_point(10.0, 2)
	b: FixedPoint = F.fixed_point(0.0, 2)
	result: FixedPoint = a / b
	F.to_string(result) == "0.00"


-- Test fixed comparison
func test_fixed_point_compare() -> Bool:
	a: FixedPoint = F.fixed_point(10.0, 1)
	b: FixedPoint = F.fixed_point(10.0, 2)

	-- Same value, different scale - should be equal
	a == b


-- Test fixed ordering comparisons
func test_fixed_point_ordering() -> Bool:
	small: FixedPoint = F.fixed_point(9.99, 2)
	large: FixedPoint = F.fixed_point(10.0, 1)
	same: FixedPoint = F.fixed_point(9.99, 3)
	(
		small < large
		and small <= same
		and large > small
		and large >= same
		and small != large
		and small == same
	)


-- Test constructors that route through std builtin wrappers
func test_fixed_point_constructor_wrappers() -> Bool:
	from_int: FixedPoint = F.from_int(42, 2)
	with_precision: FixedPoint = F.with_precision(1.2345, 4, 6)
	F.to_string(from_int) == "42.00" and F.get_precision(with_precision) == 6


-- Test round_to
func test_round_to() -> Bool:
	price: FixedPoint = F.fixed_point(19.999, 3)
	rounded: FixedPoint = F.round_to(price, 2)
	F.to_string(rounded) == "20.00"


tests: TestSuite = {
	description = "Fixed-point decimal type",
	tests = [
		("fixed_point creation", test_fixed_point_create),
		("add same scale", test_fixed_point_add_same_scale),
		("add different scale", test_fixed_point_add_diff_scale),
		("multiplication", test_fixed_point_mul),
		("subtraction", test_fixed_point_sub),
		("division", test_fixed_point_div),
		("division by zero", test_fixed_point_div_by_zero),
		("comparison across scales", test_fixed_point_compare),
		("ordering comparisons", test_fixed_point_ordering),
		("constructor wrappers", test_fixed_point_constructor_wrappers),
		("round_to", test_round_to),
	]
}
