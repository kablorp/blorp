import:
	float: abs
	test: TestSuite
	vector: all, any, argmax, argmin, cumulative_sum, fold, map, mean, product, sum, to_list, zip


func test_argmax() -> Bool:
	v: Int[#4] = {3, 7, 1, 5}
	argmax(v) == 1


func test_argmin() -> Bool:
	v: Int[#4] = {3, 7, 1, 5}
	argmin(v) == 2


func test_cumulative_sum() -> Bool:
	v: Int[#3] = {1, 2, 3}
	c: Int[#3] = cumulative_sum(v)
	c[0] == 1 and c[1] == 3 and c[2] == 6


func test_sum() -> Bool:
	v: Int[#4] = {1, 2, 3, 4}
	sum(v) == 10


func test_product() -> Bool:
	v: Int[#3] = {2, 3, 4}
	product(v) == 24


func test_mean() -> Bool:
	v: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	abs(mean(v) - 2.5) < 0.001


func test_to_list() -> Bool:
	v: Int[#3] = {10, 20, 30}
	lst: List[Int] = to_list(v)
	lst.length() == 3


func test_zip() -> Bool:
	a: Int[#2] = {1, 2}
	b: Int[#2] = {3, 4}
	z: (Int, Int)[#2] = a.zip(b)
	z.length() == 2


func test_all() -> Bool:
	v: Int[#3] = {2, 4, 6}
	v.all(func(x: Int): x % 2 == 0) and not v.all(func(x: Int): x > 3)


func test_any() -> Bool:
	v: Int[#3] = {1, 2, 3}
	v.any(func(x: Int): x == 2) and not v.any(func(x: Int): x > 10)


func test_fold() -> Bool:
	v: Int[#4] = {1, 2, 3, 4}
	v.fold(0, func(acc: Int, x: Int): acc + x) == 10


func test_map() -> Bool:
	v: Int[#3] = {1, 2, 3}
	doubled: Int[#3] = v.map(func(x: Int): x * 2)
	doubled[0] == 2 and doubled[1] == 4 and doubled[2] == 6


tests: TestSuite = {
	description = "Vector Operations",
	tests = [
		("argmax", test_argmax),
		("argmin", test_argmin),
		("cumulative_sum", test_cumulative_sum),
		("sum", test_sum),
		("product", test_product),
		("mean", test_mean),
		("to_list", test_to_list),
		("zip", test_zip),
		("all", test_all),
		("any", test_any),
		("fold", test_fold),
		("map", test_map),
	]
}
