import:
	test: TestSuite
	vector: dot, max, mean, min, product, sum


-- Test #22: Unified numeric operations (type-dispatched)
func test_sum_int() -> Bool:
	v: Int[#4] = {1, 2, 3, 4}
	sum(v) == 10


func test_sum_float() -> Bool:
	v: Float[#3] = {1.5, 2.5, 3.0}
	x: Float = sum(v)
	x == 7.0


func test_product_int() -> Bool:
	v: Int[#3] = {2, 3, 4}
	product(v) == 24


func test_max_int() -> Bool:
	v: Int[#4] = {3, 1, 4, 2}
	max(v) == 4


func test_min_float() -> Bool:
	v: Float[#3] = {5.0, 2.0, 8.0}
	x: Float = min(v)
	x == 2.0


func test_mean_int() -> Bool:
	v: Int[#4] = {2, 4, 6, 8}
	x: Float = mean(v)
	x == 5.0


func test_dot_int() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: Int[#3] = {4, 5, 6}
	dot(a, b) == 32


func test_dot_float() -> Bool:
	a: Float[#3] = {1.0, 2.0, 3.0}
	b: Float[#3] = {4.0, 5.0, 6.0}
	x: Float = dot(a, b)
	x == 32.0


tests: TestSuite = {
	description = "Unified numeric operations",
	tests = [
		("sum int", test_sum_int),
		("sum float", test_sum_float),
		("product int", test_product_int),
		("max int", test_max_int),
		("min float", test_min_float),
		("mean int", test_mean_int),
		("dot int", test_dot_int),
		("dot float", test_dot_float),
	]
}
