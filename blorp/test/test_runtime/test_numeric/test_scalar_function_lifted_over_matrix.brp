-- Typecheck lifts a scalar function over a matrix element by element:
-- `sqrt(m)` selects the scalar `float.sqrt`, whose parameter is `Float`, for a
-- `Float[#2, #2]` argument. Call resolution must trust that selection by its
-- definition id. Rejecting it on the signature mismatch once turned the call
-- into a closure call and crashed at run time.
import:
	float: abs, sqrt
	matrix: get_or
	test: TestSuite


func test_sqrt_lifted_over_matrix() -> Bool:
	m: Float[#2, #2] = {
		{4.0, 9.0},
		{16.0, 25.0},
	}
	r: Float[#2, #2] = sqrt(m)
	r.get_or(0, 0, 0.0) == 2.0 and r.get_or(1, 1, 0.0) == 5.0


func test_abs_lifted_over_matrix() -> Bool:
	m: Float[#2, #2] = {
		{-1.0, 2.0},
		{-3.0, 4.0},
	}
	r: Float[#2, #2] = abs(m)
	r.get_or(0, 0, 0.0) == 1.0 and r.get_or(1, 0, 0.0) == 3.0


tests: TestSuite = {
	description = "scalar functions lifted over matrices",
	tests = [
		("sqrt lifted over matrix", test_sqrt_lifted_over_matrix),
		("abs lifted over matrix", test_abs_lifted_over_matrix),
	]
}
