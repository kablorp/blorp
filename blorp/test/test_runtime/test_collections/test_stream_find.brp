import:
	stream: find, from_list
	test: TestSuite


func test_stream_find_int_some() -> Bool:
	match find(from_list([1, 2, 3, 4]), func(value: Int): value == 3):
		Some(found):
			found == 3
		None:
			False


func test_stream_find_int_none() -> Bool:
	match find(from_list([1, 2, 3, 4]), func(value: Int): value > 10):
		Some(found):
			False
		None:
			True


func test_stream_find_empty_stream_binds_boxed_none() -> Bool:
	values: List[Option[Int]] = []

	match find(from_list(values), func(value: Option[Int]): False):
		None:
			True
		_:
			False


tests: TestSuite = {
	description = "Stream find",
	tests = [
		("stream find int Some", test_stream_find_int_some),
		("stream find int None", test_stream_find_int_none),
		(
			"stream find empty stream binds boxed None",
			test_stream_find_empty_stream_binds_boxed_none,
		),
	]
}
