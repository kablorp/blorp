import:
	dict as D
	test: TestSuite


private pure func tuple_key_dictionary() -> Dict[(Int, Int), String]:
	var values: Dict[(Int, Int), String] = {}
	values = D.set(values, (2, 3), "first")
	D.set(values, (5, 7), "second")


pure func test_named_dict_binder_reads_tuple_keys() -> Bool:
	values = tuple_key_dictionary()
	var count: Int = 0
	var first_total: Int = 0
	var second_total: Int = 0
	for key in values:
		count = count + 1
		first_total = first_total + key[0]
		second_total = second_total + key[1]
	count == 2 and first_total == 7 and second_total == 10


pure func test_entry_pattern_binder_keeps_tuple_key_and_value_separate() -> Bool:
	values = tuple_key_dictionary()
	var count: Int = 0
	var matched: Int = 0
	for (key, value) in values:
		count = count + 1
		if key == (2, 3) and value == "first":
			matched = matched + 1
		else if key == (5, 7) and value == "second":
			matched = matched + 1
	count == 2 and matched == 2


tests: TestSuite = {
	description = "Dict iteration uses the parsed binder mode",
	tests = [
		("named dict binder reads tuple keys", test_named_dict_binder_reads_tuple_keys),
		("entry pattern keeps tuple key and value separate", test_entry_pattern_binder_keeps_tuple_key_and_value_separate),
	],
}
