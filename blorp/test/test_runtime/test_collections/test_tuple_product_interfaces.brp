import:
	dict as D
	stream as S
	test: TestSuite
	vector as V


fixed record Point {
	x: Int,
	y: Int
}


func test_dictionary_entries_preserve_inline_fields() -> Bool:
	points: Dict[String, Point] = {
		"first" => { x = 3, y = 5 },
		"second" => { x = 7, y = 11 },
	}
	entries: List[(String, Point)] = D.entries(points)

	match (entries.get(0), entries.get(1)):
		(Some(first), Some(second)):
			(
				first[0] == "first"
				and first[1].x == 3
				and first[1].y == 5
				and second[0] == "second"
				and second[1].x == 7
				and second[1].y == 11
			)
		_:
			False


func test_dictionary_entries_preserve_repeated_managed_fields() -> Bool:
	label: String = "entry".repeat(3)
	entries: List[(String, String)] = D.entries({label => label})

	match entries.get(0):
		Some(pair):
			pair[0] == label and pair[1] == label
		None:
			False


func test_dictionary_entries_preserve_wide_keys() -> Bool:
	word: Int128 = to_int128(4294967296)
	high: Int128 = word * word + to_int128(7)
	low: Int128 = to_int128(7)
	entries: List[(Int128, String)] = D.entries({high => "high", low => "low"})

	match (entries.get(0), entries.get(1)):
		(Some(first), Some(second)):
			first[0] == high and first[1] == "high" and second[0] == low and second[1] == "low"
		_:
			False


func test_vector_zip_reads_float_and_packed_elements() -> Bool:
	values: Float[#3] = {1.5, 2.5, 3.5}
	flags: Bool[#3] = {True, False, True}
	pairs: (Float, Bool)[#3] = V.zip(values, flags)
	first = pairs[0]
	second = pairs[1]
	third = pairs[2]
	(
		first[0] == 1.5 and first[1]
		and second[0] == 2.5 and not second[1]
		and third[0] == 3.5 and third[1]
	)


func test_stream_enumeration_preserves_borrowed_managed_values() -> Bool:
	label: String = "borrowed".repeat(2)
	pairs: List[(Int, String)] = S.collect(S.enumerate(S.from_list([label, label])))

	match (pairs.get(0), pairs.get(1)):
		(Some(first), Some(second)):
			first[0] == 0 and first[1] == label and second[0] == 1 and second[1] == label
		_:
			False


func test_stream_enumeration_preserves_owned_callback_values() -> Bool:
	prefix: String = "owned".repeat(2)
	pairs: List[(Int, String)] = S.collect(S.enumerate(S.map(
		S.from_list([3, 5]),
		func(value: Int): prefix + value.to_string(),
	)))

	match (pairs.get(0), pairs.get(1)):
		(Some(first), Some(second)):
			first[0] == 0 and first[1] == prefix + "3" and second[0] == 1 and second[1] == prefix + "5"
		_:
			False


private func option_state_step(state: Option[Int]) -> Option[(Option[Int], Option[Int])]:
	match state:
		Some(value):
			Some((Some(value), None))
		None:
			None


func test_stream_unfold_preserves_inline_option_state() -> Bool:
	values: List[Option[Int]] = S.collect(S.unfold(Some(13), option_state_step))
	values.length() == 1 and values.get(0) == Some(Some(13))


func test_stream_unfold_preserves_captured_and_repeated_managed_values() -> Bool:
	prefix: String = "capture".repeat(2)
	step = func(state: (String, Int)) -> Option[((String, String), (String, Int))]:
		if state[1] < 2:
			value = prefix + state[0]
			Some(((value, value), (state[0], state[1] + 1)))
		else:
			None

	values: List[(String, String)] = S.collect(S.unfold(("state", 0), step))

	match (values.get(0), values.get(1)):
		(Some(first), Some(second)):
			(
				values.length() == 2
				and first[0] == prefix + "state"
				and first[1] == first[0]
				and second[0] == first[0]
				and second[1] == first[0]
			)
		_:
			False


func test_stream_unfold_preserves_boxed_float_state() -> Bool:
	step = func(state: Float) -> Option[(Float, Float)]:
		if state < 3.0:
			Some((state, state + 1.0))
		else:
			None

	values: List[Float] = S.collect(S.unfold(1.5, step))
	values.length() == 2 and values.get(0) == Some(1.5) and values.get(1) == Some(2.5)


tests: TestSuite = {
	description = "Tuple product interfaces",
	tests = [
		("dictionary entries preserve inline fields", test_dictionary_entries_preserve_inline_fields),
		("dictionary entries preserve repeated managed fields", test_dictionary_entries_preserve_repeated_managed_fields),
		("dictionary entries preserve wide keys", test_dictionary_entries_preserve_wide_keys),
		("vector zip reads float and packed elements", test_vector_zip_reads_float_and_packed_elements),
		("stream enumeration preserves borrowed managed values", test_stream_enumeration_preserves_borrowed_managed_values),
		("stream enumeration preserves owned callback values", test_stream_enumeration_preserves_owned_callback_values),
		("stream unfold preserves inline option state", test_stream_unfold_preserves_inline_option_state),
		("stream unfold preserves boxed float state", test_stream_unfold_preserves_boxed_float_state),
		("stream unfold preserves captured and repeated managed values", test_stream_unfold_preserves_captured_and_repeated_managed_values),
	]
}
