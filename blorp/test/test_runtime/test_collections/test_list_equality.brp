-- List equality compares elements with the element type's own ==; it must not
-- fall back to identity for pointer-stored or wide inline elements.
import:
	test: TestSuite


record Point {
	x: Int,
	y: Int
}


enum Shade:
	Light
	Dark


fixed record Wide {
	a: Int,
	b: Int,
	c: Int
}


implements Equatable for Point:
	pure func equals(a: Point, b: Point) -> Bool:
		a.x == b.x and a.y == b.y

	pure func not_equals(a: Point, b: Point) -> Bool:
		not equals(a, b)


implements Equatable for Wide:
	pure func equals(l: Wide, r: Wide) -> Bool:
		l.a == r.a and l.b == r.b and l.c == r.c

	pure func not_equals(l: Wide, r: Wide) -> Bool:
		not equals(l, r)


func test_scalar_lists() -> Bool:
	ints: List[Int] = [1, 2]
	floats: List[Float] = [1.5, 2.5]
	strings: List[String] = ["a", "b"]

	(
		ints == [1, 2]
		and ints != [1, 3]
		and ints != [1]
		and floats == [1.5, 2.5]
		and strings == ["a", "b"]
		and strings != ["a", "c"]
	)


func test_empty_lists() -> Bool:
	empty_ints: List[Int] = []
	other_ints: List[Int] = []
	empty_points: List[Point] = []
	other_points: List[Point] = []

	empty_ints == other_ints and empty_points == other_points and empty_ints != [1]


func test_nested_lists() -> Bool:
	left: List[List[Int]] = [
		[1, 2],
		[3],
	]
	same: List[List[Int]] = [
		[1, 2],
		[3],
	]
	different: List[List[Int]] = [
		[1, 2],
		[4],
	]
	shorter: List[List[Int]] = [
		[1, 2],
	]

	left == same and left != different and left != shorter


func test_lists_of_options() -> Bool:
	left: List[Option[Int]] = [Some(1), None]
	same: List[Option[Int]] = [Some(1), None]
	different: List[Option[Int]] = [Some(2), None]

	left == same and left != different


func test_lists_of_enums() -> Bool:
	left: List[Shade] = [Light, Dark]
	same: List[Shade] = [Light, Dark]
	different: List[Shade] = [Light, Light]

	left == same and left != different


func test_lists_of_equatable_records() -> Bool:
	left: List[Point] = [
		{
			x = 1,
			y = 2
		},
	]
	same: List[Point] = [
		{
			x = 1,
			y = 2
		},
	]
	different: List[Point] = [
		{
			x = 1,
			y = 3
		},
	]

	left == same and left != different


func test_lists_of_wide_inline_structs() -> Bool:
	left: List[Wide] = [
		{
			a = 1,
			b = 2,
			c = 3
		},
	]
	same: List[Wide] = [
		{
			a = 1,
			b = 2,
			c = 3
		},
	]
	different: List[Wide] = [
		{
			a = 1,
			b = 2,
			c = 4
		},
	]

	left == same and left != different


pure func same_under_equatable[T:Equatable](left: T, right: T) -> Bool:
	left == right


func test_generic_equatable_bound_accepts_lists() -> Bool:
	nested: List[List[Int]] = [
		[1],
		[2, 3],
	]

	same_under_equatable(
		nested,
		[
			[1],
			[2, 3],
		],
	) and nested.contains([2, 3])


tests: TestSuite = {
	description = "List equality is element-wise for every Equatable element type",
	tests = [
		("scalar lists", test_scalar_lists),
		("empty lists", test_empty_lists),
		("nested lists", test_nested_lists),
		("lists of options", test_lists_of_options),
		("lists of enums", test_lists_of_enums),
		("lists of equatable records", test_lists_of_equatable_records),
		("lists of wide inline structs", test_lists_of_wide_inline_structs),
		("generic Equatable bound accepts lists", test_generic_equatable_bound_accepts_lists),
	]
}
