-- Dict and Set keys that the runtime cannot hash as a word (Option, Result,
-- value structs, and records) must hash and compare by value. Keys are built
-- through helper calls so that equal keys are distinct runtime objects and a
-- pointer-identity hash cannot pass by accident.
import:
	dict as Dicts
	set as Sets
	test: TestSuite


fixed record GridPoint {
	x: Int,
	y: Int
}


implements Equatable for GridPoint:
	pure func equals(a: GridPoint, b: GridPoint) -> Bool:
		a.x == b.x and a.y == b.y


implements Hashable for GridPoint:
	pure func hash(self: GridPoint) -> Int:
		self.x * 31 + self.y


record Label {text: String}


implements Equatable for Label:
	pure func equals(a: Label, b: Label) -> Bool:
		a.text == b.text


implements Hashable for Label:
	pure func hash(self: Label) -> Int:
		self.text.length()


pure func label_key(text: String) -> Label:
	{text = text + ""}


pure func some_key(value: Int) -> Option[Int]:
	Some(value)


pure func no_key() -> Option[Int]:
	None


pure func ok_key(value: Int) -> Result[Int, String]:
	Ok(value)


pure func err_key(text: String) -> Result[Int, String]:
	Err(text + "")


pure func point_key(x: Int, y: Int) -> GridPoint:
	{
		x = x,
		y = y
	}


pure func test_option_dict_keys_compare_by_value() -> Bool:
	var dict: Dict[Option[Int], Int] = {}
	dict = dict.set(some_key(1), 5)
	dict = dict.set(no_key(), 6)
	dict = dict.set(some_key(2), 7)
	dict = dict.set(some_key(1), 8)

	(
		dict.length() == 3
		and dict
			.get(some_key(1))
			.get_or(0) == 8
		and dict
			.get(no_key())
			.get_or(0) == 6
		and dict
			.get(some_key(2))
			.get_or(0) == 7
		and not dict.contains(some_key(3))
	)


pure func test_option_dict_remove_by_equal_key() -> Bool:
	var dict: Dict[Option[Int], Int] = Dicts.dict()
	dict = dict.set(some_key(1), 5)
	dict = dict.set(no_key(), 6)
	dict = dict.remove(some_key(1))
	dict = dict.remove(no_key())
	dict.is_empty()


pure func test_option_set_elements_compare_by_value() -> Bool:
	var set: Set[Option[Int]] = Sets.set()
	set = set.add(some_key(1))
	set = set.add(some_key(1))
	set = set.add(no_key())
	set = set.add(no_key())
	set.length() == 2 and set.contains(some_key(1)) and set.contains(no_key())


pure func test_option_set_from_list_deduplicates() -> Bool:
	set: Set[Option[Int]] = Sets.from_list([some_key(4), no_key(), some_key(4)])
	set.length() == 2 and set.contains(some_key(4))


pure func test_result_dict_keys_compare_by_value() -> Bool:
	var dict: Dict[Result[Int, String], Int] = {}
	dict = dict.set(ok_key(1), 1)
	dict = dict.set(err_key("x"), 2)
	dict = dict.set(ok_key(1), 3)
	dict = dict.set(err_key("x"), 4)

	(
		dict.length() == 2
		and dict
			.get(ok_key(1))
			.get_or(0) == 3
		and dict
			.get(err_key("x"))
			.get_or(0) == 4
		and not dict.contains(err_key("y"))
	)


pure func test_result_set_elements_compare_by_value() -> Bool:
	var set: Set[Result[Int, String]] = Sets.set()
	set = set.add(ok_key(1))
	set = set.add(err_key("x"))
	set = set.add(ok_key(1))
	set = set.add(err_key("x"))
	set.length() == 2 and set.contains(err_key("x"))


pure func test_struct_dict_keys_compare_by_value() -> Bool:
	var dict: Dict[GridPoint, Int] = {}
	dict = dict.set(
		point_key(1, 2),
		5,
	)
	dict = dict.set(
		point_key(3, 4),
		6,
	)
	dict = dict.set(
		point_key(1, 2),
		7,
	)

	(
		dict.length() == 2
		and dict
			.get(point_key(1, 2))
			.get_or(0) == 7
		and dict
			.get(point_key(3, 4))
			.get_or(0) == 6
		and not dict.contains(point_key(2, 1))
	)


pure func test_struct_dict_with_capacity_keys_compare_by_value() -> Bool:
	var dict: Dict[GridPoint, Int] = Dicts.with_capacity(8)
	dict = dict.set(
		point_key(1, 2),
		5,
	)
	dict = dict.set(
		point_key(1, 2),
		6,
	)
	(
		dict.length() == 1
		and dict
			.get(point_key(1, 2))
			.get_or(0) == 6
	)


pure func test_struct_set_elements_compare_by_value() -> Bool:
	var set: Set[GridPoint] = Sets.set()
	set = set.add(point_key(1, 2))
	set = set.add(point_key(1, 2))
	set = set.add(point_key(2, 1))
	set.length() == 2 and set.contains(point_key(2, 1))


pure func test_record_dict_keys_compare_by_value() -> Bool:
	first: Label = label_key("a")
	second: Label = label_key("a")
	var dict: Dict[Label, Int] = {}
	dict = dict.set(first, 1)
	dict = dict.set(second, 2)
	dict.length() == 1 and dict.get(label_key("a")).get_or(0) == 2


pure func test_empty_set_literal_option_elements_compare_by_value() -> Bool:
	var set: Set[Option[Int]] = {}
	set = set.add(some_key(3))
	set = set.add(no_key())
	set = set.add(some_key(3))
	set.length() == 2 and set.contains(some_key(3)) and set.contains(no_key())


pure func test_nonempty_dict_literals_hash_keys_by_value() -> Bool:
	options: Dict[Option[Int], Int] = {some_key(1) => 5, no_key() => 6}
	results: Dict[Result[Int, String], Int] = {ok_key(1) => 1, err_key("x") => 2}
	points: Dict[GridPoint, Int] = {point_key(1, 2) => 5}
	labels: Dict[Label, Int] = {label_key("a") => 1}

	(
		options.get(some_key(1)).get_or(0) == 5
		and options.get(no_key()).get_or(0) == 6
		and results.get(ok_key(1)).get_or(0) == 1
		and results.get(err_key("x")).get_or(0) == 2
		and points.get(point_key(1, 2)).get_or(0) == 5
		and labels.get(label_key("a")).get_or(0) == 1
	)


pure func some_point_key(x: Int) -> Option[GridPoint]:
	Some(point_key(x, x))


pure func some_label_key(text: String) -> Option[Label]:
	Some(label_key(text))


pure func test_nested_option_keys_hash_payloads_by_value() -> Bool:
	var points: Dict[Option[GridPoint], Int] = {}
	points = points.set(some_point_key(1), 1)
	points = points.set(some_point_key(1), 2)
	var labels: Set[Option[Label]] = Sets.set()
	labels = labels.add(some_label_key("a"))
	labels = labels.add(some_label_key("a"))

	(
		points.length() == 1
		and points.get(some_point_key(1)).get_or(0) == 2
		and labels.length() == 1
		and labels.contains(some_label_key("a"))
	)


tests: TestSuite = {
	description = "Value-shaped Dict and Set keys",
	tests = [
		("option dict keys compare by value", test_option_dict_keys_compare_by_value),
		("option dict remove by equal key", test_option_dict_remove_by_equal_key),
		("option set elements compare by value", test_option_set_elements_compare_by_value),
		("option set from_list deduplicates", test_option_set_from_list_deduplicates),
		("result dict keys compare by value", test_result_dict_keys_compare_by_value),
		("result set elements compare by value", test_result_set_elements_compare_by_value),
		("struct dict keys compare by value", test_struct_dict_keys_compare_by_value),
		(
			"struct dict with_capacity keys compare by value",
			test_struct_dict_with_capacity_keys_compare_by_value,
		),
		("struct set elements compare by value", test_struct_set_elements_compare_by_value),
		(
			"record dict keys compare by value",
			test_record_dict_keys_compare_by_value,
		),
		(
			"empty set literal option elements compare by value",
			test_empty_set_literal_option_elements_compare_by_value,
		),
		(
			"nonempty dict literals hash keys by value",
			test_nonempty_dict_literals_hash_keys_by_value,
		),
		(
			"nested option keys hash payloads by value",
			test_nested_option_keys_hash_payloads_by_value,
		),
	]
}
