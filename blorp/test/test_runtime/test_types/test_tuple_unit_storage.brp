-- A Void element still evaluates in written order. Its position remains
-- available to tuple projection, but it has no stored payload or owned box.
import:
	test: TestSuite


record UnitRecord {
	effect: Void,
	value: Int
}


var events: List[Int] = []
var receiver_calls: Int = 0


func record_event(marker: Int) -> Void:
	events = events.append(marker)


func recorded_value(marker: Int) -> Int:
	events = events.append(marker)
	marker


func make_unit_pair() -> (Void, String):
	receiver_calls += 1
	(record_event(3), "unit receiver " + receiver_calls.to_string())


func test_void_tuple_field_evaluates_before_later_fields() -> Bool:
	events = []
	pair: (Void, Int) = (record_event(1), recorded_value(2))
	retained: List[(Void, Int)] = [pair]

	verdict: Bool = match retained.get(0):
		Some(stored):
			stored[0]
			stored[1] == 2 and events == [1, 2]
		None:
			False
	-- The trace is test-owned; do not retain its list between leak snapshots.
	events = []
	verdict


func test_void_record_field_uses_the_same_evaluation_boundary() -> Bool:
	events = []
	value: UnitRecord = {
		effect = record_event(1),
		value = recorded_value(2),
	}
	value.effect
	verdict: Bool = value.value == 2 and events == [1, 2]
	events = []
	verdict


func test_unit_projection_evaluates_and_releases_a_managed_receiver_once() -> Bool:
	events = []
	receiver_calls = 0
	make_unit_pair()[0]
	verdict: Bool = receiver_calls == 1 and events == [3]
	events = []
	verdict


tests: TestSuite = {
	description = "Unit fields through tuple record storage",
	tests = [
		("Void tuple field evaluation stays in written order", test_void_tuple_field_evaluates_before_later_fields),
		("Void record field shares the evaluation boundary", test_void_record_field_uses_the_same_evaluation_boundary),
		("unit projection evaluates managed receiver once", test_unit_projection_evaluates_and_releases_a_managed_receiver_once),
	],
}
