-- Regression test: literal sub-patterns inside constructors
-- Ensures Some('\n'), Ok(42), etc. compile and run correctly.
import:
	option: Option(Some, None)
	result: Result(Ok, Err)
	test: TestSuite


func test_char_literal_in_some() -> Bool:
	match Some('\n'):
		Some('\n'):
			True
		Some(_):
			False
		None:
			False


func test_char_no_match() -> Bool:
	match Some('x'):
		Some('\n'):
			False
		Some('\r'):
			False
		_:
			True


func test_int_literal_in_ok() -> Bool:
	match Ok(42):
		Ok(0):
			False
		Ok(42):
			True
		Ok(_):
			False
		Err(_):
			False


func test_int_fallthrough_to_var() -> Bool:
	match Ok(99):
		Ok(0):
			False
		Ok(42):
			False
		Ok(x):
			x == 99
		Err(_):
			False


func test_wildcard_default() -> Bool:
	match Some(5):
		Some(0):
			False
		Some(1):
			False
		_:
			True


func test_none_with_literal_some() -> Bool:
	opt: Option[Int] = None

	match opt:
		Some(0):
			False
		Some(_):
			False
		None:
			True


func test_or_pattern_literals() -> Bool:
	x: Int = 2

	match x:
		1 | 2 | 3:
			True
		_:
			False


func test_or_pattern_constructors() -> Bool:
	match Some(10):
		None:
			False
		Some(_):
			True


tests: TestSuite = {
	description = "Literal-in-constructor pattern match",
	tests = [
		("char literal in Some", test_char_literal_in_some),
		("char no match falls to default", test_char_no_match),
		("int literal in Ok", test_int_literal_in_ok),
		("int fallthrough to var", test_int_fallthrough_to_var),
		("wildcard default with literal Some", test_wildcard_default),
		("None with literal Some arms", test_none_with_literal_some),
		("or-pattern literals", test_or_pattern_literals),
		("or-pattern constructors", test_or_pattern_constructors),
	]
}
