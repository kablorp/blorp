-- Test Char type (Unicode codepoint)
import:
	test: TestSuite


-- Basic character literal
func test_char_literal() -> Bool:
	c = 'a'
	to_int(c) == 97 and to_int('A') == 65


-- Escape sequences
func test_char_escape_newline() -> Bool:
	n = '\n'
	to_int(n) == 10


func test_char_escape_backslash() -> Bool:
	bs = '\\'
	to_int(bs) == 92


-- Unicode escape sequences
func test_char_unicode_smiley() -> Bool:
	emoji = '\u{1F600}'
	to_int(emoji) == 128512


-- Char to String conversion (verify length is 1 for ASCII char)
func test_char_to_string_ascii() -> Bool:
	ch: Char = 'A'
	s: String = ch.to_string()
	s == "A" and s.length() == 1 and 'Z'.to_string() == "Z"


-- Int to Char conversion
func test_int_to_char() -> Bool:
	to_char(97) == 'a' and to_char(65) == 'A'


-- Char comparison operators
func test_char_comparisons() -> Bool:
	'a' == 'a' and 'a' != 'b' and 'a' < 'b' and 'z' > 'a'


tests: TestSuite = {
	description = "Char",
	tests = [
		("char literal", test_char_literal),
		("escape newline", test_char_escape_newline),
		("escape backslash", test_char_escape_backslash),
		("unicode smiley", test_char_unicode_smiley),
		("char to string", test_char_to_string_ascii),
		("int to char", test_int_to_char),
		("char comparisons", test_char_comparisons),
	]
}
