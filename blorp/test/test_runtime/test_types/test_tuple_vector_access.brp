import:
	test: TestSuite


-- Test #19: Chained access pair[0][i] on tuple containing vector
func test_tuple_first_vec_subscript() -> Bool:
	v: Int[#3] = {10, 20, 30}
	pair: (Int[#3], String) = (v, "hello")
	pair[0][0] == 10 and pair[0][1] == 20 and pair[0][2] == 30


func test_tuple_second_vec_subscript() -> Bool:
	v: Int[#2] = {42, 99}
	pair: (String, Int[#2]) = ("world", v)
	pair[1][0] == 42 and pair[1][1] == 99


func test_tuple_float_vec_subscript() -> Bool:
	v: Float[#2] = {3.5, 4.5}
	pair: (Float[#2], Int) = (v, 0)
	x: Float = pair[0][0]
	y: Float = pair[0][1]
	x == 3.5 and y == 4.5


tests: TestSuite = {
	description = "Tuple vector access",
	tests = [
		("first element vec subscript", test_tuple_first_vec_subscript),
		("second element vec subscript", test_tuple_second_vec_subscript),
		("float vec in tuple", test_tuple_float_vec_subscript),
	]
}
