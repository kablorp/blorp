import:
	bool: negate
	test: TestSuite


func test_negate_function() -> Bool:
	negate(False) and not negate(True)


func test_negate_method() -> Bool:
	False.negate() and not True.negate()


tests: TestSuite = {
	description = "Bool helper functions",
	tests = [("negate function", test_negate_function), ("negate method", test_negate_method)]
}
