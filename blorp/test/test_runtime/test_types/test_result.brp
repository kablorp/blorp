import:
	result: Result(Ok, Err), and_then, map, map_err
	test: TestSuite


func test_to_bool_ok() -> Bool:
	r: Result[Int, String] = Ok(42)
	to_bool(r) == True


func test_to_bool_err() -> Bool:
	r: Result[Int, String] = Err("fail")
	to_bool(r) == False


func test_eq_ok_ok() -> Bool:
	a: Result[Int, String] = Ok(42)
	b: Result[Int, String] = Ok(42)
	a == b


func test_eq_ok_diff() -> Bool:
	a: Result[Int, String] = Ok(1)
	b: Result[Int, String] = Ok(2)
	a != b


func test_eq_err_err() -> Bool:
	a: Result[Int, String] = Err("x")
	b: Result[Int, String] = Err("x")
	a == b


func test_eq_ok_err() -> Bool:
	a: Result[Int, String] = Ok(1)
	b: Result[Int, String] = Err("x")
	a != b


func test_pure_map() -> Bool:
	r: Result[Int, String] = Ok(5)
	mapped: Result[Int, String] = r.map(pure func(x: Int): x * 2)

	match mapped:
		Ok(v):
			v == 10
		Err(_):
			False


func test_pure_map_err() -> Bool:
	r: Result[Int, String] = Err("bad")
	mapped: Result[Int, String] = map_err(r, pure func(e: String): e + "!")

	match mapped:
		Ok(_):
			False
		Err(e):
			e == "bad!"


pure func double_if_big(x: Int) -> Result[Int, String]:
	if x > 5:
		Ok(x * 2)
	else:
		Err("too small")


pure func just_double(x: Int) -> Result[Int, String]:
	Ok(x * 2)


func test_and_then_ok() -> Bool:
	r: Result[Int, String] = Ok(10)
	chained: Result[Int, String] = and_then(r, double_if_big)

	match chained:
		Ok(v):
			v == 20
		Err(_):
			False


func test_and_then_err() -> Bool:
	r: Result[Int, String] = Err("initial")
	chained: Result[Int, String] = and_then(r, just_double)

	match chained:
		Ok(_):
			False
		Err(e):
			e == "initial"


func test_interpolation() -> Bool:
	r: Result[Int, String] = Ok(42)
	s: String = "result: ${r}"
	s == "result: Ok(42)"


tests: TestSuite = {
	description = "Result Combinators and Traits",
	tests = [
		("to_bool Ok", test_to_bool_ok),
		("to_bool Err", test_to_bool_err),
		("eq Ok Ok", test_eq_ok_ok),
		("eq Ok diff", test_eq_ok_diff),
		("eq Err Err", test_eq_err_err),
		("eq Ok Err", test_eq_ok_err),
		("pure map", test_pure_map),
		("pure map_err", test_pure_map_err),
		("and_then Ok", test_and_then_ok),
		("and_then Err", test_and_then_err),
		("interpolation", test_interpolation),
	]
}
