-- Derived equality across modules: records compared outside the module that
-- declares them, a written implementation in the declaring module that must
-- still win, and two modules that each declare a `Point`.
import:
	test: TestSuite
	./helpers/derived_equality_shapes as shapes
	./helpers/derived_equality_others as others


record Point {
	x: Int,
	y: Int,
	z: Int
}


pure func same[T:Equatable](left: T, right: T) -> Bool:
	left == right


func test_imported_record_compares_by_fields() -> Bool:
	shapes.point(1, 2) == shapes.point(1, 2) and shapes.point(1, 2) != shapes.point(2, 1)


func test_imported_generic_record_compares_by_fields() -> Bool:
	(
		shapes.tagged("a", 1) == shapes.tagged("a", 1)
		and shapes.tagged("a", 1) != shapes.tagged("a", 2)
		and same(shapes.tagged("p", shapes.point(1, 1)), shapes.tagged("p", shapes.point(1, 1)))
	)


func test_written_implementation_wins_in_importer() -> Bool:
	shapes.label("Blorp") == shapes.label("BLORP") and shapes.label("a") != shapes.label("b")


func test_derived_record_uses_written_field_equality_of_another_module() -> Bool:
	(
		others.route(1, "North") == others.route(1, "NORTH")
		and others.route(1, "North") != others.route(2, "North")
	)


func test_same_named_records_keep_their_own_fields() -> Bool:
	local: Point = {x = 1, y = 2, z = 3}
	(
		local == {x = 1, y = 2, z = 3}
		and local != {x = 1, y = 2, z = 4}
		and others.named_point("a") == others.named_point("a")
		and others.named_point("a") != others.named_point("b")
		and shapes.point(1, 2) == shapes.point(1, 2)
	)


func test_imported_records_in_collections() -> Bool:
	points: List[shapes.Point] = [shapes.point(1, 2), shapes.point(3, 4)]
	points.contains(shapes.point(3, 4)) and [shapes.label("x")] == [shapes.label("X")]


tests: TestSuite = {
	description = "Derived record equality across modules",
	tests = [
		("imported record compares by fields", test_imported_record_compares_by_fields),
		("imported generic record compares by fields", test_imported_generic_record_compares_by_fields),
		("written implementation wins in importer", test_written_implementation_wins_in_importer),
		(
			"derived record uses written field equality of another module",
			test_derived_record_uses_written_field_equality_of_another_module,
		),
		("same-named records keep their own fields", test_same_named_records_keep_their_own_fields),
		("imported records in collections", test_imported_records_in_collections),
	]
}
