-- A list pattern inside a constructor must test its length before projecting
-- elements. The outer constructor and literal do not prove the list's shape.
import:
	test: TestSuite


union Element:
	Number(Int)
	Text(String)


union Descriptor:
	Named(String, List[Element])
	Absent


union Envelope:
	Wrapped(Descriptor)


union ListPair:
	Lists(List[Element], List[Element])


union FlaggedElement:
	Flagged(Element, Bool)


union ElementPair:
	Elements(Element, Element)


union OptionalEntry:
	WithOptionalId(String, Option[Int], List[Int])


fixed union EntryStatus:
	Ready
	Waiting


union StatusEntry:
	WithOptionalStatus(Option[EntryStatus], List[Int])


pure func singleton_number(descriptor: Descriptor) -> Int:
	match descriptor:
		Named("Option", [payload]):
			match payload:
				Number(value): value
				Text(_): -2
		Named("Option", _):
			-1
		Named(_, _):
			-3
		Absent:
			-4


func test_empty_list_uses_constructor_fallback() -> Bool:
	singleton_number(Named("Option", [])) == -1


func test_single_element_binds_payload() -> Bool:
	singleton_number(Named("Option", [Number(42)])) == 42


func test_multiple_elements_use_constructor_fallback() -> Bool:
	singleton_number(Named("Option", [Number(42), Number(7)])) == -1


func test_single_element_preserves_payload_constructor() -> Bool:
	singleton_number(Named("Option", [Text("value")])) == -2


func test_other_name_uses_named_fallback() -> Bool:
	singleton_number(Named("Other", [Number(42)])) == -3


func test_other_constructor_uses_outer_fallback() -> Bool:
	singleton_number(Absent) == -4


pure func pair_sum(descriptor: Descriptor) -> Int:
	match descriptor:
		Named("Pair", [Number(first), Number(second)]):
			first + second
		_:
			-1


func test_two_element_pattern_checks_exact_length() -> Bool:
	(
		pair_sum(Named("Pair", [])) == -1
		and pair_sum(Named("Pair", [Number(2)])) == -1
		and pair_sum(Named("Pair", [Number(2), Number(3)])) == 5
		and pair_sum(Named("Pair", [Number(2), Number(3), Number(4)])) == -1
	)


pure func first_number(descriptor: Descriptor) -> Int:
	match descriptor:
		Named("Option", [Number(value), ..._]):
			value
		_:
			-1


func test_spread_pattern_checks_minimum_length() -> Bool:
	(
		first_number(Named("Option", [])) == -1
		and first_number(Named("Option", [Number(2)])) == 2
		and first_number(Named("Option", [Number(2), Number(3)])) == 2
	)


func test_spread_pattern_checks_element_constructor() -> Bool:
	first_number(Named("Option", [Text("other"), Number(3)])) == -1


pure func all_elements(descriptor: Descriptor) -> List[Element]:
	match descriptor:
		Named("All", [...elements]):
			elements
		_:
			[]


func test_spread_only_accepts_every_length() -> Bool:
	(
		all_elements(Named("All", [])).length() == 0
		and all_elements(Named("All", [Number(2)])).length() == 1
		and all_elements(Named("All", [Number(2), Number(3)])).length() == 2
		and all_elements(Named("Other", [Number(2)])).length() == 0
	)


pure func ordered_shape(descriptor: Descriptor) -> Int:
	match descriptor:
		Named("Option", []):
			0
		Named("Option", [Number(7)]):
			1
		Named("Option", [Number(_), ..._]):
			2
		Named("Option", _):
			3
		_:
			4


func test_overlapping_arms_preserve_source_order() -> Bool:
	(
		ordered_shape(Named("Option", [])) == 0
		and ordered_shape(Named("Option", [Number(7)])) == 1
		and ordered_shape(Named("Option", [Number(8)])) == 2
		and ordered_shape(Named("Option", [Number(7), Number(8)])) == 2
		and ordered_shape(Named("Option", [Text("other")])) == 3
		and ordered_shape(Named("Other", [])) == 4
	)


pure func flagged_value(flagged: FlaggedElement) -> Int:
	match flagged:
		Flagged(Number(7), False):
			1
		Flagged(element, True):
			match element:
				Number(value): value + 20
				Text(value): value.length()
		Flagged(Number(_), _):
			3
		_:
			4


func test_partial_catchall_keeps_sibling_constraint_and_binding() -> Bool:
	(
		flagged_value(Flagged(Number(7), False)) == 1
		and flagged_value(Flagged(Number(7), True)) == 27
		and flagged_value(Flagged(Number(8), True)) == 28
		and flagged_value(Flagged(Text("abc".repeat(2)), True)) == 6
		and flagged_value(Flagged(Number(8), False)) == 3
		and flagged_value(Flagged(Text("abc"), False)) == 4
	)


pure func matching_pair(pair: ElementPair) -> Int:
	match pair:
		Elements(Number(0), Number(0)): 0
		Elements(Number(1), Number(1)): 1
		Elements(Number(2), Number(2)): 2
		Elements(_, _): -1


func test_both_nested_constructor_payloads_must_match() -> Bool:
	(
		matching_pair(Elements(Number(0), Number(0))) == 0
		and matching_pair(Elements(Number(1), Number(1))) == 1
		and matching_pair(Elements(Number(2), Number(2))) == 2
		and matching_pair(Elements(Number(0), Number(1))) == -1
		and matching_pair(Elements(Number(1), Number(0))) == -1
		and matching_pair(Elements(Number(2), Number(0))) == -1
		and matching_pair(Elements(Text("other"), Number(2))) == -1
	)


pure func optional_id_key(entry: OptionalEntry) -> Int:
	match entry:
		WithOptionalId("Target", Some(value), [key]):
			value + key
		_:
			-1


func test_optional_payload_binding_survives_sibling_list_guard() -> Bool:
	(
		optional_id_key(WithOptionalId("Target", Some(40), [2])) == 42
		and optional_id_key(WithOptionalId("Target", Some(40), [])) == -1
		and optional_id_key(WithOptionalId("Target", Some(40), [2, 3])) == -1
		and optional_id_key(WithOptionalId("Target", None, [2])) == -1
		and optional_id_key(WithOptionalId("Target", None, [])) == -1
		and optional_id_key(WithOptionalId("Other", Some(40), [2])) == -1
	)


pure func optional_status_key(entry: StatusEntry) -> Int:
	match entry:
		WithOptionalStatus(Some(status), [key]):
			match status:
				Ready: key
				Waiting: -key
		_:
			-1


func test_enum_optional_payload_binding_survives_sibling_list_guard() -> Bool:
	(
		optional_status_key(WithOptionalStatus(Some(Ready), [2])) == 2
		and optional_status_key(WithOptionalStatus(Some(Waiting), [2])) == -2
		and optional_status_key(WithOptionalStatus(None, [2])) == -1
		and optional_status_key(WithOptionalStatus(Some(Ready), [])) == -1
		and optional_status_key(WithOptionalStatus(Some(Ready), [2, 3])) == -1
	)


pure func wrapped_number(envelope: Envelope) -> Int:
	match envelope:
		Wrapped(Named("Option", [Number(value)])):
			value
		Wrapped(_):
			-1


func test_list_guard_survives_nested_constructor() -> Bool:
	(
		wrapped_number(Wrapped(Named("Option", []))) == -1
		and wrapped_number(Wrapped(Named("Option", [Number(2)]))) == 2
		and wrapped_number(Wrapped(Named("Option", [Number(2), Number(3)]))) == -1
	)


pure func pair_singletons(pair: ListPair) -> Int:
	match pair:
		Lists([Number(first)], [Number(second)]):
			first + second
		Lists(_, _):
			-1


func test_both_list_fields_keep_their_guards() -> Bool:
	(
		pair_singletons(Lists([Number(2)], [Number(3)])) == 5
		and pair_singletons(Lists([], [Number(3)])) == -1
		and pair_singletons(Lists([Number(2)], [])) == -1
		and pair_singletons(Lists([Number(2), Number(4)], [Number(3)])) == -1
		and pair_singletons(Lists([Number(2)], [Number(3), Number(4)])) == -1
	)


pure func tuple_number(pair: (Descriptor, Bool)) -> Int:
	match pair:
		(Named("Option", [Number(value)]), True):
			value
		_:
			-1


func test_constructor_payload_guard_survives_tuple_pattern() -> Bool:
	(
		tuple_number((Named("Option", []), True)) == -1
		and tuple_number((Named("Option", [Number(2)]), True)) == 2
		and tuple_number((Named("Option", [Number(2), Number(3)]), True)) == -1
		and tuple_number((Named("Option", [Number(2)]), False)) == -1
	)


pure func nested_list_number(descriptors: List[Descriptor]) -> Int:
	match descriptors:
		[Named("Option", [Number(value)])]:
			value
		_:
			-1


func test_constructor_payload_guard_survives_list_pattern() -> Bool:
	(
		nested_list_number([]) == -1
		and nested_list_number([Named("Option", [])]) == -1
		and nested_list_number([Named("Option", [Number(2)])]) == 2
		and nested_list_number([Named("Option", [Number(2), Number(3)])]) == -1
	)


pure func singleton_text(descriptor: Descriptor) -> String:
	match descriptor:
		Named("Text", [Text(value)]):
			value
		_:
			"fallback"


func test_managed_binding_survives_matched_owner() -> Bool:
	(
		singleton_text(Named("Text", [Text("value".repeat(2))])) == "valuevalue"
		and singleton_text(Named("Text", [])) == "fallback"
		and singleton_text(Named("Text", [Text("first"), Text("second")])) == "fallback"
	)


tests: TestSuite = {
	description = "List length guards inside constructor patterns",
	tests = [
		("empty list uses constructor fallback", test_empty_list_uses_constructor_fallback),
		("single element binds payload", test_single_element_binds_payload),
		("multiple elements use constructor fallback", test_multiple_elements_use_constructor_fallback),
		("single element preserves payload constructor", test_single_element_preserves_payload_constructor),
		("other name uses named fallback", test_other_name_uses_named_fallback),
		("other constructor uses outer fallback", test_other_constructor_uses_outer_fallback),
		("two element pattern checks exact length", test_two_element_pattern_checks_exact_length),
		("spread pattern checks minimum length", test_spread_pattern_checks_minimum_length),
		("spread pattern checks element constructor", test_spread_pattern_checks_element_constructor),
		("spread only accepts every length", test_spread_only_accepts_every_length),
		("overlapping arms preserve source order", test_overlapping_arms_preserve_source_order),
		("partial catchall keeps sibling constraint and binding", test_partial_catchall_keeps_sibling_constraint_and_binding),
		("both nested constructor payloads must match", test_both_nested_constructor_payloads_must_match),
		("optional payload binding survives sibling list guard", test_optional_payload_binding_survives_sibling_list_guard),
		("enum optional payload binding survives sibling list guard", test_enum_optional_payload_binding_survives_sibling_list_guard),
		("list guard survives nested constructor", test_list_guard_survives_nested_constructor),
		("both list fields keep their guards", test_both_list_fields_keep_their_guards),
		("constructor payload guard survives tuple pattern", test_constructor_payload_guard_survives_tuple_pattern),
		("constructor payload guard survives list pattern", test_constructor_payload_guard_survives_list_pattern),
		("managed binding survives matched owner", test_managed_binding_survives_matched_owner),
	]
}
