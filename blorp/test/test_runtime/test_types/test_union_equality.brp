-- Unions, Option, and Result compare payloads with the payload type's own
-- Equatable implementation; nothing falls back to object identity.
import:
	test: TestSuite


record Point {x: Int, y: Int}


union Shape:
	Circle(Int)
	Named(String)
	Nothing


fixed union Color:
	Red
	Green


implements Equatable for Point:
	pure func equals(a: Point, b: Point) -> Bool:
		a.x == b.x and a.y == b.y

	pure func not_equals(a: Point, b: Point) -> Bool:
		not equals(a, b)


implements Equatable for Shape:
	pure func equals(a: Shape, b: Shape) -> Bool:
		match (a, b):
			(Circle(left), Circle(right)):
				left == right
			(Named(left), Named(right)):
				left == right
			(Nothing, Nothing):
				True
			_:
				False

	pure func not_equals(a: Shape, b: Shape) -> Bool:
		not equals(a, b)


func test_union_with_implementation_compares_payloads() -> Bool:
	built_name: String = "a" + "b"

	Named(built_name) == Named("ab") and Named("ab") != Named("ac") and Circle(1) != Nothing


func test_option_of_equatable_record_compares_payloads() -> Bool:
	left: Option[Point] = Some({x = 1, y = 2})
	same: Option[Point] = Some({x = 1, y = 2})
	different: Option[Point] = Some({x = 1, y = 3})
	empty: Option[Point] = None

	left == same and left != different and left != empty and empty == None


func test_option_of_enum_and_string() -> Bool:
	color: Option[Color] = Some(Red)
	built: Option[String] = Some("a" + "b")

	color == Some(Red) and color != Some(Green) and built == Some("ab")


func test_result_compares_payloads() -> Bool:
	ok_left: Result[List[Int], String] = Ok([1])
	ok_same: Result[List[Int], String] = Ok([1])
	err_left: Result[List[Int], String] = Err("a" + "b")
	err_same: Result[List[Int], String] = Err("ab")

	ok_left == ok_same and err_left == err_same and ok_left != err_left


func test_list_of_options_of_records() -> Bool:
	left: List[Option[Point]] = [Some({x = 1, y = 2}), None]
	same: List[Option[Point]] = [Some({x = 1, y = 2}), None]

	left == same


func test_tuples_compare_components_including_literals() -> Bool:
	built: String = "va" + "lue"
	points: (Int, Option[Point]) = (1, Some({x = 1, y = 2}))
	same_points: (Int, Option[Point]) = (1, Some({x = 1, y = 2}))

	(1, "value") == (1, built) and points == same_points


tests: TestSuite = {
	description = "Union, Option, and Result equality",
	tests = [
		("union with implementation compares payloads", test_union_with_implementation_compares_payloads),
		("option of equatable record compares payloads", test_option_of_equatable_record_compares_payloads),
		("option of enum and string", test_option_of_enum_and_string),
		("result compares payloads", test_result_compares_payloads),
		("list of options of records", test_list_of_options_of_records),
		("tuples compare components including literals", test_tuples_compare_components_including_literals),
	]
}
