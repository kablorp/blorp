-- Declares records, a union, an alias and an implementation over the opaque
-- `NodeId` owned by `opaque_cycle_ids`, which imports them back.
import:
	./opaque_cycle_ids: NodeId, node_number


record Node {
	id: NodeId,
	label: String
}


union Edge:
	Linked(NodeId, NodeId)
	Detached


type alias NodeIds = List[NodeId]


trait Numbered:
	pure func number(self: Self) -> Int


implements Numbered for NodeId:
	pure func number(self: NodeId) -> Int:
		node_number(self)


pure func node_id(node: Node) -> NodeId:
	node.id


pure func relabel(node: Node, id: NodeId, label: String) -> Node:
	{ node |
		id = id,
		label = label
	}
