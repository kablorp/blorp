import:
	traits: Equatable


record ImportedChoice {
	value: Int
}


type alias ChoiceAlias = ImportedChoice


implements Equatable for ChoiceAlias:
	pure func equals(left: ChoiceAlias, right: ChoiceAlias) -> Bool:
		True

	pure func not_equals(left: ChoiceAlias, right: ChoiceAlias) -> Bool:
		True
