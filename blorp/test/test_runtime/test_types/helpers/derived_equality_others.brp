-- A record spelled like `Point` in derived_equality_shapes.brp, and records
-- whose derived equality goes through records of that module.
import:
	./derived_equality_shapes as shapes


record Point {
	name: String
}


record Route {
	start: shapes.Point,
	label: shapes.Label
}


pure func named_point(name: String) -> Point:
	{name = name}


pure func route(x: Int, text: String) -> Route:
	{start = shapes.point(x, 0), label = shapes.label(text)}
