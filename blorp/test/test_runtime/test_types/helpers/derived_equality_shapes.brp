-- Records for test_derived_record_equality_modules.brp: one that derives
-- Equatable, a generic one, and one whose written implementation must win in
-- every module that compares it.
record Point {
	x: Int,
	y: Int
}


record Tagged[T] {
	tag: String,
	value: T
}


record Label {
	text: String
}


-- Case-insensitive, unlike the derived fieldwise comparison.
implements Equatable for Label:
	pure func equals(left: Label, right: Label) -> Bool:
		left.text.lower() == right.text.lower()


pure func point(x: Int, y: Int) -> Point:
	{x = x, y = y}


pure func tagged[T](tag: String, value: T) -> Tagged[T]:
	{tag = tag, value = value}


pure func label(text: String) -> Label:
	{text = text}
