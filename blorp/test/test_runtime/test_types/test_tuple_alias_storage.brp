-- Opaque tuple identity stays semantic while Option/closure/native storage
-- follows the canonical generated record row.
import:
	stream as S
	test: TestSuite


opaque type Packet = (String, Int)


private pure func packet(label: String, ordinal: Int) -> Packet:
	into_opaque Packet((label, ordinal))


private pure func packet_parts(value: Packet) -> (String, Int):
	from_opaque Packet(value)


func test_opaque_packet_survives_options_and_typed_capture() -> Bool:
	label = "opaque".repeat(2)
	held = packet(label, 7)
	read = func() -> Packet: held
	options: List[Option[Packet]] = [Some(held), None]
	nested: List[(Option[Packet], String)] = [(Some(read()), "nested")]
	first_parts = match options.get(0):
		Some(Some(first)):
			packet_parts(first)
		_:
			("missing", -1)
	has_none = match options.get(1):
		Some(None):
			True
		_:
			False
	nested_matches = match nested.get(0):
		Some((Some(second), tag)):
			parts = packet_parts(second)
			parts[0] == label and parts[1] == 7 and tag == "nested"
		_:
			False
	captured_parts = packet_parts(read())
	(
		first_parts[0] == label and first_parts[1] == 7
		and has_none and nested_matches
		and captured_parts[0] == label and captured_parts[1] == 7
	)


func test_unfold_preserves_opaque_packet_state_and_output() -> Bool:
	prefix = "capture".repeat(2)
	step = func(state: Packet) -> Option[(Packet, Packet)]:
		parts = packet_parts(state)
		if parts[1] < 2:
			Some((packet(prefix + parts[0], parts[1]), packet(parts[0], parts[1] + 1)))
		else:
			None
	values: List[Packet] = S.collect(S.unfold(packet("state", 0), step))
	match (values.get(0), values.get(1)):
		(Some(first), Some(second)):
			first_parts = packet_parts(first)
			second_parts = packet_parts(second)
			(
				values.length() == 2
				and first_parts[0] == prefix + "state" and first_parts[1] == 0
				and second_parts[0] == prefix + "state" and second_parts[1] == 1
			)
		_:
			False


tests: TestSuite = {
	description = "Tuple aliases use canonical product storage",
	tests = [
		("opaque packet survives Options and typed capture", test_opaque_packet_survives_options_and_typed_capture),
		("unfold preserves opaque packet state and output", test_unfold_preserves_opaque_packet_state_and_output),
	],
}
