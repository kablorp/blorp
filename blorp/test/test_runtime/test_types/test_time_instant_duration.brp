import:
	test: TestSuite
	time:
		Instant,
		add_duration,
		duration_between,
		duration_from_microseconds,
		duration_to_microseconds,
		instant_from_posix_microseconds,
		instant_from_unix_seconds,
		instant_to_posix_microseconds,
		instant_to_unix_seconds,
		subtract_duration,
	units: Duration


func test_instant_posix_microseconds_roundtrip() -> Bool:
	t: Instant = instant_from_posix_microseconds(1234567)
	instant_to_posix_microseconds(t) == 1234567


func test_instant_unix_seconds_roundtrip() -> Bool:
	t: Instant = instant_from_unix_seconds(1704067200)
	instant_to_unix_seconds(t) == 1704067200


func test_duration_microseconds_roundtrip() -> Bool:
	d: Duration = duration_from_microseconds(1500)
	duration_to_microseconds(d) == 1500


func test_add_duration() -> Bool:
	t: Instant = instant_from_posix_microseconds(1000)
	d: Duration = duration_from_microseconds(250)
	instant_to_posix_microseconds(add_duration(t, d)) == 1250


func test_subtract_duration() -> Bool:
	t: Instant = instant_from_posix_microseconds(1000)
	d: Duration = duration_from_microseconds(250)
	instant_to_posix_microseconds(subtract_duration(t, d)) == 750


func test_duration_between() -> Bool:
	start: Instant = instant_from_posix_microseconds(1000)
	finish: Instant = instant_from_posix_microseconds(1750)
	duration_to_microseconds(duration_between(finish, start)) == 750


tests: TestSuite = {
	description = "Time Instant and Duration wrappers",
	tests = [
		("instant posix microseconds roundtrip", test_instant_posix_microseconds_roundtrip),
		("instant unix seconds roundtrip", test_instant_unix_seconds_roundtrip),
		("duration microseconds roundtrip", test_duration_microseconds_roundtrip),
		("add duration", test_add_duration),
		("subtract duration", test_subtract_duration),
		("duration between", test_duration_between),
	]
}
