import:
	./test_enum as EnumTests
	-- Loaded for its Direction union constructors; this must not hijack
	-- enum matches in test_enum.
	test: TestSuite, run_suite


func test_enum_match_uses_enum_constructors() -> Bool:
	run_suite(EnumTests.tests)


tests: TestSuite = {
	description = "Enum Constructor Collision",
	tests = [
		(
			"enum match ignores same-named imported union constructors",
			test_enum_match_uses_enum_constructors,
		),
	]
}
