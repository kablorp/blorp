-- Managed product literals allocate each authored value once; fill shares
-- one record across every slot. Exact pins include existing tensor COW costs
-- and scalar observation endpoints, with no snapshot observer allowance.
import:
	memory:
		MemoryCounter(ManagedAllocations, MemoryStatsActive, OracleStatsActive),
		read_memory_counter,
		same_object,
		reset_mem_stats,
	tensor: get_or, set_index
	test: TestSuite


-- Pins measured after the exact logical workloads with scalar counters.
private VECTOR_LITERAL_ALLOCATIONS: Int = 10
private VECTOR_FILL_ALLOCATIONS: Int = 3
private MATRIX_LITERAL_ALLOCATIONS: Int = 5
private MATRIX_FILL_ALLOCATIONS: Int = 2
private VECTOR_UPDATE_ALLOCATIONS: Int = 22


record Pt {
	x: Int,
	y: Int
}


func test_literal_allocates_each_authored_record_once() -> Bool:
	reset_mem_stats()
	active_before = counters_active()
	v: Pt[#8] = {{
			x = 0,
			y = 0
		}, {
			x = 1,
			y = 2
		}, {
			x = 2,
			y = 4
		}, {
			x = 3,
			y = 6
		}, {
			x = 4,
			y = 8
		}, {
			x = 5,
			y = 10
		}, {
			x = 6,
			y = 12
		}, {
			x = 7,
			y = 14
		}}
	p: Pt = v.get_or(
		7,
		{
			x = -1,
			y = -1
		},
	)
	allocations = read_memory_counter(ManagedAllocations)
	p.x == 7 and p.y == 14 and active_before and counters_active() and allocations == VECTOR_LITERAL_ALLOCATIONS


func test_fill_shares_one_record() -> Bool:
	reset_mem_stats()
	active_before = counters_active()
	v: Pt[#1000] = vector(
		{
			x = 0,
			y = 0
		},
		1000,
	)

	-- Read one to prevent optimization
	p: Pt = v.get_or(
		500,
		{
			x = -1,
			y = -1
		},
	)
	_ = p.x
	allocations = read_memory_counter(ManagedAllocations)

	-- One shared Pt, one vector, and the authored get_or default.
	(
		p.x == 0 and p.y == 0 and same_object(v[0], v[999])
		and active_before and counters_active() and allocations == VECTOR_FILL_ALLOCATIONS
	)


func test_matrix_literal_allocates_each_authored_record_once() -> Bool:
	reset_mem_stats()
	active_before = counters_active()
	m: Pt[#2, #2] = {
		{{
				x = 1,
				y = 2
			}, {
				x = 3,
				y = 4
			}},
		{{
				x = 5,
				y = 6
			}, {
				x = 7,
				y = 8
			}},
	}
	p: Pt = m[1, 1]
	allocations = read_memory_counter(ManagedAllocations)
	p.x == 7 and p.y == 8 and active_before and counters_active() and allocations == MATRIX_LITERAL_ALLOCATIONS


func test_matrix_fill_shares_one_record() -> Bool:
	reset_mem_stats()
	active_before = counters_active()
	m: Pt[#10, #10] = matrix(
		{
			x = 3,
			y = 4
		},
		10,
		10,
	)
	p: Pt = m[9, 9]
	allocations = read_memory_counter(ManagedAllocations)
	(
		p.x == 3 and p.y == 4 and same_object(m[0, 0], m[9, 9])
		and active_before and counters_active() and allocations == MATRIX_FILL_ALLOCATIONS
	)


func test_set_index_preserves_values_and_exact_cow_cost() -> Bool:
	reset_mem_stats()
	active_before = counters_active()
	var v: Pt[#100] = vector(
		{
			x = 0,
			y = 0
		},
		100,
	)

	-- Write 10 elements
	var i: Int = 0

	while i < 10:
		match (
			v.set_index(
				i,
				{
					x = i,
					y = i * 2
				},
			)
		):
			Some(new_v):
				v = new_v
			None:
				void

		i += 1

	allocations = read_memory_counter(ManagedAllocations)

	-- Initial Pt/vector plus ten authored Pt values and ten tensor copies.
	(
		v[9].x == 9 and v[9].y == 18 and v[99].x == 0
		and active_before and counters_active() and allocations == VECTOR_UPDATE_ALLOCATIONS
	)


private pure func counters_active() -> Bool:
	read_memory_counter(MemoryStatsActive) == 1 and read_memory_counter(OracleStatsActive) == 1


tests: TestSuite = {
	description = "Struct Vector Memory",
	tests = [
		("literal: one allocation per authored record", test_literal_allocates_each_authored_record_once),
		("fill: shared managed record", test_fill_shares_one_record),
		("matrix literal: one allocation per authored record", test_matrix_literal_allocates_each_authored_record_once),
		("matrix fill: shared managed record", test_matrix_fill_shares_one_record),
		("set: exact record and tensor COW cost", test_set_index_preserves_values_and_exact_cow_cost),
	]
}
