-- A record whose fields are all Equatable is Equatable without an
-- `implements` block: `==` compares the fields in declaration order with each
-- field type's own `==`, and `!=` is the trait's default. A generic record is
-- Equatable exactly when its type arguments are, and a written implementation
-- always replaces the derived one.
--
-- Every value is built by a call, so equal operands never share a box and a
-- comparison of addresses could not pass by chance.
import:
	test: TestSuite


record Point {
	x: Int,
	y: Int
}


record Segment {
	start: Point,
	end: Point
}


record Wrap[T] {
	value: T
}


record Inventory {
	items: List[Int],
	label: Option[String],
	name: String,
	weight: Float
}


fixed record Color {
	red: UInt8,
	green: UInt8,
	blue: UInt8
}


-- Every field is a number, so this record is stored inline, as a C struct
-- passed by value. Its derived equals still compares field by field through
-- the impl, never with a struct comparison.
fixed record Cell {
	row: Int,
	column: Int
}


fixed union Suit:
	Hearts
	Spades


record Card {
	suit: Suit,
	rank: Int
}


record Tree {
	label: Int,
	children: List[Tree]
}


record Chain {
	value: Int,
	next: Option[Chain]
}


-- Two records that reach each other through a list.
record Folder {
	name: String,
	files: List[Document]
}


record Document {
	title: String,
	attachments: List[Folder]
}


-- The written implementation ignores case, so it must win over the derived
-- fieldwise comparison.
record Tag {
	text: String
}


implements Equatable for Tag:
	pure func equals(left: Tag, right: Tag) -> Bool:
		left.text.lower() == right.text.lower()


-- A declared bound stays a bound of the derived equality: `Dict[K, Int]`
-- needs `K: Hashable`, and `Index[String]` meets it.
record Index[K: Hashable] {
	entries: Dict[K, Int]
}


-- Hashable needs Equatable, which the record derives.
record Key {
	group: Int,
	name: String
}


implements Hashable for Key:
	pure func hash(self: Key) -> Int:
		self.group.hash()


pure func point(x: Int, y: Int) -> Point:
	{x = x, y = y}


pure func segment(x: Int) -> Segment:
	{start = point(x, 0), end = point(0, x)}


pure func wrap[T](value: T) -> Wrap[T]:
	{value = value}


pure func inventory(items: List[Int], label: Option[String], weight: Float) -> Inventory:
	{items = items, label = label, name = "box", weight = weight}


pure func tree(label: Int, children: List[Tree]) -> Tree:
	{label = label, children = children}


pure func chain(length: Int) -> Chain:
	var current: Chain = {value = 0, next = None}
	var index: Int = 1

	while index < length:
		current = {value = index, next = Some(current)}
		index += 1

	current


pure func not_a_number() -> Float:
	1.0 / 0.0 - 1.0 / 0.0


pure func same[T:Equatable](left: T, right: T) -> Bool:
	left == right


pure func differs[T:Equatable](left: T, right: T) -> Bool:
	left != right


func test_record_equality_compares_fields() -> Bool:
	a: Point = point(1, 2)
	b: Point = point(1, 2)
	a == b and not (a != b) and a != point(1, 3) and a != point(0, 2)


func test_bounded_generic_record_compares_by_fields() -> Bool:
	a: Index[String] = {entries = {"a" => 1}}
	b: Index[String] = {entries = {"a" => 1}}
	c: Index[String] = {entries = {"a" => 2}}
	a == b and a != c


func test_not_equals_negates_derived_equals() -> Bool:
	not (point(4, 5) != point(4, 5)) and point(4, 5) != point(5, 4)


func test_nested_records_compare_nested_fields() -> Bool:
	segment(3) == segment(3) and segment(3) != segment(4)


func test_generic_record_is_equatable_when_argument_is() -> Bool:
	(
		wrap(7) == wrap(7)
		and wrap(7) != wrap(8)
		and wrap("a") == wrap("a")
		and wrap(point(1, 1)) == wrap(point(1, 1))
		and wrap(point(1, 1)) != wrap(point(1, 2))
	)


func test_collection_and_scalar_fields_compare_by_value() -> Bool:
	a: Inventory = inventory([1, 2], Some("tools"), 2.5)
	(
		a == inventory([1, 2], Some("tools"), 2.5)
		and a != inventory([1, 2, 3], Some("tools"), 2.5)
		and a != inventory([1, 2], None, 2.5)
		and a != inventory([1, 2], Some("tools"), 2.0)
	)


func test_float_field_compares_like_float() -> Bool:
	nan: Float = not_a_number()
	a: Inventory = inventory([], None, nan)
	-- NaN is not equal to itself, so a record holding NaN is not equal to a
	-- copy of itself, exactly as the Float does.
	nan != nan and a != inventory([], None, nan) and not (a == a)


func test_fixed_record_compares_through_impl() -> Bool:
	red: Color = {red = to_uint8(255), green = to_uint8(0), blue = to_uint8(0)}
	also_red: Color = {red = to_uint8(255), green = to_uint8(0), blue = to_uint8(0)}
	blue: Color = {red = to_uint8(0), green = to_uint8(0), blue = to_uint8(255)}
	red == also_red and red != blue


pure func cell(row: Int, column: Int) -> Cell:
	{row = row, column = column}


func test_inline_fixed_record_compares_by_fields() -> Bool:
	a: Cell = cell(1, 2)
	(
		a == cell(1, 2)
		and a != cell(1, 3)
		and not (a != cell(1, 2))
		and a.equals(cell(1, 2))
		and not a.equals(cell(2, 2))
		and same(a, cell(1, 2))
	)


func test_inline_fixed_records_in_collections() -> Bool:
	cells: List[Cell] = [cell(1, 2), cell(3, 4)]
	by_name: Dict[String, Cell] = {"origin" => cell(0, 0)}
	(
		cells == [cell(1, 2), cell(3, 4)]
		and cells != [cell(1, 2)]
		and cells.contains(cell(3, 4))
		and not cells.contains(cell(4, 3))
		and by_name == {"origin" => cell(0, 0)}
		and by_name != {"origin" => cell(0, 1)}
	)


func test_equals_method_reaches_derived_equality() -> Bool:
	a: Point = point(1, 2)
	a.equals(point(1, 2)) and not a.equals(point(2, 1)) and equals(a, point(1, 2))


func test_enum_field_compares_by_variant() -> Bool:
	a: Card = {suit = Hearts, rank = 3}
	a == {suit = Hearts, rank = 3} and a != {suit = Spades, rank = 3}


func test_recursive_records_compare_recursively() -> Bool:
	a: Tree = tree(1, [tree(2, []), tree(3, [tree(4, [])])])
	b: Tree = tree(1, [tree(2, []), tree(3, [tree(4, [])])])
	c: Tree = tree(1, [tree(2, []), tree(3, [tree(5, [])])])
	a == b and a != c and chain(5) == chain(5) and chain(5) != chain(6)


func test_mutually_recursive_records_compare() -> Bool:
	inner: Folder = {name = "inner", files = []}
	a: Document = {title = "doc", attachments = [inner]}
	b: Document = {title = "doc", attachments = [{name = "inner", files = []}]}
	c: Document = {title = "doc", attachments = [{name = "other", files = []}]}
	a == b and a != c


func test_written_implementation_replaces_derived() -> Bool:
	a: Tag = {text = "Blorp"}
	a == {text = "BLORP"} and a != {text = "other"}


func test_generic_functions_receive_derived_records() -> Bool:
	(
		same(point(1, 2), point(1, 2))
		and not same(point(1, 2), point(2, 1))
		and differs(segment(1), segment(2))
		and not differs(wrap(3), wrap(3))
	)


func test_lists_of_derived_records_compare_elements() -> Bool:
	a: List[Point] = [point(1, 2), point(3, 4)]
	b: List[Point] = [point(1, 2), point(3, 4)]
	a == b and a != [point(1, 2)] and a.contains(point(3, 4)) and not a.contains(point(4, 3))


func test_dict_values_of_derived_records_compare() -> Bool:
	a: Dict[String, Point] = {"origin" => point(0, 0)}
	b: Dict[String, Point] = {"origin" => point(0, 0)}
	c: Dict[String, Point] = {"origin" => point(0, 1)}
	a == b and a != c


func test_dict_keys_use_derived_equality() -> Bool:
	var counts: Dict[Key, Int] = {}
	counts = counts.set({group = 1, name = "a"}, 1)
	counts = counts.set({group = 1, name = "b"}, 2)
	counts = counts.set({group = 1, name = "a"}, 3)
	counts.length() == 2 and counts.get({group = 1, name = "a"}) == Some(3)


tests: TestSuite = {
	description = "Derived record equality",
	tests = [
		("record equality compares fields", test_record_equality_compares_fields),
		("!= negates the derived equals", test_not_equals_negates_derived_equals),
		("bounded generic record compares by fields", test_bounded_generic_record_compares_by_fields),
		("nested records compare nested fields", test_nested_records_compare_nested_fields),
		("generic record is Equatable when its argument is", test_generic_record_is_equatable_when_argument_is),
		("collection and scalar fields compare by value", test_collection_and_scalar_fields_compare_by_value),
		("Float field compares like Float", test_float_field_compares_like_float),
		("fixed record compares through its impl", test_fixed_record_compares_through_impl),
		("inline fixed record compares by fields", test_inline_fixed_record_compares_by_fields),
		("inline fixed records in collections", test_inline_fixed_records_in_collections),
		("equals method reaches derived equality", test_equals_method_reaches_derived_equality),
		("enum field compares by variant", test_enum_field_compares_by_variant),
		("recursive records compare recursively", test_recursive_records_compare_recursively),
		("mutually recursive records compare", test_mutually_recursive_records_compare),
		("written implementation replaces derived", test_written_implementation_replaces_derived),
		("generic functions receive derived records", test_generic_functions_receive_derived_records),
		("lists of derived records compare elements", test_lists_of_derived_records_compare_elements),
		("Dict values of derived records compare", test_dict_values_of_derived_records_compare),
		("Dict keys use derived equality", test_dict_keys_use_derived_equality),
	]
}
