import:
	test: TestSuite


-- Exercise repeated managed-record allocation and final release. Each
-- record has its own malloc-owned block, so the runtime must free its exact
-- base pointer after the destructor runs. Holding a full burst in a list
-- prevents early release; the second burst checks newly allocated values.
-- Run under the ordinary, leak-check, and sanitizer runtime gates.
record ManagedRecord {
	a: Int,
	b: Int,
	c: Int,
	d: Int
}


BURST_COUNT: Int = 1024


func make_managed_record(n: Int) -> ManagedRecord:
	{ a = n, b = n + 1, c = n + 2, d = n + 3 }


func test_managed_record_release_and_reallocate() -> Bool:
	var lst: List[ManagedRecord] = []
	for i in 0..BURST_COUNT:
		lst = lst.append(make_managed_record(i))
	len_ok: Bool = lst.length() == BURST_COUNT
	first_ok: Bool = match lst.get(0):
		Some(r): r.a == 0 and r.d == 3
		None: False
	last_ok: Bool = match lst.get(BURST_COUNT - 1):
		Some(r): r.a == BURST_COUNT - 1 and r.d == BURST_COUNT + 2
		None: False
	-- Drop the first burst before allocating the second one.
	lst = []
	for i in 0..BURST_COUNT:
		lst = lst.append(make_managed_record(i + BURST_COUNT))
	len_ok and first_ok and last_ok and lst.length() == BURST_COUNT and match lst.get(BURST_COUNT - 1):
		Some(r): r.a == BURST_COUNT * 2 - 1 and r.d == BURST_COUNT * 2 + 2
		None: False


tests: TestSuite = {
	description = "Managed record release and reallocation",
	tests = [
		("managed record release and reallocation", test_managed_record_release_and_reallocate),
	]
}
