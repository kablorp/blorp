-- A record may be named `Module`. Its field reads are projections, and they
-- sit beside reads of a module through its alias.
import:
	./helpers/constants_mod as Constants
	test: TestSuite


record Module {
	x: Int,
	name: String
}


func test_reads_fields_of_a_record_named_module() -> Bool:
	m: Module = {x = 41, name = "hi"}
	m.x + 1 == 42 and m.name == "hi"


func test_reads_module_members_beside_a_record_named_module() -> Bool:
	m: Module = {x = Constants.MY_INT, name = Constants.MY_STRING}
	m.x == 42 and m.name == "hello"


tests: TestSuite = {
	description = "A record named Module",
	tests = [
		("reads fields of a record named Module", test_reads_fields_of_a_record_named_module),
		(
			"reads module members beside a record named Module",
			test_reads_module_members_beside_a_record_named_module,
		),
	]
}
