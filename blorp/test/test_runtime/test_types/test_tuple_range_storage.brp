import:
	dict as D
	stream as S
	tensor: enumerate
	test: TestSuite
	vector as V


-- Tuple slots erase scalar proofs; nominal fields keep their accepted types.
type alias SmallIndex = ..#3
type alias IndexPair = (SmallIndex, SmallIndex)
opaque type BoundedPair = (..#3, ..#3)
opaque type PlainPair = (Int, Int)
opaque type Position = ..#3

record Indexed {
	index: ..#3
}

union IndexChoice:
	Chosen(..#3)

private pure func alias_pair(index: SmallIndex) -> IndexPair:
	(index, index)

private pure func first_alias(pair: (..#3, ..#3)) -> ..#3:
	pair[0]


pure func direct_pair(index: ..#3) -> (..#3, ..#3):
	(index, index)


pure func refined_value(flag: Bool, index: ..#3) -> ..#3:
	if flag:
		index
	else:
		0


pure func call_pair(index: ..#3) -> (..#3, ..#3):
	(refined_value(True, index), refined_value(False, index))


pure func first(pair: (..#3, ..#3)) -> ..#3:
	pair[0]


pure func repeated[T](value: T) -> (T, T):
	(value, value)


pure func nested_pair(index: ..#3) -> ((..#3, ..#3), Bool):
	(direct_pair(index), True)


func test_range_tuple_signature_body_and_projection_agree() -> Bool:
	index: ..#3 = 1
	pair = direct_pair(index)
	first(pair) == 1 and pair[1] == 1


func test_call_field_keeps_refined_call_type() -> Bool:
	pair = call_pair(2)
	pair[0] == 2 and pair[1] == 0


func test_range_tuple_destructure_and_match() -> Bool:
	pair = direct_pair(1)
	(first_value, second_value) = pair
	match pair:
		(left, right):
			first_value == 1 and second_value == 1 and left == 1 and right == 1


func test_generic_argument_refinement_is_erased_by_existing_authority() -> Bool:
	index: ..#3 = 2
	pair = repeated(index)
	pair[0] == 2 and pair[1] == 2


func test_nested_range_tuple_uses_canonical_inner_row() -> Bool:
	outer = nested_pair(1)
	outer[0][0] == 1 and outer[0][1] == 1 and outer[1]


func test_alias_tuple_and_element_use_value_slots() -> Bool:
	index: SmallIndex = 2
	pair: IndexPair = alias_pair(index)
	pair[0] == 2 and first_alias(pair) == 2


private pure func bounded_pair(index: ..#3) -> BoundedPair:
	into_opaque BoundedPair(direct_pair(index))


func test_opaque_tuple_crossing_uses_canonical_value_slots() -> Bool:
	pair = from_opaque BoundedPair(bounded_pair(2))
	pair[0] == 2 and pair[1] == 2


private pure func plain_pair(index: ..#3) -> PlainPair:
	into_opaque PlainPair((index, index))


func test_opaque_plain_tuple_literal_keeps_refined_operands() -> Bool:
	pair = from_opaque PlainPair(plain_pair(2))
	pair[0] == 2 and pair[1] == 2


func test_nominal_record_and_union_keep_range_fields() -> Bool:
	index: ..#3 = 2
	item: Indexed = { index = index }
	choice: IndexChoice = Chosen(index)
	from_record: ..#3 = item.index
	match choice:
		Chosen(from_union):
			from_record == 2 and from_union == 2


private pure func block_value(index: ..#3) -> ..#3:
	local: ..#3 = index
	local


func test_complex_refined_results_as_tuple_operands() -> Bool:
	pair = (refined_value(True, 2), block_value(2))
	pair[0] == 2 and pair[1] == 2


func test_named_enumeration_tuple_escapes() -> Bool:
	values: Int[#3] = {4, 5, 6}
	var pairs: List[(Int, Int)] = []
	for entry in enumerate(values):
		pairs = pairs.append(entry)
	match pairs.get(2):
		Some(last):
			last[0] == 2 and last[1] == 6
		None:
			False


func test_named_enumeration2_tuple_escapes() -> Bool:
	values: Int[#2, #2] = {{1, 2}, {3, 4}}
	var triples: List[(Int, Int, Int)] = []
	for entry in enumerate2(values):
		triples = triples.append(entry)
	match triples.get(3):
		Some(last):
			last[0] == 1 and last[1] == 1 and last[2] == 4
		None:
			False


func test_destructured_enumeration_retains_index_proofs() -> Bool:
	values: Int[#3] = {4, 5, 6}
	matrix: Int[#2, #2] = {{1, 2}, {3, 4}}
	var correct = True
	for (index, value) in enumerate(values):
		correct = correct and values[index] == value
	for (row, column, value) in enumerate2(matrix):
		correct = correct and matrix[row, column] == value
	correct


func test_direct_dictionary_iteration_keeps_refined_values() -> Bool:
	index: ..#3 = 2
	indices: Dict[String, ..#3] = {"second" => index}
	var correct = True
	var visits = 0
	for (label, value) in indices:
		visits = visits + 1
		correct = correct and label == "second" and value == 2
	correct and visits == 1


func test_range_native_producers_use_canonical_tuple_values() -> Bool:
	index: ..#3 = 2
	indices: Dict[String, ..#3] = {"second" => index}
	entries: List[(String, Int)] = D.entries(indices)
	values: List[..#3] = [index]
	stream_entries: List[(Int, Int)] = S.collect(S.enumerate(S.from_list(values)))
	vector_values: SmallIndex[#1] = {index}
	flags: Bool[#1] = {True}
	pairs: (Int, Bool)[#1] = V.zip(vector_values, flags)
	match (entries.get(0), stream_entries.get(0)):
		(Some(entry), Some(stream_entry)):
			(
				entry[0] == "second" and entry[1] == 2
				and stream_entry[0] == 0 and stream_entry[1] == 2
				and pairs[0][0] == 2 and pairs[0][1]
			)
		_:
			False


func test_native_opaque_range_element_preserves_nominal_identity() -> Bool:
	index: ..#3 = 2
	position = into_opaque Position(index)
	positions: Dict[String, Position] = {"second" => position}
	var visits: Int = 0
	var direct_correct: Bool = True
	for (key, value) in positions:
		visits += 1
		direct_correct = direct_correct and key == "second" and from_opaque Position(value) == 2
	stream_entries: List[(Int, Position)] = S.collect(S.enumerate(S.from_list([position])))
	stream_correct = match stream_entries.get(0):
		Some(stream_entry):
			stream_entry[0] == 0 and from_opaque Position(stream_entry[1]) == 2
		None:
			False
	entries: List[(String, Position)] = D.entries(positions)
	values: Position[#1] = {position}
	flags: Bool[#1] = {True}
	pairs: (Position, Bool)[#1] = V.zip(values, flags)
	match entries.get(0):
		Some(entry):
			(
				entry[0] == "second" and from_opaque Position(entry[1]) == 2
				and from_opaque Position(pairs[0][0]) == 2 and pairs[0][1]
				and direct_correct and visits == 1
				and stream_entries.length() == 1
				and stream_correct
			)
		None:
			False


fixed record Point { x: Int, y: Int }
opaque type OpaquePoint = Point
opaque type OpaqueUnit = Void


private pure func opaque_point() -> OpaquePoint:
	into_opaque OpaquePoint({ x = -1, y = 2 })


var unit_calls: Int = 0


private func unit_action() -> Void:
	unit_calls += 1


private func opaque_unit_value() -> OpaqueUnit:
	into_opaque OpaqueUnit(unit_action())


func test_opaque_inline_record_conversion_preserves_value() -> Bool:
	point = from_opaque OpaquePoint(opaque_point())
	point.x == -1 and point.y == 2


func test_opaque_unit_conversion_preserves_call_evaluation() -> Bool:
	unit_calls = 0
	from_opaque OpaqueUnit(opaque_unit_value())
	unit_calls == 1


func test_stored_opaque_range_field_reads_its_registered_type() -> Bool:
	index: ..#3 = 2
	position = into_opaque Position(index)
	values: List[(String, Position)] = [("second", position)]
	match values.get(0):
		Some(pair):
			from_opaque Position(pair[1]) == 2
		None:
			False


tests: TestSuite = {
	description = "Range tuple value shape crossings",
	tests = [
		("opaque inline conversion", test_opaque_inline_record_conversion_preserves_value),
		("opaque Unit conversion", test_opaque_unit_conversion_preserves_call_evaluation),
		("stored opaque Range field", test_stored_opaque_range_field_reads_its_registered_type),
		("signature body projection", test_range_tuple_signature_body_and_projection_agree),
		("refined call field", test_call_field_keeps_refined_call_type),
		("destructure and match", test_range_tuple_destructure_and_match),
		("generic argument", test_generic_argument_refinement_is_erased_by_existing_authority),
		("nested tuple", test_nested_range_tuple_uses_canonical_inner_row),
		("tuple and element aliases", test_alias_tuple_and_element_use_value_slots),
		("opaque tuple crossing", test_opaque_tuple_crossing_uses_canonical_value_slots),
		("opaque plain tuple literal", test_opaque_plain_tuple_literal_keeps_refined_operands),
		("nominal range fields", test_nominal_record_and_union_keep_range_fields),
		("complex tuple operands", test_complex_refined_results_as_tuple_operands),
		("named enumerate tuple", test_named_enumeration_tuple_escapes),
		("named enumerate2 tuple", test_named_enumeration2_tuple_escapes),
		("destructured proven indices", test_destructured_enumeration_retains_index_proofs),
		("direct Dict Range iteration", test_direct_dictionary_iteration_keeps_refined_values),
		("native opaque Range element", test_native_opaque_range_element_preserves_nominal_identity),
		("native range producer", test_range_native_producers_use_canonical_tuple_values),
	]
}
