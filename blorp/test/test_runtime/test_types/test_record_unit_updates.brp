import:
	channel: channel, send, try_recv
	test: TestSuite


record UnitRecord { effect: Void, count: Int, label: String }


private TRACE_CAPACITY: Int = 8


private func trace_unit(events: Channel[Int], marker: Int) -> Void:
	_ = send(events, marker)
	void


private func trace_count(events: Channel[Int], marker: Int) -> Int:
	_ = send(events, marker)
	marker


func test_unique_record_unit_update_preserves_effect_order() -> Bool:
	events: Channel[Int] = channel(TRACE_CAPACITY)
	var value: UnitRecord = {
		effect = trace_unit(events, 0),
		count = 0,
		label = "owned".repeat(2)
	}
	value = { value |
		effect = trace_unit(events, 1),
		count = trace_count(events, 2)
	}
	_ = value.effect
	(
		value.count == 2 and value.label == "ownedowned"
		and try_recv(events) == Some(0)
		and try_recv(events) == Some(1)
		and try_recv(events) == Some(2)
		and try_recv(events) == None
	)


func test_shared_record_unit_update_preserves_original_and_effect_order() -> Bool:
	events: Channel[Int] = channel(TRACE_CAPACITY)
	var value: UnitRecord = {
		effect = trace_unit(events, 0),
		count = 0,
		label = "shared".repeat(2)
	}
	original = value
	value = { value |
		count = trace_count(events, 2),
		effect = trace_unit(events, 1)
	}
	_ = value.effect
	_ = original.effect
	(
		value.count == 2 and original.count == 0
		and value.label == "sharedshared" and original.label == "sharedshared"
		and try_recv(events) == Some(0)
		and try_recv(events) == Some(2)
		and try_recv(events) == Some(1)
		and try_recv(events) == None
	)


tests: TestSuite = {
	description = "Record unit updates preserve values and effects",
	tests = [
		("unique record unit update preserves effect order", test_unique_record_unit_update_preserves_effect_order),
		("shared record unit update preserves original and effect order", test_shared_record_unit_update_preserves_original_and_effect_order),
	],
}
