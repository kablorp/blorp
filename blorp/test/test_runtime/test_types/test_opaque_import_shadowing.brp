import:
	option: Option as T
	test: TestSuite


opaque type Wrapped[T] = T


pure func wrap[T](value: T) -> Wrapped[T]:
	into_opaque Wrapped[T](value)


pure func unwrap[T](value: Wrapped[T]) -> T:
	from_opaque Wrapped[T](value)


pure func test_type_parameter_shadows_imported_type() -> Bool:
	unwrap(wrap(42)) == 42


tests: TestSuite = {
	description = "Opaque imported-name shadowing",
	tests = [("type parameter shadows imported type", test_type_parameter_shadows_imported_type)]
}
