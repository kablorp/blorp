import:
	memory:
		MemoryCounter(ManagedAllocations, ManagedReleases, LiveManagedObjects, MemoryStatsActive, OracleStatsActive),
		read_memory_counter,
		reset_mem_stats,
	test: TestSuite


-- Exact managed constructors/releases; both source spellings share this cost.
private FLAT_RECORD_OBJECTS: Int = 2
private NESTED_RECORD_OBJECTS: Int = 3


fixed record LegacyPoint {x: Int, y: Int}
fixed record FixedRecordPoint {x: Int, y: Int}

fixed record LegacyInner {value: Int}
fixed record LegacyOuter {inner: LegacyInner, other: Int}
fixed record FixedInner {value: Int}
fixed record FixedOuter {inner: FixedInner, other: Int}


pure func legacy_path() -> Int:
	first: LegacyPoint = {x = 2, y = 3}
	second: LegacyPoint = {first | x = first.x + 4}
	first.y + second.x


pure func fixed_path() -> Int:
	first: FixedRecordPoint = {x = 2, y = 3}
	second: FixedRecordPoint = {first | x = first.x + 4}
	first.y + second.x


pure func legacy_nested_path() -> Int:
	inner: LegacyInner = {value = 2}
	first: LegacyOuter = {inner = inner, other = 3}
	second: LegacyOuter = {first | other = first.other + 4}
	first.inner.value + second.other


pure func fixed_nested_path() -> Int:
	inner: FixedInner = {value = 2}
	first: FixedOuter = {inner = inner, other = 3}
	second: FixedOuter = {first | other = first.other + 4}
	first.inner.value + second.other


func test_fixed_record_matches_struct_value_ownership() -> Bool:
	reset_mem_stats()
	legacy_value: Int = legacy_path()
	legacy_allocations = read_memory_counter(ManagedAllocations)
	legacy_releases = read_memory_counter(ManagedReleases)
	legacy_objects = read_memory_counter(LiveManagedObjects)
	legacy_active = read_memory_counter(MemoryStatsActive)
	legacy_oracle_active = read_memory_counter(OracleStatsActive)
	reset_mem_stats()
	fixed_value: Int = fixed_path()
	fixed_allocations = read_memory_counter(ManagedAllocations)
	fixed_releases = read_memory_counter(ManagedReleases)
	fixed_objects = read_memory_counter(LiveManagedObjects)
	fixed_active = read_memory_counter(MemoryStatsActive)
	fixed_oracle_active = read_memory_counter(OracleStatsActive)

	(
		legacy_value == 9
		and fixed_value == legacy_value
		and legacy_active == 1 and legacy_oracle_active == 1
		and fixed_active == 1 and fixed_oracle_active == 1
		and legacy_allocations == fixed_allocations
		and legacy_releases == fixed_releases
		and legacy_objects == fixed_objects
		and fixed_allocations == FLAT_RECORD_OBJECTS
		and fixed_releases == FLAT_RECORD_OBJECTS
		and fixed_objects == 0
	)


func test_nested_fixed_record_matches_nested_struct_ownership() -> Bool:
	reset_mem_stats()
	legacy_value: Int = legacy_nested_path()
	legacy_allocations = read_memory_counter(ManagedAllocations)
	legacy_releases = read_memory_counter(ManagedReleases)
	legacy_objects = read_memory_counter(LiveManagedObjects)
	legacy_active = read_memory_counter(MemoryStatsActive)
	legacy_oracle_active = read_memory_counter(OracleStatsActive)
	reset_mem_stats()
	fixed_value: Int = fixed_nested_path()
	fixed_allocations = read_memory_counter(ManagedAllocations)
	fixed_releases = read_memory_counter(ManagedReleases)
	fixed_objects = read_memory_counter(LiveManagedObjects)
	fixed_active = read_memory_counter(MemoryStatsActive)
	fixed_oracle_active = read_memory_counter(OracleStatsActive)

	(
		legacy_value == 9
		and fixed_value == legacy_value
		and legacy_active == 1 and legacy_oracle_active == 1
		and fixed_active == 1 and fixed_oracle_active == 1
		and legacy_allocations == fixed_allocations
		and legacy_releases == fixed_releases
		and legacy_objects == fixed_objects
		and fixed_allocations == NESTED_RECORD_OBJECTS
		and fixed_releases == NESTED_RECORD_OBJECTS
		and fixed_objects == 0
	)


tests: TestSuite = {
	description = "Fixed record layout",
	tests = [
		("fixed record matches struct value ownership", test_fixed_record_matches_struct_value_ownership),
		("nested fixed record matches nested struct ownership", test_nested_fixed_record_matches_nested_struct_ownership),
	]
}
