import:
	channel: channel, send, try_recv
	test: TestSuite


-- Keep duplicate receiver evaluation observable without filling the channel.
private TRACE_CHANNEL_CAPACITY: Int = 12


private func trace_unit(events: Channel[Int], marker: Int) -> Void:
	_ = send(events, marker)
	void


private func trace_body(events: Channel[Int]) -> String:
	_ = send(events, 2)
	"stored".repeat(2)


private func stored_tuple(events: Channel[Int]) -> (Void, String, Void):
	(trace_unit(events, 1), trace_body(events), trace_unit(events, 3))


func test_unit_fields_preserve_construction_order_without_storage() -> Bool:
	events: Channel[Int] = channel(TRACE_CHANNEL_CAPACITY)
	entries: List[(Void, String, Void)] = [stored_tuple(events)]
	match entries.get(0):
		Some(entry):
			_ = entry[0]
			_ = entry[2]
			(
				entry[1] == "storedstored"
				and try_recv(events) == Some(1)
				and try_recv(events) == Some(2)
				and try_recv(events) == Some(3)
				and try_recv(events) == None
			)
		None:
			False


func test_named_unit_pattern_bindings_preserve_logical_fields() -> Bool:
	events: Channel[Int] = channel(TRACE_CHANNEL_CAPACITY)
	entries: List[(Void, String, Void)] = [stored_tuple(events)]
	match entries.get(0):
		Some((first, body, last)):
			_ = first
			_ = last
			(
				body == "storedstored"
				and try_recv(events) == Some(1)
				and try_recv(events) == Some(2)
				and try_recv(events) == Some(3)
				and try_recv(events) == None
			)
		None:
			False


func test_temporary_unit_projection_evaluates_receiver_once() -> Bool:
	events: Channel[Int] = channel(TRACE_CHANNEL_CAPACITY)
	_ = stored_tuple(events)[0]
	(
		try_recv(events) == Some(1)
		and try_recv(events) == Some(2)
		and try_recv(events) == Some(3)
		and try_recv(events) == None
	)


tests: TestSuite = {
	description = "Tuple record storage semantics",
	tests = [
		("unit fields preserve construction order without storage", test_unit_fields_preserve_construction_order_without_storage),
		("named unit pattern bindings preserve logical fields", test_named_unit_pattern_bindings_preserve_logical_fields),
		("temporary unit projection evaluates receiver once", test_temporary_unit_projection_evaluates_receiver_once),
	]
}
