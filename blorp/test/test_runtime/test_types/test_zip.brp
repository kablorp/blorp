-- Test zip for parallel vector iteration
import:
	test: TestSuite


func test_zip_dot_product() -> Bool:
	a: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	b: Float[#4] = {10.0, 20.0, 30.0, 40.0}
	var total: Float = 0.0

	for (x, y) in a.zip(b):
		total += x * y

	-- 10 + 40 + 90 + 160 = 300
	total == 300.0


func test_zip_different_values() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: Int[#3] = {10, 20, 30}
	var sum: Int = 0

	for (x, y) in a.zip(b):
		sum += x + y

	-- (1+10) + (2+20) + (3+30) = 66
	sum == 66


var iterable_evaluations: Int = 0


func counted_zip(first: Int[#3], second: Int[#3]) -> (Int, Int)[#3]:
	iterable_evaluations += 1
	first.zip(second)


func counted_values(values: Int[#3]) -> Int[#3]:
	iterable_evaluations += 1
	values


func test_zip_iterable_evaluates_once() -> Bool:
	first: Int[#3] = {1, 2, 3}
	second: Int[#3] = {10, 20, 30}
	iterable_evaluations = 0
	var sum: Int = 0
	for (x, y) in counted_zip(first, second):
		sum += x + y
	sum == 66 and iterable_evaluations == 1


func test_nested_zip_iterables_have_independent_temporaries() -> Bool:
	first: Int[#3] = {1, 2, 3}
	second: Int[#3] = {10, 20, 30}
	iterable_evaluations = 0
	var sum: Int = 0
	var visits: Int = 0
	for (outer, _) in first.zip(second):
		for (x, y) in counted_zip(first, second):
			sum += x + y
			visits += 1
	sum == 198 and visits == 9 and iterable_evaluations == 3


func test_statement_iterable_keeps_parent_tensor() -> Bool:
	values: Int[#3] = {1, 2, 3}
	iterable_evaluations = 0
	var sum: Int = 0
	for value in counted_values(values):
		sum += value
	sum == 6 and iterable_evaluations == 1 and values[1] == 2


tests: TestSuite = {
	description = "zip iteration",
	tests = [
		("zip dot product", test_zip_dot_product),
		("zip different values", test_zip_different_values),
		("zip iterable evaluates once", test_zip_iterable_evaluates_once),
		("nested zip iterables have independent temporaries", test_nested_zip_iterables_have_independent_temporaries),
		("statement iterable keeps parent tensor", test_statement_iterable_keeps_parent_tensor),
	]
}
