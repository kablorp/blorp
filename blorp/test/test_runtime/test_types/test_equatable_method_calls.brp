-- Calling `equals` by name, as a method (`a.equals(b)`) or as a plain call
-- (`equals(a, b)`), must reach the same `Equatable` impl as `a == b`. Both
-- forms used to bind to an unbounded compiler builtin that compared two boxes
-- by address, so equal records and tuples in separate allocations compared
-- unequal.
--
-- Every value here is built by a call, so equal operands never share a box.
-- `Tagged` equality ignores its `note` field, so a call that compared fields
-- structurally instead of running the impl would also fail.
import:
	test: TestSuite


record Tagged {
	id: Int,
	note: String
}


implements Equatable for Tagged:
	pure func equals(a: Tagged, b: Tagged) -> Bool:
		a.id == b.id


record Wrap[T] {
	value: T
}


implements Equatable for Wrap[T:Equatable]:
	pure func equals(a: Wrap[T], b: Wrap[T]) -> Bool:
		a.value == b.value


trait Labelled:
	pure func label(self: Self) -> String


implements Labelled for Tagged:
	pure func label(self: Tagged) -> String:
		"tag ${self.id}"


pure func tagged(id: Int, note: String) -> Tagged:
	{id = id, note = "n${note}"}


pure func pair(first: Int, second: String) -> (Int, String):
	(first, "p${second}")


pure func wrap(value: Int) -> Wrap[Int]:
	{value = value}


pure func same_by_method[T:Equatable](a: T, b: T) -> Bool:
	a.equals(b)


pure func same_by_call[T:Equatable](a: T, b: T) -> Bool:
	equals(a, b)


func test_record_equals_method_runs_written_impl() -> Bool:
	a: Tagged = tagged(1, "first")
	b: Tagged = tagged(1, "second")
	c: Tagged = tagged(2, "first")
	a.equals(b) and not a.equals(c)


func test_record_equals_call_runs_written_impl() -> Bool:
	a: Tagged = tagged(1, "first")
	b: Tagged = tagged(1, "second")
	c: Tagged = tagged(2, "first")
	equals(a, b) and not equals(a, c)


func test_record_equals_agrees_with_operator() -> Bool:
	a: Tagged = tagged(3, "x")
	b: Tagged = tagged(3, "y")
	a.equals(b) == (a == b) and equals(a, b) == (a == b)


func test_tuple_equals_compares_values() -> Bool:
	a: (Int, String) = pair(1, "x")
	b: (Int, String) = pair(1, "x")
	c: (Int, String) = pair(1, "y")
	a.equals(b) and equals(a, b) and not a.equals(c) and not equals(a, c)


func test_generic_record_equals_runs_generic_impl() -> Bool:
	a: Wrap[Int] = wrap(7)
	b: Wrap[Int] = wrap(7)
	c: Wrap[Int] = wrap(8)
	a.equals(b) and equals(a, b) and not a.equals(c) and not equals(a, c)


func test_bounded_generic_equals_dispatches_to_impl() -> Bool:
	(
		same_by_method(tagged(4, "x"), tagged(4, "y"))
		and same_by_call(tagged(4, "x"), tagged(4, "y"))
		and not same_by_method(tagged(4, "x"), tagged(5, "x"))
		and same_by_method(pair(2, "z"), pair(2, "z"))
		and same_by_call(wrap(9), wrap(9))
		and not same_by_call(wrap(9), wrap(10))
	)


func test_user_trait_method_through_ufcs() -> Bool:
	-- Control: a user trait method called as a method reaches its impl.
	tagged(6, "x").label() == "tag 6" and label(tagged(7, "x")) == "tag 7"


tests: TestSuite = {
	description = "Calling Equatable.equals by name",
	tests = [
		("record equals method runs written impl", test_record_equals_method_runs_written_impl),
		("record equals call runs written impl", test_record_equals_call_runs_written_impl),
		("record equals agrees with ==", test_record_equals_agrees_with_operator),
		("tuple equals compares values", test_tuple_equals_compares_values),
		("generic record equals runs generic impl", test_generic_record_equals_runs_generic_impl),
		("bounded generic equals dispatches to impl", test_bounded_generic_equals_dispatches_to_impl),
		("user trait method through UFCS", test_user_trait_method_through_ufcs),
	]
}
