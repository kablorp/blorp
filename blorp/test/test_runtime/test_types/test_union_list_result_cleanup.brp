import:
	test: TestSuite


-- Control case: generic union/List cleanup works without a first-class parser
-- closure, so failures in the parser regressions implicate closure/Perceus
-- ownership rather than ParseResult[List[Span]] by itself.
record Cursor {
	offset: Int,
	line: Int,
	column: Int
}


record Span {
	start: Cursor,
	end: Cursor
}


union ParseResult[T]:
	Parsed(T, Cursor)
	ParseFailed(String)


pure func cursor(offset: Int) -> Cursor:
	{
		offset = offset,
		line = 1,
		column = offset + 1
	}


pure func span(start_offset: Int, end_offset: Int) -> Span:
	{
		start = cursor(start_offset),
		end = cursor(end_offset)
	}


pure func direct_spans() -> ParseResult[List[Span]]:
	Parsed(
		[span(0, 1), span(2, 4), span(5, 8)],
		cursor(8),
	)


pure func list_spans() -> List[Span]:
	[span(0, 1), span(2, 4), span(5, 8)]


pure func span_offsets_are(span: Span, start_offset: Int, end_offset: Int) -> Bool:
	span.start.offset == start_offset and span.end.offset == end_offset


pure func spans_are_expected(spans: List[Span]) -> Bool:
	match spans.get(0):
		Some(first):
			match spans.get(1):
				Some(second):
					match spans.get(2):
						Some(third):
							first_ok: Bool = span_offsets_are(first, 0, 1)
							second_ok: Bool = span_offsets_are(second, 2, 4)
							third_ok: Bool = span_offsets_are(third, 5, 8)

							first_ok and second_ok and third_ok
						None:
							False
				None:
					False
		None:
			False


func test_direct_union_list_payload_cleanup() -> Bool:
	match direct_spans():
		Parsed(spans, rest):
			rest.offset == 8 and spans_are_expected(spans)
		ParseFailed(_):
			False


func test_direct_list_cleanup() -> Bool:
	spans_are_expected(list_spans())


tests: TestSuite = {
	description = "Union list result cleanup",
	tests = [
		("direct union list payload cleanup", test_direct_union_list_payload_cleanup),
		("direct list cleanup", test_direct_list_cleanup),
	]
}
