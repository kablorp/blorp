import:
	dict as Dicts
	set as Sets
	test: TestSuite


fixed union LegacyChoice:
	LegacyFirst
	LegacySecond


union OrdinaryChoice:
	OrdinaryFirst
	OrdinarySecond


fixed union FixedChoice:
	FixedFirst
	FixedSecond


implements Hashable for LegacyChoice:
	pure func hash(value: LegacyChoice) -> Int:
		match value:
			LegacyFirst: 0
			LegacySecond: 1


implements Hashable for OrdinaryChoice:
	pure func hash(value: OrdinaryChoice) -> Int:
		match value:
			OrdinaryFirst: 0
			OrdinarySecond: 1


implements Hashable for FixedChoice:
	pure func hash(value: FixedChoice) -> Int:
		match value:
			FixedFirst: 0
			FixedSecond: 1


union OrdinaryIdentity:
	OrdinaryIdentityFirst
	OrdinaryIdentitySecond


fixed union FixedIdentity:
	FixedIdentityFirst
	FixedIdentitySecond


type alias OrdinaryIdentityAlias = OrdinaryIdentity


union OrdinaryHashed:
	OrdinaryHashedFirst
	OrdinaryHashedSecond


fixed union FixedHashed:
	FixedHashedFirst
	FixedHashedSecond


union OrdinaryNeverEqual:
	OrdinaryNeverEqualValue


fixed union FixedNeverEqual:
	FixedNeverEqualValue


implements Equatable for OrdinaryNeverEqual:
	pure func equals(left: OrdinaryNeverEqual, right: OrdinaryNeverEqual) -> Bool:
		False

	pure func not_equals(left: OrdinaryNeverEqual, right: OrdinaryNeverEqual) -> Bool:
		True


implements Equatable for FixedNeverEqual:
	pure func equals(left: FixedNeverEqual, right: FixedNeverEqual) -> Bool:
		False

	pure func not_equals(left: FixedNeverEqual, right: FixedNeverEqual) -> Bool:
		True


ORDINARY_CONSTANT_EQUAL: Bool = OrdinaryNeverEqualValue == OrdinaryNeverEqualValue

FIXED_CONSTANT_EQUAL: Bool = FixedNeverEqualValue == FixedNeverEqualValue


implements Equatable for OrdinaryIdentity:
	pure func equals(left: OrdinaryIdentity, right: OrdinaryIdentity) -> Bool:
		True

	pure func not_equals(left: OrdinaryIdentity, right: OrdinaryIdentity) -> Bool:
		False


implements Hashable for OrdinaryIdentity:
	pure func hash(value: OrdinaryIdentity) -> Int:
		0


implements Equatable for FixedIdentity:
	pure func equals(left: FixedIdentity, right: FixedIdentity) -> Bool:
		True

	pure func not_equals(left: FixedIdentity, right: FixedIdentity) -> Bool:
		False


implements Hashable for FixedIdentity:
	pure func hash(value: FixedIdentity) -> Int:
		0


implements Hashable for OrdinaryHashed:
	pure func hash(value: OrdinaryHashed) -> Int:
		0


implements Hashable for FixedHashed:
	pure func hash(value: FixedHashed) -> Int:
		0


foreign(include: "fieldless_union_scalar_bridge.h"):
	func legacy_native_tag(value: LegacyChoice) -> Int = "bridge_scalar_tag"
	func ordinary_native_tag(value: OrdinaryChoice) -> Int = "bridge_scalar_tag"
	func fixed_native_tag(value: FixedChoice) -> Int = "bridge_scalar_tag"


pure func equal_through_bound[T:Equatable](left: T, right: T) -> Bool:
	left == right


pure func hash_through_bound[T:Hashable](value: T) -> Int:
	value.hash()


func test_default_equality() -> Bool:
	(
		LegacyFirst == LegacyFirst
		and LegacyFirst != LegacySecond
		and OrdinaryFirst == OrdinaryFirst
		and OrdinaryFirst != OrdinarySecond
		and FixedFirst == FixedFirst
		and FixedFirst != FixedSecond
		and equal_through_bound(LegacySecond, LegacySecond)
		and equal_through_bound(OrdinarySecond, OrdinarySecond)
		and equal_through_bound(FixedSecond, FixedSecond)
	)


func test_matching() -> Bool:
	legacy: Int = match LegacySecond:
		LegacyFirst:
			0
		LegacySecond:
			1

	ordinary: Int = match OrdinarySecond:
		OrdinaryFirst:
			0
		OrdinarySecond:
			1

	fixed: Int = match FixedSecond:
		FixedFirst:
			0
		FixedSecond:
			1

	legacy == 1 and ordinary == 1 and fixed == 1


func test_authored_hashing() -> Bool:
	(
		hash_through_bound(LegacyFirst) == 0
		and LegacyFirst.hash() == 0
		and hash_through_bound(LegacySecond) == 1
		and LegacySecond.hash() == 1
		and hash_through_bound(OrdinaryFirst) == 0
		and OrdinaryFirst.hash() == 0
		and hash_through_bound(OrdinarySecond) == 1
		and OrdinarySecond.hash() == 1
		and hash_through_bound(FixedFirst) == 0
		and FixedFirst.hash() == 0
		and hash_through_bound(FixedSecond) == 1
		and FixedSecond.hash() == 1
	)


pure func key_collections[T:Hashable](first: T, second: T) -> Bool:
	var entries: Dict[T, Int] = Dicts.dict()
	entries = entries
		.set(first, 3)
		.set(second, 5)
		.set(first, 7)
	var keys: Set[T] = Sets.set()
	keys = keys
		.add(first)
		.add(second)
		.add(first)
	(
		entries.length() == 2
		and entries
			.get(first)
			.get_or(0) == 7
		and entries
			.get(second)
			.get_or(0) == 5
		and keys.length() == 2
		and keys.contains(first)
		and keys.contains(second)
	)


func test_dict_and_set_callbacks() -> Bool:
	(
		key_collections(LegacyFirst, LegacySecond)
		and key_collections(OrdinaryFirst, OrdinarySecond)
		and key_collections(FixedFirst, FixedSecond)
	)


func test_native_long_tags() -> Bool:
	(
		legacy_native_tag(LegacyFirst) == 0
		and legacy_native_tag(LegacySecond) == 1
		and ordinary_native_tag(OrdinaryFirst) == 0
		and ordinary_native_tag(OrdinarySecond) == 1
		and fixed_native_tag(FixedFirst) == 0
		and fixed_native_tag(FixedSecond) == 1
	)


pure func overridden_key_collections[T:Hashable](first: T, second: T) -> Bool:
	var entries: Dict[T, Int] = Dicts.dict()
	entries = entries
		.set(first, 7)
		.set(second, 9)
	var keys: Set[T] = Sets.set()
	keys = keys
		.add(first)
		.add(second)
	(
		entries.length() == 1
		and entries
			.get(first)
			.get_or(0) == 9
		and keys.length() == 1
	)


func test_explicit_key_identity() -> Bool:
	alias_first: OrdinaryIdentityAlias = OrdinaryIdentityFirst
	alias_second: OrdinaryIdentityAlias = OrdinaryIdentitySecond
	(
		overridden_key_collections(OrdinaryIdentityFirst, OrdinaryIdentitySecond)
		and overridden_key_collections(FixedIdentityFirst, FixedIdentitySecond)
		and overridden_key_collections(alias_first, alias_second)
	)


func test_explicit_hash_with_default_tag_equality() -> Bool:
	(
		hash_through_bound(OrdinaryHashedSecond) == 0
		and hash_through_bound(FixedHashedSecond) == 0
		and key_collections(OrdinaryHashedFirst, OrdinaryHashedSecond)
		and key_collections(FixedHashedFirst, FixedHashedSecond)
	)


func test_explicit_equality_before_constant_evaluation() -> Bool:
	(
		not ORDINARY_CONSTANT_EQUAL
		and not FIXED_CONSTANT_EQUAL
		and not (OrdinaryNeverEqualValue == OrdinaryNeverEqualValue)
		and not (FixedNeverEqualValue == FixedNeverEqualValue)
	)


tests: TestSuite = {
	description = "Shared fieldless union scalar bridge",
	tests = [
		("default equality and generic Equatable", test_default_equality),
		("exhaustive matching", test_matching),
		("authored hashing and generic Hashable", test_authored_hashing),
		("Dict and Set callbacks", test_dict_and_set_callbacks),
		("native long ordinal tags", test_native_long_tags),
		("explicit equality and hash define key identity", test_explicit_key_identity),
		(
			"explicit hash retains default tag equality",
			test_explicit_hash_with_default_tag_equality,
		),
		(
			"explicit equality precedes constant evaluation",
			test_explicit_equality_before_constant_evaluation,
		),
	]
}
