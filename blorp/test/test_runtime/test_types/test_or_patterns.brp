import:
	test: TestSuite


union Color:
	Red
	Green
	Blue
	Yellow


union Shape:
	Circle
	Square
	Triangle


record SmallPayload {
	body: String
}


record LargePayload {
	flag: Int,
	extra: Int,
	body: String
}


union RecordShape:
	SmallShape(SmallPayload)
	LargeShape(LargePayload)


union LabelEntry:
	WideEntry(Int, Int, String)
	NarrowEntry(String)
	PairEntry(String, Int)


pure func record_body(shape: RecordShape) -> String:
	match shape:
		SmallShape(item):
			item.body
		LargeShape(item):
			item.body


func test_separate_record_arms_read_each_payload_layout() -> Bool:
	small: SmallPayload = { body = "small" }
	large: LargePayload = { flag = 7, extra = 9, body = "large" }
	record_body(SmallShape(small)) == "small" and record_body(LargeShape(large)) == "large"


pure func entry_label(entry: LabelEntry) -> String:
	match entry:
		WideEntry(_, _, label):
			label
		NarrowEntry(label):
			label
		PairEntry(label, _):
			label


func test_separate_arms_read_each_payload_position() -> Bool:
	(
		entry_label(WideEntry(7, 9, "wide")) == "wide"
		and entry_label(NarrowEntry("narrow")) == "narrow"
		and entry_label(PairEntry("pair", 11)) == "pair"
	)


pure func either_result_value(result: Result[Int, Int]) -> Int:
	match result:
		Ok(value):
			value
		Err(value):
			value


func test_separate_result_arms_read_both_alternatives() -> Bool:
	either_result_value(Ok(7)) == 7 and either_result_value(Err(9)) == 9


func test_basic_or_pattern() -> Bool:
	result: String = match Red:
		Red | Blue:
			"cool"
		Green | Yellow:
			"warm"

	result == "cool"


func test_or_pattern_second_alt() -> Bool:
	result: String = match Blue:
		Red | Blue:
			"cool"
		Green | Yellow:
			"warm"

	result == "cool"


func test_or_pattern_fallthrough() -> Bool:
	result: String = match Yellow:
		Red | Blue:
			"cool"
		Green | Yellow:
			"warm"

	result == "warm"


func test_or_pattern_with_wildcard() -> Bool:
	result: String = match Triangle:
		Circle | Square:
			"regular"
		_:
			"other"

	result == "other"


func test_or_pattern_three_alts() -> Bool:
	result: String = match Green:
		Red | Green | Blue:
			"primary"
		Yellow:
			"secondary"

	result == "primary"


func test_or_pattern_int_literals() -> Bool:
	x: Int = 3

	result: String = match x:
		1 | 2 | 3:
			"small"
		_:
			"big"

	result == "small"


func test_or_pattern_int_literal_miss() -> Bool:
	x: Int = 5

	result: String = match x:
		1 | 2 | 3:
			"small"
		_:
			"big"

	result == "big"


func test_or_pattern_string_literals() -> Bool:
	s: String = "hello"

	result: String = match s:
		"hello" | "hi":
			"greeting"
		_:
			"other"

	result == "greeting"


func test_or_pattern_bool() -> Bool:
	result: Int = match True:
		True | False:
			42

	result == 42


func classify(c: Color) -> String:
	match c:
		Red | Blue:
			"cool"
		Green | Yellow:
			"warm"


func test_or_pattern_in_function() -> Bool:
	classify(Red) == "cool" and classify(Green) == "warm"


tests: TestSuite = {
	description = "Or-Pattern Tests",
	tests = [
		("separate record arms read each payload layout", test_separate_record_arms_read_each_payload_layout),
		("separate arms read each payload position", test_separate_arms_read_each_payload_position),
		("separate Result arms read both alternatives", test_separate_result_arms_read_both_alternatives),
		("basic or-pattern", test_basic_or_pattern),
		("or-pattern second alternative", test_or_pattern_second_alt),
		("or-pattern fallthrough", test_or_pattern_fallthrough),
		("or-pattern with wildcard", test_or_pattern_with_wildcard),
		("or-pattern three alternatives", test_or_pattern_three_alts),
		("or-pattern int literals", test_or_pattern_int_literals),
		("or-pattern int literal miss", test_or_pattern_int_literal_miss),
		("or-pattern string literals", test_or_pattern_string_literals),
		("or-pattern bool", test_or_pattern_bool),
		("or-pattern in function", test_or_pattern_in_function),
	]
}
