import:
	test: TestSuite


foreign(include: "ffi_bytes_mutation_header.h"):
	func mutate_first_byte(data: Bytes) -> Int = "ffi_mutate_first_byte"
	@no_copy func mutate_first_byte_no_copy(data: Bytes) -> Int = "ffi_mutate_first_byte"


func test_default_foreign_copies_bytes() -> Bool:
	bytes: Bytes = "abc".to_bytes()
	_ = mutate_first_byte(bytes)
	bytes.to_string() == "abc"


func test_no_copy_foreign_borrows_bytes() -> Bool:
	bytes: Bytes = "abc".to_bytes()
	_ = mutate_first_byte_no_copy(bytes)
	bytes.to_string() == "Zbc"


tests: TestSuite = {
	description = "FFI Bytes Copy",
	tests = [
		("default foreign copies bytes", test_default_foreign_copies_bytes),
		("no_copy foreign borrows bytes", test_no_copy_foreign_borrows_bytes),
	]
}
