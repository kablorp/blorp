-- Test file I/O functions
import:
	bytes as B
	fs: IOError, resource_path, temporary_directory
	system: file_exists, read_bytes, read_file, remove_file, temp_dir, write_bytes, write_file
	test: TestSuite


tests: TestSuite = {
	description = "File I/O",
	tests = [
		("write and read file", test_write_read),
		("read nonexistent file", test_read_nonexistent),
		("write_bytes and read_bytes round-trip", test_bytes_roundtrip),
		("write_bytes preserves raw bytes", test_bytes_raw),
		("read_bytes nonexistent returns Err", test_bytes_nonexistent),
		("read_file rejects embedded NUL path", test_read_file_rejects_nul_path),
		("write_file rejects embedded NUL path", test_write_file_rejects_nul_path),
		("write_file counted overwrite and truncation", test_counted_overwrites),
		("write_file missing parent has error content", test_missing_parent_error),
		("write_file NUL path cannot create prefix file", test_nul_path_preserves_prefix),
	]
}


func test_write_read() -> Bool:
	path: String = "/tmp/blorp_test_file.txt"
	content: String = "Hello, blorp!"

	-- Write file
	match write_file(path, content):
		Err(_):
			False
		Ok(_):
			-- Read it back
			match read_file(path):
				Ok(data):
					equals(data, content)
				Err(_):
					False


func test_read_nonexistent() -> Bool:
	match read_file("/tmp/this_file_does_not_exist_12345.txt"):
		Err(_):
			True
		Ok(_):
			False


func test_bytes_roundtrip() -> Bool:
	path: String = "/tmp/blorp_test_bytes_io.bin"
	src: Bytes = "hello binary".to_bytes()

	match write_bytes(path, src):
		Err(_):
			False
		Ok(_):
			result: Bool = match read_bytes(path):
				Ok(got):
					B.to_string(got) == "hello binary"
				Err(_):
					False

			_ = remove_file(path)
			result


func check_byte(b: Bytes, idx: Int, expected: Int) -> Bool:
	match B.get(b, idx):
		Some(v):
			v == expected
		None:
			False


func test_bytes_raw() -> Bool:
	path: String = "/tmp/blorp_test_bytes_raw.bin"
	var src: Bytes = B.bytes(4)
	src = B.set_index(src, 0, 0)
	src = B.set_index(src, 1, 255)
	src = B.set_index(src, 2, 128)
	src = B.set_index(src, 3, 1)
	_ = write_bytes(path, src)

	result: Bool = match read_bytes(path):
		Ok(got):
			(
				check_byte(got, 0, 0)
				and check_byte(got, 1, 255)
				and check_byte(got, 2, 128)
				and check_byte(got, 3, 1)
			)
		Err(_):
			False

	_ = remove_file(path)
	result


func test_bytes_nonexistent() -> Bool:
	match read_bytes("/tmp/blorp_no_such_binary_file_xyz.bin"):
		Err(_):
			True
		Ok(_):
			False


func test_read_file_rejects_nul_path() -> Bool:
	match read_file("/tmp/blorp_nul\0hidden"):
		Err(msg):
			msg.contains("embedded NUL")
		Ok(_):
			False


func test_write_file_rejects_nul_path() -> Bool:
	match write_file("/tmp/blorp_nul\0hidden", "data"):
		Err(msg):
			msg.contains("embedded NUL")
		Ok(_):
			False


private func scoped_output_case(check: (String) -> Bool) -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_output_contract_"):
		Ok(check(directory.resource_path()))


private func output_case(check: (String) -> Bool) -> Bool:
	match scoped_output_case(check):
		Ok(passed): passed
		Err(_): False


private func write_exact_bytes(path: String, content: String, expected: List[Int]) -> Bool:
	match write_file(path, content):
		Err(_): False
		Ok(_):
			match read_bytes(path):
				Err(_): False
				Ok(actual):
					var matches: Bool = B.length(actual) == expected.length()
					var index: Int = 0
					for value in expected:
						matches = matches and check_byte(actual, index, value)
						index += 1
					matches


func test_counted_overwrites() -> Bool:
	output_case(func(directory: String):
		path = directory + "/counted"
		(
			write_exact_bytes(
				path, "prefix-é\0\r\nsuffix",
				[112, 114, 101, 102, 105, 120, 45, 195, 169, 0, 13, 10, 115, 117, 102, 102, 105, 120],
			)
			and write_exact_bytes(path, "é\0\r\n", [195, 169, 0, 13, 10])
			and write_exact_bytes(path, "", [])
		)
	)


func test_missing_parent_error() -> Bool:
	output_case(func(directory: String):
		match write_file(directory + "/missing/output", "data"):
			Err(message):
				message.starts_with("write_file: open failed; errno=") and B.decode_utf8(message.to_bytes()).is_some()
			Ok(_): False
	)


func test_nul_path_preserves_prefix() -> Bool:
	output_case(func(directory: String):
		path = directory + "/prefix"
		match write_file(path + "\0suffix", "data"):
			Err(message):
				message == "write_file: string contains embedded NUL" and not file_exists(path)
			Ok(_): False
	)
