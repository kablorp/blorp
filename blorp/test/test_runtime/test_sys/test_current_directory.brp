import:
	fs: IOError, resource_path, temporary_directory
	process: run
	system: get_current_directory, getcwd, getenv, temp_dir
	test: TestSuite, run_suite_result


func test_current_directory_matches_host_directory() -> Bool:
	match get_current_directory():
		Ok(directory): directory == getcwd() and directory.starts_with("/")
		Err(_): False


func test_ignored_directory_results_release() -> Bool:
	var remaining = 100
	while remaining > 0:
		_ = get_current_directory()
		remaining -= 1
	True


private func escaped_directory() -> Option[String]:
	match get_current_directory():
		Ok(directory): Some(directory)
		Err(_): None


func test_directory_survives_result_scope() -> Bool:
	match escaped_directory():
		Some(directory): directory == getcwd()
		None: False


private func native_case(executable: String, name: String) -> Bool:
	match run("/usr/bin/env", ["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", executable, name]):
		Err(error):
			print_error(error)
			False
		Ok(result):
			passed = result.exit_code() == 0 and result.stdout() == "" and result.stderr() == ""
			if not passed:
				print_error("current directory " + name + ": " + result.exit_code().to_string() + " " + result.stderr())
			passed


private func native_checks(directory: String) -> Result[Bool, String]:
	executable = directory + "/current_directory"
	-- The included runtime uses wrapping integer semantics.
	compiled ?= run(getenv("BLORP_CC").get_or("clang"), [
		"-std=gnu11", "-O0", "-fwrapv", "-DBLORP_MEMORY_DIAGNOSTICS=1",
		"-fsanitize=address,undefined", "-fno-sanitize-recover=all", "-fno-omit-frame-pointer",
		"-I" + getcwd() + "/blorp/src/lib/runtime/native",
		"blorp/test/test_runtime/test_sys/fixtures/current_directory.c",
		"-lm", "-lpthread", "-o", executable,
	])
	if compiled.exit_code() != 0:
		Err("native current-directory build failed: " + compiled.stderr())
	else:
		suite: TestSuite = {
			description = "Native current-directory admission",
			tests = [
				("real OS success preserves the pathname", func(): native_case(executable, "real")),
				("ERANGE grows beyond the legacy buffer", func(): native_case(executable, "growth")),
				("growth then syscall failure releases staging", func(): native_case(executable, "growth_error")),
				("EINTR returns once with its numeric error", func(): native_case(executable, "eintr")),
				("cleanup cannot overwrite saved errno", func(): native_case(executable, "saved_errno")),
				("root and multibyte whitespace paths stay exact", func(): native_case(executable, "utf8")),
				("terminator excludes spare capacity", func(): native_case(executable, "after_terminator")),
				("malformed UTF-8 rejects before publication", func(): native_case(executable, "malformed")),
				("empty native success returns a shape error", func(): native_case(executable, "empty")),
				("relative native success returns a shape error", func(): native_case(executable, "relative")),
				("live Results own independent fresh paths", func(): native_case(executable, "fresh")),
				("Ok owns and releases its String once", func(): native_case(executable, "owned_ok")),
				("Err consumes its prefix and owns its String", func(): native_case(executable, "owned_error")),
			]
		}
		result = run_suite_result(suite)
		Ok(result[1] == 0)


private func scoped_native_checks() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_current_directory_"):
		match native_checks(directory.resource_path()):
			Ok(passed): Ok(passed)
			Err(error):
				print_error(error)
				Ok(False)


func test_native_current_directory() -> Bool:
	match scoped_native_checks():
		Ok(passed): passed
		Err(error):
			print_error(error.to_string())
			False


tests: TestSuite = {
	description = "Checked current directory",
	tests = [
		("current directory matches the current host directory", test_current_directory_matches_host_directory),
		("ignored Results release across repeated calls", test_ignored_directory_results_release),
		("matched directory survives its Result scope", test_directory_survives_result_scope),
		("native admission and ownership", test_native_current_directory),
	]
}
