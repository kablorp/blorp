-- The main thread's stack holds native recursion that a default 8 MB Linux
-- stack cannot: regression for the Linux arm64 gate crash, where parsing a
-- 1,000-deep nest needs about 7.5 MB and a batch of suites tipped it over.
import:
	test: TestSuite


-- At about 32 bytes per frame (unoptimized, arm64 and x64) this needs about
-- 9.6 MB; 8 MB overflows and the runtime's 16 MB main stack holds it with room
-- to spare for frames up to 50 bytes. The test relies on -O0, which the default
-- gates use: at -O1 and above the C compiler turns this recursion into a loop.
private NESTED_SUM_DEPTH: Int = 300000


pure func nested_sum(depth: Int) -> Int:
	if depth == 0:
		0
	else:
		1 + nested_sum(depth - 1)


func test_recursion_deeper_than_the_default_stack() -> Bool:
	nested_sum(NESTED_SUM_DEPTH) == NESTED_SUM_DEPTH


tests: TestSuite = {
	description = "Main thread stack",
	tests = [
		("recursion deeper than the default 8 MB stack", test_recursion_deeper_than_the_default_stack),
	]
}
