-- A fixed record stored inline crosses a foreign boundary in one struct box
-- with the managed layout (object header, then the fields): the argument box
-- is released after the call, and a returned object is copied out and
-- released. Run under the leak gate, this also checks that nothing leaks.
import:
	test: TestSuite


fixed record Point {
	x: Float,
	y: Float
}


foreign(include: "ffi_inline_record_header.h"):
	pure func point_swap(point: Point) -> Point = "ffi_inline_point_swap"
	@no_copy func point_swap_no_copy(point: Point) -> Point = "ffi_inline_point_swap"
	pure func point_sum(point: Point) -> Float = "ffi_inline_point_sum"


func test_pure_foreign_takes_and_returns_an_inline_record() -> Bool:
	swapped: Point = point_swap({x = 1.0, y = 2.0})
	swapped.x == 2.0 and swapped.y == 1.0


func test_no_copy_foreign_takes_and_returns_an_inline_record() -> Bool:
	start: Point = {x = 3.0, y = 5.0}
	swapped: Point = point_swap_no_copy(start)
	swapped.x == 5.0 and start.x == 3.0


func test_foreign_reads_an_inline_record_argument() -> Bool:
	point_sum({x = 1.5, y = 2.0}) == 3.5


tests: TestSuite = {
	description = "FFI inline fixed records",
	tests = [
		(
			"a pure foreign function takes and returns an inline record",
			test_pure_foreign_takes_and_returns_an_inline_record,
		),
		(
			"a no_copy foreign function takes and returns an inline record",
			test_no_copy_foreign_takes_and_returns_an_inline_record,
		),
		("a foreign function reads an inline record argument", test_foreign_reads_an_inline_record_argument),
	]
}
