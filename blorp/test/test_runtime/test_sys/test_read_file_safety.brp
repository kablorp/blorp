-- Tests for read_file/read_bytes safety on non-seekable and edge-case files.
import:
	fs: IOError, resource_path, temporary_directory
	process:
		ProcessCommand, ProcessExit(Exited), ProcessStream(NullStream), command, run, run_command
	system: getcwd, getenv, read_bytes, read_file, temp_dir, write_file
	test: TestSuite, run_suite_result
	units: milliseconds


FIFO_WRITER_TIMEOUT_MILLISECONDS: Int = 5000


private pure func fifo_writer_command(path: String) -> ProcessCommand:
	{ command(
		"sh",
		["-c", "trap 'exit 0' PIPE; printf 'hello\\n' > \"$1\" || true", "sh", path],
	) |
		stdout = NullStream,
		stderr = NullStream,
		timeout = Some(milliseconds(FIFO_WRITER_TIMEOUT_MILLISECONDS))
	}


private func delayed_fifo_write(path: String) -> Bool:
	sleep(100)

	match run_command(fifo_writer_command(path)):
		Ok(result):
			result.exit == Exited(0)
		Err(_):
			False


private func exercise_blocking_open_does_not_block_process_spawn() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_fopen_spawn_lock_"):
		path: String = directory.resource_path() + "/input"

		match run_command(command("mkfifo", [path])):
			Err(_):
				Ok(False)
			Ok(created):
				if created.exit != Exited(0):
					Ok(False)
				else:
					concurrent:
						reader = read_file(path)
						writer = delayed_fifo_write(path)

					match writer:
						Err(_):
							Ok(False)
						Ok(False):
							Ok(False)
						Ok(True):
							match reader:
								Err(_):
									Ok(False)
								Ok(read_result):
									match read_result:
										Err(_):
											Ok(True)
										Ok(_):
											Ok(False)


private func exercise_read_file_fifo() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_read_file_fifo_"):
		path: String = directory.resource_path() + "/input"

		match run_command(command("mkfifo", [path])):
			Err(_):
				Ok(False)
			Ok(created):
				if created.exit != Exited(0):
					Ok(False)
				else:
					concurrent:
						writer = run_command(fifo_writer_command(path))
						reader = read_file(path)

					match writer:
						Err(_):
							Ok(False)
						Ok(writer_result):
							match writer_result:
								Err(_):
									Ok(False)
								Ok(command_result):
									if command_result.exit != Exited(0):
										Ok(False)
									else:
										match reader:
											Err(_):
												Ok(False)
											Ok(read_result):
												match read_result:
													Err(_):
														Ok(True)
													Ok(_):
														Ok(False)


private func exercise_read_bytes_fifo() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_read_bytes_fifo_"):
		path: String = directory.resource_path() + "/input"

		match run_command(command("mkfifo", [path])):
			Err(_):
				Ok(False)
			Ok(created):
				if created.exit != Exited(0):
					Ok(False)
				else:
					concurrent:
						writer = run_command(fifo_writer_command(path))
						reader = read_bytes(path)

					match writer:
						Err(_):
							Ok(False)
						Ok(writer_result):
							match writer_result:
								Err(_):
									Ok(False)
								Ok(command_result):
									if command_result.exit != Exited(0):
										Ok(False)
									else:
										match reader:
											Err(_):
												Ok(False)
											Ok(read_result):
												match read_result:
													Err(_):
														Ok(True)
													Ok(_):
														Ok(False)


private func exercise_normal_file(content: String) -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_read_file_normal_"):
		path: String = directory.resource_path() + "/input"

		match write_file(path, content):
			Err(_):
				Ok(False)
			Ok(_):
				match read_file(path):
					Ok(actual):
						Ok(actual == content)
					Err(_):
						Ok(False)


func test_read_fifo_returns_err() -> Bool:
	match exercise_read_file_fifo():
		Ok(result):
			result
		Err(_):
			False


func test_blocking_open_does_not_block_process_spawn() -> Bool:
	match exercise_blocking_open_does_not_block_process_spawn():
		Ok(result):
			result
		Err(_):
			False


func test_read_bytes_fifo_returns_err() -> Bool:
	match exercise_read_bytes_fifo():
		Ok(result):
			result
		Err(_):
			False


func test_read_normal_file() -> Bool:
	match exercise_normal_file("test content"):
		Ok(result):
			result
		Err(_):
			False


func test_read_empty_file() -> Bool:
	match exercise_normal_file(""):
		Ok(result):
			result
		Err(_):
			False


private func native_admission_case(executable: String, directory: String, name: String) -> Bool:
	match run(
		"/usr/bin/env",
		["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", executable, name, directory + "/input"],
	):
		Err(error):
			print_error(error)
			False
		Ok(result):
			passed = result.exit_code() == 0 and result.stdout() == "" and result.stderr() == ""
			if not passed:
				print_error("file admission " + name + ": " + result.exit_code().to_string() + " " + result.stderr())
			passed


private func native_admission_checks(directory: String) -> Result[Bool, String]:
	executable = directory + "/read_file_admission"
	compiled ?= run(
		getenv("BLORP_CC").get_or("clang"),
		[
			"-std=gnu11", "-O0", "-DBLORP_MEMORY_DIAGNOSTICS=1",
			"-fsanitize=address,undefined", "-fno-sanitize-recover=all", "-fno-omit-frame-pointer",
			"-I" + getcwd() + "/blorp/src/lib/runtime/native",
			"blorp/test/test_runtime/test_sys/fixtures/read_file_admission.c",
			"-lm", "-lpthread", "-o", executable,
		],
	)
	if compiled.exit_code() != 0:
		Err("native file admission build failed: " + compiled.stderr())
	else:
		suite: TestSuite = {
			description = "Native read_file UTF-8 admission",
			tests = [
				("missing-file Err exactly captures platform ENOENT", func(): native_admission_case(executable, directory, "open_errno")),
				("malformed documentation is rejected before publication", func(): native_admission_case(executable, directory, "documentation")),
				("isolated continuations and forbidden leads reject", func(): native_admission_case(executable, directory, "forbidden")),
				("overlong encodings reject", func(): native_admission_case(executable, directory, "overlong")),
				("surrogate encodings reject", func(): native_admission_case(executable, directory, "surrogate")),
				("encodings above Unicode maximum reject", func(): native_admission_case(executable, directory, "above_max")),
				("truncated multibyte encodings reject", func(): native_admission_case(executable, directory, "truncated")),
				("bad continuation positions reject", func(): native_admission_case(executable, directory, "continuation")),
				("counted NUL cannot hide invalid suffix", func(): native_admission_case(executable, directory, "after_nul")),
				("empty contents keep the existing allocation budget", func(): native_admission_case(executable, directory, "empty")),
				("valid counted contents and allocations are exact", func(): native_admission_case(executable, directory, "contents")),
				("rejected contents free their unpublished staging object", func(): native_admission_case(executable, directory, "staging_free")),
				("rejected contents close their file exactly once", func(): native_admission_case(executable, directory, "closed")),
			]
		}
		result = run_suite_result(suite)
		Ok(result[1] == 0)


private func scoped_native_admission() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_read_file_admission_"):
		match native_admission_checks(directory.resource_path()):
			Ok(passed):
				Ok(passed)
			Err(error):
				print_error(error)
				Ok(False)


func test_native_file_admission() -> Bool:
	match scoped_native_admission():
		Ok(passed):
			passed
		Err(error):
			print_error(error.to_string())
			False


tests: TestSuite = {
	description = "Read File Safety",
	tests = [
		(
			"blocking open does not block process spawn",
			test_blocking_open_does_not_block_process_spawn,
		),
		("read_file FIFO safety", test_read_fifo_returns_err),
		("read_bytes FIFO safety", test_read_bytes_fifo_returns_err),
		("read normal file", test_read_normal_file),
		("read empty file", test_read_empty_file),
		("native UTF-8 admission and ownership", test_native_file_admission),
	]
}
