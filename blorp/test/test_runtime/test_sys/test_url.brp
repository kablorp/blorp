import:
	net/url: build_query, decode, effective_port, encode, is_https, parse, parse_query, to_string
	test: TestSuite


-- ============================================================================
-- Parsing Tests
-- ============================================================================
func test_parse_simple_https() -> Bool:
	match parse("https://example.com/path"):
		Ok(u):
			u.scheme == "https" and u.host == "example.com" and u.path == "/path"
		Err(_):
			False


func test_parse_with_port() -> Bool:
	match parse("http://localhost:8080/api"):
		Ok(u):
			u.host == "localhost" and u.path == "/api"
		Err(_):
			False


func test_parse_port_value() -> Bool:
	match parse("http://localhost:8080/"):
		Ok(u):
			match u.port:
				Some(p):
					p == 8080
				None:
					False
		Err(_):
			False


func test_parse_no_port() -> Bool:
	match parse("https://example.com/"):
		Ok(u):
			match u.port:
				None:
					True
				Some(_):
					False
		Err(_):
			False


func test_parse_query_string() -> Bool:
	match parse("https://example.com/search?q=hello&lang=en"):
		Ok(u):
			u.query == "q=hello&lang=en"
		Err(_):
			False


func test_parse_fragment() -> Bool:
	match parse("https://example.com/page#section"):
		Ok(u):
			u.fragment == "section"
		Err(_):
			False


func test_parse_query_and_fragment() -> Bool:
	match parse("https://example.com/search?q=test#results"):
		Ok(u):
			u.query == "q=test" and u.fragment == "results"
		Err(_):
			False


func test_parse_no_path() -> Bool:
	match parse("https://example.com"):
		Ok(u):
			u.path == "/"
		Err(_):
			False


func test_parse_missing_scheme() -> Bool:
	match parse("example.com/path"):
		Ok(_):
			False
		Err(_):
			True


func test_parse_root_path() -> Bool:
	match parse("http://localhost:3000/"):
		Ok(u):
			u.path == "/"
		Err(_):
			False


-- ============================================================================
-- Reconstruction Tests
-- ============================================================================
func test_to_string_simple() -> Bool:
	match parse("https://example.com/path"):
		Ok(u):
			u.to_string() == "https://example.com/path"
		Err(_):
			False


func test_to_string_with_port() -> Bool:
	match parse("http://localhost:8080/api"):
		Ok(u):
			u.to_string() == "http://localhost:8080/api"
		Err(_):
			False


func test_to_string_with_query() -> Bool:
	match parse("https://example.com/search?q=hello"):
		Ok(u):
			u.to_string() == "https://example.com/search?q=hello"
		Err(_):
			False


func test_to_string_with_fragment() -> Bool:
	match parse("https://example.com/page#top"):
		Ok(u):
			u.to_string() == "https://example.com/page#top"
		Err(_):
			False


-- ============================================================================
-- Encoding Tests
-- ============================================================================
func test_encode_spaces() -> Bool:
	encode("hello world") == "hello%20world"


func test_encode_special_chars() -> Bool:
	encode("a&b=c") == "a%26b%3Dc"


func test_decode_percent() -> Bool:
	decode("hello%20world") == "hello world"


func test_decode_plus() -> Bool:
	decode("a+b") == "a b"


func test_encode_decode_roundtrip() -> Bool:
	original: String = "hello world & friends"
	decode(encode(original)) == original


-- ============================================================================
-- Query String Tests
-- ============================================================================
func test_parse_query_pairs() -> Bool:
	pairs: List[(String, String)] = parse_query("foo=bar&baz=qux")
	pairs.length() == 2


func test_parse_query_empty() -> Bool:
	pairs: List[(String, String)] = parse_query("")
	pairs.length() == 0


func test_build_query_simple() -> Bool:
	build_query([("foo", "bar"), ("baz", "qux")]) == "foo=bar&baz=qux"


func test_build_query_encoded() -> Bool:
	build_query([("q", "hello world")]) == "q=hello%20world"


-- ============================================================================
-- Utility Tests
-- ============================================================================
func test_effective_port_https() -> Bool:
	match parse("https://example.com/"):
		Ok(u):
			effective_port(u) == 443
		Err(_):
			False


func test_effective_port_http() -> Bool:
	match parse("http://example.com/"):
		Ok(u):
			effective_port(u) == 80
		Err(_):
			False


func test_effective_port_explicit() -> Bool:
	match parse("http://example.com:3000/"):
		Ok(u):
			effective_port(u) == 3000
		Err(_):
			False


func test_is_https_true() -> Bool:
	match parse("https://example.com/"):
		Ok(u):
			is_https(u) == True
		Err(_):
			False


func test_is_https_false() -> Bool:
	match parse("http://example.com/"):
		Ok(u):
			is_https(u) == False
		Err(_):
			False


-- ============================================================================
-- Test Suite
-- ============================================================================
tests: TestSuite = {
	description = "URL Parser",
	tests = [
		("parse simple https", test_parse_simple_https),
		("parse with port", test_parse_with_port),
		("parse port value", test_parse_port_value),
		("parse no port", test_parse_no_port),
		("parse query string", test_parse_query_string),
		("parse fragment", test_parse_fragment),
		("parse query and fragment", test_parse_query_and_fragment),
		("parse no path", test_parse_no_path),
		("parse missing scheme", test_parse_missing_scheme),
		("parse root path", test_parse_root_path),
		("to_string simple", test_to_string_simple),
		("to_string with port", test_to_string_with_port),
		("to_string with query", test_to_string_with_query),
		("to_string with fragment", test_to_string_with_fragment),
		("encode spaces", test_encode_spaces),
		("encode special chars", test_encode_special_chars),
		("decode percent", test_decode_percent),
		("decode plus", test_decode_plus),
		("encode/decode roundtrip", test_encode_decode_roundtrip),
		("parse query pairs", test_parse_query_pairs),
		("parse query empty", test_parse_query_empty),
		("build query simple", test_build_query_simple),
		("build query encoded", test_build_query_encoded),
		("effective port https", test_effective_port_https),
		("effective port http", test_effective_port_http),
		("effective port explicit", test_effective_port_explicit),
		("is_https true", test_is_https_true),
		("is_https false", test_is_https_false),
	]
}
