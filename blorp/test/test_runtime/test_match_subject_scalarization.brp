import:
	test: TestSuite


pure func sum_two_options(values: List[Int]) -> Int:
	match (values.get(0), values.get(1)):
		(Some(first), Some(second)):
			first + second
		_:
			0


pure func join_two_strings(values: List[String]) -> String:
	match (values.get(0), values.get(1)):
		(Some(first), Some(second)):
			first + second
		_:
			"missing"


pure func classify_option_pair(values: List[Int]) -> Int:
	match (values.get(0), values.get(1)):
		(Some(first), Some(second)):
			first + second
		(Some(_), _):
			100
		_:
			200


pure func test_distinct_option_payloads() -> Bool:
	sum_two_options([2, 7]) == 9


pure func test_second_option_missing() -> Bool:
	sum_two_options([2]) == 0


pure func test_distinct_managed_payloads() -> Bool:
	join_two_strings(["left", "right"]) == "leftright"


pure func test_constructor_fallback_priority() -> Bool:
	(
		classify_option_pair([2, 7]) == 9
		and classify_option_pair([2]) == 100
		and classify_option_pair([]) == 200
	)


tests: TestSuite = {
	description = "Match subject scalarization",
	tests = [
		("distinct Option payloads", test_distinct_option_payloads),
		("second Option missing", test_second_option_missing),
		("distinct managed payloads", test_distinct_managed_payloads),
		("constructor fallback priority", test_constructor_fallback_priority),
	]
}
