-- Allocation oracle fixture: xs.map(...) is expected to allocate (a fresh
-- result list, at minimum), so this fixture asserts the OPPOSITE of the
-- other two fixtures: it fails if no heap activity is observed, and
-- reports which counters actually moved. Run with BLORP_MEMORY_STATS=1
-- (see test_alloc_oracle_blorp_level.sh).
import:
	memory:
		MemoryCounter(
			ManagedAllocations, BackingMallocEvents, RawMallocEvents, RawCallocEvents,
			RawReallocEvents, OracleStatsActive, MemoryStatsActive,
		),
		read_memory_counter,


pure func sum_list(nums: List[Int]) -> Int:
	var total: Int = 0

	for n in nums:
		total += n

	total


func main(args: List[String]):
	nums: List[Int] = [1, 2, 3, 4, 5]

	before_allocations = read_memory_counter(ManagedAllocations)
	before_backing = read_memory_counter(BackingMallocEvents)
	before_malloc = read_memory_counter(RawMallocEvents)
	before_calloc = read_memory_counter(RawCallocEvents)
	before_realloc = read_memory_counter(RawReallocEvents)
	before_oracle = read_memory_counter(OracleStatsActive)
	before_memory = read_memory_counter(MemoryStatsActive)
	doubled: List[Int] = nums.map(pure func(n: Int) -> Int: n * 2)
	after_allocations = read_memory_counter(ManagedAllocations)
	after_backing = read_memory_counter(BackingMallocEvents)
	after_malloc = read_memory_counter(RawMallocEvents)
	after_calloc = read_memory_counter(RawCallocEvents)
	after_realloc = read_memory_counter(RawReallocEvents)
	after_oracle = read_memory_counter(OracleStatsActive)
	after_memory = read_memory_counter(MemoryStatsActive)
	allocation_delta = after_allocations - before_allocations

	sum_ok: Bool = doubled.length() == 5 and sum_list(doubled) == 30
	managed_moved: Bool = allocation_delta > 0
	raw_moved: Bool = (
		after_malloc > before_malloc
		or after_calloc > before_calloc
		or after_realloc > before_realloc
		or after_backing > before_backing
	)

	if before_memory != 1 or after_memory != 1:
		print("FAIL: memory stats inactive: run with BLORP_MEMORY_STATS=1")
	else if before_oracle != 1 or after_oracle != 1:
		print("FAIL: allocation oracle inactive: run with BLORP_MEMORY_STATS=1")
	else:
		if sum_ok and managed_moved:
			print(
				"PASS managed_allocations=" + allocation_delta.to_string() + " raw_or_backing_moved=" + raw_moved.to_string(),
			)
		else:
			print(
				"FAIL: sum_ok=" + sum_ok.to_string() + " managed_allocations_delta=" + allocation_delta.to_string(),
			)
