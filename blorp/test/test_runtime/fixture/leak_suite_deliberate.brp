-- Deliberately leaks one runtime-managed allocation inside a TestSuite so
-- suite-level leak-check diagnostics can be tested.
import:
	test: TestSuite


foreign:
	func alloc_raw(size: Int) -> Ptr = "blorp_alloc"


func test_leaks_raw_allocation() -> Bool:
	_ = alloc_raw(64)
	True


tests: TestSuite = {
	description = "Deliberate Suite Leak",
	tests = [("raw allocation leak", test_leaks_raw_allocation)]
}
