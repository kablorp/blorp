import:
	test: TestSuite
	units: microseconds, milliseconds


func test_concurrent_block_duration_timeout() -> Bool:
	concurrent(timeout: milliseconds(100)):
		a = 21 * 2

	match a:
		Ok(v):
			v == 42
		Err(_):
			False


func test_concurrent_loop_duration_timeout() -> Bool:
	nums: List[Int] = [1, 2, 3]
	out: Channel[Int] = channel(3)

	for n in nums concurrently(limit: 2, timeout: milliseconds(100)):
		_ = send(out, n * 2)

	seal(out)
	var count: Int = 0
	var total: Int = 0

	for value in out:
		count += 1
		total += value

	count == 3 and total == 12


func test_concurrent_block_accepts_microsecond_duration_timeout() -> Bool:
	concurrent(timeout: microseconds(100000)):
		a = 1

	match a:
		Ok(v):
			v == 1
		Err(_):
			False


tests: TestSuite = {
	description = "Duration timeout syntax",
	tests = [
		("concurrent block accepts Duration timeout", test_concurrent_block_duration_timeout),
		("concurrent loop accepts Duration timeout", test_concurrent_loop_duration_timeout),
		(
			"concurrent block accepts microsecond Duration timeout",
			test_concurrent_block_accepts_microsecond_duration_timeout,
		),
	]
}
