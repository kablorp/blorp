-- Real-main streaming cases use independent prepared byte oracles. The normal
-- harness owns compilation, sanitizers, exact results and strict accounting.
import:
    int: Int methods
    list: List methods
    ../driver/file_access: write_file
    ../driver/harness:
        CompileCeiling,
        NativeRun,
        Program,
        fixture_program,
        isolated,
        once_given,
        preparation,
        reported,
        run_expecting,
        strict_leak_check,
        strict_native_binary,
        verify_program,
        with_arguments,
    ../driver/reports: report_memory, within_ceiling


private PREPARE: String = "blorp/test/test_compile/fixtures/files/prepare_streaming.sh"

private COMPARE_BYTES: String = "/usr/bin/cmp"

private COMPARISON_TIMEOUT_MS: Int = 10000

private DESCRIPTOR_LIMIT: Int = 64

-- Two 64 KiB chunks accommodate one native chunk and scope bookkeeping, while
-- excluding storage that grows with the 16 MiB input. Prototype peak is ~66 KiB.
private COPY_PEAK_HEAP_CEILING: Int = 131072


-- Measured with the qualified S2 seed and the actual library; compilation
-- ceilings are observations +15%. Raw samples: s3-integration/measurements.json
-- under the ignored streaming-io-2026-11-13 evidence directory.
private COPY_CEILING: CompileCeiling = { allocations = 249104, instructions = 808708695 }
private TRANSFORM_CEILING: CompileCeiling = { allocations = 273504, instructions = 858860134 }
private COMPARE_CEILING: CompileCeiling = { allocations = 245091, instructions = 778019271 }
private EARLY_CEILING: CompileCeiling = { allocations = 259963, instructions = 817067419 }
private ALIASES_CEILING: CompileCeiling = { allocations = 255068, instructions = 811824857 }
private FOLD_CEILING: CompileCeiling = { allocations = 255187, instructions = 808135088 }


private COPY_COUNTS: List[(Int, Int)] = [(0, 12), (1, 13), (65536, 13), (65537, 14), (327681, 18)]


private EQUAL_COUNTS: List[(Int, Int)] = [
    (0, 14),
    (1, 22),
    (65536, 29371),
    (65537, 29379),
    (327681, 146807),
]


private UNEQUAL_COUNTS: List[(Int, Int, Int)] = [
    (0, 1, 13),
    (1, 0, 13),
    (65536, 65537, 29370),
    (65537, 65536, 29370),
]


private func same_bytes(expected: String, actual: String) -> Result[Void, String]:
    invocation ?= isolated(COMPARE_BYTES, [expected, actual], COMPARISON_TIMEOUT_MS)
    compared ?= run_expecting("complete byte comparison", invocation, 0)
    Ok(void)


private func verify_files(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
    tree: String,
    program: Program,
    comparisons: List[(String, String)],
) -> Result[Void, String]:
    prepare ?= preparation(PREPARE, tree)
    prepared ?= run_expecting(PREPARE, prepare, 0)
    checked ?= verify_program(compiler, c_compiler, work_directory, check_instructions, program)
    var outcome: Result[Void, String] = Ok(void)
    for (expected, actual) in comparisons:
        match outcome:
            Err(_): break
            Ok(_): outcome = same_bytes(tree + "/" + expected, tree + "/" + actual)
    outcome


-- The measured child performs only copying. Parent verification runs later.
-- The raw strict report retains its peak line; report_memory checks the
-- whole balanced report before any evidence is accepted. No NativeRun model change.
private func record_copy_peak(work_directory: String, tree: String) -> Result[Void, String]:
    invocation ?= isolated(
        strict_native_binary(work_directory + "/streaming_copy"),
        [tree + "/large.bin", tree + "/large-copy.bin"],
        COMPARISON_TIMEOUT_MS,
    )
    copied ?= run_expecting(
        "streaming copy peak",
        { invocation | environment = strict_leak_check() },
        0,
    )
    memory ?= report_memory(copied.stderr)
    bounded ?= within_ceiling("streaming copy peak heap", memory.peak_heap, COPY_PEAK_HEAP_CEILING)
    stored ?= write_file(work_directory + "/streaming-copy-peak.stderr", copied.stderr)
    if copied.stdout == "":
        same_bytes(tree + "/large.bin", tree + "/large-copy.bin")
    else:
        Err("streaming copy peak: unexpected stdout")


func tests(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
) -> List[(String, () -> Bool)]:
    tree = work_directory + "/streaming_tree"
    verify = func(program: Program, comparisons: List[(String, String)]) -> Result[Void, String]:
        verify_files(
            compiler,
            c_compiler,
            work_directory,
            check_instructions,
            tree,
            program,
            comparisons,
        )
    var copy_runs: List[NativeRun] = []
    var copied_files: List[(String, String)] = []
    for (size, allocations) in COPY_COUNTS:
        source = "input-${size}.bin"
        target = "copy-${size}.bin"
        copy_runs = copy_runs.append(
            with_arguments(
                size.to_string(),
                [tree + "/" + source, tree + "/" + target],
                0,
                "",
                allocations,
            ),
        )
        copied_files = copied_files.append((source, target))
    copy_runs = copy_runs.concat(
        once_given([tree + "/large.bin", tree + "/large-copy.bin"], 0, "", 268),
    )
    copy = fixture_program("streaming_copy", "files/streaming/copy", COPY_CEILING, copy_runs)
    var comparisons: List[NativeRun] = []
    for (size, allocations) in EQUAL_COUNTS:
        comparisons = comparisons.append(
            with_arguments(
                "equal ${size}",
                [tree + "/input-${size}.bin", tree + "/equal-${size}.bin"],
                0,
                "",
                allocations,
            ),
        )
    for (left, right, allocations) in UNEQUAL_COUNTS:
        comparisons = comparisons.append(
            with_arguments(
                "length ${left}/${right}",
                [tree + "/input-${left}.bin", tree + "/input-${right}.bin"],
                3,
                "",
                allocations,
            ),
        )
    comparisons = comparisons.concat(
        once_given([tree + "/input-327681.bin", tree + "/late-mismatch.bin"], 3, "", 146781),
    )
    compare = fixture_program(
        "streaming_compare",
        "files/streaming/compare",
        COMPARE_CEILING,
        comparisons,
    )
    copy_comparisons = copied_files
    early: NativeRun = {
        label = None,
        arguments = [tree + "/large.bin", tree + "/early-target.bin", tree + "/input-1.bin"],
        directory = None,
        descriptor_limit = Some(DESCRIPTOR_LIMIT),
        status = 0,
        stdout = "",
        stderr = "",
        allocations = 1545,
    }
    [
        (
            "streaming binary copy preserves every byte with bounded child storage",
            func() -> Bool: reported(
                verify_copy(verify, copy, copy_comparisons, work_directory, tree),
            ),
        ),
        (
            "streaming UInt8 transform and generated output match independent binary oracles",
            func() -> Bool: reported(
                verify(
                    fixture_program(
                        "streaming_transform",
                        "files/streaming/transform",
                        TRANSFORM_CEILING,
                        once_given(
                            [
                                tree + "/input-327681.bin",
                                tree + "/transformed.bin",
                                tree + "/generated.bin",
                            ],
                            0,
                            "",
                            14538,
                        ),
                    ),
                    [
                        ("transformed.expected", "transformed.bin"),
                        ("generated.expected", "generated.bin"),
                    ],
                ),
            ),
        ),
        (
            "two reader windows compare equal, late-mismatching and unequal-length inputs",
            func() -> Bool: reported(verify(compare, [])),
        ),
        (
            "owned bytes outlive the reader and early reader/writer scopes release under a low descriptor limit",
            func() -> Bool: reported(
                verify(
                    fixture_program("streaming_early", "files/streaming/early", EARLY_CEILING, [
                        early,
                    ]),
                    [("early.expected", "early-target.bin")],
                ),
            ),
        ),
        (
            "user scoped aliases forward and capture an outer reader inside a writer callback",
            func() -> Bool: reported(
                verify(
                    fixture_program(
                        "streaming_aliases",
                        "files/streaming/aliases",
                        ALIASES_CEILING,
                        once_given(
                            [tree + "/input-327681.bin", tree + "/aliases.bin"],
                            0,
                            "before\nbody\nafter\n",
                            23,
                        ),
                    ),
                    [("input-327681.bin", "aliases.bin")],
                ),
            ),
        ),
        (
            "scoped fold_lines steps capture a writer, normalize lines and discard on application error",
            func() -> Bool: reported(
                verify(
                    fixture_program(
                        "streaming_fold",
                        "files/streaming/fold_writer",
                        FOLD_CEILING,
                        once_given(
                            [
                                tree + "/lines.txt",
                                tree + "/lines-output.txt",
                                tree + "/fold-failure.bin",
                            ],
                            0,
                            "step 1\nstep 2\nstep 3\nsuccess 3\nstep 1\nstep 2\nstopped\n",
                            59,
                        ),
                    ),
                    [
                        ("lines.expected", "lines-output.txt"),
                        ("fold-failure.expected", "fold-failure.bin"),
                    ],
                ),
            ),
        ),
    ]


private func verify_copy(
    verify: (Program, List[(String, String)]) -> Result[Void, String],
    program: Program,
    comparisons: List[(String, String)],
    work_directory: String,
    tree: String,
) -> Result[Void, String]:
    checked ?= verify(program, comparisons)
    record_copy_peak(work_directory, tree)
