-- Native cases and rejections for the language surface: generics, Lists, owned
-- prefixes and parameters, local modules, bindings, UFCS, syntax, namespaces,
-- traits and stored callables. Each program compiles once within its ceiling,
-- then runs once per case with exact status, stdout and stderr and strict
-- allocation counts. Rejections check the exact diagnostic; where the rejected
-- program had to publish nothing, also that no C is created or overwritten.
import:
    int: Int methods
    io/environment: get_current_directory
    list: List methods
    result: Result methods
    string: String methods
    test: TestSuite
    ../driver/file_access: write_file, make_directories
    ../driver/harness:
        CompileCeiling,
        CompileInput(SingleSource),
        FIXTURES,
        LIBRARY_ROOT,
        NativeRun,
        Program,
        Rejection,
        exits_with,
        fixture_program,
        once,
        once_given,
        prints,
        repeated,
        reported,
        verify_program,
        verify_rejection,
        verify_unpublished_against,
        verify_unpublished_expecting,
        verify_unpublished_rejection,
        with_arguments,


-- Every program's compile ceiling is its measured cost plus 15%, rounded up to
-- a whole count: allocations from the compiler's strict report, retired
-- instructions (the larger of the serial runs) from /usr/bin/time -l, both for
-- the -O0 compiler under test. The commit that changes a ceiling states the
-- measured cost in its message.


private RECEIVER_ONLY_HELP: String = "declare the function locally or import it by name; type selections enable receiver calls only"


private UNKNOWN_FUNCTION: String = "unknown function"
private UNKNOWN_OPAQUE_MESSAGE: String = "unknown opaque type"
private OPAQUE_CONVERSION_HELP: String = "import or declare an opaque type before converting it"
private PROPAGATION_BLOCK_MESSAGE: String = "`?=` cannot be used inside an `if` or `match` block"


private PROPAGATION_BLOCK_HELP: String = "match on the Result or Option in place, or move the block into its own function and use `?=` at its top"


private RENAME_HELP: String = "choose a different name for this binding"


-- The module that the cross-file field rejection imports: a record with an Int
-- field, which `main` fills with a String.
private FIELD_HELPER_SOURCE: String = "record Holder { number: Int }\npure func take(value: Holder) -> Int:\n    value.number\n"


private UINT8_VALUES_OUTPUT: String = "byte 200, next 201, wrapped 56, zero no\nmaybe Some(200), signature [ 137 80 ]\nlarger 200 200 smaller 3, count 5\nwrap 255 0 144 44\ndivide 28 4 0 0\nequal yes yes\norder yes yes yes no\nto_int 1200, hash 200\nto_uint8 Some(0) Some(255) None None\nparse Some(17) Some(255) None None None None Some(17) None Some(0) None\npixel 255 0\npatterns zero max other\nlist [ 1 2 250 ] length 3 second Some(2)\n"


private BYTES_OPERATIONS_OUTPUT: String = "length 4 empty no yes\nget Some(255) None None\nget_or 255 7\nto_list 4 72\nslice [ 20 30 ] [ 10 20 30 40 ]\nclamped [ 10 20 ] [ 30 40 ] [ ]\ninverted [ ] [ ]\nstarts yes no\nstarts edge yes yes no\njoined [ 1 2 3 ] left [ 1 2 ] equal yes no yes\nhash equal yes unequal pair no\ndict 2 30 20 -1\nto_bytes [ 72 195 169 0 ]\nto_text Some(Hé\0) None\nempty Some() 0\noverlong None\nsurrogate None\nabove U+10FFFF None\nlone continuation None\ntruncated None\nfour bytes Some(😀)\n"


private BYTES_FILES_OUTPUT: String = "write ok\nread 263 bytes, identical yes\nrewrite ok\nempty 0 bytes\nmissing no such file / no such file same yes\ndirectory is a directory / is a directory same yes\n"


-- The text a compiler error adds after the source path: location, message, help.
private pure func diagnostic(location: String, message: String, help: String) -> String:
    ":" + location + ": error: " + message + "\nhelp: " + help + "\n"


-- The note that names an earlier declaration, in a fixture under FIXTURES.
private pure func previous_note(fixture: String, location: String) -> String:
    FIXTURES + fixture + ".brp:" + location + ": note: previous declaration or import here\n"


-- A program compiled against its own library root, from a source that is not
-- under FIXTURES.
private pure func rooted_program(
    name: String,
    library_root: String,
    source: String,
    ceiling: CompileCeiling,
    runs: List[NativeRun],
) -> Program:
    {
        name = name,
        input = SingleSource(source),
        library_root = library_root,
        ceiling = ceiling,
        runs = runs,
    }


-- A function body with this many statement lines, then a line the checker
-- rejects. The base pilot (ba57e368a) exits 139 on it at the default stack
-- because the parser recursed once per statement; 2,000 lines still passed.
-- With the loop, parsing completes and the checker's exact diagnostic on
-- line 3 is reached before any later phase runs.
private LONG_BODY_STATEMENTS: Int = 3000


private pure func long_body_source() -> String:
    "func main() -> Int:\n" + repeated("\tx = 0\n", LONG_BODY_STATEMENTS) + "\t0\n"


-- Generated programs of CHAIN_MODULES modules. Under the strict leak check the
-- namespace scopes commit measured the direct chain at 248 M instructions and
-- 79,774 allocations and the flat program at 132 M and 27,515, where the
-- program-wide namespace before it measured 528 M and 375 M. The ceilings
-- keep rejecting that namespace; the two workloads have independent oracles.
private CHAIN_MODULES: Int = 64


-- main calls m1, each module calls the next and selects Box from the last one,
-- which declares it.
private pure func direct_chain_files() -> List[(String, String)]:
    last = CHAIN_MODULES.to_string()
    var files: List[(String, String)] = [
        (
            "main.brp",
            (
                "import:\n    ./m1: f1\n    ./m"
                + last
                + ": Box(Pack)\nfunc main() -> Int:\n    match f1():\n        Pack(value): value\n"
            ),
        ),
    ]
    for position in 1..CHAIN_MODULES:
        number = position.to_string()
        next = (position + 1).to_string()
        imports = if next.equals(last):
            "import:\n    ./m" + last + ": f" + last + ", Box(Pack)\n"
        else:
            "import:\n    ./m" + next + ": f" + next + "\n    ./m" + last + ": Box(Pack)\n"
        body = (
            "pure func f"
            + number
            + "() -> Box:\n    match f"
            + next
            + "():\n        Pack(value): Pack(value)\n"
        )
        files = files.append(("m" + number + ".brp", imports + body))
    files.append(
        (
            "m" + last + ".brp",
            "union Box:\n    Pack(Int)\npure func f" + last + "() -> Box:\n    Pack(0)\n",
        ),
    )


-- main selects one type from each module, each declaring its own.
private pure func flat_files() -> List[(String, String)]:
    var imports = "import:\n"
    var files: List[(String, String)] = []
    for position in 1..(CHAIN_MODULES + 1):
        number = position.to_string()
        imports = imports + "    ./m" + number + ": Type" + number + "\n"
        files = files.append(
            ("m" + number + ".brp", "union Type" + number + "[T]:\n    Make" + number + "(T)\n"),
        )
    files.append(("main.brp", imports + "func main() -> Int:\n    0\n"))


-- Writes each (file name, text) under `directory`, creating it first.
private func write_files(directory: String, files: List[(String, String)]) -> Result[Void, String]:
    _ ?= make_directories(directory)
    var outcome: Result[Void, String] = Ok(void)
    for file in files:
        match outcome:
            Ok(_): outcome = write_file(directory + "/" + file[0], file[1])
            Err(_): void
    outcome


-- A program of generated modules, written under its own directory of the work
-- directory before it compiles.
private func verify_generated(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
    name: String,
    files: List[(String, String)],
    ceiling: CompileCeiling,
    allocations: Int,
) -> Result[Void, String]:
    directory = work_directory + "/" + name + "_modules"
    _ ?= write_files(directory, files)
    verify_program(
        compiler,
        c_compiler,
        work_directory,
        check_instructions,
        rooted_program(
            name,
            LIBRARY_ROOT,
            directory + "/main.brp",
            ceiling,
            once(0, "", allocations),
        ),
    )


-- A rejection whose notes name absolute paths under the current directory.
private func with_current_directory(check: (String) -> Result[Void, String]) -> Bool:
    match get_current_directory():
        Ok(current): reported(check("${current}"))
        Err(error): reported(Err("${error}"))


-- The root keeps its command-line spelling; dependencies display their absolute
-- normalized paths, so the closing import is located in the absolute helper path.
private func verify_cycle(
    compiler: String,
    work_directory: String,
    name: String,
    current: String,
) -> Result[Void, String]:
    root = FIXTURES + "import/cycle/main.brp"
    helper = current + "/" + FIXTURES + "import/cycle/helper.brp"
    verify_unpublished_expecting(
        compiler,
        LIBRARY_ROOT,
        work_directory,
        name,
        root,
        (
            helper
            + ":2:5: error: import cycle: "
            + root
            + " -> "
            + helper
            + " -> "
            + root
            + "\nhelp: move the declarations both modules need into a third module that both import\n"
        ),
    )


-- A root module gives a helper's record a String field; the error is in the
-- root, and its note names the helper written beside it.
private func verify_cross_file_field(
    compiler: String,
    work_directory: String,
    name: String,
) -> Result[Void, String]:
    helper = work_directory + "/" + name + "_helper.brp"
    _ ?= write_file(helper, FIELD_HELPER_SOURCE)
    root = (
        "import:\n    ./"
        + name
        + "_helper: take\nfunc main() -> Int:\n    take({ number = 42.to_string() })\n"
    )
    verify_unpublished_rejection(
        compiler,
        work_directory,
        name,
        root,
        (
            diagnostic("4:21", "record field requires Int", "use an expression of type Int here")
            + helper
            + ":1:25: note: record field declared here\n"
        ),
    )


func suite(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
) -> TestSuite:
    run_program = func(program: Program) -> Bool: reported(
        verify_program(compiler, c_compiler, work_directory, check_instructions, program),
    )
    reject_fixture = func(name: String, fixture: String, expected: String) -> Bool: reported(
        verify_rejection(compiler, work_directory, {
            name = name,
            source = FIXTURES + fixture + ".brp",
            diagnostic = expected,
        }),
    )
    reject_unpublished = func(name: String, fixture: String, expected: String) -> Bool: reported(
        verify_unpublished_against(compiler, LIBRARY_ROOT, work_directory, {
            name = name,
            source = FIXTURES + fixture + ".brp",
            diagnostic = expected,
        }),
    )
    reject_in_root = func(
        name: String,
        library_root: String,
        source: String,
        expected: String,
    ) -> Bool: reported(
        verify_unpublished_against(compiler, library_root, work_directory, {
            name = name,
            source = source,
            diagnostic = expected,
        }),
    )
    reject_text = func(name: String, text: String, expected: String) -> Bool: reported(
        verify_unpublished_rejection(compiler, work_directory, name, text, expected),
    )
    reject_cycle = func(name: String) -> Bool: with_current_directory(
        func(current: String): verify_cycle(compiler, work_directory, name, current),
    )
    reject_cross_file_field = func(name: String) -> Bool: reported(
        verify_cross_file_field(compiler, work_directory, name),
    )
    run_generated = func(
        name: String,
        files: List[(String, String)],
        ceiling: CompileCeiling,
        allocations: Int,
    ) -> Bool: reported(
        verify_generated(
            compiler,
            c_compiler,
            work_directory,
            check_instructions,
            name,
            files,
            ceiling,
            allocations,
        ),
    )
    private_specialization_index: Rejection = {
        name = "private_specialization_index",
        source = "blorp/test/test_compile/fixtures/namespace/private_specialization_index.brp",
        diagnostic = ":2:59: error: IndexedList is private to ../../../../src/common/codegen/specialize/specialize\nhelp: remove private or import a public declaration\n",
    }
    {
        description = "Blorp language surface",
        tests = [
            -- generic declarations, callbacks and specialization
            -- generic/lambda/capture_managed is not run: a lambda that captures only a
            -- Void value (its `from_void`) makes the emitter write `struct blorp_r_N{}`,
            -- which -pedantic -Werror rejects. The case returns when the emitter is fixed.
            (
                "typed siblings contextualize nominal literals once in written order",
                func(): run_program(
                    prints(
                        "generics_contextual_nominal_siblings",
                        "generic/contextual/nominal_siblings",
                        { allocations = 130130, instructions = 521447665 },
                        "left\nright\n7\nreverse-left\nreverse-right\n7\nnested-left\nnested-right\n7\nchoice-left\nchoice-right\n7\nchoice-reverse-left\nchoice-reverse-right\n7\n",
                        15,
                    ),
                ),
            ),
            (
                "immutable scalar capture forwards its environment through a declared helper",
                func(): run_program(
                    exits_with(
                        "generics_lambda_capture_scalar",
                        "generic/lambda/capture_scalar",
                        { allocations = 122616, instructions = 486518765 },
                        42,
                        0,
                    ),
                ),
            ),
            (
                "managed noncapturing callbacks retain original and returned aliases",
                func(): run_program(
                    prints(
                        "generics_lambda_managed",
                        "generic/lambda/managed",
                        { allocations = 123435, instructions = 500521032 },
                        "é\0\né\0\né\0\n",
                        3,
                    ),
                ),
            ),
            (
                "noncapturing inline and annotated block callbacks use direct calls",
                func(): run_program(
                    exits_with(
                        "generics_lambda_noncapture",
                        "generic/lambda/noncapture",
                        { allocations = 125177, instructions = 485907097 },
                        42,
                        0,
                    ),
                ),
            ),
            (
                "local annotation checks a scalar initializer",
                func(): run_program(
                    exits_with(
                        "generics_annotations_identity",
                        "annotations/identity",
                        { allocations = 119608, instructions = 471205422 },
                        7,
                        0,
                    ),
                ),
            ),
            (
                "local annotation infers a generic List and preserves its old alias",
                func(): run_program(
                    exits_with(
                        "generics_annotations_contextual_list",
