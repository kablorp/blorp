-- Native cases for records, unions, tuples, opaque types (generic ones
-- included), declaration bounds, equality and the release of deep recursive
-- values: each program compiles once
-- within its ceiling, then runs once per case with exact status, stdout and
-- stderr and strict allocation counts. Rejections check the exact diagnostic;
-- those that must publish nothing also check that no C is created and an
-- existing output is left alone.
import:
    test: TestSuite
    ../driver/file_access: write_file
    ../driver/harness:
        CompileCeiling,
        CompileInput(SingleSource),
        FIXTURES,
        LIBRARY_ROOT,
        NativeRun,
        Program,
        Rejection,
        exits_with,
        fixture_program,
        once,
        prints,
        reported,
        verify_program,
        verify_rejection,
        verify_unpublished_against,
        verify_unpublished_rejection,
        with_arguments


-- Every program's compile ceiling is its measured cost plus 15%, rounded up to
-- a whole count: allocations from the compiler's strict report, retired
-- instructions (the larger of the serial runs) from /usr/bin/time -l, both for
-- the -O0 compiler under test. The commit that changes a ceiling states the
-- measured cost in its message.


private TRAIT_INPUTS: String = "blorp/test/test_compile/trait_inputs/"

-- A reduced library (the base types, Equatable and a few implementations, and
-- no Dict) that gives the derived-equality inputs a fixed base: their expected
-- diagnostics and costs do not move with the standard library.
private DERIVED_LIBRARY_ROOT: String = "blorp/test/test_compile/trait_inputs/derived/library"

private FIELD_NOTE: String = "record field declared here"
private GROWING_TYPE_MESSAGE: String = "recursive type grows its type arguments without bound"


private GROWING_TYPE_HELP: String = "refer to the type with its type parameters unchanged, permuted or replaced by concrete types, as in Link(T, Chain[T])"


private TRAIT_BOUND_ERROR: String = ": error: type does not satisfy the required trait bound\nhelp: add the required trait to this function's type parameter bounds, or provide an implementation for the concrete receiver\n"


private MEMBER_ERROR: String = ": error: automatic equality is unavailable for a field or payload\nhelp: provide the member's required trait implementation, or write an Equatable implementation for the containing type\n"


private FINITE_ERROR: String = ": error: cannot prove finite generic trait instantiation\nhelp: avoid recursively wrapping generic receivers through trait dispatch; this increment uses a conservative constructor-path proof\n"


-- `location` is line:column; `message` and `help` are the diagnostic's two lines.
private pure func fixture_rejection(
    name: String,
    fixture: String,
    location: String,
    message: String,
    help: String
) -> Rejection:
    {
        name = name,
        source = FIXTURES + fixture + ".brp",
        diagnostic = ":" + location + ": error: " + message + "\nhelp: " + help + "\n"
    }


-- `input` is a path under trait_inputs, without the extension; `diagnostic`
-- follows the source path.
private pure func trait_rejection(name: String, input: String, diagnostic: String) -> Rejection:
    { name = name, source = TRAIT_INPUTS + input + ".brp", diagnostic = diagnostic }


-- The note the compiler adds after an error, in the same file.
private pure func with_note(rejection: Rejection, location: String, note: String) -> Rejection:
    { rejection |
        diagnostic = (
            rejection.diagnostic
            + rejection.source
            + ":"
            + location
            + ": note: "
            + note
            + "\n"
        )
    }


private pure func private_rejection(
    name: String,
    fixture: String,
    location: String,
    owner: String
) -> Rejection:
    {
        name = name,
        source = FIXTURES + "private_type/" + fixture + ".brp",
        diagnostic = (
            ":"
            + location
            + ": error: Secret is private but appears in public declaration "
            + owner
            + "\nhelp: make Secret public, or make "
            + owner
            + " private\n"
        )
    }


-- A program built from a trait input, against the reduced derived-equality
-- library.
private pure func derived_program(
    name: String,
    input: String,
    ceiling: CompileCeiling,
    runs: List[NativeRun]
) -> Program:
    {
        name = name,
        input = SingleSource(TRAIT_INPUTS + input + ".brp"),
        library_root = DERIVED_LIBRARY_ROOT,
        ceiling = ceiling,
        runs = runs
    }


private RECORD_MISSING_FIELD_SOURCE: String = "record Pair { first: Int, second: Int }\npure func make_pair() -> Pair:\n\t{ second = 2 }\nfunc main() -> Int:\n\t0\n"


-- The error names the literal, and a note names the record field it omits.
private func verify_missing_field_diagnostic(
    compiler: String,
    work_directory: String
) -> Result[Void, String]:
    source = work_directory + "/record_missing_field.brp"
    _ ?= write_file(source, RECORD_MISSING_FIELD_SOURCE)
    missing: Rejection = {
        name = "record_missing_field",
        source = source,
        diagnostic = ":3:2: error: missing field in record literal\nhelp: provide every declared record field exactly once\n"
    }
    verify_unpublished_against(
        compiler,
        LIBRARY_ROOT,
        work_directory,
        with_note(missing, "1:15", FIELD_NOTE)
    )


-- Both constructors have ordinal zero. C's enum conversion rules cannot
-- establish the language's nominal type rule; the compiler must reject it.
private NOMINAL_MISMATCH_SOURCE: String = "union Left:\n\tSame\nunion Right:\n\tMatching\nfunc take(value: Right) -> Int:\n\t0\nfunc left() -> Left:\n\tSame\nfunc main() -> Int:\n\ttake(left())\n"


private NOMINAL_MISMATCH_DIAGNOSTIC: String = ":10:2: error: argument type does not match the parameter type\nhelp: use an expression of type Right here\n"


private pure func generic_opaque(name: String, diagnostic: String) -> Rejection:
    {
        name = "opaque_" + name,
        source = "blorp/test/test_compile/fixtures/opaque/generic/" + name + ".brp",
        diagnostic = diagnostic
    }


private RECURSIVE_OPAQUE: String = " error: recursive opaque representations are not supported yet\nhelp: wrap an independently recursive aggregate instead of referring back to the opaque type\n"


func suite(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool
) -> TestSuite:
    run_program = func(program: Program) -> Bool: reported(
        verify_program(compiler, c_compiler, work_directory, check_instructions, program)
    )
    reject = func(rejection: Rejection) -> Bool: reported(
        verify_rejection(compiler, work_directory, rejection)
    )
    reject_unpublished = func(rejection: Rejection) -> Bool: reported(
        verify_unpublished_against(compiler, LIBRARY_ROOT, work_directory, rejection)
    )
    reject_in_derived = func(rejection: Rejection) -> Bool: reported(
        verify_unpublished_against(compiler, DERIVED_LIBRARY_ROOT, work_directory, rejection)
    )
    phantom_mismatch = generic_opaque(
        "phantom_mismatch",
        ":23:5: error: argument type does not match the parameter type\nhelp: use an expression of type Id[User] here\n"
    )
    empty_needs_type = generic_opaque(
        "empty_needs_type",
        ":5:11: error: cannot infer type parameter V of opaque type Box\nhelp: give into_opaque an expected type, as in value: Box[...] = into_opaque Box(...), or give from_opaque an operand whose Box type is known\n"
    )
    field_access = generic_opaque(
        "field_access",
        ":10:9: error: field access requires a record value\nhelp: read a declared record field, or use parentheses for a UFCS function call\n"
    )
    method_access = generic_opaque(
        "method_access",
        (
            ":9:9: error: no method total for Box[Int] is in scope\nhelp: use a value of a declared receiver type, or import a function accepting this type\n"
            + "blorp/test/test_compile/fixtures/opaque/generic/method_access.brp:4:11: note: candidate declaration or import here\n"
        )
    )
    arity_missing = generic_opaque(
        "arity_missing",
        ":4:18: error: generic opaque type requires one type argument\nhelp: write a concrete or symbolic application, such as Box[Int] or Box[T]\n"
    )
    arity_count = generic_opaque(
        "arity_count",
        ":4:18: error: opaque type argument count does not match its declaration\nhelp: expected 1 type arguments, got 2; supply types in declaration order\n"
    )
    arity_nongeneric = generic_opaque(
        "arity_nongeneric",
        ":4:19: error: ordinary opaque type does not accept a type argument\nhelp: remove the type argument from this opaque type\n"
    )
    explicit_arguments = generic_opaque(
        "explicit_arguments",
        ":3:20: error: opaque conversions take no type arguments\nhelp: write into_opaque Name(value) or from_opaque Name(value); the value and the expected type supply the arguments\n"
    )
    foreign_wrap: Rejection = {
        name = "opaque_foreign",
        source = "blorp/test/test_compile/fixtures/opaque/generic/foreign/main.brp",
        diagnostic = ":6:33: error: opaque values can be constructed only in their declaring module\nhelp: call a public constructor from the declaring module\n"
    }
    cycle_growing = generic_opaque("cycle_growing", ":7:20:" + RECURSIVE_OPAQUE)
    cycle_record = generic_opaque("cycle_record", ":2:11:" + RECURSIVE_OPAQUE)
    cycle_list = generic_opaque("cycle_list", ":1:20:" + RECURSIVE_OPAQUE)
    cycle_phantom = generic_opaque("cycle_phantom", ":4:20:" + RECURSIVE_OPAQUE)
    cycle_callable = generic_opaque("cycle_callable", ":1:20:" + RECURSIVE_OPAQUE)
    growing_recursion = generic_opaque(
        "growing_recursion",
        ":7:16: error: recursive calls grow type arguments without bound\nhelp: pass recursive type arguments unchanged, permute them, or reset them to concrete types\n"
    )
    unrestated_bound: Rejection = {
        name = "unrestated_bound",
        source = "blorp/test/test_compile/fixtures/declaration_bounds/unrestated.brp",
        diagnostic = ":7:39: error: Keyed[K, V] requires K: Hashable\nhelp: add Hashable to K's bounds\n"
    }
    {
        description = "Blorp records, unions, tuples, opaque types and equality",
        tests = [
            (
                "missing field diagnostic note and output preservation",
                func(): reported(verify_missing_field_diagnostic(compiler, work_directory))
            ),
            (
                "self-recursive record declaration is admitted",
                func(): run_program(
                    exits_with(
                        "record_recursive_direct",
                        "record/recursive_direct",
                        { allocations = 119623, instructions = 452557472 },
                        0,
                        0
                    )
                )
            ),
            (
                "mutually recursive record declarations are admitted",
                func(): run_program(
                    exits_with(
                        "record_recursive_mutual",
                        "record/recursive_mutual",
                        { allocations = 119929, instructions = 453634750 },
                        0,
                        0
                    )
                )
            ),
            (
                "record recursion through an applied union is admitted",
                func(): run_program(
                    exits_with(
                        "record_recursive_union",
                        "record/recursive_union",
                        { allocations = 120242, instructions = 455140951 },
                        0,
                        0
                    )
                )
            ),
            (
                "pair returns its first field",
                func(): run_program(
                    exits_with(
                        "record_basic",
                        "record/basic",
                        { allocations = 120807, instructions = 456627891 },
                        7,
                        0
                    )
                )
            ),
            (
                "reordered second nominal record",
                func(): run_program(
                    exits_with(
                        "record_reordered",
                        "record/reordered",
                        { allocations = 120930, instructions = 457290619 },
                        9,
                        0
                    )
                )
            ),
            (
                "record alias survives reassignment",
                func(): run_program(
                    exits_with(
                        "record_aliases",
                        "record/aliases",
                        { allocations = 120724, instructions = 456259900 },
                        7,
                        0
                    )
                )
            ),
            (
                "whole record reassignment",
                func(): run_program(
                    exits_with(
                        "record_reassigned",
                        "record/reassigned",
                        { allocations = 120769, instructions = 456493738 },
                        42,
                        0
                    )
                )
            ),
            (
                "generic function with record and mixed postfix",
                func(): run_program(
                    exits_with(
                        "record_generic",
                        "record/generic",
                        { allocations = 121747, instructions = 459674087 },
                        1,
                        1
                    )
                )
            ),
            (
                "nested literals and concrete UFCS context",
                func(): run_program(
                    exits_with(
                        "record_context",
                        "record/context",
                        { allocations = 120696, instructions = 455941797 },
                        7,
                        0
                    )
                )
            ),
            (
                "flat 32 field record",
                func(): run_program(
                    exits_with(
                        "record_wide",
                        "record/wide",
                        { allocations = 124376, instructions = 474074792 },
                        31,
                        0
                    )
                )
            ),
            (
                "unused full width record fields",
                func(): run_program(
                    exits_with(
                        "record_extrema",
                        "record/extrema",
                        { allocations = 120352, instructions = 454990629 },
                        0,
                        0
                    )
                )
            ),
            (
                "managed mixed record returns an owned String projection",
                func(): run_program(
                    exits_with(
                        "record_mixed",
                        "record/mixed",
                        { allocations = 121568, instructions = 459155032 },
                        2,
                        1
                    )
                )
            ),
            (
                "mixed record fields preserve Int Float and String values",
                func(): run_program(
                    prints(
                        "record_mixed_fields",
                        "record/mixed_fields",
                        { allocations = 122750, instructions = 463311927 },
                        "7\n2.5\n42\n",
                        3
                    )
                )
            ),
            (
                "nested scalar records preserve numeric fields",
                func(): run_program(
                    prints(
                        "record_scalar_nested_field",
                        "record/scalar_nested_field",
                        { allocations = 123041, instructions = 462613692 },
                        "7\n2.5\n9\n",
                        3
                    )
                )
            ),
            (
                "two stored String occurrences have independent owners",
                func(): run_program(
                    exits_with(
                        "record_shared_string",
                        "record/shared_string",
                        { allocations = 121689, instructions = 459500123 },
                        4,
                        2
                    )
                )
            ),
            (
                "two stored record occurrences preserve both child values",
                func(): run_program(
                    exits_with(
                        "record_shared_record",
                        "record/shared_record",
                        { allocations = 122566, instructions = 462217353 },
                        4,
                        2
                    )
                )
            ),
            (
                "unused managed record follows normal root cleanup",
                func(): run_program(
                    exits_with(
                        "record_unused_managed",
                        "record/unused_managed",
                        { allocations = 120569, instructions = 455507390 },
                        0,
                        1
                    )
                )
            ),
            (
                "nested owned results outlive each temporary parent",
                func(): run_program(
                    exits_with(
                        "record_nested_escape",
                        "record/nested_escape",
                        { allocations = 122901, instructions = 463973069 },
                        2,
                        1
                    )
                )
            ),
            (
                "nested field projections outlive intermediate parents",
                func(): run_program(
                    exits_with(
                        "record_nested_projection",
                        "record/nested_projection",
                        { allocations = 121595, instructions = 459084817 },
                        2,
                        1
                    )
                )
            ),
            (
                "record alias retains old fields across whole reassignment",
                func(): run_program(
                    prints(
                        "record_managed_aliases",
                        "record/managed_aliases",
                        { allocations = 123912, instructions = 465732921 },
                        "42\n42\n7\n7\n",
                        4
                    )
                )
            ),
            (
                "borrowed record identity returns an independent owner",
                func(): run_program(
                    exits_with(
                        "record_identity_escape",
                        "record/identity_escape",
                        { allocations = 121254, instructions = 457652502 },
                        2,
                        1
                    )
                )
            ),
            (
                "managed self assignment preserves the existing value",
                func(): run_program(
                    exits_with(
                        "record_managed_self_assignment",
                        "record/managed_self_assignment",
                        { allocations = 120983, instructions = 458937326 },
                        2,
                        1
                    )
                )
            ),
            (
                "identity reassignment establishes its owner before replacement",
                func(): run_program(
                    prints(
                        "record_identity_reassignment",
                        "record/identity_reassignment",
                        { allocations = 123215, instructions = 465195681 },
                        "42\n42\n42\n7\n",
                        2
                    )
                )
            ),
            (
                "generic union carries an owning record through a borrowed match",
                func(): run_program(
                    exits_with(
                        "record_union_payload",
                        "record/union_payload",
                        { allocations = 123189, instructions = 466050949 },
                        2,
                        1
                    )
                )
            ),
            (
                "owning record payload survives union alias reassignment",
                func(): run_program(
                    exits_with(
                        "record_union_aliases",
                        "record/union_aliases",
                        { allocations = 124250, instructions = 470487057 },
                        2,
                        2
                    )
                )
            ),
            (
                "record projection acquires an owning inline union",
                func(): run_program(
                    exits_with(
                        "record_owning_union_field",
                        "record/owning_union_field",
                        { allocations = 123689, instructions = 467885216 },
                        2,
                        1
                    )
                )
            ),
            (
                "nested inline union field keeps its String alive",
                func(): run_program(
                    exits_with(
                        "record_nested_union_field",
                        "record/nested_union_field",
                        { allocations = 124232, instructions = 466993983 },
                        2,
                        1
                    )
                )
            ),
            (
                "record with unmanaged union handles both active variants",
                func(): run_program(
                    exits_with(
                        "record_unmanaged_union_field",
                        "record/unmanaged_union_field",
                        { allocations = 122700, instructions = 462014806 },
                        42,
                        0
                    )
                )
            ),
            (
                "phantom String and record arguments remain valid record fields",
                func(): run_program(
                    exits_with(
                        "record_phantom_union_fields",
                        "record/phantom_union_fields",
                        { allocations = 123025, instructions = 462615505 },
                        14,
                        0
                    )
                )
            ),
            (
                "Void field is read from its temporary record",
                func(): run_program(
                    exits_with(
                        "record_void_field",
                        "record/void_field",
                        { allocations = 120181, instructions = 456283027 },
                        0,
                        0
                    )
                )
            ),
            (
                "a record returned and taken apart at once is a value and allocates nothing",
                func(): run_program(
                    exits_with(
                        "record_returned_value",
                        "record/returned_value",
                        { allocations = 83785, instructions = 467173357 },
                        180,
                        1
                    )
                )
            ),
            (
                "a value record is copied, stored in a List and captured",
                func(): run_program(
                    fixture_program(
                        "record_value_copies",
                        "record/value_copies",
                        { allocations = 87751, instructions = 480103725 },
                        once(22, "one second 3\n", 8)
                    )
                )
            ),
            (
                "record initializers evaluate once in written field order",
                func(): run_program(
                    prints(
                        "record_field_order",
                        "record/field_order",
                        { allocations = 123437, instructions = 463619938 },
                        "3\nmiddle\n1\n1\n3\n",
                        6
                    )
                )
            ),
            (
                "record List field and owned lookup survive temporary parents",
                func(): run_program(
                    fixture_program(
                        "record_list_field",
                        "record/list_field",
                        { allocations = 126103, instructions = 472728787 },
                        [
                            with_arguments(
                                "record and lookup preserve argument bytes",
                                ["kept é🙂", "unused"],
                                0,
                                "3\nkept é🙂\n",
                                5
                            ),
                            with_arguments("empty argument remains present", [""], 0, "2\n\n", 4),
                            with_arguments(
                                "missing argument remains absent",
                                [],
                                1,
                                "1\nmissing\n",
                                4
                            )
                        ]
                    )
                )
            ),
            (
                "old alias retains its original text",
                func(): run_program(
                    prints(
                        "record_update_aliases",
                        "record/update/aliases",
                        { allocations = 123947, instructions = 465320137 },
                        "42\n7\n",
                        5
                    )
                )
            ),
            (
                "base and reverse replacements execute once in order",
                func(): run_program(
                    prints(
                        "record_update_order",
                        "record/update/order",
                        { allocations = 124882, instructions = 469424410 },
                        "base\ntext\nnumber\n7\n7\n",
                        9
                    )
                )
            ),
            (
                "List and mortal String outlive updated parents",
                func(): run_program(
                    prints(
                        "record_update_escaped_children",
                        "record/update/escaped_children",
                        { allocations = 127296, instructions = 476698705 },
                        "42\n2\n7\n",
                        12
                    )
                )
            ),
            (
                "managed replacements out of declaration order",
                func(): run_program(
                    prints(
                        "record_update_managed_reorder",
                        "record/update/managed_reorder",
                        { allocations = 127251, instructions = 476664917 },
                        "42\n7\n3\n1\n42\n2\n",
                        10
                    )
                )
            ),
            (
                "nested String List admission preserves owned argument",
                func(): run_program(
                    fixture_program(
                        "generic_record_nested_string_list",
                        "record/generic/admission/nested_string_list",
                        { allocations = 125597, instructions = 470998632 },
                        [
                            with_arguments(
                                "owned Unicode argument",
                                ["kept é🙂"],
                                0,
                                "kept é🙂\n",
                                3
                            ),
                            with_arguments("absent argument", [], 0, "missing\n", 3)
                        ]
                    )
                )
            ),
            (
                "Void stays valid through record and union arguments",
                func(): run_program(
                    exits_with(
                        "generic_record_void_argument",
                        "record/generic/admission/void_argument",
                        { allocations = 122055, instructions = 462679430 },
                        7,
                        0
                    )
                )
            ),
            (
                "unused numeric List annotation accepts",
                func(): run_program(
                    exits_with(
                        "generic_record_unused_list_int",
                        "record/generic/admission/unused_list_int",
                        { allocations = 120010, instructions = 454784014 },
                        0,
                        0
                    )
                )
            ),
            (
                "generic Int field returns its stored value",
                func(): run_program(
                    exits_with(
                        "generic_record_box_int",
                        "record/generic/box_int",
                        { allocations = 121168, instructions = 458330098 },
                        7,
                        0
                    )
                )
            ),
            (
                "generic String field escapes its temporary root",
                func(): run_program(
                    prints(
                        "generic_record_box_string",
                        "record/generic/box_string",
                        { allocations = 122593, instructions = 460153849 },
                        "42\n",
                        1
                    )
                )
            ),
            (
                "one reader declaration handles String then Int",
                func(): run_program(
                    prints(
                        "generic_record_same_reader_twice",
                        "record/generic/same_reader_twice",
                        { allocations = 123712, instructions = 464836669 },
                        "42\n7\n",
                        2
                    )
                )
            ),
            (
                "ordered type arguments preserve both Pair applications",
                func(): run_program(
                    prints(
                        "generic_record_swapped_pair",
                        "record/generic/swapped_pair",
                        { allocations = 126042, instructions = 473722877 },
                        "7\n42\n9\n3\n",
                        4
                    )
                )
            ),
            (
                "phantom applications preserve independent stored values",
                func(): run_program(
                    prints(
                        "generic_record_phantom_arguments",
                        "record/generic/phantom_arguments",
                        { allocations = 123569, instructions = 463852956 },
                        "7\n9\n",
                        2
                    )
                )
            ),
            (
                "String escapes two generic temporary parents",
                func(): run_program(
                    prints(
                        "generic_record_nested_managed_escape",
                        "record/generic/nested_managed_escape",
                        { allocations = 123536, instructions = 463010809 },
                        "42\n",
                        1
                    )
                )
            ),
            (
                "generic aliases and acquired child survive reassignment",
                func(): run_program(
                    prints(
                        "generic_record_managed_alias_reassignment",
                        "record/generic/managed_alias_reassignment",
                        { allocations = 123821, instructions = 465657723 },
                        "42\n42\n7\n",
                        2
                    )
                )
            ),
            (
                "generic record carries an existing owning union",
                func(): run_program(
                    prints(
                        "generic_record_union_field",
                        "record/generic/generic_union_field",
                        { allocations = 124288, instructions = 466842675 },
                        "42\n",
                        1
                    )
                )
