-- Native cases for `concurrent:` blocks of pure tasks: each program compiles
-- once within its ceiling, then runs on the thread pool with BLORP_THREADS
-- unset (one thread per processor), 1 and 4, with the same exact stdout,
-- status and strict allocation counts at each, which catch a task result
-- dropped or released twice on its way through the nested pairs. The
-- rejection checks the exact diagnostic.
--
-- Every program's compile ceiling is its measured cost plus 15%, rounded up to
-- a whole count: allocations from the compiler's strict report, retired
-- instructions (the larger of two serial runs) from /usr/bin/time -l, both for
-- the -O0 compiler under test.
import:
    test: TestSuite
    ../driver/harness:
        CompileCeiling,
        NativeRun,
        Program,
        Rejection,
        StrictReport(StoppedBeforeStart),
        fixture_program,
        reported,
        verify_program,
        verify_rejection,
        with_arguments


-- A program that prints `stdout`, after `allocations` balanced allocations,
-- at each thread count.
private pure func at_thread_counts(
    name: String,
    fixture: String,
    ceiling: CompileCeiling,
    stdout: String,
    allocations: Int
) -> Program:
    counts: List[(String, Option[String])] = [
        ("threads-unset", None),
        ("threads-1", Some("1")),
        ("threads-4", Some("4"))
    ]

    var runs: List[NativeRun] = []

    for (label, threads) in counts:
        runs = runs.append(
            { with_arguments(label, [], 0, stdout, allocations) |
                environment = { "BLORP_THREADS" => threads }
            }
        )

    fixture_program(name, fixture, ceiling, runs)


-- `program` also run with a BLORP_THREADS that is not a thread count, which
-- the runtime rejects before any of the program's code runs.
private pure func rejecting_bad_threads(program: Program) -> Program:
    bad_threads: NativeRun = {
        label = Some("threads-x"),
        arguments = [],
        directory = None,
        descriptor_limit = None,
        environment = { "BLORP_THREADS" => Some("x") },
        status = 1,
        stdout = "",
        stderr = "error: BLORP_THREADS must be a positive integer or unset\n",
        report = StoppedBeforeStart
    }

    { program | runs = program.runs.append(bad_threads) }


func suite(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool
) -> TestSuite:
    run_program = func(program: Program) -> Bool: reported(
        verify_program(compiler, c_compiler, work_directory, check_instructions, program)
    )

    impure_task: Rejection = {
        name = "concurrency_impure_task",
        source = "blorp/test/test_compile/fixtures/concurrency/impure_task.brp",
        diagnostic = ":8:13: error: `print` is impure, and concurrent tasks must be pure until the concurrency runtime lands\nhelp: call it before or after the concurrent block\n"
    }

    {
        description = "Blorp concurrent blocks",
        tests = [
            (
                "two tasks run and their bindings are read after the block, and a bad BLORP_THREADS stops it before it prints",
                func(): run_program(
                    at_thread_counts(
                        "concurrency_summary",
                        "concurrency/summary",
                        { allocations = 74876, instructions = 514289977 },
                        "14 52\n",
                        4
                    ).rejecting_bad_threads()
                )
            ),
            (
                "four tasks of different types move their owned results through the pairs",
                func(): run_program(
                    at_thread_counts(
                        "concurrency_four_tasks",
                        "concurrency/four_tasks",
                        { allocations = 81426, instructions = 536781393 },
                        "3 count 3 3\n",
                        10
                    )
                )
            ),
            (
                "tasks share one captured List, and one appends to its own copy",
                func(): run_program(
                    at_thread_counts(
                        "concurrency_shared_capture",
                        "concurrency/shared_capture",
                        { allocations = 74356, instructions = 510239995 },
                        "4 3 3\n",
                        8
                    )
                )
            ),
            (
                "a tuple task and a variant task destructure their results, and a nested block's names follow the outer block",
                func(): run_program(
                    at_thread_counts(
                        "concurrency_tuple_task",
                        "concurrency/tuple_task",
                        { allocations = 81653, instructions = 537903545 },
                        "-2 7 8 6 x\n",
                        10
                    )
                )
            ),
            (
                "a pure function recurses through its own block",
                func(): run_program(
                    at_thread_counts(
                        "concurrency_recursion",
                        "concurrency/recursion",
                        { allocations = 76489, instructions = 523014777 },
                        "100\n",
                        1
                    )
                )
            ),
            (
                "a recursive Fibonacci's two calls are its block's two tasks",
                func(): run_program(
                    at_thread_counts(
                        "concurrency_fibonacci",
                        "concurrency/fibonacci",
                        { allocations = 72125, instructions = 504583744 },
                        "46368\n",
                        1
                    )
                )
            ),
            (
                "loop tasks return nothing, and a job of two that capture nothing has no slot",
                func(): run_program(
                    at_thread_counts(
                        "concurrency_void_tasks",
                        "concurrency/void_tasks",
                        { allocations = 76694, instructions = 520401548 },
                        "45 3\n",
                        6
                    )
                )
            ),
            (
                "an impure task is rejected",
                func(): reported(verify_rejection(compiler, work_directory, impure_task))
            )
        ]
    }
