-- Native cases for `concurrent:` blocks of pure tasks: each program compiles
-- once within its ceiling, then runs with exact stdout, status and strict
-- allocation counts, which catch a task result dropped or released twice on
-- its way through the nested pairs. The rejection checks the exact diagnostic.
--
-- Every program's compile ceiling is its measured cost plus 15%, rounded up to
-- a whole count: allocations from the compiler's strict report, retired
-- instructions (the larger of two serial runs) from /usr/bin/time -l, both for
-- the -O0 compiler under test.
import:
    test: TestSuite
    ../driver/harness: Program, Rejection, prints, reported, verify_program, verify_rejection


func suite(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool
) -> TestSuite:
    run_program = func(program: Program) -> Bool: reported(
        verify_program(compiler, c_compiler, work_directory, check_instructions, program)
    )

    impure_task: Rejection = {
        name = "concurrency_impure_task",
        source = "blorp/test/test_compile/fixtures/concurrency/impure_task.brp",
        diagnostic = ":8:13: error: `print` is impure, and concurrent tasks must be pure until the concurrency runtime lands\nhelp: call it before or after the concurrent block\n"
    }

    {
        description = "Blorp concurrent blocks",
        tests = [
            (
                "two tasks run and their bindings are read after the block",
                func(): run_program(
                    prints(
                        "concurrency_summary",
                        "concurrency/summary",
                        { allocations = 74876, instructions = 514289977 },
                        "14 52\n",
                        4
                    )
                )
            ),
            (
                "four tasks of different types move their owned results through the pairs",
                func(): run_program(
                    prints(
                        "concurrency_four_tasks",
                        "concurrency/four_tasks",
                        { allocations = 81426, instructions = 536781393 },
                        "3 count 3 3\n",
                        10
                    )
                )
            ),
            (
                "tasks share one captured List, and one appends to its own copy",
                func(): run_program(
                    prints(
                        "concurrency_shared_capture",
                        "concurrency/shared_capture",
                        { allocations = 74356, instructions = 510239995 },
                        "4 3 3\n",
                        8
                    )
                )
            ),
            (
                "a tuple task and a variant task destructure their results, and a nested block's names follow the outer block",
                func(): run_program(
                    prints(
                        "concurrency_tuple_task",
                        "concurrency/tuple_task",
                        { allocations = 81653, instructions = 537903545 },
                        "-2 7 8 6 x\n",
                        10
                    )
                )
            ),
            (
                "a pure function recurses through its own block",
                func(): run_program(
                    prints(
                        "concurrency_recursion",
                        "concurrency/recursion",
                        { allocations = 76489, instructions = 523014777 },
                        "100\n",
                        1
                    )
                )
            ),
            (
                "an impure task is rejected",
                func(): reported(verify_rejection(compiler, work_directory, impure_task))
            )
        ]
    }
