import:
    io/console: print
    io/fs/entry: EntryError, EntryKind(File, Directory, Symlink, Other), entry_kind
    io/fs/read: ReadError, read_text
    list: get
    path: Path, join, to_path
    string: String methods


-- Every read and entry kind the example prints is checked against the tree
-- that prepare.sh builds in the directory given as the first argument. Each
-- failure is printed as "name: reason" with the entry's name in place of its
-- path, so the output is the same wherever the directory is, and the number of
-- an OtherOs error is never printed, because it differs between macOS and Linux.


-- ELOOP's number differs by platform, so only the variant is shown.
private pure func read_failure(name: String, error: ReadError) -> String:
    match error:
        ReadError.OtherOs(_): "OtherOs"
        _: "${name}: ${error}"


private pure func entry_failure(name: String, error: EntryError) -> String:
    match error:
        EntryError.OtherOs(_): "OtherOs"
        _: "${name}: ${error}"


private func show_read(directory: Path, name: String) -> Void:
    match name.to_path():
        Ok(child):
            match read_text(join(directory, child)):
                Ok(text): print("read_text ${name}: ok ${text.length()} bytes")
                Err(error): print("read_text ${name}: ${read_failure(name, error)}")
        Err(error):
            print("read_text ${name}: ${error}")


private pure func kind_name(kind: Option[EntryKind]) -> String:
    match kind:
        None: "absent"
        Some(File): "file"
        Some(Directory): "directory"
        Some(Symlink): "symlink"
        Some(Other): "other"


private func show_kind(directory: Path, name: String) -> Void:
    match name.to_path():
        Ok(child):
            match entry_kind(join(directory, child)):
                Ok(kind): print("entry_kind ${name}: ${kind_name(kind)}")
                Err(error): print("entry_kind ${name}: ${entry_failure(name, error)}")
        Err(error):
            print("entry_kind ${name}: ${error}")


-- What a caller that wants a default for a missing file writes: it matches
-- NotFound itself, and any other failure stays.
private func show_fallback(directory: Path, name: String) -> Void:
    match name.to_path():
        Ok(child):
            path = join(directory, child)
            result = read_text(path)
            match result:
                Err(ReadError.NotFound): print("fallback ${name}: ok 8 bytes")
                Ok(text): print("fallback ${name}: ok ${text.length()} bytes")
                Err(error): print("fallback ${name}: ${read_failure(name, error)}")
        Err(error):
            print("fallback ${name}: ${error}")


-- Every variant of ReadError has one row, whatever read_text can produce today.
private func show_row(error: ReadError) -> Void:
    print("settings.conf: ${error}")


func main(arguments: List[String]) -> Int:
    match get(arguments, 1):
        None:
            print("missing directory")
            2
        Some(text):
            match text.to_path():
                Err(error):
                    print("${text}: ${error}")
                    2
                Ok(directory):
                    show_read(directory, "settings.conf")
                    show_read(directory, "empty.txt")
                    show_read(directory, "link_to_file")
                    show_read(directory, "missing.txt")
                    show_read(directory, "locked.txt")
                    show_read(directory, "settings.conf/child")
                    show_read(directory, "folder")
                    show_read(directory, "not_utf8.bin")
                    show_read(directory, "loop")
                    show_read(directory, "dangling_link")
                    show_kind(directory, "settings.conf")
                    show_kind(directory, "locked.txt")
                    show_kind(directory, "folder")
                    show_kind(directory, "link_to_file")
                    show_kind(directory, "dangling_link")
                    show_kind(directory, "loop")
                    show_kind(directory, "pipe")
                    show_kind(directory, "missing.txt")
                    show_kind(directory, "settings.conf/child")
                    show_kind(directory, "loop/inside")
                    show_fallback(directory, "missing.txt")
                    show_fallback(directory, "settings.conf")
                    show_fallback(directory, "locked.txt")
                    show_fallback(directory, "folder")
                    show_row(ReadError.NotFound)
                    show_row(ReadError.PermissionDenied)
                    show_row(ReadError.NotADirectory)
                    show_row(ReadError.IsADirectory)
                    show_row(ReadError.FileTooLarge)
                    show_row(ReadError.InvalidUtf8)
                    show_row(ReadError.OtherOs(40))
                    0
