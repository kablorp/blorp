import:
    list: get


-- User declarations of raw filesystem handles must be rejected.
-- The library owns descriptors and applications use its scoped operations.
-- Keep this old direct declaration as the compatibility rejection witness.
-- Its label is the exact diagnostic span checked by the e2e harness.
func open_native(path: String) -> Result[Int, Int]:
    builtin("fs.open_read")


func main(arguments: List[String]) -> Int:
    match arguments.get(1):
        None:
            2
        Some(root):
            match open_native("${root}/blorp-fs-no-such-file"):
                Ok(_):
                    print("opened")
                    1
                Err(code):
                    print(code.to_string())
                    0
