-- User code cannot declare a manual raw close operation.
-- The library owns the descriptor lifecycle within its callback scope.
-- This previously accepted builtin is now an exact permission rejection.
-- Keep the label span stable for the e2e oracle.
func close_native(descriptor: Int) -> Result[Void, Int]:
    builtin("fs.close")


func main() -> Int:
    match close_native(-1):
        Ok(_):
            print("closed")
            1
        Err(code):
            print(code.to_string())
            0
