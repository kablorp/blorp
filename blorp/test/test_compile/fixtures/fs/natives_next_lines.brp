-- User declarations of raw filesystem handles must be rejected.
-- Even this valid List[String] contract cannot grant library authority.
-- The label is the exact diagnostic span checked by the e2e harness.
-- Positive native behavior remains covered by ordinary fold_lines.
-- Direct C probes independently exercise the low-level batch operation.
func next_lines_native(descriptor: Int, carried: String) -> Result[List[String], Int]:
    builtin("fs.next_lines")


func main() -> Int:
    match next_lines_native(-1, ""):
        Ok(_):
            print("read")
            1
        Err(code):
            print(code.to_string())
            0
