-- A program that calls one native and nothing else from fs must still build
-- as valid C under -Werror, so this declares the builtin directly. The root
-- always exists, so the call succeeds and creates nothing.
func create_all_native(path: String) -> Result[Void, Int]:
    builtin("fs.create_directories")


func main() -> Int:
    match create_all_native("/"):
        Ok(_):
            print("created")
            0
        Err(code):
            print(code.to_string())
            1
