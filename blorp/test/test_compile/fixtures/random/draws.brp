-- 100,000 draws allocate nothing: the run's allocation count stays that of
-- the prints. A seed from the OS is not repeatable, so only a bound of 1,
-- which is always 0, shows that the native compiles and runs.
import:
    bits: bit_xor
    io/console/output: print
    io/random: random_below
    random: Random, seeded, next_int, next_below, split


-- The bit_xor of `count` draws.
private func folded_draws(start: Random, count: Int) -> Int:
    var current = start
    var folded = 0

    for _ in 0..count:
        (drawn, next) = current.next_int()
        folded = folded.bit_xor(drawn)
        current = next

    folded


-- The sum of `count` draws below 6.
private func summed_rolls(start: Random, count: Int) -> Int:
    var current = start
    var total = 0

    for _ in 0..count:
        (roll, next) = current.next_below(6)
        total = total + roll
        current = next

    total


func main() -> Int:
    print("${folded_draws(seeded(2026), 100000)}")
    print("${summed_rolls(seeded(2026), 100000)}")
    (_, child) = seeded(2026).split()
    print("${folded_draws(child, 1000)}")
    print("${random_below(1)}")
    0
