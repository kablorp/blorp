import:
    bytes: Bytes, is_empty, length, to_text
    io/console/read_exact: ReadExactError, read_exact
    io/console/read_line: read_line
    string: String methods


private LENGTH_HEADER: String = "Content-Length: "


-- Header lines up to the blank one, as the language server reads them, and the
-- length the Content-Length header gave (0 when there is none).
private func read_headers() -> Int:
    var count: Int = 0
    var reading: Bool = True

    while reading:
        match read_line():
            Ok(Some(line)):
                if line.is_empty():
                    reading = False
                else:
                    text = line
                        .to_text()
                        .get_or("")

                    if text.starts_with(LENGTH_HEADER):
                        match text.slice(LENGTH_HEADER.length(), text.length()):
                            Some(digits):
                                count = digits
                                    .parse_int()
                                    .get_or(0)
                            None:
                                void
            _:
                reading = False

    count


private func show(result: Result[Option[Bytes], ReadExactError]) -> Void:
    match result:
        Ok(Some(data)): print("body ${data.length()} [${data.to_text().get_or("?")}]")
        Ok(None): print("none")
        Err(error): print("error: ${error}")


-- The body the header counts, then a read of zero bytes, then one more byte.
func main() -> Int:
    count = read_headers()
    show(read_exact(count))
    show(read_exact(0))
    show(read_exact(1))
    0
