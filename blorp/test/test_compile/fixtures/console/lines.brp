import:
    bytes: Bytes, length, to_text
    io/console/read_line: read_line


-- Reads standard input a line at a time until it ends or fails, printing each
-- line's byte count and text in brackets so that a kept CR shows in the count.
func main() -> Int:
    var reading: Bool = True
    while reading:
        match read_line():
            Ok(Some(line)):
                print("line ${line.length()} [${line.to_text().get_or("?")}]")
            Ok(None):
                print("end")
                reading = False
            Err(error):
                print("error: ${error}")
                reading = False
    0
