import:
    bytes: to_bytes, to_text
    io/console/output: flush, print, write
    io/console/read_line: read_line
    io/files/write: write_text
    list: get
    path: to_path


-- A prompt, a reply read after it, then print and write interleaved. The first
-- argument is a file for write_text, which is imported beside write.
func main(arguments: List[String]) -> Int:
    print("prompt> ")
    flush()
    reply = match read_line():
        Ok(Some(line)):
            line
                .to_text()
                .get_or("?")
        _:
            "none"
    print("[")
    write(to_bytes(reply))
    print("]")
    write(to_bytes("\n"))
    match (
        arguments
            .get(1)
            .get_or("")
            .to_path()
    ):
        Ok(path):
            match write_text(path, reply):
                Ok(_): print("written")
                Err(error): print("write failed: ${error}")
        Err(error):
            print("bad path: ${error}")
    0
