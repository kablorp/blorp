import:
    int: Int methods
    list: List methods
    option: Option methods
    string: String methods, from_codepoint


-- ASCII text with CR shown as <CR>, so the output shows which line kept one.
private pure func shown(line: String) -> String:
    var text = ""
    for index in 0..line.length():
        match line.byte_at(index):
            Some(13): text = text + "<CR>"
            Some(byte): text = text + from_codepoint(byte).get_or("?")
            None: void
    text


private func show(name: String, text: String) -> Void:
    lines = text.lines()
    print("${name}: ${lines.length()} lines: ${lines.map(shown).join(" | ")}")


-- The cases of fixtures/fs/lines.brp, which checks that fold_lines agrees.
func main() -> Int:
    show("empty", "")
    show("terminated", "a\n")
    show("unterminated", "a")
    show("crlf", "a\r\nb")
    show("blank lines", "\n\n")
    show("lone cr", "\r")
    show("mixed", "a\r\nb\rc\n\nlast")
    show("cr before lf only", "a\r\r\nb\r")
    multibyte = "é\nü\r\n".lines()
    print(
        "multibyte: ${multibyte.length()} lines of ${multibyte.map(pure func(line: String) -> String: line.length().to_string()).join(" and ")} bytes",
    )
    0
