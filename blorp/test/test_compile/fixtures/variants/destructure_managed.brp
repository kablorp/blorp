-- A union with two managed payloads is destructured from a parameter, from a
-- temporary, in a loop over a reassigned `var` and inside a closure.
union Entry:
    Underlying(String, List[String])


pure func make_entry(name: String, tags: List[String]) -> Entry:
    Entry.Underlying(name, tags)


pure func summary(item: Entry) -> String:
    match item:
        Entry.Underlying(name, tags): "${name}:${tags.length()}"


pure func tag_count(item: Entry) -> Int:
    match item:
        Entry.Underlying(_, tags): tags.length()


func main():
    print(make_entry("ada", ["x", "y"]).summary())

    (first, tags) = match make_entry("grace", ["z"]):
        Entry.Underlying(first, tags): (first, tags)

    print("${first} ${tags.length()}")

    var current = make_entry("a", [])

    for round in [1, 2, 3]:
        (name, more) = match current:
            Entry.Underlying(name, more): (name, more)

        current = make_entry("${name}${round}", more.append("t"))

    print(current.summary())

    final = current

    describe = func() -> String:
        match final:
            Entry.Underlying(inner_name, inner_tags): "${inner_name}/${inner_tags.length()}"

    print(describe())
