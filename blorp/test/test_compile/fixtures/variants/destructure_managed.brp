-- A union with two managed payloads is destructured from a parameter, from a
-- temporary, in a loop over a reassigned `var` and inside a closure.
union Entry:
    Init(String, List[String])


pure func make_entry(name: String, tags: List[String]) -> Entry:
    Entry.Init(name, tags)


pure func summary(item: Entry) -> String:
    Entry.Init(name, tags) = item
    "${name}:${tags.length()}"


pure func tag_count(item: Entry) -> Int:
    Entry.Init(_, tags) = item
    tags.length()


func main():
    print(make_entry("ada", ["x", "y"]).summary())

    Entry.Init(first, tags) = make_entry("grace", ["z"])
    print("${first} ${tags.length()}")

    var current = make_entry("a", [])

    for round in [1, 2, 3]:
        Entry.Init(name, more) = current
        current = make_entry("${name}${round}", more.append("t"))

    print(current.summary())

    final = current

    describe = func() -> String:
        Entry.Init(inner_name, inner_tags) = final
        "${inner_name}/${inner_tags.length()}"

    print(describe())
