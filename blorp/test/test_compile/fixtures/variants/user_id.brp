-- A private variant is built and matched only in its module, bare where no
-- other variant in scope shares its name. An erasure test as well: UserId has
-- one variant and one payload, so it is stored as its Int and the match reads
-- the matched value itself.
union UserId:
    private Underlying(Int)


private pure func user_id(value: Int) -> UserId:
    Underlying(value)


pure func number(id: UserId) -> Int:
    match id:
        Underlying(value): value


func main():
    print(number(user_id(7)).to_string())
