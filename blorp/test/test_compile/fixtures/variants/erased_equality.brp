-- An erasure test: a union stored as its payload keeps its derived equality,
-- with a managed payload and inside an Option.
union Name:
    Underlying(String)


func main():
    print("${Name.Underlying("ada") == Name.Underlying("ada")}")
    print("${Name.Underlying("ada") == Name.Underlying("grace")}")
    first: Option[Name] = Some(Name.Underlying("ada"))
    second: Option[Name] = Some(Name.Underlying("ada"))
    print("${first == second}")
