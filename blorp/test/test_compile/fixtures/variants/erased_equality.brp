-- An erasure test: a union stored as its payload keeps its derived equality,
-- with a managed payload and inside an Option.
union Name:
    Init(String)


func main():
    print("${Name.Init("ada") == Name.Init("ada")}")
    print("${Name.Init("ada") == Name.Init("grace")}")
    first: Option[Name] = Some(Name.Init("ada"))
    second: Option[Name] = Some(Name.Init("ada"))
    print("${first == second}")
