import:
    int: Int methods
    list: List methods


record Rows[V] {
    entries: List[V],
    slots: List[Int]
}


union Box[V]:
    private Init(Rows[V])


pure func make[V](value: V) -> Box[V]:
    Box.Init({ entries = [value], slots = [0] })


pure func count[V](box: Box[V]) -> Int:
    match box:
        Box.Init(rows): rows.entries.length()


func main() -> Int:
    box: Box[String] = make("three")
    count(box).add(count(box))
