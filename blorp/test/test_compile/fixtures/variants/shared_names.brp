-- Two imported unions share the variant name NotFound; each is written through its union.
import:
    ./read_errors: ReadError
    ./write_errors: WriteError


pure func read_code(error: ReadError) -> Int:
    match error:
        ReadError.NotFound: 1
        ReadError.OtherOs(number): number


pure func write_code(error: WriteError) -> Int:
    match error:
        WriteError.NotFound: 10
        WriteError.Full: 20


func main() -> Void:
    read = ReadError.NotFound
    write = WriteError.NotFound
    print((read_code(read) + write_code(write) + read_code(ReadError.OtherOs(100))).to_string())
