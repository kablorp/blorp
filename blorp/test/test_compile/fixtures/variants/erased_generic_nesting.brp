record Rows[V] {
    values: List[V]
}


union Box[V]:
    private Init(Rows[V])


union Nested:
    private Init(Box[Box[Int]])


pure func wrap[V](value: V) -> Box[V]:
    Box.Init({ values = [value] })


pure func first[V](box: Box[V], fallback: V) -> V:
    match box:
        Box.Init(rows):
            match rows.values:
                [value, ..._]: value
                []: fallback


pure func twice[V](value: V) -> Box[Box[V]]:
    wrap(wrap(value))


pure func nested(value: Int) -> Nested:
    Nested.Init(twice(value))


pure func opened(value: Nested) -> Box[Box[Int]]:
    match value:
        Nested.Init(boxes): boxes


func main() -> Int:
    ints = twice(7)
    texts = twice("seven")
    inner = first(opened(nested(3)), wrap(0))

    first(first(ints, wrap(0)), 0)
        .add(first(first(texts, wrap("")), "").length())
        .add(first(inner, 0))
