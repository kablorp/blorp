-- A resource union, read by `match` in its own module. Its one payload is
-- its handle, so a literal arm selects on that Int.
resource union Reader:
    private Underlying(Int)


func open_reader(handle: Int, body: scoped (Reader) -> Int) -> Int:
    body(Reader.Underlying(handle))


func describe(reader: Reader) -> Int:
    match reader:
        Reader.Underlying(0): 100
        Reader.Underlying(handle): handle


func main():
    print("${open_reader(0, func(reader: Reader) -> Int: describe(reader))}")
    print("${open_reader(7, func(reader: Reader) -> Int: describe(reader))}")
