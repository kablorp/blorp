-- Another module builds an Email through `parse`, and its `match` covers the
-- private variant with `_`.
import:
    ./email: Email(Unchecked), describe, parse


pure func label(address: Email) -> String:
    match address:
        Unchecked(text): "unverified ${text}"
        _: "verified"


func main():
    print(label(parse("mailto:x@y")))
    print(label(Unchecked("x@y")))
    print(describe(parse("mailto:a@b")))
