-- A rose tree's payload reaches the tree again, so the union is not erased.
union Tree:
    Node(List[Tree])


pure func size(tree: Tree) -> Int:
    children = match tree:
        Tree.Node(children): children

    var total = 1

    for child in children:
        total = total + child.size()

    total


func main():
    leaf = Tree.Node([])
    tree = Tree.Node([leaf, Tree.Node([leaf, leaf])])
    print("${tree.size()}")
