import:
    string: String methods


union Email:
    -- Only `parse` makes one.
    private Checked(String)
    -- Anyone may make one.
    Unchecked(String)


pure func parse(text: String) -> Email:
    if text.starts_with("mailto:"):
        Email.Checked(text)
    else:
        Unchecked(text)


pure func describe(address: Email) -> String:
    match address:
        Checked(text): "checked ${text}"
        Unchecked(text): "unchecked ${text}"
