-- An erasure test: a union with one variant and one payload is stored as that
-- payload, so `meters` and `feet` both return an Int.
union Meters:
    Underlying(Int)


union Feet:
    private Underlying(Int)


pure func meters(value: Int) -> Meters:
    Meters.Underlying(value)


pure func feet(value: Int) -> Feet:
    Feet.Underlying(value)


func main():
    length = match meters(3):
        Meters.Underlying(length): length

    match feet(4):
        Feet.Underlying(span): print("${length + span}")
