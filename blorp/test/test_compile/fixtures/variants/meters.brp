-- An erasure test: a union with one variant and one payload is stored as that
-- payload, as an opaque type is, so `meters` and `feet` both return an Int.
union Meters:
    Init(Int)


opaque type Feet = Int


pure func meters(value: Int) -> Meters:
    Init(value)


pure func feet(value: Int) -> Feet:
    into_opaque Feet(value)


func main():
    Meters.Init(length) = meters(3)
    print("${length + from_opaque Feet(feet(4))}")
