-- A resource union, read only by destructuring and only in its own module.
-- Its one payload is its handle, so it is stored as that Int.
resource union Reader:
    private Init(Int)


func open_reader(handle: Int, body: scoped (Reader) -> Int) -> Int:
    body(Reader.Init(handle))


func read_chunk(reader: Reader, limit: Int) -> Int:
    Reader.Init(handle) = reader
    handle + limit


func main():
    print("ok")
    print("${open_reader(40, func(reader: Reader) -> Int: read_chunk(reader, 2))}")
