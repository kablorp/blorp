-- A union with two payloads is not stored as one of them. Destructuring it
-- reads each payload with a single-arm match, with no tag test.
union Pair:
    Underlying(Int, String)


func main():
    pair = Pair.Underlying(1, "one")

    (number, word) = match pair:
        Pair.Underlying(number, word): (number, word)

    print("${number} ${word}")
