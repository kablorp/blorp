-- A union with one variant is read by destructuring, bare where no other
-- variant in scope shares the name, or through its union.
union UserId:
    private Underlying(Int)


private pure func user_id(value: Int) -> UserId:
    Underlying(value)


pure func number(id: UserId) -> Int:
    match id:
        Underlying(value): value


pure func qualified(id: UserId) -> Int:
    match id:
        UserId.Underlying(value): value


func main():
    print("${user_id(7).number()}")
    print("${user_id(8).qualified()}")
