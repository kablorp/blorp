-- An erasure test: an erased union with a managed payload is matched in its own
-- module at the root, nested in an Option and in a loop, and read from a
-- temporary. Each arm's payload is the matched value itself.
union Name:
    private Underlying(String)


private pure func name(spelling: String) -> Name:
    Underlying(spelling)


pure func text(value: Name) -> String:
    match value:
        Underlying(inner): inner


pure func maybe_text(value: Option[Name]) -> String:
    match value:
        Some(Underlying(inner)): inner
        None: "nobody"


pure func shouted(word: String) -> String:
    match name(word + "!"):
        Underlying(inner): inner


func main():
    for each in [name("x"), name("y")]:
        print(each.text())

    print(name("ada").text())
    print(maybe_text(Some(name("grace"))))
    print(maybe_text(None))
    print(shouted("hello"))
