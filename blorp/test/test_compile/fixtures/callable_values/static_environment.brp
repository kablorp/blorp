pure func apply_each(values: List[Int], callback: pure (Int) -> String) -> List[String]:
    values.map(callback)


pure func keep(callback: pure (Int) -> String) -> pure (Int) -> String:
    callback


func main() -> Int:
    prefix = "item "
    labels = apply_each([1, 2, 3], pure func(value: Int) -> String: prefix + value.to_string())
    for label in labels:
        print(label)
    kept = keep(pure func(value: Int) -> String: prefix + value.to_string())
    print(kept(4))
    0
