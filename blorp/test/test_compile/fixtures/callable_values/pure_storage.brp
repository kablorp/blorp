import:
    int as int_ops


record TestCase {
    run: pure () -> Int,
}


pure func answer() -> Int:
    42


pure func main() -> Int:
    cases: List[TestCase] = [{ run = answer }, { run = answer }]
    match cases:
        [first, second]:
            first_callback: pure () -> Int = first.run
            second_callback: pure () -> Int = second.run
            int_ops.subtract(int_ops.add(first_callback(), second_callback()), 42)
        _:
            0
