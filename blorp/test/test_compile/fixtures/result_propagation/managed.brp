import:
    int as int_ops
    string as string_ops


func decide(value: String, fail: Bool) -> Result[String, String]:
    print("rhs")
    match fail:
        True: Err(value)
        False: Ok(value)


func advance(value: String, fail: Bool) -> Result[Int, String]:
    prefix = string_ops.add("prefix:", value)
    next ?= decide(value, fail)
    print(prefix)
    Ok(string_ops.length(next))


func main() -> Int:
    value = string_ops.add(int_ops.to_string(42), "é\0")
    retained = value
    match advance(value, False):
        Ok(number): print(int_ops.to_string(number))
        Err(error): print(error)
    print(retained)
    match advance(value, True):
        Ok(number): print(int_ops.to_string(number))
        Err(error): print(error)
    print(retained)
    0
