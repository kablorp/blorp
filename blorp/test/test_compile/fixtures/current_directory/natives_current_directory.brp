import:
    option: Option methods
    string: String methods


-- A program that calls one native and nothing else from system must still build
-- as valid C under -Werror, so this declares the builtin directly. The
-- native reports a failure as a code, so a success is checked by its first byte.
func current_directory_native() -> Result[String, Int]:
    builtin("system.current_directory")


func main() -> Int:
    match current_directory_native():
        Ok(path):
            print(
                path
                    .slice(0, 1)
                    .get_or("?"),
            )
            0
        Err(code):
            print(code.to_string())
            1
