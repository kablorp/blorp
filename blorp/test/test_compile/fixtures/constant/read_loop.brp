-- Reads a List, a counted record and a String constant in a loop. Each read
-- borrows its constant's static storage, so the loop allocates nothing: the
-- one allocation is the printed total.
record Labels {
    short: String,
    long: String
}


ROUNDS: Int = 1000
PRIMES: List[Int] = [2, 3, 5, 7, 11]
LABELS: Labels = { short = "ok", long = "okay" }
GREETING: String = "hello"


func main() -> Int:
    var total = 0

    for _ in 0..ROUNDS:
        total = total + PRIMES.length() + LABELS.long.length() + GREETING.length()

    print(total.to_string())
    0
