-- The decoder witness: 4,096 rounds of the native error decoder on codes 2, 12
-- and -37. A positive code walks the NATIVE_ERROR_KINDS List constant, whose
-- reads borrow its static storage: the one allocation is the printed total.
import:
    io/_errors: native_error_code, native_error_kind


ROUNDS: Int = 4096


pure func decoded(code: Int) -> Int:
    match native_error_kind(code):
        Some(kind): native_error_code(kind)
        None: 0 - code


func main() -> Int:
    var total = 0

    for _ in 0..ROUNDS:
        total = total + decoded(2) + decoded(12) + decoded(-37)

    print(total.to_string())
    0
