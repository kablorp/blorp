-- A constant holds `grow`, whose parameter could reach an in-place append.
-- Invoking it through the constant lends its argument, so ownership pins its
-- parameter borrowed, as for any function taken as a value: `start` is still
-- whole after the call.
pure func grow(values: List[Int]) -> List[Int]:
    values.append(1)


GROWERS: List[pure (List[Int]) -> List[Int]] = [grow]


func main() -> Int:
    start = [5, 6]
    var total = 0

    for grower in GROWERS:
        total = total + grower(start).length()

    print((total + start.length()).to_string())
    0
