import:
    int: Int methods
    list: List methods
    string: String methods


record Walk {
    evens: List[Int],
    odds: List[Int],
}


-- A field projected from the header `state`, then `state` read again in the
-- same iteration: once after the projection's last read, once before it.
pure func project(count: Int) -> String:
    var state: Walk = { evens = [1], odds = [] }
    var out = ""
    for index in 0..count:
        first = state.evens
        out = out + "${first.length()}"
        state = { state | odds = state.odds.append(index) }
        kept = state.evens
        state = { state | evens = state.evens.append(index) }
        out = out + ":${kept.length()}/${state.evens.length()}/${state.odds.length()};"
    out


func main() -> Int:
    print(project(3))
    0
