import:
    int: Int methods
    list: List methods
    string: String methods


record Pair {
    name: String,
    values: List[Int],
}


-- `label` and `pair` are made before the loop and read in every iteration,
-- so no iteration may end them; only the accumulators grow.
pure func labelled(count: Int) -> List[String]:
    label = "item".append_int(count)
    pair: Pair = { name = "pair".append_int(count), values = [1, 2] }
    var found: List[String] = []
    var total = 0
    for index in 0..count:
        found = found.append("${label}-${index}-${pair.name}")
        total = total + pair.values.length()
    found.append("${label} ${pair.name} ${total}")


func main() -> Int:
    for line in labelled(3):
        print(line)
    0
