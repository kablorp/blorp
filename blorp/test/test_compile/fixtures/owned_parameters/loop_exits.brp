import:
    int: Int methods
    list: List methods
    string: String methods


record Walk {
    evens: List[Int],
    odds: List[Int],
}


-- `continue` and `break` taken before the last read of the header `found`.
pure func before(count: Int) -> List[Int]:
    var found: List[Int] = []
    for index in 0..count:
        if index == 1:
            continue
        if index == 3:
            break
        found = found.append(index)
    found


-- `break` taken in an arm of the match whose scrutinee is the last read of
-- `text` on that path; the other arm rebuilds it.
pure func at(count: Int) -> String:
    var text = "a".append_int(0)
    for _ in 0..count:
        match text.length() > 3:
            True: break
            False: text = text + "b"
    text


-- `continue` and `break` taken after the last read of `found`.
pure func after(count: Int) -> List[Int]:
    var found: List[Int] = []
    for index in 0..count:
        found = found.append(index)
        if index == 1:
            continue
        if index == 2:
            break
    found


-- A record header rebuilt before and after the exits.
pure func walk(count: Int) -> Walk:
    var state: Walk = { evens = [], odds = [] }
    for index in 0..count:
        if index == 4:
            break
        state = { state | evens = state.evens.append(index) }
        if index == 1:
            continue
        state = { state | odds = state.odds.append(index) }
    state


pure func show(values: List[Int]) -> String:
    var text = ""
    for value in values:
        text = "${text}${value},"
    text


func main() -> Int:
    print(show(before(5)))
    print(at(10))
    print(show(after(5)))
    walked = walk(9)
    print("${show(walked.evens)} ${show(walked.odds)}")
    0
