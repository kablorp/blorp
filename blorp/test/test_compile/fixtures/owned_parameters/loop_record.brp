import:
    int: Int methods
    list: List methods
    string: String methods


record Walk {
    visiting: List[Int],
    completed: List[Int],
}


-- Each iteration rebuilds `state` from its fields. Its old record is last read
-- by the update's projections, so it drops before the appends and they grow
-- both Lists in place: one record per iteration, and no List is copied.
pure func walk(count: Int) -> Walk:
    var state: Walk = { visiting = [], completed = [] }
    for index in 0..count:
        state = { state |
            visiting = state.visiting.append(index),
            completed = state.completed.append(index * 2),
        }
    state


func main() -> Int:
    walked = walk(100)
    print("${walked.visiting.length()} ${walked.completed.length()}")
    0
