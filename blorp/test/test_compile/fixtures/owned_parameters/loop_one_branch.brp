import:
    int: Int methods
    list: List methods
    string: String methods


record Walk {
    evens: List[Int],
    odds: List[Int],
}


-- `state` and `note` are read only in one branch of an `if` inside the
-- iteration; the other branch carries them unchanged.
pure func split(count: Int) -> String:
    var state: Walk = { evens = [], odds = [] }
    var note = "note".append_int(count)
    for index in 0..count:
        if index % 2 == 0:
            state = { state | evens = state.evens.append(index) }
        if index == 3:
            note = note + "-three"
    "${state.evens.length()} ${state.odds.length()} ${note}"


func main() -> Int:
    print(split(5))
    print(split(2))
    0
