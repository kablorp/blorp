import:
    int: Int methods
    list: List methods
    string: String methods


record Walk {
    evens: List[Int],
    odds: List[Int],
}


-- The inner iteration reads `label`, an owner of the outer iteration, and
-- rebuilds `state`, a header of both loops; the outer iteration reads `label`
-- again after the inner loop.
pure func grid(rows: Int, columns: Int) -> List[String]:
    var lines: List[String] = []
    var state: Walk = { evens = [], odds = [] }
    for row in 0..rows:
        label = "r".append_int(row)
        for column in 0..columns:
            lines = lines.append("${label}c${column}")
            state = { state | evens = state.evens.append(column) }
        lines = lines.append(label)
    lines.append("${state.evens.length()} ${state.odds.length()}")


func main() -> Int:
    for line in grid(2, 2):
        print(line)
    0
