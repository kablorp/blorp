import:
    int: Int methods
    list: List methods
    string: String methods


record Bag {
    items: List[Int],
}


-- Records today's copy. The condition reads `bag.items` through an owner of
-- its own, which each iteration inherits but never reads, so that owner lives
-- to the back edge and every append copies the List. Dropping such an owner
-- when the iteration begins would let the append grow the List in place.
pure func fill(count: Int) -> Int:
    var bag: Bag = { items = [] }
    while bag.items.length() < count:
        bag = { bag | items = bag.items.append(7) }
    bag.items.length()


func main() -> Int:
    print("${fill(100)}")
    0
