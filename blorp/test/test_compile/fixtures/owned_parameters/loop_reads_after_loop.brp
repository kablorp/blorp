import:
    int: Int methods
    list: List methods
    string: String methods


-- `kept` is read in every iteration and after the loop without changing;
-- `grown` is rebuilt in the iteration and read after the loop.
func main() -> Int:
    var kept = "kept".append_int(0)
    var grown = "grown".append_int(0)
    var lengths: List[Int] = []
    var count = 0
    while count < 3:
        lengths = lengths.append(kept.length())
        grown = grown + "!"
        count = count + 1
    print(kept)
    print(grown)
    print("${lengths.length()} ${count}")
    0
