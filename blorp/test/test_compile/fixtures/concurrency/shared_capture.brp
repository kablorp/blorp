import:
    io/console/output: print
    list: append, length


-- Three tasks read one captured List; one appends to its own copy.
func main() -> Int:
    values = [4, 5, 6]

    concurrent:
        longer = values.append(7)
        size = values.length()
        same = values

    print("${longer.length()} ${size} ${same.length()}")
    0
