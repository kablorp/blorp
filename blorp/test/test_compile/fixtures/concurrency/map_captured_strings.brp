import:
    concurrency: parallel_map
    io/console/output: print


func main() -> Int:
    marks = ["!", "?", "."]
    words = ["a", "bb", "ccc", "dddd"]

    marked = words.parallel_map(pure func(word: String) -> String:
        match marks.get(word.length() % 3):
            Some(mark): word + mark
            None: word
    )

    print(marked.join(" "))
    print(words.join(" "))
    0
