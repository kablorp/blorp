import:
    io/console/output: print
    list: append, length


pure func label(count: Int) -> String:
    "count ${count}"


pure func doubled(values: List[Int]) -> List[Int]:
    var result: List[Int] = []

    for value in values:
        result = result.append(value * 2)

    result


-- Four tasks of different types: owned heap results move through the nested
-- pairs and are each released once.
func main() -> Int:
    values = [1, 2, 3]

    concurrent:
        count: Int = values.length()
        text = label(values.length())
        twice = values.doubled()
        flag = values.length() > 2

    if flag:
        print("${count} ${text} ${twice.length()}")

    0
