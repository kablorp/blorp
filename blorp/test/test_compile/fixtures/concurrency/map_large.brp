import:
    concurrency: parallel_map
    io/console/output: print


func main() -> Int:
    var inputs: List[Int] = []

    for index in 0..10000:
        inputs = inputs.append(index)

    outputs = inputs.parallel_map(pure func(value: Int) -> Int: value * 3 + 1)
    var sum = 0

    for value in outputs:
        sum = sum + value

    var sample: List[String] = []

    for position in [0, 1, 4999, 5000, 9998, 9999]:
        match outputs.get(position):
            Some(value): sample = sample.append("${value}")
            None: sample = sample.append("missing")

    print("${outputs.length()} ${sum} ${sample.join(" ")}")
    0
