import:
    concurrency: parallel_map
    io/console/output: print


pure func doubled(value: Int) -> Int:
    value * 2


pure func doubled_row(row: List[Int]) -> List[Int]:
    row.parallel_map(doubled)


func main() -> Int:
    rows: List[List[Int]] = [[1, 2], [3], [], [4, 5, 6]]
    doubled_rows = rows.parallel_map(doubled_row)

    for row in doubled_rows:
        print(
            (
                "["
                + row
                    .map(pure func(value: Int) -> String: "${value}")
                    .join(" ")
                + "]"
            )
        )

    0
