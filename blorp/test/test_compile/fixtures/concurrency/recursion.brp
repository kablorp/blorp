import:
    io/console/output: print


-- Each call splits its range in two tasks, and each task calls this function.
pure func count_between(low: Int, high: Int) -> Int:
    if high - low <= 1:
        high - low
    else:
        middle = (low + high) / 2

        concurrent:
            left = count_between(low, middle)
            right = count_between(middle, high)

        left + right


func main() -> Int:
    print("${count_between(0, 100)}")
    0
