import:
    concurrency: parallel_map
    io/console/output: print


pure func square(value: Int) -> Int:
    value * value


pure func total(values: List[Int]) -> Int:
    var sum = 0

    for value in values:
        sum = sum + value

    sum


pure func summary(values: List[Int]) -> String:
    concurrent:
        squares: List[Int] = values.parallel_map(square)
        sum: Int = values.total()

    "${sum} ${squares.total()}"


func main() -> Int:
    print([3, 1, 4, 1, 5].summary())
    0
