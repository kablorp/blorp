import:
    concurrency: parallel_map
    io/console/output: print


pure func square(value: Int) -> Int:
    value * value


pure func spelled(values: List[Int]) -> String:
    values
        .map(pure func(value: Int) -> String: "${value}")
        .join(" ")


func main() -> Int:
    values = [3, 1, 4, 1, 5]
    squares = values.parallel_map(square)
    print("${squares.length()}: ${squares.spelled()}")
    print("same as map: ${squares == values.map(square)}")
    voids = values.parallel_map(pure func(_: Int) -> Void: void)
    print("voids: ${voids.length()}")
    0
