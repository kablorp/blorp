import:
    io/console/output: print


pure func count_to(limit: Int) -> Int:
    var total = 0

    for index in 0..limit:
        total = total + index

    total


-- A loop task returns nothing, so its job has no result slot and its pair no
-- member for it. In the first block a task that captures nothing precedes one
-- that does; the second block's two loops capture nothing, so their job has
-- no slot at all.
func main() -> Int:
    values = [1, 2, 3]

    concurrent:
        for value in values:
            seen = value

        total = count_to(10)
        size = values.length()

    concurrent:
        for value in [1, 2]:
            ignored = value + 1

        for value in [3, 4]:
            doubled = value * 2

    print("${total} ${size}")
    0
