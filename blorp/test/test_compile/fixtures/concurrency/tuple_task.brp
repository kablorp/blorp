import:
    io/console/output: print


pure func bounds(values: List[Int]) -> (Int, Int):
    var low = 0
    var high = 0

    for value in values:
        if value < low:
            low = value

        if value > high:
            high = value

    (low, high)


union Total:
    Init(Int)


pure func sum(values: List[Int]) -> Total:
    var total = 0

    for value in values:
        total = total + value

    Init(total)


-- A tuple binding and a variant binding each destructure their task's result,
-- and a nested block's names follow the outer block as every task's do.
func main() -> Int:
    values = [3, -2, 7]

    concurrent:
        (low, high) = values.bounds()
        Init(total) = values.sum()

        concurrent:
            doubled = 2 * 3
            named = "x"

    print("${low} ${high} ${total} ${doubled} ${named}")
    0
