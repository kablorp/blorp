import:
    io/console/output: print


-- Each call's two recursive calls are its block's two tasks, so the pool has
-- real work to share at every level.
pure func fibonacci(n: Int) -> Int:
    if n < 2:
        n
    else:
        concurrent:
            left = fibonacci(n - 1)
            right = fibonacci(n - 2)

        left + right


func main() -> Int:
    print("${fibonacci(24)}")
    0
