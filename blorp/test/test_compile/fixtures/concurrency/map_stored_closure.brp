import:
    concurrency: parallel_map
    io/console/output: print


record Scorer {
    score: pure (String) -> Int
}


func main() -> Int:
    bonus = 10
    scorer: Scorer = { score = pure func(word: String) -> Int: word.length() + bonus }
    scores = ["a", "bb", "ccc"].parallel_map(scorer.score)

    print(
        scores
            .map(pure func(score: Int) -> String: "${score}")
            .join(" ")
    )

    0
