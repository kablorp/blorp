import:
    concurrency: parallel_map
    io/console/output: print


pure func padded(row: List[Int]) -> List[Int]:
    row.append(0)


pure func spelled(rows: List[List[Int]]) -> String:
    rows
        .map(pure func(row: List[Int]) -> String: "${row.length()}")
        .join(" ")


func main() -> Int:
    rows: List[List[Int]] = [[1], [2, 3], []]
    longer = rows.parallel_map(padded)
    print("${longer.spelled()} from ${rows.spelled()}")
    0
