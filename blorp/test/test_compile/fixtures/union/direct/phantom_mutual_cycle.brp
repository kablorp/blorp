-- A reaches B only through Q's argument, which Q never stores, so neither
-- owns anything. Building A with its payload inline prepares B while A is
-- still in progress. C, D and Tagged repeat the cycle with a second variant
-- each, which keeps every one a tagged layout whatever single-payload unions
-- become.
union Q[U]:
    Underlying(Int)


union A:
    MkA(Q[B])


union B:
    MkB(A)


union Tagged[U]:
    Tag(Int)
    Untagged


union C:
    MkC(Tagged[D])
    NoC


union D:
    MkD(C)
    NoD


func main():
    a = A.MkA(Q.Underlying(2))
    c = C.MkC(Tagged.Tag(3))

    match c:
        MkC(Tag(3)): print("x")
        _: print("y")
