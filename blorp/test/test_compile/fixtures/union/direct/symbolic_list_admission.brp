import:
    list: repeat


-- Empty keeps Values a tagged union: a union with one variant and one payload
-- is stored as that payload.
union Values[T]:
    Items(List[T])
    Empty


pure func produce() -> Values[Int]:
    Items(repeat(0, 0))


pure func pass(value: Values[Int]) -> Values[Int]:
    value


func main() -> Int:
    unused = pass(produce())
    0
