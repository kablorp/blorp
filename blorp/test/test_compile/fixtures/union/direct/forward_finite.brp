-- Missing and Absent keep both unions tagged: a union with one variant and one
-- payload is stored as that payload.
union Outer:
    Value(Inner)
    Missing


union Inner:
    Wrapped(Payload)
    Absent


record Payload {
    value: Int
}


pure func make() -> Outer:
    Value(Wrapped({ value = 7 }))


pure func inner(value: Outer) -> Inner:
    match value:
        Value(item): item
        Missing: Absent


pure func payload(value: Inner) -> Payload:
    match value:
        Wrapped(item): item
        Absent: { value = 0 }


func main() -> Int:
    payload(inner(make())).value
