-- Results that every platform computes exactly: the correctly rounded
-- functions, the conversions, and the transcendental functions only where C's
-- Annex F fixes their value. libm may differ in the last bit elsewhere.
import:
    int: INT_MAX, INT_MIN
    math: Float methods, Int methods, PI, atan2


func main() -> Int:
    infinity = 1.0e308 * 10.0
    print("sqrt ${2.0.sqrt()} ${16.0.sqrt()} ${(-1.0).sqrt()} ${(-0.0).sqrt()}")
    print("floor ${(-1.5).floor()} ceil ${(-1.5).ceil()} ${(-0.5).ceil()}")
    print("round ${2.5.round()} ${(-2.5).round()} ${0.49999999999999994.round()}")
    print("trunc ${(-1.7).trunc()} ${1.7.trunc()}")
    print("exact ${0.0.sin()} ${0.0.cos()} ${1.0.log()} ${0.0.log()} ${0.0.exp()} ${2.0.pow(10.0)}")
    print("angles ${atan2(0.0, -1.0) == PI} ${atan2(1.0, 0.0) == PI / 2.0}")

    print(
        "to_int ${(-1.9).to_int()} ${infinity.to_int()} ${(0.0 - infinity).to_int()} ${(infinity - infinity).to_int()}"
    )

    print(
        "to_float ${INT_MAX.to_float()} ${INT_MIN.to_float()} ${9007199254740993.to_float()} ${(-3).to_float()}"
    )

    (
        INT_MAX
            .to_float()
            .to_int()
        - INT_MAX
    )
