-- Every bits operation, and each shift at the counts C leaves undefined, which
-- the sanitized build of this fixture would report.
import:
    bits: Int methods
    int: INT_MAX, INT_MIN


func main() -> Int:
    print("and ${12.bit_and(10)} or ${12.bit_or(10)} xor ${12.bit_xor(10)} not ${5.bit_not()}")
    print("limits ${INT_MAX.bit_or(INT_MIN)} ${INT_MAX.bit_xor(-1)} ${INT_MIN.bit_and(-1)}")

    for count in [-1, 0, 1, 63, 64, 1000]:
        print("${count}: left ${(-3).shift_left(count)} right ${(-3).shift_right(count)}")

    0
