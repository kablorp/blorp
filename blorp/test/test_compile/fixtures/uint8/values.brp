-- UInt8 in use: literals that take UInt8 from their context, wrapping
-- arithmetic, comparisons, conversions, patterns and storage.
import:
    list: get
    option: Option methods


-- A fixed record may hold a UInt8 field.
fixed record Pixel {
    red: UInt8,
    alpha: UInt8,
}


pure func hashed[T: Hashable](value: T) -> Int:
    value.hash()


pure func takes_int(value: Int) -> Int:
    value


pure func describe(byte: UInt8) -> String:
    match byte:
        0: "zero"
        255: "max"
        _: "other"


pure func yes_no(value: Bool) -> String:
    match value:
        True: "yes"
        False: "no"


pure func show(values: List[UInt8]) -> String:
    var text = "["
    for value in values:
        text = text + " " + value.to_string()
    text + " ]"


pure func show_option(value: Option[UInt8]) -> String:
    match value:
        Some(byte): "Some(${byte})"
        None: "None"


func literals() -> Void:
    byte: UInt8 = 200
    next = byte + 1
    wrapped = 0 - byte
    is_zero = byte == 0
    maybe: Option[UInt8] = Some(200)
    signature: List[UInt8] = [137, 80]
    count = 5
    print("byte ${byte}, next ${next}, wrapped ${wrapped}, zero ${yes_no(is_zero)}")
    print("maybe ${show_option(maybe)}, signature ${show(signature)}")
    print(
        "larger ${max(byte, 3)} ${max(3, byte)} smaller ${min(byte, 3)}, count ${takes_int(count)}",
    )


func arithmetic() -> Void:
    zero: UInt8 = 0
    under: UInt8 = 0 - 1
    over: UInt8 = 255 + 1
    product: UInt8 = 200 * 2
    sum: UInt8 = 200 + 100
    byte: UInt8 = 200
    print("wrap ${under} ${over} ${product} ${sum}")
    print("divide ${byte / 7} ${byte % 7} ${byte / zero} ${byte % zero}")


func comparisons() -> Void:
    byte: UInt8 = 200
    print("equal ${yes_no(byte == 200)} ${yes_no(byte != 201)}")
    print(
        "order ${yes_no(byte < 201)} ${yes_no(byte > 3)} ${yes_no(byte <= 200)} ${yes_no(byte >= 201)}",
    )


func conversions() -> Void:
    byte: UInt8 = 200
    print("to_int ${byte.to_int() + 1000}, hash ${hashed(byte)}")
    print(
        "to_uint8 ${show_option(0.to_uint8())} ${show_option(255.to_uint8())} ${show_option(256.to_uint8())} ${show_option((-1).to_uint8())}",
    )
    print(
        "parse ${show_option("17".parse_uint8())} ${show_option("255".parse_uint8())} ${show_option("256".parse_uint8())} ${show_option("-1".parse_uint8())} ${show_option("x".parse_uint8())} ${show_option("".parse_uint8())} ${show_option("+17".parse_uint8())} ${show_option(" 17".parse_uint8())} ${show_option("-0".parse_uint8())} ${show_option("99999999999999999999".parse_uint8())}",
    )


func storage() -> Void:
    pixel: Pixel = { red = 255, alpha = 0 }
    print("pixel ${pixel.red} ${pixel.alpha}")
    print("patterns ${describe(0)} ${describe(255)} ${describe(7)}")
    values: List[UInt8] = [1, 2]
    grown = values.append(250)
    print("list ${show(grown)} length ${grown.length()} second ${show_option(grown.get(1))}")


func main() -> Int:
    literals()
    arithmetic()
    comparisons()
    conversions()
    storage()
    0
