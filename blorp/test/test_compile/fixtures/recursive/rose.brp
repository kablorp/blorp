union Rose[T]:
    Rose(T, List[Rose[T]])


record Labelled[T] {
    label: T,
    children: List[Labelled[T]],
}


pure func total(tree: Rose[Int]) -> Int:
    match tree:
        Rose(value, children):
            var sum = value
            for child in children:
                sum = sum + child.total()
            sum


pure func count[T](tree: Labelled[T]) -> Int:
    var sum = 1
    for child in tree.children:
        sum = sum + child.count()
    sum


pure func answer(value: Bool) -> String:
    if value:
        "equal"
    else:
        "different"


func main() -> Int:
    tree: Rose[Int] = Rose(1, [Rose(2, []), Rose(3, [Rose(4, [])])])
    print(
        tree
            .total()
            .to_string(),
    )
    leaf: Labelled[String] = { label = "leaf", children = [] }
    labelled: Labelled[String] = { label = "root", children = [leaf] }
    print(
        labelled
            .count()
            .to_string(),
    )
    print(answer(tree == Rose(1, [Rose(2, []), Rose(3, [Rose(4, [])])])))
    0
