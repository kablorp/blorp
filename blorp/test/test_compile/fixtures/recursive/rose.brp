union Rose[T]:
    Node(T, List[Rose[T]])


record Labelled[T] {
    label: T,
    children: List[Labelled[T]]
}


pure func total(tree: Rose[Int]) -> Int:
    match tree:
        Node(value, children):
            var sum = value

            for child in children:
                sum = sum + child.total()

            sum


pure func count[T](tree: Labelled[T]) -> Int:
    var sum = 1

    for child in tree.children:
        sum = sum + child.count()

    sum


pure func answer(value: Bool) -> String:
    if value:
        "equal"
    else:
        "different"


func main() -> Int:
    tree: Rose[Int] = Node(1, [Node(2, []), Node(3, [Node(4, [])])])

    print(
        tree
            .total()
            .to_string()
    )

    leaf: Labelled[String] = { label = "leaf", children = [] }
    labelled: Labelled[String] = { label = "root", children = [leaf] }

    print(
        labelled
            .count()
            .to_string()
    )

    print(answer(tree == Node(1, [Node(2, []), Node(3, [Node(4, [])])])))
    0
