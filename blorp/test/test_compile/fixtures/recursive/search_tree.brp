union SearchTree[T: Orderable]:
    Empty
    Branch(SearchTree[T], T, SearchTree[T])


pure func insert[T: Orderable](tree: SearchTree[T], value: T) -> SearchTree[T]:
    match tree:
        Empty:
            Branch(Empty, value, Empty)
        Branch(left, key, right):
            if value < key:
                Branch(left.insert(value), key, right)
            else if key < value:
                Branch(left, key, right.insert(value))
            else:
                tree


pure func contains[T: Orderable](tree: SearchTree[T], value: T) -> Bool:
    match tree:
        Empty:
            False
        Branch(left, key, right):
            if value < key:
                left.contains(value)
            else if key < value:
                right.contains(value)
            else:
                True


pure func depth[T: Orderable](tree: SearchTree[T]) -> Int:
    match tree:
        Empty: 0
        Branch(left, _, right): 1 + max(left.depth(), right.depth())


pure func answer(value: Bool) -> String:
    if value:
        "yes"
    else:
        "no"


func main() -> Int:
    var paths: SearchTree[List[Int]] = Empty

    for path in [[2, 1], [1], [3, 0, 0], [2], [1]]:
        paths = paths.insert(path)

    var numbers: SearchTree[Int] = Empty

    for value in [4, 2, 6, 1, 3, 5, 7]:
        numbers = numbers.insert(value)

    var again: SearchTree[Int] = Empty

    for value in [4, 2, 6, 1, 3, 5, 7]:
        again = again.insert(value)

    print(answer(paths.contains([3, 0, 0])))
    print(answer(paths.contains([3, 0])))

    print(
        paths
            .depth()
            .to_string()
    )

    print(
        numbers
            .depth()
            .to_string()
    )

    print(answer(numbers == again))
    print(answer(numbers == again.insert(8)))
    print(answer(paths == paths.insert([2, 1])))
    0
