union Maybe[V]:
    private Underlying(Option[V])


union U:
    A(Maybe[U])
    B


pure func depth(value: U) -> Int:
    match value:
        B:
            0
        A(inner):
            held = match inner:
                Maybe.Underlying(held): held

            match held:
                Some(next): 1 + next.depth()
                None: 1


func main() -> Int:
    depth(A(Maybe.Underlying(Some(A(Maybe.Underlying(None))))))
