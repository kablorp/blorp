-- Node holds one counted pointer, within the value bound, but contains itself
-- through an opaque type and Option, so each Node is a counted cell, and a
-- million of them chained must release.
opaque type Link[T] = Option[T]


record Node {
    value: Int,
    next: Link[Node]
}


pure func chain(length: Int) -> Link[Node]:
    var head: Link[Node] = into_opaque Link(None)
    for index in 0..length:
        node: Node = { value = index, next = head }
        head = into_opaque Link(Some(node))
    head


func main() -> Int:
    match from_opaque Link(chain(1000000)):
        Some(node): node.value % 50
        None: 0
