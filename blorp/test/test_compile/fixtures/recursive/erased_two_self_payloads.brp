union Box[V]:
    private Init(V)


union U:
    A(Box[U], Box[U])
    B


pure func unboxed(box: Box[U]) -> U:
    match box:
        Box.Init(value): value


pure func size(value: U) -> Int:
    match value:
        B: 1
        A(left, right): size(left.unboxed()) + size(right.unboxed())


func main() -> Int:
    leaf: U = B
    pair: U = A(Box.Init(leaf), Box.Init(leaf))
    size(A(Box.Init(leaf), Box.Init(pair)))
