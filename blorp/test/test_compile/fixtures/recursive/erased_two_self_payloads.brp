union Box[V]:
    private Underlying(V)


union U:
    A(Box[U], Box[U])
    B


pure func unboxed(box: Box[U]) -> U:
    match box:
        Box.Underlying(value): value


pure func size(value: U) -> Int:
    match value:
        B: 1
        A(left, right): size(left.unboxed()) + size(right.unboxed())


func main() -> Int:
    leaf: U = B
    pair: U = A(Box.Underlying(leaf), Box.Underlying(leaf))
    size(A(Box.Underlying(leaf), Box.Underlying(pair)))
