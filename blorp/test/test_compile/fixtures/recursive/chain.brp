union Chain[T]:
    End
    Link(T, Chain[T])


pure func length[T](chain: Chain[T]) -> Int:
    match chain:
        End: 0
        Link(_, rest): 1 + rest.length()


pure func joined(chain: Chain[String]) -> String:
    match chain:
        End: ""
        Link(head, rest): head + rest.joined()


pure func answer(value: Bool) -> String:
    if value:
        "equal"
    else:
        "different"


func main() -> Int:
    var numbers: Chain[Int] = End

    for value in [1, 2, 3]:
        numbers = Link(value, numbers)

    var words: Chain[String] = End

    for word in ["c", "b", "a"]:
        words = Link(word, words)

    same: Chain[Int] = Link(3, Link(2, Link(1, End)))

    print(
        numbers
            .length()
            .to_string()
    )

    print(words.joined())
    print(answer(numbers == same))
    print(answer(numbers == Link(0, numbers)))
    print(answer(words == Link("a", Link("b", Link("c", End)))))
    0
