-- Node holds one counted pointer, within the value bound, but contains itself
-- through an erased union and Option, so each Node is a counted cell, and a
-- million of them chained must release.
union Link[T]:
    private Underlying(Option[T])


record Node {
    value: Int,
    next: Link[Node]
}


pure func chain(length: Int) -> Link[Node]:
    var head: Link[Node] = Link.Underlying(None)

    for index in 0..length:
        node: Node = { value = index, next = head }
        head = Link.Underlying(Some(node))

    head


func main() -> Int:
    match chain(1000000):
        Link.Underlying(held):
            match held:
                Some(node): node.value % 50
                None: 0
