union Even:
    EvenZero
    EvenNext(Odd)


union Odd:
    OddNext(Even)


union Node:
    Stop(Int)
    Next(Option[Node])


opaque type Maybe[V] = Option[V]


union Wrapped:
    Bare
    Wrap(Maybe[Wrapped], Maybe[Wrapped])


pure func even_count(value: Even) -> Int:
    match value:
        EvenZero: 0
        EvenNext(odd): 1 + odd.odd_count()


pure func odd_count(value: Odd) -> Int:
    match value:
        OddNext(even): 1 + even.even_count()


pure func node_count(node: Node) -> Int:
    match node:
        Stop(value): value
        Next(None): 0
        Next(Some(child)): 1 + child.node_count()


pure func wrapped_count(value: Wrapped) -> Int:
    match value:
        Bare:
            1
        Wrap(left, right):
            var count = 0
            for side in [left, right]:
                match from_opaque Maybe(side):
                    None: void
                    Some(inner): count = count + inner.wrapped_count()
            count


pure func answer(value: Bool) -> String:
    if value:
        "equal"
    else:
        "different"


func main() -> Int:
    four: Even = EvenNext(OddNext(EvenNext(OddNext(EvenZero))))
    print(
        four
            .even_count()
            .to_string()
    )
    print(answer(four == EvenNext(OddNext(EvenNext(OddNext(EvenZero))))))
    chain: Node = Next(Some(Next(Some(Stop(10)))))
    print(
        chain
            .node_count()
            .to_string()
    )
    print(answer(chain == Next(Some(Next(Some(Stop(10)))))))
    print(answer(chain == Next(None)))
    leaf: Maybe[Wrapped] = into_opaque Maybe(Some(Bare))
    nothing: Maybe[Wrapped] = into_opaque Maybe(None)
    pair: Wrapped = Wrap(leaf, into_opaque Maybe(Some(Wrap(leaf, nothing))))
    print(
        pair
            .wrapped_count()
            .to_string()
    )
    0
