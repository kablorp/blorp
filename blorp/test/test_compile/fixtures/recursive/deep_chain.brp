union Chain[T]:
    End
    Link(T, Chain[T])


func main() -> Int:
    var chain: Chain[Int] = End
    var count = 0

    while count < 100000:
        chain = Link(count, chain)
        count = count + 1

    var length = 0
    var cursor = chain
    var walking: Bool = True

    while walking:
        match cursor:
            End:
                walking = False
            Link(_, rest):
                length = length + 1
                cursor = rest

    print(length.to_string())
    0
