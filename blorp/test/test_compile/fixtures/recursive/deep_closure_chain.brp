-- Each closure captures the one before it. Calling the chain would recurse a
-- million calls deep, so the program only releases it.
pure func chain(length: Int) -> pure (Int) -> Int:
    var step: pure (Int) -> Int = pure func(x: Int) -> Int: x

    for index in 0..length:
        previous = step
        step = pure func(x: Int) -> Int: previous(x) + index

    step


func main() -> Int:
    length = 1000000
    step = chain(length)

    match length < 1000:
        True: step(0) % 100
        False: 7
