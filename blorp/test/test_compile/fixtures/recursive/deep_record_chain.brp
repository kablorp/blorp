record Node {
    value: Int,
    next: Option[Node],
}


pure func chain(length: Int) -> Option[Node]:
    var head: Option[Node] = None
    for index in 0..length:
        head = Some({ value = index, next = head })
    head


func main() -> Int:
    match chain(1000000):
        Some(node): node.value % 50
        None: 0
