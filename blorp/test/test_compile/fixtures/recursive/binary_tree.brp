union Tree:
    Leaf
    Node(Tree, Int, Tree)


pure func insert(tree: Tree, value: Int) -> Tree:
    match tree:
        Leaf:
            Node(Leaf, value, Leaf)
        Node(left, key, right):
            if value < key:
                Node(left.insert(value), key, right)
            else:
                Node(left, key, right.insert(value))


pure func total(tree: Tree) -> Int:
    match tree:
        Leaf: 0
        Node(left, key, right): left.total() + key + right.total()


pure func size(tree: Tree) -> Int:
    match tree:
        Leaf: 0
        Node(left, _, right): left.size() + 1 + right.size()


pure func answer(value: Bool) -> String:
    if value:
        "equal"
    else:
        "different"


func main() -> Int:
    var tree: Tree = Leaf

    for value in [5, 3, 8, 1, 4, 7, 9]:
        tree = tree.insert(value)

    var same: Tree = Leaf

    for value in [5, 3, 8, 1, 4, 7, 9]:
        same = same.insert(value)

    other = tree.insert(6)

    print(
        tree
            .total()
            .to_string()
    )

    print(
        tree
            .size()
            .to_string()
    )

    print(answer(tree == same))
    print(answer(tree == other))
    shared: Tree = Node(tree, 0, tree)

    print(
        shared
            .size()
            .to_string()
    )

    0
