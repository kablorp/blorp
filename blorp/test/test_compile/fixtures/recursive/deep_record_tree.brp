record Tree {
    value: Int,
    left: Option[Tree],
    right: Option[Tree]
}


pure func leaf(value: Int) -> Option[Tree]:
    Some({ value = value, left = None, right = None })


-- A left spine of the given length; every spine node also holds a right leaf.
pure func spine(length: Int) -> Option[Tree]:
    var head: Option[Tree] = None

    for index in 0..length:
        head = Some({ value = index, left = head, right = leaf(index) })

    head


func main() -> Int:
    match spine(1000000):
        Some(tree): tree.value % 50
        None: 0
