union Constant[T]:
    Value(T)
    Reset(Constant[Int])


union Swap[A, B]:
    Pair(A, B)
    Swapped(Swap[B, A])


pure func depth[T](value: Constant[T]) -> Int:
    match value:
        Value(_): 0
        Reset(inner): 1 + inner.depth()


pure func flips[A, B](value: Swap[A, B]) -> Int:
    match value:
        Pair(_, _): 0
        Swapped(inner): 1 + inner.flips()


func main() -> Int:
    word: Constant[String] = Reset(Reset(Value(7)))
    swap: Swap[Int, String] = Swapped(Swapped(Pair(1, "one")))
    print(
        word
            .depth()
            .to_string(),
    )
    print(
        swap
            .flips()
            .to_string(),
    )
    0
