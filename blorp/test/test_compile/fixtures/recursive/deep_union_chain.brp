record Holder {
    label: String,
    link: Link
}


union Link:
    End
    Next(Holder)


pure func chain(length: Int) -> Link:
    var head: Link = End
    for index in 0..length:
        head = Next({ label = "node", link = head })
    head


func main() -> Int:
    match chain(1000000):
        End: 0
        Next(holder): holder.label.length()
