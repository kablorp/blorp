import:
    bytes: Bytes, from_list, to_list, slice, length
    int: Int methods
    io/files/read: Reader, ReadError, read_chunk, with_reader
    io/files/write: Writer, WriteError, write_all, with_atomic_writer
    list: get, map
    path: Path, to_path
    uint8: UInt8 methods
    ./transfer: CopyError(ReadFailed, WriteFailed)


private WRITE_SLICE_BYTES: Int = 23

private INCREMENT: UInt8 = 1

private GENERATED_CHUNKS: Int = 257


func write_slices(writer: Writer, data: Bytes) -> Result[Void, CopyError]:
    var offset = 0
    var outcome: Result[Void, WriteError] = Ok(void)
    while offset < length(data):
        outcome = write_all(writer, slice(data, offset, offset + WRITE_SLICE_BYTES))
        match outcome:
            Err(_): break
            Ok(_): offset = offset + WRITE_SLICE_BYTES
    outcome.map_err(pure func(error: WriteError) -> CopyError: WriteFailed(error))


func transform_step(reader: Reader, writer: Writer) -> Result[Bool, CopyError]:
    chunk ?= read_chunk(reader).map_err(pure func(error: ReadError) -> CopyError: ReadFailed(error))
    match chunk:
        None:
            Ok(False)
        Some(data):
            transformed = from_list(
                map(to_list(data), pure func(value: UInt8) -> UInt8: value + INCREMENT)
            )
            write_slices(writer, transformed).map(pure func(_: Void) -> Bool: True)


func transform(reader: Reader, writer: Writer) -> Result[Void, CopyError]:
    var outcome: Result[Bool, CopyError] = Ok(True)
    var more: Bool = True
    while more:
        outcome = transform_step(reader, writer)
        match outcome:
            Ok(value): more = value
            Err(_): more = False
    outcome.map(pure func(_: Bool) -> Void: void)


func generate(writer: Writer) -> Result[Void, CopyError]:
    -- A known repeating binary pattern, independent of any input or chunking.
    pattern = from_list([0, 255, 128, 65, 10])
    var outcome: Result[Void, CopyError] = Ok(void)
    for _ in 0..GENERATED_CHUNKS:
        outcome = write_slices(writer, pattern)
        match outcome:
            Err(_): break
            Ok(_): void
    outcome


func run(source: Path, target: Path, generated: Path) -> Result[Void, CopyError]:
    transformed ?= with_reader(
        source,
        func(reader: Reader) -> Result[Void, CopyError]: with_atomic_writer(
            target,
            func(writer: Writer) -> Result[Void, CopyError]: transform(reader, writer),
            pure func(error: WriteError) -> CopyError: WriteFailed(error)
        ),
        pure func(error: ReadError) -> CopyError: ReadFailed(error)
    )
    with_atomic_writer(
        generated,
        generate,
        pure func(error: WriteError) -> CopyError: WriteFailed(error)
    )


func main(arguments: List[String]) -> Int:
    match (get(arguments, 1), get(arguments, 2), get(arguments, 3)):
        (Some(source), Some(target), Some(generated)):
            match (to_path(source), to_path(target), to_path(generated)):
                (Ok(input), Ok(output), Ok(created)):
                    match run(input, output, created):
                        Ok(_): 0
                        Err(_): 1
                _:
                    2
        _:
            2
