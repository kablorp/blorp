import:
    bytes: Bytes, from_list, equals
    int: Int methods
    io/files/read: Reader, ReadError, read_chunk, with_reader
    io/files/write: Writer, WriteError, write_all, with_atomic_writer
    list: get
    path: Path, to_path
    result: Result methods


union EarlyError:
    ReadFailed(ReadError)
    WriteFailed(WriteError)
    ApplicationStopped


private REPETITIONS: Int = 256


func prefix(reader: Reader) -> Result[Void, EarlyError]:
    read_chunk(reader)
        .map(pure func(_: Option[Bytes]) -> Void: void)
        .map_err(pure func(error: ReadError) -> EarlyError: ReadFailed(error))


func abandon(writer: Writer) -> Result[Void, EarlyError]:
    written ?= write_all(writer, from_list([0, 255, 10])).map_err(
        pure func(error: WriteError) -> EarlyError: WriteFailed(error),
    )
    Err(ApplicationStopped)


func repeat(source: Path, target: Path) -> Int:
    var completed = 0
    for _ in 0..REPETITIONS:
        match with_reader(
            source,
            prefix,
            pure func(error: ReadError) -> EarlyError: ReadFailed(error),
        ):
            Err(_): break
            Ok(_): void
        match with_atomic_writer(
            target,
            abandon,
            pure func(error: WriteError) -> EarlyError: WriteFailed(error),
        ):
            Err(ApplicationStopped): completed = completed + 1
            _: break
    -- A counter makes a prematurely terminated loop visible to the parent.
    if completed == REPETITIONS:
        0
    else:
        1


func owned_chunk(reader: Reader) -> Result[Bytes, EarlyError]:
    chunk ?= read_chunk(reader).map_err(
        pure func(error: ReadError) -> EarlyError: ReadFailed(error),
    )
    match chunk:
        Some(data): Ok(data)
        None: Ok(from_list([]))


func run(source: Path, target: Path, known: Path) -> Int:
    -- This Result contains ordinary owned Bytes; the Reader has already closed.
    retained: Result[Bytes, EarlyError] = with_reader(
        known,
        owned_chunk,
        pure func(error: ReadError) -> EarlyError: ReadFailed(error),
    )
    match retained:
        Ok(data):
            if equals(data, from_list([0])):
                repeat(source, target)
            else:
                1
        Err(_):
            1


func main(arguments: List[String]) -> Int:
    match (get(arguments, 1), get(arguments, 2), get(arguments, 3)):
        (Some(source), Some(target), Some(known)):
            match (to_path(source), to_path(target), to_path(known)):
                (Ok(input), Ok(output), Ok(single_byte)): run(input, output, single_byte)
                _: 2
        _:
            2
