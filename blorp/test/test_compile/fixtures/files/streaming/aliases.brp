import:
    io/files/read: Reader, ReadError, with_reader
    io/files/write: Writer, WriteError, with_atomic_writer
    list: get
    path: Path, to_path
    ./transfer: CopyError(ReadFailed, WriteFailed), copy_chunks


func invoke(body: scoped () -> Result[Void, CopyError]) -> Result[Void, CopyError]:
    body()


func forward(body: scoped () -> Result[Void, CopyError]) -> Result[Void, CopyError]:
    relay = func() -> Result[Void, CopyError]: body()
    forwarded_body = relay
    invoke(forwarded_body)


func copy_with_aliases(reader: Reader, writer: Writer) -> Result[Void, CopyError]:
    print("body")
    transfer = func() -> Result[Void, CopyError]: copy_chunks(reader, writer)
    copied_body = transfer
    forward(copied_body)


func forwarded_copy(source: Path, target: Path) -> Result[Void, CopyError]:
    with_reader(
        source,
        func(reader: Reader) -> Result[Void, CopyError]: with_atomic_writer(
            target,
            func(writer: Writer) -> Result[Void, CopyError]: copy_with_aliases(reader, writer),
            pure func(error: WriteError) -> CopyError: WriteFailed(error),
        ),
        pure func(error: ReadError) -> CopyError: ReadFailed(error),
    )


func main(arguments: List[String]) -> Int:
    match (get(arguments, 1), get(arguments, 2)):
        (Some(source), Some(target)):
            match (to_path(source), to_path(target)):
                (Ok(input), Ok(output)):
                    print("before")
                    match forwarded_copy(input, output):
                        Ok(_):
                            print("after")
                            0
                        Err(_):
                            1
                _:
                    2
        _:
            2
