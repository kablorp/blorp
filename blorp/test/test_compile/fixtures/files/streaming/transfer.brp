import:
    io/files/read: Reader, ReadError, read_chunk, with_reader
    io/files/write: Writer, WriteError, write_all, with_atomic_writer
    path: Path
    result: Result methods


union CopyError:
    ReadFailed(ReadError)
    WriteFailed(WriteError)


func copy_step(reader: Reader, writer: Writer) -> Result[Bool, CopyError]:
    chunk ?= read_chunk(reader).map_err(pure func(error: ReadError) -> CopyError: ReadFailed(error))
    match chunk:
        None:
            Ok(False)
        Some(data):
            write_all(writer, data)
                .map(pure func(_: Void) -> Bool: True)
                .map_err(pure func(error: WriteError) -> CopyError: WriteFailed(error))


func copy_chunks(reader: Reader, writer: Writer) -> Result[Void, CopyError]:
    var state: Result[Bool, CopyError] = Ok(True)
    var copying: Bool = True
    while copying:
        state = copy_step(reader, writer)
        match state:
            Ok(more): copying = more
            Err(_): copying = False
    state.map(pure func(_: Bool) -> Void: void)


func copy_file(source: Path, target: Path) -> Result[Void, CopyError]:
    with_reader(
        source,
        func(reader: Reader) -> Result[Void, CopyError]: with_atomic_writer(
            target,
            func(writer: Writer) -> Result[Void, CopyError]: copy_chunks(reader, writer),
            pure func(error: WriteError) -> CopyError: WriteFailed(error)
        ),
        pure func(error: ReadError) -> CopyError: ReadFailed(error)
    )
