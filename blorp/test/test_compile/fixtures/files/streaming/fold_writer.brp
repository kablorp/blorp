import:
    bytes: to_bytes
    int: Int methods
    io/files/read: ReadError, fold_lines
    io/files/write: Writer, WriteError, write_all, with_atomic_writer
    list: get
    path: Path, to_path
    string: String methods


union FoldError:
    ReadFailed(ReadError)
    WriteFailed(WriteError)
    ApplicationStopped


func emit_line(writer: Writer, count: Int, line: String, stop: Int) -> Result[Int, FoldError]:
    written ?= write_all(writer, to_bytes(line + "\n")).map_err(
        pure func(error: WriteError) -> FoldError: WriteFailed(error)
    )
    next = count + 1
    print("step ${next}")
    if next == stop:
        Err(ApplicationStopped)
    else:
        Ok(next)


func fold_to_writer(source: Path, writer: Writer, stop: Int) -> Result[Int, FoldError]:
    fold_lines(
        source,
        0,
        func(count: Int, line: String) -> Result[Int, FoldError]: emit_line(
            writer,
            count,
            line,
            stop
        ),
        pure func(error: ReadError) -> FoldError: ReadFailed(error)
    )


func write_lines(source: Path, target: Path, stop: Int) -> Result[Int, FoldError]:
    with_atomic_writer(
        target,
        func(writer: Writer) -> Result[Int, FoldError]: fold_to_writer(source, writer, stop),
        pure func(error: WriteError) -> FoldError: WriteFailed(error)
    )


func run(source: Path, success: Path, failure: Path) -> Int:
    match write_lines(source, success, 0):
        Ok(3):
            print("success 3")
            match write_lines(source, failure, 2):
                Err(ApplicationStopped):
                    print("stopped")
                    0
                _:
                    1
        _:
            1


func main(arguments: List[String]) -> Int:
    match (get(arguments, 1), get(arguments, 2), get(arguments, 3)):
        (Some(source), Some(success), Some(failure)):
            match (to_path(source), to_path(success), to_path(failure)):
                (Ok(input), Ok(output), Ok(discarded)): run(input, output, discarded)
                _: 2
        _:
            2
