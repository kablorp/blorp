-- The parent checks complete output bytes. This child only copies, so its
-- measured peak storage excludes whole-file verification.
import:
    list: get
    path: to_path
    ./transfer: copy_file


func main(arguments: List[String]) -> Int:
    match (get(arguments, 1), get(arguments, 2)):
        (Some(source), Some(target)):
            match (to_path(source), to_path(target)):
                (Ok(input), Ok(output)):
                    match copy_file(input, output):
                        Ok(_): 0
                        Err(_): 1
                _:
                    2
        _:
            2
