-- Empty keeps Box a tagged union: a union with one variant and one payload
-- is stored as that payload.
union Box[T]:
    Boxed(T)
    Empty


pure func box(value: String) -> Box[String]:
    Boxed(value)


func main(arguments: List[String]) -> Int:
    unused = box(42.to_string())

    match (
        arguments
            .length()
            .equals(1)
    ):
        True: 7
        False: 9
