import:
    int as int_ops
    list as list_ops: sort_by
    string as string_ops


pure func integer_key(value: Int) -> Int:
    value


pure func integer_text(value: Int) -> String:
    int_ops.to_string(value)


pure func nested_key(value: List[String]) -> Int:
    list_ops.length(value)


pure func forwarded_sort[T](values: List[T], key: pure (T) -> Int) -> List[T]:
    list_ops.sort_by(values, key)


private pure func descending_values(start: Int, count: Int) -> List[Int]:
    match int_ops.equals(count, 1):
        True:
            [start]
        False:
            first_count = int_ops.divide(count, 2)
            high = descending_values(
                int_ops.add(start, first_count),
                int_ops.subtract(count, first_count),
            )
            low = descending_values(start, first_count)
            list_ops.concat(high, low)


private pure func nested_temporary() -> List[List[String]]:
    values: List[List[String]] = [
        [string_ops.add("é", "\0"), "first"],
        ["single"],
        ["two", "later"],
    ]
    forwarded_sort(values, nested_key)


private pure func nested_at(values: List[List[String]], index: Int) -> String:
    match list_ops.get(values, index):
        Some(value): list_ops.join(value, "|")
        None: "missing"


func main() -> Int:
    descending = descending_values(0, 256)
    original = descending
    ascending = forwarded_sort(descending, integer_key)
    print(list_ops.join(list_ops.map(ascending, integer_text), ","))
    print(list_ops.join(list_ops.map(original, integer_text), ","))
    values: List[List[String]] = [
        [string_ops.add("é", "\0"), "first"],
        ["single"],
        ["two", "later"],
    ]
    original_values = values
    ordered = values.sort_by(nested_key)
    print(nested_at(ordered, 0))
    print(nested_at(ordered, 1))
    print(nested_at(ordered, 2))
    print(nested_at(original_values, 0))
    escaped = nested_temporary()
    print(nested_at(escaped, 0))
    print(nested_at(escaped, 1))
    print(nested_at(escaped, 2))
    0
