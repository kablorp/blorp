-- An erasure test: Box has one variant and one payload, so it is stored as
-- that payload.
union Box[T]:
    Boxed(T)


pure func box[T](value: T) -> Box[T]:
    Boxed(value)


pure func unbox[T](value: Box[T]) -> T:
    match value:
        Boxed(payload): payload


pure func identity[T](value: T) -> T:
    value


pure func forward[Item](value: Item) -> Item:
    identity(value)


func main() -> Int:
    original = box(7).forward()
    other = box(42)
    unbox(original.identity())
