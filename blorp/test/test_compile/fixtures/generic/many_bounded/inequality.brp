-- Forty bounded `!=` functions beside hello. Each `!=` on a type parameter
-- reaches every Equatable implementation through the trait default, so
-- its compile ceiling holds checking to linear cost in their number.
func main() -> Int:
    print("Hello, World!")
    0


pure func differ_0[E: Equatable](a: E, b: E) -> Bool:
    a != b


pure func differ_1[E: Equatable](a: E, b: E) -> Bool:
    a != b


