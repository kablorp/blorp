-- Forty bounded `==` functions beside hello. Each `==` on a type parameter
-- adds a dependency on every Equatable implementation, so its compile
-- ceiling holds the growth check to linear cost in their number.
func main() -> Int:
    print("Hello, World!")
    0


pure func same_0[E: Equatable](a: E, b: E) -> Bool:
    a == b


pure func same_1[E: Equatable](a: E, b: E) -> Bool:
    a == b


