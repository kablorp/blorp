-- Empty keeps Tagged a tagged union: a union with one variant and one payload
-- is stored as that payload.
union Tagged[T]:
    Number(Int)
    Empty


pure func build() -> Tagged[String]:
    Number(7)


pure func read[Item](value: Tagged[Item]) -> Int:
    match value:
        Number(payload): payload
        Empty: 0


func main() -> Int:
    read(build())
