union Box[T]:
    Boxed(T)


pure func box[T](value: T) -> Box[T]:
    Boxed(value)


pure func unbox[T](value: Box[T]) -> T:
    match value:
        Boxed(payload): payload


pure func read(
    value: Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Int]]]]]]]]]]]]]]]]]]]]
) -> Int:
    value
        .unbox()
        .unbox()
        .unbox()
        .unbox()
        .unbox()
        .unbox()
        .unbox()
        .unbox()
        .unbox()
        .unbox()
        .unbox()
        .unbox()
        .unbox()
        .unbox()
        .unbox()
        .unbox()
        .unbox()
        .unbox()
        .unbox()
        .unbox()


func main() -> Int:
    read(
        box(
            box(
                box(
                    box(
                        box(
                            box(
                                box(
                                    box(
                                        box(
                                            box(
                                                box(box(box(box(box(box(box(box(box(box(7))))))))))
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )
