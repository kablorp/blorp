union Box[T]:
    Boxed(T)


pure func box[T](value: T) -> Box[T]:
    Boxed(value)


pure func unbox[T](value: Box[T]) -> T:
    match value:
        Boxed(payload): payload


record Pair {
    first: Int,
    second: Int
}


pure func pair() -> Pair:
    { second = 9, first = 7 }


func main() -> Int:
    unbox(box(pair())).second
