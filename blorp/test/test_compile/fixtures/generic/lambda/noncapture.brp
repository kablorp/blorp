import:
    int as int_ops


pure func apply[T, U](f: pure (T) -> U, value: T) -> U:
    f(value)


func main() -> Int:
    first = apply(pure func(number): int_ops.add(number, 1), 7)
    second = apply(
        pure func(number: Int) -> Int:
            int_ops.add(number, 1)
        ,
        33,
    )
    looped = apply(
        pure func(number: Int) -> Int:
            var again: Bool = True
            var current = number
            while again:
                current = int_ops.add(current, 1)
                again = False
            current
        ,
        2,
    )
    match int_ops.equals(looped, 3):
        True: int_ops.add(first, second)
        False: 1
