import:
    int: add
    ./operations as ops: increment


pure func compose(value: Int, f: pure (Int) -> Int, g: pure (Int) -> Int) -> Int:
    f(g(value))


pure func forward(value: Int, f: pure (Int) -> Int, g: pure (Int) -> Int) -> Int:
    compose(value, f, g)


pure func binary(f: pure (Int, Int) -> Int) -> Int:
    f(20, 22)


func main() -> Void:
    print(forward(3, increment, ops.double).to_string())
    print(forward(3, ops.double, increment).to_string())
    print(forward(3, increment, ops.double).to_string())
    print(binary(add).to_string())
