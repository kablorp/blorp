-- Bytes: construction, access, clamped slices, prefixes, concatenation,
-- equality, use as a Dict key, and decoding to text.
import:
    bytes: Bytes, from_list, String methods
    dict as dict_ops
    option: Option methods


pure func show(data: Bytes) -> String:
    var text = "["
    for value in data.to_list():
        text = text + " " + value.to_string()
    text + " ]"


pure func show_option(value: Option[UInt8]) -> String:
    match value:
        Some(byte): "Some(${byte})"
        None: "None"


pure func show_text(value: Option[String]) -> String:
    match value:
        Some(text): "Some(${text})"
        None: "None"


pure func yes_no(value: Bool) -> String:
    match value:
        True: "yes"
        False: "no"


func access() -> Void:
    data = from_list([0, 255, 72, 105])
    print(
        "length ${data.length()} empty ${yes_no(data.is_empty())} ${yes_no(from_list([]).is_empty())}",
    )
    print(
        "get ${show_option(data.get(1))} ${show_option(data.get(4))} ${show_option(data.get(-1))}",
    )
    print("get_or ${data.get_or(1, 7)} ${data.get_or(9, 7)}")
    print("to_list ${data.to_list().length()} ${data.to_list().get_or(2, 0)}")


func slices() -> Void:
    data = from_list([10, 20, 30, 40])
    print("slice ${show(data.slice(1, 3))} ${show(data.slice(0, 4))}")
    print("clamped ${show(data.slice(-5, 2))} ${show(data.slice(2, 99))} ${show(data.slice(7, 9))}")
    print("inverted ${show(data.slice(3, 1))} ${show(data.slice(2, 2))}")


func prefixes() -> Void:
    data = from_list([137, 80, 78, 71])
    print(
        "starts ${yes_no(data.starts_with(from_list([137, 80])))} ${yes_no(data.starts_with(from_list([80])))}",
    )
    print(
        "starts edge ${yes_no(data.starts_with(from_list([])))} ${yes_no(data.starts_with(data))} ${yes_no(from_list([137]).starts_with(data))}",
    )


func combining() -> Void:
    left = from_list([1, 2])
    right = from_list([3])
    joined = left + right
    print(
        "joined ${show(joined)} left ${show(left)} equal ${yes_no(joined == from_list([1, 2, 3]))} ${yes_no(left == right)} ${yes_no(left != right)}",
    )


func keys() -> Void:
    var table: dict_ops.Dict[Bytes, Int] = dict_ops.empty()
    table = table.set(from_list([1, 2]), 10)
    table = table.set(from_list([2, 1]), 20)
    table = table.set(from_list([1, 2]), 30)
    same_hash = from_list([1, 2]).hash() == from_list([1, 2]).hash()
    other_hash = from_list([1, 2]).hash() == from_list([2, 1]).hash()
    print("hash equal ${yes_no(same_hash)} unequal pair ${yes_no(other_hash)}")
    print(
        "dict ${table.length()} ${table.get_or(from_list([1, 2]), 0)} ${table.get_or(from_list([2, 1]), 0)} ${table.get_or(from_list([]), -1)}",
    )


func decoding() -> Void:
    spelled = "Hé\0".to_bytes()
    print("to_bytes ${show(spelled)}")
    print("to_text ${show_text(spelled.to_text())} ${show_text(from_list([0, 255, 72]).to_text())}")
    print("empty ${show_text(from_list([]).to_text())} ${"".to_bytes().length()}")
    -- Each refused input breaks UTF-8 one way; U+1F600 is a valid 4-byte character.
    print("overlong ${show_text(from_list([192, 128]).to_text())}")
    print("surrogate ${show_text(from_list([237, 160, 128]).to_text())}")
    print("above U+10FFFF ${show_text(from_list([244, 144, 128, 128]).to_text())}")
    print("lone continuation ${show_text(from_list([128]).to_text())}")
    print("truncated ${show_text(from_list([226, 130]).to_text())}")
    print("four bytes ${show_text(from_list([240, 159, 152, 128]).to_text())}")


func main() -> Int:
    access()
    slices()
    prefixes()
    combining()
    keys()
    decoding()
    0
