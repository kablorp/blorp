-- A binary file round trip through write_bytes and read_bytes, and the errors
-- read_bytes shares with read_text. The first argument names a directory where
-- the program may write.
import:
    bytes: Bytes, from_list
    io/fs/read: ReadError, read_bytes, read_text
    io/fs/write: write_bytes
    list: get
    option: Option methods
    path: Path, join, to_path


pure func yes_no(value: Bool) -> String:
    match value:
        True: "yes"
        False: "no"


-- Every byte value, with NUL and 0xFF in the middle and at both ends.
pure func payload() -> Bytes:
    var values: List[UInt8] = [0, 255, 72, 105, 0, 128, 255]
    for value in 0..256:
        values = values.append(
            value
                .to_uint8()
                .get_or(0),
        )
    from_list(values)


func round_trip(directory: Path) -> Void:
    match "round_trip.bin".to_path():
        Err(error):
            print("path ${error}")
        Ok(child):
            path = join(directory, child)
            match write_bytes(path, payload()):
                Err(error): print("write failed ${error}")
                Ok(_): print("write ok")
            match read_bytes(path):
                Err(error):
                    print("read failed ${error}")
                Ok(data):
                    print("read ${data.length()} bytes, identical ${yes_no(data == payload())}")
            match write_bytes(path, from_list([])):
                Err(error): print("rewrite failed ${error}")
                Ok(_): print("rewrite ok")
            match read_bytes(path):
                Err(error): print("read failed ${error}")
                Ok(data): print("empty ${data.length()} bytes")


-- The same failure as read_text, since both decode the native's code.
func same_error(path: Path, label: String) -> Void:
    match (read_bytes(path), read_text(path)):
        (Err(bytes_error), Err(text_error)):
            print(
                "${label} ${bytes_error} / ${text_error} same ${yes_no(bytes_error == text_error)}",
            )
        _:
            print("${label} unexpected success")


func main(arguments: List[String]) -> Int:
    match arguments.get(1):
        None:
            print("missing directory")
            2
        Some(text):
            match text.to_path():
                Err(error):
                    print("path ${error}")
                    2
                Ok(directory):
                    round_trip(directory)
                    match "missing.bin".to_path():
                        Ok(child): same_error(join(directory, child), "missing")
                        Err(error): print("path ${error}")
                    same_error(directory, "directory")
                    0
