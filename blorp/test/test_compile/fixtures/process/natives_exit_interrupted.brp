-- A program that calls only process.exit_interrupted must still build as valid C under
-- -Werror. Calling it would end this program by SIGINT, so it is called only with an
-- argument, which this run does not pass.
func interrupt_native() -> Result[Void, Int]:
    builtin("process.exit_interrupted")


func main(arguments: List[String]) -> Int:
    if arguments.length() > 1:
        match interrupt_native():
            Ok(_): print("returned")
            Err(code): print(code.to_string())
    else:
        print("not called")
    0
