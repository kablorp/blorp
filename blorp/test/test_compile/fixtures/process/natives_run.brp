-- A program that calls only process.run must still build as valid C under -Werror, so
-- this declares the builtin directly. The missing program is LaunchFailed(NotFound):
-- fs's code 1 times 16 plus tag 1.
func run_native(
    program: String,
    arguments: List[String],
    directory: List[String],
    environment: List[String],
) -> Result[Int, Int]:
    builtin("process.run")


func main() -> Int:
    match run_native("/nonexistent/blorp-program", [], [], []):
        Ok(ended): print(ended.to_string())
        Err(code): print(code.to_string())
    0
