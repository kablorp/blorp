-- A program that runs itself as a child. The child prints a line, which stays buffered, and
-- calls exit_interrupted, so the line must still arrive and the child ends by SIGINT: the
-- parent reports Signaled(INTERRUPT_SIGNAL) after it.
import:
    io/terminal:
        INTERRUPT_SIGNAL,
        RunExit(Exited, Signaled),
        exit_interrupted,
        run,
        terminal_command,
    path: to_path


func main(arguments: List[String]) -> Int:
    if arguments.length() > 1:
        print("child line")
        exit_interrupted()
        2
    else:
        print("parent line")
        match (
            arguments
                .get_or(0, "")
                .to_path()
        ):
            Err(_):
                1
            Ok(itself):
                match run(terminal_command(itself, ["child"])):
                    Ok(Signaled(signal)):
                        print("signaled ${signal}")
                        if signal == INTERRUPT_SIGNAL:
                            0
                        else:
                            1
                    Ok(Exited(status)):
                        print("exited ${status}")
                        1
                    Err(error):
                        print_error("${error}")
                        1
