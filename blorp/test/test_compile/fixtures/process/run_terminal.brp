-- A program that runs a child on its own stdout, which the driver captures: the line
-- printed before the call comes before the child's, and the one after comes last.
import:
    io/terminal: RunExit(Exited, Signaled), run, terminal_command
    path: to_path


func main() -> Int:
    print("before")
    match "/bin/echo".to_path():
        Err(_):
            1
        Ok(echo):
            match run(terminal_command(echo, ["child"])):
                Ok(Exited(status)):
                    print("after ${status}")
                    status
                Ok(Signaled(signal)):
                    print("signaled ${signal}")
                    1
                Err(error):
                    print_error("${error}")
                    1
