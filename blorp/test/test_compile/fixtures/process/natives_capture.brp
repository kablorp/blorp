-- A program that calls one native and nothing else from process must still
-- build as valid C under -Werror, so this declares the builtin directly. The
-- missing program is LaunchFailed(NotFound): fs's code 1 times 16 plus tag 1.
-- A timeout of 0 replies TimedOut, kind 2 times 256, without starting anything.
func capture_native(
    program: String,
    arguments: List[String],
    directory: List[String],
    environment: List[String],
    stdin: List[String],
    timeout_ms: Int,
) -> Result[List[String], Int]:
    builtin("process.capture")


func main() -> Int:
    missing = match capture_native("/nonexistent/blorp-program", [], [], [], [], -1):
        Ok(_): "started"
        Err(code): code.to_string()
    print(missing)
    match capture_native("/nonexistent/blorp-program", [], [], [], [], 0):
        Ok(reply):
            print(reply.get_or(0, "none"))
            0
        Err(code):
            print(code.to_string())
            1
