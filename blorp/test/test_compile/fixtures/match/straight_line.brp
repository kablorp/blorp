-- Matches on erased unions, whose one arm lower continues in line: in loops
-- with carried vars and arms that break and continue, in a closure, in a
-- self-tail loop and in tasks.
import:
    io/console/output: print


union Stem:
    Underlying(String)


union Counter:
    Underlying(Int)


pure func total_length(stems: List[Stem]) -> Int:
    var total = 0

    for stem in stems:
        match stem:
            Stem.Underlying(text): total = total + text.length()

    total


pure func first_long(stems: List[Stem]) -> String:
    var found = ""

    for stem in stems:
        match stem:
            Stem.Underlying(text):
                if text.length() > 2:
                    found = text
                    break
                else:
                    continue

    found


pure func suffixer(stem: Stem) -> pure (String) -> String:
    text = match stem:
        Stem.Underlying(found): found

    pure func(other: String) -> String: other + text


@tail_recursive
pure func countdown(counter: Counter, total: Int) -> Int:
    remaining = match counter:
        Counter.Underlying(value): value

    match remaining == 0:
        True: total
        False: countdown(Counter.Underlying(remaining - 1), total + 2)


pure func both(left: Stem, right: Stem) -> Int:
    concurrent:
        first = match left:
            Stem.Underlying(text): text.length()

        second = match right:
            Stem.Underlying(text): text.length()

    first + second


func main():
    stems = [
        Stem.Underlying("a"),
        Stem.Underlying("bcd"),
        Stem.Underlying(""),
        Stem.Underlying("efgh")
    ]

    suffix = suffixer(Stem.Underlying("tail"))
    print("${total_length(stems)} ${first_long(stems)} ${suffix("head-")}")

    print(
        "${countdown(Counter.Underlying(5), 0)} ${both(Stem.Underlying("abc"), Stem.Underlying("de"))}"
    )
