import:
    list: get
    path: Path, join, to_path


pure func combine(base: Path, child: Path) -> Path:
    join(base, child)


-- Exit 2 for anything that is not two paths: the usage error, or the reason
-- an operand is no path.
func main(args: List[String]) -> Int:
    match (get(args, 1), get(args, 2)):
        (Some(base_text), Some(child_text)):
            match to_path(base_text):
                Err(error):
                    print("${error}")
                    2
                Ok(base):
                    match to_path(child_text):
                        Err(error):
                            print("${error}")
                            2
                        Ok(child):
                            print("${combine(base, child)}")
                            0
        _:
            2
