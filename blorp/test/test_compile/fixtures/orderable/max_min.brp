-- Orders by rank alone, so two Cards of one rank are equal and differ by suit,
-- which shows which argument max and min return.
record Card {
    rank: Int,
    suit: String,
}


implements Orderable for Card:
    pure func less_than(left: Self, right: Self) -> Bool:
        left.rank < right.rank


func main() -> Int:
    low: Card = { rank = 2, suit = "first" }
    same: Card = { rank = 2, suit = "second" }
    high: Card = { rank = 9, suit = "high" }
    print("int: ${max(3, 8)} ${3.max(8)} ${min(3, 8)} ${3.min(8)} ${max(-1, -5)} ${(-1).min(-5)}")
    print("float: ${max(1.5, 0.5)} ${1.5.min(0.5)} ${min(-0.0, 0.0)} ${max(0.0, -0.0)}")
    print(
        "equal: ${max(low, same).suit} ${low.max(same).suit} ${min(low, same).suit} ${low.min(same).suit}",
    )
    print("user: ${max(low, high).suit} ${high.min(low).suit}")
    print("lists: ${max([1, 2], [1, 3]) == [1, 3]} ${min([1], [1, 2]) == [1]}")
    0
