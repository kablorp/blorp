opaque type Box[V] = V


union U:
    A(Box[U], Box[U])
    B


pure func size(value: U) -> Int:
    match value:
        B: 1
        A(left, right): size(from_opaque Box(left)) + size(from_opaque Box(right))


func main() -> Int:
    leaf: U = B
    pair: U = A(into_opaque Box(leaf), into_opaque Box(leaf))
    size(A(into_opaque Box(leaf), into_opaque Box(pair)))
