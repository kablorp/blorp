opaque type Maybe[V] = Option[V]


union U:
    A(Maybe[U])
    B


pure func depth(value: U) -> Int:
    match value:
        B:
            0
        A(inner):
            match from_opaque Maybe(inner):
                Some(next): 1 + next.depth()
                None: 1


func main() -> Int:
    depth(A(into_opaque Maybe(Some(A(into_opaque Maybe(None))))))
