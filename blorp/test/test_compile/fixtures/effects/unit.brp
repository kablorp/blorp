-- Spare keeps Box a tagged union: a union with one variant and one payload
-- is stored as that payload.
union Box[T]:
    Boxed(T)
    Spare(T)


func identity[T](value: T) -> T:
    value


pure func boxed[T](value: T) -> Box[T]:
    Boxed(value)


func unbox[T](value: Box[T]) -> T:
    match value:
        Boxed(item): item
        Spare(item): item


func unit(value: Void) -> Void:
    var current = identity(value)
    current = unbox(boxed(void))
    current


func main() -> Int:
    unit(void)
    0
