trait Logger:
    func log(self: Self, text: String) -> Void
    func log_all(self: Self, lines: List[String]) -> Void:
        for line in lines:
            self.log(line)
        void


record Console {
    prefix: String,
}


implements Logger for Console:
    func log(self: Self, text: String) -> Void:
        print("${self.prefix}${text}")


record Quiet {
    count: Int,
}


implements Logger for Quiet:
    func log(self: Self, text: String) -> Void:
        print(text)

    func log_all(self: Self, lines: List[String]) -> Void:
        print("quiet ${lines.length()}")


func main() -> Int:
    console: Console = { prefix = "> " }
    console.log_all(["first", "second"])
    quiet: Quiet = { count = 0 }
    quiet.log_all(["first", "second"])
    quiet.log("last")
    0
