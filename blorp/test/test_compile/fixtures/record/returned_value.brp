import:
    int: Int methods
    list: List methods


-- A scanner result returned and taken apart at once, the lexer's SkippedLines
-- shape: one counted field, so the record is a value and allocates nothing.
record Skipped {
    comments: List[Int],
    end: Int
}


pure func skip(comments: List[Int], start: Int) -> Skipped:
    { comments = comments, end = start + 3 }


func main() -> Int:
    comments: List[Int] = [1, 2]
    var total = 0
    for index in 0..1000:
        skipped = skip(comments, index)
        total = total + skipped.end + skipped.comments.length()
    total % 256
