import:
    int: Int methods
    list: List methods
    string: String methods


-- A record with one String is a value: copies share the String, a List holds
-- the records themselves, and a closure captures one by value.
record Named {
    name: String,
    count: Int
}


pure func renamed(item: Named, name: String) -> Named:
    { item | name = name }


pure func weight(item: Named) -> Int:
    item.count + item.name.length()


pure func total(items: List[Named]) -> Int:
    var sum = 0

    for item in items:
        sum = sum + weight(item)

    sum


func main() -> Int:
    first: Named = { name = "one", count = 1 }
    copy = first
    second = renamed(copy, "second")
    items: List[Named] = [first, second, copy]
    weigh: pure (Int) -> Int = pure func(extra: Int) -> Int: weight(second) + extra
    print("${first.name} ${second.name} ${items.length()}")
    total(items) + weigh(0)
