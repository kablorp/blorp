import:
    float as float_ops
    int as int_ops
    list as lists
    string as string_ops


record Point {
    value: Int,
}


record Tagged {
    tag: Int,
    detail: Int,
}


implements Equatable for Tagged:
    pure func equals(left: Self, right: Self) -> Bool:
        int_ops.equals(left.tag, right.tag)


pure func is_seven(value: Int) -> Bool:
    int_ops.equals(value, 7)


pure func member[Element: Equatable](values: List[Element], needle: Element) -> Bool:
    lists.contains(values, needle)


func produce_needle() -> Int:
    print("needle")
    7


func main() -> Int:
    first: Point = { value = 7 }
    same: Point = { value = 7 }
    tagged: Tagged = { tag = 7, detail = 1 }
    same_tag: Tagged = { tag = 7, detail = 9 }
    nested: List[List[Int]] = [[1, 2], [3]]
    empty_left: List[Int] = []
    empty_right: List[Int] = []
    infinity = float_ops.multiply(1.0e308, 1.0e308)
    nan = float_ops.subtract(infinity, infinity)
    equal_text: pure (String, String) -> Bool = int_ops.equals
    different_int: pure (Int, Int) -> Bool = string_ops.not_equals
    found_once = lists.contains([7, 9], produce_needle())
    results = [
        member([1, 7], 7),
        lists.contains(["first", "kept"], "kept"),
        lists.contains([first], same),
        lists.contains([tagged], same_tag),
        lists.contains(nested, [1, 2]),
        lists.any([7], is_seven),
        int_ops.not_equals(lists.any([9], is_seven), True),
        int_ops.equals("family", "family"),
        string_ops.equals(7, 7),
        float_ops.is_nan(nan),
        float_ops.not_equals(nan, nan),
        found_once,
        equal_text("stored", "stored"),
        different_int(7, 9),
        int_ops.equals(empty_left, empty_right),
        int_ops.not_equals([1], [1, 2]),
        int_ops.not_equals([1, 2], [9, 2]),
        int_ops.not_equals([1, 2], [1, 9]),
        int_ops.not_equals(lists.contains(nested, [1, 9]), True),
    ]
    match results:
        [True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True]:
            23
        _:
            0
