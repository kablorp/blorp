import:
    int: Int methods
    io/console: print
    ./token: Token, token_value, with_token


-- Token is Self of an authored method and of a default it inherits; both
-- run on the loan inside its scope.
trait Counted:
    func count(self: Self) -> Int
    func report(self: Self, label: String) -> Void:
        print("${label} ${self.count().to_string()}")


implements Counted for Token:
    func count(self: Self) -> Int:
        token_value(self)


func main() -> Int:
    outcome: Result[Int, String] = with_token(5, func(token: Token) -> Result[Int, String]:
        token.report("count")
        Ok(token.count() + 1)
    )
    match outcome:
        Ok(value): print("ok ${value.to_string()}")
        Err(error): print("unexpected ${error}")
    0
