import:
    int: Int methods
    io/console: print


resource type Token = Int


func token_value(token: Token) -> Int:
    from_opaque Token(token)


-- Only this module constructs the loan. It keeps the raw value for cleanup,
-- and passes the wrapped value directly to the synchronous callback.
func with_token[T, E](value: Int, body: scoped (Token) -> Result[T, E]) -> Result[T, E]:
    print("enter ${value.to_string()}")
    outcome = body(into_opaque Token(value))
    print("release ${value.to_string()}")
    outcome
