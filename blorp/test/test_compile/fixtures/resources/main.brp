import:
    int: Int methods
    io/console: print
    ./token: Token, token_value, with_token


func invoke(body: scoped () -> Result[Int, String]) -> Result[Int, String]:
    body()


-- The relay captures a scoped callback; its immutable alias must retain that
-- promise while it is forwarded through another declared scoped parameter.
func forward(body: scoped () -> Result[Int, String]) -> Result[Int, String]:
    relay = func() -> Result[Int, String]: body()
    forwarded_body = relay
    invoke(forwarded_body)


func main() -> Int:
    nested: Result[Int, String] = with_token(7, func(outer: Token) -> Result[Int, String]:
        with_token(11, func(inner: Token) -> Result[Int, String]:
            compute = func() -> Result[Int, String]:
                value = token_value(outer) + token_value(inner)
                print("value ${value.to_string()}")
                Ok(value)
            nested_body = compute
            forward(nested_body)
        )
    )
    match nested:
        Ok(value): print("ok ${value.to_string()}")
        Err(error): print("unexpected ${error}")
    failed: Result[Int, String] = with_token(9, func(_: Token) -> Result[Int, String]:
        print("body error")
        Err("stop")
    )
    match failed:
        Ok(value): print("unexpected ${value.to_string()}")
        Err(error): print("error ${error}")
    0
