-- A record small enough to be stored by value, and a union that reaches itself
-- and is boxed: an opaque type over either derives equality from it.
record Point {
    x: Int,
    y: Int
}


opaque type Cell = Point


union Tree:
    Leaf
    Node(Tree, Int, Tree)


opaque type Shape = Tree


pure func cell(x: Int, y: Int) -> Cell:
    point: Point = { x = x, y = y }
    into_opaque Cell(point)


pure func shape(middle: Int) -> Shape:
    left: Tree = Leaf
    right: Tree = Leaf
    into_opaque Shape(Node(Node(left, 1, right), middle, Node(left, 3, right)))


func main() -> Int:
    results: List[Bool] = [
        cell(1, 2) == cell(1, 2),
        cell(1, 2) == cell(1, 3),
        shape(2) == shape(2),
        shape(2) == shape(5)
    ]

    expected: List[Bool] = [True, False, True, False]

    if results == expected:
        23
    else:
        0
