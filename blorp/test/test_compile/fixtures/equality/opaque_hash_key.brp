import:
    dict as dict_ops: combine_hash


-- Equatable is derived from the representation; only Hashable is written.
opaque type Key = Int


implements Hashable for Key:
    pure func hash(value: Self) -> Int:
        combine_hash(0, from_opaque Key(value))


pure func key(number: Int) -> Key:
    into_opaque Key(number)


func main() -> Int:
    table: Dict[Key, Int] = { key(1) => 10, key(2) => 20 }
    match table.get(key(2)):
        Some(value): value
        None: 0
