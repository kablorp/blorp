record Box[T] {
    value: T,
}


-- Comparing boxes compares a pair of boxes of boxes, one level deeper each time.
implements Equatable for Box[T: Equatable]:
    pure func equals(left: Self, right: Self) -> Bool:
        wider: Box[Box[T]] = { value = left }
        other: Box[Box[T]] = { value = right }
        (wider, 1) == (other, 1)


func main() -> Int:
    0
