opaque type Ticket = Int


opaque type Label = String


opaque type Alias = Ticket


opaque type Queue = List[Ticket]


opaque type Box[T] = List[T]


opaque type Bounded[T: Equatable] = List[T]


opaque type Custom = Int


implements Equatable for Custom:
    pure func equals(left: Self, right: Self) -> Bool:
        False


record Holder {
    ticket: Ticket,
    label: Label
}


pure func ticket(number: Int) -> Ticket:
    into_opaque Ticket(number)


pure func same[T: Equatable](left: T, right: T) -> Bool:
    left == right


func main() -> Int:
    first: Holder = { ticket = ticket(7), label = into_opaque Label("a") }
    second: Holder = { ticket = ticket(7), label = into_opaque Label("a") }
    third: Holder = { ticket = ticket(7), label = into_opaque Label("b") }
    queue = into_opaque Queue([ticket(1), ticket(2)])
    other_queue = into_opaque Queue([ticket(1), ticket(3)])
    boxed: Box[Int] = into_opaque Box([1, 2])
    other_boxed: Box[Int] = into_opaque Box([1, 3])
    bounded: Bounded[Int] = into_opaque Bounded([4])
    nested: Box[Ticket] = into_opaque Box([ticket(5)])
    results = [
        ticket(7) == ticket(7),
        ticket(7) != ticket(9),
        into_opaque Alias(ticket(4)) == into_opaque Alias(ticket(4)),
        first == second,
        first == third,
        same(ticket(2), ticket(2)),
        queue == queue,
        queue == other_queue,
        boxed == boxed,
        boxed == other_boxed,
        bounded == bounded,
        nested == nested,
        into_opaque Custom(1) == into_opaque Custom(1)
    ]
    expected: List[Bool] = [
        True,
        True,
        True,
        True,
        False,
        True,
        True,
        False,
        True,
        False,
        True,
        True,
        False
    ]
    if results == expected:
        23
    else:
        0
