record Marker {
    value: Int
}


implements Equatable for Marker:
    pure func equals(left: Self, right: Self) -> Bool:
        False
    pure func not_equals(left: Self, right: Self) -> Bool:
        False


union Ticket:
    private Underlying(Int)


implements Equatable for Ticket:
    pure func equals(left: Self, right: Self) -> Bool:
        left_number = match left:
            Ticket.Underlying(left_number): left_number

        match right:
            Ticket.Underlying(right_number): left_number == right_number


func main() -> Int:
    marker: Marker = { value = 7 }
    marker_alias = marker
    ticket = Ticket.Underlying(7)
    same_ticket = Ticket.Underlying(7)
    other_ticket = Ticket.Underlying(9)

    results = [
        marker == marker_alias,
        marker != marker_alias,
        ticket == same_ticket,
        ticket != other_ticket
    ]

    match results:
        [False, False, True, True]: 23
        _: 0
