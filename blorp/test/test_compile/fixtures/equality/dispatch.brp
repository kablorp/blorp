record Marker {
    value: Int
}


implements Equatable for Marker:
    pure func equals(left: Self, right: Self) -> Bool:
        False
    pure func not_equals(left: Self, right: Self) -> Bool:
        False


union Ticket:
    private Init(Int)


implements Equatable for Ticket:
    pure func equals(left: Self, right: Self) -> Bool:
        Ticket.Init(left_number) = left
        Ticket.Init(right_number) = right
        left_number == right_number


func main() -> Int:
    marker: Marker = { value = 7 }
    marker_alias = marker
    ticket = Ticket.Init(7)
    same_ticket = Ticket.Init(7)
    other_ticket = Ticket.Init(9)

    results = [
        marker == marker_alias,
        marker != marker_alias,
        ticket == same_ticket,
        ticket != other_ticket
    ]

    match results:
        [False, False, True, True]: 23
        _: 0
