-- Native cases and rejections for Dict: key order, replacement and removal,
-- written and automatic Hashable keys, literals, and the cost of building,
-- churning and searching large Dicts. Each program compiles once within its
-- ceiling, then runs once per case with exact stdout, status and strict
-- allocation counts. Rejections check the exact diagnostic.
import:
    test: TestSuite
    ../driver/harness:
        Program,
        Rejection,
        once,
        prints,
        repeated,
        reported,
        verify_program,
        verify_rejection,


private DICT_INT_KEYS_OUTPUT: String = "empty keys  values  length 0 true\nset keys 5,1,9 values e,a,i length 3\nreplace keys 5,1,9 values e,A,i length 3\nremove keys 1,9 values A,i length 2\nset again keys 1,9,5 values A,i,E length 3\nentries 1=A 9=i 5=E\nmissing none false keys 1,9,5 values A,i,E length 3\npresent i true\norder ignored true false false\ncopy keys 1,9,5 values A,i,E length 3\noriginal keys 1,5 values changed,E length 2\n"


private DICT_STRING_KEYS_OUTPUT: String = "empty keys  values  length 0 true\nset keys pear,apple,fig values 5,1,9 length 3\nreplace keys pear,apple,fig values 5,11,9 length 3\nremove keys apple,fig values 11,9 length 2\nset again keys apple,fig,pear values 11,9,50 length 3\nentries apple=11 fig=9 pear=50\nmissing -1 false keys apple,fig,pear values 11,9,50 length 3\nprefix and case differ false false false\norder ignored true false false\ncopy keys apple,fig,pear values 11,9,50 length 3\noriginal keys apple,pear values 0,50 length 2\n"


private DICT_CASE_INSENSITIVE_KEYS_OUTPUT: String = "set keys Apple,pear,FIG values 1,2,3 length 3\nreplace keeps position and first spelling keys Apple,pear,FIG values 10,20,3 length 3\nlookup 10 3 false\nremove keys Apple,FIG values 10,3 length 2\nset again goes last with the new spelling keys Apple,FIG,pEaR values 10,3,5 length 3\nmissing -1 keys Apple,FIG,pEaR values 10,3,5 length 3\nequality ignores order and case true false\ncopy keys Apple,FIG,pEaR values 10,3,5 length 3\noriginal keys FIG,pEaR values 0,5 length 2\n"


private DICT_RECORD_KEYS_OUTPUT: String = "swapped fields hash apart true\nswapped fields are different keys keys 1:2,2:1,1:3 values 12,21,13 length 3\na Hashable bound provides == true false\nreplace keeps position keys 1:2,2:1,1:3 values 12,210,13 length 3\nlookup 12 210 -1 false\nremove keys 2:1,1:3 values 210,13 length 2\nunion keys 2 5 2 -1\n"


private DICT_LITERALS_OUTPUT: String = "empty keys  values  length 0 true\nint keys 5,1,9 values e,a,i length 3\nrepeated keys alice,bob values 99,80 length 2 alice 99\ncase-insensitive keys Apple,pear values 3,2 3\nnested a,b keys x,y values 1,2 length 2 keys  values  length 0\nequal to calls true false false\n"


func suite(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
) -> TestSuite:
    run_program = func(program: Program) -> Bool: reported(
        verify_program(compiler, c_compiler, work_directory, check_instructions, program),
    )
    hashable_without_equality: Rejection = {
        name = "dict_hashable_without_equality",
        source = "blorp/test/test_compile/fixtures/dict/hashable_without_equality.brp",
        diagnostic = ":4:12: error: implementing Hashable for Token requires an implementation of Equatable\nhelp: add implements Equatable for Token\n",
    }
    hashable_callable_field: Rejection = {
        name = "dict_hashable_callable_field",
        source = "blorp/test/test_compile/fixtures/dict/hashable_callable_field.brp",
        diagnostic = ":6:12: error: implementing Hashable for Handler requires an implementation of Equatable\nhelp: provide the member's required trait implementation, or write an Equatable implementation for the containing type\nblorp/test/test_compile/fixtures/dict/hashable_callable_field.brp:2:10: note: record field declared here\n",
    }
    removed_dict_key: Rejection = {
        name = "dict_removed_dict_key",
        source = "blorp/test/test_compile/fixtures/dict/removed_dict_key.brp",
        diagnostic = ":2:11: error: module dict declares no public function or type DictKey\nhelp: select a public function or type that dict declares\n",
    }
    non_dict_key: Rejection = {
        name = "dict_non_dict_key",
        source = "blorp/test/test_compile/fixtures/dict/non_dict_key.brp",
        diagnostic = ":12:27: error: Dict[Point, Int] requires Point: Hashable\nhelp: implement Hashable for Point, or use a type that implements it\n",
    }
    {
        description = "Blorp dict",
        tests = [
            (
                "Int keys keep insertion order through replace, remove and set again, and copies are unchanged",
                func(): run_program(
                    prints(
                        "dict_int_keys",
                        "dict/int_keys",
                        { allocations = 189132, instructions = 663351264 },
                        DICT_INT_KEYS_OUTPUT,
                        165,
                    ),
                ),
            ),
            (
                "String keys keep insertion order, tell prefixes and case apart, and copies are unchanged",
                func(): run_program(
                    prints(
                        "dict_string_keys",
                        "dict/string_keys",
                        { allocations = 191914, instructions = 681664387 },
                        DICT_STRING_KEYS_OUTPUT,
                        176,
                    ),
                ),
            ),
            (
                "a case-insensitive opaque key with written Equatable and Hashable keeps its first spelling",
                func(): run_program(
                    prints(
                        "dict_case_insensitive_keys",
                        "dict/case_insensitive_keys",
                        { allocations = 193022, instructions = 684607648 },
                        DICT_CASE_INSENSITIVE_KEYS_OUTPUT,
                        153,
                    ),
                ),
            ),
            (
                "a record key and a union key with written Hashable and automatic equality tell swapped fields apart",
                func(): run_program(
                    prints(
                        "dict_record_keys",
                        "dict/record_keys",
                        { allocations = 201782, instructions = 712341861 },
                        DICT_RECORD_KEYS_OUTPUT,
                        99,
                    ),
                ),
            ),
            (
                "remove rebuilds only when dead entries outnumber live ones and reach the minimum",
                func(): run_program(
                    prints(
                        "dict_compaction_boundary",
                        "dict/compaction_boundary",
                        { allocations = 151777, instructions = 572842872 },
                        "8 1 2\n",
                        102,
                    ),
                ),
            ),
            (
                "remove-then-set churn on 10 live keys stays within 2.6 allocations per cycle",
                func(): run_program(
                    prints(
                        "dict_churn_small",
                        "dict/churn_small",
                        { allocations = 159910, instructions = 595106113 },
                        "10 5000 5009\n15000 -1 15027\n",
                        12531,
                    ),
                ),
            ),
            (
                "remove-then-set churn on 1,000 live keys allocates about twice per cycle",
                func(): run_program(
                    prints(
                        "dict_churn_large",
                        "dict/churn_large",
                        { allocations = 159910, instructions = 591518415 },
                        "1000 5000 5999\n15000 -1 17997\n",
                        11121,
                    ),
                ),
            ),
            (
                "building 65,536 keys allocates once per key",
                func(): run_program(
                    prints(
                        "dict_linear_build",
                        "dict/linear_build",
                        { allocations = 149929, instructions = 564880763 },
                        "65536 2147516416 65536\n",
                        65616,
                    ),
                ),
            ),
            (
                "100,000 absent sequential keys are found missing within the native timeout",
                func(): run_program(
                    prints(
                        "dict_absent_sequential",
                        "dict/absent_sequential_keys",
                        { allocations = 149128, instructions = 564495828 },
                        "10000 0\n",
                        10063,
                    ),
                ),
            ),
            (
                "a Dict over a key type without Hashable is rejected where the type is written",
                func(): reported(verify_rejection(compiler, work_directory, non_dict_key)),
            ),
            (
                "Hashable requires Equatable: an opaque key without equality is rejected",
                func(): reported(
                    verify_rejection(compiler, work_directory, hashable_without_equality),
                ),
            ),
            (
                "Hashable requires Equatable: a record with a callable field is rejected",
                func(): reported(
                    verify_rejection(compiler, work_directory, hashable_callable_field),
                ),
            ),
            (
                "the retired dict-key bundle is an unknown name through the dict module",
                func(): reported(verify_rejection(compiler, work_directory, removed_dict_key)),
            ),
            (
                "Dict literals: {} by annotation, Int, String and opaque keys, repeated keys, nesting and equality with calls",
                func(): run_program(
                    prints(
                        "dict_literals",
                        "dict/literals",
                        { allocations = 254004, instructions = 830748305 },
                        DICT_LITERALS_OUTPUT,
                        166,
                    ),
                ),
            ),
            (
                "a Dict literal evaluates left to right, each key before its value",
                func(): run_program(
                    prints(
                        "dict_literal_order",
                        "dict/literal_order",
                        { allocations = 155385, instructions = 579532234 },
                        "key 1\nvalue 1\nkey 2\nvalue 2\nkey 3\nvalue 3\n1,2 30,20\n",
                        26,
                    ),
                ),
            ),
            -- The literal and its written call chain pin the same allocations.
            (
                "a Dict literal allocates what its written dict and set chain does",
                func(): run_program(
                    prints(
                        "dict_literal_cost",
                        "dict/literal_cost",
                        { allocations = 147169, instructions = 556157569 },
                        "500\n",
                        1001,
                    ),
                ),
            ),
            (
                "the written chain behind the Dict literal cost pin",
                func(): run_program(
                    prints(
                        "dict_call_chain_cost",
                        "dict/call_chain_cost",
                        { allocations = 147404, instructions = 558078165 },
                        "500\n",
                        1001,
                    ),
                ),
            ),
        ],
    }
