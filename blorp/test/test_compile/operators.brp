-- Native cases for the arithmetic and ordering operators and the traits they
-- call: Orderable and max and min, the arithmetic traits and their canonical
-- members, evaluation order and deep nesting, and supertrait entailment through
-- bounds, bundles and generic receivers. Each program compiles once within its
-- ceiling, then runs once per case with exact stdout, status and strict
-- allocation counts.
import:
    test: TestSuite
    ../driver/harness: Program, exits_with, fixture_program, once, prints, reported, verify_program


-- Expected outputs too long to read inside the test table.
private ARITHMETIC_TRAITS_OUTPUT: String = "42\n-9223372036854775808\n9223372036854775807\n-42\n-3\n-1\n0\n0\n-9223372036854775808\n0\n-5\n-9223372036854775808\n3.75\n-1.5\n-3\n3.5\n-1.5\n0\n0\n0\n-2.5\n-inf\n-1\n1\nconcat\n12\nabababababababab\n"


private ARITHMETIC_CHECKED_OUTPUT: String = "add 42, -1, overflow, 9223372036854775807, overflow, overflow, -9223372036854775808\nsubtract -2, overflow, -9223372036854775808, -9223372036854775808, overflow, overflow, 9223372036854775807\nmultiply -42, 0, 0, -9223372036854775808, overflow, overflow, -9223372036854775807, overflow, -9223372036854775808, overflow, 9223372030926249001, overflow, overflow\ndivide -3, division by zero, -9223372036854775808, overflow, -9223372036854775807\nremainder -1, division by zero, 0\nnegate -5, 0, -9223372036854775807, overflow\nmethod overflow, 42\n"


private ARITHMETIC_OPERATORS_OUTPUT: String = "9 5 14 3 1 -7\n-5 -9 -14 -3 -1 7\n9 5 14 3 1 -7\n9.5 5.5 15 3.75 1.5 -7.5\n-5.5 -9.5 -15 -3.75 -1.5 7.5\n9.5 5.5 15 3.75 1.5 -7.5\n-9223372036854775808 9223372036854775807 -2 -9223372036854775808\n0 0 0 0\n-9223372036854775808 0\n-0 -0 0\n5 2 14 -6 4\nab\nabab\nmarker 34\n"


func suite(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
) -> TestSuite:
    run_program = func(program: Program) -> Bool: reported(
        verify_program(compiler, c_compiler, work_directory, check_instructions, program),
    )
    {
        description = "Blorp arithmetic and ordering operators",
        tests = [
            (
                "Int and Float order through Orderable, NaN comparing false",
                func(): run_program(
                    prints(
                        "orderable",
                        "orderable/int_float",
                        { allocations = 134374, instructions = 539972408 },
                        "1010\n0011\n0101\n1010\n0011\n0011\n1010\n0000\n0000\n0000\n0011\n",
                        13,
                    ),
                ),
            ),
            (
                "max and min work by name and as methods, return the first of equal values, and take any Orderable",
                func(): run_program(
                    prints(
                        "orderable_max_min",
                        "orderable/max_min",
                        { allocations = 149431, instructions = 560304485 },
                        "int: 8 8 3 3 -1 -5\nfloat: 1.5 0.5 -0 0\nequal: first first first first\nuser: high first\nlists: True True\n",
                        46,
                    ),
                ),
            ),
            (
                "Int, Float and String arithmetic dispatch through the arithmetic traits",
                func(): run_program(
                    prints(
                        "arithmetic_traits",
                        "arithmetic/traits",
                        { allocations = 144128, instructions = 559130782 },
                        ARITHMETIC_TRAITS_OUTPUT,
                        31,
                    ),
                ),
            ),
            (
                "checked Int arithmetic reports overflow and division by zero at each boundary",
                func(): run_program(
                    prints(
                        "arithmetic_checked",
                        "arithmetic/checked",
                        { allocations = 147847, instructions = 565224808 },
                        ARITHMETIC_CHECKED_OUTPUT,
                        49,
                    ),
                ),
            ),
            (
                "each arithmetic operator calls its own canonical trait member",
                func(): run_program(
                    prints(
                        "arithmetic_operators",
                        "arithmetic/operators",
                        { allocations = 156678, instructions = 590364760 },
                        ARITHMETIC_OPERATORS_OUTPUT,
                        94,
                    ),
                ),
            ),
            (
                "arithmetic operators evaluate operands once from left to right",
                func(): run_program(
                    fixture_program(
                        "arithmetic_order",
                        "arithmetic/order",
                        { allocations = 129298, instructions = 514953141 },
                        once(
                            23,
                            "left\nright\nleft\nright\nleft\nright\nleft\nright\nleft\nright\noperand\n",
                            12,
                        ),
                    ),
                ),
            ),
            (
                "64 mixed-precedence arithmetic levels match ordinary calls under default limits",
                func(): run_program(
                    exits_with(
                        "arithmetic_nesting",
                        "arithmetic/nesting",
                        { allocations = 202171, instructions = 732492387 },
                        23,
                        1,
                    ),
                ),
            ),
            (
                "a 2,000-term sum and a 2,000-part String join compile and run",
                func(): run_program(
                    prints(
                        "arithmetic_long_sum",
                        "arithmetic/long_sum",
                        { allocations = 936684, instructions = 4252583121 },
                        "2001000\n2000\n",
                        2003,
                    ),
                ),
            ),
            (
                "each ordering operator calls its own canonical Orderable member",
                func(): run_program(
                    prints(
                        "ordering_operators",
                        "ordering/operators",
                        { allocations = 152831, instructions = 592590567 },
                        "1010\n0011\n0101\n1010\n0011\n0000\n0000\n0000\n1010\n0011\n0101\n0011\n0000\n1000\n0000\n1010\n0011\n",
                        19,
                    ),
                ),
            ),
            (
                "ordering operators evaluate operands once from left to right",
                func(): run_program(
                    fixture_program(
                        "ordering_order",
                        "ordering/order",
                        { allocations = 126857, instructions = 507822066 },
                        once(23, "left\nright\nleft\nright\nleft\nright\nleft\nright\n", 9),
                    ),
                ),
            ),
            (
                "64 grouped ordering comparisons and ordinary calls compile under default limits",
                func(): run_program(
                    exits_with(
                        "ordering_nesting",
                        "ordering/nesting",
                        { allocations = 175805, instructions = 647172137 },
                        23,
                        1,
                    ),
                ),
            ),
            (
                "an Ordered bound provides ==, equals and a default's supertrait call, dispatching a written Equatable",
                func(): run_program(
                    prints(
                        "supertrait_entailment",
                        "supertraits/entailment",
                        { allocations = 139065, instructions = 574130710 },
                        "1101\n0011\n0010\n1101\n0011\n0010\n1101\n",
                        9,
                    ),
                ),
            ),
            (
                "a bodyless Ring bundle provides both supertraits' methods on Int and a record",
                func(): run_program(
                    prints(
                        "supertrait_bundle",
                        "supertraits/bundle",
                        { allocations = 128011, instructions = 512363026 },
                        "56\n6,12\n",
                        4,
                    ),
                ),
            ),
            (
                "Box[Element: Ordered] entails its automatic equality's bound on Box[Box[Int]]",
                func(): run_program(
                    prints(
                        "supertrait_generic_receiver",
                        "supertraits/generic_receiver",
                        { allocations = 129389, instructions = 526015347 },
                        "10\n01\n10\n",
                        5,
                    ),
                ),
            ),
        ],
    }
