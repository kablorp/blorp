import:
    int as int_ops


trait Visit:
    pure func visit(value: Self) -> Int


union First:
    private Init(Int)


union Second:
    private Init(Int)


implements Visit for First:
    pure func visit(value: Self) -> Int:
        7


implements Visit for Second:
    pure func visit(value: Self) -> Int:
        9


record Stored {
    first: pure (First) -> Int,
    second: pure (Second) -> Int
}


pure func forward[Element: Visit](value: Element) -> Int:
    visit(value)


pure func reference[Element: Visit](witness: Element) -> pure (Element) -> Int:
    visit


pure func apply[Element: Visit](
    left: Element,
    callback: pure (Element) -> Int,
    right: Element
) -> Int:
    int_ops.add(callback(left), callback(right))


func produced(label: String) -> First:
    print(label)
    First.Init(1)


func main() -> Int:
    first = forward(First.Init(1))
    second = forward(Second.Init(2))
    repeated = forward(First.Init(3))
    direct: pure (First) -> Int = visit
    returned_first = reference(First.Init(4))
    returned_second = reference(Second.Init(5))
    repeated_reference = reference(First.Init(6))
    stored: Stored = { first = direct, second = returned_second }
    stored_first: pure (First) -> Int = stored.first
    stored_second: pure (Second) -> Int = stored.second
    ordered = apply(produced("left"), visit, produced("right"))

    results = [
        first,
        second,
        repeated,
        stored_first(First.Init(7)),
        stored_second(Second.Init(8)),
        returned_first(First.Init(9)),
        returned_second(Second.Init(10)),
        repeated_reference(First.Init(11)),
        ordered
    ]

    match results:
        [observed_1, observed_2, observed_3, observed_4, observed_5, observed_6, observed_7, observed_8, observed_9]:
            match [
                int_ops.equals(observed_1, 7),
                int_ops.equals(observed_2, 9),
                int_ops.equals(observed_3, 7),
                int_ops.equals(observed_4, 7),
                int_ops.equals(observed_5, 9),
                int_ops.equals(observed_6, 7),
                int_ops.equals(observed_7, 9),
                int_ops.equals(observed_8, 7),
                int_ops.equals(observed_9, 14)
            ]:
                [True, True, True, True, True, True, True, True, True]: 23
                _: 0
        _:
            0
