private TAKE_INT_OUTPUT: String = "0\n-1\n-1\n-1\n-1\n-1\n0\n-1\n-1\n-1\n-1\n-1\n0\n-1\n-1\n-1\n-1\n-1\n1\n0\n-1\n-1\n-1\n-1\n3\n0\n10\n20\n-1\n-1\n4\n0\n10\n20\n30\n-1\n5\n0\n10\n20\n30\n40\n5\n0\n10\n20\n30\n40\n0\n-1\n-1\n-1\n-1\n-1\n5\n0\n10\n20\n30\n40\n"


private SUPPLEMENT_BOUNDS_OUTPUT: String = "[]|-9223372036854775808|9|[]|[]|none\n[]|-1|9|[]|[]|none\n[]|0|9|[]|[]|none\n[]|1|9|[]|[]|none\n[]|2|9|[]|[]|none\n[]|3|9|[]|[]|none\n[]|4|9|[]|[]|none\n[]|9223372036854775807|9|[]|[]|none\ntrue|none|[]\n[7]|-9223372036854775808|9|[]|[7]|none\n[7]|-1|9|[]|[7]|none\n[7]|0|7|[]|[7]|[]\n[7]|1|9|[7]|[]|none\n[7]|2|9|[7]|[]|none\n[7]|3|9|[7]|[]|none\n[7]|4|9|[7]|[]|none\n[7]|9223372036854775807|9|[7]|[]|none\nfalse|7|[7]\n[1,2,3]|-9223372036854775808|9|[]|[1,2,3]|none\n[1,2,3]|-1|9|[]|[1,2,3]|none\n[1,2,3]|0|1|[]|[1,2,3]|[2,3]\n[1,2,3]|1|2|[1]|[2,3]|[1,3]\n[1,2,3]|2|3|[1,2]|[3]|[1,2]\n[1,2,3]|3|9|[1,2,3]|[]|none\n[1,2,3]|4|9|[1,2,3]|[]|none\n[1,2,3]|9223372036854775807|9|[1,2,3]|[]|none\nfalse|3|[3,2,1]\n[5,4,3,2,1]\n"


private SUPPLEMENT_MANAGED_OUTPUT: String = "42é\0:42é\0/3|7:7\n7:7|42é\0:42é\0/3|42é\0:42é\0/3\n42é\0:42é\0/3\n42é\0:42é\0/3|42é\0:42é\0/3|7:7\n42é\0:42é\0/3\n42é\0:42é\0/3|7:7\n7:7|42é\0:42é\0/3|42é\0:42é\0/3\n[]|[4]\n[]|[4]|[9é\0/2]\n[]|[4]|[9é\0/2]\n"


private LIBRARY_LOOPS_OUTPUT: String = "0 [] map [] filter []\n  reverse [] take [] drop []\n  remove none last none past none\n  any false all true find none\n  sort []\n1 [0] map [1] filter []\n  reverse [0] take [0] drop []\n  remove none last [] past none\n  any false all true find none\n  sort [0:0]\n2 [0,5] map [1,6] filter [5]\n  reverse [5,0] take [0,5] drop []\n  remove none last [0] past none\n  any true all false find 5\n  sort [0:0 2:1]\n3 [0,5,3] map [1,6,4] filter [5,3]\n  reverse [3,5,0] take [0,5,3] drop []\n  remove [0,5] last [0,5] past none\n  any true all false find 5\n  sort [0:0 0:2 2:1]\n4 [0,5,3,1] map [1,6,4,2] filter [5,3,1]\n  reverse [1,3,5,0] take [0,5,3] drop [1]\n  remove [0,5,1] last [0,5,3] past none\n  any true all false find 5\n  sort [0:0 0:2 1:3 2:1]\n5 [0,5,3,1,6] map [1,6,4,2,7] filter [5,3,1]\n  reverse [6,1,3,5,0] take [0,5,3] drop [1,6]\n  remove [0,5,1,6] last [0,5,3,1] past none\n  any true all false find 5\n  sort [0:0 0:2 0:4 1:3 2:1]\n8 [0,5,3,1,6,4,2,0] map [1,6,4,2,7,5,3,1] filter [5,3,1]\n  reverse [0,2,4,6,1,3,5,0] take [0,5,3] drop [1,6,4,2,0]\n  remove [0,5,1,6,4,2,0] last [0,5,3,1,6,4,2] past none\n  any true all false find 5\n  sort [0:0 0:2 0:4 0:7 1:3 1:5 2:1 2:6]\n9 [0,5,3,1,6,4,2,0,5] map [1,6,4,2,7,5,3,1,6] filter [5,3,1,5]\n  reverse [5,0,2,4,6,1,3,5,0] take [0,5,3] drop [1,6,4,2,0,5]\n  remove [0,5,1,6,4,2,0,5] last [0,5,3,1,6,4,2,0] past none\n  any true all false find 5\n  sort [0:0 0:2 0:4 0:7 1:3 1:5 2:1 2:6 2:8]\n"


func suite(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
) -> TestSuite:
    run_program = func(program: Program) -> Bool: reported(
        verify_program(compiler, c_compiler, work_directory, check_instructions, program),
    )
    {
        description = "Blorp lists",
        tests = [
            (
                "List growth preserves snapshots managed children and nested values",
                func(): run_program(
                    prints(
                        "append_reuse",
                        "list/append_reuse",
                        { allocations = 146502, instructions = 558623445 },
                        "12\n0\n11\n12\n42 child\n42 child\n13\nnew\ntail\n12\n7\n13\nlast\ndone\n",
                        27,
                    ),
                ),
            ),
            (
                "List set and concat preserve snapshots aliases invalid indices and nested values",
                func(): run_program(
                    prints(
                        "update_reuse",
                        "list/update_reuse",
                        { allocations = 142606, instructions = 550673556 },
                        "42 child\n42 child\n7 replacement\n42 child\n2\n7 replacement\n42 child\n42 child\n7 replacement\n2\n42 child\n4\n7 replacement\n42 child\n2\n4\n42 child\n4\n42 child\ndone\n",
                        28,
                    ),
                ),
            ),
            (
                "exact-sized List literal compiles without growth calls",
                func(): run_program(
                    prints(
                        "literal",
                        "list/literal_int",
                        { allocations = 124302, instructions = 499885752 },
                        "3\n1\n3\n",
                        4,
                    ),
                ),
            ),
            (
                "empty literals share an immortal root that updates copy and drops ignore",
                func(): run_program(
                    prints(
                        "static_empty",
                        "list/static_empty",
                        { allocations = 131144, instructions = 518731786 },
                        "1000\nfirst\n0\nfirst\n0\n5\nx\n0\n",
                        12,
                    ),
                ),
            ),
            (
                "inner-loop entry takes dying accumulators and preserves snapshots",
                func(): run_program(
                    prints(
                        "loop_entry_accumulator",
                        "list/loop_entry_accumulator",
                        { allocations = 146167, instructions = 557189293 },
                        "20\n0\n19\n4\n0\n2\n4\n6\n3\n00\n21\n012012012\n",
                        29,
                    ),
                ),
            ),
            (
                "join arms take dying accumulators and preserve snapshots",
                func(): run_program(
                    prints(
                        "branch_accumulator",
                        "list/branch_accumulator",
                        { allocations = 154828, instructions = 576812326 },
                        "20\n0\n190\n5\n0\n1\n2\n2\n5\n2\nodd\n0003006\n5\n7\n",
                        30,
                    ),
                ),
            ),
            (
                "stable Int-key sorting preserves managed aliases and chained keys",
                func(): run_program(
                    prints(
                        "sort_by",
                        "generic/managed/list_sort_by",
                        { allocations = 195595, instructions = 684060656 },
                        "0\nonly\nonly\nA\nB\nC\nB\nC\nA\nA\nmin1\nmin2\nmax\na\nx\nzz\n2\né\0\nmiddle\nlater\n",
                        45,
                    ),
                ),
            ),
            (
                "stable sort preserves every reversed element and nested owned aliases",
                func(): run_program(
                    prints(
                        "sort_by_nested",
                        "generic/managed/list_sort_by_nested_stress",
                        { allocations = 157046, instructions = 587579563 },
                        SORT_BY_NESTED_OUTPUT,
                        811,
                    ),
                ),
            ),
            (
                "Float and user Orderable keys sort stably, and NaN keys still permute",
                func(): run_program(
                    prints(
                        "sort_by_orderable",
                        "generic/managed/list_sort_by_orderable",
                        { allocations = 159405, instructions = 599907949 },
                        "BCDA\nBCAD\nBCDA\nABCD\nWXYZ\n",
                        34,
                    ),
                ),
            ),
            (
                "take clamps counts and preserves exact prefix order",
                func(): run_program(
                    prints(
                        "take_int",
                        "list/take_int",
                        { allocations = 133281, instructions = 525397485 },
                        TAKE_INT_OUTPUT,
                        66,
                    ),
                ),
            ),
            (
                "slice clamps, starts_with and index_of search, and Lists order lexicographically",
                func(): run_program(
                    prints(
                        "list_slice_search_order",
                        "list/slice_search_order",
                        { allocations = 181226, instructions = 643210754 },
                        "slice(1, 3): [20,30]\nslice(0, 5): [10,20,30,40,50]\nslice(-4, 2): [10,20]\nslice(3, 99): [40,50]\nslice(4, 2): []\nslice(7, 9): []\nslice(2, 2): []\nslice(0, 3): []\nwords: b+c\n[10,20,30,40,50] starts_with [10,20]: True\n[10,20,30,40,50] starts_with [10,20,30,40,50]: True\n[10,20,30,40,50] starts_with []: True\n[] starts_with []: True\n[] starts_with [10]: False\n[10,20,30,40,50] starts_with [10,21]: False\n[10,20,30,40,50] starts_with [10,20,30,40,50,60]: False\n[10,20,30,40,50] starts_with [20]: False\nindex_of(10): Some(0)\nindex_of(50): Some(4)\nindex_of(7): Some(0)\nindex_of(99): None\nindex_of(1): None\nnested: Some(1)\n[1,2] < [1,3]: True\n[1,3] < [1,2]: False\n[1,2] < [1,2]: False\n[1] < [1,2]: True\n[1,2] < [1]: False\n[] < [0]: True\n[] < []: False\n[2] < [1,9]: False\nge: True False gt: True le: True\nfloats: True True False\n",
                        277,
                    ),
                ),
            ),
            (
                "remove checks bounds and shifts each surviving Int in order",
                func(): run_program(
                    prints(
                        "remove_int",
                        "list/remove_int",
                        { allocations = 135147, instructions = 527717069 },
                        "none\nnone\nnone\nnone\nnone\n4\n10\n20\n30\n40\n-1\n4\n0\n10\n30\n40\n-1\n4\n0\n10\n20\n30\n-1\n0\n-1\n-1\n-1\n-1\n-1\n5\n0\n10\n20\n30\n40\n",
                        39,
                    ),
                ),
            ),
            (
                "take and remove preserve mortal repeated children and escaping aliases",
                func(): run_program(
                    prints(
                        "take_remove_managed",
                        "list/take_remove_managed",
                        { allocations = 139831, instructions = 539270161 },
                        "3\n42é\0\n42é\0\n42é\0\n2\n42é\0\n42é\0\n42é\0\n2\n42é\0\n7\n42é\0\n2\n42é\0\n42é\0\n42é\0\n2\n42é\0\n7\n42é\0\n",
                        36,
                    ),
                ),
            ),
            (
                "take and remove distinguish Void presence, Some empty and None",
                func(): run_program(
                    prints(
                        "take_remove_void",
                        "list/take_remove_void",
                        { allocations = 133392, instructions = 520999682 },
                        "2\npresent\n2\npresent\n0\nempty\nnone\nnone\n0\nempty\n3\npresent\n",
                        15,
                    ),
                ),
            ),
            (
                "take and remove handle 256 elements and retain the input",
                func(): run_program(
                    prints(
                        "take_remove_moderate",
                        "list/take_remove_moderate",
                        { allocations = 134093, instructions = 525000013 },
                        "255\n7\n7\n7\n-1\n255\n7\n7\n7\n-1\n255\n7\n7\n7\n-1\n256\n7\n",
                        22,
                    ),
                ),
            ),
            (
                "take, drop, remove and reverse clamp all Int bounds and keep exact order",
                func(): run_program(
                    prints(
                        "supplement_bounds",
                        "list/supplement/bounds",
                        { allocations = 149292, instructions = 564233658 },
                        SUPPLEMENT_BOUNDS_OUTPUT,
                        337,
                    ),
                ),
            ),
            (
                "find chooses the first match, and all handles empty, Void and forwarded predicates",
                func(): run_program(
                    prints(
                        "supplement_predicates",
                        "list/supplement/predicates",
                        { allocations = 156700, instructions = 589967749 },
                        "8\n6\n6\nnone\n2\nnone\nnone\ntrue\ntrue\nfalse\ntrue\nfalse\nfalse\ntrue\nunit-some\nunit-none\nunit-none\ntrue\nfalse\ntrue\nunit-some\n2\n",
                        33,
                    ),
                ),
            ),
            (
                "drop, reverse and find preserve escaped mortal payloads and nested aliases",
                func(): run_program(
                    prints(
                        "supplement_managed",
                        "list/supplement/managed",
                        { allocations = 154761, instructions = 578329336 },
                        SUPPLEMENT_MANAGED_OUTPUT,
                        127,
                    ),
                ),
            ),
            (
                "List queries keep owned results and eager defaults",
                func(): run_program(
                    prints(
                        "list_queries",
                        "generic/managed/list_queries",
                        { allocations = 143572, instructions = 550680875 },
                        "2\n2\n-1\neager\n42é\0\neager\nfallback!\n7!\n42é\0\n42é\0\nnone\ntrue\nfalse\nfalse\nunit-some\nunit-none\n42é\0\n42é\0\n7!\n",
                        33,
                    ),
                ),
            ),
            (
                "map, filter and any keep stable outputs and owned children",
                func(): run_program(
                    prints(
                        "list_callbacks",
                        "generic/managed/list_callbacks",
                        { allocations = 163603, instructions = 605468340 },
                        "false\ntrue\ntrue\nfalse\ninput\n1\n2\n3\n2\ntrue\n3\n1\n0\n0\n2\n2\n0\ntrue\n42é\0!\n!\n42é\0\n42é\0\n7\n7\n8\n",
                        52,
                    ),
                ),
            ),
            (
                "join keeps separators, order and managed aliases",
                func(): run_program(
                    prints(
                        "list_join",
                        "generic/managed/list_join",
                        { allocations = 132640, instructions = 524745983 },
                        "\nsolo\n//\nabc\na::::c\nleft!§\0left!\né\0|😀\nleft!\n§\0\nleft!\n2047\n",
                        48,
                    ),
                ),
            ),
            (
                "map, filter, reverse, take, drop, remove, any, all, find and sort_by agree at lengths 0 to 9",
                func(): run_program(
                    prints(
                        "library_loops",
                        "list/library_loops",
                        { allocations = 175400, instructions = 626942091 },
                        LIBRARY_LOOPS_OUTPUT,
                        581,
                    ),
                ),
            ),
            (
                "map, filter, reverse, sort_by and join of 4,096 elements allocate in proportion to the length",
                func(): run_program(
                    prints(
                        "library_linear",
                        "list/library_linear",
                        { allocations = 149370, instructions = 563135900 },
                        "4096 2048 4096\n0 4095 2859\n19369\n",
                        4117,
                    ),
                ),
            ),
            (
                "sort_by keeps the input order of 1,000 elements tied on seven keys",
                func(): run_program(
                    prints(
                        "sort_by_ties",
                        "list/sort_by_ties",
                        { allocations = 140575, instructions = 540776417 },
                        "1000 0\n",
                        6,
                    ),
                ),
            ),
            (
                "ordinary List take import reaches real main",
                func(): run_program(
                    exits_with(
                        "import_take",
                        "list/supplement/imports/take",
                        { allocations = 124255, instructions = 479629521 },
                        1,
                        2,
                    ),
                ),
            ),
            (
                "ordinary List drop import reaches real main",
                func(): run_program(
                    exits_with(
                        "import_drop",
                        "list/supplement/imports/drop",
                        { allocations = 124293, instructions = 480208305 },
                        0,
                        1,
                    ),
                ),
            ),
            (
                "ordinary List remove import reaches real main",
                func(): run_program(
                    exits_with(
                        "import_remove",
                        "list/supplement/imports/remove",
                        { allocations = 125534, instructions = 483300805 },
                        0,
                        2,
                    ),
                ),
            ),
            (
                "ordinary List reverse import reaches real main",
                func(): run_program(
                    exits_with(
                        "import_reverse",
                        "list/supplement/imports/reverse",
                        { allocations = 123155, instructions = 477653216 },
                        1,
                        2,
                    ),
                ),
            ),
            (
                "ordinary List find import reaches real main",
                func(): run_program(
                    exits_with(
                        "import_find",
                        "list/supplement/imports/find",
                        { allocations = 122656, instructions = 477483986 },
                        7,
                        1,
                    ),
                ),
            ),
            (
                "ordinary List all import reaches real main",
                func(): run_program(
                    exits_with(
                        "import_all",
                        "list/supplement/imports/all",
                        { allocations = 122479, instructions = 476906167 },
                        0,
                        1,
                    ),
                ),
            ),
        ],
    }
