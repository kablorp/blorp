-- Native cases for io/process: programs that call only some of its natives
-- and so must emit valid C under -Werror with exactly their helpers. Each
-- program compiles once within its ceiling, then runs with exact stdout,
-- status and strict allocation counts.
import:
    test: TestSuite
    ../driver/harness: Program, once, prints, reported, verify_program


func suite(
    compiler: String,
    c_compiler: String,
    work_directory: String,
    check_instructions: Bool,
) -> TestSuite:
    run_program = func(program: Program) -> Bool: reported(
        verify_program(compiler, c_compiler, work_directory, check_instructions, program),
    )
    {
        description = "Blorp process natives",
        tests = [
            -- Ceilings are each compile's measured cost plus 15%.
            (
                "a program that calls only process.capture is valid C under -Werror",
                func(): run_program(
                    prints(
                        "process_native_capture",
                        "process/natives_capture",
                        { allocations = 133243, instructions = 508751125 },
                        "17\n512\n",
                        12,
                    ),
                ),
            ),
            (
                "a program that calls only process.find_program is valid C under -Werror",
                func(): run_program(
                    prints(
                        "process_native_find_program",
                        "process/natives_find_program",
                        { allocations = 128971, instructions = 497799403 },
                        "7\n",
                        2,
                    ),
                ),
            ),
            (
                "a program that calls only process.fault is valid C under -Werror",
                func(): run_program(
                    prints(
                        "process_native_fault",
                        "process/natives_fault",
                        { allocations = 131988, instructions = 504767784 },
                        "not called\n",
                        3,
                    ),
                ),
            ),
            (
                "a program that calls only process.run is valid C under -Werror",
                func(): run_program(
                    prints(
                        "process_native_run",
                        "process/natives_run",
                        { allocations = 128468, instructions = 524112791 },
                        "17\n",
                        4,
                    ),
                ),
            ),
            (
                "a program that calls only process.exit_interrupted is valid C under -Werror",
                func(): run_program(
                    prints(
                        "process_native_exit_interrupted",
                        "process/natives_exit_interrupted",
                        { allocations = 129326, instructions = 522802418 },
                        "not called\n",
                        3,
                    ),
                ),
            ),
            (
                "a program that runs a child on its captured stdout prints its lines in order",
                func(): run_program(
                    prints(
                        "process_run_terminal",
                        "process/run_terminal",
                        { allocations = 268330, instructions = 930794829 },
                        "before\nchild\nafter 0\n",
                        12,
                    ),
                ),
            ),
            (
                "a program that runs itself, whose child calls exit_interrupted, reports Signaled with the child's line first",
                func(): run_program(
                    prints(
                        "process_run_exit_interrupted",
                        "process/run_exit_interrupted",
                        { allocations = 272067, instructions = 969043498 },
                        "parent line\nchild line\nsignaled 2\n",
                        14,
                    ),
                ),
            ),
            (
                "a program that calls the three process natives emits their shared helpers once",
                func(): run_program(
                    prints(
                        "process_native_together",
                        "process/natives_together",
                        { allocations = 132172, instructions = 521366898 },
                        "17\n7\n",
                        10,
                    ),
                ),
            ),
        ],
    }
