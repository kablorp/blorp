-- Deterministic source generation needed to build the self-hosted compiler.
--
-- Keeping these modes in one executable means the pinned bootstrap compiler is
-- invoked once. The resulting tool then generates every build-owned source.
import:
	bytes: Bytes
	fs: message, walk_files
	hash: md5
	io: print_error, puts
	system: getenv, is_directory, read_file


private record EmbeddedStdModule {
	name: String,
	content: String
}


private USAGE: String = (
	"usage: generate-build-sources <embedded-std|build-info|embedded-runtime-c> "
	+ "<inputs...>"
)


private pure func byte_text(value: Bytes, index: Int) -> String:
	value
		.slice(index, 1)
		.to_string()


private pure func quoted_blorp_string(value: String) -> String:
	var rendered: String = "\""

	for character in value.chars():
		codepoint: Int = character.to_int()

		if character == '\"':
			rendered += "\\\""
		else if character == '\\':
			rendered += "\\\\"
		else if character == '\n':
			rendered += "\\n"
		else if character == '\r':
			rendered += "\\r"
		else if character == '\t':
			rendered += "\\t"
		else if character == '{':
			-- Escaping braces prevents metadata containing `${...}` from being
			-- parsed as source interpolation while preserving its value.
			rendered += "\\{"
		else if character == '}':
			rendered += "\\}"
		else if codepoint < 32 or codepoint == 127:
			rendered += "\\u{" + codepoint.to_hex() + "}"
		else:
			rendered += character.to_string()

	rendered + "\""


private pure func c_hex_byte(byte: Int) -> String:
	byte
		.to_hex()
		.pad_left(2, '0')


private pure func quoted_c_bytes(value: String) -> String:
	raw: Bytes = value.to_bytes()
	var rendered: String = "\""

	for index in 0..raw.length():
		byte: Int = raw
			.get(index)
			.get_or(0)

		if byte == 34:
			rendered += "\\\""
		else if byte == 92:
			rendered += "\\\\"
		else if byte == 10:
			rendered += "\\n\"\n\""
		else if byte == 13:
			rendered += "\\r"
		else if byte == 9:
			rendered += "\\t"
		else if byte >= 32 and byte <= 126:
			rendered += byte_text(raw, index)
		else:
			-- The empty adjacent literal prevents a following hex digit from
			-- extending C's variable-width hexadecimal escape.
			rendered += "\\x" + c_hex_byte(byte) + "\"\""

	rendered + "\""


private pure func strip_trailing_slashes(path: String) -> String:
	var result: String = path

	while result.ends_with("/"):
		result = result.substring(0, result.length() - 1)

	result


private func embedded_std_modules(std_directory: String) -> Result[List[EmbeddedStdModule], String]:
	root: String = strip_trailing_slashes(std_directory)
	prefix: String = root + "/"
	all_paths ?= walk_files(root).map_err(func(err): message(err))
	paths: List[String] = all_paths
		.filter(func(path: String): path.ends_with(".brp"))
		.sort()
	var modules: List[EmbeddedStdModule] = []
	var error: Option[String] = None

	for path in paths:
		if error.is_none():
			if not path.starts_with(prefix):
				error = Some("standard-library path is outside its root: " + path)
			else:
				match read_file(path):
					Err(message):
						error = Some(message)
					Ok(content):
						relative_path: String = path.substring(
							prefix.length(),
							path.length() - prefix.length() - 4,
						)
						modules = modules.append({
							name = relative_path,
							content = content,
						})

	match error:
		Some(message):
			Err(message)
		None:
			Ok(modules)


private pure func embedded_std_digest_input(modules: List[EmbeddedStdModule]) -> String:
	var parts: List[String] = []

	for module_value in modules:
		parts = parts.append(module_value.name)
		parts = parts.append(module_value.content)

	parts.join("\0")


private pure func render_raw_source(content: String) -> String:
	var rendered: String = ""

	for line in content.split("\n"):
		rendered += "\t\t\t\t|" + line + "\n"

	rendered


private pure func render_embedded_std(modules: List[EmbeddedStdModule]) -> String:
	digest: String = md5(embedded_std_digest_input(modules))
	var rendered: String = "-- Generated by generate_build_sources.brp; do not edit.\n"
	rendered += "embedded_std_digest: String = " + quoted_blorp_string(digest) + "\n\n"
	rendered += "pure func embedded_std_module_names() -> List[String]:\n\t[\n"

	for module_value in modules:
		rendered += "\t\t" + quoted_blorp_string(module_value.name) + ",\n"

	rendered += "\t]\n\n\n"
	rendered += "pure func embedded_std_contains_module(module_name: String) -> Bool:\n"
	rendered += "\tmatch module_name:\n"

	for module_value in modules:
		rendered += "\t\t" + quoted_blorp_string(module_value.name) + ":\n"
		rendered += "\t\t\tTrue\n"

	rendered += "\t\t_:\n\t\t\tFalse\n\n\n"
	rendered += "pure func embedded_std_source(module_name: String) -> Option[String]:\n"
	rendered += "\tmatch module_name:\n"

	for module_value in modules:
		rendered += "\t\t" + quoted_blorp_string(module_value.name) + ":\n"
		rendered += "\t\t\tsource: String = raw\n"
		rendered += render_raw_source(module_value.content)
		rendered += "\t\t\tSome(source)\n"

	rendered += "\t\t_:\n\t\t\tNone\n"
	rendered


private func generate_embedded_std(std_directory: String) -> Result[String, String]:
	if not is_directory(std_directory):
		Err("standard-library directory does not exist: " + std_directory)
	else:
		modules ?= embedded_std_modules(std_directory)
		Ok(render_embedded_std(modules))


private func environment_or(name: String, fallback: String) -> String:
	getenv(name).get_or(fallback)


private func source_version(version_path: String) -> Result[String, String]:
	content ?= read_file(version_path)
	lines: List[String] = content.split("\n")

	match lines:
		[version, ""]:
			if version == "":
				Err("version file must contain exactly one non-empty line")
			else:
				Ok(version)
		[version]:
			if version == "":
				Err("version file must contain exactly one non-empty line")
			else:
				Ok(version)
		_:
			Err("version file must contain exactly one non-empty line")


private func generate_build_info(version_path: String) -> Result[String, String]:
	version ?= source_version(version_path)
	version_override: String = environment_or("BLORP_BUILD_VERSION", "")

	resolved_version: String = if version_override == "":
		version
	else:
		version_override

	build_commit: String = environment_or("BLORP_BUILD_COMMIT", "unknown")
	build_target: String = environment_or("BLORP_BUILD_TARGET", "unknown")
	build_channel: String = environment_or("BLORP_BUILD_CHANNEL", "local")
	build_dirty: String = environment_or("BLORP_BUILD_DIRTY", "unknown")
	var rendered: String = "-- Generated by generate_build_sources.brp; do not edit.\n"
	rendered += "import:\n\tembedded_std: embedded_std_digest\n\n\n"
	rendered += "VERSION: String = " + quoted_blorp_string(resolved_version) + "\n\n"
	rendered += "VERSION_DESCRIPTION: String = "
	rendered += quoted_blorp_string(
		"blorp " + resolved_version + "\ncommit: " + build_commit + "\ntarget: " + build_target + "\nchannel: " + build_channel + "\ndirty: " + build_dirty + "\nstd: embedded, hash ",
	)
	rendered += " + embedded_std_digest\n"
	Ok(rendered)


private pure func render_c_string(name: String, value: String) -> String:
	var rendered: String = "const char " + name + "[] =\n"
	rendered += quoted_c_bytes(value) + ";\n"
	rendered += "const size_t " + name + "_len = sizeof(" + name + ") - 1;\n\n"
	rendered


private func generate_embedded_runtime_c(
	minicoro_path: String,
	runtime_path: String,
	runtime_declarations_path: String,
) -> Result[String, String]:
	minicoro ?= read_file(minicoro_path)
	runtime ?= read_file(runtime_path)
	runtime_declarations ?= read_file(runtime_declarations_path)
	runtime_source: String = "#define _GNU_SOURCE\n#define MINICORO_IMPL\n" + minicoro + "\n" + runtime
	declaration_source: String = "#define _GNU_SOURCE\n" + minicoro + "\n" + runtime_declarations
	var rendered: String = "#include <stddef.h>\n"
	rendered += render_c_string("blorp_compiler_runtime_source_data", runtime_source)
	rendered += render_c_string("blorp_compiler_runtime_decl_data", declaration_source)
	Ok(rendered)


private func generate(args: List[String]) -> Result[String, String]:
	match args:
		[_, "embedded-std", std_directory]:
			generate_embedded_std(std_directory)
		[_, "build-info", version_path]:
			generate_build_info(version_path)
		[_, "embedded-runtime-c", minicoro_path, runtime_path, runtime_declarations_path]:
			generate_embedded_runtime_c(minicoro_path, runtime_path, runtime_declarations_path)
		_:
			Err(USAGE)


func main(args: List[String]) -> Int:
	match generate(args):
		Ok(output):
			puts(output)
			0
		Err(message):
			print_error(message)
			2
