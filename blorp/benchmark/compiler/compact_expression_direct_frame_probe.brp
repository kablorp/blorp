import:
	../../src/compiler/stage_03_parse/compact_expression_product:
		compact_expression_direct_frame_storage_probe,
	memory: get_mem_stats, reset_mem_stats


func main(_args: List[String]) -> Int:
	reset_mem_stats()
	probe = compact_expression_direct_frame_storage_probe(4096, 32)
	stats = get_mem_stats()
	print(
		"COMPACT_DIRECT_FRAME" + " pushes=" + probe.push_count.to_string() + " pops=" + probe.pop_count.to_string() + " maximum_depth=" + probe.maximum_depth.to_string() + " retained_slots=" + probe.retained_slot_count.to_string() + " reuse_depth=" + probe.reuse_depth.to_string() + " checksum=" + probe.checksum.to_string() + " allocations=" + stats.total_allocations.to_string() + " releases=" + stats.total_releases.to_string() + " retained_objects=" + stats.current_objects.to_string() + " current_live_bytes=" + stats.bytes_allocated.to_string(),
	)

	if (
		probe.push_count == 4128
		and probe.pop_count == 4128
		and probe.maximum_depth == 4096
		and probe.checksum == 8387056
		and probe.retained_slot_count == 4096
		and probe.reuse_depth == 32
	):
		0
	else:
		1
