-- Direct profile of implementation-method type-parameter admission.
import:
	compiler_implementation_method_parameter_profile_fixture:
		CompilerImplementationMethodParameterProfileConfig,
		compiler_implementation_method_parameter_profile_execute,
		compiler_implementation_method_parameter_profile_fixture,
		compiler_implementation_method_parameter_profile_observe,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func integer_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			parse_int(text).get_or(default)
		None:
			default


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	value = integer_argument(args, index, default)

	if value > 0:
		value
	else:
		default


func main(args: List[String]) -> Int:
	iterations = positive_argument(args, 1, 50)
	config: CompilerImplementationMethodParameterProfileConfig = {
		method_parameter_count = positive_argument(args, 2, 1024),
		occurrences_per_type = positive_argument(args, 3, 1),
		return_type_occurrences = integer_argument(args, 4, 1),
		constraint_count = integer_argument(args, 5, 0),
		duplicate_percent = integer_argument(args, 6, 99)
	}

	match compiler_implementation_method_parameter_profile_fixture(config):
		None:
			print("implementation method parameter profile fixture construction failed")
			1
		Some(fixture):
			setup_started = now_microseconds()
			warmup = compiler_implementation_method_parameter_profile_execute(fixture, 1)
			warmup_observation = compiler_implementation_method_parameter_profile_observe(
				fixture,
				warmup,
			)
			setup_microseconds = now_microseconds() - setup_started

			reset_mem_stats()
			begin_function_profile_window()
			started = now_microseconds()
			result = compiler_implementation_method_parameter_profile_execute(fixture, iterations)
			elapsed_microseconds = now_microseconds() - started
			end_function_profile_window()
			memory = get_mem_stats()
			observation = compiler_implementation_method_parameter_profile_observe(fixture, result)

			print(
				"IMPLEMENTATION_METHOD_PARAMETER_PROFILE" + " iterations=" + iterations.to_string() + " method_parameters=" + fixture.method_parameter_count.to_string() + " occurrences_per_type=" + fixture.occurrences_per_type.to_string() + " return_occurrences=" + fixture.return_type_occurrences.to_string() + " constraints=" + fixture.constraint_count.to_string() + " duplicate_percent=" + fixture.duplicate_percent.to_string() + " discovery_batches=" + (fixture.discovery_batches * iterations).to_string() + " candidates_discovered=" + (fixture.candidates_discovered * iterations).to_string() + " legacy_aggregate_item_opportunities=" + (fixture.candidates_discovered * iterations).to_string() + " admission_probes=" + (fixture.admission_probes * iterations).to_string() + " unique_admissions=" + (fixture.unique_admissions * iterations).to_string() + " duplicate_candidates=" + (fixture.duplicate_candidates * iterations).to_string() + " headers=" + observation.header_count.to_string() + " methods=" + observation.method_count.to_string() + " effective_parameters=" + observation.effective_parameters.to_string() + " resolved_constraints=" + observation.resolved_constraints.to_string() + " ordered_header_checksum=" + observation.ordered_header_checksum.to_string() + " graph_ready=" + observation.graph_ready.to_string() + " workload_valid=" + observation.workload_valid.to_string() + " warmup_checksum=" + warmup_observation.ordered_header_checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + memory.total_allocations.to_string() + " releases=" + memory.total_releases.to_string() + " retained_objects=" + memory.current_objects.to_string() + " allocator_bytes=" + memory.bytes_allocated.to_string(),
			)

			if observation.workload_valid and warmup_observation.workload_valid:
				0
			else:
				2
