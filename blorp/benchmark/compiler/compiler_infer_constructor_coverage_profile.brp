-- Production-boundary profile for constructor exhaustiveness membership.
--
-- Usage:
--   benchmarks/compiler_infer_constructor_coverage_profile plain 20 64 8 512 1
import:
	compiler_infer_constructor_coverage_profile_fixture:
		ConstructorCoverageProfileConfig,
		constructor_coverage_profile_execute,
		constructor_coverage_profile_fixture,
		constructor_coverage_profile_observe,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private func run_profile(config: ConstructorCoverageProfileConfig) -> Int:
	setup_started: Int = now_microseconds()
	fixture = constructor_coverage_profile_fixture(config)
	warmup_execution = constructor_coverage_profile_execute(fixture, 1)
	warmup = constructor_coverage_profile_observe(fixture, warmup_execution)
	setup_microseconds: Int = now_microseconds() - setup_started

	reset_mem_stats()
	begin_function_profile_window()
	started: Int = now_microseconds()
	execution = constructor_coverage_profile_execute(fixture, config.iterations)
	elapsed_microseconds: Int = now_microseconds() - started
	end_function_profile_window()
	memory = get_mem_stats()
	result = constructor_coverage_profile_observe(fixture, execution)
	workload_valid: Bool = (
		warmup.workload_valid
		and result.workload_valid
		and warmup.error_checksum == result.error_checksum
		and warmup.typed_case_count == result.typed_case_count
	)

	print(
		"INFER_CONSTRUCTOR_COVERAGE_PROFILE" + " iterations=" + config.iterations.to_string() + " cases=" + config.case_count.to_string() + " options=" + config.options_per_case.to_string() + " unique=" + config.unique_constructor_count.to_string() + " duplicate_stride=" + config.duplicate_stride.to_string() + " expected_pattern_visits=" + result.expected_pattern_visits.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + memory.total_allocations.to_string() + " releases=" + memory.total_releases.to_string() + " retained_objects=" + memory.current_objects.to_string() + " allocator_bytes=" + memory.bytes_allocated.to_string() + " error_count=" + result.error_count.to_string() + " error_checksum=" + result.error_checksum.to_string() + " typed_case_count=" + result.typed_case_count.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " workload_valid=" + workload_valid.to_string(),
	)

	if workload_valid:
		0
	else:
		1


func main(args: List[String]) -> Int:
	run_profile({
		iterations = positive_argument(args, 1, 20),
		case_count = positive_argument(args, 2, 64),
		options_per_case = positive_argument(args, 3, 8),
		unique_constructor_count = positive_argument(args, 4, 512),
		duplicate_stride = positive_argument(args, 5, 1),
	})
