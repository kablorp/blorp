-- Production-path profile for inference capture-name filtering.
--
-- Usage:
--   benchmarks/compiler_inference_capture_name_profile plain 50 512 100
import:
	compiler_inference_capture_name_profile_fixture:
		InferenceCaptureNameProfileConfig,
		inference_capture_name_profile_execute,
		inference_capture_name_profile_fixture,
		inference_capture_name_profile_observe,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func integer_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			parse_int(text).get_or(default)
		None:
			default


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	value = integer_argument(args, index, default)

	if value > 0:
		value
	else:
		default


private func run_profile(config: InferenceCaptureNameProfileConfig) -> Int:
	setup_started: Int = now_microseconds()
	fixture = inference_capture_name_profile_fixture(config)
	warmup_execution = inference_capture_name_profile_execute(fixture, 1)
	warmup = inference_capture_name_profile_observe(fixture, warmup_execution)
	setup_microseconds: Int = now_microseconds() - setup_started

	reset_mem_stats()
	begin_function_profile_window()
	started: Int = now_microseconds()
	execution = inference_capture_name_profile_execute(fixture, config.iterations)
	elapsed_microseconds: Int = now_microseconds() - started
	end_function_profile_window()
	memory = get_mem_stats()
	result = inference_capture_name_profile_observe(fixture, execution)
	workload_valid: Bool = (
		warmup.workload_valid
		and result.workload_valid
		and warmup.error_count == result.error_count
		and warmup.output_checksum == result.output_checksum
		and warmup.typed_body_item_count == result.typed_body_item_count
	)

	print(
		"INFERENCE_CAPTURE_NAME_PROFILE" + " iterations=" + config.iterations.to_string() + " capture_width=" + config.capture_width.to_string() + " qualifying_percent=" + config.qualifying_percent.to_string() + " producer_unique_name_count=" + result.producer_unique_name_count.to_string() + " capture_filter_input_visits=" + result.capture_filter_input_visits.to_string() + " qualifying_name_count=" + result.qualifying_name_count.to_string() + " redundant_comparison_opportunities=" + result.redundant_comparison_opportunities.to_string() + " typed_body_item_count=" + result.typed_body_item_count.to_string() + " error_count=" + result.error_count.to_string() + " output_checksum=" + result.output_checksum.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + memory.total_allocations.to_string() + " releases=" + memory.total_releases.to_string() + " retained_objects=" + memory.current_objects.to_string() + " allocator_bytes=" + memory.bytes_allocated.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " workload_valid=" + workload_valid.to_string(),
	)

	if workload_valid:
		0
	else:
		1


func main(args: List[String]) -> Int:
	run_profile({
		iterations = positive_argument(args, 1, 50),
		capture_width = positive_argument(args, 2, 512),
		qualifying_percent = integer_argument(args, 3, 100),
	})
