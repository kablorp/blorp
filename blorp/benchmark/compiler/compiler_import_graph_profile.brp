-- Fast import-heavy typechecker benchmark.
--
-- Positional controls: iterations, modules, functions per module, import
-- fan-out, and parsed-program mode (`retained` or `fallback`).
import:
	compiler_import_graph_profile_fixture:
		CompilerImportGraphBenchmarkConfig,
		CompilerImportGraphBenchmarkResult,
		compiler_import_graph_benchmark_request,
		compiler_import_graph_benchmark_with_request,
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func non_negative_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value >= 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func retain_parsed_programs_argument(args: List[String], index: Int) -> Bool:
	match args.get(index):
		Some("fallback"):
			False
		_:
			True


func main(args: List[String]) -> Int:
	config: CompilerImportGraphBenchmarkConfig = {
		iterations = positive_argument(args, 1, 3),
		module_count = positive_argument(args, 2, 30),
		functions_per_module = positive_argument(args, 3, 32),
		import_fanout = non_negative_argument(args, 4, 20),
		retain_parsed_programs = retain_parsed_programs_argument(args, 5)
	}
	setup_started = now_microseconds()
	request = compiler_import_graph_benchmark_request(config)
	setup_microseconds = now_microseconds() - setup_started
	started = now_microseconds()
	result: CompilerImportGraphBenchmarkResult = compiler_import_graph_benchmark_with_request(
		config,
		request,
	)
	elapsed_microseconds = now_microseconds() - started
	print(
		"IMPORT_GRAPH_PROFILE_BENCH" + " iterations=" + config.iterations.to_string() + " modules=" + config.module_count.to_string() + " functions_per_module=" + config.functions_per_module.to_string() + " import_fanout=" + config.import_fanout.to_string() + " retain_parsed_programs=" + config.retain_parsed_programs.to_string() + " artifacts=" + result.artifact_count.to_string() + " source_declarations=" + result.source_declaration_count.to_string() + " typed_declarations=" + result.typed_declaration_count.to_string() + " resolved_imports=" + result.resolved_import_count.to_string() + " import_bindings=" + result.import_binding_count.to_string() + " imported_function_registration_pressure=" + result.imported_function_registration_pressure.to_string() + " errors=" + result.error_count.to_string() + " workload_valid=" + result.workload_valid.to_string() + " checksum=" + result.checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string(),
	)

	if result.error_count == 0 and result.workload_valid:
		0
	else:
		1
