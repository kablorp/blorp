-- Retained profile for resolving variadic dimension lists during inference.
--
-- Usage:
--   benchmarks/compiler_var_dims_resolution_profile 200 64 16 1
--   benchmarks/compiler_var_dims_resolution_profile 200 256 4 8
import:
	../../src/compiler/stage_03_parse/parsed_ast:
		ParsedExpr(ParsedCallExpr, ParsedNameExpr),
		ParsedIdentifier,
		parsed_identifier,
	../../src/compiler/stage_06_typecheck/infer:
		infer_context,
		infer_expr,
		typed_expr_semantic_type,
	../../src/compiler/stage_06_typecheck/state:
		TYPECHECK_USER_ORIGIN,
		TypecheckState,
		typecheck_state_for_origin,
	../../src/compiler/stage_06_typecheck/type_system/env:
		FuncOrigin(UserDefinedFunc),
		Purity(Pure),
		ResourceArgPolicy(RejectResourceArgs),
		env_add_func_with_info,
		env_add_var_with_details,
		env_mint_def_id,
		func_symbol,
		VarMutability(ImmutableBinding),
		VarOrigin(LetBinding),
	../../src/compiler/stage_06_typecheck/type_system/generic_params: make_bound_type_param
	../../src/compiler/stage_06_typecheck/type_system/refinement: UNREFINED_BINDING
	../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticDimOp(SemanticDimAdd),
		SemanticType(
			SemanticArrayType,
			SemanticConstIntType,
			SemanticDimOpType,
			SemanticFunctionType,
			SemanticNamedType,
			SemanticTupleType,
			SemanticVarDimsType,
		),
		TYPE_FLOAT,
		TYPE_INT,
		type_to_string,
	../../src/lib/source:
		Cursor,
		SourceFile,
		SourceSpan,
		source_cursor_at,
		source_file,
		source_span,
	hash: crc32, hash_combine
	instrumentation: begin_function_profile_window, end_function_profile_window
	list: list
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private DEFAULT_ITERATIONS: Int = 200

private DEFAULT_INPUT_COUNT: Int = 64

private DEFAULT_EXPANSION_WIDTH: Int = 16

private DEFAULT_RECURSIVE_DEPTH: Int = 1

private PACK_INTERVAL: Int = 4

private MISSING_INTERVAL: Int = 17

private PROFILE_FUNCTION_NAME: String = "profile_var_dims"

private PROFILE_VALUE_NAME: String = "profile_values"


private pure func fixture_source_file() -> SourceFile:
	source_file(
		"compiler_var_dims_resolution_profile.brp",
		"compiler_var_dims_resolution_profile",
		"",
	)


private pure func fixture_source_span() -> SourceSpan:
	src: SourceFile = fixture_source_file()
	cursor: Cursor = source_cursor_at(src, 0)
	source_span(src, cursor, cursor)


private pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, fixture_source_span())


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func non_negative_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value >= 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func profile_dims(expansion_width: Int) -> List[SemanticType]:
	var dims: List[SemanticType] = list(expansion_width)

	for index in 0..expansion_width:
		dims = dims.append(SemanticConstIntType(index + 1))

	dims


private pure func profile_return_dims(input_count: Int) -> List[SemanticType]:
	var dims: List[SemanticType] = list(input_count)

	for index in 0..input_count:
		if index % MISSING_INTERVAL == MISSING_INTERVAL - 1:
			dims = dims.append(SemanticVarDimsType("#Missing"))
		else if index % PACK_INTERVAL == PACK_INTERVAL - 1:
			dims = dims.append(SemanticVarDimsType("#Ds"))
		else:
			dims = dims.append(SemanticConstIntType(index + 1))

	dims


private pure func nested_profile_type(
	dims: List[SemanticType],
	depth: Int,
) -> SemanticType:
	var typ: SemanticType = SemanticArrayType(TYPE_FLOAT, dims)
	var index: Int = 0

	while index < depth:
		typ = SemanticTupleType([
			typ,
			SemanticNamedType("Result", [
				SemanticArrayType(
					TYPE_FLOAT,
					[
						SemanticDimOpType(
							SemanticDimAdd,
							SemanticConstIntType(index + 1),
							SemanticConstIntType(1),
						),
						SemanticVarDimsType("#Ds"),
					],
				),
				SemanticFunctionType(
					True,
					[SemanticArrayType(TYPE_FLOAT, [SemanticVarDimsType("#Ds")])],
					SemanticArrayType(TYPE_FLOAT, [SemanticVarDimsType("#Missing")]),
				),
			]),
		])
		index += 1

	typ


private pure func expected_expansion_count(input_count: Int, recursive_depth: Int) -> Int:
	var count: Int = 0

	for index in 0..input_count:
		if index % MISSING_INTERVAL != MISSING_INTERVAL - 1 and index % PACK_INTERVAL == PACK_INTERVAL - 1:
			count += 1

	count + recursive_depth * 2


private pure func expected_missing_count(input_count: Int, recursive_depth: Int) -> Int:
	var count: Int = 0

	for index in 0..input_count:
		if index % MISSING_INTERVAL == MISSING_INTERVAL - 1:
			count += 1

	count + recursive_depth


private pure func expected_output_dim_count(
	input_count: Int,
	expansion_width: Int,
	recursive_depth: Int,
) -> Int:
	ordinary_count = input_count - expected_expansion_count(input_count, 0) - expected_missing_count(
		input_count,
		0,
	)
	(
		ordinary_count + expected_missing_count(input_count, recursive_depth)
			+ expected_expansion_count(input_count, recursive_depth) * expansion_width
	)


private pure func old_concat_prefix_copy_count(
	input_count: Int,
	expansion_width: Int,
	recursive_depth: Int,
) -> Int:
	var copied: Int = 0
	var prefix: Int = 0

	for index in 0..input_count:
		if index % MISSING_INTERVAL == MISSING_INTERVAL - 1:
			prefix += 1
		else if index % PACK_INTERVAL == PACK_INTERVAL - 1:
			copied += prefix
			prefix += expansion_width
		else:
			prefix += 1

	for _ in 0..recursive_depth:
		copied += 1

	copied


private pure func call_expr() -> ParsedExpr:
	ParsedCallExpr(
		ParsedNameExpr(ident(PROFILE_FUNCTION_NAME)),
		[ParsedNameExpr(ident(PROFILE_VALUE_NAME))],
		fixture_source_span(),
	)


private pure func profile_state(
	input_count: Int,
	expansion_width: Int,
	recursive_depth: Int,
) -> TypecheckState:
	actual_type = SemanticArrayType(TYPE_FLOAT, profile_dims(expansion_width))
	param_type = SemanticArrayType(TYPE_FLOAT, [SemanticVarDimsType("#Ds")])
	return_type = nested_profile_type(profile_return_dims(input_count), recursive_depth)
	initial = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN)
	with_value = env_add_var_with_details(
		initial.env,
		PROFILE_VALUE_NAME,
		actual_type,
		Some(actual_type),
		ImmutableBinding,
		LetBinding,
		UNREFINED_BINDING,
	)
	value_state = { initial | env = with_value }

	match env_mint_def_id(value_state.env):
		(next_env, def_id):
			{ value_state | env = env_add_func_with_info(
					next_env,
					PROFILE_FUNCTION_NAME,
					func_symbol(
						def_id,
						SemanticFunctionType(True, [param_type], return_type),
						[
							make_bound_type_param("#Ds", []),
							make_bound_type_param("#Missing", []),
						],
						[Some(PROFILE_VALUE_NAME)],
						Pure,
						UserDefinedFunc,
						RejectResourceArgs,
						None,
						[],
						None,
						False,
					),
				) }


private pure func checksum_type(typ: SemanticType) -> Int:
	crc32(type_to_string(typ))


func main(args: List[String]) -> Int:
	iterations = positive_argument(args, 1, DEFAULT_ITERATIONS)
	input_count = positive_argument(args, 2, DEFAULT_INPUT_COUNT)
	expansion_width = non_negative_argument(args, 3, DEFAULT_EXPANSION_WIDTH)
	recursive_depth = positive_argument(args, 4, DEFAULT_RECURSIVE_DEPTH)
	state = profile_state(input_count, expansion_width, recursive_depth)
	expr = call_expr()
	warmup = infer_expr(infer_context(state), expr)
	warmup_checksum = checksum_type(typed_expr_semantic_type(warmup.expr))
	var checksum: Int = 0
	var error_count: Int = 0

	reset_mem_stats()
	begin_function_profile_window()
	started = now_microseconds()

	for index in 0..iterations:
		result = infer_expr(infer_context(state), expr)
		checksum = hash_combine(checksum, checksum_type(typed_expr_semantic_type(result.expr)))
		error_count += result.context.state.errors.length()

	elapsed_microseconds = now_microseconds() - started
	end_function_profile_window()
	stats = get_mem_stats()
	expansions = expected_expansion_count(input_count, recursive_depth)
	missing = expected_missing_count(input_count, recursive_depth)
	output_dims = expected_output_dim_count(input_count, expansion_width, recursive_depth)
	old_prefix_copies = old_concat_prefix_copy_count(
		input_count,
		expansion_width,
		recursive_depth,
	)
	workload_valid = (
		iterations > 0
		and input_count > 0
		and expansion_width >= 0
		and error_count == 0
		and warmup.context.state.errors.length() == 0
		and warmup_checksum != 0
		and output_dims >= 0
	)

	print(
		"VAR_DIMS_RESOLUTION_PROFILE" + " iterations=" + iterations.to_string() + " input_count=" + input_count.to_string() + " expansion_width=" + expansion_width.to_string() + " recursive_depth=" + recursive_depth.to_string() + " root_input_visits=" + (iterations * input_count).to_string() + " substitution_lookups=" + (iterations * (expansions + missing)).to_string() + " expansions=" + expansions.to_string() + " missing_expansions=" + missing.to_string() + " concrete_dims_appended=" + (iterations * expansions * expansion_width).to_string() + " old_accumulated_prefix_elements_copied=" + (iterations * old_prefix_copies).to_string() + " resolved_output_dims=" + output_dims.to_string() + " checksum=" + checksum.to_string() + " warmup_checksum=" + warmup_checksum.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + stats.total_allocations.to_string() + " releases=" + stats.total_releases.to_string() + " retained_objects=" + stats.current_objects.to_string() + " allocated_bytes=" + stats.bytes_allocated.to_string() + " workload_valid=" + workload_valid.to_string(),
	)

	if workload_valid:
		0
	else:
		1
