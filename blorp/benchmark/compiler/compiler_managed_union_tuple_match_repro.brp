import:
	test: TestSuite


union Expr:
	Name(String)
	Field(Expr, String)


union Part:
	Literal(String)
	Interpolation(Expr)


pure func expressions_equal(left: Expr, right: Expr) -> Bool:
	match left:
		Name(left_name):
			match right:
				Name(right_name):
					left_name == right_name
				_:
					False
		Field(left_target, left_field):
			match right:
				Field(right_target, right_field):
					expressions_equal(left_target, right_target) and left_field == right_field
				_:
					False


pure func simultaneous_parts_equal(left: List[Part], right: List[Part]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(Literal(left_text)), Some(Literal(right_text))):
					equal = left_text == right_text
				(Some(Interpolation(left_expr)), Some(Interpolation(right_expr))):
					equal = expressions_equal(left_expr, right_expr)
				_:
					equal = False

			index += 1

		equal


pure func nested_parts_equal(left: List[Part], right: List[Part]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal = True
		var index: Int = 0

		while index < left.length() and equal:
			match left.get(index):
				Some(Literal(left_text)):
					match right.get(index):
						Some(Literal(right_text)):
							equal = left_text == right_text
						_:
							equal = False
				Some(Interpolation(left_expr)):
					match right.get(index):
						Some(Interpolation(right_expr)):
							equal = expressions_equal(left_expr, right_expr)
						_:
							equal = False
				None:
					equal = False

			index += 1

		equal


pure func parts() -> List[Part]:
	[
		Literal("before"),
		Interpolation(Field(Name("alpha"), "beta")),
		Literal("between"),
		Interpolation(Name("beta")),
	]


func nested_match_accepts_equal_parts() -> Bool:
	nested_parts_equal(parts(), parts())


func simultaneous_match_accepts_equal_parts() -> Bool:
	left = [
		Literal("before"),
		Interpolation(Field(Name("alpha"), "beta")),
		Literal("between"),
		Interpolation(Name("beta")),
	]
	right = [
		Literal("before"),
		Interpolation(Field(Name("alpha"), "beta")),
		Literal("between"),
		Interpolation(Name("beta")),
	]
	simultaneous_parts_equal(left, right)


tests: TestSuite = {
	description = "Managed union tuple-match reproduction",
	tests = [
		("nested match accepts equal parts", nested_match_accepts_equal_parts),
		("simultaneous match accepts equal parts", simultaneous_match_accepts_equal_parts),
	]
}
