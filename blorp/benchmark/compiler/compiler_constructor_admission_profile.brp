-- Constructor-heavy graph import admission. Graph setup and source-name
-- construction stay outside the measured window.
import:
	../../src/compiler/stage_04_modules/module_table: ModuleId, ModuleTable
	../../src/compiler/stage_06_typecheck/graph/definition_index:
		DefinitionId,
		DefinitionTable,
		definition_index_constructor_definition_ids_for_export,
	../../src/compiler/stage_06_typecheck/graph/indexed_graph:
		prepared_module_scope_definition_index,
		prepared_module_scope_id,
		prepared_module_scope_module_table,
	../../src/compiler/stage_06_typecheck/graph/source_name_table:
		graph_module_name_scope,
		graph_source_name_table,
	../../src/compiler/stage_06_typecheck/modules/module_view:
		GraphSelectiveAdmission(GraphSelectiveAdded),
		ImportedConstructorBinding,
		ModuleView,
		graph_import_admission_begin,
		graph_import_admission_finish,
		graph_import_admission_register_constructor,
		module_view_for_graph,
		module_view_import_bindings,
		module_view_imported_constructors,
	../../test/compiler/typecheck_test_support:
		definition_backed_source_fixture,
		definition_backed_type_fixture_definition_table,
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private record ConstructorAdmissionInput {
	module_table: ModuleTable,
	module_id: ModuleId,
	definition_table: DefinitionTable,
	constructor_ids: List[DefinitionId],
	names: List[String],
	initial_view: ModuleView
}


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func prepare_constructor_admission(width: Int) -> Option[ConstructorAdmissionInput]:
	scope ?= definition_backed_source_fixture("bench/constructor_dep", "union Choice:\n\tDone")
	module_table = prepared_module_scope_module_table(scope)
	module_id = prepared_module_scope_id(scope)
	definition_table = definition_backed_type_fixture_definition_table(scope)
	constructor_ids ?= definition_index_constructor_definition_ids_for_export(
		prepared_module_scope_definition_index(scope),
		module_table,
		module_id,
		"Done",
		"Choice",
	)
	var names: List[String] = []

	for index in 0..width:
		names = names.append("Done_" + index.to_string())

	Some({
		module_table = module_table,
		module_id = module_id,
		definition_table = definition_table,
		constructor_ids = constructor_ids,
		names = names,
		initial_view = module_view_for_graph(
			graph_module_name_scope(
				graph_source_name_table(module_table, names),
				module_id,
			),
		),
	})


private pure func admit_constructors(input: ConstructorAdmissionInput) -> Bool:
	match graph_import_admission_begin(input.initial_view, input.module_table, input.module_id):
		None:
			False
		Some(initial_admission):
			var admission = initial_admission
			var valid = True

			for name in input.names:
				binding: ImportedConstructorBinding = {
					local_name = name,
					module_path = "bench/constructor_dep",
					parent_local_name = "Choice",
					parent_name = "Choice",
					original_name = "Done"
				}

				match graph_import_admission_register_constructor(
					admission,
					input.module_id,
					input.definition_table,
					input.definition_table,
					binding,
					input.module_id,
					input.constructor_ids,
				):
					GraphSelectiveAdded(next):
						admission = next
					_:
						valid = False

			view = graph_import_admission_finish(admission)

			(
				valid
				and module_view_import_bindings(view).length() == input.names.length()
				and module_view_imported_constructors(view).length() == input.names.length()
			)


func main(args: List[String]) -> Int:
	iterations = positive_argument(args, 1, 100)
	width = positive_argument(args, 2, 64)

	match prepare_constructor_admission(width):
		None:
			print("CONSTRUCTOR_ADMISSION_PROFILE status=INVALID_SETUP")
			1
		Some(input):
			reset_mem_stats()
			started = now_microseconds()
			var valid = True

			for _ in 0..iterations:
				if not admit_constructors(input):
					valid = False

			elapsed = now_microseconds() - started
			memory = get_mem_stats()

			status = if valid:
				"OK"
			else:
				"INVALID"

			print(
				"CONSTRUCTOR_ADMISSION_PROFILE status=" + status + " iterations=" + iterations.to_string() + " width=" + width.to_string() + " allocations=" + memory.total_allocations.to_string() + " releases=" + memory.total_releases.to_string() + " retained_objects=" + memory.current_objects.to_string() + " allocated_bytes=" + memory.bytes_allocated.to_string() + " elapsed_microseconds=" + elapsed.to_string(),
			)

			if valid:
				0
			else:
				1
