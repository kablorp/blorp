-- Small deterministic fixture for the debug-only identity-work schema.
import:
	../../src/compiler/identity_work_counters: register_identity_work_counters
	../../src/compiler/stage_06_typecheck/type_system/env: ENV_EMPTY, env_lookup
	../../src/compiler/stage_09_core/ir: CoreVar, core_var_equal
	instrumentation: begin_function_profile_window, end_function_profile_window
	io: print
	memory: get_mem_stats, reset_mem_stats


func main(args: List[String]) -> Int:
	left: CoreVar = { name = "same", id = 1, def_id = None }
	right: CoreVar = { name = "same", id = 1, def_id = None }
	different: CoreVar = { name = "other", id = 2, def_id = None }
	reset_mem_stats()
	begin_function_profile_window()
	debug:
		register_identity_work_counters()
	first_equal: Bool = core_var_equal(left, right)
	second_equal: Bool = core_var_equal(left, different)
	first_lookup_missing: Bool = env_lookup(ENV_EMPTY, "missing").is_none()
	second_lookup_missing: Bool = env_lookup(ENV_EMPTY, "other").is_none()
	end_function_profile_window()
	stats = get_mem_stats()
	if first_equal and not second_equal and first_lookup_missing and second_lookup_missing:
		print("IDENTITY_WORK_PROFILE equality_calls=2 scope_lookup_calls=2 allocations=" + stats.total_allocations.to_string())
		0
	else:
		1
