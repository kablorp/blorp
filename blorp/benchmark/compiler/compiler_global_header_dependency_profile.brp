-- Direct profile of global initializer dependency admission and plan construction.
import:
	compiler_global_header_dependency_profile_fixture:
		CompilerGlobalHeaderDependencyProfileConfig,
		compiler_global_header_dependency_profile_execute,
		compiler_global_header_dependency_profile_fixture,
		compiler_global_header_dependency_profile_observe,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func integer_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			parse_int(text).get_or(default)
		None:
			default


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	value = integer_argument(args, index, default)

	if value > 0:
		value
	else:
		default


func main(args: List[String]) -> Int:
	iterations = positive_argument(args, 1, 10)
	config: CompilerGlobalHeaderDependencyProfileConfig = {
		initializer_count = positive_argument(args, 2, 64),
		references_per_initializer = positive_argument(args, 3, 128),
		duplicate_percent = integer_argument(args, 4, 50),
		module_count = positive_argument(args, 5, 4),
		fan_in = positive_argument(args, 6, 128)
	}

	match compiler_global_header_dependency_profile_fixture(config):
		None:
			print("global header dependency profile fixture construction failed")
			1
		Some(fixture):
			setup_started = now_microseconds()
			warmup = compiler_global_header_dependency_profile_execute(fixture, 1)
			warmup_observation = compiler_global_header_dependency_profile_observe(fixture, warmup)
			setup_microseconds = now_microseconds() - setup_started

			reset_mem_stats()
			begin_function_profile_window()
			started = now_microseconds()
			result = compiler_global_header_dependency_profile_execute(fixture, iterations)
			elapsed_microseconds = now_microseconds() - started
			end_function_profile_window()
			memory = get_mem_stats()
			observation = compiler_global_header_dependency_profile_observe(fixture, result)

			print(
				"GLOBAL_HEADER_DEPENDENCY_PROFILE" + " iterations=" + iterations.to_string() + " initializers=" + fixture.initializer_count.to_string() + " references_per_initializer=" + fixture.references_per_initializer.to_string() + " effective_unique_references=" + fixture.effective_unique_references.to_string() + " modules=" + fixture.module_count.to_string() + " fan_in=" + fixture.fan_in.to_string() + " reference_visits=" + fixture.reference_visits.to_string() + " modeled_list_comparisons=" + fixture.modeled_list_comparisons.to_string() + " modeled_dictionary_probes=" + fixture.modeled_dictionary_probes.to_string() + " expected_dependency_edges=" + fixture.expected_dependency_edges.to_string() + " pending_initializers=" + observation.pending_initializers.to_string() + " annotated_dependencies=" + observation.annotated_dependencies.to_string() + " dependency_edges=" + observation.dependency_edges.to_string() + " checksum=" + observation.checksum.to_string() + " plan_ready=" + observation.plan_ready.to_string() + " workload_valid=" + observation.workload_valid.to_string() + " warmup_checksum=" + warmup_observation.checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + memory.total_allocations.to_string() + " releases=" + memory.total_releases.to_string() + " retained_objects=" + memory.current_objects.to_string() + " allocator_bytes=" + memory.bytes_allocated.to_string(),
			)

			if observation.workload_valid and warmup_observation.workload_valid:
				0
			else:
				2
