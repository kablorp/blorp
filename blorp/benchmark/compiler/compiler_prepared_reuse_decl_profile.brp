-- Isolated profile for prepared-reuse declaration indexing.
--
-- Usage:
--   benchmarks/compiler_prepared_reuse_decl_profile plain 1 256 64 8 256
import:
	../../src/compiler/stage_09_core/ir: CoreProgram
	compiler_prepared_reuse_decl_profile_fixture:
		PreparedReuseLookupAlgorithm(PreparedReuseIndexedLookup, PreparedReuseParentLinearLookup),
		PreparedReuseProfileConfig,
		prepared_reuse_profile_execute,
		prepared_reuse_profile_observe_with_algorithm,
		prepared_reuse_profile_program,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


pure func prepared_reuse_benchmark_lookup_algorithm() -> PreparedReuseLookupAlgorithm:
	PreparedReuseIndexedLookup


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


pure func prepared_reuse_lookup_algorithm_name(algorithm: PreparedReuseLookupAlgorithm) -> String:
	match algorithm:
		PreparedReuseParentLinearLookup:
			"parent-linear"
		PreparedReuseIndexedLookup:
			"indexed"


func main(args: List[String]) -> Int:
	algorithm: PreparedReuseLookupAlgorithm = prepared_reuse_benchmark_lookup_algorithm()
	config: PreparedReuseProfileConfig = {
		iterations = positive_argument(args, 1, 1),
		declarations = positive_argument(args, 2, 256),
		union_count = positive_argument(args, 3, 64),
		variants_per_union = positive_argument(args, 4, 8),
		prepared_match_count = positive_argument(args, 5, 256)
	}

	setup_started: Int = now_microseconds()
	program: CoreProgram = prepared_reuse_profile_program(config)
	warmup_rewritten: CoreProgram = prepared_reuse_profile_execute(program, 1)
	warmup = prepared_reuse_profile_observe_with_algorithm(
		{ config | iterations = 1 },
		program,
		warmup_rewritten,
		algorithm,
	)
	setup_microseconds: Int = now_microseconds() - setup_started

	reset_mem_stats()
	begin_function_profile_window()
	started: Int = now_microseconds()
	rewritten: CoreProgram = prepared_reuse_profile_execute(program, config.iterations)
	elapsed_microseconds: Int = now_microseconds() - started
	end_function_profile_window()
	memory = get_mem_stats()
	result = prepared_reuse_profile_observe_with_algorithm(config, program, rewritten, algorithm)
	workload_valid: Bool = (
		warmup.workload_valid
		and result.workload_valid
		and warmup.semantic_checksum == result.semantic_checksum
	)

	print(
		"PREPARED_REUSE_DECL_PROFILE" + " lookup_algorithm=" + prepared_reuse_lookup_algorithm_name(
			algorithm,
		) + " iterations=" + config.iterations.to_string() + " declarations=" + config.declarations.to_string() + " union_count=" + config.union_count.to_string() + " variants_per_union=" + config.variants_per_union.to_string() + " prepared_match_count=" + config.prepared_match_count.to_string() + " layout_builds=" + result.layout_builds.to_string() + " declarations_indexed=" + result.declarations_indexed.to_string() + " union_entries_written=" + result.union_entries_written.to_string() + " union_lookup_requests=" + result.union_lookup_requests.to_string() + " union_linear_candidates_visited=" + result.union_linear_candidates_visited.to_string() + " variant_lookup_requests=" + result.variant_lookup_requests.to_string() + " variant_linear_candidates_visited=" + result.variant_linear_candidates_visited.to_string() + " prepared_nodes_visited=" + result.prepared_nodes_visited.to_string() + " rewritten_reuse_sites=" + result.rewritten_reuse_sites.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + memory.total_allocations.to_string() + " releases=" + memory.total_releases.to_string() + " retained_objects=" + memory.current_objects.to_string() + " allocator_bytes=" + memory.bytes_allocated.to_string() + " semantic_checksum=" + result.semantic_checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " workload_valid=" + workload_valid.to_string(),
	)

	if workload_valid:
		0
	else:
		1
