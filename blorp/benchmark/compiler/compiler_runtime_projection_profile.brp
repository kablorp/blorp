-- Isolated profile for runtime-declaration projection.
--
-- Usage:
--   bin/blorp run blorp/benchmark/compiler/compiler_runtime_projection_profile.brp -- 0 4096 0 0
--   bin/blorp run blorp/benchmark/compiler/compiler_runtime_projection_profile.brp -- 4096 0 0 0
--   bin/blorp run blorp/benchmark/compiler/compiler_runtime_projection_profile.brp -- 0 0 4096 4
import:
	compiler_runtime_projection_profile_fixture:
		CompilerRuntimeProjectionProfileConfig,
		compiler_runtime_projection_profile_observe_projected_program,
		compiler_runtime_projection_profile_program,
	../../src/compiler/stage_09_core/runtime_projection:
		project_runtime_program,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func nonnegative_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						0
				None:
					default
		None:
			default


func main(args: List[String]) -> Int:
	config: CompilerRuntimeProjectionProfileConfig = {
		iterations = 1,
		generic_declarations = nonnegative_argument(args, 1, 0),
		function_declarations = nonnegative_argument(args, 2, 4096),
		impl_declarations = nonnegative_argument(args, 3, 0),
		methods_per_impl = nonnegative_argument(args, 4, 0)
	}

	setup_started: Int = now_microseconds()
	program = compiler_runtime_projection_profile_program(config)
	setup_microseconds: Int = now_microseconds() - setup_started

	reset_mem_stats()
	begin_function_profile_window()
	started: Int = now_microseconds()
	projection = project_runtime_program(program)
	elapsed_microseconds: Int = now_microseconds() - started
	end_function_profile_window()
	memory = get_mem_stats()

	match projection:
		Ok(projected):
			result = compiler_runtime_projection_profile_observe_projected_program(
				program,
				projected,
				config,
			)
			observation = result.observation

			print(
				"RUNTIME_PROJECTION_PROFILE" + " generic_declarations=" + config.generic_declarations.to_string() + " function_declarations=" + config.function_declarations.to_string() + " impl_declarations=" + config.impl_declarations.to_string() + " methods_per_impl=" + config.methods_per_impl.to_string() + " input_declarations=" + observation.input_declarations.to_string() + " projected_rows=" + observation.projected_rows.to_string() + " canonicalization_calls=" + observation.canonicalization_calls.to_string() + " modeled_legacy_concat_prefix_elements_copied=" + observation.modeled_legacy_concat_prefix_elements_copied.to_string() + " output_checksum=" + observation.output_checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + memory.total_allocations.to_string() + " releases=" + memory.total_releases.to_string() + " retained_objects=" + memory.current_objects.to_string() + " allocator_bytes=" + memory.bytes_allocated.to_string() + " workload_valid=" + result.workload_valid.to_string() + " error_count=" + result.error_count.to_string(),
			)

			if result.workload_valid:
				0
			else:
				1
		Err(_):
			print(
				"RUNTIME_PROJECTION_PROFILE" + " generic_declarations=" + config.generic_declarations.to_string() + " function_declarations=" + config.function_declarations.to_string() + " impl_declarations=" + config.impl_declarations.to_string() + " methods_per_impl=" + config.methods_per_impl.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + memory.total_allocations.to_string() + " releases=" + memory.total_releases.to_string() + " retained_objects=" + memory.current_objects.to_string() + " allocator_bytes=" + memory.bytes_allocated.to_string() + " workload_valid=False error_count=1",
			)
			1
