-- Exercise canonical products, term merging, opaque division, and bind/stuck
-- results with reversed factor order. Expression construction is outside the solver loop.
import:
	../../src/compiler/stage_06_typecheck/type_system/dim_solver:
		DimSolveResult(DimBindMeta, DimBindVar, DimSolved, DimStuck),
		dim_solve,
	../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticDimOp(SemanticDimAdd, SemanticDimDivide, SemanticDimMultiply),
		SemanticType(SemanticConstIntType, SemanticDimOpType, SemanticMetaType, SemanticTypeVar),
	../../src/compiler/stage_06_typecheck/type_system/meta_identity:
		MetaSessionId,
		meta_session_ids_equal,
	memory: get_mem_stats, reset_mem_stats
	meta_profile_support: profile_meta, profile_meta_context, profile_meta_session
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func nested_opaque(product: SemanticType) -> SemanticType:
	SemanticDimOpType(
		SemanticDimAdd,
		SemanticConstIntType(1),
		SemanticDimOpType(
			SemanticDimDivide,
			SemanticDimOpType(
				SemanticDimAdd,
				SemanticConstIntType(1),
				SemanticDimOpType(SemanticDimDivide, product, SemanticConstIntType(3)),
			),
			SemanticConstIntType(5),
		),
	)


private pure func expected_result_count(
	mode: String,
	session: Option[MetaSessionId],
	left: SemanticType,
	right: SemanticType,
	iterations: Int,
) -> Int:
	var matched: Int = 0

	if mode == "meta-bind":
		for _ in 0..iterations:
			match dim_solve(session, [], left, right):
				DimBindMeta(_, meta_id, _):
					if meta_id == 1:
						matched += 1
				_:
					void
	else if mode == "named-bind":
		for _ in 0..iterations:
			match dim_solve(session, [], left, right):
				DimBindVar(name, _):
					if name == "#P":
						matched += 1
				_:
					void
	else if mode == "stuck":
		for _ in 0..iterations:
			match dim_solve(session, [], left, right):
				DimStuck:
					matched += 1
				_:
					void
	else:
		for _ in 0..iterations:
			match dim_solve(session, [], left, right):
				DimSolved:
					matched += 1
				_:
					void

	matched


private pure func binding_solves_equation(
	session: Option[MetaSessionId],
	value: SemanticType,
	remainder: SemanticType,
	right: SemanticType,
) -> Bool:
	match dim_solve(
		session,
		[],
		SemanticDimOpType(SemanticDimAdd, value, remainder),
		right,
	):
		DimSolved:
			True
		_:
			False


private pure func binding_payload_is_valid(
	mode: String,
	session: Option[MetaSessionId],
	left: SemanticType,
	right: SemanticType,
) -> Bool:
	if mode == "meta-bind":
		match (left, dim_solve(session, [], left, right)):
			(SemanticDimOpType(SemanticDimAdd, SemanticMetaType(source_session, source_meta_id), remainder), DimBindMeta(meta_session, meta_id, value)):
				(
					meta_id == 1
					and source_meta_id == meta_id
					and meta_session_ids_equal(source_session, meta_session)
					and binding_solves_equation(session, value, remainder, right)
				)
			_:
				False
	else if mode == "named-bind":
		match (left, dim_solve(session, [], left, right)):
			(SemanticDimOpType(SemanticDimAdd, SemanticTypeVar(source_name), remainder), DimBindVar(name, value)):
				(
					name == "#P"
					and source_name == name
					and binding_solves_equation(session, value, remainder, right)
				)
			_:
				False
	else:
		True


func main(args: List[String]) -> Int:
	width = positive_argument(args, 1, 8)
	iterations = positive_argument(args, 2, 4096)
	mode = args.get_or(3, "plain")
	meta_context = profile_meta_context()
	meta_session = profile_meta_session(meta_context)
	var left = SemanticConstIntType(1)
	var right = SemanticConstIntType(1)

	for index in 0..width:
		factor = SemanticTypeVar("#N" + index.to_string())
		left = SemanticDimOpType(SemanticDimMultiply, left, factor)

	for index in 0..width:
		factor = SemanticTypeVar("#N" + (width - index - 1).to_string())
		right = SemanticDimOpType(SemanticDimMultiply, right, factor)

	if mode == "multiterm":
		left = SemanticDimOpType(
			SemanticDimAdd,
			SemanticDimOpType(SemanticDimAdd, left, left),
			SemanticConstIntType(7),
		)
		right = SemanticDimOpType(
			SemanticDimAdd,
			SemanticDimOpType(SemanticDimMultiply, SemanticConstIntType(2), right),
			SemanticConstIntType(7),
		)
	else if mode == "opaque":
		left = SemanticDimOpType(
			SemanticDimAdd,
			SemanticConstIntType(1),
			SemanticDimOpType(SemanticDimDivide, left, SemanticConstIntType(3)),
		)
		right = SemanticDimOpType(
			SemanticDimAdd,
			SemanticConstIntType(1),
			SemanticDimOpType(SemanticDimDivide, right, SemanticConstIntType(3)),
		)
	else if mode == "mixed":
		left = SemanticDimOpType(SemanticDimMultiply, left, profile_meta(meta_context, 1))
		right = SemanticDimOpType(SemanticDimMultiply, profile_meta(meta_context, 1), right)
	else if mode == "nested":
		left = nested_opaque(left)
		right = nested_opaque(right)
	else if mode == "meta-bind":
		left = SemanticDimOpType(SemanticDimAdd, profile_meta(meta_context, 1), left)
		right = SemanticConstIntType(7)
	else if mode == "named-bind":
		left = SemanticDimOpType(
			SemanticDimAdd,
			SemanticTypeVar("#P"),
			SemanticDimOpType(SemanticDimDivide, left, SemanticConstIntType(3)),
		)
		right = SemanticConstIntType(7)
	else if mode == "stuck":
		left = SemanticDimOpType(
			SemanticDimAdd,
			left,
			SemanticDimOpType(SemanticDimMultiply, SemanticTypeVar("#Q"), SemanticTypeVar("#R")),
		)
		right = SemanticConstIntType(7)

	binding_payload_valid = binding_payload_is_valid(mode, meta_session, left, right)
	reset_mem_stats()
	started = now_microseconds()
	matched = expected_result_count(mode, meta_session, left, right, iterations)

	elapsed = now_microseconds() - started
	memory = get_mem_stats()

	solved = if (
		mode == "meta-bind"
		or mode == "named-bind"
		or mode == "stuck"
	):
		0
	else:
		matched

	print(
		"DIM_CANONICAL_FACTORS mode=${mode} width=${width.to_string()} iterations=${iterations.to_string()} solved=${solved.to_string()} matched=${matched.to_string()} elapsed_microseconds=${elapsed.to_string()} allocations=${memory.total_allocations.to_string()} releases=${memory.total_releases.to_string()} retained_objects=${memory.current_objects.to_string()} retained_bytes=${memory.bytes_allocated.to_string()}",
	)

	valid_mode = (
		mode == "plain"
		or mode == "multiterm"
		or mode == "opaque"
		or mode == "mixed"
		or mode == "nested"
		or mode == "meta-bind"
		or mode == "named-bind"
		or mode == "stuck"
	)

	if (
		matched == iterations
		and valid_mode
		and binding_payload_valid
		and memory.current_objects == 0
		and memory.bytes_allocated == 0
	):
		0
	else:
		1
