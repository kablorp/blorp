-- Isolated function profile for migrated typechecking phases.
--
-- Usage:
--   benchmarks/compiler_typecheck_phase_profile headers
--   benchmarks/compiler_typecheck_phase_profile skeleton 20 8 32 64 4
--   benchmarks/compiler_typecheck_phase_profile accepted 1 16 32 64 4 memory
--   benchmarks/compiler_typecheck_phase_profile accepted 1 64 1 1 4 memory 100 selective
--
-- Positional controls are stage, iterations, modules, shapes per module,
-- probes per module, and import fan-out. Fixture construction validates the
-- complete Phase 1-4 chain before the selected pure phase enters the profile
-- window.
-- The final optional `selective` argument selects one distinct type from
-- each target import module, exercising real import admission at the accepted
-- graph boundary. It is effective only for a fully type-bearing graph.
import:
	../../src/compiler/stage_06_typecheck/graph/source_name_table:
		register_source_name_catalog_work_counters,
	compiler_source_name_catalog_profile_fixture:
		CompilerSourceNameCatalogBenchmarkConfig,
		compiler_source_name_catalog_profile_fixture,
		compiler_source_name_catalog_workload,
	compiler_type_header_mixed_profile_fixture:
		CompilerMixedTypeHeaderBenchmarkConfig,
		compiler_mixed_type_header_phase_profile_fixture,
		compiler_mixed_type_header_selective_phase_profile_fixture,
		compiler_sparse_type_header_phase_profile_fixture,
	compiler_typecheck_phase_profile_fixture:
		CompilerTypecheckPhaseProfileRun(
			CompilerTypecheckPhaseProfileCompleted,
			CompilerTypecheckPhaseProfileInvariantFailed,
		),
		CompilerTypecheckProfileStage(
			CompilerProfileAcceptedGraph,
			CompilerProfileAliasDependencies,
			CompilerProfileBoundModules,
			CompilerProfileCheckedBodies,
			CompilerProfileCallableHeaders,
			CompilerProfileDeclarationSkeletons,
			CompilerProfileImplementationHeaders,
			CompilerProfileIndexedGraph,
			CompilerProfileImportableModules,
			CompilerProfileResolvedTypeParameters,
			CompilerProfileTraitTopology,
			CompilerProfileTypeHeaders,
		),
		compiler_typecheck_phase_profile_build_source_names,
		compiler_typecheck_phase_profile_execute,
		compiler_typecheck_phase_profile_observe,
		compiler_typecheck_phase_profile_observe_built_source_names,
		compiler_typecheck_phase_profile_observe_constructor_lookup_work,
		compiler_typecheck_phase_profile_observe_source_names,
		compiler_typecheck_phase_profile_plan,
		compiler_typecheck_phase_profile_source_name_input,
		compiler_typecheck_phase_profile_stage_name,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func integer_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			parse_int(text).get_or(default)
		None:
			default


private pure func type_bearing_module_count(module_count: Int, type_bearing_percent: Int) -> Int:
	if type_bearing_percent <= 0:
		0
	else if type_bearing_percent >= 100:
		module_count
	else:
		(module_count * type_bearing_percent + 99) / 100


private pure func profile_stage_argument(text: String) -> Option[CompilerTypecheckProfileStage]:
	match text:
		"indexed":
			Some(CompilerProfileIndexedGraph)
		"importable":
			Some(CompilerProfileImportableModules)
		"bound":
			Some(CompilerProfileBoundModules)
		"skeleton":
			Some(CompilerProfileDeclarationSkeletons)
		"aliases":
			Some(CompilerProfileAliasDependencies)
		"parameters":
			Some(CompilerProfileResolvedTypeParameters)
		"headers":
			Some(CompilerProfileTypeHeaders)
		"topology":
			Some(CompilerProfileTraitTopology)
		"callables":
			Some(CompilerProfileCallableHeaders)
		"implementations":
			Some(CompilerProfileImplementationHeaders)
		"accepted":
			Some(CompilerProfileAcceptedGraph)
		"bodies":
			Some(CompilerProfileCheckedBodies)
		_:
			None


private func run_phase_profile(args: List[String], stage: CompilerTypecheckProfileStage) -> Int:
	iterations = positive_argument(args, 2, 10)
	measure_memory = args
		.get(7)
		.get_or("") == "memory"
	type_bearing_percent = integer_argument(args, 8, 100)
	selective_target_imports = args
		.get(9)
		.get_or("") == "selective"

	target_import_kind = if selective_target_imports and type_bearing_percent == 100:
		"selective"
	else:
		"qualified"

	config: CompilerMixedTypeHeaderBenchmarkConfig = {
		iterations = 1,
		module_count = positive_argument(args, 3, 8),
		shapes_per_module = positive_argument(args, 4, 32),
		probes_per_module = positive_argument(args, 5, 64),
		import_fanout = positive_argument(args, 6, 4),
		retain_parsed_programs = True
	}
	type_bearing_modules = type_bearing_module_count(config.module_count, type_bearing_percent)
	expected_module_slots = config.module_count + 1

	effective_import_fanout = if type_bearing_percent == 100:
		config.import_fanout
	else:
		0

	setup_started = now_microseconds()

	fixture_result = if selective_target_imports and type_bearing_percent == 100:
		compiler_mixed_type_header_selective_phase_profile_fixture(config)
	else if type_bearing_percent == 100:
		compiler_mixed_type_header_phase_profile_fixture(config)
	else:
		compiler_sparse_type_header_phase_profile_fixture(config, type_bearing_percent)

	setup_microseconds = now_microseconds() - setup_started

	match (fixture_result, compiler_typecheck_phase_profile_plan(stage, iterations)):
		(Err(errors), _):
			print("typecheck phase profile fixture failed: " + errors.join("; "))
			1
		(_, None):
			print("typecheck phase profile iterations must be positive")
			2
		(Ok(fixture), Some(plan)):
			constructor_lookup_work = compiler_typecheck_phase_profile_observe_constructor_lookup_work(
				fixture,
			)

			if measure_memory:
				reset_mem_stats()

			started = now_microseconds()
			begin_function_profile_window()
			execution = compiler_typecheck_phase_profile_execute(fixture, plan)
			end_function_profile_window()
			window_elapsed_microseconds = now_microseconds() - started

			memory_summary = if measure_memory:
				memory = get_mem_stats()
				" total_allocations=" + memory.total_allocations.to_string() + " total_releases=" + memory.total_releases.to_string() + " retained_objects=" + memory.current_objects.to_string() + " allocated_bytes=" + memory.bytes_allocated.to_string()
			else:
				" memory_measurement=disabled"

			result = compiler_typecheck_phase_profile_observe(execution)

			match result:
				CompilerTypecheckPhaseProfileInvariantFailed(errors):
					print("typecheck phase profile invariant failed: " + errors.join("; "))
					1
				CompilerTypecheckPhaseProfileCompleted(observation):
					print(
						"TYPECHECK_PHASE_PROFILE" + " target_imports=" + target_import_kind + " stage=" + compiler_typecheck_phase_profile_stage_name(
							observation.stage,
						) + " iterations=" + observation.iterations.to_string() + " modules=" + config.module_count.to_string() + " shapes_per_module=" + config.shapes_per_module.to_string() + " probes_per_module=" + config.probes_per_module.to_string() + " requested_import_fanout=" + config.import_fanout.to_string() + " effective_import_fanout=" + effective_import_fanout.to_string() + " type_bearing_percent=" + type_bearing_percent.to_string() + " type_bearing_modules=" + type_bearing_modules.to_string() + " expected_module_slots=" + expected_module_slots.to_string() + " primary_outputs=" + observation.primary_output_count.to_string() + " secondary_outputs=" + observation.secondary_output_count.to_string() + " accepted_constructor_rows=" + observation.accepted_constructor_rows.to_string() + " accepted_field_rows=" + observation.accepted_field_rows.to_string() + " checksum=" + observation.checksum.to_string() + " constructor_lookup_requests=" + constructor_lookup_work.constructor_lookup_requests.to_string() + " constructor_name_chain_candidates_visited=" + constructor_lookup_work.constructor_name_chain_candidates_visited.to_string() + " constructor_graph_wide_projections=" + constructor_lookup_work.constructor_graph_wide_projections.to_string() + " constructor_projection_skeletons_visited=" + constructor_lookup_work.constructor_projection_skeletons_visited.to_string() + " constructor_lookup_checksum=" + constructor_lookup_work.checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " window_elapsed_microseconds=" + window_elapsed_microseconds.to_string() + memory_summary,
					)
					0


private func run_source_name_catalog_profile(args: List[String]) -> Int:
	iterations = positive_argument(args, 2, 10)
	config: CompilerSourceNameCatalogBenchmarkConfig = {
		module_count = integer_argument(args, 3, 32),
		unique_names_per_module = integer_argument(args, 4, 32),
		shared_names_per_module = integer_argument(args, 5, 8),
		import_count = integer_argument(args, 6, 8),
		symbols_per_import = integer_argument(args, 7, 4),
		constructors_per_symbol = integer_argument(args, 8, 4)
	}
	measure_memory = args
		.get(9)
		.get_or("") == "memory"
	workload = compiler_source_name_catalog_workload(config)
	setup_started = now_microseconds()
	fixture_result = compiler_source_name_catalog_profile_fixture(config)
	setup_microseconds = now_microseconds() - setup_started

	match fixture_result:
		Err(errors):
			print("source-name catalog profile fixture failed: " + errors.join("; "))
			1
		Ok(fixture):
			expected_names = compiler_typecheck_phase_profile_observe_source_names(fixture)
			input = compiler_typecheck_phase_profile_source_name_input(fixture)

			if measure_memory:
				reset_mem_stats()

			started = now_microseconds()
			begin_function_profile_window()

			debug:
				register_source_name_catalog_work_counters()

			var built_names = compiler_typecheck_phase_profile_build_source_names(input)
			var iteration: Int = 1

			while iteration < iterations:
				built_names = compiler_typecheck_phase_profile_build_source_names(input)
				iteration += 1

			end_function_profile_window()
			window_elapsed_microseconds = now_microseconds() - started
			actual_names = compiler_typecheck_phase_profile_observe_built_source_names(built_names)

			memory_summary = if measure_memory:
				memory = get_mem_stats()
				" total_allocations=${memory.total_allocations} total_releases=${memory.total_releases} retained_objects=${memory.current_objects} allocated_bytes=${memory.bytes_allocated}"
			else:
				" memory_measurement=disabled"

			workload_valid = (
				expected_names.order_is_total
				and actual_names.order_is_total
				and expected_names.name_count == workload.unique_candidates
				and actual_names.name_count == expected_names.name_count
				and actual_names.ordered_checksum == expected_names.ordered_checksum
			)

			print(
				"SOURCE_NAME_CATALOG_PROFILE iterations=${iterations} modules=${config.module_count} unique_names_per_module=${config.unique_names_per_module} shared_names_per_module=${config.shared_names_per_module} requested_imports=${config.import_count} effective_imports=${workload.effective_import_count} symbols_per_import=${config.symbols_per_import} constructors_per_symbol=${config.constructors_per_symbol} candidates=${workload.total_candidates} unique_candidates=${workload.unique_candidates} duplicate_candidates=${workload.duplicate_candidates} actual_names=${actual_names.name_count} ordered_checksum=${actual_names.ordered_checksum} order_is_total=${actual_names.order_is_total} workload_valid=${workload_valid} setup_microseconds=${setup_microseconds} window_elapsed_microseconds=${window_elapsed_microseconds}${memory_summary}",
			)

			if workload_valid:
				0
			else:
				1


private func print_usage() -> Int:
	print((
			"usage: compiler_typecheck_phase_profile source-names|indexed|importable|bound|sk"
			+ "eleton|aliases|parameters|headers|topology|callables|implementations|accepted|bo"
			+ "dies [iterations] [modules] [shapes] [probes] [fanout] [memory] "
		) + "[type-bearing-percent] [selective]\nsource-names controls: [iterations] [modules] " + "[unique-names] [shared-names] [imports] [symbols] [constructors] [memory]")
	2


func main(args: List[String]) -> Int:
	match args.get(1):
		None:
			print_usage()
		Some(text):
			if text == "source-names":
				run_source_name_catalog_profile(args)
			else:
				match profile_stage_argument(text):
					None:
						print_usage()
					Some(stage):
						run_phase_profile(args, stage)
