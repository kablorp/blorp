-- Function-profiled callable-header registration workload.
--
-- Positional controls: iterations, modules, headers per module, parameters
-- per header, dimension constraints per header, and parsed-program mode
-- (`retained` or `fallback`). Fixture construction is outside the profile and
-- allocation windows; the printed counters cover only typecheck_graph calls.
import:
	compiler_callable_header_profile_fixture:
		CompilerCallableHeaderBenchmarkConfig,
		CompilerCallableHeaderBenchmarkResult,
		compiler_callable_header_benchmark_request,
		compiler_callable_header_benchmark_with_request,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func non_negative_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value >= 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func retain_parsed_programs_argument(args: List[String], index: Int) -> Bool:
	match args.get(index):
		Some("fallback"):
			False
		_:
			True


private func print_result(
	config: CompilerCallableHeaderBenchmarkConfig,
	result: CompilerCallableHeaderBenchmarkResult,
	setup_microseconds: Int,
	elapsed_microseconds: Int,
	allocations: Int,
	bytes_allocated: Int,
) -> Int:
	print(
		"CALLABLE_HEADER_PROFILE_BENCH" + " iterations=" + config.iterations.to_string()
			+ " modules=" + config.module_count.to_string() + " headers_per_module="
			+ config.headers_per_module.to_string() + " parameters_per_header="
			+ config.parameters_per_header.to_string() + " dimension_constraints_per_header="
			+ config.dimension_constraints_per_header.to_string() + " retain_parsed_programs="
			+ config.retain_parsed_programs.to_string() + " artifacts=" + result.artifact_count.to_string()
			+ " valid_headers=" + result.valid_header_count.to_string() + " source_declarations="
			+ result.source_declaration_count.to_string() + " typed_declarations="
			+ result.typed_declaration_count.to_string() + " errors=" + result.error_count.to_string()
			+ " workload_valid=" + result.workload_valid.to_string() + " checksum="
			+ result.checksum.to_string() + " allocations=" + allocations.to_string() + " bytes_allocated="
			+ bytes_allocated.to_string() + " setup_microseconds=" + setup_microseconds.to_string()
			+ " elapsed_microseconds=" + elapsed_microseconds.to_string(),
	)

	if result.error_count == 0 and result.workload_valid:
		0
	else:
		1


func main(args: List[String]) -> Int:
	config: CompilerCallableHeaderBenchmarkConfig = {
		iterations = positive_argument(args, 1, 1),
		module_count = positive_argument(args, 2, 1),
		headers_per_module = positive_argument(args, 3, 128),
		parameters_per_header = non_negative_argument(args, 4, 4),
		dimension_constraints_per_header = non_negative_argument(args, 5, 2),
		retain_parsed_programs = retain_parsed_programs_argument(args, 6)
	}
	setup_started = now_microseconds()
	request = compiler_callable_header_benchmark_request(config)
	setup_microseconds = now_microseconds() - setup_started
	begin_function_profile_window()
	reset_mem_stats()
	started = now_microseconds()
	result = compiler_callable_header_benchmark_with_request(config, request)
	elapsed_microseconds = now_microseconds() - started
	end_function_profile_window()
	stats = get_mem_stats()
	print_result(
		config,
		result,
		setup_microseconds,
		elapsed_microseconds,
		stats.total_allocations,
		stats.bytes_allocated,
	)
