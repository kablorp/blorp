-- Retained small-product layout probe for the compact-expression schema oracle.
import:
	../../src/compiler/stage_03_parse/compact_expression_product:
		compact_expression_oracle_counts,
		compact_expression_oracle_from_parsed_roots,
		compact_expression_oracle_reference_traversal_counts,
	../../src/compiler/stage_03_parse/parsed_ast:
		ParsedBinaryOp(ParsedAddOp),
		ParsedDictEntry,
		ParsedDimBinaryOp(ParsedDimAddOp),
		ParsedExpr(
			ParsedAscriptionExpr,
			ParsedBinaryExpr,
			ParsedBlockExpr,
			ParsedDictExpr,
			ParsedDebugBlockExpr,
			ParsedFieldAccessExpr,
			ParsedForExpr,
			ParsedIfExpr,
			ParsedListExpr,
			ParsedMatchExpr,
			ParsedNameExpr,
			ParsedRecordUpdateExpr,
			ParsedSelectExpr,
			ParsedSubscriptExpr,
			ParsedStringInterpolationPartsExpr,
			ParsedTupleExpr,
			ParsedVectorExpr,
			ParsedVarDeclExpr,
			ParsedWhileExpr,
			ParsedWithExpr,
		),
		ParsedForBinder(ParsedForTupleBinder),
		ParsedListPatternSpread(ParsedListSpreadName, ParsedListSpreadWildcard),
		ParsedPattern(
			ParsedBoolPattern,
			ParsedConstructorPattern,
			ParsedIntPattern,
			ParsedListPattern,
			ParsedNamePattern,
			ParsedOrPattern,
			ParsedQualifiedConstructorPattern,
			ParsedTuplePattern,
			ParsedWildcardPattern,
		),
		ParsedRecordExprField,
		ParsedSelectArmKind(ParsedSelectAfterArm, ParsedSelectReceiveArm, ParsedSelectSealedArm),
		ParsedStringInterpolationPart(ParsedInterpolationExpr, ParsedInterpolationLiteral),
		ParsedTypeExpr(
			ParsedArrayType,
			ParsedDimBinaryType,
			ParsedDimLiteralType,
			ParsedDimNameType,
			ParsedFunctionType,
			ParsedNamedType,
			ParsedQualifiedNamedType,
		),
		ParsedWithBindingKind(ParsedWithPlainBinding, ParsedWithTryBinding),
		parsed_identifier,
	../../src/lib/source:
		SourceFile,
		SourceLocation,
		source_cursor_at,
		source_file,
		source_location_for_file,
	memory: get_mem_stats, print_live_object_summary, reset_mem_stats, size_of


pure func probe_source() -> SourceFile:
	source_file("schema_probe.brp", "schema_probe", "alpha beta gamma delta")


pure func name_expr(source: SourceFile, text: String, start: Int) -> ParsedExpr:
	ParsedNameExpr(
		parsed_identifier(
			text,
			source_location_for_file(
				source,
				source_cursor_at(source, start),
				source_cursor_at(source, start + text.length()),
			),
		),
	)


pure func binary_expr(source: SourceFile) -> ParsedExpr:
	ParsedBinaryExpr(
		ParsedAddOp,
		name_expr(source, "alpha", 0),
		name_expr(source, "beta", 6),
		source_location_for_file(
			source,
			source_cursor_at(source, 0),
			source_cursor_at(source, 10),
		),
	)


pure func probe_span(source: SourceFile, start: Int, finish: Int) -> SourceLocation:
	source_location_for_file(
		source,
		source_cursor_at(source, start),
		source_cursor_at(source, finish),
	)


pure func nested_aggregate_roots(source: SourceFile) -> List[ParsedExpr]:
	alpha = name_expr(source, "alpha", 0)
	beta = name_expr(source, "beta", 6)
	gamma = name_expr(source, "gamma", 11)
	delta = name_expr(source, "delta", 17)
	wide_items = [alpha, beta, gamma, delta, alpha, beta, gamma, delta]
	first_field: ParsedRecordExprField = {
		name = parsed_identifier(
			"beta",
			probe_span(source, 6, 10),
		),
		value = ParsedListExpr(
			wide_items,
			probe_span(source, 0, 22),
		),
		span = probe_span(source, 0, 22)
	}
	second_field: ParsedRecordExprField = {
		name = parsed_identifier(
			"gamma",
			probe_span(source, 11, 16),
		),
		value = ParsedSubscriptExpr(
			alpha,
			[beta, gamma],
			probe_span(
				source,
				0,
				16,
			),
		),
		span = probe_span(source, 0, 16)
	}
	first_entry: ParsedDictEntry = {
		key = ParsedTupleExpr(
			[alpha, beta],
			probe_span(
				source,
				0,
				10,
			),
		),
		value = ParsedVectorExpr(
			wide_items,
			probe_span(source, 0, 22),
		),
		span = probe_span(source, 0, 22)
	}
	second_entry: ParsedDictEntry = {
		key = ParsedFieldAccessExpr(
			alpha,
			parsed_identifier(
				"beta",
				probe_span(source, 6, 10),
			),
			probe_span(source, 0, 10),
		),
		value = ParsedListExpr(
			[gamma, delta],
			probe_span(
				source,
				11,
				22,
			),
		),
		span = probe_span(source, 0, 22)
	}

	[
		ParsedRecordUpdateExpr(
			alpha,
			[first_field, second_field],
			probe_span(
				source,
				0,
				22,
			),
		),
		ParsedDictExpr(
			[first_entry, second_entry],
			probe_span(
				source,
				0,
				22,
			),
		),
	]


pure func nested_type_interpolation_root(source: SourceFile) -> ParsedExpr:
	alpha = name_expr(source, "alpha", 0)
	beta = name_expr(source, "beta", 6)
	int_type = ParsedNamedType(
		parsed_identifier(
			"Int",
			probe_span(source, 0, 5),
		),
		[],
		probe_span(source, 0, 5),
	)
	qualified_type = ParsedQualifiedNamedType(
		parsed_identifier(
			"alpha",
			probe_span(source, 0, 5),
		),
		parsed_identifier(
			"beta",
			probe_span(source, 6, 10),
		),
		[int_type],
		probe_span(source, 0, 10),
	)
	array_type = ParsedArrayType(
		int_type,
		[ParsedDimBinaryType(
				ParsedDimAddOp,
				ParsedDimNameType(
					parsed_identifier(
						"gamma",
						probe_span(source, 11, 16),
					),
					False,
					probe_span(source, 11, 16),
				),
				ParsedDimLiteralType(
					"4",
					probe_span(source, 17, 22),
				),
				probe_span(source, 11, 22),
			)],
		probe_span(source, 0, 22),
	)
	function_type = ParsedFunctionType(
		True,
		[qualified_type],
		array_type,
		probe_span(source, 0, 22),
	)
	interpolation = ParsedStringInterpolationPartsExpr(
		[
			ParsedInterpolationLiteral("before"),
			ParsedInterpolationExpr(
				ParsedFieldAccessExpr(
					alpha,
					parsed_identifier(
						"beta",
						probe_span(source, 6, 10),
					),
					probe_span(source, 0, 10),
				),
			),
			ParsedInterpolationLiteral("after"),
			ParsedInterpolationExpr(beta),
		],
		False,
		probe_span(
			source,
			0,
			22,
		),
	)

	ParsedAscriptionExpr(
		interpolation,
		function_type,
		probe_span(source, 0, 22),
	)


pure func wide_sequential_scope_root(source: SourceFile, binding_count: Int) -> ParsedExpr:
	var items: List[ParsedExpr] = []
	var index: Int = 0
	shared_span = probe_span(source, 0, 5)

	while index < binding_count:
		items = items.append(
			ParsedVarDeclExpr(
				parsed_identifier("local" + index.to_string(), shared_span),
				None,
				ParsedNameExpr(parsed_identifier("seed", shared_span)),
				False,
				shared_span,
			),
		)
		index += 1

	index = 0

	while index < binding_count:
		items = items.append(ParsedNameExpr(parsed_identifier("local0", shared_span)))
		index += 1

	ParsedBlockExpr(items, shared_span)


pure func simple_control_root(source: SourceFile) -> ParsedExpr:
	alpha = name_expr(source, "alpha", 0)
	beta = name_expr(source, "beta", 6)
	gamma_identifier = parsed_identifier(
		"gamma",
		probe_span(source, 11, 16),
	)
	delta_identifier = parsed_identifier(
		"delta",
		probe_span(source, 17, 22),
	)
	control_span = probe_span(source, 0, 22)

	ParsedBlockExpr(
		[
			ParsedIfExpr(alpha, beta, Some(alpha), control_span),
			ParsedDebugBlockExpr(beta, control_span),
			ParsedWhileExpr(alpha, beta, control_span),
			ParsedForExpr(
				ParsedForTupleBinder(
					[gamma_identifier, delta_identifier],
					probe_span(
						source,
						11,
						22,
					),
				),
				alpha,
				ParsedNameExpr(gamma_identifier),
				control_span,
			),
		],
		control_span,
	)


pure func pattern_match_root(source: SourceFile) -> ParsedExpr:
	match_span = probe_span(source, 0, 22)
	alpha = parsed_identifier(
		"alpha",
		probe_span(source, 0, 5),
	)

	beta = parsed_identifier(
		"beta",
		probe_span(source, 6, 10),
	)
	gamma = parsed_identifier(
		"gamma",
		probe_span(source, 11, 16),
	)
	delta = parsed_identifier(
		"delta",
		probe_span(source, 17, 22),
	)

	ParsedMatchExpr(
		ParsedNameExpr(alpha),
		[
			{
				pattern = ParsedTuplePattern(
					[
						ParsedConstructorPattern(beta, [ParsedNamePattern(gamma)], match_span),
						ParsedQualifiedConstructorPattern(
							alpha,
							beta,
							[ParsedWildcardPattern(match_span)],
							match_span,
						),
						ParsedListPattern(
							[ParsedNamePattern(alpha), ParsedIntPattern("1", match_span)],
							Some(ParsedListSpreadName(delta)),
							match_span,
						),
						ParsedListPattern(
							[ParsedBoolPattern(True, match_span)],
							Some(ParsedListSpreadWildcard(match_span)),
							match_span,
						),
						ParsedOrPattern(
							[ParsedNamePattern(beta), ParsedWildcardPattern(match_span)],
							match_span,
						),
					],
					match_span,
				),
				body = ParsedNameExpr(gamma),
				span = match_span
			},
		],
		match_span,
	)


pure func select_with_roots(source: SourceFile) -> List[ParsedExpr]:
	common_span = probe_span(source, 0, 22)
	alpha = parsed_identifier(
		"alpha",
		probe_span(source, 0, 5),
	)
	beta = parsed_identifier(
		"beta",
		probe_span(source, 6, 10),
	)
	gamma = parsed_identifier(
		"gamma",
		probe_span(source, 11, 16),
	)
	delta = parsed_identifier(
		"delta",
		probe_span(source, 17, 22),
	)
	int_type = ParsedNamedType(alpha, [], common_span)

	[
		ParsedSelectExpr(
			[
				{
					kind = ParsedSelectReceiveArm(gamma, ParsedNameExpr(alpha)),
					body = ParsedNameExpr(gamma),
					span = common_span
				},
				{
					kind = ParsedSelectSealedArm(ParsedNameExpr(beta)),
					body = ParsedNameExpr(delta),
					span = common_span
				},
				{
					kind = ParsedSelectAfterArm(ParsedNameExpr(delta)),
					body = ParsedNameExpr(alpha),
					span = common_span
				},
			],
			common_span,
		),
		ParsedWithExpr(
			{
				name = gamma,
				type_expr = Some(int_type),
				value = ParsedNameExpr(alpha),
				kind = ParsedWithTryBinding,
				error_map = Some({
					name = delta,
					value = ParsedNameExpr(delta),
					span = common_span,
				}),
				span = common_span
			},
			ParsedNameExpr(gamma),
			common_span,
		),
	]


func measure_case(label: String, source: SourceFile, roots: List[ParsedExpr]) -> Bool:
	reset_mem_stats()

	match compact_expression_oracle_from_parsed_roots(source, roots):
		Ok(product):
			stats = get_mem_stats()
			product_abi_bytes = size_of(product)
			reference_counts = compact_expression_oracle_reference_traversal_counts(product)
			print_live_object_summary()
			counts = compact_expression_oracle_counts(product)
			print(
				"COMPACT_EXPRESSION_SCHEMA" + " case=" + label + " roots=" + counts.root_count.to_string() + " nodes=" + counts.node_count.to_string() + " children=" + counts.child_count.to_string() + " texts=" + counts.text_count.to_string() + " text_rows=" + counts.text_payload_count.to_string() + " string_rows=" + counts.string_payload_count.to_string() + " interpolation_rows=" + counts.interpolation_payload_count.to_string() + " bool_rows=" + counts.bool_payload_count.to_string() + " char_rows=" + counts.char_payload_count.to_string() + " operator_rows=" + counts.operator_payload_count.to_string() + " call_rows=" + counts.call_payload_count.to_string() + " field_access_rows=" + counts.field_access_payload_count.to_string() + " record_rows=" + counts.record_payload_count.to_string() + " record_field_rows=" + counts.record_field_count.to_string() + " dict_rows=" + counts.dict_payload_count.to_string() + " dict_entry_rows=" + counts.dict_entry_count.to_string() + " type_nodes=" + counts.type_node_count.to_string() + " type_children=" + counts.type_child_count.to_string() + " type_identifier_slices=" + counts.type_identifier_slice_count.to_string() + " type_identifiers=" + counts.type_identifier_count.to_string() + " interpolation_parts_rows=" + counts.interpolation_parts_payload_count.to_string() + " interpolation_part_rows=" + counts.interpolation_part_count.to_string() + " control_identifiers=" + counts.control_identifier_count.to_string() + " identifier_slices=" + counts.identifier_slice_count.to_string() + " typed_binders=" + counts.typed_binder_count.to_string() + " pattern_nodes=" + counts.pattern_node_count.to_string() + " pattern_children=" + counts.pattern_child_count.to_string() + " pattern_identifier_slices=" + counts.pattern_identifier_slice_count.to_string() + " pattern_identifiers=" + counts.pattern_identifier_count.to_string() + " match_cases=" + counts.match_case_count.to_string() + " select_arms=" + counts.select_arm_count.to_string() + " with_bindings=" + counts.with_binding_count.to_string() + " with_error_maps=" + counts.with_error_map_count.to_string() + " unit_rows=" + counts.unit_payload_count.to_string() + " references=" + reference_counts.reference_count.to_string() + " bound_name_comparisons=" + reference_counts.bound_name_comparison_count.to_string() + " allocations=" + stats.total_allocations.to_string() + " releases=" + stats.total_releases.to_string() + " retained_objects=" + stats.current_objects.to_string() + " current_live_bytes=" + stats.bytes_allocated.to_string() + " product_abi_bytes=" + product_abi_bytes.to_string(),
			)
			True
		Err(_):
			False


func measure_legacy_small_module(source: SourceFile, root_count: Int) -> Bool:
	reset_mem_stats()
	var roots: List[ParsedExpr] = []
	var index: Int = 0

	while index < root_count:
		roots = roots.append(binary_expr(source))
		index += 1

	stats = get_mem_stats()
	shallow_bytes = size_of(roots)
	print_live_object_summary()
	print("COMPACT_EXPRESSION_SCHEMA" + " case=legacy_tree_small_module" + " roots=" + roots
			.length()
			.to_string() + " allocations=" + stats.total_allocations.to_string() + " releases=" + stats.total_releases.to_string() + " retained_objects=" + stats.current_objects.to_string() + " current_live_bytes=" + stats.bytes_allocated.to_string() + " shallow_bytes=" + shallow_bytes.to_string())

	roots.length() == root_count


func main(_args: List[String]) -> Int:
	source = probe_source()
	scalar = name_expr(source, "alpha", 0)
	binary = binary_expr(source)
	var small_module_roots: List[ParsedExpr] = []
	var index: Int = 0

	while index < 16:
		small_module_roots = small_module_roots.append(binary)
		index += 1

	valid = (
		measure_case("empty", source, [])
		and measure_case("scalar", source, [scalar])
		and measure_case("binary", source, [binary])
		and measure_case("small_module", source, small_module_roots)
		and measure_case("nested_aggregates", source, nested_aggregate_roots(source))
		and measure_case(
			"nested_type_interpolation",
			source,
			[nested_type_interpolation_root(source)],
		)
		and measure_case("simple_control", source, [simple_control_root(source)])
		and measure_case("pattern_match", source, [pattern_match_root(source)])
		and measure_case("select_with", source, select_with_roots(source))
		and measure_case("wide_sequential_scope", source, [wide_sequential_scope_root(source, 64)])
		and measure_legacy_small_module(source, 16)
	)

	if valid:
		0
	else:
		1
