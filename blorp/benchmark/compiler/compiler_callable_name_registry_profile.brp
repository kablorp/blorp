-- Isolated callable-name registry profile runner.
import:
	compiler_callable_name_registry_profile_fixture:
		CompilerCallableNameRegistryProfileConfig,
		CompilerCallableNameRegistryProfileRequest,
		CompilerCallableNameRegistryProfileResult,
		CompilerCallableNameRegistryProfileShape(
			ImplCallableProfileShape,
			PrivateCallableProfileShape,
			TopLevelCallableProfileShape,
		),
		compiler_callable_name_registry_profile_for_shape,
		compiler_callable_name_registry_profile_request_for_shape,
		compiler_callable_name_registry_profile_with_request,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func profile_shape(args: List[String]) -> CompilerCallableNameRegistryProfileShape:
	match args.get(4):
		Some("private"):
			PrivateCallableProfileShape
		Some("impl"):
			ImplCallableProfileShape
		_:
			TopLevelCallableProfileShape


private pure func profile_shape_name(shape: CompilerCallableNameRegistryProfileShape) -> String:
	match shape:
		TopLevelCallableProfileShape:
			"top"
		PrivateCallableProfileShape:
			"private"
		ImplCallableProfileShape:
			"impl"


func main(args: List[String]) -> Int:
	config: CompilerCallableNameRegistryProfileConfig = {
		iterations = 1,
		module_count = positive_argument(args, 2, 1),
		total_callables = positive_argument(args, 3, 4096)
	}
	shape = profile_shape(args)

	setup_started: Int = now_microseconds()
	request: Option[CompilerCallableNameRegistryProfileRequest] = compiler_callable_name_registry_profile_request_for_shape(
		config,
		shape,
	)

	setup_checksum: Int = match request:
		Some(prebuilt):
			prebuilt.next_def_id + prebuilt.total_callables
		None:
			0

	setup_microseconds: Int = now_microseconds() - setup_started

	reset_mem_stats()
	begin_function_profile_window()
	started: Int = now_microseconds()

	result: CompilerCallableNameRegistryProfileResult = match request:
		Some(prebuilt):
			compiler_callable_name_registry_profile_with_request(config, prebuilt)
		None:
			compiler_callable_name_registry_profile_for_shape(config, shape)

	elapsed_microseconds: Int = now_microseconds() - started
	end_function_profile_window()
	stats = get_mem_stats()

	print(
		"CALLABLE_NAME_REGISTRY_PROFILE" + " invocations=" + config.iterations.to_string() + " shape=" + profile_shape_name(
			shape,
		) + " modules=" + config.module_count.to_string() + " total_callables=" + config.total_callables.to_string() + " registered_callables=" + result.registered_callables.to_string() + " output_declarations=" + result.output_declarations.to_string() + " checksum=" + result.checksum.to_string() + " setup_checksum=" + setup_checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + stats.total_allocations.to_string() + " releases=" + stats.total_releases.to_string() + " retained_objects=" + stats.current_objects.to_string() + " allocator_bytes=" + stats.bytes_allocated.to_string() + " workload_valid=" + result.workload_valid.to_string(),
	)

	if result.workload_valid:
		0
	else:
		1
