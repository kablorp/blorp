-- Production-consumer profile for boolean Core pattern-binding membership.
--
-- Usage:
--   benchmarks/compiler_core_pattern_membership_profile plain match miss 20 512 64
--   benchmarks/compiler_core_pattern_membership_profile plain closure late 20 512 64
import:
	compiler_core_pattern_membership_profile_fixture:
		CorePatternMembershipProfileConfig,
		CorePatternMembershipProfileConsumer(MembershipClosureConsumer, MembershipMatchConsumer),
		CorePatternMembershipProfilePosition(MembershipEarly, MembershipLate, MembershipMiss),
		core_pattern_membership_profile_execute,
		core_pattern_membership_profile_fixture,
		core_pattern_membership_profile_observe,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func consumer(text: String) -> Option[CorePatternMembershipProfileConsumer]:
	match text:
		"match":
			Some(MembershipMatchConsumer)
		"closure":
			Some(MembershipClosureConsumer)
		_:
			None


private pure func position(text: String) -> Option[CorePatternMembershipProfilePosition]:
	match text:
		"early":
			Some(MembershipEarly)
		"late":
			Some(MembershipLate)
		"miss":
			Some(MembershipMiss)
		_:
			None


private func print_usage() -> Int:
	print((
		"usage: compiler_core_pattern_membership_profile "
			+ "match|closure early|late|miss [iterations] [width] [cases]"
	))
	2


private func run_profile(config: CorePatternMembershipProfileConfig) -> Int:
	setup_started: Int = now_microseconds()
	fixture = core_pattern_membership_profile_fixture(config)
	warmup_execution = core_pattern_membership_profile_execute(fixture, 1)
	warmup = core_pattern_membership_profile_observe(fixture, warmup_execution)
	setup_microseconds: Int = now_microseconds() - setup_started

	reset_mem_stats()
	begin_function_profile_window()
	started: Int = now_microseconds()
	execution = core_pattern_membership_profile_execute(fixture, config.iterations)
	elapsed_microseconds: Int = now_microseconds() - started
	end_function_profile_window()
	memory = get_mem_stats()
	result = core_pattern_membership_profile_observe(fixture, execution)
	workload_valid: Bool = (
		warmup.workload_valid
		and result.workload_valid
		and warmup.semantic_checksum == result.semantic_checksum
		and warmup.semantic_bytes == result.semantic_bytes
	)

	print(
		"CORE_PATTERN_MEMBERSHIP_PROFILE" + " consumer=" + result.consumer + " position=" + result.position + " iterations=" + result.iterations.to_string() + " width=" + result.width.to_string() + " cases=" + result.cases.to_string() + " expected_comparisons=" + result.expected_comparisons.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + memory.total_allocations.to_string() + " releases=" + memory.total_releases.to_string() + " retained_objects=" + memory.current_objects.to_string() + " allocator_bytes=" + memory.bytes_allocated.to_string() + " semantic_checksum=" + result.semantic_checksum.to_string() + " semantic_bytes=" + result.semantic_bytes.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " workload_valid=" + workload_valid.to_string(),
	)

	if workload_valid:
		0
	else:
		1


func main(args: List[String]) -> Int:
	match (args.get(1), args.get(2)):
		(Some(consumer_text), Some(position_text)):
			match (consumer(consumer_text), position(position_text)):
				(Some(selected_consumer), Some(selected_position)):
					run_profile({
						consumer = selected_consumer,
						position = selected_position,
						iterations = positive_argument(args, 3, 20),
						width = positive_argument(args, 4, 512),
						cases = positive_argument(args, 5, 64)
					})
				_:
					print_usage()
		_:
			print_usage()
