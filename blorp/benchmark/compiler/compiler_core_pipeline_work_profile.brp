-- Isolated Core pass work profile runner.
import:
	compiler_core_pipeline_work_profile_fixture:
		CompilerCorePipelineWorkProfileConfig,
		CompilerCorePipelineWorkProfileResult,
		compiler_core_pipeline_work_profile_run,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func nonnegative_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value >= 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func string_argument(args: List[String], index: Int, default: String) -> String:
	args
		.get(index)
		.get_or(default)


func main(args: List[String]) -> Int:
	config: CompilerCorePipelineWorkProfileConfig = {
		iterations = positive_argument(args, 1, 1),
		pass_name = string_argument(args, 2, "match_projection"),
		function_count = positive_argument(args, 3, 64),
		expression_nodes_per_function = positive_argument(args, 4, 64),
		union_count = nonnegative_argument(args, 5, 32),
		alias_count = nonnegative_argument(args, 6, 32),
		callable_declaration_count = positive_argument(args, 7, 64),
		call_density = nonnegative_argument(args, 8, 4),
		union_match_density = nonnegative_argument(args, 9, 8),
		duplicate_name_interval = nonnegative_argument(args, 10, 0)
	}

	setup_started: Int = now_microseconds()
	setup_result: CompilerCorePipelineWorkProfileResult = compiler_core_pipeline_work_profile_run(
		{ config | iterations = 1 },
	)
	setup_microseconds: Int = now_microseconds() - setup_started

	reset_mem_stats()
	begin_function_profile_window()
	started: Int = now_microseconds()
	result: CompilerCorePipelineWorkProfileResult = compiler_core_pipeline_work_profile_run(config)
	elapsed_microseconds: Int = now_microseconds() - started
	end_function_profile_window()
	stats = get_mem_stats()
	observation = result.observation

	print(
		"CORE_PIPELINE_WORK_PROFILE" + " iterations=" + config.iterations.to_string() + " pass_name=" + config.pass_name + " functions=" + config.function_count.to_string() + " expr_nodes_per_function=" + config.expression_nodes_per_function.to_string() + " unions=" + config.union_count.to_string() + " aliases=" + config.alias_count.to_string() + " callable_declarations=" + config.callable_declaration_count.to_string() + " call_density=" + config.call_density.to_string() + " union_match_density=" + config.union_match_density.to_string() + " duplicate_name_interval=" + config.duplicate_name_interval.to_string() + " pass_invocations=" + observation.pass_invocations.to_string() + " input_declarations=" + observation.input_declarations.to_string() + " output_declarations=" + observation.output_declarations.to_string() + " input_expression_roots=" + observation.input_expression_roots.to_string() + " output_expression_roots=" + observation.output_expression_roots.to_string() + " input_expression_nodes=" + observation.input_expression_nodes.to_string() + " output_expression_nodes=" + observation.output_expression_nodes.to_string() + " input_functions=" + observation.input_function_count.to_string() + " output_functions=" + observation.output_function_count.to_string() + " input_unions=" + observation.input_union_count.to_string() + " input_aliases=" + observation.input_alias_count.to_string() + " input_callable_declarations=" + observation.input_callable_declarations.to_string() + " input_call_exprs=" + observation.input_call_expr_count.to_string() + " input_semantic_matches=" + observation.input_semantic_match_count.to_string() + " input_constructor_matches=" + observation.input_constructor_match_count.to_string() + " declaration_visits=" + observation.declaration_visits.to_string() + " expression_node_visits=" + observation.expression_node_visits.to_string() + " expression_child_lists_materialized=" + observation.expression_child_lists_materialized.to_string() + " expression_nodes_reconstructed=" + observation.expression_nodes_reconstructed.to_string() + " unchanged_nodes_returned=" + observation.unchanged_nodes_returned.to_string() + " program_indexes_built=" + observation.program_indexes_built.to_string() + " index_entries_built=" + observation.index_entries_built.to_string() + " declaration_lookup_queries=" + observation.declaration_lookup_queries.to_string() + " declaration_lookup_candidates_inspected=" + observation.declaration_lookup_candidates_inspected.to_string() + " invariant_program_scans=" + observation.invariant_program_scans.to_string() + " invariant_expression_node_visits=" + observation.invariant_expression_node_visits.to_string() + " workload_checksum=" + observation.workload_checksum.to_string() + " output_checksum=" + observation.output_checksum.to_string() + " setup_checksum=" + setup_result.observation.workload_checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + stats.total_allocations.to_string() + " releases=" + stats.total_releases.to_string() + " retained_objects=" + stats.current_objects.to_string() + " allocator_bytes=" + stats.bytes_allocated.to_string() + " workload_valid=" + result.workload_valid.to_string(),
	)

	if result.workload_valid:
		0
	else:
		1
