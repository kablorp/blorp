-- Isolated early-Core invariant scan benchmark.
--
-- Fixture construction and structural census stay outside the measured window;
-- only calls to the production invariant entry points are measured.
import:
	../../src/compiler/stage_09_core/early_invariants:
		CoreEarlyInvariantViolation,
		check_debug_invariants,
		check_mono_invariants,
		check_resolve_invariants,
		check_synth_invariants,
		core_early_invariant_hint,
		core_early_invariant_message,
	../../src/compiler/stage_09_core/ir: CoreProgram
	../../src/compiler/stage_09_core/work_profile: CoreProgramWorkStats, core_program_work_stats
	compiler_core_pipeline_work_profile_fixture:
		CompilerCorePipelineWorkProfileConfig,
		compiler_core_pipeline_work_profile_program,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			parse_int(text)
				.filter(pure func(value): value > 0)
				.get_or(default)
		None:
			default


private pure func string_argument(args: List[String], index: Int, default: String) -> String:
	args
		.get(index)
		.get_or(default)


private pure func valid_family(family: String) -> Bool:
	family == "debug" or family == "mono" or family == "synth" or family == "resolve"


private pure func check_invariants(
	family: String,
	program: CoreProgram,
) -> List[CoreEarlyInvariantViolation]:
	match family:
		"debug":
			check_debug_invariants(program)
		"mono":
			check_mono_invariants(program)
		"synth":
			check_synth_invariants(program)
		"resolve":
			check_resolve_invariants(program)
		_:
			[]


private pure func ordered_violation_checksum(violations: List[CoreEarlyInvariantViolation]) -> Int:
	var checksum: Int = 0

	for violation in violations:
		diagnostic: String = core_early_invariant_message(
			violation,
		) + "|" + core_early_invariant_hint(violation).get_or("")

		for ch in diagnostic:
			checksum = checksum * 131 + ch.to_int()

	checksum


func main(args: List[String]) -> Int:
	iterations: Int = positive_argument(args, 1, 100)
	family: String = string_argument(args, 2, "resolve")
	function_count: Int = positive_argument(args, 3, 64)
	expression_nodes_per_function: Int = positive_argument(args, 4, 256)
	config: CompilerCorePipelineWorkProfileConfig = {
		iterations = 1,
		pass_name = "match_projection",
		function_count = function_count,
		expression_nodes_per_function = expression_nodes_per_function,
		union_count = 0,
		alias_count = 0,
		callable_declaration_count = function_count,
		call_density = 4,
		union_match_density = 0,
		duplicate_name_interval = 0
	}
	program: CoreProgram = compiler_core_pipeline_work_profile_program(config)
	program_stats: CoreProgramWorkStats = core_program_work_stats(program)
	setup_violations: List[CoreEarlyInvariantViolation] = check_invariants(family, program)
	setup_checksum: Int = ordered_violation_checksum(setup_violations)

	reset_mem_stats()
	begin_function_profile_window()
	started: Int = now_microseconds()
	var result: List[CoreEarlyInvariantViolation] = []
	var iteration: Int = 0

	while iteration < iterations:
		result = check_invariants(family, program)
		iteration += 1

	elapsed_microseconds: Int = now_microseconds() - started
	end_function_profile_window()
	memory_stats = get_mem_stats()
	result_checksum: Int = ordered_violation_checksum(result)
	workload_valid: Bool = (
		valid_family(family)
		and setup_violations.length() == result.length()
		and setup_checksum == result_checksum
	)

	print(
		"CORE_INVARIANT_SCAN_PROFILE" + " iterations=" + iterations.to_string() + " family=" + family + " functions=" + function_count.to_string() + " expr_nodes_per_function=" + expression_nodes_per_function.to_string() + " program_checks=" + iterations.to_string() + " input_expression_roots=" + program_stats.expression_root_count.to_string() + " input_expression_nodes=" + program_stats.expression_node_count.to_string() + " setup_violation_count=" + setup_violations
			.length()
			.to_string() + " result_violation_count=" + result
			.length()
			.to_string() + " setup_violation_checksum=" + setup_checksum.to_string() + " result_violation_checksum=" + result_checksum.to_string() + " workload_checksum=" + program_stats.workload_checksum.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + memory_stats.total_allocations.to_string() + " releases=" + memory_stats.total_releases.to_string() + " retained_objects=" + memory_stats.current_objects.to_string() + " allocator_bytes=" + memory_stats.bytes_allocated.to_string() + " workload_valid=" + workload_valid.to_string(),
	)

	if workload_valid:
		0
	else:
		1
