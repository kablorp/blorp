-- Isolated profile for closure function-index construction.
--
-- Positional controls:
--   iterations
--   top_level_functions
--   impl_blocks
--   methods_per_impl
--   duplicate_name_interval
--   duplicate_id_interval
import:
	compiler_closure_function_index_profile_fixture:
		CompilerClosureFunctionIndexProfileConfig,
		compiler_closure_function_index_profile_execute,
		compiler_closure_function_index_profile_fixture,
		compiler_closure_function_index_profile_measure_construction,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private DEFAULT_ITERATIONS: Int = 10

private DEFAULT_TOP_LEVEL_FUNCTIONS: Int = 1024

private DEFAULT_IMPL_BLOCKS: Int = 8

private DEFAULT_METHODS_PER_IMPL: Int = 16

private DEFAULT_DUPLICATE_NAME_INTERVAL: Int = 16

private DEFAULT_DUPLICATE_ID_INTERVAL: Int = 64


private pure func non_negative_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value >= 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	value: Int = non_negative_argument(args, index, default)

	if value > 0:
		value
	else:
		default


func main(args: List[String]) -> Int:
	config: CompilerClosureFunctionIndexProfileConfig = {
		iterations = positive_argument(args, 1, DEFAULT_ITERATIONS),
		top_level_functions = non_negative_argument(args, 2, DEFAULT_TOP_LEVEL_FUNCTIONS),
		impl_blocks = non_negative_argument(args, 3, DEFAULT_IMPL_BLOCKS),
		methods_per_impl = non_negative_argument(args, 4, DEFAULT_METHODS_PER_IMPL),
		duplicate_name_interval = non_negative_argument(args, 5, DEFAULT_DUPLICATE_NAME_INTERVAL),
		duplicate_id_interval = non_negative_argument(args, 6, DEFAULT_DUPLICATE_ID_INTERVAL)
	}
	fixture = compiler_closure_function_index_profile_fixture(config)
	validation = compiler_closure_function_index_profile_execute(fixture)
	validation_repeat = compiler_closure_function_index_profile_execute(fixture)
	construction_warmup = compiler_closure_function_index_profile_measure_construction(fixture)

	reset_mem_stats()
	begin_function_profile_window()
	started: Int = now_microseconds()
	result = compiler_closure_function_index_profile_measure_construction(fixture)
	elapsed_microseconds: Int = now_microseconds() - started
	end_function_profile_window()
	memory = get_mem_stats()

	workload_valid: Bool = (
		validation.workload_valid
		and validation_repeat.workload_valid
		and validation.checksum == validation_repeat.checksum
		and construction_warmup.workload_valid
		and result.workload_valid
	)

	print(
		"CLOSURE_FUNCTION_INDEX_PROFILE" + " measurement_mode=construction_counts" + " iterations=" + config.iterations.to_string() + " top_level_functions=" + config.top_level_functions.to_string() + " impl_blocks=" + config.impl_blocks.to_string() + " methods_per_impl=" + config.methods_per_impl.to_string() + " duplicate_name_interval=" + config.duplicate_name_interval.to_string() + " duplicate_id_interval=" + config.duplicate_id_interval.to_string() + " function_count=" + result.function_count.to_string() + " by_id_count=" + result.by_id_count.to_string() + " by_name_count=" + result.by_name_count.to_string() + " collision_id_count=" + result.collision_id_count.to_string() + " total_collision_entries=" + result.total_collision_entries.to_string() + " checksum=" + validation.checksum.to_string() + " construction_checksum=" + result.checksum.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " total_allocations=" + memory.total_allocations.to_string() + " total_releases=" + memory.total_releases.to_string() + " retained_objects=" + memory.current_objects.to_string() + " allocated_bytes=" + memory.bytes_allocated.to_string() + " workload_valid=" + workload_valid.to_string(),
	)

	if workload_valid:
		0
	else:
		1
