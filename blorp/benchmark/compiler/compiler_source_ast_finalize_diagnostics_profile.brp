-- Isolated profile for source-AST interpolation diagnostic finalization.
--
-- Fixture source construction and parsing happen before the timed window.
-- The timed work is exactly `finalize_interpolation_program`.
--
-- Positional controls: iterations, expression count, diagnostics per
-- diagnostic expression, clean-expression period, and list nesting depth.
--
-- Usage:
--   bin/blorp compile -o /tmp/source_ast_finalize_diagnostics.c blorp/benchmark/compiler/compiler_source_ast_finalize_diagnostics_profile.brp
--   cc -O2 /tmp/source_ast_finalize_diagnostics.c -o /tmp/source_ast_finalize_diagnostics
--   /tmp/source_ast_finalize_diagnostics 5 1024 2 4 1
import:
	../../src/compiler/stage_02_lex/parse_diagnostic: parse_diagnostic_to_string
	../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../src/compiler/stage_03_parse/parsed_ast: ParsedProgram
	../../src/compiler/stage_03_parse/parsed_ast_json: parsed_program_to_json
	../../src/compiler/stage_03_parse/source_ast_finalize: finalize_interpolation_program
	../../src/lib/source: source_file
	hash: sha256
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private DEFAULT_ITERATIONS: Int = 5

private DEFAULT_EXPRESSION_COUNT: Int = 1024

private DEFAULT_DIAGNOSTICS_PER_EXPR: Int = 2

private DEFAULT_CLEAN_PERIOD: Int = 4

private DEFAULT_NESTING_DEPTH: Int = 1


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func non_negative_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value >= 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func diagnostic_hole(seed: Int) -> String:
	"$" + "{" + seed.to_string() + " +}"


private pure func diagnostic_string_expr(index: Int, diagnostics_per_expr: Int) -> String:
	var text: String = "\"expr_" + index.to_string()
	var diagnostic_index: Int = 0

	while diagnostic_index < diagnostics_per_expr:
		text += " " + diagnostic_hole(index * 1000 + diagnostic_index)
		diagnostic_index += 1

	text + "\""


private pure func clean_string_expr(index: Int) -> String:
	"\"clean_" + index.to_string() + "\""


private pure func nested_expr(expr: String, depth: Int) -> String:
	var result: String = expr
	var current_depth: Int = 0

	while current_depth < depth:
		result = "[" + result + "]"
		current_depth += 1

	result


private pure func expression_diagnostic_count(
	index: Int,
	diagnostics_per_expr: Int,
	clean_period: Int,
) -> Int:
	if clean_period > 0 and index % clean_period == 0:
		0
	else:
		diagnostics_per_expr


private pure func expression_source(
	index: Int,
	diagnostics_per_expr: Int,
	clean_period: Int,
	nesting_depth: Int,
) -> String:
	count: Int = expression_diagnostic_count(index, diagnostics_per_expr, clean_period)

	inner: String = if count == 0:
		clean_string_expr(index)
	else:
		diagnostic_string_expr(index, count)

	nested_expr(inner, nesting_depth)


private pure func fixture_source(
	expression_count: Int,
	diagnostics_per_expr: Int,
	clean_period: Int,
	nesting_depth: Int,
) -> String:
	var text: String = "func source_ast_finalize_diagnostics_profile():\n"

	for index in 0..expression_count:
		text += "\t" + expression_source(
			index,
			diagnostics_per_expr,
			clean_period,
			nesting_depth,
		) + "\n"

	text


private pure func expected_diagnostics(
	expression_count: Int,
	diagnostics_per_expr: Int,
	clean_period: Int,
) -> Int:
	var count: Int = 0

	for index in 0..expression_count:
		count += expression_diagnostic_count(index, diagnostics_per_expr, clean_period)

	count


private pure func accumulated_prefix_elements_copied(
	expression_count: Int,
	diagnostics_per_expr: Int,
	clean_period: Int,
) -> Int:
	var copied: Int = 0
	var prefix: Int = 0

	for index in 0..expression_count:
		copied += prefix
		prefix += expression_diagnostic_count(index, diagnostics_per_expr, clean_period)

	copied


private pure func diagnostic_text(program: ParsedProgram) -> String:
	var text: String = ""

	for diagnostic in program.diagnostics:
		text += parse_diagnostic_to_string(diagnostic) + "\n"

	text


func main(args: List[String]) -> Int:
	iterations: Int = positive_argument(args, 1, DEFAULT_ITERATIONS)
	expression_count: Int = positive_argument(args, 2, DEFAULT_EXPRESSION_COUNT)
	diagnostics_per_expr: Int = non_negative_argument(args, 3, DEFAULT_DIAGNOSTICS_PER_EXPR)
	clean_period: Int = non_negative_argument(args, 4, DEFAULT_CLEAN_PERIOD)
	nesting_depth: Int = non_negative_argument(args, 5, DEFAULT_NESTING_DEPTH)
	source_text: String = fixture_source(
		expression_count,
		diagnostics_per_expr,
		clean_period,
		nesting_depth,
	)
	parsed: ParsedProgram = parse_compiler_source(
		source_file(
			"source_ast_finalize_diagnostics_profile.brp",
			"source_ast_finalize_diagnostics_profile",
			source_text,
		),
	)
	expected_diagnostic_count: Int = expected_diagnostics(
		expression_count,
		diagnostics_per_expr,
		clean_period,
	)
	prefix_copied: Int = accumulated_prefix_elements_copied(
		expression_count,
		diagnostics_per_expr,
		clean_period,
	)

	reset_mem_stats()
	started: Int = now_microseconds()
	var finalized: ParsedProgram = parsed

	for _ in 0..iterations:
		finalized = finalize_interpolation_program(parsed)

	elapsed_microseconds: Int = now_microseconds() - started
	stats = get_mem_stats()
	ast_checksum: String = sha256(parsed_program_to_json(finalized).to_string())
	diagnostic_checksum: String = sha256(diagnostic_text(finalized))
	workload_valid: Bool = (
		parsed.diagnostics.length() == 0
		and finalized.diagnostics.length() == expected_diagnostic_count
	)

	print(
		"SOURCE_AST_FINALIZE_DIAGNOSTICS_PROFILE" + " iterations=" + iterations.to_string() + " expressions=" + expression_count.to_string() + " diagnostics_per_expr=" + diagnostics_per_expr.to_string() + " clean_period=" + clean_period.to_string() + " nesting_depth=" + nesting_depth.to_string() + " finalized_expressions=" + (iterations * expression_count).to_string() + " diagnostics=" + finalized.diagnostics
			.length()
			.to_string() + " diagnostic_elements_produced=" + (iterations * finalized.diagnostics.length()).to_string() + " old_prefix_elements_copied=" + (iterations * prefix_copied).to_string() + " ast_checksum=" + ast_checksum + " diagnostic_checksum=" + diagnostic_checksum + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " total_allocations=" + stats.total_allocations.to_string() + " total_releases=" + stats.total_releases.to_string() + " retained_objects=" + stats.current_objects.to_string() + " allocated_bytes=" + stats.bytes_allocated.to_string() + " workload_valid=" + workload_valid.to_string(),
	)

	if workload_valid:
		0
	else:
		1
