-- Production-boundary profile for Core match-binding accumulation.
--
-- Usage:
--   benchmarks/compiler_core_match_binding_profile plain recursive 20 128 8 1
--   benchmarks/compiler_core_match_binding_profile plain prefix-early 20 128 0 16
--   benchmarks/compiler_core_match_binding_profile plain prefix-late 20 128 0 16
import:
	compiler_core_match_binding_profile_fixture:
		CoreMatchBindingProfileConfig,
		CoreMatchBindingProfileShape(
			ProfileRecursiveChildren,
			ProfileRetainedPrefixEarly,
			ProfileRetainedPrefixLate,
		),
		core_match_binding_profile_execute,
		core_match_binding_profile_fixture,
		core_match_binding_profile_observe,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func nonnegative_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value >= 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func profile_shape(text: String) -> Option[CoreMatchBindingProfileShape]:
	match text:
		"recursive":
			Some(ProfileRecursiveChildren)
		"prefix-early":
			Some(ProfileRetainedPrefixEarly)
		"prefix-late":
			Some(ProfileRetainedPrefixLate)
		_:
			None


private pure func profile_shape_name(shape: CoreMatchBindingProfileShape) -> String:
	match shape:
		ProfileRecursiveChildren:
			"recursive"
		ProfileRetainedPrefixEarly:
			"prefix-early"
		ProfileRetainedPrefixLate:
			"prefix-late"


private func run_profile(
	shape: CoreMatchBindingProfileShape,
	config: CoreMatchBindingProfileConfig,
) -> Int:
	setup_started: Int = now_microseconds()
	fixture = core_match_binding_profile_fixture(config)
	warmup_execution = core_match_binding_profile_execute(fixture, 1)
	warmup = core_match_binding_profile_observe(fixture, warmup_execution)
	setup_microseconds: Int = now_microseconds() - setup_started

	reset_mem_stats()
	begin_function_profile_window()
	started: Int = now_microseconds()
	execution = core_match_binding_profile_execute(fixture, config.iterations)
	elapsed_microseconds: Int = now_microseconds() - started
	end_function_profile_window()
	memory = get_mem_stats()
	result = core_match_binding_profile_observe(fixture, execution)
	workload_valid: Bool = (
		warmup.workload_valid
		and result.workload_valid
		and warmup.semantic_checksum == result.semantic_checksum
		and warmup.semantic_json_checksum == result.semantic_json_checksum
	)

	print(
		"CORE_MATCH_BINDING_PROFILE" + " shape=" + profile_shape_name(
			shape,
		) + " iterations=" + result.iterations.to_string() + " binding_width=" + config.binding_width.to_string() + " nesting_depth=" + config.nesting_depth.to_string() + " constructor_columns=" + config.constructor_columns.to_string() + " input_bindings=" + result.input_bindings.to_string() + " output_bindings=" + result.output_bindings.to_string() + " leaf_count=" + result.leaf_count.to_string() + " owned_spread_bindings=" + result.owned_spread_bindings.to_string() + " modeled_recursive_concat_elements=" + result.modeled_recursive_concat_elements.to_string() + " modeled_arm_prefix_concat_elements=" + result.modeled_arm_prefix_concat_elements.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + memory.total_allocations.to_string() + " releases=" + memory.total_releases.to_string() + " retained_objects=" + memory.current_objects.to_string() + " allocator_bytes=" + memory.bytes_allocated.to_string() + " semantic_checksum=" + result.semantic_checksum.to_string() + " semantic_json_checksum=" + result.semantic_json_checksum.to_string() + " semantic_json_bytes=" + result.semantic_json_bytes.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " workload_valid=" + workload_valid.to_string(),
	)

	if workload_valid:
		0
	else:
		1


private func print_usage() -> Int:
	print((
			"usage: compiler_core_match_binding_profile "
			+ "recursive|prefix-early|prefix-late [iterations] [binding_width] "
			+ "[nesting_depth] [constructor_columns]"
		))
	2


func main(args: List[String]) -> Int:
	match args.get(1):
		Some(text):
			match profile_shape(text):
				Some(shape):
					run_profile(shape, {
						shape = shape,
						iterations = positive_argument(args, 2, 20),
						binding_width = positive_argument(args, 3, 128),
						nesting_depth = nonnegative_argument(args, 4, 8),
						constructor_columns = positive_argument(args, 5, 16)
					})
				None:
					print_usage()
		None:
			print_usage()
