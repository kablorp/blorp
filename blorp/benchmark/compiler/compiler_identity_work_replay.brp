-- Profile the production CLI through a chosen Core checkpoint on frozen input.
import:
	../../src/compiler/identity_work_counters: register_identity_work_counters
	../../src/main: main as compiler_main
	instrumentation: begin_function_profile_window, end_function_profile_window
	io: print


func main(args: List[String]) -> Int:
	if args.length() != 5:
		print("usage: compiler_identity_work_replay INPUT CORE_OUTPUT STD_DIR STAGE")
		2
	else:
		input = args.get_or(1, "")
		core_output = args.get_or(2, "")
		std_dir = args.get_or(3, "")
		stage = args.get_or(4, "")
		begin_function_profile_window()
		debug:
			register_identity_work_counters()
		status = compiler_main([
			"compiler_identity_work_replay",
			"compile",
			"--no-format",
			"--stop-after=" + stage,
			"--dump-core-after=" + stage,
			"--dump-core-file=" + core_output,
			"--std-dir",
			std_dir,
			"-o",
			"/dev/null",
			input,
		])
		end_function_profile_window()
		print("IDENTITY_WORK_REPLAY stage=" + stage + " status=" + status.to_string())
		status
