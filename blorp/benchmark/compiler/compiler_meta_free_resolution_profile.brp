-- Isolate finalization of a nested meta-free or bound-meta type.
-- Type construction and binding are outside the measured loop.
import:
	../../src/compiler/stage_06_typecheck/type_system/context:
		Context,
		resolve_type_metas,
	../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticType(SemanticMetaType, SemanticNamedType),
		TYPE_INT,
		types_equal,
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds
	meta_profile_support: profile_bind_meta, profile_fresh_meta, profile_meta_context


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


func main(args: List[String]) -> Int:
	width = positive_argument(args, 1, 16)
	iterations = positive_argument(args, 2, 4096)
	mode = args.get_or(3, "meta-free")
	valid_mode = mode == "meta-free" or mode == "bound"
	var context: Context = profile_meta_context()
	var input_type = TYPE_INT
	var expected_type = TYPE_INT
	var setup_valid = True

	if mode == "bound":
		issued = profile_fresh_meta(context)

		match issued.meta_type:
			SemanticMetaType(_, meta_id):
				match profile_bind_meta(issued.context, meta_id, TYPE_INT):
					Some(bound):
						context = bound
						input_type = issued.meta_type
					None:
						setup_valid = False
			_:
				setup_valid = False

	for _ in 0..width:
		input_type = SemanticNamedType("Box", [input_type])
		expected_type = SemanticNamedType("Box", [expected_type])

	reset_mem_stats()
	started = now_microseconds()
	var resolved: Int = 0

	for _ in 0..iterations:
		if types_equal(
			resolve_type_metas(context, input_type),
			expected_type,
		):
			resolved += 1

	elapsed = now_microseconds() - started
	memory = get_mem_stats()
	print(
		"META_FREE_RESOLUTION mode=${mode} width=${width.to_string()} iterations=${iterations.to_string()} resolved=${resolved.to_string()} elapsed_microseconds=${elapsed.to_string()} allocations=${memory.total_allocations.to_string()} releases=${memory.total_releases.to_string()} retained_objects=${memory.current_objects.to_string()} retained_bytes=${memory.bytes_allocated.to_string()}",
	)

	if (
		valid_mode
		and setup_valid
		and resolved == iterations
		and memory.current_objects == 0
		and memory.bytes_allocated == 0
		and memory.total_allocations == memory.total_releases
	):
		0
	else:
		1
