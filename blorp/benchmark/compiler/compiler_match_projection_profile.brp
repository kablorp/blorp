-- Isolated profile for backend match projection.
-- Lookup request counts are modeled from the fixture shape; structural linear
-- candidate counts are zero because production uses indexed lookups.
-- Elapsed time, allocation counters, and checksum consume the timed projection.
--
-- Usage:
--   benchmarks/compiler_match_projection_profile plain 1 256 256 8 4 4 255 7
import:
	compiler_match_projection_profile_fixture:
		CompilerMatchProjectionProfileConfig,
		compiler_match_projection_profile_observation,
		compiler_match_projection_profile_program,
		compiler_match_projection_profile_project,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func integer_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					value
				None:
					default
		None:
			default


func main(args: List[String]) -> Int:
	declarations: Int = positive_argument(args, 2, 256)
	variants_per_union: Int = positive_argument(args, 4, 8)
	config: CompilerMatchProjectionProfileConfig = {
		iterations = positive_argument(args, 1, 1),
		declarations = declarations,
		matches = positive_argument(args, 3, 256),
		variants_per_union = variants_per_union,
		accessor_depth = positive_argument(args, 5, 4),
		generic_arguments = positive_argument(args, 6, 2),
		target_union_index = integer_argument(args, 7, declarations - 1),
		target_variant_index = integer_argument(args, 8, variants_per_union - 1)
	}

	setup_started: Int = now_microseconds()
	program = compiler_match_projection_profile_program(config)
	warmup_projected = compiler_match_projection_profile_project(program, 1)
	setup_microseconds: Int = now_microseconds() - setup_started

	reset_mem_stats()
	begin_function_profile_window()
	started: Int = now_microseconds()
	projected = compiler_match_projection_profile_project(program, config.iterations)
	elapsed_microseconds: Int = now_microseconds() - started
	end_function_profile_window()
	memory = get_mem_stats()
	result = compiler_match_projection_profile_observation(config, projected)
	observation = result.observation

	workload_valid: Bool = (
		warmup_projected.workload_valid
		and result.workload_valid
		and warmup_projected.program.decls.length() == projected.program.decls.length()
	)

	print(
		"MATCH_PROJECTION_PROFILE" + " iterations=" + config.iterations.to_string() + " declarations=" + config.declarations.to_string() + " matches=" + config.matches.to_string() + " variants_per_union=" + config.variants_per_union.to_string() + " accessor_depth=" + config.accessor_depth.to_string() + " generic_arguments=" + config.generic_arguments.to_string() + " target_union_index=" + config.target_union_index.to_string() + " target_variant_index=" + config.target_variant_index.to_string() + " declaration_index_entries=" + observation.declaration_index_entries.to_string() + " variant_name_index_entries=" + observation.variant_name_index_entries.to_string() + " variant_id_index_entries=" + observation.variant_id_index_entries.to_string() + " modeled_union_lookup_requests=" + observation.modeled_union_lookup_requests.to_string() + " structural_union_linear_candidates_visited=" + observation.structural_union_linear_candidates_visited.to_string() + " modeled_variant_lookup_requests=" + observation.modeled_variant_lookup_requests.to_string() + " structural_variant_linear_candidates_visited=" + observation.structural_variant_linear_candidates_visited.to_string() + " projected_match_nodes=" + observation.projected_match_nodes.to_string() + " projected_accessor_nodes=" + observation.projected_accessor_nodes.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + memory.total_allocations.to_string() + " releases=" + memory.total_releases.to_string() + " retained_objects=" + memory.current_objects.to_string() + " allocator_bytes=" + memory.bytes_allocated.to_string() + " semantic_checksum=" + observation.semantic_checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " workload_valid=" + workload_valid.to_string(),
	)

	if workload_valid:
		0
	else:
		1
