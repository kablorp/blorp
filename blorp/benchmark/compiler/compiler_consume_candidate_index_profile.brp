-- Isolated consume-specialization candidate-index profile runner.
import:
	../../src/compiler/stage_09_core/consume_specialize: rewrite_program
	../../src/compiler/stage_09_core/ir: CoreProgram, core_program_max_declared_definition_id
	compiler_consume_candidate_index_profile_fixture:
		CompilerConsumeCandidateIndexProfileConfig,
		CompilerConsumeCandidateIndexProfileResult,
		compiler_consume_candidate_index_profile_program,
		compiler_consume_candidate_index_profile_result_for_rewrite,
		compiler_consume_candidate_index_profile_run,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func nonnegative_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value >= 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func string_argument(args: List[String], index: Int, default: String) -> String:
	args
		.get(index)
		.get_or(default)


func main(args: List[String]) -> Int:
	config: CompilerConsumeCandidateIndexProfileConfig = {
		iterations = positive_argument(args, 1, 1),
		function_count = positive_argument(args, 2, 256),
		candidates_per_function = nonnegative_argument(args, 3, 8),
		user_calls = nonnegative_argument(args, 4, 256),
		used_percent = nonnegative_argument(args, 5, 25),
		collision_mode = string_argument(args, 6, "none")
	}

	setup_started: Int = now_microseconds()
	program: CoreProgram = compiler_consume_candidate_index_profile_program(config)
	seed_next_def_id: Int = core_program_max_declared_definition_id(program) + 1
	warm_rewritten: CoreProgram = rewrite_program(program, seed_next_def_id).program
	setup_result: CompilerConsumeCandidateIndexProfileResult = compiler_consume_candidate_index_profile_result_for_rewrite(
		config,
		warm_rewritten,
	)
	setup_microseconds: Int = now_microseconds() - setup_started

	var rewritten: CoreProgram = warm_rewritten
	var iteration: Int = 0

	reset_mem_stats()
	begin_function_profile_window()
	started: Int = now_microseconds()

	while iteration < config.iterations:
		rewritten = rewrite_program(program, seed_next_def_id).program
		iteration += 1

	elapsed_microseconds: Int = now_microseconds() - started
	end_function_profile_window()
	stats = get_mem_stats()
	result: CompilerConsumeCandidateIndexProfileResult = compiler_consume_candidate_index_profile_result_for_rewrite(
		config,
		rewritten,
	)

	print(
		"CONSUME_CANDIDATE_INDEX_PROFILE" + " iterations=" + config.iterations.to_string() + " functions=" + config.function_count.to_string() + " candidates_per_function=" + config.candidates_per_function.to_string() + " user_calls=" + config.user_calls.to_string() + " used_percent=" + config.used_percent.to_string() + " collision_mode=" + config.collision_mode + " candidates_discovered=" + result.candidates_discovered.to_string() + " rewritten_clone_count=" + result.rewritten_clone_count.to_string() + " rewritten_function_checksum=" + result.rewritten_function_checksum.to_string() + " core_json_checksum=" + result.core_json_checksum.to_string() + " core_json_bytes=" + result.core_json_bytes.to_string() + " setup_checksum=" + setup_result.core_json_checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + stats.total_allocations.to_string() + " releases=" + stats.total_releases.to_string() + " retained_objects=" + stats.current_objects.to_string() + " allocator_bytes=" + stats.bytes_allocated.to_string() + " workload_valid=" + result.workload_valid.to_string(),
	)

	if result.workload_valid:
		0
	else:
		1
