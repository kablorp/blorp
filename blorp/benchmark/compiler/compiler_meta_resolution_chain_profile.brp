-- Isolate head or full resolution after an issued, acyclic binding chain is built.
-- Context construction and binding are deliberately outside the measured loop.
import:
	../../src/compiler/stage_06_typecheck/type_system/context:
		Context,
		head_resolve,
		zonk_type,
	../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		TYPE_INT,
		types_equal,
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds
	meta_profile_support: profile_bind_meta, profile_fresh_meta, profile_meta, profile_meta_context


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


func main(args: List[String]) -> Int:
	width = positive_argument(args, 1, 64)
	iterations = positive_argument(args, 2, 4096)
	mode = args
		.get(3)
		.get_or("head")
	valid_mode = mode == "head" or mode == "full"
	var context: Context = profile_meta_context()

	for _ in 0..width:
		context = profile_fresh_meta(context).context

	var setup_valid: Bool = True

	for index in 0..width:
		binding = if index + 1 < width:
			profile_meta(context, index + 1)
		else:
			TYPE_INT

		match profile_bind_meta(context, index, binding):
			Some(bound):
				context = bound
			None:
				setup_valid = False

	reset_mem_stats()
	started = now_microseconds()
	var resolved: Int = 0
	var valid: Bool = True

	for iteration in 0..iterations:
		start_index = iteration % width

		result = if mode == "full":
			zonk_type(context, profile_meta(context, start_index))
		else:
			head_resolve(context, profile_meta(context, start_index))

		if types_equal(result, TYPE_INT):
			resolved += 1
		else:
			valid = False

	elapsed = now_microseconds() - started
	memory = get_mem_stats()
	print(
		"META_RESOLUTION_CHAIN mode=${mode} mode_valid=${valid_mode.to_string()} width=${width.to_string()} iterations=${iterations.to_string()} setup_valid=${setup_valid.to_string()} resolved=${resolved.to_string()} valid=${valid.to_string()} elapsed_microseconds=${elapsed.to_string()} allocations=${memory.total_allocations.to_string()} releases=${memory.total_releases.to_string()} retained_objects=${memory.current_objects.to_string()} retained_bytes=${memory.bytes_allocated.to_string()}",
	)

	if (
		setup_valid
		and valid
		and valid_mode
		and resolved == iterations
	):
		0
	else:
		1
