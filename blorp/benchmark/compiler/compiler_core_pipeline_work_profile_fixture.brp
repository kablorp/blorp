-- Deterministic Core workload generator for pass work measurement.
import:
	../../src/compiler/stage_09_core/ir:
		CoreCallKind(BuiltinCall, UserCall),
		CoreDecl(FunctionDecl, TypeAliasDecl, UnionDecl),
		CoreExpr(CallExpr, LiteralExpr, SemanticMatchExpr, SeqExpr, VarExpr),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreLiteral(IntLiteral),
		CoreParam,
		CoreProgram,
		CoreReleasePolicy(NoReleasePolicy),
		CoreSemanticMatchAccessor(RootSemanticMatchAccessor),
		CoreSemanticMatchTree(SemanticConstructorMatch, SemanticMatchLeaf),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, UnionType),
		CoreUnionDecl,
		CoreUnionPayloadStorage(TypedUnionPayloadStorage),
		CoreUnionVariant,
		CoreVar,
	../../src/compiler/stage_09_core/work_profile: CorePipelineWorkProfileObservation, profile_core_pass_work


record CompilerCorePipelineWorkProfileConfig {
	iterations: Int,
	pass_name: String,
	function_count: Int,
	expression_nodes_per_function: Int,
	union_count: Int,
	alias_count: Int,
	callable_declaration_count: Int,
	call_density: Int,
	union_match_density: Int,
	duplicate_name_interval: Int
}


record CompilerCorePipelineWorkProfileResult {
	observation: CorePipelineWorkProfileObservation,
	workload_valid: Bool
}


private pure func int_type() -> CoreType:
	NamedType("Int", [])


private pure func benchmark_var(name: String, def_id: Option[Int]) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = def_id
	}


private pure func benchmark_param(name: String) -> CoreParam:
	{
		name = benchmark_var(name, None),
		typ = int_type(),
		loc = SyntheticSourceLoc
	}


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), int_type(), SyntheticSourceLoc)


private pure func union_name(index: Int) -> String:
	"WorkUnion${index}"


private pure func variant_name(index: Int) -> String:
	"WorkVariant${index}"


private pure func function_name(index: Int, duplicate_name_interval: Int) -> String:
	if (
		duplicate_name_interval > 0
		and index > 0
		and index % duplicate_name_interval == 0
	):
		"work_function_${index - 1}"
	else:
		"work_function_${index}"


private pure func call_expr(index: Int) -> CoreExpr:
	CallExpr(
		UserCall("work_target_${index}", Some(900000 + index), []),
		VarExpr(
			benchmark_var("work_target_${index}", Some(900000 + index)),
			int_type(),
			SyntheticSourceLoc,
		),
		[int_literal(index)],
		int_type(),
		SyntheticSourceLoc,
	)


private pure func semantic_union_match_expr(index: Int, union_count: Int) -> CoreExpr:
	modulus: Int = if union_count > 0:
		union_count
	else:
		1

	target_union: String = union_name(index % modulus)

	SemanticMatchExpr(
		VarExpr(
			benchmark_var("matched_${index}", None),
			UnionType(target_union),
			SyntheticSourceLoc,
		),
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = variant_name(0),
					body = SemanticMatchLeaf([], int_literal(index))
				},
			],
			Some(SemanticMatchLeaf([], int_literal(index + 1))),
		),
		int_type(),
		SyntheticSourceLoc,
	)


private pure func append_body_node(
	body: CoreExpr,
	node_index: Int,
	config: CompilerCorePipelineWorkProfileConfig,
) -> CoreExpr:
	new_node: CoreExpr = if (
		config.union_match_density > 0
		and node_index % config.union_match_density == 0
	):
		semantic_union_match_expr(node_index, config.union_count)
	else if config.call_density > 0 and node_index % config.call_density == 0:
		call_expr(node_index)
	else:
		int_literal(node_index)

	SeqExpr(body, new_node)


private pure func function_body(
	function_index: Int,
	config: CompilerCorePipelineWorkProfileConfig,
) -> CoreExpr:
	var body: CoreExpr = int_literal(function_index)
	var node_index: Int = 1

	target_nodes: Int = if config.expression_nodes_per_function > 0:
		config.expression_nodes_per_function
	else:
		1

	while node_index < target_nodes:
		body = append_body_node(body, function_index * target_nodes + node_index, config)
		node_index += 1

	body


private pure func benchmark_function(
	index: Int,
	config: CompilerCorePipelineWorkProfileConfig,
) -> CoreFunction:
	{
		name = function_name(index, config.duplicate_name_interval),
		source_module = Some("bench/core_work"),
		type_params = [],
		params = [benchmark_param("arg")],
		return_type = int_type(),
		body = Some(function_body(index, config)),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 800000 + index,
		loc = SyntheticSourceLoc
	}


private pure func union_decl(index: Int) -> CoreDecl:
	UnionDecl({
		abi_type = None,
		name = union_name(index),
		type_params = [],
		payload_storage = TypedUnionPayloadStorage,
		variants = [
			{
				name = variant_name(0),
				c_name = "work_variant_${index}_0",
				tag_c_name = "WORK_VARIANT_${index}_0",
				tag = 0,
				fields = [],
				def_id = Some(700000 + index)
			},
		],
		loc = SyntheticSourceLoc,
	})


private pure func alias_decl(index: Int) -> CoreDecl:
	TypeAliasDecl({
		abi_type = None,
		name = "WorkAlias${index}",
		type_params = [],
		target = int_type(),
		is_opaque = False,
		loc = SyntheticSourceLoc,
	})


pure func compiler_core_pipeline_work_profile_program(
	config: CompilerCorePipelineWorkProfileConfig,
) -> CoreProgram:
	var decls: List[CoreDecl] = []
	var union_index: Int = 0
	var alias_index: Int = 0
	var callable_index: Int = 0

	function_count: Int = if config.function_count > 0:
		config.function_count
	else:
		1

	callable_count: Int = if config.callable_declaration_count > function_count:
		config.callable_declaration_count
	else:
		function_count

	while union_index < config.union_count:
		decls = decls.append(union_decl(union_index))
		union_index += 1

	while alias_index < config.alias_count:
		decls = decls.append(alias_decl(alias_index))
		alias_index += 1

	while callable_index < callable_count:
		body_config: CompilerCorePipelineWorkProfileConfig = if callable_index < function_count:
			config
		else:
			{ config |
				expression_nodes_per_function = 1,
				call_density = 0,
				union_match_density = 0
			}

		decls = decls.append(FunctionDecl(benchmark_function(callable_index, body_config)))
		callable_index += 1

	{
		decls = decls,
		foreign_includes = []
	}


pure func compiler_core_pipeline_work_profile_run(
	config: CompilerCorePipelineWorkProfileConfig,
) -> CompilerCorePipelineWorkProfileResult:
	program: CoreProgram = compiler_core_pipeline_work_profile_program(config)
	var observation: CorePipelineWorkProfileObservation = profile_core_pass_work(
		config.pass_name,
		program,
	)
	var index: Int = 1

	while index < config.iterations:
		observation = profile_core_pass_work(config.pass_name, program)
		index += 1

	{
		observation = observation,
		workload_valid = (
			observation.input_declarations >= config.union_count + config.alias_count
			and observation.input_function_count >= config.function_count
			and observation.input_expression_nodes >= config.function_count
		)
	}
