enum CompilerTypecheckProfileStage:
	CompilerProfileIndexedGraph
	CompilerProfileImportableModules
	CompilerProfileBoundModules
	CompilerProfileDeclarationSkeletons
	CompilerProfileAliasDependencies
	CompilerProfileResolvedTypeParameters
	CompilerProfileTypeHeaders
	CompilerProfileTraitTopology
	CompilerProfileCallableHeaders
	CompilerProfileImplementationHeaders
	CompilerProfileAcceptedGraph
	CompilerProfileCheckedBodies


private record CompilerTypecheckPhaseProfilePlanRep {
	stage: CompilerTypecheckProfileStage,
	iterations: Int
}


opaque type CompilerTypecheckPhaseProfilePlan = CompilerTypecheckPhaseProfilePlanRep


record CompilerTypecheckPhaseProfileObservation {
	stage: CompilerTypecheckProfileStage,
	iterations: Int,
	primary_output_count: Int,
	secondary_output_count: Int,
	checksum: Int
}


union CompilerTypecheckPhaseProfileRun:
	CompilerTypecheckPhaseProfileCompleted(CompilerTypecheckPhaseProfileObservation)
	CompilerTypecheckPhaseProfileInvariantFailed(List[String])


private record CompilerTypecheckPhaseProfileFixtureRep {
	target_candidate: ModuleLoadCandidate,
	module_candidates: List[ModuleLoadCandidate],
	module_paths: List[String],
	indexed_graph: IndexedGraph,
	importable_graph: ImportableModuleGraph,
	bound_graph: BoundModuleGraph,
	declaration_graph: DeclarationSkeletonGraph,
	alias_dependencies: AcyclicTypeAliasDependencyGraph,
	parameter_graph: ResolvedTypeParameterGraph,
	type_headers: TypeHeaderGraph,
	trait_topology: TraitTopologyGraph,
	callable_headers: CallableHeaderGraph,
	implementation_headers: ImplementationHeaderGraph,
	accepted_graph: AcceptedTypecheckGraph
}


opaque type CompilerTypecheckPhaseProfileFixture = CompilerTypecheckPhaseProfileFixtureRep


private struct CompilerTypecheckPhaseOutputSummary {
	primary_count: Int,
	secondary_count: Int,
	fingerprint: Int
}


private union CompilerTypecheckPhaseProfileProduct:
	CompilerIndexedGraphProfileProduct(IndexedGraph)
	CompilerImportableModulesProfileProduct(ImportableModuleGraph)
	CompilerBoundModulesProfileProduct(BoundModuleGraph)
	CompilerDeclarationSkeletonsProfileProduct(DeclarationSkeletonGraph)
	CompilerAliasDependenciesProfileProduct(AcyclicTypeAliasDependencyGraph)
	CompilerResolvedTypeParametersProfileProduct(ResolvedTypeParameterGraph)
	CompilerTypeHeadersProfileProduct(TypeHeaderGraph)
	CompilerTraitTopologyProfileProduct(TraitTopologyGraph)
	CompilerCallableHeadersProfileProduct(CallableHeaderGraph)
	CompilerImplementationHeadersProfileProduct(ImplementationHeaderGraph)
	CompilerAcceptedGraphProfileProduct(AcceptedTypecheckGraph)
	CompilerCheckedBodiesProfileProduct(BodyCheckRun)


private union CompilerTypecheckPhaseProfileExecutionRep:
	CompilerTypecheckPhaseExecutionCompleted(CompilerTypecheckProfileStage, Int, CompilerTypecheckPhaseProfileProduct)
	CompilerTypecheckPhaseExecutionFailed(CompilerTypecheckProfileStage, Int, List[String])


opaque type CompilerTypecheckPhaseProfileExecution = CompilerTypecheckPhaseProfileExecutionRep


private pure func profile_fixture_rep(
	fixture: CompilerTypecheckPhaseProfileFixture,
) -> CompilerTypecheckPhaseProfileFixtureRep:
	from_opaque CompilerTypecheckPhaseProfileFixture(fixture)


pure func compiler_typecheck_phase_profile_fixture_type_headers(
	fixture: CompilerTypecheckPhaseProfileFixture,
) -> TypeHeaderGraph:
	profile_fixture_rep(fixture).type_headers


pure func compiler_typecheck_phase_profile_fixture_accepted_graph(
	fixture: CompilerTypecheckPhaseProfileFixture,
) -> AcceptedTypecheckGraph:
	profile_fixture_rep(fixture).accepted_graph


private pure func profile_plan_rep(
	plan: CompilerTypecheckPhaseProfilePlan,
) -> CompilerTypecheckPhaseProfilePlanRep:
	from_opaque CompilerTypecheckPhaseProfilePlan(plan)


private pure func profile_execution_rep(
	execution: CompilerTypecheckPhaseProfileExecution,
) -> CompilerTypecheckPhaseProfileExecutionRep:
	from_opaque CompilerTypecheckPhaseProfileExecution(execution)


private pure func profile_execution_from_rep(
	representation: CompilerTypecheckPhaseProfileExecutionRep,
) -> CompilerTypecheckPhaseProfileExecution:
	into_opaque CompilerTypecheckPhaseProfileExecution(representation)


pure func compiler_typecheck_phase_profile_plan(
	stage: CompilerTypecheckProfileStage,
	iterations: Int,
) -> Option[CompilerTypecheckPhaseProfilePlan]:
	if iterations > 0:
		Some(into_opaque CompilerTypecheckPhaseProfilePlan({
					stage = stage,
					iterations = iterations
				}))
	else:
		None


pure func compiler_typecheck_phase_profile_stage_name(
	stage: CompilerTypecheckProfileStage,
) -> String:
	match stage:
		CompilerProfileIndexedGraph:
			"indexed"
		CompilerProfileImportableModules:
			"importable"
		CompilerProfileBoundModules:
			"bound"
		CompilerProfileDeclarationSkeletons:
			"skeleton"
		CompilerProfileAliasDependencies:
			"aliases"
		CompilerProfileResolvedTypeParameters:
			"parameters"
		CompilerProfileTypeHeaders:
			"headers"
		CompilerProfileTraitTopology:
			"topology"
		CompilerProfileCallableHeaders:
			"callables"
		CompilerProfileImplementationHeaders:
			"implementations"
		CompilerProfileAcceptedGraph:
			"accepted"
		CompilerProfileCheckedBodies:
			"bodies"


private pure func indexed_error_messages(errors: List[IndexedGraphError]) -> List[String]:
	errors.map(indexed_graph_error_message)


private pure func bound_error_messages(errors: List[BoundModuleGraphError]) -> List[String]:
	errors.map(bound_module_graph_error_message)


private pure func skeleton_error_messages(
	errors: List[DeclarationSkeletonGraphError],
) -> List[String]:
	errors.map(declaration_skeleton_graph_error_message)


private pure func parameter_error_messages(
	errors: List[ResolvedTypeParameterGraphError],
) -> List[String]:
	errors.map(resolved_type_parameter_graph_error_message)


private pure func header_error_messages(errors: List[TypeHeaderError]) -> List[String]:
	errors.map(type_header_error_message)


private pure func trait_topology_error_messages(
	errors: List[TraitTopologyGraphError],
) -> List[String]:
	errors.map(trait_topology_graph_error_message)


private pure func callable_header_error_messages(
	errors: List[CallableHeaderGraphError],
) -> List[String]:
	errors.map(callable_header_graph_error_message)


private pure func implementation_header_error_messages(
	errors: List[ImplementationHeaderGraphError],
) -> List[String]:
	errors.map(implementation_header_graph_error_message)


private pure func profile_bind_module(
	scope: PreparedModuleScope,
	importable_index: ImportableModuleIndex,
) -> BoundModuleViewBinding:
	module = prepared_module_scope_module(scope)
	state = typecheck_state_for_prepared_module_scope(scope, False)
	typecheck_bind_program_module_view(
		state,
		prepared_module_program(module),
		importable_index,
		prepared_module_scope_canonical_path(scope),
	)


private pure func profile_bound_graph(
	indexed_graph: IndexedGraph,
	module_paths: List[String],
	importable_index: ImportableModuleIndex,
) -> Result[BoundModuleGraph, List[BoundModuleGraphError]]:
	bound_module_graph_build(
		indexed_graph,
		module_paths,
		func(scope): profile_bind_module(scope, importable_index),
	)


private pure func complete_profile_fixture(
	target_candidate: ModuleLoadCandidate,
	module_candidates: List[ModuleLoadCandidate],
	module_paths: List[String],
	indexed_graph: IndexedGraph,
	importable_graph: ImportableModuleGraph,
	bound_graph: BoundModuleGraph,
	declaration_graph: DeclarationSkeletonGraph,
	alias_dependencies: AcyclicTypeAliasDependencyGraph,
	parameter_graph: ResolvedTypeParameterGraph,
	type_headers: TypeHeaderGraph,
) -> Result[CompilerTypecheckPhaseProfileFixture, List[String]]:
	match trait_topology_graph_build(type_headers):
		Err(errors):
			Err(trait_topology_error_messages(errors))
		Ok(trait_topology):
			match callable_header_graph_build(trait_topology):
				Err(_):
					Err(["typecheck profile fixture callable headers were rejected"])
				Ok(callable_headers):
					match implementation_header_graph_build(callable_headers):
						Err(_):
							Err(["typecheck profile fixture implementation headers were rejected"])
						Ok(implementation_headers):
							match complete_typecheck_graph(
								implementation_headers,
								importable_graph,
								False,
							):
								TypecheckGraphAccepted(accepted_graph):
									Ok(into_opaque CompilerTypecheckPhaseProfileFixture({
												target_candidate = target_candidate,
												module_candidates = module_candidates,
												module_paths = module_paths,
												indexed_graph = indexed_graph,
												importable_graph = importable_graph,
												bound_graph = bound_graph,
												declaration_graph = declaration_graph,
												alias_dependencies = alias_dependencies,
												parameter_graph = parameter_graph,
												type_headers = type_headers,
												trait_topology = trait_topology,
												callable_headers = callable_headers,
												implementation_headers = implementation_headers,
												accepted_graph = accepted_graph
											}))
								_:
									Err(
										[
											"typecheck profile fixture products do not share one indexed graph",
										],
									)


pure func compiler_typecheck_phase_profile_fixture(
	target_candidate: ModuleLoadCandidate,
	module_candidates: List[ModuleLoadCandidate],
	module_paths: List[String],
) -> Result[CompilerTypecheckPhaseProfileFixture, List[String]]:
	match indexed_graph_build(target_candidate, module_candidates):
		Err(errors):
			Err(indexed_error_messages(errors))
		Ok(indexed_graph):
			importable_graph = importable_module_graph(indexed_graph)
			importable_index = importable_module_graph_all_index(importable_graph)

			match profile_bound_graph(indexed_graph, module_paths, importable_index):
				Err(errors):
					Err(bound_error_messages(errors))
				Ok(bound_graph):
					match declaration_skeleton_graph_build(bound_graph):
						Err(errors):
							Err(skeleton_error_messages(errors))
						Ok(declaration_graph):
							match type_alias_dependency_graph_validate(declaration_graph):
								Err(errors):
									Err(errors)
								Ok(alias_dependencies):
									match resolved_type_parameter_graph_build(alias_dependencies):
										Err(errors):
											Err(parameter_error_messages(errors))
										Ok(parameter_graph):
											match type_header_graph_build(parameter_graph):
												Err(errors):
													Err(header_error_messages(errors))
												Ok(type_headers):
													complete_profile_fixture(
														target_candidate,
														module_candidates,
														module_paths,
														indexed_graph,
														importable_graph,
														bound_graph,
														declaration_graph,
														alias_dependencies,
														parameter_graph,
														type_headers,
													)


private pure func fingerprint_add_text(fingerprint: Int, text: String) -> Int:
	hash_combine(fingerprint, crc32(text))


private pure func fingerprint_add_int(fingerprint: Int, value: Int) -> Int:
	hash_combine(fingerprint, value)


private pure func fingerprint_add_bool(fingerprint: Int, value: Bool) -> Int:
	if value:
		fingerprint_add_int(fingerprint, 1)
	else:
		fingerprint_add_int(fingerprint, 0)


private pure func fingerprint_add_optional_int(fingerprint: Int, value: Option[Int]) -> Int:
	match value:
		Some(inner):
			fingerprint
				.fingerprint_add_text("some")
				.fingerprint_add_int(inner)
		None:
			fingerprint.fingerprint_add_text("none")


private pure func fingerprint_add_optional_text(fingerprint: Int, value: Option[String]) -> Int:
	match value:
		Some(inner):
			fingerprint
				.fingerprint_add_text("some")
				.fingerprint_add_text(inner)
		None:
			fingerprint.fingerprint_add_text("none")


private pure func fingerprint_source_span(fingerprint: Int, span: SourceSpan) -> Int:
	fingerprint
		.fingerprint_add_text(span.path)
		.fingerprint_add_text(span.module_name)
		.fingerprint_add_int(span.start_offset)
		.fingerprint_add_int(span.start_line)
		.fingerprint_add_int(span.start_column)
		.fingerprint_add_int(span.end_offset)
		.fingerprint_add_int(span.end_line)
		.fingerprint_add_int(span.end_column)


private pure func source_definition_kind_name(kind: SourceDefinitionKind) -> String:
	match kind:
		ConstructorDefinition:
			"constructor"
		TraitDefinition:
			"trait"
		ImplDefinition:
			"implementation"
		GlobalDefinition:
			"global"
		TypeDefinition:
			"type"
		FieldDefinition:
			"field"


private pure func fingerprint_callable_key(fingerprint: Int, key: FuncCallableKey) -> Int:
	fingerprint_source_span(
		fingerprint
			.fingerprint_add_text(
				module_identity_storage_key(func_callable_key_module_identity(key)),
			)
			.fingerprint_add_text(func_callable_key_name(key)),
		func_callable_key_span(key),
	)


private pure func fingerprint_source_definition_key(
	fingerprint: Int,
	key: SourceDefinitionKey,
) -> Int:
	fingerprint_source_span(
		fingerprint
			.fingerprint_add_text(
				module_identity_storage_key(source_definition_key_module_identity(key)),
			)
			.fingerprint_add_text(source_definition_kind_name(source_definition_key_kind(key)))
			.fingerprint_add_text(source_definition_key_name(key))
			.fingerprint_add_optional_text(source_definition_key_owner(key)),
		source_definition_key_span(key),
	)


private pure func type_id_fingerprint_text(id: TypeId) -> String:
	module_identity_storage_key(type_id_module_identity(id)) + ":" + type_id_name(id)


private pure func fingerprint_type_parameter(
	fingerprint: Int,
	parameter: ResolvedTypeParameter,
) -> Int:
	var next = fingerprint
		.fingerprint_add_text(type_id_fingerprint_text(type_parameter_id_owner(parameter.id)))
		.fingerprint_add_int(type_parameter_id_index(parameter.id))
		.fingerprint_add_text(type_parameter_id_name(parameter.id))
		.fingerprint_add_int(parameter.bounds.length())

	for bound in parameter.bounds:
		next = next.fingerprint_add_text(
			module_identity_storage_key(
				trait_id_module_identity(bound),
			) + ":" + trait_id_name(bound),
		)

	next


private pure func fingerprint_resolved_type_shape(
	fingerprint: Int,
	shape: ResolvedTypeShape,
) -> Int:
	match shape:
		DeclaredTypeShape(id, args):
			var next = fingerprint
				.fingerprint_add_text("declared")
				.fingerprint_add_text(type_id_fingerprint_text(id))
				.fingerprint_add_int(args.length())

			for arg in args:
				next = fingerprint_resolved_type_shape(next, arg)

			next
		IntrinsicTypeShape(intrinsic, args):
			var next = fingerprint
				.fingerprint_add_text("intrinsic")
				.fingerprint_add_text(intrinsic_type_name(intrinsic))
				.fingerprint_add_int(args.length())

			for arg in args:
				next = fingerprint_resolved_type_shape(next, arg)

			next
		PreludeTypeShape(prelude_type, args):
			var next = fingerprint
				.fingerprint_add_text("prelude")
				.fingerprint_add_text(prelude_type_name(prelude_type))
				.fingerprint_add_int(args.length())

			for arg in args:
				next = fingerprint_resolved_type_shape(next, arg)

			next
		TypeParameterShape(id):
			fingerprint
				.fingerprint_add_text("parameter")
				.fingerprint_add_text(type_id_fingerprint_text(type_parameter_id_owner(id)))
				.fingerprint_add_int(type_parameter_id_index(id))
				.fingerprint_add_text(type_parameter_id_name(id))
		SelfTypeShape(id):
			fingerprint
				.fingerprint_add_text("self")
				.fingerprint_add_text(type_id_fingerprint_text(id))
		TraitTypeParameterShape(id):
			fingerprint
				.fingerprint_add_text("trait-parameter")
				.fingerprint_add_int(trait_type_parameter_id_index(id))
				.fingerprint_add_text(trait_type_parameter_id_name(id))
		CallableTypeParameterShape(id):
			fingerprint
				.fingerprint_add_text("callable-parameter")
				.fingerprint_add_int(callable_type_parameter_id_index(id))
				.fingerprint_add_text(callable_type_parameter_id_name(id))
		ImplementationTypeParameterShape(id):
			fingerprint
				.fingerprint_add_text("implementation-parameter")
				.fingerprint_add_int(implementation_type_parameter_id_index(id))
				.fingerprint_add_text(implementation_type_parameter_id_name(id))
		TraitSelfTypeShape(id):
			fingerprint
				.fingerprint_add_text("trait-self")
				.fingerprint_add_text(trait_id_name(id))
		DimensionParameterShape(id, variadic):
			fingerprint
				.fingerprint_add_text("dimension-parameter")
				.fingerprint_add_text(type_id_fingerprint_text(type_parameter_id_owner(id)))
				.fingerprint_add_int(type_parameter_id_index(id))
				.fingerprint_add_text(type_parameter_id_name(id))
				.fingerprint_add_bool(variadic)
		TraitDimensionParameterShape(id, variadic):
			fingerprint
				.fingerprint_add_text("trait-dimension-parameter")
				.fingerprint_add_int(trait_type_parameter_id_index(id))
				.fingerprint_add_text(trait_type_parameter_id_name(id))
				.fingerprint_add_bool(variadic)
		CallableDimensionParameterShape(id, variadic):
			fingerprint
				.fingerprint_add_text("callable-dimension-parameter")
				.fingerprint_add_int(callable_type_parameter_id_index(id))
				.fingerprint_add_text(callable_type_parameter_id_name(id))
				.fingerprint_add_bool(variadic)
		ImplementationDimensionParameterShape(id, variadic):
			fingerprint
				.fingerprint_add_text("implementation-dimension-parameter")
				.fingerprint_add_int(implementation_type_parameter_id_index(id))
				.fingerprint_add_text(implementation_type_parameter_id_name(id))
				.fingerprint_add_bool(variadic)
		WildcardDimensionShape(variadic):
			fingerprint
				.fingerprint_add_text("wildcard-dimension")
				.fingerprint_add_bool(variadic)
		DimensionLiteralShape(value):
			fingerprint
				.fingerprint_add_text("dimension-literal")
				.fingerprint_add_int(value)
		DimensionBinaryShape(op, left, right):
			op_name = match op:
				ResolvedDimAdd:
					"add"
				ResolvedDimSubtract:
					"subtract"
				ResolvedDimMultiply:
					"multiply"
				ResolvedDimDivide:
					"divide"

			fingerprint_resolved_type_shape(
				fingerprint_resolved_type_shape(
					fingerprint
						.fingerprint_add_text("dimension-binary")
						.fingerprint_add_text(op_name),
					left,
				),
				right,
			)
		RangeTypeShape(inner):
			fingerprint_resolved_type_shape(
				fingerprint.fingerprint_add_text("range"),
				inner,
			)
		TupleTypeShape(items):
			var next = fingerprint
				.fingerprint_add_text("tuple")
				.fingerprint_add_int(items.length())

			for item in items:
				next = fingerprint_resolved_type_shape(next, item)

			next
		FunctionTypeShape(is_pure, params, return_type):
			var next = fingerprint
				.fingerprint_add_text("function")
				.fingerprint_add_bool(is_pure)
				.fingerprint_add_int(params.length())

			for parameter in params:
				next = fingerprint_resolved_type_shape(next, parameter)

			fingerprint_resolved_type_shape(next, return_type)
		ArrayTypeShape(element, dimensions):
			var next = fingerprint_resolved_type_shape(
				fingerprint.fingerprint_add_text("array"),
				element,
			).fingerprint_add_int(dimensions.length())

			for dimension in dimensions:
				next = fingerprint_resolved_type_shape(next, dimension)

			next


private pure func skeleton_kind_name(kind: DeclarationSkeletonKind) -> String:
	match kind:
		TypeSkeletonKind:
			"type"
		ConstructorSkeletonKind:
			"constructor"
		CallableSkeletonKind:
			"callable"
		TraitSkeletonKind:
			"trait"
		TraitMethodSkeletonKind:
			"trait-method"
		GlobalSkeletonKind:
			"global"
		ImplementationSkeletonKind:
			"implementation"


private pure func fingerprint_import_symbol(fingerprint: Int, symbol: ParsedImportSymbol) -> Int:
	var next = fingerprint.fingerprint_add_text(symbol.name.text)

	next = match symbol.symbol_alias:
		Some(alias_name):
			next
				.fingerprint_add_text("alias")
				.fingerprint_add_text(alias_name.text)
		None:
			next.fingerprint_add_text("no-alias")

	for constructor in symbol.constructors:
		next = next.fingerprint_add_text(constructor.text)

	next


private pure func fingerprint_import_decl(fingerprint: Int, decl: ParsedImportDecl) -> Int:
	var next = fingerprint.fingerprint_add_text(decl.module_path)

	next = match decl.module_alias:
		Some(alias_name):
			next
				.fingerprint_add_text("alias")
				.fingerprint_add_text(alias_name.text)
		None:
			next.fingerprint_add_text("no-alias")

	match decl.symbols:
		Some(symbols):
			next = next
				.fingerprint_add_text("selective")
				.fingerprint_add_int(symbols.length())

			for symbol in symbols:
				next = fingerprint_import_symbol(next, symbol)
		None:
			next = next.fingerprint_add_text("qualified")

	next


private pure func fingerprint_importable_module(fingerprint: Int, module: ImportableModule) -> Int:
	var next = fingerprint.fingerprint_add_text(importable_module_path(module))
	local_types = importable_module_local_type_names(module)
	next = next.fingerprint_add_int(local_types.length())

	for name in local_types:
		next = next.fingerprint_add_text(name)

	imports = importable_module_declared_imports(module)
	next = next.fingerprint_add_int(imports.length())

	for decl in imports:
		next = fingerprint_import_decl(next, decl)

	signatures = importable_module_signature_decls(module)
	next = next.fingerprint_add_int(signatures.length())

	for signature in signatures:
		match signature:
			ImportableFunctionDecl(decl):
				next = next
					.fingerprint_add_text("function")
					.fingerprint_add_text(decl.name.text)
			ImportableVarDecl(decl):
				next = next
					.fingerprint_add_text("variable")
					.fingerprint_add_text(decl.name.text)
			ImportableForeignFunctionDecl(decl):
				next = next
					.fingerprint_add_text("foreign")
					.fingerprint_add_text(decl.name.text)
			ImportableTraitDecl(decl):
				next = next
					.fingerprint_add_text("trait")
					.fingerprint_add_text(decl.name.text)

	impls = importable_module_impl_decls(module)
	next = next.fingerprint_add_int(impls.length())

	for impl in impls:
		next = next
			.fingerprint_add_text(impl.trait_name.text)
			.fingerprint_add_int(impl.methods.length())

		for method in impl.methods:
			next = next.fingerprint_add_text(method.name.text)

	next.fingerprint_add_int(importable_module_decls(module).length())


private pure func fingerprint_bound_module(fingerprint: Int, module: BoundModule) -> Int:
	var next = fingerprint.fingerprint_add_text(bound_module_canonical_path(module))
	view = bound_module_view(module)

	for alias_binding in module_view_module_aliases(view):
		next = next
			.fingerprint_add_text(alias_binding[0])
			.fingerprint_add_text(alias_binding[1])

	for imported_name in module_view_imported_names(view):
		next = next
			.fingerprint_add_text(imported_name.local_name)
			.fingerprint_add_text(imported_name.module_path)
			.fingerprint_add_text(imported_name.original_name)

	for imported_module in module_view_imported_modules(view):
		next = next.fingerprint_add_text(imported_module)

	for visible in bound_module_visible_import_modules(module):
		next = next
			.fingerprint_add_text("visible")
			.fingerprint_add_text(importable_module_path(visible))

	for direct in bound_module_direct_import_modules(module):
		next = next
			.fingerprint_add_text("direct")
			.fingerprint_add_text(importable_module_path(direct))

	for diagnostic in bound_module_binding_diagnostics(module):
		next = next
			.fingerprint_add_text("diagnostic")
			.fingerprint_add_text(diagnostic.message)

	next


private pure func indexed_output_summary(
	graph: IndexedGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	index = indexed_graph_definition_index(graph)
	var fingerprint = fingerprint_add_text(
		0,
		prepared_module_canonical_path(indexed_graph_target(graph)),
	)

	for module in indexed_graph_modules(graph):
		fingerprint = fingerprint_add_text(fingerprint, prepared_module_canonical_path(module))

	for binding in definition_index_all_func_callable_bindings(index):
		fingerprint = fingerprint_callable_key(
			fingerprint.fingerprint_add_text("callable"),
			binding[0],
		).fingerprint_add_int(binding[1])

	for binding in definition_index_all_source_definition_bindings(index):
		fingerprint = fingerprint_source_definition_key(
			fingerprint.fingerprint_add_text("source"),
			binding[0],
		).fingerprint_add_int(binding[1])

	callable_count = definition_index_func_callable_id_count(index)
	source_count = definition_index_source_definition_id_count(index)
	fingerprint = fingerprint_add_int(fingerprint, callable_count)
	fingerprint = fingerprint_add_int(fingerprint, source_count)
	{
		primary_count = indexed_graph_modules(graph).length() + 1,
		secondary_count = callable_count + source_count,
		fingerprint = fingerprint
	}


private pure func bound_output_summary(
	graph: BoundModuleGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	var fingerprint = fingerprint_bound_module(0, bound_module_graph_target(graph))

	for module in bound_module_graph_modules(graph):
		fingerprint = fingerprint_bound_module(fingerprint, module)

	{
		primary_count = bound_module_graph_modules(graph).length() + 1,
		secondary_count = bound_module_graph_modules(graph).length(),
		fingerprint = fingerprint
	}


private pure func importable_output_summary(
	graph: ImportableModuleGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	modules = importable_module_graph_all(graph)
	var fingerprint: Int = 0

	for module in modules:
		fingerprint = fingerprint_importable_module(fingerprint, module)

	{
		primary_count = modules.length(),
		secondary_count = 0,
		fingerprint = fingerprint
	}


private pure func skeleton_output_summary(
	graph: DeclarationSkeletonGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	skeletons = declaration_skeleton_graph_skeletons(graph)
	var fingerprint: Int = 0

	for skeleton in skeletons:
		fingerprint = fingerprint_add_text(
			fingerprint,
			skeleton_kind_name(
				declaration_skeleton_kind(skeleton),
			) + ":" + declaration_skeleton_name(skeleton),
		)

	{
		primary_count = skeletons.length(),
		secondary_count = declaration_skeleton_graph_type_skeletons(graph).length(),
		fingerprint = fingerprint
	}


private pure func alias_output_summary(
	graph: AcyclicTypeAliasDependencyGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	nodes = acyclic_type_alias_dependency_graph_nodes(graph)
	var fingerprint: Int = 0

	for node in nodes:
		fingerprint = fingerprint_add_text(fingerprint, type_id_fingerprint_text(node.id))

		for dependency in node.dependencies:
			fingerprint = fingerprint_add_text(fingerprint, type_id_fingerprint_text(dependency))

	{
		primary_count = nodes.length(),
		secondary_count = 0,
		fingerprint = fingerprint
	}


private pure func parameter_output_summary(
	graph: ResolvedTypeParameterGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	entries = resolved_type_parameter_graph_entries(graph)
	var fingerprint: Int = 0

	for entry in entries:
		fingerprint = fingerprint_add_text(fingerprint, type_id_fingerprint_text(entry.type_id))

		for parameter in entry.parameters:
			fingerprint = fingerprint_type_parameter(fingerprint, parameter)

	{
		primary_count = entries.length(),
		secondary_count = 0,
		fingerprint = fingerprint
	}


private pure func header_output_summary(
	graph: TypeHeaderGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	headers = type_header_graph_headers(graph)
	var fingerprint: Int = 0

	for header in headers:
		fingerprint = fingerprint_add_text(fingerprint, type_id_fingerprint_text(header.id))
		parameters = header.parameters
		fingerprint = fingerprint.fingerprint_add_int(parameters.length())

		for parameter in parameters:
			fingerprint = fingerprint_type_parameter(fingerprint, parameter)

		fingerprint = fingerprint.fingerprint_add_bool(header.containment.contains_resource)

		match header.shape:
			RecordTypeHeader(layout, fields):
				layout_name = match layout:
					HeapRecord:
						"heap"
					ValueStruct:
						"struct"

				fingerprint = fingerprint
					.fingerprint_add_text("record")
					.fingerprint_add_text(layout_name)
					.fingerprint_add_int(fields.length())

				for field in fields:
					fingerprint = fingerprint_resolved_type_shape(
						fingerprint
							.fingerprint_add_text(field.name)
							.fingerprint_add_optional_int(field.definition_id),
						field.typ,
					)
			UnionTypeHeader(layout, variants):
				layout_name = match layout:
					TaggedUnion:
						"tagged"
					FieldlessEnum:
						"enum"

				fingerprint = fingerprint
					.fingerprint_add_text("union")
					.fingerprint_add_text(layout_name)
					.fingerprint_add_int(variants.length())

				for variant in variants:
					fingerprint = fingerprint
						.fingerprint_add_text(variant.name)
						.fingerprint_add_int(variant.tag)
						.fingerprint_add_int(constructor_id_definition_id(variant.id))
						.fingerprint_add_text(type_id_fingerprint_text(variant.parent_type_id))
						.fingerprint_add_int(variant.fields.length())

					for field in variant.fields:
						fingerprint = fingerprint_resolved_type_shape(fingerprint, field)
			BuiltinTypeHeader(layout):
				fingerprint = fingerprint.fingerprint_add_text("builtin")

				match layout:
					ScalarBuiltin:
						fingerprint = fingerprint.fingerprint_add_text("scalar")
					ManagedBuiltin:
						fingerprint = fingerprint.fingerprint_add_text("managed")
					NoValueBuiltin:
						fingerprint = fingerprint.fingerprint_add_text("no-value")
					UnclassifiedBuiltin:
						fingerprint = fingerprint.fingerprint_add_text("unclassified")
					ResourceBuiltin(policy):
						fingerprint = fingerprint.fingerprint_add_text("resource")

						match policy:
							ResourceWithoutCleanup:
								fingerprint = fingerprint.fingerprint_add_text("no-cleanup")
							ResourceWithCleanup(cleanup):
								fingerprint = fingerprint
									.fingerprint_add_text("cleanup")
									.fingerprint_add_text(cleanup)
			AliasTypeHeader(layout, target):
				layout_name = match layout:
					TransparentAlias:
						"transparent"
					OpaqueAlias:
						"opaque"

				fingerprint = fingerprint_resolved_type_shape(
					fingerprint
						.fingerprint_add_text("alias")
						.fingerprint_add_text(layout_name),
					target,
				)

	{
		primary_count = headers.length(),
		secondary_count = 0,
		fingerprint = fingerprint
	}


private pure func fingerprint_callable_signature(
	fingerprint: Int,
	signature: CallableSignature,
) -> Int:
	parameters = callable_signature_parameters(signature)
	var next = fingerprint
		.fingerprint_add_int(parameters.length())
		.fingerprint_add_bool(callable_signature_is_pure(signature))

	for parameter in parameters:
		next = fingerprint_resolved_type_shape(next, parameter.typ)

	fingerprint_resolved_type_shape(next, callable_signature_return_type(signature))


private pure func trait_topology_output_summary(
	graph: TraitTopologyGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	headers = trait_topology_graph_headers(graph)
	var method_count: Int = 0
	var fingerprint: Int = 0

	for header in headers:
		id = trait_topology_header_id(header)
		fingerprint = fingerprint
			.fingerprint_add_int(trait_id_definition_id(id))
			.fingerprint_add_text(trait_id_name(id))

		for supertrait in trait_topology_header_supertraits(header):
			fingerprint = fingerprint.fingerprint_add_int(trait_id_definition_id(supertrait))

		methods = trait_topology_header_methods(header)
		method_count += methods.length()

		for method in methods:
			method_id = trait_method_slot_id(method)
			fingerprint = fingerprint_callable_signature(
				fingerprint.fingerprint_add_int(trait_method_id_index(method_id)),
				trait_method_slot_signature(method),
			)

	{
		primary_count = headers.length(),
		secondary_count = method_count,
		fingerprint = fingerprint
	}


private pure func callable_header_output_summary(
	graph: CallableHeaderGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	callables = callable_header_graph_callables(graph)
	globals = callable_header_graph_globals(graph)
	var fingerprint: Int = 0

	for callable in callables:
		fingerprint = fingerprint_callable_signature(
			fingerprint
				.fingerprint_add_int(callable_id_definition_id(callable_header_id(callable)))
				.fingerprint_add_text(callable_header_name(callable)),
			callable_header_signature(callable),
		)

	for global in globals:
		id = global_header_id(global)
		fingerprint = fingerprint
			.fingerprint_add_text(module_identity_storage_key(global_id_module_identity(id)))
			.fingerprint_add_text(global_header_name(global))

		match annotated_global_header_type(global):
			Some(typ):
				fingerprint = fingerprint_resolved_type_shape(
					fingerprint.fingerprint_add_text("annotated"),
					typ,
				)
			None:
				fingerprint = fingerprint.fingerprint_add_text("pending")

	{
		primary_count = callables.length(),
		secondary_count = globals.length(),
		fingerprint = fingerprint
	}


private pure func implementation_header_output_summary(
	graph: ImplementationHeaderGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	headers = implementation_header_graph_headers(graph)
	var method_count: Int = 0
	var fingerprint: Int = 0

	for header in headers:
		method_ids = implementation_header_method_ids(header)
		method_count += method_ids.length()
		fingerprint = fingerprint_resolved_type_shape(
			fingerprint
				.fingerprint_add_int(impl_id_definition_id(implementation_header_id(header)))
				.fingerprint_add_int(
					trait_id_definition_id(implementation_header_trait_id(header)),
				),
			implementation_header_receiver(header),
		)

		for method_id in method_ids:
			fingerprint = fingerprint.fingerprint_add_int(callable_id_definition_id(method_id))

	{
		primary_count = headers.length(),
		secondary_count = method_count,
		fingerprint = fingerprint
	}


private pure func accepted_output_summary(
	graph: AcceptedTypecheckGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	modules = accepted_typecheck_graph_import_modules(graph)
	completed_globals = accepted_typecheck_graph_completed_globals(graph)
	completion_metrics = accepted_typecheck_graph_global_completion_metrics(graph)
	var fingerprint = fingerprint_add_int(
		0,
		accepted_typecheck_graph_declaration_skeleton_count(graph),
	)

	for module in modules:
		fingerprint = fingerprint_add_text(fingerprint, importable_module_path(module))

	for completed in completed_globals:
		fingerprint = fingerprint_add_text(
			fingerprint,
			global_id_name(completed_global_header_id(completed)),
		)
		fingerprint = fingerprint_add_int(
			fingerprint,
			completed_global_header_global_dependencies(completed).length(),
		)
		fingerprint = fingerprint_add_int(
			fingerprint,
			completed_global_header_callable_dependencies(completed).length(),
		)

	fingerprint = fingerprint_add_int(fingerprint, completion_metrics.initializer_checks)
	fingerprint = fingerprint_add_int(
		fingerprint,
		completion_metrics.duplicate_initializer_requests,
	)

	{
		primary_count = accepted_typecheck_graph_declaration_skeleton_count(graph),
		secondary_count = completed_globals.length(),
		fingerprint = fingerprint
	}


private pure func checked_bodies_output_summary(
	run: BodyCheckRun,
) -> CompilerTypecheckPhaseOutputSummary:
	var fingerprint: Int = 0

	for id in run.metrics.checked_order:
		fingerprint = fingerprint_add_int(fingerprint, callable_id_definition_id(id))

	for error in run.result.state.errors:
		fingerprint = fingerprint_add_text(fingerprint, error)

	{
		primary_count = run.metrics.infer_sessions,
		secondary_count = run.result.state.errors.length(),
		fingerprint = fingerprint
	}


private pure func execute_profile_stage_once(
	fixture: CompilerTypecheckPhaseProfileFixtureRep,
	stage: CompilerTypecheckProfileStage,
) -> Result[CompilerTypecheckPhaseProfileProduct, List[String]]:
	match stage:
		CompilerProfileIndexedGraph:
			match indexed_graph_build(fixture.target_candidate, fixture.module_candidates):
				Err(errors):
					Err(indexed_error_messages(errors))
				Ok(graph):
					Ok(CompilerIndexedGraphProfileProduct(graph))
		CompilerProfileImportableModules:
			Ok(
				CompilerImportableModulesProfileProduct(
					importable_module_graph(fixture.indexed_graph),
				),
			)
		CompilerProfileBoundModules:
			match profile_bound_graph(
				fixture.indexed_graph,
				fixture.module_paths,
				importable_module_graph_all_index(fixture.importable_graph),
			):
				Err(errors):
					Err(bound_error_messages(errors))
				Ok(graph):
					Ok(CompilerBoundModulesProfileProduct(graph))
		CompilerProfileDeclarationSkeletons:
			match declaration_skeleton_graph_build(fixture.bound_graph):
				Err(errors):
					Err(skeleton_error_messages(errors))
				Ok(graph):
					Ok(CompilerDeclarationSkeletonsProfileProduct(graph))
		CompilerProfileAliasDependencies:
			match type_alias_dependency_graph_validate(fixture.declaration_graph):
				Err(errors):
					Err(errors)
				Ok(graph):
					Ok(CompilerAliasDependenciesProfileProduct(graph))
		CompilerProfileResolvedTypeParameters:
			match resolved_type_parameter_graph_build(fixture.alias_dependencies):
				Err(errors):
					Err(parameter_error_messages(errors))
				Ok(graph):
					Ok(CompilerResolvedTypeParametersProfileProduct(graph))
		CompilerProfileTypeHeaders:
			match type_header_graph_build(fixture.parameter_graph):
				Err(errors):
					Err(header_error_messages(errors))
				Ok(graph):
					Ok(CompilerTypeHeadersProfileProduct(graph))
		CompilerProfileTraitTopology:
			match trait_topology_graph_build(fixture.type_headers):
				Err(errors):
					Err(trait_topology_error_messages(errors))
				Ok(graph):
					if trait_topology_graph_headers(graph).is_empty():
						Err(["trait topology profile requires at least one trait header"])
					else:
						Ok(CompilerTraitTopologyProfileProduct(graph))
		CompilerProfileCallableHeaders:
			match callable_header_graph_build(fixture.trait_topology):
				Err(errors):
					Err(callable_header_error_messages(errors))
				Ok(graph):
					if (
						callable_header_graph_callables(graph).is_empty()
						and callable_header_graph_globals(graph).is_empty()
					):
						Err(["callable header profile requires at least one callable or global"])
					else:
						Ok(CompilerCallableHeadersProfileProduct(graph))
		CompilerProfileImplementationHeaders:
			match implementation_header_graph_build(fixture.callable_headers):
				Err(errors):
					Err(implementation_header_error_messages(errors))
				Ok(graph):
					if implementation_header_graph_headers(graph).is_empty():
						Err(["implementation header profile requires at least one implementation"])
					else:
						Ok(CompilerImplementationHeadersProfileProduct(graph))
		CompilerProfileAcceptedGraph:
			match complete_typecheck_graph(
				fixture.implementation_headers,
				fixture.importable_graph,
				False,
			):
				TypecheckGraphAccepted(graph):
					Ok(CompilerAcceptedGraphProfileProduct(graph))
				_:
					Err(["accepted typecheck profile products became incompatible"])
		CompilerProfileCheckedBodies:
			target = bound_module_graph_target(fixture.bound_graph)
			state = typecheck_state_for_prepared_module_scope(bound_module_scope(target), False)

			match accepted_graph_typecheck_module(
				fixture.accepted_graph,
				bound_module_identity(target),
				state,
			):
				None:
					Err(["accepted graph could not construct the target body-check module"])
				Some(module):
					Ok(
						CompilerCheckedBodiesProfileProduct(
							typecheck_program_with_type_header_module_in_body_order_for_policy(
								module,
								SourceBodyOrder,
								IgnoreMainName,
							),
						),
					)


pure func compiler_typecheck_phase_profile_execute(
	fixture: CompilerTypecheckPhaseProfileFixture,
	plan: CompilerTypecheckPhaseProfilePlan,
) -> CompilerTypecheckPhaseProfileExecution:
	representation = profile_fixture_rep(fixture)
	plan_representation = profile_plan_rep(plan)

	match execute_profile_stage_once(representation, plan_representation.stage):
		Err(errors):
			profile_execution_from_rep(
				CompilerTypecheckPhaseExecutionFailed(
					plan_representation.stage,
					plan_representation.iterations,
					errors,
				),
			)
		Ok(first_product):
			var product = first_product
			var errors: List[String] = []
			var iteration: Int = 1

			while iteration < plan_representation.iterations and errors.is_empty():
				match execute_profile_stage_once(representation, plan_representation.stage):
					Err(iteration_errors):
						errors = iteration_errors
					Ok(iteration_product):
						product = iteration_product

				iteration += 1

			execution_rep = if errors.is_empty():
				CompilerTypecheckPhaseExecutionCompleted(
					plan_representation.stage,
					plan_representation.iterations,
					product,
				)
			else:
				CompilerTypecheckPhaseExecutionFailed(
					plan_representation.stage,
					plan_representation.iterations,
					errors,
				)

			profile_execution_from_rep(execution_rep)


private pure func profile_product_summary(
	product: CompilerTypecheckPhaseProfileProduct,
) -> CompilerTypecheckPhaseOutputSummary:
	match product:
		CompilerIndexedGraphProfileProduct(graph):
			indexed_output_summary(graph)
		CompilerImportableModulesProfileProduct(graph):
			importable_output_summary(graph)
		CompilerBoundModulesProfileProduct(graph):
			bound_output_summary(graph)
		CompilerDeclarationSkeletonsProfileProduct(graph):
			skeleton_output_summary(graph)
		CompilerAliasDependenciesProfileProduct(graph):
			alias_output_summary(graph)
		CompilerResolvedTypeParametersProfileProduct(graph):
			parameter_output_summary(graph)
		CompilerTypeHeadersProfileProduct(graph):
			header_output_summary(graph)
		CompilerTraitTopologyProfileProduct(graph):
			trait_topology_output_summary(graph)
		CompilerCallableHeadersProfileProduct(graph):
			callable_header_output_summary(graph)
		CompilerImplementationHeadersProfileProduct(graph):
			implementation_header_output_summary(graph)
		CompilerAcceptedGraphProfileProduct(graph):
			accepted_output_summary(graph)
		CompilerCheckedBodiesProfileProduct(run):
			checked_bodies_output_summary(run)


pure func compiler_typecheck_phase_profile_observe(
	execution: CompilerTypecheckPhaseProfileExecution,
) -> CompilerTypecheckPhaseProfileRun:
	match profile_execution_rep(execution):
		CompilerTypecheckPhaseExecutionFailed(_, _, errors):
			CompilerTypecheckPhaseProfileInvariantFailed(errors)
		CompilerTypecheckPhaseExecutionCompleted(stage, iterations, product):
			summary = profile_product_summary(product)
			CompilerTypecheckPhaseProfileCompleted({
				stage = stage,
				iterations = iterations,
				primary_output_count = summary.primary_count,
				secondary_output_count = summary.secondary_count,
				checksum = fingerprint_add_int(summary.fingerprint, summary.primary_count)
					.fingerprint_add_int(summary.secondary_count)
					.fingerprint_add_int(iterations),
			})


pure func compiler_typecheck_phase_profile_declaration_preparation_observation(
	fixture: CompilerTypecheckPhaseProfileFixture,
) -> FrontendDeclarationPreparationObservation:
	accepted_typecheck_graph_declaration_preparation_observation(
		profile_fixture_rep(fixture).accepted_graph,
	)


pure func compiler_typecheck_phase_profile_initializer_preparation_observation(
	fixture: CompilerTypecheckPhaseProfileFixture,
) -> FrontendDeclarationPreparationObservation:
	accepted_typecheck_graph_initializer_preparation_observation(
		profile_fixture_rep(fixture).accepted_graph,
	)


pure func compiler_typecheck_phase_profile_ctfe_artifact_preparation_observation(
	fixture: CompilerTypecheckPhaseProfileFixture,
) -> FrontendDeclarationPreparationObservation:
	accepted_typecheck_graph_ctfe_artifact_preparation_observation(
		profile_fixture_rep(fixture).accepted_graph,
	)
