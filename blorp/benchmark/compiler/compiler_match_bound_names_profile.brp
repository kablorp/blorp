-- Isolated profile for raw-match bound-name rewrite scope construction.
--
-- Usage:
--   benchmarks/compiler_match_bound_names_profile plain 20 64 512 16
--   benchmarks/compiler_match_bound_names_profile profile 5 64 512 16
import:
	compiler_match_bound_names_profile_fixture:
		MatchBoundNamesProfileConfig,
		MatchBoundNamesProfileResult,
		match_bound_names_profile_execute,
		match_bound_names_profile_observe,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


func main(args: List[String]) -> Int:
	config: MatchBoundNamesProfileConfig = {
		iterations = positive_argument(args, 1, 20),
		incoming_bound_width = positive_argument(args, 2, 64),
		cases = positive_argument(args, 3, 512),
		pattern_binders = positive_argument(args, 4, 16)
	}

	setup_started: Int = now_microseconds()
	warmup_program = match_bound_names_profile_execute({ config | iterations = 1 })
	warmup: MatchBoundNamesProfileResult = match_bound_names_profile_observe(config, warmup_program)
	setup_microseconds: Int = now_microseconds() - setup_started

	reset_mem_stats()
	begin_function_profile_window()
	started: Int = now_microseconds()
	program = match_bound_names_profile_execute(config)
	elapsed_microseconds: Int = now_microseconds() - started
	end_function_profile_window()
	memory = get_mem_stats()
	result: MatchBoundNamesProfileResult = match_bound_names_profile_observe(config, program)
	workload_valid: Bool = (
		warmup.workload_valid
		and result.workload_valid
		and warmup.semantic_checksum == result.semantic_checksum
	)

	print(
		"MATCH_BOUND_NAMES_PROFILE" + " iterations=" + result.iterations.to_string() + " incoming_bound_width=" + result.incoming_bound_width.to_string() + " cases=" + result.cases.to_string() + " pattern_binders=" + result.pattern_binders.to_string() + " mode_count=" + result.mode_count.to_string() + " raw_match_nodes=" + result.raw_match_nodes.to_string() + " raw_match_cases=" + result.raw_match_cases.to_string() + " global_target_reads=" + result.global_target_reads.to_string() + " local_target_reads=" + result.local_target_reads.to_string() + " distinct_local_target_reads=" + result.distinct_local_target_reads.to_string() + " local_shadowed_reads=" + result.local_shadowed_reads.to_string() + " local_outer_reads=" + result.local_outer_reads.to_string() + " unexpected_global_shadow_reads=" + result.unexpected_global_shadow_reads.to_string() + " pattern_names_visited=" + result.pattern_names_visited.to_string() + " naive_concat_elements=" + result.naive_concat_elements.to_string() + " naive_unique_membership_checks=" + result.naive_unique_membership_checks.to_string() + " optimized_membership_checks=" + result.optimized_membership_checks.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + memory.total_allocations.to_string() + " releases=" + memory.total_releases.to_string() + " retained_objects=" + memory.current_objects.to_string() + " allocator_bytes=" + memory.bytes_allocated.to_string() + " semantic_checksum=" + result.semantic_checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " workload_valid=" + workload_valid.to_string(),
	)

	if workload_valid:
		0
	else:
		1
