-- Direct graph-visibility width workload. Graph construction and identity
-- lookup are setup; the measured loop owns only binding, conflicts, and reads.
import:
	../../src/compiler/stage_04_modules/module_table:
		ModuleId,
		ModuleTable,
		module_id_table_index,
		module_table_canonical_path,
	../../src/compiler/stage_06_typecheck/graph/definition_index:
		DefinitionId,
		DefinitionTable,
		definition_index_find_type_definition_id,
		definition_table_definition_id,
	../../src/compiler/stage_06_typecheck/graph/indexed_graph:
		PreparedModuleScope,
		prepared_module_scope_definition_index,
		prepared_module_scope_id,
		prepared_module_scope_module_table,
	../../src/compiler/stage_06_typecheck/graph/source_name_table:
		graph_module_name_scope,
		graph_source_name_table,
	../../src/compiler/stage_06_typecheck/modules/module_view:
		GraphImportAdmission,
		GraphModuleAliasAdmission(GraphModuleAliasAdded, GraphModuleAliasAlreadyPresent),
		GraphSelectiveAdmission(GraphSelectiveAdded, GraphSelectiveConflictsWithImportedName),
		LocalNameRegistration(LocalNameAdded),
		ModuleAliasRegistration(ModuleAliasAdded, ModuleAliasAlreadyPresent),
		ModuleView,
		SelectiveNameRegistration(SelectiveNameAdded, SelectiveNameConflictsWithImportedName),
		TopLevelNameKind(TopLevelFunction),
		graph_import_admission_begin,
		graph_import_admission_finish,
		graph_import_admission_register_alias,
		graph_import_admission_register_selective_definition,
		module_view_bind_initial_graph_local_names,
		module_view_find_graph_module_alias,
		module_view_find_imported_name,
		module_view_find_local_name,
		module_view_for_graph,
		module_view_graph_bound_name_count,
		module_view_import_binding_count,
		module_view_register_local_name_for_graph,
		module_view_register_module_alias_target,
		module_view_register_selective_name_for_graph,
	../../test/compiler/typecheck_test_support:
		DefinitionBackedTypeFixtureModule,
		definition_backed_type_fixture,
		definition_backed_type_fixture_definition_table,
		module_id_fixture_find,


struct VisibilityWidthConfig {
	iterations: Int,
	module_count: Int,
	alias_count: Int,
	selective_count: Int,
	local_count: Int,
	duplicate_attempts: Int,
	query_count: Int,
	overlap_selectives_with_aliases: Bool,
	batch_initial_locals: Bool,
	batch_graph_imports: Bool
}


private record VisibilityWidthInputRep {
	config: VisibilityWidthConfig,
	module_table: ModuleTable,
	current_module_id: ModuleId,
	module_ids: List[ModuleId],
	module_paths: List[String],
	first_module_id: ModuleId,
	first_module_path: String,
	definition_table: DefinitionTable,
	definition_id_lists: List[List[DefinitionId]],
	first_definition_ids: List[DefinitionId],
	alias_names: List[String],
	first_alias_name: String,
	selective_names: List[String],
	first_selective_name: String,
	local_names: List[String],
	local_candidates: List[(String, TopLevelNameKind)],
	initial_view: ModuleView
}


opaque type VisibilityWidthInput = VisibilityWidthInputRep


record VisibilityWidthResult {
	final_bound_rows: Int,
	final_import_bindings: Int,
	final_duplicate_aliases: Int,
	final_duplicate_selectives: Int,
	final_query_hits: Int,
	total_bound_query_checksum: Int,
	valid: Bool
}


private pure func dependency_path(index: Int) -> String:
	"bench/visibility_dep_" + index.to_string()


private pure func alias_name(index: Int) -> String:
	"VisibilityAlias_" + index.to_string()


private pure func selective_name(index: Int) -> String:
	"VisibilitySelected_" + index.to_string()


private pure func local_name(index: Int) -> String:
	"VisibilityLocal_" + index.to_string()


pure func visibility_width_prepare(config: VisibilityWidthConfig) -> Option[VisibilityWidthInput]:
	if (
		config.iterations <= 0
		or config.module_count <= 0
		or config.alias_count <= 0
		or config.selective_count <= 0
		or config.local_count <= 0
		or config.duplicate_attempts < 0
		or config.query_count < 0
		or config.overlap_selectives_with_aliases and config.selective_count > config.alias_count
	):
		None
	else:
		visibility_width_prepare_valid_config(config)


private pure func visibility_width_prepare_valid_config(
	config: VisibilityWidthConfig,
) -> Option[VisibilityWidthInput]:
	var modules: List[DefinitionBackedTypeFixtureModule] = [
		{
			module_path = "bench/visibility_target",
			type_names = []
		},
	]

	for index in 0..config.module_count:
		modules = modules.append({
			module_path = dependency_path(index),
			type_names = ["Token"],
		})

	scope ?= definition_backed_type_fixture(modules)
	module_table = prepared_module_scope_module_table(scope)
	definition_table = definition_backed_type_fixture_definition_table(scope)
	definition_index = prepared_module_scope_definition_index(scope)
	var module_ids: List[ModuleId] = []
	var definition_ids: List[DefinitionId] = []

	for index in 0..config.module_count:
		match module_id_fixture_find(scope, dependency_path(index)):
			Some(module_id):
				match definition_index_find_type_definition_id(
					definition_index,
					module_table,
					module_id,
					"Token",
				):
					Some(raw_id):
						match definition_table_definition_id(definition_table, raw_id):
							Some(definition_id):
								module_ids = module_ids.append(module_id)
								definition_ids = definition_ids.append(definition_id)
							None:
								void
					None:
						void
			None:
				void

	if module_ids.length() != config.module_count:
		None
	else:
		visibility_width_finish_prepare(config, scope, module_ids, definition_ids)


private pure func visibility_width_finish_prepare(
	config: VisibilityWidthConfig,
	scope: PreparedModuleScope,
	module_ids: List[ModuleId],
	definition_ids: List[DefinitionId],
) -> Option[VisibilityWidthInput]:
	first_module_id ?= module_ids.get(0)
	module_table = prepared_module_scope_module_table(scope)
	definition_table = definition_backed_type_fixture_definition_table(scope)
	var definition_id_lists: List[List[DefinitionId]] = []

	for definition_id in definition_ids:
		definition_id_lists = definition_id_lists.append([definition_id])

	first_definition_ids ?= definition_id_lists.get(0)
	var module_paths: List[String] = []

	for index in 0..config.module_count:
		module_paths = module_paths.append(dependency_path(index))

	first_module_path ?= module_paths.get(0)

	-- The low-level fixture mints its graph catalog directly, so include the
	-- imported declaration spelling as well as every source-visible local name.
	var candidates: List[String] = ["Token"]
	var alias_names: List[String] = []

	for index in 0..config.alias_count:
		name = alias_name(index)
		alias_names = alias_names.append(name)
		candidates = candidates.append(name)

	var selective_names: List[String] = []

	for index in 0..config.selective_count:
		name = if config.overlap_selectives_with_aliases:
			alias_names.get_or(index, selective_name(index))
		else:
			selective_name(index)

		selective_names = selective_names.append(name)
		candidates = candidates.append(name)

	var local_names: List[String] = []
	var local_candidates: List[(String, TopLevelNameKind)] = []

	for index in 0..config.local_count:
		name = local_name(index)
		local_names = local_names.append(name)
		local_candidates = local_candidates.append((name, TopLevelFunction))
		candidates = candidates.append(name)

	first_alias_name ?= alias_names.get(0)
	first_selective_name ?= selective_names.get(0)

	initial_view = module_view_for_graph(
		graph_module_name_scope(
			graph_source_name_table(module_table, candidates),
			prepared_module_scope_id(scope),
		),
	)
	Some(into_opaque VisibilityWidthInput({
				config = config,
				module_table = module_table,
				current_module_id = prepared_module_scope_id(scope),
				module_ids = module_ids,
				module_paths = module_paths,
				first_module_id = first_module_id,
				first_module_path = first_module_path,
				definition_table = definition_table,
				definition_id_lists = definition_id_lists,
				first_definition_ids = first_definition_ids,
				alias_names = alias_names,
				first_alias_name = first_alias_name,
				selective_names = selective_names,
				first_selective_name = first_selective_name,
				local_names = local_names,
				local_candidates = local_candidates,
				initial_view = initial_view
			}))


private pure func register_alias(
	input: VisibilityWidthInputRep,
	view: ModuleView,
	index: Int,
) -> Option[ModuleView]:
	target_index = index % input.config.module_count
	module_id ?= input.module_ids.get(target_index)
	module_path ?= input.module_paths.get(target_index)
	name ?= input.alias_names.get(index)

	match module_view_register_module_alias_target(
		view,
		input.module_table,
		input.current_module_id,
		name,
		module_path,
		input.module_table,
		module_id,
	):
		ModuleAliasAdded(next):
			Some(next)
		_:
			None


private pure func register_selective(
	input: VisibilityWidthInputRep,
	view: ModuleView,
	index: Int,
) -> Option[ModuleView]:
	target_index = index % input.config.module_count
	module_id ?= input.module_ids.get(target_index)
	module_path ?= input.module_paths.get(target_index)
	definition_ids = input.definition_id_lists.get_or(target_index, [])
	name ?= input.selective_names.get(index)

	match module_view_register_selective_name_for_graph(
		view,
		input.current_module_id,
		input.definition_table,
		input.definition_table,
		name,
		module_path,
		"Token",
		module_id,
		definition_ids,
	):
		SelectiveNameAdded(next):
			Some(next)
		_:
			None


private pure func register_alias_in_admission(
	input: VisibilityWidthInputRep,
	admission: GraphImportAdmission,
	index: Int,
) -> Option[GraphImportAdmission]:
	target_index = index % input.config.module_count
	module_id ?= input.module_ids.get(target_index)
	module_path ?= input.module_paths.get(target_index)
	name ?= input.alias_names.get(index)

	match graph_import_admission_register_alias(
		admission,
		input.module_table,
		input.current_module_id,
		name,
		module_path,
		input.module_table,
		module_id,
	):
		GraphModuleAliasAdded(next):
			Some(next)
		_:
			None


private pure func register_selective_in_admission(
	input: VisibilityWidthInputRep,
	admission: GraphImportAdmission,
	index: Int,
) -> Option[GraphImportAdmission]:
	target_index = index % input.config.module_count
	module_id ?= input.module_ids.get(target_index)
	module_path ?= input.module_paths.get(target_index)
	definition_ids = input.definition_id_lists.get_or(target_index, [])
	name ?= input.selective_names.get(index)

	match graph_import_admission_register_selective_definition(
		admission,
		input.current_module_id,
		input.definition_table,
		input.definition_table,
		name,
		module_path,
		"Token",
		module_id,
		definition_ids,
	):
		GraphSelectiveAdded(next):
			Some(next)
		_:
			None


private pure func register_local(
	input: VisibilityWidthInputRep,
	view: ModuleView,
	index: Int,
) -> Option[ModuleView]:
	name ?= input.local_names.get(index)

	match module_view_register_local_name_for_graph(
		view,
		input.module_table,
		input.current_module_id,
		name,
		TopLevelFunction,
	):
		LocalNameAdded(next):
			Some(next)
		_:
			None


private pure func query_identity_value(
	input: VisibilityWidthInputRep,
	view: ModuleView,
	index: Int,
) -> Option[Int]:
	match index % 3:
		0:
			alias_index = index % input.config.alias_count
			name ?= input.alias_names.get(alias_index)
			expected = input.module_ids.get(alias_index % input.config.module_count)

			match module_view_find_graph_module_alias(view, name):
				Some(found):
					if Some(found) == expected:
						Some(module_id_table_index(found) + 1)
					else:
						None
				None:
					None
		1:
			selective_index = index % input.config.selective_count
			target_index = selective_index % input.config.module_count
			module_id ?= input.module_ids.get(target_index)
			module_path ?= input.module_paths.get(target_index)
			name ?= input.selective_names.get(selective_index)

			match module_view_find_imported_name(view, name):
				Some(binding):
					if binding.module_path == module_path:
						Some(module_id_table_index(module_id) + 1)
					else:
						None
				None:
					None
		_:
			local_index = index % input.config.local_count
			name ?= input.local_names.get(local_index)

			if module_view_find_local_name(view, name) == Some(TopLevelFunction):
				Some(1)
			else:
				None


private pure func register_initial_locals(input: VisibilityWidthInputRep) -> Option[ModuleView]:
	if input.config.batch_initial_locals:
		module_view_bind_initial_graph_local_names(
			input.initial_view,
			input.module_table,
			input.current_module_id,
			input.local_candidates,
		)
	else:
		var view = input.initial_view
		var valid = True

		for index in 0..input.config.local_count:
			match register_local(input, view, index):
				Some(next):
					view = next
				None:
					valid = False
					break

		if valid:
			Some(view)
		else:
			None


private pure func register_batched_imports(
	input: VisibilityWidthInputRep,
	view: ModuleView,
) -> Option[ModuleView]:
	initial_admission ?= graph_import_admission_begin(
		view,
		input.module_table,
		input.current_module_id,
	)
	var admission = initial_admission
	var valid = True

	for index in 0..input.config.alias_count:
		match register_alias_in_admission(input, admission, index):
			Some(next):
				admission = next
			None:
				valid = False
				break

	if valid:
		for index in 0..input.config.selective_count:
			match register_selective_in_admission(input, admission, index):
				Some(next):
					admission = next
				None:
					valid = False
					break

	if valid:
		for index in 0..input.config.duplicate_attempts:
			if index % 2 == 0:
				match graph_import_admission_register_alias(
					admission,
					input.module_table,
					input.current_module_id,
					input.first_alias_name,
					input.first_module_path,
					input.module_table,
					input.first_module_id,
				):
					GraphModuleAliasAlreadyPresent(next):
						admission = next
					_:
						valid = False
						break
			else:
				match graph_import_admission_register_selective_definition(
					admission,
					input.current_module_id,
					input.definition_table,
					input.definition_table,
					input.first_selective_name,
					input.first_module_path,
					"Token",
					input.first_module_id,
					input.first_definition_ids,
				):
					GraphSelectiveConflictsWithImportedName(next, _):
						admission = next
					_:
						valid = False
						break

	if valid:
		Some(graph_import_admission_finish(admission))
	else:
		None


private pure func register_sequential_imports(
	input: VisibilityWidthInputRep,
	initial_view: ModuleView,
) -> Option[ModuleView]:
	var view = initial_view
	var valid = True

	for index in 0..input.config.alias_count:
		match register_alias(input, view, index):
			Some(next):
				view = next
			None:
				valid = False
				break

	if valid:
		for index in 0..input.config.selective_count:
			match register_selective(input, view, index):
				Some(next):
					view = next
				None:
					valid = False
					break

	if valid:
		for index in 0..input.config.duplicate_attempts:
			if index % 2 == 0:
				match module_view_register_module_alias_target(
					view,
					input.module_table,
					input.current_module_id,
					input.first_alias_name,
					input.first_module_path,
					input.module_table,
					input.first_module_id,
				):
					ModuleAliasAlreadyPresent:
						void
					_:
						valid = False
						break
			else:
				match module_view_register_selective_name_for_graph(
					view,
					input.current_module_id,
					input.definition_table,
					input.definition_table,
					input.first_selective_name,
					input.first_module_path,
					"Token",
					input.first_module_id,
					input.first_definition_ids,
				):
					SelectiveNameConflictsWithImportedName(_):
						void
					_:
						valid = False
						break

	if valid:
		Some(view)
	else:
		None


private pure func register_imports(
	input: VisibilityWidthInputRep,
	view: ModuleView,
) -> Option[ModuleView]:
	if input.config.batch_graph_imports:
		register_batched_imports(input, view)
	else:
		register_sequential_imports(input, view)


private pure func query_bound_names(
	input: VisibilityWidthInputRep,
	view: ModuleView,
) -> Option[Int]:
	var checksum: Int = 0
	var valid = True

	for index in 0..input.config.query_count:
		match query_identity_value(input, view, index):
			Some(identity_value):
				checksum += identity_value
			None:
				valid = False
				break

	if valid:
		Some(checksum)
	else:
		None


private pure func visibility_width_execute_iteration(
	input: VisibilityWidthInputRep,
	prior_query_checksum: Int,
) -> Option[VisibilityWidthResult]:
	view ?= register_initial_locals(input)
	imported_view ?= register_imports(input, view)
	query_checksum ?= query_bound_names(input, imported_view)
	bound_rows = module_view_graph_bound_name_count(imported_view)
	import_bindings = module_view_import_binding_count(imported_view)
	-- Duplicate attempts alternate alias/selective, beginning with alias.
	-- Every observed variant was checked in register_imports, so these counts
	-- follow from the configured number of attempts without per-attempt writes.
	duplicate_aliases = (input.config.duplicate_attempts + 1) / 2
	duplicate_selectives = input.config.duplicate_attempts / 2

	expected_rows = if input.config.overlap_selectives_with_aliases:
		input.config.alias_count + input.config.local_count
	else:
		input.config.alias_count + input.config.selective_count + input.config.local_count

	Some({
		final_bound_rows = bound_rows,
		final_import_bindings = import_bindings,
		final_duplicate_aliases = duplicate_aliases,
		final_duplicate_selectives = duplicate_selectives,
		final_query_hits = input.config.query_count,
		total_bound_query_checksum = prior_query_checksum + query_checksum,
		valid = (
			bound_rows == expected_rows
			and import_bindings == input.config.alias_count + input.config.selective_count
		),
	})


pure func visibility_width_execute(input: VisibilityWidthInput) -> Option[VisibilityWidthResult]:
	representation: VisibilityWidthInputRep = from_opaque VisibilityWidthInput(input)
	var result: VisibilityWidthResult = {
		final_bound_rows = 0,
		final_import_bindings = 0,
		final_duplicate_aliases = 0,
		final_duplicate_selectives = 0,
		final_query_hits = 0,
		total_bound_query_checksum = 0,
		valid = True
	}
	var completed = True

	for _ in 0..representation.config.iterations:
		match visibility_width_execute_iteration(representation, result.total_bound_query_checksum):
			None:
				completed = False
				break
			Some(iteration):
				result = iteration

				if not iteration.valid:
					break

	if completed:
		Some(result)
	else:
		None


pure func visibility_width_run(config: VisibilityWidthConfig) -> Option[VisibilityWidthResult]:
	input ?= visibility_width_prepare(config)
	visibility_width_execute(input)


-- Exercise the first unexpected registration failure without admitting later
-- rows into a partial benchmark view. Only the benchmark test uses this hook.
pure func visibility_width_run_with_foreign_current_module_for_test(
	config: VisibilityWidthConfig,
) -> Option[VisibilityWidthResult]:
	input ?= visibility_width_prepare(config)
	representation: VisibilityWidthInputRep = from_opaque VisibilityWidthInput(input)
	foreign_input = into_opaque VisibilityWidthInput(
		{ representation | current_module_id = representation.first_module_id }
	)
	visibility_width_execute(foreign_input)
