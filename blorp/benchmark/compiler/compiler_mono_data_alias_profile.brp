-- Isolated profile for Core generic-data transparent alias lookup.
--
-- Usage:
--   bin/blorp run blorp/benchmark/compiler/compiler_mono_data_alias_profile.brp -- 128 0 100 0
--   bin/blorp run blorp/benchmark/compiler/compiler_mono_data_alias_profile.brp -- 512 2048 20 1
import:
	compiler_mono_data_alias_profile_fixture:
		CompilerMonoDataAliasProfileConfig,
		CompilerMonoDataAliasProfileResult,
		compiler_mono_data_alias_profile_execute,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: MemStats, get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private DEFAULT_ALIAS_COUNT: Int = 128

private DEFAULT_ALIAS_USE_COUNT: Int = 0

private DEFAULT_ITERATIONS: Int = 100

private DEFAULT_ALIAS_TARGET_MODE: Int = 0


private pure func integer_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					value
				None:
					default
		None:
			default


private pure func memory_summary(prefix: String, stats: MemStats) -> String:
	" " + prefix + "_total_allocations=" + stats.total_allocations.to_string() + " " + prefix + "_total_releases=" + stats.total_releases.to_string() + " " + prefix + "_retained_objects=" + stats.current_objects.to_string() + " " + prefix + "_allocated_bytes=" + stats.bytes_allocated.to_string()


func main(args: List[String]) -> Int:
	config: CompilerMonoDataAliasProfileConfig = {
		alias_count = integer_argument(args, 1, DEFAULT_ALIAS_COUNT),
		alias_use_count = integer_argument(args, 2, DEFAULT_ALIAS_USE_COUNT),
		iterations = integer_argument(args, 3, DEFAULT_ITERATIONS),
		alias_target_mode = integer_argument(args, 4, DEFAULT_ALIAS_TARGET_MODE)
	}

	warmup: CompilerMonoDataAliasProfileResult = compiler_mono_data_alias_profile_execute(config)

	reset_mem_stats()
	begin_function_profile_window()
	started: Int = now_microseconds()
	result: CompilerMonoDataAliasProfileResult = compiler_mono_data_alias_profile_execute(config)
	elapsed_microseconds: Int = now_microseconds() - started
	end_function_profile_window()
	stats: MemStats = get_mem_stats()
	workload_valid: Bool = (
		warmup.workload_valid
		and result.workload_valid
		and warmup.output_declarations == result.output_declarations
		and warmup.output_checksum == result.output_checksum
	)

	print(
		"MONO_DATA_ALIAS_PROFILE" + " alias_count=" + result.alias_count.to_string() + " alias_use_count=" + result.alias_use_count.to_string() + " iterations=" + result.iterations.to_string() + " alias_target_mode=" + result.alias_target_mode.to_string() + " input_declarations=" + result.input_declarations.to_string() + " output_declarations=" + result.output_declarations.to_string() + " output_checksum=" + result.output_checksum.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + memory_summary(
			"measure",
			stats,
		) + " workload_valid=" + workload_valid.to_string(),
	)

	if workload_valid:
		0
	else:
		1
