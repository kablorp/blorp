-- Slice 0 measurement harness for accepted-module declaration preparation.
--
-- The fixture reuses the production typecheck phase fixture. The measured
-- operation observes accepted graph module preparation, which calls the same
-- accepted body-module preparation path used by graph-backed typechecking.
import:
	../../src/compiler/stage_06_typecheck/decl: FrontendDeclarationPreparationObservation
	compiler_type_header_mixed_profile_fixture:
		CompilerMixedTypeHeaderBenchmarkConfig,
		compiler_mixed_type_header_phase_profile_fixture,
	compiler_typecheck_phase_profile_fixture:
		CompilerTypecheckPhaseProfileFixture,
		compiler_typecheck_phase_profile_ctfe_artifact_preparation_observation,
		compiler_typecheck_phase_profile_declaration_preparation_observation,
		compiler_typecheck_phase_profile_initializer_preparation_observation,


enum FrontendDeclarationCatalogGraphShape:
	FrontendCatalogChainGraph
	FrontendCatalogStarGraph
	FrontendCatalogLayeredGraph
	FrontendCatalogDenseGraph


struct CompilerFrontendDeclarationCatalogProfileConfig {
	iterations: Int,
	module_count: Int,
	declarations_per_module: Int,
	import_fanout: Int,
	graph_shape: FrontendDeclarationCatalogGraphShape,
	body_count_per_module: Int,
	ctfe_body_selection: Bool
}


record CompilerFrontendDeclarationCatalogProfileResult {
	config: CompilerFrontendDeclarationCatalogProfileConfig,
	canonical_observation: FrontendDeclarationPreparationObservation,
	initializer_observation: FrontendDeclarationPreparationObservation,
	ctfe_artifact_observation: FrontendDeclarationPreparationObservation,
	setup_error_count: Int,
	workload_valid: Bool
}


private pure func positive(value: Int, fallback: Int) -> Int:
	if value > 0:
		value
	else:
		fallback


private pure func nonnegative(value: Int) -> Int:
	if value > 0:
		value
	else:
		0


private pure func shape_import_fanout(
	shape: FrontendDeclarationCatalogGraphShape,
	module_count: Int,
	import_fanout: Int,
) -> Int:
	match shape:
		FrontendCatalogChainGraph:
			1
		FrontendCatalogStarGraph:
			0
		FrontendCatalogLayeredGraph:
			positive(import_fanout, 1)
		FrontendCatalogDenseGraph:
			positive(module_count, 1)


private pure func shape_name(shape: FrontendDeclarationCatalogGraphShape) -> String:
	match shape:
		FrontendCatalogChainGraph:
			"chain"
		FrontendCatalogStarGraph:
			"star"
		FrontendCatalogLayeredGraph:
			"layered"
		FrontendCatalogDenseGraph:
			"dense"


pure func frontend_declaration_catalog_graph_shape_name(
	shape: FrontendDeclarationCatalogGraphShape,
) -> String:
	shape_name(shape)


private pure func mixed_shapes_for_declaration_count(declarations_per_module: Int) -> Int:
	-- The mixed fixture emits aliases and records per shape, plus one union,
	-- one opaque alias, one private record, trait/impl/global declarations, and
	-- body probes. This converts the requested declaration axis into the closest
	-- stable mixed-fixture shape pressure without claiming exact source count.
	if declarations_per_module <= 4:
		1
	else:
		declarations_per_module / 4


private pure func mixed_config_from_catalog_config(
	config: CompilerFrontendDeclarationCatalogProfileConfig,
) -> CompilerMixedTypeHeaderBenchmarkConfig:
	{
		iterations = 1,
		module_count = positive(config.module_count, 1),
		shapes_per_module = positive(
			mixed_shapes_for_declaration_count(config.declarations_per_module),
			1,
		),
		probes_per_module = nonnegative(config.body_count_per_module),
		import_fanout = shape_import_fanout(
			config.graph_shape,
			config.module_count,
			config.import_fanout,
		),
		retain_parsed_programs = True
	}


private pure func observation_empty() -> FrontendDeclarationPreparationObservation:
	{
		accepted_modules_prepared = 0,
		unique_graph_declarations = 0,
		unique_type_declarations = 0,
		unique_constructors = 0,
		unique_callables = 0,
		unique_globals = 0,
		unique_traits = 0,
		unique_implementations = 0,
		visible_module_edges = 0,
		direct_module_edges = 0,
		module_view_projection_entries = 0,
		canonical_module_base_builds = 0,
		body_sessions_created = 0,
		body_contexts_created = 0,
		error_count = 0,
		checksum = 0
	}


private pure func checksum_add(seed: Int, value: Int) -> Int:
	seed * 16777619 + value


private pure func checksum_observation(
	observation: FrontendDeclarationPreparationObservation,
) -> Int:
	var checksum: Int = 216613626
	checksum = checksum_add(checksum, observation.accepted_modules_prepared)
	checksum = checksum_add(checksum, observation.unique_graph_declarations)
	checksum = checksum_add(checksum, observation.unique_type_declarations)
	checksum = checksum_add(checksum, observation.unique_constructors)
	checksum = checksum_add(checksum, observation.unique_callables)
	checksum = checksum_add(checksum, observation.unique_globals)
	checksum = checksum_add(checksum, observation.unique_traits)
	checksum = checksum_add(checksum, observation.unique_implementations)
	checksum = checksum_add(checksum, observation.visible_module_edges)
	checksum = checksum_add(checksum, observation.direct_module_edges)
	checksum = checksum_add(checksum, observation.module_view_projection_entries)
	checksum = checksum_add(checksum, observation.canonical_module_base_builds)
	checksum = checksum_add(checksum, observation.body_sessions_created)
	checksum = checksum_add(checksum, observation.body_contexts_created)
	checksum_add(checksum, observation.error_count)


private pure func observation_add(
	left: FrontendDeclarationPreparationObservation,
	right: FrontendDeclarationPreparationObservation,
) -> FrontendDeclarationPreparationObservation:
	unique = if right.unique_graph_declarations > 0:
		right.unique_graph_declarations
	else:
		left.unique_graph_declarations

	unique_types = if right.unique_type_declarations > 0:
		right.unique_type_declarations
	else:
		left.unique_type_declarations

	unique_constructors = if right.unique_constructors > 0:
		right.unique_constructors
	else:
		left.unique_constructors

	unique_callables = if right.unique_callables > 0:
		right.unique_callables
	else:
		left.unique_callables

	unique_globals = if right.unique_globals > 0:
		right.unique_globals
	else:
		left.unique_globals

	unique_traits = if right.unique_traits > 0:
		right.unique_traits
	else:
		left.unique_traits

	unique_implementations = if right.unique_implementations > 0:
		right.unique_implementations
	else:
		left.unique_implementations

	combined: FrontendDeclarationPreparationObservation = {
		accepted_modules_prepared = left.accepted_modules_prepared + right.accepted_modules_prepared,
		unique_graph_declarations = unique,
		unique_type_declarations = unique_types,
		unique_constructors = unique_constructors,
		unique_callables = unique_callables,
		unique_globals = unique_globals,
		unique_traits = unique_traits,
		unique_implementations = unique_implementations,
		visible_module_edges = left.visible_module_edges + right.visible_module_edges,
		direct_module_edges = left.direct_module_edges + right.direct_module_edges,
		module_view_projection_entries = left.module_view_projection_entries + right.module_view_projection_entries,
		canonical_module_base_builds = left.canonical_module_base_builds + right.canonical_module_base_builds,
		body_sessions_created = left.body_sessions_created + right.body_sessions_created,
		body_contexts_created = left.body_contexts_created + right.body_contexts_created,
		error_count = left.error_count + right.error_count,
		checksum = 0
	}
	{ combined | checksum = checksum_observation(combined) }


pure func compiler_frontend_declaration_catalog_profile_fixture(
	config: CompilerFrontendDeclarationCatalogProfileConfig,
) -> Result[CompilerTypecheckPhaseProfileFixture, List[String]]:
	compiler_mixed_type_header_phase_profile_fixture(mixed_config_from_catalog_config(config))


pure func compiler_frontend_declaration_catalog_profile_with_fixture(
	config: CompilerFrontendDeclarationCatalogProfileConfig,
	fixture: CompilerTypecheckPhaseProfileFixture,
) -> CompilerFrontendDeclarationCatalogProfileResult:
	var canonical_observation = observation_empty()
	var initializer_observation = observation_empty()
	var ctfe_artifact_observation = observation_empty()
	var iteration: Int = 0

	while iteration < positive(config.iterations, 1):
		iteration_canonical = compiler_typecheck_phase_profile_declaration_preparation_observation(
			fixture,
		)
		iteration_initializer = compiler_typecheck_phase_profile_initializer_preparation_observation(
			fixture,
		)
		iteration_ctfe = compiler_typecheck_phase_profile_ctfe_artifact_preparation_observation(
			fixture,
		)
		canonical_observation = observation_add(canonical_observation, iteration_canonical)
		initializer_observation = observation_add(initializer_observation, iteration_initializer)
		ctfe_artifact_observation = observation_add(ctfe_artifact_observation, iteration_ctfe)
		iteration += 1

	{
		config = config,
		canonical_observation = canonical_observation,
		initializer_observation = initializer_observation,
		ctfe_artifact_observation = ctfe_artifact_observation,
		setup_error_count = 0,
		workload_valid = (
			canonical_observation.accepted_modules_prepared > 0
			and canonical_observation.error_count == 0
			and initializer_observation.accepted_modules_prepared > 0
			and initializer_observation.error_count == 0
			and ctfe_artifact_observation.accepted_modules_prepared > 0
			and ctfe_artifact_observation.error_count == 0
			and canonical_observation.unique_graph_declarations > 0
			and canonical_observation.checksum != 0
			and initializer_observation.checksum != 0
			and ctfe_artifact_observation.checksum != 0
		)
	}


pure func compiler_frontend_declaration_catalog_profile(
	config: CompilerFrontendDeclarationCatalogProfileConfig,
) -> CompilerFrontendDeclarationCatalogProfileResult:
	match compiler_frontend_declaration_catalog_profile_fixture(config):
		Err(errors):
			{
				config = config,
				canonical_observation = observation_empty(),
				initializer_observation = observation_empty(),
				ctfe_artifact_observation = observation_empty(),
				setup_error_count = errors.length(),
				workload_valid = False
			}
		Ok(fixture):
			compiler_frontend_declaration_catalog_profile_with_fixture(config, fixture)
