-- Isolate repeated binding validation through an already-issued acyclic chain.
-- Issuance and chain construction are outside the measured loop.
import:
	../../src/compiler/stage_06_typecheck/type_system/context: CONTEXT_EMPTY, bind_meta, fresh_meta
	../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticType(SemanticMetaType),
		TYPE_INT,
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


func main(args: List[String]) -> Int:
	width = positive_argument(args, 1, 128)
	iterations = positive_argument(args, 2, 4096)
	var context = CONTEXT_EMPTY

	for _ in 0..width:
		context = fresh_meta(context).context

	var setup_valid: Bool = True

	for index in 1..width:
		binding = if index + 1 < width:
			SemanticMetaType(index + 1)
		else:
			TYPE_INT

		match bind_meta(context, index, binding):
			Some(bound):
				context = bound
			None:
				setup_valid = False

	reset_mem_stats()
	started = now_microseconds()
	var accepted: Int = 0

	for _ in 0..iterations:
		match bind_meta(context, 0, SemanticMetaType(1)):
			Some(_):
				accepted += 1
			None:
				void

	elapsed = now_microseconds() - started
	memory = get_mem_stats()
	print(
		"META_BINDING_CHAIN width=${width.to_string()} iterations=${iterations.to_string()} setup_valid=${setup_valid.to_string()} accepted=${accepted.to_string()} elapsed_microseconds=${elapsed.to_string()} allocations=${memory.total_allocations.to_string()} releases=${memory.total_releases.to_string()} retained_objects=${memory.current_objects.to_string()} retained_bytes=${memory.bytes_allocated.to_string()}",
	)

	if (
		setup_valid
		and width >= 2
		and accepted == iterations
	):
		0
	else:
		1
