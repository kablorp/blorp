-- Isolated profile for Core type-parameter membership queries.
--
-- Usage:
--   bin/blorp run blorp/benchmark/compiler/compiler_mono_parameter_profile.brp -- 32 128 8 -1
--   bin/blorp run --profile-mode calls --profile-function blorp/benchmark/compiler/compiler_mono_parameter_profile_fixture::compiler_mono_parameter_profile_execute blorp/benchmark/compiler/compiler_mono_parameter_profile.brp -- 64 64 12 63
import:
	compiler_mono_parameter_profile_fixture:
		CompilerMonoParameterProfileConfig,
		CompilerMonoParameterProfileResult,
		compiler_mono_parameter_profile_execute,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: MemStats, get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private DEFAULT_PARAMETER_COUNT: Int = 32

private DEFAULT_QUERIES_PER_SHAPE: Int = 128

private DEFAULT_NESTING_DEPTH: Int = 8

private DEFAULT_HIT_POSITION: Int = -1


private pure func integer_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					value
				None:
					default
		None:
			default


private pure func memory_summary(prefix: String, stats: MemStats) -> String:
	" " + prefix + "_total_allocations=" + stats.total_allocations.to_string() + " " + prefix + "_total_releases=" + stats.total_releases.to_string() + " " + prefix + "_retained_objects=" + stats.current_objects.to_string() + " " + prefix + "_allocated_bytes=" + stats.bytes_allocated.to_string()


func main(args: List[String]) -> Int:
	config: CompilerMonoParameterProfileConfig = {
		parameter_count = integer_argument(args, 1, DEFAULT_PARAMETER_COUNT),
		queries_per_shape = integer_argument(args, 2, DEFAULT_QUERIES_PER_SHAPE),
		nesting_depth = integer_argument(args, 3, DEFAULT_NESTING_DEPTH),
		hit_position = integer_argument(args, 4, DEFAULT_HIT_POSITION)
	}

	warmup: CompilerMonoParameterProfileResult = compiler_mono_parameter_profile_execute(config)

	reset_mem_stats()
	begin_function_profile_window()
	started: Int = now_microseconds()
	result: CompilerMonoParameterProfileResult = compiler_mono_parameter_profile_execute(config)
	elapsed_microseconds: Int = now_microseconds() - started
	end_function_profile_window()
	stats: MemStats = get_mem_stats()
	workload_valid: Bool = (
		warmup.workload_valid
		and result.workload_valid
		and warmup.legacy_checksum == result.legacy_checksum
		and warmup.production_checksum == result.production_checksum
	)

	print(
		"MONO_PARAMETER_PROFILE" + " parameter_count=" + result.parameter_count.to_string() + " queries_per_shape=" + result.queries_per_shape.to_string() + " nesting_depth=" + result.nesting_depth.to_string() + " hit_position=" + result.hit_position.to_string() + " query_type_count=" + result.query_type_count.to_string() + " top_level_queries=" + result.top_level_queries.to_string() + " legacy_true_count=" + result.legacy_true_count.to_string() + " indexed_true_count=" + result.indexed_true_count.to_string() + " production_true_count=" + result.production_true_count.to_string() + " legacy_checksum=" + result.legacy_checksum.to_string() + " indexed_checksum=" + result.indexed_checksum.to_string() + " production_checksum=" + result.production_checksum.to_string() + " legacy_type_nodes=" + result.legacy_type_nodes.to_string() + " legacy_parameter_leaves=" + result.legacy_parameter_leaves.to_string() + " legacy_names_compared=" + result.legacy_names_compared.to_string() + " indexed_type_nodes=" + result.indexed_type_nodes.to_string() + " indexed_parameter_leaves=" + result.indexed_parameter_leaves.to_string() + " indexed_membership_queries=" + result.indexed_membership_queries.to_string() + " index_build_work=" + result.index_build_work.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + memory_summary(
			"measure",
			stats,
		) + " workload_valid=" + workload_valid.to_string(),
	)

	if workload_valid:
		0
	else:
		1
