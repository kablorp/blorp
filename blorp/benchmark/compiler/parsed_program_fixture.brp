-- Benchmark-owned construction of finalized parser output.
import:
	../../src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../src/compiler/stage_03_parse/source_ast_finalize:
		FinalizedTypecheckProgram,
		finalized_typecheck_program,
	../../src/lib/source: source_file


pure func finalized_typecheck_program_fixture(
	path: String,
	module_name: String,
	text: String,
) -> FinalizedTypecheckProgram:
	finalized_typecheck_program(parse_compiler_source(source_file(path, module_name, text)))
