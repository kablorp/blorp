-- Direct profile of implementation-method skeleton scanning/bucketing.
import:
	compiler_implementation_method_skeleton_bucket_profile_fixture:
		CompilerImplementationMethodSkeletonBucketProfileConfig,
		compiler_implementation_method_skeleton_bucket_profile_execute,
		compiler_implementation_method_skeleton_bucket_profile_fixture,
		compiler_implementation_method_skeleton_bucket_profile_observe,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func integer_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			parse_int(text).get_or(default)
		None:
			default


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	value = integer_argument(args, index, default)

	if value > 0:
		value
	else:
		default


func main(args: List[String]) -> Int:
	iterations = positive_argument(args, 1, 20)
	config: CompilerImplementationMethodSkeletonBucketProfileConfig = {
		implementation_count = positive_argument(args, 2, 64),
		methods_per_implementation = integer_argument(args, 3, 4),
		default_methods_per_implementation = integer_argument(args, 4, 1),
		unrelated_callable_count = integer_argument(args, 5, 256)
	}

	match compiler_implementation_method_skeleton_bucket_profile_fixture(config):
		None:
			print("implementation method skeleton bucket profile fixture construction failed")
			1
		Some(fixture):
			setup_started = now_microseconds()
			warmup = compiler_implementation_method_skeleton_bucket_profile_execute(fixture, 1)
			warmup_observation = compiler_implementation_method_skeleton_bucket_profile_observe(
				fixture,
				warmup,
			)
			setup_microseconds = now_microseconds() - setup_started

			reset_mem_stats()
			begin_function_profile_window()
			started = now_microseconds()
			result = compiler_implementation_method_skeleton_bucket_profile_execute(fixture, iterations)
			elapsed_microseconds = now_microseconds() - started
			end_function_profile_window()
			memory = get_mem_stats()
			observation = compiler_implementation_method_skeleton_bucket_profile_observe(fixture, result)

			print(
				"IMPLEMENTATION_METHOD_SKELETON_BUCKET_PROFILE" + " iterations=" + iterations.to_string() + " implementations=" + fixture.implementation_count.to_string() + " methods_per_implementation=" + fixture.methods_per_implementation.to_string() + " default_methods_per_implementation=" + fixture.default_methods_per_implementation.to_string() + " unrelated_callables=" + fixture.unrelated_callable_count.to_string() + " headers=" + observation.header_count.to_string() + " methods=" + observation.method_count.to_string() + " explicit_methods=" + observation.explicit_method_count.to_string() + " default_methods=" + observation.default_method_count.to_string() + " ordered_header_checksum=" + observation.ordered_header_checksum.to_string() + " graph_ready=" + observation.graph_ready.to_string() + " workload_valid=" + observation.workload_valid.to_string() + " warmup_checksum=" + warmup_observation.ordered_header_checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " allocations=" + memory.total_allocations.to_string() + " releases=" + memory.total_releases.to_string() + " retained_objects=" + memory.current_objects.to_string() + " allocator_bytes=" + memory.bytes_allocated.to_string(),
			)

			if observation.workload_valid and warmup_observation.workload_valid:
				0
			else:
				2
