-- Deterministic workload for measuring closure function-index construction.
--
-- The benchmark observes a compact diagnostic snapshot produced by the exact
-- production index builder so measurements validate index contents without
-- exporting the internal maps.
import:
	../../src/compiler/stage_09_core/closure:
		ClosureFunctionIndexDiagnosticSnapshot,
		closure_function_index_diagnostic_snapshot,
	../../src/compiler/stage_09_core/ir:
		CoreClosureAbi,
		CoreDecl(FunctionDecl, ImplDecl),
		CoreFunction,
		CoreFunctionKind(ClosureBodyFunction, UserFunction),
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType),


private FUNCTION_DEF_ID_BASE: Int = 1000

private CHECKSUM_MULTIPLIER: Int = 131

private GENERATED_FUNCTION_INTERVAL: Int = 17


struct CompilerClosureFunctionIndexProfileConfig {
	iterations: Int,
	top_level_functions: Int,
	impl_blocks: Int,
	methods_per_impl: Int,
	duplicate_name_interval: Int,
	duplicate_id_interval: Int
}


record CompilerClosureFunctionIndexProfileFixture {
	config: CompilerClosureFunctionIndexProfileConfig,
	program: CoreProgram,
	functions: List[CoreFunction],
	query_names: List[String],
	query_def_ids: List[Int],
	expected_by_id_count: Int,
	expected_by_name_count: Int,
	expected_collision_id_count: Int,
	expected_total_collision_entries: Int
}


struct CompilerClosureFunctionIndexProfileResult {
	function_count: Int,
	by_id_count: Int,
	by_name_count: Int,
	collision_id_count: Int,
	total_collision_entries: Int,
	checksum: Int,
	workload_valid: Bool
}


private pure func positive_value(value: Int) -> Int:
	if value > 0:
		value
	else:
		0


private pure func normalized_config(
	config: CompilerClosureFunctionIndexProfileConfig,
) -> CompilerClosureFunctionIndexProfileConfig:
	{
		iterations = positive_value(config.iterations),
		top_level_functions = positive_value(config.top_level_functions),
		impl_blocks = positive_value(config.impl_blocks),
		methods_per_impl = positive_value(config.methods_per_impl),
		duplicate_name_interval = positive_value(config.duplicate_name_interval),
		duplicate_id_interval = positive_value(config.duplicate_id_interval)
	}


private pure func total_function_count(config: CompilerClosureFunctionIndexProfileConfig) -> Int:
	config.top_level_functions + config.impl_blocks * config.methods_per_impl


private pure func unique_function_name(index: Int) -> String:
	"closure_index_function_${index}"


private pure func function_name_for_index(
	config: CompilerClosureFunctionIndexProfileConfig,
	index: Int,
) -> String:
	if (
		config.duplicate_name_interval > 0
		and index > 0
		and index % config.duplicate_name_interval == 0
	):
		unique_function_name(index - 1)
	else:
		unique_function_name(index)


private pure func function_def_id_for_index(
	config: CompilerClosureFunctionIndexProfileConfig,
	index: Int,
) -> Int:
	if (
		config.duplicate_id_interval > 0
		and index > 0
		and index % config.duplicate_id_interval == 0
	):
		FUNCTION_DEF_ID_BASE + index - 1
	else:
		FUNCTION_DEF_ID_BASE + index


private pure func int_type() -> CoreType:
	NamedType("Int", [])


private pure func closure_abi(name: String) -> CoreClosureAbi:
	{
		c_name = name + "_c",
		params = [],
		captures = [],
		moved_captures = [],
		task_abi = False
	}


private pure func benchmark_function(
	config: CompilerClosureFunctionIndexProfileConfig,
	index: Int,
) -> CoreFunction:
	name: String = function_name_for_index(config, index)

	function_kind: CoreFunctionKind = if (
		GENERATED_FUNCTION_INTERVAL > 0
		and index > 0
		and index % GENERATED_FUNCTION_INTERVAL == 0
	):
		ClosureBodyFunction(closure_abi(name))
	else:
		UserFunction

	{
		name = name,
		source_module = Some("bench/closure_function_index"),
		type_params = [],
		params = [],
		return_type = int_type(),
		body = None,
		is_pure = True,
		function_kind = function_kind,
		def_id = function_def_id_for_index(config, index),
		loc = SyntheticSourceLoc
	}


private pure func benchmark_impl_decl(impl_index: Int, methods: List[CoreFunction]) -> CoreDecl:
	ImplDecl({
		trait_name = "ClosureIndexTrait${impl_index}",
		for_type = int_type(),
		type_params = [],
		methods = methods,
		loc = SyntheticSourceLoc,
	})


private pure func expected_counts(functions: List[CoreFunction]) -> (Int, Int, Int, Int):
	var ids: Dict[Int, Bool] = {}
	var names: Dict[String, Bool] = {}
	var collision_lengths: Dict[Int, Int] = {}
	var by_id_count: Int = 0
	var by_name_count: Int = 0
	var collision_id_count: Int = 0
	var total_collision_entries: Int = 0

	for func_info in functions:
		match ids.get(func_info.def_id):
			Some(_):
				next_length: Int = collision_lengths
					.get(func_info.def_id)
					.get_or(1) + 1

				if next_length == 2:
					collision_id_count += 1
					total_collision_entries += 2
				else:
					total_collision_entries += 1

				collision_lengths = collision_lengths.set(func_info.def_id, next_length)
			None:
				ids = ids.set(func_info.def_id, True)
				by_id_count += 1

		match names.get(func_info.name):
			Some(_):
				void
			None:
				names = names.set(func_info.name, True)
				by_name_count += 1

	(by_id_count, by_name_count, collision_id_count, total_collision_entries)


pure func compiler_closure_function_index_profile_fixture(
	config: CompilerClosureFunctionIndexProfileConfig,
) -> CompilerClosureFunctionIndexProfileFixture:
	normalized: CompilerClosureFunctionIndexProfileConfig = normalized_config(config)
	var decls: List[CoreDecl] = []
	var functions: List[CoreFunction] = []
	var sequence_index: Int = 0

	for _ in 0..normalized.top_level_functions:
		func_info: CoreFunction = benchmark_function(normalized, sequence_index)
		functions = functions.append(func_info)
		decls = decls.append(FunctionDecl(func_info))
		sequence_index += 1

	for impl_index in 0..normalized.impl_blocks:
		var methods: List[CoreFunction] = []

		for _ in 0..normalized.methods_per_impl:
			method: CoreFunction = benchmark_function(normalized, sequence_index)
			functions = functions.append(method)
			methods = methods.append(method)
			sequence_index += 1

		decls = decls.append(benchmark_impl_decl(impl_index, methods))

	(expected_by_id_count, expected_by_name_count, expected_collision_id_count, expected_total_collision_entries) = expected_counts(
		functions,
	)

	{
		config = normalized,
		program = {
			decls = decls,
			foreign_includes = []
		},
		functions = functions,
		query_names = function_query_names(functions),
		query_def_ids = function_query_def_ids(functions),
		expected_by_id_count = expected_by_id_count,
		expected_by_name_count = expected_by_name_count,
		expected_collision_id_count = expected_collision_id_count,
		expected_total_collision_entries = expected_total_collision_entries
	}


private pure func function_query_names(functions: List[CoreFunction]) -> List[String]:
	var names: List[String] = []

	for func_info in functions:
		names = names.append(func_info.name)

	names


private pure func function_query_def_ids(functions: List[CoreFunction]) -> List[Int]:
	var def_ids: List[Int] = []

	for func_info in functions:
		def_ids = def_ids.append(func_info.def_id)

	def_ids


private pure func checksum_text(seed: Int, text: String) -> Int:
	var checksum: Int = seed

	for character in text:
		checksum = checksum * CHECKSUM_MULTIPLIER + to_int(character)

	checksum


private pure func diagnostic_entry_checksum(seed: Int, entry: (String, Int)) -> Int:
	checksum_text(seed * CHECKSUM_MULTIPLIER + entry[1], entry[0])


private pure func diagnostic_entries_checksum(entries: List[(String, Int)]) -> Int:
	var checksum: Int = 0

	for entry in entries:
		checksum = diagnostic_entry_checksum(checksum, entry)

	checksum


private pure func observed_index_checksum(snapshot: ClosureFunctionIndexDiagnosticSnapshot) -> Int:
	var checksum: Int = 0

	for id_diagnostic in snapshot.ids:
		match id_diagnostic[1]:
			Some(entry):
				checksum = diagnostic_entry_checksum(checksum, entry)
			None:
				checksum *= CHECKSUM_MULTIPLIER

		checksum = checksum * CHECKSUM_MULTIPLIER + diagnostic_entries_checksum(id_diagnostic[2])

	for name_diagnostic in snapshot.names:
		checksum = checksum * CHECKSUM_MULTIPLIER + diagnostic_entries_checksum(name_diagnostic[1])

	checksum


private pure func observe_indexes(
	fixture: CompilerClosureFunctionIndexProfileFixture,
) -> CompilerClosureFunctionIndexProfileResult:
	snapshot: ClosureFunctionIndexDiagnosticSnapshot = closure_function_index_diagnostic_snapshot(
		fixture.program,
		fixture.query_names,
		fixture.query_def_ids,
	)
	workload_valid: Bool = (
		fixture.config.iterations > 0
		and fixture.functions.length() == total_function_count(fixture.config)
		and snapshot.by_id_count == fixture.expected_by_id_count
		and snapshot.by_name_count == fixture.expected_by_name_count
		and snapshot.collision_id_count == fixture.expected_collision_id_count
		and snapshot.total_collision_entries == fixture.expected_total_collision_entries
	)

	{
		function_count = fixture.functions.length(),
		by_id_count = snapshot.by_id_count,
		by_name_count = snapshot.by_name_count,
		collision_id_count = snapshot.collision_id_count,
		total_collision_entries = snapshot.total_collision_entries,
		checksum = observed_index_checksum(snapshot),
		workload_valid = workload_valid
	}


private pure func observe_index_construction(
	fixture: CompilerClosureFunctionIndexProfileFixture,
) -> CompilerClosureFunctionIndexProfileResult:
	snapshot: ClosureFunctionIndexDiagnosticSnapshot = closure_function_index_diagnostic_snapshot(
		fixture.program,
		[],
		[],
	)
	workload_valid: Bool = (
		fixture.config.iterations > 0
		and fixture.functions.length() == total_function_count(fixture.config)
		and snapshot.by_id_count == fixture.expected_by_id_count
		and snapshot.by_name_count == fixture.expected_by_name_count
		and snapshot.collision_id_count == fixture.expected_collision_id_count
		and snapshot.total_collision_entries == fixture.expected_total_collision_entries
		and snapshot.names.length() == 0
		and snapshot.ids.length() == 0
	)

	{
		function_count = fixture.functions.length(),
		by_id_count = snapshot.by_id_count,
		by_name_count = snapshot.by_name_count,
		collision_id_count = snapshot.collision_id_count,
		total_collision_entries = snapshot.total_collision_entries,
		checksum = observed_index_checksum(snapshot),
		workload_valid = workload_valid
	}


pure func compiler_closure_function_index_profile_execute(
	fixture: CompilerClosureFunctionIndexProfileFixture,
) -> CompilerClosureFunctionIndexProfileResult:
	var result: CompilerClosureFunctionIndexProfileResult = {
		function_count = 0,
		by_id_count = 0,
		by_name_count = 0,
		collision_id_count = 0,
		total_collision_entries = 0,
		checksum = 0,
		workload_valid = fixture.config.iterations > 0
	}

	for _ in 0..fixture.config.iterations:
		next: CompilerClosureFunctionIndexProfileResult = observe_indexes(fixture)
		result = { next |
			checksum = result.checksum * CHECKSUM_MULTIPLIER + next.checksum,
			workload_valid = result.workload_valid and next.workload_valid
		}

	result


pure func compiler_closure_function_index_profile_measure_construction(
	fixture: CompilerClosureFunctionIndexProfileFixture,
) -> CompilerClosureFunctionIndexProfileResult:
	var result: CompilerClosureFunctionIndexProfileResult = {
		function_count = 0,
		by_id_count = 0,
		by_name_count = 0,
		collision_id_count = 0,
		total_collision_entries = 0,
		checksum = 0,
		workload_valid = fixture.config.iterations > 0
	}

	for _ in 0..fixture.config.iterations:
		next: CompilerClosureFunctionIndexProfileResult = observe_index_construction(fixture)
		result = { next |
			checksum = result.checksum * CHECKSUM_MULTIPLIER + next.checksum,
			workload_valid = result.workload_valid and next.workload_valid
		}

	result


pure func compiler_closure_function_index_profile_benchmark(
	config: CompilerClosureFunctionIndexProfileConfig,
) -> CompilerClosureFunctionIndexProfileResult:
	compiler_closure_function_index_profile_execute(
		compiler_closure_function_index_profile_fixture(config),
	)
