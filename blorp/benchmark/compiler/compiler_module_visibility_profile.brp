-- Focused resolved import-closure benchmark.
--
-- Positional controls: iterations, modules, imports per module (`all` or an
-- integer), root count, graph shape, and origin mode (`user` or `mixed`).
import:
	compiler_module_visibility_profile_fixture:
		CompilerModuleVisibilityBenchmarkConfig,
		CompilerModuleVisibilityGraphShape(
			ModuleVisibilityChainGraph,
			ModuleVisibilityDenseGraph,
			ModuleVisibilityEmptyGraph,
			ModuleVisibilityLayeredGraph,
			ModuleVisibilityStarGraph,
		),
		compiler_module_visibility_benchmark,
		compiler_module_visibility_benchmark_input,
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func integer_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			parse_int(text).get_or(default)
		None:
			default


private pure func import_count_argument(args: List[String]) -> Int:
	match args.get(3):
		Some("all"):
			-1
		Some(text):
			parse_int(text).get_or(4)
		None:
			4


private pure func shape_argument(args: List[String]) -> CompilerModuleVisibilityGraphShape:
	match (
		args
			.get(5)
			.get_or("chain")
	):
		"empty":
			ModuleVisibilityEmptyGraph
		"star":
			ModuleVisibilityStarGraph
		"layered":
			ModuleVisibilityLayeredGraph
		"dense":
			ModuleVisibilityDenseGraph
		_:
			ModuleVisibilityChainGraph


private pure func mixed_origins_argument(args: List[String]) -> Bool:
	args
		.get(6)
		.get_or("user") == "mixed"


func main(args: List[String]) -> Int:
	config: CompilerModuleVisibilityBenchmarkConfig = {
		iterations = integer_argument(args, 1, 100),
		module_count = integer_argument(args, 2, 128),
		requested_imports_per_module = import_count_argument(args),
		root_count = integer_argument(args, 4, 1),
		graph_shape = shape_argument(args),
		mixed_origins = mixed_origins_argument(args)
	}
	setup_started = now_microseconds()

	match compiler_module_visibility_benchmark_input(config):
		None:
			print("MODULE_VISIBILITY_PROFILE setup_valid=False")
			1
		Some(input):
			setup_microseconds = now_microseconds() - setup_started
			reset_mem_stats()
			started = now_microseconds()
			result = compiler_module_visibility_benchmark(input)
			elapsed_microseconds = now_microseconds() - started
			memory = get_mem_stats()
			print(
				"MODULE_VISIBILITY_PROFILE" + " iterations=" + config.iterations.to_string() + " modules=" + result.module_count.to_string() + " requested_imports=" + result.requested_imports_per_module.to_string() + " effective_import_limit=" + result.effective_import_limit.to_string() + " roots=" + result.root_count.to_string() + " resolved_edges=" + result.resolved_edge_count.to_string() + " modeled_queue_visits=" + result.modeled_queue_visits.to_string() + " modeled_adjacency_reads=" + result.modeled_adjacency_reads.to_string() + " visible_modules=" + result.visible_module_count.to_string() + " checksum=" + result.checksum.to_string() + " errors=" + result.error_count.to_string() + " workload_valid=" + result.workload_valid.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " total_allocations=" + memory.total_allocations.to_string() + " total_releases=" + memory.total_releases.to_string() + " retained_objects=" + memory.current_objects.to_string() + " allocated_bytes=" + memory.bytes_allocated.to_string(),
			)

			if result.workload_valid and result.error_count == 0:
				0
			else:
				1
