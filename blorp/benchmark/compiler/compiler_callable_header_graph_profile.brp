-- Direct callable-header graph construction profile.
--
-- Positional controls: modules, headers per module, parameters per header,
-- dimension constraints per header, and mixed-error interval.
-- Fixture construction stops at trait topology before the profile window; the
-- timed/profiled section covers a single callable_header_graph_build call only.
-- Result validation runs after timing and after memory stats are captured. Take
-- warm medians by invoking this benchmark repeatedly from the shell.
import:
	../../src/compiler/stage_04_modules/loaded_module:
		ModuleLoadCandidate,
		ModuleOrigin(UserModule),
		module_load_candidate,
		resolved_module_identity_from_resolver,
	../../src/compiler/stage_06_typecheck/graph/indexed_graph:
		PreparedModuleScope,
		indexed_graph_build,
		prepared_module_program,
		prepared_module_scope_module,
	../../src/compiler/stage_06_typecheck/headers/callable_headers:
		CallableHeaderGraph,
		CallableHeaderGraphError,
		callable_header_graph_build,
		callable_header_graph_callables,
		callable_header_graph_error_message,
		callable_header_graph_find,
		callable_header_id,
	../../src/compiler/stage_06_typecheck/headers/declaration_skeleton:
		callable_id_definition_id,
		declaration_skeleton_graph_build,
	../../src/compiler/stage_06_typecheck/headers/trait_headers:
		TraitTopologyGraph,
		trait_topology_graph_build,
	../../src/compiler/stage_06_typecheck/headers/type_header_dependencies:
		type_alias_dependency_graph_validate,
	../../src/compiler/stage_06_typecheck/headers/type_header_graph: type_header_graph_build
	../../src/compiler/stage_06_typecheck/headers/type_parameter_headers:
		resolved_type_parameter_graph_build,
	../../src/compiler/stage_06_typecheck/modules/bound_module_graph:
		BoundModuleViewBinding(BoundModuleViewReady),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		bound_module_graph_build,
	../../src/compiler/stage_06_typecheck/modules/module_view: COMPILER_MODULE_VIEW_EMPTY
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	parsed_program_fixture as ParsedProgramFixture
	string: parse_int
	system: now_microseconds


struct CompilerCallableHeaderGraphProfileConfig {
	module_count: Int,
	headers_per_module: Int,
	parameters_per_header: Int,
	dimension_constraints_per_header: Int,
	mixed_error_interval: Int
}


private record CompilerCallableHeaderGraphProfileSetup {
	topology: TraitTopologyGraph,
	expected_accepted_headers: Int,
	expected_errors: Int
}


private struct CompilerCallableHeaderGraphProfileObservation {
	accepted_headers: Int,
	error_count: Int,
	checksum: Int,
	lookups_valid: Bool
}


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func non_negative_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value >= 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func benchmark_module_name(module_index: Int) -> String:
	"bench/callable_header_graph_profile_" + module_index.to_string()


private pure func benchmark_header_name(module_index: Int, header_index: Int) -> String:
	"callable_header_graph_m" + module_index.to_string() + "_" + header_index.to_string()


private pure func benchmark_header_has_error(header_index: Int, mixed_error_interval: Int) -> Bool:
	mixed_error_interval > 0 and header_index % mixed_error_interval == 0


private pure func benchmark_parameter_list(
	parameter_count: Int,
	dimension_constraint_count: Int,
	has_error: Bool,
) -> String:
	var parameters: List[String] = []

	parameter_type: String = if has_error:
		"missing_callable_header_graph_profile_type"
	else if dimension_constraint_count > 0:
		"Int[#N]"
	else:
		"T"

	for parameter_index in 0..parameter_count:
		parameters = parameters.append(
			"value_" + parameter_index.to_string() + ": " + parameter_type,
		)

	parameters.join(", ")


private pure func benchmark_dimension_constraints(
	parameter_count: Int,
	dimension_constraint_count: Int,
) -> String:
	if dimension_constraint_count == 0:
		""
	else:
		constraint: String = if parameter_count == 0:
			"#N == #1"
		else:
			"#N == #N"

		var constraints: List[String] = []

		for _ in 0..dimension_constraint_count:
			constraints = constraints.append(constraint)

		" where " + constraints.join(", ")


private pure func benchmark_header_source(
	module_index: Int,
	header_index: Int,
	config: CompilerCallableHeaderGraphProfileConfig,
) -> String:
	has_error = benchmark_header_has_error(header_index, config.mixed_error_interval)

	dimension_parameters: String = if config.dimension_constraints_per_header > 0:
		"[#N]"
	else:
		""

	parameters = benchmark_parameter_list(
		config.parameters_per_header,
		config.dimension_constraints_per_header,
		has_error,
	)

	return_type: String = if has_error and config.parameters_per_header == 0:
		"missing_callable_header_graph_profile_type"
	else if config.parameters_per_header == 0:
		if config.dimension_constraints_per_header > 0:
			"Int[#1]"
		else:
			"Int"
	else if config.dimension_constraints_per_header > 0:
		"Int[#N]"
	else:
		"T"

	body: String = if config.parameters_per_header == 0:
		if config.dimension_constraints_per_header > 0:
			"[0]"
		else:
			"0"
	else:
		"value_0"

	"pure func " + benchmark_header_name(
		module_index,
		header_index,
	) + dimension_parameters + "(" + parameters + ") -> " + return_type + benchmark_dimension_constraints(
		config.parameters_per_header,
		config.dimension_constraints_per_header,
	) + ":\n\t" + body


private pure func benchmark_module_source(
	module_index: Int,
	config: CompilerCallableHeaderGraphProfileConfig,
) -> String:
	var declarations: List[String] = []

	for header_index in 0..config.headers_per_module:
		declarations = declarations.append(
			benchmark_header_source(
				module_index,
				header_index,
				config,
			),
		)

	declarations.join("\n\n") + "\n"


private pure func benchmark_candidate(
	module_path: String,
	path: String,
	source: String,
) -> ModuleLoadCandidate:
	module_load_candidate(
		resolved_module_identity_from_resolver(module_path, UserModule),
		ParsedProgramFixture.finalized_typecheck_program_fixture(path, module_path, source),
	)


private pure func accept_empty_view(scope: PreparedModuleScope) -> BoundModuleViewBinding:
	BoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private pure func expected_error_count(config: CompilerCallableHeaderGraphProfileConfig) -> Int:
	if config.mixed_error_interval == 0:
		0
	else:
		per_module = (config.headers_per_module + config.mixed_error_interval - 1) / config.mixed_error_interval
		per_module * config.module_count


private pure func profile_setup(
	config: CompilerCallableHeaderGraphProfileConfig,
) -> Option[CompilerCallableHeaderGraphProfileSetup]:
	var modules: List[ModuleLoadCandidate] = []
	var module_targets: List[String] = []

	for module_index in 0..config.module_count:
		module_path = benchmark_module_name(module_index)
		modules = modules.append(
			benchmark_candidate(
				module_path,
				"/bench/callable_header_graph_profile_" + module_index.to_string() + ".brp",
				benchmark_module_source(module_index, config),
			),
		)
		module_targets = module_targets.append(module_path)

	target = benchmark_candidate(
		"bench/callable_header_graph_profile_main",
		"/bench/callable_header_graph_profile_main.brp",
		"",
	)
	indexed ?= indexed_graph_build(target, modules).to_option()
	bound ?= bound_module_graph_build(indexed, module_targets, accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	topology ?= trait_topology_graph_build(type_headers).to_option()
	errors = expected_error_count(config)

	Some({
		topology = topology,
		expected_accepted_headers = config.module_count * config.headers_per_module - errors,
		expected_errors = errors,
	})


private pure func observe_callable_header_graph_result(
	result: Result[CallableHeaderGraph, List[CallableHeaderGraphError]],
) -> CompilerCallableHeaderGraphProfileObservation:
	match result:
		Ok(graph):
			callables = callable_header_graph_callables(graph)
			var checksum: Int = 0
			var lookups_valid: Bool = True

			for header in callables:
				id = callable_header_id(header)
				checksum += callable_id_definition_id(id)
				lookups_valid = lookups_valid and callable_header_graph_find(graph, id).is_some()

			{
				accepted_headers = callables.length(),
				error_count = 0,
				checksum = checksum,
				lookups_valid = lookups_valid
			}
		Err(errors):
			var checksum: Int = 0

			for error in errors:
				checksum += callable_header_graph_error_message(error).length()

			{
				accepted_headers = 0,
				error_count = errors.length(),
				checksum = checksum,
				lookups_valid = True
			}


private func print_result(
	config: CompilerCallableHeaderGraphProfileConfig,
	setup: CompilerCallableHeaderGraphProfileSetup,
	observation: CompilerCallableHeaderGraphProfileObservation,
	setup_microseconds: Int,
	elapsed_microseconds: Int,
	allocations: Int,
	bytes_allocated: Int,
) -> Int:
	expected_errors = setup.expected_errors

	expected_result_accepted_headers = if expected_errors == 0:
		setup.expected_accepted_headers
	else:
		0

	accepted_count_valid = if expected_errors == 0:
		observation.accepted_headers == setup.expected_accepted_headers
	else:
		observation.accepted_headers == 0

	workload_valid = (
		observation.lookups_valid
		and accepted_count_valid
		and observation.error_count == expected_errors
	)

	print(
		"CALLABLE_HEADER_GRAPH_PROFILE" + " modules=" + config.module_count.to_string() + " headers_per_module=" + config.headers_per_module.to_string() + " parameters_per_header=" + config.parameters_per_header.to_string() + " dimension_constraints_per_header=" + config.dimension_constraints_per_header.to_string() + " mixed_error_interval=" + config.mixed_error_interval.to_string() + " accepted_headers=" + observation.accepted_headers.to_string() + " expected_accepted_headers=" + expected_result_accepted_headers.to_string() + " configured_accepted_headers=" + setup.expected_accepted_headers.to_string() + " errors=" + observation.error_count.to_string() + " expected_errors=" + expected_errors.to_string() + " checksum=" + observation.checksum.to_string() + " lookups_valid=" + observation.lookups_valid.to_string() + " workload_valid=" + workload_valid.to_string() + " allocations=" + allocations.to_string() + " bytes_allocated=" + bytes_allocated.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string(),
	)

	if workload_valid:
		0
	else:
		1


func main(args: List[String]) -> Int:
	config: CompilerCallableHeaderGraphProfileConfig = {
		module_count = positive_argument(args, 1, 1),
		headers_per_module = positive_argument(args, 2, 1024),
		parameters_per_header = non_negative_argument(args, 3, 0),
		dimension_constraints_per_header = non_negative_argument(args, 4, 0),
		mixed_error_interval = non_negative_argument(args, 5, 0)
	}
	setup_started = now_microseconds()

	match profile_setup(config):
		None:
			print("CALLABLE_HEADER_GRAPH_PROFILE setup_failed=True")
			1
		Some(setup):
			setup_microseconds = now_microseconds() - setup_started
			begin_function_profile_window()
			reset_mem_stats()
			started = now_microseconds()
			result = callable_header_graph_build(setup.topology)
			elapsed_microseconds = now_microseconds() - started
			end_function_profile_window()
			stats = get_mem_stats()
			observation = observe_callable_header_graph_result(result)
			print_result(
				config,
				setup,
				observation,
				setup_microseconds,
				elapsed_microseconds,
				stats.total_allocations,
				stats.bytes_allocated,
			)
