import:
	../src/stage_01_file_io/source:
		Cursor,
		SourceFile,
		SourceSpan,
		source_cursor_at,
		source_file,
		source_span,
	../src/stage_02_lex/parse_diagnostic: ParseDiagnostic, parse_error
	../src/stage_03_parse/parsed_ast:
		ParsedDecl(FunctionParsedDecl, ParsedErrorDecl),
		ParsedExpr(
			ParsedAscriptionExpr,
			ParsedCharLiteralExpr,
			ParsedCallExpr,
			ParsedFunctionDeclExpr,
			ParsedForExpr,
			ParsedIntLiteralExpr,
			ParsedMatchExpr,
			ParsedNameExpr,
			ParsedSelectExpr,
			ParsedTupleDestructExpr,
		),
		ParsedForBinder(ParsedForTupleBinder),
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedListPatternSpread(ParsedListSpreadName),
		ParsedMatchCase,
		ParsedParamBinder(ParsedParamTupleBinder),
		ParsedPattern(
			ParsedCharPattern,
			ParsedFloatPattern,
			ParsedIntPattern,
			ParsedListPattern,
			ParsedNamePattern,
			ParsedOrPattern,
			ParsedTuplePattern,
		),
		ParsedProgram,
		ParsedProgramPhase(RawParsedProgram, TypecheckSourceProgram),
		ParsedSelectArm,
		ParsedSelectArmKind(ParsedSelectReceiveArm),
		ParsedTypeExpr(ParsedMissingType, ParsedNamedType, ParsedTupleType),
		parsed_identifier,
		parsed_program_has_errors,
		parsed_program_ok,
		parsed_program_phase_from_name,
		parsed_program_phase_name,
	../src/stage_03_parse/parsed_ast_json:
		PARSED_DECL_KIND_FUNCTION,
		PARSED_PROGRAM_KIND,
		parsed_program_to_json,
	../src/stage_03_parse/parsed_ast_traverse: map_parsed_expr_children,
	test: TestSuite


pure func fixture_source_file() -> SourceFile:
	source_file("ast.brp", "ast", "func main(): 1")


pure func span_between(src: SourceFile, start_offset: Int, end_offset: Int) -> SourceSpan:
	start: Cursor = source_cursor_at(src, start_offset)
	finish: Cursor = source_cursor_at(src, end_offset)
	source_span(src, start, finish)


pure func test_parsed_program_phase_names_round_trip() -> Bool:
	(
		parsed_program_phase_name(RawParsedProgram) == "raw_parse"
		and parsed_program_phase_name(TypecheckSourceProgram) == "typecheck_source"
		and parsed_program_phase_from_name("raw_parse") == Some(RawParsedProgram)
		and parsed_program_phase_from_name("typecheck_source") == Some(TypecheckSourceProgram)
		and parsed_program_phase_from_name("unknown") == None
	)


func test_parsed_program_without_diagnostics_is_ok() -> Bool:
	src: SourceFile = fixture_source_file()
	name: ParsedIdentifier = parsed_identifier(
		"main",
		span_between(src, 5, 9),
	)
	return_type: ParsedTypeExpr = ParsedMissingType(span_between(src, 11, 11))
	body: ParsedExpr = ParsedIntLiteralExpr(
		"1",
		span_between(src, 13, 14),
	)
	decl: ParsedDecl = FunctionParsedDecl({
		name = name,
		keyword_span = Some(span_between(src, 0, 4)),
		type_params = [],
		params = [],
		return_type = Some(return_type),
		dim_constraints = [],
		body = Some(body),
		is_pure = False,
		annotations = [],
		doc = None,
		span = span_between(src, 0, 14),
	})
	program: ParsedProgram = {
		source = src,
		decls = [decl],
		diagnostics = []
	}

	name_ok: Bool = match decl:
		FunctionParsedDecl(function_decl):
			function_decl.name.text == "main"
		_:
			False

	parsed_program_ok(program) and not parsed_program_has_errors(program) and name_ok


func test_parsed_program_with_error_is_not_ok() -> Bool:
	src: SourceFile = fixture_source_file()
	span: SourceSpan = span_between(src, 0, 4)
	diag: ParseDiagnostic = parse_error(span, "expected declaration")
	program: ParsedProgram = {
		source = src,
		decls = [ParsedErrorDecl(span)],
		diagnostics = [diag]
	}
	not parsed_program_ok(program) and parsed_program_has_errors(program)


func test_parsed_program_json_includes_source_decl_and_diagnostics() -> Bool:
	src: SourceFile = fixture_source_file()
	name: ParsedIdentifier = parsed_identifier(
		"main",
		span_between(src, 5, 9),
	)
	body: ParsedExpr = ParsedIntLiteralExpr(
		"1",
		span_between(src, 13, 14),
	)
	decl: ParsedDecl = FunctionParsedDecl({
		name = name,
		keyword_span = Some(span_between(src, 0, 4)),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = Some(body),
		is_pure = False,
		annotations = [],
		doc = None,
		span = span_between(src, 0, 14),
	})
	program: ParsedProgram = {
		source = src,
		decls = [decl],
		diagnostics = []
	}
	text: String = parsed_program_to_json(program).to_string()

	(
		text.contains("\"kind\":\"" + PARSED_PROGRAM_KIND + "\"")
		and text.contains("\"path\":\"ast.brp\"")
		and text.contains("\"kind\":\"" + PARSED_DECL_KIND_FUNCTION + "\"")
		and text.contains("\"name\":\"main\"")
		and text.contains("\"diagnostics\":[]")
	)


func test_parsed_program_json_includes_ascription_expr() -> Bool:
	src: SourceFile = fixture_source_file()
	name: ParsedIdentifier = parsed_identifier(
		"main",
		span_between(src, 5, 9),
	)
	int_type: ParsedTypeExpr = ParsedNamedType(
		parsed_identifier(
			"Int",
			span_between(src, 18, 21),
		),
		[],
		span_between(src, 18, 21),
	)
	body: ParsedExpr = ParsedAscriptionExpr(
		ParsedIntLiteralExpr(
			"1",
			span_between(src, 13, 14),
		),
		int_type,
		span_between(src, 13, 21),
	)
	decl: ParsedDecl = FunctionParsedDecl({
		name = name,
		keyword_span = Some(span_between(src, 0, 4)),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = Some(body),
		is_pure = False,
		annotations = [],
		doc = None,
		span = span_between(src, 0, 21),
	})
	program: ParsedProgram = {
		source = src,
		decls = [decl],
		diagnostics = []
	}
	text: String = parsed_program_to_json(program).to_string()

	text.contains("\"kind\":\"ascription\"") and text.contains("\"type\"")


