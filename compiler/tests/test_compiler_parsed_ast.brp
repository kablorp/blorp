func test_parsed_program_json_includes_rich_patterns() -> Bool:
	src: SourceFile = fixture_source_file()
	name: ParsedIdentifier = parsed_identifier(
		"main",
		span_between(src, 5, 9),
	)
	cases: List[ParsedMatchCase] = [
		{
			pattern = ParsedFloatPattern(
				"3.5",
				span_between(src, 13, 16),
			),
			body = ParsedIntLiteralExpr(
				"1",
				span_between(src, 18, 19),
			),
			span = span_between(src, 13, 19)
		},
		{
			pattern = ParsedCharPattern(
				65,
				span_between(src, 20, 23),
			),
			body = ParsedIntLiteralExpr(
				"2",
				span_between(src, 25, 26),
			),
			span = span_between(src, 20, 26)
		},
		{
			pattern = ParsedOrPattern(
				[ParsedIntPattern(
						"0",
						span_between(src, 27, 28),
					), ParsedIntPattern(
						"1",
						span_between(src, 31, 32),
					)],
				span_between(
					src,
					27,
					32,
				),
			),
			body = ParsedIntLiteralExpr(
				"3",
				span_between(src, 34, 35),
			),
			span = span_between(src, 27, 35)
		},
		{
			pattern = ParsedTuplePattern(
				[ParsedIntPattern(
						"0",
						span_between(src, 36, 37),
					), ParsedIntPattern(
						"0",
						span_between(src, 39, 40),
					), ParsedIntPattern(
						"0",
						span_between(src, 42, 43),
					)],
				span_between(
					src,
					35,
					44,
				),
			),
			body = ParsedIntLiteralExpr(
				"4",
				span_between(src, 46, 47),
			),
			span = span_between(src, 35, 47)
		},
		{
			pattern = ParsedListPattern(
				[ParsedNamePattern(parsed_identifier("head", span_between(src, 48, 52)))],
				Some(ParsedListSpreadName(parsed_identifier("rest", span_between(src, 57, 61)))),
				span_between(src, 47, 62),
			),
			body = ParsedIntLiteralExpr(
				"5",
				span_between(src, 64, 65),
			),
			span = span_between(src, 47, 65)
		},
	]
	body: ParsedExpr = ParsedMatchExpr(
		ParsedNameExpr(parsed_identifier("value", span_between(src, 13, 18))),
		cases,
		span_between(src, 10, 35),
	)
	decl: ParsedDecl = FunctionParsedDecl({
		name = name,
		keyword_span = Some(span_between(src, 0, 4)),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = Some(body),
		is_pure = False,
		annotations = [],
		doc = None,
		span = span_between(src, 0, 35),
	})
	program: ParsedProgram = {
		source = src,
		decls = [decl],
		diagnostics = []
	}
	text: String = parsed_program_to_json(program).to_string()

	(
		text.contains("\"kind\":\"float\"")
		and text.contains("\"kind\":\"char\"")
		and text.contains("\"kind\":\"or\"")
		and text.contains("\"kind\":\"tuple\"")
		and text.contains("\"kind\":\"list\"")
		and text.contains("\"spread\"")
		and text.contains("\"text\":\"rest\"")
	)


func test_parsed_program_json_includes_for_tuple_binder() -> Bool:
	src: SourceFile = fixture_source_file()
	name: ParsedIdentifier = parsed_identifier(
		"main",
		span_between(src, 5, 9),
	)
	body: ParsedExpr = ParsedForExpr(
		ParsedForTupleBinder(
			[parsed_identifier(
					"key",
					span_between(src, 13, 16),
				), parsed_identifier(
					"value",
					span_between(src, 18, 23),
				)],
			span_between(
				src,
				12,
				24,
			),
		),
		ParsedNameExpr(parsed_identifier("pairs", span_between(src, 28, 33))),
		ParsedIntLiteralExpr(
			"1",
			span_between(src, 35, 36),
		),
		span_between(
			src,
			8,
			36,
		),
	)
	decl: ParsedDecl = FunctionParsedDecl({
		name = name,
		keyword_span = Some(span_between(src, 0, 4)),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = Some(body),
		is_pure = False,
		annotations = [],
		doc = None,
		span = span_between(src, 0, 36),
	})
	program: ParsedProgram = {
		source = src,
		decls = [decl],
		diagnostics = []
	}
	text: String = parsed_program_to_json(program).to_string()

	(
		text.contains("\"kind\":\"for\"")
		and text.contains("\"binder\"")
		and text.contains("\"kind\":\"tuple\"")
		and text.contains("\"text\":\"key\"")
		and text.contains("\"text\":\"value\"")
	)


