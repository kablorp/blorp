func test_parsed_program_json_includes_tuple_param_binder() -> Bool:
	src: SourceFile = fixture_source_file()
	name: ParsedIdentifier = parsed_identifier(
		"main",
		span_between(src, 5, 9),
	)
	param_type: ParsedTypeExpr = ParsedTupleType(
		[ParsedNamedType(
				parsed_identifier(
					"Int",
					span_between(src, 30, 33),
				),
				[],
				span_between(src, 30, 33),
			), ParsedNamedType(
				parsed_identifier(
					"Int",
					span_between(src, 35, 38),
				),
				[],
				span_between(src, 35, 38),
			)],
		span_between(
			src,
			29,
			39,
		),
	)
	decl: ParsedDecl = FunctionParsedDecl({
		name = name,
		keyword_span = Some(span_between(src, 0, 4)),
		type_params = [],
		params = [
			{
				binder = ParsedParamTupleBinder(
					[parsed_identifier(
							"left",
							span_between(src, 13, 17),
						), parsed_identifier(
							"right",
							span_between(src, 19, 24),
						)],
					span_between(
						src,
						12,
						25,
					),
				),
				type_expr = Some(param_type),
				span = span_between(src, 12, 39)
			},
		],
		return_type = None,
		dim_constraints = [],
		body = Some(ParsedIntLiteralExpr("1", span_between(src, 43, 44))),
		is_pure = False,
		annotations = [],
		doc = None,
		span = span_between(src, 0, 44),
	})
	program: ParsedProgram = {
		source = src,
		decls = [decl],
		diagnostics = []
	}
	text: String = parsed_program_to_json(program).to_string()

	(
		text.contains("\"binder\"")
		and text.contains("\"kind\":\"tuple\"")
		and text.contains("\"text\":\"left\"")
		and text.contains("\"text\":\"right\"")
		and text.contains("\"type\"")
	)


pure func replace_name_child_with_int(expr: ParsedExpr) -> ParsedExpr:
	match expr:
		ParsedNameExpr(_):
			ParsedIntLiteralExpr("99", span_between(fixture_source_file(), 0, 1))
		_:
			expr


func test_map_parsed_expr_children_rewrites_select_kind_and_body() -> Bool:
	src: SourceFile = fixture_source_file()
	channel_name: ParsedIdentifier = parsed_identifier("ch", span_between(src, 0, 2))
	item_name: ParsedIdentifier = parsed_identifier("item", span_between(src, 3, 7))
	body_name: ParsedIdentifier = parsed_identifier("body", span_between(src, 8, 12))
	arm: ParsedSelectArm = {
		kind = ParsedSelectReceiveArm(item_name, ParsedNameExpr(channel_name)),
		body = ParsedNameExpr(body_name),
		span = span_between(src, 0, 12)
	}
	mapped: ParsedExpr = map_parsed_expr_children(
		ParsedSelectExpr([arm], span_between(src, 0, 12)),
		replace_name_child_with_int,
	)

	match mapped:
		ParsedSelectExpr([mapped_arm], _):
			kind_ok: Bool = match mapped_arm.kind:
				ParsedSelectReceiveArm(_, ParsedIntLiteralExpr("99", _)):
					True
				_:
					False

			body_ok: Bool = match mapped_arm.body:
				ParsedIntLiteralExpr("99", _):
					True
				_:
					False

			kind_ok and body_ok
		_:
			False


func test_map_parsed_expr_children_rewrites_function_decl_body() -> Bool:
	src: SourceFile = fixture_source_file()
	decl: ParsedFunctionDecl = {
		name = parsed_identifier("inner", span_between(src, 0, 5)),
		keyword_span = Some(span_between(src, 0, 4)),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = Some(ParsedNameExpr(parsed_identifier("value", span_between(src, 6, 11)))),
		is_pure = False,
		annotations = [],
		doc = None,
		span = span_between(src, 0, 11)
	}
	mapped: ParsedExpr = map_parsed_expr_children(
		ParsedFunctionDeclExpr(decl),
		replace_name_child_with_int,
	)

	match mapped:
		ParsedFunctionDeclExpr(mapped_decl):
			match mapped_decl.body:
				Some(ParsedIntLiteralExpr("99", _)):
					True
				_:
					False
		_:
			False


tests: TestSuite = {
	description = "Compiler parsed AST foundation",
	tests = [
		("parsed program phase names round trip", test_parsed_program_phase_names_round_trip),
		("parsed program without diagnostics is ok", test_parsed_program_without_diagnostics_is_ok),
		("parsed program with error is not ok", test_parsed_program_with_error_is_not_ok),
		(
			"parsed program JSON includes source decl and diagnostics",
			test_parsed_program_json_includes_source_decl_and_diagnostics,
		),
		(
			"parsed program JSON includes ascription expr",
			test_parsed_program_json_includes_ascription_expr,
		),
		(
			"parsed program JSON includes char literal expr",
			test_parsed_program_json_includes_char_literal_expr,
		),
		(
			"parsed program JSON includes rich patterns",
			test_parsed_program_json_includes_rich_patterns,
		),
		(
			"parsed program JSON includes for tuple binder",
			test_parsed_program_json_includes_for_tuple_binder,
		),
		(
			"parsed program JSON includes tuple destruct expr",
			test_parsed_program_json_includes_tuple_destruct_expr,
		),
		(
			"parsed program JSON includes tuple param binder",
			test_parsed_program_json_includes_tuple_param_binder,
		),
		(
			"map parsed expr children rewrites select kind and body",
			test_map_parsed_expr_children_rewrites_select_kind_and_body,
		),
		(
			"map parsed expr children rewrites function decl body",
			test_map_parsed_expr_children_rewrites_function_decl_body,
		),
	]
}
