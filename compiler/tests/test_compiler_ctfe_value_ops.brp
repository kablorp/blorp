import:
	../src/stage_01_file_io/source:
		Cursor,
		SourceFile,
		SourceSpan,
		source_cursor_at,
		source_file,
		source_span,
	../src/stage_05_types/semantic_type: SemanticType(SemanticNamedType), TYPE_INT, TYPE_STRING
	../src/stage_07_ctfe/value:
		CtfeError(CtfeUnsupported),
		CtfeValue,
		ctfe_bool,
		ctfe_char,
		ctfe_int,
		ctfe_string,
		ctfe_values_equal,
	../src/stage_07_ctfe/value_ops:
		CtfeOptionState(CtfeOptionNone, CtfeOptionSome),
		CtfeResultState(CtfeResultErr, CtfeResultOk),
		ctfe_option_none_value,
		ctfe_option_some_value,
		ctfe_option_state,
		ctfe_result_err_value,
		ctfe_result_ok_value,
		ctfe_result_state,
		ctfe_string_text_of_value,
	test: TestSuite


pure func fixture_source_file() -> SourceFile:
	source_file("value_ops.brp", "value_ops", "VALUE = 1")


pure func fixture_source_span() -> SourceSpan:
	src: SourceFile = fixture_source_file()
	cursor: Cursor = source_cursor_at(src, 0)
	source_span(src, cursor, cursor)


pure func int_value(value: Int) -> CtfeValue:
	ctfe_int(fixture_source_span(), value)


pure func string_value(value: String) -> CtfeValue:
	ctfe_string(fixture_source_span(), value)


pure func bool_value(value: Bool) -> CtfeValue:
	ctfe_bool(fixture_source_span(), value)


pure func char_value(value: Int) -> CtfeValue:
	ctfe_char(fixture_source_span(), to_char(value))


pure func option_int_type() -> SemanticType:
	SemanticNamedType("Option", [TYPE_INT])


pure func result_int_string_type() -> SemanticType:
	SemanticNamedType(
		"Result",
		[TYPE_INT, TYPE_STRING],
	)


func test_option_state_decodes_constructor_values() -> Bool:
	some = ctfe_option_some_value(option_int_type(), fixture_source_span(), int_value(42))
	none = ctfe_option_none_value(option_int_type(), fixture_source_span())

	var some_ok: Bool = False

	match ctfe_option_state(some):
		Ok(CtfeOptionSome(value)):
			some_ok = ctfe_values_equal(value, int_value(42))
		_:
			void

	var none_ok: Bool = False

	match ctfe_option_state(none):
		Ok(CtfeOptionNone):
			none_ok = True
		_:
			void

	some_ok and none_ok


func test_result_state_decodes_constructor_values() -> Bool:
	ok = ctfe_result_ok_value(result_int_string_type(), fixture_source_span(), int_value(7))
	err = ctfe_result_err_value(
		result_int_string_type(),
		fixture_source_span(),
		string_value("bad"),
	)

	var ok_matches: Bool = False

	match ctfe_result_state(ok):
		Ok(CtfeResultOk(value)):
			ok_matches = ctfe_values_equal(value, int_value(7))
		_:
			void

	var err_matches: Bool = False

	match ctfe_result_state(err):
		Ok(CtfeResultErr(value)):
			err_matches = ctfe_values_equal(value, string_value("bad"))
		_:
			void

	ok_matches and err_matches


func test_carrier_state_rejects_non_carriers() -> Bool:
	option_error = ctfe_option_state(int_value(1))
	result_error = ctfe_result_state(int_value(1))

	var option_ok: Bool = False

	match option_error:
		Err(CtfeUnsupported(option_form)):
			option_ok = option_form == "Option helper on non-Option values"
		_:
			void

	var result_ok: Bool = False

	match result_error:
		Err(CtfeUnsupported(result_form)):
			result_ok = result_form == "Result helper on non-Result values"
		_:
			void

	option_ok and result_ok


pure func string_text(result: Result[String, CtfeError]) -> String:
	match result:
		Ok(text):
			text
		Err(_):
			"<error>"


func test_string_text_of_string_value() -> Bool:
	string_text(ctfe_string_text_of_value(string_value("label"))) == "label"


func test_string_text_of_int_value() -> Bool:
	string_text(ctfe_string_text_of_value(int_value(42))) == "42"


func test_string_text_of_bool_value() -> Bool:
	string_text(ctfe_string_text_of_value(bool_value(True))) == "True"


func test_string_text_of_char_value() -> Bool:
	string_text(ctfe_string_text_of_value(char_value(90))) == "Z"


tests: TestSuite = {
	description = "Compiler CTFE value ops",
	tests = [
		("option state decodes constructor values", test_option_state_decodes_constructor_values),
		("result state decodes constructor values", test_result_state_decodes_constructor_values),
		("carrier state rejects non-carriers", test_carrier_state_rejects_non_carriers),
		("string text of String values", test_string_text_of_string_value),
		("string text of Int values", test_string_text_of_int_value),
		("string text of Bool values", test_string_text_of_bool_value),
		("string text of Char values", test_string_text_of_char_value),
	]
}
