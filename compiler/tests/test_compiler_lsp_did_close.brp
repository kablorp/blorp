import:
	../src/stage_12_lsp/did_close:
		decode_lsp_did_close_envelope,
		decode_lsp_did_close_notification,
		handle_lsp_did_close_notification,
	../src/stage_12_lsp/did_open: decode_lsp_did_open_notification, handle_lsp_did_open_notification
	../src/stage_12_lsp/document_model: OpenedDocument
	../src/stage_12_lsp/document_store:
		DocumentStore,
		DocumentStoreError(DocumentNotOpen),
		document_store,
		document_store_find,
	../src/stage_12_lsp/identity: DocumentUri, document_uri_value
	../src/stage_12_lsp/json_rpc: decode_lsp_json_rpc_body, json_rpc_error_value
	../src/stage_12_lsp/protocol:
		ProtocolError(InvalidMethodParameters, MalformedJson, UnexpectedRequestId),
		ProtocolInputOutcome(ProtocolInputAccepted, ProtocolInputIgnored, ProtocolInputRejected),
		RequestId(StringRequestId),
	json: JsonValue, as_number, as_string, get_field
	test: TestSuite


private DOCUMENT_URI: String = "file:///workspace/main.brp"

private DID_OPEN_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///workspace/main.brp","languageId":"blorp","version":12,"text":"original"}}}

private DID_OPEN_OTHER_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///workspace/other.brp","languageId":"other-language","version":3,"text":"other text"}}}

private DID_CLOSE_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didClose","params":{"textDocument":{"uri":"file:///workspace/main.brp"}}}


private pure func response_error_code(response: JsonValue) -> Option[Float]:
	error ?= get_field(response, "error")
	code ?= get_field(error, "code")
	code.as_number()


private pure func invalid_parameters_contain(body: String, expected: String) -> Bool:
	match decode_lsp_did_close_notification(body):
		ProtocolInputIgnored(InvalidMethodParameters(method, detail)):
			method == "textDocument/didClose" and detail.contains(expected)
		_:
			False


private pure func decode_close(body: String) -> Option[DocumentUri]:
	match decode_lsp_did_close_notification(body):
		ProtocolInputAccepted(uri):
			Some(uri)
		_:
			None


private pure func opened_store() -> Option[(DocumentStore, OpenedDocument)]:
	opened ?= match decode_lsp_did_open_notification(DID_OPEN_BODY):
		ProtocolInputAccepted(opened):
			Some(opened)
		_:
			None

	store ?= match handle_lsp_did_open_notification(document_store(), opened):
		Ok(store):
			Some(store)
		Err(_):
			None

	Some((store, opened))


func test_did_close_decodes_document_uri() -> Bool:
	match decode_close(DID_CLOSE_BODY):
		Some(uri):
			document_uri_value(uri) == DOCUMENT_URI
		None:
			False


func test_did_close_accepts_predecoded_envelope() -> Bool:
	match decode_lsp_json_rpc_body(DID_CLOSE_BODY):
		Err(_):
			False
		Ok(envelope):
			match decode_lsp_did_close_envelope(envelope):
				ProtocolInputAccepted(uri):
					document_uri_value(uri) == DOCUMENT_URI
				_:
					False


func test_did_close_request_returns_invalid_request_error() -> Bool:
	body: String =
		|{"jsonrpc":"2.0","id":"close-request","method":"textDocument/didClose","params":{"textDocument":{"uri":"file:///workspace/main.brp"}}}

	match decode_lsp_did_close_notification(body):
		ProtocolInputRejected(failure):
			error_ok: Bool = match failure.error:
				UnexpectedRequestId(method):
					method == "textDocument/didClose"
				_:
					False

			id_ok: Bool = match failure.request_id:
				Some(StringRequestId(id)):
					id == "close-request"
				_:
					False

			response = json_rpc_error_value(failure)

			(
				error_ok
				and id_ok
				and response_error_code(response) == Some(-32600.0)
				and match get_field(response, "id"):
					Some(id):
						id.as_string() == Some("close-request")
					None:
						False
			)
		_:
			False


func test_did_close_ignores_invalid_notification_parameters() -> Bool:
	(
		invalid_parameters_contain(
			"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\"}",
			"params",
		)
		and invalid_parameters_contain(
			"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{}}",
			"textDocument",
		)
		and invalid_parameters_contain(
			"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":false}}",
			"textDocument",
		)
		and invalid_parameters_contain(
			"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{}}}",
			"uri",
		)
		and invalid_parameters_contain(
			"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":false}}}",
			"uri",
		)
	)


func test_did_close_rejects_malformed_json() -> Bool:
	match decode_lsp_did_close_notification("{"):
		ProtocolInputRejected(failure):
			match failure.error:
				MalformedJson(_):
					True
				_:
					False
		_:
			False


func test_document_store_closes_overlay_without_mutating_prior_store() -> Bool:
	match (opened_store(), decode_close(DID_CLOSE_BODY)):
		(Some((store, opened)), Some(uri)):
			match handle_lsp_did_close_notification(store, uri):
				Err(_):
					False
				Ok(closed):
					(
						document_store_find(closed, uri) == None
						and document_store_find(store, opened.document.uri) == Some(opened)
					)
		_:
			False


func test_document_store_rejects_close_for_unopened_document() -> Bool:
	match decode_close(DID_CLOSE_BODY):
		None:
			False
		Some(uri):
			match handle_lsp_did_close_notification(document_store(), uri):
				Err(DocumentNotOpen(missing)):
					document_uri_value(missing) == DOCUMENT_URI
				_:
					False


func test_document_store_close_removes_only_exact_uri() -> Bool:
	match (opened_store(), decode_close(DID_CLOSE_BODY)):
		(Some((main_store, _)), Some(main_uri)):
			match decode_lsp_did_open_notification(DID_OPEN_OTHER_BODY):
				ProtocolInputAccepted(other):
					match handle_lsp_did_open_notification(main_store, other):
						Err(_):
							False
						Ok(both):
							match handle_lsp_did_close_notification(both, main_uri):
								Err(_):
									False
								Ok(closed):
									(
										document_store_find(closed, main_uri) == None
										and document_store_find(
											closed,
											other.document.uri,
										) == Some(other)
									)
				_:
					False
		_:
			False


tests: TestSuite = {
	description = "Blorp LSP didClose notification",
	tests = [
		("decode document URI", test_did_close_decodes_document_uri),
		("accept predecoded envelope", test_did_close_accepts_predecoded_envelope),
		("reject request form", test_did_close_request_returns_invalid_request_error),
		(
			"ignore invalid notification params",
			test_did_close_ignores_invalid_notification_parameters,
		),
		("reject malformed JSON", test_did_close_rejects_malformed_json),
		(
			"close overlay without mutating prior store",
			test_document_store_closes_overlay_without_mutating_prior_store,
		),
		("reject unopened close", test_document_store_rejects_close_for_unopened_document),
		("close only exact URI", test_document_store_close_removes_only_exact_uri),
	]
}
