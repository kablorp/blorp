private record TraitTopologyFixture {
	bound_graph: BoundModuleGraph,
	skeleton_graph: DeclarationSkeletonGraph,
	type_header_graph: TypeHeaderGraph
}


private pure func fixture_module_load_candidate(
	module_path: String,
	source: String,
) -> ModuleLoadCandidate:
	module_load_candidate(
		resolved_module_identity_from_resolver(module_path, UserModule),
		ParserBridge.parsed_typecheck_source_bridge_artifact(
			module_path + ".brp",
			module_path,
			source,
			False,
		).program,
	)


private pure func accept_empty_view(scope: PreparedModuleScope) -> BoundModuleViewBinding:
	BoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private pure func accept_imported_base_view(scope: PreparedModuleScope) -> BoundModuleViewBinding:
	program = prepared_module_program(prepared_module_scope_module(scope))

	if prepared_module_scope_canonical_path(scope) == "main":
		match module_view_register_selective_name(
			COMPILER_MODULE_VIEW_EMPTY,
			"ImportedBase",
			"dep",
			"Base",
		):
			SelectiveNameAdded(view):
				BoundModuleViewReady(view, program, COMPILER_BOUND_MODULE_VISIBILITY_EMPTY, [])
			_:
				BoundModuleViewReady(
					COMPILER_MODULE_VIEW_EMPTY,
					program,
					COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
					[],
				)
	else:
		BoundModuleViewReady(
			COMPILER_MODULE_VIEW_EMPTY,
			program,
			COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
			[],
		)


private pure func accept_imported_non_trait_view(
	scope: PreparedModuleScope,
) -> BoundModuleViewBinding:
	program = prepared_module_program(prepared_module_scope_module(scope))

	if prepared_module_scope_canonical_path(scope) == "main":
		match module_view_register_selective_name(
			COMPILER_MODULE_VIEW_EMPTY,
			"Stringable",
			"dep",
			"Stringable",
		):
			SelectiveNameAdded(view):
				BoundModuleViewReady(view, program, COMPILER_BOUND_MODULE_VISIBILITY_EMPTY, [])
			_:
				BoundModuleViewReady(
					COMPILER_MODULE_VIEW_EMPTY,
					program,
					COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
					[],
				)
	else:
		BoundModuleViewReady(
			COMPILER_MODULE_VIEW_EMPTY,
			program,
			COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
			[],
		)


private pure func accept_local_non_trait_view(scope: PreparedModuleScope) -> BoundModuleViewBinding:
	program = prepared_module_program(prepared_module_scope_module(scope))

	match module_view_register_local_name(COMPILER_MODULE_VIEW_EMPTY, "Stringable", TopLevelType):
		LocalNameAdded(view):
			BoundModuleViewReady(view, program, COMPILER_BOUND_MODULE_VISIBILITY_EMPTY, [])
		_:
			BoundModuleViewReady(
				COMPILER_MODULE_VIEW_EMPTY,
				program,
				COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
				[],
			)


private pure func fixture(
	target_source: String,
	dependency_source: Option[String],
) -> Option[TraitTopologyFixture]:
	target = fixture_module_load_candidate("main", target_source)

	dependencies: List[ModuleLoadCandidate] = match dependency_source:
		Some(source):
			[fixture_module_load_candidate("dep", source)]
		None:
			[]

	indexed ?= indexed_graph_build(target, dependencies).to_option()

	bound ?= match dependency_source:
		Some(_):
			bound_module_graph_build(indexed, ["dep"], accept_imported_base_view).to_option()
		None:
			bound_module_graph_build(indexed, [], accept_empty_view).to_option()

	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	Some({
		bound_graph = bound,
		skeleton_graph = skeletons,
		type_header_graph = type_headers,
	})


private pure func local_fixture(source: String) -> Option[TraitTopologyFixture]:
	fixture(source, None)


private pure func imported_non_trait_fixture() -> Option[TraitTopologyFixture]:
	target = fixture_module_load_candidate("main", "trait Broken: Stringable")
	dependency = fixture_module_load_candidate("dep", "record Stringable {value: Int}")
	indexed ?= indexed_graph_build(target, [dependency]).to_option()
	bound ?= bound_module_graph_build(indexed, ["dep"], accept_imported_non_trait_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	Some({
		bound_graph = bound,
		skeleton_graph = skeletons,
		type_header_graph = type_headers,
	})


private pure func local_non_trait_fixture() -> Option[TraitTopologyFixture]:
	target = fixture_module_load_candidate(
		"main",
		"record Stringable {value: Int}\n\ntrait Broken: Stringable",
	)
	indexed ?= indexed_graph_build(target, []).to_option()
	bound ?= bound_module_graph_build(indexed, [], accept_local_non_trait_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	Some({
		bound_graph = bound,
		skeleton_graph = skeletons,
		type_header_graph = type_headers,
	})


private pure func trait_id(fixture_value: TraitTopologyFixture, name: String) -> Option[TraitId]:
	module_identity = bound_module_identity(bound_module_graph_target(fixture_value.bound_graph))
	declaration_skeleton_graph_find_trait(
		fixture_value.skeleton_graph,
		module_identity,
		name,
	).map(
		func(info): info.id,
	)


private pure func dependency_trait_id(
	fixture_value: TraitTopologyFixture,
	name: String,
) -> Option[TraitId]:
	module ?= bound_module_graph_find_canonical_path(fixture_value.bound_graph, "dep")
	declaration_skeleton_graph_find_trait(
		fixture_value.skeleton_graph,
		bound_module_identity(module),
		name,
	).map(
		func(info): info.id,
	)


private pure func topology_errors(source: String) -> Option[List[String]]:
	fixture_value ?= local_fixture(source)

	match trait_topology_graph_build(fixture_value.type_header_graph):
		Ok(_):
			Some([])
		Err(errors):
			Some(errors.map(trait_topology_graph_error_message))


private pure func topology_errors_equal(source: String, expected: List[String]) -> Bool:
	match topology_errors(source):
		Some(actual):
			actual == expected
		None:
			False


private pure func trait_topology_resolves_exact_ids_and_method_categories() -> Option[Bool]:
	source: String =
		|trait Base:
		|	pure func base(self: Self) -> Int
		|
		|trait Derived[T: Base]: Base:
		|	pure func required(self: Self, value: T) -> Int
		|	pure func provided(self: Self) -> Int: 1
	fixture_value ?= local_fixture(source)
	base_id ?= trait_id(fixture_value, "Base")
	derived_id ?= trait_id(fixture_value, "Derived")
	topology ?= trait_topology_graph_build(fixture_value.type_header_graph).to_option()
	header ?= trait_topology_graph_find(topology, derived_id)
	parameters = trait_topology_header_parameters(header)
	methods = trait_topology_header_methods(header)
	supertrait ?= trait_topology_header_supertraits(header).get(0)
	parameter ?= parameters.get(0)
	parameter_bound ?= trait_type_parameter_bounds(parameter).get(0)
	required_method ?= methods.get(0)
	default_method ?= methods.get(1)
	Some(
		(
			trait_topology_graph_headers(topology).length() == 2
			and trait_topology_header_supertraits(header).length() == 1
			and trait_ids_equal(supertrait, base_id)
			and parameters.length() == 1
			and trait_ids_equal(trait_type_parameter_owner(parameter), derived_id)
			and trait_type_parameter_bounds(parameter).length() == 1
			and trait_ids_equal(parameter_bound, base_id)
			and methods.length() == 2
			and trait_ids_equal(trait_method_slot_owner(required_method), derived_id)
			and trait_method_slot_category(required_method) == RequiredTraitMethod
			and trait_method_slot_category(default_method) == DefaultTraitMethod
		),
	)


pure func test_trait_topology_resolves_exact_ids_and_method_categories() -> Bool:
	trait_topology_resolves_exact_ids_and_method_categories().get_or(False)


private pure func named_parameter_binder_equals(
	binder: CallableParameterBinder,
	expected: String,
) -> Bool:
	match binder:
		NamedParameter(name):
			name == expected
		_:
			False


private pure func trait_method_signature_uses_exact_trait_owned_types() -> Option[Bool]:
	fixture_value ?= local_fixture(
		"trait Mapper[T]:\n\tpure func map(self: Self, value: T, callback: pure (T) -> String) -> String",
	)
	owner ?= trait_id(fixture_value, "Mapper")
	topology ?= trait_topology_graph_build(fixture_value.type_header_graph).to_option()
	header ?= trait_topology_graph_find(topology, owner)
	method ?= trait_topology_header_methods(header).get(0)
	signature = trait_method_slot_signature(method)
	parameters = callable_signature_parameters(signature)
	self_parameter ?= parameters.get(0)
	value_parameter ?= parameters.get(1)
	callback_parameter ?= parameters.get(2)

	self_ok = match self_parameter.typ:
		TraitSelfTypeShape(self_owner):
			trait_ids_equal(self_owner, owner)
		_:
			False

	value_ok = match value_parameter.typ:
		TraitTypeParameterShape(value_id):
			(
				trait_ids_equal(trait_type_parameter_id_owner(value_id), owner)
				and trait_type_parameter_id_index(value_id) == 0
				and trait_type_parameter_id_name(value_id) == "T"
			)
		_:
			False

	callback_ok = match callback_parameter.typ:
		FunctionTypeShape(True, [TraitTypeParameterShape(callback_id)], IntrinsicTypeShape(IntrinsicString, [])):
			trait_type_parameter_id_index(callback_id) == 0
		_:
			False

	return_ok = match callable_signature_return_type(signature):
		IntrinsicTypeShape(IntrinsicString, []):
			True
		_:
			False

	Some(
		(
			self_ok
			and value_ok
			and callback_ok
			and return_ok
			and callable_signature_is_pure(signature)
			and named_parameter_binder_equals(self_parameter.binder, "self")
			and named_parameter_binder_equals(value_parameter.binder, "value")
			and named_parameter_binder_equals(callback_parameter.binder, "callback")
		),
	)


pure func test_trait_method_signature_uses_exact_trait_owned_types() -> Bool:
	trait_method_signature_uses_exact_trait_owned_types().get_or(False)


private pure func trait_method_identity_round_trips() -> Option[Bool]:
	fixture_value ?= local_fixture(
		"trait Numbered:\n\tpure func first(self: Self) -> Int\n\tpure func second(self: Self) -> Int: 2",
	)
	owner ?= trait_id(fixture_value, "Numbered")
	topology ?= trait_topology_graph_build(fixture_value.type_header_graph).to_option()
	header ?= trait_topology_graph_find(topology, owner)
	first ?= trait_topology_header_methods(header).get(0)
	second ?= trait_topology_header_methods(header).get(1)
	first_id = trait_method_slot_id(first)
	second_id = trait_method_slot_id(second)
	found_first ?= trait_topology_graph_find_method(topology, first_id)
	found_second ?= trait_topology_graph_find_method(topology, second_id)
	Some(
		(
			trait_method_id_index(first_id) == 0
			and trait_method_id_index(second_id) == 1
			and trait_ids_equal(trait_method_id_owner(first_id), owner)
			and trait_ids_equal(trait_method_id_owner(second_id), owner)
			and not trait_method_ids_equal(first_id, second_id)
			and trait_method_ids_equal(trait_method_slot_id(found_first), first_id)
			and trait_method_ids_equal(trait_method_slot_id(found_second), second_id)
		),
	)


pure func test_trait_method_identity_round_trips() -> Bool:
	trait_method_identity_round_trips().get_or(False)


private pure func trait_method_lookup_rejects_foreign_id() -> Option[Bool]:
	first_fixture ?= local_fixture("trait First:\n\tpure func first(self: Self) -> Int")
	second_fixture ?= local_fixture("trait Second:\n\tpure func second(self: Self) -> Int")
	first_owner ?= trait_id(first_fixture, "First")
	first_topology ?= trait_topology_graph_build(first_fixture.type_header_graph).to_option()
	first_header ?= trait_topology_graph_find(first_topology, first_owner)
	first_method ?= trait_topology_header_methods(first_header).get(0)
	second_topology ?= trait_topology_graph_build(second_fixture.type_header_graph).to_option()
	Some(
		trait_topology_graph_find_method(
			second_topology,
			trait_method_slot_id(first_method),
		).is_none(),
	)


pure func test_trait_method_lookup_rejects_foreign_id() -> Bool:
	trait_method_lookup_rejects_foreign_id().get_or(False)


private pure func trait_topology_transitive_supertraits_are_deterministic() -> Option[Bool]:
	source: String =
		|trait Root:
		|	pure func root(self: Self) -> Int
		|
		|trait Left: Root:
		|	pure func left(self: Self) -> Int
		|
		|trait Right: Root:
		|	pure func right(self: Self) -> Int
		|
		|trait Leaf: Left + Right:
		|	pure func leaf(self: Self) -> Int
	fixture_value ?= local_fixture(source)
	leaf ?= trait_id(fixture_value, "Leaf")
	topology ?= trait_topology_graph_build(fixture_value.type_header_graph).to_option()
	supertraits ?= trait_topology_graph_transitive_supertraits(topology, leaf)
	Some(supertraits.map(func(id): trait_id_name(id)) == ["Left", "Root", "Right"])


pure func test_trait_topology_transitive_supertraits_are_deterministic() -> Bool:
	trait_topology_transitive_supertraits_are_deterministic().get_or(False)


private pure func trait_topology_transitive_supertraits_reject_foreign_id() -> Option[Bool]:
	first_fixture ?= local_fixture("trait First:\n\tpure func first(self: Self) -> Int")
	second_fixture ?= local_fixture("trait Second:\n\tpure func second(self: Self) -> Int")
	first_id ?= trait_id(first_fixture, "First")
	second_topology ?= trait_topology_graph_build(second_fixture.type_header_graph).to_option()
	Some(trait_topology_graph_transitive_supertraits(second_topology, first_id).is_none())


pure func test_trait_topology_transitive_supertraits_reject_foreign_id() -> Bool:
	trait_topology_transitive_supertraits_reject_foreign_id().get_or(False)


private pure func synthetic_prelude_transitive_supertraits_are_complete() -> Option[Bool]:
	fixture_value ?= local_fixture(
		"trait Sorted: Orderable:\n\tpure func sorted(self: Self) -> Bool",
	)
	sorted ?= trait_id(fixture_value, "Sorted")
	topology ?= trait_topology_graph_build(fixture_value.type_header_graph).to_option()
	supertraits ?= trait_topology_graph_transitive_supertraits(topology, sorted)
	Some(supertraits.map(trait_id_name) == ["Orderable", "Equatable"])


pure func test_synthetic_prelude_transitive_supertraits_are_complete() -> Bool:
	synthetic_prelude_transitive_supertraits_are_complete().get_or(False)


pure func test_builtin_trait_cycle_diagnostic_is_internal_and_unlocated() -> Bool:
	(
		trait_topology_graph_error_message(
			BuiltinTraitTopologyCycle,
		) == "compiler builtin trait inheritance contains a cycle"
		and trait_topology_graph_error_span(BuiltinTraitTopologyCycle).is_none()
	)


private pure func trait_topology_resolves_imported_alias_to_exact_id() -> Option[Bool]:
	target_source: String =
		|import:
		|	dep: Base as ImportedBase
		|
		|trait Base:
		|	pure func local_base(self: Self) -> Int
		|
		|trait Child: ImportedBase:
		|	pure func child(self: Self) -> Int
	dependency_source: String =
		|trait Base:
		|	pure func base(self: Self) -> Int
	fixture_value ?= fixture(target_source, Some(dependency_source))
	child_id ?= trait_id(fixture_value, "Child")
	local_base_id ?= trait_id(fixture_value, "Base")
	base_id ?= dependency_trait_id(fixture_value, "Base")
	topology ?= trait_topology_graph_build(fixture_value.type_header_graph).to_option()
	header ?= trait_topology_graph_find(topology, child_id)
	local_base_header ?= trait_topology_graph_find(topology, local_base_id)
	imported_base_header ?= trait_topology_graph_find(topology, base_id)
	supertraits = trait_topology_header_supertraits(header)
	supertrait ?= supertraits.get(0)
	Some(
		(
			supertraits.length() == 1
			and trait_ids_equal(supertrait, base_id)
			and not trait_ids_equal(local_base_id, base_id)
			and not trait_ids_equal(supertrait, child_id)
			and trait_topology_header_methods(local_base_header).length() == 1
			and trait_topology_header_methods(imported_base_header).length() == 1
		),
	)


pure func test_trait_topology_resolves_imported_alias_to_exact_id() -> Bool:
	trait_topology_resolves_imported_alias_to_exact_id().get_or(False)


private pure func compiler_surface_trait_ids_are_disjoint() -> Option[Bool]:
	equatable ?= prelude_trait_id("Equatable")
	stringable ?= prelude_trait_id("Stringable")
	compiler_surface = module_identity_for_compiler_surface("prelude-traits")
	loaded_surface = module_identity_from_resolved(
		resolved_module_identity_from_resolver(
			"<compiler:prelude-traits>",
			UserModule,
		),
	)
	Some(
		(
			prelude_trait_id("NotAPreludeTrait").is_none()
			and not trait_ids_equal(equatable, stringable)
			and module_identities_equal(trait_id_module_identity(equatable), compiler_surface)
			and not module_identities_equal(compiler_surface, loaded_surface)
			and module_identity_storage_key(
				compiler_surface,
			) != module_identity_storage_key(loaded_surface)
			and module_identity_display_name(compiler_surface) == "<compiler:prelude-traits>"
		),
	)


pure func test_compiler_surface_trait_ids_are_disjoint() -> Bool:
	compiler_surface_trait_ids_are_disjoint().get_or(False)


pure func test_trait_topology_rejects_unknown_references() -> Bool:
	source: String =
		|trait Broken[T: MissingBound]: MissingParent:
		|	pure func broken(self: Self) -> Int
	topology_errors_equal(
		source,
		[
			"trait 'Broken' has unknown supertrait 'MissingParent'",
			"trait 'Broken' type parameter 'T' has unknown bound 'MissingBound'",
		],
	)


pure func test_trait_topology_accepts_compiler_builtin_without_import() -> Bool:
	topology_errors_equal("trait NumericValue: Addable", [])


private pure func imported_non_trait_does_not_fall_back_to_builtin() -> Option[Bool]:
	fixture_value ?= imported_non_trait_fixture()

	match trait_topology_graph_build(fixture_value.type_header_graph):
		Ok(_):
			Some(False)
		Err(errors):
			Some(
				errors.map(
					trait_topology_graph_error_message,
				) == ["trait 'Broken' has unknown supertrait 'Stringable'"],
			)


pure func test_imported_non_trait_does_not_fall_back_to_builtin() -> Bool:
	imported_non_trait_does_not_fall_back_to_builtin().get_or(False)


private pure func local_non_trait_does_not_fall_back_to_builtin() -> Option[Bool]:
	fixture_value ?= local_non_trait_fixture()

	match trait_topology_graph_build(fixture_value.type_header_graph):
		Ok(_):
			Some(False)
		Err(errors):
			Some(
				errors.map(
					trait_topology_graph_error_message,
				) == ["trait 'Broken' has unknown supertrait 'Stringable'"],
			)


pure func test_local_non_trait_does_not_fall_back_to_builtin() -> Bool:
	local_non_trait_does_not_fall_back_to_builtin().get_or(False)


private pure func trait_topology_error_spans_are_precise() -> Option[Bool]:
	fixture_value ?= local_fixture(
		"trait Broken[T: MissingBound]: MissingParent:\n\tpure func broken(self: Self) -> Int",
	)

	match trait_topology_graph_build(fixture_value.type_header_graph):
		Ok(_):
			Some(False)
		Err(errors):
			first ?= errors.get(0)
			second ?= errors.get(1)
			first_span ?= trait_topology_graph_error_span(first)
			second_span ?= trait_topology_graph_error_span(second)
			Some(
				(
					first_span.path == "main.brp"
					and first_span.start_line == 1
					and second_span.path == "main.brp"
					and second_span.start_line == 1
					and first_span.start_column != second_span.start_column
				),
			)


pure func test_trait_topology_errors_retain_reference_spans() -> Bool:
	trait_topology_error_spans_are_precise().get_or(False)


private pure func trait_method_type_error_retains_type_span() -> Option[Bool]:
	fixture_value ?= local_fixture(
		"trait Broken:\n\tpure func broken(self: Self, value: MissingType) -> Int",
	)

	match trait_topology_graph_build(fixture_value.type_header_graph):
		Ok(_):
			Some(False)
		Err(errors):
			error ?= errors.get(0)
			span ?= trait_topology_graph_error_span(error)
			Some(
				(
					trait_topology_graph_error_message(
						error,
					) == "Unknown type 'MissingType' while resolving 'Broken.broken'"
					and span.path == "main.brp"
					and span.start_line == 2
					and span.start_column > 1
				),
			)


pure func test_trait_method_type_error_retains_type_span() -> Bool:
	trait_method_type_error_retains_type_span().get_or(False)


private pure func trait_cycle_error_uses_closing_edge_span() -> Option[Bool]:
	fixture_value ?= local_fixture("trait Alpha: Beta\n\ntrait Beta: Gamma\n\ntrait Gamma: Alpha")

	match trait_topology_graph_build(fixture_value.type_header_graph):
		Ok(_):
			Some(False)
		Err(errors):
			error ?= errors.get(0)
			span ?= trait_topology_graph_error_span(error)
			Some(span.path == "main.brp" and span.start_line == 5 and span.start_column == 14)


pure func test_trait_cycle_error_uses_closing_edge_span() -> Bool:
	trait_cycle_error_uses_closing_edge_span().get_or(False)


pure func test_trait_topology_rejects_duplicate_method_names() -> Bool:
	source: String =
		|trait Broken:
		|	pure func duplicate(self: Self) -> Int
		|	pure func duplicate(self: Self, value: Int) -> Int
	topology_errors_equal(source, ["trait 'Broken' declares method 'duplicate' more than once"])


pure func test_trait_topology_rejects_duplicate_edges_and_parameters() -> Bool:
	source: String =
		|trait Base:
		|	pure func base(self: Self) -> Int
		|
		|trait Broken[T, T]: Base + Base:
		|	pure func broken(self: Self) -> Int
	topology_errors_equal(
		source,
		[
			"trait 'Broken' names supertrait 'Base' more than once",
			"trait 'Broken' declares type parameter 'T' more than once",
		],
	)


pure func test_trait_topology_rejects_cycles_deterministically() -> Bool:
	source: String =
		|trait Alpha: Beta
		|
		|trait Beta: Gamma
		|
		|trait Gamma: Alpha
	topology_errors_equal(source, ["trait inheritance cycle: Alpha -> Beta -> Gamma -> Alpha"])


tests: TestSuite = {
	description = "Compiler trait topology graph",
	tests = [
		(
			"resolves exact ids and method categories",
			test_trait_topology_resolves_exact_ids_and_method_categories,
		),
		(
			"trait method signatures use exact trait-owned types",
			test_trait_method_signature_uses_exact_trait_owned_types,
		),
		("trait method identity round trips", test_trait_method_identity_round_trips),
		("method lookup rejects a foreign id", test_trait_method_lookup_rejects_foreign_id),
		(
			"transitive supertraits are deterministic",
			test_trait_topology_transitive_supertraits_are_deterministic,
		),
		(
			"transitive supertraits reject a foreign id",
			test_trait_topology_transitive_supertraits_reject_foreign_id,
		),
		(
			"synthetic prelude transitive supertraits are complete",
			test_synthetic_prelude_transitive_supertraits_are_complete,
		),
		(
			"builtin trait cycle diagnostic is internal and unlocated",
			test_builtin_trait_cycle_diagnostic_is_internal_and_unlocated,
		),
		(
			"resolves imported aliases to exact ids",
			test_trait_topology_resolves_imported_alias_to_exact_id,
		),
		("compiler surface ids are disjoint", test_compiler_surface_trait_ids_are_disjoint),
		("rejects unknown references", test_trait_topology_rejects_unknown_references),
		(
			"accepts compiler builtin without import",
			test_trait_topology_accepts_compiler_builtin_without_import,
		),
		(
			"imported non-trait does not fall back to builtin",
			test_imported_non_trait_does_not_fall_back_to_builtin,
		),
		(
			"local non-trait does not fall back to builtin",
			test_local_non_trait_does_not_fall_back_to_builtin,
		),
		("errors retain reference spans", test_trait_topology_errors_retain_reference_spans),
		("method type errors retain type spans", test_trait_method_type_error_retains_type_span),
		("cycle error uses closing edge span", test_trait_cycle_error_uses_closing_edge_span),
		("rejects duplicate method names", test_trait_topology_rejects_duplicate_method_names),
		(
			"rejects duplicate edges and parameters",
			test_trait_topology_rejects_duplicate_edges_and_parameters,
		),
		("rejects cycles deterministically", test_trait_topology_rejects_cycles_deterministically),
	]
}
