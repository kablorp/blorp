import:
	../src/stage_05_types/env: FieldDecl
	../src/stage_05_types/record_type_index:
		AcceptedRecordEntry,
		RECORD_TYPE_INDEX_EMPTY,
		RecordTypeIndex,
		record_type_index_add,
		record_type_index_contains,
		record_type_index_entry_count,
		record_type_index_find,
		record_type_index_find_names_with_fields,
		record_type_index_with_fallback,
	../src/stage_05_types/semantic_type:
		SemanticType(SemanticNamedType, SemanticTypeVar),
		TYPE_BOOL,
		TYPE_INT,
		TYPE_STRING,
		types_equal,
	test: TestSuite


private pure func field(name: String, typ: SemanticType) -> FieldDecl:
	{
		name = name,
		field_type = typ,
		definition_id = None
	}


private pure func entry(
	type_params: List[String],
	fields: List[FieldDecl],
	is_value: Bool,
	contains_resource: Bool,
) -> AcceptedRecordEntry:
	{
		type_params = type_params,
		fields = fields,
		is_value = is_value,
		contains_resource = contains_resource,
		may_contain_function = False,
		may_contain_one_shot_stream = False,
		may_contain_resource_source = False
	}


private pure func field_has_type(record_field: FieldDecl, name: String, typ: SemanticType) -> Bool:
	record_field.name == name and types_equal(record_field.field_type, typ)


private pure func add_record(
	index: RecordTypeIndex,
	name: String,
	fields: List[FieldDecl],
) -> RecordTypeIndex:
	record_type_index_add(
		index,
		name,
		entry([], fields, False, False),
	).get_or(index)


private pure func local_records_shadow_fallback_for_exact_lookup() -> Bool:
	fallback = add_record(RECORD_TYPE_INDEX_EMPTY, "User", [field("id", TYPE_INT)])
	local = add_record(RECORD_TYPE_INDEX_EMPTY, "User", [field("name", TYPE_STRING)])
	index = record_type_index_with_fallback(local, fallback)

	match record_type_index_find(index, "User"):
		Some(record_entry):
			record_entry.fields.length() == 1 and match record_entry.fields.get(0):
				Some(record_field):
					(
						record_field.name == "name"
						and types_equal(record_field.field_type, TYPE_STRING)
					)
				None:
					False
		None:
			False


private pure func generic_fields_are_preserved() -> Bool:
	index = record_type_index_add(
		RECORD_TYPE_INDEX_EMPTY,
		"Box",
		entry(["T"], [field("value", SemanticTypeVar("T"))], True, False),
	).get_or(RECORD_TYPE_INDEX_EMPTY)

	match record_type_index_find(index, "Box"):
		Some(record_entry):
			(
				record_entry.type_params == ["T"]
				and record_entry.is_value
				and not record_entry.contains_resource
				and record_entry.fields.length() == 1
				and match record_entry.fields.get(0):
					Some(record_field):
						field_has_type(record_field, "value", SemanticTypeVar("T"))
					None:
						False
			)
		None:
			False


private pure func exact_field_set_matching_preserves_lookup_order() -> Bool:
	with_point = add_record(
		RECORD_TYPE_INDEX_EMPTY,
		"Point",
		[field("x", TYPE_INT), field("y", TYPE_INT)],
	)
	with_pair = add_record(
		with_point,
		"Pair",
		[field("y", TYPE_STRING), field("x", TYPE_STRING)],
	)
	index = add_record(with_pair, "Named", [field("name", TYPE_STRING)])

	record_type_index_find_names_with_fields(
		index,
		["y", "x"],
	) == ["Point", "Pair"] and record_type_index_find_names_with_fields(
		index,
		["x", "y"],
	) == [
		"Point",
		"Pair",
	] and record_type_index_find_names_with_fields(index, ["name"]) == ["Named"]


private pure func duplicate_records_fail_closed() -> Bool:
	index = add_record(RECORD_TYPE_INDEX_EMPTY, "User", [field("id", TYPE_INT)])

	record_type_index_add(
		index,
		"User",
		entry([], [field("name", TYPE_STRING)], False, False),
	).is_none()


private pure func fallback_is_exact_findable_but_excluded_from_field_shape_lookup() -> Bool:
	fallback = add_record(
		RECORD_TYPE_INDEX_EMPTY,
		"CanonicalPoint",
		[field("x", TYPE_INT), field("y", TYPE_INT)],
	)
	local = add_record(
		RECORD_TYPE_INDEX_EMPTY,
		"LocalPoint",
		[field("x", TYPE_INT), field("y", TYPE_INT)],
	)
	index = record_type_index_with_fallback(local, fallback)

	match record_type_index_find(index, "CanonicalPoint"):
		Some(record_entry):
			(
				record_entry.fields.length() == 2
				and record_type_index_entry_count(index) == 2
				and record_type_index_find_names_with_fields(
					index,
					["x", "y"],
				) == ["LocalPoint"]
			)
		None:
			False


private pure func contains_uses_exact_lookup_with_fallback() -> Bool:
	fallback = add_record(RECORD_TYPE_INDEX_EMPTY, "Shared", [field("ok", TYPE_BOOL)])
	index = record_type_index_with_fallback(RECORD_TYPE_INDEX_EMPTY, fallback)

	(
		record_type_index_contains(index, "Shared")
		and not record_type_index_contains(index, "Missing")
		and record_type_index_entry_count(index) == 1
	)


private pure func containment_booleans_are_preserved() -> Bool:
	index = record_type_index_add(
		RECORD_TYPE_INDEX_EMPTY,
		"Holder",
		{
			type_params = [],
			fields = [field(
					"callback",
					SemanticNamedType("Fn", []),
				)],
			is_value = False,
			contains_resource = True,
			may_contain_function = True,
			may_contain_one_shot_stream = True,
			may_contain_resource_source = True
		},
	).get_or(RECORD_TYPE_INDEX_EMPTY)

	match record_type_index_find(index, "Holder"):
		Some(record_entry):
			(
				record_entry.contains_resource
				and record_entry.may_contain_function
				and record_entry.may_contain_one_shot_stream
				and record_entry.may_contain_resource_source
			)
		None:
			False


tests: TestSuite = {
	description = "Compiler record type index",
	tests = [
		(
			"local records shadow fallback for exact lookup",
			local_records_shadow_fallback_for_exact_lookup,
		),
		("generic fields are preserved", generic_fields_are_preserved),
		(
			"exact field set matching preserves lookup order",
			exact_field_set_matching_preserves_lookup_order,
		),
		("duplicate records fail closed", duplicate_records_fail_closed),
		(
			"fallback is exact findable but excluded from field shape lookup",
			fallback_is_exact_findable_but_excluded_from_field_shape_lookup,
		),
		("contains uses exact lookup with fallback", contains_uses_exact_lookup_with_fallback),
		("containment booleans are preserved", containment_booleans_are_preserved),
	]
}
