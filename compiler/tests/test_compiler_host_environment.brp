import:
	../src/stage_12_cli/host_c:
		HostCCompiler,
		HostCCompilerFamily(HostOtherCompiler),
		HostTlsBackend(HostTlsOpenSsl, HostTlsUnsupported),
	../src/stage_12_cli/host_environment:
		HostEnvironmentInput,
		HostEnvironmentProbe,
		discover_compiler_host_environment,
		discover_compiler_host_environment_with_runner,
		host_program_candidates,
		parse_host_compiler_command,
	../src/stage_12_cli/platform:
		HostPlatformError(HostPlatformInterrupted),
		HostProcessExecution(HostProcessCompleted, HostProcessInterrupted),
		HostToolchainProbe,
	bytes: bytes
	process: ProcessCommand, ProcessExit(Exited)
	test: TestSuite
	units: mebibytes, seconds


private func test_environment_discovery_keeps_configuration_structured() -> Bool:
	toolchain: HostToolchainProbe = {
		compiler = {
			program = "cc",
			prefix_arguments = [],
			family = HostOtherCompiler
		},
		uname_program = "uname",
		timeout = Some(seconds(10)),
		capture_limit = mebibytes(4)
	}
	environment_input: HostEnvironmentInput = {
		tls_backend = Some("openssl"),
		openssl_compile_arguments = Some("-I'/ssl include' -DSSL=1"),
		openssl_link_arguments = Some("-L'/ssl lib' -lssl -lcrypto"),
		runtime_cache_root = Some("/cache root"),
		xdg_cache_home = None,
		home = None,
		temporary_root = "/tmp",
		raylib_prefix = Some("/raylib root"),
		discover_raylib_prefix = True
	}
	probe: HostEnvironmentProbe = {
		input = environment_input,
		toolchain = toolchain,
		pkg_config_program = "missing-pkg-config-is-not-needed",
		brew_program = "missing-brew-is-not-needed"
	}

	match discover_compiler_host_environment(probe):
		Err(_):
			False
		Ok(environment):
			(
				environment.cache_root == "/cache root"
				and environment.raylib_prefix == Some("/raylib root")
				and environment.tls.backend == HostTlsOpenSsl
				and environment.tls.runtime_arguments == [
					"-DBLORP_TLS_BACKEND_PROFILE_OPENSSL=1",
					"-I/ssl include",
					"-DSSL=1",
				]
				and environment.tls.link_arguments == ["-L/ssl lib", "-lssl", "-lcrypto"]
			)


private func test_unsupported_tls_does_not_probe_pkg_config() -> Bool:
	toolchain: HostToolchainProbe = {
		compiler = {
			program = "cc",
			prefix_arguments = [],
			family = HostOtherCompiler
		},
		uname_program = "uname",
		timeout = Some(seconds(10)),
		capture_limit = mebibytes(4)
	}
	environment_input: HostEnvironmentInput = {
		tls_backend = None,
		openssl_compile_arguments = None,
		openssl_link_arguments = None,
		runtime_cache_root = None,
		xdg_cache_home = Some("/xdg"),
		home = Some("/home"),
		temporary_root = "/tmp",
		raylib_prefix = None,
		discover_raylib_prefix = False
	}
	probe: HostEnvironmentProbe = {
		input = environment_input,
		toolchain = toolchain,
		pkg_config_program = "missing-pkg-config",
		brew_program = "missing-brew"
	}

	match discover_compiler_host_environment(probe):
		Ok(environment):
			(
				environment.cache_root == "/xdg/blorp/cas"
				and environment.tls.backend == HostTlsUnsupported
				and environment.tls.runtime_arguments.length() == 0
				and environment.tls.link_arguments.length() == 0
			)
		Err(_):
			False


private pure func completed_host_probe(output: String) -> HostProcessExecution:
	HostProcessCompleted({
		exit = Exited(0),
		stdout = output.to_bytes(),
		stderr = bytes(0),
	})


private func test_optional_raylib_probe_preserves_interruption() -> Bool:
	probe: HostEnvironmentProbe = {
		input = {
			tls_backend = None,
			openssl_compile_arguments = None,
			openssl_link_arguments = None,
			runtime_cache_root = None,
			xdg_cache_home = None,
			home = None,
			temporary_root = "/tmp",
			raylib_prefix = None,
			discover_raylib_prefix = True
		},
		toolchain = {
			compiler = {
				program = "fake-cc",
				prefix_arguments = [],
				family = HostOtherCompiler
			},
			uname_program = "fake-uname",
			timeout = Some(seconds(10)),
			capture_limit = mebibytes(4)
		},
		pkg_config_program = "fake-pkg-config",
		brew_program = "fake-brew"
	}

	runner: (ProcessCommand) -> HostProcessExecution = func(request):
		if request.program == "fake-uname":
			completed_host_probe("Darwin\n")
		else if request.program == "fake-cc" and request.args.contains("-dumpmachine"):
			completed_host_probe("arm64-apple-darwin\n")
		else if request.program == "fake-cc":
			completed_host_probe("Apple clang version 18.0\n")
		else:
			HostProcessInterrupted(15, bytes(2), bytes(3))

	match discover_compiler_host_environment_with_runner(probe, runner):
		Err(HostPlatformInterrupted(signal, stdout, stderr)):
			signal == 15 and stdout.length() == 2 and stderr.length() == 3
		_:
			False


private pure func compiler_command_is(
	actual: Result[HostCCompiler, HostPlatformError],
	program: String,
	prefix_arguments: List[String],
) -> Bool:
	match actual:
		Ok(compiler):
			compiler.program == program and compiler.prefix_arguments == prefix_arguments
		Err(_):
			False


private pure func test_host_program_resolution_inputs_are_explicit() -> Bool:
	(
		host_program_candidates(
			"cc",
			Some("/toolchain/bin::/usr/bin"),
		) == ["/toolchain/bin/cc", "cc", "/usr/bin/cc"]
		and host_program_candidates("/custom/cc", Some("/ignored")) == ["/custom/cc"]
		and host_program_candidates("uname", None) == ["/bin/uname", "/usr/bin/uname"]
	)


private pure func test_host_compiler_command_preserves_prefix_arguments() -> Bool:
	compiler_command_is(
		parse_host_compiler_command(Some("ccache clang -target arm64")),
		"ccache",
		["clang", "-target", "arm64"],
	) and compiler_command_is(parse_host_compiler_command(None), "cc", [])


tests: TestSuite = {
	description = "Blorp compiler host environment",
	tests = [
		(
			"environment discovery keeps configuration structured",
			test_environment_discovery_keeps_configuration_structured,
		),
		(
			"unsupported TLS does not probe pkg-config",
			test_unsupported_tls_does_not_probe_pkg_config,
		),
		(
			"optional raylib probe preserves interruption",
			test_optional_raylib_probe_preserves_interruption,
		),
		(
			"host program resolution inputs are explicit",
			test_host_program_resolution_inputs_are_explicit,
		),
		(
			"host compiler command preserves prefix arguments",
			test_host_compiler_command_preserves_prefix_arguments,
		),
	]
}
