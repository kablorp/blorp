private LONG_PRODUCT_CHAIN_LENGTH: Int = 1200


func test_type_header_graph_handles_long_product_chain_iteratively() -> Bool:
	var source: String = ""
	var index: Int = 0

	while index < LONG_PRODUCT_CHAIN_LENGTH:
		name = "Chain" + index.to_string()

		field_type = if index + 1 < LONG_PRODUCT_CHAIN_LENGTH:
			"Chain" + (index + 1).to_string()
		else:
			"Int"

		source += "record " + name + " {next: " + field_type + "}\n"
		index += 1

	type_header_fixture(source).is_some()


