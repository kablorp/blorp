func test_type_header_graph_rejects_direct_value_layout_recursion() -> Bool:
	type_header_errors_equal(
		"struct Node {next: Node}",
		["Infinitely sized value layout: Node -> Node"],
	)


func test_type_header_graph_rejects_mutual_value_layout_recursion() -> Bool:
	type_header_errors_equal(
		"struct Left {right: Right}\n\nstruct Right {left: Left}",
		["Infinitely sized value layout: Left -> Right -> Left"],
	)


func test_type_header_graph_rejects_value_layout_recursion_through_alias() -> Bool:
	type_header_errors_equal(
		"type alias Next = Node\n\nstruct Node {next: Next}",
		["Infinitely sized value layout: Node -> Node"],
	)


func test_type_header_graph_rejects_value_layout_recursion_through_stack_carriers() -> Bool:
	option_errors = type_header_errors_equal(
		"struct OptionalNode {next: Option[OptionalNode]}",
		["Infinitely sized value layout: OptionalNode -> OptionalNode"],
	)
	result_errors = type_header_errors_equal(
		"struct FallibleNode {next: Result[FallibleNode, String]}",
		["Infinitely sized value layout: FallibleNode -> FallibleNode"],
	)
	task_result_errors = type_header_errors_equal(
		"struct TaskNode {next: TaskResult[TaskNode]}",
		["Infinitely sized value layout: TaskNode -> TaskNode"],
	)

	option_errors and result_errors and task_result_errors


func test_type_header_graph_allows_recursion_through_heap_layouts() -> Bool:
	heap_record = type_header_fixture("record Node {next: Option[Node]}").is_some()
	heap_union = type_header_fixture("union Tree:\n\tLeaf\n\tBranch(Tree)").is_some()

	heap_record and heap_union


private pure func installed_recursive_node_matches(fields: List[FieldDecl]) -> Bool:
	match (fields.get(0), fields.get(1)):
		(Some(value), Some(next)):
			(
				value.name == "value"
				and types_equal(value.field_type, SemanticTypeVar("T"))
				and next.name == "next"
				and types_equal(
					next.field_type,
					SemanticNamedType(
						"Option",
						[SemanticNamedType("Node", [SemanticTypeVar("T")])],
					),
				)
			)
		_:
			False


func test_local_record_header_installation_preserves_shape_and_layout() -> Bool:
	source: String =
		|record Node[T] {value: T, next: Option[Node[T]]}
		|struct Point {x: Int, y: Int}
		|type alias Names[T] = List[T]
		|opaque type Secret = String
		|resource type Handle = builtin
		|record Named {names: Names[String], secret: Secret}
		|record Owned {handle: Handle}

	match type_header_fixture(source):
		None:
			False
		Some(fixture):
			identity = bound_module_identity(bound_module_graph_target(fixture.bound))
			state = typecheck_install_local_record_headers(
				typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				fixture.graph,
				identity,
				"std/types",
			)

			match (
				env_get_record(state.env, "Node"),
				env_get_record(state.env, "Point"),
				env_get_record(state.env, "Named"),
			):
				(Some((parameters, node_fields)), Some((_, point_fields)), Some((_, [names_field, secret_field]))):
					(
						state.errors.length() == 0
						and parameters == ["T"]
						and installed_recursive_node_matches(node_fields)
						and env_is_value_record(state.env, "Point")
						and point_fields.length() == 2
						and types_equal(
							names_field.field_type,
							SemanticNamedType("List", [SemanticNamedType("String", [])]),
						)
						and types_equal(
							secret_field.field_type,
							SemanticNamedType("Secret", []),
						)
						and env_type_contains_resource_if_valid(state.env, "Owned") == Some(True)
					)
				_:
					False


func test_record_header_installation_uses_exact_cross_module_identity() -> Bool:
	match cross_module_type_parameter_graph("record Remote {value: Int}"):
		None:
			False
		Some((bound, _, parameters)):
			match type_header_graph_build(parameters):
				Err(_):
					False
				Ok(graph):
					match bound_module_graph_find_canonical_path(bound, "pkg/dep"):
						None:
							False
						Some(dependency):
							with_dependency = typecheck_install_imported_record_headers(
								typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
								graph,
								bound_module_identity(dependency),
								"pkg/dep",
							)
							state = typecheck_install_local_record_headers(
								with_dependency,
								graph,
								bound_module_identity(bound_module_graph_target(bound)),
								"std/types",
							)
							canonical_remote = canonical_module_type_name("pkg/dep", "Remote")

							match env_get_record(state.env, "UsesRemote"):
								Some((_, [field])):
									(
										state.errors.length() == 0
										and env_get_record(state.env, canonical_remote).is_some()
										and types_equal(
											field.field_type,
											SemanticNamedType(canonical_remote, []),
										)
									)
								_:
									False


