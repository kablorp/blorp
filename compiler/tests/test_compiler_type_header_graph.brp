func test_local_union_header_installation_preserves_shape_and_constructor_identity() -> Bool:
	source: String =
		|type alias Names[T] = List[T]
		|resource type Handle = builtin
		|union Tree[T]:
		| Leaf(T)
		| Branch(Tree[T], Tree[T])
		| NamesReady(Names[String])
		| Owns(Handle)
		|enum Color:
		| Red
		| Blue

	match type_header_fixture(source):
		None:
			False
		Some(fixture):
			identity = bound_module_identity(bound_module_graph_target(fixture.bound))
			with_builtins = typecheck_install_local_builtin_headers(
				typecheck_state_for_origin(TYPECHECK_STDLIB_ORIGIN),
				fixture.graph,
				identity,
				"std/types",
			)
			state = typecheck_install_local_union_headers(
				with_builtins,
				fixture.graph,
				identity,
				"std/types",
			)
			tree_header = type_header_graph_local_union_headers(fixture.graph, identity).get(0)

			match (
				env_get_type_decl(state.env, "Tree"),
				env_get_type_decl(state.env, "Color"),
				env_get_constructor_for_parent(state.env, "Tree", "Branch"),
				tree_header,
			):
				(Some((parameters, variants)), Some((_, colors)), Some(branch), Some(header)):
					match (variants.get(2), union_type_header_variants(header).get(1)):
						(Some(names_ready), Some(branch_header)):
							(
								state.errors.length() == 0
								and parameters == ["T"]
								and env_get_type_kind(state.env, "Tree") == Some(TypeUnion)
								and env_get_type_kind(state.env, "Color") == Some(TypeEnum)
								and variants.length() == 4
								and colors.length() == 2
								and branch.tag == 1
								and branch.constructor_id == constructor_id_definition_id(
									branch_header.id,
								)
								and names_ready.fields.length() == 1
								and types_equal(
									names_ready.fields
										.get(0)
										.get_or(SemanticNamedType("Void", [])),
									SemanticNamedType(
										"List",
										[SemanticNamedType("String", [])],
									),
								)
								and env_type_contains_resource_if_valid(
									state.env,
									"Tree",
								) == Some(True)
							)
						_:
							False
				_:
					False


func test_imported_enum_header_uses_canonical_parent_and_exact_constructor_id() -> Bool:
	source: String =
		|enum DirectoryEntryKind:
		| EntryFile
		| EntryDirectory

	match type_header_fixture_at("fs", source):
		None:
			False
		Some(fixture):
			module = bound_module_graph_target(fixture.bound)
			identity = bound_module_identity(module)
			module_path = prepared_module_scope_canonical_path(bound_module_scope(module))
			state = typecheck_install_imported_union_headers(
				typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				fixture.graph,
				identity,
				module_path,
			)
			canonical_kind = canonical_module_type_name(module_path, "DirectoryEntryKind")
			header = type_header_graph_public_union_headers(fixture.graph, identity).get(0)

			match (env_get_constructor(state.env, "EntryDirectory"), header):
				(Some(constructor), Some(union_header)):
					match union_type_header_variants(union_header).get(1):
						Some(variant):
							(
								state.errors.length() == 0
								and constructor.parent_type == canonical_kind
								and constructor.constructor_id == constructor_id_definition_id(
									variant.id,
								)
							)
						None:
							False
				_:
					False


