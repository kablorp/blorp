func test_accepted_header_aliases_preserve_installed_containment_facts() -> Bool:
	source: String =
		|record Plain {value: Int}
		|type alias TaskResult[T] = Result[T, String]

	match type_header_fixture(source):
		None:
			False
		Some(fixture):
			identity = bound_module_identity(bound_module_graph_target(fixture.bound))
			with_records = typecheck_install_local_record_headers(
				typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				fixture.graph,
				identity,
				"std/types",
			)
			with_aliases = typecheck_install_local_alias_headers(
				with_records,
				fixture.graph,
				identity,
				"std/types",
			)
			preserved = (
				env_type_may_contain_function(with_aliases.env, "Plain") == Some(False)
				and env_type_may_contain_one_shot_stream(with_aliases.env, "Plain") == Some(False)
				and env_type_may_contain_resource_source(with_aliases.env, "Plain") == Some(False)
			)

			mutated = env_add_alias(
				with_aliases.env,
				"Int",
				[],
				SemanticNamedType("String", []),
			)

			preserved and env_type_may_contain_function(mutated, "Plain").is_none()


func test_resource_containment_uses_exact_identity_with_same_name() -> Bool:
	target_source: String =
		|record Remote {value: Int}
		|record UsesDependency {value: Dep.Remote}
	dependency_source: String =
		|resource type Handle = builtin("close_handle")
		|record Remote {value: Handle}

	match cross_module_type_parameter_graph_with_target(target_source, dependency_source):
		None:
			False
		Some((bound, skeletons, parameters)):
			match type_header_graph_build(parameters):
				Err(_):
					False
				Ok(graph):
					match bound_module_graph_find_canonical_path(bound, "pkg/dep"):
						None:
							False
						Some(dependency):
							target_identity = bound_module_identity(
								bound_module_graph_target(bound),
							)
							dependency_identity = bound_module_identity(dependency)

							match (
								declaration_skeleton_graph_find_type(
									skeletons,
									target_identity,
									"Remote",
								),
								declaration_skeleton_graph_find_type(
									skeletons,
									target_identity,
									"UsesDependency",
								),
								declaration_skeleton_graph_find_type(
									skeletons,
									dependency_identity,
									"Remote",
								),
							):
								(Some(local), Some(uses_dependency), Some(remote_dependency)):
									(
										not type_header_graph_find(graph, local.id)
											.map(func(header): header.containment.contains_resource)
											.get_or(False)
										and type_header_graph_find(graph, remote_dependency.id)
											.map(func(header): header.containment.contains_resource)
											.get_or(False)
										and type_header_graph_find(graph, uses_dependency.id)
											.map(func(header): header.containment.contains_resource)
											.get_or(False)
									)
								_:
									False


