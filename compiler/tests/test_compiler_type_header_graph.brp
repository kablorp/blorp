				fixture_type_id(fixture, "Alias"),
				fixture_type_id(fixture, "Secret"),
			):
				(Some(choice_id), Some(alias_id), Some(secret_id)):
					match (
						type_header_graph_find(fixture.graph, choice_id),
						type_header_graph_find(fixture.graph, alias_id),
						type_header_graph_find(fixture.graph, secret_id),
					):
						(Some(choice), Some(alias_header), Some(secret)):
							alias_and_constructor_shapes_match(
								choice_id,
								choice,
								alias_header,
								secret,
							)
						_:
							False
				_:
					False


