				_:
					False


private pure func containment_facts_match(
	facts: TypeContainmentFacts,
	may_contain_function: Bool,
	may_contain_one_shot_stream: Bool,
	may_contain_resource_source: Bool,
) -> Bool:
	(
		facts.may_contain_function == may_contain_function
		and facts.may_contain_one_shot_stream == may_contain_one_shot_stream
		and facts.may_contain_resource_source == may_contain_resource_source
	)


func test_type_header_graph_completes_containment_facts() -> Bool:
	source: String =
		|record Plain {value: Int}
		|record Forward {value: Later}
		|record Later {value: Int}
		|record Recursive {next: Option[Recursive]}
		|record Generic[T] {value: T}
		|record Callback {run: pure (Int) -> Int}

	match type_header_fixture(source):
		None:
			False
		Some(fixture):
			match (
				fixture_type_id(fixture, "Plain"),
				fixture_type_id(fixture, "Forward"),
				fixture_type_id(fixture, "Recursive"),
				fixture_type_id(fixture, "Generic"),
			):
				(Some(plain_id), Some(forward_id), Some(recursive_id), Some(generic_id)):
					match (
						type_header_graph_find(fixture.graph, plain_id),
						type_header_graph_find(fixture.graph, forward_id),
						type_header_graph_find(fixture.graph, recursive_id),
						type_header_graph_find(fixture.graph, generic_id),
					):
						(Some(plain), Some(forward), Some(recursive), Some(generic)):
							base_facts_match = (
								containment_facts_match(plain.containment, False, False, False)
								and containment_facts_match(
									forward.containment,
									False,
									False,
									False,
								)
								and containment_facts_match(
									recursive.containment,
									False,
									False,
									False,
								)
								and containment_facts_match(generic.containment, True, True, True)
							)

							match fixture_type_id(fixture, "Callback"):
								Some(callback_id):
									(
										base_facts_match
										and type_header_graph_find(fixture.graph, callback_id)
											.map(
												func(
													callback,
												): containment_facts_match(
													callback.containment,
													True,
													False,
													False,
												),
											)
											.get_or(False)
									)
								None:
									False
						_:
							False
				_:
					False


func test_stream_containment_uses_canonical_builtin_identity() -> Bool:
	canonical_source: String =
		|type Stream[T] = builtin
		|type ResourceSource[T] = builtin
		|record Streams {stream: Stream[Int]}
		|record Sources {source: ResourceSource[Int]}
	impostor_source: String =
		|type Stream[T] = builtin
		|record Streams {stream: Stream[Int]}

	match (
		type_header_fixture_with_source_name(
			"std/stream",
			"source-label-does-not-own-identity",
			canonical_source,
		),
		type_header_fixture_at("std/types", impostor_source),
	):
		(Some(canonical), Some(impostor)):
			match (
				fixture_type_id(canonical, "Streams"),
				fixture_type_id(canonical, "Sources"),
				fixture_type_id(impostor, "Streams"),
			):
				(Some(streams_id), Some(sources_id), Some(impostor_id)):
					match (
						type_header_graph_find(canonical.graph, streams_id),
						type_header_graph_find(canonical.graph, sources_id),
						type_header_graph_find(impostor.graph, impostor_id),
					):
						(Some(streams), Some(sources), Some(impostor_streams)):
							(
								containment_facts_match(streams.containment, False, True, False)
								and containment_facts_match(sources.containment, False, False, True)
								and containment_facts_match(
									impostor_streams.containment,
									False,
									False,
									False,
								)
							)
						_:
							False
				_:
					False
		_:
			False


func test_opaque_alias_installation_preserves_containment_facts() -> Bool:
	source: String =
		|type Stream[T] = builtin
		|type ResourceSource[T] = builtin
		|resource type Handle = builtin
		|opaque type HiddenStream = Stream[Int]
		|opaque type HiddenSource = ResourceSource[Int]
		|opaque type HiddenCallback = pure (Int) -> Int
		|opaque type HiddenResource = Handle

	match type_header_fixture_with_source_name(
		"std/stream",
		"source-label-does-not-own-identity",
		source,
	):
		None:
			False
		Some(fixture):
			identity = bound_module_identity(bound_module_graph_target(fixture.bound))
			with_builtins = typecheck_install_local_builtin_headers(
				typecheck_state_for_origin(TYPECHECK_STDLIB_ORIGIN),
				fixture.graph,
				identity,
				"std/stream",
			)
			state = typecheck_install_local_alias_headers(
				with_builtins,
				fixture.graph,
				identity,
				"std/stream",
			)

			(
				env_type_may_contain_one_shot_stream(state.env, "HiddenStream") == Some(True)
				and env_type_may_contain_resource_source(state.env, "HiddenSource") == Some(True)
				and env_type_may_contain_function(state.env, "HiddenCallback") == Some(True)
				and env_type_contains_resource_if_valid(state.env, "HiddenResource") == Some(True)
			)


func test_imported_opaque_aliases_preserve_containment_facts() -> Bool:
	source: String =
		|type Stream[T] = builtin
		|type ResourceSource[T] = builtin
		|resource type Handle = builtin
		|opaque type HiddenStream = Stream[Int]
		|opaque type HiddenSource = ResourceSource[Int]
