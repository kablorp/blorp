private pure func alias_and_constructor_shapes_match(
	choice_id: TypeId,
	choice: TypeHeader,
	alias_header: TypeHeader,
	secret: TypeHeader,
) -> Bool:
	match (choice.shape, alias_header.shape, secret.shape):
		(UnionTypeHeader(TaggedUnion, variants), AliasTypeHeader(TransparentAlias, _), AliasTypeHeader(OpaqueAlias, _)):
			variants.all(func(variant):
				type_ids_equal(variant.parent_type_id, choice_id)
			)
		_:
			False


