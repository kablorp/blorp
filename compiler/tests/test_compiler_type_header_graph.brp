func test_type_header_graph_rejects_mutual_recursive_value_layouts() -> Bool:
	source: String =
		|record Left {right: Right}
		|record Right {left: Left}

	match type_parameter_graph(source):
		None:
			False
		Some((_, _, parameters)):
			match type_header_graph_build(parameters):
				Err([TypeHeaderRecursiveValueLayout(left, False), TypeHeaderRecursiveValueLayout(right, False)]):
					(
						type_id_name(left) == "Left"
						and type_id_name(right) == "Right"
						and type_header_error_message(
							TypeHeaderRecursiveValueLayout(
								left,
								False,
							),
						).contains("recursive value layout")
						and not type_header_error_message(
							TypeHeaderRecursiveValueLayout(
								left,
								False,
							),
						).contains("directly recursive")
					)
				_:
					False


