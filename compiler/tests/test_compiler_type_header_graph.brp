private record TypeHeaderFixture {
	bound: BoundModuleGraph,
	skeletons: DeclarationSkeletonGraph,
	graph: TypeHeaderGraph
}


private pure func finalized_program(source: String) -> FinalizedTypecheckProgram:
	ParserBridge.parsed_typecheck_source_bridge_artifact(
		"types.brp",
		"std/types",
		source,
		False,
	).program


private pure func fixture_module_load_candidate(source: String) -> ModuleLoadCandidate:
	module_load_candidate_at("std/types", source)


private pure func module_load_candidate_at(
	module_path: String,
	source: String,
) -> ModuleLoadCandidate:
	module_load_candidate_with_source_name(module_path, module_path, source)


private pure func module_load_candidate_with_source_name(
	canonical_path: String,
	source_name: String,
	source: String,
) -> ModuleLoadCandidate:
	module_load_candidate(
		resolved_module_identity_from_resolver(canonical_path, StdlibModule),
		ParserBridge.parsed_typecheck_source_bridge_artifact(
			canonical_path + ".brp",
			source_name,
			source,
			False,
		).program,
	)


private pure func accept_empty_view(scope: PreparedModuleScope) -> BoundModuleViewBinding:
	BoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private pure func type_parameter_graph(
	source: String,
) -> Option[(BoundModuleGraph, DeclarationSkeletonGraph, ResolvedTypeParameterGraph)]:
	type_parameter_graph_at("std/types", source)


private pure func type_parameter_graph_at(
	module_path: String,
	source: String,
) -> Option[(BoundModuleGraph, DeclarationSkeletonGraph, ResolvedTypeParameterGraph)]:
	indexed ?= indexed_graph_build(
		module_load_candidate_at(module_path, source),
		[],
	).to_option()
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	Some((bound, skeletons, parameters))


private pure func type_header_fixture_at(
	module_path: String,
	source: String,
) -> Option[TypeHeaderFixture]:
	type_header_fixture_with_source_name(module_path, module_path, source)


private pure func type_header_fixture_with_source_name(
	canonical_path: String,
	source_name: String,
	source: String,
) -> Option[TypeHeaderFixture]:
	indexed ?= indexed_graph_build(
		module_load_candidate_with_source_name(canonical_path, source_name, source),
		[],
	).to_option()
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	graph ?= type_header_graph_build(parameters).to_option()
	Some({
		bound = bound,
		skeletons = skeletons,
		graph = graph,
	})


private pure func type_header_fixture(source: String) -> Option[TypeHeaderFixture]:
	type_header_fixture_at("std/types", source)


private pure func type_header_error_messages(source: String) -> Option[List[String]]:
	fixture ?= type_parameter_graph(source)
	(_, _, parameters) = fixture

	match type_header_graph_build(parameters):
		Ok(_):
			Some([])
		Err(errors):
			Some(errors.map(type_header_error_message))


private pure func type_header_errors_equal(source: String, expected: List[String]) -> Bool:
	match type_header_error_messages(source):
		Some(actual):
			actual == expected
		None:
			False


private pure func accept_dependency_alias_view(
	scope: PreparedModuleScope,
) -> BoundModuleViewBinding:
	path = prepared_module_scope_canonical_path(scope)
	program = prepared_module_program(prepared_module_scope_module(scope))

	if path == "std/types":
		match module_view_register_module_alias(COMPILER_MODULE_VIEW_EMPTY, "Dep", "pkg/dep"):
			ModuleAliasAdded(view):
				BoundModuleViewReady(view, program, COMPILER_BOUND_MODULE_VISIBILITY_EMPTY, [])
			_:
				BoundModuleViewReady(
					COMPILER_MODULE_VIEW_EMPTY,
					program,
					COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
					[],
				)
	else:
		BoundModuleViewReady(
			COMPILER_MODULE_VIEW_EMPTY,
			program,
			COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
			[],
		)


private pure func cross_module_type_parameter_graph_with_target(
	target_source: String,
	dependency_source: String,
) -> Option[(BoundModuleGraph, DeclarationSkeletonGraph, ResolvedTypeParameterGraph)]:
	target = fixture_module_load_candidate(target_source)
	dependency = module_load_candidate_at("pkg/dep", dependency_source)
	indexed ?= indexed_graph_build(target, [dependency]).to_option()
	bound ?= bound_module_graph_build(
		indexed,
		["pkg/dep"],
		accept_dependency_alias_view,
	).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	Some((bound, skeletons, parameters))


private pure func cross_module_type_parameter_graph(
	dependency_source: String,
) -> Option[(BoundModuleGraph, DeclarationSkeletonGraph, ResolvedTypeParameterGraph)]:
	cross_module_type_parameter_graph_with_target(
		"record UsesRemote {value: Dep.Remote}",
		dependency_source,
	)


private pure func accept_dependency_selective_view(
	scope: PreparedModuleScope,
) -> BoundModuleViewBinding:
	path = prepared_module_scope_canonical_path(scope)
	program = prepared_module_program(prepared_module_scope_module(scope))

	if path == "std/types":
		match module_view_register_selective_name(
			COMPILER_MODULE_VIEW_EMPTY,
			"IOError",
			"fs",
			"IOError",
		):
			SelectiveNameAdded(view):
				BoundModuleViewReady(view, program, COMPILER_BOUND_MODULE_VISIBILITY_EMPTY, [])
			_:
				BoundModuleViewReady(
					COMPILER_MODULE_VIEW_EMPTY,
					program,
					COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
					[],
				)
	else:
		BoundModuleViewReady(
			COMPILER_MODULE_VIEW_EMPTY,
			program,
			COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
			[],
		)


private pure func selective_cross_module_type_parameter_graph(

) -> Option[(BoundModuleGraph, ResolvedTypeParameterGraph)]:
	target_source: String =
		|union UsesImportedError:
		| Item(IOError)
	target = fixture_module_load_candidate(target_source)
	dependency_source: String =
		|union IOError:
		| NotFound(String)
	dependency = module_load_candidate_at("fs", dependency_source)
	indexed ?= indexed_graph_build(target, [dependency]).to_option()
	bound ?= bound_module_graph_build(indexed, ["fs"], accept_dependency_selective_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	Some((bound, parameters))


private pure func fixture_type_id(fixture: TypeHeaderFixture, name: String) -> Option[TypeId]:
	declaration_skeleton_graph_find_type(
		fixture.skeletons,
		bound_module_identity(bound_module_graph_target(fixture.bound)),
		name,
	).map(
		func(info): info.id,
	)


private pure func source() -> String:
	|record Node[T] {value: T, next: Option[Node[T]]}
	|
	|union Choice:
	|	Item(Node[Int])
	|	Empty
	|
	|type alias Alias = Node[String]
	|opaque type Secret = String
	|resource type Handle = builtin("close_handle")
	|record Owned {handle: Option[Handle]}


private pure func type_header_kind_name(header: TypeHeader) -> String:
	match header.shape:
		RecordTypeHeader(_, _):
			"record"
		UnionTypeHeader(_, _):
			"union"
		BuiltinTypeHeader(_):
			"builtin"
		AliasTypeHeader(_, _):
			"alias"


private pure func recursive_node_shape_matches(node_id: TypeId, header: TypeHeader) -> Bool:
	match header.shape:
		RecordTypeHeader(HeapRecord, fields):
			match (fields.get(0), fields.get(1)):
				(Some(value), Some(next)):
					match (value.typ, next.typ):
						(TypeParameterShape(parameter_id), IntrinsicTypeShape(IntrinsicOption, [option_arg])):
							match option_arg:
								DeclaredTypeShape(resolved_node_id, [node_arg]):
									match node_arg:
										TypeParameterShape(node_parameter_id):
											(
												type_parameter_id_name(parameter_id) == "T"
												and type_ids_equal(resolved_node_id, node_id)
												and type_parameter_ids_equal(
													parameter_id,
													node_parameter_id,
												)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


func test_type_header_graph_rejects_unknown_shapes_atomically() -> Bool:
	match type_parameter_graph("record Broken {value: MissingType}"):
		None:
			False
		Some((_, _, parameters)):
			match type_header_graph_build(parameters):
				Ok(_):
					False
				Err([TypeHeaderResolutionError(TypeShapeUnknownType(_, "MissingType", _))]):
					True
				Err(_):
					False


func test_type_header_graph_rejects_enum_payload_before_installation() -> Bool:
	source: String =
		|enum Bad:
		| Value(Int)

	match type_parameter_graph(source):
		None:
			False
		Some((_, _, parameters)):
			match type_header_graph_build(parameters):
				Err([TypeHeaderInvalidEnumVariantFields(_, "Value")]):
					True
				_:
					False


func test_type_header_graph_accepts_implicit_prelude_type_without_loaded_std() -> Bool:
	match type_header_fixture("record HasItems {items: List[Int]}"):
		Some(fixture):
			match fixture_type_id(fixture, "HasItems"):
				None:
					False
				Some(type_id):
					match type_header_graph_find(fixture.graph, type_id):
						Some(header):
							match header.shape:
								RecordTypeHeader(_, [field]):
									match field.typ:
										PreludeTypeShape(PreludeList, [IntrinsicTypeShape(IntrinsicInt, [])]):
											True
										_:
											False
								_:
									False
						None:
							False
		None:
			False


func test_type_header_graph_preserves_local_prelude_name_shadow() -> Bool:
	source: String =
		|record List {value: Int}
		|record UsesLocal {items: List}

	match type_header_fixture(source):
		None:
			False
		Some(fixture):
			match (fixture_type_id(fixture, "List"), fixture_type_id(fixture, "UsesLocal")):
				(Some(list_id), Some(uses_id)):
					match type_header_graph_find(fixture.graph, uses_id):
						Some(header):
							match header.shape:
								RecordTypeHeader(_, [field]):
									match field.typ:
										DeclaredTypeShape(resolved_id, []):
											type_ids_equal(resolved_id, list_id)
										_:
											False
								_:
									False
						None:
							False
				_:
					False


func test_type_header_graph_preserves_implicit_prelude_resource_capability() -> Bool:
	match type_header_fixture("record Reads {reader: FileReader}"):
		None:
			False
		Some(fixture):
			match fixture_type_id(fixture, "Reads"):
				Some(type_id):
					type_header_graph_find(fixture.graph, type_id)
						.map(func(header): header.containment.contains_resource)
						.get_or(False)
				None:
					False


func test_type_header_graph_resolves_qualified_reference_to_exact_dependency_id() -> Bool:
	match cross_module_type_parameter_graph("record Remote {value: Int}"):
		None:
			False
		Some((bound, skeletons, parameters)):
			match type_header_graph_build(parameters):
				Err(_):
					False
				Ok(graph):
					match bound_module_graph_find_canonical_path(bound, "pkg/dep"):
						None:
							False
						Some(dependency):
							match (
								declaration_skeleton_graph_find_type(
									skeletons,
									bound_module_identity(dependency),
									"Remote",
								),
								declaration_skeleton_graph_find_type(
									skeletons,
									bound_module_identity(bound_module_graph_target(bound)),
									"UsesRemote",
								),
							):
								(Some(remote), Some(uses_remote)):
									match type_header_graph_find(graph, uses_remote.id):
										Some(header):
											match header.shape:
												RecordTypeHeader(_, [field]):
													match field.typ:
														DeclaredTypeShape(resolved_id, []):
															type_ids_equal(resolved_id, remote.id)
														_:
															False
												_:
													False
										None:
											False
								_:
									False


func test_type_header_graph_rejects_private_qualified_reference() -> Bool:
	match cross_module_type_parameter_graph("private record Remote {value: Int}"):
		None:
			False
		Some((_, _, parameters)):
			match type_header_graph_build(parameters):
				Err([TypeHeaderResolutionError(TypeShapePrivateTypeReference(_, _, _))]):
					True
				_:
					False


func test_type_header_graph_rejects_managed_struct_fields() -> Bool:
	source: String =
		|record Config {name: String}
		|type alias Names = List[Int]
		|type alias MoreNames = Names
		|opaque type HiddenNames = List[Int]
		|type alias Identity[T] = T
		|union Payload:
		| Value(Int)
		|struct Bad {
		| name: String,
		| items: List[Int],
		| maybe: Option[Int],
		| config: Config,
		| callback: pure (Int) -> Int,
		| names: Names,
		| more_names: MoreNames,
		| hidden_names: HiddenNames,
		| generic_names: Identity[List[Int]],
		| payload: Payload,
		| pair: (Int, Int)
		|}

	match type_parameter_graph(source):
		None:
			False
		Some((_, _, parameters)):
			match type_header_graph_build(parameters):
				Err([TypeHeaderInvalidStructField(_, "name"), TypeHeaderInvalidStructField(_, "items"), TypeHeaderInvalidStructField(_, "maybe"), TypeHeaderInvalidStructField(_, "config"), TypeHeaderInvalidStructField(_, "callback"), TypeHeaderInvalidStructField(_, "names"), TypeHeaderInvalidStructField(_, "more_names"), TypeHeaderInvalidStructField(_, "hidden_names"), TypeHeaderInvalidStructField(_, "generic_names"), TypeHeaderInvalidStructField(_, "payload"), TypeHeaderInvalidStructField(_, "pair")]):
					True
				_:
					False


func test_invalid_struct_field_message_explains_ownership_rule() -> Bool:
	match type_parameter_graph("struct Bad {name: String}"):
		None:
			False
		Some((_, _, parameters)):
			match type_header_graph_build(parameters):
				Err([error]):
					type_header_error_message(
						error,
					) == "Struct 'Bad' field 'name' has invalid storage: struct fields must be " + "scalar values, fieldless enums, or other structs\n" + "help: Use a record for strings, collections, functions, payload unions, " + "records, and tuples"
				_:
					False


func test_type_header_graph_accepts_scalar_and_nested_struct_fields() -> Bool:
	source: String =
		|struct Point {x: Float32, y: Float32}
		|enum Status:
		| Ready
		| Busy
		|opaque type Count = Int
		|type alias Identity[T] = T
		|struct Measurement {point: Point, count: Count, sample: Identity[Int], status: Status, valid: Bool}
	type_header_fixture(source).is_some()


func test_type_header_graph_accepts_synthetic_inline_prelude_fields() -> Bool:
	type_header_fixture("struct PreludeValues {kind: DirectoryEntryKind, range: Range}").is_some()


func test_type_header_graph_distinguishes_declared_builtin_storage() -> Bool:
	int_is_scalar = type_header_fixture_at(
		"std/int",
		"type Int = builtin\nstruct ScalarField {value: Int}",
	).is_some()
	port_is_scalar = type_header_fixture_at(
		"std/net/tcp",
		"type Port = builtin\nstruct Endpoint {port: Port}",
	).is_some()

	managed_string_is_rejected = match type_parameter_graph_at(
		"std/string",
		"type String = builtin\nstruct ManagedField {value: String}",
	):
		Some((_, _, parameters)):
			match type_header_graph_build(parameters):
				Err([TypeHeaderInvalidStructField(_, "value")]):
					True
				_:
					False
		None:
			False

	same_named_non_abi_builtin_is_rejected = match type_parameter_graph(
		"type Int = builtin\nstruct ImpostorField {value: Int}",
	):
		Some((_, _, parameters)):
			match type_header_graph_build(parameters):
				Err([TypeHeaderInvalidStructField(_, "value")]):
					True
				_:
					False
		None:
			False

	(
		int_is_scalar
		and port_is_scalar
		and managed_string_is_rejected
		and same_named_non_abi_builtin_is_rejected
	)


func test_builtin_storage_manifest_covers_current_abi() -> Bool:
	expected: List[(String, String, BuiltinValueStorage)] = [
		("std/int", "Int", BuiltinInlineScalar),
		("std/int8", "Int8", BuiltinInlineScalar),
		("std/int16", "Int16", BuiltinInlineScalar),
		("std/int32", "Int32", BuiltinInlineScalar),
		("std/int128", "Int128", BuiltinInlineScalar),
		("std/uint8", "UInt8", BuiltinInlineScalar),
		("std/uint16", "UInt16", BuiltinInlineScalar),
		("std/uint32", "UInt32", BuiltinInlineScalar),
		("std/uint64", "UInt64", BuiltinInlineScalar),
		("std/uint128", "UInt128", BuiltinInlineScalar),
		("std/float", "Float", BuiltinInlineScalar),
		("std/float16", "Float16", BuiltinInlineScalar),
		("std/float32", "Float32", BuiltinInlineScalar),
		("std/char", "Char", BuiltinInlineScalar),
		("std/ptr", "Ptr", BuiltinInlineScalar),
		("std/net/tcp", "Port", BuiltinInlineScalar),
		("std/bytes", "Bytes", BuiltinManagedReference),
		("std/channel", "Channel", BuiltinManagedReference),
		("std/dict", "Dict", BuiltinManagedReference),
		("std/fixed", "Fixed", BuiltinManagedReference),
		("std/list", "List", BuiltinManagedReference),
		("std/list", "ParallelList", BuiltinManagedReference),
		("std/matrix", "ParallelMatrix", BuiltinManagedReference),
		("std/net/tcp", "DnsName", BuiltinManagedReference),
		("std/net/tcp", "InterfaceScope", BuiltinManagedReference),
		("std/net/tcp", "IpAddress", BuiltinManagedReference),
		("std/set", "Set", BuiltinManagedReference),
		("std/slice", "StringSlice", BuiltinManagedReference),
		("std/stream", "FallibleStream", BuiltinManagedReference),
		("std/stream", "ResourceSource", BuiltinManagedReference),
		("std/stream", "Stream", BuiltinManagedReference),
		("std/string", "String", BuiltinManagedReference),
		("std/vector", "ParallelVector", BuiltinManagedReference),
		("std/void", "Void", BuiltinNoValue),
	]
	var complete: Bool = expected.length() == 34

	for (module_name, type_name, storage) in expected:
		if builtin_value_storage(module_name, type_name) != Some(storage):
			complete = False
			break

	complete and builtin_value_storage("std/other", "Int").is_none()


func test_scalar_builtin_installation_preserves_storage() -> Bool:
