import:
	../src/stage_01_file_io/source: source_file
	../src/stage_03_parse/language_parser: parse_compiler_source
	../src/stage_04_modules/loaded_module:
		ModuleIdentity,
		ModuleOrigin(UserModule),
		module_identity_for_program,
	../src/stage_06_typecheck/bridge: TypecheckGraphRequest, TypecheckImportModule, typecheck_graph
	../src/stage_12_lsp/analysis_cache:
		analysis_cache,
		analysis_cache_diagnostics,
		analysis_cache_lexed,
		analysis_cache_parsed,
		analysis_cache_remove_diagnostics,
		analysis_cache_remove_lexed,
		analysis_cache_remove_typed,
		analysis_cache_remove_typed_for_module,
		analysis_cache_store_diagnostics,
		analysis_cache_store_lexed,
		analysis_cache_store_parsed,
		analysis_cache_store_typed,
		analysis_cache_typed,
		module_analysis_fingerprints_equal,
	../src/stage_12_lsp/analysis_model:
		LexedArtifact,
		ModuleAnalysisFingerprint,
		ModuleSemanticIndex,
		ParseFingerprint,
		TypedArtifact,
		empty_module_semantic_index,
		lexed_artifact,
		lexed_artifact_fingerprint,
		parsed_artifact,
		parsed_artifact_fingerprint,
		typecheck_graph_analysis_context,
		typed_artifact_fingerprint,
		typed_artifact_from_compiler,
	../src/stage_12_lsp/diagnostic_model: Diagnostic, DiagnosticSeverity(ErrorDiagnostic)
	../src/stage_12_lsp/fingerprint_model:
		ContentFingerprint,
		FrontendFingerprint,
		SemanticArtifactId,
		content_fingerprint,
		frontend_fingerprint_from_value,
		semantic_artifact_id_from_value,
	../src/stage_12_lsp/identity: DocumentUri, document_uri
	../src/stage_12_lsp/position: position
	../src/stage_12_lsp/snapshot_model: configuration_epoch
	../src/stage_12_lsp/workspace_model:
		DiscoveredSourceProvenance(DiskSource),
		SourceSnapshot,
		source_snapshot_for_layers,
	../src/stage_12_lsp/workspace_source: discovered_source_layer, source_layers
	test: TestSuite


private SOURCE_URI: String = "file:///workspace/main.brp"


private pure func uri() -> DocumentUri:
	document_uri(SOURCE_URI)


private pure func fingerprint(source: String, frontend: String) -> ParseFingerprint:
	{
		uri = uri(),
		source = content_fingerprint(source),
		frontend = frontend_fingerprint_from_value(frontend)
	}


private pure func selected_source(source: String) -> Option[SourceSnapshot]:
	input = source_file("/workspace/main.brp", "main", source)
	layers = source_layers(uri(), Some(discovered_source_layer(input, DiskSource)), None)
	source_snapshot_for_layers(layers)


private pure func artifact(source: String, frontend: String) -> Option[LexedArtifact]:
	selected ?= selected_source(source)
	Some(lexed_artifact(selected, frontend_fingerprint_from_value(frontend)))


private pure func artifact_fingerprint(artifact: LexedArtifact) -> ParseFingerprint:
	lexed_artifact_fingerprint(artifact)


private pure func module_identity(path: String) -> ModuleIdentity:
	program = parse_compiler_source(source_file(path, "shared", "VALUE = 1\n"))
	module_identity_for_program(program)


private pure func module_fingerprint(
	identity: ModuleIdentity,
	epoch: Int,
) -> Option[ModuleAnalysisFingerprint]:
	module_fingerprint_with_source(identity, epoch, "VALUE = 1\n")


private pure func module_fingerprint_with_source(
	identity: ModuleIdentity,
	epoch: Int,
	source_text: String,
) -> Option[ModuleAnalysisFingerprint]:
	configuration_epoch ?= configuration_epoch(epoch)

	Some({
		module_identity = identity,
		source = content_fingerprint(source_text),
		configuration_epoch = configuration_epoch,
		frontend = frontend_fingerprint_from_value("frontend-v1"),
	})


private pure func cached_diagnostic() -> Diagnostic:
	{
		range = {
			start = position(1, 2),
			end = position(1, 4)
		},
		severity = ErrorDiagnostic,
		code = Some("cache"),
		message = "retained diagnostic"
	}


private pure func typed_artifact_with_context(
	epoch: Int,
	claimed_source: String,
	graph_context: String,
) -> Option[TypedArtifact]:
	configuration_epoch ?= configuration_epoch(epoch)
	path: String = "/workspace/main.brp"
	module_name: String = "main"
	text: String = "VALUE = 1\n"
	target: TypecheckImportModule = {
		path = path,
		module_name = module_name,
		module_path = module_name,
		text = text,
		typecheck_program = None,
		origin = UserModule
	}
	request: TypecheckGraphRequest = {
		target = target,
		modules = [],
		module_targets = [],
		resolved_imports = [],
		include_comments = False,
		allow_debug_only_calls = False
	}
	graph = { typecheck_graph(request) | analysis_context = Some(graph_context) }
	identity = graph.target.module_identity
	fingerprint ?= module_fingerprint_with_source(identity, epoch, claimed_source)
	artifact_id = semantic_artifact_id_from_value("main-artifact")

	match empty_module_semantic_index(identity, artifact_id, uri()):
		Err(_):
			None
		Ok(index):
			typed_artifact_from_compiler(artifact_id, uri(), fingerprint, graph, index)


private pure func typed_artifact_with_claimed_source(
	epoch: Int,
	claimed_source: String,
) -> Option[TypedArtifact]:
	configuration_epoch ?= configuration_epoch(epoch)
	typed_artifact_with_context(
		epoch,
		claimed_source,
		typecheck_graph_analysis_context(
			frontend_fingerprint_from_value("frontend-v1"),
			configuration_epoch,
		),
	)


pure func test_lexed_cache_requires_exact_fingerprint() -> Bool:
	match artifact("VALUE = 1\n", "frontend-v1"):
		None:
			False
		Some(exact):
			cache = analysis_cache_store_lexed(analysis_cache(), exact)
			exact_fingerprint = artifact_fingerprint(exact)

			analysis_cache_lexed(cache, exact_fingerprint).is_some() and analysis_cache_lexed(
				cache,
				fingerprint("VALUE = 2\n", "frontend-v1"),
			).is_none() and analysis_cache_lexed(
				cache,
				fingerprint("VALUE = 1\n", "frontend-v2"),
			).is_none()


private pure func typed_artifact(epoch: Int) -> Option[TypedArtifact]:
	typed_artifact_with_claimed_source(epoch, "VALUE = 1\n")


pure func test_lexed_cache_replacement_invalidates_old_fingerprint() -> Bool:
	match artifact("VALUE = 1\n", "frontend-v1"):
		None:
			False
		Some(first):
			match artifact("VALUE = 2\n", "frontend-v1"):
				None:
					False
				Some(second):
					first_fingerprint = artifact_fingerprint(first)
					second_fingerprint = artifact_fingerprint(second)
					initial = analysis_cache_store_lexed(analysis_cache(), first)
					replaced = analysis_cache_store_lexed(initial, second)
					stale_removal = analysis_cache_remove_lexed(replaced, first_fingerprint)
					exact_removal = analysis_cache_remove_lexed(stale_removal, second_fingerprint)

					(
						analysis_cache_lexed(initial, first_fingerprint).is_some()
						and analysis_cache_lexed(replaced, first_fingerprint).is_none()
						and analysis_cache_lexed(replaced, second_fingerprint).is_some()
						and analysis_cache_lexed(stale_removal, second_fingerprint).is_some()
						and analysis_cache_lexed(exact_removal, second_fingerprint).is_none()
					)


pure func test_parsed_cache_requires_canonical_source_fingerprint() -> Bool:
	match selected_source("VALUE = 1\n"):
		None:
			False
		Some(source):
			artifact = parsed_artifact(source, frontend_fingerprint_from_value("frontend-v1"))
			exact = parsed_artifact_fingerprint(artifact)
			cache = analysis_cache_store_parsed(analysis_cache(), artifact)

			analysis_cache_parsed(cache, exact).is_some() and analysis_cache_parsed(
				cache,
				fingerprint("VALUE = 2\n", "frontend-v1"),
			).is_none()


pure func test_typed_fingerprint_uses_exact_identity_source_and_epoch() -> Bool:
	target = module_identity("/workspace/main.brp")
	other = module_identity("/workspace/other.brp")

	match (
		module_fingerprint(target, 1),
		module_fingerprint(other, 1),
		module_fingerprint_with_source(target, 1, "VALUE = 2\n"),
		module_fingerprint(target, 2),
	):
		(Some(exact), Some(other_identity), Some(other_source), Some(new_epoch)):
			(
				module_analysis_fingerprints_equal(exact, exact)
				and not module_analysis_fingerprints_equal(exact, other_identity)
				and not module_analysis_fingerprints_equal(exact, other_source)
				and not module_analysis_fingerprints_equal(exact, new_epoch)
			)
		_:
			False


private pure func diagnostic_cache_requires_exact_fingerprint_case() -> Option[Bool]:
	typed ?= typed_artifact(1)
	exact = typed_artifact_fingerprint(typed)
	new_epoch ?= module_fingerprint(exact.module_identity, 2)
	diagnostic = cached_diagnostic()
	cache = analysis_cache_store_diagnostics(analysis_cache(), typed, [diagnostic])
	retained ?= analysis_cache_diagnostics(cache, exact)
	retained_diagnostic ?= retained.get(0)
	removed = analysis_cache_remove_diagnostics(cache, exact)

	Some(
		(
			retained.length() == 1
			and retained_diagnostic.message == diagnostic.message
			and analysis_cache_diagnostics(cache, new_epoch).is_none()
			and analysis_cache_diagnostics(removed, exact).is_none()
		),
	)


pure func test_diagnostic_cache_requires_exact_fingerprint_and_supports_removal() -> Bool:
	diagnostic_cache_requires_exact_fingerprint_case().get_or(False)


pure func test_typed_cache_rejects_stale_lookup_and_removal() -> Bool:
	match typed_artifact(1):
		None:
			False
		Some(first):
			match typed_artifact(2):
				None:
					False
				Some(second):
					first_fingerprint = typed_artifact_fingerprint(first)
					second_fingerprint = typed_artifact_fingerprint(second)
					cache = analysis_cache_store_typed(analysis_cache(), second)
					stale_removal = analysis_cache_remove_typed(cache, first_fingerprint)
					exact_removal = analysis_cache_remove_typed(stale_removal, second_fingerprint)

					(
						analysis_cache_typed(cache, first_fingerprint).is_none()
						and analysis_cache_typed(cache, second_fingerprint).is_some()
						and analysis_cache_typed(stale_removal, second_fingerprint).is_some()
						and analysis_cache_typed(exact_removal, second_fingerprint).is_none()
					)


pure func test_typed_cache_can_evict_stale_artifact_by_module_identity() -> Bool:
	match typed_artifact(1):
		None:
			False
		Some(stale):
			fingerprint = typed_artifact_fingerprint(stale)
			cache = analysis_cache_store_typed(analysis_cache(), stale)
			evicted = analysis_cache_remove_typed_for_module(cache, fingerprint.module_identity)

			(
				analysis_cache_typed(cache, fingerprint).is_some()
				and analysis_cache_typed(evicted, fingerprint).is_none()
			)


pure func test_typed_artifact_rejects_mismatched_source_claim() -> Bool:
	typed_artifact_with_claimed_source(1, "VALUE = 2\n").is_none()


pure func test_typed_artifact_rejects_untrusted_compiler_context() -> Bool:
	typed_artifact_with_context(1, "VALUE = 1\n", "wrong-context").is_none()


tests: TestSuite = {
	description = "Compiler LSP analysis cache",
	tests = [
		("require exact lexed fingerprint", test_lexed_cache_requires_exact_fingerprint),
		(
			"replace stale lexed artifact while preserving prior snapshot",
			test_lexed_cache_replacement_invalidates_old_fingerprint,
		),
		(
			"parsed cache requires canonical source fingerprint",
			test_parsed_cache_requires_canonical_source_fingerprint,
		),
		(
			"typed fingerprint uses exact identity source and epoch",
			test_typed_fingerprint_uses_exact_identity_source_and_epoch,
		),
		(
			"diagnostic cache requires exact fingerprint and supports removal",
			test_diagnostic_cache_requires_exact_fingerprint_and_supports_removal,
		),
		(
			"typed cache rejects stale lookup and removal",
			test_typed_cache_rejects_stale_lookup_and_removal,
		),
		(
			"typed artifact rejects mismatched source claim",
			test_typed_artifact_rejects_mismatched_source_claim,
		),
		(
			"typed artifact rejects untrusted compiler context",
			test_typed_artifact_rejects_untrusted_compiler_context,
		),
		(
			"typed cache can evict stale artifact by module identity",
			test_typed_cache_can_evict_stale_artifact_by_module_identity,
		),
	]
}
