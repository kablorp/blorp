func test_provisional_local_aliases_retain_env_authority() -> Bool:
	source_program = program([
		type_alias_decl("UserId", False),
		type_alias_decl("SecretId", True),
		generic_type_alias_decl("Wrapped", "T", named_type("T")),
	])
	provisional = typecheck_test_install_validated_type_headers(
		typecheck_prescan_program(
			typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
			source_program,
		),
		source_program,
	)

	(
		provisional.errors.is_empty()
		and env_get_alias(provisional.env, "UserId").is_some()
		and env_get_alias(provisional.env, "Wrapped").is_some()
		and env_get_opaque_alias(provisional.env, "SecretId").is_some()
	)


func test_accepted_transparent_aliases_replace_env_authority() -> Bool:
	accepted = typecheck_test_program(typecheck_state_for_origin(TYPECHECK_USER_ORIGIN), program([
			type_alias_decl("UserId", False),
			generic_type_alias_decl("Wrapped", "T", named_type("T")),
		]))
	user_id = accepted_transparent_alias_target(accepted.state, "UserId")
	wrapped = accepted_transparent_alias_target(accepted.state, "Wrapped")

	(
		accepted.state.errors.is_empty()
		and env_get_alias(accepted.state.env, "UserId").is_none()
		and env_get_alias(accepted.state.env, "Wrapped").is_none()
		and user_id.map(func(target): types_equal(target, TYPE_INT)) == Some(True)
		and wrapped.map(func(target): types_equal(target, SemanticTypeVar("T"))) == Some(True)
	)


func test_accepted_opaque_alias_replaces_env_authority() -> Bool:
	accepted = typecheck_test_program(
