		typecheck_test_install_validated_type_headers(
			typecheck_prescan_program(
				typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				source_program,
			),
			source_program,
		),
		source_program,
	)
	result = typecheck_materialize_standalone_program_bodies(base_state, source_program)

	match (result.program.decls.get(0), result.program.decls.get(1)):
		(Some(TypedFunctionDecl(first)), Some(TypedFunctionDecl(second))):
			callables_ok = match (first.callable_id, second.callable_id):
				(Some(first_id), Some(second_id)):
					first_id != second_id
				_:
					False

			result.state.errors.length() == 0 and callables_ok and types_equal(
				first.param_types.get_or(0, TYPE_VOID),
