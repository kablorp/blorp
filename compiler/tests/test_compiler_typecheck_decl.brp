func test_materialize_program_bodies_carries_typed_decl_shapes() -> Bool:
	source_program = program([
		record_with_fields_decl("Widget", [int_type()]),
		union_decl_with_variant_fields("Choice", "First", [int_type()]),
		type_alias_decl("WidgetId", False),
		trait_decl_with_methods(
			"Display",
			[],
			[],
			[
				trait_method_decl(
					"display",
					[named_param("value", named_type("Widget"))],
					Some(int_type()),
					False,
					False,
				),
			],
		),
		impl_decl_with_methods_at(
			"Display",
			named_type("Widget"),
			[
				method_body_decl_at(
					"display",
					[named_param("value", named_type("Widget"))],
					Some(int_type()),
					Some(int_expr()),
					2,
				),
			],
			3,
		),
		PrivateParsedDecl(
			type_alias_decl("PrivateId", False),
			fixture_source_span(),
		),
	])
	with_types = typecheck_test_install_validated_type_headers(
		typecheck_prescan_program(
			typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
			source_program,
		),
		source_program,
	)
	with_signatures = typecheck_register_program_signature_decls(with_types, source_program)
	base_state = typecheck_register_program_impl_decls(with_signatures, source_program)
	result = typecheck_materialize_standalone_program_bodies(base_state, source_program)

	record_ok = match result.program.decls.get(0):
		Some(TypedRecordDecl(info)):
			field_ok = match info.fields.get(0):
				Some(field):
					(
						field.name == "field"
						and types_equal(field.source_type, TYPE_INT)
						and types_equal(field.semantic_type, TYPE_INT)
					)
				None:
					False

			info.decl.name.text == "Widget" and info.fields.length() == 1 and field_ok
		_:
			False

	union_ok = match result.program.decls.get(1):
		Some(TypedUnionDecl(info)):
			match info.variants.get(0):
				Some(variant):
					match variant.fields.get(0):
						Some(field):
							(
								info.decl.name.text == "Choice"
								and info.variants.length() == 1
								and variant.name == "First"
								and variant.tag == 0
								and variant.def_id.is_some()
								and types_equal(field, TYPE_INT)
							)
						None:
							False
				None:
					False
		_:
			False

	alias_ok = match result.program.decls.get(2):
		Some(TypedTypeAliasDecl(info)):
			(
				info.decl.name.text == "WidgetId"
				and types_equal(info.source_target_type, TYPE_INT)
				and types_equal(info.semantic_target_type, TYPE_INT)
			)
		_:
			False

	trait_ok = match result.program.decls.get(3):
		Some(TypedTraitDecl(info)):
			match info.methods.get(0):
				Some(method):
					(
						info.decl.name.text == "Display"
						and method.decl.name.text == "display"
						and method.param_types.length() == 1
						and types_equal(
							method.param_types.get_or(0, TYPE_VOID),
							SemanticNamedType("Widget", []),
						)
						and types_equal(method.semantic_return_type, TYPE_INT)
					)
				None:
					False
		_:
			False

	impl_ok = match result.program.decls.get(4):
		Some(TypedImplDecl(info)):
			method_ok = match info.methods.get(0):
				Some(method_info):
					source_return_ok = match method_info.source_return_type:
						Some(return_type):
							types_equal(return_type, TYPE_INT)
						None:
							False

					(
						method_info.decl.name.text == "display"
						and source_return_ok
						and types_equal(method_info.semantic_return_type, TYPE_INT)
						and method_info.body.is_some()
					)
				None:
					False

			info.decl.trait_name.text == "Display" and info.methods.length() == 1 and method_ok
		_:
			False

	private_ok = match result.program.decls.get(5):
		Some(TypedPrivateDecl(TypedTypeAliasDecl(info))):
			info.decl.name.text == "PrivateId"
		_:
			False

	(
		result.state.errors.length() == 0
		and result.program.decls.length() == 6
		and record_ok
		and union_ok
		and alias_ok
		and trait_ok
		and impl_ok
		and private_ok
	)


func test_typecheck_program_runs_full_decl_pipeline() -> Bool:
	source_program = program([
		record_with_fields_decl("Widget", [int_type()]),
		trait_decl_with_methods(
			"Display",
			[],
			[],
			[
				trait_method_decl(
					"display",
					[named_param("value", named_type("Widget"))],
					Some(int_type()),
					False,
					False,
				),
			],
		),
		impl_decl_with_methods_at(
			"Display",
			named_type("Widget"),
			[
				method_body_decl_at(
					"display",
					[named_param("value", named_type("Widget"))],
					Some(int_type()),
					Some(int_expr()),
					2,
				),
			],
			3,
		),
		function_body_decl(
			"identity",
			[named_param("value", int_type())],
			Some(int_type()),
			Some(decl_name_expr("value")),
		),
		var_body_decl("answer", Some(int_type()), int_expr()),
	])
	base_state = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN)
	result = typecheck_test_program(base_state, source_program)

	record_ok = match result.program.decls.get(0):
		Some(TypedRecordDecl(info)):
			info.decl.name.text == "Widget" and info.fields.length() == 1
		_:
			False

	impl_ok = match result.program.decls.get(2):
		Some(TypedImplDecl(info)):
			info.decl.trait_name.text == "Display" and info.methods.length() == 1
		_:
			False

	function_ok = match result.program.decls.get(3):
		Some(TypedFunctionDecl(info)):
			body_ok = match info.body:
				Some(body):
					types_equal(typed_expr_semantic_type(body), TYPE_INT)
				None:
					False

			info.decl.name.text == "identity" and info.param_types.length() == 1 and body_ok
		_:
			False

	global_ok = match result.program.decls.get(4):
		Some(TypedGlobalVarDecl(info)):
			info.decl.name.text == "answer" and types_equal(info.binding_type, TYPE_INT)
		_:
			False

	(
		result.state.errors.length() == 0
		and result.state.env.impls.length() == base_state.env.impls.length() + 1
		and result.program.source.module_name == "decl"
		and result.program.diagnostics.length() == 0
		and result.program.decls.length() == 5
		and typecheck_state_find_top_level_name(result.state, "Display") == Some(TopLevelTrait)
		and record_ok
		and impl_ok
		and function_ok
		and global_ok
	)


func test_validate_typed_program_rejects_unfinalized_meta() -> Bool:
	source_decl = record_with_fields_decl("Broken", [int_type()])

	match source_decl:
		RecordParsedDecl(record_decl):
			typed_field: TypedRecordFieldInfo = {
				name = "field",
				source_type = SemanticMetaType(7),
				semantic_type = TYPE_INT,
				definition_id = None,
				declaration_span = fixture_source_span(),
				selection_span = fixture_source_span()
			}
			typed_record: TypedRecordInfo = {
				decl = record_decl,
				fields = [typed_field]
			}
			typed_program: TypedProgram = {
				source = fixture_source_file(),
				decls = [TypedRecordDecl(typed_record)],
				diagnostics = [],
				type_definitions = [],
				type_references = []
			}
			result: TypecheckProgramResult = typecheck_validate_typed_program({
				state = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				program = typed_program,
			})

			(
				result.state.errors.length() == 1
				and result.state.errors
					.get_or(0, "")
					.contains((
							"typed program contains unfinalized inference meta in record 'Broken' field "
							+ "'field' source type"
						))
			)
		_:
			False


