func test_materialize_program_bodies_carries_typed_function_and_global() -> Bool:
	source_program = program([
		function_body_decl(
			"identity",
			[named_param("value", int_type())],
			Some(int_type()),
			Some(decl_name_expr("value")),
		),
		var_body_decl("answer", Some(int_type()), int_expr()),
	])
	base_state = typecheck_register_program_signature_decls(
		typecheck_test_install_validated_type_headers(
			typecheck_prescan_program(
				typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				source_program,
			),
			source_program,
		),
		source_program,
	)
	result = typecheck_materialize_standalone_program_bodies(base_state, source_program)

	function_ok = match result.program.decls.get(0):
		Some(TypedFunctionDecl(info)):
			param_ok = match info.param_types.get(0):
				Some(param_type):
					types_equal(param_type, TYPE_INT)
				None:
					False

			source_return_ok = match info.source_return_type:
				Some(return_type):
					types_equal(return_type, TYPE_INT)
				None:
					False

			semantic_return_ok = types_equal(info.semantic_return_type, TYPE_INT)

			body_ok = match info.body:
				Some(body):
					types_equal(typed_expr_semantic_type(body), TYPE_INT)
				None:
					False

			(
				info.decl.name.text == "identity"
				and param_ok
				and source_return_ok
				and semantic_return_ok
				and body_ok
			)
		_:
			False

	global_ok = match result.program.decls.get(1):
		Some(TypedGlobalVarDecl(info)):
			source_ok = match info.source_type:
				Some(source_type):
					types_equal(source_type, TYPE_INT)
				None:
					False

			(
				info.decl.name.text == "answer"
				and types_equal(info.binding_type, TYPE_INT)
				and source_ok
			)
		_:
			False

	(
		result.state.errors.length() == 0
		and result.program.decls.length() == 2
		and function_ok
		and global_ok
	)


func test_materialize_program_bodies_preserves_global_source_alias() -> Bool:
	source_program = program([
		type_alias_decl_with_target("IntAlias", int_type()),
		var_body_decl("answer", Some(named_type("IntAlias")), int_expr()),
	])
	base_state = typecheck_register_program_signature_decls(
		typecheck_test_install_validated_type_headers(
			typecheck_prescan_program(
				typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				source_program,
			),
			source_program,
		),
		source_program,
	)
	result = typecheck_materialize_standalone_program_bodies(base_state, source_program)
	expected_source_type = SemanticNamedType("IntAlias", [])

	global_ok = match result.program.decls.get(1):
		Some(TypedGlobalVarDecl(info)):
			source_ok = match info.source_type:
				Some(source_type):
					types_equal(source_type, expected_source_type)
				None:
					False

			(
				info.decl.name.text == "answer"
				and source_ok
				and types_equal(info.binding_type, TYPE_INT)
				and types_equal(typed_expr_value_type(info.value), TYPE_INT)
			)
		_:
			False

	result.state.errors.length() == 0 and result.program.decls.length() == 2 and global_ok


func test_materialize_program_bodies_preserves_implicit_type_params() -> Bool:
	source_program = program(
		[
			function_body_decl(
				"identity",
				[named_param("value", named_type("T"))],
				Some(named_type("T")),
				Some(decl_name_expr("value")),
			),
		],
	)
	base_state = typecheck_register_program_signature_decls(
		typecheck_test_install_validated_type_headers(
			typecheck_prescan_program(
				typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				source_program,
			),
			source_program,
		),
		source_program,
	)
	result = typecheck_materialize_standalone_program_bodies(base_state, source_program)

	match result.program.decls.get(0):
		Some(TypedFunctionDecl(info)):
			expected = SemanticTypeVar("T")

			body_ok = match info.body:
				Some(body):
					(
						types_equal(typed_expr_semantic_type(body), expected)
						and types_equal(typed_expr_value_type(body), expected)
					)
				None:
					False

			(
				result.state.errors.length() == 0
				and info.decl.type_params.length() == 0
				and info.effective_type_params.map(func(param): param.name) == ["T"]
				and info.param_types.length() == 1
				and types_equal(
					info.param_types.get_or(0, TYPE_VOID),
					expected,
				)
				and types_equal(info.semantic_return_type, expected)
				and body_ok
			)
		_:
			False


func test_materialize_program_bodies_reuses_registered_function_signature() -> Bool:
	registered_program = program(
		[
			function_body_decl(
				"identity",
				[named_param("value", int_type())],
				Some(int_type()),
				Some(decl_name_expr("value")),
			),
		],
	)
	materialized_program = program(
		[
			function_body_decl(
				"identity",
				[named_param("value", string_type())],
				Some(string_type()),
				Some(decl_name_expr("value")),
			),
		],
	)
	base_state = typecheck_register_program_signature_decls(
		typecheck_test_install_validated_type_headers(
			typecheck_prescan_program(
				typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				registered_program,
			),
			registered_program,
		),
		registered_program,
	)
	result = typecheck_materialize_standalone_program_bodies(base_state, materialized_program)

	match result.program.decls.get(0):
		Some(TypedFunctionDecl(info)):
			source_return_ok = match info.source_return_type:
				Some(return_type):
					types_equal(return_type, TYPE_STRING)
				None:
					False

			body_ok = match info.body:
				Some(body):
					types_equal(typed_expr_semantic_type(body), TYPE_INT)
				None:
					False

			result.state.errors.length() == 0 and info.param_types.length() == 1 and types_equal(
				info.param_types.get_or(0, TYPE_VOID),
				TYPE_INT,
			) and source_return_ok and types_equal(info.semantic_return_type, TYPE_INT) and body_ok
		_:
			False


func test_materialize_program_bodies_selects_exact_overload_signature() -> Bool:
