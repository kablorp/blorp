			),
			source_program,
		),
		source_program,
	)
	result = typecheck_materialize_standalone_program_bodies(base_state, source_program)

	match result.program.decls.get(2):
		Some(TypedFunctionDecl(info)):
			source_return_ok = match info.source_return_type:
				Some(return_type):
					types_equal(
						return_type,
						SemanticNamedType("IntThunk", []),
					)
				None:
					False

			expected_semantic = SemanticFunctionType(True, [], TYPE_INT)

			body_ok = match info.body:
				Some(body):
					types_equal(typed_expr_semantic_type(body), expected_semantic)
				None:
