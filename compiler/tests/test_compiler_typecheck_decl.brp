				decl_void_expr(),
			])))])
	state = typecheck_check_standalone_program_bodies(
		typecheck_register_program_signature_decls(
			typecheck_test_install_validated_type_headers(
				typecheck_prescan_program(
					typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)

	(
		state.errors.length() == 1
		and state.errors
			.get_or(0, "")
			.contains("debug: blocks cannot assign")
	)


