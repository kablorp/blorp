			(
				result.state.errors.length() == 0
				and source_return_ok
				and types_equal(info.semantic_return_type, expected_semantic)
				and body_ok
			)
		_:
			False


func test_materialize_program_bodies_canonicalizes_compatible_declared_return() -> Bool:
