func test_materialize_program_bodies_resolves_function_alias_return_metadata() -> Bool:
	source_program = program([
		generic_type_alias_decl(
			"Thunk",
			"T",
			function_type(True, [], named_type("T")),
		),
		type_alias_decl_with_target(
			"IntThunk",
			generic_named_type("Thunk", [int_type()]),
		),
		function_body_decl_with_purity(
			"make",
			[],
			Some(named_type("IntThunk")),
			Some(decl_lambda_expr(True, int_expr())),
			True,
		),
	])
	base_state = typecheck_register_program_signature_decls(
		typecheck_test_install_validated_type_headers(
			typecheck_prescan_program(
				typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
