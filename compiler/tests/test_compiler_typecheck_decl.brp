			source_program,
		),
		source_program,
	)
	result = typecheck_materialize_standalone_program_bodies(base_state, source_program)
	expected_type = SemanticArrayType(TYPE_FLOAT, [SemanticVarDimsType("#Ds")])

	match result.program.decls.get(0):
		Some(TypedFunctionDecl(info)):
			match info.body:
				Some(body):
					(
						result.state.errors.length() == 0
						and info.effective_type_params.map(func(param): param.name) == ["#N"]
