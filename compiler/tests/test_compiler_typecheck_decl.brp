func test_check_global_var_bodies_validate_and_refine_registered_types() -> Bool:
	source_program = program([
		var_body_decl("answer", Some(int_type()), int_expr()),
		var_body_decl("bad", Some(bool_type()), decl_string_expr()),
		var_body_decl("inferred", None, decl_string_expr()),
	])
	state = typecheck_check_standalone_program_bodies(
		typecheck_register_program_signature_decls(
			typecheck_test_install_validated_type_headers(
				typecheck_prescan_program(
					typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)

	match (
		env_get_var_type(state.env, "inferred"),
		env_get_module_var_symbol(state.env, "decl", "inferred"),
	):
		(Some(inferred_type), Some(module_var)):
			(
				state.errors.length() == 1
				and state.errors
					.get_or(0, "")
					.contains("Global variable 'bad' has wrong type")
				and types_equal(inferred_type, TYPE_STRING)
				and types_equal(module_var.var_type, TYPE_STRING)
			)
		_:
			False


