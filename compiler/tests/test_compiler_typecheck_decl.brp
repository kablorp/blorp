func test_import_modules_preserve_tensor_loop_producer() -> Bool:
	vector_type = ParsedArrayType(
		int_type(),
		[ParsedDimLiteralType("4", fixture_source_span())],
		fixture_source_span(),
	)
	module_decls = [
		function_body_decl_with_purity(
			"windows",
			[named_param("values", vector_type), named_param("size", int_type())],
			Some(ParsedNamedType(ident("List"), [int_type()], fixture_source_span())),
			Some(
				ParsedBlockExpr(
					[ParsedBuiltinExpr(Some("std/tensor.windows"), fixture_source_span())],
					fixture_source_span(),
				),
			),
			True,
		),
	]
	source_program = program(
		[
			import_block_decl(
				[import_decl("tensor", None, Some([import_symbol("windows", None, [])]))],
			),
		],
	)
	result = typecheck_test_program_with_import_modules(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		source_program,
		importable_modules_with_origin("tensor", module_decls, StdlibModule),
	)

	match env_get_module_func_symbol(result.state.env, "tensor", "windows"):
		Some(symbol):
			match symbol.loop_producer:
				Some(producer):
					result.state.errors.length() == 0 and loop_producer_is_windows(producer)
				None:
					False
		None:
			False


