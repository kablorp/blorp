func test_check_mutable_global_initializer_reports_call_then_subscript() -> Bool:
	source_program = program([
		function_body_decl("compute", [], Some(int_type()), Some(int_expr())),
		mutable_var_body_decl(
			"value",
			None,
			decl_add_expr(
				decl_call_expr("compute", []),
				decl_subscript_expr(decl_vector_expr([int_expr(), int_expr()]), [int_expr()]),
			),
		),
	])
	state = typecheck_check_standalone_program_bodies(
		typecheck_register_program_signature_decls(
			typecheck_test_install_validated_type_headers(
				typecheck_prescan_program(
					typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)

	(
		state.errors.length() == 2
		and state.errors
			.get_or(0, "")
			.contains("top-level initializer 'value' cannot call function 'compute'")
		and state.errors
			.get_or(1, "")
			.contains("top-level initializer 'value' cannot use a subscript expression")
	)


