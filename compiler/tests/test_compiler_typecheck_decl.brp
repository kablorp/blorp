func test_registers_global_var_and_foreign_function_signature() -> Bool:
	source_program = program([
		var_decl("answer"),
		foreign_block_decl("native_hash"),
		function_signature_decl("unknown_return", [], None, False, []),
	])
	state = typecheck_register_program_signature_decls(
		typecheck_prescan_program(
			typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
			source_program,
		),
		source_program,
	)

	match (
		env_get_var_type(state.env, "answer"),
		env_get_module_var_symbol(state.env, "decl", "answer"),
		env_lookup(state.env, "native_hash"),
		env_get_func_info(state.env, "unknown_return"),
	):
		(Some(var_type), Some(module_var), Some(symbol), Some((unknown_return_type, _, unknown_purity))):
			match symbol.kind:
				FuncSymbolKind(info):
					(
						types_equal(var_type, TYPE_INT)
						and types_equal(module_var.var_type, TYPE_INT)
						and types_equal(
							info.func_type,
							SemanticFunctionType(False, [], TYPE_INT),
						)
						and info.origin == ForeignFunc
						and info.purity == Impure
						and types_equal(
							unknown_return_type,
							SemanticFunctionType(False, [], TYPE_VOID),
						)
						and unknown_purity == Impure
					)
				_:
					False
		_:
			False


func test_rejects_foreign_signatures_for_non_foreign_origins() -> Bool:
	source_program = program([foreign_block_decl("native_hash")])
	source_package_state = typecheck_register_program_signature_decls(
		typecheck_prescan_program(
			typecheck_state_for_origin(SourcePackageModule("pkg/demo")),
			source_program,
		),
		source_program,
	)
	std_state = typecheck_register_program_signature_decls(
		typecheck_prescan_program(
			typecheck_state_for_origin(TYPECHECK_STDLIB_ORIGIN),
			source_program,
		),
		source_program,
	)

	(
		source_package_state.errors.length() == 1
		and source_package_state.errors
			.get_or(0, "")
			.contains("source packages")
		and env_get_func_info(source_package_state.env, "native_hash").is_some()
		and std_state.errors.length() == 1
		and std_state.errors
			.get_or(0, "")
			.contains("standard library")
		and env_get_func_info(std_state.env, "native_hash").is_some()
	)


func test_registers_trait_definition_and_method_bindings() -> Bool:
	source_program = program([
		trait_decl_with_methods(
			"Base",
			[],
			[],
			[
				trait_method_decl(
					"base",
					[named_param("value", int_type())],
					Some(string_type()),
					True,
					False,
				),
			],
		),
		trait_decl_with_methods(
			"Display",
			[type_param("T")],
			["Base"],
			[
				trait_method_decl(
					"display",
					[named_param("item", string_type())],
					Some(string_type()),
					False,
					True,
				),
			],
		),
	])
	state = typecheck_register_program_signature_decls(
		typecheck_prescan_program(
			typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
			source_program,
		),
		source_program,
	)

	match (
		env_get_trait(state.env, "Display"),
		env_get_function_trait(state.env, "base"),
		env_get_function_trait(state.env, "display"),
	):
		(Some(trait_def), Some(base_trait), Some(display_trait)):
			method_ok: Bool = match trait_def.methods.get(0):
				Some(method):
					param_name_ok: Bool = match method.param_names.get(0):
						Some(Some(param_name)):
							param_name == "item"
						_:
							False

					method.name == "display" and types_equal(
						method.params.get_or(0, TYPE_VOID),
						TYPE_STRING,
					) and types_equal(
						method.return_type,
						TYPE_STRING,
					) and not method.is_pure and method.has_default and param_name_ok
				None:
					False

			type_param_ok: Bool = match trait_def.type_params.get(0):
				Some(name):
					name == "T"
				None:
					False

			(
				trait_def.supertraits == ["Base"]
				and trait_def.type_params.length() == 1
				and type_param_ok
				and method_ok
				and base_trait == "Base"
				and display_trait == "Display"
			)
		_:
			False


func test_materializes_foreign_block_as_typed_functions() -> Bool:
	result = typecheck_test_program(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		program([foreign_block_with_metadata_decl()]),
	)

	match (result.program.decls.get(0), result.program.decls.get(1)):
		(Some(TypedForeignFunctionDecl(first)), Some(TypedForeignFunctionDecl(second))):
			(
				result.state.errors.length() == 0
				and first.decl.name.text == "mutate"
				and first.c_name == "native_mutate"
				and first.includes == ["native.h"]
				and first.link_flags.length() == 1
				and first.link_flags.get_or(
					0,
					{
						platform = None,
						flag = ""
					},
				).platform.map(typed_foreign_link_platform_to_string) == Some("linux")
				and first.link_flags.get_or(
					0,
					{
						platform = None,
						flag = ""
					},
				).flag == "-ldl"
				and first.arg_passing == TypedForeignDefaultArgs
				and second.c_name == "inspect"
				and second.arg_passing == TypedForeignBorrowArgs
			)
		_:
			False


func test_trait_registration_reports_method_collisions_and_missing_param_types() -> Bool:
	source_program = program([
		trait_decl_with_methods(
			"One",
			[],
			[],
			[
				trait_method_decl(
					"same",
					[named_param("value", int_type())],
					Some(int_type()),
					True,
					False,
				),
			],
		),
		trait_decl_with_methods(
			"Two",
			[],
			[],
			[
				trait_method_decl(
					"same",
					[untyped_named_param("missing")],
					Some(int_type()),
					True,
					False,
				),
			],
		),
	])
	state = typecheck_register_program_signature_decls(
		typecheck_prescan_program(
			typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
			source_program,
		),
		source_program,
	)

	(
		state.errors.length() == 2
		and state.errors
			.get_or(0, "")
			.contains("parameter 'missing' must have an explicit type")
		and state.errors
			.get_or(1, "")
			.contains("method 'same' is already registered under trait 'One'")
	)


