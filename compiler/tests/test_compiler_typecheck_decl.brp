		and env_type_contains_resource_if_valid(state.env, "ReaderBox") == Some(True)
		and typecheck_state_has_known_resource_type_name(state, "Reader")
		and find_resource_cleanup(state.context, "Reader") == Some("blorp_reader_close")
		and user_state.errors.length() == 1
