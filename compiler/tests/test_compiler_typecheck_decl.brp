		and env_get_opaque_alias(accepted.state.env, "SecretId").is_none()
		and secret_id.map(func(target): types_equal(target, TYPE_INT)) == Some(True)
	)


func test_accepted_bodies_use_local_generic_and_opaque_alias_authority() -> Bool:
	result = typecheck_test_program(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		parsed_program_source(
			"local_alias_body",
			"type alias Wrapped[T] = T\nopaque type SecretId = Int\n\npure func unwrap(value: Wrapped[Int]) -> Int: value\n\npure func roundtrip(value: Int) -> Int:\n\tid: SecretId = into_opaque SecretId(value)\n\tfrom_opaque SecretId(id)",
		),
	)

	(
		result.state.errors.is_empty()
		and env_get_alias(result.state.env, "Wrapped").is_none()
		and env_get_opaque_alias(result.state.env, "SecretId").is_none()
	)


func test_accepted_imported_aliases_preserve_generic_and_opaque_semantics() -> Bool:
	dependency = parsed_program_source(
		"aliases",
		"type alias Wrapped[T] = T\nopaque type SecretId = Int",
	)
	target = parsed_program_source(
		"imported_alias_body",
		"import:\n\taliases: Wrapped, SecretId\n\npure func unwrap(value: Wrapped[Int]) -> Int: value\n\npure func illegal(value: Int) -> SecretId:\n\tinto_opaque SecretId(value)",
	)
	result = typecheck_test_program_with_import_modules(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		target,
		importable_modules("aliases", dependency.decls),
	)
	canonical_secret = canonical_module_type_name("aliases", "SecretId")

	(
		result.state.errors.length() == 1
		and result.state.errors
			.get_or(0, "")
			.contains("can only use into_opaque/from_opaque conversions in its defining module")
		and env_get_alias(result.state.env, "Wrapped").is_none()
		and env_get_alias(result.state.env, "SecretId").is_none()
		and accepted_opaque_alias_target(result.state, canonical_secret).is_some()
	)


func test_import_modules_register_canonical_signature_types() -> Bool:
	module_decls = [
		record_with_fields_decl("Token", [int_type()]),
		function_body_decl_with_purity(
			"make_token",
			[],
			Some(named_type("Token")),
			Some(int_expr()),
			True,
		),
		function_body_decl_with_purity(
			"use_token",
			[named_param("token", named_type("Token"))],
			Some(named_type("Token")),
			Some(decl_name_expr("token")),
			True,
		),
		var_body_decl(
			"default_token",
			Some(named_type("Token")),
			decl_record_expr([decl_record_field("field", int_expr())]),
		),
	]
	source_program = program([import_block_decl([import_decl("model", None, Some([
					import_symbol("Token", None, []),
					import_symbol("make_token", None, []),
					import_symbol("use_token", None, []),
					import_symbol("default_token", None, []),
				]))])])
	result = typecheck_test_program_with_import_modules(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		source_program,
		importable_modules("model", module_decls),
	)
	canonical_token = canonical_module_type_name("model", "Token")
	expected_token = SemanticNamedType(canonical_token, [])

	match (
		env_get_func_info(result.state.env, "make_token"),
		env_get_func_info(result.state.env, "use_token"),
		env_get_var_type(result.state.env, "default_token"),
	):
		(Some((make_type, _, _)), Some((use_type, _, _)), Some(var_type)):
			result.state.errors.length() == 0 and types_equal(
				make_type,
				SemanticFunctionType(True, [], expected_token),
			) and types_equal(
				use_type,
				SemanticFunctionType(True, [expected_token], expected_token),
			) and types_equal(var_type, expected_token)
		_:
			False


