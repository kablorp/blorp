		source_program,
	)
	user_program = program([builtin_type_decl("Handle", False)])
	user_state = typecheck_test_install_validated_type_headers(
		typecheck_prescan_program(typecheck_state_for_origin(TYPECHECK_USER_ORIGIN), user_program),
		user_program,
