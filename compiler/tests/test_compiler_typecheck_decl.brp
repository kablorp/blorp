pure func test_direct_definition_ids_are_recorded_in_the_index() -> Bool:
	source_program = program([
		function_body_decl("render", [], Some(int_type()), Some(int_expr())),
		union_decl("Signal", ["Ready"]),
		trait_decl("Measure"),
		impl_decl_with_methods_at("Measure", int_type(), [], 1),
	])
	result = typecheck_test_program(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		source_program,
	)

	(
		result.state.errors.length() == 0
		and typecheck_state_func_callable_bindings(result.state, "render").length() == 1
		and typecheck_state_source_definition_bindings_for_name(result.state, "Ready").length() == 1
		and typecheck_state_source_definition_bindings_for_name(
			result.state,
			"Measure",
		).length() == 2
	)


pure func test_direct_import_constructor_ids_are_recorded_for_the_imported_module() -> Bool:
	source_program = program(
		[
			import_block_decl(
				[
					import_decl(
						"signals",
						None,
						Some([import_symbol("Signal", None, ["Ready"])]),
					),
				],
			),
		],
	)
	result = typecheck_test_program_with_import_modules(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		source_program,
		importable_modules("signals", [union_decl("Signal", ["Ready"])]),
	)

	match typecheck_state_source_definition_bindings_for_name(result.state, "Ready").get(0):
		None:
			False
		Some(binding):
			(
				result.state.errors.length() == 0
				and module_identity_display_name(
					source_definition_key_module_identity(binding[0]),
				) == "signals"
				and env_get_constructor(result.state.env, "Ready").is_some()
			)


pure func test_imported_module_prescan_keeps_target_name_index_isolated() -> Bool:
	source_program = program_for_module(
		"app",
		[
			import_block_decl(
				[import_decl("dep", None, Some([import_symbol("answer", None, [])]))],
			),
			function_body_decl("shared", [], Some(int_type()), Some(int_expr())),
		],
	)
	result = typecheck_test_program_with_import_modules(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		source_program,
		importable_modules(
			"dep",
			[
				import_block_decl(
					[import_decl("other", None, Some([import_symbol("shared", None, [])]))],
				),
				function_body_decl("answer", [], Some(int_type()), Some(int_expr())),
			],
		).concat(
			importable_modules(
				"other",
				[function_body_decl("shared", [], Some(int_type()), Some(int_expr()))],
			),
		),
	)
	answer_binding = typecheck_state_func_callable_bindings(result.state, "answer").get(0)
	shared_bindings = typecheck_state_func_callable_bindings(result.state, "shared")

	match answer_binding:
		None:
			False
		Some(binding):
			(
				result.state.errors.length() == 0
				and shared_bindings.length() == 2
				and typecheck_state_find_top_level_name(
					result.state,
					"shared",
				) == Some(TopLevelFunction)
				and typecheck_state_find_top_level_name(result.state, "answer").is_none()
				and typecheck_state_find_imported_name(
					result.state,
					"answer",
				).map(
					func(imported): imported.module_path,
				) == Some("dep")
				and module_identity_display_name(
					func_callable_key_module_identity(binding[0]),
				) == "dep"
				and shared_bindings.any(
					func(
						shared,
					): module_identity_display_name(
						func_callable_key_module_identity(shared[0]),
					) == "app",
				)
				and shared_bindings.any(
					func(
						shared,
					): module_identity_display_name(
						func_callable_key_module_identity(shared[0]),
					) == "other",
				)
			)


pure func test_graph_owned_headers_keep_import_scope_compatible() -> Bool:
	target_program = program_for_module(
		"app",
		[import_block_decl([import_decl("dep", None, Some([import_symbol("second", None, [])]))])],
	)
	result = typecheck_test_program_with_import_modules(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		target_program,
		importable_modules(
			"dep",
			[function_body_decl("second", [], Some(int_type()), Some(int_expr()))],
		),
	)

	result.state.errors.is_empty() and env_lookup(result.state.env, "second").is_some()


