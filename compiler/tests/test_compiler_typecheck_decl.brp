func test_import_modules_resolve_import_aliases_to_loaded_module_path() -> Bool:
	module_decls = [
		RecordParsedDecl({
			name = ident("Cursor"),
			type_params = [],
			fields = [
				field_decl("offset", int_type()),
				field_decl("line", int_type()),
				field_decl("column", int_type()),
			],
			is_struct = False,
			doc = None,
			span = fixture_source_span(),
		}),
		function_body_decl_with_purity(
			"make_span",
			[
				named_param("start", named_type("Cursor")),
				named_param("finish", named_type("Cursor")),
			],
			Some(named_type("Cursor")),
			Some(decl_name_expr("start")),
			True,
		),
	]
	source_program = program([
		import_block_decl([import_decl("parser", None, Some([
					import_symbol("Cursor", None, []),
					import_symbol("make_span", None, []),
				]))]),
		function_body_decl_with_purity(
			"identity_cursor",
			[named_param("cursor", named_type("Cursor"))],
			Some(named_type("Cursor")),
			Some(
				decl_call_expr(
					"make_span",
					[decl_name_expr("cursor"), decl_name_expr("cursor")],
				),
			),
			True,
		),
		function_body_decl_with_purity(
			"literal_cursor",
			[],
			Some(named_type("Cursor")),
			Some(decl_record_expr([
				decl_record_field("offset", int_expr()),
				decl_record_field("line", int_expr()),
				decl_record_field("column", int_expr()),
			])),
			True,
		),
		RecordParsedDecl({
			name = ident("CursorBox"),
			type_params = [],
			fields = [field_decl("cursor", named_type("Cursor"))],
			is_struct = False,
			doc = None,
			span = fixture_source_span(),
		}),
		function_body_decl_with_purity(
			"box_cursor",
			[named_param("cursor", named_type("Cursor"))],
			Some(named_type("CursorBox")),
			Some(decl_record_expr([decl_record_field("cursor", decl_name_expr("cursor"))])),
			True,
		),
	])
	result = typecheck_test_program_with_import_modules(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		source_program,
		importable_modules("std/parser", module_decls),
	)
	canonical_cursor = canonical_module_type_name("std/parser", "Cursor")

	match (
		accepted_transparent_alias_target(result.state, "Cursor"),
		env_get_record(result.state.env, "CursorBox"),
	):
		(Some(SemanticNamedType(alias_target, _)), Some((_, fields))):
			match fields.get(0):
				Some(field):
					match field.field_type:
						SemanticNamedType(field_type_name, _):
							(
								result.state.errors.length() == 0
								and env_get_alias(result.state.env, "Cursor").is_none()
								and alias_target == canonical_cursor
								and field_type_name == canonical_cursor
							)
						_:
							False
				None:
					False
		_:
			False


func test_import_modules_canonicalize_dependency_types_inside_imported_decls() -> Bool:
	source_decls = [record_with_fields_decl("Span", [int_type()])]
	ast_decls = [
		import_block_decl([import_decl("source", None, Some([import_symbol("Span", None, [])]))]),
		record_with_fields_decl("Node", [named_type("Span")]),
		union_decl_with_variant_fields("Expr", "WithSpan", [named_type("Span")]),
	]
	source_program = program([import_block_decl([import_decl("ast", None, Some([
					import_symbol("Node", None, []),
					import_symbol("Expr", None, ["WithSpan"]),
				]))])])
	result = typecheck_test_program_with_import_modules(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		source_program,
		importable_modules("source", source_decls).concat(importable_modules("ast", ast_decls)),
	)
	canonical_span = canonical_module_type_name("source", "Span")
	canonical_node = canonical_module_type_name("ast", "Node")
	canonical_expr = canonical_module_type_name("ast", "Expr")

	match (
		env_get_record(result.state.env, canonical_node),
		env_get_type_decl(result.state.env, canonical_expr),
	):
		(Some((_, fields)), Some((_, variants))):
			record_ok = match fields.get(0):
				Some(field):
					match field.field_type:
						SemanticNamedType(type_name, _):
							type_name == canonical_span
						_:
							False
				None:
					False

			variant_ok = match variants.get(0):
				Some(variant):
					match variant.fields.get(0):
						Some(SemanticNamedType(type_name, _)):
							type_name == canonical_span
						_:
							False
				None:
					False

			result.state.errors.length() == 0 and record_ok and variant_ok
		_:
			False


