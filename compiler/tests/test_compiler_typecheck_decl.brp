func test_materialize_impl_method_type_param_shadows_alias() -> Bool:
	method_span = source_span_at(1)
	method: ParsedFunctionDecl = {
		name = ident("identity"),
		keyword_span = Some(method_span),
		type_params = [type_param("Callback")],
		params = [named_param("value", named_type("Callback"))],
		return_type = Some(named_type("Callback")),
		dim_constraints = [],
		body = Some(decl_name_expr("value")),
		is_pure = True,
		annotations = [],
		doc = None,
		span = method_span
	}
	source_program = program([
		trait_decl("Identity"),
		type_alias_decl_with_target(
			"Callback",
			function_type(False, [int_type()], int_type()),
		),
		impl_decl_with_methods_at("Identity", int_type(), [method], 2),
	])
	base_state = typecheck_register_program_impl_decls(
		typecheck_register_program_signature_decls(
			typecheck_test_install_validated_type_headers(
				typecheck_prescan_program(
					typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)
	result = typecheck_materialize_standalone_program_bodies(base_state, source_program)
	type_param = SemanticTypeVar("Callback")
	registered_method = env_find_impl_method_info(base_state.env, "Identity", "identity", TYPE_INT)

	match (registered_method, result.program.decls.get(2)):
		(Some(registered), Some(TypedImplDecl(info))):
			match info.methods.get(0):
				Some(method_info):
					target_ok = match (registered.target, method_info.callable_id):
						(Some(target), Some(callable_id)):
							target.callable_id == callable_id and target.module_path == "decl"
						_:
							False

					result.state.errors.length() == 0 and target_ok and types_equal(
						registered.func_type,
						SemanticFunctionType(True, [type_param], type_param),
					) and types_equal(
						method_info.param_types.get_or(0, TYPE_VOID),
						type_param,
					) and types_equal(method_info.semantic_return_type, type_param)
				None:
					False
		_:
			False


