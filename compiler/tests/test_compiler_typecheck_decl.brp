			) and types_equal(first.semantic_return_type, TYPE_INT) and types_equal(
				second.param_types.get_or(0, TYPE_VOID),
				TYPE_STRING,
			) and types_equal(second.semantic_return_type, TYPE_STRING)
		_:
			False


func test_materialize_generic_type_decls_use_explicit_semantic_params() -> Bool:
	generic_record = RecordParsedDecl({
		name = ident("Box"),
		type_params = [type_param("T")],
		fields = [field_decl("value", named_type("T"))],
		is_struct = False,
		doc = None,
		span = fixture_source_span(),
	})
	source_program = program([
		generic_record,
		result_union_decl(),
		generic_type_alias_decl("Wrapped", "T", named_type("T")),
	])
	state = typecheck_test_install_validated_type_headers(
		typecheck_prescan_program(
			typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
			source_program,
		),
		source_program,
	)
	result = typecheck_materialize_standalone_program_bodies(state, source_program)
	expected = SemanticTypeVar("T")

	record_ok = match result.program.decls.get(0):
		Some(TypedRecordDecl(info)):
			match info.fields.get(0):
				Some(field):
					types_equal(
						field.source_type,
						SemanticNamedType("T", []),
					) and types_equal(field.semantic_type, expected)
				None:
					False
		_:
			False

	union_ok = match result.program.decls.get(1):
		Some(TypedUnionDecl(info)):
			match info.variants.get(0):
				Some(variant):
					types_equal(
						variant.fields.get_or(0, TYPE_VOID),
						expected,
					)
				None:
					False
		_:
			False

	alias_ok = match result.program.decls.get(2):
		Some(TypedTypeAliasDecl(info)):
			types_equal(
				info.source_target_type,
				SemanticNamedType("T", []),
			) and types_equal(info.semantic_target_type, expected)
		_:
			False

	result.state.errors.length() == 0 and record_ok and union_ok and alias_ok


