pure func fixture_source_file() -> SourceFile:
	source_file("decl.brp", "decl", "func main(): 1")


pure func parsed_program_source(module_name: String, source: String) -> ParsedProgram:
	finalized_typecheck_program_ast(
		ParserBridge.parsed_typecheck_source_bridge_artifact(
			module_name + ".brp",
			module_name,
			source,
			False,
		).program,
	)


pure func accepted_transparent_alias_target(
	state: TypecheckState,
	name: String,
) -> Option[SemanticType]:
	match module_view_accepted_type_alias_index(state.module_view):
		Some(index):
			type_alias_index_find_transparent(
				index,
				name,
			).map(
				func(alias_entry): alias_entry.target,
			)
		None:
			None


pure func accepted_opaque_alias_target(state: TypecheckState, name: String) -> Option[SemanticType]:
	match module_view_accepted_type_alias_index(state.module_view):
		Some(index):
			type_alias_index_find_opaque(index, name).map(func(alias_entry): alias_entry.target)
		None:
			None


pure func fixture_source_span() -> SourceSpan:
	src: SourceFile = fixture_source_file()
	cursor: Cursor = source_cursor_at(src, 0)
	source_span(src, cursor, cursor)


pure func source_span_at(offset: Int) -> SourceSpan:
	src: SourceFile = fixture_source_file()
	cursor: Cursor = source_cursor_at(src, offset)
	source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, fixture_source_span())


pure func int_type() -> ParsedTypeExpr:
	ParsedNamedType(ident("Int"), [], fixture_source_span())


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], fixture_source_span())


pure func qualified_named_type(qualifier: String, name: String) -> ParsedTypeExpr:
	ParsedQualifiedNamedType(ident(qualifier), ident(name), [], fixture_source_span())


pure func main_signature_test_state() -> TypecheckState:
	base = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN)
	with_trait = env_add_trait(
		base.env,
		trait_def_with_details(9000, "ExitStatusAble", [], [], [], None),
	)
	with_int_impl = env_add_impl(
		with_trait,
		impl_instance(9001, "ExitStatusAble", TYPE_INT, [], True),
	)
	with_void_impl = env_add_impl(
		with_int_impl,
		impl_instance(9002, "ExitStatusAble", TYPE_VOID, [], True),
	)
	{ base | env = with_void_impl }


pure func dim_literal_type(text: String) -> ParsedTypeExpr:
	ParsedDimLiteralType(text, fixture_source_span())


pure func int_vector_type(size: String) -> ParsedTypeExpr:
	ParsedArrayType(int_type(), [dim_literal_type(size)], fixture_source_span())


pure func int_expr() -> ParsedExpr:
	ParsedIntLiteralExpr("1", fixture_source_span())


pure func decl_string_expr() -> ParsedExpr:
	ParsedStringLiteralExpr("text", ParsedPlainStringLiteral, fixture_source_span())


pure func decl_void_expr() -> ParsedExpr:
	ParsedVoidExpr(fixture_source_span())


pure func decl_name_expr(name: String) -> ParsedExpr:
	ParsedNameExpr(ident(name))


pure func decl_call_expr(name: String, args: List[ParsedExpr]) -> ParsedExpr:
	ParsedCallExpr(decl_name_expr(name), args, fixture_source_span())


pure func decl_field_access_expr(receiver: ParsedExpr, field: String) -> ParsedExpr:
	ParsedFieldAccessExpr(receiver, ident(field), fixture_source_span())


pure func decl_add_expr(left: ParsedExpr, right: ParsedExpr) -> ParsedExpr:
	ParsedBinaryExpr(ParsedAddOp, left, right, fixture_source_span())


pure func decl_assign_expr(name: String, value: ParsedExpr) -> ParsedExpr:
	ParsedAssignExpr(ident(name), value, fixture_source_span())


pure func decl_vector_expr(items: List[ParsedExpr]) -> ParsedExpr:
	ParsedVectorExpr(items, fixture_source_span())


pure func decl_record_field(name: String, value: ParsedExpr) -> ParsedRecordExprField:
	{
		name = ident(name),
		value = value,
		span = fixture_source_span()
	}


pure func decl_record_expr(fields: List[ParsedRecordExprField]) -> ParsedExpr:
	ParsedRecordExpr(fields, fixture_source_span())


pure func decl_subscript_assign_expr(
	target: ParsedExpr,
	indices: List[ParsedExpr],
	value: ParsedExpr,
) -> ParsedExpr:
	ParsedSubscriptAssignExpr(target, indices, value, fixture_source_span())


pure func decl_subscript_expr(target: ParsedExpr, indices: List[ParsedExpr]) -> ParsedExpr:
	ParsedSubscriptExpr(target, indices, fixture_source_span())


pure func decl_block_expr(items: List[ParsedExpr]) -> ParsedExpr:
	ParsedBlockExpr(items, fixture_source_span())


pure func decl_for_expr(name: String, iterable: ParsedExpr, body: ParsedExpr) -> ParsedExpr:
	ParsedForExpr(ParsedForNameBinder(ident(name)), iterable, body, fixture_source_span())


pure func decl_debug_expr(body: ParsedExpr) -> ParsedExpr:
	ParsedDebugBlockExpr(body, fixture_source_span())


pure func decl_lambda_expr(is_pure: Bool, body: ParsedExpr) -> ParsedExpr:
	ParsedLambdaExpr(is_pure, [], Some(int_type()), body, fixture_source_span())


pure func bool_type() -> ParsedTypeExpr:
	ParsedNamedType(ident("Bool"), [], fixture_source_span())


pure func string_type() -> ParsedTypeExpr:
	ParsedNamedType(ident("String"), [], fixture_source_span())


pure func generic_named_type(name: String, args: List[ParsedTypeExpr]) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), args, fixture_source_span())


pure func bounded_type(name: String, bounds: List[String]) -> ParsedTypeExpr:
	ParsedBoundedType(
		ident(name),
		bounds.map(ident),
		fixture_source_span(),
	)


pure func result_type(ok_type: ParsedTypeExpr, error_type: ParsedTypeExpr) -> ParsedTypeExpr:
	generic_named_type(
		"Result",
		[ok_type, error_type],
	)


pure func list_string_type() -> ParsedTypeExpr:
	ParsedNamedType(ident("List"), [string_type()], fixture_source_span())


pure func channel_type(element_type: ParsedTypeExpr) -> ParsedTypeExpr:
	ParsedNamedType(ident("Channel"), [element_type], fixture_source_span())


pure func stream_type(element_type: ParsedTypeExpr) -> ParsedTypeExpr:
	ParsedNamedType(ident("Stream"), [element_type], fixture_source_span())


pure func function_type(
	is_pure: Bool,
	params: List[ParsedTypeExpr],
	return_type: ParsedTypeExpr,
) -> ParsedTypeExpr:
	ParsedFunctionType(is_pure, params, return_type, fixture_source_span())


pure func named_param(name: String, type_expr: ParsedTypeExpr) -> ParsedParam:
	{
		binder = ParsedParamNameBinder(ident(name)),
		type_expr = Some(type_expr),
		span = fixture_source_span()
	}


pure func wildcard_param(type_expr: ParsedTypeExpr) -> ParsedParam:
	{
		binder = ParsedParamWildcardBinder(fixture_source_span()),
		type_expr = Some(type_expr),
		span = fixture_source_span()
	}


pure func untyped_named_param(name: String) -> ParsedParam:
	{
		binder = ParsedParamNameBinder(ident(name)),
		type_expr = None,
		span = fixture_source_span()
	}


pure func trait_method_decl(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	is_pure: Bool,
	has_default: Bool,
) -> ParsedTraitMethodDecl:
	body: Option[ParsedExpr] = if has_default:
		Some(int_expr())
	else:
		None

	{
		name = ident(name),
		params = params,
		return_type = return_type,
		body = body,
		is_pure = is_pure,
		span = fixture_source_span()
	}


pure func trait_decl_with_methods(
	name: String,
	type_params: List[ParsedTypeParamDecl],
	supertraits: List[String],
	methods: List[ParsedTraitMethodDecl],
) -> ParsedDecl:
	TraitParsedDecl({
		name = ident(name),
		type_params = type_params,
		supertraits = supertraits.map(func(supertrait): ident(supertrait)),
		methods = methods,
		doc = None,
		span = fixture_source_span(),
	})


pure func function_decl(name: String) -> ParsedDecl:
	FunctionParsedDecl({
		name = ident(name),
		keyword_span = Some(fixture_source_span()),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = Some(int_expr()),
		is_pure = False,
		annotations = [],
		doc = None,
		span = fixture_source_span(),
	})


pure func function_body_decl(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
) -> ParsedDecl:
	function_body_decl_with_purity(name, params, return_type, body, False)


pure func function_body_decl_with_purity(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
	is_pure: Bool,
) -> ParsedDecl:
	function_body_decl_with_annotations(name, params, return_type, body, is_pure, [])


pure func function_body_decl_with_annotations(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
) -> ParsedDecl:
	FunctionParsedDecl({
		name = ident(name),
		keyword_span = Some(fixture_source_span()),
		type_params = [],
		params = params,
		return_type = return_type,
		dim_constraints = [],
		body = body,
		is_pure = is_pure,
		annotations = annotations,
		doc = None,
		span = fixture_source_span(),
	})


pure func function_body_decl_with_span(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
	span: SourceSpan,
) -> ParsedDecl:
	FunctionParsedDecl({
		name = ident(name),
		keyword_span = Some(span),
		type_params = [],
		params = params,
		return_type = return_type,
		dim_constraints = [],
		body = body,
		is_pure = False,
		annotations = [],
		doc = None,
		span = span,
	})


pure func generic_function_body_decl(
	name: String,
	type_params: List[ParsedTypeParamDecl],
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
	is_pure: Bool,
) -> ParsedDecl:
	FunctionParsedDecl({
		name = ident(name),
		keyword_span = Some(fixture_source_span()),
		type_params = type_params,
		params = params,
		return_type = return_type,
		dim_constraints = [],
		body = body,
		is_pure = is_pure,
		annotations = [],
		doc = None,
		span = fixture_source_span(),
	})


pure func method_body_decl(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
) -> ParsedFunctionDecl:
	{
		name = ident(name),
		keyword_span = Some(fixture_source_span()),
		type_params = [],
		params = params,
		return_type = return_type,
		dim_constraints = [],
		body = body,
		is_pure = False,
		annotations = [],
		doc = None,
		span = fixture_source_span()
	}


pure func method_body_decl_at(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
	offset: Int,
) -> ParsedFunctionDecl:
	method = method_body_decl(name, params, return_type, body)
	span = source_span_at(offset)
	{ method |
		keyword_span = Some(span),
		span = span
	}


pure func function_signature_decl(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
) -> ParsedDecl:
	FunctionParsedDecl({
		name = ident(name),
		keyword_span = Some(fixture_source_span()),
		type_params = [type_param("T")],
		params = params,
		return_type = return_type,
		dim_constraints = [],
		body = Some(int_expr()),
		is_pure = is_pure,
		annotations = annotations,
		doc = None,
		span = fixture_source_span(),
	})


pure func var_decl(name: String) -> ParsedDecl:
	VarParsedDecl({
		name = ident(name),
		type_expr = Some(int_type()),
		value = int_expr(),
		is_mutable = False,
		span = fixture_source_span(),
	})


pure func var_body_decl(
	name: String,
	type_expr: Option[ParsedTypeExpr],
	value: ParsedExpr,
) -> ParsedDecl:
	VarParsedDecl({
		name = ident(name),
		type_expr = type_expr,
		value = value,
		is_mutable = False,
		span = fixture_source_span(),
	})


pure func mutable_var_body_decl(
	name: String,
	type_expr: Option[ParsedTypeExpr],
	value: ParsedExpr,
) -> ParsedDecl:
	VarParsedDecl({
		name = ident(name),
		type_expr = type_expr,
		value = value,
		is_mutable = True,
		span = fixture_source_span(),
	})


pure func decl_var_expr(
	name: String,
	type_expr: Option[ParsedTypeExpr],
	value: ParsedExpr,
	is_mutable: Bool,
) -> ParsedExpr:
	ParsedVarDeclExpr(ident(name), type_expr, value, is_mutable, fixture_source_span())


pure func record_decl(name: String) -> ParsedDecl:
	RecordParsedDecl({
		name = ident(name),
		type_params = [],
		fields = [],
		is_struct = False,
		doc = None,
		span = fixture_source_span(),
	})


pure func field_decl(name: String, type_expr: ParsedTypeExpr) -> ParsedFieldDecl:
	{
		name = ident(name),
		type_expr = type_expr,
		span = fixture_source_span()
	}


pure func type_param(name: String) -> ParsedTypeParamDecl:
	{
		name = ident(name),
		bounds = [],
		span = fixture_source_span()
	}


pure func record_with_fields_decl(name: String, field_types: List[ParsedTypeExpr]) -> ParsedDecl:
	RecordParsedDecl({
		name = ident(name),
		type_params = [],
		fields = field_types.map(func(type_expr): field_decl("field", type_expr)),
		is_struct = False,
		doc = None,
		span = fixture_source_span(),
	})


pure func union_decl(name: String, variants: List[String]) -> ParsedDecl:
	UnionParsedDecl({
		name = ident(name),
		type_params = [],
		variants = variants.map(func(variant_name): {
				name = ident(variant_name),
				fields = [],
				span = fixture_source_span()
			}),
		is_enum = False,
		doc = None,
		span = fixture_source_span(),
	})


pure func union_decl_with_variant_fields(
	name: String,
	variant_name: String,
	field_types: List[ParsedTypeExpr],
) -> ParsedDecl:
	UnionParsedDecl({
		name = ident(name),
		type_params = [],
		variants = [
			{
				name = ident(variant_name),
				fields = field_types,
				span = fixture_source_span()
			},
		],
		is_enum = False,
		doc = None,
		span = fixture_source_span(),
	})


pure func result_union_decl() -> ParsedDecl:
	UnionParsedDecl({
		name = ident("Result"),
		type_params = [type_param("T"), type_param("E")],
		variants = [
			{
				name = ident("Ok"),
				fields = [named_type("T")],
				span = fixture_source_span()
			},
			{
				name = ident("Err"),
				fields = [named_type("E")],
				span = fixture_source_span()
			},
		],
		is_enum = False,
		doc = None,
		span = fixture_source_span(),
	})


pure func builtin_type_decl(name: String, is_resource: Bool) -> ParsedDecl:
	BuiltinTypeParsedDecl({
		name = ident(name),
		type_params = [],
		is_resource = is_resource,
		cleanup = None,
		doc = None,
		span = fixture_source_span(),
	})


pure func builtin_resource_type_decl_with_cleanup(
	name: String,
	cleanup_function: String,
) -> ParsedDecl:
	BuiltinTypeParsedDecl({
		name = ident(name),
		type_params = [],
		is_resource = True,
		cleanup = Some({
			builtin_name = cleanup_function,
			span = fixture_source_span(),
		}),
		doc = None,
		span = fixture_source_span(),
	})


pure func type_alias_decl(name: String, is_opaque: Bool) -> ParsedDecl:
	TypeAliasParsedDecl({
		name = ident(name),
		type_params = [],
		target = int_type(),
		is_opaque = is_opaque,
		doc = None,
		span = fixture_source_span(),
	})


pure func type_alias_decl_with_target(name: String, target: ParsedTypeExpr) -> ParsedDecl:
	TypeAliasParsedDecl({
		name = ident(name),
		type_params = [],
		target = target,
		is_opaque = False,
		doc = None,
		span = fixture_source_span(),
	})


pure func generic_type_alias_decl(
	name: String,
	type_param_name: String,
	target: ParsedTypeExpr,
) -> ParsedDecl:
	TypeAliasParsedDecl({
		name = ident(name),
		type_params = [type_param(type_param_name)],
		target = target,
		is_opaque = False,
		doc = None,
		span = fixture_source_span(),
	})


pure func trait_decl(name: String) -> ParsedDecl:
	TraitParsedDecl({
		name = ident(name),
		type_params = [],
		supertraits = [],
		methods = [],
		doc = None,
		span = fixture_source_span(),
	})


pure func impl_decl_with_methods(
	trait_name: String,
	for_type: ParsedTypeExpr,
	methods: List[ParsedFunctionDecl],
) -> ParsedDecl:
	ImplParsedDecl({
		trait_name = ident(trait_name),
		for_type = for_type,
		methods = methods,
		doc = None,
		span = fixture_source_span(),
	})


pure func impl_decl_with_methods_at(
	trait_name: String,
	for_type: ParsedTypeExpr,
	methods: List[ParsedFunctionDecl],
	offset: Int,
) -> ParsedDecl:
	match impl_decl_with_methods(trait_name, for_type, methods):
		ImplParsedDecl(impl_decl):
			ImplParsedDecl({ impl_decl | span = source_span_at(offset) })
		other:
			other


pure func foreign_block_visibility_decl(function_name: String, is_private: Bool) -> ParsedDecl:
	ForeignBlockParsedDecl(
		[],
		[
			{
				name = ident(function_name),
				params = [],
				return_type = int_type(),
				c_name = None,
				is_pure = False,
				is_private = is_private,
				annotations = [],
				span = fixture_source_span()
			},
		],
		fixture_source_span(),
	)


pure func foreign_block_decl(function_name: String) -> ParsedDecl:
	foreign_block_visibility_decl(function_name, False)


pure func foreign_block_with_metadata_decl() -> ParsedDecl:
	args: List[ParsedForeignBlockArg] = [
		{
			name = ident("include"),
			value = "native.h",
			span = fixture_source_span()
		},
		{
			name = ident("link_linux"),
			value = "-ldl",
			span = fixture_source_span()
		},
	]
	ForeignBlockParsedDecl(
		args,
		[
			{
				name = ident("mutate"),
				params = [],
				return_type = int_type(),
				c_name = Some("native_mutate"),
				is_pure = False,
				is_private = False,
				annotations = [],
				span = fixture_source_span()
			},
			{
				name = ident("inspect"),
				params = [],
				return_type = int_type(),
				c_name = None,
				is_pure = False,
				is_private = False,
				annotations = [ParsedNoCopyAnnotation],
				span = fixture_source_span()
			},
		],
		fixture_source_span(),
	)


pure func import_symbol(
	name: String,
	symbol_alias: Option[String],
	constructors: List[String],
) -> ParsedImportSymbol:
	{
		name = ident(name),
		symbol_alias = symbol_alias.map(func(alias_name): ident(alias_name)),
		constructors = constructors.map(func(constructor_name): ident(constructor_name)),
		span = fixture_source_span()
	}


pure func import_decl(
	module_path: String,
	module_alias: Option[String],
	symbols: Option[List[ParsedImportSymbol]],
) -> ParsedImportDecl:
	{
		module_path = module_path,
		module_path_span = fixture_source_span(),
		module_alias = module_alias.map(func(alias_name): ident(alias_name)),
		symbols = symbols,
		span = fixture_source_span()
	}


pure func import_block_decl(imports: List[ParsedImportDecl]) -> ParsedDecl:
	ImportBlockParsedDecl(imports, fixture_source_span())


pure func import_symbol_local_name(symbol: ParsedImportSymbol) -> String:
	match symbol.symbol_alias:
		Some(alias_name):
			alias_name.text
		None:
			symbol.name.text


pure func import_decl_symbol_names(import_decl: ParsedImportDecl) -> List[String]:
	match import_decl.symbols:
		Some(symbols):
			symbols.map(func(symbol): symbol.name.text)
		None:
			[]


pure func import_decl_symbol_local_names(import_decl: ParsedImportDecl) -> List[String]:
	match import_decl.symbols:
		Some(symbols):
			symbols.map(import_symbol_local_name)
		None:
			[]


pure func optional_string_list_equals(actual: Option[List[String]], expected: List[String]) -> Bool:
	match actual:
		Some(names):
			names == expected
		None:
			False


pure func program(decls: List[ParsedDecl]) -> ParsedProgram:
	{
		source = fixture_source_file(),
		decls = decls,
		diagnostics = []
	}


private pure func program_for_module(module_path: String, decls: List[ParsedDecl]) -> ParsedProgram:
	base_program = program(decls)
	{ base_program |
		source = source_file(base_program.source.path, module_path, base_program.source.text)
	}


pure func importable_modules_with_origin(
	module_path: String,
	decls: List[ParsedDecl],
	origin: ModuleOrigin,
) -> List[ImportableModule]:
	module_program = program_for_module(module_path, decls)
	candidate = module_load_candidate(
		resolved_module_identity_from_resolver(module_path, origin),
		finalized_typecheck_program(module_program),
	)

	match indexed_graph_build(candidate, []):
		Err(_):
			[]
		Ok(graph):
			[importable_module(indexed_graph_target_scope(graph))]


pure func importable_modules(
	module_path: String,
	decls: List[ParsedDecl],
) -> List[ImportableModule]:
	importable_modules_with_origin(module_path, decls, SourcePackageModule("test"))


private pure func importable_module_index(
	modules: List[ImportableModule],
) -> Option[ImportableModuleIndex]:
	target_program = program_for_module("index_target", [])
	target = module_load_candidate(
		resolved_module_identity_from_resolver("index_target", UserModule),
		finalized_typecheck_program(target_program),
	)
	indexed ?= indexed_graph_build(
		target,
		modules.map(importable_module_candidate),
	).to_option()
	Some(importable_module_graph_all_index(importable_module_graph(indexed)))


private pure func importable_module_candidate(module: ImportableModule) -> ModuleLoadCandidate:
	scope = importable_module_prepared_scope(module)
	module_load_candidate(
		resolved_module_identity_from_resolver(
			importable_module_path(module),
			importable_module_origin(module),
		),
		finalized_typecheck_program(prepared_module_program(prepared_module_scope_module(scope))),
	)


private pure func importable_modules_with_source_name(
	canonical_path: String,
	module_name: String,
	decls: List[ParsedDecl],
) -> List[ImportableModule]:
	module_program = program_for_module(module_name, decls)
	candidate = module_load_candidate(
		resolved_module_identity_from_resolver(canonical_path, SourcePackageModule("test")),
		finalized_typecheck_program(module_program),
	)

	match indexed_graph_build(candidate, []):
		Err(_):
			[]
		Ok(graph):
			[importable_module(indexed_graph_target_scope(graph))]


private pure func importable_signature_decl_name(decl: ImportableSignatureDecl) -> String:
	match decl:
		ImportableFunctionDecl(function_decl):
			function_decl.name.text
		ImportableVarDecl(var_decl):
			var_decl.name.text
		ImportableForeignFunctionDecl(function_decl):
			function_decl.name.text
		ImportableTraitDecl(trait_decl):
			trait_decl.name.text


func test_importable_module_precomputes_interface_facts() -> Bool:
	modules = importable_modules(
		"types",
		[
			import_block_decl([import_decl("dep", None, None)]),
			record_decl("Widget"),
			union_decl(
				"MaybeWidget",
				["Present", "Missing"],
			),
			builtin_type_decl("BuiltinThing", False),
			type_alias_decl("WidgetId", False),
			function_decl("make_widget"),
			var_decl("default_widget_id"),
			foreign_block_decl("native_widget_id"),
			foreign_block_visibility_decl("hidden_native_widget_id", True),
			trait_decl("Display"),
			impl_decl_with_methods("Display", int_type(), []),
			PrivateParsedDecl(record_decl("HiddenWidget"), fixture_source_span()),
			PrivateParsedDecl(function_decl("hidden_widget"), fixture_source_span()),
		],
	)

	match modules.get(0):
		None:
			False
		Some(module):
			local_type_names = importable_module_local_type_names(module)
			declared_imports = importable_module_declared_imports(module)
			signature_decls = importable_module_signature_decls(module)
			impl_decls = importable_module_impl_decls(module)

			(
				local_type_names == [
					"BuiltinThing",
					"HiddenWidget",
					"MaybeWidget",
					"Widget",
					"WidgetId",
				]
				and declared_imports.length() == 1
				and declared_imports
					.get(0)
					.map(func(imported): imported.module_path) == Some("dep")
				and signature_decls.map(
					importable_signature_decl_name,
				) == ["make_widget", "default_widget_id", "native_widget_id", "Display"]
				and impl_decls.map(func(impl_decl): impl_decl.trait_name.text) == ["Display"]
			)


func test_prescan_collects_top_level_names_and_resources() -> Bool:
	state = typecheck_prescan_program(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		program([
			record_decl("Widget"),
			union_decl(
				"Maybe",
				["Just", "Nothing"],
			),
			builtin_type_decl("Reader", True),
			type_alias_decl("WidgetId", False),
			function_decl("main"),
			var_decl("answer"),
			trait_decl("Display"),
		]),
	)

	(
		typecheck_state_has_known_type_name(state, "Widget")
		and typecheck_state_has_known_type_name(state, "Maybe")
		and typecheck_state_has_known_type_name(state, "Reader")
		and typecheck_state_has_known_type_name(state, "WidgetId")
		and typecheck_state_has_known_resource_type_name(state, "Reader")
		and typecheck_state_find_top_level_name(state, "Widget") == Some(TopLevelType)
		and typecheck_state_find_top_level_name(state, "Just") == Some(TopLevelConstructor)
		and typecheck_state_find_top_level_name(state, "Nothing") == Some(TopLevelConstructor)
		and typecheck_state_find_top_level_name(state, "main") == Some(TopLevelFunction)
		and typecheck_state_find_top_level_name(state, "answer") == Some(TopLevelVariable)
		and typecheck_state_find_top_level_name(state, "Display") == Some(TopLevelTrait)
	)


func test_prescan_recurses_private_and_keeps_first_namespace_kind() -> Bool:
	state = typecheck_prescan_program(typecheck_state_for_origin(TYPECHECK_USER_ORIGIN), program([
			function_decl("Thing"),
			PrivateParsedDecl(record_decl("Thing"), fixture_source_span()),
		]))

	(
		typecheck_state_has_known_type_name(state, "Thing")
		and typecheck_state_find_top_level_name(state, "Thing") == Some(TopLevelFunction)
	)


func test_prescan_records_foreign_block_functions() -> Bool:
	state = typecheck_prescan_program(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		program([foreign_block_decl("native_hash")]),
	)

	typecheck_state_find_top_level_name(state, "native_hash") == Some(TopLevelFunction)


func test_register_imports_records_qualified_module_alias() -> Bool:
	source_program = program([import_block_decl([
			import_decl("std/file", Some("File"), None),
			import_decl("json", None, None),
		])])
	state = typecheck_register_program_import_decls(
		typecheck_prescan_program(
			typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
			source_program,
		),
		source_program,
	)

	(
		typecheck_state_find_module_alias(state, "File") == Some("std/file")
		and typecheck_state_find_module_alias(state, "json") == Some("json")
		and typecheck_state_has_imported_module(state, "std/file")
		and typecheck_state_has_qualified_module_binding(state, "File", "std/file")
		and typecheck_state_has_qualified_module_binding(state, "json", "json")
	)


func test_register_imports_records_selective_symbols_and_constructors() -> Bool:
	source_program = program([
		import_block_decl([
			import_decl(
				"option",
				None,
				Some([
					import_symbol(
						"Option",
						None,
						["Some", "None"],
					),
					import_symbol("map", Some("option_map"), []),
				]),
			),
		]),
	])
	state = typecheck_register_program_import_decls(
		typecheck_prescan_program(
			typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
			source_program,
		),
		source_program,
	)

	(
		typecheck_state_has_selective_definition_binding(state, "Option", "option", "Option")
		and typecheck_state_has_selective_definition_binding(state, "Some", "option", "Some")
		and typecheck_state_has_selective_definition_binding(state, "None", "option", "None")
		and typecheck_state_has_selective_definition_binding(state, "option_map", "option", "map")
		and typecheck_state_find_module_alias(state, "option").is_none()
	)


func test_register_imports_records_combined_alias_and_symbols() -> Bool:
	source_program = program(
		[
			import_block_decl(
				[import_decl("heap", Some("H"), Some([import_symbol("Heap", None, [])]))],
			),
		],
	)
	state = typecheck_register_program_import_decls(
		typecheck_prescan_program(
			typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
			source_program,
		),
		source_program,
	)

	(
		typecheck_state_find_module_alias(state, "H") == Some("heap")
		and typecheck_state_has_qualified_module_binding(state, "H", "heap")
		and typecheck_state_has_selective_definition_binding(state, "Heap", "heap", "Heap")
	)


func test_register_imports_reports_namespace_collisions() -> Bool:
	source_program = program([function_decl("File"), import_block_decl([
			import_decl("std/file", Some("File"), None),
			import_decl("math", None, Some([import_symbol("File", None, [])])),
		])])
	state = typecheck_register_program_import_decls(
		typecheck_prescan_program(
			typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
			source_program,
		),
		source_program,
	)

	(
		state.errors.length() == 2
		and state.errors
			.get_or(0, "")
			.contains("module alias 'File' conflicts with function 'File'")
		and state.errors
			.get_or(1, "")
			.contains("imported name 'File' conflicts with function 'File'")
	)


func test_bind_program_module_view_returns_completed_namespace() -> Bool:
	source_program = program([
		import_block_decl([import_decl("dep", None, Some([import_symbol("Token", None, [])]))]),
		function_decl("local_value"),
	])
	modules = importable_modules("dep", [record_decl("Token")])

	match importable_module_index(modules):
		None:
			False
		Some(index):
			match typecheck_bind_program_module_view(
				typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				source_program,
				index,
				"decl",
			):
				BoundModuleViewRejected(_, _):
					False
				BoundModuleViewReady(view, bound_program, _, diagnostics):
					(
						module_view_has_selective_binding(view, "Token", "dep", "Token")
						and module_view_find_local_name(
							view,
							"local_value",
						) == Some(TopLevelFunction)
						and bound_program.source.module_name == source_program.source.module_name
						and diagnostics.length() == 0
					)


func test_reachable_import_modules_exclude_current_and_unrelated_modules() -> Bool:
	source_program = program([import_block_decl([import_decl("dep", None, None)])])
	modules = importable_modules("decl", [function_decl("current_only")])
		.concat(
			importable_modules(
				"dep",
				[import_block_decl([import_decl("transitive", None, None)])],
			),
		)
		.concat(importable_modules("transitive", [function_decl("transitive_only")]))
		.concat(importable_modules("unrelated", [function_decl("unrelated_only")]))
	reachable = importable_module_index(modules)
		.map(
			func(
				index,
			): importable_module_selection_for_program(source_program, index, Some("decl"))[0],
		)
		.get_or([])

	(
		reachable.length() == 2
		and reachable.any(func(module): importable_module_path(module) == "dep")
		and reachable.any(func(module): importable_module_path(module) == "transitive")
		and not reachable.any(func(module): importable_module_path(module) == "decl")
		and not reachable.any(func(module):
			importable_module_path(module) == "unrelated"
		)
	)


func test_reachable_import_modules_follow_private_source_name_alias() -> Bool:
	source_program = program([import_block_decl([import_decl("dep", None, None)])])
	modules = importable_modules(
		"dep",
		[
			PrivateParsedDecl(
				import_block_decl([import_decl("nested", None, None)]),
				fixture_source_span(),
			),
		],
	).concat(importable_modules_with_source_name("pkg/nested", "nested", []))
	reachable = importable_module_index(modules)
		.map(
			func(
				index,
			): importable_module_selection_for_program(source_program, index, Some("decl"))[0],
		)
		.get_or([])

	reachable.map(importable_module_path) == ["dep", "pkg/nested"]


func test_combined_import_selection_preserves_visible_and_direct_order() -> Bool:
	source_program = program([import_block_decl([import_decl("dep", None, None)])])
	modules = importable_modules(
		"dep",
		[import_block_decl([import_decl("transitive", None, None)])],
	)
		.concat(importable_modules("transitive", []))
		.concat(importable_modules("std/tuple", []))

	match importable_module_index(modules):
		None:
			False
		Some(index):
			selection = importable_module_selection_for_program(source_program, index, Some("decl"))

			(
				selection[0].map(importable_module_path) == ["dep", "transitive", "std/tuple"]
				and selection[1].map(importable_module_path) == ["dep", "std/tuple"]
			)


func test_import_identity_resolution_reports_missing_module() -> Bool:
	resolution = importable_module_index(importable_modules("dep", []))
		.map(func(index): resolve_import_identity(index, "missing"))
		.get_or(ImportIdentityMissing)

	match resolution:
		ImportIdentityMissing:
			True
		_:
			False


func test_import_identity_resolution_reports_unique_source_name() -> Bool:
	modules = importable_modules_with_source_name("pkg/dep", "dep", [])
	resolution = importable_module_index(modules)
		.map(func(index): resolve_import_identity(index, "dep"))
		.get_or(ImportIdentityMissing)

	match resolution:
		ImportIdentityFound(identity):
			identity == "pkg/dep"
		_:
			False


func test_import_identity_resolution_prefers_exact_canonical_path() -> Bool:
	modules = importable_modules_with_source_name(
		"dep",
		"other",
		[],
	).concat(importable_modules_with_source_name("pkg/dep", "dep", []))
	resolution = importable_module_index(modules)
		.map(func(index): resolve_import_identity(index, "dep"))
		.get_or(ImportIdentityMissing)

	match resolution:
		ImportIdentityFound(identity):
			identity == "dep"
		_:
			False


func test_import_identity_resolution_reports_sorted_ambiguity() -> Bool:
	modules = importable_modules_with_source_name(
		"z/dep",
		"dep",
		[],
	).concat(importable_modules_with_source_name("a/dep", "dep", []))
	resolution = importable_module_index(modules)
		.map(func(index): resolve_import_identity(index, "dep"))
		.get_or(ImportIdentityMissing)

	match resolution:
		ImportIdentityAmbiguous(identities):
			identities == ["a/dep", "z/dep"]
		_:
			False


func test_import_identity_resolution_supports_std_alias() -> Bool:
	modules = importable_modules_with_origin("json", [], StdlibModule)
	resolution = importable_module_index(modules)
		.map(func(index): resolve_import_identity(index, "std/json"))
		.get_or(ImportIdentityMissing)

	match resolution:
		ImportIdentityFound(identity):
			identity == "json"
		_:
			False


func test_importable_module_index_prefers_std_prelude() -> Bool:
	modules = importable_modules_with_origin(
		"prelude",
		[],
		SourcePackageModule(
			"test",
		),
	).concat(importable_modules_with_origin("std/prelude", [], StdlibModule))

	match importable_module_index(modules):
		Some(index):
			importable_module_index_prelude(
				index,
			).map(importable_module_path) == Some("std/prelude")
		None:
			False


func test_prelude_import_merge_preserves_order_and_membership_semantics() -> Bool:
	user_program = program([
		import_block_decl(
			[import_decl("dep", None, Some([import_symbol("second", Some("alias_second"), [])]))],
		),
		function_decl("local_alpha"),
	])
	prelude_decls = [import_block_decl([import_decl("dep", None, Some([
					import_symbol("first", None, []),
					import_symbol("second", None, []),
				])), import_decl("extra", None, Some([
					import_symbol("alpha", Some("local_alpha"), []),
					import_symbol("beta", None, []),
				])), import_decl("dep", None, Some([
					import_symbol("first", None, []),
					import_symbol("third", None, []),
				]))])]
	modules = importable_modules_with_origin("std/prelude", prelude_decls, StdlibModule)
		.concat(importable_modules("dep", []))
		.concat(importable_modules("extra", []))

	match importable_module_index(modules):
		Some(index):
			expanded = program_with_prelude_imports(
				typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				user_program,
				index,
			)

			match expanded.decls:
				[ImportBlockParsedDecl(prepend_imports, _), ImportBlockParsedDecl(merged_imports, _), FunctionParsedDecl(_)]:
					(
						prepend_imports.length() == 1
						and prepend_imports
							.get(0)
							.map(func(import_decl): import_decl.module_path) == Some("extra")
						and optional_string_list_equals(
							prepend_imports
								.get(0)
								.map(import_decl_symbol_names),
							["beta"],
						)
						and optional_string_list_equals(
							prepend_imports
								.get(0)
								.map(import_decl_symbol_local_names),
							["beta"],
						)
						and merged_imports.length() == 1
						and merged_imports
							.get(0)
							.map(func(import_decl): import_decl.module_path) == Some("dep")
						and optional_string_list_equals(
							merged_imports
								.get(0)
								.map(import_decl_symbol_names),
							["second", "first", "third"],
						)
						and optional_string_list_equals(
							merged_imports
								.get(0)
								.map(import_decl_symbol_local_names),
							["alias_second", "first", "third"],
						)
					)
				_:
					False
		None:
			False


func test_ambient_tuple_module_registers_impls_without_source_import() -> Bool:
	base_state = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN)
	ambient_decls = [
		trait_decl("AmbientTupleTrait"),
		impl_decl_with_methods("AmbientTupleTrait", int_type(), []),
	]
	result = typecheck_test_program_with_import_modules(
		base_state,
		program([]),
		importable_modules("std/tuple", ambient_decls),
	)

	(
		result.state.errors.length() == 0
		and result.state.env.impls.length() == base_state.env.impls.length() + 1
		and result.state.env.impls.any(func(instance): instance.trait_name == "AmbientTupleTrait")
		and not typecheck_state_has_imported_module(result.state, "std/tuple")
		and typecheck_state_find_module_alias(result.state, "tuple").is_none()
	)


func test_import_modules_register_canonical_type_payloads() -> Bool:
	module_decls = [
		record_with_fields_decl("Payload", [int_type()]),
		union_decl_with_variant_fields("Message", "WithPayload", [named_type("Payload")]),
	]
	source_program = program(
		[
			import_block_decl(
				[
					import_decl(
						"model",
						None,
						Some([import_symbol("Message", None, ["WithPayload"])]),
					),
				],
			),
		],
	)
	result = typecheck_test_program_with_import_modules(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		source_program,
		importable_modules("model", module_decls),
	)
	canonical_message = canonical_module_type_name("model", "Message")
	canonical_payload = canonical_module_type_name("model", "Payload")

	match (
		env_get_type_decl(result.state.env, canonical_message),
		env_get_record(result.state.env, canonical_payload),
		accepted_transparent_alias_target(result.state, "Message"),
		accepted_transparent_alias_target(result.state, "Payload"),
	):
		(Some((_, variants)), Some(_), Some(SemanticNamedType(alias_target, _)), None):
			match variants.get(0):
				Some(variant):
					match variant.fields.get(0):
						Some(SemanticNamedType(payload_name, _)):
							(
								result.state.errors.length() == 0
								and env_get_alias(result.state.env, "Message").is_none()
								and alias_target == canonical_message
								and payload_name == canonical_payload
							)
						_:
							False
				None:
					False
		_:
			False


func test_accepted_imported_builtin_alias_uses_graph_authority() -> Bool:
	result = typecheck_test_program_with_import_modules(
