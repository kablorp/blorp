			[],
			Some(named_type("DirectoryEntry")),
			Some(decl_record_expr([decl_record_field("name", decl_string_expr())])),
			True,
		)]
	source_program = program([import_block_decl([import_decl("fs", None, Some([
					import_symbol("DirectoryEntry", None, []),
					import_symbol("make_entry", None, []),
				]))]), function_body_decl_with_purity(
			"entry_name",
			[],
			Some(string_type()),
			Some(decl_field_access_expr(decl_call_expr("make_entry", []), "name")),
			True,
		)])
	result = typecheck_test_program_with_import_modules(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		source_program,
		importable_modules("std/fs", fs_decls),
	)

	result.state.errors.length() == 0


func test_imported_builtin_resource_preserves_cleanup() -> Bool:
	module_path = "std/fs"
	resource_name = "FileReader"
	source_program = program(
		[
			import_block_decl(
				[import_decl("fs", None, Some([import_symbol(resource_name, None, [])]))],
			),
		],
	)
	result = typecheck_test_program_with_import_modules(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		source_program,
		importable_modules(
			module_path,
			[builtin_resource_type_decl_with_cleanup(resource_name, "blorp_file_close_reader")],
		),
	)
	canonical_name = canonical_module_type_name(module_path, resource_name)

	(
		result.state.errors.length() == 0
		and find_resource_cleanup(
			result.state.context,
			canonical_name,
		) == Some("blorp_file_close_reader")
	)


func test_imported_resource_function_uses_canonical_parameter_type() -> Bool:
	module_path = "std/fs"
	resource_name = "FileReader"
	function_name = "use_reader"
	source_program = program([
		import_block_decl(
			[import_decl("fs", None, Some([import_symbol(function_name, None, [])]))],
		),
		record_decl(resource_name),
	])
	result = typecheck_test_program_with_import_modules(
		typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		source_program,
		importable_modules(
			module_path,
			[
				builtin_resource_type_decl_with_cleanup(resource_name, "blorp_file_close_reader"),
				function_body_decl(
					function_name,
					[named_param("reader", named_type(resource_name))],
					Some(int_type()),
					Some(int_expr()),
				),
			],
		),
	)
	result.state.errors.any(
		func(
			error,
		): error.contains(
			"Function 'use_reader' parameter 'reader' cannot contain a resource type",
		),
	)


func test_registers_type_record_alias_and_constructors() -> Bool:
	source_program = program([
		union_decl(
			"Maybe",
			["Some", "None"],
		),
		record_with_fields_decl("Point", [int_type()]),
		type_alias_decl("UserId", False),
	])
	state = typecheck_test_install_validated_type_headers(
		typecheck_prescan_program(
			typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
			source_program,
		),
		source_program,
	)

	match (
		env_get_type_decl(state.env, "Maybe"),
		env_get_constructor(state.env, "Some"),
		env_get_record(state.env, "Point"),
		env_get_alias(state.env, "UserId"),
	):
		(Some((_, variants)), Some(ctor), Some((_, record_fields)), Some((_, alias_target))):
			(
				variants.length() == 2
				and ctor.parent_type == "Maybe"
				and ctor.field_types.length() == 0
				and ctor.tag == 0
				and record_fields.length() == 1
				and types_equal(alias_target, TYPE_INT)
				and typecheck_state_find_type_home(state, "Maybe") == Some("decl")
				and typecheck_state_find_type_home(state, "Point") == Some("decl")
			)
		_:
			False


func test_registers_builtin_resource_and_resource_containing_record() -> Bool:
	source_program = program([
		builtin_resource_type_decl_with_cleanup("Reader", "blorp_reader_close"),
		record_with_fields_decl(
			"ReaderBox",
			[ParsedNamedType(ident("Reader"), [], fixture_source_span())],
