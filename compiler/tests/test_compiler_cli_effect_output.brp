import:
	../src/pipeline: CoreObservation
	../src/stage_12_cli/effect_output: render_compile_timings, render_core_observations
	../src/stage_12_cli/timing: CliCompileTiming
	test: TestSuite


pure func test_observations_have_one_header_and_stage_boundaries() -> Bool:
	observations: List[CoreObservation] = [
		{
			stage_name = "lower",
			rendered = "lower body\n"
		},
		{
			stage_name = "resolve",
			rendered = "resolved body"
		},
	]
	rendered: String = render_core_observations("src/main.brp", observations)

	(
		rendered.starts_with("-- blorp src/main.brp\n")
		and rendered.contains("===== after lower =====\nlower body\n")
		and rendered.contains("===== after resolve =====\nresolved body\n")
		and rendered.count("-- blorp") == 1
	)


pure func test_compile_timings_include_phases_and_total() -> Bool:
	timings: List[CliCompileTiming] = [
		{
			label = "frontend",
			microseconds = 1250
		},
		{
			label = "backend",
			microseconds = 2750
		},
	]
	rendered: String = render_compile_timings(timings)

	(
		rendered.contains("frontend\t1.25 ms")
		and rendered.contains("backend\t2.75 ms")
		and rendered.contains("total\t4")
	)


tests: TestSuite = {
	description = "Blorp compiler CLI effect output",
	tests = [
		(
			"observations have one header and stage boundaries",
			test_observations_have_one_header_and_stage_boundaries,
		),
		(
			"compile timings include phases and total",
			test_compile_timings_include_phases_and_total,
		),
	]
}
