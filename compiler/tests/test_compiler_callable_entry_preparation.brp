import:
	../src/stage_03_parse/parser_bridge as ParserBridge
	../src/stage_04_modules/loaded_module:
		ANONYMOUS_IDENTITY,
		ModuleIdentity,
		ModuleLoadCandidate,
		ModuleOrigin(UserModule),
		loaded_module_identity,
		loaded_module_set,
		loaded_module_set_target,
		module_load_candidate,
		resolved_module_identity_from_resolver,
	../src/stage_05_types/callable_value_index:
		AcceptedCallableEntry,
		accepted_callable_definition_id_value,
	../src/stage_05_types/env:
		FuncOrigin(ForeignFunc, UserDefinedFunc),
		FuncSymbol,
		LoopProducer(LoopProducerIndices),
		Purity(Pure),
		ResourceArgPolicy(AllowResourceArgs, RejectResourceArgs),
		ResourceResultPolicy(ResourceResultDependent),
		func_symbol,
	../src/stage_05_types/generic_params: make_bound_type_param
	../src/stage_05_types/semantic_type:
		SemanticDimOp(SemanticDimAdd),
		SemanticType(
			SemanticArrayType,
			SemanticConstIntType,
			SemanticDimOpType,
			SemanticFunctionType,
			SemanticNamedType,
			SemanticTypeVar,
		),
		TYPE_INT,
		canonical_module_type_name,
		types_equal,
	../src/stage_06_typecheck/graph/indexed_graph:
		PreparedModuleScope,
		indexed_graph_build,
		prepared_module_program,
		prepared_module_scope_module,
	../src/stage_06_typecheck/headers/callable_entry_preparation:
		prepare_accepted_callable_entry_from_local_symbol,
	../src/stage_06_typecheck/headers/callable_headers:
		CallableHeader,
		CallableHeaderGraph,
		callable_header_graph_build,
		callable_header_graph_callables,
		callable_header_graph_trait_topology,
		callable_header_id,
		callable_header_name,
	../src/stage_06_typecheck/headers/declaration_skeleton:
		callable_id_definition_id,
		declaration_skeleton_graph_build,
	../src/stage_06_typecheck/headers/trait_headers:
		trait_topology_graph_build,
		trait_topology_graph_type_headers,
	../src/stage_06_typecheck/headers/type_header_dependencies: type_alias_dependency_graph_validate
	../src/stage_06_typecheck/headers/type_header_graph: type_header_graph_build
	../src/stage_06_typecheck/headers/type_parameter_headers: resolved_type_parameter_graph_build
	../src/stage_06_typecheck/modules/bound_module_graph:
		BoundModuleViewBinding(BoundModuleViewReady),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		bound_module_graph_build,
	../src/stage_06_typecheck/modules/module_view: COMPILER_MODULE_VIEW_EMPTY
	test: TestSuite


private CALLABLE_SOURCE: String =
	|record Payload {value: Int}
	|
	|pure func choose[#N, #M](items: Payload[#N], fallback: Payload) -> Payload where #N + 1 == #M:
	|	fallback
	|
	|pure func nullary() -> Payload:
	|	{value = 1}
	|
	|foreign:
	|	pure func native_payload(value: Int) -> Int = "native_payload"


private pure func module_identity(canonical_path: String) -> ModuleIdentity:
	program = ParserBridge.parsed_typecheck_source_bridge_artifact(
		canonical_path + ".brp",
		canonical_path,
		"pure func value() -> Int: 1",
		False,
	).program

	match loaded_module_set(
		module_load_candidate(
			resolved_module_identity_from_resolver(canonical_path, UserModule),
			program,
		),
		[],
	):
		Ok(modules):
			loaded_module_identity(loaded_module_set_target(modules))
		Err(_):
			ANONYMOUS_IDENTITY


private pure func module_load_candidate_at(
	module_path: String,
	source: String,
) -> ModuleLoadCandidate:
	module_load_candidate(
		resolved_module_identity_from_resolver(module_path, UserModule),
		ParserBridge.parsed_typecheck_source_bridge_artifact(
			module_path + ".brp",
			module_path,
			source,
			False,
		).program,
	)


private pure func accept_empty_view(scope: PreparedModuleScope) -> BoundModuleViewBinding:
	BoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private pure func callable_graph_at(
	module_path: String,
	source: String,
) -> Option[CallableHeaderGraph]:
	indexed ?= indexed_graph_build(
		module_load_candidate_at(module_path, source),
		[],
	).to_option()
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	topology ?= trait_topology_graph_build(type_headers).to_option()
	callable_header_graph_build(topology).to_option()


private pure func callable_header_by_name(
	graph: CallableHeaderGraph,
	name: String,
) -> Option[CallableHeader]:
	callable_header_graph_callables(graph).find(func(header): callable_header_name(header) == name)


private pure func payload_type(name: String) -> SemanticType:
	SemanticNamedType(name, [])


private pure func payload_array(name: String) -> SemanticType:
	SemanticArrayType(payload_type(name), [SemanticTypeVar("#N")])


private pure func source_choose_func_type() -> SemanticType:
	SemanticFunctionType(
		True,
		[payload_array("Payload"), payload_type("Payload")],
		payload_type("Payload"),
	)


private pure func canonical_choose_func_type(module_path: String) -> SemanticType:
	name = canonical_module_type_name(module_path, "Payload")
	SemanticFunctionType(
		True,
		[payload_array(name), payload_type(name)],
		payload_type(name),
	)


private pure func source_dim_constraints() -> List[(SemanticType, SemanticType)]:
	[
		(
			SemanticDimOpType(SemanticDimAdd, SemanticTypeVar("#N"), SemanticConstIntType(1)),
			SemanticTypeVar("#M"),
		),
	]


private pure func dim_constraint_lists_equal(
	left: List[(SemanticType, SemanticType)],
	right: List[(SemanticType, SemanticType)],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var result: Bool = True
		var index: Int = 0

		while index < left.length():
			if result:
				match (left.get(index), right.get(index)):
					(Some(left_item), Some(right_item)):
						result = (
							types_equal(left_item[0], right_item[0])
							and types_equal(left_item[1], right_item[1])
						)
					_:
						result = False

			index += 1

		result


private pure func local_choose_symbol(definition_id: Int) -> FuncSymbol:
	func_symbol(
		definition_id,
		source_choose_func_type(),
		[make_bound_type_param("#N", []), make_bound_type_param("#M", [])],
		[Some("items"), Some("fallback")],
		Pure,
		UserDefinedFunc,
		AllowResourceArgs(ResourceResultDependent),
		None,
		source_dim_constraints(),
		Some(LoopProducerIndices),
		True,
	)


private pure func local_foreign_symbol(definition_id: Int) -> FuncSymbol:
	func_symbol(
		definition_id,
		SemanticFunctionType(True, [TYPE_INT], TYPE_INT),
		[],
		[Some("value")],
		Pure,
		ForeignFunc,
		RejectResourceArgs,
		None,
		[],
		None,
		False,
	)


private record PreparedChooseEntry {
	entry: AcceptedCallableEntry,
	local_symbol: FuncSymbol,
	module_path: String
}


private pure func entry_result_is_err(result: Result[AcceptedCallableEntry, String]) -> Bool:
	match result:
		Err(_):
			True
		Ok(_):
			False


private pure func prepared_choose_entry() -> Option[PreparedChooseEntry]:
	module_path = "model"
	owner = module_identity(module_path)
	graph ?= callable_graph_at(module_path, CALLABLE_SOURCE)
	header ?= callable_header_by_name(graph, "choose")
	type_headers = trait_topology_graph_type_headers(callable_header_graph_trait_topology(graph))
	local_symbol = local_choose_symbol(callable_id_definition_id(callable_header_id(header)))

	match prepare_accepted_callable_entry_from_local_symbol(
		type_headers,
		owner,
		module_path,
		header,
		local_symbol,
	):
		Ok(entry):
			Some({
				entry = entry,
				local_symbol = local_symbol,
				module_path = module_path,
			})
		Err(_):
			None


private pure func prepared_entry_preserves_local_metadata_inner() -> Option[Bool]:
	prepared ?= prepared_choose_entry()
	entry = prepared.entry
	local_symbol = prepared.local_symbol

	Some(
		(
			accepted_callable_definition_id_value(entry.definition_id) == local_symbol.callable_id
			and types_equal(entry.source_signature.func_type, source_choose_func_type())
			and entry.source_signature.type_params == local_symbol.type_params
			and entry.canonical_signature.type_params == local_symbol.type_params
			and entry.source_signature.dim_constraints == local_symbol.dim_constraints
			and entry.param_names == local_symbol.param_names
			and entry.purity == local_symbol.purity
			and entry.origin == local_symbol.origin
			and entry.resource_args == local_symbol.resource_args
			and entry.loop_producer == local_symbol.loop_producer
			and entry.debug_only == local_symbol.debug_only
		),
	)


pure func test_prepared_entry_preserves_local_metadata() -> Bool:
	prepared_entry_preserves_local_metadata_inner().get_or(False)


private pure func prepared_entry_computes_canonical_signature_inner() -> Option[Bool]:
	prepared ?= prepared_choose_entry()

	Some(
		types_equal(
			prepared.entry.canonical_signature.func_type,
			canonical_choose_func_type(prepared.module_path),
		),
	)


pure func test_prepared_entry_computes_canonical_signature() -> Bool:
	prepared_entry_computes_canonical_signature_inner().get_or(False)


private pure func prepared_entry_computes_canonical_dimensions_inner() -> Option[Bool]:
	prepared ?= prepared_choose_entry()

	Some(
		dim_constraint_lists_equal(
			prepared.entry.canonical_signature.dim_constraints,
			source_dim_constraints(),
		),
	)


pure func test_prepared_entry_computes_canonical_dimensions() -> Bool:
	prepared_entry_computes_canonical_dimensions_inner().get_or(False)


private pure func prepared_entry_preserves_ufcs_eligibility_inner() -> Option[Bool]:
	prepared ?= prepared_choose_entry()
	Some(prepared.entry.ufcs_eligible)


pure func test_prepared_entry_preserves_ufcs_eligibility() -> Bool:
	prepared_entry_preserves_ufcs_eligibility_inner().get_or(False)


private pure func preparation_accepts_foreign_header_with_preserved_metadata_inner(

) -> Option[Bool]:
	module_path = "model"
	owner = module_identity(module_path)
	graph ?= callable_graph_at(module_path, CALLABLE_SOURCE)
	header ?= callable_header_by_name(graph, "native_payload")
	type_headers = trait_topology_graph_type_headers(callable_header_graph_trait_topology(graph))
	local_symbol = local_foreign_symbol(callable_id_definition_id(callable_header_id(header)))

	Some(
		match prepare_accepted_callable_entry_from_local_symbol(
			type_headers,
			owner,
			module_path,
			header,
			local_symbol,
		):
			Ok(entry):
				(
					entry.origin == ForeignFunc
					and entry.resource_args == RejectResourceArgs
					and types_equal(entry.source_signature.func_type, local_symbol.func_type)
					and entry.param_names == local_symbol.param_names
					and types_equal(
						entry.canonical_signature.func_type,
						SemanticFunctionType(True, [TYPE_INT], TYPE_INT),
					)
				)
			Err(_):
				False
	)


pure func test_preparation_accepts_foreign_header_with_preserved_metadata() -> Bool:
	preparation_accepts_foreign_header_with_preserved_metadata_inner().get_or(False)


private pure func preparation_rejects_identity_and_metadata_mismatches_inner() -> Option[Bool]:
	module_path = "model"
	owner = module_identity(module_path)
	other_owner = module_identity("other")
	graph ?= callable_graph_at(module_path, CALLABLE_SOURCE)
	header ?= callable_header_by_name(graph, "choose")
	type_headers = trait_topology_graph_type_headers(callable_header_graph_trait_topology(graph))
	definition_id = callable_id_definition_id(callable_header_id(header))

	wrong_id = local_choose_symbol(definition_id + 1)
	wrong_origin = { local_choose_symbol(definition_id) | origin = ForeignFunc }
	wrong_arity = { local_choose_symbol(definition_id) |
		func_type = SemanticFunctionType(True, [payload_array("Payload")], payload_type("Payload"))
	}
	wrong_shape = { local_choose_symbol(definition_id) | func_type = payload_type("Payload") }
	wrong_names = { local_choose_symbol(definition_id) | param_names = [Some("items")] }
	wrong_type_params = { local_choose_symbol(definition_id) |
		type_params = [make_bound_type_param("#N", []), make_bound_type_param("#Other", [])]
	}

	Some(
		(
			entry_result_is_err(
				prepare_accepted_callable_entry_from_local_symbol(
					type_headers,
					other_owner,
					module_path,
					header,
					local_choose_symbol(definition_id),
				),
			)
			and entry_result_is_err(
				prepare_accepted_callable_entry_from_local_symbol(
					type_headers,
					owner,
					module_path,
					header,
					wrong_shape,
				),
			)
			and entry_result_is_err(
				prepare_accepted_callable_entry_from_local_symbol(
					type_headers,
					owner,
					module_path,
					header,
					wrong_id,
				),
			)
			and entry_result_is_err(
				prepare_accepted_callable_entry_from_local_symbol(
					type_headers,
					owner,
					module_path,
					header,
					wrong_origin,
				),
			)
			and entry_result_is_err(
				prepare_accepted_callable_entry_from_local_symbol(
					type_headers,
					owner,
					module_path,
					header,
					wrong_arity,
				),
			)
			and entry_result_is_err(
				prepare_accepted_callable_entry_from_local_symbol(
					type_headers,
					owner,
					module_path,
					header,
					wrong_names,
				),
			)
			and entry_result_is_err(
				prepare_accepted_callable_entry_from_local_symbol(
					type_headers,
					owner,
					module_path,
					header,
					wrong_type_params,
				),
			)
		),
	)


pure func test_preparation_rejects_identity_and_metadata_mismatches() -> Bool:
	preparation_rejects_identity_and_metadata_mismatches_inner().get_or(False)


private pure func preparation_preserves_env_ufcs_eligibility_rule_inner() -> Option[Bool]:
	module_path = "model"
	owner = module_identity(module_path)
	graph ?= callable_graph_at(module_path, CALLABLE_SOURCE)
	nullary ?= callable_header_by_name(graph, "nullary")
	type_headers = trait_topology_graph_type_headers(callable_header_graph_trait_topology(graph))
	nullary_id = callable_id_definition_id(callable_header_id(nullary))
	nullary_symbol = func_symbol(
		nullary_id,
		SemanticFunctionType(True, [], payload_type("Payload")),
		[],
		[],
		Pure,
		UserDefinedFunc,
		RejectResourceArgs,
		None,
		[],
		None,
		False,
	)

	Some(
		match prepare_accepted_callable_entry_from_local_symbol(
			type_headers,
			owner,
			module_path,
			nullary,
			nullary_symbol,
		):
			Ok(entry):
				not entry.ufcs_eligible
			Err(_):
				False
	)


pure func test_preparation_preserves_env_ufcs_eligibility_rule() -> Bool:
	preparation_preserves_env_ufcs_eligibility_rule_inner().get_or(False)


tests: TestSuite = {
	description = "Compiler callable entry preparation",
	tests = [
		("prepared entry preserves local metadata", test_prepared_entry_preserves_local_metadata),
		(
			"prepared entry computes canonical signature",
			test_prepared_entry_computes_canonical_signature,
		),
		(
			"prepared entry computes canonical dimensions",
			test_prepared_entry_computes_canonical_dimensions,
		),
		(
			"prepared entry preserves UFCS eligibility",
			test_prepared_entry_preserves_ufcs_eligibility,
		),
		(
			"preparation accepts foreign header with preserved metadata",
			test_preparation_accepts_foreign_header_with_preserved_metadata,
		),
		(
			"preparation rejects identity and metadata mismatches",
			test_preparation_rejects_identity_and_metadata_mismatches,
		),
		(
			"preparation preserves Env UFCS eligibility rule",
			test_preparation_preserves_env_ufcs_eligibility_rule,
		),
	]
}
