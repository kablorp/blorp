		AnalysisPlanningRequirement(AnalysisPlanRequired, NoAnalysisPlanRequired),
		InvalidationReason(
			ConfigurationInvalidated,
			DocumentIdentityInvalidated,
			ModuleSetInvalidated,
			SourceContentInvalidated,
			SourceRemoved,
		),
		WorkspaceError(
			OutOfOrderDocumentVersion,
			WorkspaceSourceIdentityConflict,
			WorkspaceSourceUnavailable,
		),
		WorkspaceTransition,
	../src/stage_12_lsp/document_model:
		DocumentChange,
		DocumentSave,
		DocumentVersion,
		OpenedDocument,
		VersionedDocumentText,
		document_version,
		document_version_value,
	../src/stage_12_lsp/document_store: document_store_find
	../src/stage_12_lsp/fingerprint_model:
		ContentFingerprint,
		content_fingerprint,
		content_fingerprints_equal,
	../src/stage_12_lsp/identity: DocumentUri, document_uri
	../src/stage_12_lsp/snapshot_model: configuration_epoch_value, workspace_revision_value
	../src/stage_12_lsp/workspace:
		Workspace,
