import:
	../src/stage_01_file_io/source:
		Cursor,
		SourceFile,
		SourceSpan,
		source_cursor_at,
		source_file,
		source_span,
	../src/stage_03_parse/parsed_ast:
		ParsedBinaryOp(ParsedAddOp),
		ParsedExpr(ParsedIntLiteralExpr),
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedTypeExpr(ParsedNamedType),
		ParsedVarDecl,
		parsed_identifier,
	../src/stage_05_types/env: Purity(Pure), ResourceArgPolicy(RejectResourceArgs)
	../src/stage_05_types/refinement: UNREFINED_BINDING
	../src/stage_05_types/semantic_type: TYPE_INT
	../src/stage_05_types/type_widening: ValueSlot(KeptValueSlot)
	../src/stage_06_typecheck/decl:
		TypedDecl(TypedFunctionDecl, TypedGlobalVarDecl, TypedPrivateDecl),
		TypedFunctionInfo,
		TypedGlobalVarInfo,
		TypedProgram,
	../src/stage_06_typecheck/infer:
		CallableOrigin(CallableLocal),
		ExprTypeOrigin(SynthesizedOrigin),
		ResolvedCallInfo,
		ResolvedCallTarget(ResolvedDirectCall),
		TypedExpr(TypedBinaryExpr, TypedCallExpr, TypedIntLiteralExpr, TypedNameExpr),
		TypedExprInfo,
	../src/stage_06_typecheck/modules/import_binding: ImportBinding(SelectiveDefinitionBinding)
	../src/stage_07_ctfe/context:
		CTFE_CONTEXT_EMPTY,
		CtfeContext,
		CtfeImportedProgram,
		complete_ctfe_imported_program,
		ctfe_context_from_program,
		ctfe_context_module_global_value,
	../src/stage_07_ctfe/env: CTFE_ENV_EMPTY, ctfe_lookup_value
	../src/stage_07_ctfe/eval:
		CtfeEvalError(CtfeEvalEnvError, CtfeEvalInModule),
		ctfe_eval_error_message,
	../src/stage_07_ctfe/globals:
		ctfe_eval_imported_program_global_envs,
		ctfe_eval_program_global_env,
		ctfe_evaluate_program_globals,
		ctfe_rewrite_program_globals,
		ctfe_rewrite_program_globals_with_import_bindings,
	../src/stage_07_ctfe/value: CtfeEnv, ctfe_int, ctfe_values_equal
	test: TestSuite


pure func fixture_source_file() -> SourceFile:
	source_file("ctfe_global_eval.brp", "ctfe_global_eval", "VALUE = 1")


pure func fixture_source_span() -> SourceSpan:
	src: SourceFile = fixture_source_file()
	cursor: Cursor = source_cursor_at(src, 0)
	source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, fixture_source_span())


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], fixture_source_span())


pure func parsed_var(name: String, is_mutable: Bool) -> ParsedVarDecl:
	{
		name = ident(name),
		type_expr = Some(named_type("Int")),
		value = ParsedIntLiteralExpr("0", fixture_source_span()),
		is_mutable = is_mutable,
		span = fixture_source_span()
	}


pure func expr_info() -> TypedExprInfo:
	{
		source_type = None,
		origin = SynthesizedOrigin("ctfe_global_eval_test"),
		value_slot = KeptValueSlot(TYPE_INT),
		proofs = UNREFINED_BINDING,
		resolved_call = None,
		resolved_definition_id = None,
		resource_dependencies = []
	}


pure func int_expr(text: String) -> TypedExpr:
	TypedIntLiteralExpr(text, fixture_source_span(), expr_info())


pure func name_expr(name: String) -> TypedExpr:
	TypedNameExpr(ident(name), expr_info())


pure func add_expr(left: TypedExpr, right: TypedExpr) -> TypedExpr:
	TypedBinaryExpr(ParsedAddOp, left, right, fixture_source_span(), expr_info())


pure func typed_global(name: String, is_mutable: Bool, value: TypedExpr) -> TypedGlobalVarInfo:
	{
		decl = parsed_var(name, is_mutable),
		definition_id = None,
		binding_type = TYPE_INT,
		source_type = Some(TYPE_INT),
		value = value
	}


pure func typed_global_decl(name: String, is_mutable: Bool, value: TypedExpr) -> TypedDecl:
	TypedGlobalVarDecl(typed_global(name, is_mutable, value))


pure func parsed_function(name: String) -> ParsedFunctionDecl:
	{
		name = ident(name),
		keyword_span = Some(fixture_source_span()),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = None,
		is_pure = True,
		annotations = [],
		doc = None,
		span = fixture_source_span()
	}


pure func typed_pure_function_decl(callable_id: Int, name: String, body: TypedExpr) -> TypedDecl:
	info: TypedFunctionInfo = {
		decl = parsed_function(name),
		callable_id = Some(callable_id),
		effective_type_params = [],
		param_types = [],
		source_return_type = None,
		semantic_return_type = TYPE_INT,
		body = Some(body)
	}
	TypedFunctionDecl(info)


pure func local_pure_call(callable_id: Int, name: String) -> TypedExpr:
	call: ResolvedCallInfo = {
		callee_name = name,
		source_name = name,
		purity = Pure,
		target = ResolvedDirectCall(callable_id, CallableLocal),
		instantiated_params = [],
		instantiated_return = TYPE_INT,
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}
	callee_info: TypedExprInfo = { expr_info() | resolved_call = Some(call) }
	TypedCallExpr(
		TypedNameExpr(ident(name), callee_info),
		[],
		fixture_source_span(),
		callee_info,
	)


pure func private_typed_global_decl(name: String, is_mutable: Bool, value: TypedExpr) -> TypedDecl:
	TypedPrivateDecl(typed_global_decl(name, is_mutable, value))


pure func typed_program(decls: List[TypedDecl]) -> TypedProgram:
	{
		source = fixture_source_file(),
		decls = decls,
		diagnostics = [],
		type_definitions = [],
		type_references = []
	}


pure func selective_import_binding(
	local_name: String,
	module_path: String,
	source_name: String,
) -> ImportBinding:
	SelectiveDefinitionBinding(local_name, module_path, source_name)


pure func lookup_equals(env: CtfeEnv, name: String, expected: Int) -> Bool:
	match ctfe_lookup_value(env, name):
		Ok(value):
			ctfe_values_equal(
				value,
				ctfe_int(fixture_source_span(), expected),
			)
		Err(_):
			False


pure func result_error_message(result: Result[CtfeEnv, CtfeEvalError]) -> String:
	match result:
		Err(error):
			ctfe_eval_error_message(error)
		Ok(_):
			""


pure func imported_module_env_error_message(
	result: Result[CtfeContext, CtfeEvalError],
	expected_module_path: String,
) -> String:
	match result:
		Err(CtfeEvalInModule(module_path, cause)):
			match cause:
				CtfeEvalEnvError(_):
					if module_path == expected_module_path:
						ctfe_eval_error_message(CtfeEvalInModule(module_path, cause))
					else:
						""
				_:
					""
		Err(_):
			""
		Ok(_):
			""


func test_eval_program_globals_in_source_order() -> Bool:
	program = typed_program([
		typed_global_decl("A", False, int_expr("1")),
		typed_global_decl(
			"B",
			False,
			add_expr(name_expr("A"), int_expr("2")),
		),
	])
	result = ctfe_eval_program_global_env(CTFE_CONTEXT_EMPTY, CTFE_ENV_EMPTY, program)

	match result:
		Ok(env):
			lookup_equals(env, "A", 1) and lookup_equals(env, "B", 3)
		Err(_):
			False


func test_eval_program_rejects_later_global_reference() -> Bool:
	program = typed_program([
		typed_global_decl("A", False, name_expr("B")),
		typed_global_decl("B", False, int_expr("2")),
	])

	result_error_message(
		ctfe_eval_program_global_env(
			CTFE_CONTEXT_EMPTY,
			CTFE_ENV_EMPTY,
			program,
		),
	) == "global constant initializer cannot reference later global constant 'B'"


func test_eval_program_rejects_self_reference() -> Bool:
	program = typed_program([typed_global_decl("A", False, name_expr("A"))])

	result_error_message(
		ctfe_eval_program_global_env(
			CTFE_CONTEXT_EMPTY,
			CTFE_ENV_EMPTY,
			program,
		),
	) == "global constant initializer cannot reference itself: 'A'"


func test_eval_program_keeps_mutable_global_runtime_initialized() -> Bool:
	program = typed_program([
		typed_global_decl("RUNTIME", True, int_expr("1")),
		typed_global_decl("A", False, name_expr("RUNTIME")),
	])

	result_error_message(
		ctfe_eval_program_global_env(
			CTFE_CONTEXT_EMPTY,
			CTFE_ENV_EMPTY,
			program,
		),
	) == (
		"global constant initializer cannot reference global 'RUNTIME' because it is not "
		+ "a compile-time constant"
	)


func test_eval_program_evaluates_private_globals() -> Bool:
	program = typed_program([
		private_typed_global_decl("HIDDEN", False, int_expr("5")),
		typed_global_decl(
			"PUBLIC",
			False,
			add_expr(name_expr("HIDDEN"), int_expr("1")),
		),
	])
	result = ctfe_eval_program_global_env(CTFE_CONTEXT_EMPTY, CTFE_ENV_EMPTY, program)

	match result:
		Ok(env):
			lookup_equals(env, "HIDDEN", 5) and lookup_equals(env, "PUBLIC", 6)
		Err(_):
			False


func test_eval_imported_program_global_envs_attach_to_context() -> Bool:
	imported_programs: List[CtfeImportedProgram] = [
		complete_ctfe_imported_program(
			"dep",
			[typed_global_decl("VALUE", False, int_expr("42"))],
			[],
		),
	]
	result: Result[CtfeContext, CtfeEvalError] = ctfe_eval_imported_program_global_envs(
		CTFE_CONTEXT_EMPTY,
		imported_programs,
	)

	match result:
		Ok(context):
			match ctfe_context_module_global_value(context, "dep", "VALUE"):
				Some(value):
					ctfe_values_equal(
						value,
						ctfe_int(fixture_source_span(), 42),
					)
				None:
					False
		Err(_):
			False


func test_eval_imported_global_pure_call_reads_prior_global() -> Bool:
	read_first_id: Int = 701
	imported_programs: List[CtfeImportedProgram] = [
		complete_ctfe_imported_program(
			"dep",
			[typed_global_decl("FIRST", False, int_expr("40")), typed_pure_function_decl(
					read_first_id,
					"read_first",
					add_expr(name_expr("FIRST"), int_expr("2")),
				), typed_global_decl(
					"SECOND",
					False,
					local_pure_call(read_first_id, "read_first"),
				)],
			[],
		),
	]
	context = ctfe_context_from_program(typed_program([]), imported_programs)
	result = ctfe_eval_imported_program_global_envs(context, imported_programs)

	match result:
		Ok(context):
			match ctfe_context_module_global_value(context, "dep", "SECOND"):
				Some(value):
					ctfe_values_equal(
						value,
						ctfe_int(fixture_source_span(), 42),
					)
				None:
					False
		Err(_):
			False


func test_eval_imported_global_error_names_module() -> Bool:
	imported_programs: List[CtfeImportedProgram] = [
		complete_ctfe_imported_program(
			"broken/dep",
			[typed_global_decl("VALUE", False, name_expr("MISSING"))],
			[],
		),
	]
	context = ctfe_context_from_program(typed_program([]), imported_programs)

	imported_module_env_error_message(
		ctfe_eval_imported_program_global_envs(context, imported_programs),
		"broken/dep",
	) == (
		"while evaluating global constants in imported module 'broken/dep': global "
		+ "constant initializer cannot reference 'MISSING' before it is evaluated"
	)


func test_eval_imported_global_pure_call_rejects_self_reference() -> Bool:
	read_self_id: Int = 702
	imported_programs: List[CtfeImportedProgram] = [
		complete_ctfe_imported_program(
			"self/dep",
			[
				typed_pure_function_decl(read_self_id, "read_self", name_expr("SELF")),
				typed_global_decl(
					"SELF",
					False,
					local_pure_call(read_self_id, "read_self"),
				),
			],
			[],
		),
	]
	context = ctfe_context_from_program(typed_program([]), imported_programs)

	imported_module_env_error_message(
		ctfe_eval_imported_program_global_envs(context, imported_programs),
		"self/dep",
	) == (
		"while evaluating global constants in imported module 'self/dep': global "
		+ "constant initializer cannot reference itself: 'SELF'"
	)


func test_eval_imported_global_pure_call_rejects_later_reference() -> Bool:
	read_later_id: Int = 703
	imported_programs: List[CtfeImportedProgram] = [
		complete_ctfe_imported_program(
			"later/dep",
			[
				typed_pure_function_decl(read_later_id, "read_later", name_expr("LATER")),
				typed_global_decl(
					"FIRST",
					False,
					local_pure_call(read_later_id, "read_later"),
				),
				typed_global_decl("LATER", False, int_expr("42")),
			],
			[],
		),
	]
	context = ctfe_context_from_program(typed_program([]), imported_programs)

	imported_module_env_error_message(
		ctfe_eval_imported_program_global_envs(context, imported_programs),
		"later/dep",
	) == (
		"while evaluating global constants in imported module 'later/dep': global "
		+ "constant initializer cannot reference later global constant 'LATER'"
	)


func test_eval_imported_global_pure_calls_keep_module_environments_isolated() -> Bool:
	left_reader_id: Int = 704
	right_reader_id: Int = 705
	imported_programs: List[CtfeImportedProgram] = [
		complete_ctfe_imported_program(
			"left",
			[
				typed_global_decl("VALUE", False, int_expr("1")),
				typed_pure_function_decl(left_reader_id, "read_value", name_expr("VALUE")),
				typed_global_decl(
					"RESULT",
					False,
					local_pure_call(left_reader_id, "read_value"),
				),
			],
			[],
		),
		complete_ctfe_imported_program(
			"right",
			[
				typed_global_decl("VALUE", False, int_expr("2")),
				typed_pure_function_decl(right_reader_id, "read_value", name_expr("VALUE")),
				typed_global_decl(
					"RESULT",
					False,
					local_pure_call(right_reader_id, "read_value"),
				),
			],
			[],
		),
	]
	context = ctfe_context_from_program(typed_program([]), imported_programs)

	match ctfe_eval_imported_program_global_envs(context, imported_programs):
		Ok(result_context):
			left_value = ctfe_context_module_global_value(result_context, "left", "RESULT")
			right_value = ctfe_context_module_global_value(result_context, "right", "RESULT")

			match (left_value, right_value):
				(Some(left), Some(right)):
					ctfe_values_equal(
						left,
						ctfe_int(fixture_source_span(), 1),
					) and ctfe_values_equal(
						right,
						ctfe_int(fixture_source_span(), 2),
					)
				_:
					False
		Err(_):
			False


func test_eval_imported_program_globals_use_dependency_bindings() -> Bool:
	imported_programs: List[CtfeImportedProgram] = [
		complete_ctfe_imported_program(
			"base",
			[typed_global_decl("VALUE", False, int_expr("40"))],
			[],
		),
		complete_ctfe_imported_program("dep", [typed_global_decl(
					"NEXT",
					False,
					add_expr(name_expr("VALUE"), int_expr("1")),
				)], [selective_import_binding("VALUE", "base", "VALUE")]),
	]
	result = ctfe_eval_imported_program_global_envs(CTFE_CONTEXT_EMPTY, imported_programs)

	match result:
		Ok(context):
			match ctfe_context_module_global_value(context, "dep", "NEXT"):
				Some(value):
					ctfe_values_equal(
						value,
						ctfe_int(fixture_source_span(), 41),
					)
				None:
					False
		Err(_):
			False


pure func rewrite_globals_fixture() -> Result[TypedProgram, CtfeEvalError]:
	program = typed_program([
		typed_global_decl(
			"A",
			False,
			add_expr(int_expr("1"), int_expr("2")),
		),
		typed_global_decl(
			"RUNTIME",
			True,
			add_expr(int_expr("3"), int_expr("4")),
		),
	])
	ctfe_rewrite_program_globals(CTFE_CONTEXT_EMPTY, CTFE_ENV_EMPTY, program)


func test_rewrite_program_globals_materializes_typed_initializer() -> Bool:
	result = rewrite_globals_fixture()

	match result:
		Ok(rewritten):
			match rewritten.decls.get(0):
				Some(TypedGlobalVarDecl(info)):
					match info.value:
						TypedIntLiteralExpr(text, _, _):
							text == "3"
						_:
							False
				_:
					False
		Err(_):
			False


func test_rewrite_program_globals_materializes_parsed_initializer() -> Bool:
	result = rewrite_globals_fixture()

	match result:
		Ok(rewritten):
			match rewritten.decls.get(0):
				Some(TypedGlobalVarDecl(info)):
					match info.decl.value:
						ParsedIntLiteralExpr(text, _):
							text == "3"
						_:
							False
				_:
					False
		Err(_):
			False


func test_rewrite_program_globals_keeps_materialized_global_immutable() -> Bool:
	result = rewrite_globals_fixture()

	match result:
		Ok(rewritten):
			match rewritten.decls.get(0):
				Some(TypedGlobalVarDecl(info)):
					not info.decl.is_mutable
				_:
					False
		Err(_):
			False


func test_rewrite_program_globals_leaves_mutable_initializer_runtime() -> Bool:
	result = rewrite_globals_fixture()

	match result:
		Ok(rewritten):
			match rewritten.decls.get(1):
				Some(TypedGlobalVarDecl(info)):
					match info.value:
						TypedBinaryExpr(_, _, _, _, _):
							info.decl.is_mutable
						_:
							False
				_:
					False
		Err(_):
			False


func test_rewrite_program_globals_uses_selective_imported_constant() -> Bool:
	imported_programs: List[CtfeImportedProgram] = [
		complete_ctfe_imported_program(
			"dep",
			[typed_global_decl("OFFSET", False, int_expr("41"))],
			[],
		),
	]
	context_result = ctfe_eval_imported_program_global_envs(CTFE_CONTEXT_EMPTY, imported_programs)
	program = typed_program([typed_global_decl(
				"ANSWER",
				False,
				add_expr(name_expr("OFFSET"), int_expr("1")),
			)])

	match context_result:
		Ok(context):
			result = ctfe_rewrite_program_globals_with_import_bindings(
				context,
				[selective_import_binding("OFFSET", "dep", "OFFSET")],
				program,
			)

			match result:
				Ok(rewritten):
					match rewritten.decls.get(0):
						Some(TypedGlobalVarDecl(info)):
							match info.value:
								TypedIntLiteralExpr(text, _, _):
									text == "42"
								_:
									False
						_:
							False
				Err(_):
					False
		Err(_):
			False


func test_rewrite_program_globals_rejects_runtime_initialized_selective_import() -> Bool:
	imported_programs: List[CtfeImportedProgram] = [
		complete_ctfe_imported_program(
			"dep",
			[typed_global_decl("OFFSET", True, int_expr("41"))],
			[],
		),
	]
	context_result = ctfe_eval_imported_program_global_envs(CTFE_CONTEXT_EMPTY, imported_programs)
	program = typed_program([typed_global_decl("ANSWER", False, name_expr("OFFSET"))])

	match context_result:
		Ok(context):
			result = ctfe_rewrite_program_globals_with_import_bindings(
				context,
				[selective_import_binding("OFFSET", "dep", "OFFSET")],
				program,
			)

			match result:
				Err(error):
					ctfe_eval_error_message(error) == (
						"global constant initializer cannot reference imported value 'dep.OFFSET' "
						+ "because it is not a compile-time constant"
					)
				Ok(_):
					False
		Err(_):
			False


func test_evaluate_program_globals_builds_context_and_rewrites_target() -> Bool:
	imported_programs: List[CtfeImportedProgram] = [
		complete_ctfe_imported_program(
			"dep",
			[typed_global_decl("OFFSET", False, int_expr("40"))],
			[],
		),
	]
	program = typed_program([typed_global_decl(
				"ANSWER",
				False,
				add_expr(name_expr("OFFSET"), int_expr("2")),
			)])
	result = ctfe_evaluate_program_globals(
		program,
		imported_programs,
		[selective_import_binding("OFFSET", "dep", "OFFSET")],
	)

	match result:
		Ok(rewritten):
			match rewritten.decls.get(0):
				Some(TypedGlobalVarDecl(info)):
					match info.value:
						TypedIntLiteralExpr(text, _, _):
							text == "42"
						_:
							False
				_:
					False
		Err(_):
			False


tests: TestSuite = {
	description = "Compiler CTFE global eval",
	tests = [
		("eval program globals in source order", test_eval_program_globals_in_source_order),
		(
			"eval program rejects later global reference",
			test_eval_program_rejects_later_global_reference,
		),
		("eval program rejects self reference", test_eval_program_rejects_self_reference),
		(
			"eval program keeps mutable global runtime initialized",
			test_eval_program_keeps_mutable_global_runtime_initialized,
		),
		("eval program evaluates private globals", test_eval_program_evaluates_private_globals),
		(
			"eval imported program global envs attach to context",
			test_eval_imported_program_global_envs_attach_to_context,
		),
		(
			"eval imported global pure call reads prior global",
			test_eval_imported_global_pure_call_reads_prior_global,
		),
		("eval imported global error names module", test_eval_imported_global_error_names_module),
		(
			"eval imported global pure call rejects self reference",
			test_eval_imported_global_pure_call_rejects_self_reference,
		),
		(
			"eval imported global pure call rejects later reference",
			test_eval_imported_global_pure_call_rejects_later_reference,
		),
		(
			"eval imported global pure calls keep module environments isolated",
			test_eval_imported_global_pure_calls_keep_module_environments_isolated,
		),
		(
			"eval imported program globals use dependency bindings",
			test_eval_imported_program_globals_use_dependency_bindings,
		),
		(
			"rewrite program globals materializes typed initializer",
			test_rewrite_program_globals_materializes_typed_initializer,
		),
		(
			"rewrite program globals materializes parsed initializer",
