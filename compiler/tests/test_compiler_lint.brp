					(
						execution.status == 0
						and execution.stderr == ""
						and execution.stdout.contains(
							path + ":1:40: advice[function.constant-parameter]: " + "Parameter 'bias' of private function 'add_bias' receives only 1 " + "across direct calls; consider removing the parameter.",
