import:
	../src/stage_03_parse/parser_bridge as ParserBridge
	../src/stage_12_cli/args:
		CliAction(CliError, CliLint),
		CliLintOutputFormat(CliLintJson, CliLintHuman),
		parse_cli_args,
	../src/stage_12_cli/cli: run_cli
	../src/stage_12_cli/lint: execute_lint_plan, lint_context, lint_module
	../src/stage_12_cli/lint_model:
		LintRuleId(
			LintConstantParameter,
			LintListAppendAccumulator,
			LintImmediateOptionMatch,
			LintLoopListLookup,
			LintManualListIndexLoop,
			LintRepeatedListLookup,
			LintPureNoParameters,
			LintSingleFieldRecord,
			LintSingleFieldStruct,
			LintSingleVariantUnion,
		),
		LintSeverity(LintAdvice),
		lint_rule_id_name,
	../src/stage_12_cli/plan:
		CliFrontendGraphSource,
		CliFrontendModuleGraph,
		CliFrontendModuleOrigin(CliFrontendUserModule),
		CliRunPlan(CliRunLint),
	../src/stage_12_cli/typecheck: typecheck_frontend_root_only
	json: JsonValue(JsonNumber), as_array, get_field, parse_json
	system: mkdir, remove_dir, remove_file, temp_dir, write_file
	test: TestSuite


private pure func lint_graph_source_named(
	path: String,
	module_name: String,
	source: String,
) -> CliFrontendGraphSource:
	{
		path = path,
		module_name = module_name,
		source_text = source,
		typecheck_program = ParserBridge.parsed_typecheck_source_bridge_artifact(
			path,
			module_name,
			source,
			False,
		).program,
		origin = CliFrontendUserModule
	}


private pure func lint_graph_source(source: String) -> CliFrontendGraphSource:
	lint_graph_source_named("/project/sample.brp", "sample", source)


private pure func lint_graph(root: CliFrontendGraphSource) -> CliFrontendModuleGraph:
	{
		context = {
			std_dir = None,
			source_packages = [],
			package_roots = []
		},
		roots = [root],
		modules = [],
		import_edges = [],
		diagnostics = []
	}


private func lint_source_stdout(path: String, source: String) -> Option[String]:
	_ = remove_file(path)

	match write_file(path, source):
		Err(_):
			None
		Ok(_):
			output: Option[String] = match run_cli(["lint", path]):
				CliRunLint(plan):
					execution = execute_lint_plan(plan)

					if execution.status == 0 and execution.stderr == "":
						Some(execution.stdout)
					else:
						None
				_:
					None

			_ = remove_file(path)
			output


pure func test_lint_cli_parses_human_defaults() -> Bool:
	match parse_cli_args(["lint", "sample.brp"]):
		CliLint(args):
			(
				args.output_format == CliLintHuman
				and not args.fail_on_findings
				and args.disabled_rules.length() == 0
				and args.paths == ["sample.brp"]
			)
		_:
			False


pure func test_lint_cli_parses_json_and_failure_mode() -> Bool:
	match parse_cli_args([
		"lint",
		"--format",
		"json",
		"--fail-on-findings",
		"--disable",
		"loop.list-lookup",
		"src",
	]):
		CliLint(args):
			(
				args.output_format == CliLintJson
				and args.fail_on_findings
				and args.disabled_rules == ["loop.list-lookup"]
				and args.paths == ["src"]
			)
		_:
			False


pure func test_lint_cli_rejects_unknown_format() -> Bool:
	match parse_cli_args([
		"lint",
		"--format",
		"xml",
		"sample.brp",
	]):
		CliError(message):
			message.contains("--format") and message.contains("human") and message.contains("json")
		_:
			False


pure func test_lint_cli_rejects_unknown_rule_suppression() -> Bool:
	match parse_cli_args([
		"lint",
		"--disable",
		"unknown.rule",
		"sample.brp",
	]):
		CliError(message):
			message.contains("unknown lint rule") and message.contains("unknown.rule")
		_:
			False


pure func test_single_field_record_finding_has_stable_contract() -> Bool:
	root = lint_graph_source("record Wrapper {value: Int}")
	typechecked = typecheck_frontend_root_only(lint_graph(root), root, False)
	findings = lint_module(typechecked.target, lint_context(typechecked))

	match findings:
		[finding]:
			(
				finding.rule_id == LintSingleFieldRecord
				and lint_rule_id_name(finding.rule_id) == "structure.single-field-record"
				and finding.severity == LintAdvice
				and finding.span.path == "/project/sample.brp"
				and finding.span.start_line == 1
				and finding.span.start_column == 8
				and finding.span.end_line == 1
				and finding.span.end_column == 15
				and finding.message == "Record 'Wrapper' has one field; consider using the field type directly."
			)
		_:
			False


pure func test_single_field_record_near_misses_are_not_reported() -> Bool:
	root = lint_graph_source(
		"record Empty {}\nrecord Pair {left: Int, right: Int}\nstruct EmptyStruct {}",
	)
	typechecked = typecheck_frontend_root_only(lint_graph(root), root, False)
	lint_module(typechecked.target, lint_context(typechecked)).length() == 0


pure func test_lint_findings_are_sorted_by_position() -> Bool:
	root = lint_graph_source("record First {value: Int}\nrecord Second {value: Int}")
	typechecked = typecheck_frontend_root_only(lint_graph(root), root, False)
	findings = lint_module(typechecked.target, lint_context(typechecked))

	match findings:
		[first, second]:
			first.span.start_line == 1 and second.span.start_line == 2
		_:
			False


func test_lint_execution_renders_human_and_failure_status() -> Bool:
	root = lint_graph_source("record Wrapper {value: Int}")
	result = execute_lint_plan({
		args = ["lint", "sample.brp"],
		options = {
			output_format = CliLintHuman,
			fail_on_findings = True,
			disabled_rules = [],
			paths = [root.path]
		},
		path_mappings = [
			{
				graph_path = root.path,
				display_path = root.path
			},
		],
		graph = lint_graph(root),
	})

	result.status == 1 and result.stderr == "" and result.stdout == (
		"/project/sample.brp:1:8: advice[structure.single-field-record]: Record "
		+ "'Wrapper' has one field; consider using the field type directly."
	)


func test_lint_execution_renders_versioned_json() -> Bool:
	root = lint_graph_source("record Wrapper {value: Int}")
	result = execute_lint_plan({
		args = ["lint", "--format", "json", "sample.brp"],
		options = {
			output_format = CliLintJson,
			fail_on_findings = False,
			disabled_rules = [],
			paths = [root.path]
		},
		path_mappings = [
			{
				graph_path = root.path,
				display_path = root.path
			},
		],
		graph = lint_graph(root),
	})

	match parse_json(result.stdout):
		Ok(value):
			schema_ok: Bool = match get_field(value, "schema_version"):
				Some(JsonNumber(version)):
					version == 1.0
				_:
					False

			findings_ok: Bool = match get_field(value, "findings"):
				Some(findings):
					as_array(findings)
						.map(func(items): items.length() == 1)
						.get_or(False)
				None:
					False

			result.status == 0 and result.stderr == "" and schema_ok and findings_ok
		Err(_):
			False


func test_lint_rule_suppression_filters_before_failure_status() -> Bool:
	root = lint_graph_source("record Wrapper {value: Int}")
	result = execute_lint_plan({
		args = ["lint", "--disable", "structure.single-field-record", "sample.brp"],
		options = {
			output_format = CliLintHuman,
			fail_on_findings = True,
			disabled_rules = ["structure.single-field-record"],
			paths = [root.path]
		},
		path_mappings = [
			{
				graph_path = root.path,
				display_path = root.path
			},
		],
		graph = lint_graph(root),
	})

	result.status == 0 and result.stdout == "" and result.stderr == ""


func test_lint_type_error_is_atomic_and_emits_empty_json() -> Bool:
	root = lint_graph_source("record Wrapper {value: Int}\npure func broken() -> Int: missing")
	result = execute_lint_plan({
		args = ["lint", "--format", "json", "sample.brp"],
		options = {
			output_format = CliLintJson,
			fail_on_findings = False,
			disabled_rules = [],
			paths = [root.path]
		},
		path_mappings = [
			{
				graph_path = root.path,
				display_path = root.path
			},
		],
		graph = lint_graph(root),
	})

	(
		result.status == 1
		and result.stderr.contains("missing")
		and result.stdout == "{\"schema_version\":1,\"findings\":[]}"
	)


func test_lint_directory_uses_canonical_multi_root_identities() -> Bool:
	root: String = temp_dir() + "/blorp lint duplicate stems"
	first_dir: String = root + "/alpha"
	second_dir: String = root + "/beta"
	first_path: String = first_dir + "/shared.brp"
	second_path: String = second_dir + "/shared.brp"
	_ = remove_file(first_path)
	_ = remove_file(second_path)
	_ = remove_dir(first_dir)
	_ = remove_dir(second_dir)
	_ = remove_dir(root)

	if (
		not mkdir(root)
		or not mkdir(first_dir)
		or not mkdir(second_dir)
	):
		False
	else:
		first_written = write_file(first_path, "record First {value: Int}")
		second_written = write_file(second_path, "record Second {value: Int}")

		result: Bool = match (first_written, second_written):
			(Ok(_), Ok(_)):
				match run_cli(["lint", root]):
					CliRunLint(plan):
						execution = execute_lint_plan(plan)

						(
							execution.status == 0
							and execution.stderr == ""
							and execution.stdout.contains("Record 'First' has one field")
							and execution.stdout.contains("Record 'Second' has one field")
						)
					_:
						False
			_:
				False

		_ = remove_file(first_path)
		_ = remove_file(second_path)
		_ = remove_dir(first_dir)
		_ = remove_dir(second_dir)
		_ = remove_dir(root)
		result


pure func test_structural_rules_report_exact_declaration_kinds() -> Bool:
	root = lint_graph_source(
		"struct Handle {value: Int}\nunion Only:\n\tOnly(Int)\nenum Direction:\n\tNorth",
	)
	typechecked = typecheck_frontend_root_only(lint_graph(root), root, False)
	findings = lint_module(typechecked.target, lint_context(typechecked))

	match findings:
		[struct_finding, union_finding]:
			(
				struct_finding.rule_id == LintSingleFieldStruct
				and struct_finding.span.start_line == 1
				and struct_finding.span.start_column == 8
				and struct_finding.message == "Struct 'Handle' has one field; consider using the field type directly."
				and union_finding.rule_id == LintSingleVariantUnion
				and union_finding.span.start_line == 2
				and union_finding.message == "Union 'Only' has one variant; consider using the variant payload directly."
			)
		_:
			False


