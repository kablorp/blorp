			)
		_:
			False


func test_list_lookup_inside_loop_reports_direct_iteration() -> Bool:
	path: String = temp_dir() + "/blorp_lint_direct_iteration.brp"

	match lint_source_stdout(
		path,
		"pure func sum(items: List[Int]) -> Int:\n" + "\tvar total: Int = 0\n" + "\tfor index in 0..items.length():\n" + "\t\ttotal = total + items.get_or(index, 0)\n" + "\ttotal",
	):
		Some(output):
			output.contains(
				path + ":4:25: advice[loop.list-lookup]: " + "List lookup inside a loop repeats indexing work; " + "iterate over elements directly.",
			)
		None:
			False


func test_loop_lookup_suggests_enumerate_when_index_is_used() -> Bool:
	path: String = temp_dir() + "/blorp_lint_enumerate_iteration.brp"

	match lint_source_stdout(
		path,
		"pure func weighted(items: List[Int]) -> Int:\n" + "\tvar total: Int = 0\n\tfor index in 0..items.length():\n" + "\t\ttotal = total + index * items.get_or(index, 0)\n\ttotal",
	):
		Some(output):
			output.contains("use enumerate to carry both each index and element")
		None:
			False


func test_loop_lookup_suggestions_distinguish_zip_and_windows() -> Bool:
	path: String = temp_dir() + "/blorp_lint_zip_windows.brp"

	match lint_source_stdout(
		path,
		"pure func neighbors(left: List[Int], right: List[Int]) -> Int:\n" + "\tvar total: Int = 0\n\tfor index in 0..left.length():\n" + "\t\ttotal = total + left.get_or(index, 0) + right.get_or(index, 0)\n" + "\t\ttotal = total + left.get_or(index + 1, 0)\n\ttotal",
	):
		Some(output):
			(
				output.contains("use zip to traverse the lists together")
				and output.contains("use windows to traverse neighboring elements")
			)
		None:
			False


func test_list_lookup_outside_loop_is_not_reported() -> Bool:
