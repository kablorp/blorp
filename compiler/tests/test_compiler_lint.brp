pure func test_immediate_option_match_reports_parameter_span() -> Bool:
	root = lint_graph_source(
		"pure func value_or(value: Option[Int], fallback: Int) -> Int:\n" + "\tmatch value:\n\t\tSome(item): item\n\t\tNone: fallback",
	)
	typechecked = typecheck_frontend_root_only(lint_graph(root), root, False)
	findings = lint_module(typechecked.target, lint_context(typechecked))

	match findings:
		[finding]:
			(
				finding.rule_id == LintImmediateOptionMatch
				and finding.span.start_line == 1
				and finding.span.start_column == 20
				and finding.message == (
					"Option parameter 'value' is matched immediately; consider accepting the "
					+ "unwrapped value at this API boundary."
				)
			)
		_:
			False


pure func test_immediate_option_match_ignores_unrelated_match_and_question_bind() -> Bool:
	unrelated = lint_graph_source(
		"pure func choose(value: Option[Int], flag: Bool) -> Int:\n" + "\tmatch flag:\n\t\tTrue: 1\n\t\tFalse: 0",
	)
	unrelated_checked = typecheck_frontend_root_only(lint_graph(unrelated), unrelated, False)
	unrelated_findings = lint_module(unrelated_checked.target, lint_context(unrelated_checked))

	question = lint_graph_source(
		"pure func forward(value: Option[Int]) -> Option[Int]:\n\titem ?= value\n\tSome(item)",
	)
	question_checked = typecheck_frontend_root_only(lint_graph(question), question, False)
	question_findings = lint_module(question_checked.target, lint_context(question_checked))

	unrelated_findings.length() == 0 and question_findings.length() == 0


