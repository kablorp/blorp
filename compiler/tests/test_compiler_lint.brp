func test_map_and_filter_map_accumulators_are_classified() -> Bool:
	source: String = "pure func doubled(source: List[Int]) -> List[Int]:\n" + "\tvar result: List[Int] = []\n\tfor item in source:\n" + "\t\tresult = result.append(item * 2)\n\tresult\n\n" + "pure func positive_doubled(source: List[Int]) -> List[Int]:\n" + "\tvar result: List[Int] = []\n\tfor item in source:\n" + "\t\tif item > 0:\n\t\t\tresult = result.append(item * 2)\n\tresult"

	path: String = temp_dir() + "/blorp_lint_map_accumulators.brp"
	_ = remove_file(path)

	match write_file(path, source):
		Err(_):
			False
		Ok(_):
			result: Bool = match run_cli(["lint", path]):
				CliRunLint(plan):
					execution = execute_lint_plan(plan)

					(
						execution.status == 0
						and execution.stderr == ""
						and execution.stdout.contains(
							"List accumulator 'result' is a map construction; consider map.",
						)
						and execution.stdout.contains(
							"List accumulator 'result' is a filter_map construction; consider filter_map.",
						)
					)
				_:
					False

			_ = remove_file(path)
			result


func test_private_constant_parameter_reports_exact_finding() -> Bool:
	source: String = "private pure func add_bias(value: Int, bias: Int) -> Int: value + bias\n" + "pure func first(value: Int) -> Int: add_bias(value, 1)\n" + "pure func second(value: Int) -> Int: add_bias(value, 1)"

	path: String = temp_dir() + "/blorp_lint_constant_parameter.brp"
	_ = remove_file(path)

	match write_file(path, source):
		Err(_):
			False
		Ok(_):
			result: Bool = match run_cli(["lint", path]):
