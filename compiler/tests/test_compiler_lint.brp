func test_shadowed_name_is_not_forwarded_as_caller_parameter() -> Bool:
	source: String = "private pure func target(mode: Bool) -> Bool: mode\n" + "private pure func caller(mode: Bool, value: Option[Bool]) -> Bool:\n" + "\tmatch value:\n\t\tSome(mode): target(mode)\n\t\tNone: False\n" + "pure func entry(value: Option[Bool]) -> Bool: caller(True, value)"

	path: String = temp_dir() + "/blorp_lint_shadowed_constant.brp"
