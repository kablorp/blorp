					execution = execute_lint_plan(plan)

					(
						execution.status == 0
						and execution.stderr == ""
						and not execution.stdout.contains(
							"Parameter 'mode' of private function 'target'",
						)
					)
				_:
					False

			_ = remove_file(path)
			result


func test_user_defined_collection_names_are_not_standard_list_operations() -> Bool:
	source: String = "private pure func get_or(items: List[Int], index: Int, fallback: Int) -> Int: fallback\n" + "private pure func append(items: List[Int], item: Int) -> List[Int]: items\n" + "pure func inspect(items: List[Int]) -> List[Int]:\n" + "\tvar result: List[Int] = []\n\tfor item in items:\n" + "\t\t_ = items.get_or(item, 0)\n\t\tresult = result.append(item)\n\tresult"

	path: String = temp_dir() + "/blorp_lint_user_collection_names.brp"
	_ = remove_file(path)

	match write_file(path, source):
		Err(_):
			False
		Ok(_):
			result: Bool = match run_cli(["lint", path]):
				CliRunLint(plan):
					execution = execute_lint_plan(plan)

					(
						execution.status == 0
						and execution.stderr == ""
						and not execution.stdout.contains("loop.list-lookup")
						and not execution.stdout.contains("collection.list-append-accumulator")
					)
				_:
					False

			_ = remove_file(path)
			result


func test_forwarded_boolean_constant_reaches_fixed_point_with_provenance() -> Bool:
	source: String = "private pure func target(value: Int, mode: Bool) -> Int: value\n" + "private pure func forward(value: Int, mode: Bool) -> Int: target(value, mode)\n" + "pure func first(value: Int) -> Int: forward(value, True)\n" + "pure func second(value: Int) -> Int: forward(value, True)"

	path: String = temp_dir() + "/blorp lint forwarded constant.brp"
	_ = remove_file(path)

	match write_file(path, source):
		Err(_):
			False
		Ok(_):
			result: Bool = match run_cli(["lint", path]):
				CliRunLint(plan):
					execution = execute_lint_plan(plan)

					(
						execution.status == 0
						and execution.stderr == ""
						and execution.stdout.contains(
							"Parameter 'mode' of private function 'target' receives only true",
						)
						and execution.stdout.contains("Call sites: " + path + ":")
					)
				_:
					False

			_ = remove_file(path)
			result


tests: TestSuite = {
	description = "Blorp lint",
	tests = [
		("lint CLI parses human defaults", test_lint_cli_parses_human_defaults),
		("lint CLI parses JSON and failure mode", test_lint_cli_parses_json_and_failure_mode),
		("lint CLI rejects unknown format", test_lint_cli_rejects_unknown_format),
		(
			"lint CLI rejects unknown rule suppression",
			test_lint_cli_rejects_unknown_rule_suppression,
		),
		(
			"single-field record finding has stable contract",
			test_single_field_record_finding_has_stable_contract,
		),
		(
			"single-field record near misses are not reported",
			test_single_field_record_near_misses_are_not_reported,
		),
		("lint findings are sorted by position", test_lint_findings_are_sorted_by_position),
		(
			"lint execution renders human and failure status",
			test_lint_execution_renders_human_and_failure_status,
		),
		("lint execution renders versioned JSON", test_lint_execution_renders_versioned_json),
		(
			"lint rule suppression filters before failure status",
			test_lint_rule_suppression_filters_before_failure_status,
		),
		(
			"lint type error is atomic and emits empty JSON",
			test_lint_type_error_is_atomic_and_emits_empty_json,
		),
		(
			"lint directory uses canonical multi-root identities",
			test_lint_directory_uses_canonical_multi_root_identities,
		),
		(
			"structural rules report exact declaration kinds",
			test_structural_rules_report_exact_declaration_kinds,
		),
		(
			"structural rule near misses are not reported",
			test_structural_rule_near_misses_are_not_reported,
		),
		(
			"pure no-parameter function reports exact finding",
			test_pure_no_parameter_function_reports_exact_finding,
		),
		(
			"pure no-parameter near misses are not reported",
			test_pure_no_parameter_near_misses_are_not_reported,
		),
		(
			"pure no-parameter computation is not reported",
			test_pure_no_parameter_computation_is_not_reported,
		),
		(
			"pure no-parameter aggregate value is reported",
			test_pure_no_parameter_aggregate_value_is_reported,
		),
		("generated module is not linted", test_generated_module_is_not_linted),
		("pure no-parameter callback is suppressed", test_pure_no_parameter_callback_is_suppressed),
		(
			"immediate Option match reports parameter span",
			test_immediate_option_match_reports_parameter_span,
		),
		(
			"immediate Option match ignores unrelated match and question bind",
			test_immediate_option_match_ignores_unrelated_match_and_question_bind,
		),
		(
			"immediate Option match selects exact parameter",
			test_immediate_option_match_selects_exact_parameter,
		),
		(
			"immediate Option match reports impl method",
			test_immediate_option_match_reports_impl_method,
		),
		(
			"list lookup inside loop reports direct iteration",
			test_list_lookup_inside_loop_reports_direct_iteration,
		),
		(
			"loop lookup suggestions distinguish zip and windows",
			test_loop_lookup_suggestions_distinguish_zip_and_windows,
		),
		(
			"loop lookup suggests enumerate when index is used",
			test_loop_lookup_suggests_enumerate_when_index_is_used,
		),
		("list lookup outside loop is not reported", test_list_lookup_outside_loop_is_not_reported),
		(
			"list subscript outside loop is not reported",
			test_list_subscript_outside_loop_is_not_reported,
		),
		(
			"nested loop lookup uses enclosing context",
			test_nested_loop_lookup_uses_enclosing_context,
		),
		("get inside loop is reported", test_get_inside_loop_is_reported),
		(
			"manual while list iteration reports loop span",
			test_manual_while_list_iteration_reports_loop_span,
		),
		(
			"unrelated while bound is not manual list iteration",
			test_unrelated_while_bound_is_not_manual_list_iteration,
		),
		(
			"repeated list lookup reports second lookup",
			test_repeated_list_lookup_reports_second_lookup,
		),
		(
			"filter accumulator reports exact classification",
			test_filter_accumulator_reports_exact_classification,
		),
		(
			"accumulator read during construction is not reported",
			test_accumulator_read_during_construction_is_not_reported,
		),
		(
			"map and filter_map accumulators are classified",
