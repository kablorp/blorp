func test_nested_loop_lookup_uses_enclosing_context() -> Bool:
	path: String = temp_dir() + "/blorp_lint_nested_loop_context.brp"

	match lint_source_stdout(
		path,
		"pure func inspect(groups: List[List[Int]]) -> Int:\n" + "\tvar total: Int = 0\n" + "\tfor item in groups.get_or(0, []):\n" + "\t\tfor nested in groups.get_or(0, []):\n" + "\t\t\ttotal += nested\n" + "\t\ttotal += groups.get_or(0, []).length()\n" + "\ttotal",
	):
		Some(output):
			(
				not output.contains(path + ":3:")
				and output.contains(path + ":4:")
				and output.contains(path + ":6:")
			)
		None:
			False


func test_get_inside_loop_is_reported() -> Bool:
	source: String = "pure func inspect(items: List[Int]) -> Int:\n" + "\tvar total: Int = 0\n\tfor item in items:\n" + "\t\tfirst: Option[Int] = items.get(0)\n\ttotal"

	path: String = temp_dir() + "/blorp_lint_get_and_subscript.brp"
	_ = remove_file(path)

	match write_file(path, source):
		Err(_):
			False
		Ok(_):
			result: Bool = match run_cli(["lint", path]):
				CliRunLint(plan):
					execution = execute_lint_plan(plan)

					(
						execution.status == 0
						and execution.stderr == ""
						and execution.stdout.contains(path + ":4:")
						and execution.stdout.contains("advice[loop.list-lookup]")
					)
				_:
					False

			_ = remove_file(path)
			result


func test_manual_while_list_iteration_reports_loop_span() -> Bool:
	source: String = "pure func sum(items: List[Int]) -> Int:\n" + "\tvar index: Int = 0\n\tvar total: Int = 0\n" + "\twhile index < items.length():\n" + "\t\ttotal = total + items.get_or(index, 0)\n\t\tindex = index + 1\n\ttotal"

	path: String = temp_dir() + "/blorp_lint_manual_while.brp"
	_ = remove_file(path)

	match write_file(path, source):
		Err(_):
			False
		Ok(_):
			result: Bool = match run_cli(["lint", path]):
				CliRunLint(plan):
					execution = execute_lint_plan(plan)

					(
						execution.status == 0
						and execution.stderr == ""
						and execution.stdout.contains(
							path + ":4:5: advice[loop.manual-list-index]: Manual index loop over a list",
						)
					)
				_:
					False

			_ = remove_file(path)
			result


pure func test_unrelated_while_bound_is_not_manual_list_iteration() -> Bool:
	root = lint_graph_source(
		"pure func wait(items: List[Int]) -> Int:\n" + "\tvar retry: Int = 0\n\twhile retry < items.length():\n" + "\t\tretry = retry + 1\n\titems.get_or(0, 0)",
	)
	typechecked = typecheck_frontend_root_only(lint_graph(root), root, False)
	findings = lint_module(typechecked.target, lint_context(typechecked))

	not findings.any(func(finding): finding.rule_id == LintManualListIndexLoop)


func test_repeated_list_lookup_reports_second_lookup() -> Bool:
	source: String = "pure func combine(items: List[Int]) -> Int:\n" + "\tvar total: Int = 0\n\tfor index in 0..items.length():\n" + "\t\tfirst: Int = items.get_or(index, 0)\n" + "\t\tsecond: Int = items.get_or(index, 0)\n" + "\t\ttotal = total + first + second\n\ttotal"

	path: String = temp_dir() + "/blorp_lint_repeated_lookup.brp"
	_ = remove_file(path)

