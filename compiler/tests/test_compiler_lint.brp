			result


func test_filter_accumulator_reports_exact_classification() -> Bool:
	source: String = "pure func positives(source: List[Int]) -> List[Int]:\n" + "\tvar result: List[Int] = []\n\tfor item in source:\n" + "\t\tif item > 0:\n\t\t\tresult = result.append(item)\n\tresult"

	path: String = temp_dir() + "/blorp_lint_filter_accumulator.brp"
