import:
	../src/stage_03_parse/parser_bridge as ParserBridge
	../src/stage_04_modules/loaded_module:
		ModuleLoadCandidate,
		ModuleOrigin(UserModule),
		module_load_candidate,
		resolved_module_identity_from_resolver,
	../src/stage_06_typecheck/graph/indexed_graph:
		PreparedModuleScope,
		indexed_graph_build,
		prepared_module_program,
		prepared_module_scope_module,
	../src/stage_06_typecheck/headers/callable_headers: callable_header_graph_build
	../src/stage_06_typecheck/headers/callable_signature:
		callable_parameter_type,
		callable_signature_parameters,
	../src/stage_06_typecheck/headers/declaration_skeleton:
		declaration_skeleton_graph_build,
		impl_ids_equal,
		trait_id_name,
	../src/stage_06_typecheck/headers/implementation_headers:
		ImplementationHeaderGraph,
		ImplementationReceiverHeadCategory(DeclaredReceiverHead),
		explicit_implementation_method_signature,
		implementation_header_graph_build,
		implementation_header_graph_candidates,
		implementation_header_graph_error_message,
		implementation_header_graph_headers,
		implementation_header_id,
		implementation_header_method_ids,
		implementation_header_methods,
		implementation_header_parameters,
		implementation_header_receiver,
		implementation_header_receiver_head,
		implementation_header_trait_id,
		resolved_implementation_type_parameter_id,
	../src/stage_06_typecheck/headers/trait_headers: trait_topology_graph_build
	../src/stage_06_typecheck/headers/type_header_dependencies: type_alias_dependency_graph_validate
	../src/stage_06_typecheck/headers/type_header_graph:
		ResolvedTypeShape(DeclaredTypeShape, ImplementationTypeParameterShape),
		implementation_type_parameter_id_index,
		type_header_graph_build,
	../src/stage_06_typecheck/headers/type_parameter_headers: resolved_type_parameter_graph_build
	../src/stage_06_typecheck/modules/bound_module_graph:
		BoundModuleViewBinding(BoundModuleViewReady),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		bound_module_graph_build,
	../src/stage_06_typecheck/modules/module_view: COMPILER_MODULE_VIEW_EMPTY
	test: TestSuite


private pure func fixture_module_load_candidate(source: String) -> ModuleLoadCandidate:
	module_load_candidate_at("main", source)


private pure func module_load_candidate_at(
	module_path: String,
	source: String,
) -> ModuleLoadCandidate:
	module_load_candidate(
		resolved_module_identity_from_resolver(module_path, UserModule),
		ParserBridge.parsed_typecheck_source_bridge_artifact(
			module_path + ".brp",
			module_path,
			source,
			False,
		).program,
	)


private pure func accept_empty_view(scope: PreparedModuleScope) -> BoundModuleViewBinding:
	BoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private pure func implementation_graph(source: String) -> Option[ImplementationHeaderGraph]:
	implementation_graph_at("main", source)


private pure func implementation_graph_at(
	module_path: String,
	source: String,
) -> Option[ImplementationHeaderGraph]:
	indexed ?= indexed_graph_build(
		module_load_candidate_at(module_path, source),
		[],
	).to_option()
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	topology ?= trait_topology_graph_build(type_headers).to_option()
	callables ?= callable_header_graph_build(topology).to_option()
	implementation_header_graph_build(callables).to_option()


private pure func implementation_headers_are_exact_and_indexed() -> Option[Bool]:
	source: String =
		|trait Renderable:
		|	pure func render(value: Self) -> String
		|
		|record Box[T] {value: T}
		|
		|implements Renderable for Box[T]:
		|	pure func render(value: Box[T]) -> String:
		|		"box"
	graph ?= implementation_graph(source)
	foreign_graph ?= implementation_graph_at("other", source)
	header ?= implementation_header_graph_headers(graph).get(0)
	foreign_header ?= implementation_header_graph_headers(foreign_graph).get(0)
	parameter ?= implementation_header_parameters(header).get(0)
	method ?= implementation_header_methods(header).get(0)
	method_signature ?= explicit_implementation_method_signature(method)
	method_value ?= callable_signature_parameters(method_signature).get(0)
	candidate ?= implementation_header_graph_candidates(
		graph,
		implementation_header_trait_id(header),
		implementation_header_receiver_head(header),
	).get(0)

	Some(
		(
			implementation_header_graph_headers(graph).length() == 1
			and trait_id_name(implementation_header_trait_id(header)) == "Renderable"
			and implementation_header_receiver_head(header) == DeclaredReceiverHead
			and implementation_type_parameter_id_index(
				resolved_implementation_type_parameter_id(parameter),
			) == 0
			and impl_ids_equal(
				implementation_header_id(header),
				implementation_header_id(candidate),
			)
			and implementation_header_graph_candidates(
				graph,
				implementation_header_trait_id(foreign_header),
				implementation_header_receiver_head(header),
			).is_empty()
			and match implementation_header_receiver(header):
				DeclaredTypeShape(_, [ImplementationTypeParameterShape(_)]):
					(
						implementation_header_method_ids(header).length() == 1
						and match callable_parameter_type(method_value):
							DeclaredTypeShape(_, [ImplementationTypeParameterShape(_)]):
								True
							_:
								False
					)
				_:
					False
		),
	)


pure func test_implementation_headers_are_exact_and_indexed() -> Bool:
	implementation_headers_are_exact_and_indexed().get_or(False)


private pure func implementation_headers_reject_missing_required_method() -> Option[Bool]:
	source: String =
		|trait Renderable:
		|	pure func render(value: Self) -> String
		|
		|record Box {value: Int}
		|
		|implements Renderable for Box:
		|	pure func other(value: Box) -> String:
		|		"box"
	indexed ?= indexed_graph_build(fixture_module_load_candidate(source), []).to_option()
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	topology ?= trait_topology_graph_build(type_headers).to_option()
	callables ?= callable_header_graph_build(topology).to_option()

	match implementation_header_graph_build(callables):
		Ok(_):
			Some(False)
		Err(errors):
			Some(
				errors.any(func(error):
					implementation_header_graph_error_message(
						error,
					) == "implementation of 'Renderable' is missing required method 'render'"
				),
			)


pure func test_implementation_headers_reject_missing_required_method() -> Bool:
	implementation_headers_reject_missing_required_method().get_or(False)


private pure func implementation_headers_reject_method_parameter_owner_collision() -> Option[Bool]:
	source: String =
		|trait Renderable:
		|	pure func render(value: Self) -> String
		|
		|record Box[T] {value: T}
		|
		|implements Renderable for Box[T]:
		|	pure func render[T](value: Box[T]) -> String:
		|		"box"
	indexed ?= indexed_graph_build(fixture_module_load_candidate(source), []).to_option()
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	topology ?= trait_topology_graph_build(type_headers).to_option()
	callables ?= callable_header_graph_build(topology).to_option()

	match implementation_header_graph_build(callables):
		Ok(_):
			Some(False)
		Err(errors):
			Some(
				errors.any(func(error):
					implementation_header_graph_error_message(error) == (
						"implementation method 'render' redeclares implementation type parameter 'T'; "
						+ "remove it from the method's type parameter list because implementation "
						+ "parameters are already in scope"
					)
				),
			)


pure func test_implementation_headers_reject_method_parameter_owner_collision() -> Bool:
	implementation_headers_reject_method_parameter_owner_collision().get_or(False)


tests: TestSuite = {
	description = "Compiler implementation headers",
	tests = [
		(
			"resolve exact implementation headers and candidates",
			test_implementation_headers_are_exact_and_indexed,
		),
		(
			"reject missing required methods",
			test_implementation_headers_reject_missing_required_method,
		),
		(
			"reject method and implementation parameter owner collision",
			test_implementation_headers_reject_method_parameter_owner_collision,
		),
	]
}
