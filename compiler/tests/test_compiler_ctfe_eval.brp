func test_eval_checked_tensor_get_normalizes_negative_indices() -> Bool:
	row_type = SemanticArrayType(TYPE_INT, [SemanticConstIntType(2)])
	matrix_type = SemanticArrayType(
		TYPE_INT,
		[SemanticConstIntType(2), SemanticConstIntType(2)],
