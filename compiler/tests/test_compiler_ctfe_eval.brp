			CTFE_ENV_EMPTY,
			imported_call_expr("std/list", 50, "length#50", [list_expr], TYPE_INT),
		),
		ctfe_int(fixture_source_span(), 2),
	)
	append_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			CTFE_ENV_EMPTY,
			imported_call_expr(
				"std/list",
				51,
				"append#51",
				[list_expr, int_expr("3")],
				list_type,
			),
