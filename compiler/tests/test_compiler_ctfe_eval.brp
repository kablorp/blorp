func test_eval_while_break_and_continue_control_flow() -> Bool:
	i_payload: TypedVarDeclPayload = {
		name = ident("i"),
		annotation = Some(TYPE_INT),
		initializer = int_expr("0"),
		is_mutable = True,
		span = fixture_source_span()
	}
	total_payload: TypedVarDeclPayload = {
		name = ident("total"),
		annotation = Some(TYPE_INT),
		initializer = int_expr("0"),
		is_mutable = True,
		span = fixture_source_span()
	}
	increment_i = TypedAssignExpr(
		ident("i"),
		LocalAssignScope,
		int_binary_expr(ParsedAddOp, name_expr("i"), int_expr("1")),
		fixture_source_span(),
		void_expr_info(),
	)
	skip_two = TypedIfExpr(
		bool_binary_expr(ParsedEqualOp, name_expr("i"), int_expr("2")),
		TypedContinueExpr(fixture_source_span(), void_expr_info()),
		None,
		fixture_source_span(),
		void_expr_info(),
	)
	break_at_four = TypedIfExpr(
		bool_binary_expr(ParsedEqualOp, name_expr("i"), int_expr("4")),
		TypedBreakExpr(fixture_source_span(), void_expr_info()),
		None,
		fixture_source_span(),
		void_expr_info(),
	)
	add_to_total = TypedAssignExpr(
		ident("total"),
		LocalAssignScope,
		int_binary_expr(ParsedAddOp, name_expr("total"), name_expr("i")),
		fixture_source_span(),
		void_expr_info(),
	)
	body = TypedBlockExpr(
		[increment_i, skip_two, break_at_four, add_to_total],
		fixture_source_span(),
		void_expr_info(),
	)
	block = TypedBlockExpr(
		[
			TypedVarDeclExpr(i_payload, void_expr_info()),
			TypedVarDeclExpr(total_payload, void_expr_info()),
			TypedWhileExpr(
				bool_binary_expr(ParsedLessOp, name_expr("i"), int_expr("5")),
				body,
				fixture_source_span(),
				void_expr_info(),
			),
			name_expr("total"),
		],
		fixture_source_span(),
		expr_info(),
	)

	value_equals(
		ctfe_eval_typed_expr(CTFE_CONTEXT_EMPTY, CTFE_ENV_EMPTY, block),
		ctfe_int(fixture_source_span(), 4),
	)


