func test_eval_block_question_bind_result_ok_and_err() -> Bool:
	result_type = SemanticNamedType(
		"Result",
		[TYPE_INT, TYPE_STRING],
	)
	ok_env = ctfe_bind_global_value(
		CTFE_ENV_EMPTY,
		"value_result",
		ctfe_result_ok_value(
			result_type,
			fixture_source_span(),
			ctfe_int(fixture_source_span(), 40),
		),
	)
	err_env = ctfe_bind_global_value(
		CTFE_ENV_EMPTY,
		"value_result",
		ctfe_result_err_value(
			result_type,
			fixture_source_span(),
			ctfe_string(fixture_source_span(), "bad"),
		),
	)
	block = TypedBlockExpr(
		[TypedQuestionBindExpr(
				ident("value"),
				Some(TYPE_INT),
				name_expr_for("value_result", result_type),
				fixture_source_span(),
				expr_info_for(TYPE_VOID),
			), TypedBinaryExpr(
				ParsedAddOp,
				name_expr("value"),
				int_expr("2"),
				fixture_source_span(),
				expr_info(),
			)],
		fixture_source_span(),
		expr_info(),
	)
	err_block = TypedBlockExpr(
		[TypedQuestionBindExpr(
				ident("value"),
				Some(TYPE_INT),
				name_expr_for("value_result", result_type),
				fixture_source_span(),
				expr_info_for(TYPE_VOID),
			), name_expr("value")],
		fixture_source_span(),
		expr_info_for(result_type),
	)

	value_equals(
		ctfe_eval_typed_expr(CTFE_CONTEXT_EMPTY, ok_env, block),
		ctfe_int(fixture_source_span(), 42),
	) and value_equals(
		ctfe_eval_typed_expr(CTFE_CONTEXT_EMPTY, err_env, err_block),
		ctfe_result_err_value(
			result_type,
			fixture_source_span(),
			ctfe_string(fixture_source_span(), "bad"),
		),
	)


func test_eval_nullary_constructor_reference() -> Bool:
	result = ctfe_eval_typed_expr(
		constructor_context(),
		CTFE_ENV_EMPTY,
		TypedNameExpr(ident("None"), expr_info_for(SemanticNamedType("Option", [TYPE_INT]))),
	)

	match result:
		Ok(value):
			match value.desc:
				CtfeConstructorValue(payload):
					payload.name == "None" and payload.constructor_info.parent_type == "Option"
				_:
					False
		Err(_):
			False


func test_eval_string_interpolation() -> Bool:
	expr = TypedStringInterpolationPartsExpr(
		[
			TypedInterpolationLiteral("n="),
			TypedInterpolationExpr(int_expr("42")),
			TypedInterpolationLiteral(", flag="),
			TypedInterpolationExpr(bool_expr(True)),
			TypedInterpolationLiteral(", char="),
			TypedInterpolationExpr(char_expr(90)),
			TypedInterpolationLiteral(", text="),
			TypedInterpolationExpr(string_expr("ok")),
			TypedInterpolationLiteral(", float="),
			TypedInterpolationExpr(float_expr("2.75")),
		],
		False,
		fixture_source_span(),
		expr_info_for(TYPE_STRING),
	)

	match ctfe_eval_typed_expr(CTFE_CONTEXT_EMPTY, CTFE_ENV_EMPTY, expr):
		Ok(value):
			match value.desc:
				CtfeStringValue(text):
					text == "n=42, flag=True, char=Z, text=ok, float=2.75"
				_:
					False
		Err(_):
			False


