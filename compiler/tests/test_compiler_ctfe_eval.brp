		ctfe_int(fixture_source_span(), 42),
	)


func test_eval_imported_std_list_intrinsics() -> Bool:
	list_type = type_list(TYPE_INT)
	option_type = SemanticNamedType("Option", [TYPE_INT])
	list_expr = TypedListExpr(
