	) == "compile-time string case conversion currently supports ASCII input only"


func test_eval_lambda_preserves_lexical_environment() -> Bool:
	without_locals = match ctfe_eval_typed_expr(CTFE_CONTEXT_EMPTY, CTFE_ENV_EMPTY, lambda_expr()):
		Ok(value):
			match value.desc:
				CtfeLambdaValue(closure):
					not ctfe_has_local_bindings(closure.env)
				_:
					False
		Err(_):
			False

	local_env = ctfe_bind_local_value(
		CTFE_ENV_EMPTY,
		"offset",
		ctfe_int(fixture_source_span(), 3),
	)

	with_locals = match ctfe_eval_typed_expr(CTFE_CONTEXT_EMPTY, local_env, lambda_expr()):
		Ok(value):
			match value.desc:
				CtfeLambdaValue(closure):
					ctfe_has_local_bindings(closure.env)
				_:
					False
		Err(_):
			False

	without_locals and with_locals


func test_eval_lambda_call_uses_captured_local() -> Bool:
	env = ctfe_bind_local_value(
