import:
	../src/stage_01_file_io/source:
		Cursor,
		SourceFile,
		SourceSpan,
		source_cursor_at,
		source_file,
		source_span,
	../src/stage_03_parse/parsed_ast:
		ParsedBinaryOp(ParsedAddOp, ParsedEqualOp, ParsedLessOp),
		ParsedForBinder(ParsedForNameBinder, ParsedForTupleBinder),
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedLogicalOp(ParsedAndOp),
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder, ParsedParamTupleBinder),
		parsed_identifier,
	../src/stage_05_types/env: Purity(Pure), ResourceArgPolicy(RejectResourceArgs)
	../src/stage_05_types/refinement: UNREFINED_BINDING
	../src/stage_05_types/semantic_type:
		SemanticType(
			SemanticArrayType,
			SemanticConstIntType,
			SemanticFunctionType,
			SemanticNamedType,
			SemanticTupleType,
		),
		TYPE_BOOL,
		TYPE_CHAR,
		TYPE_FLOAT,
		TYPE_INT,
		TYPE_STRING,
		TYPE_VOID,
		type_list,
		types_equal,
	../src/stage_05_types/type_widening: ValueSlot(KeptValueSlot)
	../src/stage_06_typecheck/decl: TypedFunctionInfo
	../src/stage_06_typecheck/infer:
		CallableOrigin(CallableBuiltin, CallableConstructor, CallableImported, CallableLocal),
		ExprTypeOrigin(SynthesizedOrigin),
		ResolvedCallInfo,
		ResolvedCallTarget(ResolvedClosureCall, ResolvedDirectCall, ResolvedIntrinsicCall),
		TypedAssignScope(LocalAssignScope),
		TypedExpr(
			TypedAssignExpr,
			TypedBinaryExpr,
			TypedBlockExpr,
			TypedBoolLiteralExpr,
			TypedBreakExpr,
			TypedCallExpr,
			TypedCharLiteralExpr,
			TypedContinueExpr,
			TypedFieldAccessExpr,
			TypedFloatLiteralExpr,
			TypedForExpr,
			TypedIfExpr,
			TypedIntLiteralExpr,
			TypedListExpr,
			TypedLambdaExpr,
			TypedLogicalExpr,
			TypedMatchExpr,
			TypedNameExpr,
			TypedQuestionBindExpr,
			TypedRangeExpr,
			TypedRecordExpr,
			TypedRecordUpdateExpr,
			TypedStringInterpolationPartsExpr,
			TypedStringLiteralExpr,
			TypedTupleDestructExpr,
			TypedTupleExpr,
			TypedVarDeclExpr,
			TypedVectorExpr,
			TypedWhileExpr,
		),
		TypedExprInfo,
		TypedLambdaParam,
		TypedMatchCase,
		TypedPattern(TypedIntPattern, TypedNamePattern),
		TypedRecordField,
		TypedStringInterpolationPart(TypedInterpolationExpr, TypedInterpolationLiteral),
		TypedVarDeclPayload,
	../src/stage_07_ctfe/context:
		CTFE_CONTEXT_EMPTY,
		CtfeContext,
		CtfeFunction,
		ctfe_context_with_module_alias,
		ctfe_context_with_module_global_env,
	../src/stage_07_ctfe/env:
		CTFE_ENV_EMPTY,
		ctfe_bind_global_value,
		ctfe_bind_local_value,
		ctfe_has_local_bindings,
	../src/stage_07_ctfe/eval: CtfeEvalError, ctfe_eval_error_message, ctfe_eval_typed_expr
	../src/stage_07_ctfe/value:
		CtfeEnv,
		CtfeValue,
		CtfeValueDesc(
			CtfeBoolValue,
			CtfeConstructorValue,
			CtfeFloatValue,
			CtfeLambdaValue,
			CtfeListValue,
			CtfeRangeValue,
			CtfeRecordValue,
			CtfeStringValue,
		),
		ctfe_bool,
		ctfe_char,
		ctfe_constructor_info,
		ctfe_int,
		ctfe_string,
		ctfe_value,
		ctfe_values_equal,
	../src/stage_07_ctfe/value_ops:
		ctfe_option_none_value,
		ctfe_option_some_value,
		ctfe_result_err_value,
		ctfe_result_ok_value,
	test: TestSuite


pure func fixture_source_file() -> SourceFile:
	source_file("eval.brp", "eval", "VALUE = 1")


pure func fixture_source_span() -> SourceSpan:
	src: SourceFile = fixture_source_file()
	cursor: Cursor = source_cursor_at(src, 0)
	source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, fixture_source_span())


pure func expr_info_for(typ: SemanticType) -> TypedExprInfo:
	{
		source_type = None,
		origin = SynthesizedOrigin("ctfe_eval_test"),
		value_slot = KeptValueSlot(typ),
		proofs = UNREFINED_BINDING,
		resolved_call = None,
		resolved_definition_id = None,
		resource_dependencies = []
	}


pure func expr_info() -> TypedExprInfo:
	expr_info_for(TYPE_INT)


pure func lambda_expr() -> TypedExpr:
	TypedLambdaExpr(
		True,
		[],
		Some(TYPE_INT),
		int_expr("42"),
		fixture_source_span(),
		expr_info_for(SemanticFunctionType(True, [], TYPE_INT)),
	)


pure func void_expr_info() -> TypedExprInfo:
	expr_info_for(TYPE_VOID)


pure func expr_info_with_call(call: ResolvedCallInfo) -> TypedExprInfo:
	{ expr_info() | resolved_call = Some(call) }


pure func expr_info_for_with_call(typ: SemanticType, call: ResolvedCallInfo) -> TypedExprInfo:
	{ expr_info_for(typ) | resolved_call = Some(call) }


pure func int_expr(text: String) -> TypedExpr:
	TypedIntLiteralExpr(text, fixture_source_span(), expr_info())


pure func bool_expr(value: Bool) -> TypedExpr:
	TypedBoolLiteralExpr(value, fixture_source_span(), expr_info_for(TYPE_BOOL))


pure func char_expr(value: Int) -> TypedExpr:
	TypedCharLiteralExpr(value, fixture_source_span(), expr_info_for(TYPE_CHAR))


pure func float_expr(text: String) -> TypedExpr:
	TypedFloatLiteralExpr(text, fixture_source_span(), expr_info_for(TYPE_FLOAT))


pure func string_expr(value: String) -> TypedExpr:
	TypedStringLiteralExpr(value, fixture_source_span(), expr_info_for(TYPE_STRING))


pure func name_expr(name: String) -> TypedExpr:
	TypedNameExpr(ident(name), expr_info())


pure func name_expr_for(name: String, typ: SemanticType) -> TypedExpr:
	TypedNameExpr(ident(name), expr_info_for(typ))


pure func int_binary_expr(op: ParsedBinaryOp, left: TypedExpr, right: TypedExpr) -> TypedExpr:
	TypedBinaryExpr(op, left, right, fixture_source_span(), expr_info())


pure func bool_binary_expr(op: ParsedBinaryOp, left: TypedExpr, right: TypedExpr) -> TypedExpr:
	TypedBinaryExpr(op, left, right, fixture_source_span(), expr_info_for(TYPE_BOOL))


pure func name_expr_with_call(name: String, call: ResolvedCallInfo) -> TypedExpr:
	TypedNameExpr(ident(name), expr_info_with_call(call))


pure func local_resolved_call(callable_id: Int, source_name: String) -> ResolvedCallInfo:
	resolved_call_with_origin(callable_id, source_name, CallableLocal)


pure func resolved_call_with_origin(
	callable_id: Int,
	source_name: String,
	origin: CallableOrigin,
) -> ResolvedCallInfo:
	{
		callee_name = source_name,
		source_name = source_name,
		purity = Pure,
		target = ResolvedDirectCall(callable_id, origin),
		instantiated_params = [],
		instantiated_return = TYPE_INT,
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}


pure func resolved_call_with_return(
	callable_id: Int,
	source_name: String,
	origin: CallableOrigin,
	return_type: SemanticType,
) -> ResolvedCallInfo:
	{ resolved_call_with_origin(callable_id, source_name, origin) |
		instantiated_return = return_type
	}


pure func imported_call_expr(
	module_path: String,
	callable_id: Int,
	source_name: String,
	args: List[TypedExpr],
	return_type: SemanticType,
) -> TypedExpr:
	call = resolved_call_with_return(
		callable_id,
		source_name,
		CallableImported(module_path),
		return_type,
	)
	TypedCallExpr(
		name_expr_with_call(source_name, call),
		args,
		fixture_source_span(),
		expr_info_for_with_call(return_type, call),
	)


pure func lambda_call_expr() -> TypedExpr:
	lambda_param: TypedLambdaParam = {
		name = ident("value"),
		source_type = Some(TYPE_INT),
		param_type = TYPE_INT
	}
	body = TypedBinaryExpr(
		ParsedAddOp,
		name_expr("value"),
		name_expr("offset"),
		fixture_source_span(),
		expr_info(),
	)
	lambda_type = SemanticFunctionType(True, [TYPE_INT], TYPE_INT)
	lambda = TypedLambdaExpr(
		True,
		[lambda_param],
		Some(TYPE_INT),
		body,
		fixture_source_span(),
		expr_info_for(lambda_type),
	)
	call: ResolvedCallInfo = {
		callee_name = "<lambda>",
		source_name = "<lambda>",
		purity = Pure,
		target = ResolvedClosureCall,
		instantiated_params = [TYPE_INT],
		instantiated_return = TYPE_INT,
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}

	TypedCallExpr(
		lambda,
		[int_expr("20")],
		fixture_source_span(),
		expr_info_for_with_call(TYPE_INT, call),
	)


pure func builtin_call_expr(name: String, arg: TypedExpr, return_type: SemanticType) -> TypedExpr:
	call = resolved_call_with_return(50, name, CallableBuiltin, return_type)
	TypedCallExpr(
		name_expr_with_call(name, call),
		[arg],
		fixture_source_span(),
		expr_info_for_with_call(return_type, call),
	)


pure func local_function_reference_expr(
	name: String,
	callable_id: Int,
	param_types: List[SemanticType],
	return_type: SemanticType,
) -> TypedExpr:
	source_name = name + "#" + callable_id.to_string()
	call = resolved_call_with_return(callable_id, source_name, CallableLocal, return_type)
	function_type = SemanticFunctionType(True, param_types, return_type)
	TypedNameExpr(
		ident(name),
		expr_info_for_with_call(function_type, call),
	)


pure func constructor_context() -> CtfeContext:
	{
		functions = [],
		imported_functions = [],
		constructors = [("None", ctfe_constructor_info("Option", 0, None))],
		module_aliases = [],
		module_global_envs = [],
		active_module_path = None
	}


pure func param(name: String) -> ParsedParam:
	{
		binder = ParsedParamNameBinder(ident(name)),
		type_expr = None,
		span = fixture_source_span()
	}


pure func tuple_param(names: List[String]) -> ParsedParam:
	{
		binder = ParsedParamTupleBinder(
			names.map(func(name): ident(name)),
			fixture_source_span(),
		),
		type_expr = None,
		span = fixture_source_span()
	}


pure func parsed_function_decl(
	name: String,
	params: List[ParsedParam],
	is_pure: Bool,
) -> ParsedFunctionDecl:
	{
		name = ident(name),
		keyword_span = Some(fixture_source_span()),
		type_params = [],
		params = params,
		return_type = None,
		dim_constraints = [],
		body = None,
		is_pure = is_pure,
		annotations = [],
		doc = None,
		span = fixture_source_span()
	}


pure func typed_function_info(
	callable_id: Int,
	name: String,
	params: List[ParsedParam],
	body: Option[TypedExpr],
	is_pure: Bool,
) -> TypedFunctionInfo:
	{
		decl = parsed_function_decl(name, params, is_pure),
		callable_id = Some(callable_id),
		effective_type_params = [],
		param_types = [],
		source_return_type = None,
		semantic_return_type = TYPE_INT,
		body = body
	}


pure func ctfe_function(
	callable_id: Int,
	name: String,
	params: List[ParsedParam],
	body: Option[TypedExpr],
	is_pure: Bool,
) -> CtfeFunction:
	{
		info = typed_function_info(callable_id, name, params, body, is_pure),
		source_name = name,
		module_path = None
	}


pure func imported_ctfe_function(
	module_path: String,
	callable_id: Int,
	name: String,
	params: List[ParsedParam],
	body: Option[TypedExpr],
	is_pure: Bool,
) -> CtfeFunction:
	{ ctfe_function(callable_id, name, params, body, is_pure) | module_path = Some(module_path) }


pure func function_context(functions: List[(Int, CtfeFunction)]) -> CtfeContext:
	{
		functions = functions,
		imported_functions = [],
		constructors = [],
		module_aliases = [],
		module_global_envs = [],
		active_module_path = None
	}


pure func imported_function_context(
	module_path: String,
	source_name: String,
	functions: List[CtfeFunction],
) -> CtfeContext:
	{
		functions = [],
		imported_functions = [
			{
				module_path = module_path,
				source_name = source_name,
				functions = functions
			},
		],
		constructors = [],
		module_aliases = [],
		module_global_envs = [],
		active_module_path = None
	}


pure func imported_function_context_with_global(
	module_path: String,
	source_name: String,
	functions: List[CtfeFunction],
	global_name: String,
	global_value: CtfeValue,
) -> CtfeContext:
	{
		functions = [],
		imported_functions = [
			{
				module_path = module_path,
				source_name = source_name,
				functions = functions
			},
		],
		constructors = [],
		module_aliases = [],
		module_global_envs = [
			{
				module_path = module_path,
				env = ctfe_bind_global_value(CTFE_ENV_EMPTY, global_name, global_value)
			},
		],
		active_module_path = None
	}


pure func imported_global_context(
	alias_name: String,
	module_path: String,
	global_name: String,
	global_value: CtfeValue,
) -> CtfeContext:
	with_alias = ctfe_context_with_module_alias(CTFE_CONTEXT_EMPTY, alias_name, module_path)
	ctfe_context_with_module_global_env(
		with_alias,
		module_path,
		ctfe_bind_global_value(CTFE_ENV_EMPTY, global_name, global_value),
	)


pure func value_equals(result: Result[CtfeValue, CtfeEvalError], expected: CtfeValue) -> Bool:
	match result:
		Ok(value):
			ctfe_values_equal(value, expected)
		Err(_):
			False


pure func error_message(result: Result[CtfeValue, CtfeEvalError]) -> String:
	match result:
		Err(error):
			ctfe_eval_error_message(error)
		Ok(_):
			""


func test_eval_literals_and_binary_ops() -> Bool:
	expr = TypedBinaryExpr(
		ParsedAddOp,
		int_expr("20"),
		int_expr("22"),
		fixture_source_span(),
		expr_info(),
	)
	result = ctfe_eval_typed_expr(CTFE_CONTEXT_EMPTY, CTFE_ENV_EMPTY, expr)

	value_equals(
		result,
		ctfe_int(fixture_source_span(), 42),
	)


func test_eval_identifier_lookup() -> Bool:
	env = ctfe_bind_global_value(
		CTFE_ENV_EMPTY,
		"VALUE",
		ctfe_int(fixture_source_span(), 9),
	)

	value_equals(
		ctfe_eval_typed_expr(CTFE_CONTEXT_EMPTY, env, name_expr("VALUE")),
		ctfe_int(fixture_source_span(), 9),
	)


func test_eval_logical_short_circuits() -> Bool:
	expr = TypedLogicalExpr(
		ParsedAndOp,
		bool_expr(False),
		name_expr("MISSING"),
		fixture_source_span(),
		expr_info_for(TYPE_BOOL),
	)

	match ctfe_eval_typed_expr(CTFE_CONTEXT_EMPTY, CTFE_ENV_EMPTY, expr):
		Ok(value):
			match value.desc:
				CtfeBoolValue(result):
					not result
				_:
					False
		Err(_):
			False


func test_eval_collection_and_record_values() -> Bool:
	list_expr = TypedListExpr(
		[int_expr("1"), int_expr("2")],
		fixture_source_span(),
		expr_info_for(type_list(TYPE_INT)),
	)
	record_field: TypedRecordField = {
		name = ident("value"),
		value = int_expr("3"),
		span = fixture_source_span(),
		definition_id = None
	}
	record_expr = TypedRecordExpr(
		[record_field],
		fixture_source_span(),
		expr_info_for(SemanticNamedType("Box", [])),
	)

	list_result = ctfe_eval_typed_expr(CTFE_CONTEXT_EMPTY, CTFE_ENV_EMPTY, list_expr)
	record_result = ctfe_eval_typed_expr(CTFE_CONTEXT_EMPTY, CTFE_ENV_EMPTY, record_expr)

	var list_ok: Bool = False

	match list_result:
		Ok(value):
			match value.desc:
				CtfeListValue(items):
					list_ok = items.length() == 2
				_:
					void
		Err(_):
			void

	var record_ok: Bool = False

	match record_result:
		Ok(value):
			match value.desc:
				CtfeRecordValue(fields):
					match fields.get(0):
						Some(field):
							(name, field_value) = field
							record_ok = name == "value" and ctfe_values_equal(
								field_value,
								ctfe_int(fixture_source_span(), 3),
							)
						None:
							void
				_:
					void
		Err(_):
			void

	list_ok and record_ok


func test_eval_if_range_field_and_record_update() -> Bool:
	base_field: TypedRecordField = {
		name = ident("value"),
		value = int_expr("1"),
		span = fixture_source_span(),
		definition_id = None
	}
	update_field: TypedRecordField = {
		name = ident("value"),
		value = int_expr("9"),
		span = fixture_source_span(),
		definition_id = None
	}
	record_expr = TypedRecordExpr(
		[base_field],
		fixture_source_span(),
		expr_info_for(SemanticNamedType("Box", [])),
	)
	if_expr = TypedIfExpr(
		bool_expr(False),
		name_expr("MISSING"),
		Some(int_expr("7")),
		fixture_source_span(),
		expr_info(),
	)
	range_expr = TypedRangeExpr(
		int_expr("0"),
		int_expr("3"),
		fixture_source_span(),
		expr_info_for(SemanticNamedType("Range", [])),
	)
	range_start_expr = TypedFieldAccessExpr(
		range_expr,
		ident("start"),
		fixture_source_span(),
		expr_info(),
	)
	range_end_expr = TypedFieldAccessExpr(
		range_expr,
		ident("end"),
		fixture_source_span(),
		expr_info(),
	)
	tuple_type = SemanticTupleType([TYPE_INT, TYPE_INT])
	tuple_field_expr = TypedFieldAccessExpr(
		TypedTupleExpr(
			[int_expr("40"), int_expr("2")],
			fixture_source_span(),
			expr_info_for(tuple_type),
		),
		ident("1"),
		fixture_source_span(),
		expr_info(),
	)
	field_expr = TypedFieldAccessExpr(
		record_expr,
		ident("value"),
		fixture_source_span(),
		expr_info(),
	)
	update_expr = TypedRecordUpdateExpr(
		record_expr,
		[update_field],
		[],
		fixture_source_span(),
		expr_info_for(SemanticNamedType("Box", [])),
	)
	env: CtfeEnv = CTFE_ENV_EMPTY
	context = CTFE_CONTEXT_EMPTY

	if_ok = value_equals(
		ctfe_eval_typed_expr(context, env, if_expr),
		ctfe_int(fixture_source_span(), 7),
	)
	field_ok = value_equals(
		ctfe_eval_typed_expr(context, env, field_expr),
		ctfe_int(fixture_source_span(), 1),
	)
	range_start_ok = value_equals(
		ctfe_eval_typed_expr(context, env, range_start_expr),
		ctfe_int(fixture_source_span(), 0),
	)
	range_end_ok = value_equals(
		ctfe_eval_typed_expr(context, env, range_end_expr),
		ctfe_int(fixture_source_span(), 3),
	)
	tuple_field_ok = value_equals(
		ctfe_eval_typed_expr(context, env, tuple_field_expr),
		ctfe_int(fixture_source_span(), 2),
	)

	var range_literal_ok: Bool = False

	match ctfe_eval_typed_expr(context, env, range_expr):
		Ok(value):
			match value.desc:
				CtfeRangeValue(start_value, end_value):
					range_literal_ok = ctfe_values_equal(
						start_value,
						ctfe_int(fixture_source_span(), 0),
					) and ctfe_values_equal(
						end_value,
						ctfe_int(fixture_source_span(), 3),
					)
				_:
					void
		Err(_):
			void

	var update_ok: Bool = False

	match ctfe_eval_typed_expr(context, env, update_expr):
		Ok(value):
			match value.desc:
				CtfeRecordValue(fields):
					match fields.get(0):
						Some(field):
							(name, field_value) = field
							update_ok = name == "value" and ctfe_values_equal(
								field_value,
								ctfe_int(fixture_source_span(), 9),
							)
						None:
							void
				_:
					void
		Err(_):
			void

	(
		if_ok
		and range_literal_ok
		and field_ok
		and range_start_ok
		and range_end_ok
		and tuple_field_ok
		and update_ok
	)


func test_eval_block_local_bindings() -> Bool:
	payload: TypedVarDeclPayload = {
		name = ident("x"),
		annotation = Some(TYPE_INT),
		initializer = int_expr("40"),
		is_mutable = False,
		span = fixture_source_span()
	}
	block = TypedBlockExpr(
		[
			TypedVarDeclExpr(payload, expr_info_for(TYPE_VOID)),
			TypedBinaryExpr(
				ParsedAddOp,
				name_expr("x"),
				int_expr("2"),
				fixture_source_span(),
				expr_info(),
			),
		],
		fixture_source_span(),
		expr_info(),
	)

	value_equals(
		ctfe_eval_typed_expr(CTFE_CONTEXT_EMPTY, CTFE_ENV_EMPTY, block),
		ctfe_int(fixture_source_span(), 42),
	)


func test_eval_block_mutable_local_assignment() -> Bool:
	payload: TypedVarDeclPayload = {
		name = ident("x"),
		annotation = Some(TYPE_INT),
		initializer = int_expr("1"),
		is_mutable = True,
		span = fixture_source_span()
	}
	block = TypedBlockExpr(
		[
			TypedVarDeclExpr(payload, expr_info_for(TYPE_VOID)),
			TypedAssignExpr(
				ident("x"),
				LocalAssignScope,
				int_expr("41"),
				fixture_source_span(),
				expr_info_for(TYPE_VOID),
			),
			TypedBinaryExpr(
				ParsedAddOp,
				name_expr("x"),
				int_expr("1"),
				fixture_source_span(),
				expr_info(),
			),
		],
		fixture_source_span(),
		expr_info(),
	)

	value_equals(
		ctfe_eval_typed_expr(CTFE_CONTEXT_EMPTY, CTFE_ENV_EMPTY, block),
		ctfe_int(fixture_source_span(), 42),
	)


