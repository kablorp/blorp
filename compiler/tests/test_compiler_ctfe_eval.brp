				fixture_source_span(),
				expr_info_for(row_type),
			),
			TypedVectorExpr(
				[int_expr("3"), int_expr("4")],
				fixture_source_span(),
				expr_info_for(row_type),
			),
		],
		fixture_source_span(),
		expr_info_for(matrix_type),
	)
	call: ResolvedCallInfo = {
		callee_name = "matrix_checked_get",
		source_name = "matrix_checked_get",
		purity = Pure,
		target = ResolvedIntrinsicCall,
		instantiated_params = [matrix_type, TYPE_INT, TYPE_INT],
		instantiated_return = TYPE_INT,
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}
	expr = TypedCallExpr(
		name_expr_with_call(
			"matrix_checked_get",
			call,
		),
		[matrix, int_expr("-1"), int_expr("-1")],
		fixture_source_span(),
		expr_info_with_call(call),
	)

	value_equals(
		ctfe_eval_typed_expr(CTFE_CONTEXT_EMPTY, CTFE_ENV_EMPTY, expr),
		ctfe_int(fixture_source_span(), 4),
	)


func test_eval_imported_sized_float_conversion_intrinsics() -> Bool:
	float32_type = SemanticNamedType("Float32", [])
	result = ctfe_eval_typed_expr(
		CTFE_CONTEXT_EMPTY,
		CTFE_ENV_EMPTY,
		imported_call_expr(
			"std/float",
			51,
			"to_float32#51",
			[float_expr("16777217.0")],
			float32_type,
		),
	)

	match result:
		Ok(value):
			match value.desc:
				CtfeFloatValue(raw):
					raw == 16777216.0 and types_equal(value.typ, float32_type)
				_:
					False
		Err(_):
			False


func test_eval_local_function_call_binds_tuple_param() -> Bool:
	call = local_resolved_call(11, "sum_pair#11")
	body = TypedBinaryExpr(
		ParsedAddOp,
		name_expr("left"),
		name_expr("right"),
		fixture_source_span(),
		expr_info(),
	)
	tuple_type = SemanticTupleType([TYPE_INT, TYPE_INT])
	expr = TypedCallExpr(
		name_expr_with_call(
			"sum_pair",
			call,
		),
		[
			TypedTupleExpr(
				[int_expr("40"), int_expr("2")],
				fixture_source_span(),
				expr_info_for(tuple_type),
			),
		],
		fixture_source_span(),
		expr_info_with_call(call),
	)
	context = function_context(
		[(11, ctfe_function(11, "sum_pair", [tuple_param(["left", "right"])], Some(body), True))],
	)

	value_equals(
		ctfe_eval_typed_expr(context, CTFE_ENV_EMPTY, expr),
		ctfe_int(fixture_source_span(), 42),
	)


