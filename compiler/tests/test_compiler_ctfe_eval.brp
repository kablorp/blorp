func test_eval_imported_std_option_and_result_intrinsics() -> Bool:
	option_type = SemanticNamedType("Option", [TYPE_INT])
	result_type = SemanticNamedType(
		"Result",
		[TYPE_INT, TYPE_STRING],
	)
	env = ctfe_bind_global_value(
		ctfe_bind_global_value(
			ctfe_bind_global_value(
				CTFE_ENV_EMPTY,
				"some_value",
				ctfe_option_some_value(
					option_type,
					fixture_source_span(),
					ctfe_int(fixture_source_span(), 7),
				),
			),
			"none_value",
			ctfe_option_none_value(option_type, fixture_source_span()),
		),
		"ok_value",
		ctfe_result_ok_value(
			result_type,
			fixture_source_span(),
			ctfe_int(fixture_source_span(), 9),
		),
	)
	some_get_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			env,
			imported_call_expr(
				"std/option",
				60,
				"get_or#60",
				[name_expr_for("some_value", option_type), int_expr("1")],
				TYPE_INT,
			),
		),
		ctfe_int(
			fixture_source_span(),
			7,
		),
	)
	none_is_none_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			env,
			imported_call_expr(
				"std/option",
				61,
				"is_none#61",
				[name_expr_for("none_value", option_type)],
				TYPE_BOOL,
			),
		),
		ctfe_bool(fixture_source_span(), True),
	)
	result_get_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			env,
			imported_call_expr(
				"std/result",
				62,
				"get_or#62",
				[name_expr_for("ok_value", result_type), int_expr("1")],
				TYPE_INT,
			),
		),
		ctfe_int(
			fixture_source_span(),
			9,
		),
	)
	from_some_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			env,
			imported_call_expr(
				"std/result",
				63,
				"from_option#63",
				[name_expr_for("some_value", option_type), string_expr("missing")],
				result_type,
			),
		),
		ctfe_result_ok_value(
			result_type,
			fixture_source_span(),
			ctfe_int(fixture_source_span(), 7),
		),
	)
	from_none_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			env,
			imported_call_expr(
				"std/result",
				64,
				"from_option#64",
				[name_expr_for("none_value", option_type), string_expr("missing")],
				result_type,
			),
		),
		ctfe_result_err_value(
			result_type,
			fixture_source_span(),
			ctfe_string(fixture_source_span(), "missing"),
		),
	)
	to_option_some_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			env,
			imported_call_expr(
				"std/result",
				65,
				"to_option#65",
				[name_expr_for("ok_value", result_type)],
				option_type,
			),
		),
		ctfe_option_some_value(
			option_type,
			fixture_source_span(),
			ctfe_int(fixture_source_span(), 9),
		),
	)
	err_value = ctfe_result_err_value(
		result_type,
		fixture_source_span(),
		ctfe_string(fixture_source_span(), "missing"),
	)
	to_option_none_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			ctfe_bind_global_value(env, "err_value", err_value),
			imported_call_expr(
				"std/result",
				66,
				"to_option#66",
				[name_expr_for("err_value", result_type)],
				option_type,
			),
		),
		ctfe_option_none_value(option_type, fixture_source_span()),
	)

	(
		some_get_ok
		and none_is_none_ok
		and result_get_ok
		and from_some_ok
		and from_none_ok
		and to_option_some_ok
		and to_option_none_ok
	)


