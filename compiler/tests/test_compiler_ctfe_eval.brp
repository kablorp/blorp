func test_eval_sized_float_conversion_builtins() -> Bool:
	float32_type = SemanticNamedType("Float32", [])
	float16_type = SemanticNamedType("Float16", [])
	float32_result = ctfe_eval_typed_expr(
		CTFE_CONTEXT_EMPTY,
		CTFE_ENV_EMPTY,
		builtin_call_expr("to_float32", float_expr("16777217.0"), float32_type),
	)
	float16_result = ctfe_eval_typed_expr(
		CTFE_CONTEXT_EMPTY,
		CTFE_ENV_EMPTY,
		builtin_call_expr("to_float16", float_expr("1.0001"), float16_type),
	)

	float32_ok = match float32_result:
		Ok(value):
			match value.desc:
				CtfeFloatValue(raw):
					raw == 16777216.0 and types_equal(value.typ, float32_type)
				_:
					False
		Err(_):
			False

	float16_ok = match float16_result:
		Ok(value):
			match value.desc:
				CtfeFloatValue(raw):
					raw == 1.0 and types_equal(value.typ, float16_type)
				_:
					False
		Err(_):
			False

	float32_ok and float16_ok


