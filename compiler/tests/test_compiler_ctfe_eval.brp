			CTFE_ENV_EMPTY,
			expr,
		),
	) == "compile-time imported function call 'dep/math.pick' is ambiguous"


func test_eval_imported_std_string_intrinsics() -> Bool:
	length_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			CTFE_ENV_EMPTY,
			imported_call_expr("std/string", 40, "length#40", [string_expr("blorp")], TYPE_INT),
		),
		ctfe_int(fixture_source_span(), 5),
	)
	substring_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			CTFE_ENV_EMPTY,
			imported_call_expr(
				"std/string",
				41,
				"substring#41",
				[string_expr("blorp"), int_expr("1"), int_expr("3")],
				TYPE_STRING,
			),
		),
		ctfe_string(
			fixture_source_span(),
			"lor",
		),
	)
	contains_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			CTFE_ENV_EMPTY,
			imported_call_expr(
				"std/string",
				42,
				"contains#42",
				[string_expr("blorp"), string_expr("or")],
				TYPE_BOOL,
			),
		),
		ctfe_bool(
			fixture_source_span(),
			True,
		),
	)
	index_type = SemanticNamedType("Option", [TYPE_INT])
	index_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			CTFE_ENV_EMPTY,
			imported_call_expr(
				"std/string",
				43,
				"index_of#43",
				[string_expr("blorp"), string_expr("or")],
				index_type,
			),
		),
		ctfe_option_some_value(
			index_type,
			fixture_source_span(),
			ctfe_int(fixture_source_span(), 2),
		),
	)

	upper_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			CTFE_ENV_EMPTY,
			imported_call_expr("std/string", 44, "upper#44", [string_expr("Blorp")], TYPE_STRING),
		),
		ctfe_string(fixture_source_span(), "BLORP"),
	)
	lower_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			CTFE_ENV_EMPTY,
			imported_call_expr("std/string", 45, "lower#45", [string_expr("Blorp")], TYPE_STRING),
		),
		ctfe_string(fixture_source_span(), "blorp"),
	)
	drop_left_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			CTFE_ENV_EMPTY,
			imported_call_expr(
				"std/string",
				47,
				"drop_left#47",
				[string_expr("blorp"), int_expr("2")],
				TYPE_STRING,
			),
		),
		ctfe_string(
			fixture_source_span(),
			"orp",
		),
	)
	take_left_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			CTFE_ENV_EMPTY,
			imported_call_expr(
				"std/string",
				48,
				"take_left#48",
				[string_expr("blorp"), int_expr("2")],
				TYPE_STRING,
			),
		),
		ctfe_string(
			fixture_source_span(),
			"bl",
		),
	)
	char_list_type = type_list(TYPE_CHAR)
	chars_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			CTFE_ENV_EMPTY,
			imported_call_expr("std/string", 49, "chars#49", [string_expr("az")], char_list_type),
		),
		ctfe_value(char_list_type, CtfeListValue([
				ctfe_char(fixture_source_span(), 'a'),
				ctfe_char(fixture_source_span(), 'z'),
			]), fixture_source_span()),
	)
	from_char_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			CTFE_ENV_EMPTY,
			imported_call_expr("std/string", 50, "from_char#50", [char_expr(90)], TYPE_STRING),
		),
		ctfe_string(fixture_source_span(), "Z"),
	)
	from_chars_ok = value_equals(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			CTFE_ENV_EMPTY,
			imported_call_expr(
				"std/string",
				51,
				"from_chars#51",
				[
					TypedListExpr(
						[char_expr(111), char_expr(107)],
						fixture_source_span(),
						expr_info_for(char_list_type),
					),
				],
				TYPE_STRING,
			),
		),
		ctfe_string(
			fixture_source_span(),
			"ok",
		),
	)

	(
		length_ok
		and substring_ok
		and contains_ok
		and index_ok
		and upper_ok
		and lower_ok
		and drop_left_ok
		and take_left_ok
		and chars_ok
		and from_char_ok
		and from_chars_ok
	)


func test_eval_imported_std_string_case_conversion_rejects_non_ascii() -> Bool:
	error_message(
		ctfe_eval_typed_expr(
			CTFE_CONTEXT_EMPTY,
			CTFE_ENV_EMPTY,
			imported_call_expr("std/string", 46, "upper#46", [string_expr("é")], TYPE_STRING),
