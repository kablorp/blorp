import:
	../src/stage_05_types/global_value_index: GLOBAL_VALUE_INDEX_EMPTY
	../src/stage_05_types/record_type_index: RECORD_TYPE_INDEX_EMPTY
	../src/stage_05_types/semantic_type: TYPE_INT
	../src/stage_05_types/type_alias_index: TYPE_ALIAS_INDEX_EMPTY, type_alias_index_add_transparent
	../src/stage_05_types/union_type_index: UNION_TYPE_INDEX_EMPTY
	../src/stage_06_typecheck/modules/import_binding:
		ImportBinding(QualifiedModuleBinding, SelectiveDefinitionBinding),
	../src/stage_06_typecheck/modules/module_view:
		COMPILER_MODULE_VIEW_EMPTY,
		ImportedConstructorBinding,
		LocalNameRegistration(
			LocalNameAdded,
			LocalNameAlreadyPresent,
			LocalNameConflictsWithAlias,
			LocalNameConflictsWithImportedName,
		),
		ModuleAliasRegistration(
			ModuleAliasAdded,
			ModuleAliasAlreadyPresent,
			ModuleAliasConflictsWithAlias,
			ModuleAliasConflictsWithImportedName,
			ModuleAliasConflictsWithLocalName,
		),
		ModuleView,
		SelectiveNameRegistration(
			SelectiveNameAdded,
			SelectiveNameConflictsWithAlias,
			SelectiveNameConflictsWithImportedName,
			SelectiveNameConflictsWithLocalName,
		),
		TopLevelNameKind(TopLevelFunction, TopLevelType),
		module_view_accepted_global_value_index,
		module_view_accepted_record_type_index,
		module_view_accepted_type_alias_index,
		module_view_accepted_union_type_index,
		module_view_add_imported_module,
		module_view_find_imported_name,
		module_view_find_local_name,
		module_view_find_module_alias,
		module_view_has_imported_module,
		module_view_has_qualified_binding,
		module_view_has_selective_binding,
		module_view_import_bindings,
		module_view_imported_constructors,
		module_view_imported_modules,
		module_view_record_imported_constructor,
		module_view_register_local_name,
		module_view_register_module_alias,
		module_view_register_selective_name,
		module_view_with_accepted_global_value_index,
		module_view_with_accepted_record_type_index,
		module_view_with_accepted_type_alias_index,
		module_view_with_accepted_union_type_index,
		module_view_without_unqualified_names,
	test: TestSuite


pure func accepted_alias_view(
	view: ModuleView,
	local_name: String,
	module_path: String,
) -> Option[ModuleView]:
	match module_view_register_module_alias(view, local_name, module_path):
		ModuleAliasAdded(next):
			Some(next)
		ModuleAliasAlreadyPresent:
			Some(view)
		_:
			None


pure func accepted_selective_view(
	view: ModuleView,
	local_name: String,
	module_path: String,
	source_name: String,
) -> Option[ModuleView]:
	match module_view_register_selective_name(view, local_name, module_path, source_name):
		SelectiveNameAdded(next):
			Some(next)
		_:
			None


func test_module_view_preserves_order_and_exact_indexes() -> Bool:
	with_module = module_view_add_imported_module(COMPILER_MODULE_VIEW_EMPTY, "std/list")
	with_duplicate_module = module_view_add_imported_module(with_module, "std/list")
	with_alias = accepted_alias_view(with_duplicate_module, "List", "std/list")

	match with_alias:
		Some(alias_view):
			with_name = accepted_selective_view(alias_view, "map", "std/list", "map")

			match with_name:
				Some(view):
					bindings = module_view_import_bindings(view)

					qualified_matches = match bindings.get(0):
						Some(QualifiedModuleBinding(local_name, module_path)):
							local_name == "List" and module_path == "std/list"
						_:
							False

					selective_matches = match bindings.get(1):
						Some(SelectiveDefinitionBinding(local_name, module_path, source_name)):
							(
								local_name == "map"
								and module_path == "std/list"
								and source_name == "map"
							)
						_:
							False

					(
						module_view_imported_modules(view) == ["std/list"]
						and module_view_has_imported_module(view, "std/list")
						and module_view_find_module_alias(view, "List") == Some("std/list")
						and module_view_has_qualified_binding(view, "List", "std/list")
						and module_view_find_imported_name(
							view,
							"map",
						).map(
							func(binding): binding.original_name,
						) == Some("map")
						and module_view_has_selective_binding(view, "map", "std/list", "map")
						and bindings.length() == 2
						and qualified_matches
						and selective_matches
					)
				None:
					False
		None:
			False


func test_module_view_preserves_imported_constructor_parent() -> Bool:
	binding: ImportedConstructorBinding = {
		local_name = "Done",
		module_path = "std/process",
		parent_local_name = "Exit",
		parent_name = "ProcessExit",
		original_name = "Exited"
	}
	view = module_view_record_imported_constructor(COMPILER_MODULE_VIEW_EMPTY, binding)

	module_view_imported_constructors(view) == [binding]


func test_without_unqualified_names_clears_alias_authority() -> Bool:
	index = type_alias_index_add_transparent(
		TYPE_ALIAS_INDEX_EMPTY,
		"Name",
		[],
		TYPE_INT,
	).get_or(TYPE_ALIAS_INDEX_EMPTY)
	view = module_view_with_accepted_type_alias_index(COMPILER_MODULE_VIEW_EMPTY, index)

	module_view_accepted_type_alias_index(module_view_without_unqualified_names(view)).is_none()


func test_without_unqualified_names_clears_record_authority() -> Bool:
	view = module_view_with_accepted_record_type_index(
		COMPILER_MODULE_VIEW_EMPTY,
		RECORD_TYPE_INDEX_EMPTY,
	)

	module_view_accepted_record_type_index(module_view_without_unqualified_names(view)).is_none()


func test_without_unqualified_names_clears_union_authority() -> Bool:
	view = module_view_with_accepted_union_type_index(
		COMPILER_MODULE_VIEW_EMPTY,
		UNION_TYPE_INDEX_EMPTY,
	)

	module_view_accepted_union_type_index(module_view_without_unqualified_names(view)).is_none()


func test_without_unqualified_names_clears_global_authority() -> Bool:
	view = module_view_with_accepted_global_value_index(
		COMPILER_MODULE_VIEW_EMPTY,
		GLOBAL_VALUE_INDEX_EMPTY,
	)

	module_view_accepted_global_value_index(module_view_without_unqualified_names(view)).is_none()


func test_module_view_rejects_namespace_conflicts() -> Bool:
	with_alias = accepted_alias_view(COMPILER_MODULE_VIEW_EMPTY, "List", "std/list")
	with_name = accepted_selective_view(COMPILER_MODULE_VIEW_EMPTY, "map", "std/list", "map")

	match (with_alias, with_name):
		(Some(alias_view), Some(name_view)):
			alias_rebind_conflicts = match module_view_register_module_alias(
				alias_view,
				"List",
				"other/list",
			):
				ModuleAliasConflictsWithAlias(existing):
					existing == "std/list"
				_:
					False

			alias_name_conflicts = match module_view_register_selective_name(
				alias_view,
				"List",
				"std/list",
				"List",
			):
				SelectiveNameConflictsWithAlias(existing):
					existing == "std/list"
				_:
					False

			selective_alias_conflicts = match module_view_register_module_alias(
				name_view,
				"map",
				"std/list",
			):
				ModuleAliasConflictsWithImportedName(existing):
					existing.module_path == "std/list" and existing.original_name == "map"
				_:
					False

			selective_duplicate_conflicts = match module_view_register_selective_name(
				name_view,
				"map",
				"other/list",
				"other_map",
			):
				SelectiveNameConflictsWithImportedName(existing):
					existing.module_path == "std/list" and existing.original_name == "map"
				_:
					False

			(
				alias_rebind_conflicts
				and alias_name_conflicts
				and selective_alias_conflicts
				and selective_duplicate_conflicts
			)
		_:
			False


func test_local_and_imported_names_cannot_coexist() -> Bool:
	local_result = module_view_register_local_name(
		COMPILER_MODULE_VIEW_EMPTY,
		"Widget",
		TopLevelType,
	)

	match local_result:
		LocalNameAdded(local_view):
			repeated_local = match module_view_register_local_name(
				local_view,
				"Widget",
				TopLevelFunction,
			):
				LocalNameAlreadyPresent(TopLevelType):
					True
				_:
					False

			alias_after_local = match module_view_register_module_alias(
				local_view,
				"Widget",
				"pkg/widget",
			):
				ModuleAliasConflictsWithLocalName(TopLevelType):
					True
				_:
					False

			selective_after_local = match module_view_register_selective_name(
				local_view,
				"Widget",
				"pkg/widget",
				"Widget",
			):
				SelectiveNameConflictsWithLocalName(TopLevelType):
					True
				_:
					False

			with_alias = accepted_alias_view(COMPILER_MODULE_VIEW_EMPTY, "Pkg", "pkg/widget")
			with_selective = accepted_selective_view(
				COMPILER_MODULE_VIEW_EMPTY,
				"ImportedWidget",
				"pkg/widget",
				"Widget",
			)

			reverse_alias_conflict = match with_alias:
				Some(view):
					match module_view_register_local_name(view, "Pkg", TopLevelType):
						LocalNameConflictsWithAlias(path):
							path == "pkg/widget"
						_:
							False
				None:
					False

			reverse_selective_conflict = match with_selective:
				Some(view):
					match module_view_register_local_name(view, "ImportedWidget", TopLevelType):
						LocalNameConflictsWithImportedName(binding):
							binding.module_path == "pkg/widget"
						_:
							False
				None:
					False

			(
				repeated_local
				and alias_after_local
				and selective_after_local
				and reverse_alias_conflict
				and reverse_selective_conflict
			)
		_:
			False


func test_clearing_unqualified_names_keeps_view_consistent() -> Bool:
	with_module = module_view_add_imported_module(COMPILER_MODULE_VIEW_EMPTY, "std/list")
	with_alias = accepted_alias_view(with_module, "List", "std/list")

	match with_alias:
		Some(alias_view):
			with_local = module_view_register_local_name(alias_view, "local_map", TopLevelFunction)

			match with_local:
				LocalNameAdded(local_view):
					with_name = accepted_selective_view(local_view, "map", "std/list", "map")

					match with_name:
						Some(view):
							cleared = module_view_without_unqualified_names(view)
							bindings = module_view_import_bindings(cleared)

							qualified_matches = match bindings.get(0):
								Some(QualifiedModuleBinding(local_name, module_path)):
									local_name == "List" and module_path == "std/list"
								_:
									False

							(
								module_view_find_local_name(cleared, "local_map").is_none()
								and module_view_find_imported_name(cleared, "map").is_none()
								and module_view_find_module_alias(
									cleared,
									"List",
								) == Some("std/list")
								and module_view_has_imported_module(cleared, "std/list")
								and bindings.length() == 1
								and qualified_matches
							)
						None:
							False
				_:
					False
		None:
			False


tests: TestSuite = {
	description = "Opaque compiler module view",
	tests = [
		("preserves order and exact indexes", test_module_view_preserves_order_and_exact_indexes),
		(
			"preserves imported constructor parent",
			test_module_view_preserves_imported_constructor_parent,
		),
		(
			"clearing unqualified names clears alias authority",
			test_without_unqualified_names_clears_alias_authority,
		),
		(
			"clearing unqualified names clears record authority",
			test_without_unqualified_names_clears_record_authority,
		),
		(
			"clearing unqualified names clears union authority",
			test_without_unqualified_names_clears_union_authority,
		),
		(
			"clearing unqualified names clears global authority",
			test_without_unqualified_names_clears_global_authority,
		),
		("rejects namespace conflicts", test_module_view_rejects_namespace_conflicts),
		("local and imported names cannot coexist", test_local_and_imported_names_cannot_coexist),
		(
			"clearing unqualified names keeps the view consistent",
			test_clearing_unqualified_names_keeps_view_consistent,
		),
	]
}
