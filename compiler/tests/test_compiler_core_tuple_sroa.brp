import:
	../src/stage_09_core/ir:
		CoreBinaryOp(AddOp),
		CoreCallKind(UserCall),
		CoreDecl(FunctionDecl),
		CoreExpr(
			BinaryExpr,
			CallExpr,
			FieldExpr,
			ForListExpr,
			IfExpr,
			LetExpr,
			LiteralExpr,
			LogicalExpr,
			RecordReuseExpr,
			RecordUpdateExpr,
			ResourceScopeExpr,
			SemanticMatchExpr,
			TensorRawReadExpr,
			TupleExpr,
			TupleFieldExpr,
			VarExpr,
		),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreListStorageLayout(PointerListStorage),
		CoreLiteral(BoolLiteral, IntLiteral, StringLiteral),
		CoreLogicalOp(AndOp),
		CoreLoopRangeDirection(RangeForwardOnly),
		CoreParam,
		CoreProgram,
		CoreReleasePolicy(NoReleasePolicy),
		CoreSemanticLengthMatchCase,
		CoreSemanticLengthMatchGeq,
		CoreSemanticMatchAccessor(RootSemanticMatchAccessor),
		CoreSemanticMatchTree(SemanticLengthMatch, SemanticLiteralMatch, SemanticMatchLeaf),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreTensorRawScalarKind(TensorInt64Elements),
		CoreType(FunctionType, HeapRecordType, NamedType, TupleType),
		CoreVar,
		core_var_equal,
	../src/stage_09_core/traverse: immediate_core_expr_children
	../src/stage_09_core/tuple_sroa: rewrite_tuple_sroa_expr, rewrite_tuple_sroa_program
	test: TestSuite


TY_INT: CoreType = NamedType("Int", [])

TY_BOOL: CoreType = NamedType("Bool", [])

TY_STRING: CoreType = NamedType("String", [])

TY_PAIR: CoreType = TupleType([TY_INT, TY_INT])

TY_STRING_PAIR: CoreType = TupleType([TY_STRING, TY_INT])

TY_BOX: CoreType = HeapRecordType("Box")

DEEP_LOGICAL_LENGTH: Int = 512


private pure func core_var(name: String) -> CoreVar:
	core_var_with_uniq(name, 0)


private pure func core_var_with_uniq(name: String, uniq: Int) -> CoreVar:
	{
		name = name,
		uniq = uniq,
		def_id = None
	}


private pure func variable(name: String, typ: CoreType) -> CoreExpr:
	variable_with_identity(core_var(name), typ)


private pure func variable_with_identity(variable_name: CoreVar, typ: CoreType) -> CoreExpr:
	VarExpr(variable_name, typ, SyntheticSourceLoc)


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), TY_INT, SyntheticSourceLoc)


private pure func bool_literal(value: Bool) -> CoreExpr:
	LiteralExpr(BoolLiteral(value), TY_BOOL, SyntheticSourceLoc)


private pure func string_literal(value: String) -> CoreExpr:
	LiteralExpr(StringLiteral(value), TY_STRING, SyntheticSourceLoc)


private pure func field(owner: CoreExpr, name: String, typ: CoreType) -> CoreExpr:
	FieldExpr(owner, name, typ, SyntheticSourceLoc)


private pure func tuple_field(owner: CoreExpr, index: Int, typ: CoreType) -> CoreExpr:
	TupleFieldExpr(owner, index, typ, SyntheticSourceLoc)


private pure func immutable_let(
	name: String,
	typ: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	LetExpr(core_var(name), False, typ, rhs, body)


private pure func tuple_let(
	name: String,
	tuple_type: CoreType,
	elements: List[CoreExpr],
	body: CoreExpr,
) -> CoreExpr:
	immutable_let(
		name,
		tuple_type,
		TupleExpr(elements, tuple_type, SyntheticSourceLoc),
		body,
	)


private pure func function_type(params: List[CoreType], return_type: CoreType) -> CoreType:
	FunctionType(True, params, return_type)


private pure func param(name: String, typ: CoreType) -> CoreParam:
	{
		name = core_var(name),
		typ = typ,
		loc = SyntheticSourceLoc
	}


private pure func function_decl(
	name: String,
	def_id: Int,
	params: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = None,
		type_params = [],
		params = params,
		return_type = return_type,
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


private pure func program(decls: List[CoreDecl]) -> CoreProgram:
	{
		decls = decls,
		foreign_includes = []
	}


private pure func contains_expr(
	expr: CoreExpr,
	predicate: pure (CoreExpr) -> Bool,
) -> Bool:
	if predicate(expr):
		True
	else:
		immediate_core_expr_children(
			expr,
		).any(
			pure func(child: CoreExpr): contains_expr(child, predicate),
		)


private pure func is_tuple_expr(expr: CoreExpr) -> Bool:
	match expr:
		TupleExpr(_, _, _):
			True
		_:
			False


private pure func contains_tuple(expr: CoreExpr) -> Bool:
	contains_expr(expr, is_tuple_expr)


private pure func field_is_owned_by(owner: CoreVar, expr: CoreExpr) -> Bool:
	match expr:
		FieldExpr(VarExpr(variable, _, _), _, _, _):
			core_var_equal(variable, owner)
		_:
			False


private pure func contains_field_of(expr: CoreExpr, owner: CoreVar) -> Bool:
	contains_expr(expr, pure func(node: CoreExpr): field_is_owned_by(owner, node))


private pure func call_targets(name: String, expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(UserCall(callee, _, _), _, _, _, _):
			callee == name
		_:
			False


private pure func contains_call_to(expr: CoreExpr, name: String) -> Bool:
	contains_expr(expr, pure func(node: CoreExpr): call_targets(name, node))


private pure func generated_binding_names(expr: CoreExpr) -> List[String]:
	var names: List[String] = []

	match expr:
		LetExpr(variable, _, _, _, _):
			if variable.name.starts_with("$blorp$tuple_sroa$"):
				names = names.append(variable.name)
		_:
			void

	for child in immediate_core_expr_children(expr):
		names = names.concat(generated_binding_names(child))

	names


private pure func int_literals_in_expr(expr: CoreExpr) -> List[Int]:
	current: List[Int] = match expr:
		LiteralExpr(IntLiteral(value), _, _):
			[value]
		_:
			[]

	var values: List[Int] = current

	for child in immediate_core_expr_children(expr):
		values = values.concat(int_literals_in_expr(child))

	values


private pure func int_literals_in_semantic_tree(tree: CoreSemanticMatchTree) -> List[Int]:
	match tree:
		SemanticMatchLeaf(_, body):
			int_literals_in_expr(body)
		SemanticLiteralMatch(_, cases, fallback):
			var values: List[Int] = []

			for match_case in cases:
				values = values.concat(int_literals_in_semantic_tree(match_case.body))

			values.concat(int_literals_in_semantic_tree(fallback))
		SemanticLengthMatch(_, cases, geq, fallback):
			var values: List[Int] = []

			for match_case in cases:
				values = values.concat(int_literals_in_semantic_tree(match_case.body))

			match geq:
				Some(geq_case):
					values = values.concat(int_literals_in_semantic_tree(geq_case.body))
				None:
					void

			match fallback:
				Some(fallback_tree):
					values.concat(int_literals_in_semantic_tree(fallback_tree))
				None:
					values
		_:
			[]


private pure func first_semantic_leaf_ints(expr: CoreExpr) -> Option[List[Int]]:
	match expr:
		SemanticMatchExpr(_, tree, _, _):
			Some(int_literals_in_semantic_tree(tree))
		_:
			var found: Option[List[Int]] = None

			for child in immediate_core_expr_children(expr):
				match first_semantic_leaf_ints(child):
					Some(values):
						found = Some(values)
						break
					None:
						void

			found


private pure func function_body_at(program_value: CoreProgram, index: Int) -> Option[CoreExpr]:
	match program_value.decls.get(index):
		Some(FunctionDecl(function_info)):
			function_info.body
		_:
			None


func test_local_field_access_scalar_replaced() -> Bool:
	pair: CoreExpr = variable("pair", TY_PAIR)
	body: CoreExpr = BinaryExpr(
		AddOp,
		field(pair, "0", TY_INT),
		field(pair, "1", TY_INT),
		TY_INT,
		SyntheticSourceLoc,
	)
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		tuple_let(
			"pair",
			TY_PAIR,
			[int_literal(20), int_literal(22)],
			body,
		),
	)

	not contains_tuple(rewritten) and not contains_field_of(rewritten, core_var("pair"))


func test_explicit_tuple_field_access_scalar_replaced() -> Bool:
	pair: CoreExpr = variable("pair", TY_PAIR)
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		tuple_let(
			"pair",
			TY_PAIR,
			[int_literal(20), int_literal(22)],
			BinaryExpr(
				AddOp,
				tuple_field(pair, 0, TY_INT),
				tuple_field(pair, 1, TY_INT),
				TY_INT,
				SyntheticSourceLoc,
			),
		),
	)

	not contains_tuple(rewritten)


func test_escaping_tuple_is_unchanged() -> Bool:
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		tuple_let(
			"pair",
			TY_PAIR,
			[int_literal(1), int_literal(2)],
			variable(
				"pair",
				TY_PAIR,
			),
		),
	)

	contains_tuple(rewritten)


func test_mutable_tuple_is_unchanged() -> Bool:
	pair: CoreExpr = variable("pair", TY_PAIR)
	expr: CoreExpr = LetExpr(
		core_var("pair"),
		True,
		TY_PAIR,
		TupleExpr(
			[int_literal(1), int_literal(2)],
			TY_PAIR,
			SyntheticSourceLoc,
		),
		field(
			pair,
			"0",
			TY_INT,
		),
	)

	contains_tuple(rewrite_tuple_sroa_expr(expr))


func test_managed_local_tuple_is_scalar_replaced() -> Bool:
	pair: CoreExpr = variable("pair", TY_STRING_PAIR)
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		tuple_let(
			"pair",
			TY_STRING_PAIR,
			[string_literal("hello"), int_literal(2)],
			field(
				pair,
				"0",
				TY_STRING,
			),
		),
	)

	not contains_tuple(rewritten) and not contains_field_of(rewritten, core_var("pair"))


func test_immediate_tuple_field_scalar_replaced() -> Bool:
	expr: CoreExpr = field(
		TupleExpr(
			[int_literal(3), int_literal(4)],
			TY_PAIR,
			SyntheticSourceLoc,
		),
		"1",
		TY_INT,
	)
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(expr)

	not contains_tuple(rewritten) and generated_binding_names(rewritten).length() == 2


private pure func immediate_tuple_field_value() -> CoreExpr:
	field(
		TupleExpr(
			[int_literal(3), int_literal(4)],
			TY_PAIR,
			SyntheticSourceLoc,
		),
		"1",
		TY_INT,
	)


func test_tuple_sroa_traverses_record_update_fields() -> Bool:
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		RecordUpdateExpr(
			variable(
				"box",
				TY_BOX,
			),
			[
				{
					name = "value",
					value = immediate_tuple_field_value()
				},
			],
			TY_BOX,
			SyntheticSourceLoc,
		),
	)

	not contains_tuple(rewritten)


func test_tuple_sroa_traverses_record_reuse_fields() -> Bool:
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		RecordReuseExpr(
			variable(
				"box",
				TY_BOX,
			),
			[
				{
					name = "value",
					value = immediate_tuple_field_value()
				},
			],
			TY_BOX,
			SyntheticSourceLoc,
		),
	)

	not contains_tuple(rewritten)


func test_tuple_if_scalar_replaced() -> Bool:
	pair: CoreExpr = variable("pair", TY_PAIR)
	rhs: CoreExpr = IfExpr(
		bool_literal(True),
		TupleExpr(
			[int_literal(1), int_literal(2)],
			TY_PAIR,
			SyntheticSourceLoc,
		),
		TupleExpr(
			[int_literal(3), int_literal(4)],
			TY_PAIR,
			SyntheticSourceLoc,
		),
		TY_PAIR,
		SyntheticSourceLoc,
	)
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		immutable_let(
			"pair",
			TY_PAIR,
			rhs,
			field(pair, "0", TY_INT),
		),
	)

	not contains_tuple(rewritten) and not contains_field_of(rewritten, core_var("pair"))


func test_tuple_if_mismatched_element_type_is_unchanged() -> Bool:
	pair: CoreExpr = variable("pair", TY_PAIR)
	rhs: CoreExpr = IfExpr(
		bool_literal(True),
		TupleExpr(
			[int_literal(1), int_literal(2)],
			TY_PAIR,
			SyntheticSourceLoc,
		),
		TupleExpr(
			[string_literal("wrong"), int_literal(4)],
			TY_STRING_PAIR,
			SyntheticSourceLoc,
		),
		TY_PAIR,
		SyntheticSourceLoc,
	)
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		immutable_let(
			"pair",
			TY_PAIR,
			rhs,
			field(pair, "0", TY_INT),
		),
	)

	contains_tuple(rewritten) and contains_field_of(rewritten, core_var("pair"))


func test_branch_alias_scope_does_not_rewrite_unrelated_sibling() -> Bool:
	pair: CoreVar = core_var_with_uniq("pair", 1)
	other: CoreVar = core_var_with_uniq("other", 2)
	then_alias: CoreVar = core_var_with_uniq("branch_alias", 3)
	else_alias: CoreVar = then_alias
	then_branch: CoreExpr = LetExpr(
		then_alias,
		False,
		TY_PAIR,
		variable_with_identity(pair, TY_PAIR),
		field(
			variable_with_identity(then_alias, TY_PAIR),
			"0",
			TY_INT,
		),
	)
	else_branch: CoreExpr = LetExpr(
		else_alias,
		False,
		TY_PAIR,
		variable_with_identity(other, TY_PAIR),
		field(
			variable_with_identity(else_alias, TY_PAIR),
			"0",
			TY_INT,
		),
	)
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		LetExpr(
			pair,
			False,
			TY_PAIR,
			TupleExpr(
				[int_literal(1), int_literal(2)],
				TY_PAIR,
				SyntheticSourceLoc,
			),
			IfExpr(
				bool_literal(True),
				then_branch,
				else_branch,
				TY_INT,
				SyntheticSourceLoc,
			),
		),
	)

	(
		not contains_tuple(rewritten)
		and not contains_field_of(rewritten, pair)
		and contains_field_of(rewritten, else_alias)
	)


func test_resource_binding_shadow_does_not_rewrite_scoped_value() -> Bool:
	pair: CoreVar = core_var_with_uniq("pair", 1)
	scoped_pair: CoreVar = pair
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		LetExpr(
			pair,
			False,
			TY_PAIR,
			TupleExpr(
				[int_literal(1), int_literal(2)],
				TY_PAIR,
				SyntheticSourceLoc,
			),
			ResourceScopeExpr(
				{
					variable = scoped_pair,
					typ = TY_PAIR,
					acquire = variable("open_pair", TY_PAIR),
					body = field(
						variable_with_identity(scoped_pair, TY_PAIR),
						"0",
						TY_INT,
					),
					cleanup = int_literal(0)
				},
				TY_INT,
				SyntheticSourceLoc,
			),
		),
	)

	contains_tuple(rewritten) and contains_field_of(rewritten, scoped_pair)


func test_loop_binding_shadow_does_not_rewrite_loop_value() -> Bool:
	pair: CoreVar = core_var_with_uniq("pair", 1)
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		LetExpr(
			pair,
			False,
			TY_PAIR,
			TupleExpr(
				[int_literal(1), int_literal(2)],
				TY_PAIR,
				SyntheticSourceLoc,
			),
			ForListExpr(
				{
					binder = {
						variable = pair,
						typ = TY_PAIR,
						range_direction = RangeForwardOnly
					},
					layout = PointerListStorage,
					iterable = variable(
						"pairs",
						NamedType("List", [TY_PAIR]),
					),
					iterable_release_policy = NoReleasePolicy,
					body = field(
						variable_with_identity(pair, TY_PAIR),
						"0",
						TY_INT,
					)
				},
				TY_INT,
				SyntheticSourceLoc,
			),
		),
	)

	not contains_tuple(rewritten) and contains_field_of(rewritten, pair)


func test_tuple_sroa_traverses_tensor_raw_read_index() -> Bool:
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		TensorRawReadExpr(
			{
				view = core_var("view"),
				kind = TensorInt64Elements,
				index = field(
					TupleExpr(
						[int_literal(1), int_literal(2)],
						TY_PAIR,
						SyntheticSourceLoc,
					),
					"0",
					TY_INT,
				)
			},
			TY_INT,
			SyntheticSourceLoc,
		),
	)

	not contains_tuple(rewritten)


func test_unsupported_tuple_field_keeps_original_binding() -> Bool:
	pair: CoreVar = core_var_with_uniq("pair", 1)
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		LetExpr(
			pair,
			False,
			TY_PAIR,
			TupleExpr(
				[int_literal(1), int_literal(2)],
				TY_PAIR,
				SyntheticSourceLoc,
			),
			field(
				variable_with_identity(pair, TY_PAIR),
				"2",
				TY_INT,
			),
		),
	)

	contains_tuple(rewritten) and contains_field_of(rewritten, pair)


func test_tuple_match_with_non_tuple_leaf_is_unchanged() -> Bool:
	pair: CoreVar = core_var_with_uniq("pair", 1)
	match_rhs: CoreExpr = SemanticMatchExpr(
		variable(
			"choice",
			TY_INT,
		),
		SemanticLiteralMatch(
			RootSemanticMatchAccessor,
			[
				{
					literal = IntLiteral(0),
					body = SemanticMatchLeaf(
						[],
						TupleExpr(
							[int_literal(1), int_literal(2)],
							TY_PAIR,
							SyntheticSourceLoc,
						),
					)
				},
			],
			SemanticMatchLeaf(
				[],
				variable("fallback", TY_PAIR),
			),
		),
		TY_PAIR,
		SyntheticSourceLoc,
	)
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		LetExpr(
			pair,
			False,
			TY_PAIR,
			match_rhs,
			field(
				variable_with_identity(pair, TY_PAIR),
				"0",
				TY_INT,
			),
		),
	)

	contains_tuple(rewritten) and contains_field_of(rewritten, pair)


func test_tuple_match_leaf_collection_preserves_case_order() -> Bool:
	pair: CoreVar = core_var_with_uniq("pair", 1)
	match_rhs: CoreExpr = SemanticMatchExpr(
		variable(
			"choice",
			TY_INT,
		),
		SemanticLiteralMatch(
			RootSemanticMatchAccessor,
			[
				{
					literal = IntLiteral(0),
					body = SemanticMatchLeaf(
						[],
						TupleExpr(
							[int_literal(10), int_literal(11)],
							TY_PAIR,
							SyntheticSourceLoc,
						),
					)
				},
				{
					literal = IntLiteral(1),
					body = SemanticMatchLeaf(
						[],
						TupleExpr(
							[int_literal(20), int_literal(21)],
							TY_PAIR,
							SyntheticSourceLoc,
						),
					)
				},
			],
			SemanticMatchLeaf(
				[],
				TupleExpr(
					[int_literal(30), int_literal(31)],
					TY_PAIR,
					SyntheticSourceLoc,
				),
			),
		),
		TY_PAIR,
		SyntheticSourceLoc,
	)
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		LetExpr(
			pair,
			False,
			TY_PAIR,
			match_rhs,
			field(
				variable_with_identity(pair, TY_PAIR),
				"0",
				TY_INT,
			),
		),
	)

	(
		not contains_tuple(rewritten)
		and not contains_field_of(rewritten, pair)
		and match first_semantic_leaf_ints(rewritten):
			Some(values):
				values == [10, 20, 30]
			None:
				False
	)


func test_tuple_length_match_leaf_collection_preserves_geq_and_fallback_order() -> Bool:
	pair: CoreVar = core_var_with_uniq("pair", 1)
	length_case: CoreSemanticLengthMatchCase = {
		length = 2,
		body = SemanticMatchLeaf(
			[],
			TupleExpr(
				[int_literal(40), int_literal(41)],
				TY_PAIR,
				SyntheticSourceLoc,
			),
		)
	}
	geq_case: CoreSemanticLengthMatchGeq = {
		minimum_length = 3,
		body = SemanticMatchLeaf(
			[],
			TupleExpr(
				[int_literal(50), int_literal(51)],
				TY_PAIR,
				SyntheticSourceLoc,
			),
		)
	}
	match_rhs: CoreExpr = SemanticMatchExpr(
		variable(
			"choice",
			TY_INT,
		),
		SemanticLengthMatch(
			RootSemanticMatchAccessor,
			[length_case],
			Some(geq_case),
			Some(
				SemanticMatchLeaf(
					[],
					TupleExpr(
						[int_literal(60), int_literal(61)],
						TY_PAIR,
						SyntheticSourceLoc,
					),
				),
			),
		),
		TY_PAIR,
		SyntheticSourceLoc,
	)
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		LetExpr(
			pair,
			False,
			TY_PAIR,
			match_rhs,
			field(
				variable_with_identity(pair, TY_PAIR),
				"0",
				TY_INT,
			),
		),
	)

	(
		not contains_tuple(rewritten)
		and not contains_field_of(rewritten, pair)
		and match first_semantic_leaf_ints(rewritten):
			Some(values):
				values == [40, 50, 60]
			None:
				False
	)


private pure func tuple_return_call_program(
	param_type: CoreType,
	return_type: CoreType,
	element: CoreExpr,
) -> CoreProgram:
	make_pair: CoreDecl = function_decl(
		"make_pair",
		42,
		[param("value", param_type)],
		return_type,
		TupleExpr(
			[element, int_literal(2)],
			return_type,
			SyntheticSourceLoc,
		),
	)

	arg: CoreExpr = if param_type == TY_STRING:
		string_literal("hello")
	else:
		int_literal(1)

	call: CoreExpr = CallExpr(
		UserCall("make_pair", Some(42), []),
		variable(
			"make_pair",
			function_type([param_type], return_type),
		),
		[arg],
		return_type,
		SyntheticSourceLoc,
	)
	caller: CoreDecl = function_decl(
		"caller",
		43,
		[],
		param_type,
		immutable_let(
			"pair",
			return_type,
			call,
			field(
				variable("pair", return_type),
				"0",
				param_type,
			),
		),
	)

	program([make_pair, caller])


private pure func tuple_return_call_with_local_program() -> CoreProgram:
	return_type: CoreType = TY_PAIR
	local_value: CoreExpr = BinaryExpr(
		AddOp,
		variable("value", TY_INT),
		int_literal(1),
		TY_INT,
		SyntheticSourceLoc,
	)
	make_pair: CoreDecl = function_decl(
		"make_pair_with_local",
		44,
		[param("value", TY_INT)],
		return_type,
		immutable_let(
			"next",
			TY_INT,
			local_value,
			TupleExpr(
				[variable("next", TY_INT), int_literal(2)],
				return_type,
				SyntheticSourceLoc,
			),
		),
	)
	call: CoreExpr = CallExpr(
		UserCall("make_pair_with_local", Some(44), []),
		variable(
			"make_pair_with_local",
			function_type([TY_INT], return_type),
		),
		[int_literal(1)],
		return_type,
		SyntheticSourceLoc,
	)
	caller: CoreDecl = function_decl(
		"caller",
		45,
		[],
		TY_INT,
		immutable_let(
			"pair",
			return_type,
			call,
			field(
				variable("pair", return_type),
				"0",
				TY_INT,
			),
		),
	)

	program([make_pair, caller])


func test_unmanaged_tuple_return_call_scalar_replaced() -> Bool:
	rewritten: CoreProgram = rewrite_tuple_sroa_program(
		tuple_return_call_program(
			TY_INT,
			TY_PAIR,
			variable("value", TY_INT),
		),
	)

	match function_body_at(rewritten, 1):
		Some(body):
			(
				not contains_tuple(body)
				and not contains_call_to(body, "make_pair")
				and not contains_field_of(body, core_var("pair"))
			)
		None:
			False


func test_unmanaged_tuple_return_with_local_is_scalar_replaced() -> Bool:
	rewritten: CoreProgram = rewrite_tuple_sroa_program(tuple_return_call_with_local_program())

	match function_body_at(rewritten, 1):
		Some(body):
			(
				not contains_tuple(body)
				and not contains_call_to(body, "make_pair_with_local")
				and not contains_field_of(body, core_var("pair"))
			)
		None:
			False


func test_managed_tuple_return_call_is_unchanged() -> Bool:
	rewritten: CoreProgram = rewrite_tuple_sroa_program(
		tuple_return_call_program(
			TY_STRING,
			TY_STRING_PAIR,
			variable("value", TY_STRING),
		),
	)

	match function_body_at(rewritten, 1):
		Some(body):
			contains_call_to(body, "make_pair") and contains_field_of(body, core_var("pair"))
		None:
			False


private pure func tuple_return_after_scalar_let_program() -> CoreProgram:
	local: CoreVar = core_var("local")
	make_pair: CoreDecl = function_decl(
		"make_pair_after_let",
		44,
		[],
		TY_PAIR,
		LetExpr(
			local,
			False,
			TY_INT,
			int_literal(40),
			TupleExpr(
				[variable_with_identity(local, TY_INT), int_literal(2)],
				TY_PAIR,
				SyntheticSourceLoc,
			),
		),
	)
	call: CoreExpr = CallExpr(
		UserCall("make_pair_after_let", Some(44), []),
		variable(
			"make_pair_after_let",
			function_type([], TY_PAIR),
		),
		[],
		TY_PAIR,
		SyntheticSourceLoc,
	)
	caller: CoreDecl = function_decl(
		"caller_after_let",
		45,
		[],
		TY_INT,
		immutable_let(
			"pair",
			TY_PAIR,
			call,
			field(
				variable("pair", TY_PAIR),
				"0",
				TY_INT,
			),
		),
	)

	program([make_pair, caller])


func test_tuple_return_summary_traverses_scalar_let() -> Bool:
	rewritten: CoreProgram = rewrite_tuple_sroa_program(tuple_return_after_scalar_let_program())

	match function_body_at(rewritten, 1):
		Some(LetExpr(local, False, _, LiteralExpr(IntLiteral(40), _, _), LetExpr(first_element, False, _, VarExpr(first_source, _, _), LetExpr(_, False, _, LiteralExpr(IntLiteral(2), _, _), VarExpr(result, _, _))))):
			core_var_equal(first_source, local) and core_var_equal(result, first_element)
		None:
			False
		_:
			False


private pure func deep_left_logical_expr() -> CoreExpr:
	var result: CoreExpr = bool_literal(True)
	var index: Int = 0

	while index < DEEP_LOGICAL_LENGTH:
		result = LogicalExpr(
			AndOp,
			result,
			bool_literal(index % 2 == 0),
			TY_BOOL,
			SyntheticSourceLoc,
		)
		index += 1

	result


private pure func left_logical_depth(expr: CoreExpr) -> Int:
	var current: CoreExpr = expr
	var depth: Int = 0
	var valid: Bool = True

	while valid:
		match current:
			LogicalExpr(AndOp, left, _, _, _):
				depth += 1
				current = left
			LiteralExpr(BoolLiteral(_), _, _):
				break
			_:
				valid = False

	if valid:
		depth
	else:
		-1


func test_deep_logical_rewrite_is_stack_bounded() -> Bool:
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(deep_left_logical_expr())
	left_logical_depth(rewritten) == DEEP_LOGICAL_LENGTH


func test_logical_rewrite_preserves_left_to_right_fresh_order() -> Bool:
	bool_pair_type: CoreType = TupleType([TY_BOOL, TY_BOOL])
	left: CoreExpr = field(
		TupleExpr(
			[bool_literal(True), bool_literal(False)],
			bool_pair_type,
			SyntheticSourceLoc,
		),
		"0",
		TY_BOOL,
	)
	right: CoreExpr = field(
		TupleExpr(
			[bool_literal(False), bool_literal(True)],
			bool_pair_type,
			SyntheticSourceLoc,
		),
		"1",
		TY_BOOL,
	)
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		LogicalExpr(
			AndOp,
			left,
			right,
			TY_BOOL,
			SyntheticSourceLoc,
		),
	)

	generated_binding_names(
		rewritten,
	) == [
		"$blorp$tuple_sroa$element$0",
		"$blorp$tuple_sroa$element$1",
		"$blorp$tuple_sroa$element$2",
		"$blorp$tuple_sroa$element$3",
	]


func test_generated_bindings_are_program_wide_unique() -> Bool:
	left: CoreExpr = field(
		TupleExpr(
			[int_literal(1), int_literal(2)],
			TY_PAIR,
			SyntheticSourceLoc,
		),
		"0",
		TY_INT,
	)
	right: CoreExpr = field(
		TupleExpr(
			[int_literal(3), int_literal(4)],
			TY_PAIR,
			SyntheticSourceLoc,
		),
		"1",
		TY_INT,
	)
	rewritten: CoreExpr = rewrite_tuple_sroa_expr(
		BinaryExpr(
			AddOp,
			left,
			right,
			TY_INT,
			SyntheticSourceLoc,
		),
	)
	names: List[String] = generated_binding_names(rewritten)

	(
		names.length() == 4
		and names
			.unique()
			.length() == 4
	)


func test_deep_logical_chain_is_rewritten_iteratively() -> Bool:
	var expression: CoreExpr = bool_literal(True)

	for index in 0..256:
		expression = LogicalExpr(
			AndOp,
			expression,
			bool_literal(index >= 0),
			TY_BOOL,
			SyntheticSourceLoc,
		)

	match rewrite_tuple_sroa_expr(expression):
		LogicalExpr(_, _, _, _, _):
			True
		_:
			False


