import:
	../src/stage_03_parse/parser_bridge as ParserBridge
	../src/stage_04_modules/loaded_module:
		ANONYMOUS_IDENTITY,
		ModuleIdentity,
		ModuleOrigin(UserModule),
		loaded_module_identity,
		loaded_module_set,
		loaded_module_set_target,
		module_load_candidate,
		resolved_module_identity_from_resolver,
	../src/stage_05_types/env: VarMutability(ImmutableBinding, MutableBinding)
	../src/stage_05_types/global_value_index:
		AcceptedGlobalDefinitionId,
		AcceptedGlobalValueBinding,
		AcceptedGlobalValueEntry,
		GLOBAL_VALUE_INDEX_EMPTY,
		accepted_global_definition_id,
		accepted_global_definition_id_value,
		global_value_binding,
		global_value_index_add_exact,
		global_value_index_add_module,
		global_value_index_add_visible,
		global_value_index_entry_count,
		global_value_index_find_exact,
		global_value_index_find_module,
		global_value_index_find_visible,
	../src/stage_05_types/semantic_type:
		SemanticType(SemanticNamedType),
		TYPE_INT,
		TYPE_STRING,
		types_equal,
	../src/stage_06_typecheck/headers/declaration_skeleton:
		DeclarationVisibility(PrivateDeclaration, PublicDeclaration),
	../src/stage_06_typecheck/headers/global_value_projection:
		GlobalValueProjectionInput,
		GlobalValueProjectionModule,
		global_value_projection_build,
		global_value_projection_find,
		global_value_projection_find_qualified,
		global_value_projection_observe_build,
	../src/stage_06_typecheck/modules/module_binding: import_default_alias
	../src/stage_06_typecheck/modules/module_view:
		COMPILER_MODULE_VIEW_EMPTY,
		ModuleAliasRegistration(ModuleAliasAdded),
		ModuleView,
		SelectiveNameRegistration(SelectiveNameAdded),
		module_view_add_imported_module,
		module_view_register_module_alias,
		module_view_register_selective_name,
	test: TestSuite


private pure func module_identity(canonical_path: String) -> ModuleIdentity:
	program = ParserBridge.parsed_typecheck_source_bridge_artifact(
		canonical_path + ".brp",
		canonical_path,
		"global value: Int = 1",
		False,
	).program

	match loaded_module_set(
		module_load_candidate(
			resolved_module_identity_from_resolver(canonical_path, UserModule),
			program,
		),
		[],
	):
		Ok(modules):
			loaded_module_identity(loaded_module_set_target(modules))
		Err(_):
			ANONYMOUS_IDENTITY


private pure func definition_id(identity: ModuleIdentity, value: Int) -> AcceptedGlobalDefinitionId:
	accepted_global_definition_id(identity, value)


private pure func entry(
	id: Int,
	source_binding_type: SemanticType,
	canonical_binding_type: SemanticType,
	source_type: Option[SemanticType],
	mutability: VarMutability,
	identity_path: String,
) -> AcceptedGlobalValueEntry:
	{
		definition_id = definition_id(module_identity(identity_path), id),
		source_binding_type = source_binding_type,
		canonical_binding_type = canonical_binding_type,
		source_type = source_type,
		mutability = mutability
	}


private pure func local_binding(
	value: AcceptedGlobalValueEntry,
	module_path: String,
) -> AcceptedGlobalValueBinding:
	global_value_binding(value, value.source_binding_type, module_path)


private pure func canonical_binding(
	value: AcceptedGlobalValueEntry,
	module_path: String,
) -> AcceptedGlobalValueBinding:
	global_value_binding(value, value.canonical_binding_type, module_path)


private pure func typed_exact_and_source_indexes_preserve_metadata() -> Bool:
	value = entry(17, TYPE_INT, TYPE_STRING, Some(TYPE_STRING), MutableBinding, "pkg/source")
	with_exact = global_value_index_add_exact(
		GLOBAL_VALUE_INDEX_EMPTY,
		value,
	).get_or(GLOBAL_VALUE_INDEX_EMPTY)
	index = global_value_index_add_visible(
		with_exact,
		"renamed",
		canonical_binding(value, "pkg/source"),
	).get_or(with_exact)

	match (global_value_index_find_exact(
			index,
			definition_id(module_identity("pkg/source"), 17),
		), global_value_index_find_visible(index, "renamed")):
		(Some(exact), Some(visible)):
			(
				accepted_global_definition_id_value(exact.definition_id) == 17
				and accepted_global_definition_id_value(visible.entry.definition_id) == 17
				and types_equal(exact.source_binding_type, TYPE_INT)
				and types_equal(exact.canonical_binding_type, TYPE_STRING)
				and match exact.source_type:
					Some(source_type):
						types_equal(source_type, TYPE_STRING)
					None:
						False
				and exact.mutability == MutableBinding
				and visible.module_path == "pkg/source"
				and global_value_index_find_exact(
					index,
					definition_id(module_identity("pkg/other"), 17),
				).is_none()
				and global_value_index_entry_count(index) == 1
			)
		_:
			False


private pure func duplicate_exact_and_visible_bindings_fail_closed() -> Bool:
	first = entry(1, TYPE_INT, TYPE_INT, None, ImmutableBinding, "pkg/first")
	second = entry(2, TYPE_STRING, TYPE_STRING, None, ImmutableBinding, "pkg/second")
	with_exact = global_value_index_add_exact(
		GLOBAL_VALUE_INDEX_EMPTY,
		first,
	).get_or(GLOBAL_VALUE_INDEX_EMPTY)
	with_visible = global_value_index_add_visible(
		with_exact,
		"value",
		local_binding(first, "pkg/first"),
	).get_or(with_exact)

	global_value_index_add_exact(with_visible, first).is_none() and global_value_index_add_visible(
		with_visible,
		"value",
		local_binding(second, "pkg/second"),
	).is_none()


private pure func module_qualified_lookup_is_separate_from_bare_lookup() -> Bool:
	value = entry(4, TYPE_STRING, TYPE_STRING, None, ImmutableBinding, "pkg/dep")
	index = global_value_index_add_module(
		GLOBAL_VALUE_INDEX_EMPTY,
		"pkg/dep",
		"value",
		canonical_binding(value, "pkg/dep"),
	).get_or(GLOBAL_VALUE_INDEX_EMPTY)

	(
		global_value_index_find_visible(index, "value").is_none()
		and match global_value_index_find_module(index, "pkg/dep", "value"):
			Some(found):
				types_equal(found.binding_type, TYPE_STRING)
			None:
				False
	)


private pure func selective_view(
	local_name: String,
	module_path: String,
	source_name: String,
) -> ModuleView:
	with_module = module_view_add_imported_module(COMPILER_MODULE_VIEW_EMPTY, module_path)

	match module_view_register_selective_name(with_module, local_name, module_path, source_name):
		SelectiveNameAdded(view):
			view
		_:
			COMPILER_MODULE_VIEW_EMPTY


private pure func qualified_view(alias_name: String, module_path: String) -> ModuleView:
	with_module = module_view_add_imported_module(COMPILER_MODULE_VIEW_EMPTY, module_path)

	match module_view_register_module_alias(with_module, alias_name, module_path):
		ModuleAliasAdded(view):
			view
		_:
			COMPILER_MODULE_VIEW_EMPTY


private pure func direct_view(module_path: String) -> ModuleView:
	qualified_view(import_default_alias(module_path), module_path)


private pure func projection_preserves_local_selective_and_qualified_visibility() -> Bool:
	app_identity = module_identity("app/main")
	dep_identity = module_identity("pkg/dep")
	private_identity = module_identity("pkg/private")
	transitive_identity = module_identity("pkg/transitive")
	qualified_identity = module_identity("app/qualified")
	local = entry(10, TYPE_INT, TYPE_INT, Some(TYPE_INT), ImmutableBinding, "app/main")
	dep = entry(
		20,
		SemanticNamedType("LocalDep", []),
		SemanticNamedType("pkg_dep__LocalDep", []),
		None,
		ImmutableBinding,
		"pkg/dep",
	)
	dep_sibling = entry(21, TYPE_STRING, TYPE_STRING, None, ImmutableBinding, "pkg/dep")
	private_local = entry(30, TYPE_STRING, TYPE_STRING, None, ImmutableBinding, "pkg/private")
	transitive = entry(40, TYPE_INT, TYPE_INT, None, ImmutableBinding, "pkg/transitive")
	inputs: List[GlobalValueProjectionInput] = [
		{
			module_identity = app_identity,
			source_module_path = "app/source",
			canonical_module_path = "app/main",
			source_name = "local_value",
			visibility = PublicDeclaration,
			entry = local
		},
		{
			module_identity = dep_identity,
			source_module_path = "source/dep",
			canonical_module_path = "pkg/dep",
			source_name = "dep_value",
			visibility = PublicDeclaration,
			entry = dep
		},
		{
			module_identity = dep_identity,
			source_module_path = "source/dep",
			canonical_module_path = "pkg/dep",
			source_name = "dep_sibling",
			visibility = PublicDeclaration,
			entry = dep_sibling
		},
		{
			module_identity = private_identity,
			source_module_path = "source/private",
			canonical_module_path = "pkg/private",
			source_name = "hidden",
			visibility = PrivateDeclaration,
			entry = private_local
		},
		{
			module_identity = transitive_identity,
			source_module_path = "source/transitive",
			canonical_module_path = "pkg/transitive",
			source_name = "transitive_value",
			visibility = PublicDeclaration,
			entry = transitive
		},
	]
	selective_module: GlobalValueProjectionModule = {
		module_identity = app_identity,
		module_path = "app/main",
		view = selective_view("renamed", "pkg/dep", "dep_value")
	}
	qualified_module: GlobalValueProjectionModule = {
		module_identity = qualified_identity,
		module_path = "app/qualified",
		view = qualified_view("Dep", "pkg/dep")
	}
	bare_identity = module_identity("app/bare")
	bare_module: GlobalValueProjectionModule = {
		module_identity = bare_identity,
		module_path = "app/bare",
		view = direct_view("pkg/dep")
	}

	match (
		global_value_projection_build(
			inputs,
			[selective_module, qualified_module, bare_module],
		)
	):
		Err(_):
			False
		Ok(projection):
			match (
				global_value_projection_find(projection, app_identity),
				global_value_projection_find(projection, qualified_identity),
				global_value_projection_find(projection, bare_identity),
			):
				(Ok(app), Ok(qualified), Ok(bare)):
					(
						global_value_index_find_visible(app, "local_value")
							.map(func(found): found.module_path == "app/source")
							.get_or(False)
						and global_value_index_find_visible(app, "renamed")
							.map(func(found): types_equal(
									found.binding_type,
									SemanticNamedType("pkg_dep__LocalDep", []),
								) and found.module_path == "pkg/dep")
							.get_or(False)
						and global_value_index_find_visible(app, "dep_value").is_none()
						and global_value_index_find_visible(bare, "dep_value")
							.map(func(found): found.module_path == "pkg/dep")
							.get_or(False)
						and global_value_index_find_exact(
							app,
							definition_id(dep_identity, 20),
						).is_some()
						and global_value_index_find_exact(
							app,
							definition_id(dep_identity, 21),
						).is_none()
						and global_value_index_find_exact(
							app,
							definition_id(private_identity, 30),
						).is_none()
						and global_value_index_find_exact(
							app,
							definition_id(transitive_identity, 40),
						).is_none()
						and global_value_index_find_exact(
							qualified,
							definition_id(dep_identity, 20),
						).is_some()
						and global_value_index_find_exact(
							bare,
							definition_id(dep_identity, 21),
						).is_some()
						and global_value_projection_find_qualified(
							projection,
							qualified_identity,
							qualified_module.view,
							"Dep",
							"dep_value",
						)
							.map(func(found): found
									.map(func(binding): binding.module_path == "pkg/dep")
									.get_or(False))
							.get_or(False)
						and global_value_index_find_visible(qualified, "dep_value").is_none()
					)
				_:
					False


private pure func local_global_shadows_direct_import_without_hiding_exact_identity() -> Bool:
	app_identity = module_identity("app/shadow")
	dep_identity = module_identity("pkg/shadow")
	local = entry(91, TYPE_INT, TYPE_INT, None, ImmutableBinding, "app/shadow")
	imported = entry(92, TYPE_STRING, TYPE_STRING, None, ImmutableBinding, "pkg/shadow")
	inputs: List[GlobalValueProjectionInput] = [
		{
			module_identity = dep_identity,
			source_module_path = "source/shadow",
			canonical_module_path = "pkg/shadow",
			source_name = "value",
			visibility = PublicDeclaration,
			entry = imported
		},
		{
			module_identity = app_identity,
			source_module_path = "app/shadow",
			canonical_module_path = "app/shadow",
			source_name = "value",
			visibility = PublicDeclaration,
			entry = local
		},
	]
	module: GlobalValueProjectionModule = {
		module_identity = app_identity,
		module_path = "app/shadow",
		view = direct_view("pkg/shadow")
	}

	match global_value_projection_build(inputs, [module]):
		Ok(projection):
			match global_value_projection_find(projection, app_identity):
				Ok(index):
					(
						global_value_index_find_visible(index, "value")
							.map(
								func(
									binding,
								): accepted_global_definition_id_value(
									binding.entry.definition_id,
								) == 91,
							)
							.get_or(False)
						and global_value_index_find_exact(
							index,
							definition_id(dep_identity, 92),
						).is_some()
					)
				Err(_):
					False
		Err(_):
			False


private pure func unrelated_graph_globals_do_not_increase_overlay_visits() -> Bool:
	app_identity = module_identity("app/main")
	unrelated_identity = module_identity("pkg/unrelated")
	module: GlobalValueProjectionModule = {
		module_identity = app_identity,
		module_path = "app/main",
		view = COMPILER_MODULE_VIEW_EMPTY
	}
	local_input: GlobalValueProjectionInput = {
		module_identity = app_identity,
		source_module_path = "app/source",
		canonical_module_path = "app/main",
		source_name = "local_value",
		visibility = PublicDeclaration,
		entry = entry(50, TYPE_INT, TYPE_INT, None, ImmutableBinding, "app/main")
	}
	unrelated_input: GlobalValueProjectionInput = {
		module_identity = unrelated_identity,
		source_module_path = "source/unrelated",
		canonical_module_path = "pkg/unrelated",
		source_name = "unrelated_value",
		visibility = PublicDeclaration,
		entry = entry(60, TYPE_STRING, TYPE_STRING, None, ImmutableBinding, "pkg/unrelated")
	}
	unrelated_input_two: GlobalValueProjectionInput = {
		module_identity = unrelated_identity,
		source_module_path = "source/unrelated",
		canonical_module_path = "pkg/unrelated",
		source_name = "unrelated_value_two",
		visibility = PublicDeclaration,
		entry = entry(61, TYPE_STRING, TYPE_STRING, None, ImmutableBinding, "pkg/unrelated")
	}
	unrelated_input_three: GlobalValueProjectionInput = {
		module_identity = unrelated_identity,
		source_module_path = "source/unrelated",
		canonical_module_path = "pkg/unrelated",
		source_name = "unrelated_value_three",
		visibility = PublicDeclaration,
		entry = entry(62, TYPE_STRING, TYPE_STRING, None, ImmutableBinding, "pkg/unrelated")
	}
	unrelated_input_four: GlobalValueProjectionInput = {
		module_identity = unrelated_identity,
		source_module_path = "source/unrelated",
		canonical_module_path = "pkg/unrelated",
		source_name = "unrelated_value_four",
		visibility = PublicDeclaration,
		entry = entry(63, TYPE_STRING, TYPE_STRING, None, ImmutableBinding, "pkg/unrelated")
	}

	match (
		(
			global_value_projection_observe_build([local_input], [module]),
			global_value_projection_observe_build(
				[
					local_input,
					unrelated_input,
					unrelated_input_two,
					unrelated_input_three,
					unrelated_input_four,
				],
				[module],
			),
		)
	):
		(Ok(base), Ok(expanded)):
			(
				base.canonical_input_visits == 1
				and expanded.canonical_input_visits == 5
				and base.overlay_input_visits == 1
				and expanded.overlay_input_visits == 1
			)
		_:
			False


tests: TestSuite = {
	description = "Compiler global value authority index",
	tests = [
		(
			"typed exact and source indexes preserve metadata",
			typed_exact_and_source_indexes_preserve_metadata,
		),
		(
			"duplicate exact and visible bindings fail closed",
			duplicate_exact_and_visible_bindings_fail_closed,
		),
		(
			"module qualified lookup is separate from bare lookup",
			module_qualified_lookup_is_separate_from_bare_lookup,
		),
		(
			"projection preserves local selective and qualified visibility",
			projection_preserves_local_selective_and_qualified_visibility,
		),
		(
			"unrelated graph globals do not increase overlay visits",
			unrelated_graph_globals_do_not_increase_overlay_visits,
		),
		(
			"local global shadows direct import without hiding exact identity",
			local_global_shadows_direct_import_without_hiding_exact_identity,
		),
	]
}
