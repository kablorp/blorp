private pure func first_load_token(transition: ServerActorTransition) -> Option[SourceLoadToken]:
	effect ?= transition.effects.find(func(candidate):
		match candidate:
			LoadWorkspace(_, _):
				True
			_:
				False
	)

	match effect:
		LoadWorkspace(token, _):
			Some(token)
		_:
			None


private pure func first_load_effect(transition: ServerActorTransition) -> Bool:
	first_load_token(transition).is_some()


private pure func first_open_effect_document(
	transition: ServerActorTransition,
) -> Option[OpenedDocument]:
	effect ?= transition.effects.find(func(candidate):
		match candidate:
			ResolveOpenDocument(_):
				True
			_:
				False
	)

	match effect:
		ResolveOpenDocument(document):
			Some(document)
		_:
			None


private pure func has_open_resolution(transition: ServerActorTransition) -> Bool:
	first_open_effect_document(transition).is_some()


private pure func first_save_effect_uri(transition: ServerActorTransition) -> Option[DocumentUri]:
	effect ?= transition.effects.find(func(candidate):
		match candidate:
			RefreshSavedSource(_):
				True
			_:
				False
	)

	match effect:
		RefreshSavedSource(uri):
			Some(uri)
		_:
			None


private pure func has_save_refresh(transition: ServerActorTransition) -> Bool:
	first_save_effect_uri(transition).is_some()


private pure func has_document_sync_issue(transition: ServerActorTransition) -> Bool:
	transition.effects.any(func(effect):
		match effect:
			ReportDocumentSyncIssue(_):
				True
			_:
				False
	)


private pure func has_diagnostic_clear(transition: ServerActorTransition) -> Bool:
	transition.effects.any(func(effect):
		match effect:
			ClearDiagnostics(_):
				True
			_:
				False
	)


private pure func snapshot_identities_match(
	left: SnapshotIdentity,
	right: SnapshotIdentity,
) -> Bool:
	document_versions_match = match (left.document_version, right.document_version):
		(Some(left_version), Some(right_version)):
			document_version_value(left_version) == document_version_value(right_version)
		(None, None):
			True
		_:
			False

	(
		left.uri == right.uri
		and document_versions_match
		and workspace_revision_value(
			left.workspace_revision,
		) == workspace_revision_value(right.workspace_revision)
		and configuration_epoch_value(
			left.configuration_epoch,
		) == configuration_epoch_value(right.configuration_epoch)
	)


private pure func has_empty_diagnostic_publication(
	transition: ServerActorTransition,
	identity: SnapshotIdentity,
) -> Bool:
	transition.effects.any(func(effect):
		match effect:
			PublishDiagnostics(publication):
				(
					snapshot_identities_match(publication.identity, identity)
					and publication.diagnostics.is_empty()
				)
			_:
				False
	)


private pure func has_diagnostic_publication(transition: ServerActorTransition) -> Bool:
	transition.effects.any(func(effect):
		match effect:
			PublishDiagnostics(_):
				True
			_:
				False
	)


private func proved_workspace_suppresses_late_interactive_failure_case() -> Option[Bool]:
	source = discovered_source()
	workspace ?= workspace(configuration(), [source]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= apply_server_event(state, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested)
	interactive_request ?= analysis_request_for_purpose(
		opened,
		InteractiveDocumentAnalysis(source.uri),
	)
	workspace_request ?= analysis_request_for_purpose(opened, WorkspaceIndexAnalysis)
	workspace_result ?= run_compiler_analysis(workspace_request).to_option()
	workspace_committed ?= apply_server_event(
		opened.state,
		ServerAnalysisCompleted({
			scheduled = {
				token = workspace_request.cancellation_token,
				plan = workspace_request.plan
			},
			result = Ok(workspace_result),
		}),
	).to_option()
	interactive_failure: AnalysisCompletion = {
		scheduled = {
			token = interactive_request.cancellation_token,
			plan = interactive_request.plan
		},
		result = Err(AnalysisWorkerFailed("late interactive failure"))
	}
	failed ?= apply_server_event(
		workspace_committed.state,
		ServerAnalysisCompleted(interactive_failure),
	).to_option()
	malformed: AnalysisCompletion = {
		scheduled = interactive_failure.scheduled,
		result = Ok({
			workspace_revision = interactive_request.plan.workspace_revision,
			dependencies = dependency_store(),
			outcomes = [],
		})
	}
	rejected ?= apply_server_event(
		workspace_committed.state,
		ServerAnalysisCompleted(malformed),
	).to_option()

	Some(
		(
			not has_diagnostic_publication(failed)
			and not has_diagnostic_publication(rejected)
			and has_completion_rejection(rejected)
			and server_active_analysis_for(
				failed.state,
				InteractiveDocumentAnalysis(source.uri),
			).is_none()
			and server_active_analysis_for(failed.state, WorkspaceIndexAnalysis).is_none()
		),
	)


func test_proved_workspace_suppresses_late_interactive_failure() -> Bool:
	proved_workspace_suppresses_late_interactive_failure_case().get_or(False)


private pure func current_analysis_failure_publishes_clear_case() -> Option[Bool]:
	source = discovered_source()
	workspace ?= workspace(configuration(), [source]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= apply_server_event(state, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested)
	request ?= first_analysis_request(opened)
	target ?= request.plan.targets.get(0)
	completion: AnalysisCompletion = {
		scheduled = {
			token = request.cancellation_token,
			plan = request.plan
		},
		result = Err(AnalysisWorkerFailed("graph failure"))
	}
	failed ?= apply_server_event(opened.state, ServerAnalysisCompleted(completion)).to_option()

	Some(
		(
			has_empty_diagnostic_publication(failed, target.identity)
			and server_active_analysis_for(
				failed.state,
				InteractiveDocumentAnalysis(source.uri),
			).is_none()
			and server_active_analysis_for(failed.state, WorkspaceIndexAnalysis).is_some()
		),
	)


pure func test_current_analysis_failure_publishes_clear() -> Bool:
	current_analysis_failure_publishes_clear_case().get_or(False)


private pure func resolve_requested_open(
	transition: ServerActorTransition,
) -> Option[ServerActorTransition]:
	requested_document ?= first_open_effect_document(transition)
	apply_server_event(transition.state, resolved_open_event(requested_document)).to_option()


private pure func resolved_open_event(document: OpenedDocument) -> ServerEvent:
	resolved: ResolvedDocumentOpen = {
		document = document,
		source = source_file("/workspace/main.brp", "main", document.document.text),
		provenance = DiskSource
	}
	ServerDocumentOpenResolved(resolved)


private pure func saved_source(text: String) -> DiscoveredSourceSnapshot:
	{
		uri = document_uri("file:///workspace/main.brp"),
		layer = discovered_source_layer(
			source_file("/workspace/main.brp", "main", text),
			DiskSource,
		)
	}


private pure func valid_open_document() -> Option[OpenedDocument]:
	version ?= document_version(1)
	Some({
		document = {
			uri = document_uri("file:///workspace/main.brp"),
			version = version,
			text = "VALUE = 10\n"
		},
		language_id = "blorp",
	})


private pure func canonical_document_routing_case() -> Option[Bool]:
	workspace ?= workspace(configuration(), [discovered_source()]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= apply_server_event(state, open_event).to_option()
	actor_configuration ?= server_workspace_configuration(open_requested.state)
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested)
	opened_document ?= server_find_document(
		opened.state,
		document_uri("file:///workspace/main.brp"),
	)
	duplicate ?= apply_server_event(opened.state, open_event).to_option()
	change_event ?= client_event(DID_CHANGE_VERSION_TWO_BODY)
	changed ?= apply_server_event(duplicate.state, change_event).to_option()
	changed_document ?= server_find_document(
		changed.state,
		document_uri("file:///workspace/main.brp"),
	)
	stale_event ?= client_event(DID_CHANGE_STALE_BODY)
	stale ?= apply_server_event(changed.state, stale_event).to_option()
	stale_document ?= server_find_document(stale.state, document_uri("file:///workspace/main.brp"))
	close_event ?= client_event(DID_CLOSE_VALID_BODY)
	closed ?= apply_server_event(stale.state, close_event).to_option()

	Some(
		(
			has_open_resolution(open_requested)
			and open_requested.effects.length() == 1
			and actor_configuration.workspace_roots.length() == 1
			and first_analysis_request(opened).is_some()
			and opened_document.document.text == "VALUE = 10\n"
			and duplicate.effects.is_empty()
			and changed_document.document.text == "VALUE = 20\n"
			and stale.effects.is_empty()
			and stale_document.document.text == "VALUE = 20\n"
			and has_diagnostic_clear(closed)
			and server_find_document(
				closed.state,
				document_uri("file:///workspace/main.brp"),
			).is_none()
		),
	)


pure func test_document_notifications_route_through_canonical_workspace() -> Bool:
	canonical_document_routing_case().get_or(False)


private pure func save_refresh_routing_case() -> Option[Bool]:
	workspace ?= workspace(configuration(), [discovered_source()]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= apply_server_event(state, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested)
	save_event ?= client_event(DID_SAVE_VALID_BODY)
	save_requested ?= apply_server_event(opened.state, save_event).to_option()
	refresh_uri ?= first_save_effect_uri(save_requested)

	if refresh_uri != document_uri("file:///workspace/main.brp"):
		None
	else:
		refreshed ?= apply_server_event(save_requested.state, ServerSavedSourceUpdated({
				uri = document_uri("file:///workspace/main.brp"),
				layer = discovered_source_layer(
					source_file("/workspace/main.brp", "main", "VALUE = 30\n"),
					DiskSource,
				),
			})).to_option()
		document ?= server_find_document(
			refreshed.state,
			document_uri("file:///workspace/main.brp"),
		)

		Some(
			(
				has_save_refresh(save_requested)
				and save_requested.effects.length() == 1
				and document.document.text == "VALUE = 10\n"
			),
		)


pure func test_save_refresh_is_effectful_and_preserves_overlay() -> Bool:
	save_refresh_routing_case().get_or(False)


private pure func rejected_open_session_case() -> Option[Bool]:
	uri = document_uri("file:///workspace/main.brp")
	workspace ?= workspace(configuration(), [discovered_source()]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	first_request ?= apply_server_event(state, open_event).to_option()
	rejected ?= apply_server_event(
		first_request.state,
		ServerDocumentOpenResolutionFailed(uri, OpenSourceOutsideCatalog(uri)),
	).to_option()
	duplicate ?= apply_server_event(rejected.state, open_event).to_option()
	change_event ?= client_event(DID_CHANGE_VERSION_TWO_BODY)
	ignored_change ?= apply_server_event(duplicate.state, change_event).to_option()
	close_event ?= client_event(DID_CLOSE_VALID_BODY)
	closed ?= apply_server_event(ignored_change.state, close_event).to_option()
	reopened ?= apply_server_event(closed.state, open_event).to_option()

	Some(
		(
			has_document_sync_issue(rejected)
			and duplicate.effects.is_empty()
			and ignored_change.effects.is_empty()
			and closed.effects.is_empty()
			and has_open_resolution(reopened)
		),
	)


pure func test_rejected_open_session_ignores_sync_until_close() -> Bool:
	rejected_open_session_case().get_or(False)


private pure func document_effects_preserve_event_order_case() -> Option[Bool]:
	uri = document_uri("file:///workspace/main.brp")
	workspace ?= workspace(configuration(), [discovered_source()]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= apply_server_event(state, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested)
	change_event ?= client_event(DID_CHANGE_VERSION_TWO_BODY)
	changed ?= apply_server_event(opened.state, change_event).to_option()
	changed_document ?= server_find_document(changed.state, uri)
	save_event ?= client_event(DID_SAVE_VALID_BODY)
	save_requested ?= apply_server_event(changed.state, save_event).to_option()
	refresh_uri ?= first_save_effect_uri(save_requested)
	refreshed ?= apply_server_event(
		save_requested.state,
		ServerSavedSourceUpdated(saved_source("VALUE = 30\n")),
	).to_option()
	refreshed_document ?= server_find_document(refreshed.state, uri)
	close_event ?= client_event(DID_CLOSE_VALID_BODY)
	closed ?= apply_server_event(refreshed.state, close_event).to_option()

	Some(
		(
			has_open_resolution(open_requested)
			and changed_document.document.text == "VALUE = 20\n"
			and refresh_uri == uri
			and refreshed_document.document.text == "VALUE = 20\n"
			and has_diagnostic_clear(closed)
			and server_find_document(closed.state, uri).is_none()
		),
	)


pure func test_document_effects_preserve_event_order() -> Bool:
	document_effects_preserve_event_order_case().get_or(False)


private pure func hidden_saved_refresh_preserves_active_analysis_case() -> Option[Bool]:
	uri = document_uri("file:///workspace/main.brp")
	workspace ?= workspace(configuration(), [discovered_source()]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
