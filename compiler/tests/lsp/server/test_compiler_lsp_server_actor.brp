private pure func user_source(module_name: String, text: String) -> DiscoveredSourceSnapshot:
	{
		uri = document_uri("file:///workspace/" + module_name + ".brp"),
		layer = discovered_source_layer(
			source_file("/workspace/" + module_name + ".brp", module_name, text),
			DiskSource,
		)
	}


private pure func discovered_source() -> DiscoveredSourceSnapshot:
	user_source("main", "VALUE = 1\n")


private pure func package_source(module_name: String) -> DiscoveredSourceSnapshot:
	{
		uri = document_uri("file:///std/" + module_name + ".brp"),
		layer = discovered_source_layer(
			source_file("/std/" + module_name + ".brp", module_name, "VALUE = 2\n"),
			StandardLibrarySource,
		)
	}


private pure func configuration() -> WorkspaceConfiguration:
	{
		workspace_roots = [
			{
				client_uri = document_uri("file:///workspace"),
				client_path = "/workspace",
				canonical_path = "/workspace"
			},
		],
		std_provider = ProjectFilesystemStd("std"),
		source_packages = [],
		native_package_roots = []
	}


