private pure func running_server_state(workspace: Workspace) -> Option[NativeServerState]:
	ready ?= awaiting_initialized_server_state(workspace)
	initialized ?= client_event(INITIALIZED_BODY)
	running ?= apply_server_event(ready, initialized).to_option()
	active ?= server_active_analysis(running.state)
	settled ?= apply_server_event(running.state, ServerAnalysisCompleted({
			scheduled = active,
			result = Err(AnalysisWorkerFailed("bootstrap test completion")),
		})).to_option()
	Some(settled.state)


private pure func awaiting_initialized_server_state(
	workspace: Workspace,
) -> Option[NativeServerState]:
	initialize ?= client_event(INITIALIZE_BODY)
	loading ?= apply_server_event(
		initial_server_state(source_load_environment()),
		initialize,
	).to_option()
	load_token ?= first_load_token(loading)
	ready ?= apply_server_event(
		loading.state,
		ServerSourceLoadSucceeded(load_token, workspace, []),
	).to_option()
	Some(ready.state)


private pure func source_load_environment() -> SourceLoadEnvironment:
	{
		working_directory = "/workspace",
		std_override = None,
		package_cache_root = "/cache",
		policy = default_source_discovery_policy()
	}


private pure func first_analysis_request(
	transition: ServerActorTransition,
) -> Option[AnalysisRequest]:
	effect ?= transition.effects.find(func(effect):
		match effect:
			StartAnalysis(_):
				True
			_:
				False
	)

	match effect:
		StartAnalysis(request):
			Some(request)
		_:
			None


private pure func purposes_equal(left: AnalysisPurpose, right: AnalysisPurpose) -> Bool:
	match (left, right):
		(WorkspaceIndexAnalysis, WorkspaceIndexAnalysis):
			True
		(InteractiveDocumentAnalysis(left_uri), InteractiveDocumentAnalysis(right_uri)):
			document_uri_value(left_uri) == document_uri_value(right_uri)
		_:
			False


private pure func analysis_request_for_purpose(
	transition: ServerActorTransition,
	purpose: AnalysisPurpose,
) -> Option[AnalysisRequest]:
	effect ?= transition.effects.find(func(effect):
		match effect:
			StartAnalysis(request):
				purposes_equal(request.plan.purpose, purpose)
			_:
				False
	)

	match effect:
		StartAnalysis(request):
			Some(request)
		_:
			None


private pure func has_cancellation_effect(
	transition: ServerActorTransition,
	purpose: AnalysisPurpose,
	token_value: Int,
) -> Bool:
	transition.effects.any(func(effect):
		match effect:
			CancelAnalysis(cancelled_purpose, token):
				(
					purposes_equal(cancelled_purpose, purpose)
					and cancellation_token_value(token) == token_value
				)
			_:
				False
	)


private pure func has_completion_rejection(transition: ServerActorTransition) -> Bool:
	transition.effects.any(func(effect):
		match effect:
			AnalysisCompletionRejected(AnalysisCompletionMissingTarget(_)):
				True
			_:
				False
	)


private pure func latest_wins_case() -> Option[Bool]:
	source = discovered_source()
	workspace ?= workspace(configuration(), [source]).to_option()
	initial ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= apply_server_event(initial, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested)
	revision_one_request ?= first_analysis_request(opened)
	revision_one_completion: AnalysisCompletion = {
		scheduled = {
			token = revision_one_request.cancellation_token,
			plan = revision_one_request.plan
		},
		result = Err(AnalysisWorkerFailed("stale worker failure"))
	}

	change_event ?= client_event(DID_CHANGE_VERSION_TWO_BODY)
	changed ?= apply_server_event(opened.state, change_event).to_option()
	newest_change_event ?= client_event(DID_CHANGE_VERSION_THREE_BODY)
	newest ?= apply_server_event(changed.state, newest_change_event).to_option()

	if (
		not has_cancellation_effect(
			changed,
			InteractiveDocumentAnalysis(source.uri),
			cancellation_token_value(revision_one_request.cancellation_token),
		)
		or not newest.effects.is_empty()
		or server_pending_analysis(newest.state).is_none()
	):
		None
	else:
		completed ?= apply_server_event(
			newest.state,
			ServerAnalysisCompleted(revision_one_completion),
		).to_option()
		replacement ?= first_analysis_request(completed)
		active ?= server_active_analysis(completed.state)

		Some(
			(
				completed.effects.length() == 1
				and cancellation_token_value(
					replacement.cancellation_token,
				) == cancellation_token_value(active.token)
				and workspace_revision_value(replacement.plan.workspace_revision) == 3
				and server_pending_analysis_for(
					completed.state,
					InteractiveDocumentAnalysis(source.uri),
				).is_none()
				and server_pending_analysis_for(completed.state, WorkspaceIndexAnalysis).is_some()
			),
		)


pure func test_stale_completion_starts_only_newest_replacement() -> Bool:
	latest_wins_case().get_or(False)


private pure func ready_state_starts_idle_case() -> Option[Bool]:
	source = discovered_source()
	workspace ?= workspace(configuration(), [source]).to_option()
	state ?= running_server_state(workspace)
	references_event ?= client_event(REFERENCES_BODY)
	queried ?= apply_server_event(state, references_event).to_option()
	body ?= first_sent_message(queried)
	response ?= parse_json(body).to_option()
	Some(
		(
			server_active_analysis(state).is_none()
			and server_pending_analysis(state).is_none()
			and get_field(response, "result") == Some(JsonNull)
		),
	)


pure func test_ready_state_starts_idle() -> Bool:
	ready_state_starts_idle_case().get_or(False)


pure func test_cancellation_failure_releases_payload() -> Bool:
	failure = AnalysisWaveCancelled(cancellation_token(0))

	match failure:
		AnalysisWaveCancelled(token):
			cancellation_token_value(token) == 0
		_:
			False


private pure func opening_starts_analysis_case() -> Option[Bool]:
	source = discovered_source()
	workspace ?= workspace(configuration(), [source]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= apply_server_event(state, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested)
	interactive_request ?= analysis_request_for_purpose(
		opened,
		InteractiveDocumentAnalysis(source.uri),
	)
	workspace_request ?= analysis_request_for_purpose(opened, WorkspaceIndexAnalysis)

	Some(
		(
			opened.effects.length() == 2
			and interactive_request.plan.targets.length() == 1
			and interactive_request.plan.roots.length() == 1
			and workspace_request.plan.targets.length() == 1
			and server_active_analysis_for(
				opened.state,
				InteractiveDocumentAnalysis(source.uri),
			).is_some()
			and server_active_analysis_for(opened.state, WorkspaceIndexAnalysis).is_some()
		),
	)


pure func test_opening_starts_analysis() -> Bool:
	opening_starts_analysis_case().get_or(False)


private pure func shutdown_retires_analysis_case() -> Option[Bool]:
	source = discovered_source()
	workspace ?= workspace(configuration(), [source]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= apply_server_event(state, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested)
	interactive_request ?= analysis_request_for_purpose(
		opened,
		InteractiveDocumentAnalysis(source.uri),
	)
	workspace_request ?= analysis_request_for_purpose(opened, WorkspaceIndexAnalysis)
	shutdown ?= client_event(SHUTDOWN_BODY)
	shutting_down ?= apply_server_event(opened.state, shutdown).to_option()
	interactive_completion: AnalysisCompletion = {
		scheduled = {
			token = interactive_request.cancellation_token,
			plan = interactive_request.plan
		},
		result = Err(AnalysisWorkerFailed("late completion"))
	}
	workspace_completion: AnalysisCompletion = {
		scheduled = {
			token = workspace_request.cancellation_token,
			plan = workspace_request.plan
		},
		result = Err(AnalysisWorkerFailed("late completion"))
	}
	late_interactive ?= apply_server_event(
		shutting_down.state,
		ServerAnalysisCompleted(interactive_completion),
	).to_option()
	late_workspace ?= apply_server_event(
		late_interactive.state,
		ServerAnalysisCompleted(workspace_completion),
	).to_option()

	Some(
		(
			first_sent_message(shutting_down).is_some()
			and has_cancellation_effect(
				shutting_down,
				InteractiveDocumentAnalysis(source.uri),
				cancellation_token_value(interactive_request.cancellation_token),
			)
			and has_cancellation_effect(
				shutting_down,
				WorkspaceIndexAnalysis,
				cancellation_token_value(workspace_request.cancellation_token),
			)
			and server_active_analysis(shutting_down.state).is_none()
			and server_pending_analysis(shutting_down.state).is_none()
			and late_interactive.effects.is_empty()
			and late_workspace.effects.is_empty()
			and server_active_analysis(late_workspace.state).is_none()
		),
	)


pure func test_shutdown_retires_analysis_and_ignores_late_completion() -> Bool:
	shutdown_retires_analysis_case().get_or(False)


private pure func change_queues_replacement_case() -> Option[Bool]:
	source = discovered_source()
	workspace ?= workspace(configuration(), [source]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= apply_server_event(state, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested)
	interactive_active ?= server_active_analysis_for(
		opened.state,
		InteractiveDocumentAnalysis(source.uri),
	)
	workspace_active ?= server_active_analysis_for(opened.state, WorkspaceIndexAnalysis)
	change_event ?= client_event(DID_CHANGE_VERSION_TWO_BODY)
	changed ?= apply_server_event(opened.state, change_event).to_option()

	Some(
		(
			changed.effects.length() == 2
			and has_cancellation_effect(
				changed,
				InteractiveDocumentAnalysis(source.uri),
				cancellation_token_value(interactive_active.token),
			)
			and has_cancellation_effect(
				changed,
				WorkspaceIndexAnalysis,
				cancellation_token_value(workspace_active.token),
			)
			and server_pending_analysis_for(
				changed.state,
				InteractiveDocumentAnalysis(source.uri),
			).is_some()
			and server_pending_analysis_for(changed.state, WorkspaceIndexAnalysis).is_some()
		),
	)


pure func test_change_queues_replacement() -> Bool:
	change_queues_replacement_case().get_or(False)


private pure func close_retires_interactive_replacement_case() -> Option[Bool]:
	source = discovered_source()
	workspace ?= workspace(configuration(), [source]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= apply_server_event(state, open_event).to_option()
	opened ?= resolve_requested_open(open_requested)
	interactive_active ?= server_active_analysis_for(
		opened.state,
		InteractiveDocumentAnalysis(source.uri),
	)
	change_event ?= client_event(DID_CHANGE_VERSION_TWO_BODY)
	changed ?= apply_server_event(opened.state, change_event).to_option()
	close_event ?= client_event(DID_CLOSE_VALID_BODY)
	closed ?= apply_server_event(changed.state, close_event).to_option()
	late_completion: AnalysisCompletion = {
		scheduled = interactive_active,
		result = Err(AnalysisWorkerFailed("obsolete interactive completion"))
	}
	late ?= apply_server_event(closed.state, ServerAnalysisCompleted(late_completion)).to_option()

	Some(
		(
			has_cancellation_effect(
				closed,
				InteractiveDocumentAnalysis(source.uri),
				cancellation_token_value(interactive_active.token),
			)
			and server_active_analysis_for(
				closed.state,
				InteractiveDocumentAnalysis(source.uri),
			).is_none()
			and server_pending_analysis_for(
				closed.state,
				InteractiveDocumentAnalysis(source.uri),
			).is_none()
			and first_analysis_request(late).is_none()
			and server_active_analysis_for(
				late.state,
				InteractiveDocumentAnalysis(source.uri),
			).is_none()
		),
	)


pure func test_close_retires_interactive_replacement() -> Bool:
	close_retires_interactive_replacement_case().get_or(False)


private pure func rejected_completion_retires_active_case() -> Option[Bool]:
	source = discovered_source()
	workspace ?= workspace(configuration(), [source]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= apply_server_event(state, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested)
	request ?= first_analysis_request(opened)
	target ?= request.plan.targets.get(0)
	malformed: AnalysisCompletion = {
		scheduled = {
			token = request.cancellation_token,
			plan = { request.plan | targets = [] }
		},
		result = Ok({
			workspace_revision = request.plan.workspace_revision,
			dependencies = dependency_store(),
			outcomes = [],
		})
	}
	rejected ?= apply_server_event(opened.state, ServerAnalysisCompleted(malformed)).to_option()

	change_event ?= client_event(DID_CHANGE_VERSION_TWO_BODY)
	recovered ?= apply_server_event(rejected.state, change_event).to_option()

	Some(
		(
			has_completion_rejection(rejected)
			and has_empty_diagnostic_publication(rejected, target.identity)
			and server_active_analysis_for(
				rejected.state,
				InteractiveDocumentAnalysis(source.uri),
			).is_none()
			and server_active_analysis_for(rejected.state, WorkspaceIndexAnalysis).is_some()
			and first_analysis_request(recovered).is_some()
			and server_active_analysis(recovered.state).is_some()
		),
	)


pure func test_rejected_completion_retires_active_analysis() -> Bool:
	rejected_completion_retires_active_case().get_or(False)


private pure func client_event(body: String) -> Option[ServerEvent]:
	envelope ?= decode_lsp_json_rpc_body(body).to_option()
	Some(ServerClientEnvelope(envelope))


private pure func first_sent_message(transition: ServerActorTransition) -> Option[String]:
	effect ?= transition.effects.find(func(candidate):
		match candidate:
			SendMessage(_):
				True
			_:
				False
	)

	match effect:
		SendMessage(body):
			Some(body)
		_:
			None


private pure func response_result_values(
	transition: ServerActorTransition,
) -> Option[List[JsonValue]]:
	body ?= first_sent_message(transition)
	value ?= parse_json(body).to_option()
	result ?= get_field(value, "result")
	result.as_array()


private pure func response_result_field(
	transition: ServerActorTransition,
	field: String,
) -> Option[JsonValue]:
	body ?= first_sent_message(transition)
	value ?= parse_json(body).to_option()
	result ?= get_field(value, "result")
	get_field(result, field)


private pure func response_result_position(
	transition: ServerActorTransition,
	range_field: String,
	position_field: String,
) -> Option[(Float, Float)]:
	range ?= response_result_field(transition, range_field)
	position ?= get_field(range, position_field)
	line ?= get_field(position, "line")
	character ?= get_field(position, "character")
	line_number ?= as_number(line)
	character_number ?= as_number(character)
	Some((line_number, character_number))


private pure func response_result_item(
	transition: ServerActorTransition,
	index: Int,
) -> Option[JsonValue]:
	values ?= response_result_values(transition)
	values.get(index)


private pure func response_result_string_at(
	transition: ServerActorTransition,
	index: Int,
	field: String,
) -> Option[String]:
	item ?= response_result_item(transition, index)
	field_value ?= get_field(item, field)
	as_string(field_value)


private pure func response_result_number_at(
	transition: ServerActorTransition,
	index: Int,
	field: String,
) -> Option[Float]:
	item ?= response_result_item(transition, index)
	field_value ?= get_field(item, field)
	as_number(field_value)


private pure func response_result_first_string(
	transition: ServerActorTransition,
	field: String,
) -> Option[String]:
	response_result_string_at(transition, 0, field)


private pure func response_result_first_uri(transition: ServerActorTransition) -> Option[String]:
	response_result_first_string(transition, "uri")


private pure func response_result_first_symbol_name(
	transition: ServerActorTransition,
) -> Option[String]:
	response_result_first_string(transition, "name")


private pure func response_result_position_at(
	transition: ServerActorTransition,
	index: Int,
	range_field: String,
	position_field: String,
) -> Option[(Float, Float)]:
	item ?= response_result_item(transition, index)
	range ?= get_field(item, range_field)
	position ?= get_field(range, position_field)
	line ?= get_field(position, "line")
	character ?= get_field(position, "character")
	line_number ?= as_number(line)
	character_number ?= as_number(character)
	Some((line_number, character_number))


private func analyzed_workspace(open_overlay: Bool) -> Option[Workspace]:
	main_text = "VALUE: Int = 1\nfunc read() -> Int:\n\tVALUE\n"

	disk_text = if open_overlay:
		"BROKEN: Int = missing\n"
	else:
		main_text

	source = user_source("main", disk_text)
	other = user_source("other", "import:\n\tmain: VALUE\n\nOTHER: Int = VALUE\n")
	initial ?= workspace(
		configuration(),
		[source, other],
	).to_option()
	version ?= document_version(1)

	prepared ?= if open_overlay:
		apply_workspace_event(
			initial,
			ResolvedDocumentOpened({
				document = {
					document = {
						uri = source.uri,
						version = version,
						text = main_text
					},
					language_id = "blorp"
				},
				source = { source.layer.source | text = main_text },
				provenance = source.layer.provenance,
			}),
		).to_option()
	else:
		snapshot = workspace_snapshot(initial)
		Some(
			(
				initial,
				{
					snapshot = snapshot,
					invalidation = {
						workspace_revision = snapshot.compiler.revision,
						modules = []
					},
					analysis_planning = AnalysisPlanRequired,
					diagnostics_to_clear = []
				},
			),
		)

	plan ?= plan_analysis(prepared[1]).to_option()
	request: AnalysisRequest = {
		plan = plan,
		cancellation_token = cancellation_token(1)
	}
	result ?= run_compiler_analysis(request).to_option()
	completion: AnalysisCompletion = {
		scheduled = {
			token = request.cancellation_token,
			plan = request.plan
		},
		result = Ok(result)
	}

	match apply_analysis_completion(prepared[0], completion):
		Ok((updated, AnalysisCommitted(_))):
			Some(updated)
		_:
			None


private func accepted_semantic_queries_return_snapshot_result_case() -> Option[Bool]:
	workspace ?= analyzed_workspace(False)
	state ?= running_server_state(workspace)
	definition_event ?= client_event(DEFINITION_BODY)
	document_symbol_event ?= client_event(DOCUMENT_SYMBOL_BODY)
	references_event ?= client_event(REFERENCES_BODY)
	hover_event ?= client_event(VALID_HOVER_BODY)
	definition ?= apply_server_event(state, definition_event).to_option()
	document_symbols ?= apply_server_event(state, document_symbol_event).to_option()
	references ?= apply_server_event(state, references_event).to_option()
	overlay_workspace ?= analyzed_workspace(True)
	overlay_state ?= running_server_state(overlay_workspace)
	overlay_references ?= apply_server_event(overlay_state, references_event).to_option()
	hover ?= apply_server_event(state, hover_event).to_option()
	sequential_document_symbols ?= apply_server_event(
		definition.state,
		document_symbol_event,
	).to_option()
	sequential_references ?= apply_server_event(
		sequential_document_symbols.state,
		references_event,
	).to_option()

	definition_body ?= first_sent_message(definition)
	document_symbols_body ?= first_sent_message(document_symbols)
	references_body ?= first_sent_message(references)
	hover_contents ?= response_result_field(hover, "contents")
	hover_text ?= get_field(hover_contents, "value")

	Some(
		(
			response_id(definition_body) == Some(12.0)
			and response_id(document_symbols_body) == Some(13.0)
			and response_id(references_body) == Some(11.0)
			and response_result_field(hover, "contents").is_some()
			and as_string(hover_text) == Some("VALUE: Int")
			and response_result_position(hover, "range", "start") == Some((0.0, 0.0))
			and response_result_position(hover, "range", "end") == Some((0.0, 5.0))
			and response_result_values(definition).map(func(values): values.length()) == Some(1)
			and response_result_values(
				document_symbols,
			).map(
				func(values): values.length(),
			) == Some(2)
			and response_result_values(references).map(func(values): values.length()) == Some(3)
			and response_result_values(
				overlay_references,
			).map(
				func(values): values.length(),
			) == Some(3)
			and response_result_first_uri(definition) == Some("file:///workspace/main.brp")
			and response_result_first_symbol_name(document_symbols) == Some("VALUE")
			and response_result_first_uri(references) == Some("file:///workspace/main.brp")
			and response_result_string_at(
				references,
				2,
				"uri",
			) == Some("file:///workspace/other.brp")
			and response_result_number_at(document_symbols, 0, "kind") == Some(13.0)
			and response_result_position_at(definition, 0, "range", "start") == Some((0.0, 0.0))
			and response_result_position_at(definition, 0, "range", "end") == Some((0.0, 14.0))
			and response_result_position_at(references, 0, "range", "start") == Some((0.0, 0.0))
			and response_result_position_at(references, 0, "range", "end") == Some((0.0, 5.0))
			and response_result_position_at(references, 1, "range", "start") == Some((2.0, 1.0))
			and response_result_position_at(references, 1, "range", "end") == Some((2.0, 6.0))
			and response_result_position_at(
				document_symbols,
				0,
				"range",
				"start",
			) == Some((0.0, 0.0))
			and response_result_position_at(
				document_symbols,
				0,
				"range",
				"end",
			) == Some((0.0, 14.0))
			and response_result_position_at(
				document_symbols,
				0,
				"selectionRange",
				"start",
			) == Some((0.0, 0.0))
			and response_result_position_at(
				document_symbols,
				0,
				"selectionRange",
				"end",
			) == Some((0.0, 5.0))
			and response_result_string_at(document_symbols, 1, "name") == Some("read")
			and response_result_number_at(document_symbols, 1, "kind") == Some(12.0)
			and response_result_first_symbol_name(sequential_document_symbols) == Some("VALUE")
			and response_result_first_uri(
				sequential_references,
			) == Some("file:///workspace/main.brp")
			and server_lifecycle(definition.state).is_some()
			and server_lifecycle(document_symbols.state).is_some()
			and server_lifecycle(references.state).is_some()
		),
	)


func test_accepted_semantic_queries_return_snapshot_result() -> Bool:
	accepted_semantic_queries_return_snapshot_result_case().get_or(False)


private func stale_semantic_query_returns_null_without_state_change_case() -> Option[Bool]:
	workspace ?= analyzed_workspace(True)
	state ?= running_server_state(workspace)
	change_event ?= client_event(DID_CHANGE_VERSION_TWO_BODY)
	changed ?= apply_server_event(state, change_event).to_option()
	before_document ?= server_find_document(
		changed.state,
		document_uri("file:///workspace/main.brp"),
	)
	before_active ?= server_active_analysis(changed.state)
	before_configuration ?= server_workspace_configuration(changed.state)
	definition_event ?= client_event(DEFINITION_BODY)
	queried ?= apply_server_event(changed.state, definition_event).to_option()
	references_event ?= client_event(REFERENCES_BODY)
	references ?= apply_server_event(queried.state, references_event).to_option()
	after_document ?= server_find_document(
		queried.state,
		document_uri("file:///workspace/main.brp"),
	)
	after_active ?= server_active_analysis(queried.state)
	after_configuration ?= server_workspace_configuration(queried.state)
	body ?= first_sent_message(queried)
	response ?= parse_json(body).to_option()
	references_body ?= first_sent_message(references)
	references_response ?= parse_json(references_body).to_option()

	Some(
		(
			response_id(body) == Some(12.0)
			and get_field(response, "result") == Some(JsonNull)
			and get_field(references_response, "result") == Some(JsonNull)
			and before_document == after_document
			and cancellation_token_value(
				before_active.token,
			) == cancellation_token_value(after_active.token)
			and server_pending_analysis(
				changed.state,
			).is_some() == server_pending_analysis(queried.state).is_some()
			and before_configuration == after_configuration
		),
	)


func test_stale_semantic_query_returns_null_without_state_change() -> Bool:
	stale_semantic_query_returns_null_without_state_change_case().get_or(False)


