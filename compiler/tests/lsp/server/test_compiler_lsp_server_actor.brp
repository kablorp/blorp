private pure func loading_exit_case() -> Option[Bool]:
	initialize ?= client_event(INITIALIZE_BODY)
	exit ?= client_event(EXIT_BODY)
	loading ?= apply_server_event(
		initial_server_state(source_load_environment()),
		initialize,
	).to_option()
	exited ?= apply_server_event(loading.state, exit).to_option()

	Some(exited.effects.any(func(effect):
			match effect:
				ExitServer(ExitFailure):
					True
				_:
					False
		) and server_lifecycle(exited.state).is_none())


pure func test_exit_while_loading_uses_pre_shutdown_failure_status() -> Bool:
	loading_exit_case().get_or(False)


private pure func response_has_empty_result(body: String) -> Bool:
	match parse_json(body):
		Err(_):
			False
		Ok(response):
			match get_field(response, "result"):
				Some(result):
					result
						.as_array()
						.map(func(values): values.is_empty())
						.get_or(False)
				None:
					False


func test_complete_empty_list_responses_encode_as_arrays() -> Bool:
	id = IntegerRequestId(16)

	(
		response_has_empty_result(
			encode_lsp_definition_response(ProtocolSuccessResponse(id, Some([]))),
		)
		and response_has_empty_result(
			encode_lsp_references_response(ProtocolSuccessResponse(id, Some([]))),
		)
		and response_has_empty_result(
			encode_lsp_document_highlight_response(ProtocolSuccessResponse(id, Some([]))),
		)
		and response_has_empty_result(
			encode_lsp_document_symbol_response(ProtocolSuccessResponse(id, Some([]))),
		)
	)


