private pure func document_notifications_respect_lifecycle_case() -> Option[Bool]:
	uri = document_uri("file:///workspace/main.brp")
	workspace ?= workspace(configuration(), [discovered_source()]).to_option()
	awaiting ?= awaiting_initialized_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	ignored_before_initialized ?= apply_server_event(awaiting, open_event).to_option()
	running ?= running_server_state(workspace)
	shutdown_event ?= client_event(SHUTDOWN_BODY)
	shut_down ?= apply_server_event(running, shutdown_event).to_option()
	ignored_after_shutdown ?= apply_server_event(shut_down.state, open_event).to_option()

	Some(
		(
			ignored_before_initialized.effects.is_empty()
			and server_find_document(ignored_before_initialized.state, uri).is_none()
			and ignored_after_shutdown.effects.is_empty()
			and server_find_document(ignored_after_shutdown.state, uri).is_none()
		),
	)


pure func test_document_notifications_respect_lifecycle_admission() -> Bool:
	document_notifications_respect_lifecycle_case().get_or(False)


private pure func response_code(body: String) -> Option[Float]:
	value ?= parse_json(body).to_option()
	error ?= get_field(value, "error")
	code ?= get_field(error, "code")
	as_number(code)


private pure func response_id(body: String) -> Option[Float]:
	value ?= parse_json(body).to_option()
	id ?= get_field(value, "id")
	as_number(id)


private pure func successful_source_load(
	initialize_body: String,
	workspace: Workspace,
	issues: List[SourceLoadIssue],
) -> Option[(ServerActorTransition, ServerActorTransition)]:
	initialize ?= client_event(initialize_body)
	loading ?= apply_server_event(
		initial_server_state(source_load_environment()),
		initialize,
	).to_option()
	load_token ?= first_load_token(loading)
	ready ?= apply_server_event(
		loading.state,
		ServerSourceLoadSucceeded(load_token, workspace, issues),
	).to_option()
	Some((loading, ready))


private pure func initialization_commits_only_after_loading_case() -> Option[Bool]:
	loaded_workspace ?= workspace(configuration(), [discovered_source()]).to_option()
	loaded ?= successful_source_load(INITIALIZE_BODY, loaded_workspace, [])
	loading = loaded[0]
	ready = loaded[1]
	empty_workspace ?= workspace(configuration(), []).to_option()
	empty_loaded ?= successful_source_load(INITIALIZE_BODY, empty_workspace, [])
	empty_ready = empty_loaded[1]

	if (
		not server_is_loading(loading.state)
		or not first_load_effect(loading)
		or first_sent_message(loading).is_some()
	):
		None
	else:
		response ?= first_sent_message(ready)
		awaiting_lifecycle ?= server_lifecycle(ready.state)
		initialized ?= client_event(INITIALIZED_BODY)
		running ?= apply_server_event(ready.state, initialized).to_option()
		running_lifecycle ?= server_lifecycle(running.state)

		Some(
			(
				response_id(response) == Some(7.0)
				and response_code(response).is_none()
				and ready.effects.length() == 2
				and match ready.effects:
					[SendMessage(_), StartAnalysis(request)]:
						request.plan.targets.length() == 1
					_:
						False
				and match empty_ready.effects:
					[SendMessage(_), StartAnalysis(request)]:
						request.plan.targets.is_empty() and request.plan.roots.is_empty()
					_:
						False
				and lifecycle_running_initialization(awaiting_lifecycle).is_none()
				and lifecycle_running_initialization(running_lifecycle).is_some()
			),
		)


pure func test_initialize_commits_only_after_source_loading() -> Bool:
	initialization_commits_only_after_loading_case().get_or(False)


private pure func planning_conflict_clears_only_declared_sources_case() -> Option[Bool]:
	user = discovered_source()
	conflict = package_source("main")
	closed_external = package_source("external")
	workspace ?= workspace(
		configuration(),
		[user, conflict, closed_external],
	).to_option()
	state ?= running_server_state(workspace)
	version ?= document_version(1)
	opened: ResolvedDocumentOpen = {
		document = {
			document = {
				uri = conflict.uri,
				version = version,
				text = conflict.layer.source.text
			},
			language_id = "blorp"
		},
		source = conflict.layer.source,
		provenance = conflict.layer.provenance
	}
	failed ?= apply_server_event(state, ServerDocumentOpenResolved(opened)).to_option()

	Some(
		match failed.effects:
			[PublishDiagnostics(first), PublishDiagnostics(second), AnalysisPlanningFailed(WorkspaceModuleIdentityConflict(_))]:
				(
					first.identity.uri == conflict.uri
					and second.identity.uri == user.uri
					and first.diagnostics.is_empty()
					and second.diagnostics.is_empty()
				)
			_:
				False
	)


pure func test_planning_conflict_clears_only_declared_sources_in_order() -> Bool:
	planning_conflict_clears_only_declared_sources_case().get_or(False)


private pure func versioned_diagnostics_capability_survives_loading_case() -> Option[Bool]:
	workspace ?= workspace(configuration(), [discovered_source()]).to_option()
	loaded ?= successful_source_load(VERSIONED_DIAGNOSTICS_INITIALIZE_BODY, workspace, [])
	loading = loaded[0]
	ready = loaded[1]
	initialized ?= client_event(INITIALIZED_BODY)
	running ?= apply_server_event(ready.state, initialized).to_option()

	Some(
		(
			not server_supports_versioned_diagnostics(loading.state)
			and not server_supports_versioned_diagnostics(ready.state)
			and server_supports_versioned_diagnostics(running.state)
		),
	)


pure func test_versioned_diagnostics_capability_survives_source_loading() -> Bool:
	versioned_diagnostics_capability_survives_loading_case().get_or(False)


private pure func source_load_issues_are_emitted_case() -> Option[Bool]:
	workspace ?= workspace(configuration(), [discovered_source()]).to_option()
	loaded ?= successful_source_load(
		INITIALIZE_BODY,
		workspace,
		[SourceLoadDirectoryReadFailed("/workspace/src", "permission denied")],
	)
	ready = loaded[1]

	Some(
		match ready.effects:
			[SendMessage(_), ReportSourceLoadIssues(found), StartAnalysis(_)]:
				found.length() == 1
			_:
				False
	)


pure func test_source_load_issues_are_emitted_not_retained() -> Bool:
	source_load_issues_are_emitted_case().get_or(False)


private pure func failed_loading_allows_retry_case() -> Option[Bool]:
	initialize ?= client_event(INITIALIZE_BODY)
	loading ?= apply_server_event(
		initial_server_state(source_load_environment()),
		initialize,
	).to_option()
	load_token ?= first_load_token(loading)
	failed ?= apply_server_event(
		loading.state,
		ServerSourceLoadFailed(load_token, SourceLoadNoWorkspaceRoot),
	).to_option()
	response ?= first_sent_message(failed)
	retry ?= apply_server_event(failed.state, initialize).to_option()

	Some(
		(
			response_id(response) == Some(7.0)
			and response_code(response) == Some(-32603.0)
			and first_load_effect(retry)
			and server_is_loading(retry.state)
		),
	)


pure func test_failed_source_loading_allows_initialize_retry() -> Bool:
	failed_loading_allows_retry_case().get_or(False)


private pure func stale_loading_completion_is_ignored_case() -> Option[Bool]:
	initialize ?= client_event(INITIALIZE_BODY)
	first_loading ?= apply_server_event(
		initial_server_state(source_load_environment()),
		initialize,
	).to_option()
	first_token ?= first_load_token(first_loading)
	failed ?= apply_server_event(
		first_loading.state,
		ServerSourceLoadFailed(first_token, SourceLoadNoWorkspaceRoot),
	).to_option()
	retry ?= apply_server_event(failed.state, initialize).to_option()
	retry_token ?= first_load_token(retry)
	source = discovered_source()
	workspace ?= workspace(configuration(), [source]).to_option()
	stale ?= apply_server_event(
		retry.state,
		ServerSourceLoadSucceeded(first_token, workspace, []),
	).to_option()
	ready ?= apply_server_event(
		stale.state,
		ServerSourceLoadSucceeded(retry_token, workspace, []),
	).to_option()

	Some(
		(
			server_is_loading(stale.state)
			and stale.effects.is_empty()
			and first_sent_message(ready).is_some()
		),
	)


pure func test_stale_source_loading_completion_is_ignored() -> Bool:
	stale_loading_completion_is_ignored_case().get_or(False)


private pure func duplicate_initialize_while_loading_case() -> Option[Bool]:
	initialize ?= client_event(INITIALIZE_BODY)
	duplicate ?= client_event(DUPLICATE_INITIALIZE_BODY)
	loading ?= apply_server_event(
		initial_server_state(source_load_environment()),
		initialize,
	).to_option()
	rejected ?= apply_server_event(loading.state, duplicate).to_option()
	response ?= first_sent_message(rejected)

	Some(
		(
			server_is_loading(rejected.state)
			and response_id(response) == Some(8.0)
			and response_code(response) == Some(-32600.0)
		),
	)


pure func test_duplicate_initialize_is_rejected_while_loading() -> Bool:
