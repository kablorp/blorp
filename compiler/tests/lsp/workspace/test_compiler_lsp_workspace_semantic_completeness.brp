			WorkspaceCompletenessMissingUriMismatch,
			WorkspaceCompletenessPlannedTargetsMismatch,
			WorkspaceCompletenessRevisionMismatch,
			WorkspaceCompletenessUnknownIndexedTarget,
			WorkspaceCompletenessUnknownMissingTarget,
