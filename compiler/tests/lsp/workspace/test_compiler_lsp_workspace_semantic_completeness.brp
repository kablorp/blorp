import:
	../../../src/stage_01_file_io/source: source_file
	../../../src/stage_04_modules/loaded_module: ANONYMOUS_IDENTITY, module_identity_from_resolved
	../../../src/stage_04_modules/project_source_catalog: ProjectStdProvider(ProjectFilesystemStd)
	../../../src/stage_12_lsp/analysis/analysis_cache: analysis_cache
	../../../src/stage_12_lsp/analysis/analysis_model:
		IndexCoverage(CompleteIndexCoverage, PartialIndexCoverageState),
		ModuleSemanticIndexCoverage(PartialModuleSemanticIndex),
		PartialIndexReason(IndexExtractionFailed, IndexSourceUnavailable),
		SemanticIndexSnapshot,
		empty_module_semantic_index,
		function_global_type_constructor_and_field_module_semantic_index_with_coverage,
	../../../src/stage_12_lsp/analysis/architecture: CompilationWorkspaceSnapshot
	../../../src/stage_12_lsp/analysis/fingerprint_model: semantic_artifact_id_from_value
	../../../src/stage_12_lsp/analysis/workspace_semantic_targets:
		declared_workspace_semantic_targets,
		declared_workspace_semantic_targets_for_sources,
	../../../src/stage_12_lsp/protocol/identity: document_uri
	../../../src/stage_12_lsp/workspace/snapshot_model:
		initial_configuration_epoch,
		initial_workspace_revision,
		next_workspace_revision,
	../../../src/stage_12_lsp/workspace/workspace_model:
