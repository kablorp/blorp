	../../../src/stage_12_lsp/workspace/workspace_store: dependency_store
	test: TestSuite


private pure func exact_outcome_shapes_case() -> Option[Bool]:
	source: DiscoveredSourceSnapshot = {
		uri = document_uri("file:///workspace/main.brp"),
		layer = discovered_source_layer(
			source_file("/workspace/main.brp", "main", "VALUE = 1\n"),
			DiskSource,
		)
	}
	sources ?= source_layers_from_discovered([source]).to_option()
	revision = initial_workspace_revision()
	configuration: WorkspaceConfiguration = {
		workspace_roots = [],
		std_provider = ProjectFilesystemStd("std"),
		source_packages = [],
		native_package_roots = []
	}
	compiler: CompilationWorkspaceSnapshot = {
		revision = revision,
		configuration_epoch = initial_configuration_epoch(),
		configuration = configuration,
		sources = sources,
		dependencies = dependency_store(),
		analysis_cache = analysis_cache()
	}
	targets ?= declared_workspace_semantic_targets_for_sources(revision, sources).to_option()
	target ?= declared_workspace_semantic_targets(targets).get(0)
	identity = module_identity_from_resolved(target.resolved_module_identity)
	artifact_id = semantic_artifact_id_from_value("workspace-completeness-outcomes")
	complete_index ?= empty_module_semantic_index(identity, artifact_id, target.uri).to_option()
	partial_index ?= function_global_type_constructor_and_field_module_semantic_index_with_coverage(
		identity,
		artifact_id,
		target.uri,
		[],
		[],
		PartialModuleSemanticIndex,
	).to_option()
	partial_marker = {
		uri = target.uri,
		module_identity = identity,
		reason = IndexExtractionFailed
	}
	missing_marker = { partial_marker | reason = IndexSourceUnavailable }
	snapshots: List[SemanticIndexSnapshot] = [
		{
			workspace_revision = revision,
			modules = [complete_index],
			coverage = CompleteIndexCoverage
		},
		{
			workspace_revision = revision,
			modules = [partial_index],
			coverage = PartialIndexCoverageState({missing_modules = [partial_marker]})
		},
		{
			workspace_revision = revision,
			modules = [],
			coverage = PartialIndexCoverageState({missing_modules = [missing_marker]})
		},
	]
	Some(
		snapshots.all(func(index):
			workspace_snapshot_semantic_completeness(compiler, targets, index).is_ok()
		),
	)


pure func test_proof_accepts_exact_complete_partial_and_missing_outcomes() -> Bool:
	exact_outcome_shapes_case().get_or(False)


private pure func proof_rejects_snapshot_and_outcome_mismatches_case() -> Option[Bool]:
	source: DiscoveredSourceSnapshot = {
		uri = document_uri("file:///workspace/main.brp"),
		layer = discovered_source_layer(
			source_file("/workspace/main.brp", "main", "VALUE = 1\n"),
			DiskSource,
		)
	}
	sources ?= source_layers_from_discovered([source]).to_option()
	empty_sources ?= source_layers_from_discovered([]).to_option()
	revision = initial_workspace_revision()
	configuration: WorkspaceConfiguration = {
		workspace_roots = [],
		std_provider = ProjectFilesystemStd("std"),
		source_packages = [],
		native_package_roots = []
	}
	compiler: CompilationWorkspaceSnapshot = {
		revision = revision,
		configuration_epoch = initial_configuration_epoch(),
		configuration = configuration,
		sources = sources,
		dependencies = dependency_store(),
		analysis_cache = analysis_cache()
	}
	targets ?= declared_workspace_semantic_targets_for_sources(revision, sources).to_option()
	wrong_targets ?= declared_workspace_semantic_targets_for_sources(
		revision,
		empty_sources,
	).to_option()
	target ?= declared_workspace_semantic_targets(targets).get(0)
	identity = module_identity_from_resolved(target.resolved_module_identity)
	artifact_id = semantic_artifact_id_from_value("workspace-completeness-rejections")
	complete_index ?= empty_module_semantic_index(identity, artifact_id, target.uri).to_option()
	other_uri = document_uri("file:///workspace/other.brp")
	wrong_uri_index ?= empty_module_semantic_index(identity, artifact_id, other_uri).to_option()
	unknown_index ?= empty_module_semantic_index(
		ANONYMOUS_IDENTITY,
		artifact_id,
		other_uri,
	).to_option()
	missing = {
		uri = target.uri,
		module_identity = identity,
		reason = IndexSourceUnavailable
	}
	wrong_uri_missing = { missing | uri = other_uri }
	unknown_missing = { missing |
		uri = other_uri,
		module_identity = ANONYMOUS_IDENTITY
	}
	complete_snapshot: SemanticIndexSnapshot = {
		workspace_revision = revision,
		modules = [complete_index],
		coverage = CompleteIndexCoverage
	}

	revision_rejected = match workspace_snapshot_semantic_completeness(
		compiler,
		targets,
		{ complete_snapshot | workspace_revision = next_workspace_revision(revision) },
	):
		Err(WorkspaceCompletenessRevisionMismatch(_, _)):
			True
		_:
			False

	planned_rejected = match workspace_snapshot_semantic_completeness(
		compiler,
		wrong_targets,
		complete_snapshot,
	):
		Err(WorkspaceCompletenessPlannedTargetsMismatch):
			True
		_:
			False

	duplicate_index_rejected = match (
		workspace_snapshot_semantic_completeness(
			compiler,
			targets,
			{ complete_snapshot | modules = [complete_index, complete_index] },
		)
	):
		Err(WorkspaceCompletenessDuplicateIndexedTarget(_)):
			True
		_:
			False

	duplicate_missing_rejected = match (
		workspace_snapshot_semantic_completeness(
			compiler,
			targets,
			{
				workspace_revision = revision,
				modules = [],
				coverage = PartialIndexCoverageState(
					{missing_modules = [missing, missing]},
				)
			},
		)
	):
		Err(WorkspaceCompletenessDuplicateMissingTarget(_)):
			True
		_:
			False

	unknown_index_rejected = match workspace_snapshot_semantic_completeness(
		compiler,
		targets,
		{ complete_snapshot | modules = [unknown_index] },
	):
		Err(WorkspaceCompletenessUnknownIndexedTarget(_)):
			True
		_:
			False

	unknown_missing_rejected = match (
		workspace_snapshot_semantic_completeness(
			compiler,
			targets,
			{
				workspace_revision = revision,
				modules = [complete_index],
				coverage = PartialIndexCoverageState({missing_modules = [unknown_missing]})
			},
		)
	):
		Err(WorkspaceCompletenessUnknownMissingTarget(_)):
			True
		_:
			False

	indexed_uri_rejected = match workspace_snapshot_semantic_completeness(
		compiler,
		targets,
		{ complete_snapshot | modules = [wrong_uri_index] },
	):
		Err(WorkspaceCompletenessIndexedUriMismatch(_, _)):
			True
		_:
			False

	missing_uri_rejected = match (
		workspace_snapshot_semantic_completeness(
			compiler,
			targets,
			{
				workspace_revision = revision,
				modules = [],
				coverage = PartialIndexCoverageState({missing_modules = [wrong_uri_missing]})
			},
		)
	):
		Err(WorkspaceCompletenessMissingUriMismatch(_, _)):
			True
		_:
			False

	Some(
		(
			revision_rejected
			and planned_rejected
			and duplicate_index_rejected
			and duplicate_missing_rejected
			and unknown_index_rejected
			and unknown_missing_rejected
			and indexed_uri_rejected
			and missing_uri_rejected
		),
	)


pure func test_proof_rejects_snapshot_and_outcome_mismatches() -> Bool:
	proof_rejects_snapshot_and_outcome_mismatches_case().get_or(False)


tests: TestSuite = {
	description = "LSP workspace semantic completeness proof",
	tests = [
		(
			"proof accepts exact complete, partial, and missing outcomes",
			test_proof_accepts_exact_complete_partial_and_missing_outcomes,
		),
		(
			"proof rejects snapshot and outcome mismatches",
			test_proof_rejects_snapshot_and_outcome_mismatches,
		),
	]
}
