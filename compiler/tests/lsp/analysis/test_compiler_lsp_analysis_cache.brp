	../../../src/stage_12_lsp/workspace/workspace_source: discovered_source_layer, source_layers
	test: TestSuite


private SOURCE_URI: String = "file:///workspace/main.brp"


private pure func uri() -> DocumentUri:
	document_uri(SOURCE_URI)


private pure func selected_source(source: String) -> Option[SourceSnapshot]:
	input = source_file("/workspace/main.brp", "main", source)
	layers = source_layers(uri(), Some(discovered_source_layer(input, DiskSource)), None)
	source_snapshot_for_layers(layers)


private pure func module_identity(path: String) -> ModuleIdentity:
	program = parse_compiler_source(source_file(path, "shared", "VALUE = 1\n"))
	module_identity_for_program(program)


private pure func module_fingerprint(
	identity: ModuleIdentity,
	epoch: Int,
) -> Option[ModuleAnalysisFingerprint]:
	module_fingerprint_with_source(identity, epoch, "VALUE = 1\n")


private pure func module_fingerprint_with_source(
	identity: ModuleIdentity,
	epoch: Int,
	source_text: String,
) -> Option[ModuleAnalysisFingerprint]:
	configuration_epoch ?= configuration_epoch(epoch)

	Some({
		module_identity = identity,
		source = content_fingerprint(source_text),
		configuration_epoch = configuration_epoch,
		frontend = frontend_fingerprint_from_value("frontend-v1"),
	})


private pure func cached_diagnostic() -> Diagnostic:
	{
		range = {
			start = position(1, 2),
			end = position(1, 4)
		},
		severity = ErrorDiagnostic,
		code = Some("cache"),
		message = "retained diagnostic"
	}


private record TypedIndexFixture {
	artifact_id: SemanticArtifactId,
	uri: DocumentUri,
	fingerprint: ModuleAnalysisFingerprint,
	graph: TypecheckedGraph,
	index: ModuleSemanticIndex
}


private pure func typed_index_fixture(
	epoch: Int,
	claimed_source: String,
	graph_context: String,
) -> Option[TypedIndexFixture]:
	configuration_epoch ?= configuration_epoch(epoch)
	path: String = "/workspace/main.brp"
	module_name: String = "main"
	text: String = "VALUE = 1\n"
	target: TypecheckImportModule = {
		path = path,
		module_name = module_name,
		module_path = module_name,
		text = text,
		typecheck_program = None,
		origin = UserModule
	}
	request: TypecheckGraphRequest = {
		target = target,
		modules = [],
		module_targets = [],
		resolved_imports = [],
		include_comments = False,
		allow_debug_only_calls = False
	}
	graph = { typecheck_graph(request) | analysis_context = Some(graph_context) }
	identity = graph.target.module_identity
	fingerprint ?= module_fingerprint_with_source(identity, epoch, claimed_source)
	artifact_id = semantic_artifact_id_from_value("main-artifact")

	match empty_module_semantic_index(identity, artifact_id, uri()):
		Err(_):
			None
		Ok(index):
			Some({
				artifact_id = artifact_id,
				uri = uri(),
				fingerprint = fingerprint,
				graph = graph,
				index = index,
			})


private pure func typed_index_with_context(
	epoch: Int,
	claimed_source: String,
	graph_context: String,
) -> Option[ModuleSemanticIndex]:
	fixture ?= typed_index_fixture(epoch, claimed_source, graph_context)
	typed_index_from_compiler(
		fixture.artifact_id,
		fixture.uri,
		fixture.fingerprint,
		fixture.graph,
		fixture.index,
	)


private pure func typed_index_with_claimed_source(
	epoch: Int,
	claimed_source: String,
) -> Option[ModuleSemanticIndex]:
	configuration_epoch ?= configuration_epoch(epoch)
	typed_index_with_context(
		epoch,
		claimed_source,
		typecheck_graph_analysis_context(
			frontend_fingerprint_from_value("frontend-v1"),
			configuration_epoch,
		),
	)


pure func test_source_snapshot_requires_exact_parsed_program_source() -> Bool:
	match selected_source("VALUE = 1\n"):
		None:
			False
		Some(source):
			exact = parse_compiler_source(source_file("/workspace/main.brp", "main", "VALUE = 1\n"))
			wrong_text = parse_compiler_source(
				source_file(
					"/workspace/main.brp",
					"main",
					"VALUE = 2\n",
				),
			)
			wrong_path = parse_compiler_source(
				source_file(
					"/workspace/other.brp",
					"main",
					"VALUE = 1\n",
				),
			)
			wrong_module = parse_compiler_source(
				source_file(
					"/workspace/main.brp",
					"other",
					"VALUE = 1\n",
				),
			)

			(
				source_snapshot_matches_parsed_program(source, exact)
				and not source_snapshot_matches_parsed_program(source, wrong_text)
				and not source_snapshot_matches_parsed_program(source, wrong_path)
				and not source_snapshot_matches_parsed_program(source, wrong_module)
			)


pure func test_typed_fingerprint_uses_exact_identity_source_and_epoch() -> Bool:
	target = module_identity("/workspace/main.brp")
	other = module_identity("/workspace/other.brp")

	match (
		module_fingerprint(target, 1),
		module_fingerprint(other, 1),
		module_fingerprint_with_source(target, 1, "VALUE = 2\n"),
		module_fingerprint(target, 2),
	):
		(Some(exact), Some(other_identity), Some(other_source), Some(new_epoch)):
			(
				module_analysis_fingerprints_equal(exact, exact)
				and not module_analysis_fingerprints_equal(exact, other_identity)
				and not module_analysis_fingerprints_equal(exact, other_source)
				and not module_analysis_fingerprints_equal(exact, new_epoch)
			)
		_:
			False


private pure func diagnostic_cache_requires_exact_fingerprint_case() -> Option[Bool]:
	target = module_identity("/workspace/main.brp")
	exact ?= module_fingerprint(target, 1)
	new_epoch ?= module_fingerprint(exact.module_identity, 2)
	diagnostic = cached_diagnostic()
	cache = analysis_cache_store_diagnostics(analysis_cache(), exact, [diagnostic])
	retained ?= analysis_cache_diagnostics(cache, exact)
	retained_diagnostic ?= retained.get(0)
	removed = analysis_cache_remove_diagnostics(cache, exact)

	Some(
		(
			retained.length() == 1
			and retained_diagnostic.message == diagnostic.message
			and analysis_cache_diagnostics(cache, new_epoch).is_none()
			and analysis_cache_diagnostics(removed, exact).is_none()
		),
	)


pure func test_diagnostic_cache_requires_exact_fingerprint_and_supports_removal() -> Bool:
	diagnostic_cache_requires_exact_fingerprint_case().get_or(False)


pure func test_typed_cache_rejects_stale_lookup_and_removal() -> Bool:
	target = module_identity("/workspace/main.brp")

	match (module_fingerprint(target, 1), module_fingerprint(target, 2)):
		(Some(first), Some(second)):
			cache = analysis_cache_store_typed(analysis_cache(), second)
			stale_removal = analysis_cache_remove_typed(cache, first)
			exact_removal = analysis_cache_remove_typed(stale_removal, second)

			(
				not analysis_cache_has_typed(cache, first)
				and analysis_cache_has_typed(cache, second)
				and analysis_cache_has_typed(stale_removal, second)
				and not analysis_cache_has_typed(exact_removal, second)
			)
		_:
			False


pure func test_typed_cache_can_evict_stale_artifact_by_module_identity() -> Bool:
	target = module_identity("/workspace/main.brp")

	match module_fingerprint(target, 1):
		None:
			False
		Some(fingerprint):
			cache = analysis_cache_store_typed(analysis_cache(), fingerprint)
			evicted = analysis_cache_remove_typed_for_module(cache, fingerprint.module_identity)

			(
				analysis_cache_has_typed(cache, fingerprint)
				and not analysis_cache_has_typed(evicted, fingerprint)
			)


pure func test_typed_index_rejects_mismatched_source_claim() -> Bool:
	typed_index_with_claimed_source(1, "VALUE = 2\n").is_none()


pure func test_typed_index_rejects_untrusted_compiler_context() -> Bool:
	typed_index_with_context(1, "VALUE = 1\n", "wrong-context").is_none()


private pure func valid_typed_index_fixture() -> Option[TypedIndexFixture]:
	configuration_epoch ?= configuration_epoch(1)
	typed_index_fixture(
		1,
		"VALUE = 1\n",
		typecheck_graph_analysis_context(
			frontend_fingerprint_from_value("frontend-v1"),
			configuration_epoch,
		),
	)


pure func test_typed_index_rejects_mismatched_artifact_id() -> Bool:
	match valid_typed_index_fixture():
		None:
			False
		Some(fixture):
			typed_index_from_compiler(
				semantic_artifact_id_from_value("other-artifact"),
				fixture.uri,
				fixture.fingerprint,
				fixture.graph,
				fixture.index,
			).is_none()


pure func test_typed_index_rejects_mismatched_uri() -> Bool:
	match valid_typed_index_fixture():
		None:
			False
		Some(fixture):
			typed_index_from_compiler(
				fixture.artifact_id,
				document_uri("file:///workspace/other.brp"),
				fixture.fingerprint,
				fixture.graph,
				fixture.index,
			).is_none()


pure func test_typed_index_rejects_mismatched_module_identity() -> Bool:
	match valid_typed_index_fixture():
		None:
			False
		Some(fixture):
			other_fingerprint: ModuleAnalysisFingerprint = { fixture.fingerprint |
				module_identity = module_identity("/workspace/other.brp")
			}
			typed_index_from_compiler(
				fixture.artifact_id,
				fixture.uri,
				other_fingerprint,
				fixture.graph,
				fixture.index,
			).is_none()


tests: TestSuite = {
	description = "Compiler LSP analysis cache",
	tests = [
		(
			"source snapshot requires exact parsed program source",
			test_source_snapshot_requires_exact_parsed_program_source,
		),
		(
			"typed fingerprint uses exact identity source and epoch",
			test_typed_fingerprint_uses_exact_identity_source_and_epoch,
		),
		(
			"diagnostic cache requires exact fingerprint and supports removal",
			test_diagnostic_cache_requires_exact_fingerprint_and_supports_removal,
		),
		(
			"typed cache rejects stale lookup and removal",
			test_typed_cache_rejects_stale_lookup_and_removal,
		),
		(
			"typed index rejects mismatched source claim",
			test_typed_index_rejects_mismatched_source_claim,
		),
		(
			"typed index rejects untrusted compiler context",
			test_typed_index_rejects_untrusted_compiler_context,
		),
		(
			"typed index rejects mismatched artifact identity",
			test_typed_index_rejects_mismatched_artifact_id,
		),
		("typed index rejects mismatched URI", test_typed_index_rejects_mismatched_uri),
		(
			"typed index rejects mismatched module identity",
			test_typed_index_rejects_mismatched_module_identity,
		),
		(
			"typed cache can evict stale artifact by module identity",
			test_typed_cache_can_evict_stale_artifact_by_module_identity,
		),
	]
}
