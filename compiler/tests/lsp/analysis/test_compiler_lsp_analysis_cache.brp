		typecheck_graph,
	../../../src/stage_12_lsp/analysis/analysis_cache:
		analysis_cache,
		analysis_cache_diagnostics,
		analysis_cache_has_typed,
		analysis_cache_remove_diagnostics,
		analysis_cache_remove_typed,
		analysis_cache_remove_typed_for_module,
		analysis_cache_store_diagnostics,
		analysis_cache_store_typed,
		module_analysis_fingerprints_equal,
	../../../src/stage_12_lsp/analysis/analysis_model:
		ModuleAnalysisFingerprint,
		ModuleSemanticIndex,
