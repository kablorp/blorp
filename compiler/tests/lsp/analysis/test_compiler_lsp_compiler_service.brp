private pure func configuration() -> WorkspaceConfiguration:
	{
		workspace_roots = [
			{
				client_uri = document_uri("file:///workspace"),
				client_path = "/workspace",
				canonical_path = "/workspace"
			},
		],
		std_provider = ProjectFilesystemStd("std"),
		source_packages = [],
		native_package_roots = []
	}


private pure func discovered(module_name: String, text: String) -> DiscoveredSourceSnapshot:
	{
		uri = document_uri("file:///workspace/" + module_name + ".brp"),
		layer = discovered_source_layer(
			source_file("/workspace/" + module_name + ".brp", module_name, text),
			DiskSource,
		)
	}


private pure func cached_diagnostic() -> Diagnostic:
	{
		range = {
			start = position(0, 0),
			end = position(0, 1)
		},
		severity = ErrorDiagnostic,
		code = Some("cached"),
		message = "cached diagnostic"
	}


private pure func analysis_request_for_sources(
	sources: List[DiscoveredSourceSnapshot],
) -> Option[AnalysisRequest]:
	workspace_request ?= workspace_and_analysis_request(sources, sources)
	Some(workspace_request[1])


private pure func workspace_and_analysis_request(
	sources: List[DiscoveredSourceSnapshot],
	opened_sources: List[DiscoveredSourceSnapshot],
) -> Option[(Workspace, AnalysisRequest)]:
	workspace ?= workspace(configuration(), sources).to_option()
	opened ?= open_sources_for_analysis(workspace, opened_sources, 1)
	plan ?= plan_analysis(opened[1]).to_option()
	Some(
		(opened[0], {
				plan = plan,
				cancellation_token = cancellation_token(1)
			}),
	)


private pure func open_sources_for_analysis(
	workspace: Workspace,
	sources: List[DiscoveredSourceSnapshot],
	version_value: Int,
) -> Option[(Workspace, WorkspaceTransition)]:
	match sources:
		[]:
			None
		[source, ...remaining]:
			version ?= document_version(version_value)
			applied ?= apply_workspace_event(
				workspace,
				ResolvedDocumentOpened({
					document = {
						document = {
							uri = source.uri,
							version = version,
							text = source.layer.source.text
						},
						language_id = "blorp"
					},
					source = source.layer.source,
					provenance = source.layer.provenance,
				}),
			).to_option()

			match remaining:
				[]:
					Some(applied)
				_:
					open_sources_for_analysis(applied[0], remaining, version_value + 1)


private pure func analysis_request() -> Option[AnalysisRequest]:
	analysis_request_for_sources([
		discovered(
			"main",
			"import:\n\tlib: answer\n\nfunc main(args: List[String]):\n\tprint(answer().to_string())\n",
		),
		discovered("lib", "pure func answer() -> Int:\n\t42\n"),
	])


private pure func imported_global_analysis_request() -> Option[AnalysisRequest]:
	analysis_request_for_sources([
		discovered(
			"main",
			"import:\n\tlib: ANSWER\n\nfunc main(args: List[String]):\n\tprint(ANSWER.to_string())\n",
		),
		discovered("qualified", "import:\n\tlib as L\n\nfunc read() -> Int:\n\tL.ANSWER\n"),
		discovered("lib", "ANSWER: Int = 42\n"),
	])


private pure func imported_constructor_analysis_request() -> Option[AnalysisRequest]:
	analysis_request_for_sources([
		discovered(
			"main",
			"import:\n\tlib: Choice(Some, None)\n\npure func make(value: Int) -> Choice:\n\tSome(value)\n\npure func empty() -> Choice:\n\tNone\n\npure func read(choice: Choice) -> Int:\n\tmatch choice:\n\t\tSome(value): value\n\t\tNone: 0\n",
		),
		discovered(
			"qualified",
			"import:\n\tlib as L\n\npure func make(value: Int) -> L.Choice:\n\tL.Some(value)\n\npure func empty() -> L.Choice:\n\tL.None\n\npure func read(choice: L.Choice) -> Int:\n\tmatch choice:\n\t\tL.Some(value): value\n\t\tL.None: 0\n",
		),
		discovered("lib", "union Choice:\n\tNone\n\tSome(Int)\n"),
	])


private pure func imported_type_analysis_request() -> Option[AnalysisRequest]:
	analysis_request_for_sources([
		discovered(
			"main",
			"import:\n\tlib: Box as LocalBox\n\npure func identity(value: LocalBox) -> LocalBox:\n\tvalue\n",
		),
		discovered(
			"qualified",
			"import:\n\tlib as L\n\npure func identity(value: L.Box) -> L.Box:\n\tvalue\n",
		),
		discovered("lib", "record Box {value: Int}\n"),
	])


private pure func imported_field_analysis_request() -> Option[AnalysisRequest]:
	analysis_request_for_sources([
		discovered(
			"main",
			"import:\n\tlib: Box\n\npure func make() -> Box:\n\t{value = 1}\n\npure func read(box: Box) -> Int:\n\tbox.value\n",
		),
		discovered(
			"qualified",
			"import:\n\tlib as L\n\npure func make() -> L.Box:\n\t{value = 1}\n\npure func read(box: L.Box) -> Int:\n\tbox.value\n",
		),
		discovered(
			"other_user",
			"import:\n\tother as O\n\npure func make() -> O.Box:\n\t{value = \"other\"}\n\npure func read(box: O.Box) -> String:\n\tbox.value\n",
		),
		discovered("lib", "record Box {value: Int}\n"),
		discovered("other", "record Box {value: String}\n"),
	])


private pure func same_named_constructor_analysis_request() -> Option[AnalysisRequest]:
	analysis_request_for_sources([
		discovered("left", "union LeftChoice:\n\tNone\n\tSome(Int)\n"),
		discovered("right", "union RightChoice:\n\tNone\n\tSome(Int)\n"),
	])


private pure func exported_symbol_name(symbol: SemanticSymbolId) -> Option[String]:
	match symbol:
		ExportedSemanticSymbol(exported):
			exported_id: ExportedSymbolId = exported
			Some(exported_symbol_key_name(exported_id.key))
		_:
			None


private pure func successful_target_for_uri(
	outcomes: List[TargetAnalysisOutcome],
	uri: DocumentUri,
) -> Option[SuccessfulAnalysisTarget]:
	matches = outcomes.filter_map(func(outcome):
		match outcome:
			TargetAnalysisSucceeded(success):
				if success.target.identity.uri == uri:
					Some(success)
				else:
					None
			_:
				None
	)
	matches.get(0)


private pure func failed_target_for_uri(
	outcomes: List[TargetAnalysisOutcome],
	uri: DocumentUri,
) -> Option[FailedAnalysisTarget]:
	matches = outcomes.filter_map(func(outcome):
		match outcome:
			TargetAnalysisFailed(failure):
				if failure.target.identity.uri == uri:
					Some(failure)
				else:
					None
			_:
				None
	)
	matches.get(0)


private func analysis_typechecks_one_graph_and_builds_indexes() -> Option[Bool]:
	request ?= analysis_request()
	result ?= run_compiler_analysis(request).to_option()
	main ?= successful_target_for_uri(result.outcomes, document_uri("file:///workspace/main.brp"))
	lib ?= successful_target_for_uri(result.outcomes, document_uri("file:///workspace/lib.brp"))
	main_index = main.index
	lib_index = lib.index

	Some(
		(
			result.outcomes.length() == 2
			and main.diagnostics.all(func(publication): publication.diagnostics.is_empty())
			and lib.diagnostics.all(func(publication): publication.diagnostics.is_empty())
			and module_semantic_index_definitions(main_index).length() == 1
			and module_semantic_index_references(main_index).length() == 2
			and module_semantic_index_definitions(lib_index).length() == 1
			and module_semantic_index_references(lib_index).length() == 1
		),
	)


func test_analysis_typechecks_one_graph_and_builds_indexes() -> Bool:
	analysis_typechecks_one_graph_and_builds_indexes().get_or(False)


private func imported_global_uses_provider_identity() -> Option[Bool]:
	request ?= imported_global_analysis_request()
	result ?= run_compiler_analysis(request).to_option()
	main ?= successful_target_for_uri(result.outcomes, document_uri("file:///workspace/main.brp"))
	lib ?= successful_target_for_uri(result.outcomes, document_uri("file:///workspace/lib.brp"))
	qualified ?= successful_target_for_uri(
		result.outcomes,
		document_uri("file:///workspace/qualified.brp"),
	)
	main_index = main.index
	lib_index = lib.index
	qualified_index = qualified.index
	provider_definition ?= module_semantic_index_definitions(lib_index).get(0)
	bare_reference ?= module_semantic_index_references(main_index).find(func(reference):
		(
			not reference.is_declaration
			and semantic_symbol_ids_equal(reference.symbol, provider_definition.symbol)
		)
	)
	qualified_reference ?= module_semantic_index_references(qualified_index).find(func(reference):
		(
			not reference.is_declaration
			and semantic_symbol_ids_equal(reference.symbol, provider_definition.symbol)
		)
	)
	main_reference ?= module_semantic_index_references(main_index).find(func(reference):
		(
			not reference.is_declaration
			and semantic_symbol_ids_equal(reference.symbol, provider_definition.symbol)
		)
	)
	query_snapshot: SemanticIndexSnapshot = {
		workspace_revision = main.target.identity.workspace_revision,
		modules = [main_index, lib_index, qualified_index],
		coverage = CompleteIndexCoverage
	}

	definition_locations = definition_query_snapshot(
		CurrentSemanticIndex(query_snapshot),
		main.target.identity.uri,
		main_reference.location.range.start,
	)

	query_reference_locations = references_query_snapshot(
		CurrentSemanticIndex(query_snapshot),
		main.target.identity.uri,
		main_reference.location.range.start,
		True,
	)

	definition_entry ?= match definition_locations:
		Some(locations):
			locations.get(0)
		None:
			None

	reference_locations ?= query_reference_locations
	Some(
		(
			bare_reference.location.range.start.utf16_character == 7
			and qualified_reference.location.range.start.utf16_character == 3
			and definition_entry.uri == document_uri("file:///workspace/lib.brp")
			and reference_locations.length() == 3
			and reference_locations.any(func(location):
				location.uri == document_uri("file:///workspace/main.brp")
			)
			and reference_locations.any(func(location):
				location.uri == document_uri("file:///workspace/lib.brp")
			)
			and reference_locations.any(func(location):
				location.uri == document_uri("file:///workspace/qualified.brp")
			)
		),
	)


func test_imported_global_uses_provider_identity() -> Bool:
	imported_global_uses_provider_identity().get_or(False)


private func imported_constructor_uses_provider_identity() -> Option[Bool]:
	request ?= imported_constructor_analysis_request()
	result ?= run_compiler_analysis(request).to_option()
	main ?= successful_target_for_uri(result.outcomes, document_uri("file:///workspace/main.brp"))
	lib ?= successful_target_for_uri(result.outcomes, document_uri("file:///workspace/lib.brp"))
	qualified ?= successful_target_for_uri(
		result.outcomes,
		document_uri("file:///workspace/qualified.brp"),
	)
	main_index = main.index
	lib_index = lib.index
	qualified_index = qualified.index
	provider_some ?= module_semantic_index_definitions(lib_index).find(func(definition):
		exported_symbol_name(definition.symbol) == Some("Some")
	)
	provider_none ?= module_semantic_index_definitions(lib_index).find(func(definition):
		exported_symbol_name(definition.symbol) == Some("None")
	)
	bare_references = module_semantic_index_references(main_index)
	qualified_references = module_semantic_index_references(qualified_index)
	bare_some = bare_references.filter(func(reference):
		semantic_symbol_ids_equal(reference.symbol, provider_some.symbol)
	)
	bare_none = bare_references.filter(func(reference):
		semantic_symbol_ids_equal(reference.symbol, provider_none.symbol)
	)
	qualified_some = qualified_references.filter(func(reference):
		semantic_symbol_ids_equal(reference.symbol, provider_some.symbol)
	)
	qualified_none = qualified_references.filter(func(reference):
		semantic_symbol_ids_equal(reference.symbol, provider_none.symbol)
	)

	Some(
		(
			bare_some.length() == 2
			and bare_none.length() == 2
			and qualified_some.length() == 2
			and qualified_none.length() == 2
			and bare_some.any(func(reference): reference.location.range.start.line == 4)
			and bare_some.any(func(reference): reference.location.range.start.line == 11)
			and bare_none.any(func(reference): reference.location.range.start.line == 7)
			and bare_none.any(func(reference): reference.location.range.start.line == 12)
			and qualified_some.any(func(reference):
				(
					reference.location.range.start.line == 4
					and reference.location.range.start.utf16_character == 3
				)
			)
			and qualified_some.any(func(reference):
				(
					reference.location.range.start.line == 11
					and reference.location.range.start.utf16_character == 4
				)
			)
			and qualified_none.any(func(reference):
				(
					reference.location.range.start.line == 7
					and reference.location.range.start.utf16_character == 3
				)
			)
			and qualified_none.any(func(reference):
				(
					reference.location.range.start.line == 12
					and reference.location.range.start.utf16_character == 4
				)
			)
		),
	)


func test_imported_constructor_uses_provider_identity() -> Bool:
	imported_constructor_uses_provider_identity().get_or(False)


private func imported_type_uses_provider_identity() -> Option[Bool]:
	request ?= imported_type_analysis_request()
	result ?= run_compiler_analysis(request).to_option()
	main ?= successful_target_for_uri(result.outcomes, document_uri("file:///workspace/main.brp"))
	lib ?= successful_target_for_uri(result.outcomes, document_uri("file:///workspace/lib.brp"))
	qualified ?= successful_target_for_uri(
		result.outcomes,
		document_uri("file:///workspace/qualified.brp"),
	)
	main_index = main.index
	lib_index = lib.index
	qualified_index = qualified.index
	provider_box ?= module_semantic_index_definitions(lib_index).find(func(definition):
		exported_symbol_name(definition.symbol) == Some("Box")
	)
	bare_references = module_semantic_index_references(main_index).filter(func(reference):
		semantic_symbol_ids_equal(reference.symbol, provider_box.symbol)
	)
	qualified_references = module_semantic_index_references(
		qualified_index,
	).filter(
		func(reference): semantic_symbol_ids_equal(reference.symbol, provider_box.symbol),
	)

	Some(
		(
			bare_references.length() == 2
			and qualified_references.length() == 2
			and bare_references.all(func(reference): reference.location.range.start.line == 3)
			and qualified_references.all(func(reference): reference.location.range.start.line == 3)
			and qualified_references.any(func(reference):
				reference.location.range.start.utf16_character == 28
			)
			and qualified_references.any(func(reference):
				reference.location.range.start.utf16_character == 38
			)
		),
	)


func test_imported_type_uses_provider_identity() -> Bool:
	imported_type_uses_provider_identity().get_or(False)


private func imported_field_uses_provider_identity() -> Option[Bool]:
	request ?= imported_field_analysis_request()
	result ?= run_compiler_analysis(request).to_option()
	main ?= successful_target_for_uri(result.outcomes, document_uri("file:///workspace/main.brp"))
	lib ?= successful_target_for_uri(result.outcomes, document_uri("file:///workspace/lib.brp"))
	qualified ?= successful_target_for_uri(
		result.outcomes,
		document_uri("file:///workspace/qualified.brp"),
	)
	other_user ?= successful_target_for_uri(
		result.outcomes,
		document_uri("file:///workspace/other_user.brp"),
	)
	other ?= successful_target_for_uri(result.outcomes, document_uri("file:///workspace/other.brp"))
	main_index = main.index
	lib_index = lib.index
	qualified_index = qualified.index
	other_user_index = other_user.index
	other_index = other.index
	provider_field ?= module_semantic_index_definitions(lib_index).find(func(definition):
		exported_symbol_name(definition.symbol) == Some("value")
	)
	other_provider_field ?= module_semantic_index_definitions(other_index).find(func(definition):
		exported_symbol_name(definition.symbol) == Some("value")
	)
	bare_references = module_semantic_index_references(main_index).filter(func(reference):
		semantic_symbol_ids_equal(reference.symbol, provider_field.symbol)
	)
	qualified_references = module_semantic_index_references(
		qualified_index,
	).filter(
		func(reference): semantic_symbol_ids_equal(reference.symbol, provider_field.symbol),
	)
	other_references = module_semantic_index_references(other_user_index).filter(func(reference):
		semantic_symbol_ids_equal(reference.symbol, other_provider_field.symbol)
	)

	Some(
		(
			not semantic_symbol_ids_equal(provider_field.symbol, other_provider_field.symbol)
			and other_references.length() == 2
			and bare_references.length() == 2
			and qualified_references.length() == 2
			and bare_references.any(func(reference): reference.location.range.start.line == 4)
			and bare_references.any(func(reference): reference.location.range.start.line == 7)
			and qualified_references.any(func(reference): reference.location.range.start.line == 4)
			and qualified_references.any(func(reference): reference.location.range.start.line == 7)
		),
	)


func test_imported_field_uses_provider_identity() -> Bool:
	imported_field_uses_provider_identity().get_or(False)


private func same_named_constructors_keep_module_identity() -> Option[Bool]:
	request ?= same_named_constructor_analysis_request()
	result ?= run_compiler_analysis(request).to_option()
	left ?= successful_target_for_uri(result.outcomes, document_uri("file:///workspace/left.brp"))
	right ?= successful_target_for_uri(result.outcomes, document_uri("file:///workspace/right.brp"))
	left_some ?= module_semantic_index_definitions(
		left.index,
	).find(
		func(definition): exported_symbol_name(definition.symbol) == Some("Some"),
	)
	right_some ?= module_semantic_index_definitions(
		right.index,
	).find(
		func(definition): exported_symbol_name(definition.symbol) == Some("Some"),
	)

	Some(not semantic_symbol_ids_equal(left_some.symbol, right_some.symbol))


func test_same_named_constructors_keep_module_identity() -> Bool:
	same_named_constructors_keep_module_identity().get_or(False)


private func mixed_success_and_parse_failure() -> Option[Bool]:
	request ?= analysis_request_for_sources([
		discovered("valid", "pure func answer() -> Int:\n\t42\n"),
		discovered("broken", "pure func broken( -> Int:\n\t42\n"),
	])
	result ?= run_compiler_analysis(request).to_option()
	valid ?= successful_target_for_uri(result.outcomes, document_uri("file:///workspace/valid.brp"))
	broken ?= failed_target_for_uri(result.outcomes, document_uri("file:///workspace/broken.brp"))
	valid_index = valid.index
	parse_publication ?= broken.diagnostics.get(0)
	parse_diagnostic ?= parse_publication.diagnostics.get(0)

	failure_is_parse = match broken.failure:
		TargetParseFailed:
			True
		_:
			False

	Some(
		(
			module_semantic_index_definitions(valid_index).length() == 1
			and failure_is_parse
			and parse_publication.identity == broken.target.identity
			and parse_diagnostic.severity == ErrorDiagnostic
			and parse_diagnostic.code.is_none()
			and not parse_diagnostic.message.is_empty()
		),
	)


func test_failed_root_does_not_suppress_successful_index() -> Bool:
	mixed_success_and_parse_failure().get_or(False)


private func missing_import_has_exact_source_diagnostic_case() -> Option[Bool]:
	missing_import_message = "module 'missing/module' is not loaded for import registration"
	request ?= analysis_request_for_sources([
		discovered("main", "import:\n\tmissing/module: value\n\nVALUE: Int = value\n"),
		discovered("healthy", "HEALTHY: Int = 1\n"),
	])
	result ?= run_compiler_analysis(request).to_option()
	failed ?= failed_target_for_uri(result.outcomes, document_uri("file:///workspace/main.brp"))
	_healthy ?= successful_target_for_uri(
		result.outcomes,
		document_uri("file:///workspace/healthy.brp"),
	)
	publication ?= failed.diagnostics.find(func(candidate):
		candidate.diagnostics.any(func(diagnostic):
			diagnostic.message == missing_import_message
		)
	)
	diagnostic ?= publication.diagnostics.find(func(candidate):
		candidate.message == missing_import_message
	)

	failure_is_typecheck = match failed.failure:
		TargetTypecheckFailed:
			True
		_:
			False

	Some(
		(
			failure_is_typecheck
			and result.outcomes.length() == 2
			and failed.diagnostics.length() == 1
			and publication.identity == failed.target.identity
			and diagnostic.message == missing_import_message
			and diagnostic.code == Some("typecheck")
			and diagnostic.severity == ErrorDiagnostic
			and diagnostic.range.start.line == 1
			and diagnostic.range.start.utf16_character == 1
			and diagnostic.range.end.line == 1
			and diagnostic.range.end.utf16_character == 15
		),
	)


func test_missing_import_has_exact_source_diagnostic() -> Bool:
	missing_import_has_exact_source_diagnostic_case().get_or(False)


private func scoped_catalog_analysis_commits_case() -> Option[Bool]:
	main = discovered("main", "import:\n\tdep: ANSWER\n\nRESULT: Int = ANSWER\n")
	dependency = discovered("dep", "ANSWER: Int = 42\n")
	var sources: List[DiscoveredSourceSnapshot] = [main, dependency]
	var index: Int = 0

	while index < 98:
		sources = sources.append(
			discovered(
				"unrelated_${index.to_string()}",
				"VALUE: Int = ${index.to_string()}\n",
			),
		)
		index += 1

	workspace_request ?= workspace_and_analysis_request(sources, [main])
	request = workspace_request[1]
	result ?= run_compiler_analysis(request).to_option()
	dependency_names = dependency_store_values(result.dependencies)
		.map(func(state):
			resolved_module_canonical_path(module_dependency_identity(state))
		)
		.sort()
	completion: AnalysisCompletion = {
		scheduled = {
			token = request.cancellation_token,
			plan = request.plan
		},
		result = Ok(result)
	}

	committed: Bool = match apply_analysis_completion(workspace_request[0], completion):
		Ok((_, AnalysisCommitted(_))):
			True
		_:
			False

	Some(result.outcomes.length() == 1 and dependency_names == ["dep", "main"] and committed)


func test_scoped_catalog_analysis_commits() -> Bool:
	scoped_catalog_analysis_commits_case().get_or(False)


private func root_close_refreshes_cached_dependencies_case() -> Option[Bool]:
	main = discovered("main", "MAIN: Int = 1\n")
	other = discovered("other", "OTHER: Int = 2\n")
	initial ?= workspace_and_analysis_request(
		[main, other],
		[main, other],
	)
	initial_request = initial[1]
	initial_result ?= run_compiler_analysis(initial_request).to_option()
	initial_completion: AnalysisCompletion = {
		scheduled = {
			token = initial_request.cancellation_token,
			plan = initial_request.plan
		},
		result = Ok(initial_result)
	}
	committed ?= apply_analysis_completion(initial[0], initial_completion).to_option()
	closed ?= apply_workspace_event(committed[0], WorkspaceDocumentClosed(other.uri)).to_option()
	plan ?= plan_analysis(closed[1]).to_option()
	request: AnalysisRequest = {
		plan = plan,
		cancellation_token = cancellation_token(2)
	}
	result ?= run_compiler_analysis(request).to_option()
	dependency_names = dependency_store_values(result.dependencies)
		.map(func(state):
			resolved_module_canonical_path(module_dependency_identity(state))
		)
		.sort()
	completion: AnalysisCompletion = {
		scheduled = {
			token = request.cancellation_token,
			plan = request.plan
		},
		result = Ok(result)
	}

	refresh_committed: Bool = match apply_analysis_completion(closed[0], completion):
		Ok((_, AnalysisCommitted(_))):
			True
		_:
			False

	Some(
		(
			plan.targets.is_empty()
			and plan.roots.length() == 1
			and result.outcomes.is_empty()
			and dependency_names == ["main"]
			and refresh_committed
		),
	)


func test_root_close_refreshes_cached_dependencies() -> Bool:
	root_close_refreshes_cached_dependencies_case().get_or(False)


private func unchanged_revision_republishes_cached_diagnostics_case() -> Option[Bool]:
	source = discovered("main", "VALUE: Int = 1\n")
	initial ?= workspace_and_analysis_request([source], [source])
	initial_request = initial[1]
	initial_result ?= run_compiler_analysis(initial_request).to_option()
	diagnostic = cached_diagnostic()
	annotated_outcomes = initial_result.outcomes.map(func(outcome):
		match outcome:
			TargetAnalysisSucceeded(success):
				TargetAnalysisSucceeded(
					{ success | diagnostics = [
							{
								identity = success.target.identity,
								diagnostics = [diagnostic]
							},
						] },
				)
			_:
				outcome
	)
	initial_completion: AnalysisCompletion = {
		scheduled = {
			token = initial_request.cancellation_token,
			plan = initial_request.plan
		},
		result = Ok({ initial_result | outcomes = annotated_outcomes })
	}
	committed ?= apply_analysis_completion(initial[0], initial_completion).to_option()
	version ?= document_version(2)
	changed ?= apply_workspace_event(committed[0], WorkspaceDocumentChanged({
			uri = source.uri,
			version = version,
			replacement_text = Some(source.layer.source.text),
		})).to_option()
	plan ?= plan_analysis(changed[1]).to_option()
	request: AnalysisRequest = {
		plan = plan,
		cancellation_token = cancellation_token(2)
	}
	result ?= run_compiler_analysis(request).to_option()
	completion: AnalysisCompletion = {
		scheduled = {
			token = request.cancellation_token,
			plan = request.plan
		},
		result = Ok(result)
	}
	second_commit ?= apply_analysis_completion(changed[0], completion).to_option()

	match second_commit[1]:
		AnalysisCommitted(value):
			publication ?= value.diagnostics.get(0)
			retained_diagnostic ?= publication.diagnostics.get(0)

			version_matches = match publication.identity.document_version:
				Some(published_version):
					document_version_value(published_version) == 2
				None:
					False

			Some(
				(
					plan.targets.is_empty()
					and result.outcomes.is_empty()
					and value.diagnostics.length() == 1
					and publication.identity.uri == source.uri
					and version_matches
					and workspace_revision_value(
						publication.identity.workspace_revision,
					) == workspace_revision_value(plan.workspace_revision)
					and retained_diagnostic.message == diagnostic.message
				),
			)
		_:
			Some(False)


func test_unchanged_revision_republishes_cached_diagnostics() -> Bool:
	unchanged_revision_republishes_cached_diagnostics_case().get_or(False)


tests: TestSuite = {
	description = "Compiler LSP production compiler service",
	tests = [
		(
			"typecheck one graph and build semantic indexes",
			test_analysis_typechecks_one_graph_and_builds_indexes,
		),
		("imported global uses provider identity", test_imported_global_uses_provider_identity),
		(
			"imported constructor uses provider identity",
			test_imported_constructor_uses_provider_identity,
		),
		("imported type uses provider identity", test_imported_type_uses_provider_identity),
		("imported field uses provider identity", test_imported_field_uses_provider_identity),
		(
			"same-named constructors keep module identity",
			test_same_named_constructors_keep_module_identity,
		),
		(
			"failed root does not suppress successful index",
			test_failed_root_does_not_suppress_successful_index,
		),
		(
			"missing import has exact source diagnostic",
			test_missing_import_has_exact_source_diagnostic,
		),
		("scoped catalog analysis commits", test_scoped_catalog_analysis_commits),
		("root close refreshes cached dependencies", test_root_close_refreshes_cached_dependencies),
		(
			"unchanged revision republishes cached diagnostics",
			test_unchanged_revision_republishes_cached_diagnostics,
		),
	]
}
