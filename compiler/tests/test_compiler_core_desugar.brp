import:
	../src/stage_09_core/desugar: desugar_expr, desugar_program
	../src/stage_09_core/ir:
		CoreBinaryOp(AddOp, EqualOp, NotEqualOp),
		CoreCallKind(BuiltinCall),
		CoreDecl(FunctionDecl, GlobalDecl, ImplDecl),
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			CallExpr,
			CastExpr,
			DebugBlockExpr,
			LetExpr,
			LiteralExpr,
			RawMatchExpr,
			ResourceScopeExpr,
			SeqExpr,
			UnaryExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreGlobal,
		CoreLiteral(StringLiteral),
		CorePattern(WildcardPattern),
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
		CoreUnaryOp(NotOp),
		CoreVar,
		core_expr_to_json,
		core_program_to_json,
	test: TestSuite


pure func string_type() -> CoreType:
	NamedType("String", [])


pure func literal_string_type() -> CoreType:
	NamedType("LiteralString", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func named_var_with_uniq(name: String, uniq: Int) -> CoreVar:
	{
		name = name,
		uniq = uniq,
		def_id = None
	}


pure func string_lit(value: String) -> CoreExpr:
	LiteralExpr(StringLiteral(value), string_type(), SyntheticSourceLoc)


pure func literal_string_lit(value: String) -> CoreExpr:
	LiteralExpr(StringLiteral(value), literal_string_type(), SyntheticSourceLoc)


pure func string_var(name: String) -> CoreExpr:
	VarExpr(named_var(name), string_type(), SyntheticSourceLoc)


pure func int_var(name: String) -> CoreExpr:
	VarExpr(named_var(name), int_type(), SyntheticSourceLoc)


pure func core_exprs_equal(left: CoreExpr, right: CoreExpr) -> Bool:
	core_expr_to_json(left).to_string() == core_expr_to_json(right).to_string()


pure func core_programs_equal(left: CoreProgram, right: CoreProgram) -> Bool:
	core_program_to_json(left).to_string() == core_program_to_json(right).to_string()


pure func builtin_call(name: String, args: List[CoreExpr], typ: CoreType) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		VoidExpr(VoidType, SyntheticSourceLoc),
		args,
		typ,
		SyntheticSourceLoc,
	)


func test_desugars_string_add_to_concat_call() -> Bool:
	expr = BinaryExpr(AddOp, string_lit("a"), string_lit("b"), string_type(), SyntheticSourceLoc)
	expected = builtin_call(
		"blorp_string_concat",
		[string_lit("a"), string_lit("b")],
		string_type(),
	)

	core_exprs_equal(desugar_expr(expr), expected)


func test_desugars_string_equal_to_builtin_call() -> Bool:
	expr = BinaryExpr(EqualOp, string_lit("a"), string_lit("b"), bool_type(), SyntheticSourceLoc)
	expected = builtin_call(
		"blorp_string_eq",
		[string_lit("a"), string_lit("b")],
		bool_type(),
	)

	core_exprs_equal(desugar_expr(expr), expected)


func test_desugars_string_not_equal_to_not_builtin_call() -> Bool:
	expr = BinaryExpr(NotEqualOp, string_lit("a"), string_lit("b"), bool_type(), SyntheticSourceLoc)
	expected = UnaryExpr(
		NotOp,
		builtin_call(
			"blorp_string_eq",
			[string_lit("a"), string_lit("b")],
			bool_type(),
		),
		bool_type(),
		SyntheticSourceLoc,
	)

	core_exprs_equal(desugar_expr(expr), expected)


func test_desugars_literal_string_add_to_concat_call() -> Bool:
	expr = BinaryExpr(
		AddOp,
		literal_string_lit("a"),
		string_lit("b"),
		string_type(),
		SyntheticSourceLoc,
	)
	expected = builtin_call(
		"blorp_string_concat",
		[literal_string_lit("a"), string_lit("b")],
		string_type(),
	)

	core_exprs_equal(desugar_expr(expr), expected)


func test_desugars_literal_string_equal_to_builtin_call() -> Bool:
	expr = BinaryExpr(
		EqualOp,
		literal_string_lit("a"),
		string_lit("b"),
		bool_type(),
		SyntheticSourceLoc,
	)
	expected = builtin_call(
		"blorp_string_eq",
		[literal_string_lit("a"), string_lit("b")],
		bool_type(),
	)

	core_exprs_equal(desugar_expr(expr), expected)


func test_leaves_non_string_add_as_binary_expr() -> Bool:
	expr = BinaryExpr(AddOp, int_var("a"), int_var("b"), int_type(), SyntheticSourceLoc)

	core_exprs_equal(desugar_expr(expr), expr)


func test_desugars_nested_string_add_inside_let() -> Bool:
	expr = LetExpr(
		named_var("message"),
		False,
		string_type(),
		BinaryExpr(AddOp, string_lit("a"), string_lit("b"), string_type(), SyntheticSourceLoc),
		string_var("message"),
	)
	expected = LetExpr(
		named_var("message"),
		False,
		string_type(),
		builtin_call(
			"blorp_string_concat",
			[string_lit("a"), string_lit("b")],
			string_type(),
		),
		string_var("message"),
	)

	core_exprs_equal(desugar_expr(expr), expected)


func test_desugars_string_add_inside_debug_block() -> Bool:
	expr = DebugBlockExpr(
		BinaryExpr(AddOp, string_lit("a"), string_lit("b"), string_type(), SyntheticSourceLoc),
		string_type(),
		SyntheticSourceLoc,
	)
	expected = DebugBlockExpr(
		builtin_call(
			"blorp_string_concat",
			[string_lit("a"), string_lit("b")],
			string_type(),
		),
		string_type(),
		SyntheticSourceLoc,
	)

	core_exprs_equal(desugar_expr(expr), expected)


func test_desugars_string_add_inside_cast() -> Bool:
	expr = CastExpr(
		BinaryExpr(AddOp, string_lit("a"), string_lit("b"), string_type(), SyntheticSourceLoc),
		string_type(),
		SyntheticSourceLoc,
	)
	expected = CastExpr(
		builtin_call(
			"blorp_string_concat",
			[string_lit("a"), string_lit("b")],
			string_type(),
		),
		string_type(),
		SyntheticSourceLoc,
