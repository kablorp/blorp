	core_exprs_equal(desugar_expr(expr), expected)


func test_desugars_string_add_inside_raw_match_case() -> Bool:
	expr = RawMatchExpr(
		int_var("value"),
		[
			{
				pattern = WildcardPattern,
				body = BinaryExpr(
					AddOp,
					string_lit("a"),
					string_lit("b"),
					string_type(),
					SyntheticSourceLoc,
				)
			},
		],
		string_type(),
		SyntheticSourceLoc,
	)
	expected = RawMatchExpr(
		int_var("value"),
		[
			{
				pattern = WildcardPattern,
				body = builtin_call(
					"blorp_string_concat",
					[string_lit("a"), string_lit("b")],
					string_type(),
				)
			},
		],
		string_type(),
		SyntheticSourceLoc,
	)

	core_exprs_equal(desugar_expr(expr), expected)


func test_desugars_string_add_inside_resource_scope() -> Bool:
	scope = {
		variable = named_var("resource"),
		typ = int_type(),
		acquire = int_var("acquire"),
		body = BinaryExpr(
			AddOp,
			string_lit("a"),
			string_lit("b"),
			string_type(),
			SyntheticSourceLoc,
		),
		cleanup = VoidExpr(VoidType, SyntheticSourceLoc)
	}
	expected_scope = { scope | body = builtin_call(
			"blorp_string_concat",
			[string_lit("a"), string_lit("b")],
			string_type(),
		) }

	core_exprs_equal(
		desugar_expr(ResourceScopeExpr(scope, string_type(), SyntheticSourceLoc)),
		ResourceScopeExpr(expected_scope, string_type(), SyntheticSourceLoc),
	)


pure func is_string_concat_call(expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(BuiltinCall(name), _, args, _, _):
			name == "blorp_string_concat" and args.length() == 2
		_:
			False


func test_desugars_deep_sequence_without_exhausting_stack() -> Bool:
	sequence_depth: Int = 2048
	var source: CoreExpr = BinaryExpr(
		AddOp,
		string_lit("last"),
		string_lit("item"),
		string_type(),
		SyntheticSourceLoc,
	)
	var index: Int = 0

	while index < sequence_depth:
		source = SeqExpr(
			BinaryExpr(
				AddOp,
				string_lit("item"),
				string_lit("next"),
				string_type(),
				SyntheticSourceLoc,
			),
			source,
		)
		index += 1

	var current: CoreExpr = desugar_expr(source)
	var desugared_items: Int = 0
	var all_desugared: Bool = True

	while True:
		match current:
			SeqExpr(first, second):
				if not is_string_concat_call(first):
					all_desugared = False
					break

				desugared_items += 1
				current = second
			_:
				if is_string_concat_call(current):
					desugared_items += 1
				else:
					all_desugared = False

				break

	all_desugared and desugared_items == sequence_depth + 1


func test_desugars_string_accumulator_assignment_to_append() -> Bool:
	expr = AssignExpr(
		named_var("out"),
		BinaryExpr(
			AddOp,
			string_var("out"),
			string_var("suffix"),
			string_type(),
			SyntheticSourceLoc,
		),
		VoidType,
		SyntheticSourceLoc,
	)
	expected = AssignExpr(
		named_var("out"),
		builtin_call(
			"blorp_string_append",
			[string_var("out"), string_var("suffix")],
			string_type(),
		),
		VoidType,
		SyntheticSourceLoc,
	)

	core_exprs_equal(desugar_expr(expr), expected)


func test_desugars_literal_string_accumulator_assignment_to_append() -> Bool:
	source = VarExpr(named_var("out"), literal_string_type(), SyntheticSourceLoc)
	expr = AssignExpr(
		named_var("out"),
		BinaryExpr(AddOp, source, string_var("suffix"), string_type(), SyntheticSourceLoc),
		VoidType,
		SyntheticSourceLoc,
	)
	expected = AssignExpr(
		named_var("out"),
		builtin_call(
			"blorp_string_append",
			[source, string_var("suffix")],
			string_type(),
		),
		VoidType,
		SyntheticSourceLoc,
	)

	core_exprs_equal(desugar_expr(expr), expected)


func test_keeps_non_accumulator_string_assignment_as_concat() -> Bool:
	expr = AssignExpr(
		named_var("out"),
		BinaryExpr(
			AddOp,
			string_var("prefix"),
			string_var("suffix"),
			string_type(),
			SyntheticSourceLoc,
		),
		VoidType,
		SyntheticSourceLoc,
	)
	expected = AssignExpr(
		named_var("out"),
		builtin_call(
			"blorp_string_concat",
			[string_var("prefix"), string_var("suffix")],
			string_type(),
		),
		VoidType,
		SyntheticSourceLoc,
	)

	core_exprs_equal(desugar_expr(expr), expected)


func test_keeps_distinct_string_variable_assignment_as_concat() -> Bool:
	source = VarExpr(
		named_var_with_uniq("out", 1),
		string_type(),
		SyntheticSourceLoc,
	)
	expr = AssignExpr(
		named_var("out"),
		BinaryExpr(AddOp, source, string_var("suffix"), string_type(), SyntheticSourceLoc),
		VoidType,
		SyntheticSourceLoc,
	)
	expected = AssignExpr(
		named_var("out"),
		builtin_call(
			"blorp_string_concat",
			[source, string_var("suffix")],
			string_type(),
		),
		VoidType,
		SyntheticSourceLoc,
	)

	core_exprs_equal(desugar_expr(expr), expected)


func test_keeps_malformed_string_accumulator_assignment_as_concat() -> Bool:
	expr = AssignExpr(
		named_var("out"),
		BinaryExpr(AddOp, string_var("out"), string_var("suffix"), int_type(), SyntheticSourceLoc),
		VoidType,
		SyntheticSourceLoc,
	)
	expected = AssignExpr(
		named_var("out"),
		builtin_call(
			"blorp_string_concat",
			[string_var("out"), string_var("suffix")],
			int_type(),
		),
		VoidType,
		SyntheticSourceLoc,
	)

	core_exprs_equal(desugar_expr(expr), expected)


pure func sample_function(body: CoreExpr) -> CoreFunction:
	{
		name = "make_message",
		source_module = None,
		type_params = [],
		params = [],
		return_type = string_type(),
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 1,
		loc = SyntheticSourceLoc
	}


pure func sample_global(init: CoreExpr) -> CoreGlobal:
	{
		name = named_var("message"),
		source_module = None,
		typ = string_type(),
		init = init,
		is_mutable = False,
		is_const = False,
		is_private = False,
		def_id = 2,
		loc = SyntheticSourceLoc
	}


func test_desugars_program_function_global_and_impl_bodies() -> Bool:
	source_expr = BinaryExpr(
		AddOp,
		string_lit("a"),
		string_lit("b"),
		string_type(),
		SyntheticSourceLoc,
	)
	desugared_expr = builtin_call(
		"blorp_string_concat",
		[string_lit("a"), string_lit("b")],
		string_type(),
	)
	source_program: CoreProgram = {
		decls = [
			FunctionDecl(sample_function(source_expr)),
			GlobalDecl(sample_global(source_expr)),
			ImplDecl({
				trait_name = "Message",
				for_type = string_type(),
				type_params = [],
				methods = [sample_function(source_expr)],
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}
	expected: CoreProgram = {
		decls = [
			FunctionDecl(sample_function(desugared_expr)),
			GlobalDecl(sample_global(desugared_expr)),
			ImplDecl({
				trait_name = "Message",
				for_type = string_type(),
				type_params = [],
				methods = [sample_function(desugared_expr)],
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}

	core_programs_equal(desugar_program(source_program), expected)


tests: TestSuite = {
	description = "Blorp compiler Core desugar",
	tests = [
		("desugars string add to concat call", test_desugars_string_add_to_concat_call),
		("desugars string equal to builtin call", test_desugars_string_equal_to_builtin_call),
		(
			"desugars string not equal to not builtin call",
			test_desugars_string_not_equal_to_not_builtin_call,
		),
		(
			"desugars literal string add to concat call",
			test_desugars_literal_string_add_to_concat_call,
		),
		(
			"desugars literal string equal to builtin call",
			test_desugars_literal_string_equal_to_builtin_call,
		),
		("leaves non string add as binary expr", test_leaves_non_string_add_as_binary_expr),
		("desugars nested string add inside let", test_desugars_nested_string_add_inside_let),
		("desugars string add inside debug block", test_desugars_string_add_inside_debug_block),
		("desugars string add inside cast", test_desugars_string_add_inside_cast),
		(
			"desugars string add inside raw match case",
			test_desugars_string_add_inside_raw_match_case,
		),
		(
			"desugars string add inside resource scope",
			test_desugars_string_add_inside_resource_scope,
		),
		(
			"desugars deep sequence without exhausting stack",
			test_desugars_deep_sequence_without_exhausting_stack,
		),
		(
			"desugars string accumulator assignment to append",
			test_desugars_string_accumulator_assignment_to_append,
		),
		(
			"desugars literal string accumulator assignment to append",
			test_desugars_literal_string_accumulator_assignment_to_append,
		),
		(
			"keeps non accumulator string assignment as concat",
			test_keeps_non_accumulator_string_assignment_as_concat,
		),
		(
			"keeps distinct string variable assignment as concat",
			test_keeps_distinct_string_variable_assignment_as_concat,
		),
		(
			"keeps malformed string accumulator assignment as concat",
			test_keeps_malformed_string_accumulator_assignment_as_concat,
		),
		(
			"desugars program function global and impl bodies",
			test_desugars_program_function_global_and_impl_bodies,
		),
	]
}
