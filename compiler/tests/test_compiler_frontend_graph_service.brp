import:
	../src/stage_01_file_io/source: source_file
	../src/stage_03_parse/language_parser: parse_compiler_source
	../src/stage_03_parse/source_ast_finalize: finalized_typecheck_program
	../src/stage_04_modules/frontend_graph:
		FrontendModule,
		frontend_graph_import_edges,
		frontend_graph_modules,
		frontend_module,
		frontend_resolved_import_edge,
		frontend_unresolved_import_edge,
	../src/stage_04_modules/frontend_graph_service:
		FrontendGraphServiceError(
			DuplicateCompilerFrontendImportOutcome,
			MissingCompilerFrontendImportOutcome,
			UndeclaredCompilerFrontendImportOutcome,
		),
		FrontendSourceCandidate,
		FrontendSourceResolution(FrontendSourceResolved, FrontendSourceUnresolved),
		frontend_graph_discover,
		frontend_graph_for_sources,
		frontend_source_candidate,
	../src/stage_04_modules/loaded_module:
		ModuleOrigin(UserModule),
		ResolvedModuleIdentity,
		resolved_module_identities_equal,
		resolved_module_identity_from_resolver,
	test: TestSuite


private pure func identity(module_name: String) -> ResolvedModuleIdentity:
	resolved_module_identity_from_resolver(module_name, UserModule)


private pure func module(module_name: String, text: String) -> FrontendModule:
	source = source_file("/workspace/" + module_name + ".brp", module_name, text)
	frontend_module(
		identity(module_name),
		finalized_typecheck_program(parse_compiler_source(source)),
	)


pure func test_service_requires_an_outcome_for_each_parsed_import() -> Bool:
	app = module("app", "import:\n\tdep\n\nVALUE = 1\n")

	match frontend_graph_for_sources([app], [app.identity], []):
		Err([MissingCompilerFrontendImportOutcome(importer, requested_path)]):
			resolved_module_identities_equal(importer, app.identity) and requested_path == "dep"
		_:
			False


pure func test_service_rejects_duplicate_outcomes_for_one_import() -> Bool:
	app = module("app", "import:\n\tdep\n\nVALUE = 1\n")
	edges = [
		frontend_unresolved_import_edge(app.identity, "dep"),
		frontend_unresolved_import_edge(app.identity, "dep"),
	]

	match frontend_graph_for_sources([app], [app.identity], edges):
		Err([DuplicateCompilerFrontendImportOutcome(importer, requested_path)]):
			resolved_module_identities_equal(importer, app.identity) and requested_path == "dep"
		_:
			False


pure func test_service_rejects_an_edge_without_a_parsed_import() -> Bool:
	app = module("app", "VALUE = 1\n")
	edge = frontend_unresolved_import_edge(app.identity, "dep")

	match frontend_graph_for_sources([app], [app.identity], [edge]):
		Err([UndeclaredCompilerFrontendImportOutcome(importer, requested_path)]):
			resolved_module_identities_equal(importer, app.identity) and requested_path == "dep"
		_:
			False


pure func test_service_accepts_cycles_with_exact_resolved_edges() -> Bool:
	app = module("app", "import:\n\tdep\n\nVALUE = 1\n")
	dep = module("dep", "import:\n\tapp\n\nVALUE = 2\n")
	edges = [
		frontend_resolved_import_edge(app.identity, "dep", dep.identity),
		frontend_resolved_import_edge(dep.identity, "app", app.identity),
	]

	match (
		frontend_graph_for_sources(
			[app, dep],
			[app.identity],
			edges,
		)
	):
		Err(_):
			False
		Ok(graph):
			frontend_graph_import_edges(graph).length() == 2


private pure func cycle_source(
	module_name: String,
	imported_module: String,
) -> FrontendSourceCandidate:
	frontend_source_candidate(
		identity(module_name),
		source_file(
			"/workspace/" + module_name + ".brp",
			module_name,
			"import:\n\t" + imported_module + "\n\nVALUE = 1\n",
		),
	)


private pure func resolve_cycle_source(
	importer: FrontendSourceCandidate,
	requested_path: String,
) -> Result[FrontendSourceResolution, String]:
	if importer.source.module_name == "app" and requested_path == "dep":
		Ok(FrontendSourceResolved(cycle_source("dep", "app")))
	else if importer.source.module_name == "dep" and requested_path == "app":
		Ok(FrontendSourceResolved(cycle_source("app", "dep")))
	else:
		Ok(FrontendSourceUnresolved)


func test_discovery_owns_parsing_resolution_edges_and_cycle_termination() -> Bool:
	app = cycle_source("app", "dep")

	match frontend_graph_discover([app], [], resolve_cycle_source):
		Err(_):
			False
		Ok(graph):
			(
				frontend_graph_import_edges(graph).length() == 2
				and frontend_graph_modules(graph).length() == 2
			)


tests: TestSuite = {
	description = "Compiler frontend graph service",
	tests = [
		(
			"require one outcome for each parsed import",
			test_service_requires_an_outcome_for_each_parsed_import,
		),
		(
			"reject duplicate outcomes for one parsed import",
			test_service_rejects_duplicate_outcomes_for_one_import,
		),
		(
			"reject an outcome without a parsed import",
			test_service_rejects_an_edge_without_a_parsed_import,
		),
		(
			"accept cycles with exact resolved edges",
			test_service_accepts_cycles_with_exact_resolved_edges,
		),
		(
			"own parsing resolution edges and cycle termination",
			test_discovery_owns_parsing_resolution_edges_and_cycle_termination,
		),
	]
}
