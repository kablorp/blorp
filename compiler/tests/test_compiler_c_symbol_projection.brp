	{
		decls = [FunctionDecl(hash_function), FunctionDecl(equals_function), FunctionDecl(host)],
		foreign_includes = []
	}


pure func test_callable_id_contract_fixed_vectors() -> Bool:
	(
		projected_callable_base_symbol(0) == "brp_0"
		and projected_callable_base_symbol(1) == "brp_1"
		and projected_callable_base_symbol(61) == "brp_Z"
		and projected_callable_base_symbol(62) == "brp_10"
		and projected_callable_base_symbol(3843) == "brp_ZZ"
		and projected_callable_base_symbol(3844) == "brp_100"
	)


pure func test_callable_id_contract_uses_compact_portable_identifiers() -> Bool:
	name: String = projected_callable_base_symbol(1450)

	name == "brp_no" and not name.starts_with("__") and not name.starts_with("_[A-Z]")


pure func test_callable_plan_is_order_independent() -> Bool:
	first = candidate("module_alpha_first", 7, ProjectedUserFunction)
	second = candidate("module_beta_second", 3, ProjectedClosureBody)

	match (
		(
			build_callable_symbol_plan(
				[first, second],
				["main"],
			),
			build_callable_symbol_plan(
				[second, first],
				["main"],
			),
		)
	):
		(Ok(left), Ok(right)):
			(
				projected_callable_name(
					left,
					"module_alpha_first",
					7,
				) == projected_callable_name(right, "module_alpha_first", 7)
				and projected_callable_name(
					left,
					"module_beta_second",
					3,
				) == projected_callable_name(right, "module_beta_second", 3)
			)
		_:
			False


pure func test_similar_callable_names_have_distinct_symbols() -> Bool:
	projected_callable_base_symbol(1) != projected_callable_base_symbol(2)


pure func test_callable_plan_coalesces_repeated_identity() -> Bool:
	item = candidate("module_repeat", 9, ProjectedUserFunction)

	match (
		build_callable_symbol_plan(
			[item, item],
			["main"],
		)
	):
		Ok(plan):
			projected_callable_name(plan, "module_repeat", 9) == Some(projected_callable_base_symbol(9))
		Err(_):
			False


pure func test_callable_plan_rejects_disagreeing_repeated_identity() -> Bool:
	first = candidate("module_repeat", 9, ProjectedUserFunction)
	second = { first | original_c_spelling = "different_c_spelling" }

	match (
		build_callable_symbol_plan(
			[first, second],
			[],
		)
	):
		Err(DuplicateCallableIdentity(name, def_id)):
			name == "module_repeat" and def_id == 9
		_:
			False


pure func test_callable_plan_rejects_definition_id_owned_by_two_callables() -> Bool:
	match (
		build_callable_symbol_plan(
			[
				candidate("module_first", 9, ProjectedUserFunction),
				candidate("module_second", 9, ProjectedUserFunction),
			],
			[],
		)
	):
		Err(DuplicateCallableDefinitionId(9, first, second)):
			first == "module_first" and second == "module_second"
		_:
			False


pure func test_callable_plan_escapes_preserved_compact_name() -> Bool:
	match (
		build_callable_symbol_plan(
			[candidate("module_first", 0, ProjectedUserFunction)],
			["main", "brp_0"],
		)
	):
		Ok(plan):
			projected_callable_name(plan, "module_first", 0) == Some("brp_0_")
		Err(_):
			False


pure func test_callable_plan_escapes_preserved_closure_static_name() -> Bool:
	match (
		build_callable_symbol_plan(
			[candidate("module_first", 0, ProjectedClosureBody)],
			["__sc_brp_0", "__sc_brp_0_"],
		)
	):
		Ok(plan):
			projected_callable_name(plan, "module_first", 0) == Some("brp_0__")
		Err(_):
			False


pure func test_callable_plan_rejects_negative_definition_id() -> Bool:
	match (
		build_callable_symbol_plan(
			[candidate("module_first", -1, ProjectedUserFunction)],
			[],
		)
	):
		Err(InvalidCallableDefinitionId(-1, name)):
			name == "module_first"
		_:
			False


pure func test_projection_boundary_rejects_duplicate_final_definition_id() -> Bool:
	first: CoreFunction = user_function(
		"first",
		42,
		LiteralExpr(IntLiteral(1), int_type(), SyntheticSourceLoc),
	)
	second: CoreFunction = { user_function(
		"second",
		42,
		LiteralExpr(IntLiteral(2), int_type(), SyntheticSourceLoc),
	) | body = None }
	program: CoreProgram = {
		decls = [FunctionDecl(first), FunctionDecl(second)],
		foreign_includes = []
	}

	match project_core_program_callables(program):
		Err(InvalidCoreDefinitionIdentity(detail)):
			detail.contains("definition ID 42")
		Ok(_):
			False
		Err(_):
			False


pure func test_projects_user_definition_and_exact_direct_call_together() -> Bool:
	callee_name: String = "fixture_long_identity_function"
	caller_name: String = "fixture_long_caller_function"

	match project_core_program_callables(direct_call_program(Some(2))):
		Ok(projected):
			match projected_core_program_value(projected).decls:
				[FunctionDecl(callee), FunctionDecl(caller)]:
					match caller.body:
						Some(CallExpr(UserCall(call_name, Some(2), _), _, _, _, _)):
							(
								callee.name == projected_callable_base_symbol(2)
								and caller.name == projected_callable_base_symbol(3)
								and call_name == callee.name
							)
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_rejects_user_call_without_exact_definition_identity() -> Bool:
	match project_core_program_callables(direct_call_program(Some(99))):
		Err(MissingProjectedCallable(name, def_id)):
			name == "fixture_long_identity_function" and def_id == 99
		_:
			False


pure func test_rejects_unresolved_final_call_kind() -> Bool:
	match project_core_program_callables(unresolved_call_program()):
		Err(UnsupportedPreparedCallKind(kind)):
			kind == "unknown"
		_:
			False


pure func test_rejects_top_level_function_value_without_closure_conversion() -> Bool:
	match project_core_program_callables(unprojected_function_value_program()):
		Err(UnprojectedCallableValue(name, def_id)):
			name == "fixture_function_value_target" and def_id == 19
		_:
			False


pure func test_projects_closure_body_create_and_static_object_together() -> Bool:
	original_c_name: String = "fixture_long_closure_body"

	match project_core_program_callables(
		closure_create_program(static_closure_name(original_c_name)),
	):
		Ok(projected):
			match projected_core_program_value(projected).decls:
				[FunctionDecl(body_function), FunctionDecl(host_function)]:
					match (body_function.function_kind, host_function.body):
						(ClosureBodyFunction(abi), Some(ClosureCreateExpr(create, _, _))):
							expected: String = projected_callable_base_symbol(4)

							(
								abi.c_name == expected
								and create.c_name == expected
								and create.static_name == static_closure_name(expected)
							)
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_rejects_stale_closure_static_name() -> Bool:
	match project_core_program_callables(closure_create_program("stale_static_name")):
		Err(CallableCNameMismatch(expected, actual)):
			expected == "__sc_fixture_long_closure_body" and actual == "stale_static_name"
		_:
			False


pure func test_projects_detached_task_closure() -> Bool:
	match project_core_program_callables(task_program()):
		Ok(projected):
			match projected_core_program_value(projected).decls:
				[FunctionDecl(body_function), FunctionDecl(host_function)]:
					match (body_function.function_kind, host_function.body):
						(ClosureBodyFunction(abi), Some(DetachExpr(task, _, _))):
							expected: String = projected_callable_base_symbol(6)

							(
								abi.c_name == expected
								and task.c_name == expected
								and task.static_name == static_closure_name(expected)
							)
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_projects_concurrently_loop_task_closure() -> Bool:
	match project_core_program_callables(concurrently_loop_program()):
		Ok(projected):
			match projected_core_program_value(projected).decls:
				[FunctionDecl(body_function), FunctionDecl(host_function)]:
					match (body_function.function_kind, host_function.body):
						(ClosureBodyFunction(abi), Some(ConcurrentlyLoopExpr(loop, _, _))):
							expected: String = projected_callable_base_symbol(11)

							(
								abi.c_name == expected
								and loop.task.c_name == expected
								and loop.task.static_name == static_closure_name(expected)
							)
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_projects_concurrent_block_task_closure() -> Bool:
	match project_core_program_callables(concurrent_block_program()):
		Ok(projected):
			match projected_core_program_value(projected).decls:
				[FunctionDecl(body_function), FunctionDecl(host_function)]:
					match (body_function.function_kind, host_function.body):
						(ClosureBodyFunction(abi), Some(ConcurrentExpr(block, _, _))):
							match block.bindings:
								[binding]:
									expected: String = projected_callable_base_symbol(13)

									(
										abi.c_name == expected
										and binding.task.c_name == expected
										and binding.task.static_name == static_closure_name(
											expected,
										)
									)
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_projects_list_to_string_callback() -> Bool:
	callback_name: String = "fixture_long_list_item_to_string"

	match project_core_program_callables(list_to_string_callback_program()):
		Ok(projected):
			match projected_core_program_value(projected).decls:
				[FunctionDecl(callback), FunctionDecl(host_function)]:
					match host_function.body:
						Some(CallExpr(ListToStringCall(projected_name), _, _, _, _)):
							(
								callback.name == projected_callable_base_symbol(15)
								and projected_name == callback.name
								and projected_original_callable_name(
									projected,
									callback.name,
								) == callback_name
							)
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_projects_custom_collection_callbacks() -> Bool:
	match project_core_program_callables(custom_callback_program()):
		Ok(projected):
			match projected_core_program_value(projected).decls:
				[_, _, FunctionDecl(host_function)]:
					match host_function.body:
						Some(SetAllocExpr(constructor, _, _)):
							match constructor:
								CustomHashContainerConstructor(hash_name, equals_name, False):
									(
										hash_name == projected_callable_base_symbol(8)
										and equals_name == projected_callable_base_symbol(9)
									)
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_projects_dict_with_capacity_callbacks() -> Bool:
	match project_core_program_callables(custom_callback_call_program()):
		Ok(projected):
			match projected_core_program_value(projected).decls:
				[_, _, FunctionDecl(host_function)]:
					match host_function.body:
						Some(CallExpr(DictWithCapacityCall(constructor), _, _, _, _)):
							match constructor:
								CustomHashContainerConstructor(hash_name, equals_name, False):
									(
										hash_name == projected_callable_base_symbol(21)
										and equals_name == projected_callable_base_symbol(22)
									)
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_projects_dict_construct_callbacks() -> Bool:
	match project_core_program_callables(custom_callback_dict_construct_program()):
		Ok(projected):
			match projected_core_program_value(projected).decls:
				[_, _, FunctionDecl(host_function)]:
					match host_function.body:
						Some(DictConstructExpr(construct, _, _)):
							match construct.constructor:
								CustomHashContainerConstructor(hash_name, equals_name, False):
									(
										hash_name == projected_callable_base_symbol(24)
										and equals_name == projected_callable_base_symbol(25)
									)
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_rejects_missing_custom_collection_callback() -> Bool:
	program: CoreProgram = {
		decls = [
			FunctionDecl(
				user_function(
					"fixture_missing_callback_host",
					27,
					SetAllocExpr(
						CustomHashContainerConstructor(
							"fixture_missing_hash",
							"fixture_missing_equals",
							False,
						),
						NamedType("Set", [int_type()]),
						SyntheticSourceLoc,
					),
				),
			),
		],
		foreign_includes = []
	}

	match project_core_program_callables(program):
		Err(UnresolvedCallbackTarget(name)):
			name == "fixture_missing_hash"
		_:
			False


tests: TestSuite = {
	description = "Compiler C symbol projection Tests",
	tests = [
		("callable ID contract fixed vectors", test_callable_id_contract_fixed_vectors),
		(
			"callable ID contract uses compact portable identifiers",
			test_callable_id_contract_uses_compact_portable_identifiers,
		),
		("callable plan is order independent", test_callable_plan_is_order_independent),
		(
			"similar callable names have distinct symbols",
			test_similar_callable_names_have_distinct_symbols,
		),
		(
			"callable plan coalesces repeated identity",
			test_callable_plan_coalesces_repeated_identity,
		),
		(
			"callable plan rejects disagreeing repeated identity",
			test_callable_plan_rejects_disagreeing_repeated_identity,
		),
		(
			"callable plan rejects definition ID owned by two callables",
			test_callable_plan_rejects_definition_id_owned_by_two_callables,
		),
		(
			"callable plan escapes preserved compact name",
			test_callable_plan_escapes_preserved_compact_name,
		),
		(
			"callable plan escapes preserved closure static name",
			test_callable_plan_escapes_preserved_closure_static_name,
		),
		(
			"callable plan rejects negative definition ID",
			test_callable_plan_rejects_negative_definition_id,
		),
		(
			"projection boundary rejects duplicate final definition ID",
			test_projection_boundary_rejects_duplicate_final_definition_id,
		),
		(
			"projects user definition and exact direct call together",
			test_projects_user_definition_and_exact_direct_call_together,
		),
		(
			"rejects user call without exact definition identity",
			test_rejects_user_call_without_exact_definition_identity,
		),
		("rejects unresolved final call kind", test_rejects_unresolved_final_call_kind),
		(
			"rejects top-level function value without closure conversion",
			test_rejects_top_level_function_value_without_closure_conversion,
		),
		(
			"projects closure body create and static object together",
			test_projects_closure_body_create_and_static_object_together,
		),
		("rejects stale closure static name", test_rejects_stale_closure_static_name),
		("projects detached task closure", test_projects_detached_task_closure),
		("projects concurrently loop task closure", test_projects_concurrently_loop_task_closure),
		("projects concurrent block task closure", test_projects_concurrent_block_task_closure),
		("projects list to string callback", test_projects_list_to_string_callback),
		("projects custom collection callbacks", test_projects_custom_collection_callbacks),
		("projects dict with capacity callbacks", test_projects_dict_with_capacity_callbacks),
		("projects dict construct callbacks", test_projects_dict_construct_callbacks),
		(
			"rejects missing custom collection callback",
			test_rejects_missing_custom_collection_callback,
		),
	]
}
