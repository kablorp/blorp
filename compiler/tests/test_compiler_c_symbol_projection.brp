import:
	../src/stage_09_core/ir:
		CoreCallKind(DictWithCapacityCall, ListToStringCall, UnknownCall, UserCall),
		CoreClosureAbi,
		CoreClosureCreate,
		CoreConcurrentBinding,
		CoreConcurrentBlock,
		CoreConcurrentlyLoop,
		CoreConcurrentlyLoopItemMode(ConcurrentlyLoopCopyItem),
		CoreConcurrentlyLoopOutput(ConcurrentlyLoopDiscard),
		CoreDecl(FunctionDecl),
		CoreExpr(
			CallExpr,
			ClosureCreateExpr,
			ConcurrentExpr,
			ConcurrentlyLoopExpr,
			DetachExpr,
			DictConstructExpr,
			LiteralExpr,
			SetAllocExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunction,
		CoreFunctionKind(ClosureBodyFunction, UserFunction),
		CoreHashContainerConstructor(CustomHashContainerConstructor),
		CoreLiteral(IntLiteral),
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreTaskClosure,
		CoreType(FunctionType, NamedType, VoidType),
	../src/stage_10_backend/c_naming: static_closure_name
	../src/stage_10_backend/c_symbol_projection:
		CCallableSymbolCandidate,
		CProjectedCallableKind(ProjectedClosureBody, ProjectedUserFunction),
		CSymbolProjectionError(
			DuplicateCallableDefinitionId,
			DuplicateCallableIdentity,
			CallableCNameMismatch,
			InvalidCoreDefinitionIdentity,
			InvalidCallableDefinitionId,
			MissingProjectedCallable,
			UnsupportedPreparedCallKind,
			UnresolvedCallbackTarget,
			UnprojectedCallableValue,
		),
		build_callable_symbol_plan,
		project_core_program_callables,
		projected_callable_name,
		projected_callable_base_symbol,
		projected_core_program_value,
		projected_original_callable_name,
	test: TestSuite


private pure func candidate(
	name: String,
	def_id: Int,
	kind: CProjectedCallableKind,
) -> CCallableSymbolCandidate:
	{
		kind = kind,
		qualified_name = name,
		def_id = def_id,
		original_c_spelling = name
	}


private pure func int_type() -> CoreType:
	NamedType("Int", [])


private pure func function_type() -> CoreType:
	FunctionType(True, [], int_type())


private pure func user_function(name: String, def_id: Int, body: CoreExpr) -> CoreFunction:
	{
		name = name,
		source_module = Some("fixture"),
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc
	}


private pure func direct_call_program(call_def_id: Option[Int]) -> CoreProgram:
	callee_name: String = "fixture_long_identity_function"
	callee: CoreFunction = user_function(
		callee_name,
		2,
		LiteralExpr(IntLiteral(7), int_type(), SyntheticSourceLoc),
	)
	caller: CoreFunction = user_function(
		"fixture_long_caller_function",
		3,
		CallExpr(
			UserCall(
				callee_name,
				call_def_id,
				[],
			),
			VarExpr(
				{
					name = callee_name,
					uniq = 0,
					def_id = call_def_id
				},
				function_type(),
				SyntheticSourceLoc,
			),
			[],
			int_type(),
			SyntheticSourceLoc,
		),
	)
	{
		decls = [FunctionDecl(callee), FunctionDecl(caller)],
		foreign_includes = []
	}


private pure func unresolved_call_program() -> CoreProgram:
	callee_name: String = "fixture_unresolved_target"
	callee = user_function(
		callee_name,
		17,
		LiteralExpr(IntLiteral(7), int_type(), SyntheticSourceLoc),
	)
	host = user_function(
		"fixture_unresolved_host",
		18,
		CallExpr(
			UnknownCall,
			VarExpr(
				{
					name = callee_name,
					uniq = 0,
					def_id = Some(17)
				},
				function_type(),
				SyntheticSourceLoc,
			),
			[],
			int_type(),
			SyntheticSourceLoc,
		),
	)
	{
		decls = [FunctionDecl(callee), FunctionDecl(host)],
		foreign_includes = []
	}


private pure func unprojected_function_value_program() -> CoreProgram:
	callee_name: String = "fixture_function_value_target"
	callee = user_function(
		callee_name,
		19,
		LiteralExpr(IntLiteral(7), int_type(), SyntheticSourceLoc),
	)
	host = user_function(
		"fixture_function_value_host",
		20,
		VarExpr(
			{
				name = callee_name,
				uniq = 0,
				def_id = Some(19)
			},
			function_type(),
			SyntheticSourceLoc,
		),
	)
	{
		decls = [FunctionDecl(callee), FunctionDecl(host)],
		foreign_includes = []
	}


private pure func closure_abi(c_name: String, task_abi: Bool) -> CoreClosureAbi:
	{
		c_name = c_name,
		params = [],
		captures = [],
		moved_captures = [],
		task_abi = task_abi
	}


private pure func closure_body_function(
	name: String,
	def_id: Int,
	c_name: String,
	task_abi: Bool,
) -> CoreFunction:
	{
		name = name,
		source_module = Some("fixture"),
		type_params = [],
		params = [],
		return_type = VoidType,
		body = Some(VoidExpr(VoidType, SyntheticSourceLoc)),
		is_pure = True,
		function_kind = ClosureBodyFunction(closure_abi(c_name, task_abi)),
		def_id = def_id,
		loc = SyntheticSourceLoc
	}


private pure func closure_create_program(static_name: String) -> CoreProgram:
	semantic_name: String = "fixture_long_closure"
	c_name: String = "fixture_long_closure_body"
	body = closure_body_function(semantic_name, 4, c_name, False)
	host = user_function(
		"fixture_closure_host",
		5,
		ClosureCreateExpr(
			{
				function_name = semantic_name,
				def_id = 4,
				c_name = c_name,
				static_name = static_name,
				captures = []
			},
			function_type(),
			SyntheticSourceLoc,
		),
	)
	{
		decls = [FunctionDecl(body), FunctionDecl(host)],
		foreign_includes = []
	}


private pure func task_program() -> CoreProgram:
	semantic_name: String = "fixture_long_task"
	c_name: String = "fixture_long_task_body"
	body = closure_body_function(semantic_name, 6, c_name, True)
	task: CoreTaskClosure = {
		function_name = semantic_name,
		def_id = 6,
		c_name = c_name,
		static_name = static_closure_name(c_name),
		captures = [],
		return_type = VoidType
	}
	host = user_function(
		"fixture_task_host",
		7,
		DetachExpr(task, VoidType, SyntheticSourceLoc),
	)
	{
		decls = [FunctionDecl(body), FunctionDecl(host)],
		foreign_includes = []
	}


private pure func concurrently_loop_program() -> CoreProgram:
	semantic_name: String = "fixture_long_concurrently_loop_task"
	c_name: String = "fixture_long_concurrently_loop_task_body"
	body = closure_body_function(semantic_name, 11, c_name, True)
	task: CoreTaskClosure = {
		function_name = semantic_name,
		def_id = 11,
		c_name = c_name,
		static_name = static_closure_name(c_name),
		captures = [],
		return_type = VoidType
	}
	loop: CoreConcurrentlyLoop = {
		variable = {
			name = "item",
			uniq = 0,
			def_id = None
		},
		item_type = int_type(),
		item_mode = ConcurrentlyLoopCopyItem,
		iterable = VoidExpr(VoidType, SyntheticSourceLoc),
		body = VoidExpr(VoidType, SyntheticSourceLoc),
		timeout = None,
		limit = LiteralExpr(IntLiteral(1), int_type(), SyntheticSourceLoc),
		output = ConcurrentlyLoopDiscard,
		task = task
	}
	host = user_function(
		"fixture_concurrently_loop_host",
		12,
		ConcurrentlyLoopExpr(loop, VoidType, SyntheticSourceLoc),
	)
	{
		decls = [FunctionDecl(body), FunctionDecl(host)],
		foreign_includes = []
	}


private pure func concurrent_block_program() -> CoreProgram:
	semantic_name: String = "fixture_long_concurrent_block_task"
	c_name: String = "fixture_long_concurrent_block_task_body"
	body = closure_body_function(semantic_name, 13, c_name, True)
	task: CoreTaskClosure = {
		function_name = semantic_name,
		def_id = 13,
		c_name = c_name,
		static_name = static_closure_name(c_name),
		captures = [],
		return_type = VoidType
	}
	binding: CoreConcurrentBinding = {
		variable = {
			name = "result",
			uniq = 0,
			def_id = None
		},
		typ = VoidType,
		rhs = VoidExpr(VoidType, SyntheticSourceLoc),
		task = task
	}
	block: CoreConcurrentBlock = {
		bindings = [binding],
		body = VoidExpr(VoidType, SyntheticSourceLoc),
		timeout = None,
		max_threads = None
	}
	host = user_function(
		"fixture_concurrent_block_host",
		14,
		ConcurrentExpr(block, VoidType, SyntheticSourceLoc),
	)
	{
		decls = [FunctionDecl(body), FunctionDecl(host)],
		foreign_includes = []
	}


private pure func list_to_string_callback_program() -> CoreProgram:
	callback_name: String = "fixture_long_list_item_to_string"
	callback = user_function(
		callback_name,
		15,
		LiteralExpr(IntLiteral(1), int_type(), SyntheticSourceLoc),
	)
	host = user_function(
		"fixture_list_to_string_host",
		16,
		CallExpr(
			ListToStringCall(callback_name),
			VarExpr(
				{
					name = callback_name,
					uniq = 0,
					def_id = Some(15)
				},
				function_type(),
				SyntheticSourceLoc,
			),
			[],
			int_type(),
			SyntheticSourceLoc,
		),
	)
	{
		decls = [FunctionDecl(callback), FunctionDecl(host)],
		foreign_includes = []
	}


private pure func custom_callback_program() -> CoreProgram:
	hash_name: String = "fixture_custom_hash"
	equals_name: String = "fixture_custom_equals"
	hash_function = user_function(
		hash_name,
		8,
		LiteralExpr(IntLiteral(11), int_type(), SyntheticSourceLoc),
	)
	equals_function = user_function(
		equals_name,
		9,
		LiteralExpr(IntLiteral(1), int_type(), SyntheticSourceLoc),
	)
	host = user_function(
		"fixture_custom_collection_host",
		10,
		SetAllocExpr(
			CustomHashContainerConstructor(hash_name, equals_name, False),
			NamedType("Set", [int_type()]),
			SyntheticSourceLoc,
		),
	)
	{
		decls = [FunctionDecl(hash_function), FunctionDecl(equals_function), FunctionDecl(host)],
		foreign_includes = []
	}


private pure func custom_callback_call_program() -> CoreProgram:
	hash_name: String = "fixture_call_custom_hash"
	equals_name: String = "fixture_call_custom_equals"
	hash_function = user_function(
		hash_name,
		21,
		LiteralExpr(IntLiteral(11), int_type(), SyntheticSourceLoc),
	)
	equals_function = user_function(
		equals_name,
		22,
		LiteralExpr(IntLiteral(1), int_type(), SyntheticSourceLoc),
	)
	host = user_function(
		"fixture_custom_capacity_host",
		23,
		CallExpr(
			DictWithCapacityCall(CustomHashContainerConstructor(hash_name, equals_name, False)),
			VoidExpr(
				VoidType,
				SyntheticSourceLoc,
			),
			[],
			NamedType(
				"Dict",
				[int_type(), int_type()],
			),
			SyntheticSourceLoc,
		),
	)
	{
		decls = [FunctionDecl(hash_function), FunctionDecl(equals_function), FunctionDecl(host)],
		foreign_includes = []
	}


private pure func custom_callback_dict_construct_program() -> CoreProgram:
	hash_name: String = "fixture_construct_custom_hash"
	equals_name: String = "fixture_construct_custom_equals"
	hash_function = user_function(
		hash_name,
		24,
		LiteralExpr(IntLiteral(11), int_type(), SyntheticSourceLoc),
