import:
	../benchmarks/compiler_ctfe_typecheck_profile_fixture:
		CompilerCtfeTypecheckBenchmarkConfig,
		compiler_ctfe_typecheck_benchmark,
	test: TestSuite


private func test_ctfe_typecheck_fixture_exercises_function_only_dependency_chain() -> Bool:
	result = compiler_ctfe_typecheck_benchmark({
		iterations = 1,
		module_count = 3,
		functions_per_module = 2,
		retain_parsed_programs = False,
	})

	(
		result.artifact_count == 1
		and result.dependency_declaration_count == 8
		and result.target_declaration_count == 3
		and result.resolved_import_count == 3
		and result.evaluated_answer == 3
		and result.error_count == 0
		and result.ctfe_evaluated_count == 1
		and result.checksum == 18
		and result.workload_valid
	)


private func test_ctfe_typecheck_fixture_is_deterministic_when_repeated() -> Bool:
	result = compiler_ctfe_typecheck_benchmark({
		iterations = 2,
		module_count = 3,
		functions_per_module = 2,
		retain_parsed_programs = True,
	})

	(
		result.workload_valid
		and result.error_count == 0
		and result.ctfe_evaluated_count == 2
		and result.checksum == 36
	)


private func test_ctfe_typecheck_fixture_models_reachable_and_irrelevant_bodies() -> Bool:
	narrow = compiler_ctfe_typecheck_benchmark({
		iterations = 1,
		module_count = 3,
		functions_per_module = 1,
		retain_parsed_programs = False,
	})
	wide = compiler_ctfe_typecheck_benchmark({
		iterations = 1,
		module_count = 3,
		functions_per_module = 8,
		retain_parsed_programs = False,
	})

	(
		narrow.expected_ctfe_reachable_function_body_count == 3
		and wide.expected_ctfe_reachable_function_body_count == 3
		and narrow.expected_ctfe_irrelevant_function_body_count == 0
		and wide.expected_ctfe_irrelevant_function_body_count == 21
		and narrow.evaluated_answer == wide.evaluated_answer
	)


tests: TestSuite = {
	description = "Compiler CTFE typecheck profile benchmark",
	tests = [
		(
			"fixture follows function-only dependency chain",
			test_ctfe_typecheck_fixture_exercises_function_only_dependency_chain,
		),
		(
			"repeated fixture remains deterministic",
			test_ctfe_typecheck_fixture_is_deterministic_when_repeated,
		),
		(
			"fixture models reachable and irrelevant bodies",
			test_ctfe_typecheck_fixture_models_reachable_and_irrelevant_bodies,
		),
	]
}
