import:
	../src/stage_04_modules/package_manifest:
		PackageManifest,
		package_manifest_error_text,
		parse_package_manifest,
		parse_package_manifest_at_path,
		read_package_manifest,
	bytes: bytes
	fs: IOError, resource_path, temporary_directory
	system: temp_dir, write_file
	test: TestSuite


private VALID_MANIFEST: String = "# Leading comments are ignored by parsing.\n" + "[package]\n" + "name = \"json_tools\"\n" + "version = \"0.1.0\"\n" + "license = \"MIT\" # Inline comments are ignored outside strings.\n\n" + "[compat]\n" + "std = \"preview-1\"\n\n" + "[exports]\n" + "modules = [\"json_tools\", \"json_tools/parser\"]\n"

private PARITY_MANIFEST: String = "# This comment is part of the package identity.\n" + "[package]\n" + "name = \"parity_pkg\"\n" + "version = \"1.2.3\"\n" + "license = \"MIT\" # Parsed as MIT, but the complete line is hashed.\n\n" + "[compat]\n" + "std = \"preview-1\"\n\n" + "[exports]\n" + "modules = [\"parity_pkg\", \"parity_pkg/helper\"]\n"


private pure func parsed_manifest(source: String) -> Option[PackageManifest]:
	match parse_package_manifest(source):
		Ok(manifest):
			Some(manifest)
		Err(_):
			None


private pure func parse_errors(source: String) -> String:
	match parse_package_manifest(source):
		Ok(_):
			""
		Err(errors):
			errors
				.map(package_manifest_error_text)
				.join("\n")


private pure func parse_errors_at_path(source: String, path: String) -> String:
	match parse_package_manifest_at_path(source, path):
		Ok(_):
			""
		Err(errors):
			errors
				.map(package_manifest_error_text)
				.join("\n")


pure func test_parses_narrow_manifest_format() -> Bool:
	match parsed_manifest(VALID_MANIFEST):
		Some(manifest):
			(
				manifest.name == "json_tools"
				and manifest.version == Some("0.1.0")
				and manifest.license == Some("MIT")
				and manifest.std_compat == "preview-1"
				and manifest.exports == ["json_tools", "json_tools/parser"]
			)
		None:
			False


pure func test_preserves_utf8_metadata_and_trims_form_feed() -> Bool:
	form_feed: String = bytes(1)
		.set_index(0, 12)
		.to_string()
	source: String = form_feed + "[package]" + form_feed + "\n" + form_feed + "name = \"json_tools\"" + form_feed + "\n" + "license = \"München\"\n\n" + "[compat]\n" + "std = \"preview-1\"\n\n" + "[exports]\n" + "modules = [\"json_tools\"]\n"

	match parsed_manifest(source):
		Some(manifest):
			manifest.name == "json_tools" and manifest.license == Some("München")
		None:
			False


pure func test_reports_malformed_manifest_with_path_and_line() -> Bool:
	source: String = "name = \"outside\"\n" + "[package]\n" + "name = \"first\"\n" + "name = \"duplicate\"\n" + "version = unquoted\n" + "unknown = \"value\"\n" + "[compat\n" + "[exports]\n" + "modules = [\"json_tools\" \"json_tools/parser\"]\n"

	errors: String = parse_errors_at_path(source, "vendor/json_tools/package.toml")

	var valid: Bool = errors.contains(
		"vendor/json_tools/package.toml:1: package manifest keys must be inside a section",
	)
	valid = valid and errors.contains((
			"vendor/json_tools/package.toml:4: duplicate key name in package manifest "
			+ "section [package]"
		))
	valid = valid and errors.contains("vendor/json_tools/package.toml:5: expected a quoted string")
	valid = valid and errors.contains((
			"vendor/json_tools/package.toml:6: unsupported key unknown in package manifest "
			+ "section [package]"
		))
	valid = (
		valid
		and errors.contains(
			"vendor/json_tools/package.toml:7: invalid package manifest section header",
		)
	)

	valid = (
		valid
		and errors.contains("vendor/json_tools/package.toml:9: expected ',' between array items")
	)

	valid


pure func test_rejects_duplicate_exports() -> Bool:
	source: String = "[package]\n" + "name = \"json_tools\"\n\n" + "[compat]\n" + "std = \"preview-1\"\n\n" + "[exports]\n" + "modules = [\"json_tools\", \"json_tools\"]\n"

	errors: String = parse_errors(source)

	errors.contains("duplicate exported module \"json_tools\"")


pure func test_rejects_dependency_declarations_including_duplicates() -> Bool:
	source: String = "[package]\n" + "name = \"json_tools\"\n\n" + "[dependencies]\n" + "other = \"0123456789abcdef\"\n" + "other = \"fedcba9876543210\"\n\n" + "[compat]\n" + "std = \"preview-1\"\n\n" + "[exports]\n" + "modules = [\"json_tools\"]\n"

	errors: String = parse_errors(source)

	-- Source packages cannot own dependency graphs. Reject the section before
	-- duplicate dependency entries can acquire ambiguous meaning.
	errors == "line 4: unsupported package manifest section [dependencies]"


pure func test_validates_package_and_export_names() -> Bool:
	reserved_source: String = "[package]\n" + "name = \"std\"\n\n" + "[compat]\n" + "std = \"preview-1\"\n\n" + "[exports]\n" + "modules = [\"std\"]\n"

	outside_source: String = "[package]\n" + "name = \"json_tools\"\n\n" + "[compat]\n" + "std = \"preview-1\"\n\n" + "[exports]\n" + "modules = [\"other\", \"std/json\", \"json_tools/../secret\", \"json_tools/München\"]\n"

	reserved: String = parse_errors(reserved_source)
	outside: String = parse_errors(outside_source)

	(
		reserved.contains("package name \"std\" is reserved by the module system")
		and outside.contains("exported module \"other\" must be inside package \"json_tools\"")
		and outside.contains("exported module \"std/json\" is not a valid module path")
		and outside.contains("exported module \"json_tools/../secret\" is not a valid module path")
		and outside.contains(
			"exported module \"json_tools/M" + "\\195\\188" + "nchen\" is not a valid module path",
		)
	)


private func exercise_manifest_file_reads() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_package_manifest_"):
		root: String = directory.resource_path()
		fixture: String = root + "/package.toml"
		missing: String = root + "/missing.toml"

		if write_file(fixture, PARITY_MANIFEST).is_err():
			Ok(False)
		else:
			match read_package_manifest(fixture):
				Err(_):
					Ok(False)
				Ok(manifest):
					match read_package_manifest(missing):
						Ok(_):
							Ok(False)
						Err(errors):
							Ok((
									manifest.name == "parity_pkg"
									and manifest.version == Some("1.2.3")
									and manifest.license == Some("MIT")
									and manifest.exports == ["parity_pkg", "parity_pkg/helper"]
									and errors
										.map(package_manifest_error_text)
										.join("\n") == missing + ": package manifest not found"
								))


func test_reads_manifest_fixture_and_reports_missing_file() -> Bool:
	match exercise_manifest_file_reads():
		Ok(result):
			result
		Err(_):
			False


tests: TestSuite = {
	description = "Blorp-owned package manifest",
	tests = [
		("parses narrow manifest format", test_parses_narrow_manifest_format),
		(
			"preserves UTF-8 metadata and trims form feed",
			test_preserves_utf8_metadata_and_trims_form_feed,
		),
		(
			"reports malformed manifest with path and line",
			test_reports_malformed_manifest_with_path_and_line,
		),
		("rejects duplicate exports", test_rejects_duplicate_exports),
		(
			"rejects dependency declarations including duplicates",
			test_rejects_dependency_declarations_including_duplicates,
		),
		("validates package and export names", test_validates_package_and_export_names),
		(
			"reads manifest fixture and reports missing file",
			test_reads_manifest_fixture_and_reports_missing_file,
		),
	]
}
