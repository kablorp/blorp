import:
	../src/stage_01_file_io/source:
		Cursor,
		SourceFile,
		SourceSpan,
		source_cursor_at,
		source_file,
		source_span,
	../src/stage_03_parse/parsed_ast:
		ParsedExpr(ParsedIntLiteralExpr),
		ParsedIdentifier,
		ParsedTypeExpr(ParsedNamedType),
		ParsedVarDecl,
		parsed_identifier,
	../src/stage_05_types/refinement: UNREFINED_BINDING
	../src/stage_05_types/semantic_type: TYPE_INT
	../src/stage_05_types/type_widening: ValueSlot(KeptValueSlot)
	../src/stage_06_typecheck/decl:
		TypedDecl(TypedGlobalVarDecl, TypedPrivateDecl),
		TypedGlobalVarInfo,
		TypedProgram,
	../src/stage_06_typecheck/infer:
		ExprTypeOrigin(SynthesizedOrigin),
		TypedExpr(TypedIntLiteralExpr),
		TypedExprInfo,
	../src/stage_07_ctfe/context: CtfeImportedProgram, complete_ctfe_imported_program
	../src/stage_07_ctfe/env:
		CTFE_ENV_EMPTY,
		CtfeEnvError(CtfeUnavailableBinding, CtfeUnknownBinding),
		ctfe_lookup_value,
	../src/stage_07_ctfe/globals:
		ctfe_bind_unavailable_program_globals,
		ctfe_global_decl_from_typed_decl,
		ctfe_global_initializer_runs_at_runtime,
		ctfe_imported_program_declares_global,
		ctfe_program_declares_global,
		ctfe_typed_decl_declares_global,
		ctfe_unavailable_reason_for_global,
	../src/stage_07_ctfe/value:
		CtfeUnavailableGlobalReason(CtfeLaterGlobal, CtfeRuntimeInitializedGlobal),
		CtfeValue,
	test: TestSuite


pure func fixture_source_file() -> SourceFile:
	source_file("globals.brp", "globals", "VALUE = 1")


pure func fixture_source_span() -> SourceSpan:
	src: SourceFile = fixture_source_file()
	cursor: Cursor = source_cursor_at(src, 0)
	source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, fixture_source_span())


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], fixture_source_span())


pure func parsed_var(name: String, is_mutable: Bool) -> ParsedVarDecl:
	{
		name = ident(name),
		type_expr = Some(named_type("Int")),
		value = ParsedIntLiteralExpr("1", fixture_source_span()),
		is_mutable = is_mutable,
		span = fixture_source_span()
	}


pure func expr_info() -> TypedExprInfo:
	{
		source_type = None,
		origin = SynthesizedOrigin("ctfe_globals_test"),
		value_slot = KeptValueSlot(TYPE_INT),
		proofs = UNREFINED_BINDING,
		resolved_call = None,
		resolved_definition_id = None,
		resource_dependencies = []
	}


pure func typed_global(name: String, is_mutable: Bool) -> TypedGlobalVarInfo:
	{
		decl = parsed_var(name, is_mutable),
		definition_id = None,
		binding_type = TYPE_INT,
		source_type = Some(TYPE_INT),
		value = TypedIntLiteralExpr("1", fixture_source_span(), expr_info())
	}


pure func typed_global_decl(name: String, is_mutable: Bool) -> TypedDecl:
	TypedGlobalVarDecl(typed_global(name, is_mutable))


pure func private_typed_global_decl(name: String, is_mutable: Bool) -> TypedDecl:
	TypedPrivateDecl(typed_global_decl(name, is_mutable))


pure func typed_program(decls: List[TypedDecl]) -> TypedProgram:
	{
		source = fixture_source_file(),
		decls = decls,
		diagnostics = [],
		type_definitions = [],
		type_references = []
	}


pure func reason_is_later(reason: CtfeUnavailableGlobalReason) -> Bool:
	match reason:
		CtfeLaterGlobal:
			True
		_:
			False


pure func reason_is_runtime(reason: CtfeUnavailableGlobalReason) -> Bool:
	match reason:
		CtfeRuntimeInitializedGlobal:
			True
		_:
			False


pure func unavailable_reason_is_later(result: Result[CtfeValue, CtfeEnvError]) -> Bool:
	match result:
		Err(CtfeUnavailableBinding(_, CtfeLaterGlobal)):
			True
		_:
			False


pure func unavailable_reason_is_runtime(result: Result[CtfeValue, CtfeEnvError]) -> Bool:
	match result:
		Err(CtfeUnavailableBinding(_, CtfeRuntimeInitializedGlobal)):
			True
		_:
			False


func test_global_reason_tracks_mutability() -> Bool:
	immutable_info = typed_global("A", False)
	mutable_info = typed_global("B", True)

	(
		not ctfe_global_initializer_runs_at_runtime(immutable_info)
		and ctfe_global_initializer_runs_at_runtime(mutable_info)
		and reason_is_later(ctfe_unavailable_reason_for_global(immutable_info))
		and reason_is_runtime(ctfe_unavailable_reason_for_global(mutable_info))
	)


func test_global_decl_preserves_private_flag() -> Bool:
	match ctfe_global_decl_from_typed_decl(private_typed_global_decl("HIDDEN", False)):
		Some(global_decl):
			global_decl.name == "HIDDEN" and global_decl.is_private
		None:
			False


func test_program_global_lookup_walks_private_decls() -> Bool:
	program = typed_program([
		typed_global_decl("PUBLIC", False),
		private_typed_global_decl("PRIVATE", False),
	])

	(
		ctfe_program_declares_global(program, "PUBLIC")
		and ctfe_program_declares_global(program, "PRIVATE")
		and ctfe_typed_decl_declares_global(
			private_typed_global_decl("PRIVATE", False),
			"PRIVATE",
		)
		and not ctfe_program_declares_global(program, "MISSING")
	)


func test_bind_unavailable_program_globals_sets_source_order_reasons() -> Bool:
	program = typed_program([
		typed_global_decl("EARLIER", False),
		typed_global_decl("RUNTIME", True),
	])
	env = ctfe_bind_unavailable_program_globals(CTFE_ENV_EMPTY, program)

	(
		unavailable_reason_is_later(ctfe_lookup_value(env, "EARLIER"))
		and unavailable_reason_is_runtime(ctfe_lookup_value(env, "RUNTIME"))
		and match ctfe_lookup_value(env, "MISSING"):
			Err(CtfeUnknownBinding(name)):
				name == "MISSING"
			_:
				False
	)


func test_imported_program_global_lookup_uses_module_path() -> Bool:
	imported_programs: List[CtfeImportedProgram] = [
		complete_ctfe_imported_program("dep", [typed_global_decl("VALUE", False)], []),
	]

	(
		ctfe_imported_program_declares_global(imported_programs, "dep", "VALUE")
		and not ctfe_imported_program_declares_global(imported_programs, "other", "VALUE")
		and not ctfe_imported_program_declares_global(imported_programs, "dep", "MISSING")
	)


tests: TestSuite = {
	description = "Compiler CTFE globals",
	tests = [
		("global reason tracks mutability", test_global_reason_tracks_mutability),
		("global decl preserves private flag", test_global_decl_preserves_private_flag),
		(
			"program global lookup walks private decls",
			test_program_global_lookup_walks_private_decls,
		),
		(
			"bind unavailable program globals sets source order reasons",
			test_bind_unavailable_program_globals_sets_source_order_reasons,
		),
		(
			"imported program global lookup uses module path",
			test_imported_program_global_lookup_uses_module_path,
		),
	]
}
