private pure func module_identity(canonical_path: String) -> ModuleIdentity:
	program = ParserBridge.parsed_typecheck_source_bridge_artifact(
		canonical_path + ".brp",
		canonical_path,
		"pure func value(x: Int) -> Int: x",
		False,
	).program

	match loaded_module_set(
		module_load_candidate(
			resolved_module_identity_from_resolver(canonical_path, UserModule),
			program,
		),
		[],
	):
		Ok(modules):
			loaded_module_identity(loaded_module_set_target(modules))
		Err(_):
			ANONYMOUS_IDENTITY


private pure func callable_id(identity: ModuleIdentity, value: Int) -> AcceptedCallableDefinitionId:
	accepted_callable_definition_id(identity, value)


private pure func entry(
	id: Int,
	source_func_type: SemanticType,
	canonical_func_type: SemanticType,
	purity: Purity,
	origin: FuncOrigin,
	module_path: String,
	ufcs_eligible: Bool,
) -> AcceptedCallableEntry:
	{
		definition_id = callable_id(module_identity(module_path), id),
		source_signature = {
			func_type = source_func_type,
			type_params = [],
			dim_constraints = [(SemanticNamedType("LocalDim", []), TYPE_STRING)]
		},
		canonical_signature = {
			func_type = canonical_func_type,
			type_params = [],
			dim_constraints = [(SemanticNamedType("pkg_dep__LocalDim", []), TYPE_STRING)]
		},
		param_names = [Some("value")],
		purity = purity,
		origin = origin,
		resource_args = AllowResourceArgs(ResourceResultIndependent),
		loop_producer = Some(LoopProducerIndices),
		debug_only = True,
		ufcs_eligible = ufcs_eligible
	}


private pure func unary_type(param_type: SemanticType, return_type: SemanticType) -> SemanticType:
	SemanticFunctionType(True, [param_type], return_type)


private pure func exact_entry_round_trips_all_func_symbol_metadata() -> Bool:
	value = entry(
		41,
		unary_type(TYPE_INT, TYPE_STRING),
		unary_type(TYPE_INT, TYPE_STRING),
		Pure,
		ForeignFunc,
		"pkg/ffi",
		True,
	)
	index = callable_value_index_add_exact(
		CALLABLE_VALUE_INDEX_EMPTY,
		value,
	).get_or(CALLABLE_VALUE_INDEX_EMPTY)

	match callable_value_index_find_exact(
		index,
		callable_id(module_identity("pkg/ffi"), 41),
	):
		Some(found):
			binding = accepted_callable_binding(found, found.source_signature, None)
			symbol = accepted_callable_binding_func_symbol(binding)
			overload = accepted_callable_binding_overload(binding)

			(
				accepted_callable_definition_id_value(found.definition_id) == 41
				and symbol.callable_id == 41
				and overload.def_id == 41
				and symbol.module_path.is_none()
				and types_equal(
					symbol.func_type,
					unary_type(TYPE_INT, TYPE_STRING),
				)
				and callable_value_index_find_exact(
					index,
					callable_id(module_identity("pkg/other"), 41),
				).is_none()
			)
		None:
			False


private pure func binding_round_trips_callable_policy_metadata() -> Bool:
	value = entry(
		41,
		unary_type(TYPE_INT, TYPE_STRING),
		unary_type(TYPE_INT, TYPE_STRING),
		Pure,
		ForeignFunc,
		"pkg/ffi",
		True,
	)
	symbol = accepted_callable_binding_func_symbol(
		accepted_callable_binding(
			value,
			value.source_signature,
			None,
		),
	)

	resource_policy_matches = match symbol.resource_args:
		AllowResourceArgs(ResourceResultIndependent):
			True
		_:
			False

	loop_producer_matches = match symbol.loop_producer:
		Some(LoopProducerIndices):
			True
		_:
			False

	(
		symbol.purity == Pure
		and symbol.origin == ForeignFunc
		and resource_policy_matches
		and loop_producer_matches
		and symbol.debug_only
	)


private pure func binding_round_trips_callable_shape_metadata() -> Bool:
	value = entry(
		41,
		unary_type(TYPE_INT, TYPE_STRING),
		unary_type(TYPE_INT, TYPE_STRING),
		Pure,
		ForeignFunc,
		"pkg/ffi",
		True,
	)
	symbol = accepted_callable_binding_func_symbol(
		accepted_callable_binding(
			value,
			value.source_signature,
			None,
		),
	)

	param_name_matches = match symbol.param_names.get(0):
		Some(Some(name)):
			name == "value"
		_:
			False

	symbol.param_names.length() == 1 and param_name_matches and symbol.dim_constraints.length() == 1


private pure func overload_and_ufcs_indexes_preserve_newest_first_order() -> Bool:
	first = entry(
		1,
		unary_type(TYPE_INT, TYPE_INT),
		unary_type(TYPE_INT, TYPE_INT),
		Pure,
		UserDefinedFunc,
		"pkg/math",
		True,
	)
	second = entry(
		2,
		unary_type(TYPE_STRING, TYPE_STRING),
		unary_type(TYPE_STRING, TYPE_STRING),
		Impure,
		UserDefinedFunc,
		"pkg/math",
		False,
	)
	with_first = callable_value_index_add_visible(
		CALLABLE_VALUE_INDEX_EMPTY,
		"convert",
		accepted_callable_binding(first, first.source_signature, None),
	)
	index = callable_value_index_add_visible(
		with_first,
		"convert",
		accepted_callable_binding(second, second.source_signature, None),
	)

	match (
		callable_value_index_find_visible(index, "convert"),
		callable_value_index_find_ufcs(index, "convert"),
	):
		(Some(visible), Some(ufcs)):
			(
				visible.map(
					func(
						item,
					): accepted_callable_definition_id_value(item.entry.definition_id),
				) == [2, 1]
				and ufcs.map(
					func(
						item,
					): accepted_callable_definition_id_value(item.entry.definition_id),
				) == [1]
			)
		_:
			False


private pure func module_candidates_do_not_publish_bare_names() -> Bool:
	value = entry(
		7,
		unary_type(TYPE_INT, TYPE_INT),
		unary_type(TYPE_INT, TYPE_INT),
		Pure,
		UserDefinedFunc,
		"pkg/math",
		True,
	)
	index = callable_value_index_add_module(
		CALLABLE_VALUE_INDEX_EMPTY,
		"pkg/math",
		"convert",
		accepted_callable_binding(value, value.canonical_signature, Some("pkg/math")),
	)

	(
		callable_value_index_find_visible(index, "convert").is_none()
		and callable_value_index_find_module(index, "pkg/math", "convert")
			.map(func(candidates): candidates.length() == 1)
			.get_or(False)
	)


private pure func selective_view(
	local_name: String,
	module_path: String,
	source_name: String,
) -> ModuleView:
	with_module = module_view_add_imported_module(COMPILER_MODULE_VIEW_EMPTY, module_path)

	match module_view_register_selective_name(with_module, local_name, module_path, source_name):
		SelectiveNameAdded(view):
			view
		_:
			COMPILER_MODULE_VIEW_EMPTY


private pure func qualified_view(alias_name: String, module_path: String) -> ModuleView:
	with_module = module_view_add_imported_module(COMPILER_MODULE_VIEW_EMPTY, module_path)

	match module_view_register_module_alias(with_module, alias_name, module_path):
		ModuleAliasAdded(view):
			view
		_:
			COMPILER_MODULE_VIEW_EMPTY


private pure func direct_view(module_path: String) -> ModuleView:
	qualified_view(import_default_alias(module_path), module_path)


private pure func alias_without_direct_import_view(
	alias_name: String,
	module_path: String,
) -> ModuleView:
	match module_view_register_module_alias(COMPILER_MODULE_VIEW_EMPTY, alias_name, module_path):
		ModuleAliasAdded(view):
			view
		_:
			COMPILER_MODULE_VIEW_EMPTY


private pure func qualified_lookup_uses_caller_overlay() -> Bool:
	owner = module_identity("pkg/dep")
	alias_only_identity = module_identity("app/alias_only")
	qualified_identity = module_identity("app/qualified")
	inputs: List[CallableValueProjectionInput] = [
		{
			module_identity = owner,
			module_path = "pkg/dep",
			source_name = "convert",
			visibility = PublicDeclaration,
			entry = entry(
				21,
				unary_type(TYPE_INT, TYPE_INT),
				unary_type(TYPE_INT, TYPE_INT),
				Pure,
				UserDefinedFunc,
				"pkg/dep",
				True,
			)
		},
	]
	alias_only: CallableValueProjectionModule = {
		module_identity = alias_only_identity,
		module_path = "app/alias_only",
		view = alias_without_direct_import_view("Dep", "pkg/dep")
	}
	qualified: CallableValueProjectionModule = {
		module_identity = qualified_identity,
		module_path = "app/qualified",
		view = qualified_view("Dep", "pkg/dep")
	}

	match (
		callable_value_projection_build(
			inputs,
			[alias_only, qualified],
		)
	):
		Ok(projection):
			alias_only_result = callable_value_projection_find_qualified(
				projection,
				alias_only_identity,
				alias_only.view,
				"Dep",
				"convert",
			)
			qualified_result = callable_value_projection_find_qualified(
				projection,
				qualified_identity,
				qualified.view,
				"Dep",
				"convert",
			)
			qualified_overlay_has_module_bucket = callable_value_projection_find(
				projection,
				qualified_identity,
			)
				.map(func(index): (
						callable_value_index_find_module(index, "pkg/dep", "convert")
							.map(func(candidates): candidates.length() == 1)
							.get_or(False)
						and callable_value_index_find_module_ufcs(index, "pkg/dep", "convert")
							.map(func(candidates): candidates.length() == 1)
							.get_or(False)
						and callable_value_index_find_ufcs(index, "convert").is_none()
					))
				.get_or(False)

			match (alias_only_result, qualified_result):
				(Ok(None), Ok(Some(candidates))):
					(
						candidates.map(
							func(
								item,
							): accepted_callable_definition_id_value(
								item.entry.definition_id,
							),
						) == [21]
						and candidates
							.get(0)
							.map(func(item): item.module_path == Some("pkg/dep"))
							.get_or(False)
						and qualified_overlay_has_module_bucket
					)
				_:
					False
		Err(_):
			False


private pure func projection_preserves_selective_qualified_private_and_order() -> Bool:
	app = module_identity("app/main")
	dep = module_identity("pkg/dep")
	private_dep = module_identity("pkg/private")
	transitive_dep = module_identity("pkg/transitive")
	qualified_identity = module_identity("app/qualified")
	inputs: List[CallableValueProjectionInput] = [
		{
			module_identity = dep,
			module_path = "pkg/dep",
			source_name = "convert",
			visibility = PublicDeclaration,
			entry = entry(
				10,
				unary_type(
					SemanticNamedType("LocalThing", []),
					TYPE_INT,
				),
				unary_type(
					SemanticNamedType("pkg_dep__LocalThing", []),
					TYPE_INT,
				),
				Pure,
				UserDefinedFunc,
				"pkg/dep",
				True,
			)
		},
		{
			module_identity = dep,
			module_path = "pkg/dep",
			source_name = "convert",
			visibility = PublicDeclaration,
			entry = entry(
				11,
				unary_type(TYPE_STRING, TYPE_STRING),
				unary_type(TYPE_STRING, TYPE_STRING),
				Pure,
				UserDefinedFunc,
				"pkg/dep",
				True,
			)
		},
		{
			module_identity = dep,
			module_path = "pkg/dep",
			source_name = "unselected",
			visibility = PublicDeclaration,
			entry = entry(
				14,
				unary_type(TYPE_INT, TYPE_INT),
				unary_type(TYPE_INT, TYPE_INT),
				Pure,
				UserDefinedFunc,
				"pkg/dep",
				True,
			)
		},
		{
			module_identity = private_dep,
			module_path = "pkg/private",
			source_name = "hidden",
			visibility = PrivateDeclaration,
			entry = entry(
				12,
				unary_type(TYPE_INT, TYPE_INT),
				unary_type(TYPE_INT, TYPE_INT),
				Pure,
				UserDefinedFunc,
				"pkg/private",
				True,
			)
		},
		{
			module_identity = transitive_dep,
			module_path = "pkg/transitive",
			source_name = "transitive_call",
			visibility = PublicDeclaration,
			entry = entry(
				13,
				unary_type(TYPE_INT, TYPE_INT),
				unary_type(TYPE_INT, TYPE_INT),
				Pure,
				UserDefinedFunc,
				"pkg/transitive",
				True,
			)
		},
	]
	selective: CallableValueProjectionModule = {
		module_identity = app,
		module_path = "app/main",
		view = selective_view("mapped", "pkg/dep", "convert")
	}
	qualified_module: CallableValueProjectionModule = {
		module_identity = qualified_identity,
		module_path = "app/qualified",
		view = qualified_view("Dep", "pkg/dep")
	}

	bare_identity = module_identity("app/bare")
	bare_module: CallableValueProjectionModule = {
		module_identity = bare_identity,
		module_path = "app/bare",
		view = direct_view("pkg/dep")
	}

	match (
		callable_value_projection_build(
			inputs,
			[selective, qualified_module, bare_module],
		)
	):
		Err(_):
			False
		Ok(projection):
			match callable_value_projection_find(projection, app):
				Err(_):
					False
				Ok(app_index):
					mapped = callable_value_index_find_visible(app_index, "mapped")
					qualified_result = callable_value_projection_find_qualified(
						projection,
						qualified_identity,
						qualified_module.view,
						"Dep",
						"convert",
					)

					match (mapped, qualified_result):
						(Some(mapped_candidates), Ok(Some(qualified_candidates))):
							match mapped_candidates.get(1):
								Some(imported_named_candidate):
									canonical_dim_matches = match imported_named_candidate.signature.dim_constraints.get(
										0,
									):
										Some((left, _)):
											types_equal(
												left,
												SemanticNamedType("pkg_dep__LocalDim", []),
											)
										None:
											False

									bare_visible = callable_value_projection_find(
										projection,
										bare_identity,
									)
										.map(func(bare_index): (
												callable_value_index_find_visible(
													bare_index,
													"convert",
												)
													.map(
														func(
															candidates,
														): candidates.map(
															func(
																item,
															): accepted_callable_definition_id_value(
																item.entry.definition_id,
															),
														) == [11, 10],
													)
													.get_or(False)
												and callable_value_index_find_exact(
													bare_index,
													callable_id(dep, 14),
												).is_some()
											))
										.get_or(False)
									qualified_visibility = callable_value_projection_find(
										projection,
										qualified_identity,
									)
										.map(
											func(
												index,
											): (
												callable_value_index_find_visible(
													index,
													"convert",
												).is_none()
												and callable_value_index_find_exact(
													index,
													callable_id(dep, 10),
												).is_some()
											),
										)
										.get_or(False)

									(
										mapped_candidates.map(
											func(
												item,
											): accepted_callable_definition_id_value(
												item.entry.definition_id,
											),
										) == [11, 10]
										and qualified_candidates.map(
											func(
												item,
											): accepted_callable_definition_id_value(
												item.entry.definition_id,
											),
										) == [11, 10]
										and types_equal(
											imported_named_candidate.signature.func_type,
											unary_type(
												SemanticNamedType("pkg_dep__LocalThing", []),
												TYPE_INT,
											),
										)
										and imported_named_candidate.module_path == Some("pkg/dep")
										and canonical_dim_matches
										and bare_visible
										and qualified_visibility
										and callable_value_index_find_exact(
											app_index,
											callable_id(dep, 10),
										).is_some()
										and callable_value_index_find_exact(
											app_index,
											callable_id(dep, 14),
										).is_none()
										and callable_value_index_find_exact(
											app_index,
											callable_id(private_dep, 12),
										).is_none()
										and callable_value_index_find_exact(
											app_index,
											callable_id(transitive_dep, 13),
										).is_none()
										and callable_value_projection_find_qualified(
											projection,
											qualified_identity,
											qualified_module.view,
											"Dep",
											"hidden",
										)
											.map(func(result): result.is_none())
											.get_or(False)
									)
								None:
									False
						_:
							False


private pure func unrelated_graph_callables_do_not_increase_overlay_visits() -> Bool:
	app = module_identity("app/main")
	unrelated = module_identity("pkg/unrelated")
	module: CallableValueProjectionModule = {
		module_identity = app,
		module_path = "app/main",
		view = COMPILER_MODULE_VIEW_EMPTY
	}
	local_input: CallableValueProjectionInput = {
		module_identity = app,
		module_path = "app/main",
		source_name = "local_call",
		visibility = PublicDeclaration,
		entry = entry(
			70,
			unary_type(TYPE_INT, TYPE_INT),
			unary_type(TYPE_INT, TYPE_INT),
			Pure,
			UserDefinedFunc,
			"app/main",
			True,
		)
	}
	unrelated_input: CallableValueProjectionInput = {
		module_identity = unrelated,
		module_path = "pkg/unrelated",
		source_name = "unrelated_call",
		visibility = PublicDeclaration,
		entry = entry(
			80,
			unary_type(TYPE_STRING, TYPE_STRING),
			unary_type(TYPE_STRING, TYPE_STRING),
			Pure,
			UserDefinedFunc,
			"pkg/unrelated",
			True,
		)
	}
	unrelated_input_two: CallableValueProjectionInput = {
		module_identity = unrelated,
		module_path = "pkg/unrelated",
		source_name = "unrelated_call",
		visibility = PublicDeclaration,
		entry = entry(
			81,
			unary_type(TYPE_STRING, TYPE_STRING),
			unary_type(TYPE_STRING, TYPE_STRING),
			Pure,
			UserDefinedFunc,
			"pkg/unrelated",
			True,
		)
	}
	unrelated_input_three: CallableValueProjectionInput = {
		module_identity = unrelated,
		module_path = "pkg/unrelated",
		source_name = "unrelated_call",
		visibility = PublicDeclaration,
		entry = entry(
			82,
			unary_type(TYPE_STRING, TYPE_STRING),
			unary_type(TYPE_STRING, TYPE_STRING),
			Pure,
			UserDefinedFunc,
			"pkg/unrelated",
			True,
		)
	}
	unrelated_input_four: CallableValueProjectionInput = {
		module_identity = unrelated,
		module_path = "pkg/unrelated",
		source_name = "unrelated_call",
		visibility = PublicDeclaration,
		entry = entry(
			83,
			unary_type(TYPE_STRING, TYPE_STRING),
			unary_type(TYPE_STRING, TYPE_STRING),
			Pure,
			UserDefinedFunc,
			"pkg/unrelated",
			True,
		)
	}

	match (
		(
			callable_value_projection_observe_build([local_input], [module]),
			callable_value_projection_observe_build(
				[
					local_input,
					unrelated_input,
					unrelated_input_two,
					unrelated_input_three,
					unrelated_input_four,
				],
				[module],
			),
		)
	):
		(Ok(base), Ok(expanded)):
			(
				base.canonical_input_visits == 1
				and expanded.canonical_input_visits == 5
				and base.overlay_input_visits == 1
				and expanded.overlay_input_visits == 1
			)
		_:
			False


tests: TestSuite = {
