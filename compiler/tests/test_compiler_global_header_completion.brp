	test: TestSuite


private pure func accept_empty_view(scope: PreparedModuleScope) -> BoundModuleViewBinding:
	BoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private pure func callable_graph(source: String) -> Option[CallableHeaderGraph]:
	program = ParserBridge.parsed_typecheck_source_bridge_artifact(
		"global_header_completion.brp",
		"main",
		source,
		False,
	).program
	indexed ?= indexed_graph_build(
		module_load_candidate(
			resolved_module_identity_from_resolver("main", UserModule),
			program,
		),
		[],
	).to_option()
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	types ?= type_header_graph_build(parameters).to_option()
	traits ?= trait_topology_graph_build(types).to_option()
	callable_header_graph_build(traits).to_option()


private pure func completion_graph(source: String) -> Option[TypecheckGraphCompletion]:
	program = ParserBridge.parsed_typecheck_source_bridge_artifact(
		"global_header_completion.brp",
		"main",
		source,
		False,
	).program
	indexed ?= indexed_graph_build(
		module_load_candidate(
			resolved_module_identity_from_resolver("main", UserModule),
			program,
		),
		[],
	).to_option()
	importable = importable_module_graph(indexed)
	bound ?= bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	types ?= type_header_graph_build(parameters).to_option()
	traits ?= trait_topology_graph_build(types).to_option()
	callables ?= callable_header_graph_build(traits).to_option()
	implementations ?= implementation_header_graph_build(callables).to_option()
	Some(complete_typecheck_graph(implementations, importable, False))


private pure func accepted_graph(source: String) -> Option[AcceptedTypecheckGraph]:
	completion ?= completion_graph(source)

	match completion:
		TypecheckGraphAccepted(graph):
			Some(graph)
		_:
			None


private pure func dependencies_order_forward_references() -> Option[Bool]:
	graph ?= callable_graph("first = second + 1\nsecond = 41")

	match global_header_completion_plan_build(graph):
		GlobalHeaderCompletionPlanReady(plan):
			Some(
				global_header_completion_plan_pending(
					plan,
				).map(global_header_name) == ["second", "first"],
			)
		GlobalHeaderCompletionPlanBlocked(_, _, _):
			Some(False)


pure func test_dependencies_order_forward_references() -> Bool:
	dependencies_order_forward_references().get_or(False)


private pure func completed_dependency_summary(source: String) -> Option[List[String]]:
	graph ?= accepted_graph(source)
	headers = accepted_typecheck_graph_completed_globals(graph)
	var identities_are_exact: Bool = True
	var summary: List[String] = []

	for header in headers:
		dependencies = completed_global_header_global_dependencies(header)

		for dependency in dependencies:
			if (
				not headers.any(func(candidate):
					global_ids_equal(completed_global_header_id(candidate), dependency)
				)
			):
				identities_are_exact = False

		summary = summary.append(
			global_id_name(completed_global_header_id(header)) + ":" + dependencies
				.map(global_id_name)
				.sort()
				.join(","),
		)

	if identities_are_exact:
		Some(summary.sort())
	else:
		None


private pure func acyclic_permutations_complete_identically() -> Option[Bool]:
	forward ?= completed_dependency_summary("base = 1\nmiddle = base + 1\nleaf = middle + base")
	reversed ?= completed_dependency_summary("leaf = middle + base\nmiddle = base + 1\nbase = 1")
	shuffled ?= completed_dependency_summary("middle = base + 1\nbase = 1\nleaf = middle + base")

	Some(forward == reversed and reversed == shuffled)


pure func test_acyclic_permutations_complete_identically() -> Bool:
	acyclic_permutations_complete_identically().get_or(False)


private pure func lambda_body_type_dependencies_order_headers() -> Option[Bool]:
	graph ?= callable_graph("callback = func(): later\nlater = 41")

	match global_header_completion_plan_build(graph):
		GlobalHeaderCompletionPlanReady(plan):
			Some(
				global_header_completion_plan_pending(
					plan,
				).map(global_header_name) == ["later", "callback"],
			)
		GlobalHeaderCompletionPlanBlocked(_, _, _):
			Some(False)


pure func test_lambda_body_type_dependencies_order_headers() -> Bool:
	lambda_body_type_dependencies_order_headers().get_or(False)


private pure func question_binding_is_lexically_scoped() -> Option[Bool]:
	graph ?= callable_graph("x = func(value: Int):\n\tx ?= value\n\tx")

	Some(
		match global_header_completion_plan_build(graph):
			GlobalHeaderCompletionPlanReady(plan):
				global_header_completion_plan_pending(plan).map(global_header_name) == ["x"]
			GlobalHeaderCompletionPlanBlocked(_, _, _):
				False
	)


pure func test_question_binding_is_lexically_scoped() -> Bool:
	question_binding_is_lexically_scoped().get_or(False)


private pure func assignment_targets_order_headers() -> Option[Bool]:
	graph ?= callable_graph(
		"derived = func():\n\tbase = 2\ncompound = func():\n\tbase += 1\nvar base = 1",
	)

	match global_header_completion_plan_build(graph):
		GlobalHeaderCompletionPlanReady(plan):
			ordered = global_header_completion_plan_pending(plan)
			derived ?= ordered.find(func(header): global_header_name(header) == "derived")
			compound ?= ordered.find(func(header): global_header_name(header) == "compound")

			Some(
				(
					global_header_completion_plan_dependencies(
						plan,
						global_header_id(derived),
					).map(global_id_name) == ["base"]
					and global_header_completion_plan_dependencies(
						plan,
						global_header_id(compound),
					).map(global_id_name) == ["base"]
				),
			)
		GlobalHeaderCompletionPlanBlocked(_, _, _):
			Some(False)


pure func test_assignment_targets_order_headers() -> Bool:
	assignment_targets_order_headers().get_or(False)


private pure func field_access_depends_on_its_global_receiver() -> Option[Bool]:
	graph ?= callable_graph(
		"record Box { value: Int }\nderived = base.value\nbase = { value = 41 }",
	)

	match global_header_completion_plan_build(graph):
		GlobalHeaderCompletionPlanReady(plan):
			Some(
				global_header_completion_plan_pending(
					plan,
				).map(global_header_name) == ["base", "derived"],
			)
		GlobalHeaderCompletionPlanBlocked(_, _, _):
			Some(False)


pure func test_field_access_depends_on_its_global_receiver() -> Bool:
	field_access_depends_on_its_global_receiver().get_or(False)


private pure func unannotated_cycles_are_explicit() -> Option[Bool]:
	graph ?= callable_graph("first = second\nsecond = first")

	Some(
		match global_header_completion_plan_build(graph):
			GlobalHeaderCompletionPlanBlocked(_, components, _):
				(
					components.length() == 1
					and components
						.flat_map(func(component): component)
						.length() == 2
				)
			GlobalHeaderCompletionPlanReady(_):
				False
	)


pure func test_unannotated_cycles_are_explicit() -> Bool:
	unannotated_cycles_are_explicit().get_or(False)


private pure func cycles_preserve_independent_completion_work() -> Option[Bool]:
	graph ?= callable_graph("healthy = 41\nfirst = second\nsecond = first")

	Some(
		match global_header_completion_plan_build(graph):
			GlobalHeaderCompletionPlanBlocked(plan, components, _):
				(
					global_header_completion_plan_pending(
						plan,
					).map(global_header_name) == ["healthy"]
					and components.length() == 1
					and components
						.flat_map(func(component): component)
						.length() == 2
				)
			GlobalHeaderCompletionPlanReady(_):
				False
	)


pure func test_cycles_preserve_independent_completion_work() -> Bool:
	cycles_preserve_independent_completion_work().get_or(False)


private pure func blocked_dependents_are_not_cycle_members() -> Option[Bool]:
	graph ?= callable_graph("dependent = first\nfirst = second\nsecond = first")

	Some(
		match global_header_completion_plan_build(graph):
			GlobalHeaderCompletionPlanBlocked(_, components, blocked):
				(
					components
						.flat_map(func(component): component)
						.map(global_id_name)
						.sort() == ["first", "second"]
					and blocked.map(global_id_name) == ["dependent"]
				)
			GlobalHeaderCompletionPlanReady(_):
				False
	)


pure func test_blocked_dependents_are_not_cycle_members() -> Bool:
	blocked_dependents_are_not_cycle_members().get_or(False)


private pure func disjoint_cycles_remain_distinct_components() -> Option[Bool]:
	graph ?= callable_graph("a = b\nb = a\nc = d\nd = c")

	Some(
		match global_header_completion_plan_build(graph):
			GlobalHeaderCompletionPlanBlocked(_, components, blocked):
				components.map(func(component):
					component
						.map(global_id_name)
						.sort()
						.join(",")
				) == ["a,b", "c,d"] and blocked.is_empty()
			GlobalHeaderCompletionPlanReady(_):
				False
	)


pure func test_disjoint_cycles_remain_distinct_components() -> Bool:
	disjoint_cycles_remain_distinct_components().get_or(False)


private pure func cycle_source(global_count: Int) -> String:
	var declarations: List[String] = []

	for index in 0..global_count:
		next_index = (index + 1) % global_count
		declarations = declarations.append(
			"global_${index.to_string()} = global_${next_index.to_string()}",
		)

	declarations.join("\n")


private pure func large_cycle_is_classified_without_recursive_search() -> Option[Bool]:
	global_count: Int = 256
	graph ?= callable_graph(cycle_source(global_count))

	Some(
		match global_header_completion_plan_build(graph):
			GlobalHeaderCompletionPlanBlocked(_, components, blocked):
				(
					components.length() == 1
					and components
						.get_or(0, [])
						.length() == global_count
					and blocked.is_empty()
				)
			GlobalHeaderCompletionPlanReady(_):
				False
	)


pure func test_large_cycle_is_classified_without_recursive_search() -> Bool:
	large_cycle_is_classified_without_recursive_search().get_or(False)


private pure func reverse_chain_source(global_count: Int) -> String:
	var declarations: List[String] = []

	for index in 0..global_count:
		value = if index + 1 == global_count:
			"1"
		else:
			"global_${(index + 1).to_string()}"

		declarations = declarations.append("global_${index.to_string()} = ${value}")

	declarations.join("\n")


private pure func large_reverse_chain_uses_dependency_order() -> Option[Bool]:
	global_count: Int = 256
	graph ?= callable_graph(reverse_chain_source(global_count))

	Some(
		match global_header_completion_plan_build(graph):
			GlobalHeaderCompletionPlanReady(plan):
				ordered = global_header_completion_plan_pending(plan)

				(
					ordered.length() == global_count
					and ordered
						.get(0)
						.map(global_header_name) == Some("global_${(global_count - 1).to_string()}")
				)
			GlobalHeaderCompletionPlanBlocked(_, _, _):
				False
	)


pure func test_large_reverse_chain_uses_dependency_order() -> Bool:
	large_reverse_chain_uses_dependency_order().get_or(False)


private pure func failed_completion_is_recoverable_not_accepted() -> Option[Bool]:
	completion ?= completion_graph("first = second\nsecond = first")

	Some(
		match completion:
			TypecheckGraphRecoverable(_):
				True
			_:
				False
	)


pure func test_failed_completion_is_recoverable_not_accepted() -> Bool:
	failed_completion_is_recoverable_not_accepted().get_or(False)


private pure func repeated_diagnostics_preserve_distinct_spans() -> Option[Bool]:
	completion ?= completion_graph("first = missing\nsecond = missing")

	Some(
		match completion:
			TypecheckGraphRecoverable(graph):
				diagnostics = recoverable_typecheck_graph_diagnostics(graph)
				diagnostics.length() == 2 and diagnostics.all(func(diagnostic):
					diagnostic.span.is_some()
				)
			_:
				False
	)


pure func test_repeated_diagnostics_preserve_distinct_spans() -> Bool:
	repeated_diagnostics_preserve_distinct_spans().get_or(False)


pure func test_empty_completion_graph_releases_context() -> Bool:
	accepted_graph("pure func answer() -> Int: 1").is_some()


pure func test_single_completed_global_releases() -> Bool:
	accepted_graph("value = 1").is_some()


private pure func accepted_graph_checks_each_initializer_once() -> Option[Bool]:
	graph ?= accepted_graph(
		"base = 40\npure func first() -> Int: base + 1\npure func second() -> Int: base + 2",
	)
	metrics = accepted_typecheck_graph_global_completion_metrics(graph)

	Some(metrics.initializer_checks == 1 and metrics.duplicate_initializer_requests == 0)


pure func test_accepted_graph_checks_each_initializer_once() -> Bool:
	accepted_graph_checks_each_initializer_once().get_or(False)


private pure func completed_headers_preserve_annotation_origin() -> Option[Bool]:
	graph ?= accepted_graph("annotated: Int = 41\ninferred = annotated + 1")
	headers = accepted_typecheck_graph_completed_globals(graph)
	annotated ?= headers.find(func(header):
		global_id_name(completed_global_header_id(header)) == "annotated"
	)
	inferred ?= headers.find(func(header):
		global_id_name(completed_global_header_id(header)) == "inferred"
	)

	Some(
		match (annotated, inferred):
			(CompletedAnnotatedGlobalHeader(_, _, _, _, _, _), CompletedInferredGlobalHeader(_, _, _, _, _, _)):
				(
					types_equal(completed_global_header_canonical_binding_type(annotated), TYPE_INT)
					and types_equal(
						completed_global_header_canonical_binding_type(inferred),
						TYPE_INT,
					)
				)
			_:
				False
	)


pure func test_completed_headers_preserve_annotation_origin() -> Bool:
	completed_headers_preserve_annotation_origin().get_or(False)


private pure func completed_headers_retain_exact_dependencies() -> Option[Bool]:
	graph ?= accepted_graph("pure func answer() -> Int: 1\nbase = 41\nderived = base + answer()")
	headers = accepted_typecheck_graph_completed_globals(graph)
	derived ?= headers.find(func(header):
		global_id_name(completed_global_header_id(header)) == "derived"
	)

	Some(
		(
			headers.length() == 2
			and completed_global_header_global_dependencies(derived).map(global_id_name) == ["base"]
			and completed_global_header_callable_dependencies(derived).length() == 1
		),
	)


pure func test_completed_headers_retain_exact_dependencies() -> Bool:
	completed_headers_retain_exact_dependencies().get_or(False)


private pure func completed_dependencies_distinguish_lambda_captures_and_calls() -> Option[Bool]:
	graph ?= accepted_graph(
		"pure func answer() -> Int: 1\nlater = 41\ndeferred = func(): later + answer()",
	)
	headers = accepted_typecheck_graph_completed_globals(graph)
	deferred ?= headers.find(func(header):
		global_id_name(completed_global_header_id(header)) == "deferred"
	)
	Some(
		(
			completed_global_header_global_dependencies(deferred).map(global_id_name) == ["later"]
			and completed_global_header_callable_dependencies(deferred).is_empty()
		),
	)


pure func test_completed_dependencies_distinguish_lambda_captures_and_calls() -> Bool:
	completed_dependencies_distinguish_lambda_captures_and_calls().get_or(False)


tests: TestSuite = {
	description = "Compiler global header completion",
	tests = [
		("orders forward dependencies", test_dependencies_order_forward_references),
		(
			"completes acyclic source permutations identically",
			test_acyclic_permutations_complete_identically,
		),
		("orders lambda body type dependencies", test_lambda_body_type_dependencies_order_headers),
		("scopes question bindings lexically", test_question_binding_is_lexically_scoped),
		("orders assignment-target dependencies", test_assignment_targets_order_headers),
		(
			"field access depends on its global receiver",
			test_field_access_depends_on_its_global_receiver,
		),
		("represents unannotated cycles explicitly", test_unannotated_cycles_are_explicit),
		(
			"cycles preserve independent completion work",
			test_cycles_preserve_independent_completion_work,
		),
		("separates blocked dependents from cycles", test_blocked_dependents_are_not_cycle_members),
		("keeps disjoint cycles separate", test_disjoint_cycles_remain_distinct_components),
		(
			"classifies a large cycle without recursive search",
			test_large_cycle_is_classified_without_recursive_search,
		),
		("orders a large reverse dependency chain", test_large_reverse_chain_uses_dependency_order),
		("failed completion is recoverable", test_failed_completion_is_recoverable_not_accepted),
		(
			"preserves repeated diagnostics at distinct spans",
			test_repeated_diagnostics_preserve_distinct_spans,
		),
		("empty graph releases prepared context", test_empty_completion_graph_releases_context),
		("single completed global releases", test_single_completed_global_releases),
		(
			"checks each initializer once across body consumers",
			test_accepted_graph_checks_each_initializer_once,
		),
		(
			"preserves annotated and inferred origins",
			test_completed_headers_preserve_annotation_origin,
		),
		(
			"retains exact global and callable dependencies",
			test_completed_headers_retain_exact_dependencies,
		),
		(
			"retains lambda captures but excludes deferred calls",
			test_completed_dependencies_distinguish_lambda_captures_and_calls,
		),
	]
}
