	../src/stage_06_typecheck/headers/trait_headers: trait_topology_graph_build
	../src/stage_06_typecheck/headers/type_header_dependencies: type_alias_dependency_graph_validate
	../src/stage_06_typecheck/headers/type_header_graph: type_header_graph_build
	../src/stage_06_typecheck/headers/type_parameter_headers: resolved_type_parameter_graph_build
	../src/stage_06_typecheck/modules/bound_module_graph:
		BoundModuleViewBinding(BoundModuleViewReady),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
