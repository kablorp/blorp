		completed_global_header_id,
		recoverable_typecheck_graph_diagnostics,
	../src/stage_06_typecheck/graph/indexed_graph:
		PreparedModuleScope,
		indexed_graph_build,
		prepared_module_program,
		prepared_module_scope_module,
	../src/stage_06_typecheck/headers/callable_headers:
		CallableHeaderGraph,
		callable_header_graph_build,
