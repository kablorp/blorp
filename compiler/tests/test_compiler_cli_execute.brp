import:
	../src/stage_03_parse/parser_bridge as ParserBridge
	../src/stage_03_parse/source_ast_finalize: FinalizedTypecheckProgram
	../src/stage_12_cli/execute: execute_check_plan
	../src/stage_12_cli/plan:
		CliFrontendGraphSource,
		CliFrontendImportEdge,
		CliFrontendModuleGraph,
		CliFrontendModuleOrigin(CliFrontendUserModule),
	../src/stage_12_cli/typecheck: typecheck_frontend_root_only
	test: TestSuite


private pure func typecheck_program_fixture(
	path: String,
	module_name: String,
	source: String,
) -> FinalizedTypecheckProgram:
	ParserBridge.parsed_typecheck_source_bridge_artifact(path, module_name, source, False).program


private pure func graph_source(
	path: String,
	module_name: String,
	source: String,
) -> CliFrontendGraphSource:
	{
		path = path,
		module_name = module_name,
		source_text = source,
		typecheck_program = typecheck_program_fixture(path, module_name, source),
		origin = CliFrontendUserModule
	}


private pure func import_edge(
	root: CliFrontendGraphSource,
	dependency: CliFrontendGraphSource,
) -> CliFrontendImportEdge:
	{
		from_path = root.path,
		from_module = root.module_name,
		import_path = dependency.module_name,
		resolved_path = Some(dependency.path),
		resolved_module = Some(dependency.module_name),
		resolved_origin = Some(dependency.origin)
	}


private pure func frontend_graph(
	roots: List[CliFrontendGraphSource],
	modules: List[CliFrontendGraphSource],
	import_edges: List[CliFrontendImportEdge],
) -> CliFrontendModuleGraph:
	{
		context = {
			std_dir = None,
			source_packages = [],
			package_roots = []
		},
		roots = roots,
		modules = modules,
		import_edges = import_edges,
		diagnostics = []
	}


pure func test_check_visits_all_roots_and_reports_shared_dependency_once() -> Bool:
	first_root = graph_source(
		"/project/first.brp",
		"first",
		"import:\n\tshared: broken\n\npure func first() -> Int: broken()",
	)
	second_root = graph_source(
		"/project/second.brp",
		"second",
		"import:\n\tshared: broken\n\npure func second() -> Int: broken()",
	)
	dependency = graph_source(
		"/project/shared.brp",
		"shared",
		"pure func broken() -> Int: missing_shared_value",
	)
	graph = frontend_graph(
		[first_root, second_root],
		[dependency],
		[import_edge(first_root, dependency), import_edge(second_root, dependency)],
	)
	result = execute_check_plan({
		args = [],
		graph = graph,
		options = {
			debug = False,
			dump_ast = False,
			dump_typed_ast = False,
			capture_typecheck_request = None,
			no_format = True,
			std_dir = None,
			paths = [first_root.path, second_root.path]
		},
	})

	(
		result.status == 1
		and result.stdout.contains("Checking /project/first.brp")
		and result.stdout.contains("Checking /project/second.brp")
		and result.stderr.count("missing_shared_value") == 1
	)


pure func test_check_root_only_returns_no_dependency_artifacts() -> Bool:
	root = graph_source(
		"/project/main.brp",
		"main",
		"import:\n\tdep: helper\n\nfunc main() -> Int: helper()",
	)
	dependency = graph_source("/project/dep.brp", "dep", "pure func helper() -> Int: 1")
	graph = frontend_graph([root], [dependency], [import_edge(root, dependency)])

	typechecked = typecheck_frontend_root_only(graph, root, False)
	typechecked.modules.length() == 0


tests: TestSuite = {
	description = "Blorp CLI check execution",
	tests = [
		(
			"check visits all roots and reports a shared dependency once",
			test_check_visits_all_roots_and_reports_shared_dependency_once,
		),
		(
			"check root only returns no dependency artifacts",
			test_check_root_only_returns_no_dependency_artifacts,
		),
	]
}
