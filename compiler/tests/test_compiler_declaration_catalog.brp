	test: TestSuite


private pure func catalog_fixture() -> Option[CompilerTypecheckPhaseProfileFixture]:
	config: CompilerMixedTypeHeaderBenchmarkConfig = {
		iterations = 1,
		module_count = 1,
		shapes_per_module = 1,
		probes_per_module = 1,
		import_fanout = 0,
		retain_parsed_programs = False
	}
	compiler_mixed_type_header_phase_profile_fixture(config).to_option()


private pure func first_constructor_id_in_type_header(
	union_header: TypeHeader,
) -> Option[ConstructorId]:
	match union_header.shape:
		UnionTypeHeader(_, variants):
			match variants.get(0):
				Some(variant):
					Some(variant.id)
				None:
					None
		_:
			None


private pure func catalog_build_projects_every_accepted_category() -> Option[Bool]:
	fixture ?= catalog_fixture()
	accepted_graph = compiler_typecheck_phase_profile_fixture_accepted_graph(fixture)
	implementation_headers = accepted_typecheck_graph_implementation_headers(accepted_graph)
	completed_globals = accepted_typecheck_graph_completed_global_graph(accepted_graph)
	result = accepted_declaration_catalog_build(accepted_graph)

	Some(
		match result:
			Ok(catalog):
				catalog_projection_matches_fixture(
					catalog,
					compiler_typecheck_phase_profile_fixture_type_headers(fixture),
					implementation_headers,
					completed_globals,
				).get_or(False)
			Err(_):
				False
	)


private pure func catalog_projection_matches_fixture(
	catalog: AcceptedDeclarationCatalog,
	type_headers: TypeHeaderGraph,
	implementation_headers: ImplementationHeaderGraph,
	completed_globals: CompletedGlobalHeaderGraph,
) -> Option[Bool]:
	metrics = accepted_declaration_catalog_metrics(catalog)
	type_header ?= type_header_graph_headers(type_headers).get(0)
	union_header ?= type_header_graph_headers(type_headers).find(func(header):
		match header.shape:
			UnionTypeHeader(_, _):
				True
			_:
				False
	)
	constructor_id ?= first_constructor_id_in_type_header(union_header)
	callable_graph = implementation_header_graph_callable_headers(implementation_headers)
	callable ?= callable_header_graph_callables(callable_graph).get(0)
	global ?= completed_global_header_graph_headers(completed_globals).get(0)
	trait_graph = callable_header_graph_trait_topology(callable_graph)
	trait_header ?= trait_topology_graph_headers(trait_graph).get(0)
	trait_method ?= trait_topology_header_methods(trait_header).get(0)
	implementation ?= implementation_header_graph_headers(implementation_headers).get(0)
	implementation_method ?= implementation_header_methods(implementation).get(0)
	type_header_entries = type_header_graph_headers(type_headers)
	callable_header_entries = callable_header_graph_callables(callable_graph)
	global_header_entries = completed_global_header_graph_headers(completed_globals)
	trait_header_entries = trait_topology_graph_headers(trait_graph)
	implementation_header_entries = implementation_header_graph_headers(implementation_headers)
	var expected_constructor_entries: Int = 0
	var expected_trait_method_entries: Int = 0
	var expected_implementation_method_entries: Int = 0

	for header in type_header_entries:
		match header.shape:
			UnionTypeHeader(_, variants):
				expected_constructor_entries += variants.length()
			_:
				void

	for header in trait_header_entries:
		expected_trait_method_entries += trait_topology_header_methods(header).length()

	for header in implementation_header_entries:
		expected_implementation_method_entries += implementation_header_methods(header).length()

	var all_catalog_entries_resolve: Bool = True

	for entry in accepted_declaration_catalog_type_entries(catalog):
		all_catalog_entries_resolve = (
			all_catalog_entries_resolve
			and accepted_declaration_catalog_find_type(catalog, entry.id).is_some()
		)

	for entry in accepted_declaration_catalog_constructor_entries(catalog):
		all_catalog_entries_resolve = (
			all_catalog_entries_resolve
			and accepted_declaration_catalog_find_constructor(catalog, entry.id).is_some()
		)

	for entry in accepted_declaration_catalog_callable_entries(catalog):
		all_catalog_entries_resolve = (
			all_catalog_entries_resolve
			and accepted_declaration_catalog_find_callable(catalog, entry.id).is_some()
		)

	for entry in accepted_declaration_catalog_global_entries(catalog):
		all_catalog_entries_resolve = (
			all_catalog_entries_resolve
			and accepted_declaration_catalog_find_global(catalog, entry.id).is_some()
		)

	for entry in accepted_declaration_catalog_trait_entries(catalog):
		all_catalog_entries_resolve = (
			all_catalog_entries_resolve
			and accepted_declaration_catalog_find_trait(catalog, entry.id).is_some()
		)

	for entry in accepted_declaration_catalog_trait_method_entries(catalog):
		all_catalog_entries_resolve = (
			all_catalog_entries_resolve
			and accepted_declaration_catalog_find_trait_method(catalog, entry.id).is_some()
		)

	for entry in accepted_declaration_catalog_implementation_entries(catalog):
		all_catalog_entries_resolve = (
			all_catalog_entries_resolve
			and accepted_declaration_catalog_find_implementation(catalog, entry.id).is_some()
		)

	for entry in accepted_declaration_catalog_implementation_method_entries(catalog):
		all_catalog_entries_resolve = (
			all_catalog_entries_resolve
			and accepted_declaration_catalog_find_implementation_method(
				catalog,
				entry.owner,
				entry.id,
			).is_some()
		)

	Some((
			metrics.type_entries == type_header_entries.length()
			and metrics.constructor_entries == expected_constructor_entries
			and metrics.callable_entries == callable_header_entries.length()
			and metrics.global_entries == global_header_entries.length()
			and metrics.trait_entries == trait_header_entries.length()
			and metrics.trait_method_entries == expected_trait_method_entries
			and metrics.implementation_entries == implementation_header_entries.length()
			and metrics.implementation_method_entries == expected_implementation_method_entries
			and all_catalog_entries_resolve
			and metrics.total_entries == metrics.type_entries + metrics.constructor_entries + metrics.callable_entries + metrics.global_entries + metrics.trait_entries + metrics.trait_method_entries + metrics.implementation_entries + metrics.implementation_method_entries
			and metrics.builder_visits == metrics.total_entries
			and metrics.duplicate_checks == metrics.builder_visits
			and metrics.checksum != 0
			and accepted_declaration_catalog_find_type(catalog, type_header.id)
				.map(func(entry): type_ids_equal(entry.id, type_header.id))
				.get_or(False)
			and accepted_declaration_catalog_find_constructor(catalog, constructor_id)
				.map(func(entry): constructor_ids_equal(entry.id, constructor_id))
				.get_or(False)
			and accepted_declaration_catalog_find_callable(catalog, callable_header_id(callable))
				.map(func(entry): callable_ids_equal(entry.id, callable_header_id(callable)))
				.get_or(False)
			and accepted_declaration_catalog_find_global(
				catalog,
				completed_global_header_id(global),
			)
				.map(func(entry): global_ids_equal(entry.id, completed_global_header_id(global)))
				.get_or(False)
			and accepted_declaration_catalog_find_trait(
				catalog,
				trait_topology_header_id(trait_header),
			)
				.map(func(entry): trait_ids_equal(entry.id, trait_topology_header_id(trait_header)))
				.get_or(False)
			and accepted_declaration_catalog_find_trait_method(
				catalog,
				trait_method_slot_id(trait_method),
			)
				.map(
					func(
						entry,
					): trait_method_ids_equal(entry.id, trait_method_slot_id(trait_method)),
				)
				.get_or(False)
			and accepted_declaration_catalog_find_implementation(
				catalog,
				implementation_header_id(implementation),
			)
				.map(
					func(
						entry,
					): impl_ids_equal(entry.id, implementation_header_id(implementation)),
				)
				.get_or(False)
			and accepted_declaration_catalog_find_implementation_method(
				catalog,
				implementation_header_id(implementation),
				implementation_method_header_id(implementation_method),
			)
				.map(func(entry):
					(
						impl_ids_equal(entry.owner, implementation_header_id(implementation))
						and callable_ids_equal(
							entry.id,
							implementation_method_header_id(implementation_method),
						)
					)
				)
				.get_or(False)
		))


func test_catalog_build_projects_every_accepted_category() -> Bool:
	catalog_build_projects_every_accepted_category().get_or(False)


tests: TestSuite = {
	description = "Compiler declaration catalog",
	tests = [
		(
			"catalog build projects every accepted category",
			test_catalog_build_projects_every_accepted_category,
		),
	]
}
