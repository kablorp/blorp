private pure func identity(name: String) -> ModuleIdentity:
	module_identity_for_compiler_surface(name)


private record AcceptedAuthorityFixture {
	bound_graph: BoundModuleGraph,
	type_headers: TypeHeaderGraph,
	trait_topology: TraitTopologyGraph,
	implementation_headers: ImplementationHeaderGraph
}


private pure func fixture_candidate_named(
	module_name: String,
	source: String,
) -> ModuleLoadCandidate:
	module_load_candidate(
		resolved_module_identity_from_resolver(module_name, UserModule),
		ParserBridge.parsed_typecheck_source_bridge_artifact(
			module_name + ".brp",
			module_name,
			source,
			False,
		).program,
	)


private pure func fixture_candidate(source: String) -> ModuleLoadCandidate:
	fixture_candidate_named("main", source)


private pure func accept_empty_view(scope: PreparedModuleScope) -> BoundModuleViewBinding:
	BoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private AUTHORITY_FIXTURE_SOURCE: String =
	|trait Base:
	|	pure func base(value: Self) -> Int
	|
	|trait Renderable: Base:
	|	pure func render(value: Self) -> Int
	|
	|record First {value: Int}
	|record Second {value: Int}
	|
	|implements Renderable for First:
	|	pure func base(value: First) -> Int: value.value
	|	pure func render(value: First) -> Int: value.value
	|
	|implements Renderable for Second:
	|	pure func base(value: Second) -> Int: value.value
	|	pure func render(value: Second) -> Int: value.value


private pure func authority_fixture_from_source(
	source: String,
	dependencies: List[ModuleLoadCandidate],
	module_paths: List[String],
) -> Option[AcceptedAuthorityFixture]:
	indexed ?= indexed_graph_build(fixture_candidate(source), dependencies).to_option()
	bound ?= bound_module_graph_build(indexed, module_paths, accept_empty_view).to_option()
	skeletons ?= declaration_skeleton_graph_build(bound).to_option()
	aliases ?= type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= type_header_graph_build(parameters).to_option()
	topology ?= trait_topology_graph_build(type_headers).to_option()
	callables ?= callable_header_graph_build(topology).to_option()
	implementations ?= implementation_header_graph_build(callables).to_option()
	Some({
		bound_graph = bound,
		type_headers = type_headers,
		trait_topology = topology,
		implementation_headers = implementations,
	})


private pure func authority_fixture_with_dependencies(
	dependencies: List[ModuleLoadCandidate],
) -> Option[AcceptedAuthorityFixture]:
	authority_fixture_from_source(AUTHORITY_FIXTURE_SOURCE, dependencies, [])


private pure func authority_fixture() -> Option[AcceptedAuthorityFixture]:
	authority_fixture_with_dependencies([])


private pure func trait_entry(
	module_name: String,
	definition_id: Int,
	name: String,
	visibility: AcceptedAuthorityVisibility,
	method_names: List[String],
) -> AcceptedTraitAuthorityEntry:
	trait_identity = accepted_trait_identity(identity(module_name), definition_id, name)
	var methods: List[AcceptedTraitMethodAuthorityEntry] = []
	var method_index: Int = 0

	for method_name in method_names:
		methods = methods.append({
			identity = accepted_trait_method_identity(trait_identity, method_index, method_name),
			signature = trait_method_sig(
				method_name,
				[SemanticNamedType("Self", [])],
				TYPE_INT,
				True,
			),
		})
		method_index += 1

	{
		identity = trait_identity,
		definition = trait_def(
			definition_id,
			name,
			[],
			methods.map(func(method): method.signature),
		),
		canonical_definition = trait_def(
			definition_id,
			name,
			[],
			methods.map(func(method): method.signature),
		),
		visibility = visibility,
		supertraits = [],
		methods = methods,
		canonical_methods = methods
	}


private pure func trait_index() -> Option[TraitAuthorityIndex]:
	local = trait_entry("main", 10, "LocalTrait", AcceptedPrivateDeclaration, ["local_method"])
	remote = trait_entry(
		"dep",
		20,
		"RemoteTrait",
		AcceptedPublicDeclaration,
		["first", "second"],
	)
	private_remote = trait_entry("dep", 21, "HiddenTrait", AcceptedPrivateDeclaration, ["hidden"])

	trait_authority_index_build(
		identity("main"),
		[local, remote, private_remote],
		[("LocalTrait", local.identity), ("ImportedTrait", remote.identity)],
		[("Dep", identity("dep"))],
		[
			("local_method", accepted_trait_method_identity(local.identity, 0, "local_method")),
			("first", accepted_trait_method_identity(remote.identity, 0, "first")),
			("second", accepted_trait_method_identity(remote.identity, 1, "second")),
		],
		[
			("first", accepted_trait_method_identity(remote.identity, 0, "first")),
			("second", accepted_trait_method_identity(remote.identity, 1, "second")),
		],
	).to_option()


pure func test_trait_authority_preserves_exact_source_and_qualified_visibility() -> Bool:
	match trait_index():
		None:
			False
		Some(index):
			local = accepted_trait_identity(identity("main"), 10, "LocalTrait")
			remote = accepted_trait_identity(identity("dep"), 20, "RemoteTrait")
			hidden = accepted_trait_identity(identity("dep"), 21, "HiddenTrait")

			(
				trait_authority_index_find_exact(index, local).is_some()
				and trait_authority_index_find_exact(index, remote).is_some()
				and trait_authority_index_find_exact(index, hidden).is_none()
				and match trait_authority_index_find_source(index, "ImportedTrait"):
					AcceptedTraitFound(found):
						found.identity.definition_id == 20
					_:
						False
				and match trait_authority_index_find_qualified(index, "Dep", "RemoteTrait"):
					AcceptedTraitFound(found):
						found.identity.definition_id == 20
					_:
						False
				and match trait_authority_index_find_qualified(index, "Dep", "HiddenTrait"):
					AcceptedTraitNotFound:
						True
					_:
						False
			)


pure func test_trait_authority_keeps_method_and_ufcs_order_separate() -> Bool:
	match trait_index():
		None:
			False
		Some(index):
			methods = trait_authority_index_method_candidates(index, "first")
			ufcs = trait_authority_index_ufcs_candidates(index, "second")

			match (methods.get(0), ufcs.get(0)):
				(Some(first), Some(second)):
					(
						methods.length() == 1
						and ufcs.length() == 1
						and first.identity.name == "first"
						and second.identity.name == "second"
						and trait_authority_index_find_method_exact(index, first.identity).is_some()
					)
				_:
					False


pure func test_trait_authority_preserves_source_ambiguity_order() -> Bool:
	first = trait_entry("first", 1, "Shared", AcceptedPublicDeclaration, [])
	second = trait_entry("second", 2, "Shared", AcceptedPublicDeclaration, [])

	match (
		trait_authority_index_build(
			identity("main"),
			[first, second],
			[("Shared", first.identity), ("Shared", second.identity)],
			[],
			[],
			[],
		)
	):
		Err(_):
			False
		Ok(index):
			match trait_authority_index_find_source(index, "Shared"):
				AcceptedTraitAmbiguous(entries):
					(
						entries.length() == 2
						and entries
							.get(0)
							.map(func(entry): entry.identity.definition_id) == Some(1)
						and entries
							.get(1)
							.map(func(entry): entry.identity.definition_id) == Some(2)
					)
				_:
					False


private pure func implementation_entry(
	module_name: String,
	definition_id: Int,
	trait_identity: AcceptedTraitIdentity,
	visibility: AcceptedAuthorityVisibility,
	receiver_name: String,
) -> AcceptedImplementationAuthorityEntry:
	implementation_identity = accepted_implementation_identity(
		identity(module_name),
		definition_id,
		trait_identity.name,
	)
	method_info = impl_method_info(
		"render",
		None,
		SemanticFunctionType(True, [SemanticNamedType(receiver_name, [])], TYPE_INT),
		[],
		[Some("value")],
		Pure,
		RejectResourceArgs,
		[],
		False,
	)
	method: AcceptedImplementationMethodAuthorityEntry = {
		identity = accepted_implementation_method_identity(
			implementation_identity,
			identity(module_name),
			definition_id + 100,
			"render",
		),
		info = method_info
	}
	instance: ImplInstance = impl_instance_with_methods(
		definition_id,
		trait_identity.name,
		SemanticNamedType(receiver_name, []),
		[],
		[method_info],
		False,
	)

	{
		identity = implementation_identity,
		trait_identity = trait_identity,
		definition = instance,
		canonical_definition = instance,
		receiver_head = AcceptedDeclaredReceiverHead,
		visibility = visibility,
		methods = [method],
		canonical_methods = [method]
	}


private pure func implementation_index() -> Option[ImplementationAuthorityIndex]:
	trait_identity = accepted_trait_identity(identity("traits"), 5, "Renderable")
	first = implementation_entry("dep", 30, trait_identity, AcceptedPublicDeclaration, "First")
	second = implementation_entry("main", 31, trait_identity, AcceptedPrivateDeclaration, "Second")
	hidden = implementation_entry("dep", 32, trait_identity, AcceptedPrivateDeclaration, "Hidden")

	implementation_authority_index_build(
		identity("main"),
		[first, second, hidden],
	).to_option()


pure func test_implementation_authority_preserves_candidate_order_and_privacy() -> Bool:
	match implementation_index():
		None:
			False
		Some(index):
			trait_identity = accepted_trait_identity(identity("traits"), 5, "Renderable")
			first_identity = accepted_implementation_identity(identity("dep"), 30, "Renderable")
			first_method_identity = accepted_implementation_method_identity(
				first_identity,
				identity("dep"),
				130,
				"render",
			)
			candidates = implementation_authority_index_candidates(
				index,
				trait_identity,
				AcceptedDeclaredReceiverHead,
			)

			match (candidates.get(0), candidates.get(1)):
				(Some(first), Some(second)):
					(
						candidates.length() == 2
						and first.identity.definition_id == 30
						and second.identity.definition_id == 31
						and types_equal(
							first.definition.for_type,
							SemanticNamedType("First", []),
						)
						and types_equal(
							second.definition.for_type,
							SemanticNamedType("Second", []),
						)
						and implementation_authority_index_find_exact(
							index,
							accepted_implementation_identity(identity("dep"), 32, "Renderable"),
						).is_none()
						and implementation_authority_index_find_exact(
							index,
							accepted_implementation_identity(identity("dep"), 30, "WrongTrait"),
						).is_none()
						and implementation_authority_index_find_method_exact(
							index,
							first_method_identity,
						).is_some()
						and implementation_authority_index_find_method_exact(
							index,
							{ first_method_identity |
								callable_module_identity = identity("main")
							},
						).is_none()
						and implementation_authority_index_find_method_exact(
							index,
							{ first_method_identity | name = "wrong" },
						).is_none()
					)
				_:
					False


pure func test_authority_selects_local_and_canonical_semantic_payloads() -> Bool:
	owner = identity("dep")
	importer = identity("main")
	trait_identity = accepted_trait_identity(owner, 40, "PayloadTrait")
	trait_method_identity = accepted_trait_method_identity(trait_identity, 0, "convert")
	local_trait_method: AcceptedTraitMethodAuthorityEntry = {
		identity = trait_method_identity,
		signature = trait_method_sig(
			"convert",
			[SemanticNamedType("Payload", [])],
			SemanticNamedType("Payload", []),
			True,
		)
	}
	canonical_trait_method: AcceptedTraitMethodAuthorityEntry = {
		identity = trait_method_identity,
		signature = trait_method_sig(
			"convert",
			[SemanticNamedType("dep.Payload", [])],
			SemanticNamedType("dep.Payload", []),
			True,
		)
	}
	trait_entry: AcceptedTraitAuthorityEntry = {
		identity = trait_identity,
		definition = trait_def(40, "PayloadTrait", [], [local_trait_method.signature]),
		canonical_definition = trait_def(
			40,
			"PayloadTrait",
			[],
			[canonical_trait_method.signature],
		),
		visibility = AcceptedPublicDeclaration,
		supertraits = [],
		methods = [local_trait_method],
		canonical_methods = [canonical_trait_method]
	}
	implementation_identity = accepted_implementation_identity(owner, 50, "PayloadTrait")
	implementation_method_identity = accepted_implementation_method_identity(
		implementation_identity,
		owner,
		150,
		"convert",
	)
	local_impl_method = impl_method_info(
		"convert",
		None,
		SemanticFunctionType(
			True,
			[SemanticNamedType("Payload", [])],
			SemanticNamedType("Payload", []),
		),
		[],
		[Some("value")],
		Pure,
		RejectResourceArgs,
		[(SemanticNamedType("Payload", []), TYPE_INT)],
		False,
	)
	canonical_impl_method = impl_method_info(
		"convert",
		None,
		SemanticFunctionType(
			True,
			[SemanticNamedType("dep.Payload", [])],
			SemanticNamedType("dep.Payload", []),
		),
		[],
		[Some("value")],
		Pure,
		RejectResourceArgs,
		[(SemanticNamedType("dep.Payload", []), TYPE_INT)],
		False,
	)
	local_impl_method_entry: AcceptedImplementationMethodAuthorityEntry = {
		identity = implementation_method_identity,
		info = local_impl_method
	}
	canonical_impl_method_entry: AcceptedImplementationMethodAuthorityEntry = {
		identity = implementation_method_identity,
		info = canonical_impl_method
	}
	implementation_entry: AcceptedImplementationAuthorityEntry = {
		identity = implementation_identity,
		trait_identity = trait_identity,
		definition = impl_instance_with_methods(
			50,
			"PayloadTrait",
			SemanticNamedType("Payload", []),
			[],
			[local_impl_method],
			False,
		),
		canonical_definition = impl_instance_with_methods(
			50,
			"PayloadTrait",
			SemanticNamedType("dep.Payload", []),
			[],
			[canonical_impl_method],
			False,
		),
		receiver_head = AcceptedDeclaredReceiverHead,
		visibility = AcceptedPublicDeclaration,
		methods = [local_impl_method_entry],
		canonical_methods = [canonical_impl_method_entry]
	}

	match (
		trait_authority_index_build(owner, [trait_entry], [], [], [], []),
		trait_authority_index_build(importer, [trait_entry], [], [], [], []),
		implementation_authority_index_build(owner, [implementation_entry]),
		implementation_authority_index_build(importer, [implementation_entry]),
	):
		(Ok(local_traits), Ok(imported_traits), Ok(local_impls), Ok(imported_impls)):
			match (
				trait_authority_index_find_method_exact(local_traits, trait_method_identity),
				trait_authority_index_find_method_exact(imported_traits, trait_method_identity),
				implementation_authority_index_find_exact(local_impls, implementation_identity),
				implementation_authority_index_find_exact(
					imported_impls,
					implementation_identity,
				),
			):
				(Some(local_trait), Some(imported_trait), Some(local_impl), Some(imported_impl)):
					match (
						implementation_authority_index_find_method_exact(
							local_impls,
							implementation_method_identity,
						),
						implementation_authority_index_find_method_exact(
							imported_impls,
							implementation_method_identity,
						),
					):
						(Some(local_method), Some(imported_method)):
							match (
								local_trait.signature.params.get(0),
								imported_trait.signature.params.get(0),
								local_method.info.dim_constraints.get(0),
								imported_method.info.dim_constraints.get(0),
							):
								(Some(local_param), Some(imported_param), Some(local_dim), Some(imported_dim)):
									types_equal(
										local_param,
										SemanticNamedType("Payload", []),
									) and types_equal(
										imported_param,
										SemanticNamedType("dep.Payload", []),
									) and types_equal(
										local_impl.definition.for_type,
										SemanticNamedType("Payload", []),
									) and types_equal(
										imported_impl.definition.for_type,
										SemanticNamedType("dep.Payload", []),
									) and types_equal(
										local_dim[0],
										SemanticNamedType("Payload", []),
									) and types_equal(
										imported_dim[0],
										SemanticNamedType("dep.Payload", []),
									)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


private pure func prepared_trait_entries(
	topology: TraitTopologyGraph,
) -> List[AcceptedTraitAuthorityEntry]:
	var entries: List[AcceptedTraitAuthorityEntry] = []

	for header in trait_topology_graph_headers(topology):
		identity = trait_authority_identity_from_header_id(trait_topology_header_id(header))
		var methods: List[AcceptedTraitMethodAuthorityEntry] = []

		for slot in trait_topology_header_methods(header):
			method_name = trait_method_slot_name(slot)
			source = trait_method_slot_source(slot)
			methods = methods.append({
				identity = trait_authority_method_identity_from_header_id(
					trait_method_slot_id(slot),
				),
				signature = trait_method_sig_with_details(
					method_name,
					[SemanticNamedType("Self", [])],
					TYPE_INT,
					True,
					source.body.is_some(),
					[],
				),
			})

		entries = entries.append({
			identity = identity,
			definition = trait_def(
				identity.definition_id,
				identity.name,
				trait_topology_header_supertraits(header).map(trait_id_name),
				methods.map(func(method): method.signature),
			),
			canonical_definition = trait_def(
				identity.definition_id,
				identity.name,
				trait_topology_header_supertraits(header).map(trait_id_name),
				methods.map(func(method): method.signature),
			),
			visibility = accepted_authority_visibility_from_header(
				trait_topology_header_visibility(header),
			),
			supertraits = trait_topology_header_supertraits(
				header,
			).map(trait_authority_identity_from_header_id),
			methods = methods,
			canonical_methods = methods,
		})

	entries


private pure func prepared_implementation_entries(
	graph: ImplementationHeaderGraph,
) -> List[AcceptedImplementationAuthorityEntry]:
	var entries: List[AcceptedImplementationAuthorityEntry] = []

	for header in implementation_header_graph_headers(graph):
		identity = implementation_authority_identity_from_header_id(
			implementation_header_id(header),
		)
		trait_identity = trait_authority_identity_from_header_id(
			implementation_header_trait_id(header),
		)
		var methods: List[AcceptedImplementationMethodAuthorityEntry] = []

		for method in implementation_header_methods(header):
			if explicit_implementation_method_source(method).is_some():
				method_id = implementation_header_id(header)
				callable_id = implementation_method_header_id(method)
				method_name = implementation_authority_method_identity_from_header_id(
					method_id,
					callable_id,
				).name
				methods = methods.append({
					identity = implementation_authority_method_identity_from_header_id(
						method_id,
						callable_id,
					),
					info = impl_method_info(
						method_name,
						None,
						SemanticFunctionType(True, [SemanticNamedType("Self", [])], TYPE_INT),
						[],
						[Some("value")],
						Pure,
						RejectResourceArgs,
						[],
						False,
					),
				})

		entries = entries.append({
			identity = identity,
			trait_identity = trait_identity,
			definition = impl_instance_with_methods(
				identity.definition_id,
				trait_identity.name,
				SemanticNamedType("Receiver", []),
				[],
				methods.map(func(method): method.info),
				False,
			),
			canonical_definition = impl_instance_with_methods(
				identity.definition_id,
				trait_identity.name,
				SemanticNamedType("Receiver", []),
				[],
				methods.map(func(method): method.info),
				False,
			),
			receiver_head = accepted_implementation_receiver_head_from_header(
				implementation_header_receiver_head(header),
			),
			visibility = accepted_authority_visibility_from_header(
				implementation_header_visibility(header),
			),
			methods = methods,
			canonical_methods = methods,
		})

	entries


pure func test_projection_validates_headers_and_preserves_implementation_order() -> Bool:
	match authority_fixture():
		None:
			False
		Some(fixture):
			trait_entries = prepared_trait_entries(fixture.trait_topology)
			implementation_entries = prepared_implementation_entries(fixture.implementation_headers)

			match (
				trait_authority_projection_build(
					fixture.trait_topology,
					fixture.bound_graph,
					trait_entries,
				),
				implementation_authority_projection_build(
					fixture.implementation_headers,
					fixture.bound_graph,
					implementation_entries,
				),
			):
				(Ok(trait_projection), Ok(implementation_projection)):
					owner = bound_module_identity(bound_module_graph_target(fixture.bound_graph))

					match (
						trait_authority_projection_find(trait_projection, owner),
						implementation_authority_projection_find(
							implementation_projection,
							owner,
						),
					):
						(Some(trait_index), Some(implementation_index)):
							match trait_authority_index_find_source(trait_index, "Renderable"):
								AcceptedTraitFound(renderable):
									candidates = implementation_authority_index_candidates(
										implementation_index,
										renderable.identity,
										AcceptedDeclaredReceiverHead,
									)

									(
										candidates.length() == 2
										and candidates
											.get(0)
											.map(
												func(
													entry,
												): entry.identity.definition_id,
											) == implementation_entries
											.get(0)
											.map(func(entry): entry.identity.definition_id)
										and candidates
											.get(1)
											.map(
												func(
													entry,
												): entry.identity.definition_id,
											) == implementation_entries
											.get(1)
											.map(func(entry): entry.identity.definition_id)
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_projection_keeps_default_methods_in_trait_authority_only() -> Bool:
	source: String =
		|trait Renderable:
		|	pure func render(value: Self) -> Int
		|	pure func fallback(value: Self) -> Int: 7
		|record Value {value: Int}
		|implements Renderable for Value:
		|	pure func render(value: Value) -> Int: value.value

	match authority_fixture_from_source(source, [], []):
		None:
			False
		Some(fixture):
			trait_entries = prepared_trait_entries(fixture.trait_topology)
			implementation_entries = prepared_implementation_entries(fixture.implementation_headers)
			header_method_count = implementation_header_graph_headers(
				fixture.implementation_headers,
			)
				.get(0)
				.map(func(header): implementation_header_methods(header).length())
			trait_entry = trait_entries.find(func(entry): entry.identity.name == "Renderable")
			implementation_entry = implementation_entries.get(0)

			match (
				trait_entry,
				implementation_entry,
				trait_authority_projection_build(
					fixture.trait_topology,
					fixture.bound_graph,
					trait_entries,
				),
				implementation_authority_projection_build(
					fixture.implementation_headers,
					fixture.bound_graph,
					implementation_entries,
				),
			):
				(Some(trait_authority_entry), Some(impl_authority_entry), Ok(_), Ok(_)):
					fallback = trait_authority_entry.methods.find(
						func(method): method.identity.name == "fallback",
					)

					(
						header_method_count == Some(2)
						and fallback.map(func(method): method.signature.has_default) == Some(True)
						and impl_authority_entry.methods.length() == 1
						and impl_authority_entry.methods
							.get(0)
							.map(func(method): method.identity.name) == Some("render")
					)
				_:
					False


pure func test_preparation_preserves_local_metadata_and_builds_canonical_payloads() -> Bool:
	source: String =
		|record Payload {value: Int}
		|trait Transformer:
		|	pure func transform(value: Payload) -> Payload
		|	pure func fallback(value: Payload) -> Payload: value
		|implements Transformer for Payload:
		|	pure func transform(value: Payload) -> Payload: value

	match authority_fixture_from_source(source, [], []):
		None:
			False
		Some(fixture):
			owner = bound_module_graph_target(fixture.bound_graph)
			trait_header = trait_topology_graph_headers(
				fixture.trait_topology,
			).find(
				func(header): trait_id_name(trait_topology_header_id(header)) == "Transformer",
			)
			implementation_header = implementation_header_graph_headers(
				fixture.implementation_headers,
			).get(0)

			match (trait_header, implementation_header):
				(Some(header), Some(impl_header)):
					payload_type = SemanticNamedType("Payload", [])
					canonical_payload_type = SemanticNamedType(
						canonical_module_type_name(bound_module_canonical_path(owner), "Payload"),
						[],
					)
					local_trait = trait_def_with_details(
						trait_id_definition_id(trait_topology_header_id(header)),
						"Transformer",
						[],
						[],
						[
							trait_method_sig_with_details(
								"transform",
								[payload_type],
								payload_type,
								True,
								False,
								[Some("value")],
							),
							trait_method_sig_with_details(
								"fallback",
								[payload_type],
								payload_type,
								True,
								True,
								[Some("value")],
							),
						],
						Some("owner-local"),
					)
					explicit_method = implementation_header_methods(
						impl_header,
					).find(
						func(method): explicit_implementation_method_source(method).is_some(),
					)

					match explicit_method:
						None:
							False
						Some(method_header):
							callable_id = implementation_method_header_id(method_header)
							local_method = impl_method_info(
								"transform",
								Some({
									callable_id = callable_id_definition_id(callable_id),
									module_path = "owner-local",
								}),
								SemanticFunctionType(True, [payload_type], payload_type),
								[],
								[Some("value")],
								Pure,
								RejectResourceArgs,
								[],
								False,
							)
							local_implementation = impl_instance_with_methods(
								impl_id_definition_id(implementation_header_id(impl_header)),
								"Transformer",
								payload_type,
								[],
								[local_method],
								False,
							)
							mismatched_method = { local_method | target = Some({
									callable_id = callable_id_definition_id(callable_id) + 1,
									module_path = "owner-local",
								}) }
							mismatched_implementation = impl_instance_with_methods(
								impl_id_definition_id(implementation_header_id(impl_header)),
								"Transformer",
								payload_type,
								[],
								[mismatched_method],
								False,
							)

							prepared_trait = prepare_trait_authority_entry(
								fixture.type_headers,
								{
									accepted_header = header,
									owner_module = owner,
									definition = local_trait
								},
							)
							prepared_impl = prepare_implementation_authority_entry(
								fixture.type_headers,
								{
									accepted_header = impl_header,
									owner_module = owner,
									definition = local_implementation
								},
							)
							mismatched_prepared_impl = prepare_implementation_authority_entry(
								fixture.type_headers,
								{
									accepted_header = impl_header,
									owner_module = owner,
									definition = mismatched_implementation
								},
							)

							match (prepared_trait, prepared_impl):
								(Ok(trait_entry), Ok(impl_entry)):
									local_trait_method = trait_entry.methods.get(0)
									canonical_trait_method = trait_entry.canonical_methods.get(0)
									default_trait_method = trait_entry.canonical_methods.get(1)
									local_impl_method = impl_entry.methods.get(0)
									canonical_impl_method = impl_entry.canonical_methods.get(0)

									match (
										local_trait_method,
										canonical_trait_method,
										default_trait_method,
										local_impl_method,
									):
										(Some(local_trait_method), Some(canonical_trait_method), Some(default_trait_method), Some(local_impl_method)):
											local_trait_param = local_trait_method.signature.params.get(
												0,
											)
											canonical_trait_param = canonical_trait_method.signature.params.get(
												0,
											)

											match canonical_impl_method:
												None:
													False
												Some(canonical_impl_method):
													match (
														local_trait_param,
														canonical_trait_param,
														local_impl_method.info.func_type,
														canonical_impl_method.info.func_type,
													):
														(Some(local_param), Some(canonical_param), SemanticFunctionType(_, local_params, local_return), SemanticFunctionType(_, canonical_params, canonical_return)):
															match (
																local_impl_method.info.target,
																canonical_impl_method.info.target,
															):
																(Some(local_target), Some(canonical_target)):
																	(
																		types_equal(
																			local_param,
																			payload_type,
																		)
																		and types_equal(
																			canonical_param,
																			canonical_payload_type,
																		)
																		and default_trait_method.signature.has_default
																		and impl_entry.methods.length() == 1
																		and types_equal(
																			impl_entry.definition.for_type,
																			payload_type,
																		)
																		and types_equal(
																			impl_entry.canonical_definition.for_type,
																			canonical_payload_type,
																		)
																		and local_params
																			.get(0)
																			.map(
																				func(
																					typ,
																				): types_equal(
																					typ,
																					payload_type,
																				),
																			) == Some(True)
																		and types_equal(
																			local_return,
																			payload_type,
																		)
																		and canonical_params
																			.get(0)
																			.map(
																				func(
																					typ,
																				): types_equal(
																					typ,
																					canonical_payload_type,
																				),
																			) == Some(True)
																		and types_equal(
																			canonical_return,
																			canonical_payload_type,
																		)
																		and local_target.callable_id == canonical_target.callable_id
																		and local_target.module_path == "owner-local"
																		and canonical_target.module_path == bound_module_canonical_path(
																			owner,
																		)
																		and local_impl_method.info.resource_args == RejectResourceArgs
																		and canonical_impl_method.info.resource_args == RejectResourceArgs
																		and local_impl_method.info.param_names == canonical_impl_method.info.param_names
																		and mismatched_prepared_impl.is_err()
																	)
																_:
																	False
														_:
															False
										_:
											False
								_:
									False
				_:
					False


pure func test_projection_overlay_visits_ignore_unrelated_graph_entries() -> Bool:
	unrelated_source: String =
		|trait UnrelatedOne:
		|	pure func unrelated_one(value: Self) -> Int
		|trait UnrelatedTwo:
		|	pure func unrelated_two(value: Self) -> Int
		|trait UnrelatedThree:
		|	pure func unrelated_three(value: Self) -> Int
		|trait UnrelatedFour:
		|	pure func unrelated_four(value: Self) -> Int
		|
		|record UnrelatedOneValue {value: Int}
		|record UnrelatedTwoValue {value: Int}
		|record UnrelatedThreeValue {value: Int}
		|record UnrelatedFourValue {value: Int}
		|
		|implements UnrelatedOne for UnrelatedOneValue:
		|	pure func unrelated_one(value: UnrelatedOneValue) -> Int: value.value
		|implements UnrelatedTwo for UnrelatedTwoValue:
		|	pure func unrelated_two(value: UnrelatedTwoValue) -> Int: value.value
		|implements UnrelatedThree for UnrelatedThreeValue:
		|	pure func unrelated_three(value: UnrelatedThreeValue) -> Int: value.value
		|implements UnrelatedFour for UnrelatedFourValue:
		|	pure func unrelated_four(value: UnrelatedFourValue) -> Int: value.value

	match (
		(
			authority_fixture(),
			authority_fixture_from_source(
				"import:\n\tmiddle\n\n" + AUTHORITY_FIXTURE_SOURCE,
				[
					fixture_candidate_named("middle", "import:\n\tunrelated\n"),
					fixture_candidate_named("unrelated", unrelated_source),
				],
				["middle", "unrelated"],
			),
		)
	):
		(Some(baseline), Some(expanded)):
			baseline_traits = prepared_trait_entries(baseline.trait_topology)
			expanded_traits = prepared_trait_entries(expanded.trait_topology)
			baseline_impls = prepared_implementation_entries(baseline.implementation_headers)
			expanded_impls = prepared_implementation_entries(expanded.implementation_headers)

			match (
				trait_authority_projection_build_observed(
					baseline.trait_topology,
					baseline.bound_graph,
					baseline_traits,
				),
				trait_authority_projection_build_observed(
					expanded.trait_topology,
					expanded.bound_graph,
					expanded_traits,
				),
				implementation_authority_projection_build_observed(
					baseline.implementation_headers,
					baseline.bound_graph,
					baseline_impls,
				),
				implementation_authority_projection_build_observed(
					expanded.implementation_headers,
					expanded.bound_graph,
					expanded_impls,
				),
			):
				(Ok(baseline_trait_build), Ok(expanded_trait_build), Ok(baseline_impl_build), Ok(expanded_impl_build)):
					baseline_target = bound_module_identity(
						bound_module_graph_target(baseline.bound_graph),
					)
					expanded_target = bound_module_identity(
						bound_module_graph_target(expanded.bound_graph),
					)

					match (
						trait_authority_projection_observation_for_module(
							baseline_trait_build[1],
							baseline_target,
						),
						trait_authority_projection_observation_for_module(
							expanded_trait_build[1],
							expanded_target,
						),
						implementation_authority_projection_observation_for_module(
							baseline_impl_build[1],
							baseline_target,
						),
						implementation_authority_projection_observation_for_module(
							expanded_impl_build[1],
							expanded_target,
						),
					):
						(Some(baseline_trait), Some(expanded_trait), Some(baseline_impl), Some(expanded_impl)):
							(
								expanded_trait_build[1].grouped_entry_count == baseline_trait_build[1].grouped_entry_count + 4
								and expanded_impl_build[1].grouped_entry_count == baseline_impl_build[1].grouped_entry_count + 4
								and expanded_trait.bucket_entry_visits == baseline_trait.bucket_entry_visits
								and expanded_trait.supertrait_closure_entry_visits == baseline_trait.supertrait_closure_entry_visits
								and expanded_trait.visible_entry_count == baseline_trait.visible_entry_count
								and expanded_impl.bucket_entry_visits == baseline_impl.bucket_entry_visits
								and expanded_impl.visible_entry_count == baseline_impl.visible_entry_count
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_projection_construction_visits_scale_linearly_with_local_declarations() -> Bool:
	small_source: String =
		|trait Alpha:
		|	pure func alpha(value: Self) -> Int
		|record AlphaValue {value: Int}
		|implements Alpha for AlphaValue:
		|	pure func alpha(value: AlphaValue) -> Int: value.value
	large_source: String =
		|trait Alpha:
		|	pure func alpha(value: Self) -> Int
		|trait Beta:
		|	pure func beta(value: Self) -> Int
		|trait Gamma:
		|	pure func gamma(value: Self) -> Int
		|trait Delta:
		|	pure func delta(value: Self) -> Int
		|
		|record AlphaValue {value: Int}
		|record BetaValue {value: Int}
		|record GammaValue {value: Int}
		|record DeltaValue {value: Int}
		|
		|implements Alpha for AlphaValue:
		|	pure func alpha(value: AlphaValue) -> Int: value.value
		|implements Beta for BetaValue:
		|	pure func beta(value: BetaValue) -> Int: value.value
		|implements Gamma for GammaValue:
		|	pure func gamma(value: GammaValue) -> Int: value.value
		|implements Delta for DeltaValue:
		|	pure func delta(value: DeltaValue) -> Int: value.value

	match (
		authority_fixture_from_source(small_source, [], []),
		authority_fixture_from_source(large_source, [], []),
	):
		(Some(small), Some(large)):
			small_traits = prepared_trait_entries(small.trait_topology)
			large_traits = prepared_trait_entries(large.trait_topology)
			small_impls = prepared_implementation_entries(small.implementation_headers)
			large_impls = prepared_implementation_entries(large.implementation_headers)

			match (
				trait_authority_projection_build_observed(
					small.trait_topology,
					small.bound_graph,
					small_traits,
				),
				trait_authority_projection_build_observed(
					large.trait_topology,
					large.bound_graph,
					large_traits,
				),
				implementation_authority_projection_build_observed(
					small.implementation_headers,
					small.bound_graph,
					small_impls,
				),
				implementation_authority_projection_build_observed(
					large.implementation_headers,
					large.bound_graph,
					large_impls,
				),
			):
				(Ok(small_trait_build), Ok(large_trait_build), Ok(small_impl_build), Ok(large_impl_build)):
					small_owner = bound_module_identity(
						bound_module_graph_target(small.bound_graph),
					)
					large_owner = bound_module_identity(
						bound_module_graph_target(large.bound_graph),
					)

					match (
						trait_authority_projection_observation_for_module(
							small_trait_build[1],
							small_owner,
						),
						trait_authority_projection_observation_for_module(
							large_trait_build[1],
							large_owner,
						),
						implementation_authority_projection_observation_for_module(
							small_impl_build[1],
							small_owner,
						),
						implementation_authority_projection_observation_for_module(
							large_impl_build[1],
							large_owner,
						),
					):
						(Some(small_trait), Some(large_trait), Some(small_impl), Some(large_impl)):
							(
								large_trait_build[1].grouped_entry_count == small_trait_build[1].grouped_entry_count * 4
								and large_trait.bucket_entry_visits == small_trait.bucket_entry_visits * 4
								and large_trait.supertrait_closure_entry_visits == small_trait.supertrait_closure_entry_visits * 4
								and large_trait.visible_entry_count == small_trait.visible_entry_count * 4
								and large_trait.method_binding_count == small_trait.method_binding_count * 4
								and large_trait.ufcs_binding_count == small_trait.ufcs_binding_count * 4
								and large_trait.authority_index_item_visits == small_trait.authority_index_item_visits * 4
								and large_impl_build[1].grouped_entry_count == small_impl_build[1].grouped_entry_count * 4
								and large_impl.bucket_entry_visits == small_impl.bucket_entry_visits * 4
								and large_impl.visible_entry_count == small_impl.visible_entry_count * 4
								and large_impl.method_entry_count == small_impl.method_entry_count * 4
								and large_impl.authority_index_item_visits == small_impl.authority_index_item_visits * 4
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_projection_rejects_prepared_entry_reordering() -> Bool:
	match authority_fixture():
		None:
			False
		Some(fixture):
			entries = prepared_trait_entries(fixture.trait_topology)

			match trait_authority_projection_build(
				fixture.trait_topology,
				fixture.bound_graph,
