				Ok(_):
					False


pure func test_projection_rejects_implementation_trait_mismatch() -> Bool:
	match authority_fixture():
		None:
			False
		Some(fixture):
			entries = prepared_implementation_entries(fixture.implementation_headers)

			match entries.get(0):
				None:
					False
				Some(first):
					wrong_trait = { first.trait_identity | name = "WrongTrait" }
					malformed = entries.set(0, { first | trait_identity = wrong_trait })

					match implementation_authority_projection_build(
						fixture.implementation_headers,
						fixture.bound_graph,
						malformed,
					):
						Err(errors):
							errors == [
								"accepted implementation authority entry identity or order mismatch",
							]
						Ok(_):
							False


