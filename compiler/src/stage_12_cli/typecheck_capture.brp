-- Explicit diagnostic capture for bounded typecheck replay measurements.
import:
	../pipeline: typecheck_frontend_root_request
	../stage_03_parse/parsed_ast: parsed_program_has_errors
	../stage_03_parse/source_ast_finalize: finalized_typecheck_program_ast
	../stage_06_typecheck/bridge: typecheck_graph_request_json
	fs: write_text_atomic
	plan: CliCheckPlan, CliFrontendGraphSource, CliHandledResult


private pure func capture_error(message: String) -> CliHandledResult:
	{
		status = 1,
		stdout = "",
		stderr = "cannot capture typecheck request: " + message
	}


private pure func source_has_parse_errors(source: CliFrontendGraphSource) -> Bool:
	parsed_program_has_errors(finalized_typecheck_program_ast(source.typecheck_program))


private pure func capture_has_parse_errors(plan: CliCheckPlan) -> Bool:
	plan.graph.roots
		.concat(plan.graph.modules)
		.any(source_has_parse_errors)


func capture_check_typecheck_request(plan: CliCheckPlan, path: String) -> CliHandledResult:
	if plan.options.dump_ast or plan.options.dump_typed_ast:
		capture_error("--capture-typecheck-request cannot be combined with AST dump options")
	else if plan.graph.diagnostics.length() != 0:
		capture_error("the discovered module graph has diagnostics")
	else if capture_has_parse_errors(plan):
		capture_error("one or more source files have parse errors")
	else:
		match plan.graph.roots:
			[root]:
				request = typecheck_frontend_root_request(plan.graph, root, plan.options.debug)

				match write_text_atomic(path, typecheck_graph_request_json(request).to_string()):
					Ok(_):
						{
							status = 0,
							stdout = "Captured typecheck graph request to ${path}",
							stderr = ""
						}
					Err(error):
						capture_error("cannot write `${path}`: ${error.to_string()}")
			_:
				capture_error("exactly one root is required")
