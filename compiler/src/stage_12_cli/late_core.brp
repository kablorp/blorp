-- Pure execution of the Blorp-owned late Core pipeline.
--
-- Requested observations are snapshots from the pre-DCE Core. Unless a stop
-- is requested, every path still produces prepared Core before backend
-- emission.
import:
	../stage_09_core/ir: CoreProgram, core_program_to_json
	../stage_09_core/late_invariants:
		check_definition_id_uniqueness,
		check_late_core_invariants,
		core_late_invariant_message,
	../stage_09_core/pipeline:
		PreparedCoreProgram,
		prepared_core_program_value,
		run_core_pipeline_stage,
		run_pre_dce_tail,
	../stage_09_core/pipeline_stage: CorePipelineStage(FinalStage)
	../stage_09_core/record_update: record_update_carrier_survives
	observation: CliCoreObservation
	stage_requests:
		CliLateCoreStageAction(
			ObserveAndStopLateCoreStage,
			ObserveLateCoreStage,
			StopLateCoreStage,
		),
		CliLateCoreStageRequest,


union CliLateCoreExecution:
	CliLateCoreCompleted(PreparedCoreProgram, List[CliCoreObservation])
	CliLateCoreStopped(String, String, List[CliCoreObservation])
	CliLateCoreFailed(String, String)


private pure func observes_late_stage(action: CliLateCoreStageAction) -> Bool:
	match action:
		ObserveLateCoreStage:
			True
		ObserveAndStopLateCoreStage:
			True
		StopLateCoreStage:
			False


private pure func stops_at_late_stage(action: CliLateCoreStageAction) -> Bool:
	match action:
		StopLateCoreStage:
			True
		ObserveAndStopLateCoreStage:
			True
		ObserveLateCoreStage:
			False


pure func late_core_invariant(stage: CorePipelineStage, program: CoreProgram) -> Option[String]:
	match check_late_core_invariants(stage, program):
		[violation, ..._]:
			Some(core_late_invariant_message(violation))
		[]:
			None


private pure func required_final_invariant(program: CoreProgram) -> Option[String]:
	if record_update_carrier_survives(program):
		Some("record update survived ownership normalization")
	else:
		match check_definition_id_uniqueness(program):
			[violation, ..._]:
				Some(core_late_invariant_message(violation))
			[]:
				None


pure func execute_late_core_stages(
	pre_dce_core: CoreProgram,
	observations: List[CliCoreObservation],
	stages: List[CliLateCoreStageRequest],
	check_invariants: Bool,
) -> CliLateCoreExecution:
	match stages:
		[]:
			completed: PreparedCoreProgram = run_pre_dce_tail(pre_dce_core)
			program: CoreProgram = prepared_core_program_value(completed)

			-- Keep the fast ownership and identity checks on every compile. The
			-- broader expression-tree audit remains opt-in through the CLI flag.
			final_invariant_error: Option[String] = if check_invariants:
				late_core_invariant(FinalStage, program)
			else:
				required_final_invariant(program)

			match final_invariant_error:
				Some(detail):
					CliLateCoreFailed("final", detail)
				None:
					CliLateCoreCompleted(completed, observations)
		[stage, ...remaining]:
			transformed: CoreProgram = run_core_pipeline_stage(stage.stage, pre_dce_core)

			invariant_error: Option[String] = if check_invariants:
				late_core_invariant(stage.stage, transformed)
			else:
				None

			match invariant_error:
				Some(detail):
					CliLateCoreFailed(stage.name, detail)
				None:
					rendered: String = core_program_to_json(transformed).to_string()

					updated_observations: List[CliCoreObservation] = if observes_late_stage(
						stage.action,
					):
						observations.append({
							stage_name = stage.name,
							rendered = rendered,
						})
					else:
						observations

					if stops_at_late_stage(stage.action):
						CliLateCoreStopped(stage.name, rendered, updated_observations)
					else:
						execute_late_core_stages(
							pre_dce_core,
							updated_observations,
							remaining,
							check_invariants,
						)
