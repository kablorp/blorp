-- Shared C identifier spelling used by final backend emission and symbol
-- projection. Classification belongs to callers; this module only applies C
-- spelling rules and constructs names derived from an already-classified
-- callable.
-- This includes language keywords and compiler-provided object-like macros.
-- GCC defines `linux` in non-strict C modes before processing our artifact.
private C_RESERVED_IDENTIFIERS: List[String] = [
	"auto",
	"break",
	"case",
	"char",
	"const",
	"continue",
	"default",
	"do",
	"double",
	"else",
	"enum",
	"extern",
	"float",
	"for",
	"goto",
	"if",
	"inline",
	"int",
	"long",
	"register",
	"restrict",
	"return",
	"short",
	"signed",
	"sizeof",
	"static",
	"struct",
	"switch",
	"typedef",
	"union",
	"unsigned",
	"void",
	"volatile",
	"while",
	"_Alignas",
	"_Alignof",
	"_Atomic",
	"_Bool",
	"_Complex",
	"_Generic",
	"_Imaginary",
	"_Noreturn",
	"_Static_assert",
	"_Thread_local",
	"alignas",
	"alignof",
	"bool",
	"false",
	"true",
	"nullptr",
	"static_assert",
	"thread_local",
	"typeof",
	"typeof_unqual",
	"linux",
]

private COMPILER_LOCAL_PREFIX: String = "$blorp$"

private COMPILER_LOCAL_C_PREFIX: String = "__blorp_internal_"

private ESCAPED_SOURCE_LOCAL_C_PREFIX: String = "__blorp_source_"

BUILTIN_STACK_OPTION_INT128_OPTION_C_TYPE: String = "blorp_StackOption_Int128"

BUILTIN_STACK_OPTION_UINT128_OPTION_C_TYPE: String = "blorp_StackOption_UInt128"

BUILTIN_STACK_OPTION_RANGE_OPTION_C_TYPE: String = "blorp_StackOption_Range"


pure func c_identifier(name: String) -> String:
	if C_RESERVED_IDENTIFIERS.contains(name):
		name + "_"
	else:
		name


pure func c_local_name(name: String) -> String:
	-- Later Core passes may derive a local from another compiler-owned local.
	-- Preserve that namespace even when its marker is no longer at the start.
	if name.contains(COMPILER_LOCAL_PREFIX):
		COMPILER_LOCAL_C_PREFIX + name
			.replace(COMPILER_LOCAL_PREFIX, "")
			.replace("$", "_")
	else if (
		name.starts_with(COMPILER_LOCAL_C_PREFIX)
		or name.starts_with(ESCAPED_SOURCE_LOCAL_C_PREFIX)
	):
		ESCAPED_SOURCE_LOCAL_C_PREFIX + name
			.length()
			.to_string() + "_" + name
	else:
		c_identifier(name)


pure func static_closure_name(c_name: String) -> String:
	"__sc_" + c_identifier(c_name)


pure func record_make_name(type_name: String) -> String:
	c_identifier(type_name) + "_make"


pure func record_destroy_name(type_name: String) -> String:
	c_identifier(type_name) + "_destroy"


pure func record_reuse_name(type_name: String) -> String:
	"__blorp_reuse_record_" + c_identifier(type_name)


pure func enum_to_string_name(type_name: String) -> String:
	"__blorp_enum_to_string_" + c_identifier(type_name)


pure func enum_vector_to_string_name(type_name: String) -> String:
	"blorp_vector_to_string_" + c_identifier(type_name)


pure func union_destroy_name(type_name: String) -> String:
	c_identifier(type_name) + "_destroy"


pure func union_destroy_stack_push_name(type_name: String) -> String:
	c_identifier(type_name) + "_destroy_stack_push"


pure func union_destroy_release_child_name(type_name: String) -> String:
	c_identifier(type_name) + "_destroy_release_child"


pure func union_destroy_fields_name(type_name: String) -> String:
	c_identifier(type_name) + "_destroy_fields"


pure func union_instance_name(variant_c_name: String) -> String:
	"__instance_" + c_identifier(variant_c_name)


pure func union_init_name(variant_c_name: String) -> String:
	"__init_" + c_identifier(variant_c_name)


pure func union_reuse_name(type_name: String, variant_c_name: String) -> String:
	"__blorp_reuse_" + c_identifier(type_name) + "_" + c_identifier(variant_c_name)


pure func static_child_path(parent_path: String, field_name: String) -> String:
	parent_path + "_" + c_identifier(field_name)


pure func static_list_child_path(parent_path: String, index: Int) -> String:
	parent_path + "_elem_" + index.to_string()


pure func static_tuple_child_path(parent_path: String, index: Int) -> String:
	parent_path + "_" + index.to_string()


pure func static_union_child_path(
	parent_path: String,
	constructor_name: String,
	index: Int,
) -> String:
	parent_path + "_" + c_identifier(constructor_name) + "_" + index.to_string()


pure func static_record_storage_name(path: String) -> String:
	"__blorp_static_record_" + path


pure func static_tuple_storage_name(path: String) -> String:
	"__blorp_static_tuple_" + path


pure func static_union_storage_name(path: String) -> String:
	"__blorp_static_union_" + path


pure func static_list_storage_name(path: String) -> String:
	"__blorp_static_list_" + path
