-- C renderer helpers for prepared list Core nodes.
--
-- `emit.brp` owns traversal, child expression emission, layout metadata,
-- and fresh temp seeds. This module owns the final C snippet shape and temp
-- names for prepared list operations.
private enum StoreRuntime:
	SetRawStoreRuntime
	HandoffSetOwnedStoreRuntime


enum InlineStructStoreBoxing:
	StackResultBoxing
	StructAddressBoxing


-- These payloads carry rendered C snippets and temp names. They are records
-- because Blorp structs cannot contain String fields.
record InlineGetArgs {
	list: String,
	index: String,
	temp_seed: String,
	width_bytes: String
}


record InlineStructLoadArgs {
	list_tmp: String,
	index_tmp: String,
	out_tmp: String,
	temp_seed: String,
	struct_ty: String
}


record InlineBitsLoadArgs {
	list_tmp: String,
	index_tmp: String,
	bits_tmp: String,
	width_bytes: String
}


record InlineBitsStoreArgs {
	list: String,
	index: String,
	value: String,
	temp_seed: String,
	width_bytes: String
}


record PointerStoreArgs {
	list: String,
	index: String,
	value: String
}


record InlineStructStoreArgs {
	list: String,
	index: String,
	value: String,
	boxing: InlineStructStoreBoxing,
	temp_seed: String,
	struct_ty: String
}


record PointerSwapArgs {
	list: String,
	left_index: String,
	right_index: String,
	temp_seed: String
}


record InlineBitsSwapArgs {
	list: String,
	left_index: String,
	right_index: String,
	temp_seed: String,
	width_bytes: String
}


record InlineStructSwapArgs {
	list: String,
	left_index: String,
	right_index: String,
	temp_seed: String
}


record SourceSlotHandoffArgs {
	result: String,
	out_index: String,
	source: String,
	source_index: String
}


record CopySpanUninitArgs {
	dst: String,
	dst_start: String,
	src: String,
	src_start: String,
	count: String
}


record EnsureUniqueArgs {
	list: String,
	temp_seed: String
}


record EnsureCapacityArgs {
	list: String,
	capacity: String,
	temp_seed: String
}


record ReuseAllocArgs {
	list: String,
	capacity: String
}


record ReuseAllocWithReleaseArgs {
	list: String,
	capacity: String,
	temp_seed: String
}


record ListAllocInlineArgs {
	capacity: String,
	elem_size: String
}


record ListAllocInlineStructArgs {
	capacity: String,
	struct_ty: String
}


record ListAllocWithReleaseArgs {
	alloc_expr: String,
	result_tmp: String
}


record RetainForArgs {
	list: String,
	value: String
}


record ListConstructInlineStructSetArgs {
	list: String,
	index: String,
	value: String,
	temp_seed: String,
	struct_ty: String
}


record ListConstructArgs {
	list: String,
	alloc_expr: String,
	statements: String
}


record ListConstructAppendArgs {
	list: String,
	value: String
}


record ListHandoffOpenArgs {
	source_ty: String,
	source: String,
	source_expr: String,
	capacity: String,
	capacity_expr: String,
	length: String,
	release: String,
	release_fn: String
}


record ListHandoffBeginBorrowArgs {
	result_ty: String,
	result: String,
	capacity: String,
	release: String,
	storage_mode: String,
	elem_size: String,
	out: String
}


record ListHandoffBeginReuseArgs {
	result_ty: String,
	result: String,
	source: String,
	capacity: String,
	release: String,
	storage_mode: String,
	elem_size: String,
	reuse: String,
	out: String
}


record ListHandoffBorrowSuffixArgs {
	result: String,
	out: String,
	length: String
}


record ListHandoffPrefixArgs {
	source_ty: String,
	source: String,
	source_expr: String,
	capacity_expr: String,
	length: String,
	release_fn: String,
	result_ty: String,
	result: String,
	storage_mode: String,
	elem_size: String,
	out: String,
	temp_seed: String
}


record ListHandoffReuseSuffixArgs {
	result: String,
	out: String,
	length: String,
	source: String,
	temp_seed: String
}


record ListInlineStructUnboxOpenArgs {
	list: String,
	list_expr: String,
	index: String,
	index_expr: String,
	struct_ty: String,
	out: String
}


union PreparedListOp:
	PointerGet(String, String)
	InlineCheckedGet(InlineGetArgs)
	InlineProvenGet(InlineGetArgs)
	InlineBitsLoad(InlineBitsLoadArgs)
	InlineBitsStore(InlineBitsStoreArgs)
	PointerSetRawStore(PointerStoreArgs)
	PointerHandoffSetOwnedStore(PointerStoreArgs)
	InlineStructSetRawStore(InlineStructStoreArgs)
	InlineStructHandoffSetOwnedStore(InlineStructStoreArgs)
	PointerSwap(PointerSwapArgs)
	InlineBitsSwap(InlineBitsSwapArgs)
	InlineStructSwap(InlineStructSwapArgs)
	InlineStructLoadChecked(InlineStructLoadArgs)
	InlineStructLoadProven(InlineStructLoadArgs)
	ListInlineStructUnboxListName(String)
	ListInlineStructUnboxIndexName(String)
	ListInlineStructUnboxOutName(String)
	ListInlineStructUnboxOpen(ListInlineStructUnboxOpenArgs)
	ListInlineStructUnboxClose(String)
	HandoffSetSourceSlot(SourceSlotHandoffArgs)
	CopySpanUninit(CopySpanUninitArgs)
	EnsureUnique(EnsureUniqueArgs)
	EnsureCapacity(EnsureCapacityArgs)
	ReuseAlloc(ReuseAllocArgs)
	ReuseAllocWithRelease(ReuseAllocWithReleaseArgs)
	ListAllocPointer(String)
	ListAllocInline(ListAllocInlineArgs)
	ListAllocInlineStruct(ListAllocInlineStructArgs)
	ListAllocWithRelease(ListAllocWithReleaseArgs)
	RetainFor(RetainForArgs)
	RetainForNoop
	ListConstructName(String)
	ListConstruct(ListConstructArgs)
	ListConstructInitElemRelease(String)
	ListConstructInlineStructSet(ListConstructInlineStructSetArgs)
	ListConstructSetLen(String, String)
	ListConstructAppend(ListConstructAppendArgs)
	ListConstructAppendOwned(ListConstructAppendArgs)
	ListHandoffCapacityName(String)
	ListHandoffReuseName(String)
	ListHandoffReleaseName(String)
	ListStorageModePointer
	ListStorageModeInline
	ListElementSizePointer
	ListElementSizeInlineStruct(String)
	ListElementReleaseFn
	ListElementReleaseNone
	ListHandoffBorrowPrefix(ListHandoffPrefixArgs)
	ListHandoffReusePrefix(ListHandoffPrefixArgs)
	ListHandoffBorrowSuffix(ListHandoffBorrowSuffixArgs)
	ListHandoffReuseSuffix(ListHandoffReuseSuffixArgs)


private OPEN_BRACE: String = "{"

private CLOSE_BRACE: String = "}"

private LIST_STORAGE_MODE_POINTER: String = "BLORP_LIST_STORAGE_POINTER"

private LIST_STORAGE_MODE_INLINE: String = "BLORP_LIST_STORAGE_INLINE"

private LIST_ELEMENT_SIZE_POINTER: String = "sizeof(void*)"

private LIST_ELEMENT_RELEASE_FN: String = "blorp_elem_release_fn"

private LIST_ELEMENT_RELEASE_NONE: String = "NULL"


private pure func c_block(body: String) -> String:
	OPEN_BRACE + " " + body + " " + CLOSE_BRACE


private pure func c_statement_expr(body: String) -> String:
	"(" + c_block(body) + ")"


private pure func store_runtime_fn(runtime: StoreRuntime) -> String:
	match runtime:
		SetRawStoreRuntime:
			"blorp_list_set_raw"
		HandoffSetOwnedStoreRuntime:
			"blorp_list_handoff_set_owned"


private pure func render_runtime_get(list: String, index: String) -> String:
	"blorp_list_get((blorp_List*)${list}, ${index})"


private pure func render_inline_load(
	list_tmp: String,
	index_tmp: String,
	bits_tmp: String,
	width_bytes: String,
) -> String:
	body: String = "uintptr_t ${bits_tmp} = 0; memcpy(&${bits_tmp}, (char*)${list_tmp}->data + ${index_tmp} * ${width_bytes}, ${width_bytes}); (void*)${bits_tmp};"
	c_statement_expr(body)


private pure func inline_get_list_tmp(temp_seed: String) -> String:
	"__lg_list_${temp_seed}"


private pure func inline_get_index_tmp(temp_seed: String) -> String:
	"__lg_idx_${temp_seed}"


private pure func inline_get_bits_tmp(temp_seed: String) -> String:
	"__lg_bits_${temp_seed}"


private pure func inline_struct_load_raw_tmp(temp_seed: String) -> String:
	"__lg_raw_${temp_seed}"


private pure func inline_store_list_tmp(temp_seed: String) -> String:
	"__list_store_${temp_seed}"


private pure func inline_store_index_tmp(temp_seed: String) -> String:
	"__list_store_idx_${temp_seed}"


private pure func list_swap_list_tmp(temp_seed: String) -> String:
	"__list_swap_${temp_seed}"


private pure func list_swap_left_index_tmp(temp_seed: String) -> String:
	"__list_swap_i_${temp_seed}"


private pure func list_swap_right_index_tmp(temp_seed: String) -> String:
	"__list_swap_j_${temp_seed}"


private pure func list_swap_value_tmp(temp_seed: String) -> String:
	"__list_swap_tmp_${temp_seed}"


private pure func list_swap_base_tmp(temp_seed: String) -> String:
	"__list_swap_base_${temp_seed}"


private pure func render_inline_checked_get(args: InlineGetArgs) -> String:
	list_tmp: String = inline_get_list_tmp(args.temp_seed)
	index_tmp: String = inline_get_index_tmp(args.temp_seed)
	bits_tmp: String = inline_get_bits_tmp(args.temp_seed)
	list_bind: String = "blorp_List* ${list_tmp} = (blorp_List*)${args.list};"
	index_bind: String = "long ${index_tmp} = ${args.index};"
	bounds: String = "(__builtin_expect(!${list_tmp} || ${index_tmp} < 0 || ${index_tmp} >= ${list_tmp}->len, 0) ? NULL : "
	body: String = list_bind + " " + index_bind + " " + bounds + render_inline_load(
		list_tmp,
		index_tmp,
		bits_tmp,
		args.width_bytes,
	) + ");"
	c_statement_expr(body)


private pure func render_inline_proven_get(args: InlineGetArgs) -> String:
	list_tmp: String = inline_get_list_tmp(args.temp_seed)
	index_tmp: String = inline_get_index_tmp(args.temp_seed)
	bits_tmp: String = inline_get_bits_tmp(args.temp_seed)
	list_bind: String = "blorp_List* ${list_tmp} = (blorp_List*)${args.list};"
	index_bind: String = "long ${index_tmp} = ${args.index};"
	body: String = list_bind + " " + index_bind + " " + render_inline_load(
		list_tmp,
		index_tmp,
		bits_tmp,
		args.width_bytes,
	) + ";"
	c_statement_expr(body)


private pure func render_inline_bits_load(args: InlineBitsLoadArgs) -> String:
	bits_decl: String = "uintptr_t ${args.bits_tmp} = 0;"
	copy_bits: String = "memcpy(&${args.bits_tmp}, (char*)${args.list_tmp}->data + ${args.index_tmp} " + "* ${args.width_bytes}, ${args.width_bytes});"

	bits_decl + " " + copy_bits


private pure func render_inline_bits_store(args: InlineBitsStoreArgs) -> String:
	list_tmp: String = inline_store_list_tmp(args.temp_seed)
	index_tmp: String = inline_store_index_tmp(args.temp_seed)
	bits_tmp: String = "__list_store_bits_${args.temp_seed}"
	list_bind: String = "blorp_List* ${list_tmp} = (blorp_List*)${args.list};"
	index_bind: String = "long ${index_tmp} = ${args.index};"
	bits_bind: String = "uintptr_t ${bits_tmp} = (uintptr_t)${args.value};"
	copy_bits: String = "memcpy((char*)${list_tmp}->data + ${index_tmp} * ${args.width_bytes}, " + "&${bits_tmp}, ${args.width_bytes});"

	c_statement_expr(list_bind + " " + index_bind + " " + bits_bind + " " + copy_bits)


private pure func render_pointer_store(args: PointerStoreArgs, runtime: StoreRuntime) -> String:
	runtime_fn: String = store_runtime_fn(runtime)
	"${runtime_fn}((blorp_List*)${args.list}, ${args.index}, (void*)${args.value})"


private pure func render_inline_struct_store_boxed_value(
	boxing: InlineStructStoreBoxing,
	elem_tmp: String,
	struct_ty: String,
) -> String:
	match boxing:
		StackResultBoxing:
			"blorp_box_stack_result(${elem_tmp})"
		StructAddressBoxing:
			"blorp_box_struct(&${elem_tmp}, sizeof(${struct_ty}))"


private pure func render_inline_struct_store(
	args: InlineStructStoreArgs,
	runtime: StoreRuntime,
) -> String:
	runtime_fn: String = store_runtime_fn(runtime)
	list_tmp: String = inline_store_list_tmp(args.temp_seed)
	index_tmp: String = inline_store_index_tmp(args.temp_seed)
	elem_tmp: String = "__list_elem_${args.temp_seed}"
	boxed_value: String = render_inline_struct_store_boxed_value(
		args.boxing,
		elem_tmp,
		args.struct_ty,
	)
	list_bind: String = "blorp_List* ${list_tmp} = (blorp_List*)${args.list};"
	index_bind: String = "long ${index_tmp} = ${args.index};"
	value_bind: String = "${args.struct_ty} ${elem_tmp} = ${args.value};"
	inline_condition: String = "if (${list_tmp} && ${list_tmp}->storage_mode == " + "BLORP_LIST_STORAGE_INLINE && ${list_tmp}->elem_size == (int16_t)sizeof(${args.struct_ty})) "
	inline_store: String = "blorp_list_set_raw_copy(${list_tmp}, ${index_tmp}, &${elem_tmp});"
	fallback_store: String = "${runtime_fn}((blorp_List*)${list_tmp}, ${index_tmp}, (void*)${boxed_value});"
	inline_branch: String = c_block(inline_store)
	fallback_branch: String = c_block(fallback_store)
	store: String = inline_condition + inline_branch + " else " + fallback_branch

	c_statement_expr(list_bind + " " + index_bind + " " + value_bind + " " + store)


private pure func render_ensure_unique(args: EnsureUniqueArgs) -> String:
	list_tmp: String = "__list_unique_${args.temp_seed}"
	list_bind: String = "blorp_List* ${list_tmp} = (blorp_List*)${args.list};"
	condition: String = "__builtin_expect(${list_tmp} && blorp_is_unique(${list_tmp}), 1)"
	expression: String = "(${condition} ? ${list_tmp} : blorp_list_cow(${list_tmp}));"

	c_statement_expr(list_bind + " " + expression)


private pure func render_ensure_capacity(args: EnsureCapacityArgs) -> String:
	list_tmp: String = "__list_cap_${args.temp_seed}"
	capacity_tmp: String = "__list_cap_min_${args.temp_seed}"
	list_bind: String = "blorp_List* ${list_tmp} = (blorp_List*)${args.list};"
	capacity_bind: String = "long ${capacity_tmp} = ${args.capacity};"
	condition: String = "__builtin_expect(${list_tmp} && blorp_is_unique(${list_tmp}) && ${list_tmp}->capacity >= ${capacity_tmp}, 1)"
	expression: String = "(${condition} ? ${list_tmp} : blorp_list_ensure_capacity(${list_tmp}, ${capacity_tmp}));"

	c_statement_expr(list_bind + " " + capacity_bind + " " + expression)


private pure func render_reuse_alloc_with_release(args: ReuseAllocWithReleaseArgs) -> String:
	result_tmp: String = "__lst_${args.temp_seed}"
	list_bind: String = "blorp_List* ${result_tmp} = blorp_list_reuse_alloc(${args.list}, ${args.capacity});"
	init_release: String = "blorp_list_init_elem_release(${result_tmp}, blorp_elem_release_fn);"

	c_statement_expr(list_bind + " " + init_release + " " + result_tmp + ";")


private pure func render_list_alloc_with_release(args: ListAllocWithReleaseArgs) -> String:
	list_bind: String = "blorp_List* ${args.result_tmp} = ${args.alloc_expr};"
	init_release: String = "blorp_list_init_elem_release(${args.result_tmp}, blorp_elem_release_fn);"

	c_statement_expr(list_bind + " " + init_release + " " + args.result_tmp + ";")


private RETAIN_FOR_NOOP_RENDERED: String = "((void)0)"


private pure func list_construct_statements_with_separator(statements: String) -> String:
	if statements == "":
		""
	else:
		statements + " "


private pure func render_list_construct(args: ListConstructArgs) -> String:
	statements: String = list_construct_statements_with_separator(args.statements)
	c_statement_expr("blorp_List* ${args.list} = ${args.alloc_expr}; ${statements}${args.list};")


private pure func render_list_construct_inline_struct_set(
	args: ListConstructInlineStructSetArgs,
) -> String:
	elem_tmp: String = "__lst_elem_${args.temp_seed}"
	body: String = "${args.struct_ty} ${elem_tmp} = ${args.value}; blorp_list_set_raw_copy(${args.list}, ${args.index}, &${elem_tmp});"
	c_block(body)


private pure func render_list_construct_set_len(list: String, len: String) -> String:
	"${list}->len = ${len};"


private pure func render_list_handoff_capacity_name(temp_seed: String) -> String:
	"__lh_cap_${temp_seed}"


private pure func render_list_handoff_reuse_name(temp_seed: String) -> String:
	"__lh_reuse_${temp_seed}"


private pure func render_list_handoff_release_name(temp_seed: String) -> String:
	"__lh_release_${temp_seed}"


private pure func render_list_handoff_open(args: ListHandoffOpenArgs) -> String:
	"({ " + args.source_ty + " " + args.source + " = " + args.source_expr + "; long " + args.capacity + " = " + args.capacity_expr + "; " + "long " + args.length + " = " + args.source + " ? ((blorp_List*)" + args.source + ")->len : 0L; " + "void (*" + args.release + ")(void*) = " + args.release_fn + ";"


private pure func render_list_handoff_begin_borrow(args: ListHandoffBeginBorrowArgs) -> String:
	args.result_ty + " " + args.result + " = (" + args.result_ty + ")blorp_list_handoff_begin_borrow(" + args.capacity + ", " + args.release + ", " + args.storage_mode + ", " + args.elem_size + "); long " + args.out + " = 0L;"


private pure func render_list_handoff_begin_reuse(args: ListHandoffBeginReuseArgs) -> String:
	"bool " + args.reuse + " = false; " + args.result_ty + " " + args.result + " = (" + args.result_ty + ")blorp_list_handoff_begin_reuse((blorp_List*)" + args.source + ", " + args.capacity + ", " + args.release + ", " + args.storage_mode + ", " + args.elem_size + ", &" + args.reuse + "); long " + args.out + " = 0L;"


private pure func render_list_handoff_finish_reuse(
	args: ListHandoffReuseSuffixArgs,
	reuse: String,
) -> String:
	"blorp_list_handoff_finish((blorp_List*)" + args.result + ", " + args.out + ", " + args.length + ", " + reuse + ", (blorp_List*)" + args.source + ");"


private pure func render_list_handoff_close(result: String) -> String:
	"${result}; })"


private pure func render_list_handoff_borrow_prefix(args: ListHandoffPrefixArgs) -> String:
	capacity: String = render_list_handoff_capacity_name(args.temp_seed)
	release: String = render_list_handoff_release_name(args.temp_seed)
	open_text: String = render_list_handoff_open({
		source_ty = args.source_ty,
		source = args.source,
		source_expr = args.source_expr,
		capacity = capacity,
		capacity_expr = args.capacity_expr,
		length = args.length,
		release = release,
		release_fn = args.release_fn,
	})
	begin_text: String = render_list_handoff_begin_borrow({
		result_ty = args.result_ty,
		result = args.result,
		capacity = capacity,
		release = release,
		storage_mode = args.storage_mode,
		elem_size = args.elem_size,
		out = args.out,
	})
	open_text + " " + begin_text


private pure func render_list_handoff_reuse_prefix(args: ListHandoffPrefixArgs) -> String:
	capacity: String = render_list_handoff_capacity_name(args.temp_seed)
	release: String = render_list_handoff_release_name(args.temp_seed)
	reuse: String = render_list_handoff_reuse_name(args.temp_seed)
	open_text: String = render_list_handoff_open({
		source_ty = args.source_ty,
		source = args.source,
		source_expr = args.source_expr,
		capacity = capacity,
		capacity_expr = args.capacity_expr,
		length = args.length,
		release = release,
		release_fn = args.release_fn,
	})
	begin_text: String = render_list_handoff_begin_reuse({
		result_ty = args.result_ty,
		result = args.result,
		source = args.source,
		capacity = capacity,
		release = release,
		storage_mode = args.storage_mode,
		elem_size = args.elem_size,
		reuse = reuse,
		out = args.out,
	})
	open_text + " " + begin_text


private pure func render_list_handoff_reuse_suffix(args: ListHandoffReuseSuffixArgs) -> String:
	reuse: String = render_list_handoff_reuse_name(args.temp_seed)
	render_list_handoff_finish_reuse(args, reuse) + " " + render_list_handoff_close(args.result)


private pure func render_pointer_swap_body(
	list_tmp: String,
	left_index_tmp: String,
	right_index_tmp: String,
	value_tmp: String,
) -> String:
	load_value: String = "void* ${value_tmp} = blorp_list_get(${list_tmp}, ${left_index_tmp});"
	store_left: String = "blorp_list_set_raw(${list_tmp}, ${left_index_tmp}, blorp_list_get(${list_tmp}, ${right_index_tmp}));"
	store_right: String = "blorp_list_set_raw(${list_tmp}, ${right_index_tmp}, ${value_tmp});"

	load_value + " " + store_left + " " + store_right


private pure func render_swap_expression(
	list: String,
	left_index: String,
	right_index: String,
	list_tmp: String,
	left_index_tmp: String,
	right_index_tmp: String,
	body: String,
) -> String:
	list_bind: String = "blorp_List* ${list_tmp} = (blorp_List*)${list};"
	left_index_bind: String = "long ${left_index_tmp} = ${left_index};"
	right_index_bind: String = "long ${right_index_tmp} = ${right_index};"
	swap_condition: String = "if (__builtin_expect(${list_tmp} && ${left_index_tmp} != ${right_index_tmp}, 1)) "
	swap_branch: String = c_block(body)

	c_statement_expr(
		list_bind + " " + left_index_bind + " " + right_index_bind + " " + swap_condition + swap_branch,
	)


private pure func render_pointer_swap(args: PointerSwapArgs) -> String:
	list_tmp: String = list_swap_list_tmp(args.temp_seed)
	left_index_tmp: String = list_swap_left_index_tmp(args.temp_seed)
	right_index_tmp: String = list_swap_right_index_tmp(args.temp_seed)
	value_tmp: String = list_swap_value_tmp(args.temp_seed)
	body: String = render_pointer_swap_body(list_tmp, left_index_tmp, right_index_tmp, value_tmp)

	render_swap_expression(
		args.list,
		args.left_index,
		args.right_index,
		list_tmp,
		left_index_tmp,
		right_index_tmp,
		body,
	)


private pure func render_inline_bits_swap(args: InlineBitsSwapArgs) -> String:
	base_tmp: String = list_swap_base_tmp(args.temp_seed)
	bits_tmp: String = "__list_swap_bits_${args.temp_seed}"
	list_tmp: String = list_swap_list_tmp(args.temp_seed)
	left_index_tmp: String = list_swap_left_index_tmp(args.temp_seed)
	right_index_tmp: String = list_swap_right_index_tmp(args.temp_seed)
	base_bind: String = "char* ${base_tmp} = (char*)${list_tmp}->data;"
	bits_bind: String = "uintptr_t ${bits_tmp} = 0;"
	load_bits: String = "memcpy(&${bits_tmp}, ${base_tmp} + ${left_index_tmp} * ${args.width_bytes}, ${args.width_bytes});"
	store_left: String = "memcpy(${base_tmp} + ${left_index_tmp} * ${args.width_bytes}, ${base_tmp} + ${right_index_tmp} * ${args.width_bytes}, ${args.width_bytes});"
	store_right: String = "memcpy(${base_tmp} + ${right_index_tmp} * ${args.width_bytes}, &${bits_tmp}, ${args.width_bytes});"
	body: String = base_bind + " " + bits_bind + " " + load_bits + " " + store_left + " " + store_right

	render_swap_expression(
		args.list,
		args.left_index,
		args.right_index,
		list_tmp,
		left_index_tmp,
		right_index_tmp,
		body,
	)


private pure func render_inline_struct_swap(args: InlineStructSwapArgs) -> String:
	list_tmp: String = list_swap_list_tmp(args.temp_seed)
	left_index_tmp: String = list_swap_left_index_tmp(args.temp_seed)
	right_index_tmp: String = list_swap_right_index_tmp(args.temp_seed)
	base_tmp: String = list_swap_base_tmp(args.temp_seed)
	size_tmp: String = "__list_swap_size_${args.temp_seed}"
	left_slot_tmp: String = "__list_swap_a_${args.temp_seed}"
	right_slot_tmp: String = "__list_swap_b_${args.temp_seed}"
	bytes_tmp: String = "__list_swap_bytes_${args.temp_seed}"
	value_tmp: String = list_swap_value_tmp(args.temp_seed)
	base_bind: String = "char* ${base_tmp} = (char*)${list_tmp}->data;"
	size_bind: String = "size_t ${size_tmp} = (size_t)${list_tmp}->elem_size;"
	left_slot_bind: String = "void* ${left_slot_tmp} = ${base_tmp} + ${left_index_tmp} * ${size_tmp};"
	right_slot_bind: String = "void* ${right_slot_tmp} = ${base_tmp} + ${right_index_tmp} * ${size_tmp};"
	bytes_bind: String = "unsigned char ${bytes_tmp}[${size_tmp}];"
	load_bytes: String = "memcpy(${bytes_tmp}, ${left_slot_tmp}, ${size_tmp});"
	store_left: String = "memcpy(${left_slot_tmp}, ${right_slot_tmp}, ${size_tmp});"
	store_right: String = "memcpy(${right_slot_tmp}, ${bytes_tmp}, ${size_tmp});"
	inline_body: String = base_bind + " " + size_bind + " " + left_slot_bind + " " + right_slot_bind + " " + bytes_bind + " " + load_bytes + " " + store_left + " " + store_right
	inline_branch: String = c_block(inline_body)
	fallback_body: String = render_pointer_swap_body(
		list_tmp,
		left_index_tmp,
		right_index_tmp,
		value_tmp,
	)
	fallback_branch: String = c_block(fallback_body)
	storage_check: String = "if (${list_tmp}->storage_mode == BLORP_LIST_STORAGE_INLINE) "
	body: String = storage_check + inline_branch + " else " + fallback_branch

	render_swap_expression(
		args.list,
		args.left_index,
		args.right_index,
		list_tmp,
		left_index_tmp,
		right_index_tmp,
		body,
	)


private pure func render_inline_struct_load_body_parts(
	list_tmp: String,
	index_tmp: String,
	out_tmp: String,
	raw_tmp: String,
	struct_ty: String,
) -> String:
	storage_check: String = "if (${list_tmp}->storage_mode == BLORP_LIST_STORAGE_INLINE " + "&& ${list_tmp}->elem_size == (int16_t)sizeof(${struct_ty})) "

	inline_copy: String = "memcpy(&${out_tmp}, (char*)${list_tmp}->data + ${index_tmp} " + "* sizeof(${struct_ty}), sizeof(${struct_ty}));"

	fallback_get: String = "void* ${raw_tmp} = blorp_list_get(${list_tmp}, ${index_tmp});"
	null_check: String = "if (!${raw_tmp}) "
	zero_out: String = "memset(&${out_tmp}, 0, sizeof(${struct_ty}));"
	unbox_out: String = "${out_tmp} = blorp_unbox_struct(${raw_tmp}, ${struct_ty});"
	inline_branch: String = c_block(inline_copy)
	null_branch: String = c_block(zero_out)
	unbox_branch: String = c_block(unbox_out)
	fallback_choice: String = null_check + null_branch + " else " + unbox_branch
	fallback_branch: String = c_block(fallback_get + " " + fallback_choice)

	storage_check + inline_branch + " else " + fallback_branch


private pure func render_inline_struct_load_body(args: InlineStructLoadArgs) -> String:
	render_inline_struct_load_body_parts(
		args.list_tmp,
		args.index_tmp,
		args.out_tmp,
		inline_struct_load_raw_tmp(args.temp_seed),
		args.struct_ty,
	)


private pure func render_inline_struct_checked_load(args: InlineStructLoadArgs) -> String:
	raw_tmp: String = inline_struct_load_raw_tmp(args.temp_seed)
	bounds_check: String = "if (__builtin_expect(!${args.list_tmp} || ${args.index_tmp} < 0 " + "|| ${args.index_tmp} >= ${args.list_tmp}->len, 0)) "

	zero_out: String = "memset(&${args.out_tmp}, 0, sizeof(${args.struct_ty}));"
	bounds_branch: String = c_block(zero_out)
	bounds: String = bounds_check + bounds_branch + " else "
	load_body: String = render_inline_struct_load_body_parts(
		args.list_tmp,
		args.index_tmp,
		args.out_tmp,
		raw_tmp,
		args.struct_ty,
	)

	bounds + load_body


pure func render_prepared_list_op(op: PreparedListOp) -> String:
	match op:
		PointerGet(list, index):
			render_runtime_get(list, index)
		InlineCheckedGet(args):
			render_inline_checked_get(args)
		InlineProvenGet(args):
			render_inline_proven_get(args)
		InlineBitsLoad(args):
			render_inline_bits_load(args)
		InlineBitsStore(args):
			render_inline_bits_store(args)
		PointerSetRawStore(args):
			render_pointer_store(args, SetRawStoreRuntime)
		PointerHandoffSetOwnedStore(args):
			render_pointer_store(args, HandoffSetOwnedStoreRuntime)
		InlineStructSetRawStore(args):
			render_inline_struct_store(args, SetRawStoreRuntime)
		InlineStructHandoffSetOwnedStore(args):
			render_inline_struct_store(args, HandoffSetOwnedStoreRuntime)
		PointerSwap(args):
			render_pointer_swap(args)
		InlineBitsSwap(args):
			render_inline_bits_swap(args)
		InlineStructSwap(args):
			render_inline_struct_swap(args)
		InlineStructLoadChecked(args):
			render_inline_struct_checked_load(args)
		InlineStructLoadProven(args):
			render_inline_struct_load_body(args)
		ListInlineStructUnboxListName(temp_seed):
			"__lg_list_${temp_seed}"
		ListInlineStructUnboxIndexName(temp_seed):
			"__lg_idx_${temp_seed}"
		ListInlineStructUnboxOutName(temp_seed):
			"__lg_out_${temp_seed}"
		ListInlineStructUnboxOpen(args):
			"({ blorp_List* " + args.list + " = (blorp_List*)" + args.list_expr + "; long " + args.index + " = " + args.index_expr + "; " + args.struct_ty + " " + args.out + ";"
		ListInlineStructUnboxClose(out):
			"${out}; })"
		HandoffSetSourceSlot(args):
			"blorp_list_handoff_set_source_slot((blorp_List*)${args.result}, ${args.out_index}, (blorp_List*)${args.source}, ${args.source_index})"
		CopySpanUninit(args):
			"blorp_list_copy_span_uninit((blorp_List*)${args.dst}, ${args.dst_start}, (blorp_List*)${args.src}, ${args.src_start}, ${args.count})"
		EnsureUnique(args):
			render_ensure_unique(args)
		EnsureCapacity(args):
			render_ensure_capacity(args)
		ReuseAlloc(args):
			"blorp_list_reuse_alloc(${args.list}, ${args.capacity})"
		ReuseAllocWithRelease(args):
			render_reuse_alloc_with_release(args)
		ListAllocPointer(capacity):
			"blorp_list_new(${capacity})"
		ListAllocInline(args):
			"blorp_list_new_inline(${args.capacity}, ${args.elem_size})"
		ListAllocInlineStruct(args):
			"blorp_list_new_inline(${args.capacity}, sizeof(${args.struct_ty}))"
		ListAllocWithRelease(args):
			render_list_alloc_with_release(args)
		RetainFor(args):
			"blorp_list_retain_for((blorp_List*)${args.list}, (void*)${args.value})"
		RetainForNoop:
			RETAIN_FOR_NOOP_RENDERED
		ListConstructName(temp_seed):
			"__lst_${temp_seed}"
		ListConstruct(args):
			render_list_construct(args)
		ListConstructInitElemRelease(list):
			"blorp_list_init_elem_release(${list}, blorp_elem_release_fn);"
		ListConstructInlineStructSet(args):
			render_list_construct_inline_struct_set(args)
		ListConstructSetLen(list, len):
			render_list_construct_set_len(list, len)
		ListConstructAppend(args):
			"${args.list} = blorp_list_append(${args.list}, ${args.value});"
		ListConstructAppendOwned(args):
			"${args.list} = blorp_list_append_owned(${args.list}, ${args.value});"
		ListHandoffCapacityName(temp_seed):
			render_list_handoff_capacity_name(temp_seed)
		ListHandoffReuseName(temp_seed):
			render_list_handoff_reuse_name(temp_seed)
		ListHandoffReleaseName(temp_seed):
			render_list_handoff_release_name(temp_seed)
		ListStorageModePointer:
			LIST_STORAGE_MODE_POINTER
		ListStorageModeInline:
			LIST_STORAGE_MODE_INLINE
		ListElementSizePointer:
			LIST_ELEMENT_SIZE_POINTER
		ListElementSizeInlineStruct(struct_ty):
			"sizeof(${struct_ty})"
		ListElementReleaseFn:
			LIST_ELEMENT_RELEASE_FN
		ListElementReleaseNone:
			LIST_ELEMENT_RELEASE_NONE
		ListHandoffBorrowPrefix(args):
			render_list_handoff_borrow_prefix(args)
		ListHandoffReusePrefix(args):
			render_list_handoff_reuse_prefix(args)
		ListHandoffBorrowSuffix(args):
			"blorp_list_handoff_finish((blorp_List*)" + args.result + ", " + args.out + ", " + args.length + ", false, NULL); " + render_list_handoff_close(
				args.result,
			)
		ListHandoffReuseSuffix(args):
			render_list_handoff_reuse_suffix(args)
