-- Consuming-call specialization before Perceus.
--
-- Detect safe `owned = f(owned, ...)` rewrites, clone the callee with a
-- terminal drop for the consumed parameter, and retarget the assignment call
-- to that clone. Clone identity includes name and definition id, compiled
-- match bodies are rewritten recursively, and recursive match fields become
-- owned only when every branch transfers them exactly once.
import:
	ir:
		CoreAccessor(RootAccessor, VariantFieldAccessor),
		CoreBoxedStorageValue,
		CoreCallKind(UserCall),
		CoreConstructorLengthMatch,
		CoreConstructorLengthMatchBranch,
		CoreConstructorLengthMatchCase,
		CoreConstructorLengthMatchGeq,
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreDecl(FunctionDecl, GlobalDecl, UnionDecl),
		CoreExpr(
			AssignExpr,
			BoxExpr,
			BorrowLetExpr,
			CallExpr,
			CastExpr,
			ConstructorMatchExpr,
			DropExpr,
			DupExpr,
			IfExpr,
			LetExpr,
			LiteralExpr,
			SeqExpr,
			UnboxExpr,
			UnionConstructExpr,
			VarExpr,
		),
		CoreFunction,
		CoreFunctionKind(
			BuiltinFunction,
			ClosureBodyFunction,
			ForeignFunction,
			ProgramEntrypointFunction,
			UnresolvedBuiltinFunction,
			UserFunction,
		),
		CoreGlobal,
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(
			LiteralMatchFallbackBindings,
			LiteralMatchFallbackBody,
			LiteralMatchFallbackFail,
		),
		CoreMatchBinding,
		CoreMatchBindingMode(MatchBorrowBindingMode, MatchOwnBindingMode),
		CoreParam,
		CoreProgram,
		CoreReleasePolicy(ArcReleasePolicy),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(
			BoxedResultType,
			EnumType,
			FunctionType,
			HeapRecordType,
			NamedType,
			RangeType,
			SelfType,
			StackResultType,
			TensorType,
			TupleType,
			TypeParameterType,
			UnionType,
			ValueRecordType,
			VoidType,
		),
		CoreUnionDecl,
		CoreUnionField,
		CoreUnionVariant,
		CoreVar,
		core_program_max_declared_definition_id,


private record CloneKey {
	original_name: String,
	original_def_id: Int,
	arg_index: Int
}


private record CloneCandidate {
	key: CloneKey,
	param_type: CoreType,
	clone_name: String,
	clone_def_id: Int
}


private record ConsumeSpecializeState {
	unions: List[CoreUnionDecl],
	next_def_id: Int,
	candidates: List[CloneCandidate],
	used_clone_keys: List[CloneKey]
}


private record CloneTarget {
	key: CloneKey,
	clone_name: String,
	clone_def_id: Int
}


private struct OwnedUseAnalysis {
	safe: Bool,
	min_count: Int,
	max_count: Int
}


private record RewriteLengthGeqResult {
	state: ConsumeSpecializeState,
	geq: Option[CoreConstructorLengthMatchGeq]
}


private record RewriteLengthFallbackResult {
	state: ConsumeSpecializeState,
	fallback: Option[CoreConstructorLengthMatchBranch]
}


private EMPTY_OWNED_USE: OwnedUseAnalysis = {
	safe = True,
	min_count = 0,
	max_count = 0
}

private UNSAFE_OWNED_USE: OwnedUseAnalysis = {
	safe = False,
	min_count = 0,
	max_count = 0
}


private pure func core_type_lists_equal(left: List[CoreType], right: List[CoreType]) -> Bool:
	match left:
		[]:
			match right:
				[]:
					True
				[right_head, ...right_tail]:
					False
		[left_head, ...left_tail]:
			match right:
				[]:
					False
				[right_head, ...right_tail]:
					(
						core_type_equal(left_head, right_head)
						and core_type_lists_equal(left_tail, right_tail)
					)


private pure func core_type_equal(left: CoreType, right: CoreType) -> Bool:
	match left:
		VoidType:
			match right:
				VoidType:
					True
				_:
					False
		NamedType(left_name, left_args):
			match right:
				NamedType(right_name, right_args):
					left_name == right_name and core_type_lists_equal(left_args, right_args)
				_:
					False
		TypeParameterType(left_name):
			match right:
				TypeParameterType(right_name):
					left_name == right_name
				_:
					False
		SelfType:
			match right:
				SelfType:
					True
				_:
					False
		StackResultType(left_ok, left_err):
			match right:
				StackResultType(right_ok, right_err):
					core_type_equal(left_ok, right_ok) and core_type_equal(left_err, right_err)
				_:
					False
		BoxedResultType(left_ok, left_err):
			match right:
				BoxedResultType(right_ok, right_err):
					core_type_equal(left_ok, right_ok) and core_type_equal(left_err, right_err)
				_:
					False
		FunctionType(left_pure, left_params, left_return):
			match right:
				FunctionType(right_pure, right_params, right_return):
					(
						left_pure == right_pure
						and core_type_lists_equal(left_params, right_params)
						and core_type_equal(left_return, right_return)
					)
				_:
					False
		EnumType(left_name):
			match right:
				EnumType(right_name):
					left_name == right_name
				_:
					False
		ValueRecordType(left_name):
			match right:
				ValueRecordType(right_name):
					left_name == right_name
				_:
					False
		HeapRecordType(left_name):
			match right:
				HeapRecordType(right_name):
					left_name == right_name
				_:
					False
		UnionType(left_name):
			match right:
				UnionType(right_name):
					left_name == right_name
				_:
					False
		RangeType:
			match right:
				RangeType:
					True
				_:
					False
		TensorType(info):
			match right:
				TensorType(info):
					True
				_:
					False
		TupleType(left_items):
			match right:
				TupleType(right_items):
					core_type_lists_equal(left_items, right_items)
				_:
					False


private pure func core_expr_type(expr: CoreExpr) -> Option[CoreType]:
	match expr:
		LiteralExpr(literal, typ, loc):
			Some(typ)
		VarExpr(variable, typ, loc):
			Some(typ)
		CallExpr(kind, callee, args, typ, loc):
			Some(typ)
		AssignExpr(variable, rhs, typ, loc):
			Some(typ)
		CastExpr(inner, typ, loc):
			Some(typ)
		BoxExpr(box, typ, loc):
			Some(typ)
		UnboxExpr(kind, inner, typ, loc):
			Some(typ)
		LetExpr(variable, is_mutable, typ, rhs, body):
			core_expr_type(body)
		BorrowLetExpr(variable, typ, rhs, body):
			core_expr_type(body)
		SeqExpr(first, second):
			core_expr_type(second)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			Some(typ)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			Some(typ)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			Some(typ)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			Some(typ)
		UnionConstructExpr(construct, typ, loc):
			Some(typ)
		_:
			None


private pure func direct_var_name(expr: CoreExpr) -> Option[String]:
	match expr:
		VarExpr(variable, typ, loc):
			Some(variable.name)
		CastExpr(inner, typ, loc):
			direct_var_name(inner)
		UnboxExpr(kind, inner, typ, loc):
			direct_var_name(inner)
		BoxExpr(box, typ, loc):
			direct_var_name(box.value)
		_:
			None


private pure func max_int(left: Int, right: Int) -> Int:
	if left > right:
		left
	else:
		right


private pure func min_int(left: Int, right: Int) -> Int:
	if left < right:
		left
	else:
		right


private pure func collect_unions(program: CoreProgram) -> List[CoreUnionDecl]:
	var unions: List[CoreUnionDecl] = []

	for decl in program.decls:
		match decl:
			UnionDecl(union_decl):
				unions = unions.append(union_decl)
			_:
				void

	unions


private pure func make_state(program: CoreProgram) -> ConsumeSpecializeState:
	var state: ConsumeSpecializeState = {
		unions = collect_unions(program),
		next_def_id = core_program_max_declared_definition_id(program) + 1,
		candidates = [],
		used_clone_keys = []
	}

	for decl in program.decls:
		match decl:
			FunctionDecl(func_info):
				state = collect_function_clone_candidates(state, func_info)
			_:
				void

	state


private pure func find_union(state: ConsumeSpecializeState, name: String) -> Option[CoreUnionDecl]:
	var found: Option[CoreUnionDecl] = None

	for union_decl in state.unions:
		if union_decl.name == name:
			found = Some(union_decl)
		else:
			void

	found


private pure func find_union_variant(
	state: ConsumeSpecializeState,
	type_name: String,
	constructor: String,
) -> Option[CoreUnionVariant]:
	match find_union(state, type_name):
		Some(union_decl):
			var found: Option[CoreUnionVariant] = None

			for variant in union_decl.variants:
				if variant.name == constructor:
					found = Some(variant)
				else:
					void

			found
		None:
			None


private pure func source_managed_type_name(
	state: ConsumeSpecializeState,
	typ: CoreType,
) -> Option[String]:
	match typ:
		UnionType(name):
			find_union(state, name).map(func(union_decl): union_decl.name)
		HeapRecordType(name):
			Some(name)
		NamedType(name, args):
			None
		_:
			None


private pure func direct_variant_field_type(
	state: ConsumeSpecializeState,
	scrutinee_type: CoreType,
	constructor: String,
	field_index: Int,
) -> Option[CoreType]:
	match scrutinee_type:
		UnionType(type_name):
			match find_union_variant(state, type_name, constructor):
				Some(variant):
					match variant.fields.get(field_index):
						Some(field):
							Some(field.typ)
						None:
							None
				None:
					None
		_:
			None


private pure func alias_get(aliases: List[(String, Bool)], name: String) -> Bool:
	var found: Bool = False

	for entry in aliases:
		if entry[0] == name:
			found = entry[1]
		else:
			void

	found


private pure func alias_set(
	aliases: List[(String, Bool)],
	name: String,
	value: Bool,
) -> List[(String, Bool)]:
	var result: List[(String, Bool)] = [(name, value)]

	for entry in aliases:
		if entry[0] == name:
			void
		else:
			result = result.append(entry)

	result


private pure func result_aliases_name(
	state: ConsumeSpecializeState,
	name: String,
	aliases: List[(String, Bool)],
	expr: CoreExpr,
) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			if variable.name == name:
				True
			else:
				alias_get(aliases, variable.name)
		LetExpr(variable, is_mutable, typ, rhs, body):
			bind_aliases: Bool = result_aliases_name(state, name, aliases, rhs)
			result_aliases_name(
				state,
				name,
				alias_set(aliases, variable.name, bind_aliases),
				body,
			)
		BorrowLetExpr(variable, typ, rhs, body):
			bind_aliases: Bool = result_aliases_name(state, name, aliases, rhs)
			result_aliases_name(
				state,
				name,
				alias_set(aliases, variable.name, bind_aliases),
				body,
			)
		SeqExpr(first, second):
			result_aliases_name(state, name, aliases, second)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			result_aliases_name(state, name, aliases, body)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			result_aliases_name(state, name, aliases, body)
		CastExpr(inner, typ, loc):
			result_aliases_name(state, name, aliases, inner)
		BoxExpr(box, typ, loc):
			result_aliases_name(state, name, aliases, box.value)
		UnboxExpr(kind, inner, typ, loc):
			result_aliases_name(state, name, aliases, inner)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			(
				result_aliases_name(state, name, aliases, then_expr)
				or result_aliases_name(state, name, aliases, else_expr)
			)
		CallExpr(UserCall(constructor, def_id, consumed_args), callee, args, typ, loc):
			match typ:
				UnionType(type_name):
					match find_union_variant(state, type_name, constructor):
						Some(variant):
							var result: Bool = False

							for arg in args:
								if result_aliases_name(state, name, aliases, arg):
									result = True
									break
								else:
									void

							result
						None:
							False
				_:
					False
		CallExpr(kind, callee, args, typ, loc):
			var result: Bool = False

			for arg in args:
				if result_aliases_name(state, name, aliases, arg):
					result = True
					break
				else:
					void

			result
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			scrutinee_aliases: Bool = result_aliases_name(state, name, aliases, scrutinee)
			var result: Bool = False

			for match_case in cases:
				if constructor_match_case_result_aliases_name(
					state,
					name,
					aliases,
					scrutinee_aliases,
					match_case,
				):
					result = True
					break
				else:
					void

			(
				result
				or constructor_match_fallback_result_aliases_name(
					state,
					name,
					aliases,
					scrutinee_aliases,
					fallback,
				)
			)
		_:
			False


private pure func constructor_match_case_result_aliases_name(
	state: ConsumeSpecializeState,
	name: String,
	aliases: List[(String, Bool)],
	scrutinee_aliases: Bool,
	match_case: CoreConstructorMatchCase,
) -> Bool:
	var case_aliases: List[(String, Bool)] = aliases

	for binding in match_case.bindings:
		case_aliases = alias_set(case_aliases, binding.variable.name, scrutinee_aliases)

	constructor_match_body_result_aliases_name(state, name, case_aliases, match_case.body)


private pure func constructor_match_body_result_aliases_name(
	state: ConsumeSpecializeState,
	name: String,
	aliases: List[(String, Bool)],
	body: CoreConstructorMatchBody,
) -> Bool:
	match body:
		ConstructorMatchBodyExpr(expr):
			result_aliases_name(state, name, aliases, expr)
		ConstructorMatchBodyLiteral(match_expr):
			False
		ConstructorMatchBodyLength(match_expr):
			False


private pure func constructor_match_fallback_result_aliases_name(
	state: ConsumeSpecializeState,
	name: String,
	aliases: List[(String, Bool)],
	scrutinee_aliases: Bool,
	fallback: CoreConstructorMatchFallback,
) -> Bool:
	match fallback:
		ConstructorMatchFallbackBody(body):
			result_aliases_name(state, name, aliases, body)
		ConstructorMatchFallbackBindings(bindings, body):
			var fallback_aliases: List[(String, Bool)] = aliases

			for binding in bindings:
				fallback_aliases = alias_set(
					fallback_aliases,
					binding.variable.name,
					scrutinee_aliases,
				)

			result_aliases_name(state, name, fallback_aliases, body)
		ConstructorMatchFallbackFail:
			False


private pure func function_is_cloneable(
	state: ConsumeSpecializeState,
	arg_index: Int,
	func_info: CoreFunction,
) -> Bool:
	match func_info.function_kind:
		UserFunction:
			match func_info.body:
				Some(body):
					match func_info.params.get(arg_index):
						Some(param):
							managed_param: Bool = source_managed_type_name(
								state,
								param.typ,
							).is_some()
							returns_same_type: Bool = core_type_equal(
								param.typ,
								func_info.return_type,
							)
							result_does_not_alias_param: Bool = not result_aliases_name(
								state,
								param.name.name,
								[],
								body,
							)
							managed_param and returns_same_type and result_does_not_alias_param
						None:
							False
				None:
					False
		ProgramEntrypointFunction:
			False
		BuiltinFunction(c_name):
			False
		UnresolvedBuiltinFunction:
			False
		ForeignFunction(_):
			False
		ClosureBodyFunction(abi):
			False


private pure func clone_name(original_name: String, arg_index: Int) -> String:
	"${original_name}__consume_arg${arg_index.to_string()}"


private pure func clone_key(
	original_name: String,
	original_def_id: Int,
	arg_index: Int,
) -> CloneKey:
	{
		original_name = original_name,
		original_def_id = original_def_id,
		arg_index = arg_index
	}


private pure func clone_key_equal(left: CloneKey, right: CloneKey) -> Bool:
	(
		left.original_name == right.original_name
		and left.original_def_id == right.original_def_id
		and left.arg_index == right.arg_index
	)


private pure func clone_callee_var(name: String, def_id: Int) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = Some(def_id)
	}


private pure func rewrite_callee_expr(name: String, def_id: Int, callee: CoreExpr) -> CoreExpr:
	match callee:
		VarExpr(variable, typ, loc):
			VarExpr(
				clone_callee_var(name, def_id),
				typ,
				loc,
			)
		_:
			callee


private pure func is_call_to_function(original: CoreFunction, kind: CoreCallKind) -> Bool:
	match kind:
		UserCall(name, Some(def_id), consumed_args):
			name == original.name and def_id == original.def_id
		_:
			False


private pure func direct_arg_name(args: List[CoreExpr], index: Int) -> Option[String]:
	match args.get(index):
		Some(arg):
			direct_var_name(arg)
		None:
			None


private pure func optional_name_matches(value: Option[String], expected: String) -> Bool:
	match value:
		Some(name):
			name == expected
		None:
			False


private pure func seq_owned_use(
	left: OwnedUseAnalysis,
	right: OwnedUseAnalysis,
) -> OwnedUseAnalysis:
	{
		safe = left.safe and right.safe,
		min_count = left.min_count + right.min_count,
		max_count = left.max_count + right.max_count
	}


private pure func join_owned_use(
	left: OwnedUseAnalysis,
	right: OwnedUseAnalysis,
) -> OwnedUseAnalysis:
	{
		safe = left.safe and right.safe,
		min_count = min_int(left.min_count, right.min_count),
		max_count = max_int(left.max_count, right.max_count)
	}


private pure func analyze_exprs_owned_use(
	original: CoreFunction,
	arg_index: Int,
	name: String,
	exprs: List[CoreExpr],
) -> OwnedUseAnalysis:
	var result: OwnedUseAnalysis = EMPTY_OWNED_USE

	for expr in exprs:
		result = seq_owned_use(
			result,
			analyze_owned_binding_use(original, arg_index, name, expr),
		)

	result


private pure func allowed_owned_call_use(
	original: CoreFunction,
	arg_index: Int,
	name: String,
	kind: CoreCallKind,
	args: List[CoreExpr],
) -> Bool:
	is_call_to_function(original, kind) and optional_name_matches(
		direct_arg_name(args, arg_index),
		name,
	)


private pure func analyze_owned_call_args(
	original: CoreFunction,
	arg_index: Int,
	name: String,
	args: List[CoreExpr],
) -> OwnedUseAnalysis:
	var result: OwnedUseAnalysis = EMPTY_OWNED_USE
	var index: Int = 0

	for arg in args:
		if index == arg_index and optional_name_matches(direct_var_name(arg), name):
			void
		else:
			result = seq_owned_use(
				result,
				analyze_owned_binding_use(original, arg_index, name, arg),
			)

		index += 1

	result


private pure func analyze_owned_binding_use(
	original: CoreFunction,
	arg_index: Int,
	name: String,
	expr: CoreExpr,
) -> OwnedUseAnalysis:
	match expr:
		VarExpr(variable, typ, loc):
			if variable.name == name:
				UNSAFE_OWNED_USE
			else:
				EMPTY_OWNED_USE
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			if variable.name == name:
				UNSAFE_OWNED_USE
			else:
				analyze_owned_binding_use(original, arg_index, name, body)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			if variable.name == name:
				UNSAFE_OWNED_USE
			else:
				analyze_owned_binding_use(original, arg_index, name, body)
		CallExpr(kind, callee, args, typ, loc):
			if allowed_owned_call_use(original, arg_index, name, kind, args):
				call_use: OwnedUseAnalysis = {
					safe = True,
					min_count = 1,
					max_count = 1
				}
				seq_owned_use(
					call_use,
					analyze_owned_call_args(original, arg_index, name, args),
				)
			else:
				analyze_exprs_owned_use(original, arg_index, name, args)
		LetExpr(variable, is_mutable, typ, rhs, body):
			rhs_use: OwnedUseAnalysis = analyze_owned_binding_use(original, arg_index, name, rhs)

			if variable.name == name:
				rhs_use
			else:
				seq_owned_use(
					rhs_use,
					analyze_owned_binding_use(original, arg_index, name, body),
				)
		BorrowLetExpr(variable, typ, rhs, body):
			rhs_use: OwnedUseAnalysis = analyze_owned_binding_use(original, arg_index, name, rhs)

			if variable.name == name:
				rhs_use
			else:
				seq_owned_use(
					rhs_use,
					analyze_owned_binding_use(original, arg_index, name, body),
				)
		SeqExpr(first, second):
			seq_owned_use(
				analyze_owned_binding_use(original, arg_index, name, first),
				analyze_owned_binding_use(original, arg_index, name, second),
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			condition_use: OwnedUseAnalysis = analyze_owned_binding_use(
				original,
				arg_index,
				name,
				cond,
			)
			branch_use: OwnedUseAnalysis = join_owned_use(
				analyze_owned_binding_use(original, arg_index, name, then_expr),
				analyze_owned_binding_use(original, arg_index, name, else_expr),
			)
			seq_owned_use(condition_use, branch_use)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			scrutinee_use: OwnedUseAnalysis = analyze_owned_binding_use(
				original,
				arg_index,
				name,
				scrutinee,
			)
			case_use: OwnedUseAnalysis = analyze_constructor_match_cases_owned_use(
				original,
				arg_index,
				name,
				cases,
			)
			seq_owned_use(scrutinee_use, case_use)
		_:
			EMPTY_OWNED_USE


private pure func analyze_constructor_match_cases_owned_use(
	original: CoreFunction,
	arg_index: Int,
	name: String,
	cases: List[CoreConstructorMatchCase],
) -> OwnedUseAnalysis:
	var result: Option[OwnedUseAnalysis] = None

	for match_case in cases:
		case_use: OwnedUseAnalysis = analyze_constructor_match_body_owned_use(
			original,
			arg_index,
			name,
			match_case.body,
		)

		result = match result:
			Some(current):
				Some(join_owned_use(current, case_use))
			None:
				Some(case_use)

	result.get_or(EMPTY_OWNED_USE)


private pure func analyze_constructor_match_body_owned_use(
	original: CoreFunction,
	arg_index: Int,
	name: String,
	body: CoreConstructorMatchBody,
) -> OwnedUseAnalysis:
	match body:
		ConstructorMatchBodyExpr(expr):
			analyze_owned_binding_use(original, arg_index, name, expr)
		ConstructorMatchBodyLiteral(match_expr):
			EMPTY_OWNED_USE
		ConstructorMatchBodyLength(match_expr):
			EMPTY_OWNED_USE


private pure func can_own_binding(
	original: CoreFunction,
	arg_index: Int,
	binding: CoreMatchBinding,
	body: CoreConstructorMatchBody,
) -> Bool:
	analysis: OwnedUseAnalysis = analyze_constructor_match_body_owned_use(
		original,
		arg_index,
		binding.variable.name,
		body,
	)

	analysis.safe and analysis.min_count == 1 and analysis.max_count == 1


private pure func direct_owned_binding_candidate(
	state: ConsumeSpecializeState,
	param_type: CoreType,
	binding: CoreMatchBinding,
) -> Bool:
	match binding.mode:
		MatchBorrowBindingMode:
			match binding.accessor:
				VariantFieldAccessor(RootAccessor, union_c_type, constructor, field_index):
					direct_variant_field_type(state, param_type, constructor, field_index)
						.map(func(field_type):
							same_type: Bool = core_type_equal(field_type, param_type)
							managed_field: Bool = source_managed_type_name(
								state,
								field_type,
							).is_some()

							same_type and managed_field
						)
						.get_or(False)
				_:
					False
		MatchOwnBindingMode:
			False


private pure func owned_binding_names(
	state: ConsumeSpecializeState,
	original: CoreFunction,
	arg_index: Int,
	param_type: CoreType,
	match_case: CoreConstructorMatchCase,
) -> List[String]:
	var names: List[String] = []

	for binding in match_case.bindings:
		if (
			direct_owned_binding_candidate(state, param_type, binding)
			and can_own_binding(original, arg_index, binding, match_case.body)
		):
			names = names.append(binding.variable.name)
		else:
			void

	names


private pure func list_contains_string(items: List[String], value: String) -> Bool:
	var found: Bool = False

	for item in items:
		if item == value:
			found = True
			break
		else:
			void

	found


private pure func rewrite_owned_recursive_call(
	original: CoreFunction,
	clone: CoreFunction,
	arg_index: Int,
	owned_names: List[String],
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			rewritten_callee: CoreExpr = rewrite_owned_recursive_call(
				original,
				clone,
				arg_index,
				owned_names,
				callee,
			)
			rewritten_args: List[CoreExpr] = args.map(func(arg):
				rewrite_owned_recursive_call(original, clone, arg_index, owned_names, arg)
			)

			if (
				is_call_to_function(original, kind)
				and direct_arg_name(args, arg_index)
					.map(func(name): list_contains_string(owned_names, name))
					.get_or(False)
			):
				CallExpr(
					UserCall(clone.name, Some(clone.def_id), []),
					rewrite_callee_expr(clone.name, clone.def_id, rewritten_callee),
					rewritten_args,
					typ,
					loc,
				)
			else:
				CallExpr(kind, rewritten_callee, rewritten_args, typ, loc)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				rewrite_owned_recursive_call(original, clone, arg_index, owned_names, cond),
				rewrite_owned_recursive_call(original, clone, arg_index, owned_names, then_expr),
				rewrite_owned_recursive_call(original, clone, arg_index, owned_names, else_expr),
				typ,
				loc,
			)
		UnionConstructExpr(construct, typ, loc):
			UnionConstructExpr(
				{
					type_name = construct.type_name,
					constructor_name = construct.constructor_name,
					constructor_c_name = construct.constructor_c_name,
					representation = construct.representation,
					payload_storage = construct.payload_storage,
					uses_release_mask = construct.uses_release_mask,
					release_mask = construct.release_mask,
					args = rewrite_owned_recursive_boxed_values(
						original,
						clone,
						arg_index,
						owned_names,
						construct.args,
					)
				},
				typ,
				loc,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				rewrite_owned_recursive_call(original, clone, arg_index, owned_names, scrutinee),
				release_policy,
				rewrite_owned_recursive_match_cases(original, clone, arg_index, owned_names, cases),
				rewrite_owned_recursive_match_fallback(
					original,
					clone,
					arg_index,
					owned_names,
					fallback,
				),
				typ,
				loc,
			)
		_:
			expr


private pure func rewrite_owned_recursive_boxed_values(
	original: CoreFunction,
	clone: CoreFunction,
	arg_index: Int,
	owned_names: List[String],
	values: List[CoreBoxedStorageValue],
) -> List[CoreBoxedStorageValue]:
	values.map(func(value):
		{
			kind = value.kind,
			value = rewrite_owned_recursive_call(
				original,
				clone,
				arg_index,
				owned_names,
				value.value,
			),
			needs_release = value.needs_release,
			transfers_ownership = value.transfers_ownership
		}
	)


private pure func rewrite_owned_recursive_match_cases(
	original: CoreFunction,
	clone: CoreFunction,
	arg_index: Int,
	owned_names: List[String],
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	cases.map(func(match_case):
		{
			constructor = match_case.constructor,
			accessor = match_case.accessor,
			test = match_case.test,
			bindings = match_case.bindings,
			body = rewrite_owned_recursive_match_body(
				original,
				clone,
				arg_index,
				owned_names,
				match_case.body,
			)
		}
	)


private pure func rewrite_owned_recursive_match_body(
	original: CoreFunction,
	clone: CoreFunction,
	arg_index: Int,
	owned_names: List[String],
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(
				rewrite_owned_recursive_call(
					original,
					clone,
					arg_index,
					owned_names,
					expr,
				),
			)
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(match_expr)
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(match_expr)


private pure func rewrite_owned_recursive_match_fallback(
	original: CoreFunction,
	clone: CoreFunction,
	arg_index: Int,
	owned_names: List[String],
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(
				rewrite_owned_recursive_call(
					original,
					clone,
					arg_index,
					owned_names,
					body,
				),
			)
		ConstructorMatchFallbackBindings(bindings, body):
			ConstructorMatchFallbackBindings(
				bindings,
				rewrite_owned_recursive_call(original, clone, arg_index, owned_names, body),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func rewrite_owned_match_case(
	state: ConsumeSpecializeState,
	original: CoreFunction,
	clone: CoreFunction,
	arg_index: Int,
	param_type: CoreType,
	match_case: CoreConstructorMatchCase,
) -> CoreConstructorMatchCase:
	owned_names: List[String] = owned_binding_names(
		state,
		original,
		arg_index,
		param_type,
		match_case,
	)

	if owned_names.length() == 0:
		match_case
	else:
		var bindings: List[CoreMatchBinding] = []

		for binding in match_case.bindings:
			if list_contains_string(owned_names, binding.variable.name):
				bindings = bindings.append({
					variable = binding.variable,
					typ = binding.typ,
					accessor = binding.accessor,
					mode = MatchOwnBindingMode,
				})
			else:
				bindings = bindings.append(binding)

		{ match_case |
			bindings = bindings,
			body = rewrite_owned_recursive_match_body(
				original,
				clone,
				arg_index,
				owned_names,
				match_case.body,
			)
		}


private pure func rewrite_owned_match_expr(
	state: ConsumeSpecializeState,
	original: CoreFunction,
	clone: CoreFunction,
	arg_index: Int,
	param: CoreParam,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		ConstructorMatchExpr(VarExpr(scrutinee, scrutinee_type, scrutinee_loc), release_policy, cases, fallback, typ, loc):
			if scrutinee.name == param.name.name:
				var rewritten_cases: List[CoreConstructorMatchCase] = []

				for match_case in cases:
					rewritten_cases = rewritten_cases.append(
						rewrite_owned_match_case(
							state,
							original,
							clone,
							arg_index,
							param.typ,
							match_case,
						),
					)

				ConstructorMatchExpr(
					VarExpr(scrutinee, scrutinee_type, scrutinee_loc),
					release_policy,
					rewritten_cases,
					fallback,
					typ,
					loc,
				)
			else:
				expr
		_:
			expr


private pure func result_var_for_param(param: CoreParam) -> CoreVar:
	{
		name = "__consume_result_${param.name.name}",
		uniq = 0,
		def_id = None
	}


private pure func make_consuming_clone(
	state: ConsumeSpecializeState,
	original: CoreFunction,
	arg_index: Int,
	clone_def_id: Int,
) -> Option[CoreFunction]:
	match original.params.get(arg_index):
		Some(param):
			match original.body:
				Some(body):
					placeholder: CoreFunction = {
						name = clone_name(original.name, arg_index),
						source_module = original.source_module,
						type_params = original.type_params,
						params = original.params,
						return_type = original.return_type,
						body = None,
						is_pure = original.is_pure,
						function_kind = original.function_kind,
						def_id = clone_def_id,
						loc = original.loc
					}
					rewritten_body: CoreExpr = rewrite_owned_match_expr(
						state,
						original,
						placeholder,
						arg_index,
						param,
						body,
					)
					result_var: CoreVar = result_var_for_param(param)
					result_ref: CoreExpr = VarExpr(
						result_var,
						original.return_type,
						SyntheticSourceLoc,
					)
					drop_then_return: CoreExpr = DropExpr(
						param.name,
						param.typ,
						ArcReleasePolicy,
						result_ref,
						original.return_type,
						SyntheticSourceLoc,
					)

					Some(
						{ placeholder |
							body = Some(
								LetExpr(
									result_var,
									False,
									original.return_type,
									rewritten_body,
									drop_then_return,
								),
							)
						},
					)
				None:
					None
		None:
			None


private pure func collect_function_clone_candidates(
	state: ConsumeSpecializeState,
	func_info: CoreFunction,
) -> ConsumeSpecializeState:
	var current: ConsumeSpecializeState = state
	var arg_index: Int = 0

	for param in func_info.params:
		if function_is_cloneable(current, arg_index, func_info):
			current = { current |
				next_def_id = current.next_def_id + 1,
				candidates = current.candidates.append({
					key = clone_key(func_info.name, func_info.def_id, arg_index),
					param_type = param.typ,
					clone_name = clone_name(func_info.name, arg_index),
					clone_def_id = current.next_def_id,
				})
			}
		else:
			void

		arg_index += 1

	current


private pure func find_clone_target(
	state: ConsumeSpecializeState,
	original_name: String,
	original_def_id: Int,
	arg_index: Int,
	target_type: CoreType,
) -> Option[CloneTarget]:
	var found: Option[CloneTarget] = None

	for candidate in state.candidates:
		if (
			candidate.key.original_name == original_name
			and candidate.key.original_def_id == original_def_id
			and candidate.key.arg_index == arg_index
			and core_type_equal(candidate.param_type, target_type)
		):
			found = Some({
				key = candidate.key,
				clone_name = candidate.clone_name,
				clone_def_id = candidate.clone_def_id,
			})
		else:
			void

	found


private pure func clone_key_used(used_clone_keys: List[CloneKey], key: CloneKey) -> Bool:
	var found: Bool = False

	for used_key in used_clone_keys:
		if clone_key_equal(used_key, key):
			found = True
			break
		else:
			void

	found


private pure func mark_clone_used(
	state: ConsumeSpecializeState,
	key: CloneKey,
) -> ConsumeSpecializeState:
	if clone_key_used(state.used_clone_keys, key):
		state
	else:
		{ state | used_clone_keys = state.used_clone_keys.append(key) }


private pure func call_arg_consumes_target(
	state: ConsumeSpecializeState,
	target: CoreVar,
	target_type: CoreType,
	kind: CoreCallKind,
	args: List[CoreExpr],
) -> Option[CloneTarget]:
	var candidate_index: Option[Int] = None
	var index: Int = 0
	var count: Int = 0

	for arg in args:
		if optional_name_matches(direct_var_name(arg), target.name):
			candidate_index = Some(index)
			count += 1
		else:
			void

		index += 1

	if count == 1:
		match candidate_index:
			Some(arg_index):
				match kind:
					UserCall(name, Some(def_id), consumed_args):
						find_clone_target(state, name, def_id, arg_index, target_type)
					_:
						None
			None:
				None
	else:
		None


private pure func rewrite_assignment_call(
	state: ConsumeSpecializeState,
	target: CoreVar,
	target_type: CoreType,
	rhs: CoreExpr,
) -> (ConsumeSpecializeState, CoreExpr):
	match rhs:
		CallExpr(kind, callee, args, typ, loc):
			match call_arg_consumes_target(state, target, target_type, kind, args):
				Some(target_clone):
					(mark_clone_used(state, target_clone.key), CallExpr(
							UserCall(target_clone.clone_name, Some(target_clone.clone_def_id), []),
							rewrite_callee_expr(
								target_clone.clone_name,
								target_clone.clone_def_id,
								callee,
							),
							args,
							typ,
							loc,
						))
				None:
					(state, rhs)
		_:
			(state, rhs)


private pure func rewrite_constructor_literal_match_cases(
	state: ConsumeSpecializeState,
	cases: List[CoreLiteralMatchCase],
) -> (ConsumeSpecializeState, List[CoreLiteralMatchCase]):
	var current: ConsumeSpecializeState = state
	var rewritten: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		body_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(current, match_case.body)
		current = body_result[0]
		rewritten = rewritten.append({ match_case | body = body_result[1] })

	(current, rewritten)


private pure func rewrite_constructor_literal_match_fallback(
	state: ConsumeSpecializeState,
	fallback: CoreLiteralMatchFallback,
) -> (ConsumeSpecializeState, CoreLiteralMatchFallback):
	match fallback:
		LiteralMatchFallbackBody(body):
			body_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(state, body)
			(body_result[0], LiteralMatchFallbackBody(body_result[1]))
		LiteralMatchFallbackBindings(bindings, body):
			body_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(state, body)
			(body_result[0], LiteralMatchFallbackBindings(bindings, body_result[1]))
		LiteralMatchFallbackFail:
			(state, LiteralMatchFallbackFail)


private pure func rewrite_constructor_literal_match(
	state: ConsumeSpecializeState,
	match_expr: CoreConstructorLiteralMatch,
) -> (ConsumeSpecializeState, CoreConstructorLiteralMatch):
	cases_result: (ConsumeSpecializeState, List[CoreLiteralMatchCase]) = rewrite_constructor_literal_match_cases(
		state,
		match_expr.cases,
	)

	fallback_result: (ConsumeSpecializeState, CoreLiteralMatchFallback) = rewrite_constructor_literal_match_fallback(
		cases_result[0],
		match_expr.fallback,
	)

	(fallback_result[0], { match_expr |
			cases = cases_result[1],
			fallback = fallback_result[1]
		})


private pure func rewrite_constructor_length_branch(
	state: ConsumeSpecializeState,
	branch: CoreConstructorLengthMatchBranch,
) -> (ConsumeSpecializeState, CoreConstructorLengthMatchBranch):
	body_result: (ConsumeSpecializeState, CoreConstructorMatchBody) = rewrite_constructor_match_body(
		state,
		branch.body,
	)

	(body_result[0], { branch | body = body_result[1] })


private pure func rewrite_constructor_length_cases(
	state: ConsumeSpecializeState,
	cases: List[CoreConstructorLengthMatchCase],
) -> (ConsumeSpecializeState, List[CoreConstructorLengthMatchCase]):
	var current: ConsumeSpecializeState = state
	var rewritten: List[CoreConstructorLengthMatchCase] = []

	for match_case in cases:
		branch_result: (ConsumeSpecializeState, CoreConstructorLengthMatchBranch) = rewrite_constructor_length_branch(
			current,
			match_case.branch,
		)

		current = branch_result[0]
		rewritten = rewritten.append({ match_case | branch = branch_result[1] })

	(current, rewritten)


private pure func rewrite_constructor_length_geq(
	state: ConsumeSpecializeState,
	geq: Option[CoreConstructorLengthMatchGeq],
) -> RewriteLengthGeqResult:
	match geq:
		Some(match_case):
			branch_result: (ConsumeSpecializeState, CoreConstructorLengthMatchBranch) = rewrite_constructor_length_branch(
				state,
				match_case.branch,
			)

			{
				state = branch_result[0],
				geq = Some({ match_case | branch = branch_result[1] })
			}
		None:
			{
				state = state,
				geq = None
			}


private pure func rewrite_constructor_length_fallback(
	state: ConsumeSpecializeState,
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> RewriteLengthFallbackResult:
	match fallback:
		Some(branch):
			branch_result: (ConsumeSpecializeState, CoreConstructorLengthMatchBranch) = rewrite_constructor_length_branch(
				state,
				branch,
			)

			{
				state = branch_result[0],
				fallback = Some(branch_result[1])
			}
		None:
			{
				state = state,
				fallback = None
			}


private pure func rewrite_constructor_length_match(
	state: ConsumeSpecializeState,
	match_expr: CoreConstructorLengthMatch,
) -> (ConsumeSpecializeState, CoreConstructorLengthMatch):
	cases_result: (ConsumeSpecializeState, List[CoreConstructorLengthMatchCase]) = rewrite_constructor_length_cases(
		state,
		match_expr.cases,
	)

	geq_result: RewriteLengthGeqResult = rewrite_constructor_length_geq(
		cases_result[0],
		match_expr.geq,
	)

	fallback_result: RewriteLengthFallbackResult = rewrite_constructor_length_fallback(
		geq_result.state,
		match_expr.fallback,
	)

	(fallback_result.state, { match_expr |
			cases = cases_result[1],
			geq = geq_result.geq,
			fallback = fallback_result.fallback
		})


private pure func rewrite_constructor_match_body(
	state: ConsumeSpecializeState,
	body: CoreConstructorMatchBody,
) -> (ConsumeSpecializeState, CoreConstructorMatchBody):
	match body:
		ConstructorMatchBodyExpr(expr):
			expr_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(state, expr)
			(expr_result[0], ConstructorMatchBodyExpr(expr_result[1]))
		ConstructorMatchBodyLiteral(match_expr):
			match_result: (ConsumeSpecializeState, CoreConstructorLiteralMatch) = rewrite_constructor_literal_match(
				state,
				match_expr,
			)

			(match_result[0], ConstructorMatchBodyLiteral(match_result[1]))
		ConstructorMatchBodyLength(match_expr):
			match_result: (ConsumeSpecializeState, CoreConstructorLengthMatch) = rewrite_constructor_length_match(
				state,
				match_expr,
			)

			(match_result[0], ConstructorMatchBodyLength(match_result[1]))


private pure func rewrite_constructor_match_cases(
	state: ConsumeSpecializeState,
	cases: List[CoreConstructorMatchCase],
) -> (ConsumeSpecializeState, List[CoreConstructorMatchCase]):
	var current: ConsumeSpecializeState = state
	var rewritten: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		body_result: (ConsumeSpecializeState, CoreConstructorMatchBody) = rewrite_constructor_match_body(
			current,
			match_case.body,
		)

		current = body_result[0]
		rewritten = rewritten.append({ match_case | body = body_result[1] })

	(current, rewritten)


private pure func rewrite_constructor_match_fallback(
	state: ConsumeSpecializeState,
	fallback: CoreConstructorMatchFallback,
) -> (ConsumeSpecializeState, CoreConstructorMatchFallback):
	match fallback:
		ConstructorMatchFallbackBody(body):
			body_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(state, body)
			(body_result[0], ConstructorMatchFallbackBody(body_result[1]))
		ConstructorMatchFallbackBindings(bindings, body):
			body_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(state, body)
			(body_result[0], ConstructorMatchFallbackBindings(bindings, body_result[1]))
		ConstructorMatchFallbackFail:
			(state, ConstructorMatchFallbackFail)


private pure func rewrite_expr(
	state: ConsumeSpecializeState,
	expr: CoreExpr,
) -> (ConsumeSpecializeState, CoreExpr):
	match expr:
		AssignExpr(target, rhs, typ, loc):
			rewritten_rhs: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(state, rhs)
			rhs_state: ConsumeSpecializeState = rewritten_rhs[0]
			rhs_expr: CoreExpr = rewritten_rhs[1]

			match core_expr_type(rhs_expr):
				Some(rhs_type):
					match source_managed_type_name(rhs_state, rhs_type):
						Some(type_name):
							call_result: (ConsumeSpecializeState, CoreExpr) = rewrite_assignment_call(
								rhs_state,
								target,
								rhs_type,
								rhs_expr,
							)
							(call_result[0], AssignExpr(target, call_result[1], typ, loc))
						None:
							(rhs_state, AssignExpr(target, rhs_expr, typ, loc))
				None:
					(rhs_state, AssignExpr(target, rhs_expr, typ, loc))
		LetExpr(variable, is_mutable, typ, rhs, body):
			rhs_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(state, rhs)
			body_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(rhs_result[0], body)
			(body_result[0], LetExpr(variable, is_mutable, typ, rhs_result[1], body_result[1]))
		BorrowLetExpr(variable, typ, rhs, body):
			rhs_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(state, rhs)
			body_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(rhs_result[0], body)
			(body_result[0], BorrowLetExpr(variable, typ, rhs_result[1], body_result[1]))
		SeqExpr(first, second):
			first_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(state, first)
			second_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(
				first_result[0],
				second,
			)
			(second_result[0], SeqExpr(first_result[1], second_result[1]))
		IfExpr(cond, then_expr, else_expr, typ, loc):
			cond_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(state, cond)
			then_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(
				cond_result[0],
				then_expr,
			)
			else_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(
				then_result[0],
				else_expr,
			)
			(else_result[0], IfExpr(cond_result[1], then_result[1], else_result[1], typ, loc))
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			scrutinee_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(state, scrutinee)
			cases_result: (ConsumeSpecializeState, List[CoreConstructorMatchCase]) = rewrite_constructor_match_cases(
				scrutinee_result[0],
				cases,
			)

			fallback_result: (ConsumeSpecializeState, CoreConstructorMatchFallback) = rewrite_constructor_match_fallback(
				cases_result[0],
				fallback,
			)

			(
				fallback_result[0],
				ConstructorMatchExpr(
					scrutinee_result[1],
					release_policy,
					cases_result[1],
					fallback_result[1],
					typ,
					loc,
				),
			)
		_:
			(state, expr)


private pure func rewrite_func(
	state: ConsumeSpecializeState,
	func_info: CoreFunction,
) -> (ConsumeSpecializeState, CoreFunction):
	match func_info.body:
		Some(body):
			body_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(state, body)
			(body_result[0], {
					name = func_info.name,
					source_module = func_info.source_module,
					type_params = func_info.type_params,
					params = func_info.params,
					return_type = func_info.return_type,
					body = Some(body_result[1]),
					is_pure = func_info.is_pure,
					function_kind = func_info.function_kind,
					def_id = func_info.def_id,
					loc = func_info.loc
				})
		None:
			(state, func_info)


private pure func rewrite_global(
	state: ConsumeSpecializeState,
	global: CoreGlobal,
) -> (ConsumeSpecializeState, CoreGlobal):
	init_result: (ConsumeSpecializeState, CoreExpr) = rewrite_expr(state, global.init)
	(init_result[0], {
			name = global.name,
			source_module = global.source_module,
			typ = global.typ,
			init = init_result[1],
			is_mutable = global.is_mutable,
			is_const = global.is_const,
			is_private = global.is_private,
			def_id = global.def_id,
			loc = global.loc
		})


private pure func rewrite_decl_body(
	state: ConsumeSpecializeState,
	decl: CoreDecl,
) -> (ConsumeSpecializeState, CoreDecl):
	match decl:
		FunctionDecl(func_info):
			result: (ConsumeSpecializeState, CoreFunction) = rewrite_func(state, func_info)
			(result[0], FunctionDecl(result[1]))
		GlobalDecl(global):
			result: (ConsumeSpecializeState, CoreGlobal) = rewrite_global(state, global)
			(result[0], GlobalDecl(result[1]))
		_:
			(state, decl)


private pure func clones_after(
	state: ConsumeSpecializeState,
	original_func: CoreFunction,
) -> List[CoreDecl]:
	var result: List[CoreDecl] = []

	for candidate in state.candidates:
		if (
			candidate.key.original_name == original_func.name
			and candidate.key.original_def_id == original_func.def_id
			and clone_key_used(state.used_clone_keys, candidate.key)
		):
			match make_consuming_clone(
				state,
				original_func,
				candidate.key.arg_index,
				candidate.clone_def_id,
			):
				Some(clone):
					result = result.append(FunctionDecl(clone))
				None:
					void
		else:
			void

	result


private pure func original_function_for_decl(decl: CoreDecl) -> Option[CoreFunction]:
	match decl:
		FunctionDecl(func_info):
			Some(func_info)
		_:
			None


private pure func insert_clones_after_functions(
	state: ConsumeSpecializeState,
	original_decls: List[CoreDecl],
	rewritten_decls: List[CoreDecl],
) -> List[CoreDecl]:
	var result: List[CoreDecl] = []
	var index: Int = 0

	for decl in rewritten_decls:
		result = result.append(decl)

		match original_decls.get(index):
			Some(original_decl):
				match original_function_for_decl(original_decl):
					Some(original_func):
						for clone_decl in clones_after(state, original_func):
							result = result.append(clone_decl)
					None:
						void
			None:
				void

		index += 1

	result


pure func rewrite_program(program: CoreProgram) -> CoreProgram:
	var state: ConsumeSpecializeState = make_state(program)
	var rewritten_decls: List[CoreDecl] = []

	for decl in program.decls:
		decl_result: (ConsumeSpecializeState, CoreDecl) = rewrite_decl_body(state, decl)
		state = decl_result[0]
		rewritten_decls = rewritten_decls.append(decl_result[1])

	{
		decls = insert_clones_after_functions(state, program.decls, rewritten_decls),
		foreign_includes = program.foreign_includes
	}
