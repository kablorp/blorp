import:
	../stage_01_file_io/source: SourceSpan


enum Keyword:
	FuncKeyword
	PureKeyword
	VarKeyword
	UnionKeyword
	RecordKeyword
	VoidKeyword
	WhileKeyword
	ForKeyword
	InKeyword
	IfKeyword
	ElseKeyword
	AndKeyword
	OrKeyword
	NotKeyword
	OnKeyword
	MatchKeyword
	TrueKeyword
	FalseKeyword
	BreakKeyword
	ContinueKeyword
	DebugKeyword
	StructKeyword
	EnumKeyword
	WithKeyword
	ResourceKeyword
	ForeignKeyword
	PrivateKeyword
	BuiltinKeyword
	ConcurrentKeyword
	ConcurrentlyKeyword
	DetachKeyword
	SelectKeyword
	IntoOpaqueKeyword
	FromKeyword
	FromOpaqueKeyword
	AfterKeyword
	SealedKeyword
	OpaqueKeyword
	TryKeyword
	ImportKeyword
	AsKeyword
	TraitKeyword
	ImplementsKeyword
	SelfKeyword
	TypeKeyword
	AliasKeyword
	WhereKeyword


enum Symbol:
	LeftParenSymbol
	RightParenSymbol
	LeftBracketSymbol
	RightBracketSymbol
	LeftBraceSymbol
	RightBraceSymbol
	CommaSymbol
	ColonSymbol
	DotSymbol
	DotDotSymbol
	DotDotDotSymbol
	ArrowSymbol
	FatArrowSymbol
	EqualSymbol
	QuestionEqualsSymbol
	PlusSymbol
	MinusSymbol
	StarSymbol
	SlashSymbol
	PlusEqualSymbol
	MinusEqualSymbol
	StarEqualSymbol
	SlashEqualSymbol
	UnderscoreSymbol
	PercentSymbol
	HashSymbol
	AtSymbol
	PipeSymbol
	EqualEqualSymbol
	NotEqualSymbol
	LessSymbol
	LessEqualSymbol
	GreaterSymbol
	GreaterEqualSymbol


enum TriviaKind:
	WhitespaceTrivia
	CommentTrivia


enum StringLiteralKind:
	NormalStringLiteral
	RawStringLiteral
	InterpolatedStringLiteral
	PipeStringLiteral
	RawPipeStringLiteral
	InterpolatedPipeStringLiteral


record Trivia {
	kind: TriviaKind,
	text: String,
	span: SourceSpan
}


union TokenKind:
	IdentifierToken(String)
	KeywordToken(Keyword)
	SymbolToken(Symbol)
	IntLiteralToken(String)
	FloatLiteralToken(String)
	StringLiteralToken(StringLiteralKind, String)
	CharLiteralToken(Int)
	DocStringToken(String)
	NewlineToken
	IndentToken
	DedentToken
	EndOfFileToken


record Token {
	kind: TokenKind,
	span: SourceSpan,
	leading_trivia: List[Trivia],
	trailing_trivia: List[Trivia]
}


pure func keyword_text(keyword: Keyword) -> String:
	match keyword:
		FuncKeyword:
			"func"
		PureKeyword:
			"pure"
		VarKeyword:
			"var"
		UnionKeyword:
			"union"
		RecordKeyword:
			"record"
		VoidKeyword:
			"void"
		WhileKeyword:
			"while"
		ForKeyword:
			"for"
		InKeyword:
			"in"
		IfKeyword:
			"if"
		ElseKeyword:
			"else"
		AndKeyword:
			"and"
		OrKeyword:
			"or"
		NotKeyword:
			"not"
		OnKeyword:
			"on"
		MatchKeyword:
			"match"
		TrueKeyword:
			"True"
		FalseKeyword:
			"False"
		BreakKeyword:
			"break"
		ContinueKeyword:
			"continue"
		DebugKeyword:
			"debug"
		StructKeyword:
			"struct"
		EnumKeyword:
			"enum"
		WithKeyword:
			"with"
		ResourceKeyword:
			"resource"
		ForeignKeyword:
			"foreign"
		PrivateKeyword:
			"private"
		BuiltinKeyword:
			"builtin"
		ConcurrentKeyword:
			"concurrent"
		ConcurrentlyKeyword:
			"concurrently"
		DetachKeyword:
			"detach"
		SelectKeyword:
			"select"
		IntoOpaqueKeyword:
			"into_opaque"
		FromKeyword:
			"from"
		FromOpaqueKeyword:
			"from_opaque"
		AfterKeyword:
			"after"
		SealedKeyword:
			"sealed"
		OpaqueKeyword:
			"opaque"
		TryKeyword:
			"try"
		ImportKeyword:
			"import"
		AsKeyword:
			"as"
		TraitKeyword:
			"trait"
		ImplementsKeyword:
			"implements"
		SelfKeyword:
			"Self"
		TypeKeyword:
			"type"
		AliasKeyword:
			"alias"
		WhereKeyword:
			"where"


pure func symbol_text(symbol: Symbol) -> String:
	match symbol:
		LeftParenSymbol:
			"("
		RightParenSymbol:
			")"
		LeftBracketSymbol:
			"["
		RightBracketSymbol:
			"]"
		LeftBraceSymbol:
			"{"
		RightBraceSymbol:
			"}"
		CommaSymbol:
			","
		ColonSymbol:
			":"
		DotSymbol:
			"."
		DotDotSymbol:
			".."
		DotDotDotSymbol:
			"..."
		ArrowSymbol:
			"->"
		FatArrowSymbol:
			"=>"
		EqualSymbol:
			"="
		QuestionEqualsSymbol:
			"?="
		PlusSymbol:
			"+"
		MinusSymbol:
			"-"
		StarSymbol:
			"*"
		SlashSymbol:
			"/"
		PlusEqualSymbol:
			"+="
		MinusEqualSymbol:
			"-="
		StarEqualSymbol:
			"*="
		SlashEqualSymbol:
			"/="
		UnderscoreSymbol:
			"_"
		PercentSymbol:
			"%"
		HashSymbol:
			"#"
		AtSymbol:
			"@"
		PipeSymbol:
			"|"
		EqualEqualSymbol:
			"=="
		NotEqualSymbol:
			"!="
		LessSymbol:
			"<"
		LessEqualSymbol:
			"<="
		GreaterSymbol:
			">"
		GreaterEqualSymbol:
			">="


pure func string_literal_kind_name(kind: StringLiteralKind) -> String:
	match kind:
		NormalStringLiteral:
			"string literal"
		RawStringLiteral:
			"raw string literal"
		InterpolatedStringLiteral:
			"interpolated string literal"
		PipeStringLiteral:
			"pipe string literal"
		RawPipeStringLiteral:
			"raw pipe string literal"
		InterpolatedPipeStringLiteral:
			"interpolated pipe string literal"


pure func trivia(kind: TriviaKind, text: String, span: SourceSpan) -> Trivia:
	{
		kind = kind,
		text = text,
		span = span
	}


pure func token(kind: TokenKind, span: SourceSpan) -> Token:
	{
		kind = kind,
		span = span,
		leading_trivia = [],
		trailing_trivia = []
	}


pure func token_with_trivia(
	kind: TokenKind,
	span: SourceSpan,
	leading_trivia: List[Trivia],
	trailing_trivia: List[Trivia],
) -> Token:
	{
		kind = kind,
		span = span,
		leading_trivia = leading_trivia,
		trailing_trivia = trailing_trivia
	}


pure func token_kind_name(kind: TokenKind) -> String:
	match kind:
		IdentifierToken(_):
			"identifier"
		KeywordToken(keyword):
			"keyword " + keyword_text(keyword)
		SymbolToken(symbol):
			"symbol " + symbol_text(symbol)
		IntLiteralToken(_):
			"integer literal"
		FloatLiteralToken(_):
			"float literal"
		StringLiteralToken(kind, _):
			string_literal_kind_name(kind)
		CharLiteralToken(_):
			"char literal"
		DocStringToken(_):
			"docstring"
		NewlineToken:
			"newline"
		IndentToken:
			"indent"
		DedentToken:
			"dedent"
		EndOfFileToken:
			"end of file"
