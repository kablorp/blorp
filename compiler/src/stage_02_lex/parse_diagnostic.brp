import:
	../stage_01_file_io/source: SourceSpan, source_span_label


enum ParseDiagnosticSeverity:
	ParseErrorSeverity
	ParseWarningSeverity


record ParseDiagnostic {
	severity: ParseDiagnosticSeverity,
	span: SourceSpan,
	message: String,
	expected: List[String],
	help: Option[String]
}


pure func parse_error(span: SourceSpan, message: String) -> ParseDiagnostic:
	{
		severity = ParseErrorSeverity,
		span = span,
		message = message,
		expected = [],
		help = None
	}


pure func parse_warning(span: SourceSpan, message: String) -> ParseDiagnostic:
	{
		severity = ParseWarningSeverity,
		span = span,
		message = message,
		expected = [],
		help = None
	}


pure func parse_error_expected(
	span: SourceSpan,
	message: String,
	expected: List[String],
	help: Option[String],
) -> ParseDiagnostic:
	{
		severity = ParseErrorSeverity,
		span = span,
		message = message,
		expected = expected,
		help = help
	}


pure func parse_diagnostic_is_error(diagnostic: ParseDiagnostic) -> Bool:
	match diagnostic.severity:
		ParseErrorSeverity:
			True
		ParseWarningSeverity:
			False


pure func parse_diagnostic_severity_text(severity: ParseDiagnosticSeverity) -> String:
	match severity:
		ParseErrorSeverity:
			"error"
		ParseWarningSeverity:
			"warning"


private pure func expected_summary(expected: List[String]) -> String:
	expected.join(", ")


pure func parse_diagnostic_to_string(diagnostic: ParseDiagnostic) -> String:
	base: String = source_span_label(
		diagnostic.span,
	) + ": " + parse_diagnostic_severity_text(diagnostic.severity) + ": " + diagnostic.message

	expected: String = expected_summary(diagnostic.expected)

	with_expected: String = if expected.length() == 0:
		base
	else:
		base + " (expected " + expected + ")"

	match diagnostic.help:
		Some(help):
			with_expected + "\nhelp: " + help
		None:
			with_expected
