-- Pure definition lookup over one immutable workspace snapshot.
--
-- A query never reads the filesystem or guesses from a symbol's spelling. It
-- first resolves the opaque semantic symbol identity at the requested source
-- position, then asks the indexed modules for that exact definition.
import:
	../analysis/analysis_model:
		IndexCoverage(CompleteIndexCoverage, PartialIndexCoverageState),
		Location,
		SemanticIndexSnapshot,
		SemanticIndexState(CurrentSemanticIndex, SemanticIndexUnavailable, StaleSemanticIndex),
		module_semantic_index_symbol_at,
		semantic_index_definition,
		semantic_index_module_for_uri,
	../protocol/identity: DocumentUri
	../protocol/position: ProtocolPosition


private pure func definition_from_snapshot(
	index: SemanticIndexSnapshot,
	uri: DocumentUri,
	position: ProtocolPosition,
) -> Option[List[Location]]:
	module ?= semantic_index_module_for_uri(index, uri)
	symbol ?= module_semantic_index_symbol_at(module, uri, position)

	match semantic_index_definition(index, symbol):
		Some(definition):
			Some([definition.location])
		None:
			match index.coverage:
				CompleteIndexCoverage:
					Some([])
				PartialIndexCoverageState(_):
					None


pure func definition_query_snapshot(
	semantic_index: SemanticIndexState,
	uri: DocumentUri,
	position: ProtocolPosition,
) -> Option[List[Location]]:
	match semantic_index:
		CurrentSemanticIndex(index):
			definition_from_snapshot(index, uri, position)
		StaleSemanticIndex(_, _):
			None
		SemanticIndexUnavailable(_):
			None
