-- Pure definition lookup over one immutable workspace snapshot.
--
-- A query never reads the filesystem or guesses from a symbol's spelling. It
-- first resolves the opaque semantic symbol identity at the requested source
-- position, then asks the indexed modules for that exact definition.
import:
	../analysis/analysis_model: Location, SemanticIndexState
	../analysis/semantic_query:
		SemanticQueryResult(SemanticQueryAvailable, SemanticQueryUnavailable),
		semantic_query_definition_or_absence,
		semantic_query_session,
		semantic_query_symbol_at,
	../protocol/identity: DocumentUri
	../protocol/position: ProtocolPosition


pure func definition_query_snapshot(
	semantic_index: SemanticIndexState,
	uri: DocumentUri,
	position: ProtocolPosition,
) -> Option[List[Location]]:
	match semantic_query_session(semantic_index, uri):
		SemanticQueryUnavailable(_):
			None
		SemanticQueryAvailable(session):
			symbol ?= semantic_query_symbol_at(session, position)

			match semantic_query_definition_or_absence(session, symbol):
				SemanticQueryUnavailable(_):
					None
				SemanticQueryAvailable(Some(definition)):
					Some([definition.location])
				SemanticQueryAvailable(None):
					Some([])
