-- Pure reference lookup over one immutable workspace snapshot.
--
-- The query follows the exact semantic symbol at the requested position. It
-- never reconstructs identity from source spelling, and incomplete snapshots
-- return unavailable rather than presenting a misleading empty result.
import:
	../analysis/analysis_model: Location
	../analysis/semantic_query:
		SemanticQueryResult(SemanticQueryAvailable, SemanticQueryUnavailable),
		WorkspaceSemanticQueryAdmission,
		workspace_semantic_query_references,
		workspace_semantic_query_session,
		workspace_semantic_query_symbol_at,
	../protocol/identity: DocumentUri
	../protocol/position: ProtocolPosition


pure func references_query_snapshot(
	admission: Option[WorkspaceSemanticQueryAdmission],
	uri: DocumentUri,
	position: ProtocolPosition,
	include_declaration: Bool,
) -> Option[List[Location]]:
	workspace_admission ?= admission

	match workspace_semantic_query_session(workspace_admission, uri):
		SemanticQueryUnavailable(_):
			None
		SemanticQueryAvailable(session):
			symbol ?= workspace_semantic_query_symbol_at(session, position)

			match workspace_semantic_query_references(session, symbol):
				SemanticQueryUnavailable(_):
					None
				SemanticQueryAvailable(references):
					Some(references.filter(func(reference):
						include_declaration or not reference.is_declaration
					).map(
						func(reference): reference.location,
					))
