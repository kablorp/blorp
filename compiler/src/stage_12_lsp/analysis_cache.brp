-- Fingerprint-checked access to completed analysis and diagnostics.
--
-- The underlying persistent stores retain only the newest entry for a module
-- identity. A lookup must still present the complete analysis fingerprint, so
-- a stale entry can never be mistaken for a cache hit.
import:
	../stage_04_modules/loaded_module: ModuleIdentity, module_identities_equal
	analysis_model: ModuleAnalysisFingerprint
	diagnostic_model: Diagnostic
	fingerprint_model: content_fingerprints_equal, frontend_fingerprints_equal
	indexed_store:
		ModuleStore,
		module_store,
		module_store_get,
		module_store_remove,
		module_store_set,
	snapshot_model: configuration_epoch_value


private record AnalysisCacheRep {
	typed_fingerprints: ModuleStore[ModuleAnalysisFingerprint],
	diagnostics: ModuleStore[DiagnosticCacheEntry]
}


private record DiagnosticCacheEntry {
	fingerprint: ModuleAnalysisFingerprint,
	diagnostics: List[Diagnostic]
}


opaque type AnalysisCacheSnapshot = AnalysisCacheRep


private pure func analysis_cache_rep(cache: AnalysisCacheSnapshot) -> AnalysisCacheRep:
	from AnalysisCacheSnapshot(cache)


pure func analysis_cache() -> AnalysisCacheSnapshot:
	representation: AnalysisCacheRep = {
		typed_fingerprints = module_store(),
		diagnostics = module_store()
	}
	into AnalysisCacheSnapshot(representation)


pure func module_analysis_fingerprints_equal(
	left: ModuleAnalysisFingerprint,
	right: ModuleAnalysisFingerprint,
) -> Bool:
	(
		module_identities_equal(left.module_identity, right.module_identity)
		and content_fingerprints_equal(left.source, right.source)
		and configuration_epoch_value(
			left.configuration_epoch,
		) == configuration_epoch_value(right.configuration_epoch)
		and frontend_fingerprints_equal(left.frontend, right.frontend)
	)


pure func analysis_cache_has_typed(
	cache: AnalysisCacheSnapshot,
	fingerprint: ModuleAnalysisFingerprint,
) -> Bool:
	representation = analysis_cache_rep(cache)

	match module_store_get(representation.typed_fingerprints, fingerprint.module_identity):
		Some(cached):
			module_analysis_fingerprints_equal(cached, fingerprint)
		None:
			False


pure func analysis_cache_diagnostics(
	cache: AnalysisCacheSnapshot,
	fingerprint: ModuleAnalysisFingerprint,
) -> Option[List[Diagnostic]]:
	representation = analysis_cache_rep(cache)
	entry ?= module_store_get(representation.diagnostics, fingerprint.module_identity)

	if module_analysis_fingerprints_equal(entry.fingerprint, fingerprint):
		Some(entry.diagnostics)
	else:
		None


-- The serialized workspace owner records this marker only while atomically
-- committing the matching semantic index. It is intentionally not an index
-- cache: planning needs only to know whether the current fingerprint completed.
pure func analysis_cache_store_typed(
	cache: AnalysisCacheSnapshot,
	fingerprint: ModuleAnalysisFingerprint,
) -> AnalysisCacheSnapshot:
	representation = analysis_cache_rep(cache)
	updated: AnalysisCacheRep = { representation |
		typed_fingerprints = module_store_set(
			representation.typed_fingerprints,
			fingerprint.module_identity,
			fingerprint,
		)
	}
	into AnalysisCacheSnapshot(updated)


pure func analysis_cache_store_diagnostics(
	cache: AnalysisCacheSnapshot,
	fingerprint: ModuleAnalysisFingerprint,
	diagnostics: List[Diagnostic],
) -> AnalysisCacheSnapshot:
	representation = analysis_cache_rep(cache)
	updated: AnalysisCacheRep = { representation | diagnostics = module_store_set(
			representation.diagnostics,
			fingerprint.module_identity,
			{
				fingerprint = fingerprint,
				diagnostics = diagnostics
			},
		) }
	into AnalysisCacheSnapshot(updated)


pure func analysis_cache_remove_typed(
	cache: AnalysisCacheSnapshot,
	fingerprint: ModuleAnalysisFingerprint,
) -> AnalysisCacheSnapshot:
	if not analysis_cache_has_typed(cache, fingerprint):
		cache
	else:
		representation = analysis_cache_rep(cache)
		updated: AnalysisCacheRep = { representation |
			typed_fingerprints = module_store_remove(
				representation.typed_fingerprints,
				fingerprint.module_identity,
			),
			diagnostics = module_store_remove(
				representation.diagnostics,
				fingerprint.module_identity,
			)
		}
		into AnalysisCacheSnapshot(updated)


pure func analysis_cache_remove_diagnostics(
	cache: AnalysisCacheSnapshot,
	fingerprint: ModuleAnalysisFingerprint,
) -> AnalysisCacheSnapshot:
	if analysis_cache_diagnostics(cache, fingerprint).is_none():
		cache
	else:
		representation = analysis_cache_rep(cache)
		updated: AnalysisCacheRep = { representation |
			diagnostics = module_store_remove(
				representation.diagnostics,
				fingerprint.module_identity,
			)
		}
		into AnalysisCacheSnapshot(updated)


-- Invalidation knows which module became unusable, but its replacement
-- fingerprint is intentionally different from the stale cached artifact.
-- Removing by canonical module identity prevents a failed reanalysis from
-- leaving the previous successful artifact reachable.
pure func analysis_cache_remove_typed_for_module(
	cache: AnalysisCacheSnapshot,
	module_identity: ModuleIdentity,
) -> AnalysisCacheSnapshot:
	representation = analysis_cache_rep(cache)
	updated: AnalysisCacheRep = { representation |
		typed_fingerprints = module_store_remove(
			representation.typed_fingerprints,
			module_identity,
		),
		diagnostics = module_store_remove(representation.diagnostics, module_identity)
	}
	into AnalysisCacheSnapshot(updated)
