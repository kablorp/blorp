-- JSON-RPC codec for the first semantic query endpoint.
--
-- This module validates only the wire contract. Workspace ownership and
-- snapshot freshness remain in definition_query and the serialized actor.
import:
	analysis_model: Location
	document_sync_codec: document_parameter_error
	json: JsonValue(JsonNull, JsonVector)
	json_rpc:
		JsonRpcEnvelope,
		json_rpc_error_value,
		json_rpc_method,
		json_rpc_parameters,
		json_rpc_request_id,
		json_rpc_success_value,
	protocol:
		ProtocolError(InvalidMethodParameters, MissingRequestId, UnknownMethod),
		ProtocolFailure,
		ProtocolInputOutcome(ProtocolInputAccepted, ProtocolInputIgnored, ProtocolInputRejected),
		ProtocolResponse(ProtocolErrorResponse, ProtocolSuccessResponse),
		RequestId,
	semantic_query_codec:
		PositionedDocumentRequest,
		decode_positioned_document_parameters,
		location_json,


DEFINITION_METHOD: String = "textDocument/definition"

type alias DefinitionRequest = PositionedDocumentRequest


private pure func definition_parameter_error(detail: String) -> ProtocolError:
	document_parameter_error(DEFINITION_METHOD, detail)


pure func decode_lsp_definition_envelope(
	envelope: JsonRpcEnvelope,
) -> ProtocolInputOutcome[DefinitionRequest]:
	method = json_rpc_method(envelope)
	request_id = json_rpc_request_id(envelope)

	if method != DEFINITION_METHOD:
		match request_id:
			Some(_):
				ProtocolInputRejected({
					request_id = request_id,
					error = UnknownMethod(method),
				})
			None:
				ProtocolInputIgnored(UnknownMethod(method))
	else:
		match request_id:
			None:
				ProtocolInputIgnored(MissingRequestId(DEFINITION_METHOD))
			Some(id):
				match json_rpc_parameters(envelope):
					None:
						ProtocolInputRejected({
							request_id = Some(id),
							error = definition_parameter_error("missing required params object"),
						})
					Some(params):
						match decode_positioned_document_parameters(params, DEFINITION_METHOD):
							Err(error):
								ProtocolInputRejected({
									request_id = Some(id),
									error = error,
								})
							Ok(query):
								ProtocolInputAccepted({
									id = id,
									uri = query[0],
									position = query[1],
								})


pure func encode_lsp_definition_response(
	response: ProtocolResponse[Option[List[Location]], ProtocolFailure],
) -> String:
	match response:
		ProtocolSuccessResponse(id, locations):
			result: JsonValue = match locations:
				Some(found):
					JsonVector(found.map(location_json))
				None:
					JsonNull

			json_rpc_success_value(id, result).to_string()
		ProtocolErrorResponse(failure):
			json_rpc_error_value(failure).to_string()
