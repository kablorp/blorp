-- Pure definition lookup over one immutable workspace snapshot.
--
-- A query never reads the filesystem or guesses from a symbol's spelling. It
-- first resolves the opaque semantic symbol identity at the requested source
-- position, then asks the indexed modules for that exact definition.
import:
	analysis_model:
		IndexCoverage(CompleteIndexCoverage, PartialIndexCoverageState),
		Location,
		ModuleSemanticIndex,
		SemanticIndexSnapshot,
		SemanticIndexState(CurrentSemanticIndex, SemanticIndexUnavailable, StaleSemanticIndex),
		SemanticSymbolId,
		module_semantic_index_definition,
		module_semantic_index_symbol_at,
		module_semantic_index_uri,
	identity: DocumentUri, document_uri_value
	position: ProtocolPosition
	workspace: Workspace, workspace_snapshot


union DefinitionQueryResult:
	DefinitionQueryLocations(List[Location])
	DefinitionQueryUnavailable


private pure func module_uri_is(module: ModuleSemanticIndex, uri: DocumentUri) -> Bool:
	document_uri_value(module_semantic_index_uri(module)) == document_uri_value(uri)


private pure func module_for_uri(
	modules: List[ModuleSemanticIndex],
	uri: DocumentUri,
) -> Option[ModuleSemanticIndex]:
	modules.find(func(module): module_uri_is(module, uri))


private pure func definition_location_in_modules(
	modules: List[ModuleSemanticIndex],
	symbol: SemanticSymbolId,
) -> Option[Location]:
	var found: Option[Location] = None

	for module in modules:
		match module_semantic_index_definition(module, symbol):
			Some(definition):
				found = Some(definition.location)
			None:
				found = found

	found


private pure func definition_from_snapshot(
	index: SemanticIndexSnapshot,
	uri: DocumentUri,
	position: ProtocolPosition,
) -> DefinitionQueryResult:
	match module_for_uri(index.modules, uri):
		None:
			DefinitionQueryUnavailable
		Some(module):
			match module_semantic_index_symbol_at(module, uri, position):
				None:
					DefinitionQueryUnavailable
				Some(symbol):
					match definition_location_in_modules(index.modules, symbol):
						None:
							match index.coverage:
								PartialIndexCoverageState(_):
									DefinitionQueryUnavailable
								CompleteIndexCoverage:
									DefinitionQueryLocations([])
						Some(location):
							DefinitionQueryLocations([location])


pure func definition_query(
	workspace: Workspace,
	uri: DocumentUri,
	position: ProtocolPosition,
) -> DefinitionQueryResult:
	definition_query_snapshot(workspace_snapshot(workspace).semantic_index, uri, position)


pure func definition_query_snapshot(
	semantic_index: SemanticIndexState,
	uri: DocumentUri,
	position: ProtocolPosition,
) -> DefinitionQueryResult:
	match semantic_index:
		CurrentSemanticIndex(index):
			definition_from_snapshot(index, uri, position)
		StaleSemanticIndex(_, _):
			DefinitionQueryUnavailable
		SemanticIndexUnavailable(_):
			DefinitionQueryUnavailable
