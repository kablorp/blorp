-- Pure document-local highlight lookup over one immutable semantic snapshot.
-- A highlight is useful even when dependency projection is incomplete because
-- every returned range belongs to the requested module's exact symbol index.
import:
	analysis_model:
		ModuleSemanticIndex,
		SemanticIndexSnapshot,
		SemanticIndexState(CurrentSemanticIndex, SemanticIndexUnavailable, StaleSemanticIndex),
		SemanticSymbolId,
		module_semantic_index_references_for_symbol,
		module_semantic_index_symbol_at,
		semantic_index_module_for_uri,
	identity: DocumentUri
	position: ProtocolPosition, ProtocolRange


record DocumentHighlight {
	range: ProtocolRange
}


private HIGHLIGHT_LOCATION_SORT_WIDTH: Int = 11


private pure func padded_highlight_sort_number(value: Int) -> String:
	value
		.to_string()
		.pad_left(HIGHLIGHT_LOCATION_SORT_WIDTH, '0')


private pure func document_highlight_sort_key(highlight: DocumentHighlight) -> String:
	padded_highlight_sort_number(
		highlight.range.start.line,
	) + padded_highlight_sort_number(
		highlight.range.start.utf16_character,
	) + padded_highlight_sort_number(
		highlight.range.end.line,
	) + padded_highlight_sort_number(highlight.range.end.utf16_character)


private pure func document_highlights_for_symbol(
	module: ModuleSemanticIndex,
	symbol: SemanticSymbolId,
) -> List[DocumentHighlight]:
	module_semantic_index_references_for_symbol(module, symbol)
		.map(func(reference):
			{range = reference.location.range}
		)
		.sort_by(document_highlight_sort_key)


private pure func document_highlights_from_snapshot(
	index: SemanticIndexSnapshot,
	uri: DocumentUri,
	position: ProtocolPosition,
) -> Option[List[DocumentHighlight]]:
	module ?= semantic_index_module_for_uri(index, uri)
	symbol ?= module_semantic_index_symbol_at(module, uri, position)
	Some(document_highlights_for_symbol(module, symbol))


pure func document_highlights_query_snapshot(
	semantic_index: SemanticIndexState,
	uri: DocumentUri,
	position: ProtocolPosition,
) -> Option[List[DocumentHighlight]]:
	match semantic_index:
		CurrentSemanticIndex(index):
			document_highlights_from_snapshot(index, uri, position)
		StaleSemanticIndex(_, _):
			None
		SemanticIndexUnavailable(_):
			None
