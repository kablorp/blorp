-- Shared wire values for position-based semantic queries.
-- Endpoint admission and result shape stay in their feature modules; only the
-- protocol's repeated document-position and location shapes are centralized.
import:
	analysis_model: Location
	document_sync_codec: document_parameter_error, required_object_field, required_string_field
	identity: DocumentUri, document_uri, document_uri_value
	json: JsonValue(JsonNumber, JsonObject, JsonString), get_field
	json_rpc: integer_from_json
	position: ProtocolPosition, ProtocolRange, position
	protocol: ProtocolError, RequestId


record PositionedDocumentRequest {
	id: RequestId,
	uri: DocumentUri,
	position: ProtocolPosition
}


private pure func required_nonnegative_integer_field(
	value: JsonValue,
	name: String,
	method: String,
) -> Result[Int, ProtocolError]:
	match get_field(value, name):
		None:
			Err(document_parameter_error(method, "missing required `${name}` integer"))
		Some(field):
			match integer_from_json(field):
				None:
					Err(
						document_parameter_error(
							method,
							"`${name}` must be a signed 32-bit integer",
						),
					)
				Some(integer):
					if integer < 0:
						Err(document_parameter_error(method, "`${name}` must be non-negative"))
					else:
						Ok(integer)


private pure func required_protocol_position(
	value: JsonValue,
	method: String,
) -> Result[ProtocolPosition, ProtocolError]:
	line ?= required_nonnegative_integer_field(value, "line", method)
	character ?= required_nonnegative_integer_field(value, "character", method)
	Ok(position(line, character))


pure func decode_positioned_document_parameters(
	params: JsonValue,
	method: String,
) -> Result[(DocumentUri, ProtocolPosition), ProtocolError]:
	match params:
		JsonObject(_):
			text_document ?= required_object_field(params, "textDocument", method)
			uri ?= required_string_field(text_document, "uri", method)
			position_value ?= required_object_field(params, "position", method)
			query_position ?= required_protocol_position(position_value, method)
			Ok((document_uri(uri), query_position))
		_:
			Err(document_parameter_error(method, "params must be an object"))


pure func protocol_position_json(position: ProtocolPosition) -> JsonValue:
	JsonObject([
		("line", JsonNumber(to_float(position.line))),
		("character", JsonNumber(to_float(position.utf16_character))),
	])


pure func protocol_range_json(range: ProtocolRange) -> JsonValue:
	JsonObject([
		("start", protocol_position_json(range.start)),
		("end", protocol_position_json(range.end)),
	])


pure func location_json(location: Location) -> JsonValue:
	JsonObject([
		("uri", JsonString(document_uri_value(location.uri))),
		("range", protocol_range_json(location.range)),
	])
