-- Typed admission boundary for synchronous semantic LSP requests.
--
-- Each semantic codec owns its wire contract. This module owns the common
-- routing decision and preserves unhandled envelopes for document/lifecycle
-- dispatch, so the actor does not duplicate method-name checks or decode
-- outcomes. Query execution captures one immutable workspace snapshot in the
-- actor before invoking the selected query.
import:
	definition: DEFINITION_METHOD, DefinitionRequest, decode_lsp_definition_envelope
	document_highlight:
		DOCUMENT_HIGHLIGHT_METHOD,
		DocumentHighlightRequest,
		decode_lsp_document_highlight_envelope,
	document_symbol:
		DOCUMENT_SYMBOL_METHOD,
		DocumentSymbolRequest,
		decode_lsp_document_symbol_envelope,
	hover: HOVER_METHOD, HoverRequest, decode_lsp_hover_envelope
	json_rpc: JsonRpcEnvelope, json_rpc_method
	protocol:
		ProtocolError,
		ProtocolFailure,
		ProtocolInputOutcome(ProtocolInputAccepted, ProtocolInputIgnored, ProtocolInputRejected),
	references: REFERENCES_METHOD, ReferencesRequest, decode_lsp_references_envelope


union SemanticQueryRequest:
	DefinitionSemanticQuery(DefinitionRequest)
	DocumentSymbolSemanticQuery(DocumentSymbolRequest)
	DocumentHighlightSemanticQuery(DocumentHighlightRequest)
	ReferencesSemanticQuery(ReferencesRequest)
	HoverSemanticQuery(HoverRequest)


union SemanticQueryDispatch:
	SemanticQueryAccepted(SemanticQueryRequest)
	SemanticQueryRejected(ProtocolFailure)
	SemanticQueryIgnored(ProtocolError)
	SemanticQueryUnhandled(JsonRpcEnvelope)


private pure func dispatch_definition_query(envelope: JsonRpcEnvelope) -> SemanticQueryDispatch:
	match decode_lsp_definition_envelope(envelope):
		ProtocolInputAccepted(request):
			SemanticQueryAccepted(DefinitionSemanticQuery(request))
		ProtocolInputRejected(failure):
			SemanticQueryRejected(failure)
		ProtocolInputIgnored(error):
			SemanticQueryIgnored(error)


private pure func dispatch_document_symbol_query(
	envelope: JsonRpcEnvelope,
) -> SemanticQueryDispatch:
	match decode_lsp_document_symbol_envelope(envelope):
		ProtocolInputAccepted(request):
			SemanticQueryAccepted(DocumentSymbolSemanticQuery(request))
		ProtocolInputRejected(failure):
			SemanticQueryRejected(failure)
		ProtocolInputIgnored(error):
			SemanticQueryIgnored(error)


private pure func dispatch_document_highlight_query(
	envelope: JsonRpcEnvelope,
) -> SemanticQueryDispatch:
	match decode_lsp_document_highlight_envelope(envelope):
		ProtocolInputAccepted(request):
			SemanticQueryAccepted(DocumentHighlightSemanticQuery(request))
		ProtocolInputRejected(failure):
			SemanticQueryRejected(failure)
		ProtocolInputIgnored(error):
			SemanticQueryIgnored(error)


private pure func dispatch_references_query(envelope: JsonRpcEnvelope) -> SemanticQueryDispatch:
	match decode_lsp_references_envelope(envelope):
		ProtocolInputAccepted(request):
			SemanticQueryAccepted(ReferencesSemanticQuery(request))
		ProtocolInputRejected(failure):
			SemanticQueryRejected(failure)
		ProtocolInputIgnored(error):
			SemanticQueryIgnored(error)


private pure func dispatch_hover_query(envelope: JsonRpcEnvelope) -> SemanticQueryDispatch:
	match decode_lsp_hover_envelope(envelope):
		ProtocolInputAccepted(request):
			SemanticQueryAccepted(HoverSemanticQuery(request))
		ProtocolInputRejected(failure):
			SemanticQueryRejected(failure)
		ProtocolInputIgnored(error):
			SemanticQueryIgnored(error)


pure func dispatch_lsp_semantic_query(envelope: JsonRpcEnvelope) -> SemanticQueryDispatch:
	method = json_rpc_method(envelope)

	if method == DEFINITION_METHOD:
		dispatch_definition_query(envelope)
	else if method == DOCUMENT_SYMBOL_METHOD:
		dispatch_document_symbol_query(envelope)
	else if method == DOCUMENT_HIGHLIGHT_METHOD:
		dispatch_document_highlight_query(envelope)
	else if method == REFERENCES_METHOD:
		dispatch_references_query(envelope)
	else if method == HOVER_METHOD:
		dispatch_hover_query(envelope)
	else:
		SemanticQueryUnhandled(envelope)
