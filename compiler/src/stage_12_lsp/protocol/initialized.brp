-- The initialized notification completes the LSP initialization handshake.
--
-- Decoding an existing envelope lets the eventual router parse JSON exactly
-- once. The raw-body entry point remains a thin convenience for focused tests
-- and other callers that do not yet own a router.
import:
	json: JsonValue(JsonObject)
	json_rpc:
		JsonRpcEnvelope,
		decode_lsp_json_rpc_body,
		json_rpc_method,
		json_rpc_parameters,
		json_rpc_request_id,
	lifecycle_model:
		InitializedNotification(ClientInitialized),
		LifecycleError,
		LifecycleState,
		lifecycle_accept_initialized,
	protocol:
		ProtocolError(InvalidMethodParameters, UnexpectedRequestId, UnknownMethod),
		ProtocolInputOutcome(ProtocolInputAccepted, ProtocolInputIgnored, ProtocolInputRejected),


private INITIALIZED_METHOD: String = "initialized"


pure func initialized_method() -> String:
	INITIALIZED_METHOD


private pure func initialized_parameter_error(detail: String) -> ProtocolError:
	InvalidMethodParameters(INITIALIZED_METHOD, detail)


pure func decode_lsp_initialized_envelope(
	envelope: JsonRpcEnvelope,
) -> ProtocolInputOutcome[InitializedNotification]:
	method = json_rpc_method(envelope)
	request_id = json_rpc_request_id(envelope)

	if method != INITIALIZED_METHOD:
		match request_id:
			Some(_):
				ProtocolInputRejected({
					request_id = request_id,
					error = UnknownMethod(method),
				})
			None:
				ProtocolInputIgnored(UnknownMethod(method))
	else:
		match request_id:
			Some(_):
				ProtocolInputRejected({
					request_id = request_id,
					error = UnexpectedRequestId(method),
				})
			None:
				match json_rpc_parameters(envelope):
					None:
						ProtocolInputAccepted(ClientInitialized)
					Some(JsonObject(_)):
						ProtocolInputAccepted(ClientInitialized)
					Some(_):
						ProtocolInputIgnored(
							initialized_parameter_error("params must be an object"),
						)


pure func decode_lsp_initialized_notification(
	body: String,
) -> ProtocolInputOutcome[InitializedNotification]:
	match decode_lsp_json_rpc_body(body):
		Err(failure):
			ProtocolInputRejected(failure)
		Ok(envelope):
			decode_lsp_initialized_envelope(envelope)


pure func handle_lsp_initialized_notification(
	state: LifecycleState,
	notification: InitializedNotification,
) -> Result[LifecycleState, LifecycleError]:
	lifecycle_accept_initialized(state, notification)
