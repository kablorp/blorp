-- Decoder for full-sync textDocument/didChange notifications.
--
-- Full replacement keeps synchronization independent of UTF-16 range mapping.
-- Incremental events remain invalid until the position mapper can apply them
-- against the exact prior document revision.
import:
	../protocol/document_sync_codec:
		document_parameter_error,
		required_document_version,
		required_object_field,
		required_string_field,
	../protocol/identity: document_uri
	../protocol/json_rpc:
		JsonRpcEnvelope,
		decode_lsp_json_rpc_body,
		json_rpc_method,
		json_rpc_parameters,
		json_rpc_request_id,
	../protocol/protocol:
		ProtocolError(UnexpectedRequestId, UnknownMethod),
		ProtocolInputOutcome(ProtocolInputAccepted, ProtocolInputIgnored, ProtocolInputRejected),
	document_model: DocumentChange
	document_store: DocumentStore, DocumentStoreError, document_store_change
	json: JsonValue(JsonObject, JsonVector), get_field


DID_CHANGE_METHOD: String = "textDocument/didChange"


private pure func did_change_parameter_error(detail: String) -> ProtocolError:
	document_parameter_error(DID_CHANGE_METHOD, detail)


private pure func decode_full_content_change(change: JsonValue) -> Result[String, ProtocolError]:
	match change:
		JsonObject(_):
			match get_field(change, "range"):
				Some(_):
					Err(
						did_change_parameter_error(
							"incremental `range` changes are not supported by full synchronization",
						),
					)
				None:
					match get_field(change, "rangeLength"):
						Some(_):
							Err(
								did_change_parameter_error(
									"incremental `rangeLength` changes are not supported by full synchronization",
								),
							)
						None:
							required_string_field(change, "text", DID_CHANGE_METHOD)
		_:
			Err(did_change_parameter_error("each `contentChanges` entry must be an object"))


private pure func decode_last_full_content_change(
	changes: List[JsonValue],
) -> Result[Option[String], ProtocolError]:
	match changes:
		[]:
			Ok(None)
		[change]:
			match decode_full_content_change(change):
				Ok(text):
					Ok(Some(text))
				Err(error):
					Err(error)
		[change, ...remaining]:
			match decode_full_content_change(change):
				Ok(_):
					decode_last_full_content_change(remaining)
				Err(error):
					Err(error)


private pure func decode_content_changes(
	params: JsonValue,
) -> Result[Option[String], ProtocolError]:
	match get_field(params, "contentChanges"):
		Some(JsonVector(changes)):
			decode_last_full_content_change(changes)
		Some(_):
			Err(did_change_parameter_error("`contentChanges` must be an array"))
		None:
			Err(did_change_parameter_error("missing required `contentChanges` array"))


private pure func decode_did_change_parameters(
	params: JsonValue,
) -> Result[DocumentChange, ProtocolError]:
	match params:
		JsonObject(_):
			text_document ?= required_object_field(params, "textDocument", DID_CHANGE_METHOD)
			uri ?= required_string_field(text_document, "uri", DID_CHANGE_METHOD)
			version ?= required_document_version(text_document, DID_CHANGE_METHOD)
			replacement_text ?= decode_content_changes(params)

			Ok({
				uri = document_uri(uri),
				version = version,
				replacement_text = replacement_text,
			})
		_:
			Err(did_change_parameter_error("params must be an object"))


pure func decode_lsp_did_change_envelope(
	envelope: JsonRpcEnvelope,
) -> ProtocolInputOutcome[DocumentChange]:
	method = json_rpc_method(envelope)
	request_id = json_rpc_request_id(envelope)

	if method != DID_CHANGE_METHOD:
		match request_id:
			Some(_):
				ProtocolInputRejected({
					request_id = request_id,
					error = UnknownMethod(method),
				})
			None:
				ProtocolInputIgnored(UnknownMethod(method))
	else:
		match request_id:
			Some(_):
				ProtocolInputRejected({
					request_id = request_id,
					error = UnexpectedRequestId(method),
				})
			None:
				match json_rpc_parameters(envelope):
					None:
						ProtocolInputIgnored(
							did_change_parameter_error("missing required params object"),
						)
					Some(params):
						match decode_did_change_parameters(params):
							Ok(changed):
								ProtocolInputAccepted(changed)
							Err(error):
								ProtocolInputIgnored(error)


pure func decode_lsp_did_change_notification(body: String) -> ProtocolInputOutcome[DocumentChange]:
	match decode_lsp_json_rpc_body(body):
		Err(failure):
			ProtocolInputRejected(failure)
		Ok(envelope):
			decode_lsp_did_change_envelope(envelope)


pure func handle_lsp_did_change_notification(
	store: DocumentStore,
	changed: DocumentChange,
) -> Result[DocumentStore, DocumentStoreError]:
	document_store_change(store, changed)
