-- Data crossing the serialized server actor boundary. These unions contain no
-- effect interpretation so tests and future transport/worker loops share one
-- closed vocabulary without importing the actor's private state.
import:
	../analysis/architecture: AnalysisCompletion, AnalysisRequest, CancellationToken, WorkspaceError
	../analysis/diagnostic_model: DiagnosticPublication
	../protocol/identity: DocumentUri
	../protocol/json_rpc: JsonRpcEnvelope
	../protocol/lifecycle_model: ServerExitStatus
	../workspace/document_model: OpenedDocument
	../workspace/snapshot_model: SnapshotIdentity
	../workspace/source_loader:
		FatalSourceLoadError,
		OpenSourceResolutionError,
		SavedSourceRefreshError,
		SourceLoadIssue,
		SourceLoadRequest,
	../workspace/workspace: Workspace
	../workspace/workspace_model: DiscoveredSourceSnapshot, ResolvedDocumentOpen


-- Source loading is asynchronous. An opaque scalar identity prevents a delayed
-- completion from an earlier initialize attempt from satisfying a later retry.
opaque type SourceLoadToken = Int


pure func source_load_token(value: Int) -> SourceLoadToken:
	into SourceLoadToken(value)


pure func source_load_token_value(token: SourceLoadToken) -> Int:
	from SourceLoadToken(token)


union DocumentSyncIssue:
	DocumentOpenResolutionIssue(DocumentUri, OpenSourceResolutionError)
	SavedSourceRefreshIssue(DocumentUri, SavedSourceRefreshError)
	DocumentWorkspaceIssue(WorkspaceError)


union ServerEvent:
	ServerClientEnvelope(JsonRpcEnvelope)
	ServerSourceLoadSucceeded(SourceLoadToken, Workspace, List[SourceLoadIssue])
	ServerSourceLoadFailed(SourceLoadToken, FatalSourceLoadError)
	ServerDocumentOpenResolved(ResolvedDocumentOpen)
	ServerDocumentOpenResolutionFailed(DocumentUri, OpenSourceResolutionError)
	ServerSavedSourceUpdated(DiscoveredSourceSnapshot)
	ServerSavedSourceRemoved(DocumentUri)
	ServerSavedSourceRefreshFailed(DocumentUri, SavedSourceRefreshError)
	ServerAnalysisCompleted(AnalysisCompletion)


-- For document filesystem effects, the interpreter reads configuration from
-- the accompanying ready state and completes the command before dequeuing the
-- next client event. This preserves didOpen/change and didSave/close ordering.
union ServerEffect:
	LoadWorkspace(SourceLoadToken, SourceLoadRequest)
	ResolveOpenDocument(OpenedDocument)
	RefreshSavedSource(DocumentUri)
	ReportSourceLoadIssues(List[SourceLoadIssue])
	ReportDocumentSyncIssue(DocumentSyncIssue)
	SendMessage(String)
	OperationalEnvelopeReady(JsonRpcEnvelope)
	ExitServer(ServerExitStatus)
	StartAnalysis(AnalysisRequest)
	CancelAnalysis(CancellationToken)
	PublishDiagnostics(DiagnosticPublication)
	ClearDiagnostics(SnapshotIdentity)
	AnalysisPlanningFailed(WorkspaceError)
	AnalysisCompletionRejected(WorkspaceError)
