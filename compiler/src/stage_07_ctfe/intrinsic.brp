-- Compiler-owned std operations admitted to compile-time evaluation.
--
-- Keep source-name admission centralized here so CTFE support does not spread
-- across evaluator branches as ad-hoc string checks.
STD_LIST_MODULE_PATH: String = "std/list"

STD_MATRIX_MODULE_PATH: String = "std/matrix"

STD_DICT_MODULE_PATH: String = "std/dict"

STD_OPTION_MODULE_PATH: String = "std/option"

STD_RESULT_MODULE_PATH: String = "std/result"

STD_STRING_MODULE_PATH: String = "std/string"

STD_FLOAT_MODULE_PATH: String = "std/float"


union CtfeBuiltinIntrinsic:
	CtfeFromCharIntrinsic
	CtfeFromCharsIntrinsic
	CtfeLengthIntrinsic
	CtfeTensorFillIntrinsic(Int)
	CtfeToFloat16Intrinsic
	CtfeToFloat32Intrinsic
	CtfeToStringIntrinsic


pure func ctfe_builtin_intrinsic(source_name: String) -> Option[CtfeBuiltinIntrinsic]:
	match source_name:
		"from_char":
			Some(CtfeFromCharIntrinsic)
		"from_chars":
			Some(CtfeFromCharsIntrinsic)
		"length":
			Some(CtfeLengthIntrinsic)
		"vector":
			Some(CtfeTensorFillIntrinsic(1))
		"matrix":
			Some(CtfeTensorFillIntrinsic(2))
		"tensor3":
			Some(CtfeTensorFillIntrinsic(3))
		"tensor4":
			Some(CtfeTensorFillIntrinsic(4))
		"tensor5":
			Some(CtfeTensorFillIntrinsic(5))
		"to_float16":
			Some(CtfeToFloat16Intrinsic)
		"to_float32":
			Some(CtfeToFloat32Intrinsic)
		"to_string":
			Some(CtfeToStringIntrinsic)
		_:
			None


enum CtfeListIntrinsic:
	CtfeListAll
	CtfeListAppend
	CtfeListAny
	CtfeListConcat
	CtfeListContains
	CtfeListFilter
	CtfeListFilterMap
	CtfeListFlatMap
	CtfeListFoldLeft
	CtfeListFoldRight
	CtfeListGet
	CtfeListGetOr
	CtfeListJoin
	CtfeListLength
	CtfeListMake
	CtfeListMap
	CtfeListMapIndexed
	CtfeListSet


enum CtfeMatrixIntrinsic:
	CtfeMatrixColumnCount
	CtfeMatrixRowCount


enum CtfeDictIntrinsic:
	CtfeDictContains
	CtfeDictFromList
	CtfeDictGet
	CtfeDictGetOr
	CtfeDictIsEmpty
	CtfeDictLength
	CtfeDictSet


enum CtfeOptionIntrinsic:
	CtfeOptionAndThen
	CtfeOptionFilter
	CtfeOptionGetOr
	CtfeOptionGetOrElse
	CtfeOptionIsNone
	CtfeOptionIsSome
	CtfeOptionMap
	CtfeOptionToResult


enum CtfeResultIntrinsic:
	CtfeResultAndThen
	CtfeResultFromOption
	CtfeResultGetOr
	CtfeResultGetOrElse
	CtfeResultIsErr
	CtfeResultIsOk
	CtfeResultMap
	CtfeResultMapErr
	CtfeResultToOption


enum CtfeStringIntrinsic:
	CtfeStringChars
	CtfeStringCount
	CtfeStringContains
	CtfeStringDropLeft
	CtfeStringEndsWith
	CtfeStringFromChar
	CtfeStringFromChars
	CtfeStringGet
	CtfeStringGetOr
	CtfeStringIndexOf
	CtfeStringLength
	CtfeStringLower
	CtfeStringRawIndexOf
	CtfeStringRepeat
	CtfeStringReplace
	CtfeStringReverse
	CtfeStringSplit
	CtfeStringStartsWith
	CtfeStringSubstring
	CtfeStringTakeLeft
	CtfeStringTrim
	CtfeStringTrimLeft
	CtfeStringTrimRight
	CtfeStringUpper


union CtfeImportedIntrinsic:
	CtfeImportedBuiltinIntrinsic(CtfeBuiltinIntrinsic)
	CtfeImportedDictIntrinsic(CtfeDictIntrinsic)
	CtfeImportedListIntrinsic(CtfeListIntrinsic)
	CtfeImportedMatrixIntrinsic(CtfeMatrixIntrinsic)
	CtfeImportedOptionIntrinsic(CtfeOptionIntrinsic)
	CtfeImportedResultIntrinsic(CtfeResultIntrinsic)
	CtfeImportedStringIntrinsic(CtfeStringIntrinsic)


private pure func ctfe_list_intrinsic(source_name: String) -> Option[CtfeListIntrinsic]:
	match source_name:
		"all":
			Some(CtfeListAll)
		"append":
			Some(CtfeListAppend)
		"any":
			Some(CtfeListAny)
		"concat":
			Some(CtfeListConcat)
		"contains":
			Some(CtfeListContains)
		"filter":
			Some(CtfeListFilter)
		"filter_map":
			Some(CtfeListFilterMap)
		"flat_map":
			Some(CtfeListFlatMap)
		"fold_left":
			Some(CtfeListFoldLeft)
		"fold_right":
			Some(CtfeListFoldRight)
		"get":
			Some(CtfeListGet)
		"get_or":
			Some(CtfeListGetOr)
		"join":
			Some(CtfeListJoin)
		"length":
			Some(CtfeListLength)
		"list":
			Some(CtfeListMake)
		"map":
			Some(CtfeListMap)
		"map_indexed":
			Some(CtfeListMapIndexed)
		"set":
			Some(CtfeListSet)
		_:
			None


private pure func ctfe_option_intrinsic(source_name: String) -> Option[CtfeOptionIntrinsic]:
	match source_name:
		"and_then":
			Some(CtfeOptionAndThen)
		"filter":
			Some(CtfeOptionFilter)
		"get_or":
			Some(CtfeOptionGetOr)
		"get_or_else":
			Some(CtfeOptionGetOrElse)
		"is_none":
			Some(CtfeOptionIsNone)
		"is_some":
			Some(CtfeOptionIsSome)
		"map":
			Some(CtfeOptionMap)
		"to_result":
			Some(CtfeOptionToResult)
		_:
			None


private pure func ctfe_matrix_intrinsic(source_name: String) -> Option[CtfeMatrixIntrinsic]:
	match source_name:
		"column_count":
			Some(CtfeMatrixColumnCount)
		"row_count":
			Some(CtfeMatrixRowCount)
		_:
			None


private pure func ctfe_result_intrinsic(source_name: String) -> Option[CtfeResultIntrinsic]:
	match source_name:
		"and_then":
			Some(CtfeResultAndThen)
		"from_option":
			Some(CtfeResultFromOption)
		"get_or":
			Some(CtfeResultGetOr)
		"get_or_else":
			Some(CtfeResultGetOrElse)
		"is_err":
			Some(CtfeResultIsErr)
		"is_ok":
			Some(CtfeResultIsOk)
		"map":
			Some(CtfeResultMap)
		"map_err":
			Some(CtfeResultMapErr)
		"to_option":
			Some(CtfeResultToOption)
		_:
			None


private pure func ctfe_string_intrinsic(source_name: String) -> Option[CtfeStringIntrinsic]:
	match source_name:
		"chars":
			Some(CtfeStringChars)
		"count":
			Some(CtfeStringCount)
		"contains":
			Some(CtfeStringContains)
		"drop_left":
			Some(CtfeStringDropLeft)
		"ends_with":
			Some(CtfeStringEndsWith)
		"from_char":
			Some(CtfeStringFromChar)
		"from_chars":
			Some(CtfeStringFromChars)
		"get":
			Some(CtfeStringGet)
		"get_or":
			Some(CtfeStringGetOr)
		"index_of":
			Some(CtfeStringIndexOf)
		"length":
			Some(CtfeStringLength)
		"lower":
			Some(CtfeStringLower)
		"raw_index_of":
			Some(CtfeStringRawIndexOf)
		"repeat":
			Some(CtfeStringRepeat)
		"replace":
			Some(CtfeStringReplace)
		"reverse":
			Some(CtfeStringReverse)
		"split":
			Some(CtfeStringSplit)
		"starts_with":
			Some(CtfeStringStartsWith)
		"substring":
			Some(CtfeStringSubstring)
		"take_left":
			Some(CtfeStringTakeLeft)
		"trim":
			Some(CtfeStringTrim)
		"trim_left":
			Some(CtfeStringTrimLeft)
		"trim_right":
			Some(CtfeStringTrimRight)
		"upper":
			Some(CtfeStringUpper)
		_:
			None


private pure func ctfe_dict_intrinsic(source_name: String) -> Option[CtfeDictIntrinsic]:
	match source_name:
		"contains":
			Some(CtfeDictContains)
		"from_list":
			Some(CtfeDictFromList)
		"get":
			Some(CtfeDictGet)
		"get_or":
			Some(CtfeDictGetOr)
		"is_empty":
			Some(CtfeDictIsEmpty)
		"length":
			Some(CtfeDictLength)
		"set":
			Some(CtfeDictSet)
		_:
			None


pure func ctfe_imported_intrinsic(
	module_path: String,
	source_name: String,
) -> Option[CtfeImportedIntrinsic]:
	if module_path == STD_FLOAT_MODULE_PATH:
		match ctfe_builtin_intrinsic(source_name):
			Some(op):
				Some(CtfeImportedBuiltinIntrinsic(op))
			None:
				None
	else if module_path == STD_DICT_MODULE_PATH:
		match ctfe_dict_intrinsic(source_name):
			Some(op):
				Some(CtfeImportedDictIntrinsic(op))
			None:
				None
	else if module_path == STD_LIST_MODULE_PATH:
		match ctfe_list_intrinsic(source_name):
			Some(op):
				Some(CtfeImportedListIntrinsic(op))
			None:
				None
	else if module_path == STD_MATRIX_MODULE_PATH:
		match ctfe_matrix_intrinsic(source_name):
			Some(op):
				Some(CtfeImportedMatrixIntrinsic(op))
			None:
				None
	else if module_path == STD_OPTION_MODULE_PATH:
		match ctfe_option_intrinsic(source_name):
			Some(op):
				Some(CtfeImportedOptionIntrinsic(op))
			None:
				None
	else if module_path == STD_RESULT_MODULE_PATH:
		match ctfe_result_intrinsic(source_name):
			Some(op):
				Some(CtfeImportedResultIntrinsic(op))
			None:
				None
	else if module_path == STD_STRING_MODULE_PATH:
		match ctfe_string_intrinsic(source_name):
			Some(op):
				Some(CtfeImportedStringIntrinsic(op))
			None:
				None
	else:
		None
