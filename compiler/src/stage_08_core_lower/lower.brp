-- Typed AST -> Core lowering for the Blorp-owned frontend.
--
-- This starts with the phase-boundary primitives shared by every lowering
-- case: source locations, type conversion, stable variables, and simple
-- expressions/declarations. Unsupported shapes return explicit errors so the
-- production handoff cannot silently produce partial Core.
import:
	../stage_01_file_io/source: SourceSpan
	../stage_03_parse/parsed_ast:
		ParsedBinaryOp(
			ParsedAddOp,
			ParsedDivideOp,
			ParsedEqualOp,
			ParsedGreaterEqualOp,
			ParsedGreaterOp,
			ParsedLessEqualOp,
			ParsedLessOp,
			ParsedModuloOp,
			ParsedMultiplyOp,
			ParsedNotEqualOp,
			ParsedSubtractOp,
		),
		ParsedDecl(BuiltinTypeParsedDecl, ImportBlockParsedDecl, PrivateParsedDecl),
		ParsedForBinder(ParsedForNameBinder, ParsedForTupleBinder),
		ParsedFunctionBodyKind(
			ParsedFunctionBuiltinBody,
			ParsedFunctionForwardDecl,
			ParsedFunctionSourceBody,
		),
		ParsedIdentifier,
		ParsedListPatternSpread(ParsedListSpreadName, ParsedListSpreadWildcard),
		ParsedLogicalOp(ParsedAndOp, ParsedOrOp),
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder, ParsedParamTupleBinder, ParsedParamWildcardBinder),
		ParsedTypeParamDecl,
		ParsedUnaryOp(ParsedNegateOp, ParsedNotOp),
		parsed_function_body_kind,
