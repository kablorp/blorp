private pure func lower_core_patterns(
	patterns: List[TypedPattern],
) -> Result[List[CorePattern], CoreLowerError]:
	var lowered: List[CorePattern] = []
	var failure: Option[CoreLowerError] = None

	for pattern in patterns:
		if failure.is_none():
			match lower_core_pattern(pattern):
				Ok(lowered_pattern):
					lowered = lowered.append(lowered_pattern)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_core_pattern(pattern: TypedPattern) -> Result[CorePattern, CoreLowerError]:
	match pattern:
		TypedWildcardPattern(_):
			Ok(WildcardPattern)
		TypedNamePattern(name, _):
			Ok(NamePattern(name.text))
		TypedBoolPattern(value, _):
			Ok(LiteralPattern(BoolLiteral(value)))
		TypedIntPattern(value, _):
			Ok(LiteralPattern(core_literal_int(value)))
		TypedFloatPattern(value, _):
			Ok(LiteralPattern(core_literal_float(value)))
		TypedStringPattern(value, _):
			Ok(LiteralPattern(StringLiteral(value)))
		TypedCharPattern(value, _):
			Ok(LiteralPattern(CharLiteral(value)))
		TypedConstructorPattern(name, args, _, _):
			lowered_args ?= lower_core_patterns(args)
			Ok(ConstructorPattern(name.text, lowered_args))
		TypedQualifiedConstructorPattern(module_name, name, args, _, _):
			lowered_args ?= lower_core_patterns(args)
			Ok(QualifiedConstructorPattern(module_name.text, name.text, lowered_args))
		TypedTuplePattern(items, _):
			lowered_items ?= lower_core_patterns(items)
			Ok(TuplePattern(lowered_items))
		TypedListPattern(items, spread, _):
			lowered_items ?= lower_core_patterns(items)

			lowered_spread = match spread:
				Some(ParsedListSpreadName(name)):
					Some(NamePattern(name.text))
				Some(ParsedListSpreadWildcard(_)):
					Some(WildcardPattern)
				None:
					None

			Ok(ListPattern(lowered_items, lowered_spread))
		TypedOrPattern(items, _):
			lowered_items ?= lower_core_patterns(items)
			Ok(OrPattern(lowered_items))
		TypedUnsupportedPattern(label, _):
			Err(CoreLowerUnsupported("match pattern: " + label))


private pure func core_binary_op(op: ParsedBinaryOp) -> CoreBinaryOp:
	match op:
		ParsedAddOp:
			AddOp
		ParsedSubtractOp:
			SubtractOp
		ParsedMultiplyOp:
			MultiplyOp
		ParsedDivideOp:
			DivideOp
		ParsedModuloOp:
			ModuloOp
		ParsedEqualOp:
			EqualOp
		ParsedNotEqualOp:
			NotEqualOp
		ParsedLessOp:
			LessOp
		ParsedLessEqualOp:
			LessEqualOp
		ParsedGreaterOp:
			GreaterOp
		ParsedGreaterEqualOp:
			GreaterEqualOp


private pure func core_unary_op(op: ParsedUnaryOp) -> CoreUnaryOp:
	match op:
		ParsedNegateOp:
			NegateOp
		ParsedNotOp:
			NotOp


private pure func core_logical_op(op: ParsedLogicalOp) -> CoreLogicalOp:
	match op:
		ParsedAndOp:
			AndOp
		ParsedOrOp:
			OrOp


private pure func decimal_magnitude_text(text: String) -> String:
	start: Int = if text.starts_with("-") or text.starts_with("+"):
		1
	else:
		0

	var index: Int = start

	while index < text.length() and text.get_or(index, '0') == '0':
		index += 1

	var result: String = ""

	while index < text.length():
		ch: Char = text.get_or(index, ' ')

		if ch >= '0' and ch <= '9':
			result += ch.to_string()

		index += 1

	if result.length() == 0:
		"0"
	else:
		result


private pure func decimal_text_leq_same_length(left: String, right: String) -> Bool:
	var index: Int = 0
	var decided: Bool = False
	var result: Bool = True

	while index < left.length() and not decided:
		left_ch: Char = left.get_or(index, '0')
		right_ch: Char = right.get_or(index, '0')

		if left_ch < right_ch:
			decided = True
			result = True
		else if left_ch > right_ch:
			decided = True
			result = False

		index += 1

	result


private pure func decimal_text_leq(left: String, right: String) -> Bool:
	if left.length() < right.length():
		True
	else if left.length() > right.length():
		False
	else:
		decimal_text_leq_same_length(left, right)


private pure func int_literal_fits_core_int(text: String) -> Bool:
	magnitude: String = decimal_magnitude_text(text)

	limit: String = if text.starts_with("-"):
		CORE_INT_MIN_MAGNITUDE_DECIMAL
	else:
		CORE_INT_MAX_DECIMAL

	decimal_text_leq(magnitude, limit)


private pure func core_literal_int(text: String) -> CoreLiteral:
	if int_literal_fits_core_int(text):
		match text.parse_int():
			Some(value):
				IntLiteral(value)
			None:
				WideIntLiteral(text)
	else:
		WideIntLiteral(text)


private pure func core_literal_float(text: String) -> CoreLiteral:
	if text == "inf":
		FloatInfinityLiteral
	else if text == "-inf":
		FloatNegInfinityLiteral
	else if text == "nan":
		FloatNanLiteral
	else:
		FloatTextLiteral(text)


private pure func lower_typed_exprs(
	context: CoreLowerContext,
	exprs: List[TypedExpr],
) -> Result[List[CoreExpr], CoreLowerError]:
	var lowered: List[CoreExpr] = []
	var failure: Option[CoreLowerError] = None

	for expr in exprs:
		if failure.is_none():
			match lower_typed_expr_with_context(context, expr):
				Ok(lowered_expr):
					lowered = lowered.append(lowered_expr)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func core_primitive_box_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if args.length() != 0:
				False
			else if name == "Int":
				True
			else if name == "Int8":
				True
			else if name == "Int16":
				True
			else if name == "Int32":
				True
			else if name == "Int64":
				True
			else if name == "UInt8":
				True
			else if name == "UInt16":
				True
			else if name == "UInt32":
				True
			else if name == "UInt64":
				True
			else if name == "Bool":
				True
			else if name == "Char":
				True
			else:
				False
		RangeType:
			True
		_:
			False


private pure func core_box_kind_for_type(typ: CoreType) -> CoreBoxKind:
	match typ:
		VoidType:
			VoidBox
		NamedType(name, args):
			if name == "Float" and args.length() == 0:
				FloatBox
			else if name == "Float32" and args.length() == 0:
				Float32Box
			else if name == "Float16" and args.length() == 0:
				Float16Box
			else if name == "Int128" and args.length() == 0:
				Int128Box
			else if name == "UInt128" and args.length() == 0:
				UInt128Box
			else if core_primitive_box_type(typ):
				PrimBox
			else:
				PointerBox
		_:
			if core_primitive_box_type(typ):
				PrimBox
			else:
				PointerBox


private pure func core_boxed_value_needs_release_type(typ: CoreType, kind: CoreBoxKind) -> Bool:
	match kind:
		PointerBox:
			match typ:
				NamedType(name, args):
					if name == "String" and args.length() == 0:
						True
					else if name == "Bytes" and args.length() == 0:
						True
					else if name == "Fixed" and args.length() == 0:
						True
					else if name == "Closure" and args.length() == 0:
						True
					else if name == "List" and args.length() == 1:
						True
					else if name == "Dict" and args.length() == 2:
						True
					else if name == "Set" and args.length() == 1:
						True
					else if name == "Channel" and args.length() == 1:
						True
					else if name == "Result" and args.length() == 2:
						True
					else:
						False
				TupleType(_):
					True
				TensorType(_):
					True
				_:
					False
		Int128Box:
			True
		UInt128Box:
			True
		_:
			False


private pure func core_boxed_storage_value_for_expr(
	expr: CoreExpr,
	typ: CoreType,
) -> CoreBoxedStorageValue:
	kind: CoreBoxKind = core_box_kind_for_type(typ)

	{
		kind = kind,
		value = expr,
		needs_release = core_boxed_value_needs_release_type(typ, kind),
		transfers_ownership = False
	}


private pure func lower_typed_list_items(
	context: CoreLowerContext,
	items: List[TypedExpr],
) -> Result[List[CoreBoxedStorageValue], CoreLowerError]:
	var lowered: List[CoreBoxedStorageValue] = []
	var failure: Option[CoreLowerError] = None

	for item in items:
		if failure.is_none():
			match lower_typed_expr_with_context(context, item):
				Ok(lowered_expr):
					match core_lower_value_type(typed_expr_value_type(item)):
						Ok(item_type):
							lowered = lowered.append(
								core_boxed_storage_value_for_expr(
									lowered_expr,
									item_type,
								),
							)
						Err(error):
							failure = Some(error)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_typed_dict_entries(
	context: CoreLowerContext,
	entries: List[TypedDictEntry],
) -> Result[List[CoreDictLiteralEntry], CoreLowerError]:
	var lowered: List[CoreDictLiteralEntry] = []
	var failure: Option[CoreLowerError] = None

	for entry in entries:
		if failure.is_none():
			match lower_typed_expr_with_context(context, entry.key):
				Ok(key):
					match lower_typed_expr_with_context(context, entry.value):
						Ok(value):
							lowered = lowered.append({
								key = key,
								value = value,
							})
						Err(error):
							failure = Some(error)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_typed_record_fields(
	context: CoreLowerContext,
	fields: List[TypedRecordField],
) -> Result[List[CoreRecordFieldValue], CoreLowerError]:
	var lowered: List[CoreRecordFieldValue] = []
	var failure: Option[CoreLowerError] = None

	for field in fields:
		if failure.is_none():
			match lower_typed_expr_with_context(context, field.value):
				Ok(value):
					lowered = lowered.append({
						name = field.name.text,
						value = value,
					})
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_record_update_field(
	context: CoreLowerContext,
	field: FieldDecl,
	updates: List[CoreRecordFieldValue],
	base_ref: CoreExpr,
	loc: CoreSourceLoc,
) -> Result[CoreRecordFieldValue, CoreLowerError]:
	field_type ?= core_lower_type(field.field_type)

	match updates.find(func(update): update.name == field.name):
		Some(update):
			Ok(update)
		None:
			Ok({
				name = field.name,
				value = FieldExpr(base_ref, field.name, field_type, loc),
			})


private pure func lower_record_update_fields(
	context: CoreLowerContext,
	record_fields: List[FieldDecl],
	updates: List[CoreRecordFieldValue],
	base_ref: CoreExpr,
	loc: CoreSourceLoc,
) -> Result[List[CoreRecordFieldValue], CoreLowerError]:
	match record_fields:
		[]:
			Ok([])
		[field, ...rest]:
			lowered ?= lower_record_update_field(context, field, updates, base_ref, loc)
			lowered_rest ?= lower_record_update_fields(context, rest, updates, base_ref, loc)
			Ok([lowered].concat(lowered_rest))


private pure func lower_typed_record_update(
	context: CoreLowerContext,
	receiver: TypedExpr,
	updates: List[TypedRecordField],
	record_fields: List[FieldDecl],
	span: SourceSpan,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	match typ:
		VoidType:
			Err(CoreLowerInvalidType("record update is missing its checked record shape"))
		_:
			lowered_receiver ?= lower_typed_expr_with_context(context, receiver)
			lowered_updates ?= lower_typed_record_fields(context, updates)
			temp_var: CoreVar = {
				name = "__record_update_" + span.start_offset.to_string(),
				uniq = span.start_offset,
				def_id = None
			}
			base_ref = VarExpr(temp_var, typ, loc)
			fields ?= lower_record_update_fields(
				context,
				record_fields,
				lowered_updates,
				base_ref,
				loc,
			)

			Ok(
				LetExpr(
					temp_var,
					False,
					typ,
					lowered_receiver,
					RecordUpdateExpr(base_ref, fields, typ, loc),
				),
			)


private CORE_STRING_TYPE: CoreType = NamedType("String", [])


private pure func interpolation_to_string_function(typ: CoreType) -> Option[String]:
	match typ:
		NamedType(name, args):
			if args.length() != 0:
				Some("blorp_to_string")
			else:
				match name:
					"String":
						None
					"Float":
						Some("blorp_float_to_string")
					"Float32":
						Some("blorp_float32_to_string")
					"Float16":
						Some("blorp_float16_to_string")
					"Bool":
						Some("blorp_bool_to_string")
					"Char":
						Some("blorp_from_char")
					"Int128":
						Some("blorp_int128_to_string")
					"UInt128":
						Some("blorp_uint128_to_string")
					_:
						Some("blorp_to_string")
		_:
			Some("blorp_to_string")


private pure func interpolation_builtin_call(
	name: String,
	args: List[CoreExpr],
	loc: CoreSourceLoc,
) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		VoidExpr(VoidType, loc),
		args,
		CORE_STRING_TYPE,
		loc,
	)


private pure func lower_string_interpolation_part(
	context: CoreLowerContext,
	part: TypedStringInterpolationPart,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	match part:
		TypedInterpolationLiteral(text):
			Ok(LiteralExpr(StringLiteral(text), CORE_STRING_TYPE, loc))
		TypedInterpolationExpr(expr):
			lowered ?= lower_typed_expr_with_context(context, expr)
			expr_type ?= core_lower_value_type(typed_expr_value_type(expr))

			match interpolation_to_string_function(expr_type):
				Some(function_name):
					Ok(interpolation_builtin_call(function_name, [lowered], loc))
				None:
					Ok(lowered)


private pure func lower_string_interpolation_parts(
	context: CoreLowerContext,
	parts: List[TypedStringInterpolationPart],
	loc: CoreSourceLoc,
) -> Result[List[CoreExpr], CoreLowerError]:
	match parts:
		[]:
			Ok([])
		[part, ...rest]:
			lowered ?= lower_string_interpolation_part(context, part, loc)
			lowered_rest ?= lower_string_interpolation_parts(context, rest, loc)
			Ok([lowered].concat(lowered_rest))


private pure func lower_string_interpolation(
	context: CoreLowerContext,
	parts: List[TypedStringInterpolationPart],
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	lowered ?= lower_string_interpolation_parts(context, parts, loc)

	match lowered:
		[]:
			Ok(LiteralExpr(StringLiteral(""), CORE_STRING_TYPE, loc))
		[single]:
			Ok(single)
		[first, second]:
			Ok(
				interpolation_builtin_call(
					"blorp_string_concat_consume",
					[first, second],
					loc,
				),
			)
		_:
			count = LiteralExpr(
				IntLiteral(lowered.length()),
				NamedType("Int", []),
				loc,
			)
			Ok(interpolation_builtin_call("blorp_string_concat_many", [count].concat(lowered), loc))


private pure func lower_typed_field_access(
	context: CoreLowerContext,
	receiver: TypedExpr,
	field: ParsedIdentifier,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	lowered_receiver ?= lower_typed_expr_with_context(context, receiver)
	receiver_type ?= core_lower_value_type(typed_expr_value_type(receiver))

	match receiver_type:
		TupleType(items):
			match field.text.parse_int():
				Some(index):
					if index >= 0 and index < items.length():
						Ok(TupleFieldExpr(lowered_receiver, index, typ, loc))
					else:
						Err(
							CoreLowerInvalidType(
								"tuple field index " + index.to_string() + " is out of bounds for tuple arity " + items
									.length()
									.to_string(),
							),
						)
				None:
					Err(CoreLowerInvalidType("tuple field access requires numeric field name"))
		NamedType(name, args):
			if name == "Tuple":
				match field.text.parse_int():
					Some(index):
						if index >= 0 and index < args.length():
							Ok(TupleFieldExpr(lowered_receiver, index, typ, loc))
						else:
							Err(
								CoreLowerInvalidType(
									"tuple field index " + index.to_string() + " is out of bounds for tuple arity " + args
										.length()
										.to_string(),
								),
							)
					None:
						Err(CoreLowerInvalidType("tuple field access requires numeric field name"))
			else:
				Ok(FieldExpr(lowered_receiver, field.text, typ, loc))
		_:
			Ok(FieldExpr(lowered_receiver, field.text, typ, loc))


private pure func lower_raw_match_cases(
	context: CoreLowerContext,
	cases: List[TypedMatchCase],
) -> Result[List[CoreRawMatchCase], CoreLowerError]:
	var lowered: List[CoreRawMatchCase] = []
	var failure: Option[CoreLowerError] = None

	for match_case in cases:
		if failure.is_none():
			match lower_core_pattern(match_case.pattern):
				Err(error):
					failure = Some(error)
				Ok(pattern):
					match lower_typed_expr_with_context(context, match_case.body):
						Err(error):
							failure = Some(error)
						Ok(body):
							lowered = lowered.append({
								pattern = pattern,
								body = body,
							})

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_typed_concurrent_binding(
	context: CoreLowerContext,
	binding: TypedConcurrentBinding,
) -> Result[CorePreClosureConcurrentBinding, CoreLowerError]:
	typ ?= core_lower_value_type(typed_expr_info_value_type(binding.info))
	rhs ?= lower_typed_expr_with_context(context, binding.value)

	Ok({
		variable = core_var(binding.name.text, None),
		typ = typ,
		rhs = rhs,
	})


private pure func lower_typed_concurrent_bindings(
	context: CoreLowerContext,
	bindings: List[TypedConcurrentBinding],
) -> Result[List[CorePreClosureConcurrentBinding], CoreLowerError]:
	var lowered: List[CorePreClosureConcurrentBinding] = []
	var failure: Option[CoreLowerError] = None

	for binding in bindings:
		if failure.is_none():
			match lower_typed_concurrent_binding(context, binding):
				Ok(lowered_binding):
					lowered = lowered.append(lowered_binding)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func positive_int_literal_from_typed_expr(
	label: String,
	expr: TypedExpr,
) -> Result[Int, CoreLowerError]:
	match expr:
		TypedIntLiteralExpr(text, _, _):
			match text.parse_int():
				Some(value):
					if value > 0:
						Ok(value)
					else:
						Err(CoreLowerInvalidType(label + " must be positive"))
				None:
					Err(CoreLowerInvalidType(label + " is too large"))
		_:
			Err(CoreLowerInvalidType(label + " must be an integer literal"))


private pure func lower_typed_timeout_expr(
	context: CoreLowerContext,
	label: String,
	timeout: TypedExpr,
) -> Result[CoreExpr, CoreLowerError]:
	timeout_type = typed_expr_value_type(timeout)

	if core_timeout_is_int(timeout_type):
		lower_typed_expr_with_context(context, timeout)
	else if core_timeout_is_duration(timeout_type):
		duration_type ?= core_lower_value_type(timeout_type)
		lowered_duration ?= lower_typed_expr_with_context(context, timeout)
		Ok(
			lower_duration_timeout_milliseconds(
				context,
				lowered_duration,
				duration_type,
				typed_expr_span(timeout),
			),
		)
	else:
		Err(
			CoreLowerInvalidType(
				label + " expected Int milliseconds or Duration, got " + type_to_string(
					timeout_type,
				),
			),
		)


private pure func lower_typed_concurrent_params(
	context: CoreLowerContext,
	params: List[TypedConcurrentParam],
) -> Result[CoreLowerConcurrentParams, CoreLowerError]:
	var timeout: Option[CoreExpr] = None
	var max_threads: Option[Int] = None
	var failure: Option[CoreLowerError] = None

	for param in params:
		if failure.is_none():
			name = param.name.text

			if name == "timeout":
				if timeout.is_some():
					failure = Some(CoreLowerInvalidType("duplicate concurrent timeout"))
				else:
					match lower_typed_timeout_expr(context, "concurrent timeout", param.value):
						Ok(lowered_timeout):
							timeout = Some(lowered_timeout)
						Err(error):
							failure = Some(error)
			else if name == "max_threads":
				if max_threads.is_some():
					failure = Some(CoreLowerInvalidType("duplicate concurrent max_threads"))
				else:
					match positive_int_literal_from_typed_expr(
						"concurrent max_threads",
						param.value,
					):
						Ok(value):
							max_threads = Some(value)
						Err(error):
							failure = Some(error)
			else:
				failure = Some(CoreLowerUnsupported("concurrent parameter " + name))

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				timeout = timeout,
				max_threads = max_threads,
			})


private pure func lower_typed_concurrent_block(
	context: CoreLowerContext,
	params: List[TypedConcurrentParam],
	bindings: List[TypedConcurrentBinding],
	body: CoreExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	lowered_params ?= lower_typed_concurrent_params(context, params)
	lowered_bindings ?= lower_typed_concurrent_bindings(context, bindings)
	block: CorePreClosureConcurrentBlock = {
		bindings = lowered_bindings,
		body = body,
		timeout = lowered_params.timeout,
		max_threads = lowered_params.max_threads
	}
	Ok(PreClosureConcurrentExpr(block, typ, loc))


private pure func core_timeout_is_int(typ: SemanticType) -> Bool:
	match typ:
		SemanticConstIntType(_):
			True
		SemanticNamedType(name, args):
			normalize_type_name(name) == "Int" and args.length() == 0
		_:
			False


private pure func core_timeout_is_duration(typ: SemanticType) -> Bool:
	match typ:
		SemanticNamedType(name, args):
			name == canonical_module_type_name("std/units", "Duration") and args.length() == 0
		_:
			False


private pure func timeout_binding_name(label: String, span: SourceSpan) -> String:
	"__timeout_" + label + "_" + span.start_line.to_string() + "_" + span.start_column.to_string()


private pure func lower_duration_timeout_milliseconds(
	context: CoreLowerContext,
	duration: CoreExpr,
	duration_type: CoreType,
	span: SourceSpan,
) -> CoreExpr:
	loc = core_source_loc(span)
	duration_name = timeout_binding_name("duration", span)
	microseconds_name = timeout_binding_name("microseconds", span)
	whole_ms_name = timeout_binding_name("whole_ms", span)

	duration_microseconds = VarExpr(
		core_var(duration_name, None),
		CORE_INT_TYPE,
		loc,
	)
	microseconds_ref = VarExpr(
		core_var(microseconds_name, None),
		CORE_INT_TYPE,
		loc,
	)
	whole_ms_ref = VarExpr(
		core_var(whole_ms_name, None),
		CORE_INT_TYPE,
		loc,
	)
	microseconds_per_ms = core_int_literal(MICROSECONDS_PER_MILLISECOND, loc)
	zero = core_int_literal(0, loc)
	one = core_int_literal(1, loc)

	whole_ms_rhs = BinaryExpr(DivideOp, microseconds_ref, microseconds_per_ms, CORE_INT_TYPE, loc)
	rounded_ms = IfExpr(
		BinaryExpr(
			EqualOp,
			BinaryExpr(ModuloOp, microseconds_ref, microseconds_per_ms, CORE_INT_TYPE, loc),
			zero,
			CORE_BOOL_TYPE,
			loc,
		),
		whole_ms_ref,
		BinaryExpr(AddOp, whole_ms_ref, one, CORE_INT_TYPE, loc),
		CORE_INT_TYPE,
		loc,
	)
	positive_ms = LetExpr(
		core_var(whole_ms_name, None),
		False,
		CORE_INT_TYPE,
		whole_ms_rhs,
		rounded_ms,
	)
	clamped_ms = IfExpr(
		BinaryExpr(LessEqualOp, microseconds_ref, zero, CORE_BOOL_TYPE, loc),
		zero,
		positive_ms,
		CORE_INT_TYPE,
		loc,
	)
	converted = LetExpr(
		core_var(microseconds_name, None),
		False,
		CORE_INT_TYPE,
		duration_microseconds,
		clamped_ms,
	)

	LetExpr(
		core_var(duration_name, None),
		False,
		duration_type,
		duration,
		converted,
	)


private pure func lower_typed_select_arm_kind(
	context: CoreLowerContext,
	kind: TypedSelectArmKind,
) -> Result[CoreSelectArmKind, CoreLowerError]:
	match kind:
		TypedSelectReceiveArm(name, element_type, channel):
			elem_type ?= core_lower_type(element_type)
			lowered_channel ?= lower_typed_expr_with_context(context, channel)
			recv: CoreSelectRecvArm = {
				binder = core_var(name.text, None),
				elem_type = elem_type,
				channel = lowered_channel
			}
			Ok(SelectRecvArm(recv))
		TypedSelectSealedArm(_, channel):
			lowered_channel ?= lower_typed_expr_with_context(context, channel)
			Ok(SelectSealedArm(lowered_channel))
		TypedSelectAfterArm(timeout):
			lowered_timeout ?= lower_typed_timeout_expr(context, "select after timeout", timeout)
			Ok(SelectAfterArm(lowered_timeout))


private pure func lower_typed_select_arm(
	context: CoreLowerContext,
	arm: TypedSelectArm,
) -> Result[CoreSelectArm, CoreLowerError]:
	kind ?= lower_typed_select_arm_kind(context, arm.kind)
	body ?= lower_typed_expr_with_context(context, arm.body)

	Ok({
		kind = kind,
		body = body,
		loc = core_source_loc(arm.span),
	})


private pure func lower_typed_select_arms(
	context: CoreLowerContext,
	arms: List[TypedSelectArm],
) -> Result[List[CoreSelectArm], CoreLowerError]:
	var lowered: List[CoreSelectArm] = []
	var failure: Option[CoreLowerError] = None

	for arm in arms:
		if failure.is_none():
			match lower_typed_select_arm(context, arm):
				Ok(lowered_arm):
					lowered = lowered.append(lowered_arm)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_typed_lambda_params(
	context: CoreLowerContext,
	params: List[TypedLambdaParam],
) -> Result[List[CoreParam], CoreLowerError]:
	var lowered: List[CoreParam] = []
	var failure: Option[CoreLowerError] = None

	for param in params:
		if failure.is_none():
			match core_lower_type(param.param_type):
				Ok(param_type):
					lowered = lowered.append({
						name = core_var(param.name.text, None),
						typ = param_type,
						loc = core_source_loc(param.name.span),
					})
				Err(CoreLowerInvalidType(message)):
					failure = Some(
						CoreLowerInvalidType(
							"lambda parameter `" + param.name.text + "` has an invalid type: " + message,
						),
					)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_for_name_binder(
	context: CoreLowerContext,
	binder: ParsedForBinder,
	element_type: SemanticType,
) -> Result[CoreLoopBinder, CoreLowerError]:
	match binder:
		ParsedForNameBinder(name):
			typ ?= core_lower_value_type(element_type)
			Ok({
				variable = core_var(name.text, None),
				typ = typ,
				range_direction = RangeMayRunBackward,
			})
		ParsedForTupleBinder(_, _):
			Err(CoreLowerUnsupported("tuple for binder"))


private pure func lower_typed_for_binding(
	context: CoreLowerContext,
	binder: ParsedForBinder,
	element_type: SemanticType,
	body: TypedExpr,
) -> Result[CoreLowerLoopBinding, CoreLowerError]:
	lowered_body ?= lower_typed_expr_with_context(context, body)

	match binder:
		ParsedForNameBinder(_):
			lowered_binder ?= lower_for_name_binder(context, binder, element_type)
			Ok({
				binder = lowered_binder,
				body = lowered_body,
			})
		ParsedForTupleBinder(names, span):
			match element_type:
				SemanticTupleType(element_types):
					if names.length() != element_types.length():
						Err(
							CoreLowerInvalidType(
								"tuple for binder has ${names.length()} names but element type has ${element_types.length()} fields",
							),
						)
					else:
						field_types ?= core_lower_type_list(element_types)
						tuple_type: CoreType = TupleType(field_types)
						tuple_var = core_var(tuple_destruct_name(span), None)
						tuple_ref = VarExpr(
							clone_core_var(tuple_var),
							clone_core_type(tuple_type),
							core_source_loc(span),
						)
						body_with_bindings ?= lower_tuple_destruct_bindings(
							context,
							names,
							0,
							tuple_ref,
							field_types,
							lowered_body,
							core_source_loc(span),
						)
						Ok({
							binder = {
								variable = tuple_var,
								typ = tuple_type,
								range_direction = RangeMayRunBackward
							},
							body = body_with_bindings,
						})
				_:
					Err(CoreLowerInvalidType("tuple for binder requires a tuple element type"))


private pure func lower_typed_range_for(
	context: CoreLowerContext,
	binder: ParsedForBinder,
	iterable: TypedExpr,
	start_expr: TypedExpr,
	end_expr: TypedExpr,
	body: TypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	iterable_type = typed_expr_value_type(iterable)

	is_range: Bool = match iterable_type:
		SemanticRangeType(_):
			True
		SemanticNamedType(name, args):
			normalize_type_name(name) == "Range" and args.length() == 0
		_:
			False

	if not is_range:
		Err(
			CoreLowerInvalidType(
				"range for expected a Range iterable, got " + type_to_string(iterable_type),
			),
		)
	else:
		element_type = typed_expr_value_type(start_expr)
		lowered_binder ?= lower_for_name_binder(context, binder, element_type)
		lowered_start ?= lower_typed_expr_with_context(context, start_expr)
		lowered_end ?= lower_typed_expr_with_context(context, end_expr)
		lowered_body ?= lower_typed_expr_with_context(context, body)
		Ok(ForRangeExpr(lowered_binder, lowered_start, lowered_end, lowered_body, typ, loc))


private pure func lower_typed_for_parts(
	context: CoreLowerContext,
	binder: ParsedForBinder,
	element_type: SemanticType,
	iterable: TypedExpr,
	body: TypedExpr,
) -> Result[CoreLowerForParts, CoreLowerError]:
	iterable_type: SemanticType = typed_expr_value_type(iterable)
	iterable_core_type ?= core_lower_type(iterable_type)
	lowered_binding ?= lower_typed_for_binding(context, binder, element_type, body)
	lowered_iterable ?= lower_typed_expr_with_context(context, iterable)

	Ok({
		binder = lowered_binding.binder,
		iterable = lowered_iterable,
		iterable_release_policy = CoreTypePolicy.cleanup_release_policy_for_type(
			iterable_core_type,
		),
		body = lowered_binding.body,
	})


private pure func lower_typed_range_value_for(
	context: CoreLowerContext,
	binder: ParsedForBinder,
	iterable: TypedExpr,
	body: TypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	lowered_binder ?= lower_for_name_binder(context, binder, TYPE_INT)
	lowered_iterable ?= lower_typed_expr_with_context(context, iterable)
	lowered_body ?= lower_typed_expr_with_context(context, body)
	range_type ?= core_lower_type(typed_expr_value_type(iterable))
	range_var = core_var(
		loop_view_internal_name("range_source", for_binder_span(binder)),
		None,
	)
	range_ref = VarExpr(
		clone_core_var(range_var),
		clone_core_type(range_type),
		clone_core_source_loc(loc),
	)
	start_expr = FieldExpr(range_ref, "start", CORE_INT_TYPE, clone_core_source_loc(loc))
	end_expr = FieldExpr(
		VarExpr(clone_core_var(range_var), clone_core_type(range_type), clone_core_source_loc(loc)),
		"end",
		CORE_INT_TYPE,
		clone_core_source_loc(loc),
	)
	loop_expr = ForRangeExpr(
		lowered_binder,
		start_expr,
		end_expr,
		lowered_body,
		typ,
		clone_core_source_loc(loc),
	)

	Ok(LetExpr(range_var, False, range_type, lowered_iterable, loop_expr))


private pure func lower_typed_named_iterable_for(
	context: CoreLowerContext,
	binder: ParsedForBinder,
	iterable: TypedExpr,
	body: TypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
	name: String,
	args: List[SemanticType],
) -> Result[CoreExpr, CoreLowerError]:
	normalized_name: String = normalize_type_name(name)

	if normalized_name == "Range" and args.length() == 0:
		lower_typed_range_value_for(context, binder, iterable, body, typ, loc)
	else if normalized_name == "List":
		match args:
			[element_type]:
				parts ?= lower_typed_for_parts(context, binder, element_type, iterable, body)
				for_list: CoreForList = {
					binder = parts.binder,
					layout = PointerListStorage,
					iterable = parts.iterable,
					iterable_release_policy = parts.iterable_release_policy,
					body = parts.body
				}
				Ok(ForListExpr(for_list, typ, loc))
			_:
				Err(CoreLowerUnsupported("for over " + normalized_name))
	else if normalized_name == "String" and args.length() == 0:
		parts ?= lower_typed_for_parts(context, binder, TYPE_CHAR, iterable, body)
		for_string: CoreForString = {
			binder = parts.binder,
			iterable = parts.iterable,
			iterable_release_policy = parts.iterable_release_policy,
			body = parts.body
		}
		Ok(ForStringExpr(for_string, typ, loc))
	else if normalized_name == "Dict":
		match args:
			[key_type, value_type]:
				element_type: SemanticType = match binder:
					ParsedForTupleBinder(_, _):
						SemanticTupleType([key_type, value_type])
					ParsedForNameBinder(_):
						key_type

				parts ?= lower_typed_for_parts(context, binder, element_type, iterable, body)
				for_dict: CoreForDict = {
					binder = parts.binder,
					iterable = parts.iterable,
					iterable_release_policy = parts.iterable_release_policy,
					body = parts.body
				}
				Ok(ForDictExpr(for_dict, typ, loc))
			_:
				Err(CoreLowerUnsupported("for over " + normalized_name))
	else if normalized_name == "Channel":
		match args:
			[element_type]:
				lowered_binder ?= lower_for_name_binder(context, binder, element_type)
				lowered_iterable ?= lower_typed_expr_with_context(context, iterable)
				lowered_body ?= lower_typed_expr_with_context(context, body)
				for_channel: CoreForChannel = {
					binder = lowered_binder,
					iterable = lowered_iterable,
					body = lowered_body
				}
				Ok(ForChannelExpr(for_channel, typ, loc))
			_:
				Err(CoreLowerUnsupported("for over " + normalized_name))
	else if normalized_name == "Set":
		match args:
			[element_type]:
				parts ?= lower_typed_for_parts(context, binder, element_type, iterable, body)
				for_set: CoreForSet = {
					binder = parts.binder,
					iterable = parts.iterable,
					iterable_release_policy = parts.iterable_release_policy,
					body = parts.body
				}
				Ok(ForSetExpr(for_set, typ, loc))
			_:
				Err(CoreLowerUnsupported("for over " + normalized_name))
	else if is_stream_type_name(name):
		match args:
			[element_type]:
				parts ?= lower_typed_for_parts(context, binder, element_type, iterable, body)
				for_stream: CoreForStream = {
					binder = parts.binder,
					iterable = parts.iterable,
					iterable_release_policy = parts.iterable_release_policy,
					body = parts.body
				}
				Ok(ForStreamExpr(for_stream, typ, loc))
			_:
				Err(CoreLowerUnsupported("for over " + normalized_name))
	else if is_resource_source_type_name(name):
		match args:
			[resource_type, _]:
				parts ?= lower_typed_for_parts(context, binder, resource_type, iterable, body)
				for_resource_source: CoreForResourceSource = {
					binder = parts.binder,
					iterable = parts.iterable,
					iterable_release_policy = parts.iterable_release_policy,
					body = parts.body
				}
				Ok(ForResourceSourceExpr(for_resource_source, typ, loc))
			_:
				Err(CoreLowerUnsupported("for over " + normalized_name))
	else:
		Err(CoreLowerUnsupported("for over " + normalized_name))


private pure func typed_loop_view_source(
	iterable: TypedExpr,
	view_name: String,
) -> Result[TypedExpr, CoreLowerError]:
	match iterable:
		TypedCallExpr(_, args, _, _):
			match args.get(0):
				Some(source):
					Ok(source)
				None:
					Err(
						CoreLowerInvalidType(
							view_name + " loop view is missing its source argument",
						),
					)
		_:
			Err(CoreLowerInvalidType(view_name + " loop view is not attached to a call expression"))


private pure func unknown_named_core_call(
	name: String,
	args: List[CoreExpr],
	return_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	CallExpr(
		UnknownCall,
		VarExpr(
			core_var(name, None),
			NamedType("Closure", []),
			clone_core_source_loc(loc),
		),
		args,
		return_type,
		clone_core_source_loc(loc),
	)


private pure func lower_typed_indices_for(
	context: CoreLowerContext,
	binder: ParsedForBinder,
	iterable: TypedExpr,
	element_type: SemanticType,
	body: TypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	source ?= typed_loop_view_source(iterable, "indices")
	lowered_binder ?= lower_for_name_binder(context, binder, element_type)
	lowered_source ?= lower_typed_expr_with_context(context, source)
	lowered_body ?= lower_typed_expr_with_context(context, body)
	length_call = unknown_named_core_call(
		"length",
		[lowered_source],
		CORE_INT_TYPE,
		clone_core_source_loc(loc),
	)

	Ok(
		ForRangeExpr(
			lowered_binder,
			core_int_literal(0, clone_core_source_loc(loc)),
			length_call,
			lowered_body,
			typ,
			loc,
		),
	)


private pure func lower_typed_windows_for(
	context: CoreLowerContext,
	binder: ParsedForBinder,
	iterable: TypedExpr,
	window_size: Int,
	window_source_type: SemanticType,
	body: TypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	if window_size <= 0:
		Err(CoreLowerInvalidType("windows loop size must be positive"))
	else:
		match binder:
			ParsedForTupleBinder(_, _):
				Err(CoreLowerInvalidType("windows loop requires a name binder"))
			ParsedForNameBinder(window_name):
				source ?= typed_loop_view_source(iterable, "windows")
				source_type ?= core_lower_type(typed_expr_value_type(source))
				window_type ?= core_lower_type(window_source_type)
				lowered_source ?= lower_typed_expr_with_context(context, source)
				lowered_body ?= lower_typed_expr_with_context(context, body)
				span: SourceSpan = for_binder_span(binder)
				source_var = core_var(
					loop_view_internal_name("windows_source", span),
					None,
				)
				index_var = core_var(
					loop_view_internal_name("windows_index", span),
					None,
				)
				index_type = CORE_INT_TYPE
				length_call = unknown_named_core_call(
					"length",
					[
						VarExpr(
							clone_core_var(source_var),
							clone_core_type(source_type),
							clone_core_source_loc(loc),
						),
					],
					CORE_INT_TYPE,
					clone_core_source_loc(loc),
				)
				window_size_expr = core_int_literal(window_size, clone_core_source_loc(loc))
				end_expr = BinaryExpr(
					AddOp,
					BinaryExpr(
						SubtractOp,
						length_call,
						window_size_expr,
						CORE_INT_TYPE,
						clone_core_source_loc(loc),
					),
					core_int_literal(1, clone_core_source_loc(loc)),
					CORE_INT_TYPE,
					clone_core_source_loc(loc),
				)
				index_ref = VarExpr(
					clone_core_var(index_var),
					clone_core_type(index_type),
					clone_core_source_loc(loc),
				)
				slice_expr = unknown_named_core_call(
					"checked_slice",
					[
						VarExpr(
							clone_core_var(source_var),
							clone_core_type(source_type),
							clone_core_source_loc(loc),
						),
						index_ref,
						BinaryExpr(
							AddOp,
							VarExpr(
								clone_core_var(index_var),
								clone_core_type(index_type),
								clone_core_source_loc(loc),
							),
							core_int_literal(window_size, clone_core_source_loc(loc)),
							CORE_INT_TYPE,
							clone_core_source_loc(loc),
						),
					],
					clone_core_type(window_type),
					clone_core_source_loc(loc),
				)

				loop_body = if window_name.text == "_":
					lowered_body
				else:
					LetExpr(
						core_var(window_name.text, None),
						False,
						window_type,
						slice_expr,
						lowered_body,
					)

				loop_expr = ForRangeExpr(
					{
						variable = index_var,
						typ = index_type,
						range_direction = RangeMayRunBackward
					},
					core_int_literal(
						0,
						clone_core_source_loc(loc),
					),
					end_expr,
					loop_body,
					typ,
					clone_core_source_loc(loc),
				)

				Ok(LetExpr(source_var, False, source_type, lowered_source, loop_expr))


private pure func lower_enumerate_loop_body(
	context: CoreLowerContext,
	binder: ParsedForBinder,
	span: SourceSpan,
	index_var: CoreVar,
	index_type: CoreType,
	element_expr: CoreExpr,
	element_type: CoreType,
	body: TypedExpr,
) -> Result[CoreExpr, CoreLowerError]:
	lowered_body ?= lower_typed_expr_with_context(context, body)

	match binder:
		ParsedForTupleBinder(names, _):
			if names.length() != 2:
				Err(CoreLowerInvalidType("enumerate tuple loop requires exactly two binders"))
			else:
				match (names.get(0), names.get(1)):
					(Some(index_name), Some(element_name)):
						if index_name.text != "_" and index_name.text != index_var.name:
							Err(
								CoreLowerInvalidType(
									"enumerate index binder does not match its Core loop variable",
								),
							)
						else if element_name.text == "_":
							Ok(lowered_body)
						else:
							Ok(
								LetExpr(
									core_var(element_name.text, None),
									False,
									element_type,
									element_expr,
									lowered_body,
								),
							)
					_:
						Err(
							CoreLowerInvalidType(
								"enumerate tuple loop has incomplete binder metadata",
							),
						)
		ParsedForNameBinder(name):
			if name.text == "_":
				Ok(lowered_body)
			else:
				tuple_type: CoreType = TupleType(
					[clone_core_type(index_type), clone_core_type(element_type)],
				)
				index_ref = VarExpr(
					clone_core_var(index_var),
					clone_core_type(index_type),
					core_source_loc(span),
				)

				Ok(
					LetExpr(
						core_var(
							name.text,
							None,
						),
						False,
						tuple_type,
						TupleExpr(
							[index_ref, element_expr],
							clone_core_type(tuple_type),
							core_source_loc(span),
						),
						lowered_body,
					),
				)


private pure func static_tensor_dim_product(dims: List[SemanticType]) -> Option[Int]:
	match dims:
		[]:
			Some(1)
		[SemanticConstIntType(value), ...rest]:
			static_tensor_dim_product(rest).map(func(product): value * product)
		_:
			None


private pure func lower_typed_enumerate_element(
	context: CoreLowerContext,
	source_var: CoreVar,
	source_type: CoreType,
	index_var: CoreVar,
	index_type: CoreType,
	element_type: CoreType,
	dims: List[SemanticType],
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	source_ref = VarExpr(
		clone_core_var(source_var),
		clone_core_type(source_type),
		clone_core_source_loc(loc),
	)
	index_ref = VarExpr(
		clone_core_var(index_var),
		clone_core_type(index_type),
		clone_core_source_loc(loc),
	)

	match dims:
		[_]:
			Ok(
				unknown_named_core_call(
					"checked_get",
					[source_ref, index_ref],
					clone_core_type(element_type),
					clone_core_source_loc(loc),
				),
			)
		[_, first_inner, ...rest]:
			match (first_inner, static_tensor_dim_product(rest)):
				(SemanticConstIntType(first_inner_value), Some(remaining_size)):
					row_size: Int = first_inner_value * remaining_size
					Ok(
						builtin_core_call(
							"blorp_tensor_slice_row",
							[
								source_ref,
								index_ref,
								core_int_literal(row_size, clone_core_source_loc(loc)),
								core_int_literal(first_inner_value, clone_core_source_loc(loc)),
							],
							clone_core_type(element_type),
							clone_core_source_loc(loc),
						),
					)
				_:
					Err(
						CoreLowerUnsupported(
							"enumerate over a multidimensional tensor with non-literal inner dimensions",
						),
					)
		[]:
			Err(CoreLowerInvalidType("enumerate tensor source has no dimensions"))


private pure func lower_typed_tensor_enumerate_for(
	context: CoreLowerContext,
	binder: ParsedForBinder,
	source: TypedExpr,
	source_type: SemanticType,
	dims: List[SemanticType],
	index_source_type: SemanticType,
	element_source_type: SemanticType,
	body: TypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	span: SourceSpan = for_binder_span(binder)

	index_name: String = loop_view_binder_name(binder, 0, "enumerate_index", span)

	index_type ?= core_lower_type(index_source_type)
	element_type ?= core_lower_type(element_source_type)
	lowered_source ?= lower_typed_expr_with_context(context, source)
	lowered_source_type ?= core_lower_type(source_type)
	source_var = core_var(
		loop_view_internal_name("enumerate_source", span),
		None,
	)
	index_var = core_var(index_name, None)
	element_expr ?= lower_typed_enumerate_element(
		context,
		source_var,
		lowered_source_type,
		index_var,
		index_type,
		element_type,
		dims,
		loc,
	)
	loop_body ?= lower_enumerate_loop_body(
		context,
		binder,
		span,
		index_var,
		index_type,
		element_expr,
		element_type,
		body,
	)
	length_call = unknown_named_core_call(
		"length",
		[
			VarExpr(
				clone_core_var(source_var),
				clone_core_type(lowered_source_type),
				clone_core_source_loc(loc),
			),
		],
		CORE_INT_TYPE,
		clone_core_source_loc(loc),
	)
	loop_expr = ForRangeExpr(
		{
			variable = index_var,
			typ = index_type,
			range_direction = RangeMayRunBackward
		},
		core_int_literal(
			0,
			clone_core_source_loc(loc),
		),
		length_call,
		loop_body,
		typ,
		clone_core_source_loc(loc),
	)

	Ok(LetExpr(source_var, False, lowered_source_type, lowered_source, loop_expr))


private pure func lower_typed_enumerate_for(
	context: CoreLowerContext,
	binder: ParsedForBinder,
	iterable: TypedExpr,
	loop_element_type: SemanticType,
	body: TypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	source ?= typed_loop_view_source(iterable, "enumerate")
	source_type: SemanticType = typed_expr_value_type(source)

	match loop_element_type:
		SemanticTupleType(elements):
			if elements.length() != 2:
				Err(
					CoreLowerInvalidType(
						"enumerate loop view must yield an (index, element) tuple",
					),
				)
			else:
				match array_type_parts(source_type):
					Some((_, dims)):
						match (elements.get(0), elements.get(1)):
							(Some(index_type), Some(element_type)):
								lower_typed_tensor_enumerate_for(
									context,
									binder,
									source,
									source_type,
									dims,
									index_type,
									element_type,
									body,
									typ,
									loc,
								)
							_:
								Err(
									CoreLowerInvalidType(
										"enumerate loop view has incomplete element metadata",
									),
								)
					None:
						Err(CoreLowerInvalidType("enumerate requires a tensor source"))
		_:
			Err(CoreLowerInvalidType("enumerate loop view must yield an (index, element) tuple"))


private pure func lower_enumerate2_loop_body(
	context: CoreLowerContext,
	binder: ParsedForBinder,
	span: SourceSpan,
	row_var: CoreVar,
	row_type: CoreType,
	column_var: CoreVar,
	column_type: CoreType,
	element_expr: CoreExpr,
	element_type: CoreType,
	body: TypedExpr,
) -> Result[CoreExpr, CoreLowerError]:
	lowered_body ?= lower_typed_expr_with_context(context, body)

	match binder:
		ParsedForTupleBinder(names, _):
			if names.length() != 3:
				Err(CoreLowerInvalidType("enumerate2 tuple loop requires exactly three binders"))
			else:
				match (names.get(0), names.get(1), names.get(2)):
					(Some(row_name), Some(column_name), Some(element_name)):
						if row_name.text != "_" and row_name.text != row_var.name:
							Err(
								CoreLowerInvalidType(
									"enumerate2 row binder does not match its Core loop variable",
								),
							)
						else if column_name.text != "_" and column_name.text != column_var.name:
							Err(
								CoreLowerInvalidType(
									"enumerate2 column binder does not match its Core loop variable",
								),
							)
						else if element_name.text == "_":
							Ok(lowered_body)
						else:
							Ok(
								LetExpr(
									core_var(element_name.text, None),
									False,
									element_type,
									element_expr,
									lowered_body,
								),
							)
					_:
						Err(
							CoreLowerInvalidType(
								"enumerate2 tuple loop has incomplete binder metadata",
							),
						)
		ParsedForNameBinder(name):
			if name.text == "_":
				Ok(lowered_body)
			else:
				tuple_type: CoreType = TupleType([
					clone_core_type(row_type),
					clone_core_type(column_type),
					clone_core_type(element_type),
				])
				row_ref = VarExpr(
					clone_core_var(row_var),
					clone_core_type(row_type),
					core_source_loc(span),
				)
				column_ref = VarExpr(
					clone_core_var(column_var),
					clone_core_type(column_type),
					core_source_loc(span),
				)

				Ok(
					LetExpr(
						core_var(
							name.text,
							None,
						),
						False,
						tuple_type,
						TupleExpr(
							[row_ref, column_ref, element_expr],
							clone_core_type(tuple_type),
							core_source_loc(span),
						),
						lowered_body,
					),
				)


private pure func lower_typed_2d_enumerate2_for(
	context: CoreLowerContext,
	binder: ParsedForBinder,
	source: TypedExpr,
	source_type: SemanticType,
	row_source_type: SemanticType,
	column_source_type: SemanticType,
	element_source_type: SemanticType,
	column_dim: SemanticType,
	body: TypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	span: SourceSpan = for_binder_span(binder)
	row_name: String = loop_view_binder_name(binder, 0, "enumerate2_row", span)
	column_name: String = loop_view_binder_name(binder, 1, "enumerate2_column", span)
	row_type ?= core_lower_type(row_source_type)
	column_type ?= core_lower_type(column_source_type)
	element_type ?= core_lower_type(element_source_type)
	lowered_source ?= lower_typed_expr_with_context(context, source)
	lowered_source_type ?= core_lower_type(source_type)
	source_var = core_var(
		loop_view_internal_name("enumerate2_source", span),
		None,
	)
	row_var = core_var(row_name, None)
	column_var = core_var(column_name, None)
	row_ref = VarExpr(
		clone_core_var(row_var),
		clone_core_type(row_type),
		clone_core_source_loc(loc),
	)
	column_ref = VarExpr(
		clone_core_var(column_var),
		clone_core_type(column_type),
		clone_core_source_loc(loc),
	)
	element_expr = unknown_named_core_call(
		"matrix_checked_get",
		[
			VarExpr(
				clone_core_var(source_var),
				clone_core_type(lowered_source_type),
				clone_core_source_loc(loc),
			),
			row_ref,
			column_ref,
		],
		clone_core_type(element_type),
		clone_core_source_loc(loc),
	)
	loop_body ?= lower_enumerate2_loop_body(
		context,
		binder,
		span,
		row_var,
		row_type,
		column_var,
		column_type,
		element_expr,
		element_type,
		body,
	)
	rows_call = unknown_named_core_call(
		"length",
		[
			VarExpr(
				clone_core_var(source_var),
				clone_core_type(lowered_source_type),
				clone_core_source_loc(loc),
			),
		],
		CORE_INT_TYPE,
		clone_core_source_loc(loc),
	)

	column_count: CoreExpr = match column_dim:
		SemanticConstIntType(value):
			core_int_literal(value, clone_core_source_loc(loc))
		_:
			capacity_call = CallExpr(
				IntrinsicCall("tensor_capacity"),
				VoidExpr(VoidType, clone_core_source_loc(loc)),
				[
					VarExpr(
						clone_core_var(source_var),
						clone_core_type(lowered_source_type),
						clone_core_source_loc(loc),
					),
				],
				CORE_INT_TYPE,
				clone_core_source_loc(loc),
			)
			column_rows_call = unknown_named_core_call(
				"length",
				[
					VarExpr(
						clone_core_var(source_var),
						clone_core_type(lowered_source_type),
						clone_core_source_loc(loc),
					),
				],
				CORE_INT_TYPE,
				clone_core_source_loc(loc),
			)

			BinaryExpr(
				DivideOp,
				capacity_call,
				column_rows_call,
				CORE_INT_TYPE,
				clone_core_source_loc(loc),
			)

	inner_loop = ForRangeExpr(
		{
			variable = column_var,
			typ = column_type,
			range_direction = RangeMayRunBackward
		},
		core_int_literal(
			0,
			clone_core_source_loc(loc),
		),
		column_count,
		loop_body,
		typ,
		clone_core_source_loc(loc),
	)
	outer_loop = ForRangeExpr(
		{
			variable = row_var,
			typ = row_type,
			range_direction = RangeMayRunBackward
		},
		core_int_literal(
			0,
			clone_core_source_loc(loc),
		),
		rows_call,
		inner_loop,
		typ,
		clone_core_source_loc(loc),
	)

	Ok(LetExpr(source_var, False, lowered_source_type, lowered_source, outer_loop))


private pure func lower_typed_enumerate2_for(
	context: CoreLowerContext,
	binder: ParsedForBinder,
	iterable: TypedExpr,
	loop_element_type: SemanticType,
	body: TypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	source ?= typed_loop_view_source(iterable, "enumerate2")
	source_type: SemanticType = typed_expr_value_type(source)

	match loop_element_type:
		SemanticTupleType(elements):
			if elements.length() != 3:
				Err(
					CoreLowerInvalidType(
						"enumerate2 loop view must yield a (row, column, element) tuple",
					),
				)
			else:
				match array_type_parts(source_type):
					Some((_, dims)):
						if dims.length() != 2:
							Err(
								CoreLowerUnsupported(
									"enumerate2 requires a two-dimensional tensor",
								),
							)
						else:
							match (elements.get(0), elements.get(1), elements.get(2), dims.get(1)):
								(Some(row_source_type), Some(column_source_type), Some(element_source_type), Some(column_dim)):
									lower_typed_2d_enumerate2_for(
										context,
										binder,
										source,
										source_type,
										row_source_type,
										column_source_type,
										element_source_type,
										column_dim,
										body,
										typ,
										loc,
									)
								_:
									Err(
										CoreLowerInvalidType(
											"enumerate2 loop view has incomplete element or dimension metadata",
										),
									)
					None:
						Err(CoreLowerInvalidType("enumerate2 requires a tensor source"))
		_:
			Err(
				CoreLowerInvalidType(
					"enumerate2 loop view must yield a (row, column, element) tuple",
				),
			)


private pure func tensor_row_slice_storage(
	dims: List[SemanticType],
) -> Result[CoreTensorForElementStorage, CoreLowerError]:
	match dims:
		[_, SemanticConstIntType(inner_size)]:
			Ok(TensorForRowSliceElement({
				row_size = inner_size.to_string() + "L",
				result_first_dim = inner_size.to_string() + "L",
				runtime_derived = False,
			}))
		[_, _]:
			Ok(TensorForRowSliceElement({
				row_size = "",
				result_first_dim = "",
				runtime_derived = True,
			}))
		[_, SemanticConstIntType(first_inner), ...rest]:
			match static_tensor_dim_product(rest):
				Some(remaining_size):
					Ok(TensorForRowSliceElement({
						row_size = (first_inner * remaining_size).to_string() + "L",
						result_first_dim = first_inner.to_string() + "L",
						runtime_derived = False,
					}))
				None:
					Err(
						CoreLowerUnsupported(
							"cannot peel a 3D or higher tensor with non-literal inner dimensions",
						),
					)
		_:
			Err(CoreLowerInvalidType("tensor row loop requires at least two dimensions"))


private pure func lower_typed_tensor_for(
	context: CoreLowerContext,
	binder: ParsedForBinder,
	iterable: TypedExpr,
	body: TypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
	element_type: SemanticType,
	dims: List[SemanticType],
) -> Result[CoreExpr, CoreLowerError]:
	match dims:
		[]:
			Err(CoreLowerInvalidType("tensor for loop source has no dimensions"))
		[_]:
			parts ?= lower_typed_for_parts(context, binder, element_type, iterable, body)
			lowered_element_type ?= core_lower_type(element_type)
			for_tensor: CoreForTensor = {
				binder = parts.binder,
				element_storage = tensor_for_element_storage_for_canonical_type(
					lowered_element_type,
				),
				iterable = parts.iterable,
				iterable_release_policy = parts.iterable_release_policy,
				body = parts.body
			}
			Ok(ForTensorExpr(for_tensor, typ, loc))
		[_, ...inner_dims]:
			row_type: SemanticType = SemanticArrayType(element_type, inner_dims)
			parts ?= lower_typed_for_parts(context, binder, row_type, iterable, body)
			storage ?= tensor_row_slice_storage(dims)
			for_tensor: CoreForTensor = {
				binder = parts.binder,
				element_storage = storage,
				iterable = parts.iterable,
				iterable_release_policy = parts.iterable_release_policy,
				body = parts.body
			}
			Ok(ForTensorExpr(for_tensor, typ, loc))


private pure func lower_typed_for(
	context: CoreLowerContext,
	binder: ParsedForBinder,
	iterable: TypedExpr,
	loop_view: Option[TypedLoopView],
	body: TypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	match loop_view:
		Some(TypedIndicesLoopView(element_type)):
			lower_typed_indices_for(context, binder, iterable, element_type, body, typ, loc)
		Some(TypedEnumerateLoopView(element_type)):
			lower_typed_enumerate_for(context, binder, iterable, element_type, body, typ, loc)
		Some(TypedEnumerate2LoopView(element_type)):
			lower_typed_enumerate2_for(context, binder, iterable, element_type, body, typ, loc)
		Some(TypedWindowsLoopView(window_size, element_type)):
			lower_typed_windows_for(
				context,
				binder,
				iterable,
				window_size,
				element_type,
				body,
				typ,
				loc,
			)
		None:
			match iterable:
				TypedRangeExpr(start_expr, end_expr, _, _):
					lower_typed_range_for(
						context,
						binder,
						iterable,
						start_expr,
						end_expr,
						body,
						typ,
						loc,
					)
				_:
					iterable_type = typed_expr_value_type(iterable)

					match array_type_parts(iterable_type):
						Some((element_type, dims)):
							lower_typed_tensor_for(
								context,
								binder,
								iterable,
								body,
								typ,
								loc,
								element_type,
								dims,
							)
						None:
							match iterable_type:
								SemanticNamedType(name, args):
									lower_typed_named_iterable_for(
										context,
										binder,
										iterable,
										body,
										typ,
										loc,
										name,
										args,
									)
								_:
									Err(
										CoreLowerUnsupported(
											"for over " + type_to_string(iterable_type),
										),
									)


private pure func concurrent_for_item(
	iterable_type: SemanticType,
) -> Result[CoreLowerConcurrentForItem, CoreLowerError]:
	match iterable_type:
		SemanticNamedType(name, args):
			normalized_name: String = normalize_type_name(name)

			if normalized_name == "List":
				match args:
					[element_type]:
						item_type ?= core_lower_type(element_type)
						Ok({
							item_type = item_type,
							item_mode = ConcurrentlyLoopCopyItem,
						})
					_:
						Err(CoreLowerUnsupported("for ... concurrently over " + normalized_name))
			else if is_resource_source_type_name(name):
				match args:
					[resource_source_type, error_source_type]:
						resource_type ?= core_lower_type(resource_source_type)
						error_type ?= core_lower_type(error_source_type)
						move_item: CoreConcurrentlyLoopMoveResourceItem = {
							resource_type = resource_type,
							error_type = error_type
						}
						Ok({
							item_type = resource_type,
							item_mode = ConcurrentlyLoopMoveResourceItem(move_item),
						})
					_:
						Err(CoreLowerUnsupported("for ... concurrently over ResourceSource"))
			else:
				Err(CoreLowerUnsupported("for ... concurrently over " + normalized_name))
		_:
			Err(CoreLowerUnsupported("for ... concurrently over " + type_to_string(iterable_type)))


private pure func lower_typed_concurrent_for_params(
	context: CoreLowerContext,
	params: List[TypedConcurrentParam],
	loc: CoreSourceLoc,
) -> Result[CoreLowerConcurrentForParams, CoreLowerError]:
	var timeout: Option[CoreExpr] = None
	var limit: Option[CoreExpr] = None
	var failure: Option[CoreLowerError] = None

	for param in params:
		if failure.is_none():
			name = param.name.text

			if name == "timeout":
				if timeout.is_some():
					failure = Some(CoreLowerInvalidType("duplicate timeout parameter"))
				else:
					match lower_typed_timeout_expr(
						context,
						"for ... concurrently timeout",
						param.value,
					):
						Ok(lowered_timeout):
							timeout = Some(lowered_timeout)
						Err(error):
							failure = Some(error)
			else if name == "limit":
				if limit.is_some():
					failure = Some(CoreLowerInvalidType("duplicate concurrently limit"))
				else:
					match positive_int_literal_from_typed_expr("concurrently limit", param.value):
						Ok(value):
							limit = Some(core_int_literal(value, loc))
						Err(error):
							failure = Some(error)
			else if name == "max_threads":
				failure = Some(CoreLowerInvalidType((
							"use `limit: N` in `concurrently(...)`; `max_threads` is only valid on "
							+ "`concurrent(...)` blocks"
						)))
			else:
				failure = Some(
					CoreLowerUnsupported(
						"unknown concurrently parameter `" + name + "` (expected `limit` or `timeout`)",
					),
				)

	match failure:
		Some(error):
			Err(error)
		None:
			match limit:
				Some(limit_value):
					Ok({
						timeout = timeout,
						limit = limit_value,
					})
				None:
					Err(CoreLowerInvalidType("`for ... concurrently(...)` requires `limit: N`"))


private pure func discard_concurrent_for_body_if_needed(
	body: CoreExpr,
	body_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	if core_type_is_void(body_type):
		body
	else:
		SeqExpr(
			body,
			VoidExpr(VoidType, loc),
		)


private pure func lower_typed_concurrent_for(
	context: CoreLowerContext,
	name: ParsedIdentifier,
	iterable: TypedExpr,
	params: List[TypedConcurrentParam],
	body: TypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	iterable_type = typed_expr_value_type(iterable)
	item ?= concurrent_for_item(iterable_type)
	lowered_iterable ?= lower_typed_expr_with_context(context, iterable)
	lowered_body ?= lower_typed_expr_with_context(context, body)
	body_type ?= core_lower_value_type(typed_expr_value_type(body))
	lowered_params ?= lower_typed_concurrent_for_params(context, params, loc)
	loop: CorePreClosureConcurrentlyLoop = {
		variable = core_var(name.text, None),
		item_type = item.item_type,
		item_mode = item.item_mode,
		iterable = lowered_iterable,
		body = discard_concurrent_for_body_if_needed(lowered_body, body_type, loc),
		timeout = lowered_params.timeout,
		limit = lowered_params.limit,
		output = ConcurrentlyLoopDiscard
	}
	Ok(PreClosureConcurrentlyLoopExpr(loop, typ, loc))


private pure func lower_user_call_kind(
	context: CoreLowerContext,
	info: ResolvedCallInfo,
	callable_id: Int,
	callee: CoreExpr,
) -> Result[CoreCallKind, CoreLowerError]:
	match callee:
		VarExpr(variable, _, _):
			match variable.def_id:
				Some(existing_id):
					if existing_id == callable_id:
						Ok(SelectedDirectCall(callable_id))
					else:
						Err(
							CoreLowerInvalidCall(
								"conflicting callable ids for " + info.callee_name + ": callee carried " + existing_id.to_string() + " but resolved_call carried " + callable_id.to_string(),
							),
						)
				None:
					Ok(SelectedDirectCall(callable_id))
		_:
			Ok(UnknownCall)


private pure func lower_builtin_call_kind(info: ResolvedCallInfo) -> CoreCallKind:
	if info.source_name == TO_STRING_BUILTIN_NAME:
		BuiltinCall(TO_STRING_CORE_SENTINEL)
	else:
		UnknownCall


private pure func lower_resolved_call_kind(
	context: CoreLowerContext,
	resolved: Option[ResolvedCallInfo],
	callee: CoreExpr,
) -> Result[CoreCallKind, CoreLowerError]:
	match resolved:
		Some(info):
			match info.target:
				ResolvedDirectCall(callable_id, origin):
					match origin:
						CallableLocal:
							lower_user_call_kind(context, info, callable_id, callee)
						CallableBuiltin:
							Ok(lower_builtin_call_kind(info))
						CallableImported(_):
							lower_user_call_kind(context, info, callable_id, callee)
						CallableConstructor(_):
							Ok(UnknownCall)
						CallableImplMethod:
							lower_user_call_kind(context, info, callable_id, callee)
						CallableForeign:
							Ok(UnknownCall)
				ResolvedTraitMethodCall(trait_name, impl_target):
					match impl_target:
						Some(target):
							Ok(
								SelectedTraitCall(
									trait_name,
									info.callee_name,
									target.module_path,
									target.callable_id,
								),
							)
						None:
							Ok(DeferredTraitCall(trait_name, info.callee_name))
				ResolvedIntrinsicCall:
					if info.source_name == "type_name" or info.source_name == "is_heap":
						Ok(IntrinsicCall(info.source_name))
					else:
						Ok(UnknownCall)
				ResolvedClosureCall:
					Ok(UnknownCall)
		None:
			Ok(UnknownCall)


private pure func lower_question_bind_success_case(
	context: CoreLowerContext,
	name: ParsedIdentifier,
	kind: CoreLowerCarrierKind,
	success_body: CoreExpr,
) -> CoreRawMatchCase:
	constructor: String = match kind:
		CoreLowerOptionCarrier:
			"Some"
		CoreLowerResultCarrier:
			"Ok"

	{
		pattern = ConstructorPattern(constructor, [NamePattern(name.text)]),
		body = success_body
	}


private pure func lower_question_bind_failure_case(
	context: CoreLowerContext,
	kind: CoreLowerCarrierKind,
	rhs_type: CoreType,
	block_type: CoreType,
	span: SourceSpan,
	loc: CoreSourceLoc,
) -> Result[CoreRawMatchCase, CoreLowerError]:
	constructor: String = match kind:
		CoreLowerOptionCarrier:
			"None"
		CoreLowerResultCarrier:
			"Err"

	failure_var = core_var(
		question_bind_name("failure", span),
		None,
	)

	failure_type ?= match kind:
		CoreLowerOptionCarrier:
			Ok(VoidType)
		CoreLowerResultCarrier:
			match core_carrier_failure_type(rhs_type):
				Ok(result_type):
					Ok(clone_core_type(result_type))
				Err(error):
					Err(error)

	failure_pattern: CorePattern = match kind:
		CoreLowerOptionCarrier:
			ConstructorPattern(constructor, [])
		CoreLowerResultCarrier:
			ConstructorPattern(constructor, [NamePattern(failure_var.name)])

	Ok({
		pattern = failure_pattern,
		body = carrier_failure_expr(
			kind,
			clone_core_type(block_type),
			failure_var,
			failure_type,
			clone_core_source_loc(loc),
		),
	})


private pure func lower_typed_question_bind(
	context: CoreLowerContext,
	name: ParsedIdentifier,
	rhs: TypedExpr,
	span: SourceSpan,
	rest: List[TypedExpr],
	block_type: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	if rest.length() == 0:
		Err(CoreLowerInvalidType("EQuestionBind reached lowering without a success continuation"))
	else:
		block_kind ?= core_carrier_kind(block_type)
		lowered_rhs ?= lower_typed_expr_with_context(context, rhs)
		rhs_type ?= core_lower_value_type(typed_expr_value_type(rhs))
		rhs_kind ?= core_carrier_kind(rhs_type)

		if block_kind != rhs_kind:
			Err(CoreLowerInvalidType("?= carrier kind changed between inference and lowering"))
		else:
			success_body ?= lower_typed_block_expr(
				context,
				rest,
				clone_core_type(block_type),
				clone_core_source_loc(loc),
			)
			success_case = lower_question_bind_success_case(context, name, rhs_kind, success_body)
			failure_case ?= lower_question_bind_failure_case(
				context,
				rhs_kind,
				clone_core_type(rhs_type),
				clone_core_type(block_type),
				span,
				clone_core_source_loc(loc),
			)
			tmp_var = core_var(
				question_bind_name("value", span),
				None,
			)
			tmp_ref = VarExpr(
				clone_core_var(tmp_var),
				clone_core_type(rhs_type),
				clone_core_source_loc(loc),
			)
			match_expr = RawMatchExpr(
				tmp_ref,
				[success_case, failure_case],
				clone_core_type(block_type),
				clone_core_source_loc(loc),
			)

			Ok(
				LetExpr(
					clone_core_var(tmp_var),
					False,
					clone_core_type(rhs_type),
					lowered_rhs,
					match_expr,
				),
			)


private pure func with_resource_name(binding: TypedWithBinding) -> String:
	if binding.name.text == "_":
		question_bind_name("resource", binding.span)
	else:
		binding.name.text


private pure func with_resource_type(
	is_try: Bool,
	acquisition_type: CoreType,
) -> Result[CoreType, CoreLowerError]:
	if is_try:
		match core_carrier_success_type(acquisition_type):
			Ok(resource_type):
				Ok(clone_core_type(resource_type))
			Err(error):
				Err(error)
	else:
		Ok(clone_core_type(acquisition_type))


private pure func resource_cleanup_call(
	binding: TypedWithBinding,
	resource_var: CoreVar,
	resource_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	resource_ref = VarExpr(
		clone_core_var(resource_var),
		clone_core_type(resource_type),
		clone_core_source_loc(loc),
	)

	match binding.cleanup_function:
		Some(cleanup_function):
			builtin_core_call(
				cleanup_function,
				[resource_ref],
				VoidType,
				clone_core_source_loc(loc),
			)
		None:
			CallExpr(
				UnknownCall,
				VarExpr(
					core_var("close", None),
					NamedType("Closure", []),
					clone_core_source_loc(loc),
				),
				[resource_ref],
				VoidType,
				clone_core_source_loc(loc),
			)


private pure func resource_scope_expr(
	binding: TypedWithBinding,
	resource_type: CoreType,
	acquire: CoreExpr,
	body: CoreExpr,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	resource_var = core_var(with_resource_name(binding), None)
	scope: CoreResourceScope = {
		variable = clone_core_var(resource_var),
		typ = clone_core_type(resource_type),
		acquire = acquire,
		body = body,
		cleanup = resource_cleanup_call(
			binding,
			resource_var,
			clone_core_type(resource_type),
			clone_core_source_loc(loc),
		)
	}
	ResourceScopeExpr(scope, result_type, loc)


private pure func lower_with_mapped_failure_case(
	context: CoreLowerContext,
	mapper: TypedWithErrorMap,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreRawMatchCase, CoreLowerError]:
	mapped_error ?= lower_typed_expr_with_context(context, mapper.value)

	failure_var = if mapper.name.text == "_":
		core_var(
			question_bind_name("with_failure", mapper.span),
			None,
		)
	else:
		core_var(mapper.name.text, None)

	Ok({
		pattern = ConstructorPattern("Err", [NamePattern(failure_var.name)]),
		body = builtin_core_call("blorp_result_err", [mapped_error], result_type, loc),
	})


private pure func lower_with_failure_case(
	context: CoreLowerContext,
	binding: TypedWithBinding,
	kind: CoreLowerCarrierKind,
	acquisition_type: CoreType,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreRawMatchCase, CoreLowerError]:
	match binding.error_map:
		None:
			lower_question_bind_failure_case(
				context,
				kind,
				acquisition_type,
				result_type,
				binding.span,
				loc,
			)
		Some(mapper):
			match kind:
				CoreLowerOptionCarrier:
					Err(CoreLowerInvalidType("with ?= error mapping reached lowering for Option"))
				CoreLowerResultCarrier:
					lower_with_mapped_failure_case(context, mapper, result_type, loc)


private pure func lower_typed_with(
	context: CoreLowerContext,
	binding: TypedWithBinding,
	body: TypedExpr,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	acquisition ?= lower_typed_expr_with_context(context, binding.value)
	acquisition_type ?= core_lower_value_type(typed_expr_value_type(binding.value))
	is_try = typed_with_binding_is_try(binding)
	resource_type ?= with_resource_type(is_try, clone_core_type(acquisition_type))
	lowered_body ?= lower_typed_expr_with_context(context, body)

	if is_try:
		acquisition_kind ?= core_carrier_kind(acquisition_type)
		result_kind ?= core_carrier_kind(result_type)

		if acquisition_kind != result_kind:
			Err(CoreLowerInvalidType("with ?= carrier kind changed between inference and lowering"))
		else:
			payload_name: ParsedIdentifier = {
				text = question_bind_name("with_payload", binding.span),
				span = binding.span
			}
			payload_var = core_var(payload_name.text, None)
			payload_ref = VarExpr(
				clone_core_var(payload_var),
				clone_core_type(resource_type),
				clone_core_source_loc(loc),
			)
			success_scope = resource_scope_expr(
				binding,
				clone_core_type(resource_type),
				payload_ref,
				lowered_body,
				clone_core_type(result_type),
				clone_core_source_loc(loc),
			)
			success_case = lower_question_bind_success_case(
				context,
				payload_name,
				acquisition_kind,
				success_scope,
			)
			failure_case ?= lower_with_failure_case(
				context,
				binding,
				acquisition_kind,
				clone_core_type(acquisition_type),
				clone_core_type(result_type),
				clone_core_source_loc(loc),
			)
			temp_var = core_var(
				question_bind_name("with_value", binding.span),
				None,
			)
			temp_ref = VarExpr(
				clone_core_var(temp_var),
				clone_core_type(acquisition_type),
				clone_core_source_loc(loc),
			)
			match_expr = RawMatchExpr(
				temp_ref,
				[success_case, failure_case],
				clone_core_type(result_type),
				clone_core_source_loc(loc),
			)

			Ok(LetExpr(temp_var, False, acquisition_type, acquisition, match_expr))
	else:
		Ok(resource_scope_expr(binding, resource_type, acquisition, lowered_body, result_type, loc))


private pure func lower_tuple_destruct_bindings(
	context: CoreLowerContext,
	names: List[ParsedIdentifier],
	index: Int,
	tuple_ref: CoreExpr,
	field_types: List[CoreType],
	body: CoreExpr,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	match names.get(index):
		None:
			Ok(body)
		Some(name):
			field_type ?= match field_types.get(index):
				Some(typ):
					Ok(typ)
				None:
					Err(
						CoreLowerInvalidType(
							"tuple destructure field type missing at index " + index.to_string(),
						),
					)

			inner ?= lower_tuple_destruct_bindings(
				context,
				names,
				index + 1,
				tuple_ref,
				field_types,
				body,
				loc,
			)

			if name.text == "_":
				Ok(inner)
			else:
				Ok(
					LetExpr(
						core_var(name.text, None),
						False,
						field_type,
						TupleFieldExpr(tuple_ref, index, field_type, loc),
						inner,
					),
				)


private pure func lower_typed_tuple_destruct(
	context: CoreLowerContext,
	names: List[ParsedIdentifier],
	value: TypedExpr,
	span: SourceSpan,
	rest: List[TypedExpr],
	block_type: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	lowered_value ?= lower_typed_expr_with_context(context, value)
	value_type ?= core_lower_value_type(typed_expr_value_type(value))

	field_types ?= match value_type:
		TupleType(items):
			if items.length() == names.length():
				Ok(items)
			else:
				Err(CoreLowerInvalidType("tuple destructure has " + names
							.length()
							.to_string() + " names but tuple type has " + items
							.length()
							.to_string() + " fields"))
		_:
			Err(CoreLowerInvalidType("tuple destructure value must have tuple type"))

	body ?= lower_typed_block_expr(context, rest, block_type, loc)
	temp_var = core_var(tuple_destruct_name(span), None)
	temp_ref = VarExpr(temp_var, value_type, loc)
	body_with_bindings ?= lower_tuple_destruct_bindings(
		context,
		names,
		0,
		temp_ref,
		field_types,
		body,
		loc,
	)

	Ok(LetExpr(temp_var, False, value_type, lowered_value, body_with_bindings))


private pure func lower_typed_block_expr(
	context: CoreLowerContext,
	items: List[TypedExpr],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CoreLowerError]:
	match items.get(0):
		None:
			Ok(VoidExpr(typ, loc))
		Some(first):
			rest: List[TypedExpr] = items.tail()
			first_loc: CoreSourceLoc = core_source_loc(typed_expr_span(first))

			match first:
				TypedVarDeclExpr(payload, _):
					lowered_init ?= lower_typed_expr_with_context(context, payload.initializer)
					-- Typechecking has already validated any source annotation.
					-- The initializer's value type carries the resolved module
					-- identity and widening decision that Core must preserve.
					bind_type ?= core_lower_value_type(typed_expr_value_type(payload.initializer))
					body ?= lower_typed_block_expr(
						context,
						rest,
						typ,
						core_source_loc(payload.span),
					)

					Ok(
						LetExpr(
							core_var(payload.name.text, None),
							payload.is_mutable,
							bind_type,
							lowered_init,
							body,
						),
					)
				TypedQuestionBindExpr(name, _, value, span, _):
					lower_typed_question_bind(context, name, value, span, rest, typ, first_loc)
				TypedTupleDestructExpr(names, value, span, _):
					lower_typed_tuple_destruct(context, names, value, span, rest, typ, first_loc)
				TypedConcurrentBlockExpr(params, bindings, _, _):
					body ?= if rest.length() == 0:
						Ok(VoidExpr(typ, loc))
					else:
						lower_typed_block_expr(context, rest, typ, first_loc)

					lower_typed_concurrent_block(context, params, bindings, body, typ, first_loc)
				_:
					lowered_first ?= lower_typed_expr_with_context(context, first)

					if rest.length() == 0:
						Ok(lowered_first)
					else:
						lowered_rest ?= lower_typed_block_expr(context, rest, typ, loc)
						Ok(SeqExpr(lowered_first, lowered_rest))


pure func lower_typed_expr(expr: TypedExpr) -> Result[CoreExpr, CoreLowerError]:
	lower_typed_expr_with_context(
		core_lower_context(0, None),
		expr,
	)


private pure func lower_typed_expr_with_context(
	context: CoreLowerContext,
	expr: TypedExpr,
) -> Result[CoreExpr, CoreLowerError]:
	typ ?= core_lower_value_type(typed_expr_value_type(expr))

	lower_typed_expr_as_type(context, expr, typ)


private pure func lower_typed_expr_as_type(
	context: CoreLowerContext,
	expr: TypedExpr,
	typ: CoreType,
) -> Result[CoreExpr, CoreLowerError]:
	loc: CoreSourceLoc = core_source_loc(typed_expr_span(expr))

	match expr:
		TypedNameExpr(name, info):
			identity ?= lower_name_expr_identity(context, name, info)
			(clean_name, def_id) = identity
			Ok(VarExpr(core_var(clean_name, def_id), typ, loc))
		TypedIntLiteralExpr(text, _, _):
			Ok(LiteralExpr(core_literal_int(text), typ, loc))
		TypedFloatLiteralExpr(text, _, _):
			Ok(LiteralExpr(core_literal_float(text), typ, loc))
		TypedStringLiteralExpr(text, _, _):
			Ok(LiteralExpr(StringLiteral(text), typ, loc))
		TypedStringInterpolationExpr(_, _, _, _):
			Err(
				CoreLowerUnsupported(
					"raw string interpolation reached Core lowering before interpolation parsing",
				),
			)
		TypedStringInterpolationPartsExpr(parts, _, _, _):
			lower_string_interpolation(context, parts, loc)
		TypedBoolLiteralExpr(value, _, _):
			Ok(LiteralExpr(BoolLiteral(value), typ, loc))
		TypedCharLiteralExpr(value, _, _):
			Ok(LiteralExpr(CharLiteral(value), typ, loc))
		TypedVoidExpr(_, _):
			Ok(VoidExpr(typ, loc))
		TypedBreakExpr(_, _):
			Ok(BreakExpr(typ, loc))
		TypedContinueExpr(_, _):
			Ok(ContinueExpr(typ, loc))
		TypedAscriptionExpr(inner, _, _, _):
			lower_typed_expr_with_context(context, inner)
		TypedOpaqueIntoExpr(_, inner, _, _):
			lower_typed_expr_with_context(context, inner)
		TypedOpaqueFromExpr(_, inner, _, _):
			lower_typed_expr_as_type(context, inner, typ)
		TypedAssignExpr(name, _, value, _, _):
			lowered_value ?= lower_typed_expr_with_context(context, value)
			Ok(AssignExpr(core_var(name.text, None), lowered_value, typ, loc))
		TypedUnaryExpr(op, inner, _, _):
			lowered_inner ?= lower_typed_expr_with_context(context, inner)
			Ok(UnaryExpr(core_unary_op(op), lowered_inner, typ, loc))
		TypedBinaryExpr(op, left, right, _, _):
			lowered_left ?= lower_typed_expr_with_context(context, left)
			lowered_right ?= lower_typed_expr_with_context(context, right)
			Ok(BinaryExpr(core_binary_op(op), lowered_left, lowered_right, typ, loc))
		TypedLogicalExpr(op, left, right, _, _):
			lowered_left ?= lower_typed_expr_with_context(context, left)
			lowered_right ?= lower_typed_expr_with_context(context, right)
			Ok(LogicalExpr(core_logical_op(op), lowered_left, lowered_right, typ, loc))
		TypedCallExpr(callee, args, _, info):
			raw_callee ?= lower_typed_expr_with_context(context, callee)
			lowered_callee ?= apply_resolved_callee_identity(
				context,
				info.resolved_call,
				raw_callee,
			)
			lowered_args ?= lower_typed_exprs(context, args)
			call_kind ?= lower_resolved_call_kind(context, info.resolved_call, lowered_callee)
			Ok(CallExpr(call_kind, lowered_callee, lowered_args, typ, loc))
		TypedTupleExpr(items, _, _):
			lowered_items ?= lower_typed_exprs(context, items)
			Ok(TupleExpr(lowered_items, typ, loc))
		TypedListExpr(items, _, _):
			lowered_items ?= lower_typed_list_items(context, items)
			construct: CoreListConstruct = {
				layout = PointerListStorage,
				elements = lowered_items,
				elem_needs_release = lowered_items.any(
					pure func(item: CoreBoxedStorageValue): item.needs_release,
				)
			}
			Ok(ListConstructExpr(construct, typ, loc))
		TypedVectorExpr(items, _, _):
			lowered_items ?= lower_typed_exprs(context, items)
			Ok(VectorExpr(lowered_items, typ, loc))
		TypedDictExpr(entries, _, _):
			lowered_entries ?= lower_typed_dict_entries(context, entries)
			Ok(DictExpr(lowered_entries, typ, loc))
		TypedFieldAccessExpr(receiver, field, _, _):
			lower_typed_field_access(context, receiver, field, typ, loc)
		TypedRangeExpr(start_expr, end_expr, _, _):
			lowered_start ?= lower_typed_expr_with_context(context, start_expr)
			lowered_end ?= lower_typed_expr_with_context(context, end_expr)
			Ok(RangeExpr(lowered_start, lowered_end, typ, loc))
		TypedRecordExpr(fields, _, _):
			lowered_fields ?= lower_typed_record_fields(context, fields)
			Ok(RecordExpr(lowered_fields, typ, loc))
		TypedRecordUpdateExpr(receiver, updates, record_fields, span, _):
			lower_typed_record_update(context, receiver, updates, record_fields, span, typ, loc)
		TypedIfExpr(condition, then_branch, else_branch, _, _):
			lowered_condition ?= lower_typed_expr_with_context(context, condition)
			lowered_then ?= lower_typed_expr_with_context(context, then_branch)

			lowered_else ?= match else_branch:
				Some(branch):
					lower_typed_expr_with_context(context, branch)
				None:
					Ok(VoidExpr(typ, loc))

			Ok(IfExpr(lowered_condition, lowered_then, lowered_else, typ, loc))
		TypedMatchExpr(scrutinee, cases, _, _):
			lowered_scrutinee ?= lower_typed_expr_with_context(context, scrutinee)
			lowered_cases ?= lower_raw_match_cases(context, cases)
			Ok(RawMatchExpr(lowered_scrutinee, lowered_cases, typ, loc))
		TypedSelectExpr(arms, _, _):
			lowered_arms ?= lower_typed_select_arms(context, arms)
			Ok(SelectExpr(lowered_arms, typ, loc))
		TypedLambdaExpr(is_pure, params, _, body, _, _):
			lowered_params ?= lower_typed_lambda_params(context, params)
			lowered_return_type ?= core_lower_value_type(typed_expr_value_type(body))
			lowered_body ?= lower_typed_expr_with_context(context, body)
			Ok(LambdaExpr(lowered_params, lowered_return_type, lowered_body, is_pure, typ, loc))
		TypedBlockExpr(items, _, _):
			lower_typed_block_expr(context, items, typ, loc)
		TypedDebugBlockExpr(body, _, _):
			lowered_body ?= lower_typed_expr_with_context(context, body)
			Ok(DebugBlockExpr(lowered_body, typ, loc))
		TypedWithExpr(binding, body, _, _):
			lower_typed_with(context, binding, body, typ, loc)
		TypedWhileExpr(condition, body, _, _):
			lowered_condition ?= lower_typed_expr_with_context(context, condition)
			lowered_body ?= lower_typed_expr_with_context(context, body)
			Ok(WhileExpr(lowered_condition, lowered_body, typ, loc))
		TypedDetachExpr(body, _, _):
			lowered_body ?= lower_typed_expr_with_context(context, body)
			Ok(PreClosureDetachExpr(lowered_body, typ, loc))
		TypedForExpr(binder, iterable, loop_view, body, _, _):
			lower_typed_for(context, binder, iterable, loop_view, body, typ, loc)
		TypedConcurrentBlockExpr(params, bindings, _, _):
			lower_typed_concurrent_block(
				context,
				params,
				bindings,
				VoidExpr(typ, loc),
				typ,
				loc,
			)
		TypedConcurrentForExpr(name, iterable, params, body, _, _):
			lower_typed_concurrent_for(context, name, iterable, params, body, typ, loc)
		TypedVarDeclExpr(_, _):
			lower_typed_block_expr(context, [expr], typ, loc)
		_:
			Err(CoreLowerUnsupported(typed_expr_label(expr)))


private pure func core_type_param_names(params: List[ParsedTypeParamDecl]) -> List[String]:
	params.map(func(param: ParsedTypeParamDecl): param.name.text)


private pure func core_lower_param(
	param: ParsedParam,
	param_type: SemanticType,
	index: Int,
) -> Result[CoreLowerParamResult, CoreLowerError]:
	typ ?= core_lower_value_type(param_type)

	match param.binder:
		ParsedParamNameBinder(name):
			Ok({
				param = {
					name = core_var(name.text, None),
					typ = typ,
					loc = core_source_loc(name.span)
				},
				destructure = None,
			})
		ParsedParamWildcardBinder(span):
			Ok({
				param = {
					name = core_var(
						"__pattern_param_${index}_${span.start_line}_${span.start_column}",
						None,
					),
					typ = typ,
					loc = core_source_loc(span)
				},
				destructure = None,
			})
		ParsedParamTupleBinder(names, span):
			match typ:
				TupleType(field_types):
					if field_types.length() != names.length():
						Err(
							CoreLowerInvalidParam(
								"tuple parameter has ${names.length()} names but its type has " + "${field_types.length()} fields",
							),
						)
					else:
						lowered_param: CoreParam = {
							name = core_var(
								"__pattern_param_${index}_${span.start_line}_${span.start_column}",
								None,
							),
							typ = typ,
							loc = core_source_loc(span)
						}
						Ok({
							param = lowered_param,
							destructure = Some({
								param = lowered_param,
								names = names,
							}),
						})
				_:
					Err(
						CoreLowerInvalidParam(
							"tuple parameter requires a tuple type, got " + type_to_string(
								param_type,
							),
						),
					)


private pure func core_lower_params(
	params: List[ParsedParam],
	param_types: List[SemanticType],
) -> Result[CoreLowerParams, CoreLowerError]:
	if params.length() != param_types.length():
		Err(CoreLowerInvalidParam("function parameter count " + params
					.length()
					.to_string() + " does not match typed parameter count " + param_types
					.length()
					.to_string()))
	else:
		var lowered: List[CoreParam] = []
		var destructures: List[CoreLowerParamDestructure] = []
		var index: Int = 0
		var failure: Option[CoreLowerError] = None

		while index < params.length() and failure.is_none():
			match (params.get(index), param_types.get(index)):
				(Some(param), Some(param_type)):
					match core_lower_param(param, param_type, index):
						Ok(lowered_param):
							lowered = lowered.append(lowered_param.param)

							match lowered_param.destructure:
								Some(destructure):
									destructures = destructures.append(destructure)
								None:
									void
						Err(error):
							failure = Some(error)
				_:
					failure = Some(
						CoreLowerInvalidParam(
							"function parameter metadata is missing at index " + index.to_string(),
						),
					)

			index += 1

		match failure:
			Some(error):
				Err(error)
			None:
				Ok({
					params = lowered,
					destructures = destructures,
				})


private pure func lower_param_destructures(
	context: CoreLowerContext,
	destructures: List[CoreLowerParamDestructure],
	index: Int,
	body: CoreExpr,
) -> Result[CoreExpr, CoreLowerError]:
	match destructures.get(index):
		None:
			Ok(body)
		Some(destructure):
			inner ?= lower_param_destructures(context, destructures, index + 1, body)

			match destructure.param.typ:
				TupleType(field_types):
					lower_tuple_destruct_bindings(
						context,
						destructure.names,
						0,
						VarExpr(
							destructure.param.name,
							destructure.param.typ,
							destructure.param.loc,
						),
						field_types,
						inner,
						destructure.param.loc,
					)
				_:
					Err(
						CoreLowerInvalidParam(
							"validated tuple parameter lost its tuple type during lowering",
						),
					)


private pure func lower_typed_function_body(
	context: CoreLowerContext,
	info: TypedFunctionInfo,
	params: CoreLowerParams,
	return_type: CoreType,
) -> Result[CoreLowerFunctionBody, CoreLowerError]:
	match parsed_function_body_kind(info.decl.body):
		ParsedFunctionSourceBody:
			match info.body:
				Some(body):
					match lower_typed_expr_with_context(context, body):
						Ok(lowered_body):
							wrapped_body ?= lower_param_destructures(
								context,
								params.destructures,
								0,
								lowered_body,
							)
							Ok(CoreLowerUserFunctionBody(wrapped_body))
						Err(error):
							Err(error)
				None:
					Err(
						CoreLowerUnsupported(
							"typed source function has no body: " + info.decl.name.text,
						),
					)
		ParsedFunctionForwardDecl:
			if info.body.is_some():
				Err(
					CoreLowerUnsupported(
						"forward function has a typed body: " + info.decl.name.text,
					),
				)
			else:
				Ok(CoreLowerForwardDeclaration)
		ParsedFunctionBuiltinBody(name):
			if info.body.is_some():
				Err(
					CoreLowerUnsupported(
						"builtin function has a typed body: " + info.decl.name.text,
					),
				)
			else:
				match name:
					None:
						Ok(CoreLowerBuiltinDeclaration)
					Some(builtin_name):
						if builtin_name.starts_with("std/"):
							Ok(CoreLowerBuiltinDeclaration)
						else:
							Ok(
								CoreLowerUserFunctionBody(
									builtin_core_call(
										builtin_name,
										params.params.map(core_param_value),
										return_type,
										core_source_loc(info.decl.span),
									),
								),
							)


private pure func lower_typed_function_info(
	context: CoreLowerContext,
	info: TypedFunctionInfo,
) -> Result[CoreLowerFunctionResult, CoreLowerError]:
	params ?= core_lower_params(info.decl.params, info.param_types)
	return_type ?= core_lower_value_type(info.semantic_return_type)
	lowered_function_body ?= lower_typed_function_body(
		context,
		info,
		params,
		clone_core_type(return_type),
	)

	body: Option[CoreExpr] = match lowered_function_body:
		CoreLowerUserFunctionBody(lowered_body):
			Some(lowered_body)
		CoreLowerForwardDeclaration:
			None
		CoreLowerBuiltinDeclaration:
			None

	function_kind: CoreFunctionKind = lowered_function_kind(lowered_function_body)

	(next_context, def_id) = match info.callable_id:
		Some(callable_id):
			(context, callable_id)
		None:
			mint_def_id(context)

	Ok({
		context = next_context,
		function_info = {
			name = info.decl.name.text,
			source_module = context.source_module,
			type_params = info.effective_type_params.map(pure func(param): param.name),
			params = params.params,
			return_type = return_type,
			body = body,
			is_pure = info.decl.is_pure,
			function_kind = function_kind,
			def_id = def_id,
			loc = core_source_loc(info.decl.span)
		},
	})


private pure func lower_typed_function(
	context: CoreLowerContext,
	info: TypedFunctionInfo,
) -> Result[CoreLowerDeclResult, CoreLowerError]:
	result ?= lower_typed_function_info(context, info)
	Ok({
		context = result.context,
		decl = FunctionDecl(result.function_info),
	})


private pure func lower_foreign_link_platform(
	platform: TypedForeignLinkPlatform,
) -> CoreForeignLinkPlatform:
	match platform:
		TypedForeignLinux:
			CoreForeignLinux
		TypedForeignMacos:
			CoreForeignMacos


private pure func lower_typed_foreign_function(
	context: CoreLowerContext,
	info: TypedForeignFunctionInfo,
) -> Result[CoreLowerDeclResult, CoreLowerError]:
	params ?= core_lower_params(info.decl.params, info.param_types)
	return_type ?= core_lower_value_type(info.semantic_return_type)

	(next_context, def_id) = match info.callable_id:
		Some(callable_id):
			(context, callable_id)
		None:
			mint_def_id(context)

	arg_passing: CoreForeignArgPassing = if typed_foreign_arg_passing_borrows(info.arg_passing):
		ForeignBorrowArgs
	else:
		ForeignDefaultArgs([])

	link_flags: List[CoreForeignLinkFlag] = info.link_flags.map(
		pure func(link_flag: TypedForeignLinkFlag) -> CoreForeignLinkFlag: {
			platform = link_flag.platform.map(lower_foreign_link_platform),
			flag = link_flag.flag
		},
	)

	Ok({
		context = next_context,
		decl = FunctionDecl({
			name = info.decl.name.text,
			source_module = context.source_module,
			type_params = [],
			params = params.params,
			return_type = return_type,
			body = None,
			is_pure = info.decl.is_pure,
			function_kind = ForeignFunction({
				c_name = info.c_name,
				includes = info.includes,
				link_flags = link_flags,
				arg_passing = arg_passing,
			}),
			def_id = def_id,
			loc = core_source_loc(info.decl.span),
		}),
	})


private pure func lower_typed_global(
	context: CoreLowerContext,
	info: TypedGlobalVarInfo,
	is_private: Bool,
) -> Result[CoreLowerDeclResult, CoreLowerError]:
	(next_context, def_id) = mint_def_id(context)
	init ?= lower_typed_expr_with_context(context, info.value)
	typ ?= core_lower_value_type(info.binding_type)

	Ok({
		context = next_context,
		decl = GlobalDecl({
			name = core_var(info.decl.name.text, Some(def_id)),
			source_module = context.source_module,
			typ = typ,
			init = init,
			is_mutable = info.decl.is_mutable,
			is_const = not info.decl.is_mutable,
			is_private = is_private,
			def_id = def_id,
			loc = core_source_loc(info.decl.span),
		}),
	})


private pure func lower_value_record_field(
	field: TypedRecordFieldInfo,
) -> Result[CoreValueRecordField, CoreLowerError]:
	typ ?= core_lower_type(field.semantic_type)
	Ok({
		name = field.name,
		typ = typ,
	})


private pure func lower_value_record_fields(
	fields: List[TypedRecordFieldInfo],
) -> Result[List[CoreValueRecordField], CoreLowerError]:
	var lowered: List[CoreValueRecordField] = []
	var failure: Option[CoreLowerError] = None

	for field in fields:
		if failure.is_none():
			match lower_value_record_field(field):
				Ok(lowered_field):
					lowered = lowered.append(lowered_field)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_heap_record_field(
	field: TypedRecordFieldInfo,
) -> Result[CoreHeapRecordField, CoreLowerError]:
	typ ?= core_lower_type(field.semantic_type)
	Ok({
		name = field.name,
		typ = typ,
		release_policy = CoreTypePolicy.cleanup_release_policy_for_type(typ),
	})


private pure func lower_heap_record_fields(
	fields: List[TypedRecordFieldInfo],
) -> Result[List[CoreHeapRecordField], CoreLowerError]:
	var lowered: List[CoreHeapRecordField] = []
	var failure: Option[CoreLowerError] = None

	for field in fields:
		if failure.is_none():
			match lower_heap_record_field(field):
				Ok(lowered_field):
					lowered = lowered.append(lowered_field)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_typed_record(
	context: CoreLowerContext,
	info: TypedRecordInfo,
) -> Result[CoreLowerDeclResult, CoreLowerError]:
	if info.decl.is_struct:
		fields ?= lower_value_record_fields(info.fields)
		Ok({
			context = context,
			decl = ValueRecordDecl({
				abi_type = lowered_declared_abi_type(context, info.decl.name.text),
				name = info.decl.name.text,
				type_params = core_type_param_names(info.decl.type_params),
				fields = fields,
				loc = core_source_loc(info.decl.span),
			}),
		})
	else:
		fields ?= lower_heap_record_fields(info.fields)
		Ok({
			context = context,
			decl = HeapRecordDecl({
				abi_type = lowered_declared_abi_type(context, info.decl.name.text),
				name = info.decl.name.text,
				type_params = core_type_param_names(info.decl.type_params),
				fields = fields,
				loc = core_source_loc(info.decl.span),
			}),
		})


private pure func constructor_c_name(name: String, def_id: Option[Int]) -> String:
	match def_id:
		Some(id):
			"__def_" + id.to_string() + "_" + name
		None:
			name


private pure func source_union_typed_payload_field_supported(typ: SemanticType) -> Bool:
	match typ:
		SemanticNamedType(name, args):
			if args.length() != 0:
				False
			else:
				normalized_name = normalize_type_name(name)

				(
					normalized_name == "Int"
					or normalized_name == "Int8"
					or normalized_name == "Int16"
					or normalized_name == "Int32"
					or normalized_name == "Int64"
					or normalized_name == "Int128"
					or normalized_name == "UInt8"
					or normalized_name == "UInt16"
					or normalized_name == "UInt32"
					or normalized_name == "UInt64"
					or normalized_name == "UInt128"
					or normalized_name == "Float"
					or normalized_name == "Float32"
					or normalized_name == "Float16"
					or normalized_name == "Bool"
					or normalized_name == "Char"
					or normalized_name == "Fixed"
					or normalized_name == "Range"
				)
		SemanticRangeType(_):
			True
		_:
			False


private pure func lower_union_payload_storage(info: TypedUnionInfo) -> CoreUnionPayloadStorage:
	if (
		info.decl.type_params.length() == 0
		and not CoreTypePolicy.is_runtime_erased_union_payload_type_name(info.decl.name.text)
		and info.variants.all(
			func(variant): variant.fields.all(source_union_typed_payload_field_supported),
		)
	):
		TypedUnionPayloadStorage
	else:
		ErasedUnionPayloadStorage


private pure func lower_enum_variant(
	variant: TypedUnionVariantInfo,
) -> Result[CoreEnumVariant, CoreLowerError]:
	if variant.fields.length() == 0:
		Ok({
			name = variant.name,
			c_name = constructor_c_name(variant.name, variant.def_id),
			tag = variant.tag,
			def_id = variant.def_id,
		})
	else:
		Err(CoreLowerUnsupported("enum variant payload"))


private pure func lower_enum_variants(
	variants: List[TypedUnionVariantInfo],
) -> Result[List[CoreEnumVariant], CoreLowerError]:
	var lowered: List[CoreEnumVariant] = []
	var failure: Option[CoreLowerError] = None

	for variant in variants:
		if failure.is_none():
			match lower_enum_variant(variant):
				Ok(lowered_variant):
					lowered = lowered.append(lowered_variant)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_union_field(typ: SemanticType) -> Result[CoreUnionField, CoreLowerError]:
	core_type ?= core_lower_type(typ)

	Ok({
		typ = core_type,
		release_policy = CoreTypePolicy.cleanup_release_policy_for_type(core_type),
	})


private pure func lower_union_fields(
	fields: List[SemanticType],
) -> Result[List[CoreUnionField], CoreLowerError]:
	var lowered: List[CoreUnionField] = []
	var failure: Option[CoreLowerError] = None

	for field in fields:
		if failure.is_none():
			match lower_union_field(field):
				Ok(lowered_field):
					lowered = lowered.append(lowered_field)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_union_variant(
	type_name: String,
	variant: TypedUnionVariantInfo,
) -> Result[CoreUnionVariant, CoreLowerError]:
	fields ?= lower_union_fields(variant.fields)

	Ok({
		name = variant.name,
		c_name = constructor_c_name(variant.name, variant.def_id),
		tag_c_name = "TAG_" + type_name + "_" + variant.name,
		tag = variant.tag,
		fields = fields,
		def_id = variant.def_id,
	})


private pure func lower_union_variants(
	type_name: String,
	variants: List[TypedUnionVariantInfo],
) -> Result[List[CoreUnionVariant], CoreLowerError]:
	var lowered: List[CoreUnionVariant] = []
	var failure: Option[CoreLowerError] = None

	for variant in variants:
		if failure.is_none():
			match lower_union_variant(type_name, variant):
				Ok(lowered_variant):
					lowered = lowered.append(lowered_variant)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_typed_union(
	context: CoreLowerContext,
	info: TypedUnionInfo,
) -> Result[CoreLowerDeclResult, CoreLowerError]:
	if info.decl.is_enum:
		variants ?= lower_enum_variants(info.variants)
		Ok({
			context = context,
			decl = EnumDecl({
				abi_type = lowered_declared_abi_type(context, info.decl.name.text),
				name = info.decl.name.text,
				type_params = core_type_param_names(info.decl.type_params),
				variants = variants,
				loc = core_source_loc(info.decl.span),
			}),
		})
	else:
		storage = lower_union_payload_storage(info)
		variants ?= lower_union_variants(info.decl.name.text, info.variants)
		Ok({
			context = context,
			decl = UnionDecl({
				abi_type = lowered_declared_abi_type(context, info.decl.name.text),
				name = info.decl.name.text,
				type_params = core_type_param_names(info.decl.type_params),
				payload_storage = storage,
				variants = variants,
				loc = core_source_loc(info.decl.span),
			}),
		})


private pure func lower_typed_type_alias(
	context: CoreLowerContext,
	info: TypedTypeAliasInfo,
) -> Result[CoreLowerDeclResult, CoreLowerError]:
	target ?= core_lower_type(info.semantic_target_type)

	Ok({
		context = context,
		decl = TypeAliasDecl({
			abi_type = lowered_declared_abi_type(context, info.decl.name.text),
			name = info.decl.name.text,
			type_params = core_type_param_names(info.decl.type_params),
			target = target,
			is_opaque = info.decl.is_opaque,
			loc = core_source_loc(info.decl.span),
		}),
	})


private pure func lower_typed_trait_method(
	method: TypedTraitMethodInfo,
) -> Result[CoreTraitMethod, CoreLowerError]:
	params ?= core_lower_params(method.decl.params, method.param_types)
	return_type ?= core_lower_value_type(method.semantic_return_type)

	Ok({
		name = method.decl.name.text,
		params = params.params,
		return_type = return_type,
		is_pure = method.decl.is_pure,
		loc = core_source_loc(method.decl.span),
	})


private pure func lower_typed_trait_methods(
	methods: List[TypedTraitMethodInfo],
) -> Result[List[CoreTraitMethod], CoreLowerError]:
	match methods:
		[]:
			Ok([])
		[method, ...rest]:
			lowered ?= lower_typed_trait_method(method)
			lowered_rest ?= lower_typed_trait_methods(rest)
			Ok([lowered].concat(lowered_rest))


private pure func lower_typed_trait(
	context: CoreLowerContext,
	info: TypedTraitInfo,
) -> Result[CoreLowerDeclResult, CoreLowerError]:
	methods ?= lower_typed_trait_methods(info.methods)

	Ok({
		context = context,
		decl = TraitDecl({
			name = info.decl.name.text,
			type_params = core_type_param_names(info.decl.type_params),
			supertraits = info.decl.supertraits.map(func(name): name.text),
			methods = methods,
			loc = core_source_loc(info.decl.span),
		}),
	})


private pure func lower_typed_impl_methods_at(
	context: CoreLowerContext,
	methods: List[TypedFunctionInfo],
	index: Int,
	lowered: List[CoreFunction],
) -> Result[(CoreLowerContext, List[CoreFunction]), CoreLowerError]:
	match methods.get(index):
		Some(method):
			result ?= lower_typed_function_info(context, method)
			lower_typed_impl_methods_at(
				result.context,
				methods,
				index + 1,
				lowered.append(result.function_info),
			)
		None:
			Ok((context, lowered))


private pure func lower_typed_impl(
	context: CoreLowerContext,
	info: TypedImplInfo,
) -> Result[CoreLowerDeclResult, CoreLowerError]:
	for_type ?= core_lower_type(info.for_type)
	lowered_methods ?= lower_typed_impl_methods_at(context, info.methods, 0, [])
	(next_context, methods) = lowered_methods

	Ok({
		context = next_context,
		decl = ImplDecl({
			trait_name = info.decl.trait_name.text,
			for_type = for_type,
			type_params = info.type_params.map(pure func(param) -> CoreTypeParam: {
					name = param.name,
					bounds = param.bounds
				}),
			methods = methods,
			loc = core_source_loc(info.decl.span),
		}),
	})


private pure func lower_typed_decl_with_visibility(
	context: CoreLowerContext,
	decl: TypedDecl,
	is_private: Bool,
) -> Result[CoreLowerDeclResult, CoreLowerError]:
	match decl:
		TypedFunctionDecl(info):
			lower_typed_function(context, info)
		TypedForeignFunctionDecl(info):
			lower_typed_foreign_function(context, info)
		TypedGlobalVarDecl(info):
			lower_typed_global(context, info, is_private)
		TypedPrivateDecl(inner):
			lower_typed_decl_with_visibility(context, inner, True)
		TypedRecordDecl(info):
			lower_typed_record(context, info)
		TypedUnionDecl(info):
			lower_typed_union(context, info)
		TypedTypeAliasDecl(info):
			lower_typed_type_alias(context, info)
		TypedTraitDecl(info):
			lower_typed_trait(context, info)
		TypedImplDecl(info):
			lower_typed_impl(context, info)
		TypedParsedDecl(_):
			Err(CoreLowerUnsupported("untyped parsed declaration"))


pure func lower_typed_decl(
	context: CoreLowerContext,
	decl: TypedDecl,
) -> Result[CoreLowerDeclResult, CoreLowerError]:
	lower_typed_decl_with_visibility(context, decl, False)


-- Imports have already become explicit graph/import-table metadata, while
-- builtin type declarations define stable ABI types rather than emitted Core
-- declarations. These are the only typed-program declarations intentionally
-- consumed without producing a Core declaration.
private pure func typed_decl_is_compile_time_only(decl: TypedDecl) -> Bool:
	match decl:
		TypedParsedDecl(parsed):
			match parsed:
				ImportBlockParsedDecl(_, _):
					True
				BuiltinTypeParsedDecl(_):
					True
				PrivateParsedDecl(inner, _):
					typed_decl_is_compile_time_only(TypedParsedDecl(inner))
				_:
					False
		TypedPrivateDecl(inner):
			typed_decl_is_compile_time_only(inner)
		_:
			False


pure func lower_typed_program(
	context: CoreLowerContext,
	program: TypedProgram,
) -> Result[CoreLowerProgramResult, CoreLowerError]:
	var current: CoreLowerContext = context
	var decls: List[CoreDecl] = []
	var foreign_includes: List[String] = []
	var failure: Option[CoreLowerError] = None

	for decl in program.decls:
		if failure.is_none():
			if typed_decl_is_compile_time_only(decl):
				void
			else:
				match decl:
					TypedForeignFunctionDecl(info):
						foreign_includes = foreign_includes
							.concat(info.includes)
							.unique()
					_:
						void

				match lower_typed_decl(current, decl):
					Ok(result):
						current = result.context
						decls = decls.append(result.decl)
					Err(error):
						failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				context = current,
				program = {
					decls = decls,
					foreign_includes = foreign_includes
				},
			})
