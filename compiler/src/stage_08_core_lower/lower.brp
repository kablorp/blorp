private CALLABLE_ID_SEPARATOR: String = "#"

private CORE_INT_MAX_DECIMAL: String = "9223372036854775807"

private CORE_INT_MIN_MAGNITUDE_DECIMAL: String = "9223372036854775808"

private MICROSECONDS_PER_MILLISECOND: Int = 1000

private PARALLEL_VECTOR_TYPE_NAME: String = "ParallelVector"

private CANONICAL_PARALLEL_VECTOR_TYPE_NAME: String = "std/vector::ParallelVector"

private PARALLEL_MATRIX_TYPE_NAME: String = "ParallelMatrix"

private CANONICAL_PARALLEL_MATRIX_TYPE_NAME: String = "std/matrix::ParallelMatrix"

private TO_STRING_BUILTIN_NAME: String = "to_string"

private TO_STRING_CORE_SENTINEL: String = "blorp_to_string"


union CoreLowerError:
	CoreLowerUnsupported(String)
	CoreLowerInvalidType(String)
	CoreLowerInvalidParam(String)
	CoreLowerInvalidCall(String)


private union CoreLowerFunctionBody:
	CoreLowerUserFunctionBody(CoreExpr)
	CoreLowerForwardDeclaration
	CoreLowerBuiltinDeclaration


private record CoreLowerParamDestructure {
	param: CoreParam,
	names: List[ParsedIdentifier]
}


private record CoreLowerParamResult {
	param: CoreParam,
	destructure: Option[CoreLowerParamDestructure]
}


private record CoreLowerParams {
	params: List[CoreParam],
	destructures: List[CoreLowerParamDestructure]
}


private pure func lowered_function_kind(body: CoreLowerFunctionBody) -> CoreFunctionKind:
	match body:
		CoreLowerBuiltinDeclaration:
			UnresolvedBuiltinFunction
		CoreLowerForwardDeclaration:
			UserFunction
		CoreLowerUserFunctionBody(_):
			UserFunction


enum CoreLowerCarrierKind:
	CoreLowerOptionCarrier
	CoreLowerResultCarrier


record CoreLowerContext {
	next_def_id: Int,
	source_module: Option[String],
	callable_names: CoreLowerCallableNameRegistry
}


-- The graph preparation boundary owns these names because it is the first
-- phase that has both a resolved target module and its stable callable id.
union CoreLowerCallableNameRegistry:
	CoreLowerDefaultCallableNames
	CoreLowerPreparedCallableNames(Dict[String, Dict[Int, CoreLowerCallableName]])


record CoreLowerCallableName {
	source_name: String,
	ufcs_name: String
}


record CoreLowerDeclResult {
	context: CoreLowerContext,
	decl: CoreDecl
}


record CoreLowerFunctionResult {
	context: CoreLowerContext,
	function_info: CoreFunction
}


record CoreLowerProgramResult {
	context: CoreLowerContext,
	program: CoreProgram
}


record CoreLowerForParts {
	binder: CoreLoopBinder,
	iterable: CoreExpr,
	iterable_release_policy: CoreReleasePolicy,
	body: CoreExpr
}


private record CoreLowerLoopBinding {
	binder: CoreLoopBinder,
	body: CoreExpr
}


private record CoreLowerConcurrentForItem {
	item_type: CoreType,
	item_mode: CoreConcurrentlyLoopItemMode
}


record CoreLowerConcurrentParams {
	timeout: Option[CoreExpr],
	max_threads: Option[Int]
}


record CoreLowerConcurrentForParams {
	timeout: Option[CoreExpr],
	limit: CoreExpr
}


pure func core_lower_error_to_string(error: CoreLowerError) -> String:
	match error:
		CoreLowerUnsupported(message):
			"unsupported Core lowering shape: " + message
		CoreLowerInvalidType(message):
			"invalid Core lowering type: " + message
		CoreLowerInvalidParam(message):
			"invalid Core lowering parameter: " + message
		CoreLowerInvalidCall(message):
			"invalid Core lowering call: " + message


pure func core_lower_context(next_def_id: Int, source_module: Option[String]) -> CoreLowerContext:
	{
		next_def_id = next_def_id,
		source_module = source_module,
		callable_names = CoreLowerDefaultCallableNames
	}


pure func core_lower_context_with_callable_names(
	next_def_id: Int,
	source_module: Option[String],
	callable_names: CoreLowerCallableNameRegistry,
) -> CoreLowerContext:
	{
		next_def_id = next_def_id,
		source_module = source_module,
		callable_names = callable_names
	}


private pure func mint_def_id(context: CoreLowerContext) -> (CoreLowerContext, Int):
	({ context | next_def_id = context.next_def_id + 1 }, context.next_def_id)


private pure func lowered_declared_abi_type(
	context: CoreLowerContext,
	type_name: String,
) -> Option[DeclaredAbiType]:
	match context.source_module:
		Some(module_path):
			declared_abi_type(module_path, type_name)
		None:
			None


pure func core_source_loc(span: SourceSpan) -> CoreSourceLoc:
	KnownSourceLoc(span.path, span.start_line, span.start_column, span.end_line, span.end_column)


private pure func core_var(name: String, def_id: Option[Int]) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = def_id
	}


private pure func split_var_callable_id(name: String) -> (String, Option[Int]):
	if is_core_ufcs_function_name(name):
		hash_index: Int = name.raw_index_of(CALLABLE_ID_SEPARATOR)

		if hash_index < 0:
			(name, None)
		else:
			clean: String = name.substring(0, hash_index)
			suffix: String = name.substring(hash_index + 1, name.length() - hash_index - 1)

			match suffix.parse_int():
				Some(def_id):
					(clean, Some(def_id))
				None:
					(name, None)
	else:
		(name, None)


private pure func resolved_call_target_identity(
	resolved: ResolvedCallInfo,
) -> Option[(String, Int)]:
	match resolved.target:
		ResolvedTraitMethodCall(_, Some(target)):
			Some((target.module_path, target.callable_id))
		ResolvedDirectCall(callable_id, CallableImported(module_path)):
			Some((module_path, callable_id))
		_:
			None


private pure func resolved_call_explicit_name(
	context: CoreLowerContext,
	resolved: ResolvedCallInfo,
) -> Result[Option[String], CoreLowerError]:
	match resolved_call_target_identity(resolved):
		Some((module_path, callable_id)):
			match context.callable_names:
				CoreLowerPreparedCallableNames(by_module):
					match by_module.get(module_path):
						Some(by_callable):
							match by_callable.get(callable_id):
								Some(entry):
									if entry.source_name == resolved.source_name:
										Ok(Some(entry.ufcs_name))
									else:
										Err(
											CoreLowerInvalidCall(
												"callable ${callable_id} in ${module_path} changed source name during graph preparation",
											),
										)
								None:
									Err(
										CoreLowerInvalidCall(
											"prepared graph is missing callable ${callable_id} in ${module_path}",
										),
									)
						None:
							Err(
								CoreLowerInvalidCall(
									"prepared graph is missing module ${module_path} for callable ${callable_id}",
								),
							)
				CoreLowerDefaultCallableNames:
					Ok(Some(core_ufcs_function_name(module_path, resolved.source_name)))
		None:
			Ok(None)


private pure func lowered_name_expr_name(
	context: CoreLowerContext,
	name: ParsedIdentifier,
	info: TypedExprInfo,
) -> Result[String, CoreLowerError]:
	match info.resolved_call:
		Some(resolved):
			explicit_name ?= resolved_call_explicit_name(context, resolved)
			Ok(explicit_name.get_or(name.text))
		None:
			Ok(name.text)


private pure func resolved_core_decl_callable_id(resolved: ResolvedCallInfo) -> Option[Int]:
	match resolved.target:
		ResolvedDirectCall(callable_id, origin):
			match origin:
				CallableLocal:
					Some(callable_id)
				CallableImported(_):
					Some(callable_id)
				CallableConstructor(_):
					Some(callable_id)
				CallableImplMethod:
					Some(callable_id)
				_:
					None
		ResolvedTraitMethodCall(_, impl_target):
			match impl_target:
				Some(target):
					Some(target.callable_id)
				None:
					None
		_:
			None


private pure func lower_name_expr_identity(
	context: CoreLowerContext,
	name: ParsedIdentifier,
	info: TypedExprInfo,
) -> Result[(String, Option[Int]), CoreLowerError]:
	lowered_name ?= lowered_name_expr_name(context, name, info)
	(clean_name, encoded_id) = split_var_callable_id(lowered_name)

	resolved_id: Option[Int] = match info.resolved_call:
		Some(resolved):
			resolved_core_decl_callable_id(resolved)
		None:
			None

	match (encoded_id, resolved_id):
		(Some(encoded), Some(resolved)):
			if encoded == resolved:
				Ok((clean_name, encoded_id))
			else:
				Err(
					CoreLowerInvalidCall(
						"conflicting callable ids for ${name.text}: name carried ${encoded} but resolved_call carried ${resolved}",
					),
				)
		(Some(_), None):
			Ok((clean_name, encoded_id))
		(None, _):
			Ok((clean_name, resolved_id))


private pure func apply_resolved_callee_identity(
	context: CoreLowerContext,
	resolved: Option[ResolvedCallInfo],
	callee: CoreExpr,
) -> Result[CoreExpr, CoreLowerError]:
	match resolved:
		Some(info):
			explicit_name ?= resolved_call_explicit_name(context, info)

			match explicit_name:
				Some(name):
					match callee:
						VarExpr(variable, typ, loc):
							Ok(VarExpr({ variable | name = name }, typ, loc))
						FieldExpr(_, _, typ, loc):
							Ok(VarExpr(core_var(name, None), typ, loc))
						_:
							Ok(callee)
				None:
					Ok(callee)
		None:
			Ok(callee)


private pure func core_dim_op(op: SemanticDimOp) -> CoreDimOp:
	match op:
		SemanticDimAdd:
			DimAdd
		SemanticDimSubtract:
			DimSubtract
		SemanticDimMultiply:
			DimMultiply
		SemanticDimDivide:
			DimDivide


private pure func core_tensor_dim(dim: SemanticType) -> Result[CoreTensorDim, CoreLowerError]:
	match dim:
		SemanticConstIntType(value):
			Ok(TensorStaticDim(value))
		SemanticTypeVar(name):
			Ok(TensorRuntimeDim(name))
		SemanticVarDimsType(name):
			Ok(TensorVariadicDim(name))
		SemanticDimOpType(op, left, right):
			lowered_left ?= core_tensor_dim(left)
			lowered_right ?= core_tensor_dim(right)
			Ok(TensorDimOperation(core_dim_op(op), lowered_left, lowered_right))
		_:
			Err(
				CoreLowerInvalidType(
					"tensor dimension must be a const int or dimension variable, got " + type_to_string(
						dim,
					),
				),
			)


private pure func core_tensor_dims(
	dims: List[SemanticType],
) -> Result[List[CoreTensorDim], CoreLowerError]:
	var lowered: List[CoreTensorDim] = []
	var failure: Option[CoreLowerError] = None

	for dim in dims:
		if failure.is_none():
			match core_tensor_dim(dim):
				Ok(lowered_dim):
					lowered = lowered.append(lowered_dim)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func core_lower_type_list(
	types: List[SemanticType],
) -> Result[List[CoreType], CoreLowerError]:
	var lowered: List[CoreType] = []
	var failure: Option[CoreLowerError] = None

	for typ in types:
		if failure.is_none():
			match core_lower_type(typ):
				Ok(lowered_type):
					lowered = lowered.append(lowered_type)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func core_lower_tensor_type(
	element: SemanticType,
	dims: List[SemanticType],
) -> Result[CoreType, CoreLowerError]:
	element_type ?= core_lower_value_type(element)
	core_dims ?= core_tensor_dims(dims)

	Ok(TensorType({
		element_type = element_type,
		dims = core_dims,
	}))


private pure func malformed_parallel_tensor_type(
	typ: SemanticType,
	expected: String,
) -> Result[CoreType, CoreLowerError]:
	Err(
		CoreLowerInvalidType(
			"scoped parallel tensor type " + type_to_string(typ) + " must have " + expected,
		),
	)


private pure func core_lower_value_type_list(
	types: List[SemanticType],
) -> Result[List[CoreType], CoreLowerError]:
	var lowered: List[CoreType] = []
	var failure: Option[CoreLowerError] = None

	for typ in types:
		if failure.is_none():
			match core_lower_value_type(typ):
				Ok(lowered_type):
					lowered = lowered.append(lowered_type)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


pure func core_lower_type(typ: SemanticType) -> Result[CoreType, CoreLowerError]:
	match array_type_parts(typ):
		Some((element, dims)):
			core_lower_tensor_type(element, dims)
		None:
			match typ:
				SemanticNamedType(name, args):
					-- This flattening currently discards nominal module identity before
					-- representation-sensitive Core passes. The staged replacement is
					-- documented under "Core loses nominal type identity" in
					-- docs/OWNERSHIP_MODEL.md.
					normalized: String = flatten_canonical_core_type_name(normalize_type_name(name))

					if normalized == TYPE_NAME_VOID and args.length() == 0:
						Ok(VoidType)
					else if (
						name == PARALLEL_VECTOR_TYPE_NAME
						or name == CANONICAL_PARALLEL_VECTOR_TYPE_NAME
					):
						match args:
							[element, dim]:
								core_lower_tensor_type(element, [dim])
							_:
								malformed_parallel_tensor_type(
									typ,
									"an element type and one dimension",
								)
					else if (
						name == PARALLEL_MATRIX_TYPE_NAME
						or name == CANONICAL_PARALLEL_MATRIX_TYPE_NAME
					):
						match args:
							[element, rows, columns]:
								core_lower_tensor_type(
									element,
									[rows, columns],
								)
							_:
								malformed_parallel_tensor_type(
									typ,
									"an element type and two dimensions",
								)
					else if (
						normalized == TYPE_NAME_TENSOR
						or normalized == TYPE_NAME_VECTOR
						or normalized == TYPE_NAME_MATRIX
					):
						Err(
							CoreLowerInvalidType(
								"tensor type " + type_to_string(
									typ,
								) + " is missing element or dimensions",
							),
						)
					else:
						match core_lower_value_type_list(args):
							Ok(lowered_args):
								Ok(NamedType(normalized, lowered_args))
							Err(CoreLowerInvalidType(message)):
								Err(
									CoreLowerInvalidType(
										"type " + type_to_string(
											typ,
										) + " has an invalid argument: " + message,
									),
								)
							Err(error):
								Err(error)
				SemanticTupleType(elements):
					lowered_elements ?= core_lower_value_type_list(elements)
					Ok(TupleType(lowered_elements))
				SemanticRangeType(_):
					Ok(RangeType)
				SemanticTypeVar(name):
					Ok(TypeParameterType(name))
				SemanticSelfType:
					Ok(SelfType)
				SemanticConstIntType(_):
					Err(
						CoreLowerInvalidType(
							"dimension literal cannot be used as a value type: " + type_to_string(
								typ,
							),
						),
					)
				SemanticFunctionType(is_pure, params, return_type):
					lowered_params ?= core_lower_value_type_list(params)
					lowered_return ?= core_lower_value_type(return_type)
					Ok(FunctionType(is_pure, lowered_params, lowered_return))
				SemanticArrayType(_, _):
					Err(
						CoreLowerInvalidType(
							"array type lowering failed unexpectedly: " + type_to_string(typ),
						),
					)
				SemanticVarDimsType(_):
					Err(
						CoreLowerInvalidType(
							"dimension variable cannot be used as a value type: " + type_to_string(
								typ,
							),
						),
					)
				SemanticDimOpType(_, _, _):
					Err(
						CoreLowerInvalidType(
							"dimension expression cannot be used as a value type: " + type_to_string(
								typ,
							),
						),
					)
				SemanticMetaType(_):
					Err(
						CoreLowerInvalidType(
							"unresolved meta type reached Core lowering: " + type_to_string(typ),
						),
					)


private pure func core_lower_value_type(typ: SemanticType) -> Result[CoreType, CoreLowerError]:
	match typ:
		SemanticConstIntType(_):
			Ok(NamedType("Int", []))
		_:
			core_lower_type(typ)


private CORE_INT_TYPE: CoreType = NamedType("Int", [])

private CORE_BOOL_TYPE: CoreType = NamedType("Bool", [])


private pure func core_type_is_void(typ: CoreType) -> Bool:
	match typ:
		VoidType:
			True
		_:
			False


private pure func core_int_literal(value: Int, loc: CoreSourceLoc) -> CoreExpr:
	LiteralExpr(IntLiteral(value), CORE_INT_TYPE, loc)


private pure func question_bind_name(label: String, span: SourceSpan) -> String:
	"__qb_" + label + "_" + span.start_line.to_string() + "_" + span.start_column.to_string()


private pure func tuple_destruct_name(span: SourceSpan) -> String:
	"__td_" + span.start_line.to_string() + "_" + span.start_column.to_string()


private pure func loop_view_internal_name(label: String, span: SourceSpan) -> String:
	"__loop_" + label + "_" + span.start_line.to_string() + "_" + span.start_column.to_string()


private pure func for_binder_span(binder: ParsedForBinder) -> SourceSpan:
	match binder:
		ParsedForNameBinder(name):
			name.span
		ParsedForTupleBinder(_, span):
			span


private pure func loop_view_binder_name(
	binder: ParsedForBinder,
	position: Int,
	label: String,
	span: SourceSpan,
) -> String:
	match binder:
		ParsedForTupleBinder(names, _):
			match names.get(position):
				Some(name):
					if name.text == "_":
						loop_view_internal_name(label, span)
					else:
						name.text
				None:
					loop_view_internal_name(label, span)
		ParsedForNameBinder(_):
			loop_view_internal_name(label, span)


private pure func core_carrier_kind(typ: CoreType) -> Result[CoreLowerCarrierKind, CoreLowerError]:
	match typ:
		NamedType(name, args):
			if name == "Option" and args.length() == 1:
				Ok(CoreLowerOptionCarrier)
			else if name == "Result" and args.length() == 2:
				Ok(CoreLowerResultCarrier)
			else:
				Err(CoreLowerInvalidType("expected Option or Result carrier"))
		StackResultType(_, _):
			Ok(CoreLowerResultCarrier)
		BoxedResultType(_, _):
			Ok(CoreLowerResultCarrier)
		_:
			Err(CoreLowerInvalidType("expected Option or Result carrier"))


private pure func core_carrier_success_type(typ: CoreType) -> Result[CoreType, CoreLowerError]:
	match typ:
		NamedType(name, args):
			if name == "Option":
				match args:
					[payload]:
						Ok(payload)
					_:
						Err(CoreLowerInvalidType("Option carrier expected one payload type"))
			else if name == "Result":
				match args:
					[ok_type, _]:
						Ok(ok_type)
					_:
						Err(CoreLowerInvalidType("Result carrier expected ok and error types"))
			else:
				Err(CoreLowerInvalidType("expected Option or Result carrier"))
		StackResultType(ok_type, _):
			Ok(ok_type)
		BoxedResultType(ok_type, _):
			Ok(ok_type)
		_:
			Err(CoreLowerInvalidType("expected Option or Result carrier"))


private pure func core_carrier_failure_type(typ: CoreType) -> Result[CoreType, CoreLowerError]:
	match typ:
		NamedType(name, args):
			if name == "Result":
				match args:
					[_, err_type]:
						Ok(err_type)
					_:
						Err(CoreLowerInvalidType("Result carrier expected ok and error types"))
			else:
				Err(CoreLowerInvalidType("Option carrier has no failure payload"))
		StackResultType(_, err_type):
			Ok(err_type)
		BoxedResultType(_, err_type):
			Ok(err_type)
		_:
			Err(CoreLowerInvalidType("expected Result carrier"))


private pure func builtin_core_call(
	name: String,
	args: List[CoreExpr],
	return_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		VarExpr(
			core_var(name, None),
			NamedType("Closure", []),
			clone_core_source_loc(loc),
		),
		args,
		return_type,
		clone_core_source_loc(loc),
	)


private pure func core_param_value(param: CoreParam) -> CoreExpr:
	VarExpr(
		clone_core_var(param.name),
		clone_core_type(param.typ),
		clone_core_source_loc(param.loc),
	)


private pure func carrier_failure_expr(
	kind: CoreLowerCarrierKind,
	carrier_type: CoreType,
	failure_var: CoreVar,
	failure_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	match kind:
		CoreLowerOptionCarrier:
			builtin_core_call("blorp_option_none", [], carrier_type, loc)
		CoreLowerResultCarrier:
			builtin_core_call(
				"blorp_result_err",
				[
					VarExpr(
						clone_core_var(failure_var),
						clone_core_type(failure_type),
						clone_core_source_loc(loc),
					),
				],
				carrier_type,
				clone_core_source_loc(loc),
			)


