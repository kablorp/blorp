-- Compact accepted callable metadata with distinct owner-local and canonical
-- signatures. Query misses return None rather than materializing empty lists.
import:
	../stage_04_modules/loaded_module: ModuleIdentity, module_identity_storage_key
	env:
		FuncOrigin,
		FuncSymbol,
		LoopProducer,
		OverloadEntry,
		Purity,
		ResourceArgPolicy,
		func_symbol,
		overload_entry_from_func_symbol,
	generic_params: BoundTypeParam
	semantic_type: SemanticType


private record AcceptedCallableDefinitionIdRep {
	module_identity: ModuleIdentity,
	value: Int
}


opaque type AcceptedCallableDefinitionId = AcceptedCallableDefinitionIdRep


pure func accepted_callable_definition_id(
	module_identity: ModuleIdentity,
	value: Int,
) -> AcceptedCallableDefinitionId:
	into AcceptedCallableDefinitionId({
			module_identity = module_identity,
			value = value
		})


pure func accepted_callable_definition_id_module_identity(
	id: AcceptedCallableDefinitionId,
) -> ModuleIdentity:
	from AcceptedCallableDefinitionId(id).module_identity


pure func accepted_callable_definition_id_value(id: AcceptedCallableDefinitionId) -> Int:
	from AcceptedCallableDefinitionId(id).value


record AcceptedCallableSignature {
	func_type: SemanticType,
	type_params: List[BoundTypeParam],
	dim_constraints: List[(SemanticType, SemanticType)]
}


record AcceptedCallableEntry {
	definition_id: AcceptedCallableDefinitionId,
	source_signature: AcceptedCallableSignature,
	canonical_signature: AcceptedCallableSignature,
	param_names: List[Option[String]],
	purity: Purity,
	origin: FuncOrigin,
	resource_args: ResourceArgPolicy,
	loop_producer: Option[LoopProducer],
	debug_only: Bool,
	ufcs_eligible: Bool
}


record AcceptedCallableBinding {
	entry: AcceptedCallableEntry,
	signature: AcceptedCallableSignature,
	module_path: Option[String]
}


private record AcceptedCallableBindingRef {
	definition_id: AcceptedCallableDefinitionId,
	module_path: Option[String]
}


private record CallableValueIndexRep {
	exact: Dict[String, Dict[Int, AcceptedCallableEntry]],
	unique_by_definition_id: Dict[Int, AcceptedCallableEntry],
	ambiguous_definition_ids: Dict[Int, Bool],
	exact_visibility: Option[Dict[String, Dict[Int, Bool]]],
	definition_visibility: Option[Dict[Int, Bool]],
	visible_binding_by_definition_id: Dict[Int, AcceptedCallableBindingRef],
	ambiguous_binding_definition_ids: Dict[Int, Bool],
	visible: Dict[String, List[AcceptedCallableBindingRef]],
	ufcs: Dict[String, List[AcceptedCallableBindingRef]],
	modules: Dict[String, Dict[String, List[AcceptedCallableBindingRef]]],
	module_ufcs: Dict[String, Dict[String, List[AcceptedCallableBindingRef]]]
}


opaque type CallableValueIndex = CallableValueIndexRep


private pure func rep(index: CallableValueIndex) -> CallableValueIndexRep:
	from CallableValueIndex(index)


CALLABLE_VALUE_INDEX_EMPTY: CallableValueIndex = into CallableValueIndex({
		exact = {},
		unique_by_definition_id = {},
		ambiguous_definition_ids = {},
		exact_visibility = None,
		definition_visibility = None,
		visible_binding_by_definition_id = {},
		ambiguous_binding_definition_ids = {},
		visible = {},
		ufcs = {},
		modules = {},
		module_ufcs = {}
	})


-- Module overlays share the immutable accepted-entry catalog and retain only
-- their own visibility references.
pure func callable_value_index_overlay(catalog: CallableValueIndex) -> CallableValueIndex:
	r = rep(catalog)
	into CallableValueIndex({
			exact = r.exact,
			unique_by_definition_id = r.unique_by_definition_id,
			ambiguous_definition_ids = r.ambiguous_definition_ids,
			exact_visibility = Some({}),
			definition_visibility = Some({}),
			visible_binding_by_definition_id = {},
			ambiguous_binding_definition_ids = {},
			visible = {},
			ufcs = {},
			modules = {},
			module_ufcs = {}
		})


pure func accepted_callable_binding(
	entry: AcceptedCallableEntry,
	signature: AcceptedCallableSignature,
	module_path: Option[String],
) -> AcceptedCallableBinding:
	{
		entry = entry,
		signature = signature,
		module_path = module_path
	}


pure func accepted_callable_binding_func_symbol(binding: AcceptedCallableBinding) -> FuncSymbol:
	func_symbol(
		accepted_callable_definition_id_value(binding.entry.definition_id),
		binding.signature.func_type,
		binding.signature.type_params,
		binding.entry.param_names,
		binding.entry.purity,
		binding.entry.origin,
		binding.entry.resource_args,
		binding.module_path,
		binding.signature.dim_constraints,
		binding.entry.loop_producer,
		binding.entry.debug_only,
	)


pure func accepted_callable_binding_overload(binding: AcceptedCallableBinding) -> OverloadEntry:
	overload_entry_from_func_symbol(accepted_callable_binding_func_symbol(binding))


private pure func accepted_callable_binding_ref(
	binding: AcceptedCallableBinding,
) -> AcceptedCallableBindingRef:
	{
		definition_id = binding.entry.definition_id,
		module_path = binding.module_path
	}


private pure func callable_ids_equal(
	left: AcceptedCallableDefinitionId,
	right: AcceptedCallableDefinitionId,
) -> Bool:
	(
		accepted_callable_definition_id_value(left) == accepted_callable_definition_id_value(right)
		and module_identity_storage_key(
			accepted_callable_definition_id_module_identity(
				left,
			),
		) == module_identity_storage_key(accepted_callable_definition_id_module_identity(right))
	)


private pure func add_visible_binding_definition_id(
	all: Dict[Int, AcceptedCallableBindingRef],
	ambiguous: Dict[Int, Bool],
	binding: AcceptedCallableBindingRef,
) -> (Dict[Int, AcceptedCallableBindingRef], Dict[Int, Bool]):
	definition_id = accepted_callable_definition_id_value(binding.definition_id)

	if ambiguous.contains(definition_id):
		(all, ambiguous)
	else:
		match all.get(definition_id):
			Some(existing):
				if callable_ids_equal(existing.definition_id, binding.definition_id):
					(all.set(definition_id, binding), ambiguous)
				else:
					(all.remove(definition_id), ambiguous.set(definition_id, True))
			None:
				(all.set(definition_id, binding), ambiguous)


private pure func callable_value_index_add_catalog_exact(
	index: CallableValueIndex,
	entry: AcceptedCallableEntry,
) -> Option[CallableValueIndex]:
	r = rep(index)
	key = module_identity_storage_key(
		accepted_callable_definition_id_module_identity(entry.definition_id),
	)
	value = accepted_callable_definition_id_value(entry.definition_id)

	entries: Dict[Int, AcceptedCallableEntry] = match r.exact.get(key):
		Some(found):
			found
		None:
			{}

	if entries.contains(value):
		None
	else:
		(unique_by_definition_id, ambiguous_definition_ids) = if r.ambiguous_definition_ids.contains(
			value,
		):
			(r.unique_by_definition_id, r.ambiguous_definition_ids)
		else:
			match r.unique_by_definition_id.get(value):
				Some(_):
					(
						r.unique_by_definition_id.remove(value),
						r.ambiguous_definition_ids.set(value, True),
					)
				None:
					(r.unique_by_definition_id.set(value, entry), r.ambiguous_definition_ids)

		Some(into CallableValueIndex({ r |
					exact = r.exact.set(
						key,
						entries.set(value, entry),
					),
					unique_by_definition_id = unique_by_definition_id,
					ambiguous_definition_ids = ambiguous_definition_ids
				}))


pure func callable_value_index_add_exact(
	index: CallableValueIndex,
	entry: AcceptedCallableEntry,
) -> Option[CallableValueIndex]:
	r = rep(index)
	key = module_identity_storage_key(
		accepted_callable_definition_id_module_identity(entry.definition_id),
	)
	value = accepted_callable_definition_id_value(entry.definition_id)

	match r.exact_visibility:
		None:
			callable_value_index_add_catalog_exact(index, entry)
		Some(visible):
			visible_entries: Dict[Int, Bool] = match visible.get(key):
				Some(found):
					found
				None:
					{}

			catalog_contains = match r.exact.get(key):
				Some(entries):
					entries.contains(value)
				None:
					False

			if visible_entries.contains(value) or not catalog_contains:
				None
			else:
				definition_visibility = match r.definition_visibility:
					Some(found):
						Some(found.set(value, True))
					None:
						None

				Some(into CallableValueIndex({ r |
							exact_visibility = Some(
								visible.set(
									key,
									visible_entries.set(value, True),
								),
							),
							definition_visibility = definition_visibility
						}))


private pure func callable_value_index_with_exact_binding(
	index: CallableValueIndex,
	binding: AcceptedCallableBinding,
) -> CallableValueIndex:
	match callable_value_index_find_exact(index, binding.entry.definition_id):
		Some(_):
			index
		None:
			match callable_value_index_add_exact(index, binding.entry):
				Some(next):
					next
				None:
					index


pure func callable_value_index_add_visible(
	index: CallableValueIndex,
	name: String,
	binding: AcceptedCallableBinding,
) -> CallableValueIndex:
	with_exact = callable_value_index_with_exact_binding(index, binding)
	r = rep(with_exact)
	binding_ref = accepted_callable_binding_ref(binding)

	visible_candidates: List[AcceptedCallableBindingRef] = match r.visible.get(name):
		Some(found):
			found
		None:
			[]

	visible = r.visible.set(
		name,
		[binding_ref].concat(visible_candidates),
	)

	ufcs = if binding.entry.ufcs_eligible:
		ufcs_candidates: List[AcceptedCallableBindingRef] = match r.ufcs.get(name):
			Some(found):
				found
			None:
				[]

		r.ufcs.set(
			name,
			[binding_ref].concat(ufcs_candidates),
		)
	else:
		r.ufcs

	(visible_binding_by_definition_id, ambiguous_binding_definition_ids) = add_visible_binding_definition_id(
		r.visible_binding_by_definition_id,
		r.ambiguous_binding_definition_ids,
		binding_ref,
	)

	into CallableValueIndex({ r |
			visible = visible,
			ufcs = ufcs,
			visible_binding_by_definition_id = visible_binding_by_definition_id,
			ambiguous_binding_definition_ids = ambiguous_binding_definition_ids
		})


pure func callable_value_index_add_ufcs(
	index: CallableValueIndex,
	name: String,
	binding: AcceptedCallableBinding,
) -> CallableValueIndex:
	if not binding.entry.ufcs_eligible:
		index
	else:
		with_exact = callable_value_index_with_exact_binding(index, binding)
		r = rep(with_exact)
		binding_ref = accepted_callable_binding_ref(binding)

		ufcs_candidates: List[AcceptedCallableBindingRef] = match r.ufcs.get(name):
			Some(found):
				found
			None:
				[]

		(visible_binding_by_definition_id, ambiguous_binding_definition_ids) = add_visible_binding_definition_id(
			r.visible_binding_by_definition_id,
			r.ambiguous_binding_definition_ids,
			binding_ref,
		)

		into CallableValueIndex({ r |
				ufcs = r.ufcs.set(
					name,
					[binding_ref].concat(ufcs_candidates),
				),
				visible_binding_by_definition_id = visible_binding_by_definition_id,
				ambiguous_binding_definition_ids = ambiguous_binding_definition_ids
			})


pure func callable_value_index_add_module(
	index: CallableValueIndex,
	module_path: String,
	name: String,
	binding: AcceptedCallableBinding,
) -> CallableValueIndex:
	with_exact = callable_value_index_with_exact_binding(index, binding)
	r = rep(with_exact)
	binding_ref = accepted_callable_binding_ref(binding)

	entries: Dict[String, List[AcceptedCallableBindingRef]] = match r.modules.get(module_path):
		Some(found):
			found
		None:
			{}

	candidates: List[AcceptedCallableBindingRef] = match entries.get(name):
		Some(found):
			found
		None:
			[]

	modules = r.modules.set(
		module_path,
		entries.set(
			name,
			[binding_ref].concat(candidates),
		),
	)

	var module_ufcs = r.module_ufcs

	if binding.entry.ufcs_eligible:
		ufcs_entries: Dict[String, List[AcceptedCallableBindingRef]] = match module_ufcs.get(
			module_path,
		):
			Some(found):
				found
			None:
				{}

		ufcs_candidates: List[AcceptedCallableBindingRef] = match ufcs_entries.get(name):
			Some(found):
				found
			None:
				[]

		module_ufcs = module_ufcs.set(
			module_path,
			ufcs_entries.set(
				name,
				[binding_ref].concat(ufcs_candidates),
			),
		)

	(visible_binding_by_definition_id, ambiguous_binding_definition_ids) = add_visible_binding_definition_id(
		r.visible_binding_by_definition_id,
		r.ambiguous_binding_definition_ids,
		binding_ref,
	)

	into CallableValueIndex({ r |
			modules = modules,
			module_ufcs = module_ufcs,
			visible_binding_by_definition_id = visible_binding_by_definition_id,
			ambiguous_binding_definition_ids = ambiguous_binding_definition_ids
		})


private pure func find_exact_in(
	all: Dict[String, Dict[Int, AcceptedCallableEntry]],
	key: String,
	value: Int,
) -> Option[AcceptedCallableEntry]:
	match all.get(key):
		Some(entries):
			entries.get(value)
		None:
			None


pure func callable_value_index_find_exact(
	index: CallableValueIndex,
	id: AcceptedCallableDefinitionId,
) -> Option[AcceptedCallableEntry]:
	r = rep(index)
	key = module_identity_storage_key(accepted_callable_definition_id_module_identity(id))
	value = accepted_callable_definition_id_value(id)

	visible = match r.exact_visibility:
		None:
			True
		Some(all):
			match all.get(key):
				Some(entries):
					entries.contains(value)
				None:
					False

	if visible:
		find_exact_in(r.exact, key, value)
	else:
		None


-- Definition IDs are graph-global in production. Synthetic or malformed
-- overlays that contain the same integer for two module identities fail closed.
pure func callable_value_index_find_definition_id(
	index: CallableValueIndex,
	definition_id: Int,
) -> Option[AcceptedCallableEntry]:
	r = rep(index)

	definition_is_hidden = match r.definition_visibility:
		Some(visible):
			not visible.contains(definition_id)
		None:
			False

	if r.ambiguous_definition_ids.contains(definition_id):
		None
	else if definition_is_hidden:
		None
	else:
		r.unique_by_definition_id.get(definition_id)


private pure func binding_from_ref(
	index: CallableValueIndex,
	binding_ref: AcceptedCallableBindingRef,
) -> Option[AcceptedCallableBinding]:
	entry ?= callable_value_index_find_exact(index, binding_ref.definition_id)

	signature = match binding_ref.module_path:
		Some(_):
			entry.canonical_signature
		None:
			entry.source_signature

	Some(accepted_callable_binding(entry, signature, binding_ref.module_path))


private pure func bindings_from_refs(
	index: CallableValueIndex,
	refs: List[AcceptedCallableBindingRef],
) -> Option[List[AcceptedCallableBinding]]:
	var bindings_reversed: List[AcceptedCallableBinding] = []
	var complete: Bool = True

	for binding_ref in refs:
		if complete:
			match binding_from_ref(index, binding_ref):
				Some(binding):
					bindings_reversed = [binding].concat(bindings_reversed)
				None:
					complete = False

	if complete:
		Some(bindings_reversed.reverse())
	else:
		None


pure func callable_value_index_find_binding_definition_id(
	index: CallableValueIndex,
	definition_id: Int,
) -> Option[AcceptedCallableBinding]:
	r = rep(index)

	if r.ambiguous_binding_definition_ids.contains(definition_id):
		None
	else:
		match r.visible_binding_by_definition_id.get(definition_id):
			Some(binding_ref):
				binding_from_ref(index, binding_ref)
			None:
				None


pure func callable_value_index_find_visible(
	index: CallableValueIndex,
	name: String,
) -> Option[List[AcceptedCallableBinding]]:
	match rep(index).visible.get(name):
		Some(refs):
			bindings_from_refs(index, refs)
		None:
			None


pure func callable_value_index_find_visible_overloads(
	index: CallableValueIndex,
	name: String,
) -> Option[List[OverloadEntry]]:
	callable_value_index_find_visible(
		index,
		name,
	).map(
		func(bindings): bindings.map(accepted_callable_binding_overload),
	)


pure func callable_value_index_find_ufcs(
	index: CallableValueIndex,
	name: String,
) -> Option[List[AcceptedCallableBinding]]:
	match rep(index).ufcs.get(name):
		Some(refs):
			bindings_from_refs(index, refs)
		None:
			None


pure func callable_value_index_find_ufcs_overloads(
	index: CallableValueIndex,
	name: String,
) -> Option[List[OverloadEntry]]:
	callable_value_index_find_ufcs(
		index,
		name,
	).map(
		func(bindings): bindings.map(accepted_callable_binding_overload),
	)


private pure func find_module(
	primary: Dict[String, Dict[String, List[AcceptedCallableBindingRef]]],
	module_path: String,
	name: String,
) -> Option[List[AcceptedCallableBindingRef]]:
	match primary.get(module_path):
		Some(entries):
			entries.get(name)
		None:
			None


pure func callable_value_index_find_module(
	index: CallableValueIndex,
	module_path: String,
	name: String,
) -> Option[List[AcceptedCallableBinding]]:
	r = rep(index)

	match find_module(r.modules, module_path, name):
		Some(refs):
			bindings_from_refs(index, refs)
		None:
			None


pure func callable_value_index_find_module_overloads(
	index: CallableValueIndex,
	module_path: String,
	name: String,
) -> Option[List[OverloadEntry]]:
	callable_value_index_find_module(
		index,
		module_path,
		name,
	).map(
		func(bindings): bindings.map(accepted_callable_binding_overload),
	)


pure func callable_value_index_find_module_ufcs(
	index: CallableValueIndex,
	module_path: String,
	name: String,
) -> Option[List[AcceptedCallableBinding]]:
	r = rep(index)

	match find_module(r.module_ufcs, module_path, name):
		Some(refs):
			bindings_from_refs(index, refs)
		None:
			None


pure func callable_value_index_find_module_ufcs_overloads(
	index: CallableValueIndex,
	module_path: String,
	name: String,
) -> Option[List[OverloadEntry]]:
	callable_value_index_find_module_ufcs(
		index,
		module_path,
		name,
	).map(
		func(bindings): bindings.map(accepted_callable_binding_overload),
	)
