-- Immutable accepted trait and implementation facts used after graph-owned
-- declarations leave lexical Env scopes. Construction is owned by stage 06;
-- this module only defines exact, visibility-aware query indexes.
import:
	../stage_04_modules/loaded_module:
		ModuleIdentity,
		module_identities_equal,
		module_identity_storage_key,
	env: ImplInstance, ImplMethodInfo, TraitDef, TraitMethodSig
	semantic_type:
		SemanticType(
			SemanticArrayType,
			SemanticConstIntType,
			SemanticDimOpType,
			SemanticFunctionType,
			SemanticMetaType,
			SemanticNamedType,
			SemanticRangeType,
			SemanticSelfType,
			SemanticTupleType,
			SemanticTypeVar,
			SemanticVarDimsType,
		),


enum AcceptedAuthorityVisibility:
	AcceptedPublicDeclaration
	AcceptedPrivateDeclaration


record AcceptedTraitIdentity {
	module_identity: ModuleIdentity,
	definition_id: Int,
	name: String
}


record AcceptedTraitMethodIdentity {
	owner: AcceptedTraitIdentity,
	slot_index: Int,
	name: String
}


record AcceptedTraitMethodAuthorityEntry {
	identity: AcceptedTraitMethodIdentity,
	signature: TraitMethodSig
}


record AcceptedTraitAuthorityEntry {
	identity: AcceptedTraitIdentity,
	definition: TraitDef,
	canonical_definition: TraitDef,
	visibility: AcceptedAuthorityVisibility,
	supertraits: List[AcceptedTraitIdentity],
	methods: List[AcceptedTraitMethodAuthorityEntry],
	canonical_methods: List[AcceptedTraitMethodAuthorityEntry]
}


union AcceptedTraitLookup:
	AcceptedTraitFound(AcceptedTraitAuthorityEntry)
	AcceptedTraitAmbiguous(List[AcceptedTraitAuthorityEntry])
	AcceptedTraitNotFound


record AcceptedTraitTraversalObservation {
	visited_entries: Int
}


private record TraitAuthorityIndexRep {
	owner: ModuleIdentity,
	traits: List[AcceptedTraitAuthorityEntry],
	trait_indices_by_module_and_definition: Dict[String, Dict[Int, Int]],
	public_trait_indices_by_module_and_name: Dict[String, Dict[String, Int]],
	methods: List[AcceptedTraitMethodAuthorityEntry],
	method_indices_by_module_owner_and_slot: Dict[String, Dict[Int, Dict[Int, Int]]],
	source_trait_indices_by_name: Dict[String, List[Int]],
	canonical_trait_indices_by_name: Dict[String, List[Int]],
	qualified_modules_by_alias: Dict[String, ModuleIdentity],
	method_indices_by_name: Dict[String, List[Int]],
	ufcs_method_indices_by_name: Dict[String, List[Int]]
}


opaque type TraitAuthorityIndex = TraitAuthorityIndexRep


pure func trait_authority_index_empty(owner: ModuleIdentity) -> TraitAuthorityIndex:
	into TraitAuthorityIndex({
			owner = owner,
			traits = [],
			trait_indices_by_module_and_definition = {},
			public_trait_indices_by_module_and_name = {},
			methods = [],
			method_indices_by_module_owner_and_slot = {},
			source_trait_indices_by_name = {},
			canonical_trait_indices_by_name = {},
			qualified_modules_by_alias = {},
			method_indices_by_name = {},
			ufcs_method_indices_by_name = {}
		})


record AcceptedImplementationIdentity {
	module_identity: ModuleIdentity,
	definition_id: Int,
	trait_name: String
}


record AcceptedImplementationMethodIdentity {
	owner: AcceptedImplementationIdentity,
	callable_module_identity: ModuleIdentity,
	callable_definition_id: Int,
	name: String
}


record AcceptedImplementationMethodAuthorityEntry {
	identity: AcceptedImplementationMethodIdentity,
	info: ImplMethodInfo
}


union AcceptedImplementationMethodLookup:
	AcceptedImplementationMethodFound(AcceptedImplementationMethodAuthorityEntry)
	AcceptedImplementationMethodAmbiguous
	AcceptedImplementationMethodNotFound


enum AcceptedImplementationReceiverHead:
	AcceptedDeclaredReceiverHead
	AcceptedIntrinsicReceiverHead
	AcceptedPreludeReceiverHead
	AcceptedArrayReceiverHead
	AcceptedTupleReceiverHead
	AcceptedFunctionReceiverHead
	AcceptedRangeReceiverHead
	AcceptedParameterReceiverHead
	AcceptedDimensionReceiverHead


record AcceptedImplementationAuthorityEntry {
	identity: AcceptedImplementationIdentity,
	trait_identity: AcceptedTraitIdentity,
	definition: ImplInstance,
	canonical_definition: ImplInstance,
	receiver_head: AcceptedImplementationReceiverHead,
	visibility: AcceptedAuthorityVisibility,
	methods: List[AcceptedImplementationMethodAuthorityEntry],
	canonical_methods: List[AcceptedImplementationMethodAuthorityEntry]
}


private record ImplementationAuthorityIndexRep {
	owner: ModuleIdentity,
	implementations: List[AcceptedImplementationAuthorityEntry],
	implementation_indices_by_module_and_definition: Dict[String, Dict[Int, Int]],
	methods: List[AcceptedImplementationMethodAuthorityEntry],
	method_indices_by_module_owner_and_callable: Dict[String, Dict[Int, Dict[Int, Int]]],
	method_indices_by_callable_definition: Dict[Int, List[Int]],
	candidate_indices_by_trait_and_receiver: Dict[String, Dict[Int, List[Int]]]
}


opaque type ImplementationAuthorityIndex = ImplementationAuthorityIndexRep


pure func implementation_authority_index_empty(
	owner: ModuleIdentity,
) -> ImplementationAuthorityIndex:
	into ImplementationAuthorityIndex({
			owner = owner,
			implementations = [],
			implementation_indices_by_module_and_definition = {},
			methods = [],
			method_indices_by_module_owner_and_callable = {},
			method_indices_by_callable_definition = {},
			candidate_indices_by_trait_and_receiver = {}
		})


pure func accepted_trait_identity(
	module_identity: ModuleIdentity,
	definition_id: Int,
	name: String,
) -> AcceptedTraitIdentity:
	{
		module_identity = module_identity,
		definition_id = definition_id,
		name = name
	}


pure func accepted_trait_method_identity(
	owner: AcceptedTraitIdentity,
	slot_index: Int,
	name: String,
) -> AcceptedTraitMethodIdentity:
	{
		owner = owner,
		slot_index = slot_index,
		name = name
	}


pure func accepted_implementation_identity(
	module_identity: ModuleIdentity,
	definition_id: Int,
	trait_name: String,
) -> AcceptedImplementationIdentity:
	{
		module_identity = module_identity,
		definition_id = definition_id,
		trait_name = trait_name
	}


pure func accepted_implementation_method_identity(
	owner: AcceptedImplementationIdentity,
	callable_module_identity: ModuleIdentity,
	callable_definition_id: Int,
	name: String,
) -> AcceptedImplementationMethodIdentity:
	{
		owner = owner,
		callable_module_identity = callable_module_identity,
		callable_definition_id = callable_definition_id,
		name = name
	}


pure func accepted_trait_identities_equal(
	left: AcceptedTraitIdentity,
	right: AcceptedTraitIdentity,
) -> Bool:
	(
		left.definition_id == right.definition_id
		and left.name == right.name
		and module_identities_equal(left.module_identity, right.module_identity)
	)


pure func accepted_trait_method_identities_equal(
	left: AcceptedTraitMethodIdentity,
	right: AcceptedTraitMethodIdentity,
) -> Bool:
	(
		left.slot_index == right.slot_index
		and left.name == right.name
		and accepted_trait_identities_equal(left.owner, right.owner)
	)


pure func accepted_implementation_identities_equal(
	left: AcceptedImplementationIdentity,
	right: AcceptedImplementationIdentity,
) -> Bool:
	(
		left.definition_id == right.definition_id
		and left.trait_name == right.trait_name
		and module_identities_equal(left.module_identity, right.module_identity)
	)


pure func accepted_implementation_method_identities_equal(
	left: AcceptedImplementationMethodIdentity,
	right: AcceptedImplementationMethodIdentity,
) -> Bool:
	(
		left.callable_definition_id == right.callable_definition_id
		and left.name == right.name
		and module_identities_equal(left.callable_module_identity, right.callable_module_identity)
		and accepted_implementation_identities_equal(left.owner, right.owner)
	)


private pure func trait_authority_index_rep(index: TraitAuthorityIndex) -> TraitAuthorityIndexRep:
	from TraitAuthorityIndex(index)


private pure func implementation_authority_index_rep(
	index: ImplementationAuthorityIndex,
) -> ImplementationAuthorityIndexRep:
	from ImplementationAuthorityIndex(index)


private pure func authority_entry_is_visible(
	owner: ModuleIdentity,
	entry_owner: ModuleIdentity,
	visibility: AcceptedAuthorityVisibility,
) -> Bool:
	match visibility:
		AcceptedPublicDeclaration:
			True
		AcceptedPrivateDeclaration:
			module_identities_equal(owner, entry_owner)


private pure func trait_entry_for_owner(
	owner: ModuleIdentity,
	entry: AcceptedTraitAuthorityEntry,
) -> AcceptedTraitAuthorityEntry:
	if module_identities_equal(owner, entry.identity.module_identity):
		entry
	else:
		{ entry |
			definition = entry.canonical_definition,
			methods = entry.canonical_methods
		}


private pure func implementation_entry_for_owner(
	owner: ModuleIdentity,
	entry: AcceptedImplementationAuthorityEntry,
) -> AcceptedImplementationAuthorityEntry:
	if module_identities_equal(owner, entry.identity.module_identity):
		entry
	else:
		{ entry |
			definition = entry.canonical_definition,
			methods = entry.canonical_methods
		}


private pure func trait_index_for_identity(
	indices: Dict[String, Dict[Int, Int]],
	id: AcceptedTraitIdentity,
) -> Option[Int]:
	module_indices ?= indices.get(module_identity_storage_key(id.module_identity))
	module_indices.get(id.definition_id)


private pure func trait_entry_for_identity(
	traits: List[AcceptedTraitAuthorityEntry],
	indices: Dict[String, Dict[Int, Int]],
	id: AcceptedTraitIdentity,
) -> Option[AcceptedTraitAuthorityEntry]:
	index ?= trait_index_for_identity(indices, id)
	entry ?= traits.get(index)

	if accepted_trait_identities_equal(entry.identity, id):
		Some(entry)
	else:
		None


private pure func trait_entries_for_indices(
	traits: List[AcceptedTraitAuthorityEntry],
	indices: List[Int],
) -> List[AcceptedTraitAuthorityEntry]:
	var result: List[AcceptedTraitAuthorityEntry] = []

	for index in indices:
		match traits.get(index):
			Some(entry):
				result = [entry].concat(result)
			None:
				void

	result.reverse()


private pure func trait_lookup_from_indices(
	traits: List[AcceptedTraitAuthorityEntry],
	indices: List[Int],
) -> AcceptedTraitLookup:
	match indices:
		[]:
			AcceptedTraitNotFound
		[index]:
			match traits.get(index):
				Some(entry):
					AcceptedTraitFound(entry)
				None:
					AcceptedTraitNotFound
		_:
			AcceptedTraitAmbiguous(trait_entries_for_indices(traits, indices))


private pure func append_trait_source_binding(
	bindings: Dict[String, List[Int]],
	name: String,
	index: Int,
) -> Dict[String, List[Int]]:
	prior: List[Int] = match bindings.get(name):
		Some(indices):
			indices
		None:
			[]

	if prior.contains(index):
		bindings
	else:
		bindings.set(
			name,
			[index].concat(prior),
		)


private pure func append_method_binding(
	bindings: Dict[String, List[Int]],
	name: String,
	index: Int,
) -> Dict[String, List[Int]]:
	prior: List[Int] = match bindings.get(name):
		Some(indices):
			indices
		None:
			[]

	if prior.contains(index):
		bindings
	else:
		bindings.set(
			name,
			[index].concat(prior),
		)


private pure func reverse_index_lists(bindings: Dict[String, List[Int]]) -> Dict[String, List[Int]]:
	var result: Dict[String, List[Int]] = {}

	for binding in bindings.entries():
		result = result.set(binding[0], binding[1].reverse())

	result


private pure func reverse_int_index_lists(bindings: Dict[Int, List[Int]]) -> Dict[Int, List[Int]]:
	var result: Dict[Int, List[Int]] = {}

	for binding in bindings.entries():
		result = result.set(binding[0], binding[1].reverse())

	result


private pure func reverse_nested_index_lists(
	bindings: Dict[String, Dict[Int, List[Int]]],
) -> Dict[String, Dict[Int, List[Int]]]:
	var result: Dict[String, Dict[Int, List[Int]]] = {}

	for outer_binding in bindings.entries():
		var inner_result: Dict[Int, List[Int]] = {}

		for inner_binding in outer_binding[1].entries():
			inner_result = inner_result.set(inner_binding[0], inner_binding[1].reverse())

		result = result.set(outer_binding[0], inner_result)

	result


pure func trait_authority_index_build(
	owner: ModuleIdentity,
	entries: List[AcceptedTraitAuthorityEntry],
	source_bindings: List[(String, AcceptedTraitIdentity)],
	qualified_bindings: List[(String, ModuleIdentity)],
	method_bindings: List[(String, AcceptedTraitMethodIdentity)],
	ufcs_bindings: List[(String, AcceptedTraitMethodIdentity)],
) -> Result[TraitAuthorityIndex, String]:
	var visible_traits: List[AcceptedTraitAuthorityEntry] = []
	var trait_indices: Dict[String, Dict[Int, Int]] = {}
	var public_traits_by_module_and_name: Dict[String, Dict[String, Int]] = {}
	var canonical_trait_indices_by_name: Dict[String, List[Int]] = {}
	var methods: List[AcceptedTraitMethodAuthorityEntry] = []
	var method_indices: Dict[String, Dict[Int, Dict[Int, Int]]] = {}
	var issue: Option[String] = None

	for prepared_entry in entries:
		if (
			issue.is_none()
			and authority_entry_is_visible(
				owner,
				prepared_entry.identity.module_identity,
				prepared_entry.visibility,
			)
		):
			entry = trait_entry_for_owner(owner, prepared_entry)
			module_key = module_identity_storage_key(entry.identity.module_identity)

			module_indices: Dict[Int, Int] = match trait_indices.get(module_key):
				Some(indices):
					indices
				None:
					{}

			if module_indices.contains(entry.identity.definition_id):
				issue = Some("duplicate accepted trait identity")
			else:
				entry_index = visible_traits.length()
				visible_traits = [entry].concat(visible_traits)
				trait_indices = trait_indices.set(
					module_key,
					module_indices.set(entry.identity.definition_id, entry_index),
				)
				canonical_trait_indices_by_name = append_trait_source_binding(
					canonical_trait_indices_by_name,
					entry.identity.name,
					entry_index,
				)

				match entry.visibility:
					AcceptedPublicDeclaration:
						module_names: Dict[String, Int] = match public_traits_by_module_and_name.get(
							module_key,
						):
							Some(names):
								names
							None:
								{}

						if module_names.contains(entry.identity.name):
							issue = Some("duplicate public accepted trait name")
						else:
							public_traits_by_module_and_name = public_traits_by_module_and_name.set(
								module_key,
								module_names.set(entry.identity.name, entry_index),
							)
					AcceptedPrivateDeclaration:
						void

				for method in entry.methods:
					if issue.is_none():
						owner_indices: Dict[Int, Dict[Int, Int]] = match method_indices.get(
							module_key,
						):
							Some(indices):
								indices
							None:
								{}

						slot_indices: Dict[Int, Int] = match owner_indices.get(
							entry.identity.definition_id,
						):
							Some(indices):
								indices
							None:
								{}

						if (
							slot_indices.contains(method.identity.slot_index)
							or not accepted_trait_identities_equal(
								method.identity.owner,
								entry.identity,
							)
						):
							issue = Some("duplicate or mismatched accepted trait method identity")
						else:
							method_index = methods.length()
							methods = [method].concat(methods)
							method_indices = method_indices.set(
								module_key,
								owner_indices.set(
									entry.identity.definition_id,
									slot_indices.set(method.identity.slot_index, method_index),
								),
							)

	match issue:
		Some(message):
			Err(message)
		None:
			var source_indices: Dict[String, List[Int]] = {}

			for binding in source_bindings:
				(local_name, id) = binding

				match trait_index_for_identity(trait_indices, id):
					Some(index):
						source_indices = append_trait_source_binding(
							source_indices,
							local_name,
							index,
						)
					None:
						issue = Some(
							"accepted trait source binding references an invisible identity",
						)

			var qualified_modules: Dict[String, ModuleIdentity] = {}

			for binding in qualified_bindings:
				(local_alias, module_identity) = binding

				if qualified_modules.contains(local_alias):
					issue = Some("duplicate accepted trait qualified alias")
				else:
					qualified_modules = qualified_modules.set(local_alias, module_identity)

			var method_indices_by_name: Dict[String, List[Int]] = {}

			for binding in method_bindings:
				(local_name, id) = binding

				match trait_method_index(method_indices, id):
					Some(index):
						method_indices_by_name = append_method_binding(
							method_indices_by_name,
							local_name,
							index,
						)
					None:
						issue = Some(
							"accepted trait method binding references an invisible identity",
						)

			var ufcs_indices_by_name: Dict[String, List[Int]] = {}

			for binding in ufcs_bindings:
				(local_name, id) = binding

				match trait_method_index(method_indices, id):
					Some(index):
						ufcs_indices_by_name = append_method_binding(
							ufcs_indices_by_name,
							local_name,
							index,
						)
					None:
						issue = Some("accepted trait UFCS binding references an invisible identity")

			match issue:
				Some(message):
					Err(message)
				None:
					Ok(into TraitAuthorityIndex({
								owner = owner,
								traits = visible_traits.reverse(),
								trait_indices_by_module_and_definition = trait_indices,
								public_trait_indices_by_module_and_name = public_traits_by_module_and_name,
								methods = methods.reverse(),
								method_indices_by_module_owner_and_slot = method_indices,
								source_trait_indices_by_name = reverse_index_lists(source_indices),
								canonical_trait_indices_by_name = reverse_index_lists(
									canonical_trait_indices_by_name,
								),
								qualified_modules_by_alias = qualified_modules,
								method_indices_by_name = reverse_index_lists(
									method_indices_by_name,
								),
								ufcs_method_indices_by_name = reverse_index_lists(
									ufcs_indices_by_name,
								)
							}))


pure func trait_authority_index_find_exact(
	index: TraitAuthorityIndex,
	id: AcceptedTraitIdentity,
) -> Option[AcceptedTraitAuthorityEntry]:
	representation = trait_authority_index_rep(index)
	trait_entry_for_identity(
		representation.traits,
		representation.trait_indices_by_module_and_definition,
		id,
	)


pure func trait_authority_index_find_source(
	index: TraitAuthorityIndex,
	name: String,
) -> AcceptedTraitLookup:
	representation = trait_authority_index_rep(index)

	match representation.source_trait_indices_by_name.get(name):
		Some(indices):
			trait_lookup_from_indices(representation.traits, indices)
		None:
			AcceptedTraitNotFound


-- Accepted semantic payloads currently retain resolved declaration names for
-- trait bounds, not their source import aliases. This preindexed fallback is
-- only for already-resolved obligations; source expression lookup must keep
-- using the visibility-sensitive source/qualified APIs above.
pure func trait_authority_index_find_canonical_name(
	index: TraitAuthorityIndex,
	name: String,
) -> AcceptedTraitLookup:
	representation = trait_authority_index_rep(index)

	match representation.canonical_trait_indices_by_name.get(name):
		Some(indices):
			trait_lookup_from_indices(representation.traits, indices)
		None:
			AcceptedTraitNotFound


pure func trait_authority_index_find_qualified(
	index: TraitAuthorityIndex,
	local_alias: String,
	name: String,
) -> AcceptedTraitLookup:
	representation = trait_authority_index_rep(index)

	match representation.qualified_modules_by_alias.get(local_alias):
		Some(identity):
			match representation.public_trait_indices_by_module_and_name.get(
				module_identity_storage_key(identity),
			):
				Some(module_indices):
					match module_indices.get(name):
						Some(entry_index):
							match representation.traits.get(entry_index):
								Some(entry):
									if (
										entry.identity.name == name
										and module_identities_equal(
											entry.identity.module_identity,
											identity,
										)
									):
										AcceptedTraitFound(entry)
									else:
										AcceptedTraitNotFound
								None:
									AcceptedTraitNotFound
						None:
							AcceptedTraitNotFound
				None:
					AcceptedTraitNotFound
		None:
			AcceptedTraitNotFound


private pure func trait_method_index(
	indices: Dict[String, Dict[Int, Dict[Int, Int]]],
	id: AcceptedTraitMethodIdentity,
) -> Option[Int]:
	owner_indices ?= indices.get(module_identity_storage_key(id.owner.module_identity))
	slot_indices ?= owner_indices.get(id.owner.definition_id)
	slot_indices.get(id.slot_index)


pure func trait_authority_index_find_method_exact(
	index: TraitAuthorityIndex,
	id: AcceptedTraitMethodIdentity,
) -> Option[AcceptedTraitMethodAuthorityEntry]:
	representation = trait_authority_index_rep(index)
	method_index ?= trait_method_index(representation.method_indices_by_module_owner_and_slot, id)
	entry ?= representation.methods.get(method_index)

	if accepted_trait_method_identities_equal(entry.identity, id):
		Some(entry)
	else:
		None


pure func trait_authority_index_find_method(
	index: TraitAuthorityIndex,
	trait_identity: AcceptedTraitIdentity,
	method_name: String,
) -> Option[AcceptedTraitMethodAuthorityEntry]:
	var pending: List[AcceptedTraitIdentity] = [trait_identity]
	var seen: Dict[String, Bool] = {}
	var result: Option[AcceptedTraitMethodAuthorityEntry] = None

	while result.is_none() and not pending.is_empty():
		match pending.get(0):
			Some(current):
				pending = pending.drop(1)
				key = implementation_candidate_key(current)

				if not seen.contains(key):
					seen = seen.set(key, True)

					match trait_authority_index_find_exact(index, current):
						Some(entry):
							for method in entry.methods:
								if method.identity.name == method_name:
									result = Some(method)
									break

							if result.is_none():
								pending = entry.supertraits.concat(pending)
						None:
							void
			None:
				void

	result


-- Implementation body setup needs the complete declared method surface once.
-- This cold projection preserves trait-first, declared-supertrait DFS order
-- with one shared seen set; hot method queries use find_method directly.
pure func trait_authority_index_methods_for_trait(
	index: TraitAuthorityIndex,
	trait_identity: AcceptedTraitIdentity,
) -> List[AcceptedTraitMethodAuthorityEntry]:
	var pending: List[AcceptedTraitIdentity] = [trait_identity]
	var seen: Dict[String, Bool] = {}
	var methods_reversed: List[AcceptedTraitMethodAuthorityEntry] = []

	while not pending.is_empty():
		match pending.get(0):
			Some(current):
				pending = pending.drop(1)
				key = implementation_candidate_key(current)

				if not seen.contains(key):
					seen = seen.set(key, True)

					match trait_authority_index_find_exact(index, current):
						Some(entry):
							for method in entry.methods:
								methods_reversed = [method].concat(methods_reversed)

							pending = entry.supertraits.concat(pending)
						None:
							void
			None:
				void

	methods_reversed.reverse()


pure func trait_authority_index_trait_satisfies_trait(
	index: TraitAuthorityIndex,
	candidate: AcceptedTraitIdentity,
	target: AcceptedTraitIdentity,
) -> Bool:
	var pending: List[AcceptedTraitIdentity] = [candidate]
	var seen: Dict[String, Bool] = {}
	var found: Bool = False

	while not found and not pending.is_empty():
		match pending.get(0):
			Some(current):
				pending = pending.drop(1)
				key = implementation_candidate_key(current)

				if not seen.contains(key):
					seen = seen.set(key, True)
					found = accepted_trait_identities_equal(current, target)

					if not found:
						match trait_authority_index_find_exact(index, current):
							Some(entry):
								pending = entry.supertraits.concat(pending)
							None:
								void
			None:
				void

	found


pure func trait_authority_index_traversal_observation(
	index: TraitAuthorityIndex,
	trait_identity: AcceptedTraitIdentity,
) -> AcceptedTraitTraversalObservation:
	var pending: List[AcceptedTraitIdentity] = [trait_identity]
	var seen: Dict[String, Bool] = {}
	var visited_entries: Int = 0

	while not pending.is_empty():
		match pending.get(0):
			Some(current):
				pending = pending.drop(1)
				key = implementation_candidate_key(current)

				if not seen.contains(key):
					seen = seen.set(key, True)

					match trait_authority_index_find_exact(index, current):
						Some(entry):
							visited_entries += 1
							pending = entry.supertraits.concat(pending)
						None:
							void
			None:
				void

	{visited_entries = visited_entries}


-- Construction-only closure used to index implementation candidates under
-- both their declared trait and every exact supertrait. Hot queries read the
-- resulting bucket directly and never rescan visible implementations.
private pure func trait_authority_index_satisfied_traits_for_build(
	index: TraitAuthorityIndex,
	trait_identity: AcceptedTraitIdentity,
) -> List[AcceptedTraitIdentity]:
	var pending: List[AcceptedTraitIdentity] = [trait_identity]
	var seen: Dict[String, Bool] = {}
	var result_reversed: List[AcceptedTraitIdentity] = []

	while not pending.is_empty():
		match pending.get(0):
			Some(current):
				pending = pending.drop(1)
				key = implementation_candidate_key(current)

				if not seen.contains(key):
					seen = seen.set(key, True)
					result_reversed = [current].concat(result_reversed)

					match trait_authority_index_find_exact(index, current):
						Some(entry):
							pending = entry.supertraits.concat(pending)
						None:
							void
			None:
				void

	result_reversed.reverse()


private pure func method_entries_for_indices(
	methods: List[AcceptedTraitMethodAuthorityEntry],
	indices: List[Int],
) -> List[AcceptedTraitMethodAuthorityEntry]:
	var result: List[AcceptedTraitMethodAuthorityEntry] = []

	for index in indices:
		match methods.get(index):
			Some(method):
				result = [method].concat(result)
			None:
				void

	result.reverse()


pure func trait_authority_index_method_candidates(
	index: TraitAuthorityIndex,
	name: String,
) -> List[AcceptedTraitMethodAuthorityEntry]:
	representation = trait_authority_index_rep(index)

	match representation.method_indices_by_name.get(name):
		Some(indices):
			method_entries_for_indices(representation.methods, indices)
		None:
			[]


pure func trait_authority_index_ufcs_candidates(
	index: TraitAuthorityIndex,
	name: String,
) -> List[AcceptedTraitMethodAuthorityEntry]:
	representation = trait_authority_index_rep(index)

	match representation.ufcs_method_indices_by_name.get(name):
		Some(indices):
			method_entries_for_indices(representation.methods, indices)
		None:
			[]


private pure func receiver_head_key(head: AcceptedImplementationReceiverHead) -> Int:
	match head:
		AcceptedDeclaredReceiverHead | AcceptedIntrinsicReceiverHead | AcceptedPreludeReceiverHead:
			-- Semantic named types do not retain the source header category. Keep
			-- all named receivers in one coarse bucket and let semantic matching
			-- distinguish the exact receiver and bounds.
			0
		AcceptedArrayReceiverHead:
			1
		AcceptedTupleReceiverHead:
			2
		AcceptedFunctionReceiverHead:
			3
		AcceptedRangeReceiverHead:
			4
		AcceptedParameterReceiverHead:
			5
		AcceptedDimensionReceiverHead:
			6


pure func accepted_implementation_receiver_head_from_semantic_type(
	typ: SemanticType,
) -> AcceptedImplementationReceiverHead:
	match typ:
		SemanticNamedType(_, _):
			AcceptedDeclaredReceiverHead
		SemanticArrayType(_, _):
			AcceptedArrayReceiverHead
		SemanticTupleType(_):
			AcceptedTupleReceiverHead
		SemanticFunctionType(_, _, _):
			AcceptedFunctionReceiverHead
		SemanticRangeType(_):
			AcceptedRangeReceiverHead
		SemanticTypeVar(_) | SemanticSelfType | SemanticMetaType(_):
			AcceptedParameterReceiverHead
		SemanticConstIntType(_) | SemanticDimOpType(_, _, _) | SemanticVarDimsType(_):
			AcceptedDimensionReceiverHead


private pure func implementation_candidate_key(id: AcceptedTraitIdentity) -> String:
	module_identity_storage_key(id.module_identity) + "\n" + id.definition_id.to_string()


private pure func implementation_authority_index_build_with_optional_trait_index(
	owner: ModuleIdentity,
	entries: List[AcceptedImplementationAuthorityEntry],
	trait_index: Option[TraitAuthorityIndex],
) -> Result[ImplementationAuthorityIndex, String]:
	var implementations: List[AcceptedImplementationAuthorityEntry] = []
	var implementation_indices: Dict[String, Dict[Int, Int]] = {}
	var methods: List[AcceptedImplementationMethodAuthorityEntry] = []
	var method_indices: Dict[String, Dict[Int, Dict[Int, Int]]] = {}
	var method_indices_by_callable_definition: Dict[Int, List[Int]] = {}
	var candidate_indices: Dict[String, Dict[Int, List[Int]]] = {}
	var issue: Option[String] = None

	for prepared_entry in entries:
		if (
			issue.is_none()
			and authority_entry_is_visible(
				owner,
				prepared_entry.identity.module_identity,
				prepared_entry.visibility,
			)
		):
			entry = implementation_entry_for_owner(owner, prepared_entry)
			module_key = module_identity_storage_key(entry.identity.module_identity)

			module_indices: Dict[Int, Int] = match implementation_indices.get(module_key):
				Some(indices):
					indices
				None:
					{}

			if module_indices.contains(entry.identity.definition_id):
				issue = Some("duplicate accepted implementation identity")
			else:
				entry_index = implementations.length()
				implementations = [entry].concat(implementations)
				implementation_indices = implementation_indices.set(
					module_key,
					module_indices.set(entry.identity.definition_id, entry_index),
				)

				receiver_key = receiver_head_key(entry.receiver_head)

				candidate_traits = match trait_index:
					Some(index):
						trait_authority_index_satisfied_traits_for_build(
							index,
							entry.trait_identity,
						)
					None:
						[entry.trait_identity]

				for candidate_trait in candidate_traits:
					candidate_key = implementation_candidate_key(candidate_trait)

					by_receiver: Dict[Int, List[Int]] = match candidate_indices.get(candidate_key):
						Some(indices):
							indices
						None:
							{}

					prior_candidates: List[Int] = match by_receiver.get(receiver_key):
						Some(indices):
							indices
						None:
							[]

					candidate_indices = candidate_indices.set(
						candidate_key,
						by_receiver.set(
							receiver_key,
							[entry_index].concat(prior_candidates),
						),
					)

				for method in entry.methods:
					if issue.is_none():
						owner_indices: Dict[Int, Dict[Int, Int]] = match method_indices.get(
							module_key,
						):
							Some(indices):
								indices
							None:
								{}

						callable_indices: Dict[Int, Int] = match owner_indices.get(
							entry.identity.definition_id,
						):
							Some(indices):
								indices
							None:
								{}

						if (
							callable_indices.contains(method.identity.callable_definition_id)
							or not accepted_implementation_identities_equal(
								method.identity.owner,
								entry.identity,
							)
						):
							issue = Some(
								"duplicate or mismatched accepted implementation method identity",
							)
						else:
							method_index = methods.length()
							methods = [method].concat(methods)
							method_indices = method_indices.set(
								module_key,
								owner_indices.set(
									entry.identity.definition_id,
									callable_indices.set(
										method.identity.callable_definition_id,
										method_index,
									),
								),
							)

							prior_callable_indices: List[Int] = match method_indices_by_callable_definition.get(
								method.identity.callable_definition_id,
							):
								Some(indices):
									indices
								None:
									[]

							method_indices_by_callable_definition = method_indices_by_callable_definition.set(
								method.identity.callable_definition_id,
								[method_index].concat(prior_callable_indices),
							)

	match issue:
		Some(message):
			Err(message)
		None:
			Ok(into ImplementationAuthorityIndex({
						owner = owner,
						implementations = implementations.reverse(),
						implementation_indices_by_module_and_definition = implementation_indices,
						methods = methods.reverse(),
						method_indices_by_module_owner_and_callable = method_indices,
						method_indices_by_callable_definition = reverse_int_index_lists(
							method_indices_by_callable_definition,
						),
						candidate_indices_by_trait_and_receiver = reverse_nested_index_lists(
							candidate_indices,
						)
					}))


pure func implementation_authority_index_build(
	owner: ModuleIdentity,
	entries: List[AcceptedImplementationAuthorityEntry],
) -> Result[ImplementationAuthorityIndex, String]:
	implementation_authority_index_build_with_optional_trait_index(owner, entries, None)


pure func implementation_authority_index_build_with_trait_index(
	owner: ModuleIdentity,
	entries: List[AcceptedImplementationAuthorityEntry],
	trait_index: TraitAuthorityIndex,
) -> Result[ImplementationAuthorityIndex, String]:
	implementation_authority_index_build_with_optional_trait_index(
		owner,
		entries,
		Some(trait_index),
	)


pure func implementation_authority_index_find_exact(
	index: ImplementationAuthorityIndex,
	id: AcceptedImplementationIdentity,
) -> Option[AcceptedImplementationAuthorityEntry]:
	representation = implementation_authority_index_rep(index)
	module_indices ?= representation.implementation_indices_by_module_and_definition.get(
		module_identity_storage_key(id.module_identity),
	)
	entry_index ?= module_indices.get(id.definition_id)
	entry ?= representation.implementations.get(entry_index)

	if accepted_implementation_identities_equal(entry.identity, id):
		Some(entry)
	else:
		None


pure func implementation_authority_index_find_method_exact(
	index: ImplementationAuthorityIndex,
	id: AcceptedImplementationMethodIdentity,
) -> Option[AcceptedImplementationMethodAuthorityEntry]:
	representation = implementation_authority_index_rep(index)
	owner_indices ?= representation.method_indices_by_module_owner_and_callable.get(
		module_identity_storage_key(id.owner.module_identity),
	)
	callable_indices ?= owner_indices.get(id.owner.definition_id)
	method_index ?= callable_indices.get(id.callable_definition_id)
	entry ?= representation.methods.get(method_index)

	if accepted_implementation_method_identities_equal(entry.identity, id):
		Some(entry)
	else:
		None


pure func implementation_authority_index_find_method_by_callable_definition_id(
	index: ImplementationAuthorityIndex,
	callable_definition_id: Int,
) -> AcceptedImplementationMethodLookup:
	representation = implementation_authority_index_rep(index)

	match representation.method_indices_by_callable_definition.get(callable_definition_id):
		None:
			AcceptedImplementationMethodNotFound
		Some(indices):
			match indices:
				[entry_index]:
					match representation.methods.get(entry_index):
						Some(entry):
							if entry.identity.callable_definition_id == callable_definition_id:
								AcceptedImplementationMethodFound(entry)
							else:
								AcceptedImplementationMethodNotFound
						None:
							AcceptedImplementationMethodNotFound
				_:
					AcceptedImplementationMethodAmbiguous


pure func implementation_authority_index_candidates(
	index: ImplementationAuthorityIndex,
	trait_identity: AcceptedTraitIdentity,
	receiver_head: AcceptedImplementationReceiverHead,
) -> List[AcceptedImplementationAuthorityEntry]:
	representation = implementation_authority_index_rep(index)

	-- Receiver head is only a coarse partition. Callers must retain the existing
	-- receiver compatibility, type-parameter bound, and supertrait checks while
	-- walking this deterministic candidate order.
	match representation.candidate_indices_by_trait_and_receiver.get(
		implementation_candidate_key(trait_identity),
	):
		None:
			[]
		Some(by_receiver):
			match by_receiver.get(receiver_head_key(receiver_head)):
				None:
					[]
				Some(indices):
					var result: List[AcceptedImplementationAuthorityEntry] = []

					for entry_index in indices:
						match representation.implementations.get(entry_index):
							Some(entry):
								-- Construction validates and owns the exact trait bucket,
								-- including inherited supertrait buckets. The entry's
								-- declared trait may therefore differ from this query.
								result = [entry].concat(result)
							None:
								void

					result.reverse()
