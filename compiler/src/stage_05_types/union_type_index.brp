-- Immutable accepted union facts used by typechecking after graph declarations
-- leave lexical Env scopes. Module-local unions are primary; shared canonical
-- unions stay in fallback storage for exact semantic-name lookup.
import:
	env:
		ConstructorSymbol,
		Env,
		Symbol,
		SymbolKind(ConstructorSymbolKind),
		TypeKind(TypeBuiltin),
		env_get_constructor_for_parent,
		env_get_type_decl,
		env_get_type_kind,
		env_type_contains_resource_if_valid,
		env_type_is_enum,
		env_type_may_contain_function,
		env_type_may_contain_one_shot_stream,
		env_type_may_contain_resource_source,
	semantic_type: SemanticType, types_equal


record AcceptedUnionVariantEntry {
	name: String,
	constructor_id: Int,
	fields: List[SemanticType],
	tag: Int
}


record AcceptedUnionEntry {
	type_params: List[String],
	variants: List[AcceptedUnionVariantEntry],
	is_enum: Bool,
	contains_resource: Bool,
	may_contain_function: Bool,
	may_contain_one_shot_stream: Bool,
	may_contain_resource_source: Bool
}


private record UnionTypeIndexRep {
	unions_by_name: Dict[String, AcceptedUnionEntry],
	fallback_unions_by_name: Dict[String, AcceptedUnionEntry],
	constructors_by_name: Dict[String, List[Symbol]],
	fallback_constructors_by_name: Dict[String, List[Symbol]],
	constructor_parent_aliases: Dict[String, String],
	constructors_by_module_path: Dict[String, Dict[String, List[Symbol]]],
	fallback_constructors_by_module_path: Dict[String, Dict[String, List[Symbol]]]
}


opaque type UnionTypeIndex = UnionTypeIndexRep


private pure func union_type_index_rep(index: UnionTypeIndex) -> UnionTypeIndexRep:
	from UnionTypeIndex(index)


UNION_TYPE_INDEX_EMPTY: UnionTypeIndex = into UnionTypeIndex({
		unions_by_name = {},
		fallback_unions_by_name = {},
		constructors_by_name = {},
		fallback_constructors_by_name = {},
		constructor_parent_aliases = {},
		constructors_by_module_path = {},
		fallback_constructors_by_module_path = {}
	})


pure func union_type_index_with_fallback(
	index: UnionTypeIndex,
	fallback: UnionTypeIndex,
) -> UnionTypeIndex:
	representation = union_type_index_rep(index)
	fallback_representation = union_type_index_rep(fallback)

	into UnionTypeIndex({ representation |
			fallback_unions_by_name = fallback_representation.unions_by_name,
			fallback_constructors_by_name = fallback_representation.constructors_by_name,
			fallback_constructors_by_module_path = fallback_representation.constructors_by_module_path
		})


-- Selective constructor imports are resolved once while the accepted module
-- index is built. Bare inference then uses the same local dictionary for local
-- and explicitly imported spellings without rescanning modules.
pure func union_type_index_with_visible_constructor_bindings(
	index: UnionTypeIndex,
	bindings: List[(String, String, Symbol)],
) -> UnionTypeIndex:
	representation = union_type_index_rep(index)
	var constructors_by_name = representation.constructors_by_name
	var constructor_parent_aliases = representation.constructor_parent_aliases

	for binding in bindings:
		(local_name, parent_local_name, symbol) = binding
		prior = constructors_by_name
			.get(local_name)
			.get_or([])
		constructor_id = constructor_from_symbol(
			symbol,
		).map(
			func(constructor): constructor.constructor_id,
		)

		already_visible = match constructor_id:
			Some(id):
				prior.any(
					func(
						existing,
					): constructor_from_symbol(
						existing,
					).map(
						func(constructor): constructor.constructor_id,
					) == Some(id),
				)
			None:
				False

		match symbol.kind:
			ConstructorSymbolKind(constructor):
				if not constructor_parent_aliases.contains(parent_local_name):
					constructor_parent_aliases = constructor_parent_aliases.set(
						parent_local_name,
						constructor.parent_type,
					)
			_:
				void

		if not already_visible:
			constructors_by_name = constructors_by_name.set(
				local_name,
				prior.append(symbol),
			)

	into UnionTypeIndex({ representation |
			constructors_by_name = constructors_by_name,
			constructor_parent_aliases = constructor_parent_aliases
		})


private pure func constructor_entry(
	parent_type: String,
	type_params: List[String],
	variant: AcceptedUnionVariantEntry,
) -> Symbol:
	{
		name = variant.name,
		kind = ConstructorSymbolKind({
			parent_type = parent_type,
			constructor_id = variant.constructor_id,
			type_params = type_params,
			field_types = variant.fields,
			tag = variant.tag,
		})
	}


private pure func add_constructors_by_name(
	constructors_by_name: Dict[String, List[Symbol]],
	parent_type: String,
	entry: AcceptedUnionEntry,
) -> Dict[String, List[Symbol]]:
	var result = constructors_by_name

	for variant in entry.variants:
		prior = result
			.get(variant.name)
			.get_or([])
		result = result.set(
			variant.name,
			[constructor_entry(parent_type, entry.type_params, variant)].concat(prior),
		)

	result


private pure func add_module_constructors(
	constructors_by_module_path: Dict[String, Dict[String, List[Symbol]]],
	module_path: String,
	parent_type: String,
	entry: AcceptedUnionEntry,
) -> Dict[String, Dict[String, List[Symbol]]]:
	module_constructors = constructors_by_module_path
		.get(module_path)
		.get_or({})
	constructors_by_module_path.set(
		module_path,
		add_constructors_by_name(module_constructors, parent_type, entry),
	)


-- Construction owns these dictionaries uniquely. Build all category indexes
-- in local accumulators, then wrap one immutable value instead of rebuilding
-- the opaque record after every declaration.
pure func union_type_index_build(
	entries: List[(String, Option[String], AcceptedUnionEntry)],
) -> Result[UnionTypeIndex, String]:
	var unions_by_name: Dict[String, AcceptedUnionEntry] = {}
	var constructors_by_name: Dict[String, List[Symbol]] = {}
	var constructors_by_module_path: Dict[String, Dict[String, List[Symbol]]] = {}
	var issue: Option[String] = None

	for item in entries:
		(name, module_path, entry) = item

		if issue.is_none():
			if unions_by_name.contains(name):
				issue = Some("duplicate accepted union projection for '" + name + "'")
			else:
				unions_by_name = unions_by_name.set(name, entry)

				match module_path:
					Some(path):
						constructors_by_module_path = add_module_constructors(
							constructors_by_module_path,
							path,
							name,
							entry,
						)
					None:
						constructors_by_name = add_constructors_by_name(
							constructors_by_name,
							name,
							entry,
						)

	match issue:
		Some(message):
			Err(message)
		None:
			Ok(into UnionTypeIndex({
						unions_by_name = unions_by_name,
						fallback_unions_by_name = {},
						constructors_by_name = constructors_by_name,
						fallback_constructors_by_name = {},
						constructor_parent_aliases = {},
						constructors_by_module_path = constructors_by_module_path,
						fallback_constructors_by_module_path = {}
					}))


pure func union_type_index_add(
	index: UnionTypeIndex,
	name: String,
	entry: AcceptedUnionEntry,
) -> Option[UnionTypeIndex]:
	representation = union_type_index_rep(index)

	if representation.unions_by_name.contains(name):
		None
	else:
		Some(into UnionTypeIndex({ representation |
					unions_by_name = representation.unions_by_name.set(name, entry),
					constructors_by_name = add_constructors_by_name(
						representation.constructors_by_name,
						name,
						entry,
					)
				}))


private pure func semantic_type_lists_equal(
	left: List[SemanticType],
	right: List[SemanticType],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal: Bool = True
		var index: Int = 0

		while equal and index < left.length():
			equal = match (left.get(index), right.get(index)):
				(Some(left_type), Some(right_type)):
					types_equal(left_type, right_type)
				_:
					False

			index += 1

		equal


private pure func builtin_union_entry_from_env(
	env: Env,
	name: String,
) -> Result[AcceptedUnionEntry, String]:
	if env_get_type_kind(env, name) != Some(TypeBuiltin):
		Err("bootstrap union '" + name + "' is missing its builtin type declaration")
	else:
		match env_get_type_decl(env, name):
			Some((type_params, variants)):
				containment = (
					env_type_contains_resource_if_valid(env, name),
					env_type_may_contain_function(env, name),
					env_type_may_contain_one_shot_stream(env, name),
					env_type_may_contain_resource_source(env, name),
				)

				match containment:
					(Some(contains_resource), Some(may_contain_function), Some(may_contain_one_shot_stream), Some(may_contain_resource_source)):
						var projected_variants: List[AcceptedUnionVariantEntry] = []
						var issue: Option[String] = None

						for variant in variants:
							if issue.is_none():
								match env_get_constructor_for_parent(env, name, variant.name):
									Some(constructor):
										if (
											constructor.parent_type == name
											and constructor.type_params == type_params
											and semantic_type_lists_equal(
												constructor.field_types,
												variant.fields,
											)
											and constructor.tag == variant.tag
										):
											projected_variants = projected_variants.append({
												name = variant.name,
												constructor_id = constructor.constructor_id,
												fields = variant.fields,
												tag = variant.tag,
											})
										else:
											issue = Some(
												"bootstrap constructor '" + name + "." + variant.name + "' does not match its type declaration",
											)
									None:
										issue = Some(
											"bootstrap union '" + name + "' is missing constructor '" + variant.name + "'",
										)

						match issue:
							Some(message):
								Err(message)
							None:
								Ok({
									type_params = type_params,
									variants = projected_variants,
									is_enum = env_type_is_enum(env, name),
									contains_resource = contains_resource,
									may_contain_function = may_contain_function,
									may_contain_one_shot_stream = may_contain_one_shot_stream,
									may_contain_resource_source = may_contain_resource_source,
								})
					_:
						Err("bootstrap union '" + name + "' has incomplete containment metadata")
			None:
				Err("bootstrap union '" + name + "' is missing its type metadata")


private pure func accepted_union_entries_equal(
	left: AcceptedUnionEntry,
	right: AcceptedUnionEntry,
) -> Bool:
	var variants_equal = left.variants.length() == right.variants.length()
	var index: Int = 0

	while variants_equal and index < left.variants.length():
		variants_equal = match (left.variants.get(index), right.variants.get(index)):
			(Some(left_variant), Some(right_variant)):
				(
					left_variant.name == right_variant.name
					and semantic_type_lists_equal(left_variant.fields, right_variant.fields)
					and left_variant.tag == right_variant.tag
				)
			_:
				False

		index += 1

	(
		left.type_params == right.type_params
		and left.is_enum == right.is_enum
		and left.contains_resource == right.contains_resource
		and left.may_contain_function == right.may_contain_function
		and left.may_contain_one_shot_stream == right.may_contain_one_shot_stream
		and left.may_contain_resource_source == right.may_contain_resource_source
		and variants_equal
	)


private pure func union_type_index_publish_builtin_entry(
	index: UnionTypeIndex,
	name: String,
	entry: AcceptedUnionEntry,
) -> Result[UnionTypeIndex, String]:
	representation = union_type_index_rep(index)

	match union_type_index_find(index, name):
		Some(existing):
			if accepted_union_entries_equal(existing, entry):
				-- A source intrinsic such as std/channel.ConcurrencyError may
				-- already own the accepted union entry. Its module-qualified
				-- constructors do not replace the language-level bare builtin
				-- constructors, so publish those names even when metadata agrees.
				Ok(
					into UnionTypeIndex(
						{ representation |
							constructors_by_name = add_constructors_by_name(
								representation.constructors_by_name,
								name,
								existing,
							)
						}
					),
				)
			else:
				Err("bootstrap union '" + name + "' does not match accepted graph metadata")
		None:
			match union_type_index_add(index, name, entry):
				Some(updated):
					Ok(updated)
				None:
					Err("duplicate bootstrap union projection for '" + name + "'")


-- Intrinsic unions are established in the bootstrap type environment rather
-- than by source headers. Validate and project them once at graph completion.
pure func union_type_index_with_builtins_from_env(
	index: UnionTypeIndex,
	env: Env,
	names: List[String],
) -> Result[UnionTypeIndex, String]:
	var result = index
	var issue: Option[String] = None

	for name in names:
		if issue.is_none():
			match builtin_union_entry_from_env(env, name):
				Ok(entry):
					match union_type_index_publish_builtin_entry(result, name, entry):
						Ok(updated):
							result = updated
						Err(message):
							issue = Some(message)
				Err(message):
					issue = Some(message)

	match issue:
		Some(message):
			Err(message)
		None:
			Ok(result)


pure func union_type_index_add_module(
	index: UnionTypeIndex,
	module_path: String,
	name: String,
	entry: AcceptedUnionEntry,
) -> Option[UnionTypeIndex]:
	representation = union_type_index_rep(index)

	if representation.unions_by_name.contains(name):
		None
	else:
		Some(into UnionTypeIndex({ representation |
					unions_by_name = representation.unions_by_name.set(name, entry),
					constructors_by_module_path = add_module_constructors(
						representation.constructors_by_module_path,
						module_path,
						name,
						entry,
					)
				}))


pure func union_type_index_find(index: UnionTypeIndex, name: String) -> Option[AcceptedUnionEntry]:
	representation = union_type_index_rep(index)

	match representation.unions_by_name.get(name):
		Some(entry):
			Some(entry)
		None:
			representation.fallback_unions_by_name.get(name)


pure func union_type_index_contains(index: UnionTypeIndex, name: String) -> Bool:
	representation = union_type_index_rep(index)

	(
		representation.unions_by_name.contains(name)
		or representation.fallback_unions_by_name.contains(name)
	)


private pure func first_constructor_symbol(symbols: Option[List[Symbol]]) -> Option[Symbol]:
	match symbols:
		Some(entries):
			entries.get(0)
		None:
			None


pure func union_type_index_find_constructor_symbol(
	index: UnionTypeIndex,
	name: String,
) -> Option[Symbol]:
	representation = union_type_index_rep(index)

	match first_constructor_symbol(representation.constructors_by_name.get(name)):
		Some(symbol):
			Some(symbol)
		None:
			first_constructor_symbol(representation.fallback_constructors_by_name.get(name))


private pure func constructor_symbol_for_parent(
	symbols: Option[List[Symbol]],
	parent_type: String,
) -> Option[Symbol]:
	var result: Option[Symbol] = None

	match symbols:
		Some(entries):
			for symbol in entries:
				if result.is_none():
					match constructor_from_symbol(symbol):
						Some(constructor):
							if constructor.parent_type == parent_type:
								result = Some(symbol)
						None:
							void
		None:
			void

	result


pure func union_type_index_find_constructor_symbol_for_parent(
	index: UnionTypeIndex,
	parent_type: String,
	name: String,
) -> Option[Symbol]:
	representation = union_type_index_rep(index)
	resolved_parent_type = representation.constructor_parent_aliases
		.get(parent_type)
		.get_or(parent_type)

	match constructor_symbol_for_parent(
		representation.constructors_by_name.get(name),
		resolved_parent_type,
	):
		Some(symbol):
			Some(symbol)
		None:
			constructor_symbol_for_parent(
				representation.fallback_constructors_by_name.get(name),
				resolved_parent_type,
			)


private pure func constructor_from_symbol(symbol: Symbol) -> Option[ConstructorSymbol]:
	match symbol.kind:
		ConstructorSymbolKind(constructor):
			Some(constructor)
		_:
			None


pure func union_type_index_find_constructor(
	index: UnionTypeIndex,
	name: String,
) -> Option[ConstructorSymbol]:
	match union_type_index_find_constructor_symbol(index, name):
		Some(symbol):
			constructor_from_symbol(symbol)
		None:
			None


pure func union_type_index_find_constructor_for_parent(
	index: UnionTypeIndex,
	parent_type: String,
	name: String,
) -> Option[ConstructorSymbol]:
	union_type_index_find_constructor_symbol_for_parent(
		index,
		parent_type,
		name,
	).and_then(constructor_from_symbol)


pure func union_type_index_find_module_constructor_symbol(
	index: UnionTypeIndex,
	module_path: String,
	name: String,
) -> Option[Symbol]:
	representation = union_type_index_rep(index)

	local = match representation.constructors_by_module_path.get(module_path):
		Some(constructors):
			first_constructor_symbol(constructors.get(name))
		None:
			None

	match local:
		Some(constructor):
			Some(constructor)
		None:
			match representation.fallback_constructors_by_module_path.get(module_path):
				Some(constructors):
					first_constructor_symbol(constructors.get(name))
				None:
					None


private pure func module_constructor_symbol_for_parent(
	constructors_by_module_path: Dict[String, Dict[String, List[Symbol]]],
	module_path: String,
	parent_type: String,
	name: String,
) -> Option[Symbol]:
	constructor_symbol_for_parent(
		constructors_by_module_path.get(module_path).and_then(
			func(constructors): constructors.get(name),
		),
		parent_type,
	)


pure func union_type_index_find_module_constructor_symbol_for_parent(
	index: UnionTypeIndex,
	module_path: String,
	parent_type: String,
	name: String,
) -> Option[Symbol]:
	representation = union_type_index_rep(index)

	match module_constructor_symbol_for_parent(
		representation.constructors_by_module_path,
		module_path,
		parent_type,
		name,
	):
		Some(symbol):
			Some(symbol)
		None:
			module_constructor_symbol_for_parent(
				representation.fallback_constructors_by_module_path,
				module_path,
				parent_type,
				name,
			)


pure func union_type_index_find_module_constructor(
	index: UnionTypeIndex,
	module_path: String,
	name: String,
) -> Option[ConstructorSymbol]:
	match union_type_index_find_module_constructor_symbol(index, module_path, name):
		Some(symbol):
			constructor_from_symbol(symbol)
		None:
			None


pure func union_type_index_entry_count(index: UnionTypeIndex) -> Int:
	representation = union_type_index_rep(index)

	representation.unions_by_name.length() + representation.fallback_unions_by_name.length()
