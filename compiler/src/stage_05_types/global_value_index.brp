-- Compact accepted global declarations and module-visible bindings. Exact
-- declaration metadata is stored once; source and qualified names point to a
-- binding that selects the correct local or canonical type spelling.
import:
	../stage_04_modules/loaded_module: ModuleIdentity, module_identity_storage_key
	env: VarMutability
	semantic_type: SemanticType


private record AcceptedGlobalDefinitionIdRep {
	module_identity: ModuleIdentity,
	value: Int
}


opaque type AcceptedGlobalDefinitionId = AcceptedGlobalDefinitionIdRep


pure func accepted_global_definition_id(
	module_identity: ModuleIdentity,
	value: Int,
) -> AcceptedGlobalDefinitionId:
	into AcceptedGlobalDefinitionId({
			module_identity = module_identity,
			value = value
		})


pure func accepted_global_definition_id_module_identity(
	id: AcceptedGlobalDefinitionId,
) -> ModuleIdentity:
	from AcceptedGlobalDefinitionId(id).module_identity


pure func accepted_global_definition_id_value(id: AcceptedGlobalDefinitionId) -> Int:
	from AcceptedGlobalDefinitionId(id).value


record AcceptedGlobalValueEntry {
	definition_id: AcceptedGlobalDefinitionId,
	source_binding_type: SemanticType,
	canonical_binding_type: SemanticType,
	source_type: Option[SemanticType],
	mutability: VarMutability
}


record AcceptedGlobalValueBinding {
	entry: AcceptedGlobalValueEntry,
	binding_type: SemanticType,
	module_path: String
}


private record GlobalValueIndexRep {
	exact_by_module_identity_key: Dict[String, Dict[Int, AcceptedGlobalValueEntry]],
	visible_by_name: Dict[String, AcceptedGlobalValueBinding],
	modules_by_path: Dict[String, Dict[String, AcceptedGlobalValueBinding]]
}


opaque type GlobalValueIndex = GlobalValueIndexRep


private pure func global_value_index_rep(index: GlobalValueIndex) -> GlobalValueIndexRep:
	from GlobalValueIndex(index)


GLOBAL_VALUE_INDEX_EMPTY: GlobalValueIndex = into GlobalValueIndex({
		exact_by_module_identity_key = {},
		visible_by_name = {},
		modules_by_path = {}
	})


pure func global_value_binding(
	entry: AcceptedGlobalValueEntry,
	binding_type: SemanticType,
	module_path: String,
) -> AcceptedGlobalValueBinding:
	{
		entry = entry,
		binding_type = binding_type,
		module_path = module_path
	}


pure func global_value_index_add_exact(
	index: GlobalValueIndex,
	entry: AcceptedGlobalValueEntry,
) -> Option[GlobalValueIndex]:
	representation = global_value_index_rep(index)
	module_key = module_identity_storage_key(
		accepted_global_definition_id_module_identity(entry.definition_id),
	)
	key = accepted_global_definition_id_value(entry.definition_id)

	module_entries: Dict[Int, AcceptedGlobalValueEntry] = match representation.exact_by_module_identity_key.get(
		module_key,
	):
		Some(entries):
			entries
		None:
			{}

	if module_entries.contains(key):
		None
	else:
		Some(
			into GlobalValueIndex(
				{ representation |
					exact_by_module_identity_key = representation.exact_by_module_identity_key.set(
						module_key,
						module_entries.set(key, entry),
					)
				}
			),
		)


pure func global_value_index_add_visible(
	index: GlobalValueIndex,
	name: String,
	binding: AcceptedGlobalValueBinding,
) -> Option[GlobalValueIndex]:
	representation = global_value_index_rep(index)

	if representation.visible_by_name.contains(name):
		None
	else:
		Some(
			into GlobalValueIndex(
				{ representation |
					visible_by_name = representation.visible_by_name.set(name, binding)
				}
			),
		)


-- Local declarations are installed after imports and intentionally replace an
-- imported source spelling while preserving the imported exact identity.
pure func global_value_index_set_visible(
	index: GlobalValueIndex,
	name: String,
	binding: AcceptedGlobalValueBinding,
) -> GlobalValueIndex:
	representation = global_value_index_rep(index)

	into GlobalValueIndex(
		{ representation | visible_by_name = representation.visible_by_name.set(name, binding) }
	)


pure func global_value_index_add_module(
	index: GlobalValueIndex,
	module_path: String,
	name: String,
	binding: AcceptedGlobalValueBinding,
) -> Option[GlobalValueIndex]:
	representation = global_value_index_rep(index)

	module_entries: Dict[String, AcceptedGlobalValueBinding] = match representation.modules_by_path.get(
		module_path,
	):
		Some(entries):
			entries
		None:
			{}

	if module_entries.contains(name):
		None
	else:
		Some(
			into GlobalValueIndex(
				{ representation | modules_by_path = representation.modules_by_path.set(
						module_path,
						module_entries.set(name, binding),
					) }
			),
		)


pure func global_value_index_find_exact(
	index: GlobalValueIndex,
	id: AcceptedGlobalDefinitionId,
) -> Option[AcceptedGlobalValueEntry]:
	representation = global_value_index_rep(index)
	module_key = module_identity_storage_key(accepted_global_definition_id_module_identity(id))
	key = accepted_global_definition_id_value(id)

	match representation.exact_by_module_identity_key.get(module_key):
		Some(entries):
			entries.get(key)
		None:
			None


pure func global_value_index_find_visible(
	index: GlobalValueIndex,
	name: String,
) -> Option[AcceptedGlobalValueBinding]:
	global_value_index_rep(index).visible_by_name.get(name)


pure func global_value_index_find_module(
	index: GlobalValueIndex,
	module_path: String,
	name: String,
) -> Option[AcceptedGlobalValueBinding]:
	representation = global_value_index_rep(index)

	match representation.modules_by_path.get(module_path):
		Some(entries):
			entries.get(name)
		None:
			None


pure func global_value_index_entry_count(index: GlobalValueIndex) -> Int:
	representation = global_value_index_rep(index)
	var count: Int = 0

	for entries in representation.exact_by_module_identity_key.values():
		count += entries.length()

	count
