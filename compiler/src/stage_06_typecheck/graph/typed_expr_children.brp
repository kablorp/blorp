-- One child relation for compiler projections over typed expressions.
-- Keeping this beside graph projections avoids adding traversal-only code to
-- every consumer of the already broad inference module.
import:
	../infer:
		TypedExpr(
			TypedAscriptionExpr,
			TypedAssignExpr,
			TypedBinaryExpr,
			TypedBlockExpr,
			TypedCallExpr,
			TypedConcurrentBlockExpr,
			TypedConcurrentForExpr,
			TypedDebugBlockExpr,
			TypedDetachExpr,
			TypedDictExpr,
			TypedFieldAccessExpr,
			TypedForExpr,
			TypedIfExpr,
			TypedLambdaExpr,
			TypedListExpr,
			TypedLogicalExpr,
			TypedMatchExpr,
			TypedOpaqueFromExpr,
			TypedOpaqueIntoExpr,
			TypedQuestionBindExpr,
			TypedRangeExpr,
			TypedRecordExpr,
			TypedRecordUpdateExpr,
			TypedSelectExpr,
			TypedStringInterpolationPartsExpr,
			TypedSubscriptAssignExpr,
			TypedSubscriptExpr,
			TypedTupleDestructExpr,
			TypedTupleExpr,
			TypedUnaryExpr,
			TypedVarDeclExpr,
			TypedVectorExpr,
			TypedWhileExpr,
			TypedWithExpr,
		),
		TypedSelectArmKind(TypedSelectAfterArm, TypedSelectReceiveArm, TypedSelectSealedArm),
		TypedStringInterpolationPart(TypedInterpolationExpr, TypedInterpolationLiteral),


pure func typed_expr_children(expr: TypedExpr) -> List[TypedExpr]:
	match expr:
		TypedUnaryExpr(_, inner, _, _):
			[inner]
		TypedBinaryExpr(_, left, right, _, _):
			[left, right]
		TypedLogicalExpr(_, left, right, _, _):
			[left, right]
		TypedCallExpr(callee, args, _, _):
			[callee] + args
		TypedTupleExpr(items, _, _):
			items
		TypedTupleDestructExpr(_, value, _, _):
			[value]
		TypedAssignExpr(_, _, value, _, _):
			[value]
		TypedSubscriptExpr(receiver, indices, _, _):
			[receiver] + indices
		TypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
			[receiver] + indices + [value]
		TypedListExpr(items, _, _):
			items
		TypedVectorExpr(items, _, _):
			items
		TypedDictExpr(entries, _, _):
			entries.flat_map(func(entry): [entry.key, entry.value])
		TypedOpaqueIntoExpr(_, inner, _, _):
			[inner]
		TypedOpaqueFromExpr(_, inner, _, _):
			[inner]
		TypedRecordExpr(fields, _, _):
			fields.map(func(field): field.value)
		TypedRecordUpdateExpr(receiver, fields, _, _, _):
			[receiver] + fields.map(func(field): field.value)
		TypedFieldAccessExpr(receiver, _, _, _):
			[receiver]
		TypedLambdaExpr(_, _, _, body, _, _):
			[body]
		TypedRangeExpr(start_expr, end_expr, _, _):
			[start_expr, end_expr]
		TypedIfExpr(condition, then_branch, else_branch, _, _):
			else_children: List[TypedExpr] = match else_branch:
				Some(branch):
					[branch]
				None:
					[]

			[condition, then_branch] + else_children
		TypedMatchExpr(scrutinee, cases, _, _):
			[scrutinee] + cases.map(func(case): case.body)
		TypedSelectExpr(arms, _, _):
			arms.flat_map(func(arm):
				arm_value: TypedExpr = match arm.kind:
					TypedSelectReceiveArm(_, _, channel):
						channel
					TypedSelectSealedArm(_, channel):
						channel
					TypedSelectAfterArm(timeout):
						timeout

				[arm_value, arm.body]
			)
		TypedWhileExpr(condition, body, _, _):
			[condition, body]
		TypedForExpr(_, iterable, _, body, _, _):
			[iterable, body]
		TypedConcurrentBlockExpr(params, bindings, _, _):
			param_values = params.map(func(param): param.value)
			param_values + bindings.map(func(binding): binding.value)
		TypedConcurrentForExpr(_, iterable, params, body, _, _):
			[iterable] + params.map(func(param): param.value) + [body]
		TypedDetachExpr(body, _, _):
			[body]
		TypedAscriptionExpr(inner, _, _, _):
			[inner]
		TypedBlockExpr(items, _, _):
			items
		TypedWithExpr(binding, body, _, _):
			error_map_values: List[TypedExpr] = match binding.error_map:
				Some(mapper):
					[mapper.value]
				None:
					[]

			[binding.value] + error_map_values + [body]
		TypedDebugBlockExpr(body, _, _):
			[body]
		TypedVarDeclExpr(payload, _):
			[payload.initializer]
		TypedQuestionBindExpr(_, _, value, _, _):
			[value]
		TypedStringInterpolationPartsExpr(parts, _, _, _):
			parts.flat_map(func(part):
				match part:
					TypedInterpolationLiteral(_):
						empty: List[TypedExpr] = []
						empty
					TypedInterpolationExpr(value):
						[value]
			)
		_:
			[]
