-- Opaque graph-wide index of stable callable and source-definition IDs.
--
-- The index owns its lookup maps, counts, and allocation frontier as one value.
-- Callers can query or extend it through operations that preserve those facts;
-- they cannot construct mismatched maps and counters directly.
import:
	../../stage_01_file_io/source: SourceSpan, source_spans_equal
	../../stage_03_parse/parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			ImportBlockParsedDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedForeignFunctionDecl,
		ParsedFunctionDecl,
		ParsedImplDecl,
		ParsedImportDecl,
		ParsedImportSymbol,
		ParsedProgram,
	../../stage_04_modules/loaded_module:
		LoadedModule,
		LoadedModuleSet,
		ModuleIdentity,
		loaded_module_canonical_path,
		loaded_module_identity,
		loaded_module_origin,
		loaded_module_program,
		loaded_module_set_modules,
		loaded_module_set_target,
		module_identities_equal,
		module_identity_display_name,
	../../stage_05_types/builtins:
		builtin_trait_is_prelude,
		env_with_builtins,
		prelude_traits_module_matches,
	../../stage_05_types/env: Env
	definition_identity:
		FuncCallableKey,
		SourceDefinitionKey,
		SourceDefinitionKind(
			ConstructorDefinition,
			FieldDefinition,
			GlobalDefinition,
			ImplDefinition,
			TraitDefinition,
			TypeDefinition,
		),
		func_callable_key,
		func_callable_key_description,
		func_callable_key_module_identity,
		func_callable_key_name,
		func_callable_key_span,
		func_callable_keys_equal,
		source_definition_key,
		source_definition_key_description,
		source_definition_key_module_identity,
		source_definition_key_name,
		source_definition_keys_equal,


private struct DefinitionIndexSeedRep {
	next_def_id: Int
}


opaque type DefinitionIndexSeed = DefinitionIndexSeedRep


private record FuncCallableIdEntry {
	key: FuncCallableKey,
	def_id: Int
}


private record SourceDefinitionIdEntry {
	key: SourceDefinitionKey,
	def_id: Int
}


private type alias FuncCallableNameBuckets = Dict[String, List[FuncCallableIdEntry]]

private type alias SourceDefinitionNameBuckets = Dict[String, List[SourceDefinitionIdEntry]]


union DefinitionIndexBindingKey:
	FuncCallableBindingKey(FuncCallableKey)
	SourceDefinitionBindingKey(SourceDefinitionKey)


union DefinitionIndexConflict:
	DefinitionKeyAlreadyAssigned(DefinitionIndexBindingKey, Int, Int)
	DefinitionIdBelowAllocationFrontier(Int, Int, DefinitionIndexBindingKey)


private record DefinitionIndexRep {
	func_callable_ids_by_module_bucket_and_name: Dict[String, FuncCallableNameBuckets],
	source_definition_ids_by_module_bucket_and_name: Dict[String, SourceDefinitionNameBuckets],
	func_callable_id_count: Int,
	source_definition_id_count: Int,
	next_def_id: Int
}


-- The first update may detach these maps from the source index through COW;
-- subsequent reservations reuse the builder-owned maps. Keeping the bucket in
-- the builder prevents committing a valid build under the wrong module key.
private record DefinitionModuleBuildState {
	module_bucket: String,
	func_callable_ids_by_name: FuncCallableNameBuckets,
	source_definition_ids_by_name: SourceDefinitionNameBuckets,
	next_def_id: Int,
	added_func_count: Int,
	added_source_count: Int
}


opaque type DefinitionIndex = DefinitionIndexRep


private record DefinitionIndexBootstrapRep {
	env: Env,
	empty_index: DefinitionIndex
}


opaque type DefinitionIndexBootstrap = DefinitionIndexBootstrapRep


-- Defaults remain associated with the trait that declared them. Keeping this
-- catalog module-qualified prevents an unrelated trait from creating phantom
-- callable IDs at every implementation span.
private enum TraitDefaultsModuleKind:
	OrdinaryTraitDefaultsModule
	PreludeTraitDefaultsModule


private record TraitDefaultMethods {
	module_identity: ModuleIdentity,
	canonical_path: String,
	module_kind: TraitDefaultsModuleKind,
	trait_name: String,
	method_names: List[String]
}


private record ImportedTraitReference {
	canonical_path: String,
	trait_name: String
}


private pure func definition_index_bootstrap_rep(
	bootstrap: DefinitionIndexBootstrap,
) -> DefinitionIndexBootstrapRep:
	from DefinitionIndexBootstrap(bootstrap)


private pure func definition_index_seed_from_env(env: Env) -> DefinitionIndexSeed:
	representation: DefinitionIndexSeedRep = {next_def_id = env.next_def_id}
	into DefinitionIndexSeed(representation)


pure func definition_index_initial_seed(base_env: Env) -> DefinitionIndexSeed:
	definition_index_seed_from_env(env_with_builtins(base_env))


pure func definition_index_seed_next_def_id(seed: DefinitionIndexSeed) -> Int:
	representation: DefinitionIndexSeedRep = from DefinitionIndexSeed(seed)
	representation.next_def_id


private pure func definition_index_rep_empty(seed: DefinitionIndexSeed) -> DefinitionIndexRep:
	{
		func_callable_ids_by_module_bucket_and_name = {},
		source_definition_ids_by_module_bucket_and_name = {},
		func_callable_id_count = 0,
		source_definition_id_count = 0,
		next_def_id = definition_index_seed_next_def_id(seed)
	}


pure func definition_index_empty(seed: DefinitionIndexSeed) -> DefinitionIndex:
	into DefinitionIndex(definition_index_rep_empty(seed))


pure func definition_index_bootstrap_from_base_env(base_env: Env) -> DefinitionIndexBootstrap:
	env = env_with_builtins(base_env)
	representation: DefinitionIndexBootstrapRep = {
		env = env,
		empty_index = definition_index_empty(definition_index_seed_from_env(env))
	}
	into DefinitionIndexBootstrap(representation)


pure func definition_index_bootstrap_env(bootstrap: DefinitionIndexBootstrap) -> Env:
	representation = definition_index_bootstrap_rep(bootstrap)
	representation.env


pure func definition_index_bootstrap_empty_index(
	bootstrap: DefinitionIndexBootstrap,
) -> DefinitionIndex:
	representation = definition_index_bootstrap_rep(bootstrap)
	representation.empty_index


private pure func definition_binding_key_description(key: DefinitionIndexBindingKey) -> String:
	match key:
		FuncCallableBindingKey(callable_key):
			func_callable_key_description(callable_key)
		SourceDefinitionBindingKey(source_key):
			source_definition_key_description(source_key)


pure func definition_index_conflict_message(conflict: DefinitionIndexConflict) -> String:
	match conflict:
		DefinitionKeyAlreadyAssigned(key, existing_id, requested_id):
			"definition index conflict: " + definition_binding_key_description(
				key,
			) + " already maps to definition ID " + existing_id.to_string() + "; cannot remap it to definition ID " + requested_id.to_string()
		DefinitionIdBelowAllocationFrontier(def_id, frontier, requested_key):
			"definition index conflict: definition ID " + def_id.to_string() + " is below allocation frontier " + frontier.to_string() + "; cannot assign it to " + definition_binding_key_description(
				requested_key,
			)


private pure func definition_index_next_after_id(index: DefinitionIndexRep, def_id: Int) -> Int:
	if def_id >= index.next_def_id:
		def_id + 1
	else:
		index.next_def_id


private pure func definition_index_module_build_state(
	index: DefinitionIndexRep,
	module_bucket: String,
) -> DefinitionModuleBuildState:
	{
		module_bucket = module_bucket,
		func_callable_ids_by_name = index.func_callable_ids_by_module_bucket_and_name.get_or(
			module_bucket,
			{},
		),
		source_definition_ids_by_name = index.source_definition_ids_by_module_bucket_and_name.get_or(
			module_bucket,
			{},
		),
		next_def_id = index.next_def_id,
		added_func_count = 0,
		added_source_count = 0
	}


private pure func definition_index_commit_module_build(
	index: DefinitionIndexRep,
	build: DefinitionModuleBuildState,
) -> DefinitionIndexRep:
	{ index |
		func_callable_ids_by_module_bucket_and_name = index.func_callable_ids_by_module_bucket_and_name.set(
			build.module_bucket,
			build.func_callable_ids_by_name,
		),
		source_definition_ids_by_module_bucket_and_name = index.source_definition_ids_by_module_bucket_and_name.set(
			build.module_bucket,
			build.source_definition_ids_by_name,
		),
		func_callable_id_count = index.func_callable_id_count + build.added_func_count,
		source_definition_id_count = index.source_definition_id_count + build.added_source_count,
		next_def_id = build.next_def_id
	}


private pure func definition_module_find_func_callable_id(
	build: DefinitionModuleBuildState,
	key: FuncCallableKey,
) -> Option[Int]:
	var result: Option[Int] = None

	for entry in build.func_callable_ids_by_name.get_or(func_callable_key_name(key), []):
		if func_callable_keys_equal(entry.key, key):
			result = Some(entry.def_id)
			break

	result


private pure func definition_module_add_func_callable_id(
	build: DefinitionModuleBuildState,
	key: FuncCallableKey,
) -> DefinitionModuleBuildState:
	name = func_callable_key_name(key)
	entry: FuncCallableIdEntry = {
		key = key,
		def_id = build.next_def_id
	}
	{ build |
		func_callable_ids_by_name = build.func_callable_ids_by_name.set(
			name,
			build.func_callable_ids_by_name
				.get_or(name, [])
				.append(entry),
		),
		next_def_id = build.next_def_id + 1,
		added_func_count = build.added_func_count + 1
	}


private pure func definition_module_find_source_definition_id(
	build: DefinitionModuleBuildState,
	key: SourceDefinitionKey,
) -> Option[Int]:
	var result: Option[Int] = None

	for entry in build.source_definition_ids_by_name.get_or(source_definition_key_name(key), []):
		if source_definition_keys_equal(entry.key, key):
			result = Some(entry.def_id)
			break

	result


private pure func definition_module_add_source_definition_id(
	build: DefinitionModuleBuildState,
	key: SourceDefinitionKey,
) -> DefinitionModuleBuildState:
	name = source_definition_key_name(key)
	entry: SourceDefinitionIdEntry = {
		key = key,
		def_id = build.next_def_id
	}
	{ build |
		source_definition_ids_by_name = build.source_definition_ids_by_name.set(
			name,
			build.source_definition_ids_by_name
				.get_or(name, [])
				.append(entry),
		),
		next_def_id = build.next_def_id + 1,
		added_source_count = build.added_source_count + 1
	}


private pure func definition_index_rep_find_func_callable_id(
	index: DefinitionIndexRep,
	key: FuncCallableKey,
) -> Option[Int]:
	var result: Option[Int] = None
	module_bucket = module_identity_display_name(func_callable_key_module_identity(key))
	name = func_callable_key_name(key)
	entries = index.func_callable_ids_by_module_bucket_and_name
		.get_or(module_bucket, {})
		.get_or(name, [])

	-- Display name and declaration name are only search accelerators. Exact
	-- equality keeps direct-module collisions and overloads distinct.
	for entry in entries:
		if func_callable_keys_equal(entry.key, key):
			result = Some(entry.def_id)
			break

	result


private pure func definition_index_binding_conflict(
	index: DefinitionIndexRep,
	key: DefinitionIndexBindingKey,
	existing_id: Option[Int],
	def_id: Int,
) -> Option[DefinitionIndexConflict]:
	match existing_id:
		Some(existing_id):
			if existing_id == def_id:
				None
			else:
				Some(DefinitionKeyAlreadyAssigned(key, existing_id, def_id))
		None:
			if def_id < index.next_def_id:
				Some(DefinitionIdBelowAllocationFrontier(def_id, index.next_def_id, key))
			else:
				None


private pure func definition_index_add_func_callable_id(
	index: DefinitionIndexRep,
	key: FuncCallableKey,
	def_id: Int,
) -> DefinitionIndexRep:
	entry: FuncCallableIdEntry = {
		key = key,
		def_id = def_id
	}
	module_bucket = module_identity_display_name(func_callable_key_module_identity(key))
	name = func_callable_key_name(key)
	name_buckets = index.func_callable_ids_by_module_bucket_and_name.get_or(module_bucket, {})
	{ index |
		func_callable_ids_by_module_bucket_and_name = index.func_callable_ids_by_module_bucket_and_name.set(
			module_bucket,
			name_buckets.set(
				name,
				name_buckets
					.get_or(name, [])
					.append(entry),
			),
		),
		func_callable_id_count = index.func_callable_id_count + 1,
		next_def_id = definition_index_next_after_id(index, def_id)
	}


pure func definition_index_insert_func_callable_id(
	index: DefinitionIndex,
	key: FuncCallableKey,
	def_id: Int,
) -> Result[DefinitionIndex, DefinitionIndexConflict]:
	representation: DefinitionIndexRep = from DefinitionIndex(index)
	binding_key = FuncCallableBindingKey(key)
	existing_id = definition_index_rep_find_func_callable_id(representation, key)

	match definition_index_binding_conflict(representation, binding_key, existing_id, def_id):
		Some(conflict):
			Err(conflict)
		None:
			match existing_id:
				Some(_):
					Ok(index)
				None:
					updated = definition_index_add_func_callable_id(representation, key, def_id)
					Ok(into DefinitionIndex(updated))


pure func definition_index_find_func_callable_id(
	index: DefinitionIndex,
	key: FuncCallableKey,
) -> Option[Int]:
	representation: DefinitionIndexRep = from DefinitionIndex(index)
	definition_index_rep_find_func_callable_id(representation, key)


pure func definition_index_func_callable_bindings(
	index: DefinitionIndex,
	name: String,
) -> List[(FuncCallableKey, Int)]:
	representation: DefinitionIndexRep = from DefinitionIndex(index)
	var bindings: List[(FuncCallableKey, Int)] = []

	for name_buckets in representation.func_callable_ids_by_module_bucket_and_name.values():
		for entry in name_buckets.get_or(name, []):
			bindings = bindings.append((entry.key, entry.def_id))

	bindings.sort_by(func(binding): binding[1])


-- Deterministic complete projection for validation, diagnostics, and tooling.
-- Semantic lookup remains encapsulated by DefinitionIndex.
pure func definition_index_all_func_callable_bindings(
	index: DefinitionIndex,
) -> List[(FuncCallableKey, Int)]:
	representation: DefinitionIndexRep = from DefinitionIndex(index)
	var bindings: List[(FuncCallableKey, Int)] = []

	for name_buckets in representation.func_callable_ids_by_module_bucket_and_name.values():
		for entries in name_buckets.values():
			for entry in entries:
				bindings = bindings.append((entry.key, entry.def_id))

	bindings.sort_by(func(binding): binding[1])


pure func definition_index_func_callables_at_span(
	index: DefinitionIndex,
	module_identity: ModuleIdentity,
	span: SourceSpan,
) -> List[(FuncCallableKey, Int)]:
	representation: DefinitionIndexRep = from DefinitionIndex(index)
	module_bucket = module_identity_display_name(module_identity)
	var bindings: List[(FuncCallableKey, Int)] = []

	for entries in (
		representation.func_callable_ids_by_module_bucket_and_name
			.get_or(module_bucket, {})
			.values()
	):
		for entry in entries:
			if (
				module_identities_equal(
					func_callable_key_module_identity(entry.key),
					module_identity,
				)
				and source_spans_equal(func_callable_key_span(entry.key), span)
			):
				bindings = bindings.append((entry.key, entry.def_id))

	bindings.sort_by(func(binding): binding[1])


private pure func definition_index_rep_find_source_definition_id(
	index: DefinitionIndexRep,
	key: SourceDefinitionKey,
) -> Option[Int]:
	var result: Option[Int] = None
	module_bucket = module_identity_display_name(source_definition_key_module_identity(key))
	name = source_definition_key_name(key)
	entries = index.source_definition_ids_by_module_bucket_and_name
		.get_or(module_bucket, {})
		.get_or(name, [])

	for entry in entries:
		if source_definition_keys_equal(entry.key, key):
			result = Some(entry.def_id)
			break

	result


private pure func definition_index_add_source_definition_id(
	index: DefinitionIndexRep,
	key: SourceDefinitionKey,
	def_id: Int,
) -> DefinitionIndexRep:
	entry: SourceDefinitionIdEntry = {
		key = key,
		def_id = def_id
	}
	module_bucket = module_identity_display_name(source_definition_key_module_identity(key))
	name = source_definition_key_name(key)
	name_buckets = index.source_definition_ids_by_module_bucket_and_name.get_or(module_bucket, {})
	{ index |
		source_definition_ids_by_module_bucket_and_name = index.source_definition_ids_by_module_bucket_and_name.set(
			module_bucket,
			name_buckets.set(
				name,
				name_buckets
					.get_or(name, [])
					.append(entry),
			),
		),
		source_definition_id_count = index.source_definition_id_count + 1,
		next_def_id = definition_index_next_after_id(index, def_id)
	}


pure func definition_index_insert_source_definition_id(
	index: DefinitionIndex,
	key: SourceDefinitionKey,
	def_id: Int,
) -> Result[DefinitionIndex, DefinitionIndexConflict]:
	representation: DefinitionIndexRep = from DefinitionIndex(index)
	binding_key = SourceDefinitionBindingKey(key)
	existing_id = definition_index_rep_find_source_definition_id(representation, key)

	match definition_index_binding_conflict(representation, binding_key, existing_id, def_id):
		Some(conflict):
			Err(conflict)
		None:
			match existing_id:
				Some(_):
					Ok(index)
				None:
					updated = definition_index_add_source_definition_id(representation, key, def_id)
					Ok(into DefinitionIndex(updated))


pure func definition_index_find_source_definition_id(
	index: DefinitionIndex,
	key: SourceDefinitionKey,
) -> Option[Int]:
	representation: DefinitionIndexRep = from DefinitionIndex(index)
	definition_index_rep_find_source_definition_id(representation, key)


pure func definition_index_source_definition_bindings(
	index: DefinitionIndex,
	name: String,
) -> List[(SourceDefinitionKey, Int)]:
	representation: DefinitionIndexRep = from DefinitionIndex(index)
	var bindings: List[(SourceDefinitionKey, Int)] = []

	for name_buckets in representation.source_definition_ids_by_module_bucket_and_name.values():
		for entry in name_buckets.get_or(name, []):
			bindings = bindings.append((entry.key, entry.def_id))

	bindings.sort_by(func(binding): binding[1])


-- Deterministic complete projection for validation, diagnostics, and tooling.
-- Semantic lookup remains encapsulated by DefinitionIndex.
pure func definition_index_all_source_definition_bindings(
	index: DefinitionIndex,
) -> List[(SourceDefinitionKey, Int)]:
	representation: DefinitionIndexRep = from DefinitionIndex(index)
	var bindings: List[(SourceDefinitionKey, Int)] = []

	for name_buckets in representation.source_definition_ids_by_module_bucket_and_name.values():
		for entries in name_buckets.values():
			for entry in entries:
				bindings = bindings.append((entry.key, entry.def_id))

	bindings.sort_by(func(binding): binding[1])


pure func definition_index_func_callable_id_count(index: DefinitionIndex) -> Int:
	representation: DefinitionIndexRep = from DefinitionIndex(index)
	representation.func_callable_id_count


pure func definition_index_source_definition_id_count(index: DefinitionIndex) -> Int:
	representation: DefinitionIndexRep = from DefinitionIndex(index)
	representation.source_definition_id_count


pure func definition_index_next_def_id(index: DefinitionIndex) -> Int:
	representation: DefinitionIndexRep = from DefinitionIndex(index)
	representation.next_def_id


pure func definition_index_advance_to_env(index: DefinitionIndex, env: Env) -> DefinitionIndex:
	representation: DefinitionIndexRep = from DefinitionIndex(index)

	if env.next_def_id <= representation.next_def_id:
		index
	else:
		into DefinitionIndex({ representation | next_def_id = env.next_def_id })


private pure func definition_index_reserve_function(
	build: DefinitionModuleBuildState,
	module_identity: ModuleIdentity,
	name: String,
	span: SourceSpan,
) -> DefinitionModuleBuildState:
	key = func_callable_key(module_identity, name, span)

	match definition_module_find_func_callable_id(build, key):
		Some(_):
			build
		None:
			definition_module_add_func_callable_id(build, key)


private pure func definition_index_reserve_source(
	build: DefinitionModuleBuildState,
	key: SourceDefinitionKey,
) -> DefinitionModuleBuildState:
	match definition_module_find_source_definition_id(build, key):
		Some(_):
			build
		None:
			definition_module_add_source_definition_id(build, key)


private pure func graph_trait_defaults_in_decl(
	defaults: List[TraitDefaultMethods],
	module_identity: ModuleIdentity,
	canonical_path: String,
	module_kind: TraitDefaultsModuleKind,
	decl: ParsedDecl,
) -> List[TraitDefaultMethods]:
	match decl:
		TraitParsedDecl(trait_decl):
			defaults.append({
				module_identity = module_identity,
				canonical_path = canonical_path,
				module_kind = module_kind,
				trait_name = trait_decl.name.text,
				method_names = trait_decl.methods
					.filter(func(method): method.body.is_some())
					.map(func(method): method.name.text),
			})
		PrivateParsedDecl(inner, _):
			graph_trait_defaults_in_decl(
				defaults,
				module_identity,
				canonical_path,
				module_kind,
				inner,
			)
		_:
			defaults


private pure func graph_trait_defaults_in_module(
	defaults: List[TraitDefaultMethods],
	module: LoadedModule,
) -> List[TraitDefaultMethods]:
	module_identity = loaded_module_identity(module)
	canonical_path = loaded_module_canonical_path(module)
	program = loaded_module_program(module)

	module_kind = if prelude_traits_module_matches(
		loaded_module_origin(module),
		canonical_path,
		program.source.module_name,
	):
		PreludeTraitDefaultsModule
	else:
		OrdinaryTraitDefaultsModule

	var result = defaults

	for decl in program.decls:
		result = graph_trait_defaults_in_decl(
			result,
			module_identity,
			canonical_path,
			module_kind,
			decl,
		)

	result


private pure func graph_trait_defaults_for_modules(
	target: LoadedModule,
	modules: List[LoadedModule],
) -> List[TraitDefaultMethods]:
	var defaults = graph_trait_defaults_in_module([], target)

	for module in modules:
		defaults = graph_trait_defaults_in_module(defaults, module)

	defaults


private pure func graph_local_trait_default_methods(
	defaults: List[TraitDefaultMethods],
	module_identity: ModuleIdentity,
	trait_name: String,
) -> Option[List[String]]:
	var result: Option[List[String]] = None

	for trait_defaults in defaults:
		if (
			module_identities_equal(trait_defaults.module_identity, module_identity)
			and trait_defaults.trait_name == trait_name
		):
			result = Some(trait_defaults.method_names)
			break

	result


private pure func graph_import_symbol_local_name(symbol: ParsedImportSymbol) -> String:
	match symbol.symbol_alias:
		Some(alias_name):
			alias_name.text
		None:
			symbol.name.text


private pure func graph_imported_trait_reference_in_import(
	import_decl: ParsedImportDecl,
	visible_name: String,
) -> Option[ImportedTraitReference]:
	match import_decl.symbols:
		None:
			None
		Some(symbols):
			var result: Option[ImportedTraitReference] = None

			for symbol in symbols:
				if graph_import_symbol_local_name(symbol) == visible_name:
					result = Some({
						canonical_path = import_decl.module_path,
						trait_name = symbol.name.text,
					})
					break

			result


private pure func graph_imported_trait_reference_in_decl(
	decl: ParsedDecl,
	visible_name: String,
) -> Option[ImportedTraitReference]:
	match decl:
		ImportBlockParsedDecl(imports, _):
			var result: Option[ImportedTraitReference] = None

			for import_decl in imports:
				match graph_imported_trait_reference_in_import(import_decl, visible_name):
					Some(reference):
						result = Some(reference)
						break
					None:
						void

			result
		PrivateParsedDecl(inner, _):
			graph_imported_trait_reference_in_decl(inner, visible_name)
		_:
			None


private pure func graph_imported_trait_reference(
	program: ParsedProgram,
	visible_name: String,
) -> Option[ImportedTraitReference]:
	var result: Option[ImportedTraitReference] = None

	for decl in program.decls:
		match graph_imported_trait_reference_in_decl(decl, visible_name):
			Some(reference):
				result = Some(reference)
				break
			None:
				void

	result


private pure func graph_imported_trait_default_methods(
	defaults: List[TraitDefaultMethods],
	reference: ImportedTraitReference,
) -> Option[List[String]]:
	var result: Option[List[String]] = None

	for trait_defaults in defaults:
		if (
			trait_defaults.canonical_path == reference.canonical_path
			and trait_defaults.trait_name == reference.trait_name
		):
			result = Some(trait_defaults.method_names)
			break

	result


private pure func graph_prelude_trait_default_methods(
	defaults: List[TraitDefaultMethods],
	trait_name: String,
) -> Option[List[String]]:
	var result: Option[List[String]] = None

	if builtin_trait_is_prelude(trait_name):
		for trait_defaults in defaults:
			match trait_defaults.module_kind:
				PreludeTraitDefaultsModule:
					if trait_defaults.trait_name == trait_name:
						result = Some(trait_defaults.method_names)
						break
				OrdinaryTraitDefaultsModule:
					void

	result


private pure func graph_default_method_names_for_impl(
	defaults: List[TraitDefaultMethods],
	module_identity: ModuleIdentity,
	program: ParsedProgram,
	impl_decl: ParsedImplDecl,
) -> List[String]:
	trait_name = impl_decl.trait_name.text

	method_names = match graph_local_trait_default_methods(defaults, module_identity, trait_name):
		Some(local_methods):
			local_methods
		None:
			match graph_imported_trait_reference(program, trait_name):
				Some(reference):
					graph_imported_trait_default_methods(defaults, reference).get_or([])
				None:
					graph_prelude_trait_default_methods(defaults, trait_name).get_or([])

	method_names.filter(
		func(
			method_name,
		): not impl_decl.methods.any(func(method): method.name.text == method_name),
	)


private pure func definition_index_reserve_decl(
	build: DefinitionModuleBuildState,
	module_identity: ModuleIdentity,
	trait_defaults: List[TraitDefaultMethods],
	program: ParsedProgram,
	decl: ParsedDecl,
) -> DefinitionModuleBuildState:
	match decl:
		FunctionParsedDecl(function_decl):
			definition_index_reserve_function(
				build,
				module_identity,
				function_decl.name.text,
				function_decl.span,
			)
		ForeignBlockParsedDecl(_, functions, _):
			var result = build

			for function_decl in functions:
				result = definition_index_reserve_function(
					result,
					module_identity,
					function_decl.name.text,
					function_decl.span,
				)

			result
		UnionParsedDecl(union_decl):
			var with_variants = definition_index_reserve_source(
				build,
				source_definition_key(
					module_identity,
					TypeDefinition,
					union_decl.name.text,
					None,
					union_decl.span,
				),
			)

			for variant in union_decl.variants:
				with_variants = definition_index_reserve_source(
					with_variants,
					source_definition_key(
						module_identity,
						ConstructorDefinition,
						variant.name.text,
						Some(union_decl.name.text),
						variant.span,
					),
				)

			with_variants
		RecordParsedDecl(record_decl):
			var result = definition_index_reserve_source(
				build,
				source_definition_key(
					module_identity,
					TypeDefinition,
					record_decl.name.text,
					None,
					record_decl.span,
				),
			)

			for field in record_decl.fields:
				result = definition_index_reserve_source(
					result,
					source_definition_key(
						module_identity,
						FieldDefinition,
						field.name.text,
						Some(record_decl.name.text),
						field.span,
					),
				)

			result
		BuiltinTypeParsedDecl(type_decl):
			definition_index_reserve_source(
				build,
				source_definition_key(
					module_identity,
					TypeDefinition,
					type_decl.name.text,
					None,
					type_decl.span,
				),
			)
		TypeAliasParsedDecl(alias_decl):
			definition_index_reserve_source(
				build,
				source_definition_key(
					module_identity,
					TypeDefinition,
					alias_decl.name.text,
					None,
					alias_decl.span,
				),
			)
		TraitParsedDecl(trait_decl):
			definition_index_reserve_source(
				build,
				source_definition_key(
					module_identity,
					TraitDefinition,
					trait_decl.name.text,
					None,
					trait_decl.span,
				),
			)
		ImplParsedDecl(impl_decl):
			with_impl = definition_index_reserve_source(
				build,
				source_definition_key(
					module_identity,
					ImplDefinition,
					impl_decl.trait_name.text,
					None,
					impl_decl.span,
				),
			)
			var result = with_impl

			for method_name in graph_default_method_names_for_impl(
				trait_defaults,
				module_identity,
				program,
				impl_decl,
			):
				result = definition_index_reserve_function(
					result,
					module_identity,
					method_name,
					impl_decl.span,
				)

			for method in impl_decl.methods:
				result = definition_index_reserve_function(
					result,
					module_identity,
					method.name.text,
					method.span,
				)

			result
		VarParsedDecl(var_decl):
			definition_index_reserve_source(
				build,
				source_definition_key(
					module_identity,
					GlobalDefinition,
					var_decl.name.text,
					None,
					var_decl.span,
				),
			)
		PrivateParsedDecl(inner, _):
			definition_index_reserve_decl(build, module_identity, trait_defaults, program, inner)
		_:
			build


private pure func definition_index_reserve_program(
	index: DefinitionIndexRep,
	module_identity: ModuleIdentity,
	trait_defaults: List[TraitDefaultMethods],
	program: ParsedProgram,
) -> DefinitionIndexRep:
	module_bucket = module_identity_display_name(module_identity)
	var build = definition_index_module_build_state(index, module_bucket)

	for decl in program.decls:
		build = definition_index_reserve_decl(build, module_identity, trait_defaults, program, decl)

	definition_index_commit_module_build(index, build)


pure func definition_index_for_loaded_modules(
	seed: DefinitionIndexSeed,
	loaded_modules: LoadedModuleSet,
) -> DefinitionIndex:
	target = loaded_module_set_target(loaded_modules)
	modules = loaded_module_set_modules(
		loaded_modules,
	).sort_by(
		func(module): loaded_module_canonical_path(module),
	)
	target_program = loaded_module_program(target)
	trait_defaults = graph_trait_defaults_for_modules(target, modules)
	var index = definition_index_reserve_program(
		definition_index_rep_empty(seed),
		loaded_module_identity(target),
		trait_defaults,
		target_program,
	)

	for module in modules:
		index = definition_index_reserve_program(
			index,
			loaded_module_identity(module),
			trait_defaults,
			loaded_module_program(module),
		)

	into DefinitionIndex(index)
