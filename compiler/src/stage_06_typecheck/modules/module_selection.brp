-- Module-selection orchestration for Blorp-owned typechecking.
import:
	../../stage_03_parse/parsed_ast: ParsedProgram
	module_binding: ImportableModule, ImportableModuleIndex
	module_visibility:
		importable_modules_for_program,
		reachable_importable_modules,
		with_ambient_impl_modules,


pure func visible_importable_modules_for_program(
	program_with_prelude: ParsedProgram,
	index: ImportableModuleIndex,
	current_module_path: Option[String],
) -> List[ImportableModule]:
	with_ambient_impl_modules(
		reachable_importable_modules(program_with_prelude, index, current_module_path),
		index,
		current_module_path,
	)


pure func direct_importable_modules_for_program(
	program_with_prelude: ParsedProgram,
	index: ImportableModuleIndex,
	current_module_path: Option[String],
) -> List[ImportableModule]:
	with_ambient_impl_modules(
		importable_modules_for_program(index, program_with_prelude, current_module_path),
		index,
		current_module_path,
	)
