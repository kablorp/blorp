-- Prelude import projection for Blorp-owned typechecking.
--
-- Prelude declarations are compiler-provided source imports. This module
-- merges them with user imports while preserving explicit user aliases and
-- local declarations.
import:
	../../stage_03_parse/parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImportBlockParsedDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedImportDecl,
		ParsedImportSymbol,
		ParsedProgram,
	../state: TypecheckState, typecheck_state_is_stdlib
	module_binding: ImportableModuleIndex, importable_module_decls, importable_module_index_prelude
	module_visibility:
		ImportIdentityResolution(ImportIdentityFound),
		matching_import_identities,
		program_import_identities,
		resolve_import_identity,
	set as Sets


private pure func local_top_level_names_for_decl(decl: ParsedDecl) -> List[String]:
	match decl:
		FunctionParsedDecl(function_decl):
			[function_decl.name.text]
		VarParsedDecl(var_decl):
			[var_decl.name.text]
		RecordParsedDecl(record_decl):
			[record_decl.name.text]
		UnionParsedDecl(union_decl):
			var names: List[String] = [union_decl.name.text]

			for variant in union_decl.variants:
				names = names.append(variant.name.text)

			names
		BuiltinTypeParsedDecl(type_decl):
			[type_decl.name.text]
		TypeAliasParsedDecl(alias_decl):
			[alias_decl.name.text]
		TraitParsedDecl(trait_decl):
			[trait_decl.name.text]
		ForeignBlockParsedDecl(_, functions, _):
			var names: List[String] = []

			for function_decl in functions:
				names = names.append(function_decl.name.text)

			names
		PrivateParsedDecl(inner, _):
			local_top_level_names_for_decl(inner)
		_:
			[]


private pure func import_symbol_local_name(symbol: ParsedImportSymbol) -> String:
	match symbol.symbol_alias:
		Some(alias_name):
			alias_name.text
		None:
			symbol.name.text


private pure func prelude_import_without_local_conflicts(
	import_decl: ParsedImportDecl,
	local_names: Set[String],
) -> Option[ParsedImportDecl]:
	match import_decl.symbols:
		Some(symbols):
			var filtered: List[ParsedImportSymbol] = []

			for symbol in symbols:
				if not Sets.contains(local_names, import_symbol_local_name(symbol)):
					filtered = filtered.append(symbol)

			if filtered.length() == 0:
				None
			else:
				Some({ import_decl | symbols = Some(filtered) })
		None:
			Some(import_decl)


private pure func prelude_import_decls(
	index: ImportableModuleIndex,
	local_names: Set[String],
) -> List[ParsedDecl]:
	var result: List[ParsedDecl] = []

	match importable_module_index_prelude(index):
		Some(module):
			for decl in importable_module_decls(module):
				match decl:
					ImportBlockParsedDecl(imports, span):
						var filtered_imports: List[ParsedImportDecl] = []

						for import_decl in imports:
							match prelude_import_without_local_conflicts(import_decl, local_names):
								Some(filtered):
									filtered_imports = filtered_imports.append(filtered)
								None:
									void

						if filtered_imports.length() > 0:
							result = result.append(ImportBlockParsedDecl(filtered_imports, span))
					PrivateParsedDecl(ImportBlockParsedDecl(imports, span), _):
						var filtered_imports: List[ParsedImportDecl] = []

						for import_decl in imports:
							match prelude_import_without_local_conflicts(import_decl, local_names):
								Some(filtered):
									filtered_imports = filtered_imports.append(filtered)
								None:
									void

						if filtered_imports.length() > 0:
							result = result.append(ImportBlockParsedDecl(filtered_imports, span))
					_:
						void
		None:
			void

	result


private pure func program_current_import_identities(
	state: TypecheckState,
	program: ParsedProgram,
) -> List[String]:
	module_name: String = program.source.module_name
	var identities: List[String] = [module_name]

	if typecheck_state_is_stdlib(state):
		if module_name.starts_with("std/"):
			identities = identities.append(module_name.substring(4, module_name.length() - 4))
		else:
			identities = identities.append("std/" + module_name)

	identities


private pure func string_set(names: List[String]) -> Set[String]:
	var result: Set[String] = Sets.set()

	for name in names:
		result = Sets.add(result, name)

	result


private pure func prelude_symbols_for_identity(
	index: ImportableModuleIndex,
	prelude_decls: List[ParsedDecl],
	module_identity: String,
) -> List[ParsedImportSymbol]:
	var result: List[ParsedImportSymbol] = []
	var seen: Set[String] = Sets.set()

	for decl in prelude_decls:
		match decl:
			ImportBlockParsedDecl(imports, _):
				for import_decl in imports:
					if matching_import_identities(
						index,
						import_decl.module_path,
					).contains(module_identity):
						match import_decl.symbols:
							Some(symbols):
								for symbol in symbols:
									if not Sets.contains(seen, symbol.name.text):
										result = result.append(symbol)
										seen = Sets.add(seen, symbol.name.text)
							None:
								void
			_:
				void

	result


private pure func merge_prelude_import_symbols(
	index: ImportableModuleIndex,
	prelude_decls: List[ParsedDecl],
	import_decl: ParsedImportDecl,
) -> ParsedImportDecl:
	match import_decl.symbols:
		Some(user_symbols):
			module_identity = resolve_import_identity(index, import_decl.module_path)

			prelude_symbols: List[ParsedImportSymbol] = match module_identity:
				ImportIdentityFound(identity):
					prelude_symbols_for_identity(index, prelude_decls, identity)
				_:
					[]

			var merged: List[ParsedImportSymbol] = user_symbols
			var seen: Set[String] = string_set(user_symbols.map(
				func(symbol): symbol.name.text,
			))

			for symbol in prelude_symbols:
				if not Sets.contains(seen, symbol.name.text):
					merged = merged.append(symbol)
					seen = Sets.add(seen, symbol.name.text)

			if merged.length() == user_symbols.length():
				import_decl
			else:
				{ import_decl | symbols = Some(merged) }
		None:
			import_decl


private pure func merge_prelude_imports_into_decl(
	index: ImportableModuleIndex,
	prelude_decls: List[ParsedDecl],
	decl: ParsedDecl,
) -> ParsedDecl:
	match decl:
		ImportBlockParsedDecl(imports, span):
			ImportBlockParsedDecl(
				imports.map(
					func(
						import_decl,
					): merge_prelude_import_symbols(index, prelude_decls, import_decl),
				),
				span,
			)
		PrivateParsedDecl(ImportBlockParsedDecl(imports, span), private_span):
			PrivateParsedDecl(
				ImportBlockParsedDecl(
					imports.map(
						func(
							import_decl,
						): merge_prelude_import_symbols(index, prelude_decls, import_decl),
					),
					span,
				),
				private_span,
			)
		_:
			decl


private pure func filter_prelude_import_decls_for_missing_modules(
	index: ImportableModuleIndex,
	user_identities: Set[String],
	prelude_decls: List[ParsedDecl],
) -> List[ParsedDecl]:
	var result: List[ParsedDecl] = []

	for decl in prelude_decls:
		match decl:
			ImportBlockParsedDecl(imports, span):
				var filtered: List[ParsedImportDecl] = []

				for import_decl in imports:
					module_identities = matching_import_identities(index, import_decl.module_path)

					if not module_identities.any(
						func(identity): Sets.contains(user_identities, identity),
					):
						filtered = filtered.append(import_decl)

				if filtered.length() > 0:
					result = result.append(ImportBlockParsedDecl(filtered, span))
			_:
				void

	result


pure func program_with_prelude_imports(
	state: TypecheckState,
	program: ParsedProgram,
	index: ImportableModuleIndex,
) -> ParsedProgram:
	if program.source.module_name == "prelude" or program.source.module_name == "std/prelude":
		program
	else:
		local_names: List[String] = program.decls.flat_map(
			func(decl): local_top_level_names_for_decl(decl),
		)
		prelude_decls: List[ParsedDecl] = prelude_import_decls(index, string_set(local_names))

		if prelude_decls.length() == 0:
			program
		else:
			user_identities: List[String] = program_import_identities(
				index,
				program,
			).concat(program_current_import_identities(state, program))
			prepend_decls: List[ParsedDecl] = filter_prelude_import_decls_for_missing_modules(
				index,
				string_set(user_identities),
				prelude_decls,
			)
			merged_decls: List[ParsedDecl] = program.decls.map(
				func(decl): merge_prelude_imports_into_decl(index, prelude_decls, decl),
			)

			{
				source = program.source,
				decls = prepend_decls.concat(merged_decls),
				diagnostics = program.diagnostics
			}
