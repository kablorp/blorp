-- Low-overhead structural counts for diagnosing retained typecheck programs.
--
-- These counts deliberately describe logical AST size rather than allocator
-- bytes. They are only called by the opt-in typecheck inventory path.
import:
	decl:
		TypedDecl(
			TypedForeignFunctionDecl,
			TypedFunctionDecl,
			TypedGlobalVarDecl,
			TypedImplDecl,
			TypedParsedDecl,
			TypedPrivateDecl,
			TypedRecordDecl,
			TypedTraitDecl,
			TypedTypeAliasDecl,
			TypedUnionDecl,
		),
		TypedProgram,
	infer:
		TypedExpr(
			TypedAscriptionExpr,
			TypedAssignExpr,
			TypedBinaryExpr,
			TypedBlockExpr,
			TypedBoolLiteralExpr,
			TypedBreakExpr,
			TypedBuiltinExpr,
			TypedCallExpr,
			TypedCharLiteralExpr,
			TypedConcurrentBlockExpr,
			TypedConcurrentForExpr,
			TypedContinueExpr,
			TypedDebugBlockExpr,
			TypedDetachExpr,
			TypedDictExpr,
			TypedFieldAccessExpr,
			TypedFloatLiteralExpr,
			TypedForExpr,
			TypedIfExpr,
			TypedIntLiteralExpr,
			TypedLambdaExpr,
			TypedListExpr,
			TypedLogicalExpr,
			TypedMatchExpr,
			TypedMissingExpr,
			TypedNameExpr,
			TypedOpaqueFromExpr,
			TypedOpaqueIntoExpr,
			TypedQuestionBindExpr,
			TypedRangeExpr,
			TypedRecordExpr,
			TypedRecordUpdateExpr,
			TypedSelectExpr,
			TypedStringInterpolationExpr,
			TypedStringInterpolationPartsExpr,
			TypedStringLiteralExpr,
			TypedSubscriptAssignExpr,
			TypedSubscriptExpr,
			TypedTupleDestructExpr,
			TypedTupleExpr,
			TypedUnaryExpr,
			TypedUnsupportedExpr,
			TypedVarDeclExpr,
			TypedVectorExpr,
			TypedVoidExpr,
			TypedWhileExpr,
			TypedWithExpr,
		),
		TypedSelectArmKind(TypedSelectAfterArm, TypedSelectReceiveArm, TypedSelectSealedArm),
		TypedStringInterpolationPart(TypedInterpolationExpr, TypedInterpolationLiteral),


record TypedProgramInventory {
	source_bytes: Int,
	typed_decls: Int,
	typed_expr_nodes: Int
}


private pure func optional_typed_expr_node_count(expr: Option[TypedExpr]) -> Int:
	match expr:
		Some(value):
			typed_expr_node_count(value)
		None:
			0


private pure func typed_expr_list_node_count(items: List[TypedExpr]) -> Int:
	var result: Int = 0

	for item in items:
		result += typed_expr_node_count(item)

	result


pure func typed_expr_node_count(expr: TypedExpr) -> Int:
	match expr:
		TypedNameExpr(_, _):
			1
		TypedIntLiteralExpr(_, _, _):
			1
		TypedFloatLiteralExpr(_, _, _):
			1
		TypedStringLiteralExpr(_, _, _):
			1
		TypedStringInterpolationExpr(_, _, _, _):
			1
		TypedStringInterpolationPartsExpr(parts, _, _, _):
			var result: Int = 1

			for part in parts:
				match part:
					TypedInterpolationExpr(value):
						result += typed_expr_node_count(value)
					TypedInterpolationLiteral(_):
						void

			result
		TypedBoolLiteralExpr(_, _, _):
			1
		TypedCharLiteralExpr(_, _, _):
			1
		TypedUnaryExpr(_, inner, _, _):
			1 + typed_expr_node_count(inner)
		TypedBinaryExpr(_, left, right, _, _):
			1 + typed_expr_node_count(left) + typed_expr_node_count(right)
		TypedLogicalExpr(_, left, right, _, _):
			1 + typed_expr_node_count(left) + typed_expr_node_count(right)
		TypedCallExpr(callee, args, _, _):
			1 + typed_expr_node_count(callee) + typed_expr_list_node_count(args)
		TypedTupleExpr(items, _, _):
			1 + typed_expr_list_node_count(items)
		TypedTupleDestructExpr(_, value, _, _):
			1 + typed_expr_node_count(value)
		TypedAssignExpr(_, _, value, _, _):
			1 + typed_expr_node_count(value)
		TypedSubscriptExpr(receiver, indices, _, _):
			1 + typed_expr_node_count(receiver) + typed_expr_list_node_count(indices)
		TypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
			1 + typed_expr_node_count(
				receiver,
			) + typed_expr_list_node_count(indices) + typed_expr_node_count(value)
		TypedListExpr(items, _, _):
			1 + typed_expr_list_node_count(items)
		TypedVectorExpr(items, _, _):
			1 + typed_expr_list_node_count(items)
		TypedDictExpr(entries, _, _):
			var result: Int = 1

			for entry in entries:
				result += typed_expr_node_count(entry.key) + typed_expr_node_count(entry.value)

			result
		TypedOpaqueIntoExpr(_, inner, _, _):
			1 + typed_expr_node_count(inner)
		TypedOpaqueFromExpr(_, inner, _, _):
			1 + typed_expr_node_count(inner)
		TypedRecordExpr(fields, _, _):
			var result: Int = 1

			for field in fields:
				result += typed_expr_node_count(field.value)

			result
		TypedRecordUpdateExpr(receiver, fields, _, _, _):
			var result: Int = 1 + typed_expr_node_count(receiver)

			for field in fields:
				result += typed_expr_node_count(field.value)

			result
		TypedFieldAccessExpr(receiver, _, _, _):
			1 + typed_expr_node_count(receiver)
		TypedLambdaExpr(_, _, _, body, _, _):
			1 + typed_expr_node_count(body)
		TypedRangeExpr(start_expr, end_expr, _, _):
			1 + typed_expr_node_count(start_expr) + typed_expr_node_count(end_expr)
		TypedIfExpr(condition, then_branch, else_branch, _, _):
			1 + typed_expr_node_count(
				condition,
			) + typed_expr_node_count(then_branch) + optional_typed_expr_node_count(else_branch)
		TypedMatchExpr(scrutinee, cases, _, _):
			var result: Int = 1 + typed_expr_node_count(scrutinee)

			for case in cases:
				result += typed_expr_node_count(case.body)

			result
		TypedSelectExpr(arms, _, _):
			var result: Int = 1

			for arm in arms:
				match arm.kind:
					TypedSelectReceiveArm(_, _, channel):
						result += typed_expr_node_count(channel)
					TypedSelectSealedArm(_, channel):
						result += typed_expr_node_count(channel)
					TypedSelectAfterArm(timeout):
						result += typed_expr_node_count(timeout)

				result += typed_expr_node_count(arm.body)

			result
		TypedWhileExpr(condition, body, _, _):
			1 + typed_expr_node_count(condition) + typed_expr_node_count(body)
		TypedForExpr(_, iterable, _, body, _, _):
			1 + typed_expr_node_count(iterable) + typed_expr_node_count(body)
		TypedConcurrentBlockExpr(params, bindings, _, _):
			var result: Int = 1

			for param in params:
				result += typed_expr_node_count(param.value)

			for binding in bindings:
				result += typed_expr_node_count(binding.value)

			result
		TypedConcurrentForExpr(_, iterable, params, body, _, _):
			var result: Int = 1 + typed_expr_node_count(iterable)

			for param in params:
				result += typed_expr_node_count(param.value)

			result + typed_expr_node_count(body)
		TypedDetachExpr(body, _, _):
			1 + typed_expr_node_count(body)
		TypedAscriptionExpr(inner, _, _, _):
			1 + typed_expr_node_count(inner)
		TypedBlockExpr(items, _, _):
			1 + typed_expr_list_node_count(items)
		TypedWithExpr(binding, body, _, _):
			var result: Int = 1 + typed_expr_node_count(binding.value)

			match binding.error_map:
				Some(error_map):
					result += typed_expr_node_count(error_map.value)
				None:
					void

			result + typed_expr_node_count(body)
		TypedDebugBlockExpr(body, _, _):
			1 + typed_expr_node_count(body)
		TypedVarDeclExpr(payload, _):
			1 + typed_expr_node_count(payload.initializer)
		TypedQuestionBindExpr(_, _, value, _, _):
			1 + typed_expr_node_count(value)
		TypedBreakExpr(_, _):
			1
		TypedContinueExpr(_, _):
			1
		TypedVoidExpr(_, _):
			1
		TypedBuiltinExpr(_, _, _):
			1
		TypedMissingExpr(_, _):
			1
		TypedUnsupportedExpr(_, _, _):
			1


private pure func typed_decl_expr_node_count(decl: TypedDecl) -> Int:
	match decl:
		TypedFunctionDecl(info):
			optional_typed_expr_node_count(info.body)
		TypedForeignFunctionDecl(_):
			0
		TypedGlobalVarDecl(info):
			typed_expr_node_count(info.value)
		TypedRecordDecl(_):
			0
		TypedTypeAliasDecl(_):
			0
		TypedTraitDecl(_):
			0
		TypedUnionDecl(_):
			0
		TypedImplDecl(info):
			var result: Int = 0

			for method in info.methods:
				result += optional_typed_expr_node_count(method.body)

			result
		TypedPrivateDecl(inner):
			typed_decl_expr_node_count(inner)
		TypedParsedDecl(_):
			0


pure func typed_program_inventory(program: TypedProgram) -> TypedProgramInventory:
	var typed_expr_nodes: Int = 0

	for decl in program.decls:
		typed_expr_nodes += typed_decl_expr_node_count(decl)

	{
		source_bytes = program.source.text.length(),
		typed_decls = program.decls.length(),
		typed_expr_nodes = typed_expr_nodes
	}
