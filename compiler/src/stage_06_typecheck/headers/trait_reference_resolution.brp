-- Resolve a source-visible trait name to one exact declaration identity.
--
-- Local declarations shadow imports. Explicit selective imports shadow the
-- implicit prelude. Prelude fallback is restricted to compiler-known trait
-- names and the canonical std traits module, so unrelated short-name matches
-- cannot become semantic identities.
import:
	../../stage_05_types/builtins: prelude_traits_module_matches
	../graph/indexed_graph: prepared_module_scope_origin
	../modules/bound_module_graph:
		BoundModule,
		BoundModuleGraph,
		bound_module_canonical_path,
		bound_module_graph_find_canonical_path,
		bound_module_graph_modules,
		bound_module_graph_target,
		bound_module_identity,
		bound_module_program,
		bound_module_scope,
		bound_module_view,
	../modules/module_view: module_view_find_imported_name, module_view_find_local_name
	declaration_skeleton:
		DeclarationSkeletonGraph,
		TraitId,
		builtin_trait_id,
		declaration_skeleton_graph_find_trait,


private pure func trait_id_in_module(
	declaration_graph: DeclarationSkeletonGraph,
	module: BoundModule,
	name: String,
) -> Option[TraitId]:
	declaration_skeleton_graph_find_trait(
		declaration_graph,
		bound_module_identity(module),
		name,
	).map(
		func(info): info.id,
	)


private pure func trait_id_at_canonical_path(
	declaration_graph: DeclarationSkeletonGraph,
	bound_graph: BoundModuleGraph,
	module_path: String,
	name: String,
) -> Option[TraitId]:
	module ?= bound_module_graph_find_canonical_path(bound_graph, module_path)
	trait_id_in_module(declaration_graph, module, name)


private pure func module_is_prelude_traits(module: BoundModule) -> Bool:
	program = bound_module_program(module)
	prelude_traits_module_matches(
		prepared_module_scope_origin(bound_module_scope(module)),
		bound_module_canonical_path(module),
		program.source.module_name,
	)


private pure func prelude_trait_id(
	declaration_graph: DeclarationSkeletonGraph,
	bound_graph: BoundModuleGraph,
	name: String,
) -> Option[TraitId]:
	var result: Option[TraitId] = None
	builtin_id = builtin_trait_id(name)

	if builtin_id.is_some():
		target = bound_module_graph_target(bound_graph)

		if module_is_prelude_traits(target):
			result = trait_id_in_module(declaration_graph, target, name)

		if result.is_none():
			for module in bound_module_graph_modules(bound_graph):
				if module_is_prelude_traits(module):
					match trait_id_in_module(declaration_graph, module, name):
						Some(id):
							result = Some(id)
							break
						None:
							void

	match result:
		Some(id):
			Some(id)
		None:
			builtin_id


pure func resolve_visible_trait_id(
	declaration_graph: DeclarationSkeletonGraph,
	bound_graph: BoundModuleGraph,
	module: BoundModule,
	name: String,
) -> Option[TraitId]:
	match trait_id_in_module(declaration_graph, module, name):
		Some(local):
			Some(local)
		None:
			view = bound_module_view(module)

			if module_view_find_local_name(view, name).is_some():
				None
			else:
				match module_view_find_imported_name(view, name):
					Some(binding):
						resolved = trait_id_at_canonical_path(
							declaration_graph,
							bound_graph,
							binding.module_path,
							binding.original_name,
						)

						match resolved:
							Some(id):
								Some(id)
							None:
								None
					None:
						prelude_trait_id(declaration_graph, bound_graph, name)
