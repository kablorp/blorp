-- Accepted global metadata is converted once by the graph owner, then indexed
-- here by exact definition identity and module-visible source spelling. This
-- module deliberately accepts compact inputs instead of importing decl.brp,
-- where CompletedGlobalHeaderGraph currently lives.
import:
	../../stage_04_modules/loaded_module:
		ModuleIdentity,
		module_identities_equal,
		module_identity_storage_key,
	../../stage_05_types/global_value_index:
		AcceptedGlobalValueBinding,
		AcceptedGlobalValueEntry,
		GLOBAL_VALUE_INDEX_EMPTY,
		GlobalValueIndex,
		accepted_global_definition_id_module_identity,
		global_value_binding,
		global_value_index_add_exact,
		global_value_index_add_module,
		global_value_index_add_visible,
		global_value_index_find_exact,
		global_value_index_find_module,
		global_value_index_set_visible,
	../modules/module_binding: import_default_alias
	../modules/module_view:
		ImportedNameBinding,
		ModuleView,
		module_view_find_module_alias,
		module_view_imported_modules,
		module_view_imported_names,
		module_view_module_aliases,
	declaration_skeleton: DeclarationVisibility(PublicDeclaration)


record GlobalValueProjectionInput {
	module_identity: ModuleIdentity,
	source_module_path: String,
	canonical_module_path: String,
	source_name: String,
	visibility: DeclarationVisibility,
	entry: AcceptedGlobalValueEntry
}


record GlobalValueProjectionModule {
	module_identity: ModuleIdentity,
	module_path: String,
	view: ModuleView
}


private record GlobalValueProjectionRep {
	canonical: GlobalValueIndex,
	indexes_by_module_identity_key: Dict[String, GlobalValueIndex]
}


record GlobalValueProjectionBuildMetrics {
	canonical_input_visits: Int,
	overlay_input_visits: Int
}


private record GlobalValueProjectionBuckets {
	canonical: GlobalValueIndex,
	inputs_by_owner_key: Dict[String, List[GlobalValueProjectionInput]],
	public_inputs_by_module_path: Dict[String, List[GlobalValueProjectionInput]]
}


opaque type GlobalValueProjection = GlobalValueProjectionRep


private pure func global_value_projection_rep(
	projection: GlobalValueProjection,
) -> GlobalValueProjectionRep:
	from GlobalValueProjection(projection)


private pure func global_input_buckets_source_order(
	buckets: Dict[String, List[GlobalValueProjectionInput]],
) -> Dict[String, List[GlobalValueProjectionInput]]:
	var ordered: Dict[String, List[GlobalValueProjectionInput]] = {}

	for key in buckets.keys():
		match buckets.get(key):
			Some(inputs):
				ordered = ordered.set(key, inputs.reverse())
			None:
				void

	ordered


private pure func canonical_index(
	inputs: List[GlobalValueProjectionInput],
) -> Result[GlobalValueProjectionBuckets, List[String]]:
	var index = GLOBAL_VALUE_INDEX_EMPTY
	var inputs_by_owner_key: Dict[String, List[GlobalValueProjectionInput]] = {}
	var public_inputs_by_module_path: Dict[String, List[GlobalValueProjectionInput]] = {}
	var errors: List[String] = []

	for input in inputs:
		if not module_identities_equal(
			input.module_identity,
			accepted_global_definition_id_module_identity(input.entry.definition_id),
		):
			errors = errors.append(
				"accepted global projection identity does not match its owner module",
			)
		else:
			owner_key = module_identity_storage_key(input.module_identity)

			owner_inputs: List[GlobalValueProjectionInput] = match inputs_by_owner_key.get(
				owner_key,
			):
				Some(found):
					found
				None:
					[]

			inputs_by_owner_key = inputs_by_owner_key.set(
				owner_key,
				[input].concat(owner_inputs),
			)

			match global_value_index_add_exact(index, input.entry):
				Some(next):
					index = next
				None:
					errors = errors.append(
						"duplicate accepted global definition projection for '" + input.source_name + "'",
					)

			if input.visibility == PublicDeclaration:
				prior: List[GlobalValueProjectionInput] = match public_inputs_by_module_path.get(
					input.canonical_module_path,
				):
					Some(found):
						found
					None:
						[]

				public_inputs_by_module_path = public_inputs_by_module_path.set(
					input.canonical_module_path,
					[input].concat(prior),
				)

				match global_value_index_add_module(
					index,
					input.canonical_module_path,
					input.source_name,
					global_value_binding(
						input.entry,
						input.entry.canonical_binding_type,
						input.canonical_module_path,
					),
				):
					Some(next):
						index = next
					None:
						errors = errors.append(
							"duplicate accepted global module projection for '" + input.source_name + "'",
						)

	if errors.is_empty():
		Ok({
			canonical = index,
			inputs_by_owner_key = global_input_buckets_source_order(inputs_by_owner_key),
			public_inputs_by_module_path = global_input_buckets_source_order(
				public_inputs_by_module_path,
			),
		})
	else:
		Err(errors)


private pure func add_local_globals(
	index: GlobalValueIndex,
	inputs: List[GlobalValueProjectionInput],
) -> Result[GlobalValueIndex, String]:
	var next = index
	var issue: Option[String] = None

	for input in inputs:
		if issue.is_none():
			match global_value_index_add_exact(next, input.entry):
				Some(with_exact):
					next = global_value_index_set_visible(
						with_exact,
						input.source_name,
						global_value_binding(
							input.entry,
							input.entry.source_binding_type,
							input.source_module_path,
						),
					)
				None:
					issue = Some(
						"duplicate accepted local global identity for '" + input.source_name + "'",
					)

	match issue:
		Some(message):
			Err(message)
		None:
			Ok(next)


private pure func add_imported_binding(
	index: GlobalValueIndex,
	canonical: GlobalValueIndex,
	binding: ImportedNameBinding,
) -> Result[GlobalValueIndex, String]:
	match global_value_index_find_module(canonical, binding.module_path, binding.original_name):
		None:
			-- ModuleView also contains imported types, constructors, callables,
			-- and traits. A non-global binding is intentionally ignored here.
			Ok(index)
		Some(global_binding):
			with_exact = match global_value_index_find_exact(
				index,
				global_binding.entry.definition_id,
			):
				Some(_):
					Some(index)
				None:
					global_value_index_add_exact(index, global_binding.entry)

			match with_exact:
				None:
					Err("duplicate accepted imported global identity")
				Some(exact_index):
					match global_value_index_add_visible(
						exact_index,
						binding.local_name,
						global_binding,
					):
						Some(next):
							Ok(next)
						None:
							Err(
								"duplicate accepted imported global projection for '" + binding.local_name + "'",
							)


private pure func module_has_qualified_alias(view: ModuleView, module_path: String) -> Bool:
	module_view_module_aliases(view).any(func(entry): entry[1] == module_path)


private pure func module_index(
	module: GlobalValueProjectionModule,
	local_inputs: List[GlobalValueProjectionInput],
	canonical: GlobalValueIndex,
	public_inputs_by_module_path: Dict[String, List[GlobalValueProjectionInput]],
) -> Result[GlobalValueIndex, String]:
	var index = GLOBAL_VALUE_INDEX_EMPTY
	var issue: Option[String] = None

	-- A default module alias is a direct bare import. Explicit non-default
	-- aliases remain qualified-only and therefore publish no source names.
	for imported_path in module_view_imported_modules(module.view):
		if issue.is_none() and module_has_qualified_alias(module.view, imported_path):
			match public_inputs_by_module_path.get(imported_path):
				Some(imported_inputs):
					for input in imported_inputs:
						if issue.is_none():
							match global_value_index_add_exact(index, input.entry):
								Some(with_exact):
									match global_value_index_add_module(
										with_exact,
										input.canonical_module_path,
										input.source_name,
										global_value_binding(
											input.entry,
											input.entry.canonical_binding_type,
											input.canonical_module_path,
										),
									):
										Some(with_module):
											index = with_module

											if module_view_find_module_alias(
												module.view,
												import_default_alias(
													imported_path,
												),
											) == Some(imported_path):
												match global_value_index_add_visible(
													index,
													input.source_name,
													global_value_binding(
														input.entry,
														input.entry.canonical_binding_type,
														input.canonical_module_path,
													),
												):
													Some(next):
														index = next
													None:
														issue = Some(
															"duplicate accepted bare global projection for '" + input.source_name + "'",
														)
										None:
											issue = Some(
												"duplicate accepted qualified global projection for '" + input.source_name + "'",
											)
								None:
									issue = Some(
										"duplicate accepted imported global identity for '" + input.source_name + "'",
									)
				None:
					void

	for binding in module_view_imported_names(module.view):
		if issue.is_none():
			match add_imported_binding(index, canonical, binding):
				Ok(next):
					index = next
				Err(message):
					issue = Some(message)

	if issue.is_none():
		match add_local_globals(index, local_inputs):
			Ok(with_locals):
				index = with_locals
			Err(message):
				issue = Some(message)

	match issue:
		Some(message):
			Err(message)
		None:
			Ok(index)


private pure func global_value_projection_from_buckets(
	buckets: GlobalValueProjectionBuckets,
	modules: List[GlobalValueProjectionModule],
) -> Result[GlobalValueProjection, List[String]]:
	var indexes: Dict[String, GlobalValueIndex] = {}
	var errors: List[String] = []

	for module in modules:
		key = module_identity_storage_key(module.module_identity)

		if indexes.contains(key):
			errors = errors.append("duplicate accepted global module projection")
		else:
			result = match buckets.inputs_by_owner_key.get(key):
				Some(local_inputs):
					module_index(
						module,
						local_inputs,
						buckets.canonical,
						buckets.public_inputs_by_module_path,
					)
				None:
					module_index(
						module,
						[],
						buckets.canonical,
						buckets.public_inputs_by_module_path,
					)

			match result:
				Ok(index):
					indexes = indexes.set(key, index)
				Err(message):
					errors = errors.append(message)

	if errors.is_empty():
		Ok(into GlobalValueProjection({
					canonical = buckets.canonical,
					indexes_by_module_identity_key = indexes
				}))
	else:
		Err(errors)


private pure func global_module_overlay_input_visits(
	module: GlobalValueProjectionModule,
	local_input_count: Int,
	buckets: GlobalValueProjectionBuckets,
) -> Int:
	var visits = local_input_count

	for imported_path in module_view_imported_modules(module.view):
		if module_has_qualified_alias(module.view, imported_path):
			match buckets.public_inputs_by_module_path.get(imported_path):
				Some(imported_inputs):
					visits += imported_inputs.length()
				None:
					void

	for binding in module_view_imported_names(module.view):
		if global_value_index_find_module(
			buckets.canonical,
			binding.module_path,
			binding.original_name,
		).is_some():
			visits += 1

	visits


pure func global_value_projection_build(
	inputs: List[GlobalValueProjectionInput],
	modules: List[GlobalValueProjectionModule],
) -> Result[GlobalValueProjection, List[String]]:
	buckets ?= canonical_index(inputs)
	global_value_projection_from_buckets(buckets, modules)


pure func global_value_projection_observe_build(
	inputs: List[GlobalValueProjectionInput],
	modules: List[GlobalValueProjectionModule],
) -> Result[GlobalValueProjectionBuildMetrics, List[String]]:
	buckets ?= canonical_index(inputs)

	match global_value_projection_from_buckets(buckets, modules):
		Err(errors):
			Err(errors)
		Ok(_):
			var overlay_input_visits: Int = 0

			for module in modules:
				key = module_identity_storage_key(module.module_identity)

				local_input_count = match buckets.inputs_by_owner_key.get(key):
					Some(local_inputs):
						local_inputs.length()
					None:
						0

				overlay_input_visits += global_module_overlay_input_visits(
					module,
					local_input_count,
					buckets,
				)

			Ok({
				canonical_input_visits = inputs.length(),
				overlay_input_visits = overlay_input_visits,
			})


pure func global_value_projection_find(
	projection: GlobalValueProjection,
	module_identity: ModuleIdentity,
) -> Result[GlobalValueIndex, String]:
	global_value_projection_rep(projection).indexes_by_module_identity_key
		.get(module_identity_storage_key(module_identity))
		.to_result("accepted global projection is missing a module identity")


pure func global_value_projection_find_qualified(
	projection: GlobalValueProjection,
	module_identity: ModuleIdentity,
	caller_view: ModuleView,
	alias_name: String,
	source_name: String,
) -> Result[Option[AcceptedGlobalValueBinding], String]:
	representation = global_value_projection_rep(projection)
	key = module_identity_storage_key(module_identity)
	index ?= representation.indexes_by_module_identity_key
		.get(key)
		.to_result("accepted global projection is missing a module identity")

	match module_view_find_module_alias(caller_view, alias_name):
		Some(module_path):
			Ok(global_value_index_find_module(representation.canonical, module_path, source_name))
		None:
			Ok(None)
