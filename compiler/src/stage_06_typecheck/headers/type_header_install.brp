	var next = state

	for header in type_header_graph_local_record_headers(graph, module_identity):
		next = install_record_header(
			next,
			graph,
			header,
			LocalTypeHeaderInstallation(module_identity, module_path),
		)

	next


pure func typecheck_install_imported_record_headers(
