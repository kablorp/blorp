-- Installation boundary from immutable type headers to the transitional Env.
--
-- Definition-owned builtin and record facts come only from category-specific
-- accepted headers. The installation target carries importer-local naming
-- separately, so parsed declarations are not replayed at this boundary.
import:
	../../stage_04_modules/loaded_module: ModuleIdentity, module_identities_equal
	../../stage_05_types/context: register_resource_cleanup
	../../stage_05_types/env:
		Env,
		FieldDecl,
		TypeContainmentSummary,
		TypeKind(TypeBuiltin, TypeEnum, TypeResource, TypeScalarBuiltin, TypeUnion),
		VariantDef,
		env_add_accepted_alias_with_containment,
		env_add_accepted_opaque_alias,
		env_add_accepted_record,
		env_add_accepted_type,
		env_add_accepted_type_containment,
		env_add_accepted_type_with_constructor_ids,
	../../stage_05_types/language_surface_manifest: prelude_type_name
	../../stage_05_types/record_type_index: record_type_index_find
	../../stage_05_types/semantic_type:
		SemanticDimOp(SemanticDimAdd, SemanticDimDivide, SemanticDimMultiply, SemanticDimSubtract),
		SemanticType(
			SemanticArrayType,
			SemanticConstIntType,
			SemanticDimOpType,
			SemanticFunctionType,
			SemanticNamedType,
			SemanticRangeType,
			SemanticSelfType,
			SemanticTupleType,
			SemanticTypeVar,
			SemanticVarDimsType,
		),
		canonical_module_type_name,
	../modules/module_view:
		module_view_accepted_record_type_index,
		module_view_accepted_type_alias_index,
	../state:
		TypecheckState,
		typecheck_state_add_error,
		typecheck_state_add_known_resource_type_name,
		typecheck_state_add_known_type_name,
		typecheck_state_allows_builtin,
		typecheck_state_record_type_home,
	declaration_skeleton:
		TypeId,
		constructor_id_definition_id,
		type_id_module_identity,
		type_id_name,
	type_header_graph:
		AcceptedAliasHeader,
		AcceptedBuiltinHeader,
		AcceptedRecordHeader,
		AcceptedUnionHeader,
		AliasLayout(OpaqueAlias, TransparentAlias),
		BuiltinTypeLayout(
			ManagedBuiltin,
			NoValueBuiltin,
			ResourceBuiltin,
			ScalarBuiltin,
			UnclassifiedBuiltin,
		),
		DeclaredTypeExpansion(NominalDeclaredType, TransparentAliasExpansion),
		IntrinsicType(IntrinsicTaskResult),
		RecordLayout(HeapRecord, ValueStruct),
		ResolvedDimOp(ResolvedDimAdd, ResolvedDimDivide, ResolvedDimMultiply, ResolvedDimSubtract),
		ResolvedTypeShape(
			ArrayTypeShape,
			CallableDimensionParameterShape,
			CallableTypeParameterShape,
			DeclaredTypeShape,
			DimensionBinaryShape,
			DimensionLiteralShape,
			DimensionParameterShape,
			FunctionTypeShape,
			ImplementationDimensionParameterShape,
			ImplementationTypeParameterShape,
			IntrinsicTypeShape,
			PreludeTypeShape,
			RangeTypeShape,
			SelfTypeShape,
			TraitDimensionParameterShape,
			TraitSelfTypeShape,
			TraitTypeParameterShape,
			TupleTypeShape,
			TypeParameterShape,
			WildcardDimensionShape,
		),
		ResourceCleanupPolicy(ResourceWithCleanup, ResourceWithoutCleanup),
		TypeContainmentFacts,
		TypeHeaderField,
		TypeHeaderGraph,
		TypeHeaderVariant,
		UnionLayout(FieldlessEnum, TaggedUnion),
		alias_type_header_containment_facts,
		alias_type_header_id,
		alias_type_header_layout,
		alias_type_header_parameters,
		alias_type_header_target,
		builtin_type_header_containment_facts,
		builtin_type_header_id,
		builtin_type_header_layout,
		builtin_type_header_parameters,
		callable_type_parameter_id_name,
		implementation_type_parameter_id_name,
		intrinsic_type_name,
		record_type_header_containment_facts,
		record_type_header_contains_resource,
		record_type_header_fields,
		record_type_header_id,
		record_type_header_layout,
		record_type_header_parameters,
		trait_type_parameter_id_name,
		type_header_graph_declared_type_expansion,
		type_header_graph_local_alias_headers,
		type_header_graph_local_builtin_headers,
		type_header_graph_local_record_headers,
		type_header_graph_local_union_headers,
		type_header_graph_owner_provides_prelude_type,
		type_header_graph_public_alias_headers,
		type_header_graph_public_builtin_headers,
		type_header_graph_public_record_headers,
		type_header_graph_public_union_headers,
		type_header_graph_type_module_path,
		union_type_header_containment_facts,
		union_type_header_contains_resource,
		union_type_header_id,
		union_type_header_layout,
		union_type_header_parameters,
		union_type_header_variants,
	type_parameter_headers: TypeParameterId, type_parameter_id_name, type_parameter_ids_equal
	type_resolution: add_imported_accepted_type_aliases


private union BuiltinHeaderInstallation:
	LocalBuiltinInstallation(String)
	ImportedBuiltinInstallation(String)


private union TypeHeaderInstallation:
	LocalTypeHeaderInstallation(ModuleIdentity, String)
	ImportedTypeHeaderInstallation(ModuleIdentity, String)


-- These installation values own managed compiler data and therefore cannot be
-- value structs; their generated destructors must release nested payloads.
private record SemanticTypeSubstitution {
	parameter: TypeParameterId,
	replacement: SemanticType
}


private record InstalledUnionVariant {
	definition: VariantDef,
	constructor_id: Int
}


private pure func type_header_installation_identity(
	installation: TypeHeaderInstallation,
) -> ModuleIdentity:
	match installation:
		LocalTypeHeaderInstallation(identity, _):
			identity
		ImportedTypeHeaderInstallation(identity, _):
			identity


private pure func type_header_installation_path(installation: TypeHeaderInstallation) -> String:
	match installation:
		LocalTypeHeaderInstallation(_, path):
			path
		ImportedTypeHeaderInstallation(_, path):
			path


private pure func installed_type_name(
	source_name: String,
	installation: TypeHeaderInstallation,
) -> String:
	match installation:
		LocalTypeHeaderInstallation(_, _):
			source_name
		ImportedTypeHeaderInstallation(_, path):
			canonical_module_type_name(path, source_name)


private pure func finalize_installed_type(
	state: TypecheckState,
	source_name: String,
	type_name: String,
	type_parameters: List[String],
	installation: TypeHeaderInstallation,
) -> TypecheckState:
	module_path = type_header_installation_path(installation)

	with_home = match installation:
		LocalTypeHeaderInstallation(_, _):
			typecheck_state_record_type_home(state, type_name, module_path, False)
		ImportedTypeHeaderInstallation(_, _):
			typecheck_state_record_type_home(state, type_name, module_path, True)

	match module_view_accepted_type_alias_index(state.module_view):
		Some(_):
			with_home
		None:
			match installation:
				LocalTypeHeaderInstallation(_, _):
					with_home
				ImportedTypeHeaderInstallation(_, _):
					add_imported_accepted_type_aliases(
						with_home,
						module_path,
						source_name,
						type_name,
						type_parameters,
					)


private pure func resolved_declared_type_name(
	graph: TypeHeaderGraph,
	id: TypeId,
	installation: TypeHeaderInstallation,
) -> Option[String]:
	source_name = type_id_name(id)

	if module_identities_equal(
		type_id_module_identity(id),
		type_header_installation_identity(installation),
	):
		match installation:
			LocalTypeHeaderInstallation(_, _):
				Some(source_name)
			ImportedTypeHeaderInstallation(_, path):
				Some(canonical_module_type_name(path, source_name))
	else:
		type_header_graph_type_module_path(
			graph,
			id,
		).map(
			func(path): canonical_module_type_name(path, source_name),
		)


private pure func semantic_dim_op(op: ResolvedDimOp) -> SemanticDimOp:
	match op:
		ResolvedDimAdd:
			SemanticDimAdd
		ResolvedDimSubtract:
			SemanticDimSubtract
		ResolvedDimMultiply:
			SemanticDimMultiply
		ResolvedDimDivide:
			SemanticDimDivide


private pure func semantic_type_substitution_find(
	substitutions: List[SemanticTypeSubstitution],
	parameter: TypeParameterId,
) -> Option[SemanticType]:
	var result: Option[SemanticType] = None

	for substitution in substitutions:
		if type_parameter_ids_equal(substitution.parameter, parameter):
			result = Some(substitution.replacement)
			break

	result


private pure func semantic_types_from_resolved_shapes_with_substitutions(
	graph: TypeHeaderGraph,
	shapes: List[ResolvedTypeShape],
	installation: TypeHeaderInstallation,
	substitutions: List[SemanticTypeSubstitution],
) -> Option[List[SemanticType]]:
	var result: List[SemanticType] = []
	var valid: Bool = True

	for shape in shapes:
		if valid:
			match semantic_type_from_resolved_shape_with_substitutions(
				graph,
				shape,
				installation,
				substitutions,
			):
				Some(semantic_type):
					result = result.append(semantic_type)
				None:
					valid = False

	if valid:
		Some(result)
	else:
		None


private pure func semantic_type_from_resolved_shape_with_substitutions(
	graph: TypeHeaderGraph,
	shape: ResolvedTypeShape,
	installation: TypeHeaderInstallation,
	substitutions: List[SemanticTypeSubstitution],
) -> Option[SemanticType]:
	match shape:
		DeclaredTypeShape(id, args):
			semantic_args ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				args,
				installation,
				substitutions,
			)

			match type_header_graph_declared_type_expansion(graph, id):
				Some(expansion):
					match expansion:
						TransparentAliasExpansion(parameters, target):
							if parameters.length() != semantic_args.length():
								None
							else:
								var alias_substitutions = substitutions
								var index: Int = 0

								while index < parameters.length():
									match (parameters.get(index), semantic_args.get(index)):
										(Some(parameter), Some(replacement)):
											alias_substitutions = alias_substitutions.append({
												parameter = parameter.id,
												replacement = replacement,
											})
										_:
											void

									index += 1

								semantic_type_from_resolved_shape_with_substitutions(
									graph,
									target,
									installation,
									alias_substitutions,
								)
						NominalDeclaredType:
							name ?= resolved_declared_type_name(graph, id, installation)
							Some(SemanticNamedType(name, semantic_args))
				None:
					None
		IntrinsicTypeShape(intrinsic, args):
			semantic_args ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				args,
				installation,
				substitutions,
			)

			match intrinsic:
				IntrinsicTaskResult:
					-- TaskResult is a source-level alias retained in header shapes for
					-- layout analysis. The semantic environment must receive its
					-- canonical Result type so Result constructors remain valid.
					match semantic_args:
						[ok_type]:
							Some(
								SemanticNamedType(
									"Result",
									[ok_type, SemanticNamedType("ConcurrencyError", [])],
								),
							)
						_:
							None
				_:
					Some(SemanticNamedType(intrinsic_type_name(intrinsic), semantic_args))
		PreludeTypeShape(prelude, args):
			semantic_args ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				args,
				installation,
				substitutions,
			)
			prelude_name = prelude_type_name(prelude)

			semantic_name = if type_header_graph_owner_provides_prelude_type(
				graph,
				type_header_installation_identity(installation),
				prelude,
			):
				match installation:
					LocalTypeHeaderInstallation(_, _):
						prelude_name
					ImportedTypeHeaderInstallation(_, path):
						canonical_module_type_name(path, prelude_name)
			else:
				prelude_name

			Some(SemanticNamedType(semantic_name, semantic_args))
		TypeParameterShape(id):
			Some(
				semantic_type_substitution_find(
					substitutions,
					id,
				).get_or(SemanticTypeVar(type_parameter_id_name(id))),
			)
		SelfTypeShape(_):
			Some(SemanticSelfType)
		TraitTypeParameterShape(id):
			Some(SemanticTypeVar(trait_type_parameter_id_name(id)))
		CallableTypeParameterShape(id):
			Some(SemanticTypeVar(callable_type_parameter_id_name(id)))
		ImplementationTypeParameterShape(id):
			Some(SemanticTypeVar(implementation_type_parameter_id_name(id)))
		TraitSelfTypeShape(_):
			Some(SemanticSelfType)
		DimensionParameterShape(id, is_variadic):
			name = type_parameter_id_name(id)

			match semantic_type_substitution_find(substitutions, id):
				Some(replacement):
					Some(replacement)
				None:
					if is_variadic:
						Some(SemanticVarDimsType(name))
					else:
						Some(SemanticTypeVar(name))
		TraitDimensionParameterShape(id, is_variadic):
			name = trait_type_parameter_id_name(id)

			if is_variadic:
				Some(SemanticVarDimsType(name))
			else:
				Some(SemanticTypeVar(name))
		CallableDimensionParameterShape(id, is_variadic):
			name = callable_type_parameter_id_name(id)

			if is_variadic:
				Some(SemanticVarDimsType(name))
			else:
				Some(SemanticTypeVar(name))
		ImplementationDimensionParameterShape(id, is_variadic):
			name = implementation_type_parameter_id_name(id)

			if is_variadic:
				Some(SemanticVarDimsType(name))
			else:
				Some(SemanticTypeVar(name))
		WildcardDimensionShape(is_variadic):
			if is_variadic:
				Some(SemanticVarDimsType("#_"))
			else:
				Some(SemanticTypeVar("#_"))
		DimensionLiteralShape(value):
			Some(SemanticConstIntType(value))
		DimensionBinaryShape(op, left, right):
			semantic_left ?= semantic_type_from_resolved_shape_with_substitutions(
				graph,
				left,
				installation,
				substitutions,
			)
			semantic_right ?= semantic_type_from_resolved_shape_with_substitutions(
				graph,
				right,
				installation,
				substitutions,
			)
			Some(SemanticDimOpType(semantic_dim_op(op), semantic_left, semantic_right))
		RangeTypeShape(inner):
			semantic_inner ?= semantic_type_from_resolved_shape_with_substitutions(
				graph,
				inner,
				installation,
				substitutions,
			)
			Some(SemanticRangeType(semantic_inner))
		TupleTypeShape(elements):
			semantic_elements ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				elements,
				installation,
				substitutions,
			)
			Some(SemanticTupleType(semantic_elements))
		FunctionTypeShape(is_pure, params, return_type):
			semantic_params ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				params,
				installation,
				substitutions,
			)
			semantic_return ?= semantic_type_from_resolved_shape_with_substitutions(
				graph,
				return_type,
				installation,
				substitutions,
			)
			Some(SemanticFunctionType(is_pure, semantic_params, semantic_return))
		ArrayTypeShape(element, dims):
			semantic_element ?= semantic_type_from_resolved_shape_with_substitutions(
				graph,
				element,
				installation,
				substitutions,
			)
			semantic_dims ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				dims,
				installation,
				substitutions,
			)
			Some(SemanticArrayType(semantic_element, semantic_dims))


private pure func semantic_type_from_resolved_shape(
	graph: TypeHeaderGraph,
	shape: ResolvedTypeShape,
	installation: TypeHeaderInstallation,
) -> Option[SemanticType]:
	semantic_type_from_resolved_shape_with_substitutions(graph, shape, installation, [])


-- Callable and implementation adapters use these category-specific entry
-- points so importer-local naming cannot be confused with owner-local naming.
-- The resolved shape remains definition-owned; only its legacy Env spelling
-- depends on the installation site.
pure func local_semantic_type_from_resolved_shape(
	graph: TypeHeaderGraph,
	owner_identity: ModuleIdentity,
	owner_path: String,
	shape: ResolvedTypeShape,
) -> Option[SemanticType]:
	semantic_type_from_resolved_shape(
		graph,
		shape,
		LocalTypeHeaderInstallation(owner_identity, owner_path),
	)


pure func imported_semantic_type_from_resolved_shape(
	graph: TypeHeaderGraph,
	owner_identity: ModuleIdentity,
	owner_path: String,
	shape: ResolvedTypeShape,
) -> Option[SemanticType]:
	semantic_type_from_resolved_shape(
		graph,
		shape,
		ImportedTypeHeaderInstallation(owner_identity, owner_path),
	)


private pure func env_containment_summary(facts: TypeContainmentFacts) -> TypeContainmentSummary:
	{
		may_contain_function = facts.may_contain_function,
		may_contain_one_shot_stream = facts.may_contain_one_shot_stream,
		may_contain_resource_source = facts.may_contain_resource_source
	}


private pure func install_builtin_header(
	state: TypecheckState,
	header: AcceptedBuiltinHeader,
	installation: BuiltinHeaderInstallation,
) -> TypecheckState:
	source_name = type_id_name(builtin_type_header_id(header))

	module_path = match installation:
		LocalBuiltinInstallation(path):
			path
		ImportedBuiltinInstallation(path):
			path

	type_name = match installation:
		LocalBuiltinInstallation(_):
			source_name
		ImportedBuiltinInstallation(path):
			canonical_module_type_name(path, source_name)

	layout = builtin_type_header_layout(header)
	type_parameters = builtin_type_header_parameters(
		header,
	).map(
		func(parameter): type_parameter_id_name(parameter.id),
	)

	is_resource = match layout:
		ScalarBuiltin | ManagedBuiltin | NoValueBuiltin | UnclassifiedBuiltin:
			False
		ResourceBuiltin(_):
			True

	var next = match installation:
		LocalBuiltinInstallation(_):
			if typecheck_state_allows_builtin(state):
				state
			else:
				prefix = if is_resource:
					"resource type "
				else:
					"type "

				typecheck_state_add_error(
					state,
					"'" + prefix + source_name + " = builtin' can only be used in the standard library",
				)
		ImportedBuiltinInstallation(_):
			state

	next = if is_resource:
		typecheck_state_add_known_resource_type_name(next, type_name)
	else:
		match installation:
			LocalBuiltinInstallation(_):
				typecheck_state_add_known_type_name(next, type_name)
			ImportedBuiltinInstallation(_):
				next

	type_kind = match layout:
		ScalarBuiltin:
			TypeScalarBuiltin
		ResourceBuiltin(_):
			TypeResource
		ManagedBuiltin | NoValueBuiltin | UnclassifiedBuiltin:
			TypeBuiltin

	env: Env = env_add_accepted_type(
		next.env,
		type_name,
		type_parameters,
		[],
		type_kind,
		is_resource,
		False,
		env_containment_summary(builtin_type_header_containment_facts(header)),
	)
	with_env = { next | env = env }

	with_cleanup = match layout:
		ResourceBuiltin(ResourceWithCleanup(cleanup)):
			{ with_env | context = register_resource_cleanup(with_env.context, type_name, cleanup) }
		ResourceBuiltin(ResourceWithoutCleanup):
			with_env
		ScalarBuiltin | ManagedBuiltin | NoValueBuiltin | UnclassifiedBuiltin:
			with_env

	with_home = match installation:
		LocalBuiltinInstallation(_):
			typecheck_state_record_type_home(with_cleanup, type_name, module_path, False)
		ImportedBuiltinInstallation(_):
			typecheck_state_record_type_home(with_cleanup, type_name, module_path, True)

	match module_view_accepted_type_alias_index(state.module_view):
		Some(_):
			with_home
		None:
			match installation:
				LocalBuiltinInstallation(_):
					with_home
				ImportedBuiltinInstallation(_):
					add_imported_accepted_type_aliases(
						with_home,
						module_path,
						source_name,
						type_name,
						type_parameters,
					)


private pure func record_header_type_parameters(header: AcceptedRecordHeader) -> List[String]:
	record_type_header_parameters(header).map(func(parameter): type_parameter_id_name(parameter.id))


private pure func record_header_fields(
	graph: TypeHeaderGraph,
	header: AcceptedRecordHeader,
	installation: TypeHeaderInstallation,
) -> Option[List[FieldDecl]]:
	var result: List[FieldDecl] = []
	var valid: Bool = True

	for field in record_type_header_fields(header):
		if valid:
			match semantic_type_from_resolved_shape(graph, field.typ, installation):
				Some(field_type):
					result = result.append({
						name = field.name,
						field_type = field_type,
						definition_id = field.definition_id,
					})
				None:
					valid = False

	if valid:
		Some(result)
	else:
		None


pure func local_record_header_fields(
	graph: TypeHeaderGraph,
	module_identity: ModuleIdentity,
	module_path: String,
	header: AcceptedRecordHeader,
) -> Option[List[FieldDecl]]:
	record_header_fields(
		graph,
		header,
		LocalTypeHeaderInstallation(module_identity, module_path),
	)


pure func imported_record_header_fields(
	graph: TypeHeaderGraph,
	module_identity: ModuleIdentity,
	module_path: String,
	header: AcceptedRecordHeader,
) -> Option[List[FieldDecl]]:
	record_header_fields(
		graph,
		header,
		ImportedTypeHeaderInstallation(module_identity, module_path),
	)


private pure func install_record_header(
	state: TypecheckState,
	graph: TypeHeaderGraph,
	header: AcceptedRecordHeader,
	installation: TypeHeaderInstallation,
) -> TypecheckState:
	source_name = type_id_name(record_type_header_id(header))
	type_name = installed_type_name(source_name, installation)
	type_parameters = record_header_type_parameters(header)
	containment = env_containment_summary(record_type_header_containment_facts(header))

	match module_view_accepted_record_type_index(state.module_view):
		Some(index):
			match record_type_index_find(index, type_name):
				Some(_):
					env = env_add_accepted_type_containment(
						state.env,
						type_name,
						record_type_header_contains_resource(header),
						containment,
					)

					finalize_installed_type(
						{ state | env = env },
						source_name,
						type_name,
						type_parameters,
						installation,
					)
				None:
					typecheck_state_add_error(
						state,
						"internal typecheck error: accepted record authority is missing '" + type_name + "'",
					)
		None:
			match record_header_fields(graph, header, installation):
				None:
					typecheck_state_add_error(
						state,
						"internal typecheck error: accepted record header '" + type_name + "' refers to a module absent from its type-header graph",
					)
				Some(fields):
					is_value = match record_type_header_layout(header):
						HeapRecord:
							False
						ValueStruct:
							True

					env = env_add_accepted_record(
						state.env,
						type_name,
						type_parameters,
						fields,
						is_value,
						record_type_header_contains_resource(header),
						containment,
					)

					finalize_installed_type(
						{ state | env = env },
						source_name,
						type_name,
						type_parameters,
						installation,
					)


private pure func installed_union_variant(
	graph: TypeHeaderGraph,
	variant: TypeHeaderVariant,
	installation: TypeHeaderInstallation,
) -> Option[InstalledUnionVariant]:
	fields ?= semantic_types_from_resolved_shapes_with_substitutions(
		graph,
		variant.fields,
		installation,
		[],
	)
	Some({
		definition = {
			name = variant.name,
			fields = fields,
			tag = variant.tag
		},
		constructor_id = constructor_id_definition_id(variant.id),
	})


private pure func installed_union_variants(
	graph: TypeHeaderGraph,
	header: AcceptedUnionHeader,
	installation: TypeHeaderInstallation,
) -> Option[List[InstalledUnionVariant]]:
	var result: List[InstalledUnionVariant] = []
	var valid: Bool = True

	for variant in union_type_header_variants(header):
		if valid:
			match installed_union_variant(graph, variant, installation):
				Some(installed):
					result = result.append(installed)
				None:
					valid = False

	if valid:
		Some(result)
	else:
		None


private pure func install_union_header(
	state: TypecheckState,
	graph: TypeHeaderGraph,
	header: AcceptedUnionHeader,
	installation: TypeHeaderInstallation,
) -> TypecheckState:
	source_name = type_id_name(union_type_header_id(header))
	type_name = installed_type_name(source_name, installation)

	match installed_union_variants(graph, header, installation):
		None:
			typecheck_state_add_error(
				state,
				"internal typecheck error: accepted union header '" + type_name + "' refers to a module absent from its type-header graph",
			)
		Some(installed_variants):
			type_kind = match union_type_header_layout(header):
				TaggedUnion:
					TypeUnion
				FieldlessEnum:
					TypeEnum

			type_parameters = union_type_header_parameters(
				header,
			).map(
				func(parameter): type_parameter_id_name(parameter.id),
			)
			env = env_add_accepted_type_with_constructor_ids(
				state.env,
				type_name,
				type_parameters,
				installed_variants.map(func(variant): variant.definition),
				type_kind,
				union_type_header_contains_resource(header),
				True,
				installed_variants.map(func(variant): Some(variant.constructor_id)),
				env_containment_summary(union_type_header_containment_facts(header)),
			)
			finalize_installed_type(
				{ state | env = env },
				source_name,
				type_name,
				type_parameters,
				installation,
			)


private pure func finalize_installed_alias(
	state: TypecheckState,
	source_name: String,
	type_name: String,
	type_parameters: List[String],
	layout: AliasLayout,
	installation: TypeHeaderInstallation,
) -> TypecheckState:
	module_path = type_header_installation_path(installation)

	with_home = match layout:
		TransparentAlias:
			state
		OpaqueAlias:
			match installation:
				LocalTypeHeaderInstallation(_, _):
					typecheck_state_record_type_home(state, type_name, module_path, False)
				ImportedTypeHeaderInstallation(_, _):
					typecheck_state_record_type_home(state, type_name, module_path, True)

	match module_view_accepted_type_alias_index(state.module_view):
		Some(_):
			with_home
		None:
			match installation:
				LocalTypeHeaderInstallation(_, _):
					with_home
				ImportedTypeHeaderInstallation(_, _):
					add_imported_accepted_type_aliases(
						with_home,
						module_path,
						source_name,
						type_name,
						type_parameters,
					)


private pure func install_alias_header(
	state: TypecheckState,
	graph: TypeHeaderGraph,
	header: AcceptedAliasHeader,
	installation: TypeHeaderInstallation,
) -> TypecheckState:
	source_name = type_id_name(alias_type_header_id(header))
	type_name = installed_type_name(source_name, installation)
	type_parameters = alias_type_header_parameters(
		header,
	).map(
		func(parameter): type_parameter_id_name(parameter.id),
	)
	layout = alias_type_header_layout(header)

	match semantic_type_from_resolved_shape(graph, alias_type_header_target(header), installation):
		None:
			typecheck_state_add_error(
				state,
				"internal typecheck error: accepted alias header '" + type_name + "' refers to a module absent from its type-header graph",
			)
		Some(target):
			containment = alias_type_header_containment_facts(header)
			env_summary = env_containment_summary(containment)

			env = match module_view_accepted_type_alias_index(state.module_view):
				Some(_):
					state.env
				None:
					match layout:
						TransparentAlias:
							env_add_accepted_alias_with_containment(
								state.env,
								type_name,
								type_parameters,
								target,
								containment.contains_resource,
								env_summary,
							)
						OpaqueAlias:
							env_add_accepted_opaque_alias(
								state.env,
								type_name,
								type_parameters,
								target,
								Some(type_header_installation_path(installation)),
								containment.contains_resource,
								env_summary,
							)

			with_env = { typecheck_state_add_known_type_name(state, type_name) | env = env }
			finalize_installed_alias(
				with_env,
				source_name,
				type_name,
				type_parameters,
				layout,
				installation,
			)


pure func typecheck_install_local_builtin_headers(
	state: TypecheckState,
	graph: TypeHeaderGraph,
	module_identity: ModuleIdentity,
	module_path: String,
) -> TypecheckState:
	var next = state

	for header in type_header_graph_local_builtin_headers(graph, module_identity):
		next = install_builtin_header(next, header, LocalBuiltinInstallation(module_path))

	next


pure func typecheck_install_imported_builtin_headers(
	state: TypecheckState,
	graph: TypeHeaderGraph,
	module_identity: ModuleIdentity,
	module_path: String,
) -> TypecheckState:
	var next = state

	for header in type_header_graph_public_builtin_headers(graph, module_identity):
		next = install_builtin_header(next, header, ImportedBuiltinInstallation(module_path))

	next


pure func typecheck_install_local_record_headers(
	state: TypecheckState,
