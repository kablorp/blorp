pure func declaration_skeleton_graph_find_type(
	graph: DeclarationSkeletonGraph,
	module_identity: ModuleIdentity,
	name: String,
) -> Option[TypeDeclarationSkeletonInfo]:
	var result: Option[TypeDeclarationSkeletonInfo] = None

	for skeleton in declaration_skeleton_graph_rep(graph).skeletons_by_name.get_or(name, []):
		match skeleton:
			TypeDeclarationSkeleton(id, visibility, source):
				if module_identities_equal(type_id_module_identity(id), module_identity):
					result = Some({
						id = id,
						visibility = visibility,
						source = source,
					})
					break
			_:
				void

	result


pure func declaration_skeleton_graph_find_trait(
	graph: DeclarationSkeletonGraph,
	module_identity: ModuleIdentity,
	name: String,
) -> Option[TraitDeclarationSkeletonInfo]:
	var result: Option[TraitDeclarationSkeletonInfo] = None

	for skeleton in declaration_skeleton_graph_rep(graph).skeletons_by_name.get_or(name, []):
		match skeleton:
			TraitDeclarationSkeleton(id, visibility, source):
				if module_identities_equal(trait_id_module_identity(id), module_identity):
					result = Some({
						id = id,
						visibility = visibility,
						source = source,
					})
					break
			_:
				void

	result


pure func declaration_skeleton_graph_find(
	graph: DeclarationSkeletonGraph,
	id: DeclarationId,
) -> Option[DeclarationSkeleton]:
	var result: Option[DeclarationSkeleton] = None
	name = declaration_id_structural(id).name

	for skeleton in declaration_skeleton_graph_rep(graph).skeletons_by_name.get_or(name, []):
		if declaration_ids_equal(declaration_skeleton_id(skeleton), id):
			result = Some(skeleton)
			break

	result


pure func declaration_skeleton_graph_error_message(error: DeclarationSkeletonGraphError) -> String:
	match error:
		CallableSkeletonMissingDefinition(module_identity, name, _):
			"declaration skeleton is missing callable definition '" + name + "' in module '" + module_identity_display_name(
				module_identity,
			) + "'"
		ConstructorSkeletonMissingDefinition(module_identity, owner, name, _):
			"declaration skeleton is missing constructor definition '" + owner + "." + name + "' in module '" + module_identity_display_name(
				module_identity,
			) + "'"
		TraitSkeletonMissingDefinition(module_identity, name, _):
			"declaration skeleton is missing trait definition '" + name + "' in module '" + module_identity_display_name(
				module_identity,
			) + "'"
		ImplementationSkeletonMissingDefinition(module_identity, name, _):
			"declaration skeleton is missing implementation definition for '" + name + "' in module '" + module_identity_display_name(
				module_identity,
			) + "'"
		DuplicateTypeDeclaration(module_identity, name, _):
			"duplicate type declaration '" + name + "' in module '" + module_identity_display_name(
				module_identity,
			) + "'"
		DuplicateTraitDeclaration(module_identity, name, _):
			"duplicate trait declaration '" + name + "' in module '" + module_identity_display_name(
				module_identity,
			) + "'"
		DuplicateConstructorDeclaration(parent_type_id, name, _):
			"duplicate constructor '" + name + "' in union '" + type_id_name(
				parent_type_id,
			) + "' in module '" + module_identity_display_name(
				type_id_module_identity(parent_type_id),
			) + "'"
		DuplicateDeclarationSkeleton(_):
			"duplicate declaration skeleton identity"
