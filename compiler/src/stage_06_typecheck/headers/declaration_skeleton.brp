-- Stable, category-safe declaration identities and source provenance.
--
-- Skeletons reserve declaration identity before any header resolves a type.
-- Runtime definition-bearing categories retain their graph-reserved integer
-- ID; categories without runtime IDs use an opaque structural identity rather
-- than an invented sentinel integer.
import:
	../../stage_01_file_io/source: SourceSpan, source_spans_equal
	../../stage_03_parse/parsed_ast:
		ParsedBuiltinTypeDecl,
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			ImportBlockParsedDecl,
			ParsedErrorDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedForeignFunctionDecl,
		ParsedFunctionDecl,
		ParsedImplDecl,
		ParsedRecordDecl,
		ParsedTraitDecl,
		ParsedTraitMethodDecl,
		ParsedTypeAliasDecl,
		ParsedUnionDecl,
		ParsedVarDecl,
		ParsedVariantDecl,
		parsed_program_has_errors,
	../../stage_04_modules/loaded_module:
		ModuleIdentity,
		module_identities_equal,
		module_identity_display_name,
		module_identity_for_compiler_surface,
	../../stage_05_types/builtins: builtin_trait_is_prelude, builtin_trait_supertraits
	../graph/definition_identity:
		SourceDefinitionKind(ConstructorDefinition, ImplDefinition, TraitDefinition),
		func_callable_key,
		func_callable_key_name,
		source_definition_key,
	../graph/definition_index:
		DefinitionIndex,
		definition_index_find_func_callable_id,
		definition_index_find_source_definition_id,
		definition_index_func_callables_at_span,
	../graph/indexed_graph: indexed_graph_definition_index
	../modules/bound_module_graph:
		BoundModule,
		BoundModuleGraph,
		bound_module_graph_indexed_graph,
		bound_module_graph_modules,
		bound_module_graph_target,
		bound_module_identity,
		bound_module_program,


enum DeclarationVisibility:
	PublicDeclaration
	PrivateDeclaration


enum DeclarationSkeletonKind:
	TypeSkeletonKind
	ConstructorSkeletonKind
	CallableSkeletonKind
	TraitSkeletonKind
	TraitMethodSkeletonKind
	GlobalSkeletonKind
	ImplementationSkeletonKind


private record StructuralDeclarationIdRep {
	module_identity: ModuleIdentity,
	name: String,
	owner: Option[String],
	span: SourceSpan
}


private record RuntimeDeclarationIdRep {
	structural: StructuralDeclarationIdRep,
	definition_id: Int
}


opaque type TypeId = StructuralDeclarationIdRep

opaque type GlobalId = StructuralDeclarationIdRep

opaque type ConstructorId = RuntimeDeclarationIdRep

opaque type CallableId = RuntimeDeclarationIdRep

opaque type TraitId = RuntimeDeclarationIdRep

opaque type ImplId = RuntimeDeclarationIdRep


private record TraitMethodIdRep {
	owner: TraitId,
	index: Int,
	structural: StructuralDeclarationIdRep
}


opaque type TraitMethodId = TraitMethodIdRep

private COMPILER_PRELUDE_TRAIT_SURFACE: String = "prelude-traits"

private COMPILER_PRELUDE_TRAIT_DEFINITION_ID: Int = 0


union DeclarationId:
	TypeDeclarationId(TypeId)
	ConstructorDeclarationId(ConstructorId)
	CallableDeclarationId(CallableId)
	TraitDeclarationId(TraitId)
	TraitMethodDeclarationId(TraitMethodId)
	GlobalDeclarationId(GlobalId)
	ImplementationDeclarationId(ImplId)


union TypeDeclarationSource:
	RecordTypeSource(ParsedRecordDecl)
	UnionTypeSource(ParsedUnionDecl)
	BuiltinTypeSource(ParsedBuiltinTypeDecl)
	AliasTypeSource(ParsedTypeAliasDecl)


union CallableDeclarationSource:
	FunctionCallableSource(ParsedFunctionDecl)
	ForeignCallableSource(ParsedForeignFunctionDecl)
	ImplementationMethodCallableSource(ImplId, ParsedFunctionDecl)
	DefaultImplementationMethodCallableSource(ImplId, String, ParsedImplDecl)


union DeclarationSource:
	TypeDeclarationSourceValue(TypeDeclarationSource)
	ConstructorDeclarationSourceValue(TypeId, ParsedVariantDecl)
	CallableDeclarationSourceValue(CallableDeclarationSource)
	TraitDeclarationSourceValue(ParsedTraitDecl)
	TraitMethodDeclarationSourceValue(ParsedTraitMethodDecl)
	GlobalDeclarationSourceValue(ParsedVarDecl)
	ImplementationDeclarationSourceValue(ParsedImplDecl)


union DeclarationSkeleton:
	TypeDeclarationSkeleton(TypeId, DeclarationVisibility, TypeDeclarationSource)
	ConstructorDeclarationSkeleton(ConstructorId, DeclarationVisibility, TypeId, ParsedVariantDecl)
	CallableDeclarationSkeleton(CallableId, DeclarationVisibility, CallableDeclarationSource)
	TraitDeclarationSkeleton(TraitId, DeclarationVisibility, ParsedTraitDecl)
	TraitMethodDeclarationSkeleton(TraitMethodId, DeclarationVisibility, ParsedTraitMethodDecl)
	GlobalDeclarationSkeleton(GlobalId, DeclarationVisibility, ParsedVarDecl)
	ImplementationDeclarationSkeleton(ImplId, DeclarationVisibility, ParsedImplDecl)


record TypeDeclarationSkeletonInfo {
	id: TypeId,
	visibility: DeclarationVisibility,
	source: TypeDeclarationSource
}


record ConstructorDeclarationSkeletonInfo {
	id: ConstructorId,
	visibility: DeclarationVisibility,
	parent_type_id: TypeId,
	source: ParsedVariantDecl
}


record TraitDeclarationSkeletonInfo {
	id: TraitId,
	visibility: DeclarationVisibility,
	source: ParsedTraitDecl
}


record TraitMethodDeclarationSkeletonInfo {
	id: TraitMethodId,
	source: ParsedTraitMethodDecl
}


record CallableDeclarationSkeletonInfo {
	id: CallableId,
	visibility: DeclarationVisibility,
	source: CallableDeclarationSource
}


record GlobalDeclarationSkeletonInfo {
	id: GlobalId,
	visibility: DeclarationVisibility,
	source: ParsedVarDecl
}


record ImplementationDeclarationSkeletonInfo {
	id: ImplId,
	visibility: DeclarationVisibility,
	source: ParsedImplDecl
}


union DeclarationSkeletonGraphError:
	CallableSkeletonMissingDefinition(ModuleIdentity, String, SourceSpan)
	ConstructorSkeletonMissingDefinition(ModuleIdentity, String, String, SourceSpan)
	TraitSkeletonMissingDefinition(ModuleIdentity, String, SourceSpan)
	ImplementationSkeletonMissingDefinition(ModuleIdentity, String, SourceSpan)
	DuplicateTypeDeclaration(ModuleIdentity, String, SourceSpan)
	DuplicateTraitDeclaration(ModuleIdentity, String, SourceSpan)
	DuplicateConstructorDeclaration(TypeId, String, SourceSpan)
	DuplicateDeclarationSkeleton(DeclarationId)


-- Exact declaration identity includes source location. Namespace identity does
-- not: it describes the semantic slots whose occupants must be unique before
-- name-indexed header resolution can begin. Callable overloads deliberately do
-- not have a key here.
private union DeclarationNamespaceKey:
	TypeNamespaceKey(ModuleIdentity, String)
	TraitNamespaceKey(ModuleIdentity, String)
	ConstructorNamespaceKey(TypeId, String)


private record DeclarationSkeletonGraphRep {
	bound_graph: BoundModuleGraph,
	skeletons: List[DeclarationSkeleton],
	skeletons_by_name: Dict[String, List[DeclarationSkeleton]]
}


opaque type DeclarationSkeletonGraph = DeclarationSkeletonGraphRep


-- The collection pass preserves source order without constructing a partially
-- valid graph. Validation consumes these items in order and is the only phase
-- that owns the graph indexes.
private union DeclarationSkeletonBuildItem:
	DeclarationSkeletonCandidate(DeclarationSkeleton)
	DeclarationSkeletonBuildError(DeclarationSkeletonGraphError)


private record DeclarationSkeletonBuildContext {
	module_identity: ModuleIdentity,
	definition_index: DefinitionIndex
}


private pure func structural_declaration_id(
	module_identity: ModuleIdentity,
	name: String,
	owner: Option[String],
	span: SourceSpan,
) -> StructuralDeclarationIdRep:
	{
		module_identity = module_identity,
		name = name,
		owner = owner,
		span = span
	}


private pure func runtime_declaration_id(
	structural: StructuralDeclarationIdRep,
	definition_id: Int,
) -> RuntimeDeclarationIdRep:
	{
		structural = structural,
		definition_id = definition_id
	}


private pure func structural_declaration_ids_equal(
	left: StructuralDeclarationIdRep,
	right: StructuralDeclarationIdRep,
) -> Bool:
	(
		module_identities_equal(left.module_identity, right.module_identity)
		and left.name == right.name
		and left.owner == right.owner
		and source_spans_equal(left.span, right.span)
	)


private pure func runtime_declaration_ids_equal(
	left: RuntimeDeclarationIdRep,
	right: RuntimeDeclarationIdRep,
) -> Bool:
	(
		left.definition_id == right.definition_id
		and structural_declaration_ids_equal(left.structural, right.structural)
	)


pure func trait_method_ids_equal(left: TraitMethodId, right: TraitMethodId) -> Bool:
	left_rep = from TraitMethodId(left)
	right_rep = from TraitMethodId(right)

	(
		trait_ids_equal(left_rep.owner, right_rep.owner)
		and left_rep.index == right_rep.index
		and structural_declaration_ids_equal(left_rep.structural, right_rep.structural)
	)


pure func declaration_ids_equal(left: DeclarationId, right: DeclarationId) -> Bool:
	match (left, right):
		(TypeDeclarationId(left_id), TypeDeclarationId(right_id)):
			structural_declaration_ids_equal(from TypeId(left_id), from TypeId(right_id))
		(GlobalDeclarationId(left_id), GlobalDeclarationId(right_id)):
			structural_declaration_ids_equal(from GlobalId(left_id), from GlobalId(right_id))
		(TraitMethodDeclarationId(left_id), TraitMethodDeclarationId(right_id)):
			trait_method_ids_equal(left_id, right_id)
		(ConstructorDeclarationId(left_id), ConstructorDeclarationId(right_id)):
			runtime_declaration_ids_equal(from ConstructorId(left_id), from ConstructorId(right_id))
		(CallableDeclarationId(left_id), CallableDeclarationId(right_id)):
			runtime_declaration_ids_equal(from CallableId(left_id), from CallableId(right_id))
		(TraitDeclarationId(left_id), TraitDeclarationId(right_id)):
			runtime_declaration_ids_equal(from TraitId(left_id), from TraitId(right_id))
		(ImplementationDeclarationId(left_id), ImplementationDeclarationId(right_id)):
			runtime_declaration_ids_equal(from ImplId(left_id), from ImplId(right_id))
		_:
			False


pure func type_ids_equal(left: TypeId, right: TypeId) -> Bool:
	structural_declaration_ids_equal(from TypeId(left), from TypeId(right))


pure func type_id_name(id: TypeId) -> String:
	from TypeId(id).name


pure func type_id_module_identity(id: TypeId) -> ModuleIdentity:
	from TypeId(id).module_identity


pure func type_id_source_span(id: TypeId) -> SourceSpan:
	from TypeId(id).span


pure func constructor_id_definition_id(id: ConstructorId) -> Int:
	from ConstructorId(id).definition_id


pure func constructor_ids_equal(left: ConstructorId, right: ConstructorId) -> Bool:
	runtime_declaration_ids_equal(from ConstructorId(left), from ConstructorId(right))


pure func constructor_id_module_identity(id: ConstructorId) -> ModuleIdentity:
	from ConstructorId(id).structural.module_identity


pure func constructor_id_source_span(id: ConstructorId) -> SourceSpan:
	from ConstructorId(id).structural.span


pure func callable_ids_equal(left: CallableId, right: CallableId) -> Bool:
	runtime_declaration_ids_equal(from CallableId(left), from CallableId(right))


pure func callable_id_name(id: CallableId) -> String:
	from CallableId(id).structural.name


pure func callable_id_module_identity(id: CallableId) -> ModuleIdentity:
	from CallableId(id).structural.module_identity


pure func callable_id_definition_id(id: CallableId) -> Int:
	from CallableId(id).definition_id


pure func callable_id_source_span(id: CallableId) -> SourceSpan:
	from CallableId(id).structural.span


pure func global_ids_equal(left: GlobalId, right: GlobalId) -> Bool:
	structural_declaration_ids_equal(from GlobalId(left), from GlobalId(right))


pure func global_id_name(id: GlobalId) -> String:
	from GlobalId(id).name


pure func global_id_module_identity(id: GlobalId) -> ModuleIdentity:
	from GlobalId(id).module_identity


pure func global_id_source_span(id: GlobalId) -> SourceSpan:
	from GlobalId(id).span


pure func impl_ids_equal(left: ImplId, right: ImplId) -> Bool:
	runtime_declaration_ids_equal(from ImplId(left), from ImplId(right))


pure func impl_id_module_identity(id: ImplId) -> ModuleIdentity:
	from ImplId(id).structural.module_identity


pure func impl_id_name(id: ImplId) -> String:
	from ImplId(id).structural.name


pure func impl_id_definition_id(id: ImplId) -> Int:
	from ImplId(id).definition_id


pure func impl_id_source_span(id: ImplId) -> SourceSpan:
	from ImplId(id).structural.span


pure func trait_ids_equal(left: TraitId, right: TraitId) -> Bool:
	runtime_declaration_ids_equal(from TraitId(left), from TraitId(right))


pure func trait_id_name(id: TraitId) -> String:
	from TraitId(id).structural.name


pure func trait_id_module_identity(id: TraitId) -> ModuleIdentity:
	from TraitId(id).structural.module_identity


pure func trait_id_definition_id(id: TraitId) -> Int:
	from TraitId(id).definition_id


pure func trait_id_source_span(id: TraitId) -> SourceSpan:
	from TraitId(id).structural.span


pure func prelude_trait_id(name: String) -> Option[TraitId]:
	if builtin_trait_is_prelude(name):
		builtin_trait_id(name)
	else:
		None


pure func builtin_trait_id(name: String) -> Option[TraitId]:
	match builtin_trait_supertraits(name):
		None:
			None
		Some(_):
			span: SourceSpan = {
				path = "<compiler-prelude>",
				module_name = "<compiler-prelude>",
				start_offset = 0,
				start_line = 1,
				start_column = 1,
				end_offset = 0,
				end_line = 1,
				end_column = 1
			}
			structural = structural_declaration_id(
				module_identity_for_compiler_surface(COMPILER_PRELUDE_TRAIT_SURFACE),
				name,
				None,
				span,
			)
			runtime = runtime_declaration_id(structural, COMPILER_PRELUDE_TRAIT_DEFINITION_ID)
			Some(into TraitId(runtime))


pure func trait_id_is_compiler_builtin(id: TraitId) -> Bool:
	(
		module_identities_equal(
			trait_id_module_identity(id),
			module_identity_for_compiler_surface(COMPILER_PRELUDE_TRAIT_SURFACE),
		)
		and builtin_trait_supertraits(trait_id_name(id)).is_some()
	)


pure func trait_method_id_name(id: TraitMethodId) -> String:
	from TraitMethodId(id).structural.name


pure func trait_method_id_owner(id: TraitMethodId) -> TraitId:
	from TraitMethodId(id).owner


pure func trait_method_id_index(id: TraitMethodId) -> Int:
	from TraitMethodId(id).index


pure func trait_method_id_source_span(id: TraitMethodId) -> SourceSpan:
	from TraitMethodId(id).structural.span


private pure func declaration_id_structural(id: DeclarationId) -> StructuralDeclarationIdRep:
	match id:
		TypeDeclarationId(type_id):
			from TypeId(type_id)
		ConstructorDeclarationId(constructor_id):
			from ConstructorId(constructor_id).structural
		CallableDeclarationId(callable_id):
			from CallableId(callable_id).structural
		TraitDeclarationId(trait_id):
			from TraitId(trait_id).structural
		TraitMethodDeclarationId(method_id):
			from TraitMethodId(method_id).structural
		GlobalDeclarationId(global_id):
			from GlobalId(global_id)
		ImplementationDeclarationId(impl_id):
			from ImplId(impl_id).structural


private pure func skeleton_structural_id(
	skeleton: DeclarationSkeleton,
) -> StructuralDeclarationIdRep:
	declaration_id_structural(declaration_skeleton_id(skeleton))


pure func declaration_skeleton_id(skeleton: DeclarationSkeleton) -> DeclarationId:
	match skeleton:
		TypeDeclarationSkeleton(id, _, _):
			TypeDeclarationId(id)
		ConstructorDeclarationSkeleton(id, _, _, _):
			ConstructorDeclarationId(id)
		CallableDeclarationSkeleton(id, _, _):
			CallableDeclarationId(id)
		TraitDeclarationSkeleton(id, _, _):
			TraitDeclarationId(id)
		TraitMethodDeclarationSkeleton(id, _, _):
			TraitMethodDeclarationId(id)
		GlobalDeclarationSkeleton(id, _, _):
			GlobalDeclarationId(id)
		ImplementationDeclarationSkeleton(id, _, _):
			ImplementationDeclarationId(id)


pure func declaration_skeleton_kind(skeleton: DeclarationSkeleton) -> DeclarationSkeletonKind:
	match skeleton:
		TypeDeclarationSkeleton(_, _, _):
			TypeSkeletonKind
		ConstructorDeclarationSkeleton(_, _, _, _):
			ConstructorSkeletonKind
		CallableDeclarationSkeleton(_, _, _):
			CallableSkeletonKind
		TraitDeclarationSkeleton(_, _, _):
			TraitSkeletonKind
		TraitMethodDeclarationSkeleton(_, _, _):
			TraitMethodSkeletonKind
		GlobalDeclarationSkeleton(_, _, _):
			GlobalSkeletonKind
		ImplementationDeclarationSkeleton(_, _, _):
			ImplementationSkeletonKind


pure func declaration_skeleton_name(skeleton: DeclarationSkeleton) -> String:
	skeleton_structural_id(skeleton).name


pure func declaration_skeleton_visibility(skeleton: DeclarationSkeleton) -> DeclarationVisibility:
	match skeleton:
		TypeDeclarationSkeleton(_, visibility, _):
			visibility
		ConstructorDeclarationSkeleton(_, visibility, _, _):
			visibility
		CallableDeclarationSkeleton(_, visibility, _):
			visibility
		TraitDeclarationSkeleton(_, visibility, _):
			visibility
		TraitMethodDeclarationSkeleton(_, visibility, _):
			visibility
		GlobalDeclarationSkeleton(_, visibility, _):
			visibility
		ImplementationDeclarationSkeleton(_, visibility, _):
			visibility


pure func declaration_skeleton_source(skeleton: DeclarationSkeleton) -> DeclarationSource:
	match skeleton:
		TypeDeclarationSkeleton(_, _, source):
			TypeDeclarationSourceValue(source)
		ConstructorDeclarationSkeleton(_, _, parent_type_id, source):
			ConstructorDeclarationSourceValue(parent_type_id, source)
		CallableDeclarationSkeleton(_, _, source):
			CallableDeclarationSourceValue(source)
		TraitDeclarationSkeleton(_, _, source):
			TraitDeclarationSourceValue(source)
		TraitMethodDeclarationSkeleton(_, _, source):
			TraitMethodDeclarationSourceValue(source)
		GlobalDeclarationSkeleton(_, _, source):
			GlobalDeclarationSourceValue(source)
		ImplementationDeclarationSkeleton(_, _, source):
			ImplementationDeclarationSourceValue(source)


private pure func declaration_namespace_key(
	skeleton: DeclarationSkeleton,
) -> Option[DeclarationNamespaceKey]:
	match skeleton:
		TypeDeclarationSkeleton(id, _, _):
			Some(TypeNamespaceKey(type_id_module_identity(id), type_id_name(id)))
		TraitDeclarationSkeleton(id, _, _):
			Some(TraitNamespaceKey(trait_id_module_identity(id), trait_id_name(id)))
		ConstructorDeclarationSkeleton(_, _, parent_type_id, source):
			Some(ConstructorNamespaceKey(parent_type_id, source.name.text))
		_:
			None


private pure func declaration_namespace_keys_equal(
	left: DeclarationNamespaceKey,
	right: DeclarationNamespaceKey,
) -> Bool:
	match (left, right):
		(TypeNamespaceKey(left_module, left_name), TypeNamespaceKey(right_module, right_name)):
			left_name == right_name and module_identities_equal(left_module, right_module)
		(TraitNamespaceKey(left_module, left_name), TraitNamespaceKey(right_module, right_name)):
			left_name == right_name and module_identities_equal(left_module, right_module)
		(ConstructorNamespaceKey(left_parent, left_name), ConstructorNamespaceKey(right_parent, right_name)):
			left_name == right_name and type_ids_equal(left_parent, right_parent)
		_:
			False


private pure func duplicate_namespace_error(
	skeleton: DeclarationSkeleton,
) -> DeclarationSkeletonGraphError:
	structural = skeleton_structural_id(skeleton)

	match skeleton:
		TypeDeclarationSkeleton(_, _, _):
			DuplicateTypeDeclaration(structural.module_identity, structural.name, structural.span)
		TraitDeclarationSkeleton(_, _, _):
			DuplicateTraitDeclaration(structural.module_identity, structural.name, structural.span)
		ConstructorDeclarationSkeleton(_, _, parent_type_id, _):
			DuplicateConstructorDeclaration(parent_type_id, structural.name, structural.span)
		_:
			DuplicateDeclarationSkeleton(declaration_skeleton_id(skeleton))


private pure func function_skeleton_build_items(
	context: DeclarationSkeletonBuildContext,
	visibility: DeclarationVisibility,
	owner: Option[String],
	function_decl: ParsedFunctionDecl,
	source: CallableDeclarationSource,
) -> List[DeclarationSkeletonBuildItem]:
	key = func_callable_key(context.module_identity, function_decl.name.text, function_decl.span)

	match definition_index_find_func_callable_id(context.definition_index, key):
		None:
			[
				DeclarationSkeletonBuildError(
					CallableSkeletonMissingDefinition(
						context.module_identity,
						function_decl.name.text,
						function_decl.span,
					),
				),
			]
		Some(definition_id):
			structural = structural_declaration_id(
				context.module_identity,
				function_decl.name.text,
				owner,
				function_decl.span,
			)
			id = into CallableId(runtime_declaration_id(structural, definition_id))
			[DeclarationSkeletonCandidate(CallableDeclarationSkeleton(id, visibility, source))]


private pure func foreign_function_skeleton_build_items(
	context: DeclarationSkeletonBuildContext,
	visibility: DeclarationVisibility,
	function_decl: ParsedForeignFunctionDecl,
) -> List[DeclarationSkeletonBuildItem]:
	key = func_callable_key(context.module_identity, function_decl.name.text, function_decl.span)

	match definition_index_find_func_callable_id(context.definition_index, key):
		None:
			[
				DeclarationSkeletonBuildError(
					CallableSkeletonMissingDefinition(
						context.module_identity,
						function_decl.name.text,
						function_decl.span,
					),
				),
			]
		Some(definition_id):
			structural = structural_declaration_id(
				context.module_identity,
				function_decl.name.text,
				None,
				function_decl.span,
			)
			id = into CallableId(runtime_declaration_id(structural, definition_id))
			[
				DeclarationSkeletonCandidate(
					CallableDeclarationSkeleton(
						id,
						visibility,
						ForeignCallableSource(function_decl),
					),
				),
			]


private pure func union_skeleton_build_items(
	context: DeclarationSkeletonBuildContext,
	visibility: DeclarationVisibility,
	union_decl: ParsedUnionDecl,
) -> List[DeclarationSkeletonBuildItem]:
	type_structural = structural_declaration_id(
		context.module_identity,
		union_decl.name.text,
		None,
		union_decl.span,
	)
	type_id = into TypeId(type_structural)
	var items: List[DeclarationSkeletonBuildItem] = [
		DeclarationSkeletonCandidate(
			TypeDeclarationSkeleton(
				type_id,
				visibility,
				UnionTypeSource(union_decl),
			),
		),
	]

	for variant in union_decl.variants:
		key = source_definition_key(
			context.module_identity,
			ConstructorDefinition,
			variant.name.text,
			Some(union_decl.name.text),
			variant.span,
		)

		match definition_index_find_source_definition_id(context.definition_index, key):
			None:
				items = items.append(
					DeclarationSkeletonBuildError(
						ConstructorSkeletonMissingDefinition(
							context.module_identity,
							union_decl.name.text,
							variant.name.text,
							variant.span,
						),
					),
				)
			Some(definition_id):
				structural = structural_declaration_id(
					context.module_identity,
					variant.name.text,
					Some(union_decl.name.text),
					variant.span,
				)
				id = into ConstructorId(runtime_declaration_id(structural, definition_id))
				items = items.append(
					DeclarationSkeletonCandidate(
						ConstructorDeclarationSkeleton(
							id,
							visibility,
							type_id,
							variant,
						),
					),
				)

	items


private pure func trait_skeleton_build_items(
	context: DeclarationSkeletonBuildContext,
	visibility: DeclarationVisibility,
	trait_decl: ParsedTraitDecl,
) -> List[DeclarationSkeletonBuildItem]:
	key = source_definition_key(
		context.module_identity,
		TraitDefinition,
		trait_decl.name.text,
		None,
		trait_decl.span,
	)

	match definition_index_find_source_definition_id(context.definition_index, key):
		None:
			[
				DeclarationSkeletonBuildError(
					TraitSkeletonMissingDefinition(
						context.module_identity,
						trait_decl.name.text,
						trait_decl.span,
					),
				),
			]
		Some(definition_id):
			structural = structural_declaration_id(
				context.module_identity,
				trait_decl.name.text,
				None,
				trait_decl.span,
			)
			trait_id = into TraitId(runtime_declaration_id(structural, definition_id))
			var items: List[DeclarationSkeletonBuildItem] = [
				DeclarationSkeletonCandidate(
					TraitDeclarationSkeleton(
						trait_id,
						visibility,
						trait_decl,
					),
				),
			]

			var method_index: Int = 0

			for method in trait_decl.methods:
				-- The exact owner lives only in TraitMethodIdRep. Repeating
				-- its source name in the structural component would permit the two
				-- owner representations to disagree inside this module.
				method_structural = structural_declaration_id(
					context.module_identity,
					method.name.text,
					None,
					method.span,
				)
				method_id = into TraitMethodId({
						owner = trait_id,
						index = method_index,
						structural = method_structural
					})
				items = items.append(
					DeclarationSkeletonCandidate(
						TraitMethodDeclarationSkeleton(
							method_id,
							visibility,
							method,
						),
					),
				)
				method_index += 1

			items


private pure func implementation_skeleton_build_items(
	context: DeclarationSkeletonBuildContext,
	visibility: DeclarationVisibility,
	impl_decl: ParsedImplDecl,
) -> List[DeclarationSkeletonBuildItem]:
	key = source_definition_key(
		context.module_identity,
		ImplDefinition,
		impl_decl.trait_name.text,
		None,
		impl_decl.span,
	)

	match definition_index_find_source_definition_id(context.definition_index, key):
		None:
			[
				DeclarationSkeletonBuildError(
					ImplementationSkeletonMissingDefinition(
						context.module_identity,
						impl_decl.trait_name.text,
						impl_decl.span,
					),
				),
			]
		Some(definition_id):
			structural = structural_declaration_id(
				context.module_identity,
				impl_decl.trait_name.text,
				None,
				impl_decl.span,
			)
			impl_id = into ImplId(runtime_declaration_id(structural, definition_id))
			var items: List[DeclarationSkeletonBuildItem] = [
				DeclarationSkeletonCandidate(
					ImplementationDeclarationSkeleton(
						impl_id,
						visibility,
						impl_decl,
					),
				),
			]

			for default_binding in definition_index_func_callables_at_span(
				context.definition_index,
				context.module_identity,
				impl_decl.span,
			):
				(default_key, default_definition_id) = default_binding
				method_name = func_callable_key_name(default_key)
				default_structural = structural_declaration_id(
					context.module_identity,
					method_name,
					Some(impl_decl.trait_name.text),
					impl_decl.span,
				)
				default_runtime_id = runtime_declaration_id(
					default_structural,
					default_definition_id,
				)
				default_id = into CallableId(default_runtime_id)
				items = items.append(
					DeclarationSkeletonCandidate(
						CallableDeclarationSkeleton(
							default_id,
							visibility,
							DefaultImplementationMethodCallableSource(
								impl_id,
								method_name,
								impl_decl,
							),
						),
					),
				)

			for method in impl_decl.methods:
				items = items.concat(
					function_skeleton_build_items(
						context,
						visibility,
						Some(impl_decl.trait_name.text),
						method,
						ImplementationMethodCallableSource(impl_id, method),
					),
				)

			items


private pure func type_skeleton_build_items(
	context: DeclarationSkeletonBuildContext,
	visibility: DeclarationVisibility,
	name: String,
	span: SourceSpan,
	source: TypeDeclarationSource,
) -> List[DeclarationSkeletonBuildItem]:
	structural = structural_declaration_id(context.module_identity, name, None, span)
	id = into TypeId(structural)
	[DeclarationSkeletonCandidate(TypeDeclarationSkeleton(id, visibility, source))]


private pure func declaration_skeleton_build_items(
	context: DeclarationSkeletonBuildContext,
	visibility: DeclarationVisibility,
	decl: ParsedDecl,
) -> List[DeclarationSkeletonBuildItem]:
	match decl:
		RecordParsedDecl(record_decl):
			type_skeleton_build_items(
				context,
				visibility,
				record_decl.name.text,
				record_decl.span,
				RecordTypeSource(record_decl),
			)
		UnionParsedDecl(union_decl):
			union_skeleton_build_items(context, visibility, union_decl)
		BuiltinTypeParsedDecl(type_decl):
			type_skeleton_build_items(
				context,
				visibility,
				type_decl.name.text,
				type_decl.span,
				BuiltinTypeSource(type_decl),
			)
		TypeAliasParsedDecl(alias_decl):
			type_skeleton_build_items(
				context,
				visibility,
				alias_decl.name.text,
				alias_decl.span,
				AliasTypeSource(alias_decl),
			)
		FunctionParsedDecl(function_decl):
			function_skeleton_build_items(
				context,
				visibility,
				None,
				function_decl,
				FunctionCallableSource(function_decl),
			)
		ForeignBlockParsedDecl(_, functions, _):
			var items: List[DeclarationSkeletonBuildItem] = []

			for function_decl in functions:
				function_visibility = if (
					visibility == PrivateDeclaration
					or function_decl.is_private
				):
					PrivateDeclaration
				else:
					PublicDeclaration

				items = items.concat(
					foreign_function_skeleton_build_items(
						context,
						function_visibility,
						function_decl,
					),
				)

			items
		VarParsedDecl(var_decl):
			structural = structural_declaration_id(
				context.module_identity,
				var_decl.name.text,
				None,
				var_decl.span,
			)
			id = into GlobalId(structural)
			[DeclarationSkeletonCandidate(GlobalDeclarationSkeleton(id, visibility, var_decl))]
		TraitParsedDecl(trait_decl):
			trait_skeleton_build_items(context, visibility, trait_decl)
		ImplParsedDecl(impl_decl):
			implementation_skeleton_build_items(context, visibility, impl_decl)
		PrivateParsedDecl(inner, _):
			declaration_skeleton_build_items(context, PrivateDeclaration, inner)
		ImportBlockParsedDecl(_, _):
			[]
		ParsedErrorDecl(_):
			[]


private pure func module_skeleton_build_items(
	definition_index: DefinitionIndex,
	module: BoundModule,
) -> List[DeclarationSkeletonBuildItem]:
	program = bound_module_program(module)

	-- Parser recovery nodes preserve enough shape for diagnostics and tooling,
	-- but they are not valid semantic declarations. Excluding the whole invalid
	-- module here prevents later header phases from manufacturing secondary
	-- type errors from a syntax-recovery AST while independent modules continue.
	if parsed_program_has_errors(program):
		[]
	else:
		context: DeclarationSkeletonBuildContext = {
			module_identity = bound_module_identity(module),
			definition_index = definition_index
		}
		program.decls.flat_map(func(decl):
			declaration_skeleton_build_items(context, PublicDeclaration, decl)
		)


private pure func validate_skeleton_build_items(
	bound_graph: BoundModuleGraph,
	items: List[DeclarationSkeletonBuildItem],
) -> Result[DeclarationSkeletonGraph, List[DeclarationSkeletonGraphError]]:
	var skeletons: List[DeclarationSkeleton] = []
	var skeletons_by_name: Dict[String, List[DeclarationSkeleton]] = {}
	var errors: List[DeclarationSkeletonGraphError] = []

	for item in items:
		match item:
			DeclarationSkeletonBuildError(error):
				errors = errors.append(error)
			DeclarationSkeletonCandidate(skeleton):
				id = declaration_skeleton_id(skeleton)
				name = declaration_id_structural(id).name
				name_bucket = skeletons_by_name.get_or(name, [])
				exact_duplicate = name_bucket.any(
					func(existing): declaration_ids_equal(declaration_skeleton_id(existing), id),
				)
				namespace_key = declaration_namespace_key(skeleton)

				namespace_duplicate = match namespace_key:
					None:
						False
					Some(key):
						name_bucket.any(func(existing):
							match declaration_namespace_key(existing):
								Some(existing_key):
									declaration_namespace_keys_equal(existing_key, key)
								None:
									False
						)

				if namespace_duplicate:
					errors = errors.append(duplicate_namespace_error(skeleton))
				else if exact_duplicate:
					errors = errors.append(DuplicateDeclarationSkeleton(id))
				else:
					skeletons = skeletons.append(skeleton)
					skeletons_by_name = skeletons_by_name.set(
						name,
						name_bucket.append(skeleton),
					)

	if errors.length() > 0:
		Err(errors)
	else:
		representation: DeclarationSkeletonGraphRep = {
			bound_graph = bound_graph,
			skeletons = skeletons,
			skeletons_by_name = skeletons_by_name
		}
		Ok(into DeclarationSkeletonGraph(representation))


pure func declaration_skeleton_graph_build(
	bound_graph: BoundModuleGraph,
) -> Result[DeclarationSkeletonGraph, List[DeclarationSkeletonGraphError]]:
	definition_index = indexed_graph_definition_index(bound_module_graph_indexed_graph(bound_graph))
	var items = module_skeleton_build_items(
		definition_index,
		bound_module_graph_target(bound_graph),
	)

	for module in bound_module_graph_modules(bound_graph):
		items = items.concat(module_skeleton_build_items(definition_index, module))

	validate_skeleton_build_items(bound_graph, items)


private pure func declaration_skeleton_graph_rep(
	graph: DeclarationSkeletonGraph,
) -> DeclarationSkeletonGraphRep:
	from DeclarationSkeletonGraph(graph)


pure func declaration_skeleton_graph_bound_graph(
	graph: DeclarationSkeletonGraph,
) -> BoundModuleGraph:
	declaration_skeleton_graph_rep(graph).bound_graph


pure func declaration_skeleton_graph_skeletons(
	graph: DeclarationSkeletonGraph,
) -> List[DeclarationSkeleton]:
	declaration_skeleton_graph_rep(graph).skeletons


pure func declaration_skeleton_graph_type_skeletons(
	graph: DeclarationSkeletonGraph,
) -> List[TypeDeclarationSkeletonInfo]:
	var type_skeletons: List[TypeDeclarationSkeletonInfo] = []

	for skeleton in declaration_skeleton_graph_rep(graph).skeletons:
		match skeleton:
			TypeDeclarationSkeleton(id, visibility, source):
				type_skeletons = type_skeletons.append({
					id = id,
					visibility = visibility,
					source = source,
				})
			_:
				void

	type_skeletons


pure func declaration_skeleton_graph_constructor_skeletons(
	graph: DeclarationSkeletonGraph,
) -> List[ConstructorDeclarationSkeletonInfo]:
	var constructor_skeletons: List[ConstructorDeclarationSkeletonInfo] = []

	for skeleton in declaration_skeleton_graph_rep(graph).skeletons:
		match skeleton:
			ConstructorDeclarationSkeleton(id, visibility, parent_type_id, source):
				constructor_skeletons = constructor_skeletons.append({
					id = id,
					visibility = visibility,
					parent_type_id = parent_type_id,
					source = source,
				})
			_:
				void

	constructor_skeletons


