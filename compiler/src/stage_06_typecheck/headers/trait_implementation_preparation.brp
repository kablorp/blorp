-- Converts validated owner-local trait and implementation payloads into the
-- dual local/canonical entries retained by declaration authority. Resource
-- policy and callable targets come from the validated payload; this module
-- only canonicalizes accepted resolved type shapes.
import:
	../../stage_05_types/env:
		ImplInstance,
		ImplMethodInfo,
		Purity(Impure, Pure),
		TraitDef,
		TraitMethodSig,
		impl_instance_with_methods,
		trait_def_with_details,
	../../stage_05_types/semantic_type: SemanticType(SemanticFunctionType)
	../../stage_05_types/trait_implementation_authority:
		AcceptedImplementationAuthorityEntry,
		AcceptedImplementationMethodAuthorityEntry,
		AcceptedTraitAuthorityEntry,
		AcceptedTraitMethodAuthorityEntry,
	../modules/bound_module_graph: BoundModule, bound_module_canonical_path, bound_module_identity
	callable_signature:
		CallableSignature,
		callable_signature_is_pure,
		callable_signature_parameters,
		callable_signature_return_type,
	declaration_skeleton:
		callable_id_definition_id,
		callable_id_name,
		impl_id_definition_id,
		trait_id_definition_id,
		trait_id_name,
	implementation_headers:
		ImplementationHeader,
		ImplementationMethodHeader,
		explicit_implementation_method_dimension_constraints,
		explicit_implementation_method_signature,
		explicit_implementation_method_source,
		implementation_header_id,
		implementation_header_methods,
		implementation_header_receiver,
		implementation_header_receiver_head,
		implementation_header_trait_id,
		implementation_header_visibility,
		implementation_method_header_id,
	trait_headers:
		TraitMethodSlot,
		TraitTopologyHeader,
		trait_method_slot_id,
		trait_method_slot_name,
		trait_method_slot_signature,
		trait_topology_header_id,
		trait_topology_header_methods,
		trait_topology_header_parameters,
		trait_topology_header_supertraits,
		trait_topology_header_visibility,
		trait_type_parameter_name,
	trait_implementation_projection:
		accepted_authority_visibility_from_header,
		accepted_implementation_receiver_head_from_header,
		implementation_authority_identity_from_header_id,
		implementation_authority_method_identity_from_header_id,
		trait_authority_identity_from_header_id,
		trait_authority_method_identity_from_header_id,
	type_header_graph: ResolvedTypeShape, TypeHeaderGraph
	type_header_install: imported_semantic_type_from_resolved_shape


record ValidatedTraitAuthorityPayload {
	accepted_header: TraitTopologyHeader,
	owner_module: BoundModule,
	definition: TraitDef
}


record ValidatedImplementationAuthorityPayload {
	accepted_header: ImplementationHeader,
	owner_module: BoundModule,
	definition: ImplInstance
}


private pure func canonical_type(
	type_headers: TypeHeaderGraph,
	owner_module: BoundModule,
	shape: ResolvedTypeShape,
) -> Option[SemanticType]:
	imported_semantic_type_from_resolved_shape(
		type_headers,
		bound_module_identity(owner_module),
		bound_module_canonical_path(owner_module),
		shape,
	)


private pure func canonical_types(
	type_headers: TypeHeaderGraph,
	owner_module: BoundModule,
	shapes: List[ResolvedTypeShape],
) -> Option[List[SemanticType]]:
	var result: List[SemanticType] = []
	var failed: Bool = False

	for shape in shapes:
		if not failed:
			match canonical_type(type_headers, owner_module, shape):
				Some(typ):
					result = [typ].concat(result)
				None:
					failed = True

	if failed:
		None
	else:
		Some(result.reverse())


private pure func canonical_signature_types(
	type_headers: TypeHeaderGraph,
	owner_module: BoundModule,
	signature: CallableSignature,
) -> Option[(List[SemanticType], SemanticType)]:
	params ?= canonical_types(
		type_headers,
		owner_module,
		callable_signature_parameters(signature).map(func(parameter): parameter.typ),
	)
	return_type ?= canonical_type(
		type_headers,
		owner_module,
		callable_signature_return_type(signature),
	)
	Some((params, return_type))


private pure func prepare_trait_method(
	type_headers: TypeHeaderGraph,
	owner_module: BoundModule,
	slot: TraitMethodSlot,
	local: TraitMethodSig,
) -> Option[(AcceptedTraitMethodAuthorityEntry, AcceptedTraitMethodAuthorityEntry)]:
	if (
		local.name != trait_method_slot_name(slot)
		or local.is_pure != callable_signature_is_pure(trait_method_slot_signature(slot))
	):
		None
	else:
		canonical ?= canonical_signature_types(
			type_headers,
			owner_module,
			trait_method_slot_signature(slot),
		)
		identity = trait_authority_method_identity_from_header_id(trait_method_slot_id(slot))
		Some(
			(
				{
					identity = identity,
					signature = local
				},
				{
					identity = identity,
					signature = { local |
						params = canonical[0],
						return_type = canonical[1]
					}
				},
			),
		)


pure func prepare_trait_authority_entry(
	type_headers: TypeHeaderGraph,
	payload: ValidatedTraitAuthorityPayload,
) -> Result[AcceptedTraitAuthorityEntry, String]:
	header_id = trait_topology_header_id(payload.accepted_header)
	header_methods = trait_topology_header_methods(payload.accepted_header)
	header_parameter_names = trait_topology_header_parameters(
		payload.accepted_header,
	).map(trait_type_parameter_name)
	header_supertrait_names = trait_topology_header_supertraits(
		payload.accepted_header,
	).map(trait_id_name)

	if (
		payload.definition.def_id != trait_id_definition_id(header_id)
		or payload.definition.name != trait_id_name(header_id)
		or payload.definition.type_params != header_parameter_names
		or payload.definition.supertraits != header_supertrait_names
		or payload.definition.methods.length() != header_methods.length()
	):
		Err("validated trait authority payload does not match its accepted header")
	else:
		var local_methods: List[AcceptedTraitMethodAuthorityEntry] = []
		var canonical_methods: List[AcceptedTraitMethodAuthorityEntry] = []
		var failed: Bool = False
		var index: Int = 0

		while not failed and index < header_methods.length():
			match (header_methods.get(index), payload.definition.methods.get(index)):
				(Some(slot), Some(local)):
					match prepare_trait_method(type_headers, payload.owner_module, slot, local):
						Some(prepared):
							local_methods = [prepared[0]].concat(local_methods)
							canonical_methods = [prepared[1]].concat(canonical_methods)
						None:
							failed = True
				_:
					failed = True

			index += 1

		if failed:
			Err("validated trait method payload does not match its accepted header")
		else:
			ordered_local_methods = local_methods.reverse()
			ordered_canonical_methods = canonical_methods.reverse()
			Ok({
				identity = trait_authority_identity_from_header_id(header_id),
				definition = trait_def_with_details(
					payload.definition.def_id,
					payload.definition.name,
					payload.definition.type_params,
					payload.definition.supertraits,
					ordered_local_methods.map(func(method): method.signature),
					payload.definition.module_path,
				),
				canonical_definition = trait_def_with_details(
					payload.definition.def_id,
					payload.definition.name,
					payload.definition.type_params,
					payload.definition.supertraits,
					ordered_canonical_methods.map(func(method): method.signature),
					Some(bound_module_canonical_path(payload.owner_module)),
				),
				visibility = accepted_authority_visibility_from_header(
					trait_topology_header_visibility(payload.accepted_header),
				),
				supertraits = trait_topology_header_supertraits(
					payload.accepted_header,
				).map(trait_authority_identity_from_header_id),
				methods = ordered_local_methods,
				canonical_methods = ordered_canonical_methods,
			})


private pure func explicit_method_headers(
	accepted_header: ImplementationHeader,
) -> List[ImplementationMethodHeader]:
	implementation_header_methods(
		accepted_header,
	).filter(
		func(method): explicit_implementation_method_source(method).is_some(),
	)


private pure func local_implementation_methods_by_callable_id(
	methods: List[ImplMethodInfo],
) -> Result[Dict[Int, ImplMethodInfo], String]:
	var result: Dict[Int, ImplMethodInfo] = {}
	var issue: Option[String] = None

	for method in methods:
		if issue.is_none():
			match method.target:
				Some(target):
					if result.contains(target.callable_id):
						issue = Some("validated implementation payload has a duplicate callable ID")
					else:
						result = result.set(target.callable_id, method)
				None:
					issue = Some("validated explicit implementation method has no callable target")

	match issue:
		Some(message):
			Err(message)
		None:
			Ok(result)


private pure func canonical_dimension_constraints(
	type_headers: TypeHeaderGraph,
	owner_module: BoundModule,
	method: ImplementationMethodHeader,
) -> Option[List[(SemanticType, SemanticType)]]:
	var result: List[(SemanticType, SemanticType)] = []
	var failed: Bool = False

	for constraint in explicit_implementation_method_dimension_constraints(method):
		if not failed:
			left = canonical_type(type_headers, owner_module, constraint[0])
			right = canonical_type(type_headers, owner_module, constraint[1])

			match (left, right):
				(Some(left_type), Some(right_type)):
					result = [(left_type, right_type)].concat(result)
				_:
					failed = True

	if failed:
		None
	else:
		Some(result.reverse())


private pure func prepare_implementation_method(
	type_headers: TypeHeaderGraph,
	owner_module: BoundModule,
	accepted_header: ImplementationHeader,
	method_header: ImplementationMethodHeader,
	local: ImplMethodInfo,
) -> Option[(AcceptedImplementationMethodAuthorityEntry, AcceptedImplementationMethodAuthorityEntry)]:
	callable_id = implementation_method_header_id(method_header)
	signature ?= explicit_implementation_method_signature(method_header)
	canonical ?= canonical_signature_types(type_headers, owner_module, signature)
	canonical_dims ?= canonical_dimension_constraints(type_headers, owner_module, method_header)
	local_target ?= local.target

	local_is_pure = match local.purity:
		Pure:
			True
		Impure:
			False

	if (
		local_target.callable_id != callable_id_definition_id(callable_id)
		or local.name != callable_id_name(callable_id)
		or local_is_pure != callable_signature_is_pure(signature)
	):
		None
	else:
		identity = implementation_authority_method_identity_from_header_id(
			implementation_header_id(accepted_header),
			callable_id,
		)
		canonical_info = { local |
			target = Some(
				{ local_target | module_path = bound_module_canonical_path(owner_module) },
			),
			func_type = SemanticFunctionType(
				callable_signature_is_pure(signature),
				canonical[0],
				canonical[1],
			),
			dim_constraints = canonical_dims
		}
		Some(
			({
					identity = identity,
					info = local
				}, {
					identity = identity,
					info = canonical_info
				}),
		)


pure func prepare_implementation_authority_entry(
	type_headers: TypeHeaderGraph,
	payload: ValidatedImplementationAuthorityPayload,
) -> Result[AcceptedImplementationAuthorityEntry, String]:
	header_id = implementation_header_id(payload.accepted_header)
	explicit_headers = explicit_method_headers(payload.accepted_header)
	local_methods_result = local_implementation_methods_by_callable_id(payload.definition.methods)
	canonical_receiver = canonical_type(
		type_headers,
		payload.owner_module,
		implementation_header_receiver(payload.accepted_header),
	)

	if (
		payload.definition.def_id != impl_id_definition_id(header_id)
		or payload.definition.trait_name != trait_id_name(
			implementation_header_trait_id(payload.accepted_header),
		)
		or payload.definition.methods.length() != explicit_headers.length()
	):
		Err("validated implementation authority payload does not match its accepted header")
	else:
		match (local_methods_result, canonical_receiver):
			(Err(message), _):
				Err(message)
			(_, None):
				Err("accepted implementation receiver could not be canonicalized")
			(Ok(local_methods_by_id), Some(receiver)):
				var local_methods: List[AcceptedImplementationMethodAuthorityEntry] = []
				var canonical_methods: List[AcceptedImplementationMethodAuthorityEntry] = []
				var issue: Option[String] = None

				for method_header in explicit_headers:
					if issue.is_none():
						callable_id = implementation_method_header_id(method_header)

						match local_methods_by_id.get(callable_id_definition_id(callable_id)):
							None:
								issue = Some(
									"accepted implementation method has no exact validated callable payload",
								)
							Some(local):
								match prepare_implementation_method(
									type_headers,
									payload.owner_module,
									payload.accepted_header,
									method_header,
									local,
								):
									Some(prepared):
										local_methods = [prepared[0]].concat(local_methods)
										canonical_methods = [prepared[1]].concat(canonical_methods)
									None:
										issue = Some(
											"validated implementation method payload does not match its accepted header",
										)

				match issue:
					Some(message):
						Err(message)
					None:
						ordered_local_methods = local_methods.reverse()
						ordered_canonical_methods = canonical_methods.reverse()
						identity = implementation_authority_identity_from_header_id(header_id)
						Ok({
							identity = identity,
							trait_identity = trait_authority_identity_from_header_id(
								implementation_header_trait_id(payload.accepted_header),
							),
							definition = impl_instance_with_methods(
								payload.definition.def_id,
								payload.definition.trait_name,
								payload.definition.for_type,
								payload.definition.bounds,
								ordered_local_methods.map(func(method): method.info),
								payload.definition.is_builtin,
							),
							canonical_definition = impl_instance_with_methods(
								payload.definition.def_id,
								payload.definition.trait_name,
								receiver,
								payload.definition.bounds,
								ordered_canonical_methods.map(func(method): method.info),
								payload.definition.is_builtin,
							),
							receiver_head = accepted_implementation_receiver_head_from_header(
								implementation_header_receiver_head(payload.accepted_header),
							),
							visibility = accepted_authority_visibility_from_header(
								implementation_header_visibility(payload.accepted_header),
							),
							methods = ordered_local_methods,
							canonical_methods = ordered_canonical_methods,
						})
