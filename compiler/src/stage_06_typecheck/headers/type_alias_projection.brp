-- Canonical alias lookup is projected once from accepted type headers. A
-- selected module adds only its local and selective source spellings, sharing
-- the canonical dictionaries as fallback.
import:
	../../stage_04_modules/loaded_module: ModuleIdentity
	../../stage_05_types/semantic_type:
		SemanticType(SemanticNamedType, SemanticTypeVar),
		canonical_module_type_name,
		types_equal,
	../../stage_05_types/type_alias_index:
		TYPE_ALIAS_INDEX_EMPTY,
		TypeAliasIndex,
		type_alias_index_add_opaque,
		type_alias_index_add_transparent,
		type_alias_index_builtins,
		type_alias_index_entry_count,
		type_alias_index_find_transparent,
		type_alias_index_with_fallback,
	../graph/indexed_graph: prepared_module_scope_identity
	../modules/bound_module_graph:
		BoundModule,
		BoundModuleGraph,
		bound_module_canonical_path,
		bound_module_graph_modules,
		bound_module_graph_target,
		bound_module_identity,
		bound_module_view,
		bound_module_visible_import_modules,
	../modules/module_binding:
		ImportableModule,
		importable_module_path,
		importable_module_prepared_scope,
	../modules/module_view: ImportedNameBinding, module_view_imported_names
	declaration_skeleton: TypeId, type_id_name
	type_header_graph:
		AcceptedAliasHeader,
		AliasLayout(OpaqueAlias, TransparentAlias),
		TypeHeaderGraph,
		alias_type_header_id,
		alias_type_header_layout,
		alias_type_header_parameters,
		alias_type_header_target,
		builtin_type_header_id,
		builtin_type_header_parameters,
		record_type_header_id,
		record_type_header_parameters,
		type_header_graph_local_alias_headers,
		type_header_graph_public_alias_headers,
		type_header_graph_public_builtin_headers,
		type_header_graph_public_record_headers,
		type_header_graph_public_union_headers,
		union_type_header_id,
		union_type_header_parameters,
	type_header_install:
		imported_semantic_type_from_resolved_shape,
		local_semantic_type_from_resolved_shape,
	type_parameter_headers: ResolvedTypeParameter, type_parameter_id_name


private record TypeAliasProjectionRep {
	canonical_index: TypeAliasIndex
}


opaque type TypeAliasProjection = TypeAliasProjectionRep


private pure func type_alias_projection_rep(
	projection: TypeAliasProjection,
) -> TypeAliasProjectionRep:
	from TypeAliasProjection(projection)


pure func type_alias_projection_find(
	projection: TypeAliasProjection,
	type_headers: TypeHeaderGraph,
	bound_module: BoundModule,
) -> Result[TypeAliasIndex, String]:
	type_alias_index_for_module(
		type_headers,
		bound_module,
		type_alias_projection_rep(projection).canonical_index,
	)


pure func type_alias_projection_canonical_index(projection: TypeAliasProjection) -> TypeAliasIndex:
	type_alias_projection_rep(projection).canonical_index


private pure func parameter_names(parameters: List[ResolvedTypeParameter]) -> List[String]:
	parameters.map(func(parameter): type_parameter_id_name(parameter.id))


private pure func has_imported_name_bindings_for_module(
	bindings: List[ImportedNameBinding],
	module_path: String,
) -> Bool:
	bindings.any(func(binding): binding.module_path == module_path)


private pure func add_transparent_alias(
	index: TypeAliasIndex,
	name: String,
	type_params: List[String],
	target: SemanticType,
) -> Result[TypeAliasIndex, String]:
	match type_alias_index_find_transparent(index, name):
		Some(existing):
			if existing.type_params == type_params and types_equal(existing.target, target):
				Ok(index)
			else:
				Err("conflicting type alias projection for '" + name + "'")
		None:
			match type_alias_index_add_transparent(index, name, type_params, target):
				Some(next):
					Ok(next)
				None:
					Err("duplicate type alias projection for '" + name + "'")


private pure func add_opaque_alias(
	index: TypeAliasIndex,
	name: String,
	type_params: List[String],
	target: SemanticType,
	home_module: String,
) -> Result[TypeAliasIndex, String]:
	match type_alias_index_add_opaque(index, name, type_params, target, Some(home_module)):
		Some(next):
			Ok(next)
		None:
			Err("duplicate opaque type alias projection for '" + name + "'")


private pure func add_selective_import_aliases(
	index: TypeAliasIndex,
	bindings: List[ImportedNameBinding],
	module_path: String,
	id: TypeId,
	parameters: List[ResolvedTypeParameter],
) -> Result[TypeAliasIndex, String]:
	source_name = type_id_name(id)
	type_params = parameter_names(parameters)
	canonical_name = canonical_module_type_name(module_path, source_name)
	target = SemanticNamedType(
		canonical_name,
		type_params.map(func(type_param): SemanticTypeVar(type_param)),
	)
	var next = index
	var issue: Option[String] = None

	for binding in bindings:
		if (
			issue.is_none()
			and binding.module_path == module_path
			and binding.original_name == source_name
			and binding.local_name != canonical_name
		):
			match add_transparent_alias(next, binding.local_name, type_params, target):
				Ok(updated):
					next = updated
				Err(message):
					issue = Some(message)

	match issue:
		Some(message):
			Err(message)
		None:
			Ok(next)


private pure func add_local_alias_header(
	index: TypeAliasIndex,
	type_headers: TypeHeaderGraph,
	module_identity: ModuleIdentity,
	module_path: String,
	header: AcceptedAliasHeader,
) -> Result[TypeAliasIndex, String]:
	match local_semantic_type_from_resolved_shape(
		type_headers,
		module_identity,
		module_path,
		alias_type_header_target(header),
	):
		Some(target):
			name = type_id_name(alias_type_header_id(header))
			type_params = parameter_names(alias_type_header_parameters(header))

			match alias_type_header_layout(header):
				TransparentAlias:
					add_transparent_alias(index, name, type_params, target)
				OpaqueAlias:
					add_opaque_alias(index, name, type_params, target, module_path)
		None:
			Err("type alias projection could not resolve a local alias target")


private pure func add_imported_alias_header(
	index: TypeAliasIndex,
	module_path: String,
	bindings: List[ImportedNameBinding],
	header: AcceptedAliasHeader,
) -> Result[TypeAliasIndex, String]:
	add_selective_import_aliases(
		index,
		bindings,
		module_path,
		alias_type_header_id(header),
		alias_type_header_parameters(header),
	)


private pure func add_canonical_alias_header(
	index: TypeAliasIndex,
	type_headers: TypeHeaderGraph,
	module_identity: ModuleIdentity,
	module_path: String,
	header: AcceptedAliasHeader,
) -> Result[TypeAliasIndex, String]:
	match imported_semantic_type_from_resolved_shape(
		type_headers,
		module_identity,
		module_path,
		alias_type_header_target(header),
	):
		Some(target):
			name = canonical_module_type_name(
				module_path,
				type_id_name(alias_type_header_id(header)),
			)
			type_params = parameter_names(alias_type_header_parameters(header))

			match alias_type_header_layout(header):
				TransparentAlias:
					add_transparent_alias(index, name, type_params, target)
				OpaqueAlias:
					add_opaque_alias(index, name, type_params, target, module_path)
		None:
			Err("type alias projection could not resolve a canonical alias target")


private pure func add_imported_non_alias_type_headers(
	index: TypeAliasIndex,
	type_headers: TypeHeaderGraph,
	module_identity: ModuleIdentity,
	module_path: String,
	bindings: List[ImportedNameBinding],
) -> Result[TypeAliasIndex, String]:
	var next = index
	var issue: Option[String] = None

	for header in type_header_graph_public_builtin_headers(type_headers, module_identity):
		if issue.is_none():
			match add_selective_import_aliases(
				next,
				bindings,
				module_path,
				builtin_type_header_id(header),
				builtin_type_header_parameters(header),
			):
				Ok(updated):
					next = updated
				Err(message):
					issue = Some(message)

	for header in type_header_graph_public_record_headers(type_headers, module_identity):
		if issue.is_none():
			match add_selective_import_aliases(
				next,
				bindings,
				module_path,
				record_type_header_id(header),
				record_type_header_parameters(header),
			):
				Ok(updated):
					next = updated
				Err(message):
					issue = Some(message)

	for header in type_header_graph_public_union_headers(type_headers, module_identity):
		if issue.is_none():
			match add_selective_import_aliases(
				next,
				bindings,
				module_path,
				union_type_header_id(header),
				union_type_header_parameters(header),
			):
				Ok(updated):
					next = updated
				Err(message):
					issue = Some(message)

	match issue:
		Some(message):
			Err(message)
		None:
			Ok(next)


private pure func add_imported_module_aliases(
	index: TypeAliasIndex,
	type_headers: TypeHeaderGraph,
	module: ImportableModule,
	bindings: List[ImportedNameBinding],
) -> Result[TypeAliasIndex, String]:
	module_identity = prepared_module_scope_identity(importable_module_prepared_scope(module))
	module_path = importable_module_path(module)

	if not has_imported_name_bindings_for_module(bindings, module_path):
		Ok(index)
	else:
		var next = index
		var issue: Option[String] = None

		for header in type_header_graph_public_alias_headers(type_headers, module_identity):
			if issue.is_none():
				match add_imported_alias_header(next, module_path, bindings, header):
					Ok(updated):
						next = updated
					Err(message):
						issue = Some(message)

		match issue:
			Some(message):
				Err(message)
			None:
				add_imported_non_alias_type_headers(
					next,
					type_headers,
					module_identity,
					module_path,
					bindings,
				)


private pure func type_alias_index_for_module(
	type_headers: TypeHeaderGraph,
	bound_module: BoundModule,
	canonical_index: TypeAliasIndex,
) -> Result[TypeAliasIndex, String]:
	module_identity = bound_module_identity(bound_module)
	module_path = bound_module_canonical_path(bound_module)
	bindings = module_view_imported_names(bound_module_view(bound_module))
	var index = TYPE_ALIAS_INDEX_EMPTY
	var issue: Option[String] = None

	for header in type_header_graph_local_alias_headers(type_headers, module_identity):
		if issue.is_none():
			match add_local_alias_header(index, type_headers, module_identity, module_path, header):
				Ok(updated):
					index = updated
				Err(message):
					issue = Some(message)

	for imported_module in bound_module_visible_import_modules(bound_module):
		if issue.is_none():
			match add_imported_module_aliases(index, type_headers, imported_module, bindings):
				Ok(updated):
					index = updated
				Err(message):
					issue = Some(message)

	match issue:
		Some(message):
			Err(message)
		None:
			if type_alias_index_entry_count(index) == 0:
				Ok(canonical_index)
			else:
				Ok(type_alias_index_with_fallback(index, canonical_index))


private pure func canonical_type_alias_index(
	type_headers: TypeHeaderGraph,
	modules: List[BoundModule],
) -> Result[TypeAliasIndex, List[String]]:
	var index = type_alias_index_builtins()
	var errors: List[String] = []

	for module in modules:
		module_identity = bound_module_identity(module)
		module_path = bound_module_canonical_path(module)

		for header in type_header_graph_public_alias_headers(type_headers, module_identity):
			match add_canonical_alias_header(
				index,
				type_headers,
				module_identity,
				module_path,
				header,
			):
				Ok(updated):
					index = updated
				Err(message):
					errors = errors.append(message)

	if errors.is_empty():
		Ok(index)
	else:
		Err(errors)


pure func type_alias_projection_build(
	type_headers: TypeHeaderGraph,
	bound_graph: BoundModuleGraph,
) -> Result[TypeAliasProjection, List[String]]:
	modules = [
		bound_module_graph_target(bound_graph),
	].concat(bound_module_graph_modules(bound_graph))
	canonical_index ?= canonical_type_alias_index(type_headers, modules)
	Ok(into TypeAliasProjection({canonical_index = canonical_index}))
