foreign:
	pure func typed_program_is_unique(program: TypedProgram) -> Bool = "blorp_is_unique"


private union TypecheckBridgeDispatchError:
	MissingStringField(String)
	ExpectedRequestField(String, String)
	UnsupportedBridgeAction(BridgeAction)


record TypecheckImportModule {
	path: String,
	module_name: String,
	module_path: String,
	text: String,
	typecheck_program: Option[FinalizedTypecheckProgram],
	origin: ModuleOrigin
}


record TypecheckResolvedImport {
	from_path: String,
	from_module: String,
	import_path: String,
	resolved_module: String
}


record TypecheckGraphRequest {
	target: TypecheckImportModule,
	modules: List[TypecheckImportModule],
	module_targets: List[String],
	resolved_imports: List[TypecheckResolvedImport],
	include_comments: Bool,
	allow_debug_only_calls: Bool
}


private pure func typecheck_request_origin_json(origin: ModuleOrigin) -> JsonValue:
	match origin:
		UserModule:
			JsonObject([("kind", JsonString("user"))])
		StdlibModule:
			JsonObject([("kind", JsonString("std"))])
		SourcePackageModule(package):
			JsonObject([
				("kind", JsonString("source_package")),
				("package", JsonString(package)),
			])
		NativePackageModule(package):
			JsonObject([
				("kind", JsonString("pkg")),
				("package", JsonString(package)),
			])


private pure func typecheck_request_module_json(module: TypecheckImportModule) -> JsonValue:
	JsonObject([
		("path", JsonString(module.path)),
		("module", JsonString(module.module_name)),
		("module_path", JsonString(module.module_path)),
		("text", JsonString(module.text)),
		("origin", typecheck_request_origin_json(module.origin)),
	])


private pure func typecheck_request_resolved_import_json(
	resolved: TypecheckResolvedImport,
) -> JsonValue:
	JsonObject([
		("from_path", JsonString(resolved.from_path)),
		("from_module", JsonString(resolved.from_module)),
		("import_path", JsonString(resolved.import_path)),
		("resolved_module", JsonString(resolved.resolved_module)),
	])


-- This envelope is the stable replay boundary: finalized parse programs are
-- deliberately omitted because replay reconstructs them from the raw text.
pure func typecheck_graph_request_json(request: TypecheckGraphRequest) -> JsonValue:
	JsonObject([
		("schema", JsonNumber(to_float(BRIDGE_SCHEMA_VERSION))),
		("domain", JsonString("compiler")),
		("action", JsonString(bridge_action_name(TypecheckGraphAction))),
		("payload", JsonObject([
			("target", typecheck_request_module_json(request.target)),
			("modules", JsonVector(request.modules.map(typecheck_request_module_json))),
			("module_targets", JsonVector(request.module_targets.map(
					func(path): JsonString(path),
				))),
			(
				"resolved_imports",
				JsonVector(request.resolved_imports.map(typecheck_request_resolved_import_json)),
			),
			("include_comments", JsonBool(request.include_comments)),
			("allow_debug_only_calls", JsonBool(request.allow_debug_only_calls)),
		])),
	])


-- Retain only CTFE dependencies shared by requested artifacts. Completed typed
-- artifacts remain streamed and are not retained by this graph value.
private record ReusableCtfeArtifact {
	imported_program: CtfeImportedProgram,
	complete_program: TypedProgram
}


private union PreparedCtfeProgram:
	ReusableCtfeProgram(ReusableCtfeArtifact)
	SelectiveCtfeProgram(CtfeImportedProgram, Option[List[BodyCheckOutcome]])
	EagerCtfeOnlyProgram(CtfeImportedProgram)
	FailedCtfeProgram


enum CtfeEagerFallbackKind:
	CtfeNoEagerFallback
	CtfeNoCallableRootsFallback
	CtfeMissingCheckedBodyFallback
	CtfeUnresolvedTraitDispatchFallback
	CtfeMissingBodyRegistryFallback
	CtfeRejectedBodyFallback
	CtfeQueueInvariantFallback
	CtfePreparationFailureFallback
	CtfeRecoverableGraphFallback
	CtfeTracedGraphFallback


private record PreparedCtfeDependency {
	module_path: String,
	program: PreparedCtfeProgram,
	body_checks: Int
}


private record PreparedCtfeDependencies {
	modules: List[PreparedCtfeDependency],
	target_body_outcomes: Option[List[BodyCheckOutcome]],
	target_discovery_body_checks: Int,
	eager_fallback: CtfeEagerFallbackKind
}


private record CtfeImportedProgramBuild {
	program: Option[CtfeImportedProgram],
	complete_program: Option[TypedProgram],
	body_checks: Int
}


private record PreparedCtfeProgramBuild {
	program: PreparedCtfeProgram,
	body_checks: Int
}


private union SelectiveCtfeDependencyPreparation:
	SelectiveCtfeDependenciesReady(List[PreparedCtfeDependency], Option[List[BodyCheckOutcome]], Int)
	SelectiveCtfeDependenciesRequireEager(CtfeEagerFallbackKind, Int, Int)


private record CtfeDependencyOrder {
	visited_paths: List[String],
	dependencies: List[PreparedModule]
}


private record PreparedTargetImportReachability {
	importing_module_paths: Dict[String, Bool],
	prelude_imports_target: Bool
}


private NO_PREPARED_MODULE_INDEX: Int = -1


private union BodyTypecheckGraph:
	AcceptedBodyTypecheckGraph(AcceptedTypecheckGraph)
	RecoverableBodyTypecheckGraph(RecoverableTypecheckGraph)


private record PreparedTypecheckContext {
	all_modules: List[PreparedModule],
	ctfe_dependencies: List[PreparedCtfeDependency],
	target_ctfe_body_outcomes: Option[List[BodyCheckOutcome]],
	target_ctfe_discovery_body_checks: Int,
	ctfe_eager_fallback: CtfeEagerFallbackKind,
	typecheck_graph: BodyTypecheckGraph
}


private record PreparedTypecheckModule {
	bound_module: BoundModule,
	context: PreparedTypecheckContext
}


private record PreparedTypecheckGraph {
	target: PreparedTypecheckModule,
	modules: List[PreparedTypecheckModule]
}


private union RejectedTypecheckTarget:
	RejectedCandidateTarget(ModuleLoadCandidate)
	RejectedPreparedTarget(PreparedModule)


private union PreparedTypecheckGraphResult:
	PreparedTypecheckGraphReady(PreparedTypecheckGraph)
	PreparedTypecheckGraphRejected(RejectedTypecheckTarget, List[TypecheckDiagnostic])


private pure func rejected_target_path(target: RejectedTypecheckTarget) -> String:
	match target:
		RejectedCandidateTarget(candidate):
			module_load_candidate_canonical_path(candidate)
		RejectedPreparedTarget(module):
			prepared_module_canonical_path(module)


private pure func rejected_target_program(target: RejectedTypecheckTarget) -> ParsedProgram:
	match target:
		RejectedCandidateTarget(candidate):
			module_load_candidate_program(candidate)
		RejectedPreparedTarget(module):
			prepared_module_program(module)


private pure func rejected_target_origin(target: RejectedTypecheckTarget) -> ModuleOrigin:
	match target:
		RejectedCandidateTarget(candidate):
			module_load_candidate_origin(candidate)
		RejectedPreparedTarget(module):
			prepared_module_origin(module)


private pure func prepared_typecheck_context(
	all_modules: List[PreparedModule],
	ctfe_dependencies: PreparedCtfeDependencies,
	typecheck_graph: BodyTypecheckGraph,
) -> PreparedTypecheckContext:
	{
		all_modules = all_modules,
		ctfe_dependencies = ctfe_dependencies.modules,
		target_ctfe_body_outcomes = ctfe_dependencies.target_body_outcomes,
		target_ctfe_discovery_body_checks = ctfe_dependencies.target_discovery_body_checks,
		ctfe_eager_fallback = ctfe_dependencies.eager_fallback,
		typecheck_graph = typecheck_graph
	}


private pure func prepared_typecheck_module(
	bound_module: BoundModule,
	context: PreparedTypecheckContext,
) -> PreparedTypecheckModule:
	{
		bound_module = bound_module,
		context = context
	}


private pure func bound_module_graph_error_messages(
	errors: List[BoundModuleGraphError],
) -> List[String]:
	errors.map(bound_module_graph_error_message)


private pure func validated_type_alias_dependencies(
	bound_graph: BoundModuleGraph,
) -> Result[AcyclicTypeAliasDependencyGraph, List[String]]:
	match declaration_skeleton_graph_build(bound_graph):
		Err(errors):
			Err(errors.map(declaration_skeleton_graph_error_message))
		Ok(graph):
			type_alias_dependency_graph_validate(graph)


private pure func typecheck_diagnostics_from_messages(
	messages: List[String],
) -> List[TypecheckDiagnostic]:
	messages.map(func(message): typecheck_diagnostic(message, None))


private pure func validated_type_headers(
	bound_graph: BoundModuleGraph,
) -> Result[TypeHeaderGraph, List[TypecheckDiagnostic]]:
	match validated_type_alias_dependencies(bound_graph):
		Err(errors):
			Err(typecheck_diagnostics_from_messages(errors))
		Ok(alias_dependencies):
			match resolved_type_parameter_graph_build(alias_dependencies):
				Err(errors):
					Err(
						typecheck_diagnostics_from_messages(
							errors.map(resolved_type_parameter_graph_error_message),
						),
					)
				Ok(parameters):
					match type_header_graph_build(parameters):
						Err(errors):
							Err(
								errors.map(func(error):
									typecheck_diagnostic(
										type_header_error_message(error),
										type_header_error_span(error),
									)
								),
							)
						Ok(headers):
							Ok(headers)


private pure func validated_trait_topology(
	bound_graph: BoundModuleGraph,
) -> Result[TraitTopologyGraph, List[TypecheckDiagnostic]]:
	match validated_type_headers(bound_graph):
		Err(errors):
			Err(errors)
		Ok(type_headers):
			match trait_topology_graph_build(type_headers):
				Err(errors):
					Err(
						errors.map(func(error):
							typecheck_diagnostic(
								trait_topology_graph_error_message(error),
								trait_topology_graph_error_span(error),
							)
						),
					)
				Ok(topology):
					Ok(topology)


private pure func validated_callable_headers(
	bound_graph: BoundModuleGraph,
) -> Result[CallableHeaderGraph, List[TypecheckDiagnostic]]:
	match validated_trait_topology(bound_graph):
		Err(errors):
			Err(errors)
		Ok(topology):
			match callable_header_graph_build(topology):
				Err(errors):
					Err(
						errors.map(func(error):
							typecheck_diagnostic(
								callable_header_graph_error_message(error),
								callable_header_graph_error_span(error),
							)
						),
					)
				Ok(headers):
					Ok(headers)


private pure func validated_implementation_headers(
	bound_graph: BoundModuleGraph,
) -> Result[ImplementationHeaderGraph, List[TypecheckDiagnostic]]:
	match validated_callable_headers(bound_graph):
		Err(errors):
			Err(errors)
		Ok(callable_headers):
			match implementation_header_graph_build(callable_headers):
				Err(errors):
					Err(
						errors.map(func(error):
							typecheck_diagnostic(
								implementation_header_graph_error_message(error),
								Some(implementation_header_graph_error_span(error)),
							)
						),
					)
				Ok(headers):
					Ok(headers)


private pure func bind_typecheck_graph(
	indexed_graph: IndexedGraph,
	module_paths: List[String],
	importable_index: ImportableModuleIndex,
	allow_debug_only_calls: Bool,
) -> Result[BoundModuleGraph, List[BoundModuleGraphError]]:
	bound_module_graph_build(
		indexed_graph,
		module_paths,
		func(scope): typecheck_bind_program_module_view(
			graph_typecheck_state(scope, allow_debug_only_calls),
			prepared_module_program(prepared_module_scope_module(scope)),
			importable_index,
			prepared_module_scope_canonical_path(scope),
		),
	)


private pure func bind_standalone_typecheck_graph(
	indexed_graph: IndexedGraph,
	allow_debug_only_calls: Bool,
) -> Result[BoundModuleGraph, List[BoundModuleGraphError]]:
	bound_module_graph_build(
		indexed_graph,
		[],
		func(scope): typecheck_bind_standalone_program_module_view(
			graph_typecheck_state(scope, allow_debug_only_calls),
			prepared_module_program(prepared_module_scope_module(scope)),
		),
	)


private pure func append_unique_binding_module_paths(
	paths: List[String],
	modules: List[PreparedModule],
) -> List[String]:
	var result = paths

	for module in modules:
		module_path = prepared_module_canonical_path(module)

		if not result.contains(module_path):
			result = result.append(module_path)

	result


private pure func selected_bound_modules(
	bound_graph: BoundModuleGraph,
	selected_paths: List[String],
) -> List[BoundModule]:
	bound_module_graph_modules(
		bound_graph,
	).filter(
		func(module): selected_paths.contains(bound_module_canonical_path(module)),
	)


record TypecheckedModule {
	path: String,
	module_name: String,
	module_path: String,
	module_identity: ModuleIdentity,
	parsed_program: ParsedProgram,
	module_surface: ModuleSurface,
	semantic_program: TypedProgram,
	typed_program: TypedProgram,
	errors: List[String],
	diagnostics: List[TypecheckDiagnostic],
	import_bindings: List[ImportBinding],
	ctfe_evaluated: Bool
}


record TypecheckedGraph {
	target: TypecheckedModule,
	modules: List[TypecheckedModule],
	next_def_id: Int,
	analysis_context: Option[String]
}


struct CtfeMaterializationMetrics {
	dependency_body_checks: Int,
	target_discovery_body_checks: Int,
	reused_body_checks: Int,
	selective_dependency_modules: Int,
	eager_dependency_modules: Int,
	failed_dependency_modules: Int,
	eager_fallback: CtfeEagerFallbackKind
}


record TypecheckGraphRun {
	graph: TypecheckedGraph,
	ctfe: CtfeMaterializationMetrics
}


private enum TypecheckCtfeStatus:
	TypecheckCtfeEvaluated
	TypecheckCtfeNotRun


private record TypecheckCtfeArtifact {
	semantic_program: TypedProgram,
	program: TypedProgram,
	errors: List[String],
	diagnostics: List[TypecheckDiagnostic],
	import_bindings: List[ImportBinding],
	status: TypecheckCtfeStatus
}


private enum TypecheckedGraphModuleOrigin:
	FreshGraphModule
	ReusedCtfeGraphModule


private struct TypecheckedProgramOwnership {
	after_typecheck_unique: Bool,
	after_ctfe_unique: Bool,
	after_module_construction_unique: Bool
}


private record TypecheckedGraphModuleResult {
	module: TypecheckedModule,
	origin: TypecheckedGraphModuleOrigin,
	ownership: Option[TypecheckedProgramOwnership],
	reused_bodies: Int
}


private record TypecheckedPreparedModuleResult {
	module: TypecheckedModule,
	ownership: Option[TypecheckedProgramOwnership]
}


private record SeededTypecheckedModule {
	module: TypecheckedModule,
	reused_bodies: Int
}


private pure func dispatch_error_code(error: TypecheckBridgeDispatchError) -> String:
	match error:
		MissingStringField(_):
			"invalid_request"
		ExpectedRequestField(_, _):
			"invalid_request"
		UnsupportedBridgeAction(_):
			"unsupported_action"


private pure func dispatch_error_message(error: TypecheckBridgeDispatchError) -> String:
	match error:
		MissingStringField(field_name):
			"missing string field `${field_name}`"
		ExpectedRequestField(field_name, expected):
			"field `${field_name}` must be ${expected}"
		UnsupportedBridgeAction(action):
			"unsupported Blorp typecheck bridge action: ${bridge_action_name(action)}"


private pure func dispatch_error_json(error: TypecheckBridgeDispatchError) -> JsonValue:
	bridge_failure_json(dispatch_error_code(error), dispatch_error_message(error))


private pure func string_field(
	value: JsonValue,
	field_name: String,
) -> Result[String, TypecheckBridgeDispatchError]:
	field ?= get_field(value, field_name).to_result(MissingStringField(field_name))
	as_string(field).to_result(ExpectedRequestField(field_name, "a string"))


private pure func optional_string_field(
	value: JsonValue,
	field_name: String,
) -> Result[Option[String], TypecheckBridgeDispatchError]:
	match get_field(value, field_name):
		Some(field):
			as_string(field)
				.map(func(text): Some(text))
				.to_result(ExpectedRequestField(field_name, "a string"))
		None:
			Ok(None)


private pure func optional_bool_field(value: JsonValue, field_name: String, default: Bool) -> Bool:
	match get_field(value, field_name):
		Some(field):
			as_bool(field).get_or(default)
		None:
			default


private pure func module_origin_from_json(
	value: JsonValue,
) -> Result[ModuleOrigin, TypecheckBridgeDispatchError]:
	match value:
		JsonObject(_):
			kind ?= string_field(value, "kind")

			match kind:
				"user":
					Ok(UserModule)
				"std":
					Ok(StdlibModule)
				"source_package":
					package ?= string_field(value, "package")
					Ok(SourcePackageModule(package))
				"pkg":
					package ?= string_field(value, "package")
					Ok(NativePackageModule(package))
				_:
					Err(
						ExpectedRequestField(
							"origin.kind",
							"one of user, std, source_package, pkg",
						),
					)
		_:
			Err(ExpectedRequestField("origin", "an object"))


private pure func optional_origin_field(
	value: JsonValue,
) -> Result[ModuleOrigin, TypecheckBridgeDispatchError]:
	match get_field(value, "origin"):
		Some(origin):
			module_origin_from_json(origin)
		None:
			Ok(UserModule)


private pure func import_module_from_json(
	value: JsonValue,
) -> Result[TypecheckImportModule, TypecheckBridgeDispatchError]:
	match value:
		JsonObject(_):
			path ?= string_field(value, "path")
			module_name ?= string_field(value, "module")
			maybe_module_path ?= optional_string_field(value, "module_path")
			text ?= string_field(value, "text")
			origin ?= optional_origin_field(value)

			Ok({
				path = path,
				module_name = module_name,
				module_path = maybe_module_path.get_or(module_name),
				text = text,
				typecheck_program = None,
				origin = origin,
			})
		_:
			Err(ExpectedRequestField("import_modules item", "an object"))


private pure func import_modules_named_field(
	value: JsonValue,
	field_name: String,
) -> Result[List[TypecheckImportModule], TypecheckBridgeDispatchError]:
	match get_field(value, field_name):
		None:
			Ok([])
		Some(field):
			items ?= as_array(field).to_result(ExpectedRequestField(field_name, "an array"))
			var modules: List[TypecheckImportModule] = []
			var error: Option[TypecheckBridgeDispatchError] = None

			for item in items:
				match error:
					Some(_):
						break
					None:
						match import_module_from_json(item):
							Ok(module):
								modules = modules.append(module)
							Err(err):
								error = Some(err)

			match error:
				Some(err):
					Err(err)
				None:
					Ok(modules)


private pure func import_module_named_field(
	value: JsonValue,
	field_name: String,
) -> Result[TypecheckImportModule, TypecheckBridgeDispatchError]:
	field ?= get_field(value, field_name).to_result(ExpectedRequestField(field_name, "an object"))
	import_module_from_json(field)


private pure func string_list_named_field(
	value: JsonValue,
	field_name: String,
) -> Result[List[String], TypecheckBridgeDispatchError]:
	field ?= get_field(value, field_name).to_result(ExpectedRequestField(field_name, "an array"))
	items ?= as_array(field).to_result(ExpectedRequestField(field_name, "an array"))
	var strings: List[String] = []
	var error: Option[TypecheckBridgeDispatchError] = None

	for item in items:
		match error:
			Some(_):
				break
			None:
				match as_string(item):
					Some(text):
						strings = strings.append(text)
					None:
						error = Some(ExpectedRequestField(field_name, "an array of strings"))

	match error:
		Some(err):
			Err(err)
		None:
			Ok(strings)


private pure func resolved_import_from_json(
	value: JsonValue,
) -> Result[TypecheckResolvedImport, TypecheckBridgeDispatchError]:
	match value:
		JsonObject(_):
			from_path ?= string_field(value, "from_path")
			from_module ?= string_field(value, "from_module")
			import_path ?= string_field(value, "import_path")
			resolved_module ?= string_field(value, "resolved_module")

			Ok({
				from_path = from_path,
				from_module = from_module,
				import_path = import_path,
				resolved_module = resolved_module,
			})
		_:
			Err(ExpectedRequestField("resolved_imports item", "an object"))


private pure func resolved_imports_field(
	value: JsonValue,
) -> Result[List[TypecheckResolvedImport], TypecheckBridgeDispatchError]:
	match get_field(value, "resolved_imports"):
		None:
			Ok([])
		Some(field):
			items ?= as_array(field).to_result(ExpectedRequestField("resolved_imports", "an array"))
			var imports: List[TypecheckResolvedImport] = []
			var error: Option[TypecheckBridgeDispatchError] = None

			for item in items:
				match error:
					Some(_):
						break
					None:
						match resolved_import_from_json(item):
							Ok(resolved):
								imports = imports.append(resolved)
							Err(err):
								error = Some(err)

			match error:
				Some(err):
					Err(err)
				None:
					Ok(imports)


private pure func comment_json(trivia: Trivia, trailing: Bool) -> JsonValue:
	JsonObject([
		("text", JsonString(trivia.text)),
		("line", JsonNumber(to_float(trivia.span.start_line))),
		("column", JsonNumber(to_float(trivia.span.start_column))),
		("trailing", JsonBool(trailing)),
	])


private pure func append_comment_jsons(
	comments: List[JsonValue],
	trivia: List[Trivia],
	trailing: Bool,
) -> List[JsonValue]:
	var result: List[JsonValue] = comments

	for item in trivia:
		if item.kind == CommentTrivia:
			result = result.append(comment_json(item, trailing))

	result


private pure func source_comment_jsons(source: SourceFile) -> JsonValue:
	lex_result = lex(source)
	JsonVector(lex_result.tokens.flat_map(
		func(token): append_comment_jsons(
			append_comment_jsons([], token.leading_trivia, False),
			token.trailing_trivia,
			True,
		),
	))


private pure func import_binding_to_json(binding: ImportBinding) -> JsonValue:
	match binding:
		QualifiedModuleBinding(local_name, module_path):
			JsonObject([
				("local_name", JsonString(local_name)),
				("module_path", JsonString(module_path)),
				("original_name", JsonNull),
			])
		SelectiveDefinitionBinding(local_name, module_path, source_name):
			JsonObject([
				("local_name", JsonString(local_name)),
				("module_path", JsonString(module_path)),
				("original_name", JsonString(source_name)),
			])


private pure func parse_typecheck_program_for_module(
	module: TypecheckImportModule,
) -> FinalizedTypecheckProgram:
	source_file: SourceFile = source_file(module.path, module.module_name, module.text)
	finalized_typecheck_program(parse_compiler_source(source_file))


private pure func typecheck_program_for_module(
	module: TypecheckImportModule,
) -> FinalizedTypecheckProgram:
	match module.typecheck_program:
		Some(finalized_program):
			if finalized_typecheck_program_matches_source(
				finalized_program,
				module.path,
				module.module_name,
				module.text,
			):
				finalized_program
			else:
				parse_typecheck_program_for_module(module)
		None:
			parse_typecheck_program_for_module(module)


private pure func finalized_import_path_rewrites(
	resolved_imports: List[TypecheckResolvedImport],
) -> List[FinalizedImportPathRewrite]:
	resolved_imports.map(func(resolved):
		rewrite: FinalizedImportPathRewrite = {
			from_path = resolved.from_path,
			from_module = resolved.from_module,
			import_path = resolved.import_path,
			resolved_module = resolved.resolved_module
		}
		rewrite
	)


private pure func prepare_typecheck_module(
	module: TypecheckImportModule,
	import_path_rewrites: List[FinalizedImportPathRewrite],
) -> ModuleLoadCandidate:
	program = typecheck_program_for_module(module)
	rewritten = finalized_typecheck_program_rewrite_import_paths(
		program,
		module.path,
		module.module_name,
		import_path_rewrites,
	)
	module_load_candidate(
		resolved_module_identity_from_resolver(module.module_path, module.origin),
		rewritten,
	)


private pure func prepare_typecheck_modules(
	modules: List[TypecheckImportModule],
	import_path_rewrites: List[FinalizedImportPathRewrite],
) -> List[ModuleLoadCandidate]:
	modules.map(func(module): prepare_typecheck_module(module, import_path_rewrites))


private pure func indexed_graph_error_messages(errors: List[IndexedGraphError]) -> List[String]:
	errors.map(indexed_graph_error_message)


private pure func graph_typecheck_state(
	scope: PreparedModuleScope,
	allow_debug_only_calls: Bool,
) -> TypecheckState:
	typecheck_state_for_prepared_module_scope(scope, allow_debug_only_calls)


private pure func prepared_module_surface(
	module: PreparedModule,
	importable_modules: List[ImportableModule],
) -> ModuleSurface:
	match importable_modules.find(
		func(
			importable,
		): importable_module_path(importable) == prepared_module_canonical_path(module),
	):
		Some(importable):
			importable_module_surface_value(importable)
		None:
			-- Direct artifact helpers do not always include the current module.
			module_surface_for_program(prepared_module_program(module))


private pure func typed_decl_has_ctfe_global(decl: TypedDecl) -> Bool:
	match decl:
		TypedGlobalVarDecl(info):
			not info.decl.is_mutable
		TypedPrivateDecl(inner):
			typed_decl_has_ctfe_global(inner)
		_:
			False


private pure func typed_program_has_ctfe_globals(program: TypedProgram) -> Bool:
	program.decls.any(typed_decl_has_ctfe_global)


-- Closed initializer trees can be evaluated without constructing contexts for
-- imported programs. Unknown or name-bearing forms remain conservative so
-- this proof cannot mistake a local-looking name for an imported dependency.
private pure func parsed_expr_is_import_independent_ctfe_initializer(expr: ParsedExpr) -> Bool:
	match expr:
		ParsedIntLiteralExpr(_, _):
			True
		ParsedFloatLiteralExpr(_, _):
			True
		ParsedStringLiteralExpr(_, _, _):
			True
		ParsedBoolLiteralExpr(_, _):
			True
		ParsedCharLiteralExpr(_, _):
			True
		ParsedUnaryExpr(_, value, _):
			parsed_expr_is_import_independent_ctfe_initializer(value)
		ParsedBinaryExpr(_, left, right, _):
			(
				parsed_expr_is_import_independent_ctfe_initializer(left)
				and parsed_expr_is_import_independent_ctfe_initializer(right)
			)
		ParsedLogicalExpr(_, left, right, _):
			(
				parsed_expr_is_import_independent_ctfe_initializer(left)
				and parsed_expr_is_import_independent_ctfe_initializer(right)
			)
		ParsedAscriptionExpr(value, _, _):
			parsed_expr_is_import_independent_ctfe_initializer(value)
		ParsedListExpr(items, _):
			items.all(parsed_expr_is_import_independent_ctfe_initializer)
		ParsedTupleExpr(items, _):
			items.all(parsed_expr_is_import_independent_ctfe_initializer)
		ParsedRecordExpr(fields, _):
			fields.all(func(field: ParsedRecordExprField):
				parsed_expr_is_import_independent_ctfe_initializer(field.value)
			)
		ParsedDictExpr(entries, _):
			entries.all(func(entry: ParsedDictEntry):
				(
					parsed_expr_is_import_independent_ctfe_initializer(entry.key)
					and parsed_expr_is_import_independent_ctfe_initializer(entry.value)
				)
			)
		ParsedVectorExpr(items, _):
			items.all(parsed_expr_is_import_independent_ctfe_initializer)
		ParsedBlockExpr(items, _):
			items.all(parsed_expr_is_import_independent_ctfe_initializer)
		ParsedIfExpr(condition, then_expr, else_expr, _):
			(
				parsed_expr_is_import_independent_ctfe_initializer(condition)
				and parsed_expr_is_import_independent_ctfe_initializer(then_expr)
				and else_expr
					.map(parsed_expr_is_import_independent_ctfe_initializer)
					.get_or(True)
			)
		_:
			False


private pure func parsed_decl_has_ctfe_global_requiring_imports(decl: ParsedDecl) -> Bool:
	match decl:
		VarParsedDecl(var_decl):
			(
				not var_decl.is_mutable
				and not parsed_expr_is_import_independent_ctfe_initializer(var_decl.value)
			)
		PrivateParsedDecl(inner, _):
			parsed_decl_has_ctfe_global_requiring_imports(inner)
		_:
			False


private pure func explicit_import_paths_from_decl(decl: ParsedDecl) -> List[String]:
	match decl:
		ImportBlockParsedDecl(imports, _):
			imports.map(func(import_decl): import_decl.module_path)
		PrivateParsedDecl(inner, _):
			explicit_import_paths_from_decl(inner)
		_:
			[]


private pure func ctfe_imported_program_from_accepted_module(
	scope: PreparedModuleScope,
	header_module: AcceptedTypecheckModule,
) -> CtfeImportedProgramBuild:
	body_run = typecheck_program_with_type_header_module_in_body_order_for_policy(
		header_module,
		SourceBodyOrder,
		IgnoreMainName,
	)
	typed_result = body_run.result
	body_checks = body_run.metrics.checked_order.length()

	if typed_result.state.errors.length() == 0:
		{
			program = Some(
				complete_ctfe_imported_program(
					prepared_module_canonical_path(prepared_module_scope_module(scope)),
					typed_result.program.decls,
					module_view_import_bindings(typed_result.state.module_view),
				),
			),
			complete_program = Some(typed_result.program),
			body_checks = body_checks
		}
	else:
		{
			program = None,
			complete_program = None,
			body_checks = body_checks
		}


private pure func body_graph_typecheck_module(
	graph: BodyTypecheckGraph,
	module_identity: ModuleIdentity,
	state: TypecheckState,
) -> Option[AcceptedTypecheckModule]:
	match graph:
		AcceptedBodyTypecheckGraph(accepted):
			accepted_graph_typecheck_module(accepted, module_identity, state)
		RecoverableBodyTypecheckGraph(recoverable):
			recoverable_graph_typecheck_module(recoverable, module_identity, state)


private pure func body_graph_ctfe_artifact_typecheck_module(
	graph: BodyTypecheckGraph,
	scope: PreparedModuleScope,
	state: TypecheckState,
) -> Option[AcceptedTypecheckModule]:
	match graph:
		AcceptedBodyTypecheckGraph(accepted):
			accepted_ctfe_artifact_typecheck_module(accepted, scope, state)
		RecoverableBodyTypecheckGraph(recoverable):
			recoverable_ctfe_artifact_typecheck_module(recoverable, scope, state)


private pure func body_graph_import_modules(graph: BodyTypecheckGraph) -> List[ImportableModule]:
	match graph:
		AcceptedBodyTypecheckGraph(accepted):
			accepted_typecheck_graph_import_modules(accepted)
		RecoverableBodyTypecheckGraph(recoverable):
			recoverable_typecheck_graph_import_modules(recoverable)


private pure func body_graph_declaration_skeleton_count(graph: BodyTypecheckGraph) -> Int:
	match graph:
		AcceptedBodyTypecheckGraph(accepted):
			accepted_typecheck_graph_declaration_skeleton_count(accepted)
		RecoverableBodyTypecheckGraph(recoverable):
			recoverable_typecheck_graph_declaration_skeleton_count(recoverable)


private pure func body_graph_completion_diagnostics(
	graph: BodyTypecheckGraph,
	module_identity: ModuleIdentity,
) -> List[TypecheckDiagnostic]:
	match graph:
		AcceptedBodyTypecheckGraph(_):
			[]
		RecoverableBodyTypecheckGraph(recoverable):
			recoverable_typecheck_graph_diagnostics_for_module(recoverable, module_identity)


private pure func ctfe_imported_program_from_bound(
	bound_module: BoundModule,
	allow_debug_only_calls: Bool,
	typecheck_graph: BodyTypecheckGraph,
) -> CtfeImportedProgramBuild:
	scope = bound_module_scope(bound_module)
	state = graph_typecheck_state(scope, allow_debug_only_calls)

	match body_graph_typecheck_module(typecheck_graph, bound_module_identity(bound_module), state):
		Some(header_module):
			ctfe_imported_program_from_accepted_module(scope, header_module)
		None:
			{
				program = None,
				complete_program = None,
				body_checks = 0
			}


-- Reusable CTFE artifacts are checked against the accepted graph's
-- dependency-only inventory. The accepted constructor builds that binding, so
-- this path cannot accidentally admit target-dependent definitions.
private pure func ctfe_imported_program_from_prepared(
	scope: PreparedModuleScope,
	allow_debug_only_calls: Bool,
	typecheck_graph: BodyTypecheckGraph,
) -> CtfeImportedProgramBuild:
	state = graph_typecheck_state(scope, allow_debug_only_calls)

	match body_graph_ctfe_artifact_typecheck_module(typecheck_graph, scope, state):
		Some(header_module):
			ctfe_imported_program_from_accepted_module(scope, header_module)
		None:
			{
				program = None,
				complete_program = None,
				body_checks = 0
			}


private pure func direct_ctfe_dependencies_for_artifact(
	artifact: PreparedModule,
	modules: List[PreparedModule],
) -> List[PreparedModule]:
	explicit_import_paths = prepared_module_program(
		artifact,
	).decls.flat_map(explicit_import_paths_from_decl)

	modules.filter(func(module): import_module_is_explicit_for_ctfe(module, explicit_import_paths))


private pure func append_ctfe_dependency_tree(
	order: CtfeDependencyOrder,
	dependency: PreparedModule,
	modules: List[PreparedModule],
) -> CtfeDependencyOrder:
	module_path = prepared_module_canonical_path(dependency)

	if order.visited_paths.contains(module_path):
		order
	else:
		var result = { order | visited_paths = order.visited_paths.append(module_path) }

		for transitive in direct_ctfe_dependencies_for_artifact(dependency, modules):
			result = append_ctfe_dependency_tree(result, transitive, modules)

		{ result | dependencies = result.dependencies.append(dependency) }


private pure func append_ctfe_dependencies_for_artifact(
	order: CtfeDependencyOrder,
	artifact: PreparedModule,
	modules: List[PreparedModule],
) -> CtfeDependencyOrder:
	var result = order

	if prepared_module_program(artifact).decls.any(parsed_decl_has_ctfe_global_requiring_imports):
		for dependency in direct_ctfe_dependencies_for_artifact(artifact, modules):
			result = append_ctfe_dependency_tree(result, dependency, modules)

	result


private pure func ctfe_dependencies_for_graph(
	target: PreparedModule,
	modules: List[PreparedModule],
	selected_modules: List[PreparedModule],
) -> List[PreparedModule]:
	var order: CtfeDependencyOrder = {
		visited_paths = [],
		dependencies = []
	}
	order = append_ctfe_dependencies_for_artifact(order, target, modules)

	for module in selected_modules:
		order = append_ctfe_dependencies_for_artifact(order, module, modules)

	order.dependencies


private pure func prepared_ctfe_dependencies_for_artifact(
	artifact: PreparedModule,
	modules: List[PreparedModule],
	prepared_dependencies: List[PreparedCtfeDependency],
) -> List[PreparedCtfeDependency]:
	order = append_ctfe_dependencies_for_artifact(
		{
			visited_paths = [],
			dependencies = []
		},
		artifact,
		modules,
	)
	dependency_paths = order.dependencies.map(
		func(dependency): prepared_module_canonical_path(dependency),
	)

	prepared_dependencies.filter(
		func(dependency): dependency_paths.contains(dependency.module_path),
	)


private pure func prepared_module_is_prelude(module: PreparedModule) -> Bool:
	importable_module_identity_is_std_prelude(
		prepared_module_canonical_path(module),
		prepared_module_origin(module),
		prepared_module_program(module).source.module_name,
	)


private pure func prepared_module_is_ambient_typecheck_module(module: PreparedModule) -> Bool:
	identities: List[String] = [
		prepared_module_canonical_path(module),
		prepared_module_program(module).source.module_name,
	]

	(
		prepared_module_is_prelude(module)
		or identities.contains("traits")
		or identities.contains("std/traits")
	)


private pure func prepared_module_import_identities(module: PreparedModule) -> List[String]:
	importable_module_request_aliases(
		prepared_module_canonical_path(module),
		prepared_module_origin(module),
		prepared_module_program(module).source.module_name,
	)


private pure func prepared_module_import_identity_index(
	modules: List[PreparedModule],
) -> Dict[String, Int]:
	var result: Dict[String, Int] = {}
	var module_index: Int = 0

	for module in modules:
		-- First insertion wins to preserve the previous List.find resolution
		-- order for ambiguous aliases. Keep Dict mutation in this owning frame:
		-- passing the Dict through a helper retains it and forces backing-table COW.
		for identity in prepared_module_import_identities(module):
			if not result.contains(identity):
				result = result.set(identity, module_index)

		module_index += 1

	result


private pure func prepared_target_import_reachability(
	modules: List[PreparedModule],
	target: PreparedModule,
) -> PreparedTargetImportReachability:
	module_indices_by_import_path = prepared_module_import_identity_index(modules)
	target_indices_by_import_path = prepared_module_import_identity_index([target])
	var first_dependent_edge_indices: List[Int] = []
	var dependent_module_indices: List[Int] = []
	var next_dependent_edge_indices: List[Int] = []
	var imports_target: List[Bool] = []
	var pending_module_indices: List[Int] = []
	var module_index: Int = 0

	for _ in modules:
		first_dependent_edge_indices = first_dependent_edge_indices.append(NO_PREPARED_MODULE_INDEX)

	for module in modules:
		import_paths = prepared_module_program(
			module,
		).decls.flat_map(explicit_import_paths_from_decl)
		directly_imports_target = import_paths.any(
			func(path): target_indices_by_import_path.contains(path),
		)
		imports_target = imports_target.append(directly_imports_target)

		if directly_imports_target:
			pending_module_indices = pending_module_indices.append(module_index)
		else:
			for import_path in import_paths:
				match module_indices_by_import_path.get(import_path):
					Some(imported_module_index):
						edge_index = dependent_module_indices.length()
						dependent_module_indices = dependent_module_indices.append(module_index)
						next_dependent_edge_indices = next_dependent_edge_indices.append(
							first_dependent_edge_indices.get_or(
								imported_module_index,
								NO_PREPARED_MODULE_INDEX,
							),
						)
						first_dependent_edge_indices = first_dependent_edge_indices.set(
							imported_module_index,
							edge_index,
						)
					None:
						void

		module_index += 1

	var pending_index: Int = 0

	while pending_index < pending_module_indices.length():
		imported_module_index = pending_module_indices.get_or(
			pending_index,
			NO_PREPARED_MODULE_INDEX,
		)
		var edge_index = first_dependent_edge_indices.get_or(
			imported_module_index,
			NO_PREPARED_MODULE_INDEX,
		)

		while edge_index != NO_PREPARED_MODULE_INDEX:
			dependent_module_index = dependent_module_indices.get_or(
				edge_index,
				NO_PREPARED_MODULE_INDEX,
			)

			if not imports_target.get_or(dependent_module_index, False):
				imports_target = imports_target.set(dependent_module_index, True)
				pending_module_indices = pending_module_indices.append(dependent_module_index)

			edge_index = next_dependent_edge_indices.get_or(edge_index, NO_PREPARED_MODULE_INDEX)

		pending_index += 1

	var importing_module_paths: Dict[String, Bool] = {}
	var prelude_imports_target: Bool = False
	module_index = 0

	for module in modules:
		if imports_target.get_or(module_index, False):
			importing_module_paths = importing_module_paths.set(
				prepared_module_canonical_path(module),
				True,
			)

			if prepared_module_is_prelude(module):
				prelude_imports_target = True

		module_index += 1

	{
		importing_module_paths = importing_module_paths,
		prelude_imports_target = prelude_imports_target
	}


private pure func prepared_reusable_artifact_path_index(
	target_scope: PreparedModuleScope,
	artifact_modules: List[PreparedModule],
	reusable_artifact_paths: List[String],
) -> Dict[String, Bool]:
	var reusable_paths: Dict[String, Bool] = {}
	target = prepared_module_scope_module(target_scope)

	if (
		reusable_artifact_paths.length() > 0
		and not prepared_module_is_ambient_typecheck_module(target)
	):
		reachability = prepared_target_import_reachability(artifact_modules, target)

		if not reachability.prelude_imports_target:
			for module_path in reusable_artifact_paths:
				if not reachability.importing_module_paths.contains(module_path):
					reusable_paths = reusable_paths.set(module_path, True)

	reusable_paths


private pure func ctfe_only_program_from_imported(
	imported_program: Option[CtfeImportedProgram],
) -> PreparedCtfeProgram:
	match imported_program:
		Some(program):
			EagerCtfeOnlyProgram(program)
		None:
			FailedCtfeProgram


private pure func prepare_ctfe_dependency_program(
	target_scope: PreparedModuleScope,
	dependency: BoundModule,
	reusable_artifact_paths: Dict[String, Bool],
	allow_debug_only_calls: Bool,
	accepted_graph: BodyTypecheckGraph,
) -> PreparedCtfeProgramBuild:
	dependency_module = prepared_module_scope_module(bound_module_scope(dependency))

	match prepared_module_scope_find_module(
		target_scope,
		prepared_module_canonical_path(dependency_module),
	):
		None:
			{
				program = FailedCtfeProgram,
				body_checks = 0
			}
		Some(dependency_scope):
			can_try_artifact_environment = reusable_artifact_paths.contains(
				prepared_module_canonical_path(prepared_module_scope_module(dependency_scope)),
			)

			if can_try_artifact_environment:
				artifact_build = ctfe_imported_program_from_prepared(
					dependency_scope,
					allow_debug_only_calls,
					accepted_graph,
				)

				match artifact_build.program:
					Some(program):
						match artifact_build.complete_program:
							Some(complete_program):
								{
									program = ReusableCtfeProgram({
										imported_program = program,
										complete_program = complete_program,
									}),
									body_checks = artifact_build.body_checks
								}
							None:
								{
									program = FailedCtfeProgram,
									body_checks = artifact_build.body_checks
								}
					None:
						fallback_build = ctfe_imported_program_from_bound(
							dependency,
							allow_debug_only_calls,
							accepted_graph,
						)
						{
							program = ctfe_only_program_from_imported(fallback_build.program),
							body_checks = artifact_build.body_checks + fallback_build.body_checks
						}
			else:
				build = ctfe_imported_program_from_bound(
					dependency,
					allow_debug_only_calls,
					accepted_graph,
				)
				{
					program = ctfe_only_program_from_imported(build.program),
					body_checks = build.body_checks
				}


private pure func accepted_ctfe_root_definition_ids(graph: AcceptedTypecheckGraph) -> List[Int]:
	var roots: List[Int] = []
	var seen: Dict[Int, Bool] = {}

	for header in accepted_typecheck_graph_completed_globals(graph):
		if not completed_global_header_typed(header).decl.is_mutable:
			for dependency in completed_global_header_callable_dependencies(header):
				definition_id = callable_id_definition_id(dependency)

				if not seen.contains(definition_id):
					seen = seen.set(definition_id, True)
					roots = roots.append(definition_id)

	roots


private pure func ctfe_body_module_registries(
	target_scope: PreparedModuleScope,
	dependencies: List[BoundModule],
	allow_debug_only_calls: Bool,
	graph: AcceptedTypecheckGraph,
) -> Option[List[CtfeBodyModuleRegistry]]:
	var registries: List[CtfeBodyModuleRegistry] = []
	var failed: Bool = False
	target_state = graph_typecheck_state(target_scope, allow_debug_only_calls)

	match accepted_graph_typecheck_module(
		graph,
		prepared_module_scope_identity(target_scope),
		target_state,
	):
		Some(module):
			registries = registries.append({
				module_path = prepared_module_scope_canonical_path(target_scope),
				registry = accepted_typecheck_module_body_registry(module),
			})
		None:
			failed = True

	for dependency in dependencies:
		if not failed:
			state = graph_typecheck_state(bound_module_scope(dependency), allow_debug_only_calls)

			match accepted_graph_typecheck_module(graph, bound_module_identity(dependency), state):
				Some(module):
					registries = registries.append({
						module_path = bound_module_canonical_path(dependency),
						registry = accepted_typecheck_module_body_registry(module),
					})
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some(registries)


private struct CtfeAttemptedBodyChecks {
	dependency_checks: Int,
	target_checks: Int
}


private pure func ctfe_eager_fallback_for_worklist(
	fallback: CtfeBodyWorklistFallback,
) -> CtfeEagerFallbackKind:
	match fallback:
		CtfeDependencyFallback(reason):
			match reason:
				CtfeMissingCheckedBody:
					CtfeMissingCheckedBodyFallback
				CtfeUnresolvedTraitDispatch:
					CtfeUnresolvedTraitDispatchFallback
		CtfeMissingBodyRegistry(_):
			CtfeMissingBodyRegistryFallback
		CtfeRejectedBody(_):
			CtfeRejectedBodyFallback
		CtfeQueueInvariantViolation(_):
			CtfeQueueInvariantFallback


private pure func ctfe_registry_module_path_for_definition(
	registries: List[CtfeBodyModuleRegistry],
	definition_id: Int,
) -> Option[String]:
	var result: Option[String] = None

	for registration in registries:
		if (
			result.is_none()
			and body_check_registry_context_for_definition_id(
				registration.registry,
				definition_id,
			).is_some()
		):
			result = Some(registration.module_path)

	result


private pure func ctfe_attempted_body_checks(
	target_module_path: String,
	registries: List[CtfeBodyModuleRegistry],
	checked: List[CtfeCheckedBody],
	fallback: CtfeBodyWorklistFallback,
	metrics: CtfeBodyWorklistMetrics,
) -> CtfeAttemptedBodyChecks:
	var target_checks = checked
		.filter(func(body): body.module_path == target_module_path)
		.length()

	match fallback:
		CtfeRejectedBody(definition_id):
			match ctfe_registry_module_path_for_definition(registries, definition_id):
				Some(module_path):
					if module_path == target_module_path:
						target_checks += 1
				None:
					void
		_:
			void

	{
		dependency_checks = metrics.checked_bodies - target_checks,
		target_checks = target_checks
	}


private pure func prepare_selective_ctfe_dependencies_for_roots(
	target_scope: PreparedModuleScope,
	dependencies: List[BoundModule],
	allow_debug_only_calls: Bool,
	graph: AcceptedTypecheckGraph,
	root_definition_ids: List[Int],
) -> SelectiveCtfeDependencyPreparation:
	match ctfe_body_module_registries(target_scope, dependencies, allow_debug_only_calls, graph):
		None:
			SelectiveCtfeDependenciesRequireEager(CtfePreparationFailureFallback, 0, 0)
		Some(registries):
			target_module_path = prepared_module_scope_canonical_path(target_scope)

			match ctfe_check_reachable_bodies(root_definition_ids, registries):
				CtfeBodyWorklistRequiresEager(fallback, checked, metrics):
					attempted = ctfe_attempted_body_checks(
						target_module_path,
						registries,
						checked,
						fallback,
						metrics,
					)
					SelectiveCtfeDependenciesRequireEager(
						ctfe_eager_fallback_for_worklist(fallback),
						attempted.dependency_checks,
						attempted.target_checks,
					)
				CtfeBodyWorklistReady(checked, metrics):
					var prepared: List[PreparedCtfeDependency] = []
					var failed: Bool = False
					target_outcomes = checked
						.filter(func(body): body.module_path == target_module_path)
						.map(func(body): body.outcome)

					target_seed_outcomes: Option[List[BodyCheckOutcome]] = if target_outcomes.is_empty():
						None
					else:
						Some(target_outcomes)

					for dependency in dependencies:
						module_path = bound_module_canonical_path(dependency)
						registration = registries.find(
							func(candidate): candidate.module_path == module_path,
						)
						outcomes = checked
							.filter(func(body): body.module_path == module_path)
							.map(func(body): body.outcome)

						match registration:
							None:
								failed = True
							Some(found):
								match body_check_registry_materialize_subset(
									found.registry,
									outcomes,
								):
									BodySubsetProgramRejected(_):
										failed = True
									BodySubsetProgramReady(subset):
										seed_outcomes: Option[List[BodyCheckOutcome]] = if outcomes.is_empty():
											None
										else:
											Some(outcomes)

										prepared = prepared.append({
											module_path = module_path,
											program = SelectiveCtfeProgram(
												selective_ctfe_imported_program(
													module_path,
													body_subset_program_decls(subset),
													outcomes.map(body_check_outcome_typed_function),
													body_subset_program_import_bindings(subset),
												),
												seed_outcomes,
											),
											body_checks = outcomes.length(),
										})

						if failed:
							break

					if failed:
						SelectiveCtfeDependenciesRequireEager(
							CtfePreparationFailureFallback,
							metrics.checked_bodies - target_outcomes.length(),
							target_outcomes.length(),
						)
					else:
						SelectiveCtfeDependenciesReady(
							prepared,
							target_seed_outcomes,
							target_outcomes.length(),
						)


private pure func prepare_selective_ctfe_dependencies(
	target_scope: PreparedModuleScope,
	dependencies: List[BoundModule],
	allow_debug_only_calls: Bool,
	graph: AcceptedTypecheckGraph,
) -> SelectiveCtfeDependencyPreparation:
	root_definition_ids = accepted_ctfe_root_definition_ids(graph)

	if root_definition_ids.is_empty():
		SelectiveCtfeDependenciesRequireEager(CtfeNoCallableRootsFallback, 0, 0)
	else:
		prepare_selective_ctfe_dependencies_for_roots(
			target_scope,
			dependencies,
			allow_debug_only_calls,
			graph,
			root_definition_ids,
		)


private pure func add_ctfe_attempted_body_checks(
	dependencies: List[PreparedCtfeDependency],
	attempted_checks: Int,
) -> List[PreparedCtfeDependency]:
	if attempted_checks == 0:
		dependencies
	else:
		match dependencies.get(0):
			None:
				dependencies
			Some(first):
				dependencies.set(0, { first | body_checks = first.body_checks + attempted_checks })


private pure func prepare_ctfe_dependencies(
	target_scope: PreparedModuleScope,
	dependencies: List[BoundModule],
	artifact_modules: List[PreparedModule],
	reusable_artifact_paths: List[String],
	allow_debug_only_calls: Bool,
	accepted_graph: BodyTypecheckGraph,
) -> PreparedCtfeDependencies:
	if dependencies.is_empty():
		{
			modules = [],
			target_body_outcomes = None,
			target_discovery_body_checks = 0,
			eager_fallback = CtfeNoEagerFallback
		}
	else:
		match accepted_graph:
			AcceptedBodyTypecheckGraph(graph):
				match prepare_selective_ctfe_dependencies(
					target_scope,
					dependencies,
					allow_debug_only_calls,
					graph,
				):
					SelectiveCtfeDependenciesReady(prepared, target_outcomes, target_checks):
						{
							modules = prepared,
							target_body_outcomes = target_outcomes,
							target_discovery_body_checks = target_checks,
							eager_fallback = CtfeNoEagerFallback
						}
					SelectiveCtfeDependenciesRequireEager(fallback, attempted_dependency_checks, attempted_target_checks):
						reusable_artifact_path_index = prepared_reusable_artifact_path_index(
							target_scope,
							artifact_modules,
							reusable_artifact_paths,
						)
						eager = dependencies.map(func(dependency):
							build = prepare_ctfe_dependency_program(
								target_scope,
								dependency,
								reusable_artifact_path_index,
								allow_debug_only_calls,
								accepted_graph,
							)
							{
								module_path = bound_module_canonical_path(dependency),
								program = build.program,
								body_checks = build.body_checks
							}
						)
						{
							modules = add_ctfe_attempted_body_checks(
								eager,
								attempted_dependency_checks,
							),
							target_body_outcomes = None,
							target_discovery_body_checks = attempted_target_checks,
							eager_fallback = fallback
						}
			RecoverableBodyTypecheckGraph(_):
				reusable_artifact_path_index = prepared_reusable_artifact_path_index(
					target_scope,
					artifact_modules,
					reusable_artifact_paths,
				)

				eager = dependencies.map(func(dependency):
					build = prepare_ctfe_dependency_program(
						target_scope,
						dependency,
						reusable_artifact_path_index,
						allow_debug_only_calls,
						accepted_graph,
					)
					{
						module_path = bound_module_canonical_path(dependency),
						program = build.program,
						body_checks = build.body_checks
					}
				)

				{
					modules = eager,
					target_body_outcomes = None,
					target_discovery_body_checks = 0,
					eager_fallback = CtfeRecoverableGraphFallback
				}


private pure func prepare_ctfe_dependencies_from_bound_graph(
	target_scope: PreparedModuleScope,
	bound_graph: BoundModuleGraph,
	dependency_plan: List[PreparedModule],
	artifact_modules: List[PreparedModule],
	reusable_artifact_paths: List[String],
	allow_debug_only_calls: Bool,
	accepted_graph: BodyTypecheckGraph,
) -> Result[PreparedCtfeDependencies, List[BoundModuleGraphError]]:
	bound_dependencies ?= bound_module_graph_modules_for_prepared(bound_graph, dependency_plan)

	Ok(
		prepare_ctfe_dependencies(
			target_scope,
			bound_dependencies,
			artifact_modules,
			reusable_artifact_paths,
			allow_debug_only_calls,
			accepted_graph,
		),
	)


private pure func typecheck_inventory_field(value: String) -> String:
	value
		.replace("%", "%25")
		.replace(" ", "%20")
		.replace("\t", "%09")
		.replace("\r", "%0D")
		.replace("\n", "%0A")


private func prepare_ctfe_dependencies_with_trace(
	target_scope: PreparedModuleScope,
	dependencies: List[BoundModule],
	artifact_modules: List[PreparedModule],
	reusable_artifact_paths: List[String],
	allow_debug_only_calls: Bool,
	accepted_graph: BodyTypecheckGraph,
	trace: (TypecheckTracePhase, Int, String) -> Void,
	include_inventory: Bool,
	inventory: (String, String) -> Void,
) -> List[PreparedCtfeDependency]:
	var result: List[PreparedCtfeDependency] = []
	reusable_artifact_path_index = prepared_reusable_artifact_path_index(
		target_scope,
		artifact_modules,
		reusable_artifact_paths,
	)

	for dependency in dependencies:
		module_path = bound_module_canonical_path(dependency)
		trace(CtfeDependencyTypecheckStart, TYPECHECK_TRACE_UNINDEXED, module_path)
		prepared_build = prepare_ctfe_dependency_program(
			target_scope,
			dependency,
			reusable_artifact_path_index,
			allow_debug_only_calls,
			accepted_graph,
		)
		prepared_program = prepared_build.program
		trace(CtfeDependencyTypecheckComplete, TYPECHECK_TRACE_UNINDEXED, module_path)

		if include_inventory:
			match prepared_program:
				ReusableCtfeProgram(artifact):
					program = artifact.imported_program
					counts = typed_program_inventory(artifact.complete_program)
					inventory(
						"ctfe_dependency",
						"module=" + typecheck_inventory_field(
							module_path,
						) + " source_bytes=" + counts.source_bytes.to_string() + " typed_decls=" + counts.typed_decls.to_string() + " typed_expr_nodes=" + counts.typed_expr_nodes.to_string() + " import_bindings=" + ctfe_imported_program_import_bindings(
							program,
						)
							.length()
							.to_string() + " reusable_artifact=1",
					)
				SelectiveCtfeProgram(program, _):
					counts = typed_decls_inventory(
						bound_module_program(dependency).source.text.length(),
						ctfe_imported_program_decls(program),
					)
					inventory(
						"ctfe_dependency",
						"module=" + typecheck_inventory_field(
							module_path,
						) + " source_bytes=" + counts.source_bytes.to_string() + " typed_decls=" + counts.typed_decls.to_string() + " typed_expr_nodes=" + counts.typed_expr_nodes.to_string() + " import_bindings=" + ctfe_imported_program_import_bindings(
							program,
						)
							.length()
							.to_string() + " reusable_artifact=0",
					)
				EagerCtfeOnlyProgram(program):
					counts = typed_decls_inventory(
						bound_module_program(dependency).source.text.length(),
						ctfe_imported_program_decls(program),
					)
					inventory(
						"ctfe_dependency",
						"module=" + typecheck_inventory_field(
							module_path,
						) + " source_bytes=" + counts.source_bytes.to_string() + " typed_decls=" + counts.typed_decls.to_string() + " typed_expr_nodes=" + counts.typed_expr_nodes.to_string() + " import_bindings=" + ctfe_imported_program_import_bindings(
							program,
						)
							.length()
							.to_string() + " reusable_artifact=0",
					)
				FailedCtfeProgram:
					inventory(
						"ctfe_dependency",
						"module=" + typecheck_inventory_field(
							module_path,
						) + " source_bytes=" + bound_module_program(dependency).source.text
							.length()
							.to_string() + ((
							" typed_decls=0 typed_expr_nodes=0 import_bindings=0 typecheck_failed=1 "
							+ "reusable_artifact=0"
						)),
					)

		result = result.append({
			module_path = module_path,
			program = prepared_program,
			body_checks = prepared_build.body_checks,
		})

	result


private func prepare_ctfe_dependencies_from_bound_graph_with_trace(
	target_scope: PreparedModuleScope,
	bound_graph: BoundModuleGraph,
	dependency_plan: List[PreparedModule],
	artifact_modules: List[PreparedModule],
	reusable_artifact_paths: List[String],
	allow_debug_only_calls: Bool,
	accepted_graph: BodyTypecheckGraph,
	trace: (TypecheckTracePhase, Int, String) -> Void,
	include_inventory: Bool,
	inventory: (String, String) -> Void,
) -> Result[PreparedCtfeDependencies, List[BoundModuleGraphError]]:
	match bound_module_graph_modules_for_prepared(bound_graph, dependency_plan):
		Err(errors):
			Err(errors)
		Ok(bound_dependencies):
			Ok({
				modules = prepare_ctfe_dependencies_with_trace(
					target_scope,
					bound_dependencies,
					artifact_modules,
					reusable_artifact_paths,
					allow_debug_only_calls,
					accepted_graph,
					trace,
					include_inventory,
					inventory,
				),
				target_body_outcomes = None,
				target_discovery_body_checks = 0,
				eager_fallback = CtfeTracedGraphFallback,
			})


private pure func import_module_is_explicit_for_ctfe(
	module: PreparedModule,
	explicit_import_paths: List[String],
) -> Bool:
	match prepared_module_origin(module):
		NativePackageModule(_):
			False
		SourcePackageModule(_):
			explicit_import_paths.contains(prepared_module_canonical_path(module))
		StdlibModule:
			explicit_import_paths.contains(prepared_module_canonical_path(module))
		UserModule:
			explicit_import_paths.contains(prepared_module_canonical_path(module))


private pure func ctfe_imported_programs_from_dependencies(
	ctfe_dependencies: List[PreparedCtfeDependency],
) -> Option[List[CtfeImportedProgram]]:
	var result: List[CtfeImportedProgram] = []
	var failed: Bool = False

	for dependency in ctfe_dependencies:
		match dependency.program:
			ReusableCtfeProgram(artifact):
				result = result.append(artifact.imported_program)
			SelectiveCtfeProgram(imported_program, _):
				result = result.append(imported_program)
			EagerCtfeOnlyProgram(imported_program):
				result = result.append(imported_program)
			FailedCtfeProgram:
				failed = True
				break

	if failed:
		None
	else:
		Some(result)


private pure func ctfe_imported_programs_for_artifact(
	has_ctfe_globals: Bool,
	ctfe_dependencies: List[PreparedCtfeDependency],
) -> Option[List[CtfeImportedProgram]]:
	if has_ctfe_globals:
		ctfe_imported_programs_from_dependencies(ctfe_dependencies)
	else:
		Some([])


private pure func ctfe_body_outcomes_for_module(
	ctfe_dependencies: List[PreparedCtfeDependency],
	module_path: String,
) -> Option[List[BodyCheckOutcome]]:
	match ctfe_dependencies.find(func(dependency): dependency.module_path == module_path):
		Some(dependency):
			match dependency.program:
				SelectiveCtfeProgram(_, outcomes):
					outcomes
				_:
					None
		None:
			None


private pure func reusable_ctfe_program_for_module(
	ctfe_dependencies: List[PreparedCtfeDependency],
	module_path: String,
) -> Option[ReusableCtfeArtifact]:
	var result: Option[ReusableCtfeArtifact] = None

	for dependency in ctfe_dependencies:
		if dependency.module_path == module_path:
			match dependency.program:
				ReusableCtfeProgram(program):
					result = Some(program)
				_:
					void

			break

	result


private pure func typecheck_ctfe_was_evaluated(status: TypecheckCtfeStatus) -> Bool:
	match status:
		TypecheckCtfeEvaluated:
			True
		TypecheckCtfeNotRun:
			False


private pure func typecheck_ctfe_status_name(evaluated: Bool) -> String:
	if evaluated:
		"evaluated"
	else:
		"not_run"


private pure func evaluated_typecheck_artifact(
	program: TypedProgram,
	errors: List[String],
	diagnostics: List[TypecheckDiagnostic],
	import_bindings: List[ImportBinding],
	imported_programs: Option[List[CtfeImportedProgram]],
) -> TypecheckCtfeArtifact:
	if errors.length() != 0:
		{
			semantic_program = program,
			program = program,
			errors = errors,
			diagnostics = diagnostics,
			import_bindings = import_bindings,
			status = TypecheckCtfeNotRun
		}
	else:
		match imported_programs:
			Some(programs):
				match ctfe_evaluate_program_globals(program, programs, import_bindings):
					Ok(evaluated_program):
						{
							semantic_program = program,
							program = evaluated_program,
							errors = errors,
							diagnostics = diagnostics,
							import_bindings = import_bindings,
							status = TypecheckCtfeEvaluated
						}
					Err(error):
						message = ctfe_eval_error_message(error)
						{
							semantic_program = program,
							program = program,
							status = TypecheckCtfeNotRun,
							errors = errors.append(message),
							diagnostics = diagnostics.append(typecheck_diagnostic(message, None)),
							import_bindings = import_bindings
						}
			None:
				message = "compile-time evaluation could not resolve all imported modules"
				{
					semantic_program = program,
					program = program,
					errors = errors.append(message),
					diagnostics = diagnostics.append(typecheck_diagnostic(message, None)),
					import_bindings = import_bindings,
					status = TypecheckCtfeNotRun
				}


private pure func typecheck_ctfe_artifact(
	typed_result: TypecheckProgramResult,
	imported_programs: Option[List[CtfeImportedProgram]],
) -> TypecheckCtfeArtifact:
	evaluated_typecheck_artifact(
		typed_result.program,
		typed_result.state.errors,
		typed_result.state.diagnostics,
		module_view_import_bindings(typed_result.state.module_view),
		imported_programs,
	)


private pure func typechecked_module_from_ctfe_artifact(
	scope: PreparedModuleScope,
	module_surface: ModuleSurface,
	ctfe_artifact: TypecheckCtfeArtifact,
) -> TypecheckedModule:
	prepared = prepared_module_scope_module(scope)
	resolved_identity = resolved_module_identity_from_resolver(
		prepared_module_canonical_path(prepared),
		prepared_module_origin(prepared),
	)
	{
		path = prepared_module_program(prepared).source.path,
		module_name = prepared_module_program(prepared).source.module_name,
		module_path = prepared_module_canonical_path(prepared),
		module_identity = module_identity_from_resolved(resolved_identity),
		parsed_program = prepared_module_program(prepared),
		module_surface = module_surface,
		semantic_program = ctfe_artifact.semantic_program,
		typed_program = ctfe_artifact.program,
		errors = ctfe_artifact.errors,
		diagnostics = ctfe_artifact.diagnostics,
		import_bindings = ctfe_artifact.import_bindings,
		ctfe_evaluated = typecheck_ctfe_was_evaluated(ctfe_artifact.status)
	}


private pure func typecheck_bound_program(
	bound_module: BoundModule,
	allow_debug_only_calls: Bool,
	accepted_graph: BodyTypecheckGraph,
	main_policy: MainValidationPolicy,
) -> TypecheckProgramResult:
	scope = bound_module_scope(bound_module)
	initial_state = graph_typecheck_state(scope, allow_debug_only_calls)

	match body_graph_typecheck_module(
		accepted_graph,
		bound_module_identity(bound_module),
		initial_state,
	):
		Some(header_module):
			typecheck_program_with_type_header_module_for_policy(header_module, main_policy)
		None:
			diagnostics = body_graph_completion_diagnostics(
				accepted_graph,
				bound_module_identity(bound_module),
			)

			if diagnostics.is_empty():
				rejected_typecheck_program(
					initial_state,
					bound_module_program(bound_module),
					"accepted type-header graph does not own the requested module",
				)
			else:
				rejected_typecheck_program_with_diagnostics(
					initial_state,
					bound_module_program(bound_module),
					diagnostics,
				)


private pure func typecheck_bound_program_with_seeded_bodies(
	bound_module: BoundModule,
	allow_debug_only_calls: Bool,
	accepted_graph: BodyTypecheckGraph,
	main_policy: MainValidationPolicy,
	seed_outcomes: List[BodyCheckOutcome],
) -> SeededBodyCheckRun:
	scope = bound_module_scope(bound_module)
	initial_state = graph_typecheck_state(scope, allow_debug_only_calls)

	match body_graph_typecheck_module(
		accepted_graph,
		bound_module_identity(bound_module),
		initial_state,
	):
		Some(header_module):
			body_check_registry_materialize_complete_with_seed(
				accepted_typecheck_module_body_registry(header_module),
				seed_outcomes,
				main_policy,
			)
		None:
			{
				result = typecheck_bound_program(
					bound_module,
					allow_debug_only_calls,
					accepted_graph,
					main_policy,
				),
				checked_bodies = 0,
				reused_bodies = 0
			}


private pure func typechecked_prepared_module(
	bound_module: BoundModule,
	module_surface: ModuleSurface,
	allow_debug_only_calls: Bool,
	ctfe_dependencies: List[PreparedCtfeDependency],
	accepted_graph: BodyTypecheckGraph,
	main_policy: MainValidationPolicy,
) -> TypecheckedModule:
	scope = bound_module_scope(bound_module)
	typed_result = typecheck_bound_program(
		bound_module,
		allow_debug_only_calls,
		accepted_graph,
		main_policy,
	)
	imported_programs = ctfe_imported_programs_for_artifact(
		typed_program_has_ctfe_globals(typed_result.program),
		ctfe_dependencies,
	)
	ctfe_artifact = typecheck_ctfe_artifact(typed_result, imported_programs)

	typechecked_module_from_ctfe_artifact(scope, module_surface, ctfe_artifact)


private pure func typechecked_prepared_module_with_seeded_bodies(
	bound_module: BoundModule,
	module_surface: ModuleSurface,
	allow_debug_only_calls: Bool,
	ctfe_dependencies: List[PreparedCtfeDependency],
	accepted_graph: BodyTypecheckGraph,
	main_policy: MainValidationPolicy,
	seed_outcomes: List[BodyCheckOutcome],
) -> SeededTypecheckedModule:
	scope = bound_module_scope(bound_module)
	body_run = typecheck_bound_program_with_seeded_bodies(
		bound_module,
		allow_debug_only_calls,
		accepted_graph,
		main_policy,
		seed_outcomes,
	)
	typed_result = body_run.result
	imported_programs = ctfe_imported_programs_for_artifact(
		typed_program_has_ctfe_globals(typed_result.program),
		ctfe_dependencies,
	)
	ctfe_artifact = typecheck_ctfe_artifact(typed_result, imported_programs)

	{
		module = typechecked_module_from_ctfe_artifact(scope, module_surface, ctfe_artifact),
		reused_bodies = body_run.reused_bodies
	}


private pure func typechecked_prepared_module_with_ownership(
	bound_module: BoundModule,
	module_surface: ModuleSurface,
	allow_debug_only_calls: Bool,
	ctfe_dependencies: List[PreparedCtfeDependency],
	accepted_graph: BodyTypecheckGraph,
	main_policy: MainValidationPolicy,
) -> TypecheckedPreparedModuleResult:
	scope = bound_module_scope(bound_module)
	typed_result = typecheck_bound_program(
		bound_module,
		allow_debug_only_calls,
		accepted_graph,
		main_policy,
	)
	after_typecheck_unique = typed_program_is_unique(typed_result.program)

	imported_programs = ctfe_imported_programs_for_artifact(
		typed_program_has_ctfe_globals(typed_result.program),
		ctfe_dependencies,
	)
	ctfe_artifact = typecheck_ctfe_artifact(typed_result, imported_programs)
	after_ctfe_unique = typed_program_is_unique(ctfe_artifact.program)
	typechecked = typechecked_module_from_ctfe_artifact(scope, module_surface, ctfe_artifact)

	{
		module = typechecked,
		ownership = Some({
			after_typecheck_unique = after_typecheck_unique,
			after_ctfe_unique = after_ctfe_unique,
			after_module_construction_unique = typed_program_is_unique(typechecked.typed_program),
		})
	}


private func typechecked_prepared_module_with_ownership_and_trace(
	bound_module: BoundModule,
	module_surface: ModuleSurface,
	allow_debug_only_calls: Bool,
	ctfe_dependencies: List[PreparedCtfeDependency],
	accepted_graph: BodyTypecheckGraph,
	trace: (TypecheckTracePhase, Int) -> Void,
	main_policy: MainValidationPolicy,
) -> TypecheckedPreparedModuleResult:
	scope = bound_module_scope(bound_module)
	initial_state = graph_typecheck_state(scope, allow_debug_only_calls)

	typed_result = match body_graph_typecheck_module(
		accepted_graph,
		bound_module_identity(bound_module),
		initial_state,
	):
		Some(header_module):
			typecheck_program_with_type_header_module_and_trace_for_policy(
				header_module,
				trace,
				main_policy,
			)
		None:
			trace(HeaderModuleMismatch, TYPECHECK_TRACE_UNINDEXED)
			diagnostics = body_graph_completion_diagnostics(
				accepted_graph,
				bound_module_identity(bound_module),
			)

			if diagnostics.is_empty():
				rejected_typecheck_program(
					initial_state,
					bound_module_program(bound_module),
					"accepted type-header graph does not own the requested module",
				)
			else:
				rejected_typecheck_program_with_diagnostics(
					initial_state,
					bound_module_program(bound_module),
					diagnostics,
				)

	after_typecheck_unique = typed_program_is_unique(typed_result.program)

	imported_programs = ctfe_imported_programs_for_artifact(
		typed_program_has_ctfe_globals(typed_result.program),
		ctfe_dependencies,
	)
	ctfe_artifact = typecheck_ctfe_artifact(typed_result, imported_programs)
	after_ctfe_unique = typed_program_is_unique(ctfe_artifact.program)
	typechecked = typechecked_module_from_ctfe_artifact(scope, module_surface, ctfe_artifact)

	{
		module = typechecked,
		ownership = Some({
			after_typecheck_unique = after_typecheck_unique,
			after_ctfe_unique = after_ctfe_unique,
			after_module_construction_unique = typed_program_is_unique(typechecked.typed_program),
		})
	}


private pure func typechecked_reusable_ctfe_module(
	scope: PreparedModuleScope,
	module_surface: ModuleSurface,
	artifact: ReusableCtfeArtifact,
	ctfe_dependencies: List[PreparedCtfeDependency],
) -> TypecheckedModule:
	imported_program = artifact.imported_program

	imported_programs: Option[List[CtfeImportedProgram]] = if typed_program_has_ctfe_globals(
		artifact.complete_program,
	):
		ctfe_imported_programs_from_dependencies(ctfe_dependencies)
	else:
		Some([])

	ctfe_artifact = evaluated_typecheck_artifact(
		artifact.complete_program,
		[],
		[],
		ctfe_imported_program_import_bindings(imported_program),
		imported_programs,
	)

	typechecked_module_from_ctfe_artifact(scope, module_surface, ctfe_artifact)


private pure func typechecked_module_artifact(
	module: TypecheckedModule,
	include_comments: Bool,
) -> JsonValue:
	var fields: List[(String, JsonValue)] = [
		("path", JsonString(module.path)),
		("module", JsonString(module.module_name)),
		("ast_phase", JsonString(parsed_program_phase_name(TypecheckSourceProgram))),
		("typed_program", typed_program_to_json(module.typed_program)),
		("ctfe_status", JsonString(typecheck_ctfe_status_name(module.ctfe_evaluated))),
		("type_errors", JsonVector(module.errors.map(
				pure func(item: String): JsonString(item),
			))),
		("import_bindings", JsonVector(module.import_bindings.map(import_binding_to_json))),
		("module_surface", module_surface_to_json(module.module_surface)),
	]

	if include_comments:
		fields = fields.append(("comments", source_comment_jsons(module.parsed_program.source)))

	JsonObject(fields)


private func emit_json_string_list(
	items: List[String],
	emit: (String) -> Void,
) -> Void:
	emit("[")
	var first: Bool = True

	for item in items:
		if first:
			first = False
		else:
			emit(",")

		emit_json_chunks(JsonString(item), emit)

	emit("]")


private func emit_import_bindings(
	items: List[ImportBinding],
	emit: (String) -> Void,
) -> Void:
	emit("[")
	var first: Bool = True

	for item in items:
		if first:
			first = False
		else:
			emit(",")

		emit_json_chunks(import_binding_to_json(item), emit)

	emit("]")


private func emit_typechecked_module_artifact_chunks(
	module: TypecheckedModule,
	include_comments: Bool,
	emit: (String) -> Void,
) -> Void:
	emit("{\"path\":")
	emit_json_chunks(JsonString(module.path), emit)
	emit(",\"module\":")
	emit_json_chunks(JsonString(module.module_name), emit)
	emit(",\"ast_phase\":")
	emit_json_chunks(JsonString(parsed_program_phase_name(TypecheckSourceProgram)), emit)
	emit(",\"typed_program\":")
	emit_compiler_typed_program_json_chunks(module.typed_program, emit)
	emit(",\"ctfe_status\":")
	emit_json_chunks(JsonString(typecheck_ctfe_status_name(module.ctfe_evaluated)), emit)
	emit(",\"type_errors\":")
	emit_json_string_list(module.errors, emit)
	emit(",\"import_bindings\":")
	emit_import_bindings(module.import_bindings, emit)
	emit(",\"module_surface\":")
	emit_json_chunks(module_surface_to_json(module.module_surface), emit)

	if include_comments:
		emit(",\"comments\":")
		emit_json_chunks(source_comment_jsons(module.parsed_program.source), emit)

	emit("}")


private pure func typechecked_rejected_module_with_diagnostics(
	target: RejectedTypecheckTarget,
	diagnostics: List[TypecheckDiagnostic],
) -> TypecheckedModule:
	program = rejected_target_program(target)
	errors = diagnostics.map(func(diagnostic): diagnostic.message)
	resolved_identity = resolved_module_identity_from_resolver(
		rejected_target_path(target),
		rejected_target_origin(target),
	)
	{
		path = program.source.path,
		module_name = program.source.module_name,
		module_path = rejected_target_path(target),
		module_identity = module_identity_from_resolved(resolved_identity),
		parsed_program = program,
		module_surface = module_surface_for_program(program),
		semantic_program = {
			source = program.source,
			decls = [],
			diagnostics = program.diagnostics,
			type_definitions = [],
			type_references = []
		},
		typed_program = {
			source = program.source,
			decls = [],
			diagnostics = program.diagnostics,
			type_definitions = [],
			type_references = []
		},
		errors = errors,
		diagnostics = diagnostics,
		import_bindings = [],
		ctfe_evaluated = False
	}


private pure func typechecked_rejected_module(
	target: RejectedTypecheckTarget,
	errors: List[String],
) -> TypecheckedModule:
	typechecked_rejected_module_with_diagnostics(
		target,
		typecheck_diagnostics_from_messages(errors),
	)


private pure func rejected_typechecked_graph(
	target: RejectedTypecheckTarget,
	diagnostics: List[TypecheckDiagnostic],
) -> TypecheckedGraph:
	seed = definition_index_initial_seed(ENV_EMPTY)
	{
		target = typechecked_rejected_module_with_diagnostics(target, diagnostics),
		modules = [],
		next_def_id = definition_index_seed_next_def_id(seed),
		analysis_context = None
	}


private pure func typed_source_artifact(
	path: String,
	module_name: String,
	text: String,
	include_comments: Bool,
	allow_debug_only_calls: Bool,
	origin: ModuleOrigin,
	import_modules: List[TypecheckImportModule],
	resolved_imports: List[TypecheckResolvedImport],
) -> JsonValue:
	import_path_rewrites = finalized_import_path_rewrites(resolved_imports)
	module_candidate = prepare_typecheck_module(
		{
			path = path,
			module_name = module_name,
			module_path = module_name,
			text = text,
			typecheck_program = None,
			origin = origin
		},
		import_path_rewrites,
	)
	indexed_result = indexed_graph_build(
		module_candidate,
		prepare_typecheck_modules(import_modules, import_path_rewrites),
	)

	match indexed_result:
		Err(errors):
			typechecked_module_artifact(
				typechecked_rejected_module(
					RejectedCandidateTarget(module_candidate),
					indexed_graph_error_messages(errors),
				),
				include_comments,
			)
		Ok(indexed_graph):
			module_scope = indexed_graph_target_scope(indexed_graph)
			module = prepared_module_scope_module(module_scope)
			prepared_imports = indexed_graph_modules(indexed_graph)
			importable_graph = importable_module_graph(indexed_graph)
			importable_modules = importable_module_graph_dependencies(importable_graph)
			module_surface = module_surface_for_program(prepared_module_program(module))
			binding_importable_index = importable_module_graph_all_index(importable_graph)
			ctfe_dependency_plan = append_ctfe_dependencies_for_artifact(
				{
					visited_paths = [],
					dependencies = []
				},
				module,
				prepared_imports,
			).dependencies
			binding_module_paths = append_unique_binding_module_paths([], prepared_imports)

			binding_result = if importable_modules.length() == 0:
				bind_standalone_typecheck_graph(indexed_graph, allow_debug_only_calls)
			else:
				bind_typecheck_graph(
					indexed_graph,
					binding_module_paths,
					binding_importable_index,
					allow_debug_only_calls,
				)

			match binding_result:
				Err(errors):
					typechecked_module_artifact(
						typechecked_rejected_module(
							RejectedPreparedTarget(module),
							bound_module_graph_error_messages(errors),
						),
						include_comments,
					)
				Ok(bound_graph):
					match validated_implementation_headers(bound_graph):
						Err(errors):
							typechecked_module_artifact(
								typechecked_rejected_module_with_diagnostics(
									RejectedPreparedTarget(module),
									errors,
								),
								include_comments,
							)
						Ok(implementation_headers):
							match complete_typecheck_graph(
								implementation_headers,
								importable_graph,
								allow_debug_only_calls,
							):
								TypecheckGraphCompletionRejected(completion_errors):
									typechecked_module_artifact(
										typechecked_rejected_module(
											RejectedPreparedTarget(module),
											completion_errors,
										),
										include_comments,
									)
								TypecheckGraphRecoverable(recoverable_graph):
									typechecked_module_artifact(
										typechecked_rejected_module_with_diagnostics(
											RejectedPreparedTarget(module),
											recoverable_typecheck_graph_diagnostics(
												recoverable_graph,
											),
										),
										include_comments,
									)
								TypecheckGraphAccepted(accepted_graph):
									ctfe_result = prepare_ctfe_dependencies_from_bound_graph(
										module_scope,
										bound_graph,
										ctfe_dependency_plan,
										prepared_imports,
										[],
										allow_debug_only_calls,
										AcceptedBodyTypecheckGraph(accepted_graph),
									)

									match ctfe_result:
										Err(errors):
											typechecked_module_artifact(
												typechecked_rejected_module(
													RejectedPreparedTarget(module),
													bound_module_graph_error_messages(errors),
												),
												include_comments,
											)
										Ok(ctfe_dependencies):
											typechecked_module_artifact(
												typechecked_prepared_module(
													bound_module_graph_target(bound_graph),
													module_surface,
													allow_debug_only_calls,
													ctfe_dependencies.modules,
													AcceptedBodyTypecheckGraph(accepted_graph),
													IgnoreMainName,
												),
												include_comments,
											)


private pure func freshly_typechecked_graph_module(
	request: TypecheckGraphRequest,
	prepared: PreparedTypecheckModule,
	bound_module: BoundModule,
	module_surface: ModuleSurface,
	module_ctfe_dependencies: List[PreparedCtfeDependency],
	include_inventory: Bool,
	main_policy: MainValidationPolicy,
	seed_outcomes: Option[List[BodyCheckOutcome]],
) -> TypecheckedGraphModuleResult:
	if include_inventory:
		prepared_result = typechecked_prepared_module_with_ownership(
			bound_module,
			module_surface,
			request.allow_debug_only_calls,
			module_ctfe_dependencies,
			prepared.context.typecheck_graph,
			main_policy,
		)
		{
			module = prepared_result.module,
			origin = FreshGraphModule,
			ownership = prepared_result.ownership,
			reused_bodies = 0
		}
	else:
		match seed_outcomes:
			Some(outcomes):
				seeded = typechecked_prepared_module_with_seeded_bodies(
					bound_module,
					module_surface,
					request.allow_debug_only_calls,
					module_ctfe_dependencies,
					prepared.context.typecheck_graph,
					main_policy,
					outcomes,
				)
				{
					module = seeded.module,
					origin = FreshGraphModule,
					ownership = None,
					reused_bodies = seeded.reused_bodies
				}
			None:
				{
					module = typechecked_prepared_module(
						bound_module,
						module_surface,
						request.allow_debug_only_calls,
						module_ctfe_dependencies,
						prepared.context.typecheck_graph,
						main_policy,
					),
					origin = FreshGraphModule,
					ownership = None,
					reused_bodies = 0
				}


private pure func typechecked_graph_module(
	request: TypecheckGraphRequest,
	prepared: PreparedTypecheckModule,
	include_inventory: Bool,
	main_policy: MainValidationPolicy,
) -> TypecheckedGraphModuleResult:
	bound_module = prepared.bound_module
	module_scope = bound_module_scope(bound_module)
	module = prepared_module_scope_module(module_scope)
	module_ctfe_dependencies = prepared_ctfe_dependencies_for_artifact(
		module,
		prepared.context.all_modules,
		prepared.context.ctfe_dependencies,
	)
	module_surface = prepared_module_surface(
		module,
		body_graph_import_modules(prepared.context.typecheck_graph),
	)

	seed_outcomes = match main_policy:
		ValidateProgramMain:
			prepared.context.target_ctfe_body_outcomes
		IgnoreMainName:
			ctfe_body_outcomes_for_module(
				prepared.context.ctfe_dependencies,
				prepared_module_canonical_path(module),
			)

	result = match reusable_ctfe_program_for_module(
		prepared.context.ctfe_dependencies,
		prepared_module_canonical_path(module),
	):
		Some(imported_program):
			{
				module = typechecked_reusable_ctfe_module(
					module_scope,
					module_surface,
					imported_program,
					module_ctfe_dependencies,
				),
				origin = ReusedCtfeGraphModule,
				ownership = None,
				reused_bodies = 0
			}
		None:
			freshly_typechecked_graph_module(
				request,
				prepared,
				bound_module,
				module_surface,
				module_ctfe_dependencies,
				include_inventory,
				main_policy,
				seed_outcomes,
			)

	result


private func typechecked_graph_module_with_trace(
	request: TypecheckGraphRequest,
	prepared: PreparedTypecheckModule,
	trace: (TypecheckTracePhase, Int) -> Void,
	main_policy: MainValidationPolicy,
) -> TypecheckedGraphModuleResult:
	bound_module = prepared.bound_module
	module_scope = bound_module_scope(bound_module)
	module = prepared_module_scope_module(module_scope)
	module_ctfe_dependencies = prepared_ctfe_dependencies_for_artifact(
		module,
		prepared.context.all_modules,
		prepared.context.ctfe_dependencies,
	)
	module_surface = prepared_module_surface(
		module,
		body_graph_import_modules(prepared.context.typecheck_graph),
	)

	result = match reusable_ctfe_program_for_module(
		prepared.context.ctfe_dependencies,
		prepared_module_canonical_path(module),
	):
		Some(imported_program):
			{
				module = typechecked_reusable_ctfe_module(
					module_scope,
					module_surface,
					imported_program,
					module_ctfe_dependencies,
				),
				origin = ReusedCtfeGraphModule,
				ownership = None,
				reused_bodies = 0
			}
		None:
			prepared_result = typechecked_prepared_module_with_ownership_and_trace(
				bound_module,
				module_surface,
				request.allow_debug_only_calls,
				module_ctfe_dependencies,
				prepared.context.typecheck_graph,
				trace,
				main_policy,
			)
			{
				module = prepared_result.module,
				origin = FreshGraphModule,
				ownership = prepared_result.ownership,
				reused_bodies = 0
			}

	result


private pure func prepare_typecheck_graph_from_completed_headers(
	request: TypecheckGraphRequest,
	target: PreparedModule,
	target_scope: PreparedModuleScope,
	bound_graph: BoundModuleGraph,
	ctfe_dependency_plan: List[PreparedModule],
	modules: List[PreparedModule],
	selected_modules: List[PreparedModule],
	typecheck_graph: BodyTypecheckGraph,
) -> PreparedTypecheckGraphResult:
	bound_target = bound_module_graph_target(bound_graph)
	bound_modules = selected_bound_modules(bound_graph, request.module_targets)
	ctfe_result = prepare_ctfe_dependencies_from_bound_graph(
		target_scope,
		bound_graph,
		ctfe_dependency_plan,
		modules,
		selected_modules.map(func(module): prepared_module_canonical_path(module)),
		request.allow_debug_only_calls,
		typecheck_graph,
	)

	match ctfe_result:
		Err(errors):
			PreparedTypecheckGraphRejected(
				RejectedPreparedTarget(target),
				typecheck_diagnostics_from_messages(bound_module_graph_error_messages(errors)),
			)
		Ok(ctfe_dependencies):
			typecheck_context = prepared_typecheck_context(
				modules,
				ctfe_dependencies,
				typecheck_graph,
			)
			PreparedTypecheckGraphReady({
				target = prepared_typecheck_module(bound_target, typecheck_context),
				modules = bound_modules.map(
					func(module): prepared_typecheck_module(module, typecheck_context),
				),
			})


private pure func prepare_typecheck_graph(
	request: TypecheckGraphRequest,
) -> PreparedTypecheckGraphResult:
	import_path_rewrites = finalized_import_path_rewrites(request.resolved_imports)
	target_candidate = prepare_typecheck_module(request.target, import_path_rewrites)
	indexed_result = indexed_graph_build(
		target_candidate,
		prepare_typecheck_modules(request.modules, import_path_rewrites),
	)

	match indexed_result:
		Err(errors):
			PreparedTypecheckGraphRejected(
				RejectedCandidateTarget(target_candidate),
				typecheck_diagnostics_from_messages(indexed_graph_error_messages(errors)),
			)
		Ok(indexed_graph):
			target_scope = indexed_graph_target_scope(indexed_graph)
			target = prepared_module_scope_module(target_scope)
			modules = indexed_graph_modules(indexed_graph)
			importable_graph = importable_module_graph(indexed_graph)
			importable_index = importable_module_graph_all_index(importable_graph)

			match indexed_graph_select_dependency_scopes(indexed_graph, request.module_targets):
				Err(errors):
					PreparedTypecheckGraphRejected(
						RejectedPreparedTarget(target),
						typecheck_diagnostics_from_messages(indexed_graph_error_messages(errors)),
					)
				Ok(selected_scopes):
					selected_modules = selected_scopes.map(prepared_module_scope_module)
					ctfe_dependency_plan = ctfe_dependencies_for_graph(
						target,
						modules,
						selected_modules,
					)
					binding_module_paths = append_unique_binding_module_paths(
						request.module_targets,
						modules,
					)

					match bind_typecheck_graph(
						indexed_graph,
						binding_module_paths,
						importable_index,
						request.allow_debug_only_calls,
					):
						Err(errors):
							PreparedTypecheckGraphRejected(
								RejectedPreparedTarget(target),
								typecheck_diagnostics_from_messages(
									bound_module_graph_error_messages(errors),
								),
							)
						Ok(bound_graph):
							match validated_implementation_headers(bound_graph):
								Err(errors):
									PreparedTypecheckGraphRejected(
										RejectedPreparedTarget(target),
										errors,
									)
								Ok(implementation_headers):
									match complete_typecheck_graph(
										implementation_headers,
										importable_graph,
										request.allow_debug_only_calls,
									):
										TypecheckGraphCompletionRejected(completion_errors):
											PreparedTypecheckGraphRejected(
												RejectedPreparedTarget(target),
												typecheck_diagnostics_from_messages(
													completion_errors,
												),
											)
										TypecheckGraphRecoverable(recoverable_graph):
											prepare_typecheck_graph_from_completed_headers(
												request,
												target,
												target_scope,
												bound_graph,
												ctfe_dependency_plan,
												modules,
												selected_modules,
												RecoverableBodyTypecheckGraph(recoverable_graph),
											)
										TypecheckGraphAccepted(accepted_graph):
											prepare_typecheck_graph_from_completed_headers(
												request,
												target,
												target_scope,
												bound_graph,
												ctfe_dependency_plan,
												modules,
												selected_modules,
												AcceptedBodyTypecheckGraph(accepted_graph),
											)


private pure func prepared_ctfe_dependencies_contain_program(
	dependencies: List[PreparedCtfeDependency],
	module_path: String,
) -> Bool:
	dependencies.any(func(dependency):
		if dependency.module_path != module_path:
			False
		else:
			match dependency.program:
				ReusableCtfeProgram(_):
					True
				SelectiveCtfeProgram(_, _):
					True
				EagerCtfeOnlyProgram(_):
					True
				FailedCtfeProgram:
					False
	)


private func emit_prepared_graph_inventory(
	target: PreparedModule,
	modules: List[PreparedModule],
	selected_modules: List[PreparedModule],
	importable_modules: List[ImportableModule],
	ctfe_dependency_plan: List[PreparedModule],
	definition_index: DefinitionIndex,
	declaration_skeleton_count: Int,
	inventory: (String, String) -> Void,
) -> Void:
	var parsed_source_bytes: Int = prepared_module_program(target).source.text.length()
	var parsed_decls: Int = prepared_module_program(target).decls.length()
	var importable_decls: Int = 0
	var ctfe_selected_overlap: Int = 0

	for module in modules:
		parsed_source_bytes += prepared_module_program(module).source.text.length()
		parsed_decls += prepared_module_program(module).decls.length()

	for importable in importable_modules:
		importable_decls += importable_module_decls(importable).length()

	for dependency in ctfe_dependency_plan:
		dependency_path = prepared_module_canonical_path(dependency)

		if selected_modules.any(
			func(module): prepared_module_canonical_path(module) == dependency_path,
		):
			ctfe_selected_overlap += 1

	target_path = prepared_module_canonical_path(target)

	ctfe_target_overlap = if ctfe_dependency_plan.any(
		func(module): prepared_module_canonical_path(module) == target_path,
	):
		1
	else:
		0

	inventory(
		"graph",
		"module=" + typecheck_inventory_field(
			prepared_module_canonical_path(target),
		) + " modules=" + modules
			.length()
			.to_string() + " selected_modules=" + selected_modules
			.length()
			.to_string() + " parsed_source_bytes=" + parsed_source_bytes.to_string() + " parsed_decls=" + parsed_decls.to_string() + " importable_modules=" + importable_modules
			.length()
			.to_string() + " importable_decls=" + importable_decls.to_string() + " ctfe_dependencies=" + ctfe_dependency_plan
			.length()
			.to_string() + " ctfe_selected_overlap=" + ctfe_selected_overlap.to_string() + " ctfe_target_overlap=" + ctfe_target_overlap.to_string() + " callable_ids=" + definition_index_func_callable_id_count(
			definition_index,
		).to_string() + " source_definition_ids=" + definition_index_source_definition_id_count(
			definition_index,
		).to_string() + " declaration_skeletons=" + declaration_skeleton_count.to_string(),
	)


private func prepare_typecheck_graph_from_completed_headers_with_trace(
	request: TypecheckGraphRequest,
	target: PreparedModule,
	target_scope: PreparedModuleScope,
	bound_graph: BoundModuleGraph,
	ctfe_dependency_plan: List[PreparedModule],
	modules: List[PreparedModule],
	selected_modules: List[PreparedModule],
	artifact_importable_modules: List[ImportableModule],
	definition_index: DefinitionIndex,
	typecheck_graph: BodyTypecheckGraph,
	trace: (TypecheckTracePhase, Int, String) -> Void,
	include_inventory: Bool,
	inventory: (String, String) -> Void,
) -> PreparedTypecheckGraphResult:
	bound_target = bound_module_graph_target(bound_graph)
	bound_modules = selected_bound_modules(bound_graph, request.module_targets)
	ctfe_result = prepare_ctfe_dependencies_from_bound_graph_with_trace(
		target_scope,
		bound_graph,
		ctfe_dependency_plan,
		modules,
		selected_modules.map(func(module): prepared_module_canonical_path(module)),
		request.allow_debug_only_calls,
		typecheck_graph,
		trace,
		include_inventory,
		inventory,
	)

	match ctfe_result:
		Err(errors):
			PreparedTypecheckGraphRejected(
				RejectedPreparedTarget(target),
				typecheck_diagnostics_from_messages(bound_module_graph_error_messages(errors)),
			)
		Ok(ctfe_dependencies):
			if include_inventory:
				emit_prepared_graph_inventory(
					target,
					modules,
					selected_modules,
					artifact_importable_modules,
					ctfe_dependency_plan,
					definition_index,
					body_graph_declaration_skeleton_count(typecheck_graph),
					inventory,
				)

			typecheck_context = prepared_typecheck_context(
				modules,
				ctfe_dependencies,
				typecheck_graph,
			)
			PreparedTypecheckGraphReady({
				target = prepared_typecheck_module(bound_target, typecheck_context),
				modules = bound_modules.map(
					func(module): prepared_typecheck_module(module, typecheck_context),
				),
			})


private func prepare_typecheck_graph_with_trace(
	request: TypecheckGraphRequest,
	trace: (TypecheckTracePhase, Int, String) -> Void,
	include_inventory: Bool,
	inventory: (String, String) -> Void,
) -> PreparedTypecheckGraphResult:
	target_module_path = request.target.module_path
	import_path_rewrites = finalized_import_path_rewrites(request.resolved_imports)
	target_candidate = prepare_typecheck_module(request.target, import_path_rewrites)
	indexed_result = indexed_graph_build(
		target_candidate,
		prepare_typecheck_modules(request.modules, import_path_rewrites),
	)
	trace(GraphParseComplete, TYPECHECK_TRACE_UNINDEXED, target_module_path)

	match indexed_result:
		Err(errors):
			PreparedTypecheckGraphRejected(
				RejectedCandidateTarget(target_candidate),
				typecheck_diagnostics_from_messages(indexed_graph_error_messages(errors)),
			)
		Ok(indexed_graph):
			target_scope = indexed_graph_target_scope(indexed_graph)
			target = prepared_module_scope_module(target_scope)
			modules = indexed_graph_modules(indexed_graph)
			definition_index = indexed_graph_definition_index(indexed_graph)
			importable_graph = importable_module_graph(indexed_graph)
			artifact_importable_modules = importable_module_graph_dependencies(importable_graph)
			importable_index = importable_module_graph_all_index(importable_graph)
			trace(GraphImportablesComplete, TYPECHECK_TRACE_UNINDEXED, target_module_path)
			trace(GraphDefinitionIndexComplete, TYPECHECK_TRACE_UNINDEXED, target_module_path)

			match indexed_graph_select_dependency_scopes(indexed_graph, request.module_targets):
				Err(errors):
					PreparedTypecheckGraphRejected(
						RejectedPreparedTarget(target),
						typecheck_diagnostics_from_messages(indexed_graph_error_messages(errors)),
					)
				Ok(selected_scopes):
					selected_modules = selected_scopes.map(prepared_module_scope_module)
					ctfe_dependency_plan = ctfe_dependencies_for_graph(
						target,
						modules,
						selected_modules,
					)
					trace(GraphCtfePlanComplete, TYPECHECK_TRACE_UNINDEXED, target_module_path)
					binding_module_paths = append_unique_binding_module_paths(
						request.module_targets,
						modules,
					)

					match bind_typecheck_graph(
						indexed_graph,
						binding_module_paths,
						importable_index,
						request.allow_debug_only_calls,
					):
						Err(errors):
							PreparedTypecheckGraphRejected(
								RejectedPreparedTarget(target),
								typecheck_diagnostics_from_messages(
									bound_module_graph_error_messages(errors),
								),
							)
						Ok(bound_graph):
							match validated_implementation_headers(bound_graph):
								Err(errors):
									PreparedTypecheckGraphRejected(
										RejectedPreparedTarget(target),
										errors,
									)
								Ok(implementation_headers):
									trace(
										GraphDeclarationSkeletonComplete,
										TYPECHECK_TRACE_UNINDEXED,
										target_module_path,
									)
									trace(
										GraphTypeAliasDependenciesComplete,
										TYPECHECK_TRACE_UNINDEXED,
										target_module_path,
									)
									trace(
										GraphTypeParameterHeadersComplete,
										TYPECHECK_TRACE_UNINDEXED,
										target_module_path,
									)
									trace(
										GraphTypeHeadersComplete,
										TYPECHECK_TRACE_UNINDEXED,
										target_module_path,
									)
									trace(
										GraphTraitTopologyComplete,
										TYPECHECK_TRACE_UNINDEXED,
										target_module_path,
									)
									trace(
										GraphCallableHeadersComplete,
										TYPECHECK_TRACE_UNINDEXED,
										target_module_path,
									)
									trace(
										GraphImplementationHeadersComplete,
										TYPECHECK_TRACE_UNINDEXED,
										target_module_path,
									)

									match complete_typecheck_graph(
										implementation_headers,
										importable_graph,
										request.allow_debug_only_calls,
									):
										TypecheckGraphCompletionRejected(completion_errors):
											PreparedTypecheckGraphRejected(
												RejectedPreparedTarget(target),
												typecheck_diagnostics_from_messages(
													completion_errors,
												),
											)
										TypecheckGraphRecoverable(recoverable_graph):
											prepare_typecheck_graph_from_completed_headers_with_trace(
												request,
												target,
												target_scope,
												bound_graph,
												ctfe_dependency_plan,
												modules,
												selected_modules,
												artifact_importable_modules,
												definition_index,
												RecoverableBodyTypecheckGraph(recoverable_graph),
												trace,
												include_inventory,
												inventory,
											)
										TypecheckGraphAccepted(accepted_graph):
											prepare_typecheck_graph_from_completed_headers_with_trace(
												request,
												target,
												target_scope,
												bound_graph,
												ctfe_dependency_plan,
												modules,
												selected_modules,
												artifact_importable_modules,
												definition_index,
												AcceptedBodyTypecheckGraph(accepted_graph),
												trace,
												include_inventory,
												inventory,
											)


private pure func ctfe_materialization_metrics(
	dependencies: List[PreparedCtfeDependency],
	target_discovery_body_checks: Int,
	eager_fallback: CtfeEagerFallbackKind,
	reused_body_checks: Int,
) -> CtfeMaterializationMetrics:
	var selective_dependency_modules: Int = 0
	var eager_dependency_modules: Int = 0
	var failed_dependency_modules: Int = 0

	for dependency in dependencies:
		match dependency.program:
			SelectiveCtfeProgram(_, _):
				selective_dependency_modules += 1
			ReusableCtfeProgram(_):
				eager_dependency_modules += 1
			EagerCtfeOnlyProgram(_):
				eager_dependency_modules += 1
			FailedCtfeProgram:
				failed_dependency_modules += 1

	{
		dependency_body_checks = dependencies
			.map(func(dependency): dependency.body_checks)
			.sum(),
		target_discovery_body_checks = target_discovery_body_checks,
		reused_body_checks = reused_body_checks,
		selective_dependency_modules = selective_dependency_modules,
		eager_dependency_modules = eager_dependency_modules,
		failed_dependency_modules = failed_dependency_modules,
		eager_fallback = eager_fallback
	}


pure func typecheck_graph_with_metrics(request: TypecheckGraphRequest) -> TypecheckGraphRun:
	match prepare_typecheck_graph(request):
		PreparedTypecheckGraphRejected(target, diagnostics):
			{
				graph = rejected_typechecked_graph(target, diagnostics),
				ctfe = {
					dependency_body_checks = 0,
					target_discovery_body_checks = 0,
					reused_body_checks = 0,
					selective_dependency_modules = 0,
					eager_dependency_modules = 0,
					failed_dependency_modules = 0,
					eager_fallback = CtfeNoEagerFallback
				}
			}
		PreparedTypecheckGraphReady(graph):
			target_result = typechecked_graph_module(
				request,
				graph.target,
				False,
				ValidateProgramMain,
			)
			var modules: List[TypecheckedModule] = []
			var reused_body_checks: Int = target_result.reused_bodies

			for prepared in graph.modules:
				module_result = typechecked_graph_module(request, prepared, False, IgnoreMainName)
				modules = modules.append(module_result.module)
				reused_body_checks += module_result.reused_bodies

			{
				graph = {
					target = target_result.module,
					modules = modules,
					next_def_id = definition_index_next_def_id(
						prepared_module_scope_definition_index(
							bound_module_scope(graph.target.bound_module),
						),
					),
					analysis_context = None
				},
				ctfe = ctfe_materialization_metrics(
					graph.target.context.ctfe_dependencies,
					graph.target.context.target_ctfe_discovery_body_checks,
					graph.target.context.ctfe_eager_fallback,
					reused_body_checks,
				)
			}


pure func typecheck_graph(request: TypecheckGraphRequest) -> TypecheckedGraph:
	match prepare_typecheck_graph(request):
		PreparedTypecheckGraphRejected(target, diagnostics):
			rejected_typechecked_graph(target, diagnostics)
		PreparedTypecheckGraphReady(graph):
			{
				target = typechecked_graph_module(
					request,
					graph.target,
					False,
					ValidateProgramMain,
				).module,
				modules = graph.modules.map(
					func(
						prepared,
					): typechecked_graph_module(request, prepared, False, IgnoreMainName).module,
				),
				next_def_id = definition_index_next_def_id(
					prepared_module_scope_definition_index(
						bound_module_scope(graph.target.bound_module),
					),
				),
				analysis_context = None
			}


private pure func typechecked_rejected_module_response(
	request: TypecheckGraphRequest,
	target: RejectedTypecheckTarget,
	diagnostics: List[TypecheckDiagnostic],
) -> String:
	typechecked = typechecked_rejected_module_with_diagnostics(target, diagnostics)
	bridge_success_json(
		typechecked_module_artifact(
			typechecked,
			request.include_comments,
		),
	).to_string()


private pure func typechecked_graph_module_response(
	request: TypecheckGraphRequest,
	prepared: PreparedTypecheckModule,
	main_policy: MainValidationPolicy,
) -> String:
	artifact = typechecked_module_artifact(
		typechecked_graph_module(request, prepared, False, main_policy).module,
		request.include_comments,
	)
	bridge_success_json(artifact).to_string()


private func emit_typechecked_graph_module_response(
	request: TypecheckGraphRequest,
	prepared: PreparedTypecheckModule,
	emit: (String) -> Void,
	trace: (TypecheckTracePhase, Int, String) -> Void,
	include_inventory: Bool,
	inventory: (String, String) -> Void,
	main_policy: MainValidationPolicy,
) -> Void:
	module_scope = bound_module_scope(prepared.bound_module)
	module_path = prepared_module_canonical_path(prepared_module_scope_module(module_scope))
	trace(TypecheckStart, TYPECHECK_TRACE_UNINDEXED, module_path)

	trace_callback = func(phase: TypecheckTracePhase, declaration_index: Int):
		trace(phase, declaration_index, module_path)

	result = if include_inventory:
		typechecked_graph_module_with_trace(request, prepared, trace_callback, main_policy)
	else:
		typechecked_graph_module(request, prepared, False, main_policy)

	typechecked = result.module
	trace(TypecheckComplete, TYPECHECK_TRACE_UNINDEXED, module_path)

	if include_inventory:
		counts = typed_program_inventory(typechecked.typed_program)

		reuses_retained_ctfe = match result.origin:
			ReusedCtfeGraphModule:
				1
			FreshGraphModule:
				0

		duplicates_retained_ctfe = if reuses_retained_ctfe == 0:
			if prepared_ctfe_dependencies_contain_program(
				prepared.context.ctfe_dependencies,
				module_path,
			):
				1
			else:
				0
		else:
			0

		inventory(
			"artifact",
			"module=" + typecheck_inventory_field(
				module_path,
			) + " source_bytes=" + counts.source_bytes.to_string() + " typed_decls=" + counts.typed_decls.to_string() + " typed_expr_nodes=" + counts.typed_expr_nodes.to_string() + " retained_ctfe_dependencies=" + prepared.context.ctfe_dependencies
				.length()
				.to_string() + " duplicates_retained_ctfe=" + duplicates_retained_ctfe.to_string() + " reuses_retained_ctfe=" + reuses_retained_ctfe.to_string(),
		)

	emit("{\"schema\":")
	emit_json_chunks(bridge_schema_json(BRIDGE_SCHEMA_VERSION), emit)
	emit(",\"ok\":true,\"artifact\":")
	emit_typechecked_module_artifact_chunks(typechecked, request.include_comments, emit)
	trace(ProjectionComplete, TYPECHECK_TRACE_UNINDEXED, module_path)
	emit("}")
	emit("\n")
	trace(EmitComplete, TYPECHECK_TRACE_UNINDEXED, module_path)

	match result.ownership:
		Some(ownership):
			inventory(
				"artifact_ownership",
				"module=" + typecheck_inventory_field(
					module_path,
				) + " after_typecheck_unique=" + ownership.after_typecheck_unique.to_string() + " after_ctfe_unique=" + ownership.after_ctfe_unique.to_string() + " after_module_construction_unique=" + ownership.after_module_construction_unique.to_string() + " before_artifact_release_unique=" + typed_program_is_unique(
					typechecked.typed_program,
				).to_string(),
			)
		None:
			void


private func emit_typechecked_rejected_module_response(
	request: TypecheckGraphRequest,
	target: RejectedTypecheckTarget,
	diagnostics: List[TypecheckDiagnostic],
	emit: (String) -> Void,
	trace: (TypecheckTracePhase, Int, String) -> Void,
) -> Void:
	module_path = rejected_target_path(target)
	trace(TypecheckStart, TYPECHECK_TRACE_UNINDEXED, module_path)
	typechecked = typechecked_rejected_module_with_diagnostics(target, diagnostics)
	trace(TypecheckComplete, TYPECHECK_TRACE_UNINDEXED, module_path)
	emit("{\"schema\":")
	emit_json_chunks(bridge_schema_json(BRIDGE_SCHEMA_VERSION), emit)
	emit(",\"ok\":true,\"artifact\":")
	emit_typechecked_module_artifact_chunks(typechecked, request.include_comments, emit)
	trace(ProjectionComplete, TYPECHECK_TRACE_UNINDEXED, module_path)
	emit("}")
	emit("\n")
	trace(EmitComplete, TYPECHECK_TRACE_UNINDEXED, module_path)


private pure func handle_typecheck_source(
	body: JsonValue,
) -> Result[JsonValue, TypecheckBridgeDispatchError]:
	path ?= string_field(body, "path")
	module_name ?= string_field(body, "module")
	text ?= string_field(body, "text")
	import_modules ?= import_modules_named_field(body, "import_modules")
	resolved_imports ?= resolved_imports_field(body)
	include_comments = optional_bool_field(body, "include_comments", True)
	allow_debug_only_calls = optional_bool_field(body, "allow_debug_only_calls", False)
	origin ?= optional_origin_field(body)

	Ok(
		bridge_success_json(
			typed_source_artifact(
				path,
				module_name,
				text,
				include_comments,
				allow_debug_only_calls,
				origin,
				import_modules,
				resolved_imports,
			),
		),
	)


private pure func typecheck_graph_request_from_body(
	body: JsonValue,
) -> Result[TypecheckGraphRequest, TypecheckBridgeDispatchError]:
	target ?= import_module_named_field(body, "target")
	modules ?= import_modules_named_field(body, "modules")
	module_targets ?= string_list_named_field(body, "module_targets")
	resolved_imports ?= resolved_imports_field(body)
	include_comments = optional_bool_field(body, "include_comments", False)
	allow_debug_only_calls = optional_bool_field(body, "allow_debug_only_calls", False)

	Ok({
		target = target,
		modules = modules,
		module_targets = module_targets,
		resolved_imports = resolved_imports,
		include_comments = include_comments,
		allow_debug_only_calls = allow_debug_only_calls,
	})


func stream_typecheck_graph_request_value(
	root: JsonValue,
	emit: (String) -> Void,
) -> Bool:
	match decode_bridge_envelope_value(root):
		Ok(envelope):
			match envelope.action:
				TypecheckGraphAction:
					match typecheck_graph_request_from_body(envelope.payload):
						Ok(request):
							match prepare_typecheck_graph(request):
								PreparedTypecheckGraphRejected(target, diagnostics):
									emit(
										typechecked_rejected_module_response(
											request,
											target,
											diagnostics,
										),
									)
								PreparedTypecheckGraphReady(graph):
									for prepared in graph.modules:
										emit(
											typechecked_graph_module_response(
												request,
												prepared,
												IgnoreMainName,
											),
										)

									emit(
										typechecked_graph_module_response(
											request,
											graph.target,
											ValidateProgramMain,
										),
									)
						Err(error):
							emit(dispatch_error_json(error).to_string())

					True
				_:
					False
		Err(_):
			False


private func stream_typecheck_graph_request_chunks_impl(
	root: JsonValue,
	emit: (String) -> Void,
	trace: (TypecheckTracePhase, Int, String) -> Void,
	include_inventory: Bool,
	inventory: (String, String) -> Void,
) -> Bool:
	match decode_bridge_envelope_value(root):
		Ok(envelope):
			match envelope.action:
				TypecheckGraphAction:
					match typecheck_graph_request_from_body(envelope.payload):
						Ok(request):
							target_module_path = request.target.module_path
							trace(GraphPrepareStart, TYPECHECK_TRACE_UNINDEXED, target_module_path)
							prepared_result = prepare_typecheck_graph_with_trace(
								request,
								trace,
								include_inventory,
								inventory,
							)
							trace(
								GraphPrepareComplete,
								TYPECHECK_TRACE_UNINDEXED,
								target_module_path,
							)

							match prepared_result:
								PreparedTypecheckGraphRejected(target, diagnostics):
									emit_typechecked_rejected_module_response(
										request,
										target,
										diagnostics,
										emit,
										trace,
									)
									trace(
										TypedArtifactScopeComplete,
										TYPECHECK_TRACE_UNINDEXED,
										rejected_target_path(target),
									)
								PreparedTypecheckGraphReady(graph):
									for prepared in graph.modules:
										emit_typechecked_graph_module_response(
											request,
											prepared,
											emit,
											trace,
											include_inventory,
											inventory,
											IgnoreMainName,
										)

										trace(
											TypedArtifactScopeComplete,
											TYPECHECK_TRACE_UNINDEXED,
											prepared_module_canonical_path(
												prepared_module_scope_module(
													bound_module_scope(prepared.bound_module),
												),
											),
										)

									emit_typechecked_graph_module_response(
										request,
										graph.target,
										emit,
										trace,
										include_inventory,
										inventory,
										ValidateProgramMain,
									)
									trace(
										TypedArtifactScopeComplete,
										TYPECHECK_TRACE_UNINDEXED,
										prepared_module_canonical_path(
											prepared_module_scope_module(
												bound_module_scope(graph.target.bound_module),
											),
										),
									)
						Err(error):
							emit_json_chunks(dispatch_error_json(error), emit)
							emit("\n")

					True
				_:
					False
		Err(_):
			False


func stream_typecheck_graph_request_chunks(
	root: JsonValue,
	emit: (String) -> Void,
	trace: (TypecheckTracePhase, Int, String) -> Void,
) -> Bool:
	stream_typecheck_graph_request_chunks_impl(root, emit, trace, False, func(kind, fields):
		_ = kind.length() + fields.length()
	)


func stream_typecheck_graph_request_chunks_with_inventory(
	root: JsonValue,
	emit: (String) -> Void,
	trace: (TypecheckTracePhase, Int, String) -> Void,
	inventory: (String, String) -> Void,
) -> Bool:
	stream_typecheck_graph_request_chunks_impl(root, emit, trace, True, inventory)


private pure func handle_envelope(
	envelope: BridgeEnvelope,
) -> Result[JsonValue, TypecheckBridgeDispatchError]:
	body: JsonValue = envelope.payload

	match envelope.action:
		TypecheckSourceAction:
			handle_typecheck_source(body)
		_:
			Err(UnsupportedBridgeAction(envelope.action))


pure func handle_request_value(root: JsonValue) -> JsonValue:
	match decode_bridge_envelope_value(root):
		Ok(envelope):
			handle_envelope(envelope).get_or_else(dispatch_error_json)
		Err(error):
			bridge_error_json(error)


pure func handle_request(source: String) -> String:
	parse_json(source)
		.map(func(root): handle_request_value(root).to_string())
		.get_or_else(func(message): bridge_error_json(InvalidJson(message)).to_string())
