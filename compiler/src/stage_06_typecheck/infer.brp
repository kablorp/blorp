				)
			TypedSelectSealedArm(_, channel):
				result = append_impure_call_names(
					result,
					typed_expr_debug_block_impure_call_names(channel),
				)
			TypedSelectAfterArm(timeout):
				result = append_impure_call_names(
					result,
					typed_expr_debug_block_impure_call_names(timeout),
				)

		result = append_impure_call_names(
			result,
			typed_expr_debug_block_impure_call_names(arm.body),
		)

	result


pure func typed_expr_debug_block_impure_call_names(expr: TypedExpr) -> List[String]:
	match expr:
		TypedUnaryExpr(_, inner, _, _):
			typed_expr_debug_block_impure_call_names(inner)
		TypedBinaryExpr(_, left, right, _, _):
			append_impure_call_names(
				typed_expr_debug_block_impure_call_names(left),
				typed_expr_debug_block_impure_call_names(right),
			)
		TypedLogicalExpr(_, left, right, _, _):
			append_impure_call_names(
				typed_expr_debug_block_impure_call_names(left),
				typed_expr_debug_block_impure_call_names(right),
			)
		TypedCallExpr(callee, args, _, _):
			append_impure_call_names(
				typed_expr_debug_block_impure_call_names(callee),
				typed_expr_list_debug_block_impure_call_names(args),
			)
		TypedTupleExpr(items, _, _):
			typed_expr_list_debug_block_impure_call_names(items)
		TypedTupleDestructExpr(_, value, _, _):
			typed_expr_debug_block_impure_call_names(value)
		TypedAssignExpr(_, _, value, _, _):
			typed_expr_debug_block_impure_call_names(value)
		TypedSubscriptExpr(receiver, indices, _, _):
			append_impure_call_names(
				typed_expr_debug_block_impure_call_names(receiver),
				typed_expr_list_debug_block_impure_call_names(indices),
			)
		TypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
			with_indices = append_impure_call_names(
				typed_expr_debug_block_impure_call_names(receiver),
				typed_expr_list_debug_block_impure_call_names(indices),
			)
			append_impure_call_names(with_indices, typed_expr_debug_block_impure_call_names(value))
		TypedListExpr(items, _, _):
			typed_expr_list_debug_block_impure_call_names(items)
		TypedVectorExpr(items, _, _):
			typed_expr_list_debug_block_impure_call_names(items)
		TypedDictExpr(entries, _, _):
			typed_dict_entries_debug_block_impure_call_names(entries)
		TypedRecordExpr(fields, _, _):
			typed_record_fields_debug_block_impure_call_names(fields)
		TypedRecordUpdateExpr(base, fields, _, _, _):
			append_impure_call_names(
				typed_expr_debug_block_impure_call_names(base),
				typed_record_fields_debug_block_impure_call_names(fields),
			)
		TypedFieldAccessExpr(receiver, _, _, _):
			typed_expr_debug_block_impure_call_names(receiver)
		TypedLambdaExpr(_, _, _, body, _, _):
			typed_expr_debug_block_impure_call_names(body)
		TypedRangeExpr(start_expr, end_expr, _, _):
			append_impure_call_names(
				typed_expr_debug_block_impure_call_names(start_expr),
				typed_expr_debug_block_impure_call_names(end_expr),
			)
		TypedIfExpr(condition, then_branch, else_branch, _, _):
			with_then = append_impure_call_names(
				typed_expr_debug_block_impure_call_names(condition),
				typed_expr_debug_block_impure_call_names(then_branch),
			)

			match else_branch:
				Some(branch):
					append_impure_call_names(
						with_then,
						typed_expr_debug_block_impure_call_names(branch),
					)
				None:
					with_then
		TypedMatchExpr(scrutinee, cases, _, _):
			append_impure_call_names(
				typed_expr_debug_block_impure_call_names(scrutinee),
				typed_match_cases_debug_block_impure_call_names(cases),
			)
		TypedSelectExpr(arms, _, _):
			typed_select_arms_debug_block_impure_call_names(arms)
		TypedWhileExpr(condition, body, _, _):
			append_impure_call_names(
				typed_expr_debug_block_impure_call_names(condition),
				typed_expr_debug_block_impure_call_names(body),
			)
		TypedForExpr(_, iterable, _, body, _, _):
			append_impure_call_names(
				typed_expr_debug_block_impure_call_names(iterable),
				typed_expr_debug_block_impure_call_names(body),
			)
		TypedConcurrentBlockExpr(params, bindings, _, _):
			append_impure_call_names(
				typed_concurrent_params_debug_block_impure_call_names(params),
				typed_concurrent_bindings_debug_block_impure_call_names(bindings),
			)
		TypedConcurrentForExpr(_, iterable, params, body, _, _):
			with_iterable = typed_expr_debug_block_impure_call_names(iterable)
			with_params = append_impure_call_names(
				with_iterable,
				typed_concurrent_params_debug_block_impure_call_names(params),
			)
			append_impure_call_names(with_params, typed_expr_debug_block_impure_call_names(body))
		TypedDetachExpr(body, _, _):
			typed_expr_debug_block_impure_call_names(body)
		TypedAscriptionExpr(inner, _, _, _):
			typed_expr_debug_block_impure_call_names(inner)
		TypedOpaqueIntoExpr(_, inner, _, _):
			typed_expr_debug_block_impure_call_names(inner)
		TypedOpaqueFromExpr(_, inner, _, _):
			typed_expr_debug_block_impure_call_names(inner)
		TypedBlockExpr(items, _, _):
			typed_expr_list_debug_block_impure_call_names(items)
		TypedWithExpr(binding, body, _, _):
			append_impure_call_names(
				typed_with_binding_debug_block_impure_call_names(binding),
				typed_expr_debug_block_impure_call_names(body),
			)
		TypedDebugBlockExpr(body, _, _):
			typed_expr_impure_call_names(body)
		TypedVarDeclExpr(payload, _):
			typed_expr_debug_block_impure_call_names(payload.initializer)
		TypedQuestionBindExpr(_, _, value, _, _):
			typed_expr_debug_block_impure_call_names(value)
		_:
			[]


private pure func typed_expr_list_has_debug_block_assignment(exprs: List[TypedExpr]) -> Bool:
	var found: Bool = False

	for expr in exprs:
		if typed_expr_has_debug_block_assignment(expr):
			found = True
			break

	found


private pure func typed_expr_has_assignment_inside_debug_block(expr: TypedExpr) -> Bool:
	match expr:
		TypedAssignExpr(_, _, _, _, _):
			True
		TypedSubscriptAssignExpr(_, _, _, _, _, _):
			True
		TypedTupleDestructExpr(_, _, _, _):
			True
		TypedVarDeclExpr(_, _):
			True
		TypedQuestionBindExpr(_, _, _, _, _):
			True
		TypedUnaryExpr(_, inner, _, _):
			typed_expr_has_assignment_inside_debug_block(inner)
		TypedBinaryExpr(_, left, right, _, _):
			(
				typed_expr_has_assignment_inside_debug_block(left)
				or typed_expr_has_assignment_inside_debug_block(right)
			)
		TypedLogicalExpr(_, left, right, _, _):
			(
				typed_expr_has_assignment_inside_debug_block(left)
				or typed_expr_has_assignment_inside_debug_block(right)
			)
		TypedCallExpr(callee, args, _, _):
			(
				typed_expr_has_assignment_inside_debug_block(callee)
				or typed_expr_list_has_assignment_inside_debug_block(args)
			)
		TypedTupleExpr(items, _, _):
			typed_expr_list_has_assignment_inside_debug_block(items)
		TypedListExpr(items, _, _):
			typed_expr_list_has_assignment_inside_debug_block(items)
		TypedVectorExpr(items, _, _):
			typed_expr_list_has_assignment_inside_debug_block(items)
		TypedDictExpr(entries, _, _):
			typed_dict_entries_have_assignment_inside_debug_block(entries)
		TypedRecordExpr(fields, _, _):
			typed_record_fields_have_assignment_inside_debug_block(fields)
		TypedRecordUpdateExpr(base, fields, _, _, _):
			(
				typed_expr_has_assignment_inside_debug_block(base)
				or typed_record_fields_have_assignment_inside_debug_block(fields)
			)
		TypedFieldAccessExpr(receiver, _, _, _):
			typed_expr_has_assignment_inside_debug_block(receiver)
		TypedSubscriptExpr(receiver, indices, _, _):
			(
				typed_expr_has_assignment_inside_debug_block(receiver)
				or typed_expr_list_has_assignment_inside_debug_block(indices)
			)
		TypedLambdaExpr(_, _, _, _, _, _):
			False
		TypedBlockExpr(items, _, _):
			typed_expr_list_has_assignment_inside_debug_block(items)
		TypedDebugBlockExpr(body, _, _):
			typed_expr_has_assignment_inside_debug_block(body)
		TypedAscriptionExpr(inner, _, _, _):
			typed_expr_has_assignment_inside_debug_block(inner)
		TypedOpaqueIntoExpr(_, inner, _, _):
			typed_expr_has_assignment_inside_debug_block(inner)
		TypedOpaqueFromExpr(_, inner, _, _):
			typed_expr_has_assignment_inside_debug_block(inner)
		TypedIfExpr(condition, then_branch, else_branch, _, _):
			if (
				typed_expr_has_assignment_inside_debug_block(condition)
				or typed_expr_has_assignment_inside_debug_block(then_branch)
			):
				True
			else:
				match else_branch:
					Some(branch):
						typed_expr_has_assignment_inside_debug_block(branch)
					None:
						False
		TypedMatchExpr(scrutinee, cases, _, _):
			(
				typed_expr_has_assignment_inside_debug_block(scrutinee)
				or typed_match_cases_have_assignment_inside_debug_block(cases)
			)
		TypedSelectExpr(arms, _, _):
			typed_select_arms_have_assignment_inside_debug_block(arms)
		TypedWhileExpr(condition, body, _, _):
			(
				typed_expr_has_assignment_inside_debug_block(condition)
				or typed_expr_has_assignment_inside_debug_block(body)
			)
		TypedForExpr(_, iterable, _, body, _, _):
			(
				typed_expr_has_assignment_inside_debug_block(iterable)
				or typed_expr_has_assignment_inside_debug_block(body)
			)
		TypedConcurrentBlockExpr(params, bindings, _, _):
			(
				typed_concurrent_params_have_assignment_inside_debug_block(params)
				or typed_concurrent_bindings_have_assignment_inside_debug_block(bindings)
			)
		TypedConcurrentForExpr(_, iterable, params, body, _, _):
			(
				typed_expr_has_assignment_inside_debug_block(iterable)
				or typed_concurrent_params_have_assignment_inside_debug_block(params)
				or typed_expr_has_assignment_inside_debug_block(body)
			)
		TypedWithExpr(binding, body, _, _):
			(
				typed_with_binding_has_assignment_inside_debug_block(binding)
				or typed_expr_has_assignment_inside_debug_block(body)
			)
		TypedDetachExpr(body, _, _):
			typed_expr_has_assignment_inside_debug_block(body)
		TypedStringInterpolationPartsExpr(parts, _, _, _):
			typed_interpolation_parts_have_assignment_inside_debug_block(parts)
		_:
			False


private pure func typed_expr_list_has_assignment_inside_debug_block(exprs: List[TypedExpr]) -> Bool:
	var found: Bool = False

	for expr in exprs:
		if typed_expr_has_assignment_inside_debug_block(expr):
			found = True
			break

	found


private pure func typed_dict_entries_have_assignment_inside_debug_block(
	entries: List[TypedDictEntry],
) -> Bool:
	var found: Bool = False

	for entry in entries:
		if (
			typed_expr_has_assignment_inside_debug_block(entry.key)
			or typed_expr_has_assignment_inside_debug_block(entry.value)
		):
			found = True
			break

	found


private pure func typed_record_fields_have_assignment_inside_debug_block(
	fields: List[TypedRecordField],
) -> Bool:
	var found: Bool = False

	for field in fields:
		if typed_expr_has_assignment_inside_debug_block(field.value):
			found = True
			break

	found


private pure func typed_concurrent_params_have_assignment_inside_debug_block(
	params: List[TypedConcurrentParam],
) -> Bool:
	var found: Bool = False

	for param in params:
		if typed_expr_has_assignment_inside_debug_block(param.value):
			found = True
			break

	found


private pure func typed_concurrent_bindings_have_assignment_inside_debug_block(
	bindings: List[TypedConcurrentBinding],
) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if typed_expr_has_assignment_inside_debug_block(binding.value):
			found = True
			break

	found


private pure func typed_with_binding_has_assignment_inside_debug_block(
	binding: TypedWithBinding,
) -> Bool:
	if typed_expr_has_assignment_inside_debug_block(binding.value):
		True
	else:
		match binding.error_map:
			Some(mapper):
				typed_expr_has_assignment_inside_debug_block(mapper.value)
			None:
				False


private pure func typed_interpolation_parts_have_assignment_inside_debug_block(
	parts: List[TypedStringInterpolationPart],
) -> Bool:
	var found: Bool = False

	for part in parts:
		match part:
			TypedInterpolationLiteral(_):
				void
			TypedInterpolationExpr(expr):
				if typed_expr_has_assignment_inside_debug_block(expr):
					found = True
					break

	found


private pure func typed_match_cases_have_assignment_inside_debug_block(
	cases: List[TypedMatchCase],
) -> Bool:
	var found: Bool = False

	for case in cases:
		if typed_expr_has_assignment_inside_debug_block(case.body):
			found = True
			break

	found


private pure func typed_select_arm_kind_has_assignment_inside_debug_block(
	kind: TypedSelectArmKind,
) -> Bool:
	match kind:
		TypedSelectReceiveArm(_, _, channel):
			typed_expr_has_assignment_inside_debug_block(channel)
		TypedSelectSealedArm(_, channel):
			typed_expr_has_assignment_inside_debug_block(channel)
		TypedSelectAfterArm(timeout):
			typed_expr_has_assignment_inside_debug_block(timeout)


private pure func typed_select_arms_have_assignment_inside_debug_block(
	arms: List[TypedSelectArm],
) -> Bool:
	var found: Bool = False

	for arm in arms:
		if (
			typed_select_arm_kind_has_assignment_inside_debug_block(arm.kind)
			or typed_expr_has_assignment_inside_debug_block(arm.body)
		):
			found = True
			break

	found


pure func typed_expr_has_debug_block_assignment(expr: TypedExpr) -> Bool:
	match expr:
		TypedDebugBlockExpr(body, _, _):
			typed_expr_has_assignment_inside_debug_block(body)
		TypedLambdaExpr(_, _, _, body, _, _):
			typed_expr_has_debug_block_assignment(body)
		TypedBlockExpr(items, _, _):
			typed_expr_list_has_debug_block_assignment(items)
		TypedConcurrentBlockExpr(params, bindings, _, _):
			(
				typed_concurrent_params_have_debug_block_assignment(params)
				or typed_concurrent_bindings_have_debug_block_assignment(bindings)
			)
		TypedConcurrentForExpr(_, iterable, params, body, _, _):
			(
				typed_expr_has_debug_block_assignment(iterable)
				or typed_concurrent_params_have_debug_block_assignment(params)
				or typed_expr_has_debug_block_assignment(body)
			)
		TypedWithExpr(binding, body, _, _):
			(
				typed_with_binding_has_debug_block_assignment(binding)
				or typed_expr_has_debug_block_assignment(body)
			)
		TypedDetachExpr(body, _, _):
			typed_expr_has_debug_block_assignment(body)
		TypedIfExpr(condition, then_branch, else_branch, _, _):
			if (
				typed_expr_has_debug_block_assignment(condition)
				or typed_expr_has_debug_block_assignment(then_branch)
			):
				True
			else:
				match else_branch:
					Some(branch):
						typed_expr_has_debug_block_assignment(branch)
					None:
						False
		TypedMatchExpr(scrutinee, cases, _, _):
			(
				typed_expr_has_debug_block_assignment(scrutinee)
				or typed_match_cases_have_debug_block_assignment(cases)
			)
		TypedSelectExpr(arms, _, _):
			typed_select_arms_have_debug_block_assignment(arms)
		TypedWhileExpr(condition, body, _, _):
			(
				typed_expr_has_debug_block_assignment(condition)
				or typed_expr_has_debug_block_assignment(body)
			)
		TypedForExpr(_, iterable, _, body, _, _):
			(
				typed_expr_has_debug_block_assignment(iterable)
				or typed_expr_has_debug_block_assignment(body)
			)
		_:
			False


private pure func typed_match_cases_have_debug_block_assignment(
	cases: List[TypedMatchCase],
) -> Bool:
	var found: Bool = False

	for case in cases:
		if typed_expr_has_debug_block_assignment(case.body):
			found = True
			break

	found


private pure func typed_select_arm_kind_has_debug_block_assignment(
	kind: TypedSelectArmKind,
) -> Bool:
	match kind:
		TypedSelectReceiveArm(_, _, channel):
			typed_expr_has_debug_block_assignment(channel)
		TypedSelectSealedArm(_, channel):
			typed_expr_has_debug_block_assignment(channel)
		TypedSelectAfterArm(timeout):
			typed_expr_has_debug_block_assignment(timeout)


private pure func typed_select_arms_have_debug_block_assignment(arms: List[TypedSelectArm]) -> Bool:
	var found: Bool = False

	for arm in arms:
		if (
			typed_select_arm_kind_has_debug_block_assignment(arm.kind)
			or typed_expr_has_debug_block_assignment(arm.body)
		):
			found = True
			break

	found


private pure func typed_concurrent_params_have_debug_block_assignment(
	params: List[TypedConcurrentParam],
) -> Bool:
	var found: Bool = False

	for param in params:
		if typed_expr_has_debug_block_assignment(param.value):
			found = True
			break

	found


private pure func typed_concurrent_bindings_have_debug_block_assignment(
	bindings: List[TypedConcurrentBinding],
) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if typed_expr_has_debug_block_assignment(binding.value):
			found = True
			break

	found


private pure func typed_with_binding_has_debug_block_assignment(binding: TypedWithBinding) -> Bool:
	if typed_expr_has_debug_block_assignment(binding.value):
		True
	else:
		match binding.error_map:
			Some(mapper):
				typed_expr_has_debug_block_assignment(mapper.value)
			None:
				False


pure func typed_expr_var_initializer_widening(expr: TypedExpr) -> TypeWideningDecision:
	match expr:
		TypedVarDeclExpr(payload, _):
			typed_expr_widening(payload.initializer)
		_:
			TypeKeep(TYPE_VOID)


pure func typed_expr_binary_left_widening(expr: TypedExpr) -> TypeWideningDecision:
	match expr:
		TypedBinaryExpr(_, left, _, _, _):
			typed_expr_widening(left)
		_:
			TypeKeep(TYPE_VOID)


pure func typed_expr_binary_right_widening(expr: TypedExpr) -> TypeWideningDecision:
	match expr:
		TypedBinaryExpr(_, _, right, _, _):
			typed_expr_widening(right)
		_:
			TypeKeep(TYPE_VOID)


pure func typed_expr_call_arg_widening(expr: TypedExpr, index: Int) -> TypeWideningDecision:
	match expr:
		TypedCallExpr(_, args, _, _):
			match args.get(index):
				Some(arg):
					typed_expr_widening(arg)
				None:
					TypeKeep(TYPE_VOID)
		_:
			TypeKeep(TYPE_VOID)


pure func typed_expr_list_item_widening(expr: TypedExpr, index: Int) -> TypeWideningDecision:
	match expr:
		TypedListExpr(items, _, _):
			match items.get(index):
				Some(item):
					typed_expr_widening(item)
				None:
					TypeKeep(TYPE_VOID)
		_:
			TypeKeep(TYPE_VOID)


pure func typed_expr_vector_item_widening(expr: TypedExpr, index: Int) -> TypeWideningDecision:
	match expr:
		TypedVectorExpr(items, _, _):
			match items.get(index):
				Some(item):
					typed_expr_widening(item)
				None:
					TypeKeep(TYPE_VOID)
		_:
			TypeKeep(TYPE_VOID)


pure func typed_expr_dict_key_widening(expr: TypedExpr, index: Int) -> TypeWideningDecision:
	match expr:
		TypedDictExpr(entries, _, _):
			match entries.get(index):
				Some(entry):
					typed_expr_widening(entry.key)
				None:
					TypeKeep(TYPE_VOID)
		_:
			TypeKeep(TYPE_VOID)


pure func typed_expr_dict_value_widening(expr: TypedExpr, index: Int) -> TypeWideningDecision:
	match expr:
		TypedDictExpr(entries, _, _):
			match entries.get(index):
				Some(entry):
					typed_expr_widening(entry.value)
				None:
					TypeKeep(TYPE_VOID)
		_:
			TypeKeep(TYPE_VOID)


private pure func typed_record_field_widening(
	fields: List[TypedRecordField],
	field_name: String,
) -> TypeWideningDecision:
	var result: TypeWideningDecision = TypeKeep(TYPE_VOID)
	var index: Int = 0
	var found: Bool = False

	while index < fields.length() and not found:
		match fields.get(index):
			Some(field):
				if field.name.text == field_name:
					result = typed_expr_widening(field.value)
					found = True
			None:
				void

		index += 1

	result


pure func typed_expr_record_field_widening(
	expr: TypedExpr,
	field_name: String,
) -> TypeWideningDecision:
	match expr:
		TypedRecordExpr(fields, _, _):
			typed_record_field_widening(fields, field_name)
		TypedRecordUpdateExpr(_, fields, _, _, _):
			typed_record_field_widening(fields, field_name)
		_:
			TypeKeep(TYPE_VOID)


pure func typed_expr_field_access_receiver_type(expr: TypedExpr) -> Option[SemanticType]:
	match expr:
		TypedFieldAccessExpr(receiver, _, _, _):
			Some(typed_expr_semantic_type(receiver))
		_:
			None


private pure func infer_result(context: InferContext, expr: TypedExpr) -> InferResult:
	{
		context = context,
		expr = expr
	}


private pure func infer_error(context: InferContext, message: String) -> InferContext:
	diagnostic = typecheck_diagnostic(message, None)
	infer_context_with_state(
		context,
		{ context.state |
			errors = context.state.errors.append(message),
			diagnostics = context.state.diagnostics.append(diagnostic)
		},
	)


private pure func checked_type(context: InferContext, typ: SemanticType) -> CheckedType:
	{
		context = context,
		typ = typ
	}


private pure func binary_op_symbol(op: ParsedBinaryOp) -> String:
	match op:
		ParsedAddOp:
			"+"
		ParsedSubtractOp:
			"-"
		ParsedMultiplyOp:
			"*"
		ParsedDivideOp:
			"/"
		ParsedModuloOp:
			"%"
		ParsedEqualOp:
			"=="
		ParsedNotEqualOp:
			"!="
		ParsedLessOp:
			"<"
		ParsedLessEqualOp:
			"<="
		ParsedGreaterOp:
			">"
		ParsedGreaterEqualOp:
			">="


private pure func is_arithmetic_binary_op(op: ParsedBinaryOp) -> Bool:
	match op:
		ParsedAddOp:
			True
		ParsedSubtractOp:
			True
		ParsedMultiplyOp:
			True
		ParsedDivideOp:
			True
		ParsedModuloOp:
			True
		_:
			False


private pure func is_modulo_binary_op(op: ParsedBinaryOp) -> Bool:
	match op:
		ParsedModuloOp:
			True
		_:
			False


private pure func arithmetic_trait_name(op: ParsedBinaryOp) -> String:
	match op:
		ParsedAddOp:
			"Addable"
		ParsedSubtractOp:
			"Subtractable"
		ParsedMultiplyOp:
			"Multipliable"
		ParsedDivideOp:
			"Divisible"
		ParsedModuloOp:
			"Modulable"
		_:
			"Addable"


private pure func named_value_type_is(typ: SemanticType, name: String) -> Bool:
	match typ:
		SemanticNamedType(type_name, args):
			type_name == name and args.length() == 0
		_:
			False


private pure func named_type_head_is(typ: SemanticType, name: String) -> Bool:
	match typ:
		SemanticNamedType(type_name, _):
			type_name == name
		_:
			False


private pure func is_fixed_type(typ: SemanticType) -> Bool:
	named_value_type_is(typ, "Fixed")


private pure func is_orderable_primitive_type(typ: SemanticType) -> Bool:
	(
		named_value_type_is(typ, "Int")
		or named_value_type_is(typ, "Float")
		or named_value_type_is(typ, "String")
		or named_value_type_is(typ, "Char")
		or is_fixed_type(typ)
		or is_any_float_type(typ)
		or is_any_integer_type(typ)
	)


private pure func is_equality_primitive_type(typ: SemanticType) -> Bool:
	is_orderable_primitive_type(typ) or named_value_type_is(typ, "Bool")


private pure func is_enum_value_type(context: InferContext, typ: SemanticType) -> Bool:
	match typ:
		SemanticNamedType(name, args):
			if args.length() != 0:
				False
			else:
				match module_view_accepted_union_type_index(context.state.facts.module_view):
					Some(index):
						union_type_index_find(index, name)
							.map(func(entry): entry.is_enum)
							.get_or(False)
					None:
						match env_get_type_kind(context.state.env, name):
							Some(kind):
								kind == TypeEnum
							None:
								False
		_:
			False


private pure func type_param_name(context: InferContext, typ: SemanticType) -> Option[String]:
	type_params = env_get_type_params(context.state.env)

	match typ:
		SemanticTypeVar(name):
			if type_params.contains(name):
				Some(name)
			else:
				None
		SemanticNamedType(name, args):
			if args.length() == 0 and type_params.contains(name):
				Some(name)
			else:
				None
		_:
			None


private pure func type_satisfies_trait(
	context: InferContext,
	typ: SemanticType,
	trait_name: String,
) -> Bool:
	infer_resolve_trait_obligation(
		context,
		trait_obligation(typ, trait_name),
	) == TraitObligationSatisfied


private pure func tensor_element_supports_arithmetic(
	context: InferContext,
	typ: SemanticType,
) -> Bool:
	if is_any_integer_type(typ) or is_any_float_type(typ):
		True
	else:
		match type_param_name(context, typ):
			Some(_):
				(
					type_satisfies_trait(context, typ, "Integer")
					or type_satisfies_trait(context, typ, "FloatingPoint")
				)
			None:
				False


private pure func dim_is_variadic(typ: SemanticType) -> Bool:
	match typ:
		SemanticVarDimsType(_):
			True
		_:
			False


private pure func tensor_arithmetic_result_type(
	context: InferContext,
	op: ParsedBinaryOp,
	left_type: SemanticType,
	right_type: SemanticType,
) -> Option[SemanticType]:
	if not is_arithmetic_binary_op(op) or is_modulo_binary_op(op):
		None
	else:
		match (array_type_parts(left_type), array_type_parts(right_type)):
			(Some((element, dims)), None):
				if (
					tensor_element_supports_arithmetic(context, element)
					and types_equal(element, right_type)
				):
					Some(left_type)
				else:
					None
			(None, Some((element, dims))):
				if (
					tensor_element_supports_arithmetic(context, element)
					and types_equal(left_type, element)
				):
					Some(right_type)
				else:
					None
			(Some((left_element, left_dims)), Some((right_element, right_dims))):
				if (
					tensor_element_supports_arithmetic(context, left_element)
					and types_equal(left_element, right_element)
					and not left_dims.any(dim_is_variadic)
					and not right_dims.any(dim_is_variadic)
					and types_equal(left_type, right_type)
				):
					Some(left_type)
				else:
					None
			_:
				None


private pure func is_structural_equality_collection(typ: SemanticType) -> Bool:
	match typ:
		SemanticNamedType(name, _):
			normalized_name: String = normalize_type_name(name)

			normalized_name == "List" or normalized_name == "Dict" or normalized_name == "Set"
		_:
			False


private pure func open_exhaustiveness_scalar_name(typ: SemanticType) -> Option[String]:
	if (
		is_any_integer_type(typ)
		or is_any_float_type(typ)
		or named_value_type_is(typ, "String")
		or named_value_type_is(typ, "Char")
		or is_fixed_type(typ)
	):
		Some(type_to_string(typ))
	else:
		None


private pure func arithmetic_result_type(
	context: InferContext,
	op: ParsedBinaryOp,
	left_type: SemanticType,
	right_type: SemanticType,
) -> Option[SemanticType]:
	match tensor_arithmetic_result_type(context, op, left_type, right_type):
		Some(result_type):
			Some(result_type)
		None:
			if named_value_type_is(left_type, "Int") and named_value_type_is(right_type, "Int"):
				Some(TYPE_INT)
			else if (
				named_value_type_is(left_type, "Float")
				and named_value_type_is(right_type, "Float")
			):
				Some(TYPE_FLOAT)
			else if (
				is_fixed_type(left_type)
				and is_fixed_type(right_type)
				and not is_modulo_binary_op(op)
			):
				Some(SemanticNamedType("Fixed", []))
			else if (
				op == ParsedAddOp
				and named_value_type_is(left_type, "String")
				and named_value_type_is(right_type, "String")
			):
				Some(TYPE_STRING)
			else if is_any_float_type(left_type) and types_equal(left_type, right_type):
				Some(left_type)
			else if is_any_integer_type(left_type) and types_equal(left_type, right_type):
				Some(left_type)
			else:
				None


private pure func check_arithmetic_binary_op(
	context: InferContext,
	op: ParsedBinaryOp,
	left_type: SemanticType,
	right_type: SemanticType,
) -> CheckedType:
	match arithmetic_result_type(context, op, left_type, right_type):
		Some(result_type):
			checked_type(context, result_type)
		None:
			if array_type_parts(left_type).is_some() or array_type_parts(right_type).is_some():
				next = infer_error(
					context,
					"Tensor arithmetic requires concrete numeric element types, got " + type_to_string(
						left_type,
					) + " and " + type_to_string(right_type),
				)
				checked_type(next, TYPE_VOID)
			else:
				left_param_name = type_param_name(context, left_type)
				right_param_name = type_param_name(context, right_type)
				trait_name = arithmetic_trait_name(op)

				match (left_param_name, right_param_name):
					(Some(left_name), Some(right_name)):
						if left_name != right_name:
							next = infer_error(
								context,
								"Cannot apply " + binary_op_symbol(
									op,
								) + " to different type parameters " + type_to_string(
									left_type,
								) + " and " + type_to_string(right_type),
							)
							checked_type(next, TYPE_VOID)
						else if type_satisfies_trait(context, left_type, trait_name):
							checked_type(context, left_type)
						else:
							next = infer_error(
								context,
								"Type parameter '" + left_name + "' requires " + trait_name + " bound for " + binary_op_symbol(
									op,
								) + " operator",
							)
							checked_type(next, TYPE_VOID)
					_:
						if (
							types_equal(left_type, right_type)
							and not is_equality_primitive_type(left_type)
							and type_satisfies_trait(context, left_type, trait_name)
						):
							checked_type(context, left_type)
						else:
							next = infer_error(
								context,
								"Cannot apply " + binary_op_symbol(
									op,
								) + " to " + type_to_string(
									left_type,
								) + " and " + type_to_string(right_type),
							)
							checked_type(next, TYPE_VOID)


private pure func check_comparison_binary_op(
	context: InferContext,
	left_type: SemanticType,
	right_type: SemanticType,
) -> CheckedType:
	left_param_name = type_param_name(context, left_type)
	right_param_name = type_param_name(context, right_type)

	if types_equal(left_type, right_type) and is_orderable_primitive_type(left_type):
		checked_type(context, TYPE_BOOL)
	else:
		match (left_param_name, right_param_name):
			(Some(left_name), Some(right_name)):
				if left_name != right_name:
					next = infer_error(
						context,
						"Comparison requires the same type parameter, got " + left_name + " and " + right_name,
					)
					checked_type(next, TYPE_VOID)
				else if type_satisfies_trait(context, left_type, "Orderable"):
					checked_type(context, TYPE_BOOL)
				else:
					next = infer_error(
						context,
						"Type parameter '" + left_name + "' requires Orderable bound for comparison operators",
					)
					checked_type(next, TYPE_VOID)
			_:
				if (
					types_equal(left_type, right_type)
					and type_satisfies_trait(context, left_type, "Orderable")
				):
					checked_type(context, TYPE_BOOL)
				else:
					next = infer_error(
						context,
						"Comparison requires matching types that implement Orderable, got " + type_to_string(
							left_type,
						) + " and " + type_to_string(right_type),
					)
					checked_type(next, TYPE_VOID)


private pure func check_equality_binary_op(
	context: InferContext,
	left_type: SemanticType,
	right_type: SemanticType,
) -> CheckedType:
	resolved_left = infer_resolve_alias(context, left_type)
	resolved_right = infer_resolve_alias(context, right_type)

	match unify_symmetric(context.state.context, resolved_left, resolved_right):
		Some(step):
			next_state = { context.state | context = step.context }
			next_context = infer_context_with_state(context, next_state)
			zonked_left = zonk_type(step.context, resolved_left)
			zonked_right = zonk_type(step.context, resolved_right)
			left_param_name = type_param_name(next_context, zonked_left)
			right_param_name = type_param_name(next_context, zonked_right)

			if (
				is_equality_primitive_type(zonked_left)
				or is_enum_value_type(next_context, zonked_left)
				or is_structural_equality_collection(zonked_left)
			):
				checked_type(next_context, TYPE_BOOL)
			else:
				match (left_param_name, right_param_name):
					(Some(left_name), Some(right_name)):
						if left_name != right_name:
							next = infer_error(
								next_context,
								"Cannot compare type parameters " + type_to_string(
									zonked_left,
								) + " and " + type_to_string(
									zonked_right,
								) + " because equality requires the same type",
							)
							checked_type(next, TYPE_VOID)
						else if type_satisfies_trait(next_context, zonked_left, "Equatable"):
							checked_type(next_context, TYPE_BOOL)
						else:
							next = infer_error(
								next_context,
								"Type parameter '" + left_name + "' requires Equatable bound for == and " + "!= operators. Add '" + left_name + ": Equatable' to the function signature",
							)
							checked_type(next, TYPE_VOID)
					_:
						checked_type(next_context, TYPE_BOOL)
		None:
			next = infer_error(
				context,
				"Equality comparison requires compatible types, got " + type_to_string(
					left_type,
				) + " and " + type_to_string(right_type),
			)
			checked_type(next, TYPE_VOID)


private pure func check_binary_op(
	context: InferContext,
	op: ParsedBinaryOp,
	left_type: SemanticType,
	right_type: SemanticType,
) -> CheckedType:
	if is_arithmetic_binary_op(op):
		check_arithmetic_binary_op(context, op, left_type, right_type)
	else:
		match op:
			ParsedLessOp:
				check_comparison_binary_op(context, left_type, right_type)
			ParsedLessEqualOp:
				check_comparison_binary_op(context, left_type, right_type)
			ParsedGreaterOp:
				check_comparison_binary_op(context, left_type, right_type)
			ParsedGreaterEqualOp:
				check_comparison_binary_op(context, left_type, right_type)
			ParsedEqualOp:
				check_equality_binary_op(context, left_type, right_type)
			ParsedNotEqualOp:
				check_equality_binary_op(context, left_type, right_type)
			_:
				next = infer_error(context, "Unsupported binary operator")
				checked_type(next, TYPE_VOID)


private pure func mod_result_type(
	op: ParsedBinaryOp,
	left_semantic_type: SemanticType,
	right_semantic_type: SemanticType,
	result_type: SemanticType,
) -> SemanticType:
	if not is_modulo_binary_op(op):
		result_type
	else:
		lhs_non_negative = match left_semantic_type:
			SemanticRangeType(_):
				True
			SemanticConstIntType(value):
				value >= 0
			_:
				False

		if not lhs_non_negative:
			result_type
		else:
			match right_semantic_type:
				SemanticConstIntType(bound):
					if bound > 0:
						SemanticRangeType(SemanticConstIntType(bound))
					else:
						result_type
				_:
					result_type


private pure func unary_operand_slot(op: ParsedUnaryOp, operand_type: SemanticType) -> ValueSlot:
	match op:
		ParsedNegateOp:
			numeric_operand_slot(ParsedSubtractOp, operand_type)
		ParsedNotOp:
			KeptValueSlot(operand_type)


private pure func is_negatable_array_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticArrayType(element_type, _):
			(
				named_value_type_is(element_type, "Int")
				or is_signed_integer_type(element_type)
				or is_any_float_type(element_type)
			)
		_:
			False


private pure func check_unary_op(
	context: InferContext,
	op: ParsedUnaryOp,
	operand_type: SemanticType,
) -> CheckedType:
	match op:
		ParsedNegateOp:
			if named_value_type_is(operand_type, "Int"):
				checked_type(context, TYPE_INT)
			else if named_value_type_is(operand_type, "Float"):
				checked_type(context, TYPE_FLOAT)
			else if is_negatable_array_type(operand_type):
				checked_type(context, operand_type)
			else if is_any_float_type(operand_type):
				checked_type(context, operand_type)
			else if is_signed_integer_type(operand_type):
				checked_type(context, operand_type)
			else if is_unsigned_integer_type(operand_type):
				next = infer_error(
					context,
					"Cannot negate unsigned type " + type_to_string(operand_type),
				)
				checked_type(next, TYPE_VOID)
			else if type_satisfies_trait(context, operand_type, "Negatable"):
				checked_type(context, operand_type)
			else:
				next = infer_error(
					context,
					"Negation requires numeric type, got " + type_to_string(operand_type),
				)
				checked_type(next, TYPE_VOID)
		ParsedNotOp:
			if named_value_type_is(operand_type, "Bool"):
				checked_type(context, TYPE_BOOL)
			else:
				next = infer_error(
					context,
					"Logical not requires Bool, got " + type_to_string(operand_type),
				)
				checked_type(next, TYPE_VOID)


private pure func check_logical_op(
	context: InferContext,
	left_type: SemanticType,
	right_type: SemanticType,
) -> CheckedType:
	if named_value_type_is(left_type, "Bool") and named_value_type_is(right_type, "Bool"):
		checked_type(context, TYPE_BOOL)
	else:
		next = infer_error(
			context,
			"Logical operation requires Bool operands, got " + type_to_string(
				left_type,
			) + " and " + type_to_string(right_type),
		)
		checked_type(next, TYPE_VOID)


private pure func parse_int_literal(text: String) -> Int:
	text
		.parse_int()
		.get_or(0)


private pure func type_can_interpolate(typ: SemanticType) -> Bool:
	if (
		named_value_type_is(typ, "Int")
		or named_value_type_is(typ, "Float")
		or named_value_type_is(typ, "Bool")
		or named_value_type_is(typ, "Char")
		or named_value_type_is(typ, "String")
		or is_any_integer_type(typ)
		or is_any_float_type(typ)
	):
		True
	else:
		match typ:
			SemanticConstIntType(_):
				True
			SemanticRangeType(_):
				True
			SemanticArrayType(_, _):
				True
			SemanticNamedType(name, _):
				(
					name == "List"
					or name == "Result"
					or name == "Tensor"
					or name == "Vector"
					or name == "Matrix"
				)
			_:
				False


private pure func interpolation_type_error(
	context: InferContext,
	typ: SemanticType,
) -> InferContext:
	infer_error(
		context,
		"Interpolated expression has type " + type_to_string(typ) + ((
			" which cannot be converted to String. Implement Stringable for this type or "
			+ "convert it explicitly"
		)),
	)


private pure func infer_string_interpolation_parts(
	context: InferContext,
	parts: List[ParsedStringInterpolationPart],
) -> InferStringInterpolationPartsResult:
	var next_context: InferContext = context
	var typed_parts: List[TypedStringInterpolationPart] = []

	for part in parts:
		match part:
			ParsedInterpolationLiteral(value):
				typed_parts = typed_parts.append(TypedInterpolationLiteral(value))
			ParsedInterpolationExpr(expr):
				expr_result = infer_expr(infer_without_expected(next_context), expr)
				expr_type = typed_expr_semantic_type(expr_result.expr)

				next_context = if type_can_interpolate(expr_type):
					expr_result.context
				else:
					interpolation_type_error(expr_result.context, expr_type)

				typed_parts = typed_parts.append(TypedInterpolationExpr(expr_result.expr))

	{
		context = infer_without_expected(next_context),
		parts = typed_parts
	}


private pure func infer_string_interpolation_parts_expr(
	context: InferContext,
	parts: List[ParsedStringInterpolationPart],
	is_multiline: Bool,
	span: SourceSpan,
) -> InferResult:
	parts_result = infer_string_interpolation_parts(context, parts)
	result_context = infer_context_with_state(context, parts_result.context.state)
	typed = TypedStringInterpolationPartsExpr(
		parts_result.parts,
		is_multiline,
		span,
		inferred_info(result_context, TYPE_STRING),
	)

	infer_result(result_context, typed)


private pure func inferred_string_literal_type(context: InferContext) -> SemanticType:
	match infer_context_expected_type(context):
		Some(SemanticNamedType(name, args)):
			if name == "LiteralString" and args.length() == 0:
				SemanticNamedType(name, [])
			else:
				TYPE_STRING
		_:
			TYPE_STRING


private pure func var_origin_resource_dependencies(name: String, origin: VarOrigin) -> List[String]:
	match origin:
		ScopedResource:
			[name]
		ScopedResourceUnavailable(_):
			[name]
		ScopedResourceDerived:
			[name]
		_:
			[]


private pure func constructor_return_type(
	context: InferContext,
	parent_type: String,
	type_params: List[String],
	field_types: List[SemanticType],
) -> CheckedType:
	expected_constructor_type: Option[SemanticType] = match infer_context_expected_type(context):
		Some(SemanticNamedType(expected_name, args)):
			if expected_name == parent_type and args.length() == type_params.length():
				Some(SemanticNamedType(parent_type, args))
			else:
				None
		_:
			None

	match expected_constructor_type:
		Some(typ):
			checked_type(context, typ)
		None:
			var type_context: Context = context.state.context
			var args: List[SemanticType] = []

			for param in type_params:
				if field_types.any(func(field_type): occurs_in(param, field_type)):
					args = args.append(SemanticTypeVar(param))
				else:
					step = fresh_meta_with_origin(type_context, param)
					type_context = step.context
					args = args.append(step.meta_type)

			next_state = { context.state | context = type_context }
			checked_type(
				infer_context_with_state(context, next_state),
				SemanticNamedType(parent_type, args),
			)


private pure func constructor_return_subst(
	type_params: List[String],
	return_type: SemanticType,
) -> List[SemanticTypeSubstEntry]:
	match return_type:
		SemanticNamedType(_, args):
			var result: List[SemanticTypeSubstEntry] = []
			var index: Int = 0

			while index < type_params.length() and index < args.length():
				match (type_params.get(index), args.get(index)):
					(Some(name), Some(arg)):
						result = result.append(type_subst_entry(name, arg))
					_:
						void

				index += 1

			result
		_:
			[]


private pure func constructor_expr_type(
	context: InferContext,
	parent_type: String,
	type_params: List[String],
	field_types: List[SemanticType],
) -> CheckedType:
	return_step = constructor_return_type(context, parent_type, type_params, field_types)

	if field_types.length() == 0:
		return_step
	else:
		subst = constructor_return_subst(type_params, return_step.typ)
		checked_type(
			return_step.context,
			SemanticFunctionType(
				True,
				field_types.map(func(field_type): apply_subst(subst, field_type)),
				return_step.typ,
			),
		)


private pure func infer_constructor_name_expr(
	context: InferContext,
	name: ParsedIdentifier,
	ctor: ConstructorSymbol,
) -> InferResult:
	constructor_step = constructor_expr_type(
		context,
		ctor.parent_type,
		ctor.type_params,
		ctor.field_types,
	)
	constructor_type = constructor_step.typ
	resolved_call = Some(
		resolved_call_from_constructor(
			name.text,
			ctor.constructor_id,
			ctor.parent_type,
			constructor_type,
		),
	)
	expr = TypedNameExpr(
		name,
		typed_expr_info_from_slot(
			None,
			InferredOrigin,
			UNREFINED_BINDING,
			resolved_call,
			KeptValueSlot(constructor_type),
		),
	)

	infer_result(constructor_step.context, expr)


private pure func module_path_matches_span(module_path: String, span: SourceSpan) -> Bool:
	(
		module_path == span.module_name
		or module_path == span.path
		or span.path.ends_with(module_path + ".brp")
	)


private pure func module_symbol_visible_as_bare(
	context: InferContext,
	span: SourceSpan,
	local_name: String,
	module_path: Option[String],
	original_name: String,
) -> Bool:
	match module_path:
		None:
			True
		Some(path):
			if module_path_matches_span(path, span):
				True
			else:
				module_view_has_selective_binding(
					context.state.facts.module_view,
					local_name,
					path,
					original_name,
				)


private pure func constructor_visible_as_bare(
	context: InferContext,
	span: SourceSpan,
	local_name: String,
	original_name: String,
	ctor: ConstructorSymbol,
) -> Bool:
	match infer_facts_find_type_home(context.state.facts, ctor.parent_type):
		Some(module_path):
			module_symbol_visible_as_bare(
				context,
				span,
				local_name,
				Some(module_path),
				original_name,
			)
		None:
			True


private pure func find_accepted_bare_constructor_symbol(
	context: InferContext,
	name: String,
) -> Option[Symbol]:
	match module_view_accepted_union_type_index(context.state.facts.module_view):
		Some(index):
			match infer_context_expected_type(context):
				Some(SemanticNamedType(parent_type, _)):
					union_type_index_find_constructor_symbol_for_parent(index, parent_type, name)
				_:
					union_type_index_find_constructor_symbol(index, name)
		None:
			None


private pure func find_accepted_bare_constructor(
	context: InferContext,
	name: String,
) -> Option[ConstructorSymbol]:
	match find_accepted_bare_constructor_symbol(context, name):
		Some(symbol):
			match symbol.kind:
				ConstructorSymbolKind(constructor):
					Some(constructor)
				_:
					None
		None:
			None


private pure func find_bare_constructor(
	context: InferContext,
	env: Env,
	name: String,
) -> Option[ConstructorSymbol]:
	match module_view_accepted_union_type_index(context.state.facts.module_view):
		Some(_):
			match env_lookup(env, name):
				Some(symbol):
					match symbol.kind:
						ConstructorSymbolKind(_):
							find_accepted_bare_constructor(context, name)
						_:
							None
				None:
					find_accepted_bare_constructor(context, name)
		None:
			env_get_constructor(env, name)


private pure func find_bare_constructor_for_type(
	context: InferContext,
	env: Env,
	name: String,
	typ: SemanticType,
) -> Option[ConstructorSymbol]:
	match (module_view_accepted_union_type_index(context.state.facts.module_view), typ):
		(Some(index), SemanticNamedType(parent_type, _)):
			match env_lookup(env, name):
				Some(symbol):
					match symbol.kind:
						ConstructorSymbolKind(_):
							union_type_index_find_constructor_for_parent(index, parent_type, name)
						_:
							None
				None:
					union_type_index_find_constructor_for_parent(index, parent_type, name)
		_:
			find_bare_constructor(context, env, name)


private pure func symbol_visible_as_bare(
	context: InferContext,
	span: SourceSpan,
	local_name: String,
	symbol: Symbol,
) -> Bool:
	match symbol.kind:
		VarSymbolKind(var_symbol):
			module_symbol_visible_as_bare(
				context,
				span,
				local_name,
				var_symbol.module_path,
				symbol.name,
			)
		FuncSymbolKind(func_symbol):
			module_symbol_visible_as_bare(
				context,
				span,
				local_name,
				func_symbol.module_path,
				symbol.name,
			)
		ConstructorSymbolKind(ctor):
			constructor_visible_as_bare(context, span, local_name, symbol.name, ctor)
		_:
			True


private pure func symbol_is_lexical_or_current_module(
	context: InferContext,
	span: SourceSpan,
	symbol: Symbol,
) -> Bool:
	match symbol.kind:
		VarSymbolKind(var_symbol):
			match var_symbol.module_path:
				Some(module_path):
					module_path_matches_span(module_path, span)
				None:
					True
		FuncSymbolKind(func_symbol):
			match func_symbol.module_path:
				Some(module_path):
					module_path_matches_span(module_path, span)
				None:
					func_symbol.origin != BuiltinFunc
		ConstructorSymbolKind(ctor):
			match infer_facts_find_type_home(context.state.facts, ctor.parent_type):
				Some(module_path):
					(
						not infer_facts_type_home_is_imported(context.state.facts, ctor.parent_type)
						and module_path_matches_span(module_path, span)
					)
				None:
					False
		_:
			False


private pure func accepted_global_binding_var_symbol(
	binding: AcceptedGlobalValueBinding,
) -> VarSymbol:
	{
		var_type = binding.binding_type,
		source_type = binding.entry.source_type,
		mutability = binding.entry.mutability,
		origin = LetBinding,
		refinement = UNREFINED_BINDING,
		module_path = Some(binding.module_path),
		definition_id = Some(accepted_global_definition_id_value(binding.entry.definition_id))
	}


private pure func infer_session_visible_var_symbol(
	session: InferSession,
	name: String,
) -> Option[VarSymbol]:
	match env_lookup(session.env, name):
		Some(symbol):
			match symbol.kind:
				VarSymbolKind(var_symbol):
					Some(var_symbol)
				_:
					None
		None:
			index ?= module_view_accepted_global_value_index(session.facts.module_view)
			binding ?= global_value_index_find_visible(index, name)
			Some(accepted_global_binding_var_symbol(binding))


private pure func accepted_visible_global_symbol(
	context: InferContext,
	name: String,
) -> Option[Symbol]:
	index ?= module_view_accepted_global_value_index(context.state.facts.module_view)
	binding ?= global_value_index_find_visible(index, name)
	Some({
		name = name,
		kind = VarSymbolKind(accepted_global_binding_var_symbol(binding)),
	})


private pure func accepted_module_global_symbol(
	context: InferContext,
	module_path: String,
	name: String,
) -> Option[VarSymbol]:
	index ?= module_view_accepted_global_value_index(context.state.facts.module_view)
	global_value_index_find_module(index, module_path, name).map(accepted_global_binding_var_symbol)


private pure func module_global_symbol(
	context: InferContext,
	module_path: String,
	name: String,
) -> Option[VarSymbol]:
	match module_view_accepted_global_value_index(context.state.facts.module_view):
		Some(_):
			accepted_module_global_symbol(context, module_path, name)
		None:
			env_get_module_var_symbol(context.state.env, module_path, name)


private pure func accepted_visible_callable_bindings(
	context: InferContext,
	name: String,
) -> Option[List[AcceptedCallableBinding]]:
	index ?= module_view_accepted_callable_value_index(context.state.facts.module_view)
	callable_value_index_find_visible(index, name)


private pure func accepted_visible_callable_symbol(
	context: InferContext,
	name: String,
) -> Option[Symbol]:
	bindings ?= accepted_visible_callable_bindings(context, name)
	binding ?= bindings.get(0)
	Some({
		name = name,
		kind = FuncSymbolKind(accepted_callable_binding_func_symbol(binding)),
	})


private pure func accepted_module_callable_bindings(
	context: InferContext,
	module_path: String,
	name: String,
) -> Option[List[AcceptedCallableBinding]]:
	index ?= module_view_accepted_callable_value_index(context.state.facts.module_view)
	callable_value_index_find_module(index, module_path, name)


private pure func module_callable_symbol(
	context: InferContext,
	module_path: String,
	name: String,
) -> Option[FuncSymbol]:
	match module_view_accepted_callable_value_index(context.state.facts.module_view):
		Some(_):
			bindings ?= accepted_module_callable_bindings(context, module_path, name)
			binding ?= bindings.get(0)
			Some(accepted_callable_binding_func_symbol(binding))
		None:
			env_get_module_func_symbol(context.state.env, module_path, name)


private pure func accepted_callable_binding_for_definition_id(
	context: InferContext,
	definition_id: Int,
) -> Option[AcceptedCallableBinding]:
	index ?= module_view_accepted_callable_value_index(context.state.facts.module_view)
	callable_value_index_find_binding_definition_id(index, definition_id)


private pure func implementation_method_info_for_definition_id(
	context: InferContext,
	definition_id: Int,
) -> Option[ImplMethodInfo]:
	match module_view_accepted_implementation_authority_index(context.state.facts.module_view):
		Some(index):
			match implementation_authority_index_find_method_by_callable_definition_id(
				index,
				definition_id,
			):
				AcceptedImplementationMethodFound(entry):
					Some(entry.info)
				AcceptedImplementationMethodAmbiguous | AcceptedImplementationMethodNotFound:
					None
		None:
			env_find_impl_method_by_def_id(context.state.env, definition_id)


-- None means this is a provisional/standalone session with no accepted
-- authority. Once either accepted index is present, incomplete or missing
-- authority fails closed as an empty candidate set instead of consulting Env.
private pure func accepted_implementation_candidates(
	context: InferContext,
	trait_name: String,
	receiver_type: SemanticType,
) -> Option[List[AcceptedImplementationAuthorityEntry]]:
	trait_index = module_view_accepted_trait_authority_index(context.state.facts.module_view)
	implementation_index = module_view_accepted_implementation_authority_index(
		context.state.facts.module_view,
	)

	match (trait_index, implementation_index):
		(None, None):
			None
		(Some(traits), Some(implementations)):
			trait_lookup = match trait_authority_index_find_source(traits, trait_name):
				AcceptedTraitNotFound:
					trait_authority_index_find_canonical_name(traits, trait_name)
				found_or_ambiguous:
					found_or_ambiguous

			match trait_lookup:
				AcceptedTraitFound(trait_entry):
					Some(
						implementation_authority_index_candidates(
							implementations,
							trait_entry.identity,
							accepted_implementation_receiver_head_from_semantic_type(receiver_type),
						),
					)
				AcceptedTraitAmbiguous(_) | AcceptedTraitNotFound:
					Some([])
		_:
			Some([])


private pure func infer_impl_matches_type(
	context: InferContext,
	implementation: ImplInstance,
	receiver_type: SemanticType,
) -> Bool:
	impl_matches_type_with_obligation_resolver(
		implementation,
		receiver_type,
		pure func(obligation): infer_resolve_trait_obligation(context, obligation),
	)


private pure func infer_find_impl_method_info(
	context: InferContext,
	trait_name: String,
	method_name: String,
	receiver_type: SemanticType,
) -> Option[ImplMethodInfo]:
	match accepted_implementation_candidates(context, trait_name, receiver_type):
		Some(candidates):
			var result: Option[ImplMethodInfo] = None

			for candidate in candidates:
				if infer_impl_matches_type(context, candidate.definition, receiver_type):
					for method in candidate.definition.methods:
						if method.name == method_name:
							result = Some(method)
							break

				if result.is_some():
					break

			result
		None:
			env_find_impl_method_info(context.state.env, trait_name, method_name, receiver_type)


private pure func infer_resolve_trait_obligation(
	context: InferContext,
	obligation: TraitObligation,
) -> TraitObligationResolution:
	match accepted_implementation_candidates(
		context,
		obligation.trait_name,
		obligation.obligation_type,
	):
		Some(candidates):
			var has_matching_impl: Bool = False

			for candidate in candidates:
				if infer_impl_matches_type(
					context,
					candidate.definition,
					obligation.obligation_type,
				):
					has_matching_impl = True
					break

			env_resolve_trait_obligation_from_match(
				context.state.env,
				obligation,
				has_matching_impl,
			)
		None:
			env_resolve_trait_obligation(context.state.env, obligation)


private pure func infer_find_unsatisfied_trait_obligation(
	context: InferContext,
	obligations: List[TraitObligation],
) -> Option[TraitObligation]:
	var result: Option[TraitObligation] = None

	for obligation in obligations:
		match infer_resolve_trait_obligation(context, obligation):
			TraitObligationUnsatisfied:
				result = Some(obligation)
				break
			_:
				void

	result


private pure func callable_overloads(
	context: InferContext,
	name: String,
) -> Option[List[OverloadEntry]]:
	match module_view_accepted_callable_value_index(context.state.facts.module_view):
		Some(index):
			match callable_value_index_find_visible_overloads(index, name):
				Some(overloads):
					if overloads.length() > 1:
						Some(overloads)
					else:
						None
				None:
					None
		None:
			overloads = env_get_overloads(context.state.env, name)

			if overloads.is_empty():
				None
			else:
				Some(overloads)


private pure func accepted_ufcs_overloads(
	context: InferContext,
	name: String,
	receiver_type: SemanticType,
) -> Option[List[OverloadEntry]]:
	index ?= module_view_accepted_callable_value_index(context.state.facts.module_view)
	overloads ?= callable_value_index_find_ufcs_overloads(index, name)
	Some(overloads.filter(
		func(entry): overload_first_param_matches(entry, receiver_type),
	))


private pure func accepted_module_ufcs_overloads(
	context: InferContext,
	module_path: String,
	name: String,
	receiver_type: SemanticType,
) -> Option[List[OverloadEntry]]:
	index ?= module_view_accepted_callable_value_index(context.state.facts.module_view)
	overloads ?= callable_value_index_find_module_ufcs_overloads(index, module_path, name)
	Some(overloads.filter(
		func(entry): overload_first_param_matches(entry, receiver_type),
	))


private pure func symbol_from_imported_binding(
	context: InferContext,
	local_name: String,
	binding: ImportedNameBinding,
) -> Option[Symbol]:
	module_path = binding.module_path
	original_name = binding.original_name

	match module_callable_symbol(context, module_path, original_name):
		Some(func_symbol):
			Some({
				name = local_name,
				kind = FuncSymbolKind(func_symbol),
			})
		None:
			match module_global_symbol(context, module_path, original_name):
				Some(var_symbol):
					Some({
						name = local_name,
						kind = VarSymbolKind(var_symbol),
					})
				None:
					match module_view_accepted_union_type_index(context.state.facts.module_view):
						Some(_):
							None
						None:
							match find_module_constructor(
								context,
								context.state.env,
								module_path,
								original_name,
							):
								Some(ctor):
									legacy_symbol: Symbol = {
										name = local_name,
										kind = ConstructorSymbolKind(ctor)
									}
									Some(legacy_symbol)
								None:
									None


private pure func trait_method_callee_from_trait(
	context: InferContext,
	source_name: String,
	method_name: String,
	trait_name: String,
) -> Option[TraitMethodCallee]:
	match module_view_accepted_trait_authority_index(context.state.facts.module_view):
		Some(index):
			match trait_authority_index_find_source(index, trait_name):
				AcceptedTraitFound(entry):
					trait_authority_index_find_method(
						index,
						entry.identity,
						method_name,
					).map(
						func(method): {
							source_name = source_name,
							method_name = method_name,
							trait_name = method.identity.owner.name,
							method = method.signature
						},
					)
				AcceptedTraitAmbiguous(_) | AcceptedTraitNotFound:
					None
		None:
			match env_find_trait_method(context.state.env, trait_name, method_name):
				Some((method, declaring_trait)):
					Some({
						source_name = source_name,
						method_name = method_name,
						trait_name = declaring_trait,
						method = method,
					})
				None:
					None


private pure func accepted_trait_method_callee(
	context: InferContext,
	source_name: String,
	method_name: String,
) -> Option[TraitMethodCallee]:
	index ?= module_view_accepted_trait_authority_index(context.state.facts.module_view)
	method ?= trait_authority_index_method_candidates(index, method_name).get(0)
	Some({
		source_name = source_name,
		method_name = method_name,
		trait_name = method.identity.owner.name,
		method = method.signature,
	})


private pure func trait_method_callee_from_authority_entry(
	source_name: String,
	method: AcceptedTraitMethodAuthorityEntry,
) -> TraitMethodCallee:
	{
		source_name = source_name,
		method_name = method.identity.name,
		trait_name = method.identity.owner.name,
		method = method.signature
	}


private pure func imported_trait_method_callee(
	context: InferContext,
	local_name: String,
	binding: ImportedNameBinding,
) -> Option[TraitMethodCallee]:
	match module_view_accepted_trait_authority_index(context.state.facts.module_view):
		Some(_):
			accepted_trait_method_callee(context, local_name, binding.original_name)
		None:
			match env_get_function_trait(context.state.env, binding.original_name):
				Some(trait_name):
					trait_method_callee_from_trait(
						context,
						local_name,
						binding.original_name,
						trait_name,
					)
				None:
					None


private pure func local_trait_method_callee(
	context: InferContext,
	name: String,
) -> Option[TraitMethodCallee]:
	match module_view_accepted_trait_authority_index(context.state.facts.module_view):
		Some(index):
			var result: Option[TraitMethodCallee] = None

			for method in trait_authority_index_method_candidates(index, name):
				trait_name = method.identity.owner.name

				is_local_trait = match module_view_find_local_name(
					context.state.facts.module_view,
					trait_name,
				):
					Some(kind):
						top_level_name_kind_is_trait(kind)
					None:
						False

				allowed = (
					infer_facts_allows_scoped_trait_function(context.state.facts, name, trait_name)
					or builtin_trait_is_prelude(trait_name)
					or is_local_trait
				)

				if allowed:
					result = Some({
						source_name = name,
						method_name = name,
						trait_name = trait_name,
						method = method.signature,
					})
					break

			result
		None:
			match env_get_function_trait(context.state.env, name):
				Some(trait_name):
					if infer_facts_allows_scoped_trait_function(
						context.state.facts,
						name,
						trait_name,
					):
						trait_method_callee_from_trait(context, name, name, trait_name)
					else if builtin_trait_is_prelude(trait_name):
						trait_method_callee_from_trait(context, name, name, trait_name)
					else:
						match module_view_find_local_name(
							context.state.facts.module_view,
							trait_name,
						):
							Some(kind):
								if top_level_name_kind_is_trait(kind):
									trait_method_callee_from_trait(context, name, name, trait_name)
								else:
									None
							None:
								None
				None:
					None


private pure func lookup_trait_method_callee(
	context: InferContext,
	name: ParsedIdentifier,
) -> Option[TraitMethodCallee]:
	match module_view_find_imported_name(context.state.facts.module_view, name.text):
		Some(binding):
			imported_trait_method_callee(context, name.text, binding)
		None:
			local_trait_method_callee(context, name.text)


private pure func lookup_trait_ufcs_method_callee(
	context: InferContext,
	name: ParsedIdentifier,
) -> Option[TraitMethodCallee]:
	match module_view_accepted_trait_authority_index(context.state.facts.module_view):
		Some(index):
			method ?= trait_authority_index_ufcs_candidates(index, name.text).get(0)
			Some({
				source_name = name.text,
				method_name = name.text,
				trait_name = method.identity.owner.name,
				method = method.signature,
			})
		None:
			lookup_trait_method_callee(context, name)


private pure func imported_receiver_trait_method_callee(
	context: InferContext,
	name: ParsedIdentifier,
	receiver_type: SemanticType,
) -> Option[TraitMethodCallee]:
	type_is_imported = match receiver_type:
		SemanticNamedType(type_name, _):
			infer_facts_type_home_is_imported(context.state.facts, type_name)
		_:
			False

	if not type_is_imported:
		None
	else:
		match module_view_accepted_trait_authority_index(context.state.facts.module_view):
			Some(index):
				var result: Option[TraitMethodCallee] = None

				for method in trait_authority_index_ufcs_candidates(index, name.text):
					match infer_find_impl_method_info(
						context,
						method.identity.owner.name,
						method.identity.name,
						receiver_type,
					):
						Some(_):
							result = Some(
								trait_method_callee_from_authority_entry(
									name.text,
									method,
								),
							)
							break
						None:
							void

				result
			None:
				match env_get_function_trait(context.state.env, name.text):
					Some(trait_name):
						match infer_find_impl_method_info(
							context,
							trait_name,
							name.text,
							receiver_type,
						):
							Some(_):
								trait_method_callee_from_trait(
									context,
									name.text,
									name.text,
									trait_name,
								)
							None:
								None
					None:
						None


private pure func lookup_bare_symbol(
	context: InferContext,
	name: ParsedIdentifier,
) -> Option[Symbol]:
	has_callable_authority = module_view_accepted_callable_value_index(
		context.state.facts.module_view,
	).is_some()

	var local_or_current = match env_lookup(context.state.env, name.text):
		Some(symbol):
			match symbol.kind:
				FuncSymbolKind(func_symbol):
					if has_callable_authority and func_symbol.origin != BuiltinFunc:
						None
					else if symbol_is_lexical_or_current_module(context, name.span, symbol):
						Some(symbol)
					else:
						None
				_:
					if symbol_is_lexical_or_current_module(context, name.span, symbol):
						Some(symbol)
					else:
						None
		None:
			None

	var visible_fallback: Option[Symbol] = None
	var builtin_fallback: Option[Symbol] = None
	imported_binding = module_view_find_imported_name(context.state.facts.module_view, name.text)

	if local_or_current.is_none():
		for symbol in env_symbols_named(context.state.env, name.text):
			match symbol.kind:
				FuncSymbolKind(func_symbol):
					if func_symbol.origin == BuiltinFunc:
						if builtin_fallback.is_none():
							builtin_fallback = Some(symbol)
					else if not has_callable_authority:
						if symbol_is_lexical_or_current_module(context, name.span, symbol):
							local_or_current = Some(symbol)
							break
						else if (
							visible_fallback.is_none()
							and symbol_visible_as_bare(context, name.span, name.text, symbol)
						):
							visible_fallback = Some(symbol)
				_:
					if symbol_is_lexical_or_current_module(context, name.span, symbol):
						local_or_current = Some(symbol)
						break
					else if (
						visible_fallback.is_none()
						and symbol_visible_as_bare(context, name.span, name.text, symbol)
					):
						visible_fallback = Some(symbol)

	explicit_import = match imported_binding:
		Some(binding):
			symbol_from_imported_binding(context, name.text, binding)
		None:
			None

	match local_or_current:
		Some(symbol):
			Some(symbol)
		None:
			match explicit_import:
				Some(symbol):
					Some(symbol)
				None:
					match accepted_visible_callable_symbol(context, name.text):
						Some(symbol):
							Some(symbol)
						None:
							match accepted_visible_global_symbol(context, name.text):
								Some(symbol):
									Some(symbol)
								None:
									constructor_fallback = find_accepted_bare_constructor_symbol(
										context,
										name.text,
									)

									match constructor_fallback:
										Some(symbol):
											Some(symbol)
										None:
											match visible_fallback:
												Some(symbol):
													Some(symbol)
												None:
													builtin_fallback


private pure func source_name_for_imported_module_path(
	context: InferContext,
	local_name: String,
	module_path: Option[String],
) -> String:
	match module_path:
		Some(path):
			match module_view_find_imported_name(context.state.facts.module_view, local_name):
				Some(binding):
					if binding.module_path == path:
						binding.original_name
					else:
						local_name
				None:
					local_name
		None:
			local_name


private pure func infer_trait_method_name_expr(
	context: InferContext,
	name: ParsedIdentifier,
	callee: TraitMethodCallee,
) -> InferResult:
	func_type = SemanticFunctionType(
		callee.method.is_pure,
		callee.method.params,
		callee.method.return_type,
	)
	expr = TypedNameExpr(
		name,
		typed_expr_info_from_slot(
			None,
			InferredOrigin,
			UNREFINED_BINDING,
			Some(resolved_call_from_trait_method_callee(callee, None)),
			infer_expected_slot(context, func_type),
		),
	)
	infer_result(context, expr)


private pure func scoped_trait_method_callee(
	context: InferContext,
	name: ParsedIdentifier,
) -> Option[TraitMethodCallee]:
	if module_view_find_imported_name(context.state.facts.module_view, name.text).is_some():
		None
	else:
		trait_name ?= infer_facts_find_scoped_trait_function(context.state.facts, name.text)
		trait_method_callee_from_trait(context, name.text, name.text, trait_name)


private pure func builtin_symbol_prefers_trait_dispatch(name: String) -> Bool:
	-- These builtins have fallback signatures for direct calls, but their
	-- trait contracts are authoritative when resolving the receiver type.
	[
		"length",
		"checked_div",
		"checked_mod",
		"bit_and",
		"bit_or",
		"bit_xor",
		"bit_not",
		"shift_left",
		"shift_right",
	].contains(name)


private pure func to_string_prefers_trait_dispatch(receiver_type: SemanticType) -> Bool:
	match receiver_type:
		SemanticTypeVar(_):
			True
		_:
			False


private pure func builtin_ufcs_prefers_trait_dispatch(
	name: String,
	receiver_type: SemanticType,
) -> Bool:
	if name == "to_string":
		to_string_prefers_trait_dispatch(receiver_type)
	else:
		builtin_symbol_prefers_trait_dispatch(name)


private pure func infer_name_expr(context: InferContext, name: ParsedIdentifier) -> InferResult:
	match lookup_bare_symbol(context, name):
		Some(symbol):
			match symbol.kind:
				VarSymbolKind(var_symbol):
					var_type = resolve_type_metas(context.state.context, var_symbol.var_type)
					dependencies = var_origin_resource_dependencies(name.text, var_symbol.origin)

					value_slot = match var_type:
						SemanticRangeType(_):
							match infer_context_expected_type(context):
								Some(SemanticRangeType(_)):
									infer_expected_slot(context, var_type)
								_:
									range_proof_slot(var_type)
						_:
							infer_expected_slot(context, var_type)

					expr = TypedNameExpr(
						name,
						{ typed_expr_info_from_slot(
							var_symbol.source_type,
							InferredOrigin,
							UNREFINED_BINDING,
							None,
							value_slot,
						) |
							resolved_definition_id = var_symbol.definition_id,
							resource_dependencies = dependencies
						},
					)
					infer_result(context, expr)
				FuncSymbolKind(func_symbol):
					is_local: Bool = symbol_is_lexical_or_current_module(context, name.span, symbol)

					scoped_trait_callee = if is_local:
						empty: Option[TraitMethodCallee] = None
						empty
					else:
						scoped_trait_method_callee(context, name)

					trait_callee = match scoped_trait_callee:
						Some(callee):
							Some(callee)
						None:
							if (
								func_symbol.origin == BuiltinFunc
								and builtin_symbol_prefers_trait_dispatch(name.text)
							):
								lookup_trait_method_callee(context, name)
							else:
								empty: Option[TraitMethodCallee] = None
								empty

					match trait_callee:
						Some(callee):
							infer_trait_method_name_expr(context, name, callee)
						None:
							next_context = check_debug_only_reference(
								context,
								name.text,
								func_symbol.debug_only,
							)
							source_name = source_name_for_imported_module_path(
								context,
								name.text,
								func_symbol.module_path,
							)
							expr = TypedNameExpr(
								name,
								typed_expr_info_from_slot(
									None,
									InferredOrigin,
									UNREFINED_BINDING,
									Some(
										resolved_call_from_func_symbol_with_source(
											name.text,
											source_name,
											func_symbol,
										),
									),
									infer_expected_slot(next_context, func_symbol.func_type),
								),
							)
							infer_result(next_context, expr)
				ConstructorSymbolKind(ctor):
					infer_constructor_name_expr(context, name, ctor)
				_:
					next = infer_error(context, "`" + name.text + "` is not a value")
					infer_result(
						next,
						TypedNameExpr(
							name,
							inferred_info(next, TYPE_VOID),
						),
					)
		None:
			match lookup_trait_method_callee(context, name):
				Some(callee):
					infer_trait_method_name_expr(context, name, callee)
				None:
					match find_bare_constructor(context, context.state.env, name.text):
						Some(ctor):
							infer_constructor_name_expr(context, name, ctor)
						None:
							next = infer_error(context, "Unbound value `" + name.text + "`")
							infer_result(
								next,
								TypedNameExpr(
									name,
									inferred_info(next, TYPE_VOID),
								),
							)


private pure func apply_ascription(
	context: InferContext,
	inner: TypedExpr,
	source_type: SemanticType,
	semantic_type: SemanticType,
	span: SourceSpan,
) -> InferResult:
	value_type = typed_expr_value_type(inner)

	next = if types_equal(value_type, semantic_type):
		context
	else:
		infer_error(
			context,
			"Ascribed type `" + type_to_string(
				source_type,
			) + "` does not match value type `" + type_to_string(value_type) + "`",
		)

	infer_result(
		next,
		TypedAscriptionExpr(
			inner,
			source_type,
			span,
			typed_expr_info_from_slot(
				Some(source_type),
				ExplicitAnnotationOrigin(source_type),
				UNREFINED_BINDING,
				None,
				KeptValueSlot(semantic_type),
			),
		),
	)


private pure func opaque_conversion_name(conversion: OpaqueConversion) -> String:
	match conversion:
		OpaqueIntoConversion:
			"into_opaque"
		OpaqueFromConversion:
			"from_opaque"


private pure func opaque_conversion_same_module(
	home_module: Option[String],
	span: SourceSpan,
) -> Bool:
	match home_module:
		Some(module_path):
			module_path_matches_span(module_path, span)
		None:
			True


private pure func type_param_subst_for_args(
	type_params: List[String],
	args: List[SemanticType],
) -> List[SemanticTypeSubstEntry]:
	var subst: List[SemanticTypeSubstEntry] = []
	var index: Int = 0

	while index < type_params.length() and index < args.length():
		match (type_params.get(index), args.get(index)):
			(Some(type_param), Some(arg)):
				subst = subst.append(type_subst_entry(type_param, arg))
			_:
				void

		index += 1

	subst


private pure func opaque_conversion_type_result(
	context: InferContext,
	source_type: SemanticType,
	opaque_type: SemanticType,
	target_type: SemanticType,
	ok: Bool,
) -> OpaqueConversionTypeResult:
	{
		context = context,
		source_type = source_type,
		opaque_type = opaque_type,
		target_type = target_type,
		ok = ok
	}


private pure func resolve_opaque_conversion_type(
	context: InferContext,
	type_expr: ParsedTypeExpr,
	span: SourceSpan,
) -> OpaqueConversionTypeResult:
	source_type = type_from_parsed_type_expr(type_expr)
	opaque_type = infer_canonical_expected_type(context, source_type)

	match opaque_type:
		SemanticNamedType(name, args):
			match infer_find_opaque_alias(context, name):
				Some((type_params, target, home_module)):
					if type_params.length() != args.length():
						next = infer_error(
							context,
							"Opaque type '" + name + "' expects " + type_params
								.length()
								.to_string() + " type argument(s), got " + args
								.length()
								.to_string(),
						)
						opaque_conversion_type_result(
							next,
							source_type,
							opaque_type,
							TYPE_VOID,
							False,
						)
					else if not opaque_conversion_same_module(home_module, span):
						next = infer_error(
							context,
							"Opaque type '" + name + "' can only use into_opaque/from_opaque conversions in its defining module",
						)
						opaque_conversion_type_result(
							next,
							source_type,
							opaque_type,
							TYPE_VOID,
							False,
						)
					else:
						subst = type_param_subst_for_args(type_params, args)
						target_type = apply_subst(subst, target)
						opaque_conversion_type_result(
							context,
							source_type,
							opaque_type,
							target_type,
							True,
						)
				None:
					next = infer_error(
						context,
						"Type '" + type_to_string(opaque_type) + "' is not an opaque type",
					)
					opaque_conversion_type_result(next, source_type, opaque_type, TYPE_VOID, False)
		_:
			next = infer_error(
				context,
				"Expected an opaque named type, got " + type_to_string(opaque_type),
			)
			opaque_conversion_type_result(next, source_type, opaque_type, TYPE_VOID, False)


private pure func typed_opaque_conversion_expr(
	conversion: OpaqueConversion,
	source_type: SemanticType,
	inner: TypedExpr,
	result_type: SemanticType,
	span: SourceSpan,
	info: TypedExprInfo,
) -> TypedExpr:
	match conversion:
		OpaqueIntoConversion:
			TypedOpaqueIntoExpr(source_type, inner, span, info)
		OpaqueFromConversion:
			TypedOpaqueFromExpr(source_type, inner, span, info)


private pure func infer_opaque_conversion_expr(
	context: InferContext,
	conversion: OpaqueConversion,
	type_expr: ParsedTypeExpr,
	inner: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	type_result = resolve_opaque_conversion_type(context, type_expr, span)

	expected_inner_type = match conversion:
		OpaqueIntoConversion:
			type_result.target_type
		OpaqueFromConversion:
			type_result.opaque_type

	inner_context = if type_result.ok:
		infer_with_canonical_expected_value_slot(
			type_result.context,
			expected_inner_type,
			ExpectedArgumentSlot,
		)
	else:
		type_result.context

	inner_result = infer_expr(inner_context, inner)
	inner_value_type = typed_expr_value_type(inner_result.expr)

	checked_context = if type_result.ok and not types_equal(inner_value_type, expected_inner_type):
		infer_error(
			inner_result.context,
			opaque_conversion_name(
				conversion,
			) + " expected " + type_to_string(
				expected_inner_type,
			) + ", got " + type_to_string(inner_value_type),
		)
	else:
		inner_result.context

	result_type = match conversion:
		OpaqueIntoConversion:
			type_result.opaque_type
		OpaqueFromConversion:
			type_result.target_type

	info = inferred_info(checked_context, result_type)
	typed = typed_opaque_conversion_expr(
		conversion,
		type_result.source_type,
		inner_result.expr,
		result_type,
		span,
		info,
	)

	infer_result(checked_context, typed)


private pure func infer_ascription_expr(
	context: InferContext,
	inner: ParsedExpr,
	type_expr: ParsedTypeExpr,
	span: SourceSpan,
) -> InferResult:
	source_type = type_from_parsed_type_expr(type_expr)
	semantic_type = infer_canonical_expected_type(context, source_type)
	inner_result = infer_expr(
		infer_with_canonical_expected_value_slot(context, semantic_type, ExpectedArgumentSlot),
		inner,
	)
	apply_ascription(inner_result.context, inner_result.expr, source_type, semantic_type, span)


private pure func infer_unary_expr(
	context: InferContext,
	op: ParsedUnaryOp,
	operand: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	operand_context = match (op, operand):
		(ParsedNegateOp, ParsedFloatLiteralExpr(_, _)):
			context
		(ParsedNegateOp, ParsedIntLiteralExpr(_, _)):
			context
		_:
			infer_without_expected(context)

	operand_result = infer_expr(operand_context, operand)
	operand_type = typed_expr_value_type(operand_result.expr)
	operand_slot = unary_operand_slot(op, operand_type)
	operand_value_type = widening_value_type(operand_slot)
	checked = check_unary_op(operand_result.context, op, operand_value_type)
	typed_operand = typed_expr_with_slot(operand_result.expr, operand_slot)
	typed = TypedUnaryExpr(
		op,
		typed_operand,
		span,
		inferred_info(checked.context, checked.typ),
	)

	infer_result(checked.context, typed)


private pure func infer_binary_expr(
	context: InferContext,
	op: ParsedBinaryOp,
	left: ParsedExpr,
	right: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	left_result = infer_expr(infer_without_expected(context), left)
	right_result = infer_expr(infer_without_expected(left_result.context), right)
	left_semantic_type = typed_expr_semantic_type(left_result.expr)
	right_semantic_type = typed_expr_semantic_type(right_result.expr)
	left_slot = numeric_operand_slot(op, left_semantic_type)
	right_slot = numeric_operand_slot(op, right_semantic_type)
	left_value_type = widening_value_type(left_slot)
	right_value_type = widening_value_type(right_slot)
	checked = check_binary_op(right_result.context, op, left_value_type, right_value_type)
	result_type = mod_result_type(op, left_semantic_type, right_semantic_type, checked.typ)
	typed_left = typed_expr_with_slot(left_result.expr, left_slot)
	typed_right = typed_expr_with_slot(right_result.expr, right_slot)
	typed = TypedBinaryExpr(
		op,
		typed_left,
		typed_right,
		span,
		inferred_info(checked.context, result_type),
	)

	infer_result(checked.context, typed)


private pure func infer_logical_expr(
	context: InferContext,
	op: ParsedLogicalOp,
	left: ParsedExpr,
	right: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	left_result = infer_expr(infer_without_expected(context), left)
	right_result = infer_expr(infer_without_expected(left_result.context), right)
	left_type = typed_expr_semantic_type(left_result.expr)
	right_type = typed_expr_semantic_type(right_result.expr)
	checked = check_logical_op(right_result.context, left_type, right_type)
	typed = TypedLogicalExpr(
		op,
		left_result.expr,
		right_result.expr,
		span,
		inferred_info(checked.context, checked.typ),
	)

	infer_result(checked.context, typed)


private pure func call_name(callee: TypedExpr) -> Option[String]:
	match callee:
		TypedNameExpr(name, _):
			Some(name.text)
		_:
			None


private pure func call_arity_error(
	context: InferContext,
	callee: TypedExpr,
	expected: Int,
	got: Int,
) -> InferContext:
	name_text = match call_name(callee):
		Some(name):
			" '" + name + "'"
		None:
			""

	arg_word = if expected == 1:
		" argument"
	else:
		" arguments"

	infer_error(
		context,
		"Function" + name_text + " expects " + expected.to_string() + arg_word + ", got " + got.to_string(),
	)


private pure func argument_mismatch_error(
	context: InferContext,
	callee: TypedExpr,
	index: Int,
	expected: SemanticType,
	got: SemanticType,
	span: SourceSpan,
) -> InferContext:
	callee_text = match call_name(callee):
		Some(name):
			"in call to '${name}', "
		None:
			""

	expected_text = type_to_string(expected)
	got_text = type_to_string(got)
	location = source_span_label(span)

	infer_error(
		context,
		"Argument type mismatch: ${callee_text}argument ${(index + 1).to_string()} expected ${expected_text}, got ${got_text} at ${location}",
	)


private pure func type_contains_type_var(typ: SemanticType) -> Bool:
	match typ:
		SemanticTypeVar(_):
			True
		SemanticNamedType(name, args):
			if args.length() == 0:
				is_legacy_single_letter_type_param(name)
			else:
				args.any(type_contains_type_var)
		SemanticArrayType(element, dims):
			type_contains_type_var(element) or dims.any(type_contains_type_var)
		SemanticFunctionType(_, params, return_type):
			params.any(type_contains_type_var) or type_contains_type_var(return_type)
		SemanticTupleType(elements):
			elements.any(type_contains_type_var)
		SemanticRangeType(inner):
			type_contains_type_var(inner)
		SemanticDimOpType(_, left, right):
			type_contains_type_var(left) or type_contains_type_var(right)
		_:
			False


private pure func type_contains_self(typ: SemanticType) -> Bool:
	match typ:
		SemanticSelfType:
			True
		SemanticNamedType(_, args):
			args.any(type_contains_self)
		SemanticArrayType(element, dims):
			type_contains_self(element) or dims.any(type_contains_self)
		SemanticFunctionType(_, params, return_type):
			params.any(type_contains_self) or type_contains_self(return_type)
		SemanticTupleType(elements):
			elements.any(type_contains_self)
		SemanticRangeType(inner):
			type_contains_self(inner)
		SemanticDimOpType(_, left, right):
			type_contains_self(left) or type_contains_self(right)
		_:
			False


private pure func fresh_callee_type_param_name(
	outer_names: List[String],
	used_names: List[String],
	name: String,
) -> String:
	if not outer_names.contains(name) and not used_names.contains(name):
		name
	else:
		is_dim = is_dim_var_name(name)

		base_name = if is_dim:
			name.substring(1, name.length())
		else:
			name

		prefix = if is_dim:
			"#__callee_"
		else:
			"__callee_"

		var index: Int = 0
		var candidate: String = prefix + base_name

		while outer_names.contains(candidate) or used_names.contains(candidate):
			index += 1
			candidate = prefix + index.to_string() + "_" + base_name

		candidate


private pure func call_signature(
	context: InferContext,
	bound_params: List[BoundTypeParam],
	params: List[SemanticType],
	return_type: SemanticType,
) -> CallSignature:
	outer_names = env_get_type_params(context.state.env)
	var used_names: List[String] = []
	var scoped_params: List[BoundTypeParam] = []
	var renames: List[SemanticTypeSubstEntry] = []

	for param in bound_params:
		scoped_name = fresh_callee_type_param_name(outer_names, used_names, param.name)
		scoped_params = scoped_params.append({ param | name = scoped_name })
		used_names = used_names.append(scoped_name)

		if scoped_name != param.name:
			renames = renames.append(type_subst_entry(param.name, SemanticTypeVar(scoped_name)))

	final_renames = renames
	{
		bound_params = scoped_params,
		params = params.map(func(param): apply_subst(final_renames, param)),
		return_type = apply_subst(final_renames, return_type)
	}


private pure func type_contains_named_type_param(
	type_param_names: List[String],
	typ: SemanticType,
) -> Bool:
	match typ:
		SemanticTypeVar(name):
			type_param_names.contains(name)
		SemanticNamedType(name, args):
			(
				args.length() == 0 and type_param_names.contains(name)
				or args.any(func(arg): type_contains_named_type_param(type_param_names, arg))
			)
		SemanticArrayType(element, dims):
			(
				type_contains_named_type_param(type_param_names, element)
				or dims.any(func(dim): type_contains_named_type_param(type_param_names, dim))
			)
		SemanticFunctionType(_, params, return_type):
			(
				params.any(func(param): type_contains_named_type_param(type_param_names, param))
				or type_contains_named_type_param(type_param_names, return_type)
			)
		SemanticTupleType(elements):
			elements.any(func(element): type_contains_named_type_param(type_param_names, element))
		SemanticRangeType(inner):
			type_contains_named_type_param(type_param_names, inner)
		SemanticDimOpType(_, left, right):
			(
				type_contains_named_type_param(type_param_names, left)
				or type_contains_named_type_param(type_param_names, right)
			)
		_:
			False


private pure func type_contains_call_type_param(
	type_param_names: List[String],
	typ: SemanticType,
) -> Bool:
	if type_param_names.length() == 0:
		type_contains_type_var(typ)
	else:
		type_contains_named_type_param(type_param_names, typ)


private pure func find_type_subst(
	subst: List[SemanticTypeSubstEntry],
	name: String,
) -> Option[SemanticType]:
	var result: Option[SemanticType] = None
	var index: Int = 0

	while index < subst.length() and result.is_none():
		match subst.get(index):
			Some(entry):
				if entry.var_name == name:
					result = Some(entry.concrete_type)
			None:
				void

		index += 1

	result


private pure func find_var_dims_subst(
	subst: List[VarDimsSubstEntry],
	name: String,
) -> Option[List[SemanticType]]:
	var result: Option[List[SemanticType]] = None

	for entry in subst:
		if entry.var_name == name:
			result = Some(entry.concrete_dims)
			break

	result


private pure func var_dims_lists_equal(left: List[SemanticType], right: List[SemanticType]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal: Bool = True
		var index: Int = 0

		while index < left.length():
			match (left.get(index), right.get(index)):
				(Some(left_type), Some(right_type)):
					if not types_equal(left_type, right_type):
						equal = False
						break
				_:
					equal = False
					break

			index += 1

		equal


private pure func var_dims_to_string(dims: List[SemanticType]) -> String:
	dims
		.map(type_to_string)
		.join(", ")


private pure func bind_var_dims_subst_result(
	context: InferContext,
	subst: List[VarDimsSubstEntry],
) -> BindVarDimsSubstResult:
	{
		context = context,
		subst = subst
	}


private pure func bind_var_dims_entry(
	context: InferContext,
	subst: List[VarDimsSubstEntry],
	name: String,
	concrete_dims: List[SemanticType],
) -> BindVarDimsSubstResult:
	match find_var_dims_subst(subst, name):
		Some(existing):
			if var_dims_lists_equal(existing, concrete_dims):
				bind_var_dims_subst_result(context, subst)
			else:
				bind_var_dims_subst_result(
					infer_error(
						context,
						"Variadic dimension " + name + "... has conflicting shapes: [" + var_dims_to_string(
							existing,
						) + "] vs [" + var_dims_to_string(
							concrete_dims,
						) + "]. Use different names for independent dimensions",
					),
					subst,
				)
		None:
			bind_var_dims_subst_result(
				context,
				subst.append({
					var_name = name,
					concrete_dims = concrete_dims,
				}),
			)


private pure func types_from_index(
	types: List[SemanticType],
	start_index: Int,
) -> List[SemanticType]:
	var result: List[SemanticType] = []
	var index: Int = start_index

	while index < types.length():
		match types.get(index):
			Some(typ):
				result = result.append(typ)
			None:
				void

		index += 1

	result


private pure func bind_var_dims_type_lists(
	context: InferContext,
	subst: List[VarDimsSubstEntry],
	param_types: List[SemanticType],
	actual_types: List[SemanticType],
) -> BindVarDimsSubstResult:
	var next_context = context
	var next_subst = subst
	var index: Int = 0
	var consumed_remainder: Bool = False

	while index < param_types.length() and not consumed_remainder:
		match param_types.get(index):
			Some(SemanticVarDimsType(name)):
				result = bind_var_dims_entry(
					next_context,
					next_subst,
					name,
					types_from_index(actual_types, index),
				)
				next_context = result.context
				next_subst = result.subst
				consumed_remainder = True
			Some(param_type):
				match actual_types.get(index):
					Some(actual_type):
						result = bind_var_dims_type(
							next_context,
							next_subst,
							param_type,
							actual_type,
						)
						next_context = result.context
						next_subst = result.subst
					None:
						void
			None:
				void

		index += 1

	bind_var_dims_subst_result(next_context, next_subst)


private pure func bind_var_dims_type(
	context: InferContext,
	subst: List[VarDimsSubstEntry],
	param_type: SemanticType,
	actual_type: SemanticType,
) -> BindVarDimsSubstResult:
	match param_type:
		SemanticArrayType(param_element, param_dims):
			match array_type_parts(actual_type):
				Some((actual_element, actual_dims)):
					element_result = bind_var_dims_type(
						context,
						subst,
						param_element,
						actual_element,
					)
					bind_var_dims_type_lists(
						element_result.context,
						element_result.subst,
						param_dims,
						actual_dims,
					)
				None:
					bind_var_dims_subst_result(context, subst)
		SemanticNamedType(param_name, param_args):
			match actual_type:
				SemanticNamedType(actual_name, actual_args):
					if param_name == actual_name:
						bind_var_dims_type_lists(context, subst, param_args, actual_args)
					else:
						bind_var_dims_subst_result(context, subst)
				_:
					bind_var_dims_subst_result(context, subst)
		SemanticTupleType(param_elements):
			match actual_type:
				SemanticTupleType(actual_elements):
					bind_var_dims_type_lists(context, subst, param_elements, actual_elements)
				_:
					bind_var_dims_subst_result(context, subst)
		SemanticFunctionType(_, param_params, param_return):
			match actual_type:
				SemanticFunctionType(_, actual_params, actual_return):
					params_result = bind_var_dims_type_lists(
						context,
						subst,
						param_params,
						actual_params,
					)
					bind_var_dims_type(
						params_result.context,
						params_result.subst,
						param_return,
						actual_return,
					)
				_:
					bind_var_dims_subst_result(context, subst)
		SemanticRangeType(param_inner):
			match actual_type:
				SemanticRangeType(actual_inner):
					bind_var_dims_type(context, subst, param_inner, actual_inner)
				_:
					bind_var_dims_subst_result(context, subst)
		_:
			bind_var_dims_subst_result(context, subst)


private pure func bind_call_var_dims(
	context: InferContext,
	param_types: List[SemanticType],
	args: List[TypedExpr],
) -> BindVarDimsSubstResult:
	var next_context = context
	var subst: List[VarDimsSubstEntry] = []
	var index: Int = 0

	while index < param_types.length() and index < args.length():
		match (param_types.get(index), args.get(index)):
			(Some(param_type), Some(arg)):
				result = bind_var_dims_type(
					next_context,
					subst,
					infer_resolve_alias(next_context, param_type),
					infer_resolve_alias(next_context, typed_expr_value_type(arg)),
				)
				next_context = result.context
				subst = result.subst
			_:
				void

		index += 1

	bind_var_dims_subst_result(next_context, subst)


private pure func resolve_var_dims_type_list(
	subst: List[VarDimsSubstEntry],
	types: List[SemanticType],
) -> List[SemanticType]:
	var result: List[SemanticType] = []

	for typ in types:
		match typ:
			SemanticVarDimsType(name):
				match find_var_dims_subst(subst, name):
					Some(concrete_dims):
						result = result.concat(concrete_dims)
					None:
						result = result.append(typ)
			_:
				result = result.append(resolve_var_dims_type(subst, typ))

	result


private pure func resolve_var_dims_type(
	subst: List[VarDimsSubstEntry],
	typ: SemanticType,
) -> SemanticType:
	match typ:
		SemanticNamedType(name, args):
			SemanticNamedType(
				name,
				resolve_var_dims_type_list(subst, args),
			)
		SemanticArrayType(element, dims):
			SemanticArrayType(
				resolve_var_dims_type(subst, element),
				resolve_var_dims_type_list(subst, dims),
			)
		SemanticFunctionType(is_pure, params, return_type):
			SemanticFunctionType(
				is_pure,
				params.map(func(param): resolve_var_dims_type(subst, param)),
				resolve_var_dims_type(subst, return_type),
			)
		SemanticTupleType(elements):
			SemanticTupleType(elements.map(
				func(element): resolve_var_dims_type(subst, element),
			))
		SemanticRangeType(inner):
			SemanticRangeType(resolve_var_dims_type(subst, inner))
		SemanticDimOpType(op, left, right):
			normalize_dim(
				SemanticDimOpType(
					op,
					resolve_var_dims_type(subst, left),
					resolve_var_dims_type(subst, right),
				),
			)
		_:
			typ


private pure func bind_type_subst_result(
	context: InferContext,
	subst: List[SemanticTypeSubstEntry],
) -> BindTypeSubstResult:
	{
		context = context,
		subst = subst
	}


private pure func generic_conflict_error(
	context: InferContext,
	name: String,
	existing: SemanticType,
	found: SemanticType,
) -> InferContext:
	infer_error(
		context,
		"Generic type parameter " + name + " inferred as " + type_to_string(
			existing,
		) + " and " + type_to_string(found),
	)


private pure func bind_type_var_subst(
	context: InferContext,
	name: String,
	actual_type: SemanticType,
	subst: List[SemanticTypeSubstEntry],
) -> BindTypeSubstResult:
	bound_type: SemanticType = if is_dim_var_name(name):
		actual_type
	else:
		default_collection_element_type(actual_type)

	is_identity = match bound_type:
		SemanticTypeVar(actual_name):
			actual_name == name
		SemanticNamedType(actual_name, args):
			args.length() == 0 and actual_name == name
		_:
			False

	if is_identity:
		bind_type_subst_result(context, subst)
	else:
		match find_type_subst(subst, name):
			Some(existing):
				if types_equal(existing, bound_type):
					bind_type_subst_result(context, subst)
				else if type_contains_meta(existing) or type_contains_meta(bound_type):
					match unify_symmetric(context.state.context, existing, bound_type):
						Some(step):
							next_state = { context.state | context = step.context }
							bind_type_subst_result(
								infer_context_with_state(context, next_state),
								subst,
							)
						None:
							bind_type_subst_result(
								generic_conflict_error(context, name, existing, bound_type),
								subst,
							)
				else:
					bind_type_subst_result(
						generic_conflict_error(context, name, existing, bound_type),
						subst,
					)
			None:
				bind_type_subst_result(
					context,
					subst.append(type_subst_entry(name, bound_type)),
				)


private pure func complete_call_type_subst(
	context: InferContext,
	bound_params: List[BoundTypeParam],
	subst: List[SemanticTypeSubstEntry],
) -> BindTypeSubstResult:
	var next_context: InferContext = context
	var next_subst: List[SemanticTypeSubstEntry] = subst

	for param in bound_params:
		if param.bounds.length() == 0 and find_type_subst(next_subst, param.name).is_none():
			step = fresh_meta_with_origin(next_context.state.context, param.name)
			next_state = { next_context.state | context = step.context }
			next_context = infer_context_with_state(next_context, next_state)
			next_subst = next_subst.append(type_subst_entry(param.name, step.meta_type))

	bind_type_subst_result(next_context, next_subst)


private pure func bind_type_list_subst_with_type_params(
	context: InferContext,
	type_param_names: List[String],
	param_types: List[SemanticType],
	actual_types: List[SemanticType],
	subst: List[SemanticTypeSubstEntry],
) -> BindTypeSubstResult:
	var next_context: InferContext = context
	var next_subst: List[SemanticTypeSubstEntry] = subst
	var index: Int = 0

	while index < param_types.length() and index < actual_types.length():
		match (param_types.get(index), actual_types.get(index)):
			(Some(param_type), Some(actual_type)):
				result = bind_type_subst_with_type_params(
					next_context,
					type_param_names,
					param_type,
					actual_type,
					next_subst,
				)
				next_context = result.context
				next_subst = result.subst
			_:
				void

		index += 1

	bind_type_subst_result(next_context, next_subst)


private pure func bind_type_subst_with_type_params(
	context: InferContext,
	type_param_names: List[String],
	param_type: SemanticType,
	actual_type: SemanticType,
	subst: List[SemanticTypeSubstEntry],
) -> BindTypeSubstResult:
	match param_type:
		SemanticTypeVar(name):
			if type_param_names.length() == 0 or type_param_names.contains(name):
				bind_type_var_subst(context, name, actual_type, subst)
			else:
				bind_type_subst_result(context, subst)
		SemanticNamedType(param_name, param_args):
			if param_args.length() == 0 and type_param_names.contains(param_name):
				bind_type_var_subst(context, param_name, actual_type, subst)
			else:
				match actual_type:
					SemanticNamedType(actual_name, actual_args):
						if (
							param_name == actual_name
							and param_args.length() == actual_args.length()
						):
							bind_type_list_subst_with_type_params(
								context,
								type_param_names,
								param_args,
								actual_args,
								subst,
							)
						else:
							bind_type_subst_result(context, subst)
					_:
						bind_type_subst_result(context, subst)
		SemanticArrayType(param_element, param_dims):
			match array_type_parts(actual_type):
				Some((actual_element, actual_dims)):
					element_result = bind_type_subst_with_type_params(
						context,
						type_param_names,
						param_element,
						actual_element,
						subst,
					)
					bind_type_list_subst_with_type_params(
						element_result.context,
						type_param_names,
						param_dims,
						actual_dims,
						element_result.subst,
					)
				None:
					bind_type_subst_result(context, subst)
		SemanticTupleType(param_elements):
			match actual_type:
				SemanticTupleType(actual_elements):
					if param_elements.length() == actual_elements.length():
						bind_type_list_subst_with_type_params(
							context,
							type_param_names,
							param_elements,
							actual_elements,
							subst,
						)
					else:
						bind_type_subst_result(context, subst)
				_:
					bind_type_subst_result(context, subst)
		SemanticFunctionType(_, param_params, param_return):
			match actual_type:
				SemanticFunctionType(_, actual_params, actual_return):
					param_result = bind_type_list_subst_with_type_params(
						context,
						type_param_names,
						param_params,
						actual_params,
						subst,
					)
					bind_type_subst_with_type_params(
						param_result.context,
						type_param_names,
						param_return,
						actual_return,
						param_result.subst,
					)
				_:
					bind_type_subst_result(context, subst)
		SemanticRangeType(param_inner):
			match actual_type:
				SemanticRangeType(actual_inner):
					bind_type_subst_with_type_params(
						context,
						type_param_names,
						param_inner,
						actual_inner,
						subst,
					)
				_:
					bind_type_subst_result(context, subst)
		_:
			bind_type_subst_result(context, subst)


private pure func generic_param_type_can_guide_argument(
	type_param_names: List[String],
	param_type: SemanticType,
	arg: ParsedExpr,
) -> Bool:
	if not type_contains_call_type_param(type_param_names, param_type):
		True
	else:
		match (param_type, arg):
			(SemanticFunctionType(_, callback_params, _), ParsedLambdaExpr(_, lambda_params, _, _, _)):
				(
					not callback_params.any(
						func(param): type_contains_call_type_param(type_param_names, param),
					)
					or lambda_params.all(func(param): param.type_expr.is_some())
				)
			_:
				False


private pure func generic_argument_bind_type(
	param_type: SemanticType,
	arg: TypedExpr,
	value_type: SemanticType,
) -> SemanticType:
	match param_type:
		SemanticRangeType(_):
			match typed_expr_semantic_type(arg):
				SemanticRangeType(bound):
					SemanticRangeType(bound)
				_:
					static_dim_from_typed_expr(arg).get_or(value_type)
		_:
			if is_dim_type(param_type):
				static_dim_from_typed_expr(arg).get_or(value_type)
			else:
				value_type


private pure func trait_method_supports_elementwise_tensor_call(
	trait_name: String,
	method_name: String,
) -> Bool:
	match trait_name:
		"FloatingPoint":
			["sqrt", "exp", "log"].contains(method_name)
		"Absolute":
			method_name == "abs"
		_:
			False


private pure func resolved_call_supports_elementwise_tensor_call(
	resolved_call: Option[ResolvedCallInfo],
) -> Bool:
	match resolved_call:
		Some(call):
			match call.target:
				ResolvedDirectCall(_, CallableBuiltin):
					builtin_is_elementwise_tensor_function(call.source_name)
				ResolvedDirectCall(_, CallableImported(module_path)):
					(
						module_path == "std/float"
						and builtin_is_elementwise_tensor_function(call.source_name)
					)
				ResolvedTraitMethodCall(trait_name, _):
					trait_method_supports_elementwise_tensor_call(trait_name, call.callee_name)
				_:
					False
		None:
			False


private pure func elementwise_tensor_element_type(
	resolved_call: Option[ResolvedCallInfo],
	typ: SemanticType,
) -> Option[SemanticType]:
	if resolved_call_supports_elementwise_tensor_call(resolved_call):
		match array_type_parts(typ):
			Some((element_type, _)):
				Some(element_type)
			None:
				None
	else:
		None


private pure func call_argument_assignable_context(
	context: InferContext,
	callee: TypedExpr,
	expected: SemanticType,
	found: SemanticType,
) -> Option[InferContext]:
	match assignable_context(context, expected, found):
		Some(assignable_context):
			Some(assignable_context)
		None:
			match elementwise_tensor_element_type(direct_callable_resolution(callee), found):
				Some(element_type):
					assignable_context(context, expected, element_type)
				None:
					None


private pure func infer_call_args_with_subst(
	context: InferContext,
	callee: TypedExpr,
	args: List[ParsedExpr],
	params: List[SemanticType],
	type_param_names: List[String],
	initial_subst: List[SemanticTypeSubstEntry],
) -> InferCallArgsResult:
	var next_context: InferContext = context
	var typed_args: List[TypedExpr] = []
	var subst: List[SemanticTypeSubstEntry] = initial_subst
	var index: Int = 0

	while index < args.length():
		match (args.get(index), params.get(index)):
			(Some(arg), Some(raw_param_type)):
				param_type = apply_subst(subst, raw_param_type)
				is_generic_param = type_contains_call_type_param(type_param_names, raw_param_type)
				can_use_expected_type = generic_param_type_can_guide_argument(
					type_param_names,
					param_type,
					arg,
				)

				arg_context = if can_use_expected_type:
					infer_with_canonical_expected_value_slot(
						next_context,
						param_type,
						ExpectedArgumentSlot,
					)
				else:
					infer_without_expected(next_context)

				arg_result = infer_expr(arg_context, arg)
				arg_value_type = typed_expr_value_type(arg_result.expr)
				arg_bind_type = generic_argument_bind_type(
					raw_param_type,
					arg_result.expr,
					arg_value_type,
				)

				bind_result = if is_generic_param:
					bind_type_subst_with_type_params(
						arg_result.context,
						type_param_names,
						raw_param_type,
						arg_bind_type,
						subst,
					)
				else:
					bind_type_subst_result(arg_result.context, subst)

				subst = bind_result.subst
				instantiated_param_type = apply_subst(subst, raw_param_type)

				next_context = if bind_result.context.state.errors.length() > arg_result.context.state.errors.length():
					bind_result.context
				else:
					match call_argument_assignable_context(
						bind_result.context,
						callee,
						instantiated_param_type,
						arg_bind_type,
					):
						Some(assignable_context):
							assignable_context
						None:
							argument_mismatch_error(
								bind_result.context,
								callee,
								index,
								instantiated_param_type,
								arg_bind_type,
								parsed_expr_span(arg),
							)

				typed_args = typed_args.append(arg_result.expr)
			_:
				void

		index += 1

	{
		context = infer_without_expected(next_context),
		args = typed_args,
		subst = subst
	}


private pure func inferred_call_info(
	context: InferContext,
	semantic_type: SemanticType,
	resolved_call: Option[ResolvedCallInfo],
) -> TypedExprInfo:
	typed_expr_info_from_slot(
		None,
		InferredOrigin,
		UNREFINED_BINDING,
		resolved_call,
		infer_expected_slot(context, semantic_type),
	)


private pure func typed_module_marker_expr(module_ident: ParsedIdentifier) -> TypedExpr:
	TypedNameExpr(
		module_ident,
		typed_expr_info_from_slot(
			None,
			InferredOrigin,
			UNREFINED_BINDING,
			None,
			KeptValueSlot(SemanticNamedType("Module", [])),
		),
	)


private pure func typed_qualified_module_field_expr(
	module_ident: ParsedIdentifier,
	field: ParsedIdentifier,
	span: SourceSpan,
	field_type: SemanticType,
	resolved_call: Option[ResolvedCallInfo],
) -> TypedExpr:
	TypedFieldAccessExpr(
		typed_module_marker_expr(module_ident),
		field,
		span,
		typed_expr_info_from_slot(
			None,
			InferredOrigin,
			UNREFINED_BINDING,
			resolved_call,
			KeptValueSlot(field_type),
		),
	)


private pure func typed_qualified_module_var_expr(
	module_ident: ParsedIdentifier,
	field: ParsedIdentifier,
	span: SourceSpan,
	var_symbol: VarSymbol,
) -> TypedExpr:
	TypedFieldAccessExpr(
		typed_module_marker_expr(module_ident),
		field,
		span,
		{ typed_expr_info_from_slot(
			var_symbol.source_type,
			InferredOrigin,
			UNREFINED_BINDING,
			None,
			KeptValueSlot(var_symbol.var_type),
		) |
			resolved_definition_id = var_symbol.definition_id
		},
	)


private pure func find_module_constructor(
	context: InferContext,
	env: Env,
	module_path: String,
	name: String,
) -> Option[ConstructorSymbol]:
	match module_view_accepted_union_type_index(context.state.facts.module_view):
		Some(index):
			union_type_index_find_module_constructor(index, module_path, name)
		None:
			var result: Option[ConstructorSymbol] = None

			for ctor in env_get_constructors(env, name):
				if infer_facts_type_home_matches(
					context.state.facts,
					ctor.parent_type,
					module_path,
				):
					result = Some(ctor)
					break

			result


private pure func typed_qualified_module_constructor_expr(
	context: InferContext,
	module_ident: ParsedIdentifier,
	field: ParsedIdentifier,
	span: SourceSpan,
	ctor: ConstructorSymbol,
) -> InferResult:
	constructor_step = constructor_expr_type(
		context,
		ctor.parent_type,
		ctor.type_params,
		ctor.field_types,
	)
	constructor_type = constructor_step.typ

	infer_result(
		constructor_step.context,
		typed_qualified_module_field_expr(
			module_ident,
			field,
			span,
			constructor_type,
			Some(
				resolved_call_from_constructor(
					field.text,
					ctor.constructor_id,
					ctor.parent_type,
					constructor_type,
				),
			),
		),
	)


private pure func infer_qualified_module_callee(
	context: InferContext,
	callee: ParsedExpr,
) -> Option[InferResult]:
	match callee:
		ParsedFieldAccessExpr(receiver, field, span):
			match receiver:
				ParsedNameExpr(module_ident):
					match module_view_find_module_alias(
						context.state.facts.module_view,
						module_ident.text,
					):
						Some(module_path):
							match module_callable_symbol(context, module_path, field.text):
								Some(func_symbol):
									typed = typed_qualified_module_field_expr(
										module_ident,
										field,
										span,
										func_symbol.func_type,
										Some(
											resolved_call_from_func_symbol_with_source(
												field.text,
												field.text,
												func_symbol,
											),
										),
									)
									Some(infer_result(context, typed))
								None:
									match find_module_constructor(
										context,
										context.state.env,
										module_path,
										field.text,
									):
										Some(ctor):
											Some(
												typed_qualified_module_constructor_expr(
													context,
													module_ident,
													field,
													span,
													ctor,
												),
											)
										None:
											None
						None:
							None
				_:
					None
		_:
			None


private pure func infer_qualified_module_field_expr(
	context: InferContext,
	receiver: ParsedExpr,
	field: ParsedIdentifier,
	span: SourceSpan,
) -> Option[InferResult]:
	match receiver:
		ParsedNameExpr(module_ident):
			match module_view_find_module_alias(context.state.facts.module_view, module_ident.text):
				Some(module_path):
					match module_callable_symbol(context, module_path, field.text):
						Some(func_symbol):
							next_context = check_debug_only_reference(
								context,
								field.text,
								func_symbol.debug_only,
							)
							typed = typed_qualified_module_field_expr(
								module_ident,
								field,
								span,
								func_symbol.func_type,
								Some(
									resolved_call_from_func_symbol_with_source(
										field.text,
										field.text,
										func_symbol,
									),
								),
							)
							Some(infer_result(next_context, typed))
						None:
							match module_global_symbol(context, module_path, field.text):
								Some(var_symbol):
									typed = typed_qualified_module_var_expr(
										module_ident,
										field,
										span,
										var_symbol,
									)
									Some(infer_result(context, typed))
								None:
									match find_module_constructor(
										context,
										context.state.env,
										module_path,
										field.text,
									):
										Some(ctor):
											Some(
												typed_qualified_module_constructor_expr(
													context,
													module_ident,
													field,
													span,
													ctor,
												),
											)
										None:
											next = infer_error(
												context,
												"Module alias `" + module_ident.text + "` for module `" + module_path + "` has no value or function `" + field.text + "`",
											)
											typed = typed_qualified_module_field_expr(
												module_ident,
												field,
												span,
												TYPE_VOID,
												None,
											)
											Some(infer_result(next, typed))
				None:
					None
		_:
			None


private pure func missing_qualified_module_call_result(
	context: InferContext,
	callee: ParsedExpr,
	span: SourceSpan,
) -> Option[InferResult]:
	match callee:
		ParsedFieldAccessExpr(receiver, field, field_span):
			match receiver:
				ParsedNameExpr(module_ident):
					match module_view_find_module_alias(
						context.state.facts.module_view,
						module_ident.text,
					):
						Some(module_path):
							if (
								module_callable_symbol(context, module_path, field.text).is_some()
								or find_module_constructor(
									context,
									context.state.env,
									module_path,
									field.text,
								).is_some()
							):
								None
							else:
								next = infer_error(
									context,
									"Module alias `" + module_ident.text + "` for module `" + module_path + "` has no function `" + field.text + "`",
								)
								typed_callee = typed_qualified_module_field_expr(
									module_ident,
									field,
									field_span,
									TYPE_VOID,
									None,
								)
								typed = TypedCallExpr(
									typed_callee,
									[],
									span,
									inferred_call_info(next, TYPE_VOID, None),
								)
								Some(infer_result(next, typed))
						None:
							None
				_:
					None
		_:
			None


private pure func bare_overload_first_arg_type(
	context: InferContext,
	args: List[ParsedExpr],
) -> Option[SemanticType]:
	match args.get(0):
		Some(first_arg):
			first_arg_result = infer_expr(infer_without_expected(context), first_arg)

			if first_arg_result.context.state.errors.length() == context.state.errors.length():
				Some(typed_expr_value_type(first_arg_result.expr))
			else:
				None
		None:
			None


private pure func bare_overload_arg_types(
	context: InferContext,
	args: List[ParsedExpr],
) -> Option[List[SemanticType]]:
	var arg_types: List[SemanticType] = []
	var ok: Bool = True

	for arg in args:
		if ok:
			arg_result = infer_expr(infer_without_expected(context), arg)

			if arg_result.context.state.errors.length() == context.state.errors.length():
				arg_types = arg_types.append(overload_argument_type(arg, arg_result.expr))
			else:
				ok = False

	if ok:
		Some(arg_types)
	else:
		None


private pure func overload_argument_type(parsed: ParsedExpr, typed: TypedExpr) -> SemanticType:
	value_type = typed_expr_value_type(typed)

	lambda_body_is_pure = match typed:
		TypedLambdaExpr(False, _, _, body, _, _):
			typed_expr_purity_requirements(body).is_empty()
		_:
			False

	match (parsed, value_type):
		(ParsedLambdaExpr(False, _, _, _, _), SemanticFunctionType(False, params, return_type)):
			if lambda_body_is_pure:
				SemanticFunctionType(True, params, return_type)
			else:
				value_type
		_:
			value_type


private pure func bare_overload_callee_result(
	context: InferContext,
	name: ParsedIdentifier,
	entry: OverloadEntry,
) -> InferResult:
	source_name = source_name_for_imported_module_path(context, name.text, entry.module_path)
	typed = TypedNameExpr(
		name,
		typed_expr_info_from_slot(
			None,
			InferredOrigin,
			UNREFINED_BINDING,
			Some(resolved_call_from_overload_entry(name.text, source_name, entry)),
			KeptValueSlot(entry.func_type),
		),
	)
	infer_result(context, typed)


private pure func infer_bare_overload_callee(
	context: InferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
) -> Option[InferResult]:
	match callee:
		ParsedNameExpr(name):
			lookup = lookup_bare_symbol(context, name)

			lookup_allows_authority = match lookup:
				Some(symbol):
					match symbol.kind:
						FuncSymbolKind(func_symbol):
							accepted_callable_binding_for_definition_id(
								context,
								func_symbol.callable_id,
							).is_some()
						_:
							False
				None:
					True
				_:
					False

			if not lookup_allows_authority:
				None
			else:
				match callable_overloads(context, name.text):
					None:
						None
					Some(overloads):
						match bare_overload_arg_types(context, args):
							Some(arg_types):
								match env_select_overload_for_args(overloads, arg_types):
									Some(entry):
										Some(bare_overload_callee_result(context, name, entry))
									None:
										match arg_types.get(0):
											Some(first_arg_type):
												match select_overload_for_first_arg(
													overloads,
													first_arg_type,
												):
													Some(entry):
														Some(
															bare_overload_callee_result(
																context,
																name,
																entry,
															),
														)
													None:
														None
											None:
												None
							None:
								None
		_:
			None


private pure func missing_bare_overload_call_result(
	context: InferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: SourceSpan,
) -> Option[InferResult]:
	match callee:
		ParsedNameExpr(name):
			lookup = lookup_bare_symbol(context, name)

			lookup_allows_authority = match lookup:
				Some(symbol):
					match symbol.kind:
						FuncSymbolKind(func_symbol):
							accepted_callable_binding_for_definition_id(
								context,
								func_symbol.callable_id,
							).is_some()
						_:
							False
				None:
					True
				_:
					False

			if not lookup_allows_authority:
				None
			else:
				match callable_overloads(context, name.text):
					None:
						None
					Some(overloads):
						match bare_overload_first_arg_type(context, args):
							Some(first_arg_type):
								if select_overload_for_first_arg(
									overloads,
									first_arg_type,
								).is_some():
									None
								else:
									next = infer_error(
										context,
										"No overload `" + name.text + "` matches first argument type " + type_to_string(
											first_arg_type,
										),
									)
									typed_callee = TypedNameExpr(
										name,
										inferred_info(next, TYPE_VOID),
									)
									typed = TypedCallExpr(
										typed_callee,
										[],
										span,
										inferred_call_info(next, TYPE_VOID, None),
									)
									Some(infer_result(next, typed))
							None:
								None
		_:
			None


private pure func bare_callee_is_constructor(context: InferContext, name: ParsedIdentifier) -> Bool:
	match lookup_bare_symbol(context, name):
		Some(symbol):
			match symbol.kind:
				ConstructorSymbolKind(_):
					True
				_:
					False
		None:
			False


private pure func qualified_callee_is_constructor(
	context: InferContext,
	receiver: ParsedExpr,
	field: ParsedIdentifier,
) -> Bool:
	match receiver:
		ParsedNameExpr(module_ident):
			match module_view_find_module_alias(context.state.facts.module_view, module_ident.text):
				Some(module_path):
					find_module_constructor(
						context,
						context.state.env,
						module_path,
						field.text,
					).is_some()
				None:
					False
		_:
			False


private pure func call_callee_context(context: InferContext, callee: ParsedExpr) -> InferContext:
	is_constructor = match callee:
		ParsedNameExpr(name):
			bare_callee_is_constructor(context, name)
		ParsedFieldAccessExpr(receiver, field, _):
			qualified_callee_is_constructor(context, receiver, field)
		_:
			False

	if is_constructor:
		context
	else:
		infer_without_expected(context)


private pure func types_after_first(types: List[SemanticType]) -> List[SemanticType]:
	var result: List[SemanticType] = []
	var index: Int = 1

	while index < types.length():
		match types.get(index):
			Some(typ):
				result = result.append(typ)
			None:
				void

		index += 1

	result


private pure func resolved_entry_bound_type_params(
	context: InferContext,
	resolved_call: ResolvedCallInfo,
) -> Option[List[BoundTypeParam]]:
	match resolved_call_callable_id(resolved_call):
		Some(callable_id):
			match module_view_accepted_callable_value_index(context.state.facts.module_view):
				Some(_):
					match accepted_callable_binding_for_definition_id(context, callable_id):
						Some(binding):
							Some(binding.signature.type_params)
						None:
							implementation_method_info_for_definition_id(
								context,
								callable_id,
							).map(
								func(method): method.type_params,
							)
				None:
					env_find_callable_type_params_by_def_id(context.state.env, callable_id)
		None:
			None


private pure func declared_callee_bound_type_params(
	context: InferContext,
	callee: TypedExpr,
) -> List[BoundTypeParam]:
	match callee:
		TypedNameExpr(name, _):
			match module_view_accepted_callable_value_index(context.state.facts.module_view):
				Some(_):
					match accepted_visible_callable_bindings(context, name.text):
						Some(bindings):
							bindings
								.get(0)
								.map(func(binding): binding.signature.type_params)
								.get_or([])
						None:
							[]
				None:
					match env_get_func_info(context.state.env, name.text):
						Some((_, type_params, _)):
							type_params
						None:
							[]
		TypedFieldAccessExpr(receiver, field, _, _):
			match receiver:
				TypedNameExpr(module_ident, _):
					match module_view_find_module_alias(
						context.state.facts.module_view,
						module_ident.text,
					):
						Some(module_path):
							match module_callable_symbol(context, module_path, field.text):
								Some(func_symbol):
									func_symbol.type_params
								None:
									[]
						None:
							[]
				_:
					[]
		_:
			[]


private pure func callee_bound_type_params(
	context: InferContext,
	callee: TypedExpr,
) -> List[BoundTypeParam]:
	match direct_callable_resolution(callee):
		Some(resolved_call):
			match resolved_entry_bound_type_params(context, resolved_call):
				Some(type_params):
					type_params
				None:
					declared_callee_bound_type_params(context, callee)
		None:
			declared_callee_bound_type_params(context, callee)


private pure func call_trait_bound_error(
	context: InferContext,
	callee_name: String,
	concrete_type: SemanticType,
	trait_name: String,
) -> InferContext:
	match concrete_type:
		SemanticTypeVar(name):
			infer_error(
				context,
				"Type parameter " + name + " does not have bound " + trait_name + " (required by " + callee_name + ")",
			)
		_:
			infer_error(
				context,
				"Type " + type_to_string(
					concrete_type,
				) + " does not implement trait " + trait_name + " (required by " + callee_name + ")",
			)


private pure func check_call_trait_bounds_for_params(
	context: InferContext,
	callee: TypedExpr,
	bound_params: List[BoundTypeParam],
	subst: List[SemanticTypeSubstEntry],
) -> InferContext:
	callee_name = match direct_callable_resolution(callee):
		Some(info):
			info.callee_name
		None:
			"<function>"

	var next: InferContext = context

	for param in bound_params:
		match find_type_subst(subst, param.name):
			Some(concrete_type):
				obligations = trait_obligations_for_bound_type_param(param, concrete_type)

				match infer_find_unsatisfied_trait_obligation(next, obligations):
					Some(obligation):
						next = call_trait_bound_error(
							next,
							callee_name,
							concrete_type,
							obligation.trait_name,
						)
					None:
						void
			None:
				void

	next


private pure func trait_self_type_from_call(
	context: InferContext,
	args: List[ParsedExpr],
) -> Option[SemanticType]:
	match args.get(0):
		Some(first_arg):
			first_arg_result = infer_expr(infer_without_expected(context), first_arg)

			if first_arg_result.context.state.errors.length() == context.state.errors.length():
				Some(
					widening_value_type(
						method_receiver_slot(typed_expr_semantic_type(first_arg_result.expr)),
					),
				)
			else:
				None
		None:
			match infer_context_expected_type(context):
				Some(expected_type):
					Some(expected_type)
				None:
					None


private pure func check_trait_method_self_bound(
	context: InferContext,
	resolved_call: Option[ResolvedCallInfo],
	self_type: SemanticType,
) -> InferContext:
	match resolved_call:
		Some(call):
			match call.target:
				ResolvedTraitMethodCall(trait_name, _):
					obligation_type = elementwise_tensor_element_type(
						resolved_call,
						self_type,
					).get_or(self_type)

					match infer_find_unsatisfied_trait_obligation(
						context,
						[trait_obligation(obligation_type, trait_name)],
					):
						Some(obligation):
							call_trait_bound_error(
								context,
								call.callee_name,
								self_type,
								obligation.trait_name,
							)
						None:
							context
				_:
					context
		None:
			context


private pure func resolve_trait_self_call(
	context: InferContext,
	callee: TypedExpr,
	args: List[ParsedExpr],
	is_pure: Bool,
	params: List[SemanticType],
	return_type: SemanticType,
	resolved_call: Option[ResolvedCallInfo],
) -> TraitSelfCallResolution:
	is_trait_method = match resolved_call:
		Some(call):
			match call.target:
				ResolvedTraitMethodCall(_, _):
					True
				_:
					False
		None:
			False

	if is_trait_method and (params.any(type_contains_self) or type_contains_self(return_type)):
		match trait_self_type_from_call(context, args):
			Some(self_type):
				resolved_params = params.map(func(param): resolve_self(self_type, param))
				resolved_return = resolve_self(self_type, return_type)
				resolved_func_type = SemanticFunctionType(is_pure, resolved_params, resolved_return)
				info = typed_expr_info(callee)

				updated_resolved_call = match resolved_call:
					Some(call):
						Some({ call |
								instantiated_params = resolved_params,
								instantiated_return = resolved_return
							})
					None:
						empty: Option[ResolvedCallInfo] = None
						empty

				resource_args = match updated_resolved_call:
					Some(call):
						match call.target:
							ResolvedTraitMethodCall(trait_name, _):
								trait_method_resource_args_for_type(
									context,
									trait_name,
									call.callee_name,
									self_type,
									call.resource_args,
								)
							_:
								call.resource_args
					None:
						RejectResourceArgs

				final_resolved_call = match updated_resolved_call:
					Some(call):
						Some({ call | resource_args = resource_args })
					None:
						empty: Option[ResolvedCallInfo] = None
						empty

				updated_info = { info |
					value_slot = KeptValueSlot(resolved_func_type),
					resolved_call = final_resolved_call
				}
				checked_context = check_trait_method_self_bound(context, resolved_call, self_type)
				{
					context = checked_context,
					callee = typed_expr_with_info(callee, updated_info),
					params = resolved_params,
					return_type = resolved_return,
					resolved_call = final_resolved_call
				}
			None:
				{
					context = context,
					callee = callee,
					params = params,
					return_type = return_type,
					resolved_call = resolved_call
				}
	else:
		{
			context = context,
			callee = callee,
			params = params,
			return_type = return_type,
			resolved_call = resolved_call
		}


private pure func dim_constraint_error(
	context: InferContext,
	callee_name: String,
	lhs: SemanticType,
	rhs: SemanticType,
	resolved_lhs: SemanticType,
	resolved_rhs: SemanticType,
) -> InferContext:
	infer_error(
		context,
		"Dimension constraint violated in call to '" + callee_name + "'\n   = constraint: " + type_to_string(
			lhs,
		) + " == " + type_to_string(
			rhs,
		) + "\n   = but: " + type_to_string(resolved_lhs) + " != " + type_to_string(resolved_rhs),
	)


private pure func dim_constraint_solved(result: DimSolveResult) -> Bool:
	match result:
		DimSolved:
			True
		DimBindMeta(_, _):
			False
		DimBindVar(_, _):
			False
		DimContradiction:
			False
		DimStuck:
			False


private pure func check_call_dim_constraints(
	context: InferContext,
	resolved_call: Option[ResolvedCallInfo],
	subst: List[SemanticTypeSubstEntry],
) -> InferContext:
	match resolved_call:
		Some(call):
			var next: InferContext = context

			for constraint in call.dim_constraints:
				lhs = constraint[0]
				rhs = constraint[1]
				resolved_lhs = apply_subst(subst, lhs)
				resolved_rhs = apply_subst(subst, rhs)

				if not dim_constraint_solved(dim_solve([], resolved_lhs, resolved_rhs)):
					next = dim_constraint_error(
						next,
						call.callee_name,
						lhs,
						rhs,
						resolved_lhs,
						resolved_rhs,
					)

			next
		None:
			context


private pure func call_allows_resource_args(resolved_call: Option[ResolvedCallInfo]) -> Bool:
	match resolved_call:
		Some(call):
			match call.resource_args:
				AllowResourceArgs(_):
					True
				RejectResourceArgs:
					False
		None:
			False


private pure func resolved_call_display_name(resolved_call: Option[ResolvedCallInfo]) -> String:
	match resolved_call:
		Some(call):
			call.callee_name
		None:
			"<function>"


private pure func resolved_call_is_debug_only(
	context: InferContext,
	resolved_call: Option[ResolvedCallInfo],
) -> Bool:
	match resolved_call:
		Some(call):
			match resolved_call_callable_id(call):
				Some(callable_id):
					match module_view_accepted_callable_value_index(
						context.state.facts.module_view,
					):
						Some(_):
							match accepted_callable_binding_for_definition_id(context, callable_id):
								Some(binding):
									binding.entry.debug_only
								None:
									implementation_method_info_for_definition_id(
										context,
										callable_id,
									)
										.map(func(method): method.debug_only)
										.get_or(False)
						None:
							env_find_callable_debug_only_by_def_id(
								context.state.env,
								callable_id,
							).get_or(False)
				None:
					False
		None:
			False


private pure func check_debug_only_reference(
	context: InferContext,
	name: String,
	debug_only: Bool,
) -> InferContext:
	if (
		debug_only
		and not context.suppress_debug_only_reference
		and not context.in_debug
		and not context.state.facts.allow_debug_only_calls
	):
		infer_error(
			context,
			"debug-only function '" + name + "' can only be used inside a debug: block",
		)
	else:
		context


private pure func check_debug_only_call(
	context: InferContext,
	resolved_call: Option[ResolvedCallInfo],
) -> InferContext:
	if resolved_call_is_debug_only(context, resolved_call):
		check_debug_only_reference(context, resolved_call_display_name(resolved_call), True)
	else:
		context


private pure func is_direct_scoped_resource_arg(context: InferContext, arg: TypedExpr) -> Bool:
	match arg:
		TypedNameExpr(name, _):
			env_is_scoped_resource_var(context.state.env, name.text)
		_:
			False


private pure func check_resource_operation_arg(
	context: InferContext,
	resolved_call: Option[ResolvedCallInfo],
	arg: TypedExpr,
) -> InferContext:
	unavailable_context = match arg:
		TypedNameExpr(name, _):
			match env_scoped_resource_unavailable_owner(context.state.env, name.text):
				Some(owner):
					infer_error(
						context,
						"scoped resource `" + name.text + "` is unavailable while " + owner + " is in scope",
					)
				None:
					context
		_:
			context

	if unavailable_context.state.errors.length() > context.state.errors.length():
		unavailable_context
	else:
		arg_type = typed_expr_value_type(arg)

		if (
			type_contains_resource(unavailable_context, arg_type)
			and not is_direct_scoped_resource_arg(unavailable_context, arg)
		):
			infer_error(
				unavailable_context,
				(
					"resource argument to compiler-owned resource operation must be a scoped with "
					+ "binding `"
				) + resolved_call_display_name(resolved_call) + "`",
			)
		else:
			unavailable_context


private pure func check_ordinary_call_arg(
	context: InferContext,
	resolved_call: Option[ResolvedCallInfo],
	arg: TypedExpr,
) -> InferContext:
	arg_type = typed_expr_value_type(arg)
	callee_name = resolved_call_display_name(resolved_call)

	if type_contains_resource(context, arg_type):
		infer_error(
			context,
			"scoped resource value cannot be passed to ordinary call `" + callee_name + "`",
		)
	else:
		refs = typed_expr_resource_dependency_refs(context, arg)

		if refs.length() > 0:
			infer_error(
				context,
				"scoped resource-derived value cannot be passed to ordinary call `" + callee_name + "`",
			)
		else:
			context


private pure func check_call_resource_args(
	context: InferContext,
	resolved_call: Option[ResolvedCallInfo],
	args: List[TypedExpr],
) -> InferContext:
	var next_context = context
	allow_resource_args = call_allows_resource_args(resolved_call)

	for arg in args:
		next_context = if allow_resource_args:
			check_resource_operation_arg(next_context, resolved_call, arg)
		else:
			check_ordinary_call_arg(next_context, resolved_call, arg)

	next_context


private pure func bind_expected_return_subst(
	context: InferContext,
	type_param_names: List[String],
	return_type: SemanticType,
	subst: List[SemanticTypeSubstEntry],
) -> BindTypeSubstResult:
	match infer_context_expected_type(context):
		Some(expected_type):
			resolved_return_type = infer_resolve_alias(context, return_type)
			resolved_expected_type = expected_type

			expected_is_int = match resolved_expected_type:
				SemanticNamedType("Int", []):
					True
				_:
					False

			dimension_widens_to_int = is_dim_type(resolved_return_type) and expected_is_int

			if (
				type_contains_call_type_param(type_param_names, resolved_return_type)
				and not dimension_widens_to_int
			):
				bind_type_subst_with_type_params(
					context,
					type_param_names,
					resolved_return_type,
					resolved_expected_type,
					subst,
				)
			else:
				bind_type_subst_result(context, subst)
		None:
			bind_type_subst_result(context, subst)


private pure func refined_length_return_type(
	arg_type: SemanticType,
	fallback: SemanticType,
) -> SemanticType:
	match array_type_parts(arg_type):
		Some((_, dims)):
			match dims.get(0):
				Some(SemanticConstIntType(size)):
					SemanticConstIntType(size)
				Some(SemanticTypeVar(name)):
					if is_dim_var_name(name):
						SemanticTypeVar(name)
					else:
						fallback
				Some(SemanticDimOpType(op, left, right)):
					normalize_dim(SemanticDimOpType(op, left, right))
				_:
					fallback
		None:
			fallback


private pure func static_dim_from_type(typ: SemanticType) -> Option[SemanticType]:
	match typ:
		SemanticConstIntType(_):
			Some(typ)
		SemanticTypeVar(name):
			if is_dim_var_name(name):
				Some(typ)
			else:
				None
		SemanticNamedType(name, args):
			if args.length() == 0 and is_dim_var_name(name):
				Some(SemanticTypeVar(name))
			else:
				None
		SemanticDimOpType(_, _, _):
			Some(normalize_dim(typ))
		_:
			None


private pure func binary_dim_op(op: ParsedBinaryOp) -> Option[SemanticDimOp]:
	match op:
		ParsedAddOp:
			Some(SemanticDimAdd)
		ParsedSubtractOp:
			Some(SemanticDimSubtract)
		ParsedMultiplyOp:
			Some(SemanticDimMultiply)
		ParsedDivideOp:
			Some(SemanticDimDivide)
		_:
			None


private pure func static_dim_from_typed_expr(expr: TypedExpr) -> Option[SemanticType]:
	semantic_dim = static_dim_from_type(typed_expr_semantic_type(expr))

	match expr:
		TypedIntLiteralExpr(text, _, _):
			text
				.parse_int()
				.map(func(value): SemanticConstIntType(value))
		TypedBinaryExpr(op, left, right, _, _):
			match (
				binary_dim_op(op),
				static_dim_from_typed_expr(left),
				static_dim_from_typed_expr(right),
			):
				(Some(dim_op), Some(left_dim), Some(right_dim)):
					Some(normalize_dim(SemanticDimOpType(dim_op, left_dim, right_dim)))
				_:
					semantic_dim
		TypedCallExpr(_, args, _, info):
			call_name = resolved_call_display_name(info.resolved_call)

			if (call_name == "length" or call_name == "vector_length") and args.length() == 1:
				match args.get(0):
					Some(arg):
						match array_type_parts(typed_expr_semantic_type(arg)):
							Some((_, dims)):
								match dims.get(0):
									Some(dim):
										match static_dim_from_type(dim):
											Some(result):
												Some(result)
											None:
												semantic_dim
									None:
										semantic_dim
							None:
								semantic_dim
					None:
						semantic_dim
			else:
				semantic_dim
		_:
			semantic_dim


private pure func static_constructor_dims(
	args: List[TypedExpr],
	rank: Int,
) -> Option[List[SemanticType]]:
	var dims: List[SemanticType] = []
	var index: Int = 0
	var complete: Bool = True

	while index < rank and complete:
		match args.get(index + 1):
			Some(arg):
				match static_dim_from_typed_expr(arg):
					Some(dim):
						dims = dims.append(dim)
					None:
						complete = False
			None:
				complete = False

		index += 1

	if complete and dims.length() == rank:
		Some(dims)
	else:
		None


private pure func refined_tensor_constructor_return_type(
	args: List[TypedExpr],
	rank: Int,
	fallback: SemanticType,
) -> SemanticType:
	match (args.get(0), static_constructor_dims(args, rank)):
		(Some(value), Some(dims)):
			element_type = match array_type_parts(fallback):
				Some((element, _)):
					element
				None:
					typed_expr_semantic_type(value)

			SemanticArrayType(element_type, dims)
		_:
			fallback


private pure func refined_builtin_return_type(
	resolved_call: Option[ResolvedCallInfo],
	args: List[TypedExpr],
	fallback: SemanticType,
) -> SemanticType:
	name = resolved_call_display_name(resolved_call)
	special_inference = builtin_special_inference(name)

	elementwise_return = if args.length() == 1:
		match args.get(0):
			Some(arg):
				arg_type = typed_expr_semantic_type(arg)

				match elementwise_tensor_element_type(resolved_call, arg_type):
					Some(_):
						Some(arg_type)
					None:
						None
			None:
				None
	else:
		None

	match elementwise_return:
		Some(return_type):
			return_type
		None:
			match special_inference:
				Some(VectorCtorInference):
					refined_tensor_constructor_return_type(args, 1, fallback)
				Some(MatrixCtorInference):
					refined_tensor_constructor_return_type(args, 2, fallback)
				Some(TensorCtorInference(rank)):
					refined_tensor_constructor_return_type(args, rank, fallback)
				_:
					if (name == "length" or name == "vector_length") and args.length() == 1:
						match args.get(0):
							Some(arg):
								refined_length_return_type(typed_expr_semantic_type(arg), fallback)
							None:
								fallback
					else:
						fallback


private pure func debug_reflection_name(resolved_call: Option[ResolvedCallInfo]) -> Option[String]:
	match resolved_call:
		Some(call):
			match call.target:
				ResolvedDirectCall(_, CallableImported("std/debug")):
					if call.source_name == "type_name" or call.source_name == "is_heap":
						Some(call.source_name)
					else:
						None
				_:
					None
		None:
			None


private pure func deferred_debug_reflection_result(
	context: InferContext,
	callee: TypedExpr,
	args: List[TypedExpr],
	span: SourceSpan,
	return_type: SemanticType,
	call: ResolvedCallInfo,
) -> InferResult:
	intrinsic_call = { call | target = ResolvedIntrinsicCall }
	callee_info = typed_expr_info(callee)
	intrinsic_callee = typed_expr_with_info(
		callee,
		{ callee_info | resolved_call = Some(intrinsic_call) },
	)
	infer_result(
		context,
		TypedCallExpr(
			intrinsic_callee,
			args,
			span,
			inferred_call_info(context, return_type, Some(intrinsic_call)),
		),
	)


private pure func debug_reflection_result(
	context: InferContext,
	callee: TypedExpr,
	args: List[TypedExpr],
	span: SourceSpan,
	return_type: SemanticType,
	resolved_call: Option[ResolvedCallInfo],
) -> Option[InferResult]:
	reflection_name ?= debug_reflection_name(resolved_call)
	call ?= resolved_call

	match args:
		[arg]:
			arg_type = typed_expr_semantic_type(arg)

			if reflection_name == "type_name" and not type_contains_type_var(arg_type):
				Some(
					infer_result(
						context,
						TypedStringLiteralExpr(
							type_to_string(arg_type),
							span,
							inferred_info(context, TYPE_STRING),
						),
					),
				)
			else:
				Some(
					deferred_debug_reflection_result(
						context,
						callee,
						args,
						span,
						return_type,
						call,
					),
				)
		_:
			None


private pure func infer_call_with_callee_result(
	context: InferContext,
	callee_result: InferResult,
	args: List[ParsedExpr],
	span: SourceSpan,
) -> InferResult:
	callee_type = infer_resolve_alias(
		callee_result.context,
		typed_expr_value_type(callee_result.expr),
	)
	-- Resolved-call metadata on a call expression describes the call that
	-- produced its value. It does not identify a subsequently invoked function
	-- value. Only direct callable references may carry their resolution into
	-- this call; all other callable values are closure calls.
	resolved_call: Option[ResolvedCallInfo] = direct_callable_resolution(callee_result.expr)

	match callee_type:
		SemanticFunctionType(is_pure, raw_params, raw_return_type):
			-- Calls consume the canonical callable type. Keep the source type and
			-- origin on the callee, but make the typed IR self-contained so later
			-- invariant checks do not need the alias environment.
			callable_callee = typed_expr_with_slot(callee_result.expr, KeptValueSlot(callee_type))

			initial_resolved_call = match resolved_call:
				Some(_):
					resolved_call
				None:
					Some(resolved_call_from_closure(is_pure, raw_params, raw_return_type))

			self_resolution = resolve_trait_self_call(
				infer_context_with_state(context, callee_result.context.state),
				callable_callee,
				args,
				is_pure,
				raw_params,
				raw_return_type,
				initial_resolved_call,
			)
			params = self_resolution.params
			return_type = self_resolution.return_type
			self_resolved_call = self_resolution.resolved_call
			callee_expr = self_resolution.callee
			signature = call_signature(
				self_resolution.context,
				callee_bound_type_params(context, callee_expr),
				params,
				return_type,
			)
			call_params = signature.params
			call_return_type = signature.return_type
			type_param_names: List[String] = signature.bound_params.map(func(param): param.name)

			if call_params.length() != args.length():
				next = call_arity_error(
					infer_without_expected(self_resolution.context),
					callee_expr,
					call_params.length(),
					args.length(),
				)
				typed = TypedCallExpr(
					callee_expr,
					[],
					span,
					inferred_call_info(next, TYPE_VOID, self_resolved_call),
				)
				infer_result(next, typed)
			else:
				initial_return_bind = bind_expected_return_subst(
					self_resolution.context,
					type_param_names,
					call_return_type,
					[],
				)
				arg_result = infer_call_args_with_subst(
					initial_return_bind.context,
					callee_expr,
					args,
					call_params,
					type_param_names,
					initial_return_bind.subst,
				)
				result_context = infer_context_with_state(context, arg_result.context.state)
				return_bind = bind_expected_return_subst(
					result_context,
					type_param_names,
					call_return_type,
					arg_result.subst,
				)
				complete_subst = complete_call_type_subst(
					return_bind.context,
					signature.bound_params,
					return_bind.subst,
				)
				checked_context = check_call_trait_bounds_for_params(
					complete_subst.context,
					callee_expr,
					signature.bound_params,
					complete_subst.subst,
				)
				dim_checked_context = check_call_dim_constraints(
					checked_context,
					self_resolved_call,
					complete_subst.subst,
				)
				debug_checked_context = check_debug_only_call(
					dim_checked_context,
					self_resolved_call,
				)
				resource_checked_context = check_call_resource_args(
					debug_checked_context,
					self_resolved_call,
					arg_result.args,
				)
				substituted_param_types = call_params.map(
					func(param): apply_subst(complete_subst.subst, param),
				)
				var_dims_bind = bind_call_var_dims(
					resource_checked_context,
					substituted_param_types,
					arg_result.args,
				)
				resolved_param_types = substituted_param_types.map(
					func(param): resolve_var_dims_type(var_dims_bind.subst, param),
				)
				resolved_return_base = resolve_var_dims_type(
					var_dims_bind.subst,
					apply_subst(complete_subst.subst, call_return_type),
				)
				resolved_return_type = refined_builtin_return_type(
					self_resolved_call,
					arg_result.args,
					resolved_return_base,
				)

				instantiated_resolved_call = match self_resolved_call:
					Some(call):
						Some({ call |
								instantiated_params = resolved_param_types,
								instantiated_return = resolved_return_type
							})
					None:
						empty: Option[ResolvedCallInfo] = None
						empty

				match debug_reflection_result(
					var_dims_bind.context,
					callee_expr,
					arg_result.args,
					span,
					resolved_return_type,
					instantiated_resolved_call,
				):
					Some(result):
						result
					None:
						typed = TypedCallExpr(
							callee_expr,
							arg_result.args,
							span,
							inferred_call_info(
								var_dims_bind.context,
								resolved_return_type,
								instantiated_resolved_call,
							),
						)
						infer_result(var_dims_bind.context, typed)
		_:
			next = infer_error(
				infer_without_expected(callee_result.context),
				"Cannot call non-function type: " + type_to_string(callee_type),
			)
			typed = TypedCallExpr(
				callee_result.expr,
				[],
				span,
				inferred_call_info(next, TYPE_VOID, resolved_call),
			)
			infer_result(next, typed)


private pure func parsed_args_after_first(args: List[ParsedExpr]) -> List[ParsedExpr]:
	var result: List[ParsedExpr] = []
	var index: Int = 1

	while index < args.length():
		match args.get(index):
			Some(arg):
				result = result.append(arg)
			None:
				void

		index += 1

	result


private pure func trait_method_ufcs_resource_args(
	context: InferContext,
	method_callee: TraitMethodCallee,
	receiver: ParsedExpr,
) -> ResourceArgPolicy:
	receiver_result = infer_expr(infer_without_expected(context), receiver)

	if receiver_result.context.state.errors.length() != context.state.errors.length():
		RejectResourceArgs
	else:
		receiver_type = typed_expr_value_type(receiver_result.expr)

		trait_method_resource_args_for_type(
			context,
			method_callee.trait_name,
			method_callee.method_name,
			receiver_type,
			RejectResourceArgs,
		)


private pure func infer_ufcs_call_with_receiver_result(
	context: InferContext,
	receiver_result: InferResult,
	method: ParsedIdentifier,
	entry: OverloadEntry,
	args: List[ParsedExpr],
	span: SourceSpan,
) -> Option[InferResult]:
	source_name = source_name_for_imported_module_path(context, method.text, entry.module_path)
	resolved_call = resolved_call_from_overload_entry(method.text, source_name, entry)
	callee_expr = TypedNameExpr(
		method,
		typed_expr_info_from_slot(
			None,
			InferredOrigin,
			UNREFINED_BINDING,
			Some(resolved_call),
			KeptValueSlot(entry.func_type),
		),
	)

	match entry.func_type:
		SemanticFunctionType(_, params, return_type):
			signature = call_signature(context, entry.type_params, params, return_type)
			call_params = signature.params
			call_return_type = signature.return_type
			expected_arg_count = call_params.length() - 1

			if expected_arg_count != args.length():
				next = call_arity_error(
					infer_without_expected(receiver_result.context),
					callee_expr,
					expected_arg_count,
					args.length(),
				)
				typed = TypedCallExpr(
					callee_expr,
					[receiver_result.expr],
					span,
					inferred_call_info(next, TYPE_VOID, Some(resolved_call)),
				)
				Some(infer_result(next, typed))
			else:
				match call_params.get(0):
					Some(receiver_param):
						type_param_names: List[String] = signature.bound_params.map(
							func(param): param.name,
						)
						receiver_type = typed_expr_value_type(receiver_result.expr)
						receiver_bind = bind_type_subst_with_type_params(
							receiver_result.context,
							type_param_names,
							receiver_param,
							receiver_type,
							[],
						)
						initial_return_bind = bind_expected_return_subst(
							receiver_bind.context,
							type_param_names,
							call_return_type,
							receiver_bind.subst,
						)
						arg_result = infer_call_args_with_subst(
							initial_return_bind.context,
							callee_expr,
							args,
							types_after_first(call_params),
							type_param_names,
							initial_return_bind.subst,
						)
						result_context = infer_context_with_state(context, arg_result.context.state)
						return_bind = bind_expected_return_subst(
							result_context,
							type_param_names,
							call_return_type,
							arg_result.subst,
						)
						complete_subst = complete_call_type_subst(
							return_bind.context,
							signature.bound_params,
							return_bind.subst,
						)
						checked_context = check_call_trait_bounds_for_params(
							complete_subst.context,
							callee_expr,
							signature.bound_params,
							complete_subst.subst,
						)
						dim_checked_context = check_call_dim_constraints(
							checked_context,
							Some(resolved_call),
							complete_subst.subst,
						)
						debug_checked_context = check_debug_only_call(
							dim_checked_context,
							Some(resolved_call),
						)
						resource_checked_context = check_call_resource_args(
							debug_checked_context,
							Some(resolved_call),
							[receiver_result.expr].concat(arg_result.args),
						)
						substituted_param_types = call_params.map(
							func(param): apply_subst(complete_subst.subst, param),
						)
						call_args = [receiver_result.expr].concat(arg_result.args)
						var_dims_bind = bind_call_var_dims(
							resource_checked_context,
							substituted_param_types,
							call_args,
						)
						resolved_param_types = substituted_param_types.map(
							func(param): resolve_var_dims_type(var_dims_bind.subst, param),
						)
						resolved_return_base = resolve_var_dims_type(
							var_dims_bind.subst,
							apply_subst(complete_subst.subst, call_return_type),
						)
						resolved_return_type = refined_builtin_return_type(
							Some(resolved_call),
							call_args,
							resolved_return_base,
						)
						instantiated_resolved_call = { resolved_call |
							instantiated_params = resolved_param_types,
							instantiated_return = resolved_return_type
						}
						typed = TypedCallExpr(
							callee_expr,
							call_args,
							span,
							inferred_call_info(
								var_dims_bind.context,
								resolved_return_type,
								Some(instantiated_resolved_call),
							),
						)
						Some(infer_result(var_dims_bind.context, typed))
					None:
						None
		_:
			None


private pure func retry_ufcs_call_candidates(
	context: InferContext,
	receiver_result: InferResult,
	method: ParsedIdentifier,
	selected: OverloadEntry,
	args: List[ParsedExpr],
	span: SourceSpan,
) -> Option[InferResult]:
	receiver_type = typed_expr_value_type(receiver_result.expr)

	raw_candidates: List[OverloadEntry] = match module_view_accepted_callable_value_index(
		context.state.facts.module_view,
	):
		Some(_):
			match accepted_ufcs_overloads(context, method.text, receiver_type):
				Some(found):
					found
				None:
					empty: List[OverloadEntry] = []
					empty
		None:
			env_lookup_ufcs_methods(context.state.env, method.text, receiver_type)

	candidates = raw_candidates.filter(func(entry): entry.module_path == selected.module_path)
	var successful: List[OverloadEntry] = []

	-- An unannotated lambda is purity-flexible: its body must be checked with
	-- each callback signature before a pure/impure overload can be rejected.
	for candidate in candidates:
		match infer_ufcs_call_with_receiver_result(
			context,
			receiver_result,
			method,
			candidate,
			args,
			span,
		):
			Some(result):
				if result.context.state.errors.length() == context.state.errors.length():
					successful = successful.append(candidate)
			None:
				void

	match env_select_ufcs_method(successful, receiver_type):
		Some(candidate):
			infer_ufcs_call_with_receiver_result(
				context,
				receiver_result,
				method,
				candidate,
				args,
				span,
			)
		None:
			None


private pure func infer_trait_method_ufcs_call_expr(
	context: InferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: SourceSpan,
) -> Option[InferResult]:
	match callee:
		ParsedFieldAccessExpr(receiver, method, _):
			is_module_alias = match receiver:
				ParsedNameExpr(module_ident):
					module_view_find_module_alias(
						context.state.facts.module_view,
						module_ident.text,
					).is_some()
				_:
					False

			if is_module_alias:
				None
			else:
				receiver_result = infer_expr(infer_without_expected(context), receiver)

				method_callee: Option[TraitMethodCallee] = match lookup_trait_ufcs_method_callee(
					context,
					method,
				):
					Some(callee):
						Some(callee)
					None:
						if receiver_result.context.state.errors.length() == context.state.errors.length():
							imported_receiver_trait_method_callee(
								context,
								method,
								typed_expr_value_type(receiver_result.expr),
							)
						else:
							None

				match method_callee:
					Some(method_callee):
						func_type = SemanticFunctionType(
							method_callee.method.is_pure,
							method_callee.method.params,
							method_callee.method.return_type,
						)
						receiver_type = typed_expr_value_type(receiver_result.expr)

						impl_target: Option[ImplMethodTarget] = match infer_find_impl_method_info(
							context,
							method_callee.trait_name,
							method_callee.method_name,
							receiver_type,
						):
							Some(method_info):
								method_info.target
							None:
								None

						resource_args = trait_method_ufcs_resource_args(
							context,
							method_callee,
							receiver,
						)
						resolved_call = { resolved_call_from_trait_method_callee(
							method_callee,
							impl_target,
						) |
							resource_args = resource_args
						}
						callee_expr = TypedNameExpr(
							method,
							typed_expr_info_from_slot(
								None,
								InferredOrigin,
								UNREFINED_BINDING,
								Some(resolved_call),
								KeptValueSlot(func_type),
							),
						)
						callee_result = infer_result(context, callee_expr)
						Some(
							infer_call_with_callee_result(
								context,
								callee_result,
								[receiver].concat(args),
								span,
							),
						)
					None:
						None
		_:
			None


private pure func infer_qualified_module_ufcs_call_expr(
	context: InferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: SourceSpan,
) -> Option[InferResult]:
	match callee:
		ParsedFieldAccessExpr(receiver, method, _):
			match receiver:
				ParsedNameExpr(module_ident):
					match module_view_find_module_alias(
						context.state.facts.module_view,
						module_ident.text,
					):
						Some(module_path):
							match args.get(0):
								Some(receiver_arg):
									receiver_result = infer_expr(
										infer_without_expected(context),
										receiver_arg,
									)

									if receiver_result.context.state.errors.length() != context.state.errors.length():
										None
									else:
										receiver_type = typed_expr_value_type(receiver_result.expr)

										module_entry = match module_view_accepted_callable_value_index(
											context.state.facts.module_view,
										):
											Some(_):
												accepted_module_ufcs_overloads(
													context,
													module_path,
													method.text,
													receiver_type,
												).and_then(
													func(
														matches,
													): env_select_ufcs_method(
														matches,
														receiver_type,
													),
												)
											None:
												env_resolve_module_ufcs_method(
													context.state.env,
													module_path,
													method.text,
													receiver_type,
												)

										match module_entry:
											Some(entry):
												infer_ufcs_call_with_receiver_result(
													context,
													receiver_result,
													method,
													entry,
													parsed_args_after_first(args),
													span,
												)
											None:
												None
								None:
									None
						None:
							None
				_:
					None
		_:
			None


private pure func qualified_module_owns_trait_dispatch(
	context: InferContext,
	module_path: String,
	trait_name: String,
	receiver_type: SemanticType,
) -> Bool:
	trait_owned = match module_view_accepted_trait_authority_index(context.state.facts.module_view):
		Some(index):
			match trait_authority_index_find_source(index, trait_name):
				AcceptedTraitFound(entry):
					module_identity_matches_canonical_path(
						entry.identity.module_identity,
						module_path,
					)
				AcceptedTraitAmbiguous(_) | AcceptedTraitNotFound:
					False
		None:
			match env_get_trait(context.state.env, trait_name):
				Some(trait_def):
					trait_def.module_path == Some(module_path)
				None:
					False

	type_owned = match receiver_type:
		SemanticNamedType(type_name, _):
			infer_facts_type_home_matches(context.state.facts, type_name, module_path)
		_:
			False

	-- The orphan rule requires every implementation to live with either its
	-- trait or receiver type, so these two ownership facts fully identify the
	-- modules through which qualified implementation dispatch is visible.
	trait_owned or type_owned


private pure func accepted_qualified_trait_dispatch(
	context: InferContext,
	module_path: String,
	method_name: String,
	receiver_type: SemanticType,
) -> Option[AcceptedTraitDispatch]:
	index ?= module_view_accepted_trait_authority_index(context.state.facts.module_view)
	var result: Option[AcceptedTraitDispatch] = None

	for method in trait_authority_index_ufcs_candidates(index, method_name):
		trait_owned = module_identity_matches_canonical_path(
			method.identity.owner.module_identity,
			module_path,
		)

		type_owned = match receiver_type:
			SemanticNamedType(type_name, _):
				infer_facts_type_home_matches(context.state.facts, type_name, module_path)
			_:
				False

		if trait_owned or type_owned:
			match infer_find_impl_method_info(
				context,
				method.identity.owner.name,
				method.identity.name,
				receiver_type,
			):
				Some(method_info):
					result = Some({
						callee = trait_method_callee_from_authority_entry(method_name, method),
						method_info = method_info,
					})
					break
				None:
					void

	result


private pure func legacy_qualified_trait_dispatch(
	context: InferContext,
	module_path: String,
	method_name: String,
	receiver_type: SemanticType,
) -> Option[AcceptedTraitDispatch]:
	trait_name ?= env_get_function_trait(context.state.env, method_name)

	if not qualified_module_owns_trait_dispatch(context, module_path, trait_name, receiver_type):
		None
	else:
		callee ?= trait_method_callee_from_trait(context, method_name, method_name, trait_name)
		method_info ?= infer_find_impl_method_info(context, trait_name, method_name, receiver_type)
		Some({
			callee = callee,
			method_info = method_info,
		})


private pure func infer_qualified_module_trait_call_expr(
	context: InferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: SourceSpan,
) -> Option[InferResult]:
	match callee:
		ParsedFieldAccessExpr(receiver, method, field_span):
			match (receiver, args.get(0)):
				(ParsedNameExpr(module_ident), Some(receiver_arg)):
					match module_view_find_module_alias(
						context.state.facts.module_view,
						module_ident.text,
					):
						Some(module_path):
							receiver_result = infer_expr(
								infer_without_expected(context),
								receiver_arg,
							)

							if receiver_result.context.state.errors.length() != context.state.errors.length():
								None
							else:
								receiver_type = typed_expr_value_type(receiver_result.expr)

								dispatch = match module_view_accepted_trait_authority_index(
									context.state.facts.module_view,
								):
									Some(_):
										accepted_qualified_trait_dispatch(
											context,
											module_path,
											method.text,
											receiver_type,
										)
									None:
										legacy_qualified_trait_dispatch(
											context,
											module_path,
											method.text,
											receiver_type,
										)

								match dispatch:
									Some(resolved):
										method_callee = resolved.callee
										method_info = resolved.method_info
										resolved_call = { resolved_call_from_trait_method_callee(
											method_callee,
											method_info.target,
										) |
											resource_args = method_info.resource_args
										}
										callee_expr = typed_qualified_module_field_expr(
											module_ident,
											method,
											field_span,
											method_info.func_type,
											Some(resolved_call),
										)
										Some(
											infer_call_with_callee_result(
												context,
												infer_result(context, callee_expr),
												args,
												span,
											),
										)
									None:
										None
						None:
							None
				_:
					None
		_:
			None


private pure func select_visible_ufcs_candidates(
	matches: List[OverloadEntry],
	receiver_type: SemanticType,
	argument_types: Option[List[SemanticType]],
) -> Option[OverloadEntry]:
	match argument_types:
		Some(types):
			env_select_overload_for_args(
				matches,
				[receiver_type].concat(types),
			)
		None:
			env_select_ufcs_method(matches, receiver_type)


private pure func resolve_visible_ufcs_method(
	context: InferContext,
	name: String,
	receiver_type: SemanticType,
	argument_types: Option[List[SemanticType]],
) -> Option[OverloadEntry]:
	match module_view_accepted_callable_value_index(context.state.facts.module_view):
		Some(_):
			accepted_matches: List[OverloadEntry] = match accepted_ufcs_overloads(
				context,
				name,
				receiver_type,
			):
				Some(found):
					found
				None:
					empty: List[OverloadEntry] = []
					empty

			accepted_match = select_visible_ufcs_candidates(
				accepted_matches,
				receiver_type,
				argument_types,
			)

			match accepted_match:
				Some(entry):
					Some(entry)
				None:
					builtin_matches = env_lookup_ufcs_methods(
						context.state.env,
						name,
						receiver_type,
					).filter(
						func(entry): entry.origin == BuiltinFunc,
					)
					select_visible_ufcs_candidates(builtin_matches, receiver_type, argument_types)
		None:
			resolve_visible_ufcs_method_from_env(context, name, receiver_type, argument_types)


private pure func resolve_visible_ufcs_method_from_env(
	context: InferContext,
	name: String,
	receiver_type: SemanticType,
	argument_types: Option[List[SemanticType]],
) -> Option[OverloadEntry]:
	matches = env_lookup_ufcs_methods(context.state.env, name, receiver_type)
	local_matches = matches.filter(func(entry):
		entry.module_path.is_none() and entry.origin != BuiltinFunc
	)
	imported_matches = matches.filter(func(entry):
		match entry.module_path:
			Some(module_path):
				module_view_has_selective_binding(
					context.state.facts.module_view,
					name,
					module_path,
					name,
				)
			None:
				False
	)
	builtin_matches = matches.filter(func(entry): entry.origin == BuiltinFunc)
	fallback_matches = matches.filter(func(entry):
		(
			entry.module_path.is_some()
			and entry.origin != BuiltinFunc
			and not imported_matches.any(func(imported): imported.def_id == entry.def_id)
		)
	)
	local_match = select_visible_ufcs_candidates(local_matches, receiver_type, argument_types)
	imported_match = select_visible_ufcs_candidates(imported_matches, receiver_type, argument_types)
	builtin_match = select_visible_ufcs_candidates(builtin_matches, receiver_type, argument_types)
	fallback_match = select_visible_ufcs_candidates(fallback_matches, receiver_type, argument_types)

	match local_match:
		Some(entry):
			Some(entry)
		None:
			match imported_match:
				Some(entry):
					Some(entry)
				None:
					match fallback_match:
						Some(entry):
							Some(entry)
						None:
							match builtin_match:
								Some(entry):
									Some(entry)
								None:
									env_select_ufcs_method(matches, receiver_type)


private pure func type_is_callable(typ: SemanticType) -> Bool:
	match typ:
		SemanticFunctionType(_, _, _):
			True
		_:
			False


private record CallableFieldInfo {
	field_type: SemanticType,
	definition_id: Option[Int]
}


private pure func callable_field_info(
	context: InferContext,
	receiver_type: SemanticType,
	field_name: String,
) -> Option[CallableFieldInfo]:
	match receiver_type:
		SemanticTupleType(elements):
			tuple_field_type(elements, field_name)
				.filter(type_is_callable)
				.map(func(field_type): {
						field_type = field_type,
						definition_id = None
					})
		SemanticNamedType(name, args):
			if name == "Tuple":
				tuple_field_type(args, field_name)
					.filter(type_is_callable)
					.map(func(field_type): {
							field_type = field_type,
							definition_id = None
						})
			else:
				match record_field_types(context, name, args):
					Some(fields):
						find_record_field(fields, field_name)
							.filter(func(field): type_is_callable(field.field_type))
							.map(func(field): {
									field_type = field.field_type,
									definition_id = field.definition_id
								})
					None:
						None
		_:
			None


private pure func infer_ufcs_call_expr(
	context: InferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: SourceSpan,
) -> Option[InferResult]:
	match callee:
		ParsedFieldAccessExpr(receiver, method, field_span):
			is_module_alias = match receiver:
				ParsedNameExpr(module_ident):
					module_view_find_module_alias(
						context.state.facts.module_view,
						module_ident.text,
					).is_some()
				_:
					False

			if is_module_alias:
				None
			else:
				receiver_result = infer_expr(infer_without_expected(context), receiver)

				if receiver_result.context.state.errors.length() != context.state.errors.length():
					None
				else:
					receiver_type = typed_expr_value_type(receiver_result.expr)

					match callable_field_info(context, receiver_type, method.text):
						Some(field):
							field_context = infer_context_with_state(
								context,
								receiver_result.context.state,
							)
							field_expr = TypedFieldAccessExpr(
								receiver_result.expr,
								method,
								field_span,
								{ inferred_info(field_context, field.field_type) |
									resolved_definition_id = field.definition_id
								},
							)
							field_result = infer_result(field_context, field_expr)
							Some(infer_call_with_callee_result(context, field_result, args, span))
						None:
							argument_types = bare_overload_arg_types(receiver_result.context, args)

							match resolve_visible_ufcs_method(
								context,
								method.text,
								receiver_type,
								argument_types,
							):
								Some(entry):
									if (
										entry.origin == BuiltinFunc
										and builtin_ufcs_prefers_trait_dispatch(
											method.text,
											receiver_type,
										)
									):
										-- Preserve the authoritative trait identity instead
										-- of lowering the builtin fallback as a direct call.
										None
									else:
										initial = infer_ufcs_call_with_receiver_result(
											context,
											receiver_result,
											method,
											entry,
											args,
											span,
										)

										match initial:
											Some(result):
												if result.context.state.errors.length() == context.state.errors.length():
													Some(result)
												else:
													match retry_ufcs_call_candidates(
														context,
														receiver_result,
														method,
														entry,
														args,
														span,
													):
														Some(retried):
															Some(retried)
														None:
															Some(result)
											None:
												retry_ufcs_call_candidates(
													context,
													receiver_result,
													method,
													entry,
													args,
													span,
												)
								None:
									None
		_:
			None


private pure func infer_call_expr(
	context: InferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: SourceSpan,
) -> InferResult:
	match infer_special_builtin_call_expr(infer_without_expected(context), callee, args, span):
		Some(result):
			result
		None:
			-- Module-qualified ordinary calls can reach this UFCS selector when
			-- their first argument matches the first parameter. Preserve the
			-- caller's expected type so return-only generics can still bind from
			-- annotated locals.
			match infer_qualified_module_ufcs_call_expr(context, callee, args, span):
				Some(result):
					result
				None:
					match infer_qualified_module_trait_call_expr(context, callee, args, span):
						Some(result):
							result
						None:
							match missing_qualified_module_call_result(
								infer_without_expected(context),
								callee,
								span,
							):
								Some(result):
									result
								None:
									match infer_bare_overload_callee(
										infer_without_expected(context),
										callee,
										args,
									):
										Some(callee_result):
											infer_call_with_callee_result(
												context,
												callee_result,
												args,
												span,
											)
										None:
											match missing_bare_overload_call_result(
												infer_without_expected(context),
												callee,
												args,
												span,
											):
												Some(result):
													result
												None:
													match infer_ufcs_call_expr(
														context,
														callee,
														args,
														span,
													):
														Some(result):
															result
														None:
															match infer_trait_method_ufcs_call_expr(
																context,
																callee,
																args,
																span,
															):
																Some(result):
																	result
																None:
																	callee_context = { call_callee_context(
																		context,
																		callee,
																	) |
																		suppress_debug_only_reference = True
																	}

																	callee_result = match infer_qualified_module_callee(
																		callee_context,
																		callee,
																	):
																		Some(result):
																			result
																		None:
																			infer_expr(
																				callee_context,
																				callee,
																			)

																	infer_call_with_callee_result(
																		context,
																		callee_result,
																		args,
																		span,
																	)


private pure func expected_function_type(
	context: InferContext,
) -> Option[(Bool, List[SemanticType], SemanticType)]:
	match infer_context_expected_type(context):
		Some(SemanticFunctionType(is_pure, params, return_type)):
			Some((is_pure, params, return_type))
		_:
			None


private pure func name_list_add_unique(names: List[String], name: String) -> List[String]:
	if names.contains(name):
		names
	else:
		names.append(name)


private pure func name_lists_concat_unique(
	names: List[String],
	extra: List[String],
) -> List[String]:
	var result = names

	for name in extra:
		result = name_list_add_unique(result, name)

	result


private opaque type FreeVarFacts = InferSession


private pure func free_var_facts(context: InferContext) -> FreeVarFacts:
	into FreeVarFacts(context.state)


private pure func free_var_facts_with_env(context: InferContext, env: Env) -> FreeVarFacts:
	into FreeVarFacts({ context.state | env = env })


private pure func free_var_facts_session(facts: FreeVarFacts) -> InferSession:
	from FreeVarFacts(facts)


private pure func free_var_facts_env(facts: FreeVarFacts) -> Env:
	free_var_facts_session(facts).env


private pure func free_var_name_is_constructor(facts: FreeVarFacts, name: String) -> Bool:
	session = free_var_facts_session(facts)

	match module_view_accepted_union_type_index(session.facts.module_view):
		Some(index):
			match env_lookup(session.env, name):
				Some(symbol):
					match symbol.kind:
						ConstructorSymbolKind(_):
							union_type_index_find_constructor(index, name).is_some()
						_:
							False
				None:
					union_type_index_find_constructor(index, name).is_some()
		None:
			env_get_constructor(session.env, name).is_some()


private pure func pattern_bound_names(env: FreeVarFacts, pattern: ParsedPattern) -> List[String]:
	match pattern:
		ParsedNamePattern(name):
			if free_var_name_is_constructor(env, name.text):
				[]
			else:
				[name.text]
		ParsedConstructorPattern(_, fields, _):
			var result: List[String] = []

			for field in fields:
				result = name_lists_concat_unique(
					result,
					pattern_bound_names(env, field),
				)

			result
		ParsedQualifiedConstructorPattern(_, _, fields, _):
			var result: List[String] = []

			for field in fields:
				result = name_lists_concat_unique(
					result,
					pattern_bound_names(env, field),
				)

			result
		ParsedTuplePattern(items, _):
			var result: List[String] = []

			for item in items:
				result = name_lists_concat_unique(
					result,
					pattern_bound_names(env, item),
				)

			result
		ParsedListPattern(items, spread, _):
			var result: List[String] = []

			for item in items:
				result = name_lists_concat_unique(
					result,
					pattern_bound_names(env, item),
				)

			match spread:
				Some(ParsedListSpreadName(name)):
					name_list_add_unique(result, name.text)
				Some(ParsedListSpreadWildcard(_)):
					result
				None:
					result
		ParsedOrPattern(options, _):
			var result: List[String] = []

			for option in options:
				result = name_lists_concat_unique(
					result,
					pattern_bound_names(env, option),
				)

			result
		_:
			[]


private pure func free_var_refs_in_interpolation_parts(
	env: FreeVarFacts,
	bound: List[String],
	parts: List[ParsedStringInterpolationPart],
) -> List[String]:
	var result: List[String] = []

	for part in parts:
		match part:
			ParsedInterpolationLiteral(_):
				void
			ParsedInterpolationExpr(expr):
				result = name_lists_concat_unique(
					result,
					free_var_refs_in_expr(env, bound, expr),
				)

	result


private pure func free_var_refs_in_exprs(
	env: FreeVarFacts,
	bound: List[String],
	exprs: List[ParsedExpr],
) -> List[String]:
	var result: List[String] = []

	for expr in exprs:
		result = name_lists_concat_unique(
			result,
			free_var_refs_in_expr(env, bound, expr),
		)

	result


private pure func free_var_refs_in_dict_entries(
	env: FreeVarFacts,
	bound: List[String],
	entries: List[ParsedDictEntry],
) -> List[String]:
	var result: List[String] = []

	for entry in entries:
		result = name_lists_concat_unique(
			result,
			free_var_refs_in_expr(env, bound, entry.key),
		)
		result = name_lists_concat_unique(
			result,
			free_var_refs_in_expr(env, bound, entry.value),
		)

	result


private pure func free_var_refs_in_record_fields(
	env: FreeVarFacts,
	bound: List[String],
	fields: List[ParsedRecordExprField],
) -> List[String]:
	var result: List[String] = []

	for field in fields:
		result = name_lists_concat_unique(
			result,
			free_var_refs_in_expr(env, bound, field.value),
		)

	result


private pure func free_var_refs_in_match_cases(
	env: FreeVarFacts,
	bound: List[String],
	cases: List[ParsedMatchCase],
) -> List[String]:
	var result: List[String] = []

	for case in cases:
		case_bound = name_lists_concat_unique(
			bound,
			pattern_bound_names(env, case.pattern),
		)
		result = name_lists_concat_unique(
			result,
			free_var_refs_in_expr(env, case_bound, case.body),
		)

	result


private pure func free_var_refs_in_concurrent_params(
	env: FreeVarFacts,
	bound: List[String],
	params: List[ParsedConcurrentParam],
) -> List[String]:
	var result: List[String] = []

	for param in params:
		result = name_lists_concat_unique(
			result,
			free_var_refs_in_expr(env, bound, param.value),
		)

	result


private pure func free_var_refs_in_select_arms(
	env: FreeVarFacts,
	bound: List[String],
	arms: List[ParsedSelectArm],
) -> List[String]:
	var result: List[String] = []

	for arm in arms:
		match arm.kind:
			ParsedSelectReceiveArm(name, channel):
				body_bound = name_list_add_unique(bound, name.text)
				result = name_lists_concat_unique(
					result,
					free_var_refs_in_expr(env, bound, channel),
				)
				result = name_lists_concat_unique(
					result,
					free_var_refs_in_expr(env, body_bound, arm.body),
				)
			ParsedSelectSealedArm(channel):
				result = name_lists_concat_unique(
					result,
					free_var_refs_in_expr(env, bound, channel),
				)
				result = name_lists_concat_unique(
					result,
					free_var_refs_in_expr(env, bound, arm.body),
				)
			ParsedSelectAfterArm(timeout):
				result = name_lists_concat_unique(
					result,
					free_var_refs_in_expr(env, bound, timeout),
				)
				result = name_lists_concat_unique(
					result,
					free_var_refs_in_expr(env, bound, arm.body),
				)

	result


private pure func free_var_refs_in_with_binding(
	env: FreeVarFacts,
	bound: List[String],
	binding: ParsedWithBinding,
) -> List[String]:
	value_refs = free_var_refs_in_expr(env, bound, binding.value)

	match binding.error_map:
		Some(mapper):
			mapper_bound = name_list_add_unique(bound, mapper.name.text)
			name_lists_concat_unique(
				value_refs,
				free_var_refs_in_expr(env, mapper_bound, mapper.value),
			)
		None:
			value_refs


private pure func free_var_refs_in_concurrent_block_body(
	env: FreeVarFacts,
	bound: List[String],
	body: ParsedExpr,
) -> List[String]:
	match body:
		ParsedBlockExpr(items, _):
			var result: List[String] = []

			for item in items:
				match concurrent_binding_value(item):
					Some(value):
						result = name_lists_concat_unique(
							result,
							free_var_refs_in_expr(env, bound, value),
						)
					None:
						result = name_lists_concat_unique(
							result,
							free_var_refs_in_expr(env, bound, item),
						)

			result
		_:
			free_var_refs_in_expr(env, bound, body)


private pure func sequence_bound_after_expr(
	env: FreeVarFacts,
	bound: List[String],
	expr: ParsedExpr,
) -> List[String]:
	match expr:
		ParsedVarDeclExpr(name, _, _, _, _):
			name_list_add_unique(bound, name.text)
		ParsedAssignExpr(name, _, _):
			if (
				not bound.contains(name.text)
				and env_lookup(free_var_facts_env(env), name.text).is_none()
			):
				name_list_add_unique(bound, name.text)
			else:
				bound
		ParsedQuestionBindExpr(name, _, _, _):
			name_list_add_unique(bound, name.text)
		ParsedTupleDestructExpr(names, _, _):
			name_lists_concat_unique(
				bound,
				names.map(func(name): name.text),
			)
		_:
			bound


private pure func free_var_refs_in_sequence(
	env: FreeVarFacts,
	bound: List[String],
	exprs: List[ParsedExpr],
) -> List[String]:
	var result: List[String] = []
	var next_bound = bound

	for expr in exprs:
		result = name_lists_concat_unique(
			result,
			free_var_refs_in_expr(env, next_bound, expr),
		)
		next_bound = sequence_bound_after_expr(env, next_bound, expr)

	result


private pure func lambda_param_bound_names(params: List[ParsedLambdaParam]) -> List[String]:
	var result: List[String] = []

	for param in params:
		result = name_list_add_unique(result, param.name.text)

	result


private pure func free_var_lhs_refs(
	env: FreeVarFacts,
	bound: List[String],
	name: ParsedIdentifier,
) -> List[String]:
	if bound.contains(name.text):
		[]
	else:
		match env_lookup(free_var_facts_env(env), name.text):
			Some(_):
				[name.text]
			None:
				[]


private pure func free_var_refs_in_expr(
	env: FreeVarFacts,
	bound: List[String],
	expr: ParsedExpr,
) -> List[String]:
	match expr:
		ParsedNameExpr(name):
			if bound.contains(name.text):
				[]
			else:
				[name.text]
		ParsedUnaryExpr(_, inner, _):
			free_var_refs_in_expr(env, bound, inner)
		ParsedBinaryExpr(_, left, right, _):
			name_lists_concat_unique(
				free_var_refs_in_expr(env, bound, left),
				free_var_refs_in_expr(env, bound, right),
			)
		ParsedLogicalExpr(_, left, right, _):
			name_lists_concat_unique(
				free_var_refs_in_expr(env, bound, left),
				free_var_refs_in_expr(env, bound, right),
			)
		ParsedAscriptionExpr(inner, _, _):
			free_var_refs_in_expr(env, bound, inner)
		ParsedOpaqueIntoExpr(_, inner, _):
			free_var_refs_in_expr(env, bound, inner)
		ParsedOpaqueFromExpr(_, inner, _):
			free_var_refs_in_expr(env, bound, inner)
		ParsedQuestionBindExpr(_, _, value, _):
			free_var_refs_in_expr(env, bound, value)
		ParsedRangeExpr(start_expr, end_expr, _):
			name_lists_concat_unique(
				free_var_refs_in_expr(env, bound, start_expr),
				free_var_refs_in_expr(env, bound, end_expr),
			)
		ParsedStringInterpolationPartsExpr(parts, _, _):
			free_var_refs_in_interpolation_parts(env, bound, parts)
		ParsedCallExpr(callee, args, _):
			name_lists_concat_unique(
				free_var_refs_in_expr(env, bound, callee),
				free_var_refs_in_exprs(env, bound, args),
			)
		ParsedFieldAccessExpr(receiver, _, _):
			free_var_refs_in_expr(env, bound, receiver)
		ParsedSubscriptExpr(receiver, indices, _):
			name_lists_concat_unique(
				free_var_refs_in_expr(env, bound, receiver),
				free_var_refs_in_exprs(env, bound, indices),
			)
		ParsedListExpr(items, _):
			free_var_refs_in_exprs(env, bound, items)
		ParsedTupleExpr(items, _):
			free_var_refs_in_exprs(env, bound, items)
		ParsedVectorExpr(items, _):
			free_var_refs_in_exprs(env, bound, items)
		ParsedDictExpr(entries, _):
			free_var_refs_in_dict_entries(env, bound, entries)
		ParsedRecordExpr(fields, _):
			free_var_refs_in_record_fields(env, bound, fields)
		ParsedRecordUpdateExpr(base, fields, _):
			name_lists_concat_unique(
				free_var_refs_in_expr(env, bound, base),
				free_var_refs_in_record_fields(env, bound, fields),
			)
		ParsedBlockExpr(items, _):
			free_var_refs_in_sequence(env, bound, items)
		ParsedIfExpr(condition, then_branch, else_branch, _):
			with_then = name_lists_concat_unique(
				free_var_refs_in_expr(env, bound, condition),
				free_var_refs_in_expr(env, bound, then_branch),
			)

			match else_branch:
				Some(branch):
					name_lists_concat_unique(
						with_then,
						free_var_refs_in_expr(env, bound, branch),
					)
				None:
					with_then
		ParsedMatchExpr(scrutinee, cases, _):
			name_lists_concat_unique(
				free_var_refs_in_expr(env, bound, scrutinee),
				free_var_refs_in_match_cases(env, bound, cases),
			)
		ParsedDebugBlockExpr(body, _):
			free_var_refs_in_expr(env, bound, body)
		ParsedSelectExpr(arms, _):
			free_var_refs_in_select_arms(env, bound, arms)
		ParsedWithExpr(binding, body, _):
			body_bound = name_list_add_unique(bound, binding.name.text)
			name_lists_concat_unique(
				free_var_refs_in_with_binding(env, bound, binding),
				free_var_refs_in_expr(env, body_bound, body),
			)
		ParsedConcurrentBlockExpr(params, body, _):
			name_lists_concat_unique(
				free_var_refs_in_concurrent_params(env, bound, params),
				free_var_refs_in_concurrent_block_body(env, bound, body),
			)
		ParsedConcurrentForExpr(name, iterable, params, body, _):
			body_bound = name_list_add_unique(bound, name.text)
			name_lists_concat_unique(
				name_lists_concat_unique(
					free_var_refs_in_expr(env, bound, iterable),
					free_var_refs_in_concurrent_params(env, bound, params),
				),
				free_var_refs_in_expr(env, body_bound, body),
			)
		ParsedDetachExpr(body, _):
			free_var_refs_in_expr(env, bound, body)
		ParsedLambdaExpr(_, params, _, body, _):
			lambda_bound = name_lists_concat_unique(bound, lambda_param_bound_names(params))
			free_var_refs_in_expr(env, lambda_bound, body)
		ParsedWhileExpr(condition, body, _):
			name_lists_concat_unique(
				free_var_refs_in_expr(env, bound, condition),
				free_var_refs_in_expr(env, bound, body),
			)
		ParsedForExpr(binder, iterable, body, _):
			binder_bound_names: List[String] = match binder:
				ParsedForNameBinder(name):
					[name.text]
				ParsedForTupleBinder(names, _):
					names.map(func(name): name.text)

			body_bound = name_lists_concat_unique(bound, binder_bound_names)
			name_lists_concat_unique(
				free_var_refs_in_expr(env, bound, iterable),
				free_var_refs_in_expr(env, body_bound, body),
			)
		ParsedVarDeclExpr(_, _, value, _, _):
			free_var_refs_in_expr(env, bound, value)
		ParsedAssignExpr(name, value, _):
			name_lists_concat_unique(
				free_var_lhs_refs(env, bound, name),
				free_var_refs_in_expr(env, bound, value),
			)
		ParsedCompoundAssignExpr(name, _, value, _):
			name_lists_concat_unique(
				free_var_lhs_refs(env, bound, name),
				free_var_refs_in_expr(env, bound, value),
			)
		ParsedSubscriptAssignExpr(target, indices, value, _):
			with_indices = name_lists_concat_unique(
				free_var_refs_in_expr(env, bound, target),
				free_var_refs_in_exprs(env, bound, indices),
			)
			name_lists_concat_unique(
				with_indices,
				free_var_refs_in_expr(env, bound, value),
			)
		ParsedTupleDestructExpr(_, value, _):
			free_var_refs_in_expr(env, bound, value)
		_:
			[]


private pure func mutable_capture_names(session: InferSession, refs: List[String]) -> List[String]:
	var result: List[String] = []

	for name in refs:
		match infer_session_visible_var_symbol(session, name):
			Some(var_symbol):
				if var_mutability_is_mutable(var_symbol.mutability):
					result = name_list_add_unique(result, name)
				else:
					void
			None:
				void

	result


private pure func scoped_resource_capture_names(env: Env, refs: List[String]) -> List[String]:
	var result: List[String] = []

	for name in refs:
		if (
			env_is_scoped_resource_var(env, name)
			or env_scoped_resource_unavailable_owner(env, name).is_some()
		):
			result = name_list_add_unique(result, name)

	result


private pure func scoped_resource_derived_capture_names(
	env: Env,
	refs: List[String],
) -> List[String]:
	var result: List[String] = []

	for name in refs:
		if env_is_scoped_resource_derived_var(env, name):
			result = name_list_add_unique(result, name)

	result


private pure func resource_capability_target_matches(
	target: ResourceShapeTarget,
	name: String,
) -> Bool:
	match target:
		OneShotStreamShape:
			is_one_shot_stream_type_name(name)
		ResourceSourceShape:
			is_resource_source_type_name(name)


-- Recursive capability scans may access only declaration layout and alias
-- facts. The opaque wrapper reuses the existing session without allocating a
-- second record; its accessors enforce the narrower dependency locally.
private opaque type ResourceTypeFacts = InferSession


private pure func resource_type_facts(context: InferContext) -> ResourceTypeFacts:
	into ResourceTypeFacts(context.state)


private pure func resource_type_facts_session(facts: ResourceTypeFacts) -> InferSession:
	from ResourceTypeFacts(facts)


private pure func resource_type_facts_env(facts: ResourceTypeFacts) -> Env:
	resource_type_facts_session(facts).env


private pure func resource_type_contains_resource_if_valid(
	facts: ResourceTypeFacts,
	name: String,
) -> Option[Bool]:
	env_type_contains_resource_if_valid(resource_type_facts_env(facts), name)


private pure func resource_type_scan_is_proven_unnecessary(
	facts: ResourceTypeFacts,
	name: String,
) -> Bool:
	env_type_resource_scan_is_proven_unnecessary(resource_type_facts_env(facts), name)


private pure func resource_type_may_contain_function(
	facts: ResourceTypeFacts,
	name: String,
) -> Option[Bool]:
	env_type_may_contain_function(resource_type_facts_env(facts), name)


private pure func resource_type_may_contain_one_shot_stream(
	facts: ResourceTypeFacts,
	name: String,
) -> Option[Bool]:
	env_type_may_contain_one_shot_stream(resource_type_facts_env(facts), name)


private pure func resource_type_may_contain_resource_source(
	facts: ResourceTypeFacts,
	name: String,
) -> Option[Bool]:
	env_type_may_contain_resource_source(resource_type_facts_env(facts), name)


private pure func resource_type_facts_resolve_alias_head(
	facts: ResourceTypeFacts,
	typ: SemanticType,
) -> SemanticType:
	session = resource_type_facts_session(facts)

	match module_view_accepted_type_alias_index(session.facts.module_view):
		Some(index):
			type_alias_index_resolve_head(index, typ)
		None:
			env_resolve_alias_head(session.env, typ)


private pure func resource_type_facts_find_opaque_alias(
	facts: ResourceTypeFacts,
	name: String,
) -> Option[(List[String], SemanticType, Option[String])]:
	session = resource_type_facts_session(facts)

	match module_view_accepted_type_alias_index(session.facts.module_view):
		Some(index):
			type_alias_index_find_opaque(
				index,
				name,
			).map(
				func(
					alias_entry,
				): (alias_entry.type_params, alias_entry.target, alias_entry.home_module),
			)
		None:
			env_get_opaque_alias(session.env, name)


private pure func named_type_component_types(
	facts: ResourceTypeFacts,
	name: String,
	args: List[SemanticType],
) -> Option[List[SemanticType]]:
	session = resource_type_facts_session(facts)

	record_info = match module_view_accepted_record_type_index(session.facts.module_view):
		Some(index):
			record_type_index_find(index, name).map(func(entry): (entry.type_params, entry.fields))
		None:
			env_get_record(session.env, name)

	match record_info:
		Some((type_params, fields)):
			subst = type_param_subst_for_args(type_params, args)
			Some(fields.map(
				func(field): apply_subst(subst, field.field_type),
			))
		None:
			union_components = match module_view_accepted_union_type_index(
				session.facts.module_view,
			):
				Some(index):
					match union_type_index_find(index, name):
						Some(entry):
							subst = type_param_subst_for_args(entry.type_params, args)
							var result: List[SemanticType] = []

							for variant in entry.variants:
								for field_type in variant.fields:
									result = result.append(apply_subst(subst, field_type))

							Some(result)
						None:
							None
				None:
					match env_get_type_decl(session.env, name):
						Some((type_params, variants)):
							subst = type_param_subst_for_args(type_params, args)
							var result: List[SemanticType] = []

							for variant in variants:
								for field_type in variant.fields:
									result = result.append(apply_subst(subst, field_type))

							Some(result)
						None:
							None

			match union_components:
				Some(component_types):
					Some(component_types)
				None:
					match resource_type_facts_find_opaque_alias(facts, name):
						Some((type_params, target, _)):
							subst = type_param_subst_for_args(type_params, args)
							Some([apply_subst(subst, target)])
						None:
							None


private pure func type_is_resource_capability_target(
	facts: ResourceTypeFacts,
	target: ResourceShapeTarget,
	typ: SemanticType,
) -> Bool:
	resolved = resource_type_facts_resolve_alias_head(facts, typ)

	match resolved:
		SemanticNamedType(name, _):
			resource_capability_target_matches(target, name)
		_:
			False


-- Leaf types cannot hide capability values or function carriers. Avoid
-- populating four shape-memo entries for each distinct ordinary scalar type.
private pure func type_requires_resource_capability_scan(
	facts: ResourceTypeFacts,
	typ: SemanticType,
) -> Bool:
	resolved = resource_type_facts_resolve_alias_head(facts, typ)

	match resolved:
		SemanticNamedType(name, args):
			session = resource_type_facts_session(facts)

			is_record = match module_view_accepted_record_type_index(session.facts.module_view):
				Some(index):
					record_type_index_find(index, name).is_some()
				None:
					env_get_record(session.env, name).is_some()

			union_index = module_view_accepted_union_type_index(session.facts.module_view)

			is_union = match union_index:
				Some(index):
					union_type_index_find(index, name).is_some()
				None:
					match env_get_type_kind(resource_type_facts_env(facts), name):
						Some(kind):
							kind == TypeUnion or kind == TypeEnum
						None:
							False

			if resource_type_scan_is_proven_unnecessary(facts, name):
				False
			else:
				(
					is_one_shot_stream_type_name(name)
					or is_resource_source_type_name(name)
					or args.length() > 0
					or is_record
					or resource_type_facts_find_opaque_alias(facts, name).is_some()
					or is_union
				)
		SemanticArrayType(element, dims):
			type_requires_resource_capability_scan(facts, element) or dims.any(func(dim):
				type_requires_resource_capability_scan(facts, dim)
			)
		SemanticFunctionType(_, _, _):
			True
		SemanticTupleType(elements):
			elements.any(func(element):
				type_requires_resource_capability_scan(facts, element)
			)
		SemanticRangeType(inner):
			type_requires_resource_capability_scan(facts, inner)
		SemanticDimOpType(_, left, right):
			(
				type_requires_resource_capability_scan(facts, left)
				or type_requires_resource_capability_scan(facts, right)
			)
		_:
			False


private EMPTY_RESOURCE_CAPABILITY_PRESENCE: ResourceCapabilityPresence = {
	contains_one_shot_stream = False,
	contains_resource_source = False
}


private pure func resource_capability_presence_for_name(name: String) -> ResourceCapabilityPresence:
	{
		contains_one_shot_stream = is_one_shot_stream_type_name(name),
		contains_resource_source = is_resource_source_type_name(name)
	}


private pure func resource_capability_presence_merge(
	left: ResourceCapabilityPresence,
	right: ResourceCapabilityPresence,
) -> ResourceCapabilityPresence:
	{
		contains_one_shot_stream = left.contains_one_shot_stream or right.contains_one_shot_stream,
		contains_resource_source = left.contains_resource_source or right.contains_resource_source
	}


private pure func resource_capability_presence_is_complete(
	presence: ResourceCapabilityPresence,
) -> Bool:
	presence.contains_one_shot_stream and presence.contains_resource_source


private pure func types_resource_capability_presence_seen(
	facts: ResourceTypeFacts,
	visited: List[String],
	types: List[SemanticType],
) -> ResourceCapabilityPresence:
	var presence: ResourceCapabilityPresence = EMPTY_RESOURCE_CAPABILITY_PRESENCE

	for typ in types:
		presence = resource_capability_presence_merge(
			presence,
			type_resource_capability_presence_seen(facts, visited, typ),
		)

		if resource_capability_presence_is_complete(presence):
			break

	presence


private pure func type_resource_capability_presence_seen(
	facts: ResourceTypeFacts,
	visited: List[String],
	typ: SemanticType,
) -> ResourceCapabilityPresence:
	resolved = resource_type_facts_resolve_alias_head(facts, typ)

	match resolved:
		SemanticNamedType(name, args):
			owned_name: String = name
			direct_presence = resource_capability_presence_for_name(owned_name)

			if (
				resource_capability_presence_is_complete(direct_presence)
				or visited.contains(owned_name)
			):
				direct_presence
			else:
				next_visited: List[String] = visited.append(owned_name)

				nested_presence = match named_type_component_types(facts, owned_name, args):
					Some(components):
						types_resource_capability_presence_seen(facts, next_visited, components)
					None:
						types_resource_capability_presence_seen(facts, visited, args)

				resource_capability_presence_merge(direct_presence, nested_presence)
		SemanticArrayType(element, dims):
			element_presence = type_resource_capability_presence_seen(facts, visited, element)

			if resource_capability_presence_is_complete(element_presence):
				element_presence
			else:
				resource_capability_presence_merge(
					element_presence,
					types_resource_capability_presence_seen(facts, visited, dims),
				)
		SemanticFunctionType(_, _, _):
			EMPTY_RESOURCE_CAPABILITY_PRESENCE
		SemanticTupleType(elements):
			types_resource_capability_presence_seen(facts, visited, elements)
		SemanticRangeType(inner):
			type_resource_capability_presence_seen(facts, visited, inner)
		SemanticDimOpType(_, left, right):
			left_presence = type_resource_capability_presence_seen(facts, visited, left)

			if resource_capability_presence_is_complete(left_presence):
				left_presence
			else:
				resource_capability_presence_merge(
					left_presence,
					type_resource_capability_presence_seen(facts, visited, right),
				)
		_:
			EMPTY_RESOURCE_CAPABILITY_PRESENCE


private pure func type_resource_capability_presence(
	facts: ResourceTypeFacts,
	typ: SemanticType,
) -> ResourceCapabilityPresence:
	resolved = resource_type_facts_resolve_alias_head(facts, typ)

	match resolved:
		SemanticNamedType(name, _):
			if (
				resource_type_may_contain_one_shot_stream(facts, name) == Some(False)
				and resource_type_may_contain_resource_source(facts, name) == Some(False)
			):
				EMPTY_RESOURCE_CAPABILITY_PRESENCE
			else:
				type_resource_capability_presence_seen(facts, [], resolved)
		_:
			type_resource_capability_presence_seen(facts, [], resolved)


private pure func resource_capability_presence_contains_target(
	presence: ResourceCapabilityPresence,
	target: ResourceShapeTarget,
) -> Bool:
	match target:
		OneShotStreamShape:
			presence.contains_one_shot_stream
		ResourceSourceShape:
			presence.contains_resource_source


private pure func resource_capability_presence_without_direct_targets(
	presence: ResourceCapabilityPresence,
	direct_presence: ResourceCapabilityPresence,
) -> ResourceCapabilityPresence:
	{
		contains_one_shot_stream = (
			presence.contains_one_shot_stream
			and not direct_presence.contains_one_shot_stream
		),
		contains_resource_source = (
			presence.contains_resource_source
			and not direct_presence.contains_resource_source
		)
	}


private pure func function_endpoint_resource_capability_presence(
	facts: ResourceTypeFacts,
	visited: List[String],
	typ: SemanticType,
) -> ResourceCapabilityPresence:
	resolved = resource_type_facts_resolve_alias_head(facts, typ)

	match resolved:
		SemanticFunctionType(_, _, _):
			type_resource_capability_function_carrier_presence_seen(facts, visited, resolved)
		_:
			direct_presence = match resolved:
				SemanticNamedType(name, _):
					resource_capability_presence_for_name(name)
				_:
					EMPTY_RESOURCE_CAPABILITY_PRESENCE

			hidden_presence = resource_capability_presence_without_direct_targets(
				type_resource_capability_presence(facts, resolved),
				direct_presence,
			)

			resource_capability_presence_merge(
				hidden_presence,
				type_resource_capability_function_carrier_presence_seen(facts, visited, resolved),
			)


private pure func function_endpoints_resource_capability_presence(
	facts: ResourceTypeFacts,
	visited: List[String],
	types: List[SemanticType],
) -> ResourceCapabilityPresence:
	var presence: ResourceCapabilityPresence = EMPTY_RESOURCE_CAPABILITY_PRESENCE

	for typ in types:
		presence = resource_capability_presence_merge(
			presence,
			function_endpoint_resource_capability_presence(facts, visited, typ),
		)

		if resource_capability_presence_is_complete(presence):
			break

	presence


private pure func types_resource_capability_function_carrier_presence_seen(
	facts: ResourceTypeFacts,
	visited: List[String],
	types: List[SemanticType],
) -> ResourceCapabilityPresence:
	var presence: ResourceCapabilityPresence = EMPTY_RESOURCE_CAPABILITY_PRESENCE

	for typ in types:
		presence = resource_capability_presence_merge(
			presence,
			type_resource_capability_function_carrier_presence_seen(facts, visited, typ),
		)

		if resource_capability_presence_is_complete(presence):
			break

	presence


private pure func type_resource_capability_function_carrier_presence_seen(
	facts: ResourceTypeFacts,
	visited: List[String],
	typ: SemanticType,
) -> ResourceCapabilityPresence:
	resolved = resource_type_facts_resolve_alias_head(facts, typ)

	match resolved:
		SemanticFunctionType(_, params, return_type):
			param_presence = function_endpoints_resource_capability_presence(facts, visited, params)

			if resource_capability_presence_is_complete(param_presence):
				param_presence
			else:
				resource_capability_presence_merge(
					param_presence,
					function_endpoint_resource_capability_presence(facts, visited, return_type),
				)
		SemanticNamedType(name, args):
			owned_name: String = name
			direct_presence = resource_capability_presence_for_name(owned_name)

			if visited.contains(owned_name):
				EMPTY_RESOURCE_CAPABILITY_PRESENCE
			else:
				next_visited: List[String] = visited.append(owned_name)

				nested_presence = match named_type_component_types(facts, owned_name, args):
					Some(components):
						types_resource_capability_function_carrier_presence_seen(
							facts,
							next_visited,
							components,
						)
					None:
						types_resource_capability_function_carrier_presence_seen(
							facts,
							visited,
							args,
						)

				resource_capability_presence_without_direct_targets(
					nested_presence,
					direct_presence,
				)
		SemanticArrayType(element, dims):
			element_presence = type_resource_capability_function_carrier_presence_seen(
				facts,
				visited,
				element,
			)

			if resource_capability_presence_is_complete(element_presence):
				element_presence
			else:
				resource_capability_presence_merge(
					element_presence,
					types_resource_capability_function_carrier_presence_seen(facts, visited, dims),
				)
		SemanticTupleType(elements):
			types_resource_capability_function_carrier_presence_seen(facts, visited, elements)
		SemanticRangeType(inner):
			type_resource_capability_function_carrier_presence_seen(facts, visited, inner)
		SemanticDimOpType(_, left, right):
			left_presence = type_resource_capability_function_carrier_presence_seen(
				facts,
				visited,
				left,
			)

			if resource_capability_presence_is_complete(left_presence):
				left_presence
			else:
				resource_capability_presence_merge(
					left_presence,
					type_resource_capability_function_carrier_presence_seen(facts, visited, right),
				)
		_:
			EMPTY_RESOURCE_CAPABILITY_PRESENCE


private pure func type_has_function_carrier_candidate_seen(
	facts: ResourceTypeFacts,
	visited: List[String],
	typ: SemanticType,
) -> Bool:
	resolved = resource_type_facts_resolve_alias_head(facts, typ)

	match resolved:
		SemanticFunctionType(_, _, _):
			True
		SemanticNamedType(name, args):
			owned_name: String = name

			if visited.contains(owned_name):
				False
			else:
				next_visited: List[String] = visited.append(owned_name)

				match named_type_component_types(facts, owned_name, args):
					Some(components):
						components.any(
							func(
								component,
							): type_has_function_carrier_candidate_seen(
								facts,
								next_visited,
								component,
							),
						)
					None:
						args.any(
							func(
								arg,
							): type_has_function_carrier_candidate_seen(facts, visited, arg),
						)
		SemanticArrayType(element, dims):
			(
				type_has_function_carrier_candidate_seen(facts, visited, element)
				or dims.any(
					func(dim): type_has_function_carrier_candidate_seen(facts, visited, dim),
				)
			)
		SemanticTupleType(elements):
			elements.any(
				func(element): type_has_function_carrier_candidate_seen(facts, visited, element),
			)
		SemanticRangeType(inner):
			type_has_function_carrier_candidate_seen(facts, visited, inner)
		SemanticDimOpType(_, left, right):
			(
				type_has_function_carrier_candidate_seen(facts, visited, left)
				or type_has_function_carrier_candidate_seen(facts, visited, right)
			)
		_:
			False


private pure func type_has_function_carrier_candidate(
	facts: ResourceTypeFacts,
	typ: SemanticType,
) -> Bool:
	match resource_type_facts_resolve_alias_head(facts, typ):
		SemanticNamedType(name, _):
			match resource_type_may_contain_function(facts, name):
				Some(False):
					False
				_:
					type_has_function_carrier_candidate_seen(facts, [], typ)
		_:
			type_has_function_carrier_candidate_seen(facts, [], typ)


private pure func type_resource_capability_function_carrier_presence(
	facts: ResourceTypeFacts,
	typ: SemanticType,
) -> ResourceCapabilityPresence:
	if type_has_function_carrier_candidate(facts, typ):
		type_resource_capability_function_carrier_presence_seen(facts, [], typ)
	else:
		EMPTY_RESOURCE_CAPABILITY_PRESENCE


private pure func resource_capability_memo_entry_contains_target(
	entry: ResourceCapabilityMemoEntry,
	target: ResourceShapeTarget,
) -> Bool:
	match target:
		OneShotStreamShape:
			entry.contains_one_shot_stream
		ResourceSourceShape:
			entry.contains_resource_source


private pure func resource_capability_memo_lookup(
	entries: List[ResourceCapabilityMemoEntry],
	target: ResourceShapeTarget,
	typ: SemanticType,
) -> Option[Bool]:
	var result: Option[Bool] = None

	for entry in entries:
		if types_equal(entry.typ, typ):
			result = Some(resource_capability_memo_entry_contains_target(entry, target))
			break

	result


private pure func type_contains_resource_capability(
	context: InferContext,
	target: ResourceShapeTarget,
	typ: SemanticType,
) -> MemoizedTypeShapeCheck:
	memo = context.state.type_shape_memo

	match resource_capability_memo_lookup(memo.contains_target, target, typ):
		Some(cached_result):
			{
				contains = cached_result,
				memo = memo
			}
		None:
			presence = type_resource_capability_presence(resource_type_facts(context), typ)

			{
				contains = resource_capability_presence_contains_target(presence, target),
				memo = { memo | contains_target = memo.contains_target.append({
						typ = typ,
						contains_one_shot_stream = presence.contains_one_shot_stream,
						contains_resource_source = presence.contains_resource_source,
					}) }
			}


private pure func type_contains_resource_capability_function_carrier(
	context: InferContext,
	target: ResourceShapeTarget,
	typ: SemanticType,
) -> MemoizedTypeShapeCheck:
	memo = context.state.type_shape_memo

	match resource_capability_memo_lookup(memo.function_carrier, target, typ):
		Some(cached_result):
			{
				contains = cached_result,
				memo = memo
			}
		None:
			carrier_presence = type_resource_capability_function_carrier_presence(
				resource_type_facts(context),
				typ,
			)
			{
				contains = resource_capability_presence_contains_target(carrier_presence, target),
				memo = { memo | function_carrier = memo.function_carrier.append({
						typ = typ,
						contains_one_shot_stream = carrier_presence.contains_one_shot_stream,
						contains_resource_source = carrier_presence.contains_resource_source,
					}) }
			}


private pure func infer_context_with_type_shape_memo(
	context: InferContext,
	memo: TypeShapeMemo,
) -> InferContext:
	{ context | state = { context.state | type_shape_memo = memo } }


private pure func optional_binding_name_suffix(name: String) -> String:
	if name == "_":
		""
	else:
		" `" + name + "`"


private pure func check_one_shot_stream_ordinary_binding(
	context: InferContext,
	binding_name: String,
	typ: SemanticType,
) -> InferContext:
	carrier_check = type_contains_resource_capability_function_carrier(
		context,
		OneShotStreamShape,
		typ,
	)
	with_function_carrier_memo = infer_context_with_type_shape_memo(context, carrier_check.memo)

	if carrier_check.contains:
		infer_error(
			with_function_carrier_memo,
			"function value" + optional_binding_name_suffix(
				binding_name,
			) + " cannot accept or return a one-shot stream carrier",
		)
	else:
		capability_check = type_contains_resource_capability(
			with_function_carrier_memo,
			OneShotStreamShape,
			typ,
		)
		with_contains_memo = infer_context_with_type_shape_memo(
			with_function_carrier_memo,
			capability_check.memo,
		)

		if (
			capability_check.contains
			and not type_is_resource_capability_target(
				resource_type_facts(with_contains_memo),
				OneShotStreamShape,
				typ,
			)
		):
			infer_error(
				with_contains_memo,
				"one-shot stream value" + optional_binding_name_suffix(
					binding_name,
				) + " cannot be bound to an ordinary variable",
			)
		else:
			with_contains_memo


private pure func check_resource_source_ordinary_binding(
	context: InferContext,
	binding_name: String,
	typ: SemanticType,
) -> InferContext:
	carrier_check = type_contains_resource_capability_function_carrier(
		context,
		ResourceSourceShape,
		typ,
	)
	with_function_carrier_memo = infer_context_with_type_shape_memo(context, carrier_check.memo)

	if carrier_check.contains:
		infer_error(
			with_function_carrier_memo,
			"function value" + optional_binding_name_suffix(
				binding_name,
			) + " cannot accept or return a resource source carrier",
		)
	else:
		capability_check = type_contains_resource_capability(
			with_function_carrier_memo,
			ResourceSourceShape,
			typ,
		)
		with_contains_memo = infer_context_with_type_shape_memo(
			with_function_carrier_memo,
			capability_check.memo,
		)

		if (
			capability_check.contains
			and not type_is_resource_capability_target(
				resource_type_facts(with_contains_memo),
				ResourceSourceShape,
				typ,
			)
		):
			infer_error(
				with_contains_memo,
				"resource source value" + optional_binding_name_suffix(
					binding_name,
				) + " cannot be bound to an ordinary variable",
			)
		else:
			with_contains_memo


private pure func check_resource_source_mutable_binding(
	context: InferContext,
	binding_name: String,
	typ: SemanticType,
	is_mutable: Bool,
) -> InferContext:
	if (
		is_mutable
		and type_is_resource_capability_target(
			resource_type_facts(context),
			ResourceSourceShape,
			typ,
		)
	):
		infer_error(
			context,
			"resource source value" + optional_binding_name_suffix(
				binding_name,
			) + " cannot be mutable",
		)
	else:
		context


private pure func check_resource_source_copy_from_existing(
	context: InferContext,
	binding_name: String,
	typ: SemanticType,
	value: ParsedExpr,
) -> InferContext:
	if type_is_resource_capability_target(resource_type_facts(context), ResourceSourceShape, typ):
		free_refs = free_var_refs_in_expr(free_var_facts(context), [], value)
		resource_capabilities = resource_capability_capture_names(
			resource_type_facts(context),
			free_refs,
		)
		refs = resource_capabilities.resource_sources

		if refs.length() > 0:
			plural = if refs.length() == 1:
				""
			else:
				"s"

			infer_error(
				context,
				"resource source value" + optional_binding_name_suffix(
					binding_name,
				) + " cannot copy existing resource source value" + plural + ": " + join_names(
					refs,
				),
			)
		else:
			context
	else:
		context


private pure func check_resource_capability_binding(
	context: InferContext,
	binding_name: String,
	typ: SemanticType,
	is_mutable: Bool,
	value: ParsedExpr,
) -> InferContext:
	if type_requires_resource_capability_scan(resource_type_facts(context), typ):
		stream_context = check_one_shot_stream_ordinary_binding(context, binding_name, typ)
		source_context = check_resource_source_ordinary_binding(stream_context, binding_name, typ)
		mutable_context = check_resource_source_mutable_binding(
			source_context,
			binding_name,
			typ,
			is_mutable,
		)
		check_resource_source_copy_from_existing(mutable_context, binding_name, typ, value)
	else:
		context


private pure func check_one_shot_stream_storage(
	context: InferContext,
	container: String,
	typ: SemanticType,
) -> InferContext:
	capability_check = type_contains_resource_capability(context, OneShotStreamShape, typ)
	with_memo = infer_context_with_type_shape_memo(context, capability_check.memo)

	if capability_check.contains:
		infer_error(
			with_memo,
			"one-shot stream values cannot be stored in " + container + " (found " + type_to_string(
				typ,
			) + ")",
		)
	else:
		with_memo


private pure func check_resource_source_storage(
	context: InferContext,
	container: String,
	typ: SemanticType,
) -> InferContext:
	capability_check = type_contains_resource_capability(context, ResourceSourceShape, typ)
	with_memo = infer_context_with_type_shape_memo(context, capability_check.memo)

	if capability_check.contains:
		infer_error(
			with_memo,
			"resource source values cannot be stored in " + container + " (found " + type_to_string(
				typ,
			) + ")",
		)
	else:
		with_memo


private pure func check_resource_capability_storage(
	context: InferContext,
	container: String,
	typ: SemanticType,
) -> InferContext:
	if type_requires_resource_capability_scan(resource_type_facts(context), typ):
		stream_context = check_one_shot_stream_storage(context, container, typ)
		check_resource_source_storage(stream_context, container, typ)
	else:
		context


private pure func resource_capability_capture_names(
	facts: ResourceTypeFacts,
	refs: List[String],
) -> ResourceCapabilityCaptureNames:
	var one_shot_streams: List[String] = []
	var resource_sources: List[String] = []

	for name in refs:
		match infer_session_visible_var_symbol(resource_type_facts_session(facts), name):
			Some(var_symbol):
				typ = var_symbol.var_type
				presence = type_resource_capability_presence(facts, typ)

				if presence.contains_one_shot_stream:
					one_shot_streams = name_list_add_unique(one_shot_streams, name)

				if presence.contains_resource_source:
					resource_sources = name_list_add_unique(resource_sources, name)
			None:
				void

	{
		one_shot_streams = one_shot_streams,
		resource_sources = resource_sources
	}


private pure func join_names(names: List[String]) -> String:
	var result: String = ""
	var index: Int = 0

	for name in names:
		if index == 0:
			result = name
		else:
			result = result + ", " + name

		index += 1

	result


private pure func check_lambda_captures(
	context: InferContext,
	params: List[ParsedLambdaParam],
	body: ParsedExpr,
) -> InferContext:
	free_refs = free_var_refs_in_expr(
		free_var_facts(context),
		lambda_param_bound_names(params),
		body,
	)
	resource_captures = scoped_resource_capture_names(context.state.env, free_refs)
	resource_capabilities = resource_capability_capture_names(
		resource_type_facts(context),
		free_refs,
	)
	source_captures = resource_capabilities.resource_sources
	derived_captures = scoped_resource_derived_capture_names(context.state.env, free_refs)
	stream_captures = resource_capabilities.one_shot_streams
	mutable_captures = mutable_capture_names(context.state, free_refs)

	if resource_captures.length() > 0:
		plural = if resource_captures.length() == 1:
			""
		else:
			"s"

		infer_error(
			context,
			"Closure cannot capture scoped resource" + plural + ": " + join_names(
				resource_captures,
			) + ". Keep resource use inside the with block without storing it in a closure.",
		)
	else if source_captures.length() > 0:
		plural = if source_captures.length() == 1:
			""
		else:
			"s"

		infer_error(
			context,
			"Closure cannot capture resource source value" + plural + ": " + join_names(
				source_captures,
			) + ". Consume the source with resource-source iteration instead.",
		)
	else if derived_captures.length() > 0:
		plural = if derived_captures.length() == 1:
			""
		else:
			"s"

		infer_error(
			context,
			"Closure cannot capture scoped resource-derived value" + plural + ": " + join_names(
				derived_captures,
			) + ". Keep dependent values inside the with block without storing them in a closure.",
		)
	else if stream_captures.length() > 0:
		plural = if stream_captures.length() == 1:
			""
		else:
			"s"

		infer_error(
			context,
			"Closure cannot capture one-shot stream value" + plural + ": " + join_names(
				stream_captures,
			) + ((
				". Create and consume the stream inside the closure, or collect ordinary data "
				+ "before creating the closure."
			)),
		)
	else if mutable_captures.length() == 0:
		context
	else:
		plural = if mutable_captures.length() == 1:
			""
		else:
			"s"

		infer_error(
			context,
			"Closure cannot capture mutable variable" + plural + ": " + join_names(
				mutable_captures,
			) + ". Use explicit state threading instead.",
		)


private pure func lambda_param_type(
	context: InferContext,
	param: ParsedLambdaParam,
	index: Int,
	expected_params: List[SemanticType],
) -> (InferContext, TypedLambdaParam):
	match param.type_expr:
		Some(type_expr):
			source_type = type_from_parsed_type_expr(type_expr)
			semantic_type = infer_canonical_expected_type(context, source_type)
			(context, {
					name = param.name,
					source_type = Some(source_type),
					param_type = semantic_type
				})
		None:
			match expected_params.get(index):
				Some(expected_type):
					(context, {
							name = param.name,
							source_type = None,
							param_type = expected_type
						})
				None:
					next = infer_error(
						context,
						"Cannot infer type of lambda parameter `" + param.name.text + "`; add a type annotation",
					)
					(next, {
							name = param.name,
							source_type = None,
							param_type = TYPE_VOID
						})


private pure func infer_lambda_params(
	context: InferContext,
	params: List[ParsedLambdaParam],
	expected_params: List[SemanticType],
) -> InferLambdaParamsResult:
	var next_context: InferContext = context
	var typed_params: List[TypedLambdaParam] = []
	var param_types: List[SemanticType] = []
	var seen: List[String] = []
	var index: Int = 0

	while index < params.length():
		match params.get(index):
			Some(param):
				if seen.contains(param.name.text):
					next_context = infer_error(
						next_context,
						"Cannot redeclare lambda parameter `" + param.name.text + "`",
					)

				seen = seen.append(param.name.text)
				param_result: (InferContext, TypedLambdaParam) = lambda_param_type(
					next_context,
					param,
					index,
					expected_params,
				)
				next_context = param_result[0]
				typed_param = param_result[1]
				typed_params = typed_params.append(typed_param)
				param_types = param_types.append(typed_param.param_type)
			None:
				void

		index += 1

	{
		context = next_context,
		params = typed_params,
		param_types = param_types
	}


private pure func add_lambda_param_bindings(env: Env, params: List[TypedLambdaParam]) -> Env:
	var next_env: Env = env

	for param in params:
		next_env = env_add_var_with_details(
			next_env,
			param.name.text,
			param.param_type,
			param.source_type,
			ImmutableBinding,
			FuncParam,
			UNREFINED_BINDING,
		)

	next_env


private pure func expected_lambda_return_type(
	context: InferContext,
	return_type: Option[ParsedTypeExpr],
	expected_return_type: Option[SemanticType],
) -> Option[SemanticType]:
	match return_type:
		Some(type_expr):
			Some(infer_canonical_expected_type(context, type_from_parsed_type_expr(type_expr)))
		None:
			match expected_return_type:
				Some(typ):
					if type_contains_type_var(typ):
						None
					else:
						Some(typ)
				None:
					None


private pure func infer_lambda_expr(
	context: InferContext,
	is_pure: Bool,
	params: List[ParsedLambdaParam],
	return_type: Option[ParsedTypeExpr],
	body: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	expected_function = expected_function_type(context)

	expected_params: List[SemanticType] = match expected_function:
		Some((_, param_types, _)):
			param_types
		None:
			[]

	expected_pure = match expected_function:
		Some((is_expected_pure, _, _)):
			is_expected_pure
		None:
			False

	expected_return_type: Option[SemanticType] = match expected_function:
		Some((_, _, expected_return)):
			Some(expected_return)
		None:
			None

	capture_context = check_lambda_captures(context, params, body)
	params_result = infer_lambda_params(capture_context, params, expected_params)
	var body_env = env_push_scope(params_result.context.state.env)
	body_env = add_lambda_param_bindings(body_env, params_result.params)
	body_state = { params_result.context.state | env = body_env }
	body_base_context = infer_context_with_state(params_result.context, body_state)
	declared_return_type = expected_lambda_return_type(
		body_base_context,
		return_type,
		expected_return_type,
	)

	body_context = match declared_return_type:
		Some(typ):
			infer_with_canonical_expected_value_slot(body_base_context, typ, ExpectedArgumentSlot)
		None:
			infer_without_expected(body_base_context)

	body_result = infer_expr(body_context, body)
	body_value_type = typed_expr_value_type(body_result.expr)

	result_return_type = match declared_return_type:
		Some(typ):
			typ
		None:
			typed_expr_semantic_type(body_result.expr)

	checked_context = match declared_return_type:
		Some(typ):
			if types_equal(body_value_type, typ):
				body_result.context
			else:
				infer_error(
					body_result.context,
					"Lambda body type mismatch: expected " + type_to_string(
						typ,
					) + ", got " + type_to_string(body_value_type),
				)
		None:
			body_result.context

	outer_env = env_pop_scope(checked_context.state.env)
	outer_state = { checked_context.state | env = outer_env }
	result_context = infer_context_with_state(context, outer_state)
	inferred_pure = (
		is_pure
		or expected_pure and typed_expr_purity_requirements(body_result.expr).is_empty()
	)

	function_type = SemanticFunctionType(
		inferred_pure,
		params_result.param_types,
		result_return_type,
	)
	typed = TypedLambdaExpr(
		inferred_pure,
		params_result.params,
		declared_return_type,
		body_result.expr,
		span,
		inferred_info(result_context, function_type),
	)

	infer_result(result_context, typed)


private pure func infer_expr_list_result(
	context: InferContext,
	exprs: List[TypedExpr],
) -> InferExprListResult:
	{
		context = context,
		exprs = exprs
	}


private pure func infer_unconstrained_exprs(
	context: InferContext,
	exprs: List[ParsedExpr],
) -> InferExprListResult:
	var next_context: InferContext = context
	var typed_exprs: List[TypedExpr] = []
	var index: Int = 0

	while index < exprs.length():
		match exprs.get(index):
			Some(expr):
				result = infer_expr(infer_without_expected(next_context), expr)
				next_context = result.context
				typed_exprs = typed_exprs.append(result.expr)
			None:
				void

		index += 1

	infer_expr_list_result(infer_without_expected(next_context), typed_exprs)


private pure func expected_tuple_item_types(context: InferContext) -> Option[List[SemanticType]]:
	match infer_context_expected_type(context):
		Some(expected_type):
			tuple_elements_from_type(expected_type)
		None:
			None


private pure func infer_tuple_items_with_expected(
	context: InferContext,
	items: List[ParsedExpr],
	expected_items: List[SemanticType],
) -> InferExprListResult:
	var next_context: InferContext = context
	var typed_exprs: List[TypedExpr] = []
	var index: Int = 0

	while index < items.length():
		match (items.get(index), expected_items.get(index)):
			(Some(item), Some(expected_type)):
				result = infer_expr(
					infer_with_canonical_expected_value_slot(
						next_context,
						expected_type,
						ExpectedArgumentSlot,
					),
					item,
				)
				next_context = result.context
				typed_exprs = typed_exprs.append(result.expr)
			_:
				void

		index += 1

	infer_expr_list_result(infer_without_expected(next_context), typed_exprs)


private pure func infer_tuple_items(
	context: InferContext,
	items: List[ParsedExpr],
) -> InferExprListResult:
	match expected_tuple_item_types(context):
		Some(expected_items):
			if expected_items.length() == items.length():
				infer_tuple_items_with_expected(context, items, expected_items)
			else:
				infer_unconstrained_exprs(context, items)
		None:
			infer_unconstrained_exprs(context, items)


private pure func infer_tuple_expr(
	context: InferContext,
	items: List[ParsedExpr],
	span: SourceSpan,
) -> InferResult:
	items_result = infer_tuple_items(context, items)
	tuple_type = SemanticTupleType(items_result.exprs.map(typed_expr_semantic_type))
	tuple_value_type = SemanticTupleType(items_result.exprs.map(
		func(item): scalar_int_value_type(typed_expr_value_type(item)),
	))
	var checked_context: InferContext = infer_context_with_state(
		context,
		items_result.context.state,
	)

	for item in items_result.exprs:
		checked_context = check_resource_capability_storage(
			checked_context,
			"tuple literals",
			typed_expr_value_type(item),
		)

	typed = TypedTupleExpr(
		items_result.exprs,
		span,
		typed_expr_info_from_slot(
			None,
			InferredOrigin,
			UNREFINED_BINDING,
			None,
			tuple_literal_slot(tuple_type, tuple_value_type),
		),
	)

	infer_result(checked_context, typed)


private pure func check_tuple_destruct_redeclarations(
	context: InferContext,
	names: List[ParsedIdentifier],
) -> InferContext:
	var next_context: InferContext = context
	var seen: List[String] = []

	for name in names:
		if name.text != "_":
			if (
				env_lookup_in_current_scope(context.state.env, name.text).is_some()
				or seen.contains(name.text)
			):
				next_context = infer_error(
					next_context,
					"Cannot redeclare `" + name.text + "` in tuple destructuring",
				)

			seen = seen.append(name.text)

	next_context


private pure func add_tuple_destruct_bindings(
	env: Env,
	names: List[ParsedIdentifier],
	element_types: List[SemanticType],
) -> Env:
	var next_env: Env = env
	var index: Int = 0

	while index < names.length():
		match names.get(index):
			Some(name):
				if name.text != "_":
					elem_type = tuple_binding_type(element_types, index)
					next_env = env_add_var_with_details(
						next_env,
						name.text,
						elem_type,
						Some(elem_type),
						ImmutableBinding,
						LetBinding,
						UNREFINED_BINDING,
					)
			None:
				void

		index += 1

	next_env


private pure func infer_tuple_destruct_expr(
	context: InferContext,
	names: List[ParsedIdentifier],
	value: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	checked_context = check_tuple_destruct_redeclarations(context, names)
	value_result = infer_expr(infer_without_expected(checked_context), value)
	value_type = typed_expr_semantic_type(value_result.expr)
	element_result = tuple_elements_from_type(value_type)

	result_context = match element_result:
		Some(element_types):
			if names.length() == element_types.length():
				next_env = add_tuple_destruct_bindings(
					value_result.context.state.env,
					names,
					element_types,
				)
				next_state = { value_result.context.state | env = next_env }
				infer_context_with_state(context, next_state)
			else:
				infer_error(
					value_result.context,
					"Tuple destructuring arity mismatch: expected " + names
						.length()
						.to_string() + " elements, got " + element_types
						.length()
						.to_string(),
				)
		None:
			infer_error(
				value_result.context,
				"Tuple destructuring requires a tuple type, got " + type_to_string(value_type),
			)

	typed = TypedTupleDestructExpr(
		names,
		value_result.expr,
		span,
		inferred_info(result_context, TYPE_VOID),
	)

	infer_result(result_context, typed)


private pure func expected_list_element_type(context: InferContext) -> Option[SemanticType]:
	match infer_context_expected_type(context):
		Some(expected):
			match expected:
				SemanticNamedType(name, args):
					if name == "List" and args.length() == 1:
						args.get(0)
					else:
						None
				_:
					None
		None:
			None


private pure func expected_vector_type(
	context: InferContext,
) -> Option[(SemanticType, List[SemanticType])]:
	match infer_context_expected_type(context):
		Some(expected):
			array_type_parts(expected)
		None:
			None


private pure func dims_after_first(dims: List[SemanticType]) -> List[SemanticType]:
	var result: List[SemanticType] = []
	var index: Int = 1

	while index < dims.length():
		match dims.get(index):
			Some(dim):
				result = result.append(dim)
			None:
				void

		index += 1

	result


private pure func vector_item_type(
	element_type: SemanticType,
	dims: List[SemanticType],
) -> SemanticType:
	if dims.length() <= 1:
		element_type
	else:
		array_type(element_type, dims_after_first(dims))


private pure func default_collection_element_type(typ: SemanticType) -> SemanticType:
	match typ:
		SemanticTupleType(elements):
			SemanticTupleType(elements.map(default_collection_element_type))
		_:
			numeric_operand_type(ParsedAddOp, typ)


private pure func types_compatible_for_inference(
	context: InferContext,
	expected: SemanticType,
	actual: SemanticType,
) -> Bool:
	type_params = env_get_type_params(context.state.env)
	resolved_expected = infer_resolve_alias(context, expected)
	resolved_actual = infer_resolve_alias(context, actual)
	types_compatible_with_params(type_params, resolved_expected, resolved_actual)


private pure func common_inferred_tuple_type_without_meta(
	context: InferContext,
	left: List[SemanticType],
	right: List[SemanticType],
) -> Option[CheckedType]:
	if left.length() != right.length():
		None
	else:
		var next_context = context
		var elements: List[SemanticType] = []
		var index: Int = 0
		var compatible: Bool = True

		while index < left.length() and compatible:
			match (left.get(index), right.get(index)):
				(Some(left_type), Some(right_type)):
					match common_inferred_type_without_meta(next_context, left_type, right_type):
						Some(common):
							next_context = common.context
							elements = elements.append(common.typ)
						None:
							compatible = False
				_:
					compatible = False

			index += 1

		if compatible:
			Some(checked_type(next_context, SemanticTupleType(elements)))
		else:
			None


private pure func common_inferred_type_without_meta(
	context: InferContext,
	left: SemanticType,
	right: SemanticType,
) -> Option[CheckedType]:
	if types_equal(left, right):
		Some(checked_type(context, left))
	else if types_compatible_for_inference(context, left, right):
		Some(checked_type(context, left))
	else if types_compatible_for_inference(context, right, left):
		Some(checked_type(context, right))
	else:
		match (left, right):
			(SemanticTupleType(left_elements), SemanticTupleType(right_elements)):
				common_inferred_tuple_type_without_meta(context, left_elements, right_elements)
			(SemanticConstIntType(_), SemanticConstIntType(_)):
				Some(checked_type(context, TYPE_INT))
			(SemanticConstIntType(_), SemanticNamedType(name, args)):
				if name == "Int" and args.length() == 0:
					Some(checked_type(context, TYPE_INT))
				else:
					None
			(SemanticNamedType(name, args), SemanticConstIntType(_)):
				if name == "Int" and args.length() == 0:
					Some(checked_type(context, TYPE_INT))
				else:
					None
			_:
				None


private pure func common_inferred_type(
	context: InferContext,
	left: SemanticType,
	right: SemanticType,
) -> Option[CheckedType]:
	if type_contains_meta(left) or type_contains_meta(right):
		resolved_left = infer_resolve_alias(context, left)
		resolved_right = infer_resolve_alias(context, right)

		match unify_symmetric(context.state.context, resolved_left, resolved_right):
			Some(step):
				next_state = { context.state | context = step.context }
				next_context = infer_context_with_state(context, next_state)
				Some(checked_type(next_context, zonk_type(step.context, left)))
			None:
				None
	else:
		common_inferred_type_without_meta(context, left, right)


private pure func type_dict(key_type: SemanticType, value_type: SemanticType) -> SemanticType:
	SemanticNamedType(
		"Dict",
		[key_type, value_type],
	)


private pure func list_element_mismatch_error(
	context: InferContext,
	index: Int,
	expected: SemanticType,
	got: SemanticType,
) -> InferContext:
	infer_error(
		context,
		"List element " + (index + 1).to_string() + " expected " + type_to_string(
			expected,
		) + ", got " + type_to_string(got),
	)


private pure func vector_element_mismatch_error(
	context: InferContext,
	index: Int,
	expected: SemanticType,
	got: SemanticType,
) -> InferContext:
	infer_error(
		context,
		"Tensor element " + (index + 1).to_string() + " expected " + type_to_string(
			expected,
		) + ", got " + type_to_string(got),
	)


private pure func check_vector_expected_count(
	context: InferContext,
	dims: List[SemanticType],
	actual_count: Int,
) -> InferContext:
	match dims.get(0):
		Some(SemanticConstIntType(expected_count)):
			if expected_count == actual_count:
				context
			else:
				infer_error(
					context,
					"Tensor literal expected " + expected_count.to_string() + " elements, got " + actual_count.to_string(),
				)
		_:
			context


private pure func vector_items_all_literal_vectors(items: List[ParsedExpr]) -> Bool:
	var result: Bool = True

	for item in items:
		match item:
			ParsedVectorExpr(_, _):
				void
			_:
				result = False
				break

	result


private pure func check_nested_vector_literal_items(
	context: InferContext,
	items: List[ParsedExpr],
	item_type: SemanticType,
) -> InferContext:
	match array_type_parts(item_type):
		Some((_, dims)):
			if dims.length() > 0 and not vector_items_all_literal_vectors(items):
				infer_error(
					context,
					(
						"Multi-dimensional tensor literals must use nested literal syntax (e.g., {{1,2},"
						+ "{3,4}}). Constructing from tensor variables is not yet supported"
					),
				)
			else:
				context
		None:
			context


private pure func collection_slot_for_target(
	kind: CollectionKind,
	target_type: SemanticType,
	semantic_type: SemanticType,
) -> ValueSlot:
	if types_equal(default_collection_element_type(semantic_type), target_type):
		collection_element_target_slot(kind, target_type, semantic_type)
	else:
		KeptValueSlot(semantic_type)


private pure func infer_list_tail_items(
	context: InferContext,
	items: List[ParsedExpr],
	start_index: Int,
	element_type: SemanticType,
	typed_items: List[TypedExpr],
) -> InferExprListResult:
	var next_context: InferContext = context
	var result_items: List[TypedExpr] = typed_items
	var index: Int = start_index

	while index < items.length():
		match items.get(index):
			Some(item):
				item_result = infer_expr(
					infer_with_canonical_expected_value_slot(
						next_context,
						element_type,
						ExpectedCollectionElementSlot(ListLiteral),
					),
					item,
				)
				item_semantic_type = typed_expr_semantic_type(item_result.expr)
				item_candidate_type = default_collection_element_type(item_semantic_type)
				item_slot = collection_slot_for_target(
					ListLiteral,
					element_type,
					item_semantic_type,
				)
				typed_item = typed_expr_with_slot(item_result.expr, item_slot)
				item_type = typed_expr_value_type(typed_item)

				next_context = if types_compatible_for_inference(
					item_result.context,
					element_type,
					item_type,
				):
					item_result.context
				else:
					list_element_mismatch_error(
						item_result.context,
						index,
						element_type,
						item_candidate_type,
					)

				next_context = check_resource_capability_storage(
					next_context,
					"List literals",
					item_type,
				)
				result_items = result_items.append(typed_item)
			None:
				void

		index += 1

	infer_expr_list_result(infer_without_expected(next_context), result_items)


private pure func infer_list_expr(
	context: InferContext,
	items: List[ParsedExpr],
	span: SourceSpan,
) -> InferResult:
	match expected_list_element_type(context):
		Some(expected_element):
			if items.length() == 0:
				result_context = check_resource_capability_storage(
					context,
					"List literals",
					expected_element,
				)
				list_type = type_list(expected_element)
				typed = TypedListExpr(
					[],
					span,
					inferred_info(result_context, list_type),
				)
				infer_result(result_context, typed)
			else:
				items_result = infer_list_tail_items(context, items, 0, expected_element, [])
				result_context = infer_context_with_state(context, items_result.context.state)
				list_type = type_list(expected_element)
				typed = TypedListExpr(
					items_result.exprs,
					span,
					inferred_info(result_context, list_type),
				)
				infer_result(result_context, typed)
		None:
			if items.length() == 0:
				next = infer_error(context, "Cannot infer element type for empty list literal")
				typed = TypedListExpr(
					[],
					span,
					inferred_info(next, type_list(TYPE_VOID)),
				)
				infer_result(next, typed)
			else:
				match items.get(0):
					Some(first_item):
						first_result = infer_expr(infer_without_expected(context), first_item)
						first_semantic_type = typed_expr_semantic_type(first_result.expr)
						element_type = default_collection_element_type(first_semantic_type)
						first_typed = typed_expr_with_slot(
							first_result.expr,
							collection_slot_for_target(
								ListLiteral,
								element_type,
								first_semantic_type,
							),
						)

						first_context = if types_equal(
							typed_expr_value_type(first_typed),
							element_type,
						):
							first_result.context
						else:
							list_element_mismatch_error(
								first_result.context,
								0,
								element_type,
								typed_expr_value_type(first_typed),
							)

						first_storage_context = check_resource_capability_storage(
							first_context,
							"List literals",
							typed_expr_value_type(first_typed),
						)
						items_result = infer_list_tail_items(
							first_storage_context,
							items,
							1,
							element_type,
							[first_typed],
						)
						result_context = infer_context_with_state(
							context,
							items_result.context.state,
						)
						list_type = type_list(element_type)
						typed = TypedListExpr(
							items_result.exprs,
							span,
							inferred_info(result_context, list_type),
						)
						infer_result(result_context, typed)
					None:
						next = infer_error(
							context,
							"Cannot infer element type for empty list literal",
						)
						typed = TypedListExpr(
							[],
							span,
							inferred_info(next, type_list(TYPE_VOID)),
						)
						infer_result(next, typed)


private pure func infer_vector_tail_items(
	context: InferContext,
	items: List[ParsedExpr],
	start_index: Int,
	item_type: SemanticType,
	typed_items: List[TypedExpr],
) -> InferExprListResult:
	var next_context: InferContext = context
	var result_items: List[TypedExpr] = typed_items
	var index: Int = start_index

	while index < items.length():
		match items.get(index):
			Some(item):
				item_result = infer_expr(
					infer_with_canonical_expected_value_slot(
						next_context,
						item_type,
						ExpectedCollectionElementSlot(VectorLiteral),
					),
					item,
				)
				item_semantic_type = typed_expr_semantic_type(item_result.expr)
				item_candidate_type = default_collection_element_type(item_semantic_type)
				item_slot = collection_slot_for_target(VectorLiteral, item_type, item_semantic_type)
				typed_item = typed_expr_with_slot(item_result.expr, item_slot)
				item_value_type = typed_expr_value_type(typed_item)

				next_context = if types_equal(item_value_type, item_type):
					item_result.context
				else:
					vector_element_mismatch_error(
						item_result.context,
						index,
						item_type,
						item_candidate_type,
					)

				next_context = check_resource_capability_storage(
					next_context,
					"tensor literals",
					item_value_type,
				)
				result_items = result_items.append(typed_item)
			None:
				void

		index += 1

	infer_expr_list_result(infer_without_expected(next_context), result_items)


private pure func array_type_from_item_count(item_type: SemanticType, count: Int) -> SemanticType:
	match array_type_parts(item_type):
		Some((element_type, dims)):
			var result_dims: List[SemanticType] = [SemanticConstIntType(count)]

			for dim in dims:
				result_dims = result_dims.append(dim)

			array_type(element_type, result_dims)
		None:
			array_type(item_type, [SemanticConstIntType(count)])


private pure func infer_vector_expr(
	context: InferContext,
	items: List[ParsedExpr],
	span: SourceSpan,
) -> InferResult:
	match expected_vector_type(context):
		Some((element_type, dims)):
			result_type = array_type(element_type, dims)
			item_type = vector_item_type(element_type, dims)
			count_context = check_vector_expected_count(context, dims, items.length())
			nested_context = check_nested_vector_literal_items(count_context, items, item_type)

			storage_context = if items.length() == 0:
				check_resource_capability_storage(nested_context, "tensor literals", item_type)
			else:
				nested_context

			items_result = infer_vector_tail_items(storage_context, items, 0, item_type, [])
			result_context = infer_context_with_state(context, items_result.context.state)
			typed = TypedVectorExpr(
				items_result.exprs,
				span,
				inferred_info(result_context, result_type),
			)
			infer_result(result_context, typed)
		None:
			if items.length() == 0:
				next = infer_error(context, "Cannot infer type of empty tensor literal")
				typed = TypedVectorExpr(
					[],
					span,
					inferred_info(
						next,
						array_type(TYPE_VOID, [SemanticConstIntType(0)]),
					),
				)
				infer_result(next, typed)
			else:
				match items.get(0):
					Some(first_item):
						first_result = infer_expr(infer_without_expected(context), first_item)
						first_semantic_type = typed_expr_semantic_type(first_result.expr)
						item_type = default_collection_element_type(first_semantic_type)
						first_typed = typed_expr_with_slot(
							first_result.expr,
							collection_slot_for_target(
								VectorLiteral,
								item_type,
								first_semantic_type,
							),
						)

						first_context = if types_equal(
							typed_expr_value_type(first_typed),
							item_type,
						):
							first_result.context
						else:
							vector_element_mismatch_error(
								first_result.context,
								0,
								item_type,
								typed_expr_value_type(first_typed),
							)

						first_storage_context = check_resource_capability_storage(
							first_context,
							"tensor literals",
							typed_expr_value_type(first_typed),
						)
						nested_context = check_nested_vector_literal_items(
							first_storage_context,
							items,
							item_type,
						)
						items_result = infer_vector_tail_items(
							nested_context,
							items,
							1,
							item_type,
							[first_typed],
						)
						result_context = infer_context_with_state(
							context,
							items_result.context.state,
						)
						vector_type = array_type_from_item_count(item_type, items.length())
						typed = TypedVectorExpr(
							items_result.exprs,
							span,
							inferred_info(result_context, vector_type),
						)
						infer_result(result_context, typed)
					None:
						next = infer_error(context, "Cannot infer type of empty tensor literal")
						typed = TypedVectorExpr(
							[],
							span,
							inferred_info(
								next,
								array_type(TYPE_VOID, [SemanticConstIntType(0)]),
							),
						)
						infer_result(next, typed)


private pure func expected_dict_types(
	context: InferContext,
) -> Option[(SemanticType, SemanticType)]:
	match infer_context_expected_type(context):
		Some(expected):
			match expected:
				SemanticNamedType(name, args):
					if name == "Dict" and args.length() == 2:
						match (args.get(0), args.get(1)):
							(Some(key_type), Some(value_type)):
								Some((key_type, value_type))
							_:
								None
					else:
						None
				_:
					None
		None:
			None


private pure func dict_entry_mismatch_error(
	context: InferContext,
	label: String,
	index: Int,
	expected: SemanticType,
	got: SemanticType,
) -> InferContext:
	infer_error(
		context,
		label + " " + (index + 1).to_string() + " expected " + type_to_string(
			expected,
		) + ", got " + type_to_string(got),
	)


private pure func infer_dict_entries(
	context: InferContext,
	entries: List[ParsedDictEntry],
	start_index: Int,
	key_type: SemanticType,
	value_type: SemanticType,
	typed_entries: List[TypedDictEntry],
) -> InferDictEntriesResult:
	var next_context: InferContext = context
	var result_entries: List[TypedDictEntry] = typed_entries
	var index: Int = start_index

	while index < entries.length():
		match entries.get(index):
			Some(entry):
				key_result = infer_expr(infer_without_expected(next_context), entry.key)
				key_semantic_type = typed_expr_semantic_type(key_result.expr)
				key_candidate_type = default_collection_element_type(key_semantic_type)
				typed_key = typed_expr_with_slot(
					key_result.expr,
					collection_slot_for_target(DictLiteral, key_type, key_semantic_type),
				)
				key_value_type = typed_expr_value_type(typed_key)

				key_context = if types_equal(key_value_type, key_type):
					key_result.context
				else:
					dict_entry_mismatch_error(
						key_result.context,
						"Dict literal key",
						index,
						key_type,
						key_candidate_type,
					)

				key_storage_context = check_resource_capability_storage(
					key_context,
					"Dict literals",
					key_value_type,
				)

				value_result = infer_expr(infer_without_expected(key_storage_context), entry.value)
				value_semantic_type = typed_expr_semantic_type(value_result.expr)
				value_candidate_type = default_collection_element_type(value_semantic_type)
				typed_value = typed_expr_with_slot(
					value_result.expr,
					collection_slot_for_target(DictLiteral, value_type, value_semantic_type),
				)
				value_value_type = typed_expr_value_type(typed_value)

				next_context = if types_equal(value_value_type, value_type):
					value_result.context
				else:
					dict_entry_mismatch_error(
						value_result.context,
						"Dict literal value",
						index,
						value_type,
						value_candidate_type,
					)

				next_context = check_resource_capability_storage(
					next_context,
					"Dict literals",
					value_value_type,
				)
				typed_entry: TypedDictEntry = {
					key = typed_key,
					value = typed_value
				}
				result_entries = result_entries.append(typed_entry)
			None:
				void

		index += 1

	{
		context = infer_without_expected(next_context),
		entries = result_entries
	}


private pure func infer_dict_expr(
	context: InferContext,
	entries: List[ParsedDictEntry],
	span: SourceSpan,
) -> InferResult:
	match expected_dict_types(context):
		Some((key_type, value_type)):
			initial_context = if entries.length() == 0:
				key_context = check_resource_capability_storage(context, "Dict literals", key_type)
				check_resource_capability_storage(key_context, "Dict literals", value_type)
			else:
				context

			entries_result = infer_dict_entries(
				initial_context,
				entries,
				0,
				key_type,
				value_type,
				[],
			)
			result_context = infer_context_with_state(context, entries_result.context.state)
			dict_type = type_dict(key_type, value_type)
			typed = TypedDictExpr(
				entries_result.entries,
				span,
				inferred_info(result_context, dict_type),
			)
			infer_result(result_context, typed)
		None:
			if entries.length() == 0:
				next = infer_error(context, "Cannot infer type of empty dict literal")
				typed = TypedDictExpr(
					[],
					span,
					inferred_info(
						next,
						type_dict(TYPE_VOID, TYPE_VOID),
					),
				)
				infer_result(next, typed)
			else:
				match entries.get(0):
					Some(first_entry):
						first_key_result = infer_expr(
							infer_without_expected(context),
							first_entry.key,
						)
						first_key_semantic_type = typed_expr_semantic_type(first_key_result.expr)
						key_type = default_collection_element_type(first_key_semantic_type)
						first_key = typed_expr_with_slot(
							first_key_result.expr,
							collection_slot_for_target(
								DictLiteral,
								key_type,
								first_key_semantic_type,
							),
						)
						first_key_context = check_resource_capability_storage(
							first_key_result.context,
							"Dict literals",
							typed_expr_value_type(first_key),
						)

						first_value_result = infer_expr(
							infer_without_expected(first_key_context),
							first_entry.value,
						)
						first_value_semantic_type = typed_expr_semantic_type(
							first_value_result.expr,
						)
						value_type = default_collection_element_type(first_value_semantic_type)
						first_value = typed_expr_with_slot(
							first_value_result.expr,
							collection_slot_for_target(
								DictLiteral,
								value_type,
								first_value_semantic_type,
							),
						)
						first_context = check_resource_capability_storage(
							first_value_result.context,
							"Dict literals",
							typed_expr_value_type(first_value),
						)
						entries_result = infer_dict_entries(
							first_context,
							entries,
							1,
							key_type,
							value_type,
							[
								{
									key = first_key,
									value = first_value
								},
							],
						)
						result_context = infer_context_with_state(
							context,
							entries_result.context.state,
						)
						dict_type = type_dict(key_type, value_type)
						typed = TypedDictExpr(
							entries_result.entries,
							span,
							inferred_info(result_context, dict_type),
						)
						infer_result(result_context, typed)
					None:
						next = infer_error(context, "Cannot infer type of empty dict literal")
						typed = TypedDictExpr(
							[],
							span,
							inferred_info(
								next,
								type_dict(TYPE_VOID, TYPE_VOID),
							),
						)
						infer_result(next, typed)


private pure func record_subst_for_args(
	type_params: List[String],
	args: List[SemanticType],
) -> List[SemanticTypeSubstEntry]:
	var subst: List[SemanticTypeSubstEntry] = []
	var index: Int = 0

	while index < type_params.length() and index < args.length():
		match (type_params.get(index), args.get(index)):
			(Some(type_param), Some(arg)):
				subst = subst.append(type_subst_entry(type_param, arg))
			_:
				void

		index += 1

	subst


private pure func record_field_types(
	context: InferContext,
	record_name: String,
	args: List[SemanticType],
) -> Option[List[FieldDecl]]:
	record_info = match module_view_accepted_record_type_index(context.state.facts.module_view):
		Some(index):
			record_type_index_find(
				index,
				record_name,
			).map(
				func(entry): (entry.type_params, entry.fields),
			)
		None:
			env_get_record(context.state.env, record_name)

	match record_info:
		Some((type_params, fields)):
			if type_params.length() != args.length():
				None
			else:
				subst = record_subst_for_args(type_params, args)
				Some(fields.map(
					func(
						field: FieldDecl,
					) -> FieldDecl: { field | field_type = apply_subst(subst, field.field_type) },
				))
		None:
			None


private pure func find_record_field(fields: List[FieldDecl], name: String) -> Option[FieldDecl]:
	var result: Option[FieldDecl] = None
	var index: Int = 0

	while index < fields.length() and result.is_none():
		match fields.get(index):
			Some(field):
				if field.name == name:
					result = Some(field)
			None:
				void

		index += 1

	result


private pure func record_field_names(fields: List[FieldDecl]) -> List[String]:
	fields.map(func(field): field.name)


private pure func missing_record_field_names(
	expected_fields: List[FieldDecl],
	actual_fields: List[ParsedRecordExprField],
) -> List[String]:
	provided_names = actual_fields.map(func(field): field.name.text)
	var missing: List[String] = []

	for field in expected_fields:
		if not provided_names.contains(field.name):
			missing = missing.append(field.name)

	missing


private pure func infer_record_fields(
	context: InferContext,
	fields: List[ParsedRecordExprField],
	expected_fields: List[FieldDecl],
) -> InferRecordFieldsResult:
	var next_context: InferContext = context
	var typed_fields: List[TypedRecordField] = []
	var index: Int = 0

	while index < fields.length():
		match fields.get(index):
			Some(field):
				match find_record_field(expected_fields, field.name.text):
					Some(expected_field):
						value_result = infer_expr(
							infer_with_canonical_expected_value_slot(
								next_context,
								expected_field.field_type,
								ExpectedArgumentSlot,
							),
							field.value,
						)
						value_type = typed_expr_value_type(value_result.expr)

						next_context = if types_equal(value_type, expected_field.field_type):
							value_result.context
						else:
							infer_error(
								value_result.context,
								"Record field '" + field.name.text + "': expected " + type_to_string(
									expected_field.field_type,
								) + ", got " + type_to_string(value_type),
							)

						next_context = check_resource_capability_storage(
							next_context,
							"record fields",
							value_type,
						)
						typed_fields = typed_fields.append({
							name = field.name,
							value = value_result.expr,
							span = field.span,
							definition_id = expected_field.definition_id,
						})
					None:
						unknown_context = infer_error(
							next_context,
							"Unknown field '" + field.name.text + "' in record literal. Valid fields: " + record_field_names(
								expected_fields,
							).join(", "),
						)
						value_result = infer_expr(
							infer_without_expected(unknown_context),
							field.value,
						)
						next_context = check_resource_capability_storage(
							value_result.context,
							"record fields",
							typed_expr_value_type(value_result.expr),
						)
						typed_fields = typed_fields.append({
							name = field.name,
							value = value_result.expr,
							span = field.span,
							definition_id = None,
						})
			None:
				void

		index += 1

	{
		context = infer_without_expected(next_context),
		fields = typed_fields
	}


private pure func infer_unconstrained_record_fields(
	context: InferContext,
	fields: List[ParsedRecordExprField],
) -> InferRecordFieldsResult:
	var next_context: InferContext = context
	var typed_fields: List[TypedRecordField] = []
	var index: Int = 0

	while index < fields.length():
		match fields.get(index):
			Some(field):
				value_result = infer_expr(infer_without_expected(next_context), field.value)
				next_context = check_resource_capability_storage(
					value_result.context,
					"record fields",
					typed_expr_value_type(value_result.expr),
				)
				typed_fields = typed_fields.append({
					name = field.name,
					value = value_result.expr,
					span = field.span,
					definition_id = None,
				})
			None:
				void

		index += 1

	{
		context = infer_without_expected(next_context),
		fields = typed_fields
	}


private pure func infer_known_record_expr(
	context: InferContext,
	fields: List[ParsedRecordExprField],
	span: SourceSpan,
	record_type: SemanticType,
	expected_fields: List[FieldDecl],
) -> InferResult:
	fields_result = infer_record_fields(context, fields, expected_fields)
	missing_names = missing_record_field_names(expected_fields, fields)

	missing_context = if missing_names.length() == 0:
		fields_result.context
	else:
		infer_error(
			fields_result.context,
			"Record literal is missing field(s): " + missing_names.join(", "),
		)

	result_context = infer_context_with_state(context, missing_context.state)
	typed = TypedRecordExpr(
		fields_result.fields,
		span,
		inferred_info(result_context, record_type),
	)

	infer_result(result_context, typed)


private pure func record_literal_inference_error(
	context: InferContext,
	fields: List[ParsedRecordExprField],
	span: SourceSpan,
	message: String,
) -> InferResult:
	next = infer_error(context, message)
	fields_result = infer_unconstrained_record_fields(infer_without_expected(next), fields)
	result_context = infer_context_with_state(context, fields_result.context.state)
	typed = TypedRecordExpr(
		fields_result.fields,
		span,
		inferred_info(result_context, TYPE_VOID),
	)

	infer_result(result_context, typed)


private CANNOT_INFER_RECORD_MESSAGE: String = (
	"Cannot infer record type without annotation. Add an explicit record type, e.g. "
	+ "p: Point = {x = 1, y = 2}"
)


private pure func invalid_record_literal_message(
	fields: List[ParsedRecordExprField],
	expected_type: SemanticType,
) -> String:
	if fields.length() == 0:
		"Cannot use {} for type " + type_to_string(expected_type) + ": not a record type"
	else:
		"Cannot use record literal for type " + type_to_string(expected_type)


private pure func infer_record_from_fields(
	context: InferContext,
	fields: List[ParsedRecordExprField],
	span: SourceSpan,
) -> InferResult:
	if fields.length() == 0:
		record_literal_inference_error(context, fields, span, CANNOT_INFER_RECORD_MESSAGE)
	else:
		field_names = fields.map(func(field): field.name.text)

		matches = match module_view_accepted_record_type_index(context.state.facts.module_view):
			Some(index):
				record_type_index_find_names_with_fields(index, field_names)
			None:
				env_find_records_with_fields(context.state.env, field_names)

		if matches.length() == 0:
			record_literal_inference_error(context, fields, span, CANNOT_INFER_RECORD_MESSAGE)
		else if matches.length() == 1:
			match matches.get(0):
				Some(record_name):
					match record_field_types(context, record_name, []):
						Some(expected_fields):
							infer_known_record_expr(
								context,
								fields,
								span,
								SemanticNamedType(record_name, []),
								expected_fields,
							)
						None:
							record_literal_inference_error(
								context,
								fields,
								span,
								"Internal error: matched record type '" + record_name + "' has no field metadata",
							)
				None:
					record_literal_inference_error(
						context,
						fields,
						span,
						CANNOT_INFER_RECORD_MESSAGE,
					)
		else:
			record_literal_inference_error(
				context,
				fields,
				span,
				"Ambiguous record literal: could be " + matches.join(
					" or ",
				) + ". Multiple types share fields {" + field_names.join(", ") + "}",
			)


private pure func expected_empty_record_collection_type(
	context: InferContext,
) -> Option[SemanticType]:
	match infer_context_expected_type(context):
		Some(expected_type):
			match expected_type:
				SemanticNamedType(name, args):
					if (
						name == "Dict" and args.length() == 2
						or name == "Set" and args.length() == 1
					):
						Some(expected_type)
					else:
						None
				_:
					None
		None:
			None


private pure func infer_empty_record_collection_expr(
	context: InferContext,
	collection_type: SemanticType,
	span: SourceSpan,
) -> InferResult:
	container = match collection_type:
		SemanticNamedType("Set", _):
			"Set literals"
		_:
			"Dict literals"

	result_context = check_resource_capability_storage(context, container, collection_type)
	typed = TypedDictExpr(
		[],
		span,
		inferred_info(result_context, collection_type),
	)
	infer_result(result_context, typed)


private pure func infer_record_expr_as_record(
	context: InferContext,
	fields: List[ParsedRecordExprField],
	span: SourceSpan,
) -> InferResult:
	match infer_context_expected_type(context):
		Some(expected_type):
			match expected_type:
				SemanticNamedType(record_name, args):
					match record_field_types(context, record_name, args):
						Some(expected_fields):
							infer_known_record_expr(
								context,
								fields,
								span,
								SemanticNamedType(record_name, args),
								expected_fields,
							)
						None:
							record_literal_inference_error(
								context,
								fields,
								span,
								invalid_record_literal_message(fields, expected_type),
							)
				_:
					record_literal_inference_error(
						context,
						fields,
						span,
						invalid_record_literal_message(fields, expected_type),
					)
		None:
			infer_record_from_fields(context, fields, span)


private pure func infer_record_expr(
	context: InferContext,
	fields: List[ParsedRecordExprField],
	span: SourceSpan,
) -> InferResult:
	if fields.length() == 0:
		match expected_empty_record_collection_type(context):
			Some(collection_type):
				infer_empty_record_collection_expr(context, collection_type, span)
			None:
				infer_record_expr_as_record(context, fields, span)
	else:
		infer_record_expr_as_record(context, fields, span)


private pure func infer_record_update_fields(
	context: InferContext,
	record_name: String,
	fields: List[ParsedRecordExprField],
	expected_fields: List[FieldDecl],
) -> InferRecordFieldsResult:
	var next_context: InferContext = context
	var typed_fields: List[TypedRecordField] = []
	var index: Int = 0

	while index < fields.length():
		match fields.get(index):
			Some(field):
				match find_record_field(expected_fields, field.name.text):
					Some(expected_field):
						value_result = infer_expr(
							infer_with_canonical_expected_value_slot(
								next_context,
								expected_field.field_type,
								ExpectedArgumentSlot,
							),
							field.value,
						)
						value_type = typed_expr_value_type(value_result.expr)

						next_context = if types_equal(value_type, expected_field.field_type):
							value_result.context
						else:
							infer_error(
								value_result.context,
								"Record update field '" + field.name.text + "' type mismatch: expected " + type_to_string(
									expected_field.field_type,
								) + ", got " + type_to_string(value_type),
							)

						next_context = check_resource_capability_storage(
							next_context,
							"record updates",
							value_type,
						)
						typed_fields = typed_fields.append({
							name = field.name,
							value = value_result.expr,
							span = field.span,
							definition_id = expected_field.definition_id,
						})
					None:
						unknown_context = infer_error(
							next_context,
							"Record " + record_name + " has no field '" + field.name.text + "'. Valid fields: " + record_field_names(
								expected_fields,
							).join(", "),
						)
						value_result = infer_expr(
							infer_without_expected(unknown_context),
							field.value,
						)
						next_context = check_resource_capability_storage(
							value_result.context,
							"record updates",
							typed_expr_value_type(value_result.expr),
						)
						typed_fields = typed_fields.append({
							name = field.name,
							value = value_result.expr,
							span = field.span,
							definition_id = None,
						})
			None:
				void

		index += 1

	{
		context = infer_without_expected(next_context),
		fields = typed_fields
	}


private pure func infer_record_update_expr(
	context: InferContext,
	base: ParsedExpr,
	fields: List[ParsedRecordExprField],
	span: SourceSpan,
) -> InferResult:
	base_result = infer_expr(infer_without_expected(context), base)
	base_type = typed_expr_semantic_type(base_result.expr)
	base_context = check_resource_capability_storage(
		base_result.context,
		"record updates",
		base_type,
	)

	match base_type:
		SemanticNamedType(record_name, args):
			match record_field_types(context, record_name, args):
				Some(expected_fields):
					fields_result = infer_record_update_fields(
						base_context,
						record_name,
						fields,
						expected_fields,
					)
					result_context = infer_context_with_state(context, fields_result.context.state)
					typed = TypedRecordUpdateExpr(
						base_result.expr,
						fields_result.fields,
						expected_fields,
						span,
						inferred_info(result_context, base_type),
					)
					infer_result(result_context, typed)
				None:
					next = infer_error(base_context, "Type " + record_name + " is not a record")
					fields_result = infer_unconstrained_record_fields(
						infer_without_expected(next),
						fields,
					)
					result_context = infer_context_with_state(context, fields_result.context.state)
					typed = TypedRecordUpdateExpr(
						base_result.expr,
						fields_result.fields,
						[],
						span,
						inferred_info(result_context, TYPE_VOID),
					)
					infer_result(result_context, typed)
		_:
			next = infer_error(
				base_context,
				"Record update requires a record type, got " + type_to_string(base_type),
			)
			fields_result = infer_unconstrained_record_fields(infer_without_expected(next), fields)
			result_context = infer_context_with_state(context, fields_result.context.state)
			typed = TypedRecordUpdateExpr(
				base_result.expr,
				fields_result.fields,
				[],
				span,
				inferred_info(result_context, TYPE_VOID),
			)
			infer_result(result_context, typed)


private pure func tuple_field_type(
	elements: List[SemanticType],
	field: String,
) -> Option[SemanticType]:
	match field.parse_int():
		Some(index):
			if index >= 0 and index < elements.length():
				elements.get(index)
			else:
				None
		None:
			None


private pure func record_field_access_error(
	context: InferContext,
	typ: SemanticType,
) -> InferContext:
	infer_error(
		context,
		"Cannot access field on type " + type_to_string(typ) + ((
			". Field access is supported on record fields. Use tuple[index] for tuple "
			+ "elements"
		)),
	)


private pure func infer_field_access_expr(
	context: InferContext,
	receiver: ParsedExpr,
	field: ParsedIdentifier,
	span: SourceSpan,
) -> InferResult:
	match infer_qualified_module_field_expr(context, receiver, field, span):
		Some(result):
			result
		None:
			infer_ordinary_field_access_expr(context, receiver, field, span)


private pure func infer_ordinary_field_access_expr(
	context: InferContext,
	receiver: ParsedExpr,
	field: ParsedIdentifier,
	span: SourceSpan,
) -> InferResult:
	receiver_result = infer_expr(infer_without_expected(context), receiver)
	receiver_type = typed_expr_semantic_type(receiver_result.expr)

	match receiver_type:
		SemanticTupleType(elements):
			match tuple_field_type(elements, field.text):
				Some(field_type):
					result_context = infer_context_with_state(
						context,
						receiver_result.context.state,
					)
					typed = TypedFieldAccessExpr(
						receiver_result.expr,
						field,
						span,
						inferred_info(result_context, field_type),
					)
					infer_result(result_context, typed)
				None:
					next = infer_error(receiver_result.context, "Tuple of arity " + elements
							.length()
							.to_string() + " has no field " + field.text)
					typed = TypedFieldAccessExpr(
						receiver_result.expr,
						field,
						span,
						inferred_info(next, TYPE_VOID),
					)
					infer_result(next, typed)
		SemanticNamedType(name, args):
			if name == "Tuple":
				match tuple_field_type(args, field.text):
					Some(field_type):
						result_context = infer_context_with_state(
							context,
							receiver_result.context.state,
						)
						typed = TypedFieldAccessExpr(
							receiver_result.expr,
							field,
							span,
							inferred_info(result_context, field_type),
						)
						infer_result(result_context, typed)
					None:
						next = infer_error(receiver_result.context, "Tuple of arity " + args
								.length()
								.to_string() + " has no field " + field.text)
						typed = TypedFieldAccessExpr(
							receiver_result.expr,
							field,
							span,
							inferred_info(next, TYPE_VOID),
						)
						infer_result(next, typed)
			else:
				match record_field_types(context, name, args):
					Some(fields):
						match find_record_field(fields, field.text):
							Some(field_decl):
								result_context = infer_context_with_state(
									context,
									receiver_result.context.state,
								)
								typed = TypedFieldAccessExpr(
									receiver_result.expr,
									field,
									span,
									{ inferred_info(result_context, field_decl.field_type) |
										resolved_definition_id = field_decl.definition_id
									},
								)
								infer_result(result_context, typed)
							None:
								next = infer_error(
									receiver_result.context,
									"Record " + name + " has no field '" + field.text + "'. Valid fields: " + record_field_names(
										fields,
									).join(", "),
								)
								typed = TypedFieldAccessExpr(
									receiver_result.expr,
									field,
									span,
									inferred_info(next, TYPE_VOID),
								)
								infer_result(next, typed)
					None:
						next = record_field_access_error(receiver_result.context, receiver_type)
						typed = TypedFieldAccessExpr(
							receiver_result.expr,
							field,
							span,
							inferred_info(next, TYPE_VOID),
						)
						infer_result(next, typed)
		_:
			next = record_field_access_error(receiver_result.context, receiver_type)
			typed = TypedFieldAccessExpr(
				receiver_result.expr,
				field,
				span,
				inferred_info(next, TYPE_VOID),
			)
			infer_result(next, typed)


private pure func subscript_static_index(index_expr: ParsedExpr) -> Option[Int]:
	match index_expr:
		ParsedIntLiteralExpr(text, _):
			Some(parse_int_literal(text))
		ParsedUnaryExpr(ParsedNegateOp, ParsedIntLiteralExpr(text, _), _):
			Some(0 - parse_int_literal(text))
		_:
			None


private pure func infer_subscript_indices(
	context: InferContext,
	indices: List[ParsedExpr],
) -> InferSubscriptIndicesResult:
	var next_context: InferContext = context
	var typed_indices: List[SubscriptIndexEvidence] = []
	var index: Int = 0

	while index < indices.length():
		match indices.get(index):
			Some(index_expr):
				index_result = infer_expr(
					infer_with_canonical_expected_value_slot(
						next_context,
						TYPE_INT,
						ExpectedArgumentSlot,
					),
					index_expr,
				)
				index_type = typed_expr_value_type(index_result.expr)

				type_context = if range_endpoint_type_is_int_like(index_type):
					index_result.context
				else:
					infer_error(
						index_result.context,
						"Subscript index must be Int, got " + type_to_string(index_type),
					)

				match subscript_static_index(index_expr):
					Some(value):
						typed_indices = typed_indices.append({
							expr = index_result.expr,
							static_value = Some(value),
						})
						next_context = type_context
					None:
						typed_indices = typed_indices.append({
							expr = index_result.expr,
							static_value = None,
						})
						next_context = type_context
			None:
				void

		index += 1

	{
		context = infer_without_expected(next_context),
		indices = typed_indices
	}


private pure func subscript_single_static_value(
	indices: List[SubscriptIndexEvidence],
) -> Option[Int]:
	match indices.get(0):
		Some(index):
			index.static_value
		None:
			None


private pure func subscript_tuple_result_type(
	elements: List[SemanticType],
	indices: List[SubscriptIndexEvidence],
) -> SemanticType:
	index_value = subscript_single_static_value(indices).get_or(0)

	match elements.get(index_value):
		Some(element):
			element
		None:
			TYPE_VOID


private pure func validate_tuple_subscript(
	context: InferContext,
	elements: List[SemanticType],
	indices: List[SubscriptIndexEvidence],
	index_count: Int,
) -> InferContext:
	if index_count != 1:
		infer_error(
			context,
			"Tuple subscript expects exactly one index, got " + index_count.to_string(),
		)
	else:
		match subscript_single_static_value(indices):
			Some(index_value):
				if index_value < 0 or index_value >= elements.length():
					infer_error(
						context,
						"Tuple index " + index_value.to_string() + " out of bounds for tuple of arity " + elements
							.length()
							.to_string(),
					)
				else:
					context
			None:
				infer_error(
					context,
					(
						"Subscript index must be a compile-time integer literal. Use get() for runtime-"
						+ "checked access"
					),
				)


private pure func array_subscript_result_type(
	element_type: SemanticType,
	dims: List[SemanticType],
	index_count: Int,
) -> SemanticType:
	if index_count == 1:
		vector_item_type(element_type, dims)
	else:
		element_type


private pure func subscript_resolved_index(index_value: Int, size: Int) -> Int:
	if index_value < 0:
		size + index_value
	else:
		index_value


private pure func validate_array_index(
	context: InferContext,
	index_value: Int,
	dim: SemanticType,
) -> InferContext:
	match dim:
		SemanticConstIntType(size):
			resolved_index = subscript_resolved_index(index_value, size)

			if resolved_index < 0:
				infer_error(
					context,
					"Negative index " + index_value.to_string() + " out of bounds for dimension of size " + size.to_string() + " (resolves to " + resolved_index.to_string() + ")",
				)
			else if resolved_index >= size:
				infer_error(
					context,
					"Index " + index_value.to_string() + " out of bounds for dimension of size " + size.to_string(),
				)
			else:
				context
		_:
			fits = match dim_minimum_size(dim):
				Some(minimum_size):
					if index_value < 0:
						minimum_size + index_value >= 0
					else:
						index_value < minimum_size
				None:
					False

			if fits:
				context
			else:
				infer_error(context, "Cannot verify bounds: dimension is not known at compile time")


private pure func dim_minimum_size(dim: SemanticType) -> Option[Int]:
	match normalize_dim(dim):
		SemanticConstIntType(value):
			Some(value)
		SemanticTypeVar(name):
			if is_dim_var_name(name):
				Some(1)
			else:
				None
		SemanticNamedType(name, args):
			if args.length() == 0 and is_dim_var_name(name):
				Some(1)
			else:
				None
		SemanticDimOpType(op, left, right):
			left_minimum ?= dim_minimum_size(left)
			right_minimum ?= dim_minimum_size(right)

			match op:
				SemanticDimAdd:
					Some(add_saturating(left_minimum, right_minimum))
				SemanticDimMultiply:
					if left_minimum >= 0 and right_minimum >= 0:
						Some(multiply_saturating(left_minimum, right_minimum))
					else:
						None
				_:
					None
		_:
			None


private pure func range_bound_fits_dim(bound: SemanticType, dim: SemanticType) -> Bool:
	match (bound, dim):
		(SemanticConstIntType(bound_size), SemanticConstIntType(dim_size)):
			bound_size <= dim_size
		(SemanticTypeVar(bound_name), SemanticTypeVar(dim_name)):
			is_dim_var_name(bound_name) and is_dim_var_name(dim_name) and bound_name == dim_name
		_:
			types_equal(bound, dim)


private pure func expr_range_bound(expr: TypedExpr) -> Option[SemanticType]:
	match typed_expr_semantic_type(expr):
		SemanticRangeType(bound):
			Some(bound)
		_:
			None


private pure func flattened_index_term(expr: TypedExpr) -> Option[(SemanticType, SemanticType)]:
	match expr:
		TypedBinaryExpr(ParsedMultiplyOp, left, right, _, _):
			match (expr_range_bound(left), static_dim_from_typed_expr(right)):
				(Some(outer_bound), Some(stride)):
					Some((outer_bound, stride))
				_:
					match (expr_range_bound(right), static_dim_from_typed_expr(left)):
						(Some(outer_bound), Some(stride)):
							Some((outer_bound, stride))
						_:
							None
		_:
			None


private pure func flattened_index_term_fits_dim(
	term: TypedExpr,
	offset: TypedExpr,
	dim: SemanticType,
) -> Bool:
	match (flattened_index_term(term), expr_range_bound(offset)):
		(Some((outer_bound, stride)), Some(offset_bound)):
			normalized_stride = normalize_dim(stride)
			normalized_offset_bound = normalize_dim(offset_bound)
			normalized_dim = normalize_dim(dim)
			expected_dim = normalize_dim(
				SemanticDimOpType(
					SemanticDimMultiply,
					outer_bound,
					normalized_stride,
				),
			)

			(
				types_equal(normalized_stride, normalized_offset_bound)
				and types_equal(expected_dim, normalized_dim)
			)
		_:
			False


private pure func flattened_index_fits_dim(expr: TypedExpr, dim: SemanticType) -> Bool:
	match expr:
		TypedBinaryExpr(ParsedAddOp, left, right, _, _):
			(
				flattened_index_term_fits_dim(left, right, dim)
				or flattened_index_term_fits_dim(right, left, dim)
			)
		_:
			False


private pure func subscript_constant_bounds(dim: SemanticType) -> List[SubscriptBound]:
	match normalize_dim(dim):
		SemanticConstIntType(size):
			match constant_dim_bound(size):
				Some(bound):
					[bound]
				None:
					[]
		_:
			[]


private pure func index_binding_offset(expr: TypedExpr) -> Option[(String, Int)]:
	match expr:
		TypedNameExpr(name, _):
			Some((name.text, 0))
		TypedBinaryExpr(op, left, right, _, _):
			right_offset: Option[Int] = match right:
				TypedIntLiteralExpr(text, _, _):
					text.parse_int()
				_:
					None

			match (op, left, right_offset):
				(ParsedAddOp, TypedNameExpr(name, _), Some(offset)):
					Some((name.text, offset))
				(ParsedSubtractOp, TypedNameExpr(name, _), Some(offset)):
					Some((name.text, -offset))
				_:
					None
		_:
			None


private pure func index_binding_proof(
	context: InferContext,
	index_expr: TypedExpr,
	dim: SemanticType,
) -> Option[OffsetSubscriptProof]:
	match index_binding_offset(index_expr):
		Some((name, offset)):
			match env_get_var_refinement(context.state.env, name):
				Some(refinement):
					Some(
						binding_proves_offset_range(
							refinement,
							subscript_constant_bounds(dim),
							offset,
						),
					)
				None:
					None
		None:
			None


private pure func validate_array_range_index(
	context: InferContext,
	index_expr: TypedExpr,
	dim: SemanticType,
) -> InferContext:
	index_type = typed_expr_semantic_type(index_expr)

	match index_type:
		SemanticRangeType(bound):
			if range_bound_fits_dim(bound, dim):
				context
			else:
				infer_error(
					context,
					"Range-refined index " + type_to_string(
						index_type,
					) + " is not proven in bounds for dimension " + type_to_string(dim),
				)
		_:
			match index_binding_proof(context, index_expr, dim):
				Some(OffsetProven):
					context
				Some(OffsetRejected(OffsetOutOfBounds(message))):
					infer_error(context, "Loop offset is out of bounds: " + message)
				_:
					if flattened_index_fits_dim(index_expr, dim):
						context
					else:
						index_location: String = match index_expr:
							TypedNameExpr(name, _):
								" at " + source_span_label(name.span)
							_:
								""

						infer_error(
							context,
							(
								"Subscript index must be a compile-time integer literal. Use get() for runtime-"
								+ "checked access"
							) + index_location,
						)


private pure func typed_name_text(expr: TypedExpr) -> Option[String]:
	match expr:
		TypedNameExpr(name, _):
			Some(name.text)
		_:
			None


private pure func positive_modulo_bound(expr: TypedExpr) -> Option[Int]:
	match typed_expr_semantic_type(expr):
		SemanticConstIntType(value):
			if value > 0:
				Some(value)
			else:
				None
		_:
			None


private pure func length_call_receiver_name(expr: TypedExpr) -> Option[String]:
	match expr:
		TypedCallExpr(callee, args, _, _):
			match typed_name_text(callee):
				Some(name):
					if name == "length" or name == "vector_length":
						match args.get(0):
							Some(receiver):
								typed_name_text(receiver)
							None:
								None
					else:
						None
				None:
					None
		_:
			None


private pure func safe_subscript_modulo(
	context: InferContext,
	left: TypedExpr,
	right: TypedExpr,
	span: SourceSpan,
	bound: SemanticType,
) -> TypedExpr:
	int_info = inferred_info(infer_without_expected(context), TYPE_INT)
	inner_mod = TypedBinaryExpr(ParsedModuloOp, left, right, span, int_info)
	add_bound = TypedBinaryExpr(ParsedAddOp, inner_mod, right, span, int_info)

	TypedBinaryExpr(
		ParsedModuloOp,
		add_bound,
		right,
		span,
		inferred_info(infer_without_expected(context), SemanticRangeType(bound)),
	)


private pure func subscript_modulo_error(
	context: InferContext,
	index: TypedExpr,
	message: String,
) -> ValidatedSubscriptIndex:
	{
		context = infer_error(context, message),
		index = index
	}


private pure func validate_dynamic_array_index(
	context: InferContext,
	receiver: TypedExpr,
	index: TypedExpr,
	dim: SemanticType,
) -> ValidatedSubscriptIndex:
	match index:
		TypedBinaryExpr(ParsedModuloOp, left, right, span, _):
			match (positive_modulo_bound(right), dim):
				(Some(bound), SemanticConstIntType(size)):
					if bound <= size:
						{
							context = context,
							index = safe_subscript_modulo(
								context,
								left,
								right,
								span,
								SemanticConstIntType(bound),
							)
						}
					else:
						subscript_modulo_error(
							context,
							index,
							"Modulo bound ${bound} exceeds dimension of size ${size}",
						)
				_:
					uses_receiver_length: Bool = match (
						typed_name_text(receiver),
						length_call_receiver_name(right),
					):
						(Some(receiver_name), Some(length_receiver_name)):
							receiver_name == length_receiver_name
						_:
							False

					if uses_receiver_length:
						{
							context = context,
							index = safe_subscript_modulo(context, left, right, span, dim)
						}
					else:
						subscript_modulo_error(
							context,
							index,
							(
								"Subscript modulo requires a positive compile-time integer literal or length(v). "
								+ "Use get() for runtime-checked access"
							),
						)
		_:
			{
				context = validate_array_range_index(context, index, dim),
				index = index
			}


private pure func normalized_static_array_index(
	context: InferContext,
	index: TypedExpr,
	index_value: Int,
	dim: SemanticType,
	span: SourceSpan,
) -> TypedExpr:
	if index_value >= 0:
		index
	else:
		match dim:
			SemanticConstIntType(size):
				resolved_index = subscript_resolved_index(index_value, size)

				if resolved_index >= 0 and resolved_index < size:
					TypedIntLiteralExpr(
						resolved_index.to_string(),
						span,
						inferred_info(infer_without_expected(context), TYPE_INT),
					)
				else:
					index
			_:
				-- Checked runtime operations know the size of each symbolic axis and
				-- can normalize it without evaluating the receiver more than once.
				index


private pure func validate_array_subscript_indices(
	context: InferContext,
	receiver: TypedExpr,
	dims: List[SemanticType],
	indices: List[SubscriptIndexEvidence],
	span: SourceSpan,
) -> ValidatedSubscriptIndices:
	var next_context: InferContext = context
	var validated_indices: List[TypedExpr] = []
	var index: Int = 0

	while index < indices.length() and index < dims.length():
		match (indices.get(index), dims.get(index)):
			(Some(index_evidence), Some(dim)):
				match index_evidence.static_value:
					Some(index_value):
						next_context = validate_array_index(next_context, index_value, dim)
						validated_indices = validated_indices.append(
							normalized_static_array_index(
								next_context,
								index_evidence.expr,
								index_value,
								dim,
								span,
							),
						)
					None:
						validated = validate_dynamic_array_index(
							next_context,
							receiver,
							index_evidence.expr,
							dim,
						)
						next_context = validated.context
						validated_indices = validated_indices.append(validated.index)
			_:
				void

		index += 1

	{
		context = next_context,
		indices = validated_indices
	}


private pure func validate_array_subscript(
	context: InferContext,
	receiver: TypedExpr,
	dims: List[SemanticType],
	indices: List[SubscriptIndexEvidence],
	index_count: Int,
	span: SourceSpan,
) -> ValidatedSubscriptIndices:
	if dims.length() == 0:
		{
			context = infer_error(
				context,
				"checked_get requires an array type, got empty dimensions",
			),
			indices = indices.map(func(index): index.expr)
		}
	else if index_count == 1 or index_count == dims.length():
		validate_array_subscript_indices(context, receiver, dims, indices, span)
	else:
		{
			context = infer_error(
				context,
				"Multi-index subscript has " + index_count.to_string() + " indices but array has " + dims
					.length()
					.to_string() + " dimensions",
			),
			indices = indices.map(func(index): index.expr)
		}


private pure func non_array_subscript_error(
	context: InferContext,
	typ: SemanticType,
	index_count: Int,
) -> InferContext:
	match typ:
		SemanticNamedType(name, _):
			if name == "List":
				infer_error(
					context,
					(
						"checked_get is not supported on List. Use get(list, index) for bounds-checked "
						+ "access"
					),
				)
			else if name == "String":
				infer_error(
					context,
					(
						"checked_get is not supported on String. Use get(str, index) for bounds-checked "
						+ "access"
					),
				)
			else if index_count == 1:
				infer_error(
					context,
					"checked_get requires an array type, got " + type_to_string(typ),
				)
			else:
				infer_error(
					context,
					"Type " + type_to_string(typ) + ((
						" does not support multi-index subscript. Multi-index subscript is supported on "
						+ "array types"
					)),
				)
		_:
			if index_count == 1:
				infer_error(
					context,
					"checked_get requires an array type, got " + type_to_string(typ),
				)
			else:
				infer_error(
					context,
					"Type " + type_to_string(typ) + ((
						" does not support multi-index subscript. Multi-index subscript is supported on "
						+ "array types"
					)),
				)


private pure func subscript_type_if_no_errors(
	context: InferContext,
	original_error_count: Int,
	typ: SemanticType,
) -> SemanticType:
	if context.state.errors.length() == original_error_count:
		typ
	else:
		TYPE_VOID


private pure func infer_subscript_result(
	context: InferContext,
	next_context: InferContext,
	receiver: TypedExpr,
	indices: List[TypedExpr],
	span: SourceSpan,
	result_type: SemanticType,
) -> InferResult:
	result_context = infer_context_with_state(context, next_context.state)
	typed = TypedSubscriptExpr(
		receiver,
		indices,
		span,
		inferred_info(result_context, result_type),
	)
	infer_result(result_context, typed)


private pure func infer_tuple_subscript_result(
	context: InferContext,
	receiver: TypedExpr,
	index_result: InferSubscriptIndicesResult,
	elements: List[SemanticType],
	index_count: Int,
	span: SourceSpan,
	original_error_count: Int,
) -> InferResult:
	next_context = validate_tuple_subscript(
		index_result.context,
		elements,
		index_result.indices,
		index_count,
	)
	result_type = subscript_type_if_no_errors(
		next_context,
		original_error_count,
		subscript_tuple_result_type(elements, index_result.indices),
	)
	infer_subscript_result(
		context,
		next_context,
		receiver,
		index_result.indices.map(func(index): index.expr),
		span,
		result_type,
	)


private pure func infer_array_subscript_result(
	context: InferContext,
	receiver: TypedExpr,
	index_result: InferSubscriptIndicesResult,
	element_type: SemanticType,
	dims: List[SemanticType],
	index_count: Int,
	span: SourceSpan,
	original_error_count: Int,
) -> InferResult:
	validated = validate_array_subscript(
		index_result.context,
		receiver,
		dims,
		index_result.indices,
		index_count,
		span,
	)
	result_type = subscript_type_if_no_errors(
		validated.context,
		original_error_count,
		array_subscript_result_type(element_type, dims, index_count),
	)
	infer_subscript_result(
		context,
		validated.context,
		receiver,
		validated.indices,
		span,
		result_type,
	)


private pure func infer_unsupported_subscript_result(
	context: InferContext,
	receiver: TypedExpr,
	index_result: InferSubscriptIndicesResult,
	receiver_type: SemanticType,
	index_count: Int,
	span: SourceSpan,
) -> InferResult:
	next_context = non_array_subscript_error(index_result.context, receiver_type, index_count)
	infer_subscript_result(
		context,
		next_context,
		receiver,
		index_result.indices.map(func(index): index.expr),
		span,
		TYPE_VOID,
	)


private pure func infer_subscript_expr(
	context: InferContext,
	receiver: ParsedExpr,
	indices: List[ParsedExpr],
	span: SourceSpan,
) -> InferResult:
	original_error_count = context.state.errors.length()
	receiver_result = infer_expr(infer_without_expected(context), receiver)
	index_result = infer_subscript_indices(receiver_result.context, indices)
	receiver_type = typed_expr_semantic_type(receiver_result.expr)
	index_count = indices.length()

	match receiver_type:
		SemanticTupleType(elements):
			infer_tuple_subscript_result(
				context,
				receiver_result.expr,
				index_result,
				elements,
				index_count,
				span,
				original_error_count,
			)
		SemanticNamedType(name, args):
			if name == "Tuple":
				infer_tuple_subscript_result(
					context,
					receiver_result.expr,
					index_result,
					args,
					index_count,
					span,
					original_error_count,
				)
			else:
				match array_type_parts(receiver_type):
					Some((element_type, dims)):
						infer_array_subscript_result(
							context,
							receiver_result.expr,
							index_result,
							element_type,
							dims,
							index_count,
							span,
							original_error_count,
						)
					None:
						infer_unsupported_subscript_result(
							context,
							receiver_result.expr,
							index_result,
							receiver_type,
							index_count,
							span,
						)
		_:
			match array_type_parts(receiver_type):
				Some((element_type, dims)):
					infer_array_subscript_result(
						context,
						receiver_result.expr,
						index_result,
						element_type,
						dims,
						index_count,
						span,
						original_error_count,
					)
				None:
					infer_unsupported_subscript_result(
						context,
						receiver_result.expr,
						index_result,
						receiver_type,
						index_count,
						span,
					)


private pure func builtin_resolved_call(
	name: String,
	params: List[SemanticType],
	return_type: SemanticType,
) -> ResolvedCallInfo:
	{
		callee_name = name,
		source_name = name,
		purity = Pure,
		target = ResolvedIntrinsicCall,
		instantiated_params = params,
		instantiated_return = return_type,
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}


private pure func typed_builtin_callee(
	name: String,
	params: List[SemanticType],
	return_type: SemanticType,
	span: SourceSpan,
	resolved_call: ResolvedCallInfo,
) -> TypedExpr:
	func_type = SemanticFunctionType(True, params, return_type)

	TypedNameExpr(
		parsed_identifier(name, span),
		typed_expr_info_from_slot(
			None,
			InferredOrigin,
			UNREFINED_BINDING,
			Some(resolved_call),
			KeptValueSlot(func_type),
		),
	)


private pure func assert_shape_error(
	context: InferContext,
	message: String,
	span: SourceSpan,
	recovery_inner_type: SemanticType,
) -> InferResult:
	next = infer_error(context, message)
	recovery_type = SemanticNamedType("Option", [recovery_inner_type])
	infer_result(
		next,
		TypedMissingExpr(
			span,
			inferred_info(next, recovery_type),
		),
	)


private pure func assert_shape_result(
	context: InferContext,
	receiver: TypedExpr,
	length: TypedExpr,
	element_type: SemanticType,
	expected_length: Int,
	span: SourceSpan,
) -> InferResult:
	receiver_type = typed_expr_semantic_type(receiver)
	result_inner = SemanticArrayType(element_type, [SemanticConstIntType(expected_length)])
	result_type = SemanticNamedType("Option", [result_inner])
	params = [receiver_type, TYPE_INT]
	resolved_call = builtin_resolved_call("assert_shape", params, result_type)
	callee = typed_builtin_callee("assert_shape", params, result_type, span, resolved_call)
	typed = TypedCallExpr(
		callee,
		[receiver, length],
		span,
		inferred_call_info(
			context,
			result_type,
			Some(resolved_call),
		),
	)

	infer_result(context, typed)


private pure func assert_shape_dims_refinable(dims: List[SemanticType]) -> Bool:
	match dims:
		[SemanticVarDimsType(_)]:
			True
		[SemanticTypeVar(_)]:
			True
		_:
			False


private pure func infer_assert_shape_call(
	context: InferContext,
	args: List[ParsedExpr],
	span: SourceSpan,
) -> InferResult:
	if args.length() != 2:
		assert_shape_error(
			context,
			"assert_shape takes exactly 2 arguments: (tensor, expected_length: Int)",
			span,
			TYPE_VOID,
		)
	else:
		receiver_result = infer_expr(
			infer_without_expected(context),
			args.get_or(0, ParsedMissingExpr(span)),
		)
		length_result = infer_expr(
			infer_with_canonical_expected_value_slot(
				receiver_result.context,
				TYPE_INT,
				ExpectedArgumentSlot,
			),
			args.get_or(1, ParsedMissingExpr(span)),
		)
		result_context = infer_context_with_state(context, length_result.context.state)
		receiver_type = typed_expr_semantic_type(receiver_result.expr)

		match array_type_parts(receiver_type):
			Some((element_type, dims)):
				if not assert_shape_dims_refinable(dims):
					assert_shape_error(
						result_context,
						"assert_shape requires a variadic-dimension tensor (T[#Ds...]) as first argument",
						span,
						receiver_type,
					)
				else:
					match typed_expr_semantic_type(length_result.expr):
						SemanticConstIntType(expected_length):
							if expected_length > 0:
								assert_shape_result(
									result_context,
									receiver_result.expr,
									length_result.expr,
									element_type,
									expected_length,
									span,
								)
							else:
								assert_shape_error(
									result_context,
									(
										"assert_shape requires a positive compile-time integer literal as the expected "
										+ "length"
									),
									span,
									receiver_type,
								)
						_:
							assert_shape_error(
								result_context,
								(
									"assert_shape requires a positive compile-time integer literal as the expected "
									+ "length"
								),
								span,
								receiver_type,
							)
			None:
				assert_shape_error(
					result_context,
					"assert_shape requires an array type as first argument",
					span,
					receiver_type,
				)


private pure func checked_get_builtin_result(
	context: InferContext,
	next_context: InferContext,
	callee_name: String,
	receiver: TypedExpr,
	index: TypedExpr,
	receiver_type: SemanticType,
	result_type: SemanticType,
	span: SourceSpan,
) -> InferResult:
	result_context = infer_context_with_state(context, next_context.state)
	params: List[SemanticType] = [receiver_type, TYPE_INT]
	resolved_call = builtin_resolved_call(callee_name, params, result_type)
	callee = typed_builtin_callee(callee_name, params, result_type, span, resolved_call)
	typed = TypedCallExpr(
		callee,
		[receiver, index],
		span,
		inferred_call_info(
			result_context,
			result_type,
			Some(resolved_call),
		),
	)

	infer_result(result_context, typed)


private pure func checked_get_tuple_result(
	context: InferContext,
	receiver: TypedExpr,
	index_result: InferSubscriptIndicesResult,
	elements: List[SemanticType],
	span: SourceSpan,
	original_error_count: Int,
) -> InferResult:
	next_context = validate_tuple_subscript(index_result.context, elements, index_result.indices, 1)
	result_type = subscript_type_if_no_errors(
		next_context,
		original_error_count,
		subscript_tuple_result_type(elements, index_result.indices),
	)
	index_value = subscript_single_static_value(index_result.indices).get_or(0)
	result_context = infer_context_with_state(context, next_context.state)
	typed = TypedFieldAccessExpr(
		receiver,
		parsed_identifier(index_value.to_string(), span),
		span,
		inferred_info(result_context, result_type),
	)

	infer_result(result_context, typed)


private pure func checked_get_array_result(
	context: InferContext,
	receiver: TypedExpr,
	index_result: InferSubscriptIndicesResult,
	element_type: SemanticType,
	dims: List[SemanticType],
	span: SourceSpan,
	original_error_count: Int,
) -> InferResult:
	validated = validate_array_subscript(
		index_result.context,
		receiver,
		dims,
		index_result.indices,
		1,
		span,
	)
	result_type = subscript_type_if_no_errors(
		validated.context,
		original_error_count,
		array_subscript_result_type(element_type, dims, 1),
	)
	receiver_type = typed_expr_semantic_type(receiver)
	index = validated.indices.get_or(
		0,
		TypedMissingExpr(
			span,
			inferred_info(validated.context, TYPE_INT),
		),
	)

	callee_name: String = if dims.length() > 1:
		"tensor_peel"
	else:
		"checked_get"

	checked_get_builtin_result(
		context,
		validated.context,
		callee_name,
		receiver,
		index,
		receiver_type,
		result_type,
		span,
	)


private pure func checked_get_unsupported_result(
	context: InferContext,
	receiver: TypedExpr,
	index_result: InferSubscriptIndicesResult,
	receiver_type: SemanticType,
	span: SourceSpan,
) -> InferResult:
	next_context = non_array_subscript_error(index_result.context, receiver_type, 1)
	index = index_result.indices
		.map(func(index): index.expr)
		.get_or(
			0,
			TypedMissingExpr(
				span,
				inferred_info(next_context, TYPE_INT),
			),
		)

	checked_get_builtin_result(
		context,
		next_context,
		"checked_get",
		receiver,
		index,
		receiver_type,
		TYPE_VOID,
		span,
	)


private pure func infer_checked_get_call(
	context: InferContext,
	args: List[ParsedExpr],
	span: SourceSpan,
) -> InferResult:
	if args.length() != 2:
		next = infer_error(context, "checked_get takes exactly 2 arguments: (tensor, index: Int)")
		missing = TypedMissingExpr(
			span,
			inferred_info(next, TYPE_VOID),
		)
		infer_result(next, missing)
	else:
		original_error_count = context.state.errors.length()
		receiver_arg = args.get_or(0, ParsedMissingExpr(span))
		index_arg = args.get_or(1, ParsedMissingExpr(span))
		receiver_result = infer_expr(infer_without_expected(context), receiver_arg)
		index_result = infer_subscript_indices(receiver_result.context, [index_arg])
		receiver_type = typed_expr_semantic_type(receiver_result.expr)

		match receiver_type:
			SemanticTupleType(elements):
				checked_get_tuple_result(
					context,
					receiver_result.expr,
					index_result,
					elements,
					span,
					original_error_count,
				)
			SemanticNamedType(name, type_args):
				if name == "Tuple":
					checked_get_tuple_result(
						context,
						receiver_result.expr,
						index_result,
						type_args,
						span,
						original_error_count,
					)
				else:
					match array_type_parts(receiver_type):
						Some((element_type, dims)):
							checked_get_array_result(
								context,
								receiver_result.expr,
								index_result,
								element_type,
								dims,
								span,
								original_error_count,
							)
						None:
							checked_get_unsupported_result(
								context,
								receiver_result.expr,
								index_result,
								receiver_type,
								span,
							)
			_:
				match array_type_parts(receiver_type):
					Some((element_type, dims)):
						checked_get_array_result(
							context,
							receiver_result.expr,
							index_result,
							element_type,
							dims,
							span,
							original_error_count,
						)
					None:
						checked_get_unsupported_result(
							context,
							receiver_result.expr,
							index_result,
							receiver_type,
							span,
						)


private pure func nd_checked_get_result(
	name: String,
	result: InferResult,
	span: SourceSpan,
) -> InferResult:
	match result.expr:
		TypedSubscriptExpr(receiver, indices, _, _):
			receiver_type = typed_expr_semantic_type(receiver)
			result_type = typed_expr_semantic_type(result.expr)
			params = [receiver_type].concat(indices.map(
				func(_): TYPE_INT,
			))
			resolved_call = builtin_resolved_call(name, params, result_type)
			callee = typed_builtin_callee(name, params, result_type, span, resolved_call)
			typed = TypedCallExpr(
				callee,
				[receiver].concat(indices),
				span,
				inferred_call_info(result.context, result_type, Some(resolved_call)),
			)
			infer_result(result.context, typed)
		_:
			result


private pure func infer_nd_checked_get_call(
	context: InferContext,
	name: String,
	index_count: Int,
	args: List[ParsedExpr],
	span: SourceSpan,
) -> InferResult:
	if args.length() != index_count + 1:
		next = infer_error(context, "${name} takes ${index_count + 1} arguments")
		missing = TypedMissingExpr(
			span,
			inferred_info(next, TYPE_VOID),
		)
		infer_result(next, missing)
	else:
		receiver = args.get_or(0, ParsedMissingExpr(span))
		parsed_indices: List[ParsedExpr] = parsed_args_after_first(args)
		nd_checked_get_result(
			name,
			infer_subscript_expr(context, receiver, parsed_indices, span),
			span,
		)


private pure func checked_slice_error(
	context: InferContext,
	message: String,
	span: SourceSpan,
) -> InferResult:
	next = infer_error(context, message)
	infer_result(
		next,
		TypedMissingExpr(
			span,
			inferred_info(next, TYPE_VOID),
		),
	)


private pure func typed_static_int(expr: TypedExpr) -> Option[Int]:
	match typed_expr_semantic_type(expr):
		SemanticConstIntType(value):
			Some(value)
		_:
			None


private pure func checked_slice_result(
	context: InferContext,
	receiver: TypedExpr,
	start: TypedExpr,
	end: TypedExpr,
	element_type: SemanticType,
	array_size: Int,
	span: SourceSpan,
) -> InferResult:
	match (typed_static_int(start), typed_static_int(end)):
		(Some(start_value), Some(end_value)):
			if start_value < 0:
				checked_slice_error(context, "Slice start ${start_value} is negative", span)
			else if end_value > array_size:
				checked_slice_error(
					context,
					"Slice end ${end_value} out of bounds for Tensor of size ${array_size}",
					span,
				)
			else if start_value >= end_value:
				checked_slice_error(
					context,
					"Slice start ${start_value} must be less than end ${end_value}",
					span,
				)
			else:
				receiver_type = typed_expr_semantic_type(receiver)
				result_type = SemanticArrayType(
					element_type,
					[SemanticConstIntType(end_value - start_value)],
				)
				params = [receiver_type, TYPE_INT, TYPE_INT]
				resolved_call = builtin_resolved_call("checked_slice", params, result_type)
				callee = typed_builtin_callee(
					"checked_slice",
					params,
					result_type,
					span,
					resolved_call,
				)
				typed = TypedCallExpr(
					callee,
					[receiver, start, end],
					span,
					inferred_call_info(
						context,
						result_type,
						Some(resolved_call),
					),
				)
				infer_result(context, typed)
		_:
			checked_slice_error(
				context,
				"checked_slice requires compile-time integer literal start and end",
				span,
			)


private pure func infer_checked_slice_call(
	context: InferContext,
	args: List[ParsedExpr],
	span: SourceSpan,
) -> InferResult:
	if args.length() != 3:
		checked_slice_error(
			context,
			"checked_slice takes exactly 3 arguments: (tensor, start: Int, end: Int)",
			span,
		)
	else:
		receiver_result = infer_expr(
			infer_without_expected(context),
			args.get_or(0, ParsedMissingExpr(span)),
		)
		start_result = infer_expr(
			infer_with_canonical_expected_value_slot(
				receiver_result.context,
				TYPE_INT,
				ExpectedArgumentSlot,
			),
			args.get_or(1, ParsedMissingExpr(span)),
		)
		end_result = infer_expr(
			infer_with_canonical_expected_value_slot(
				start_result.context,
				TYPE_INT,
				ExpectedArgumentSlot,
			),
			args.get_or(2, ParsedMissingExpr(span)),
		)
		receiver_type = typed_expr_semantic_type(receiver_result.expr)

		match array_type_parts(receiver_type):
			Some((element_type, dims)):
				if dims.length() != 1:
					checked_slice_error(
						end_result.context,
						"checked_slice is only supported on 1D arrays",
						span,
					)
				else:
					match dims.get(0):
						Some(SemanticConstIntType(array_size)):
							checked_slice_result(
								end_result.context,
								receiver_result.expr,
								start_result.expr,
								end_result.expr,
								element_type,
								array_size,
								span,
							)
						_:
							checked_slice_error(
								end_result.context,
								"Cannot verify slice bounds: dimension is not known at compile time",
								span,
							)
			None:
				checked_slice_error(
					end_result.context,
					"checked_slice requires a 1D array, got " + type_to_string(receiver_type),
					span,
				)


private pure func checked_set_error(
	context: InferContext,
	message: String,
	span: SourceSpan,
) -> InferResult:
	next = infer_error(context, message)
	infer_result(
		next,
		TypedMissingExpr(
			span,
			inferred_info(next, TYPE_VOID),
		),
	)


private pure func infer_checked_set_call(
	context: InferContext,
	name: String,
	index_count: Int,
	args: List[ParsedExpr],
	span: SourceSpan,
) -> InferResult:
	if args.length() != index_count + 2:
		checked_set_error(context, "${name} takes ${index_count + 2} arguments", span)
	else:
		target_result = infer_expr(
			infer_without_expected(context),
			args.get_or(0, ParsedMissingExpr(span)),
		)
		parsed_indices = args
			.drop(1)
			.take(index_count)
		index_result = infer_subscript_indices(target_result.context, parsed_indices)
		target_type = typed_expr_semantic_type(target_result.expr)

		match array_type_parts(target_type):
			Some((element_type, dims)):
				validated = validate_array_subscript_assignment(
					index_result.context,
					target_result.expr,
					dims,
					index_result.indices,
					index_count,
					span,
				)
				value_result = infer_subscript_assignment_value(
					validated.context,
					Some(element_type),
					args.get_or(index_count + 1, ParsedMissingExpr(span)),
				)
				value_type = typed_expr_value_type(value_result.expr)

				next_context = match assignable_context(
					value_result.context,
					element_type,
					value_type,
				):
					Some(assignable_context):
						assignable_context
					None:
						subscript_assignment_value_mismatch_error(
							value_result.context,
							element_type,
							value_type,
						)

				result_context = infer_context_with_state(context, next_context.state)
				set_call = checked_set_call(
					result_context,
					target_result.expr,
					validated.indices,
					value_result.expr,
					target_type,
					element_type,
					span,
				)
				infer_result(result_context, set_call)
			None:
				checked_set_error(
					index_result.context,
					"Type " + type_to_string(
						target_type,
					) + " does not support subscript assignment",
					span,
				)


private pure func infer_special_builtin_call_expr(
	context: InferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: SourceSpan,
) -> Option[InferResult]:
	match callee:
		ParsedNameExpr(name):
			is_builtin = match lookup_bare_symbol(context, name):
				Some(symbol):
					match symbol.kind:
						FuncSymbolKind(func_symbol):
							func_symbol.origin == BuiltinFunc
						_:
							False
				None:
					False

			if not is_builtin:
				None
			else:
				match builtin_special_inference(name.text):
					Some(AssertShapeInference):
						Some(infer_assert_shape_call(context, args, span))
					Some(CheckedGetInference):
						Some(infer_checked_get_call(context, args, span))
					Some(CheckedSetInference):
						Some(infer_checked_set_call(context, name.text, 1, args, span))
					Some(CheckedSliceInference):
						Some(infer_checked_slice_call(context, args, span))
					Some(MatrixCheckedGetInference):
						Some(infer_nd_checked_get_call(context, name.text, 2, args, span))
					Some(MatrixCheckedSetInference):
						Some(infer_checked_set_call(context, name.text, 2, args, span))
					Some(TensorCheckedGetInference(rank)):
						Some(infer_nd_checked_get_call(context, name.text, rank, args, span))
					Some(TensorCheckedSetInference(rank)):
						Some(infer_checked_set_call(context, name.text, rank, args, span))
					_:
						None
		_:
			None


private pure func subscript_assignment_root(target: ParsedExpr) -> Option[String]:
	match target:
		ParsedNameExpr(name):
			Some(name.text)
		ParsedFieldAccessExpr(receiver, _, _):
			subscript_assignment_root(receiver)
		_:
			None


private record SubscriptAssignmentMutabilityResult {
	context: InferContext,
	assign_target: Option[TypedAssignTarget]
}


private pure func subscript_assignment_mutability(
	context: InferContext,
	target: ParsedExpr,
) -> SubscriptAssignmentMutabilityResult:
	match subscript_assignment_root(target):
		Some(name):
			match env_lookup_with_scope_depth(context.state.env, name):
				Some(lookup):
					match lookup.symbol.kind:
						VarSymbolKind(var_symbol):
							if var_mutability_is_mutable(var_symbol.mutability):
								scope = if env_lookup_is_outermost_scope(context.state.env, lookup):
									ModuleAssignScope
								else:
									LocalAssignScope

								{
									context = context,
									assign_target = Some({
										name = name,
										scope = scope,
									})
								}
							else:
								{
									context = infer_error(
										context,
										"Cannot assign to subscript of immutable variable '" + name + "'",
									),
									assign_target = None
								}
						_:
							{
								context = context,
								assign_target = None
							}
				None:
					{
						context = context,
						assign_target = None
					}
		None:
			{
				context = context,
				assign_target = None
			}


private pure func validate_array_subscript_assignment(
	context: InferContext,
	target: TypedExpr,
	dims: List[SemanticType],
	indices: List[SubscriptIndexEvidence],
	index_count: Int,
	span: SourceSpan,
) -> ValidatedSubscriptIndices:
	if index_count != dims.length():
		{
			context = infer_error(
				context,
				"Subscript assignment has " + index_count.to_string() + " indices but tensor has " + dims
					.length()
					.to_string() + " dimensions",
			),
			indices = indices.map(func(index): index.expr)
		}
	else:
		validate_array_subscript_indices(context, target, dims, indices, span)


private pure func subscript_assignment_value_mismatch_error(
	context: InferContext,
	expected: SemanticType,
	got: SemanticType,
) -> InferContext:
	infer_error(
		context,
		"Cannot assign " + type_to_string(
			got,
		) + " to tensor element of type " + type_to_string(expected),
	)


private pure func infer_subscript_assign_result(
	context: InferContext,
	next_context: InferContext,
	assign_target: Option[TypedAssignTarget],
	target: TypedExpr,
	indices: List[TypedExpr],
	value: TypedExpr,
	span: SourceSpan,
) -> InferResult:
	result_context = infer_context_with_state(context, next_context.state)
	typed = TypedSubscriptAssignExpr(
		assign_target,
		target,
		indices,
		value,
		span,
		inferred_info(result_context, TYPE_VOID),
	)
	infer_result(result_context, typed)


private pure func checked_set_callee_name(index_count: Int) -> String:
	match index_count:
		2:
			"matrix_checked_set"
		3:
			"tensor3_checked_set"
		4:
			"tensor4_checked_set"
		5:
			"tensor5_checked_set"
		_:
			"checked_set"


private pure func checked_set_call(
	context: InferContext,
	target: TypedExpr,
	indices: List[TypedExpr],
	value: TypedExpr,
	target_type: SemanticType,
	element_type: SemanticType,
	span: SourceSpan,
) -> TypedExpr:
	callee_name = checked_set_callee_name(indices.length())
	params = [target_type]
		.concat(indices.map(
			func(_): TYPE_INT,
		))
		.append(element_type)
	resolved_call = builtin_resolved_call(callee_name, params, target_type)
	callee = typed_builtin_callee(callee_name, params, target_type, span, resolved_call)

	TypedCallExpr(
		callee,
		[target]
			.concat(indices)
			.append(value),
		span,
		inferred_call_info(
			context,
			target_type,
			Some(resolved_call),
		),
	)


private pure func infer_array_subscript_assign_result(
	context: InferContext,
	next_context: InferContext,
	assign_target: Option[TypedAssignTarget],
	target: TypedExpr,
	indices: List[TypedExpr],
	value: TypedExpr,
	target_type: SemanticType,
	element_type: SemanticType,
	span: SourceSpan,
) -> InferResult:
	result_context = infer_context_with_state(context, next_context.state)
	set_call = checked_set_call(
		result_context,
		target,
		indices,
		value,
		target_type,
		element_type,
		span,
	)

	match (assign_target, target):
		(Some(destination), TypedNameExpr(name, _)):
			if destination.name == name.text:
				typed = TypedAssignExpr(
					name,
					destination.scope,
					set_call,
					span,
					inferred_info(result_context, TYPE_VOID),
				)
				infer_result(result_context, typed)
			else:
				infer_subscript_assign_result(
					context,
					next_context,
					assign_target,
					target,
					indices,
					value,
					span,
				)
		_:
			infer_subscript_assign_result(
				context,
				next_context,
				assign_target,
				target,
				indices,
				value,
				span,
			)


private pure func infer_subscript_assignment_value(
	context: InferContext,
	expected_type: Option[SemanticType],
	value: ParsedExpr,
) -> InferResult:
	match expected_type:
		Some(typ):
			infer_expr(
				infer_with_canonical_expected_value_slot(context, typ, ExpectedArgumentSlot),
				value,
			)
		None:
			infer_expr(infer_without_expected(context), value)


private pure func infer_array_subscript_assign_expr(
	context: InferContext,
	target_result: InferResult,
	index_result: InferSubscriptIndicesResult,
	assign_target: Option[TypedAssignTarget],
	value: ParsedExpr,
	element_type: SemanticType,
	dims: List[SemanticType],
	index_count: Int,
	span: SourceSpan,
) -> InferResult:
	validated = validate_array_subscript_assignment(
		index_result.context,
		target_result.expr,
		dims,
		index_result.indices,
		index_count,
		span,
	)
	value_result = infer_subscript_assignment_value(validated.context, Some(element_type), value)
	value_type = typed_expr_value_type(value_result.expr)

	next_context = if types_equal(value_type, element_type):
		value_result.context
	else:
		subscript_assignment_value_mismatch_error(value_result.context, element_type, value_type)

	infer_array_subscript_assign_result(
		context,
		next_context,
		assign_target,
		target_result.expr,
		validated.indices,
		value_result.expr,
		typed_expr_semantic_type(target_result.expr),
		element_type,
		span,
	)


private pure func infer_invalid_subscript_assign_expr(
	context: InferContext,
	target_result: InferResult,
	index_result: InferSubscriptIndicesResult,
	assign_target: Option[TypedAssignTarget],
	value: ParsedExpr,
	target_type: SemanticType,
	span: SourceSpan,
) -> InferResult:
	target_context = infer_error(
		index_result.context,
		"Type " + type_to_string(target_type) + ((
			" does not support subscript assignment. Subscript assignment is supported on "
			+ "array types"
		)),
	)
	value_result = infer_subscript_assignment_value(target_context, None, value)
	infer_subscript_assign_result(
		context,
		value_result.context,
		assign_target,
		target_result.expr,
		index_result.indices.map(func(index): index.expr),
		value_result.expr,
		span,
	)


private pure func infer_subscript_assign_expr(
	context: InferContext,
	target: ParsedExpr,
	indices: List[ParsedExpr],
	value: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	mutability = subscript_assignment_mutability(context, target)
	target_result = infer_expr(infer_without_expected(mutability.context), target)
	index_result = infer_subscript_indices(target_result.context, indices)
	target_type = typed_expr_semantic_type(target_result.expr)
	index_count = indices.length()

	match array_type_parts(target_type):
		Some((element_type, dims)):
			infer_array_subscript_assign_expr(
				context,
				target_result,
				index_result,
				mutability.assign_target,
				value,
				element_type,
				dims,
				index_count,
				span,
			)
		None:
			infer_invalid_subscript_assign_expr(
				context,
				target_result,
				index_result,
				mutability.assign_target,
				value,
				target_type,
				span,
			)


private pure func range_endpoint_error(
	context: InferContext,
	label: String,
	typ: SemanticType,
) -> InferContext:
	infer_error(context, "Range " + label + " must be Int, got " + type_to_string(typ))


private pure func range_endpoint_type_is_int_like(typ: SemanticType) -> Bool:
	named_value_type_is(typ, "Int") or is_dim_type(typ)


private pure func infer_range_expr(
	context: InferContext,
	start_expr: ParsedExpr,
	end_expr: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	start_result = infer_expr(
		infer_with_canonical_expected_value_slot(context, TYPE_INT, ExpectedArgumentSlot),
		start_expr,
	)
	start_type = typed_expr_value_type(start_result.expr)

	start_context = if range_endpoint_type_is_int_like(start_type):
		start_result.context
	else:
		range_endpoint_error(start_result.context, "start", start_type)

	end_result = infer_expr(
		infer_with_canonical_expected_value_slot(start_context, TYPE_INT, ExpectedArgumentSlot),
		end_expr,
	)
	end_type = typed_expr_value_type(end_result.expr)

	result_context = if range_endpoint_type_is_int_like(end_type):
		infer_context_with_state(context, end_result.context.state)
	else:
		infer_context_with_state(
			context,
			range_endpoint_error(end_result.context, "end", end_type).state,
		)

	typed = TypedRangeExpr(
		start_result.expr,
		end_result.expr,
		span,
		inferred_info(
			result_context,
			SemanticNamedType("Range", []),
		),
	)

	infer_result(result_context, typed)


private pure func pattern_type_error(
	context: InferContext,
	pattern_label: String,
	expected: SemanticType,
	got: SemanticType,
) -> InferContext:
	infer_error(
		context,
		pattern_label + " pattern requires " + type_to_string(
			expected,
		) + " scrutinee, got " + type_to_string(got),
	)


private pure func int_pattern_scrutinee_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticConstIntType(_):
			True
		_:
			is_any_integer_type(typ) or named_value_type_is(typ, "Int")


private pure func infer_pattern_result(
	context: InferContext,
	env: Env,
	pattern: TypedPattern,
	catch_all: Bool,
	matches_true: Bool,
	matches_false: Bool,
) -> InferPatternResult:
	{
		context = context,
		env = env,
		pattern = pattern,
		catch_all = catch_all,
		matches_true = matches_true,
		matches_false = matches_false
	}


private pure func add_match_binding(env: Env, name: ParsedIdentifier, typ: SemanticType) -> Env:
	env_add_var_with_details(
		env,
		name.text,
		typ,
		Some(typ),
		ImmutableBinding,
		MatchBinding,
		UNREFINED_BINDING,
	)


private pure func tuple_pattern_element_types(
	scrutinee_type: SemanticType,
) -> Option[List[SemanticType]]:
	match scrutinee_type:
		SemanticTupleType(elements):
			Some(elements)
		SemanticNamedType(name, args):
			if name == "Tuple":
				Some(args)
			else:
				None
		_:
			None


private pure func list_pattern_element_type(scrutinee_type: SemanticType) -> Option[SemanticType]:
	match scrutinee_type:
		SemanticNamedType(name, args):
			if name == "List":
				match args.get(0):
					Some(element):
						Some(element)
					None:
						Some(SemanticTypeVar("_list_elem"))
			else:
				None
		_:
			None


private pure func infer_pattern_items(
	context: InferContext,
	env: Env,
	patterns: List[ParsedPattern],
	item_types: List[SemanticType],
) -> InferPatternItemsResult:
	var next_context: InferContext = context
	var next_env: Env = env
	var typed_patterns: List[TypedPattern] = []
	var index: Int = 0

	while index < patterns.length():
		match (patterns.get(index), item_types.get(index)):
			(Some(pattern), Some(item_type)):
				item_result = infer_pattern(next_context, next_env, pattern, item_type)
				next_context = item_result.context
				next_env = item_result.env
				typed_patterns = typed_patterns.append(item_result.pattern)
			_:
				void

		index += 1

	{
		context = next_context,
		env = next_env,
		patterns = typed_patterns
	}


private pure func infer_repeated_pattern_items(
	context: InferContext,
	env: Env,
	patterns: List[ParsedPattern],
	item_type: SemanticType,
) -> InferPatternItemsResult:
	var item_types: List[SemanticType] = []

	for _pattern in patterns:
		item_types = item_types.append(item_type)

	infer_pattern_items(context, env, patterns, item_types)


private pure func bind_list_pattern_spread(
	env: Env,
	spread: Option[ParsedListPatternSpread],
	scrutinee_type: SemanticType,
) -> Env:
	match spread:
		Some(ParsedListSpreadName(name)):
			add_match_binding(env, name, scrutinee_type)
		Some(ParsedListSpreadWildcard(_)):
			env
		None:
			env


private pure func constructor_subst_for_scrutinee(
	type_params: List[String],
	scrutinee_type: SemanticType,
) -> List[SemanticTypeSubstEntry]:
	match scrutinee_type:
		SemanticNamedType(_, args):
			var result: List[SemanticTypeSubstEntry] = []
			var index: Int = 0

			while index < type_params.length() and index < args.length():
				match (type_params.get(index), args.get(index)):
					(Some(name), Some(arg)):
						result = result.append(type_subst_entry(name, arg))
					_:
						void

				index += 1

			result
		_:
			[]


private pure func constructor_pattern_parent_error(
	context: InferContext,
	constructor_name: String,
	parent_type: String,
	scrutinee_type: SemanticType,
) -> InferContext:
	match scrutinee_type:
		SemanticNamedType(type_name, _):
			infer_error(
				context,
				"Constructor " + constructor_name + " belongs to type " + parent_type + ", not " + type_name,
			)
		_:
			infer_error(
				context,
				"Constructor " + constructor_name + " cannot match scrutinee of type " + type_to_string(
					scrutinee_type,
				),
			)


private pure func infer_known_constructor_pattern(
	context: InferContext,
	env: Env,
	constructor_name: ParsedIdentifier,
	constructor_label: String,
	parent_type: String,
	constructor_id: Int,
	type_params: List[String],
	field_types: List[SemanticType],
	fields: List[ParsedPattern],
	span: SourceSpan,
	scrutinee_type: SemanticType,
) -> InferPatternResult:
	parent_context = match scrutinee_type:
		SemanticNamedType(type_name, _):
			if type_name == parent_type:
				context
			else:
				constructor_pattern_parent_error(
					context,
					constructor_label,
					parent_type,
					scrutinee_type,
				)
		_:
			constructor_pattern_parent_error(
				context,
				constructor_label,
				parent_type,
				scrutinee_type,
			)

	if fields.length() != field_types.length():
		infer_pattern_result(
			infer_error(
				parent_context,
				"Constructor " + constructor_label + " expects " + field_types
					.length()
					.to_string() + " field(s), but pattern has " + fields
					.length()
					.to_string(),
			),
			env,
			TypedConstructorPattern(constructor_name, [], span, constructor_id),
			False,
			False,
			False,
		)
	else:
		subst = constructor_subst_for_scrutinee(type_params, scrutinee_type)
		concrete_fields = field_types.map(func(field_type): apply_subst(subst, field_type))
		items_result = infer_pattern_items(parent_context, env, fields, concrete_fields)
		infer_pattern_result(
			items_result.context,
			items_result.env,
			TypedConstructorPattern(constructor_name, items_result.patterns, span, constructor_id),
			False,
			False,
			False,
		)


private pure func infer_constructor_pattern(
	context: InferContext,
	env: Env,
	constructor_name: ParsedIdentifier,
	fields: List[ParsedPattern],
	span: SourceSpan,
	scrutinee_type: SemanticType,
) -> InferPatternResult:
	match find_bare_constructor_for_type(context, env, constructor_name.text, scrutinee_type):
		Some(ctor):
			infer_known_constructor_pattern(
				context,
				env,
				constructor_name,
				constructor_name.text,
				ctor.parent_type,
				ctor.constructor_id,
				ctor.type_params,
				ctor.field_types,
				fields,
				span,
				scrutinee_type,
			)
		None:
			infer_pattern_result(
				infer_error(context, "Unknown constructor pattern `" + constructor_name.text + "`"),
				env,
				TypedUnsupportedPattern("unknown constructor " + constructor_name.text, span),
				False,
				False,
				False,
			)


private pure func qualified_constructor_pattern_result(
	base: InferPatternResult,
	module_name: ParsedIdentifier,
	name: ParsedIdentifier,
	span: SourceSpan,
) -> InferPatternResult:
	match base.pattern:
		TypedConstructorPattern(_, fields, _, constructor_id):
			infer_pattern_result(
				base.context,
				base.env,
				TypedQualifiedConstructorPattern(module_name, name, fields, span, constructor_id),
				base.catch_all,
				base.matches_true,
				base.matches_false,
			)
		_:
			-- Known-constructor inference currently always returns a constructor
			-- pattern, including error recovery. Preserve any future recovery shape
			-- instead of manufacturing a qualified pattern with unrelated identity.
			base


private pure func infer_qualified_constructor_pattern(
	context: InferContext,
	env: Env,
	module_name: ParsedIdentifier,
	name: ParsedIdentifier,
	fields: List[ParsedPattern],
	span: SourceSpan,
	scrutinee_type: SemanticType,
) -> InferPatternResult:
	match module_view_find_module_alias(context.state.facts.module_view, module_name.text):
		Some(module_path):
			match find_module_constructor(context, env, module_path, name.text):
				Some(ctor):
					base = infer_known_constructor_pattern(
						context,
						env,
						name,
						module_name.text + "." + name.text,
						ctor.parent_type,
						ctor.constructor_id,
						ctor.type_params,
						ctor.field_types,
						fields,
						span,
						scrutinee_type,
					)
					qualified_constructor_pattern_result(base, module_name, name, span)
				None:
					infer_pattern_result(
						infer_error(
							context,
							"Module alias `" + module_name.text + "` for module `" + module_path + "` has no constructor `" + name.text + "`",
						),
						env,
						TypedUnsupportedPattern(
							"unknown qualified constructor " + module_name.text + "." + name.text,
							span,
						),
						False,
						False,
						False,
					)
		None:
			infer_pattern_result(
				infer_error(
					context,
					"Unknown module alias `" + module_name.text + "` in constructor pattern",
				),
				env,
				TypedUnsupportedPattern(
					"unknown qualified constructor " + module_name.text + "." + name.text,
					span,
				),
				False,
				False,
				False,
			)


private pure func infer_pattern(
	context: InferContext,
	env: Env,
	pattern: ParsedPattern,
	scrutinee_type: SemanticType,
) -> InferPatternResult:
	match pattern:
		ParsedWildcardPattern(span):
			infer_pattern_result(context, env, TypedWildcardPattern(span), True, False, False)
		ParsedNamePattern(name):
			match find_bare_constructor_for_type(context, env, name.text, scrutinee_type):
				Some(_):
					infer_constructor_pattern(context, env, name, [], name.span, scrutinee_type)
				None:
					next_env = add_match_binding(env, name, scrutinee_type)
					infer_pattern_result(
						context,
						next_env,
						TypedNamePattern(name, scrutinee_type),
						True,
						False,
						False,
					)
		ParsedBoolPattern(value, span):
			next_context = if named_value_type_is(scrutinee_type, "Bool"):
				context
			else:
				pattern_type_error(context, "Bool", TYPE_BOOL, scrutinee_type)

			infer_pattern_result(
				next_context,
				env,
				TypedBoolPattern(value, span),
				False,
				value,
				not value,
			)
		ParsedIntPattern(text, span):
			next_context = if int_pattern_scrutinee_type(scrutinee_type):
				context
			else:
				pattern_type_error(context, "Int", TYPE_INT, scrutinee_type)

			infer_pattern_result(
				next_context,
				env,
				TypedIntPattern(text, span),
				False,
				False,
				False,
			)
		ParsedStringPattern(value, _, span):
			next_context = if named_value_type_is(scrutinee_type, "String"):
				context
			else:
				pattern_type_error(context, "String", TYPE_STRING, scrutinee_type)

			infer_pattern_result(
				next_context,
				env,
				TypedStringPattern(value, span),
				False,
				False,
				False,
			)
		ParsedCharPattern(value, span):
			next_context = if named_value_type_is(scrutinee_type, "Char"):
				context
			else:
				pattern_type_error(context, "Char", TYPE_CHAR, scrutinee_type)

			infer_pattern_result(
				next_context,
				env,
				TypedCharPattern(value, span),
				False,
				False,
				False,
			)
		ParsedFloatPattern(text, span):
			next_context = if is_any_float_type(scrutinee_type):
				context
			else:
				pattern_type_error(context, "Float", TYPE_FLOAT, scrutinee_type)

			infer_pattern_result(
				next_context,
				env,
				TypedFloatPattern(text, span),
				False,
				False,
				False,
			)
		ParsedConstructorPattern(name, fields, span):
			infer_constructor_pattern(context, env, name, fields, span, scrutinee_type)
		ParsedQualifiedConstructorPattern(module_name, name, fields, span):
			infer_qualified_constructor_pattern(
				context,
				env,
				module_name,
				name,
				fields,
				span,
				scrutinee_type,
			)
		ParsedTuplePattern(items, span):
			match tuple_pattern_element_types(scrutinee_type):
				Some(elements):
					if items.length() != elements.length():
						infer_pattern_result(
							infer_error(context, "Tuple pattern has " + items
									.length()
									.to_string() + " elements, but scrutinee tuple has " + elements
									.length()
									.to_string() + " elements"),
							env,
							TypedTuplePattern([], span),
							False,
							False,
							False,
						)
					else:
						items_result = infer_pattern_items(context, env, items, elements)
						infer_pattern_result(
							items_result.context,
							items_result.env,
							TypedTuplePattern(items_result.patterns, span),
							False,
							False,
							False,
						)
				None:
					infer_pattern_result(
						infer_error(
							context,
							"Tuple pattern cannot match scrutinee of type " + type_to_string(
								scrutinee_type,
							),
						),
						env,
						TypedTuplePattern([], span),
						False,
						False,
						False,
					)
		ParsedListPattern(items, spread, span):
			match list_pattern_element_type(scrutinee_type):
				Some(element_type):
					items_result = infer_repeated_pattern_items(context, env, items, element_type)
					next_env = bind_list_pattern_spread(items_result.env, spread, scrutinee_type)
					infer_pattern_result(
						items_result.context,
						next_env,
						TypedListPattern(items_result.patterns, spread, span),
						False,
						False,
						False,
					)
				None:
					infer_pattern_result(
						infer_error(
							context,
							"List pattern cannot match scrutinee of type " + type_to_string(
								scrutinee_type,
							),
						),
						env,
						TypedListPattern([], spread, span),
						False,
						False,
						False,
					)
		ParsedOrPattern(options, span):
			match options.get(0):
				Some(first):
					first_result = infer_pattern(context, env, first, scrutinee_type)
					var next_context: InferContext = first_result.context
					var typed_options: List[TypedPattern] = [first_result.pattern]
					var catch_all: Bool = first_result.catch_all
					var matches_true: Bool = first_result.matches_true
					var matches_false: Bool = first_result.matches_false
					var index: Int = 1

					while index < options.length():
						match options.get(index):
							Some(option):
								next_context = if string_lists_equal(pattern_bound_names(
										free_var_facts_with_env(context, env),
										first,
									).sort(), pattern_bound_names(
										free_var_facts_with_env(context, env),
										option,
									).sort()):
									next_context
								else:
									infer_error(
										next_context,
										"Or-pattern alternatives must bind the same variables",
									)

								option_result = infer_pattern(
									next_context,
									env,
									option,
									scrutinee_type,
								)
								next_context = option_result.context
								typed_options = typed_options.append(option_result.pattern)
								catch_all = catch_all or option_result.catch_all
								matches_true = matches_true or option_result.matches_true
								matches_false = matches_false or option_result.matches_false
							None:
								void

						index += 1

					infer_pattern_result(
						next_context,
						first_result.env,
						TypedOrPattern(typed_options, span),
						catch_all,
						matches_true,
						matches_false,
					)
				None:
					infer_pattern_result(
						infer_error(context, "Or pattern must have at least one alternative"),
						env,
						TypedOrPattern([], span),
						False,
						False,
						False,
					)
		ParsedMissingPattern(span):
			infer_pattern_result(
				infer_error(context, "Missing match pattern"),
				env,
				TypedUnsupportedPattern("missing", span),
				False,
				False,
				False,
			)


private pure func match_type_mismatch_error(
	context: InferContext,
	expected: SemanticType,
	got: SemanticType,
	span: SourceSpan,
) -> InferContext:
	expected_text = type_to_string(expected)
	got_text = type_to_string(got)
	location = source_span_label(span)

	infer_error(
		context,
		"Match branch type mismatch: expected ${expected_text}, got ${got_text} at ${location}",
	)


private pure func match_body_context(context: InferContext) -> InferContext:
	match infer_context_expected_type(context):
		Some(expected):
			infer_with_canonical_expected_value_slot(context, expected, ExpectedArgumentSlot)
		None:
			infer_without_expected(context)


private pure func infer_match_cases(
	context: InferContext,
	cases: List[ParsedMatchCase],
	scrutinee_type: SemanticType,
) -> InferMatchCasesResult:
	var next_context: InferContext = context
	var typed_cases: List[TypedMatchCase] = []
	var result_type: Option[SemanticType] = None
	var catch_all: Bool = False
	var matches_true: Bool = False
	var matches_false: Bool = False
	var index: Int = 0

	while index < cases.length():
		match cases.get(index):
			Some(case):
				case_env = env_push_scope(next_context.state.env)
				pattern_result = infer_pattern(next_context, case_env, case.pattern, scrutinee_type)
				case_state = { pattern_result.context.state | env = pattern_result.env }
				case_context = infer_context_with_state(pattern_result.context, case_state)

				body_context = match infer_context_expected_type(case_context):
					Some(expected):
						infer_with_canonical_expected_value_slot(
							case_context,
							expected,
							ExpectedArgumentSlot,
						)
					None:
						infer_without_expected(case_context)

				body_result = infer_expr(body_context, case.body)
				branch_type = typed_expr_semantic_type(body_result.expr)

				match result_type:
					None:
						next_context = body_result.context
						result_type = Some(branch_type)
					Some(expected):
						match common_inferred_type(body_result.context, expected, branch_type):
							Some(common):
								next_context = common.context
								result_type = Some(common.typ)
							None:
								next_context = match_type_mismatch_error(
									body_result.context,
									expected,
									branch_type,
									case.span,
								)
								result_type = Some(expected)

				outer_env = env_pop_scope(next_context.state.env)
				outer_state = { next_context.state | env = outer_env }
				next_context = infer_context_with_state(context, outer_state)
				typed_cases = typed_cases.append({
					pattern = pattern_result.pattern,
					body = body_result.expr,
					span = case.span,
				})
				catch_all = catch_all or pattern_result.catch_all
				matches_true = matches_true or pattern_result.matches_true
				matches_false = matches_false or pattern_result.matches_false
			None:
				void

		index += 1

	{
		context = next_context,
		cases = typed_cases,
		result_type = result_type,
		catch_all = catch_all,
		matches_true = matches_true,
		matches_false = matches_false
	}


private pure func bool_match_exhaustiveness_error(
	context: InferContext,
	matches_true: Bool,
	matches_false: Bool,
) -> InferContext:
	if matches_true and matches_false:
		context
	else:
		missing = if not matches_true and not matches_false:
			"True and False"
		else if not matches_true:
			"True"
		else:
			"False"

		infer_error(context, "Non-exhaustive match on Bool: missing " + missing)


private pure func typed_pattern_constructor_names(pattern: TypedPattern) -> List[String]:
	match pattern:
		TypedConstructorPattern(name, _, _, _):
			[name.text]
		TypedQualifiedConstructorPattern(_, name, _, _, _):
			[name.text]
		TypedOrPattern(options, _):
			var result: List[String] = []

			for option in options:
				for name in typed_pattern_constructor_names(option):
					if not result.contains(name):
						result = result.append(name)

			result
		_:
			[]


private pure func match_case_constructor_names(cases: List[TypedMatchCase]) -> List[String]:
	var result: List[String] = []

	for case in cases:
		for name in typed_pattern_constructor_names(case.pattern):
			if not result.contains(name):
				result = result.append(name)

	result


private pure func missing_constructor_names(
	all_names: List[String],
	seen_names: List[String],
) -> List[String]:
	var missing: List[String] = []

	for name in all_names:
		if not seen_names.contains(name):
			missing = missing.append(name)

	missing


private pure func constructor_match_exhaustiveness_error(
	context: InferContext,
	scrutinee_type: SemanticType,
	cases: List[TypedMatchCase],
) -> InferContext:
	match scrutinee_type:
		SemanticNamedType(type_name, _):
			variant_names = match module_view_accepted_union_type_index(
				context.state.facts.module_view,
			):
				Some(index):
					union_type_index_find(
						index,
						type_name,
					).map(
						func(entry): entry.variants.map(func(variant): variant.name),
					)
				None:
					match env_get_type_decl(context.state.env, type_name):
						Some((_, variants)):
							Some(variants.map(
								func(variant): variant.name,
							))
						None:
							None

			match variant_names:
				Some(all_names):
					missing = missing_constructor_names(
						all_names,
						match_case_constructor_names(cases),
					)

					if missing.length() == 0:
						context
					else:
						infer_error(
							context,
							"Non-exhaustive match on " + type_name + ": missing " + missing.join(
								", ",
							),
						)
				None:
					context
		_:
			context


private pure func typed_pattern_is_catch_all(pattern: TypedPattern) -> Bool:
	match pattern:
		TypedWildcardPattern(_):
			True
		TypedNamePattern(_, _):
			True
		TypedOrPattern(options, _):
			var found: Bool = False

			for option in options:
				if typed_pattern_is_catch_all(option):
					found = True
					break

			found
		_:
			False


private pure func typed_patterns_all_catch_all(patterns: List[TypedPattern]) -> Bool:
	var all_catch_all: Bool = True

	for pattern in patterns:
		if not typed_pattern_is_catch_all(pattern):
			all_catch_all = False
			break

	all_catch_all


private pure func typed_pattern_list_coverages(pattern: TypedPattern) -> List[ListPatternCoverage]:
	match pattern:
		TypedListPattern(items, spread, _):
			if typed_patterns_all_catch_all(items):
				[
					{
						fixed_length = items.length(),
						has_spread = spread.is_some()
					},
				]
			else:
				[]
		TypedOrPattern(options, _):
			var result: List[ListPatternCoverage] = []

			for option in options:
				result = result.concat(typed_pattern_list_coverages(option))

			result
		_:
			[]


private pure func match_case_list_coverages(
	cases: List[TypedMatchCase],
) -> List[ListPatternCoverage]:
	var result: List[ListPatternCoverage] = []

	for case in cases:
		result = result.concat(typed_pattern_list_coverages(case.pattern))

	result


private pure func min_spread_list_coverage(coverages: List[ListPatternCoverage]) -> Option[Int]:
	var result: Option[Int] = None

	for coverage in coverages:
		if coverage.has_spread:
			result = match result:
				Some(current):
					minimum = if current < coverage.fixed_length:
						current
					else:
						coverage.fixed_length

					Some(minimum)
				None:
					Some(coverage.fixed_length)

	result


private pure func exact_list_length_covered(
	coverages: List[ListPatternCoverage],
	length: Int,
) -> Bool:
	var covered: Bool = False

	for coverage in coverages:
		if not coverage.has_spread and coverage.fixed_length == length:
			covered = True
			break

	covered


private pure func missing_list_lengths(
	coverages: List[ListPatternCoverage],
	max_exclusive: Int,
) -> List[Int]:
	var missing: List[Int] = []
	var length: Int = 0

	while length < max_exclusive:
		if not exact_list_length_covered(coverages, length):
			missing = missing.append(length)

		length += 1

	missing


private pure func list_length_label(length: Int) -> String:
	if length == 0:
		"[]"
	else:
		"length " + length.to_string()


private pure func check_list_match_exhaustiveness(
	context: InferContext,
	cases: List[TypedMatchCase],
) -> InferContext:
	coverages = match_case_list_coverages(cases)

	match min_spread_list_coverage(coverages):
		Some(min_spread):
			missing = missing_list_lengths(coverages, min_spread)

			if missing.length() == 0:
				context
			else:
				infer_error(context, "Non-exhaustive match on List: missing " + missing
						.map(list_length_label)
						.join(", "))
		None:
			infer_error(
				context,
				(
					"Non-exhaustive match on List: add a catch-all spread pattern (e.g., [x, ..."
					+ "rest]) or wildcard (_)"
				),
			)


private pure func check_match_exhaustiveness(
	context: InferContext,
	scrutinee_type: SemanticType,
	cases: List[TypedMatchCase],
	catch_all: Bool,
	matches_true: Bool,
	matches_false: Bool,
) -> InferContext:
	if catch_all:
		context
	else if named_value_type_is(scrutinee_type, "Bool"):
		bool_match_exhaustiveness_error(context, matches_true, matches_false)
	else:
		match open_exhaustiveness_scalar_name(scrutinee_type):
			Some(type_name):
				infer_error(
					context,
					"Non-exhaustive match on " + type_name + ": add a wildcard (_) or default pattern to handle all values",
				)
			None:
				if named_type_head_is(scrutinee_type, "List"):
					check_list_match_exhaustiveness(context, cases)
				else:
					constructor_match_exhaustiveness_error(context, scrutinee_type, cases)


private pure func infer_match_expr(
	context: InferContext,
	scrutinee: ParsedExpr,
	cases: List[ParsedMatchCase],
	span: SourceSpan,
) -> InferResult:
	scrutinee_result = infer_expr(infer_without_expected(context), scrutinee)
	scrutinee_type = typed_expr_semantic_type(scrutinee_result.expr)

	if cases.length() == 0:
		next = infer_error(scrutinee_result.context, "match expression must have at least one case")
		typed = TypedMatchExpr(
			scrutinee_result.expr,
			[],
			span,
			inferred_info(next, TYPE_VOID),
		)
		infer_result(next, typed)
	else:
		cases_context = infer_context_with_state(context, scrutinee_result.context.state)
		cases_result = infer_match_cases(cases_context, cases, scrutinee_type)
		exhaustive_context = check_match_exhaustiveness(
			cases_result.context,
			scrutinee_type,
			cases_result.cases,
			cases_result.catch_all,
			cases_result.matches_true,
			cases_result.matches_false,
		)

		result_type = match cases_result.result_type:
			Some(typ):
				typ
			None:
				TYPE_VOID

		result_context = infer_context_with_state(context, exhaustive_context.state)
		typed = TypedMatchExpr(
			scrutinee_result.expr,
			cases_result.cases,
			span,
			inferred_info(result_context, result_type),
		)
		infer_result(result_context, typed)


private pure func condition_error(
	context: InferContext,
	kind: String,
	condition_type: SemanticType,
) -> InferContext:
	infer_error(context, kind + " condition must be Bool, got " + type_to_string(condition_type))


private pure func condition_is_zero(expr: ParsedExpr) -> Bool:
	match expr:
		ParsedIntLiteralExpr(text, _):
			parse_int_literal(text) == 0
		_:
			False


private pure func condition_name(expr: ParsedExpr) -> Option[String]:
	match expr:
		ParsedNameExpr(name):
			Some(name.text)
		_:
			None


private pure func condition_nonnegative_name(expr: ParsedExpr) -> Option[String]:
	match expr:
		ParsedBinaryExpr(op, left, right, _):
			match op:
				ParsedGreaterEqualOp:
					if condition_is_zero(right):
						condition_name(left)
					else:
						None
				ParsedLessEqualOp:
					if condition_is_zero(left):
						condition_name(right)
					else:
						None
				_:
					None
		_:
			None


private pure func condition_length_collection_name(expr: ParsedExpr) -> Option[String]:
	match expr:
		ParsedCallExpr(callee, args, _):
			match callee:
				ParsedNameExpr(callee_name):
					if callee_name.text == "length" and args.length() == 1:
						match args.get(0):
							Some(ParsedNameExpr(collection_name)):
								Some(collection_name.text)
							_:
								None
					else:
						None
				ParsedFieldAccessExpr(receiver, method, _):
					if method.text == "length" and args.length() == 0:
						condition_name(receiver)
					else:
						None
				_:
					None
		_:
			None


private pure func condition_length_bound(expr: ParsedExpr) -> Option[(String, String)]:
	match expr:
		ParsedBinaryExpr(ParsedLessOp, left, right, _):
			match condition_name(left):
				Some(index_name):
					match condition_length_collection_name(right):
						Some(collection_name):
							Some((index_name, collection_name))
						None:
							None
				None:
					None
		_:
			None


private pure func if_range_refinement_from_parts(
	context: InferContext,
	lower: ParsedExpr,
	upper: ParsedExpr,
) -> Option[(String, SemanticType)]:
	match condition_nonnegative_name(lower):
		Some(lower_name):
			match condition_length_bound(upper):
				Some((upper_name, collection_name)):
					if lower_name != upper_name:
						None
					else:
						if env_var_is_immutable(context.state.env, lower_name):
							match env_get_var_type(context.state.env, collection_name):
								Some(collection_type):
									match array_type_parts(collection_type):
										Some((_, dims)):
											dims
												.get(0)
												.map(func(dim): (lower_name, dim))
										None:
											None
								None:
									None
						else:
							None
				None:
					None
		None:
			None


private pure func condition_conjuncts(condition: ParsedExpr) -> List[ParsedExpr]:
	match condition:
		ParsedLogicalExpr(ParsedAndOp, left, right, _):
			condition_conjuncts(left).concat(condition_conjuncts(right))
		_:
			[condition]


private pure func range_refinement_list_contains(
	refinements: List[(String, SemanticType)],
	name: String,
) -> Bool:
	var found: Bool = False

	for (existing_name, _) in refinements:
		if existing_name == name:
			found = True
			break

	found


private pure func if_range_refinements(
	context: InferContext,
	condition: ParsedExpr,
) -> List[(String, SemanticType)]:
	clauses = condition_conjuncts(condition)
	var refinements: List[(String, SemanticType)] = []

	for lower in clauses:
		for upper in clauses:
			match if_range_refinement_from_parts(context, lower, upper):
				Some((name, bound)):
					if not range_refinement_list_contains(refinements, name):
						refinements = refinements.append((name, bound))
				None:
					void

	refinements


private pure func if_refined_then_context(
	context: InferContext,
	refinements: List[(String, SemanticType)],
) -> InferContext:
	if refinements.length() == 0:
		context
	else:
		var refined_env = env_push_scope(context.state.env)

		for (name, bound) in refinements:
			refined_type = SemanticRangeType(bound)
			refined_env = env_add_var_with_details(
				refined_env,
				name,
				refined_type,
				Some(TYPE_INT),
				ImmutableBinding,
				LetBinding,
				UNREFINED_BINDING,
			)

		refined_state = { context.state | env = refined_env }
		infer_context_with_state(context, refined_state)


private pure func if_unscoped_then_context(
	context: InferContext,
	refinements: List[(String, SemanticType)],
) -> InferContext:
	if refinements.length() == 0:
		context
	else:
		outer_env = env_pop_scope(context.state.env)
		outer_state = { context.state | env = outer_env }
		infer_context_with_state(context, outer_state)


private pure func infer_if_expr(
	context: InferContext,
	condition: ParsedExpr,
	then_branch: ParsedExpr,
	else_branch: Option[ParsedExpr],
	span: SourceSpan,
) -> InferResult:
	condition_result = infer_expr(infer_without_expected(context), condition)
	condition_type = typed_expr_semantic_type(condition_result.expr)

	condition_context = if named_value_type_is(condition_type, "Bool"):
		condition_result.context
	else:
		condition_error(condition_result.context, "If", condition_type)

	branch_context = match else_branch:
		Some(_):
			infer_context_with_state(context, condition_context.state)
		None:
			infer_without_expected(infer_context_with_state(context, condition_context.state))

	refinements = if_range_refinements(condition_context, condition)
	refined_branch_context = if_refined_then_context(branch_context, refinements)
	raw_then_result = infer_expr(refined_branch_context, then_branch)
	then_result = infer_result(
		if_unscoped_then_context(raw_then_result.context, refinements),
		raw_then_result.expr,
	)
	then_type = typed_expr_semantic_type(then_result.expr)

	match else_branch:
		None:
			next_context = if types_equal(then_type, TYPE_VOID):
				then_result.context
			else:
				infer_error(
					then_result.context,
					"if-expression without else cannot produce a value; then-branch returns " + type_to_string(
						then_type,
					),
				)

			typed = TypedIfExpr(
				condition_result.expr,
				then_result.expr,
				None,
				span,
				inferred_info(next_context, TYPE_VOID),
			)
			infer_result(next_context, typed)
		Some(else_expr):
			else_result = infer_expr(
				infer_context_with_state(context, then_result.context.state),
				else_expr,
			)
			else_type = typed_expr_semantic_type(else_result.expr)

			match common_inferred_type(else_result.context, then_type, else_type):
				Some(common):
					result_context = infer_context_with_state(context, common.context.state)
					typed = TypedIfExpr(
						condition_result.expr,
						then_result.expr,
						Some(else_result.expr),
						span,
						inferred_info(result_context, common.typ),
					)
					infer_result(result_context, typed)
				None:
					next_context = infer_error(
						else_result.context,
						"If-else type mismatch: then-branch returns " + type_to_string(
							then_type,
						) + ", else-branch returns " + type_to_string(else_type),
					)
					typed = TypedIfExpr(
						condition_result.expr,
						then_result.expr,
						Some(else_result.expr),
						span,
						inferred_info(next_context, TYPE_VOID),
					)
					infer_result(next_context, typed)


private pure func infer_while_expr(
	context: InferContext,
	condition: ParsedExpr,
	body: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	condition_result = infer_expr(
		infer_with_canonical_expected_value_slot(context, TYPE_BOOL, ExpectedArgumentSlot),
		condition,
	)
	condition_type = typed_expr_value_type(condition_result.expr)

	condition_context = if named_value_type_is(condition_type, "Bool"):
		condition_result.context
	else:
		condition_error(condition_result.context, "While", condition_type)

	body_result = infer_expr(infer_loop_body_context(condition_context), body)
	result_context = infer_context_with_state(context, body_result.context.state)
	typed = TypedWhileExpr(
		condition_result.expr,
		body_result.expr,
		span,
		inferred_info(result_context, TYPE_VOID),
	)

	infer_result(result_context, typed)


private pure func infer_break_expr(context: InferContext, span: SourceSpan) -> InferResult:
	next_context = if context.in_loop:
		context
	else:
		infer_error(context, "'break' can only be used inside a loop")

	typed = TypedBreakExpr(
		span,
		inferred_info(next_context, TYPE_VOID),
	)

	infer_result(next_context, typed)


private pure func infer_continue_expr(context: InferContext, span: SourceSpan) -> InferResult:
	next_context = if context.in_loop:
		context
	else:
		infer_error(context, "'continue' can only be used inside a loop")

	typed = TypedContinueExpr(
		span,
		inferred_info(next_context, TYPE_VOID),
	)

	infer_result(next_context, typed)


private pure func array_loop_element_type(
	element_type: SemanticType,
	dims: List[SemanticType],
) -> Option[SemanticType]:
	if dims.length() == 0:
		None
	else if dims.length() == 1:
		Some(element_type)
	else:
		var rest: List[SemanticType] = []
		var index: Int = 1

		while index < dims.length():
			match dims.get(index):
				Some(dim):
					rest = rest.append(dim)
				None:
					void

			index += 1

		Some(SemanticArrayType(element_type, rest))


private pure func is_single_argument_iterable_type_name(name: String) -> Bool:
	(
		name == "Channel"
		or name == "List"
		or name == "Set"
		or name == "Vector"
		or is_stream_type_name(name)
	)


private pure func iterable_element_type(typ: SemanticType) -> Option[SemanticType]:
	match typ:
		SemanticNamedType(name, args):
			if name == "Range" and args.length() == 0:
				Some(TYPE_INT)
			else if name == "String" and args.length() == 0:
				Some(TYPE_CHAR)
			else if is_single_argument_iterable_type_name(name) and args.length() == 1:
				match args.get(0):
					Some(element):
						Some(element)
					None:
						None
			else if is_resource_source_type_name(name) and args.length() == 2:
				args.get(0)
			else if name == "Dict" and args.length() == 2:
				match args.get(0):
					Some(element):
						Some(element)
					None:
						None
			else:
				None
		SemanticArrayType(element_type, dims):
			array_loop_element_type(element_type, dims)
		_:
			None


private pure func loop_index_type(dim: SemanticType) -> SemanticType:
	match dim:
		SemanticConstIntType(bound):
			if bound > 0:
				SemanticRangeType(SemanticConstIntType(bound))
			else:
				TYPE_INT
		SemanticTypeVar(name):
			if is_dim_var_name(name):
				SemanticRangeType(SemanticTypeVar(name))
			else:
				TYPE_INT
		SemanticVarDimsType(name):
			SemanticRangeType(SemanticVarDimsType(name))
		SemanticDimOpType(op, left, right):
			SemanticRangeType(normalize_dim(SemanticDimOpType(op, left, right)))
		_:
			TYPE_INT


private pure func enumerate_loop_view(
	element_type: SemanticType,
	dims: List[SemanticType],
) -> Option[TypedLoopView]:
	match (dims.get(0), array_loop_element_type(element_type, dims)):
		(Some(first_dim), Some(loop_element_type)):
			Some(
				TypedEnumerateLoopView(
					SemanticTupleType([loop_index_type(first_dim), loop_element_type]),
				),
			)
		_:
			None


private pure func enumerate2_loop_view(
	element_type: SemanticType,
	dims: List[SemanticType],
) -> Option[TypedLoopView]:
	match (dims.get(0), dims.get(1)):
		(Some(row_dim), Some(column_dim)):
			Some(TypedEnumerate2LoopView(SemanticTupleType([
				loop_index_type(row_dim),
				loop_index_type(column_dim),
				element_type,
			])))
		_:
			None


private pure func windows_loop_view(
	element_type: SemanticType,
	dims: List[SemanticType],
	args: List[TypedExpr],
) -> Option[TypedLoopView]:
	if dims.length() != 1:
		None
	else:
		match args.get(1):
			Some(TypedIntLiteralExpr(text, _, _)):
				match text.parse_int():
					Some(size):
						if size > 0:
							Some(
								TypedWindowsLoopView(
									size,
									SemanticArrayType(element_type, [SemanticConstIntType(size)]),
								),
							)
						else:
							None
					None:
						None
			_:
				None


private pure func typed_loop_view(iterable: TypedExpr) -> Option[TypedLoopView]:
	match iterable:
		TypedCallExpr(_, args, _, info):
			match (info.resolved_call, args.get(0)):
				(Some(call), Some(source)):
					match array_type_parts(typed_expr_semantic_type(source)):
						Some((element_type, dims)):
							match call.loop_producer:
								Some(ResolvedLoopProducerIndices):
									match dims.get(0):
										Some(first_dim):
											Some(TypedIndicesLoopView(loop_index_type(first_dim)))
										None:
											None
								Some(ResolvedLoopProducerEnumerate):
									enumerate_loop_view(element_type, dims)
								Some(ResolvedLoopProducerEnumerate2):
									enumerate2_loop_view(element_type, dims)
								Some(ResolvedLoopProducerWindows):
									windows_loop_view(element_type, dims, args)
								None:
									None
						None:
							None
				_:
					None
		_:
			None


pure func typed_loop_view_element_type(view: TypedLoopView) -> SemanticType:
	match view:
		TypedIndicesLoopView(element_type):
			element_type
		TypedEnumerateLoopView(element_type):
			element_type
		TypedEnumerate2LoopView(element_type):
			element_type
		TypedWindowsLoopView(_, element_type):
			element_type


private pure func iterable_binding_origin(typ: SemanticType) -> VarOrigin:
	match typ:
		SemanticNamedType(name, args):
			if is_resource_source_type_name(name) and args.length() == 2:
				ScopedResource
			else:
				ForLoopVar
		_:
			ForLoopVar


private pure func is_fallible_stream_iterable_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticNamedType(name, args):
			is_fallible_stream_type_name(name) and args.length() == 2
		_:
			False


private pure func fallible_stream_for_iterable_error(context: InferContext) -> InferContext:
	infer_error(
		context,
		"Cannot iterate directly over FallibleStream because retrieving an item may fail\n    help: Collect it with collect_result() or use a fallible stream terminal operation",
	)


private pure func fallible_stream_for_iterable_error_result(
	context: InferContext,
	span: SourceSpan,
) -> InferResult:
	error_context = fallible_stream_for_iterable_error(context)
	infer_result(
		error_context,
		TypedMissingExpr(
			span,
			inferred_info(error_context, TYPE_VOID),
		),
	)


private pure func for_iterable_purity_requirements(iterable: TypedExpr) -> List[PurityRequirement]:
	match typed_expr_semantic_type(iterable):
		SemanticNamedType(name, args):
			if name == "Channel" and args.length() == 1:
				[PuritySyntaxRequirement("channel receive")]
			else if is_stream_type_name(name) and args.length() == 1:
				[PuritySyntaxRequirement("stream next")]
			else:
				[]
		_:
			[]


private pure func tuple_elements_from_type(typ: SemanticType) -> Option[List[SemanticType]]:
	match typ:
		SemanticTupleType(elements):
			Some(elements)
		SemanticNamedType(name, args):
			if name == "Tuple":
				Some(args)
			else:
				None
		_:
			None


private pure func for_tuple_elements_from_iterable_element(
	context: InferContext,
	element_type: SemanticType,
) -> ForTupleElementsResult:
	match tuple_elements_from_type(element_type):
		Some(elements):
			{
				context = context,
				elements = elements,
				ok = True
			}
		None:
			next = infer_error(
				context,
				"Tuple for-loop requires iterable elements to be tuples, got " + type_to_string(
					element_type,
				),
			)
			{
				context = next,
				elements = [],
				ok = False
			}


private pure func for_tuple_iterable_error(
	context: InferContext,
	iterable_type: SemanticType,
) -> ForTupleElementsResult:
	next = infer_error(
		context,
		"Cannot iterate over type " + type_to_string(
			iterable_type,
		) + ". Tuple for-in loops work with Dict and iterables of tuples",
	)
	{
		context = next,
		elements = [],
		ok = False
	}


private pure func for_tuple_element_types(
	context: InferContext,
	iterable_type: SemanticType,
) -> ForTupleElementsResult:
	match iterable_type:
		SemanticNamedType(name, args):
			if name == "Dict" and args.length() == 2:
				match (args.get(0), args.get(1)):
					(Some(key_type), Some(value_type)):
						{
							context = context,
							elements = [key_type, value_type],
							ok = True
						}
					_:
						{
							context = context,
							elements = [],
							ok = False
						}
			else:
				match iterable_element_type(iterable_type):
					Some(element_type):
						for_tuple_elements_from_iterable_element(context, element_type)
					None:
						for_tuple_iterable_error(context, iterable_type)
		_:
			match iterable_element_type(iterable_type):
				Some(element_type):
					for_tuple_elements_from_iterable_element(context, element_type)
				None:
					for_tuple_iterable_error(context, iterable_type)


private pure func for_redeclaration_error(context: InferContext, name: String) -> InferContext:
	infer_error(context, "Cannot redeclare `" + name + "` in for loop")


private pure func check_for_tuple_redeclarations(
	context: InferContext,
	names: List[ParsedIdentifier],
) -> InferContext:
	var next_context: InferContext = context
	var seen: List[String] = []

	for name in names:
		if name.text != "_":
			if (
				env_lookup_in_current_scope(context.state.env, name.text).is_some()
				or seen.contains(name.text)
			):
				next_context = for_redeclaration_error(next_context, name.text)

			seen = seen.append(name.text)

	next_context


private pure func tuple_binding_type(element_types: List[SemanticType], index: Int) -> SemanticType:
	match element_types.get(index):
		Some(typ):
			typ
		None:
			TYPE_VOID


private pure func add_tuple_for_bindings(
	env: Env,
	names: List[ParsedIdentifier],
	element_types: List[SemanticType],
) -> Env:
	var next_env: Env = env
	var index: Int = 0

	while index < names.length():
		match names.get(index):
			Some(name):
				if name.text != "_":
					elem_type = tuple_binding_type(element_types, index)
					next_env = env_add_var_with_details(
						next_env,
						name.text,
						elem_type,
						Some(elem_type),
						ImmutableBinding,
						ForLoopVar,
						UNREFINED_BINDING,
					)
			None:
				void

		index += 1

	next_env


private pure func for_name_binding_type(
	loop_view: Option[TypedLoopView],
	iterable: TypedExpr,
	fallback: SemanticType,
) -> SemanticType:
	match loop_view:
		Some(view):
			typed_loop_view_element_type(view)
		None:
			match iterable:
				TypedRangeExpr(start_expr, end_expr, _, _):
					match (
						typed_expr_semantic_type(start_expr),
						typed_expr_semantic_type(end_expr),
					):
						(SemanticConstIntType(start), SemanticConstIntType(end)):
							if start >= 0 and end > start:
								SemanticRangeType(SemanticConstIntType(end))
							else:
								fallback
						(SemanticConstIntType(0), end_type):
							loop_index_type(end_type)
						_:
							fallback
				_:
					fallback


private pure func for_name_binding_refinement(iterable: TypedExpr) -> ValueProofs:
	match iterable:
		TypedRangeExpr(start_expr, end_expr, _, _):
			match (typed_expr_semantic_type(start_expr), typed_expr_semantic_type(end_expr)):
				(SemanticConstIntType(start), SemanticConstIntType(end)):
					match range_upper_lit(end):
						Some(upper):
							match make_range_proof_with_source(start, upper, ProofSourceLoopRange):
								Some(proof):
									range_binding(proof)
								None:
									UNREFINED_BINDING
						None:
							UNREFINED_BINDING
				_:
					UNREFINED_BINDING
		_:
			UNREFINED_BINDING


private pure func resource_source_parts(typ: SemanticType) -> Option[(SemanticType, SemanticType)]:
	match typ:
		SemanticNamedType(name, args):
			if is_resource_source_type_name(name):
				match args:
					[resource_type, error_type]:
						Some((resource_type, error_type))
					_:
						None
			else:
				None
		_:
			None


private pure func resource_loop_item_identifier(
	label: String,
	span: SourceSpan,
) -> ParsedIdentifier:
	{
		text = "__resource_" + label + "_" + span.start_line.to_string() + "_" + span.start_column.to_string(),
		span = span
	}


private pure func scope_resource_loop_body(
	context: InferContext,
	name: ParsedIdentifier,
	item_name: ParsedIdentifier,
	resource_type: SemanticType,
	body: TypedExpr,
	span: SourceSpan,
) -> TypedExpr:
	resource_info = inferred_info(context, resource_type)
	void_info = inferred_info(context, TYPE_VOID)
	item_value = TypedNameExpr(item_name, resource_info)

	discarded_body = if named_value_type_is(typed_expr_value_type(body), "Void"):
		body
	else:
		TypedBlockExpr(
			[body, TypedVoidExpr(span, void_info)],
			span,
			void_info,
		)

	binding: TypedWithBinding = {
		name = name,
		annotation = None,
		value = item_value,
		kind = ParsedWithPlainBinding,
		error_map = None,
		cleanup_function = with_cleanup_function(context, resource_type),
		resource_loop_item_name = Some(item_name.text),
		span = span
	}

	TypedWithExpr(binding, discarded_body, span, void_info)


private pure func infer_for_expr(
	context: InferContext,
	binder: ParsedForBinder,
	iterable: ParsedExpr,
	body: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	iter_result = infer_expr(infer_without_expected(context), iterable)
	iter_type = typed_expr_semantic_type(iter_result.expr)
	loop_view = typed_loop_view(iter_result.expr)
	is_fallible_stream = is_fallible_stream_iterable_type(iter_type)

	match binder:
		ParsedForNameBinder(name):
			element_result = match loop_view:
				Some(view):
					Some(typed_loop_view_element_type(view))
				None:
					iterable_element_type(iter_type)

			binding_origin = iterable_binding_origin(iter_type)

			after_iter_context = if is_fallible_stream:
				fallible_stream_for_iterable_error(iter_result.context)
			else:
				match element_result:
					Some(_):
						iter_result.context
					None:
						infer_error(
							iter_result.context,
							"Cannot iterate over type " + type_to_string(iter_type) + ((
								". For-in loops work with Channel, Dict, List, Vector, Set, Stream, String, and "
								+ "Range types"
							)),
						)

			redeclared = if name.text == "_":
				False
			else:
				env_lookup_in_current_scope(after_iter_context.state.env, name.text).is_some()

			checked_context = if redeclared:
				for_redeclaration_error(after_iter_context, name.text)
			else:
				after_iter_context

			base_elem_type = if is_fallible_stream:
				iter_type
			else:
				match element_result:
					Some(typ):
						typ
					None:
						TYPE_VOID

			elem_type = for_name_binding_type(loop_view, iter_result.expr, base_elem_type)

			loop_env = env_push_scope(checked_context.state.env)

			bound_env = if name.text == "_":
				loop_env
			else:
				env_add_var_with_details(
					loop_env,
					name.text,
					elem_type,
					Some(elem_type),
					ImmutableBinding,
					binding_origin,
					for_name_binding_refinement(iter_result.expr),
				)

			loop_state = { checked_context.state | env = bound_env }
			loop_context = infer_loop_body_context(
				infer_context_with_state(
					checked_context,
					loop_state,
				),
			)

			body_result = if is_fallible_stream:
				infer_result(
					checked_context,
					TypedMissingExpr(
						span,
						inferred_info(checked_context, TYPE_VOID),
					),
				)
			else:
				infer_expr(loop_context, body)

			outer_env = env_pop_scope(body_result.context.state.env)
			outer_state = { body_result.context.state | env = outer_env }
			result_context = infer_context_with_state(context, outer_state)

			(lowered_binder, lowered_body) = match resource_source_parts(iter_type):
				Some((resource_type, _)):
					item_name = resource_loop_item_identifier("item", span)
					(
						ParsedForNameBinder(item_name),
						scope_resource_loop_body(
							body_result.context,
							name,
							item_name,
							resource_type,
							body_result.expr,
							span,
						),
					)
				None:
					(binder, body_result.expr)

			typed = TypedForExpr(
				lowered_binder,
				iter_result.expr,
				loop_view,
				lowered_body,
				span,
				inferred_info(result_context, TYPE_VOID),
			)
			infer_result(result_context, typed)
		ParsedForTupleBinder(names, _):
			tuple_elements = if is_fallible_stream:
				{
					context = iter_result.context,
					elements = [],
					ok = False
				}
			else:
				match loop_view:
					Some(view):
						for_tuple_elements_from_iterable_element(
							iter_result.context,
							typed_loop_view_element_type(view),
						)
					None:
						for_tuple_element_types(iter_result.context, iter_type)

			arity_context = if tuple_elements.ok:
				if names.length() == tuple_elements.elements.length():
					tuple_elements.context
				else:
					infer_error(
						tuple_elements.context,
						"Tuple for-loop arity mismatch: expected " + names
							.length()
							.to_string() + " binders, got " + tuple_elements.elements
							.length()
							.to_string() + " tuple fields",
					)
			else:
				tuple_elements.context

			checked_context = check_for_tuple_redeclarations(arity_context, names)
			loop_env = env_push_scope(checked_context.state.env)
			bound_env = add_tuple_for_bindings(loop_env, names, tuple_elements.elements)
			loop_state = { checked_context.state | env = bound_env }
			loop_context = infer_loop_body_context(
				infer_context_with_state(
					checked_context,
					loop_state,
				),
			)

			body_result = if is_fallible_stream:
				fallible_stream_for_iterable_error_result(checked_context, span)
			else:
				infer_expr(loop_context, body)

			outer_env = env_pop_scope(body_result.context.state.env)
			outer_state = { body_result.context.state | env = outer_env }
			result_context = infer_context_with_state(context, outer_state)
			typed = TypedForExpr(
				binder,
				iter_result.expr,
				loop_view,
				body_result.expr,
				span,
				inferred_info(result_context, TYPE_VOID),
			)
			infer_result(result_context, typed)


private pure func assign_to_non_var_error(
	context: InferContext,
	name: String,
	kind: SymbolKind,
) -> InferContext:
	error_message: String = match kind:
		FuncSymbolKind(_):
			"Cannot assign to function '" + name + "'"
		TypeSymbolKind(_):
			"Cannot assign to type name '" + name + "'"
		RecordSymbolKind(_):
			"Cannot assign to record type '" + name + "'"
		ConstructorSymbolKind(_):
			"Cannot assign to constructor '" + name + "'"
		AliasSymbolKind(_):
			"Cannot assign to type alias '" + name + "'"
		OpaqueAliasSymbolKind(_):
			"Cannot assign to opaque type '" + name + "'"
		VarSymbolKind(_):
			"Cannot assign to variable '" + name + "'"

	infer_error(context, error_message)


private pure func assignable_context(
	context: InferContext,
	expected: SemanticType,
	found: SemanticType,
) -> Option[InferContext]:
	resolved_expected = infer_resolve_alias(context, expected)
	resolved_found = infer_resolve_alias(context, found)
	type_params = env_get_type_params(context.state.env)

	if types_compatible_with_params(type_params, resolved_expected, resolved_found):
		Some(context)
	else if type_contains_meta(resolved_expected) or type_contains_meta(resolved_found):
		match unify_symmetric(context.state.context, resolved_expected, resolved_found):
			Some(step):
				next_state = { context.state | context = step.context }
				Some(infer_context_with_state(context, next_state))
			None:
				None
	else:
		None


private pure func infer_discard_assign_expr(
	context: InferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	value_result = infer_expr(infer_without_expected(context), value)
	typed = TypedAssignExpr(
		name,
		LocalAssignScope,
		value_result.expr,
		span,
		inferred_info(value_result.context, TYPE_VOID),
	)

	infer_result(value_result.context, typed)


private pure func infer_implicit_assign_binding(
	context: InferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	value_result = infer_expr(infer_without_expected(context), value)
	binding_type = typed_expr_semantic_type(value_result.expr)
	source_type = typed_expr_source_type(value_result.expr)
	initializer = typed_expr_with_slot(value_result.expr, KeptValueSlot(binding_type))
	checked_context = check_resource_capability_binding(
		value_result.context,
		name.text,
		binding_type,
		False,
		value,
	)
	binding_origin = binding_origin_for_initializer(checked_context, initializer)
	next_env = env_add_var_with_details(
		checked_context.state.env,
		name.text,
		binding_type,
		source_type,
		ImmutableBinding,
		binding_origin,
		UNREFINED_BINDING,
	)
	next_state = { checked_context.state | env = next_env }
	next_context = infer_context_with_state(checked_context, next_state)
	typed = TypedVarDeclExpr(
		{
			name = name,
			annotation = Some(binding_type),
			initializer = initializer,
			is_mutable = False,
			span = span
		},
		inferred_info(
			next_context,
			TYPE_VOID,
		),
	)

	infer_result(next_context, typed)


private pure func infer_mutable_assign_expr(
	context: InferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: SourceSpan,
	assign_scope: TypedAssignScope,
	var_type: SemanticType,
	definition_id: Option[Int],
) -> InferResult:
	current_var_type = resolve_type_metas(context.state.context, var_type)
	value_result = infer_expr(
		infer_with_canonical_expected_value_slot(context, current_var_type, ExpectedArgumentSlot),
		value,
	)
	value_type = typed_expr_value_type(value_result.expr)

	next_context = match assignable_context(value_result.context, current_var_type, value_type):
		Some(compatible_context):
			compatible_context
		None:
			infer_error(
				value_result.context,
				"Cannot assign to variable '" + name.text + "'\n    expected: " + type_to_string(
					current_var_type,
				) + "\n       found: " + type_to_string(value_type),
			)

	typed = TypedAssignExpr(
		name,
		assign_scope,
		value_result.expr,
		span,
		{ inferred_info(next_context, TYPE_VOID) | resolved_definition_id = definition_id },
	)

	infer_result(next_context, typed)


private pure func infer_invalid_assign_target_result(
	context: InferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	typed_value = TypedUnsupportedExpr(
		"assignment value",
		parsed_expr_span(value),
		inferred_info(context, TYPE_VOID),
	)
	typed = TypedAssignExpr(
		name,
		LocalAssignScope,
		typed_value,
		span,
		inferred_info(context, TYPE_VOID),
	)

	infer_result(context, typed)


private pure func accepted_type_assignment_error(
	context: InferContext,
	name: String,
) -> Option[String]:
	view = context.state.facts.module_view

	constructor_error = match module_view_accepted_union_type_index(view):
		Some(index):
			match union_type_index_find_constructor_symbol(index, name):
				Some(_):
					Some("Cannot assign to constructor '" + name + "'")
				None:
					None
		None:
			None

	match constructor_error:
		Some(message):
			Some(message)
		None:
			record_error = match module_view_accepted_record_type_index(view):
				Some(index):
					if record_type_index_contains(index, name):
						Some("Cannot assign to record type '" + name + "'")
					else:
						None
				None:
					None

			match record_error:
				Some(message):
					Some(message)
				None:
					union_error = match module_view_accepted_union_type_index(view):
						Some(index):
							if union_type_index_contains(index, name):
								Some("Cannot assign to type name '" + name + "'")
							else:
								None
						None:
							None

					match union_error:
						Some(message):
							Some(message)
						None:
							match module_view_accepted_type_alias_index(view):
								Some(index):
									if type_alias_index_find_opaque(index, name).is_some():
										Some("Cannot assign to opaque type '" + name + "'")
									else if type_alias_index_find_transparent(
										index,
										name,
									).is_some():
										Some("Cannot assign to type alias '" + name + "'")
									else:
										None
								None:
									None


private pure func infer_implicit_assign_or_type_error(
	context: InferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	match accepted_type_assignment_error(context, name.text):
		Some(message):
			next_context = infer_error(context, message)
			infer_invalid_assign_target_result(next_context, name, value, span)
		None:
			infer_implicit_assign_binding(context, name, value, span)


private pure func infer_assign_to_var_symbol(
	context: InferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: SourceSpan,
	scope: TypedAssignScope,
	var_symbol: VarSymbol,
) -> InferResult:
	if var_mutability_is_mutable(var_symbol.mutability):
		infer_mutable_assign_expr(
			context,
			name,
			value,
			span,
			scope,
			var_symbol.var_type,
			var_symbol.definition_id,
		)
	else:
		next_context = infer_error(
			context,
			"Cannot assign to immutable variable '" + name.text + "'",
		)
		infer_invalid_assign_target_result(next_context, name, value, span)


private pure func infer_assign_expr(
	context: InferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	match env_lookup_with_scope_depth(context.state.env, name.text):
		None:
			if name.text == "_":
				infer_discard_assign_expr(context, name, value, span)
			else:
				match accepted_visible_global_symbol(context, name.text):
					Some(symbol):
						match symbol.kind:
							VarSymbolKind(var_symbol):
								infer_assign_to_var_symbol(
									context,
									name,
									value,
									span,
									ModuleAssignScope,
									var_symbol,
								)
							_:
								infer_implicit_assign_or_type_error(context, name, value, span)
					None:
						infer_implicit_assign_or_type_error(context, name, value, span)
		Some(lookup):
			match lookup.symbol.kind:
				VarSymbolKind(var_symbol):
					scope = if env_lookup_is_outermost_scope(context.state.env, lookup):
						ModuleAssignScope
					else:
						LocalAssignScope

					infer_assign_to_var_symbol(context, name, value, span, scope, var_symbol)
				_:
					if env_lookup_in_current_scope(context.state.env, name.text).is_none():
						infer_implicit_assign_or_type_error(context, name, value, span)
					else:
						next_context = assign_to_non_var_error(
							context,
							name.text,
							lookup.symbol.kind,
						)
						infer_invalid_assign_target_result(next_context, name, value, span)


private pure func compound_assign_binary_op(op: ParsedCompoundAssignOp) -> ParsedBinaryOp:
	match op:
		ParsedAssignAddOp:
			ParsedAddOp
		ParsedAssignSubtractOp:
			ParsedSubtractOp
		ParsedAssignMultiplyOp:
			ParsedMultiplyOp
		ParsedAssignDivideOp:
			ParsedDivideOp


private pure func infer_compound_assign_expr(
	context: InferContext,
	name: ParsedIdentifier,
	op: ParsedCompoundAssignOp,
	value: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	rhs = ParsedBinaryExpr(compound_assign_binary_op(op), ParsedNameExpr(name), value, span)
	infer_assign_expr(context, name, rhs, span)


private pure func infer_var_decl_expr(
	context: InferContext,
	name: ParsedIdentifier,
	annotation: Option[ParsedTypeExpr],
	value: ParsedExpr,
	is_mutable: Bool,
	span: SourceSpan,
) -> InferResult:
	source_declared_type: Option[SemanticType] = annotation.map(type_from_parsed_type_expr)
	semantic_declared_type: Option[SemanticType] = source_declared_type.map(
		func(typ): infer_canonical_expected_type(context, typ),
	)

	value_context = match semantic_declared_type:
		Some(typ):
			infer_with_canonical_expected_value_slot(context, typ, ExpectedArgumentSlot)
		None:
			infer_without_expected(context)

	value_result = infer_expr(value_context, value)
	value_type = typed_expr_value_type(value_result.expr)

	binding_type = match semantic_declared_type:
		Some(typ):
			typ
		None:
			typed_expr_semantic_type(value_result.expr)

	source_type = match source_declared_type:
		Some(typ):
			Some(typ)
		None:
			typed_expr_source_type(value_result.expr)

	checked_context = match (source_declared_type, semantic_declared_type):
		(Some(source_type), Some(semantic_type)):
			match assignable_context(value_result.context, semantic_type, value_type):
				Some(compatible_context):
					compatible_context
				None:
					infer_error(
						value_result.context,
						"Binding `" + name.text + "` declared as `" + type_to_string(
							source_type,
						) + "` but initializer has type `" + type_to_string(value_type) + "`",
					)
		_:
			value_result.context

	initializer_slot = if is_mutable:
		mutable_binding_slot(binding_type)
	else:
		KeptValueSlot(binding_type)

	initializer = typed_expr_with_slot(value_result.expr, initializer_slot)
	binding_checked_context = check_resource_capability_binding(
		checked_context,
		name.text,
		binding_type,
		is_mutable,
		value,
	)

	binding_origin = if is_mutable:
		LetBinding
	else:
		binding_origin_for_initializer(binding_checked_context, initializer)

	next_env = env_add_var_with_details(
		binding_checked_context.state.env,
		name.text,
		binding_type,
		source_type,
		var_mutability(is_mutable),
		binding_origin,
		UNREFINED_BINDING,
	)
	next_state = { binding_checked_context.state | env = next_env }
	next_context = infer_context_with_state(binding_checked_context, next_state)
	typed = TypedVarDeclExpr(
		{
			name = name,
			annotation = source_declared_type,
			initializer = initializer,
			is_mutable = is_mutable,
			span = span
		},
		inferred_info(
			next_context,
			TYPE_VOID,
		),
	)

	infer_result(next_context, typed)


private pure func question_bind_carrier(
	context: InferContext,
	typ: SemanticType,
) -> QuestionBindCarrier:
	resolved = infer_resolve_alias(context, typ)

	match resolved:
		SemanticNamedType(name, args):
			if name == "Option" and args.length() == 1:
				match args.get(0):
					Some(inner_type):
						QuestionBindOptionCarrier(inner_type)
					None:
						QuestionBindNonCarrier
			else if name == "Result" and args.length() == 2:
				match (args.get(0), args.get(1)):
					(Some(ok_type), Some(error_type)):
						QuestionBindResultCarrier(ok_type, error_type)
					_:
						QuestionBindNonCarrier
			else:
				QuestionBindNonCarrier
		_:
			QuestionBindNonCarrier


private pure func optional_question_bind_annotation_type(
	context: InferContext,
	annotation: Option[ParsedTypeExpr],
) -> Option[SemanticType]:
	match annotation:
		Some(type_expr):
			Some(infer_canonical_expected_type(context, type_from_parsed_type_expr(type_expr)))
		None:
			None


private pure func question_bind_annotation_context(
	context: InferContext,
	annotation_type: Option[SemanticType],
	inner_type: SemanticType,
) -> InferContext:
	match annotation_type:
		Some(annotated_type):
			if types_equal(annotated_type, inner_type):
				context
			else:
				infer_error(
					context,
					"Type annotation `" + type_to_string(
						annotated_type,
					) + "` does not match unwrapped type `" + type_to_string(inner_type) + "`",
				)
		None:
			context


private pure func question_bind_result(
	context: InferContext,
	name: ParsedIdentifier,
	annotation_type: Option[SemanticType],
	value: TypedExpr,
	binding_type: SemanticType,
	span: SourceSpan,
) -> InferResult:
	next_env = if name.text == "_":
		context.state.env
	else:
		env_add_var_with_details(
			context.state.env,
			name.text,
			binding_type,
			Some(binding_type),
			ImmutableBinding,
			LetBinding,
			UNREFINED_BINDING,
		)

	next_state = { context.state | env = next_env }
	next_context = infer_context_with_state(context, next_state)
	typed = TypedQuestionBindExpr(
		name,
		annotation_type,
		value,
		span,
		inferred_info(next_context, binding_type),
	)

	infer_result(next_context, typed)


private pure func question_bind_error_result(
	context: InferContext,
	name: ParsedIdentifier,
	annotation_type: Option[SemanticType],
	value: TypedExpr,
	span: SourceSpan,
) -> InferResult:
	typed = TypedQuestionBindExpr(
		name,
		annotation_type,
		value,
		span,
		inferred_info(context, TYPE_VOID),
	)

	infer_result(context, typed)


private pure func validate_question_bind(
	context: InferContext,
	name: ParsedIdentifier,
	annotation_type: Option[SemanticType],
	value: TypedExpr,
	inner_type: SemanticType,
	span: SourceSpan,
) -> InferResult:
	annotated_context = question_bind_annotation_context(context, annotation_type, inner_type)

	binding_type = match annotation_type:
		Some(annotated_type):
			annotated_type
		None:
			inner_type

	if annotated_context.state.errors.length() == context.state.errors.length():
		question_bind_result(annotated_context, name, annotation_type, value, binding_type, span)
	else:
		question_bind_error_result(annotated_context, name, annotation_type, value, span)


private pure func infer_question_bind_statement(
	context: InferContext,
	name: ParsedIdentifier,
	annotation: Option[ParsedTypeExpr],
	value: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	annotation_type = optional_question_bind_annotation_type(context, annotation)
	value_result = infer_expr(infer_without_expected(context), value)
	value_context = infer_context_with_state(context, value_result.context.state)
	value_type = typed_expr_value_type(value_result.expr)

	if context.in_loop:
		next = infer_error(value_context, "?= cannot be used inside loop bodies")
		question_bind_error_result(next, name, annotation_type, value_result.expr, span)
	else:
		expected_carrier = match infer_context_expected_type(context):
			Some(expected_type):
				question_bind_carrier(context, expected_type)
			None:
				QuestionBindNonCarrier

		value_carrier = question_bind_carrier(value_context, value_type)

		match (expected_carrier, value_carrier):
			(QuestionBindOptionCarrier(_), QuestionBindOptionCarrier(inner_type)):
				validate_question_bind(
					value_context,
					name,
					annotation_type,
					value_result.expr,
					inner_type,
					span,
				)
			(QuestionBindOptionCarrier(_), QuestionBindResultCarrier(_, _)):
				next = infer_error(
					value_context,
					(
						"Cannot use Result ?= in a block returning Option. Convert the Result to Option "
						+ "or return Result from the enclosing function"
					),
				)
				question_bind_error_result(next, name, annotation_type, value_result.expr, span)
			(QuestionBindResultCarrier(_, expected_error_type), QuestionBindResultCarrier(inner_type, actual_error_type)):
				if types_equal(expected_error_type, actual_error_type):
					validate_question_bind(
						value_context,
						name,
						annotation_type,
						value_result.expr,
						inner_type,
						span,
					)
				else:
					next = infer_error(
						value_context,
						"Incompatible error type for ?=: enclosing block returns Result[..., " + type_to_string(
							expected_error_type,
						) + "], but expression returns Result[..., " + type_to_string(
							actual_error_type,
						) + "]",
					)
					question_bind_error_result(next, name, annotation_type, value_result.expr, span)
			(QuestionBindResultCarrier(_, _), QuestionBindOptionCarrier(_)):
				next = infer_error(
					value_context,
					(
						"Cannot use Option ?= in a block returning Result. Convert the Option to Result "
						+ "with to_result(...) or return Option from the enclosing function"
					),
				)
				question_bind_error_result(next, name, annotation_type, value_result.expr, span)
			(QuestionBindNonCarrier, QuestionBindOptionCarrier(_)):
				next = match infer_context_expected_type(context):
					Some(expected_type):
						infer_error(
							value_context,
							(
								"?= requires the enclosing block to return the same carrier as the expression; "
								+ "enclosing block returns "
							) + type_to_string(expected_type),
						)
					None:
						infer_error(
							value_context,
							"?= requires an enclosing block returning Option[T] or Result[T, E]",
						)

				question_bind_error_result(next, name, annotation_type, value_result.expr, span)
			(QuestionBindNonCarrier, QuestionBindResultCarrier(_, _)):
				next = match infer_context_expected_type(context):
					Some(expected_type):
						infer_error(
							value_context,
							(
								"?= requires the enclosing block to return the same carrier as the expression; "
								+ "enclosing block returns "
							) + type_to_string(expected_type),
						)
					None:
						infer_error(
							value_context,
							"?= requires an enclosing block returning Option[T] or Result[T, E]",
						)

				question_bind_error_result(next, name, annotation_type, value_result.expr, span)
			(_, QuestionBindNonCarrier):
				next = infer_error(
					value_context,
					"Cannot use `?=` on type `" + type_to_string(
						value_type,
					) + "` — only Option and Result support ?= bindings",
				)
				question_bind_error_result(next, name, annotation_type, value_result.expr, span)


private pure func question_bind_final_result(
	context: InferContext,
	name: ParsedIdentifier,
	annotation: Option[ParsedTypeExpr],
	span: SourceSpan,
) -> InferResult:
	annotation_type = optional_question_bind_annotation_type(context, annotation)
	next = infer_error(context, "?= binding must be followed by a result expression")
	value = TypedMissingExpr(
		span,
		inferred_info(next, TYPE_VOID),
	)
	question_bind_error_result(next, name, annotation_type, value, span)


private pure func infer_block_items(
	context: InferContext,
	exprs: List[ParsedExpr],
	index: Int,
	typed_exprs: List[TypedExpr],
	block_span: SourceSpan,
) -> InferResult:
	if index >= exprs.length():
		typed = TypedBlockExpr(
			typed_exprs,
			block_span,
			inferred_info(context, TYPE_VOID),
		)
		infer_result(context, typed)
	else:
		match exprs.get(index):
			Some(ParsedQuestionBindExpr(name, annotation, value, span)):
				is_last: Bool = index == exprs.length() - 1

				if is_last:
					item_result = question_bind_final_result(context, name, annotation, span)
					next_exprs = typed_exprs.append(item_result.expr)
					typed = TypedBlockExpr(
						next_exprs,
						block_span,
						inferred_info(item_result.context, TYPE_VOID),
					)
					infer_result(item_result.context, typed)
				else:
					item_result = infer_question_bind_statement(
						context,
						name,
						annotation,
						value,
						span,
					)
					next_exprs = typed_exprs.append(item_result.expr)
					infer_block_items(item_result.context, exprs, index + 1, next_exprs, block_span)
			Some(expr):
				is_last: Bool = index == exprs.length() - 1

				item_context = if is_last:
					context
				else:
					infer_without_expected(context)

				item_result = infer_expr(item_context, expr)
				next_exprs = typed_exprs.append(item_result.expr)

				if is_last:
					typed = TypedBlockExpr(
						next_exprs,
						block_span,
						typed_expr_info(item_result.expr),
					)
					infer_result(item_result.context, typed)
				else:
					preserved_context = infer_context_with_state(context, item_result.context.state)
					infer_block_items(preserved_context, exprs, index + 1, next_exprs, block_span)
			None:
				typed = TypedBlockExpr(
					typed_exprs,
					block_span,
					inferred_info(context, TYPE_VOID),
				)
				infer_result(context, typed)


private pure func infer_block_expr(
	context: InferContext,
	exprs: List[ParsedExpr],
	span: SourceSpan,
) -> InferResult:
	inner_env = env_push_scope(context.state.env)
	inner_state = { context.state | env = inner_env }
	inner_context = infer_context_with_state(context, inner_state)

	result = if exprs.length() == 0:
		typed = TypedBlockExpr(
			[],
			span,
			inferred_info(inner_context, TYPE_VOID),
		)
		infer_result(inner_context, typed)
	else:
		infer_block_items(inner_context, exprs, 0, [], span)

	outer_env = env_pop_scope(result.context.state.env)
	outer_state = { result.context.state | env = outer_env }
	outer_context = infer_context_with_state(result.context, outer_state)

	block_items: List[TypedExpr] = match result.expr:
		TypedBlockExpr(items, _, _):
			items
		_:
			[]

	infer_result(
		outer_context,
		TypedBlockExpr(block_items, span, typed_expr_info(result.expr)),
	)


private pure func infer_debug_block_expr(
	context: InferContext,
	body: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	body_context = { infer_without_expected(context) | in_debug = True }
	body_result = infer_expr(body_context, body)
	result_context = infer_context_with_state(context, body_result.context.state)
	typed = TypedDebugBlockExpr(
		body_result.expr,
		span,
		inferred_info(result_context, TYPE_VOID),
	)

	infer_result(result_context, typed)


private pure func check_concurrent_param_names(
	context: InferContext,
	params: List[ParsedConcurrentParam],
) -> InferContext:
	var next_context = context
	var seen: List[String] = []

	for param in params:
		name = param.name.text

		if not (name == CONCURRENT_PARAM_MAX_THREADS or name == CONCURRENT_PARAM_TIMEOUT):
			next_context = infer_error(next_context, "Unknown concurrent parameter `" + name + "`")
		else if seen.contains(name):
			next_context = infer_error(
				next_context,
				"Duplicate concurrent parameter `" + name + "`",
			)
		else:
			seen = seen.append(name)

	next_context


private pure func infer_concurrent_params(
	context: InferContext,
	params: List[ParsedConcurrentParam],
) -> InferConcurrentParamsResult:
	var next_context = check_concurrent_param_names(context, params)
	var typed_params: List[TypedConcurrentParam] = []

	for param in params:
		param_context = infer_with_canonical_expected_value_slot(
			infer_without_expected(next_context),
			TYPE_INT,
			ExpectedArgumentSlot,
		)
		value_result = infer_expr(param_context, param.value)
		typed_params = typed_params.append({
			name = param.name,
			value = value_result.expr,
			span = param.span,
		})
		next_context = infer_context_with_state(next_context, value_result.context.state)

	{
		context = next_context,
		params = typed_params
	}


private pure func check_concurrent_body_shape(
	context: InferContext,
	body: ParsedExpr,
) -> InferContext:
	match body:
		ParsedBlockExpr(items, _):
			if items.length() == 0:
				infer_error(context, "concurrent: block cannot be empty")
			else:
				var next_context = context

				for item in items:
					match item:
						ParsedAssignExpr(_, _, _):
							void
						ParsedVarDeclExpr(_, _, _, False, _):
							void
						ParsedVarDeclExpr(_, _, _, True, _):
							next_context = infer_error(
								next_context,
								"concurrent bindings cannot be mutable (var)",
							)
						_:
							next_context = infer_error(
								next_context,
								"concurrent: block must contain only bindings (name = expr)",
							)

				next_context
		_:
			infer_error(context, "concurrent: body must be a block")


private pure func concurrent_binding_name(item: ParsedExpr) -> Option[String]:
	match item:
		ParsedAssignExpr(name, _, _):
			Some(name.text)
		ParsedVarDeclExpr(name, _, _, False, _):
			Some(name.text)
		_:
			None


private pure func concurrent_binding_value(item: ParsedExpr) -> Option[ParsedExpr]:
	match item:
		ParsedAssignExpr(_, value, _):
			Some(value)
		ParsedVarDeclExpr(_, _, value, False, _):
			Some(value)
		_:
			None


private pure func check_duplicate_concurrent_bindings(
	context: InferContext,
	items: List[ParsedExpr],
) -> InferContext:
	var next_context = context
	var seen: List[String] = []

	for item in items:
		match concurrent_binding_name(item):
			Some(name):
				if seen.contains(name):
					next_context = infer_error(
						next_context,
						"Duplicate concurrent binding `" + name + "`",
					)
				else:
					seen = seen.append(name)
			None:
				void

	next_context


private pure func unavailable_concurrent_binding_refs(
	context: InferContext,
	binding_names: List[String],
	value: ParsedExpr,
) -> List[String]:
	refs = free_var_refs_in_expr(free_var_facts(context), [], value)
	var result: List[String] = []

	for name in refs:
		if binding_names.contains(name) and env_lookup(context.state.env, name).is_none():
			result = name_list_add_unique(result, name)

	result


private pure func concurrent_sibling_ref_message(
	current_name: String,
	refs: List[String],
) -> String:
	if refs.length() == 1:
		name = refs.get_or(0, "")

		if name == current_name:
			"concurrent binding `" + name + "` is not available inside its own task"
		else:
			"concurrent binding `" + name + "` is not available inside another concurrent task"
	else:
		joined = join_names(refs)
		"concurrent bindings " + joined + " are not available inside sibling concurrent tasks"


private pure func check_concurrent_sibling_binding_refs(
	context: InferContext,
	binding_names: List[String],
	current_name: String,
	value: ParsedExpr,
) -> InferContext:
	refs = unavailable_concurrent_binding_refs(context, binding_names, value)

	if refs.length() == 0:
		context
	else:
		infer_error(
			context,
			concurrent_sibling_ref_message(current_name, refs),
		)


private pure func task_capture_error(
	context: InferContext,
	task_label: String,
	capture_label: String,
	names: List[String],
) -> InferContext:
	plural = if names.length() == 1:
		""
	else:
		"s"

	infer_error(
		context,
		task_label + " cannot capture " + capture_label + plural + ": " + join_names(names),
	)


private pure func check_task_captures(
	context: InferContext,
	task_label: String,
	bound: List[String],
	body: ParsedExpr,
) -> InferContext:
	free_refs = free_var_refs_in_expr(free_var_facts(context), bound, body)
	resource_captures = scoped_resource_capture_names(context.state.env, free_refs)
	resource_capabilities = resource_capability_capture_names(
		resource_type_facts(context),
		free_refs,
	)
	source_captures = resource_capabilities.resource_sources
	derived_captures = scoped_resource_derived_capture_names(context.state.env, free_refs)
	stream_captures = resource_capabilities.one_shot_streams
	mutable_captures = mutable_capture_names(context.state, free_refs)

	if resource_captures.length() > 0:
		task_capture_error(context, task_label, "scoped resource", resource_captures)
	else if source_captures.length() > 0:
		task_capture_error(context, task_label, "resource source value", source_captures)
	else if derived_captures.length() > 0:
		task_capture_error(context, task_label, "scoped resource-derived value", derived_captures)
	else if stream_captures.length() > 0:
		task_capture_error(context, task_label, "one-shot stream value", stream_captures)
	else if mutable_captures.length() > 0:
		task_capture_error(context, task_label, "mutable variable", mutable_captures)
	else:
		context


private pure func check_concurrent_block_task_rules(
	context: InferContext,
	body: ParsedExpr,
) -> InferContext:
	match body:
		ParsedBlockExpr(items, _):
			binding_names = items.filter_map(func(item): concurrent_binding_name(item))
			var next_context = check_duplicate_concurrent_bindings(context, items)

			for item in items:
				match (concurrent_binding_name(item), concurrent_binding_value(item)):
					(Some(name), Some(value)):
						sibling_context = check_concurrent_sibling_binding_refs(
							next_context,
							binding_names,
							name,
							value,
						)
						next_context = check_task_captures(
							sibling_context,
							"concurrent task",
							[],
							value,
						)
					_:
						void

			next_context
		_:
			context


private pure func type_result(ok_type: SemanticType, error_type: SemanticType) -> SemanticType:
	SemanticNamedType(
		"Result",
		[ok_type, error_type],
	)


private pure func concurrent_annotation_task_value_type(
	canonical_annotation_type: Option[SemanticType],
) -> Option[SemanticType]:
	match canonical_annotation_type:
		Some(canonical_type):
			match canonical_type:
				SemanticNamedType(name, args):
					if name == "Result" and args.length() == 2:
						match args.get(0):
							Some(value_type):
								Some(value_type)
							None:
								None
					else:
						None
				_:
					None
		None:
			None


private pure func concurrent_binding_annotation_context(
	context: InferContext,
	canonical_annotation_type: Option[SemanticType],
	result_type: SemanticType,
) -> InferContext:
	match canonical_annotation_type:
		Some(canonical_type):
			type_params = env_get_type_params(context.state.env)

			if types_compatible_with_params(type_params, canonical_type, result_type):
				context
			else:
				infer_error(
					context,
					"Type annotation `" + type_to_string(
						canonical_type,
					) + "` does not match concurrent result type `" + type_to_string(
						result_type,
					) + "`",
				)
		None:
			context


private pure func infer_concurrent_binding_value_context(
	context: InferContext,
	canonical_annotation_type: Option[SemanticType],
) -> InferContext:
	match concurrent_annotation_task_value_type(canonical_annotation_type):
		Some(value_type):
			infer_with_canonical_expected_value_slot(context, value_type, ExpectedArgumentSlot)
		None:
			infer_without_expected(context)


private pure func add_concurrent_result_binding(
	env: Env,
	name: ParsedIdentifier,
	result_type: SemanticType,
) -> Env:
	if name.text == "_":
		env
	else:
		env_add_var_with_details(
			env,
			name.text,
			result_type,
			Some(result_type),
			ImmutableBinding,
			LetBinding,
			UNREFINED_BINDING,
		)


record InferConcurrentBindingsResult {
	context: InferContext,
	bindings: List[TypedConcurrentBinding]
}


private pure func infer_concurrent_bindings_from_items(
	context: InferContext,
	items: List[ParsedExpr],
	index: Int,
	base_env: Env,
	typed_bindings: List[TypedConcurrentBinding],
) -> InferConcurrentBindingsResult:
	if index >= items.length():
		{
			context = context,
			bindings = typed_bindings
		}
	else:
		match items.get(index):
			Some(item):
				binding_parts: Option[(ParsedIdentifier, Option[ParsedTypeExpr], ParsedExpr)] = match item:
					ParsedAssignExpr(name, value, _):
						Some((name, None, value))
					ParsedVarDeclExpr(name, annotation, value, False, _):
						Some((name, annotation, value))
					_:
						None

				match binding_parts:
					Some((name, parsed_annotation, value)):
						source_annotation_type = parsed_annotation.map(type_from_parsed_type_expr)
						base_state = { context.state | env = base_env }
						base_context = infer_context_with_state(context, base_state)

						declared_context = if (
							name.text == "_"
							or not env_lookup_in_current_scope(base_env, name.text).is_some()
						):
							base_context
						else:
							infer_error(
								base_context,
								"Cannot redeclare `" + name.text + "` in concurrent block",
							)

						canonical_annotation_type = source_annotation_type.map(
							func(
								source_type,
							): infer_canonical_expected_type(declared_context, source_type),
						)
						value_context = infer_concurrent_binding_value_context(
							declared_context,
							canonical_annotation_type,
						)
						value_result = infer_expr(value_context, value)
						value_type = typed_expr_value_type(value_result.expr)
						result_type = type_result(
							value_type,
							SemanticNamedType("ConcurrencyError", []),
						)
						value_state = { value_result.context.state | env = base_env }
						value_done_context = infer_context_with_state(context, value_state)
						checked_context = concurrent_binding_annotation_context(
							value_done_context,
							canonical_annotation_type,
							result_type,
						)
						result_env = add_concurrent_result_binding(
							context.state.env,
							name,
							result_type,
						)
						next_state = { checked_context.state | env = result_env }
						next_context = infer_context_with_state(context, next_state)
						typed: TypedConcurrentBinding = {
							name = name,
							annotation = source_annotation_type,
							value = value_result.expr,
							span = parsed_expr_span(item),
							info = inferred_info(next_context, result_type)
						}
						infer_concurrent_bindings_from_items(
							next_context,
							items,
							index + 1,
							base_env,
							typed_bindings.append(typed),
						)
					_:
						{
							context = context,
							bindings = []
						}
			None:
				{
					context = context,
					bindings = []
				}


private pure func infer_concurrent_block_bindings(
	context: InferContext,
	body: ParsedExpr,
) -> InferConcurrentBindingsResult:
	match body:
		ParsedBlockExpr(items, _):
			base_env = context.state.env
			infer_concurrent_bindings_from_items(context, items, 0, base_env, [])
		_:
			{
				context = context,
				bindings = []
			}


private pure func infer_concurrent_block_expr(
	context: InferContext,
	params: List[ParsedConcurrentParam],
	body: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	params_result = infer_concurrent_params(infer_without_expected(context), params)
	checked_context = check_concurrent_body_shape(params_result.context, body)
	task_context = check_concurrent_block_task_rules(checked_context, body)

	bindings_result = if task_context.state.errors.length() > params_result.context.state.errors.length():
		{
			context = task_context,
			bindings = []
		}
	else:
		infer_concurrent_block_bindings(infer_without_expected(task_context), body)

	result_context = infer_context_with_state(context, bindings_result.context.state)
	typed = TypedConcurrentBlockExpr(
		params_result.params,
		bindings_result.bindings,
		span,
		inferred_info(result_context, TYPE_VOID),
	)

	infer_result(result_context, typed)


private pure func infer_detach_expr(
	context: InferContext,
	body: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	capture_context = check_task_captures(context, "detach", [], body)
	body_result = infer_expr(infer_without_expected(capture_context), body)
	result_context = infer_context_with_state(context, body_result.context.state)
	typed = TypedDetachExpr(
		body_result.expr,
		span,
		inferred_info(result_context, TYPE_VOID),
	)

	infer_result(result_context, typed)


private pure func type_contains_resource_seen(
	context: InferContext,
	visited: List[String],
	typ: SemanticType,
) -> Bool:
	resolved = infer_resolve_alias_head(context, typ)

	match resolved:
		SemanticNamedType(name, args):
			if (
				known_type_index_has_resource(context.state.facts.known_type_index, name)
				or env_type_is_resource(context.state.env, name)
			):
				True
			else if args.any(func(arg): type_contains_resource_seen(context, visited, arg)):
				True
			else:
				match resource_type_contains_resource_if_valid(resource_type_facts(context), name):
					Some(contains_resource):
						contains_resource
					None:
						if visited.contains(name):
							False
						else:
							match named_type_component_types(
								resource_type_facts(context),
								name,
								args,
							):
								Some(components):
									components.any(func(component):
										type_contains_resource_seen(
											context,
											visited.append(name),
											component,
										)
									)
								None:
									False
		SemanticArrayType(element, dims):
			(
				type_contains_resource_seen(context, visited, element)
				or dims.any(func(dim): type_contains_resource_seen(context, visited, dim))
			)
		SemanticFunctionType(_, params, return_type):
			(
				params.any(func(param): type_contains_resource_seen(context, visited, param))
				or type_contains_resource_seen(context, visited, return_type)
			)
		SemanticTupleType(elements):
			elements.any(func(element): type_contains_resource_seen(context, visited, element))
		SemanticRangeType(inner):
			type_contains_resource_seen(context, visited, inner)
		SemanticDimOpType(_, left, right):
			(
				type_contains_resource_seen(context, visited, left)
				or type_contains_resource_seen(context, visited, right)
			)
		_:
			False


private pure func type_contains_resource(context: InferContext, typ: SemanticType) -> Bool:
	type_contains_resource_seen(context, [], typ)


private pure func is_resource_type(context: InferContext, typ: SemanticType) -> Bool:
	resolved = infer_resolve_alias(context, typ)

	match resolved:
		SemanticNamedType(name, args):
			(
				args.length() == 0
				and known_type_index_has_resource(context.state.facts.known_type_index, name)
			)
		_:
			False


private pure func check_with_binding_resource_type(
	context: InferContext,
	typ: SemanticType,
) -> InferContext:
	if is_resource_type(context, typ):
		context
	else:
		type_display: String = match typ:
			SemanticConstIntType(_):
				"Int"
			_:
				type_to_string(typ)

		infer_error(context, "with binding requires a resource type, got " + type_display)


private pure func check_with_binding_annotation(
	context: InferContext,
	annotation_type: Option[SemanticType],
	acquisition_type: SemanticType,
) -> InferContext:
	match annotation_type:
		Some(annotated_type):
			if types_equal(annotated_type, acquisition_type):
				context
			else:
				infer_error(
					context,
					"with binding annotation `" + type_to_string(
						annotated_type,
					) + "` does not match acquisition type `" + type_to_string(
						acquisition_type,
					) + "`",
				)
		None:
			context


private pure func check_with_body_resource_escape(
	context: InferContext,
	body_type: SemanticType,
	body: TypedExpr,
) -> InferContext:
	if type_contains_resource(context, body_type):
		infer_error(context, "scoped resource values cannot escape a with block")
	else:
		refs = typed_expr_resource_dependency_refs(context, body)

		if refs.length() > 0:
			infer_error(
				context,
				"scoped resource-derived values cannot escape a with block: " + refs.join(", "),
			)
		else:
			context


private pure func unavailable_parent_resource_names(
	context: InferContext,
	acquisition: TypedExpr,
) -> List[String]:
	var result: List[String] = []

	for name in typed_expr_resource_dependency_refs(context, acquisition):
		if env_is_scoped_resource_var(context.state.env, name) and not result.contains(name):
			result = result.append(name)

	result


private pure func shadow_parent_resource_unavailable(env: Env, owner: String, name: String) -> Env:
	match env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				VarSymbolKind(var_symbol):
					if env_is_scoped_resource_var(env, name):
						env_add_var_with_details(
							env,
							name,
							var_symbol.var_type,
							var_symbol.source_type,
							var_symbol.mutability,
							ScopedResourceUnavailable(owner),
							var_symbol.refinement,
						)
					else:
						env
				_:
					env
		None:
			env


private pure func infer_with_try_binding_result(
	context: InferContext,
	inner_type: SemanticType,
	error_map: Option[TypedWithErrorMap],
) -> InferWithTryBindingResult:
	{
		context = context,
		inner_type = inner_type,
		error_map = error_map
	}


private pure func infer_with_error_mapper(
	context: InferContext,
	mapper: ParsedWithErrorMap,
	actual_error_type: SemanticType,
	expected_error_type: SemanticType,
) -> InferWithTryBindingResult:
	mapper_env = env_push_scope(context.state.env)
	bound_env = env_add_var_with_details(
		mapper_env,
		mapper.name.text,
		actual_error_type,
		Some(actual_error_type),
		ImmutableBinding,
		LetBinding,
		UNREFINED_BINDING,
	)
	mapper_state = { context.state | env = bound_env }
	mapper_context = infer_with_canonical_expected_value_slot(
		infer_context_with_state(context, mapper_state),
		expected_error_type,
		ExpectedArgumentSlot,
	)
	mapper_result = infer_expr(mapper_context, mapper.value)
	mapper_type = typed_expr_value_type(mapper_result.expr)

	checked_context = if types_equal(mapper_type, expected_error_type):
		mapper_result.context
	else:
		infer_error(
			mapper_result.context,
			"with ?= error mapper must return " + type_to_string(
				expected_error_type,
			) + ", got " + type_to_string(mapper_type),
		)

	outer_env = env_pop_scope(checked_context.state.env)
	outer_state = { checked_context.state | env = outer_env }
	result_context = infer_context_with_state(context, outer_state)

	infer_with_try_binding_result(result_context, TYPE_VOID, Some({
			name = mapper.name,
			value = mapper_result.expr,
			span = mapper.span,
		}))


private pure func infer_with_try_binding(
	context: InferContext,
	rhs_type: SemanticType,
	error_map: Option[ParsedWithErrorMap],
) -> InferWithTryBindingResult:
	expected_carrier = match infer_context_expected_type(context):
		Some(expected_type):
			question_bind_carrier(context, expected_type)
		None:
			QuestionBindNonCarrier

	rhs_carrier = question_bind_carrier(context, rhs_type)

	match (expected_carrier, rhs_carrier, error_map):
		(QuestionBindOptionCarrier(_), QuestionBindOptionCarrier(inner_type), None):
			infer_with_try_binding_result(context, inner_type, None)
		(QuestionBindOptionCarrier(_), QuestionBindOptionCarrier(_), Some(_)):
			next = infer_error(
				context,
				"with ?= error mapping requires the enclosing block to return Result[T, E]",
			)
			infer_with_try_binding_result(next, TYPE_VOID, None)
		(QuestionBindOptionCarrier(_), QuestionBindResultCarrier(_, _), Some(_)):
			next = infer_error(
				context,
				"with ?= error mapping requires the enclosing block to return Result[T, E]",
			)
			infer_with_try_binding_result(next, TYPE_VOID, None)
		(QuestionBindOptionCarrier(_), QuestionBindResultCarrier(_, _), None):
			next = infer_error(
				context,
				(
					"Cannot use Result ?= in a with binding inside a block returning Option. Convert "
					+ "the Result to Option or return Result from the enclosing function"
				),
			)
			infer_with_try_binding_result(next, TYPE_VOID, None)
		(QuestionBindResultCarrier(_, expected_error_type), QuestionBindResultCarrier(inner_type, actual_error_type), None):
			if types_equal(expected_error_type, actual_error_type):
				infer_with_try_binding_result(context, inner_type, None)
			else:
				next = infer_error(
					context,
					"Incompatible error type for with ?=: enclosing block returns Result[..., " + type_to_string(
						expected_error_type,
					) + "], but expression returns Result[..., " + type_to_string(
						actual_error_type,
					) + "]",
				)
				infer_with_try_binding_result(next, TYPE_VOID, None)
		(QuestionBindResultCarrier(_, expected_error_type), QuestionBindResultCarrier(inner_type, actual_error_type), Some(mapper)):
			mapper_result = infer_with_error_mapper(
				context,
				mapper,
				actual_error_type,
				expected_error_type,
			)
			infer_with_try_binding_result(
				mapper_result.context,
				inner_type,
				mapper_result.error_map,
			)
		(QuestionBindResultCarrier(_, _), QuestionBindOptionCarrier(_), Some(_)):
			next = infer_error(
				context,
				"with ?= error mapping requires a Result acquisition expression",
			)
			infer_with_try_binding_result(next, TYPE_VOID, None)
		(QuestionBindResultCarrier(_, _), QuestionBindOptionCarrier(_), None):
			next = infer_error(
				context,
				(
					"Cannot use Option ?= in a with binding inside a block returning Result. Convert "
					+ "the Option to Result with to_result(...) or return Option from the enclosing "
					+ "function"
				),
			)
			infer_with_try_binding_result(next, TYPE_VOID, None)
		(QuestionBindNonCarrier, QuestionBindOptionCarrier(_), Some(_)):
			next = infer_error(
				context,
				"with ?= error mapping requires an enclosing block returning Result[T, E]",
			)
			infer_with_try_binding_result(next, TYPE_VOID, None)
		(QuestionBindNonCarrier, QuestionBindResultCarrier(_, _), Some(_)):
			next = infer_error(
				context,
				"with ?= error mapping requires an enclosing block returning Result[T, E]",
			)
			infer_with_try_binding_result(next, TYPE_VOID, None)
		(QuestionBindNonCarrier, QuestionBindOptionCarrier(_), None):
			next = match infer_context_expected_type(context):
				Some(expected_type):
					infer_error(
						context,
						(
							"with ?= requires the enclosing block to return the same carrier as the "
							+ "acquisition expression; enclosing block returns "
						) + type_to_string(expected_type),
					)
				None:
					infer_error(
						context,
						"with ?= requires an enclosing block returning Option[T] or Result[T, E]",
					)

			infer_with_try_binding_result(next, TYPE_VOID, None)
		(QuestionBindNonCarrier, QuestionBindResultCarrier(_, _), None):
			next = match infer_context_expected_type(context):
				Some(expected_type):
					infer_error(
						context,
						(
							"with ?= requires the enclosing block to return the same carrier as the "
							+ "acquisition expression; enclosing block returns "
						) + type_to_string(expected_type),
					)
				None:
					infer_error(
						context,
						"with ?= requires an enclosing block returning Option[T] or Result[T, E]",
					)

			infer_with_try_binding_result(next, TYPE_VOID, None)
		(_, QuestionBindNonCarrier, Some(_)):
			next = infer_error(
				context,
				"Cannot use `?=` error mapping in a with binding on type `" + type_to_string(
					rhs_type,
				) + "` — only Result supports error mapping",
			)
			infer_with_try_binding_result(next, TYPE_VOID, None)
		(_, QuestionBindNonCarrier, None):
			next = infer_error(
				context,
				"Cannot use `?=` in a with binding on type `" + type_to_string(
					rhs_type,
				) + "` — only Option and Result support ?= bindings",
			)
			infer_with_try_binding_result(next, TYPE_VOID, None)


private pure func infer_scoped_with_body(
	context: InferContext,
	bound_env: Env,
	body: ParsedExpr,
) -> InferResult:
	body_state = { context.state | env = bound_env }
	body_context = infer_context_with_state(context, body_state)
	body_result = infer_expr(body_context, body)
	body_type = typed_expr_value_type(body_result.expr)

	checked_context = if body_result.context.state.errors.length() == body_context.state.errors.length():
		check_with_body_resource_escape(body_result.context, body_type, body_result.expr)
	else:
		body_result.context

	outer_env = env_pop_scope(checked_context.state.env)
	outer_state = { checked_context.state | env = outer_env }
	result_context = infer_context_with_state(context, outer_state)

	infer_result(result_context, body_result.expr)


private pure func infer_with_body(
	context: InferContext,
	name: ParsedIdentifier,
	binding_type: SemanticType,
	unavailable_parents: List[String],
	body: ParsedExpr,
) -> InferResult:
	owner = if name.text == "_":
		"current dependent resource"
	else:
		name.text

	var scoped_env = env_push_scope(context.state.env)

	for parent in unavailable_parents:
		scoped_env = shadow_parent_resource_unavailable(scoped_env, owner, parent)

	if name.text == "_":
		infer_scoped_with_body(context, scoped_env, body)
	else:
		bound_env = env_add_var_with_details(
			scoped_env,
			name.text,
			binding_type,
			Some(binding_type),
			ImmutableBinding,
			ScopedResource,
			UNREFINED_BINDING,
		)

		infer_scoped_with_body(context, bound_env, body)


private pure func typed_with_binding(
	binding: ParsedWithBinding,
	annotation_type: Option[SemanticType],
	value: TypedExpr,
	error_map: Option[TypedWithErrorMap],
	cleanup_function: Option[String],
) -> TypedWithBinding:
	{
		name = binding.name,
		annotation = annotation_type,
		value = value,
		kind = binding.kind,
		error_map = error_map,
		cleanup_function = cleanup_function,
		resource_loop_item_name = None,
		span = binding.span
	}


private pure func with_cleanup_function(
	context: InferContext,
	binding_type: SemanticType,
) -> Option[String]:
	resolved_type = infer_resolve_alias(context, binding_type)

	match resolved_type:
		SemanticNamedType(name, _):
			find_resource_cleanup(context.state.context, name)
		_:
			None


private pure func infer_with_expr(
	context: InferContext,
	binding: ParsedWithBinding,
	body: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	annotation_type = optional_question_bind_annotation_type(context, binding.type_expr)
	value_result = infer_expr(infer_without_expected(context), binding.value)
	acquisition_type = typed_expr_value_type(value_result.expr)
	value_context = infer_context_with_state(context, value_result.context.state)

	match binding.kind:
		ParsedWithPlainBinding:
			annotation_context = check_with_binding_annotation(
				value_context,
				annotation_type,
				acquisition_type,
			)

			binding_type = match annotation_type:
				Some(annotated_type):
					annotated_type
				None:
					acquisition_type

			checked_context = if annotation_context.state.errors.length() == value_context.state.errors.length():
				check_with_binding_resource_type(annotation_context, binding_type)
			else:
				annotation_context

			unavailable_parents = unavailable_parent_resource_names(
				checked_context,
				value_result.expr,
			)
			body_result = infer_with_body(
				checked_context,
				binding.name,
				binding_type,
				unavailable_parents,
				body,
			)
			result_context = infer_context_with_state(context, body_result.context.state)
			typed = TypedWithExpr(
				typed_with_binding(
					binding,
					annotation_type,
					value_result.expr,
					None,
					with_cleanup_function(checked_context, binding_type),
				),
				body_result.expr,
				span,
				typed_expr_info(body_result.expr),
			)
			infer_result(result_context, typed)
		ParsedWithTryBinding:
			try_result = infer_with_try_binding(value_context, acquisition_type, binding.error_map)

			binding_type = if try_result.context.state.errors.length() == value_context.state.errors.length():
				match annotation_type:
					Some(annotated_type):
						annotated_type
					None:
						try_result.inner_type
			else:
				TYPE_VOID

			checked_context = if try_result.context.state.errors.length() == value_context.state.errors.length():
				annotation_context = check_with_binding_annotation(
					try_result.context,
					annotation_type,
					try_result.inner_type,
				)

				if annotation_context.state.errors.length() == try_result.context.state.errors.length():
					check_with_binding_resource_type(annotation_context, binding_type)
				else:
					annotation_context
			else:
				try_result.context

			unavailable_parents = unavailable_parent_resource_names(
				checked_context,
				value_result.expr,
			)
			body_result = infer_with_body(
				checked_context,
				binding.name,
				binding_type,
				unavailable_parents,
				body,
			)
			result_context = infer_context_with_state(context, body_result.context.state)
			typed = TypedWithExpr(
				typed_with_binding(
					binding,
					annotation_type,
					value_result.expr,
					try_result.error_map,
					with_cleanup_function(checked_context, binding_type),
				),
				body_result.expr,
				span,
				typed_expr_info(body_result.expr),
			)
			infer_result(result_context, typed)


private pure func int_type_ok(typ: SemanticType) -> Bool:
	match typ:
		SemanticConstIntType(_):
			True
		SemanticRangeType(_):
			True
		SemanticNamedType(name, args):
			name == "Int" and args.length() == 0
		_:
			False


private pure func timeout_type_ok(timeout_type: SemanticType) -> Bool:
	if int_type_ok(timeout_type):
		True
	else:
		match timeout_type:
			SemanticNamedType(name, args):
				name == canonical_module_type_name("std/units", "Duration") and args.length() == 0
			_:
				False


private pure func check_concurrent_for_param_names(
	context: InferContext,
	params: List[ParsedConcurrentParam],
) -> InferContext:
	var next_context = context
	var seen: List[String] = []

	for param in params:
		name = param.name.text

		if not (name == CONCURRENT_FOR_PARAM_LIMIT or name == CONCURRENT_PARAM_TIMEOUT):
			next_context = infer_error(
				next_context,
				"Unknown `for ... concurrently` parameter `" + name + "`",
			)
		else if seen.contains(name):
			next_context = infer_error(
				next_context,
				"Duplicate `for ... concurrently` parameter `" + name + "`",
			)
		else:
			seen = seen.append(name)

	next_context


private pure func check_concurrent_for_param_type(
	context: InferContext,
	name: String,
	value_type: SemanticType,
) -> InferContext:
	if name == CONCURRENT_FOR_PARAM_LIMIT:
		if int_type_ok(value_type):
			context
		else:
			infer_error(context, "`for ... concurrently(...)` limit must be Int")
	else if name == CONCURRENT_PARAM_TIMEOUT:
		if timeout_type_ok(value_type):
			context
		else:
			infer_error(
				context,
				"`for ... concurrently(...)` timeout must be Int milliseconds or Duration",
			)
	else:
		context


private pure func infer_concurrent_for_params(
	context: InferContext,
	params: List[ParsedConcurrentParam],
) -> InferConcurrentParamsResult:
	var next_context = check_concurrent_for_param_names(context, params)
	var typed_params: List[TypedConcurrentParam] = []

	for param in params:
		value_result = infer_expr(infer_without_expected(next_context), param.value)
		value_type = typed_expr_value_type(value_result.expr)
		checked_context = check_concurrent_for_param_type(
			value_result.context,
			param.name.text,
			value_type,
		)
		typed_params = typed_params.append({
			name = param.name,
			value = value_result.expr,
			span = param.span,
		})
		next_context = infer_context_with_state(next_context, checked_context.state)

	{
		context = next_context,
		params = typed_params
	}


private pure func check_concurrent_for_statement_context(context: InferContext) -> InferContext:
	match infer_context_expected_type(context):
		Some(expected):
			if named_value_type_is(expected, "Void"):
				context
			else:
				infer_error(
					context,
					"`for ... concurrently(...)` is statement-only and does not collect results",
				)
		None:
			context


private pure func infer_concurrent_for_body(
	context: InferContext,
	name: ParsedIdentifier,
	element_type: SemanticType,
	binding_origin: VarOrigin,
	body: ParsedExpr,
) -> InferResult:
	loop_env = env_push_scope(context.state.env)

	bound_env = if name.text == "_":
		loop_env
	else:
		env_add_var_with_details(
			loop_env,
			name.text,
			element_type,
			Some(element_type),
			ImmutableBinding,
			binding_origin,
			UNREFINED_BINDING,
		)

	loop_state = { context.state | env = bound_env }
	loop_context = infer_loop_body_context(infer_context_with_state(context, loop_state))
	body_result = infer_expr(infer_without_expected(loop_context), body)
	outer_env = env_pop_scope(body_result.context.state.env)
	outer_state = { body_result.context.state | env = outer_env }
	result_context = infer_context_with_state(context, outer_state)

	infer_result(result_context, body_result.expr)


private pure func infer_concurrent_for_expr(
	context: InferContext,
	name: ParsedIdentifier,
	iterable: ParsedExpr,
	params: List[ParsedConcurrentParam],
	body: ParsedExpr,
	span: SourceSpan,
) -> InferResult:
	statement_context = check_concurrent_for_statement_context(context)
	params_result = infer_concurrent_for_params(infer_without_expected(statement_context), params)
	iterable_result = infer_expr(infer_without_expected(params_result.context), iterable)
	iterable_type = typed_expr_semantic_type(iterable_result.expr)
	var iterable_context = iterable_result.context
	var element_type: Option[SemanticType] = None

	match iterable_type:
		SemanticNamedType(name, args):
			if name == "List" and args.length() == 1:
				element_type = args.get(0)
			else if is_resource_source_type_name(name) and args.length() == 2:
				element_type = args.get(0)
			else:
				iterable_context = infer_error(
					iterable_context,
					"`for ... concurrently` requires a List or ResourceSource, got " + type_to_string(
						iterable_type,
					),
				)
		_:
			iterable_context = infer_error(
				iterable_context,
				"`for ... concurrently` requires a List or ResourceSource, got " + type_to_string(
					iterable_type,
				),
			)

	after_iter_context = if name.text == "_":
		iterable_context
	else if env_lookup_in_current_scope(iterable_context.state.env, name.text).is_some():
		for_redeclaration_error(iterable_context, name.text)
	else:
		iterable_context

	body_element_type = match element_type:
		Some(typ):
			typ
		None:
			TYPE_VOID

	binding_origin = iterable_binding_origin(iterable_type)

	task_bound_names: List[String] = if name.text == "_":
		[]
	else:
		[name.text]

	capture_context = check_task_captures(
		after_iter_context,
		"`for ... concurrently` body",
		task_bound_names,
		body,
	)
	body_result = infer_concurrent_for_body(
		capture_context,
		name,
		body_element_type,
		binding_origin,
		body,
	)
	result_context = infer_context_with_state(context, body_result.context.state)

	(lowered_name, lowered_body) = match resource_source_parts(iterable_type):
		Some((resource_type, _)):
			item_name = resource_loop_item_identifier("concurrent_item", span)
			(
				item_name,
				scope_resource_loop_body(
					body_result.context,
					name,
					item_name,
					resource_type,
					body_result.expr,
					span,
				),
			)
		None:
			(name, body_result.expr)

	typed = TypedConcurrentForExpr(
		lowered_name,
		iterable_result.expr,
		params_result.params,
		lowered_body,
		span,
		inferred_info(result_context, TYPE_VOID),
	)

	infer_result(result_context, typed)


private pure func select_channel_element_type(
	context: InferContext,
	channel_type: SemanticType,
	arm_label: String,
) -> SelectChannelTypeResult:
	match channel_type:
		SemanticNamedType(name, args):
			if name == "Channel" and args.length() == 1:
				{
					context = context,
					element_type = args.get(0)
				}
			else:
				next = infer_error(
					context,
					"select " + arm_label + " arm requires Channel[T], got " + type_to_string(
						channel_type,
					),
				)
				{
					context = next,
					element_type = None
				}
		_:
			next = infer_error(
				context,
				"select " + arm_label + " arm requires Channel[T], got " + type_to_string(
					channel_type,
				),
			)
			{
				context = next,
				element_type = None
			}


private pure func check_select_statement_context(context: InferContext) -> InferContext:
	match infer_context_expected_type(context):
		Some(expected):
			if named_value_type_is(expected, "Void"):
				context
			else:
				infer_error(context, "`select:` is statement-only")
		None:
			context


private pure func infer_select_arm_body(
	context: InferContext,
	body: ParsedExpr,
	binding_name: Option[ParsedIdentifier],
	binding_type: Option[SemanticType],
) -> InferResult:
	var body_env = env_push_scope(context.state.env)

	match (binding_name, binding_type):
		(Some(name), Some(typ)):
			if name.text != "_":
				body_env = env_add_var_with_details(
					body_env,
					name.text,
					typ,
					Some(typ),
					ImmutableBinding,
					MatchBinding,
					UNREFINED_BINDING,
				)
			else:
				void
		_:
			void

	body_state = { context.state | env = body_env }
	body_context = infer_context_with_state(context, body_state)
	body_result = infer_expr(infer_without_expected(body_context), body)
	outer_env = env_pop_scope(body_result.context.state.env)
	outer_state = { body_result.context.state | env = outer_env }
	result_context = infer_context_with_state(context, outer_state)

	infer_result(result_context, body_result.expr)


private pure func infer_select_expr(
	context: InferContext,
	arms: List[ParsedSelectArm],
	span: SourceSpan,
) -> InferResult:
	statement_context = check_select_statement_context(context)

	checked_context = if arms.length() == 0:
		infer_error(statement_context, "select: block cannot be empty")
	else:
		statement_context

	var next_context = infer_without_expected(checked_context)
	var typed_arms: List[TypedSelectArm] = []

	for arm in arms:
		match arm.kind:
			ParsedSelectReceiveArm(name, channel):
				channel_result = infer_expr(infer_without_expected(next_context), channel)
				channel_type = typed_expr_value_type(channel_result.expr)
				element_result = select_channel_element_type(
					channel_result.context,
					channel_type,
					"receive",
				)

				element_type = match element_result.element_type:
					Some(typ):
						typ
					None:
						TYPE_VOID

				body_result = infer_select_arm_body(
					element_result.context,
					arm.body,
					Some(name),
					Some(element_type),
				)
				typed_arms = typed_arms.append({
					kind = TypedSelectReceiveArm(name, element_type, channel_result.expr),
					body = body_result.expr,
					span = arm.span,
				})
				next_context = infer_context_with_state(next_context, body_result.context.state)
			ParsedSelectSealedArm(channel):
				channel_result = infer_expr(infer_without_expected(next_context), channel)
				channel_type = typed_expr_value_type(channel_result.expr)
				element_result = select_channel_element_type(
					channel_result.context,
					channel_type,
					"sealed",
				)

				element_type = match element_result.element_type:
					Some(typ):
						typ
					None:
						TYPE_VOID

				body_result = infer_select_arm_body(element_result.context, arm.body, None, None)
				typed_arms = typed_arms.append({
					kind = TypedSelectSealedArm(element_type, channel_result.expr),
					body = body_result.expr,
					span = arm.span,
				})
				next_context = infer_context_with_state(next_context, body_result.context.state)
			ParsedSelectAfterArm(timeout):
				timeout_result = infer_expr(infer_without_expected(next_context), timeout)
				timeout_type = typed_expr_value_type(timeout_result.expr)

				timeout_context = if timeout_type_ok(timeout_type):
					timeout_result.context
				else:
					infer_error(
						timeout_result.context,
						"select after timeout must be Int milliseconds or Duration",
					)

				body_result = infer_select_arm_body(timeout_context, arm.body, None, None)
				typed_arms = typed_arms.append({
					kind = TypedSelectAfterArm(timeout_result.expr),
					body = body_result.expr,
					span = arm.span,
				})
				next_context = infer_context_with_state(next_context, body_result.context.state)

	result_context = infer_context_with_state(context, next_context.state)
	typed = TypedSelectExpr(
		typed_arms,
		span,
		inferred_info(result_context, TYPE_VOID),
	)

	infer_result(result_context, typed)


private pure func unsupported_expr(
	context: InferContext,
	expr: ParsedExpr,
	label: String,
) -> InferResult:
	next = infer_error(context, "Blorp inference does not yet support " + label)
	infer_result(
		next,
		TypedUnsupportedExpr(
			label,
			parsed_expr_span(expr),
			inferred_info(next, TYPE_VOID),
		),
	)


private pure func infer_expr_inner(context: InferContext, expr: ParsedExpr) -> InferResult:
	match expr:
		ParsedNameExpr(name):
			infer_name_expr(context, name)
		ParsedIntLiteralExpr(text, span):
			infer_result(
				context,
				TypedIntLiteralExpr(
					text,
					span,
					inferred_info(context, SemanticConstIntType(parse_int_literal(text))),
				),
			)
		ParsedFloatLiteralExpr(text, span):
			infer_result(
				context,
				TypedFloatLiteralExpr(
					text,
					span,
					inferred_info(context, TYPE_FLOAT),
				),
			)
		ParsedStringLiteralExpr(text, _, span):
			infer_result(
				context,
				TypedStringLiteralExpr(
					text,
					span,
					inferred_info(context, inferred_string_literal_type(context)),
				),
			)
		ParsedStringInterpolationExpr(text, raw, span):
			infer_result(
				context,
				TypedStringInterpolationExpr(
					text,
					raw,
					span,
					inferred_info(context, TYPE_STRING),
				),
			)
		ParsedStringInterpolationPartsExpr(parts, is_multiline, span):
			infer_string_interpolation_parts_expr(context, parts, is_multiline, span)
		ParsedBoolLiteralExpr(value, span):
			infer_result(
				context,
				TypedBoolLiteralExpr(
					value,
					span,
					inferred_info(context, TYPE_BOOL),
				),
			)
		ParsedCharLiteralExpr(value, span):
			infer_result(
				context,
				TypedCharLiteralExpr(
					value,
					span,
					inferred_info(context, TYPE_CHAR),
				),
			)
		ParsedUnaryExpr(op, operand, span):
			infer_unary_expr(context, op, operand, span)
		ParsedBinaryExpr(op, left, right, span):
			infer_binary_expr(context, op, left, right, span)
		ParsedLogicalExpr(op, left, right, span):
			infer_logical_expr(context, op, left, right, span)
		ParsedCallExpr(callee, args, span):
			infer_call_expr(context, callee, args, span)
		ParsedLambdaExpr(is_pure, params, return_type, body, span):
			infer_lambda_expr(context, is_pure, params, return_type, body, span)
		ParsedFieldAccessExpr(receiver, field, span):
			infer_field_access_expr(context, receiver, field, span)
		ParsedSubscriptExpr(receiver, indices, span):
			infer_subscript_expr(context, receiver, indices, span)
		ParsedSubscriptAssignExpr(target, indices, value, span):
			infer_subscript_assign_expr(context, target, indices, value, span)
		ParsedTupleExpr(items, span):
			infer_tuple_expr(context, items, span)
		ParsedTupleDestructExpr(names, value, span):
			infer_tuple_destruct_expr(context, names, value, span)
		ParsedListExpr(items, span):
			infer_list_expr(context, items, span)
		ParsedVectorExpr(items, span):
			infer_vector_expr(context, items, span)
		ParsedDictExpr(entries, span):
			infer_dict_expr(context, entries, span)
		ParsedRecordExpr(fields, span):
			infer_record_expr(context, fields, span)
		ParsedRecordUpdateExpr(base, fields, span):
			infer_record_update_expr(context, base, fields, span)
		ParsedOpaqueIntoExpr(type_expr, inner, span):
			infer_opaque_conversion_expr(context, OpaqueIntoConversion, type_expr, inner, span)
		ParsedOpaqueFromExpr(type_expr, inner, span):
			infer_opaque_conversion_expr(context, OpaqueFromConversion, type_expr, inner, span)
		ParsedRangeExpr(start_expr, end_expr, span):
			infer_range_expr(context, start_expr, end_expr, span)
		ParsedIfExpr(condition, then_branch, else_branch, span):
			infer_if_expr(context, condition, then_branch, else_branch, span)
		ParsedMatchExpr(scrutinee, cases, span):
			infer_match_expr(context, scrutinee, cases, span)
		ParsedSelectExpr(arms, span):
			infer_select_expr(context, arms, span)
		ParsedWhileExpr(condition, body, span):
			infer_while_expr(context, condition, body, span)
		ParsedForExpr(binder, iterable, body, span):
			infer_for_expr(context, binder, iterable, body, span)
		ParsedBreakExpr(span):
			infer_break_expr(context, span)
		ParsedContinueExpr(span):
			infer_continue_expr(context, span)
		ParsedAssignExpr(name, value, span):
			infer_assign_expr(context, name, value, span)
		ParsedCompoundAssignExpr(name, op, value, span):
			infer_compound_assign_expr(context, name, op, value, span)
		ParsedAscriptionExpr(inner, type_expr, span):
			infer_ascription_expr(context, inner, type_expr, span)
		ParsedQuestionBindExpr(name, annotation, value, span):
			annotation_type = optional_question_bind_annotation_type(context, annotation)
			value_result = infer_expr(infer_without_expected(context), value)
			next = infer_error(
				value_result.context,
				"?= binding must be used as a statement in a result-producing block",
			)
			question_bind_error_result(next, name, annotation_type, value_result.expr, span)
		ParsedBlockExpr(exprs, span):
			infer_block_expr(context, exprs, span)
		ParsedWithExpr(binding, body, span):
			infer_with_expr(context, binding, body, span)
		ParsedDebugBlockExpr(body, span):
			infer_debug_block_expr(context, body, span)
		ParsedConcurrentBlockExpr(params, body, span):
			infer_concurrent_block_expr(context, params, body, span)
		ParsedConcurrentForExpr(name, iterable, params, body, span):
			infer_concurrent_for_expr(context, name, iterable, params, body, span)
		ParsedDetachExpr(body, span):
			infer_detach_expr(context, body, span)
		ParsedVoidExpr(span):
			infer_result(
				context,
				TypedVoidExpr(
					span,
					inferred_info(context, TYPE_VOID),
				),
			)
		ParsedBuiltinExpr(name, span):
			next = if typecheck_module_scope_is_source_package(context.state.facts.module_scope):
				infer_error(context, "builtin expressions cannot be used in source packages")
			else:
				context

			infer_result(
				next,
				TypedBuiltinExpr(
					name,
					span,
					inferred_info(next, TYPE_VOID),
				),
			)
		ParsedFunctionDeclExpr(function_decl):
			next = infer_error(
				context,
				"Nested function declaration `" + function_decl.name.text + "` reached expression inference before source finalization",
			)
			infer_result(
				next,
				TypedUnsupportedExpr(
					"nested function declaration",
					function_decl.span,
					inferred_info(next, TYPE_VOID),
				),
			)
		ParsedVarDeclExpr(name, annotation, value, is_mutable, span):
			infer_var_decl_expr(context, name, annotation, value, is_mutable, span)
		ParsedMissingExpr(span):
			infer_result(
				context,
				TypedMissingExpr(
					span,
					inferred_info(context, TYPE_VOID),
				),
			)
		_:
			unsupported_expr(context, expr, "expression form")


pure func infer_expr(context: InferContext, expr: ParsedExpr) -> InferResult:
	first_diagnostic: Int = context.state.diagnostics.length()
	result = infer_expr_inner(context, expr)

	if result.context.state.diagnostics.length() == first_diagnostic:
		result
	else:
		-- Child calls locate their own failures first. Filling only missing spans
		-- here therefore assigns each inference error to its narrowest expression.
		var index: Int = first_diagnostic
		var diagnostics: List[TypecheckDiagnostic] = result.context.state.diagnostics.take(
			first_diagnostic,
		)

		while index < result.context.state.diagnostics.length():
			match result.context.state.diagnostics.get(index):
				Some(diagnostic):
					located = if diagnostic.span == None:
						{ diagnostic | span = Some(parsed_expr_span(expr)) }
					else:
						diagnostic

					diagnostics = diagnostics.append(located)
				None:
					void

			index += 1

		located_session = { result.context.state | diagnostics = diagnostics }
		{ result | context = infer_context_with_state(result.context, located_session) }
