CONCURRENT_PARAM_MAX_THREADS: String = "max_threads"

CONCURRENT_PARAM_TIMEOUT: String = "timeout"

CONCURRENT_FOR_PARAM_LIMIT: String = "limit"


union ExprTypeOrigin:
	InferredOrigin
	ExplicitAnnotationOrigin(SemanticType)
	SynthesizedOrigin(String)


union CallableOrigin:
	CallableLocal
	CallableImported(String)
	CallableBuiltin
	CallableForeign
	CallableConstructor(String)
	CallableImplMethod


union ResolvedCallTarget:
	ResolvedDirectCall(Int, CallableOrigin)
	ResolvedTraitMethodCall(String, Option[ImplMethodTarget])
	ResolvedIntrinsicCall
	ResolvedClosureCall


enum ResolvedLoopProducer:
	ResolvedLoopProducerIndices
	ResolvedLoopProducerEnumerate
	ResolvedLoopProducerEnumerate2
	ResolvedLoopProducerWindows


record ResolvedCallInfo {
	callee_name: String,
	source_name: String,
	purity: Purity,
	target: ResolvedCallTarget,
	instantiated_params: List[SemanticType],
	instantiated_return: SemanticType,
	resource_args: ResourceArgPolicy,
	dim_constraints: List[(SemanticType, SemanticType)],
	loop_producer: Option[ResolvedLoopProducer]
}


private record TraitMethodCallee {
	source_name: String,
	method_name: String,
	trait_name: String,
	method: TraitMethodSig
}


private record AcceptedTraitDispatch {
	callee: TraitMethodCallee,
	method_info: ImplMethodInfo
}


record TypedExprInfo {
	source_type: Option[SemanticType],
	origin: ExprTypeOrigin,
	value_slot: ValueSlot,
	proofs: ValueProofs,
	resolved_call: Option[ResolvedCallInfo],
	resolved_definition_id: Option[Int],
	resource_dependencies: List[String]
}


record TypedVarDeclPayload {
	name: ParsedIdentifier,
	annotation: Option[SemanticType],
	initializer: TypedExpr,
	is_mutable: Bool,
	span: SourceSpan
}


record TypedDictEntry {
	key: TypedExpr,
	value: TypedExpr
}


record TypedRecordField {
	name: ParsedIdentifier,
	value: TypedExpr,
	span: SourceSpan,
	definition_id: Option[Int]
}


record TypedLambdaParam {
	name: ParsedIdentifier,
	source_type: Option[SemanticType],
	param_type: SemanticType
}


union TypedStringInterpolationPart:
	TypedInterpolationLiteral(String)
	TypedInterpolationExpr(TypedExpr)


union TypedPattern:
	TypedWildcardPattern(SourceSpan)
	TypedNamePattern(ParsedIdentifier, SemanticType)
	TypedBoolPattern(Bool, SourceSpan)
	TypedIntPattern(String, SourceSpan)
	TypedFloatPattern(String, SourceSpan)
	TypedStringPattern(String, SourceSpan)
	TypedCharPattern(Int, SourceSpan)
	TypedConstructorPattern(ParsedIdentifier, List[TypedPattern], SourceSpan, Int)
	TypedQualifiedConstructorPattern(ParsedIdentifier, ParsedIdentifier, List[TypedPattern], SourceSpan, Int)
	TypedTuplePattern(List[TypedPattern], SourceSpan)
	TypedListPattern(List[TypedPattern], Option[ParsedListPatternSpread], SourceSpan)
	TypedOrPattern(List[TypedPattern], SourceSpan)
	TypedUnsupportedPattern(String, SourceSpan)


record TypedMatchCase {
	pattern: TypedPattern,
	body: TypedExpr,
	span: SourceSpan
}


union TypedSelectArmKind:
	TypedSelectReceiveArm(ParsedIdentifier, SemanticType, TypedExpr)
	TypedSelectSealedArm(SemanticType, TypedExpr)
	TypedSelectAfterArm(TypedExpr)


record TypedSelectArm {
	kind: TypedSelectArmKind,
	body: TypedExpr,
	span: SourceSpan
}


enum TypedAssignScope:
	LocalAssignScope
	ModuleAssignScope


record TypedAssignTarget {
	name: String,
	scope: TypedAssignScope
}


record TypedConcurrentParam {
	name: ParsedIdentifier,
	value: TypedExpr,
	span: SourceSpan
}


record TypedConcurrentBinding {
	name: ParsedIdentifier,
	annotation: Option[SemanticType],
	value: TypedExpr,
	span: SourceSpan,
	info: TypedExprInfo
}


record TypedWithErrorMap {
	name: ParsedIdentifier,
	value: TypedExpr,
	span: SourceSpan
}


record TypedWithBinding {
	name: ParsedIdentifier,
	annotation: Option[SemanticType],
	value: TypedExpr,
	kind: ParsedWithBindingKind,
	error_map: Option[TypedWithErrorMap],
	cleanup_function: Option[String],
	resource_loop_item_name: Option[String],
	span: SourceSpan
}


pure func typed_with_binding_is_try(binding: TypedWithBinding) -> Bool:
	match binding.kind:
		ParsedWithPlainBinding:
			False
		ParsedWithTryBinding:
			True


union TypedLoopView:
	TypedIndicesLoopView(SemanticType)
	TypedEnumerateLoopView(SemanticType)
	TypedEnumerate2LoopView(SemanticType)
	TypedWindowsLoopView(Int, SemanticType)


union TypedExpr:
	TypedNameExpr(ParsedIdentifier, TypedExprInfo)
	TypedIntLiteralExpr(String, SourceSpan, TypedExprInfo)
	TypedFloatLiteralExpr(String, SourceSpan, TypedExprInfo)
	TypedStringLiteralExpr(String, SourceSpan, TypedExprInfo)
	TypedStringInterpolationExpr(String, Bool, SourceSpan, TypedExprInfo)
	TypedStringInterpolationPartsExpr(List[TypedStringInterpolationPart], Bool, SourceSpan, TypedExprInfo)
	TypedBoolLiteralExpr(Bool, SourceSpan, TypedExprInfo)
	TypedCharLiteralExpr(Int, SourceSpan, TypedExprInfo)
	TypedUnaryExpr(ParsedUnaryOp, TypedExpr, SourceSpan, TypedExprInfo)
	TypedBinaryExpr(ParsedBinaryOp, TypedExpr, TypedExpr, SourceSpan, TypedExprInfo)
	TypedLogicalExpr(ParsedLogicalOp, TypedExpr, TypedExpr, SourceSpan, TypedExprInfo)
	TypedCallExpr(TypedExpr, List[TypedExpr], SourceSpan, TypedExprInfo)
	TypedTupleExpr(List[TypedExpr], SourceSpan, TypedExprInfo)
	TypedTupleDestructExpr(List[ParsedIdentifier], TypedExpr, SourceSpan, TypedExprInfo)
	TypedAssignExpr(ParsedIdentifier, TypedAssignScope, TypedExpr, SourceSpan, TypedExprInfo)
	TypedSubscriptExpr(TypedExpr, List[TypedExpr], SourceSpan, TypedExprInfo)
	TypedSubscriptAssignExpr(Option[TypedAssignTarget], TypedExpr, List[TypedExpr], TypedExpr, SourceSpan, TypedExprInfo)
	TypedListExpr(List[TypedExpr], SourceSpan, TypedExprInfo)
	TypedVectorExpr(List[TypedExpr], SourceSpan, TypedExprInfo)
	TypedDictExpr(List[TypedDictEntry], SourceSpan, TypedExprInfo)
	TypedOpaqueIntoExpr(SemanticType, TypedExpr, SourceSpan, TypedExprInfo)
	TypedOpaqueFromExpr(SemanticType, TypedExpr, SourceSpan, TypedExprInfo)
	TypedRecordExpr(List[TypedRecordField], SourceSpan, TypedExprInfo)
	TypedRecordUpdateExpr(TypedExpr, List[TypedRecordField], List[FieldDecl], SourceSpan, TypedExprInfo)
	TypedFieldAccessExpr(TypedExpr, ParsedIdentifier, SourceSpan, TypedExprInfo)
	TypedLambdaExpr(Bool, List[TypedLambdaParam], Option[SemanticType], TypedExpr, SourceSpan, TypedExprInfo)
	TypedRangeExpr(TypedExpr, TypedExpr, SourceSpan, TypedExprInfo)
	TypedIfExpr(TypedExpr, TypedExpr, Option[TypedExpr], SourceSpan, TypedExprInfo)
	TypedMatchExpr(TypedExpr, List[TypedMatchCase], SourceSpan, TypedExprInfo)
	TypedSelectExpr(List[TypedSelectArm], SourceSpan, TypedExprInfo)
	TypedWhileExpr(TypedExpr, TypedExpr, SourceSpan, TypedExprInfo)
	TypedForExpr(ParsedForBinder, TypedExpr, Option[TypedLoopView], TypedExpr, SourceSpan, TypedExprInfo)
	TypedConcurrentBlockExpr(List[TypedConcurrentParam], List[TypedConcurrentBinding], SourceSpan, TypedExprInfo)
	TypedConcurrentForExpr(ParsedIdentifier, TypedExpr, List[TypedConcurrentParam], TypedExpr, SourceSpan, TypedExprInfo)
	TypedDetachExpr(TypedExpr, SourceSpan, TypedExprInfo)
	TypedAscriptionExpr(TypedExpr, SemanticType, SourceSpan, TypedExprInfo)
	TypedBlockExpr(List[TypedExpr], SourceSpan, TypedExprInfo)
	TypedWithExpr(TypedWithBinding, TypedExpr, SourceSpan, TypedExprInfo)
	TypedDebugBlockExpr(TypedExpr, SourceSpan, TypedExprInfo)
	TypedVarDeclExpr(TypedVarDeclPayload, TypedExprInfo)
	TypedQuestionBindExpr(ParsedIdentifier, Option[SemanticType], TypedExpr, SourceSpan, TypedExprInfo)
	TypedBreakExpr(SourceSpan, TypedExprInfo)
	TypedContinueExpr(SourceSpan, TypedExprInfo)
	TypedVoidExpr(SourceSpan, TypedExprInfo)
	TypedBuiltinExpr(Option[String], SourceSpan, TypedExprInfo)
	TypedMissingExpr(SourceSpan, TypedExprInfo)
	TypedUnsupportedExpr(String, SourceSpan, TypedExprInfo)


union ExpectedValueSlotContext:
	ExpectedArgumentSlot
	ExpectedCollectionElementSlot(CollectionKind)
	ExpectedBitwiseOperandSlot


private union InferExpectation:
	NoExpectedValue
	ExpectedValue(SemanticType)
	ExpectedValueInSlot(SemanticType, ExpectedValueSlotContext)


record InferContext {
	state: InferSession,
	expectation: InferExpectation,
	in_loop: Bool,
	in_debug: Bool,
	suppress_debug_only_reference: Bool
}


private record TraitSelfCallResolution {
	context: InferContext,
	callee: TypedExpr,
	params: List[SemanticType],
	return_type: SemanticType,
	resolved_call: Option[ResolvedCallInfo]
}


private record CallSignature {
	bound_params: List[BoundTypeParam],
	params: List[SemanticType],
	return_type: SemanticType
}


record InferResult {
	context: InferContext,
	expr: TypedExpr
}


private record MemoizedTypeShapeCheck {
	contains: Bool,
	memo: TypeShapeMemo
}


private struct ResourceCapabilityPresence {
	contains_one_shot_stream: Bool,
	contains_resource_source: Bool
}


private record ResourceCapabilityCaptureNames {
	one_shot_streams: List[String],
	resource_sources: List[String]
}


private record CheckedType {
	context: InferContext,
	typ: SemanticType
}


private record InferCallArgsResult {
	context: InferContext,
	args: List[TypedExpr],
	subst: List[SemanticTypeSubstEntry]
}


private record InferConcurrentParamsResult {
	context: InferContext,
	params: List[TypedConcurrentParam]
}


private record SelectChannelTypeResult {
	context: InferContext,
	element_type: Option[SemanticType]
}


private record InferWithTryBindingResult {
	context: InferContext,
	inner_type: SemanticType,
	error_map: Option[TypedWithErrorMap]
}


private record BindTypeSubstResult {
	context: InferContext,
	subst: List[SemanticTypeSubstEntry]
}


private record VarDimsSubstEntry {
	var_name: String,
	concrete_dims: List[SemanticType]
}


private record BindVarDimsSubstResult {
	context: InferContext,
	subst: List[VarDimsSubstEntry]
}


private record InferExprListResult {
	context: InferContext,
	exprs: List[TypedExpr]
}


private record InferDictEntriesResult {
	context: InferContext,
	entries: List[TypedDictEntry]
}


private record InferRecordFieldsResult {
	context: InferContext,
	fields: List[TypedRecordField]
}


private record InferStringInterpolationPartsResult {
	context: InferContext,
	parts: List[TypedStringInterpolationPart]
}


private record InferLambdaParamsResult {
	context: InferContext,
	params: List[TypedLambdaParam],
	param_types: List[SemanticType]
}


private record InferPatternResult {
	context: InferContext,
	env: Env,
	pattern: TypedPattern,
	catch_all: Bool,
	matches_true: Bool,
	matches_false: Bool
}


private record InferPatternItemsResult {
	context: InferContext,
	env: Env,
	patterns: List[TypedPattern]
}


private record InferMatchCasesResult {
	context: InferContext,
	cases: List[TypedMatchCase],
	result_type: Option[SemanticType],
	catch_all: Bool,
	matches_true: Bool,
	matches_false: Bool
}


private record ListPatternCoverage {
	fixed_length: Int,
	has_spread: Bool
}


private record ForTupleElementsResult {
	context: InferContext,
	elements: List[SemanticType],
	ok: Bool
}


private record SubscriptIndexEvidence {
	expr: TypedExpr,
	static_value: Option[Int]
}


private record InferSubscriptIndicesResult {
	context: InferContext,
	indices: List[SubscriptIndexEvidence]
}


private record ValidatedSubscriptIndex {
	context: InferContext,
	index: TypedExpr
}


private record ValidatedSubscriptIndices {
	context: InferContext,
	indices: List[TypedExpr]
}


private enum OpaqueConversion:
	OpaqueIntoConversion
	OpaqueFromConversion


private record OpaqueConversionTypeResult {
	context: InferContext,
	source_type: SemanticType,
	opaque_type: SemanticType,
	target_type: SemanticType,
	ok: Bool
}


private union QuestionBindCarrier:
	QuestionBindOptionCarrier(SemanticType)
	QuestionBindResultCarrier(SemanticType, SemanticType)
	QuestionBindNonCarrier


pure func infer_context(state: TypecheckState) -> InferContext:
	{
		state = infer_session_from_typecheck_state(state),
		expectation = NoExpectedValue,
		in_loop = False,
		in_debug = False,
		suppress_debug_only_reference = False
	}


private pure func infer_resolve_alias(context: InferContext, typ: SemanticType) -> SemanticType:
	match module_view_accepted_type_alias_index(context.state.facts.module_view):
		Some(index):
			type_alias_index_resolve(index, typ)
		None:
			env_resolve_alias(context.state.env, typ)


private pure func infer_resolve_alias_head(
	context: InferContext,
	typ: SemanticType,
) -> SemanticType:
	match module_view_accepted_type_alias_index(context.state.facts.module_view):
		Some(index):
			type_alias_index_resolve_head(index, typ)
		None:
			env_resolve_alias_head(context.state.env, typ)


private pure func infer_find_opaque_alias(
	context: InferContext,
	name: String,
) -> Option[(List[String], SemanticType, Option[String])]:
	match module_view_accepted_type_alias_index(context.state.facts.module_view):
		Some(index):
			type_alias_index_find_opaque(
				index,
				name,
			).map(
				func(
					alias_entry,
				): (alias_entry.type_params, alias_entry.target, alias_entry.home_module),
			)
		None:
			env_get_opaque_alias(context.state.env, name)


private pure func infer_canonical_expected_type(
	context: InferContext,
	source_type: SemanticType,
) -> SemanticType:
	qualified = resolve_qualified_type_names(
		module_view_module_aliases(context.state.facts.module_view),
		source_type,
	)
	type_instantiate_type_params(
		env_get_type_params(context.state.env),
		infer_resolve_alias(context, qualified),
	)


pure func infer_with_canonical_expected(
	context: InferContext,
	expected_type: SemanticType,
) -> InferContext:
	{ context | expectation = ExpectedValue(expected_type) }


pure func infer_with_canonical_expected_value_slot(
	context: InferContext,
	expected_type: SemanticType,
	expected_slot: ExpectedValueSlotContext,
) -> InferContext:
	{ context | expectation = ExpectedValueInSlot(expected_type, expected_slot) }


pure func infer_without_expected(context: InferContext) -> InferContext:
	{
		state = context.state,
		expectation = NoExpectedValue,
		in_loop = context.in_loop,
		in_debug = context.in_debug,
		suppress_debug_only_reference = context.suppress_debug_only_reference
	}


private pure func infer_context_with_state(
	context: InferContext,
	state: InferSession,
) -> InferContext:
	{
		state = state,
		expectation = context.expectation,
		in_loop = context.in_loop,
		in_debug = context.in_debug,
		suppress_debug_only_reference = context.suppress_debug_only_reference
	}


private pure func infer_loop_body_context(context: InferContext) -> InferContext:
	{
		state = context.state,
		expectation = NoExpectedValue,
		in_loop = True,
		in_debug = context.in_debug,
		suppress_debug_only_reference = context.suppress_debug_only_reference
	}


-- Recombine the narrow body session only when a caller leaves expression
-- inference. Immutable module facts remain nested in the session, and the
-- recursive hot path performs no broad-state reconstruction.
pure func infer_context_typecheck_state(context: InferContext) -> TypecheckState:
	typecheck_state_from_infer_session(context.state)


private pure func infer_facts_allows_scoped_trait_function(
	facts: InferModuleFacts,
	function_name: String,
	trait_name: String,
) -> Bool:
	facts.scoped_trait_functions.any(func(pair): pair[0] == function_name and pair[1] == trait_name)


private pure func infer_facts_find_scoped_trait_function(
	facts: InferModuleFacts,
	function_name: String,
) -> Option[String]:
	match facts.scoped_trait_functions.find(func(pair): pair[0] == function_name):
		Some(pair):
			Some(pair[1])
		None:
			None


private pure func infer_facts_find_type_home_entry(
	facts: InferModuleFacts,
	type_name: String,
) -> Option[TypecheckTypeHome]:
	facts.type_homes.find(func(home): home.type_name == type_name)


private pure func infer_facts_find_type_home(
	facts: InferModuleFacts,
	type_name: String,
) -> Option[String]:
	infer_facts_find_type_home_entry(facts, type_name).map(func(home): home.module_path)


private pure func infer_facts_type_home_is_imported(
	facts: InferModuleFacts,
	type_name: String,
) -> Bool:
	match infer_facts_find_type_home_entry(facts, type_name):
		Some(home):
			home.imported
		None:
			False


private pure func infer_facts_type_home_matches(
	facts: InferModuleFacts,
	type_name: String,
	module_path: String,
) -> Bool:
	infer_facts_find_type_home(facts, type_name) == Some(module_path)


private pure func infer_expected_slot(
	context: InferContext,
	semantic_type: SemanticType,
) -> ValueSlot:
	match context.expectation:
		ExpectedValueInSlot(expected_type, slot_context):
			match slot_context:
				ExpectedArgumentSlot:
					argument_target_slot(context.state.context, expected_type, semantic_type)
				ExpectedCollectionElementSlot(kind):
					collection_element_target_slot(kind, expected_type, semantic_type)
				ExpectedBitwiseOperandSlot:
					bitwise_operand_target_slot(expected_type, semantic_type)
		NoExpectedValue | ExpectedValue(_):
			KeptValueSlot(semantic_type)


pure func infer_context_expected_type(context: InferContext) -> Option[SemanticType]:
	match context.expectation:
		NoExpectedValue:
			None
		ExpectedValue(expected_type) | ExpectedValueInSlot(expected_type, _):
			Some(expected_type)


pure func infer_context_expected_slot(context: InferContext) -> Option[ExpectedValueSlotContext]:
	match context.expectation:
		ExpectedValueInSlot(_, expected_slot):
			Some(expected_slot)
		NoExpectedValue | ExpectedValue(_):
			None


private pure func typed_expr_info_from_slot(
	source_type: Option[SemanticType],
	origin: ExprTypeOrigin,
	proofs: ValueProofs,
	resolved_call: Option[ResolvedCallInfo],
	value_slot: ValueSlot,
) -> TypedExprInfo:
	{
		source_type = source_type,
		origin = origin,
		value_slot = value_slot,
		proofs = proofs,
		resolved_call = resolved_call,
		resolved_definition_id = None,
		resource_dependencies = []
	}


private pure func inferred_info(
	context: InferContext,
	semantic_type: SemanticType,
) -> TypedExprInfo:
	typed_expr_info_from_slot(
		None,
		InferredOrigin,
		UNREFINED_BINDING,
		None,
		infer_expected_slot(context, semantic_type),
	)


private pure func callable_origin_from_func(
	origin: FuncOrigin,
	module_path: Option[String],
) -> CallableOrigin:
	match origin:
		UserDefinedFunc:
			match module_path:
				Some(path):
					CallableImported(path)
				None:
					CallableLocal
		BuiltinFunc:
			match module_path:
				Some(path):
					CallableImported(path)
				None:
					CallableBuiltin
		ForeignFunc:
			CallableForeign


pure func resolved_call_callable_id(info: ResolvedCallInfo) -> Option[Int]:
	match info.target:
		ResolvedDirectCall(callable_id, _):
			Some(callable_id)
		ResolvedTraitMethodCall(_, impl_target):
			impl_target.map(func(target): target.callable_id)
		ResolvedIntrinsicCall:
			None
		ResolvedClosureCall:
			None


private pure func resolved_loop_producer(
	producer: Option[LoopProducer],
) -> Option[ResolvedLoopProducer]:
	match producer:
		Some(value):
			if loop_producer_is_indices(value):
				Some(ResolvedLoopProducerIndices)
			else if loop_producer_is_enumerate(value):
				Some(ResolvedLoopProducerEnumerate)
			else if loop_producer_is_enumerate2(value):
				Some(ResolvedLoopProducerEnumerate2)
			else if loop_producer_is_windows(value):
				Some(ResolvedLoopProducerWindows)
			else:
				None
		None:
			None


private pure func resolved_call_params_from_type(func_type: SemanticType) -> List[SemanticType]:
	match func_type:
		SemanticFunctionType(_, params, _):
			params
		_:
			[]


private pure func resolved_call_return_from_type(func_type: SemanticType) -> SemanticType:
	match func_type:
		SemanticFunctionType(_, _, return_type):
			return_type
		_:
			func_type


private pure func resolved_call_from_trait_method_callee(
	callee: TraitMethodCallee,
	impl_target: Option[ImplMethodTarget],
) -> ResolvedCallInfo:
	purity = if callee.method.is_pure:
		Pure
	else:
		Impure

	{
		callee_name = callee.method_name,
		source_name = callee.source_name,
		purity = purity,
		target = ResolvedTraitMethodCall(callee.trait_name, impl_target),
		instantiated_params = callee.method.params,
		instantiated_return = callee.method.return_type,
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}


private pure func resolved_call_from_closure(
	is_pure: Bool,
	params: List[SemanticType],
	return_type: SemanticType,
) -> ResolvedCallInfo:
	purity = if is_pure:
		Pure
	else:
		Impure

	{
		callee_name = "<closure>",
		source_name = "<closure>",
		purity = purity,
		target = ResolvedClosureCall,
		instantiated_params = params,
		instantiated_return = return_type,
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}


private pure func trait_method_resource_args_for_type(
	context: InferContext,
	trait_name: String,
	method_name: String,
	receiver_type: SemanticType,
	fallback: ResourceArgPolicy,
) -> ResourceArgPolicy:
	match infer_find_impl_method_info(context, trait_name, method_name, receiver_type):
		Some(method_info):
			method_info.resource_args
		None:
			fallback


private pure func resolved_call_from_func_symbol_with_source(
	callee_name: String,
	source_name: String,
	func_symbol: FuncSymbol,
) -> ResolvedCallInfo:
	{
		callee_name = callee_name,
		source_name = source_name,
		purity = func_symbol.purity,
		target = ResolvedDirectCall(
			func_symbol.callable_id,
			callable_origin_from_func(func_symbol.origin, func_symbol.module_path),
		),
		instantiated_params = resolved_call_params_from_type(func_symbol.func_type),
		instantiated_return = resolved_call_return_from_type(func_symbol.func_type),
		resource_args = func_symbol.resource_args,
		dim_constraints = func_symbol.dim_constraints,
		loop_producer = resolved_loop_producer(func_symbol.loop_producer)
	}


private pure func resolved_call_from_overload_entry(
	callee_name: String,
	source_name: String,
	entry: OverloadEntry,
) -> ResolvedCallInfo:
	{
		callee_name = callee_name,
		source_name = source_name,
		purity = entry.purity,
		target = ResolvedDirectCall(
			entry.def_id,
			callable_origin_from_func(entry.origin, entry.module_path),
		),
		instantiated_params = resolved_call_params_from_type(entry.func_type),
		instantiated_return = resolved_call_return_from_type(entry.func_type),
		resource_args = entry.resource_args,
		dim_constraints = entry.dim_constraints,
		loop_producer = resolved_loop_producer(entry.loop_producer)
	}


private pure func resolved_call_from_constructor(
	callee_name: String,
	callable_id: Int,
	parent_type: String,
	constructor_type: SemanticType,
) -> ResolvedCallInfo:
	{
		callee_name = callee_name,
		source_name = callee_name,
		purity = Pure,
		target = ResolvedDirectCall(callable_id, CallableConstructor(parent_type)),
		instantiated_params = resolved_call_params_from_type(constructor_type),
		instantiated_return = resolved_call_return_from_type(constructor_type),
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}


pure func typed_expr_info(expr: TypedExpr) -> TypedExprInfo:
	match expr:
		TypedNameExpr(_, info):
			info
		TypedIntLiteralExpr(_, _, info):
			info
		TypedFloatLiteralExpr(_, _, info):
			info
		TypedStringLiteralExpr(_, _, info):
			info
		TypedStringInterpolationExpr(_, _, _, info):
			info
		TypedStringInterpolationPartsExpr(_, _, _, info):
			info
		TypedBoolLiteralExpr(_, _, info):
			info
		TypedCharLiteralExpr(_, _, info):
			info
		TypedUnaryExpr(_, _, _, info):
			info
		TypedBinaryExpr(_, _, _, _, info):
			info
		TypedLogicalExpr(_, _, _, _, info):
			info
		TypedCallExpr(_, _, _, info):
			info
		TypedTupleExpr(_, _, info):
			info
		TypedTupleDestructExpr(_, _, _, info):
			info
		TypedAssignExpr(_, _, _, _, info):
			info
		TypedSubscriptExpr(_, _, _, info):
			info
		TypedSubscriptAssignExpr(_, _, _, _, _, info):
			info
		TypedListExpr(_, _, info):
			info
		TypedVectorExpr(_, _, info):
			info
		TypedDictExpr(_, _, info):
			info
		TypedOpaqueIntoExpr(_, _, _, info):
			info
		TypedOpaqueFromExpr(_, _, _, info):
			info
		TypedRecordExpr(_, _, info):
			info
		TypedRecordUpdateExpr(_, _, _, _, info):
			info
		TypedFieldAccessExpr(_, _, _, info):
			info
		TypedLambdaExpr(_, _, _, _, _, info):
			info
		TypedRangeExpr(_, _, _, info):
			info
		TypedIfExpr(_, _, _, _, info):
			info
		TypedMatchExpr(_, _, _, info):
			info
		TypedSelectExpr(_, _, info):
			info
		TypedWhileExpr(_, _, _, info):
			info
		TypedForExpr(_, _, _, _, _, info):
			info
		TypedConcurrentBlockExpr(_, _, _, info):
			info
		TypedConcurrentForExpr(_, _, _, _, _, info):
			info
		TypedDetachExpr(_, _, info):
			info
		TypedAscriptionExpr(_, _, _, info):
			info
		TypedBlockExpr(_, _, info):
			info
		TypedWithExpr(_, _, _, info):
			info
		TypedDebugBlockExpr(_, _, info):
			info
		TypedVarDeclExpr(_, info):
			info
		TypedQuestionBindExpr(_, _, _, _, info):
			info
		TypedBreakExpr(_, info):
			info
		TypedContinueExpr(_, info):
			info
		TypedVoidExpr(_, info):
			info
		TypedBuiltinExpr(_, _, info):
			info
		TypedMissingExpr(_, info):
			info
		TypedUnsupportedExpr(_, _, info):
			info


private pure func typed_expr_with_info(expr: TypedExpr, info: TypedExprInfo) -> TypedExpr:
	match expr:
		TypedNameExpr(name, _):
			TypedNameExpr(name, info)
		TypedIntLiteralExpr(text, span, _):
			TypedIntLiteralExpr(text, span, info)
		TypedFloatLiteralExpr(text, span, _):
			TypedFloatLiteralExpr(text, span, info)
		TypedStringLiteralExpr(text, span, _):
			TypedStringLiteralExpr(text, span, info)
		TypedStringInterpolationExpr(text, raw, span, _):
			TypedStringInterpolationExpr(text, raw, span, info)
		TypedStringInterpolationPartsExpr(parts, multiline, span, _):
			TypedStringInterpolationPartsExpr(parts, multiline, span, info)
		TypedBoolLiteralExpr(value, span, _):
			TypedBoolLiteralExpr(value, span, info)
		TypedCharLiteralExpr(value, span, _):
			TypedCharLiteralExpr(value, span, info)
		TypedUnaryExpr(op, inner, span, _):
			TypedUnaryExpr(op, inner, span, info)
		TypedBinaryExpr(op, left, right, span, _):
			TypedBinaryExpr(op, left, right, span, info)
		TypedLogicalExpr(op, left, right, span, _):
			TypedLogicalExpr(op, left, right, span, info)
		TypedCallExpr(callee, args, span, _):
			TypedCallExpr(callee, args, span, info)
		TypedTupleExpr(items, span, _):
			TypedTupleExpr(items, span, info)
		TypedTupleDestructExpr(names, value, span, _):
			TypedTupleDestructExpr(names, value, span, info)
		TypedAssignExpr(name, scope, value, span, _):
			TypedAssignExpr(name, scope, value, span, info)
		TypedSubscriptExpr(receiver, indices, span, _):
			TypedSubscriptExpr(receiver, indices, span, info)
		TypedSubscriptAssignExpr(assign_target, receiver, indices, value, span, _):
			TypedSubscriptAssignExpr(assign_target, receiver, indices, value, span, info)
		TypedListExpr(items, span, _):
			TypedListExpr(items, span, info)
		TypedVectorExpr(items, span, _):
			TypedVectorExpr(items, span, info)
		TypedDictExpr(entries, span, _):
			TypedDictExpr(entries, span, info)
		TypedOpaqueIntoExpr(source_type, inner, span, _):
			TypedOpaqueIntoExpr(source_type, inner, span, info)
		TypedOpaqueFromExpr(source_type, inner, span, _):
			TypedOpaqueFromExpr(source_type, inner, span, info)
		TypedRecordExpr(fields, span, _):
			TypedRecordExpr(fields, span, info)
		TypedRecordUpdateExpr(receiver, fields, record_fields, span, _):
			TypedRecordUpdateExpr(receiver, fields, record_fields, span, info)
		TypedFieldAccessExpr(receiver, field, span, _):
			TypedFieldAccessExpr(receiver, field, span, info)
		TypedLambdaExpr(is_pure, params, return_annotation, body, span, _):
			TypedLambdaExpr(is_pure, params, return_annotation, body, span, info)
		TypedRangeExpr(start_expr, end_expr, span, _):
			TypedRangeExpr(start_expr, end_expr, span, info)
		TypedIfExpr(condition, then_branch, else_branch, span, _):
			TypedIfExpr(condition, then_branch, else_branch, span, info)
		TypedMatchExpr(scrutinee, cases, span, _):
			TypedMatchExpr(scrutinee, cases, span, info)
		TypedSelectExpr(arms, span, _):
			TypedSelectExpr(arms, span, info)
		TypedWhileExpr(condition, body, span, _):
			TypedWhileExpr(condition, body, span, info)
		TypedForExpr(binder, iterable, loop_view, body, span, _):
			TypedForExpr(binder, iterable, loop_view, body, span, info)
		TypedConcurrentBlockExpr(params, bindings, span, _):
			TypedConcurrentBlockExpr(params, bindings, span, info)
		TypedConcurrentForExpr(name, iterable, params, body, span, _):
			TypedConcurrentForExpr(name, iterable, params, body, span, info)
		TypedDetachExpr(body, span, _):
			TypedDetachExpr(body, span, info)
		TypedAscriptionExpr(inner, source_type, span, _):
			TypedAscriptionExpr(inner, source_type, span, info)
		TypedBlockExpr(items, span, _):
			TypedBlockExpr(items, span, info)
		TypedWithExpr(binding, body, span, _):
			TypedWithExpr(binding, body, span, info)
		TypedDebugBlockExpr(body, span, _):
			TypedDebugBlockExpr(body, span, info)
		TypedVarDeclExpr(payload, _):
			TypedVarDeclExpr(payload, info)
		TypedQuestionBindExpr(name, annotation, value, span, _):
			TypedQuestionBindExpr(name, annotation, value, span, info)
		TypedBreakExpr(span, _):
			TypedBreakExpr(span, info)
		TypedContinueExpr(span, _):
			TypedContinueExpr(span, info)
		TypedVoidExpr(span, _):
			TypedVoidExpr(span, info)
		TypedBuiltinExpr(name, span, _):
			TypedBuiltinExpr(name, span, info)
		TypedMissingExpr(span, _):
			TypedMissingExpr(span, info)
		TypedUnsupportedExpr(label, span, _):
			TypedUnsupportedExpr(label, span, info)


pure func typed_expr_with_slot(expr: TypedExpr, value_slot: ValueSlot) -> TypedExpr:
	info = typed_expr_info(expr)
	typed_expr_with_info(expr, { info | value_slot = value_slot })


pure func typed_expr_source_type(expr: TypedExpr) -> Option[SemanticType]:
	typed_expr_info(expr).source_type


pure func typed_expr_info_semantic_type(info: TypedExprInfo) -> SemanticType:
	widening_semantic_type(info.value_slot)


pure func typed_expr_info_value_type(info: TypedExprInfo) -> SemanticType:
	widening_value_type(info.value_slot)


pure func typed_expr_semantic_type(expr: TypedExpr) -> SemanticType:
	typed_expr_info_semantic_type(typed_expr_info(expr))


pure func typed_expr_value_type(expr: TypedExpr) -> SemanticType:
	typed_expr_info_value_type(typed_expr_info(expr))


pure func typed_expr_origin(expr: TypedExpr) -> ExprTypeOrigin:
	typed_expr_info(expr).origin


pure func typed_expr_widening(expr: TypedExpr) -> TypeWideningDecision:
	widening_decision(typed_expr_info(expr).value_slot)


pure func typed_expr_resolved_call(expr: TypedExpr) -> Option[ResolvedCallInfo]:
	typed_expr_info(expr).resolved_call


pure func typed_expr_resolved_definition_id(expr: TypedExpr) -> Option[Int]:
	typed_expr_info(expr).resolved_definition_id


private pure func optional_type_contains_meta(typ: Option[SemanticType]) -> Bool:
	match typ:
		Some(value):
			type_contains_meta(value)
		None:
			False


private pure func expr_type_origin_contains_meta(origin: ExprTypeOrigin) -> Bool:
	match origin:
		ExplicitAnnotationOrigin(typ):
			type_contains_meta(typ)
		InferredOrigin:
			False
		SynthesizedOrigin(_):
			False


private pure func value_slot_contains_meta(slot: ValueSlot) -> Bool:
	match slot:
		KeptValueSlot(typ):
			type_contains_meta(typ)
		WidenedValueSlot(semantic_type, value_type, _):
			type_contains_meta(semantic_type) or type_contains_meta(value_type)


private pure func type_list_contains_meta(types: List[SemanticType]) -> Bool:
	var found: Bool = False

	for typ in types:
		if type_contains_meta(typ):
			found = True
			break

	found


private pure func resolved_call_contains_meta(info: ResolvedCallInfo) -> Bool:
	var found: Bool = False

	for constraint in info.dim_constraints:
		if type_contains_meta(constraint[0]) or type_contains_meta(constraint[1]):
			found = True
			break

	(
		found
		or type_list_contains_meta(info.instantiated_params)
		or type_contains_meta(info.instantiated_return)
	)


pure func typed_expr_info_contains_meta(info: TypedExprInfo) -> Bool:
	resolved_call_has_meta = match info.resolved_call:
		Some(value):
			resolved_call_contains_meta(value)
		None:
			False

	(
		optional_type_contains_meta(info.source_type)
		or expr_type_origin_contains_meta(info.origin)
		or value_slot_contains_meta(info.value_slot)
		or resolved_call_has_meta
	)


private pure func typed_expr_info_origin_error(info: TypedExprInfo) -> Option[String]:
	match info.origin:
		ExplicitAnnotationOrigin(origin_type):
			match info.source_type:
				Some(source_type):
					if types_equal(origin_type, source_type):
						None
					else:
						Some("explicit origin type must match source type")
				None:
					Some("explicit origin requires source type")
		InferredOrigin:
			None
		SynthesizedOrigin(_):
			None


private pure func dim_constraints_equal(
	left: List[(SemanticType, SemanticType)],
	right: List[(SemanticType, SemanticType)],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal: Bool = True
		var index: Int = 0

		while equal and index < left.length():
			match (left.get(index), right.get(index)):
				(Some(left_pair), Some(right_pair)):
					equal = (
						types_equal(left_pair[0], right_pair[0])
						and types_equal(left_pair[1], right_pair[1])
					)
				_:
					equal = False

			index += 1

		equal


private pure func callable_origins_equal(left: CallableOrigin, right: CallableOrigin) -> Bool:
	match left:
		CallableLocal:
			match right:
				CallableLocal:
					True
				_:
					False
		CallableImported(left_path):
			match right:
				CallableImported(right_path):
					left_path == right_path
				_:
					False
		CallableBuiltin:
			match right:
				CallableBuiltin:
					True
				_:
					False
		CallableForeign:
			match right:
				CallableForeign:
					True
				_:
					False
		CallableConstructor(left_parent):
			match right:
				CallableConstructor(right_parent):
					left_parent == right_parent
				_:
					False
		CallableImplMethod:
			match right:
				CallableImplMethod:
					True
				_:
					False


private pure func resolved_call_targets_equal(
	left: ResolvedCallTarget,
	right: ResolvedCallTarget,
) -> Bool:
	match left:
		ResolvedDirectCall(left_id, left_origin):
			match right:
				ResolvedDirectCall(right_id, right_origin):
					left_id == right_id and callable_origins_equal(left_origin, right_origin)
				_:
					False
		ResolvedTraitMethodCall(left_trait, left_target):
			match right:
				ResolvedTraitMethodCall(right_trait, right_target):
					left_trait == right_trait and match left_target:
						Some(left_value):
							match right_target:
								Some(right_value):
									(
										left_value.callable_id == right_value.callable_id
										and left_value.module_path == right_value.module_path
									)
								None:
									False
						None:
							right_target.is_none()
				_:
					False
		ResolvedIntrinsicCall:
			match right:
				ResolvedIntrinsicCall:
					True
				_:
					False
		ResolvedClosureCall:
			match right:
				ResolvedClosureCall:
					True
				_:
					False


private pure func optional_resolved_loop_producers_equal(
	left: Option[ResolvedLoopProducer],
	right: Option[ResolvedLoopProducer],
) -> Bool:
	match left:
		Some(left_value):
			match right:
				Some(right_value):
					left_value == right_value
				None:
					False
		None:
			right.is_none()


private pure func resolved_call_infos_equal(
	left: ResolvedCallInfo,
	right: ResolvedCallInfo,
) -> Bool:
	(
		left.callee_name == right.callee_name
		and left.source_name == right.source_name
		and purities_equal(left.purity, right.purity)
		and resolved_call_targets_equal(left.target, right.target)
		and resource_arg_policies_equal(left.resource_args, right.resource_args)
		and dim_constraints_equal(left.dim_constraints, right.dim_constraints)
		and optional_resolved_loop_producers_equal(left.loop_producer, right.loop_producer)
	)


private pure func direct_callable_resolution(callee: TypedExpr) -> Option[ResolvedCallInfo]:
	match callee:
		TypedNameExpr(_, _):
			typed_expr_resolved_call(callee)
		TypedFieldAccessExpr(_, _, _, _):
			typed_expr_resolved_call(callee)
		_:
			None


private pure func typed_call_resolved_metadata_error(
	callee: TypedExpr,
	call_info: TypedExprInfo,
) -> Option[String]:
	match direct_callable_resolution(callee):
		Some(callee_call):
			match call_info.resolved_call:
				Some(call_call):
					if resolved_call_infos_equal(callee_call, call_call):
						None
					else:
						Some("call expression resolved-call metadata must match callee")
				None:
					Some("call expression missing resolved-call metadata from callee")
		None:
			match call_info.resolved_call:
				Some(call):
					match call.target:
						ResolvedClosureCall:
							match typed_expr_semantic_type(callee):
								SemanticFunctionType(is_pure, _, _):
									callee_purity = if is_pure:
										Pure
									else:
										Impure

									if purities_equal(call.purity, callee_purity):
										None
									else:
										Some("indirect call resolved-call purity must match callee")
								_:
									None
						_:
							Some("indirect call must have closure resolved-call metadata")
				None:
					Some("call expression is missing resolved-call metadata")


pure func typed_expr_info_type_error(info: TypedExprInfo) -> Option[String]:
	typed_expr_info_origin_error(info)


private pure func first_typed_expr_type_error(exprs: List[TypedExpr]) -> Option[String]:
	var result: Option[String] = None

	for expr in exprs:
		match result:
			Some(_):
				break
			None:
				result = typed_expr_type_error(expr)

	result


private pure func optional_typed_expr_type_error(expr: Option[TypedExpr]) -> Option[String]:
	match expr:
		Some(value):
			typed_expr_type_error(value)
		None:
			None


private pure func typed_dict_entry_type_error(entry: TypedDictEntry) -> Option[String]:
	match typed_expr_type_error(entry.key):
		Some(message):
			Some(message)
		None:
			typed_expr_type_error(entry.value)


private pure func typed_dict_entries_type_error(entries: List[TypedDictEntry]) -> Option[String]:
	var result: Option[String] = None

	for entry in entries:
		match result:
			Some(_):
				break
			None:
				result = typed_dict_entry_type_error(entry)

	result


private pure func typed_record_fields_type_error(fields: List[TypedRecordField]) -> Option[String]:
	var result: Option[String] = None

	for field in fields:
		match result:
			Some(_):
				break
			None:
				result = typed_expr_type_error(field.value)

	result


private pure func typed_string_interpolation_part_type_error(
	part: TypedStringInterpolationPart,
) -> Option[String]:
	match part:
		TypedInterpolationLiteral(_):
			None
		TypedInterpolationExpr(expr):
			typed_expr_type_error(expr)


private pure func typed_string_interpolation_parts_type_error(
	parts: List[TypedStringInterpolationPart],
) -> Option[String]:
	var result: Option[String] = None

	for part in parts:
		match result:
			Some(_):
				break
			None:
				result = typed_string_interpolation_part_type_error(part)

	result


private pure func typed_match_cases_type_error(cases: List[TypedMatchCase]) -> Option[String]:
	var result: Option[String] = None

	for case in cases:
		match result:
			Some(_):
				break
			None:
				result = typed_expr_type_error(case.body)

	result


private pure func typed_select_arm_kind_type_error(kind: TypedSelectArmKind) -> Option[String]:
	match kind:
		TypedSelectReceiveArm(_, _, channel):
			typed_expr_type_error(channel)
		TypedSelectSealedArm(_, channel):
			typed_expr_type_error(channel)
		TypedSelectAfterArm(timeout):
			typed_expr_type_error(timeout)


private pure func typed_select_arm_type_error(arm: TypedSelectArm) -> Option[String]:
	match typed_select_arm_kind_type_error(arm.kind):
		Some(message):
			Some(message)
		None:
			typed_expr_type_error(arm.body)


private pure func typed_select_arms_type_error(arms: List[TypedSelectArm]) -> Option[String]:
	var result: Option[String] = None

	for arm in arms:
		match result:
			Some(_):
				break
			None:
				result = typed_select_arm_type_error(arm)

	result


private pure func typed_concurrent_params_type_error(
	params: List[TypedConcurrentParam],
) -> Option[String]:
	var result: Option[String] = None

	for param in params:
		match result:
			Some(_):
				break
			None:
				result = typed_expr_type_error(param.value)

	result


private pure func typed_concurrent_bindings_type_error(
	bindings: List[TypedConcurrentBinding],
) -> Option[String]:
	var result: Option[String] = None

	for binding in bindings:
		match result:
			Some(_):
				break
			None:
				result = typed_expr_type_error(binding.value)

	result


private pure func optional_typed_with_error_map_type_error(
	error_map: Option[TypedWithErrorMap],
) -> Option[String]:
	match error_map:
		Some(value):
			typed_expr_type_error(value.value)
		None:
			None


private pure func typed_with_binding_type_error(binding: TypedWithBinding) -> Option[String]:
	match typed_expr_type_error(binding.value):
		Some(message):
			Some(message)
		None:
			optional_typed_with_error_map_type_error(binding.error_map)


pure func typed_expr_type_error(expr: TypedExpr) -> Option[String]:
	match typed_expr_info_type_error(typed_expr_info(expr)):
		Some(message):
			Some(message)
		None:
			match expr:
				TypedNameExpr(_, _):
					None
				TypedIntLiteralExpr(_, _, _):
					None
				TypedFloatLiteralExpr(_, _, _):
					None
				TypedStringLiteralExpr(_, _, _):
					None
				TypedStringInterpolationExpr(_, _, _, _):
					None
				TypedStringInterpolationPartsExpr(parts, _, _, _):
					typed_string_interpolation_parts_type_error(parts)
				TypedBoolLiteralExpr(_, _, _):
					None
				TypedCharLiteralExpr(_, _, _):
					None
				TypedUnaryExpr(_, inner, _, _):
					typed_expr_type_error(inner)
				TypedBinaryExpr(_, left, right, _, _):
					match typed_expr_type_error(left):
						Some(message):
							Some(message)
						None:
							typed_expr_type_error(right)
				TypedLogicalExpr(_, left, right, _, _):
					match typed_expr_type_error(left):
						Some(message):
							Some(message)
						None:
							typed_expr_type_error(right)
				TypedCallExpr(callee, args, _, info):
					match typed_expr_type_error(callee):
						Some(message):
							Some(message)
						None:
							match typed_call_resolved_metadata_error(callee, info):
								Some(message):
									Some(message)
								None:
									first_typed_expr_type_error(args)
				TypedTupleExpr(items, _, _):
					first_typed_expr_type_error(items)
				TypedTupleDestructExpr(_, value, _, _):
					typed_expr_type_error(value)
				TypedAssignExpr(_, _, value, _, _):
					typed_expr_type_error(value)
				TypedSubscriptExpr(receiver, indices, _, _):
					match typed_expr_type_error(receiver):
						Some(message):
							Some(message)
						None:
							first_typed_expr_type_error(indices)
				TypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
					match typed_expr_type_error(receiver):
						Some(message):
							Some(message)
						None:
							match first_typed_expr_type_error(indices):
								Some(message):
									Some(message)
								None:
									typed_expr_type_error(value)
				TypedListExpr(items, _, _):
					first_typed_expr_type_error(items)
				TypedVectorExpr(items, _, _):
					first_typed_expr_type_error(items)
				TypedDictExpr(entries, _, _):
					typed_dict_entries_type_error(entries)
				TypedOpaqueIntoExpr(_, inner, _, _):
					typed_expr_type_error(inner)
				TypedOpaqueFromExpr(_, inner, _, _):
					typed_expr_type_error(inner)
				TypedRecordExpr(fields, _, _):
					typed_record_fields_type_error(fields)
				TypedRecordUpdateExpr(receiver, fields, _, _, _):
					match typed_expr_type_error(receiver):
						Some(message):
							Some(message)
						None:
							typed_record_fields_type_error(fields)
				TypedFieldAccessExpr(receiver, _, _, _):
					typed_expr_type_error(receiver)
				TypedLambdaExpr(_, _, _, body, _, _):
					typed_expr_type_error(body)
				TypedRangeExpr(start_expr, end_expr, _, _):
					match typed_expr_type_error(start_expr):
						Some(message):
							Some(message)
						None:
							typed_expr_type_error(end_expr)
				TypedIfExpr(condition, then_branch, else_branch, _, _):
					match typed_expr_type_error(condition):
						Some(message):
							Some(message)
						None:
							match typed_expr_type_error(then_branch):
								Some(message):
									Some(message)
								None:
									optional_typed_expr_type_error(else_branch)
				TypedMatchExpr(scrutinee, cases, _, _):
					match typed_expr_type_error(scrutinee):
						Some(message):
							Some(message)
						None:
							typed_match_cases_type_error(cases)
				TypedSelectExpr(arms, _, _):
					typed_select_arms_type_error(arms)
				TypedWhileExpr(condition, body, _, _):
					match typed_expr_type_error(condition):
						Some(message):
							Some(message)
						None:
							typed_expr_type_error(body)
				TypedForExpr(_, iterable, _, body, _, _):
					match typed_expr_type_error(iterable):
						Some(message):
							Some(message)
						None:
							typed_expr_type_error(body)
				TypedConcurrentBlockExpr(params, bindings, _, _):
					match typed_concurrent_params_type_error(params):
						Some(message):
							Some(message)
						None:
							typed_concurrent_bindings_type_error(bindings)
				TypedConcurrentForExpr(_, iterable, params, body, _, _):
					match typed_expr_type_error(iterable):
						Some(message):
							Some(message)
						None:
							match typed_concurrent_params_type_error(params):
								Some(message):
									Some(message)
								None:
									typed_expr_type_error(body)
				TypedDetachExpr(body, _, _):
					typed_expr_type_error(body)
				TypedAscriptionExpr(inner, _, _, _):
					typed_expr_type_error(inner)
				TypedBlockExpr(items, _, _):
					first_typed_expr_type_error(items)
				TypedWithExpr(binding, body, _, _):
					match typed_with_binding_type_error(binding):
						Some(message):
							Some(message)
						None:
							typed_expr_type_error(body)
				TypedDebugBlockExpr(body, _, _):
					typed_expr_type_error(body)
				TypedVarDeclExpr(payload, _):
					typed_expr_type_error(payload.initializer)
				TypedQuestionBindExpr(_, _, value, _, _):
					typed_expr_type_error(value)
				TypedBreakExpr(_, _):
					None
				TypedContinueExpr(_, _):
					None
				TypedVoidExpr(_, _):
					None
				TypedBuiltinExpr(_, _, _):
					None
				TypedMissingExpr(_, _):
					None
				TypedUnsupportedExpr(_, _, _):
					None


private pure func typed_string_interpolation_part_contains_meta(
	part: TypedStringInterpolationPart,
) -> Bool:
	match part:
		TypedInterpolationLiteral(_):
			False
		TypedInterpolationExpr(expr):
			typed_expr_contains_meta(expr)


private pure func typed_pattern_contains_meta(pattern: TypedPattern) -> Bool:
	match pattern:
		TypedWildcardPattern(_):
			False
		TypedNamePattern(_, typ):
			type_contains_meta(typ)
		TypedBoolPattern(_, _):
			False
		TypedIntPattern(_, _):
			False
		TypedFloatPattern(_, _):
			False
		TypedStringPattern(_, _):
			False
		TypedCharPattern(_, _):
			False
		TypedConstructorPattern(_, fields, _, _):
			fields.any(typed_pattern_contains_meta)
		TypedQualifiedConstructorPattern(_, _, fields, _, _):
			fields.any(typed_pattern_contains_meta)
		TypedTuplePattern(items, _):
			items.any(typed_pattern_contains_meta)
		TypedListPattern(items, _, _):
			items.any(typed_pattern_contains_meta)
		TypedOrPattern(items, _):
			items.any(typed_pattern_contains_meta)
		TypedUnsupportedPattern(_, _):
			False


private pure func typed_select_arm_kind_contains_meta(kind: TypedSelectArmKind) -> Bool:
	match kind:
		TypedSelectReceiveArm(_, elem_type, channel):
			type_contains_meta(elem_type) or typed_expr_contains_meta(channel)
		TypedSelectSealedArm(elem_type, channel):
			type_contains_meta(elem_type) or typed_expr_contains_meta(channel)
		TypedSelectAfterArm(timeout):
			typed_expr_contains_meta(timeout)


private pure func optional_typed_with_error_map_contains_meta(
	error_map: Option[TypedWithErrorMap],
) -> Bool:
	match error_map:
		Some(value):
			typed_expr_contains_meta(value.value)
		None:
			False


private pure func typed_with_binding_contains_meta(binding: TypedWithBinding) -> Bool:
	(
		optional_type_contains_meta(binding.annotation)
		or typed_expr_contains_meta(binding.value)
		or optional_typed_with_error_map_contains_meta(binding.error_map)
	)


pure func typed_expr_contains_meta(expr: TypedExpr) -> Bool:
	if typed_expr_info_contains_meta(typed_expr_info(expr)):
		True
	else:
		match expr:
			TypedNameExpr(_, _):
				False
			TypedIntLiteralExpr(_, _, _):
				False
			TypedFloatLiteralExpr(_, _, _):
				False
			TypedStringLiteralExpr(_, _, _):
				False
			TypedStringInterpolationExpr(_, _, _, _):
				False
			TypedStringInterpolationPartsExpr(parts, _, _, _):
				parts.any(typed_string_interpolation_part_contains_meta)
			TypedBoolLiteralExpr(_, _, _):
				False
			TypedCharLiteralExpr(_, _, _):
				False
			TypedUnaryExpr(_, inner, _, _):
				typed_expr_contains_meta(inner)
			TypedBinaryExpr(_, left, right, _, _):
				typed_expr_contains_meta(left) or typed_expr_contains_meta(right)
			TypedLogicalExpr(_, left, right, _, _):
				typed_expr_contains_meta(left) or typed_expr_contains_meta(right)
			TypedCallExpr(callee, args, _, _):
				typed_expr_contains_meta(callee) or args.any(typed_expr_contains_meta)
			TypedTupleExpr(items, _, _):
				items.any(typed_expr_contains_meta)
			TypedTupleDestructExpr(_, value, _, _):
				typed_expr_contains_meta(value)
			TypedAssignExpr(_, _, value, _, _):
				typed_expr_contains_meta(value)
			TypedSubscriptExpr(receiver, indices, _, _):
				typed_expr_contains_meta(receiver) or indices.any(typed_expr_contains_meta)
			TypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
				(
					typed_expr_contains_meta(receiver)
					or indices.any(typed_expr_contains_meta)
					or typed_expr_contains_meta(value)
				)
			TypedListExpr(items, _, _):
				items.any(typed_expr_contains_meta)
			TypedVectorExpr(items, _, _):
				items.any(typed_expr_contains_meta)
			TypedDictExpr(entries, _, _):
				entries.any(
					func(
						entry,
					): (
						typed_expr_contains_meta(entry.key)
						or typed_expr_contains_meta(entry.value)
					),
				)
			TypedOpaqueIntoExpr(source_type, inner, _, _):
				type_contains_meta(source_type) or typed_expr_contains_meta(inner)
			TypedOpaqueFromExpr(source_type, inner, _, _):
				type_contains_meta(source_type) or typed_expr_contains_meta(inner)
			TypedRecordExpr(fields, _, _):
				fields.any(func(field): typed_expr_contains_meta(field.value))
			TypedRecordUpdateExpr(receiver, fields, _, _, _):
				(
					typed_expr_contains_meta(receiver)
					or fields.any(func(field): typed_expr_contains_meta(field.value))
				)
			TypedFieldAccessExpr(receiver, _, _, _):
				typed_expr_contains_meta(receiver)
			TypedLambdaExpr(_, params, return_annotation, body, _, _):
				(
					params.any(
						func(
							param,
						): (
							optional_type_contains_meta(param.source_type)
							or type_contains_meta(param.param_type)
						),
					)
					or optional_type_contains_meta(return_annotation)
					or typed_expr_contains_meta(body)
				)
			TypedRangeExpr(start_expr, end_expr, _, _):
				typed_expr_contains_meta(start_expr) or typed_expr_contains_meta(end_expr)
			TypedIfExpr(condition, then_branch, else_branch, _, _):
				(
					typed_expr_contains_meta(condition)
					or typed_expr_contains_meta(then_branch)
					or match else_branch:
						Some(branch):
							typed_expr_contains_meta(branch)
						None:
							False
				)
			TypedMatchExpr(scrutinee, cases, _, _):
				(
					typed_expr_contains_meta(scrutinee)
					or cases.any(
						func(
							case,
						): (
							typed_pattern_contains_meta(case.pattern)
							or typed_expr_contains_meta(case.body)
						),
					)
				)
			TypedSelectExpr(arms, _, _):
				arms.any(
					func(
						arm,
					): (
						typed_select_arm_kind_contains_meta(arm.kind)
						or typed_expr_contains_meta(arm.body)
					),
				)
			TypedWhileExpr(condition, body, _, _):
				typed_expr_contains_meta(condition) or typed_expr_contains_meta(body)
			TypedForExpr(_, iterable, _, body, _, _):
				typed_expr_contains_meta(iterable) or typed_expr_contains_meta(body)
			TypedConcurrentBlockExpr(params, bindings, _, _):
				(
					params.any(func(param): typed_expr_contains_meta(param.value))
					or bindings.any(
						func(
							binding,
						): (
							optional_type_contains_meta(binding.annotation)
							or typed_expr_contains_meta(binding.value)
						),
					)
				)
			TypedConcurrentForExpr(_, iterable, params, body, _, _):
				(
					typed_expr_contains_meta(iterable)
					or params.any(func(param): typed_expr_contains_meta(param.value))
					or typed_expr_contains_meta(body)
				)
			TypedDetachExpr(body, _, _):
				typed_expr_contains_meta(body)
			TypedAscriptionExpr(inner, source_type, _, _):
				typed_expr_contains_meta(inner) or type_contains_meta(source_type)
			TypedBlockExpr(items, _, _):
				items.any(typed_expr_contains_meta)
			TypedWithExpr(binding, body, _, _):
				typed_with_binding_contains_meta(binding) or typed_expr_contains_meta(body)
			TypedDebugBlockExpr(body, _, _):
				typed_expr_contains_meta(body)
			TypedVarDeclExpr(payload, _):
				(
					optional_type_contains_meta(payload.annotation)
					or typed_expr_contains_meta(payload.initializer)
				)
			TypedQuestionBindExpr(_, annotation, value, _, _):
				optional_type_contains_meta(annotation) or typed_expr_contains_meta(value)
			TypedBreakExpr(_, _):
				False
			TypedContinueExpr(_, _):
				False
			TypedVoidExpr(_, _):
				False
			TypedBuiltinExpr(_, _, _):
				False
			TypedMissingExpr(_, _):
				False
			TypedUnsupportedExpr(_, _, _):
				False


private pure func zonk_optional_type(
	context: Context,
	typ: Option[SemanticType],
) -> Option[SemanticType]:
	match typ:
		Some(value):
			Some(zonk_type(context, value))
		None:
			None


private pure func zonk_expr_type_origin(context: Context, origin: ExprTypeOrigin) -> ExprTypeOrigin:
	match origin:
		InferredOrigin:
			InferredOrigin
		ExplicitAnnotationOrigin(typ):
			ExplicitAnnotationOrigin(zonk_type(context, typ))
		SynthesizedOrigin(label):
			SynthesizedOrigin(label)


private pure func zonk_resolved_call_info(
	context: Context,
	info: ResolvedCallInfo,
) -> ResolvedCallInfo:
	dim_constraints: List[(SemanticType, SemanticType)] = info.dim_constraints.map(
		func(constraint): (zonk_type(context, constraint[0]), zonk_type(context, constraint[1])),
	)
	{
		callee_name = info.callee_name,
		source_name = info.source_name,
		purity = info.purity,
		target = info.target,
		instantiated_params = info.instantiated_params.map(func(typ): zonk_type(context, typ)),
		instantiated_return = zonk_type(context, info.instantiated_return),
		resource_args = info.resource_args,
		dim_constraints = dim_constraints,
		loop_producer = info.loop_producer
	}


private pure func zonk_optional_resolved_call_info(
	context: Context,
	info: Option[ResolvedCallInfo],
) -> Option[ResolvedCallInfo]:
	match info:
		Some(value):
			Some(zonk_resolved_call_info(context, value))
		None:
			empty: Option[ResolvedCallInfo] = None
			empty


private pure func zonk_value_slot(context: Context, slot: ValueSlot) -> ValueSlot:
	match slot:
		KeptValueSlot(typ):
			KeptValueSlot(zonk_type(context, typ))
		WidenedValueSlot(semantic_type, value_type, reason):
			WidenedValueSlot(
				zonk_type(context, semantic_type),
				zonk_type(context, value_type),
				reason,
			)


private pure func zonk_typed_expr_info(context: Context, info: TypedExprInfo) -> TypedExprInfo:
	value_slot = zonk_value_slot(context, info.value_slot)

	{
		source_type = zonk_optional_type(context, info.source_type),
		origin = zonk_expr_type_origin(context, info.origin),
		value_slot = value_slot,
		proofs = info.proofs,
		resolved_call = zonk_optional_resolved_call_info(context, info.resolved_call),
		resolved_definition_id = info.resolved_definition_id,
		resource_dependencies = info.resource_dependencies
	}


private pure func zonk_typed_var_decl_payload(
	context: Context,
	payload: TypedVarDeclPayload,
) -> TypedVarDeclPayload:
	{
		name = payload.name,
		annotation = zonk_optional_type(context, payload.annotation),
		initializer = zonk_typed_expr(context, payload.initializer),
		is_mutable = payload.is_mutable,
		span = payload.span
	}


private pure func zonk_typed_dict_entry(context: Context, entry: TypedDictEntry) -> TypedDictEntry:
	{
		key = zonk_typed_expr(context, entry.key),
		value = zonk_typed_expr(context, entry.value)
	}


private pure func zonk_typed_record_field(
	context: Context,
	field: TypedRecordField,
) -> TypedRecordField:
	{
		name = field.name,
		value = zonk_typed_expr(context, field.value),
		span = field.span,
		definition_id = field.definition_id
	}


private pure func zonk_typed_lambda_param(
	context: Context,
	param: TypedLambdaParam,
) -> TypedLambdaParam:
	{
		name = param.name,
		source_type = zonk_optional_type(context, param.source_type),
		param_type = zonk_type(context, param.param_type)
	}


private pure func zonk_typed_string_interpolation_part(
	context: Context,
	part: TypedStringInterpolationPart,
) -> TypedStringInterpolationPart:
	match part:
		TypedInterpolationLiteral(value):
			TypedInterpolationLiteral(value)
		TypedInterpolationExpr(expr):
			TypedInterpolationExpr(zonk_typed_expr(context, expr))


private pure func zonk_typed_pattern(context: Context, pattern: TypedPattern) -> TypedPattern:
	match pattern:
		TypedWildcardPattern(span):
			TypedWildcardPattern(span)
		TypedNamePattern(name, typ):
			TypedNamePattern(
				name,
				zonk_type(context, typ),
			)
		TypedBoolPattern(value, span):
			TypedBoolPattern(value, span)
		TypedIntPattern(value, span):
			TypedIntPattern(value, span)
		TypedFloatPattern(value, span):
			TypedFloatPattern(value, span)
		TypedStringPattern(value, span):
			TypedStringPattern(value, span)
		TypedCharPattern(value, span):
			TypedCharPattern(value, span)
		TypedConstructorPattern(name, fields, span, definition_id):
			TypedConstructorPattern(
				name,
				fields.map(func(field): zonk_typed_pattern(context, field)),
				span,
				definition_id,
			)
		TypedQualifiedConstructorPattern(module_name, name, fields, span, definition_id):
			TypedQualifiedConstructorPattern(
				module_name,
				name,
				fields.map(func(field): zonk_typed_pattern(context, field)),
				span,
				definition_id,
			)
		TypedTuplePattern(items, span):
			TypedTuplePattern(
				items.map(func(item): zonk_typed_pattern(context, item)),
				span,
			)
		TypedListPattern(items, spread, span):
			TypedListPattern(
				items.map(func(item): zonk_typed_pattern(context, item)),
				spread,
				span,
			)
		TypedOrPattern(items, span):
			TypedOrPattern(
				items.map(func(item): zonk_typed_pattern(context, item)),
				span,
			)
		TypedUnsupportedPattern(label, span):
			TypedUnsupportedPattern(label, span)


private pure func zonk_typed_match_case(context: Context, case: TypedMatchCase) -> TypedMatchCase:
	{
		pattern = zonk_typed_pattern(context, case.pattern),
		body = zonk_typed_expr(context, case.body),
		span = case.span
	}


private pure func zonk_typed_select_arm_kind(
	context: Context,
	kind: TypedSelectArmKind,
) -> TypedSelectArmKind:
	match kind:
		TypedSelectReceiveArm(name, channel_type, channel):
			TypedSelectReceiveArm(
				name,
				zonk_type(context, channel_type),
				zonk_typed_expr(context, channel),
			)
		TypedSelectSealedArm(channel_type, channel):
			TypedSelectSealedArm(
				zonk_type(context, channel_type),
				zonk_typed_expr(context, channel),
			)
		TypedSelectAfterArm(timeout):
			TypedSelectAfterArm(zonk_typed_expr(context, timeout))


private pure func zonk_typed_select_arm(context: Context, arm: TypedSelectArm) -> TypedSelectArm:
	{
		kind = zonk_typed_select_arm_kind(context, arm.kind),
		body = zonk_typed_expr(context, arm.body),
		span = arm.span
	}


private pure func zonk_typed_concurrent_param(
	context: Context,
	param: TypedConcurrentParam,
) -> TypedConcurrentParam:
	{
		name = param.name,
		value = zonk_typed_expr(context, param.value),
		span = param.span
	}


private pure func zonk_typed_concurrent_binding(
	context: Context,
	binding: TypedConcurrentBinding,
) -> TypedConcurrentBinding:
	{
		name = binding.name,
		annotation = zonk_optional_type(context, binding.annotation),
		value = zonk_typed_expr(context, binding.value),
		span = binding.span,
		info = zonk_typed_expr_info(context, binding.info)
	}


private pure func zonk_typed_with_error_map(
	context: Context,
	error_map: TypedWithErrorMap,
) -> TypedWithErrorMap:
	{
		name = error_map.name,
		value = zonk_typed_expr(context, error_map.value),
		span = error_map.span
	}


private pure func zonk_optional_typed_with_error_map(
	context: Context,
	error_map: Option[TypedWithErrorMap],
) -> Option[TypedWithErrorMap]:
	match error_map:
		Some(value):
			Some(zonk_typed_with_error_map(context, value))
		None:
			None


private pure func zonk_typed_with_binding(
	context: Context,
	binding: TypedWithBinding,
) -> TypedWithBinding:
	{
		name = binding.name,
		annotation = zonk_optional_type(context, binding.annotation),
		value = zonk_typed_expr(context, binding.value),
		kind = binding.kind,
		error_map = zonk_optional_typed_with_error_map(context, binding.error_map),
		cleanup_function = binding.cleanup_function,
		resource_loop_item_name = binding.resource_loop_item_name,
		span = binding.span
	}


private pure func zonk_typed_loop_view(context: Context, view: TypedLoopView) -> TypedLoopView:
	match view:
		TypedIndicesLoopView(element_type):
			TypedIndicesLoopView(zonk_type(context, element_type))
		TypedEnumerateLoopView(element_type):
			TypedEnumerateLoopView(zonk_type(context, element_type))
		TypedEnumerate2LoopView(element_type):
			TypedEnumerate2LoopView(zonk_type(context, element_type))
		TypedWindowsLoopView(size, element_type):
			TypedWindowsLoopView(
				size,
				zonk_type(context, element_type),
			)


pure func zonk_typed_expr(context: Context, expr: TypedExpr) -> TypedExpr:
	info = zonk_typed_expr_info(context, typed_expr_info(expr))

	match expr:
		TypedNameExpr(name, _):
			TypedNameExpr(name, info)
		TypedIntLiteralExpr(text, span, _):
			TypedIntLiteralExpr(text, span, info)
		TypedFloatLiteralExpr(text, span, _):
			TypedFloatLiteralExpr(text, span, info)
		TypedStringLiteralExpr(text, span, _):
			TypedStringLiteralExpr(text, span, info)
		TypedStringInterpolationExpr(text, raw, span, _):
			TypedStringInterpolationExpr(text, raw, span, info)
		TypedStringInterpolationPartsExpr(parts, multiline, span, _):
			TypedStringInterpolationPartsExpr(
				parts.map(func(part): zonk_typed_string_interpolation_part(context, part)),
				multiline,
				span,
				info,
			)
		TypedBoolLiteralExpr(value, span, _):
			TypedBoolLiteralExpr(value, span, info)
		TypedCharLiteralExpr(value, span, _):
			TypedCharLiteralExpr(value, span, info)
		TypedUnaryExpr(op, inner, span, _):
			TypedUnaryExpr(
				op,
				zonk_typed_expr(context, inner),
				span,
				info,
			)
		TypedBinaryExpr(op, left, right, span, _):
			TypedBinaryExpr(
				op,
				zonk_typed_expr(context, left),
				zonk_typed_expr(context, right),
				span,
				info,
			)
		TypedLogicalExpr(op, left, right, span, _):
			TypedLogicalExpr(
				op,
				zonk_typed_expr(context, left),
				zonk_typed_expr(context, right),
				span,
				info,
			)
		TypedCallExpr(callee, args, span, _):
			TypedCallExpr(
				zonk_typed_expr(context, callee),
				args.map(func(arg): zonk_typed_expr(context, arg)),
				span,
				info,
			)
		TypedTupleExpr(items, span, _):
			TypedTupleExpr(
				items.map(func(item): zonk_typed_expr(context, item)),
				span,
				info,
			)
		TypedTupleDestructExpr(names, value, span, _):
			TypedTupleDestructExpr(
				names,
				zonk_typed_expr(context, value),
				span,
				info,
			)
		TypedAssignExpr(name, scope, value, span, _):
			TypedAssignExpr(
				name,
				scope,
				zonk_typed_expr(context, value),
				span,
				info,
			)
		TypedSubscriptExpr(receiver, indices, span, _):
			TypedSubscriptExpr(
				zonk_typed_expr(context, receiver),
				indices.map(func(index): zonk_typed_expr(context, index)),
				span,
				info,
			)
		TypedSubscriptAssignExpr(assign_target, receiver, indices, value, span, _):
			TypedSubscriptAssignExpr(
				assign_target,
				zonk_typed_expr(context, receiver),
				indices.map(func(index): zonk_typed_expr(context, index)),
				zonk_typed_expr(context, value),
				span,
				info,
			)
		TypedListExpr(items, span, _):
			TypedListExpr(
				items.map(func(item): zonk_typed_expr(context, item)),
				span,
				info,
			)
		TypedVectorExpr(items, span, _):
			TypedVectorExpr(
				items.map(func(item): zonk_typed_expr(context, item)),
				span,
				info,
			)
		TypedDictExpr(entries, span, _):
			TypedDictExpr(
				entries.map(func(entry): zonk_typed_dict_entry(context, entry)),
				span,
				info,
			)
		TypedOpaqueIntoExpr(source_type, inner, span, _):
			TypedOpaqueIntoExpr(
				zonk_type(context, source_type),
				zonk_typed_expr(context, inner),
				span,
				info,
			)
		TypedOpaqueFromExpr(source_type, inner, span, _):
			TypedOpaqueFromExpr(
				zonk_type(context, source_type),
				zonk_typed_expr(context, inner),
				span,
				info,
			)
		TypedRecordExpr(fields, span, _):
			TypedRecordExpr(
				fields.map(func(field): zonk_typed_record_field(context, field)),
				span,
				info,
			)
		TypedRecordUpdateExpr(receiver, fields, record_fields, span, _):
			TypedRecordUpdateExpr(
				zonk_typed_expr(context, receiver),
				fields.map(func(field): zonk_typed_record_field(context, field)),
				record_fields.map(
					func(field): { field | field_type = zonk_type(context, field.field_type) },
				),
				span,
				info,
			)
		TypedFieldAccessExpr(receiver, field, span, _):
			TypedFieldAccessExpr(
				zonk_typed_expr(context, receiver),
				field,
				span,
				info,
			)
		TypedLambdaExpr(is_pure, params, return_annotation, body, span, _):
			TypedLambdaExpr(
				is_pure,
				params.map(func(param): zonk_typed_lambda_param(context, param)),
				zonk_optional_type(context, return_annotation),
				zonk_typed_expr(context, body),
				span,
				info,
			)
		TypedRangeExpr(start_expr, end_expr, span, _):
			TypedRangeExpr(
				zonk_typed_expr(context, start_expr),
				zonk_typed_expr(context, end_expr),
				span,
				info,
			)
		TypedIfExpr(condition, then_branch, else_branch, span, _):
			TypedIfExpr(
				zonk_typed_expr(context, condition),
				zonk_typed_expr(context, then_branch),
				else_branch.map(func(branch): zonk_typed_expr(context, branch)),
				span,
				info,
			)
		TypedMatchExpr(scrutinee, cases, span, _):
			TypedMatchExpr(
				zonk_typed_expr(context, scrutinee),
				cases.map(func(case): zonk_typed_match_case(context, case)),
				span,
				info,
			)
		TypedSelectExpr(arms, span, _):
			TypedSelectExpr(
				arms.map(func(arm): zonk_typed_select_arm(context, arm)),
				span,
				info,
			)
		TypedWhileExpr(condition, body, span, _):
			TypedWhileExpr(
				zonk_typed_expr(context, condition),
				zonk_typed_expr(context, body),
				span,
				info,
			)
		TypedForExpr(binder, iterable, loop_view, body, span, _):
			TypedForExpr(
				binder,
				zonk_typed_expr(context, iterable),
				loop_view.map(func(view): zonk_typed_loop_view(context, view)),
				zonk_typed_expr(context, body),
				span,
				info,
			)
		TypedConcurrentBlockExpr(params, bindings, span, _):
			TypedConcurrentBlockExpr(
				params.map(
					func(param): zonk_typed_concurrent_param(context, param),
				),
				bindings.map(func(binding):
					zonk_typed_concurrent_binding(context, binding)
				),
				span,
				info,
			)
		TypedConcurrentForExpr(name, iterable, params, body, span, _):
			TypedConcurrentForExpr(
				name,
				zonk_typed_expr(context, iterable),
				params.map(func(param): zonk_typed_concurrent_param(context, param)),
				zonk_typed_expr(context, body),
				span,
				info,
			)
		TypedDetachExpr(body, span, _):
			TypedDetachExpr(
				zonk_typed_expr(context, body),
				span,
				info,
			)
		TypedAscriptionExpr(inner, source_type, span, _):
			TypedAscriptionExpr(
				zonk_typed_expr(context, inner),
				zonk_type(context, source_type),
				span,
				info,
			)
		TypedBlockExpr(items, span, _):
			TypedBlockExpr(
				items.map(func(item): zonk_typed_expr(context, item)),
				span,
				info,
			)
		TypedWithExpr(binding, body, span, _):
			TypedWithExpr(
				zonk_typed_with_binding(context, binding),
				zonk_typed_expr(context, body),
				span,
				info,
			)
		TypedDebugBlockExpr(body, span, _):
			TypedDebugBlockExpr(
				zonk_typed_expr(context, body),
				span,
				info,
			)
		TypedVarDeclExpr(payload, _):
			TypedVarDeclExpr(
				zonk_typed_var_decl_payload(context, payload),
				info,
			)
		TypedQuestionBindExpr(name, annotation, value, span, _):
			TypedQuestionBindExpr(
				name,
				zonk_optional_type(context, annotation),
				zonk_typed_expr(context, value),
				span,
				info,
			)
		TypedBreakExpr(span, _):
			TypedBreakExpr(span, info)
		TypedContinueExpr(span, _):
			TypedContinueExpr(span, info)
		TypedVoidExpr(span, _):
			TypedVoidExpr(span, info)
		TypedBuiltinExpr(name, span, _):
			TypedBuiltinExpr(name, span, info)
		TypedMissingExpr(span, _):
			TypedMissingExpr(span, info)
		TypedUnsupportedExpr(label, span, _):
			TypedUnsupportedExpr(label, span, info)


pure func finalize_infer_result(result: InferResult) -> InferResult:
	{
		context = result.context,
		expr = zonk_typed_expr(result.context.state.context, result.expr)
	}


private pure func append_resource_refs(refs: List[String], extra: List[String]) -> List[String]:
	var result = refs

	for name in extra:
		if not result.contains(name):
			result = result.append(name)

	result


private pure func resource_result_breaks_dependency(policy: ResourceResultPolicy) -> Bool:
	match policy:
		ResourceResultOrdinary:
			True
		ResourceResultIndependent:
			True
		ResourceResultDependent:
			False


private pure func call_result_breaks_resource_dependency(info: TypedExprInfo) -> Bool:
	match info.resolved_call:
		Some(call):
			match call.resource_args:
				AllowResourceArgs(policy):
					resource_result_breaks_dependency(policy)
				RejectResourceArgs:
					False
		None:
			False


private pure func typed_expr_list_resource_dependency_refs(
	context: InferContext,
	items: List[TypedExpr],
) -> List[String]:
	var result: List[String] = []

	for item in items:
		result = append_resource_refs(
			result,
			typed_expr_resource_dependency_refs(context, item),
		)

	result


private pure func typed_dict_entries_resource_dependency_refs(
	context: InferContext,
	entries: List[TypedDictEntry],
) -> List[String]:
	var result: List[String] = []

	for entry in entries:
		result = append_resource_refs(
			result,
			typed_expr_resource_dependency_refs(context, entry.key),
		)
		result = append_resource_refs(
			result,
			typed_expr_resource_dependency_refs(context, entry.value),
		)

	result


private pure func typed_record_fields_resource_dependency_refs(
	context: InferContext,
	fields: List[TypedRecordField],
) -> List[String]:
	var result: List[String] = []

	for field in fields:
		result = append_resource_refs(
			result,
			typed_expr_resource_dependency_refs(context, field.value),
		)

	result


private pure func typed_match_cases_resource_dependency_refs(
	context: InferContext,
	cases: List[TypedMatchCase],
) -> List[String]:
	var result: List[String] = []

	for case in cases:
		result = append_resource_refs(
			result,
			typed_expr_resource_dependency_refs(context, case.body),
		)

	result


private pure func typed_interpolation_parts_resource_dependency_refs(
	context: InferContext,
	parts: List[TypedStringInterpolationPart],
) -> List[String]:
	var result: List[String] = []

	for part in parts:
		match part:
			TypedInterpolationExpr(expr):
				result = append_resource_refs(
					result,
					typed_expr_resource_dependency_refs(context, expr),
				)
			TypedInterpolationLiteral(_):
				void

	result


private pure func typed_concurrent_bindings_resource_dependency_refs(
	context: InferContext,
	bindings: List[TypedConcurrentBinding],
) -> List[String]:
	var result: List[String] = []

	for binding in bindings:
		result = append_resource_refs(
			result,
			typed_expr_resource_dependency_refs(context, binding.value),
		)

	result


private pure func typed_expr_resource_dependency_refs(
	context: InferContext,
	expr: TypedExpr,
) -> List[String]:
	match expr:
		TypedNameExpr(name, info):
			if info.resource_dependencies.length() > 0:
				info.resource_dependencies
			else if env_is_scoped_resource_related_var(context.state.env, name.text):
				[name.text]
			else:
				[]
		TypedUnaryExpr(_, inner, _, _):
			typed_expr_resource_dependency_refs(context, inner)
		TypedBinaryExpr(_, left, right, _, _):
			append_resource_refs(
				typed_expr_resource_dependency_refs(context, left),
				typed_expr_resource_dependency_refs(context, right),
			)
		TypedLogicalExpr(_, left, right, _, _):
			append_resource_refs(
				typed_expr_resource_dependency_refs(context, left),
				typed_expr_resource_dependency_refs(context, right),
			)
		TypedCallExpr(callee, args, _, info):
			if call_result_breaks_resource_dependency(info):
				[]
			else:
				append_resource_refs(
					typed_expr_resource_dependency_refs(context, callee),
					typed_expr_list_resource_dependency_refs(context, args),
				)
		TypedTupleExpr(items, _, _):
			typed_expr_list_resource_dependency_refs(context, items)
		TypedSubscriptExpr(receiver, indices, _, _):
			append_resource_refs(
				typed_expr_resource_dependency_refs(context, receiver),
				typed_expr_list_resource_dependency_refs(context, indices),
			)
		TypedListExpr(items, _, _):
			typed_expr_list_resource_dependency_refs(context, items)
		TypedVectorExpr(items, _, _):
			typed_expr_list_resource_dependency_refs(context, items)
		TypedDictExpr(entries, _, _):
			typed_dict_entries_resource_dependency_refs(context, entries)
		TypedOpaqueIntoExpr(_, inner, _, _):
			typed_expr_resource_dependency_refs(context, inner)
		TypedOpaqueFromExpr(_, inner, _, _):
			typed_expr_resource_dependency_refs(context, inner)
		TypedRecordExpr(fields, _, _):
			typed_record_fields_resource_dependency_refs(context, fields)
		TypedRecordUpdateExpr(base, fields, _, _, _):
			append_resource_refs(
				typed_expr_resource_dependency_refs(context, base),
				typed_record_fields_resource_dependency_refs(context, fields),
			)
		TypedFieldAccessExpr(receiver, _, _, _):
			typed_expr_resource_dependency_refs(context, receiver)
		TypedRangeExpr(start_expr, end_expr, _, _):
			append_resource_refs(
				typed_expr_resource_dependency_refs(context, start_expr),
				typed_expr_resource_dependency_refs(context, end_expr),
			)
		TypedIfExpr(condition, then_branch, else_branch, _, _):
			with_then = append_resource_refs(
				typed_expr_resource_dependency_refs(context, condition),
				typed_expr_resource_dependency_refs(context, then_branch),
			)

			match else_branch:
				Some(branch):
					append_resource_refs(
						with_then,
						typed_expr_resource_dependency_refs(context, branch),
					)
				None:
					with_then
		TypedMatchExpr(scrutinee, cases, _, _):
			append_resource_refs(
				typed_expr_resource_dependency_refs(context, scrutinee),
				typed_match_cases_resource_dependency_refs(context, cases),
			)
		TypedAscriptionExpr(inner, _, _, _):
			typed_expr_resource_dependency_refs(context, inner)
		TypedBlockExpr(items, _, _):
			result_expr: Option[TypedExpr] = if items.length() == 0:
				None
			else:
				items.get(items.length() - 1)

			match result_expr:
				Some(result_expr):
					typed_expr_resource_dependency_refs(context, result_expr)
				None:
					[]
		TypedConcurrentBlockExpr(_, bindings, _, _):
			typed_concurrent_bindings_resource_dependency_refs(context, bindings)
		TypedWithExpr(_, body, _, _):
			typed_expr_resource_dependency_refs(context, body)
		TypedStringInterpolationPartsExpr(parts, _, _, _):
			typed_interpolation_parts_resource_dependency_refs(context, parts)
		_:
			[]


private pure func binding_origin_for_initializer(
	context: InferContext,
	initializer: TypedExpr,
) -> VarOrigin:
	if typed_expr_resource_dependency_refs(context, initializer).length() > 0:
		ScopedResourceDerived
	else:
		LetBinding


union PurityRequirement:
	PurityKnownCallRequirement(String, Int)
	PurityFunctionValueRequirement(String)
	PuritySyntaxRequirement(String)


private pure func append_impure_call_names(
	names: List[String],
	extra: List[String],
) -> List[String]:
	var result = names

	for name in extra:
		result = result.append(name)

	result


private pure func append_purity_requirements(
	requirements: List[PurityRequirement],
	extra: List[PurityRequirement],
) -> List[PurityRequirement]:
	var result = requirements

	for requirement in extra:
		result = result.append(requirement)

	result


private pure func typed_expr_list_purity_requirements(
	exprs: List[TypedExpr],
) -> List[PurityRequirement]:
	var result: List[PurityRequirement] = []

	for expr in exprs:
		result = append_purity_requirements(result, typed_expr_purity_requirements(expr))

	result


private pure func typed_dict_entries_purity_requirements(
	entries: List[TypedDictEntry],
) -> List[PurityRequirement]:
	var result: List[PurityRequirement] = []

	for entry in entries:
		result = append_purity_requirements(result, typed_expr_purity_requirements(entry.key))
		result = append_purity_requirements(result, typed_expr_purity_requirements(entry.value))

	result


private pure func typed_record_fields_purity_requirements(
	fields: List[TypedRecordField],
) -> List[PurityRequirement]:
	var result: List[PurityRequirement] = []

	for field in fields:
		result = append_purity_requirements(result, typed_expr_purity_requirements(field.value))

	result


private pure func typed_concurrent_params_purity_requirements(
	params: List[TypedConcurrentParam],
) -> List[PurityRequirement]:
	var result: List[PurityRequirement] = []

	for param in params:
		result = append_purity_requirements(result, typed_expr_purity_requirements(param.value))

	result


private pure func typed_concurrent_bindings_purity_requirements(
	bindings: List[TypedConcurrentBinding],
) -> List[PurityRequirement]:
	var result: List[PurityRequirement] = []

	for binding in bindings:
		result = append_purity_requirements(result, typed_expr_purity_requirements(binding.value))

	result


private pure func typed_with_binding_purity_requirements(
	binding: TypedWithBinding,
) -> List[PurityRequirement]:
	result = typed_expr_purity_requirements(binding.value)

	match binding.error_map:
		Some(mapper):
			append_purity_requirements(result, typed_expr_purity_requirements(mapper.value))
		None:
			result


private pure func typed_interpolation_parts_purity_requirements(
	parts: List[TypedStringInterpolationPart],
) -> List[PurityRequirement]:
	var result: List[PurityRequirement] = []

	for part in parts:
		match part:
			TypedInterpolationLiteral(_):
				void
			TypedInterpolationExpr(expr):
				result = append_purity_requirements(result, typed_expr_purity_requirements(expr))

	result


private pure func typed_match_cases_purity_requirements(
	cases: List[TypedMatchCase],
) -> List[PurityRequirement]:
	var result: List[PurityRequirement] = []

	for case in cases:
		result = append_purity_requirements(result, typed_expr_purity_requirements(case.body))

	result


private pure func typed_select_arm_kind_purity_requirements(
	kind: TypedSelectArmKind,
) -> List[PurityRequirement]:
	match kind:
		TypedSelectReceiveArm(_, _, channel):
			typed_expr_purity_requirements(channel)
		TypedSelectSealedArm(_, channel):
			typed_expr_purity_requirements(channel)
		TypedSelectAfterArm(timeout):
			typed_expr_purity_requirements(timeout)


private pure func typed_select_arms_purity_requirements(
	arms: List[TypedSelectArm],
) -> List[PurityRequirement]:
	var result: List[PurityRequirement] = []

	for arm in arms:
		result = append_purity_requirements(
			result,
			typed_select_arm_kind_purity_requirements(arm.kind),
		)
		result = append_purity_requirements(result, typed_expr_purity_requirements(arm.body))

	result


private pure func call_expr_purity_requirements(
	callee: TypedExpr,
	info: TypedExprInfo,
) -> List[PurityRequirement]:
	match info.resolved_call:
		Some(call):
			if purities_equal(call.purity, Impure):
				match resolved_call_callable_id(call):
					Some(id):
						[PurityKnownCallRequirement(call.callee_name, id)]
					None:
						[PurityFunctionValueRequirement(call.callee_name)]
			else:
				[]
		None:
			match typed_expr_semantic_type(callee):
				SemanticFunctionType(False, _, _):
					callee_name: String = match callee:
						TypedNameExpr(name, _):
							name.text
						_:
							"<impure function value>"

					[PurityFunctionValueRequirement(callee_name)]
				_:
					[]


pure func typed_expr_purity_requirements(expr: TypedExpr) -> List[PurityRequirement]:
	match expr:
		TypedUnaryExpr(_, inner, _, _):
			typed_expr_purity_requirements(inner)
		TypedBinaryExpr(_, left, right, _, _):
			append_purity_requirements(
				typed_expr_purity_requirements(left),
				typed_expr_purity_requirements(right),
			)
		TypedLogicalExpr(_, left, right, _, _):
			append_purity_requirements(
				typed_expr_purity_requirements(left),
				typed_expr_purity_requirements(right),
			)
		TypedCallExpr(callee, args, _, info):
			with_callee = append_purity_requirements(
				typed_expr_purity_requirements(callee),
				typed_expr_list_purity_requirements(args),
			)
			append_purity_requirements(
				with_callee,
				call_expr_purity_requirements(callee, info),
			)
		TypedTupleExpr(items, _, _):
			typed_expr_list_purity_requirements(items)
		TypedTupleDestructExpr(_, value, _, _):
			typed_expr_purity_requirements(value)
		TypedAssignExpr(_, _, value, _, _):
			typed_expr_purity_requirements(value)
		TypedSubscriptExpr(receiver, indices, _, _):
			append_purity_requirements(
				typed_expr_purity_requirements(receiver),
				typed_expr_list_purity_requirements(indices),
			)
		TypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
			with_indices = append_purity_requirements(
				typed_expr_purity_requirements(receiver),
				typed_expr_list_purity_requirements(indices),
			)
			append_purity_requirements(with_indices, typed_expr_purity_requirements(value))
		TypedListExpr(items, _, _):
			typed_expr_list_purity_requirements(items)
		TypedVectorExpr(items, _, _):
			typed_expr_list_purity_requirements(items)
		TypedDictExpr(entries, _, _):
			typed_dict_entries_purity_requirements(entries)
		TypedRecordExpr(fields, _, _):
			typed_record_fields_purity_requirements(fields)
		TypedRecordUpdateExpr(base, fields, _, _, _):
			append_purity_requirements(
				typed_expr_purity_requirements(base),
				typed_record_fields_purity_requirements(fields),
			)
		TypedFieldAccessExpr(receiver, _, _, _):
			typed_expr_purity_requirements(receiver)
		TypedLambdaExpr(is_pure, _, _, body, _, _):
			if is_pure:
				typed_expr_purity_requirements(body)
			else:
				[]
		TypedRangeExpr(start_expr, end_expr, _, _):
			append_purity_requirements(
				typed_expr_purity_requirements(start_expr),
				typed_expr_purity_requirements(end_expr),
			)
		TypedIfExpr(condition, then_branch, else_branch, _, _):
			with_then = append_purity_requirements(
				typed_expr_purity_requirements(condition),
				typed_expr_purity_requirements(then_branch),
			)

			match else_branch:
				Some(branch):
					append_purity_requirements(with_then, typed_expr_purity_requirements(branch))
				None:
					with_then
		TypedMatchExpr(scrutinee, cases, _, _):
			append_purity_requirements(
				typed_expr_purity_requirements(scrutinee),
				typed_match_cases_purity_requirements(cases),
			)
		TypedSelectExpr(arms, _, _):
			append_purity_requirements(
				[PuritySyntaxRequirement("select")],
				typed_select_arms_purity_requirements(arms),
			)
		TypedWhileExpr(condition, body, _, _):
			append_purity_requirements(
				typed_expr_purity_requirements(condition),
				typed_expr_purity_requirements(body),
			)
		TypedForExpr(_, iterable, _, body, _, _):
			with_iterable = append_purity_requirements(
				for_iterable_purity_requirements(iterable),
				typed_expr_purity_requirements(iterable),
			)
			append_purity_requirements(with_iterable, typed_expr_purity_requirements(body))
		TypedConcurrentBlockExpr(params, bindings, _, _):
			append_purity_requirements(
				[PuritySyntaxRequirement("concurrent")],
				append_purity_requirements(
					typed_concurrent_params_purity_requirements(params),
					typed_concurrent_bindings_purity_requirements(bindings),
				),
			)
		TypedConcurrentForExpr(_, iterable, params, body, _, _):
			with_iterable = append_purity_requirements(
				[PuritySyntaxRequirement("for ... concurrently")],
				typed_expr_purity_requirements(iterable),
			)
			with_params = append_purity_requirements(
				with_iterable,
				typed_concurrent_params_purity_requirements(params),
			)
			append_purity_requirements(with_params, typed_expr_purity_requirements(body))
		TypedDetachExpr(body, _, _):
			append_purity_requirements(
				[PuritySyntaxRequirement("detach")],
				typed_expr_purity_requirements(body),
			)
		TypedAscriptionExpr(inner, _, _, _):
			typed_expr_purity_requirements(inner)
		TypedOpaqueIntoExpr(_, inner, _, _):
			typed_expr_purity_requirements(inner)
		TypedOpaqueFromExpr(_, inner, _, _):
			typed_expr_purity_requirements(inner)
		TypedBlockExpr(items, _, _):
			typed_expr_list_purity_requirements(items)
		TypedWithExpr(binding, body, _, _):
			append_purity_requirements(
				typed_with_binding_purity_requirements(binding),
				typed_expr_purity_requirements(body),
			)
		TypedDebugBlockExpr(body, _, _):
			typed_expr_purity_requirements(body)
		TypedVarDeclExpr(payload, _):
			typed_expr_purity_requirements(payload.initializer)
		TypedQuestionBindExpr(_, _, value, _, _):
			typed_expr_purity_requirements(value)
		TypedStringInterpolationPartsExpr(parts, _, _, _):
			typed_interpolation_parts_purity_requirements(parts)
		_:
			[]


pure func typed_expr_impure_call_names(expr: TypedExpr) -> List[String]:
	typed_expr_purity_requirements(expr).map(func(requirement):
		match requirement:
			PurityKnownCallRequirement(name, _):
				name
			PurityFunctionValueRequirement(name):
				name
			PuritySyntaxRequirement(name):
				name
	)


private pure func append_module_assign_names(
	names: List[String],
	extra: List[String],
) -> List[String]:
	var result = names

	for name in extra:
		result = result.append(name)

	result


private pure func typed_expr_list_module_assign_names(exprs: List[TypedExpr]) -> List[String]:
	var result: List[String] = []

	for expr in exprs:
		result = append_module_assign_names(result, typed_expr_module_assign_names(expr))

	result


private pure func typed_dict_entries_module_assign_names(
	entries: List[TypedDictEntry],
) -> List[String]:
	var result: List[String] = []

	for entry in entries:
		result = append_module_assign_names(result, typed_expr_module_assign_names(entry.key))
		result = append_module_assign_names(result, typed_expr_module_assign_names(entry.value))

	result


private pure func typed_record_fields_module_assign_names(
	fields: List[TypedRecordField],
) -> List[String]:
	var result: List[String] = []

	for field in fields:
		result = append_module_assign_names(result, typed_expr_module_assign_names(field.value))

	result


private pure func typed_concurrent_params_module_assign_names(
	params: List[TypedConcurrentParam],
) -> List[String]:
	var result: List[String] = []

	for param in params:
		result = append_module_assign_names(result, typed_expr_module_assign_names(param.value))

	result


private pure func typed_concurrent_bindings_module_assign_names(
	bindings: List[TypedConcurrentBinding],
) -> List[String]:
	var result: List[String] = []

	for binding in bindings:
		result = append_module_assign_names(result, typed_expr_module_assign_names(binding.value))

	result


private pure func typed_with_binding_module_assign_names(binding: TypedWithBinding) -> List[String]:
	result = typed_expr_module_assign_names(binding.value)

	match binding.error_map:
		Some(mapper):
			append_module_assign_names(result, typed_expr_module_assign_names(mapper.value))
		None:
			result


private pure func typed_interpolation_parts_module_assign_names(
	parts: List[TypedStringInterpolationPart],
) -> List[String]:
	var result: List[String] = []

	for part in parts:
		match part:
			TypedInterpolationLiteral(_):
				void
			TypedInterpolationExpr(expr):
				result = append_module_assign_names(result, typed_expr_module_assign_names(expr))

	result


private pure func typed_match_cases_module_assign_names(
	cases: List[TypedMatchCase],
) -> List[String]:
	var result: List[String] = []

	for case in cases:
		result = append_module_assign_names(result, typed_expr_module_assign_names(case.body))

	result


private pure func typed_select_arm_kind_module_assign_names(
	kind: TypedSelectArmKind,
) -> List[String]:
	match kind:
		TypedSelectReceiveArm(_, _, channel):
			typed_expr_module_assign_names(channel)
		TypedSelectSealedArm(_, channel):
			typed_expr_module_assign_names(channel)
		TypedSelectAfterArm(timeout):
			typed_expr_module_assign_names(timeout)


private pure func typed_select_arms_module_assign_names(arms: List[TypedSelectArm]) -> List[String]:
	var result: List[String] = []

	for arm in arms:
		result = append_module_assign_names(
			result,
			typed_select_arm_kind_module_assign_names(arm.kind),
		)
		result = append_module_assign_names(result, typed_expr_module_assign_names(arm.body))

	result


pure func typed_expr_module_assign_names(expr: TypedExpr) -> List[String]:
	match expr:
		TypedUnaryExpr(_, inner, _, _):
			typed_expr_module_assign_names(inner)
		TypedBinaryExpr(_, left, right, _, _):
			append_module_assign_names(
				typed_expr_module_assign_names(left),
				typed_expr_module_assign_names(right),
			)
		TypedLogicalExpr(_, left, right, _, _):
			append_module_assign_names(
				typed_expr_module_assign_names(left),
				typed_expr_module_assign_names(right),
			)
		TypedCallExpr(callee, args, _, _):
			append_module_assign_names(
				typed_expr_module_assign_names(callee),
				typed_expr_list_module_assign_names(args),
			)
		TypedTupleExpr(items, _, _):
			typed_expr_list_module_assign_names(items)
		TypedTupleDestructExpr(_, value, _, _):
			typed_expr_module_assign_names(value)
		TypedAssignExpr(name, scope, value, _, _):
			value_names = typed_expr_module_assign_names(value)

			match scope:
				ModuleAssignScope:
					append_module_assign_names(value_names, [name.text])
				LocalAssignScope:
					value_names
		TypedSubscriptExpr(receiver, indices, _, _):
			append_module_assign_names(
				typed_expr_module_assign_names(receiver),
				typed_expr_list_module_assign_names(indices),
			)
		TypedSubscriptAssignExpr(assign_target, receiver, indices, value, _, _):
			with_indices = append_module_assign_names(
				typed_expr_module_assign_names(receiver),
				typed_expr_list_module_assign_names(indices),
			)
			value_names = append_module_assign_names(
				with_indices,
				typed_expr_module_assign_names(value),
			)

			match assign_target:
				Some(target):
					match target.scope:
						ModuleAssignScope:
							append_module_assign_names(value_names, [target.name])
						LocalAssignScope:
							value_names
				None:
					value_names
		TypedListExpr(items, _, _):
			typed_expr_list_module_assign_names(items)
		TypedVectorExpr(items, _, _):
			typed_expr_list_module_assign_names(items)
		TypedDictExpr(entries, _, _):
			typed_dict_entries_module_assign_names(entries)
		TypedRecordExpr(fields, _, _):
			typed_record_fields_module_assign_names(fields)
		TypedRecordUpdateExpr(base, fields, _, _, _):
			append_module_assign_names(
				typed_expr_module_assign_names(base),
				typed_record_fields_module_assign_names(fields),
			)
		TypedFieldAccessExpr(receiver, _, _, _):
			typed_expr_module_assign_names(receiver)
		TypedLambdaExpr(is_pure, _, _, body, _, _):
			if is_pure:
				typed_expr_module_assign_names(body)
			else:
				[]
		TypedRangeExpr(start_expr, end_expr, _, _):
			append_module_assign_names(
				typed_expr_module_assign_names(start_expr),
				typed_expr_module_assign_names(end_expr),
			)
		TypedIfExpr(condition, then_branch, else_branch, _, _):
			with_then = append_module_assign_names(
				typed_expr_module_assign_names(condition),
				typed_expr_module_assign_names(then_branch),
			)

			match else_branch:
				Some(branch):
					append_module_assign_names(with_then, typed_expr_module_assign_names(branch))
				None:
					with_then
		TypedMatchExpr(scrutinee, cases, _, _):
			append_module_assign_names(
				typed_expr_module_assign_names(scrutinee),
				typed_match_cases_module_assign_names(cases),
			)
		TypedSelectExpr(arms, _, _):
			typed_select_arms_module_assign_names(arms)
		TypedWhileExpr(condition, body, _, _):
			append_module_assign_names(
				typed_expr_module_assign_names(condition),
				typed_expr_module_assign_names(body),
			)
		TypedForExpr(_, iterable, _, body, _, _):
			append_module_assign_names(
				typed_expr_module_assign_names(iterable),
				typed_expr_module_assign_names(body),
			)
		TypedConcurrentBlockExpr(params, bindings, _, _):
			append_module_assign_names(
				typed_concurrent_params_module_assign_names(params),
				typed_concurrent_bindings_module_assign_names(bindings),
			)
		TypedConcurrentForExpr(_, iterable, params, body, _, _):
			with_iterable = typed_expr_module_assign_names(iterable)
			with_params = append_module_assign_names(
				with_iterable,
				typed_concurrent_params_module_assign_names(params),
			)
			append_module_assign_names(with_params, typed_expr_module_assign_names(body))
		TypedDetachExpr(body, _, _):
			typed_expr_module_assign_names(body)
		TypedAscriptionExpr(inner, _, _, _):
			typed_expr_module_assign_names(inner)
		TypedOpaqueIntoExpr(_, inner, _, _):
			typed_expr_module_assign_names(inner)
		TypedOpaqueFromExpr(_, inner, _, _):
			typed_expr_module_assign_names(inner)
		TypedBlockExpr(items, _, _):
			typed_expr_list_module_assign_names(items)
		TypedWithExpr(binding, body, _, _):
			append_module_assign_names(
				typed_with_binding_module_assign_names(binding),
				typed_expr_module_assign_names(body),
			)
		TypedDebugBlockExpr(body, _, _):
			typed_expr_module_assign_names(body)
		TypedVarDeclExpr(payload, _):
			typed_expr_module_assign_names(payload.initializer)
		TypedQuestionBindExpr(_, _, value, _, _):
			typed_expr_module_assign_names(value)
		TypedStringInterpolationPartsExpr(parts, _, _, _):
			typed_interpolation_parts_module_assign_names(parts)
		_:
			[]


private pure func startup_call_name(callee: TypedExpr, info: TypedExprInfo) -> String:
	match info.resolved_call:
		Some(call):
			call.callee_name
		None:
			match callee:
				TypedNameExpr(name, _):
					name.text
				TypedFieldAccessExpr(_, field, _, _):
					field.text
				_:
					"<expression>"


record TypedStartupWorkScan {
	call_names: List[String],
	has_subscript: Bool
}


private pure func startup_work_scan_empty() -> TypedStartupWorkScan:
	{
		call_names = [],
		has_subscript = False
	}


private pure func startup_work_scan_call(name: String) -> TypedStartupWorkScan:
	{
		call_names = [name],
		has_subscript = False
	}


private pure func startup_work_scan_subscript() -> TypedStartupWorkScan:
	{
		call_names = [],
		has_subscript = True
	}


private pure func append_startup_work_scan(
	left: TypedStartupWorkScan,
	right: TypedStartupWorkScan,
) -> TypedStartupWorkScan:
	var call_names = left.call_names

	for name in right.call_names:
		call_names = call_names.append(name)

	{
		call_names = call_names,
		has_subscript = left.has_subscript or right.has_subscript
	}


private pure func typed_expr_list_startup_work_scan(exprs: List[TypedExpr]) -> TypedStartupWorkScan:
	var result = startup_work_scan_empty()

	for expr in exprs:
		result = append_startup_work_scan(result, typed_expr_startup_work_scan(expr))

	result


private pure func typed_dict_entries_startup_work_scan(
	entries: List[TypedDictEntry],
) -> TypedStartupWorkScan:
	var result = startup_work_scan_empty()

	for entry in entries:
		result = append_startup_work_scan(result, typed_expr_startup_work_scan(entry.key))
		result = append_startup_work_scan(result, typed_expr_startup_work_scan(entry.value))

	result


private pure func typed_record_fields_startup_work_scan(
	fields: List[TypedRecordField],
) -> TypedStartupWorkScan:
	var result = startup_work_scan_empty()

	for field in fields:
		result = append_startup_work_scan(result, typed_expr_startup_work_scan(field.value))

	result


private pure func typed_concurrent_params_startup_work_scan(
	params: List[TypedConcurrentParam],
) -> TypedStartupWorkScan:
	var result = startup_work_scan_empty()

	for param in params:
		result = append_startup_work_scan(result, typed_expr_startup_work_scan(param.value))

	result


private pure func typed_concurrent_bindings_startup_work_scan(
	bindings: List[TypedConcurrentBinding],
) -> TypedStartupWorkScan:
	var result = startup_work_scan_empty()

	for binding in bindings:
		result = append_startup_work_scan(result, typed_expr_startup_work_scan(binding.value))

	result


private pure func typed_with_binding_startup_work_scan(
	binding: TypedWithBinding,
) -> TypedStartupWorkScan:
	result = typed_expr_startup_work_scan(binding.value)

	match binding.error_map:
		Some(mapper):
			append_startup_work_scan(result, typed_expr_startup_work_scan(mapper.value))
		None:
			result


private pure func typed_interpolation_parts_startup_work_scan(
	parts: List[TypedStringInterpolationPart],
) -> TypedStartupWorkScan:
	var result = startup_work_scan_empty()

	for part in parts:
		match part:
			TypedInterpolationLiteral(_):
				void
			TypedInterpolationExpr(expr):
				result = append_startup_work_scan(result, typed_expr_startup_work_scan(expr))

	result


private pure func typed_match_cases_startup_work_scan(
	cases: List[TypedMatchCase],
) -> TypedStartupWorkScan:
	var result = startup_work_scan_empty()

	for case in cases:
		result = append_startup_work_scan(result, typed_expr_startup_work_scan(case.body))

	result


private pure func typed_select_arm_kind_startup_work_scan(
	kind: TypedSelectArmKind,
) -> TypedStartupWorkScan:
	match kind:
		TypedSelectReceiveArm(_, _, channel):
			typed_expr_startup_work_scan(channel)
		TypedSelectSealedArm(_, channel):
			typed_expr_startup_work_scan(channel)
		TypedSelectAfterArm(timeout):
			typed_expr_startup_work_scan(timeout)


private pure func typed_select_arms_startup_work_scan(
	arms: List[TypedSelectArm],
) -> TypedStartupWorkScan:
	var result = startup_work_scan_empty()

	for arm in arms:
		result = append_startup_work_scan(result, typed_select_arm_kind_startup_work_scan(arm.kind))
		result = append_startup_work_scan(result, typed_expr_startup_work_scan(arm.body))

	result


pure func typed_expr_startup_work_scan(expr: TypedExpr) -> TypedStartupWorkScan:
	match expr:
		TypedUnaryExpr(_, inner, _, _):
			typed_expr_startup_work_scan(inner)
		TypedBinaryExpr(_, left, right, _, _):
			append_startup_work_scan(
				typed_expr_startup_work_scan(left),
				typed_expr_startup_work_scan(right),
			)
		TypedLogicalExpr(_, left, right, _, _):
			append_startup_work_scan(
				typed_expr_startup_work_scan(left),
				typed_expr_startup_work_scan(right),
			)
		TypedCallExpr(callee, args, _, info):
			with_callee = append_startup_work_scan(
				startup_work_scan_call(startup_call_name(callee, info)),
				typed_expr_startup_work_scan(callee),
			)
			append_startup_work_scan(with_callee, typed_expr_list_startup_work_scan(args))
		TypedTupleExpr(items, _, _):
			typed_expr_list_startup_work_scan(items)
		TypedTupleDestructExpr(_, value, _, _):
			typed_expr_startup_work_scan(value)
		TypedAssignExpr(_, _, value, _, _):
			typed_expr_startup_work_scan(value)
		TypedSubscriptExpr(receiver, indices, _, _):
			append_startup_work_scan(
				append_startup_work_scan(
					typed_expr_startup_work_scan(receiver),
					typed_expr_list_startup_work_scan(indices),
				),
				startup_work_scan_subscript(),
			)
		TypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
			with_indices = append_startup_work_scan(
				typed_expr_startup_work_scan(receiver),
				typed_expr_list_startup_work_scan(indices),
			)
			append_startup_work_scan(
				append_startup_work_scan(with_indices, typed_expr_startup_work_scan(value)),
				startup_work_scan_subscript(),
			)
		TypedListExpr(items, _, _):
			typed_expr_list_startup_work_scan(items)
		TypedVectorExpr(items, _, _):
			typed_expr_list_startup_work_scan(items)
		TypedDictExpr(entries, _, _):
			typed_dict_entries_startup_work_scan(entries)
		TypedRecordExpr(fields, _, _):
			typed_record_fields_startup_work_scan(fields)
		TypedRecordUpdateExpr(base, fields, _, _, _):
			append_startup_work_scan(
				typed_expr_startup_work_scan(base),
				typed_record_fields_startup_work_scan(fields),
			)
		TypedFieldAccessExpr(receiver, _, _, _):
			typed_expr_startup_work_scan(receiver)
		TypedLambdaExpr(_, _, _, _, _, _):
			startup_work_scan_empty()
		TypedRangeExpr(start_expr, end_expr, _, _):
			append_startup_work_scan(
				typed_expr_startup_work_scan(start_expr),
				typed_expr_startup_work_scan(end_expr),
			)
		TypedIfExpr(condition, then_branch, else_branch, _, _):
			with_then = append_startup_work_scan(
				typed_expr_startup_work_scan(condition),
				typed_expr_startup_work_scan(then_branch),
			)

			match else_branch:
				Some(branch):
					append_startup_work_scan(with_then, typed_expr_startup_work_scan(branch))
				None:
					with_then
		TypedMatchExpr(scrutinee, cases, _, _):
			append_startup_work_scan(
				typed_expr_startup_work_scan(scrutinee),
				typed_match_cases_startup_work_scan(cases),
			)
		TypedSelectExpr(arms, _, _):
			typed_select_arms_startup_work_scan(arms)
		TypedWhileExpr(condition, body, _, _):
			append_startup_work_scan(
				typed_expr_startup_work_scan(condition),
				typed_expr_startup_work_scan(body),
			)
		TypedForExpr(_, iterable, _, body, _, _):
			append_startup_work_scan(
				typed_expr_startup_work_scan(iterable),
				typed_expr_startup_work_scan(body),
			)
		TypedConcurrentBlockExpr(params, bindings, _, _):
			append_startup_work_scan(
				typed_concurrent_params_startup_work_scan(params),
				typed_concurrent_bindings_startup_work_scan(bindings),
			)
		TypedConcurrentForExpr(_, iterable, params, body, _, _):
			with_iterable = typed_expr_startup_work_scan(iterable)
			with_params = append_startup_work_scan(
				with_iterable,
				typed_concurrent_params_startup_work_scan(params),
			)
			append_startup_work_scan(with_params, typed_expr_startup_work_scan(body))
		TypedDetachExpr(body, _, _):
			typed_expr_startup_work_scan(body)
		TypedAscriptionExpr(inner, _, _, _):
			typed_expr_startup_work_scan(inner)
		TypedOpaqueIntoExpr(_, inner, _, _):
			typed_expr_startup_work_scan(inner)
		TypedOpaqueFromExpr(_, inner, _, _):
			typed_expr_startup_work_scan(inner)
		TypedBlockExpr(items, _, _):
			typed_expr_list_startup_work_scan(items)
		TypedWithExpr(binding, body, _, _):
			append_startup_work_scan(
				typed_with_binding_startup_work_scan(binding),
				typed_expr_startup_work_scan(body),
			)
		TypedDebugBlockExpr(body, _, _):
			typed_expr_startup_work_scan(body)
		TypedVarDeclExpr(payload, _):
			typed_expr_startup_work_scan(payload.initializer)
		TypedQuestionBindExpr(_, _, value, _, _):
			typed_expr_startup_work_scan(value)
		TypedStringInterpolationPartsExpr(parts, _, _, _):
			typed_interpolation_parts_startup_work_scan(parts)
		_:
			startup_work_scan_empty()


private pure func typed_expr_list_has_non_tail_recursive_call(
	exprs: List[TypedExpr],
	function_name: String,
) -> Bool:
	var found: Bool = False

	for expr in exprs:
		if typed_expr_has_non_tail_recursive_call_inner(expr, function_name, False):
			found = True
			break

	found


private pure func typed_dict_entries_have_non_tail_recursive_call(
	entries: List[TypedDictEntry],
	function_name: String,
) -> Bool:
	var found: Bool = False

	for entry in entries:
		if (
			typed_expr_has_non_tail_recursive_call_inner(entry.key, function_name, False)
			or typed_expr_has_non_tail_recursive_call_inner(entry.value, function_name, False)
		):
			found = True
			break

	found


private pure func typed_record_fields_have_non_tail_recursive_call(
	fields: List[TypedRecordField],
	function_name: String,
) -> Bool:
	var found: Bool = False

	for field in fields:
		if typed_expr_has_non_tail_recursive_call_inner(field.value, function_name, False):
			found = True
			break

	found


private pure func typed_concurrent_params_have_non_tail_recursive_call(
	params: List[TypedConcurrentParam],
	function_name: String,
) -> Bool:
	var found: Bool = False

	for param in params:
		if typed_expr_has_non_tail_recursive_call_inner(param.value, function_name, False):
			found = True
			break

	found


private pure func typed_concurrent_bindings_have_non_tail_recursive_call(
	bindings: List[TypedConcurrentBinding],
	function_name: String,
) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if typed_expr_has_non_tail_recursive_call_inner(binding.value, function_name, False):
			found = True
			break

	found


private pure func typed_with_binding_has_non_tail_recursive_call(
	binding: TypedWithBinding,
	function_name: String,
) -> Bool:
	if typed_expr_has_non_tail_recursive_call_inner(binding.value, function_name, False):
		True
	else:
		match binding.error_map:
			Some(mapper):
				typed_expr_has_non_tail_recursive_call_inner(mapper.value, function_name, False)
			None:
				False


private pure func typed_interpolation_parts_have_non_tail_recursive_call(
	parts: List[TypedStringInterpolationPart],
	function_name: String,
) -> Bool:
	var found: Bool = False

	for part in parts:
		match part:
			TypedInterpolationLiteral(_):
				void
			TypedInterpolationExpr(expr):
				if typed_expr_has_non_tail_recursive_call_inner(expr, function_name, False):
					found = True
					break

	found


private pure func typed_match_cases_have_non_tail_recursive_call(
	cases: List[TypedMatchCase],
	function_name: String,
	in_tail: Bool,
) -> Bool:
	var found: Bool = False

	for case in cases:
		if typed_expr_has_non_tail_recursive_call_inner(case.body, function_name, in_tail):
			found = True
			break

	found


private pure func typed_select_arm_kind_has_non_tail_recursive_call(
	kind: TypedSelectArmKind,
	function_name: String,
) -> Bool:
	match kind:
		TypedSelectReceiveArm(_, _, channel):
			typed_expr_has_non_tail_recursive_call_inner(channel, function_name, False)
		TypedSelectSealedArm(_, channel):
			typed_expr_has_non_tail_recursive_call_inner(channel, function_name, False)
		TypedSelectAfterArm(timeout):
			typed_expr_has_non_tail_recursive_call_inner(timeout, function_name, False)


private pure func typed_select_arms_have_non_tail_recursive_call(
	arms: List[TypedSelectArm],
	function_name: String,
) -> Bool:
	var found: Bool = False

	for arm in arms:
		if (
			typed_select_arm_kind_has_non_tail_recursive_call(arm.kind, function_name)
			or typed_expr_has_non_tail_recursive_call_inner(arm.body, function_name, False)
		):
			found = True
			break

	found


private pure func typed_block_has_non_tail_recursive_call(
	items: List[TypedExpr],
	function_name: String,
	in_tail: Bool,
) -> Bool:
	var found: Bool = False
	var index: Int = 0

	while index < items.length() and not found:
		match items.get(index):
			Some(item):
				item_tail: Bool = in_tail and index == items.length() - 1

				if typed_expr_has_non_tail_recursive_call_inner(item, function_name, item_tail):
					found = True
			None:
				void

		index += 1

	found


private pure func typed_call_has_non_tail_recursive_call(
	callee: TypedExpr,
	args: List[TypedExpr],
	info: TypedExprInfo,
	function_name: String,
	in_tail: Bool,
) -> Bool:
	is_recursive: Bool = match info.resolved_call:
		Some(call):
			call.callee_name == function_name
		None:
			False

	if is_recursive and not in_tail:
		True
	else:
		args_have_call = typed_expr_list_has_non_tail_recursive_call(args, function_name)

		if args_have_call:
			True
		else if is_recursive:
			False
		else:
			typed_expr_has_non_tail_recursive_call_inner(callee, function_name, False)


private pure func typed_expr_has_non_tail_recursive_call_inner(
	expr: TypedExpr,
	function_name: String,
	in_tail: Bool,
) -> Bool:
	match expr:
		TypedUnaryExpr(_, inner, _, _):
			typed_expr_has_non_tail_recursive_call_inner(inner, function_name, False)
		TypedBinaryExpr(_, left, right, _, _):
			(
				typed_expr_has_non_tail_recursive_call_inner(left, function_name, False)
				or typed_expr_has_non_tail_recursive_call_inner(right, function_name, False)
			)
		TypedLogicalExpr(_, left, right, _, _):
			(
				typed_expr_has_non_tail_recursive_call_inner(left, function_name, False)
				or typed_expr_has_non_tail_recursive_call_inner(right, function_name, False)
			)
		TypedCallExpr(callee, args, _, info):
			typed_call_has_non_tail_recursive_call(callee, args, info, function_name, in_tail)
		TypedTupleExpr(items, _, _):
			typed_expr_list_has_non_tail_recursive_call(items, function_name)
		TypedTupleDestructExpr(_, value, _, _):
			typed_expr_has_non_tail_recursive_call_inner(value, function_name, False)
		TypedAssignExpr(_, _, value, _, _):
			typed_expr_has_non_tail_recursive_call_inner(value, function_name, False)
		TypedSubscriptExpr(receiver, indices, _, _):
			(
				typed_expr_has_non_tail_recursive_call_inner(receiver, function_name, False)
				or typed_expr_list_has_non_tail_recursive_call(indices, function_name)
			)
		TypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
			(
				typed_expr_has_non_tail_recursive_call_inner(receiver, function_name, False)
				or typed_expr_list_has_non_tail_recursive_call(indices, function_name)
				or typed_expr_has_non_tail_recursive_call_inner(value, function_name, False)
			)
		TypedListExpr(items, _, _):
			typed_expr_list_has_non_tail_recursive_call(items, function_name)
		TypedVectorExpr(items, _, _):
			typed_expr_list_has_non_tail_recursive_call(items, function_name)
		TypedDictExpr(entries, _, _):
			typed_dict_entries_have_non_tail_recursive_call(entries, function_name)
		TypedRecordExpr(fields, _, _):
			typed_record_fields_have_non_tail_recursive_call(fields, function_name)
		TypedRecordUpdateExpr(base, fields, _, _, _):
			(
				typed_expr_has_non_tail_recursive_call_inner(base, function_name, False)
				or typed_record_fields_have_non_tail_recursive_call(fields, function_name)
			)
		TypedFieldAccessExpr(receiver, _, _, _):
			typed_expr_has_non_tail_recursive_call_inner(receiver, function_name, False)
		TypedLambdaExpr(_, _, _, body, _, _):
			typed_expr_has_non_tail_recursive_call_inner(body, function_name, True)
		TypedRangeExpr(start_expr, end_expr, _, _):
			(
				typed_expr_has_non_tail_recursive_call_inner(start_expr, function_name, False)
				or typed_expr_has_non_tail_recursive_call_inner(end_expr, function_name, False)
			)
		TypedIfExpr(condition, then_branch, else_branch, _, _):
			condition_has = typed_expr_has_non_tail_recursive_call_inner(
				condition,
				function_name,
				False,
			)

			if condition_has:
				True
			else if typed_expr_has_non_tail_recursive_call_inner(
				then_branch,
				function_name,
				in_tail,
			):
				True
			else:
				match else_branch:
					Some(branch):
						typed_expr_has_non_tail_recursive_call_inner(branch, function_name, in_tail)
					None:
						False
		TypedMatchExpr(scrutinee, cases, _, _):
			(
				typed_expr_has_non_tail_recursive_call_inner(scrutinee, function_name, False)
				or typed_match_cases_have_non_tail_recursive_call(cases, function_name, in_tail)
			)
		TypedSelectExpr(arms, _, _):
			typed_select_arms_have_non_tail_recursive_call(arms, function_name)
		TypedWhileExpr(condition, body, _, _):
			(
				typed_expr_has_non_tail_recursive_call_inner(condition, function_name, False)
				or typed_expr_has_non_tail_recursive_call_inner(body, function_name, False)
			)
		TypedForExpr(_, iterable, _, body, _, _):
			(
				typed_expr_has_non_tail_recursive_call_inner(iterable, function_name, False)
				or typed_expr_has_non_tail_recursive_call_inner(body, function_name, False)
			)
		TypedConcurrentBlockExpr(params, bindings, _, _):
			(
				typed_concurrent_params_have_non_tail_recursive_call(params, function_name)
				or typed_concurrent_bindings_have_non_tail_recursive_call(bindings, function_name)
			)
		TypedConcurrentForExpr(_, iterable, params, body, _, _):
			(
				typed_expr_has_non_tail_recursive_call_inner(iterable, function_name, False)
				or typed_concurrent_params_have_non_tail_recursive_call(params, function_name)
				or typed_expr_has_non_tail_recursive_call_inner(body, function_name, False)
			)
		TypedDetachExpr(body, _, _):
			typed_expr_has_non_tail_recursive_call_inner(body, function_name, False)
		TypedAscriptionExpr(inner, _, _, _):
			typed_expr_has_non_tail_recursive_call_inner(inner, function_name, in_tail)
		TypedOpaqueIntoExpr(_, inner, _, _):
			typed_expr_has_non_tail_recursive_call_inner(inner, function_name, in_tail)
		TypedOpaqueFromExpr(_, inner, _, _):
			typed_expr_has_non_tail_recursive_call_inner(inner, function_name, in_tail)
		TypedBlockExpr(items, _, _):
			typed_block_has_non_tail_recursive_call(items, function_name, in_tail)
		TypedWithExpr(binding, body, _, _):
			(
				typed_with_binding_has_non_tail_recursive_call(binding, function_name)
				or typed_expr_has_non_tail_recursive_call_inner(body, function_name, in_tail)
			)
		TypedDebugBlockExpr(body, _, _):
			typed_expr_has_non_tail_recursive_call_inner(body, function_name, in_tail)
		TypedVarDeclExpr(payload, _):
			typed_expr_has_non_tail_recursive_call_inner(payload.initializer, function_name, False)
		TypedQuestionBindExpr(_, _, value, _, _):
			typed_expr_has_non_tail_recursive_call_inner(value, function_name, False)
		TypedStringInterpolationPartsExpr(parts, _, _, _):
			typed_interpolation_parts_have_non_tail_recursive_call(parts, function_name)
		_:
			False


pure func typed_expr_has_non_tail_recursive_call(expr: TypedExpr, function_name: String) -> Bool:
	typed_expr_has_non_tail_recursive_call_inner(expr, function_name, True)


private pure func typed_expr_list_pure_lambda_impure_call_names(
	exprs: List[TypedExpr],
) -> List[String]:
	var result: List[String] = []

	for expr in exprs:
		result = append_impure_call_names(result, typed_expr_pure_lambda_impure_call_names(expr))

	result


private pure func typed_dict_entries_pure_lambda_impure_call_names(
	entries: List[TypedDictEntry],
) -> List[String]:
	var result: List[String] = []

	for entry in entries:
		result = append_impure_call_names(
			result,
			typed_expr_pure_lambda_impure_call_names(entry.key),
		)
		result = append_impure_call_names(
			result,
			typed_expr_pure_lambda_impure_call_names(entry.value),
		)

	result


