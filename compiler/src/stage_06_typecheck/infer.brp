			result,
			typed_expr_pure_lambda_impure_call_names(field.value),
		)

	result


private pure func typed_concurrent_params_pure_lambda_impure_call_names(
	params: List[TypedConcurrentParam],
) -> List[String]:
	var result: List[String] = []

	for param in params:
		result = append_impure_call_names(
			result,
			typed_expr_pure_lambda_impure_call_names(param.value),
		)

	result


private pure func typed_concurrent_bindings_pure_lambda_impure_call_names(
	bindings: List[TypedConcurrentBinding],
) -> List[String]:
	var result: List[String] = []

	for binding in bindings:
		result = append_impure_call_names(
			result,
			typed_expr_pure_lambda_impure_call_names(binding.value),
		)

	result


private pure func typed_with_binding_pure_lambda_impure_call_names(
	binding: TypedWithBinding,
) -> List[String]:
	result = typed_expr_pure_lambda_impure_call_names(binding.value)

	match binding.error_map:
		Some(mapper):
			append_impure_call_names(result, typed_expr_pure_lambda_impure_call_names(mapper.value))
		None:
			result


private pure func typed_interpolation_parts_pure_lambda_impure_call_names(
	parts: List[TypedStringInterpolationPart],
) -> List[String]:
	var result: List[String] = []

	for part in parts:
		match part:
			TypedInterpolationLiteral(_):
				void
			TypedInterpolationExpr(expr):
				result = append_impure_call_names(
					result,
					typed_expr_pure_lambda_impure_call_names(expr),
				)

	result


private pure func typed_match_cases_pure_lambda_impure_call_names(
	cases: List[TypedMatchCase],
) -> List[String]:
	var result: List[String] = []

	for case in cases:
		result = append_impure_call_names(
			result,
			typed_expr_pure_lambda_impure_call_names(case.body),
		)

	result


private pure func typed_select_arms_pure_lambda_impure_call_names(
	arms: List[TypedSelectArm],
) -> List[String]:
	var result: List[String] = []

	for arm in arms:
		match arm.kind:
			TypedSelectReceiveArm(_, _, channel):
				result = append_impure_call_names(
					result,
					typed_expr_pure_lambda_impure_call_names(channel),
				)
			TypedSelectSealedArm(_, channel):
				result = append_impure_call_names(
					result,
					typed_expr_pure_lambda_impure_call_names(channel),
				)
			TypedSelectAfterArm(timeout):
				result = append_impure_call_names(
					result,
					typed_expr_pure_lambda_impure_call_names(timeout),
				)

		result = append_impure_call_names(
			result,
			typed_expr_pure_lambda_impure_call_names(arm.body),
		)

	result


pure func typed_expr_pure_lambda_impure_call_names(expr: TypedExpr) -> List[String]:
	match expr:
		TypedUnaryExpr(_, inner, _, _):
			typed_expr_pure_lambda_impure_call_names(inner)
		TypedBinaryExpr(_, left, right, _, _):
			append_impure_call_names(
				typed_expr_pure_lambda_impure_call_names(left),
				typed_expr_pure_lambda_impure_call_names(right),
			)
		TypedLogicalExpr(_, left, right, _, _):
			append_impure_call_names(
				typed_expr_pure_lambda_impure_call_names(left),
				typed_expr_pure_lambda_impure_call_names(right),
			)
		TypedCallExpr(callee, args, _, _):
			append_impure_call_names(
				typed_expr_pure_lambda_impure_call_names(callee),
				typed_expr_list_pure_lambda_impure_call_names(args),
			)
		TypedTupleExpr(items, _, _):
			typed_expr_list_pure_lambda_impure_call_names(items)
		TypedTupleDestructExpr(_, value, _, _):
			typed_expr_pure_lambda_impure_call_names(value)
		TypedAssignExpr(_, _, value, _, _):
			typed_expr_pure_lambda_impure_call_names(value)
		TypedSubscriptExpr(receiver, indices, _, _):
			append_impure_call_names(
				typed_expr_pure_lambda_impure_call_names(receiver),
				typed_expr_list_pure_lambda_impure_call_names(indices),
			)
		TypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
			with_indices = append_impure_call_names(
				typed_expr_pure_lambda_impure_call_names(receiver),
				typed_expr_list_pure_lambda_impure_call_names(indices),
			)
			append_impure_call_names(with_indices, typed_expr_pure_lambda_impure_call_names(value))
		TypedListExpr(items, _, _):
			typed_expr_list_pure_lambda_impure_call_names(items)
		TypedVectorExpr(items, _, _):
			typed_expr_list_pure_lambda_impure_call_names(items)
		TypedDictExpr(entries, _, _):
			typed_dict_entries_pure_lambda_impure_call_names(entries)
		TypedRecordExpr(fields, _, _):
			typed_record_fields_pure_lambda_impure_call_names(fields)
		TypedRecordUpdateExpr(base, fields, _, _, _):
			append_impure_call_names(
				typed_expr_pure_lambda_impure_call_names(base),
				typed_record_fields_pure_lambda_impure_call_names(fields),
			)
		TypedFieldAccessExpr(receiver, _, _, _):
			typed_expr_pure_lambda_impure_call_names(receiver)
		TypedLambdaExpr(is_pure, _, _, body, _, _):
			if is_pure:
				typed_expr_impure_call_names(body)
			else:
				typed_expr_pure_lambda_impure_call_names(body)
		TypedRangeExpr(start_expr, end_expr, _, _):
			append_impure_call_names(
				typed_expr_pure_lambda_impure_call_names(start_expr),
				typed_expr_pure_lambda_impure_call_names(end_expr),
			)
		TypedIfExpr(condition, then_branch, else_branch, _, _):
			with_then = append_impure_call_names(
				typed_expr_pure_lambda_impure_call_names(condition),
				typed_expr_pure_lambda_impure_call_names(then_branch),
			)

			match else_branch:
				Some(branch):
					append_impure_call_names(
						with_then,
						typed_expr_pure_lambda_impure_call_names(branch),
					)
				None:
					with_then
		TypedMatchExpr(scrutinee, cases, _, _):
			append_impure_call_names(
				typed_expr_pure_lambda_impure_call_names(scrutinee),
				typed_match_cases_pure_lambda_impure_call_names(cases),
			)
		TypedSelectExpr(arms, _, _):
			typed_select_arms_pure_lambda_impure_call_names(arms)
		TypedWhileExpr(condition, body, _, _):
			append_impure_call_names(
				typed_expr_pure_lambda_impure_call_names(condition),
				typed_expr_pure_lambda_impure_call_names(body),
			)
		TypedForExpr(_, iterable, _, body, _, _):
			append_impure_call_names(
				typed_expr_pure_lambda_impure_call_names(iterable),
				typed_expr_pure_lambda_impure_call_names(body),
			)
		TypedConcurrentBlockExpr(params, bindings, _, _):
			append_impure_call_names(
				typed_concurrent_params_pure_lambda_impure_call_names(params),
				typed_concurrent_bindings_pure_lambda_impure_call_names(bindings),
			)
		TypedConcurrentForExpr(_, iterable, params, body, _, _):
			with_iterable = typed_expr_pure_lambda_impure_call_names(iterable)
			with_params = append_impure_call_names(
				with_iterable,
				typed_concurrent_params_pure_lambda_impure_call_names(params),
			)
			append_impure_call_names(with_params, typed_expr_pure_lambda_impure_call_names(body))
		TypedDetachExpr(body, _, _):
			typed_expr_pure_lambda_impure_call_names(body)
		TypedAscriptionExpr(inner, _, _, _):
			typed_expr_pure_lambda_impure_call_names(inner)
		TypedOpaqueIntoExpr(_, inner, _, _):
			typed_expr_pure_lambda_impure_call_names(inner)
		TypedOpaqueFromExpr(_, inner, _, _):
			typed_expr_pure_lambda_impure_call_names(inner)
		TypedBlockExpr(items, _, _):
			typed_expr_list_pure_lambda_impure_call_names(items)
		TypedWithExpr(binding, body, _, _):
			append_impure_call_names(
				typed_with_binding_pure_lambda_impure_call_names(binding),
				typed_expr_pure_lambda_impure_call_names(body),
			)
		TypedDebugBlockExpr(body, _, _):
			typed_expr_pure_lambda_impure_call_names(body)
		TypedVarDeclExpr(payload, _):
			typed_expr_pure_lambda_impure_call_names(payload.initializer)
		TypedQuestionBindExpr(_, _, value, _, _):
			typed_expr_pure_lambda_impure_call_names(value)
		TypedStringInterpolationPartsExpr(parts, _, _, _):
			typed_interpolation_parts_pure_lambda_impure_call_names(parts)
		_:
			[]


