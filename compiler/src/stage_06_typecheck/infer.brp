private pure func typed_with_binding_debug_block_impure_call_names(
	binding: TypedWithBinding,
) -> List[String]:
	result = typed_expr_debug_block_impure_call_names(binding.value)

	match binding.error_map:
		Some(mapper):
			append_impure_call_names(result, typed_expr_debug_block_impure_call_names(mapper.value))
		None:
			result


