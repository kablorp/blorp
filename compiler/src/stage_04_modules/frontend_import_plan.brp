-- Canonical import lookup policy shared by every compiler client.
--
-- This layer decides precedence and confinement without performing I/O. Source
-- providers evaluate the resulting typed lookups against either the filesystem
-- (CLI) or one immutable selected-source snapshot (LSP).
import:
	frontend_graph_service: FrontendSourceCandidate
	loaded_module: ModuleOrigin(SourcePackageModule, StdlibModule), resolved_module_origin
	path: dirname, join, normalize


union FrontendImportLookup:
	FrontendNativePackageLookup(String)
	FrontendStandardLibraryLookup(String)
	FrontendRelativePathLookup(String, ModuleOrigin)
	FrontendSourcePackageAliasLookup(String)
	FrontendSourcePackageInternalLookup(String, String)
	FrontendLocalPathLookup(String)


private pure func module_source_filename(module_path: String) -> String:
	if module_path.ends_with(".brp"):
		module_path
	else:
		module_path + ".brp"


private pure func source_path_for_import(
	importer: FrontendSourceCandidate,
	requested_path: String,
) -> String:
	normalize(join(dirname(importer.source.path), module_source_filename(requested_path)))


-- Ordering is language behavior. Keeping it here prevents editor analysis from
-- preferring a different module than a normal build when names overlap.
pure func frontend_import_lookup_plan(
	importer: FrontendSourceCandidate,
	requested_path: String,
) -> List[FrontendImportLookup]:
	origin = resolved_module_origin(importer.identity)

	if requested_path.starts_with("pkg/"):
		match origin:
			SourcePackageModule(_):
				[]
			StdlibModule:
				[]
			_:
				[FrontendNativePackageLookup(requested_path)]
	else if requested_path.starts_with("std/"):
		[FrontendStandardLibraryLookup(requested_path)]
	else if requested_path.starts_with("./") or requested_path.starts_with("../"):
		[FrontendRelativePathLookup(
				source_path_for_import(importer, requested_path),
				origin,
			)]
	else:
		match origin:
			SourcePackageModule(package_alias):
				[FrontendSourcePackageInternalLookup(package_alias, requested_path)]
			_:
				[
					FrontendSourcePackageAliasLookup(requested_path),
					FrontendStandardLibraryLookup("std/" + requested_path),
					FrontendLocalPathLookup(source_path_for_import(importer, requested_path)),
				]
