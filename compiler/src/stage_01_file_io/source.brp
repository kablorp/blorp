-- Source, cursor, and span primitives for the Blorp-owned compiler frontend.
--
-- This module is deliberately separate from CoreSourceLoc. Parser spans are
-- frontend facts over source text; Core spans are lowered diagnostic metadata.
record SourceFile {
	path: String,
	module_name: String,
	text: String
}


struct Cursor {
	offset: Int,
	line: Int,
	column: Int
}


record SourceSpan {
	path: String,
	module_name: String,
	start_offset: Int,
	start_line: Int,
	start_column: Int,
	end_offset: Int,
	end_line: Int,
	end_column: Int
}


private COMPILER_SOURCE_TAB_WIDTH: Int = 4


pure func source_file(path: String, module_name: String, text: String) -> SourceFile:
	{
		path = path,
		module_name = module_name,
		text = text
	}


pure func source_start(_: SourceFile) -> Cursor:
	{
		offset = 0,
		line = 1,
		column = 1
	}


pure func source_at_end(src: SourceFile, cursor: Cursor) -> Bool:
	cursor.offset >= src.text.length()


pure func source_peek(src: SourceFile, cursor: Cursor) -> Option[Char]:
	src.text.get(cursor.offset)


pure func source_advance(src: SourceFile, cursor: Cursor) -> Cursor:
	match source_peek(src, cursor):
		Some('\n'):
			next: Cursor = {
				offset = cursor.offset + 1,
				line = cursor.line + 1,
				column = 1
			}
			next
		Some('\t'):
			next: Cursor = {
				offset = cursor.offset + 1,
				line = cursor.line,
				column = cursor.column + (COMPILER_SOURCE_TAB_WIDTH - (cursor.column - 1) % COMPILER_SOURCE_TAB_WIDTH)
			}
			next
		Some(_):
			next: Cursor = {
				offset = cursor.offset + 1,
				line = cursor.line,
				column = cursor.column + 1
			}
			next
		None:
			cursor


pure func source_cursor_at(src: SourceFile, offset: Int) -> Cursor:
	target: Int = if offset < 0:
		0
	else if offset > src.text.length():
		src.text.length()
	else:
		offset

	var cursor: Cursor = source_start(src)

	while cursor.offset < target:
		cursor = source_advance(src, cursor)

	cursor


pure func source_span(src: SourceFile, start_cursor: Cursor, end_cursor: Cursor) -> SourceSpan:
	{
		path = src.path,
		module_name = src.module_name,
		start_offset = start_cursor.offset,
		start_line = start_cursor.line,
		start_column = start_cursor.column,
		end_offset = end_cursor.offset,
		end_line = end_cursor.line,
		end_column = end_cursor.column
	}


pure func source_empty_span(src: SourceFile, cursor: Cursor) -> SourceSpan:
	source_span(src, cursor, cursor)


pure func source_span_text(src: SourceFile, span: SourceSpan) -> String:
	src.text.substring(span.start_offset, span.end_offset - span.start_offset)


pure func source_span_label(span: SourceSpan) -> String:
	span.path + ":" + span.start_line.to_string() + ":" + span.start_column.to_string()


pure func source_spans_equal(left: SourceSpan, right: SourceSpan) -> Bool:
	(
		left.path == right.path
		and left.module_name == right.module_name
		and left.start_offset == right.start_offset
		and left.start_line == right.start_line
		and left.start_column == right.start_column
		and left.end_offset == right.end_offset
		and left.end_line == right.end_line
		and left.end_column == right.end_column
	)
