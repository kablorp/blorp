		_:
			None


pure func render_static_string_object(args: StaticStringObjectArgs) -> String:
	"static struct { blorp_Object header; long len; long capacity; char data[" + args.data_len + "]; } " + args.storage + " = { { BLORP_IMMORTAL_REFCOUNT, BLORP_ALLOC_CLASS_DIRECT, 0 }, " + args.byte_len + "L, " + args.byte_len + "L, \"" + args.escaped_text + "\" };"


pure func render_static_tuple_object(args: StaticTupleObjectArgs) -> String:
	"static struct { blorp_Object header; long arity; long release_mask; void* elem[" + args.storage_slots + "]; } " + args.storage + ((
		" = { .header = { BLORP_IMMORTAL_REFCOUNT, BLORP_ALLOC_CLASS_DIRECT, 0 }, .arity "
		+ "= "
	)) + args.arity + "L, .release_mask = " + args.release_mask + "UL, .elem = { " + args.element_initializers + " } };"


pure func render_static_pointer_list_object(args: StaticPointerListObjectArgs) -> String:
	(
		"static struct { blorp_Object header; long len; long capacity; void "
		+ "(*elem_release)(void*); int16_t elem_size; uint8_t storage_mode; char __pad["
	) + args.padding_bytes + "]; void* data[" + args.capacity + "]; } " + args.storage + " = { { BLORP_IMMORTAL_REFCOUNT, BLORP_ALLOC_CLASS_DIRECT, 0 }, " + args.elem_count + "L, " + args.capacity + "L, " + args.elem_release + ", (int16_t)sizeof(void*), BLORP_LIST_STORAGE_POINTER, { 0 }, { " + args.element_initializers + " } };"


pure func render_static_inline_list_object(args: StaticInlineListObjectArgs) -> String:
	(
		"static struct { blorp_Object header; long len; long capacity; void "
		+ "(*elem_release)(void*); int16_t elem_size; uint8_t storage_mode; char __pad["
	) + args.padding_bytes + "]; " + args.storage_c_type + " data[" + args.capacity + "]; } " + args.storage + " = { { BLORP_IMMORTAL_REFCOUNT, BLORP_ALLOC_CLASS_DIRECT, 0 }, " + args.elem_count + "L, " + args.capacity + "L, NULL, (int16_t)" + args.elem_size + ", BLORP_LIST_STORAGE_INLINE, { 0 }, { " + args.element_initializers + " } };"


pure func render_static_record_object(args: StaticRecordObjectArgs) -> String:
	"static " + args.c_type + " " + args.storage + " = { { BLORP_IMMORTAL_REFCOUNT, BLORP_ALLOC_CLASS_DIRECT, 0 }" + args.field_initializer_tail + " };"


pure func render_static_union_object(args: StaticUnionObjectArgs) -> String:
	"static " + args.c_type + " " + args.storage + " = { .header = { BLORP_IMMORTAL_REFCOUNT, BLORP_ALLOC_CLASS_DIRECT, 0 }, " + ".tag = " + args.tag + ", .data." + args.variant + " = { " + args.field_initializers + " } };"


pure func render_string_global_pointer(args: GlobalPointerArgs) -> String:
	"static blorp_String* ${args.name} = (blorp_String*)&${args.storage};"


pure func render_list_global_pointer(args: GlobalPointerArgs) -> String:
	"static blorp_List* ${args.name} = (blorp_List*)&${args.storage};"


pure func render_tuple_global_pointer(args: GlobalPointerArgs) -> String:
	"static blorp_Tuple* ${args.name} = (blorp_Tuple*)&${args.storage};"


pure func render_typed_pointer_global(args: TypedPointerGlobalArgs) -> String:
	"static ${args.c_type} ${args.name} = (${args.c_type})&${args.storage};"


pure func render_static_stack_result_initializer(args: StaticStackResultInitializerArgs) -> String:
	"{ .tag = " + args.tag + ", .release_mask = " + args.release_mask + "UL, .data." + args.field + ".field0 = " + args.payload + " }"


pure func render_stack_value_global(args: StackValueGlobalArgs) -> String:
	"static ${args.c_type} ${args.name} = ${args.initializer};"


pure func render_scalar_global(args: StackValueGlobalArgs) -> String:
	"static ${args.c_type} ${args.name} = ${args.initializer};"


pure func render_uninitialized_global(args: UninitializedGlobalArgs) -> String:
	"static ${args.c_type} ${args.name};"


pure func render_string_storage_name(args: NameArgs) -> String:
	"__blorp_static_string_" + args.name


pure func render_list_storage_name(args: NameArgs) -> String:
	"__blorp_static_list_" + args.name


pure func render_tuple_storage_name(args: NameArgs) -> String:
	"__blorp_static_tuple_" + args.name


pure func render_record_storage_name(args: NameArgs) -> String:
	"__blorp_static_record_" + args.name


pure func render_union_storage_name(args: NameArgs) -> String:
	"__blorp_static_union_" + args.name


pure func render_child_path(args: ChildPathArgs) -> String:
	args.parent + "_" + args.child


pure func render_list_child_path(args: IndexedChildPathArgs) -> String:
	args.parent + "_elem_" + args.index


pure func render_tuple_child_path(args: IndexedChildPathArgs) -> String:
	args.parent + "_" + args.index


pure func render_union_child_path(args: UnionChildPathArgs) -> String:
	args.parent + "_" + args.variant + "_" + args.index


pure func render_string_pointer_initializer(args: StorageInitializerArgs) -> String:
	"(blorp_String*)&" + args.storage


pure func render_list_pointer_initializer(args: StorageInitializerArgs) -> String:
	"(blorp_List*)&" + args.storage


pure func render_tuple_pointer_initializer(args: StorageInitializerArgs) -> String:
	"(blorp_Tuple*)&" + args.storage


pure func render_typed_pointer_initializer(args: TypedInitializerArgs) -> String:
	"(" + args.c_type + ")&" + args.value


pure func render_pointer_slot_initializer(args: ExpressionInitializerArgs) -> String:
	"(void*)" + args.expression


pure func render_primitive_slot_initializer(args: ExpressionInitializerArgs) -> String:
	"(void*)(long)(" + args.expression + ")"


pure func render_void_slot_initializer() -> String:
	"(void*)0"


pure func render_inline_element_cast_initializer(args: TypedInitializerArgs) -> String:
	"((" + args.c_type + ")(" + args.value + "))"


pure func render_static_constant_op(op: StaticConstantOp) -> String:
	match op:
		StringObject(args):
			render_static_string_object(args)
		TupleObject(args):
			render_static_tuple_object(args)
		PointerListObject(args):
			render_static_pointer_list_object(args)
		InlineListObject(args):
			render_static_inline_list_object(args)
		RecordObject(args):
			render_static_record_object(args)
		UnionObject(args):
			render_static_union_object(args)
		StringGlobalPointer(args):
			render_string_global_pointer(args)
		ListGlobalPointer(args):
			render_list_global_pointer(args)
		TupleGlobalPointer(args):
			render_tuple_global_pointer(args)
		TypedPointerGlobal(args):
			render_typed_pointer_global(args)
		StackResultInitializer(args):
			render_static_stack_result_initializer(args)
		StackValueGlobal(args):
			render_stack_value_global(args)
		ScalarGlobal(args):
			render_scalar_global(args)
		UninitializedGlobal(args):
			render_uninitialized_global(args)
		StringStorageName(args):
			render_string_storage_name(args)
		ListStorageName(args):
			render_list_storage_name(args)
		TupleStorageName(args):
			render_tuple_storage_name(args)
		RecordStorageName(args):
			render_record_storage_name(args)
		UnionStorageName(args):
			render_union_storage_name(args)
		ChildPath(args):
			render_child_path(args)
		ListChildPath(args):
			render_list_child_path(args)
		TupleChildPath(args):
			render_tuple_child_path(args)
		UnionChildPath(args):
			render_union_child_path(args)
		StringPointerInitializer(args):
			render_string_pointer_initializer(args)
		ListPointerInitializer(args):
			render_list_pointer_initializer(args)
		TuplePointerInitializer(args):
			render_tuple_pointer_initializer(args)
		TypedPointerInitializer(args):
			render_typed_pointer_initializer(args)
		PointerSlotInitializer(args):
			render_pointer_slot_initializer(args)
		PrimitiveSlotInitializer(args):
			render_primitive_slot_initializer(args)
		VoidSlotInitializer:
			render_void_slot_initializer()
		InlineElementCastInitializer(args):
			render_inline_element_cast_initializer(args)


pure func build_static_constant_op(
	info: StaticConstantTemplateInfo,
	args: List[String],
) -> Result[StaticConstantOp, RenderError]:
	match info.template:
		StaticStringObjectTemplate:
			parsed ?= parse_static_string_object_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StringObject(parsed))
		StaticTupleObjectTemplate:
			parsed ?= parse_static_tuple_object_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TupleObject(parsed))
		StaticPointerListObjectTemplate:
			parsed ?= parse_static_pointer_list_object_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(PointerListObject(parsed))
		StaticInlineListObjectTemplate:
			parsed ?= parse_static_inline_list_object_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(InlineListObject(parsed))
		StaticRecordObjectTemplate:
			parsed ?= parse_static_record_object_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(RecordObject(parsed))
		StaticUnionObjectTemplate:
			parsed ?= parse_static_union_object_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(UnionObject(parsed))
		StaticStringGlobalPointerTemplate:
			parsed ?= parse_global_pointer_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(StringGlobalPointer(parsed))
		StaticListGlobalPointerTemplate:
			parsed ?= parse_global_pointer_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(ListGlobalPointer(parsed))
		StaticTupleGlobalPointerTemplate:
			parsed ?= parse_global_pointer_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(TupleGlobalPointer(parsed))
		StaticTypedPointerGlobalTemplate:
			parsed ?= parse_typed_pointer_global_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TypedPointerGlobal(parsed))
		StaticStackResultInitializerTemplate:
			parsed ?= parse_static_stack_result_initializer_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackResultInitializer(parsed))
		StaticStackValueGlobalTemplate:
			parsed ?= parse_stack_value_global_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackValueGlobal(parsed))
		StaticScalarGlobalTemplate:
			parsed ?= parse_stack_value_global_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ScalarGlobal(parsed))
		StaticUninitializedGlobalTemplate:
			parsed ?= parse_uninitialized_global_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(UninitializedGlobal(parsed))
		StaticStringStorageNameTemplate:
			parsed ?= parse_name_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(StringStorageName(parsed))
		StaticListStorageNameTemplate:
			parsed ?= parse_name_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(ListStorageName(parsed))
		StaticTupleStorageNameTemplate:
			parsed ?= parse_name_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(TupleStorageName(parsed))
		StaticRecordStorageNameTemplate:
			parsed ?= parse_name_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(RecordStorageName(parsed))
		StaticUnionStorageNameTemplate:
			parsed ?= parse_name_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(UnionStorageName(parsed))
		StaticChildPathTemplate:
			parsed ?= parse_child_path_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(ChildPath(parsed))
		StaticListChildPathTemplate:
			parsed ?= parse_indexed_child_path_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListChildPath(parsed))
		StaticTupleChildPathTemplate:
			parsed ?= parse_indexed_child_path_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TupleChildPath(parsed))
		StaticUnionChildPathTemplate:
			parsed ?= parse_union_child_path_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(UnionChildPath(parsed))
		StaticStringPointerInitializerTemplate:
			parsed ?= parse_storage_initializer_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StringPointerInitializer(parsed))
		StaticListPointerInitializerTemplate:
			parsed ?= parse_storage_initializer_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListPointerInitializer(parsed))
		StaticTuplePointerInitializerTemplate:
			parsed ?= parse_storage_initializer_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TuplePointerInitializer(parsed))
		StaticTypedPointerInitializerTemplate:
			parsed ?= parse_typed_initializer_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(TypedPointerInitializer(parsed))
		StaticPointerSlotInitializerTemplate:
			parsed ?= parse_expression_initializer_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(PointerSlotInitializer(parsed))
		StaticPrimitiveSlotInitializerTemplate:
			parsed ?= parse_expression_initializer_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(PrimitiveSlotInitializer(parsed))
		StaticVoidSlotInitializerTemplate:
			match args:
				[]:
					Ok(VoidSlotInitializer)
				_:
					Err(wrong_arity_for_args(info, args))
		StaticInlineElementCastInitializerTemplate:
			parsed ?= parse_typed_initializer_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(InlineElementCastInitializer(parsed))


pure func render_static_constant(name: String, args: List[String]) -> Result[String, RenderError]:
	match parse_static_constant_template(name):
		Some(info):
			match build_static_constant_op(info, args):
				Ok(op):
					Ok(render_static_constant_op(op))
				Err(error):
					Err(error)
		None:
			Err(UnsupportedStaticConstantOp(name))


private pure func placeholder_static_constant_op(
	info: StaticConstantTemplateInfo,
) -> StaticConstantOp:
	match info.template:
		StaticStringObjectTemplate:
			StringObject({
				storage = "@0@",
				data_len = "@1@",
				byte_len = "@2@",
				escaped_text = "@3@",
			})
		StaticTupleObjectTemplate:
			TupleObject({
				storage = "@0@",
				storage_slots = "@1@",
				arity = "@2@",
				release_mask = "@3@",
				element_initializers = "@4@",
			})
		StaticPointerListObjectTemplate:
			PointerListObject({
				storage = "@0@",
				padding_bytes = "@1@",
				capacity = "@2@",
				elem_count = "@3@",
				elem_release = "@4@",
				element_initializers = "@5@",
			})
		StaticInlineListObjectTemplate:
			InlineListObject({
				storage = "@0@",
				padding_bytes = "@1@",
				storage_c_type = "@2@",
				capacity = "@3@",
				elem_count = "@4@",
				elem_size = "@5@",
				element_initializers = "@6@",
			})
		StaticRecordObjectTemplate:
			RecordObject({
				c_type = "@0@",
				storage = "@1@",
				field_initializer_tail = "@2@",
			})
		StaticUnionObjectTemplate:
			UnionObject({
				c_type = "@0@",
				storage = "@1@",
				tag = "@2@",
				variant = "@3@",
				field_initializers = "@4@",
			})
		StaticStringGlobalPointerTemplate:
			StringGlobalPointer({
				name = "@0@",
				storage = "@1@",
			})
		StaticListGlobalPointerTemplate:
			ListGlobalPointer({
				name = "@0@",
				storage = "@1@",
			})
		StaticTupleGlobalPointerTemplate:
			TupleGlobalPointer({
				name = "@0@",
				storage = "@1@",
			})
		StaticTypedPointerGlobalTemplate:
			TypedPointerGlobal({
				c_type = "@0@",
				name = "@1@",
				storage = "@2@",
			})
		StaticStackResultInitializerTemplate:
			StackResultInitializer({
				tag = "@0@",
				release_mask = "@1@",
				field = "@2@",
				payload = "@3@",
			})
		StaticStackValueGlobalTemplate:
			StackValueGlobal({
				c_type = "@0@",
				name = "@1@",
				initializer = "@2@",
			})
		StaticScalarGlobalTemplate:
			ScalarGlobal({
				c_type = "@0@",
				name = "@1@",
				initializer = "@2@",
			})
		StaticUninitializedGlobalTemplate:
			UninitializedGlobal({
				c_type = "@0@",
				name = "@1@",
			})
		StaticStringStorageNameTemplate:
			StringStorageName({name = "@0@"})
		StaticListStorageNameTemplate:
			ListStorageName({name = "@0@"})
		StaticTupleStorageNameTemplate:
			TupleStorageName({name = "@0@"})
		StaticRecordStorageNameTemplate:
			RecordStorageName({name = "@0@"})
		StaticUnionStorageNameTemplate:
			UnionStorageName({name = "@0@"})
		StaticChildPathTemplate:
			ChildPath({
				parent = "@0@",
				child = "@1@",
			})
		StaticListChildPathTemplate:
			ListChildPath({
				parent = "@0@",
				index = "@1@",
			})
		StaticTupleChildPathTemplate:
			TupleChildPath({
				parent = "@0@",
				index = "@1@",
			})
		StaticUnionChildPathTemplate:
			UnionChildPath({
				parent = "@0@",
				variant = "@1@",
				index = "@2@",
			})
		StaticStringPointerInitializerTemplate:
			StringPointerInitializer({storage = "@0@"})
		StaticListPointerInitializerTemplate:
			ListPointerInitializer({storage = "@0@"})
		StaticTuplePointerInitializerTemplate:
			TuplePointerInitializer({storage = "@0@"})
		StaticTypedPointerInitializerTemplate:
			TypedPointerInitializer({
				c_type = "@0@",
				value = "@1@",
			})
		StaticPointerSlotInitializerTemplate:
			PointerSlotInitializer({expression = "@0@"})
		StaticPrimitiveSlotInitializerTemplate:
			PrimitiveSlotInitializer({expression = "@0@"})
		StaticVoidSlotInitializerTemplate:
			VoidSlotInitializer
		StaticInlineElementCastInitializerTemplate:
			InlineElementCastInitializer({
				c_type = "@0@",
				value = "@1@",
			})


pure func render_manifest_line(info: StaticConstantTemplateInfo) -> String:
	name: String = static_constant_template_name(info)
	arity: Int = static_constant_template_arity(info)
	body: String = render_static_constant_op(placeholder_static_constant_op(info))
	render_template_manifest_line(name, arity, body)


pure func render_manifest_lines() -> List[String]:
	ALL_TEMPLATES.map(render_manifest_line)
