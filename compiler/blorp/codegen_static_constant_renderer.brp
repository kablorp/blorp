private TEMPLATES_BY_NAME: Dict[String, StaticConstantTemplateInfo] = templates_by_name(
	ALL_TEMPLATES,
)


pure func static_constant_template_name(info: StaticConstantTemplateInfo) -> String:
	info.name


pure func static_constant_template_arity(info: StaticConstantTemplateInfo) -> Int:
	info.arity


pure func parse_static_constant_template(name: String) -> Option[StaticConstantTemplateInfo]:
	TEMPLATES_BY_NAME.get(name)


private pure func wrong_arity_for_args(
	info: StaticConstantTemplateInfo,
	args: List[String],
) -> RenderError:
	WrongArity(info, args.length())


pure func render_error_to_string(error: RenderError) -> String:
	match error:
		WrongArity(info, actual):
			render_template_arity_error(
				"static constant op",
				static_constant_template_name(info),
				static_constant_template_arity(info),
				actual,
			)
		UnsupportedStaticConstantOp(name):
			render_unsupported_template_error("static constant op", name)


private pure func parse_global_pointer_args(args: List[String]) -> Option[GlobalPointerArgs]:
	match args:
		[name, storage]:
			Some({
				name = name,
				storage = storage,
			})
		_:
			None


private pure func parse_static_string_object_args(
	args: List[String],
) -> Option[StaticStringObjectArgs]:
	match args:
		[storage, data_len, byte_len, escaped_text]:
			Some({
				storage = storage,
				data_len = data_len,
				byte_len = byte_len,
				escaped_text = escaped_text,
			})
		_:
			None


