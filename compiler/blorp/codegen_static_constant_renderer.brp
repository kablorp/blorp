-- Blorp-authored renderer for static global constant declarations.
--
-- OCaml still decides whether a global can be represented statically and
-- computes nested initializer values. This module owns the final C declaration
-- snippets for supported storage objects and source-level globals.
import:
	codegen_template_registry:
		render_template_arity_error,
		render_template_manifest_line,
		render_unsupported_template_error,


enum StaticConstantTemplate:
	StaticStringObjectTemplate
	StaticTupleObjectTemplate
	StaticPointerListObjectTemplate
	StaticInlineListObjectTemplate
	StaticRecordObjectTemplate
	StaticUnionObjectTemplate
	StaticStringGlobalPointerTemplate
	StaticListGlobalPointerTemplate
	StaticTupleGlobalPointerTemplate
	StaticTypedPointerGlobalTemplate
	StaticStackResultInitializerTemplate
	StaticStackValueGlobalTemplate
	StaticScalarGlobalTemplate
	StaticUninitializedGlobalTemplate
	StaticStringStorageNameTemplate
	StaticListStorageNameTemplate
	StaticTupleStorageNameTemplate
	StaticRecordStorageNameTemplate
	StaticUnionStorageNameTemplate
	StaticChildPathTemplate
	StaticListChildPathTemplate
	StaticTupleChildPathTemplate
	StaticUnionChildPathTemplate
	StaticStringPointerInitializerTemplate
	StaticListPointerInitializerTemplate
	StaticTuplePointerInitializerTemplate
	StaticTypedPointerInitializerTemplate
	StaticPointerSlotInitializerTemplate
	StaticPrimitiveSlotInitializerTemplate
	StaticVoidSlotInitializerTemplate
	StaticInlineElementCastInitializerTemplate


record StaticConstantTemplateInfo {
	template: StaticConstantTemplate,
	name: String,
	arity: Int
}


record GlobalPointerArgs {
	name: String,
	storage: String
}


record StaticStringObjectArgs {
	storage: String,
	data_len: String,
	byte_len: String,
	escaped_text: String
}


record StaticTupleObjectArgs {
	storage: String,
	storage_slots: String,
	arity: String,
	release_mask: String,
	element_initializers: String
}


record StaticPointerListObjectArgs {
	storage: String,
	padding_bytes: String,
	capacity: String,
	elem_count: String,
	elem_release: String,
	element_initializers: String
}


record StaticInlineListObjectArgs {
	storage: String,
	padding_bytes: String,
	storage_c_type: String,
	capacity: String,
	elem_count: String,
	elem_size: String,
	element_initializers: String
}


record StaticRecordObjectArgs {
	c_type: String,
	storage: String,
	field_initializer_tail: String
}


record StaticUnionObjectArgs {
	c_type: String,
	storage: String,
	tag: String,
	variant: String,
	field_initializers: String
}


record TypedPointerGlobalArgs {
	c_type: String,
	name: String,
	storage: String
}


record StackValueGlobalArgs {
	c_type: String,
	name: String,
	initializer: String
}


record UninitializedGlobalArgs {
	c_type: String,
	name: String
}


record StaticStackResultInitializerArgs {
	tag: String,
	release_mask: String,
	field: String,
	payload: String
}


record NameArgs {
	name: String
}


record ChildPathArgs {
	parent: String,
	child: String
}


record IndexedChildPathArgs {
	parent: String,
	index: String
}


record UnionChildPathArgs {
	parent: String,
	variant: String,
	index: String
}


record StorageInitializerArgs {
	storage: String
}


record TypedInitializerArgs {
	c_type: String,
	value: String
}


record ExpressionInitializerArgs {
	expression: String
}


union StaticConstantOp:
	StringObject(StaticStringObjectArgs)
	TupleObject(StaticTupleObjectArgs)
	PointerListObject(StaticPointerListObjectArgs)
	InlineListObject(StaticInlineListObjectArgs)
	RecordObject(StaticRecordObjectArgs)
	UnionObject(StaticUnionObjectArgs)
	StringGlobalPointer(GlobalPointerArgs)
	ListGlobalPointer(GlobalPointerArgs)
	TupleGlobalPointer(GlobalPointerArgs)
	TypedPointerGlobal(TypedPointerGlobalArgs)
	StackResultInitializer(StaticStackResultInitializerArgs)
	StackValueGlobal(StackValueGlobalArgs)
	ScalarGlobal(StackValueGlobalArgs)
	UninitializedGlobal(UninitializedGlobalArgs)
	StringStorageName(NameArgs)
	ListStorageName(NameArgs)
	TupleStorageName(NameArgs)
	RecordStorageName(NameArgs)
	UnionStorageName(NameArgs)
	ChildPath(ChildPathArgs)
	ListChildPath(IndexedChildPathArgs)
	TupleChildPath(IndexedChildPathArgs)
	UnionChildPath(UnionChildPathArgs)
	StringPointerInitializer(StorageInitializerArgs)
	ListPointerInitializer(StorageInitializerArgs)
	TuplePointerInitializer(StorageInitializerArgs)
	TypedPointerInitializer(TypedInitializerArgs)
	PointerSlotInitializer(ExpressionInitializerArgs)
	PrimitiveSlotInitializer(ExpressionInitializerArgs)
	VoidSlotInitializer
	InlineElementCastInitializer(TypedInitializerArgs)


union RenderError:
	WrongArity(StaticConstantTemplateInfo, Int)
	UnsupportedStaticConstantOp(String)


private pure func templates_by_name(
	templates: List[StaticConstantTemplateInfo],
) -> Dict[String, StaticConstantTemplateInfo]:
	var dict: Dict[String, StaticConstantTemplateInfo] = {}

	for info in templates:
		dict = dict.set(info.name, info)

	dict


