-- Typecheck compiler bridge dispatcher.
--
-- This bridge owns the first typed frontend artifact. It is intentionally
-- separate from the always-built parse bridge helper while the Blorp
-- typechecker continues to grow toward the production compile path.
import:
	compiler_bridge_protocol:
		BRIDGE_SCHEMA_VERSION,
		BridgeAction(TypecheckSourceAction),
		BridgeEnvelope,
		BridgeProtocolError(InvalidJson),
		bridge_action_name,
		bridge_error_json,
		bridge_success_json,
		decode_bridge_envelope_value,
	compiler_context:
		CompilerModuleOrigin(
			CompilerNativePackageModule,
			CompilerSourcePackageModule,
			CompilerStdlibModule,
			CompilerUserModule,
		),
	compiler_imports:
		CompilerImportableModule,
		compiler_importable_module,
	compiler_lexer: compiler_lex
	compiler_module_surface: module_surface_for_program
	compiler_module_surface_json: module_surface_to_json
	compiler_parsed_ast: ParsedProgramPhase(TypecheckSourceProgram), parsed_program_phase_name
	compiler_parser: parse_compiler_source
	compiler_source: CompilerSourceFile, compiler_source_file
	compiler_source_ast_finalize: finalize_typecheck_source_program
	compiler_token: CompilerToken, CompilerTrivia, CompilerTriviaKind(CommentTrivia)
	compiler_typecheck_decl: compiler_typecheck_program, compiler_typecheck_program_with_import_modules
	compiler_typecheck_state: CompilerImportBinding, compiler_typecheck_state_empty
	compiler_typed_ast_json: compiler_typed_program_to_json
	json:
		JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_bool,
		as_string,
		get_field,
		parse_json,


union TypecheckBridgeDispatchError:
	MissingStringField(String)
	ExpectedRequestField(String, String)
	UnsupportedBridgeAction(BridgeAction)


record TypecheckImportModule {
	path: String,
	module_name: String,
	module_path: String,
	text: String,
	origin: CompilerModuleOrigin
}


private pure func owned_string(text: String) -> String:
	text.substring(0, text.length())


private pure func schema_json() -> JsonValue:
	JsonNumber(to_float(BRIDGE_SCHEMA_VERSION))


private pure func dispatch_error_code(error: TypecheckBridgeDispatchError) -> String:
	match error:
		MissingStringField(_):
			"invalid_request"
		ExpectedRequestField(_, _):
			"invalid_request"
		UnsupportedBridgeAction(_):
			"unsupported_action"


private pure func dispatch_error_message(error: TypecheckBridgeDispatchError) -> String:
	match error:
		MissingStringField(field_name):
			"missing string field `${field_name}`"
		ExpectedRequestField(field_name, expected):
			"field `${field_name}` must be ${expected}"
		UnsupportedBridgeAction(action):
			"unsupported Blorp typecheck bridge action: ${bridge_action_name(action)}"


private pure func dispatch_error_json(error: TypecheckBridgeDispatchError) -> JsonValue:
	JsonObject([("schema", schema_json()), ("ok", JsonBool(False)), ("error", JsonObject([
				("code", JsonString(dispatch_error_code(error))),
				("message", JsonString(dispatch_error_message(error))),
			]))])


private pure func request_body(envelope: BridgeEnvelope) -> JsonValue:
	envelope.payload


private pure func string_field(
	value: JsonValue,
	field_name: String,
) -> Result[String, TypecheckBridgeDispatchError]:
	field ?= get_field(value, field_name).to_result(MissingStringField(field_name))
	as_string(field)
		.map(owned_string)
		.to_result(ExpectedRequestField(field_name, "a string"))


private pure func optional_string_field(
	value: JsonValue,
	field_name: String,
) -> Result[Option[String], TypecheckBridgeDispatchError]:
	match get_field(value, field_name):
		Some(field):
			as_string(field)
				.map(func(text): Some(owned_string(text)))
				.to_result(ExpectedRequestField(field_name, "a string"))
		None:
			Ok(None)


private pure func optional_bool_field(value: JsonValue, field_name: String, default: Bool) -> Bool:
	match get_field(value, field_name):
		Some(field):
			as_bool(field).get_or(default)
		None:
			default


private pure func compiler_module_origin_from_json(
	value: JsonValue,
) -> Result[CompilerModuleOrigin, TypecheckBridgeDispatchError]:
	match value:
		JsonObject(_):
			kind ?= string_field(value, "kind")

			match kind:
				"user":
					Ok(CompilerUserModule)
				"std":
					Ok(CompilerStdlibModule)
				"source_package":
					package ?= string_field(value, "package")
					Ok(CompilerSourcePackageModule(package))
				"pkg":
					package ?= string_field(value, "package")
					Ok(CompilerNativePackageModule(package))
				"native_package":
					package ?= string_field(value, "package")
					Ok(CompilerNativePackageModule(package))
				_:
					Err(ExpectedRequestField("origin.kind", "one of user, std, source_package, pkg"))
		_:
			Err(ExpectedRequestField("origin", "an object"))


private pure func optional_origin_field(
	value: JsonValue,
) -> Result[CompilerModuleOrigin, TypecheckBridgeDispatchError]:
	match get_field(value, "origin"):
		Some(origin):
			compiler_module_origin_from_json(origin)
		None:
			Ok(CompilerUserModule)


private pure func import_module_from_json(
	value: JsonValue,
) -> Result[TypecheckImportModule, TypecheckBridgeDispatchError]:
	match value:
		JsonObject(_):
			path ?= string_field(value, "path")
			module_name ?= string_field(value, "module")
			maybe_module_path ?= optional_string_field(value, "module_path")
			text ?= string_field(value, "text")
			origin ?= optional_origin_field(value)

			Ok({
				path = path,
				module_name = module_name,
				module_path = maybe_module_path.get_or(module_name),
				text = text,
				origin = origin
			})
		_:
			Err(ExpectedRequestField("import_modules item", "an object"))


private pure func import_modules_field(
	value: JsonValue,
) -> Result[List[TypecheckImportModule], TypecheckBridgeDispatchError]:
	match get_field(value, "import_modules"):
		None:
			Ok([])
		Some(field):
			items ?= as_array(field).to_result(ExpectedRequestField("import_modules", "an array"))
			var modules: List[TypecheckImportModule] = []
			var error: Option[TypecheckBridgeDispatchError] = None

			for item in items:
				match error:
					Some(_):
						break
					None:
						match import_module_from_json(item):
							Ok(module):
								modules = modules.append(module)
							Err(err):
								error = Some(err)

			match error:
				Some(err):
					Err(err)
				None:
					Ok(modules)


private pure func comment_json(trivia: CompilerTrivia, trailing: Bool) -> JsonValue:
	JsonObject([
		("text", JsonString(trivia.text)),
		("line", JsonNumber(to_float(trivia.span.start_line))),
		("column", JsonNumber(to_float(trivia.span.start_column))),
		("trailing", JsonBool(trailing)),
	])


private pure func append_comment_jsons(
	comments: List[JsonValue],
	trivia: List[CompilerTrivia],
	trailing: Bool,
) -> List[JsonValue]:
	var result: List[JsonValue] = comments

	for item in trivia:
		if item.kind == CommentTrivia:
			result = result.append(comment_json(item, trailing))

	result


private pure func token_comment_jsons(token: CompilerToken) -> List[JsonValue]:
	append_comment_jsons(
		append_comment_jsons([], token.leading_trivia, False),
		token.trailing_trivia,
		True,
	)


private pure func source_comment_jsons(source: CompilerSourceFile) -> JsonValue:
	lex_result = compiler_lex(source)
	var comments: List[JsonValue] = []

	for token in lex_result.tokens:
		for comment in token_comment_jsons(token):
			comments = comments.append(comment)

	JsonVector(comments)


private pure func strings_to_json(items: List[String]) -> JsonValue:
	var values: List[JsonValue] = []

	for item in items:
		values = values.append(JsonString(item))

	JsonVector(values)


private pure func optional_string_to_json(value: Option[String]) -> JsonValue:
	match value:
		Some(text):
			JsonString(text)
		None:
			JsonNull


private pure func import_binding_to_json(binding: CompilerImportBinding) -> JsonValue:
	JsonObject([
		("local_name", JsonString(binding.local_name)),
		("module_path", JsonString(binding.module_path)),
		("original_name", optional_string_to_json(binding.original_name)),
	])


private pure func import_bindings_to_json(bindings: List[CompilerImportBinding]) -> JsonValue:
	var values: List[JsonValue] = []

	for binding in bindings:
		values = values.append(import_binding_to_json(binding))

	JsonVector(values)


private pure func importable_module_from_request(
	module: TypecheckImportModule,
) -> CompilerImportableModule:
	source = compiler_source_file(module.path, module.module_name, module.text)
	raw_program = parse_compiler_source(source)
	final_program = finalize_typecheck_source_program(raw_program)

	compiler_importable_module(
		module.module_path,
		module.origin,
		module_surface_for_program(final_program),
		final_program.decls,
	)


private pure func importable_modules_from_request(
	modules: List[TypecheckImportModule],
) -> List[CompilerImportableModule]:
	modules.map(importable_module_from_request)


private pure func typed_source_artifact(
	path: String,
	module_name: String,
	text: String,
	include_comments: Bool,
	import_modules: List[TypecheckImportModule],
) -> JsonValue:
	source = compiler_source_file(path, module_name, text)
	raw_program = parse_compiler_source(source)
	final_program = finalize_typecheck_source_program(raw_program)
	typed_result = if import_modules.length() == 0:
		compiler_typecheck_program(compiler_typecheck_state_empty(), final_program)
	else:
		compiler_typecheck_program_with_import_modules(
			compiler_typecheck_state_empty(),
			final_program,
			importable_modules_from_request(import_modules),
		)

	var fields: List[(String, JsonValue)] = [
		("path", JsonString(path)),
		("module", JsonString(module_name)),
		("ast_phase", JsonString(parsed_program_phase_name(TypecheckSourceProgram))),
		("typed_program", compiler_typed_program_to_json(typed_result.program)),
		("type_errors", strings_to_json(typed_result.state.errors)),
		("import_bindings", import_bindings_to_json(typed_result.state.import_bindings)),
		("module_surface", module_surface_to_json(module_surface_for_program(final_program))),
	]

	if include_comments:
		fields = fields.append(("comments", source_comment_jsons(source)))

	JsonObject(fields)


private pure func handle_typecheck_source(
	body: JsonValue,
) -> Result[JsonValue, TypecheckBridgeDispatchError]:
	path ?= string_field(body, "path")
	module_name ?= string_field(body, "module")
	text ?= string_field(body, "text")
	import_modules ?= import_modules_field(body)
	include_comments = optional_bool_field(body, "include_comments", True)

	Ok(bridge_success_json(typed_source_artifact(
			path,
			module_name,
			text,
			include_comments,
			import_modules,
		)))


private pure func handle_envelope(
	envelope: BridgeEnvelope,
) -> Result[JsonValue, TypecheckBridgeDispatchError]:
	body: JsonValue = request_body(envelope)

	match envelope.action:
		TypecheckSourceAction:
			handle_typecheck_source(body)
		_:
			Err(UnsupportedBridgeAction(envelope.action))


pure func handle_request_value(root: JsonValue) -> JsonValue:
	match decode_bridge_envelope_value(root):
		Ok(envelope):
			handle_envelope(envelope).get_or_else(dispatch_error_json)
		Err(error):
			bridge_error_json(error)


pure func handle_request(source: String) -> String:
	parse_json(source)
		.map(func(root): handle_request_value(root).to_string())
		.get_or_else(func(message): bridge_error_json(InvalidJson(message)).to_string())
