-- Cooperative-fairness checkpoint insertion for the Blorp-owned Core tail.
--
-- Loop bodies must reach the runtime scheduler at bounded intervals. This pass
-- inserts an explicit checkpoint at the start of loop bodies unless one is
-- already present.
import:
	compiler_core_json:
		CoreBoxedStorageValue,
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(ConstructorMatchFallbackBody, ConstructorMatchFallbackFail),
		CoreDecl(EnumDecl, FunctionDecl, GlobalDecl, UnionDecl, ValueRecordDecl),
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			BreakExpr,
			CastExpr,
			CallExpr,
			ConstructorMatchExpr,
			ContinueExpr,
			CooperativeCheckpointExpr,
			DupExpr,
			DropExpr,
			FieldExpr,
			ForRangeExpr,
			IfExpr,
			LetExpr,
			ListConstructExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			RangeExpr,
			RecordExpr,
			RecordConstructExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SeqExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			TupleExpr,
			TupleConstructExpr,
			TupleFieldExpr,
			UnaryExpr,
			UnionConstructExpr,
			VarExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreGlobal,
		CoreListConstruct,
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(LiteralMatchFallbackBody, LiteralMatchFallbackFail),
		CoreProgram,
		CoreRecordFieldValue,
		CoreSourceLoc,
		CoreTupleElement(TuplePointerElement, TuplePrimElement, TupleVoidElement),
		CoreType(VoidType),


private pure func checkpoint(loc: CoreSourceLoc) -> CoreExpr:
	CooperativeCheckpointExpr(VoidType, loc)


private pure func is_checkpoint_expr(expr: CoreExpr) -> Bool:
	match expr:
		CooperativeCheckpointExpr(typ, loc):
			True
		LiteralExpr(literal, typ, loc):
			False
		VarExpr(variable, typ, loc):
			False
		VoidExpr(typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, expr_value, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(variable, rhs, typ, loc):
			False
		CastExpr(expr_value, typ, loc):
			False
		FieldExpr(expr_value, field_name, typ, loc):
			False
		TupleFieldExpr(expr_value, field_index, typ, loc):
			False
		TupleExpr(items, typ, loc):
			False
		TupleConstructExpr(elements, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			False
		RecordExpr(fields, typ, loc):
			False
		RecordConstructExpr(type_name, fields, typ, loc):
			False
		UnionConstructExpr(construct, typ, loc):
			False
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			False
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			False
		LetExpr(name, is_mutable, typ, rhs, body):
			False
		SeqExpr(first, second):
			False
		WhileExpr(cond, body, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			False
		RangeExpr(start, end_value, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False


private pure func body_starts_with_checkpoint(body: CoreExpr) -> Bool:
	match body:
		CooperativeCheckpointExpr(typ, loc):
			True
		SeqExpr(first, second):
			is_checkpoint_expr(first)
		LiteralExpr(literal, typ, loc):
			False
		VarExpr(variable, typ, loc):
			False
		VoidExpr(typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, expr_value, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(variable, rhs, typ, loc):
			False
		CastExpr(expr_value, typ, loc):
			False
		FieldExpr(expr_value, field_name, typ, loc):
			False
		TupleFieldExpr(expr_value, field_index, typ, loc):
			False
		TupleExpr(items, typ, loc):
			False
		TupleConstructExpr(elements, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			False
		RecordExpr(fields, typ, loc):
			False
		RecordConstructExpr(type_name, fields, typ, loc):
			False
		UnionConstructExpr(construct, typ, loc):
			False
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			False
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			False
		LetExpr(name, is_mutable, typ, rhs, body):
			False
		WhileExpr(cond, body, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			False
		RangeExpr(start, end_value, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False


private pure func checkpoint_loop_body(loop_loc: CoreSourceLoc, body: CoreExpr) -> CoreExpr:
	if body_starts_with_checkpoint(body):
		body
	else:
		SeqExpr(checkpoint(loop_loc), body)


private pure func insert_exprs(exprs: List[CoreExpr]) -> List[CoreExpr]:
	var result: List[CoreExpr] = []

	for expr in exprs:
		result = result.append(insert_cooperative_checkpoints_expr(expr))

	result


private pure func insert_tuple_elements(elements: List[CoreTupleElement]) -> List[CoreTupleElement]:
	var result: List[CoreTupleElement] = []

	for element in elements:
		match element:
			TuplePrimElement(value):
				result = result.append(TuplePrimElement(insert_cooperative_checkpoints_expr(value)))
			TuplePointerElement(value):
				result = result.append(
					TuplePointerElement(insert_cooperative_checkpoints_expr(value)),
				)
			TupleVoidElement:
				result = result.append(TupleVoidElement)

	result


private pure func insert_boxed_storage_value(value: CoreBoxedStorageValue) -> CoreBoxedStorageValue:
	{
		kind = value.kind,
		value = insert_cooperative_checkpoints_expr(value.value),
		needs_release = value.needs_release,
		transfers_ownership = value.transfers_ownership
	}


private pure func insert_boxed_storage_values(
	values: List[CoreBoxedStorageValue],
) -> List[CoreBoxedStorageValue]:
	var result: List[CoreBoxedStorageValue] = []

	for value in values:
		result = result.append(insert_boxed_storage_value(value))

	result


private pure func insert_list_construct(construct: CoreListConstruct) -> CoreListConstruct:
	{
		layout = construct.layout,
		elements = insert_boxed_storage_values(construct.elements),
		elem_needs_release = construct.elem_needs_release
	}


private pure func insert_record_fields(
	fields: List[CoreRecordFieldValue],
) -> List[CoreRecordFieldValue]:
	var result: List[CoreRecordFieldValue] = []

	for field in fields:
		result = result.append({
			name = field.name,
			value = insert_cooperative_checkpoints_expr(field.value),
		})

	result


private pure func insert_literal_match_cases(
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	var result: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		result = result.append({
			literal = match_case.literal,
			body = insert_cooperative_checkpoints_expr(match_case.body),
		})

	result


private pure func insert_literal_match_fallback(
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(insert_cooperative_checkpoints_expr(body))
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func insert_constructor_match_cases(
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	var result: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		result = result.append({
			constructor = match_case.constructor,
			constructor_c_name = match_case.constructor_c_name,
			body = insert_cooperative_checkpoints_expr(match_case.body),
		})

	result


private pure func insert_constructor_match_fallback(
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(insert_cooperative_checkpoints_expr(body))
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


pure func insert_cooperative_checkpoints_expr(expr: CoreExpr) -> CoreExpr:
	match expr:
		LiteralExpr(literal, typ, loc):
			expr
		VarExpr(variable, typ, loc):
			expr
		VoidExpr(typ, loc):
			expr
		CooperativeCheckpointExpr(typ, loc):
			expr
		CallExpr(kind, callee, args, typ, loc):
			CallExpr(
				kind,
				insert_cooperative_checkpoints_expr(callee),
				insert_exprs(args),
				typ,
				loc,
			)
		BinaryExpr(op, left, right, typ, loc):
			BinaryExpr(
				op,
				insert_cooperative_checkpoints_expr(left),
				insert_cooperative_checkpoints_expr(right),
				typ,
				loc,
			)
		UnaryExpr(op, expr_value, typ, loc):
			UnaryExpr(op, insert_cooperative_checkpoints_expr(expr_value), typ, loc)
		LogicalExpr(op, left, right, typ, loc):
			LogicalExpr(
				op,
				insert_cooperative_checkpoints_expr(left),
				insert_cooperative_checkpoints_expr(right),
				typ,
				loc,
			)
		AssignExpr(variable, rhs, typ, loc):
			AssignExpr(variable, insert_cooperative_checkpoints_expr(rhs), typ, loc)
		CastExpr(expr_value, typ, loc):
			CastExpr(insert_cooperative_checkpoints_expr(expr_value), typ, loc)
		FieldExpr(expr_value, field_name, typ, loc):
			FieldExpr(insert_cooperative_checkpoints_expr(expr_value), field_name, typ, loc)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			TupleFieldExpr(insert_cooperative_checkpoints_expr(expr_value), field_index, typ, loc)
		TupleExpr(items, typ, loc):
			TupleExpr(insert_exprs(items), typ, loc)
		TupleConstructExpr(elements, typ, loc):
			TupleConstructExpr(insert_tuple_elements(elements), typ, loc)
		ListConstructExpr(construct, typ, loc):
			ListConstructExpr(insert_list_construct(construct), typ, loc)
		RecordExpr(fields, typ, loc):
			RecordExpr(insert_record_fields(fields), typ, loc)
		RecordConstructExpr(type_name, fields, typ, loc):
			RecordConstructExpr(type_name, insert_record_fields(fields), typ, loc)
		UnionConstructExpr(construct, typ, loc):
			UnionConstructExpr(
				{
					type_name = construct.type_name,
					constructor_name = construct.constructor_name,
					constructor_c_name = construct.constructor_c_name,
					representation = construct.representation,
					args = insert_exprs(construct.args)
				},
				typ,
				loc,
			)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			DupExpr(
				variable,
				value_type,
				retain_policy,
				insert_cooperative_checkpoints_expr(body),
				typ,
				loc,
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				variable,
				value_type,
				release_policy,
				insert_cooperative_checkpoints_expr(body),
				typ,
				loc,
			)
		LetExpr(name, is_mutable, typ, rhs, body):
			LetExpr(
				name,
				is_mutable,
				typ,
				insert_cooperative_checkpoints_expr(rhs),
				insert_cooperative_checkpoints_expr(body),
			)
		SeqExpr(first, second):
			SeqExpr(
				insert_cooperative_checkpoints_expr(first),
				insert_cooperative_checkpoints_expr(second),
			)
		WhileExpr(cond, body, typ, loc):
			checked_body: CoreExpr = checkpoint_loop_body(
				loc,
				insert_cooperative_checkpoints_expr(body),
			)
			WhileExpr(insert_cooperative_checkpoints_expr(cond), checked_body, typ, loc)
		BreakExpr(typ, loc):
			expr
		ContinueExpr(typ, loc):
			expr
		ResourceScopeExpr(scope, typ, loc):
			ResourceScopeExpr(
				{
					variable = scope.variable,
					typ = scope.typ,
					acquire = insert_cooperative_checkpoints_expr(scope.acquire),
					body = insert_cooperative_checkpoints_expr(scope.body),
					cleanup = insert_cooperative_checkpoints_expr(scope.cleanup)
				},
				typ,
				loc,
			)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			ResourceCleanupExitExpr(
				{
					cleanups = insert_exprs(cleanup_exit.cleanups),
					exit = cleanup_exit.exit
				},
				typ,
				loc,
			)
		TailrecLoopExpr(params, return_type, body, loc):
			checked_body: CoreExpr = checkpoint_loop_body(
				loc,
				insert_cooperative_checkpoints_expr(body),
			)
			TailrecLoopExpr(params, return_type, checked_body, loc)
		TailrecRecurExpr(args, typ, loc):
			TailrecRecurExpr(insert_exprs(args), typ, loc)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			checked_body: CoreExpr = checkpoint_loop_body(
				loc,
				insert_cooperative_checkpoints_expr(body),
			)
			ForRangeExpr(
				binder,
				insert_cooperative_checkpoints_expr(start),
				insert_cooperative_checkpoints_expr(end_value),
				checked_body,
				typ,
				loc,
			)
		RangeExpr(start, end_value, typ, loc):
			RangeExpr(
				insert_cooperative_checkpoints_expr(start),
				insert_cooperative_checkpoints_expr(end_value),
				typ,
				loc,
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			LiteralMatchExpr(
				insert_cooperative_checkpoints_expr(scrutinee),
				insert_literal_match_cases(cases),
				insert_literal_match_fallback(fallback),
				typ,
				loc,
			)
		ConstructorMatchExpr(scrutinee, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				insert_cooperative_checkpoints_expr(scrutinee),
				insert_constructor_match_cases(cases),
				insert_constructor_match_fallback(fallback),
				typ,
				loc,
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				insert_cooperative_checkpoints_expr(cond),
				insert_cooperative_checkpoints_expr(then_expr),
				insert_cooperative_checkpoints_expr(else_expr),
				typ,
				loc,
			)


private pure func insert_function(func_info: CoreFunction) -> CoreFunction:
	match func_info.body:
		Some(body):
			{ func_info | body = Some(insert_cooperative_checkpoints_expr(body)) }
		None:
			func_info


private pure func insert_global(global: CoreGlobal) -> CoreGlobal:
	{ global | init = insert_cooperative_checkpoints_expr(global.init) }


private pure func insert_decl(decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(func_info):
			FunctionDecl(insert_function(func_info))
		GlobalDecl(global):
			GlobalDecl(insert_global(global))
		EnumDecl(enum_decl):
			EnumDecl(enum_decl)
		UnionDecl(union_decl):
			UnionDecl(union_decl)
		ValueRecordDecl(record_decl):
			ValueRecordDecl(record_decl)


pure func insert_cooperative_checkpoints(program: CoreProgram) -> CoreProgram:
	var decls: List[CoreDecl] = []

	for decl in program.decls:
		decls = decls.append(insert_decl(decl))

	{decls = decls}
