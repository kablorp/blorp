private union ClosureAbiValue:
	ClosureAbiVoid
	ClosureAbiPointer
	ClosureAbiPrim
	ClosureAbiFloat
	ClosureAbiFloat32
	ClosureAbiFloat16
	ClosureAbiInt128
	ClosureAbiUInt128
	ClosureAbiStruct(String)


private record ClosureArgBinding {
	name: String,
	statement: String,
	needs_release: Bool
}


private pure func function_kind_label(kind: CoreFunctionKind) -> String:
	match kind:
		UserFunction:
			"user"
		BuiltinFunction:
			"builtin"
		ForeignFunction:
			"foreign"
		ClosureBodyFunction(abi):
			"closure_body"


private pure func emit_function_inventory(func_info: CoreFunction) -> String:
	"/* function " + func_info.name + " kind=" + function_kind_label(
		func_info.function_kind,
	) + " def_id=" + func_info.def_id.to_string() + " */\n"


private pure func emit_unsupported_function_error(func_info: CoreFunction) -> String:
	"/* unsupported function " + func_info.name + " kind=" + function_kind_label(
		func_info.function_kind,
	) + " def_id=" + func_info.def_id.to_string() + " */\n#error \"Blorp backend could not emit function body: " + func_info.name + "\"\n"


private pure func is_entrypoint(func_info: CoreFunction) -> Bool:
	func_info.name == "main" and func_info.source_module == None


private pure func c_function_name(func_info: CoreFunction) -> String:
	func_info.name


private pure func stack_option_c_type(payload: CoreType) -> Option[String]:
	match payload:
		VoidType:
			Some("blorp_StackOption_Void")
		NamedType(name, args):
			if args.length() == 0:
				if name == "Int":
					Some("blorp_StackOption_Int")
				else if name == "Int8":
					Some("blorp_StackOption_Int8")
				else if name == "Int16":
					Some("blorp_StackOption_Int16")
				else if name == "Int32":
					Some("blorp_StackOption_Int32")
				else if name == "Int64":
					Some("blorp_StackOption_Int64")
				else if name == "UInt8":
					Some("blorp_StackOption_UInt8")
				else if name == "UInt16":
					Some("blorp_StackOption_UInt16")
				else if name == "UInt32":
					Some("blorp_StackOption_UInt32")
				else if name == "UInt64":
					Some("blorp_StackOption_UInt64")
				else if name == "Float":
					Some("blorp_StackOption_Float")
				else if name == "Float32":
					Some("blorp_StackOption_Float32")
				else if name == "Float16":
					Some("blorp_StackOption_Float16")
				else if name == "Bool":
					Some("blorp_StackOption_Bool")
				else if name == "Char":
					Some("blorp_StackOption_Char")
				else if name == "Int128":
					Some("blorp_StackOption_Int128")
				else if name == "UInt128":
					Some("blorp_StackOption_UInt128")
				else:
					None
			else:
				None
		EnumType(name):
			Some(generated_stack_option_c_type_name(name))
		ValueRecordType(name):
			Some(generated_stack_option_c_type_name(name))
		HeapRecordType(name):
			None
		UnionType(name):
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		RangeType:
			Some("blorp_StackOption_Range")
		TensorType:
			None
		TupleType(items):
			None


private pure func generated_stack_option_c_type_name(payload_name: String) -> String:
	if payload_name == "Range":
		"blorp_StackOption_RangeValue"
	else:
		"blorp_StackOption_" + payload_name


private pure func runtime_owned_stack_option_payload_name(name: String) -> Bool:
	(
		name == "Void"
		or name == "Int"
		or name == "Int8"
		or name == "Int16"
		or name == "Int32"
		or name == "Int64"
		or name == "UInt8"
		or name == "UInt16"
		or name == "UInt32"
		or name == "UInt64"
		or name == "Float"
		or name == "Float32"
		or name == "Float16"
		or name == "Bool"
		or name == "Char"
	)


private pure func is_closure_abi_prim_name(name: String) -> Bool:
	(
		name == "Int"
		or name == "Int8"
		or name == "Int16"
		or name == "Int32"
		or name == "Int64"
		or name == "UInt8"
		or name == "UInt16"
		or name == "UInt32"
		or name == "UInt64"
		or name == "Bool"
		or name == "Char"
	)


private pure func closure_abi_value_for_named_type(
	name: String,
	args: List[CoreType],
) -> Option[ClosureAbiValue]:
	if name == "Void" and args.length() == 0:
		Some(ClosureAbiVoid)
	else if is_closure_abi_prim_name(name) and args.length() == 0:
		Some(ClosureAbiPrim)
	else if name == "Float" and args.length() == 0:
		Some(ClosureAbiFloat)
	else if name == "Float32" and args.length() == 0:
		Some(ClosureAbiFloat32)
	else if name == "Float16" and args.length() == 0:
		Some(ClosureAbiFloat16)
	else if name == "Int128" and args.length() == 0:
		Some(ClosureAbiInt128)
	else if name == "UInt128" and args.length() == 0:
		Some(ClosureAbiUInt128)
	else if name == "Option":
		match args:
			[payload]:
				match stack_option_c_type(payload):
					Some(c_type):
						Some(ClosureAbiStruct(c_type))
					None:
						Some(ClosureAbiPointer)
			[]:
				None
			[first, second, ...rest]:
				None
	else if name == "Result":
		None
	else:
		Some(ClosureAbiPointer)


private pure func closure_abi_value_for_type(typ: CoreType) -> Option[ClosureAbiValue]:
	match typ:
		VoidType:
			Some(ClosureAbiVoid)
		NamedType(name, args):
			closure_abi_value_for_named_type(name, args)
		StackResultType(ok_type, err_type):
			Some(ClosureAbiStruct("blorp_StackResult"))
		BoxedResultType(ok_type, err_type):
			Some(ClosureAbiPointer)
		EnumType(name):
			Some(ClosureAbiPrim)
		ValueRecordType(name):
			Some(ClosureAbiStruct(name))
		HeapRecordType(name):
			Some(ClosureAbiPointer)
		UnionType(name):
			Some(ClosureAbiPointer)
		RangeType:
			Some(ClosureAbiPrim)
		TensorType:
			Some(ClosureAbiPointer)
		TupleType(items):
			Some(ClosureAbiPointer)


private pure func c_type_name(typ: CoreType) -> String:
	match typ:
		VoidType:
			"void"
		NamedType(name, args):
			if name == "Option":
				match args:
					[payload]:
						match stack_option_c_type(payload):
							Some(c_type):
								c_type
							None:
								"void*"
					[]:
						"void*"
					[first, second, ...rest]:
						"void*"
			else if name == "Result":
				match args:
					[ok_type, err_type]:
						"blorp_StackResult"
					[]:
						"void*"
					[only]:
						"void*"
					[first, second, third, ...rest]:
						"void*"
			else if name == "Int":
				"long"
			else if name == "Int8":
				"int8_t"
			else if name == "Int16":
				"int16_t"
			else if name == "Int32":
				"int32_t"
			else if name == "Int64":
				"long"
			else if name == "Int128":
				"__int128"
			else if name == "UInt8":
				"uint8_t"
			else if name == "UInt16":
				"uint16_t"
			else if name == "UInt32":
				"uint32_t"
			else if name == "UInt64":
				"uint64_t"
			else if name == "UInt128":
				"unsigned __int128"
			else if name == "Float":
				"double"
			else if name == "Float32":
				"float"
			else if name == "Float16":
				"_Float16"
			else if name == "Bool":
				"int"
			else if name == "Char":
				"int32_t"
			else if name == "String":
				"blorp_String*"
			else if name == "Bytes":
				"blorp_Bytes*"
			else if name == "Fixed":
				"blorp_Fixed*"
			else if name == "Closure":
				"blorp_Closure*"
			else if name == "Channel":
				"blorp_Channel*"
			else if name == "ResourceSource":
				"blorp_ResourceSource*"
			else if name == "Port" or name == "std/net/tcp::Port" or name == "std_net_tcp__Port":
				"long"
			else if name == "TcpListener" or name == "std/net/tcp::TcpListener" or name == "std_net_tcp__TcpListener":
				"blorp_TcpListener*"
			else if name == "TcpStream" or name == "std/net/tcp::TcpStream" or name == "std_net_tcp__TcpStream":
				"blorp_TcpStream*"
			else if name == "UdpSocket" or name == "std/net/udp::UdpSocket" or name == "std_net_udp__UdpSocket":
				"blorp_UdpSocket*"
			else if name == "List":
				"blorp_List*"
			else:
				"void*"
		StackResultType(ok_type, err_type):
			"blorp_StackResult"
		BoxedResultType(ok_type, err_type):
			"blorp_Result*"
		EnumType(name):
			"long"
		ValueRecordType(name):
			name
		HeapRecordType(name):
			name + "*"
		UnionType(name):
			name + "*"
		RangeType:
			"long"
		TensorType:
			"blorp_Vector*"
		TupleType(items):
			"blorp_Tuple*"


private pure func c_return_type(func_info: CoreFunction) -> String:
	if is_entrypoint(func_info):
		"int"
	else:
		c_type_name(func_info.return_type)


private pure func c_function_signature(func_info: CoreFunction) -> String:
	if is_entrypoint(func_info) and func_info.params.length() > 0:
		c_return_type(func_info) + " " + c_function_name(func_info) + "(int argc, char** argv)"
	else:
		c_return_type(
			func_info,
		) + " " + c_function_name(func_info) + "(" + c_param_list(func_info.params) + ")"


private pure func c_identifier(name: String) -> String:
	if C_RESERVED_IDENTIFIERS.contains(name):
		name + "_"
	else:
		name


private pure func c_var_name(variable: CoreVar) -> String:
	c_identifier(variable.name)


private pure func entrypoint_has_source_args(func_info: CoreFunction) -> Bool:
	is_entrypoint(func_info) and func_info.params.length() > 0


private pure func entrypoint_arg_name(func_info: CoreFunction) -> String:
	match func_info.params:
		[]:
			"args"
		[param, ...rest]:
			c_var_name(param.name)


private pure func entrypoint_arg_prelude(func_info: CoreFunction) -> String:
	if entrypoint_has_source_args(func_info):
		arg_name: String = entrypoint_arg_name(func_info)

		"  blorp_List* " + arg_name + " = blorp_list_new(argc);\n" + "  blorp_list_init_elem_release(" + arg_name + ", blorp_elem_release_fn);\n" + "  for (int __i = 0; __i < argc; __i++) " + arg_name + " = blorp_list_append_owned(" + arg_name + ", (void*)blorp_string_create(argv[__i]));\n"
	else:
		""


private pure func entrypoint_arg_cleanup(func_info: CoreFunction) -> String:
	if entrypoint_has_source_args(func_info):
		"  blorp_release(" + entrypoint_arg_name(func_info) + ");\n"
	else:
		""


private pure func c_param(param: CoreParam) -> String:
	c_type_name(param.typ) + " " + c_var_name(param.name)


private pure func c_param_list(params: List[CoreParam]) -> String:
	if params.length() == 0:
		"void"
	else:
		var result: String = ""
		var index: Int = 0

		for param in params:
			if index > 0:
				result += ", "

			result += c_param(param)
			index += 1

		result


private pure func is_void_type(typ: CoreType) -> Bool:
	match typ:
		VoidType:
			True
		NamedType(name, args):
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType:
			False
		TupleType(items):
			False


private pure func is_stack_result_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if name == "Result":
				match args:
					[first, second]:
						True
					[]:
						False
					[first]:
						False
					[first, second, third, ...rest]:
						False
			else:
				False
		StackResultType(ok_type, err_type):
			True
		BoxedResultType(ok_type, err_type):
			False
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType:
			False
		TupleType(items):
			False


private pure func is_void_expr(expr: CoreExpr) -> Bool:
	match expr:
		LiteralExpr(literal, typ, loc):
			False
		VarExpr(variable, typ, loc):
			False
		VoidExpr(typ, loc):
			True
		CooperativeCheckpointExpr(typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, expr_value, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(variable, rhs, typ, loc):
			False
		CastExpr(expr_value, typ, loc):
			False
		BoxExpr(box, typ, loc):
			False
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			False
		FieldExpr(expr_value, field_name, typ, loc):
			False
		TupleFieldExpr(expr_value, field_index, typ, loc):
			False
		TupleExpr(items, typ, loc):
			False
		TupleConstructExpr(tuple_construct, typ, loc):
			False
		ClosureCreateExpr(closure, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			False
		ListAllocExpr(alloc, typ, loc):
			False
		ListGetExpr(get, typ, loc):
			False
		ListHandoffExpr(handoff, typ, loc):
			False
		ListHandoffSetOwnedExpr(set, typ, loc):
			False
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			False
		StringByteReadExpr(read, typ, loc):
			False
		StringByteWriteExpr(write, typ, loc):
			False
		StringByteCopyExpr(copy, typ, loc):
			False
		StringSetLenExpr(set_len, typ, loc):
			False
		TensorLiteralExpr(literal, typ, loc):
			False
		TensorBoxedLiteralExpr(literal, typ, loc):
			False
		TensorPackedLiteralExpr(literal, typ, loc):
			False
		TensorRawFillExpr(fill, typ, loc):
			False
		TensorRawReadExpr(read, typ, loc):
			False
		TensorRawWriteExpr(write, typ, loc):
			False
		TensorRawViewLetExpr(binding, body, typ, loc):
			False
		DictConstructExpr(construct, typ, loc):
			False
		SetAllocExpr(alloc, typ, loc):
			False
		ListRetainExpr(retain, typ, loc):
			False
		ListSetExpr(set, typ, loc):
			False
		RecordExpr(fields, typ, loc):
			False
		RecordConstructExpr(type_name, fields, typ, loc):
			False
		UnionConstructExpr(construct, typ, loc):
			False
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			False
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			False
		LetExpr(name, is_mutable, typ, rhs, body):
			False
		SeqExpr(first, second):
			False
		WhileExpr(cond, body, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			False
		ForListExpr(for_list, typ, loc):
			False
		ForTensorExpr(for_tensor, typ, loc):
			False
		RangeExpr(start, end_value, typ, loc):
			False
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			False
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, default_body, typ, loc):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False


private pure func body_value(value: String, next_temp: Int) -> FunctionBodyC:
	{
		statements = "",
		value = value,
		next_temp = next_temp,
		returns = False
	}


private pure func discard_body(body: FunctionBodyC) -> String:
	if body.value == "":
		body.statements
	else:
		body.statements + "  " + body.value + ";\n"


private pure func type_requires_release(typ: CoreType) -> Bool:
	match typ:
		TupleType(items):
			True
		UnionType(name):
			True
		VoidType:
			False
		NamedType(name, args):
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			True
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			True
		RangeType:
			False
		TensorType:
			True


private pure func boxed_value_needs_release_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if name == "String" and args.length() == 0:
				True
			else if name == "Bytes" and args.length() == 0:
				True
			else if name == "Fixed" and args.length() == 0:
				True
			else if name == "Closure" and args.length() == 0:
				True
			else if name == "List" and args.length() == 1:
				True
			else if name == "Dict" and args.length() == 2:
				True
			else if name == "Set" and args.length() == 1:
				True
			else if name == "Channel" and args.length() == 1:
				True
			else if name == "ResourceSource" and args.length() == 1:
				True
			else if name == "TcpListener" and args.length() == 0:
				True
			else if name == "TcpStream" and args.length() == 0:
				True
			else if name == "UdpSocket" and args.length() == 0:
				True
			else:
				False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			True
		HeapRecordType(name):
			True
		UnionType(name):
			True
		TupleType(items):
			True
		TensorType:
			True
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False


private pure func channel_element_type(typ: CoreType) -> Option[CoreType]:
	match typ:
		NamedType(name, args):
			if name == "Channel":
				match args:
					[elem_type]:
						Some(elem_type)
					[]:
						None
					[first, second, ...rest]:
						None
			else:
				None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		TupleType(items):
			None
		TensorType:
			None
		VoidType:
			None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		RangeType:
			None


private pure func discard_expr_body(expr: CoreExpr, body: FunctionBodyC) -> String:
	if body.value == "":
		body.statements
	else if type_requires_release(core_expr_type(expr)):
		body.statements + "  blorp_release(" + body.value + ");\n"
	else:
		discard_body(body)


private pure func statement_body(expr: CoreExpr, body: FunctionBodyC) -> String:
	if is_void_expr(expr):
		body.statements
	else:
		discard_expr_body(expr, body)


private pure func required_body_value(body: FunctionBodyC) -> Option[String]:
	if body.value == "":
		None
	else:
		Some(body.value)


private pure func statement_expression(statements: String, value: String) -> String:
	"({\n" + indent_statements(statements) + "  " + value + ";\n})"


private pure func emit_condition(cond: CoreExpr, next_temp: Int) -> Option[ConditionC]:
	match emit_simple_expr(cond):
		Some(cond_c):
			Some({
				statements = "",
				value = cond_c,
				next_temp = next_temp,
			})
		None:
			cond_body ?= emit_function_body(cond, next_temp)
			cond_value ?= required_body_value(cond_body)
			cond_temp: String = temp_name("cond", cond_body.next_temp)
			Some({
				statements = cond_body.statements + "  bool " + cond_temp + " = " + cond_value + ";\n",
				value = cond_temp,
				next_temp = cond_body.next_temp + 1,
			})


private pure func indent_statements(statements: String) -> String:
	if statements == "":
		""
	else:
		var result: String = ""

		for line in statements.split("\n"):
			if line.length() > 0:
				result += "  " + line + "\n"

		result


private pure func temp_name(prefix: String, index: Int) -> String:
	"__" + prefix + "_" + index.to_string()


private pure func core_vars_equal(left: CoreVar, right: CoreVar) -> Bool:
	left.name == right.name and left.uniq == right.uniq and left.def_id == right.def_id


private pure func emit_temp_value_body(
	prefix: String,
	value_type: CoreType,
	statements: String,
	value: String,
	next_temp: Int,
) -> FunctionBodyC:
	temp: String = temp_name(prefix, next_temp)
	{
		statements = statements + "  " + c_type_name(
			value_type,
		) + " " + temp + " = " + value + ";\n",
		value = temp,
		next_temp = next_temp + 1,
		returns = False
	}


private pure func emit_binary_body(
	op: CoreBinaryOp,
	left: CoreExpr,
	right: CoreExpr,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	left_c ?= emit_function_body(left, next_temp)
	left_value ?= required_body_value(left_c)
	right_c ?= emit_function_body(right, left_c.next_temp)
	right_value ?= required_body_value(right_c)
	value ?= c_binary_expr(op, left, right, left_value, right_value)

	Some(
		emit_temp_value_body(
			"bin_result",
			typ,
			left_c.statements + right_c.statements,
			value,
			right_c.next_temp,
		),
	)


private pure func emit_unary_body(
	op: CoreUnaryOp,
	expr_value: CoreExpr,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	expr_c ?= emit_function_body(expr_value, next_temp)
	value ?= required_body_value(expr_c)

	Some(
		emit_temp_value_body(
			"unary_result",
			typ,
			expr_c.statements,
			"(" + c_unary_operator(op) + value + ")",
			expr_c.next_temp,
		),
	)


private pure func emit_cast_body(
	expr_value: CoreExpr,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	expr_c ?= emit_function_body(expr_value, next_temp)
	value ?= required_body_value(expr_c)

	Some(
		emit_temp_value_body(
			"cast_result",
			typ,
			expr_c.statements,
			"((" + c_type_name(typ) + ")" + value + ")",
			expr_c.next_temp,
		),
	)


private pure func emit_logical_body(
	op: CoreLogicalOp,
	left: CoreExpr,
	right: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	left_c ?= emit_condition(left, next_temp)
	result_name: String = temp_name("logical_result", left_c.next_temp)
	right_c ?= emit_condition(right, left_c.next_temp + 1)
	var statements: String = left_c.statements + "  int " + result_name + ";\n"

	match op:
		AndOp:
			statements += "  if (" + left_c.value + ") {\n" + indent_statements(
				right_c.statements + "  " + result_name + " = " + right_c.value + ";\n",
			) + "  } else {\n    " + result_name + " = 0;\n  }\n"
		OrOp:
			statements += "  if (" + left_c.value + ") {\n    " + result_name + " = 1;\n  } else {\n" + indent_statements(
				right_c.statements + "  " + result_name + " = " + right_c.value + ";\n",
			) + "  }\n"

	Some({
		statements = statements,
		value = result_name,
		next_temp = right_c.next_temp,
		returns = False,
	})


private pure func cancellation_cleanup_pop_statement(variable: CoreVar) -> String:
	"  blorp_task_cleanup_pop_slot(&" + c_var_name(variable) + ");\n"


private pure func cleanup_frame_name(variable: CoreVar) -> String:
	"__blorp_cleanup_" + c_var_name(variable)


private pure func cleanup_release_fn(kind: CoreCallKind) -> Option[String]:
	match kind:
		UserCall(name, def_id):
			Some(name)
		BuiltinCall(name):
			Some(name)
		ForeignCall(name):
			Some(name)
		IntrinsicCall(name):
			None
		OperationResultCall(bridge):
			None
		ListToStringCall(callback_name):
			None
		ClosureCall:
			None


private pure func resource_cleanup_hook(cleanup: CoreExpr) -> Option[ResourceCleanupHook]:
	match cleanup:
		CallExpr(kind, callee, args, typ, loc):
			match args:
				[VarExpr(variable, var_type, var_loc)]:
					release_fn ?= cleanup_release_fn(kind)
					Some({
						variable = variable,
						release_fn = release_fn,
					})
				[]:
					None
				[first]:
					None
				[first, second, ...rest]:
					None
		LiteralExpr(literal, typ, loc):
			None
		VarExpr(variable, typ, loc):
			None
		VoidExpr(typ, loc):
			None
		CooperativeCheckpointExpr(typ, loc):
			None
		BinaryExpr(op, left, right, typ, loc):
			None
		UnaryExpr(op, expr_value, typ, loc):
			None
		LogicalExpr(op, left, right, typ, loc):
			None
		AssignExpr(variable, rhs, typ, loc):
			None
		CastExpr(expr_value, typ, loc):
			None
		BoxExpr(box, typ, loc):
			None
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			None
		FieldExpr(expr_value, field_name, typ, loc):
			None
		TupleFieldExpr(expr_value, field_index, typ, loc):
			None
		TupleExpr(items, typ, loc):
			None
		TupleConstructExpr(tuple_construct, typ, loc):
			None
		ClosureCreateExpr(closure, typ, loc):
			None
		ListConstructExpr(construct, typ, loc):
			None
		ListAllocExpr(alloc, typ, loc):
			None
		ListGetExpr(get, typ, loc):
			None
		ListHandoffExpr(handoff, typ, loc):
			None
		ListHandoffSetOwnedExpr(set, typ, loc):
			None
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			None
		StringByteReadExpr(read, typ, loc):
			None
		StringByteWriteExpr(write, typ, loc):
			None
		StringByteCopyExpr(copy, typ, loc):
			None
		StringSetLenExpr(set_len, typ, loc):
			None
		TensorLiteralExpr(literal, typ, loc):
			None
		TensorBoxedLiteralExpr(literal, typ, loc):
			None
		TensorPackedLiteralExpr(literal, typ, loc):
			None
		TensorRawFillExpr(fill, typ, loc):
			None
		TensorRawReadExpr(read, typ, loc):
			None
		TensorRawWriteExpr(write, typ, loc):
			None
		TensorRawViewLetExpr(binding, body, typ, loc):
			None
		DictConstructExpr(construct, typ, loc):
			None
		SetAllocExpr(alloc, typ, loc):
			None
		ListRetainExpr(retain, typ, loc):
			None
		ListSetExpr(set, typ, loc):
			None
		RecordExpr(fields, typ, loc):
			None
		RecordConstructExpr(type_name, fields, typ, loc):
			None
		UnionConstructExpr(construct, typ, loc):
			None
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			None
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			None
		LetExpr(name, is_mutable, typ, rhs, body):
			None
		SeqExpr(first, second):
			None
		WhileExpr(cond, body, typ, loc):
			None
		BreakExpr(typ, loc):
			None
		ContinueExpr(typ, loc):
			None
		ResourceScopeExpr(scope, typ, loc):
			None
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			None
		TailrecLoopExpr(params, return_type, body, loc):
			None
		TailrecRecurExpr(args, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			None
		ForListExpr(for_list, typ, loc):
			None
		ForTensorExpr(for_tensor, typ, loc):
			None
		RangeExpr(start, end_value, typ, loc):
			None
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			None
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			None
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			None
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			None
		IfExpr(cond, then_expr, else_expr, typ, loc):
			None


private pure func resource_cleanup_push_statement(scope: CoreResourceScope) -> Option[String]:
	hook ?= resource_cleanup_hook(scope.cleanup)

	if core_vars_equal(hook.variable, scope.variable):
		frame_name: String = cleanup_frame_name(scope.variable)
		resource_name: String = c_var_name(scope.variable)
		Some(
			"  blorp_CancelCleanupFrame " + frame_name + ";\n  blorp_task_cleanup_push(&" + frame_name + ", &" + resource_name + ", (void*)" + resource_name + ", (blorp_CancelCleanupFn)" + hook.release_fn + ");\n",
		)
	else:
		None


private pure func c_string_literal(text: String) -> String:
	var result: String = make_string(text.length() + 2)
	result = result.append_char('\"')
	var index: Int = 0

	while index < text.length():
		match text.get(index):
			Some(ch):
				code: Int = to_int(ch)

				if code == 0:
					result = result.append_char('\\')
					result = result.append_char('0')
					result = result.append_char('0')
					result = result.append_char('0')
				else if code == 34:
					result = result.append_char('\\')
					result = result.append_char('\"')
				else if code == 92:
					result = result.append_char('\\')
					result = result.append_char('\\')
				else if code == 10:
					result = result.append_char('\\')
					result = result.append_char('n')
				else if code == 13:
					result = result.append_char('\\')
					result = result.append_char('r')
				else if code == 9:
					result = result.append_char('\\')
					result = result.append_char('t')
				else:
					result = result.append_char(ch)
			None:
				void

		index += 1

	result.append_char('\"')


private pure func string_contains_nul(text: String) -> Bool:
	var found: Bool = False
	var index: Int = 0

	while index < text.length():
		if not found:
			match text.get(index):
				Some(ch):
					if to_int(ch) == 0:
						found = True
					else:
						void
				None:
					void

		index += 1

	found


private pure func emit_string_literal_expr(value: String) -> String:
	literal_c: String = c_string_literal(value)

	if string_contains_nul(value):
		"blorp_string_literal_len(" + literal_c + ", " + value
			.length()
			.to_string() + "L)"
	else:
		"blorp_string_literal(" + literal_c + ")"


private pure func c_float_literal(value: Float) -> String:
	raw: String = value.to_string()

	if (
		raw.contains(".")
		or raw.contains("e")
		or raw.contains("E")
	):
		raw
	else:
		raw + ".0"


private pure func emit_literal_expr(literal: CoreLiteral) -> Option[String]:
	match literal:
		IntLiteral(value):
			Some(value.to_string())
		WideIntLiteral(value):
			Some(value + "L")
		FloatLiteral(value):
			Some(c_float_literal(value))
		FloatTextLiteral(value):
			Some(value)
		FloatInfinityLiteral:
			Some("INFINITY")
		FloatNegInfinityLiteral:
			Some("-INFINITY")
		FloatNanLiteral:
			Some("NAN")
		BoolLiteral(value):
			if value:
				Some("1")
			else:
				Some("0")
		CharLiteral(value):
			Some(value.to_string())
		StringLiteral(value):
			Some(emit_string_literal_expr(value))


private pure func c_infix_expr(left_c: String, operator: String, right_c: String) -> String:
	"(" + left_c + " " + operator + " " + right_c + ")"


private pure func c_zero_guarded_arithmetic_expr(
	left_c: String,
	operator: String,
	right_c: String,
) -> String:
	"((" + right_c + ") == 0 ? 0 : (" + left_c + " " + operator + " " + right_c + "))"


private pure func is_string_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			(name == "String" or name == "LiteralString") and args.length() == 0
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType:
			False
		TupleType(items):
			False


private pure func is_float_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "Float" and args.length() == 0
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType:
			False
		TupleType(items):
			False


private pure func is_fixed_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "Fixed" and args.length() == 0
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType:
			False
		TupleType(items):
			False


private pure func fixed_binary_runtime(op: CoreBinaryOp) -> Option[FixedBinaryRuntime]:
	match op:
		AddOp:
			Some(FixedBinaryCall("blorp_fixed_add"))
		SubtractOp:
			Some(FixedBinaryCall("blorp_fixed_sub"))
		MultiplyOp:
			Some(FixedBinaryCall("blorp_fixed_mul"))
		DivideOp:
			Some(FixedBinaryCall("blorp_fixed_div"))
		EqualOp:
			Some(FixedBinaryCall("blorp_fixed_eq"))
		NotEqualOp:
			Some(FixedBinaryNegatedCall("blorp_fixed_eq"))
		LessOp:
			Some(FixedBinaryCall("blorp_fixed_lt"))
		LessEqualOp:
			Some(FixedBinaryCall("blorp_fixed_le"))
		GreaterOp:
			Some(FixedBinaryCall("blorp_fixed_gt"))
		GreaterEqualOp:
			Some(FixedBinaryCall("blorp_fixed_ge"))
		ModuloOp:
			None


private pure func render_fixed_binary_runtime(runtime: FixedBinaryRuntime, left_c: String, right_c: String) -> String:
	match runtime:
		FixedBinaryCall(name):
			name + "(" + left_c + ", " + right_c + ")"
		FixedBinaryNegatedCall(name):
			"(!" + name + "(" + left_c + ", " + right_c + "))"


private pure func list_equality_function(typ: CoreType) -> Option[String]:
	match typ:
		NamedType(name, args):
			if name == "List":
				match args:
					[elem_type]:
						if is_string_type(elem_type):
							Some("blorp_list_eq_string")
						else if is_float_type(elem_type):
							Some("blorp_list_eq_float")
						else:
							Some("blorp_list_eq")
					[]:
						None
					[first, second, ...rest]:
						None
			else:
				None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		VoidType:
			None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		RangeType:
			None
		TensorType:
			None
		TupleType(items):
			None


private pure func list_equality_binary_expr(
	op: CoreBinaryOp,
	left: CoreExpr,
	right: CoreExpr,
	left_c: String,
	right_c: String,
) -> Option[String]:
	match list_equality_function(core_expr_type(left)):
		Some(fn_name):
			match op:
				EqualOp:
					Some(fn_name + "(" + left_c + ", " + right_c + ")")
				NotEqualOp:
					Some("(!" + fn_name + "(" + left_c + ", " + right_c + "))")
				AddOp:
					None
				SubtractOp:
					None
				MultiplyOp:
					None
				DivideOp:
					None
				ModuloOp:
					None
				LessOp:
					None
				LessEqualOp:
					None
				GreaterOp:
					None
				GreaterEqualOp:
					None
		None:
			match list_equality_function(core_expr_type(right)):
				Some(fn_name):
					match op:
						EqualOp:
							Some(fn_name + "(" + left_c + ", " + right_c + ")")
						NotEqualOp:
							Some("(!" + fn_name + "(" + left_c + ", " + right_c + "))")
						AddOp:
							None
						SubtractOp:
							None
						MultiplyOp:
							None
						DivideOp:
							None
						ModuloOp:
							None
						LessOp:
							None
						LessEqualOp:
							None
						GreaterOp:
							None
						GreaterEqualOp:
							None
				None:
					None


private pure func c_binary_expr(
	op: CoreBinaryOp,
	left: CoreExpr,
	right: CoreExpr,
	left_c: String,
	right_c: String,
) -> Option[String]:
	if is_fixed_type(core_expr_type(left)) or is_fixed_type(core_expr_type(right)):
		runtime ?= fixed_binary_runtime(op)
		Some(render_fixed_binary_runtime(runtime, left_c, right_c))
	else if is_string_type(core_expr_type(left)) or is_string_type(core_expr_type(right)):
		match op:
			EqualOp:
				Some("blorp_string_eq(" + left_c + ", " + right_c + ")")
			NotEqualOp:
				Some("(!blorp_string_eq(" + left_c + ", " + right_c + "))")
			LessOp:
				Some("(blorp_string_compare(" + left_c + ", " + right_c + ") < 0)")
			LessEqualOp:
				Some("(blorp_string_compare(" + left_c + ", " + right_c + ") <= 0)")
			GreaterOp:
				Some("(blorp_string_compare(" + left_c + ", " + right_c + ") > 0)")
			GreaterEqualOp:
				Some("(blorp_string_compare(" + left_c + ", " + right_c + ") >= 0)")
			AddOp:
				None
			SubtractOp:
				None
			MultiplyOp:
				None
			DivideOp:
				None
			ModuloOp:
				None
	else:
		match list_equality_binary_expr(op, left, right, left_c, right_c):
			Some(expr):
				Some(expr)
			None:
				Some(c_primitive_binary_expr(op, left_c, right_c))


private pure func c_primitive_binary_expr(
	op: CoreBinaryOp,
	left_c: String,
	right_c: String,
) -> String:
	match op:
		AddOp:
			c_infix_expr(left_c, "+", right_c)
		SubtractOp:
			c_infix_expr(left_c, "-", right_c)
		MultiplyOp:
			c_infix_expr(left_c, "*", right_c)
		DivideOp:
			c_zero_guarded_arithmetic_expr(left_c, "/", right_c)
		ModuloOp:
			c_zero_guarded_arithmetic_expr(left_c, "%", right_c)
		EqualOp:
			c_infix_expr(left_c, "==", right_c)
		NotEqualOp:
			c_infix_expr(left_c, "!=", right_c)
		LessOp:
			c_infix_expr(left_c, "<", right_c)
		LessEqualOp:
			c_infix_expr(left_c, "<=", right_c)
		GreaterOp:
			c_infix_expr(left_c, ">", right_c)
		GreaterEqualOp:
			c_infix_expr(left_c, ">=", right_c)


private pure func c_unary_operator(op: CoreUnaryOp) -> String:
	match op:
		NegateOp:
			"-"
		NotOp:
			"!"


private pure func c_logical_operator(op: CoreLogicalOp) -> String:
	match op:
		AndOp:
			"&&"
		OrOp:
			"||"


private pure func emit_simple_expr_arg_values(args: List[CoreExpr]) -> Option[List[String]]:
	var result: List[String] = []
	var failed: Bool = False

	for arg in args:
		if not failed:
			match emit_simple_expr(arg):
				Some(arg_c):
					result = result.append(arg_c)
				None:
					failed = True

	if failed:
		None
	else:
		Some(result)


private pure func emit_simple_expr_args(args: List[CoreExpr]) -> Option[String]:
	arg_values ?= emit_simple_expr_arg_values(args)
	Some(arg_values.join(", "))


private pure func adapt_direct_call_result(call_c: String, typ: CoreType) -> String:
	if is_stack_result_type(typ):
		"blorp_stack_result_from_boxed((blorp_Result*)" + call_c + ")"
	else:
		call_c


private TENSOR_PARALLEL_UNARY_SEMANTIC_ARG_COUNT: Int = 3

private TENSOR_PARALLEL_UNARY_RUNTIME_ARG_COUNT: Int = 6

private TENSOR_PARALLEL_BINARY_SEMANTIC_ARG_COUNT: Int = 4

private TENSOR_PARALLEL_BINARY_RUNTIME_ARG_COUNT: Int = 7


private pure func is_unary_tensor_parallel_layout_builtin(name: String) -> Bool:
	(
		name == "blorp_matrix_map"
			or name == "blorp_matrix_map_indexed"
			or name == "blorp_vmap_parallel"
			or name == "blorp_vmap_indexed_parallel"
			or name == "blorp_mmap_parallel"
			or name == "blorp_mmap_indexed_parallel"
			or name == "blorp_mmap_flat_indexed_parallel"
	)


private pure func is_binary_tensor_parallel_layout_builtin(name: String) -> Bool:
	(
		name == "blorp_matrix_zip_map"
			or name == "blorp_vzip_parallel"
			or name == "blorp_mzip_parallel"
			or name == "blorp_mzip_indexed_parallel"
	)


private pure func tensor_parallel_layout_metadata_args() -> List[String]:
	[
		render_prepared_tensor_op(TensorStorageModePointer),
		render_prepared_tensor_op(TensorElementSizePointer),
		render_prepared_tensor_op(TensorCallbackResultBits),
	]


private pure func with_tensor_parallel_layout_metadata(args: List[String]) -> List[String]:
	var result: List[String] = args

	for metadata_arg in tensor_parallel_layout_metadata_args():
		result = result.append(metadata_arg)

	result


private pure func tensor_parallel_runtime_args(
	name: String,
	args: List[String],
) -> Option[List[String]]:
	if is_unary_tensor_parallel_layout_builtin(name):
		if args.length() == TENSOR_PARALLEL_UNARY_SEMANTIC_ARG_COUNT:
			Some(with_tensor_parallel_layout_metadata(args))
		else if args.length() == TENSOR_PARALLEL_UNARY_RUNTIME_ARG_COUNT:
			Some(args)
		else:
			None
	else if is_binary_tensor_parallel_layout_builtin(name):
		if args.length() == TENSOR_PARALLEL_BINARY_SEMANTIC_ARG_COUNT:
			Some(with_tensor_parallel_layout_metadata(args))
		else if args.length() == TENSOR_PARALLEL_BINARY_RUNTIME_ARG_COUNT:
			Some(args)
		else:
			None
	else:
		Some(args)


private pure func emit_direct_runtime_call(
	name: String,
	args: List[String],
	typ: CoreType,
) -> Option[String]:
	call_args ?= tensor_parallel_runtime_args(name, args)
	Some(adapt_direct_call_result(name + "(" + call_args.join(", ") + ")", typ))


private pure func result_type_payloads(typ: CoreType) -> Option[(CoreType, CoreType)]:
	match typ:
		StackResultType(ok_type, err_type):
			Some((ok_type, err_type))
		BoxedResultType(ok_type, err_type):
			Some((ok_type, err_type))
		NamedType(name, args):
			if name == "Result":
				match args:
					[ok_type, err_type]:
						Some((ok_type, err_type))
					[]:
						None
					[only]:
						None
					[first, second, third, ...rest]:
						None
			else:
				None
		VoidType:
			None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		RangeType:
			None
		TensorType:
			None
		TupleType(items):
			None


private pure func operation_result_uses_boxed_result(
	bridge: CoreOperationResultBridge,
	typ: CoreType,
) -> Bool:
	match typ:
		BoxedResultType(ok_type, err_type):
			True
		StackResultType(ok_type, err_type):
			False
		NamedType(name, args):
			match bridge.result_layout_policy:
				BoxedResultOnlyPolicy(hint):
					True
				DefaultResultLayoutPolicy:
					False
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType:
			False
		TupleType(items):
			False


private pure func payload_named_type_name(typ: CoreType) -> Option[String]:
	match typ:
		NamedType(name, args):
			Some(name)
		ValueRecordType(name):
			Some(name)
		HeapRecordType(name):
			Some(name)
		UnionType(name):
			Some(name)
		EnumType(name):
			Some(name)
		TensorType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		VoidType:
			Some("Void")
		RangeType:
			Some("Range")
		TupleType(items):
			None


private pure func runtime_union_release_mask(args: List[CoreRuntimeUnionArg]) -> Int:
	var mask: Int = 0
	var bit: Int = 1

	for arg in args:
		match arg:
			RuntimeOwnedField(field):
				mask += bit
			RuntimeIntField(field):
				void

		bit *= 2

	mask


private pure func runtime_union_arg_value(op_tmp: String, arg: CoreRuntimeUnionArg) -> String:
	match arg:
		RuntimeOwnedField(field):
			"(void*)" + op_tmp + "." + field
		RuntimeIntField(field):
			"(void*)(intptr_t)" + op_tmp + "." + field


private pure func runtime_union_arg_values(
	op_tmp: String,
	args: List[CoreRuntimeUnionArg],
) -> String:
	var values: List[String] = []

	for arg in args:
		values = values.append(runtime_union_arg_value(op_tmp, arg))

	values.join(", ")


private pure func emit_runtime_union_payload_expr(
	bridge: CoreOperationResultBridge,
	op_tmp: String,
	ok_type: CoreType,
	runtime_tag_field: String,
	cases: List[CoreRuntimeUnionCase],
	next_temp: Int,
) -> Option[String]:
	payload_type_name ?= payload_named_type_name(ok_type)
	payload_tmp: String = temp_name(bridge.temp_prefix + "_payload", next_temp)
	var c_code: String = "({ void* " + payload_tmp + " = NULL; switch (" + op_tmp + "." + runtime_tag_field + ") { "

	for case in cases:
		c_code += "case " + case.runtime_tag + ": " + payload_tmp + " = "

		match case.args:
			[]:
				c_code += "(void*)" + case.constructor_c_name
			[first, ...rest]:
				c_code += "(void*)" + case.constructor_c_name + "(" + runtime_union_arg_values(
					op_tmp,
					case.args,
				) + ", " + runtime_union_release_mask(case.args).to_string() + "UL)"

		c_code += "; break; "

	c_code += "default: " + payload_tmp + " = NULL; break; } " + payload_tmp + "; })"
	Some(c_code)


private pure func emit_operation_success_payload_expr(
	bridge: CoreOperationResultBridge,
	op_tmp: String,
	ok_type: CoreType,
	next_temp: Int,
) -> Option[String]:
	match bridge.success.runtime_payload:
		RuntimeNoPayload:
			Some("NULL")
		RuntimeField(field):
			Some("(void*)" + op_tmp + "." + field)
		RuntimeRecordFields(fields):
			payload_type_name ?= payload_named_type_name(ok_type)
			var values: List[String] = []

			for field in fields:
				values = values.append(op_tmp + "." + field)

			Some("(void*)" + payload_type_name + "_make(" + values.join(", ") + ")")
		RuntimeUnionPayload(runtime_tag_field, cases):
			emit_runtime_union_payload_expr(
				bridge,
				op_tmp,
				ok_type,
				runtime_tag_field,
				cases,
				next_temp,
			)


private pure func operation_error_switch_cases(
	bridge: CoreOperationResultBridge,
	op_tmp: String,
	err_tmp: String,
) -> String:
	var c_code: String = ""

	for case in bridge.error.cases:
		c_code += "case " + case.runtime_tag + ": " + err_tmp + " = " + case.constructor_c_name + "((void*)" + op_tmp + "." + bridge.error.detail_field + ", " + op_tmp + "." + bridge.error.detail_field + " ? 1UL : 0UL); break; "

	c_code


private pure func operation_other_error_expr(
	bridge: CoreOperationResultBridge,
	op_tmp: String,
) -> String:
	bridge.error.other_constructor_c_name + "((void*)" + op_tmp + "." + bridge.error.detail_field + ", " + op_tmp + "." + bridge.error.detail_field + " ? 1UL : 0UL)"


private pure func emit_boxed_operation_result_bridge_body(
	bridge: CoreOperationResultBridge,
	args_c: String,
	typ: CoreType,
	ok_type: CoreType,
	err_type: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	op_tmp: String = temp_name(bridge.temp_prefix + "_op", next_temp)
	result_tmp: String = temp_name(bridge.temp_prefix + "_result", next_temp + 1)
	err_tmp: String = temp_name(bridge.temp_prefix + "_error", next_temp + 2)
	ok_payload ?= emit_operation_success_payload_expr(bridge, op_tmp, ok_type, next_temp + 3)
	result_c: String = c_type_name(typ)
	err_c: String = c_type_name(err_type)

	ok_release_mask_statement: String = if bridge.success.release_mask == 1:
		" ((blorp_Result*)" + result_tmp + ")->release_mask = 1UL;"
	else:
		""

	value: String = "({ " + bridge.runtime_result_c_type + " " + op_tmp + " = " + bridge.runtime_c_name + "(" + args_c + "); " + result_c + " " + result_tmp + " = NULL; if (" + op_tmp + ".error_kind == " + bridge.error.none_tag + ") { " + result_tmp + " = (" + result_c + ")blorp_result_ok(" + ok_payload + ");" + ok_release_mask_statement + " } else { " + err_c + " " + err_tmp + " = NULL; switch (" + op_tmp + ".error_kind) { " + operation_error_switch_cases(
		bridge,
		op_tmp,
		err_tmp,
	) + "default: " + err_tmp + " = " + operation_other_error_expr(
		bridge,
		op_tmp,
	) + "; break; } " + result_tmp + " = (" + result_c + ")blorp_result_err((void*)" + err_tmp + "); ((blorp_Result*)" + result_tmp + ")->release_mask = 1UL; } " + result_tmp + "; })"

	Some(body_value(value, next_temp + 4))


private pure func emit_stack_operation_result_bridge_body(
	bridge: CoreOperationResultBridge,
	args_c: String,
	typ: CoreType,
	ok_type: CoreType,
	err_type: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	op_tmp: String = temp_name(bridge.temp_prefix + "_op", next_temp)
	result_tmp: String = temp_name(bridge.temp_prefix + "_result", next_temp + 1)
	err_tmp: String = temp_name(bridge.temp_prefix + "_error", next_temp + 2)
	ok_payload ?= emit_operation_success_payload_expr(bridge, op_tmp, ok_type, next_temp + 3)
	result_c: String = c_type_name(typ)
	err_c: String = c_type_name(err_type)

	value: String = "({ " + bridge.runtime_result_c_type + " " + op_tmp + " = " + bridge.runtime_c_name + "(" + args_c + "); " + result_c + " " + result_tmp + "; if (" + op_tmp + ".error_kind == " + bridge.error.none_tag + ") { " + result_tmp + " = ((" + result_c + "){ .tag = BLORP_TAG_OK, .release_mask = " + bridge.success.release_mask.to_string() + "UL, .data.Ok.field0 = " + ok_payload + " }); } else { " + err_c + " " + err_tmp + " = NULL; switch (" + op_tmp + ".error_kind) { " + operation_error_switch_cases(
		bridge,
		op_tmp,
		err_tmp,
	) + "default: " + err_tmp + " = " + operation_other_error_expr(
		bridge,
		op_tmp,
	) + "; break; } " + result_tmp + " = ((" + result_c + "){ .tag = BLORP_TAG_ERR, .release_mask = 1UL, .data.Err.field0 = (void*)" + err_tmp + " }); } " + result_tmp + "; })"

	Some(body_value(value, next_temp + 4))


private pure func emit_operation_result_bridge_body(
	bridge: CoreOperationResultBridge,
	args: List[CoreExpr],
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	payloads ?= result_type_payloads(typ)
	args_c ?= emit_simple_expr_args(args)

	if operation_result_uses_boxed_result(bridge, typ):
		emit_boxed_operation_result_bridge_body(
			bridge,
			args_c,
			typ,
			payloads[0],
			payloads[1],
			next_temp,
		)
	else:
		emit_stack_operation_result_bridge_body(
			bridge,
			args_c,
			typ,
			payloads[0],
			payloads[1],
			next_temp,
		)


private pure func emit_prepared_list_intrinsic_call(
	name: String,
	arg_values: List[String],
) -> Option[String]:
	if name == "list_ensure_unique":
		match arg_values:
			[list]:
				Some(render_prepared_list_op(EnsureUnique({
					list = list,
					temp_seed = LIST_ENSURE_TEMP_SEED,
				})))
			[]:
				None
			[first, second, ...rest]:
				None
	else if name == "list_ensure_capacity":
		match arg_values:
			[list, capacity]:
				Some(render_prepared_list_op(EnsureCapacity({
					list = list,
					capacity = capacity,
					temp_seed = LIST_ENSURE_TEMP_SEED,
				})))
			[]:
				None
			[first]:
				None
			[first, second]:
				None
			[first, second, third, ...rest]:
				None
	else if name == "list_copy_span_uninit":
		match arg_values:
			[dst, dst_start, src, src_start, count]:
				Some(render_prepared_list_op(CopySpanUninit({
					dst = dst,
					dst_start = dst_start,
					src = src,
					src_start = src_start,
					count = count
				})))
			[]:
				None
			[first]:
				None
			[first, second]:
				None
			[first, second, third]:
				None
			[first, second, third, fourth]:
				None
			[first, second, third, fourth, fifth, ...rest]:
				None
	else:
		None


private pure func emit_prepared_tensor_intrinsic_call(
	name: String,
	arg_values: List[String],
) -> Option[String]:
	match arg_values:
		[tensor]:
			args: StorageCheckArgs = {
				tensor = tensor,
				temp_seed = TENSOR_STORAGE_CHECK_TEMP_SEED
			}

			if name == "tensor_is_word_storage":
				Some(render_prepared_tensor_op(WordStorageCheck(args)))
			else if name == "tensor_is_f64_storage":
				Some(render_prepared_tensor_op(F64StorageCheck(args)))
			else if name == "tensor_is_f32_storage":
				Some(render_prepared_tensor_op(F32StorageCheck(args)))
			else if name == "tensor_is_i64_storage":
				Some(render_prepared_tensor_op(I64StorageCheck(args)))
			else:
				None
		[]:
			None
		[first, second, ...rest]:
			None


private pure func tensor_fill_dim_args(dim_values: List[String]) -> String:
	if dim_values.length() == 0:
		""
	else:
		", " + dim_values.join(", ")


private pure func emit_tensor_fill_inline_struct_call(
	name: String,
	args: List[CoreExpr],
) -> Option[String]:
	if name == "blorp_vector_new_fill" or name == "blorp_matrix_new_fill":
		match args:
			[BoxExpr(box, box_type, box_loc), ...dims]:
				match box.kind:
					StructBox(c_type):
						value_c ?= emit_simple_expr(box.value)
						dim_values ?= emit_simple_expr_arg_values(dims)
						fill_args: TensorFillInlineStructArgs = {
							function_name = name,
							value = value_c,
							dim_args = tensor_fill_dim_args(dim_values),
							temp_seed = TENSOR_FILL_TEMP_SEED,
							struct_ty = c_type
						}

						Some(render_prepared_tensor_op(TensorFillInlineStruct(fill_args)))
					VoidBox:
						None
					FloatBox:
						None
					Float32Box:
						None
					Float16Box:
						None
					Int128Box:
						None
					UInt128Box:
						None
					PrimBox:
						None
					PointerBox:
						None
			[]:
				None
			[first, ...rest]:
				None
	else:
		None


private pure func packed_tensor_fill_alloc_expr(
	dim_values: List[String],
	elem_size: String,
) -> Option[String]:
	match dim_values:
		[size]:
			Some(render_prepared_tensor_op(TensorAllocPacked({
				size = size,
				elem_size = elem_size,
			})))
		[rows, cols]:
			total_expr: String = render_prepared_tensor_op(TensorFillProductExpr(rows, cols))
			Some(render_prepared_tensor_op(TensorRankedAllocPacked({
				first_dim = rows,
				total_dim = total_expr,
				elem_size = elem_size,
			})))
		[]:
			None
		[first, second, third, ...rest]:
			None


private pure func render_tensor_fill_packed_values(
	value: String,
	dim_values: List[String],
	elem_size: String,
	dim_bindings: String,
	temp_seed: String,
) -> Option[String]:
	total_expr: String = tensor_raw_fill_total_expr(dim_values)
	alloc_expr ?= packed_tensor_fill_alloc_expr(dim_values, elem_size)
	args: TensorFillPackedArgs = {
		dim_bindings = dim_bindings,
		total_expr = total_expr,
		value = value,
		alloc_expr = alloc_expr,
		temp_seed = temp_seed
	}

	Some(render_prepared_tensor_op(TensorFillPacked(args)))


private pure func emit_tensor_fill_packed_expr(
	value_expr: CoreExpr,
	dims: List[CoreExpr],
	elem_size_expr: CoreExpr,
) -> Option[String]:
	dim_bindings ?= tensor_raw_fill_dim_bindings(TENSOR_PACKED_FILL_TEMP_SEED, dims)
	dim_names: List[String] = tensor_raw_fill_dim_names(TENSOR_PACKED_FILL_TEMP_SEED, dims)
	value ?= emit_simple_expr(tensor_raw_fill_value_expr(value_expr))
	elem_size ?= emit_simple_expr(elem_size_expr)

	render_tensor_fill_packed_values(
		value,
		dim_names,
		elem_size,
		dim_bindings,
		TENSOR_PACKED_FILL_TEMP_SEED,
	)


private pure func emit_tensor_fill_packed_call(
	name: String,
	args: List[CoreExpr],
) -> Option[String]:
	if name == "blorp_vector_new_fill_packed":
		match args:
			[value_expr, size_expr, elem_size_expr]:
				emit_tensor_fill_packed_expr(value_expr, [size_expr], elem_size_expr)
			[]:
				None
			[first]:
				None
			[first, second]:
				None
			[first, second, third]:
				None
			[first, second, third, fourth, ...rest]:
				None
	else if name == "blorp_matrix_new_fill_packed":
		match args:
			[value_expr, rows_expr, cols_expr, elem_size_expr]:
				emit_tensor_fill_packed_expr(
					value_expr,
					[rows_expr, cols_expr],
					elem_size_expr,
				)
			[]:
				None
			[first]:
				None
			[first, second]:
				None
			[first, second, third]:
				None
			[first, second, third, fourth, fifth, ...rest]:
				None
	else:
		None


private pure func box_kind_needs_release(kind: CoreBoxKind) -> Bool:
	match kind:
		VoidBox:
			False
		FloatBox:
			True
		Float32Box:
			True
		Float16Box:
			True
		Int128Box:
			True
		UInt128Box:
			True
		PrimBox:
			False
		PointerBox:
			False
		StructBox(c_type):
			True


private pure func boxed_fill_value_expr(
	kind: CoreBoxKind,
	source_type: CoreType,
	raw_value: String,
) -> Option[String]:
	boxed_pointer_value_from_c(kind, source_type, raw_value)


private pure func emit_boxed_vector_fill_call(box: CoreBoxOp, size: CoreExpr) -> Option[String]:
	value_c ?= emit_simple_expr(box.value)
	size_c ?= emit_simple_expr(size)
	value_type: String = c_type_name(box.source_type)
	value_name: String = "__fill_value_" + TENSOR_FILL_TEMP_SEED
	size_name: String = "__fill_size_" + TENSOR_FILL_TEMP_SEED
	vector_name: String = "__fill_vector_" + TENSOR_FILL_TEMP_SEED
	index_name: String = "__fill_index_" + TENSOR_FILL_TEMP_SEED
	boxed_value ?= boxed_fill_value_expr(box.kind, box.source_type, value_name)
	release_init: String = if box_kind_needs_release(box.kind):
		" blorp_vector_init_elem_release(" + vector_name + ", blorp_elem_release_fn);"
	else:
		""

	Some(
		"({ " + value_type + " " + value_name + " = " + value_c + "; long " + size_name + " = " + size_c + "; blorp_Vector* " + vector_name + " = blorp_vector_new(" + size_name + ");" + release_init + " for (long " + index_name + " = 0; " + index_name + " < " + size_name + "; " + index_name + "++) { " + vector_name + "->data[" + index_name + "] = " + boxed_value + "; } " + vector_name + "; })",
	)


private pure func emit_boxed_matrix_fill_call(
	box: CoreBoxOp,
	rows: CoreExpr,
	cols: CoreExpr,
) -> Option[String]:
	value_c ?= emit_simple_expr(box.value)
	rows_c ?= emit_simple_expr(rows)
	cols_c ?= emit_simple_expr(cols)
	value_type: String = c_type_name(box.source_type)
	value_name: String = "__fill_value_" + TENSOR_FILL_TEMP_SEED
	rows_name: String = "__fill_rows_" + TENSOR_FILL_TEMP_SEED
	cols_name: String = "__fill_cols_" + TENSOR_FILL_TEMP_SEED
	total_name: String = "__fill_total_" + TENSOR_FILL_TEMP_SEED
	vector_name: String = "__fill_vector_" + TENSOR_FILL_TEMP_SEED
	index_name: String = "__fill_index_" + TENSOR_FILL_TEMP_SEED
	boxed_value ?= boxed_fill_value_expr(box.kind, box.source_type, value_name)
	release_init: String = if box_kind_needs_release(box.kind):
		" blorp_vector_init_elem_release(" + vector_name + ", blorp_elem_release_fn);"
	else:
		""

	Some(
		"({ " + value_type + " " + value_name + " = " + value_c + "; long " + rows_name + " = " + rows_c + "; long " + cols_name + " = " + cols_c + "; long " + total_name + " = (long)blorp_checked_mul(" + rows_name + ", " + cols_name + "); blorp_Vector* " + vector_name + " = blorp_tensor_new(" + rows_name + ", " + total_name + ");" + release_init + " for (long " + index_name + " = 0; " + index_name + " < " + total_name + "; " + index_name + "++) { " + vector_name + "->data[" + index_name + "] = " + boxed_value + "; } " + vector_name + "; })",
	)


private pure func emit_boxed_tensor_fill_call(
	name: String,
	args: List[CoreExpr],
) -> Option[String]:
	if name == "blorp_vector_new_fill":
		match args:
			[BoxExpr(box, box_type, box_loc), size]:
				emit_boxed_vector_fill_call(box, size)
			[]:
				None
			[first]:
				None
			[first, second]:
				None
			[first, second, third, ...rest]:
				None
	else if name == "blorp_matrix_new_fill":
		match args:
			[BoxExpr(box, box_type, box_loc), rows, cols]:
				emit_boxed_matrix_fill_call(box, rows, cols)
			[]:
				None
			[first]:
				None
			[first, second]:
				None
			[first, second, third]:
				None
			[first, second, third, fourth, ...rest]:
				None
	else:
		None


private pure func emit_tensor_fill_packed_from_values(
	name: String,
