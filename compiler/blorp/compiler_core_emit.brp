private pure func emit_global_decl(global: CoreGlobal) -> String:
	match emit_global_static_init_expr(global.init):
		Some(init_c):
			"static " + c_type_name(
				global.typ,
			) + " " + c_var_name(global.name) + " = " + init_c + ";\n\n"
		None:
			"static " + c_type_name(global.typ) + " " + c_var_name(global.name) + ";\n\n"


private pure func global_needs_runtime_init(global: CoreGlobal) -> Bool:
	match emit_global_static_init_expr(global.init):
		Some(init_c):
			False
		None:
			True


private pure func emit_global_runtime_init_body(
	global: CoreGlobal,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	init_body ?= emit_function_body(global.init, next_temp)

	if init_body.returns:
		None
	else:
		init_value ?= required_body_value(init_body)
		Some({
			statements = init_body.statements + "  " + c_var_name(
				global.name,
			) + " = " + init_value + ";\n",
			value = "",
			next_temp = init_body.next_temp,
			returns = False,
		})


private pure func c_value_record_field_decl(field: CoreValueRecordField) -> String:
	c_type_name(field.typ) + " " + c_identifier(field.name) + "; "


private pure func c_value_record_make_param(field: CoreValueRecordField) -> String:
	c_type_name(field.typ) + " " + c_identifier(field.name)


private pure func emit_value_record_decl(record_decl: CoreValueRecordDecl) -> String:
	var fields_c: String = ""
	var params: List[String] = []
	var init_fields: List[String] = []

	for field in record_decl.fields:
		fields_c += c_value_record_field_decl(field)
		params = params.append(c_value_record_make_param(field))
		init_fields = init_fields.append(c_identifier(field.name))

	param_c: String = if params.length() == 0:
		"void"
	else:
		params.join(", ")

	"typedef struct { " + fields_c + "} " + record_decl.name + ";\nstatic inline " + record_decl.name + " " + record_decl.name + "_make(" + param_c + ") { " + record_decl.name + " __r = { " + init_fields.join(
		", ",
	) + " }; return __r; }\n\n"


private pure func heap_record_field_decl(field: CoreHeapRecordField) -> String:
	"  " + c_type_name(field.typ) + " " + c_identifier(field.name) + ";\n"


private pure func heap_record_make_param(field: CoreHeapRecordField) -> String:
	c_type_name(field.typ) + " " + c_identifier(field.name)


private pure func heap_record_field_release_statement(field: CoreHeapRecordField) -> String:
	field_name: String = c_identifier(field.name)

	match field.release_policy:
		NoReleasePolicy:
			""
		ArcReleasePolicy:
			"  if (__rec->" + field_name + ") blorp_release((blorp_Object*)__rec->" + field_name + ");\n"
		ArcReleaseOnlyPolicy:
			"  if (__rec->" + field_name + ") blorp_release_arc_only(__rec->" + field_name + ");\n"
		StackResultReleasePolicy:
			"  blorp_stack_result_release(__rec->" + field_name + ");\n"


private pure func heap_record_has_destructor(record_decl: CoreHeapRecordDecl) -> Bool:
	var has_destructor: Bool = False

	for field in record_decl.fields:
		match field.release_policy:
			NoReleasePolicy:
				void
			ArcReleasePolicy:
				has_destructor = True
			ArcReleaseOnlyPolicy:
				has_destructor = True
			StackResultReleasePolicy:
				has_destructor = True

	has_destructor


private pure func emit_heap_record_destructor(record_decl: CoreHeapRecordDecl) -> String:
	if heap_record_has_destructor(record_decl):
		var releases: String = ""

		for field in record_decl.fields:
			releases += heap_record_field_release_statement(field)

		"static void " + record_decl.name + "_destroy(void* obj) {\n" + "  " + record_decl.name + "* __rec = (" + record_decl.name + "*)obj;\n" + releases + "}\n\n"
	else:
		""


private pure func emit_heap_record_decl(record_decl: CoreHeapRecordDecl) -> String:
	var fields_c: String = ""
	var params: List[String] = []
	var assignments: String = ""

	for field in record_decl.fields:
		field_name: String = c_identifier(field.name)
		fields_c += heap_record_field_decl(field)
		params = params.append(heap_record_make_param(field))
		assignments += "  __rec->" + field_name + " = " + field_name + ";\n"

	param_c: String = if params.length() == 0:
		"void"
	else:
		params.join(", ")

	destructor_init: String = if heap_record_has_destructor(record_decl):
		"  BLORP_SET_DESTRUCTOR(__rec, " + record_decl.name + "_destroy);\n"
	else:
		""

	"struct " + record_decl.name + " {\n" + "  blorp_Object header;\n" + fields_c + "};\n\n" + emit_heap_record_destructor(
		record_decl,
	) + record_decl.name + "* " + record_decl.name + "_make(" + param_c + ") {\n" + "  " + record_decl.name + "* __rec = (" + record_decl.name + "*)blorp_alloc(sizeof(" + record_decl.name + "));\n" + "  BLORP_TAG(__rec, \"" + record_decl.name + "\");\n" + destructor_init + assignments + "  return __rec;\n}\n\n"


private pure func release_policy_requires_release(policy: CoreReleasePolicy) -> Bool:
	match policy:
		NoReleasePolicy:
			False
		ArcReleasePolicy:
			True
		ArcReleaseOnlyPolicy:
			True
		StackResultReleasePolicy:
			True


private pure func union_field_storage_type(
	payload_storage: CoreUnionPayloadStorage,
	field: CoreUnionField,
) -> String:
	match payload_storage:
		TypedUnionPayloadStorage:
			c_type_name(field.typ)
		ErasedUnionPayloadStorage:
			"void*"


private pure func c_union_variant_field_decl(
	payload_storage: CoreUnionPayloadStorage,
	field: CoreUnionField,
	index: Int,
) -> String:
	union_field_storage_type(payload_storage, field) + " field" + index.to_string() + "; "


private pure func emit_union_variant_storage(
	union_decl: CoreUnionDecl,
	variant: CoreUnionVariant,
) -> String:
	if variant.fields.length() == 0:
		"    char " + variant.name + ";\n"
	else:
		var fields_c: String = ""
		var index: Int = 0

		for field in variant.fields:
			fields_c += c_union_variant_field_decl(union_decl.payload_storage, field, index)
			index += 1

		"    struct { " + fields_c + "} " + variant.name + ";\n"


private pure func emit_union_variant_tag(variant: CoreUnionVariant) -> String:
	"#define " + variant.tag_c_name + " " + variant.tag.to_string() + "\n"


private pure func union_singleton_instance_name(variant: CoreUnionVariant) -> String:
	"__instance_" + variant.c_name


private pure func union_singleton_init_name(variant: CoreUnionVariant) -> String:
	"__init_" + variant.c_name


private pure func emit_union_constructor_param(
	payload_storage: CoreUnionPayloadStorage,
	field: CoreUnionField,
	index: Int,
) -> String:
	union_field_storage_type(payload_storage, field) + " field" + index.to_string()


private pure func union_variant_has_releasable_field(variant: CoreUnionVariant) -> Bool:
	var has_releasable_field: Bool = False

	for field in variant.fields:
		if release_policy_requires_release(field.release_policy):
			has_releasable_field = True

	has_releasable_field


private pure func union_decl_has_destructor(union_decl: CoreUnionDecl) -> Bool:
	var has_destructor: Bool = False

	for variant in union_decl.variants:
		if union_variant_has_releasable_field(variant):
			has_destructor = True

	has_destructor


private pure func union_variant_uses_release_mask(
	union_decl: CoreUnionDecl,
	variant: CoreUnionVariant,
) -> Bool:
	match union_decl.payload_storage:
		TypedUnionPayloadStorage:
			False
		ErasedUnionPayloadStorage:
			union_variant_has_releasable_field(variant)


private pure func union_decl_has_release_mask(union_decl: CoreUnionDecl) -> Bool:
	var has_release_mask: Bool = False

	for variant in union_decl.variants:
		if union_variant_uses_release_mask(union_decl, variant):
			has_release_mask = True

	has_release_mask


private pure func typed_union_field_release_statement(
	field: CoreUnionField,
	field_c: String,
) -> String:
	match field.release_policy:
		NoReleasePolicy:
			""
		ArcReleasePolicy:
			"        if (" + field_c + ") blorp_release((blorp_Object*)" + field_c + ");\n"
		ArcReleaseOnlyPolicy:
			"        if (" + field_c + ") blorp_release_arc_only(" + field_c + ");\n"
		StackResultReleasePolicy:
			"        blorp_stack_result_release(" + field_c + ");\n"


private pure func erased_union_field_release_statement(index: Int, field_c: String) -> String:
	bit: String = int_power_of_two(index).to_string()
	"        if ((self->release_mask & " + bit + "UL) && " + field_c + ") blorp_release(" + field_c + ");\n"


private pure func union_field_release_statement(
	union_decl: CoreUnionDecl,
	variant: CoreUnionVariant,
	field: CoreUnionField,
	index: Int,
) -> String:
	if not release_policy_requires_release(field.release_policy):
		""
	else:
		field_c: String = "self->data." + variant.name + ".field" + index.to_string()

		match union_decl.payload_storage:
			TypedUnionPayloadStorage:
				typed_union_field_release_statement(field, field_c)
			ErasedUnionPayloadStorage:
				erased_union_field_release_statement(index, field_c)


private pure func emit_union_destructor(union_decl: CoreUnionDecl) -> String:
	if not union_decl_has_destructor(union_decl):
		""
	else:
		var cases_c: String = ""

		for variant in union_decl.variants:
			if union_variant_has_releasable_field(variant):
				var releases_c: String = ""
				var index: Int = 0

				for field in variant.fields:
					releases_c += union_field_release_statement(union_decl, variant, field, index)
					index += 1

				cases_c += "    case " + variant.tag_c_name + ":\n" + releases_c + "      break;\n"

		"static void " + union_decl.name + "_destroy(void* obj) {\n" + "  " + union_decl.name + "* self = (" + union_decl.name + "*)obj;\n" + "  switch (self->tag) {\n" + cases_c + "    default:\n" + "      break;\n" + "  }\n" + "}\n\n"


private pure func emit_union_constructor(
	union_decl: CoreUnionDecl,
	variant: CoreUnionVariant,
) -> String:
	if variant.fields.length() == 0:
		instance_name: String = union_singleton_instance_name(variant)
		init_name: String = union_singleton_init_name(variant)

		"static " + union_decl.name + " " + instance_name + ";\n" + "__attribute__((constructor)) static void " + init_name + "(void) {\n" + "  atomic_store_explicit(&" + instance_name + ".header.refcount, BLORP_IMMORTAL_REFCOUNT, memory_order_relaxed);\n" + "  " + instance_name + ".tag = " + variant.tag_c_name + ";\n" + "}\n" + "#define " + variant.c_name + " ((" + union_decl.name + "*)&" + instance_name + ")\n\n"
	else:
		var params: List[String] = []
		var assignments: String = ""
		var index: Int = 0
		uses_release_mask: Bool = union_variant_uses_release_mask(union_decl, variant)
		has_release_mask: Bool = union_decl_has_release_mask(union_decl)

		for field in variant.fields:
			params = params.append(
				emit_union_constructor_param(
					union_decl.payload_storage,
					field,
					index,
				),
			)
			assignments += "  __vc->data." + variant.name + ".field" + index.to_string() + " = field" + index.to_string() + ";\n"
			index += 1

		if uses_release_mask:
			params = params.append("unsigned long release_mask")

		destructor_init: String = if union_decl_has_destructor(union_decl):
			"  BLORP_SET_DESTRUCTOR(__vc, " + union_decl.name + "_destroy);\n"
		else:
			""

		release_mask_init: String = if uses_release_mask:
			"  __vc->release_mask = release_mask;\n"
		else if has_release_mask:
			"  __vc->release_mask = 0UL;\n"
		else:
			""

		union_decl.name + "* " + variant.c_name + "(" + params.join(
			", ",
		) + ") {\n" + "  " + union_decl.name + "* __vc = (" + union_decl.name + "*)blorp_alloc(sizeof(" + union_decl.name + "));\n" + "  BLORP_TAG(__vc, \"" + union_decl.name + "\");\n" + destructor_init + "  __vc->tag = " + variant.tag_c_name + ";\n" + release_mask_init + assignments + "  return __vc;\n}\n\n"


private pure func emit_union_decl(union_decl: CoreUnionDecl) -> String:
	var storage_c: String = ""
	var tags_c: String = ""
	var constructors_c: String = ""

	release_mask_field: String = if union_decl_has_release_mask(union_decl):
		"  unsigned long release_mask;\n"
	else:
		""

	for variant in union_decl.variants:
		storage_c += emit_union_variant_storage(union_decl, variant)
		tags_c += emit_union_variant_tag(variant)
		constructors_c += emit_union_constructor(union_decl, variant)

	"typedef struct " + union_decl.name + " {\n" + "  blorp_Object header;\n" + "  int tag;\n" + release_mask_field + "  union {\n" + storage_c + "  } data;\n" + "} " + union_decl.name + ";\n\n" + tags_c + "\n" + emit_union_destructor(
		union_decl,
	) + constructors_c


private pure func emit_value_record_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			ValueRecordDecl(record_decl):
				c_code += emit_value_record_decl(record_decl)
			HeapRecordDecl(record_decl):
				void
			EnumDecl(enum_decl):
				void
			UnionDecl(union_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_heap_record_forward_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			HeapRecordDecl(record_decl):
				c_code += "typedef struct " + record_decl.name + " " + record_decl.name + ";\n"
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			EnumDecl(enum_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void

	if c_code == "":
		""
	else:
		c_code + "\n"


private pure func emit_heap_record_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			HeapRecordDecl(record_decl):
				c_code += emit_heap_record_decl(record_decl)
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			EnumDecl(enum_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_union_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			UnionDecl(union_decl):
				c_code += emit_union_decl(union_decl)
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			EnumDecl(enum_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_enum_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			EnumDecl(enum_decl):
				c_code += emit_enum_decl(enum_decl)
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_generated_stack_option_typedef(
	payload_c_type: String,
	option_c_type: String,
) -> String:
	"typedef struct { int tag; " + payload_c_type + " value; } " + option_c_type + ";\n"


private pure func emit_builtin_generated_stack_option_typedefs() -> String:
	emit_generated_stack_option_typedef(
		"__int128",
		"blorp_StackOption_Int128",
	) + emit_generated_stack_option_typedef(
		"unsigned __int128",
		"blorp_StackOption_UInt128",
	) + emit_generated_stack_option_typedef("long", "blorp_StackOption_Range")


private pure func emit_decl_generated_stack_option_typedef(decl: CoreDecl) -> String:
	match decl:
		ValueRecordDecl(record_decl):
			if runtime_owned_stack_option_payload_name(record_decl.name):
				""
			else:
				emit_generated_stack_option_typedef(
					record_decl.name,
					generated_stack_option_c_type_name(record_decl.name),
				)
		EnumDecl(enum_decl):
			if runtime_owned_stack_option_payload_name(enum_decl.name):
				""
			else:
				emit_generated_stack_option_typedef(
					"long",
					generated_stack_option_c_type_name(enum_decl.name),
				)
		HeapRecordDecl(record_decl):
			""
		UnionDecl(union_decl):
			""
		FunctionDecl(func_info):
			""
		GlobalDecl(global):
			""


private pure func emit_generated_stack_option_typedefs(decls: List[CoreDecl]) -> String:
	var c_code: String = emit_builtin_generated_stack_option_typedefs()

	for decl in decls:
		c_code += emit_decl_generated_stack_option_typedef(decl)

	if c_code == "":
		""
	else:
		c_code + "\n"


private pure func emit_global_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			GlobalDecl(global):
				c_code += emit_global_decl(global)
			EnumDecl(enum_decl):
				void
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			FunctionDecl(func_info):
				void

	c_code


private pure func emit_global_init_function(decls: List[CoreDecl]) -> String:
	var statements: String = ""
	var failed: Bool = False
	var temp_index: Int = 0

	for decl in decls:
		if not failed:
			match decl:
				GlobalDecl(global):
					if global_needs_runtime_init(global):
						match emit_global_runtime_init_body(global, temp_index):
							Some(init_body):
								statements += init_body.statements
								temp_index = init_body.next_temp
							None:
								failed = True
					else:
						void
				EnumDecl(enum_decl):
					void
				HeapRecordDecl(record_decl):
					void
				ValueRecordDecl(record_decl):
					void
				UnionDecl(union_decl):
					void
				FunctionDecl(func_info):
					void

	if failed:
		"void __blorp_init_globals(void) {\n  /* unsupported global initializer */\n}\n\n"
	else:
		"void __blorp_init_globals(void) {\n" + statements + "}\n\n"


private pure func emit_function_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			FunctionDecl(func_info):
				c_code += emit_function(decls, func_info)
			EnumDecl(enum_decl):
				void
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_function_forward_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			FunctionDecl(func_info):
				c_code += emit_function_forward_decl(func_info)
			EnumDecl(enum_decl):
				void
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			GlobalDecl(global):
				void

	if c_code == "":
		""
	else:
		c_code + "\n"


private pure func emit_static_closure_forward_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			FunctionDecl(func_info):
				c_code += emit_static_closure_forward_decl(func_info)
			EnumDecl(enum_decl):
				void
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			GlobalDecl(global):
				void

	if c_code == "":
		""
	else:
		c_code + "\n"


private pure func emit_decls(decls: List[CoreDecl]) -> String:
	emit_value_record_decls(
		decls,
	) + emit_heap_record_forward_decls(
		decls,
	) + emit_enum_decls(
		decls,
	) + emit_generated_stack_option_typedefs(
		decls,
	) + emit_union_decls(
		decls,
	) + emit_heap_record_decls(
		decls,
	) + emit_static_closure_forward_decls(
		decls,
	) + emit_global_decls(
		decls,
	) + emit_global_init_function(
		decls,
	) + emit_function_forward_decls(decls) + emit_function_decls(decls)


pure func emit_prepared_core_program_c_artifact(program: CoreProgram) -> CArtifact:
	{
		c_code = C_ARTIFACT_HEADER + emit_decls(program.decls),
		link_flags = [],
		include_dirs = []
	}


pure func prepare_and_emit_core_program_c_artifact(program: CoreProgram) -> CArtifact:
	resource_program: CoreProgram = CoreResource.rewrite_resource_program(program)
	fair_program: CoreProgram = CoreFairness.insert_cooperative_checkpoints(resource_program)
	prepared_program: CoreProgram = CorePrepare.prepare_program(fair_program)

	emit_prepared_core_program_c_artifact(prepared_program)


pure func emit_core_program_c_artifact(program: CoreProgram) -> CArtifact:
	prepare_and_emit_core_program_c_artifact(program)
