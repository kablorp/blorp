-- First Blorp-owned final-Core-to-C artifact surface.
--
-- This intentionally starts as a valid-C skeleton. The production migration
-- can replace each inventory comment with real C emission while preserving the
-- same typed CoreProgram -> CArtifact boundary.
import:
	codegen_intrinsic_renderer as Intrinsic
	compiler_artifact_json: CArtifact
	compiler_core_fairness as CoreFairness
	compiler_core_json:
		CoreBinaryOp(
			AddOp,
			DivideOp,
			EqualOp,
			GreaterEqualOp,
			GreaterOp,
			LessOp,
			LessEqualOp,
			ModuloOp,
			MultiplyOp,
			NotEqualOp,
			SubtractOp,
		),
		CoreBoxKind(PointerBox, PrimBox, StructBox, VoidBox),
		CoreBoxedStorageValue,
		CoreCallKind(BuiltinCall, ClosureCall, ForeignCall, IntrinsicCall, UserCall),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(ConstructorMatchFallbackBody, ConstructorMatchFallbackFail),
		CoreDecl(EnumDecl, FunctionDecl, GlobalDecl, UnionDecl, ValueRecordDecl),
		CoreEnumDecl,
		CoreEnumVariant,
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			BreakExpr,
			CastExpr,
			CallExpr,
			ConstructorMatchExpr,
			CooperativeCheckpointExpr,
			ContinueExpr,
			DupExpr,
			DropExpr,
			FieldExpr,
			ForRangeExpr,
			IfExpr,
			LetExpr,
			ListConstructExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			RangeExpr,
			RecordExpr,
			RecordConstructExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SeqExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			TupleExpr,
			TupleConstructExpr,
			TupleFieldExpr,
			UnaryExpr,
			UnionConstructExpr,
			VarExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreFunctionKind(BuiltinFunction, ClosureBodyFunction, ForeignFunction, UserFunction),
		CoreGlobal,
		CoreListConstruct,
		CoreListStorageLayout(InlineListStorage, InlineStructListStorage, PointerListStorage),
		CoreLiteral(BoolLiteral, CharLiteral, FloatLiteral, IntLiteral, StringLiteral),
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(LiteralMatchFallbackBody, LiteralMatchFallbackFail),
		CoreLogicalOp(AndOp, OrOp),
		CoreLoopBinder,
		CoreLoopRangeDirection(RangeForwardOnly, RangeMayRunBackward),
		CoreParam,
		CoreProgram,
		CoreRecordFieldValue,
		CoreReleasePolicy(
			ArcReleaseOnlyPolicy,
			ArcReleasePolicy,
			NoReleasePolicy,
			StackResultReleasePolicy,
		),
		CoreRetainPolicy(ArcRetainPolicy, NoRetainPolicy, StackResultRetainPolicy),
		CoreTupleElement(TuplePointerElement, TuplePrimElement, TupleVoidElement),
		CoreType(EnumType, NamedType, RangeType, TupleType, UnionType, ValueRecordType, VoidType),
		CoreUnaryOp(NegateOp, NotOp),
		CoreUnionConstruct,
		CoreUnionDecl,
		CoreUnionRepresentation(GenericUnionRepresentation, StackOptionRepresentation),
		CoreUnionVariant,
		CoreValueRecordDecl,
		CoreValueRecordField,
	compiler_core_prepare as CorePrepare
	compiler_core_resource as CoreResource
	string: string as make_string


private C_ARTIFACT_HEADER: String = "/* Blorp final Core C artifact */\n#include <math.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n\n"


private record FunctionBodyC {
	statements: String,
	value: String,
	next_temp: Int,
	returns: Bool
}


private pure func function_kind_label(kind: CoreFunctionKind) -> String:
	match kind:
		UserFunction:
			"user"
		BuiltinFunction:
			"builtin"
		ForeignFunction:
			"foreign"
		ClosureBodyFunction:
			"closure_body"


private pure func emit_function_inventory(func_info: CoreFunction) -> String:
	"/* function " + func_info.name + " kind=" + function_kind_label(
		func_info.function_kind,
	) + " def_id=" + func_info.def_id.to_string() + " */\n"


private pure func c_function_name(func_info: CoreFunction) -> String:
	func_info.name


private pure func is_entrypoint(func_info: CoreFunction) -> Bool:
	func_info.name == "main" and func_info.source_module == None


private pure func c_type_name(typ: CoreType) -> String:
	match typ:
		VoidType:
			"void"
		NamedType(name, args):
			if name == "Int":
				"long"
			else if name == "Int8":
				"int8_t"
			else if name == "Int16":
				"int16_t"
			else if name == "Int32":
				"int32_t"
			else if name == "Int64":
				"long"
			else if name == "Int128":
				"__int128"
			else if name == "UInt8":
				"uint8_t"
			else if name == "UInt16":
				"uint16_t"
			else if name == "UInt32":
				"uint32_t"
			else if name == "UInt64":
				"uint64_t"
			else if name == "UInt128":
				"unsigned __int128"
			else if name == "Float":
				"double"
			else if name == "Float32":
				"float"
			else if name == "Float16":
				"_Float16"
			else if name == "Bool":
				"int"
			else if name == "Char":
				"int32_t"
			else if name == "String":
				"blorp_String*"
			else if name == "Closure":
				"blorp_Closure*"
			else if name == "List":
				"blorp_List*"
			else:
				"void*"
		EnumType(name):
			"long"
		ValueRecordType(name):
			name
		UnionType(name):
			name + "*"
		RangeType:
			"Range"
		TupleType(items):
			"blorp_Tuple*"


private pure func c_return_type(func_info: CoreFunction) -> String:
	if is_entrypoint(func_info):
		"int"
	else:
		c_type_name(func_info.return_type)


private pure func c_function_signature(func_info: CoreFunction) -> String:
	if is_entrypoint(func_info) and func_info.params.length() > 0:
		c_return_type(func_info) + " " + c_function_name(func_info) + "(int argc, char** argv)"
	else:
		c_return_type(
			func_info,
		) + " " + c_function_name(func_info) + "(" + c_param_list(func_info.params) + ")"


private pure func entrypoint_has_source_args(func_info: CoreFunction) -> Bool:
	is_entrypoint(func_info) and func_info.params.length() > 0


private pure func entrypoint_arg_name(func_info: CoreFunction) -> String:
	match func_info.params:
		[]:
			"args"
		[param, ...rest]:
			param.name.name


private pure func entrypoint_arg_prelude(func_info: CoreFunction) -> String:
	if entrypoint_has_source_args(func_info):
		arg_name: String = entrypoint_arg_name(func_info)

		"  blorp_List* " + arg_name + " = blorp_list_new(argc);\n" + "  blorp_list_init_elem_release(" + arg_name + ", blorp_elem_release_fn);\n" + "  for (int __i = 0; __i < argc; __i++) " + arg_name + " = blorp_list_append_owned(" + arg_name + ", (void*)blorp_string_create(argv[__i]));\n"
	else:
		""


private pure func entrypoint_arg_cleanup(func_info: CoreFunction) -> String:
	if entrypoint_has_source_args(func_info):
		"  blorp_release(" + entrypoint_arg_name(func_info) + ");\n"
	else:
		""


private pure func c_param(param: CoreParam) -> String:
	c_type_name(param.typ) + " " + param.name.name


private pure func c_param_list(params: List[CoreParam]) -> String:
	if params.length() == 0:
		"void"
	else:
		var result: String = ""
		var index: Int = 0

		for param in params:
			if index > 0:
				result += ", "

			result += c_param(param)
			index += 1

		result


private pure func is_void_type(typ: CoreType) -> Bool:
	match typ:
		VoidType:
			True
		NamedType(name, args):
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TupleType(items):
			False


private pure func is_void_expr(expr: CoreExpr) -> Bool:
	match expr:
		LiteralExpr(literal, typ, loc):
			False
		VarExpr(variable, typ, loc):
			False
		VoidExpr(typ, loc):
			True
		CooperativeCheckpointExpr(typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, expr_value, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(variable, rhs, typ, loc):
			False
		CastExpr(expr_value, typ, loc):
			False
		FieldExpr(expr_value, field_name, typ, loc):
			False
		TupleFieldExpr(expr_value, field_index, typ, loc):
			False
		TupleExpr(items, typ, loc):
			False
		TupleConstructExpr(elements, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			False
		RecordExpr(fields, typ, loc):
			False
		RecordConstructExpr(type_name, fields, typ, loc):
			False
		UnionConstructExpr(construct, typ, loc):
			False
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			False
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			False
		LetExpr(name, is_mutable, typ, rhs, body):
			False
		SeqExpr(first, second):
			False
		WhileExpr(cond, body, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			False
		RangeExpr(start, end_value, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, cases, default_body, typ, loc):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False


private pure func body_value(value: String, next_temp: Int) -> FunctionBodyC:
	{
		statements = "",
		value = value,
		next_temp = next_temp,
		returns = False
	}


private pure func discard_body(body: FunctionBodyC) -> String:
	if body.value == "":
		body.statements
	else:
		body.statements + "  " + body.value + ";\n"


private pure func type_requires_release(typ: CoreType) -> Bool:
	match typ:
		TupleType(items):
			True
		UnionType(name):
			True
		VoidType:
			False
		NamedType(name, args):
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False


private pure func discard_expr_body(expr: CoreExpr, body: FunctionBodyC) -> String:
	if body.value == "":
		body.statements
	else if type_requires_release(core_expr_type(expr)):
		body.statements + "  blorp_release(" + body.value + ");\n"
	else:
		discard_body(body)


private pure func statement_body(expr: CoreExpr, body: FunctionBodyC) -> String:
	if is_void_expr(expr):
		body.statements
	else:
		discard_expr_body(expr, body)


private pure func required_body_value(body: FunctionBodyC) -> Option[String]:
	if body.value == "":
		None
	else:
		Some(body.value)


private pure func indent_statements(statements: String) -> String:
	if statements == "":
		""
	else:
		var result: String = ""

		for line in statements.split("\n"):
			if line.length() > 0:
				result += "  " + line + "\n"

		result


private pure func temp_name(prefix: String, index: Int) -> String:
	"__" + prefix + "_" + index.to_string()


private pure func c_string_literal(text: String) -> String:
	var result: String = make_string(text.length() + 2)
	result = result.append_char('\"')
	var index: Int = 0

	while index < text.length():
		match text.get(index):
			Some(ch):
				code: Int = to_int(ch)

				if code == 0:
					result = result.append_char('\\')
					result = result.append_char('0')
					result = result.append_char('0')
					result = result.append_char('0')
				else if code == 34:
					result = result.append_char('\\')
					result = result.append_char('\"')
				else if code == 92:
					result = result.append_char('\\')
					result = result.append_char('\\')
				else if code == 10:
					result = result.append_char('\\')
					result = result.append_char('n')
				else if code == 13:
					result = result.append_char('\\')
					result = result.append_char('r')
				else if code == 9:
					result = result.append_char('\\')
					result = result.append_char('t')
				else:
					result = result.append_char(ch)
			None:
				void

		index += 1

	result.append_char('\"')


private pure func string_contains_nul(text: String) -> Bool:
	var found: Bool = False
	var index: Int = 0

	while index < text.length():
		if not found:
			match text.get(index):
				Some(ch):
					if to_int(ch) == 0:
						found = True
					else:
						void
				None:
					void

		index += 1

	found


private pure func emit_string_literal_expr(value: String) -> String:
	literal_c: String = c_string_literal(value)

	if string_contains_nul(value):
		"blorp_string_literal_len(" + literal_c + ", " + value
			.length()
			.to_string() + "L)"
	else:
		"blorp_string_literal(" + literal_c + ")"


private pure func c_float_literal(value: Float) -> String:
	raw: String = value.to_string()

	if (
		raw.contains(".")
		or raw.contains("e")
		or raw.contains("E")
	):
		raw
	else:
		raw + ".0"


private pure func emit_literal_expr(literal: CoreLiteral) -> Option[String]:
	match literal:
		IntLiteral(value):
			Some(value.to_string())
		FloatLiteral(value):
			Some(c_float_literal(value))
		BoolLiteral(value):
			if value:
				Some("1")
			else:
				Some("0")
		CharLiteral(value):
			Some(value.to_string())
		StringLiteral(value):
			Some(emit_string_literal_expr(value))


private pure func c_infix_expr(left_c: String, operator: String, right_c: String) -> String:
	"(" + left_c + " " + operator + " " + right_c + ")"


private pure func c_zero_guarded_arithmetic_expr(
	left_c: String,
	operator: String,
	right_c: String,
) -> String:
	"((" + right_c + ") == 0 ? 0 : (" + left_c + " " + operator + " " + right_c + "))"


private pure func c_binary_expr(op: CoreBinaryOp, left_c: String, right_c: String) -> String:
	match op:
		AddOp:
			c_infix_expr(left_c, "+", right_c)
		SubtractOp:
			c_infix_expr(left_c, "-", right_c)
		MultiplyOp:
			c_infix_expr(left_c, "*", right_c)
		DivideOp:
			c_zero_guarded_arithmetic_expr(left_c, "/", right_c)
		ModuloOp:
			c_zero_guarded_arithmetic_expr(left_c, "%", right_c)
		EqualOp:
			c_infix_expr(left_c, "==", right_c)
		NotEqualOp:
			c_infix_expr(left_c, "!=", right_c)
		LessOp:
			c_infix_expr(left_c, "<", right_c)
		LessEqualOp:
			c_infix_expr(left_c, "<=", right_c)
		GreaterOp:
			c_infix_expr(left_c, ">", right_c)
		GreaterEqualOp:
			c_infix_expr(left_c, ">=", right_c)


private pure func c_unary_operator(op: CoreUnaryOp) -> String:
	match op:
		NegateOp:
			"-"
		NotOp:
			"!"


private pure func c_logical_operator(op: CoreLogicalOp) -> String:
	match op:
		AndOp:
			"&&"
		OrOp:
			"||"


private pure func emit_simple_expr_arg_values(args: List[CoreExpr]) -> Option[List[String]]:
	var result: List[String] = []
	var failed: Bool = False

	for arg in args:
		if not failed:
			match emit_simple_expr(arg):
				Some(arg_c):
					result = result.append(arg_c)
				None:
					failed = True

	if failed:
		None
	else:
		Some(result)


private pure func emit_simple_expr_args(args: List[CoreExpr]) -> Option[String]:
	arg_values ?= emit_simple_expr_arg_values(args)
	Some(arg_values.join(", "))


private pure func emit_intrinsic_call(name: String, args: List[CoreExpr]) -> Option[String]:
	arg_values ?= emit_simple_expr_arg_values(args)

	match Intrinsic.render_intrinsic(name, arg_values):
		Ok(rendered):
			Some(rendered)
		Err(error):
			None


private pure func emit_tuple_element_box(element: CoreTupleElement) -> Option[String]:
	match element:
		TuplePrimElement(value):
			value_c ?= emit_simple_expr(value)
			Some("(void*)(long)(" + value_c + ")")
		TuplePointerElement(value):
			value_c ?= emit_simple_expr(value)
			Some("(void*)" + value_c)
		TupleVoidElement:
			Some("(void*)0")


private pure func emit_tuple_construct(elements: List[CoreTupleElement]) -> Option[String]:
	var values: List[String] = []
	var failed: Bool = False

	for element in elements:
		if not failed:
			match emit_tuple_element_box(element):
				Some(value):
					values = values.append(value)
				None:
					failed = True

	if failed:
		None
	else:
		args_c: String = if values.length() == 0:
			""
		else:
			", " + values.join(", ")

		Some("blorp_tuple_new(" + values
				.length()
				.to_string() + args_c + ")")


private pure func list_construct_alloc(layout: CoreListStorageLayout, len: Int) -> String:
	match layout:
		PointerListStorage:
			"blorp_list_new(" + len.to_string() + ")"
		InlineListStorage(width_bytes):
			"blorp_list_new_inline(" + len.to_string() + ", " + width_bytes.to_string() + ")"
		InlineStructListStorage(c_type):
			"blorp_list_new_inline(" + len.to_string() + ", sizeof(" + c_type + "))"


private pure func emit_boxed_pointer_value(value: CoreBoxedStorageValue) -> Option[String]:
	value_c ?= emit_simple_expr(value.value)

	match value.kind:
		PrimBox:
			Some("(void*)(long)(" + value_c + ")")
		PointerBox:
			Some("(void*)" + value_c)
		VoidBox:
			Some("(void*)0")
		StructBox(c_type):
			Some("blorp_box_struct(&(" + c_type + "){" + value_c + "}, sizeof(" + c_type + "))")


private pure func render_list_construct_append_statement(
	list_name: String,
	value: CoreBoxedStorageValue,
) -> Option[String]:
	value_c ?= emit_boxed_pointer_value(value)

	if value.transfers_ownership:
		Some("  " + list_name + " = blorp_list_append_owned(" + list_name + ", " + value_c + ");\n")
	else:
		Some("  " + list_name + " = blorp_list_append(" + list_name + ", " + value_c + ");\n")


private pure func render_inline_struct_list_write(
	list_name: String,
	index: Int,
	c_type: String,
	value: CoreBoxedStorageValue,
) -> Option[String]:
	value_c ?= emit_simple_expr(value.value)
	elem_name: String = "__lst_elem_" + index.to_string()

	Some(
		"  { " + c_type + " " + elem_name + " = " + value_c + "; blorp_list_set_raw_copy(" + list_name + ", " + index.to_string() + ", &" + elem_name + "); }\n",
	)


private pure func emit_list_construct(construct: CoreListConstruct) -> Option[String]:
	list_name: String = "__lst"
	len: Int = construct.elements.length()
	var statements: String = "({\n  blorp_List* " + list_name + " = " + list_construct_alloc(
		construct.layout,
		len,
	) + ";\n"
	var failed: Bool = False
	var index: Int = 0

	if construct.elem_needs_release:
		statements += "  blorp_list_init_elem_release(" + list_name + ", blorp_elem_release_fn);\n"

	match construct.layout:
		InlineStructListStorage(c_type):
			for value in construct.elements:
				if not failed:
					match render_inline_struct_list_write(list_name, index, c_type, value):
						Some(statement):
							statements += statement
						None:
							failed = True

				index += 1
		PointerListStorage:
			for value in construct.elements:
				if not failed:
					match render_list_construct_append_statement(list_name, value):
						Some(statement):
							statements += statement
						None:
							failed = True
		InlineListStorage(width_bytes):
			for value in construct.elements:
				if not failed:
					match render_list_construct_append_statement(list_name, value):
						Some(statement):
							statements += statement
						None:
							failed = True

	if failed:
		None
	else:
		statements += "  " + list_name + "->len = " + len.to_string() + ";\n  " + list_name + ";\n})"
		Some(statements)


private pure func emit_record_construct(
	type_name: String,
	fields: List[CoreRecordFieldValue],
) -> Option[String]:
	var values: List[String] = []
	var failed: Bool = False

	for field in fields:
		if not failed:
			match emit_simple_expr(field.value):
				Some(value):
					values = values.append(value)
				None:
					failed = True

	if failed:
		None
	else:
		Some(type_name + "_make(" + values.join(", ") + ")")


private pure func emit_union_construct(construct: CoreUnionConstruct) -> Option[String]:
	var args: List[String] = []
	var failed: Bool = False

	for arg in construct.args:
		if not failed:
			match emit_simple_expr(arg):
				Some(arg_c):
					args = args.append(arg_c)
				None:
					failed = True

	if failed:
		None
	else:
		match construct.representation:
			GenericUnionRepresentation:
				Some(construct.constructor_c_name + "(" + args.join(", ") + ")")
			StackOptionRepresentation(info):
				match args:
					[]:
						Some(
							"((" + info.option_type + "){ .tag = " + info.tag.to_string() + ", .value = " + info.none_value + " })",
						)
					[payload]:
						Some(
							"((" + info.option_type + "){ .tag = " + info.tag.to_string() + ", .value = " + payload + " })",
						)
					[first, second, ...rest]:
						None


private pure func emit_tuple_field_access(
	expr_value: CoreExpr,
	field_index: Int,
	typ: CoreType,
) -> Option[String]:
	tuple_c ?= emit_simple_expr(expr_value)
	element_c: String = "((blorp_Tuple*)" + tuple_c + ")->elem[" + field_index.to_string() + "]"

	if CorePrepare.is_primitive_tuple_slot_type(typ):
		field_type: String = c_type_name(typ)

		if field_type == "long":
			Some("((long)" + element_c + ")")
		else:
			Some("((" + field_type + ")(long)" + element_c + ")")
	else:
		None


private pure func emit_drop_statement(
	variable: CoreVar,
	release_policy: CoreReleasePolicy,
) -> String:
	match release_policy:
		NoReleasePolicy:
			""
		ArcReleasePolicy:
			"  blorp_release(" + variable.name + ");\n"
		ArcReleaseOnlyPolicy:
			"  blorp_release_arc_only(" + variable.name + ");\n"
		StackResultReleasePolicy:
			"  blorp_stack_result_release(" + variable.name + ");\n"


private pure func emit_dup_statement(variable: CoreVar, retain_policy: CoreRetainPolicy) -> String:
	match retain_policy:
		NoRetainPolicy:
			""
		ArcRetainPolicy:
			"  blorp_retain(" + variable.name + ");\n"
		StackResultRetainPolicy:
			"  blorp_stack_result_retain(" + variable.name + ");\n"


private pure func emit_simple_expr(expr: CoreExpr) -> Option[String]:
	match expr:
		LiteralExpr(literal, typ, loc):
			emit_literal_expr(literal)
		VarExpr(variable, typ, loc):
			Some(variable.name)
		VoidExpr(typ, loc):
			Some("0")
		CooperativeCheckpointExpr(typ, loc):
			None
		CallExpr(kind, callee, args, typ, loc):
			match kind:
				IntrinsicCall(name):
					emit_intrinsic_call(name, args)
				UserCall(name, def_id):
					args_c ?= emit_simple_expr_args(args)
					Some(name + "(" + args_c + ")")
				ForeignCall(name):
					args_c ?= emit_simple_expr_args(args)
					Some(name + "(" + args_c + ")")
				BuiltinCall(name):
					args_c ?= emit_simple_expr_args(args)
					Some(name + "(" + args_c + ")")
				ClosureCall:
					None
		BinaryExpr(op, left, right, typ, loc):
			left_c ?= emit_simple_expr(left)
			right_c ?= emit_simple_expr(right)
			Some(c_binary_expr(op, left_c, right_c))
		UnaryExpr(op, expr_value, typ, loc):
			expr_c ?= emit_simple_expr(expr_value)
			Some("(" + c_unary_operator(op) + expr_c + ")")
		LogicalExpr(op, left, right, typ, loc):
			left_c ?= emit_simple_expr(left)
			right_c ?= emit_simple_expr(right)
			Some("(" + left_c + " " + c_logical_operator(op) + " " + right_c + ")")
		AssignExpr(variable, rhs, typ, loc):
			None
		CastExpr(expr_value, typ, loc):
			expr_c ?= emit_simple_expr(expr_value)
			Some("((" + c_type_name(typ) + ")" + expr_c + ")")
		FieldExpr(expr_value, field_name, typ, loc):
			expr_c ?= emit_simple_expr(expr_value)
			Some(expr_c + "." + field_name)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			emit_tuple_field_access(expr_value, field_index, typ)
		TupleExpr(items, typ, loc):
			None
		TupleConstructExpr(elements, typ, loc):
			emit_tuple_construct(elements)
		ListConstructExpr(construct, typ, loc):
			emit_list_construct(construct)
		RecordExpr(fields, typ, loc):
			None
		RecordConstructExpr(type_name, fields, typ, loc):
			emit_record_construct(type_name, fields)
		UnionConstructExpr(construct, typ, loc):
			emit_union_construct(construct)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			None
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			None
		LetExpr(name, is_mutable, typ, rhs, body):
			None
		SeqExpr(first, second):
			None
		WhileExpr(cond, body, typ, loc):
			None
		BreakExpr(typ, loc):
			None
		ContinueExpr(typ, loc):
			None
		ResourceScopeExpr(scope, typ, loc):
			None
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			None
		TailrecLoopExpr(params, return_type, body, loc):
			None
		TailrecRecurExpr(args, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			None
		RangeExpr(start, end_value, typ, loc):
			start_c ?= emit_simple_expr(start)
			end_c ?= emit_simple_expr(end_value)
			range_type: String = c_type_name(typ)
			Some(
				"({ " + range_type + " __range_value = { " + start_c + ", " + end_c + " }; __range_value; })",
			)
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			None
		ConstructorMatchExpr(scrutinee, cases, default_body, typ, loc):
			None
		IfExpr(cond, then_expr, else_expr, typ, loc):
			cond_c ?= emit_simple_expr(cond)
			then_c ?= emit_simple_expr(then_expr)
			else_c ?= emit_simple_expr(else_expr)
			Some("(" + cond_c + " ? " + then_c + " : " + else_c + ")")


private pure func terminal_body(statements: String, next_temp: Int) -> FunctionBodyC:
	{
		statements = statements,
		value = "",
		next_temp = next_temp,
		returns = True
	}


private pure func emit_tailrec_recur(
	params: List[CoreParam],
	args: List[CoreExpr],
	next_temp: Int,
) -> Option[FunctionBodyC]:
	if params.length() != args.length():
		None
	else:
		var declarations: String = ""
		var assignments: String = ""
		var index: Int = 0
		var temp_index: Int = next_temp
		var failed: Bool = False

		for arg in args:
			if not failed:
				match params.get(index):
					Some(param):
						match emit_simple_expr(arg):
							Some(arg_c):
								temp: String = temp_name(
									"tailrec_arg_" + index.to_string(),
									temp_index,
								)

								declarations += "  " + c_type_name(
									param.typ,
								) + " " + temp + " = " + arg_c + ";\n"
								assignments += "  " + param.name.name + " = " + temp + ";\n"
								index += 1
								temp_index += 1
							None:
								failed = True
					None:
						failed = True

		if failed:
			None
		else:
			Some(terminal_body(declarations + assignments + "  continue;\n", temp_index))


private pure func emit_tailrec_tail(
	params: List[CoreParam],
	return_type: CoreType,
	expr: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match expr:
		TailrecRecurExpr(args, typ, loc):
			emit_tailrec_recur(params, args, next_temp)
		LetExpr(name, is_mutable, typ, rhs, body):
			if is_void_type(typ):
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_tailrec_tail(params, return_type, body, rhs_c.next_temp)
				Some(
					terminal_body(
						discard_expr_body(rhs, rhs_c) + body_c.statements,
						body_c.next_temp,
					),
				)
			else if name.name == "_":
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_tailrec_tail(params, return_type, body, rhs_c.next_temp)
				Some(
					terminal_body(
						discard_expr_body(rhs, rhs_c) + body_c.statements,
						body_c.next_temp,
					),
				)
			else:
				rhs_c ?= emit_simple_expr(rhs)
				body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
				Some(
					terminal_body(
						"  " + c_type_name(
							typ,
						) + " " + name.name + " = " + rhs_c + ";\n" + body_c.statements,
						body_c.next_temp,
					),
				)
		SeqExpr(first, second):
			first_c ?= emit_function_body(first, next_temp)
			second_c ?= emit_tailrec_tail(params, return_type, second, first_c.next_temp)
			Some(
				terminal_body(
					discard_expr_body(first, first_c) + second_c.statements,
					second_c.next_temp,
				),
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			cond_c ?= emit_simple_expr(cond)
			then_c ?= emit_tailrec_tail(params, return_type, then_expr, next_temp)
			else_c ?= emit_tailrec_tail(params, return_type, else_expr, then_c.next_temp)
			Some(
				terminal_body(
					"  if (" + cond_c + ") {\n" + indent_statements(
						then_c.statements,
					) + "  } else {\n" + indent_statements(else_c.statements) + "  }\n",
					else_c.next_temp,
				),
			)
		LiteralExpr(literal, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		VarExpr(variable, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		VoidExpr(typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		CooperativeCheckpointExpr(typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		CallExpr(kind, callee, args, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		BinaryExpr(op, left, right, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		UnaryExpr(op, expr_value, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		LogicalExpr(op, left, right, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		AssignExpr(variable, rhs, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		CastExpr(expr_value, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		FieldExpr(expr_value, field_name, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TupleExpr(items, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TupleConstructExpr(elements, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListConstructExpr(construct, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		RecordExpr(fields, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		RecordConstructExpr(type_name, fields, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		UnionConstructExpr(construct, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			retain_statement: String = emit_dup_statement(variable, retain_policy)
			body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
			Some(terminal_body(retain_statement + body_c.statements, body_c.next_temp))
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			drop_statement: String = emit_drop_statement(variable, release_policy)
			body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
			Some(terminal_body(drop_statement + body_c.statements, body_c.next_temp))
		WhileExpr(cond, body, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		BreakExpr(typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ContinueExpr(typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ResourceScopeExpr(scope, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TailrecLoopExpr(loop_params, loop_return_type, body, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		RangeExpr(start, end_value, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ConstructorMatchExpr(scrutinee, cases, default_body, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)


private pure func emit_tailrec_return(
	return_type: CoreType,
	expr: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_function_body(expr, next_temp)

	if is_void_type(return_type):
		Some(terminal_body(discard_expr_body(expr, body_c) + "  return;\n", body_c.next_temp))
	else:
		return_value ?= required_body_value(body_c)
		Some(
			terminal_body(
				body_c.statements + "  return " + return_value + ";\n",
				body_c.next_temp,
			),
		)


private pure func emit_tailrec_loop(
	params: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
	Some(
		terminal_body(
			"  while (1) {\n" + indent_statements(body_c.statements) + "  }\n",
			body_c.next_temp,
		),
	)


private pure func static_int_literal(expr: CoreExpr) -> Option[Int]:
	match expr:
		LiteralExpr(literal, typ, loc):
			match literal:
				IntLiteral(value):
					Some(value)
				FloatLiteral(value):
					None
				BoolLiteral(value):
					None
				CharLiteral(value):
					None
				StringLiteral(value):
					None
		VarExpr(variable, typ, loc):
			None
		VoidExpr(typ, loc):
			None
		CooperativeCheckpointExpr(typ, loc):
			None
		CallExpr(kind, callee, args, typ, loc):
			None
		BinaryExpr(op, left, right, typ, loc):
			None
		UnaryExpr(op, expr_value, typ, loc):
			None
		LogicalExpr(op, left, right, typ, loc):
			None
		AssignExpr(variable, rhs, typ, loc):
			None
		CastExpr(expr_value, typ, loc):
			None
		FieldExpr(expr_value, field_name, typ, loc):
			None
		TupleFieldExpr(expr_value, field_index, typ, loc):
			None
		TupleExpr(items, typ, loc):
			None
		TupleConstructExpr(elements, typ, loc):
			None
		ListConstructExpr(construct, typ, loc):
			None
		RecordExpr(fields, typ, loc):
			None
		RecordConstructExpr(type_name, fields, typ, loc):
			None
		UnionConstructExpr(construct, typ, loc):
			None
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			None
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			None
		LetExpr(name, is_mutable, typ, rhs, body):
			None
		SeqExpr(first, second):
			None
		WhileExpr(cond, body, typ, loc):
			None
		BreakExpr(typ, loc):
			None
		ContinueExpr(typ, loc):
			None
		ResourceScopeExpr(scope, typ, loc):
			None
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			None
		TailrecLoopExpr(params, return_type, body, loc):
			None
		TailrecRecurExpr(args, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			None
		RangeExpr(start, end_value, typ, loc):
			None
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			None
		ConstructorMatchExpr(scrutinee, cases, default_body, typ, loc):
			None
		IfExpr(cond, then_expr, else_expr, typ, loc):
			None


private pure func range_is_forward_proven(
	direction: CoreLoopRangeDirection,
	start: CoreExpr,
	end_value: CoreExpr,
) -> Bool:
	match direction:
		RangeMayRunBackward:
			match static_int_literal(start):
				Some(start_value):
					match static_int_literal(end_value):
						Some(end_int):
							start_value <= end_int
						None:
							False
				None:
					False
		RangeForwardOnly:
			True


private pure func emit_for_range(
	binder: CoreLoopBinder,
	start: CoreExpr,
	end_value: CoreExpr,
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	start_c ?= emit_simple_expr(start)
	end_c ?= emit_simple_expr(end_value)
	body_c ?= emit_function_body(body, next_temp + 1)
	start_tmp: String = temp_name("range_start", next_temp)
	end_tmp: String = temp_name("range_end", next_temp)
	step_tmp: String = temp_name("range_step", next_temp)
	loop_type: String = c_type_name(binder.typ)
	prefix: String = "  " + loop_type + " " + start_tmp + " = " + start_c + ";\n  " + loop_type + " " + end_tmp + " = " + end_c + ";\n"

	if range_is_forward_proven(binder.range_direction, start, end_value):
		Some({
			statements = prefix + "  for (" + loop_type + " " + binder.variable.name + " = " + start_tmp + "; " + binder.variable.name + " < " + end_tmp + "; " + binder.variable.name + "++) {\n" + indent_statements(
				statement_body(
					body,
					body_c,
				),
			) + "  }\n",
			value = "",
			next_temp = body_c.next_temp,
			returns = False,
		})
	else:
		Some({
			statements = prefix + "  " + loop_type + " " + step_tmp + " = (" + start_tmp + " <= " + end_tmp + ") ? 1 : -1;\n  for (" + loop_type + " " + binder.variable.name + " = " + start_tmp + "; " + binder.variable.name + " != " + end_tmp + "; " + binder.variable.name + " += " + step_tmp + ") {\n" + indent_statements(
				statement_body(
					body,
					body_c,
				),
			) + "  }\n",
			value = "",
			next_temp = body_c.next_temp,
			returns = False,
		})


private pure func core_expr_type(expr: CoreExpr) -> CoreType:
	match expr:
		LiteralExpr(literal, typ, loc):
			typ
		VarExpr(variable, typ, loc):
			typ
		VoidExpr(typ, loc):
			typ
		CooperativeCheckpointExpr(typ, loc):
			typ
		CallExpr(kind, callee, args, typ, loc):
			typ
		BinaryExpr(op, left, right, typ, loc):
			typ
		UnaryExpr(op, expr_value, typ, loc):
			typ
		LogicalExpr(op, left, right, typ, loc):
			typ
		AssignExpr(variable, rhs, typ, loc):
			typ
		CastExpr(expr_value, typ, loc):
			typ
		FieldExpr(expr_value, field_name, typ, loc):
			typ
		TupleFieldExpr(expr_value, field_index, typ, loc):
			typ
		TupleExpr(items, typ, loc):
			typ
		TupleConstructExpr(elements, typ, loc):
			typ
		ListConstructExpr(construct, typ, loc):
			typ
		RecordExpr(fields, typ, loc):
			typ
		RecordConstructExpr(type_name, fields, typ, loc):
			typ
		UnionConstructExpr(construct, typ, loc):
			typ
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			typ
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			typ
		LetExpr(name, is_mutable, typ, rhs, body):
			core_expr_type(body)
		SeqExpr(first, second):
			core_expr_type(second)
		WhileExpr(cond, body, typ, loc):
			typ
		BreakExpr(typ, loc):
			typ
		ContinueExpr(typ, loc):
			typ
		ResourceScopeExpr(scope, typ, loc):
			typ
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			typ
		TailrecLoopExpr(params, return_type, body, loc):
			return_type
		TailrecRecurExpr(args, typ, loc):
			typ
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			typ
		RangeExpr(start, end_value, typ, loc):
			typ
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			typ
		ConstructorMatchExpr(scrutinee, cases, default_body, typ, loc):
			typ
		IfExpr(cond, then_expr, else_expr, typ, loc):
			typ


private pure func c_literal_match_test(scrutinee: String, literal: CoreLiteral) -> Option[String]:
	match literal:
		IntLiteral(value):
			Some(scrutinee + " == " + value.to_string())
		FloatLiteral(value):
			Some(scrutinee + " == " + c_float_literal(value))
		BoolLiteral(value):
			if value:
				Some(scrutinee + " == 1")
			else:
				Some(scrutinee + " == 0")
		CharLiteral(value):
			Some(scrutinee + " == " + value.to_string())
		StringLiteral(value):
			None


private pure func emit_literal_match_branch_body(
	result_name: Option[String],
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_function_body(body, next_temp)

	match result_name:
		Some(name):
			value ?= required_body_value(body_c)
			Some({
				statements = body_c.statements + "  " + name + " = " + value + ";\n",
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		None:
			Some({
				statements = statement_body(body, body_c),
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})


private pure func emit_literal_match_failure(next_temp: Int) -> FunctionBodyC:
	terminal_body("  fprintf(stderr, \"blorp: non-exhaustive match\\n\");\n  abort();\n", next_temp)


private pure func emit_literal_match_fallback(
	result_name: Option[String],
	fallback: CoreLiteralMatchFallback,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fallback:
		LiteralMatchFallbackBody(body):
			emit_literal_match_branch_body(result_name, body, next_temp)
		LiteralMatchFallbackFail:
			Some(emit_literal_match_failure(next_temp))


private pure func emit_literal_match(
	scrutinee: CoreExpr,
	cases: List[CoreLiteralMatchCase],
	fallback: CoreLiteralMatchFallback,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	scrutinee_c ?= emit_function_body(scrutinee, next_temp)
	scrutinee_value ?= required_body_value(scrutinee_c)
	scrutinee_temp: String = temp_name("match_scrut", scrutinee_c.next_temp)
	result_temp: String = temp_name("match_result", scrutinee_c.next_temp + 1)
	has_result: Bool = not is_void_type(typ)

	var branch_next_temp: Int = scrutinee_c.next_temp + 1

	if has_result:
		branch_next_temp = scrutinee_c.next_temp + 2

	result_name: Option[String] = if has_result:
		Some(result_temp)
	else:
		None

	var branch_statements: String = ""
	var failed: Bool = False
	var has_case: Bool = False

	for match_case in cases:
		if not failed:
			match c_literal_match_test(scrutinee_temp, match_case.literal):
				Some(test):
					match emit_literal_match_branch_body(
						result_name,
						match_case.body,
						branch_next_temp,
					):
						Some(case_c):
							if has_case:
								branch_statements += "  } else if (" + test + ") {\n"
							else:
								branch_statements += "  if (" + test + ") {\n"

							branch_statements += indent_statements(case_c.statements)
							branch_next_temp = case_c.next_temp
							has_case = True
						None:
							failed = True
				None:
					failed = True

	if failed:
		None
	else:
		fallback_c ?= emit_literal_match_fallback(result_name, fallback, branch_next_temp)
		scrutinee_type: String = c_type_name(core_expr_type(scrutinee))
		prefix: String = scrutinee_c.statements + "  " + scrutinee_type + " " + scrutinee_temp + " = " + scrutinee_value + ";\n"
		var result_decl: String = ""

		if has_result:
			result_decl = "  " + c_type_name(typ) + " " + result_temp + ";\n"

		var match_statements: String = fallback_c.statements

		if has_case:
			match_statements = branch_statements + "  } else {\n" + indent_statements(
				fallback_c.statements,
			) + "  }\n"

		var result_value: String = ""

		if has_result:
			result_value = result_temp

		Some({
			statements = prefix + result_decl + match_statements,
			value = result_value,
			next_temp = fallback_c.next_temp,
			returns = False,
		})


private pure func emit_constructor_match_fallback(
	result_name: Option[String],
	fallback: CoreConstructorMatchFallback,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			emit_literal_match_branch_body(result_name, body, next_temp)
		ConstructorMatchFallbackFail:
			Some(emit_literal_match_failure(next_temp))


private pure func emit_constructor_match(
	scrutinee: CoreExpr,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	scrutinee_c ?= emit_function_body(scrutinee, next_temp)
	scrutinee_value ?= required_body_value(scrutinee_c)
	scrutinee_temp: String = temp_name("match_scrut", scrutinee_c.next_temp)
	result_temp: String = temp_name("match_result", scrutinee_c.next_temp + 1)
	has_result: Bool = not is_void_type(typ)

	var branch_next_temp: Int = scrutinee_c.next_temp + 1

	if has_result:
		branch_next_temp = scrutinee_c.next_temp + 2

	result_name: Option[String] = if has_result:
		Some(result_temp)
	else:
		None

	var branch_statements: String = ""
	var failed: Bool = False
	var has_case: Bool = False

	for match_case in cases:
		if not failed:
			test: String = scrutinee_temp + " == " + match_case.constructor_c_name

			match emit_literal_match_branch_body(result_name, match_case.body, branch_next_temp):
				Some(case_c):
					if has_case:
						branch_statements += "  } else if (" + test + ") {\n"
					else:
						branch_statements += "  if (" + test + ") {\n"

					branch_statements += indent_statements(case_c.statements)
					branch_next_temp = case_c.next_temp
					has_case = True
				None:
					failed = True

	if failed:
		None
	else:
		fallback_c ?= emit_constructor_match_fallback(result_name, fallback, branch_next_temp)
		scrutinee_type: String = c_type_name(core_expr_type(scrutinee))
		prefix: String = scrutinee_c.statements + "  " + scrutinee_type + " " + scrutinee_temp + " = " + scrutinee_value + ";\n"
		var result_decl: String = ""

		if has_result:
			result_decl = "  " + c_type_name(typ) + " " + result_temp + ";\n"

		var match_statements: String = fallback_c.statements

		if has_case:
			match_statements = branch_statements + "  } else {\n" + indent_statements(
				fallback_c.statements,
			) + "  }\n"

		var result_value: String = ""

		if has_result:
			result_value = result_temp

		Some({
			statements = prefix + result_decl + match_statements,
			value = result_value,
			next_temp = fallback_c.next_temp,
			returns = False,
		})


private pure func emit_function_body(expr: CoreExpr, next_temp: Int) -> Option[FunctionBodyC]:
	match expr:
		LetExpr(name, is_mutable, typ, rhs, body):
			if is_void_type(typ):
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_function_body(body, rhs_c.next_temp)
				Some({
					statements = discard_expr_body(rhs, rhs_c) + body_c.statements,
					value = body_c.value,
					next_temp = body_c.next_temp,
					returns = body_c.returns,
				})
			else if name.name == "_":
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_function_body(body, rhs_c.next_temp)
				Some({
					statements = discard_expr_body(rhs, rhs_c) + body_c.statements,
					value = body_c.value,
					next_temp = body_c.next_temp,
					returns = body_c.returns,
				})
			else:
				rhs_c ?= emit_simple_expr(rhs)
				body_c ?= emit_function_body(body, next_temp)
				Some({
					statements = "  " + c_type_name(
						typ,
					) + " " + name.name + " = " + rhs_c + ";\n" + body_c.statements,
					value = body_c.value,
					next_temp = body_c.next_temp,
					returns = body_c.returns,
				})
		LiteralExpr(literal, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		VarExpr(variable, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		VoidExpr(typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		CooperativeCheckpointExpr(typ, loc):
			Some({
				statements = "  blorp_cooperative_checkpoint();\n",
				value = "",
				next_temp = next_temp,
				returns = False,
			})
		CallExpr(kind, callee, args, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		BinaryExpr(op, left, right, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		UnaryExpr(op, expr_value, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		LogicalExpr(op, left, right, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		AssignExpr(variable, rhs, typ, loc):
			rhs_c ?= emit_function_body(rhs, next_temp)

			if variable.name == "_":
				Some({
					statements = discard_expr_body(rhs, rhs_c),
					value = "",
					next_temp = rhs_c.next_temp,
					returns = False,
				})
			else:
				Some({
					statements = rhs_c.statements + "  " + variable.name + " = " + rhs_c.value + ";\n",
					value = "",
					next_temp = rhs_c.next_temp,
					returns = False,
				})
		CastExpr(expr_value, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		FieldExpr(expr_value, field_name, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TupleFieldExpr(expr_value, field_index, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TupleExpr(items, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TupleConstructExpr(elements, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListConstructExpr(construct, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		RecordExpr(fields, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		RecordConstructExpr(type_name, fields, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		UnionConstructExpr(construct, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			retain_statement: String = emit_dup_statement(variable, retain_policy)
			body_c ?= emit_function_body(body, next_temp)
			Some({
				statements = retain_statement + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			drop_statement: String = emit_drop_statement(variable, release_policy)
			body_c ?= emit_function_body(body, next_temp)
			Some({
				statements = drop_statement + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		SeqExpr(first, second):
			first_c ?= emit_function_body(first, next_temp)
			second_c ?= emit_function_body(second, first_c.next_temp)
			Some({
				statements = discard_expr_body(first, first_c) + second_c.statements,
				value = second_c.value,
				next_temp = second_c.next_temp,
				returns = second_c.returns,
			})
		WhileExpr(cond, body, typ, loc):
			cond_c ?= emit_simple_expr(cond)
			body_c ?= emit_function_body(body, next_temp)
			Some({
				statements = "  while (" + cond_c + ") {\n" + indent_statements(
					statement_body(
						body,
						body_c,
					),
				) + "  }\n",
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		BreakExpr(typ, loc):
			Some({
				statements = "  break;\n",
				value = "",
				next_temp = next_temp,
				returns = False,
			})
		ContinueExpr(typ, loc):
			Some({
				statements = "  continue;\n",
				value = "",
				next_temp = next_temp,
				returns = False,
			})
		ResourceScopeExpr(scope, typ, loc):
			None
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			None
		TailrecLoopExpr(params, return_type, body, loc):
			emit_tailrec_loop(params, return_type, body, next_temp)
		TailrecRecurExpr(args, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			emit_for_range(binder, start, end_value, body, next_temp)
		RangeExpr(start, end_value, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			emit_literal_match(scrutinee, cases, fallback, typ, next_temp)
		ConstructorMatchExpr(scrutinee, cases, fallback, typ, loc):
			emit_constructor_match(scrutinee, cases, fallback, typ, next_temp)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					cond_c ?= emit_simple_expr(cond)

					if is_void_type(typ):
						then_c ?= emit_function_body(then_expr, next_temp)
						else_c ?= emit_function_body(else_expr, then_c.next_temp)
						else_statements: String = statement_body(else_expr, else_c)

						if else_statements == "":
							Some({
								statements = "  if (" + cond_c + ") {\n" + indent_statements(
									statement_body(
										then_expr,
										then_c,
									),
								) + "  }\n",
								value = "",
								next_temp = else_c.next_temp,
								returns = False,
							})
						else:
							Some({
								statements = "  if (" + cond_c + ") {\n" + indent_statements(
									statement_body(
										then_expr,
										then_c,
									),
								) + "  } else {\n" + indent_statements(else_statements) + "  }\n",
								value = "",
								next_temp = else_c.next_temp,
								returns = False,
							})
					else:
						temp: String = temp_name("if_result", next_temp)
						then_c ?= emit_function_body(then_expr, next_temp + 1)
						else_c ?= emit_function_body(else_expr, then_c.next_temp)
						then_value ?= required_body_value(then_c)
						else_value ?= required_body_value(else_c)
						Some({
							statements = "  " + c_type_name(
								typ,
							) + " " + temp + ";\n  if (" + cond_c + ") {\n" + indent_statements(
								then_c.statements,
							) + "    " + temp + " = " + then_value + ";\n  } else {\n" + indent_statements(
								else_c.statements,
							) + "    " + temp + " = " + else_value + ";\n  }\n",
							value = temp,
							next_temp = else_c.next_temp,
							returns = False,
						})


private pure func emit_supported_user_function(func_info: CoreFunction) -> Option[String]:
	match func_info.body:
		Some(body):
			match emit_function_body(body, 0):
				Some(body_c):
					prefix: String = c_function_signature(func_info) + " {\n"
					body_prelude: String = entrypoint_arg_prelude(func_info)
					body_cleanup: String = entrypoint_arg_cleanup(func_info)

					if is_void_type(func_info.return_type):
						if is_entrypoint(func_info):
							Some(
								prefix + body_prelude + discard_body(
									body_c,
								) + body_cleanup + "  return 0;\n}\n",
							)
						else:
							Some(prefix + body_prelude + discard_body(body_c) + "}\n")
					else:
						match required_body_value(body_c):
							Some(return_value):
								if entrypoint_has_source_args(func_info):
									Some(
										prefix + body_prelude + body_c.statements + "  long __blorp_main_result = (long)" + return_value + ";\n" + body_cleanup + "  return (int)__blorp_main_result;\n}\n",
									)
								else:
									Some(
										prefix + body_prelude + body_c.statements + "  return " + return_value + ";\n}\n",
									)
							None:
								if body_c.returns:
									Some(prefix + body_prelude + body_c.statements + "}\n")
								else:
									None
				None:
					None
		None:
			None


private pure func emit_function(func_info: CoreFunction) -> String:
	match func_info.function_kind:
		UserFunction:
			match emit_supported_user_function(func_info):
				Some(c_code):
					c_code
				None:
					emit_function_inventory(func_info)
		BuiltinFunction:
			emit_function_inventory(func_info)
		ForeignFunction:
			emit_function_inventory(func_info)
		ClosureBodyFunction:
			emit_function_inventory(func_info)


private pure func emit_function_forward_decl(func_info: CoreFunction) -> String:
	match func_info.function_kind:
		UserFunction:
			match func_info.body:
				Some(body):
					if is_entrypoint(func_info):
						""
					else:
						c_function_signature(func_info) + ";\n"
				None:
					""
		BuiltinFunction:
			""
		ForeignFunction:
			""
		ClosureBodyFunction:
			""


private pure func emit_enum_variant(variant: CoreEnumVariant) -> String:
	"#define " + variant.c_name + " " + variant.tag.to_string() + "L\n"


private pure func emit_enum_decl(enum_decl: CoreEnumDecl) -> String:
	var c_code: String = ""

	for variant in enum_decl.variants:
		c_code += emit_enum_variant(variant)

	c_code


private pure func emit_static_global_init_expr(init: CoreExpr) -> Option[String]:
	match init:
		LiteralExpr(literal, typ, loc):
			match literal:
				IntLiteral(value):
					Some(value.to_string() + "L")
				FloatLiteral(value):
					emit_simple_expr(init)
				BoolLiteral(value):
					emit_simple_expr(init)
				CharLiteral(value):
					emit_simple_expr(init)
				StringLiteral(value):
					emit_simple_expr(init)
		VarExpr(variable, typ, loc):
			emit_simple_expr(init)
		VoidExpr(typ, loc):
			emit_simple_expr(init)
		CooperativeCheckpointExpr(typ, loc):
			emit_simple_expr(init)
		CallExpr(kind, callee, args, typ, loc):
			emit_simple_expr(init)
		BinaryExpr(op, left, right, typ, loc):
			emit_simple_expr(init)
		UnaryExpr(op, expr_value, typ, loc):
			emit_simple_expr(init)
		LogicalExpr(op, left, right, typ, loc):
			emit_simple_expr(init)
		AssignExpr(variable, rhs, typ, loc):
			emit_simple_expr(init)
		CastExpr(expr_value, typ, loc):
			emit_simple_expr(init)
		FieldExpr(expr_value, field_name, typ, loc):
			emit_simple_expr(init)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			emit_simple_expr(init)
		TupleExpr(items, typ, loc):
			emit_simple_expr(init)
		TupleConstructExpr(elements, typ, loc):
			emit_simple_expr(init)
		ListConstructExpr(construct, typ, loc):
			None
		RecordExpr(fields, typ, loc):
			emit_simple_expr(init)
		RecordConstructExpr(type_name, fields, typ, loc):
			emit_simple_expr(init)
		UnionConstructExpr(construct, typ, loc):
			None
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			emit_simple_expr(init)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			emit_simple_expr(init)
		LetExpr(name, is_mutable, typ, rhs, body):
			emit_simple_expr(init)
		SeqExpr(first, second):
			emit_simple_expr(init)
		WhileExpr(cond, body, typ, loc):
			emit_simple_expr(init)
		BreakExpr(typ, loc):
			emit_simple_expr(init)
		ContinueExpr(typ, loc):
			emit_simple_expr(init)
		ResourceScopeExpr(scope, typ, loc):
			emit_simple_expr(init)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			emit_simple_expr(init)
		TailrecLoopExpr(params, return_type, body, loc):
			emit_simple_expr(init)
		TailrecRecurExpr(args, typ, loc):
			emit_simple_expr(init)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			emit_simple_expr(init)
		RangeExpr(start, end_value, typ, loc):
			emit_simple_expr(init)
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			emit_simple_expr(init)
		ConstructorMatchExpr(scrutinee, cases, default_body, typ, loc):
			emit_simple_expr(init)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			emit_simple_expr(init)


private pure func emit_global_decl(global: CoreGlobal) -> String:
	match emit_static_global_init_expr(global.init):
		Some(init_c):
			"static " + c_type_name(global.typ) + " " + global.name.name + " = " + init_c + ";\n\n"
		None:
			"/* unsupported global " + global.name.name + " */\n"


private pure func c_value_record_field_decl(field: CoreValueRecordField) -> String:
	c_type_name(field.typ) + " " + field.name + "; "


private pure func c_value_record_make_param(field: CoreValueRecordField) -> String:
	c_type_name(field.typ) + " " + field.name


private pure func emit_value_record_decl(record_decl: CoreValueRecordDecl) -> String:
	var fields_c: String = ""
	var params: List[String] = []
	var init_fields: List[String] = []

	for field in record_decl.fields:
		fields_c += c_value_record_field_decl(field)
		params = params.append(c_value_record_make_param(field))
		init_fields = init_fields.append(field.name)

	param_c: String = if params.length() == 0:
		"void"
	else:
		params.join(", ")

	"typedef struct { " + fields_c + "} " + record_decl.name + ";\nstatic inline " + record_decl.name + " " + record_decl.name + "_make(" + param_c + ") { " + record_decl.name + " __r = { " + init_fields.join(
		", ",
	) + " }; return __r; }\n\n"


private pure func c_union_variant_field_decl(field_type: CoreType, index: Int) -> String:
	c_type_name(field_type) + " field" + index.to_string() + "; "


private pure func emit_union_variant_storage(variant: CoreUnionVariant) -> String:
	if variant.fields.length() == 0:
		"    char " + variant.name + ";\n"
	else:
		var fields_c: String = ""
		var index: Int = 0

		for field_type in variant.fields:
			fields_c += c_union_variant_field_decl(field_type, index)
			index += 1

		"    struct { " + fields_c + "} " + variant.name + ";\n"


private pure func emit_union_variant_tag(variant: CoreUnionVariant) -> String:
	"#define " + variant.tag_c_name + " " + variant.tag.to_string() + "\n"


private pure func emit_union_constructor_param(field_type: CoreType, index: Int) -> String:
	c_type_name(field_type) + " field" + index.to_string()


private pure func emit_union_constructor(
	union_decl: CoreUnionDecl,
	variant: CoreUnionVariant,
) -> String:
	if variant.fields.length() == 0:
		""
	else:
		var params: List[String] = []
		var assignments: String = ""
		var index: Int = 0

		for field_type in variant.fields:
			params = params.append(emit_union_constructor_param(field_type, index))
			assignments += "  __vc->data." + variant.name + ".field" + index.to_string() + " = field" + index.to_string() + ";\n"
			index += 1

		union_decl.name + "* " + variant.c_name + "(" + params.join(
			", ",
		) + ") {\n" + "  " + union_decl.name + "* __vc = (" + union_decl.name + "*)blorp_alloc(sizeof(" + union_decl.name + "));\n" + "  BLORP_TAG(__vc, \"" + union_decl.name + "\");\n" + "  __vc->tag = " + variant.tag_c_name + ";\n" + assignments + "  return __vc;\n}\n\n"


private pure func emit_union_decl(union_decl: CoreUnionDecl) -> String:
	var storage_c: String = ""
	var tags_c: String = ""
	var constructors_c: String = ""

	for variant in union_decl.variants:
		storage_c += emit_union_variant_storage(variant)
		tags_c += emit_union_variant_tag(variant)
		constructors_c += emit_union_constructor(union_decl, variant)

	"typedef struct " + union_decl.name + " {\n" + "  blorp_Object header;\n" + "  int tag;\n" + "  union {\n" + storage_c + "  } data;\n" + "} " + union_decl.name + ";\n\n" + tags_c + "\n" + constructors_c


private pure func emit_value_record_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			ValueRecordDecl(record_decl):
				c_code += emit_value_record_decl(record_decl)
			EnumDecl(enum_decl):
				void
			UnionDecl(union_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_union_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			UnionDecl(union_decl):
				c_code += emit_union_decl(union_decl)
			ValueRecordDecl(record_decl):
				void
			EnumDecl(enum_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_enum_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			EnumDecl(enum_decl):
				c_code += emit_enum_decl(enum_decl)
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_global_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			GlobalDecl(global):
				c_code += emit_global_decl(global)
			EnumDecl(enum_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			FunctionDecl(func_info):
				void

	c_code


private pure func emit_function_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			FunctionDecl(func_info):
				c_code += emit_function(func_info)
			EnumDecl(enum_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_function_forward_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			FunctionDecl(func_info):
				c_code += emit_function_forward_decl(func_info)
			EnumDecl(enum_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			GlobalDecl(global):
				void

	if c_code == "":
		""
	else:
		c_code + "\n"


private pure func emit_decls(decls: List[CoreDecl]) -> String:
	emit_value_record_decls(
		decls,
	) + emit_enum_decls(
		decls,
	) + emit_union_decls(
		decls,
	) + emit_global_decls(decls) + emit_function_forward_decls(decls) + emit_function_decls(decls)


pure func emit_prepared_core_program_c_artifact(program: CoreProgram) -> CArtifact:
	{
		c_code = C_ARTIFACT_HEADER + emit_decls(program.decls),
		link_flags = [],
		include_dirs = []
	}


pure func prepare_and_emit_core_program_c_artifact(program: CoreProgram) -> CArtifact:
	resource_program: CoreProgram = CoreResource.rewrite_resource_program(program)
	fair_program: CoreProgram = CoreFairness.insert_cooperative_checkpoints(resource_program)
	prepared_program: CoreProgram = CorePrepare.prepare_program(fair_program)

	emit_prepared_core_program_c_artifact(prepared_program)


pure func emit_core_program_c_artifact(program: CoreProgram) -> CArtifact:
	prepare_and_emit_core_program_c_artifact(program)
