-- First Blorp-owned final-Core-to-C artifact surface.
--
-- This intentionally starts as a valid-C skeleton. The production migration
-- can replace each inventory comment with real C emission while preserving the
-- same typed CoreProgram -> CArtifact boundary.
import:
	codegen_intrinsic_renderer as Intrinsic
	compiler_artifact_json: CArtifact
	compiler_core_json:
		CoreBinaryOp(
			AddOp,
			DivideOp,
			EqualOp,
			GreaterEqualOp,
			GreaterOp,
			LessOp,
			LessEqualOp,
			ModuloOp,
			MultiplyOp,
			NotEqualOp,
			SubtractOp,
		),
		CoreCallKind(BuiltinCall, ClosureCall, ForeignCall, IntrinsicCall, UserCall),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(ConstructorMatchFallbackBody, ConstructorMatchFallbackFail),
		CoreDecl(EnumDecl, FunctionDecl, GlobalDecl, ValueRecordDecl),
		CoreEnumDecl,
		CoreEnumVariant,
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			BreakExpr,
			CastExpr,
			CallExpr,
			ConstructorMatchExpr,
			CooperativeCheckpointExpr,
			ContinueExpr,
			FieldExpr,
			ForRangeExpr,
			IfExpr,
			LetExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			RangeExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SeqExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			UnaryExpr,
			VarExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreFunctionKind(BuiltinFunction, ClosureBodyFunction, ForeignFunction, UserFunction),
		CoreGlobal,
		CoreLiteral(BoolLiteral, CharLiteral, FloatLiteral, IntLiteral, StringLiteral),
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(LiteralMatchFallbackBody, LiteralMatchFallbackFail),
		CoreLogicalOp(AndOp, OrOp),
		CoreLoopBinder,
		CoreLoopRangeDirection(RangeForwardOnly, RangeMayRunBackward),
		CoreParam,
		CoreProgram,
		CoreSourceLoc,
		CoreType(EnumType, NamedType, TupleType, ValueRecordType, VoidType),
		CoreUnaryOp(NegateOp, NotOp),
		CoreValueRecordDecl,
		CoreValueRecordField,
	compiler_core_resource: rewrite_resource_program
	string: string as make_string


private C_ARTIFACT_HEADER: String = "/* Blorp final Core C artifact */\n#include <math.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n\n"


private record FunctionBodyC {
	statements: String,
	value: String,
	next_temp: Int,
	returns: Bool
}


private pure func function_kind_label(kind: CoreFunctionKind) -> String:
	match kind:
		UserFunction:
			"user"
		BuiltinFunction:
			"builtin"
		ForeignFunction:
			"foreign"
		ClosureBodyFunction:
			"closure_body"


private pure func emit_function_inventory(func_info: CoreFunction) -> String:
	"/* function " + func_info.name + " kind=" + function_kind_label(
		func_info.function_kind,
	) + " def_id=" + func_info.def_id.to_string() + " */\n"


private pure func fairness_checkpoint(loc: CoreSourceLoc) -> CoreExpr:
	CooperativeCheckpointExpr(VoidType, loc)


private pure func is_checkpoint_expr(expr: CoreExpr) -> Bool:
	match expr:
		CooperativeCheckpointExpr(typ, loc):
			True
		LiteralExpr(literal, typ, loc):
			False
		VarExpr(variable, typ, loc):
			False
		VoidExpr(typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, expr_value, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(variable, rhs, typ, loc):
			False
		CastExpr(expr_value, typ, loc):
			False
		FieldExpr(expr_value, field_name, typ, loc):
			False
		LetExpr(name, is_mutable, typ, rhs, body):
			False
		SeqExpr(first, second):
			False
		WhileExpr(cond, body, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			False
		RangeExpr(start, end_value, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False


private pure func body_starts_with_checkpoint(body: CoreExpr) -> Bool:
	match body:
		CooperativeCheckpointExpr(typ, loc):
			True
		SeqExpr(first, second):
			is_checkpoint_expr(first)
		LiteralExpr(literal, typ, loc):
			False
		VarExpr(variable, typ, loc):
			False
		VoidExpr(typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, expr_value, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(variable, rhs, typ, loc):
			False
		CastExpr(expr_value, typ, loc):
			False
		FieldExpr(expr_value, field_name, typ, loc):
			False
		LetExpr(name, is_mutable, typ, rhs, body):
			False
		WhileExpr(cond, body, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			False
		RangeExpr(start, end_value, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False


private pure func add_loop_checkpoint(loop_loc: CoreSourceLoc, body: CoreExpr) -> CoreExpr:
	if body_starts_with_checkpoint(body):
		body
	else:
		SeqExpr(fairness_checkpoint(loop_loc), body)


private pure func add_expr_checkpoints(expr: CoreExpr) -> CoreExpr:
	match expr:
		LiteralExpr(literal, typ, loc):
			expr
		VarExpr(variable, typ, loc):
			expr
		VoidExpr(typ, loc):
			expr
		CooperativeCheckpointExpr(typ, loc):
			expr
		CallExpr(kind, callee, args, typ, loc):
			CallExpr(kind, add_expr_checkpoints(callee), add_expr_list_checkpoints(args), typ, loc)
		BinaryExpr(op, left, right, typ, loc):
			BinaryExpr(op, add_expr_checkpoints(left), add_expr_checkpoints(right), typ, loc)
		UnaryExpr(op, expr_value, typ, loc):
			UnaryExpr(op, add_expr_checkpoints(expr_value), typ, loc)
		LogicalExpr(op, left, right, typ, loc):
			LogicalExpr(op, add_expr_checkpoints(left), add_expr_checkpoints(right), typ, loc)
		AssignExpr(variable, rhs, typ, loc):
			AssignExpr(variable, add_expr_checkpoints(rhs), typ, loc)
		CastExpr(expr_value, typ, loc):
			CastExpr(add_expr_checkpoints(expr_value), typ, loc)
		FieldExpr(expr_value, field_name, typ, loc):
			FieldExpr(add_expr_checkpoints(expr_value), field_name, typ, loc)
		LetExpr(name, is_mutable, typ, rhs, body):
			LetExpr(name, is_mutable, typ, add_expr_checkpoints(rhs), add_expr_checkpoints(body))
		SeqExpr(first, second):
			SeqExpr(add_expr_checkpoints(first), add_expr_checkpoints(second))
		WhileExpr(cond, body, typ, loc):
			checked_body: CoreExpr = add_loop_checkpoint(loc, add_expr_checkpoints(body))
			WhileExpr(add_expr_checkpoints(cond), checked_body, typ, loc)
		BreakExpr(typ, loc):
			expr
		ContinueExpr(typ, loc):
			expr
		ResourceScopeExpr(scope, typ, loc):
			ResourceScopeExpr(
				{
					variable = scope.variable,
					typ = scope.typ,
					acquire = add_expr_checkpoints(scope.acquire),
					body = add_expr_checkpoints(scope.body),
					cleanup = add_expr_checkpoints(scope.cleanup)
				},
				typ,
				loc,
			)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			ResourceCleanupExitExpr(
				{
					cleanups = add_expr_list_checkpoints(cleanup_exit.cleanups),
					exit = cleanup_exit.exit
				},
				typ,
				loc,
			)
		TailrecLoopExpr(params, return_type, body, loc):
			checked_body: CoreExpr = add_loop_checkpoint(loc, add_expr_checkpoints(body))
			TailrecLoopExpr(params, return_type, checked_body, loc)
		TailrecRecurExpr(args, typ, loc):
			TailrecRecurExpr(add_expr_list_checkpoints(args), typ, loc)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			checked_body: CoreExpr = add_loop_checkpoint(loc, add_expr_checkpoints(body))
			ForRangeExpr(
				binder,
				add_expr_checkpoints(start),
				add_expr_checkpoints(end_value),
				checked_body,
				typ,
				loc,
			)
		RangeExpr(start, end_value, typ, loc):
			RangeExpr(add_expr_checkpoints(start), add_expr_checkpoints(end_value), typ, loc)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			LiteralMatchExpr(
				add_expr_checkpoints(scrutinee),
				add_literal_match_case_checkpoints(cases),
				add_literal_match_fallback_checkpoints(fallback),
				typ,
				loc,
			)
		ConstructorMatchExpr(scrutinee, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				add_expr_checkpoints(scrutinee),
				add_constructor_match_case_checkpoints(cases),
				add_constructor_match_fallback_checkpoints(fallback),
				typ,
				loc,
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				add_expr_checkpoints(cond),
				add_expr_checkpoints(then_expr),
				add_expr_checkpoints(else_expr),
				typ,
				loc,
			)


private pure func add_expr_list_checkpoints(exprs: List[CoreExpr]) -> List[CoreExpr]:
	var result: List[CoreExpr] = []

	for expr in exprs:
		result = result.append(add_expr_checkpoints(expr))

	result


private pure func add_literal_match_case_checkpoints(
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	var result: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		result = result.append({
			literal = match_case.literal,
			body = add_expr_checkpoints(match_case.body),
		})

	result


private pure func add_literal_match_fallback_checkpoints(
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(add_expr_checkpoints(body))
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func add_constructor_match_case_checkpoints(
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	var result: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		result = result.append({
			constructor = match_case.constructor,
			constructor_c_name = match_case.constructor_c_name,
			body = add_expr_checkpoints(match_case.body),
		})

	result


private pure func add_constructor_match_fallback_checkpoints(
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(add_expr_checkpoints(body))
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func add_function_checkpoints(func_info: CoreFunction) -> CoreFunction:
	match func_info.body:
		Some(body):
			{ func_info | body = Some(add_expr_checkpoints(body)) }
		None:
			func_info


private pure func add_global_checkpoints(global: CoreGlobal) -> CoreGlobal:
	{ global | init = add_expr_checkpoints(global.init) }


private pure func add_decl_checkpoints(decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(func_info):
			FunctionDecl(add_function_checkpoints(func_info))
		GlobalDecl(global):
			GlobalDecl(add_global_checkpoints(global))
		EnumDecl(enum_decl):
			decl
		ValueRecordDecl(record_decl):
			decl


private pure func add_program_checkpoints(program: CoreProgram) -> CoreProgram:
	var decls: List[CoreDecl] = []

	for decl in program.decls:
		decls = decls.append(add_decl_checkpoints(decl))

	{decls = decls}


private pure func c_function_name(func_info: CoreFunction) -> String:
	func_info.name


private pure func is_entrypoint(func_info: CoreFunction) -> Bool:
	func_info.name == "main" and func_info.source_module == None


private pure func c_type_name(typ: CoreType) -> String:
	match typ:
		VoidType:
			"void"
		NamedType(name, args):
			if name == "Int":
				"long"
			else if name == "Int8":
				"int8_t"
			else if name == "Int16":
				"int16_t"
			else if name == "Int32":
				"int32_t"
			else if name == "Int64":
				"long"
			else if name == "Int128":
				"__int128"
			else if name == "UInt8":
				"uint8_t"
			else if name == "UInt16":
				"uint16_t"
			else if name == "UInt32":
				"uint32_t"
			else if name == "UInt64":
				"uint64_t"
			else if name == "UInt128":
				"unsigned __int128"
			else if name == "Float":
				"double"
			else if name == "Float32":
				"float"
			else if name == "Float16":
				"_Float16"
			else if name == "Bool":
				"int"
			else if name == "Char":
				"int32_t"
			else if name == "String":
				"const char*"
			else if name == "Closure":
				"blorp_Closure*"
			else:
				"void*"
		EnumType(name):
			"long"
		ValueRecordType(name):
			name
		TupleType(items):
			"void*"


private pure func c_return_type(func_info: CoreFunction) -> String:
	if is_entrypoint(func_info):
		"int"
	else:
		c_type_name(func_info.return_type)


private pure func c_function_signature(func_info: CoreFunction) -> String:
	if is_entrypoint(func_info) and func_info.params.length() > 0:
		c_return_type(func_info) + " " + c_function_name(func_info) + "(int argc, char** argv)"
	else:
		c_return_type(
			func_info,
		) + " " + c_function_name(func_info) + "(" + c_param_list(func_info.params) + ")"


private pure func entrypoint_arg_prelude(func_info: CoreFunction) -> String:
	if is_entrypoint(func_info) and func_info.params.length() > 0:
		"  (void)argc;\n  (void)argv;\n"
	else:
		""


private pure func c_param(param: CoreParam) -> String:
	c_type_name(param.typ) + " " + param.name.name


private pure func c_param_list(params: List[CoreParam]) -> String:
	if params.length() == 0:
		"void"
	else:
		var result: String = ""
		var index: Int = 0

		for param in params:
			if index > 0:
				result += ", "

			result += c_param(param)
			index += 1

		result


private pure func is_void_type(typ: CoreType) -> Bool:
	match typ:
		VoidType:
			True
		NamedType(name, args):
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		TupleType(items):
			False


private pure func is_void_expr(expr: CoreExpr) -> Bool:
	match expr:
		LiteralExpr(literal, typ, loc):
			False
		VarExpr(variable, typ, loc):
			False
		VoidExpr(typ, loc):
			True
		CooperativeCheckpointExpr(typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, expr_value, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(variable, rhs, typ, loc):
			False
		CastExpr(expr_value, typ, loc):
			False
		FieldExpr(expr_value, field_name, typ, loc):
			False
		LetExpr(name, is_mutable, typ, rhs, body):
			False
		SeqExpr(first, second):
			False
		WhileExpr(cond, body, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			False
		RangeExpr(start, end_value, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, cases, default_body, typ, loc):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False


private pure func body_value(value: String, next_temp: Int) -> FunctionBodyC:
	{
		statements = "",
		value = value,
		next_temp = next_temp,
		returns = False
	}


private pure func discard_body(body: FunctionBodyC) -> String:
	if body.value == "":
		body.statements
	else:
		body.statements + "  " + body.value + ";\n"


private pure func statement_body(expr: CoreExpr, body: FunctionBodyC) -> String:
	if is_void_expr(expr):
		body.statements
	else:
		discard_body(body)


private pure func required_body_value(body: FunctionBodyC) -> Option[String]:
	if body.value == "":
		None
	else:
		Some(body.value)


private pure func indent_statements(statements: String) -> String:
	if statements == "":
		""
	else:
		var result: String = ""

		for line in statements.split("\n"):
			if line.length() > 0:
				result += "  " + line + "\n"

		result


private pure func temp_name(prefix: String, index: Int) -> String:
	"__" + prefix + "_" + index.to_string()


private pure func c_string_literal(text: String) -> String:
	var result: String = make_string(text.length() + 2)
	result = result.append_char('\"')
	var index: Int = 0

	while index < text.length():
		match text.get(index):
			Some(ch):
				code: Int = to_int(ch)

				if code == 34:
					result = result.append_char('\\')
					result = result.append_char('\"')
				else if code == 92:
					result = result.append_char('\\')
					result = result.append_char('\\')
				else if code == 10:
					result = result.append_char('\\')
					result = result.append_char('n')
				else if code == 13:
					result = result.append_char('\\')
					result = result.append_char('r')
				else if code == 9:
					result = result.append_char('\\')
					result = result.append_char('t')
				else:
					result = result.append_char(ch)
			None:
				void

		index += 1

	result.append_char('\"')


private pure func c_float_literal(value: Float) -> String:
	raw: String = value.to_string()

	if (
		raw.contains(".")
		or raw.contains("e")
		or raw.contains("E")
	):
		raw
	else:
		raw + ".0"


private pure func emit_literal_expr(literal: CoreLiteral) -> Option[String]:
	match literal:
		IntLiteral(value):
			Some(value.to_string())
		FloatLiteral(value):
			Some(c_float_literal(value))
		BoolLiteral(value):
			if value:
				Some("1")
			else:
				Some("0")
		CharLiteral(value):
			Some(value.to_string())
		StringLiteral(value):
			Some(c_string_literal(value))


private pure func c_infix_expr(left_c: String, operator: String, right_c: String) -> String:
	"(" + left_c + " " + operator + " " + right_c + ")"


private pure func c_zero_guarded_arithmetic_expr(
	left_c: String,
	operator: String,
	right_c: String,
) -> String:
	"((" + right_c + ") == 0 ? 0 : (" + left_c + " " + operator + " " + right_c + "))"


private pure func c_binary_expr(op: CoreBinaryOp, left_c: String, right_c: String) -> String:
	match op:
		AddOp:
			c_infix_expr(left_c, "+", right_c)
		SubtractOp:
			c_infix_expr(left_c, "-", right_c)
		MultiplyOp:
			c_infix_expr(left_c, "*", right_c)
		DivideOp:
			c_zero_guarded_arithmetic_expr(left_c, "/", right_c)
		ModuloOp:
			c_zero_guarded_arithmetic_expr(left_c, "%", right_c)
		EqualOp:
			c_infix_expr(left_c, "==", right_c)
		NotEqualOp:
			c_infix_expr(left_c, "!=", right_c)
		LessOp:
			c_infix_expr(left_c, "<", right_c)
		LessEqualOp:
			c_infix_expr(left_c, "<=", right_c)
		GreaterOp:
			c_infix_expr(left_c, ">", right_c)
		GreaterEqualOp:
			c_infix_expr(left_c, ">=", right_c)


private pure func c_unary_operator(op: CoreUnaryOp) -> String:
	match op:
		NegateOp:
			"-"
		NotOp:
			"!"


private pure func c_logical_operator(op: CoreLogicalOp) -> String:
	match op:
		AndOp:
			"&&"
		OrOp:
			"||"


private pure func emit_simple_expr_arg_values(args: List[CoreExpr]) -> Option[List[String]]:
	var result: List[String] = []
	var failed: Bool = False

	for arg in args:
		if not failed:
			match emit_simple_expr(arg):
				Some(arg_c):
					result = result.append(arg_c)
				None:
					failed = True

	if failed:
		None
	else:
		Some(result)


private pure func emit_simple_expr_args(args: List[CoreExpr]) -> Option[String]:
	arg_values ?= emit_simple_expr_arg_values(args)
	Some(arg_values.join(", "))


private pure func emit_intrinsic_call(name: String, args: List[CoreExpr]) -> Option[String]:
	arg_values ?= emit_simple_expr_arg_values(args)

	match Intrinsic.render_intrinsic(name, arg_values):
		Ok(rendered):
			Some(rendered)
		Err(error):
			None


private pure func emit_simple_expr(expr: CoreExpr) -> Option[String]:
	match expr:
		LiteralExpr(literal, typ, loc):
			emit_literal_expr(literal)
		VarExpr(variable, typ, loc):
			Some(variable.name)
		VoidExpr(typ, loc):
			Some("0")
		CooperativeCheckpointExpr(typ, loc):
			None
		CallExpr(kind, callee, args, typ, loc):
			match kind:
				IntrinsicCall(name):
					emit_intrinsic_call(name, args)
				UserCall(name, def_id):
					args_c ?= emit_simple_expr_args(args)
					Some(name + "(" + args_c + ")")
				ForeignCall(name):
					args_c ?= emit_simple_expr_args(args)
					Some(name + "(" + args_c + ")")
				BuiltinCall(name):
					args_c ?= emit_simple_expr_args(args)
					Some(name + "(" + args_c + ")")
				ClosureCall:
					None
		BinaryExpr(op, left, right, typ, loc):
			left_c ?= emit_simple_expr(left)
			right_c ?= emit_simple_expr(right)
			Some(c_binary_expr(op, left_c, right_c))
		UnaryExpr(op, expr_value, typ, loc):
			expr_c ?= emit_simple_expr(expr_value)
			Some("(" + c_unary_operator(op) + expr_c + ")")
		LogicalExpr(op, left, right, typ, loc):
			left_c ?= emit_simple_expr(left)
			right_c ?= emit_simple_expr(right)
			Some("(" + left_c + " " + c_logical_operator(op) + " " + right_c + ")")
		AssignExpr(variable, rhs, typ, loc):
			None
		CastExpr(expr_value, typ, loc):
			expr_c ?= emit_simple_expr(expr_value)
			Some("((" + c_type_name(typ) + ")" + expr_c + ")")
		FieldExpr(expr_value, field_name, typ, loc):
			expr_c ?= emit_simple_expr(expr_value)
			Some(expr_c + "." + field_name)
		LetExpr(name, is_mutable, typ, rhs, body):
			None
		SeqExpr(first, second):
			None
		WhileExpr(cond, body, typ, loc):
			None
		BreakExpr(typ, loc):
			None
		ContinueExpr(typ, loc):
			None
		ResourceScopeExpr(scope, typ, loc):
			None
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			None
		TailrecLoopExpr(params, return_type, body, loc):
			None
		TailrecRecurExpr(args, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			None
		RangeExpr(start, end_value, typ, loc):
			start_c ?= emit_simple_expr(start)
			end_c ?= emit_simple_expr(end_value)
			range_type: String = c_type_name(typ)
			Some(
				"({ " + range_type + " __range_value = { " + start_c + ", " + end_c + " }; __range_value; })",
			)
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			None
		ConstructorMatchExpr(scrutinee, cases, default_body, typ, loc):
			None
		IfExpr(cond, then_expr, else_expr, typ, loc):
			cond_c ?= emit_simple_expr(cond)
			then_c ?= emit_simple_expr(then_expr)
			else_c ?= emit_simple_expr(else_expr)
			Some("(" + cond_c + " ? " + then_c + " : " + else_c + ")")


private pure func terminal_body(statements: String, next_temp: Int) -> FunctionBodyC:
	{
		statements = statements,
		value = "",
		next_temp = next_temp,
		returns = True
	}


private pure func emit_tailrec_recur(
	params: List[CoreParam],
	args: List[CoreExpr],
	next_temp: Int,
) -> Option[FunctionBodyC]:
	if params.length() != args.length():
		None
	else:
		var declarations: String = ""
		var assignments: String = ""
		var index: Int = 0
		var temp_index: Int = next_temp
		var failed: Bool = False

		for arg in args:
			if not failed:
				match params.get(index):
					Some(param):
						match emit_simple_expr(arg):
							Some(arg_c):
								temp: String = temp_name(
									"tailrec_arg_" + index.to_string(),
									temp_index,
								)

								declarations += "  " + c_type_name(
									param.typ,
								) + " " + temp + " = " + arg_c + ";\n"
								assignments += "  " + param.name.name + " = " + temp + ";\n"
								index += 1
								temp_index += 1
							None:
								failed = True
					None:
						failed = True

		if failed:
			None
		else:
			Some(terminal_body(declarations + assignments + "  continue;\n", temp_index))


private pure func emit_tailrec_tail(
	params: List[CoreParam],
	return_type: CoreType,
	expr: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match expr:
		TailrecRecurExpr(args, typ, loc):
			emit_tailrec_recur(params, args, next_temp)
		LetExpr(name, is_mutable, typ, rhs, body):
			if is_void_type(typ):
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_tailrec_tail(params, return_type, body, rhs_c.next_temp)
				Some(terminal_body(discard_body(rhs_c) + body_c.statements, body_c.next_temp))
			else if name.name == "_":
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_tailrec_tail(params, return_type, body, rhs_c.next_temp)
				Some(
					terminal_body(
						rhs_c.statements + "  (void)(" + rhs_c.value + ");\n" + body_c.statements,
						body_c.next_temp,
					),
				)
			else:
				rhs_c ?= emit_simple_expr(rhs)
				body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
				Some(
					terminal_body(
						"  " + c_type_name(
							typ,
						) + " " + name.name + " = " + rhs_c + ";\n" + body_c.statements,
						body_c.next_temp,
					),
				)
		SeqExpr(first, second):
			first_c ?= emit_function_body(first, next_temp)
			second_c ?= emit_tailrec_tail(params, return_type, second, first_c.next_temp)
			Some(terminal_body(discard_body(first_c) + second_c.statements, second_c.next_temp))
		IfExpr(cond, then_expr, else_expr, typ, loc):
			cond_c ?= emit_simple_expr(cond)
			then_c ?= emit_tailrec_tail(params, return_type, then_expr, next_temp)
			else_c ?= emit_tailrec_tail(params, return_type, else_expr, then_c.next_temp)
			Some(
				terminal_body(
					"  if (" + cond_c + ") {\n" + indent_statements(
						then_c.statements,
					) + "  } else {\n" + indent_statements(else_c.statements) + "  }\n",
					else_c.next_temp,
				),
			)
		LiteralExpr(literal, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		VarExpr(variable, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		VoidExpr(typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		CooperativeCheckpointExpr(typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		CallExpr(kind, callee, args, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		BinaryExpr(op, left, right, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		UnaryExpr(op, expr_value, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		LogicalExpr(op, left, right, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		AssignExpr(variable, rhs, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		CastExpr(expr_value, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		FieldExpr(expr_value, field_name, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		WhileExpr(cond, body, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		BreakExpr(typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ContinueExpr(typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ResourceScopeExpr(scope, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TailrecLoopExpr(loop_params, loop_return_type, body, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		RangeExpr(start, end_value, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ConstructorMatchExpr(scrutinee, cases, default_body, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)


private pure func emit_tailrec_return(
	return_type: CoreType,
	expr: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_function_body(expr, next_temp)

	if is_void_type(return_type):
		Some(terminal_body(discard_body(body_c) + "  return;\n", body_c.next_temp))
	else:
		return_value ?= required_body_value(body_c)
		Some(
			terminal_body(
				body_c.statements + "  return " + return_value + ";\n",
				body_c.next_temp,
			),
		)


private pure func emit_tailrec_loop(
	params: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
	Some(
		terminal_body(
			"  while (1) {\n" + indent_statements(body_c.statements) + "  }\n",
			body_c.next_temp,
		),
	)


private pure func static_int_literal(expr: CoreExpr) -> Option[Int]:
	match expr:
		LiteralExpr(literal, typ, loc):
			match literal:
				IntLiteral(value):
					Some(value)
				FloatLiteral(value):
					None
				BoolLiteral(value):
					None
				CharLiteral(value):
					None
				StringLiteral(value):
					None
		VarExpr(variable, typ, loc):
			None
		VoidExpr(typ, loc):
			None
		CooperativeCheckpointExpr(typ, loc):
			None
		CallExpr(kind, callee, args, typ, loc):
			None
		BinaryExpr(op, left, right, typ, loc):
			None
		UnaryExpr(op, expr_value, typ, loc):
			None
		LogicalExpr(op, left, right, typ, loc):
			None
		AssignExpr(variable, rhs, typ, loc):
			None
		CastExpr(expr_value, typ, loc):
			None
		FieldExpr(expr_value, field_name, typ, loc):
			None
		LetExpr(name, is_mutable, typ, rhs, body):
			None
		SeqExpr(first, second):
			None
		WhileExpr(cond, body, typ, loc):
			None
		BreakExpr(typ, loc):
			None
		ContinueExpr(typ, loc):
			None
		ResourceScopeExpr(scope, typ, loc):
			None
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			None
		TailrecLoopExpr(params, return_type, body, loc):
			None
		TailrecRecurExpr(args, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			None
		RangeExpr(start, end_value, typ, loc):
			None
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			None
		ConstructorMatchExpr(scrutinee, cases, default_body, typ, loc):
			None
		IfExpr(cond, then_expr, else_expr, typ, loc):
			None


private pure func range_is_forward_proven(
	direction: CoreLoopRangeDirection,
	start: CoreExpr,
	end_value: CoreExpr,
) -> Bool:
	match direction:
		RangeMayRunBackward:
			match static_int_literal(start):
				Some(start_value):
					match static_int_literal(end_value):
						Some(end_int):
							start_value <= end_int
						None:
							False
				None:
					False
		RangeForwardOnly:
			True


private pure func emit_for_range(
	binder: CoreLoopBinder,
	start: CoreExpr,
	end_value: CoreExpr,
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	start_c ?= emit_simple_expr(start)
	end_c ?= emit_simple_expr(end_value)
	body_c ?= emit_function_body(body, next_temp + 1)
	start_tmp: String = temp_name("range_start", next_temp)
	end_tmp: String = temp_name("range_end", next_temp)
	step_tmp: String = temp_name("range_step", next_temp)
	loop_type: String = c_type_name(binder.typ)
	prefix: String = "  " + loop_type + " " + start_tmp + " = " + start_c + ";\n  " + loop_type + " " + end_tmp + " = " + end_c + ";\n"

	if range_is_forward_proven(binder.range_direction, start, end_value):
		Some({
			statements = prefix + "  for (" + loop_type + " " + binder.variable.name + " = " + start_tmp + "; " + binder.variable.name + " < " + end_tmp + "; " + binder.variable.name + "++) {\n" + indent_statements(
				discard_body(body_c),
			) + "  }\n",
			value = "",
			next_temp = body_c.next_temp,
			returns = False,
		})
	else:
		Some({
			statements = prefix + "  " + loop_type + " " + step_tmp + " = (" + start_tmp + " <= " + end_tmp + ") ? 1 : -1;\n  for (" + loop_type + " " + binder.variable.name + " = " + start_tmp + "; " + binder.variable.name + " != " + end_tmp + "; " + binder.variable.name + " += " + step_tmp + ") {\n" + indent_statements(
				discard_body(body_c),
			) + "  }\n",
			value = "",
			next_temp = body_c.next_temp,
			returns = False,
		})


private pure func core_expr_type(expr: CoreExpr) -> CoreType:
	match expr:
		LiteralExpr(literal, typ, loc):
			typ
		VarExpr(variable, typ, loc):
			typ
		VoidExpr(typ, loc):
			typ
		CooperativeCheckpointExpr(typ, loc):
			typ
		CallExpr(kind, callee, args, typ, loc):
			typ
		BinaryExpr(op, left, right, typ, loc):
			typ
		UnaryExpr(op, expr_value, typ, loc):
			typ
		LogicalExpr(op, left, right, typ, loc):
			typ
		AssignExpr(variable, rhs, typ, loc):
			typ
		CastExpr(expr_value, typ, loc):
			typ
		FieldExpr(expr_value, field_name, typ, loc):
			typ
		LetExpr(name, is_mutable, typ, rhs, body):
			core_expr_type(body)
		SeqExpr(first, second):
			core_expr_type(second)
		WhileExpr(cond, body, typ, loc):
			typ
		BreakExpr(typ, loc):
			typ
		ContinueExpr(typ, loc):
			typ
		ResourceScopeExpr(scope, typ, loc):
			typ
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			typ
		TailrecLoopExpr(params, return_type, body, loc):
			return_type
		TailrecRecurExpr(args, typ, loc):
			typ
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			typ
		RangeExpr(start, end_value, typ, loc):
			typ
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			typ
		ConstructorMatchExpr(scrutinee, cases, default_body, typ, loc):
			typ
		IfExpr(cond, then_expr, else_expr, typ, loc):
			typ


private pure func c_literal_match_test(scrutinee: String, literal: CoreLiteral) -> Option[String]:
	match literal:
		IntLiteral(value):
			Some(scrutinee + " == " + value.to_string())
		FloatLiteral(value):
			Some(scrutinee + " == " + c_float_literal(value))
		BoolLiteral(value):
			if value:
				Some(scrutinee + " == 1")
			else:
				Some(scrutinee + " == 0")
		CharLiteral(value):
			Some(scrutinee + " == " + value.to_string())
		StringLiteral(value):
			None


private pure func emit_literal_match_branch_body(
	result_name: Option[String],
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_function_body(body, next_temp)

	match result_name:
		Some(name):
			value ?= required_body_value(body_c)
			Some({
				statements = body_c.statements + "  " + name + " = " + value + ";\n",
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		None:
			Some({
				statements = statement_body(body, body_c),
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})


private pure func emit_literal_match_failure(next_temp: Int) -> FunctionBodyC:
	terminal_body("  fprintf(stderr, \"blorp: non-exhaustive match\\n\");\n  abort();\n", next_temp)


private pure func emit_literal_match_fallback(
	result_name: Option[String],
	fallback: CoreLiteralMatchFallback,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fallback:
		LiteralMatchFallbackBody(body):
			emit_literal_match_branch_body(result_name, body, next_temp)
		LiteralMatchFallbackFail:
			Some(emit_literal_match_failure(next_temp))


private pure func emit_literal_match(
	scrutinee: CoreExpr,
	cases: List[CoreLiteralMatchCase],
	fallback: CoreLiteralMatchFallback,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	scrutinee_c ?= emit_function_body(scrutinee, next_temp)
	scrutinee_value ?= required_body_value(scrutinee_c)
	scrutinee_temp: String = temp_name("match_scrut", scrutinee_c.next_temp)
	result_temp: String = temp_name("match_result", scrutinee_c.next_temp + 1)
	has_result: Bool = not is_void_type(typ)

	var branch_next_temp: Int = scrutinee_c.next_temp + 1

	if has_result:
		branch_next_temp = scrutinee_c.next_temp + 2

	result_name: Option[String] = if has_result:
		Some(result_temp)
	else:
		None

	var branch_statements: String = ""
	var failed: Bool = False
	var has_case: Bool = False

	for match_case in cases:
		if not failed:
			match c_literal_match_test(scrutinee_temp, match_case.literal):
				Some(test):
					match emit_literal_match_branch_body(
						result_name,
						match_case.body,
						branch_next_temp,
					):
						Some(case_c):
							if has_case:
								branch_statements += "  } else if (" + test + ") {\n"
							else:
								branch_statements += "  if (" + test + ") {\n"

							branch_statements += indent_statements(case_c.statements)
							branch_next_temp = case_c.next_temp
							has_case = True
						None:
							failed = True
				None:
					failed = True

	if failed:
		None
	else:
		fallback_c ?= emit_literal_match_fallback(result_name, fallback, branch_next_temp)
		scrutinee_type: String = c_type_name(core_expr_type(scrutinee))
		prefix: String = scrutinee_c.statements + "  " + scrutinee_type + " " + scrutinee_temp + " = " + scrutinee_value + ";\n"
		var result_decl: String = ""

		if has_result:
			result_decl = "  " + c_type_name(typ) + " " + result_temp + ";\n"

		var match_statements: String = fallback_c.statements

		if has_case:
			match_statements = branch_statements + "  } else {\n" + indent_statements(
				fallback_c.statements,
			) + "  }\n"

		var result_value: String = ""

		if has_result:
			result_value = result_temp

		Some({
			statements = prefix + result_decl + match_statements,
			value = result_value,
			next_temp = fallback_c.next_temp,
			returns = False,
		})


private pure func emit_constructor_match_fallback(
	result_name: Option[String],
	fallback: CoreConstructorMatchFallback,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			emit_literal_match_branch_body(result_name, body, next_temp)
		ConstructorMatchFallbackFail:
			Some(emit_literal_match_failure(next_temp))


private pure func emit_constructor_match(
	scrutinee: CoreExpr,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	scrutinee_c ?= emit_function_body(scrutinee, next_temp)
	scrutinee_value ?= required_body_value(scrutinee_c)
	scrutinee_temp: String = temp_name("match_scrut", scrutinee_c.next_temp)
	result_temp: String = temp_name("match_result", scrutinee_c.next_temp + 1)
	has_result: Bool = not is_void_type(typ)

	var branch_next_temp: Int = scrutinee_c.next_temp + 1

	if has_result:
		branch_next_temp = scrutinee_c.next_temp + 2

	result_name: Option[String] = if has_result:
		Some(result_temp)
	else:
		None

	var branch_statements: String = ""
	var failed: Bool = False
	var has_case: Bool = False

	for match_case in cases:
		if not failed:
			test: String = scrutinee_temp + " == " + match_case.constructor_c_name

			match emit_literal_match_branch_body(result_name, match_case.body, branch_next_temp):
				Some(case_c):
					if has_case:
						branch_statements += "  } else if (" + test + ") {\n"
					else:
						branch_statements += "  if (" + test + ") {\n"

					branch_statements += indent_statements(case_c.statements)
					branch_next_temp = case_c.next_temp
					has_case = True
				None:
					failed = True

	if failed:
		None
	else:
		fallback_c ?= emit_constructor_match_fallback(result_name, fallback, branch_next_temp)
		scrutinee_type: String = c_type_name(core_expr_type(scrutinee))
		prefix: String = scrutinee_c.statements + "  " + scrutinee_type + " " + scrutinee_temp + " = " + scrutinee_value + ";\n"
		var result_decl: String = ""

		if has_result:
			result_decl = "  " + c_type_name(typ) + " " + result_temp + ";\n"

		var match_statements: String = fallback_c.statements

		if has_case:
			match_statements = branch_statements + "  } else {\n" + indent_statements(
				fallback_c.statements,
			) + "  }\n"

		var result_value: String = ""

		if has_result:
			result_value = result_temp

		Some({
			statements = prefix + result_decl + match_statements,
			value = result_value,
			next_temp = fallback_c.next_temp,
			returns = False,
		})


private pure func emit_function_body(expr: CoreExpr, next_temp: Int) -> Option[FunctionBodyC]:
	match expr:
		LetExpr(name, is_mutable, typ, rhs, body):
			if is_void_type(typ):
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_function_body(body, rhs_c.next_temp)
				Some({
					statements = discard_body(rhs_c) + body_c.statements,
					value = body_c.value,
					next_temp = body_c.next_temp,
					returns = body_c.returns,
				})
			else if name.name == "_":
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_function_body(body, rhs_c.next_temp)
				Some({
					statements = rhs_c.statements + "  (void)(" + rhs_c.value + ");\n" + body_c.statements,
					value = body_c.value,
					next_temp = body_c.next_temp,
					returns = body_c.returns,
				})
			else:
				rhs_c ?= emit_simple_expr(rhs)
				body_c ?= emit_function_body(body, next_temp)
				Some({
					statements = "  " + c_type_name(
						typ,
					) + " " + name.name + " = " + rhs_c + ";\n" + body_c.statements,
					value = body_c.value,
					next_temp = body_c.next_temp,
					returns = body_c.returns,
				})
		LiteralExpr(literal, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		VarExpr(variable, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		VoidExpr(typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		CooperativeCheckpointExpr(typ, loc):
			Some({
				statements = "  blorp_cooperative_checkpoint();\n",
				value = "",
				next_temp = next_temp,
				returns = False,
			})
		CallExpr(kind, callee, args, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		BinaryExpr(op, left, right, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		UnaryExpr(op, expr_value, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		LogicalExpr(op, left, right, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		AssignExpr(variable, rhs, typ, loc):
			rhs_c ?= emit_function_body(rhs, next_temp)
			Some({
				statements = rhs_c.statements + "  " + variable.name + " = " + rhs_c.value + ";\n",
				value = "",
				next_temp = rhs_c.next_temp,
				returns = False,
			})
		CastExpr(expr_value, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		FieldExpr(expr_value, field_name, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		SeqExpr(first, second):
			first_c ?= emit_function_body(first, next_temp)
			second_c ?= emit_function_body(second, first_c.next_temp)
			Some({
				statements = discard_body(first_c) + second_c.statements,
				value = second_c.value,
				next_temp = second_c.next_temp,
				returns = second_c.returns,
			})
		WhileExpr(cond, body, typ, loc):
			cond_c ?= emit_simple_expr(cond)
			body_c ?= emit_function_body(body, next_temp)
			Some({
				statements = "  while (" + cond_c + ") {\n" + indent_statements(
					discard_body(body_c),
				) + "  }\n",
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		BreakExpr(typ, loc):
			Some({
				statements = "  break;\n",
				value = "",
				next_temp = next_temp,
				returns = False,
			})
		ContinueExpr(typ, loc):
			Some({
				statements = "  continue;\n",
				value = "",
				next_temp = next_temp,
				returns = False,
			})
		ResourceScopeExpr(scope, typ, loc):
			None
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			None
		TailrecLoopExpr(params, return_type, body, loc):
			emit_tailrec_loop(params, return_type, body, next_temp)
		TailrecRecurExpr(args, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			emit_for_range(binder, start, end_value, body, next_temp)
		RangeExpr(start, end_value, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			emit_literal_match(scrutinee, cases, fallback, typ, next_temp)
		ConstructorMatchExpr(scrutinee, cases, fallback, typ, loc):
			emit_constructor_match(scrutinee, cases, fallback, typ, next_temp)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					cond_c ?= emit_simple_expr(cond)

					if is_void_type(typ):
						then_c ?= emit_function_body(then_expr, next_temp)
						else_c ?= emit_function_body(else_expr, then_c.next_temp)
						else_statements: String = statement_body(else_expr, else_c)

						if else_statements == "":
							Some({
								statements = "  if (" + cond_c + ") {\n" + indent_statements(
									statement_body(
										then_expr,
										then_c,
									),
								) + "  }\n",
								value = "",
								next_temp = else_c.next_temp,
								returns = False,
							})
						else:
							Some({
								statements = "  if (" + cond_c + ") {\n" + indent_statements(
									statement_body(
										then_expr,
										then_c,
									),
								) + "  } else {\n" + indent_statements(else_statements) + "  }\n",
								value = "",
								next_temp = else_c.next_temp,
								returns = False,
							})
					else:
						temp: String = temp_name("if_result", next_temp)
						then_c ?= emit_function_body(then_expr, next_temp + 1)
						else_c ?= emit_function_body(else_expr, then_c.next_temp)
						then_value ?= required_body_value(then_c)
						else_value ?= required_body_value(else_c)
						Some({
							statements = "  " + c_type_name(
								typ,
							) + " " + temp + ";\n  if (" + cond_c + ") {\n" + indent_statements(
								then_c.statements,
							) + "    " + temp + " = " + then_value + ";\n  } else {\n" + indent_statements(
								else_c.statements,
							) + "    " + temp + " = " + else_value + ";\n  }\n",
							value = temp,
							next_temp = else_c.next_temp,
							returns = False,
						})


private pure func emit_supported_user_function(func_info: CoreFunction) -> Option[String]:
	match func_info.body:
		Some(body):
			match emit_function_body(body, 0):
				Some(body_c):
					prefix: String = c_function_signature(func_info) + " {\n"
					body_prelude: String = entrypoint_arg_prelude(func_info)

					if is_void_type(func_info.return_type):
						Some(prefix + body_prelude + discard_body(body_c) + "}\n")
					else:
						match required_body_value(body_c):
							Some(return_value):
								Some(
									prefix + body_prelude + body_c.statements + "  return " + return_value + ";\n}\n",
								)
							None:
								if body_c.returns:
									Some(prefix + body_prelude + body_c.statements + "}\n")
								else:
									None
				None:
					None
		None:
			None


private pure func emit_function(func_info: CoreFunction) -> String:
	match func_info.function_kind:
		UserFunction:
			match emit_supported_user_function(func_info):
				Some(c_code):
					c_code
				None:
					emit_function_inventory(func_info)
		BuiltinFunction:
			emit_function_inventory(func_info)
		ForeignFunction:
			emit_function_inventory(func_info)
		ClosureBodyFunction:
			emit_function_inventory(func_info)


private pure func emit_function_forward_decl(func_info: CoreFunction) -> String:
	match func_info.function_kind:
		UserFunction:
			match func_info.body:
				Some(body):
					if is_entrypoint(func_info):
						""
					else:
						c_function_signature(func_info) + ";\n"
				None:
					""
		BuiltinFunction:
			""
		ForeignFunction:
			""
		ClosureBodyFunction:
			""


private pure func emit_enum_variant(variant: CoreEnumVariant) -> String:
	"#define " + variant.c_name + " " + variant.tag.to_string() + "L\n"


private pure func emit_enum_decl(enum_decl: CoreEnumDecl) -> String:
	var c_code: String = ""

	for variant in enum_decl.variants:
		c_code += emit_enum_variant(variant)

	c_code


private pure func emit_static_global_init_expr(init: CoreExpr) -> Option[String]:
	match init:
		LiteralExpr(literal, typ, loc):
			match literal:
				IntLiteral(value):
					Some(value.to_string() + "L")
				FloatLiteral(value):
					emit_simple_expr(init)
				BoolLiteral(value):
					emit_simple_expr(init)
				CharLiteral(value):
					emit_simple_expr(init)
				StringLiteral(value):
					emit_simple_expr(init)
		VarExpr(variable, typ, loc):
			emit_simple_expr(init)
		VoidExpr(typ, loc):
			emit_simple_expr(init)
		CooperativeCheckpointExpr(typ, loc):
			emit_simple_expr(init)
		CallExpr(kind, callee, args, typ, loc):
			emit_simple_expr(init)
		BinaryExpr(op, left, right, typ, loc):
			emit_simple_expr(init)
		UnaryExpr(op, expr_value, typ, loc):
			emit_simple_expr(init)
		LogicalExpr(op, left, right, typ, loc):
			emit_simple_expr(init)
		AssignExpr(variable, rhs, typ, loc):
			emit_simple_expr(init)
		CastExpr(expr_value, typ, loc):
			emit_simple_expr(init)
		FieldExpr(expr_value, field_name, typ, loc):
			emit_simple_expr(init)
		LetExpr(name, is_mutable, typ, rhs, body):
			emit_simple_expr(init)
		SeqExpr(first, second):
			emit_simple_expr(init)
		WhileExpr(cond, body, typ, loc):
			emit_simple_expr(init)
		BreakExpr(typ, loc):
			emit_simple_expr(init)
		ContinueExpr(typ, loc):
			emit_simple_expr(init)
		ResourceScopeExpr(scope, typ, loc):
			emit_simple_expr(init)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			emit_simple_expr(init)
		TailrecLoopExpr(params, return_type, body, loc):
			emit_simple_expr(init)
		TailrecRecurExpr(args, typ, loc):
			emit_simple_expr(init)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			emit_simple_expr(init)
		RangeExpr(start, end_value, typ, loc):
			emit_simple_expr(init)
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			emit_simple_expr(init)
		ConstructorMatchExpr(scrutinee, cases, default_body, typ, loc):
			emit_simple_expr(init)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			emit_simple_expr(init)


private pure func emit_global_decl(global: CoreGlobal) -> String:
	match emit_static_global_init_expr(global.init):
		Some(init_c):
			"static " + c_type_name(global.typ) + " " + global.name.name + " = " + init_c + ";\n\n"
		None:
			"/* unsupported global " + global.name.name + " */\n"


private pure func c_value_record_field_decl(field: CoreValueRecordField) -> String:
	c_type_name(field.typ) + " " + field.name + "; "


private pure func c_value_record_make_param(field: CoreValueRecordField) -> String:
	c_type_name(field.typ) + " " + field.name


private pure func emit_value_record_decl(record_decl: CoreValueRecordDecl) -> String:
	var fields_c: String = ""
	var params: List[String] = []
	var init_fields: List[String] = []

	for field in record_decl.fields:
		fields_c += c_value_record_field_decl(field)
		params = params.append(c_value_record_make_param(field))
		init_fields = init_fields.append(field.name)

	param_c: String = if params.length() == 0:
		"void"
	else:
		params.join(", ")

	"typedef struct { " + fields_c + "} " + record_decl.name + ";\nstatic inline " + record_decl.name + " " + record_decl.name + "_make(" + param_c + ") { " + record_decl.name + " __r = { " + init_fields.join(
		", ",
	) + " }; return __r; }\n\n"


private pure func emit_value_record_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			ValueRecordDecl(record_decl):
				c_code += emit_value_record_decl(record_decl)
			EnumDecl(enum_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_enum_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			EnumDecl(enum_decl):
				c_code += emit_enum_decl(enum_decl)
			ValueRecordDecl(record_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_global_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			GlobalDecl(global):
				c_code += emit_global_decl(global)
			EnumDecl(enum_decl):
				void
			ValueRecordDecl(record_decl):
				void
			FunctionDecl(func_info):
				void

	c_code


private pure func emit_function_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			FunctionDecl(func_info):
				c_code += emit_function(func_info)
			EnumDecl(enum_decl):
				void
			ValueRecordDecl(record_decl):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_function_forward_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			FunctionDecl(func_info):
				c_code += emit_function_forward_decl(func_info)
			EnumDecl(enum_decl):
				void
			ValueRecordDecl(record_decl):
				void
			GlobalDecl(global):
				void

	if c_code == "":
		""
	else:
		c_code + "\n"


private pure func emit_decls(decls: List[CoreDecl]) -> String:
	emit_value_record_decls(
		decls,
	) + emit_enum_decls(
		decls,
	) + emit_global_decls(decls) + emit_function_forward_decls(decls) + emit_function_decls(decls)


pure func emit_core_program_c_artifact(program: CoreProgram) -> CArtifact:
	resource_program: CoreProgram = rewrite_resource_program(program)
	checked_program: CoreProgram = add_program_checkpoints(resource_program)
	{
		c_code = C_ARTIFACT_HEADER + emit_decls(checked_program.decls),
		link_flags = [],
		include_dirs = []
	}
