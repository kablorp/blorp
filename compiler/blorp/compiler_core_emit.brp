-- First Blorp-owned final-Core-to-C artifact surface.
--
-- This intentionally starts as a valid-C skeleton. The production migration
-- can replace each inventory comment with real C emission while preserving the
-- same typed CoreProgram -> CArtifact boundary.
import:
	codegen_intrinsic_renderer as Intrinsic
	codegen_prepared_backend_renderer:
		CustomCtorArgs,
		DictConstructWithBodyArgs,
		ElemReleaseArg(ElemReleaseFn, NoElemRelease),
		PreparedBackendOp(
			BackendFlatIterLoopHeader,
			BackendFlatIterSourceBinding,
			BackendDictConstructEmpty,
			BackendDictConstructWithBody,
			BackendDictCtorCustom,
			BackendDictCtorFloat,
			BackendDictCtorGeneric,
			BackendDictCtorString,
			BackendDictInsert,
			BackendDictValueReleaseInit,
			BackendSetCtorCustom,
			BackendSetCtorFloat,
			BackendSetCtorGeneric,
			BackendSetCtorString,
		),
		render_prepared_backend_op,
	codegen_prepared_list_renderer:
		InlineBitsStoreArgs,
		InlineStructStoreArgs,
		InlineStructStoreBoxing(StackResultBoxing, StructAddressBoxing),
		ListHandoffBorrowSuffixArgs,
		ListHandoffPrefixArgs,
		ListHandoffReuseSuffixArgs,
		PointerStoreArgs,
		PreparedListOp(
			HandoffSetSourceSlot,
			InlineBitsStore,
			InlineStructHandoffSetOwnedStore,
			ListElementReleaseFn,
			ListElementReleaseNone,
			ListElementSizeInlineStruct,
			ListElementSizePointer,
			ListHandoffBorrowPrefix,
			ListHandoffBorrowSuffix,
			ListHandoffReusePrefix,
			ListHandoffReuseSuffix,
			ListStorageModeInline,
			ListStorageModePointer,
			PointerHandoffSetOwnedStore,
		),
		SourceSlotHandoffArgs,
		render_prepared_list_op,
	codegen_prepared_tensor_renderer:
		PreparedTensorOp(RawRead, RawViewDecl, RawWriteExpr),
		RawViewDeclArgs,
		RawWriteArgs,
		render_prepared_tensor_op,
	codegen_prepared_tuple_renderer:
		PreparedTupleOp(TupleConstruct, TupleConstructWithRc, TupleName, TupleRetainElem),
		TupleConstructArgs,
		TupleConstructWithRcArgs,
		TupleRetainElemArgs,
		render_prepared_tuple_op,
	compiler_artifact_json: CArtifact
	compiler_core_fairness as CoreFairness
	compiler_core_json:
		CoreAccessor(
			NullableOptionPayloadAccessor,
			RootAccessor,
			StackOptionPayloadAccessor,
			VariantFieldAccessor,
		),
		CoreBinaryOp(
			AddOp,
			DivideOp,
			EqualOp,
			GreaterEqualOp,
			GreaterOp,
			LessOp,
			LessEqualOp,
			ModuloOp,
			MultiplyOp,
			NotEqualOp,
			SubtractOp,
		),
		CoreBoxKind(PointerBox, PrimBox, StructBox, VoidBox),
		CoreBoxOp,
		CoreBoxedStorageValue,
		CoreCallKind(BuiltinCall, ClosureCall, ForeignCall, IntrinsicCall, UserCall),
		CoreClosureAbi,
		CoreClosureCapture,
		CoreClosureCreate,
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(ConstructorMatchFallbackBody, ConstructorMatchFallbackFail),
		CoreConstructorMatchTest(
			EnumConstructorTest,
			NullableOptionNoneConstructorTest,
			NullableOptionSomeConstructorTest,
			StackOptionNoneConstructorTest,
			StackOptionSomeConstructorTest,
			UnionTagConstructorTest,
		),
		CoreDecl(EnumDecl, FunctionDecl, GlobalDecl, HeapRecordDecl, UnionDecl, ValueRecordDecl),
		CoreDictConstruct,
		CoreDictEntry,
		CoreEnumDecl,
		CoreEnumVariant,
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			BoxExpr,
			BreakExpr,
			CastExpr,
			CallExpr,
			ClosureCreateExpr,
			ConstructorMatchExpr,
			CooperativeCheckpointExpr,
			ContinueExpr,
			DictConstructExpr,
			DupExpr,
			DropExpr,
			FieldExpr,
			ForListExpr,
			ForRangeExpr,
			IfExpr,
			LetExpr,
			ListAllocExpr,
			ListConstructExpr,
			ListGetExpr,
			ListHandoffExpr,
			ListHandoffSetOwnedExpr,
			ListHandoffSetSourceSlotExpr,
			ListRetainExpr,
			ListSetExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			RangeExpr,
			RecordExpr,
			RecordConstructExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SeqExpr,
			SetAllocExpr,
			StringByteCopyExpr,
			StringByteReadExpr,
			StringByteWriteExpr,
			StringSetLenExpr,
