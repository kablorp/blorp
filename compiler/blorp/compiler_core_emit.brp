private pure func range_is_forward_proven(
	direction: CoreLoopRangeDirection,
	start: CoreExpr,
	end_value: CoreExpr,
) -> Bool:
	match direction:
		RangeMayRunBackward:
			match static_int_literal(start):
				Some(start_value):
					match static_int_literal(end_value):
						Some(end_int):
							start_value <= end_int
						None:
							False
				None:
					False
		RangeForwardOnly:
			True


private pure func emit_for_range(
	binder: CoreLoopBinder,
	start: CoreExpr,
	end_value: CoreExpr,
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	start_c ?= emit_simple_expr(start)
	end_c ?= emit_simple_expr(end_value)
	body_c ?= emit_function_body(body, next_temp + 1)
	start_tmp: String = temp_name("range_start", next_temp)
	end_tmp: String = temp_name("range_end", next_temp)
	step_tmp: String = temp_name("range_step", next_temp)
	loop_type: String = c_type_name(binder.typ)
	prefix: String = "  " + loop_type + " " + start_tmp + " = " + start_c + ";\n  " + loop_type + " " + end_tmp + " = " + end_c + ";\n"

	if range_is_forward_proven(binder.range_direction, start, end_value):
		Some({
			statements = prefix + "  for (" + loop_type + " " + c_var_name(
				binder.variable,
			) + " = " + start_tmp + "; " + c_var_name(
				binder.variable,
			) + " < " + end_tmp + "; " + c_var_name(
				binder.variable,
			) + "++) {\n" + indent_statements(statement_body(body, body_c)) + "  }\n",
			value = "",
			next_temp = body_c.next_temp,
			returns = False,
		})
	else:
		Some({
			statements = prefix + "  " + loop_type + " " + step_tmp + " = (" + start_tmp + " <= " + end_tmp + ") ? 1 : -1;\n  for (" + loop_type + " " + c_var_name(
				binder.variable,
			) + " = " + start_tmp + "; " + c_var_name(
				binder.variable,
			) + " != " + end_tmp + "; " + c_var_name(
				binder.variable,
			) + " += " + step_tmp + ") {\n" + indent_statements(
				statement_body(
					body,
					body_c,
				),
			) + "  }\n",
			value = "",
			next_temp = body_c.next_temp,
			returns = False,
		})


private pure func is_scalar_boxed_value_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			(
				name == "Int"
				or name == "Int8"
				or name == "Int16"
				or name == "Int32"
				or name == "Int64"
				or name == "UInt8"
				or name == "UInt16"
				or name == "UInt32"
				or name == "UInt64"
				or name == "Bool"
				or name == "Char"
			)
		EnumType(name):
			True
		VoidType:
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TupleType(items):
			False


private pure func pointer_list_loop_binding(
	binder: CoreLoopBinder,
	iter_tmp: String,
	index_tmp: String,
) -> String:
	value_c: String = "blorp_list_get(" + iter_tmp + ", " + index_tmp + ")"
	binding_type: String = c_type_name(binder.typ)

	if is_scalar_boxed_value_type(binder.typ):
		binding_type + " " + c_var_name(
			binder.variable,
		) + " = (" + binding_type + ")(long)" + value_c + ";\n"
	else:
		binding_type + " " + c_var_name(
			binder.variable,
		) + " = (" + binding_type + ")" + value_c + ";\n"


private pure func emit_for_list(for_list: CoreForList, next_temp: Int) -> Option[FunctionBodyC]:
	match for_list.layout:
		PointerListStorage:
			iterable_c ?= emit_simple_expr(for_list.iterable)
			iter_tmp: String = temp_name("iter", next_temp)
			len_tmp: String = temp_name("len", next_temp)
			index_tmp: String = temp_name("i", next_temp)
			body_c ?= emit_function_body(for_list.body, next_temp + 1)
			source_binding: String = render_prepared_backend_op(BackendFlatIterSourceBinding({
				iter_c_type = "blorp_List*",
				iter = iter_tmp,
				source = iterable_c,
			}))
			loop_header: String = render_prepared_backend_op(BackendFlatIterLoopHeader({
				length = len_tmp,
				iter = iter_tmp,
				index = index_tmp,
			}))
			loop_body: String = pointer_list_loop_binding(
				for_list.binder,
				iter_tmp,
				index_tmp,
			) + statement_body(for_list.body, body_c)

			Some({
				statements = indent_statements(
					source_binding + "\n" + loop_header,
				) + indent_statements(loop_body) + "  }\n",
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		InlineListStorage(width_bytes):
			None
		InlineStructListStorage(c_type):
			None


private pure func core_expr_type(expr: CoreExpr) -> CoreType:
	match expr:
		LiteralExpr(literal, typ, loc):
			typ
		VarExpr(variable, typ, loc):
			typ
		VoidExpr(typ, loc):
			typ
		CooperativeCheckpointExpr(typ, loc):
			typ
		CallExpr(kind, callee, args, typ, loc):
			typ
		BinaryExpr(op, left, right, typ, loc):
			typ
		UnaryExpr(op, expr_value, typ, loc):
			typ
		LogicalExpr(op, left, right, typ, loc):
			typ
		AssignExpr(variable, rhs, typ, loc):
			typ
		CastExpr(expr_value, typ, loc):
			typ
		BoxExpr(box, typ, loc):
			typ
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			typ
		FieldExpr(expr_value, field_name, typ, loc):
			typ
		TupleFieldExpr(expr_value, field_index, typ, loc):
			typ
		TupleExpr(items, typ, loc):
			typ
		TupleConstructExpr(tuple_construct, typ, loc):
			typ
		ClosureCreateExpr(closure, typ, loc):
			typ
		ListConstructExpr(construct, typ, loc):
			typ
		ListAllocExpr(alloc, typ, loc):
			typ
		ListGetExpr(get, typ, loc):
			typ
		ListHandoffExpr(handoff, typ, loc):
			typ
		ListHandoffSetOwnedExpr(set, typ, loc):
			typ
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			typ
		StringByteReadExpr(read, typ, loc):
			typ
		StringByteWriteExpr(write, typ, loc):
			typ
		StringByteCopyExpr(copy, typ, loc):
			typ
		StringSetLenExpr(set_len, typ, loc):
			typ
		TensorRawReadExpr(read, typ, loc):
			typ
		TensorRawWriteExpr(write, typ, loc):
			typ
		TensorRawViewLetExpr(binding, body, typ, loc):
			typ
		DictConstructExpr(construct, typ, loc):
			typ
		SetAllocExpr(alloc, typ, loc):
			typ
		ListRetainExpr(retain, typ, loc):
			typ
		ListSetExpr(set, typ, loc):
			typ
		RecordExpr(fields, typ, loc):
			typ
		RecordConstructExpr(type_name, fields, typ, loc):
			typ
		UnionConstructExpr(construct, typ, loc):
			typ
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			typ
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			typ
		LetExpr(name, is_mutable, typ, rhs, body):
			core_expr_type(body)
		SeqExpr(first, second):
			core_expr_type(second)
		WhileExpr(cond, body, typ, loc):
			typ
		BreakExpr(typ, loc):
			typ
		ContinueExpr(typ, loc):
			typ
		ResourceScopeExpr(scope, typ, loc):
			typ
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			typ
		TailrecLoopExpr(params, return_type, body, loc):
			return_type
		TailrecRecurExpr(args, typ, loc):
			typ
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			typ
		ForListExpr(for_list, typ, loc):
			typ
		RangeExpr(start, end_value, typ, loc):
			typ
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			typ
		ConstructorMatchExpr(scrutinee, cases, default_body, typ, loc):
			typ
		IfExpr(cond, then_expr, else_expr, typ, loc):
			typ


private pure func c_literal_match_test(scrutinee: String, literal: CoreLiteral) -> Option[String]:
	match literal:
		IntLiteral(value):
			Some(scrutinee + " == " + value.to_string())
		FloatLiteral(value):
			Some(scrutinee + " == " + c_float_literal(value))
		BoolLiteral(value):
			if value:
				Some(scrutinee + " == 1")
			else:
				Some(scrutinee + " == 0")
		CharLiteral(value):
			Some(scrutinee + " == " + value.to_string())
		StringLiteral(value):
			None


private pure func emit_literal_match_branch_body(
	result_name: Option[String],
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_function_body(body, next_temp)

	match result_name:
		Some(name):
			value ?= required_body_value(body_c)
			Some({
				statements = body_c.statements + "  " + name + " = " + value + ";\n",
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		None:
			Some({
				statements = statement_body(body, body_c),
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})


private pure func emit_constructor_match_test(
	scrutinee_temp: String,
	test: CoreConstructorMatchTest,
) -> String:
	match test:
		EnumConstructorTest(c_name):
			scrutinee_temp + " == " + c_name
		UnionTagConstructorTest(tag_c_name):
			scrutinee_temp + "->tag == " + tag_c_name
		NullableOptionSomeConstructorTest:
			scrutinee_temp + " != NULL"
		NullableOptionNoneConstructorTest:
			scrutinee_temp + " == NULL"
		StackOptionSomeConstructorTest:
			scrutinee_temp + ".tag == BLORP_TAG_SOME"
		StackOptionNoneConstructorTest:
			scrutinee_temp + ".tag == BLORP_TAG_NONE"


private pure func emit_match_accessor(
	scrutinee_temp: String,
	accessor: CoreAccessor,
) -> Option[String]:
	match accessor:
		RootAccessor:
			Some(scrutinee_temp)
		VariantFieldAccessor(parent, constructor, field_index):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(parent_c + "->data." + constructor + ".field" + field_index.to_string())
		NullableOptionPayloadAccessor(parent):
			emit_match_accessor(scrutinee_temp, parent)
		StackOptionPayloadAccessor(parent):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(parent_c + ".value")


private pure func emit_match_binding(
	scrutinee_temp: String,
	binding: CoreMatchBinding,
) -> Option[String]:
	mode: CoreMatchBindingMode = binding.mode

	match mode:
		MatchBorrowBindingMode:
			source_c ?= emit_match_accessor(scrutinee_temp, binding.accessor)
			Some(
				"  " + c_type_name(
					binding.typ,
				) + " " + c_var_name(binding.variable) + " = " + source_c + ";\n",
			)
		MatchOwnBindingMode:
			None


private pure func emit_match_bindings(
	scrutinee_temp: String,
	bindings: List[CoreMatchBinding],
) -> Option[String]:
	var statements: String = ""
	var failed: Bool = False

	for binding in bindings:
		if not failed:
			match emit_match_binding(scrutinee_temp, binding):
				Some(statement):
					statements += statement
				None:
					failed = True

	if failed:
		None
	else:
		Some(statements)


private pure func emit_constructor_match_branch_body(
	scrutinee_temp: String,
	result_name: Option[String],
	match_case: CoreConstructorMatchCase,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	bindings_c ?= emit_match_bindings(scrutinee_temp, match_case.bindings)
	body_c ?= emit_literal_match_branch_body(result_name, match_case.body, next_temp)

	Some({
		statements = bindings_c + body_c.statements,
		value = body_c.value,
		next_temp = body_c.next_temp,
		returns = body_c.returns,
	})


private pure func emit_literal_match_failure(next_temp: Int) -> FunctionBodyC:
	terminal_body("  fprintf(stderr, \"blorp: non-exhaustive match\\n\");\n  abort();\n", next_temp)


private pure func emit_literal_match_fallback(
	result_name: Option[String],
	fallback: CoreLiteralMatchFallback,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fallback:
		LiteralMatchFallbackBody(body):
			emit_literal_match_branch_body(result_name, body, next_temp)
		LiteralMatchFallbackFail:
			Some(emit_literal_match_failure(next_temp))


private pure func emit_literal_match(
	scrutinee: CoreExpr,
	cases: List[CoreLiteralMatchCase],
	fallback: CoreLiteralMatchFallback,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	scrutinee_c ?= emit_function_body(scrutinee, next_temp)
	scrutinee_value ?= required_body_value(scrutinee_c)
	scrutinee_temp: String = temp_name("match_scrut", scrutinee_c.next_temp)
	result_temp: String = temp_name("match_result", scrutinee_c.next_temp + 1)
	has_result: Bool = not is_void_type(typ)

	var branch_next_temp: Int = scrutinee_c.next_temp + 1

	if has_result:
		branch_next_temp = scrutinee_c.next_temp + 2

	result_name: Option[String] = if has_result:
		Some(result_temp)
	else:
		None

	var branch_statements: String = ""
	var failed: Bool = False
	var has_case: Bool = False

	for match_case in cases:
		if not failed:
			match c_literal_match_test(scrutinee_temp, match_case.literal):
				Some(test):
					match emit_literal_match_branch_body(
						result_name,
						match_case.body,
						branch_next_temp,
					):
						Some(case_c):
							if has_case:
								branch_statements += "  } else if (" + test + ") {\n"
							else:
								branch_statements += "  if (" + test + ") {\n"

							branch_statements += indent_statements(case_c.statements)
							branch_next_temp = case_c.next_temp
							has_case = True
						None:
							failed = True
				None:
					failed = True

	if failed:
		None
	else:
		fallback_c ?= emit_literal_match_fallback(result_name, fallback, branch_next_temp)
		scrutinee_type: String = c_type_name(core_expr_type(scrutinee))
		prefix: String = scrutinee_c.statements + "  " + scrutinee_type + " " + scrutinee_temp + " = " + scrutinee_value + ";\n"
		var result_decl: String = ""

		if has_result:
			result_decl = "  " + c_type_name(typ) + " " + result_temp + ";\n"

		var match_statements: String = fallback_c.statements

		if has_case:
			match_statements = branch_statements + "  } else {\n" + indent_statements(
				fallback_c.statements,
			) + "  }\n"

		var result_value: String = ""

		if has_result:
			result_value = result_temp

		Some({
			statements = prefix + result_decl + match_statements,
			value = result_value,
			next_temp = fallback_c.next_temp,
			returns = False,
		})


private pure func emit_constructor_match_fallback(
	result_name: Option[String],
	fallback: CoreConstructorMatchFallback,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			emit_literal_match_branch_body(result_name, body, next_temp)
		ConstructorMatchFallbackFail:
			Some(emit_literal_match_failure(next_temp))


private pure func emit_constructor_match(
	scrutinee: CoreExpr,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	scrutinee_c ?= emit_function_body(scrutinee, next_temp)
	scrutinee_value ?= required_body_value(scrutinee_c)
	scrutinee_temp: String = temp_name("match_scrut", scrutinee_c.next_temp)
	result_temp: String = temp_name("match_result", scrutinee_c.next_temp + 1)
	has_result: Bool = not is_void_type(typ)

	var branch_next_temp: Int = scrutinee_c.next_temp + 1

	if has_result:
		branch_next_temp = scrutinee_c.next_temp + 2

	result_name: Option[String] = if has_result:
		Some(result_temp)
	else:
		None

	var branch_statements: String = ""
	var failed: Bool = False
	var has_case: Bool = False

	for match_case in cases:
		if not failed:
			test: String = emit_constructor_match_test(scrutinee_temp, match_case.test)

			match emit_constructor_match_branch_body(
				scrutinee_temp,
				result_name,
				match_case,
				branch_next_temp,
			):
				Some(case_c):
					if has_case:
						branch_statements += "  } else if (" + test + ") {\n"
					else:
						branch_statements += "  if (" + test + ") {\n"

					branch_statements += indent_statements(case_c.statements)
					branch_next_temp = case_c.next_temp
					has_case = True
				None:
					failed = True

	if failed:
		None
	else:
		fallback_c ?= emit_constructor_match_fallback(result_name, fallback, branch_next_temp)
		scrutinee_type: String = c_type_name(core_expr_type(scrutinee))
		prefix: String = scrutinee_c.statements + "  " + scrutinee_type + " " + scrutinee_temp + " = " + scrutinee_value + ";\n"
		var result_decl: String = ""

		if has_result:
			result_decl = "  " + c_type_name(typ) + " " + result_temp + ";\n"

		var match_statements: String = fallback_c.statements

		if has_case:
			match_statements = branch_statements + "  } else {\n" + indent_statements(
				fallback_c.statements,
			) + "  }\n"

		var result_value: String = ""

		if has_result:
			result_value = result_temp

		Some({
			statements = prefix + result_decl + match_statements,
			value = result_value,
			next_temp = fallback_c.next_temp,
			returns = False,
		})


private pure func emit_resource_cleanups(
	cleanups: List[CoreExpr],
	next_temp: Int,
) -> Option[FunctionBodyC]:
	var statements: String = ""
	var current_temp: Int = next_temp
	var failed: Bool = False

	for cleanup in cleanups:
		if not failed:
			match resource_cleanup_hook(cleanup):
				Some(hook):
					statements += cancellation_cleanup_pop_statement(hook.variable)
				None:
					statements = statements

			match emit_function_body(cleanup, current_temp):
				Some(cleanup_c):
					statements += discard_expr_body(cleanup, cleanup_c)
					current_temp = cleanup_c.next_temp
				None:
					failed = True

	if failed:
		None
	else:
		Some({
			statements = statements,
			value = "",
			next_temp = current_temp,
			returns = False,
		})


private pure func resource_exit_statement(exit: CoreResourceExit) -> String:
	match exit:
		ResourceBreakExit:
			"  break;\n"
		ResourceContinueExit:
			"  continue;\n"


private pure func emit_resource_cleanup_exit(
	cleanup_exit: CoreResourceCleanupExit,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	cleanups_c ?= emit_resource_cleanups(cleanup_exit.cleanups, next_temp)

	Some({
		statements = cleanups_c.statements + resource_exit_statement(cleanup_exit.exit),
		value = "",
		next_temp = cleanups_c.next_temp,
		returns = False,
	})


private pure func emit_resource_scope(
	scope: CoreResourceScope,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	acquire_c ?= emit_simple_expr(scope.acquire)
	push_statement ?= resource_cleanup_push_statement(scope)
	resource_declaration: String = "  " + c_type_name(
		scope.typ,
	) + " " + c_var_name(scope.variable) + " = " + acquire_c + ";\n"
	pop_statement: String = cancellation_cleanup_pop_statement(scope.variable)

	if is_void_type(typ):
		body_c ?= emit_function_body(scope.body, next_temp)
		cleanup_c ?= emit_function_body(scope.cleanup, body_c.next_temp)
		inner: String = resource_declaration + push_statement + statement_body(
			scope.body,
			body_c,
		) + pop_statement + discard_expr_body(scope.cleanup, cleanup_c)

		Some({
			statements = "  {\n" + indent_statements(inner) + "  }\n",
			value = "",
			next_temp = cleanup_c.next_temp,
			returns = False,
		})
	else:
		result_name: String = temp_name("resource_result", next_temp)
		body_c ?= emit_function_body(scope.body, next_temp + 1)
		body_value ?= required_body_value(body_c)
		cleanup_c ?= emit_function_body(scope.cleanup, body_c.next_temp)
		inner: String = resource_declaration + push_statement + body_c.statements + "  " + result_name + " = " + body_value + ";\n" + pop_statement + discard_expr_body(
			scope.cleanup,
			cleanup_c,
		)

		Some({
			statements = "  " + c_type_name(
				typ,
			) + " " + result_name + ";\n  {\n" + indent_statements(inner) + "  }\n",
			value = result_name,
			next_temp = cleanup_c.next_temp,
			returns = False,
		})


private pure func emit_function_body(expr: CoreExpr, next_temp: Int) -> Option[FunctionBodyC]:
	match expr:
		LetExpr(name, is_mutable, typ, rhs, body):
			if is_void_type(typ):
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_function_body(body, rhs_c.next_temp)
				Some({
					statements = discard_expr_body(rhs, rhs_c) + body_c.statements,
					value = body_c.value,
					next_temp = body_c.next_temp,
					returns = body_c.returns,
				})
			else if name.name == "_":
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_function_body(body, rhs_c.next_temp)
				Some({
					statements = discard_expr_body(rhs, rhs_c) + body_c.statements,
					value = body_c.value,
					next_temp = body_c.next_temp,
					returns = body_c.returns,
				})
			else:
				match emit_simple_expr(rhs):
					Some(rhs_c):
						body_c ?= emit_function_body(body, next_temp)
						Some({
							statements = "  " + c_type_name(
								typ,
							) + " " + c_var_name(name) + " = " + rhs_c + ";\n" + body_c.statements,
							value = body_c.value,
							next_temp = body_c.next_temp,
							returns = body_c.returns,
						})
					None:
						rhs_body ?= emit_function_body(rhs, next_temp)
						rhs_value ?= required_body_value(rhs_body)
						body_c ?= emit_function_body(body, rhs_body.next_temp)
						Some({
							statements = "  " + c_type_name(
								typ,
							) + " " + c_var_name(
								name,
							) + ";\n" + rhs_body.statements + "  " + c_var_name(
								name,
							) + " = " + rhs_value + ";\n" + body_c.statements,
							value = body_c.value,
							next_temp = body_c.next_temp,
							returns = body_c.returns,
						})
		LiteralExpr(literal, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		VarExpr(variable, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		VoidExpr(typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		CooperativeCheckpointExpr(typ, loc):
			Some({
				statements = "  blorp_cooperative_checkpoint();\n",
				value = "",
				next_temp = next_temp,
				returns = False,
			})
		CallExpr(kind, callee, args, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		BinaryExpr(op, left, right, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		UnaryExpr(op, expr_value, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		LogicalExpr(op, left, right, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		AssignExpr(variable, rhs, typ, loc):
			rhs_c ?= emit_function_body(rhs, next_temp)

			if variable.name == "_":
				Some({
					statements = discard_expr_body(rhs, rhs_c),
					value = "",
					next_temp = rhs_c.next_temp,
					returns = False,
				})
			else:
				Some({
					statements = rhs_c.statements + "  " + c_var_name(
						variable,
					) + " = " + rhs_c.value + ";\n",
					value = "",
					next_temp = rhs_c.next_temp,
					returns = False,
				})
		CastExpr(expr_value, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		BoxExpr(box, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		FieldExpr(expr_value, field_name, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TupleFieldExpr(expr_value, field_index, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TupleExpr(items, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TupleConstructExpr(tuple_construct, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ClosureCreateExpr(closure, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListConstructExpr(construct, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListAllocExpr(alloc, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListGetExpr(get, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListHandoffExpr(handoff, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListHandoffSetOwnedExpr(set, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		StringByteReadExpr(read, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		StringByteWriteExpr(write, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		StringByteCopyExpr(copy, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		StringSetLenExpr(set_len, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TensorRawReadExpr(read, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TensorRawWriteExpr(write, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TensorRawViewLetExpr(binding, body, typ, loc):
			decl ?= tensor_raw_view_decl(binding)
			body_c ?= emit_function_body(body, next_temp)
			Some({
				statements = "  " + decl + ";\n" + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		DictConstructExpr(construct, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		SetAllocExpr(alloc, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListRetainExpr(retain, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListSetExpr(set, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		RecordExpr(fields, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		RecordConstructExpr(type_name, fields, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		UnionConstructExpr(construct, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			retain_statement: String = emit_dup_statement(variable, retain_policy)
			body_c ?= emit_function_body(body, next_temp)
			Some({
				statements = retain_statement + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			drop_statement: String = emit_drop_statement(variable, release_policy)
			body_c ?= emit_function_body(body, next_temp)
			Some({
				statements = drop_statement + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		SeqExpr(first, second):
			first_c ?= emit_function_body(first, next_temp)
			second_c ?= emit_function_body(second, first_c.next_temp)
			Some({
				statements = discard_expr_body(first, first_c) + second_c.statements,
				value = second_c.value,
				next_temp = second_c.next_temp,
				returns = second_c.returns,
			})
		WhileExpr(cond, body, typ, loc):
			condition ?= emit_condition(cond, next_temp)
			body_c ?= emit_function_body(body, condition.next_temp)

			if condition.statements == "":
				Some({
					statements = "  while (" + condition.value + ") {\n" + indent_statements(
						statement_body(
							body,
							body_c,
						),
					) + "  }\n",
					value = "",
					next_temp = body_c.next_temp,
					returns = False,
				})
			else:
				Some({
					statements = "  while (1) {\n" + indent_statements(
						condition.statements + "  if (!(" + condition.value + ")) {\n    break;\n  }\n" + statement_body(
							body,
							body_c,
						),
					) + "  }\n",
					value = "",
					next_temp = body_c.next_temp,
					returns = False,
				})
		BreakExpr(typ, loc):
			Some({
				statements = "  break;\n",
				value = "",
				next_temp = next_temp,
				returns = False,
			})
		ContinueExpr(typ, loc):
			Some({
				statements = "  continue;\n",
				value = "",
				next_temp = next_temp,
				returns = False,
			})
		ResourceScopeExpr(scope, typ, loc):
			emit_resource_scope(scope, typ, next_temp)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			emit_resource_cleanup_exit(cleanup_exit, next_temp)
		TailrecLoopExpr(params, return_type, body, loc):
			emit_tailrec_loop(params, return_type, body, next_temp)
		TailrecRecurExpr(args, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			emit_for_range(binder, start, end_value, body, next_temp)
		ForListExpr(for_list, typ, loc):
			emit_for_list(for_list, next_temp)
		RangeExpr(start, end_value, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			emit_literal_match(scrutinee, cases, fallback, typ, next_temp)
		ConstructorMatchExpr(scrutinee, cases, fallback, typ, loc):
			emit_constructor_match(scrutinee, cases, fallback, typ, next_temp)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					condition ?= emit_condition(cond, next_temp)

					if is_void_type(typ):
						then_c ?= emit_function_body(then_expr, condition.next_temp)
						else_c ?= emit_function_body(else_expr, then_c.next_temp)
						else_statements: String = statement_body(else_expr, else_c)

						if else_statements == "":
							Some({
								statements = condition.statements + "  if (" + condition.value + ") {\n" + indent_statements(
									statement_body(
										then_expr,
										then_c,
									),
								) + "  }\n",
								value = "",
								next_temp = else_c.next_temp,
								returns = False,
							})
						else:
							Some({
								statements = condition.statements + "  if (" + condition.value + ") {\n" + indent_statements(
									statement_body(
										then_expr,
										then_c,
									),
								) + "  } else {\n" + indent_statements(else_statements) + "  }\n",
								value = "",
								next_temp = else_c.next_temp,
								returns = False,
							})
					else:
						temp: String = temp_name("if_result", condition.next_temp)
						then_c ?= emit_function_body(then_expr, condition.next_temp + 1)
						else_c ?= emit_function_body(else_expr, then_c.next_temp)
						then_value ?= required_body_value(then_c)
						else_value ?= required_body_value(else_c)
						Some({
							statements = "  " + c_type_name(
								typ,
							) + " " + temp + ";\n" + condition.statements + "  if (" + condition.value + ") {\n" + indent_statements(
								then_c.statements,
							) + "    " + temp + " = " + then_value + ";\n  } else {\n" + indent_statements(
								else_c.statements,
							) + "    " + temp + " = " + else_value + ";\n  }\n",
							value = temp,
							next_temp = else_c.next_temp,
							returns = False,
						})


private pure func emit_supported_user_function(func_info: CoreFunction) -> Option[String]:
	match func_info.body:
		Some(body):
			match emit_function_body(body, 0):
				Some(body_c):
					prefix: String = c_function_signature(func_info) + " {\n"
					body_prelude: String = entrypoint_arg_prelude(func_info)
					body_cleanup: String = entrypoint_arg_cleanup(func_info)

					if is_void_type(func_info.return_type):
						if is_entrypoint(func_info):
							Some(
								prefix + body_prelude + discard_body(
									body_c,
								) + body_cleanup + "  return 0;\n}\n",
							)
						else:
							Some(prefix + body_prelude + discard_body(body_c) + "}\n")
					else:
						match required_body_value(body_c):
							Some(return_value):
								if entrypoint_has_source_args(func_info):
									Some(
										prefix + body_prelude + body_c.statements + "  long __blorp_main_result = (long)" + return_value + ";\n" + body_cleanup + "  return (int)__blorp_main_result;\n}\n",
									)
								else:
									Some(
										prefix + body_prelude + body_c.statements + "  return " + return_value + ";\n}\n",
									)
							None:
								if body_c.returns:
									Some(prefix + body_prelude + body_c.statements + "}\n")
								else:
									None
				None:
					None
		None:
			None


private pure func emit_function(func_info: CoreFunction) -> String:
	match func_info.function_kind:
		UserFunction:
			match emit_supported_user_function(func_info):
				Some(c_code):
					c_code
				None:
					emit_function_inventory(func_info)
		BuiltinFunction:
			emit_function_inventory(func_info)
		ForeignFunction:
			emit_function_inventory(func_info)
		ClosureBodyFunction(abi):
			match emit_closure_body_function(func_info, abi):
				Some(c_code):
					c_code
				None:
					emit_function_inventory(func_info)


private pure func emit_function_forward_decl(func_info: CoreFunction) -> String:
	match func_info.function_kind:
		UserFunction:
			match func_info.body:
				Some(body):
					if is_entrypoint(func_info):
						""
					else:
						c_function_signature(func_info) + ";\n"
				None:
					""
		BuiltinFunction:
			""
		ForeignFunction:
			""
		ClosureBodyFunction(abi):
			if abi.moved_captures.length() == 0 and not abi.task_abi:
				match func_info.body:
					Some(body):
						closure_body_signature(func_info, abi) + ";\n"
					None:
						""
			else:
				""


private pure func emit_static_closure_forward_decl(func_info: CoreFunction) -> String:
	match func_info.function_kind:
		ClosureBodyFunction(abi):
			if abi.captures.length() == 0:
				"static blorp_Closure " + static_closure_name(abi.c_name) + ";\n"
			else:
				""
		UserFunction:
			""
		BuiltinFunction:
			""
		ForeignFunction:
			""


private pure func emit_enum_variant(variant: CoreEnumVariant) -> String:
	"#define " + variant.c_name + " " + variant.tag.to_string() + "L\n"


private pure func emit_enum_decl(enum_decl: CoreEnumDecl) -> String:
	var c_code: String = ""

	for variant in enum_decl.variants:
		c_code += emit_enum_variant(variant)

	c_code


private pure func emit_static_global_init_expr(init: CoreExpr) -> Option[String]:
	match init:
		LiteralExpr(literal, typ, loc):
			match literal:
				IntLiteral(value):
					Some(value.to_string() + "L")
				FloatLiteral(value):
					emit_simple_expr(init)
				BoolLiteral(value):
					emit_simple_expr(init)
				CharLiteral(value):
					emit_simple_expr(init)
				StringLiteral(value):
					emit_simple_expr(init)
		VarExpr(variable, typ, loc):
			emit_simple_expr(init)
		VoidExpr(typ, loc):
			emit_simple_expr(init)
		CooperativeCheckpointExpr(typ, loc):
			emit_simple_expr(init)
		CallExpr(kind, callee, args, typ, loc):
			emit_simple_expr(init)
		BinaryExpr(op, left, right, typ, loc):
			emit_simple_expr(init)
		UnaryExpr(op, expr_value, typ, loc):
			emit_simple_expr(init)
		LogicalExpr(op, left, right, typ, loc):
			emit_simple_expr(init)
		AssignExpr(variable, rhs, typ, loc):
			emit_simple_expr(init)
		CastExpr(expr_value, typ, loc):
			emit_simple_expr(init)
		BoxExpr(box, typ, loc):
			emit_simple_expr(init)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			emit_simple_expr(init)
		FieldExpr(expr_value, field_name, typ, loc):
			emit_simple_expr(init)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			emit_simple_expr(init)
		TupleExpr(items, typ, loc):
			emit_simple_expr(init)
		TupleConstructExpr(tuple_construct, typ, loc):
			emit_simple_expr(init)
		ClosureCreateExpr(closure, typ, loc):
			None
		ListConstructExpr(construct, typ, loc):
			None
		ListAllocExpr(alloc, typ, loc):
			None
		ListGetExpr(get, typ, loc):
			None
		ListHandoffExpr(handoff, typ, loc):
			None
		ListHandoffSetOwnedExpr(set, typ, loc):
			None
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			None
		StringByteReadExpr(read, typ, loc):
			emit_simple_expr(init)
		StringByteWriteExpr(write, typ, loc):
			emit_simple_expr(init)
		StringByteCopyExpr(copy, typ, loc):
			None
		StringSetLenExpr(set_len, typ, loc):
			None
		TensorRawReadExpr(read, typ, loc):
			emit_simple_expr(init)
		TensorRawWriteExpr(write, typ, loc):
			emit_simple_expr(init)
		TensorRawViewLetExpr(binding, body, typ, loc):
			None
		DictConstructExpr(construct, typ, loc):
			None
		SetAllocExpr(alloc, typ, loc):
			None
		ListRetainExpr(retain, typ, loc):
			None
		ListSetExpr(set, typ, loc):
			None
		RecordExpr(fields, typ, loc):
			emit_simple_expr(init)
		RecordConstructExpr(type_name, fields, typ, loc):
			emit_simple_expr(init)
		UnionConstructExpr(construct, typ, loc):
			None
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			emit_simple_expr(init)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			emit_simple_expr(init)
		LetExpr(name, is_mutable, typ, rhs, body):
			emit_simple_expr(init)
		SeqExpr(first, second):
			emit_simple_expr(init)
		WhileExpr(cond, body, typ, loc):
			emit_simple_expr(init)
		BreakExpr(typ, loc):
			emit_simple_expr(init)
		ContinueExpr(typ, loc):
			emit_simple_expr(init)
		ResourceScopeExpr(scope, typ, loc):
			emit_simple_expr(init)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			emit_simple_expr(init)
		TailrecLoopExpr(params, return_type, body, loc):
			emit_simple_expr(init)
		TailrecRecurExpr(args, typ, loc):
			emit_simple_expr(init)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			emit_simple_expr(init)
		ForListExpr(for_list, typ, loc):
			emit_simple_expr(init)
		RangeExpr(start, end_value, typ, loc):
			emit_simple_expr(init)
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			emit_simple_expr(init)
		ConstructorMatchExpr(scrutinee, cases, default_body, typ, loc):
			emit_simple_expr(init)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			emit_simple_expr(init)


private pure func emit_global_decl(global: CoreGlobal) -> String:
	match emit_static_global_init_expr(global.init):
		Some(init_c):
			"static " + c_type_name(global.typ) + " " + global.name.name + " = " + init_c + ";\n\n"
		None:
			"/* unsupported global " + global.name.name + " */\n"


private pure func c_value_record_field_decl(field: CoreValueRecordField) -> String:
	c_type_name(field.typ) + " " + field.name + "; "


private pure func c_value_record_make_param(field: CoreValueRecordField) -> String:
	c_type_name(field.typ) + " " + field.name


private pure func emit_value_record_decl(record_decl: CoreValueRecordDecl) -> String:
	var fields_c: String = ""
	var params: List[String] = []
	var init_fields: List[String] = []

	for field in record_decl.fields:
		fields_c += c_value_record_field_decl(field)
		params = params.append(c_value_record_make_param(field))
		init_fields = init_fields.append(field.name)

	param_c: String = if params.length() == 0:
		"void"
	else:
		params.join(", ")

	"typedef struct { " + fields_c + "} " + record_decl.name + ";\nstatic inline " + record_decl.name + " " + record_decl.name + "_make(" + param_c + ") { " + record_decl.name + " __r = { " + init_fields.join(
		", ",
	) + " }; return __r; }\n\n"


private pure func heap_record_field_decl(field: CoreHeapRecordField) -> String:
	"  " + c_type_name(field.typ) + " " + c_identifier(field.name) + ";\n"


private pure func heap_record_make_param(field: CoreHeapRecordField) -> String:
	c_type_name(field.typ) + " " + c_identifier(field.name)


private pure func heap_record_field_release_statement(field: CoreHeapRecordField) -> String:
	field_name: String = c_identifier(field.name)

	match field.release_policy:
		NoReleasePolicy:
			""
		ArcReleasePolicy:
			"  if (__rec->" + field_name + ") blorp_release((blorp_Object*)__rec->" + field_name + ");\n"
		ArcReleaseOnlyPolicy:
			"  if (__rec->" + field_name + ") blorp_release_arc_only(__rec->" + field_name + ");\n"
		StackResultReleasePolicy:
			"  blorp_stack_result_release(__rec->" + field_name + ");\n"


private pure func heap_record_has_destructor(record_decl: CoreHeapRecordDecl) -> Bool:
	var has_destructor: Bool = False

	for field in record_decl.fields:
		match field.release_policy:
			NoReleasePolicy:
				void
			ArcReleasePolicy:
				has_destructor = True
			ArcReleaseOnlyPolicy:
				has_destructor = True
			StackResultReleasePolicy:
				has_destructor = True

	has_destructor


private pure func emit_heap_record_destructor(record_decl: CoreHeapRecordDecl) -> String:
	if heap_record_has_destructor(record_decl):
		var releases: String = ""

		for field in record_decl.fields:
			releases += heap_record_field_release_statement(field)

		"static void " + record_decl.name + "_destroy(void* obj) {\n" + "  " + record_decl.name + "* __rec = (" + record_decl.name + "*)obj;\n" + releases + "}\n\n"
	else:
		""


private pure func emit_heap_record_decl(record_decl: CoreHeapRecordDecl) -> String:
	var fields_c: String = ""
	var params: List[String] = []
	var assignments: String = ""

	for field in record_decl.fields:
		field_name: String = c_identifier(field.name)
		fields_c += heap_record_field_decl(field)
		params = params.append(heap_record_make_param(field))
		assignments += "  __rec->" + field_name + " = " + field_name + ";\n"

	param_c: String = if params.length() == 0:
		"void"
	else:
		params.join(", ")

	destructor_init: String = if heap_record_has_destructor(record_decl):
		"  BLORP_SET_DESTRUCTOR(__rec, " + record_decl.name + "_destroy);\n"
	else:
		""

	"struct " + record_decl.name + " {\n" + "  blorp_Object header;\n" + fields_c + "};\n\n" + emit_heap_record_destructor(
		record_decl,
	) + record_decl.name + "* " + record_decl.name + "_make(" + param_c + ") {\n" + "  " + record_decl.name + "* __rec = (" + record_decl.name + "*)blorp_alloc(sizeof(" + record_decl.name + "));\n" + "  BLORP_TAG(__rec, \"" + record_decl.name + "\");\n" + destructor_init + assignments + "  return __rec;\n}\n\n"


private pure func c_union_variant_field_decl(field_type: CoreType, index: Int) -> String:
	c_type_name(field_type) + " field" + index.to_string() + "; "


private pure func emit_union_variant_storage(variant: CoreUnionVariant) -> String:
	if variant.fields.length() == 0:
		"    char " + variant.name + ";\n"
	else:
		var fields_c: String = ""
		var index: Int = 0

		for field_type in variant.fields:
			fields_c += c_union_variant_field_decl(field_type, index)
			index += 1

		"    struct { " + fields_c + "} " + variant.name + ";\n"


private pure func emit_union_variant_tag(variant: CoreUnionVariant) -> String:
	"#define " + variant.tag_c_name + " " + variant.tag.to_string() + "\n"


private pure func emit_union_constructor_param(field_type: CoreType, index: Int) -> String:
	c_type_name(field_type) + " field" + index.to_string()


private pure func emit_union_constructor(
	union_decl: CoreUnionDecl,
	variant: CoreUnionVariant,
) -> String:
	if variant.fields.length() == 0:
		""
	else:
		var params: List[String] = []
		var assignments: String = ""
		var index: Int = 0

		for field_type in variant.fields:
			params = params.append(emit_union_constructor_param(field_type, index))
			assignments += "  __vc->data." + variant.name + ".field" + index.to_string() + " = field" + index.to_string() + ";\n"
			index += 1

		union_decl.name + "* " + variant.c_name + "(" + params.join(
			", ",
		) + ") {\n" + "  " + union_decl.name + "* __vc = (" + union_decl.name + "*)blorp_alloc(sizeof(" + union_decl.name + "));\n" + "  BLORP_TAG(__vc, \"" + union_decl.name + "\");\n" + "  __vc->tag = " + variant.tag_c_name + ";\n" + assignments + "  return __vc;\n}\n\n"


private pure func emit_union_decl(union_decl: CoreUnionDecl) -> String:
	var storage_c: String = ""
	var tags_c: String = ""
	var constructors_c: String = ""

	for variant in union_decl.variants:
		storage_c += emit_union_variant_storage(variant)
		tags_c += emit_union_variant_tag(variant)
		constructors_c += emit_union_constructor(union_decl, variant)

	"typedef struct " + union_decl.name + " {\n" + "  blorp_Object header;\n" + "  int tag;\n" + "  union {\n" + storage_c + "  } data;\n" + "} " + union_decl.name + ";\n\n" + tags_c + "\n" + constructors_c


private pure func emit_value_record_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			ValueRecordDecl(record_decl):
				c_code += emit_value_record_decl(record_decl)
			HeapRecordDecl(record_decl):
				void
			EnumDecl(enum_decl):
				void
			UnionDecl(union_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_heap_record_forward_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			HeapRecordDecl(record_decl):
				c_code += "typedef struct " + record_decl.name + " " + record_decl.name + ";\n"
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			EnumDecl(enum_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void

	if c_code == "":
		""
	else:
		c_code + "\n"


private pure func emit_heap_record_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			HeapRecordDecl(record_decl):
				c_code += emit_heap_record_decl(record_decl)
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			EnumDecl(enum_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_union_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			UnionDecl(union_decl):
				c_code += emit_union_decl(union_decl)
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			EnumDecl(enum_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_enum_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			EnumDecl(enum_decl):
				c_code += emit_enum_decl(enum_decl)
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_global_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			GlobalDecl(global):
				c_code += emit_global_decl(global)
			EnumDecl(enum_decl):
				void
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			FunctionDecl(func_info):
				void

	c_code


private pure func emit_function_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			FunctionDecl(func_info):
				c_code += emit_function(func_info)
			EnumDecl(enum_decl):
				void
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			GlobalDecl(global):
				void

	c_code


private pure func emit_function_forward_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			FunctionDecl(func_info):
				c_code += emit_function_forward_decl(func_info)
			EnumDecl(enum_decl):
				void
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			GlobalDecl(global):
				void

	if c_code == "":
		""
	else:
		c_code + "\n"


private pure func emit_static_closure_forward_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = ""

	for decl in decls:
		match decl:
			FunctionDecl(func_info):
				c_code += emit_static_closure_forward_decl(func_info)
			EnumDecl(enum_decl):
				void
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			GlobalDecl(global):
				void

	if c_code == "":
		""
	else:
		c_code + "\n"


private pure func emit_decls(decls: List[CoreDecl]) -> String:
	emit_value_record_decls(
		decls,
	) + emit_heap_record_forward_decls(
		decls,
	) + emit_enum_decls(
		decls,
	) + emit_union_decls(
		decls,
	) + emit_heap_record_decls(
		decls,
	) + emit_static_closure_forward_decls(
		decls,
	) + emit_global_decls(decls) + emit_function_forward_decls(decls) + emit_function_decls(decls)


pure func emit_prepared_core_program_c_artifact(program: CoreProgram) -> CArtifact:
	{
		c_code = C_ARTIFACT_HEADER + emit_decls(program.decls),
		link_flags = [],
		include_dirs = []
	}


pure func prepare_and_emit_core_program_c_artifact(program: CoreProgram) -> CArtifact:
	resource_program: CoreProgram = CoreResource.rewrite_resource_program(program)
	fair_program: CoreProgram = CoreFairness.insert_cooperative_checkpoints(resource_program)
	prepared_program: CoreProgram = CorePrepare.prepare_program(fair_program)

	emit_prepared_core_program_c_artifact(prepared_program)


pure func emit_core_program_c_artifact(program: CoreProgram) -> CArtifact:
	prepare_and_emit_core_program_c_artifact(program)
