private pure func boxed_tensor_set_release_tail(kind: CoreBoxKind, value_tmp: String) -> String:
	match kind:
		VoidBox:
			""
		FloatBox:
			" if (${value_tmp}) blorp_release(${value_tmp});"
		Float32Box:
			" if (${value_tmp}) blorp_release(${value_tmp});"
		Float16Box:
			" if (${value_tmp}) blorp_release(${value_tmp});"
		Int128Box:
			" if (${value_tmp}) blorp_release(${value_tmp});"
		UInt128Box:
			" if (${value_tmp}) blorp_release(${value_tmp});"
		PrimBox:
			""
		PointerBox:
			""
		StructBox(c_type):
			" if (${value_tmp}) blorp_release(${value_tmp});"


private pure func emit_boxed_tensor_set_call_with_prefix(
	name: String,
	prefix_args: List[CoreExpr],
	box: CoreBoxOp,
	typ: CoreType,
) -> Option[String]:
	prefix_values ?= emit_simple_expr_arg_values(prefix_args)
	value_c ?= emit_box_expr(box)
	value_tmp: String = "__set_value_" + TENSOR_SET_TEMP_SEED
	result_tmp: String = "__set_result_" + TENSOR_SET_TEMP_SEED
	call_args: String = prefix_values
		.append(value_tmp)
		.join(", ")
	release_tail: String = boxed_tensor_set_release_tail(box.kind, value_tmp)

	Some(
		"({ void* " + value_tmp + " = " + value_c + "; " + c_type_name(
			typ,
		) + " " + result_tmp + " = " + name + "(" + call_args + ");" + release_tail + " " + result_tmp + "; })",
	)


private pure func emit_boxed_tensor_set_call(
	name: String,
	args: List[CoreExpr],
	typ: CoreType,
) -> Option[String]:
	if name == "blorp_vector_set_cow_nullable" or name == "blorp_checked_set":
		match args:
			[tensor_expr, index_expr, BoxExpr(box, box_type, box_loc)]:
				emit_boxed_tensor_set_call_with_prefix(
					name,
					[tensor_expr, index_expr],
					box,
					typ,
				)
			[]:
				None
			[first]:
				None
			[first, second]:
				None
			[first, second, third, ...rest]:
				None
	else if name == "blorp_matrix_checked_set":
		match args:
			[tensor_expr, row_expr, col_expr, BoxExpr(box, box_type, box_loc)]:
				emit_boxed_tensor_set_call_with_prefix(
					name,
					[tensor_expr, row_expr, col_expr],
					box,
					typ,
				)
			[]:
				None
			[first]:
				None
			[first, second]:
				None
			[first, second, third]:
				None
			[first, second, third, fourth, ...rest]:
				None
	else:
		None


private pure func emit_intrinsic_call(name: String, args: List[CoreExpr]) -> Option[String]:
	arg_values ?= emit_simple_expr_arg_values(args)
	emit_intrinsic_call_from_values(name, arg_values)


private pure func emit_intrinsic_call_from_values(
	name: String,
	arg_values: List[String],
) -> Option[String]:
	match emit_prepared_list_intrinsic_call(name, arg_values):
		Some(rendered):
			Some(rendered)
		None:
			match emit_prepared_tensor_intrinsic_call(name, arg_values):
				Some(rendered):
					Some(rendered)
				None:
					match Intrinsic.render_intrinsic(name, arg_values):
						Ok(rendered):
							Some(rendered)
						Err(error):
							None


private pure func emit_call_args_body(args: List[CoreExpr], next_temp: Int) -> Option[CallArgsBody]:
	var statements: String = ""
	var values: List[String] = []
	var failed: Bool = False
	var temp_index: Int = next_temp

	for arg in args:
		if not failed:
			match emit_function_body(arg, temp_index):
				Some(arg_body):
					if arg_body.returns:
						failed = True
					else:
							match required_body_value(arg_body):
								Some(arg_value):
									scoped_arg: FunctionBodyC = scoped_body_value(
										"call_arg",
										core_expr_type(arg),
										arg_body,
									)
									statements += scoped_arg.statements
									values = values.append(scoped_arg.value)
									temp_index = scoped_arg.next_temp
								None:
									failed = True
				None:
					failed = True

	if failed:
		None
	else:
		Some({
			statements = statements,
			args = values,
			next_temp = temp_index,
		})


private pure func scoped_c_value(
	prefix: String,
	c_type: String,
	body: FunctionBodyC,
) -> FunctionBodyC:
	if body.statements == "":
		body
	else:
		result_name: String = temp_name(prefix, body.next_temp)
		{
			statements = "  " + c_type + " " + result_name + ";\n  {\n" + indent_statements(
				body.statements + "  " + result_name + " = " + body.value + ";\n",
			) + "  }\n",
			value = result_name,
			next_temp = body.next_temp + 1,
			returns = False,
		}


private pure func scoped_body_value(
	prefix: String,
	typ: CoreType,
	body: FunctionBodyC,
) -> FunctionBodyC:
	scoped_c_value(prefix, c_type_name(typ), body)


private pure func emit_scoped_expr_value(
	prefix: String,
	expr: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body ?= emit_function_body(expr, next_temp)
	if body.returns:
		None
	else if body.value == "":
		None
	else:
		Some(scoped_body_value(prefix, core_expr_type(expr), body))


private pure func stack_option_none_value_for_type(typ: CoreType) -> String:
	match typ:
		NamedType(name, args):
			if name == "Option":
				match args:
					[ValueRecordType(record_name)]:
						"{0}"
					[payload]:
						"0"
					[]:
						"0"
					[first, second, ...rest]:
						"0"
			else:
				"0"
		VoidType:
			"0"
		StackResultType(ok_type, err_type):
			"0"
		BoxedResultType(ok_type, err_type):
			"0"
		EnumType(name):
			"0"
		ValueRecordType(name):
			"{0}"
		HeapRecordType(name):
			"0"
		UnionType(name):
			"0"
		RangeType:
			"0"
		TensorType:
			"0"
		TupleType(items):
			"0"


private pure func stack_option_scalar_get_args(
	dict: String,
	key: String,
	typ: CoreType,
) -> StackOptionScalarGetArgs:
	{
		dict = dict,
		key = key,
		temp_seed = DICT_GET_TEMP_SEED,
		option_c_type = c_type_name(typ),
		none_value = stack_option_none_value_for_type(typ)
	}


private pure func emit_dict_get_stack_option_payload(
	dict: String,
	key: String,
	result_type: CoreType,
	payload_type: CoreType,
) -> Option[String]:
	match payload_type:
		ValueRecordType(name):
			args: StackOptionValueRecordGetArgs = {
				dict = dict,
				key = key,
				temp_seed = DICT_GET_TEMP_SEED,
				option_c_type = c_type_name(result_type),
				payload_c_type = c_type_name(payload_type),
				none_value = stack_option_none_value_for_type(result_type)
			}
			Some(
				render_prepared_backend_op(
					BackendDictStackOptionValueRecordGet(
						args,
						DictKeepKey,
					),
				),
			)
		RangeType:
			args: StackOptionScalarGetArgs = stack_option_scalar_get_args(dict, key, result_type)
			Some(render_prepared_backend_op(BackendDictStackOptionLongGet(args, DictKeepKey)))
		EnumType(name):
			args: StackOptionScalarGetArgs = stack_option_scalar_get_args(dict, key, result_type)
			Some(render_prepared_backend_op(BackendDictStackOptionLongGet(args, DictKeepKey)))
		NamedType(name, type_args):
			if type_args.length() == 0 and name == "Int128":
				args: StackOptionScalarGetArgs = stack_option_scalar_get_args(
					dict,
					key,
					result_type,
				)
				Some(render_prepared_backend_op(BackendDictStackOptionInt128Get(args, DictKeepKey)))
			else if type_args.length() == 0 and name == "UInt128":
				args: StackOptionScalarGetArgs = stack_option_scalar_get_args(
					dict,
					key,
					result_type,
				)
				Some(
					render_prepared_backend_op(
						BackendDictStackOptionUInt128Get(
							args,
							DictKeepKey,
						),
					),
				)
			else if type_args.length() == 0 and (name == "Int" or name == "Bool" or name == "Char"):
				args: StackOptionScalarGetArgs = stack_option_scalar_get_args(
					dict,
					key,
					result_type,
				)
				Some(render_prepared_backend_op(BackendDictStackOptionLongGet(args, DictKeepKey)))
			else:
				None
		VoidType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		TensorType:
			None
		TupleType(items):
			None


private pure func emit_prepared_dict_builtin_call(
	name: String,
	args: List[String],
	typ: CoreType,
) -> Option[String]:
	if name == "blorp_dict_get":
		match args:
			[dict, key]:
				match typ:
					NamedType(type_name, type_args):
						if type_name == "Option":
							match type_args:
								[payload_type]:
									emit_dict_get_stack_option_payload(dict, key, typ, payload_type)
								[]:
									None
								[first, second, ...rest]:
									None
						else:
							None
					VoidType:
						None
					StackResultType(ok_type, err_type):
						None
					BoxedResultType(ok_type, err_type):
						None
					EnumType(type_name):
						None
					ValueRecordType(type_name):
						None
					HeapRecordType(type_name):
						None
					UnionType(type_name):
						None
					RangeType:
						None
					TensorType:
						None
					TupleType(items):
						None
			[]:
				None
			[first]:
				None
			[first, second, third, ...rest]:
				None
	else:
		None


private pure func stack_option_vector_scalar_get_args(
	tensor: String,
	index: String,
	typ: CoreType,
) -> StackOptionVectorScalarGetArgs:
	{
		tensor = tensor,
		index = index,
		temp_seed = TENSOR_STACK_OPTION_GET_TEMP_SEED,
		option_c_type = c_type_name(typ),
		none_value = stack_option_none_value_for_type(typ)
	}


private pure func stack_option_matrix_scalar_get_args(
	tensor: String,
	row: String,
	col: String,
	typ: CoreType,
) -> StackOptionMatrixScalarGetArgs:
	{
		tensor = tensor,
		row = row,
		col = col,
		temp_seed = TENSOR_STACK_OPTION_GET_TEMP_SEED,
		option_c_type = c_type_name(typ),
		none_value = stack_option_none_value_for_type(typ)
	}


private pure func emit_vector_get_stack_option_payload(
	tensor: String,
	index: String,
	result_type: CoreType,
	payload_type: CoreType,
) -> Option[String]:
	match payload_type:
		ValueRecordType(name):
			args: StackOptionVectorValueRecordGetArgs = {
				tensor = tensor,
				index = index,
				temp_seed = TENSOR_STACK_OPTION_GET_TEMP_SEED,
				option_c_type = c_type_name(result_type),
				payload_c_type = c_type_name(payload_type),
				none_value = stack_option_none_value_for_type(result_type)
			}
			Some(render_prepared_tensor_op(StackOptionVectorValueRecordGet(args)))
		RangeType:
			args: StackOptionVectorScalarGetArgs = stack_option_vector_scalar_get_args(tensor, index, result_type)
			Some(render_prepared_tensor_op(StackOptionVectorLongGet(args)))
		EnumType(name):
			args: StackOptionVectorScalarGetArgs = stack_option_vector_scalar_get_args(tensor, index, result_type)
			Some(render_prepared_tensor_op(StackOptionVectorLongGet(args)))
		NamedType(name, type_args):
			if type_args.length() == 0 and name == "Int128":
				args: StackOptionVectorScalarGetArgs = stack_option_vector_scalar_get_args(
					tensor,
					index,
					result_type,
				)
				Some(render_prepared_tensor_op(StackOptionVectorInt128Get(args)))
			else if type_args.length() == 0 and name == "UInt128":
				args: StackOptionVectorScalarGetArgs = stack_option_vector_scalar_get_args(
					tensor,
					index,
					result_type,
				)
				Some(render_prepared_tensor_op(StackOptionVectorUInt128Get(args)))
			else:
				None
		VoidType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		TensorType:
			None
		TupleType(items):
			None


private pure func emit_matrix_get_stack_option_payload(
	tensor: String,
	row: String,
	col: String,
	result_type: CoreType,
	payload_type: CoreType,
) -> Option[String]:
	match payload_type:
		ValueRecordType(name):
			args: StackOptionMatrixValueRecordGetArgs = {
				tensor = tensor,
				row = row,
				col = col,
				temp_seed = TENSOR_STACK_OPTION_GET_TEMP_SEED,
				option_c_type = c_type_name(result_type),
				payload_c_type = c_type_name(payload_type),
				none_value = stack_option_none_value_for_type(result_type)
			}
			Some(render_prepared_tensor_op(StackOptionMatrixValueRecordGet(args)))
		RangeType:
			args: StackOptionMatrixScalarGetArgs = stack_option_matrix_scalar_get_args(tensor, row, col, result_type)
			Some(render_prepared_tensor_op(StackOptionMatrixLongGet(args)))
		EnumType(name):
			args: StackOptionMatrixScalarGetArgs = stack_option_matrix_scalar_get_args(tensor, row, col, result_type)
			Some(render_prepared_tensor_op(StackOptionMatrixLongGet(args)))
		NamedType(name, type_args):
			if type_args.length() == 0 and name == "Int128":
				args: StackOptionMatrixScalarGetArgs = stack_option_matrix_scalar_get_args(
					tensor,
					row,
					col,
					result_type,
				)
				Some(render_prepared_tensor_op(StackOptionMatrixInt128Get(args)))
			else if type_args.length() == 0 and name == "UInt128":
				args: StackOptionMatrixScalarGetArgs = stack_option_matrix_scalar_get_args(
					tensor,
					row,
					col,
					result_type,
				)
				Some(render_prepared_tensor_op(StackOptionMatrixUInt128Get(args)))
			else:
				None
		VoidType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		TensorType:
			None
		TupleType(items):
			None


private pure func emit_tensor_stack_option_get_call(
	name: String,
	args: List[String],
	typ: CoreType,
) -> Option[String]:
	match typ:
		NamedType(type_name, type_args):
			if type_name == "Option":
				match type_args:
					[payload_type]:
						if name == "blorp_vector_get_opt":
							match args:
								[tensor, index]:
									emit_vector_get_stack_option_payload(
										tensor,
										index,
										typ,
										payload_type,
									)
								[]:
									None
								[first]:
									None
								[first, second, third, ...rest]:
									None
						else if name == "blorp_matrix_get_opt":
							match args:
								[tensor, row, col]:
									emit_matrix_get_stack_option_payload(
										tensor,
										row,
										col,
										typ,
										payload_type,
									)
								[]:
									None
								[first]:
									None
								[first, second]:
									None
								[first, second, third, fourth, ...rest]:
									None
						else:
							None
					[]:
						None
					[first, second, ...rest]:
						None
			else:
				None
		VoidType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		EnumType(type_name):
			None
		ValueRecordType(type_name):
			None
		HeapRecordType(type_name):
			None
		UnionType(type_name):
			None
		RangeType:
			None
		TensorType:
			None
		TupleType(items):
			None


private pure func emit_prepared_channel_builtin_call(
	name: String,
	args: List[String],
	typ: CoreType,
) -> Option[String]:
	if name == "blorp_channel_new":
		elem_type ?= channel_element_type(typ)
		if boxed_value_needs_release_type(elem_type):
			match args:
				[capacity]:
					render_args: ChannelWithElemReleaseArgs = {
						capacity = capacity,
						temp_seed = CHANNEL_ALLOC_TEMP_SEED
					}
					Some(render_prepared_backend_op(BackendChannelWithElemRelease(render_args)))
				[]:
					None
				[first, second, ...rest]:
					None
		else:
			None
	else:
		None


private pure func emit_call_value_from_args(
	kind: CoreCallKind,
	args: List[String],
	typ: CoreType,
) -> Option[String]:
	args_c: String = args.join(", ")

	match kind:
		IntrinsicCall(name):
			emit_intrinsic_call_from_values(name, args)
		UserCall(name, def_id):
			if name == "Some" or name == "None":
				None
			else:
				Some(name + "(" + args_c + ")")
		ForeignCall(name):
			Some(adapt_direct_call_result(name + "(" + args_c + ")", typ))
		ListToStringCall(callback_name):
			match args:
				[list_value]:
					Some(
						"blorp_list_to_string_cb(" + list_value + ", (blorp_String* (*)(void*))" + callback_name + ")",
					)
				[]:
					None
				[first, second, ...rest]:
					None
		BuiltinCall(name):
			match emit_tensor_stack_option_get_call(name, args, typ):
				Some(rendered):
					Some(rendered)
				None:
					match emit_tensor_fill_packed_from_values(name, args):
						Some(rendered):
							Some(rendered)
						None:
							match emit_prepared_dict_builtin_call(name, args, typ):
								Some(rendered):
									Some(rendered)
								None:
									match emit_prepared_channel_builtin_call(name, args, typ):
										Some(rendered):
											Some(rendered)
										None:
											if (
												name == "blorp_dict_get"
												or name == "blorp_vector_get_opt"
												or name == "blorp_matrix_get_opt"
												or name == "blorp_vector_new_fill"
												or name == "blorp_matrix_new_fill"
												or name == "blorp_vector_new_fill_packed"
												or name == "blorp_matrix_new_fill_packed"
												or name == "blorp_vector_set_cow_nullable"
												or name == "blorp_checked_set"
												or name == "blorp_matrix_checked_set"
											):
												None
											else:
												emit_direct_runtime_call(name, args, typ)
		OperationResultCall(bridge):
			None
		ListToStringCall(callback_name):
			None
		ClosureCall:
			None


private pure func emit_call_body(
	kind: CoreCallKind,
	args: List[CoreExpr],
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	args_body ?= emit_call_args_body(args, next_temp)
	value ?= emit_call_value_from_args(kind, args_body.args, typ)
	Some({
		statements = args_body.statements,
		value = value,
		next_temp = args_body.next_temp,
		returns = False,
	})


private pure func emit_tuple_element_box(element: CoreTupleElement) -> Option[String]:
	match element:
		TuplePrimElement(value):
			value_c ?= emit_simple_expr(value)
			Some("(void*)(long)(" + value_c + ")")
		TuplePointerElement(value):
			value_c ?= emit_simple_expr(value)
			Some("(void*)" + value_c)
		TupleStructElement(value, c_type):
			value_c ?= emit_simple_expr(value)
			Some(
				"({ " + c_type + " __box_struct_value = " + value_c + "; blorp_box_struct(&__box_struct_value, sizeof(" + c_type + ")); })",
			)
		TupleVoidElement:
			Some("(void*)0")
		TupleFloatElement(value):
			value_c ?= emit_simple_expr(value)
			Some("blorp_box_float(" + value_c + ")")
		TupleFloat32Element(value):
			value_c ?= emit_simple_expr(value)
			Some("blorp_box_float32(" + value_c + ")")
		TupleFloat16Element(value):
			value_c ?= emit_simple_expr(value)
			Some("blorp_box_float16(" + value_c + ")")


private pure func tuple_call_args_suffix(values: List[String]) -> String:
	if values.length() == 0:
		""
	else:
		", " + values.join(", ")


private pure func tuple_element_box_args(elements: List[CoreTupleElement]) -> Option[String]:
	var values: List[String] = []
	var failed: Bool = False

	for element in elements:
		if not failed:
			match emit_tuple_element_box(element):
				Some(value):
					values = values.append(value)
				None:
					failed = True

	if failed:
		None
	else:
		Some(tuple_call_args_suffix(values))


private pure func int_power_of_two(exponent: Int) -> Int:
	var result: Int = 1
	var index: Int = 0

	while index < exponent:
		result *= 2
		index += 1

	result


private pure func mask_contains_bit(mask: Int, index: Int) -> Bool:
	bit: Int = int_power_of_two(index)
	mask / bit % 2 == 1


private pure func tuple_retain_statements(
	tuple_construct: CoreTupleConstruct,
	tuple_name: String,
) -> String:
	var statements: List[String] = []
	var index: Int = 0

	for element in tuple_construct.elements:
		if mask_contains_bit(tuple_construct.retain_mask, index):
			args: TupleRetainElemArgs = {
				tuple = tuple_name,
				index = index.to_string()
			}
			statements = statements.append(render_prepared_tuple_op(TupleRetainElem(args)))

		index += 1

	statements.join(" ")


private pure func render_tuple_construct_from_args(
	tuple_construct: CoreTupleConstruct,
	args_c: String,
) -> String:
	arity: String = tuple_construct.elements
		.length()
		.to_string()

	if tuple_construct.release_mask == 0:
		args: TupleConstructArgs = {
			arity = arity,
			args = args_c
		}

		render_prepared_tuple_op(TupleConstruct(args))
	else:
		tuple_name: String = render_prepared_tuple_op(TupleName(TUPLE_RC_TEMP_SEED))
		args: TupleConstructWithRcArgs = {
			tuple = tuple_name,
			arity = arity,
			args = args_c,
			retain_statements = tuple_retain_statements(tuple_construct, tuple_name),
			release_mask = tuple_construct.release_mask.to_string()
		}

		render_prepared_tuple_op(TupleConstructWithRc(args))


private pure func emit_tuple_construct(tuple_construct: CoreTupleConstruct) -> Option[String]:
	args_c ?= tuple_element_box_args(tuple_construct.elements)
	Some(render_tuple_construct_from_args(tuple_construct, args_c))


private pure func emit_tuple_element_box_body(
	element: CoreTupleElement,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match element:
		TuplePrimElement(value):
			value_body ?= emit_function_body(value, next_temp)

			if value_body.returns:
				None
			else:
				value_c ?= required_body_value(value_body)
				Some({
					statements = value_body.statements,
					value = "(void*)(long)(" + value_c + ")",
					next_temp = value_body.next_temp,
					returns = False,
				})
		TuplePointerElement(value):
			value_body ?= emit_function_body(value, next_temp)

			if value_body.returns:
				None
			else:
				value_c ?= required_body_value(value_body)
				Some({
					statements = value_body.statements,
					value = "(void*)" + value_c,
					next_temp = value_body.next_temp,
					returns = False,
				})
		TupleStructElement(value, c_type):
			value_body ?= emit_function_body(value, next_temp)

			if value_body.returns:
				None
			else:
				value_c ?= required_body_value(value_body)
				struct_tmp: String = temp_name("tuple_struct", value_body.next_temp)
				Some({
					statements = value_body.statements + "  " + c_type + " " + struct_tmp + " = " + value_c + ";\n",
					value = "blorp_box_struct(&" + struct_tmp + ", sizeof(" + c_type + "))",
					next_temp = value_body.next_temp + 1,
					returns = False,
				})
		TupleVoidElement:
			Some(body_value("(void*)0", next_temp))
		TupleFloatElement(value):
			value_body ?= emit_function_body(value, next_temp)

			if value_body.returns:
				None
			else:
				value_c ?= required_body_value(value_body)
				Some({
					statements = value_body.statements,
					value = "blorp_box_float(" + value_c + ")",
					next_temp = value_body.next_temp,
					returns = False,
				})
		TupleFloat32Element(value):
			value_body ?= emit_function_body(value, next_temp)

			if value_body.returns:
				None
			else:
				value_c ?= required_body_value(value_body)
				Some({
					statements = value_body.statements,
					value = "blorp_box_float32(" + value_c + ")",
					next_temp = value_body.next_temp,
					returns = False,
				})
		TupleFloat16Element(value):
			value_body ?= emit_function_body(value, next_temp)

			if value_body.returns:
				None
			else:
				value_c ?= required_body_value(value_body)
				Some({
					statements = value_body.statements,
					value = "blorp_box_float16(" + value_c + ")",
					next_temp = value_body.next_temp,
					returns = False,
				})


private pure func emit_tuple_construct_args_body(
	elements: List[CoreTupleElement],
	next_temp: Int,
) -> Option[CallArgsBody]:
	var statements: String = ""
	var values: List[String] = []
	var failed: Bool = False
	var temp_index: Int = next_temp

	for element in elements:
		if not failed:
			match emit_tuple_element_box_body(element, temp_index):
				Some(element_body):
					match required_body_value(element_body):
						Some(element_value):
							if element_body.statements == "":
								values = values.append(element_value)
								temp_index = element_body.next_temp
							else:
								arg_temp: String = temp_name("tuple_arg", element_body.next_temp)
								statements += "  void* " + arg_temp + ";\n  {\n" + indent_statements(
									element_body.statements + "  " + arg_temp + " = " + element_value + ";\n",
								) + "  }\n"
								values = values.append(arg_temp)
								temp_index = element_body.next_temp + 1
						None:
							failed = True
				None:
					failed = True

	if failed:
		None
	else:
		Some({
			statements = statements,
			args = values,
			next_temp = temp_index,
		})


private pure func emit_tuple_construct_body(
	tuple_construct: CoreTupleConstruct,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	args_body ?= emit_tuple_construct_args_body(tuple_construct.elements, next_temp)
	Some({
		statements = args_body.statements,
		value = render_tuple_construct_from_args(
			tuple_construct,
			tuple_call_args_suffix(args_body.args),
		),
		next_temp = args_body.next_temp,
		returns = False,
	})


private pure func list_alloc_call(layout: CoreListStorageLayout, capacity: String) -> String:
	match layout:
		PointerListStorage:
			"blorp_list_new(" + capacity + ")"
		InlineListStorage(width_bytes):
			"blorp_list_new_inline(" + capacity + ", " + width_bytes.to_string() + ")"
		InlineStructListStorage(c_type):
			"blorp_list_new_inline(" + capacity + ", sizeof(" + c_type + "))"


private pure func list_construct_alloc(layout: CoreListStorageLayout, len: Int) -> String:
	list_alloc_call(layout, len.to_string())


private pure func boxed_pointer_value_from_c(
	kind: CoreBoxKind,
	source_type: CoreType,
	value_c: String,
) -> Option[String]:
	match kind:
		PrimBox:
			Some("(void*)(long)(" + value_c + ")")
		PointerBox:
			Some("(void*)" + value_c)
		VoidBox:
			Some("(void*)0")
		FloatBox:
			Some("blorp_box_float(" + value_c + ")")
		Float32Box:
			Some("blorp_box_float32(" + value_c + ")")
		Float16Box:
			Some("blorp_box_float16(" + value_c + ")")
		Int128Box:
			Some("blorp_box_int128(" + value_c + ")")
		UInt128Box:
			Some("blorp_box_uint128(" + value_c + ")")
		StructBox(c_type):
			if is_stack_result_type(source_type):
				Some("blorp_box_stack_result(blorp_stack_result_retain_value(" + value_c + "))")
			else:
				Some(
					"({ " + c_type + " __box_struct_value = " + value_c + "; blorp_box_struct(&__box_struct_value, sizeof(" + c_type + ")); })",
				)


private pure func emit_boxed_pointer_value(value: CoreBoxedStorageValue) -> Option[String]:
	value_c ?= emit_simple_expr(value.value)
	boxed_pointer_value_from_c(value.kind, core_expr_type(value.value), value_c)


private pure func emit_boxed_pointer_body(
	value: CoreBoxedStorageValue,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match emit_boxed_pointer_value(value):
		Some(value_c):
			Some(body_value(value_c, next_temp))
		None:
			value_body ?= emit_function_body(value.value, next_temp)

			if value_body.returns:
				None
			else:
				match value.kind:
					VoidBox:
						Some({
							statements = discard_expr_body(value.value, value_body),
							value = "(void*)0",
							next_temp = value_body.next_temp,
							returns = False,
						})
					PrimBox:
						value_c ?= required_body_value(value_body)
						Some({
							statements = value_body.statements,
							value = "(void*)(long)(" + value_c + ")",
							next_temp = value_body.next_temp,
							returns = False,
						})
					PointerBox:
						value_c ?= required_body_value(value_body)
						Some({
							statements = value_body.statements,
							value = "(void*)" + value_c,
							next_temp = value_body.next_temp,
							returns = False,
						})
					FloatBox:
						value_c ?= required_body_value(value_body)
						Some({
							statements = value_body.statements,
							value = "blorp_box_float(" + value_c + ")",
							next_temp = value_body.next_temp,
							returns = False,
						})
					Float32Box:
						value_c ?= required_body_value(value_body)
						Some({
							statements = value_body.statements,
							value = "blorp_box_float32(" + value_c + ")",
							next_temp = value_body.next_temp,
							returns = False,
						})
					Float16Box:
						value_c ?= required_body_value(value_body)
						Some({
							statements = value_body.statements,
							value = "blorp_box_float16(" + value_c + ")",
							next_temp = value_body.next_temp,
							returns = False,
						})
					Int128Box:
						value_c ?= required_body_value(value_body)
						Some({
							statements = value_body.statements,
							value = "blorp_box_int128(" + value_c + ")",
							next_temp = value_body.next_temp,
							returns = False,
						})
					UInt128Box:
						value_c ?= required_body_value(value_body)
						Some({
							statements = value_body.statements,
							value = "blorp_box_uint128(" + value_c + ")",
							next_temp = value_body.next_temp,
							returns = False,
						})
					StructBox(c_type):
						value_c ?= required_body_value(value_body)
						value_expr: String = if is_stack_result_type(core_expr_type(value.value)):
							"blorp_box_stack_result(blorp_stack_result_retain_value(" + value_c + "))"
						else:
							"({ " + c_type + " __box_struct_value = " + value_c + "; blorp_box_struct(&__box_struct_value, sizeof(" + c_type + ")); })"
						Some({
							statements = value_body.statements,
							value = value_expr,
							next_temp = value_body.next_temp,
							returns = False,
						})


private pure func render_list_construct_append_body(
	list_name: String,
	value: CoreBoxedStorageValue,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	value_body ?= emit_boxed_pointer_body(value, next_temp)
	scoped_value: FunctionBodyC = scoped_c_value("list_elem", "void*", value_body)
	value_c ?= required_body_value(scoped_value)

	append_statement: String = if value.transfers_ownership:
		"  " + list_name + " = blorp_list_append_owned(" + list_name + ", " + value_c + ");\n"
	else:
		"  " + list_name + " = blorp_list_append(" + list_name + ", " + value_c + ");\n"

	Some({
		statements = scoped_value.statements + append_statement,
		value = "",
		next_temp = scoped_value.next_temp,
		returns = False,
	})


private pure func render_inline_struct_list_write(
	list_name: String,
	index: Int,
	c_type: String,
	value: CoreBoxedStorageValue,
) -> Option[String]:
	value_c ?= emit_simple_expr(value.value)
	elem_name: String = "__lst_elem_" + index.to_string()

	Some(
		"  { " + c_type + " " + elem_name + " = " + value_c + "; blorp_list_set_raw_copy(" + list_name + ", " + index.to_string() + ", &" + elem_name + "); }\n",
	)


private pure func emit_list_construct(construct: CoreListConstruct) -> Option[String]:
	list_name: String = "__lst"
	len: Int = construct.elements.length()
	var statements: String = "({\n  blorp_List* " + list_name + " = " + list_construct_alloc(
		construct.layout,
		len,
	) + ";\n"
	var failed: Bool = False
	var index: Int = 0
	var temp_index: Int = 0

	if construct.elem_needs_release:
		statements += "  blorp_list_init_elem_release(" + list_name + ", blorp_elem_release_fn);\n"

	match construct.layout:
		InlineStructListStorage(c_type):
			for value in construct.elements:
				if not failed:
					match render_inline_struct_list_write(list_name, index, c_type, value):
						Some(statement):
							statements += statement
						None:
							failed = True

				index += 1
		PointerListStorage:
			for value in construct.elements:
				if not failed:
					match render_list_construct_append_body(list_name, value, temp_index):
						Some(value_body):
							statements += value_body.statements
							temp_index = value_body.next_temp
						None:
							failed = True
		InlineListStorage(width_bytes):
			for value in construct.elements:
				if not failed:
					match render_list_construct_append_body(list_name, value, temp_index):
						Some(value_body):
							statements += value_body.statements
							temp_index = value_body.next_temp
						None:
							failed = True

	if failed:
		None
	else:
		statements += "  " + list_name + "->len = " + len.to_string() + ";\n  " + list_name + ";\n})"
		Some(statements)


private pure func emit_list_construct_body(
	construct: CoreListConstruct,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	list_name: String = temp_name("lst", next_temp)
	len: Int = construct.elements.length()
	var statements: String = "  blorp_List* " + list_name + " = " + list_construct_alloc(
		construct.layout,
		len,
	) + ";\n"
	var failed: Bool = False
	var index: Int = 0
	var temp_index: Int = next_temp + 1

	if construct.elem_needs_release:
		statements += "  blorp_list_init_elem_release(" + list_name + ", blorp_elem_release_fn);\n"

	match construct.layout:
		InlineStructListStorage(c_type):
			for value in construct.elements:
				if not failed:
					match render_inline_struct_list_write(list_name, index, c_type, value):
						Some(statement):
							statements += statement
						None:
							failed = True

				index += 1
		PointerListStorage:
			for value in construct.elements:
				if not failed:
					match render_list_construct_append_body(list_name, value, temp_index):
						Some(value_body):
							statements += value_body.statements
							temp_index = value_body.next_temp
						None:
							failed = True
		InlineListStorage(width_bytes):
			for value in construct.elements:
				if not failed:
					match render_list_construct_append_body(list_name, value, temp_index):
						Some(value_body):
							statements += value_body.statements
							temp_index = value_body.next_temp
						None:
							failed = True

	if failed:
		None
	else:
		statements += "  " + list_name + "->len = " + len.to_string() + ";\n"
		Some({
			statements = statements,
			value = list_name,
			next_temp = temp_index,
			returns = False,
		})


private pure func emit_list_alloc(alloc: CoreListAlloc) -> Option[String]:
	capacity_c ?= emit_simple_expr(alloc.capacity)
	alloc_c: String = list_alloc_call(alloc.layout, capacity_c)

	if alloc.elem_needs_release:
		Some("({ blorp_List* __list_alloc = " + alloc_c + ((
				"; blorp_list_init_elem_release(__list_alloc, blorp_elem_release_fn); "
				+ "__list_alloc; })"
			)))
	else:
		Some(alloc_c)


private pure func inline_list_load_result(bounds: CoreListAccessBounds, load_c: String) -> String:
	match bounds:
		CheckedListAccess:
			(
				"(__builtin_expect(!__lg_list || __lg_idx < 0 || __lg_idx >= __lg_list->len, 0) "
				+ "? NULL : "
			) + load_c + ")"
		ProvenListAccess:
			load_c


private pure func emit_inline_list_get(get: CoreListGet, width_bytes: Int) -> Option[String]:
	list_c ?= emit_simple_expr(get.list)
	index_c ?= emit_simple_expr(get.index)
	width_c: String = width_bytes.to_string()
	load_c: String = (
		"({ uintptr_t __lg_bits = 0; memcpy(&__lg_bits, (char*)__lg_list->data + "
		+ "__lg_idx * "
	) + width_c + ", " + width_c + "); (void*)__lg_bits; })"

	Some(
		"({ blorp_List* __lg_list = (blorp_List*)" + list_c + "; long __lg_idx = " + index_c + "; " + inline_list_load_result(
			get.bounds,
			load_c,
		) + "; })",
	)


private pure func emit_runtime_list_get(get: CoreListGet) -> Option[String]:
	list_c ?= emit_simple_expr(get.list)
	index_c ?= emit_simple_expr(get.index)
	Some("blorp_list_get((blorp_List*)" + list_c + ", " + index_c + ")")


private pure func inline_struct_list_load_op(
	bounds: CoreListAccessBounds,
	args: InlineStructLoadArgs,
) -> PreparedListOp:
	match bounds:
		CheckedListAccess:
			InlineStructLoadChecked(args)
		ProvenListAccess:
			InlineStructLoadProven(args)


private pure func emit_inline_struct_list_unbox_get(
	get: CoreListGet,
	c_type: String,
) -> Option[String]:
	list_c ?= emit_simple_expr(get.list)
	index_c ?= emit_simple_expr(get.index)
	list_tmp: String = render_prepared_list_op(
		ListInlineStructUnboxListName(LIST_INLINE_STRUCT_LOAD_TEMP_SEED),
	)
	index_tmp: String = render_prepared_list_op(
		ListInlineStructUnboxIndexName(LIST_INLINE_STRUCT_LOAD_TEMP_SEED),
	)
	out_tmp: String = render_prepared_list_op(
		ListInlineStructUnboxOutName(LIST_INLINE_STRUCT_LOAD_TEMP_SEED),
	)
	open_args: ListInlineStructUnboxOpenArgs = {
		list = list_tmp,
		list_expr = list_c,
		index = index_tmp,
		index_expr = index_c,
		struct_ty = c_type,
		out = out_tmp
	}
	load_args: InlineStructLoadArgs = {
		list_tmp = list_tmp,
		index_tmp = index_tmp,
		out_tmp = out_tmp,
		temp_seed = LIST_INLINE_STRUCT_LOAD_TEMP_SEED,
		struct_ty = c_type
	}

	Some(
		render_prepared_list_op(
			ListInlineStructUnboxOpen(
				open_args,
			),
		) + " " + render_prepared_list_op(
			inline_struct_list_load_op(
				get.bounds,
				load_args,
			),
		) + " " + render_prepared_list_op(ListInlineStructUnboxClose(out_tmp)),
	)


private pure func emit_inline_struct_tensor_get_unchecked(
	args: List[CoreExpr],
	c_type: String,
) -> Option[String]:
	arg_values ?= emit_simple_expr_arg_values(args)

	match arg_values:
		[tensor, index]:
			get_args: InlineStructGetArgs = {
				tensor = tensor,
				index = index,
				temp_seed = TENSOR_INLINE_STRUCT_GET_TEMP_SEED,
				struct_ty = c_type
			}

			Some(render_prepared_tensor_op(InlineStructGetUnchecked(get_args)))
		[]:
			None
		[first]:
			None
		[first, second, third, ...rest]:
			None


private pure func emit_inline_struct_tensor_get_checked(
	args: List[CoreExpr],
	c_type: String,
) -> Option[String]:
	arg_values ?= emit_simple_expr_arg_values(args)

	match arg_values:
		[tensor, index]:
			get_args: InlineStructGetArgs = {
				tensor = tensor,
				index = index,
				temp_seed = TENSOR_INLINE_STRUCT_CHECKED_GET_TEMP_SEED,
				struct_ty = c_type
			}

			Some(render_prepared_tensor_op(InlineStructGetChecked(get_args)))
		[]:
			None
		[first]:
			None
		[first, second, third, ...rest]:
			None


private pure func emit_value_record_tensor_get_unchecked(
	name: String,
	args: List[CoreExpr],
	typ: CoreType,
) -> Option[String]:
	if name == "tensor_get_unchecked":
		match typ:
			ValueRecordType(type_name):
				emit_inline_struct_tensor_get_unchecked(args, c_type_name(typ))
			NamedType(type_name, type_args):
				None
			HeapRecordType(type_name):
				None
			UnionType(type_name):
				None
			EnumType(type_name):
				None
			StackResultType(ok_type, err_type):
				None
			BoxedResultType(ok_type, err_type):
				None
			RangeType:
				None
			TensorType:
				None
			TupleType(items):
				None
			VoidType:
				None
	else:
		None


private pure func tensor_raw_scalar_kind_for_type(typ: CoreType) -> Option[CoreTensorRawScalarKind]:
	match typ:
		NamedType(name, args):
			if args.length() != 0:
				None
			else if name == "Int" or name == "Int64":
				Some(TensorInt64Elements)
			else if name == "Float":
				Some(TensorFloat64Elements)
			else if name == "Float32":
				Some(TensorFloat32Elements)
			else:
				None
		VoidType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		EnumType(type_name):
			None
		ValueRecordType(type_name):
			None
		HeapRecordType(type_name):
			None
		UnionType(type_name):
			None
		RangeType:
			None
		TensorType:
			None
		TupleType(items):
			None


private pure func emit_raw_scalar_tensor_get_unchecked(
	name: String,
	args: List[CoreExpr],
	typ: CoreType,
) -> Option[String]:
	if name == "tensor_get_unchecked":
		kind ?= tensor_raw_scalar_kind_for_type(typ)
		arg_values ?= emit_simple_expr_arg_values(args)

		match arg_values:
			[tensor, index]:
				Some("((" + tensor_raw_pointer_c_type(kind) + ")((blorp_Vector*)" + tensor + ")->data)[" + index + "]")
			[]:
				None
			[first]:
				None
			[first, second, third, ...rest]:
				None
	else:
		None


private pure func emit_list_get(get: CoreListGet) -> Option[String]:
	match get.layout:
		PointerListStorage:
			emit_runtime_list_get(get)
		InlineListStorage(width_bytes):
			emit_inline_list_get(get, width_bytes)
		InlineStructListStorage(c_type):
			emit_runtime_list_get(get)


private pure func list_handoff_storage_mode(layout: CoreListStorageLayout) -> String:
	match layout:
		PointerListStorage:
			render_prepared_list_op(ListStorageModePointer)
		InlineListStorage(width_bytes):
			render_prepared_list_op(ListStorageModeInline)
		InlineStructListStorage(c_type):
			render_prepared_list_op(ListStorageModeInline)


private pure func list_handoff_element_size(layout: CoreListStorageLayout) -> String:
	match layout:
		PointerListStorage:
			render_prepared_list_op(ListElementSizePointer)
		InlineListStorage(width_bytes):
			width_bytes.to_string()
		InlineStructListStorage(c_type):
			render_prepared_list_op(ListElementSizeInlineStruct(c_type))


private pure func list_handoff_release_fn(handoff: CoreListHandoff) -> String:
	if handoff.elem_needs_release:
		render_prepared_list_op(ListElementReleaseFn)
	else:
		render_prepared_list_op(ListElementReleaseNone)


private pure func list_handoff_emit_mode(mode: CoreListHandoffMode) -> Option[ListHandoffEmitMode]:
	if mode == BorrowFreshHandoff:
		Some(EmitBorrowFreshHandoff)
	else if mode == ConsumeReuseHandoff:
		Some(EmitConsumeReuseHandoff)
	else:
		None


private pure func list_handoff_emit_write_order(
	order: CoreListHandoffWriteOrder,
) -> Option[ListHandoffEmitWriteOrder]:
	if order == ForwardCompactingHandoff:
		Some(EmitForwardCompactingHandoff)
	else:
		None


private pure func list_handoff_prefix(
	handoff: CoreListHandoff,
	mode: ListHandoffEmitMode,
	source_c: String,
	capacity_c: String,
) -> String:
	args: ListHandoffPrefixArgs = {
		source_ty = c_type_name(handoff.source_type),
		source = c_var_name(handoff.source_var),
		source_expr = source_c,
		capacity_expr = capacity_c,
		length = c_var_name(handoff.len_var),
		release_fn = list_handoff_release_fn(handoff),
		result_ty = c_type_name(handoff.result_type),
		result = c_var_name(handoff.result_var),
		storage_mode = list_handoff_storage_mode(handoff.layout),
		elem_size = list_handoff_element_size(handoff.layout),
		out = c_var_name(handoff.out_var),
		temp_seed = LIST_HANDOFF_TEMP_SEED
	}

	match mode:
		EmitBorrowFreshHandoff:
			render_prepared_list_op(ListHandoffBorrowPrefix(args))
		EmitConsumeReuseHandoff:
			render_prepared_list_op(ListHandoffReusePrefix(args))


private pure func list_handoff_suffix(
	handoff: CoreListHandoff,
	mode: ListHandoffEmitMode,
) -> String:
	match mode:
		EmitBorrowFreshHandoff:
			args: ListHandoffBorrowSuffixArgs = {
				result = c_var_name(handoff.result_var),
				out = c_var_name(handoff.out_var),
				length = c_var_name(handoff.len_var)
			}
			render_prepared_list_op(ListHandoffBorrowSuffix(args))
		EmitConsumeReuseHandoff:
			args: ListHandoffReuseSuffixArgs = {
				result = c_var_name(handoff.result_var),
				out = c_var_name(handoff.out_var),
				length = c_var_name(handoff.len_var),
				source = c_var_name(handoff.source_var),
				temp_seed = LIST_HANDOFF_TEMP_SEED
			}
			render_prepared_list_op(ListHandoffReuseSuffix(args))


private pure func emit_list_handoff(handoff: CoreListHandoff) -> Option[String]:
	mode ?= list_handoff_emit_mode(handoff.mode)
	write_order ?= list_handoff_emit_write_order(handoff.write_order)

	match write_order:
		EmitForwardCompactingHandoff:
			source_c ?= emit_simple_expr(handoff.source)
			capacity_c ?= emit_simple_expr(handoff.capacity)
			body_c ?= emit_function_body(handoff.body, 0)
			body_statements: String = statement_body(handoff.body, body_c)

			Some(
				list_handoff_prefix(
					handoff,
					mode,
					source_c,
					capacity_c,
				) + "\n" + body_statements + list_handoff_suffix(handoff, mode),
			)


private pure func emit_string_byte_read(read: CoreStringByteRead) -> Option[String]:
	source_c ?= emit_simple_expr(read.source)
	index_c ?= emit_simple_expr(read.index)
	Some("(long)(unsigned char)((blorp_String*)" + source_c + ")->data[" + index_c + "]")


private pure func emit_string_byte_write(write: CoreStringByteWrite) -> Option[String]:
	target_c ?= emit_simple_expr(write.target)
	index_c ?= emit_simple_expr(write.index)
	byte_c ?= emit_simple_expr(write.byte)

	Some("(((blorp_String*)" + target_c + ")->data[" + index_c + "] = (char)" + byte_c + ")")


private pure func emit_string_byte_copy(copy: CoreStringByteCopy) -> Option[String]:
	dst_c ?= emit_simple_expr(copy.dst)
	dst_pos_c ?= emit_simple_expr(copy.dst_pos)
	src_c ?= emit_simple_expr(copy.src)
	src_pos_c ?= emit_simple_expr(copy.src_pos)
	len_c ?= emit_simple_expr(copy.len)
	bind_dst: String = "blorp_String* __string_copy_dst = (blorp_String*)" + dst_c + ";"
	bind_dst_pos: String = "long __string_copy_dst_pos = " + dst_pos_c + ";"
	bind_src: String = "blorp_String* __string_copy_src = (blorp_String*)" + src_c + ";"
	bind_src_pos: String = "long __string_copy_src_pos = " + src_pos_c + ";"
	bind_len: String = "long __string_copy_len = " + len_c + ";"
	copy_statement: String = (
		"if (__string_copy_len > 0) { memcpy(__string_copy_dst->data + "
		+ "__string_copy_dst_pos, __string_copy_src->data + __string_copy_src_pos, "
		+ "(size_t)__string_copy_len); }"
	)

	Some(
		"({ " + bind_dst + " " + bind_dst_pos + " " + bind_src + " " + bind_src_pos + " " + bind_len + " " + copy_statement + " (void)0; })",
	)


private pure func emit_string_set_len(set_len: CoreStringSetLen) -> Option[String]:
	target_c ?= emit_simple_expr(set_len.target)
	len_c ?= emit_simple_expr(set_len.len)
	body: String = "blorp_String* __string_set_len_target = (blorp_String*)" + target_c + "; long __string_set_len_value = " + len_c + "; __string_set_len_target->len = __string_set_len_value; __string_set_len_target->data[__string_set_len_value] = '\\0'; (void)0;"

	Some("({ " + body + " })")


private pure func tensor_raw_scalar_supported(kind: CoreTensorRawScalarKind) -> Bool:
	if kind == TensorFloat64Elements:
		True
	else if kind == TensorFloat32Elements:
		True
	else if kind == TensorInt64Elements:
		True
	else:
		False


private pure func tensor_raw_pointer_c_type(kind: CoreTensorRawScalarKind) -> String:
	match kind:
		TensorFloat64Elements:
			"double*"
		TensorFloat32Elements:
			"float*"
		TensorInt64Elements:
			"long*"


private pure func tensor_raw_view_decl(binding: CoreTensorRawViewBinding) -> Option[String]:
	source_c ?= emit_simple_expr(binding.source)
	args: RawViewDeclArgs = {
		pointer_c_type = tensor_raw_pointer_c_type(binding.kind),
		view = binding.variable.name,
		source = source_c
	}

	Some(render_prepared_tensor_op(RawViewDecl(args)))


private pure func emit_tensor_raw_read(read: CoreTensorRawRead) -> Option[String]:
	index_c ?= emit_simple_expr(read.index)

	if tensor_raw_scalar_supported(read.kind):
		Some(render_prepared_tensor_op(RawRead(read.view.name, index_c)))
	else:
		None


private pure func emit_tensor_raw_write(write: CoreTensorRawWrite) -> Option[String]:
	index_c ?= emit_simple_expr(write.index)
	value_c ?= emit_simple_expr(write.value)
	args: RawWriteArgs = {
		view = write.view.name,
		index = index_c,
		value = value_c
	}

	if tensor_raw_scalar_supported(write.kind):
		Some(render_prepared_tensor_op(RawWriteExpr(args)))
	else:
		None


private union TensorLiteralAllocShape:
	TensorFlatAlloc(String)
	TensorRankedAlloc(String, String)


private pure func int_product_from_first(first: Int, rest: List[Int]) -> Int:
	var total: Int = first

	for value in rest:
		total *= value

	total


private pure func tensor_literal_alloc_shape(
	shape: CoreTensorLiteralShape,
) -> TensorLiteralAllocShape:
	match shape:
		TensorVectorLength(length):
			TensorFlatAlloc(length.to_string())
		TensorStaticShape(dims):
			match dims:
				[]:
					TensorFlatAlloc("0")
				[first, ...rest]:
					TensorRankedAlloc(
						first.to_string(),
						int_product_from_first(first, rest).to_string(),
					)


private pure func tensor_literal_alloc_op(
	kind: CoreTensorRawScalarKind,
	shape: CoreTensorLiteralShape,
) -> PreparedTensorOp:
	match tensor_literal_alloc_shape(shape):
		TensorFlatAlloc(size):
			match kind:
				TensorFloat64Elements:
					TensorAllocF64(size)
				TensorFloat32Elements:
					TensorAllocF32(size)
				TensorInt64Elements:
					TensorAllocI64(size)
		TensorRankedAlloc(first_dim, total_dim):
			args: TensorRankedAllocArgs = {
				first_dim = first_dim,
				total_dim = total_dim
			}

			match kind:
				TensorFloat64Elements:
					TensorRankedAllocF64(args)
				TensorFloat32Elements:
					TensorRankedAllocF32(args)
				TensorInt64Elements:
					TensorRankedAllocI64(args)


private pure func tensor_literal_write_statement(
	tensor: String,
	kind: CoreTensorRawScalarKind,
	index: Int,
	value: CoreExpr,
) -> Option[String]:
	value_c ?= emit_simple_expr(value)
	args: TensorLiteralWriteArgs = {
		tensor = tensor,
		index = index.to_string(),
		value = value_c
	}

	match kind:
		TensorFloat64Elements:
			Some(render_prepared_tensor_op(TensorLiteralF64Write(args)))
		TensorFloat32Elements:
			Some(render_prepared_tensor_op(TensorLiteralF32Write(args)))
		TensorInt64Elements:
			Some(render_prepared_tensor_op(TensorLiteralI64Write(args)))


private pure func tensor_literal_write_statements(
	tensor: String,
	raw: CoreTensorRawLiteral,
) -> Option[String]:
	var statements: String = ""
	var failed: Bool = False
	var index: Int = 0

	for element in raw.elements:
		if not failed:
			match tensor_literal_write_statement(tensor, raw.raw_kind, index, element):
				Some(statement):
					statements += statement + " "
				None:
					failed = True

		index += 1

	if failed:
		None
	else:
		Some(statements)


private pure func tensor_inline_struct_literal_alloc_op(
	shape: CoreTensorLiteralShape,
	struct_c_type: String,
) -> PreparedTensorOp:
	match tensor_literal_alloc_shape(shape):
		TensorFlatAlloc(size):
			TensorAllocSized({
				size = size,
				struct_ty = struct_c_type,
			})
		TensorRankedAlloc(first_dim, total_dim):
			TensorRankedAllocSized({
				first_dim = first_dim,
				total_dim = total_dim,
				struct_ty = struct_c_type,
			})


private pure func tensor_inline_struct_literal_write_statement(
	tensor: String,
	index: Int,
	value: CoreExpr,
	temp_seed: String,
	struct_c_type: String,
) -> Option[String]:
	value_c ?= emit_simple_expr(value)
	args: TensorLiteralInlineStructWriteArgs = {
		tensor = tensor,
		index = index.to_string(),
		value = value_c,
		temp_seed = temp_seed + "_" + index.to_string(),
		struct_ty = struct_c_type
	}

	Some(render_prepared_tensor_op(TensorLiteralInlineStructWrite(args)))


private pure func tensor_inline_struct_literal_write_statements(
	tensor: String,
	inline_struct: CoreTensorInlineStructLiteral,
	temp_seed: String,
) -> Option[String]:
	var statements: String = ""
	var failed: Bool = False
	var index: Int = 0

	for element in inline_struct.elements:
		if not failed:
			match tensor_inline_struct_literal_write_statement(
				tensor,
				index,
				element,
				temp_seed,
				inline_struct.struct_c_type,
			):
				Some(statement):
					statements += statement + " "
				None:
					failed = True

		index += 1

	if failed:
		None
	else:
		Some(statements)


private pure func emit_tensor_literal_payload(
	shape: CoreTensorLiteralShape,
	payload: CoreTensorLiteralPayload,
	temp_seed: String,
	tensor: String,
) -> Option[(String, String)]:
	match payload:
		TensorRawLiteralPayload(raw):
			alloc_expr: String = render_prepared_tensor_op(
				tensor_literal_alloc_op(
					raw.raw_kind,
					shape,
				),
			)
			statements ?= tensor_literal_write_statements(tensor, raw)
			Some((alloc_expr, statements))
		TensorInlineStructLiteralPayload(inline_struct):
			alloc_expr: String = render_prepared_tensor_op(
				tensor_inline_struct_literal_alloc_op(
					shape,
					inline_struct.struct_c_type,
				),
			)
			statements ?= tensor_inline_struct_literal_write_statements(
				tensor,
				inline_struct,
				temp_seed,
			)
			Some((alloc_expr, statements))


private pure func emit_tensor_literal(
	literal: CoreTensorLiteral,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	temp_seed: String = next_temp.to_string()
	tensor: String = render_prepared_tensor_op(TensorLiteralName(temp_seed))
	payload_result ?= emit_tensor_literal_payload(literal.shape, literal.payload, temp_seed, tensor)
	(alloc_expr, statements) = payload_result
	construct_args: TensorLiteralConstructArgs = {
		tensor = tensor,
		alloc_expr = alloc_expr,
		statements = statements
	}

	Some({
		statements = "",
		value = render_prepared_tensor_op(TensorLiteralConstruct(construct_args)),
		next_temp = next_temp + 1,
		returns = False,
	})


private pure func tensor_raw_fill_value_c_type(kind: CoreTensorRawScalarKind) -> String:
	match kind:
		TensorFloat64Elements:
			"double"
		TensorFloat32Elements:
			"float"
		TensorInt64Elements:
			"long"


private pure func tensor_raw_fill_alloc_op(
	kind: CoreTensorRawScalarKind,
	first_dim: String,
	total_dim: String,
) -> PreparedTensorOp:
	args: TensorRankedAllocArgs = {
		first_dim = first_dim,
		total_dim = total_dim
	}

	match kind:
		TensorFloat64Elements:
			TensorRankedAllocF64(args)
		TensorFloat32Elements:
			TensorRankedAllocF32(args)
		TensorInt64Elements:
			TensorRankedAllocI64(args)


private pure func tensor_raw_fill_dim_name(temp_seed: String, index: Int) -> String:
	render_prepared_tensor_op(TensorFillDimName({
		temp_seed = temp_seed,
		dim_index = index.to_string(),
	}))


private pure func tensor_raw_fill_dim_names(
	temp_seed: String,
	dims: List[CoreExpr],
) -> List[String]:
	var names: List[String] = []
	var index: Int = 0

	for dim in dims:
		names = names.append(tensor_raw_fill_dim_name(temp_seed, index))
		index += 1

	names


private pure func tensor_raw_fill_dim_bindings(
	temp_seed: String,
	dims: List[CoreExpr],
) -> Option[String]:
	var statements: String = ""
	var failed: Bool = False
	var index: Int = 0

	for dim in dims:
		if not failed:
			match emit_simple_expr(dim):
				Some(dim_value):
					args: TensorFillDimBindArgs = {
						temp_seed = temp_seed,
						dim_index = index.to_string(),
						dim_value = dim_value
					}
					statements += render_prepared_tensor_op(TensorFillDimBind(args)) + " "
				None:
					failed = True

		index += 1

	if failed:
		None
	else:
		Some(statements)


private pure func tensor_raw_fill_total_expr(dim_names: List[String]) -> String:
	var total_expr: String = ""

	for dim_name in dim_names:
		if total_expr == "":
			total_expr = dim_name
		else:
			total_expr = render_prepared_tensor_op(TensorFillProductExpr(total_expr, dim_name))

	if total_expr == "":
		"0"
	else:
		total_expr


private pure func tensor_raw_fill_value_expr(value: CoreExpr) -> CoreExpr:
	match value:
		BoxExpr(box, box_type, box_loc):
			box.value
		other:
			other


private pure func emit_tensor_raw_fill(
	fill: CoreTensorRawFill,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fill.dims:
		[]:
			None
		[first_dim_expr, ...rest_dims]:
			temp_seed: String = next_temp.to_string()
			dim_bindings ?= tensor_raw_fill_dim_bindings(temp_seed, fill.dims)
			dim_names: List[String] = tensor_raw_fill_dim_names(temp_seed, fill.dims)
			first_dim: String = tensor_raw_fill_dim_name(temp_seed, 0)
			total_expr: String = tensor_raw_fill_total_expr(dim_names)
			total_dim: String = render_prepared_tensor_op(TensorFillTotalName(temp_seed))
			value ?= emit_simple_expr(tensor_raw_fill_value_expr(fill.value))
			alloc_expr: String = render_prepared_tensor_op(
				tensor_raw_fill_alloc_op(
					fill.raw_kind,
					first_dim,
					total_dim,
				),
			)
			args: TensorFillRawScalarArgs = {
				dim_bindings = dim_bindings,
				total_expr = total_expr,
				value_c_type = tensor_raw_fill_value_c_type(fill.raw_kind),
				value = value,
				alloc_expr = alloc_expr,
				temp_seed = temp_seed
			}

			Some({
				statements = "",
				value = render_prepared_tensor_op(TensorFillRawScalar(args)),
				next_temp = next_temp + 1,
				returns = False,
			})


private pure func tensor_boxed_literal_alloc_op(shape: CoreTensorLiteralShape) -> PreparedTensorOp:
	match tensor_literal_alloc_shape(shape):
		TensorFlatAlloc(size):
			TensorAllocPointer(size)
		TensorRankedAlloc(first_dim, total_dim):
			TensorRankedAllocPointer({
				first_dim = first_dim,
				total_dim = total_dim,
			})


private pure func tensor_boxed_literal_write_statement(
	tensor: String,
	elem_needs_release: Bool,
	index: Int,
	value: CoreBoxedStorageValue,
	temp_seed: String,
) -> Option[String]:
	value_c ?= emit_boxed_pointer_value(value)

	if elem_needs_release:
		args: TensorLiteralBoxedSeededWriteArgs = {
			tensor = tensor,
			index = index.to_string(),
			value = value_c,
			temp_seed = temp_seed + "_" + index.to_string()
		}

		if value.transfers_ownership:
			Some(render_prepared_tensor_op(TensorLiteralBoxedOwnedWrite(args)))
		else:
			Some(render_prepared_tensor_op(TensorLiteralBoxedBorrowedWrite(args)))
	else:
		args: TensorLiteralWriteArgs = {
			tensor = tensor,
			index = index.to_string(),
			value = value_c
		}

		Some(render_prepared_tensor_op(TensorLiteralBoxedWrite(args)))


private pure func tensor_boxed_literal_write_statements(
	tensor: String,
	literal: CoreTensorBoxedLiteral,
	temp_seed: String,
) -> Option[String]:
	var statements: String = if literal.elem_needs_release:
		render_prepared_tensor_op(TensorInitElemRelease(tensor)) + " "
	else:
		""

	var failed: Bool = False
	var index: Int = 0

	for element in literal.elements:
		if not failed:
			match tensor_boxed_literal_write_statement(
				tensor,
				literal.elem_needs_release,
				index,
				element,
				temp_seed,
			):
				Some(statement):
					statements += statement + " "
				None:
					failed = True

		index += 1

	if failed:
		None
	else:
		Some(statements)


private pure func emit_tensor_boxed_literal(
	literal: CoreTensorBoxedLiteral,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	temp_seed: String = next_temp.to_string()
	tensor: String = render_prepared_tensor_op(TensorLiteralName(temp_seed))
	alloc_expr: String = render_prepared_tensor_op(tensor_boxed_literal_alloc_op(literal.shape))
	statements ?= tensor_boxed_literal_write_statements(tensor, literal, temp_seed)
	construct_args: TensorLiteralConstructArgs = {
		tensor = tensor,
		alloc_expr = alloc_expr,
		statements = statements
	}

	Some({
		statements = "",
		value = render_prepared_tensor_op(TensorLiteralConstruct(construct_args)),
		next_temp = next_temp + 1,
		returns = False,
	})


private pure func tensor_packed_literal_alloc_op(
	literal: CoreTensorPackedLiteral,
) -> PreparedTensorOp:
	elem_size: String = literal.elem_size.to_string()

	match tensor_literal_alloc_shape(literal.shape):
		TensorFlatAlloc(size):
			TensorAllocPacked({
				size = size,
				elem_size = elem_size,
			})
		TensorRankedAlloc(first_dim, total_dim):
			TensorRankedAllocPacked({
				first_dim = first_dim,
				total_dim = total_dim,
				elem_size = elem_size,
			})


private pure func tensor_packed_literal_write_statement(
	tensor: String,
	index: Int,
	value: CoreExpr,
) -> Option[String]:
	value_c ?= emit_simple_expr(value)
	args: TensorLiteralWriteArgs = {
		tensor = tensor,
		index = index.to_string(),
		value = value_c
	}

	Some(render_prepared_tensor_op(TensorLiteralPackedWrite(args)))


private pure func tensor_packed_literal_write_statements(
	tensor: String,
	literal: CoreTensorPackedLiteral,
) -> Option[String]:
	var statements: String = ""
	var failed: Bool = False
	var index: Int = 0

	for element in literal.elements:
		if not failed:
			match tensor_packed_literal_write_statement(tensor, index, element):
				Some(statement):
					statements += statement + " "
				None:
					failed = True

		index += 1

	if failed:
		None
	else:
		Some(statements)


private pure func emit_tensor_packed_literal(
	literal: CoreTensorPackedLiteral,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	temp_seed: String = next_temp.to_string()
	tensor: String = render_prepared_tensor_op(TensorLiteralName(temp_seed))
	alloc_expr: String = render_prepared_tensor_op(tensor_packed_literal_alloc_op(literal))
	statements ?= tensor_packed_literal_write_statements(tensor, literal)
	construct_args: TensorLiteralConstructArgs = {
		tensor = tensor,
		alloc_expr = alloc_expr,
		statements = statements
	}

	Some({
		statements = "",
		value = render_prepared_tensor_op(TensorLiteralConstruct(construct_args)),
		next_temp = next_temp + 1,
		returns = False,
	})


private pure func hash_container_release_arg(needs_release: Bool) -> ElemReleaseArg:
	if needs_release:
		ElemReleaseFn
	else:
		NoElemRelease


private pure func custom_ctor_args(hash_fn: String, equals_fn: String) -> CustomCtorArgs:
	{
		hash_fn = hash_fn,
		equals_fn = equals_fn
	}


private pure func emit_dict_constructor(constructor: CoreHashContainerConstructor) -> String:
	match constructor:
		GenericHashContainerConstructor:
			render_prepared_backend_op(BackendDictCtorGeneric)
		StringHashContainerConstructor:
			render_prepared_backend_op(BackendDictCtorString)
		FloatHashContainerConstructor:
			render_prepared_backend_op(BackendDictCtorFloat)
		CustomHashContainerConstructor(hash_fn, equals_fn, elem_needs_release):
			render_prepared_backend_op(
				BackendDictCtorCustom(
					custom_ctor_args(hash_fn, equals_fn),
					hash_container_release_arg(elem_needs_release),
				),
			)


private pure func emit_set_constructor(constructor: CoreHashContainerConstructor) -> String:
	match constructor:
		GenericHashContainerConstructor:
			render_prepared_backend_op(BackendSetCtorGeneric)
		StringHashContainerConstructor:
			render_prepared_backend_op(BackendSetCtorString)
		FloatHashContainerConstructor:
			render_prepared_backend_op(BackendSetCtorFloat)
		CustomHashContainerConstructor(hash_fn, equals_fn, elem_needs_release):
			render_prepared_backend_op(
				BackendSetCtorCustom(
					custom_ctor_args(hash_fn, equals_fn),
					hash_container_release_arg(elem_needs_release),
				),
			)


private pure func emit_dict_insert_statement(entry: CoreDictEntry) -> Option[String]:
	key_c ?= emit_boxed_pointer_value(entry.key)
	value_c ?= emit_boxed_pointer_value(entry.value)

	Some(render_prepared_backend_op(BackendDictInsert({
		temp_seed = DICT_CONSTRUCT_TEMP_SEED,
		key = key_c,
		value = value_c,
	})))


private pure func emit_dict_insert_statements(entries: List[CoreDictEntry]) -> Option[String]:
	var statements: String = ""
	var failed: Bool = False

	for entry in entries:
		if failed:
			void
		else:
			match emit_dict_insert_statement(entry):
				Some(statement):
					statements += statement
				None:
					failed = True

	if failed:
		None
	else:
		Some(statements)


private pure func emit_dict_construct(construct: CoreDictConstruct) -> Option[String]:
	ctor_c: String = emit_dict_constructor(construct.constructor)

	if construct.entries.length() == 0 and not construct.value_needs_release:
		Some(render_prepared_backend_op(BackendDictConstructEmpty(ctor_c)))
	else:
		insert_statements ?= emit_dict_insert_statements(construct.entries)

		release_init: String = if construct.value_needs_release:
			render_prepared_backend_op(BackendDictValueReleaseInit(DICT_CONSTRUCT_TEMP_SEED))
		else:
			""

		args: DictConstructWithBodyArgs = {
			ctor = ctor_c,
			temp_seed = DICT_CONSTRUCT_TEMP_SEED,
			release_init = release_init,
			insert_statements = insert_statements
		}

		Some(render_prepared_backend_op(BackendDictConstructWithBody(args)))


private pure func emit_set_alloc(alloc: CoreSetAlloc) -> Option[String]:
	Some(emit_set_constructor(alloc.constructor))


private pure func emit_inline_struct_list_set(set: CoreListSet, c_type: String) -> Option[String]:
	list_c ?= emit_simple_expr(set.list)
	index_c ?= emit_simple_expr(set.index)
	value_c ?= emit_simple_expr(set.value.value)

	boxed_fallback: String = if set.value_is_stack_result:
		"blorp_box_stack_result(__list_elem)"
	else:
		"blorp_box_struct(&__list_elem, sizeof(" + c_type + "))"

	Some(
		"({ blorp_List* __list_store = (blorp_List*)" + list_c + "; long __list_store_idx = " + index_c + "; " + c_type + " __list_elem = " + value_c + ((
			"; if (__list_store && __list_store->storage_mode == BLORP_LIST_STORAGE_INLINE "
			+ "&& __list_store->elem_size == (int16_t)sizeof("
		)) + c_type + ((
			")) { blorp_list_set_raw_copy(__list_store, __list_store_idx, &__list_elem); } "
			+ "else { blorp_list_set_raw((blorp_List*)__list_store, __list_store_idx, (void*)"
		)) + boxed_fallback + "); } })",
	)


private pure func emit_pointer_list_set(set: CoreListSet) -> Option[String]:
	list_c ?= emit_simple_expr(set.list)
	index_c ?= emit_simple_expr(set.index)
	value_c ?= emit_boxed_pointer_value(set.value)

	Some("({ blorp_list_set_raw((blorp_List*)" + list_c + ", " + index_c + ", " + value_c + "); })")


private pure func emit_pointer_list_set_body(
	set: CoreListSet,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	list_c ?= emit_simple_expr(set.list)
	index_c ?= emit_simple_expr(set.index)
	value_body ?= emit_boxed_pointer_body(set.value, next_temp)
	value ?= required_body_value(value_body)

	Some({
		statements = value_body.statements + "  blorp_list_set_raw((blorp_List*)" + list_c + ", " + index_c + ", " + value + ");\n",
		value = "",
		next_temp = value_body.next_temp,
		returns = False,
	})


private pure func emit_inline_list_set(set: CoreListSet, width_bytes: Int) -> Option[String]:
	list_c ?= emit_simple_expr(set.list)
	index_c ?= emit_simple_expr(set.index)
	value_c ?= emit_boxed_pointer_value(set.value)
	args: InlineBitsStoreArgs = {
		list = list_c,
		index = index_c,
		value = value_c,
		temp_seed = LIST_INLINE_STORE_TEMP_SEED,
		width_bytes = width_bytes.to_string()
	}

	Some(render_prepared_list_op(InlineBitsStore(args)))


private pure func emit_list_set(set: CoreListSet) -> Option[String]:
	match set.layout:
		InlineStructListStorage(c_type):
			emit_inline_struct_list_set(set, c_type)
		PointerListStorage:
			emit_pointer_list_set(set)
		InlineListStorage(width_bytes):
			emit_inline_list_set(set, width_bytes)


private pure func emit_list_set_body(set: CoreListSet, next_temp: Int) -> Option[FunctionBodyC]:
	match set.layout:
		InlineStructListStorage(c_type):
			value ?= emit_inline_struct_list_set(set, c_type)
			Some(body_value(value, next_temp))
		PointerListStorage:
			emit_pointer_list_set_body(set, next_temp)
		InlineListStorage(width_bytes):
			value ?= emit_inline_list_set(set, width_bytes)
			Some(body_value(value, next_temp))


private pure func emit_pointer_list_handoff_set_owned(set: CoreListSet) -> Option[String]:
	list_c ?= emit_simple_expr(set.list)
	index_c ?= emit_simple_expr(set.index)
	value_c ?= emit_boxed_pointer_value(set.value)
	args: PointerStoreArgs = {
		list = list_c,
		index = index_c,
		value = value_c
	}

	Some(render_prepared_list_op(PointerHandoffSetOwnedStore(args)))


private pure func emit_pointer_list_handoff_set_owned_body(
	set: CoreListSet,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	list_c ?= emit_simple_expr(set.list)
	index_c ?= emit_simple_expr(set.index)
	value_body ?= emit_boxed_pointer_body(set.value, next_temp)
	value ?= required_body_value(value_body)

	Some({
		statements = value_body.statements + "  blorp_list_set_raw((blorp_List*)" + list_c + ", " + index_c + ", " + value + ");\n",
		value = "",
		next_temp = value_body.next_temp,
		returns = False,
	})


private pure func emit_inline_struct_list_handoff_set_owned(
	set: CoreListSet,
	c_type: String,
) -> Option[String]:
	list_c ?= emit_simple_expr(set.list)
	index_c ?= emit_simple_expr(set.index)
	value_c ?= emit_simple_expr(set.value.value)

	boxing: InlineStructStoreBoxing = if set.value_is_stack_result:
		StackResultBoxing
	else:
		StructAddressBoxing

	args: InlineStructStoreArgs = {
		list = list_c,
		index = index_c,
		value = value_c,
		boxing = boxing,
		temp_seed = LIST_HANDOFF_STORE_TEMP_SEED,
		struct_ty = c_type
	}

	Some(render_prepared_list_op(InlineStructHandoffSetOwnedStore(args)))


private pure func emit_list_handoff_set_owned(set: CoreListSet) -> Option[String]:
	match set.layout:
		PointerListStorage:
			emit_pointer_list_handoff_set_owned(set)
		InlineStructListStorage(c_type):
			emit_inline_struct_list_handoff_set_owned(set, c_type)
		InlineListStorage(width_bytes):
			None


private pure func emit_list_handoff_set_owned_body(
	set: CoreListSet,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match set.layout:
		PointerListStorage:
			emit_pointer_list_handoff_set_owned_body(set, next_temp)
		InlineStructListStorage(c_type):
			value ?= emit_inline_struct_list_handoff_set_owned(set, c_type)
			Some(body_value(value, next_temp))
		InlineListStorage(width_bytes):
			None


private pure func emit_list_handoff_set_source_slot(
	slot: CoreListHandoffSetSourceSlot,
) -> Option[String]:
	result_c ?= emit_simple_expr(slot.result)
	out_index_c ?= emit_simple_expr(slot.out_index)
	source_c ?= emit_simple_expr(slot.source)
	source_index_c ?= emit_simple_expr(slot.source_index)
	args: SourceSlotHandoffArgs = {
		result = result_c,
		out_index = out_index_c,
		source = source_c,
		source_index = source_index_c
	}

	Some(render_prepared_list_op(HandoffSetSourceSlot(args)))


private pure func emit_list_retain(retain: CoreListRetain) -> Option[String]:
	list_c ?= emit_simple_expr(retain.list)
	value_c ?= emit_boxed_pointer_value(retain.value)

	Some("blorp_list_retain_for((blorp_List*)" + list_c + ", " + value_c + ")")


private pure func emit_record_construct(
	type_name: String,
	fields: List[CoreRecordFieldValue],
) -> Option[String]:
	var values: List[String] = []
	var failed: Bool = False

	for field in fields:
		if not failed:
			match emit_simple_expr(field.value):
				Some(value):
					values = values.append(value)
				None:
					failed = True

	if failed:
		None
	else:
		Some(type_name + "_make(" + values.join(", ") + ")")


private pure func emit_record_construct_args_body(
	fields: List[CoreRecordFieldValue],
	next_temp: Int,
) -> Option[CallArgsBody]:
	var statements: String = ""
	var values: List[String] = []
	var failed: Bool = False
	var temp_index: Int = next_temp

	for field in fields:
		if not failed:
			match emit_function_body(field.value, temp_index):
				Some(field_body):
					if field_body.returns:
						failed = True
					else:
							match required_body_value(field_body):
								Some(field_value):
									scoped_field: FunctionBodyC = scoped_body_value(
										"record_field",
										core_expr_type(field.value),
										field_body,
									)
									statements += scoped_field.statements
									values = values.append(scoped_field.value)
									temp_index = scoped_field.next_temp
								None:
									failed = True
				None:
					failed = True

	if failed:
		None
	else:
		Some({
			statements = statements,
			args = values,
			next_temp = temp_index,
		})


private pure func emit_record_construct_body(
	type_name: String,
	fields: List[CoreRecordFieldValue],
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	args_body ?= emit_record_construct_args_body(fields, next_temp)

	Some(
		emit_temp_value_body(
			"record_result",
			typ,
			args_body.statements,
			type_name + "_make(" + args_body.args.join(", ") + ")",
			args_body.next_temp,
		),
	)


private pure func emit_generic_union_arg(
	payload_storage: CoreUnionPayloadStorage,
	arg: CoreBoxedStorageValue,
) -> Option[String]:
	match payload_storage:
		TypedUnionPayloadStorage:
			emit_simple_expr(arg.value)
		ErasedUnionPayloadStorage:
			emit_boxed_pointer_value(arg)


private pure func emit_generic_union_args(construct: CoreUnionConstruct) -> Option[List[String]]:
	var args: List[String] = []
	var failed: Bool = False

	for arg in construct.args:
		if not failed:
			match emit_generic_union_arg(construct.payload_storage, arg):
				Some(arg_c):
					args = args.append(arg_c)
				None:
					failed = True

	if failed:
		None
	else:
		Some(args)


private pure func emit_stack_option_args(construct: CoreUnionConstruct) -> Option[List[String]]:
	var args: List[String] = []
	var failed: Bool = False

	for arg in construct.args:
		if not failed:
			match emit_simple_expr(arg.value):
				Some(arg_c):
					args = args.append(arg_c)
				None:
					failed = True

	if failed:
		None
	else:
			Some(args)


private pure func emit_stack_option_value(
	info: CoreStackOptionRepresentation,
	payload: CoreBoxedStorageValue,
) -> Option[String]:
	if is_void_type(core_expr_type(payload.value)):
		statement ?= emit_simple_expr(payload.value)
		args: StackOptionVoidStatementArgs = {
			option_type = info.option_type,
			tag = info.tag.to_string(),
			statement = statement + ";"
		}
		Some(render_prepared_constructor_op(StackOptionVoidStatement(args)))
	else:
		value ?= emit_simple_expr(payload.value)
		args: StackOptionValueArgs = {
			option_type = info.option_type,
			tag = info.tag.to_string(),
			value = value
		}
		Some(render_prepared_constructor_op(StackOptionValue(args)))


private pure func emit_stack_option_none(info: CoreStackOptionRepresentation) -> String:
	args: StackOptionNoneArgs = {
		option_type = info.option_type,
		tag = info.tag.to_string(),
		none_value = info.none_value
	}
	render_prepared_constructor_op(StackOptionNone(args))


private pure func emit_union_construct(construct: CoreUnionConstruct) -> Option[String]:
	match construct.representation:
		BoxedOptionRepresentation:
			initial_args ?= emit_generic_union_args(construct)
			var args: List[String] = initial_args

			if args.length() == 0:
				Some(construct.constructor_c_name)
			else:
				if construct.uses_release_mask:
					args = args.append(construct.release_mask.to_string() + "UL")

				Some(construct.constructor_c_name + "(" + args.join(", ") + ")")
		GenericUnionRepresentation:
			initial_args ?= emit_generic_union_args(construct)
			var args: List[String] = initial_args

			if args.length() == 0:
				Some(construct.constructor_c_name)
			else:
				if construct.uses_release_mask:
					args = args.append(construct.release_mask.to_string() + "UL")

				Some(construct.constructor_c_name + "(" + args.join(", ") + ")")
		StackOptionRepresentation(info):
			match construct.args:
				[]:
					Some(emit_stack_option_none(info))
				[payload]:
					emit_stack_option_value(info, payload)
				[first, second, ...rest]:
					None
		StackResultRepresentation(info):
			match construct.args:
				[payload]:
					payload_c ?= emit_boxed_pointer_value(payload)
					render_args: StackResultTaggedPayloadArgs = {
						result_type = info.result_type,
						tag = info.tag.to_string(),
						field = construct.constructor_name,
						payload = payload_c,
						release_mask = info.release_mask.to_string()
					}

					Some(render_prepared_backend_op(BackendStackResultTaggedPayload(render_args)))
				[]:
					None
				[first, second, ...rest]:
					None
		NullableOptionRepresentation:
			args ?= emit_stack_option_args(construct)

			match args:
				[]:
					Some("NULL")
				[payload]:
					Some(payload)
				[first, second, ...rest]:
					None


private pure func emit_generic_union_construct_body(
	construct: CoreUnionConstruct,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	var statements: String = ""
	var args: List[String] = []
	var failed: Bool = False
	var temp_index: Int = next_temp

	for arg in construct.args:
		if not failed:
			match construct.payload_storage:
				TypedUnionPayloadStorage:
					match emit_function_body(arg.value, temp_index):
						Some(arg_body):
							if arg_body.returns:
								failed = True
							else:
								match required_body_value(arg_body):
									Some(arg_c):
										statements += arg_body.statements
										args = args.append(arg_c)
										temp_index = arg_body.next_temp
									None:
										failed = True
						None:
							failed = True
				ErasedUnionPayloadStorage:
					match emit_boxed_pointer_body(arg, temp_index):
						Some(arg_body):
							match required_body_value(arg_body):
								Some(arg_c):
									statements += arg_body.statements
									args = args.append(arg_c)
									temp_index = arg_body.next_temp
								None:
									failed = True
						None:
							failed = True

	if failed:
		None
	else if args.length() == 0:
		Some({
			statements = statements,
			value = construct.constructor_c_name,
			next_temp = temp_index,
			returns = False,
		})
	else:
		if construct.uses_release_mask:
			args = args.append(construct.release_mask.to_string() + "UL")

		Some({
			statements = statements,
			value = construct.constructor_c_name + "(" + args.join(", ") + ")",
			next_temp = temp_index,
			returns = False,
		})


private pure func emit_stack_result_construct_body(
	construct: CoreUnionConstruct,
	info: CoreStackResultRepresentation,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match construct.args:
		[payload]:
			payload_body ?= emit_boxed_pointer_body(payload, next_temp)
			payload_c ?= required_body_value(payload_body)
			render_args: StackResultTaggedPayloadArgs = {
				result_type = info.result_type,
				tag = info.tag.to_string(),
				field = construct.constructor_name,
				payload = payload_c,
				release_mask = info.release_mask.to_string()
			}
			Some({
				statements = payload_body.statements,
				value = render_prepared_backend_op(BackendStackResultTaggedPayload(render_args)),
				next_temp = payload_body.next_temp,
				returns = False,
			})
		[]:
			None
		[first, second, ...rest]:
			None


private pure func emit_nullable_option_construct_body(
	construct: CoreUnionConstruct,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match construct.args:
		[]:
			Some(body_value("NULL", next_temp))
		[payload]:
			emit_boxed_pointer_body(payload, next_temp)
		[first, second, ...rest]:
			None


private pure func emit_union_construct_body(
	construct: CoreUnionConstruct,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match construct.representation:
		BoxedOptionRepresentation:
			emit_generic_union_construct_body(construct, next_temp)
		GenericUnionRepresentation:
			emit_generic_union_construct_body(construct, next_temp)
		StackOptionRepresentation(info):
			match construct.args:
				[]:
					Some(body_value(emit_stack_option_none(info), next_temp))
				[payload]:
					payload_body ?= emit_function_body(payload.value, next_temp)

					if payload_body.returns:
						None
					else if is_void_type(core_expr_type(payload.value)):
						args: StackOptionVoidStatementArgs = {
							option_type = info.option_type,
							tag = info.tag.to_string(),
							statement = payload_body.statements
						}
						Some({
							statements = "",
							value = render_prepared_constructor_op(
								StackOptionVoidStatement(args),
							),
							next_temp = payload_body.next_temp,
							returns = False,
						})
					else:
						payload_c ?= required_body_value(payload_body)
						args: StackOptionValueArgs = {
							option_type = info.option_type,
							tag = info.tag.to_string(),
							value = payload_c
						}
						Some({
							statements = payload_body.statements,
							value = render_prepared_constructor_op(StackOptionValue(args)),
							next_temp = payload_body.next_temp,
							returns = False,
						})
				[first, second, ...rest]:
					None
		StackResultRepresentation(info):
			emit_stack_result_construct_body(construct, info, next_temp)
		NullableOptionRepresentation:
			emit_nullable_option_construct_body(construct, next_temp)


private pure func is_named_pointer_tuple_slot_type(name: String, args: List[CoreType]) -> Bool:
	(
		name == "String"
		or name == "Bytes"
		or name == "Fixed"
		or name == "Closure"
		or name == "List"
		or name == "Dict"
		or name == "Set"
		or name == "Channel"
		or name == "Ptr"
	)


private pure func is_pointer_tuple_slot_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			is_named_pointer_tuple_slot_type(name, args)
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			True
		HeapRecordType(name):
			True
		UnionType(name):
			True
		TupleType(items):
			True
		TensorType:
			True
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False


private pure func emit_float_tuple_field_access(element_c: String, typ: CoreType) -> Option[String]:
	match typ:
		NamedType(name, args):
			if args.length() != 0:
				None
			else if name == "Float":
				Some("blorp_unbox_float(" + element_c + ")")
			else if name == "Float32":
				Some("blorp_unbox_float32(" + element_c + ")")
			else if name == "Float16":
				Some("blorp_unbox_float16(" + element_c + ")")
			else:
				None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		TupleType(items):
			None
		TensorType:
			None
		VoidType:
			None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		RangeType:
			None


private pure func emit_tuple_field_access(
	expr_value: CoreExpr,
	field_index: Int,
	typ: CoreType,
) -> Option[String]:
	tuple_c ?= emit_simple_expr(expr_value)
	element_c: String = "((blorp_Tuple*)" + tuple_c + ")->elem[" + field_index.to_string() + "]"

	match emit_float_tuple_field_access(element_c, typ):
		Some(float_access):
			Some(float_access)
		None:
			if CorePrepare.is_primitive_tuple_slot_type(typ):
				field_type: String = c_type_name(typ)

				if field_type == "long":
					Some("((long)" + element_c + ")")
				else:
					Some("((" + field_type + ")(long)" + element_c + ")")
			else if is_pointer_tuple_slot_type(typ):
				Some("((" + c_type_name(typ) + ")" + element_c + ")")
			else:
				match typ:
					ValueRecordType(name):
						Some(boxed_struct_value_source(c_type_name(typ), element_c))
					NamedType(name, args):
						None
					StackResultType(ok_type, err_type):
						None
					BoxedResultType(ok_type, err_type):
						None
					HeapRecordType(name):
						None
					UnionType(name):
						None
					TupleType(items):
						None
					TensorType:
						None
					VoidType:
						None
					EnumType(name):
						None
					RangeType:
						None


private pure func emit_field_access(expr_value: CoreExpr, field_name: String) -> Option[String]:
	expr_c ?= emit_simple_expr(expr_value)
	field_c: String = c_identifier(field_name)

	match core_expr_type(expr_value):
		HeapRecordType(name):
			Some(expr_c + "->" + field_c)
		ValueRecordType(name):
			Some(expr_c + "." + field_c)
		RangeType:
			Some(expr_c + "." + field_c)
		VoidType:
			None
		NamedType(name, args):
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		EnumType(name):
			None
		UnionType(name):
			None
		TensorType:
			None
		TupleType(items):
			None


private pure func emit_struct_unbox_from_pointer_expr(
	expr_value: CoreExpr,
	c_type: String,
) -> Option[String]:
	value_c ?= emit_simple_expr(expr_value)
	Some("blorp_unbox_struct(" + value_c + ", " + c_type + ")")


private pure func emit_unbox_expr(
	unbox_kind: CoreUnboxKind,
	expr_value: CoreExpr,
	typ: CoreType,
) -> Option[String]:
	match unbox_kind:
		FloatUnbox:
			value_c ?= emit_simple_expr(expr_value)
			Some("blorp_unbox_float(" + value_c + ")")
		Float32Unbox:
			value_c ?= emit_simple_expr(expr_value)
			Some("blorp_unbox_float32(" + value_c + ")")
		Float16Unbox:
			value_c ?= emit_simple_expr(expr_value)
			Some("blorp_unbox_float16(" + value_c + ")")
		Int128Unbox:
			value_c ?= emit_simple_expr(expr_value)
			Some("blorp_unbox_int128(" + value_c + ")")
		UInt128Unbox:
			value_c ?= emit_simple_expr(expr_value)
			Some("blorp_unbox_uint128(" + value_c + ")")
		PrimUnbox:
			value_c ?= emit_simple_expr(expr_value)
			Some("((" + c_type_name(typ) + ")(long)" + value_c + ")")
		PointerUnbox:
			value_c ?= emit_simple_expr(expr_value)
			Some("((" + c_type_name(typ) + ")" + value_c + ")")
		StructUnbox(c_type):
			match expr_value:
				ListGetExpr(get, list_get_type, loc):
					match get.layout:
						InlineStructListStorage(list_c_type):
							if list_c_type == c_type:
								emit_inline_struct_list_unbox_get(get, c_type)
							else:
								emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						PointerListStorage:
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						InlineListStorage(width_bytes):
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
				CallExpr(kind, callee, args, call_type, loc):
					match kind:
						IntrinsicCall(name):
							if name == "tensor_get_unchecked":
								emit_inline_struct_tensor_get_unchecked(args, c_type)
							else:
								emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						UserCall(name, def_id):
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						ForeignCall(name):
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						BuiltinCall(name):
							if name == "blorp_checked_get":
								emit_inline_struct_tensor_get_checked(args, c_type)
							else:
								emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						OperationResultCall(bridge):
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						ListToStringCall(callback_name):
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						ClosureCall:
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
				_:
					emit_struct_unbox_from_pointer_expr(expr_value, c_type)


private pure func emit_box_expr(box: CoreBoxOp) -> Option[String]:
	value_c ?= emit_simple_expr(box.value)

	match box.kind:
		VoidBox:
			Some("({ " + value_c + "; (void*)0; })")
		FloatBox:
			Some("blorp_box_float(" + value_c + ")")
		Float32Box:
			Some("blorp_box_float32(" + value_c + ")")
		Float16Box:
			Some("blorp_box_float16(" + value_c + ")")
		Int128Box:
			Some("blorp_box_int128(" + value_c + ")")
		UInt128Box:
			Some("blorp_box_uint128(" + value_c + ")")
		PrimBox:
			Some("(void*)(long)(" + value_c + ")")
		PointerBox:
			Some("(void*)" + value_c)
		StructBox(c_type):
			if is_stack_result_type(box.source_type):
				Some("blorp_box_stack_result(blorp_stack_result_retain_value(" + value_c + "))")
			else:
				Some(
					"({ " + c_type + " __box = " + value_c + "; blorp_box_struct(&__box, sizeof(" + c_type + ")); })",
				)


private pure func closure_arg_needs_release(value: ClosureAbiValue) -> Bool:
	match value:
		ClosureAbiVoid:
			False
		ClosureAbiPointer:
			False
		ClosureAbiPrim:
			False
		ClosureAbiFloat:
			False
		ClosureAbiFloat32:
			False
		ClosureAbiFloat16:
			False
		ClosureAbiInt128:
			True
		ClosureAbiUInt128:
			True
		ClosureAbiStruct(c_type):
			True


private pure func closure_arg_value_expr(value: ClosureAbiValue, value_c: String) -> String:
	match value:
		ClosureAbiVoid:
			"({ " + value_c + "; (void*)0; })"
		ClosureAbiPointer:
			"(void*)" + value_c
		ClosureAbiPrim:
			"(void*)(long)(" + value_c + ")"
		ClosureAbiFloat:
			"blorp_box_float(" + value_c + ")"
		ClosureAbiFloat32:
			"blorp_box_float32(" + value_c + ")"
		ClosureAbiFloat16:
			"blorp_box_float16(" + value_c + ")"
		ClosureAbiInt128:
			"blorp_box_int128(" + value_c + ")"
		ClosureAbiUInt128:
			"blorp_box_uint128(" + value_c + ")"
		ClosureAbiStruct(c_type):
			""


private pure func is_managed_pointer_capture_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if name == "String" and args.length() == 0:
				True
			else if name == "Bytes" and args.length() == 0:
				True
			else if name == "Fixed" and args.length() == 0:
				True
			else if name == "Closure" and args.length() == 0:
				True
			else if name == "List" and args.length() == 1:
				True
			else if name == "Dict" and args.length() == 2:
				True
			else if name == "Set" and args.length() == 1:
				True
			else if name == "Channel" and args.length() == 1:
				True
			else:
				False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			True
		HeapRecordType(name):
			True
		UnionType(name):
			True
		TupleType(items):
			False
		TensorType:
			True
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False


private pure func closure_simple_arg_binding(
	abi_value: ClosureAbiValue,
	arg_name: String,
	arg_c: String,
) -> ClosureArgBinding:
	{
		name = arg_name,
		statement = "; void* " + arg_name + " = " + closure_arg_value_expr(abi_value, arg_c),
		needs_release = closure_arg_needs_release(abi_value)
	}


private pure func closure_arg_binding(arg: CoreExpr, index: Int) -> Option[ClosureArgBinding]:
	abi_value ?= closure_abi_value_for_type(core_expr_type(arg))
	arg_c ?= emit_simple_expr(arg)
	arg_name: String = "__cl_arg_" + index.to_string()

	match abi_value:
		ClosureAbiStruct(c_type):
			value_name: String = "__cl_arg_value_" + index.to_string()
			Some({
				name = arg_name,
				statement = "; " + c_type + " " + value_name + " = " + arg_c + "; void* " + arg_name + " = blorp_box_struct(&" + value_name + ", sizeof(" + c_type + "))",
				needs_release = True,
			})
		ClosureAbiVoid:
			Some(closure_simple_arg_binding(abi_value, arg_name, arg_c))
		ClosureAbiPointer:
			Some(closure_simple_arg_binding(abi_value, arg_name, arg_c))
		ClosureAbiPrim:
			Some(closure_simple_arg_binding(abi_value, arg_name, arg_c))
		ClosureAbiFloat:
			Some(closure_simple_arg_binding(abi_value, arg_name, arg_c))
		ClosureAbiFloat32:
			Some(closure_simple_arg_binding(abi_value, arg_name, arg_c))
		ClosureAbiFloat16:
			Some(closure_simple_arg_binding(abi_value, arg_name, arg_c))
		ClosureAbiInt128:
			Some(closure_simple_arg_binding(abi_value, arg_name, arg_c))
		ClosureAbiUInt128:
			Some(closure_simple_arg_binding(abi_value, arg_name, arg_c))


private pure func closure_arg_bindings(args: List[CoreExpr]) -> Option[List[ClosureArgBinding]]:
	var result: List[ClosureArgBinding] = []
	var failed: Bool = False
	var index: Int = 0

	for arg in args:
		if not failed:
			match closure_arg_binding(arg, index):
				Some(binding):
					result = result.append(binding)
				None:
					failed = True

		index += 1

	if failed:
		None
	else:
		Some(result)


private pure func closure_arg_declarations(bindings: List[ClosureArgBinding]) -> String:
	var result: String = ""

	for binding in bindings:
		result += binding.statement

	result


private pure func closure_call_arg_list(bindings: List[ClosureArgBinding]) -> String:
	var args: List[String] = []

	for binding in bindings:
		args = args.append(binding.name)

	if args.length() == 0:
		""
	else:
		", " + args.join(", ")


private pure func closure_arg_release_statements(bindings: List[ClosureArgBinding]) -> String:
	var result: String = ""

	for binding in bindings:
		if binding.needs_release:
			result += "; blorp_release(" + binding.name + ")"

	result


private pure func closure_call_signature(arg_count: Int, return_c: String) -> String:
	var arg_types: List[String] = ["void*"]
	var index: Int = 0

	while index < arg_count:
		arg_types = arg_types.append("void*")
		index += 1

	return_c + " (*)(" + arg_types.join(", ") + ")"


private pure func closure_return_expr(result_name: String, return_type: CoreType) -> Option[String]:
	abi_value ?= closure_abi_value_for_type(return_type)

	match abi_value:
		ClosureAbiVoid:
			Some("(void)0")
		ClosureAbiPointer:
			Some("((" + c_type_name(return_type) + ")" + result_name + ")")
		ClosureAbiPrim:
			Some("((" + c_type_name(return_type) + ")(long)" + result_name + ")")
		ClosureAbiFloat:
			Some("blorp_unbox_float(" + result_name + ")")
		ClosureAbiFloat32:
			Some("blorp_unbox_float32(" + result_name + ")")
		ClosureAbiFloat16:
			Some("blorp_unbox_float16(" + result_name + ")")
		ClosureAbiInt128:
			Some("__cl_unboxed")
		ClosureAbiUInt128:
			Some("__cl_unboxed")
		ClosureAbiStruct(c_type):
			Some("__cl_unboxed")


private pure func closure_return_unbox_prelude(
	result_name: String,
	return_type: CoreType,
) -> Option[String]:
	abi_value ?= closure_abi_value_for_type(return_type)

	match abi_value:
		ClosureAbiVoid:
			Some("")
		ClosureAbiPointer:
			Some("")
		ClosureAbiPrim:
			Some("")
		ClosureAbiFloat:
			Some("")
		ClosureAbiFloat32:
			Some("")
		ClosureAbiFloat16:
			Some("")
		ClosureAbiInt128:
			Some(
				"; __int128 __cl_unboxed = blorp_unbox_int128(" + result_name + "); blorp_release(" + result_name + ")",
			)
		ClosureAbiUInt128:
			Some(
				"; unsigned __int128 __cl_unboxed = blorp_unbox_uint128(" + result_name + "); blorp_release(" + result_name + ")",
			)
		ClosureAbiStruct(c_type):
			Some(
				"; " + c_type + " __cl_unboxed = (*(" + c_type + "*)((char*)" + result_name + " + sizeof(blorp_Object))); blorp_release(" + result_name + ")",
			)


private pure func emit_closure_call(
	callee: CoreExpr,
	args: List[CoreExpr],
	return_type: CoreType,
) -> Option[String]:
	callee_c ?= emit_simple_expr(callee)
	bindings ?= closure_arg_bindings(args)
	arg_declarations: String = closure_arg_declarations(bindings)
	call_args: String = closure_call_arg_list(bindings)
	arg_releases: String = closure_arg_release_statements(bindings)

	if is_void_type(return_type):
		call_signature: String = closure_call_signature(args.length(), "void")
		Some(
			"({ blorp_Closure* __cl = (blorp_Closure*)" + callee_c + arg_declarations + "; ((" + call_signature + ")(__cl->func))(__cl->env" + call_args + ")" + arg_releases + "; (void)0; })",
		)
	else:
		return_expr ?= closure_return_expr("__cl_r", return_type)
		unbox_prelude ?= closure_return_unbox_prelude("__cl_r", return_type)
		call_signature: String = closure_call_signature(args.length(), "void*")
		Some(
			"({ blorp_Closure* __cl = (blorp_Closure*)" + callee_c + arg_declarations + "; void* __cl_r = ((" + call_signature + ")(__cl->func))(__cl->env" + call_args + ")" + arg_releases + unbox_prelude + "; " + return_expr + "; })",
		)


private pure func closure_capture_box_expr(capture: CoreClosureCapture) -> Option[String]:
	abi_value ?= closure_abi_value_for_type(capture.typ)
	capture_c: String = c_identifier(capture.name)

	match abi_value:
		ClosureAbiVoid:
			Some("(void*)0")
		ClosureAbiPointer:
			if is_managed_pointer_capture_type(capture.typ):
				Some("(void*)blorp_retain((blorp_Object*)" + capture_c + ")")
			else:
				None
		ClosureAbiPrim:
			Some("(void*)(long)(" + capture_c + ")")
		ClosureAbiFloat:
			None
		ClosureAbiFloat32:
			None
		ClosureAbiFloat16:
			None
		ClosureAbiInt128:
			None
		ClosureAbiUInt128:
			None
		ClosureAbiStruct(c_type):
			Some(
				"({ " + c_type + " __cl_capture = " + capture_c + "; blorp_box_struct(&__cl_capture, sizeof(" + c_type + ")); })",
			)


private pure func closure_capture_needs_release(capture: CoreClosureCapture) -> Option[Bool]:
	abi_value ?= closure_abi_value_for_type(capture.typ)

	match abi_value:
		ClosureAbiVoid:
			Some(False)
		ClosureAbiPointer:
			if is_managed_pointer_capture_type(capture.typ):
				Some(True)
			else:
				None
		ClosureAbiPrim:
			Some(False)
		ClosureAbiFloat:
			None
		ClosureAbiFloat32:
			None
		ClosureAbiFloat16:
			None
		ClosureAbiInt128:
			None
		ClosureAbiUInt128:
			None
		ClosureAbiStruct(c_type):
			Some(True)


private pure func closure_capture_assignments(captures: List[CoreClosureCapture]) -> Option[String]:
	var result: String = ""
	var failed: Bool = False
	var index: Int = 0

	for capture in captures:
		if not failed:
			match closure_capture_box_expr(capture):
				Some(boxed):
					result += " ((void**)__cl_new->env)[" + index.to_string() + "] = " + boxed + ";"
				None:
					failed = True

		index += 1

	if failed:
		None
	else:
		Some(result)


private pure func closure_capture_release_mask(captures: List[CoreClosureCapture]) -> Option[Int]:
	var mask: Int = 0
	var failed: Bool = False
	var index: Int = 0

	for capture in captures:
		if not failed:
			match closure_capture_needs_release(capture):
				Some(needs_release):
					if needs_release:
						mask += int_power_of_two(index)
				None:
					failed = True

		index += 1

	if failed:
		None
	else:
		Some(mask)


private pure func emit_closure_create(closure: CoreClosureCreate) -> Option[String]:
	if closure.captures.length() == 0:
		Some("((void*)&" + c_identifier(closure.static_name) + ")")
	else:
		assignments ?= closure_capture_assignments(closure.captures)
		release_mask ?= closure_capture_release_mask(closure.captures)

		Some(
			"({ blorp_Closure* __cl_new = blorp_closure_new_inline((void*)" + c_identifier(
				closure.c_name,
			) + ", " + closure.captures
				.length()
				.to_string() + ");" + assignments + " __cl_new->env_release_mask = " + release_mask.to_string() + "UL; (void*)__cl_new; })",
		)


private pure func closure_slot_decl(typ: CoreType, name: String, source: String) -> Option[String]:
	abi_value ?= closure_abi_value_for_type(typ)
	param_type: String = c_type_name(typ)
	param_name: String = c_identifier(name)

	match abi_value:
		ClosureAbiVoid:
			None
		ClosureAbiPointer:
			Some("  " + param_type + " " + param_name + " = (" + param_type + ")" + source + ";\n")
		ClosureAbiPrim:
			Some(
				"  " + param_type + " " + param_name + " = (" + param_type + ")(long)" + source + ";\n",
			)
		ClosureAbiFloat:
			Some("  double " + param_name + " = blorp_unbox_float(" + source + ");\n")
		ClosureAbiFloat32:
			Some("  float " + param_name + " = blorp_unbox_float32(" + source + ");\n")
		ClosureAbiFloat16:
			Some("  _Float16 " + param_name + " = blorp_unbox_float16(" + source + ");\n")
		ClosureAbiInt128:
			Some("  __int128 " + param_name + " = blorp_unbox_int128(" + source + ");\n")
		ClosureAbiUInt128:
			Some("  unsigned __int128 " + param_name + " = blorp_unbox_uint128(" + source + ");\n")
		ClosureAbiStruct(c_type):
			Some(
				"  " + c_type + " " + param_name + " = *(" + c_type + "*)((char*)" + source + " + sizeof(blorp_Object));\n",
			)


private pure func closure_param_decl(param: CoreParam, index: Int) -> Option[String]:
	closure_slot_decl(param.typ, param.name.name, "__arg" + index.to_string())


private pure func closure_param_decls(params: List[CoreParam]) -> Option[String]:
	var result: String = ""
	var failed: Bool = False
	var index: Int = 0

	for param in params:
		if not failed:
			match closure_param_decl(param, index):
				Some(decl):
					result += decl
				None:
					failed = True

		index += 1

	if failed:
		None
	else:
		Some(result)


private pure func closure_capture_decl(capture: CoreClosureCapture, index: Int) -> Option[String]:
	closure_slot_decl(capture.typ, capture.name, "__e[" + index.to_string() + "]")


private pure func closure_capture_decls(captures: List[CoreClosureCapture]) -> Option[String]:
	var result: String = ""
	var failed: Bool = False
	var index: Int = 0

	for capture in captures:
		if not failed:
			match closure_capture_decl(capture, index):
				Some(decl):
					result += decl
				None:
					failed = True

		index += 1

	if failed:
		None
	else:
		Some(result)


private pure func closure_env_prelude(abi: CoreClosureAbi) -> Option[String]:
	if abi.captures.length() == 0:
		Some("  (void)__env;\n")
	else:
		capture_decls ?= closure_capture_decls(abi.captures)
		Some("  void** __e = (void**)__env;\n" + capture_decls)


private pure func closure_body_suffix(abi: CoreClosureAbi) -> String:
	if abi.captures.length() == 0:
		emit_static_closure_definition(abi)
	else:
		""


private pure func closure_return_value(return_type: CoreType, value_c: String) -> Option[String]:
	abi_value ?= closure_abi_value_for_type(return_type)

	match abi_value:
		ClosureAbiVoid:
			Some("(void*)0")
		ClosureAbiPointer:
			Some("(void*)" + value_c)
		ClosureAbiPrim:
			Some("(void*)(long)(" + value_c + ")")
		ClosureAbiFloat:
			Some("blorp_box_float(" + value_c + ")")
		ClosureAbiFloat32:
			Some("blorp_box_float32(" + value_c + ")")
		ClosureAbiFloat16:
			Some("blorp_box_float16(" + value_c + ")")
		ClosureAbiInt128:
			Some("blorp_box_int128(" + value_c + ")")
		ClosureAbiUInt128:
			Some("blorp_box_uint128(" + value_c + ")")
		ClosureAbiStruct(c_type):
			Some(
				"({ " + c_type + " __cl_ret = " + value_c + "; blorp_box_struct(&__cl_ret, sizeof(" + c_type + ")); })",
			)


private pure func closure_body_return_type(abi: CoreClosureAbi, return_type: CoreType) -> String:
	if is_void_type(return_type) and not abi.task_abi:
		"void"
	else:
		"void*"


private pure func closure_body_signature(func_info: CoreFunction, abi: CoreClosureAbi) -> String:
	var params: String = "void* __env"
	var index: Int = 0

	for param in abi.params:
		params += ", void* __arg" + index.to_string()
		index += 1

	closure_body_return_type(
		abi,
		func_info.return_type,
	) + " " + c_identifier(abi.c_name) + "(" + params + ")"


private pure func static_closure_name(c_name: String) -> String:
	"__sc_" + c_identifier(c_name)


private pure func emit_static_closure_definition(abi: CoreClosureAbi) -> String:
	static_name: String = static_closure_name(abi.c_name)
	function_name: String = c_identifier(abi.c_name)

	"static blorp_Closure " + static_name + " = { { BLORP_IMMORTAL_REFCOUNT, BLORP_ALLOC_CLASS_DIRECT, 0 }, (void*)" + function_name + ", NULL, 0, 0 };\n"


private pure func emit_closure_body_function(
	func_info: CoreFunction,
	abi: CoreClosureAbi,
) -> Option[String]:
	if abi.moved_captures.length() != 0 or abi.task_abi:
		None
	else:
		match func_info.body:
			Some(body):
				param_decls ?= closure_param_decls(abi.params)
				env_prelude ?= closure_env_prelude(abi)
				body_c ?= emit_function_body(body, 0)
				prefix: String = closure_body_signature(
					func_info,
					abi,
				) + " {\n" + env_prelude + param_decls
				suffix: String = closure_body_suffix(abi)

				if is_void_type(func_info.return_type):
					Some(prefix + discard_body(body_c) + "}\n" + suffix)
				else if body_c.returns:
					None
				else:
					return_value ?= required_body_value(body_c)
					boxed_return ?= closure_return_value(func_info.return_type, return_value)
					Some(
						prefix + body_c.statements + "  return " + boxed_return + ";\n}\n" + suffix,
					)
			None:
				None


private pure func emit_drop_statement(
	variable: CoreVar,
	release_policy: CoreReleasePolicy,
) -> String:
	emit_release_statement(c_var_name(variable), release_policy)


private pure func emit_release_statement(
	value: String,
	release_policy: CoreReleasePolicy,
) -> String:
	match release_policy:
		NoReleasePolicy:
			""
		ArcReleasePolicy:
			"  blorp_release(" + value + ");\n"
		ArcReleaseOnlyPolicy:
			"  blorp_release_arc_only(" + value + ");\n"
		StackResultReleasePolicy:
			"  blorp_stack_result_release(" + value + ");\n"


private pure func owned_temp_cleanup_frame_name(slot: String) -> String:
	"__blorp_owned_cleanup_" + slot


private pure func owned_temp_cleanup_release_fn(policy: CoreReleasePolicy) -> Option[String]:
	match policy:
		NoReleasePolicy:
			None
		ArcReleasePolicy:
			Some("blorp_cleanup_release_arc_value")
		ArcReleaseOnlyPolicy:
			Some("blorp_cleanup_release_arc_only_value")
		StackResultReleasePolicy:
			Some("blorp_cleanup_stack_result_value")


private pure func owned_temp_cleanup_value_arg(slot: String, policy: CoreReleasePolicy) -> String:
	match policy:
		NoReleasePolicy:
			"(void*)0"
		ArcReleasePolicy:
			"(void*)" + slot
		ArcReleaseOnlyPolicy:
			"(void*)" + slot
		StackResultReleasePolicy:
			"(void*)&" + slot


private pure func owned_temp_cleanup_push_statement(
	slot: String,
	policy: CoreReleasePolicy,
) -> String:
	match owned_temp_cleanup_release_fn(policy):
		Some(release_fn):
			frame_name: String = owned_temp_cleanup_frame_name(slot)
			value_arg: String = owned_temp_cleanup_value_arg(slot, policy)
			"  blorp_CancelCleanupFrame " + frame_name + ";\n  blorp_task_cleanup_push(&" + frame_name + ", &" + slot + ", " + value_arg + ", " + release_fn + ");\n"
		None:
			""


private pure func owned_temp_cleanup_pop_statement(
	slot: String,
	policy: CoreReleasePolicy,
) -> String:
	match owned_temp_cleanup_release_fn(policy):
		Some(release_fn):
			"  blorp_task_cleanup_pop_slot(&" + slot + ");\n"
		None:
			""


private pure func emit_dup_statement(variable: CoreVar, retain_policy: CoreRetainPolicy) -> String:
	match retain_policy:
		NoRetainPolicy:
			""
		ArcRetainPolicy:
			"  blorp_retain(" + c_var_name(variable) + ");\n"
		StackResultRetainPolicy:
			"  blorp_stack_result_retain(" + c_var_name(variable) + ");\n"


private pure func statement_expr(statement: String, value: String) -> String:
	if statement.length() == 0:
		value
	else:
		"({ " + statement + " " + value + "; })"


private pure func emit_simple_expr(expr: CoreExpr) -> Option[String]:
	match expr:
		LiteralExpr(literal, typ, loc):
			emit_literal_expr(literal)
		VarExpr(variable, typ, loc):
			if variable.name == "None":
				None
			else:
				Some(c_var_name(variable))
		VoidExpr(typ, loc):
			Some("(void)0")
		CooperativeCheckpointExpr(typ, loc):
			None
		CallExpr(kind, callee, args, typ, loc):
			match kind:
				IntrinsicCall(name):
					match emit_raw_scalar_tensor_get_unchecked(name, args, typ):
						Some(rendered):
							Some(rendered)
						None:
							match emit_value_record_tensor_get_unchecked(name, args, typ):
								Some(rendered):
									Some(rendered)
								None:
									emit_intrinsic_call(name, args)
				UserCall(name, def_id):
					if name == "Some" or name == "None":
						None
					else:
						args_c ?= emit_simple_expr_args(args)
						Some(name + "(" + args_c + ")")
				ForeignCall(name):
					args_c ?= emit_simple_expr_args(args)
					Some(adapt_direct_call_result(name + "(" + args_c + ")", typ))
				ListToStringCall(callback_name):
					arg_values ?= emit_simple_expr_arg_values(args)
					emit_call_value_from_args(kind, arg_values, typ)
				BuiltinCall(name):
					match emit_tensor_fill_packed_call(name, args):
						Some(rendered):
							Some(rendered)
						None:
							match emit_tensor_fill_inline_struct_call(name, args):
								Some(rendered):
									Some(rendered)
								None:
									match emit_boxed_tensor_fill_call(name, args):
										Some(rendered):
											Some(rendered)
										None:
											match emit_boxed_tensor_set_call(name, args, typ):
												Some(rendered):
													Some(rendered)
												None:
													if (
														name == "blorp_vector_new_fill"
														or name == "blorp_matrix_new_fill"
														or name == "blorp_vector_new_fill_packed"
														or name == "blorp_matrix_new_fill_packed"
														or name == "blorp_matrix_checked_set"
													):
														None
													else:
														arg_values ?= emit_simple_expr_arg_values(args)
														emit_call_value_from_args(kind, arg_values, typ)
				OperationResultCall(bridge):
					None
				ListToStringCall(callback_name):
					arg_values ?= emit_simple_expr_arg_values(args)
					emit_call_value_from_args(kind, arg_values, typ)
				ClosureCall:
					emit_closure_call(callee, args, typ)
		BinaryExpr(op, left, right, typ, loc):
			left_c ?= emit_simple_expr(left)
			right_c ?= emit_simple_expr(right)
			c_binary_expr(op, left, right, left_c, right_c)
		UnaryExpr(op, expr_value, typ, loc):
			expr_c ?= emit_simple_expr(expr_value)
			Some("(" + c_unary_operator(op) + expr_c + ")")
		LogicalExpr(op, left, right, typ, loc):
			left_c ?= emit_simple_expr(left)
			right_c ?= emit_simple_expr(right)
			Some("(" + left_c + " " + c_logical_operator(op) + " " + right_c + ")")
		AssignExpr(variable, rhs, typ, loc):
			None
		CastExpr(expr_value, typ, loc):
			expr_c ?= emit_simple_expr(expr_value)
			Some("((" + c_type_name(typ) + ")" + expr_c + ")")
		BoxExpr(box, typ, loc):
			emit_box_expr(box)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			emit_unbox_expr(unbox_kind, expr_value, typ)
		FieldExpr(expr_value, field_name, typ, loc):
			emit_field_access(expr_value, field_name)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			emit_tuple_field_access(expr_value, field_index, typ)
		TupleExpr(items, typ, loc):
			None
		TupleConstructExpr(tuple_construct, typ, loc):
			emit_tuple_construct(tuple_construct)
		ClosureCreateExpr(closure, typ, loc):
			emit_closure_create(closure)
		ListConstructExpr(construct, typ, loc):
			emit_list_construct(construct)
		ListAllocExpr(alloc, typ, loc):
			emit_list_alloc(alloc)
		ListGetExpr(get, typ, loc):
			emit_list_get(get)
		ListHandoffExpr(handoff, typ, loc):
			emit_list_handoff(handoff)
		ListHandoffSetOwnedExpr(set, typ, loc):
			emit_list_handoff_set_owned(set)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			emit_list_handoff_set_source_slot(slot)
		StringByteReadExpr(read, typ, loc):
			emit_string_byte_read(read)
		StringByteWriteExpr(write, typ, loc):
			emit_string_byte_write(write)
		StringByteCopyExpr(copy, typ, loc):
			emit_string_byte_copy(copy)
		StringSetLenExpr(set_len, typ, loc):
			emit_string_set_len(set_len)
		TensorLiteralExpr(literal, typ, loc):
			None
		TensorBoxedLiteralExpr(literal, typ, loc):
			None
		TensorPackedLiteralExpr(literal, typ, loc):
			None
		TensorRawFillExpr(fill, typ, loc):
			None
		TensorRawReadExpr(read, typ, loc):
			emit_tensor_raw_read(read)
		TensorRawWriteExpr(write, typ, loc):
			emit_tensor_raw_write(write)
		TensorRawViewLetExpr(binding, body, typ, loc):
			None
		DictConstructExpr(construct, typ, loc):
			emit_dict_construct(construct)
		SetAllocExpr(alloc, typ, loc):
			emit_set_alloc(alloc)
		ListRetainExpr(retain, typ, loc):
			emit_list_retain(retain)
		ListSetExpr(set, typ, loc):
			emit_list_set(set)
		RecordExpr(fields, typ, loc):
			None
		RecordConstructExpr(type_name, fields, typ, loc):
			emit_record_construct(type_name, fields)
		UnionConstructExpr(construct, typ, loc):
			emit_union_construct(construct)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			body_c ?= emit_simple_expr(body)
			Some(statement_expr(emit_dup_statement(variable, retain_policy), body_c))
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			body_c ?= emit_simple_expr(body)
			Some(statement_expr(emit_drop_statement(variable, release_policy), body_c))
		LetExpr(name, is_mutable, typ, rhs, body):
			None
		SeqExpr(first, second):
			None
		WhileExpr(cond, body, typ, loc):
			None
		BreakExpr(typ, loc):
			None
		ContinueExpr(typ, loc):
			None
		ResourceScopeExpr(scope, typ, loc):
			None
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			None
		TailrecLoopExpr(params, return_type, body, loc):
			None
		TailrecRecurExpr(args, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			None
		ForListExpr(for_list, typ, loc):
			None
		ForTensorExpr(for_tensor, typ, loc):
			None
		RangeExpr(start, end_value, typ, loc):
			start_c ?= emit_simple_expr(start)
			end_c ?= emit_simple_expr(end_value)
			Some("({ Range __range_value = { " + start_c + ", " + end_c + " }; __range_value; })")
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			None
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			None
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			None
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, default_body, typ, loc):
			None
		IfExpr(cond, then_expr, else_expr, typ, loc):
			cond_c ?= emit_simple_expr(cond)
			then_c ?= emit_simple_expr(then_expr)
			else_c ?= emit_simple_expr(else_expr)
			Some("(" + cond_c + " ? " + then_c + " : " + else_c + ")")


private pure func terminal_body(statements: String, next_temp: Int) -> FunctionBodyC:
	{
		statements = statements,
		value = "",
		next_temp = next_temp,
		returns = True
	}


private pure func emit_tailrec_recur(
	params: List[CoreParam],
	args: List[CoreExpr],
	next_temp: Int,
) -> Option[FunctionBodyC]:
	if params.length() != args.length():
		None
	else:
		var declarations: String = ""
		var assignments: String = ""
		var index: Int = 0
		var temp_index: Int = next_temp
		var failed: Bool = False

		for arg in args:
			if not failed:
				match params.get(index):
					Some(param):
						match emit_simple_expr(arg):
							Some(arg_c):
								temp: String = temp_name(
									"tailrec_arg_" + index.to_string(),
									temp_index,
								)

								declarations += "  " + c_type_name(
									param.typ,
								) + " " + temp + " = " + arg_c + ";\n"
								assignments += "  " + c_var_name(param.name) + " = " + temp + ";\n"
								index += 1
								temp_index += 1
							None:
								failed = True
					None:
						failed = True

		if failed:
			None
		else:
			Some(terminal_body(declarations + assignments + "  continue;\n", temp_index))


private pure func emit_tailrec_tail(
	params: List[CoreParam],
	return_type: CoreType,
	expr: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match expr:
		TailrecRecurExpr(args, typ, loc):
			emit_tailrec_recur(params, args, next_temp)
		LetExpr(name, is_mutable, typ, rhs, body):
			if is_void_type(typ):
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_tailrec_tail(params, return_type, body, rhs_c.next_temp)
				Some(
					terminal_body(
						discard_expr_body(rhs, rhs_c) + body_c.statements,
						body_c.next_temp,
					),
				)
			else if name.name == "_":
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_tailrec_tail(params, return_type, body, rhs_c.next_temp)
				Some(
					terminal_body(
						discard_expr_body(rhs, rhs_c) + body_c.statements,
						body_c.next_temp,
					),
				)
			else:
				rhs_c ?= emit_simple_expr(rhs)
				body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
				Some(
					terminal_body(
						"  " + c_type_name(
							typ,
						) + " " + c_var_name(name) + " = " + rhs_c + ";\n" + body_c.statements,
						body_c.next_temp,
					),
				)
		SeqExpr(first, second):
			first_c ?= emit_function_body(first, next_temp)
			second_c ?= emit_tailrec_tail(params, return_type, second, first_c.next_temp)
			Some(
				terminal_body(
					discard_expr_body(first, first_c) + second_c.statements,
					second_c.next_temp,
				),
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			cond_c ?= emit_simple_expr(cond)
			then_c ?= emit_tailrec_tail(params, return_type, then_expr, next_temp)
			else_c ?= emit_tailrec_tail(params, return_type, else_expr, then_c.next_temp)
			Some(
				terminal_body(
					"  if (" + cond_c + ") {\n" + indent_statements(
						then_c.statements,
					) + "  } else {\n" + indent_statements(else_c.statements) + "  }\n",
					else_c.next_temp,
				),
			)
		LiteralExpr(literal, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		VarExpr(variable, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		VoidExpr(typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		CooperativeCheckpointExpr(typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		CallExpr(kind, callee, args, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		BinaryExpr(op, left, right, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		UnaryExpr(op, expr_value, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		LogicalExpr(op, left, right, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		AssignExpr(variable, rhs, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		CastExpr(expr_value, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		BoxExpr(box, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		FieldExpr(expr_value, field_name, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TupleExpr(items, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TupleConstructExpr(tuple_construct, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ClosureCreateExpr(closure, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListConstructExpr(construct, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListAllocExpr(alloc, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListGetExpr(get, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListHandoffExpr(handoff, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListHandoffSetOwnedExpr(set, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		StringByteReadExpr(read, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		StringByteWriteExpr(write, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		StringByteCopyExpr(copy, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		StringSetLenExpr(set_len, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TensorLiteralExpr(literal, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TensorBoxedLiteralExpr(literal, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TensorPackedLiteralExpr(literal, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TensorRawFillExpr(fill, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TensorRawReadExpr(read, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TensorRawWriteExpr(write, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TensorRawViewLetExpr(binding, body, typ, loc):
			decl ?= tensor_raw_view_decl(binding)
			body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
			Some(terminal_body("  " + decl + ";\n" + body_c.statements, body_c.next_temp))
		DictConstructExpr(construct, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		SetAllocExpr(alloc, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListRetainExpr(retain, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListSetExpr(set, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		RecordExpr(fields, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		RecordConstructExpr(type_name, fields, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		UnionConstructExpr(construct, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			retain_statement: String = emit_dup_statement(variable, retain_policy)
			body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
			Some(terminal_body(retain_statement + body_c.statements, body_c.next_temp))
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			drop_statement: String = emit_drop_statement(variable, release_policy)
			body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
			Some(terminal_body(drop_statement + body_c.statements, body_c.next_temp))
		WhileExpr(cond, body, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		BreakExpr(typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ContinueExpr(typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ResourceScopeExpr(scope, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TailrecLoopExpr(loop_params, loop_return_type, body, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ForListExpr(for_list, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ForTensorExpr(for_tensor, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		RangeExpr(start, end_value, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, default_body, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)


private pure func emit_tailrec_return(
	return_type: CoreType,
	expr: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_function_body(expr, next_temp)

	if is_void_type(return_type):
		Some(terminal_body(discard_expr_body(expr, body_c) + "  return;\n", body_c.next_temp))
	else:
		return_value ?= required_body_value(body_c)
		Some(
			terminal_body(
				body_c.statements + "  return " + return_value + ";\n",
				body_c.next_temp,
			),
		)


private pure func emit_tailrec_loop(
	params: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
	Some(
		terminal_body(
			"  while (1) {\n" + indent_statements(body_c.statements) + "  }\n",
			body_c.next_temp,
		),
	)


private pure func static_int_literal(expr: CoreExpr) -> Option[Int]:
	match expr:
		LiteralExpr(literal, typ, loc):
			match literal:
				IntLiteral(value):
					Some(value)
				WideIntLiteral(value):
					None
				FloatLiteral(value):
					None
				FloatTextLiteral(value):
					None
				FloatInfinityLiteral:
					None
				FloatNegInfinityLiteral:
					None
				FloatNanLiteral:
					None
				BoolLiteral(value):
					None
				CharLiteral(value):
					None
				StringLiteral(value):
					None
		VarExpr(variable, typ, loc):
			None
		VoidExpr(typ, loc):
			None
		CooperativeCheckpointExpr(typ, loc):
			None
		CallExpr(kind, callee, args, typ, loc):
			None
		BinaryExpr(op, left, right, typ, loc):
			None
		UnaryExpr(op, expr_value, typ, loc):
			None
		LogicalExpr(op, left, right, typ, loc):
			None
		AssignExpr(variable, rhs, typ, loc):
			None
		CastExpr(expr_value, typ, loc):
			None
		BoxExpr(box, typ, loc):
			None
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			None
		FieldExpr(expr_value, field_name, typ, loc):
			None
		TupleFieldExpr(expr_value, field_index, typ, loc):
			None
		TupleExpr(items, typ, loc):
			None
		TupleConstructExpr(tuple_construct, typ, loc):
			None
		ClosureCreateExpr(closure, typ, loc):
			None
		ListConstructExpr(construct, typ, loc):
			None
		ListAllocExpr(alloc, typ, loc):
			None
		ListGetExpr(get, typ, loc):
			None
		ListHandoffExpr(handoff, typ, loc):
			None
		ListHandoffSetOwnedExpr(set, typ, loc):
			None
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			None
		StringByteReadExpr(read, typ, loc):
			None
		StringByteWriteExpr(write, typ, loc):
			None
		StringByteCopyExpr(copy, typ, loc):
			None
		StringSetLenExpr(set_len, typ, loc):
			None
		TensorLiteralExpr(literal, typ, loc):
			None
		TensorBoxedLiteralExpr(literal, typ, loc):
			None
		TensorPackedLiteralExpr(literal, typ, loc):
			None
		TensorRawFillExpr(fill, typ, loc):
			None
		TensorRawReadExpr(read, typ, loc):
			None
		TensorRawWriteExpr(write, typ, loc):
			None
		TensorRawViewLetExpr(binding, body, typ, loc):
			None
		DictConstructExpr(construct, typ, loc):
			None
		SetAllocExpr(alloc, typ, loc):
			None
		ListRetainExpr(retain, typ, loc):
			None
		ListSetExpr(set, typ, loc):
			None
		RecordExpr(fields, typ, loc):
			None
		RecordConstructExpr(type_name, fields, typ, loc):
			None
		UnionConstructExpr(construct, typ, loc):
			None
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			None
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			None
		LetExpr(name, is_mutable, typ, rhs, body):
			None
		SeqExpr(first, second):
			None
		WhileExpr(cond, body, typ, loc):
			None
		BreakExpr(typ, loc):
			None
		ContinueExpr(typ, loc):
			None
		ResourceScopeExpr(scope, typ, loc):
			None
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			None
		TailrecLoopExpr(params, return_type, body, loc):
			None
		TailrecRecurExpr(args, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			None
		ForListExpr(for_list, typ, loc):
			None
		ForTensorExpr(for_tensor, typ, loc):
			None
		RangeExpr(start, end_value, typ, loc):
			None
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			None
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			None
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			None
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, default_body, typ, loc):
			None
		IfExpr(cond, then_expr, else_expr, typ, loc):
			None


private pure func range_is_forward_proven(
	direction: CoreLoopRangeDirection,
	start: CoreExpr,
	end_value: CoreExpr,
) -> Bool:
	match direction:
		RangeMayRunBackward:
			match static_int_literal(start):
				Some(start_value):
					match static_int_literal(end_value):
						Some(end_int):
							start_value <= end_int
						None:
							False
				None:
					False
		RangeForwardOnly:
			True


private pure func emit_for_range(
	binder: CoreLoopBinder,
	start: CoreExpr,
	end_value: CoreExpr,
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	start_c ?= emit_simple_expr(start)
	end_c ?= emit_simple_expr(end_value)
	body_c ?= emit_function_body(body, next_temp + 1)
	start_tmp: String = temp_name("range_start", next_temp)
	end_tmp: String = temp_name("range_end", next_temp)
	step_tmp: String = temp_name("range_step", next_temp)
	loop_type: String = c_type_name(binder.typ)
	prefix: String = "  " + loop_type + " " + start_tmp + " = " + start_c + ";\n  " + loop_type + " " + end_tmp + " = " + end_c + ";\n"

	if range_is_forward_proven(binder.range_direction, start, end_value):
		Some({
			statements = prefix + "  for (" + loop_type + " " + c_var_name(
				binder.variable,
			) + " = " + start_tmp + "; " + c_var_name(
				binder.variable,
			) + " < " + end_tmp + "; " + c_var_name(
				binder.variable,
			) + "++) {\n" + indent_statements(statement_body(body, body_c)) + "  }\n",
			value = "",
			next_temp = body_c.next_temp,
			returns = False,
		})
	else:
		Some({
			statements = prefix + "  " + loop_type + " " + step_tmp + " = (" + start_tmp + " <= " + end_tmp + ") ? 1 : -1;\n  for (" + loop_type + " " + c_var_name(
				binder.variable,
			) + " = " + start_tmp + "; " + c_var_name(
				binder.variable,
			) + " != " + end_tmp + "; " + c_var_name(
				binder.variable,
			) + " += " + step_tmp + ") {\n" + indent_statements(
				statement_body(
					body,
					body_c,
				),
			) + "  }\n",
			value = "",
			next_temp = body_c.next_temp,
			returns = False,
		})


private pure func is_scalar_boxed_value_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			(
				name == "Int"
				or name == "Int8"
				or name == "Int16"
				or name == "Int32"
				or name == "Int64"
				or name == "UInt8"
				or name == "UInt16"
				or name == "UInt32"
				or name == "UInt64"
				or name == "Bool"
				or name == "Char"
			)
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		EnumType(name):
			True
		VoidType:
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			True
		TensorType:
			False
		TupleType(items):
			False


private pure func pointer_list_loop_binding(
	binder: CoreLoopBinder,
	iter_tmp: String,
	index_tmp: String,
) -> String:
	value_c: String = "blorp_list_get(" + iter_tmp + ", " + index_tmp + ")"
	binding_type: String = c_type_name(binder.typ)

	if is_scalar_boxed_value_type(binder.typ):
		binding_type + " " + c_var_name(
			binder.variable,
		) + " = (" + binding_type + ")(long)" + value_c + ";\n"
	else:
		binding_type + " " + c_var_name(
			binder.variable,
		) + " = (" + binding_type + ")" + value_c + ";\n"


private pure func inline_struct_list_loop_binding(
	binder: CoreLoopBinder,
	iter_tmp: String,
	index_tmp: String,
	temp_seed: String,
	c_type: String,
) -> String:
	binding_name: String = c_var_name(binder.variable)
	load_args: InlineStructLoadArgs = {
		list_tmp = iter_tmp,
		index_tmp = index_tmp,
		out_tmp = binding_name,
		temp_seed = temp_seed,
		struct_ty = c_type
	}

	c_type + " " + binding_name + ";\n" + render_prepared_list_op(
		InlineStructLoadProven(load_args),
	) + "\n"


private pure func inline_scalar_list_loop_binding(
	binder: CoreLoopBinder,
	iter_tmp: String,
	index_tmp: String,
	width_bytes: Int,
	next_temp: Int,
) -> Option[String]:
	binding_name: String = c_var_name(binder.variable)
	bits_tmp: String = temp_name("iter_bits", next_temp)
	load_args: InlineBitsLoadArgs = {
		list_tmp = iter_tmp,
		index_tmp = index_tmp,
		bits_tmp = bits_tmp,
		width_bytes = width_bytes.to_string()
	}
	value ?= boxed_storage_value_source("(void*)" + bits_tmp, binder.typ)

	Some(
		render_prepared_list_op(InlineBitsLoad(load_args)) + "\n" + c_type_name(
			binder.typ,
		) + " " + binding_name + " = " + value + ";\n",
	)


private pure func emit_for_list(for_list: CoreForList, next_temp: Int) -> Option[FunctionBodyC]:
	match for_list.layout:
		PointerListStorage:
			iterable_body ?= emit_scoped_expr_value("iterable", for_list.iterable, next_temp)
			iterable_c ?= required_body_value(iterable_body)
			temp_index: Int = iterable_body.next_temp
			iter_tmp: String = temp_name("iter", temp_index)
			len_tmp: String = temp_name("len", temp_index)
			index_tmp: String = temp_name("i", temp_index)
			body_c ?= emit_function_body(for_list.body, temp_index + 1)
			source_binding: String = render_prepared_backend_op(BackendFlatIterSourceBinding({
				iter_c_type = "blorp_List*",
				iter = iter_tmp,
				source = iterable_c,
			}))
			loop_header: String = render_prepared_backend_op(BackendFlatIterLoopHeader({
				length = len_tmp,
				iter = iter_tmp,
				index = index_tmp,
			}))
			loop_body: String = pointer_list_loop_binding(
				for_list.binder,
				iter_tmp,
				index_tmp,
			) + statement_body(for_list.body, body_c)
			cleanup_push: String = owned_temp_cleanup_push_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)
			cleanup_pop: String = owned_temp_cleanup_pop_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)
			iterable_release: String = emit_release_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)

			Some({
				statements = iterable_body.statements + indent_statements(
					source_binding + "\n" + cleanup_push + loop_header,
				) + indent_statements(loop_body) + "  }\n" + cleanup_pop + iterable_release,
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		InlineListStorage(width_bytes):
			iterable_body ?= emit_scoped_expr_value("iterable", for_list.iterable, next_temp)
			iterable_c ?= required_body_value(iterable_body)
			temp_index: Int = iterable_body.next_temp
			iter_tmp: String = temp_name("iter", temp_index)
			len_tmp: String = temp_name("len", temp_index)
			index_tmp: String = temp_name("i", temp_index)
			body_c ?= emit_function_body(for_list.body, temp_index + 1)
			source_binding: String = render_prepared_backend_op(BackendFlatIterSourceBinding({
				iter_c_type = "blorp_List*",
				iter = iter_tmp,
				source = iterable_c,
			}))
			loop_header: String = render_prepared_backend_op(BackendFlatIterLoopHeader({
				length = len_tmp,
				iter = iter_tmp,
				index = index_tmp,
			}))
			loop_binding ?= inline_scalar_list_loop_binding(
				for_list.binder,
				iter_tmp,
				index_tmp,
				width_bytes,
				temp_index,
			)
			loop_body: String = loop_binding + statement_body(for_list.body, body_c)
			cleanup_push: String = owned_temp_cleanup_push_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)
			cleanup_pop: String = owned_temp_cleanup_pop_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)
			iterable_release: String = emit_release_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)

			Some({
				statements = iterable_body.statements + indent_statements(
					source_binding + "\n" + cleanup_push + loop_header,
				) + indent_statements(loop_body) + "  }\n" + cleanup_pop + iterable_release,
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		InlineStructListStorage(c_type):
			iterable_body ?= emit_scoped_expr_value("iterable", for_list.iterable, next_temp)
			iterable_c ?= required_body_value(iterable_body)
			temp_index: Int = iterable_body.next_temp
			iter_tmp: String = temp_name("iter", temp_index)
			len_tmp: String = temp_name("len", temp_index)
			index_tmp: String = temp_name("i", temp_index)
			body_c ?= emit_function_body(for_list.body, temp_index + 1)
			source_binding: String = render_prepared_backend_op(BackendFlatIterSourceBinding({
				iter_c_type = "blorp_List*",
				iter = iter_tmp,
				source = iterable_c,
			}))
			loop_header: String = render_prepared_backend_op(BackendFlatIterLoopHeader({
				length = len_tmp,
				iter = iter_tmp,
				index = index_tmp,
			}))
			loop_body: String = inline_struct_list_loop_binding(
				for_list.binder,
				iter_tmp,
				index_tmp,
				temp_index.to_string(),
				c_type,
			) + statement_body(for_list.body, body_c)
			cleanup_push: String = owned_temp_cleanup_push_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)
			cleanup_pop: String = owned_temp_cleanup_pop_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)
			iterable_release: String = emit_release_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)

			Some({
				statements = iterable_body.statements + indent_statements(
					source_binding + "\n" + cleanup_push + loop_header,
				) + indent_statements(loop_body) + "  }\n" + cleanup_pop + iterable_release,
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})


private pure func emit_for_tensor(
	for_tensor: CoreForTensor,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	iterable_c ?= emit_simple_expr(for_tensor.iterable)
	iter_tmp: String = temp_name("iter", next_temp)
	len_tmp: String = temp_name("len", next_temp)
	index_tmp: String = temp_name("i", next_temp)
	body_c ?= emit_function_body(for_tensor.body, next_temp + 1)
	source_binding: String = render_prepared_backend_op(BackendFlatIterSourceBinding({
		iter_c_type = "blorp_Vector*",
		iter = iter_tmp,
		source = iterable_c,
	}))
	loop_header: String = render_prepared_backend_op(BackendFlatIterLoopHeader({
		length = len_tmp,
		iter = iter_tmp,
		index = index_tmp,
	}))
	cleanup_push: String = owned_temp_cleanup_push_statement(
		iter_tmp,
		for_tensor.iterable_release_policy,
	)
	cleanup_pop: String = owned_temp_cleanup_pop_statement(
		iter_tmp,
		for_tensor.iterable_release_policy,
	)
	iterable_release: String = emit_release_statement(iter_tmp, for_tensor.iterable_release_policy)

	match for_tensor.element_storage:
		TensorForInlineStructElement(c_type):
			element_decl: String = render_prepared_tensor_op(InlineStructElementDecl({
				binding = c_var_name(for_tensor.binder.variable),
				tensor = iter_tmp,
				index = index_tmp,
				temp_seed = next_temp.to_string(),
				struct_ty = c_type,
			}))
			loop_body: String = element_decl + "\n" + statement_body(for_tensor.body, body_c)

			Some({
				statements = indent_statements(
					source_binding + "\n" + cleanup_push + loop_header,
				) + indent_statements(loop_body) + "  }\n" + cleanup_pop + iterable_release,
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		TensorForRuntimeReadElement(runtime_read):
			element_decl: String = runtime_read.value_c_type + " " + c_var_name(
				for_tensor.binder.variable,
			) + " = (" + runtime_read.value_c_type + ")" + tensor_runtime_read_helper_name(
				runtime_read.helper,
			) + "(" + iter_tmp + ", " + index_tmp + ");"
			loop_body: String = element_decl + "\n" + statement_body(for_tensor.body, body_c)

			Some({
				statements = indent_statements(
					source_binding + "\n" + cleanup_push + loop_header,
				) + indent_statements(loop_body) + "  }\n" + cleanup_pop + iterable_release,
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		TensorForBoxedElement(value_c_type):
			element_decl: String = value_c_type + " " + c_var_name(
				for_tensor.binder.variable,
			) + " = (" + value_c_type + ")" + iter_tmp + "->data[" + index_tmp + "];"
			loop_body: String = element_decl + "\n" + statement_body(for_tensor.body, body_c)

			Some({
				statements = indent_statements(
					source_binding + "\n" + cleanup_push + loop_header,
				) + indent_statements(loop_body) + "  }\n" + cleanup_pop + iterable_release,
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		TensorForRowSliceElement(row_slice):
			binding_name: String = c_var_name(for_tensor.binder.variable)
			binding_type: String = c_type_name(for_tensor.binder.typ)
			derived_dim: String = "(" + iter_tmp + "->capacity / " + iter_tmp + "->len)"
			row_size: String = if row_slice.runtime_derived:
				derived_dim
			else:
				row_slice.row_size
			result_first_dim: String = if row_slice.runtime_derived:
				derived_dim
			else:
				row_slice.result_first_dim
			element_decl: String = binding_type + " " + binding_name + " = (" + binding_type + ")blorp_tensor_slice_row(" + iter_tmp + ", " + index_tmp + ", " + row_size + ", " + result_first_dim + ");"
			loop_body: String = element_decl + "\n" + statement_body(
				for_tensor.body,
				body_c,
			) + "blorp_release(" + binding_name + ");\n"

			Some({
				statements = indent_statements(
					source_binding + "\n" + cleanup_push + loop_header,
				) + indent_statements(loop_body) + "  }\n" + cleanup_pop + iterable_release,
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})


private pure func tensor_runtime_read_helper_name(helper: CoreTensorRuntimeReadHelper) -> String:
	match helper:
		TensorRuntimeReadI64:
			"blorp_vector_read_i64"
		TensorRuntimeReadF64:
			"blorp_vector_read_f64"
		TensorRuntimeReadF32:
			"blorp_vector_read_f32"
		TensorRuntimeReadF16:
			"blorp_vector_read_f16"


private pure func core_expr_type(expr: CoreExpr) -> CoreType:
	match expr:
		LiteralExpr(literal, typ, loc):
			typ
		VarExpr(variable, typ, loc):
			typ
		VoidExpr(typ, loc):
			typ
		CooperativeCheckpointExpr(typ, loc):
			typ
		CallExpr(kind, callee, args, typ, loc):
			typ
		BinaryExpr(op, left, right, typ, loc):
			typ
		UnaryExpr(op, expr_value, typ, loc):
			typ
		LogicalExpr(op, left, right, typ, loc):
			typ
		AssignExpr(variable, rhs, typ, loc):
			typ
		CastExpr(expr_value, typ, loc):
			typ
		BoxExpr(box, typ, loc):
			typ
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			typ
		FieldExpr(expr_value, field_name, typ, loc):
			typ
		TupleFieldExpr(expr_value, field_index, typ, loc):
			typ
		TupleExpr(items, typ, loc):
			typ
		TupleConstructExpr(tuple_construct, typ, loc):
			typ
		ClosureCreateExpr(closure, typ, loc):
			typ
		ListConstructExpr(construct, typ, loc):
			typ
		ListAllocExpr(alloc, typ, loc):
			typ
		ListGetExpr(get, typ, loc):
			typ
		ListHandoffExpr(handoff, typ, loc):
			typ
		ListHandoffSetOwnedExpr(set, typ, loc):
			typ
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			typ
		StringByteReadExpr(read, typ, loc):
			typ
		StringByteWriteExpr(write, typ, loc):
			typ
		StringByteCopyExpr(copy, typ, loc):
			typ
		StringSetLenExpr(set_len, typ, loc):
			typ
		TensorLiteralExpr(literal, typ, loc):
			typ
		TensorBoxedLiteralExpr(literal, typ, loc):
			typ
		TensorPackedLiteralExpr(literal, typ, loc):
			typ
		TensorRawFillExpr(fill, typ, loc):
			typ
		TensorRawReadExpr(read, typ, loc):
			typ
		TensorRawWriteExpr(write, typ, loc):
			typ
		TensorRawViewLetExpr(binding, body, typ, loc):
			typ
		DictConstructExpr(construct, typ, loc):
			typ
		SetAllocExpr(alloc, typ, loc):
			typ
		ListRetainExpr(retain, typ, loc):
			typ
		ListSetExpr(set, typ, loc):
			typ
		RecordExpr(fields, typ, loc):
			typ
		RecordConstructExpr(type_name, fields, typ, loc):
			typ
		UnionConstructExpr(construct, typ, loc):
			typ
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			typ
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			typ
		LetExpr(name, is_mutable, typ, rhs, body):
			core_expr_type(body)
		SeqExpr(first, second):
			core_expr_type(second)
		WhileExpr(cond, body, typ, loc):
			typ
		BreakExpr(typ, loc):
			typ
		ContinueExpr(typ, loc):
			typ
		ResourceScopeExpr(scope, typ, loc):
			typ
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			typ
		TailrecLoopExpr(params, return_type, body, loc):
			return_type
		TailrecRecurExpr(args, typ, loc):
			typ
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			typ
		ForListExpr(for_list, typ, loc):
			typ
		ForTensorExpr(for_tensor, typ, loc):
			typ
		RangeExpr(start, end_value, typ, loc):
			typ
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			typ
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			typ
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			typ
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, default_body, typ, loc):
			typ
		IfExpr(cond, then_expr, else_expr, typ, loc):
			typ


private pure func c_literal_match_test(scrutinee: String, literal: CoreLiteral) -> Option[String]:
	match literal:
		IntLiteral(value):
			Some(scrutinee + " == " + value.to_string())
		WideIntLiteral(value):
			Some(scrutinee + " == " + value + "L")
		FloatLiteral(value):
			Some(scrutinee + " == " + c_float_literal(value))
		FloatTextLiteral(value):
			Some(scrutinee + " == " + value)
		FloatInfinityLiteral:
			Some(scrutinee + " == INFINITY")
		FloatNegInfinityLiteral:
			Some(scrutinee + " == -INFINITY")
		FloatNanLiteral:
			Some("isnan(" + scrutinee + ")")
		BoolLiteral(value):
			if value:
				Some(scrutinee + " == 1")
			else:
				Some(scrutinee + " == 0")
		CharLiteral(value):
			Some(scrutinee + " == " + value.to_string())
		StringLiteral(value):
			Some("blorp_string_eq(" + scrutinee + ", " + emit_string_literal_expr(value) + ")")


private pure func emit_literal_match_branch_body(
	result_name: Option[String],
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_function_body(body, next_temp)

	match result_name:
		Some(name):
			value ?= required_body_value(body_c)
			Some({
				statements = body_c.statements + "  " + name + " = " + value + ";\n",
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		None:
			Some({
				statements = statement_body(body, body_c),
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})


private pure func emit_literal_match_case_body(
	binding_scrutinee_temp: String,
	result_name: Option[String],
	match_case: CoreLiteralMatchCase,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	bindings_c ?= emit_match_bindings(binding_scrutinee_temp, match_case.bindings)
	body_c ?= emit_literal_match_branch_body(result_name, match_case.body, next_temp)

	Some({
		statements = bindings_c + body_c.statements,
		value = body_c.value,
		next_temp = body_c.next_temp,
		returns = body_c.returns,
	})


private pure func emit_constructor_match_test(
	scrutinee_temp: String,
	accessor: CoreAccessor,
	test: CoreConstructorMatchTest,
) -> String:
	match test:
		EnumConstructorTest(c_name):
			scrutinee_temp + " == " + c_name
		UnionTagConstructorTest(tag_c_name, union_c_type):
			constructor_match_test_target(scrutinee_temp, test) + "->tag == " + tag_c_name
		NullableOptionSomeConstructorTest:
			scrutinee_temp + " != NULL"
		NullableOptionNoneConstructorTest:
			scrutinee_temp + " == NULL"
		StackOptionSomeConstructorTest(option_type):
			stack_option_match_source(
				scrutinee_temp,
				accessor,
				option_type,
			) + ".tag == BLORP_TAG_SOME"
		StackOptionNoneConstructorTest(option_type):
			stack_option_match_source(
				scrutinee_temp,
				accessor,
				option_type,
			) + ".tag == BLORP_TAG_NONE"
		StackResultOkConstructorTest:
			scrutinee_temp + ".tag == BLORP_TAG_OK"
		StackResultErrConstructorTest:
			scrutinee_temp + ".tag == BLORP_TAG_ERR"
		BoxedResultOkConstructorTest:
			scrutinee_temp + "->tag == BLORP_TAG_OK"
		BoxedResultErrConstructorTest:
			scrutinee_temp + "->tag == BLORP_TAG_ERR"
		BoolTrueConstructorTest:
			scrutinee_temp + " != 0"
		BoolFalseConstructorTest:
			scrutinee_temp + " == 0"


private pure func constructor_match_union_scrutinee_type(
	cases: List[CoreConstructorMatchCase],
) -> Option[String]:
	var result: Option[String] = None
	var has_non_root_union_test: Bool = False

	for match_case in cases:
		match match_case.test:
			UnionTagConstructorTest(tag_c_name, union_c_type):
				if accessors_equal(match_case.accessor, RootAccessor):
					match result:
						Some(c_type):
							void
						None:
							result = Some(union_c_type + "*")
				else:
					has_non_root_union_test = True
			EnumConstructorTest(c_name):
				void
			NullableOptionSomeConstructorTest:
				void
			NullableOptionNoneConstructorTest:
				void
			StackOptionSomeConstructorTest(option_type):
				void
			StackOptionNoneConstructorTest(option_type):
				void
			StackResultOkConstructorTest:
				void
			StackResultErrConstructorTest:
				void
			BoxedResultOkConstructorTest:
				void
			BoxedResultErrConstructorTest:
				void
			BoolTrueConstructorTest:
				void
			BoolFalseConstructorTest:
				void

	if has_non_root_union_test:
		None
	else:
		result


private pure func constructor_match_scrutinee_c_type(
	scrutinee: CoreExpr,
	cases: List[CoreConstructorMatchCase],
) -> String:
	match constructor_match_union_scrutinee_type(cases):
		Some(c_type):
			c_type
		None:
			c_type_name(core_expr_type(scrutinee))


private pure func boxed_storage_value_source(
	raw_value: String,
	typ: CoreType,
) -> Option[String]:
	abi_value ?= closure_abi_value_for_type(typ)

	match abi_value:
		ClosureAbiVoid:
			Some("(void)0")
		ClosureAbiPointer:
			Some("((" + c_type_name(typ) + ")" + raw_value + ")")
		ClosureAbiPrim:
			Some("((" + c_type_name(typ) + ")(long)" + raw_value + ")")
		ClosureAbiFloat:
			Some("blorp_unbox_float(" + raw_value + ")")
		ClosureAbiFloat32:
			Some("blorp_unbox_float32(" + raw_value + ")")
		ClosureAbiFloat16:
			Some("blorp_unbox_float16(" + raw_value + ")")
		ClosureAbiInt128:
			Some("blorp_unbox_int128(" + raw_value + ")")
		ClosureAbiUInt128:
			Some("blorp_unbox_uint128(" + raw_value + ")")
		ClosureAbiStruct(c_type):
			Some(boxed_struct_value_source(c_type, raw_value))


private pure func boxed_struct_value_source(c_type: String, raw_value: String) -> String:
	"(*(" + c_type + "*)((char*)(" + raw_value + ") + sizeof(blorp_Object)))"


private pure func union_pointer_source(union_c_type: String, raw_value: String) -> String:
	"((" + union_c_type + "*)" + raw_value + ")"


private pure func emit_match_accessor(
	scrutinee_temp: String,
	accessor: CoreAccessor,
) -> Option[String]:
	match accessor:
		RootAccessor:
			Some(scrutinee_temp)
		VariantFieldAccessor(parent, union_c_type, constructor, field_index):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(
				union_pointer_source(
					union_c_type,
					parent_c,
				) + "->data." + constructor + ".field" + field_index.to_string(),
			)
		ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(
				union_pointer_source(
					union_c_type,
					parent_c,
				) + "->data." + constructor + ".field" + field_index.to_string(),
			)
		NullableOptionPayloadAccessor(parent):
			emit_match_accessor(scrutinee_temp, parent)
		StackOptionPayloadAccessor(parent):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(parent_c + ".value")
		StackResultOkPayloadAccessor(parent):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(parent_c + ".data.Ok.field0")
		StackResultErrPayloadAccessor(parent):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(parent_c + ".data.Err.field0")
		BoxedResultOkPayloadAccessor(parent):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(parent_c + "->data.Ok.field0")
		BoxedResultErrPayloadAccessor(parent):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(parent_c + "->data.Err.field0")
		TupleFieldAccessor(parent, index, typ):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			raw_value: String = render_prepared_tuple_op(TupleFieldElement({
				tuple = parent_c,
				field = index.to_string(),
			}))
			boxed_storage_value_source(raw_value, typ)
		ListElementAccessor(parent, index):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some("blorp_list_get((blorp_List*)" + parent_c + ", " + index.to_string() + ")")
		ListSpreadAccessor(parent, offset):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some("blorp_list_drop((blorp_List*)" + parent_c + ", " + offset.to_string() + ")")


private pure func boxed_payload_binding_source(
	raw_payload: String,
	typ: CoreType,
) -> Option[String]:
	boxed_storage_value_source(raw_payload, typ)


private pure func match_accessor_value_source(
	raw_source: String,
	accessor: CoreAccessor,
	typ: CoreType,
) -> Option[String]:
	match accessor:
		StackResultOkPayloadAccessor(parent):
			boxed_payload_binding_source(raw_source, typ)
		StackResultErrPayloadAccessor(parent):
			boxed_payload_binding_source(raw_source, typ)
		BoxedResultOkPayloadAccessor(parent):
			boxed_payload_binding_source(raw_source, typ)
		BoxedResultErrPayloadAccessor(parent):
			boxed_payload_binding_source(raw_source, typ)
		ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
			boxed_payload_binding_source(raw_source, typ)
		ListElementAccessor(parent, index):
			boxed_payload_binding_source(raw_source, typ)
		ListSpreadAccessor(parent, offset):
			Some(raw_source)
		TupleFieldAccessor(parent, index, field_type):
			Some(raw_source)
		RootAccessor:
			Some(raw_source)
		VariantFieldAccessor(parent, union_c_type, constructor, field_index):
			Some(raw_source)
		NullableOptionPayloadAccessor(parent):
			Some(raw_source)
		StackOptionPayloadAccessor(parent):
			Some(raw_source)


private pure func match_binding_source(
	scrutinee_temp: String,
	binding: CoreMatchBinding,
) -> Option[String]:
	raw_source ?= emit_match_accessor(scrutinee_temp, binding.accessor)
	match_accessor_value_source(raw_source, binding.accessor, binding.typ)


private pure func emit_borrow_match_binding_statement(
	binding: CoreMatchBinding,
	source_c: String,
) -> String:
	if is_void_type(binding.typ):
		"  " + source_c + ";\n"
	else:
		"  " + c_type_name(
			binding.typ,
		) + " " + c_var_name(binding.variable) + " = " + source_c + ";\n"


private pure func emit_match_binding(
	scrutinee_temp: String,
	binding: CoreMatchBinding,
) -> Option[String]:
	mode: CoreMatchBindingMode = binding.mode

	match mode:
		MatchBorrowBindingMode:
			source_c ?= match_binding_source(scrutinee_temp, binding)
			Some(emit_borrow_match_binding_statement(binding, source_c))
		MatchOwnBindingMode:
			None


private pure func emit_match_bindings(
	scrutinee_temp: String,
	bindings: List[CoreMatchBinding],
) -> Option[String]:
	var statements: String = ""
	var failed: Bool = False

	for binding in bindings:
		if not failed:
			match emit_match_binding(scrutinee_temp, binding):
				Some(statement):
					statements += statement
				None:
					failed = True

	if failed:
		None
	else:
		Some(statements)


private pure func accessors_equal(left: CoreAccessor, right: CoreAccessor) -> Bool:
	match left:
		RootAccessor:
			match right:
				RootAccessor: True
				VariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				NullableOptionPayloadAccessor(parent): False
				StackOptionPayloadAccessor(parent): False
				StackResultOkPayloadAccessor(parent): False
				StackResultErrPayloadAccessor(parent): False
				BoxedResultOkPayloadAccessor(parent): False
				BoxedResultErrPayloadAccessor(parent): False
				TupleFieldAccessor(parent, index, typ): False
				ListElementAccessor(parent, index): False
				ListSpreadAccessor(parent, offset): False
		VariantFieldAccessor(left_parent, left_union_c_type, left_constructor, left_field_index):
			match right:
				RootAccessor: False
				VariantFieldAccessor(right_parent, right_union_c_type, right_constructor, right_field_index):
					accessors_equal(left_parent, right_parent) and left_union_c_type == right_union_c_type and left_constructor == right_constructor and left_field_index == right_field_index
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				NullableOptionPayloadAccessor(parent): False
				StackOptionPayloadAccessor(parent): False
				StackResultOkPayloadAccessor(parent): False
				StackResultErrPayloadAccessor(parent): False
				BoxedResultOkPayloadAccessor(parent): False
				BoxedResultErrPayloadAccessor(parent): False
				TupleFieldAccessor(parent, index, typ): False
				ListElementAccessor(parent, index): False
				ListSpreadAccessor(parent, offset): False
		ErasedVariantFieldAccessor(left_parent, left_union_c_type, left_constructor, left_field_index):
			match right:
				RootAccessor: False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				ErasedVariantFieldAccessor(right_parent, right_union_c_type, right_constructor, right_field_index):
					accessors_equal(left_parent, right_parent) and left_union_c_type == right_union_c_type and left_constructor == right_constructor and left_field_index == right_field_index
				NullableOptionPayloadAccessor(parent): False
				StackOptionPayloadAccessor(parent): False
				StackResultOkPayloadAccessor(parent): False
				StackResultErrPayloadAccessor(parent): False
				BoxedResultOkPayloadAccessor(parent): False
				BoxedResultErrPayloadAccessor(parent): False
				TupleFieldAccessor(parent, index, typ): False
				ListElementAccessor(parent, index): False
				ListSpreadAccessor(parent, offset): False
		NullableOptionPayloadAccessor(left_parent):
			match right:
				RootAccessor: False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				NullableOptionPayloadAccessor(right_parent):
					accessors_equal(left_parent, right_parent)
				StackOptionPayloadAccessor(parent): False
				StackResultOkPayloadAccessor(parent): False
				StackResultErrPayloadAccessor(parent): False
				BoxedResultOkPayloadAccessor(parent): False
				BoxedResultErrPayloadAccessor(parent): False
				TupleFieldAccessor(parent, index, typ): False
				ListElementAccessor(parent, index): False
				ListSpreadAccessor(parent, offset): False
		StackOptionPayloadAccessor(left_parent):
			match right:
				RootAccessor: False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				NullableOptionPayloadAccessor(parent): False
				StackOptionPayloadAccessor(right_parent):
					accessors_equal(left_parent, right_parent)
				StackResultOkPayloadAccessor(parent): False
				StackResultErrPayloadAccessor(parent): False
				BoxedResultOkPayloadAccessor(parent): False
				BoxedResultErrPayloadAccessor(parent): False
				TupleFieldAccessor(parent, index, typ): False
				ListElementAccessor(parent, index): False
				ListSpreadAccessor(parent, offset): False
		StackResultOkPayloadAccessor(left_parent):
			match right:
				RootAccessor: False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				NullableOptionPayloadAccessor(parent): False
				StackOptionPayloadAccessor(parent): False
				StackResultOkPayloadAccessor(right_parent):
					accessors_equal(left_parent, right_parent)
				StackResultErrPayloadAccessor(parent): False
				BoxedResultOkPayloadAccessor(parent): False
				BoxedResultErrPayloadAccessor(parent): False
				TupleFieldAccessor(parent, index, typ): False
				ListElementAccessor(parent, index): False
				ListSpreadAccessor(parent, offset): False
		StackResultErrPayloadAccessor(left_parent):
			match right:
				RootAccessor: False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				NullableOptionPayloadAccessor(parent): False
				StackOptionPayloadAccessor(parent): False
				StackResultOkPayloadAccessor(parent): False
				StackResultErrPayloadAccessor(right_parent):
					accessors_equal(left_parent, right_parent)
				BoxedResultOkPayloadAccessor(parent): False
				BoxedResultErrPayloadAccessor(parent): False
				TupleFieldAccessor(parent, index, typ): False
				ListElementAccessor(parent, index): False
				ListSpreadAccessor(parent, offset): False
		BoxedResultOkPayloadAccessor(left_parent):
			match right:
				RootAccessor: False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				NullableOptionPayloadAccessor(parent): False
				StackOptionPayloadAccessor(parent): False
				StackResultOkPayloadAccessor(parent): False
				StackResultErrPayloadAccessor(parent): False
				BoxedResultOkPayloadAccessor(right_parent):
					accessors_equal(left_parent, right_parent)
				BoxedResultErrPayloadAccessor(parent): False
				TupleFieldAccessor(parent, index, typ): False
				ListElementAccessor(parent, index): False
				ListSpreadAccessor(parent, offset): False
		BoxedResultErrPayloadAccessor(left_parent):
			match right:
				RootAccessor: False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				NullableOptionPayloadAccessor(parent): False
				StackOptionPayloadAccessor(parent): False
				StackResultOkPayloadAccessor(parent): False
				StackResultErrPayloadAccessor(parent): False
				BoxedResultOkPayloadAccessor(parent): False
				BoxedResultErrPayloadAccessor(right_parent):
					accessors_equal(left_parent, right_parent)
				TupleFieldAccessor(parent, index, typ): False
				ListElementAccessor(parent, index): False
				ListSpreadAccessor(parent, offset): False
		TupleFieldAccessor(left_parent, left_index, left_typ):
			match right:
				RootAccessor: False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				NullableOptionPayloadAccessor(parent): False
				StackOptionPayloadAccessor(parent): False
				StackResultOkPayloadAccessor(parent): False
				StackResultErrPayloadAccessor(parent): False
				BoxedResultOkPayloadAccessor(parent): False
				BoxedResultErrPayloadAccessor(parent): False
				TupleFieldAccessor(right_parent, right_index, right_typ):
					accessors_equal(left_parent, right_parent) and left_index == right_index
				ListElementAccessor(parent, index): False
				ListSpreadAccessor(parent, offset): False
		ListElementAccessor(left_parent, left_index):
			match right:
				RootAccessor: False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				NullableOptionPayloadAccessor(parent): False
				StackOptionPayloadAccessor(parent): False
				StackResultOkPayloadAccessor(parent): False
				StackResultErrPayloadAccessor(parent): False
				BoxedResultOkPayloadAccessor(parent): False
				BoxedResultErrPayloadAccessor(parent): False
				TupleFieldAccessor(parent, index, typ): False
				ListElementAccessor(right_parent, right_index):
					accessors_equal(left_parent, right_parent) and left_index == right_index
				ListSpreadAccessor(parent, offset): False
		ListSpreadAccessor(left_parent, left_offset):
			match right:
				RootAccessor: False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index): False
				NullableOptionPayloadAccessor(parent): False
				StackOptionPayloadAccessor(parent): False
				StackResultOkPayloadAccessor(parent): False
				StackResultErrPayloadAccessor(parent): False
				BoxedResultOkPayloadAccessor(parent): False
				BoxedResultErrPayloadAccessor(parent): False
				TupleFieldAccessor(parent, index, typ): False
				ListElementAccessor(parent, index): False
				ListSpreadAccessor(right_parent, right_offset):
					accessors_equal(left_parent, right_parent) and left_offset == right_offset


private pure func constructor_match_test_target(
	source_c: String,
	test: CoreConstructorMatchTest,
) -> String:
	match test:
		UnionTagConstructorTest(tag_c_name, union_c_type):
			"((" + union_c_type + "*)" + source_c + ")"
		EnumConstructorTest(c_name):
			source_c
		NullableOptionSomeConstructorTest:
			source_c
		NullableOptionNoneConstructorTest:
			source_c
		StackOptionSomeConstructorTest(option_type):
			source_c
		StackOptionNoneConstructorTest(option_type):
			source_c
		StackResultOkConstructorTest:
			source_c
		StackResultErrConstructorTest:
			source_c
		BoxedResultOkConstructorTest:
			source_c
		BoxedResultErrConstructorTest:
			source_c
		BoolTrueConstructorTest:
			source_c
		BoolFalseConstructorTest:
			source_c


private pure func accessor_reads_boxed_struct_value(accessor: CoreAccessor) -> Bool:
	match accessor:
		RootAccessor:
			False
		VariantFieldAccessor(parent, union_c_type, constructor, field_index):
			False
		ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
			True
		NullableOptionPayloadAccessor(parent):
			False
		StackOptionPayloadAccessor(parent):
			False
		StackResultOkPayloadAccessor(parent):
			True
		StackResultErrPayloadAccessor(parent):
			True
		BoxedResultOkPayloadAccessor(parent):
			True
		BoxedResultErrPayloadAccessor(parent):
			True
		TupleFieldAccessor(parent, index, typ):
			False
		ListElementAccessor(parent, index):
			True
		ListSpreadAccessor(parent, offset):
			False


private pure func stack_option_match_source(
	source_c: String,
	accessor: CoreAccessor,
	option_type: String,
) -> String:
	if accessor_reads_boxed_struct_value(accessor):
		boxed_struct_value_source(option_type, source_c)
	else:
		source_c + ""


private pure func constructor_case_parent_source(
	parent_c: String,
	parent_accessor: CoreAccessor,
	case_accessor: CoreAccessor,
	case_test: CoreConstructorMatchTest,
) -> String:
	if accessors_equal(parent_accessor, case_accessor):
		constructor_match_test_target(parent_c, case_test)
	else:
		parent_c


private pure func emit_match_accessor_for_constructor_case(
	scrutinee_temp: String,
	case_accessor: CoreAccessor,
	case_test: CoreConstructorMatchTest,
	accessor: CoreAccessor,
) -> Option[String]:
	match accessor:
		RootAccessor:
			Some(scrutinee_temp)
		VariantFieldAccessor(parent, union_c_type, constructor, field_index):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some(
				union_pointer_source(
					union_c_type,
					parent_c,
				) + "->data." + constructor + ".field" + field_index.to_string(),
			)
		ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some(
				union_pointer_source(
					union_c_type,
					parent_c,
				) + "->data." + constructor + ".field" + field_index.to_string(),
			)
		NullableOptionPayloadAccessor(parent):
			emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
		StackOptionPayloadAccessor(parent):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			if accessors_equal(parent, case_accessor):
				match case_test:
					StackOptionSomeConstructorTest(option_type):
						Some(stack_option_match_source(parent_c, parent, option_type) + ".value")
					StackOptionNoneConstructorTest(option_type):
						Some(stack_option_match_source(parent_c, parent, option_type) + ".value")
					EnumConstructorTest(c_name):
						None
					UnionTagConstructorTest(tag_c_name, union_c_type):
						None
					NullableOptionSomeConstructorTest:
						None
					NullableOptionNoneConstructorTest:
						None
					StackResultOkConstructorTest:
						None
					StackResultErrConstructorTest:
						None
					BoxedResultOkConstructorTest:
						None
					BoxedResultErrConstructorTest:
						None
					BoolTrueConstructorTest:
						None
					BoolFalseConstructorTest:
						None
			else:
				Some(parent_c + ".value")
		StackResultOkPayloadAccessor(parent):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some(parent_c + ".data.Ok.field0")
		StackResultErrPayloadAccessor(parent):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some(parent_c + ".data.Err.field0")
		BoxedResultOkPayloadAccessor(parent):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some(parent_c + "->data.Ok.field0")
		BoxedResultErrPayloadAccessor(parent):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some(parent_c + "->data.Err.field0")
		TupleFieldAccessor(parent, index, typ):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			raw_value: String = render_prepared_tuple_op(TupleFieldElement({
				tuple = parent_c,
				field = index.to_string(),
			}))
			boxed_storage_value_source(raw_value, typ)
		ListElementAccessor(parent, index):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some("blorp_list_get((blorp_List*)" + parent_c + ", " + index.to_string() + ")")
		ListSpreadAccessor(parent, offset):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some("blorp_list_drop((blorp_List*)" + parent_c + ", " + offset.to_string() + ")")


private pure func constructor_case_binding_source(
	scrutinee_temp: String,
	match_case: CoreConstructorMatchCase,
	binding: CoreMatchBinding,
) -> Option[String]:
	raw_source ?= emit_match_accessor_for_constructor_case(
		scrutinee_temp,
		match_case.accessor,
		match_case.test,
		binding.accessor,
	)
	match_accessor_value_source(raw_source, binding.accessor, binding.typ)


private pure func emit_constructor_case_match_binding(
	scrutinee_temp: String,
	match_case: CoreConstructorMatchCase,
	binding: CoreMatchBinding,
) -> Option[String]:
	match binding.mode:
		MatchBorrowBindingMode:
			source_c ?= constructor_case_binding_source(scrutinee_temp, match_case, binding)
			Some(emit_borrow_match_binding_statement(binding, source_c))
		MatchOwnBindingMode:
			None


private pure func emit_constructor_case_match_bindings(
	scrutinee_temp: String,
	match_case: CoreConstructorMatchCase,
) -> Option[String]:
	var statements: String = ""
	var failed: Bool = False

	for binding in match_case.bindings:
		if not failed:
			match emit_constructor_case_match_binding(scrutinee_temp, match_case, binding):
				Some(statement):
					statements += statement
				None:
					failed = True

	if failed:
		None
	else:
		Some(statements)


private pure func emit_constructor_literal_match_body(
	outer_scrutinee_temp: String,
	result_name: Option[String],
	match_expr: CoreConstructorLiteralMatch,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	raw_scrutinee_value ?= emit_match_accessor(outer_scrutinee_temp, match_expr.accessor)
	scrutinee_value ?= match_accessor_value_source(
		raw_scrutinee_value,
		match_expr.accessor,
		match_expr.scrutinee_type,
	)
	scrutinee_temp: String = temp_name("match_scrut", next_temp)

	emit_literal_match_statement(
		"",
		scrutinee_temp,
		scrutinee_value,
		match_expr.scrutinee_type,
		Some(outer_scrutinee_temp),
		result_name,
		match_expr.cases,
		match_expr.fallback,
		next_temp + 1,
	)


private pure func emit_constructor_case_literal_match_body(
	outer_scrutinee_temp: String,
	result_name: Option[String],
	match_case: CoreConstructorMatchCase,
	match_expr: CoreConstructorLiteralMatch,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	raw_scrutinee_value ?= emit_match_accessor_for_constructor_case(
		outer_scrutinee_temp,
		match_case.accessor,
		match_case.test,
		match_expr.accessor,
	)
	scrutinee_value ?= match_accessor_value_source(
		raw_scrutinee_value,
		match_expr.accessor,
		match_expr.scrutinee_type,
	)
	scrutinee_temp: String = temp_name("match_scrut", next_temp)

	emit_literal_match_statement(
		"",
		scrutinee_temp,
		scrutinee_value,
		match_expr.scrutinee_type,
		Some(outer_scrutinee_temp),
		result_name,
		match_expr.cases,
		match_expr.fallback,
		next_temp + 1,
	)


private pure func emit_constructor_length_match_branch(
	outer_scrutinee_temp: String,
	result_name: Option[String],
	branch: CoreConstructorLengthMatchBranch,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	bindings_c ?= emit_match_bindings(outer_scrutinee_temp, branch.bindings)
	body_c ?= emit_constructor_match_body(outer_scrutinee_temp, result_name, branch.body, next_temp)

	Some({
		statements = bindings_c + body_c.statements,
		value = body_c.value,
		next_temp = body_c.next_temp,
		returns = body_c.returns,
	})


private pure func emit_constructor_length_match_fallback(
	outer_scrutinee_temp: String,
	result_name: Option[String],
	fallback: Option[CoreConstructorLengthMatchBranch],
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fallback:
		Some(branch):
			emit_constructor_length_match_branch(
				outer_scrutinee_temp,
				result_name,
				branch,
				next_temp,
			)
		None:
			Some(emit_literal_match_failure(next_temp))


private pure func emit_constructor_length_match_body(
	outer_scrutinee_temp: String,
	result_name: Option[String],
	match_expr: CoreConstructorLengthMatch,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	list_value ?= emit_match_accessor(outer_scrutinee_temp, match_expr.accessor)
	len_temp: String = temp_name("match_len", next_temp)
	var branch_next_temp: Int = next_temp + 1
	var branch_statements: String = ""
	var failed: Bool = False
	var has_case: Bool = False

	for match_case in match_expr.cases:
		if not failed:
			match emit_constructor_length_match_branch(
				outer_scrutinee_temp,
				result_name,
				match_case.branch,
				branch_next_temp,
			):
				Some(case_c):
					test: String = len_temp + " == " + match_case.length.to_string()

					if has_case:
						branch_statements += "  } else if (" + test + ") {\n"
					else:
						branch_statements += "  if (" + test + ") {\n"

					branch_statements += indent_statements(case_c.statements)
					branch_next_temp = case_c.next_temp
					has_case = True
				None:
					failed = True

	match match_expr.geq:
		Some(geq_case):
			if not failed:
				match emit_constructor_length_match_branch(
					outer_scrutinee_temp,
					result_name,
					geq_case.branch,
					branch_next_temp,
				):
					Some(case_c):
						test: String = len_temp + " >= " + geq_case.minimum_length.to_string()

						if has_case:
							branch_statements += "  } else if (" + test + ") {\n"
						else:
							branch_statements += "  if (" + test + ") {\n"

						branch_statements += indent_statements(case_c.statements)
						branch_next_temp = case_c.next_temp
						has_case = True
					None:
						failed = True
		None:
			void

	if failed:
		None
	else:
		fallback_c ?= emit_constructor_length_match_fallback(
			outer_scrutinee_temp,
			result_name,
			match_expr.fallback,
			branch_next_temp,
		)
		prefix: String = "  long " + len_temp + " = ((blorp_List*)" + list_value + ")->len;\n"

		var match_statements: String = fallback_c.statements

		if has_case:
			match_statements = branch_statements + "  } else {\n" + indent_statements(
				fallback_c.statements,
			) + "  }\n"

		Some({
			statements = prefix + match_statements,
			value = "",
			next_temp = fallback_c.next_temp,
			returns = False,
		})


private pure func emit_constructor_match_body(
	outer_scrutinee_temp: String,
	result_name: Option[String],
	body: CoreConstructorMatchBody,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match body:
		ConstructorMatchBodyExpr(expr):
			emit_literal_match_branch_body(result_name, expr, next_temp)
		ConstructorMatchBodyLiteral(match_expr):
			emit_constructor_literal_match_body(
				outer_scrutinee_temp,
				result_name,
				match_expr,
				next_temp,
			)
		ConstructorMatchBodyLength(match_expr):
			emit_constructor_length_match_body(
				outer_scrutinee_temp,
				result_name,
				match_expr,
				next_temp,
			)


private pure func emit_constructor_match_branch_body(
	scrutinee_temp: String,
	result_name: Option[String],
	match_case: CoreConstructorMatchCase,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	bindings_c ?= emit_constructor_case_match_bindings(scrutinee_temp, match_case)
	body_c ?= match match_case.body:
		ConstructorMatchBodyExpr(expr):
			emit_literal_match_branch_body(result_name, expr, next_temp)
		ConstructorMatchBodyLiteral(match_expr):
			emit_constructor_case_literal_match_body(
				scrutinee_temp,
				result_name,
				match_case,
				match_expr,
				next_temp,
			)
		ConstructorMatchBodyLength(match_expr):
			emit_constructor_length_match_body(scrutinee_temp, result_name, match_expr, next_temp)

	Some({
		statements = bindings_c + body_c.statements,
		value = body_c.value,
		next_temp = body_c.next_temp,
		returns = body_c.returns,
	})


private pure func emit_literal_match_failure(next_temp: Int) -> FunctionBodyC:
	terminal_body("  fprintf(stderr, \"blorp: non-exhaustive match\\n\");\n  abort();\n", next_temp)


private pure func emit_literal_match_fallback(
	scrutinee_temp: String,
	result_name: Option[String],
	fallback: CoreLiteralMatchFallback,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fallback:
		LiteralMatchFallbackBody(body):
			emit_literal_match_branch_body(result_name, body, next_temp)
		LiteralMatchFallbackBindings(bindings, body):
			bindings_c ?= emit_match_bindings(scrutinee_temp, bindings)
			body_c ?= emit_literal_match_branch_body(result_name, body, next_temp)
			Some({
				statements = bindings_c + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		LiteralMatchFallbackFail:
			Some(emit_literal_match_failure(next_temp))


private pure func emit_literal_match_statement(
	prefix_statements: String,
	scrutinee_temp: String,
	scrutinee_value: String,
	scrutinee_type: CoreType,
	fallback_binding_scrutinee_temp: Option[String],
	result_name: Option[String],
	cases: List[CoreLiteralMatchCase],
	fallback: CoreLiteralMatchFallback,
	branch_next_temp_start: Int,
) -> Option[FunctionBodyC]:
	var branch_next_temp: Int = branch_next_temp_start
	var branch_statements: String = ""
	var failed: Bool = False
	var has_case: Bool = False
	binding_scrutinee_temp: String = match fallback_binding_scrutinee_temp:
		Some(name):
			name
		None:
			scrutinee_temp

	for match_case in cases:
		if not failed:
			match c_literal_match_test(scrutinee_temp, match_case.literal):
				Some(test):
					match emit_literal_match_case_body(
						binding_scrutinee_temp,
						result_name,
						match_case,
						branch_next_temp,
					):
						Some(case_c):
							if has_case:
								branch_statements += "  } else if (" + test + ") {\n"
							else:
								branch_statements += "  if (" + test + ") {\n"

							branch_statements += indent_statements(case_c.statements)
							branch_next_temp = case_c.next_temp
							has_case = True
						None:
							failed = True
				None:
					failed = True

	if failed:
		None
	else:
		fallback_c ?= emit_literal_match_fallback(
			binding_scrutinee_temp,
			result_name,
			fallback,
			branch_next_temp,
		)
		prefix: String = prefix_statements + "  " + c_type_name(
			scrutinee_type,
		) + " " + scrutinee_temp + " = " + scrutinee_value + ";\n"

		var match_statements: String = fallback_c.statements

		if has_case:
			match_statements = branch_statements + "  } else {\n" + indent_statements(
				fallback_c.statements,
			) + "  }\n"

		Some({
			statements = prefix + match_statements,
			value = "",
			next_temp = fallback_c.next_temp,
			returns = False,
		})


private pure func emit_literal_match(
	scrutinee: CoreExpr,
	cases: List[CoreLiteralMatchCase],
	fallback: CoreLiteralMatchFallback,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	scrutinee_c ?= emit_function_body(scrutinee, next_temp)
	scrutinee_value ?= required_body_value(scrutinee_c)
	scrutinee_temp: String = temp_name("match_scrut", scrutinee_c.next_temp)
	result_temp: String = temp_name("match_result", scrutinee_c.next_temp + 1)
	has_result: Bool = not is_void_type(typ)

	var branch_next_temp: Int = scrutinee_c.next_temp + 1
	var result_decl: String = ""
	var result_value: String = ""

	result_name: Option[String] = if has_result:
		branch_next_temp = scrutinee_c.next_temp + 2
		result_decl = "  " + c_type_name(typ) + " " + result_temp + ";\n"
		result_value = result_temp
		Some(result_temp)
	else:
		None

	match_c ?= emit_literal_match_statement(
		scrutinee_c.statements + result_decl,
		scrutinee_temp,
		scrutinee_value,
		core_expr_type(scrutinee),
		None,
		result_name,
		cases,
		fallback,
		branch_next_temp,
	)

	Some({
		statements = match_c.statements,
		value = result_value,
		next_temp = match_c.next_temp,
		returns = False,
	})


private pure func emit_accessor_literal_match(
	scrutinee: CoreExpr,
	scrutinee_release_policy: CoreReleasePolicy,
	match_expr: CoreConstructorLiteralMatch,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	scrutinee_c ?= emit_function_body(scrutinee, next_temp)
	scrutinee_value ?= required_body_value(scrutinee_c)
	scrutinee_temp: String = temp_name("match_scrut", scrutinee_c.next_temp)
	result_temp: String = temp_name("match_result", scrutinee_c.next_temp + 1)
	has_result: Bool = not is_void_type(typ)

	var branch_next_temp: Int = scrutinee_c.next_temp + 1
	var result_decl: String = ""
	var result_value: String = ""

	result_name: Option[String] = if has_result:
		branch_next_temp = scrutinee_c.next_temp + 2
		result_decl = "  " + c_type_name(typ) + " " + result_temp + ";\n"
		result_value = result_temp
		Some(result_temp)
	else:
		None

	match_c ?= emit_constructor_literal_match_body(
		scrutinee_temp,
		result_name,
		match_expr,
		branch_next_temp,
	)
	prefix: String = scrutinee_c.statements + "  " + c_type_name(
		core_expr_type(
			scrutinee,
		),
	) + " " + scrutinee_temp + " = " + scrutinee_value + ";\n" + owned_temp_cleanup_push_statement(
		scrutinee_temp,
		scrutinee_release_policy,
	) + result_decl

	Some({
		statements = prefix + match_c.statements + owned_temp_cleanup_pop_statement(
			scrutinee_temp,
			scrutinee_release_policy,
		) + emit_release_statement(scrutinee_temp, scrutinee_release_policy),
		value = result_value,
		next_temp = match_c.next_temp,
		returns = False,
	})


private pure func emit_length_match(
	scrutinee: CoreExpr,
	scrutinee_release_policy: CoreReleasePolicy,
	match_expr: CoreConstructorLengthMatch,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	scrutinee_c ?= emit_function_body(scrutinee, next_temp)
	scrutinee_value ?= required_body_value(scrutinee_c)
	scrutinee_temp: String = temp_name("match_scrut", scrutinee_c.next_temp)
	result_temp: String = temp_name("match_result", scrutinee_c.next_temp + 1)
	has_result: Bool = not is_void_type(typ)

	var branch_next_temp: Int = scrutinee_c.next_temp + 1
	var result_decl: String = ""
	var result_value: String = ""

	result_name: Option[String] = if has_result:
		branch_next_temp = scrutinee_c.next_temp + 2
		result_decl = "  " + c_type_name(typ) + " " + result_temp + ";\n"
		result_value = result_temp
		Some(result_temp)
	else:
		None

	match_c ?= emit_constructor_length_match_body(
		scrutinee_temp,
		result_name,
		match_expr,
		branch_next_temp,
	)
	prefix: String = scrutinee_c.statements + "  " + c_type_name(
		core_expr_type(
			scrutinee,
		),
	) + " " + scrutinee_temp + " = " + scrutinee_value + ";\n" + owned_temp_cleanup_push_statement(
		scrutinee_temp,
		scrutinee_release_policy,
	) + result_decl

	Some({
		statements = prefix + match_c.statements + owned_temp_cleanup_pop_statement(
			scrutinee_temp,
			scrutinee_release_policy,
		) + emit_release_statement(scrutinee_temp, scrutinee_release_policy),
		value = result_value,
		next_temp = match_c.next_temp,
		returns = False,
	})


private pure func emit_constructor_match_fallback(
	scrutinee_temp: String,
	result_name: Option[String],
	fallback: CoreConstructorMatchFallback,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			emit_literal_match_branch_body(result_name, body, next_temp)
		ConstructorMatchFallbackBindings(bindings, body):
			bindings_c ?= emit_match_bindings(scrutinee_temp, bindings)
			body_c ?= emit_literal_match_branch_body(result_name, body, next_temp)
			Some({
				statements = bindings_c + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		ConstructorMatchFallbackFail:
			Some(emit_literal_match_failure(next_temp))


private pure func emit_constructor_match(
	scrutinee: CoreExpr,
	scrutinee_release_policy: CoreReleasePolicy,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	scrutinee_c ?= emit_function_body(scrutinee, next_temp)
	scrutinee_value ?= required_body_value(scrutinee_c)
	scrutinee_temp: String = temp_name("match_scrut", scrutinee_c.next_temp)
	result_temp: String = temp_name("match_result", scrutinee_c.next_temp + 1)
	has_result: Bool = not is_void_type(typ)

	var branch_next_temp: Int = scrutinee_c.next_temp + 1

	if has_result:
		branch_next_temp = scrutinee_c.next_temp + 2

	result_name: Option[String] = if has_result:
		Some(result_temp)
	else:
		None

	var branch_statements: String = ""
	var failed: Bool = False
	var has_case: Bool = False

	for match_case in cases:
		if not failed:
			match emit_match_accessor(scrutinee_temp, match_case.accessor):
				Some(test_target):
					test: String = emit_constructor_match_test(
						test_target,
						match_case.accessor,
						match_case.test,
					)

					match emit_constructor_match_branch_body(
						scrutinee_temp,
						result_name,
						match_case,
						branch_next_temp,
					):
						Some(case_c):
							if has_case:
								branch_statements += "  } else if (" + test + ") {\n"
							else:
								branch_statements += "  if (" + test + ") {\n"

							branch_statements += indent_statements(case_c.statements)
							branch_next_temp = case_c.next_temp
							has_case = True
						None:
							failed = True
				None:
					failed = True

	if failed:
		None
	else:
		fallback_c ?= emit_constructor_match_fallback(
			scrutinee_temp,
			result_name,
			fallback,
			branch_next_temp,
		)
		scrutinee_type: String = constructor_match_scrutinee_c_type(scrutinee, cases)
		prefix: String = scrutinee_c.statements + "  " + scrutinee_type + " " + scrutinee_temp + " = " + scrutinee_value + ";\n" + owned_temp_cleanup_push_statement(
			scrutinee_temp,
			scrutinee_release_policy,
		)
		var result_decl: String = ""

		if has_result:
			result_decl = "  " + c_type_name(typ) + " " + result_temp + ";\n"

		var match_statements: String = fallback_c.statements

		if has_case:
			match_statements = branch_statements + "  } else {\n" + indent_statements(
				fallback_c.statements,
			) + "  }\n"

		var result_value: String = ""

		if has_result:
			result_value = result_temp

		Some({
			statements = prefix + result_decl + match_statements + owned_temp_cleanup_pop_statement(
				scrutinee_temp,
				scrutinee_release_policy,
			) + emit_release_statement(scrutinee_temp, scrutinee_release_policy),
			value = result_value,
			next_temp = fallback_c.next_temp,
			returns = False,
		})


private pure func emit_resource_cleanups(
	cleanups: List[CoreExpr],
	next_temp: Int,
) -> Option[FunctionBodyC]:
	var statements: String = ""
	var current_temp: Int = next_temp
	var failed: Bool = False

	for cleanup in cleanups:
		if not failed:
			match resource_cleanup_hook(cleanup):
				Some(hook):
					statements += cancellation_cleanup_pop_statement(hook.variable)
				None:
					statements = statements

			match emit_function_body(cleanup, current_temp):
				Some(cleanup_c):
					statements += discard_expr_body(cleanup, cleanup_c)
					current_temp = cleanup_c.next_temp
				None:
					failed = True

	if failed:
		None
	else:
		Some({
			statements = statements,
			value = "",
			next_temp = current_temp,
			returns = False,
		})


private pure func resource_exit_statement(exit: CoreResourceExit) -> String:
	match exit:
		ResourceBreakExit:
			"  break;\n"
		ResourceContinueExit:
			"  continue;\n"


private pure func emit_resource_cleanup_exit(
	cleanup_exit: CoreResourceCleanupExit,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	cleanups_c ?= emit_resource_cleanups(cleanup_exit.cleanups, next_temp)

	Some({
		statements = cleanups_c.statements + resource_exit_statement(cleanup_exit.exit),
		value = "",
		next_temp = cleanups_c.next_temp,
		returns = False,
	})


private pure func emit_resource_scope(
	scope: CoreResourceScope,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	acquire_c ?= emit_simple_expr(scope.acquire)
	push_statement ?= resource_cleanup_push_statement(scope)
	resource_declaration: String = "  " + c_type_name(
		scope.typ,
	) + " " + c_var_name(scope.variable) + " = " + acquire_c + ";\n"
	pop_statement: String = cancellation_cleanup_pop_statement(scope.variable)

	if is_void_type(typ):
		body_c ?= emit_function_body(scope.body, next_temp)
		cleanup_c ?= emit_function_body(scope.cleanup, body_c.next_temp)
		inner: String = resource_declaration + push_statement + statement_body(
			scope.body,
			body_c,
		) + pop_statement + discard_expr_body(scope.cleanup, cleanup_c)

		Some({
			statements = "  {\n" + indent_statements(inner) + "  }\n",
			value = "",
			next_temp = cleanup_c.next_temp,
			returns = False,
		})
	else:
		result_name: String = temp_name("resource_result", next_temp)
		body_c ?= emit_function_body(scope.body, next_temp + 1)
		body_value ?= required_body_value(body_c)
		cleanup_c ?= emit_function_body(scope.cleanup, body_c.next_temp)
		inner: String = resource_declaration + push_statement + body_c.statements + "  " + result_name + " = " + body_value + ";\n" + pop_statement + discard_expr_body(
			scope.cleanup,
			cleanup_c,
		)

		Some({
			statements = "  " + c_type_name(
				typ,
			) + " " + result_name + ";\n  {\n" + indent_statements(inner) + "  }\n",
			value = result_name,
			next_temp = cleanup_c.next_temp,
			returns = False,
		})


private pure func emit_function_body(expr: CoreExpr, next_temp: Int) -> Option[FunctionBodyC]:
	match expr:
		LetExpr(name, is_mutable, typ, rhs, body):
			if is_void_type(typ):
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_function_body(body, rhs_c.next_temp)
				Some({
					statements = discard_expr_body(rhs, rhs_c) + body_c.statements,
					value = body_c.value,
					next_temp = body_c.next_temp,
					returns = body_c.returns,
				})
			else if name.name == "_":
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_function_body(body, rhs_c.next_temp)
				Some({
					statements = discard_expr_body(rhs, rhs_c) + body_c.statements,
					value = body_c.value,
					next_temp = body_c.next_temp,
					returns = body_c.returns,
				})
			else:
				match emit_simple_expr(rhs):
					Some(rhs_c):
						body_c ?= emit_function_body(body, next_temp)
						Some({
							statements = "  " + c_type_name(
								typ,
							) + " " + c_var_name(name) + " = " + rhs_c + ";\n" + body_c.statements,
							value = body_c.value,
							next_temp = body_c.next_temp,
							returns = body_c.returns,
						})
					None:
						rhs_body ?= emit_function_body(rhs, next_temp)
						rhs_value ?= required_body_value(rhs_body)
						body_c ?= emit_function_body(body, rhs_body.next_temp)
						rhs_statement_expr: String = statement_expression(
							rhs_body.statements,
							rhs_value,
						)
						Some({
							statements = "  " + c_type_name(
								typ,
							) + " " + c_var_name(
								name,
							) + " = " + rhs_statement_expr + ";\n" + body_c.statements,
							value = body_c.value,
							next_temp = body_c.next_temp,
							returns = body_c.returns,
						})
		LiteralExpr(literal, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		VarExpr(variable, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		VoidExpr(typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		CooperativeCheckpointExpr(typ, loc):
			Some({
				statements = "  blorp_cooperative_checkpoint();\n",
				value = "",
				next_temp = next_temp,
				returns = False,
			})
		CallExpr(kind, callee, args, typ, loc):
			match kind:
				OperationResultCall(bridge):
					emit_operation_result_bridge_body(bridge, args, typ, next_temp)
				ListToStringCall(callback_name):
					match emit_simple_expr(expr):
						Some(value):
							Some(body_value(value, next_temp))
						None:
							emit_call_body(kind, args, typ, next_temp)
				UserCall(name, def_id):
					match emit_simple_expr(expr):
						Some(value):
							Some(body_value(value, next_temp))
						None:
							emit_call_body(kind, args, typ, next_temp)
				ForeignCall(name):
					match emit_simple_expr(expr):
						Some(value):
							Some(body_value(value, next_temp))
						None:
							emit_call_body(kind, args, typ, next_temp)
				BuiltinCall(name):
					match emit_simple_expr(expr):
						Some(value):
							Some(body_value(value, next_temp))
						None:
							emit_call_body(kind, args, typ, next_temp)
				IntrinsicCall(name):
					match emit_simple_expr(expr):
						Some(value):
							Some(body_value(value, next_temp))
						None:
							emit_call_body(kind, args, typ, next_temp)
				ClosureCall:
					value ?= emit_simple_expr(expr)
					Some(body_value(value, next_temp))
		BinaryExpr(op, left, right, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_binary_body(op, left, right, typ, next_temp)
		UnaryExpr(op, expr_value, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_unary_body(op, expr_value, typ, next_temp)
		LogicalExpr(op, left, right, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_logical_body(op, left, right, next_temp)
		AssignExpr(variable, rhs, typ, loc):
			rhs_c ?= emit_function_body(rhs, next_temp)

			if variable.name == "_":
				Some({
					statements = discard_expr_body(rhs, rhs_c),
					value = "",
					next_temp = rhs_c.next_temp,
					returns = False,
				})
			else:
				Some({
					statements = rhs_c.statements + "  " + c_var_name(
						variable,
					) + " = " + rhs_c.value + ";\n",
					value = "",
					next_temp = rhs_c.next_temp,
					returns = False,
				})
		CastExpr(expr_value, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_cast_body(expr_value, typ, next_temp)
		BoxExpr(box, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		FieldExpr(expr_value, field_name, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TupleFieldExpr(expr_value, field_index, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TupleExpr(items, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TupleConstructExpr(tuple_construct, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_tuple_construct_body(tuple_construct, next_temp)
		ClosureCreateExpr(closure, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListConstructExpr(construct, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_list_construct_body(construct, next_temp)
		ListAllocExpr(alloc, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListGetExpr(get, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListHandoffExpr(handoff, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListHandoffSetOwnedExpr(set, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_list_handoff_set_owned_body(set, next_temp)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		StringByteReadExpr(read, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		StringByteWriteExpr(write, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		StringByteCopyExpr(copy, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		StringSetLenExpr(set_len, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TensorLiteralExpr(literal, typ, loc):
			emit_tensor_literal(literal, next_temp)
		TensorBoxedLiteralExpr(literal, typ, loc):
			emit_tensor_boxed_literal(literal, next_temp)
		TensorPackedLiteralExpr(literal, typ, loc):
			emit_tensor_packed_literal(literal, next_temp)
		TensorRawFillExpr(fill, typ, loc):
			emit_tensor_raw_fill(fill, next_temp)
		TensorRawReadExpr(read, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TensorRawWriteExpr(write, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TensorRawViewLetExpr(binding, body, typ, loc):
			decl ?= tensor_raw_view_decl(binding)
			body_c ?= emit_function_body(body, next_temp)
			Some({
				statements = "  " + decl + ";\n" + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		DictConstructExpr(construct, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		SetAllocExpr(alloc, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListRetainExpr(retain, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListSetExpr(set, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_list_set_body(set, next_temp)
		RecordExpr(fields, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		RecordConstructExpr(type_name, fields, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_record_construct_body(type_name, fields, typ, next_temp)
		UnionConstructExpr(construct, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_union_construct_body(construct, next_temp)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			retain_statement: String = emit_dup_statement(variable, retain_policy)
			body_c ?= emit_function_body(body, next_temp)
			Some({
				statements = retain_statement + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			drop_statement: String = emit_drop_statement(variable, release_policy)
			body_c ?= emit_function_body(body, next_temp)
			Some({
				statements = drop_statement + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		SeqExpr(first, second):
			first_c ?= emit_function_body(first, next_temp)
			second_c ?= emit_function_body(second, first_c.next_temp)
			Some({
				statements = discard_expr_body(first, first_c) + second_c.statements,
				value = second_c.value,
				next_temp = second_c.next_temp,
				returns = second_c.returns,
			})
		WhileExpr(cond, body, typ, loc):
			condition ?= emit_condition(cond, next_temp)
			body_c ?= emit_function_body(body, condition.next_temp)

			if condition.statements == "":
				Some({
					statements = "  while (" + condition.value + ") {\n" + indent_statements(
						statement_body(
							body,
							body_c,
						),
					) + "  }\n",
					value = "",
					next_temp = body_c.next_temp,
					returns = False,
				})
			else:
				Some({
					statements = "  while (1) {\n" + indent_statements(
						condition.statements + "  if (!(" + condition.value + ")) {\n    break;\n  }\n" + statement_body(
							body,
							body_c,
						),
					) + "  }\n",
					value = "",
					next_temp = body_c.next_temp,
					returns = False,
				})
		BreakExpr(typ, loc):
			Some({
				statements = "  break;\n",
				value = "",
				next_temp = next_temp,
				returns = False,
			})
		ContinueExpr(typ, loc):
			Some({
				statements = "  continue;\n",
				value = "",
				next_temp = next_temp,
				returns = False,
			})
		ResourceScopeExpr(scope, typ, loc):
			emit_resource_scope(scope, typ, next_temp)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			emit_resource_cleanup_exit(cleanup_exit, next_temp)
		TailrecLoopExpr(params, return_type, body, loc):
			emit_tailrec_loop(params, return_type, body, next_temp)
		TailrecRecurExpr(args, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			emit_for_range(binder, start, end_value, body, next_temp)
		ForListExpr(for_list, typ, loc):
			emit_for_list(for_list, next_temp)
		ForTensorExpr(for_tensor, typ, loc):
			emit_for_tensor(for_tensor, next_temp)
		RangeExpr(start, end_value, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			emit_accessor_literal_match(
				scrutinee,
				scrutinee_release_policy,
				match_expr,
				typ,
				next_temp,
			)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			emit_length_match(scrutinee, scrutinee_release_policy, match_expr, typ, next_temp)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			emit_literal_match(scrutinee, cases, fallback, typ, next_temp)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			emit_constructor_match(
				scrutinee,
				scrutinee_release_policy,
				cases,
				fallback,
				typ,
				next_temp,
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					condition ?= emit_condition(cond, next_temp)

					if is_void_type(typ):
						then_c ?= emit_function_body(then_expr, condition.next_temp)
						else_c ?= emit_function_body(else_expr, then_c.next_temp)
						else_statements: String = statement_body(else_expr, else_c)

						if else_statements == "":
							Some({
								statements = condition.statements + "  if (" + condition.value + ") {\n" + indent_statements(
									statement_body(
										then_expr,
										then_c,
									),
								) + "  }\n",
								value = "",
								next_temp = else_c.next_temp,
								returns = False,
							})
						else:
							Some({
								statements = condition.statements + "  if (" + condition.value + ") {\n" + indent_statements(
									statement_body(
										then_expr,
										then_c,
									),
								) + "  } else {\n" + indent_statements(else_statements) + "  }\n",
								value = "",
								next_temp = else_c.next_temp,
								returns = False,
							})
					else:
						temp: String = temp_name("if_result", condition.next_temp)
						then_c ?= emit_function_body(then_expr, condition.next_temp + 1)
						else_c ?= emit_function_body(else_expr, then_c.next_temp)
						then_value ?= required_body_value(then_c)
						else_value ?= required_body_value(else_c)
						Some({
							statements = "  " + c_type_name(
								typ,
							) + " " + temp + ";\n" + condition.statements + "  if (" + condition.value + ") {\n" + indent_statements(
								then_c.statements,
							) + "    " + temp + " = " + then_value + ";\n  } else {\n" + indent_statements(
								else_c.statements,
							) + "    " + temp + " = " + else_value + ";\n  }\n",
							value = temp,
							next_temp = else_c.next_temp,
							returns = False,
						})


private pure func union_type_name(typ: CoreType) -> Option[String]:
	match typ:
		UnionType(name):
			Some(name)
		NamedType(name, args):
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		HeapRecordType(name):
			None
		TupleType(items):
			None
		TensorType:
			None
		VoidType:
			None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		RangeType:
			None


private pure func find_union_decl(decls: List[CoreDecl], type_name: String) -> Option[CoreUnionDecl]:
	var found: Option[CoreUnionDecl] = None

	for decl in decls:
		match decl:
			UnionDecl(union_decl):
				if union_decl.name == type_name:
					found = Some(union_decl)
			FunctionDecl(func_info):
				void
			EnumDecl(enum_decl):
				void
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			GlobalDecl(global):
				void

	found


private pure func find_union_variant(
	union_decl: CoreUnionDecl,
	variant_name: String,
) -> Option[CoreUnionVariant]:
	var found: Option[CoreUnionVariant] = None

	for variant in union_decl.variants:
		if variant.name == variant_name:
			found = Some(variant)

	found


private pure func union_variant_c_name(
	union_decl: CoreUnionDecl,
	variant_name: String,
) -> Option[String]:
	variant ?= find_union_variant(union_decl, variant_name)
	Some(variant.c_name)


private pure func channel_attempt_constructors(union_decl: CoreUnionDecl) -> ChannelAttemptConstructors:
	recv_value_variant: Option[CoreUnionVariant] = find_union_variant(union_decl, "RecvValue")
	recv_value_uses_release_mask: Bool = match recv_value_variant:
		Some(variant):
			union_variant_uses_release_mask(union_decl, variant)
		None:
			False

	{
		recv_value = union_variant_c_name(union_decl, "RecvValue"),
		recv_would_block = union_variant_c_name(union_decl, "RecvWouldBlock"),
		recv_sealed = union_variant_c_name(union_decl, "RecvSealed"),
		recv_timed_out = union_variant_c_name(union_decl, "RecvTimedOut"),
		send_accepted = union_variant_c_name(union_decl, "SendAccepted"),
		send_would_block = union_variant_c_name(union_decl, "SendWouldBlock"),
		send_sealed = union_variant_c_name(union_decl, "SendSealed"),
		send_timed_out = union_variant_c_name(union_decl, "SendTimedOut"),
		recv_value_uses_release_mask = recv_value_uses_release_mask
	}


private pure func channel_send_attempt_constructors(
	constructors: ChannelAttemptConstructors,
) -> Option[ChannelSendAttemptConstructors]:
	accepted ?= constructors.send_accepted
	would_block ?= constructors.send_would_block
	sealed ?= constructors.send_sealed
	timed_out ?= constructors.send_timed_out

	Some({
		accepted = accepted,
		would_block = would_block,
		sealed = sealed,
		timed_out = timed_out
	})


private pure func channel_recv_attempt_constructors(
	constructors: ChannelAttemptConstructors,
	empty: Option[String],
) -> Option[ChannelRecvAttemptConstructors]:
	value ?= constructors.recv_value
	sealed ?= constructors.recv_sealed
	empty_ctor ?= empty

	Some({
		value = value,
		sealed = sealed,
		empty = empty_ctor
	})


private pure func emit_channel_send_attempt_value(
	result_type: String,
	channel: String,
	value: String,
	timeout: Option[String],
	temp_seed: String,
	constructors: ChannelSendAttemptConstructors,
) -> String:
	match timeout:
		Some(timeout_value):
			args: ChannelSendTimeoutAttemptArgs = {
				result_type = result_type,
				channel = channel,
				value = value,
				timeout = timeout_value,
				temp_seed = temp_seed,
				constructors = constructors
			}
			render_prepared_backend_op(BackendChannelSendTimeoutAttempt(args))
		None:
			args: ChannelTrySendAttemptArgs = {
				result_type = result_type,
				channel = channel,
				value = value,
				temp_seed = temp_seed,
				constructors = constructors
			}
			render_prepared_backend_op(BackendChannelTrySendAttempt(args))


private pure func emit_channel_recv_attempt_value(
	result_type: String,
	channel: String,
	timeout: Option[String],
	temp_seed: String,
	release_policy: ChannelRecvReleasePolicy,
	constructors: ChannelRecvAttemptConstructors,
	value_constructor_uses_release_mask: Bool,
) -> String:
	match timeout:
		Some(timeout_value):
			if value_constructor_uses_release_mask:
				args: ChannelRecvTimeoutAttemptArgs = {
					result_type = result_type,
					channel = channel,
					timeout = timeout_value,
					temp_seed = temp_seed,
					release_policy = release_policy,
					constructors = constructors
				}
				render_prepared_backend_op(BackendChannelRecvTimeoutAttempt(args))
			else:
				args: ChannelRecvTimeoutAttemptNoReleaseMaskArgs = {
					result_type = result_type,
					channel = channel,
					timeout = timeout_value,
					temp_seed = temp_seed,
					constructors = constructors
				}
				render_prepared_backend_op(BackendChannelRecvTimeoutAttemptNoReleaseMask(args))
		None:
			if value_constructor_uses_release_mask:
				args: ChannelTryRecvAttemptArgs = {
					result_type = result_type,
					channel = channel,
					temp_seed = temp_seed,
					release_policy = release_policy,
					constructors = constructors
				}
				render_prepared_backend_op(BackendChannelTryRecvAttempt(args))
			else:
				args: ChannelTryRecvAttemptNoReleaseMaskArgs = {
					result_type = result_type,
					channel = channel,
					temp_seed = temp_seed,
					constructors = constructors
				}
				render_prepared_backend_op(BackendChannelTryRecvAttemptNoReleaseMask(args))


private pure func emit_channel_attempt_return_function(
	func_info: CoreFunction,
	value: String,
) -> String:
	c_function_signature(func_info) + " {\n  return " + value + ";\n}\n"


private pure func emit_channel_attempt_user_function(
	decls: List[CoreDecl],
	func_info: CoreFunction,
) -> Option[String]:
	body ?= func_info.body
	type_name ?= union_type_name(func_info.return_type)
	union_decl ?= find_union_decl(decls, type_name)
	constructors: ChannelAttemptConstructors = channel_attempt_constructors(union_decl)
	temp_seed: String = func_info.def_id.to_string()

	match body:
		CallExpr(BuiltinCall(name), callee, args, typ, loc):
			arg_values ?= emit_simple_expr_arg_values(args)
			if name == "blorp_channel_send_timeout_attempt":
				match arg_values:
					[channel, value, timeout]:
						send_constructors ?= channel_send_attempt_constructors(constructors)
						rendered: String = emit_channel_send_attempt_value(
							c_type_name(func_info.return_type),
							channel,
							value,
							Some(timeout),
							temp_seed,
							send_constructors,
						)
						Some(emit_channel_attempt_return_function(func_info, rendered))
					[]:
						None
					[first]:
						None
					[first, second]:
						None
					[first, second, third, fourth, ...rest]:
						None
			else if name == "blorp_channel_try_send_attempt":
				match arg_values:
					[channel, value]:
						send_constructors ?= channel_send_attempt_constructors(constructors)
						rendered: String = emit_channel_send_attempt_value(
							c_type_name(func_info.return_type),
							channel,
							value,
							None,
							temp_seed,
							send_constructors,
						)
						Some(emit_channel_attempt_return_function(func_info, rendered))
					[]:
						None
					[first]:
						None
					[first, second, third, ...rest]:
						None
			else if name == "blorp_channel_recv_timeout_attempt":
				match arg_values:
					[channel, timeout]:
						match args:
							[channel_expr, timeout_expr]:
								elem_type ?= channel_element_type(core_expr_type(channel_expr))
								recv_constructors ?= channel_recv_attempt_constructors(
									constructors,
									constructors.recv_timed_out,
								)
								release_policy: ChannelRecvReleasePolicy = if boxed_value_needs_release_type(elem_type):
									ReleaseChannelRecvValue
								else:
									KeepChannelRecvValue
								rendered: String = emit_channel_recv_attempt_value(
									c_type_name(func_info.return_type),
									channel,
									Some(timeout),
									temp_seed,
									release_policy,
									recv_constructors,
									constructors.recv_value_uses_release_mask,
								)
								Some(emit_channel_attempt_return_function(func_info, rendered))
							[]:
								None
							[first]:
								None
							[first, second, third, ...rest]:
								None
					[]:
						None
					[first]:
						None
					[first, second, third, ...rest]:
						None
			else if name == "blorp_channel_try_recv_attempt":
				match arg_values:
					[channel]:
						match args:
							[channel_expr]:
								elem_type ?= channel_element_type(core_expr_type(channel_expr))
								recv_constructors ?= channel_recv_attempt_constructors(
									constructors,
									constructors.recv_would_block,
								)
								release_policy: ChannelRecvReleasePolicy = if boxed_value_needs_release_type(elem_type):
									ReleaseChannelRecvValue
								else:
									KeepChannelRecvValue
								rendered: String = emit_channel_recv_attempt_value(
									c_type_name(func_info.return_type),
									channel,
									None,
									temp_seed,
									release_policy,
									recv_constructors,
									constructors.recv_value_uses_release_mask,
								)
								Some(emit_channel_attempt_return_function(func_info, rendered))
							[]:
								None
							[first, second, ...rest]:
								None
					[]:
						None
					[first, second, ...rest]:
						None
			else:
				None
		CallExpr(kind, callee, args, typ, loc):
			None
		LiteralExpr(literal, typ, loc):
			None
		VarExpr(variable, typ, loc):
			None
		VoidExpr(typ, loc):
			None
		CooperativeCheckpointExpr(typ, loc):
			None
		BinaryExpr(op, left, right, typ, loc):
			None
		UnaryExpr(op, expr_value, typ, loc):
			None
		LogicalExpr(op, left, right, typ, loc):
			None
		AssignExpr(variable, rhs, typ, loc):
			None
		CastExpr(expr_value, typ, loc):
			None
		BoxExpr(box, typ, loc):
			None
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			None
		FieldExpr(expr_value, field_name, typ, loc):
			None
		TupleFieldExpr(expr_value, field_index, typ, loc):
			None
		TupleExpr(items, typ, loc):
			None
		TupleConstructExpr(tuple_construct, typ, loc):
			None
		ClosureCreateExpr(closure, typ, loc):
			None
		ListConstructExpr(construct, typ, loc):
			None
		ListAllocExpr(alloc, typ, loc):
			None
		ListGetExpr(get, typ, loc):
			None
		ListHandoffExpr(handoff, typ, loc):
			None
		ListHandoffSetOwnedExpr(set, typ, loc):
			None
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			None
		StringByteReadExpr(read, typ, loc):
			None
		StringByteWriteExpr(write, typ, loc):
			None
		StringByteCopyExpr(copy, typ, loc):
			None
		StringSetLenExpr(set_len, typ, loc):
			None
		TensorLiteralExpr(literal, typ, loc):
			None
		TensorBoxedLiteralExpr(literal, typ, loc):
			None
		TensorPackedLiteralExpr(literal, typ, loc):
			None
		TensorRawFillExpr(fill, typ, loc):
			None
		TensorRawReadExpr(read, typ, loc):
			None
		TensorRawWriteExpr(write, typ, loc):
			None
		TensorRawViewLetExpr(binding, body, typ, loc):
			None
		DictConstructExpr(construct, typ, loc):
			None
		SetAllocExpr(alloc, typ, loc):
			None
		ListRetainExpr(retain, typ, loc):
			None
		ListSetExpr(set, typ, loc):
			None
		RecordExpr(fields, typ, loc):
			None
		RecordConstructExpr(type_name, fields, typ, loc):
			None
		UnionConstructExpr(construct, typ, loc):
			None
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			None
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			None
		LetExpr(name, is_mutable, typ, rhs, body):
			None
		SeqExpr(first, second):
			None
		WhileExpr(cond, body, typ, loc):
			None
		BreakExpr(typ, loc):
			None
		ContinueExpr(typ, loc):
			None
		ResourceScopeExpr(scope, typ, loc):
			None
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			None
		TailrecLoopExpr(params, return_type, body, loc):
			None
		TailrecRecurExpr(args, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			None
		ForListExpr(for_list, typ, loc):
			None
		ForTensorExpr(for_tensor, typ, loc):
			None
		RangeExpr(start, end_value, typ, loc):
			None
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			None
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			None
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			None
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, default_body, typ, loc):
			None
		IfExpr(cond, then_expr, else_expr, typ, loc):
			None


private pure func emit_supported_user_function(decls: List[CoreDecl], func_info: CoreFunction) -> Option[String]:
	match emit_channel_attempt_user_function(decls, func_info):
		Some(c_code):
			Some(c_code)
		None:
			emit_general_supported_user_function(func_info)


private pure func emit_general_supported_user_function(func_info: CoreFunction) -> Option[String]:
	match func_info.body:
		Some(body):
			match emit_function_body(body, 0):
				Some(body_c):
					prefix: String = c_function_signature(func_info) + " {\n"
					body_prelude: String = entrypoint_arg_prelude(func_info)
					body_cleanup: String = entrypoint_arg_cleanup(func_info)

					global_init: String = if is_entrypoint(func_info):
						"  __blorp_init_globals();\n"
					else:
						""

					if is_void_type(func_info.return_type):
						if is_entrypoint(func_info):
							Some(
								prefix + global_init + body_prelude + discard_body(
									body_c,
								) + body_cleanup + "  return 0;\n}\n",
							)
						else:
							Some(prefix + body_prelude + discard_body(body_c) + "}\n")
					else:
						match required_body_value(body_c):
							Some(return_value):
								if entrypoint_has_source_args(func_info):
									Some(
										prefix + global_init + body_prelude + body_c.statements + "  long __blorp_main_result = (long)" + return_value + ";\n" + body_cleanup + "  return (int)__blorp_main_result;\n}\n",
									)
								else:
									Some(
										prefix + global_init + body_prelude + body_c.statements + "  return " + return_value + ";\n}\n",
									)
							None:
								if body_c.returns:
									Some(
										prefix + global_init + body_prelude + body_c.statements + "}\n",
									)
								else:
									None
				None:
					None
		None:
			None


private pure func emit_function(decls: List[CoreDecl], func_info: CoreFunction) -> String:
	match func_info.function_kind:
		UserFunction:
			match func_info.body:
				Some(body):
					match emit_supported_user_function(decls, func_info):
						Some(c_code):
							c_code
						None:
							emit_unsupported_function_error(func_info)
				None:
					emit_function_inventory(func_info)
		BuiltinFunction:
			emit_function_inventory(func_info)
		ForeignFunction:
			emit_function_inventory(func_info)
		ClosureBodyFunction(abi):
			match emit_closure_body_function(func_info, abi):
				Some(c_code):
					c_code
				None:
					emit_function_inventory(func_info)


private pure func emit_function_forward_decl(func_info: CoreFunction) -> String:
	match func_info.function_kind:
		UserFunction:
			match func_info.body:
				Some(body):
					if is_entrypoint(func_info):
						""
					else:
						c_function_signature(func_info) + ";\n"
				None:
					""
		BuiltinFunction:
			""
		ForeignFunction:
			""
		ClosureBodyFunction(abi):
			if abi.moved_captures.length() == 0 and not abi.task_abi:
				match func_info.body:
					Some(body):
						closure_body_signature(func_info, abi) + ";\n"
					None:
						""
			else:
				""


private pure func emit_static_closure_forward_decl(func_info: CoreFunction) -> String:
	match func_info.function_kind:
		ClosureBodyFunction(abi):
			if abi.captures.length() == 0:
				"static blorp_Closure " + static_closure_name(abi.c_name) + ";\n"
			else:
				""
		UserFunction:
			""
		BuiltinFunction:
			""
		ForeignFunction:
			""


private pure func emit_enum_variant(variant: CoreEnumVariant) -> String:
	"#define " + variant.c_name + " " + variant.tag.to_string() + "L\n"


private pure func enum_to_string_function_name(enum_decl: CoreEnumDecl) -> String:
	"__blorp_enum_to_string_" + c_identifier(enum_decl.name)


private pure func enum_vector_to_string_function_name(enum_decl: CoreEnumDecl) -> String:
	"blorp_vector_to_string_" + c_identifier(enum_decl.name)


private pure func emit_enum_to_string_case(variant: CoreEnumVariant) -> String:
	"    case " + variant.c_name + ": return blorp_string_literal(" + c_string_literal(
		variant.name,
	) + ");\n"


private pure func emit_enum_to_string_function(enum_decl: CoreEnumDecl) -> String:
	function_name: String = enum_to_string_function_name(enum_decl)
	var c_code: String = "static blorp_String* " + function_name + "(long v) {\n"
	c_code += "    switch (v) {\n"

	for variant in enum_decl.variants:
		c_code += emit_enum_to_string_case(variant)

	c_code += "    default: return blorp_to_string(v);\n"
	c_code += "    }\n"
	c_code += "}\n"
	c_code


private pure func emit_enum_vector_to_string_function(enum_decl: CoreEnumDecl) -> String:
	function_name: String = enum_vector_to_string_function_name(enum_decl)
	enum_to_string_name: String = enum_to_string_function_name(enum_decl)
	"blorp_String* " + function_name + "(blorp_Vector* v) {\n" + "    return blorp_vector_to_string_packed_enum(v, " + enum_to_string_name + ");\n" + "}\n"


private pure func emit_enum_decl(enum_decl: CoreEnumDecl) -> String:
	var c_code: String = ""

	for variant in enum_decl.variants:
		c_code += emit_enum_variant(variant)

	c_code += emit_enum_to_string_function(enum_decl)
	c_code += emit_enum_vector_to_string_function(enum_decl)
	c_code += "\n"

	c_code


private pure func emit_static_global_init_expr(init: CoreExpr) -> Option[String]:
	match init:
		LiteralExpr(literal, typ, loc):
			match literal:
				IntLiteral(value):
					Some(value.to_string() + "L")
				WideIntLiteral(value):
					Some(value + "L")
				FloatLiteral(value):
					emit_simple_expr(init)
				FloatTextLiteral(value):
					emit_simple_expr(init)
				FloatInfinityLiteral:
					emit_simple_expr(init)
				FloatNegInfinityLiteral:
					emit_simple_expr(init)
				FloatNanLiteral:
					emit_simple_expr(init)
				BoolLiteral(value):
					emit_simple_expr(init)
				CharLiteral(value):
					emit_simple_expr(init)
				StringLiteral(value):
					emit_simple_expr(init)
		VarExpr(variable, typ, loc):
			emit_simple_expr(init)
		VoidExpr(typ, loc):
			emit_simple_expr(init)
		CooperativeCheckpointExpr(typ, loc):
			emit_simple_expr(init)
		CallExpr(kind, callee, args, typ, loc):
			emit_simple_expr(init)
		BinaryExpr(op, left, right, typ, loc):
			emit_simple_expr(init)
		UnaryExpr(op, expr_value, typ, loc):
			emit_simple_expr(init)
		LogicalExpr(op, left, right, typ, loc):
			emit_simple_expr(init)
		AssignExpr(variable, rhs, typ, loc):
			emit_simple_expr(init)
		CastExpr(expr_value, typ, loc):
			emit_simple_expr(init)
		BoxExpr(box, typ, loc):
			emit_simple_expr(init)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			emit_simple_expr(init)
		FieldExpr(expr_value, field_name, typ, loc):
			emit_simple_expr(init)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			emit_simple_expr(init)
		TupleExpr(items, typ, loc):
			emit_simple_expr(init)
		TupleConstructExpr(tuple_construct, typ, loc):
			emit_simple_expr(init)
		ClosureCreateExpr(closure, typ, loc):
			None
		ListConstructExpr(construct, typ, loc):
			None
		ListAllocExpr(alloc, typ, loc):
			None
		ListGetExpr(get, typ, loc):
			None
		ListHandoffExpr(handoff, typ, loc):
			None
		ListHandoffSetOwnedExpr(set, typ, loc):
			None
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			None
		StringByteReadExpr(read, typ, loc):
			emit_simple_expr(init)
		StringByteWriteExpr(write, typ, loc):
			emit_simple_expr(init)
		StringByteCopyExpr(copy, typ, loc):
			None
		StringSetLenExpr(set_len, typ, loc):
			None
		TensorLiteralExpr(literal, typ, loc):
			None
		TensorBoxedLiteralExpr(literal, typ, loc):
			None
		TensorPackedLiteralExpr(literal, typ, loc):
			None
		TensorRawFillExpr(fill, typ, loc):
			None
		TensorRawReadExpr(read, typ, loc):
			emit_simple_expr(init)
		TensorRawWriteExpr(write, typ, loc):
			emit_simple_expr(init)
		TensorRawViewLetExpr(binding, body, typ, loc):
			None
		DictConstructExpr(construct, typ, loc):
			None
		SetAllocExpr(alloc, typ, loc):
			None
		ListRetainExpr(retain, typ, loc):
			None
		ListSetExpr(set, typ, loc):
			None
		RecordExpr(fields, typ, loc):
			emit_simple_expr(init)
		RecordConstructExpr(type_name, fields, typ, loc):
			emit_simple_expr(init)
		UnionConstructExpr(construct, typ, loc):
			None
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			emit_simple_expr(init)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			emit_simple_expr(init)
		LetExpr(name, is_mutable, typ, rhs, body):
			emit_simple_expr(init)
		SeqExpr(first, second):
			emit_simple_expr(init)
		WhileExpr(cond, body, typ, loc):
			emit_simple_expr(init)
		BreakExpr(typ, loc):
			emit_simple_expr(init)
		ContinueExpr(typ, loc):
			emit_simple_expr(init)
		ResourceScopeExpr(scope, typ, loc):
			emit_simple_expr(init)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			emit_simple_expr(init)
		TailrecLoopExpr(params, return_type, body, loc):
			emit_simple_expr(init)
		TailrecRecurExpr(args, typ, loc):
			emit_simple_expr(init)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			emit_simple_expr(init)
		ForListExpr(for_list, typ, loc):
			emit_simple_expr(init)
		ForTensorExpr(for_tensor, typ, loc):
			emit_simple_expr(init)
		RangeExpr(start, end_value, typ, loc):
			emit_simple_expr(init)
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			emit_simple_expr(init)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			emit_simple_expr(init)
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			emit_simple_expr(init)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, default_body, typ, loc):
			emit_simple_expr(init)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			emit_simple_expr(init)


