-- Pure compiler bridge dispatcher for Blorp-owned compiler slices.
--
-- This module deliberately keeps command I/O out. The public handlers accept
-- JSON values/strings and return JSON response values/strings so the eventual
-- command wrapper is a thin stdin/stdout perimeter around pure compiler code.
import:
	codegen_intrinsic_renderer as Intrinsic
	codegen_prepared_backend_renderer as PreparedBackend
	codegen_prepared_constructor_renderer as PreparedConstructor
	codegen_prepared_list_renderer as PreparedList
	codegen_prepared_tensor_renderer as PreparedTensor
	codegen_prepared_tuple_renderer as PreparedTuple
	compiler_artifact_json: CArtifact, c_artifact_to_json
	compiler_bridge_protocol:
		BRIDGE_SCHEMA_VERSION,
		BridgeAction(
			CompileSourceAction,
			EmitPostClosureCAction,
			LowerAndCompileAction,
			ParseSourceAction,
			ParseSourcesAction,
			PrepareAndEmitCAction,
			RendererTemplatesAction,
			RenderManyAction,
			RunCliAction,
			RunCorePipelineAction,
			TypecheckAndCompileAction,
		),
		BridgeEnvelope,
		BridgeProtocolError(InvalidJson),
		bridge_action_name,
		bridge_error_json,
		bridge_success_json,
		decode_bridge_envelope_value,
	compiler_core_emit:
		core_emit_error_to_string,
		try_emit_post_closure_core_program_c_artifact_with_options,
		try_emit_prepared_core_program_c_artifact_with_options,
	compiler_core_json:
		CoreProgram,
		core_json_error_to_string,
		core_program_to_json,
		decode_core_program_json,
	compiler_core_pipeline as CorePipeline
	core_error_format as CoreError
	core_fairness_policy as CoreFairness
	core_profile_format as CoreProfile
	core_stage_manifest as CoreStage
	core_trait_resolve_diagnostics as CoreTraitResolve
	json:
		JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_string,
		get_field,
		parse_json,
	language_surface_manifest as LanguageSurface


enum BridgeRenderer:
	CoreErrorRenderer
	CoreFairnessRenderer
	CoreProfileRenderer
	CoreStageRenderer
	CoreTraitResolveRenderer
	LanguageSurfaceRenderer


enum BridgeTemplateRenderer:
	IntrinsicTemplateRenderer
	PreparedBackendTemplateRenderer
	PreparedListTemplateRenderer
	PreparedTensorTemplateRenderer
	PreparedConstructorTemplateRenderer
	PreparedTupleTemplateRenderer
	CoreErrorTemplateRenderer
	CoreFairnessTemplateRenderer
	CoreProfileTemplateRenderer
	CoreStageTemplateRenderer
	CoreTraitResolveTemplateRenderer
	LanguageSurfaceTemplateRenderer


record RenderItem {
	op: String,
	args: List[String]
}


union BridgeDispatchError:
	ProtocolError(BridgeProtocolError)
	MissingStringField(String)
	ExpectedRequestField(String, String)
	UnsupportedRenderer(String)
	UnsupportedBridgeAction(BridgeAction)
	CoreJsonFailure(String)
	EmitFailure(String)
	RenderFailure(String)


private pure func owned_string(text: String) -> String:
	text.substring(0, text.length())


private pure func owned_json(value: JsonValue) -> JsonValue:
	match value:
		JsonNull:
			JsonNull
		JsonBool(flag):
			JsonBool(flag)
		JsonNumber(number):
			JsonNumber(number)
		JsonString(text):
			JsonString(owned_string(text))
		JsonVector(items):
			var owned_items: List[JsonValue] = []

			for item in items:
				owned_items = owned_items.append(owned_json(item))

			JsonVector(owned_items)
		JsonObject(fields):
			var owned_fields: List[(String, JsonValue)] = []

			for field in fields:
				owned_fields = owned_fields.append((owned_string(field[0]), owned_json(field[1])))

			JsonObject(owned_fields)


private pure func schema_json() -> JsonValue:
	JsonNumber(to_float(BRIDGE_SCHEMA_VERSION))


private pure func success_json(fields: List[(String, JsonValue)]) -> JsonValue:
	var result: List[(String, JsonValue)] = [("schema", schema_json()), ("ok", JsonBool(True))]

	for field in fields:
		result = result.append((owned_string(field[0]), owned_json(field[1])))

	JsonObject(result)


private pure func dispatch_error_code(error: BridgeDispatchError) -> String:
	match error:
		ProtocolError(_):
			"invalid_request"
		MissingStringField(_):
			"invalid_request"
		ExpectedRequestField(_, _):
			"invalid_request"
		UnsupportedRenderer(_):
			"unsupported_renderer"
		UnsupportedBridgeAction(_):
			"unsupported_action"
		CoreJsonFailure(_):
			"invalid_request"
		EmitFailure(_):
			"emit_error"
		RenderFailure(_):
			"render_error"


private pure func dispatch_error_message(error: BridgeDispatchError) -> String:
	match error:
		ProtocolError(_):
			"invalid bridge request"
		MissingStringField(field_name):
			"missing string field `${field_name}`"
		ExpectedRequestField(field_name, expected):
			"field `${field_name}` must be ${expected}"
		UnsupportedRenderer(renderer):
			"unsupported Blorp renderer: ${renderer}"
		UnsupportedBridgeAction(action):
			"unsupported Blorp bridge renderer action: ${bridge_action_name(action)}"
		CoreJsonFailure(message):
			message
		EmitFailure(message):
			message
		RenderFailure(message):
			message


private pure func dispatch_error_json(error: BridgeDispatchError) -> JsonValue:
	match error:
		ProtocolError(protocol_error):
			bridge_error_json(protocol_error)
		_:
			JsonObject([("schema", schema_json()), ("ok", JsonBool(False)), ("error", JsonObject([
						("code", JsonString(dispatch_error_code(error))),
						("message", JsonString(dispatch_error_message(error))),
					]))])


private pure func parse_renderer(name: String) -> Result[BridgeRenderer, BridgeDispatchError]:
	match name:
		"core_error":
			Ok(CoreErrorRenderer)
		"core_fairness":
			Ok(CoreFairnessRenderer)
		"core_profile":
			Ok(CoreProfileRenderer)
		"core_stage":
			Ok(CoreStageRenderer)
		"core_trait_resolve":
			Ok(CoreTraitResolveRenderer)
		"language_surface":
			Ok(LanguageSurfaceRenderer)
		_:
			Err(UnsupportedRenderer(name))


private pure func parse_template_renderer(
	name: String,
) -> Result[BridgeTemplateRenderer, BridgeDispatchError]:
	match name:
		"intrinsic":
			Ok(IntrinsicTemplateRenderer)
		"prepared_backend":
			Ok(PreparedBackendTemplateRenderer)
		"prepared_list":
			Ok(PreparedListTemplateRenderer)
		"prepared_tensor":
			Ok(PreparedTensorTemplateRenderer)
		"prepared_constructor":
			Ok(PreparedConstructorTemplateRenderer)
		"prepared_tuple":
			Ok(PreparedTupleTemplateRenderer)
		"core_error":
			Ok(CoreErrorTemplateRenderer)
		"core_fairness":
			Ok(CoreFairnessTemplateRenderer)
		"core_profile":
			Ok(CoreProfileTemplateRenderer)
		"core_stage":
			Ok(CoreStageTemplateRenderer)
		"core_trait_resolve":
			Ok(CoreTraitResolveTemplateRenderer)
		"language_surface":
			Ok(LanguageSurfaceTemplateRenderer)
		_:
			Err(UnsupportedRenderer(name))


private pure func request_body(envelope: BridgeEnvelope) -> JsonValue:
	envelope.payload


private pure func string_field(
	value: JsonValue,
	field_name: String,
) -> Result[String, BridgeDispatchError]:
	field ?= get_field(value, field_name).to_result(MissingStringField(field_name))
	as_string(field)
		.map(owned_string)
		.to_result(ExpectedRequestField(field_name, "a string"))


private pure func strings_from_json_array(
	items: List[JsonValue],
	field_name: String,
) -> Result[List[String], BridgeDispatchError]:
	strings_from_json_array_at(items, field_name, 0, [])


private pure func string_from_json_array_item(
	item: JsonValue,
	field_name: String,
) -> Result[String, BridgeDispatchError]:
	text ?= as_string(item).to_result(ExpectedRequestField(field_name, "an array of strings"))
	Ok(owned_string(text))


private pure func strings_from_json_array_at(
	items: List[JsonValue],
	field_name: String,
	index: Int,
	result: List[String],
) -> Result[List[String], BridgeDispatchError]:
	match items.get(index):
		Some(item):
			text ?= string_from_json_array_item(item, field_name)
			strings_from_json_array_at(
				items,
				field_name,
				index + 1,
				result.append(text),
			)
		None:
			Ok(result)


private pure func string_array_field(
	value: JsonValue,
	field_name: String,
) -> Result[List[String], BridgeDispatchError]:
	match get_field(value, field_name):
		Some(field):
			items ?= as_array(field).to_result(ExpectedRequestField(field_name, "an array"))
			strings_from_json_array(items, field_name)
		None:
			Ok([])


private pure func optional_bool_field(
	value: JsonValue,
	field_name: String,
	default_value: Bool,
) -> Result[Bool, BridgeDispatchError]:
	match get_field(value, field_name):
		Some(field):
			match field:
				JsonBool(flag):
					Ok(flag)
				JsonNull:
					Err(ExpectedRequestField(field_name, "a boolean"))
				JsonNumber(number):
					Err(ExpectedRequestField(field_name, "a boolean"))
				JsonString(text):
					Err(ExpectedRequestField(field_name, "a boolean"))
				JsonVector(items):
					Err(ExpectedRequestField(field_name, "a boolean"))
				JsonObject(fields):
					Err(ExpectedRequestField(field_name, "a boolean"))
		None:
			Ok(default_value)


private pure func json_field(
	value: JsonValue,
	field_name: String,
	expected: String,
) -> Result[JsonValue, BridgeDispatchError]:
	get_field(value, field_name).to_result(ExpectedRequestField(field_name, expected))


private pure func render_item_value(value: JsonValue) -> Result[RenderItem, BridgeDispatchError]:
	op ?= string_field(value, "op")
	args ?= string_array_field(value, "args")

	Ok({
		op = op,
		args = args,
	})


private pure func render_items_from_json_array(
	items: List[JsonValue],
) -> Result[List[RenderItem], BridgeDispatchError]:
	render_items_from_json_array_at(items, 0, [])


private pure func render_items_from_json_array_at(
	items: List[JsonValue],
	index: Int,
	result: List[RenderItem],
) -> Result[List[RenderItem], BridgeDispatchError]:
	match items.get(index):
		Some(item):
			render_item ?= render_item_value(item)
			render_items_from_json_array_at(
				items,
				index + 1,
				result.append(render_item),
			)
		None:
			Ok(result)


private pure func render_items_field(
	value: JsonValue,
	field_name: String,
) -> Result[List[RenderItem], BridgeDispatchError]:
	match get_field(value, field_name):
		Some(field):
			items ?= as_array(field).to_result(ExpectedRequestField(field_name, "an array"))
			render_items_from_json_array(items)
		None:
			Ok([])


private pure func renderer_from_request(
	body: JsonValue,
) -> Result[BridgeRenderer, BridgeDispatchError]:
	renderer_name ?= string_field(body, "renderer")
	parse_renderer(renderer_name)


private pure func template_renderer_from_request(
	body: JsonValue,
) -> Result[BridgeTemplateRenderer, BridgeDispatchError]:
	renderer_name ?= string_field(body, "renderer")
	parse_template_renderer(renderer_name)


private pure func render_with(
	renderer: BridgeRenderer,
	op: String,
	args: List[String],
) -> Result[String, BridgeDispatchError]:
	match renderer:
		CoreErrorRenderer:
			match CoreError.render_core_error(op, args):
				Ok(text):
					Ok(text)
				Err(error):
					Err(RenderFailure(CoreError.render_error_to_string(error)))
		CoreFairnessRenderer:
			match CoreFairness.render_fairness(op, args):
				Ok(text):
					Ok(text)
				Err(error):
					Err(RenderFailure(CoreFairness.render_error_to_string(error)))
		CoreProfileRenderer:
			match CoreProfile.render_core_profile(op, args):
				Ok(text):
					Ok(text)
				Err(error):
					Err(RenderFailure(CoreProfile.render_error_to_string(error)))
		CoreStageRenderer:
			match CoreStage.render_core_stage(op, args):
				Ok(text):
					Ok(text)
				Err(error):
					Err(RenderFailure(CoreStage.render_error_to_string(error)))
		CoreTraitResolveRenderer:
			match CoreTraitResolve.render_core_trait_resolve(op, args):
				Ok(text):
					Ok(text)
				Err(error):
					Err(RenderFailure(CoreTraitResolve.render_error_to_string(error)))
		LanguageSurfaceRenderer:
			match LanguageSurface.render_language_surface(op, args):
				Ok(text):
					Ok(text)
				Err(error):
					Err(RenderFailure(LanguageSurface.render_error_to_string(error)))


private pure func renderer_template_json(name: String, arity: Int) -> JsonValue:
	JsonObject([
		("op", JsonString(owned_string(name))),
		("arity", JsonNumber(to_float(arity))),
	])


private pure func renderer_templates(renderer: BridgeTemplateRenderer) -> List[JsonValue]:
	var items: List[JsonValue] = []

	match renderer:
		IntrinsicTemplateRenderer:
			for intrinsic in Intrinsic.ALL_INTRINSICS:
				items = items.append(
					renderer_template_json(
						Intrinsic.intrinsic_name(intrinsic),
						Intrinsic.intrinsic_arity(intrinsic),
					),
				)
		PreparedBackendTemplateRenderer:
			for info in PreparedBackend.ALL_TEMPLATES:
				items = items.append(
					renderer_template_json(
						PreparedBackend.prepared_backend_template_name(info),
						PreparedBackend.prepared_backend_template_arity(info),
					),
				)
		PreparedListTemplateRenderer:
			for info in PreparedList.ALL_TEMPLATES:
				items = items.append(
					renderer_template_json(
						PreparedList.prepared_list_template_name(info),
						PreparedList.prepared_list_template_arity(info),
					),
				)
		PreparedTensorTemplateRenderer:
			for info in PreparedTensor.ALL_TEMPLATES:
				items = items.append(
					renderer_template_json(
						PreparedTensor.prepared_tensor_template_name(info),
						PreparedTensor.prepared_tensor_template_arity(info),
					),
				)
		PreparedConstructorTemplateRenderer:
			for info in PreparedConstructor.ALL_TEMPLATES:
				items = items.append(
					renderer_template_json(
						PreparedConstructor.prepared_constructor_template_name(info),
						PreparedConstructor.prepared_constructor_template_arity(info),
					),
				)
		PreparedTupleTemplateRenderer:
			for info in PreparedTuple.ALL_TEMPLATES:
				items = items.append(
					renderer_template_json(
						PreparedTuple.prepared_tuple_template_name(info),
						PreparedTuple.prepared_tuple_template_arity(info),
					),
				)
		CoreErrorTemplateRenderer:
			for info in CoreError.ALL_TEMPLATES:
				items = items.append(
					renderer_template_json(
						CoreError.core_error_template_name(info),
						CoreError.core_error_template_arity(info),
					),
				)
		CoreFairnessTemplateRenderer:
			for info in CoreFairness.ALL_TEMPLATES:
				items = items.append(
					renderer_template_json(
						CoreFairness.fairness_template_name(info),
						CoreFairness.fairness_template_arity(info),
					),
				)
		CoreProfileTemplateRenderer:
			for info in CoreProfile.ALL_TEMPLATES:
				items = items.append(
					renderer_template_json(
						CoreProfile.core_profile_template_name(info),
						CoreProfile.core_profile_template_arity(info),
					),
				)
		CoreStageTemplateRenderer:
			for info in CoreStage.ALL_TEMPLATES:
				items = items.append(
					renderer_template_json(
						CoreStage.core_stage_template_name(info),
						CoreStage.core_stage_template_arity(info),
					),
				)
		CoreTraitResolveTemplateRenderer:
			for info in CoreTraitResolve.ALL_TEMPLATES:
				items = items.append(
					renderer_template_json(
						CoreTraitResolve.core_trait_resolve_template_name(info),
						CoreTraitResolve.core_trait_resolve_template_arity(info),
					),
				)
		LanguageSurfaceTemplateRenderer:
			for info in LanguageSurface.ALL_TEMPLATES:
				items = items.append(
					renderer_template_json(
						LanguageSurface.language_surface_template_name(info),
						LanguageSurface.language_surface_template_arity(info),
					),
				)

	items


private pure func handle_renderer_templates(
	body: JsonValue,
) -> Result[JsonValue, BridgeDispatchError]:
	renderer ?= template_renderer_from_request(body)
	Ok(success_json([("items", JsonVector(renderer_templates(renderer)))]))


private pure func rendered_item_json(
	renderer: BridgeRenderer,
	item: RenderItem,
) -> Result[JsonValue, BridgeDispatchError]:
	text ?= render_with(renderer, item.op, item.args)

	Ok(JsonObject([
		("op", JsonString(owned_string(item.op))),
		("text", JsonString(owned_string(text))),
	]))


private pure func rendered_items_json_at(
	renderer: BridgeRenderer,
	items: List[RenderItem],
	index: Int,
	rendered: List[JsonValue],
) -> Result[List[JsonValue], BridgeDispatchError]:
	match items.get(index):
		Some(item):
			rendered_item ?= rendered_item_json(renderer, item)
			rendered_items_json_at(
				renderer,
				items,
				index + 1,
				rendered.append(rendered_item),
			)
		None:
			Ok(rendered)


private pure func rendered_items_json(
	renderer: BridgeRenderer,
	items: List[RenderItem],
) -> Result[List[JsonValue], BridgeDispatchError]:
	rendered_items_json_at(renderer, items, 0, [])


private pure func handle_render_many(body: JsonValue) -> Result[JsonValue, BridgeDispatchError]:
	renderer ?= renderer_from_request(body)
	items ?= render_items_field(body, "items")
	rendered ?= rendered_items_json(renderer, items)

	Ok(success_json([("items", JsonVector(rendered))]))


private pure func decode_core_program_for_bridge(
	core_json: JsonValue,
) -> Result[CoreProgram, BridgeDispatchError]:
	decode_core_program_json(
		core_json,
	).map_err(
		func(error): CoreJsonFailure(core_json_error_to_string(error)),
	)


private pure func emit_post_closure_c_artifact_for_bridge(
	program: CoreProgram,
	profile: Bool,
) -> Result[CArtifact, BridgeDispatchError]:
	try_emit_post_closure_core_program_c_artifact_with_options(
		program,
		{profile = profile},
	).map_err(
		func(error): EmitFailure(core_emit_error_to_string(error)),
	)


private pure func prepare_and_emit_c_artifact_for_bridge(
	program: CoreProgram,
	profile: Bool,
) -> Result[CArtifact, BridgeDispatchError]:
	prepared_program: CoreProgram = CorePipeline.run_post_closure_tail(program)
	try_emit_prepared_core_program_c_artifact_with_options(
		prepared_program,
		{profile = profile},
	).map_err(
		func(error): EmitFailure(core_emit_error_to_string(error)),
	)


private pure func handle_emit_post_closure_c(
	body: JsonValue,
) -> Result[JsonValue, BridgeDispatchError]:
	core_json ?= json_field(body, "core", "Core program JSON")
	profile ?= optional_bool_field(body, "profile", False)
	program ?= decode_core_program_for_bridge(core_json)
	artifact ?= emit_post_closure_c_artifact_for_bridge(program, profile)

	Ok(bridge_success_json(c_artifact_to_json(artifact)))


private pure func handle_prepare_and_emit_c(
	body: JsonValue,
) -> Result[JsonValue, BridgeDispatchError]:
	core_json ?= json_field(body, "core", "Core program JSON")
	profile ?= optional_bool_field(body, "profile", False)
	program ?= decode_core_program_json(
		core_json,
	).map_err(
		func(error): CoreJsonFailure(core_json_error_to_string(error)),
	)
	artifact ?= prepare_and_emit_c_artifact_for_bridge(program, profile)

	Ok(bridge_success_json(c_artifact_to_json(artifact)))


private pure func handle_run_core_pipeline(
	body: JsonValue,
) -> Result[JsonValue, BridgeDispatchError]:
	stage_name ?= string_field(body, "stage")
	core_json ?= json_field(body, "core", "Core program JSON")
	stage ?= CorePipeline
		.parse_core_pipeline_stage(stage_name)
		.to_result(ExpectedRequestField("stage", "a supported Core pipeline stage"))
	program ?= decode_core_program_json(
		core_json,
	).map_err(
		func(error): CoreJsonFailure(core_json_error_to_string(error)),
	)
	transformed = CorePipeline.run_core_pipeline_stage(stage, program)

	Ok(success_json([("core", core_program_to_json(transformed))]))


private pure func handle_envelope(
	envelope: BridgeEnvelope,
) -> Result[JsonValue, BridgeDispatchError]:
	body: JsonValue = request_body(envelope)

	match envelope.action:
		RenderManyAction:
			handle_render_many(body)
		RendererTemplatesAction:
			handle_renderer_templates(body)
		PrepareAndEmitCAction:
			handle_prepare_and_emit_c(body)
		EmitPostClosureCAction:
			handle_emit_post_closure_c(body)
		RunCorePipelineAction:
			handle_run_core_pipeline(body)
		RunCliAction:
			Err(UnsupportedBridgeAction(envelope.action))
		ParseSourceAction:
			Err(UnsupportedBridgeAction(envelope.action))
		ParseSourcesAction:
			Err(UnsupportedBridgeAction(envelope.action))
		LowerAndCompileAction:
			Err(UnsupportedBridgeAction(envelope.action))
		TypecheckAndCompileAction:
			Err(UnsupportedBridgeAction(envelope.action))
		CompileSourceAction:
			Err(UnsupportedBridgeAction(envelope.action))


pure func handle_request_value(root: JsonValue) -> JsonValue:
	match decode_bridge_envelope_value(root):
		Ok(envelope):
			handle_envelope(envelope).get_or_else(dispatch_error_json)
		Err(error):
			bridge_error_json(error)


pure func handle_request(source: String) -> String:
	parse_json(source)
		.map(func(root): handle_request_value(root).to_string())
		.get_or_else(func(message): bridge_error_json(InvalidJson(message)).to_string())
