import:
	compiler_bridge: handle_request
	fs: message, open_read
	io: print_error


func read_request(path: String) -> Result[String, String]:
	with reader ?= open_read(path) on err => message(err):
		match reader.read_text():
			Ok(request):
				Ok(request)
			Err(err):
				Err(message(err))


func main(args: List[String]) -> Int:
	if args.length() != 2:
		print_error("Usage: compiler_bridge_cli <request.json>")
		1
	else:
		path: String = args
			.get(1)
			.get_or("")

		match read_request(path):
			Ok(request):
				print(handle_request(request))
				0
			Err(message):
				print_error(message)
				1
