-- Core representation preparation for the Blorp-owned compiler tail.
--
-- This pass keeps backend-specific shape normalization out of C emission.
-- The emitter should consume prepared Core instead of discovering source-level
-- constructs such as record literals and primitive tuple literals itself.
import:
	compiler_core_json:
		CoreBoxOp,
		CoreBoxedStorageValue,
		CoreCallKind(BuiltinCall, ClosureCall, ForeignCall, IntrinsicCall, UserCall),
        CoreConstructorMatchCase,
        CoreConstructorMatchFallback(ConstructorMatchFallbackBody, ConstructorMatchFallbackFail),
        CoreDecl(EnumDecl, FunctionDecl, GlobalDecl, HeapRecordDecl, UnionDecl, ValueRecordDecl),
        CoreDictConstruct,
		CoreDictEntry,
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			BoxExpr,
			BreakExpr,
			CastExpr,
			CallExpr,
			ClosureCreateExpr,
			ConstructorMatchExpr,
			ContinueExpr,
			CooperativeCheckpointExpr,
			DictConstructExpr,
			DupExpr,
			DropExpr,
			FieldExpr,
			ForListExpr,
			ForRangeExpr,
			IfExpr,
			LetExpr,
			ListAllocExpr,
			ListConstructExpr,
			ListGetExpr,
			ListHandoffExpr,
			ListHandoffSetOwnedExpr,
			ListHandoffSetSourceSlotExpr,
			ListRetainExpr,
			ListSetExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			RangeExpr,
			RecordExpr,
			RecordConstructExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SeqExpr,
			SetAllocExpr,
			StringByteCopyExpr,
			StringByteReadExpr,
			StringByteWriteExpr,
			StringSetLenExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			TensorRawReadExpr,
			TensorRawViewLetExpr,
			TensorRawWriteExpr,
			TupleExpr,
			TupleConstructExpr,
			TupleFieldExpr,
			UnaryExpr,
			UnionConstructExpr,
			VarExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreGlobal,
		CoreHeapRecordDecl,
		CoreListAlloc,
		CoreListConstruct,
		CoreListGet,
		CoreListHandoff,
		CoreListHandoffSetSourceSlot,
		CoreListRetain,
		CoreListSet,
		CoreLiteral(BoolLiteral, CharLiteral, FloatLiteral, IntLiteral, StringLiteral),
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(LiteralMatchFallbackBody, LiteralMatchFallbackFail),
		CoreProgram,
		CoreRecordFieldValue,
		CoreSetAlloc,
		CoreSourceLoc,
		CoreStackOptionRepresentation,
		CoreStringByteCopy,
		CoreStringByteRead,
		CoreStringByteWrite,
		CoreStringSetLen,
		CoreTensorRawRead,
		CoreTensorRawViewBinding,
		CoreTensorRawWrite,
		CoreTupleElement(TuplePointerElement, TuplePrimElement, TupleVoidElement),
        CoreType(EnumType, HeapRecordType, NamedType, RangeType, TupleType, UnionType, ValueRecordType, VoidType),
		CoreUnionConstruct,
		CoreUnionDecl,
		CoreUnionRepresentation(GenericUnionRepresentation, StackOptionRepresentation),
		CoreUnionVariant,
		CoreValueRecordDecl,


record PreparedTupleLiteral {
	elements: List[CoreTupleElement],
	release_mask: Int,
	retain_mask: Int
}


private STACK_OPTION_SOME_TAG: Int = 0

private STACK_OPTION_NONE_TAG: Int = 1


private pure func find_value_record_decl(
	decls: List[CoreDecl],
	name: String,
) -> Option[CoreValueRecordDecl]:
	var result: Option[CoreValueRecordDecl] = None

	for decl in decls:
		match decl:
			ValueRecordDecl(record_decl):
				if record_decl.name == name:
					result = Some(record_decl)
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void
			HeapRecordDecl(record_decl):
				void
			EnumDecl(enum_decl):
				void
			UnionDecl(union_decl):
				void

	result


private pure func find_heap_record_decl(
	decls: List[CoreDecl],
	name: String,
) -> Option[CoreHeapRecordDecl]:
	var result: Option[CoreHeapRecordDecl] = None

	for decl in decls:
		match decl:
			HeapRecordDecl(record_decl):
				if record_decl.name == name:
					result = Some(record_decl)
			ValueRecordDecl(record_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void
			EnumDecl(enum_decl):
				void
			UnionDecl(union_decl):
				void

	result


private pure func find_union_decl(decls: List[CoreDecl], name: String) -> Option[CoreUnionDecl]:
	var result: Option[CoreUnionDecl] = None

	for decl in decls:
		match decl:
			UnionDecl(union_decl):
				if union_decl.name == name:
					result = Some(union_decl)
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void
			EnumDecl(enum_decl):
				void

	result


private pure func find_union_variant(
	union_decl: CoreUnionDecl,
	constructor_name: String,
) -> Option[CoreUnionVariant]:
	var result: Option[CoreUnionVariant] = None

	for variant in union_decl.variants:
		if variant.name == constructor_name:
			result = Some(variant)

	result


private pure func find_record_field(
	fields: List[CoreRecordFieldValue],
	name: String,
) -> Option[CoreRecordFieldValue]:
	var result: Option[CoreRecordFieldValue] = None

	for field in fields:
		if field.name == name:
			result = Some(field)

	result


private pure func order_value_record_fields(
	record_decl: CoreValueRecordDecl,
	fields: List[CoreRecordFieldValue],
) -> Option[List[CoreRecordFieldValue]]:
	var ordered: List[CoreRecordFieldValue] = []
	var found_all_fields: Bool = True

	for field_decl in record_decl.fields:
		match find_record_field(fields, field_decl.name):
			Some(field):
				ordered = ordered.append(field)
			None:
				found_all_fields = False

	if found_all_fields and ordered.length() == fields.length():
		Some(ordered)
	else:
		None


private pure func order_heap_record_fields(
	record_decl: CoreHeapRecordDecl,
	fields: List[CoreRecordFieldValue],
) -> Option[List[CoreRecordFieldValue]]:
	var ordered: List[CoreRecordFieldValue] = []
	var found_all_fields: Bool = True

	for field_decl in record_decl.fields:
		match find_record_field(fields, field_decl.name):
			Some(field):
				ordered = ordered.append(field)
			None:
				found_all_fields = False

	if found_all_fields and ordered.length() == fields.length():
		Some(ordered)
	else:
		None


private pure func prepare_exprs(decls: List[CoreDecl], exprs: List[CoreExpr]) -> List[CoreExpr]:
	var prepared: List[CoreExpr] = []

	for expr in exprs:
		prepared = prepared.append(prepare_expr(decls, expr))

	prepared


private pure func prepare_tuple_elements(
	decls: List[CoreDecl],
	elements: List[CoreTupleElement],
) -> List[CoreTupleElement]:
	var prepared: List[CoreTupleElement] = []

	for element in elements:
		match element:
			TuplePrimElement(value):
				prepared = prepared.append(TuplePrimElement(prepare_expr(decls, value)))
			TuplePointerElement(value):
				prepared = prepared.append(TuplePointerElement(prepare_expr(decls, value)))
			TupleVoidElement:
				prepared = prepared.append(TupleVoidElement)

	prepared


private pure func prepare_boxed_storage_value(
	decls: List[CoreDecl],
	value: CoreBoxedStorageValue,
) -> CoreBoxedStorageValue:
	{
		kind = value.kind,
		value = prepare_expr(decls, value.value),
		needs_release = value.needs_release,
		transfers_ownership = value.transfers_ownership
	}


private pure func prepare_box_op(decls: List[CoreDecl], box: CoreBoxOp) -> CoreBoxOp:
	{
		kind = box.kind,
		value = prepare_expr(decls, box.value),
		source_type = box.source_type
	}


private pure func prepare_boxed_storage_values(
	decls: List[CoreDecl],
	values: List[CoreBoxedStorageValue],
) -> List[CoreBoxedStorageValue]:
	var prepared: List[CoreBoxedStorageValue] = []

	for value in values:
		prepared = prepared.append(prepare_boxed_storage_value(decls, value))

	prepared


private pure func prepare_dict_entry(decls: List[CoreDecl], entry: CoreDictEntry) -> CoreDictEntry:
	{
		key = prepare_boxed_storage_value(decls, entry.key),
		value = prepare_boxed_storage_value(decls, entry.value)
	}


private pure func prepare_dict_entries(
	decls: List[CoreDecl],
	entries: List[CoreDictEntry],
) -> List[CoreDictEntry]:
	var prepared: List[CoreDictEntry] = []

	for entry in entries:
		prepared = prepared.append(prepare_dict_entry(decls, entry))

	prepared


private pure func prepare_dict_construct(
	decls: List[CoreDecl],
	construct: CoreDictConstruct,
) -> CoreDictConstruct:
	{
		constructor = construct.constructor,
		entries = prepare_dict_entries(decls, construct.entries),
		value_needs_release = construct.value_needs_release
	}


private pure func prepare_set_alloc(alloc: CoreSetAlloc) -> CoreSetAlloc:
	alloc


private pure func prepare_list_construct(
	decls: List[CoreDecl],
	construct: CoreListConstruct,
) -> CoreListConstruct:
	{
		layout = construct.layout,
		elements = prepare_boxed_storage_values(decls, construct.elements),
		elem_needs_release = construct.elem_needs_release
	}


private pure func prepare_list_alloc(decls: List[CoreDecl], alloc: CoreListAlloc) -> CoreListAlloc:
	{
		layout = alloc.layout,
		capacity = prepare_expr(decls, alloc.capacity),
		elem_needs_release = alloc.elem_needs_release
	}


private pure func prepare_list_get(decls: List[CoreDecl], get: CoreListGet) -> CoreListGet:
	{
		layout = get.layout,
		list = prepare_expr(decls, get.list),
		index = prepare_expr(decls, get.index),
		bounds = get.bounds
	}


private pure func prepare_list_handoff(
	decls: List[CoreDecl],
	handoff: CoreListHandoff,
) -> CoreListHandoff:
	{
		mode = handoff.mode,
		layout = handoff.layout,
		elem_needs_release = handoff.elem_needs_release,
		source = prepare_expr(decls, handoff.source),
		source_var = handoff.source_var,
		source_type = handoff.source_type,
		result_type = handoff.result_type,
		capacity = prepare_expr(decls, handoff.capacity),
		result_var = handoff.result_var,
		len_var = handoff.len_var,
		out_var = handoff.out_var,
		body = prepare_expr(decls, handoff.body),
		write_order = handoff.write_order
	}


private pure func prepare_list_handoff_set_source_slot(
	decls: List[CoreDecl],
	slot: CoreListHandoffSetSourceSlot,
) -> CoreListHandoffSetSourceSlot:
	{
		result = prepare_expr(decls, slot.result),
		out_index = prepare_expr(decls, slot.out_index),
		source = prepare_expr(decls, slot.source),
		source_index = prepare_expr(decls, slot.source_index)
	}


private pure func prepare_string_byte_read(
	decls: List[CoreDecl],
	read: CoreStringByteRead,
) -> CoreStringByteRead:
	{
		source = prepare_expr(decls, read.source),
		index = prepare_expr(decls, read.index)
	}


private pure func prepare_string_byte_write(
	decls: List[CoreDecl],
	write: CoreStringByteWrite,
) -> CoreStringByteWrite:
	{
		target = prepare_expr(decls, write.target),
		index = prepare_expr(decls, write.index),
		byte = prepare_expr(decls, write.byte)
	}


private pure func prepare_string_byte_copy(
	decls: List[CoreDecl],
	copy: CoreStringByteCopy,
) -> CoreStringByteCopy:
	{
		dst = prepare_expr(decls, copy.dst),
		dst_pos = prepare_expr(decls, copy.dst_pos),
		src = prepare_expr(decls, copy.src),
		src_pos = prepare_expr(decls, copy.src_pos),
		len = prepare_expr(decls, copy.len)
	}


private pure func prepare_tensor_raw_read(
	decls: List[CoreDecl],
	read: CoreTensorRawRead,
) -> CoreTensorRawRead:
	{
		view = read.view,
		kind = read.kind,
		index = prepare_expr(decls, read.index)
	}


private pure func prepare_tensor_raw_write(
	decls: List[CoreDecl],
	write: CoreTensorRawWrite,
) -> CoreTensorRawWrite:
	{
		view = write.view,
		kind = write.kind,
		index = prepare_expr(decls, write.index),
		value = prepare_expr(decls, write.value)
	}


private pure func prepare_tensor_raw_view_binding(
	decls: List[CoreDecl],
	binding: CoreTensorRawViewBinding,
) -> CoreTensorRawViewBinding:
	{
		variable = binding.variable,
		kind = binding.kind,
		source = prepare_expr(decls, binding.source)
	}


private pure func prepare_string_set_len(
	decls: List[CoreDecl],
	set_len: CoreStringSetLen,
) -> CoreStringSetLen:
	{
		target = prepare_expr(decls, set_len.target),
		len = prepare_expr(decls, set_len.len)
	}


private pure func prepare_list_set(decls: List[CoreDecl], set: CoreListSet) -> CoreListSet:
	{
		layout = set.layout,
		list = prepare_expr(decls, set.list),
		index = prepare_expr(decls, set.index),
		value = prepare_boxed_storage_value(decls, set.value),
		value_is_stack_result = set.value_is_stack_result
	}


private pure func prepare_list_retain(
	decls: List[CoreDecl],
	retain: CoreListRetain,
) -> CoreListRetain:
	{
		list = prepare_expr(decls, retain.list),
		value = prepare_boxed_storage_value(decls, retain.value)
	}


pure func is_primitive_tuple_slot_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if args.length() != 0:
				False
			else if name == "Int":
				True
			else if name == "Int8":
				True
			else if name == "Int16":
				True
			else if name == "Int32":
				True
			else if name == "Int64":
				True
			else if name == "UInt8":
				True
			else if name == "UInt16":
				True
			else if name == "UInt32":
				True
			else if name == "UInt64":
				True
			else if name == "Bool":
				True
			else:
				name == "Char"
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TupleType(items):
			False


private pure func is_managed_pointer_tuple_slot_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if name == "String" and args.length() == 0:
				True
			else if name == "Bytes" and args.length() == 0:
				True
			else if name == "Fixed" and args.length() == 0:
				True
			else if name == "Closure" and args.length() == 0:
				True
			else if name == "List" and args.length() == 1:
				True
			else if name == "Dict" and args.length() == 2:
				True
			else:
				name == "Set" and args.length() == 1
		HeapRecordType(name):
			False
		UnionType(name):
			False
		TupleType(items):
			True
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False


private pure func tuple_slot_needs_release(typ: CoreType) -> Bool:
	is_managed_pointer_tuple_slot_type(typ)


private pure func int_power_of_two(exponent: Int) -> Int:
	var result: Int = 1
	var index: Int = 0

	while index < exponent:
		result = result * 2
		index += 1

	result


private pure func tuple_pointer_expr_needs_retain(expr: CoreExpr) -> Bool:
	match expr:
		LiteralExpr(literal, typ, loc):
			match literal:
				StringLiteral(value):
					True
				IntLiteral(value):
					False
				FloatLiteral(value):
					False
				BoolLiteral(value):
					False
				CharLiteral(value):
					False
		VarExpr(variable, typ, loc):
			True
		FieldExpr(expr_value, field_name, typ, loc):
			True
		TupleFieldExpr(expr_value, field_index, typ, loc):
			True
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			True
		ListGetExpr(get, typ, loc):
			True
		CooperativeCheckpointExpr(typ, loc):
			False
		VoidExpr(typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, expr_value, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(variable, rhs, typ, loc):
			False
		CastExpr(expr_value, typ, loc):
			False
		BoxExpr(box, typ, loc):
			False
		TupleExpr(items, typ, loc):
			False
		TupleConstructExpr(tuple_construct, typ, loc):
			False
		ClosureCreateExpr(closure, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			False
		ListAllocExpr(alloc, typ, loc):
			False
		ListHandoffExpr(handoff, typ, loc):
			False
		ListHandoffSetOwnedExpr(set, typ, loc):
			False
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			False
		ListRetainExpr(retain, typ, loc):
			False
		ListSetExpr(set, typ, loc):
			False
		StringByteReadExpr(read, typ, loc):
			False
		StringByteWriteExpr(write, typ, loc):
			False
		StringByteCopyExpr(copy, typ, loc):
			False
		StringSetLenExpr(set_len, typ, loc):
			False
		TensorRawReadExpr(read, typ, loc):
			False
		TensorRawWriteExpr(write, typ, loc):
			False
		TensorRawViewLetExpr(binding, body, typ, loc):
			False
		DictConstructExpr(construct, typ, loc):
			False
		SetAllocExpr(alloc, typ, loc):
			False
		RecordExpr(fields, typ, loc):
			False
		RecordConstructExpr(type_name, fields, typ, loc):
			False
		UnionConstructExpr(construct, typ, loc):
			False
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			False
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			False
		LetExpr(name, is_mutable, typ, rhs, body):
			False
		SeqExpr(first, second):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False
		WhileExpr(cond, body, typ, loc):
			False
		ForRangeExpr(binder, start, end, body, typ, loc):
			False
		ForListExpr(loop, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		RangeExpr(start, end, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False


private pure func prepared_tuple_literal(
	items: List[CoreExpr],
	item_types: List[CoreType],
) -> Option[PreparedTupleLiteral]:
	var elements: List[CoreTupleElement] = []
	var release_mask: Int = 0
	var retain_mask: Int = 0
	var failed: Bool = False
	var index: Int = 0

	for item in items:
		if not failed:
			match item_types.get(index):
				Some(item_type):
					match item_type:
						VoidType:
							elements = elements.append(TupleVoidElement)
						NamedType(name, args):
							if is_primitive_tuple_slot_type(item_type):
								elements = elements.append(TuplePrimElement(item))
							else if is_managed_pointer_tuple_slot_type(item_type):
								elements = elements.append(TuplePointerElement(item))
								if tuple_slot_needs_release(item_type):
									release_mask += int_power_of_two(index)
								if tuple_pointer_expr_needs_retain(item):
									retain_mask += int_power_of_two(index)
							else:
								failed = True
						TupleType(items):
							if is_managed_pointer_tuple_slot_type(item_type):
								elements = elements.append(TuplePointerElement(item))
								release_mask += int_power_of_two(index)
								if tuple_pointer_expr_needs_retain(item):
									retain_mask += int_power_of_two(index)
							else:
								failed = True
						HeapRecordType(name):
							failed = True
						UnionType(name):
							failed = True
						EnumType(name):
							failed = True
						ValueRecordType(name):
							failed = True
						RangeType:
							failed = True
				None:
					failed = True

		index += 1

	if failed or index != item_types.length():
		None
	else:
		Some({
			elements = elements,
			release_mask = release_mask,
			retain_mask = retain_mask
		})


private pure func prepare_tuple_expr(
	decls: List[CoreDecl],
	items: List[CoreExpr],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	prepared_items: List[CoreExpr] = prepare_exprs(decls, items)

	match typ:
		TupleType(item_types):
				match prepared_tuple_literal(prepared_items, item_types):
					Some(prepared):
						TupleConstructExpr(
							{
								elements = prepared.elements,
								release_mask = prepared.release_mask,
								retain_mask = prepared.retain_mask
							},
							typ,
							loc,
						)
					None:
						TupleExpr(prepared_items, typ, loc)
		NamedType(name, args):
			TupleExpr(prepared_items, typ, loc)
		EnumType(name):
			TupleExpr(prepared_items, typ, loc)
		ValueRecordType(name):
			TupleExpr(prepared_items, typ, loc)
		HeapRecordType(name):
			TupleExpr(prepared_items, typ, loc)
		UnionType(name):
			TupleExpr(prepared_items, typ, loc)
		RangeType:
			TupleExpr(prepared_items, typ, loc)
		VoidType:
			TupleExpr(prepared_items, typ, loc)


private pure func prepare_record_fields(
	decls: List[CoreDecl],
	fields: List[CoreRecordFieldValue],
) -> List[CoreRecordFieldValue]:
	var prepared: List[CoreRecordFieldValue] = []

	for field in fields:
		prepared = prepared.append({
			name = field.name,
			value = prepare_expr(decls, field.value),
		})

	prepared


private pure func prepare_record_expr(
	decls: List[CoreDecl],
	fields: List[CoreRecordFieldValue],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	prepared_fields: List[CoreRecordFieldValue] = prepare_record_fields(decls, fields)

	match typ:
		ValueRecordType(name):
			match find_value_record_decl(decls, name):
				Some(record_decl):
					match order_value_record_fields(record_decl, prepared_fields):
						Some(ordered_fields):
							RecordConstructExpr(name, ordered_fields, typ, loc)
						None:
							RecordExpr(prepared_fields, typ, loc)
				None:
					RecordExpr(prepared_fields, typ, loc)
		NamedType(name, args):
			RecordExpr(prepared_fields, typ, loc)
		HeapRecordType(name):
			match find_heap_record_decl(decls, name):
				Some(record_decl):
					match order_heap_record_fields(record_decl, prepared_fields):
						Some(ordered_fields):
							RecordConstructExpr(name, ordered_fields, typ, loc)
						None:
							RecordExpr(prepared_fields, typ, loc)
				None:
					RecordExpr(prepared_fields, typ, loc)
		EnumType(name):
			RecordExpr(prepared_fields, typ, loc)
		UnionType(name):
			RecordExpr(prepared_fields, typ, loc)
		RangeType:
			RecordExpr(prepared_fields, typ, loc)
		VoidType:
			RecordExpr(prepared_fields, typ, loc)
		TupleType(items):
			RecordExpr(prepared_fields, typ, loc)


private pure func stack_option_c_type(payload: CoreType) -> Option[String]:
	match payload:
		VoidType:
			Some("blorp_StackOption_Void")
		NamedType(name, args):
			match args:
				[]:
					if name == "Int":
						Some("blorp_StackOption_Int")
					else if name == "Int8":
						Some("blorp_StackOption_Int8")
					else if name == "Int16":
						Some("blorp_StackOption_Int16")
					else if name == "Int32":
						Some("blorp_StackOption_Int32")
					else if name == "Int64":
						Some("blorp_StackOption_Int64")
					else if name == "UInt8":
						Some("blorp_StackOption_UInt8")
					else if name == "UInt16":
						Some("blorp_StackOption_UInt16")
					else if name == "UInt32":
						Some("blorp_StackOption_UInt32")
					else if name == "UInt64":
						Some("blorp_StackOption_UInt64")
					else if name == "Float":
						Some("blorp_StackOption_Float")
					else if name == "Float32":
						Some("blorp_StackOption_Float32")
					else if name == "Float16":
						Some("blorp_StackOption_Float16")
					else if name == "Bool":
						Some("blorp_StackOption_Bool")
					else if name == "Char":
						Some("blorp_StackOption_Char")
					else:
						None
				[first, ...rest]:
					None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		RangeType:
			None
		TupleType(items):
			None


private pure func stack_option_none_value(payload: CoreType) -> String:
	match payload:
		NamedType(name, args):
			match args:
				[]:
					if name == "Int":
						"0L"
					else:
						"0"
				[first, ...rest]:
					"0"
		VoidType:
			"0"
		EnumType(name):
			"0"
		ValueRecordType(name):
			"0"
		HeapRecordType(name):
			"0"
		UnionType(name):
			"0"
		RangeType:
			"0"
		TupleType(items):
			"0"


private pure func stack_option_representation(
	payload: CoreType,
	tag: Int,
) -> Option[CoreStackOptionRepresentation]:
	match stack_option_c_type(payload):
		Some(option_type):
			Some({
				option_type = option_type,
				tag = tag,
				none_value = stack_option_none_value(payload),
			})
		None:
			None


private pure func prepare_stack_option_construct(
	kind: CoreCallKind,
	args: List[CoreExpr],
	payload: CoreType,
) -> Option[CoreUnionConstruct]:
	match kind:
		UserCall(constructor_name, def_id):
			if constructor_name == "Some" and args.length() == 1:
				match stack_option_representation(payload, STACK_OPTION_SOME_TAG):
					Some(representation):
						Some({
							type_name = "Option",
							constructor_name = "Some",
							constructor_c_name = "Some",
							representation = StackOptionRepresentation(representation),
							args = args,
						})
					None:
						None
			else if constructor_name == "None" and args.length() == 0:
				match stack_option_representation(payload, STACK_OPTION_NONE_TAG):
					Some(representation):
						Some({
							type_name = "Option",
							constructor_name = "None",
							constructor_c_name = "None",
							representation = StackOptionRepresentation(representation),
							args = [],
						})
					None:
						None
			else:
				None
		ForeignCall(name):
			None
		BuiltinCall(name):
			None
		IntrinsicCall(name):
			None
		ClosureCall:
			None


private pure func prepare_union_construct(
	decls: List[CoreDecl],
	kind: CoreCallKind,
	args: List[CoreExpr],
	typ: CoreType,
) -> Option[CoreUnionConstruct]:
    match typ:
        UnionType(type_name):
            match kind:
                UserCall(constructor_name, def_id):
                    match find_union_decl(decls, type_name):
                        Some(union_decl):
                            match find_union_variant(union_decl, constructor_name):
                                Some(variant):
                                    if variant.fields.length() == args.length():
                                        Some({
                                            type_name = type_name,
                                            constructor_name = constructor_name,
                                            constructor_c_name = variant.c_name,
                                            representation = GenericUnionRepresentation,
                                            args = args,
                                        })
                                    else:
                                        None
                                None:
                                    None
                        None:
                            None
                ForeignCall(name):
                    None
                BuiltinCall(name):
                    None
                IntrinsicCall(name):
                    None
                ClosureCall:
                    None
        NamedType(name, type_args):
            if name == "Option":
                match type_args:
                    [payload]:
                        prepare_stack_option_construct(kind, args, payload)
                    []:
                        None
                    [first, second, ...rest]:
                        None
            else:
                None
        EnumType(name):
            None
        ValueRecordType(name):
            None
        HeapRecordType(name):
            None
        RangeType:
            None
        TupleType(items):
            None
        VoidType:
            None


private pure func prepare_literal_match_cases(
	decls: List[CoreDecl],
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	var prepared: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		prepared = prepared.append({
			literal = match_case.literal,
			body = prepare_expr(decls, match_case.body),
		})

	prepared


private pure func prepare_literal_match_fallback(
	decls: List[CoreDecl],
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(prepare_expr(decls, body))
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func prepare_constructor_match_cases(
	decls: List[CoreDecl],
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	var prepared: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		prepared = prepared.append({
			constructor = match_case.constructor,
			test = match_case.test,
			bindings = match_case.bindings,
			body = prepare_expr(decls, match_case.body),
		})

	prepared


private pure func prepare_constructor_match_fallback(
	decls: List[CoreDecl],
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(prepare_expr(decls, body))
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func prepare_expr(decls: List[CoreDecl], expr: CoreExpr) -> CoreExpr:
	match expr:
		LiteralExpr(literal, typ, loc):
			expr
		VarExpr(variable, typ, loc):
			expr
		VoidExpr(typ, loc):
			expr
		CooperativeCheckpointExpr(typ, loc):
			expr
		CallExpr(kind, callee, args, typ, loc):
			prepared_callee: CoreExpr = prepare_expr(decls, callee)
			prepared_args: List[CoreExpr] = prepare_exprs(decls, args)

			match prepare_union_construct(decls, kind, prepared_args, typ):
				Some(construct):
					UnionConstructExpr(construct, typ, loc)
				None:
					CallExpr(kind, prepared_callee, prepared_args, typ, loc)
		BinaryExpr(op, left, right, typ, loc):
			BinaryExpr(
				op,
				prepare_expr(decls, left),
				prepare_expr(decls, right),
				typ,
				loc,
			)
		UnaryExpr(op, expr_value, typ, loc):
			UnaryExpr(
				op,
				prepare_expr(decls, expr_value),
				typ,
				loc,
			)
		LogicalExpr(op, left, right, typ, loc):
			LogicalExpr(
				op,
				prepare_expr(decls, left),
				prepare_expr(decls, right),
				typ,
				loc,
			)
		AssignExpr(variable, rhs, typ, loc):
			AssignExpr(
				variable,
				prepare_expr(decls, rhs),
				typ,
				loc,
			)
		CastExpr(expr_value, typ, loc):
			CastExpr(
				prepare_expr(decls, expr_value),
				typ,
				loc,
			)
		BoxExpr(box, typ, loc):
			BoxExpr(
				prepare_box_op(decls, box),
				typ,
				loc,
			)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			UnboxExpr(
				unbox_kind,
				prepare_expr(decls, expr_value),
				typ,
				loc,
			)
		FieldExpr(expr_value, field_name, typ, loc):
			FieldExpr(
				prepare_expr(decls, expr_value),
				field_name,
				typ,
				loc,
			)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			TupleFieldExpr(
				prepare_expr(decls, expr_value),
				field_index,
				typ,
				loc,
			)
		TupleExpr(items, typ, loc):
			prepare_tuple_expr(decls, items, typ, loc)
		TupleConstructExpr(tuple_construct, typ, loc):
			TupleConstructExpr(
				{
					elements = prepare_tuple_elements(decls, tuple_construct.elements),
					release_mask = tuple_construct.release_mask,
					retain_mask = tuple_construct.retain_mask
				},
				typ,
				loc,
			)
		ClosureCreateExpr(closure, typ, loc):
			ClosureCreateExpr(closure, typ, loc)
		ListConstructExpr(construct, typ, loc):
			ListConstructExpr(
				prepare_list_construct(decls, construct),
				typ,
				loc,
			)
		ListAllocExpr(alloc, typ, loc):
			ListAllocExpr(
				prepare_list_alloc(decls, alloc),
				typ,
				loc,
			)
		ListGetExpr(get, typ, loc):
			ListGetExpr(
				prepare_list_get(decls, get),
				typ,
				loc,
			)
		ListHandoffExpr(handoff, typ, loc):
			ListHandoffExpr(
				prepare_list_handoff(decls, handoff),
				typ,
				loc,
			)
		ListHandoffSetOwnedExpr(set, typ, loc):
			ListHandoffSetOwnedExpr(
				prepare_list_set(decls, set),
				typ,
				loc,
			)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			ListHandoffSetSourceSlotExpr(
				prepare_list_handoff_set_source_slot(decls, slot),
				typ,
				loc,
			)
		StringByteReadExpr(read, typ, loc):
			StringByteReadExpr(
				prepare_string_byte_read(decls, read),
				typ,
				loc,
			)
		StringByteWriteExpr(write, typ, loc):
			StringByteWriteExpr(
				prepare_string_byte_write(decls, write),
				typ,
				loc,
			)
		StringByteCopyExpr(copy, typ, loc):
			StringByteCopyExpr(
				prepare_string_byte_copy(decls, copy),
				typ,
				loc,
			)
		StringSetLenExpr(set_len, typ, loc):
			StringSetLenExpr(
				prepare_string_set_len(decls, set_len),
				typ,
				loc,
			)
		TensorRawReadExpr(read, typ, loc):
			TensorRawReadExpr(
				prepare_tensor_raw_read(decls, read),
				typ,
				loc,
			)
		TensorRawWriteExpr(write, typ, loc):
			TensorRawWriteExpr(
				prepare_tensor_raw_write(decls, write),
				typ,
				loc,
			)
		TensorRawViewLetExpr(binding, body, typ, loc):
			TensorRawViewLetExpr(
				prepare_tensor_raw_view_binding(decls, binding),
				prepare_expr(decls, body),
				typ,
				loc,
			)
		DictConstructExpr(construct, typ, loc):
			DictConstructExpr(
				prepare_dict_construct(decls, construct),
				typ,
				loc,
			)
		SetAllocExpr(alloc, typ, loc):
			SetAllocExpr(prepare_set_alloc(alloc), typ, loc)
		ListRetainExpr(retain, typ, loc):
			ListRetainExpr(
				prepare_list_retain(decls, retain),
				typ,
				loc,
			)
		ListSetExpr(set, typ, loc):
			ListSetExpr(
				prepare_list_set(decls, set),
				typ,
				loc,
			)
		RecordExpr(fields, typ, loc):
			prepare_record_expr(decls, fields, typ, loc)
		RecordConstructExpr(type_name, fields, typ, loc):
			RecordConstructExpr(
				type_name,
				prepare_record_fields(decls, fields),
				typ,
				loc,
			)
		UnionConstructExpr(construct, typ, loc):
			UnionConstructExpr(
				{
					type_name = construct.type_name,
					constructor_name = construct.constructor_name,
					constructor_c_name = construct.constructor_c_name,
					representation = construct.representation,
					args = prepare_exprs(decls, construct.args)
				},
				typ,
				loc,
			)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			DupExpr(
				variable,
				value_type,
				retain_policy,
				prepare_expr(decls, body),
				typ,
				loc,
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				variable,
				value_type,
				release_policy,
				prepare_expr(decls, body),
				typ,
				loc,
			)
		LetExpr(name, is_mutable, typ, rhs, body):
			LetExpr(
				name,
				is_mutable,
				typ,
				prepare_expr(decls, rhs),
				prepare_expr(decls, body),
			)
		SeqExpr(first, second):
			SeqExpr(
				prepare_expr(decls, first),
				prepare_expr(decls, second),
			)
		WhileExpr(cond, body, typ, loc):
			WhileExpr(
				prepare_expr(decls, cond),
				prepare_expr(decls, body),
				typ,
				loc,
			)
		BreakExpr(typ, loc):
			expr
		ContinueExpr(typ, loc):
			expr
		ResourceScopeExpr(scope, typ, loc):
			ResourceScopeExpr(
				{
					variable = scope.variable,
					typ = scope.typ,
					acquire = prepare_expr(decls, scope.acquire),
					body = prepare_expr(decls, scope.body),
					cleanup = prepare_expr(decls, scope.cleanup)
				},
				typ,
				loc,
			)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			ResourceCleanupExitExpr(
				{
					cleanups = prepare_exprs(decls, cleanup_exit.cleanups),
					exit = cleanup_exit.exit
				},
				typ,
				loc,
			)
		TailrecLoopExpr(params, return_type, body, loc):
			TailrecLoopExpr(
				params,
				return_type,
				prepare_expr(decls, body),
				loc,
			)
		TailrecRecurExpr(args, typ, loc):
			TailrecRecurExpr(
				prepare_exprs(decls, args),
				typ,
				loc,
			)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			ForRangeExpr(
				binder,
				prepare_expr(decls, start),
				prepare_expr(decls, end_value),
				prepare_expr(decls, body),
				typ,
				loc,
			)
		ForListExpr(for_list, typ, loc):
			ForListExpr(
				{
					binder = for_list.binder,
					layout = for_list.layout,
					iterable = prepare_expr(decls, for_list.iterable),
					body = prepare_expr(decls, for_list.body)
				},
				typ,
				loc,
			)
		RangeExpr(start, end_value, typ, loc):
			RangeExpr(
				prepare_expr(decls, start),
				prepare_expr(decls, end_value),
				typ,
				loc,
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			LiteralMatchExpr(
				prepare_expr(decls, scrutinee),
				prepare_literal_match_cases(decls, cases),
				prepare_literal_match_fallback(decls, fallback),
				typ,
				loc,
			)
		ConstructorMatchExpr(scrutinee, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				prepare_expr(decls, scrutinee),
				prepare_constructor_match_cases(decls, cases),
				prepare_constructor_match_fallback(decls, fallback),
				typ,
				loc,
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				prepare_expr(decls, cond),
				prepare_expr(decls, then_expr),
				prepare_expr(decls, else_expr),
				typ,
				loc,
			)


private pure func prepare_function(decls: List[CoreDecl], func_info: CoreFunction) -> CoreFunction:
	match func_info.body:
		Some(body):
			{ func_info | body = Some(prepare_expr(decls, body)) }
		None:
			func_info


private pure func prepare_global(decls: List[CoreDecl], global: CoreGlobal) -> CoreGlobal:
	{ global | init = prepare_expr(decls, global.init) }


private pure func prepare_decl(decls: List[CoreDecl], decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(func_info):
			FunctionDecl(prepare_function(decls, func_info))
		GlobalDecl(global):
			GlobalDecl(prepare_global(decls, global))
		EnumDecl(enum_decl):
			EnumDecl(enum_decl)
		UnionDecl(union_decl):
			UnionDecl(union_decl)
		ValueRecordDecl(record_decl):
			ValueRecordDecl(record_decl)
		HeapRecordDecl(record_decl):
			HeapRecordDecl(record_decl)


pure func prepare_program(program: CoreProgram) -> CoreProgram:
	var decls: List[CoreDecl] = []

	for decl in program.decls:
		decls = decls.append(prepare_decl(program.decls, decl))

	{decls = decls}
