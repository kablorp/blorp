-- Shared formatting helpers for Blorp-authored codegen template registries.
--
-- Renderer modules keep their typed template enums, operation unions, and local
-- errors. This module owns only text conventions that should stay byte-for-byte
-- consistent across those registries.
pure func render_template_manifest_line(name: String, arity: Int, body: String) -> String:
	"${name}\t${arity}\t${body}"


pure func render_template_arity_error(
	kind: String,
	name: String,
	expected: Int,
	got: Int,
) -> String:
	"${kind} ${name} expected ${expected} arg(s), got ${got}"


pure func render_unsupported_template_error(kind: String, name: String) -> String:
	"unsupported ${kind}: ${name}"
