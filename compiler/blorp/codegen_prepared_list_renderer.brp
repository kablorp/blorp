private pure func render_pointer_swap_body(
	list_tmp: String,
	left_index_tmp: String,
	right_index_tmp: String,
	value_tmp: String,
) -> String:
	load_value: String = "void* ${value_tmp} = blorp_list_get(${list_tmp}, ${left_index_tmp});"
	store_left: String = "blorp_list_set_raw(${list_tmp}, ${left_index_tmp}, blorp_list_get(${list_tmp}, ${right_index_tmp}));"
	store_right: String = "blorp_list_set_raw(${list_tmp}, ${right_index_tmp}, ${value_tmp});"

	load_value + " " + store_left + " " + store_right


private pure func render_swap_expression(
	list: String,
	left_index: String,
	right_index: String,
	list_tmp: String,
	left_index_tmp: String,
	right_index_tmp: String,
	body: String,
) -> String:
	list_bind: String = "blorp_List* ${list_tmp} = (blorp_List*)${list};"
	left_index_bind: String = "long ${left_index_tmp} = ${left_index};"
	right_index_bind: String = "long ${right_index_tmp} = ${right_index};"
	swap_condition: String = "if (__builtin_expect(${list_tmp} && ${left_index_tmp} != ${right_index_tmp}, 1)) "
	swap_branch: String = c_block(body)

	c_statement_expr(
		list_bind + " " + left_index_bind + " " + right_index_bind + " " + swap_condition + swap_branch,
	)


private pure func render_pointer_swap(args: PointerSwapArgs) -> String:
	list_tmp: String = list_swap_list_tmp(args.temp_seed)
	left_index_tmp: String = list_swap_left_index_tmp(args.temp_seed)
	right_index_tmp: String = list_swap_right_index_tmp(args.temp_seed)
	value_tmp: String = list_swap_value_tmp(args.temp_seed)
	body: String = render_pointer_swap_body(list_tmp, left_index_tmp, right_index_tmp, value_tmp)

	render_swap_expression(
		args.list,
		args.left_index,
		args.right_index,
		list_tmp,
		left_index_tmp,
		right_index_tmp,
		body,
	)


private pure func render_inline_bits_swap(args: InlineBitsSwapArgs) -> String:
	base_tmp: String = list_swap_base_tmp(args.temp_seed)
	bits_tmp: String = list_swap_bits_tmp(args.temp_seed)
	list_tmp: String = list_swap_list_tmp(args.temp_seed)
	left_index_tmp: String = list_swap_left_index_tmp(args.temp_seed)
	right_index_tmp: String = list_swap_right_index_tmp(args.temp_seed)
	base_bind: String = "char* ${base_tmp} = (char*)${list_tmp}->data;"
	bits_bind: String = "uintptr_t ${bits_tmp} = 0;"
	load_bits: String = "memcpy(&${bits_tmp}, ${base_tmp} + ${left_index_tmp} * ${args.width_bytes}, ${args.width_bytes});"
	store_left: String = "memcpy(${base_tmp} + ${left_index_tmp} * ${args.width_bytes}, ${base_tmp} + ${right_index_tmp} * ${args.width_bytes}, ${args.width_bytes});"
	store_right: String = "memcpy(${base_tmp} + ${right_index_tmp} * ${args.width_bytes}, &${bits_tmp}, ${args.width_bytes});"
	body: String = base_bind + " " + bits_bind + " " + load_bits + " " + store_left + " " + store_right

	render_swap_expression(
		args.list,
		args.left_index,
		args.right_index,
		list_tmp,
		left_index_tmp,
		right_index_tmp,
		body,
	)


private pure func render_inline_struct_swap(args: InlineStructSwapArgs) -> String:
	list_tmp: String = list_swap_list_tmp(args.temp_seed)
	left_index_tmp: String = list_swap_left_index_tmp(args.temp_seed)
	right_index_tmp: String = list_swap_right_index_tmp(args.temp_seed)
	base_tmp: String = list_swap_base_tmp(args.temp_seed)
	size_tmp: String = list_swap_size_tmp(args.temp_seed)
	left_slot_tmp: String = list_swap_left_slot_tmp(args.temp_seed)
	right_slot_tmp: String = list_swap_right_slot_tmp(args.temp_seed)
	bytes_tmp: String = list_swap_bytes_tmp(args.temp_seed)
	value_tmp: String = list_swap_value_tmp(args.temp_seed)
	base_bind: String = "char* ${base_tmp} = (char*)${list_tmp}->data;"
	size_bind: String = "size_t ${size_tmp} = (size_t)${list_tmp}->elem_size;"
	left_slot_bind: String = "void* ${left_slot_tmp} = ${base_tmp} + ${left_index_tmp} * ${size_tmp};"
	right_slot_bind: String = "void* ${right_slot_tmp} = ${base_tmp} + ${right_index_tmp} * ${size_tmp};"
	bytes_bind: String = "unsigned char ${bytes_tmp}[${size_tmp}];"
	load_bytes: String = "memcpy(${bytes_tmp}, ${left_slot_tmp}, ${size_tmp});"
	store_left: String = "memcpy(${left_slot_tmp}, ${right_slot_tmp}, ${size_tmp});"
	store_right: String = "memcpy(${right_slot_tmp}, ${bytes_tmp}, ${size_tmp});"
	inline_body: String = base_bind + " " + size_bind + " " + left_slot_bind + " " + right_slot_bind + " " + bytes_bind + " " + load_bytes + " " + store_left + " " + store_right
	inline_branch: String = c_block(inline_body)
	fallback_body: String = render_pointer_swap_body(
		list_tmp,
		left_index_tmp,
		right_index_tmp,
		value_tmp,
	)
	fallback_branch: String = c_block(fallback_body)
	storage_check: String = "if (${list_tmp}->storage_mode == BLORP_LIST_STORAGE_INLINE) "
	body: String = storage_check + inline_branch + " else " + fallback_branch

	render_swap_expression(
		args.list,
		args.left_index,
		args.right_index,
		list_tmp,
		left_index_tmp,
		right_index_tmp,
		body,
	)


private pure func render_inline_struct_load_body_parts(
	list_tmp: String,
	index_tmp: String,
	out_tmp: String,
	raw_tmp: String,
	struct_ty: String,
) -> String:
	storage_check: String = "if (${list_tmp}->storage_mode == BLORP_LIST_STORAGE_INLINE " + "&& ${list_tmp}->elem_size == (int16_t)sizeof(${struct_ty})) "

	inline_copy: String = "memcpy(&${out_tmp}, (char*)${list_tmp}->data + ${index_tmp} " + "* sizeof(${struct_ty}), sizeof(${struct_ty}));"

	fallback_get: String = "void* ${raw_tmp} = blorp_list_get(${list_tmp}, ${index_tmp});"
	null_check: String = "if (!${raw_tmp}) "
	zero_out: String = "memset(&${out_tmp}, 0, sizeof(${struct_ty}));"
	unbox_out: String = "${out_tmp} = blorp_unbox_struct(${raw_tmp}, ${struct_ty});"
	inline_branch: String = c_block(inline_copy)
	null_branch: String = c_block(zero_out)
	unbox_branch: String = c_block(unbox_out)
	fallback_choice: String = null_check + null_branch + " else " + unbox_branch
	fallback_branch: String = c_block(fallback_get + " " + fallback_choice)

	storage_check + inline_branch + " else " + fallback_branch


private pure func render_inline_struct_load_body(args: InlineStructLoadArgs) -> String:
	render_inline_struct_load_body_parts(
		args.list_tmp,
		args.index_tmp,
		args.out_tmp,
		inline_struct_load_raw_tmp(args.temp_seed),
		args.struct_ty,
	)


private pure func render_inline_struct_checked_load(args: InlineStructLoadArgs) -> String:
	raw_tmp: String = inline_struct_load_raw_tmp(args.temp_seed)
	bounds_check: String = "if (__builtin_expect(!${args.list_tmp} || ${args.index_tmp} < 0 " + "|| ${args.index_tmp} >= ${args.list_tmp}->len, 0)) "

	zero_out: String = "memset(&${args.out_tmp}, 0, sizeof(${args.struct_ty}));"
	bounds_branch: String = c_block(zero_out)
	bounds: String = bounds_check + bounds_branch + " else "
	load_body: String = render_inline_struct_load_body_parts(
		args.list_tmp,
		args.index_tmp,
		args.out_tmp,
		raw_tmp,
		args.struct_ty,
	)

	bounds + load_body


pure func render_prepared_list_op(op: PreparedListOp) -> String:
	match op:
		PointerGet(list, index):
			render_runtime_get(list, index)
		InlineCheckedGet(args):
			render_inline_checked_get(args)
		InlineProvenGet(args):
			render_inline_proven_get(args)
		InlineBitsLoad(args):
			render_inline_bits_load(args)
		InlineBitsStore(args):
			render_inline_bits_store(args)
		PointerSetRawStore(args):
			render_pointer_store(args, SetRawStoreRuntime)
		PointerHandoffSetOwnedStore(args):
			render_pointer_store(args, HandoffSetOwnedStoreRuntime)
		InlineStructSetRawStore(args):
			render_inline_struct_store(args, SetRawStoreRuntime)
		InlineStructHandoffSetOwnedStore(args):
			render_inline_struct_store(args, HandoffSetOwnedStoreRuntime)
		PointerSwap(args):
			render_pointer_swap(args)
		InlineBitsSwap(args):
			render_inline_bits_swap(args)
		InlineStructSwap(args):
			render_inline_struct_swap(args)
		InlineStructLoadChecked(args):
			render_inline_struct_checked_load(args)
		InlineStructLoadProven(args):
			render_inline_struct_load_body(args)
		ListInlineStructUnboxListName(temp_seed):
			render_list_inline_struct_unbox_list_name(temp_seed)
		ListInlineStructUnboxIndexName(temp_seed):
			render_list_inline_struct_unbox_index_name(temp_seed)
		ListInlineStructUnboxOutName(temp_seed):
			render_list_inline_struct_unbox_out_name(temp_seed)
		ListInlineStructUnboxOpen(args):
			render_list_inline_struct_unbox_open(args)
		ListInlineStructUnboxClose(out):
			render_list_inline_struct_unbox_close(out)
		HandoffSetSourceSlot(args):
			render_handoff_source_slot(args)
		CopySpanUninit(args):
			render_copy_span_uninit(args)
		EnsureUnique(args):
			render_ensure_unique(args)
		EnsureCapacity(args):
			render_ensure_capacity(args)
		ReuseAlloc(args):
			render_reuse_alloc(args)
		ReuseAllocWithRelease(args):
			render_reuse_alloc_with_release(args)
		ListAllocPointer(capacity):
			render_list_alloc_pointer(capacity)
		ListAllocInline(args):
			render_list_alloc_inline(args)
		ListAllocInlineStruct(args):
			render_list_alloc_inline_struct(args)
		ListAllocWithRelease(args):
			render_list_alloc_with_release(args)
		RetainFor(args):
			render_retain_for(args)
		RetainForNoop:
			RETAIN_FOR_NOOP_RENDERED
		ListConstructName(temp_seed):
			render_list_construct_name(temp_seed)
		ListConstruct(args):
			render_list_construct(args)
		ListConstructInitElemRelease(list):
			render_list_construct_init_elem_release(list)
		ListConstructInlineStructSet(args):
			render_list_construct_inline_struct_set(args)
		ListConstructSetLen(list, len):
			render_list_construct_set_len(list, len)
		ListConstructAppend(args):
			render_list_construct_append(args)
		ListConstructAppendOwned(args):
			render_list_construct_append_owned(args)
		ListHandoffCapacityName(temp_seed):
			render_list_handoff_capacity_name(temp_seed)
		ListHandoffReuseName(temp_seed):
			render_list_handoff_reuse_name(temp_seed)
		ListHandoffReleaseName(temp_seed):
			render_list_handoff_release_name(temp_seed)
		ListStorageModePointer:
			LIST_STORAGE_MODE_POINTER
		ListStorageModeInline:
			LIST_STORAGE_MODE_INLINE
		ListElementSizePointer:
			LIST_ELEMENT_SIZE_POINTER
		ListElementSizeInlineStruct(struct_ty):
			render_list_element_size_inline_struct(struct_ty)
		ListElementReleaseFn:
			LIST_ELEMENT_RELEASE_FN
		ListElementReleaseNone:
			LIST_ELEMENT_RELEASE_NONE
		ListHandoffBorrowPrefix(args):
			render_list_handoff_borrow_prefix(args)
		ListHandoffReusePrefix(args):
			render_list_handoff_reuse_prefix(args)
		ListHandoffBorrowSuffix(args):
			render_list_handoff_borrow_suffix(args)
		ListHandoffReuseSuffix(args):
			render_list_handoff_reuse_suffix(args)


pure func build_prepared_list_op(
	info: PreparedListTemplateInfo,
	args: List[String],
) -> Result[PreparedListOp, RenderError]:
	match info.template:
		ListGetPointerTemplate:
			op ?= parse_pointer_get_op(args).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		ListGetInlineCheckedTemplate:
			parsed ?= parse_inline_get_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(InlineCheckedGet(parsed))
		ListGetInlineProvenTemplate:
			parsed ?= parse_inline_get_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(InlineProvenGet(parsed))
		ListInlineBitsLoadTemplate:
			parsed ?= parse_inline_bits_load_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(InlineBitsLoad(parsed))
		ListInlineBitsStoreTemplate:
			parsed ?= parse_inline_bits_store_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(InlineBitsStore(parsed))
		ListPointerSetRawStoreTemplate:
			parsed ?= parse_pointer_store_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(PointerSetRawStore(parsed))
		ListPointerHandoffSetOwnedStoreTemplate:
			parsed ?= parse_pointer_store_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(PointerHandoffSetOwnedStore(parsed))
		ListInlineStructSetRawStoreTemplate:
			parsed ?= parse_inline_struct_store_args(
				args,
				StructAddressBoxing,
			).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructSetRawStore(parsed))
		ListInlineStructSetRawStackResultStoreTemplate:
			parsed ?= parse_inline_struct_store_args(
				args,
				StackResultBoxing,
			).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructSetRawStore(parsed))
		ListInlineStructHandoffSetOwnedStoreTemplate:
			parsed ?= parse_inline_struct_store_args(
				args,
				StructAddressBoxing,
			).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructHandoffSetOwnedStore(parsed))
		ListInlineStructHandoffSetOwnedStackResultStoreTemplate:
			parsed ?= parse_inline_struct_store_args(
				args,
				StackResultBoxing,
			).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructHandoffSetOwnedStore(parsed))
		ListPointerSwapTemplate:
			parsed ?= parse_pointer_swap_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(PointerSwap(parsed))
		ListInlineBitsSwapTemplate:
			parsed ?= parse_inline_bits_swap_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(InlineBitsSwap(parsed))
		ListInlineStructSwapTemplate:
			parsed ?= parse_inline_struct_swap_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructSwap(parsed))
		ListInlineStructLoadCheckedTemplate:
			parsed ?= parse_inline_struct_load_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructLoadChecked(parsed))
		ListInlineStructLoadProvenTemplate:
			parsed ?= parse_inline_struct_load_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructLoadProven(parsed))
		ListInlineStructUnboxListNameTemplate:
			temp_seed ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(ListInlineStructUnboxListName(temp_seed))
		ListInlineStructUnboxIndexNameTemplate:
			temp_seed ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(ListInlineStructUnboxIndexName(temp_seed))
		ListInlineStructUnboxOutNameTemplate:
			temp_seed ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(ListInlineStructUnboxOutName(temp_seed))
		ListInlineStructUnboxOpenTemplate:
			parsed ?= parse_list_inline_struct_unbox_open_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListInlineStructUnboxOpen(parsed))
		ListInlineStructUnboxCloseTemplate:
			out ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(ListInlineStructUnboxClose(out))
		ListHandoffSetSourceSlotTemplate:
			parsed ?= parse_source_slot_handoff_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(HandoffSetSourceSlot(parsed))
		ListCopySpanUninitTemplate:
			parsed ?= parse_copy_span_uninit_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(CopySpanUninit(parsed))
		ListEnsureUniqueTemplate:
			parsed ?= parse_ensure_unique_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(EnsureUnique(parsed))
		ListEnsureCapacityTemplate:
			parsed ?= parse_ensure_capacity_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(EnsureCapacity(parsed))
		ListReuseAllocTemplate:
			parsed ?= parse_reuse_alloc_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(ReuseAlloc(parsed))
		ListReuseAllocWithReleaseTemplate:
			parsed ?= parse_reuse_alloc_with_release_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ReuseAllocWithRelease(parsed))
		ListAllocPointerTemplate:
			capacity ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(ListAllocPointer(capacity))
		ListAllocInlineTemplate:
			parsed ?= parse_list_alloc_inline_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(ListAllocInline(parsed))
		ListAllocInlineStructTemplate:
			parsed ?= parse_list_alloc_inline_struct_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListAllocInlineStruct(parsed))
		ListAllocWithReleaseTemplate:
			parsed ?= parse_list_alloc_with_release_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListAllocWithRelease(parsed))
		ListRetainForTemplate:
			parsed ?= parse_retain_for_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(RetainFor(parsed))
		ListRetainForNoopTemplate:
			op ?= parse_no_arg_op(args, RetainForNoop).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		ListConstructNameTemplate:
			temp_seed ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(ListConstructName(temp_seed))
		ListConstructTemplate:
			parsed ?= parse_list_construct_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(ListConstruct(parsed))
		ListConstructInitElemReleaseTemplate:
			list ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(ListConstructInitElemRelease(list))
		ListConstructInlineStructSetTemplate:
			parsed ?= parse_list_construct_inline_struct_set_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListConstructInlineStructSet(parsed))
		ListConstructSetLenTemplate:
			op ?= parse_list_construct_set_len_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		ListConstructAppendTemplate:
			parsed ?= parse_list_construct_append_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListConstructAppend(parsed))
		ListConstructAppendOwnedTemplate:
			parsed ?= parse_list_construct_append_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListConstructAppendOwned(parsed))
		ListHandoffCapacityNameTemplate:
			temp_seed ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(ListHandoffCapacityName(temp_seed))
		ListHandoffReuseNameTemplate:
			temp_seed ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(ListHandoffReuseName(temp_seed))
		ListHandoffReleaseNameTemplate:
			temp_seed ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(ListHandoffReleaseName(temp_seed))
		ListStorageModePointerTemplate:
			op ?= parse_no_arg_op(
				args,
				ListStorageModePointer,
			).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		ListStorageModeInlineTemplate:
			op ?= parse_no_arg_op(
				args,
				ListStorageModeInline,
			).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		ListElementSizePointerTemplate:
			op ?= parse_no_arg_op(
				args,
				ListElementSizePointer,
			).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		ListElementSizeInlineStructTemplate:
			struct_ty ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(ListElementSizeInlineStruct(struct_ty))
		ListElementReleaseFnTemplate:
			op ?= parse_no_arg_op(
				args,
				ListElementReleaseFn,
			).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		ListElementReleaseNoneTemplate:
			op ?= parse_no_arg_op(
				args,
				ListElementReleaseNone,
			).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		ListHandoffBorrowPrefixTemplate:
			parsed ?= parse_list_handoff_prefix_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListHandoffBorrowPrefix(parsed))
		ListHandoffReusePrefixTemplate:
			parsed ?= parse_list_handoff_prefix_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListHandoffReusePrefix(parsed))
		ListHandoffBorrowSuffixTemplate:
			parsed ?= parse_list_handoff_borrow_suffix_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListHandoffBorrowSuffix(parsed))
		ListHandoffReuseSuffixTemplate:
			parsed ?= parse_list_handoff_reuse_suffix_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListHandoffReuseSuffix(parsed))


pure func render_prepared_list(name: String, args: List[String]) -> Result[String, RenderError]:
	match parse_prepared_list_template(name):
		Some(info):
			match build_prepared_list_op(info, args):
				Ok(op):
					Ok(render_prepared_list_op(op))
				Err(error):
					Err(error)
		None:
			Err(UnsupportedPreparedListOp(name))
