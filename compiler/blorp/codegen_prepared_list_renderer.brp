-- Blorp-authored library for prepared list Core nodes.
--
-- OCaml still owns Core traversal, child expression emission, layout metadata,
-- and fresh temp seeds. This module owns the final C snippet shape and temp
-- names for prepared list operations.
import:
	codegen_template_registry: render_template_arity_error, render_unsupported_template_error
	string: string as make_string


enum PreparedListTemplate:
	ListGetPointerTemplate
	ListGetInlineCheckedTemplate
	ListGetInlineProvenTemplate
	ListInlineBitsLoadTemplate
	ListInlineBitsStoreTemplate
	ListPointerSetRawStoreTemplate
	ListPointerHandoffSetOwnedStoreTemplate
	ListInlineStructSetRawStoreTemplate
	ListInlineStructSetRawStackResultStoreTemplate
	ListInlineStructHandoffSetOwnedStoreTemplate
	ListInlineStructHandoffSetOwnedStackResultStoreTemplate
	ListPointerSwapTemplate
	ListInlineBitsSwapTemplate
	ListInlineStructSwapTemplate
	ListInlineStructLoadCheckedTemplate
	ListInlineStructLoadProvenTemplate
	ListInlineStructUnboxListNameTemplate
	ListInlineStructUnboxIndexNameTemplate
	ListInlineStructUnboxOutNameTemplate
	ListInlineStructUnboxOpenTemplate
	ListInlineStructUnboxCloseTemplate
	ListHandoffSetSourceSlotTemplate
	ListCopySpanUninitTemplate
	ListEnsureUniqueTemplate
	ListEnsureCapacityTemplate
	ListReuseAllocTemplate
	ListReuseAllocWithReleaseTemplate
	ListAllocPointerTemplate
	ListAllocInlineTemplate
	ListAllocInlineStructTemplate
	ListAllocWithReleaseTemplate
	ListRetainForTemplate
	ListRetainForNoopTemplate
	ListConstructNameTemplate
	ListConstructTemplate
	ListConstructInitElemReleaseTemplate
	ListConstructInlineStructSetTemplate
	ListConstructSetLenTemplate
	ListConstructAppendTemplate
	ListConstructAppendOwnedTemplate
	ListHandoffCapacityNameTemplate
	ListHandoffReuseNameTemplate
	ListHandoffReleaseNameTemplate
	ListStorageModePointerTemplate
	ListStorageModeInlineTemplate
	ListElementSizePointerTemplate
	ListElementSizeInlineStructTemplate
	ListElementReleaseFnTemplate
	ListElementReleaseNoneTemplate
	ListHandoffBorrowPrefixTemplate
	ListHandoffReusePrefixTemplate
	ListHandoffBorrowSuffixTemplate
	ListHandoffReuseSuffixTemplate


record PreparedListTemplateInfo {
	template: PreparedListTemplate,
	name: String,
	arity: Int
}


private enum StoreRuntime:
	SetRawStoreRuntime
	HandoffSetOwnedStoreRuntime


enum InlineStructStoreBoxing:
	StackResultBoxing
	StructAddressBoxing


-- These payloads carry rendered C snippets and temp names. They are records
-- because Blorp structs cannot contain String fields.
record InlineGetArgs {
	list: String,
	index: String,
	temp_seed: String,
	width_bytes: String
}


record InlineStructLoadArgs {
	list_tmp: String,
	index_tmp: String,
	out_tmp: String,
	temp_seed: String,
	struct_ty: String
}


record InlineBitsLoadArgs {
	list_tmp: String,
	index_tmp: String,
	bits_tmp: String,
	width_bytes: String
}


record InlineBitsStoreArgs {
	list: String,
	index: String,
	value: String,
	temp_seed: String,
	width_bytes: String
}


record PointerStoreArgs {
	list: String,
	index: String,
	value: String
}


record InlineStructStoreArgs {
	list: String,
	index: String,
	value: String,
	boxing: InlineStructStoreBoxing,
	temp_seed: String,
	struct_ty: String
}


record PointerSwapArgs {
	list: String,
	left_index: String,
	right_index: String,
	temp_seed: String
}


record InlineBitsSwapArgs {
	list: String,
	left_index: String,
	right_index: String,
	temp_seed: String,
	width_bytes: String
}


record InlineStructSwapArgs {
	list: String,
	left_index: String,
	right_index: String,
	temp_seed: String
}


record SourceSlotHandoffArgs {
	result: String,
	out_index: String,
	source: String,
	source_index: String
}


record CopySpanUninitArgs {
	dst: String,
	dst_start: String,
	src: String,
	src_start: String,
	count: String
}


record EnsureUniqueArgs {
	list: String,
	temp_seed: String
}


record EnsureCapacityArgs {
	list: String,
	capacity: String,
	temp_seed: String
}


record ReuseAllocArgs {
	list: String,
	capacity: String
}


record ReuseAllocWithReleaseArgs {
	list: String,
	capacity: String,
	temp_seed: String
}


record ListAllocInlineArgs {
	capacity: String,
	elem_size: String
}


record ListAllocInlineStructArgs {
	capacity: String,
	struct_ty: String
}


record ListAllocWithReleaseArgs {
	alloc_expr: String,
	result_tmp: String
}


record RetainForArgs {
	list: String,
	value: String
}


record ListConstructInlineStructSetArgs {
	list: String,
	index: String,
	value: String,
	temp_seed: String,
	struct_ty: String
}


record ListConstructArgs {
	list: String,
	alloc_expr: String,
	statements: String
}


record ListConstructAppendArgs {
	list: String,
	value: String
}


record ListHandoffOpenArgs {
	source_ty: String,
	source: String,
	source_expr: String,
	capacity: String,
	capacity_expr: String,
	length: String,
	release: String,
	release_fn: String
}


record ListHandoffBeginBorrowArgs {
	result_ty: String,
	result: String,
	capacity: String,
	release: String,
	storage_mode: String,
	elem_size: String,
	out: String
}


record ListHandoffBeginReuseArgs {
	result_ty: String,
	result: String,
	source: String,
	capacity: String,
	release: String,
	storage_mode: String,
	elem_size: String,
	reuse: String,
	out: String
}


record ListHandoffBorrowSuffixArgs {
	result: String,
	out: String,
	length: String
}


record ListHandoffPrefixArgs {
	source_ty: String,
	source: String,
	source_expr: String,
	capacity_expr: String,
	length: String,
	release_fn: String,
	result_ty: String,
	result: String,
	storage_mode: String,
	elem_size: String,
	out: String,
	temp_seed: String
}


record ListHandoffReuseSuffixArgs {
	result: String,
	out: String,
	length: String,
	source: String,
	temp_seed: String
}


record ListInlineStructUnboxOpenArgs {
	list: String,
	list_expr: String,
	index: String,
	index_expr: String,
	struct_ty: String,
	out: String
}


union PreparedListOp:
	PointerGet(String, String)
	InlineCheckedGet(InlineGetArgs)
	InlineProvenGet(InlineGetArgs)
	InlineBitsLoad(InlineBitsLoadArgs)
	InlineBitsStore(InlineBitsStoreArgs)
	PointerSetRawStore(PointerStoreArgs)
	PointerHandoffSetOwnedStore(PointerStoreArgs)
	InlineStructSetRawStore(InlineStructStoreArgs)
	InlineStructHandoffSetOwnedStore(InlineStructStoreArgs)
	PointerSwap(PointerSwapArgs)
	InlineBitsSwap(InlineBitsSwapArgs)
	InlineStructSwap(InlineStructSwapArgs)
	InlineStructLoadChecked(InlineStructLoadArgs)
	InlineStructLoadProven(InlineStructLoadArgs)
	ListInlineStructUnboxListName(String)
	ListInlineStructUnboxIndexName(String)
	ListInlineStructUnboxOutName(String)
	ListInlineStructUnboxOpen(ListInlineStructUnboxOpenArgs)
	ListInlineStructUnboxClose(String)
	HandoffSetSourceSlot(SourceSlotHandoffArgs)
	CopySpanUninit(CopySpanUninitArgs)
	EnsureUnique(EnsureUniqueArgs)
	EnsureCapacity(EnsureCapacityArgs)
	ReuseAlloc(ReuseAllocArgs)
	ReuseAllocWithRelease(ReuseAllocWithReleaseArgs)
	ListAllocPointer(String)
	ListAllocInline(ListAllocInlineArgs)
	ListAllocInlineStruct(ListAllocInlineStructArgs)
	ListAllocWithRelease(ListAllocWithReleaseArgs)
	RetainFor(RetainForArgs)
	RetainForNoop
	ListConstructName(String)
	ListConstruct(ListConstructArgs)
	ListConstructInitElemRelease(String)
	ListConstructInlineStructSet(ListConstructInlineStructSetArgs)
	ListConstructSetLen(String, String)
	ListConstructAppend(ListConstructAppendArgs)
	ListConstructAppendOwned(ListConstructAppendArgs)
	ListHandoffCapacityName(String)
	ListHandoffReuseName(String)
	ListHandoffReleaseName(String)
	ListStorageModePointer
	ListStorageModeInline
	ListElementSizePointer
	ListElementSizeInlineStruct(String)
	ListElementReleaseFn
	ListElementReleaseNone
	ListHandoffBorrowPrefix(ListHandoffPrefixArgs)
	ListHandoffReusePrefix(ListHandoffPrefixArgs)
	ListHandoffBorrowSuffix(ListHandoffBorrowSuffixArgs)
	ListHandoffReuseSuffix(ListHandoffReuseSuffixArgs)


union RenderError:
	WrongArity(PreparedListTemplateInfo, Int)
	UnsupportedPreparedListOp(String)


private pure func templates_by_name(
	templates: List[PreparedListTemplateInfo],
) -> Dict[String, PreparedListTemplateInfo]:
	var dict: Dict[String, PreparedListTemplateInfo] = {}

	for info in templates:
		dict = dict.set(info.name, info)

	dict


