private pure func store_runtime_fn(runtime: StoreRuntime) -> String:
	match runtime:
		SetRawStoreRuntime: "blorp_list_set_raw"
		HandoffSetOwnedStoreRuntime: "blorp_list_handoff_set_owned"


private pure func render_runtime_get(list: String, index: String) -> String:
	"blorp_list_get((blorp_List*)${list}, ${index})"


private pure func render_inline_load(
	list_tmp: String,
	index_tmp: String,
	bits_tmp: String,
	width_bytes: String,
) -> String:
	body: String = "uintptr_t ${bits_tmp} = 0; memcpy(&${bits_tmp}, (char*)${list_tmp}->data + ${index_tmp} * ${width_bytes}, ${width_bytes}); (void*)${bits_tmp};"
	c_statement_expr(body)


private pure func inline_get_list_tmp(temp_seed: String) -> String:
	"__lg_list_${temp_seed}"


private pure func inline_get_index_tmp(temp_seed: String) -> String:
	"__lg_idx_${temp_seed}"


private pure func inline_get_bits_tmp(temp_seed: String) -> String:
	"__lg_bits_${temp_seed}"


private pure func inline_store_list_tmp(temp_seed: String) -> String:
	"__list_store_${temp_seed}"


private pure func inline_store_index_tmp(temp_seed: String) -> String:
	"__list_store_idx_${temp_seed}"


private pure func inline_store_bits_tmp(temp_seed: String) -> String:
	"__list_store_bits_${temp_seed}"


private pure func ensure_unique_list_tmp(temp_seed: String) -> String:
	"__list_unique_${temp_seed}"


private pure func ensure_capacity_list_tmp(temp_seed: String) -> String:
	"__list_cap_${temp_seed}"


private pure func ensure_capacity_min_tmp(temp_seed: String) -> String:
	"__list_cap_min_${temp_seed}"


private pure func reuse_alloc_result_tmp(temp_seed: String) -> String:
	"__lst_${temp_seed}"


private pure func render_inline_checked_get(args: InlineGetArgs) -> String:
	list: String = args.list
	index: String = args.index
	list_tmp: String = inline_get_list_tmp(args.temp_seed)
	index_tmp: String = inline_get_index_tmp(args.temp_seed)
	bits_tmp: String = inline_get_bits_tmp(args.temp_seed)
	width_bytes: String = args.width_bytes
	list_bind: String = "blorp_List* ${list_tmp} = (blorp_List*)${list};"
	index_bind: String = "long ${index_tmp} = ${index};"
	bounds: String = "(__builtin_expect(!${list_tmp} || ${index_tmp} < 0 || ${index_tmp} >= ${list_tmp}->len, 0) ? NULL : "
	body: String = list_bind + " " + index_bind + " " + bounds + render_inline_load(
		list_tmp,
		index_tmp,
		bits_tmp,
		width_bytes,
	) + ");"
	c_statement_expr(body)


private pure func render_inline_proven_get(args: InlineGetArgs) -> String:
	list: String = args.list
	index: String = args.index
	list_tmp: String = inline_get_list_tmp(args.temp_seed)
	index_tmp: String = inline_get_index_tmp(args.temp_seed)
	bits_tmp: String = inline_get_bits_tmp(args.temp_seed)
	width_bytes: String = args.width_bytes
	list_bind: String = "blorp_List* ${list_tmp} = (blorp_List*)${list};"
	index_bind: String = "long ${index_tmp} = ${index};"
	body: String = list_bind + " " + index_bind + " " + render_inline_load(
		list_tmp,
		index_tmp,
		bits_tmp,
		width_bytes,
	) + ";"
	c_statement_expr(body)


private pure func render_inline_bits_load(args: InlineBitsLoadArgs) -> String:
	list_tmp: String = args.list_tmp
	index_tmp: String = args.index_tmp
	bits_tmp: String = args.bits_tmp
	width_bytes: String = args.width_bytes
	bits_decl: String = "uintptr_t ${bits_tmp} = 0;"
	copy_bits: String = "memcpy(&${bits_tmp}, (char*)${list_tmp}->data + ${index_tmp} " + "* ${width_bytes}, ${width_bytes});"

	bits_decl + " " + copy_bits


private pure func render_inline_bits_store(args: InlineBitsStoreArgs) -> String:
	list: String = args.list
	index: String = args.index
	value: String = args.value
	list_tmp: String = inline_store_list_tmp(args.temp_seed)
	index_tmp: String = inline_store_index_tmp(args.temp_seed)
	bits_tmp: String = inline_store_bits_tmp(args.temp_seed)
	width_bytes: String = args.width_bytes
	list_bind: String = "blorp_List* ${list_tmp} = (blorp_List*)${list};"
	index_bind: String = "long ${index_tmp} = ${index};"
	bits_bind: String = "uintptr_t ${bits_tmp} = (uintptr_t)${value};"
	copy_bits: String = "memcpy((char*)${list_tmp}->data + ${index_tmp} * ${width_bytes}, " + "&${bits_tmp}, ${width_bytes});"

	c_statement_expr(list_bind + " " + index_bind + " " + bits_bind + " " + copy_bits)


private pure func render_pointer_store(args: PointerStoreArgs, runtime: StoreRuntime) -> String:
	runtime_fn: String = store_runtime_fn(runtime)
	"${runtime_fn}((blorp_List*)${args.list}, ${args.index}, (void*)${args.value})"


private pure func render_inline_struct_store(
	args: InlineStructStoreArgs,
	runtime: StoreRuntime,
) -> String:
	list: String = args.list
	index: String = args.index
	value: String = args.value
	boxed_value: String = args.boxed_value
	runtime_fn: String = store_runtime_fn(runtime)
	list_tmp: String = args.list_tmp
	index_tmp: String = args.index_tmp
	elem_tmp: String = args.elem_tmp
	struct_ty: String = args.struct_ty
	list_bind: String = "blorp_List* ${list_tmp} = (blorp_List*)${list};"
	index_bind: String = "long ${index_tmp} = ${index};"
	value_bind: String = "${struct_ty} ${elem_tmp} = ${value};"
	inline_condition: String = "if (${list_tmp} && ${list_tmp}->storage_mode == " + "BLORP_LIST_STORAGE_INLINE && ${list_tmp}->elem_size == (int16_t)sizeof(${struct_ty})) "
	inline_store: String = "blorp_list_set_raw_copy(${list_tmp}, ${index_tmp}, &${elem_tmp});"
	fallback_store: String = "${runtime_fn}((blorp_List*)${list_tmp}, ${index_tmp}, (void*)${boxed_value});"
	inline_branch: String = c_block(inline_store)
	fallback_branch: String = c_block(fallback_store)
	store: String = inline_condition + inline_branch + " else " + fallback_branch

	c_statement_expr(list_bind + " " + index_bind + " " + value_bind + " " + store)


private pure func render_handoff_source_slot(args: SourceSlotHandoffArgs) -> String:
	"blorp_list_handoff_set_source_slot((blorp_List*)${args.result}, ${args.out_index}, (blorp_List*)${args.source}, ${args.source_index})"


private pure func render_copy_span_uninit(args: CopySpanUninitArgs) -> String:
	"blorp_list_copy_span_uninit((blorp_List*)${args.dst}, ${args.dst_start}, (blorp_List*)${args.src}, ${args.src_start}, ${args.count})"


private pure func render_ensure_unique(args: EnsureUniqueArgs) -> String:
	list_tmp: String = ensure_unique_list_tmp(args.temp_seed)
	list_bind: String = "blorp_List* ${list_tmp} = (blorp_List*)${args.list};"
	condition: String = "__builtin_expect(${list_tmp} && blorp_is_unique(${list_tmp}), 1)"
	expression: String = "(${condition} ? ${list_tmp} : blorp_list_cow(${list_tmp}));"

	c_statement_expr(list_bind + " " + expression)


private pure func render_ensure_capacity(args: EnsureCapacityArgs) -> String:
	list_tmp: String = ensure_capacity_list_tmp(args.temp_seed)
	capacity_tmp: String = ensure_capacity_min_tmp(args.temp_seed)
	list_bind: String = "blorp_List* ${list_tmp} = (blorp_List*)${args.list};"
	capacity_bind: String = "long ${capacity_tmp} = ${args.capacity};"
	condition: String = "__builtin_expect(${list_tmp} && blorp_is_unique(${list_tmp}) && ${list_tmp}->capacity >= ${capacity_tmp}, 1)"
	expression: String = "(${condition} ? ${list_tmp} : blorp_list_ensure_capacity(${list_tmp}, ${capacity_tmp}));"

	c_statement_expr(list_bind + " " + capacity_bind + " " + expression)


private pure func render_reuse_alloc(args: ReuseAllocArgs) -> String:
	"blorp_list_reuse_alloc(${args.list}, ${args.capacity})"


private pure func render_reuse_alloc_with_release(args: ReuseAllocWithReleaseArgs) -> String:
	result_tmp: String = reuse_alloc_result_tmp(args.temp_seed)
	list_bind: String = "blorp_List* ${result_tmp} = blorp_list_reuse_alloc(${args.list}, ${args.capacity});"
	init_release: String = "blorp_list_init_elem_release(${result_tmp}, blorp_elem_release_fn);"

	c_statement_expr(list_bind + " " + init_release + " " + result_tmp + ";")


private pure func render_list_alloc_pointer(capacity: String) -> String:
	"blorp_list_new(${capacity})"


private pure func render_list_alloc_inline(args: ListAllocInlineArgs) -> String:
	"blorp_list_new_inline(${args.capacity}, ${args.elem_size})"


private pure func render_list_alloc_with_release(args: ListAllocWithReleaseArgs) -> String:
	result_tmp: String = args.result_tmp
	list_bind: String = "blorp_List* ${result_tmp} = ${args.alloc_expr};"
	init_release: String = "blorp_list_init_elem_release(${result_tmp}, blorp_elem_release_fn);"

	c_statement_expr(list_bind + " " + init_release + " " + result_tmp + ";")


private pure func render_retain_for(args: RetainForArgs) -> String:
	"blorp_list_retain_for((blorp_List*)${args.list}, (void*)${args.value})"


private RETAIN_FOR_NOOP_RENDERED: String = "((void)0)"


private pure func render_list_construct_init_elem_release(list: String) -> String:
	"blorp_list_init_elem_release(${list}, blorp_elem_release_fn);"


private pure func render_list_construct_inline_struct_set(
	args: ListConstructInlineStructSetArgs,
) -> String:
	body: String = "${args.struct_ty} ${args.elem_tmp} = ${args.value}; blorp_list_set_raw_copy(${args.list}, ${args.index}, &${args.elem_tmp});"
	c_block(body)


private pure func render_list_construct_set_len(list: String, len: String) -> String:
	"${list}->len = ${len};"


private pure func render_list_construct_append(args: ListConstructAppendArgs) -> String:
	"${args.list} = blorp_list_append(${args.list}, ${args.value});"


private pure func render_list_construct_append_owned(args: ListConstructAppendArgs) -> String:
	"${args.list} = blorp_list_append_owned(${args.list}, ${args.value});"


private pure func render_pointer_swap_body(
	list_tmp: String,
	left_index_tmp: String,
	right_index_tmp: String,
	value_tmp: String,
) -> String:
	load_value: String = "void* ${value_tmp} = blorp_list_get(${list_tmp}, ${left_index_tmp});"
	store_left: String = "blorp_list_set_raw(${list_tmp}, ${left_index_tmp}, blorp_list_get(${list_tmp}, ${right_index_tmp}));"
	store_right: String = "blorp_list_set_raw(${list_tmp}, ${right_index_tmp}, ${value_tmp});"

	load_value + " " + store_left + " " + store_right


private pure func render_swap_expression(
	list: String,
	left_index: String,
	right_index: String,
	list_tmp: String,
	left_index_tmp: String,
	right_index_tmp: String,
	body: String,
) -> String:
	list_bind: String = "blorp_List* ${list_tmp} = (blorp_List*)${list};"
	left_index_bind: String = "long ${left_index_tmp} = ${left_index};"
	right_index_bind: String = "long ${right_index_tmp} = ${right_index};"
	swap_condition: String = "if (__builtin_expect(${list_tmp} && ${left_index_tmp} != ${right_index_tmp}, 1)) "
	swap_branch: String = c_block(body)

	c_statement_expr(
		list_bind + " " + left_index_bind + " " + right_index_bind + " " + swap_condition + swap_branch,
	)


private pure func render_pointer_swap(args: PointerSwapArgs) -> String:
	body: String = render_pointer_swap_body(
		args.list_tmp,
		args.left_index_tmp,
		args.right_index_tmp,
		args.value_tmp,
	)

	render_swap_expression(
		args.list,
		args.left_index,
		args.right_index,
		args.list_tmp,
		args.left_index_tmp,
		args.right_index_tmp,
		body,
	)


private pure func render_inline_bits_swap(args: InlineBitsSwapArgs) -> String:
	base_tmp: String = args.base_tmp
	bits_tmp: String = args.bits_tmp
	list_tmp: String = args.list_tmp
	left_index_tmp: String = args.left_index_tmp
	right_index_tmp: String = args.right_index_tmp
	width_bytes: String = args.width_bytes
	base_bind: String = "char* ${base_tmp} = (char*)${list_tmp}->data;"
	bits_bind: String = "uintptr_t ${bits_tmp} = 0;"
	load_bits: String = "memcpy(&${bits_tmp}, ${base_tmp} + ${left_index_tmp} * ${width_bytes}, ${width_bytes});"
	store_left: String = "memcpy(${base_tmp} + ${left_index_tmp} * ${width_bytes}, ${base_tmp} + ${right_index_tmp} * ${width_bytes}, ${width_bytes});"
	store_right: String = "memcpy(${base_tmp} + ${right_index_tmp} * ${width_bytes}, &${bits_tmp}, ${width_bytes});"
	body: String = base_bind + " " + bits_bind + " " + load_bits + " " + store_left + " " + store_right

	render_swap_expression(
		args.list,
		args.left_index,
		args.right_index,
		list_tmp,
		left_index_tmp,
		right_index_tmp,
		body,
	)


private pure func render_inline_struct_swap(args: InlineStructSwapArgs) -> String:
	list_tmp: String = args.list_tmp
	left_index_tmp: String = args.left_index_tmp
	right_index_tmp: String = args.right_index_tmp
	base_tmp: String = args.base_tmp
	size_tmp: String = args.size_tmp
	left_slot_tmp: String = args.left_slot_tmp
	right_slot_tmp: String = args.right_slot_tmp
	bytes_tmp: String = args.bytes_tmp
	base_bind: String = "char* ${base_tmp} = (char*)${list_tmp}->data;"
	size_bind: String = "size_t ${size_tmp} = (size_t)${list_tmp}->elem_size;"
	left_slot_bind: String = "void* ${left_slot_tmp} = ${base_tmp} + ${left_index_tmp} * ${size_tmp};"
	right_slot_bind: String = "void* ${right_slot_tmp} = ${base_tmp} + ${right_index_tmp} * ${size_tmp};"
	bytes_bind: String = "unsigned char ${bytes_tmp}[${size_tmp}];"
	load_bytes: String = "memcpy(${bytes_tmp}, ${left_slot_tmp}, ${size_tmp});"
	store_left: String = "memcpy(${left_slot_tmp}, ${right_slot_tmp}, ${size_tmp});"
	store_right: String = "memcpy(${right_slot_tmp}, ${bytes_tmp}, ${size_tmp});"
	inline_body: String = base_bind + " " + size_bind + " " + left_slot_bind + " " + right_slot_bind + " " + bytes_bind + " " + load_bytes + " " + store_left + " " + store_right
	inline_branch: String = c_block(inline_body)
	fallback_body: String = render_pointer_swap_body(
		list_tmp,
		left_index_tmp,
		right_index_tmp,
		args.value_tmp,
	)
	fallback_branch: String = c_block(fallback_body)
	storage_check: String = "if (${list_tmp}->storage_mode == BLORP_LIST_STORAGE_INLINE) "
	body: String = storage_check + inline_branch + " else " + fallback_branch

	render_swap_expression(
		args.list,
		args.left_index,
		args.right_index,
		list_tmp,
		left_index_tmp,
		right_index_tmp,
		body,
	)


private pure func render_inline_struct_load_body(args: InlineStructLoadArgs) -> String:
	list_tmp: String = args.list_tmp
	index_tmp: String = args.index_tmp
	out_tmp: String = args.out_tmp
	raw_tmp: String = args.raw_tmp
	struct_ty: String = args.struct_ty
	storage_check: String = "if (${list_tmp}->storage_mode == BLORP_LIST_STORAGE_INLINE " + "&& ${list_tmp}->elem_size == (int16_t)sizeof(${struct_ty})) "

	inline_copy: String = "memcpy(&${out_tmp}, (char*)${list_tmp}->data + ${index_tmp} " + "* sizeof(${struct_ty}), sizeof(${struct_ty}));"

	fallback_get: String = "void* ${raw_tmp} = blorp_list_get(${list_tmp}, ${index_tmp});"
	null_check: String = "if (!${raw_tmp}) "
	zero_out: String = "memset(&${out_tmp}, 0, sizeof(${struct_ty}));"
	unbox_out: String = "${out_tmp} = blorp_unbox_struct(${raw_tmp}, ${struct_ty});"
	inline_branch: String = c_block(inline_copy)
	null_branch: String = c_block(zero_out)
	unbox_branch: String = c_block(unbox_out)
	fallback_choice: String = null_check + null_branch + " else " + unbox_branch
	fallback_branch: String = c_block(fallback_get + " " + fallback_choice)

	storage_check + inline_branch + " else " + fallback_branch


private pure func render_inline_struct_checked_load(args: InlineStructLoadArgs) -> String:
	list_tmp: String = args.list_tmp
	index_tmp: String = args.index_tmp
	out_tmp: String = args.out_tmp
	struct_ty: String = args.struct_ty
	bounds_check: String = "if (__builtin_expect(!${list_tmp} || ${index_tmp} < 0 " + "|| ${index_tmp} >= ${list_tmp}->len, 0)) "

	zero_out: String = "memset(&${out_tmp}, 0, sizeof(${struct_ty}));"
	bounds_branch: String = c_block(zero_out)
	bounds: String = bounds_check + bounds_branch + " else "

	bounds + render_inline_struct_load_body(args)


pure func render_prepared_list_op(op: PreparedListOp) -> String:
	match op:
		PointerGet(list, index): render_runtime_get(list, index)
		InlineCheckedGet(args): render_inline_checked_get(args)
		InlineProvenGet(args): render_inline_proven_get(args)
		InlineBitsLoad(args): render_inline_bits_load(args)
		InlineBitsStore(args): render_inline_bits_store(args)
		PointerSetRawStore(args): render_pointer_store(args, SetRawStoreRuntime)
		PointerHandoffSetOwnedStore(args):
			render_pointer_store(args, HandoffSetOwnedStoreRuntime)
		InlineStructSetRawStore(args): render_inline_struct_store(args, SetRawStoreRuntime)
		InlineStructHandoffSetOwnedStore(args): render_inline_struct_store(
			args,
			HandoffSetOwnedStoreRuntime,
		)
		PointerSwap(args): render_pointer_swap(args)
		InlineBitsSwap(args): render_inline_bits_swap(args)
		InlineStructSwap(args): render_inline_struct_swap(args)
		InlineStructLoadChecked(args): render_inline_struct_checked_load(args)
		InlineStructLoadProven(args): render_inline_struct_load_body(args)
		HandoffSetSourceSlot(args): render_handoff_source_slot(args)
		CopySpanUninit(args): render_copy_span_uninit(args)
		EnsureUnique(args): render_ensure_unique(args)
		EnsureCapacity(args): render_ensure_capacity(args)
		ReuseAlloc(args): render_reuse_alloc(args)
		ReuseAllocWithRelease(args): render_reuse_alloc_with_release(args)
		ListAllocPointer(capacity): render_list_alloc_pointer(capacity)
		ListAllocInline(args): render_list_alloc_inline(args)
		ListAllocWithRelease(args): render_list_alloc_with_release(args)
		RetainFor(args): render_retain_for(args)
		RetainForNoop: RETAIN_FOR_NOOP_RENDERED
		ListConstructInitElemRelease(list): render_list_construct_init_elem_release(list)
		ListConstructInlineStructSet(args): render_list_construct_inline_struct_set(args)
		ListConstructSetLen(list, len): render_list_construct_set_len(list, len)
		ListConstructAppend(args): render_list_construct_append(args)
		ListConstructAppendOwned(args): render_list_construct_append_owned(args)


pure func build_prepared_list_op(
	info: PreparedListTemplateInfo,
	args: List[String],
) -> Result[PreparedListOp, RenderError]:
	match info.template:
		ListGetPointerTemplate:
			op ?= parse_pointer_get_op(args).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		ListGetInlineCheckedTemplate:
			parsed ?= parse_inline_get_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(InlineCheckedGet(parsed))
		ListGetInlineProvenTemplate:
			parsed ?= parse_inline_get_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(InlineProvenGet(parsed))
		ListInlineBitsLoadTemplate:
			parsed ?= parse_inline_bits_load_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(InlineBitsLoad(parsed))
		ListInlineBitsStoreTemplate:
			parsed ?= parse_inline_bits_store_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(InlineBitsStore(parsed))
		ListPointerSetRawStoreTemplate:
			parsed ?= parse_pointer_store_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(PointerSetRawStore(parsed))
		ListPointerHandoffSetOwnedStoreTemplate:
			parsed ?= parse_pointer_store_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(PointerHandoffSetOwnedStore(parsed))
		ListInlineStructSetRawStoreTemplate:
			parsed ?= parse_inline_struct_store_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructSetRawStore(parsed))
		ListInlineStructHandoffSetOwnedStoreTemplate:
			parsed ?= parse_inline_struct_store_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructHandoffSetOwnedStore(parsed))
		ListPointerSwapTemplate:
			parsed ?= parse_pointer_swap_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(PointerSwap(parsed))
		ListInlineBitsSwapTemplate:
			parsed ?= parse_inline_bits_swap_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(InlineBitsSwap(parsed))
		ListInlineStructSwapTemplate:
			parsed ?= parse_inline_struct_swap_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructSwap(parsed))
		ListInlineStructLoadCheckedTemplate:
			parsed ?= parse_inline_struct_load_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructLoadChecked(parsed))
		ListInlineStructLoadProvenTemplate:
			parsed ?= parse_inline_struct_load_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructLoadProven(parsed))
		ListHandoffSetSourceSlotTemplate:
			parsed ?= parse_source_slot_handoff_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(HandoffSetSourceSlot(parsed))
		ListCopySpanUninitTemplate:
			parsed ?= parse_copy_span_uninit_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(CopySpanUninit(parsed))
		ListEnsureUniqueTemplate:
			parsed ?= parse_ensure_unique_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(EnsureUnique(parsed))
		ListEnsureCapacityTemplate:
			parsed ?= parse_ensure_capacity_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(EnsureCapacity(parsed))
		ListReuseAllocTemplate:
			parsed ?= parse_reuse_alloc_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(ReuseAlloc(parsed))
		ListReuseAllocWithReleaseTemplate:
			parsed ?= parse_reuse_alloc_with_release_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ReuseAllocWithRelease(parsed))
		ListAllocPointerTemplate:
			capacity ?= parse_list_alloc_pointer_arg(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListAllocPointer(capacity))
		ListAllocInlineTemplate:
			parsed ?= parse_list_alloc_inline_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(ListAllocInline(parsed))
		ListAllocWithReleaseTemplate:
			parsed ?= parse_list_alloc_with_release_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListAllocWithRelease(parsed))
		ListRetainForTemplate:
			parsed ?= parse_retain_for_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(RetainFor(parsed))
		ListRetainForNoopTemplate:
			op ?= parse_retain_for_noop(args).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		ListConstructInitElemReleaseTemplate:
			list ?= parse_list_construct_init_elem_release_arg(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListConstructInitElemRelease(list))
		ListConstructInlineStructSetTemplate:
			parsed ?= parse_list_construct_inline_struct_set_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListConstructInlineStructSet(parsed))
		ListConstructSetLenTemplate:
			op ?= parse_list_construct_set_len_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		ListConstructAppendTemplate:
			parsed ?= parse_list_construct_append_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListConstructAppend(parsed))
		ListConstructAppendOwnedTemplate:
			parsed ?= parse_list_construct_append_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(ListConstructAppendOwned(parsed))


pure func render_prepared_list(name: String, args: List[String]) -> Result[String, RenderError]:
	match parse_prepared_list_template(name):
		Some(info):
			match build_prepared_list_op(info, args):
				Ok(op): Ok(render_prepared_list_op(op))
				Err(error): Err(error)
		None: Err(UnsupportedPreparedListOp(name))


private PLACEHOLDER_INLINE_GET_ARGS: InlineGetArgs = {
	list = "@0@",
	index = "@1@",
	temp_seed = "@2@",
	width_bytes = "@3@"
}


private pure func placeholder_prepared_list_op(info: PreparedListTemplateInfo) -> PreparedListOp:
	match info.template:
		ListGetPointerTemplate: PointerGet("@0@", "@1@")
		ListGetInlineCheckedTemplate: InlineCheckedGet(PLACEHOLDER_INLINE_GET_ARGS)
		ListGetInlineProvenTemplate: InlineProvenGet(PLACEHOLDER_INLINE_GET_ARGS)
		ListInlineBitsLoadTemplate:
			InlineBitsLoad({
				list_tmp = "@0@",
				index_tmp = "@1@",
				bits_tmp = "@2@",
				width_bytes = "@3@",
			})
		ListInlineBitsStoreTemplate:
			InlineBitsStore({
				list = "@0@",
				index = "@1@",
				value = "@2@",
				temp_seed = "@3@",
				width_bytes = "@4@",
			})
		ListPointerSetRawStoreTemplate:
			PointerSetRawStore({
				list = "@0@",
				index = "@1@",
				value = "@2@",
			})
		ListPointerHandoffSetOwnedStoreTemplate:
			PointerHandoffSetOwnedStore({
				list = "@0@",
				index = "@1@",
				value = "@2@",
			})
		ListInlineStructSetRawStoreTemplate:
			InlineStructSetRawStore({
				list = "@0@",
				index = "@1@",
				value = "@2@",
				boxed_value = "@3@",
				list_tmp = "@4@",
				index_tmp = "@5@",
				elem_tmp = "@6@",
				struct_ty = "@7@",
			})
		ListInlineStructHandoffSetOwnedStoreTemplate:
			InlineStructHandoffSetOwnedStore({
				list = "@0@",
				index = "@1@",
				value = "@2@",
				boxed_value = "@3@",
				list_tmp = "@4@",
				index_tmp = "@5@",
				elem_tmp = "@6@",
				struct_ty = "@7@",
			})
		ListPointerSwapTemplate:
			PointerSwap({
				list = "@0@",
				left_index = "@1@",
				right_index = "@2@",
				list_tmp = "@3@",
				left_index_tmp = "@4@",
				right_index_tmp = "@5@",
				value_tmp = "@6@",
			})
		ListInlineBitsSwapTemplate:
			InlineBitsSwap({
				list = "@0@",
				left_index = "@1@",
				right_index = "@2@",
				list_tmp = "@3@",
				left_index_tmp = "@4@",
				right_index_tmp = "@5@",
				base_tmp = "@6@",
				bits_tmp = "@7@",
				width_bytes = "@8@",
			})
		ListInlineStructSwapTemplate:
			InlineStructSwap({
				list = "@0@",
				left_index = "@1@",
				right_index = "@2@",
				list_tmp = "@3@",
				left_index_tmp = "@4@",
				right_index_tmp = "@5@",
				base_tmp = "@6@",
				size_tmp = "@7@",
				left_slot_tmp = "@8@",
				right_slot_tmp = "@9@",
				bytes_tmp = "@10@",
				value_tmp = "@11@",
			})
