private TEMPLATES_BY_NAME: Dict[String, PreparedListTemplateInfo] = templates_by_name(ALL_TEMPLATES)

private OPEN_BRACE: String = "{"

private CLOSE_BRACE: String = "}"

private LIST_STORAGE_MODE_POINTER: String = "BLORP_LIST_STORAGE_POINTER"

private LIST_STORAGE_MODE_INLINE: String = "BLORP_LIST_STORAGE_INLINE"

private LIST_ELEMENT_SIZE_POINTER: String = "sizeof(void*)"

private LIST_ELEMENT_RELEASE_FN: String = "blorp_elem_release_fn"

private LIST_ELEMENT_RELEASE_NONE: String = "NULL"


private pure func c_block(body: String) -> String:
	OPEN_BRACE + " " + body + " " + CLOSE_BRACE


private pure func c_statement_expr(body: String) -> String:
	"(" + c_block(body) + ")"


private pure func owned_arg(arg: String) -> String:
	var result: String = make_string(arg.length())
	var i: Int = 0

	while i < arg.length():
		match arg.get(i):
			Some(c):
				result = result.append_char(c)
			None:
				void

		i += 1

	result


pure func prepared_list_template_name(info: PreparedListTemplateInfo) -> String:
	info.name


pure func prepared_list_template_arity(info: PreparedListTemplateInfo) -> Int:
	info.arity


pure func parse_prepared_list_template(name: String) -> Option[PreparedListTemplateInfo]:
	TEMPLATES_BY_NAME.get(name)


pure func render_error_to_string(error: RenderError) -> String:
	match error:
		WrongArity(info, got):
			render_template_arity_error("prepared list op", info.name, info.arity, got)
		UnsupportedPreparedListOp(name):
			render_unsupported_template_error("prepared list op", name)


pure func wrong_arity_for_args(info: PreparedListTemplateInfo, args: List[String]) -> RenderError:
	WrongArity(info, args.length())


private pure func parse_pointer_get_op(args: List[String]) -> Option[PreparedListOp]:
	match args:
		[list, index]:
			Some(PointerGet(list, index))
		_:
			None


private pure func parse_inline_get_args(args: List[String]) -> Option[InlineGetArgs]:
	match args:
		[list, index, temp_seed, width_bytes]:
			Some({
				list = list,
				index = index,
				temp_seed = temp_seed,
				width_bytes = width_bytes,
			})
		_:
			None


private pure func parse_inline_struct_load_args(args: List[String]) -> Option[InlineStructLoadArgs]:
	match args:
		[list_tmp, index_tmp, out_tmp, temp_seed, struct_ty]:
			Some({
				list_tmp = owned_arg(list_tmp),
				index_tmp = owned_arg(index_tmp),
				out_tmp = owned_arg(out_tmp),
				temp_seed = owned_arg(temp_seed),
				struct_ty = owned_arg(struct_ty),
			})
		_:
			None


private pure func parse_inline_bits_load_args(args: List[String]) -> Option[InlineBitsLoadArgs]:
	match args:
