pure func render_manifest_line(info: PreparedListTemplateInfo) -> String:
	name: String = prepared_list_template_name(info)
	arity: Int = prepared_list_template_arity(info)
	body: String = render_prepared_list_op(placeholder_prepared_list_op(info))
	"${name}\t${arity}\t${body}"


pure func render_manifest_lines() -> List[String]:
	ALL_TEMPLATES.map(render_manifest_line)


func print_manifest() -> Void:
	for line in render_manifest_lines():
		print(line)


func print_result(result: Result[String, RenderError]) -> Int:
	match result:
		Ok(rendered):
			puts(rendered)
			0
		Err(error):
			print(render_error_to_string(error))
			1


func main(args: List[String]) -> Int:
	match args:
		[program_name, command_name, ...command_args]:
			match parse_command(command_name):
				RenderPreparedListCommand:
					match command_args:
						[name, ...rendered_args]: print_result(
							render_prepared_list(
								name,
								rendered_args,
							),
						)
						[]:
							print(USAGE)
							1
				RenderManifestCommand:
					print_manifest()
					0
				UnknownCommand:
					print(USAGE)
					1
		[]:
			print(USAGE)
			1
		[program_name]:
			print(USAGE)
			1
