-- Function-level profile of the self-hosted typecheck_graph path.
--
-- Usage:
--   benchmarks/compiler_typecheck_profile
--   benchmarks/compiler_typecheck_profile 2 2 64 128 fallback
--   benchmarks/compiler_typecheck_profile 1 8 32 64 mixed 4
--   benchmarks/compiler_typecheck_profile 20 16 64 128 alias
--   benchmarks/compiler_typecheck_profile 256 16 64 1 alias-register
--
-- Positional controls: iterations, modules, type depth, probes per module,
-- workload mode (`retained`, `fallback`, `mixed`, `alias`, or
-- `alias-register`), and optional mixed-workload import fan-out.
-- Alias mode treats modules as alias depth and probes per module as resolutions
-- per iteration. Alias-register treats modules as aliases per environment and
-- uses type depth as the structural target depth.
import:
	compiler_alias_resolution_profile_fixture:
		CompilerAliasRegistrationBenchmarkConfig,
		CompilerAliasRegistrationBenchmarkResult,
		CompilerAliasResolutionBenchmarkConfig,
		CompilerAliasResolutionBenchmarkResult,
		compiler_alias_registration_benchmark_fixture,
		compiler_alias_registration_benchmark_with_fixture,
		compiler_alias_resolution_benchmark_fixture,
		compiler_alias_resolution_benchmark_with_fixture,
	compiler_type_header_mixed_profile_fixture:
		CompilerMixedTypeHeaderBenchmarkConfig,
		CompilerMixedTypeHeaderBenchmarkResult,
		compiler_mixed_type_header_benchmark_request,
		compiler_mixed_type_header_benchmark_with_request,
	compiler_typecheck_profile_fixture:
		CompilerTypecheckBenchmarkConfig,
		CompilerTypecheckBenchmarkResult,
		compiler_typecheck_benchmark_request,
		compiler_typecheck_benchmark_with_request,
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func retain_parsed_programs_argument(args: List[String], index: Int) -> Bool:
	match args.get(index):
		Some("fallback"):
			False
		_:
			True


private func run_typecheck_profile(args: List[String]) -> Int:
	config: CompilerTypecheckBenchmarkConfig = {
		iterations = positive_argument(args, 1, 1),
		module_count = positive_argument(args, 2, 1),
		type_depth = positive_argument(args, 3, 64),
		probes_per_module = positive_argument(args, 4, 128),
		retain_parsed_programs = retain_parsed_programs_argument(args, 5)
	}
	setup_started: Int = now_microseconds()
	request = compiler_typecheck_benchmark_request(config)
	setup_microseconds: Int = now_microseconds() - setup_started
	started: Int = now_microseconds()
	result: CompilerTypecheckBenchmarkResult = compiler_typecheck_benchmark_with_request(
		config,
		request,
	)
	elapsed_microseconds: Int = now_microseconds() - started
	print(
		"TYPECHECK_PROFILE_BENCH" + " iterations=" + config.iterations.to_string() + " modules=" + config.module_count.to_string() + " type_depth=" + config.type_depth.to_string() + " probes_per_module=" + config.probes_per_module.to_string() + " retain_parsed_programs=" + config.retain_parsed_programs.to_string() + " artifacts=" + result.artifact_count.to_string() + " source_declarations=" + result.source_declaration_count.to_string() + " typed_declarations=" + result.typed_declaration_count.to_string() + " errors=" + result.error_count.to_string() + " workload_valid=" + result.workload_valid.to_string() + " checksum=" + result.checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string(),
	)

	if result.error_count == 0 and result.workload_valid:
		0
	else:
		1


private func run_mixed_type_header_profile(args: List[String]) -> Int:
	config: CompilerMixedTypeHeaderBenchmarkConfig = {
		iterations = positive_argument(args, 1, 1),
		module_count = positive_argument(args, 2, 8),
		shapes_per_module = positive_argument(args, 3, 32),
		probes_per_module = positive_argument(args, 4, 64),
		import_fanout = positive_argument(args, 6, 4),
		retain_parsed_programs = True
	}
	setup_started: Int = now_microseconds()
	request = compiler_mixed_type_header_benchmark_request(config)
	setup_microseconds: Int = now_microseconds() - setup_started
	started: Int = now_microseconds()
	result: CompilerMixedTypeHeaderBenchmarkResult = compiler_mixed_type_header_benchmark_with_request(
		config,
		request,
	)
	elapsed_microseconds: Int = now_microseconds() - started
	print(
		"MIXED_TYPE_HEADER_PROFILE" + " iterations=" + config.iterations.to_string() + " modules=" + config.module_count.to_string() + " shapes_per_module=" + config.shapes_per_module.to_string() + " probes_per_module=" + config.probes_per_module.to_string() + " import_fanout=" + config.import_fanout.to_string() + " artifacts=" + result.artifact_count.to_string() + " source_declarations=" + result.source_declaration_count.to_string() + " typed_declarations=" + result.typed_declaration_count.to_string() + " resolved_imports=" + result.resolved_import_count.to_string() + " records=" + result.record_count.to_string() + " aliases=" + result.alias_count.to_string() + " unions=" + result.union_count.to_string() + " functions=" + result.function_count.to_string() + " private_declarations=" + result.private_count.to_string() + " errors=" + result.error_count.to_string() + " workload_valid=" + result.workload_valid.to_string() + " checksum=" + result.checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string(),
	)

	if result.error_count == 0 and result.workload_valid:
		0
	else:
		1


private func run_alias_resolution_profile(args: List[String]) -> Int:
	config: CompilerAliasResolutionBenchmarkConfig = {
		iterations = positive_argument(args, 1, 20),
		alias_depth = positive_argument(args, 2, 16),
		type_depth = positive_argument(args, 3, 64),
		resolutions_per_iteration = positive_argument(args, 4, 128)
	}
	fixture = compiler_alias_resolution_benchmark_fixture(config)
	started: Int = now_microseconds()
	result: CompilerAliasResolutionBenchmarkResult = compiler_alias_resolution_benchmark_with_fixture(
		config,
		fixture,
	)

	elapsed_microseconds: Int = now_microseconds() - started
	print(
		"ALIAS_RESOLUTION_PROFILE_BENCH" + " iterations=" + config.iterations.to_string() + " alias_depth=" + config.alias_depth.to_string() + " type_depth=" + config.type_depth.to_string() + " resolutions_per_iteration=" + config.resolutions_per_iteration.to_string() + " alias_count=" + result.alias_count.to_string() + " target_node_count=" + result.target_node_count.to_string() + " resolution_count=" + result.resolution_count.to_string() + " expected_alias_expansions=" + result.expected_alias_expansion_count.to_string() + " expected_result_nodes=" + result.expected_result_node_count.to_string() + " checksum=" + result.checksum.to_string() + " workload_valid=" + result.workload_valid.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string(),
	)

	if result.workload_valid:
		0
	else:
		1


private func run_alias_registration_profile(args: List[String]) -> Int:
	config: CompilerAliasRegistrationBenchmarkConfig = {
		iterations = positive_argument(args, 1, 256),
		alias_count = positive_argument(args, 2, 16),
		type_depth = positive_argument(args, 3, 64)
	}
	fixture = compiler_alias_registration_benchmark_fixture(config)
	started: Int = now_microseconds()
	result: CompilerAliasRegistrationBenchmarkResult = compiler_alias_registration_benchmark_with_fixture(
		config,
		fixture,
	)

	elapsed_microseconds: Int = now_microseconds() - started
	print(
		"ALIAS_REGISTRATION_PROFILE_BENCH" + " iterations=" + config.iterations.to_string() + " alias_count=" + config.alias_count.to_string() + " type_depth=" + config.type_depth.to_string() + " target_node_count=" + result.target_node_count.to_string() + " registration_count=" + result.registration_count.to_string() + " baseline_registration_copy_nodes=" + result.baseline_registration_copy_node_count.to_string() + " checksum=" + result.checksum.to_string() + " workload_valid=" + result.workload_valid.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string(),
	)

	if result.workload_valid:
		0
	else:
		1


func main(args: List[String]) -> Int:
	match args.get(5):
		Some("mixed"):
			run_mixed_type_header_profile(args)
		Some("alias-register"):
			run_alias_registration_profile(args)
		Some("alias"):
			run_alias_resolution_profile(args)
		_:
			run_typecheck_profile(args)
