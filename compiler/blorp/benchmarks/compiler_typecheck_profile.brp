-- Function-level profile of the self-hosted typecheck_graph path.
--
-- Usage:
--   benchmarks/compiler_typecheck_profile
--   benchmarks/compiler_typecheck_profile 2 2 64 128
--
-- Positional controls: iterations, modules, type depth, probes per module.
import:
	compiler_typecheck_profile_fixture:
		CompilerTypecheckBenchmarkConfig,
		CompilerTypecheckBenchmarkResult,
		compiler_typecheck_benchmark,
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


func main(args: List[String]) -> Int:
	config: CompilerTypecheckBenchmarkConfig = {
		iterations = positive_argument(args, 1, 1),
		module_count = positive_argument(args, 2, 1),
		type_depth = positive_argument(args, 3, 64),
		probes_per_module = positive_argument(args, 4, 128)
	}
	started: Int = now_microseconds()
	result: CompilerTypecheckBenchmarkResult = compiler_typecheck_benchmark(config)
	elapsed_microseconds: Int = now_microseconds() - started
	print(
		"TYPECHECK_PROFILE_BENCH" + " iterations=" + config.iterations.to_string() + " modules=" + config.module_count.to_string() + " type_depth=" + config.type_depth.to_string() + " probes_per_module=" + config.probes_per_module.to_string() + " artifacts=" + result.artifact_count.to_string() + " source_declarations=" + result.source_declaration_count.to_string() + " typed_declarations=" + result.typed_declaration_count.to_string() + " errors=" + result.error_count.to_string() + " workload_valid=" + result.workload_valid.to_string() + " checksum=" + result.checksum.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string(),
	)

	if result.error_count == 0 and result.workload_valid:
		0
	else:
		1
