-- Deterministic alias-chain workload for profiling full alias resolution.
import:
	../src/stage_05_types/compiler_env:
		Env,
		env_add_alias,
		env_empty,
		env_get_alias,
		env_resolve_alias,
	../src/stage_05_types/compiler_type:
		CompilerType(CompilerNamedType, CompilerTupleType),
		compiler_type_int,
		compiler_types_equal,


record CompilerAliasResolutionBenchmarkConfig {
	iterations: Int,
	alias_depth: Int,
	type_depth: Int,
	resolutions_per_iteration: Int
}


record CompilerAliasRegistrationBenchmarkConfig {
	iterations: Int,
	alias_count: Int,
	type_depth: Int
}


record CompilerAliasResolutionBenchmarkFixture {
	env: Env,
	top_alias: CompilerType,
	target: CompilerType,
	target_node_count: Int
}


record CompilerAliasRegistrationBenchmarkFixture {
	target: CompilerType,
	target_node_count: Int
}


record CompilerAliasResolutionBenchmarkResult {
	alias_count: Int,
	target_node_count: Int,
	resolution_count: Int,
	expected_alias_expansion_count: Int,
	expected_result_node_count: Int,
	checksum: Int,
	workload_valid: Bool
}


record CompilerAliasRegistrationBenchmarkResult {
	alias_count: Int,
	target_node_count: Int,
	registration_count: Int,
	baseline_registration_copy_node_count: Int,
	checksum: Int,
	workload_valid: Bool
}


private pure func benchmark_alias_name(alias_index: Int) -> String:
	"BenchAlias" + alias_index.to_string()


private pure func benchmark_alias_target(type_depth: Int) -> CompilerType:
	var target: CompilerType = compiler_type_int()

	for _ in 0..type_depth:
		target = CompilerTupleType([target, compiler_type_int()])

	target


pure func compiler_alias_resolution_benchmark_fixture(
	config: CompilerAliasResolutionBenchmarkConfig,
) -> CompilerAliasResolutionBenchmarkFixture:
	target = benchmark_alias_target(config.type_depth)
	var env = env_empty()

	for alias_index in 0..config.alias_depth:
		alias_target: CompilerType = if alias_index == 0:
			target
		else:
			CompilerNamedType(benchmark_alias_name(alias_index - 1), [])

		env = env_add_alias(env, benchmark_alias_name(alias_index), [], alias_target)

	{
		env = env,
		top_alias = CompilerNamedType(benchmark_alias_name(config.alias_depth - 1), []),
		target = target,
		target_node_count = config.type_depth * 2 + 1
	}


pure func compiler_alias_registration_benchmark_fixture(
	config: CompilerAliasRegistrationBenchmarkConfig,
) -> CompilerAliasRegistrationBenchmarkFixture:
	{
		target = benchmark_alias_target(config.type_depth),
		target_node_count = config.type_depth * 2 + 1
	}


pure func compiler_alias_resolution_benchmark_with_fixture(
	config: CompilerAliasResolutionBenchmarkConfig,
	fixture: CompilerAliasResolutionBenchmarkFixture,
) -> CompilerAliasResolutionBenchmarkResult:
	resolution_count = config.iterations * config.resolutions_per_iteration
	var checksum: Int = 0
	var workload_valid: Bool = (
		config.iterations > 0
		and config.alias_depth > 0
		and config.type_depth > 0
		and config.resolutions_per_iteration > 0
	)

	for _ in 0..config.iterations:
		for _ in 0..config.resolutions_per_iteration:
			resolved = env_resolve_alias(fixture.env, fixture.top_alias)

			if compiler_types_equal(resolved, fixture.target):
				checksum += fixture.target_node_count
			else:
				workload_valid = False

	{
		alias_count = config.alias_depth,
		target_node_count = fixture.target_node_count,
		resolution_count = resolution_count,
		expected_alias_expansion_count = resolution_count * config.alias_depth,
		expected_result_node_count = resolution_count * fixture.target_node_count,
		checksum = checksum,
		workload_valid = workload_valid
	}


pure func compiler_alias_registration_benchmark_with_fixture(
	config: CompilerAliasRegistrationBenchmarkConfig,
	fixture: CompilerAliasRegistrationBenchmarkFixture,
) -> CompilerAliasRegistrationBenchmarkResult:
	registration_count = config.iterations * config.alias_count
	var checksum: Int = 0
	var workload_valid: Bool = (
		config.iterations > 0
		and config.alias_count > 0
		and config.type_depth > 0
	)

	for _ in 0..config.iterations:
		var env = env_empty()

		for alias_index in 0..config.alias_count:
			env = env_add_alias(env, benchmark_alias_name(alias_index), [], fixture.target)

		match env_get_alias(env, benchmark_alias_name(config.alias_count - 1)):
			Some((type_params, stored_target)):
				if (
					type_params.length() == 0
					and compiler_types_equal(stored_target, fixture.target)
				):
					checksum += fixture.target_node_count
				else:
					workload_valid = False
			None:
				workload_valid = False

	{
		alias_count = config.alias_count,
		target_node_count = fixture.target_node_count,
		registration_count = registration_count,
		baseline_registration_copy_node_count = registration_count * fixture.target_node_count,
		checksum = checksum,
		workload_valid = workload_valid
	}


pure func compiler_alias_resolution_benchmark(
	config: CompilerAliasResolutionBenchmarkConfig,
) -> CompilerAliasResolutionBenchmarkResult:
	fixture = compiler_alias_resolution_benchmark_fixture(config)
	compiler_alias_resolution_benchmark_with_fixture(config, fixture)


pure func compiler_alias_registration_benchmark(
	config: CompilerAliasRegistrationBenchmarkConfig,
) -> CompilerAliasRegistrationBenchmarkResult:
	fixture = compiler_alias_registration_benchmark_fixture(config)
	compiler_alias_registration_benchmark_with_fixture(config, fixture)
