import:
	../src/stage_06_typecheck/typecheck_bridge:
		handle_request_value,
		stream_typecheck_graph_request_chunks,
		stream_typecheck_graph_request_chunks_with_inventory,
	../src/stage_06_typecheck/typecheck_trace: TypecheckTracePhase, typecheck_trace_phase_name
	../src/stage_12_cli/bridge_protocol:
		BridgeAction(TypecheckSourceAction),
		BridgeEnvelope,
		BridgeProtocolError(InvalidJson),
		bridge_error_json,
		bridge_failure_json,
		decode_bridge_envelope_value,
	fs: message, open_read, read_text
	io: print, print_error, puts
	json: JsonValue(JsonBool, JsonNumber, JsonObject, JsonString), as_string, get_field, parse_json
	memory: get_mem_stats, reset_mem_stats
	system: getenv, now_microseconds


func read_text_file(path: String) -> Result[String, String]:
	with reader ?= open_read(path) on err => message(err):
		match reader.read_text():
			Ok(request):
				Ok(request)
			Err(err):
				Err(message(err))


pure func source_read_error_json(path: String, error_message: String) -> JsonValue:
	bridge_failure_json(
		"source_read_error",
		"failed to read source file `${path}`: ${error_message}",
	)


pure func json_has_field(value: JsonValue, name: String) -> Bool:
	match get_field(value, name):
		Some(_):
			True
		None:
			False


pure func payload_with_text(payload: JsonValue, text: String) -> JsonValue:
	match payload:
		JsonObject(fields):
			var result: List[(String, JsonValue)] = []
			var replaced: Bool = False

			for field in fields:
				if field[0] == "text":
					result = result.append(("text", JsonString(text)))
					replaced = True
				else:
					result = result.append(field)

			if replaced:
				JsonObject(result)
			else:
				JsonObject(result.append(("text", JsonString(text))))
		_:
			payload


pure func bridge_root_with_payload(envelope: BridgeEnvelope, payload: JsonValue) -> JsonValue:
	JsonObject([
		("schema", JsonNumber(to_float(envelope.schema))),
		("domain", JsonString(envelope.domain)),
		("action", JsonString(envelope.action_name)),
		("payload", payload),
	])


func enrich_typecheck_source_request(envelope: BridgeEnvelope) -> Result[JsonValue, JsonValue]:
	if json_has_field(envelope.payload, "text"):
		Ok(bridge_root_with_payload(envelope, envelope.payload))
	else:
		match get_field(envelope.payload, "path"):
			Some(path_value):
				match as_string(path_value):
					Some(path):
						match read_text_file(path):
							Ok(source):
								Ok(
									bridge_root_with_payload(
										envelope,
										payload_with_text(envelope.payload, source),
									),
								)
							Err(read_error):
								Err(source_read_error_json(path, read_error))
					None:
						Ok(bridge_root_with_payload(envelope, envelope.payload))
			None:
				Ok(bridge_root_with_payload(envelope, envelope.payload))


func prepare_request_value_for_cli(root: JsonValue) -> Result[JsonValue, JsonValue]:
	match decode_bridge_envelope_value(root):
		Ok(envelope):
			if envelope.action == TypecheckSourceAction:
				enrich_typecheck_source_request(envelope)
			else:
				Ok(root)
		Err(_):
			Ok(root)


func emit_response_chunk(response: String):
	puts(response)


func emit_typecheck_trace(phase: TypecheckTracePhase, declaration_index: Int, module_name: String):
	match getenv("BLORP_COMPILER_TYPECHECK_TRACE"):
		Some(_):
			phase_name: String = typecheck_trace_phase_name(phase, declaration_index)
			timestamp_microseconds = now_microseconds()

			match getenv("BLORP_COMPILER_TYPECHECK_MEMSTATS"):
				Some(_):
					stats = get_mem_stats()
					print_error(
						"[typecheck-phase] phase=${phase_name} module=${module_name} " + "timestamp_microseconds=${timestamp_microseconds} " + "total_allocations=${stats.total_allocations} " + "total_releases=${stats.total_releases} " + "current_objects=${stats.current_objects} " + "bytes_allocated=${stats.bytes_allocated}",
					)
				None:
					print_error(
						"[typecheck-phase] phase=${phase_name} module=${module_name} " + "timestamp_microseconds=${timestamp_microseconds}",
					)
		None:
			void


func emit_typecheck_inventory(kind: String, fields: String):
	print_error("[typecheck-inventory] kind=${kind} ${fields}")


func print_cli_request_response(request: String):
	match getenv("BLORP_COMPILER_TYPECHECK_MEMSTATS"):
		Some(_):
			reset_mem_stats()
		None:
			void

	match parse_json(request):
		Ok(root):
			match prepare_request_value_for_cli(root):
				Ok(prepared):
					streamed: Bool = match getenv("BLORP_COMPILER_TYPECHECK_INVENTORY"):
						Some(_):
							stream_typecheck_graph_request_chunks_with_inventory(
								prepared,
								emit_response_chunk,
								emit_typecheck_trace,
								emit_typecheck_inventory,
							)
						None:
							stream_typecheck_graph_request_chunks(
								prepared,
								emit_response_chunk,
								emit_typecheck_trace,
							)

					if not streamed:
						print(handle_request_value(prepared).to_string())
				Err(error_response):
					print(error_response.to_string())
		Err(message):
			print(bridge_error_json(InvalidJson(message)).to_string())


func main(args: List[String]) -> Int:
	if args.length() != 2:
		print_error("Usage: compiler_typecheck_worker <request.json>")
		1
	else:
		path: String = args
			.get(1)
			.get_or("")

		match read_text_file(path):
			Ok(request):
				print_cli_request_response(request)
				0
			Err(message):
				print_error(message)
				1
