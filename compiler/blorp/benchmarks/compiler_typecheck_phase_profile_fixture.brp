enum CompilerTypecheckProfileStage:
	CompilerProfileIndexedGraph
	CompilerProfileImportableModules
	CompilerProfileBoundModules
	CompilerProfileDeclarationSkeletons
	CompilerProfileAliasDependencies
	CompilerProfileResolvedTypeParameters
	CompilerProfileTypeHeaders
	CompilerProfileTraitTopology
	CompilerProfileCallableHeaders
	CompilerProfileImplementationHeaders
	CompilerProfileAcceptedGraph


private record CompilerTypecheckPhaseProfilePlanRep {
	stage: CompilerTypecheckProfileStage,
	iterations: Int
}


opaque type CompilerTypecheckPhaseProfilePlan = CompilerTypecheckPhaseProfilePlanRep


record CompilerTypecheckPhaseProfileObservation {
	stage: CompilerTypecheckProfileStage,
	iterations: Int,
	primary_output_count: Int,
	secondary_output_count: Int,
	checksum: Int
}


union CompilerTypecheckPhaseProfileRun:
	CompilerTypecheckPhaseProfileCompleted(CompilerTypecheckPhaseProfileObservation)
	CompilerTypecheckPhaseProfileInvariantFailed(List[String])


private record CompilerTypecheckPhaseProfileFixtureRep {
	target_candidate: CompilerModuleLoadCandidate,
	module_candidates: List[CompilerModuleLoadCandidate],
	module_paths: List[String],
	indexed_graph: CompilerIndexedGraph,
	importable_graph: CompilerImportableModuleGraph,
	bound_graph: CompilerBoundModuleGraph,
	declaration_graph: CompilerDeclarationSkeletonGraph,
	alias_dependencies: CompilerAcyclicTypeAliasDependencyGraph,
	parameter_graph: CompilerResolvedTypeParameterGraph,
	type_headers: CompilerTypeHeaderGraph,
	trait_topology: CompilerTraitTopologyGraph,
	callable_headers: CompilerCallableHeaderGraph,
	implementation_headers: CompilerImplementationHeaderGraph,
	accepted_graph: CompilerAcceptedTypecheckGraph
}


opaque type CompilerTypecheckPhaseProfileFixture = CompilerTypecheckPhaseProfileFixtureRep


private struct CompilerTypecheckPhaseOutputSummary {
	primary_count: Int,
	secondary_count: Int,
	fingerprint: Int
}


private union CompilerTypecheckPhaseProfileProduct:
	CompilerIndexedGraphProfileProduct(CompilerIndexedGraph)
	CompilerImportableModulesProfileProduct(CompilerImportableModuleGraph)
	CompilerBoundModulesProfileProduct(CompilerBoundModuleGraph)
	CompilerDeclarationSkeletonsProfileProduct(CompilerDeclarationSkeletonGraph)
	CompilerAliasDependenciesProfileProduct(CompilerAcyclicTypeAliasDependencyGraph)
	CompilerResolvedTypeParametersProfileProduct(CompilerResolvedTypeParameterGraph)
	CompilerTypeHeadersProfileProduct(CompilerTypeHeaderGraph)
	CompilerTraitTopologyProfileProduct(CompilerTraitTopologyGraph)
	CompilerCallableHeadersProfileProduct(CompilerCallableHeaderGraph)
	CompilerImplementationHeadersProfileProduct(CompilerImplementationHeaderGraph)
	CompilerAcceptedGraphProfileProduct(CompilerAcceptedTypecheckGraph)


private union CompilerTypecheckPhaseProfileExecutionRep:
	CompilerTypecheckPhaseExecutionCompleted(CompilerTypecheckProfileStage, Int, CompilerTypecheckPhaseProfileProduct)
	CompilerTypecheckPhaseExecutionFailed(CompilerTypecheckProfileStage, Int, List[String])


opaque type CompilerTypecheckPhaseProfileExecution = CompilerTypecheckPhaseProfileExecutionRep


private pure func profile_fixture_rep(
	fixture: CompilerTypecheckPhaseProfileFixture,
) -> CompilerTypecheckPhaseProfileFixtureRep:
	from CompilerTypecheckPhaseProfileFixture(fixture)


pure func compiler_typecheck_phase_profile_fixture_type_headers(
	fixture: CompilerTypecheckPhaseProfileFixture,
) -> CompilerTypeHeaderGraph:
	profile_fixture_rep(fixture).type_headers


private pure func profile_plan_rep(
	plan: CompilerTypecheckPhaseProfilePlan,
) -> CompilerTypecheckPhaseProfilePlanRep:
	from CompilerTypecheckPhaseProfilePlan(plan)


private pure func profile_execution_rep(
	execution: CompilerTypecheckPhaseProfileExecution,
) -> CompilerTypecheckPhaseProfileExecutionRep:
	from CompilerTypecheckPhaseProfileExecution(execution)


private pure func profile_execution_from_rep(
	representation: CompilerTypecheckPhaseProfileExecutionRep,
) -> CompilerTypecheckPhaseProfileExecution:
	into CompilerTypecheckPhaseProfileExecution(representation)


pure func compiler_typecheck_phase_profile_plan(
	stage: CompilerTypecheckProfileStage,
	iterations: Int,
) -> Option[CompilerTypecheckPhaseProfilePlan]:
	if iterations > 0:
		Some(into CompilerTypecheckPhaseProfilePlan({
				stage = stage,
				iterations = iterations,
			}))
	else:
		None


pure func compiler_typecheck_phase_profile_stage_name(
	stage: CompilerTypecheckProfileStage,
) -> String:
	match stage:
		CompilerProfileIndexedGraph:
			"indexed"
		CompilerProfileImportableModules:
			"importable"
		CompilerProfileBoundModules:
			"bound"
		CompilerProfileDeclarationSkeletons:
			"skeleton"
		CompilerProfileAliasDependencies:
			"aliases"
		CompilerProfileResolvedTypeParameters:
			"parameters"
		CompilerProfileTypeHeaders:
			"headers"
		CompilerProfileTraitTopology:
			"topology"
		CompilerProfileCallableHeaders:
			"callables"
		CompilerProfileImplementationHeaders:
			"implementations"
		CompilerProfileAcceptedGraph:
			"accepted"


private pure func indexed_error_messages(errors: List[CompilerIndexedGraphError]) -> List[String]:
	errors.map(compiler_indexed_graph_error_message)


private pure func bound_error_messages(errors: List[CompilerBoundModuleGraphError]) -> List[String]:
	errors.map(compiler_bound_module_graph_error_message)


private pure func skeleton_error_messages(
	errors: List[CompilerDeclarationSkeletonGraphError],
) -> List[String]:
	errors.map(compiler_declaration_skeleton_graph_error_message)


private pure func parameter_error_messages(
	errors: List[CompilerResolvedTypeParameterGraphError],
) -> List[String]:
	errors.map(compiler_resolved_type_parameter_graph_error_message)


private pure func header_error_messages(errors: List[CompilerTypeHeaderError]) -> List[String]:
	errors.map(compiler_type_header_error_message)


private pure func trait_topology_error_messages(
	errors: List[CompilerTraitTopologyGraphError],
) -> List[String]:
	errors.map(compiler_trait_topology_graph_error_message)


private pure func callable_header_error_messages(
	errors: List[CompilerCallableHeaderGraphError],
) -> List[String]:
	errors.map(compiler_callable_header_graph_error_message)


private pure func implementation_header_error_messages(
	errors: List[CompilerImplementationHeaderGraphError],
) -> List[String]:
	errors.map(compiler_implementation_header_graph_error_message)


private pure func profile_bind_module(
	scope: CompilerPreparedModuleScope,
	importable_index: CompilerImportableModuleIndex,
) -> CompilerBoundModuleViewBinding:
	module = compiler_prepared_module_scope_module(scope)
	state = compiler_typecheck_state_for_prepared_module_scope(scope, False)
	typecheck_bind_program_module_view(
		state,
		prepared_module_program(module),
		importable_index,
		compiler_prepared_module_scope_canonical_path(scope),
	)


private pure func profile_bound_graph(
	indexed_graph: CompilerIndexedGraph,
	module_paths: List[String],
	importable_index: CompilerImportableModuleIndex,
) -> Result[CompilerBoundModuleGraph, List[CompilerBoundModuleGraphError]]:
	compiler_bound_module_graph_build(
		indexed_graph,
		module_paths,
		func(scope): profile_bind_module(scope, importable_index),
	)


private pure func complete_profile_fixture(
	target_candidate: CompilerModuleLoadCandidate,
	module_candidates: List[CompilerModuleLoadCandidate],
	module_paths: List[String],
	indexed_graph: CompilerIndexedGraph,
	importable_graph: CompilerImportableModuleGraph,
	bound_graph: CompilerBoundModuleGraph,
	declaration_graph: CompilerDeclarationSkeletonGraph,
	alias_dependencies: CompilerAcyclicTypeAliasDependencyGraph,
	parameter_graph: CompilerResolvedTypeParameterGraph,
	type_headers: CompilerTypeHeaderGraph,
) -> Result[CompilerTypecheckPhaseProfileFixture, List[String]]:
	match compiler_trait_topology_graph_build(type_headers):
		Err(errors):
			Err(trait_topology_error_messages(errors))
		Ok(trait_topology):
			match compiler_callable_header_graph_build(trait_topology):
				Err(_):
					Err(["typecheck profile fixture callable headers were rejected"])
				Ok(callable_headers):
					match compiler_implementation_header_graph_build(callable_headers):
						Err(_):
							Err(["typecheck profile fixture implementation headers were rejected"])
						Ok(implementation_headers):
							match compiler_accepted_typecheck_graph(
								implementation_headers,
								importable_graph,
							):
								None:
									Err(
										[
											"typecheck profile fixture products do not share one indexed graph",
										],
									)
								Some(accepted_graph):
									Ok(into CompilerTypecheckPhaseProfileFixture({
											target_candidate = target_candidate,
											module_candidates = module_candidates,
											module_paths = module_paths,
											indexed_graph = indexed_graph,
											importable_graph = importable_graph,
											bound_graph = bound_graph,
											declaration_graph = declaration_graph,
											alias_dependencies = alias_dependencies,
											parameter_graph = parameter_graph,
											type_headers = type_headers,
											trait_topology = trait_topology,
											callable_headers = callable_headers,
											implementation_headers = implementation_headers,
											accepted_graph = accepted_graph,
										}))


pure func compiler_typecheck_phase_profile_fixture(
	target_candidate: CompilerModuleLoadCandidate,
	module_candidates: List[CompilerModuleLoadCandidate],
	module_paths: List[String],
) -> Result[CompilerTypecheckPhaseProfileFixture, List[String]]:
	match compiler_indexed_graph_build(target_candidate, module_candidates):
		Err(errors):
			Err(indexed_error_messages(errors))
		Ok(indexed_graph):
			importable_graph = compiler_importable_module_graph(indexed_graph)
			importable_index = compiler_importable_module_graph_all_index(importable_graph)

			match profile_bound_graph(indexed_graph, module_paths, importable_index):
				Err(errors):
					Err(bound_error_messages(errors))
				Ok(bound_graph):
					match compiler_declaration_skeleton_graph_build(bound_graph):
						Err(errors):
							Err(skeleton_error_messages(errors))
						Ok(declaration_graph):
							match compiler_type_alias_dependency_graph_validate(declaration_graph):
								Err(errors):
									Err(errors)
								Ok(alias_dependencies):
									match compiler_resolved_type_parameter_graph_build(
										alias_dependencies,
									):
										Err(errors):
											Err(parameter_error_messages(errors))
										Ok(parameter_graph):
											match compiler_type_header_graph_build(parameter_graph):
												Err(errors):
													Err(header_error_messages(errors))
												Ok(type_headers):
													complete_profile_fixture(
														target_candidate,
														module_candidates,
														module_paths,
														indexed_graph,
														importable_graph,
														bound_graph,
														declaration_graph,
														alias_dependencies,
														parameter_graph,
														type_headers,
													)


private pure func fingerprint_add_text(fingerprint: Int, text: String) -> Int:
	hash_combine(fingerprint, crc32(text))


private pure func fingerprint_add_int(fingerprint: Int, value: Int) -> Int:
	hash_combine(fingerprint, value)


private pure func fingerprint_add_bool(fingerprint: Int, value: Bool) -> Int:
	if value:
		fingerprint_add_int(fingerprint, 1)
	else:
		fingerprint_add_int(fingerprint, 0)


private pure func fingerprint_add_optional_int(fingerprint: Int, value: Option[Int]) -> Int:
	match value:
		Some(inner):
			fingerprint
				.fingerprint_add_text("some")
				.fingerprint_add_int(inner)
		None:
			fingerprint.fingerprint_add_text("none")


private pure func fingerprint_add_optional_text(fingerprint: Int, value: Option[String]) -> Int:
	match value:
		Some(inner):
			fingerprint
				.fingerprint_add_text("some")
				.fingerprint_add_text(inner)
		None:
			fingerprint.fingerprint_add_text("none")


private pure func fingerprint_source_span(fingerprint: Int, span: CompilerSourceSpan) -> Int:
	fingerprint
		.fingerprint_add_text(span.path)
		.fingerprint_add_text(span.module_name)
		.fingerprint_add_int(span.start_offset)
		.fingerprint_add_int(span.start_line)
		.fingerprint_add_int(span.start_column)
		.fingerprint_add_int(span.end_offset)
		.fingerprint_add_int(span.end_line)
		.fingerprint_add_int(span.end_column)


private pure func source_definition_kind_name(kind: CompilerSourceDefinitionKind) -> String:
	match kind:
		CompilerConstructorDefinition:
			"constructor"
		CompilerTraitDefinition:
			"trait"
		CompilerImplDefinition:
			"implementation"
		CompilerGlobalDefinition:
			"global"
		CompilerTypeDefinition:
			"type"
		CompilerFieldDefinition:
			"field"


private pure func fingerprint_callable_key(fingerprint: Int, key: CompilerFuncCallableKey) -> Int:
	fingerprint_source_span(
		fingerprint
			.fingerprint_add_text(
				compiler_module_identity_storage_key(
					compiler_func_callable_key_module_identity(key),
				),
			)
			.fingerprint_add_text(compiler_func_callable_key_name(key)),
		compiler_func_callable_key_span(key),
	)


private pure func fingerprint_source_definition_key(
	fingerprint: Int,
	key: CompilerSourceDefinitionKey,
) -> Int:
	fingerprint_source_span(
		fingerprint
			.fingerprint_add_text(
				compiler_module_identity_storage_key(
					compiler_source_definition_key_module_identity(key),
				),
			)
			.fingerprint_add_text(
				source_definition_kind_name(compiler_source_definition_key_kind(key)),
			)
			.fingerprint_add_text(compiler_source_definition_key_name(key))
			.fingerprint_add_optional_text(compiler_source_definition_key_owner(key)),
		compiler_source_definition_key_span(key),
	)


private pure func type_id_fingerprint_text(id: CompilerTypeId) -> String:
	compiler_module_identity_storage_key(
		compiler_type_id_module_identity(id),
	) + ":" + compiler_type_id_name(id)


private pure func fingerprint_type_parameter(
	fingerprint: Int,
	parameter: CompilerResolvedTypeParameter,
) -> Int:
	var next = fingerprint
		.fingerprint_add_text(
			type_id_fingerprint_text(compiler_type_parameter_id_owner(parameter.id)),
		)
		.fingerprint_add_int(compiler_type_parameter_id_index(parameter.id))
		.fingerprint_add_text(compiler_type_parameter_id_name(parameter.id))
		.fingerprint_add_int(parameter.bounds.length())

	for bound in parameter.bounds:
		next = next.fingerprint_add_text(
			compiler_module_identity_storage_key(
				compiler_trait_id_module_identity(bound),
			) + ":" + compiler_trait_id_name(bound),
		)

	next


private pure func fingerprint_resolved_type_shape(
	fingerprint: Int,
	shape: CompilerResolvedTypeShape,
) -> Int:
	match shape:
		CompilerDeclaredTypeShape(id, args):
			var next = fingerprint
				.fingerprint_add_text("declared")
				.fingerprint_add_text(type_id_fingerprint_text(id))
				.fingerprint_add_int(args.length())

			for arg in args:
				next = fingerprint_resolved_type_shape(next, arg)

			next
		CompilerIntrinsicTypeShape(intrinsic, args):
			var next = fingerprint
				.fingerprint_add_text("intrinsic")
				.fingerprint_add_text(compiler_intrinsic_type_name(intrinsic))
				.fingerprint_add_int(args.length())

			for arg in args:
				next = fingerprint_resolved_type_shape(next, arg)

			next
		CompilerPreludeTypeShape(prelude_type, args):
			var next = fingerprint
				.fingerprint_add_text("prelude")
				.fingerprint_add_text(compiler_prelude_type_name(prelude_type))
				.fingerprint_add_int(args.length())

			for arg in args:
				next = fingerprint_resolved_type_shape(next, arg)

			next
		CompilerTypeParameterShape(id):
			fingerprint
				.fingerprint_add_text("parameter")
				.fingerprint_add_text(
					type_id_fingerprint_text(compiler_type_parameter_id_owner(id)),
				)
				.fingerprint_add_int(compiler_type_parameter_id_index(id))
				.fingerprint_add_text(compiler_type_parameter_id_name(id))
		CompilerSelfTypeShape(id):
			fingerprint
				.fingerprint_add_text("self")
				.fingerprint_add_text(type_id_fingerprint_text(id))
		CompilerTraitTypeParameterShape(id):
			fingerprint
				.fingerprint_add_text("trait-parameter")
				.fingerprint_add_int(compiler_trait_type_parameter_id_index(id))
				.fingerprint_add_text(compiler_trait_type_parameter_id_name(id))
		CompilerCallableTypeParameterShape(id):
			fingerprint
				.fingerprint_add_text("callable-parameter")
				.fingerprint_add_int(compiler_callable_type_parameter_id_index(id))
				.fingerprint_add_text(compiler_callable_type_parameter_id_name(id))
		CompilerImplementationTypeParameterShape(id):
			fingerprint
				.fingerprint_add_text("implementation-parameter")
				.fingerprint_add_int(compiler_implementation_type_parameter_id_index(id))
				.fingerprint_add_text(compiler_implementation_type_parameter_id_name(id))
		CompilerTraitSelfTypeShape(id):
			fingerprint
				.fingerprint_add_text("trait-self")
				.fingerprint_add_text(compiler_trait_id_name(id))
		CompilerDimensionParameterShape(id, variadic):
			fingerprint
				.fingerprint_add_text("dimension-parameter")
				.fingerprint_add_text(
					type_id_fingerprint_text(compiler_type_parameter_id_owner(id)),
				)
				.fingerprint_add_int(compiler_type_parameter_id_index(id))
				.fingerprint_add_text(compiler_type_parameter_id_name(id))
				.fingerprint_add_bool(variadic)
		CompilerTraitDimensionParameterShape(id, variadic):
			fingerprint
				.fingerprint_add_text("trait-dimension-parameter")
				.fingerprint_add_int(compiler_trait_type_parameter_id_index(id))
				.fingerprint_add_text(compiler_trait_type_parameter_id_name(id))
				.fingerprint_add_bool(variadic)
		CompilerCallableDimensionParameterShape(id, variadic):
			fingerprint
				.fingerprint_add_text("callable-dimension-parameter")
				.fingerprint_add_int(compiler_callable_type_parameter_id_index(id))
				.fingerprint_add_text(compiler_callable_type_parameter_id_name(id))
				.fingerprint_add_bool(variadic)
		CompilerImplementationDimensionParameterShape(id, variadic):
			fingerprint
				.fingerprint_add_text("implementation-dimension-parameter")
				.fingerprint_add_int(compiler_implementation_type_parameter_id_index(id))
				.fingerprint_add_text(compiler_implementation_type_parameter_id_name(id))
				.fingerprint_add_bool(variadic)
		CompilerWildcardDimensionShape(variadic):
			fingerprint
				.fingerprint_add_text("wildcard-dimension")
				.fingerprint_add_bool(variadic)
		CompilerDimensionLiteralShape(value):
			fingerprint
				.fingerprint_add_text("dimension-literal")
				.fingerprint_add_int(value)
		CompilerDimensionBinaryShape(op, left, right):
			op_name = match op:
				CompilerResolvedDimAdd:
					"add"
				CompilerResolvedDimSubtract:
					"subtract"
				CompilerResolvedDimMultiply:
					"multiply"
				CompilerResolvedDimDivide:
					"divide"

			fingerprint_resolved_type_shape(
				fingerprint_resolved_type_shape(
					fingerprint
						.fingerprint_add_text("dimension-binary")
						.fingerprint_add_text(op_name),
					left,
				),
				right,
			)
		CompilerRangeTypeShape(inner):
			fingerprint_resolved_type_shape(
				fingerprint.fingerprint_add_text("range"),
				inner,
			)
		CompilerTupleTypeShape(items):
			var next = fingerprint
				.fingerprint_add_text("tuple")
				.fingerprint_add_int(items.length())

			for item in items:
				next = fingerprint_resolved_type_shape(next, item)

			next
		CompilerFunctionTypeShape(is_pure, params, return_type):
			var next = fingerprint
				.fingerprint_add_text("function")
				.fingerprint_add_bool(is_pure)
				.fingerprint_add_int(params.length())

			for parameter in params:
				next = fingerprint_resolved_type_shape(next, parameter)

			fingerprint_resolved_type_shape(next, return_type)
		CompilerArrayTypeShape(element, dimensions):
			var next = fingerprint_resolved_type_shape(
				fingerprint.fingerprint_add_text("array"),
				element,
			).fingerprint_add_int(dimensions.length())

			for dimension in dimensions:
				next = fingerprint_resolved_type_shape(next, dimension)

			next


private pure func skeleton_kind_name(kind: CompilerDeclarationSkeletonKind) -> String:
	match kind:
		CompilerTypeSkeletonKind:
			"type"
		CompilerConstructorSkeletonKind:
			"constructor"
		CompilerCallableSkeletonKind:
			"callable"
		CompilerTraitSkeletonKind:
			"trait"
		CompilerTraitMethodSkeletonKind:
			"trait-method"
		CompilerGlobalSkeletonKind:
			"global"
		CompilerImplementationSkeletonKind:
			"implementation"


private pure func fingerprint_import_symbol(fingerprint: Int, symbol: ParsedImportSymbol) -> Int:
	var next = fingerprint.fingerprint_add_text(symbol.name.text)

	next = match symbol.symbol_alias:
		Some(alias_name):
			next
				.fingerprint_add_text("alias")
				.fingerprint_add_text(alias_name.text)
		None:
			next.fingerprint_add_text("no-alias")

	for constructor in symbol.constructors:
		next = next.fingerprint_add_text(constructor.text)

	next


private pure func fingerprint_import_decl(fingerprint: Int, decl: ParsedImportDecl) -> Int:
	var next = fingerprint.fingerprint_add_text(decl.module_path)

	next = match decl.module_alias:
		Some(alias_name):
			next
				.fingerprint_add_text("alias")
				.fingerprint_add_text(alias_name.text)
		None:
			next.fingerprint_add_text("no-alias")

	match decl.symbols:
		Some(symbols):
			next = next
				.fingerprint_add_text("selective")
				.fingerprint_add_int(symbols.length())

			for symbol in symbols:
				next = fingerprint_import_symbol(next, symbol)
		None:
			next = next.fingerprint_add_text("qualified")

	next


private pure func fingerprint_importable_module(
	fingerprint: Int,
	module: CompilerImportableModule,
) -> Int:
	var next = fingerprint.fingerprint_add_text(compiler_importable_module_path(module))
	local_types = compiler_importable_module_local_type_names(module)
	next = next.fingerprint_add_int(local_types.length())

	for name in local_types:
		next = next.fingerprint_add_text(name)

	imports = compiler_importable_module_declared_imports(module)
	next = next.fingerprint_add_int(imports.length())

	for decl in imports:
		next = fingerprint_import_decl(next, decl)

	signatures = compiler_importable_module_signature_decls(module)
	next = next.fingerprint_add_int(signatures.length())

	for signature in signatures:
		match signature:
			CompilerImportableFunctionDecl(decl):
				next = next
					.fingerprint_add_text("function")
					.fingerprint_add_text(decl.name.text)
			CompilerImportableVarDecl(decl):
				next = next
					.fingerprint_add_text("variable")
					.fingerprint_add_text(decl.name.text)
			CompilerImportableForeignFunctionDecl(decl):
				next = next
					.fingerprint_add_text("foreign")
					.fingerprint_add_text(decl.name.text)
			CompilerImportableTraitDecl(decl):
				next = next
					.fingerprint_add_text("trait")
					.fingerprint_add_text(decl.name.text)

	impls = compiler_importable_module_impl_decls(module)
	next = next.fingerprint_add_int(impls.length())

	for impl in impls:
		next = next
			.fingerprint_add_text(impl.trait_name.text)
			.fingerprint_add_int(impl.methods.length())

		for method in impl.methods:
			next = next.fingerprint_add_text(method.name.text)

	next.fingerprint_add_int(compiler_importable_module_decls(module).length())


private pure func fingerprint_bound_module(fingerprint: Int, module: CompilerBoundModule) -> Int:
	var next = fingerprint.fingerprint_add_text(compiler_bound_module_canonical_path(module))
	view = compiler_bound_module_view(module)

	for alias_binding in compiler_module_view_module_aliases(view):
		next = next
			.fingerprint_add_text(alias_binding[0])
			.fingerprint_add_text(alias_binding[1])

	for imported_name in compiler_module_view_imported_names(view):
		next = next
			.fingerprint_add_text(imported_name.local_name)
			.fingerprint_add_text(imported_name.module_path)
			.fingerprint_add_text(imported_name.original_name)

	for imported_module in compiler_module_view_imported_modules(view):
		next = next.fingerprint_add_text(imported_module)

	for visible in compiler_bound_module_visible_import_modules(module):
		next = next
			.fingerprint_add_text("visible")
			.fingerprint_add_text(compiler_importable_module_path(visible))

	for direct in compiler_bound_module_direct_import_modules(module):
		next = next
			.fingerprint_add_text("direct")
			.fingerprint_add_text(compiler_importable_module_path(direct))

	for diagnostic in compiler_bound_module_binding_diagnostics(module):
		next = next
			.fingerprint_add_text("diagnostic")
			.fingerprint_add_text(diagnostic.message)

	next


private pure func indexed_output_summary(
	graph: CompilerIndexedGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	index = compiler_indexed_graph_definition_index(graph)
	var fingerprint = fingerprint_add_text(
		0,
		prepared_module_canonical_path(compiler_indexed_graph_target(graph)),
	)

	for module in compiler_indexed_graph_modules(graph):
		fingerprint = fingerprint_add_text(fingerprint, prepared_module_canonical_path(module))

	for binding in compiler_definition_index_all_func_callable_bindings(index):
		fingerprint = fingerprint_callable_key(
			fingerprint.fingerprint_add_text("callable"),
			binding[0],
		).fingerprint_add_int(binding[1])

	for binding in compiler_definition_index_all_source_definition_bindings(index):
		fingerprint = fingerprint_source_definition_key(
			fingerprint.fingerprint_add_text("source"),
			binding[0],
		).fingerprint_add_int(binding[1])

	callable_count = compiler_definition_index_func_callable_id_count(index)
	source_count = compiler_definition_index_source_definition_id_count(index)
	fingerprint = fingerprint_add_int(fingerprint, callable_count)
	fingerprint = fingerprint_add_int(fingerprint, source_count)
	{
		primary_count = compiler_indexed_graph_modules(graph).length() + 1,
		secondary_count = callable_count + source_count,
		fingerprint = fingerprint
	}


private pure func bound_output_summary(
	graph: CompilerBoundModuleGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	var fingerprint = fingerprint_bound_module(0, compiler_bound_module_graph_target(graph))

	for module in compiler_bound_module_graph_modules(graph):
		fingerprint = fingerprint_bound_module(fingerprint, module)

	{
		primary_count = compiler_bound_module_graph_modules(graph).length() + 1,
		secondary_count = compiler_bound_module_graph_modules(graph).length(),
		fingerprint = fingerprint
	}


private pure func importable_output_summary(
	graph: CompilerImportableModuleGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	modules = compiler_importable_module_graph_all(graph)
	var fingerprint: Int = 0

	for module in modules:
		fingerprint = fingerprint_importable_module(fingerprint, module)

	{
		primary_count = modules.length(),
		secondary_count = 0,
		fingerprint = fingerprint
	}


private pure func skeleton_output_summary(
	graph: CompilerDeclarationSkeletonGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	skeletons = compiler_declaration_skeleton_graph_skeletons(graph)
	var fingerprint: Int = 0

	for skeleton in skeletons:
		fingerprint = fingerprint_add_text(
			fingerprint,
			skeleton_kind_name(
				compiler_declaration_skeleton_kind(
					skeleton,
				),
			) + ":" + compiler_declaration_skeleton_name(skeleton),
		)

	{
		primary_count = skeletons.length(),
		secondary_count = compiler_declaration_skeleton_graph_type_skeletons(graph).length(),
		fingerprint = fingerprint
	}


private pure func alias_output_summary(
	graph: CompilerAcyclicTypeAliasDependencyGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	nodes = compiler_acyclic_type_alias_dependency_graph_nodes(graph)
	var fingerprint: Int = 0

	for node in nodes:
		fingerprint = fingerprint_add_text(fingerprint, type_id_fingerprint_text(node.id))

		for dependency in node.dependencies:
			fingerprint = fingerprint_add_text(fingerprint, type_id_fingerprint_text(dependency))

	{
		primary_count = nodes.length(),
		secondary_count = 0,
		fingerprint = fingerprint
	}


private pure func parameter_output_summary(
	graph: CompilerResolvedTypeParameterGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	entries = compiler_resolved_type_parameter_graph_entries(graph)
	var fingerprint: Int = 0

	for entry in entries:
		fingerprint = fingerprint_add_text(fingerprint, type_id_fingerprint_text(entry.type_id))

		for parameter in entry.parameters:
			fingerprint = fingerprint_type_parameter(fingerprint, parameter)

	{
		primary_count = entries.length(),
		secondary_count = 0,
		fingerprint = fingerprint
	}


private pure func header_output_summary(
	graph: CompilerTypeHeaderGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	headers = compiler_type_header_graph_headers(graph)
	var fingerprint: Int = 0

	for header in headers:
		fingerprint = fingerprint_add_text(
			fingerprint,
			type_id_fingerprint_text(compiler_type_header_id(header)),
		)
		parameters = compiler_type_header_parameters(header)
		fingerprint = fingerprint.fingerprint_add_int(parameters.length())

		for parameter in parameters:
			fingerprint = fingerprint_type_parameter(fingerprint, parameter)

		fingerprint = fingerprint.fingerprint_add_bool(
			compiler_type_header_contains_resource(header),
		)

		match compiler_type_header_shape(header):
			CompilerRecordTypeHeader(layout, fields):
				layout_name = match layout:
					CompilerHeapRecord:
						"heap"
					CompilerValueStruct:
						"struct"

				fingerprint = fingerprint
					.fingerprint_add_text("record")
					.fingerprint_add_text(layout_name)
					.fingerprint_add_int(fields.length())

				for field in fields:
					fingerprint = fingerprint_resolved_type_shape(
						fingerprint
							.fingerprint_add_text(field.name)
							.fingerprint_add_optional_int(field.definition_id),
						field.typ,
					)
			CompilerUnionTypeHeader(layout, variants):
				layout_name = match layout:
					CompilerTaggedUnion:
						"tagged"
					CompilerFieldlessEnum:
						"enum"

				fingerprint = fingerprint
					.fingerprint_add_text("union")
					.fingerprint_add_text(layout_name)
					.fingerprint_add_int(variants.length())

				for variant in variants:
					fingerprint = fingerprint
						.fingerprint_add_text(variant.name)
						.fingerprint_add_int(variant.tag)
						.fingerprint_add_int(compiler_constructor_id_definition_id(variant.id))
						.fingerprint_add_text(type_id_fingerprint_text(variant.parent_type_id))
						.fingerprint_add_int(variant.fields.length())

					for field in variant.fields:
						fingerprint = fingerprint_resolved_type_shape(fingerprint, field)
			CompilerBuiltinTypeHeader(layout):
				fingerprint = fingerprint.fingerprint_add_text("builtin")

				match layout:
					CompilerScalarBuiltin:
						fingerprint = fingerprint.fingerprint_add_text("scalar")
					CompilerManagedBuiltin:
						fingerprint = fingerprint.fingerprint_add_text("managed")
					CompilerNoValueBuiltin:
						fingerprint = fingerprint.fingerprint_add_text("no-value")
					CompilerUnclassifiedBuiltin:
						fingerprint = fingerprint.fingerprint_add_text("unclassified")
					CompilerResourceBuiltin(policy):
						fingerprint = fingerprint.fingerprint_add_text("resource")

						match policy:
							CompilerResourceWithoutCleanup:
								fingerprint = fingerprint.fingerprint_add_text("no-cleanup")
							CompilerResourceWithCleanup(cleanup):
								fingerprint = fingerprint
									.fingerprint_add_text("cleanup")
									.fingerprint_add_text(cleanup)
			CompilerAliasTypeHeader(layout, target):
				layout_name = match layout:
					CompilerTransparentAlias:
						"transparent"
					CompilerOpaqueAlias:
						"opaque"

				fingerprint = fingerprint_resolved_type_shape(
					fingerprint
						.fingerprint_add_text("alias")
						.fingerprint_add_text(layout_name),
					target,
				)

	{
		primary_count = headers.length(),
		secondary_count = 0,
		fingerprint = fingerprint
	}


private pure func fingerprint_callable_signature(
	fingerprint: Int,
	signature: CompilerCallableSignature,
) -> Int:
	parameters = compiler_callable_signature_parameters(signature)
	var next = fingerprint
		.fingerprint_add_int(parameters.length())
		.fingerprint_add_bool(compiler_callable_signature_is_pure(signature))

	for parameter in parameters:
		next = fingerprint_resolved_type_shape(next, compiler_callable_parameter_type(parameter))

	fingerprint_resolved_type_shape(next, compiler_callable_signature_return_type(signature))


private pure func trait_topology_output_summary(
	graph: CompilerTraitTopologyGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	headers = compiler_trait_topology_graph_headers(graph)
	var method_count: Int = 0
	var fingerprint: Int = 0

	for header in headers:
		id = compiler_trait_topology_header_id(header)
		fingerprint = fingerprint
			.fingerprint_add_int(compiler_trait_id_definition_id(id))
			.fingerprint_add_text(compiler_trait_id_name(id))

		for supertrait in compiler_trait_topology_header_supertraits(header):
			fingerprint = fingerprint.fingerprint_add_int(
				compiler_trait_id_definition_id(supertrait),
			)

		methods = compiler_trait_topology_header_methods(header)
		method_count += methods.length()

		for method in methods:
			method_id = compiler_trait_method_slot_id(method)
			fingerprint = fingerprint_callable_signature(
				fingerprint.fingerprint_add_int(compiler_trait_method_id_index(method_id)),
				compiler_trait_method_slot_signature(method),
			)

	{
		primary_count = headers.length(),
		secondary_count = method_count,
		fingerprint = fingerprint
	}


private pure func callable_header_output_summary(
	graph: CompilerCallableHeaderGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	callables = compiler_callable_header_graph_callables(graph)
	globals = compiler_callable_header_graph_globals(graph)
	var fingerprint: Int = 0

	for callable in callables:
		fingerprint = fingerprint_callable_signature(
			fingerprint
				.fingerprint_add_int(
					compiler_callable_id_definition_id(compiler_callable_header_id(callable)),
				)
				.fingerprint_add_text(compiler_callable_header_name(callable)),
			compiler_callable_header_signature(callable),
		)

	for global in globals:
		id = compiler_global_header_id(global)
		fingerprint = fingerprint
			.fingerprint_add_text(
				compiler_module_identity_storage_key(compiler_global_id_module_identity(id)),
			)
			.fingerprint_add_text(compiler_global_header_name(global))

		match compiler_annotated_global_header_type(global):
			Some(typ):
				fingerprint = fingerprint_resolved_type_shape(
					fingerprint.fingerprint_add_text("annotated"),
					typ,
				)
			None:
				fingerprint = fingerprint.fingerprint_add_text("pending")

	{
		primary_count = callables.length(),
		secondary_count = globals.length(),
		fingerprint = fingerprint
	}


private pure func implementation_header_output_summary(
	graph: CompilerImplementationHeaderGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	headers = compiler_implementation_header_graph_headers(graph)
	var method_count: Int = 0
	var fingerprint: Int = 0

	for header in headers:
		method_ids = compiler_implementation_header_method_ids(header)
		method_count += method_ids.length()
		fingerprint = fingerprint_resolved_type_shape(
			fingerprint
				.fingerprint_add_int(
					compiler_impl_id_definition_id(compiler_implementation_header_id(header)),
				)
				.fingerprint_add_int(
					compiler_trait_id_definition_id(
						compiler_implementation_header_trait_id(header),
					),
				),
			compiler_implementation_header_receiver(header),
		)

		for method_id in method_ids:
			fingerprint = fingerprint.fingerprint_add_int(
				compiler_callable_id_definition_id(method_id),
			)

	{
		primary_count = headers.length(),
		secondary_count = method_count,
		fingerprint = fingerprint
	}


private pure func accepted_output_summary(
	graph: CompilerAcceptedTypecheckGraph,
) -> CompilerTypecheckPhaseOutputSummary:
	modules = compiler_accepted_typecheck_graph_import_modules(graph)
	var fingerprint = fingerprint_add_int(
		0,
		compiler_accepted_typecheck_graph_declaration_skeleton_count(graph),
	)

	for module in modules:
		fingerprint = fingerprint_add_text(fingerprint, compiler_importable_module_path(module))

	{
		primary_count = compiler_accepted_typecheck_graph_declaration_skeleton_count(graph),
		secondary_count = modules.length(),
		fingerprint = fingerprint
	}


private pure func execute_profile_stage_once(
	fixture: CompilerTypecheckPhaseProfileFixtureRep,
	stage: CompilerTypecheckProfileStage,
) -> Result[CompilerTypecheckPhaseProfileProduct, List[String]]:
	match stage:
		CompilerProfileIndexedGraph:
			match compiler_indexed_graph_build(fixture.target_candidate, fixture.module_candidates):
				Err(errors):
					Err(indexed_error_messages(errors))
				Ok(graph):
					Ok(CompilerIndexedGraphProfileProduct(graph))
		CompilerProfileImportableModules:
			Ok(
				CompilerImportableModulesProfileProduct(
					compiler_importable_module_graph(fixture.indexed_graph),
				),
			)
		CompilerProfileBoundModules:
			match profile_bound_graph(
				fixture.indexed_graph,
				fixture.module_paths,
				compiler_importable_module_graph_all_index(fixture.importable_graph),
			):
				Err(errors):
					Err(bound_error_messages(errors))
				Ok(graph):
					Ok(CompilerBoundModulesProfileProduct(graph))
		CompilerProfileDeclarationSkeletons:
			match compiler_declaration_skeleton_graph_build(fixture.bound_graph):
				Err(errors):
					Err(skeleton_error_messages(errors))
				Ok(graph):
					Ok(CompilerDeclarationSkeletonsProfileProduct(graph))
		CompilerProfileAliasDependencies:
			match compiler_type_alias_dependency_graph_validate(fixture.declaration_graph):
				Err(errors):
					Err(errors)
				Ok(graph):
					Ok(CompilerAliasDependenciesProfileProduct(graph))
		CompilerProfileResolvedTypeParameters:
			match compiler_resolved_type_parameter_graph_build(fixture.alias_dependencies):
				Err(errors):
					Err(parameter_error_messages(errors))
				Ok(graph):
					Ok(CompilerResolvedTypeParametersProfileProduct(graph))
		CompilerProfileTypeHeaders:
			match compiler_type_header_graph_build(fixture.parameter_graph):
				Err(errors):
					Err(header_error_messages(errors))
				Ok(graph):
					Ok(CompilerTypeHeadersProfileProduct(graph))
		CompilerProfileTraitTopology:
			match compiler_trait_topology_graph_build(fixture.type_headers):
				Err(errors):
					Err(trait_topology_error_messages(errors))
				Ok(graph):
					if compiler_trait_topology_graph_headers(graph).is_empty():
						Err(["trait topology profile requires at least one trait header"])
					else:
						Ok(CompilerTraitTopologyProfileProduct(graph))
		CompilerProfileCallableHeaders:
			match compiler_callable_header_graph_build(fixture.trait_topology):
				Err(errors):
					Err(callable_header_error_messages(errors))
				Ok(graph):
					if (
						compiler_callable_header_graph_callables(graph).is_empty()
						and compiler_callable_header_graph_globals(graph).is_empty()
					):
						Err(["callable header profile requires at least one callable or global"])
					else:
						Ok(CompilerCallableHeadersProfileProduct(graph))
		CompilerProfileImplementationHeaders:
			match compiler_implementation_header_graph_build(fixture.callable_headers):
				Err(errors):
					Err(implementation_header_error_messages(errors))
				Ok(graph):
					if compiler_implementation_header_graph_headers(graph).is_empty():
						Err(["implementation header profile requires at least one implementation"])
					else:
						Ok(CompilerImplementationHeadersProfileProduct(graph))
		CompilerProfileAcceptedGraph:
			match compiler_accepted_typecheck_graph(
				fixture.implementation_headers,
				fixture.importable_graph,
			):
				None:
					Err(["accepted typecheck profile products became incompatible"])
				Some(graph):
					Ok(CompilerAcceptedGraphProfileProduct(graph))


pure func compiler_typecheck_phase_profile_execute(
	fixture: CompilerTypecheckPhaseProfileFixture,
	plan: CompilerTypecheckPhaseProfilePlan,
) -> CompilerTypecheckPhaseProfileExecution:
	representation = profile_fixture_rep(fixture)
	plan_representation = profile_plan_rep(plan)

	match execute_profile_stage_once(representation, plan_representation.stage):
		Err(errors):
			profile_execution_from_rep(
				CompilerTypecheckPhaseExecutionFailed(
					plan_representation.stage,
					plan_representation.iterations,
					errors,
				),
			)
		Ok(first_product):
			var product = first_product
			var errors: List[String] = []
			var iteration: Int = 1

			while iteration < plan_representation.iterations and errors.is_empty():
				match execute_profile_stage_once(representation, plan_representation.stage):
					Err(iteration_errors):
						errors = iteration_errors
					Ok(iteration_product):
						product = iteration_product

				iteration += 1

			execution_rep = if errors.is_empty():
				CompilerTypecheckPhaseExecutionCompleted(
					plan_representation.stage,
					plan_representation.iterations,
					product,
				)
			else:
				CompilerTypecheckPhaseExecutionFailed(
					plan_representation.stage,
					plan_representation.iterations,
					errors,
				)

			profile_execution_from_rep(execution_rep)


private pure func profile_product_summary(
	product: CompilerTypecheckPhaseProfileProduct,
) -> CompilerTypecheckPhaseOutputSummary:
	match product:
		CompilerIndexedGraphProfileProduct(graph):
			indexed_output_summary(graph)
		CompilerImportableModulesProfileProduct(graph):
			importable_output_summary(graph)
		CompilerBoundModulesProfileProduct(graph):
			bound_output_summary(graph)
		CompilerDeclarationSkeletonsProfileProduct(graph):
			skeleton_output_summary(graph)
		CompilerAliasDependenciesProfileProduct(graph):
			alias_output_summary(graph)
		CompilerResolvedTypeParametersProfileProduct(graph):
			parameter_output_summary(graph)
		CompilerTypeHeadersProfileProduct(graph):
			header_output_summary(graph)
		CompilerTraitTopologyProfileProduct(graph):
			trait_topology_output_summary(graph)
		CompilerCallableHeadersProfileProduct(graph):
			callable_header_output_summary(graph)
		CompilerImplementationHeadersProfileProduct(graph):
			implementation_header_output_summary(graph)
		CompilerAcceptedGraphProfileProduct(graph):
			accepted_output_summary(graph)


pure func compiler_typecheck_phase_profile_observe(
	execution: CompilerTypecheckPhaseProfileExecution,
) -> CompilerTypecheckPhaseProfileRun:
	match profile_execution_rep(execution):
		CompilerTypecheckPhaseExecutionFailed(_, _, errors):
			CompilerTypecheckPhaseProfileInvariantFailed(errors)
		CompilerTypecheckPhaseExecutionCompleted(stage, iterations, product):
			summary = profile_product_summary(product)
			CompilerTypecheckPhaseProfileCompleted({
				stage = stage,
				iterations = iterations,
				primary_output_count = summary.primary_count,
				secondary_output_count = summary.secondary_count,
				checksum = fingerprint_add_int(summary.fingerprint, summary.primary_count)
					.fingerprint_add_int(summary.secondary_count)
					.fingerprint_add_int(iterations),
			})
