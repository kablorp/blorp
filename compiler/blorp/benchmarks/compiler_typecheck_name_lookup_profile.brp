-- Fast, isolated workload for typecheck-state name registration and lookup.
import:
	../src/stage_06_typecheck/compiler_typecheck_state:
		CompilerTopLevelNameKind(CompilerTopLevelFunction),
		CompilerTypecheckState,
		compiler_typecheck_state_empty,
		compiler_typecheck_state_find_imported_name,
		compiler_typecheck_state_find_top_level_name,
		compiler_typecheck_state_register_imported_name,
		compiler_typecheck_state_remember_top_level_name,
	string: parse_int
	system: now_microseconds


private CALIBRATION_TARGET_MICROSECONDS: Int = 50000

private MAX_CALIBRATION_ITERATIONS: Int = 1000000

private TIMED_SAMPLE_COUNT: Int = 5

private NANOSECONDS_PER_MICROSECOND: Int = 1000


record CompilerNameLookupBenchmarkConfig {
	initial_iterations: Int,
	name_count: Int,
	queries_per_kind: Int
}


record CompilerNameLookupBenchmarkResult {
	lookup_count: Int,
	matched_lookup_count: Int,
	checksum: Int,
	workload_valid: Bool
}


record CompilerNameLookupTimedResult {
	result: CompilerNameLookupBenchmarkResult,
	elapsed_microseconds: Int
}


record CompilerNameLookupCalibration {
	iterations: Int,
	workload_valid: Bool
}


record CompilerNameLookupSampleSummary {
	lookup_count: Int,
	matched_lookup_count: Int,
	checksum: Int,
	workload_valid: Bool,
	median_microseconds: Int,
	minimum_microseconds: Int,
	maximum_microseconds: Int
}


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func top_level_name(index: Int) -> String:
	"TopLevel" + index.to_string()


private pure func imported_name(index: Int) -> String:
	"imported_name_" + index.to_string()


private pure func missing_name(index: Int) -> String:
	"missing_name_" + index.to_string()


private pure func module_name(index: Int) -> String:
	"bench/module_" + index.to_string()


private pure func query_names(
	name_count: Int,
	query_count: Int,
	name_for_index: pure (Int) -> String,
) -> List[String]:
	var names: List[String] = []

	for query_index in 0..query_count:
		names = names.append(name_for_index(query_index % name_count))

	names


private pure func benchmark_state(name_count: Int) -> CompilerTypecheckState:
	var state = compiler_typecheck_state_empty()

	for index in 0..name_count:
		state = compiler_typecheck_state_remember_top_level_name(
			state,
			top_level_name(index),
			CompilerTopLevelFunction,
		)
		state = compiler_typecheck_state_register_imported_name(
			state,
			imported_name(index),
			module_name(index),
			"source_name_" + index.to_string(),
		).state

	state


private pure func run_lookup_workload(
	iterations: Int,
	state: CompilerTypecheckState,
	top_level_hits: List[String],
	imported_hits: List[String],
	misses: List[String],
) -> CompilerNameLookupBenchmarkResult:
	var matched: Int = 0
	var checksum: Int = 0

	for _ in 0..iterations:
		for name in top_level_hits:
			match compiler_typecheck_state_find_top_level_name(state, name):
				Some(CompilerTopLevelFunction):
					matched += 1
				_:
					void

		for name in imported_hits:
			match compiler_typecheck_state_find_imported_name(state, name):
				Some(binding):
					if binding.local_name == name:
						matched += 1
						checksum += binding.module_path.length()
				None:
					void

		for name in misses:
			if compiler_typecheck_state_find_top_level_name(state, name).is_none():
				matched += 1

			if compiler_typecheck_state_find_imported_name(state, name).is_none():
				matched += 1

	expected: Int = iterations * top_level_hits.length() * 4
	{
		lookup_count = expected,
		matched_lookup_count = matched,
		checksum = checksum,
		workload_valid = matched == expected and checksum > 0
	}


private func timed_lookup_workload(
	iterations: Int,
	state: CompilerTypecheckState,
	top_level_hits: List[String],
	imported_hits: List[String],
	misses: List[String],
) -> CompilerNameLookupTimedResult:
	started: Int = now_microseconds()
	result = run_lookup_workload(iterations, state, top_level_hits, imported_hits, misses)
	{
		result = result,
		elapsed_microseconds = now_microseconds() - started
	}


private func calibrated_iterations(
	initial_iterations: Int,
	state: CompilerTypecheckState,
	top_level_hits: List[String],
	imported_hits: List[String],
	misses: List[String],
) -> CompilerNameLookupCalibration:
	var iterations: Int = initial_iterations
	var workload_valid: Bool = True

	while True:
		timed = timed_lookup_workload(iterations, state, top_level_hits, imported_hits, misses)
		workload_valid = workload_valid and timed.result.workload_valid

		if (
			timed.elapsed_microseconds >= CALIBRATION_TARGET_MICROSECONDS
			or iterations >= MAX_CALIBRATION_ITERATIONS
		):
			break

		if iterations > MAX_CALIBRATION_ITERATIONS / 2:
			iterations = MAX_CALIBRATION_ITERATIONS
		else:
			iterations *= 2

	{
		iterations = iterations,
		workload_valid = workload_valid
	}


private pure func sample_at_or_zero(samples: List[Int], index: Int) -> Int:
	match samples.get(index):
		Some(sample):
			sample
		None:
			0


private func run_lookup_samples(
	iterations: Int,
	state: CompilerTypecheckState,
	top_level_hits: List[String],
	imported_hits: List[String],
	misses: List[String],
) -> CompilerNameLookupSampleSummary:
	var elapsed_samples: List[Int] = []
	var lookup_count: Int = 0
	var matched_lookup_count: Int = 0
	var checksum: Int = 0
	var workload_valid: Bool = True

	for _ in 0..TIMED_SAMPLE_COUNT:
		timed = timed_lookup_workload(iterations, state, top_level_hits, imported_hits, misses)
		elapsed_samples = elapsed_samples.append(timed.elapsed_microseconds)
		lookup_count += timed.result.lookup_count
		matched_lookup_count += timed.result.matched_lookup_count
		checksum += timed.result.checksum
		workload_valid = workload_valid and timed.result.workload_valid

	sorted_samples = elapsed_samples.sort()
	{
		lookup_count = lookup_count,
		matched_lookup_count = matched_lookup_count,
		checksum = checksum,
		workload_valid = workload_valid and matched_lookup_count == lookup_count,
		median_microseconds = sample_at_or_zero(sorted_samples, TIMED_SAMPLE_COUNT / 2),
		minimum_microseconds = sample_at_or_zero(sorted_samples, 0),
		maximum_microseconds = sample_at_or_zero(sorted_samples, TIMED_SAMPLE_COUNT - 1)
	}


func main(args: List[String]) -> Int:
	config: CompilerNameLookupBenchmarkConfig = {
		initial_iterations = positive_argument(args, 1, 200),
		name_count = positive_argument(args, 2, 256),
		queries_per_kind = positive_argument(args, 3, 256)
	}
	setup_started: Int = now_microseconds()
	state = benchmark_state(config.name_count)
	top_level_hits = query_names(config.name_count, config.queries_per_kind, top_level_name)
	imported_hits = query_names(config.name_count, config.queries_per_kind, imported_name)
	misses = query_names(config.name_count, config.queries_per_kind, missing_name)
	setup_microseconds: Int = now_microseconds() - setup_started
	calibration_started: Int = now_microseconds()
	calibration = calibrated_iterations(
		config.initial_iterations,
		state,
		top_level_hits,
		imported_hits,
		misses,
	)
	calibration_microseconds: Int = now_microseconds() - calibration_started
	result = run_lookup_samples(
		calibration.iterations,
		state,
		top_level_hits,
		imported_hits,
		misses,
	)
	workload_valid: Bool = calibration.workload_valid and result.workload_valid
	lookups_per_sample: Int = result.lookup_count / TIMED_SAMPLE_COUNT
	nanoseconds_per_lookup: Int = result.median_microseconds * NANOSECONDS_PER_MICROSECOND / lookups_per_sample

	print(
		"TYPECHECK_NAME_LOOKUP_PROFILE_BENCH" + " initial_iterations=" + config.initial_iterations.to_string() + " iterations=" + calibration.iterations.to_string() + " name_count=" + config.name_count.to_string() + " queries_per_kind=" + config.queries_per_kind.to_string() + " sample_count=" + TIMED_SAMPLE_COUNT.to_string() + " lookups_per_sample=" + lookups_per_sample.to_string() + " lookup_count=" + result.lookup_count.to_string() + " matched_lookup_count=" + result.matched_lookup_count.to_string() + " checksum=" + result.checksum.to_string() + " workload_valid=" + workload_valid.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " calibration_microseconds=" + calibration_microseconds.to_string() + " minimum_microseconds=" + result.minimum_microseconds.to_string() + " median_microseconds=" + result.median_microseconds.to_string() + " maximum_microseconds=" + result.maximum_microseconds.to_string() + " nanoseconds_per_lookup=" + nanoseconds_per_lookup.to_string(),
	)

	if workload_valid:
		0
	else:
		1
