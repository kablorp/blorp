-- Fast graph definition-indexing benchmark.
--
-- Positional controls: iterations, modules, and functions per module. Parsing
-- is reported as setup time and excluded from the index measurement.
import:
	compiler_definition_index_profile_fixture:
		CompilerDefinitionIndexBenchmarkConfig,
		compiler_definition_index_benchmark_input,
		compiler_definition_index_benchmark_with_input,
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


func main(args: List[String]) -> Int:
	config: CompilerDefinitionIndexBenchmarkConfig = {
		iterations = positive_argument(args, 1, 25),
		module_count = positive_argument(args, 2, 20),
		functions_per_module = positive_argument(args, 3, 32)
	}
	setup_started = now_microseconds()
	input = compiler_definition_index_benchmark_input(config)
	setup_microseconds = now_microseconds() - setup_started

	match input:
		None:
			print("DEFINITION_INDEX_PROFILE_BENCH workload_valid=false setup_failed=true")
			1
		Some(benchmark_input):
			started = now_microseconds()
			result = compiler_definition_index_benchmark_with_input(config, benchmark_input)
			elapsed_microseconds = now_microseconds() - started

			print(
				"DEFINITION_INDEX_PROFILE_BENCH" + " iterations=" + config.iterations.to_string() + " modules=" + config.module_count.to_string() + " functions_per_module=" + config.functions_per_module.to_string() + " callable_ids=" + result.func_callable_id_count.to_string() + " source_ids=" + result.source_definition_id_count.to_string() + " allocated_ids=" + result.allocated_definition_count.to_string() + " workload_valid=" + result.workload_valid.to_string() + " checksum=" + result.checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string(),
			)

			if result.workload_valid:
				0
			else:
				1
