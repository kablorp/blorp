import:
	compiler_generic_params:
		CompilerBoundTypeParam,
		CompilerTraitRef,
		compiler_bound_type_param_name,
		compiler_trait_ref,
		compiler_trait_ref_name,
	compiler_refinement: CompilerValueProofs, compiler_unrefined_binding
	compiler_type:
		CompilerType(
			CompilerArrayType,
			CompilerConstIntType,
			CompilerDimOpType,
			CompilerFunctionType,
			CompilerMetaType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerSelfType,
			CompilerTupleType,
			CompilerTypeVar,
			CompilerVarDimsType,
		),
		CompilerTypeSubstEntry,
		compiler_apply_subst,
		compiler_is_dim_var_name,
		compiler_type_subst_entry,
		compiler_types_equal,


enum CompilerVarMutability:
	CompilerImmutableBinding
	CompilerMutableBinding


union CompilerVarOrigin:
	CompilerLetBinding
	CompilerFuncParam
	CompilerForLoopVar
	CompilerMatchBinding
	CompilerScopedResource
	CompilerScopedResourceUnavailable(String)
	CompilerScopedResourceDerived
	CompilerOtherBinding


enum CompilerPurity:
	CompilerPure
	CompilerImpure


enum CompilerFuncOrigin:
	CompilerUserDefinedFunc
	CompilerBuiltinFunc
	CompilerForeignFunc


enum CompilerResourceResultPolicy:
	CompilerResourceResultDependent
	CompilerResourceResultIndependent
	CompilerResourceResultOrdinary


union CompilerResourceArgPolicy:
	CompilerRejectResourceArgs
	CompilerAllowResourceArgs(CompilerResourceResultPolicy)


enum CompilerLoopProducer:
	CompilerLoopProducerIndices
	CompilerLoopProducerEnumerate
	CompilerLoopProducerEnumerate2
	CompilerLoopProducerWindows


enum CompilerTypeKind:
	CompilerTypeUnion
	CompilerTypeEnum
	CompilerTypeBuiltin
	CompilerTypeResource


record CompilerFieldDecl {
	name: String,
	field_type: CompilerType
}


record CompilerVariantDef {
	name: String,
	fields: List[CompilerType],
	tag: Int
}


record CompilerVarSymbol {
	var_type: CompilerType,
	source_type: Option[CompilerType],
	mutability: CompilerVarMutability,
	origin: CompilerVarOrigin,
	refinement: CompilerValueProofs
}


record CompilerFuncSymbol {
	callable_id: Int,
	func_type: CompilerType,
	type_params: List[CompilerBoundTypeParam],
	param_names: List[Option[String]],
	purity: CompilerPurity,
	origin: CompilerFuncOrigin,
	resource_args: CompilerResourceArgPolicy,
	module_path: Option[String],
	dim_constraints: List[(CompilerType, CompilerType)],
	loop_producer: Option[CompilerLoopProducer],
	debug_only: Bool
}


record CompilerTypeSymbol {
	type_params: List[String],
	variants: List[CompilerVariantDef],
	type_kind: CompilerTypeKind,
	contains_resource: Bool
}


record CompilerRecordSymbol {
	type_params: List[String],
	fields: List[CompilerFieldDecl],
	is_value: Bool,
	contains_resource: Bool
}


record CompilerAliasSymbol {
	type_params: List[String],
	target: CompilerType
}


record CompilerOpaqueAliasSymbol {
	type_params: List[String],
	target: CompilerType,
	home_module: Option[String]
}


record CompilerConstructorSymbol {
	parent_type: String,
	constructor_id: Int,
	type_params: List[String],
	field_types: List[CompilerType],
	tag: Int
}


union CompilerSymbolKind:
	CompilerVarSymbolKind(CompilerVarSymbol)
	CompilerFuncSymbolKind(CompilerFuncSymbol)
	CompilerTypeSymbolKind(CompilerTypeSymbol)
	CompilerRecordSymbolKind(CompilerRecordSymbol)
	CompilerAliasSymbolKind(CompilerAliasSymbol)
	CompilerOpaqueAliasSymbolKind(CompilerOpaqueAliasSymbol)
	CompilerConstructorSymbolKind(CompilerConstructorSymbol)


record CompilerSymbol {
	name: String,
	kind: CompilerSymbolKind
}


record CompilerScope {
	symbols: List[CompilerSymbol]
}


union CompilerTypeBinding:
	CompilerUnionTypeBinding(CompilerTypeSymbol)
	CompilerRecordTypeBinding(CompilerRecordSymbol)
	CompilerAliasTypeBinding(CompilerAliasSymbol)
	CompilerOpaqueAliasTypeBinding(CompilerOpaqueAliasSymbol)


record CompilerTraitObligation {
	obligation_type: CompilerType,
	obligation_trait: CompilerTraitRef
}


enum CompilerTraitObligationResolution:
	CompilerTraitObligationSatisfied
	CompilerTraitObligationUnsatisfied
	CompilerTraitObligationDeferred


record CompilerTraitMethodSig {
	name: String,
	params: List[CompilerType],
	return_type: CompilerType,
	is_pure: Bool,
	has_default: Bool,
	param_names: List[Option[String]]
}


record CompilerTraitDef {
	def_id: Int,
	name: String,
	type_params: List[String],
	supertraits: List[String],
	methods: List[CompilerTraitMethodSig],
	module_path: Option[String]
}


record CompilerImplInstance {
	def_id: Int,
	trait_name: String,
	for_type: CompilerType,
	bounds: List[CompilerBoundTypeParam],
	is_builtin: Bool
}


record CompilerOverloadEntry {
	def_id: Int,
	func_type: CompilerType,
	type_params: List[CompilerBoundTypeParam],
	param_names: List[Option[String]],
	purity: CompilerPurity,
	origin: CompilerFuncOrigin,
	resource_args: CompilerResourceArgPolicy,
	module_path: Option[String],
	dim_constraints: List[(CompilerType, CompilerType)],
	loop_producer: Option[CompilerLoopProducer],
	debug_only: Bool
}


record CompilerOverloadSet {
	name: String,
	entries: List[CompilerOverloadEntry]
}


record CompilerEnv {
	scopes: List[CompilerScope],
	current_function: Option[String],
	current_function_pure: Bool,
	type_params_in_scope: List[String],
	type_param_bounds: List[CompilerBoundTypeParam],
	trait_functions: List[(String, String)],
	traits: List[CompilerTraitDef],
	impls: List[CompilerImplInstance],
	overloads: List[CompilerOverloadSet],
	ufcs_methods: List[CompilerOverloadSet],
	next_def_id: Int
}


private pure func compiler_empty_scope() -> CompilerScope:
	{symbols = []}


pure func compiler_env_empty() -> CompilerEnv:
	{
		scopes = [compiler_empty_scope()],
		current_function = None,
		current_function_pure = False,
		type_params_in_scope = [],
		type_param_bounds = [],
		trait_functions = [],
		traits = [],
		impls = [],
		overloads = [],
		ufcs_methods = [],
		next_def_id = 0
	}


pure func compiler_env_push_scope(env: CompilerEnv) -> CompilerEnv:
	{ env | scopes = [compiler_empty_scope()].concat(env.scopes) }


pure func compiler_env_pop_scope(env: CompilerEnv) -> CompilerEnv:
	if env.scopes.length() <= 1:
		env
	else:
		var rest: List[CompilerScope] = []
		var index: Int = 1

		while index < env.scopes.length():
			match env.scopes.get(index):
				Some(scope):
					rest = rest.append(scope)
				None:
					void

			index += 1

		{ env | scopes = rest }


pure func compiler_env_mint_def_id(env: CompilerEnv) -> (CompilerEnv, Int):
	({ env | next_def_id = env.next_def_id + 1 }, env.next_def_id)


private pure func compiler_symbol_is_type_binding(
	symbol: CompilerSymbol,
) -> Option[CompilerTypeBinding]:
	match symbol.kind:
		CompilerTypeSymbolKind(type_symbol):
			Some(CompilerUnionTypeBinding(type_symbol))
		CompilerRecordSymbolKind(record_symbol):
			Some(CompilerRecordTypeBinding(record_symbol))
		CompilerAliasSymbolKind(alias_symbol):
			Some(CompilerAliasTypeBinding(alias_symbol))
		CompilerOpaqueAliasSymbolKind(alias_symbol):
			Some(CompilerOpaqueAliasTypeBinding(alias_symbol))
		_:
			None


private pure func compiler_scope_add_symbol(
	scope: CompilerScope,
	symbol: CompilerSymbol,
) -> CompilerScope:
	{ scope | symbols = [symbol].concat(scope.symbols) }


pure func compiler_env_add_symbol(env: CompilerEnv, symbol: CompilerSymbol) -> CompilerEnv:
	match env.scopes.get(0):
		Some(current):
			var scopes: List[CompilerScope] = [compiler_scope_add_symbol(current, symbol)]
			var index: Int = 1

			while index < env.scopes.length():
				match env.scopes.get(index):
					Some(scope):
						scopes = scopes.append(scope)
					None:
						void

				index += 1

			{ env | scopes = scopes }
		None:
			{ env | scopes = [compiler_scope_add_symbol(compiler_empty_scope(), symbol)] }


pure func compiler_env_lookup_in_current_scope(
	env: CompilerEnv,
	name: String,
) -> Option[CompilerSymbol]:
	match env.scopes.get(0):
		Some(scope):
			var result: Option[CompilerSymbol] = None

			for symbol in scope.symbols:
				if symbol.name == name:
					result = Some(symbol)
					break

			result
		None:
			None


pure func compiler_env_lookup(env: CompilerEnv, name: String) -> Option[CompilerSymbol]:
	var result: Option[CompilerSymbol] = None

	for scope in env.scopes:
		for symbol in scope.symbols:
			if symbol.name == name:
				result = Some(symbol)
				break

		if result.is_some():
			break

	result


private pure func compiler_env_find_type_binding(
	env: CompilerEnv,
	name: String,
) -> Option[CompilerTypeBinding]:
	match compiler_env_lookup(env, name):
		Some(symbol):
			compiler_symbol_is_type_binding(symbol)
		None:
			None


pure func compiler_symbol_kind_label(symbol: CompilerSymbol) -> String:
	match symbol.kind:
		CompilerVarSymbolKind(_):
			"variable"
		CompilerFuncSymbolKind(_):
			"function"
		CompilerTypeSymbolKind(_):
			"type"
		CompilerRecordSymbolKind(_):
			"record"
		CompilerAliasSymbolKind(_):
			"type alias"
		CompilerOpaqueAliasSymbolKind(_):
			"opaque type"
		CompilerConstructorSymbolKind(_):
			"constructor"


pure func compiler_env_add_var_with_details(
	env: CompilerEnv,
	name: String,
	var_type: CompilerType,
	source_type: Option[CompilerType],
	mutability: CompilerVarMutability,
	origin: CompilerVarOrigin,
	refinement: CompilerValueProofs,
) -> CompilerEnv:
	compiler_env_add_symbol(
		env,
		{
			name = name,
			kind = CompilerVarSymbolKind({
				var_type = var_type,
				source_type = source_type,
				mutability = mutability,
				origin = origin,
				refinement = refinement,
			})
		},
	)


pure func compiler_env_add_var(
	env: CompilerEnv,
	name: String,
	var_type: CompilerType,
) -> CompilerEnv:
	compiler_env_add_var_with_details(
		env,
		name,
		var_type,
		None,
		CompilerImmutableBinding,
		CompilerLetBinding,
		compiler_unrefined_binding(),
	)


pure func compiler_env_get_var_type(env: CompilerEnv, name: String) -> Option[CompilerType]:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerVarSymbolKind(var_symbol):
					Some(var_symbol.var_type)
				CompilerFuncSymbolKind(func_symbol):
					Some(func_symbol.func_type)
				_:
					None
		None:
			None


pure func compiler_env_get_var_refinement(
	env: CompilerEnv,
	name: String,
) -> Option[CompilerValueProofs]:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerVarSymbolKind(var_symbol):
					Some(var_symbol.refinement)
				_:
					None
		None:
			None


pure func compiler_env_is_func_param(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerVarSymbolKind(var_symbol):
					match var_symbol.origin:
						CompilerFuncParam:
							True
						_:
							False
				_:
					False
		None:
			False


pure func compiler_env_is_scoped_resource_related_var(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerVarSymbolKind(var_symbol):
					match var_symbol.origin:
						CompilerScopedResource:
							True
						CompilerScopedResourceUnavailable(_):
							True
						CompilerScopedResourceDerived:
							True
						_:
							False
				_:
					False
		None:
			False


pure func compiler_func_symbol(
	callable_id: Int,
	func_type: CompilerType,
	type_params: List[CompilerBoundTypeParam],
	param_names: List[Option[String]],
	purity: CompilerPurity,
	origin: CompilerFuncOrigin,
	resource_args: CompilerResourceArgPolicy,
	module_path: Option[String],
	dim_constraints: List[(CompilerType, CompilerType)],
	loop_producer: Option[CompilerLoopProducer],
	debug_only: Bool,
) -> CompilerFuncSymbol:
	{
		callable_id = callable_id,
		func_type = func_type,
		type_params = type_params,
		param_names = param_names,
		purity = purity,
		origin = origin,
		resource_args = resource_args,
		module_path = module_path,
		dim_constraints = dim_constraints,
		loop_producer = loop_producer,
		debug_only = debug_only
	}


pure func compiler_env_add_func_with_info(
	env: CompilerEnv,
	name: String,
	info: CompilerFuncSymbol,
) -> CompilerEnv:
	compiler_env_add_symbol(
		env,
		{
			name = name,
			kind = CompilerFuncSymbolKind(info)
		},
	)


pure func compiler_env_add_func(
	env: CompilerEnv,
	name: String,
	func_type: CompilerType,
	purity: CompilerPurity,
	origin: CompilerFuncOrigin,
) -> CompilerEnv:
	match compiler_env_mint_def_id(env):
		(next_env, def_id):
			compiler_env_add_func_with_info(
				next_env,
				name,
				compiler_func_symbol(
					def_id,
					func_type,
					[],
					[],
					purity,
					origin,
					CompilerRejectResourceArgs,
					None,
					[],
					None,
					False,
				),
			)


pure func compiler_env_get_func_info(
	env: CompilerEnv,
	name: String,
) -> Option[(CompilerType, List[CompilerBoundTypeParam], CompilerPurity)]:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerFuncSymbolKind(func_symbol):
					Some((func_symbol.func_type, func_symbol.type_params, func_symbol.purity))
				_:
					None
		None:
			None


pure func compiler_env_get_func_callable_id(env: CompilerEnv, name: String) -> Option[Int]:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerFuncSymbolKind(func_symbol):
					Some(func_symbol.callable_id)
				_:
					None
		None:
			None


pure func compiler_env_is_builtin_func(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerFuncSymbolKind(func_symbol):
					func_symbol.origin == CompilerBuiltinFunc
				_:
					False
		None:
			False


pure func compiler_env_is_local_func(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerFuncSymbolKind(func_symbol):
					func_symbol.origin != CompilerBuiltinFunc and func_symbol.module_path.is_none()
				_:
					False
		None:
			False


pure func compiler_env_add_type(
	env: CompilerEnv,
	name: String,
	type_params: List[String],
	variants: List[CompilerVariantDef],
	type_kind: CompilerTypeKind,
	contains_resource: Bool,
	with_ctors: Bool,
) -> CompilerEnv:
	type_env: CompilerEnv = compiler_env_add_symbol(
		env,
		{
			name = name,
			kind = CompilerTypeSymbolKind({
				type_params = type_params,
				variants = variants,
				type_kind = type_kind,
				contains_resource = contains_resource,
			})
		},
	)

	if not with_ctors:
		type_env
	else:
		var current_env: CompilerEnv = type_env

		for variant in variants:
			match compiler_env_mint_def_id(current_env):
				(next_env, def_id):
					current_env = compiler_env_add_symbol(
						next_env,
						{
							name = variant.name,
							kind = CompilerConstructorSymbolKind({
								parent_type = name,
								constructor_id = def_id,
								type_params = type_params,
								field_types = variant.fields,
								tag = variant.tag,
							})
						},
					)

		current_env


pure func compiler_env_add_record(
	env: CompilerEnv,
	name: String,
	type_params: List[String],
	fields: List[CompilerFieldDecl],
	is_value: Bool,
	contains_resource: Bool,
) -> CompilerEnv:
	compiler_env_add_symbol(
		env,
		{
			name = name,
			kind = CompilerRecordSymbolKind({
				type_params = type_params,
				fields = fields,
				is_value = is_value,
				contains_resource = contains_resource,
			})
		},
	)


pure func compiler_env_add_alias(
	env: CompilerEnv,
	name: String,
	type_params: List[String],
	target: CompilerType,
) -> CompilerEnv:
	compiler_env_add_symbol(
		env,
		{
			name = name,
			kind = CompilerAliasSymbolKind({
				type_params = type_params,
				target = target,
			})
		},
	)


pure func compiler_env_add_opaque_alias(
	env: CompilerEnv,
	name: String,
	type_params: List[String],
	target: CompilerType,
	home_module: Option[String],
) -> CompilerEnv:
	compiler_env_add_symbol(
		env,
		{
			name = name,
			kind = CompilerOpaqueAliasSymbolKind({
				type_params = type_params,
				target = target,
				home_module = home_module,
			})
		},
	)


pure func compiler_env_get_type_decl(
	env: CompilerEnv,
	name: String,
) -> Option[(List[String], List[CompilerVariantDef])]:
	match compiler_env_find_type_binding(env, name):
		Some(CompilerUnionTypeBinding(type_symbol)):
			Some((type_symbol.type_params, type_symbol.variants))
		_:
			None


pure func compiler_env_get_type_kind(env: CompilerEnv, name: String) -> Option[CompilerTypeKind]:
	match compiler_env_find_type_binding(env, name):
		Some(CompilerUnionTypeBinding(type_symbol)):
			Some(type_symbol.type_kind)
		_:
			None


pure func compiler_env_get_type_contains_resource(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_find_type_binding(env, name):
		Some(CompilerUnionTypeBinding(type_symbol)):
			type_symbol.contains_resource
		Some(CompilerRecordTypeBinding(record_symbol)):
			record_symbol.contains_resource
		_:
			False


pure func compiler_env_get_constructor(
	env: CompilerEnv,
	name: String,
) -> Option[(String, List[String], List[CompilerType], Int)]:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerConstructorSymbolKind(ctor):
					Some((ctor.parent_type, ctor.type_params, ctor.field_types, ctor.tag))
				_:
					None
		None:
			None


pure func compiler_env_get_record(
	env: CompilerEnv,
	name: String,
) -> Option[(List[String], List[CompilerFieldDecl])]:
	match compiler_env_find_type_binding(env, name):
		Some(CompilerRecordTypeBinding(record_symbol)):
			Some((record_symbol.type_params, record_symbol.fields))
		_:
			None


pure func compiler_env_is_value_record(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_find_type_binding(env, name):
		Some(CompilerRecordTypeBinding(record_symbol)):
			record_symbol.is_value
		_:
			False


pure func compiler_env_get_alias(
	env: CompilerEnv,
	name: String,
) -> Option[(List[String], CompilerType)]:
	match compiler_env_find_type_binding(env, name):
		Some(CompilerAliasTypeBinding(alias_symbol)):
			Some((alias_symbol.type_params, alias_symbol.target))
		_:
			None


pure func compiler_env_get_opaque_alias(
	env: CompilerEnv,
	name: String,
) -> Option[(List[String], CompilerType, Option[String])]:
	match compiler_env_find_type_binding(env, name):
		Some(CompilerOpaqueAliasTypeBinding(alias_symbol)):
			Some((alias_symbol.type_params, alias_symbol.target, alias_symbol.home_module))
		_:
			None


private pure func compiler_field_names_match(
	fields: List[CompilerFieldDecl],
	names: List[String],
) -> Bool:
	fields
		.map(func(field): field.name)
		.sort() == names.sort()


pure func compiler_env_find_records_with_fields(
	env: CompilerEnv,
	field_names: List[String],
) -> List[String]:
	var matches: List[String] = []

	for scope in env.scopes:
		for symbol in scope.symbols:
			match symbol.kind:
				CompilerRecordSymbolKind(record_symbol):
					if (
						compiler_field_names_match(record_symbol.fields, field_names)
						and not matches.contains(symbol.name)
					):
						matches = matches.append(symbol.name)
				_:
					void

	matches


private pure func compiler_nominal_dim_params(
	env: CompilerEnv,
	name: String,
) -> Option[List[String]]:
	params: Option[List[String]] = match compiler_env_get_record(env, name):
		Some((type_params, _)):
			Some(type_params)
		None:
			match compiler_env_get_type_decl(env, name):
				Some((type_params, _)):
					Some(type_params)
				None:
					match compiler_env_get_alias(env, name):
						Some((type_params, _)):
							Some(type_params)
						None:
							match compiler_env_get_opaque_alias(env, name):
								Some((type_params, _, _)):
									Some(type_params)
								None:
									None

	match params:
		Some(type_params):
			if type_params.length() > 0 and type_params.all(compiler_is_dim_var_name):
				Some(type_params)
			else:
				None
		None:
			None


pure func compiler_env_disambiguate_nominal_dim_application(
	env: CompilerEnv,
	typ: CompilerType,
) -> CompilerType:
	match typ:
		CompilerArrayType(CompilerNamedType(name, args), dims):
			resolved_dims: List[CompilerType] = dims.map(
				func(dim): compiler_env_disambiguate_nominal_dim_application(env, dim),
			)

			if args.length() == 0:
				match compiler_nominal_dim_params(env, name):
					Some(params):
						if params.length() == resolved_dims.length():
							CompilerNamedType(name, resolved_dims)
						else:
							CompilerArrayType(
								CompilerNamedType(name, []),
								resolved_dims,
							)
					None:
						CompilerArrayType(
							CompilerNamedType(name, []),
							resolved_dims,
						)
			else:
				CompilerArrayType(
					CompilerNamedType(
						name,
						args.map(
							func(
								arg,
							): compiler_env_disambiguate_nominal_dim_application(env, arg),
						),
					),
					resolved_dims,
				)
		CompilerArrayType(element, dims):
			CompilerArrayType(
				compiler_env_disambiguate_nominal_dim_application(env, element),
				dims.map(func(dim): compiler_env_disambiguate_nominal_dim_application(env, dim)),
			)
		CompilerNamedType(name, args):
			CompilerNamedType(
				name,
				args.map(func(arg): compiler_env_disambiguate_nominal_dim_application(env, arg)),
			)
		CompilerFunctionType(is_pure, params, return_type):
			CompilerFunctionType(
				is_pure,
				params.map(
					func(param): compiler_env_disambiguate_nominal_dim_application(env, param),
				),
				compiler_env_disambiguate_nominal_dim_application(env, return_type),
			)
		CompilerTupleType(elements):
			CompilerTupleType(elements.map(
				func(element): compiler_env_disambiguate_nominal_dim_application(env, element),
			))
		CompilerRangeType(inner):
			CompilerRangeType(compiler_env_disambiguate_nominal_dim_application(env, inner))
		CompilerDimOpType(op, left, right):
			CompilerDimOpType(
				op,
				compiler_env_disambiguate_nominal_dim_application(env, left),
				compiler_env_disambiguate_nominal_dim_application(env, right),
			)
		_:
			typ


private pure func compiler_subst_for_params(
	type_params: List[String],
	args: List[CompilerType],
) -> List[CompilerTypeSubstEntry]:
	var subst: List[CompilerTypeSubstEntry] = []
	var index: Int = 0

	while index < type_params.length() and index < args.length():
		match (type_params.get(index), args.get(index)):
			(Some(type_param), Some(arg)):
				subst = subst.append(compiler_type_subst_entry(type_param, arg))
			_:
				void

		index += 1

	subst


private pure func compiler_env_copy_type(typ: CompilerType) -> CompilerType:
	match typ:
		CompilerNamedType(name, args):
			CompilerNamedType(
				name,
				args.map(compiler_env_copy_type),
			)
		CompilerArrayType(element, dims):
			CompilerArrayType(
				compiler_env_copy_type(element),
				dims.map(compiler_env_copy_type),
			)
		CompilerFunctionType(is_pure, params, return_type):
			CompilerFunctionType(
				is_pure,
				params.map(compiler_env_copy_type),
				compiler_env_copy_type(return_type),
			)
		CompilerTupleType(elements):
			CompilerTupleType(elements.map(compiler_env_copy_type))
		CompilerRangeType(inner):
			CompilerRangeType(compiler_env_copy_type(inner))
		CompilerDimOpType(op, left, right):
			CompilerDimOpType(op, compiler_env_copy_type(left), compiler_env_copy_type(right))
		_:
			typ


private pure func compiler_env_resolve_alias_seen(
	env: CompilerEnv,
	seen: String,
	typ: CompilerType,
) -> CompilerType:
	match typ:
		CompilerNamedType(name, args):
			seen_key: String = "|" + name + "|"

			if seen.contains(seen_key):
				compiler_env_copy_type(typ)
			else:
				resolved_args: List[CompilerType] = args.map(
					func(arg): compiler_env_resolve_alias_seen(env, seen, arg),
				)

				match compiler_env_get_alias(env, name):
					Some((type_params, target)):
						if type_params.length() == resolved_args.length():
							subst: List[CompilerTypeSubstEntry] = compiler_subst_for_params(
								type_params,
								resolved_args,
							)
							next_seen: String = seen + seen_key
							substituted: CompilerType = compiler_apply_subst(
								subst,
								compiler_env_copy_type(target),
							)
							compiler_env_resolve_alias_seen(env, next_seen, substituted)
						else:
							CompilerNamedType(name, resolved_args)
					None:
						CompilerNamedType(name, resolved_args)
		CompilerArrayType(element, dims):
			CompilerArrayType(
				compiler_env_resolve_alias_seen(env, seen, element),
				dims.map(func(dim): compiler_env_resolve_alias_seen(env, seen, dim)),
			)
		CompilerFunctionType(is_pure, params, return_type):
			CompilerFunctionType(
				is_pure,
				params.map(func(param): compiler_env_resolve_alias_seen(env, seen, param)),
				compiler_env_resolve_alias_seen(env, seen, return_type),
			)
		CompilerTupleType(elements):
			CompilerTupleType(elements.map(
				func(element): compiler_env_resolve_alias_seen(env, seen, element),
			))
		CompilerRangeType(inner):
			CompilerRangeType(compiler_env_resolve_alias_seen(env, seen, inner))
		CompilerDimOpType(op, left, right):
			CompilerDimOpType(
				op,
				compiler_env_resolve_alias_seen(env, seen, left),
				compiler_env_resolve_alias_seen(env, seen, right),
			)
		_:
			compiler_env_copy_type(typ)


pure func compiler_env_resolve_alias(env: CompilerEnv, typ: CompilerType) -> CompilerType:
	compiler_env_resolve_alias_seen(env, "", typ)


pure func compiler_env_set_type_param_bounds(
	env: CompilerEnv,
	params: List[CompilerBoundTypeParam],
) -> CompilerEnv:
	{ env |
		type_params_in_scope = params.map(compiler_bound_type_param_name),
		type_param_bounds = params
	}


pure func compiler_env_get_type_params(env: CompilerEnv) -> List[String]:
	env.type_params_in_scope


pure func compiler_env_get_type_param_bounds(env: CompilerEnv, param_name: String) -> List[String]:
	var result: List[String] = []

	for param in env.type_param_bounds:
		if param.name == param_name:
			result = param.bounds.map(compiler_trait_ref_name)
			break

	result


pure func compiler_env_has_trait_bound(
	env: CompilerEnv,
	param_name: String,
	trait_name: String,
) -> Bool:
	compiler_env_get_type_param_bounds(env, param_name).contains(trait_name)


pure func compiler_trait_method_sig(
	name: String,
	params: List[CompilerType],
	return_type: CompilerType,
	is_pure: Bool,
) -> CompilerTraitMethodSig:
	{
		name = name,
		params = params,
		return_type = return_type,
		is_pure = is_pure,
		has_default = False,
		param_names = []
	}


pure func compiler_trait_def(
	def_id: Int,
	name: String,
	supertraits: List[String],
	methods: List[CompilerTraitMethodSig],
) -> CompilerTraitDef:
	{
		def_id = def_id,
		name = name,
		type_params = [],
		supertraits = supertraits,
		methods = methods,
		module_path = None
	}


pure func compiler_env_add_trait(env: CompilerEnv, trait_def: CompilerTraitDef) -> CompilerEnv:
	var traits: List[CompilerTraitDef] = []
	var replaced: Bool = False

	for existing in env.traits:
		if existing.name == trait_def.name:
			traits = traits.append(trait_def)
			replaced = True
		else:
			traits = traits.append(existing)

	if not replaced:
		traits = traits.append(trait_def)

	{ env | traits = traits }


pure func compiler_env_get_trait(env: CompilerEnv, name: String) -> Option[CompilerTraitDef]:
	var result: Option[CompilerTraitDef] = None

	for trait_def in env.traits:
		if trait_def.name == name:
			result = Some(trait_def)
			break

	result


private pure func compiler_trait_has_supertrait_seen(
	env: CompilerEnv,
	seen: List[String],
	trait_name: String,
	target: String,
) -> Bool:
	if trait_name == target:
		True
	else if seen.contains(trait_name):
		False
	else:
		match compiler_env_get_trait(env, trait_name):
			Some(trait_def):
				var found: Bool = False

				for supertrait in trait_def.supertraits:
					if compiler_trait_has_supertrait_seen(
						env,
						seen.append(trait_name),
						supertrait,
						target,
					):
						found = True
						break

				found
			None:
				False


pure func compiler_env_trait_has_supertrait(
	env: CompilerEnv,
	trait_name: String,
	target: String,
) -> Bool:
	if trait_name == target:
		False
	else:
		compiler_trait_has_supertrait_seen(env, [], trait_name, target)


private pure func compiler_append_unique_string(
	values: List[String],
	value: String,
) -> List[String]:
	if values.contains(value):
		values
	else:
		values.append(value)


private pure func compiler_trait_method_names_seen(
	env: CompilerEnv,
	seen: List[String],
	trait_name: String,
) -> List[String]:
	if seen.contains(trait_name):
		[]
	else:
		match compiler_env_get_trait(env, trait_name):
			Some(trait_def):
				var names: List[String] = []

				for method in trait_def.methods:
					names = compiler_append_unique_string(names, method.name)

				for supertrait in trait_def.supertraits:
					for name in compiler_trait_method_names_seen(
						env,
						seen.append(trait_name),
						supertrait,
					):
						names = compiler_append_unique_string(names, name)

				names
			None:
				[]


pure func compiler_env_trait_method_names_transitive(
	env: CompilerEnv,
	trait_name: String,
) -> List[String]:
	compiler_trait_method_names_seen(env, [], trait_name)


pure func compiler_env_has_trait_bound_transitive(
	env: CompilerEnv,
	param_name: String,
	trait_name: String,
) -> Bool:
	var result: Bool = False

	for bound in compiler_env_get_type_param_bounds(env, param_name):
		if bound == trait_name or compiler_env_trait_has_supertrait(env, bound, trait_name):
			result = True
			break

	result


pure func compiler_env_trait_function_collision(
	env: CompilerEnv,
	func_name: String,
	trait_name: String,
) -> Option[String]:
	var result: Option[String] = None

	for pair in env.trait_functions:
		if pair[0] == func_name and pair[1] != trait_name:
			result = Some(pair[1])
			break

	result


pure func compiler_env_add_trait_function(
	env: CompilerEnv,
	func_name: String,
	trait_name: String,
) -> CompilerEnv:
	var exists: Bool = False

	for pair in env.trait_functions:
		if pair[0] == func_name and pair[1] == trait_name:
			exists = True
			break

	if exists:
		env
	else:
		{ env | trait_functions = env.trait_functions.append((func_name, trait_name)) }


pure func compiler_env_get_function_trait(env: CompilerEnv, func_name: String) -> Option[String]:
	var result: Option[String] = None

	for pair in env.trait_functions:
		if pair[0] == func_name:
			result = Some(pair[1])
			break

	result


pure func compiler_trait_obligation(
	obligation_type: CompilerType,
	trait_name: String,
) -> CompilerTraitObligation:
	{
		obligation_type = obligation_type,
		obligation_trait = compiler_trait_ref(trait_name)
	}


pure func compiler_trait_obligations_for_bound_type_param(
	param: CompilerBoundTypeParam,
	concrete_type: CompilerType,
) -> List[CompilerTraitObligation]:
	param.bounds.map(func(bound): {
			obligation_type = concrete_type,
			obligation_trait = bound
		})


pure func compiler_impl_instance(
	def_id: Int,
	trait_name: String,
	for_type: CompilerType,
	bounds: List[CompilerBoundTypeParam],
	is_builtin: Bool,
) -> CompilerImplInstance:
	{
		def_id = def_id,
		trait_name = trait_name,
		for_type = for_type,
		bounds = bounds,
		is_builtin = is_builtin
	}


pure func compiler_env_add_impl(env: CompilerEnv, impl: CompilerImplInstance) -> CompilerEnv:
	{ env | impls = env.impls.append(impl) }


pure func compiler_env_find_conflicting_impl(
	env: CompilerEnv,
	candidate: CompilerImplInstance,
) -> Option[CompilerImplInstance]:
	var result: Option[CompilerImplInstance] = None

	for existing in env.impls:
		if (
			not existing.is_builtin
			and not candidate.is_builtin
			and existing.trait_name == candidate.trait_name
			and compiler_types_equal(existing.for_type, candidate.for_type)
		):
			result = Some(existing)
			break

	result


private pure func compiler_impl_satisfies_trait(
	env: CompilerEnv,
	impl: CompilerImplInstance,
	trait_name: String,
) -> Bool:
	(
		impl.trait_name == trait_name
		or compiler_env_trait_has_supertrait(env, impl.trait_name, trait_name)
	)


pure func compiler_env_resolve_trait_obligation(
	env: CompilerEnv,
	obligation: CompilerTraitObligation,
) -> CompilerTraitObligationResolution:
	match obligation.obligation_type:
		CompilerMetaType(_):
			CompilerTraitObligationDeferred
		CompilerTypeVar(name):
			if compiler_env_has_trait_bound_transitive(env, name, obligation.obligation_trait.name):
				CompilerTraitObligationSatisfied
			else:
				CompilerTraitObligationUnsatisfied
		CompilerNamedType(name, args):
			if (
				args.length() == 0
				and compiler_env_has_trait_bound_transitive(
					env,
					name,
					obligation.obligation_trait.name,
				)
			):
				CompilerTraitObligationSatisfied
			else:
				var result: CompilerTraitObligationResolution = CompilerTraitObligationUnsatisfied

				for impl in env.impls:
					if (
						compiler_impl_satisfies_trait(env, impl, obligation.obligation_trait.name)
						and compiler_types_equal(impl.for_type, obligation.obligation_type)
					):
						result = CompilerTraitObligationSatisfied
						break

				result
		_:
			var result: CompilerTraitObligationResolution = CompilerTraitObligationUnsatisfied

			for impl in env.impls:
				if (
					compiler_impl_satisfies_trait(env, impl, obligation.obligation_trait.name)
					and compiler_types_equal(impl.for_type, obligation.obligation_type)
				):
					result = CompilerTraitObligationSatisfied
					break

			result


pure func compiler_env_find_unsatisfied_trait_obligation(
	env: CompilerEnv,
	obligations: List[CompilerTraitObligation],
) -> Option[CompilerTraitObligation]:
	var result: Option[CompilerTraitObligation] = None

	for obligation in obligations:
		match compiler_env_resolve_trait_obligation(env, obligation):
			CompilerTraitObligationUnsatisfied:
				result = Some(obligation)
				break
			_:
				void

	result


pure func compiler_resolve_self(concrete_type: CompilerType, typ: CompilerType) -> CompilerType:
	match typ:
		CompilerSelfType:
			concrete_type
		CompilerNamedType(name, args):
			CompilerNamedType(
				name,
				args.map(func(arg): compiler_resolve_self(concrete_type, arg)),
			)
		CompilerArrayType(element, dims):
			CompilerArrayType(
				compiler_resolve_self(concrete_type, element),
				dims.map(func(dim): compiler_resolve_self(concrete_type, dim)),
			)
		CompilerFunctionType(is_pure, params, return_type):
			CompilerFunctionType(
				is_pure,
				params.map(func(param): compiler_resolve_self(concrete_type, param)),
				compiler_resolve_self(concrete_type, return_type),
			)
		CompilerTupleType(elements):
			CompilerTupleType(elements.map(
				func(element): compiler_resolve_self(concrete_type, element),
			))
		CompilerRangeType(inner):
			CompilerRangeType(compiler_resolve_self(concrete_type, inner))
		CompilerDimOpType(op, left, right):
			CompilerDimOpType(
				op,
				compiler_resolve_self(concrete_type, left),
				compiler_resolve_self(concrete_type, right),
			)
		_:
			typ


pure func compiler_overload_type_param_names(entry: CompilerOverloadEntry) -> List[String]:
	entry.type_params.map(compiler_bound_type_param_name)


private pure func compiler_replace_overload_set(
	sets: List[CompilerOverloadSet],
	name: String,
	entries: List[CompilerOverloadEntry],
) -> List[CompilerOverloadSet]:
	var result: List[CompilerOverloadSet] = []
	var replaced: Bool = False

	for set in sets:
		if set.name == name:
			result = result.append({
				name = name,
				entries = entries,
			})
			replaced = True
		else:
			result = result.append(set)

	if replaced:
		result
	else:
		result.append({
			name = name,
			entries = entries,
		})


private pure func compiler_find_overload_set(
	sets: List[CompilerOverloadSet],
	name: String,
) -> Option[CompilerOverloadSet]:
	var result: Option[CompilerOverloadSet] = None

	for set in sets:
		if set.name == name:
			result = Some(set)
			break

	result


pure func compiler_env_add_overload(
	env: CompilerEnv,
	name: String,
	entry: CompilerOverloadEntry,
) -> CompilerEnv:
	entries: List[CompilerOverloadEntry] = match compiler_find_overload_set(env.overloads, name):
		Some(set):
			set.entries.append(entry)
		None:
			[entry]

	{ env | overloads = compiler_replace_overload_set(env.overloads, name, entries) }


pure func compiler_env_get_overloads(env: CompilerEnv, name: String) -> List[CompilerOverloadEntry]:
	match compiler_find_overload_set(env.overloads, name):
		Some(set):
			set.entries
		None:
			[]


private pure func compiler_find_entry_by_def_id(
	sets: List[CompilerOverloadSet],
	def_id: Int,
) -> Option[CompilerOverloadEntry]:
	var result: Option[CompilerOverloadEntry] = None

	for set in sets:
		for entry in set.entries:
			if entry.def_id == def_id:
				result = Some(entry)
				break

		if result.is_some():
			break

	result


pure func compiler_env_find_overload_by_def_id(
	env: CompilerEnv,
	def_id: Int,
) -> Option[CompilerOverloadEntry]:
	compiler_find_entry_by_def_id(env.overloads, def_id)


pure func compiler_env_find_ufcs_method_by_def_id(
	env: CompilerEnv,
	def_id: Int,
) -> Option[CompilerOverloadEntry]:
	compiler_find_entry_by_def_id(env.ufcs_methods, def_id)


private pure func compiler_function_first_param_type(
	func_type: CompilerType,
) -> Option[CompilerType]:
	match func_type:
		CompilerFunctionType(_, params, _):
			params.get(0)
		_:
			None


pure func compiler_env_resolve_overload(
	env: CompilerEnv,
	name: String,
	first_arg_type: CompilerType,
) -> Option[CompilerOverloadEntry]:
	var result: Option[CompilerOverloadEntry] = None

	for entry in compiler_env_get_overloads(env, name):
		match compiler_function_first_param_type(entry.func_type):
			Some(param_type):
				if compiler_types_equal(param_type, first_arg_type):
					result = Some(entry)
					break
			None:
				void

	result


pure func compiler_env_add_ufcs_method(
	env: CompilerEnv,
	name: String,
	entry: CompilerOverloadEntry,
) -> CompilerEnv:
	entries: List[CompilerOverloadEntry] = match compiler_find_overload_set(env.ufcs_methods, name):
		Some(set):
			set.entries.append(entry)
		None:
			[entry]

	{ env | ufcs_methods = compiler_replace_overload_set(env.ufcs_methods, name, entries) }


pure func compiler_env_lookup_ufcs_methods(
	env: CompilerEnv,
	name: String,
	first_arg_type: CompilerType,
) -> List[CompilerOverloadEntry]:
	var result: List[CompilerOverloadEntry] = []

	match compiler_find_overload_set(env.ufcs_methods, name):
		Some(set):
			for entry in set.entries:
				match compiler_function_first_param_type(entry.func_type):
					Some(param_type):
						if compiler_types_equal(param_type, first_arg_type):
							result = result.append(entry)
					None:
						void
		None:
			void

	result


pure func compiler_env_has_ufcs_method(env: CompilerEnv, name: String) -> Bool:
	match compiler_find_overload_set(env.ufcs_methods, name):
		Some(set):
			set.entries.length() > 0
		None:
			False


pure func compiler_env_find_similar(env: CompilerEnv, name: String) -> Option[String]:
	var result: Option[String] = None

	for scope in env.scopes:
		for symbol in scope.symbols:
			if symbol.name.starts_with(name) or name.starts_with(symbol.name):
				result = Some(symbol.name)
				break

		if result.is_some():
			break

	result
