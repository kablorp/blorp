-- JSON encoding for Blorp CLI plans crossing the compiler bridge.
import:
	compiler_bridge_protocol: BRIDGE_SCHEMA_VERSION, bridge_success_json
	compiler_cli_args:
		CliCheckArgs,
		CliCompileArgs,
		CliPurifyArgs,
		CliRunArgs,
		CliSanitizerMode(CliSanitizeAddressUndefined, CliSanitizeOff, CliSanitizeUndefined),
		CliTestArgs,
		CliTestMode(CliTestAll, CliTestDocOnly, CliTestSuiteOnly),
	compiler_cli_plan:
		CliCheckSourceBatch,
		CliDelegationIo(BatchCliDelegation, TerminalCliDelegation),
		CliFrontendCommand(CliFrontendCheck, CliFrontendCompile, CliFrontendRun),
		CliFrontendOptionsPlan,
		CliFrontendParsedSource,
		CliLspRunPlan,
		CliPackageRunCommand(
			CliPackageRunCheck,
			CliPackageRunFetchAll,
			CliPackageRunFetchTarget,
			CliPackageRunHash,
			CliPackageRunPack,
			CliPackageRunVendorAll,
			CliPackageRunVendorTarget,
		),
		CliPackageRunPlan,
		CliParsedSourceFile,
		CliPurifyRunPlan,
		CliReplRunPlan,
		CliRunPlan(
			CliRunDelegate,
			CliRunFrontendOptions,
			CliRunHandled,
			CliRunLsp,
			CliRunPackage,
			CliRunParsedSource,
			CliRunParsedSourceBatch,
			CliRunPurify,
			CliRunRepl,
			CliRunTest,
		),
		CliTestRunPlan,
		LegacyCliDelegation,
	json: JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector)


private pure func cli_frontend_command_name(command: CliFrontendCommand) -> String:
	match command:
		CliFrontendCheck:
			"check"
		CliFrontendCompile:
			"compile"
		CliFrontendRun:
			"run"


private pure func delegation_io_name(io: CliDelegationIo) -> String:
	match io:
		BatchCliDelegation:
			"batch"
		TerminalCliDelegation:
			"terminal"


private pure func json_string_list(values: List[String]) -> JsonValue:
	var items: List[JsonValue] = []

	for value in values:
		items = items.append(JsonString(value))

	JsonVector(items)


private pure func json_optional_string(value: Option[String]) -> JsonValue:
	match value:
		Some(text):
			JsonString(text)
		None:
			JsonNull


private pure func json_optional_int(value: Option[Int]) -> JsonValue:
	match value:
		Some(number):
			JsonNumber(to_float(number))
		None:
			JsonNull


private pure func cli_sanitizer_mode_name(mode: CliSanitizerMode) -> String:
	match mode:
		CliSanitizeOff:
			"off"
		CliSanitizeAddressUndefined:
			"address_undefined"
		CliSanitizeUndefined:
			"undefined"


private pure func json_optional_sanitizer_mode(value: Option[CliSanitizerMode]) -> JsonValue:
	match value:
		Some(mode):
			JsonString(cli_sanitizer_mode_name(mode))
		None:
			JsonNull


pure func cli_check_options_json(args: CliCheckArgs) -> JsonValue:
	JsonObject([
		("kind", JsonString("check")),
		("dump_ast", JsonBool(args.dump_ast)),
		("dump_typed_ast", JsonBool(args.dump_typed_ast)),
		("debug", JsonBool(args.debug)),
		("no_format", JsonBool(args.no_format)),
		("std_dir", json_optional_string(args.std_dir)),
		("paths", json_string_list(args.paths)),
	])


pure func cli_compile_options_json(args: CliCompileArgs) -> JsonValue:
	JsonObject([
		("kind", JsonString("compile")),
		("ast_only", JsonBool(args.ast_only)),
		("dump_ast", JsonBool(args.dump_ast)),
		("dump_typed_ast", JsonBool(args.dump_typed_ast)),
		("dump_core_after", json_string_list(args.dump_core_after)),
		("dump_file", json_optional_string(args.dump_file)),
		("stop_after", json_optional_string(args.stop_after)),
		("time_phases", JsonBool(args.time_phases)),
		("check_invariants", JsonBool(args.check_invariants)),
		("debug", JsonBool(args.debug)),
		("no_format", JsonBool(args.no_format)),
		("embed_runtime", JsonBool(args.embed_runtime)),
		("std_dir", json_optional_string(args.std_dir)),
		("output", json_optional_string(args.output)),
		("files", json_string_list(args.files)),
	])


pure func cli_run_options_json(args: CliRunArgs) -> JsonValue:
	JsonObject([
		("kind", JsonString("run")),
		("profile", JsonBool(args.profile)),
		("debug", JsonBool(args.debug)),
		("sanitizer", json_optional_sanitizer_mode(args.sanitizer)),
		("leak_check", JsonBool(args.leak_check)),
		("release", JsonBool(args.release)),
		("no_format", JsonBool(args.no_format)),
		("timeout", json_optional_int(args.timeout)),
		("threads", json_optional_int(args.threads)),
		("std_dir", json_optional_string(args.std_dir)),
		("files", json_string_list(args.files)),
		("user_args", json_string_list(args.user_args)),
	])


private pure func cli_test_mode_name(mode: CliTestMode) -> String:
	match mode:
		CliTestAll:
			"all"
		CliTestDocOnly:
			"doc"
		CliTestSuiteOnly:
			"suite"


pure func cli_test_options_json(args: CliTestArgs) -> JsonValue:
	JsonObject([
		("kind", JsonString("test")),
		("profile", JsonBool(args.profile)),
		("debug", JsonBool(args.debug)),
		("sanitizer", json_optional_sanitizer_mode(args.sanitizer)),
		("leak_check", JsonBool(args.leak_check)),
		("no_format", JsonBool(args.no_format)),
		("timeout", json_optional_int(args.timeout)),
		("jobs", JsonNumber(to_float(args.jobs))),
		("repeat", JsonNumber(to_float(args.repeat))),
		("mode", JsonString(cli_test_mode_name(args.mode))),
		("cache", JsonBool(args.cache)),
		("std_dir", json_optional_string(args.std_dir)),
		("paths", json_string_list(args.paths)),
	])


pure func cli_test_warmup_options_json() -> JsonValue:
	JsonObject([("kind", JsonString("test_warmup"))])


pure func cli_purify_options_json(args: CliPurifyArgs) -> JsonValue:
	JsonObject([
		("kind", JsonString("purify")),
		("dry_run", JsonBool(args.dry_run)),
		("verbose", JsonBool(args.verbose)),
		("paths", json_string_list(args.paths)),
	])


pure func cli_parsed_source_file_json(source: CliParsedSourceFile) -> JsonValue:
	JsonObject([
		("path", JsonString(source.path)),
		("module", JsonString(source.module_name)),
		("source_text", JsonString(source.source_text)),
		("parsed_source", source.parsed_source),
	])


private pure func cli_parsed_source_files_json(sources: List[CliParsedSourceFile]) -> JsonValue:
	var items: List[JsonValue] = []

	for source in sources:
		items = items.append(cli_parsed_source_file_json(source))

	JsonVector(items)


pure func cli_check_source_batch_artifact_json(batch: CliCheckSourceBatch) -> JsonValue:
	if batch.modules.length() > 0:
		JsonObject([
			("kind", JsonString("parsed_source_graph")),
			("command", JsonString("check")),
			("args", json_string_list(batch.args)),
			("options", batch.options),
			("roots", cli_parsed_source_files_json(batch.sources)),
			("modules", cli_parsed_source_files_json(batch.modules)),
		])
	else:
		JsonObject([
			("kind", JsonString("parsed_source_batch")),
			("command", JsonString("check")),
			("args", json_string_list(batch.args)),
			("options", batch.options),
			("sources", cli_parsed_source_files_json(batch.sources)),
		])


private pure func cli_frontend_parsed_artifact_json(parsed: CliFrontendParsedSource) -> JsonValue:
	if parsed.modules.length() > 0:
		JsonObject([
			("kind", JsonString("parsed_source_graph")),
			("command", JsonString(cli_frontend_command_name(parsed.command))),
			("args", json_string_list(parsed.args)),
			("options", parsed.options),
			("roots", cli_parsed_source_files_json([parsed.source])),
			("modules", cli_parsed_source_files_json(parsed.modules)),
		])
	else:
		JsonObject([
			("kind", JsonString("parsed_source")),
			("command", JsonString(cli_frontend_command_name(parsed.command))),
			("args", json_string_list(parsed.args)),
			("options", parsed.options),
			("source", cli_parsed_source_file_json(parsed.source)),
		])


private pure func cli_frontend_options_artifact_json(plan: CliFrontendOptionsPlan) -> JsonValue:
	JsonObject([
		("kind", JsonString("frontend_options")),
		("command", JsonString(cli_frontend_command_name(plan.command))),
		("args", json_string_list(plan.args)),
		("options", plan.options),
	])


private pure func cli_delegation_artifact_json(delegation: LegacyCliDelegation) -> JsonValue:
	JsonObject([
		("kind", JsonString("delegate")),
		("args", json_string_list(delegation.args)),
		("io", JsonString(delegation_io_name(delegation.io))),
	])


private pure func cli_test_artifact_json(test_plan: CliTestRunPlan) -> JsonValue:
	JsonObject([
		("kind", JsonString("test")),
		("args", json_string_list(test_plan.args)),
		("options", test_plan.options),
	])


private pure func cli_purify_artifact_json(purify_plan: CliPurifyRunPlan) -> JsonValue:
	JsonObject([
		("kind", JsonString("purify")),
		("args", json_string_list(purify_plan.args)),
		("options", purify_plan.options),
	])


private pure func cli_repl_artifact_json(repl_plan: CliReplRunPlan) -> JsonValue:
	JsonObject([
		("kind", JsonString("repl")),
		("args", json_string_list(repl_plan.args)),
		("debug", JsonBool(repl_plan.debug)),
	])


private pure func cli_lsp_artifact_json(lsp_plan: CliLspRunPlan) -> JsonValue:
	JsonObject([
		("kind", JsonString("lsp")),
		("args", json_string_list(lsp_plan.args)),
	])


private pure func cli_package_command_json(command: CliPackageRunCommand) -> JsonValue:
	match command:
		CliPackageRunCheck(path):
			JsonObject([("kind", JsonString("check")), ("path", JsonString(path))])
		CliPackageRunHash(path):
			JsonObject([("kind", JsonString("hash")), ("path", JsonString(path))])
		CliPackageRunPack(path, output):
			JsonObject([
				("kind", JsonString("pack")),
				("path", JsonString(path)),
				("output", JsonString(output)),
			])
		CliPackageRunFetchAll:
			JsonObject([("kind", JsonString("fetch_all"))])
		CliPackageRunFetchTarget(target, locations):
			JsonObject([
				("kind", JsonString("fetch_target")),
				("target", JsonString(target)),
				("from", json_string_list(locations)),
			])
		CliPackageRunVendorAll:
			JsonObject([("kind", JsonString("vendor_all"))])
		CliPackageRunVendorTarget(target, dest):
			match dest:
				Some(path):
					JsonObject([
						("kind", JsonString("vendor_target")),
						("target", JsonString(target)),
						("dest", JsonString(path)),
					])
				None:
					JsonObject([
						("kind", JsonString("vendor_target")),
						("target", JsonString(target)),
						("dest", JsonNull),
					])


private pure func cli_package_artifact_json(package_plan: CliPackageRunPlan) -> JsonValue:
	JsonObject([
		("kind", JsonString("package")),
		("args", json_string_list(package_plan.args)),
		("command", cli_package_command_json(package_plan.command)),
	])


pure func cli_command_error_json(message: String, status: Int) -> JsonValue:
	JsonObject([
		("schema", JsonNumber(to_float(BRIDGE_SCHEMA_VERSION))),
		("ok", JsonBool(False)),
		("error", JsonObject([
				("code", JsonString("cli_command_error")),
				("message", JsonString(message)),
				("status", JsonNumber(to_float(status))),
			])),
	])


pure func cli_run_plan_to_json(plan: CliRunPlan) -> JsonValue:
	match plan:
		CliRunHandled(result):
			bridge_success_json(JsonObject([
				("kind", JsonString("handled")),
				("status", JsonNumber(to_float(result.status))),
				("stdout", JsonString(result.stdout)),
				("stderr", JsonString(result.stderr)),
			]))
		CliRunDelegate(delegation):
			bridge_success_json(cli_delegation_artifact_json(delegation))
		CliRunParsedSource(parsed):
			bridge_success_json(cli_frontend_parsed_artifact_json(parsed))
		CliRunParsedSourceBatch(batch):
			bridge_success_json(cli_check_source_batch_artifact_json(batch))
		CliRunFrontendOptions(frontend_options):
			bridge_success_json(cli_frontend_options_artifact_json(frontend_options))
		CliRunTest(test_plan):
			bridge_success_json(cli_test_artifact_json(test_plan))
		CliRunPurify(purify_plan):
			bridge_success_json(cli_purify_artifact_json(purify_plan))
		CliRunRepl(repl_plan):
			bridge_success_json(cli_repl_artifact_json(repl_plan))
		CliRunLsp(lsp_plan):
			bridge_success_json(cli_lsp_artifact_json(lsp_plan))
		CliRunPackage(package_plan):
			bridge_success_json(cli_package_artifact_json(package_plan))
