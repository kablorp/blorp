		BackendSelectReceivedValueBindingTemplate:
			2


pure func parse_prepared_backend_template(name: String) -> Option[PreparedBackendTemplateInfo]:
	TEMPLATES_BY_NAME.get(name)


pure func render_error_to_string(error: RenderError) -> String:
	match error:
		WrongArity(info, got):
			expected: Int = prepared_backend_template_arity(info)
			render_template_arity_error("prepared backend op", info.name, expected, got)
		UnsupportedPreparedBackendOp(name):
			render_unsupported_template_error("prepared backend op", name)


pure func wrong_arity_for_args(
	info: PreparedBackendTemplateInfo,
	args: List[String],
) -> RenderError:
	WrongArity(info, args.length())


-- Argument parsing from the OCaml bridge boundary.
private pure func parse_custom_ctor_args(args: List[String]) -> Option[CustomCtorArgs]:
	match args:
		[hash_fn, equals_fn]:
			Some({
				hash_fn = hash_fn,
				equals_fn = equals_fn,
			})
		_:
			None


