pure func render_prepared_backend(name: String, args: List[String]) -> Result[String, RenderError]:
	match parse_prepared_backend_template(name):
		Some(info):
			match build_prepared_backend_op(info, args):
				Ok(op):
					Ok(render_prepared_backend_op(op))
				Err(error):
					Err(error)
		None:
			Err(UnsupportedPreparedBackendOp(name))
