private pure func render_elem_release_arg(arg: ElemReleaseArg) -> String:
	match arg:
		NoElemRelease:
			"NULL"
		ElemReleaseFn:
			"blorp_elem_release_fn"


private pure func render_custom_ctor(
	function_name: String,
	args: CustomCtorArgs,
	elem_release: ElemReleaseArg,
) -> String:
	release_arg: String = render_elem_release_arg(elem_release)

	"${function_name}((unsigned long (*)(void*))${args.hash_fn}, " + "(bool (*)(void*, void*))${args.equals_fn}, ${release_arg})"


private pure func render_capacity_custom_ctor(
	function_name: String,
	args: CapacityCustomCtorArgs,
	elem_release: ElemReleaseArg,
) -> String:
	release_arg: String = render_elem_release_arg(elem_release)

	"${function_name}(${args.capacity}, (unsigned long (*)(void*))${args.hash_fn}, " + "(bool (*)(void*, void*))${args.equals_fn}, ${release_arg})"


private pure func c_block(body: String) -> String:
	"{ " + body + " }"


private pure func c_statement_expr(body: String) -> String:
	"(" + c_block(body) + ")"


private pure func stack_option_dict_tmp(temp_seed: String) -> String:
	"__gso_dict_${temp_seed}"


private pure func stack_option_key_tmp(temp_seed: String) -> String:
	"__gso_key_${temp_seed}"


private pure func stack_option_found_tmp(temp_seed: String) -> String:
	"__gso_found_${temp_seed}"


private pure func stack_option_raw_tmp(temp_seed: String) -> String:
	"__gso_raw_${temp_seed}"


private pure func stack_option_result_tmp(temp_seed: String) -> String:
	"__gso_result_${temp_seed}"


private pure func dict_construct_tmp(temp_seed: String) -> String:
	"__dict_${temp_seed}"


private pure func render_stack_option_none_assignment(
	result_tmp: String,
	option_c_type: String,
	none_value: String,
) -> String:
	"${result_tmp} = ((${option_c_type}){ .tag = BLORP_TAG_NONE, .value = ${none_value} });"


private pure func render_stack_option_some_assignment(
	result_tmp: String,
	option_c_type: String,
	payload_expr: String,
) -> String:
	"${result_tmp} = ((${option_c_type}){ .tag = BLORP_TAG_SOME, .value = ${payload_expr} });"


private pure func render_key_release_tail(
	policy: DictKeyReleasePolicy,
	key_tmp: String,
	result_tmp: String,
) -> String:
	match policy:
		DictKeepKey:
			"${result_tmp};"
		DictReleaseKey:
			"blorp_release(${key_tmp}); ${result_tmp};"


private pure func render_stack_option_dict_shell(
	dict: String,
	key: String,
	temp_seed: String,
	option_c_type: String,
	none_value: String,
	payload_expr: String,
	key_policy: DictKeyReleasePolicy,
) -> String:
	dict_tmp: String = stack_option_dict_tmp(temp_seed)
	key_tmp: String = stack_option_key_tmp(temp_seed)
	found_tmp: String = stack_option_found_tmp(temp_seed)
	raw_tmp: String = stack_option_raw_tmp(temp_seed)
	result_tmp: String = stack_option_result_tmp(temp_seed)
	dict_bind: String = "blorp_Dict* ${dict_tmp} = (blorp_Dict*)${dict};"
	key_bind: String = "void* ${key_tmp} = ${key};"
	raw_decl: String = "void* ${raw_tmp} = NULL;"
	found_bind: String = "bool ${found_tmp} = blorp_dict_get_raw(${dict_tmp}, ${key_tmp}, &${raw_tmp});"
	result_decl: String = "${option_c_type} ${result_tmp};"
	found_condition: String = "if (${found_tmp}) "
	some_body: String = render_stack_option_some_assignment(result_tmp, option_c_type, payload_expr)
	none_body: String = render_stack_option_none_assignment(result_tmp, option_c_type, none_value)
	tail: String = render_key_release_tail(key_policy, key_tmp, result_tmp)

	c_statement_expr(
		dict_bind + " " + key_bind + " " + raw_decl + " " + found_bind + " " + result_decl + " " + found_condition + c_block(
			some_body,
		) + " else " + c_block(none_body) + " " + tail,
	)


private pure func render_stack_option_value_record_get(
	args: StackOptionValueRecordGetArgs,
	key_policy: DictKeyReleasePolicy,
) -> String:
	raw_tmp: String = stack_option_raw_tmp(args.temp_seed)
	payload_expr: String = "blorp_unbox_struct(${raw_tmp}, ${args.payload_c_type})"
	render_stack_option_dict_shell(
		args.dict,
		args.key,
		args.temp_seed,
		args.option_c_type,
		args.none_value,
		payload_expr,
		key_policy,
	)


private pure func render_stack_option_long_get(
	args: StackOptionScalarGetArgs,
	key_policy: DictKeyReleasePolicy,
) -> String:
	raw_tmp: String = stack_option_raw_tmp(args.temp_seed)
	payload_expr: String = "(long)${raw_tmp}"
	render_stack_option_dict_shell(
		args.dict,
		args.key,
		args.temp_seed,
		args.option_c_type,
		args.none_value,
		payload_expr,
		key_policy,
	)


private pure func render_stack_option_erased_get(
	args: StackOptionScalarGetArgs,
	key_policy: DictKeyReleasePolicy,
	unbox_fn: String,
) -> String:
	raw_tmp: String = stack_option_raw_tmp(args.temp_seed)
	payload_expr: String = "${unbox_fn}(${raw_tmp})"
	render_stack_option_dict_shell(
		args.dict,
		args.key,
		args.temp_seed,
		args.option_c_type,
		args.none_value,
		payload_expr,
		key_policy,
	)


private pure func render_dict_value_release_init(temp_seed: String) -> String:
	dict_tmp: String = dict_construct_tmp(temp_seed)
	" blorp_dict_set_value_release(${dict_tmp}, blorp_elem_release_fn);"


private pure func render_dict_insert(args: DictInsertArgs) -> String:
	dict_tmp: String = dict_construct_tmp(args.temp_seed)
	" ${dict_tmp} = blorp_dict_insert(${dict_tmp}, ${args.key}, ${args.value});"


private pure func render_dict_iter_source_binding(args: DictIterSourceBindingArgs) -> String:
	"blorp_Dict* ${args.dict} = (blorp_Dict*)${args.source};"


private pure func render_dict_iter_loop_open(args: DictIterLoopOpenArgs) -> String:
	"for (long ${args.index} = 0; ${args.index} < ${args.dict}->order_len; ${args.index}++) {"


private pure func render_dict_iter_slot_binding(args: DictIterSlotBindingArgs) -> String:
	"long ${args.slot} = ${args.dict}->order[${args.index}];"


private pure func render_dict_iter_deleted_slot_guard(slot: String) -> String:
	"if (${slot} < 0) continue;"


private pure func render_dict_iter_key_binding(args: DictIterKeyBindingArgs) -> String:
	"${args.key_c_type} ${args.binding} = (${args.key_c_type})${args.dict}->keys[${args.slot}];"


private pure func render_dict_iter_pair_binding(args: DictIterPairBindingArgs) -> String:
	"blorp_Tuple* ${args.entry} = blorp_tuple_new(2, " + "${args.dict}->keys[${args.slot}], ${args.dict}->values[${args.slot}]);"


private pure func render_dict_construct_with_body(args: DictConstructWithBodyArgs) -> String:
	dict_tmp: String = dict_construct_tmp(args.temp_seed)
	c_statement_expr(
		"blorp_Dict* ${dict_tmp} = ${args.ctor};${args.release_init}${args.insert_statements} ${dict_tmp};",
	)


private pure func render_set_iter_source_binding(args: SetIterSourceBindingArgs) -> String:
	"blorp_Set* ${args.set} = (blorp_Set*)${args.source};"


private pure func render_set_iter_retain(set: String) -> String:
	"blorp_retain(${set});"


private pure func render_set_iter_loop_open(args: SetIterLoopOpenArgs) -> String:
	"for (blorp_SetEntry* ${args.entry} = ${args.set}->first; " + "${args.entry} != NULL; ${args.entry} = ${args.entry}->next_order) {"


private pure func render_set_iter_entry_key(entry: String) -> String:
	"${entry}->key"


private pure func render_set_iter_release(set: String) -> String:
	"blorp_release(${set});"


private pure func tuple_tmp(temp_seed: String) -> String:
	"__tup_" + temp_seed


private pure func render_tuple_name(temp_seed: String) -> String:
	tuple_tmp(temp_seed)


private pure func render_tuple_arg(value: String) -> String:
	", " + value


private pure func render_tuple_construct(arity: String, args: String) -> String:
	"blorp_tuple_new(" + arity + args + ")"


private pure func render_tuple_retain_elem(tuple: String, index: String) -> String:
	"if (" + tuple + "->elem[" + index + "]) blorp_retain(" + tuple + "->elem[" + index + "]);"


private pure func retain_statements_with_separator(statements: String) -> String:
	if statements == "":
		""
	else:
		statements + " "


private pure func render_tuple_construct_with_rc(args: TupleConstructWithRcArgs) -> String:
	retains: String = retain_statements_with_separator(args.retain_statements)
	"({ blorp_Tuple* " + args.tuple + " = blorp_tuple_new(" + args.arity + args.args + "); " + retains + "blorp_tuple_set_rc(" + args.tuple + ", " + args.release_mask + "UL); " + args.tuple + "; })"


private pure func render_tuple_field_element(tuple: String, field: String) -> String:
	"((blorp_Tuple*)" + tuple + ")->elem[" + field + "]"


private pure func render_tuple_field_access(args: TupleFieldAccessArgs) -> String:
	"({ void* " + args.tuple + " = (void*)" + args.source + "; " + args.read + "; })"


private pure func render_string_byte_read(source: String, index: String) -> String:
	"(long)(unsigned char)((blorp_String*)" + source + ")->data[" + index + "]"


private pure func render_string_byte_write(target: String, index: String, byte: String) -> String:
	"(((blorp_String*)" + target + ")->data[" + index + "] = (char)" + byte + ")"


private pure func render_string_find_byte_from(args: StringFindByteFromArgs) -> String:
	source_tmp: String = "__string_find_src_" + args.temp_seed
	byte_tmp: String = "__string_find_byte_" + args.temp_seed
	start_tmp: String = "__string_find_start_" + args.temp_seed
	bind_source: String = "blorp_String* " + source_tmp + " = (blorp_String*)" + args.source + ";"
	bind_byte: String = "long " + byte_tmp + " = " + args.byte + ";"
	bind_start: String = "long " + start_tmp + " = " + args.start + ";"
	call: String = "blorp_string_find_byte_from(" + source_tmp + ", " + byte_tmp + ", " + start_tmp + ");"
	body: String = bind_source + " " + bind_byte + " " + bind_start + " " + call
	"({ " + body + " })"


private pure func render_string_byte_copy(args: StringByteCopyArgs) -> String:
	dst_tmp: String = "__string_copy_dst_" + args.temp_seed
	dst_pos_tmp: String = "__string_copy_dst_pos_" + args.temp_seed
	src_tmp: String = "__string_copy_src_" + args.temp_seed
	src_pos_tmp: String = "__string_copy_src_pos_" + args.temp_seed
	len_tmp: String = "__string_copy_len_" + args.temp_seed
	bind_dst: String = "blorp_String* " + dst_tmp + " = (blorp_String*)" + args.dst + ";"
	bind_dst_pos: String = "long " + dst_pos_tmp + " = " + args.dst_pos + ";"
	bind_src: String = "blorp_String* " + src_tmp + " = (blorp_String*)" + args.src + ";"
	bind_src_pos: String = "long " + src_pos_tmp + " = " + args.src_pos + ";"
	bind_len: String = "long " + len_tmp + " = " + args.len + ";"
	copy: String = "if (" + len_tmp + " > 0) { memcpy(" + dst_tmp + "->data + " + dst_pos_tmp + ", " + src_tmp + "->data + " + src_pos_tmp + ", (size_t)" + len_tmp + "); }"
	body: String = bind_dst + " " + bind_dst_pos + " " + bind_src + " " + bind_src_pos + " " + bind_len + " " + copy + " (void)0;"
	"({ " + body + " })"


private pure func render_string_set_len(target: String, len: String) -> String:
	body: String = "blorp_String* __sl = (blorp_String*)" + target + "; long __sn = " + len + "; __sl->len = __sn; __sl->data[__sn] = '\\0'; (void)0;"
	"({ " + body + " })"


private pure func render_channel_with_elem_release(args: ChannelWithElemReleaseArgs) -> String:
	channel_tmp: String = "__ch_" + args.temp_seed
	capacity: String = args.capacity
	statements: List[String] = [
		"blorp_Channel* " + channel_tmp + " = blorp_channel_new(" + capacity + ");",
		"blorp_channel_init_elem_release(" + channel_tmp + ", blorp_elem_release_fn);",
		channel_tmp + ";",
	]

	"({ " + statements.join(" ") + " })"


private pure func channel_retaining_send_runtime_name(
	runtime: ChannelRetainingSendRuntime,
) -> String:
	match runtime:
		ChannelSendRuntime:
			"blorp_channel_send"
		ChannelTrySendRuntime:
			"blorp_channel_try_send"
		ChannelTrySendStatusRuntime:
			"blorp_channel_try_send_status"


private pure func channel_retaining_send_timeout_runtime_name(
	runtime: ChannelRetainingSendTimeoutRuntime,
) -> String:
	match runtime:
		ChannelSendTimeoutRuntime:
			"blorp_channel_send_timeout"
		ChannelSendTimeoutStatusRuntime:
			"blorp_channel_send_timeout_status"


private pure func render_channel_retaining_send_base(
	function_name: String,
	result_type: String,
	channel: String,
	value: String,
	timeout_suffix: String,
	value_seed: String,
	cleanup_seed: String,
	result_seed: String,
) -> String:
	value_tmp: String = "__chan_send_value_" + value_seed
	cleanup_tmp: String = "__chan_send_cleanup_" + cleanup_seed
	result_tmp: String = "__chan_send_result_" + result_seed
	statements: List[String] = [
		"void* " + value_tmp + " = " + value + ";",
		"blorp_CancelCleanupFrame " + cleanup_tmp + ";",
		"blorp_task_cleanup_push(&" + cleanup_tmp + ", &" + value_tmp + ", (void*)" + value_tmp + ", blorp_cleanup_release_arc_value);",
		result_type + " " + result_tmp + " = " + function_name + "(" + channel + ", " + value_tmp + timeout_suffix + ");",
		"blorp_task_cleanup_pop_slot(&" + value_tmp + ");",
		"blorp_release(" + value_tmp + ");",
		result_tmp + ";",
	]

	"({ " + statements.join(" ") + " })"


private pure func render_channel_retaining_send(
	args: ChannelRetainingSendArgs,
	runtime: ChannelRetainingSendRuntime,
) -> String:
	render_channel_retaining_send_base(
		channel_retaining_send_runtime_name(runtime),
		args.result_type,
		args.channel,
		args.value,
		"",
		args.value_seed,
		args.cleanup_seed,
		args.result_seed,
	)


private pure func render_channel_retaining_send_with_timeout(
	args: ChannelRetainingSendWithTimeoutArgs,
	runtime: ChannelRetainingSendTimeoutRuntime,
) -> String:
	render_channel_retaining_send_base(
		channel_retaining_send_timeout_runtime_name(runtime),
		args.result_type,
		args.channel,
		args.value,
		", " + args.timeout,
		args.value_seed,
		args.cleanup_seed,
		args.result_seed,
	)


private pure func channel_send_attempt_result_statements(
	result_type: String,
	status_tmp: String,
	result_tmp: String,
	constructors: ChannelSendAttemptConstructors,
) -> List[String]:
	[
		result_type + " " + result_tmp + ";",
		"if (" + status_tmp + " == BLORP_CHANNEL_SEND_ACCEPTED) { " + result_tmp + " = " + constructors.accepted + "; } else if (" + status_tmp + " == BLORP_CHANNEL_SEND_WOULD_BLOCK) { " + result_tmp + " = " + constructors.would_block + "; } else if (" + status_tmp + " == BLORP_CHANNEL_SEND_SEALED) { " + result_tmp + " = " + constructors.sealed + "; } else { " + result_tmp + " = " + constructors.timed_out + "; }",
		result_tmp + ";",
	]


private pure func render_channel_send_attempt_direct(
	result_type: String,
	status_call: String,
	status_seed: String,
	result_seed: String,
	constructors: ChannelSendAttemptConstructors,
) -> String:
	status_tmp: String = "__chan_send_status_" + status_seed
	result_tmp: String = "__chan_send_result_" + result_seed
	statements: List[String] = [
		"long " + status_tmp + " = " + status_call + ";",
	].concat(
		channel_send_attempt_result_statements(
			result_type,
			status_tmp,
			result_tmp,
			constructors,
		),
	)

	"({ " + statements.join(" ") + " })"


private pure func render_channel_send_attempt_retained_value(
	result_type: String,
	value: String,
	status_call: String,
	status_seed: String,
	result_seed: String,
	value_seed: String,
	cleanup_seed: String,
	constructors: ChannelSendAttemptConstructors,
) -> String:
	status_tmp: String = "__chan_send_status_" + status_seed
	result_tmp: String = "__chan_send_result_" + result_seed
	value_tmp: String = "__chan_send_value_" + value_seed
	cleanup_tmp: String = "__chan_send_cleanup_" + cleanup_seed
	prefix: List[String] = [
		"void* " + value_tmp + " = " + value + ";",
		"blorp_CancelCleanupFrame " + cleanup_tmp + ";",
		"blorp_task_cleanup_push(&" + cleanup_tmp + ", &" + value_tmp + ", (void*)" + value_tmp + ", blorp_cleanup_release_arc_value);",
		"long " + status_tmp + " = " + status_call + ";",
		"blorp_task_cleanup_pop_slot(&" + value_tmp + ");",
		"blorp_release(" + value_tmp + ");",
	]
	statements: List[String] = prefix.concat(
		channel_send_attempt_result_statements(
			result_type,
			status_tmp,
			result_tmp,
			constructors,
		),
	)

	"({ " + statements.join(" ") + " })"


private pure func render_channel_try_send_attempt(args: ChannelTrySendAttemptArgs) -> String:
	status_call: String = "blorp_channel_try_send_status(" + args.channel + ", " + args.value + ")"

	render_channel_send_attempt_direct(
		args.result_type,
		status_call,
		args.status_seed,
		args.result_seed,
		args.constructors,
	)


private pure func render_channel_try_send_attempt_retained_value(
	args: ChannelTrySendAttemptRetainedValueArgs,
) -> String:
	value_tmp: String = "__chan_send_value_" + args.value_seed
	status_call: String = "blorp_channel_try_send_status(" + args.channel + ", " + value_tmp + ")"

	render_channel_send_attempt_retained_value(
		args.result_type,
		args.value,
		status_call,
		args.status_seed,
		args.result_seed,
		args.value_seed,
		args.cleanup_seed,
		args.constructors,
	)


private pure func render_channel_send_timeout_attempt(
	args: ChannelSendTimeoutAttemptArgs,
) -> String:
	status_call: String = "blorp_channel_send_timeout_status(" + args.channel + ", " + args.value + ", " + args.timeout + ")"

	render_channel_send_attempt_direct(
		args.result_type,
		status_call,
		args.status_seed,
		args.result_seed,
		args.constructors,
	)


private pure func render_channel_send_timeout_attempt_retained_value(
	args: ChannelSendTimeoutAttemptRetainedValueArgs,
) -> String:
	value_tmp: String = "__chan_send_value_" + args.value_seed
	status_call: String = "blorp_channel_send_timeout_status(" + args.channel + ", " + value_tmp + ", " + args.timeout + ")"

	render_channel_send_attempt_retained_value(
		args.result_type,
		args.value,
		status_call,
		args.status_seed,
		args.result_seed,
		args.value_seed,
		args.cleanup_seed,
		args.constructors,
	)


private pure func channel_recv_attempt_result_statements(
	result_type: String,
	value_tmp: String,
	status_tmp: String,
	result_tmp: String,
	release_mask: String,
	constructors: ChannelRecvAttemptConstructors,
) -> List[String]:
	[
		result_type + " " + result_tmp + ";",
		"if (" + status_tmp + " == BLORP_CHANNEL_RECV_VALUE) { " + result_tmp + " = " + constructors.value + "(" + value_tmp + ", " + release_mask + "UL); } else if (" + status_tmp + " == BLORP_CHANNEL_RECV_SEALED) { " + result_tmp + " = " + constructors.sealed + "; } else { " + result_tmp + " = " + constructors.empty + "; }",
		result_tmp + ";",
	]


private pure func render_channel_try_recv_attempt(args: ChannelTryRecvAttemptArgs) -> String:
	value_tmp: String = "__chan_recv_value_" + args.value_seed
	status_tmp: String = "__chan_recv_status_" + args.status_seed
	result_tmp: String = "__chan_recv_result_" + args.result_seed
	statements: List[String] = [
		"void* " + value_tmp + " = NULL;",
		"long " + status_tmp + " = blorp_channel_try_recv_status_raw((blorp_Channel*)" + args.channel + ", &" + value_tmp + ");",
	].concat(
		channel_recv_attempt_result_statements(
			args.result_type,
			value_tmp,
			status_tmp,
			result_tmp,
			args.release_mask,
			args.constructors,
		),
	)

	"({ " + statements.join(" ") + " })"


private pure func render_channel_recv_timeout_attempt(
	args: ChannelRecvTimeoutAttemptArgs,
) -> String:
	value_tmp: String = "__chan_recv_value_" + args.value_seed
	status_tmp: String = "__chan_recv_status_" + args.status_seed
	result_tmp: String = "__chan_recv_result_" + args.result_seed
	statements: List[String] = [
		"void* " + value_tmp + " = NULL;",
		"long " + status_tmp + " = blorp_channel_recv_timeout_status_raw((blorp_Channel*)" + args.channel + ", " + args.timeout + ", &" + value_tmp + ");",
	].concat(
		channel_recv_attempt_result_statements(
			args.result_type,
			value_tmp,
			status_tmp,
			result_tmp,
			args.release_mask,
			args.constructors,
		),
	)

	"({ " + statements.join(" ") + " })"


private pure func render_stack_option_some_value(args: StackOptionSomeValueArgs) -> String:
	"((" + args.option_type + "){ .tag = BLORP_TAG_SOME, .value = " + args.value + " })"


private pure func render_stack_option_some_void_statement(
	args: StackOptionSomeVoidStatementArgs,
) -> String:
	"({ " + args.statement + " ((" + args.option_type + "){ .tag = BLORP_TAG_SOME, .value = 0 }); })"


private pure func render_stack_option_none(args: StackOptionNoneArgs) -> String:
	"((" + args.option_type + "){ .tag = BLORP_TAG_NONE, .value = " + args.none_value + " })"


private pure func render_stack_option_tagged_value(args: StackOptionTaggedValueArgs) -> String:
	"((" + args.option_type + "){ .tag = " + args.tag + ", .value = " + args.value + " })"


private pure func render_stack_option_tagged_void_statement(
	args: StackOptionTaggedVoidStatementArgs,
) -> String:
	"({ " + args.statement + " ((" + args.option_type + "){ .tag = " + args.tag + ", .value = 0 }); })"


private pure func render_stack_option_tagged_none(args: StackOptionTaggedNoneArgs) -> String:
	"((" + args.option_type + "){ .tag = " + args.tag + ", .value = " + args.none_value + " })"


private pure func render_stack_result_constructor(
	args: StackResultConstructorArgs,
	tag: String,
	field: String,
) -> String:
	"((" + args.result_type + "){ .tag = " + tag + ", .release_mask = " + args.release_mask + "UL, .data." + field + ".field0 = " + args.payload + " })"


private pure func render_stack_result_tagged_payload(args: StackResultTaggedPayloadArgs) -> String:
	"((" + args.result_type + "){ .tag = " + args.tag + ", .release_mask = " + args.release_mask + "UL, .data." + args.field + ".field0 = " + args.payload + " })"


pure func render_prepared_backend_op(op: PreparedBackendOp) -> String:
	match op:
		BackendDictCtorGeneric:
			"blorp_dict_new()"
		BackendDictCtorString:
			"blorp_dict_new_string()"
		BackendDictCtorFloat:
			"blorp_dict_new_float()"
		BackendDictCtorCustom(args, elem_release):
			render_custom_ctor("blorp_dict_new_custom", args, elem_release)
		BackendDictStackOptionValueRecordGet(args, key_policy):
			render_stack_option_value_record_get(args, key_policy)
		BackendDictStackOptionLongGet(args, key_policy):
			render_stack_option_long_get(args, key_policy)
		BackendDictStackOptionInt128Get(args, key_policy):
			render_stack_option_erased_get(args, key_policy, "blorp_unbox_int128")
		BackendDictStackOptionUInt128Get(args, key_policy):
			render_stack_option_erased_get(args, key_policy, "blorp_unbox_uint128")
		BackendDictConstructEmpty(ctor):
			ctor
		BackendDictValueReleaseInit(temp_seed):
			render_dict_value_release_init(temp_seed)
		BackendDictInsert(args):
			render_dict_insert(args)
		BackendDictIterSourceBinding(args):
			render_dict_iter_source_binding(args)
		BackendDictIterLoopOpen(args):
			render_dict_iter_loop_open(args)
		BackendDictIterSlotBinding(args):
			render_dict_iter_slot_binding(args)
		BackendDictIterDeletedSlotGuard(slot):
			render_dict_iter_deleted_slot_guard(slot)
		BackendDictIterKeyBinding(args):
			render_dict_iter_key_binding(args)
		BackendDictIterPairBinding(args):
			render_dict_iter_pair_binding(args)
		BackendDictConstructWithBody(args):
			render_dict_construct_with_body(args)
		BackendSetCtorGeneric:
			"blorp_set_new()"
		BackendSetCtorString:
			"blorp_set_new_string()"
		BackendSetCtorFloat:
			"blorp_set_new_float()"
		BackendSetCtorCustom(args, elem_release):
			render_custom_ctor("blorp_set_new_custom", args, elem_release)
		BackendSetIterSourceBinding(args):
			render_set_iter_source_binding(args)
		BackendSetIterRetain(set):
			render_set_iter_retain(set)
		BackendSetIterLoopOpen(args):
			render_set_iter_loop_open(args)
		BackendSetIterEntryKey(entry):
			render_set_iter_entry_key(entry)
		BackendSetIterRelease(set):
			render_set_iter_release(set)
		BackendTupleName(temp_seed):
			render_tuple_name(temp_seed)
		BackendTupleArg(value):
			render_tuple_arg(value)
		BackendTupleConstruct(arity, args):
			render_tuple_construct(arity, args)
		BackendTupleRetainElem(tuple, index):
			render_tuple_retain_elem(tuple, index)
		BackendTupleConstructWithRc(args):
			render_tuple_construct_with_rc(args)
		BackendTupleFieldElement(tuple, field):
			render_tuple_field_element(tuple, field)
		BackendTupleFieldAccess(args):
			render_tuple_field_access(args)
		BackendStringFindByteFrom(args):
			render_string_find_byte_from(args)
		BackendStringByteRead(source, index):
			render_string_byte_read(source, index)
		BackendStringByteWrite(target, index, byte):
			render_string_byte_write(target, index, byte)
		BackendStringByteCopy(args):
			render_string_byte_copy(args)
		BackendStringSetLen(target, len):
			render_string_set_len(target, len)
		BackendDictWithCapacityGeneric(capacity):
			"blorp_dict_with_capacity(${capacity})"
		BackendDictWithCapacityString(capacity):
			"blorp_dict_with_capacity_string(${capacity})"
		BackendDictWithCapacityFloat(capacity):
			"blorp_dict_with_capacity_float(${capacity})"
		BackendDictWithCapacityCustom(args, elem_release):
			render_capacity_custom_ctor("blorp_dict_with_capacity_custom", args, elem_release)
		BackendChannelWithElemRelease(args):
			render_channel_with_elem_release(args)
		BackendChannelRetainingSend(args, runtime):
			render_channel_retaining_send(args, runtime)
		BackendChannelRetainingSendWithTimeout(args, runtime):
			render_channel_retaining_send_with_timeout(args, runtime)
		BackendChannelTrySendAttempt(args):
			render_channel_try_send_attempt(args)
		BackendChannelTrySendAttemptRetainedValue(args):
			render_channel_try_send_attempt_retained_value(args)
		BackendChannelSendTimeoutAttempt(args):
			render_channel_send_timeout_attempt(args)
		BackendChannelSendTimeoutAttemptRetainedValue(args):
			render_channel_send_timeout_attempt_retained_value(args)
		BackendChannelTryRecvAttempt(args):
			render_channel_try_recv_attempt(args)
		BackendChannelRecvTimeoutAttempt(args):
			render_channel_recv_timeout_attempt(args)
		BackendStackOptionSomeValue(args):
			render_stack_option_some_value(args)
		BackendStackOptionSomeVoidStatement(args):
			render_stack_option_some_void_statement(args)
		BackendStackOptionNone(args):
			render_stack_option_none(args)
		BackendStackOptionTaggedValue(args):
			render_stack_option_tagged_value(args)
		BackendStackOptionTaggedVoidStatement(args):
			render_stack_option_tagged_void_statement(args)
		BackendStackOptionTaggedNone(args):
			render_stack_option_tagged_none(args)
		BackendStackResultOk(args):
			render_stack_result_constructor(args, "BLORP_TAG_OK", "Ok")
		BackendStackResultErr(args):
			render_stack_result_constructor(args, "BLORP_TAG_ERR", "Err")
		BackendStackResultTaggedPayload(args):
			render_stack_result_tagged_payload(args)


pure func build_prepared_backend_op(
	info: PreparedBackendTemplateInfo,
	args: List[String],
) -> Result[PreparedBackendOp, RenderError]:
	match info.template:
		BackendDictCtorGenericTemplate:
			match args:
				[]:
					Ok(BackendDictCtorGeneric)
				_:
					Err(wrong_arity_for_args(info, args))
		BackendDictCtorStringTemplate:
			match args:
				[]:
					Ok(BackendDictCtorString)
				_:
					Err(wrong_arity_for_args(info, args))
		BackendDictCtorFloatTemplate:
			match args:
				[]:
					Ok(BackendDictCtorFloat)
				_:
					Err(wrong_arity_for_args(info, args))
		BackendDictCtorCustomNoReleaseTemplate:
			parsed ?= parse_custom_ctor_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(BackendDictCtorCustom(parsed, NoElemRelease))
		BackendDictCtorCustomElemReleaseTemplate:
			parsed ?= parse_custom_ctor_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(BackendDictCtorCustom(parsed, ElemReleaseFn))
		BackendDictStackOptionGetValueRecordTemplate:
			parsed ?= parse_stack_option_value_record_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(BackendDictStackOptionValueRecordGet(parsed, DictKeepKey))
		BackendDictStackOptionGetValueRecordReleaseKeyTemplate:
			parsed ?= parse_stack_option_value_record_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(BackendDictStackOptionValueRecordGet(parsed, DictReleaseKey))
		BackendDictStackOptionGetLongTemplate:
			parsed ?= parse_stack_option_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(BackendDictStackOptionLongGet(parsed, DictKeepKey))
		BackendDictStackOptionGetLongReleaseKeyTemplate:
			parsed ?= parse_stack_option_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(BackendDictStackOptionLongGet(parsed, DictReleaseKey))
		BackendDictStackOptionGetInt128Template:
			parsed ?= parse_stack_option_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(BackendDictStackOptionInt128Get(parsed, DictKeepKey))
		BackendDictStackOptionGetInt128ReleaseKeyTemplate:
			parsed ?= parse_stack_option_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(BackendDictStackOptionInt128Get(parsed, DictReleaseKey))
		BackendDictStackOptionGetUInt128Template:
			parsed ?= parse_stack_option_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(BackendDictStackOptionUInt128Get(parsed, DictKeepKey))
		BackendDictStackOptionGetUInt128ReleaseKeyTemplate:
			parsed ?= parse_stack_option_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(BackendDictStackOptionUInt128Get(parsed, DictReleaseKey))
		BackendDictConstructEmptyTemplate:
			ctor ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(BackendDictConstructEmpty(ctor))
		BackendDictValueReleaseInitTemplate:
			temp_seed ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(BackendDictValueReleaseInit(temp_seed))
		BackendDictInsertTemplate:
			parsed ?= parse_dict_insert_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(BackendDictInsert(parsed))
		BackendDictIterSourceBindingTemplate:
			parsed ?= parse_dict_iter_source_binding_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(BackendDictIterSourceBinding(parsed))
		BackendDictIterLoopOpenTemplate:
			parsed ?= parse_dict_iter_loop_open_args(
				args,
