-- Blorp-authored library for prepared backend facade helpers.
--
-- OCaml still owns Core traversal and child expression emission. This module
-- owns final C snippet shape for backend templates that are emitted through the
-- prepared backend facade.
import:
	codegen_template_registry: render_template_arity_error, render_unsupported_template_error


enum PreparedBackendTemplate:
	BackendDictCtorGenericTemplate
	BackendDictCtorStringTemplate
	BackendDictCtorFloatTemplate
	BackendDictCtorCustomNoReleaseTemplate
	BackendDictCtorCustomElemReleaseTemplate
	BackendDictStackOptionGetValueRecordTemplate
	BackendDictStackOptionGetValueRecordReleaseKeyTemplate
	BackendDictStackOptionGetLongTemplate
	BackendDictStackOptionGetLongReleaseKeyTemplate
	BackendDictStackOptionGetInt128Template
	BackendDictStackOptionGetInt128ReleaseKeyTemplate
	BackendDictStackOptionGetUInt128Template
	BackendDictStackOptionGetUInt128ReleaseKeyTemplate
	BackendDictConstructEmptyTemplate
	BackendDictValueReleaseInitTemplate
	BackendDictInsertTemplate
	BackendDictIterSourceBindingTemplate
	BackendDictIterLoopOpenTemplate
	BackendDictIterHeaderTemplate
	BackendDictIterSlotBindingTemplate
	BackendDictIterDeletedSlotGuardTemplate
	BackendDictIterKeyBindingTemplate
	BackendDictIterPairBindingTemplate
	BackendDictConstructWithBodyTemplate
	BackendSetCtorGenericTemplate
	BackendSetCtorStringTemplate
	BackendSetCtorFloatTemplate
	BackendSetCtorCustomNoReleaseTemplate
	BackendSetCtorCustomElemReleaseTemplate
	BackendSetIterSourceBindingTemplate
	BackendSetIterRetainTemplate
	BackendSetIterLoopOpenTemplate
	BackendSetIterEntryKeyTemplate
	BackendSetIterReleaseTemplate
	BackendSetIterHeaderTemplate
	BackendStringFindByteFromTemplate
	BackendStringByteReadTemplate
	BackendStringByteWriteTemplate
	BackendStringByteCopyTemplate
	BackendStringSetLenTemplate
	BackendStringIterSourceBindingTemplate
	BackendStringIterLoopOpenTemplate
	BackendStringIterCodepointBindingTemplate
	BackendStringIterHeaderTemplate
	BackendFlatIterSourceBindingTemplate
	BackendFlatIterLengthBindingTemplate
	BackendFlatIterLoopOpenTemplate
	BackendFlatIterLoopHeaderTemplate
	BackendFlatIterRawDataBindingTemplate
	BackendFlatIterRawValueBindingTemplate
	BackendDictWithCapacityGenericTemplate
	BackendDictWithCapacityStringTemplate
	BackendDictWithCapacityFloatTemplate
	BackendDictWithCapacityCustomNoReleaseTemplate
	BackendDictWithCapacityCustomElemReleaseTemplate
	BackendChannelWithElemReleaseTemplate
	BackendChannelSendRetainingTemplate
	BackendChannelTrySendRetainingTemplate
	BackendChannelTrySendStatusRetainingTemplate
	BackendChannelSendTimeoutRetainingTemplate
	BackendChannelSendTimeoutStatusRetainingTemplate
	BackendChannelTrySendAttemptTemplate
	BackendChannelTrySendAttemptRetainedValueTemplate
	BackendChannelSendTimeoutAttemptTemplate
	BackendChannelSendTimeoutAttemptRetainedValueTemplate
	BackendChannelTryRecvAttemptKeepValueTemplate
	BackendChannelTryRecvAttemptReleaseValueTemplate
	BackendChannelRecvTimeoutAttemptKeepValueTemplate
	BackendChannelRecvTimeoutAttemptReleaseValueTemplate
	BackendChannelTryRecvAttemptNoReleaseMaskTemplate
	BackendChannelRecvTimeoutAttemptNoReleaseMaskTemplate
	BackendStackOptionSomeValueTemplate
	BackendStackOptionSomeVoidStatementTemplate
	BackendStackOptionNoneTemplate
	BackendStackOptionTaggedValueTemplate
	BackendStackOptionTaggedVoidStatementTemplate
	BackendStackOptionTaggedNoneTemplate
	BackendStackResultOkTemplate
	BackendStackResultErrTemplate
	BackendStackResultTaggedPayloadTemplate
	BackendChannelIterSourceBindingTemplate
	BackendChannelIterValueInitTemplate
	BackendChannelIterLoopOpenTemplate
	BackendChannelIterReleaseObjectTemplate
	BackendChannelIterHeaderTemplate
	BackendSelectArmsDeclTemplate
	BackendSelectRecvArmTemplate
	BackendSelectSealedArmTemplate
	BackendSelectAfterArmTemplate
	BackendSelectWaitTemplate
	BackendSelectFirstBranchOpenTemplate
	BackendSelectNextBranchOpenTemplate
	BackendSelectCleanupFrameDeclTemplate
	BackendSelectCleanupPushTemplate
	BackendSelectCleanupPopTemplate
	BackendSelectReceivedValueBindingTemplate


enum ElemReleaseArg:
	NoElemRelease
	ElemReleaseFn


enum DictKeyReleasePolicy:
	DictKeepKey
	DictReleaseKey


enum ChannelRetainingSendRuntime:
	ChannelSendRuntime
	ChannelTrySendRuntime
	ChannelTrySendStatusRuntime


enum ChannelRetainingSendTimeoutRuntime:
	ChannelSendTimeoutRuntime
	ChannelSendTimeoutStatusRuntime


enum ChannelRecvReleasePolicy:
	KeepChannelRecvValue
	ReleaseChannelRecvValue


enum SelectChannelArmKind:
	SelectRecvArmKind
	SelectSealedArmKind


-- Template metadata and typed operation model.
record PreparedBackendTemplateInfo {
	template: PreparedBackendTemplate,
	name: String
}


record CustomCtorArgs {
	hash_fn: String,
	equals_fn: String
}


record CapacityCustomCtorArgs {
	capacity: String,
	hash_fn: String,
	equals_fn: String
}


record StackOptionValueRecordGetArgs {
	dict: String,
	key: String,
	temp_seed: String,
	option_c_type: String,
	payload_c_type: String,
	none_value: String
}


record StackOptionScalarGetArgs {
	dict: String,
	key: String,
	temp_seed: String,
	option_c_type: String,
	none_value: String
}


record DictInsertArgs {
	temp_seed: String,
	key: String,
	value: String
}


record DictIterSourceBindingArgs {
	dict: String,
	source: String
}


record DictIterLoopOpenArgs {
	index: String,
	dict: String
}


record DictIterHeaderArgs {
	dict: String,
	source: String,
	index: String
}


record DictIterSlotBindingArgs {
	slot: String,
	dict: String,
	index: String
}


record DictIterKeyBindingArgs {
	key_c_type: String,
	binding: String,
	dict: String,
	slot: String
}


record DictIterPairBindingArgs {
	entry: String,
	dict: String,
	slot: String
}


record DictConstructWithBodyArgs {
	ctor: String,
	temp_seed: String,
	release_init: String,
	insert_statements: String
}


record SetIterSourceBindingArgs {
	set: String,
	source: String
}


record SetIterLoopOpenArgs {
	entry: String,
	set: String
}


record SetIterHeaderArgs {
	set: String,
	source: String,
	entry: String
}


record StringFindByteFromArgs {
	source: String,
	byte: String,
	start: String,
	temp_seed: String
}


record StringByteCopyArgs {
	dst: String,
	dst_pos: String,
	src: String,
	src_pos: String,
	len: String,
	temp_seed: String
}


record StringIterSourceBindingArgs {
	iter: String,
	source: String
}


record StringIterLoopOpenArgs {
	index: String,
	iter: String
}


record StringIterCodepointBindingArgs {
	binding: String,
	iter: String,
	index: String
}


record StringIterHeaderArgs {
	iter: String,
	source: String,
	index: String
}


record FlatIterSourceBindingArgs {
	iter_c_type: String,
	iter: String,
	source: String
}


record FlatIterLengthBindingArgs {
	length: String,
	iter: String
}


record FlatIterLoopOpenArgs {
	index: String,
	length: String
}


record FlatIterLoopHeaderArgs {
	length: String,
	iter: String,
	index: String
}


record FlatIterRawDataBindingArgs {
	pointer_c_type: String,
	raw: String,
	iter: String
}


record FlatIterRawValueBindingArgs {
	value_c_type: String,
	binding: String,
	raw: String,
	index: String
}


record ChannelWithElemReleaseArgs {
	capacity: String,
	temp_seed: String
}


record ChannelRetainingSendArgs {
	result_type: String,
	channel: String,
	value: String,
	temp_seed: String
}


record ChannelRetainingSendWithTimeoutArgs {
	result_type: String,
	channel: String,
	value: String,
	timeout: String,
	temp_seed: String
}


record ChannelSendAttemptConstructors {
	accepted: String,
	would_block: String,
	sealed: String,
	timed_out: String
}


record ChannelTrySendAttemptArgs {
	result_type: String,
	channel: String,
	value: String,
	temp_seed: String,
	constructors: ChannelSendAttemptConstructors
}


record ChannelSendTimeoutAttemptArgs {
	result_type: String,
	channel: String,
	value: String,
	timeout: String,
	temp_seed: String,
	constructors: ChannelSendAttemptConstructors
}


record ChannelRecvAttemptConstructors {
	value: String,
	sealed: String,
	empty: String
}


record ChannelTryRecvAttemptArgs {
	result_type: String,
	channel: String,
	temp_seed: String,
	release_policy: ChannelRecvReleasePolicy,
	constructors: ChannelRecvAttemptConstructors
}


record ChannelTryRecvAttemptNoReleaseMaskArgs {
	result_type: String,
	channel: String,
	temp_seed: String,
	constructors: ChannelRecvAttemptConstructors
}


record ChannelRecvTimeoutAttemptArgs {
	result_type: String,
	channel: String,
	timeout: String,
	temp_seed: String,
	release_policy: ChannelRecvReleasePolicy,
	constructors: ChannelRecvAttemptConstructors
}


record ChannelRecvTimeoutAttemptNoReleaseMaskArgs {
	result_type: String,
	channel: String,
	timeout: String,
	temp_seed: String,
	constructors: ChannelRecvAttemptConstructors
}


record StackOptionSomeValueArgs {
	option_type: String,
	value: String
}


record StackOptionSomeVoidStatementArgs {
	option_type: String,
	statement: String
}


record StackOptionNoneArgs {
	option_type: String,
	none_value: String
}


record StackOptionTaggedValueArgs {
	option_type: String,
	tag: String,
	value: String
}


record StackOptionTaggedVoidStatementArgs {
	option_type: String,
	tag: String,
	statement: String
}


record StackOptionTaggedNoneArgs {
	option_type: String,
	tag: String,
	none_value: String
}


record StackResultConstructorArgs {
	result_type: String,
	payload: String,
	release_mask: String
}


record StackResultTaggedPayloadArgs {
	result_type: String,
	tag: String,
	field: String,
	payload: String,
	release_mask: String
}


record ChannelIterSourceBindingArgs {
	channel: String,
	source: String
}


record ChannelIterLoopOpenArgs {
	channel: String,
	value: String
}


record ChannelIterHeaderArgs {
	channel: String,
	source: String,
	value: String
}


record SelectArmsDeclArgs {
	arms: String,
	arm_count: String
}


record SelectChannelArmArgs {
	arms: String,
	index: String,
	channel: String
}


record SelectAfterArmArgs {
	arms: String,
	index: String,
	timeout: String
}


record SelectWaitArgs {
	result: String,
	arms: String,
	arm_count: String
}


record SelectBranchArgs {
	result: String,
	index: String
}


record SelectCleanupPushArgs {
	cleanup_frame: String,
	value_slot: String,
	cleanup_value: String,
	release_fn: String
}


record SelectReceivedValueBindingArgs {
	binding: String,
	result: String
}


union PreparedBackendOp:
	BackendDictCtorGeneric
	BackendDictCtorString
	BackendDictCtorFloat
	BackendDictCtorCustom(CustomCtorArgs, ElemReleaseArg)
	BackendDictStackOptionValueRecordGet(StackOptionValueRecordGetArgs, DictKeyReleasePolicy)
	BackendDictStackOptionLongGet(StackOptionScalarGetArgs, DictKeyReleasePolicy)
	BackendDictStackOptionInt128Get(StackOptionScalarGetArgs, DictKeyReleasePolicy)
	BackendDictStackOptionUInt128Get(StackOptionScalarGetArgs, DictKeyReleasePolicy)
	BackendDictConstructEmpty(String)
	BackendDictValueReleaseInit(String)
	BackendDictInsert(DictInsertArgs)
	BackendDictIterSourceBinding(DictIterSourceBindingArgs)
	BackendDictIterLoopOpen(DictIterLoopOpenArgs)
	BackendDictIterHeader(DictIterHeaderArgs)
	BackendDictIterSlotBinding(DictIterSlotBindingArgs)
	BackendDictIterDeletedSlotGuard(String)
	BackendDictIterKeyBinding(DictIterKeyBindingArgs)
	BackendDictIterPairBinding(DictIterPairBindingArgs)
	BackendDictConstructWithBody(DictConstructWithBodyArgs)
	BackendSetCtorGeneric
	BackendSetCtorString
	BackendSetCtorFloat
	BackendSetCtorCustom(CustomCtorArgs, ElemReleaseArg)
	BackendSetIterSourceBinding(SetIterSourceBindingArgs)
	BackendSetIterRetain(String)
	BackendSetIterLoopOpen(SetIterLoopOpenArgs)
	BackendSetIterEntryKey(String)
	BackendSetIterRelease(String)
	BackendSetIterHeader(SetIterHeaderArgs)
	BackendStringFindByteFrom(StringFindByteFromArgs)
	BackendStringByteRead(String, String)
	BackendStringByteWrite(String, String, String)
	BackendStringByteCopy(StringByteCopyArgs)
	BackendStringSetLen(String, String)
	BackendStringIterSourceBinding(StringIterSourceBindingArgs)
	BackendStringIterLoopOpen(StringIterLoopOpenArgs)
	BackendStringIterCodepointBinding(StringIterCodepointBindingArgs)
	BackendStringIterHeader(StringIterHeaderArgs)
	BackendFlatIterSourceBinding(FlatIterSourceBindingArgs)
	BackendFlatIterLengthBinding(FlatIterLengthBindingArgs)
	BackendFlatIterLoopOpen(FlatIterLoopOpenArgs)
	BackendFlatIterLoopHeader(FlatIterLoopHeaderArgs)
	BackendFlatIterRawDataBinding(FlatIterRawDataBindingArgs)
	BackendFlatIterRawValueBinding(FlatIterRawValueBindingArgs)
	BackendDictWithCapacityGeneric(String)
	BackendDictWithCapacityString(String)
	BackendDictWithCapacityFloat(String)
	BackendDictWithCapacityCustom(CapacityCustomCtorArgs, ElemReleaseArg)
	BackendChannelWithElemRelease(ChannelWithElemReleaseArgs)
	BackendChannelRetainingSend(ChannelRetainingSendArgs, ChannelRetainingSendRuntime)
	BackendChannelRetainingSendWithTimeout(ChannelRetainingSendWithTimeoutArgs, ChannelRetainingSendTimeoutRuntime)
	BackendChannelTrySendAttempt(ChannelTrySendAttemptArgs)
	BackendChannelTrySendAttemptRetainedValue(ChannelTrySendAttemptArgs)
	BackendChannelSendTimeoutAttempt(ChannelSendTimeoutAttemptArgs)
	BackendChannelSendTimeoutAttemptRetainedValue(ChannelSendTimeoutAttemptArgs)
	BackendChannelTryRecvAttempt(ChannelTryRecvAttemptArgs)
	BackendChannelRecvTimeoutAttempt(ChannelRecvTimeoutAttemptArgs)
	BackendChannelTryRecvAttemptNoReleaseMask(ChannelTryRecvAttemptNoReleaseMaskArgs)
	BackendChannelRecvTimeoutAttemptNoReleaseMask(ChannelRecvTimeoutAttemptNoReleaseMaskArgs)
	BackendStackOptionSomeValue(StackOptionSomeValueArgs)
	BackendStackOptionSomeVoidStatement(StackOptionSomeVoidStatementArgs)
	BackendStackOptionNone(StackOptionNoneArgs)
	BackendStackOptionTaggedValue(StackOptionTaggedValueArgs)
	BackendStackOptionTaggedVoidStatement(StackOptionTaggedVoidStatementArgs)
	BackendStackOptionTaggedNone(StackOptionTaggedNoneArgs)
	BackendStackResultOk(StackResultConstructorArgs)
	BackendStackResultErr(StackResultConstructorArgs)
	BackendStackResultTaggedPayload(StackResultTaggedPayloadArgs)
	BackendChannelIterSourceBinding(ChannelIterSourceBindingArgs)
	BackendChannelIterValueInit(String)
	BackendChannelIterLoopOpen(ChannelIterLoopOpenArgs)
	BackendChannelIterReleaseObject(String)
	BackendChannelIterHeader(ChannelIterHeaderArgs)
	BackendSelectArmsDecl(SelectArmsDeclArgs)
	BackendSelectRecvArm(SelectChannelArmArgs)
	BackendSelectSealedArm(SelectChannelArmArgs)
	BackendSelectAfterArm(SelectAfterArmArgs)
	BackendSelectWait(SelectWaitArgs)
	BackendSelectFirstBranchOpen(SelectBranchArgs)
	BackendSelectNextBranchOpen(SelectBranchArgs)
	BackendSelectCleanupFrameDecl(String)
	BackendSelectCleanupPush(SelectCleanupPushArgs)
	BackendSelectCleanupPop(String)
	BackendSelectReceivedValueBinding(SelectReceivedValueBindingArgs)


union RenderError:
	WrongArity(PreparedBackendTemplateInfo, Int)
	UnsupportedPreparedBackendOp(String)


private pure func templates_by_name(
	templates: List[PreparedBackendTemplateInfo],
) -> Dict[String, PreparedBackendTemplateInfo]:
	var dict: Dict[String, PreparedBackendTemplateInfo] = {}

	for info in templates:
		dict = dict.set(info.name, info)

	dict


