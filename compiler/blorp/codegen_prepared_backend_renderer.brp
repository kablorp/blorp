pure func render_manifest_line(info: PreparedBackendTemplateInfo) -> String:
	name: String = prepared_backend_template_name(info)
	arity: Int = prepared_backend_template_arity(info)
	body: String = render_prepared_backend_op(placeholder_prepared_backend_op(info))
	"${name}\t${arity}\t${body}"


pure func render_manifest_lines() -> List[String]:
	ALL_TEMPLATES.map(render_manifest_line)
