private pure func placeholder_prepared_backend_op(
	info: PreparedBackendTemplateInfo,
) -> PreparedBackendOp:
	match info.template:
		BackendDictCtorGenericTemplate:
			BackendDictCtorGeneric
		BackendDictCtorStringTemplate:
			BackendDictCtorString
		BackendDictCtorFloatTemplate:
			BackendDictCtorFloat
		BackendDictCtorCustomNoReleaseTemplate:
			BackendDictCtorCustom(PLACEHOLDER_CUSTOM_CTOR_ARGS, NoElemRelease)
		BackendDictCtorCustomElemReleaseTemplate:
			BackendDictCtorCustom(PLACEHOLDER_CUSTOM_CTOR_ARGS, ElemReleaseFn)
		BackendDictStackOptionGetValueRecordTemplate:
			BackendDictStackOptionValueRecordGet(
				PLACEHOLDER_STACK_OPTION_VALUE_RECORD_GET_ARGS,
				DictKeepKey,
			)
		BackendDictStackOptionGetValueRecordReleaseKeyTemplate:
			BackendDictStackOptionValueRecordGet(
				PLACEHOLDER_STACK_OPTION_VALUE_RECORD_GET_ARGS,
				DictReleaseKey,
			)
		BackendDictStackOptionGetLongTemplate:
			BackendDictStackOptionLongGet(PLACEHOLDER_STACK_OPTION_SCALAR_GET_ARGS, DictKeepKey)
		BackendDictStackOptionGetLongReleaseKeyTemplate:
			BackendDictStackOptionLongGet(PLACEHOLDER_STACK_OPTION_SCALAR_GET_ARGS, DictReleaseKey)
		BackendDictStackOptionGetInt128Template:
			BackendDictStackOptionInt128Get(PLACEHOLDER_STACK_OPTION_SCALAR_GET_ARGS, DictKeepKey)
		BackendDictStackOptionGetInt128ReleaseKeyTemplate:
			BackendDictStackOptionInt128Get(
				PLACEHOLDER_STACK_OPTION_SCALAR_GET_ARGS,
				DictReleaseKey,
			)
		BackendDictStackOptionGetUInt128Template:
			BackendDictStackOptionUInt128Get(PLACEHOLDER_STACK_OPTION_SCALAR_GET_ARGS, DictKeepKey)
		BackendDictStackOptionGetUInt128ReleaseKeyTemplate:
			BackendDictStackOptionUInt128Get(
				PLACEHOLDER_STACK_OPTION_SCALAR_GET_ARGS,
				DictReleaseKey,
			)
		BackendDictConstructEmptyTemplate:
			BackendDictConstructEmpty("@0@")
		BackendDictValueReleaseInitTemplate:
			BackendDictValueReleaseInit("@0@")
		BackendDictInsertTemplate:
			BackendDictInsert(PLACEHOLDER_DICT_INSERT_ARGS)
		BackendDictIterSourceBindingTemplate:
			BackendDictIterSourceBinding(PLACEHOLDER_DICT_ITER_SOURCE_BINDING_ARGS)
		BackendDictIterLoopOpenTemplate:
			BackendDictIterLoopOpen(PLACEHOLDER_DICT_ITER_LOOP_OPEN_ARGS)
		BackendDictIterSlotBindingTemplate:
			BackendDictIterSlotBinding(PLACEHOLDER_DICT_ITER_SLOT_BINDING_ARGS)
		BackendDictIterDeletedSlotGuardTemplate:
			BackendDictIterDeletedSlotGuard("@0@")
		BackendDictIterKeyBindingTemplate:
			BackendDictIterKeyBinding(PLACEHOLDER_DICT_ITER_KEY_BINDING_ARGS)
		BackendDictIterPairBindingTemplate:
			BackendDictIterPairBinding(PLACEHOLDER_DICT_ITER_PAIR_BINDING_ARGS)
		BackendDictConstructWithBodyTemplate:
			BackendDictConstructWithBody(PLACEHOLDER_DICT_CONSTRUCT_WITH_BODY_ARGS)
		BackendSetCtorGenericTemplate:
			BackendSetCtorGeneric
		BackendSetCtorStringTemplate:
			BackendSetCtorString
		BackendSetCtorFloatTemplate:
			BackendSetCtorFloat
		BackendSetCtorCustomNoReleaseTemplate:
			BackendSetCtorCustom(PLACEHOLDER_CUSTOM_CTOR_ARGS, NoElemRelease)
		BackendSetCtorCustomElemReleaseTemplate:
