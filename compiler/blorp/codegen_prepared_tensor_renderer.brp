	tensor = "@0@",
	row = "@1@",
	col = "@2@",
	temp_seed = "@3@",
	option_c_type = "@4@",
	payload_c_type = "@5@",
	none_value = "@6@"
}

private PLACEHOLDER_STACK_OPTION_MATRIX_SCALAR_GET_ARGS: StackOptionMatrixScalarGetArgs = {
	tensor = "@0@",
	row = "@1@",
	col = "@2@",
	temp_seed = "@3@",
	option_c_type = "@4@",
	none_value = "@5@"
}

private PLACEHOLDER_RAW_SCALAR_GET_UNCHECKED_ARGS: RawScalarGetUncheckedArgs = {
	tensor = "@0@",
	index = "@1@",
	temp_seed = "@2@"
}

private PLACEHOLDER_TENSOR_ALLOC_PACKED_ARGS: TensorAllocPackedArgs = {
	size = "@0@",
	elem_size = "@1@"
}

private PLACEHOLDER_TENSOR_ALLOC_SIZED_ARGS: TensorAllocSizedArgs = {
	size = "@0@",
	struct_ty = "@1@"
}

private PLACEHOLDER_TENSOR_ALLOC_WITH_RELEASE_ARGS: TensorAllocWithReleaseArgs = {
	alloc_expr = "@0@",
	temp_seed = "@1@"
}

private PLACEHOLDER_TENSOR_FILL_INLINE_STRUCT_ARGS: TensorFillInlineStructArgs = {
	function_name = "@0@",
