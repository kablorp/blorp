-- Blorp-authored library for prepared tensor Core nodes.
--
-- OCaml still owns Core traversal, child expression emission, ABI strings, and
-- fresh temp seeds. This module owns the final C snippet shape and local
-- temp-name conventions for prepared tensor raw-view access and allocation
-- helpers.
import:
	codegen_template_registry:
		render_template_arity_error,
		render_template_manifest_line,
		render_unsupported_template_error,


enum PreparedTensorTemplate:
	TensorRawViewDeclTemplate
	TensorRawReadTemplate
	TensorRawWriteExprTemplate
	TensorRawWriteStmtTemplate
	TensorWordStorageCheckTemplate
	TensorF64StorageCheckTemplate
	TensorF32StorageCheckTemplate
	TensorI64StorageCheckTemplate
	TensorDataPointerGetUncheckedTemplate
	TensorInlineStructGetUncheckedTemplate
	TensorInlineStructGetCheckedTemplate
	TensorInlineStructMatrixGetCheckedTemplate
	TensorStackOptionVectorGetValueRecordTemplate
	TensorStackOptionVectorGetLongTemplate
	TensorStackOptionVectorGetInt128Template
	TensorStackOptionVectorGetUInt128Template
	TensorStackOptionMatrixGetValueRecordTemplate
	TensorStackOptionMatrixGetLongTemplate
	TensorStackOptionMatrixGetInt128Template
	TensorStackOptionMatrixGetUInt128Template
	TensorF64RawGetUncheckedTemplate
	TensorF32RawGetUncheckedTemplate
	TensorAllocPointerTemplate
	TensorAllocI64Template
	TensorAllocF64Template
	TensorAllocF32Template
	TensorAllocPackedTemplate
	TensorAllocSizedTemplate
	TensorAllocWithReleaseTemplate
	TensorFillInlineStructTemplate
	TensorFillBoxedTemplate
	TensorFillBoxedReleaseValueTemplate
	TensorFillDimNameTemplate
	TensorFillTotalNameTemplate
	TensorFillDimBindTemplate
	TensorFillRawScalarTemplate
	TensorFillPackedTemplate
	TensorInitElemReleaseTemplate
	TensorRankedAllocPointerTemplate
	TensorRankedAllocI64Template
	TensorRankedAllocF64Template
	TensorRankedAllocF32Template
	TensorRankedAllocPackedTemplate
	TensorRankedAllocSizedTemplate
	TensorLiteralNameTemplate
	TensorLiteralConstructTemplate
	TensorLiteralF32WriteTemplate
	TensorLiteralF64WriteTemplate
	TensorLiteralI64WriteTemplate
	TensorLiteralWordWriteTemplate
	TensorLiteralPackedWriteTemplate
	TensorLiteralInlineStructWriteTemplate
	TensorLiteralBoxedWriteTemplate
	TensorLiteralBoxedOwnedWriteTemplate
	TensorLiteralBoxedBorrowedWriteTemplate


record PreparedTensorTemplateInfo {
	template: PreparedTensorTemplate,
	name: String,
	arity: Int
}


private union StorageCheckKind:
	WordStorageKind
	F64StorageKind
	F32StorageKind
	I64StorageKind


private union RawScalarKind:
	F64RawScalarKind
	F32RawScalarKind


-- These payloads carry rendered C snippets and ABI strings. They are records
-- because Blorp structs cannot contain String fields.
record RawViewDeclArgs {
	pointer_c_type: String,
	view: String,
	source: String
}


record RawWriteArgs {
	view: String,
	index: String,
	value: String
}


record StorageCheckArgs {
	tensor: String,
	temp_seed: String
}


record TensorIndexArgs {
	tensor: String,
	index: String
}


record InlineStructGetArgs {
	tensor: String,
	index: String,
	temp_seed: String,
	struct_ty: String
}


record InlineStructMatrixGetCheckedArgs {
	tensor: String,
	row: String,
	col: String,
	temp_seed: String,
	struct_ty: String
}


record StackOptionVectorValueRecordGetArgs {
	tensor: String,
	index: String,
	temp_seed: String,
	option_c_type: String,
	payload_c_type: String,
	none_value: String
}


record StackOptionVectorScalarGetArgs {
	tensor: String,
	index: String,
	temp_seed: String,
	option_c_type: String,
	none_value: String
}


record StackOptionMatrixValueRecordGetArgs {
	tensor: String,
	row: String,
	col: String,
	temp_seed: String,
	option_c_type: String,
	payload_c_type: String,
	none_value: String
}


record StackOptionMatrixScalarGetArgs {
	tensor: String,
	row: String,
	col: String,
	temp_seed: String,
	option_c_type: String,
	none_value: String
}


record RawScalarGetUncheckedArgs {
	tensor: String,
	index: String,
	temp_seed: String
}


record TensorAllocPackedArgs {
	size: String,
	elem_size: String
}


record TensorAllocSizedArgs {
	size: String,
	struct_ty: String
}


record TensorAllocWithReleaseArgs {
	alloc_expr: String,
	temp_seed: String
}


record TensorFillInlineStructArgs {
	function_name: String,
	value: String,
	dim_args: String,
	temp_seed: String,
	struct_ty: String
}


record TensorFillBoxedArgs {
	function_name: String,
	value: String,
	dim_args: String,
	temp_seed: String
}


record TensorFillDimBindArgs {
	temp_seed: String,
	dim_index: String,
	dim_value: String
}


record TensorFillDimNameArgs {
	temp_seed: String,
	dim_index: String
}


record TensorFillRawScalarArgs {
	dim_bindings: String,
	total_expr: String,
	value_c_type: String,
	value: String,
	alloc_expr: String,
	temp_seed: String
}


record TensorFillPackedArgs {
	dim_bindings: String,
	total_expr: String,
	value: String,
	alloc_expr: String,
	temp_seed: String
}


record TensorRankedAllocArgs {
	first_dim: String,
	total_dim: String
}


record TensorRankedAllocPackedArgs {
	first_dim: String,
	total_dim: String,
	elem_size: String
}


record TensorRankedAllocSizedArgs {
	first_dim: String,
	total_dim: String,
	struct_ty: String
}


record TensorLiteralWriteArgs {
	tensor: String,
	index: String,
	value: String
}


record TensorLiteralConstructArgs {
	tensor: String,
	alloc_expr: String,
	statements: String
}


record TensorLiteralInlineStructWriteArgs {
	tensor: String,
	index: String,
	value: String,
	temp_seed: String,
	struct_ty: String
}


record TensorLiteralBoxedSeededWriteArgs {
	tensor: String,
	index: String,
	value: String,
	temp_seed: String
}


union PreparedTensorOp:
	RawViewDecl(RawViewDeclArgs)
	RawRead(String, String)
	RawWriteExpr(RawWriteArgs)
	RawWriteStmt(RawWriteArgs)
	WordStorageCheck(StorageCheckArgs)
	F64StorageCheck(StorageCheckArgs)
	F32StorageCheck(StorageCheckArgs)
	I64StorageCheck(StorageCheckArgs)
	DataPointerGetUnchecked(TensorIndexArgs)
	InlineStructGetUnchecked(InlineStructGetArgs)
	InlineStructGetChecked(InlineStructGetArgs)
	InlineStructMatrixGetChecked(InlineStructMatrixGetCheckedArgs)
	StackOptionVectorValueRecordGet(StackOptionVectorValueRecordGetArgs)
	StackOptionVectorLongGet(StackOptionVectorScalarGetArgs)
	StackOptionVectorInt128Get(StackOptionVectorScalarGetArgs)
	StackOptionVectorUInt128Get(StackOptionVectorScalarGetArgs)
	StackOptionMatrixValueRecordGet(StackOptionMatrixValueRecordGetArgs)
	StackOptionMatrixLongGet(StackOptionMatrixScalarGetArgs)
	StackOptionMatrixInt128Get(StackOptionMatrixScalarGetArgs)
	StackOptionMatrixUInt128Get(StackOptionMatrixScalarGetArgs)
	F64RawGetUnchecked(RawScalarGetUncheckedArgs)
	F32RawGetUnchecked(RawScalarGetUncheckedArgs)
	TensorAllocPointer(String)
	TensorAllocI64(String)
	TensorAllocF64(String)
	TensorAllocF32(String)
	TensorAllocPacked(TensorAllocPackedArgs)
	TensorAllocSized(TensorAllocSizedArgs)
	TensorAllocWithRelease(TensorAllocWithReleaseArgs)
	TensorFillInlineStruct(TensorFillInlineStructArgs)
	TensorFillBoxed(TensorFillBoxedArgs)
	TensorFillBoxedReleaseValue(TensorFillBoxedArgs)
	TensorFillDimName(TensorFillDimNameArgs)
	TensorFillTotalName(String)
	TensorFillDimBind(TensorFillDimBindArgs)
	TensorFillRawScalar(TensorFillRawScalarArgs)
	TensorFillPacked(TensorFillPackedArgs)
	TensorInitElemRelease(String)
	TensorRankedAllocPointer(TensorRankedAllocArgs)
	TensorRankedAllocI64(TensorRankedAllocArgs)
	TensorRankedAllocF64(TensorRankedAllocArgs)
	TensorRankedAllocF32(TensorRankedAllocArgs)
	TensorRankedAllocPacked(TensorRankedAllocPackedArgs)
	TensorRankedAllocSized(TensorRankedAllocSizedArgs)
	TensorLiteralName(String)
	TensorLiteralConstruct(TensorLiteralConstructArgs)
	TensorLiteralF32Write(TensorLiteralWriteArgs)
	TensorLiteralF64Write(TensorLiteralWriteArgs)
	TensorLiteralI64Write(TensorLiteralWriteArgs)
	TensorLiteralWordWrite(TensorLiteralWriteArgs)
	TensorLiteralPackedWrite(TensorLiteralWriteArgs)
	TensorLiteralInlineStructWrite(TensorLiteralInlineStructWriteArgs)
	TensorLiteralBoxedWrite(TensorLiteralWriteArgs)
	TensorLiteralBoxedOwnedWrite(TensorLiteralBoxedSeededWriteArgs)
	TensorLiteralBoxedBorrowedWrite(TensorLiteralBoxedSeededWriteArgs)


union RenderError:
	WrongArity(PreparedTensorTemplateInfo, Int)
	UnsupportedPreparedTensorOp(String)


private pure func templates_by_name(
	templates: List[PreparedTensorTemplateInfo],
) -> Dict[String, PreparedTensorTemplateInfo]:
	var dict: Dict[String, PreparedTensorTemplateInfo] = {}

	for info in templates:
		dict = dict.set(info.name, info)

	dict


