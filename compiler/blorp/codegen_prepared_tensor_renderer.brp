	dim_args = "@2@",
	temp_seed = "@3@",
	struct_ty = "@4@"
}

private PLACEHOLDER_TENSOR_FILL_BOXED_ARGS: TensorFillBoxedArgs = {
	function_name = "@0@",
	value = "@1@",
	dim_args = "@2@",
	temp_seed = "@3@"
}

private PLACEHOLDER_TENSOR_FILL_DIM_NAME_ARGS: TensorFillDimNameArgs = {
	temp_seed = "@0@",
	dim_index = "@1@"
}

private PLACEHOLDER_TENSOR_FILL_DIM_BIND_ARGS: TensorFillDimBindArgs = {
	temp_seed = "@0@",
