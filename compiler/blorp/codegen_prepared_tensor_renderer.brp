private pure func placeholder_prepared_tensor_op(
	info: PreparedTensorTemplateInfo,
) -> PreparedTensorOp:
	match info.template:
		TensorRawViewDeclTemplate:
			RawViewDecl(PLACEHOLDER_RAW_VIEW_DECL_ARGS)
		TensorRawReadTemplate:
			RawRead("@0@", "@1@")
		TensorRawWriteExprTemplate:
			RawWriteExpr(PLACEHOLDER_RAW_WRITE_ARGS)
		TensorRawWriteStmtTemplate:
			RawWriteStmt(PLACEHOLDER_RAW_WRITE_ARGS)
		TensorWordStorageCheckTemplate:
			WordStorageCheck(PLACEHOLDER_STORAGE_CHECK_ARGS)
		TensorF64StorageCheckTemplate:
			F64StorageCheck(PLACEHOLDER_STORAGE_CHECK_ARGS)
		TensorF32StorageCheckTemplate:
			F32StorageCheck(PLACEHOLDER_STORAGE_CHECK_ARGS)
		TensorI64StorageCheckTemplate:
			I64StorageCheck(PLACEHOLDER_STORAGE_CHECK_ARGS)
		TensorDataPointerGetUncheckedTemplate:
			DataPointerGetUnchecked(PLACEHOLDER_TENSOR_INDEX_ARGS)
		TensorInlineStructGetUncheckedTemplate:
			InlineStructGetUnchecked(PLACEHOLDER_INLINE_STRUCT_GET_ARGS)
		TensorInlineStructGetCheckedTemplate:
			InlineStructGetChecked(PLACEHOLDER_INLINE_STRUCT_GET_ARGS)
		TensorInlineStructMatrixGetCheckedTemplate:
			InlineStructMatrixGetChecked(PLACEHOLDER_INLINE_STRUCT_MATRIX_GET_CHECKED_ARGS)
		TensorStackOptionVectorGetValueRecordTemplate:
			StackOptionVectorValueRecordGet(PLACEHOLDER_STACK_OPTION_VECTOR_VALUE_RECORD_GET_ARGS)
		TensorStackOptionVectorGetLongTemplate:
			StackOptionVectorLongGet(PLACEHOLDER_STACK_OPTION_VECTOR_SCALAR_GET_ARGS)
		TensorStackOptionVectorGetInt128Template:
			StackOptionVectorInt128Get(PLACEHOLDER_STACK_OPTION_VECTOR_SCALAR_GET_ARGS)
		TensorStackOptionVectorGetUInt128Template:
			StackOptionVectorUInt128Get(PLACEHOLDER_STACK_OPTION_VECTOR_SCALAR_GET_ARGS)
		TensorStackOptionMatrixGetValueRecordTemplate:
			StackOptionMatrixValueRecordGet(PLACEHOLDER_STACK_OPTION_MATRIX_VALUE_RECORD_GET_ARGS)
		TensorStackOptionMatrixGetLongTemplate:
			StackOptionMatrixLongGet(PLACEHOLDER_STACK_OPTION_MATRIX_SCALAR_GET_ARGS)
		TensorStackOptionMatrixGetInt128Template:
			StackOptionMatrixInt128Get(PLACEHOLDER_STACK_OPTION_MATRIX_SCALAR_GET_ARGS)
		TensorStackOptionMatrixGetUInt128Template:
			StackOptionMatrixUInt128Get(PLACEHOLDER_STACK_OPTION_MATRIX_SCALAR_GET_ARGS)
		TensorF64RawGetUncheckedTemplate:
			F64RawGetUnchecked(PLACEHOLDER_RAW_SCALAR_GET_UNCHECKED_ARGS)
		TensorF32RawGetUncheckedTemplate:
			F32RawGetUnchecked(PLACEHOLDER_RAW_SCALAR_GET_UNCHECKED_ARGS)
		TensorAllocPointerTemplate:
			TensorAllocPointer("@0@")
		TensorAllocI64Template:
			TensorAllocI64("@0@")
		TensorAllocF64Template:
			TensorAllocF64("@0@")
		TensorAllocF32Template:
			TensorAllocF32("@0@")
		TensorAllocPackedTemplate:
			TensorAllocPacked(PLACEHOLDER_TENSOR_ALLOC_PACKED_ARGS)
		TensorAllocSizedTemplate:
			TensorAllocSized(PLACEHOLDER_TENSOR_ALLOC_SIZED_ARGS)
		TensorAllocWithReleaseTemplate:
			TensorAllocWithRelease(PLACEHOLDER_TENSOR_ALLOC_WITH_RELEASE_ARGS)
		TensorFillInlineStructTemplate:
			TensorFillInlineStruct(PLACEHOLDER_TENSOR_FILL_INLINE_STRUCT_ARGS)
		TensorFillBoxedTemplate:
			TensorFillBoxed(PLACEHOLDER_TENSOR_FILL_BOXED_ARGS)
		TensorFillBoxedReleaseValueTemplate:
			TensorFillBoxedReleaseValue(PLACEHOLDER_TENSOR_FILL_BOXED_ARGS)
		TensorFillDimNameTemplate:
			TensorFillDimName(PLACEHOLDER_TENSOR_FILL_DIM_NAME_ARGS)
		TensorFillTotalNameTemplate:
			TensorFillTotalName("@0@")
		TensorFillDimBindTemplate:
			TensorFillDimBind(PLACEHOLDER_TENSOR_FILL_DIM_BIND_ARGS)
		TensorFillRawScalarTemplate:
			TensorFillRawScalar(PLACEHOLDER_TENSOR_FILL_RAW_SCALAR_ARGS)
		TensorFillPackedTemplate:
			TensorFillPacked(PLACEHOLDER_TENSOR_FILL_PACKED_ARGS)
		TensorInitElemReleaseTemplate:
			TensorInitElemRelease("@0@")
		TensorRankedAllocPointerTemplate:
			TensorRankedAllocPointer(PLACEHOLDER_TENSOR_RANKED_ALLOC_ARGS)
		TensorRankedAllocI64Template:
			TensorRankedAllocI64(PLACEHOLDER_TENSOR_RANKED_ALLOC_ARGS)
		TensorRankedAllocF64Template:
			TensorRankedAllocF64(PLACEHOLDER_TENSOR_RANKED_ALLOC_ARGS)
		TensorRankedAllocF32Template:
			TensorRankedAllocF32(PLACEHOLDER_TENSOR_RANKED_ALLOC_ARGS)
		TensorRankedAllocPackedTemplate:
			TensorRankedAllocPacked(PLACEHOLDER_TENSOR_RANKED_ALLOC_PACKED_ARGS)
		TensorRankedAllocSizedTemplate:
			TensorRankedAllocSized(PLACEHOLDER_TENSOR_RANKED_ALLOC_SIZED_ARGS)
		TensorLiteralNameTemplate:
			TensorLiteralName("@0@")
		TensorLiteralConstructTemplate:
			TensorLiteralConstruct(PLACEHOLDER_TENSOR_LITERAL_CONSTRUCT_ARGS)
		TensorLiteralF32WriteTemplate:
			TensorLiteralF32Write(PLACEHOLDER_TENSOR_LITERAL_WRITE_ARGS)
		TensorLiteralF64WriteTemplate:
			TensorLiteralF64Write(PLACEHOLDER_TENSOR_LITERAL_WRITE_ARGS)
		TensorLiteralI64WriteTemplate:
			TensorLiteralI64Write(PLACEHOLDER_TENSOR_LITERAL_WRITE_ARGS)
		TensorLiteralWordWriteTemplate:
			TensorLiteralWordWrite(PLACEHOLDER_TENSOR_LITERAL_WRITE_ARGS)
		TensorLiteralPackedWriteTemplate:
			TensorLiteralPackedWrite(PLACEHOLDER_TENSOR_LITERAL_WRITE_ARGS)
		TensorLiteralInlineStructWriteTemplate:
			TensorLiteralInlineStructWrite(PLACEHOLDER_TENSOR_LITERAL_INLINE_STRUCT_WRITE_ARGS)
		TensorLiteralBoxedWriteTemplate:
			TensorLiteralBoxedWrite(PLACEHOLDER_TENSOR_LITERAL_WRITE_ARGS)
		TensorLiteralBoxedOwnedWriteTemplate:
			TensorLiteralBoxedOwnedWrite({
				tensor = "@0@",
				index = "@1@",
				value = "@2@",
				temp_seed = "@3@",
			})
		TensorLiteralBoxedBorrowedWriteTemplate:
			TensorLiteralBoxedBorrowedWrite({
				tensor = "@0@",
				index = "@1@",
				value = "@2@",
				temp_seed = "@3@",
			})


pure func render_manifest_line(info: PreparedTensorTemplateInfo) -> String:
	name: String = prepared_tensor_template_name(info)
	arity: Int = prepared_tensor_template_arity(info)
	body: String = render_prepared_tensor_op(placeholder_prepared_tensor_op(info))
	render_template_manifest_line(name, arity, body)


pure func render_manifest_lines() -> List[String]:
	ALL_TEMPLATES.map(render_manifest_line)
