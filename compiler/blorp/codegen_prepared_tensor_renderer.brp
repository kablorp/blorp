private pure func raw_scalar_c_type(kind: RawScalarKind) -> String:
	match kind:
		F64RawScalarKind:
			"double"
		F32RawScalarKind:
			"float"


private pure func raw_scalar_get_vector_tmp(temp_seed: String) -> String:
	"__tensor_raw_vec_${temp_seed}"


private pure func raw_scalar_get_index_tmp(temp_seed: String) -> String:
	"__tensor_raw_idx_${temp_seed}"


private pure func raw_scalar_get_out_tmp(temp_seed: String) -> String:
	"__tensor_raw_${temp_seed}"


private pure func render_raw_scalar_get_unchecked(
	args: RawScalarGetUncheckedArgs,
	kind: RawScalarKind,
) -> String:
	vector_tmp: String = raw_scalar_get_vector_tmp(args.temp_seed)
	index_tmp: String = raw_scalar_get_index_tmp(args.temp_seed)
	out_tmp: String = raw_scalar_get_out_tmp(args.temp_seed)
	c_type: String = raw_scalar_c_type(kind)
	vector_bind: String = "blorp_Vector* ${vector_tmp} = (blorp_Vector*)${args.tensor};"
	index_bind: String = "long ${index_tmp} = ${args.index};"
	out_decl: String = "${c_type} ${out_tmp};"
	load: String = "memcpy(&${out_tmp}, (char*)${vector_tmp}->data + ${index_tmp} * sizeof(${c_type}), sizeof(${c_type}));"

	c_statement_expr(
		vector_bind + " " + index_bind + " " + out_decl + " " + load + " " + out_tmp + ";",
	)


private pure func render_tensor_alloc_call(function_name: String, size: String) -> String:
	"${function_name}(${size})"


private pure func render_tensor_alloc_packed(args: TensorAllocPackedArgs) -> String:
	"blorp_vector_new_packed(${args.size}, ${args.elem_size})"


private pure func render_tensor_alloc_sized(args: TensorAllocSizedArgs) -> String:
	"blorp_vector_new_sized(${args.size}, sizeof(${args.struct_ty}))"


private pure func tensor_alloc_result_tmp(temp_seed: String) -> String:
	"__tensor_alloc_${temp_seed}"


private pure func render_tensor_alloc_with_release(args: TensorAllocWithReleaseArgs) -> String:
	result_tmp: String = tensor_alloc_result_tmp(args.temp_seed)
	bind_result: String = "blorp_Vector* ${result_tmp} = ${args.alloc_expr};"
	init_release: String = "blorp_vector_init_elem_release(${result_tmp}, blorp_elem_release_fn);"
	c_statement_expr(bind_result + " " + init_release + " " + result_tmp + ";")


private pure func tensor_fill_value_tmp(temp_seed: String) -> String:
	"__fill_${temp_seed}"


private pure func tensor_fill_vector_tmp(temp_seed: String) -> String:
	"__vec_${temp_seed}"


private pure func render_tensor_fill_inline_struct(args: TensorFillInlineStructArgs) -> String:
	value_tmp: String = tensor_fill_value_tmp(args.temp_seed)
	c_statement_expr(
		"${args.struct_ty} ${value_tmp} = ${args.value}; ${args.function_name}_sized(&${value_tmp}${args.dim_args}, sizeof(${args.struct_ty}));",
	)


private pure func render_tensor_fill_boxed_with_release_tail(
	args: TensorFillBoxedArgs,
	release_tail: String,
) -> String:
	value_tmp: String = tensor_fill_value_tmp(args.temp_seed)
	vector_tmp: String = tensor_fill_vector_tmp(args.temp_seed)
	c_statement_expr(
		"void* ${value_tmp} = ${args.value}; blorp_Vector* ${vector_tmp} = ${args.function_name}(${value_tmp}${args.dim_args}); blorp_vector_set_elem_release(${vector_tmp}, blorp_elem_release_fn);${release_tail} ${vector_tmp};",
	)


private pure func render_tensor_fill_boxed(args: TensorFillBoxedArgs) -> String:
	render_tensor_fill_boxed_with_release_tail(args, "")


private pure func render_tensor_fill_boxed_release_value(args: TensorFillBoxedArgs) -> String:
	value_tmp: String = tensor_fill_value_tmp(args.temp_seed)
	render_tensor_fill_boxed_with_release_tail(
		args,
		" if (${value_tmp}) blorp_release(${value_tmp});",
	)


private pure func tensor_fill_direct_dim_tmp(temp_seed: String, dim_index: String) -> String:
	"__tensor_fill_dim_${temp_seed}_${dim_index}"


private pure func tensor_fill_direct_total_tmp(temp_seed: String) -> String:
	"__tensor_fill_total_${temp_seed}"


private pure func tensor_fill_direct_value_tmp(temp_seed: String) -> String:
	"__tensor_fill_value_${temp_seed}"


private pure func tensor_fill_direct_vector_tmp(temp_seed: String) -> String:
	"__tensor_fill_vec_${temp_seed}"


private pure func tensor_fill_direct_index_tmp(temp_seed: String) -> String:
	"__tensor_fill_i_${temp_seed}"


private pure func tensor_fill_direct_raw_tmp(temp_seed: String) -> String:
	"__tensor_fill_raw_${temp_seed}"


private pure func render_tensor_fill_dim_name(args: TensorFillDimNameArgs) -> String:
	tensor_fill_direct_dim_tmp(args.temp_seed, args.dim_index)


private pure func render_tensor_fill_total_name(temp_seed: String) -> String:
	tensor_fill_direct_total_tmp(temp_seed)


private pure func render_tensor_fill_dim_bind(args: TensorFillDimBindArgs) -> String:
	dim_tmp: String = tensor_fill_direct_dim_tmp(args.temp_seed, args.dim_index)
	"long ${dim_tmp} = ${args.dim_value};"


private pure func dim_bindings_with_separator(dim_bindings: String) -> String:
	if dim_bindings == "":
		""
	else:
		dim_bindings + " "


private pure func render_tensor_fill_raw_scalar(args: TensorFillRawScalarArgs) -> String:
	total_tmp: String = tensor_fill_direct_total_tmp(args.temp_seed)
	value_tmp: String = tensor_fill_direct_value_tmp(args.temp_seed)
	vector_tmp: String = tensor_fill_direct_vector_tmp(args.temp_seed)
	index_tmp: String = tensor_fill_direct_index_tmp(args.temp_seed)
	raw_tmp: String = tensor_fill_direct_raw_tmp(args.temp_seed)
	dim_bindings: String = dim_bindings_with_separator(args.dim_bindings)

	c_statement_expr(
		dim_bindings + "long ${total_tmp} = ${args.total_expr}; " + "${args.value_c_type} ${value_tmp} = ${args.value}; " + "blorp_Vector* ${vector_tmp} = ${args.alloc_expr}; " + "${args.value_c_type}* ${raw_tmp} = (${args.value_c_type}*)${vector_tmp}->data; " + "for (long ${index_tmp} = 0; ${index_tmp} < ${vector_tmp}->capacity; ${index_tmp}++) " + "${raw_tmp}[${index_tmp}] = ${value_tmp}; ${vector_tmp};",
	)


private pure func render_tensor_fill_packed(args: TensorFillPackedArgs) -> String:
	total_tmp: String = tensor_fill_direct_total_tmp(args.temp_seed)
	value_tmp: String = tensor_fill_direct_value_tmp(args.temp_seed)
	vector_tmp: String = tensor_fill_direct_vector_tmp(args.temp_seed)
	index_tmp: String = tensor_fill_direct_index_tmp(args.temp_seed)
	dim_bindings: String = dim_bindings_with_separator(args.dim_bindings)

	c_statement_expr(
		dim_bindings + "long ${total_tmp} = ${args.total_expr}; " + "long ${value_tmp} = ${args.value}; " + "blorp_Vector* ${vector_tmp} = ${args.alloc_expr}; " + "for (long ${index_tmp} = 0; ${index_tmp} < ${vector_tmp}->capacity; ${index_tmp}++) " + "blorp_packed_set(${vector_tmp}, ${index_tmp}, ${value_tmp}); ${vector_tmp};",
	)


private pure func render_tensor_ranked_alloc(
	function_name: String,
	args: TensorRankedAllocArgs,
) -> String:
	"${function_name}(${args.first_dim}, ${args.total_dim})"


private pure func render_tensor_ranked_alloc_packed(args: TensorRankedAllocPackedArgs) -> String:
	"blorp_tensor_new_packed(${args.first_dim}, ${args.total_dim}, ${args.elem_size})"


private pure func render_tensor_ranked_alloc_sized(args: TensorRankedAllocSizedArgs) -> String:
	"blorp_tensor_new_sized(${args.first_dim}, ${args.total_dim}, sizeof(${args.struct_ty}))"


private pure func render_tensor_init_elem_release(tensor: String) -> String:
	"blorp_vector_init_elem_release(${tensor}, blorp_elem_release_fn);"


private pure func tensor_literal_tmp(temp_seed: String) -> String:
	"__ten_${temp_seed}"


private pure func render_tensor_literal_name(temp_seed: String) -> String:
	tensor_literal_tmp(temp_seed)


private pure func literal_statements_with_separator(statements: String) -> String:
	if statements == "":
		""
	else:
		statements + " "


private pure func render_tensor_literal_construct(args: TensorLiteralConstructArgs) -> String:
	statements: String = literal_statements_with_separator(args.statements)
	c_statement_expr(
		"blorp_Vector* ${args.tensor} = ${args.alloc_expr}; ${statements}${args.tensor};",
	)


private pure func render_tensor_literal_f32_write(args: TensorLiteralWriteArgs) -> String:
	"((float*)${args.tensor}->data)[${args.index}] = ${args.value};"


private pure func render_tensor_literal_f64_write(args: TensorLiteralWriteArgs) -> String:
	"blorp_vector_write_f64(${args.tensor}, ${args.index}, ${args.value});"


private pure func render_tensor_literal_i64_write(args: TensorLiteralWriteArgs) -> String:
	"((long*)${args.tensor}->data)[${args.index}] = ${args.value};"


private pure func render_tensor_literal_word_write(args: TensorLiteralWriteArgs) -> String:
	"${args.tensor}->data[${args.index}] = (void*)(intptr_t)(${args.value});"


private pure func render_tensor_literal_packed_write(args: TensorLiteralWriteArgs) -> String:
	"blorp_packed_set(${args.tensor}, ${args.index}, (long)(${args.value}));"


private pure func tensor_literal_inline_struct_elem_tmp(temp_seed: String) -> String:
	"__ten_elem_${temp_seed}"


private pure func render_tensor_literal_inline_struct_write(
	args: TensorLiteralInlineStructWriteArgs,
) -> String:
	elem_tmp: String = tensor_literal_inline_struct_elem_tmp(args.temp_seed)
	c_block(
		"${args.struct_ty} ${elem_tmp} = ${args.value}; memcpy((char*)${args.tensor}->data + ${args.index} * sizeof(${args.struct_ty}), &${elem_tmp}, sizeof(${args.struct_ty}));",
	)


private pure func render_tensor_literal_boxed_write(args: TensorLiteralWriteArgs) -> String:
	"${args.tensor}->data[${args.index}] = ${args.value};"


private pure func tensor_literal_boxed_tmp(temp_seed: String) -> String:
	"__ten_boxed_${temp_seed}"


private pure func render_tensor_literal_boxed_owned_write(
	args: TensorLiteralBoxedSeededWriteArgs,
) -> String:
	value_tmp: String = tensor_literal_boxed_tmp(args.temp_seed)
	c_block(
		"void* ${value_tmp} = ${args.value}; ${args.tensor}->data[${args.index}] = ${value_tmp};",
	)


private pure func render_tensor_literal_boxed_borrowed_write(
	args: TensorLiteralBoxedSeededWriteArgs,
) -> String:
	value_tmp: String = tensor_literal_boxed_tmp(args.temp_seed)
	c_block(
		"void* ${value_tmp} = ${args.value}; ${args.tensor}->data[${args.index}] = ${value_tmp}; if (${value_tmp}) blorp_retain(${value_tmp});",
	)


pure func render_prepared_tensor_op(op: PreparedTensorOp) -> String:
	match op:
		RawViewDecl(args):
			render_tensor_raw_view_decl(args.pointer_c_type, args.view, args.source)
		RawRead(view, index):
			render_tensor_raw_read(view, index)
		RawWriteExpr(args):
			render_tensor_raw_write_expr(args.view, args.index, args.value)
		RawWriteStmt(args):
			render_tensor_raw_write_stmt(args.view, args.index, args.value)
		WordStorageCheck(args):
			render_storage_check(args, WordStorageKind)
		F64StorageCheck(args):
			render_storage_check(args, F64StorageKind)
		F32StorageCheck(args):
			render_storage_check(args, F32StorageKind)
		I64StorageCheck(args):
			render_storage_check(args, I64StorageKind)
		DataPointerGetUnchecked(args):
			render_data_pointer_get_unchecked(args)
		InlineStructGetUnchecked(args):
			render_inline_struct_get_unchecked(args)
		InlineStructGetChecked(args):
			render_inline_struct_get_checked(args)
		InlineStructMatrixGetChecked(args):
			render_inline_struct_matrix_get_checked(args)
		StackOptionVectorValueRecordGet(args):
			render_stack_option_vector_value_record_get(args)
		StackOptionVectorLongGet(args):
			render_stack_option_vector_long_get(args)
		StackOptionVectorInt128Get(args):
			render_stack_option_vector_erased_get(args, "blorp_unbox_int128")
		StackOptionVectorUInt128Get(args):
			render_stack_option_vector_erased_get(args, "blorp_unbox_uint128")
		StackOptionMatrixValueRecordGet(args):
			render_stack_option_matrix_value_record_get(args)
		StackOptionMatrixLongGet(args):
			render_stack_option_matrix_long_get(args)
		StackOptionMatrixInt128Get(args):
			render_stack_option_matrix_erased_get(args, "blorp_unbox_int128")
		StackOptionMatrixUInt128Get(args):
			render_stack_option_matrix_erased_get(args, "blorp_unbox_uint128")
		F64RawGetUnchecked(args):
			render_raw_scalar_get_unchecked(args, F64RawScalarKind)
		F32RawGetUnchecked(args):
			render_raw_scalar_get_unchecked(args, F32RawScalarKind)
		TensorAllocPointer(size):
			render_tensor_alloc_call("blorp_vector_new", size)
		TensorAllocI64(size):
			render_tensor_alloc_call("blorp_vector_new_i64", size)
		TensorAllocF64(size):
			render_tensor_alloc_call("blorp_vector_new_f64", size)
		TensorAllocF32(size):
			render_tensor_alloc_call("blorp_vector_new_f32", size)
		TensorAllocPacked(args):
			render_tensor_alloc_packed(args)
		TensorAllocSized(args):
			render_tensor_alloc_sized(args)
		TensorAllocWithRelease(args):
			render_tensor_alloc_with_release(args)
		TensorFillInlineStruct(args):
			render_tensor_fill_inline_struct(args)
		TensorFillBoxed(args):
			render_tensor_fill_boxed(args)
		TensorFillBoxedReleaseValue(args):
			render_tensor_fill_boxed_release_value(args)
		TensorFillDimName(args):
			render_tensor_fill_dim_name(args)
		TensorFillTotalName(temp_seed):
			render_tensor_fill_total_name(temp_seed)
		TensorFillDimBind(args):
			render_tensor_fill_dim_bind(args)
		TensorFillRawScalar(args):
			render_tensor_fill_raw_scalar(args)
		TensorFillPacked(args):
			render_tensor_fill_packed(args)
		TensorInitElemRelease(tensor):
			render_tensor_init_elem_release(tensor)
		TensorRankedAllocPointer(args):
			render_tensor_ranked_alloc("blorp_tensor_new", args)
		TensorRankedAllocI64(args):
			render_tensor_ranked_alloc("blorp_tensor_new_i64", args)
		TensorRankedAllocF64(args):
			render_tensor_ranked_alloc("blorp_tensor_new_f64", args)
		TensorRankedAllocF32(args):
			render_tensor_ranked_alloc("blorp_tensor_new_f32", args)
		TensorRankedAllocPacked(args):
			render_tensor_ranked_alloc_packed(args)
		TensorRankedAllocSized(args):
			render_tensor_ranked_alloc_sized(args)
		TensorLiteralName(temp_seed):
			render_tensor_literal_name(temp_seed)
		TensorLiteralConstruct(args):
			render_tensor_literal_construct(args)
		TensorLiteralF32Write(args):
			render_tensor_literal_f32_write(args)
		TensorLiteralF64Write(args):
			render_tensor_literal_f64_write(args)
		TensorLiteralI64Write(args):
			render_tensor_literal_i64_write(args)
		TensorLiteralWordWrite(args):
			render_tensor_literal_word_write(args)
		TensorLiteralPackedWrite(args):
			render_tensor_literal_packed_write(args)
		TensorLiteralInlineStructWrite(args):
			render_tensor_literal_inline_struct_write(args)
		TensorLiteralBoxedWrite(args):
			render_tensor_literal_boxed_write(args)
		TensorLiteralBoxedOwnedWrite(args):
			render_tensor_literal_boxed_owned_write(args)
		TensorLiteralBoxedBorrowedWrite(args):
			render_tensor_literal_boxed_borrowed_write(args)


pure func build_prepared_tensor_op(
	info: PreparedTensorTemplateInfo,
	args: List[String],
) -> Result[PreparedTensorOp, RenderError]:
	match info.template:
		TensorRawViewDeclTemplate:
			parsed ?= parse_raw_view_decl_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(RawViewDecl(parsed))
		TensorRawReadTemplate:
			op ?= parse_raw_read_op(args).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		TensorRawWriteExprTemplate:
			parsed ?= parse_raw_write_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(RawWriteExpr(parsed))
		TensorRawWriteStmtTemplate:
			parsed ?= parse_raw_write_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(RawWriteStmt(parsed))
		TensorWordStorageCheckTemplate:
			parsed ?= parse_storage_check_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(WordStorageCheck(parsed))
		TensorF64StorageCheckTemplate:
			parsed ?= parse_storage_check_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(F64StorageCheck(parsed))
		TensorF32StorageCheckTemplate:
			parsed ?= parse_storage_check_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(F32StorageCheck(parsed))
		TensorI64StorageCheckTemplate:
			parsed ?= parse_storage_check_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(I64StorageCheck(parsed))
		TensorDataPointerGetUncheckedTemplate:
			parsed ?= parse_tensor_index_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(DataPointerGetUnchecked(parsed))
		TensorInlineStructGetUncheckedTemplate:
			parsed ?= parse_inline_struct_get_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructGetUnchecked(parsed))
		TensorInlineStructGetCheckedTemplate:
			parsed ?= parse_inline_struct_get_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructGetChecked(parsed))
		TensorInlineStructMatrixGetCheckedTemplate:
			parsed ?= parse_inline_struct_matrix_get_checked_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructMatrixGetChecked(parsed))
		TensorStackOptionVectorGetValueRecordTemplate:
			parsed ?= parse_stack_option_vector_value_record_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackOptionVectorValueRecordGet(parsed))
		TensorStackOptionVectorGetLongTemplate:
			parsed ?= parse_stack_option_vector_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackOptionVectorLongGet(parsed))
		TensorStackOptionVectorGetInt128Template:
			parsed ?= parse_stack_option_vector_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackOptionVectorInt128Get(parsed))
		TensorStackOptionVectorGetUInt128Template:
			parsed ?= parse_stack_option_vector_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackOptionVectorUInt128Get(parsed))
		TensorStackOptionMatrixGetValueRecordTemplate:
			parsed ?= parse_stack_option_matrix_value_record_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackOptionMatrixValueRecordGet(parsed))
		TensorStackOptionMatrixGetLongTemplate:
			parsed ?= parse_stack_option_matrix_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackOptionMatrixLongGet(parsed))
		TensorStackOptionMatrixGetInt128Template:
			parsed ?= parse_stack_option_matrix_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackOptionMatrixInt128Get(parsed))
		TensorStackOptionMatrixGetUInt128Template:
			parsed ?= parse_stack_option_matrix_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackOptionMatrixUInt128Get(parsed))
		TensorF64RawGetUncheckedTemplate:
			parsed ?= parse_raw_scalar_get_unchecked_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(F64RawGetUnchecked(parsed))
		TensorF32RawGetUncheckedTemplate:
			parsed ?= parse_raw_scalar_get_unchecked_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(F32RawGetUnchecked(parsed))
		TensorAllocPointerTemplate:
			size ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(TensorAllocPointer(size))
		TensorAllocI64Template:
			size ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(TensorAllocI64(size))
		TensorAllocF64Template:
			size ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(TensorAllocF64(size))
		TensorAllocF32Template:
			size ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(TensorAllocF32(size))
		TensorAllocPackedTemplate:
			parsed ?= parse_tensor_alloc_packed_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorAllocPacked(parsed))
		TensorAllocSizedTemplate:
			parsed ?= parse_tensor_alloc_sized_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorAllocSized(parsed))
		TensorAllocWithReleaseTemplate:
			parsed ?= parse_tensor_alloc_with_release_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorAllocWithRelease(parsed))
		TensorFillInlineStructTemplate:
			parsed ?= parse_tensor_fill_inline_struct_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorFillInlineStruct(parsed))
		TensorFillBoxedTemplate:
			parsed ?= parse_tensor_fill_boxed_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(TensorFillBoxed(parsed))
		TensorFillBoxedReleaseValueTemplate:
			parsed ?= parse_tensor_fill_boxed_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(TensorFillBoxedReleaseValue(parsed))
		TensorFillDimNameTemplate:
			parsed ?= parse_tensor_fill_dim_name_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorFillDimName(parsed))
		TensorFillTotalNameTemplate:
			temp_seed ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(TensorFillTotalName(temp_seed))
		TensorFillDimBindTemplate:
			parsed ?= parse_tensor_fill_dim_bind_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorFillDimBind(parsed))
		TensorFillRawScalarTemplate:
			parsed ?= parse_tensor_fill_raw_scalar_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorFillRawScalar(parsed))
		TensorFillPackedTemplate:
			parsed ?= parse_tensor_fill_packed_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorFillPacked(parsed))
		TensorInitElemReleaseTemplate:
			tensor ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(TensorInitElemRelease(tensor))
		TensorRankedAllocPointerTemplate:
			parsed ?= parse_tensor_ranked_alloc_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorRankedAllocPointer(parsed))
		TensorRankedAllocI64Template:
			parsed ?= parse_tensor_ranked_alloc_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorRankedAllocI64(parsed))
		TensorRankedAllocF64Template:
			parsed ?= parse_tensor_ranked_alloc_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorRankedAllocF64(parsed))
		TensorRankedAllocF32Template:
			parsed ?= parse_tensor_ranked_alloc_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorRankedAllocF32(parsed))
		TensorRankedAllocPackedTemplate:
			parsed ?= parse_tensor_ranked_alloc_packed_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorRankedAllocPacked(parsed))
		TensorRankedAllocSizedTemplate:
			parsed ?= parse_tensor_ranked_alloc_sized_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorRankedAllocSized(parsed))
		TensorLiteralNameTemplate:
			temp_seed ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralName(temp_seed))
		TensorLiteralConstructTemplate:
			parsed ?= parse_tensor_literal_construct_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralConstruct(parsed))
		TensorLiteralF32WriteTemplate:
			parsed ?= parse_tensor_literal_write_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralF32Write(parsed))
		TensorLiteralF64WriteTemplate:
			parsed ?= parse_tensor_literal_write_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralF64Write(parsed))
		TensorLiteralI64WriteTemplate:
			parsed ?= parse_tensor_literal_write_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralI64Write(parsed))
		TensorLiteralWordWriteTemplate:
			parsed ?= parse_tensor_literal_write_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralWordWrite(parsed))
		TensorLiteralPackedWriteTemplate:
			parsed ?= parse_tensor_literal_write_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralPackedWrite(parsed))
		TensorLiteralInlineStructWriteTemplate:
			parsed ?= parse_tensor_literal_inline_struct_write_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralInlineStructWrite(parsed))
		TensorLiteralBoxedWriteTemplate:
			parsed ?= parse_tensor_literal_write_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralBoxedWrite(parsed))
		TensorLiteralBoxedOwnedWriteTemplate:
			parsed ?= parse_tensor_literal_boxed_seeded_write_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralBoxedOwnedWrite(parsed))
		TensorLiteralBoxedBorrowedWriteTemplate:
			parsed ?= parse_tensor_literal_boxed_seeded_write_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralBoxedBorrowedWrite(parsed))


pure func render_prepared_tensor(name: String, args: List[String]) -> Result[String, RenderError]:
	match parse_prepared_tensor_template(name):
		Some(info):
			match build_prepared_tensor_op(info, args):
				Ok(op):
					Ok(render_prepared_tensor_op(op))
				Err(error):
					Err(error)
		None:
			Err(UnsupportedPreparedTensorOp(name))


private PLACEHOLDER_RAW_VIEW_DECL_ARGS: RawViewDeclArgs = {
	pointer_c_type = "@0@",
	view = "@1@",
	source = "@2@"
}

private PLACEHOLDER_RAW_WRITE_ARGS: RawWriteArgs = {
	view = "@0@",
	index = "@1@",
	value = "@2@"
}

private PLACEHOLDER_STORAGE_CHECK_ARGS: StorageCheckArgs = {
	tensor = "@0@",
	temp_seed = "@1@"
}

private PLACEHOLDER_TENSOR_INDEX_ARGS: TensorIndexArgs = {
	tensor = "@0@",
	index = "@1@"
}

