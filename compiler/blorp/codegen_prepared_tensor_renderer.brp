) -> Option[TensorLiteralWriteArgs]:
	match args:
		[tensor, index, value]:
			Some({
				tensor = tensor,
				index = index,
				value = value,
			})
		_: None


private pure func parse_tensor_literal_inline_struct_write_args(
	args: List[String],
) -> Option[TensorLiteralInlineStructWriteArgs]:
	match args:
		[tensor, index, value, elem_tmp, struct_ty]:
			Some({
				tensor = tensor,
				index = index,
				value = value,
				elem_tmp = elem_tmp,
				struct_ty = struct_ty,
			})
		_: None


pure func render_tensor_raw_view_decl(
	pointer_c_type: String,
	view: String,
	source: String,
) -> String:
	"${pointer_c_type} ${view} = (${pointer_c_type})((blorp_Vector*)${source})->data"


pure func render_tensor_raw_read(view: String, index: String) -> String:
	"${view}[${index}]"


pure func render_tensor_raw_write_expr(view: String, index: String, value: String) -> String:
	c_statement_expr("${view}[${index}] = ${value}; (void)0;")


pure func render_tensor_raw_write_stmt(view: String, index: String, value: String) -> String:
	"${view}[${index}] = ${value};"


private pure func storage_check_mode(kind: StorageCheckKind) -> String:
	match kind:
		WordStorageKind: "BLORP_VECTOR_STORAGE_POINTER"
		F64StorageKind: "BLORP_VECTOR_STORAGE_F64"
		F32StorageKind: "BLORP_VECTOR_STORAGE_F32"
		I64StorageKind: "BLORP_VECTOR_STORAGE_I64"


private pure func storage_check_elem_size(kind: StorageCheckKind) -> String:
	match kind:
		WordStorageKind: "sizeof(void*)"
		F64StorageKind: "sizeof(double)"
		F32StorageKind: "sizeof(float)"
		I64StorageKind: "sizeof(long)"


private pure func storage_check_extra_condition(
	kind: StorageCheckKind,
	vector_tmp: String,
) -> String:
	match kind:
		WordStorageKind: " && ${vector_tmp}->elem_release == NULL"
		F64StorageKind: ""
		F32StorageKind: ""
		I64StorageKind: ""


private pure func render_storage_check(args: StorageCheckArgs, kind: StorageCheckKind) -> String:
	vector_tmp: String = args.vector_tmp
	mode: String = storage_check_mode(kind)
	elem_size: String = storage_check_elem_size(kind)
	extra_condition: String = storage_check_extra_condition(kind, vector_tmp)
	vector_bind: String = "blorp_Vector* ${vector_tmp} = (blorp_Vector*)${args.tensor};"
	check: String = "${vector_tmp} && ${vector_tmp}->storage_mode == ${mode} && ${vector_tmp}->elem_size == (int16_t)${elem_size}${extra_condition};"

	c_statement_expr(vector_bind + " " + check)


private pure func render_data_pointer_get_unchecked(args: TensorIndexArgs) -> String:
	"((blorp_Vector*)${args.tensor})->data[${args.index}]"


private pure func render_inline_struct_get_unchecked(args: InlineStructGetUncheckedArgs) -> String:
	vector_tmp: String = args.vector_tmp
	index_tmp: String = args.index_tmp
	out_tmp: String = args.out_tmp
	raw_tmp: String = args.raw_tmp
	struct_ty: String = args.struct_ty
	vector_bind: String = "blorp_Vector* ${vector_tmp} = (blorp_Vector*)${args.tensor};"
	index_bind: String = "long ${index_tmp} = ${args.index};"
	out_decl: String = "${struct_ty} ${out_tmp};"
	inline_condition: String = "if (__builtin_expect(${vector_tmp}->storage_mode == BLORP_VECTOR_STORAGE_INLINE && ${vector_tmp}->elem_size == sizeof(${struct_ty}), 1)) "
	inline_copy: String = "memcpy(&${out_tmp}, (char*)${vector_tmp}->data + ${index_tmp} * sizeof(${struct_ty}), sizeof(${struct_ty}));"
	fallback_get: String = "void* ${raw_tmp} = ${vector_tmp}->data[${index_tmp}];"
	fallback_unbox: String = "${out_tmp} = blorp_unbox_struct(${raw_tmp}, ${struct_ty});"
	inline_branch: String = c_block(inline_copy)
	fallback_branch: String = c_block(fallback_get + " " + fallback_unbox)

	c_statement_expr(
		vector_bind + " " + index_bind + " " + out_decl + " " + inline_condition + inline_branch + " else " + fallback_branch + " " + out_tmp + ";",
	)


private pure func raw_scalar_c_type(kind: RawScalarKind) -> String:
	match kind:
		F64RawScalarKind: "double"
		F32RawScalarKind: "float"


private pure func render_raw_scalar_get_unchecked(
	args: RawScalarGetUncheckedArgs,
	kind: RawScalarKind,
) -> String:
	vector_tmp: String = args.vector_tmp
	index_tmp: String = args.index_tmp
	out_tmp: String = args.out_tmp
	c_type: String = raw_scalar_c_type(kind)
	vector_bind: String = "blorp_Vector* ${vector_tmp} = (blorp_Vector*)${args.tensor};"
	index_bind: String = "long ${index_tmp} = ${args.index};"
	out_decl: String = "${c_type} ${out_tmp};"
	load: String = "memcpy(&${out_tmp}, (char*)${vector_tmp}->data + ${index_tmp} * sizeof(${c_type}), sizeof(${c_type}));"

	c_statement_expr(
		vector_bind + " " + index_bind + " " + out_decl + " " + load + " " + out_tmp + ";",
	)


private pure func render_tensor_alloc_call(function_name: String, size: String) -> String:
	"${function_name}(${size})"


private pure func render_tensor_alloc_packed(args: TensorAllocPackedArgs) -> String:
	"blorp_vector_new_packed(${args.size}, ${args.elem_size})"


private pure func render_tensor_alloc_sized(args: TensorAllocSizedArgs) -> String:
	"blorp_vector_new_sized(${args.size}, sizeof(${args.struct_ty}))"


private pure func render_tensor_alloc_with_release(args: TensorAllocWithReleaseArgs) -> String:
	result_tmp: String = args.result_tmp
	bind_result: String = "blorp_Vector* ${result_tmp} = ${args.alloc_expr};"
	init_release: String = "blorp_vector_init_elem_release(${result_tmp}, blorp_elem_release_fn);"
	c_statement_expr(bind_result + " " + init_release + " " + result_tmp + ";")


private pure func render_tensor_ranked_alloc(
	function_name: String,
	args: TensorRankedAllocArgs,
) -> String:
	"${function_name}(${args.first_dim}, ${args.total_dim})"


private pure func render_tensor_ranked_alloc_packed(args: TensorRankedAllocPackedArgs) -> String:
	"blorp_tensor_new_packed(${args.first_dim}, ${args.total_dim}, ${args.elem_size})"


private pure func render_tensor_ranked_alloc_sized(args: TensorRankedAllocSizedArgs) -> String:
	"blorp_tensor_new_sized(${args.first_dim}, ${args.total_dim}, sizeof(${args.struct_ty}))"


private pure func render_tensor_init_elem_release(tensor: String) -> String:
	"blorp_vector_init_elem_release(${tensor}, blorp_elem_release_fn);"


private pure func render_tensor_literal_f32_write(args: TensorLiteralWriteArgs) -> String:
	"((float*)${args.tensor}->data)[${args.index}] = ${args.value};"


private pure func render_tensor_literal_f64_write(args: TensorLiteralWriteArgs) -> String:
	"blorp_vector_write_f64(${args.tensor}, ${args.index}, ${args.value});"


private pure func render_tensor_literal_i64_write(args: TensorLiteralWriteArgs) -> String:
	"((long*)${args.tensor}->data)[${args.index}] = ${args.value};"


private pure func render_tensor_literal_word_write(args: TensorLiteralWriteArgs) -> String:
	"${args.tensor}->data[${args.index}] = (void*)(intptr_t)(${args.value});"


private pure func render_tensor_literal_packed_write(args: TensorLiteralWriteArgs) -> String:
	"blorp_packed_set(${args.tensor}, ${args.index}, (long)(${args.value}));"


private pure func render_tensor_literal_inline_struct_write(
	args: TensorLiteralInlineStructWriteArgs,
) -> String:
	c_block(
		"${args.struct_ty} ${args.elem_tmp} = ${args.value}; memcpy((char*)${args.tensor}->data + ${args.index} * sizeof(${args.struct_ty}), &${args.elem_tmp}, sizeof(${args.struct_ty}));",
	)


private pure func render_tensor_literal_boxed_write(args: TensorLiteralWriteArgs) -> String:
	"${args.tensor}->data[${args.index}] = ${args.value};"


private pure func render_tensor_literal_boxed_retain(value: String) -> String:
	"if (${value}) blorp_retain(${value});"


pure func render_prepared_tensor_op(op: PreparedTensorOp) -> String:
	match op:
		RawViewDecl(args):
			render_tensor_raw_view_decl(args.pointer_c_type, args.view, args.source)
		RawRead(view, index): render_tensor_raw_read(view, index)
		RawWriteExpr(args): render_tensor_raw_write_expr(args.view, args.index, args.value)
		RawWriteStmt(args): render_tensor_raw_write_stmt(args.view, args.index, args.value)
		WordStorageCheck(args): render_storage_check(args, WordStorageKind)
		F64StorageCheck(args): render_storage_check(args, F64StorageKind)
		F32StorageCheck(args): render_storage_check(args, F32StorageKind)
		I64StorageCheck(args): render_storage_check(args, I64StorageKind)
		DataPointerGetUnchecked(args): render_data_pointer_get_unchecked(args)
		InlineStructGetUnchecked(args): render_inline_struct_get_unchecked(args)
		F64RawGetUnchecked(args): render_raw_scalar_get_unchecked(args, F64RawScalarKind)
		F32RawGetUnchecked(args): render_raw_scalar_get_unchecked(args, F32RawScalarKind)
		TensorAllocPointer(size): render_tensor_alloc_call("blorp_vector_new", size)
		TensorAllocI64(size): render_tensor_alloc_call("blorp_vector_new_i64", size)
		TensorAllocF64(size): render_tensor_alloc_call("blorp_vector_new_f64", size)
		TensorAllocF32(size): render_tensor_alloc_call("blorp_vector_new_f32", size)
		TensorAllocPacked(args): render_tensor_alloc_packed(args)
		TensorAllocSized(args): render_tensor_alloc_sized(args)
		TensorAllocWithRelease(args): render_tensor_alloc_with_release(args)
		TensorInitElemRelease(tensor): render_tensor_init_elem_release(tensor)
		TensorRankedAllocPointer(args): render_tensor_ranked_alloc("blorp_tensor_new", args)
		TensorRankedAllocI64(args): render_tensor_ranked_alloc("blorp_tensor_new_i64", args)
		TensorRankedAllocF64(args): render_tensor_ranked_alloc("blorp_tensor_new_f64", args)
		TensorRankedAllocF32(args): render_tensor_ranked_alloc("blorp_tensor_new_f32", args)
		TensorRankedAllocPacked(args): render_tensor_ranked_alloc_packed(args)
		TensorRankedAllocSized(args): render_tensor_ranked_alloc_sized(args)
		TensorLiteralF32Write(args): render_tensor_literal_f32_write(args)
		TensorLiteralF64Write(args): render_tensor_literal_f64_write(args)
		TensorLiteralI64Write(args): render_tensor_literal_i64_write(args)
		TensorLiteralWordWrite(args): render_tensor_literal_word_write(args)
		TensorLiteralPackedWrite(args): render_tensor_literal_packed_write(args)
		TensorLiteralInlineStructWrite(args): render_tensor_literal_inline_struct_write(args)
		TensorLiteralBoxedWrite(args): render_tensor_literal_boxed_write(args)
		TensorLiteralBoxedRetain(value): render_tensor_literal_boxed_retain(value)


pure func build_prepared_tensor_op(
	info: PreparedTensorTemplateInfo,
	args: List[String],
) -> Result[PreparedTensorOp, RenderError]:
	match info.template:
		TensorRawViewDeclTemplate:
			parsed ?= parse_raw_view_decl_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(RawViewDecl(parsed))
		TensorRawReadTemplate:
			op ?= parse_raw_read_op(args).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		TensorRawWriteExprTemplate:
			parsed ?= parse_raw_write_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(RawWriteExpr(parsed))
		TensorRawWriteStmtTemplate:
			parsed ?= parse_raw_write_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(RawWriteStmt(parsed))
		TensorWordStorageCheckTemplate:
			parsed ?= parse_storage_check_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(WordStorageCheck(parsed))
		TensorF64StorageCheckTemplate:
			parsed ?= parse_storage_check_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(F64StorageCheck(parsed))
		TensorF32StorageCheckTemplate:
			parsed ?= parse_storage_check_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(F32StorageCheck(parsed))
		TensorI64StorageCheckTemplate:
			parsed ?= parse_storage_check_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(I64StorageCheck(parsed))
		TensorDataPointerGetUncheckedTemplate:
			parsed ?= parse_tensor_index_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(DataPointerGetUnchecked(parsed))
		TensorInlineStructGetUncheckedTemplate:
			parsed ?= parse_inline_struct_get_unchecked_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructGetUnchecked(parsed))
		TensorF64RawGetUncheckedTemplate:
			parsed ?= parse_raw_scalar_get_unchecked_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(F64RawGetUnchecked(parsed))
		TensorF32RawGetUncheckedTemplate:
			parsed ?= parse_raw_scalar_get_unchecked_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(F32RawGetUnchecked(parsed))
		TensorAllocPointerTemplate:
			size ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(TensorAllocPointer(size))
		TensorAllocI64Template:
			size ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(TensorAllocI64(size))
		TensorAllocF64Template:
			size ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(TensorAllocF64(size))
		TensorAllocF32Template:
			size ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(TensorAllocF32(size))
		TensorAllocPackedTemplate:
			parsed ?= parse_tensor_alloc_packed_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorAllocPacked(parsed))
		TensorAllocSizedTemplate:
			parsed ?= parse_tensor_alloc_sized_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorAllocSized(parsed))
		TensorAllocWithReleaseTemplate:
			parsed ?= parse_tensor_alloc_with_release_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorAllocWithRelease(parsed))
		TensorInitElemReleaseTemplate:
			tensor ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(TensorInitElemRelease(tensor))
		TensorRankedAllocPointerTemplate:
			parsed ?= parse_tensor_ranked_alloc_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorRankedAllocPointer(parsed))
		TensorRankedAllocI64Template:
			parsed ?= parse_tensor_ranked_alloc_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorRankedAllocI64(parsed))
		TensorRankedAllocF64Template:
			parsed ?= parse_tensor_ranked_alloc_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorRankedAllocF64(parsed))
		TensorRankedAllocF32Template:
			parsed ?= parse_tensor_ranked_alloc_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorRankedAllocF32(parsed))
		TensorRankedAllocPackedTemplate:
			parsed ?= parse_tensor_ranked_alloc_packed_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorRankedAllocPacked(parsed))
		TensorRankedAllocSizedTemplate:
			parsed ?= parse_tensor_ranked_alloc_sized_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorRankedAllocSized(parsed))
		TensorLiteralF32WriteTemplate:
			parsed ?= parse_tensor_literal_write_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralF32Write(parsed))
		TensorLiteralF64WriteTemplate:
			parsed ?= parse_tensor_literal_write_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralF64Write(parsed))
		TensorLiteralI64WriteTemplate:
			parsed ?= parse_tensor_literal_write_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralI64Write(parsed))
		TensorLiteralWordWriteTemplate:
			parsed ?= parse_tensor_literal_write_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralWordWrite(parsed))
		TensorLiteralPackedWriteTemplate:
			parsed ?= parse_tensor_literal_write_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralPackedWrite(parsed))
		TensorLiteralInlineStructWriteTemplate:
			parsed ?= parse_tensor_literal_inline_struct_write_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralInlineStructWrite(parsed))
		TensorLiteralBoxedWriteTemplate:
			parsed ?= parse_tensor_literal_write_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralBoxedWrite(parsed))
		TensorLiteralBoxedRetainTemplate:
			value ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(TensorLiteralBoxedRetain(value))


pure func render_prepared_tensor(name: String, args: List[String]) -> Result[String, RenderError]:
	match parse_prepared_tensor_template(name):
		Some(info):
			match build_prepared_tensor_op(info, args):
				Ok(op): Ok(render_prepared_tensor_op(op))
				Err(error): Err(error)
		None: Err(UnsupportedPreparedTensorOp(name))


private PLACEHOLDER_RAW_VIEW_DECL_ARGS: RawViewDeclArgs = {
	pointer_c_type = "@0@",
	view = "@1@",
	source = "@2@"
}

private PLACEHOLDER_RAW_WRITE_ARGS: RawWriteArgs = {
	view = "@0@",
	index = "@1@",
	value = "@2@"
}

private PLACEHOLDER_STORAGE_CHECK_ARGS: StorageCheckArgs = {
	tensor = "@0@",
	vector_tmp = "@1@"
}

private PLACEHOLDER_TENSOR_INDEX_ARGS: TensorIndexArgs = {
	tensor = "@0@",
	index = "@1@"
}

private PLACEHOLDER_INLINE_STRUCT_GET_UNCHECKED_ARGS: InlineStructGetUncheckedArgs = {
	tensor = "@0@",
	index = "@1@",
	vector_tmp = "@2@",
	index_tmp = "@3@",
	out_tmp = "@4@",
	raw_tmp = "@5@",
	struct_ty = "@6@"
}

private PLACEHOLDER_RAW_SCALAR_GET_UNCHECKED_ARGS: RawScalarGetUncheckedArgs = {
	tensor = "@0@",
	index = "@1@",
	vector_tmp = "@2@",
	index_tmp = "@3@",
	out_tmp = "@4@"
}

private PLACEHOLDER_TENSOR_ALLOC_PACKED_ARGS: TensorAllocPackedArgs = {
	size = "@0@",
	elem_size = "@1@"
}

private PLACEHOLDER_TENSOR_ALLOC_SIZED_ARGS: TensorAllocSizedArgs = {
	size = "@0@",
	struct_ty = "@1@"
}

private PLACEHOLDER_TENSOR_ALLOC_WITH_RELEASE_ARGS: TensorAllocWithReleaseArgs = {
	alloc_expr = "@0@",
	result_tmp = "@1@"
}

private PLACEHOLDER_TENSOR_RANKED_ALLOC_ARGS: TensorRankedAllocArgs = {
	first_dim = "@0@",
	total_dim = "@1@"
}

private PLACEHOLDER_TENSOR_RANKED_ALLOC_PACKED_ARGS: TensorRankedAllocPackedArgs = {
	first_dim = "@0@",
	total_dim = "@1@",
	elem_size = "@2@"
}

private PLACEHOLDER_TENSOR_RANKED_ALLOC_SIZED_ARGS: TensorRankedAllocSizedArgs = {
	first_dim = "@0@",
	total_dim = "@1@",
	struct_ty = "@2@"
}

private PLACEHOLDER_TENSOR_LITERAL_WRITE_ARGS: TensorLiteralWriteArgs = {
	tensor = "@0@",
	index = "@1@",
	value = "@2@"
}

private PLACEHOLDER_TENSOR_LITERAL_INLINE_STRUCT_WRITE_ARGS: TensorLiteralInlineStructWriteArgs = {
	tensor = "@0@",
	index = "@1@",
	value = "@2@",
	elem_tmp = "@3@",
	struct_ty = "@4@"
}


private pure func placeholder_prepared_tensor_op(
	info: PreparedTensorTemplateInfo,
) -> PreparedTensorOp:
	match info.template:
		TensorRawViewDeclTemplate: RawViewDecl(PLACEHOLDER_RAW_VIEW_DECL_ARGS)
		TensorRawReadTemplate: RawRead("@0@", "@1@")
		TensorRawWriteExprTemplate: RawWriteExpr(PLACEHOLDER_RAW_WRITE_ARGS)
		TensorRawWriteStmtTemplate: RawWriteStmt(PLACEHOLDER_RAW_WRITE_ARGS)
		TensorWordStorageCheckTemplate: WordStorageCheck(PLACEHOLDER_STORAGE_CHECK_ARGS)
		TensorF64StorageCheckTemplate: F64StorageCheck(PLACEHOLDER_STORAGE_CHECK_ARGS)
		TensorF32StorageCheckTemplate: F32StorageCheck(PLACEHOLDER_STORAGE_CHECK_ARGS)
		TensorI64StorageCheckTemplate: I64StorageCheck(PLACEHOLDER_STORAGE_CHECK_ARGS)
		TensorDataPointerGetUncheckedTemplate:
			DataPointerGetUnchecked(PLACEHOLDER_TENSOR_INDEX_ARGS)
		TensorInlineStructGetUncheckedTemplate:
			InlineStructGetUnchecked(PLACEHOLDER_INLINE_STRUCT_GET_UNCHECKED_ARGS)
		TensorF64RawGetUncheckedTemplate:
			F64RawGetUnchecked(PLACEHOLDER_RAW_SCALAR_GET_UNCHECKED_ARGS)
		TensorF32RawGetUncheckedTemplate:
			F32RawGetUnchecked(PLACEHOLDER_RAW_SCALAR_GET_UNCHECKED_ARGS)
		TensorAllocPointerTemplate: TensorAllocPointer("@0@")
		TensorAllocI64Template: TensorAllocI64("@0@")
		TensorAllocF64Template: TensorAllocF64("@0@")
		TensorAllocF32Template: TensorAllocF32("@0@")
		TensorAllocPackedTemplate: TensorAllocPacked(PLACEHOLDER_TENSOR_ALLOC_PACKED_ARGS)
		TensorAllocSizedTemplate: TensorAllocSized(PLACEHOLDER_TENSOR_ALLOC_SIZED_ARGS)
		TensorAllocWithReleaseTemplate:
			TensorAllocWithRelease(PLACEHOLDER_TENSOR_ALLOC_WITH_RELEASE_ARGS)
		TensorInitElemReleaseTemplate: TensorInitElemRelease("@0@")
		TensorRankedAllocPointerTemplate:
			TensorRankedAllocPointer(PLACEHOLDER_TENSOR_RANKED_ALLOC_ARGS)
		TensorRankedAllocI64Template: TensorRankedAllocI64(PLACEHOLDER_TENSOR_RANKED_ALLOC_ARGS)
		TensorRankedAllocF64Template: TensorRankedAllocF64(PLACEHOLDER_TENSOR_RANKED_ALLOC_ARGS)
		TensorRankedAllocF32Template: TensorRankedAllocF32(PLACEHOLDER_TENSOR_RANKED_ALLOC_ARGS)
		TensorRankedAllocPackedTemplate:
			TensorRankedAllocPacked(PLACEHOLDER_TENSOR_RANKED_ALLOC_PACKED_ARGS)
		TensorRankedAllocSizedTemplate:
			TensorRankedAllocSized(PLACEHOLDER_TENSOR_RANKED_ALLOC_SIZED_ARGS)
		TensorLiteralF32WriteTemplate: TensorLiteralF32Write(PLACEHOLDER_TENSOR_LITERAL_WRITE_ARGS)
		TensorLiteralF64WriteTemplate: TensorLiteralF64Write(PLACEHOLDER_TENSOR_LITERAL_WRITE_ARGS)
		TensorLiteralI64WriteTemplate: TensorLiteralI64Write(PLACEHOLDER_TENSOR_LITERAL_WRITE_ARGS)
		TensorLiteralWordWriteTemplate: TensorLiteralWordWrite(
			PLACEHOLDER_TENSOR_LITERAL_WRITE_ARGS,
		)
		TensorLiteralPackedWriteTemplate:
			TensorLiteralPackedWrite(PLACEHOLDER_TENSOR_LITERAL_WRITE_ARGS)
		TensorLiteralInlineStructWriteTemplate:
			TensorLiteralInlineStructWrite(PLACEHOLDER_TENSOR_LITERAL_INLINE_STRUCT_WRITE_ARGS)
		TensorLiteralBoxedWriteTemplate:
			TensorLiteralBoxedWrite(PLACEHOLDER_TENSOR_LITERAL_WRITE_ARGS)
		TensorLiteralBoxedRetainTemplate: TensorLiteralBoxedRetain("@0@")


pure func render_manifest_line(info: PreparedTensorTemplateInfo) -> String:
	name: String = prepared_tensor_template_name(info)
	arity: Int = prepared_tensor_template_arity(info)
	body: String = render_prepared_tensor_op(placeholder_prepared_tensor_op(info))
	"${name}\t${arity}\t${body}"


pure func render_manifest_lines() -> List[String]:
	ALL_TEMPLATES.map(render_manifest_line)


func print_manifest() -> Void:
	for line in render_manifest_lines():
		print(line)


func print_result(result: Result[String, RenderError]) -> Int:
	match result:
		Ok(rendered):
			puts(rendered)
			0
		Err(error):
			print(render_error_to_string(error))
			1


func main(args: List[String]) -> Int:
	match args:
		[program_name, command_name, ...command_args]:
			match parse_command(command_name):
				RenderPreparedTensorCommand:
					match command_args:
						[name, ...rendered_args]: print_result(
							render_prepared_tensor(
								name,
								rendered_args,
							),
						)
						[]:
							print(USAGE)
							1
				RenderManifestCommand:
					print_manifest()
					0
				UnknownCommand:
					print(USAGE)
					1
		[]:
			print(USAGE)
			1
		[program_name]:
			print(USAGE)
			1
