-- Blorp-authored renderer for prepared tensor Core nodes.
--
-- OCaml still owns Core traversal, child expression emission, ABI strings, and
-- variable naming. This module owns only the final C snippet shape for prepared
-- tensor raw-view access.
enum CompilerCommand:
	RenderPreparedTensorCommand
	RenderManifestCommand
	UnknownCommand


enum PreparedTensorTemplate:
	TensorRawViewDeclTemplate
	TensorRawReadTemplate
	TensorRawWriteExprTemplate
	TensorRawWriteStmtTemplate
	TensorWordStorageCheckTemplate
	TensorF64StorageCheckTemplate
	TensorF32StorageCheckTemplate
	TensorI64StorageCheckTemplate
	TensorDataPointerGetUncheckedTemplate
	TensorInlineStructGetUncheckedTemplate
	TensorF64RawGetUncheckedTemplate
	TensorF32RawGetUncheckedTemplate


record PreparedTensorTemplateInfo {
	template: PreparedTensorTemplate,
	name: String,
	arity: Int
}


private union StorageCheckKind:
	WordStorageKind
	F64StorageKind
	F32StorageKind
	I64StorageKind


private union RawScalarKind:
	F64RawScalarKind
	F32RawScalarKind


-- These payloads carry rendered C snippets and ABI strings. They are records
-- because Blorp structs cannot contain String fields.
record RawViewDeclArgs {
	pointer_c_type: String,
	view: String,
	source: String
}


record RawWriteArgs {
	view: String,
	index: String,
	value: String
}


record StorageCheckArgs {
	tensor: String,
	vector_tmp: String
}


record TensorIndexArgs {
	tensor: String,
	index: String
}


record InlineStructGetUncheckedArgs {
	tensor: String,
	index: String,
	vector_tmp: String,
	index_tmp: String,
	out_tmp: String,
	raw_tmp: String,
	struct_ty: String
}


record RawScalarGetUncheckedArgs {
	tensor: String,
	index: String,
	vector_tmp: String,
	index_tmp: String,
	out_tmp: String
}


union PreparedTensorOp:
	RawViewDecl(RawViewDeclArgs)
	RawRead(String, String)
	RawWriteExpr(RawWriteArgs)
	RawWriteStmt(RawWriteArgs)
	WordStorageCheck(StorageCheckArgs)
	F64StorageCheck(StorageCheckArgs)
	F32StorageCheck(StorageCheckArgs)
	I64StorageCheck(StorageCheckArgs)
	DataPointerGetUnchecked(TensorIndexArgs)
	InlineStructGetUnchecked(InlineStructGetUncheckedArgs)
	F64RawGetUnchecked(RawScalarGetUncheckedArgs)
	F32RawGetUnchecked(RawScalarGetUncheckedArgs)


union RenderError:
	WrongArity(PreparedTensorTemplateInfo, Int)
	UnsupportedPreparedTensorOp(String)


ALL_TEMPLATES: List[PreparedTensorTemplateInfo] = [{
		template = TensorRawViewDeclTemplate,
		name = "tensor_raw_view_decl",
		arity = 3
	}, {
		template = TensorRawReadTemplate,
		name = "tensor_raw_read",
		arity = 2
	}, {
		template = TensorRawWriteExprTemplate,
		name = "tensor_raw_write_expr",
		arity = 3
	}, {
		template = TensorRawWriteStmtTemplate,
		name = "tensor_raw_write_stmt",
		arity = 3
	}, {
		template = TensorWordStorageCheckTemplate,
		name = "tensor_is_word_storage",
		arity = 2
	}, {
		template = TensorF64StorageCheckTemplate,
		name = "tensor_is_f64_storage",
		arity = 2
	}, {
		template = TensorF32StorageCheckTemplate,
		name = "tensor_is_f32_storage",
		arity = 2
	}, {
		template = TensorI64StorageCheckTemplate,
		name = "tensor_is_i64_storage",
		arity = 2
	}, {
		template = TensorDataPointerGetUncheckedTemplate,
		name = "tensor_data_pointer_get_unchecked",
		arity = 2
	}, {
		template = TensorInlineStructGetUncheckedTemplate,
		name = "tensor_inline_struct_get_unchecked",
		arity = 7
	}, {
		template = TensorF64RawGetUncheckedTemplate,
		name = "tensor_get_f64_raw_unchecked",
		arity = 5
	}, {
		template = TensorF32RawGetUncheckedTemplate,
		name = "tensor_get_f32_raw_unchecked",
		arity = 5
	}]

USAGE: String = (
	"Usage: codegen_prepared_tensor_renderer prepared-tensor <name> [rendered-arg..."
	+ "] | manifest"
)

private OPEN_BRACE: String = "{"

private CLOSE_BRACE: String = "}"


private pure func c_block(body: String) -> String:
	OPEN_BRACE + " " + body + " " + CLOSE_BRACE


private pure func c_statement_expr(body: String) -> String:
	"(" + c_block(body) + ")"


pure func parse_command(command: String) -> CompilerCommand:
	match command:
		"prepared-tensor": RenderPreparedTensorCommand
		"manifest": RenderManifestCommand
		_: UnknownCommand


pure func prepared_tensor_template_name(info: PreparedTensorTemplateInfo) -> String:
	info.name


pure func prepared_tensor_template_arity(info: PreparedTensorTemplateInfo) -> Int:
	info.arity


pure func parse_prepared_tensor_template(name: String) -> Option[PreparedTensorTemplateInfo]:
	var found: Option[PreparedTensorTemplateInfo] = None

	for info in ALL_TEMPLATES:
		if found.is_none() and info.name == name:
			found = Some(info)

	found


pure func render_error_to_string(error: RenderError) -> String:
	match error:
		WrongArity(info, got):
			"prepared tensor op ${info.name} expected ${info.arity} arg(s), got ${got}"
		UnsupportedPreparedTensorOp(name): "unsupported prepared tensor op: ${name}"


pure func wrong_arity_for_args(info: PreparedTensorTemplateInfo, args: List[String]) -> RenderError:
	WrongArity(info, args.length())


private pure func parse_raw_view_decl_args(args: List[String]) -> Option[RawViewDeclArgs]:
	match args:
		[pointer_c_type, view, source]:
			Some({
				pointer_c_type = pointer_c_type,
				view = view,
				source = source,
			})
		_: None


private pure func parse_raw_read_op(args: List[String]) -> Option[PreparedTensorOp]:
	match args:
		[view, index]: Some(RawRead(view, index))
		_: None


private pure func parse_raw_write_args(args: List[String]) -> Option[RawWriteArgs]:
	match args:
		[view, index, value]:
			Some({
				view = view,
				index = index,
				value = value,
			})
		_: None


private pure func parse_storage_check_args(args: List[String]) -> Option[StorageCheckArgs]:
	match args:
		[tensor, vector_tmp]:
			Some({
				tensor = tensor,
				vector_tmp = vector_tmp,
			})
		_: None


private pure func parse_tensor_index_args(args: List[String]) -> Option[TensorIndexArgs]:
	match args:
		[tensor, index]:
			Some({
				tensor = tensor,
				index = index,
			})
		_: None


private pure func parse_inline_struct_get_unchecked_args(
	args: List[String],
) -> Option[InlineStructGetUncheckedArgs]:
	match args:
		[tensor, index, vector_tmp, index_tmp, out_tmp, raw_tmp, struct_ty]:
			Some({
				tensor = tensor,
				index = index,
				vector_tmp = vector_tmp,
				index_tmp = index_tmp,
				out_tmp = out_tmp,
				raw_tmp = raw_tmp,
				struct_ty = struct_ty,
			})
		_: None


private pure func parse_raw_scalar_get_unchecked_args(
	args: List[String],
) -> Option[RawScalarGetUncheckedArgs]:
	match args:
		[tensor, index, vector_tmp, index_tmp, out_tmp]:
			Some({
				tensor = tensor,
				index = index,
				vector_tmp = vector_tmp,
				index_tmp = index_tmp,
				out_tmp = out_tmp,
			})
		_: None


pure func render_tensor_raw_view_decl(
	pointer_c_type: String,
	view: String,
	source: String,
) -> String:
	"${pointer_c_type} ${view} = (${pointer_c_type})((blorp_Vector*)${source})->data"


pure func render_tensor_raw_read(view: String, index: String) -> String:
	"${view}[${index}]"


pure func render_tensor_raw_write_expr(view: String, index: String, value: String) -> String:
	c_statement_expr("${view}[${index}] = ${value}; (void)0;")


pure func render_tensor_raw_write_stmt(view: String, index: String, value: String) -> String:
	"${view}[${index}] = ${value};"


private pure func storage_check_mode(kind: StorageCheckKind) -> String:
	match kind:
		WordStorageKind: "BLORP_VECTOR_STORAGE_POINTER"
		F64StorageKind: "BLORP_VECTOR_STORAGE_F64"
		F32StorageKind: "BLORP_VECTOR_STORAGE_F32"
		I64StorageKind: "BLORP_VECTOR_STORAGE_I64"


private pure func storage_check_elem_size(kind: StorageCheckKind) -> String:
	match kind:
		WordStorageKind: "sizeof(void*)"
		F64StorageKind: "sizeof(double)"
		F32StorageKind: "sizeof(float)"
		I64StorageKind: "sizeof(long)"


private pure func storage_check_extra_condition(
	kind: StorageCheckKind,
	vector_tmp: String,
) -> String:
	match kind:
		WordStorageKind: " && ${vector_tmp}->elem_release == NULL"
		F64StorageKind: ""
		F32StorageKind: ""
		I64StorageKind: ""


private pure func render_storage_check(args: StorageCheckArgs, kind: StorageCheckKind) -> String:
	vector_tmp: String = args.vector_tmp
	mode: String = storage_check_mode(kind)
	elem_size: String = storage_check_elem_size(kind)
	extra_condition: String = storage_check_extra_condition(kind, vector_tmp)
	vector_bind: String = "blorp_Vector* ${vector_tmp} = (blorp_Vector*)${args.tensor};"
	check: String = "${vector_tmp} && ${vector_tmp}->storage_mode == ${mode} && ${vector_tmp}->elem_size == (int16_t)${elem_size}${extra_condition};"

	c_statement_expr(vector_bind + " " + check)


private pure func render_data_pointer_get_unchecked(args: TensorIndexArgs) -> String:
	"((blorp_Vector*)${args.tensor})->data[${args.index}]"


private pure func render_inline_struct_get_unchecked(args: InlineStructGetUncheckedArgs) -> String:
	vector_tmp: String = args.vector_tmp
	index_tmp: String = args.index_tmp
	out_tmp: String = args.out_tmp
	raw_tmp: String = args.raw_tmp
	struct_ty: String = args.struct_ty
	vector_bind: String = "blorp_Vector* ${vector_tmp} = (blorp_Vector*)${args.tensor};"
	index_bind: String = "long ${index_tmp} = ${args.index};"
	out_decl: String = "${struct_ty} ${out_tmp};"
	inline_condition: String = "if (__builtin_expect(${vector_tmp}->storage_mode == BLORP_VECTOR_STORAGE_INLINE && ${vector_tmp}->elem_size == sizeof(${struct_ty}), 1)) "
	inline_copy: String = "memcpy(&${out_tmp}, (char*)${vector_tmp}->data + ${index_tmp} * sizeof(${struct_ty}), sizeof(${struct_ty}));"
	fallback_get: String = "void* ${raw_tmp} = ${vector_tmp}->data[${index_tmp}];"
	fallback_unbox: String = "${out_tmp} = blorp_unbox_struct(${raw_tmp}, ${struct_ty});"
	inline_branch: String = c_block(inline_copy)
	fallback_branch: String = c_block(fallback_get + " " + fallback_unbox)

	c_statement_expr(
		vector_bind + " " + index_bind + " " + out_decl + " " + inline_condition + inline_branch + " else " + fallback_branch + " " + out_tmp + ";",
	)


private pure func raw_scalar_c_type(kind: RawScalarKind) -> String:
	match kind:
		F64RawScalarKind: "double"
		F32RawScalarKind: "float"


private pure func render_raw_scalar_get_unchecked(
	args: RawScalarGetUncheckedArgs,
	kind: RawScalarKind,
) -> String:
	vector_tmp: String = args.vector_tmp
	index_tmp: String = args.index_tmp
	out_tmp: String = args.out_tmp
	c_type: String = raw_scalar_c_type(kind)
	vector_bind: String = "blorp_Vector* ${vector_tmp} = (blorp_Vector*)${args.tensor};"
	index_bind: String = "long ${index_tmp} = ${args.index};"
	out_decl: String = "${c_type} ${out_tmp};"
	load: String = "memcpy(&${out_tmp}, (char*)${vector_tmp}->data + ${index_tmp} * sizeof(${c_type}), sizeof(${c_type}));"

	c_statement_expr(
		vector_bind + " " + index_bind + " " + out_decl + " " + load + " " + out_tmp + ";",
	)


pure func render_prepared_tensor_op(op: PreparedTensorOp) -> String:
	match op:
		RawViewDecl(args):
			render_tensor_raw_view_decl(args.pointer_c_type, args.view, args.source)
		RawRead(view, index): render_tensor_raw_read(view, index)
		RawWriteExpr(args): render_tensor_raw_write_expr(args.view, args.index, args.value)
		RawWriteStmt(args): render_tensor_raw_write_stmt(args.view, args.index, args.value)
		WordStorageCheck(args): render_storage_check(args, WordStorageKind)
		F64StorageCheck(args): render_storage_check(args, F64StorageKind)
		F32StorageCheck(args): render_storage_check(args, F32StorageKind)
		I64StorageCheck(args): render_storage_check(args, I64StorageKind)
		DataPointerGetUnchecked(args): render_data_pointer_get_unchecked(args)
		InlineStructGetUnchecked(args): render_inline_struct_get_unchecked(args)
		F64RawGetUnchecked(args): render_raw_scalar_get_unchecked(args, F64RawScalarKind)
		F32RawGetUnchecked(args): render_raw_scalar_get_unchecked(args, F32RawScalarKind)


pure func build_prepared_tensor_op(
	info: PreparedTensorTemplateInfo,
	args: List[String],
) -> Result[PreparedTensorOp, RenderError]:
	match info.template:
		TensorRawViewDeclTemplate:
			parsed ?= parse_raw_view_decl_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(RawViewDecl(parsed))
		TensorRawReadTemplate:
			op ?= parse_raw_read_op(args).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		TensorRawWriteExprTemplate:
			parsed ?= parse_raw_write_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(RawWriteExpr(parsed))
		TensorRawWriteStmtTemplate:
			parsed ?= parse_raw_write_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(RawWriteStmt(parsed))
		TensorWordStorageCheckTemplate:
			parsed ?= parse_storage_check_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(WordStorageCheck(parsed))
		TensorF64StorageCheckTemplate:
			parsed ?= parse_storage_check_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(F64StorageCheck(parsed))
		TensorF32StorageCheckTemplate:
			parsed ?= parse_storage_check_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(F32StorageCheck(parsed))
		TensorI64StorageCheckTemplate:
			parsed ?= parse_storage_check_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(I64StorageCheck(parsed))
		TensorDataPointerGetUncheckedTemplate:
			parsed ?= parse_tensor_index_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(DataPointerGetUnchecked(parsed))
		TensorInlineStructGetUncheckedTemplate:
			parsed ?= parse_inline_struct_get_unchecked_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(InlineStructGetUnchecked(parsed))
		TensorF64RawGetUncheckedTemplate:
			parsed ?= parse_raw_scalar_get_unchecked_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(F64RawGetUnchecked(parsed))
		TensorF32RawGetUncheckedTemplate:
			parsed ?= parse_raw_scalar_get_unchecked_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(F32RawGetUnchecked(parsed))


pure func render_prepared_tensor(name: String, args: List[String]) -> Result[String, RenderError]:
	match parse_prepared_tensor_template(name):
		Some(info):
			match build_prepared_tensor_op(info, args):
				Ok(op): Ok(render_prepared_tensor_op(op))
				Err(error): Err(error)
		None: Err(UnsupportedPreparedTensorOp(name))


private pure func placeholder_raw_view_decl_args() -> RawViewDeclArgs:
	{
		pointer_c_type = "@0@",
		view = "@1@",
		source = "@2@"
	}


private pure func placeholder_raw_write_args() -> RawWriteArgs:
	{
		view = "@0@",
		index = "@1@",
		value = "@2@"
	}


private pure func placeholder_storage_check_args() -> StorageCheckArgs:
	{
		tensor = "@0@",
		vector_tmp = "@1@"
	}


private pure func placeholder_tensor_index_args() -> TensorIndexArgs:
	{
		tensor = "@0@",
		index = "@1@"
	}


private pure func placeholder_inline_struct_get_unchecked_args() -> InlineStructGetUncheckedArgs:
	{
		tensor = "@0@",
		index = "@1@",
		vector_tmp = "@2@",
		index_tmp = "@3@",
		out_tmp = "@4@",
		raw_tmp = "@5@",
		struct_ty = "@6@"
	}


private pure func placeholder_raw_scalar_get_unchecked_args() -> RawScalarGetUncheckedArgs:
	{
		tensor = "@0@",
		index = "@1@",
		vector_tmp = "@2@",
		index_tmp = "@3@",
		out_tmp = "@4@"
	}


private pure func placeholder_prepared_tensor_op(
	info: PreparedTensorTemplateInfo,
) -> PreparedTensorOp:
	match info.template:
		TensorRawViewDeclTemplate: RawViewDecl(placeholder_raw_view_decl_args())
		TensorRawReadTemplate: RawRead("@0@", "@1@")
		TensorRawWriteExprTemplate: RawWriteExpr(placeholder_raw_write_args())
		TensorRawWriteStmtTemplate: RawWriteStmt(placeholder_raw_write_args())
		TensorWordStorageCheckTemplate: WordStorageCheck(placeholder_storage_check_args())
		TensorF64StorageCheckTemplate: F64StorageCheck(placeholder_storage_check_args())
		TensorF32StorageCheckTemplate: F32StorageCheck(placeholder_storage_check_args())
		TensorI64StorageCheckTemplate: I64StorageCheck(placeholder_storage_check_args())
		TensorDataPointerGetUncheckedTemplate:
			DataPointerGetUnchecked(placeholder_tensor_index_args())
		TensorInlineStructGetUncheckedTemplate:
			InlineStructGetUnchecked(placeholder_inline_struct_get_unchecked_args())
		TensorF64RawGetUncheckedTemplate:
			F64RawGetUnchecked(placeholder_raw_scalar_get_unchecked_args())
		TensorF32RawGetUncheckedTemplate:
			F32RawGetUnchecked(placeholder_raw_scalar_get_unchecked_args())


pure func render_manifest_line(info: PreparedTensorTemplateInfo) -> String:
	name: String = prepared_tensor_template_name(info)
	arity: Int = prepared_tensor_template_arity(info)
	body: String = render_prepared_tensor_op(placeholder_prepared_tensor_op(info))
	"${name}\t${arity}\t${body}"


pure func render_manifest_lines() -> List[String]:
	ALL_TEMPLATES.map(render_manifest_line)


func print_manifest() -> Void:
	for line in render_manifest_lines():
		print(line)


func print_result(result: Result[String, RenderError]) -> Int:
	match result:
		Ok(rendered):
			puts(rendered)
			0
		Err(error):
			print(render_error_to_string(error))
			1


func main(args: List[String]) -> Int:
	match args:
		[program_name, command_name, ...command_args]:
			match parse_command(command_name):
				RenderPreparedTensorCommand:
					match command_args:
						[name, ...rendered_args]: print_result(
							render_prepared_tensor(
								name,
								rendered_args,
							),
						)
						[]:
							print(USAGE)
							1
				RenderManifestCommand:
					print_manifest()
					0
				UnknownCommand:
					print(USAGE)
					1
		[]:
			print(USAGE)
			1
		[program_name]:
			print(USAGE)
			1
