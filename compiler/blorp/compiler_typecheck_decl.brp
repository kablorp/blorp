-- First-pass declaration helpers for Blorp-owned typechecking.
--
-- This module owns AST walking. The state module stays a plain value model.
import:
	compiler_env:
		CompilerEnv,
		CompilerFieldDecl,
		CompilerFuncOrigin(CompilerForeignFunc, CompilerUserDefinedFunc),
		CompilerImplInstance,
		CompilerPurity(CompilerImpure, CompilerPure),
		CompilerResourceArgPolicy(CompilerAllowResourceArgs, CompilerRejectResourceArgs),
		CompilerResourceResultPolicy(CompilerResourceResultDependent, CompilerResourceResultOrdinary),
		CompilerTraitMethodSig,
		CompilerTypeKind(
			CompilerTypeBuiltin,
			CompilerTypeEnum,
			CompilerTypeResource,
			CompilerTypeUnion,
		),
		CompilerVarMutability(CompilerImmutableBinding, CompilerMutableBinding),
		CompilerVarOrigin(CompilerFuncParam, CompilerLetBinding),
		CompilerVariantDef,
		compiler_env_add_alias,
		compiler_env_add_func_with_info,
		compiler_env_add_impl,
		compiler_env_add_opaque_alias,
		compiler_env_add_record,
		compiler_env_add_trait,
		compiler_env_add_trait_function,
		compiler_env_add_type,
		compiler_env_add_var_with_details,
		compiler_env_find_conflicting_impl,
		compiler_env_get_function_trait,
		compiler_env_get_trait,
		compiler_env_mint_def_id,
		compiler_env_push_scope,
		compiler_env_set_type_param_bounds,
		compiler_env_trait_function_collision,
		compiler_env_trait_methods_with_declaring_trait,
		compiler_func_symbol,
		compiler_impl_instance,
		compiler_trait_def_with_details,
		compiler_trait_method_sig_with_details,
	compiler_infer:
		CompilerExpectedValueSlotContext(CompilerExpectedArgumentSlot),
		CompilerInferContext,
		CompilerInferResult,
		compiler_infer_context,
		compiler_infer_expr,
		compiler_infer_with_expected_value_slot,
		compiler_infer_without_expected,
		compiler_typed_expr_debug_block_impure_call_names,
		compiler_typed_expr_has_non_tail_recursive_call,
		compiler_typed_expr_has_debug_block_assignment,
		compiler_typed_expr_has_startup_subscript,
		compiler_typed_expr_impure_call_names,
		compiler_typed_expr_module_assign_names,
		compiler_typed_expr_pure_lambda_impure_call_names,
		compiler_typed_expr_semantic_type,
		compiler_typed_expr_startup_call_names,
		compiler_typed_expr_value_type,
	compiler_parsed_ast:
		ParsedBuiltinTypeDecl,
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			ImportBlockParsedDecl,
			ParsedErrorDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedDimConstraint,
		ParsedFieldDecl,
		ParsedForeignFunctionDecl,
		ParsedFunctionAnnotation(
			ParsedDebugOnlyAnnotation,
			ParsedResourceResultOrdinaryAnnotation,
			ParsedTailRecursiveAnnotation,
		),
		ParsedFunctionDecl,
		ParsedImplDecl,
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder, ParsedParamTupleBinder, ParsedParamWildcardBinder),
		ParsedProgram,
		ParsedExpr(ParsedBuiltinExpr),
		ParsedRecordDecl,
		ParsedTraitDecl,
		ParsedTraitMethodDecl,
		ParsedTypeAliasDecl,
		ParsedTypeExpr,
		ParsedTypeParamDecl,
		ParsedUnionDecl,
		ParsedVarDecl,
		ParsedVariantDecl,
	compiler_refinement: compiler_unrefined_binding
	compiler_source: CompilerSourceSpan
	compiler_type:
		CompilerType(
			CompilerArrayType,
			CompilerDimOpType,
			CompilerFunctionType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerTupleType,
