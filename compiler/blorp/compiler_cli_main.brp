import:
	compiler_cli: run_cli
	compiler_cli_artifact_json: cli_run_plan_to_json
	compiler_cli_plan:
		CliRunPlan(
			CliRunDelegate,
			CliRunFrontendModuleGraph,
			CliRunHandled,
			CliRunLsp,
			CliRunPackage,
			CliRunPurify,
			CliRunRepl,
			CliRunTest,
		),
	io: print_error
	process: run_inherit
	system: getenv, mkstemp_path, remove_file, write_file


private OCAML_HOST_ENV: String = "BLORP_OCAML_HOST_BIN"

private DEFAULT_OCAML_HOST: String = "./blorp-ocaml-host"

private HOST_EXECUTE_CLI_PLAN_COMMAND: String = "__compiler-run-cli-plan"


private func ocaml_host_path() -> String:
	match getenv(OCAML_HOST_ENV):
		Some(path):
			if path.length() > 0:
				path
			else:
				DEFAULT_OCAML_HOST
		None:
			DEFAULT_OCAML_HOST


private pure func is_internal_compiler_command(args: List[String]) -> Bool:
	match args.get(0):
		Some(command):
			match command:
				"__compiler-bridge":
					True
				"__compiler-bridge-prepare":
					True
				"__compiler-host-compile-wrapper":
					True
				"__compiler-run-cli-plan":
					True
				_:
					False
		None:
			False


private func run_ocaml_host(host_args: List[String]) -> Int:
	match run_inherit(ocaml_host_path(), host_args):
		Ok(status):
			status
		Err(message):
			print_error("Error: cannot run OCaml compiler host: " + message)
			1


private func write_cli_plan_file(plan: CliRunPlan) -> Result[String, String]:
	path ?= mkstemp_path("blorp_cli_plan_")

	match write_file(path, cli_run_plan_to_json(plan).to_string()):
		Ok(_):
			Ok(path)
		Err(message):
			Err(message)


private func run_ocaml_host_with_plan(plan: CliRunPlan) -> Int:
	match write_cli_plan_file(plan):
		Ok(path):
			status: Int = run_ocaml_host([HOST_EXECUTE_CLI_PLAN_COMMAND, path])
			_ = remove_file(path)
			status
		Err(message):
			print_error("Error: cannot write CLI plan: " + message)
			1


private func execute_cli_plan(plan: CliRunPlan) -> Int:
	match plan:
		CliRunDelegate(delegation):
			run_ocaml_host(delegation.args)
		CliRunHandled(result):
			run_ocaml_host_with_plan(CliRunHandled(result))
		CliRunFrontendModuleGraph(graph):
			run_ocaml_host_with_plan(CliRunFrontendModuleGraph(graph))
		CliRunTest(test_plan):
			run_ocaml_host_with_plan(CliRunTest(test_plan))
		CliRunPurify(purify_plan):
			run_ocaml_host_with_plan(CliRunPurify(purify_plan))
		CliRunRepl(repl_plan):
			run_ocaml_host_with_plan(CliRunRepl(repl_plan))
		CliRunLsp(lsp_plan):
			run_ocaml_host_with_plan(CliRunLsp(lsp_plan))
		CliRunPackage(package_plan):
			run_ocaml_host_with_plan(CliRunPackage(package_plan))


func main(args: List[String]) -> Int:
	host_args: List[String] = args.drop(1)

	if is_internal_compiler_command(host_args):
		run_ocaml_host(host_args)
	else:
		execute_cli_plan(run_cli(host_args))
