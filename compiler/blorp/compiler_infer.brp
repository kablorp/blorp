-- Starter expression inference substrate for the Blorp-owned typecheck pass.
--
-- This file intentionally begins with the low-level bidirectional inference
-- machinery and the first expression forms. Later checkpoint-6 slices should
-- extend this module or split call/resource/concurrency helpers out of it while
-- preserving the typed expression metadata boundary defined here.
import:
	compiler_env:
		CompilerEnv,
		CompilerFieldDecl,
		CompilerFuncSymbol,
		CompilerOverloadEntry,
		CompilerPurity,
		CompilerSymbolKind(
			CompilerAliasSymbolKind,
			CompilerConstructorSymbolKind,
			CompilerFuncSymbolKind,
			CompilerOpaqueAliasSymbolKind,
			CompilerRecordSymbolKind,
			CompilerTypeSymbolKind,
			CompilerVarSymbolKind,
		),
		CompilerSymbolLookup,
		CompilerVarMutability(CompilerImmutableBinding, CompilerMutableBinding),
		CompilerVarOrigin(CompilerForLoopVar, CompilerFuncParam, CompilerLetBinding, CompilerMatchBinding),
		compiler_env_add_var_with_details,
		compiler_env_find_records_with_fields,
		compiler_env_get_module_func_symbol,
		compiler_env_get_overloads,
		compiler_env_get_record,
		compiler_env_lookup,
		compiler_env_lookup_is_outermost_scope,
		compiler_env_lookup_with_scope_depth,
		compiler_env_lookup_in_current_scope,
		compiler_env_lookup_ufcs_methods,
		compiler_env_pop_scope,
		compiler_env_push_scope,
		compiler_env_resolve_overload,
	compiler_parsed_ast:
		ParsedBinaryOp(
			ParsedAddOp,
			ParsedDivideOp,
			ParsedEqualOp,
			ParsedGreaterEqualOp,
			ParsedGreaterOp,
			ParsedLessEqualOp,
			ParsedLessOp,
			ParsedModuloOp,
			ParsedMultiplyOp,
			ParsedNotEqualOp,
			ParsedSubtractOp,
		),
		ParsedCompoundAssignOp(
			ParsedAssignAddOp,
			ParsedAssignDivideOp,
			ParsedAssignMultiplyOp,
			ParsedAssignSubtractOp,
		),
		ParsedExpr(
			ParsedAscriptionExpr,
			ParsedAssignExpr,
			ParsedBinaryExpr,
			ParsedBlockExpr,
			ParsedBoolLiteralExpr,
			ParsedBreakExpr,
			ParsedBuiltinExpr,
			ParsedCallExpr,
			ParsedCharLiteralExpr,
			ParsedCompoundAssignExpr,
			ParsedContinueExpr,
			ParsedDebugBlockExpr,
			ParsedDictExpr,
			ParsedFieldAccessExpr,
			ParsedFloatLiteralExpr,
			ParsedForExpr,
			ParsedIfExpr,
			ParsedIntLiteralExpr,
			ParsedLambdaExpr,
			ParsedListExpr,
			ParsedLogicalExpr,
			ParsedMatchExpr,
			ParsedMissingExpr,
			ParsedNameExpr,
			ParsedRangeExpr,
			ParsedRecordExpr,
			ParsedRecordUpdateExpr,
			ParsedStringInterpolationExpr,
			ParsedStringInterpolationPartsExpr,
			ParsedStringLiteralExpr,
			ParsedSubscriptAssignExpr,
			ParsedSubscriptExpr,
			ParsedTupleExpr,
			ParsedTupleDestructExpr,
			ParsedUnaryExpr,
			ParsedVarDeclExpr,
			ParsedVectorExpr,
			ParsedWhileExpr,
			ParsedVoidExpr,
		),
		ParsedDictEntry,
		ParsedForBinder(ParsedForNameBinder, ParsedForTupleBinder),
		ParsedIdentifier,
		ParsedLambdaParam,
		ParsedListPatternSpread(ParsedListSpreadName, ParsedListSpreadWildcard),
		ParsedLogicalOp(ParsedAndOp, ParsedOrOp),
		ParsedMatchCase,
		ParsedPattern(
			ParsedBoolPattern,
			ParsedCharPattern,
			ParsedConstructorPattern,
			ParsedFloatPattern,
			ParsedIntPattern,
			ParsedListPattern,
			ParsedMissingPattern,
			ParsedNamePattern,
			ParsedOrPattern,
			ParsedQualifiedConstructorPattern,
			ParsedStringPattern,
			ParsedTuplePattern,
			ParsedWildcardPattern,
		),
		ParsedRecordExprField,
		ParsedStringInterpolationPart(ParsedInterpolationExpr, ParsedInterpolationLiteral),
		ParsedTypeExpr,
		ParsedUnaryOp(ParsedNegateOp, ParsedNotOp),
		parsed_expr_span,
	compiler_refinement: CompilerValueProofs, compiler_unrefined_binding
	compiler_source: CompilerSourceSpan
	compiler_type:
		CompilerType(
			CompilerArrayType,
			CompilerConstIntType,
			CompilerDimOpType,
			CompilerFunctionType,
			CompilerMetaType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerSelfType,
			CompilerTupleType,
			CompilerTypeVar,
			CompilerVarDimsType,
		),
		CompilerTypeSubstEntry,
		compiler_apply_subst,
		compiler_array_type,
		compiler_array_type_parts,
		compiler_is_any_float_type,
		compiler_is_any_integer_type,
		compiler_is_signed_integer_type,
		compiler_is_unsigned_integer_type,
		compiler_type_subst_entry,
		compiler_type_bool,
		compiler_type_char,
		compiler_type_copy,
		compiler_type_float,
		compiler_type_int,
		compiler_type_list,
		compiler_type_string,
		compiler_type_to_string,
		compiler_type_void,
		compiler_types_equal,
	compiler_type_widening:
		CompilerCollectionKind,
		CompilerTypeWideningDecision(CompilerTypeKeep),
		CompilerValueSlot,
		compiler_argument_target_slot,
		compiler_bitwise_operand_target_slot,
		compiler_collection_element_target_slot,
		compiler_mutable_binding_slot,
		compiler_numeric_operand_slot,
		compiler_numeric_operand_type,
		compiler_widening_decision,
		compiler_widening_semantic_type,
		compiler_widening_value_type,
	compiler_typecheck_state:
		CompilerTypecheckState,
		compiler_typecheck_state_add_error,
		compiler_typecheck_state_find_module_alias,
	compiler_typecheck_types: compiler_type_from_parsed_type_expr,


union CompilerExprTypeOrigin:
	CompilerInferredOrigin
	CompilerExplicitAnnotationOrigin(CompilerType)
	CompilerSynthesizedOrigin(String)


record CompilerResolvedCallInfo {
	callee_name: String,
	callable_id: Option[Int],
	purity: CompilerPurity
}


record CompilerTypedExprInfo {
	source_type: Option[CompilerType],
	semantic_type: CompilerType,
	value_type: CompilerType,
	origin: CompilerExprTypeOrigin,
	value_slot: CompilerValueSlot,
	proofs: CompilerValueProofs,
	resolved_call: Option[CompilerResolvedCallInfo]
}


record CompilerTypedVarDeclPayload {
	name: ParsedIdentifier,
	annotation: Option[CompilerType],
	initializer: CompilerTypedExpr,
	is_mutable: Bool,
	span: CompilerSourceSpan
}


record CompilerTypedDictEntry {
	key: CompilerTypedExpr,
	value: CompilerTypedExpr
}


record CompilerTypedRecordField {
	name: ParsedIdentifier,
	value: CompilerTypedExpr,
	span: CompilerSourceSpan
}


record CompilerTypedLambdaParam {
	name: ParsedIdentifier,
	source_type: Option[CompilerType],
	param_type: CompilerType
}


union CompilerTypedStringInterpolationPart:
	CompilerTypedInterpolationLiteral(String)
	CompilerTypedInterpolationExpr(CompilerTypedExpr)


union CompilerTypedPattern:
	CompilerTypedWildcardPattern(CompilerSourceSpan)
	CompilerTypedNamePattern(ParsedIdentifier, CompilerType)
	CompilerTypedBoolPattern(Bool, CompilerSourceSpan)
	CompilerTypedIntPattern(String, CompilerSourceSpan)
	CompilerTypedStringPattern(String, CompilerSourceSpan)
	CompilerTypedCharPattern(Int, CompilerSourceSpan)
	CompilerTypedUnsupportedPattern(String, CompilerSourceSpan)


record CompilerTypedMatchCase {
	pattern: CompilerTypedPattern,
	body: CompilerTypedExpr,
	span: CompilerSourceSpan
}


enum CompilerTypedAssignScope:
	CompilerLocalAssignScope
	CompilerModuleAssignScope


record CompilerTypedAssignTarget {
	name: String,
	scope: CompilerTypedAssignScope
}


union CompilerTypedExpr:
	CompilerTypedNameExpr(ParsedIdentifier, CompilerTypedExprInfo)
	CompilerTypedIntLiteralExpr(String, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedFloatLiteralExpr(String, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedStringLiteralExpr(String, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedStringInterpolationExpr(String, Bool, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedStringInterpolationPartsExpr(List[CompilerTypedStringInterpolationPart], Bool, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedBoolLiteralExpr(Bool, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedCharLiteralExpr(Int, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedUnaryExpr(ParsedUnaryOp, CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedBinaryExpr(ParsedBinaryOp, CompilerTypedExpr, CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedLogicalExpr(ParsedLogicalOp, CompilerTypedExpr, CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedCallExpr(CompilerTypedExpr, List[CompilerTypedExpr], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedTupleExpr(List[CompilerTypedExpr], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedTupleDestructExpr(List[ParsedIdentifier], CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedAssignExpr(ParsedIdentifier, CompilerTypedAssignScope, CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedSubscriptExpr(CompilerTypedExpr, List[CompilerTypedExpr], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedSubscriptAssignExpr(Option[CompilerTypedAssignTarget], CompilerTypedExpr, List[CompilerTypedExpr], CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedListExpr(List[CompilerTypedExpr], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedVectorExpr(List[CompilerTypedExpr], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedDictExpr(List[CompilerTypedDictEntry], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedRecordExpr(List[CompilerTypedRecordField], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedRecordUpdateExpr(CompilerTypedExpr, List[CompilerTypedRecordField], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedFieldAccessExpr(CompilerTypedExpr, ParsedIdentifier, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedLambdaExpr(Bool, List[CompilerTypedLambdaParam], Option[CompilerType], CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedRangeExpr(CompilerTypedExpr, CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedIfExpr(CompilerTypedExpr, CompilerTypedExpr, Option[CompilerTypedExpr], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedMatchExpr(CompilerTypedExpr, List[CompilerTypedMatchCase], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedWhileExpr(CompilerTypedExpr, CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedForExpr(ParsedForBinder, CompilerTypedExpr, CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedAscriptionExpr(CompilerTypedExpr, CompilerType, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedBlockExpr(List[CompilerTypedExpr], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedDebugBlockExpr(CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedVarDeclExpr(CompilerTypedVarDeclPayload, CompilerTypedExprInfo)
	CompilerTypedBreakExpr(CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedContinueExpr(CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedVoidExpr(CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedBuiltinExpr(Option[String], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedMissingExpr(CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedUnsupportedExpr(String, CompilerSourceSpan, CompilerTypedExprInfo)


union CompilerExpectedValueSlotContext:
	CompilerExpectedArgumentSlot
	CompilerExpectedCollectionElementSlot(CompilerCollectionKind)
	CompilerExpectedBitwiseOperandSlot


record CompilerInferContext {
	state: CompilerTypecheckState,
	expected_type: Option[CompilerType],
	expected_slot: Option[CompilerExpectedValueSlotContext],
	in_loop: Bool
}


record CompilerInferResult {
	context: CompilerInferContext,
	expr: CompilerTypedExpr
}


private record CompilerCheckedType {
	context: CompilerInferContext,
	typ: CompilerType
}


private record CompilerInferCallArgsResult {
	context: CompilerInferContext,
	args: List[CompilerTypedExpr],
	subst: List[CompilerTypeSubstEntry]
}


private record CompilerBindTypeSubstResult {
	context: CompilerInferContext,
	subst: List[CompilerTypeSubstEntry]
}


private record CompilerInferExprListResult {
	context: CompilerInferContext,
	exprs: List[CompilerTypedExpr]
}


private record CompilerInferDictEntriesResult {
	context: CompilerInferContext,
	entries: List[CompilerTypedDictEntry]
}


private record CompilerInferRecordFieldsResult {
	context: CompilerInferContext,
	fields: List[CompilerTypedRecordField]
}


private record CompilerInferStringInterpolationPartsResult {
	context: CompilerInferContext,
	parts: List[CompilerTypedStringInterpolationPart]
}


private record CompilerInferLambdaParamsResult {
	context: CompilerInferContext,
	params: List[CompilerTypedLambdaParam],
	param_types: List[CompilerType]
}


private record CompilerInferPatternResult {
	context: CompilerInferContext,
	env: CompilerEnv,
	pattern: CompilerTypedPattern,
	catch_all: Bool,
	matches_true: Bool,
	matches_false: Bool
}


private record CompilerInferMatchCasesResult {
	context: CompilerInferContext,
	cases: List[CompilerTypedMatchCase],
	result_type: Option[CompilerType],
	catch_all: Bool,
	matches_true: Bool,
	matches_false: Bool
}


private record CompilerMatchResultTypeResult {
	context: CompilerInferContext,
	result_type: Option[CompilerType]
}


private record CompilerForTupleElementsResult {
	context: CompilerInferContext,
	elements: List[CompilerType],
	ok: Bool
}


private record CompilerInferSubscriptIndicesResult {
	context: CompilerInferContext,
	indices: List[CompilerTypedExpr],
	values: List[Int],
	all_static: Bool
}


private pure func compiler_expected_value_slot_context_copy(
	slot: CompilerExpectedValueSlotContext,
) -> CompilerExpectedValueSlotContext:
	match slot:
		CompilerExpectedArgumentSlot:
			CompilerExpectedArgumentSlot
		CompilerExpectedCollectionElementSlot(kind):
			CompilerExpectedCollectionElementSlot(kind)
		CompilerExpectedBitwiseOperandSlot:
			CompilerExpectedBitwiseOperandSlot


private pure func compiler_optional_expected_value_slot_context_copy(
	slot: Option[CompilerExpectedValueSlotContext],
) -> Option[CompilerExpectedValueSlotContext]:
	match slot:
		Some(value):
			Some(compiler_expected_value_slot_context_copy(value))
		None:
			None


private pure func compiler_optional_type_copy(
	typ: Option[CompilerType],
) -> Option[CompilerType]:
	match typ:
		Some(value):
			Some(compiler_type_copy(value))
		None:
			None


private pure func compiler_infer_context_copy(
	context: CompilerInferContext,
) -> CompilerInferContext:
	{
		state = context.state,
		expected_type = compiler_optional_type_copy(context.expected_type),
		expected_slot = compiler_optional_expected_value_slot_context_copy(context.expected_slot),
		in_loop = context.in_loop
	}


pure func compiler_infer_context(state: CompilerTypecheckState) -> CompilerInferContext:
	{
		state = state,
		expected_type = None,
		expected_slot = None,
		in_loop = False
	}


pure func compiler_infer_with_expected(
	context: CompilerInferContext,
	expected_type: CompilerType,
) -> CompilerInferContext:
	{
		state = context.state,
		expected_type = Some(compiler_type_copy(expected_type)),
		expected_slot = None,
		in_loop = context.in_loop
	}


pure func compiler_infer_with_expected_value_slot(
	context: CompilerInferContext,
	expected_type: CompilerType,
	expected_slot: CompilerExpectedValueSlotContext,
) -> CompilerInferContext:
	{
		state = context.state,
		expected_type = Some(compiler_type_copy(expected_type)),
		expected_slot = Some(compiler_expected_value_slot_context_copy(expected_slot)),
		in_loop = context.in_loop
	}


pure func compiler_infer_without_expected(
	context: CompilerInferContext,
) -> CompilerInferContext:
	{
		state = context.state,
		expected_type = None,
		expected_slot = None,
		in_loop = context.in_loop
	}


private pure func compiler_infer_context_with_state(
	context: CompilerInferContext,
	state: CompilerTypecheckState,
) -> CompilerInferContext:
	{
		state = state,
		expected_type = compiler_optional_type_copy(context.expected_type),
		expected_slot = compiler_optional_expected_value_slot_context_copy(context.expected_slot),
		in_loop = context.in_loop
	}


private pure func compiler_infer_inside_loop(
	context: CompilerInferContext,
) -> CompilerInferContext:
	{
		state = context.state,
		expected_type = None,
		expected_slot = None,
		in_loop = True
	}


private pure func compiler_typecheck_state_with_env(
	state: CompilerTypecheckState,
	env: CompilerEnv,
) -> CompilerTypecheckState:
	{ state | env = env }


private pure func compiler_expr_type_origin_copy(
	origin: CompilerExprTypeOrigin,
) -> CompilerExprTypeOrigin:
	match origin:
		CompilerInferredOrigin:
			CompilerInferredOrigin
		CompilerExplicitAnnotationOrigin(typ):
			CompilerExplicitAnnotationOrigin(compiler_type_copy(typ))
		CompilerSynthesizedOrigin(label):
			CompilerSynthesizedOrigin(label)


private pure func compiler_resolved_call_info_copy(
	info: CompilerResolvedCallInfo,
) -> CompilerResolvedCallInfo:
	{
		callee_name = info.callee_name,
		callable_id = info.callable_id,
		purity = info.purity
	}


private pure func compiler_optional_resolved_call_info_copy(
	info: Option[CompilerResolvedCallInfo],
) -> Option[CompilerResolvedCallInfo]:
	match info:
		Some(value):
			Some(compiler_resolved_call_info_copy(value))
		None:
			None


private pure func compiler_keep_value_slot(typ: CompilerType) -> CompilerValueSlot:
	{
		semantic_type = compiler_type_copy(typ),
		decision = CompilerTypeKeep(compiler_type_copy(typ))
	}


private pure func compiler_infer_expected_slot(
	context: CompilerInferContext,
	semantic_type: CompilerType,
) -> CompilerValueSlot:
	match (context.expected_type, context.expected_slot):
		(Some(expected_type), Some(slot_context)):
			match slot_context:
				CompilerExpectedArgumentSlot:
					compiler_argument_target_slot(context.state.context, expected_type, semantic_type)
				CompilerExpectedCollectionElementSlot(kind):
					compiler_collection_element_target_slot(kind, expected_type, semantic_type)
				CompilerExpectedBitwiseOperandSlot:
					compiler_bitwise_operand_target_slot(expected_type, semantic_type)
		_:
			compiler_keep_value_slot(semantic_type)


private pure func compiler_typed_expr_info_from_slot(
	source_type: Option[CompilerType],
	origin: CompilerExprTypeOrigin,
	proofs: CompilerValueProofs,
	resolved_call: Option[CompilerResolvedCallInfo],
	value_slot: CompilerValueSlot,
) -> CompilerTypedExprInfo:
	semantic_type = compiler_widening_semantic_type(value_slot)
	value_type = compiler_widening_value_type(value_slot)

	{
		source_type = compiler_optional_type_copy(source_type),
		semantic_type = compiler_type_copy(semantic_type),
		value_type = compiler_type_copy(value_type),
		origin = compiler_expr_type_origin_copy(origin),
		value_slot = value_slot,
		proofs = proofs,
		resolved_call = compiler_optional_resolved_call_info_copy(resolved_call)
	}


private pure func compiler_inferred_info(
	context: CompilerInferContext,
	semantic_type: CompilerType,
) -> CompilerTypedExprInfo:
	compiler_typed_expr_info_from_slot(
		None,
		CompilerInferredOrigin,
		compiler_unrefined_binding(),
		None,
		compiler_infer_expected_slot(context, semantic_type),
	)


private pure func compiler_resolved_call_from_func_symbol(
	callee_name: String,
	func_symbol: CompilerFuncSymbol,
) -> CompilerResolvedCallInfo:
	{
		callee_name = callee_name,
		callable_id = Some(func_symbol.callable_id),
		purity = func_symbol.purity
	}


private pure func compiler_resolved_call_from_overload_entry(
	callee_name: String,
	entry: CompilerOverloadEntry,
) -> CompilerResolvedCallInfo:
	{
		callee_name = callee_name,
		callable_id = Some(entry.def_id),
		purity = entry.purity
	}


private pure func compiler_explicit_info(
	source_type: CompilerType,
	semantic_type: CompilerType,
) -> CompilerTypedExprInfo:
	compiler_typed_expr_info_from_slot(
		Some(compiler_type_copy(source_type)),
		CompilerExplicitAnnotationOrigin(compiler_type_copy(source_type)),
		compiler_unrefined_binding(),
		None,
		compiler_keep_value_slot(semantic_type),
	)


pure func compiler_typed_expr_info(expr: CompilerTypedExpr) -> CompilerTypedExprInfo:
	match expr:
		CompilerTypedNameExpr(_, info):
			info
		CompilerTypedIntLiteralExpr(_, _, info):
			info
		CompilerTypedFloatLiteralExpr(_, _, info):
			info
		CompilerTypedStringLiteralExpr(_, _, info):
			info
		CompilerTypedStringInterpolationExpr(_, _, _, info):
			info
		CompilerTypedStringInterpolationPartsExpr(_, _, _, info):
			info
		CompilerTypedBoolLiteralExpr(_, _, info):
			info
		CompilerTypedCharLiteralExpr(_, _, info):
			info
		CompilerTypedUnaryExpr(_, _, _, info):
			info
		CompilerTypedBinaryExpr(_, _, _, _, info):
			info
		CompilerTypedLogicalExpr(_, _, _, _, info):
			info
		CompilerTypedCallExpr(_, _, _, info):
			info
		CompilerTypedTupleExpr(_, _, info):
			info
		CompilerTypedTupleDestructExpr(_, _, _, info):
			info
		CompilerTypedAssignExpr(_, _, _, _, info):
			info
		CompilerTypedSubscriptExpr(_, _, _, info):
			info
		CompilerTypedSubscriptAssignExpr(_, _, _, _, _, info):
			info
		CompilerTypedListExpr(_, _, info):
			info
		CompilerTypedVectorExpr(_, _, info):
			info
		CompilerTypedDictExpr(_, _, info):
			info
		CompilerTypedRecordExpr(_, _, info):
			info
		CompilerTypedRecordUpdateExpr(_, _, _, info):
			info
		CompilerTypedFieldAccessExpr(_, _, _, info):
			info
		CompilerTypedLambdaExpr(_, _, _, _, _, info):
			info
		CompilerTypedRangeExpr(_, _, _, info):
			info
		CompilerTypedIfExpr(_, _, _, _, info):
			info
		CompilerTypedMatchExpr(_, _, _, info):
			info
		CompilerTypedWhileExpr(_, _, _, info):
			info
		CompilerTypedForExpr(_, _, _, _, info):
			info
		CompilerTypedAscriptionExpr(_, _, _, info):
			info
		CompilerTypedBlockExpr(_, _, info):
			info
		CompilerTypedDebugBlockExpr(_, _, info):
			info
		CompilerTypedVarDeclExpr(_, info):
			info
		CompilerTypedBreakExpr(_, info):
			info
		CompilerTypedContinueExpr(_, info):
			info
		CompilerTypedVoidExpr(_, info):
			info
		CompilerTypedBuiltinExpr(_, _, info):
			info
		CompilerTypedMissingExpr(_, info):
			info
		CompilerTypedUnsupportedExpr(_, _, info):
			info


private pure func compiler_typed_expr_with_info(
	expr: CompilerTypedExpr,
	info: CompilerTypedExprInfo,
) -> CompilerTypedExpr:
	match expr:
		CompilerTypedNameExpr(name, _):
			CompilerTypedNameExpr(name, info)
		CompilerTypedIntLiteralExpr(text, span, _):
			CompilerTypedIntLiteralExpr(text, span, info)
		CompilerTypedFloatLiteralExpr(text, span, _):
			CompilerTypedFloatLiteralExpr(text, span, info)
		CompilerTypedStringLiteralExpr(text, span, _):
			CompilerTypedStringLiteralExpr(text, span, info)
		CompilerTypedStringInterpolationExpr(text, raw, span, _):
			CompilerTypedStringInterpolationExpr(text, raw, span, info)
		CompilerTypedStringInterpolationPartsExpr(parts, multiline, span, _):
			CompilerTypedStringInterpolationPartsExpr(parts, multiline, span, info)
		CompilerTypedBoolLiteralExpr(value, span, _):
			CompilerTypedBoolLiteralExpr(value, span, info)
		CompilerTypedCharLiteralExpr(value, span, _):
			CompilerTypedCharLiteralExpr(value, span, info)
		CompilerTypedUnaryExpr(op, inner, span, _):
			CompilerTypedUnaryExpr(op, inner, span, info)
		CompilerTypedBinaryExpr(op, left, right, span, _):
			CompilerTypedBinaryExpr(op, left, right, span, info)
		CompilerTypedLogicalExpr(op, left, right, span, _):
			CompilerTypedLogicalExpr(op, left, right, span, info)
		CompilerTypedCallExpr(callee, args, span, _):
			CompilerTypedCallExpr(callee, args, span, info)
		CompilerTypedTupleExpr(items, span, _):
			CompilerTypedTupleExpr(items, span, info)
		CompilerTypedTupleDestructExpr(names, value, span, _):
			CompilerTypedTupleDestructExpr(names, value, span, info)
		CompilerTypedAssignExpr(name, scope, value, span, _):
			CompilerTypedAssignExpr(name, scope, value, span, info)
		CompilerTypedSubscriptExpr(receiver, indices, span, _):
			CompilerTypedSubscriptExpr(receiver, indices, span, info)
		CompilerTypedSubscriptAssignExpr(assign_target, receiver, indices, value, span, _):
			CompilerTypedSubscriptAssignExpr(assign_target, receiver, indices, value, span, info)
		CompilerTypedListExpr(items, span, _):
			CompilerTypedListExpr(items, span, info)
		CompilerTypedVectorExpr(items, span, _):
			CompilerTypedVectorExpr(items, span, info)
		CompilerTypedDictExpr(entries, span, _):
			CompilerTypedDictExpr(entries, span, info)
		CompilerTypedRecordExpr(fields, span, _):
			CompilerTypedRecordExpr(fields, span, info)
		CompilerTypedRecordUpdateExpr(receiver, fields, span, _):
			CompilerTypedRecordUpdateExpr(receiver, fields, span, info)
		CompilerTypedFieldAccessExpr(receiver, field, span, _):
			CompilerTypedFieldAccessExpr(receiver, field, span, info)
		CompilerTypedLambdaExpr(is_pure, params, return_annotation, body, span, _):
			CompilerTypedLambdaExpr(is_pure, params, return_annotation, body, span, info)
		CompilerTypedRangeExpr(start_expr, end_expr, span, _):
			CompilerTypedRangeExpr(start_expr, end_expr, span, info)
		CompilerTypedIfExpr(condition, then_branch, else_branch, span, _):
			CompilerTypedIfExpr(condition, then_branch, else_branch, span, info)
		CompilerTypedMatchExpr(scrutinee, cases, span, _):
			CompilerTypedMatchExpr(scrutinee, cases, span, info)
		CompilerTypedWhileExpr(condition, body, span, _):
			CompilerTypedWhileExpr(condition, body, span, info)
		CompilerTypedForExpr(binder, iterable, body, span, _):
			CompilerTypedForExpr(binder, iterable, body, span, info)
		CompilerTypedAscriptionExpr(inner, source_type, span, _):
			CompilerTypedAscriptionExpr(inner, source_type, span, info)
		CompilerTypedBlockExpr(items, span, _):
			CompilerTypedBlockExpr(items, span, info)
		CompilerTypedDebugBlockExpr(body, span, _):
			CompilerTypedDebugBlockExpr(body, span, info)
		CompilerTypedVarDeclExpr(payload, _):
			CompilerTypedVarDeclExpr(payload, info)
		CompilerTypedBreakExpr(span, _):
			CompilerTypedBreakExpr(span, info)
		CompilerTypedContinueExpr(span, _):
			CompilerTypedContinueExpr(span, info)
		CompilerTypedVoidExpr(span, _):
			CompilerTypedVoidExpr(span, info)
		CompilerTypedBuiltinExpr(name, span, _):
			CompilerTypedBuiltinExpr(name, span, info)
		CompilerTypedMissingExpr(span, _):
			CompilerTypedMissingExpr(span, info)
		CompilerTypedUnsupportedExpr(label, span, _):
			CompilerTypedUnsupportedExpr(label, span, info)


private pure func compiler_typed_expr_with_slot(
	expr: CompilerTypedExpr,
	value_slot: CompilerValueSlot,
) -> CompilerTypedExpr:
	info = compiler_typed_expr_info(expr)

	compiler_typed_expr_with_info(
		expr,
		compiler_typed_expr_info_from_slot(
			info.source_type,
			info.origin,
			info.proofs,
			info.resolved_call,
			value_slot,
		),
	)


pure func compiler_typed_expr_source_type(
	expr: CompilerTypedExpr,
) -> Option[CompilerType]:
	compiler_typed_expr_info(expr).source_type


pure func compiler_typed_expr_semantic_type(expr: CompilerTypedExpr) -> CompilerType:
	compiler_typed_expr_info(expr).semantic_type


pure func compiler_typed_expr_value_type(expr: CompilerTypedExpr) -> CompilerType:
	compiler_typed_expr_info(expr).value_type


pure func compiler_typed_expr_origin(expr: CompilerTypedExpr) -> CompilerExprTypeOrigin:
	compiler_typed_expr_info(expr).origin


pure func compiler_typed_expr_widening(
	expr: CompilerTypedExpr,
) -> CompilerTypeWideningDecision:
	compiler_widening_decision(compiler_typed_expr_info(expr).value_slot)


pure func compiler_typed_expr_resolved_call(
	expr: CompilerTypedExpr,
) -> Option[CompilerResolvedCallInfo]:
	compiler_typed_expr_info(expr).resolved_call


private pure func compiler_copy_diagnostic_name(name: String) -> String:
	name.substring(0, name.length())


private pure func compiler_append_impure_call_names(
	names: List[String],
	extra: List[String],
) -> List[String]:
	var result = names

	for name in extra:
		result = result.append(name)

	result


private pure func compiler_typed_expr_list_impure_call_names(
	exprs: List[CompilerTypedExpr],
) -> List[String]:
	var result: List[String] = []

	for expr in exprs:
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_impure_call_names(expr),
		)

	result


private pure func compiler_typed_dict_entries_impure_call_names(
	entries: List[CompilerTypedDictEntry],
) -> List[String]:
	var result: List[String] = []

	for entry in entries:
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_impure_call_names(entry.key),
		)
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_impure_call_names(entry.value),
		)

	result


private pure func compiler_typed_record_fields_impure_call_names(
	fields: List[CompilerTypedRecordField],
) -> List[String]:
	var result: List[String] = []

	for field in fields:
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_impure_call_names(field.value),
		)

	result


private pure func compiler_typed_interpolation_parts_impure_call_names(
	parts: List[CompilerTypedStringInterpolationPart],
) -> List[String]:
	var result: List[String] = []

	for part in parts:
		match part:
			CompilerTypedInterpolationLiteral(_):
				void
			CompilerTypedInterpolationExpr(expr):
				result = compiler_append_impure_call_names(
					result,
					compiler_typed_expr_impure_call_names(expr),
				)

	result


private pure func compiler_typed_match_cases_impure_call_names(
	cases: List[CompilerTypedMatchCase],
) -> List[String]:
	var result: List[String] = []

	for case in cases:
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_impure_call_names(case.body),
		)

	result


private pure func compiler_call_expr_impure_call_name(
	info: CompilerTypedExprInfo,
) -> List[String]:
	match info.resolved_call:
		Some(call):
			if call.purity == CompilerImpure:
				[compiler_copy_diagnostic_name(call.callee_name)]
			else:
				[]
		None:
			[]


pure func compiler_typed_expr_impure_call_names(expr: CompilerTypedExpr) -> List[String]:
	match expr:
		CompilerTypedUnaryExpr(_, inner, _, _):
			compiler_typed_expr_impure_call_names(inner)
		CompilerTypedBinaryExpr(_, left, right, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(left),
				compiler_typed_expr_impure_call_names(right),
			)
		CompilerTypedLogicalExpr(_, left, right, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(left),
				compiler_typed_expr_impure_call_names(right),
			)
		CompilerTypedCallExpr(callee, args, _, info):
			with_callee = compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(callee),
				compiler_typed_expr_list_impure_call_names(args),
			)
			compiler_append_impure_call_names(with_callee, compiler_call_expr_impure_call_name(info))
		CompilerTypedTupleExpr(items, _, _):
			compiler_typed_expr_list_impure_call_names(items)
		CompilerTypedTupleDestructExpr(_, value, _, _):
			compiler_typed_expr_impure_call_names(value)
		CompilerTypedAssignExpr(_, _, value, _, _):
			compiler_typed_expr_impure_call_names(value)
		CompilerTypedSubscriptExpr(receiver, indices, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(receiver),
				compiler_typed_expr_list_impure_call_names(indices),
			)
		CompilerTypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
			with_indices = compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(receiver),
				compiler_typed_expr_list_impure_call_names(indices),
			)
			compiler_append_impure_call_names(with_indices, compiler_typed_expr_impure_call_names(value))
		CompilerTypedListExpr(items, _, _):
			compiler_typed_expr_list_impure_call_names(items)
		CompilerTypedVectorExpr(items, _, _):
			compiler_typed_expr_list_impure_call_names(items)
		CompilerTypedDictExpr(entries, _, _):
			compiler_typed_dict_entries_impure_call_names(entries)
		CompilerTypedRecordExpr(fields, _, _):
			compiler_typed_record_fields_impure_call_names(fields)
		CompilerTypedRecordUpdateExpr(base, fields, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(base),
				compiler_typed_record_fields_impure_call_names(fields),
			)
		CompilerTypedFieldAccessExpr(receiver, _, _, _):
			compiler_typed_expr_impure_call_names(receiver)
		CompilerTypedLambdaExpr(is_pure, _, _, body, _, _):
			if is_pure:
				compiler_typed_expr_impure_call_names(body)
			else:
				[]
		CompilerTypedRangeExpr(start_expr, end_expr, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(start_expr),
				compiler_typed_expr_impure_call_names(end_expr),
			)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			with_then = compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(condition),
				compiler_typed_expr_impure_call_names(then_branch),
			)
			match else_branch:
				Some(branch):
					compiler_append_impure_call_names(
						with_then,
						compiler_typed_expr_impure_call_names(branch),
					)
				None:
					with_then
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(scrutinee),
				compiler_typed_match_cases_impure_call_names(cases),
			)
		CompilerTypedWhileExpr(condition, body, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(condition),
				compiler_typed_expr_impure_call_names(body),
			)
		CompilerTypedForExpr(_, iterable, body, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(iterable),
				compiler_typed_expr_impure_call_names(body),
			)
		CompilerTypedAscriptionExpr(inner, _, _, _):
			compiler_typed_expr_impure_call_names(inner)
		CompilerTypedBlockExpr(items, _, _):
			compiler_typed_expr_list_impure_call_names(items)
		CompilerTypedDebugBlockExpr(body, _, _):
			compiler_typed_expr_impure_call_names(body)
		CompilerTypedVarDeclExpr(payload, _):
			compiler_typed_expr_impure_call_names(payload.initializer)
		CompilerTypedStringInterpolationPartsExpr(parts, _, _, _):
			compiler_typed_interpolation_parts_impure_call_names(parts)
		_:
			[]


private pure func compiler_append_module_assign_names(
	names: List[String],
	extra: List[String],
) -> List[String]:
	var result = names

	for name in extra:
		result = result.append(name)

	result


private pure func compiler_typed_expr_list_module_assign_names(
	exprs: List[CompilerTypedExpr],
) -> List[String]:
	var result: List[String] = []

	for expr in exprs:
		result = compiler_append_module_assign_names(
			result,
			compiler_typed_expr_module_assign_names(expr),
		)

	result


private pure func compiler_typed_dict_entries_module_assign_names(
	entries: List[CompilerTypedDictEntry],
) -> List[String]:
	var result: List[String] = []

	for entry in entries:
		result = compiler_append_module_assign_names(
			result,
			compiler_typed_expr_module_assign_names(entry.key),
		)
		result = compiler_append_module_assign_names(
			result,
			compiler_typed_expr_module_assign_names(entry.value),
		)

	result


private pure func compiler_typed_record_fields_module_assign_names(
	fields: List[CompilerTypedRecordField],
) -> List[String]:
	var result: List[String] = []

	for field in fields:
		result = compiler_append_module_assign_names(
			result,
			compiler_typed_expr_module_assign_names(field.value),
		)

	result


private pure func compiler_typed_interpolation_parts_module_assign_names(
	parts: List[CompilerTypedStringInterpolationPart],
) -> List[String]:
	var result: List[String] = []

	for part in parts:
		match part:
			CompilerTypedInterpolationLiteral(_):
				void
			CompilerTypedInterpolationExpr(expr):
				result = compiler_append_module_assign_names(
					result,
					compiler_typed_expr_module_assign_names(expr),
				)

	result


private pure func compiler_typed_match_cases_module_assign_names(
	cases: List[CompilerTypedMatchCase],
) -> List[String]:
	var result: List[String] = []

	for case in cases:
		result = compiler_append_module_assign_names(
			result,
			compiler_typed_expr_module_assign_names(case.body),
		)

	result


pure func compiler_typed_expr_module_assign_names(expr: CompilerTypedExpr) -> List[String]:
	match expr:
		CompilerTypedUnaryExpr(_, inner, _, _):
			compiler_typed_expr_module_assign_names(inner)
		CompilerTypedBinaryExpr(_, left, right, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(left),
				compiler_typed_expr_module_assign_names(right),
			)
		CompilerTypedLogicalExpr(_, left, right, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(left),
				compiler_typed_expr_module_assign_names(right),
			)
		CompilerTypedCallExpr(callee, args, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(callee),
				compiler_typed_expr_list_module_assign_names(args),
			)
		CompilerTypedTupleExpr(items, _, _):
			compiler_typed_expr_list_module_assign_names(items)
		CompilerTypedTupleDestructExpr(_, value, _, _):
			compiler_typed_expr_module_assign_names(value)
		CompilerTypedAssignExpr(name, scope, value, _, _):
			value_names = compiler_typed_expr_module_assign_names(value)

			match scope:
				CompilerModuleAssignScope:
					compiler_append_module_assign_names(
						value_names,
						[compiler_copy_diagnostic_name(name.text)],
					)
				CompilerLocalAssignScope:
					value_names
		CompilerTypedSubscriptExpr(receiver, indices, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(receiver),
				compiler_typed_expr_list_module_assign_names(indices),
			)
		CompilerTypedSubscriptAssignExpr(assign_target, receiver, indices, value, _, _):
			with_indices = compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(receiver),
				compiler_typed_expr_list_module_assign_names(indices),
			)
			value_names = compiler_append_module_assign_names(
				with_indices,
				compiler_typed_expr_module_assign_names(value),
			)

			match assign_target:
				Some(target):
					match target.scope:
						CompilerModuleAssignScope:
							compiler_append_module_assign_names(
								value_names,
								[compiler_copy_diagnostic_name(target.name)],
							)
						CompilerLocalAssignScope:
							value_names
				None:
					value_names
		CompilerTypedListExpr(items, _, _):
			compiler_typed_expr_list_module_assign_names(items)
		CompilerTypedVectorExpr(items, _, _):
			compiler_typed_expr_list_module_assign_names(items)
		CompilerTypedDictExpr(entries, _, _):
			compiler_typed_dict_entries_module_assign_names(entries)
		CompilerTypedRecordExpr(fields, _, _):
			compiler_typed_record_fields_module_assign_names(fields)
		CompilerTypedRecordUpdateExpr(base, fields, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(base),
				compiler_typed_record_fields_module_assign_names(fields),
			)
		CompilerTypedFieldAccessExpr(receiver, _, _, _):
			compiler_typed_expr_module_assign_names(receiver)
		CompilerTypedLambdaExpr(is_pure, _, _, body, _, _):
			if is_pure:
				compiler_typed_expr_module_assign_names(body)
			else:
				[]
		CompilerTypedRangeExpr(start_expr, end_expr, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(start_expr),
				compiler_typed_expr_module_assign_names(end_expr),
			)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			with_then = compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(condition),
				compiler_typed_expr_module_assign_names(then_branch),
			)
			match else_branch:
				Some(branch):
					compiler_append_module_assign_names(
						with_then,
						compiler_typed_expr_module_assign_names(branch),
					)
				None:
					with_then
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(scrutinee),
				compiler_typed_match_cases_module_assign_names(cases),
			)
		CompilerTypedWhileExpr(condition, body, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(condition),
				compiler_typed_expr_module_assign_names(body),
			)
		CompilerTypedForExpr(_, iterable, body, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(iterable),
				compiler_typed_expr_module_assign_names(body),
			)
		CompilerTypedAscriptionExpr(inner, _, _, _):
			compiler_typed_expr_module_assign_names(inner)
		CompilerTypedBlockExpr(items, _, _):
			compiler_typed_expr_list_module_assign_names(items)
		CompilerTypedDebugBlockExpr(body, _, _):
			compiler_typed_expr_module_assign_names(body)
		CompilerTypedVarDeclExpr(payload, _):
			compiler_typed_expr_module_assign_names(payload.initializer)
		CompilerTypedStringInterpolationPartsExpr(parts, _, _, _):
			compiler_typed_interpolation_parts_module_assign_names(parts)
		_:
			[]


private pure func compiler_append_startup_call_names(
	names: List[String],
	extra: List[String],
) -> List[String]:
	var result = names

	for name in extra:
		result = result.append(name)

	result


private pure func compiler_typed_expr_list_startup_call_names(
	exprs: List[CompilerTypedExpr],
) -> List[String]:
	var result: List[String] = []

	for expr in exprs:
		result = compiler_append_startup_call_names(
			result,
			compiler_typed_expr_startup_call_names(expr),
		)

	result


private pure func compiler_typed_dict_entries_startup_call_names(
	entries: List[CompilerTypedDictEntry],
) -> List[String]:
	var result: List[String] = []

	for entry in entries:
		result = compiler_append_startup_call_names(
			result,
			compiler_typed_expr_startup_call_names(entry.key),
		)
		result = compiler_append_startup_call_names(
			result,
			compiler_typed_expr_startup_call_names(entry.value),
		)

	result


private pure func compiler_typed_record_fields_startup_call_names(
	fields: List[CompilerTypedRecordField],
) -> List[String]:
	var result: List[String] = []

	for field in fields:
		result = compiler_append_startup_call_names(
			result,
			compiler_typed_expr_startup_call_names(field.value),
		)

	result


private pure func compiler_typed_interpolation_parts_startup_call_names(
	parts: List[CompilerTypedStringInterpolationPart],
) -> List[String]:
	var result: List[String] = []

	for part in parts:
		match part:
			CompilerTypedInterpolationLiteral(_):
				void
			CompilerTypedInterpolationExpr(expr):
				result = compiler_append_startup_call_names(
					result,
					compiler_typed_expr_startup_call_names(expr),
				)

	result


private pure func compiler_typed_match_cases_startup_call_names(
	cases: List[CompilerTypedMatchCase],
) -> List[String]:
	var result: List[String] = []

	for case in cases:
		result = compiler_append_startup_call_names(
			result,
			compiler_typed_expr_startup_call_names(case.body),
		)

	result


private pure func compiler_startup_call_name(
	callee: CompilerTypedExpr,
	info: CompilerTypedExprInfo,
) -> String:
	match info.resolved_call:
		Some(call):
			compiler_copy_diagnostic_name(call.callee_name)
		None:
			match callee:
				CompilerTypedNameExpr(name, _):
					compiler_copy_diagnostic_name(name.text)
				CompilerTypedFieldAccessExpr(_, field, _, _):
					compiler_copy_diagnostic_name(field.text)
				_:
					"<expression>"


pure func compiler_typed_expr_startup_call_names(expr: CompilerTypedExpr) -> List[String]:
	match expr:
		CompilerTypedUnaryExpr(_, inner, _, _):
			compiler_typed_expr_startup_call_names(inner)
		CompilerTypedBinaryExpr(_, left, right, _, _):
			compiler_append_startup_call_names(
				compiler_typed_expr_startup_call_names(left),
				compiler_typed_expr_startup_call_names(right),
			)
		CompilerTypedLogicalExpr(_, left, right, _, _):
			compiler_append_startup_call_names(
				compiler_typed_expr_startup_call_names(left),
				compiler_typed_expr_startup_call_names(right),
			)
		CompilerTypedCallExpr(callee, args, _, info):
			with_callee = compiler_append_startup_call_names(
				[compiler_startup_call_name(callee, info)],
				compiler_typed_expr_startup_call_names(callee),
			)
			compiler_append_startup_call_names(
				with_callee,
				compiler_typed_expr_list_startup_call_names(args),
			)
		CompilerTypedTupleExpr(items, _, _):
			compiler_typed_expr_list_startup_call_names(items)
		CompilerTypedTupleDestructExpr(_, value, _, _):
			compiler_typed_expr_startup_call_names(value)
		CompilerTypedAssignExpr(_, _, value, _, _):
			compiler_typed_expr_startup_call_names(value)
		CompilerTypedSubscriptExpr(receiver, indices, _, _):
			compiler_append_startup_call_names(
				compiler_typed_expr_startup_call_names(receiver),
				compiler_typed_expr_list_startup_call_names(indices),
			)
		CompilerTypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
			with_indices = compiler_append_startup_call_names(
				compiler_typed_expr_startup_call_names(receiver),
				compiler_typed_expr_list_startup_call_names(indices),
			)
			compiler_append_startup_call_names(
				with_indices,
				compiler_typed_expr_startup_call_names(value),
			)
		CompilerTypedListExpr(items, _, _):
			compiler_typed_expr_list_startup_call_names(items)
		CompilerTypedVectorExpr(items, _, _):
			compiler_typed_expr_list_startup_call_names(items)
		CompilerTypedDictExpr(entries, _, _):
			compiler_typed_dict_entries_startup_call_names(entries)
		CompilerTypedRecordExpr(fields, _, _):
			compiler_typed_record_fields_startup_call_names(fields)
		CompilerTypedRecordUpdateExpr(base, fields, _, _):
			compiler_append_startup_call_names(
				compiler_typed_expr_startup_call_names(base),
				compiler_typed_record_fields_startup_call_names(fields),
			)
		CompilerTypedFieldAccessExpr(receiver, _, _, _):
			compiler_typed_expr_startup_call_names(receiver)
		CompilerTypedLambdaExpr(_, _, _, _, _, _):
			[]
		CompilerTypedRangeExpr(start_expr, end_expr, _, _):
			compiler_append_startup_call_names(
				compiler_typed_expr_startup_call_names(start_expr),
				compiler_typed_expr_startup_call_names(end_expr),
			)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			with_then = compiler_append_startup_call_names(
				compiler_typed_expr_startup_call_names(condition),
				compiler_typed_expr_startup_call_names(then_branch),
			)
			match else_branch:
				Some(branch):
					compiler_append_startup_call_names(
						with_then,
						compiler_typed_expr_startup_call_names(branch),
					)
				None:
					with_then
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			compiler_append_startup_call_names(
				compiler_typed_expr_startup_call_names(scrutinee),
				compiler_typed_match_cases_startup_call_names(cases),
			)
		CompilerTypedWhileExpr(condition, body, _, _):
			compiler_append_startup_call_names(
				compiler_typed_expr_startup_call_names(condition),
				compiler_typed_expr_startup_call_names(body),
			)
		CompilerTypedForExpr(_, iterable, body, _, _):
			compiler_append_startup_call_names(
				compiler_typed_expr_startup_call_names(iterable),
				compiler_typed_expr_startup_call_names(body),
			)
		CompilerTypedAscriptionExpr(inner, _, _, _):
			compiler_typed_expr_startup_call_names(inner)
		CompilerTypedBlockExpr(items, _, _):
			compiler_typed_expr_list_startup_call_names(items)
		CompilerTypedDebugBlockExpr(body, _, _):
			compiler_typed_expr_startup_call_names(body)
		CompilerTypedVarDeclExpr(payload, _):
			compiler_typed_expr_startup_call_names(payload.initializer)
		CompilerTypedStringInterpolationPartsExpr(parts, _, _, _):
			compiler_typed_interpolation_parts_startup_call_names(parts)
		_:
			[]


private pure func compiler_typed_expr_list_has_startup_subscript(
	exprs: List[CompilerTypedExpr],
) -> Bool:
	var found: Bool = False

	for expr in exprs:
		if compiler_typed_expr_has_startup_subscript(expr):
			found = True
			break

	found


private pure func compiler_typed_dict_entries_have_startup_subscript(
	entries: List[CompilerTypedDictEntry],
) -> Bool:
	var found: Bool = False

	for entry in entries:
		if (
			compiler_typed_expr_has_startup_subscript(entry.key)
			or compiler_typed_expr_has_startup_subscript(entry.value)
		):
			found = True
			break

	found


private pure func compiler_typed_record_fields_have_startup_subscript(
	fields: List[CompilerTypedRecordField],
) -> Bool:
	var found: Bool = False

	for field in fields:
		if compiler_typed_expr_has_startup_subscript(field.value):
			found = True
			break

	found


private pure func compiler_typed_interpolation_parts_have_startup_subscript(
	parts: List[CompilerTypedStringInterpolationPart],
) -> Bool:
	var found: Bool = False

	for part in parts:
		match part:
			CompilerTypedInterpolationLiteral(_):
				void
			CompilerTypedInterpolationExpr(expr):
				if compiler_typed_expr_has_startup_subscript(expr):
					found = True
					break

	found


private pure func compiler_typed_match_cases_have_startup_subscript(
	cases: List[CompilerTypedMatchCase],
) -> Bool:
	var found: Bool = False

	for case in cases:
		if compiler_typed_expr_has_startup_subscript(case.body):
			found = True
			break

	found


pure func compiler_typed_expr_has_startup_subscript(expr: CompilerTypedExpr) -> Bool:
	match expr:
		CompilerTypedUnaryExpr(_, inner, _, _):
			compiler_typed_expr_has_startup_subscript(inner)
		CompilerTypedBinaryExpr(_, left, right, _, _):
			(
				compiler_typed_expr_has_startup_subscript(left)
				or compiler_typed_expr_has_startup_subscript(right)
			)
		CompilerTypedLogicalExpr(_, left, right, _, _):
			(
				compiler_typed_expr_has_startup_subscript(left)
				or compiler_typed_expr_has_startup_subscript(right)
			)
		CompilerTypedCallExpr(callee, args, _, _):
			(
				compiler_typed_expr_has_startup_subscript(callee)
				or compiler_typed_expr_list_has_startup_subscript(args)
			)
		CompilerTypedTupleExpr(items, _, _):
			compiler_typed_expr_list_has_startup_subscript(items)
		CompilerTypedTupleDestructExpr(_, value, _, _):
			compiler_typed_expr_has_startup_subscript(value)
		CompilerTypedAssignExpr(_, _, value, _, _):
			compiler_typed_expr_has_startup_subscript(value)
		CompilerTypedSubscriptExpr(_, _, _, _):
			True
		CompilerTypedSubscriptAssignExpr(_, _, _, _, _, _):
			True
		CompilerTypedListExpr(items, _, _):
			compiler_typed_expr_list_has_startup_subscript(items)
		CompilerTypedVectorExpr(items, _, _):
			compiler_typed_expr_list_has_startup_subscript(items)
		CompilerTypedDictExpr(entries, _, _):
			compiler_typed_dict_entries_have_startup_subscript(entries)
		CompilerTypedRecordExpr(fields, _, _):
			compiler_typed_record_fields_have_startup_subscript(fields)
		CompilerTypedRecordUpdateExpr(base, fields, _, _):
			(
				compiler_typed_expr_has_startup_subscript(base)
				or compiler_typed_record_fields_have_startup_subscript(fields)
			)
		CompilerTypedFieldAccessExpr(receiver, _, _, _):
			compiler_typed_expr_has_startup_subscript(receiver)
		CompilerTypedLambdaExpr(_, _, _, _, _, _):
			False
		CompilerTypedRangeExpr(start_expr, end_expr, _, _):
			(
				compiler_typed_expr_has_startup_subscript(start_expr)
				or compiler_typed_expr_has_startup_subscript(end_expr)
			)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			has_else = match else_branch:
				Some(branch):
					compiler_typed_expr_has_startup_subscript(branch)
				None:
					False
			(
				compiler_typed_expr_has_startup_subscript(condition)
				or compiler_typed_expr_has_startup_subscript(then_branch)
				or has_else
			)
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			(
				compiler_typed_expr_has_startup_subscript(scrutinee)
				or compiler_typed_match_cases_have_startup_subscript(cases)
			)
		CompilerTypedWhileExpr(condition, body, _, _):
			(
				compiler_typed_expr_has_startup_subscript(condition)
				or compiler_typed_expr_has_startup_subscript(body)
			)
		CompilerTypedForExpr(_, iterable, body, _, _):
			(
				compiler_typed_expr_has_startup_subscript(iterable)
				or compiler_typed_expr_has_startup_subscript(body)
			)
		CompilerTypedAscriptionExpr(inner, _, _, _):
			compiler_typed_expr_has_startup_subscript(inner)
		CompilerTypedBlockExpr(items, _, _):
			compiler_typed_expr_list_has_startup_subscript(items)
		CompilerTypedDebugBlockExpr(body, _, _):
			compiler_typed_expr_has_startup_subscript(body)
		CompilerTypedVarDeclExpr(payload, _):
			compiler_typed_expr_has_startup_subscript(payload.initializer)
		CompilerTypedStringInterpolationPartsExpr(parts, _, _, _):
			compiler_typed_interpolation_parts_have_startup_subscript(parts)
		_:
			False


private pure func compiler_resolved_call_name(info: CompilerTypedExprInfo) -> Option[String]:
	match info.resolved_call:
		Some(call):
			Some(call.callee_name)
		None:
			None


private pure func compiler_typed_expr_list_has_non_tail_recursive_call(
	exprs: List[CompilerTypedExpr],
	function_name: String,
) -> Bool:
	var found: Bool = False

	for expr in exprs:
		if compiler_typed_expr_has_non_tail_recursive_call_inner(expr, function_name, False):
			found = True
			break

	found


private pure func compiler_typed_dict_entries_have_non_tail_recursive_call(
	entries: List[CompilerTypedDictEntry],
	function_name: String,
) -> Bool:
	var found: Bool = False

	for entry in entries:
		if (
			compiler_typed_expr_has_non_tail_recursive_call_inner(entry.key, function_name, False)
			or compiler_typed_expr_has_non_tail_recursive_call_inner(entry.value, function_name, False)
		):
			found = True
			break

	found


private pure func compiler_typed_record_fields_have_non_tail_recursive_call(
	fields: List[CompilerTypedRecordField],
	function_name: String,
) -> Bool:
	var found: Bool = False

	for field in fields:
		if compiler_typed_expr_has_non_tail_recursive_call_inner(field.value, function_name, False):
			found = True
			break

	found


private pure func compiler_typed_interpolation_parts_have_non_tail_recursive_call(
	parts: List[CompilerTypedStringInterpolationPart],
	function_name: String,
) -> Bool:
	var found: Bool = False

	for part in parts:
		match part:
			CompilerTypedInterpolationLiteral(_):
				void
			CompilerTypedInterpolationExpr(expr):
				if compiler_typed_expr_has_non_tail_recursive_call_inner(expr, function_name, False):
					found = True
					break

	found


private pure func compiler_typed_match_cases_have_non_tail_recursive_call(
	cases: List[CompilerTypedMatchCase],
	function_name: String,
	in_tail: Bool,
) -> Bool:
	var found: Bool = False

	for case in cases:
		if compiler_typed_expr_has_non_tail_recursive_call_inner(case.body, function_name, in_tail):
			found = True
			break

	found


private pure func compiler_typed_block_has_non_tail_recursive_call(
	items: List[CompilerTypedExpr],
	function_name: String,
	in_tail: Bool,
) -> Bool:
	var found: Bool = False
	var index: Int = 0

	while index < items.length() and not found:
		match items.get(index):
			Some(item):
				item_tail: Bool = in_tail and index == items.length() - 1
				if compiler_typed_expr_has_non_tail_recursive_call_inner(
					item,
					function_name,
					item_tail,
				):
					found = True
			None:
				void

		index += 1

	found


private pure func compiler_typed_call_has_non_tail_recursive_call(
	callee: CompilerTypedExpr,
	args: List[CompilerTypedExpr],
	info: CompilerTypedExprInfo,
	function_name: String,
	in_tail: Bool,
) -> Bool:
	is_recursive = compiler_resolved_call_name(info) == Some(function_name)

	if is_recursive and not in_tail:
		True
	else:
		args_have_call = compiler_typed_expr_list_has_non_tail_recursive_call(args, function_name)
		if args_have_call:
			True
		else if is_recursive:
			False
		else:
			compiler_typed_expr_has_non_tail_recursive_call_inner(callee, function_name, False)


private pure func compiler_typed_expr_has_non_tail_recursive_call_inner(
	expr: CompilerTypedExpr,
	function_name: String,
	in_tail: Bool,
) -> Bool:
	match expr:
		CompilerTypedUnaryExpr(_, inner, _, _):
			compiler_typed_expr_has_non_tail_recursive_call_inner(inner, function_name, False)
		CompilerTypedBinaryExpr(_, left, right, _, _):
			(
				compiler_typed_expr_has_non_tail_recursive_call_inner(left, function_name, False)
				or compiler_typed_expr_has_non_tail_recursive_call_inner(right, function_name, False)
			)
		CompilerTypedLogicalExpr(_, left, right, _, _):
			(
				compiler_typed_expr_has_non_tail_recursive_call_inner(left, function_name, False)
				or compiler_typed_expr_has_non_tail_recursive_call_inner(right, function_name, False)
			)
		CompilerTypedCallExpr(callee, args, _, info):
			compiler_typed_call_has_non_tail_recursive_call(
				callee,
				args,
				info,
				function_name,
				in_tail,
			)
		CompilerTypedTupleExpr(items, _, _):
			compiler_typed_expr_list_has_non_tail_recursive_call(items, function_name)
		CompilerTypedTupleDestructExpr(_, value, _, _):
			compiler_typed_expr_has_non_tail_recursive_call_inner(value, function_name, False)
		CompilerTypedAssignExpr(_, _, value, _, _):
			compiler_typed_expr_has_non_tail_recursive_call_inner(value, function_name, False)
		CompilerTypedSubscriptExpr(receiver, indices, _, _):
			(
				compiler_typed_expr_has_non_tail_recursive_call_inner(receiver, function_name, False)
				or compiler_typed_expr_list_has_non_tail_recursive_call(indices, function_name)
			)
		CompilerTypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
			(
				compiler_typed_expr_has_non_tail_recursive_call_inner(receiver, function_name, False)
				or compiler_typed_expr_list_has_non_tail_recursive_call(indices, function_name)
				or compiler_typed_expr_has_non_tail_recursive_call_inner(value, function_name, False)
			)
		CompilerTypedListExpr(items, _, _):
			compiler_typed_expr_list_has_non_tail_recursive_call(items, function_name)
		CompilerTypedVectorExpr(items, _, _):
			compiler_typed_expr_list_has_non_tail_recursive_call(items, function_name)
		CompilerTypedDictExpr(entries, _, _):
			compiler_typed_dict_entries_have_non_tail_recursive_call(entries, function_name)
		CompilerTypedRecordExpr(fields, _, _):
			compiler_typed_record_fields_have_non_tail_recursive_call(fields, function_name)
		CompilerTypedRecordUpdateExpr(base, fields, _, _):
			(
				compiler_typed_expr_has_non_tail_recursive_call_inner(base, function_name, False)
				or compiler_typed_record_fields_have_non_tail_recursive_call(fields, function_name)
			)
		CompilerTypedFieldAccessExpr(receiver, _, _, _):
			compiler_typed_expr_has_non_tail_recursive_call_inner(receiver, function_name, False)
		CompilerTypedLambdaExpr(_, _, _, body, _, _):
			compiler_typed_expr_has_non_tail_recursive_call_inner(body, function_name, True)
		CompilerTypedRangeExpr(start_expr, end_expr, _, _):
			(
				compiler_typed_expr_has_non_tail_recursive_call_inner(start_expr, function_name, False)
				or compiler_typed_expr_has_non_tail_recursive_call_inner(end_expr, function_name, False)
			)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			condition_has = compiler_typed_expr_has_non_tail_recursive_call_inner(
				condition,
				function_name,
				False,
			)
			if condition_has:
				True
			else if compiler_typed_expr_has_non_tail_recursive_call_inner(
				then_branch,
				function_name,
				in_tail,
			):
				True
			else:
				match else_branch:
					Some(branch):
						compiler_typed_expr_has_non_tail_recursive_call_inner(
							branch,
							function_name,
							in_tail,
						)
					None:
						False
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			(
				compiler_typed_expr_has_non_tail_recursive_call_inner(scrutinee, function_name, False)
				or compiler_typed_match_cases_have_non_tail_recursive_call(
					cases,
					function_name,
					in_tail,
				)
			)
		CompilerTypedWhileExpr(condition, body, _, _):
			(
				compiler_typed_expr_has_non_tail_recursive_call_inner(condition, function_name, False)
				or compiler_typed_expr_has_non_tail_recursive_call_inner(body, function_name, False)
			)
		CompilerTypedForExpr(_, iterable, body, _, _):
			(
				compiler_typed_expr_has_non_tail_recursive_call_inner(iterable, function_name, False)
				or compiler_typed_expr_has_non_tail_recursive_call_inner(body, function_name, False)
			)
		CompilerTypedAscriptionExpr(inner, _, _, _):
			compiler_typed_expr_has_non_tail_recursive_call_inner(inner, function_name, in_tail)
		CompilerTypedBlockExpr(items, _, _):
			compiler_typed_block_has_non_tail_recursive_call(items, function_name, in_tail)
		CompilerTypedDebugBlockExpr(body, _, _):
			compiler_typed_expr_has_non_tail_recursive_call_inner(body, function_name, in_tail)
		CompilerTypedVarDeclExpr(payload, _):
			compiler_typed_expr_has_non_tail_recursive_call_inner(
				payload.initializer,
				function_name,
				False,
			)
		CompilerTypedStringInterpolationPartsExpr(parts, _, _, _):
			compiler_typed_interpolation_parts_have_non_tail_recursive_call(parts, function_name)
		_:
			False


pure func compiler_typed_expr_has_non_tail_recursive_call(
	expr: CompilerTypedExpr,
	function_name: String,
) -> Bool:
	compiler_typed_expr_has_non_tail_recursive_call_inner(expr, function_name, True)


private pure func compiler_append_pure_lambda_impure_call_names(
	names: List[String],
	extra: List[String],
) -> List[String]:
	compiler_append_impure_call_names(names, extra)


private pure func compiler_typed_expr_list_pure_lambda_impure_call_names(
	exprs: List[CompilerTypedExpr],
) -> List[String]:
	var result: List[String] = []

	for expr in exprs:
		result = compiler_append_pure_lambda_impure_call_names(
			result,
			compiler_typed_expr_pure_lambda_impure_call_names(expr),
		)

	result


private pure func compiler_typed_dict_entries_pure_lambda_impure_call_names(
	entries: List[CompilerTypedDictEntry],
) -> List[String]:
	var result: List[String] = []

	for entry in entries:
		result = compiler_append_pure_lambda_impure_call_names(
			result,
			compiler_typed_expr_pure_lambda_impure_call_names(entry.key),
		)
		result = compiler_append_pure_lambda_impure_call_names(
			result,
			compiler_typed_expr_pure_lambda_impure_call_names(entry.value),
		)

	result


private pure func compiler_typed_record_fields_pure_lambda_impure_call_names(
	fields: List[CompilerTypedRecordField],
) -> List[String]:
	var result: List[String] = []

	for field in fields:
		result = compiler_append_pure_lambda_impure_call_names(
			result,
			compiler_typed_expr_pure_lambda_impure_call_names(field.value),
		)

	result


private pure func compiler_typed_interpolation_parts_pure_lambda_impure_call_names(
	parts: List[CompilerTypedStringInterpolationPart],
) -> List[String]:
	var result: List[String] = []

	for part in parts:
		match part:
			CompilerTypedInterpolationLiteral(_):
				void
			CompilerTypedInterpolationExpr(expr):
				result = compiler_append_pure_lambda_impure_call_names(
					result,
					compiler_typed_expr_pure_lambda_impure_call_names(expr),
				)

	result


private pure func compiler_typed_match_cases_pure_lambda_impure_call_names(
	cases: List[CompilerTypedMatchCase],
) -> List[String]:
	var result: List[String] = []

	for case in cases:
		result = compiler_append_pure_lambda_impure_call_names(
			result,
			compiler_typed_expr_pure_lambda_impure_call_names(case.body),
		)

	result


pure func compiler_typed_expr_pure_lambda_impure_call_names(
	expr: CompilerTypedExpr,
) -> List[String]:
	match expr:
		CompilerTypedUnaryExpr(_, inner, _, _):
			compiler_typed_expr_pure_lambda_impure_call_names(inner)
		CompilerTypedBinaryExpr(_, left, right, _, _):
			compiler_append_pure_lambda_impure_call_names(
				compiler_typed_expr_pure_lambda_impure_call_names(left),
				compiler_typed_expr_pure_lambda_impure_call_names(right),
			)
		CompilerTypedLogicalExpr(_, left, right, _, _):
			compiler_append_pure_lambda_impure_call_names(
				compiler_typed_expr_pure_lambda_impure_call_names(left),
				compiler_typed_expr_pure_lambda_impure_call_names(right),
			)
		CompilerTypedCallExpr(callee, args, _, _):
			compiler_append_pure_lambda_impure_call_names(
				compiler_typed_expr_pure_lambda_impure_call_names(callee),
				compiler_typed_expr_list_pure_lambda_impure_call_names(args),
			)
		CompilerTypedTupleExpr(items, _, _):
			compiler_typed_expr_list_pure_lambda_impure_call_names(items)
		CompilerTypedTupleDestructExpr(_, value, _, _):
			compiler_typed_expr_pure_lambda_impure_call_names(value)
		CompilerTypedAssignExpr(_, _, value, _, _):
			compiler_typed_expr_pure_lambda_impure_call_names(value)
		CompilerTypedSubscriptExpr(receiver, indices, _, _):
			compiler_append_pure_lambda_impure_call_names(
				compiler_typed_expr_pure_lambda_impure_call_names(receiver),
				compiler_typed_expr_list_pure_lambda_impure_call_names(indices),
			)
		CompilerTypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
			with_indices = compiler_append_pure_lambda_impure_call_names(
				compiler_typed_expr_pure_lambda_impure_call_names(receiver),
				compiler_typed_expr_list_pure_lambda_impure_call_names(indices),
			)
			compiler_append_pure_lambda_impure_call_names(
				with_indices,
				compiler_typed_expr_pure_lambda_impure_call_names(value),
			)
		CompilerTypedListExpr(items, _, _):
			compiler_typed_expr_list_pure_lambda_impure_call_names(items)
		CompilerTypedVectorExpr(items, _, _):
			compiler_typed_expr_list_pure_lambda_impure_call_names(items)
		CompilerTypedDictExpr(entries, _, _):
			compiler_typed_dict_entries_pure_lambda_impure_call_names(entries)
		CompilerTypedRecordExpr(fields, _, _):
			compiler_typed_record_fields_pure_lambda_impure_call_names(fields)
		CompilerTypedRecordUpdateExpr(base, fields, _, _):
			compiler_append_pure_lambda_impure_call_names(
				compiler_typed_expr_pure_lambda_impure_call_names(base),
				compiler_typed_record_fields_pure_lambda_impure_call_names(fields),
			)
		CompilerTypedFieldAccessExpr(receiver, _, _, _):
			compiler_typed_expr_pure_lambda_impure_call_names(receiver)
		CompilerTypedLambdaExpr(is_pure, _, _, body, _, _):
			if is_pure:
				compiler_typed_expr_impure_call_names(body)
			else:
				compiler_typed_expr_pure_lambda_impure_call_names(body)
		CompilerTypedRangeExpr(start_expr, end_expr, _, _):
			compiler_append_pure_lambda_impure_call_names(
				compiler_typed_expr_pure_lambda_impure_call_names(start_expr),
				compiler_typed_expr_pure_lambda_impure_call_names(end_expr),
			)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			with_then = compiler_append_pure_lambda_impure_call_names(
				compiler_typed_expr_pure_lambda_impure_call_names(condition),
				compiler_typed_expr_pure_lambda_impure_call_names(then_branch),
			)
			match else_branch:
				Some(branch):
					compiler_append_pure_lambda_impure_call_names(
						with_then,
						compiler_typed_expr_pure_lambda_impure_call_names(branch),
					)
				None:
					with_then
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			compiler_append_pure_lambda_impure_call_names(
				compiler_typed_expr_pure_lambda_impure_call_names(scrutinee),
				compiler_typed_match_cases_pure_lambda_impure_call_names(cases),
			)
		CompilerTypedWhileExpr(condition, body, _, _):
			compiler_append_pure_lambda_impure_call_names(
				compiler_typed_expr_pure_lambda_impure_call_names(condition),
				compiler_typed_expr_pure_lambda_impure_call_names(body),
			)
		CompilerTypedForExpr(_, iterable, body, _, _):
			compiler_append_pure_lambda_impure_call_names(
				compiler_typed_expr_pure_lambda_impure_call_names(iterable),
				compiler_typed_expr_pure_lambda_impure_call_names(body),
			)
		CompilerTypedAscriptionExpr(inner, _, _, _):
			compiler_typed_expr_pure_lambda_impure_call_names(inner)
		CompilerTypedBlockExpr(items, _, _):
			compiler_typed_expr_list_pure_lambda_impure_call_names(items)
		CompilerTypedDebugBlockExpr(body, _, _):
			compiler_typed_expr_pure_lambda_impure_call_names(body)
		CompilerTypedVarDeclExpr(payload, _):
			compiler_typed_expr_pure_lambda_impure_call_names(payload.initializer)
		CompilerTypedStringInterpolationPartsExpr(parts, _, _, _):
			compiler_typed_interpolation_parts_pure_lambda_impure_call_names(parts)
		_:
			[]


private pure func compiler_typed_expr_list_debug_block_impure_call_names(
	exprs: List[CompilerTypedExpr],
) -> List[String]:
	var result: List[String] = []

	for expr in exprs:
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_debug_block_impure_call_names(expr),
		)

	result


private pure func compiler_typed_dict_entries_debug_block_impure_call_names(
	entries: List[CompilerTypedDictEntry],
) -> List[String]:
	var result: List[String] = []

	for entry in entries:
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_debug_block_impure_call_names(entry.key),
		)
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_debug_block_impure_call_names(entry.value),
		)

	result


private pure func compiler_typed_record_fields_debug_block_impure_call_names(
	fields: List[CompilerTypedRecordField],
) -> List[String]:
	var result: List[String] = []

	for field in fields:
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_debug_block_impure_call_names(field.value),
		)

	result


private pure func compiler_typed_match_cases_debug_block_impure_call_names(
	cases: List[CompilerTypedMatchCase],
) -> List[String]:
	var result: List[String] = []

	for case in cases:
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_debug_block_impure_call_names(case.body),
		)

	result


pure func compiler_typed_expr_debug_block_impure_call_names(
	expr: CompilerTypedExpr,
) -> List[String]:
	match expr:
		CompilerTypedUnaryExpr(_, inner, _, _):
			compiler_typed_expr_debug_block_impure_call_names(inner)
		CompilerTypedBinaryExpr(_, left, right, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(left),
				compiler_typed_expr_debug_block_impure_call_names(right),
			)
		CompilerTypedLogicalExpr(_, left, right, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(left),
				compiler_typed_expr_debug_block_impure_call_names(right),
			)
		CompilerTypedCallExpr(callee, args, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(callee),
				compiler_typed_expr_list_debug_block_impure_call_names(args),
			)
		CompilerTypedTupleExpr(items, _, _):
			compiler_typed_expr_list_debug_block_impure_call_names(items)
		CompilerTypedTupleDestructExpr(_, value, _, _):
			compiler_typed_expr_debug_block_impure_call_names(value)
		CompilerTypedAssignExpr(_, _, value, _, _):
			compiler_typed_expr_debug_block_impure_call_names(value)
		CompilerTypedSubscriptExpr(receiver, indices, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(receiver),
				compiler_typed_expr_list_debug_block_impure_call_names(indices),
			)
		CompilerTypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
			with_indices = compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(receiver),
				compiler_typed_expr_list_debug_block_impure_call_names(indices),
			)
			compiler_append_impure_call_names(
				with_indices,
				compiler_typed_expr_debug_block_impure_call_names(value),
			)
		CompilerTypedListExpr(items, _, _):
			compiler_typed_expr_list_debug_block_impure_call_names(items)
		CompilerTypedVectorExpr(items, _, _):
			compiler_typed_expr_list_debug_block_impure_call_names(items)
		CompilerTypedDictExpr(entries, _, _):
			compiler_typed_dict_entries_debug_block_impure_call_names(entries)
		CompilerTypedRecordExpr(fields, _, _):
			compiler_typed_record_fields_debug_block_impure_call_names(fields)
		CompilerTypedRecordUpdateExpr(base, fields, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(base),
				compiler_typed_record_fields_debug_block_impure_call_names(fields),
			)
		CompilerTypedFieldAccessExpr(receiver, _, _, _):
			compiler_typed_expr_debug_block_impure_call_names(receiver)
		CompilerTypedLambdaExpr(_, _, _, body, _, _):
			compiler_typed_expr_debug_block_impure_call_names(body)
		CompilerTypedRangeExpr(start_expr, end_expr, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(start_expr),
				compiler_typed_expr_debug_block_impure_call_names(end_expr),
			)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			with_then = compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(condition),
				compiler_typed_expr_debug_block_impure_call_names(then_branch),
			)
			match else_branch:
				Some(branch):
					compiler_append_impure_call_names(
						with_then,
						compiler_typed_expr_debug_block_impure_call_names(branch),
					)
				None:
					with_then
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(scrutinee),
				compiler_typed_match_cases_debug_block_impure_call_names(cases),
			)
		CompilerTypedWhileExpr(condition, body, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(condition),
				compiler_typed_expr_debug_block_impure_call_names(body),
			)
		CompilerTypedForExpr(_, iterable, body, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(iterable),
				compiler_typed_expr_debug_block_impure_call_names(body),
			)
		CompilerTypedAscriptionExpr(inner, _, _, _):
			compiler_typed_expr_debug_block_impure_call_names(inner)
		CompilerTypedBlockExpr(items, _, _):
			compiler_typed_expr_list_debug_block_impure_call_names(items)
		CompilerTypedDebugBlockExpr(body, _, _):
			compiler_typed_expr_impure_call_names(body)
		CompilerTypedVarDeclExpr(payload, _):
			compiler_typed_expr_debug_block_impure_call_names(payload.initializer)
		_:
			[]


private pure func compiler_typed_expr_list_has_debug_block_assignment(
	exprs: List[CompilerTypedExpr],
) -> Bool:
	var found: Bool = False

	for expr in exprs:
		if compiler_typed_expr_has_debug_block_assignment(expr):
			found = True
			break

	found


private pure func compiler_typed_expr_has_assignment_inside_debug_block(
	expr: CompilerTypedExpr,
) -> Bool:
	match expr:
		CompilerTypedAssignExpr(_, _, _, _, _):
			True
		CompilerTypedSubscriptAssignExpr(_, _, _, _, _, _):
			True
		CompilerTypedTupleDestructExpr(_, _, _, _):
			True
		CompilerTypedVarDeclExpr(_, _):
			True
		CompilerTypedUnaryExpr(_, inner, _, _):
			compiler_typed_expr_has_assignment_inside_debug_block(inner)
		CompilerTypedBinaryExpr(_, left, right, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(left)
				or compiler_typed_expr_has_assignment_inside_debug_block(right)
			)
		CompilerTypedLogicalExpr(_, left, right, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(left)
				or compiler_typed_expr_has_assignment_inside_debug_block(right)
			)
		CompilerTypedCallExpr(callee, args, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(callee)
				or compiler_typed_expr_list_has_assignment_inside_debug_block(args)
			)
		CompilerTypedTupleExpr(items, _, _):
			compiler_typed_expr_list_has_assignment_inside_debug_block(items)
		CompilerTypedListExpr(items, _, _):
			compiler_typed_expr_list_has_assignment_inside_debug_block(items)
		CompilerTypedVectorExpr(items, _, _):
			compiler_typed_expr_list_has_assignment_inside_debug_block(items)
		CompilerTypedDictExpr(entries, _, _):
			compiler_typed_dict_entries_have_assignment_inside_debug_block(entries)
		CompilerTypedRecordExpr(fields, _, _):
			compiler_typed_record_fields_have_assignment_inside_debug_block(fields)
		CompilerTypedRecordUpdateExpr(base, fields, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(base)
				or compiler_typed_record_fields_have_assignment_inside_debug_block(fields)
			)
		CompilerTypedFieldAccessExpr(receiver, _, _, _):
			compiler_typed_expr_has_assignment_inside_debug_block(receiver)
		CompilerTypedSubscriptExpr(receiver, indices, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(receiver)
				or compiler_typed_expr_list_has_assignment_inside_debug_block(indices)
			)
		CompilerTypedLambdaExpr(_, _, _, _, _, _):
			False
		CompilerTypedBlockExpr(items, _, _):
			compiler_typed_expr_list_has_assignment_inside_debug_block(items)
		CompilerTypedDebugBlockExpr(body, _, _):
			compiler_typed_expr_has_assignment_inside_debug_block(body)
		CompilerTypedAscriptionExpr(inner, _, _, _):
			compiler_typed_expr_has_assignment_inside_debug_block(inner)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			if (
				compiler_typed_expr_has_assignment_inside_debug_block(condition)
				or compiler_typed_expr_has_assignment_inside_debug_block(then_branch)
			):
				True
			else:
				match else_branch:
					Some(branch):
						compiler_typed_expr_has_assignment_inside_debug_block(branch)
					None:
						False
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(scrutinee)
				or compiler_typed_match_cases_have_assignment_inside_debug_block(cases)
			)
		CompilerTypedWhileExpr(condition, body, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(condition)
				or compiler_typed_expr_has_assignment_inside_debug_block(body)
			)
		CompilerTypedForExpr(_, iterable, body, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(iterable)
				or compiler_typed_expr_has_assignment_inside_debug_block(body)
			)
		CompilerTypedStringInterpolationPartsExpr(parts, _, _, _):
			compiler_typed_interpolation_parts_have_assignment_inside_debug_block(parts)
		_:
			False


private pure func compiler_typed_expr_list_has_assignment_inside_debug_block(
	exprs: List[CompilerTypedExpr],
) -> Bool:
	var found: Bool = False

	for expr in exprs:
		if compiler_typed_expr_has_assignment_inside_debug_block(expr):
			found = True
			break

	found


private pure func compiler_typed_dict_entries_have_assignment_inside_debug_block(
	entries: List[CompilerTypedDictEntry],
) -> Bool:
	var found: Bool = False

	for entry in entries:
		if (
			compiler_typed_expr_has_assignment_inside_debug_block(entry.key)
			or compiler_typed_expr_has_assignment_inside_debug_block(entry.value)
		):
			found = True
			break

	found


private pure func compiler_typed_record_fields_have_assignment_inside_debug_block(
	fields: List[CompilerTypedRecordField],
) -> Bool:
	var found: Bool = False

	for field in fields:
		if compiler_typed_expr_has_assignment_inside_debug_block(field.value):
			found = True
			break

	found


private pure func compiler_typed_interpolation_parts_have_assignment_inside_debug_block(
	parts: List[CompilerTypedStringInterpolationPart],
) -> Bool:
	var found: Bool = False

	for part in parts:
		match part:
			CompilerTypedInterpolationLiteral(_):
				void
			CompilerTypedInterpolationExpr(expr):
				if compiler_typed_expr_has_assignment_inside_debug_block(expr):
					found = True
					break

	found


private pure func compiler_typed_match_cases_have_assignment_inside_debug_block(
	cases: List[CompilerTypedMatchCase],
) -> Bool:
	var found: Bool = False

	for case in cases:
		if compiler_typed_expr_has_assignment_inside_debug_block(case.body):
			found = True
			break

	found


pure func compiler_typed_expr_has_debug_block_assignment(expr: CompilerTypedExpr) -> Bool:
	match expr:
		CompilerTypedDebugBlockExpr(body, _, _):
			compiler_typed_expr_has_assignment_inside_debug_block(body)
		CompilerTypedLambdaExpr(_, _, _, body, _, _):
			compiler_typed_expr_has_debug_block_assignment(body)
		CompilerTypedBlockExpr(items, _, _):
			compiler_typed_expr_list_has_debug_block_assignment(items)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			if (
				compiler_typed_expr_has_debug_block_assignment(condition)
				or compiler_typed_expr_has_debug_block_assignment(then_branch)
			):
				True
			else:
				match else_branch:
					Some(branch):
						compiler_typed_expr_has_debug_block_assignment(branch)
					None:
						False
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			(
				compiler_typed_expr_has_debug_block_assignment(scrutinee)
				or compiler_typed_match_cases_have_debug_block_assignment(cases)
			)
		CompilerTypedWhileExpr(condition, body, _, _):
			(
				compiler_typed_expr_has_debug_block_assignment(condition)
				or compiler_typed_expr_has_debug_block_assignment(body)
			)
		CompilerTypedForExpr(_, iterable, body, _, _):
			(
				compiler_typed_expr_has_debug_block_assignment(iterable)
				or compiler_typed_expr_has_debug_block_assignment(body)
			)
		_:
			False


private pure func compiler_typed_match_cases_have_debug_block_assignment(
	cases: List[CompilerTypedMatchCase],
) -> Bool:
	var found: Bool = False

	for case in cases:
		if compiler_typed_expr_has_debug_block_assignment(case.body):
			found = True
			break

	found


pure func compiler_typed_expr_var_initializer(
	expr: CompilerTypedExpr,
) -> Option[CompilerTypedExpr]:
	match expr:
		CompilerTypedVarDeclExpr(payload, _):
			Some(payload.initializer)
		_:
			None


pure func compiler_typed_expr_var_initializer_widening(
	expr: CompilerTypedExpr,
) -> CompilerTypeWideningDecision:
	match expr:
		CompilerTypedVarDeclExpr(payload, _):
			compiler_typed_expr_widening(payload.initializer)
		_:
			CompilerTypeKeep(compiler_type_void())


pure func compiler_typed_expr_binary_left_widening(
	expr: CompilerTypedExpr,
) -> CompilerTypeWideningDecision:
	match expr:
		CompilerTypedBinaryExpr(_, left, _, _, _):
			compiler_typed_expr_widening(left)
		_:
			CompilerTypeKeep(compiler_type_void())


pure func compiler_typed_expr_binary_right_widening(
	expr: CompilerTypedExpr,
) -> CompilerTypeWideningDecision:
	match expr:
		CompilerTypedBinaryExpr(_, _, right, _, _):
			compiler_typed_expr_widening(right)
		_:
			CompilerTypeKeep(compiler_type_void())


pure func compiler_typed_expr_call_arg_widening(
	expr: CompilerTypedExpr,
	index: Int,
) -> CompilerTypeWideningDecision:
	match expr:
		CompilerTypedCallExpr(_, args, _, _):
			match args.get(index):
				Some(arg):
					compiler_typed_expr_widening(arg)
				None:
					CompilerTypeKeep(compiler_type_void())
		_:
			CompilerTypeKeep(compiler_type_void())


pure func compiler_typed_expr_list_item_widening(
	expr: CompilerTypedExpr,
	index: Int,
) -> CompilerTypeWideningDecision:
	match expr:
		CompilerTypedListExpr(items, _, _):
			match items.get(index):
				Some(item):
					compiler_typed_expr_widening(item)
				None:
					CompilerTypeKeep(compiler_type_void())
		_:
			CompilerTypeKeep(compiler_type_void())


pure func compiler_typed_expr_vector_item_widening(
	expr: CompilerTypedExpr,
	index: Int,
) -> CompilerTypeWideningDecision:
	match expr:
		CompilerTypedVectorExpr(items, _, _):
			match items.get(index):
				Some(item):
					compiler_typed_expr_widening(item)
				None:
					CompilerTypeKeep(compiler_type_void())
		_:
			CompilerTypeKeep(compiler_type_void())


pure func compiler_typed_expr_dict_key_widening(
	expr: CompilerTypedExpr,
	index: Int,
) -> CompilerTypeWideningDecision:
	match expr:
		CompilerTypedDictExpr(entries, _, _):
			match entries.get(index):
				Some(entry):
					compiler_typed_expr_widening(entry.key)
				None:
					CompilerTypeKeep(compiler_type_void())
		_:
			CompilerTypeKeep(compiler_type_void())


pure func compiler_typed_expr_dict_value_widening(
	expr: CompilerTypedExpr,
	index: Int,
) -> CompilerTypeWideningDecision:
	match expr:
		CompilerTypedDictExpr(entries, _, _):
			match entries.get(index):
				Some(entry):
					compiler_typed_expr_widening(entry.value)
				None:
					CompilerTypeKeep(compiler_type_void())
		_:
			CompilerTypeKeep(compiler_type_void())


private pure func compiler_typed_record_field_widening(
	fields: List[CompilerTypedRecordField],
	field_name: String,
) -> CompilerTypeWideningDecision:
	var result: CompilerTypeWideningDecision = CompilerTypeKeep(compiler_type_void())
	var index: Int = 0
	var found: Bool = False

	while index < fields.length() and not found:
		match fields.get(index):
			Some(field):
				if field.name.text == field_name:
					result = compiler_typed_expr_widening(field.value)
					found = True
			None:
				void

		index += 1

	result


pure func compiler_typed_expr_record_field_widening(
	expr: CompilerTypedExpr,
	field_name: String,
) -> CompilerTypeWideningDecision:
	match expr:
		CompilerTypedRecordExpr(fields, _, _):
			compiler_typed_record_field_widening(fields, field_name)
		CompilerTypedRecordUpdateExpr(_, fields, _, _):
			compiler_typed_record_field_widening(fields, field_name)
		_:
			CompilerTypeKeep(compiler_type_void())


pure func compiler_typed_expr_field_access_receiver_type(
	expr: CompilerTypedExpr,
) -> Option[CompilerType]:
	match expr:
		CompilerTypedFieldAccessExpr(receiver, _, _, _):
			Some(compiler_typed_expr_semantic_type(receiver))
		_:
			None


private pure func compiler_infer_result(
	context: CompilerInferContext,
	expr: CompilerTypedExpr,
) -> CompilerInferResult:
	{
		context = context,
		expr = expr
	}


private pure func compiler_infer_error(
	context: CompilerInferContext,
	message: String,
) -> CompilerInferContext:
	compiler_infer_context_with_state(
		context,
		compiler_typecheck_state_add_error(context.state, message),
	)


private pure func compiler_checked_type(
	context: CompilerInferContext,
	typ: CompilerType,
) -> CompilerCheckedType:
	{
		context = compiler_infer_context_copy(context),
		typ = compiler_type_copy(typ)
	}


private pure func compiler_binary_op_symbol(op: ParsedBinaryOp) -> String:
	match op:
		ParsedAddOp:
			"+"
		ParsedSubtractOp:
			"-"
		ParsedMultiplyOp:
			"*"
		ParsedDivideOp:
			"/"
		ParsedModuloOp:
			"%"
		ParsedEqualOp:
			"=="
		ParsedNotEqualOp:
			"!="
		ParsedLessOp:
			"<"
		ParsedLessEqualOp:
			"<="
		ParsedGreaterOp:
			">"
		ParsedGreaterEqualOp:
			">="


private pure func compiler_is_arithmetic_binary_op(op: ParsedBinaryOp) -> Bool:
	match op:
		ParsedAddOp:
			True
		ParsedSubtractOp:
			True
		ParsedMultiplyOp:
			True
		ParsedDivideOp:
			True
		ParsedModuloOp:
			True
		_:
			False


private pure func compiler_is_comparison_binary_op(op: ParsedBinaryOp) -> Bool:
	match op:
		ParsedLessOp:
			True
		ParsedLessEqualOp:
			True
		ParsedGreaterOp:
			True
		ParsedGreaterEqualOp:
			True
		_:
			False


private pure func compiler_is_equality_binary_op(op: ParsedBinaryOp) -> Bool:
	match op:
		ParsedEqualOp:
			True
		ParsedNotEqualOp:
			True
		_:
			False


private pure func compiler_is_add_binary_op(op: ParsedBinaryOp) -> Bool:
	match op:
		ParsedAddOp:
			True
		_:
			False


private pure func compiler_is_modulo_binary_op(op: ParsedBinaryOp) -> Bool:
	match op:
		ParsedModuloOp:
			True
		_:
			False


private pure func compiler_named_value_type_is(
	typ: CompilerType,
	name: String,
) -> Bool:
	match typ:
		CompilerNamedType(type_name, args):
			type_name == name and args.length() == 0
		_:
			False


private pure func compiler_is_fixed_type(typ: CompilerType) -> Bool:
	compiler_named_value_type_is(typ, "Fixed")


private pure func compiler_is_orderable_primitive_type(typ: CompilerType) -> Bool:
	(
		compiler_named_value_type_is(typ, "Int")
		or compiler_named_value_type_is(typ, "Float")
		or compiler_named_value_type_is(typ, "String")
		or compiler_named_value_type_is(typ, "Char")
		or compiler_is_fixed_type(typ)
		or compiler_is_any_float_type(typ)
		or compiler_is_any_integer_type(typ)
	)


private pure func compiler_is_equality_primitive_type(typ: CompilerType) -> Bool:
	(
		compiler_is_orderable_primitive_type(typ)
		or compiler_named_value_type_is(typ, "Bool")
	)


private pure func compiler_arithmetic_result_type(
	op: ParsedBinaryOp,
	left_type: CompilerType,
	right_type: CompilerType,
) -> Option[CompilerType]:
	if compiler_named_value_type_is(left_type, "Int") and compiler_named_value_type_is(right_type, "Int"):
		Some(compiler_type_int())
	else if compiler_named_value_type_is(left_type, "Float") and compiler_named_value_type_is(right_type, "Float"):
		Some(compiler_type_float())
	else if compiler_is_fixed_type(left_type) and compiler_is_fixed_type(right_type) and not compiler_is_modulo_binary_op(op):
		Some(CompilerNamedType("Fixed", []))
	else if compiler_is_add_binary_op(op) and compiler_named_value_type_is(left_type, "String") and compiler_named_value_type_is(right_type, "String"):
		Some(compiler_type_string())
	else if compiler_is_any_float_type(left_type) and compiler_types_equal(left_type, right_type):
		Some(compiler_type_copy(left_type))
	else if compiler_is_any_integer_type(left_type) and compiler_types_equal(left_type, right_type):
		Some(compiler_type_copy(left_type))
	else:
		None


private pure func compiler_check_arithmetic_binary_op(
	context: CompilerInferContext,
	op: ParsedBinaryOp,
	left_type: CompilerType,
	right_type: CompilerType,
) -> CompilerCheckedType:
	match compiler_arithmetic_result_type(op, left_type, right_type):
		Some(result_type):
			compiler_checked_type(context, result_type)
		None:
			next = compiler_infer_error(
				context,
				"Cannot apply "
					+ compiler_binary_op_symbol(op)
					+ " to "
					+ compiler_type_to_string(left_type)
					+ " and "
					+ compiler_type_to_string(right_type),
			)
			compiler_checked_type(next, compiler_type_void())


private pure func compiler_check_comparison_binary_op(
	context: CompilerInferContext,
	left_type: CompilerType,
	right_type: CompilerType,
) -> CompilerCheckedType:
	if (
		compiler_types_equal(left_type, right_type)
		and compiler_is_orderable_primitive_type(left_type)
	):
		compiler_checked_type(context, compiler_type_bool())
	else:
		next = compiler_infer_error(
			context,
			"Comparison requires matching types that implement Orderable, got "
				+ compiler_type_to_string(left_type)
				+ " and "
				+ compiler_type_to_string(right_type),
		)
		compiler_checked_type(next, compiler_type_void())


private pure func compiler_check_equality_binary_op(
	context: CompilerInferContext,
	left_type: CompilerType,
	right_type: CompilerType,
) -> CompilerCheckedType:
	if (
		compiler_types_equal(left_type, right_type)
		and compiler_is_equality_primitive_type(left_type)
	):
		compiler_checked_type(context, compiler_type_bool())
	else:
		next = compiler_infer_error(
			context,
			"Equality comparison requires compatible types, got "
				+ compiler_type_to_string(left_type)
				+ " and "
				+ compiler_type_to_string(right_type),
		)
		compiler_checked_type(next, compiler_type_void())


private pure func compiler_check_binary_op(
	context: CompilerInferContext,
	op: ParsedBinaryOp,
	left_type: CompilerType,
	right_type: CompilerType,
) -> CompilerCheckedType:
	if compiler_is_arithmetic_binary_op(op):
		compiler_check_arithmetic_binary_op(context, op, left_type, right_type)
	else if compiler_is_comparison_binary_op(op):
		compiler_check_comparison_binary_op(context, left_type, right_type)
	else if compiler_is_equality_binary_op(op):
		compiler_check_equality_binary_op(context, left_type, right_type)
	else:
		next = compiler_infer_error(context, "Unsupported binary operator")
		compiler_checked_type(next, compiler_type_void())


private pure func compiler_mod_result_type(
	op: ParsedBinaryOp,
	left_semantic_type: CompilerType,
	right_semantic_type: CompilerType,
	result_type: CompilerType,
) -> CompilerType:
	if not compiler_is_modulo_binary_op(op):
		compiler_type_copy(result_type)
	else:
		lhs_non_negative = match left_semantic_type:
			CompilerRangeType(_):
				True
			CompilerConstIntType(value):
				value >= 0
			_:
				False

		if not lhs_non_negative:
			compiler_type_copy(result_type)
		else:
			match right_semantic_type:
				CompilerConstIntType(bound):
					if bound > 0:
						CompilerRangeType(CompilerConstIntType(bound))
					else:
						compiler_type_copy(result_type)
				_:
					compiler_type_copy(result_type)


private pure func compiler_unary_operand_type(
	op: ParsedUnaryOp,
	operand_type: CompilerType,
) -> CompilerType:
	match op:
		ParsedNegateOp:
			compiler_numeric_operand_type(ParsedSubtractOp, operand_type)
		ParsedNotOp:
			compiler_type_copy(operand_type)


private pure func compiler_unary_operand_slot(
	op: ParsedUnaryOp,
	operand_type: CompilerType,
) -> CompilerValueSlot:
	match op:
		ParsedNegateOp:
			compiler_numeric_operand_slot(ParsedSubtractOp, operand_type)
		ParsedNotOp:
			compiler_keep_value_slot(operand_type)


private pure func compiler_check_unary_op(
	context: CompilerInferContext,
	op: ParsedUnaryOp,
	operand_type: CompilerType,
) -> CompilerCheckedType:
	match op:
		ParsedNegateOp:
			if compiler_named_value_type_is(operand_type, "Int"):
				compiler_checked_type(context, compiler_type_int())
			else if compiler_named_value_type_is(operand_type, "Float"):
				compiler_checked_type(context, compiler_type_float())
			else if compiler_is_any_float_type(operand_type):
				compiler_checked_type(context, operand_type)
			else if compiler_is_signed_integer_type(operand_type):
				compiler_checked_type(context, operand_type)
			else if compiler_is_unsigned_integer_type(operand_type):
				next = compiler_infer_error(
					context,
					"Cannot negate unsigned type " + compiler_type_to_string(operand_type),
				)
				compiler_checked_type(next, compiler_type_void())
			else:
				next = compiler_infer_error(
					context,
					"Negation requires numeric type, got " + compiler_type_to_string(operand_type),
				)
				compiler_checked_type(next, compiler_type_void())
		ParsedNotOp:
			if compiler_named_value_type_is(operand_type, "Bool"):
				compiler_checked_type(context, compiler_type_bool())
			else:
				next = compiler_infer_error(
					context,
					"Logical not requires Bool, got " + compiler_type_to_string(operand_type),
				)
				compiler_checked_type(next, compiler_type_void())


private pure func compiler_check_logical_op(
	context: CompilerInferContext,
	left_type: CompilerType,
	right_type: CompilerType,
) -> CompilerCheckedType:
	if compiler_named_value_type_is(left_type, "Bool") and compiler_named_value_type_is(right_type, "Bool"):
		compiler_checked_type(context, compiler_type_bool())
	else:
		next = compiler_infer_error(
			context,
			"Logical operation requires Bool operands, got "
				+ compiler_type_to_string(left_type)
				+ " and "
				+ compiler_type_to_string(right_type),
		)
		compiler_checked_type(next, compiler_type_void())


private pure func compiler_parse_int_literal(text: String) -> Int:
	text.parse_int().get_or(0)


private pure func compiler_literal_result(
	context: CompilerInferContext,
	expr: CompilerTypedExpr,
) -> CompilerInferResult:
	compiler_infer_result(context, expr)


private pure func compiler_type_can_interpolate(typ: CompilerType) -> Bool:
	if (
		compiler_named_value_type_is(typ, "Int")
		or compiler_named_value_type_is(typ, "Float")
		or compiler_named_value_type_is(typ, "Bool")
		or compiler_named_value_type_is(typ, "Char")
		or compiler_named_value_type_is(typ, "String")
		or compiler_is_any_integer_type(typ)
		or compiler_is_any_float_type(typ)
	):
		True
	else:
		match typ:
			CompilerConstIntType(_):
				True
			CompilerRangeType(_):
				True
			CompilerArrayType(_, _):
				True
			CompilerNamedType(name, _):
				name == "List" or name == "Result" or name == "Tensor" or name == "Vector" or name == "Matrix"
			_:
				False


private pure func compiler_interpolation_type_error(
	context: CompilerInferContext,
	typ: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Interpolated expression has type "
			+ compiler_type_to_string(typ)
			+ " which cannot be converted to String. Implement Stringable for this type or convert it explicitly",
	)


private pure func compiler_infer_string_interpolation_parts_result(
	context: CompilerInferContext,
	parts: List[CompilerTypedStringInterpolationPart],
) -> CompilerInferStringInterpolationPartsResult:
	{
		context = compiler_infer_context_copy(context),
		parts = parts
	}


private pure func compiler_infer_string_interpolation_parts(
	context: CompilerInferContext,
	parts: List[ParsedStringInterpolationPart],
) -> CompilerInferStringInterpolationPartsResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_parts: List[CompilerTypedStringInterpolationPart] = []

	for part in parts:
		match part:
			ParsedInterpolationLiteral(value):
				typed_parts = typed_parts.append(CompilerTypedInterpolationLiteral(value))
			ParsedInterpolationExpr(expr):
				expr_result = compiler_infer_expr(compiler_infer_without_expected(next_context), expr)
				expr_type = compiler_typed_expr_semantic_type(expr_result.expr)
				next_context = if compiler_type_can_interpolate(expr_type):
					compiler_infer_context_copy(expr_result.context)
				else:
					compiler_interpolation_type_error(expr_result.context, expr_type)
				typed_parts = typed_parts.append(CompilerTypedInterpolationExpr(expr_result.expr))

	compiler_infer_string_interpolation_parts_result(compiler_infer_without_expected(next_context), typed_parts)


private pure func compiler_infer_string_interpolation_parts_expr(
	context: CompilerInferContext,
	parts: List[ParsedStringInterpolationPart],
	is_multiline: Bool,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	parts_result = compiler_infer_string_interpolation_parts(context, parts)
	result_context = compiler_infer_context_with_state(context, parts_result.context.state)
	typed = CompilerTypedStringInterpolationPartsExpr(
		parts_result.parts,
		is_multiline,
		span,
		compiler_inferred_info(result_context, compiler_type_string()),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_infer_name_expr(
	context: CompilerInferContext,
	name: ParsedIdentifier,
) -> CompilerInferResult:
	match compiler_env_lookup(context.state.env, name.text):
		Some(symbol):
			match symbol.kind:
				CompilerVarSymbolKind(var_symbol):
					expr = CompilerTypedNameExpr(
						name,
						compiler_typed_expr_info_from_slot(
							var_symbol.source_type,
							CompilerInferredOrigin,
							compiler_unrefined_binding(),
							None,
							compiler_infer_expected_slot(context, var_symbol.var_type),
						),
					)
					compiler_infer_result(context, expr)
				CompilerFuncSymbolKind(func_symbol):
					expr = CompilerTypedNameExpr(
						name,
						compiler_typed_expr_info_from_slot(
							None,
							CompilerInferredOrigin,
							compiler_unrefined_binding(),
							Some(compiler_resolved_call_from_func_symbol(name.text, func_symbol)),
							compiler_infer_expected_slot(context, func_symbol.func_type),
						),
					)
					compiler_infer_result(context, expr)
				_:
					next = compiler_infer_error(context, "`" + name.text + "` is not a value")
					compiler_infer_result(
						next,
						CompilerTypedNameExpr(name, compiler_inferred_info(next, compiler_type_void())),
					)
		None:
			next = compiler_infer_error(context, "Unbound value `" + name.text + "`")
			compiler_infer_result(
				next,
				CompilerTypedNameExpr(name, compiler_inferred_info(next, compiler_type_void())),
			)


private pure func compiler_apply_ascription(
	context: CompilerInferContext,
	inner: CompilerTypedExpr,
	source_type: CompilerType,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	value_type = compiler_typed_expr_value_type(inner)
	next = if compiler_types_equal(value_type, source_type):
		context
	else:
		compiler_infer_error(
			context,
			"Ascribed type `"
				+ compiler_type_to_string(source_type)
				+ "` does not match value type `"
				+ compiler_type_to_string(value_type)
				+ "`",
		)

	compiler_infer_result(
		next,
		CompilerTypedAscriptionExpr(
			inner,
			source_type,
			span,
			compiler_explicit_info(source_type, source_type),
		),
	)


private pure func compiler_infer_ascription_expr(
	context: CompilerInferContext,
	inner: ParsedExpr,
	type_expr: ParsedTypeExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	source_type = compiler_type_from_parsed_type_expr(type_expr)
	inner_result = compiler_infer_expr(
		compiler_infer_with_expected_value_slot(
			context,
			source_type,
			CompilerExpectedArgumentSlot,
		),
		inner,
	)
	compiler_apply_ascription(inner_result.context, inner_result.expr, source_type, span)


private pure func compiler_infer_unary_expr(
	context: CompilerInferContext,
	op: ParsedUnaryOp,
	operand: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	operand_result = compiler_infer_expr(compiler_infer_without_expected(context), operand)
	operand_semantic_type = compiler_typed_expr_semantic_type(operand_result.expr)
	operand_slot = compiler_unary_operand_slot(op, operand_semantic_type)
	operand_value_type = compiler_widening_value_type(operand_slot)
	checked = compiler_check_unary_op(operand_result.context, op, operand_value_type)
	typed_operand = compiler_typed_expr_with_slot(operand_result.expr, operand_slot)
	typed = CompilerTypedUnaryExpr(
		op,
		typed_operand,
		span,
		compiler_inferred_info(checked.context, checked.typ),
	)

	compiler_infer_result(checked.context, typed)


private pure func compiler_infer_binary_expr(
	context: CompilerInferContext,
	op: ParsedBinaryOp,
	left: ParsedExpr,
	right: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	left_result = compiler_infer_expr(compiler_infer_without_expected(context), left)
	right_result = compiler_infer_expr(compiler_infer_without_expected(left_result.context), right)
	left_semantic_type = compiler_typed_expr_semantic_type(left_result.expr)
	right_semantic_type = compiler_typed_expr_semantic_type(right_result.expr)
	left_slot = compiler_numeric_operand_slot(op, left_semantic_type)
	right_slot = compiler_numeric_operand_slot(op, right_semantic_type)
	left_value_type = compiler_widening_value_type(left_slot)
	right_value_type = compiler_widening_value_type(right_slot)
	checked = compiler_check_binary_op(right_result.context, op, left_value_type, right_value_type)
	result_type = compiler_mod_result_type(op, left_semantic_type, right_semantic_type, checked.typ)
	typed_left = compiler_typed_expr_with_slot(left_result.expr, left_slot)
	typed_right = compiler_typed_expr_with_slot(right_result.expr, right_slot)
	typed = CompilerTypedBinaryExpr(
		op,
		typed_left,
		typed_right,
		span,
		compiler_inferred_info(checked.context, result_type),
	)

	compiler_infer_result(checked.context, typed)


private pure func compiler_infer_logical_expr(
	context: CompilerInferContext,
	op: ParsedLogicalOp,
	left: ParsedExpr,
	right: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	left_result = compiler_infer_expr(compiler_infer_without_expected(context), left)
	right_result = compiler_infer_expr(compiler_infer_without_expected(left_result.context), right)
	left_type = compiler_typed_expr_semantic_type(left_result.expr)
	right_type = compiler_typed_expr_semantic_type(right_result.expr)
	checked = compiler_check_logical_op(right_result.context, left_type, right_type)
	typed = CompilerTypedLogicalExpr(
		op,
		left_result.expr,
		right_result.expr,
		span,
		compiler_inferred_info(checked.context, checked.typ),
	)

	compiler_infer_result(checked.context, typed)


private pure func compiler_call_name(callee: CompilerTypedExpr) -> Option[String]:
	match callee:
		CompilerTypedNameExpr(name, _):
			Some(name.text)
		_:
			None


private pure func compiler_call_arity_error(
	context: CompilerInferContext,
	callee: CompilerTypedExpr,
	expected: Int,
	got: Int,
) -> CompilerInferContext:
	name_text = match compiler_call_name(callee):
		Some(name):
			" '" + name + "'"
		None:
			""
	arg_word = if expected == 1:
		" argument"
	else:
		" arguments"

	compiler_infer_error(
		context,
		"Function" + name_text + " expects " + expected.to_string() + arg_word + ", got " + got.to_string(),
	)


private pure func compiler_argument_mismatch_error(
	context: CompilerInferContext,
	callee: CompilerTypedExpr,
	index: Int,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	callee_text = match compiler_call_name(callee):
		Some(name):
			"in call to '" + name + "', "
		None:
			""

	compiler_infer_error(
		context,
		"Argument type mismatch: "
			+ callee_text
			+ "argument "
			+ (index + 1).to_string()
			+ " expected "
			+ compiler_type_to_string(expected)
			+ ", got "
			+ compiler_type_to_string(got),
	)


private pure func compiler_type_contains_type_var(typ: CompilerType) -> Bool:
	match typ:
		CompilerTypeVar(_):
			True
		CompilerNamedType(_, args):
			args.any(compiler_type_contains_type_var)
		CompilerArrayType(element, dims):
			compiler_type_contains_type_var(element) or dims.any(compiler_type_contains_type_var)
		CompilerFunctionType(_, params, return_type):
			params.any(compiler_type_contains_type_var) or compiler_type_contains_type_var(return_type)
		CompilerTupleType(elements):
			elements.any(compiler_type_contains_type_var)
		CompilerRangeType(inner):
			compiler_type_contains_type_var(inner)
		CompilerDimOpType(_, left, right):
			compiler_type_contains_type_var(left) or compiler_type_contains_type_var(right)
		_:
			False


private pure func compiler_find_type_subst(
	subst: List[CompilerTypeSubstEntry],
	name: String,
) -> Option[CompilerType]:
	var result: Option[CompilerType] = None
	var index: Int = 0

	while index < subst.length() and result == None:
		match subst.get(index):
			Some(entry):
				if entry.var_name == name:
					result = Some(entry.concrete_type)
			None:
				void

		index += 1

	result


private pure func compiler_bind_type_subst_result(
	context: CompilerInferContext,
	subst: List[CompilerTypeSubstEntry],
) -> CompilerBindTypeSubstResult:
	{
		context = compiler_infer_context_copy(context),
		subst = subst
	}


private pure func compiler_generic_actual_type(typ: CompilerType) -> CompilerType:
	compiler_default_collection_element_type(typ)


private pure func compiler_generic_conflict_error(
	context: CompilerInferContext,
	name: String,
	existing: CompilerType,
	found: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Generic type parameter "
			+ name
			+ " inferred as "
			+ compiler_type_to_string(existing)
			+ " and "
			+ compiler_type_to_string(found),
	)


private pure func compiler_bind_type_var_subst(
	context: CompilerInferContext,
	name: String,
	actual_type: CompilerType,
	subst: List[CompilerTypeSubstEntry],
) -> CompilerBindTypeSubstResult:
	bound_type = compiler_generic_actual_type(actual_type)
	match compiler_find_type_subst(subst, name):
		Some(existing):
			if compiler_types_equal(existing, bound_type):
				compiler_bind_type_subst_result(context, subst)
			else:
				compiler_bind_type_subst_result(
					compiler_generic_conflict_error(context, name, existing, bound_type),
					subst,
				)
		None:
			compiler_bind_type_subst_result(context, subst.append(compiler_type_subst_entry(name, bound_type)))


private pure func compiler_bind_type_list_subst(
	context: CompilerInferContext,
	param_types: List[CompilerType],
	actual_types: List[CompilerType],
	subst: List[CompilerTypeSubstEntry],
) -> CompilerBindTypeSubstResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var next_subst: List[CompilerTypeSubstEntry] = subst
	var index: Int = 0

	while index < param_types.length() and index < actual_types.length():
		match (param_types.get(index), actual_types.get(index)):
			(Some(param_type), Some(actual_type)):
				result = compiler_bind_type_subst(next_context, param_type, actual_type, next_subst)
				next_context = result.context
				next_subst = result.subst
			_:
				void

		index += 1

	compiler_bind_type_subst_result(next_context, next_subst)


private pure func compiler_bind_type_subst(
	context: CompilerInferContext,
	param_type: CompilerType,
	actual_type: CompilerType,
	subst: List[CompilerTypeSubstEntry],
) -> CompilerBindTypeSubstResult:
	match param_type:
		CompilerTypeVar(name):
			compiler_bind_type_var_subst(context, name, actual_type, subst)
		CompilerNamedType(param_name, param_args):
			match actual_type:
				CompilerNamedType(actual_name, actual_args):
					if param_name == actual_name and param_args.length() == actual_args.length():
						compiler_bind_type_list_subst(context, param_args, actual_args, subst)
					else:
						compiler_bind_type_subst_result(context, subst)
				_:
					compiler_bind_type_subst_result(context, subst)
		CompilerArrayType(param_element, param_dims):
			match compiler_array_type_parts(actual_type):
				Some((actual_element, actual_dims)):
					element_result = compiler_bind_type_subst(context, param_element, actual_element, subst)
					compiler_bind_type_list_subst(
						element_result.context,
						param_dims,
						actual_dims,
						element_result.subst,
					)
				None:
					compiler_bind_type_subst_result(context, subst)
		CompilerTupleType(param_elements):
			match actual_type:
				CompilerTupleType(actual_elements):
					if param_elements.length() == actual_elements.length():
						compiler_bind_type_list_subst(context, param_elements, actual_elements, subst)
					else:
						compiler_bind_type_subst_result(context, subst)
				_:
					compiler_bind_type_subst_result(context, subst)
		CompilerFunctionType(_, param_params, param_return):
			match actual_type:
				CompilerFunctionType(_, actual_params, actual_return):
					param_result = compiler_bind_type_list_subst(context, param_params, actual_params, subst)
					compiler_bind_type_subst(
						param_result.context,
						param_return,
						actual_return,
						param_result.subst,
					)
				_:
					compiler_bind_type_subst_result(context, subst)
		CompilerRangeType(param_inner):
			match actual_type:
				CompilerRangeType(actual_inner):
					compiler_bind_type_subst(context, param_inner, actual_inner, subst)
				_:
					compiler_bind_type_subst_result(context, subst)
		_:
			compiler_bind_type_subst_result(context, subst)


private pure func compiler_infer_call_args_result(
	context: CompilerInferContext,
	args: List[CompilerTypedExpr],
	subst: List[CompilerTypeSubstEntry],
) -> CompilerInferCallArgsResult:
	{
		context = compiler_infer_context_copy(context),
		args = args,
		subst = subst
	}


private pure func compiler_infer_call_args(
	context: CompilerInferContext,
	callee: CompilerTypedExpr,
	args: List[ParsedExpr],
	params: List[CompilerType],
) -> CompilerInferCallArgsResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_args: List[CompilerTypedExpr] = []
	var subst: List[CompilerTypeSubstEntry] = []
	var index: Int = 0

	while index < args.length():
		match (args.get(index), params.get(index)):
			(Some(arg), Some(raw_param_type)):
				param_type = compiler_apply_subst(subst, raw_param_type)
				is_generic_param = compiler_type_contains_type_var(raw_param_type)
				arg_context = if is_generic_param:
					compiler_infer_without_expected(next_context)
				else:
					compiler_infer_with_expected_value_slot(
						next_context,
						param_type,
						CompilerExpectedArgumentSlot,
					)
				arg_result = compiler_infer_expr(arg_context, arg)
				arg_value_type = compiler_typed_expr_value_type(arg_result.expr)
				bind_result = if is_generic_param:
					compiler_bind_type_subst(arg_result.context, raw_param_type, arg_value_type, subst)
				else:
					compiler_bind_type_subst_result(arg_result.context, subst)
				subst = bind_result.subst
				next_context = if is_generic_param:
					compiler_infer_context_copy(bind_result.context)
				else:
					if compiler_types_equal(arg_value_type, param_type):
						compiler_infer_context_copy(bind_result.context)
					else:
						compiler_argument_mismatch_error(
							bind_result.context,
							callee,
							index,
							param_type,
							arg_value_type,
						)
				typed_args = typed_args.append(arg_result.expr)
			_:
				void

		index += 1

	compiler_infer_call_args_result(compiler_infer_without_expected(next_context), typed_args, subst)


private pure func compiler_inferred_call_info(
	context: CompilerInferContext,
	semantic_type: CompilerType,
	resolved_call: Option[CompilerResolvedCallInfo],
) -> CompilerTypedExprInfo:
	compiler_typed_expr_info_from_slot(
		None,
		CompilerInferredOrigin,
		compiler_unrefined_binding(),
		resolved_call,
		compiler_infer_expected_slot(context, semantic_type),
	)


private pure func compiler_typed_module_marker_expr(
	module_ident: ParsedIdentifier,
) -> CompilerTypedExpr:
	CompilerTypedNameExpr(
		module_ident,
		compiler_typed_expr_info_from_slot(
			None,
			CompilerInferredOrigin,
			compiler_unrefined_binding(),
			None,
			compiler_keep_value_slot(CompilerNamedType("Module", [])),
		),
	)


private pure func compiler_typed_qualified_module_field_expr(
	module_ident: ParsedIdentifier,
	field: ParsedIdentifier,
	span: CompilerSourceSpan,
	field_type: CompilerType,
	resolved_call: Option[CompilerResolvedCallInfo],
) -> CompilerTypedExpr:
	CompilerTypedFieldAccessExpr(
		compiler_typed_module_marker_expr(module_ident),
		field,
		span,
		compiler_typed_expr_info_from_slot(
			None,
			CompilerInferredOrigin,
			compiler_unrefined_binding(),
			resolved_call,
			compiler_keep_value_slot(field_type),
		),
	)


private pure func compiler_infer_qualified_module_callee(
	context: CompilerInferContext,
	callee: ParsedExpr,
) -> Option[CompilerInferResult]:
	match callee:
		ParsedFieldAccessExpr(receiver, field, span):
			match receiver:
				ParsedNameExpr(module_ident):
					match compiler_typecheck_state_find_module_alias(context.state, module_ident.text):
						Some(module_path):
							match compiler_env_get_module_func_symbol(context.state.env, module_path, field.text):
								Some(func_symbol):
									typed = compiler_typed_qualified_module_field_expr(
										module_ident,
										field,
										span,
										func_symbol.func_type,
										Some(compiler_resolved_call_from_func_symbol(field.text, func_symbol)),
									)
									Some(compiler_infer_result(context, typed))
								None:
									None
						None:
							None
				_:
					None
		_:
			None


private pure func compiler_missing_qualified_module_call_result(
	context: CompilerInferContext,
	callee: ParsedExpr,
	span: CompilerSourceSpan,
) -> Option[CompilerInferResult]:
	match callee:
		ParsedFieldAccessExpr(receiver, field, field_span):
			match receiver:
				ParsedNameExpr(module_ident):
					match compiler_typecheck_state_find_module_alias(context.state, module_ident.text):
						Some(module_path):
							if compiler_env_get_module_func_symbol(context.state.env, module_path, field.text).is_some():
								None
							else:
								next = compiler_infer_error(
									context,
									"Module alias `"
										+ module_ident.text
										+ "` for module `"
										+ module_path
										+ "` has no function `"
										+ field.text
										+ "`",
								)
								typed_callee = compiler_typed_qualified_module_field_expr(
									module_ident,
									field,
									field_span,
									compiler_type_void(),
									None,
								)
								typed = CompilerTypedCallExpr(
									typed_callee,
									[],
									span,
									compiler_inferred_call_info(next, compiler_type_void(), None),
								)
								Some(compiler_infer_result(next, typed))
						None:
							None
				_:
					None
		_:
			None


private pure func compiler_bare_overload_first_arg_type(
	context: CompilerInferContext,
	args: List[ParsedExpr],
) -> Option[CompilerType]:
	match args.get(0):
		Some(first_arg):
			first_arg_result = compiler_infer_expr(compiler_infer_without_expected(context), first_arg)
			if first_arg_result.context.state.errors.length() == context.state.errors.length():
				Some(compiler_typed_expr_value_type(first_arg_result.expr))
			else:
				None
		None:
			None


private pure func compiler_infer_bare_overload_callee(
	context: CompilerInferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
) -> Option[CompilerInferResult]:
	match callee:
		ParsedNameExpr(name):
			match compiler_env_lookup(context.state.env, name.text):
				Some(_):
					None
				None:
					if compiler_env_get_overloads(context.state.env, name.text).length() == 0:
						None
					else:
						match compiler_bare_overload_first_arg_type(context, args):
							Some(first_arg_type):
								match compiler_env_resolve_overload(
									context.state.env,
									name.text,
									first_arg_type,
								):
									Some(entry):
										typed = CompilerTypedNameExpr(
											name,
											compiler_typed_expr_info_from_slot(
												None,
												CompilerInferredOrigin,
												compiler_unrefined_binding(),
												Some(compiler_resolved_call_from_overload_entry(name.text, entry)),
												compiler_keep_value_slot(entry.func_type),
											),
										)
										Some(compiler_infer_result(context, typed))
									None:
										None
							None:
								None
		_:
			None


private pure func compiler_missing_bare_overload_call_result(
	context: CompilerInferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> Option[CompilerInferResult]:
	match callee:
		ParsedNameExpr(name):
			match compiler_env_lookup(context.state.env, name.text):
				Some(_):
					None
				None:
					if compiler_env_get_overloads(context.state.env, name.text).length() == 0:
						None
					else:
						match compiler_bare_overload_first_arg_type(context, args):
							Some(first_arg_type):
								if compiler_env_resolve_overload(context.state.env, name.text, first_arg_type).is_some():
									None
								else:
									next = compiler_infer_error(
										context,
										"No overload `"
											+ name.text
											+ "` matches first argument type "
											+ compiler_type_to_string(first_arg_type),
									)
									typed_callee = CompilerTypedNameExpr(
										name,
										compiler_inferred_info(next, compiler_type_void()),
									)
									typed = CompilerTypedCallExpr(
										typed_callee,
										[],
										span,
										compiler_inferred_call_info(next, compiler_type_void(), None),
									)
									Some(compiler_infer_result(next, typed))
							None:
								None
		_:
			None


private pure func compiler_types_after_first(types: List[CompilerType]) -> List[CompilerType]:
	var result: List[CompilerType] = []
	var index: Int = 1

	while index < types.length():
		match types.get(index):
			Some(typ):
				result = result.append(typ)
			None:
				void

		index += 1

	result


private pure func compiler_infer_call_with_callee_result(
	context: CompilerInferContext,
	callee_result: CompilerInferResult,
	args: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	callee_type = compiler_typed_expr_value_type(callee_result.expr)
	resolved_call = compiler_typed_expr_resolved_call(callee_result.expr)

	match callee_type:
		CompilerFunctionType(_, params, return_type):
			if params.length() != args.length():
				next = compiler_call_arity_error(
					compiler_infer_without_expected(callee_result.context),
					callee_result.expr,
					params.length(),
					args.length(),
				)
				typed = CompilerTypedCallExpr(
					callee_result.expr,
					[],
					span,
					compiler_inferred_call_info(next, compiler_type_void(), resolved_call),
				)
				compiler_infer_result(next, typed)
			else:
				arg_result = compiler_infer_call_args(
					callee_result.context,
					callee_result.expr,
					args,
					params,
				)
				result_context = compiler_infer_context_with_state(context, arg_result.context.state)
				resolved_return_type = compiler_apply_subst(arg_result.subst, return_type)
				typed = CompilerTypedCallExpr(
					callee_result.expr,
					arg_result.args,
					span,
					compiler_inferred_call_info(result_context, resolved_return_type, resolved_call),
				)
				compiler_infer_result(result_context, typed)
		_:
			next = compiler_infer_error(
				compiler_infer_without_expected(callee_result.context),
				"Cannot call non-function type: " + compiler_type_to_string(callee_type),
			)
			typed = CompilerTypedCallExpr(
				callee_result.expr,
				[],
				span,
				compiler_inferred_call_info(next, compiler_type_void(), resolved_call),
			)
			compiler_infer_result(next, typed)


private pure func compiler_infer_ufcs_call_expr(
	context: CompilerInferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> Option[CompilerInferResult]:
	match callee:
		ParsedFieldAccessExpr(receiver, method, _):
			is_module_alias = match receiver:
				ParsedNameExpr(module_ident):
					compiler_typecheck_state_find_module_alias(context.state, module_ident.text).is_some()
				_:
					False

			if is_module_alias:
				None
			else:
				receiver_result = compiler_infer_expr(compiler_infer_without_expected(context), receiver)
				if receiver_result.context.state.errors.length() != context.state.errors.length():
					None
				else:
					receiver_type = compiler_typed_expr_value_type(receiver_result.expr)
					match compiler_env_lookup_ufcs_methods(context.state.env, method.text, receiver_type).get(0):
						Some(entry):
							callee_expr = CompilerTypedNameExpr(
								method,
								compiler_typed_expr_info_from_slot(
									None,
									CompilerInferredOrigin,
									compiler_unrefined_binding(),
									Some(compiler_resolved_call_from_overload_entry(method.text, entry)),
									compiler_keep_value_slot(entry.func_type),
								),
							)
							match entry.func_type:
								CompilerFunctionType(_, params, return_type):
									expected_arg_count = params.length() - 1
									if expected_arg_count != args.length():
										next = compiler_call_arity_error(
											compiler_infer_without_expected(receiver_result.context),
											callee_expr,
											expected_arg_count,
											args.length(),
										)
										typed = CompilerTypedCallExpr(
											callee_expr,
											[receiver_result.expr],
											span,
											compiler_inferred_call_info(
												next,
												compiler_type_void(),
												Some(compiler_resolved_call_from_overload_entry(method.text, entry)),
											),
										)
										Some(compiler_infer_result(next, typed))
									else:
										arg_result = compiler_infer_call_args(
											receiver_result.context,
											callee_expr,
											args,
											compiler_types_after_first(params),
										)
										result_context = compiler_infer_context_with_state(
											context,
											arg_result.context.state,
										)
										resolved_return_type = compiler_apply_subst(
											arg_result.subst,
											return_type,
										)
										typed = CompilerTypedCallExpr(
											callee_expr,
											[receiver_result.expr].concat(arg_result.args),
											span,
											compiler_inferred_call_info(
												result_context,
												resolved_return_type,
												Some(compiler_resolved_call_from_overload_entry(method.text, entry)),
											),
										)
										Some(compiler_infer_result(result_context, typed))
								_:
									None
						None:
							None
		_:
			None


private pure func compiler_infer_call_expr(
	context: CompilerInferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	match compiler_missing_qualified_module_call_result(
		compiler_infer_without_expected(context),
		callee,
		span,
	):
		Some(result):
			result
		None:
			match compiler_infer_bare_overload_callee(
				compiler_infer_without_expected(context),
				callee,
				args,
			):
				Some(callee_result):
					compiler_infer_call_with_callee_result(context, callee_result, args, span)
				None:
					match compiler_missing_bare_overload_call_result(
						compiler_infer_without_expected(context),
						callee,
						args,
						span,
					):
						Some(result):
							result
						None:
							match compiler_infer_ufcs_call_expr(
								compiler_infer_without_expected(context),
								callee,
								args,
								span,
							):
								Some(result):
									result
								None:
									callee_result = match compiler_infer_qualified_module_callee(
										compiler_infer_without_expected(context),
										callee,
									):
										Some(result):
											result
										None:
											compiler_infer_expr(compiler_infer_without_expected(context), callee)
									compiler_infer_call_with_callee_result(context, callee_result, args, span)


private pure func compiler_expected_function_type(
	context: CompilerInferContext,
) -> Option[(Bool, List[CompilerType], CompilerType)]:
	match context.expected_type:
		Some(CompilerFunctionType(is_pure, params, return_type)):
			Some((is_pure, params, return_type))
		_:
			None


private pure func compiler_lambda_missing_param_type_error(
	context: CompilerInferContext,
	name: String,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Cannot infer type of lambda parameter `" + name + "`; add a type annotation",
	)


private pure func compiler_lambda_return_mismatch_error(
	context: CompilerInferContext,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Lambda body type mismatch: expected "
			+ compiler_type_to_string(expected)
			+ ", got "
			+ compiler_type_to_string(got),
	)


private pure func compiler_name_list_add_unique(names: List[String], name: String) -> List[String]:
	if names.contains(name):
		names
	else:
		names.append(name)


private pure func compiler_name_lists_concat_unique(
	names: List[String],
	extra: List[String],
) -> List[String]:
	var result = names

	for name in extra:
		result = compiler_name_list_add_unique(result, name)

	result


private pure func compiler_pattern_bound_names(pattern: ParsedPattern) -> List[String]:
	match pattern:
		ParsedNamePattern(name):
			[name.text]
		ParsedConstructorPattern(_, fields, _):
			var result: List[String] = []

			for field in fields:
				result = compiler_name_lists_concat_unique(result, compiler_pattern_bound_names(field))

			result
		ParsedQualifiedConstructorPattern(_, _, fields, _):
			var result: List[String] = []

			for field in fields:
				result = compiler_name_lists_concat_unique(result, compiler_pattern_bound_names(field))

			result
		ParsedTuplePattern(items, _):
			var result: List[String] = []

			for item in items:
				result = compiler_name_lists_concat_unique(result, compiler_pattern_bound_names(item))

			result
		ParsedListPattern(items, spread, _):
			var result: List[String] = []

			for item in items:
				result = compiler_name_lists_concat_unique(result, compiler_pattern_bound_names(item))

			match spread:
				Some(ParsedListSpreadName(name)):
					compiler_name_list_add_unique(result, name.text)
				Some(ParsedListSpreadWildcard(_)):
					result
				None:
					result
		ParsedOrPattern(options, _):
			var result: List[String] = []

			for option in options:
				result = compiler_name_lists_concat_unique(result, compiler_pattern_bound_names(option))

			result
		_:
			[]


private pure func compiler_free_var_refs_in_interpolation_parts(
	env: CompilerEnv,
	bound: List[String],
	parts: List[ParsedStringInterpolationPart],
) -> List[String]:
	var result: List[String] = []

	for part in parts:
		match part:
			ParsedInterpolationLiteral(_):
				void
			ParsedInterpolationExpr(expr):
				result = compiler_name_lists_concat_unique(
					result,
					compiler_free_var_refs_in_expr(env, bound, expr),
				)

	result


private pure func compiler_free_var_refs_in_exprs(
	env: CompilerEnv,
	bound: List[String],
	exprs: List[ParsedExpr],
) -> List[String]:
	var result: List[String] = []

	for expr in exprs:
		result = compiler_name_lists_concat_unique(
			result,
			compiler_free_var_refs_in_expr(env, bound, expr),
		)

	result


private pure func compiler_free_var_refs_in_dict_entries(
	env: CompilerEnv,
	bound: List[String],
	entries: List[ParsedDictEntry],
) -> List[String]:
	var result: List[String] = []

	for entry in entries:
		result = compiler_name_lists_concat_unique(
			result,
			compiler_free_var_refs_in_expr(env, bound, entry.key),
		)
		result = compiler_name_lists_concat_unique(
			result,
			compiler_free_var_refs_in_expr(env, bound, entry.value),
		)

	result


private pure func compiler_free_var_refs_in_record_fields(
	env: CompilerEnv,
	bound: List[String],
	fields: List[ParsedRecordExprField],
) -> List[String]:
	var result: List[String] = []

	for field in fields:
		result = compiler_name_lists_concat_unique(
			result,
			compiler_free_var_refs_in_expr(env, bound, field.value),
		)

	result


private pure func compiler_free_var_refs_in_match_cases(
	env: CompilerEnv,
	bound: List[String],
	cases: List[ParsedMatchCase],
) -> List[String]:
	var result: List[String] = []

	for case in cases:
		case_bound = compiler_name_lists_concat_unique(
			bound,
			compiler_pattern_bound_names(case.pattern),
		)
		result = compiler_name_lists_concat_unique(
			result,
			compiler_free_var_refs_in_expr(env, case_bound, case.body),
		)

	result


private pure func compiler_sequence_bound_after_expr(
	env: CompilerEnv,
	bound: List[String],
	expr: ParsedExpr,
) -> List[String]:
	match expr:
		ParsedVarDeclExpr(name, _, _, _, _):
			compiler_name_list_add_unique(bound, name.text)
		ParsedAssignExpr(name, _, _):
			if compiler_expr_introduces_local_name(env, bound, name):
				compiler_name_list_add_unique(bound, name.text)
			else:
				bound
		ParsedTupleDestructExpr(names, _, _):
			compiler_name_lists_concat_unique(bound, names.map(func(name): name.text))
		_:
			bound


private pure func compiler_free_var_refs_in_sequence(
	env: CompilerEnv,
	bound: List[String],
	exprs: List[ParsedExpr],
) -> List[String]:
	var result: List[String] = []
	var next_bound = bound

	for expr in exprs:
		result = compiler_name_lists_concat_unique(
			result,
			compiler_free_var_refs_in_expr(env, next_bound, expr),
		)
		next_bound = compiler_sequence_bound_after_expr(env, next_bound, expr)

	result


private pure func compiler_lambda_param_bound_names(params: List[ParsedLambdaParam]) -> List[String]:
	var result: List[String] = []

	for param in params:
		result = compiler_name_list_add_unique(result, param.name.text)

	result


private pure func compiler_for_binder_bound_names(binder: ParsedForBinder) -> List[String]:
	match binder:
		ParsedForNameBinder(name):
			[name.text]
		ParsedForTupleBinder(names, _):
			names.map(func(name): name.text)


private pure func compiler_free_var_lhs_refs(
	env: CompilerEnv,
	bound: List[String],
	name: ParsedIdentifier,
) -> List[String]:
	if bound.contains(name.text):
		[]
	else:
		match compiler_env_lookup(env, name.text):
			Some(_):
				[name.text]
			None:
				[]


private pure func compiler_expr_introduces_local_name(
	env: CompilerEnv,
	bound: List[String],
	name: ParsedIdentifier,
) -> Bool:
	not bound.contains(name.text) and compiler_env_lookup(env, name.text).is_none()


private pure func compiler_free_var_refs_in_expr(
	env: CompilerEnv,
	bound: List[String],
	expr: ParsedExpr,
) -> List[String]:
	match expr:
		ParsedNameExpr(name):
			if bound.contains(name.text):
				[]
			else:
				[name.text]
		ParsedUnaryExpr(_, inner, _):
			compiler_free_var_refs_in_expr(env, bound, inner)
		ParsedBinaryExpr(_, left, right, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, left),
				compiler_free_var_refs_in_expr(env, bound, right),
			)
		ParsedLogicalExpr(_, left, right, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, left),
				compiler_free_var_refs_in_expr(env, bound, right),
			)
		ParsedAscriptionExpr(inner, _, _):
			compiler_free_var_refs_in_expr(env, bound, inner)
		ParsedRangeExpr(start_expr, end_expr, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, start_expr),
				compiler_free_var_refs_in_expr(env, bound, end_expr),
			)
		ParsedStringInterpolationPartsExpr(parts, _, _):
			compiler_free_var_refs_in_interpolation_parts(env, bound, parts)
		ParsedCallExpr(callee, args, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, callee),
				compiler_free_var_refs_in_exprs(env, bound, args),
			)
		ParsedFieldAccessExpr(receiver, _, _):
			compiler_free_var_refs_in_expr(env, bound, receiver)
		ParsedSubscriptExpr(receiver, indices, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, receiver),
				compiler_free_var_refs_in_exprs(env, bound, indices),
			)
		ParsedListExpr(items, _):
			compiler_free_var_refs_in_exprs(env, bound, items)
		ParsedTupleExpr(items, _):
			compiler_free_var_refs_in_exprs(env, bound, items)
		ParsedVectorExpr(items, _):
			compiler_free_var_refs_in_exprs(env, bound, items)
		ParsedDictExpr(entries, _):
			compiler_free_var_refs_in_dict_entries(env, bound, entries)
		ParsedRecordExpr(fields, _):
			compiler_free_var_refs_in_record_fields(env, bound, fields)
		ParsedRecordUpdateExpr(base, fields, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, base),
				compiler_free_var_refs_in_record_fields(env, bound, fields),
			)
		ParsedBlockExpr(items, _):
			compiler_free_var_refs_in_sequence(env, bound, items)
		ParsedIfExpr(condition, then_branch, else_branch, _):
			with_then = compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, condition),
				compiler_free_var_refs_in_expr(env, bound, then_branch),
			)
			match else_branch:
				Some(branch):
					compiler_name_lists_concat_unique(
						with_then,
						compiler_free_var_refs_in_expr(env, bound, branch),
					)
				None:
					with_then
		ParsedMatchExpr(scrutinee, cases, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, scrutinee),
				compiler_free_var_refs_in_match_cases(env, bound, cases),
			)
		ParsedDebugBlockExpr(body, _):
			compiler_free_var_refs_in_expr(env, bound, body)
		ParsedLambdaExpr(_, params, _, body, _):
			lambda_bound = compiler_name_lists_concat_unique(
				bound,
				compiler_lambda_param_bound_names(params),
			)
			compiler_free_var_refs_in_expr(env, lambda_bound, body)
		ParsedWhileExpr(condition, body, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, condition),
				compiler_free_var_refs_in_expr(env, bound, body),
			)
		ParsedForExpr(binder, iterable, body, _):
			body_bound = compiler_name_lists_concat_unique(
				bound,
				compiler_for_binder_bound_names(binder),
			)
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, iterable),
				compiler_free_var_refs_in_expr(env, body_bound, body),
			)
		ParsedVarDeclExpr(_, _, value, _, _):
			compiler_free_var_refs_in_expr(env, bound, value)
		ParsedAssignExpr(name, value, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_lhs_refs(env, bound, name),
				compiler_free_var_refs_in_expr(env, bound, value),
			)
		ParsedCompoundAssignExpr(name, _, value, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_lhs_refs(env, bound, name),
				compiler_free_var_refs_in_expr(env, bound, value),
			)
		ParsedSubscriptAssignExpr(target, indices, value, _):
			with_indices = compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, target),
				compiler_free_var_refs_in_exprs(env, bound, indices),
			)
			compiler_name_lists_concat_unique(
				with_indices,
				compiler_free_var_refs_in_expr(env, bound, value),
			)
		ParsedTupleDestructExpr(_, value, _):
			compiler_free_var_refs_in_expr(env, bound, value)
		_:
			[]
private pure func compiler_mutable_capture_names(
	env: CompilerEnv,
	refs: List[String],
) -> List[String]:
	var result: List[String] = []

	for name in refs:
		match compiler_env_lookup(env, name):
			Some(symbol):
				match symbol.kind:
					CompilerVarSymbolKind(var_symbol):
						match var_symbol.mutability:
							CompilerMutableBinding:
								result = compiler_name_list_add_unique(result, name)
							CompilerImmutableBinding:
								void
					_:
						void
			None:
				void

	result


private pure func compiler_join_names(names: List[String]) -> String:
	var result: String = ""
	var index: Int = 0

	for name in names:
		if index == 0:
			result = name
		else:
			result = result + ", " + name

		index += 1

	result


private pure func compiler_check_lambda_mutable_captures(
	context: CompilerInferContext,
	params: List[ParsedLambdaParam],
	body: ParsedExpr,
) -> CompilerInferContext:
	captures = compiler_mutable_capture_names(
		context.state.env,
		compiler_free_var_refs_in_expr(
			context.state.env,
			compiler_lambda_param_bound_names(params),
			body,
		),
	)

	if captures.length() == 0:
		compiler_infer_context_copy(context)
	else:
		plural = if captures.length() == 1:
			""
		else:
			"s"
		compiler_infer_error(
			context,
			"Closure cannot capture mutable variable"
				+ plural
				+ ": "
				+ compiler_join_names(captures)
				+ ". Use explicit state threading instead.",
		)


private pure func compiler_lambda_param_type(
	context: CompilerInferContext,
	param: ParsedLambdaParam,
	index: Int,
	expected_params: List[CompilerType],
) -> (CompilerInferContext, CompilerTypedLambdaParam):
	match param.type_expr:
		Some(type_expr):
			typ = compiler_type_from_parsed_type_expr(type_expr)
			(
				compiler_infer_context_copy(context),
				{
					name = param.name,
					source_type = Some(compiler_type_copy(typ)),
					param_type = compiler_type_copy(typ)
				},
			)
		None:
			match expected_params.get(index):
				Some(expected_type):
					(
						compiler_infer_context_copy(context),
						{
							name = param.name,
							source_type = None,
							param_type = compiler_type_copy(expected_type)
						},
					)
				None:
					next = compiler_lambda_missing_param_type_error(context, param.name.text)
					(
						next,
						{
							name = param.name,
							source_type = None,
							param_type = compiler_type_void()
						},
					)


private pure func compiler_infer_lambda_params_result(
	context: CompilerInferContext,
	params: List[CompilerTypedLambdaParam],
	param_types: List[CompilerType],
) -> CompilerInferLambdaParamsResult:
	{
		context = compiler_infer_context_copy(context),
		params = params,
		param_types = param_types
	}


private pure func compiler_infer_lambda_params(
	context: CompilerInferContext,
	params: List[ParsedLambdaParam],
	expected_params: List[CompilerType],
) -> CompilerInferLambdaParamsResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_params: List[CompilerTypedLambdaParam] = []
	var param_types: List[CompilerType] = []
	var seen: List[String] = []
	var index: Int = 0

	while index < params.length():
		match params.get(index):
			Some(param):
				if seen.contains(param.name.text):
					next_context = compiler_infer_error(
						next_context,
						"Cannot redeclare lambda parameter `" + param.name.text + "`",
					)
				seen = seen.append(param.name.text)
				param_result: (CompilerInferContext, CompilerTypedLambdaParam) = compiler_lambda_param_type(
					next_context,
					param,
					index,
					expected_params,
				)
				next_context = param_result[0]
				typed_param = param_result[1]
				typed_params = typed_params.append(typed_param)
				param_types = param_types.append(compiler_type_copy(typed_param.param_type))
			None:
				void

		index += 1

	compiler_infer_lambda_params_result(next_context, typed_params, param_types)


private pure func compiler_add_lambda_param_bindings(
	env: CompilerEnv,
	params: List[CompilerTypedLambdaParam],
) -> CompilerEnv:
	var next_env: CompilerEnv = env

	for param in params:
		next_env = compiler_env_add_var_with_details(
			next_env,
			param.name.text,
			compiler_type_copy(param.param_type),
			compiler_optional_type_copy(param.source_type),
			CompilerImmutableBinding,
			CompilerFuncParam,
			compiler_unrefined_binding(),
		)

	next_env


private pure func compiler_expected_lambda_return_type(
	return_type: Option[ParsedTypeExpr],
	expected_return_type: Option[CompilerType],
) -> Option[CompilerType]:
	match return_type:
		Some(type_expr):
			Some(compiler_type_from_parsed_type_expr(type_expr))
		None:
			compiler_optional_type_copy(expected_return_type)


private pure func compiler_infer_lambda_expr(
	context: CompilerInferContext,
	is_pure: Bool,
	params: List[ParsedLambdaParam],
	return_type: Option[ParsedTypeExpr],
	body: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	expected_function = compiler_expected_function_type(context)
	expected_params: List[CompilerType] = match expected_function:
		Some((_, param_types, _)):
			param_types
		None:
			[]
	expected_return_type: Option[CompilerType] = match expected_function:
		Some((_, _, expected_return)):
			Some(expected_return)
		None:
			None
	capture_context = compiler_check_lambda_mutable_captures(context, params, body)
	params_result = compiler_infer_lambda_params(capture_context, params, expected_params)
	var body_env = compiler_env_push_scope(params_result.context.state.env)
	body_env = compiler_add_lambda_param_bindings(body_env, params_result.params)
	body_state = compiler_typecheck_state_with_env(params_result.context.state, body_env)
	body_base_context = compiler_infer_context_with_state(params_result.context, body_state)
	declared_return_type = compiler_expected_lambda_return_type(return_type, expected_return_type)
	body_context = match declared_return_type:
		Some(typ):
			compiler_infer_with_expected_value_slot(body_base_context, typ, CompilerExpectedArgumentSlot)
		None:
			compiler_infer_without_expected(body_base_context)
	body_result = compiler_infer_expr(body_context, body)
	body_value_type = compiler_typed_expr_value_type(body_result.expr)
	result_return_type = match declared_return_type:
		Some(typ):
			compiler_type_copy(typ)
		None:
			compiler_typed_expr_semantic_type(body_result.expr)
	checked_context = match declared_return_type:
		Some(typ):
			if compiler_types_equal(body_value_type, typ):
				compiler_infer_context_copy(body_result.context)
			else:
				compiler_lambda_return_mismatch_error(body_result.context, typ, body_value_type)
		None:
			compiler_infer_context_copy(body_result.context)
	outer_env = compiler_env_pop_scope(checked_context.state.env)
	outer_state = compiler_typecheck_state_with_env(checked_context.state, outer_env)
	result_context = compiler_infer_context_with_state(context, outer_state)
	function_type = CompilerFunctionType(is_pure, params_result.param_types, result_return_type)
	typed = CompilerTypedLambdaExpr(
		is_pure,
		params_result.params,
		compiler_optional_type_copy(declared_return_type),
		body_result.expr,
		span,
		compiler_inferred_info(result_context, function_type),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_infer_expr_list_result(
	context: CompilerInferContext,
	exprs: List[CompilerTypedExpr],
) -> CompilerInferExprListResult:
	{
		context = compiler_infer_context_copy(context),
		exprs = exprs
	}


private pure func compiler_infer_unconstrained_exprs(
	context: CompilerInferContext,
	exprs: List[ParsedExpr],
) -> CompilerInferExprListResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_exprs: List[CompilerTypedExpr] = []
	var index: Int = 0

	while index < exprs.length():
		match exprs.get(index):
			Some(expr):
				result = compiler_infer_expr(compiler_infer_without_expected(next_context), expr)
				next_context = compiler_infer_context_copy(result.context)
				typed_exprs = typed_exprs.append(result.expr)
			None:
				void

		index += 1

	compiler_infer_expr_list_result(compiler_infer_without_expected(next_context), typed_exprs)


private pure func compiler_tuple_type_from_items(
	items: List[CompilerTypedExpr],
) -> CompilerType:
	var types: List[CompilerType] = []

	for item in items:
		types = types.append(compiler_type_copy(compiler_typed_expr_semantic_type(item)))

	CompilerTupleType(types)


private pure func compiler_infer_tuple_expr(
	context: CompilerInferContext,
	items: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	items_result = compiler_infer_unconstrained_exprs(context, items)
	tuple_type = compiler_tuple_type_from_items(items_result.exprs)
	result_context = compiler_infer_context_with_state(context, items_result.context.state)
	typed = CompilerTypedTupleExpr(
		items_result.exprs,
		span,
		compiler_inferred_info(result_context, tuple_type),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_tuple_destruct_redeclaration_error(
	context: CompilerInferContext,
	name: String,
) -> CompilerInferContext:
	compiler_infer_error(context, "Cannot redeclare `" + name + "` in tuple destructuring")


private pure func compiler_check_tuple_destruct_redeclarations(
	context: CompilerInferContext,
	names: List[ParsedIdentifier],
) -> CompilerInferContext:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var seen: List[String] = []

	for name in names:
		if name.text != "_":
			if (
				compiler_env_lookup_in_current_scope(context.state.env, name.text).is_some()
				or seen.contains(name.text)
			):
				next_context = compiler_tuple_destruct_redeclaration_error(next_context, name.text)
			seen = seen.append(name.text)

	next_context


private pure func compiler_add_tuple_destruct_bindings(
	env: CompilerEnv,
	names: List[ParsedIdentifier],
	element_types: List[CompilerType],
) -> CompilerEnv:
	var next_env: CompilerEnv = env
	var index: Int = 0

	while index < names.length():
		match names.get(index):
			Some(name):
				if name.text != "_":
					elem_type = compiler_tuple_binding_type(element_types, index)
					next_env = compiler_env_add_var_with_details(
						next_env,
						name.text,
						compiler_type_copy(elem_type),
						Some(compiler_type_copy(elem_type)),
						CompilerImmutableBinding,
						CompilerLetBinding,
						compiler_unrefined_binding(),
					)
			None:
				void

		index += 1

	next_env


private pure func compiler_tuple_destruct_arity_error(
	context: CompilerInferContext,
	binder_count: Int,
	element_count: Int,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Tuple destructuring arity mismatch: expected "
			+ binder_count.to_string()
			+ " elements, got "
			+ element_count.to_string(),
	)


private pure func compiler_tuple_destruct_non_tuple_error(
	context: CompilerInferContext,
	typ: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Tuple destructuring requires a tuple type, got " + compiler_type_to_string(typ),
	)


private pure func compiler_infer_tuple_destruct_expr(
	context: CompilerInferContext,
	names: List[ParsedIdentifier],
	value: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	checked_context = compiler_check_tuple_destruct_redeclarations(context, names)
	value_result = compiler_infer_expr(compiler_infer_without_expected(checked_context), value)
	value_type = compiler_typed_expr_semantic_type(value_result.expr)
	element_result = compiler_tuple_elements_from_type(value_type)

	result_context = match element_result:
		Some(element_types):
			if names.length() == element_types.length():
				next_env = compiler_add_tuple_destruct_bindings(
					value_result.context.state.env,
					names,
					element_types,
				)
				next_state = compiler_typecheck_state_with_env(value_result.context.state, next_env)
				compiler_infer_context_with_state(context, next_state)
			else:
				compiler_tuple_destruct_arity_error(
					value_result.context,
					names.length(),
					element_types.length(),
				)
		None:
			compiler_tuple_destruct_non_tuple_error(value_result.context, value_type)
	typed = CompilerTypedTupleDestructExpr(
		names,
		value_result.expr,
		span,
		compiler_inferred_info(result_context, compiler_type_void()),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_expected_list_element_type(
	context: CompilerInferContext,
) -> Option[CompilerType]:
	match context.expected_type:
		Some(expected):
			match expected:
				CompilerNamedType(name, args):
					if name == "List" and args.length() == 1:
						args.get(0).map(compiler_type_copy)
					else:
						None
				_:
					None
		None:
			None


private pure func compiler_expected_vector_type(
	context: CompilerInferContext,
) -> Option[(CompilerType, List[CompilerType])]:
	match context.expected_type:
		Some(expected):
			compiler_array_type_parts(expected)
		None:
			None


private pure func compiler_dims_after_first(dims: List[CompilerType]) -> List[CompilerType]:
	var result: List[CompilerType] = []
	var index: Int = 1

	while index < dims.length():
		match dims.get(index):
			Some(dim):
				result = result.append(dim)
			None:
				void

		index += 1

	result


private pure func compiler_vector_item_type(
	element_type: CompilerType,
	dims: List[CompilerType],
) -> CompilerType:
	if dims.length() <= 1:
		compiler_type_copy(element_type)
	else:
		compiler_array_type(compiler_type_copy(element_type), compiler_dims_after_first(dims))


private pure func compiler_default_collection_element_type(
	typ: CompilerType,
) -> CompilerType:
	compiler_numeric_operand_type(ParsedAddOp, typ)


private pure func compiler_common_inferred_type(
	left: CompilerType,
	right: CompilerType,
) -> Option[CompilerType]:
	if compiler_types_equal(left, right):
		Some(compiler_type_copy(left))
	else:
		match (left, right):
			(CompilerConstIntType(_), CompilerConstIntType(_)):
				Some(compiler_type_int())
			(CompilerConstIntType(_), CompilerNamedType(name, args)):
				if name == "Int" and args.length() == 0:
					Some(compiler_type_int())
				else:
					None
			(CompilerNamedType(name, args), CompilerConstIntType(_)):
				if name == "Int" and args.length() == 0:
					Some(compiler_type_int())
				else:
					None
			_:
				None


private pure func compiler_type_range() -> CompilerType:
	CompilerNamedType("Range", [])


private pure func compiler_type_dict(
	key_type: CompilerType,
	value_type: CompilerType,
) -> CompilerType:
	CompilerNamedType("Dict", [compiler_type_copy(key_type), compiler_type_copy(value_type)])


private pure func compiler_list_element_mismatch_error(
	context: CompilerInferContext,
	index: Int,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"List element "
			+ (index + 1).to_string()
			+ " expected "
			+ compiler_type_to_string(expected)
			+ ", got "
			+ compiler_type_to_string(got),
	)


private pure func compiler_vector_element_mismatch_error(
	context: CompilerInferContext,
	index: Int,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Tensor element "
			+ (index + 1).to_string()
			+ " expected "
			+ compiler_type_to_string(expected)
			+ ", got "
			+ compiler_type_to_string(got),
	)


private pure func compiler_vector_expected_count_error(
	context: CompilerInferContext,
	expected: Int,
	got: Int,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Tensor literal expected "
			+ expected.to_string()
			+ " elements, got "
			+ got.to_string(),
	)


private pure func compiler_check_vector_expected_count(
	context: CompilerInferContext,
	dims: List[CompilerType],
	actual_count: Int,
) -> CompilerInferContext:
	match dims.get(0):
		Some(CompilerConstIntType(expected_count)):
			if expected_count == actual_count:
				compiler_infer_context_copy(context)
			else:
				compiler_vector_expected_count_error(context, expected_count, actual_count)
		_:
			compiler_infer_context_copy(context)


private pure func compiler_collection_slot_for_target(
	kind: CompilerCollectionKind,
	target_type: CompilerType,
	semantic_type: CompilerType,
) -> CompilerValueSlot:
	if compiler_types_equal(compiler_default_collection_element_type(semantic_type), target_type):
		compiler_collection_element_target_slot(kind, target_type, semantic_type)
	else:
		compiler_keep_value_slot(semantic_type)


private pure func compiler_infer_list_tail_items(
	context: CompilerInferContext,
	items: List[ParsedExpr],
	start_index: Int,
	element_type: CompilerType,
	typed_items: List[CompilerTypedExpr],
) -> CompilerInferExprListResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var result_items: List[CompilerTypedExpr] = typed_items
	var index: Int = start_index

	while index < items.length():
		match items.get(index):
			Some(item):
				item_result = compiler_infer_expr(compiler_infer_without_expected(next_context), item)
				item_semantic_type = compiler_typed_expr_semantic_type(item_result.expr)
				item_candidate_type = compiler_default_collection_element_type(item_semantic_type)
				item_slot = compiler_collection_slot_for_target(
					CompilerListLiteral,
					element_type,
					item_semantic_type,
				)
				typed_item = compiler_typed_expr_with_slot(item_result.expr, item_slot)
				item_type = compiler_typed_expr_value_type(typed_item)
				next_context = if compiler_types_equal(item_type, element_type):
					compiler_infer_context_copy(item_result.context)
				else:
					compiler_list_element_mismatch_error(
						item_result.context,
						index,
						element_type,
						item_candidate_type,
					)
				result_items = result_items.append(typed_item)
			None:
				void

		index += 1

	compiler_infer_expr_list_result(compiler_infer_without_expected(next_context), result_items)


private pure func compiler_infer_list_expr(
	context: CompilerInferContext,
	items: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	match compiler_expected_list_element_type(context):
		Some(expected_element):
			if items.length() == 0:
				result_context = compiler_infer_context_copy(context)
				list_type = compiler_type_list(expected_element)
				typed = CompilerTypedListExpr(
					[],
					span,
					compiler_inferred_info(result_context, list_type),
				)
				compiler_infer_result(result_context, typed)
			else:
				items_result = compiler_infer_list_tail_items(context, items, 0, expected_element, [])
				result_context = compiler_infer_context_with_state(context, items_result.context.state)
				list_type = compiler_type_list(expected_element)
				typed = CompilerTypedListExpr(
					items_result.exprs,
					span,
					compiler_inferred_info(result_context, list_type),
				)
				compiler_infer_result(result_context, typed)
		None:
			if items.length() == 0:
				next = compiler_infer_error(
					context,
					"Cannot infer element type for empty list literal",
				)
				typed = CompilerTypedListExpr(
					[],
					span,
					compiler_inferred_info(next, compiler_type_list(compiler_type_void())),
				)
				compiler_infer_result(next, typed)
			else:
				match items.get(0):
					Some(first_item):
						first_result = compiler_infer_expr(
							compiler_infer_without_expected(context),
							first_item,
						)
						first_semantic_type = compiler_typed_expr_semantic_type(first_result.expr)
						element_type = compiler_default_collection_element_type(first_semantic_type)
						first_typed = compiler_typed_expr_with_slot(
							first_result.expr,
							compiler_collection_slot_for_target(
								CompilerListLiteral,
								element_type,
								first_semantic_type,
							),
						)
						first_context = if compiler_types_equal(compiler_typed_expr_value_type(first_typed), element_type):
							compiler_infer_context_copy(first_result.context)
						else:
							compiler_list_element_mismatch_error(
								first_result.context,
								0,
								element_type,
								compiler_typed_expr_value_type(first_typed),
							)
						items_result = compiler_infer_list_tail_items(
							first_context,
							items,
							1,
							element_type,
							[first_typed],
						)
						result_context = compiler_infer_context_with_state(context, items_result.context.state)
						list_type = compiler_type_list(element_type)
						typed = CompilerTypedListExpr(
							items_result.exprs,
							span,
							compiler_inferred_info(result_context, list_type),
						)
						compiler_infer_result(result_context, typed)
					None:
						next = compiler_infer_error(
							context,
							"Cannot infer element type for empty list literal",
						)
						typed = CompilerTypedListExpr(
							[],
							span,
							compiler_inferred_info(next, compiler_type_list(compiler_type_void())),
						)
						compiler_infer_result(next, typed)


private pure func compiler_infer_vector_tail_items(
	context: CompilerInferContext,
	items: List[ParsedExpr],
	start_index: Int,
	item_type: CompilerType,
	typed_items: List[CompilerTypedExpr],
) -> CompilerInferExprListResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var result_items: List[CompilerTypedExpr] = typed_items
	var index: Int = start_index

	while index < items.length():
		match items.get(index):
			Some(item):
				item_result = compiler_infer_expr(compiler_infer_without_expected(next_context), item)
				item_semantic_type = compiler_typed_expr_semantic_type(item_result.expr)
				item_candidate_type = compiler_default_collection_element_type(item_semantic_type)
				item_slot = compiler_collection_slot_for_target(
					CompilerVectorLiteral,
					item_type,
					item_semantic_type,
				)
				typed_item = compiler_typed_expr_with_slot(item_result.expr, item_slot)
				item_value_type = compiler_typed_expr_value_type(typed_item)
				next_context = if compiler_types_equal(item_value_type, item_type):
					compiler_infer_context_copy(item_result.context)
				else:
					compiler_vector_element_mismatch_error(
						item_result.context,
						index,
						item_type,
						item_candidate_type,
					)
				result_items = result_items.append(typed_item)
			None:
				void

		index += 1

	compiler_infer_expr_list_result(compiler_infer_without_expected(next_context), result_items)


private pure func compiler_array_type_from_item_count(
	item_type: CompilerType,
	count: Int,
) -> CompilerType:
	match compiler_array_type_parts(item_type):
		Some((element_type, dims)):
			var result_dims: List[CompilerType] = [CompilerConstIntType(count)]

			for dim in dims:
				result_dims = result_dims.append(dim)

			compiler_array_type(element_type, result_dims)
		None:
			compiler_array_type(item_type, [CompilerConstIntType(count)])


private pure func compiler_infer_vector_expr(
	context: CompilerInferContext,
	items: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	match compiler_expected_vector_type(context):
		Some((element_type, dims)):
			result_type = compiler_array_type(element_type, dims)
			item_type = compiler_vector_item_type(element_type, dims)
			count_context = compiler_check_vector_expected_count(context, dims, items.length())
			items_result = compiler_infer_vector_tail_items(count_context, items, 0, item_type, [])
			result_context = compiler_infer_context_with_state(context, items_result.context.state)
			typed = CompilerTypedVectorExpr(
				items_result.exprs,
				span,
				compiler_inferred_info(result_context, result_type),
			)
			compiler_infer_result(result_context, typed)
		None:
			if items.length() == 0:
				next = compiler_infer_error(
					context,
					"Cannot infer type of empty tensor literal",
				)
				typed = CompilerTypedVectorExpr(
					[],
					span,
					compiler_inferred_info(next, compiler_array_type(compiler_type_void(), [CompilerConstIntType(0)])),
				)
				compiler_infer_result(next, typed)
			else:
				match items.get(0):
					Some(first_item):
						first_result = compiler_infer_expr(compiler_infer_without_expected(context), first_item)
						first_semantic_type = compiler_typed_expr_semantic_type(first_result.expr)
						item_type = compiler_default_collection_element_type(first_semantic_type)
						first_typed = compiler_typed_expr_with_slot(
							first_result.expr,
							compiler_collection_slot_for_target(
								CompilerVectorLiteral,
								item_type,
								first_semantic_type,
							),
						)
						first_context = if compiler_types_equal(compiler_typed_expr_value_type(first_typed), item_type):
							compiler_infer_context_copy(first_result.context)
						else:
							compiler_vector_element_mismatch_error(
								first_result.context,
								0,
								item_type,
								compiler_typed_expr_value_type(first_typed),
							)
						items_result = compiler_infer_vector_tail_items(
							first_context,
							items,
							1,
							item_type,
							[first_typed],
						)
						result_context = compiler_infer_context_with_state(context, items_result.context.state)
						vector_type = compiler_array_type_from_item_count(item_type, items.length())
						typed = CompilerTypedVectorExpr(
							items_result.exprs,
							span,
							compiler_inferred_info(result_context, vector_type),
						)
						compiler_infer_result(result_context, typed)
					None:
						next = compiler_infer_error(
							context,
							"Cannot infer type of empty tensor literal",
						)
						typed = CompilerTypedVectorExpr(
							[],
							span,
							compiler_inferred_info(next, compiler_array_type(compiler_type_void(), [CompilerConstIntType(0)])),
						)
						compiler_infer_result(next, typed)


private pure func compiler_expected_dict_types(
	context: CompilerInferContext,
) -> Option[(CompilerType, CompilerType)]:
	match context.expected_type:
		Some(expected):
			match expected:
				CompilerNamedType(name, args):
					if name == "Dict" and args.length() == 2:
						match (args.get(0), args.get(1)):
							(Some(key_type), Some(value_type)):
								Some((compiler_type_copy(key_type), compiler_type_copy(value_type)))
							_:
								None
					else:
						None
				_:
					None
		None:
			None


private pure func compiler_dict_entry_mismatch_error(
	context: CompilerInferContext,
	label: String,
	index: Int,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		label
			+ " "
			+ (index + 1).to_string()
			+ " expected "
			+ compiler_type_to_string(expected)
			+ ", got "
			+ compiler_type_to_string(got),
	)


private pure func compiler_infer_dict_entries_result(
	context: CompilerInferContext,
	entries: List[CompilerTypedDictEntry],
) -> CompilerInferDictEntriesResult:
	{
		context = compiler_infer_context_copy(context),
		entries = entries
	}


private pure func compiler_infer_dict_entries(
	context: CompilerInferContext,
	entries: List[ParsedDictEntry],
	start_index: Int,
	key_type: CompilerType,
	value_type: CompilerType,
	typed_entries: List[CompilerTypedDictEntry],
) -> CompilerInferDictEntriesResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var result_entries: List[CompilerTypedDictEntry] = typed_entries
	var index: Int = start_index

	while index < entries.length():
		match entries.get(index):
			Some(entry):
				key_result = compiler_infer_expr(compiler_infer_without_expected(next_context), entry.key)
				key_semantic_type = compiler_typed_expr_semantic_type(key_result.expr)
				key_candidate_type = compiler_default_collection_element_type(key_semantic_type)
				typed_key = compiler_typed_expr_with_slot(
					key_result.expr,
					compiler_collection_slot_for_target(CompilerDictLiteral, key_type, key_semantic_type),
				)
				key_value_type = compiler_typed_expr_value_type(typed_key)
				key_context = if compiler_types_equal(key_value_type, key_type):
					compiler_infer_context_copy(key_result.context)
				else:
					compiler_dict_entry_mismatch_error(
						key_result.context,
						"Dict literal key",
						index,
						key_type,
						key_candidate_type,
					)

				value_result = compiler_infer_expr(compiler_infer_without_expected(key_context), entry.value)
				value_semantic_type = compiler_typed_expr_semantic_type(value_result.expr)
				value_candidate_type = compiler_default_collection_element_type(value_semantic_type)
				typed_value = compiler_typed_expr_with_slot(
					value_result.expr,
					compiler_collection_slot_for_target(
						CompilerDictLiteral,
						value_type,
						value_semantic_type,
					),
				)
				value_value_type = compiler_typed_expr_value_type(typed_value)
				next_context = if compiler_types_equal(value_value_type, value_type):
					compiler_infer_context_copy(value_result.context)
				else:
					compiler_dict_entry_mismatch_error(
						value_result.context,
						"Dict literal value",
						index,
						value_type,
						value_candidate_type,
					)
				result_entries = result_entries.append({key = typed_key, value = typed_value})
			None:
				void

		index += 1

	compiler_infer_dict_entries_result(compiler_infer_without_expected(next_context), result_entries)


private pure func compiler_infer_dict_expr(
	context: CompilerInferContext,
	entries: List[ParsedDictEntry],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	match compiler_expected_dict_types(context):
		Some((key_type, value_type)):
			entries_result = compiler_infer_dict_entries(context, entries, 0, key_type, value_type, [])
			result_context = compiler_infer_context_with_state(context, entries_result.context.state)
			dict_type = compiler_type_dict(key_type, value_type)
			typed = CompilerTypedDictExpr(
				entries_result.entries,
				span,
				compiler_inferred_info(result_context, dict_type),
			)
			compiler_infer_result(result_context, typed)
		None:
			if entries.length() == 0:
				next = compiler_infer_error(
					context,
					"Cannot infer type of empty dict literal",
				)
				typed = CompilerTypedDictExpr(
					[],
					span,
					compiler_inferred_info(
						next,
						compiler_type_dict(compiler_type_void(), compiler_type_void()),
					),
				)
				compiler_infer_result(next, typed)
			else:
				match entries.get(0):
					Some(first_entry):
						first_key_result = compiler_infer_expr(
							compiler_infer_without_expected(context),
							first_entry.key,
						)
						first_key_semantic_type = compiler_typed_expr_semantic_type(first_key_result.expr)
						key_type = compiler_default_collection_element_type(first_key_semantic_type)
						first_key = compiler_typed_expr_with_slot(
							first_key_result.expr,
							compiler_collection_slot_for_target(
								CompilerDictLiteral,
								key_type,
								first_key_semantic_type,
							),
						)

						first_value_result = compiler_infer_expr(
							compiler_infer_without_expected(first_key_result.context),
							first_entry.value,
						)
						first_value_semantic_type = compiler_typed_expr_semantic_type(first_value_result.expr)
						value_type = compiler_default_collection_element_type(first_value_semantic_type)
						first_value = compiler_typed_expr_with_slot(
							first_value_result.expr,
							compiler_collection_slot_for_target(
								CompilerDictLiteral,
								value_type,
								first_value_semantic_type,
							),
						)
						first_context = compiler_infer_context_copy(first_value_result.context)
						entries_result = compiler_infer_dict_entries(
							first_context,
							entries,
							1,
							key_type,
							value_type,
							[{key = first_key, value = first_value}],
						)
						result_context = compiler_infer_context_with_state(context, entries_result.context.state)
						dict_type = compiler_type_dict(key_type, value_type)
						typed = CompilerTypedDictExpr(
							entries_result.entries,
							span,
							compiler_inferred_info(result_context, dict_type),
						)
						compiler_infer_result(result_context, typed)
					None:
						next = compiler_infer_error(
							context,
							"Cannot infer type of empty dict literal",
						)
						typed = CompilerTypedDictExpr(
							[],
							span,
							compiler_inferred_info(
								next,
								compiler_type_dict(compiler_type_void(), compiler_type_void()),
							),
						)
						compiler_infer_result(next, typed)


private pure func compiler_record_subst_for_args(
	type_params: List[String],
	args: List[CompilerType],
) -> List[CompilerTypeSubstEntry]:
	var subst: List[CompilerTypeSubstEntry] = []
	var index: Int = 0

	while index < type_params.length() and index < args.length():
		match (type_params.get(index), args.get(index)):
			(Some(type_param), Some(arg)):
				subst = subst.append(compiler_type_subst_entry(type_param, arg))
			_:
				void

		index += 1

	subst


private pure func compiler_record_field_types(
	context: CompilerInferContext,
	record_name: String,
	args: List[CompilerType],
) -> Option[List[CompilerFieldDecl]]:
	match compiler_env_get_record(context.state.env, record_name):
		Some((type_params, fields)):
			if type_params.length() != args.length():
				None
			else:
				subst = compiler_record_subst_for_args(type_params, args)
				Some(fields.map(
					func(field): {
						name = field.name,
						field_type = compiler_apply_subst(subst, field.field_type),
					},
				))
		None:
			None


private pure func compiler_find_record_field(
	fields: List[CompilerFieldDecl],
	name: String,
) -> Option[CompilerFieldDecl]:
	var result: Option[CompilerFieldDecl] = None
	var index: Int = 0

	while index < fields.length() and result == None:
		match fields.get(index):
			Some(field):
				if field.name == name:
					result = Some({
						name = field.name,
						field_type = compiler_type_copy(field.field_type),
					})
			None:
				void

		index += 1

	result


private pure func compiler_record_field_names(
	fields: List[CompilerFieldDecl],
) -> List[String]:
	fields.map(func(field): field.name)


private pure func compiler_record_expr_field_names(
	fields: List[ParsedRecordExprField],
) -> List[String]:
	fields.map(func(field): field.name.text)


private pure func compiler_missing_record_field_names(
	expected_fields: List[CompilerFieldDecl],
	actual_fields: List[ParsedRecordExprField],
) -> List[String]:
	provided_names = compiler_record_expr_field_names(actual_fields)
	var missing: List[String] = []

	for field in expected_fields:
		if not provided_names.contains(field.name):
			missing = missing.append(field.name)

	missing


private pure func compiler_record_missing_fields_error(
	context: CompilerInferContext,
	missing_names: List[String],
) -> CompilerInferContext:
	if missing_names.length() == 0:
		compiler_infer_context_copy(context)
	else:
		compiler_infer_error(
			context,
			"Record literal is missing field(s): " + missing_names.join(", "),
		)


private pure func compiler_record_unknown_field_error(
	context: CompilerInferContext,
	field_name: String,
	expected_fields: List[CompilerFieldDecl],
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Unknown field '"
			+ field_name
			+ "' in record literal. Valid fields: "
			+ compiler_record_field_names(expected_fields).join(", "),
	)


private pure func compiler_record_field_mismatch_error(
	context: CompilerInferContext,
	field_name: String,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Record field '"
			+ field_name
			+ "': expected "
			+ compiler_type_to_string(expected)
			+ ", got "
			+ compiler_type_to_string(got),
	)


private pure func compiler_infer_record_fields_result(
	context: CompilerInferContext,
	fields: List[CompilerTypedRecordField],
) -> CompilerInferRecordFieldsResult:
	{
		context = compiler_infer_context_copy(context),
		fields = fields
	}


private pure func compiler_infer_record_fields(
	context: CompilerInferContext,
	fields: List[ParsedRecordExprField],
	expected_fields: List[CompilerFieldDecl],
) -> CompilerInferRecordFieldsResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_fields: List[CompilerTypedRecordField] = []
	var index: Int = 0

	while index < fields.length():
		match fields.get(index):
			Some(field):
				match compiler_find_record_field(expected_fields, field.name.text):
					Some(expected_field):
						value_result = compiler_infer_expr(
							compiler_infer_with_expected_value_slot(
								next_context,
								expected_field.field_type,
								CompilerExpectedArgumentSlot,
							),
							field.value,
						)
						value_type = compiler_typed_expr_value_type(value_result.expr)
						next_context = if compiler_types_equal(value_type, expected_field.field_type):
							compiler_infer_context_copy(value_result.context)
						else:
							compiler_record_field_mismatch_error(
								value_result.context,
								field.name.text,
								expected_field.field_type,
								value_type,
							)
						typed_fields = typed_fields.append({
							name = field.name,
							value = value_result.expr,
							span = field.span,
						})
					None:
						unknown_context = compiler_record_unknown_field_error(
							next_context,
							field.name.text,
							expected_fields,
						)
						value_result = compiler_infer_expr(
							compiler_infer_without_expected(unknown_context),
							field.value,
						)
						next_context = compiler_infer_context_copy(value_result.context)
						typed_fields = typed_fields.append({
							name = field.name,
							value = value_result.expr,
							span = field.span,
						})
			None:
				void

		index += 1

	compiler_infer_record_fields_result(compiler_infer_without_expected(next_context), typed_fields)


private pure func compiler_infer_unconstrained_record_fields(
	context: CompilerInferContext,
	fields: List[ParsedRecordExprField],
) -> CompilerInferRecordFieldsResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_fields: List[CompilerTypedRecordField] = []
	var index: Int = 0

	while index < fields.length():
		match fields.get(index):
			Some(field):
				value_result = compiler_infer_expr(
					compiler_infer_without_expected(next_context),
					field.value,
				)
				next_context = compiler_infer_context_copy(value_result.context)
				typed_fields = typed_fields.append({
					name = field.name,
					value = value_result.expr,
					span = field.span,
				})
			None:
				void

		index += 1

	compiler_infer_record_fields_result(compiler_infer_without_expected(next_context), typed_fields)


private pure func compiler_infer_known_record_expr(
	context: CompilerInferContext,
	fields: List[ParsedRecordExprField],
	span: CompilerSourceSpan,
	record_type: CompilerType,
	expected_fields: List[CompilerFieldDecl],
) -> CompilerInferResult:
	fields_result = compiler_infer_record_fields(context, fields, expected_fields)
	missing_context = compiler_record_missing_fields_error(
		fields_result.context,
		compiler_missing_record_field_names(expected_fields, fields),
	)
	result_context = compiler_infer_context_with_state(context, missing_context.state)
	typed = CompilerTypedRecordExpr(
		fields_result.fields,
		span,
		compiler_inferred_info(result_context, record_type),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_record_literal_inference_error(
	context: CompilerInferContext,
	fields: List[ParsedRecordExprField],
	span: CompilerSourceSpan,
	message: String,
) -> CompilerInferResult:
	next = compiler_infer_error(context, message)
	fields_result = compiler_infer_unconstrained_record_fields(
		compiler_infer_without_expected(next),
		fields,
	)
	result_context = compiler_infer_context_with_state(context, fields_result.context.state)
	typed = CompilerTypedRecordExpr(
		fields_result.fields,
		span,
		compiler_inferred_info(result_context, compiler_type_void()),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_cannot_infer_record_message() -> String:
	"Cannot infer record type without annotation. Add an explicit record type, e.g. p: Point = {x = 1, y = 2}"


private pure func compiler_invalid_record_literal_message(
	fields: List[ParsedRecordExprField],
	expected_type: CompilerType,
) -> String:
	if fields.length() == 0:
		"Cannot use {} for type " + compiler_type_to_string(expected_type) + ": not a record type"
	else:
		"Cannot use record literal for type " + compiler_type_to_string(expected_type)


private pure func compiler_infer_record_from_fields(
	context: CompilerInferContext,
	fields: List[ParsedRecordExprField],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	if fields.length() == 0:
		compiler_record_literal_inference_error(
			context,
			fields,
			span,
			compiler_cannot_infer_record_message(),
		)
	else:
		field_names = compiler_record_expr_field_names(fields)
		matches = compiler_env_find_records_with_fields(context.state.env, field_names)

		if matches.length() == 0:
			compiler_record_literal_inference_error(
				context,
				fields,
				span,
				compiler_cannot_infer_record_message(),
			)
		else if matches.length() == 1:
			match matches.get(0):
				Some(record_name):
					match compiler_record_field_types(context, record_name, []):
						Some(expected_fields):
							compiler_infer_known_record_expr(
								context,
								fields,
								span,
								CompilerNamedType(record_name, []),
								expected_fields,
							)
						None:
							compiler_record_literal_inference_error(
								context,
								fields,
								span,
								"Internal error: matched record type '" + record_name + "' has no field metadata",
							)
				None:
					compiler_record_literal_inference_error(
						context,
						fields,
						span,
						compiler_cannot_infer_record_message(),
					)
		else:
			compiler_record_literal_inference_error(
				context,
				fields,
				span,
				"Ambiguous record literal: could be "
					+ matches.join(" or ")
					+ ". Multiple types share fields {"
					+ field_names.join(", ")
					+ "}",
			)


private pure func compiler_infer_record_expr(
	context: CompilerInferContext,
	fields: List[ParsedRecordExprField],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	match context.expected_type:
		Some(expected_type):
			match expected_type:
				CompilerNamedType(record_name, args):
					match compiler_record_field_types(context, record_name, args):
						Some(expected_fields):
							compiler_infer_known_record_expr(
								context,
								fields,
								span,
								CompilerNamedType(record_name, args.map(compiler_type_copy)),
								expected_fields,
							)
						None:
							compiler_record_literal_inference_error(
								context,
								fields,
								span,
								compiler_invalid_record_literal_message(fields, expected_type),
							)
				_:
					compiler_record_literal_inference_error(
						context,
						fields,
						span,
						compiler_invalid_record_literal_message(fields, expected_type),
					)
		None:
			compiler_infer_record_from_fields(context, fields, span)


private pure func compiler_record_update_unknown_field_error(
	context: CompilerInferContext,
	record_name: String,
	field_name: String,
	expected_fields: List[CompilerFieldDecl],
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Record "
			+ record_name
			+ " has no field '"
			+ field_name
			+ "'. Valid fields: "
			+ compiler_record_field_names(expected_fields).join(", "),
	)


private pure func compiler_record_update_field_mismatch_error(
	context: CompilerInferContext,
	field_name: String,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Record update field '"
			+ field_name
			+ "' type mismatch: expected "
			+ compiler_type_to_string(expected)
			+ ", got "
			+ compiler_type_to_string(got),
	)


private pure func compiler_infer_record_update_fields(
	context: CompilerInferContext,
	record_name: String,
	fields: List[ParsedRecordExprField],
	expected_fields: List[CompilerFieldDecl],
) -> CompilerInferRecordFieldsResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_fields: List[CompilerTypedRecordField] = []
	var index: Int = 0

	while index < fields.length():
		match fields.get(index):
			Some(field):
				match compiler_find_record_field(expected_fields, field.name.text):
					Some(expected_field):
						value_result = compiler_infer_expr(
							compiler_infer_with_expected_value_slot(
								next_context,
								expected_field.field_type,
								CompilerExpectedArgumentSlot,
							),
							field.value,
						)
						value_type = compiler_typed_expr_value_type(value_result.expr)
						next_context = if compiler_types_equal(value_type, expected_field.field_type):
							compiler_infer_context_copy(value_result.context)
						else:
							compiler_record_update_field_mismatch_error(
								value_result.context,
								field.name.text,
								expected_field.field_type,
								value_type,
							)
						typed_fields = typed_fields.append({
							name = field.name,
							value = value_result.expr,
							span = field.span,
						})
					None:
						unknown_context = compiler_record_update_unknown_field_error(
							next_context,
							record_name,
							field.name.text,
							expected_fields,
						)
						value_result = compiler_infer_expr(
							compiler_infer_without_expected(unknown_context),
							field.value,
						)
						next_context = compiler_infer_context_copy(value_result.context)
						typed_fields = typed_fields.append({
							name = field.name,
							value = value_result.expr,
							span = field.span,
						})
			None:
				void

		index += 1

	compiler_infer_record_fields_result(compiler_infer_without_expected(next_context), typed_fields)


private pure func compiler_record_update_non_record_error(
	context: CompilerInferContext,
	base_type: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Record update requires a record type, got " + compiler_type_to_string(base_type),
	)


private pure func compiler_record_update_unknown_type_error(
	context: CompilerInferContext,
	type_name: String,
) -> CompilerInferContext:
	compiler_infer_error(context, "Type " + type_name + " is not a record")


private pure func compiler_infer_record_update_expr(
	context: CompilerInferContext,
	base: ParsedExpr,
	fields: List[ParsedRecordExprField],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	base_result = compiler_infer_expr(compiler_infer_without_expected(context), base)
	base_type = compiler_typed_expr_semantic_type(base_result.expr)

	match base_type:
		CompilerNamedType(record_name, args):
			match compiler_record_field_types(context, record_name, args):
				Some(expected_fields):
					fields_result = compiler_infer_record_update_fields(
						base_result.context,
						record_name,
						fields,
						expected_fields,
					)
					result_context = compiler_infer_context_with_state(context, fields_result.context.state)
					typed = CompilerTypedRecordUpdateExpr(
						base_result.expr,
						fields_result.fields,
						span,
						compiler_inferred_info(result_context, base_type),
					)
					compiler_infer_result(result_context, typed)
				None:
					next = compiler_record_update_unknown_type_error(base_result.context, record_name)
					fields_result = compiler_infer_unconstrained_record_fields(
						compiler_infer_without_expected(next),
						fields,
					)
					result_context = compiler_infer_context_with_state(context, fields_result.context.state)
					typed = CompilerTypedRecordUpdateExpr(
						base_result.expr,
						fields_result.fields,
						span,
						compiler_inferred_info(result_context, compiler_type_void()),
					)
					compiler_infer_result(result_context, typed)
		_:
			next = compiler_record_update_non_record_error(base_result.context, base_type)
			fields_result = compiler_infer_unconstrained_record_fields(
				compiler_infer_without_expected(next),
				fields,
			)
			result_context = compiler_infer_context_with_state(context, fields_result.context.state)
			typed = CompilerTypedRecordUpdateExpr(
				base_result.expr,
				fields_result.fields,
				span,
				compiler_inferred_info(result_context, compiler_type_void()),
			)
			compiler_infer_result(result_context, typed)


private pure func compiler_tuple_field_type(
	elements: List[CompilerType],
	field: String,
) -> Option[CompilerType]:
	match field.parse_int():
		Some(index):
			if index >= 0 and index < elements.length():
				elements.get(index).map(compiler_type_copy)
			else:
				None
		None:
			None


private pure func compiler_record_field_access_error(
	context: CompilerInferContext,
	typ: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Cannot access field on type "
			+ compiler_type_to_string(typ)
			+ ". Field access is supported on record fields. Use tuple[index] for tuple elements",
	)


private pure func compiler_infer_field_access_expr(
	context: CompilerInferContext,
	receiver: ParsedExpr,
	field: ParsedIdentifier,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	receiver_result = compiler_infer_expr(compiler_infer_without_expected(context), receiver)
	receiver_type = compiler_typed_expr_semantic_type(receiver_result.expr)

	match receiver_type:
		CompilerTupleType(elements):
			match compiler_tuple_field_type(elements, field.text):
				Some(field_type):
					result_context = compiler_infer_context_with_state(context, receiver_result.context.state)
					typed = CompilerTypedFieldAccessExpr(
						receiver_result.expr,
						field,
						span,
						compiler_inferred_info(result_context, field_type),
					)
					compiler_infer_result(result_context, typed)
				None:
					next = compiler_infer_error(
						receiver_result.context,
						"Tuple of arity "
							+ elements.length().to_string()
							+ " has no field "
							+ field.text,
					)
					typed = CompilerTypedFieldAccessExpr(
						receiver_result.expr,
						field,
						span,
						compiler_inferred_info(next, compiler_type_void()),
					)
					compiler_infer_result(next, typed)
		CompilerNamedType(name, args):
			if name == "Tuple":
				match compiler_tuple_field_type(args, field.text):
					Some(field_type):
						result_context = compiler_infer_context_with_state(context, receiver_result.context.state)
						typed = CompilerTypedFieldAccessExpr(
							receiver_result.expr,
							field,
							span,
							compiler_inferred_info(result_context, field_type),
						)
						compiler_infer_result(result_context, typed)
					None:
						next = compiler_infer_error(
							receiver_result.context,
							"Tuple of arity "
								+ args.length().to_string()
								+ " has no field "
								+ field.text,
						)
						typed = CompilerTypedFieldAccessExpr(
							receiver_result.expr,
							field,
							span,
							compiler_inferred_info(next, compiler_type_void()),
						)
						compiler_infer_result(next, typed)
			else:
				match compiler_record_field_types(context, name, args):
					Some(fields):
						match compiler_find_record_field(fields, field.text):
							Some(field_decl):
								result_context = compiler_infer_context_with_state(
									context,
									receiver_result.context.state,
								)
								typed = CompilerTypedFieldAccessExpr(
									receiver_result.expr,
									field,
									span,
									compiler_inferred_info(result_context, field_decl.field_type),
								)
								compiler_infer_result(result_context, typed)
							None:
								next = compiler_infer_error(
									receiver_result.context,
									"Record "
										+ name
										+ " has no field '"
										+ field.text
										+ "'. Valid fields: "
										+ compiler_record_field_names(fields).join(", "),
								)
								typed = CompilerTypedFieldAccessExpr(
									receiver_result.expr,
									field,
									span,
									compiler_inferred_info(next, compiler_type_void()),
								)
								compiler_infer_result(next, typed)
					None:
						next = compiler_record_field_access_error(receiver_result.context, receiver_type)
						typed = CompilerTypedFieldAccessExpr(
							receiver_result.expr,
							field,
							span,
							compiler_inferred_info(next, compiler_type_void()),
						)
						compiler_infer_result(next, typed)
		_:
			next = compiler_record_field_access_error(receiver_result.context, receiver_type)
			typed = CompilerTypedFieldAccessExpr(
				receiver_result.expr,
				field,
				span,
				compiler_inferred_info(next, compiler_type_void()),
			)
			compiler_infer_result(next, typed)


private pure func compiler_subscript_static_index(index_expr: ParsedExpr) -> Option[Int]:
	match index_expr:
		ParsedIntLiteralExpr(text, _):
			Some(compiler_parse_int_literal(text))
		ParsedUnaryExpr(ParsedNegateOp, ParsedIntLiteralExpr(text, _), _):
			Some(0 - compiler_parse_int_literal(text))
		_:
			None


private pure func compiler_infer_subscript_indices_result(
	context: CompilerInferContext,
	indices: List[CompilerTypedExpr],
	values: List[Int],
	all_static: Bool,
) -> CompilerInferSubscriptIndicesResult:
	{
		context = compiler_infer_context_copy(context),
		indices = indices,
		values = values,
		all_static = all_static
	}


private pure func compiler_static_subscript_index_error(
	context: CompilerInferContext,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Subscript index must be a compile-time integer literal. Use get() for runtime-checked access",
	)


private pure func compiler_infer_subscript_indices(
	context: CompilerInferContext,
	indices: List[ParsedExpr],
) -> CompilerInferSubscriptIndicesResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_indices: List[CompilerTypedExpr] = []
	var values: List[Int] = []
	var all_static: Bool = True
	var index: Int = 0

	while index < indices.length():
		match indices.get(index):
			Some(index_expr):
				index_result = compiler_infer_expr(
					compiler_infer_with_expected_value_slot(
						next_context,
						compiler_type_int(),
						CompilerExpectedArgumentSlot,
					),
					index_expr,
				)
				index_type = compiler_typed_expr_value_type(index_result.expr)
				type_context = if compiler_types_equal(index_type, compiler_type_int()):
					compiler_infer_context_copy(index_result.context)
				else:
					compiler_infer_error(
						index_result.context,
						"Subscript index must be Int, got " + compiler_type_to_string(index_type),
					)

				match compiler_subscript_static_index(index_expr):
					Some(value):
						values = values.append(value)
						next_context = compiler_infer_context_copy(type_context)
					None:
						values = values.append(0)
						all_static = False
						next_context = if compiler_types_equal(index_type, compiler_type_int()):
							compiler_static_subscript_index_error(type_context)
						else:
							compiler_infer_context_copy(type_context)

				typed_indices = typed_indices.append(index_result.expr)
			None:
				void

		index += 1

	compiler_infer_subscript_indices_result(
		compiler_infer_without_expected(next_context),
		typed_indices,
		values,
		all_static,
	)


private pure func compiler_subscript_single_index_value(values: List[Int]) -> Int:
	match values.get(0):
		Some(value):
			value
		None:
			0


private pure func compiler_subscript_tuple_error(
	context: CompilerInferContext,
	message: String,
) -> CompilerInferContext:
	compiler_infer_error(context, message)


private pure func compiler_subscript_tuple_result_type(
	elements: List[CompilerType],
	values: List[Int],
) -> CompilerType:
	index_value = compiler_subscript_single_index_value(values)
	match elements.get(index_value):
		Some(element):
			compiler_type_copy(element)
		None:
			compiler_type_void()


private pure func compiler_validate_tuple_subscript(
	context: CompilerInferContext,
	elements: List[CompilerType],
	values: List[Int],
	index_count: Int,
	all_static: Bool,
) -> CompilerInferContext:
	if index_count != 1:
		compiler_subscript_tuple_error(
			context,
			"Tuple subscript expects exactly one index, got " + index_count.to_string(),
		)
	else if all_static:
		index_value = compiler_subscript_single_index_value(values)
		if index_value < 0 or index_value >= elements.length():
			compiler_subscript_tuple_error(
				context,
				"Tuple index "
					+ index_value.to_string()
					+ " out of bounds for tuple of arity "
					+ elements.length().to_string(),
			)
		else:
			compiler_infer_context_copy(context)
	else:
		compiler_infer_context_copy(context)


private pure func compiler_array_subscript_result_type(
	element_type: CompilerType,
	dims: List[CompilerType],
	index_count: Int,
) -> CompilerType:
	if index_count == 1:
		compiler_vector_item_type(element_type, dims)
	else:
		compiler_type_copy(element_type)


private pure func compiler_subscript_resolved_index(
	index_value: Int,
	size: Int,
) -> Int:
	if index_value < 0:
		size + index_value
	else:
		index_value


private pure func compiler_validate_array_index(
	context: CompilerInferContext,
	index_value: Int,
	dim: CompilerType,
) -> CompilerInferContext:
	match dim:
		CompilerConstIntType(size):
			resolved_index = compiler_subscript_resolved_index(index_value, size)
			if resolved_index < 0:
				compiler_infer_error(
					context,
					"Negative index "
						+ index_value.to_string()
						+ " out of bounds for dimension of size "
						+ size.to_string()
						+ " (resolves to "
						+ resolved_index.to_string()
						+ ")",
				)
			else if resolved_index >= size:
				compiler_infer_error(
					context,
					"Index "
						+ index_value.to_string()
						+ " out of bounds for dimension of size "
						+ size.to_string(),
				)
			else:
				compiler_infer_context_copy(context)
		_:
			compiler_infer_error(
				context,
				"Cannot verify bounds: dimension is not known at compile time",
			)


private pure func compiler_validate_array_subscript_indices(
	context: CompilerInferContext,
	dims: List[CompilerType],
	values: List[Int],
	all_static: Bool,
) -> CompilerInferContext:
	if not all_static:
		compiler_infer_context_copy(context)
	else:
		var next_context: CompilerInferContext = compiler_infer_context_copy(context)
		var index: Int = 0

		while index < values.length() and index < dims.length():
			match (values.get(index), dims.get(index)):
				(Some(index_value), Some(dim)):
					next_context = compiler_validate_array_index(next_context, index_value, dim)
				_:
					void

			index += 1

		next_context


private pure func compiler_array_subscript_arity_error(
	context: CompilerInferContext,
	index_count: Int,
	dim_count: Int,
) -> CompilerInferContext:
	if index_count == 1:
		compiler_infer_context_copy(context)
	else:
		compiler_infer_error(
			context,
			"Multi-index subscript has "
				+ index_count.to_string()
				+ " indices but array has "
				+ dim_count.to_string()
				+ " dimensions",
		)


private pure func compiler_validate_array_subscript(
	context: CompilerInferContext,
	dims: List[CompilerType],
	values: List[Int],
	index_count: Int,
	all_static: Bool,
) -> CompilerInferContext:
	if dims.length() == 0:
		compiler_infer_error(context, "checked_get requires an array type, got empty dimensions")
	else if index_count == 1 or index_count == dims.length():
		compiler_validate_array_subscript_indices(context, dims, values, all_static)
	else:
		compiler_array_subscript_arity_error(context, index_count, dims.length())


private pure func compiler_non_array_subscript_error(
	context: CompilerInferContext,
	typ: CompilerType,
	index_count: Int,
) -> CompilerInferContext:
	match typ:
		CompilerNamedType(name, _):
			if name == "List":
				compiler_infer_error(
					context,
					"checked_get is not supported on List. Use get(list, index) for bounds-checked access",
				)
			else if name == "String":
				compiler_infer_error(
					context,
					"checked_get is not supported on String. Use get(str, index) for bounds-checked access",
				)
			else if index_count == 1:
				compiler_infer_error(
					context,
					"checked_get requires an array type, got " + compiler_type_to_string(typ),
				)
			else:
				compiler_infer_error(
					context,
					"Type "
						+ compiler_type_to_string(typ)
						+ " does not support multi-index subscript. Multi-index subscript is supported on array types",
				)
		_:
			if index_count == 1:
				compiler_infer_error(
					context,
					"checked_get requires an array type, got " + compiler_type_to_string(typ),
				)
			else:
				compiler_infer_error(
					context,
					"Type "
						+ compiler_type_to_string(typ)
						+ " does not support multi-index subscript. Multi-index subscript is supported on array types",
				)


private pure func compiler_subscript_type_if_no_errors(
	context: CompilerInferContext,
	original_error_count: Int,
	typ: CompilerType,
) -> CompilerType:
	if context.state.errors.length() == original_error_count:
		compiler_type_copy(typ)
	else:
		compiler_type_void()


private pure func compiler_infer_subscript_result(
	context: CompilerInferContext,
	next_context: CompilerInferContext,
	receiver: CompilerTypedExpr,
	indices: List[CompilerTypedExpr],
	span: CompilerSourceSpan,
	result_type: CompilerType,
) -> CompilerInferResult:
	result_context = compiler_infer_context_with_state(context, next_context.state)
	typed = CompilerTypedSubscriptExpr(
		receiver,
		indices,
		span,
		compiler_inferred_info(result_context, result_type),
	)
	compiler_infer_result(result_context, typed)


private pure func compiler_infer_tuple_subscript_result(
	context: CompilerInferContext,
	receiver: CompilerTypedExpr,
	index_result: CompilerInferSubscriptIndicesResult,
	elements: List[CompilerType],
	index_count: Int,
	span: CompilerSourceSpan,
	original_error_count: Int,
) -> CompilerInferResult:
	next_context = compiler_validate_tuple_subscript(
		index_result.context,
		elements,
		index_result.values,
		index_count,
		index_result.all_static,
	)
	result_type = compiler_subscript_type_if_no_errors(
		next_context,
		original_error_count,
		compiler_subscript_tuple_result_type(elements, index_result.values),
	)
	compiler_infer_subscript_result(
		context,
		next_context,
		receiver,
		index_result.indices,
		span,
		result_type,
	)


private pure func compiler_infer_array_subscript_result(
	context: CompilerInferContext,
	receiver: CompilerTypedExpr,
	index_result: CompilerInferSubscriptIndicesResult,
	element_type: CompilerType,
	dims: List[CompilerType],
	index_count: Int,
	span: CompilerSourceSpan,
	original_error_count: Int,
) -> CompilerInferResult:
	next_context = compiler_validate_array_subscript(
		index_result.context,
		dims,
		index_result.values,
		index_count,
		index_result.all_static,
	)
	result_type = compiler_subscript_type_if_no_errors(
		next_context,
		original_error_count,
		compiler_array_subscript_result_type(element_type, dims, index_count),
	)
	compiler_infer_subscript_result(
		context,
		next_context,
		receiver,
		index_result.indices,
		span,
		result_type,
	)


private pure func compiler_infer_unsupported_subscript_result(
	context: CompilerInferContext,
	receiver: CompilerTypedExpr,
	index_result: CompilerInferSubscriptIndicesResult,
	receiver_type: CompilerType,
	index_count: Int,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	next_context = compiler_non_array_subscript_error(
		index_result.context,
		receiver_type,
		index_count,
	)
	compiler_infer_subscript_result(
		context,
		next_context,
		receiver,
		index_result.indices,
		span,
		compiler_type_void(),
	)


private pure func compiler_infer_subscript_expr(
	context: CompilerInferContext,
	receiver: ParsedExpr,
	indices: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	original_error_count = context.state.errors.length()
	receiver_result = compiler_infer_expr(compiler_infer_without_expected(context), receiver)
	index_result = compiler_infer_subscript_indices(receiver_result.context, indices)
	receiver_type = compiler_typed_expr_semantic_type(receiver_result.expr)
	index_count = indices.length()

	match receiver_type:
		CompilerTupleType(elements):
			compiler_infer_tuple_subscript_result(
				context,
				receiver_result.expr,
				index_result,
				elements,
				index_count,
				span,
				original_error_count,
			)
		CompilerNamedType(name, args):
			if name == "Tuple":
				compiler_infer_tuple_subscript_result(
					context,
					receiver_result.expr,
					index_result,
					args,
					index_count,
					span,
					original_error_count,
				)
			else:
				match compiler_array_type_parts(receiver_type):
					Some((element_type, dims)):
						compiler_infer_array_subscript_result(
							context,
							receiver_result.expr,
							index_result,
							element_type,
							dims,
							index_count,
							span,
							original_error_count,
						)
					None:
						compiler_infer_unsupported_subscript_result(
							context,
							receiver_result.expr,
							index_result,
							receiver_type,
							index_count,
							span,
						)
		_:
			match compiler_array_type_parts(receiver_type):
				Some((element_type, dims)):
					compiler_infer_array_subscript_result(
						context,
						receiver_result.expr,
						index_result,
						element_type,
						dims,
						index_count,
						span,
						original_error_count,
					)
				None:
					compiler_infer_unsupported_subscript_result(
						context,
						receiver_result.expr,
						index_result,
						receiver_type,
						index_count,
						span,
					)


private pure func compiler_subscript_assignment_root(target: ParsedExpr) -> Option[String]:
	match target:
		ParsedNameExpr(name):
			Some(name.text)
		ParsedFieldAccessExpr(receiver, _, _):
			compiler_subscript_assignment_root(receiver)
		_:
			None


private record CompilerSubscriptAssignmentMutabilityResult {
	context: CompilerInferContext,
	assign_target: Option[CompilerTypedAssignTarget]
}


private pure func compiler_typed_assign_target(
	name: String,
	scope: CompilerTypedAssignScope,
) -> CompilerTypedAssignTarget:
	{
		name = name.substring(0, name.length()),
		scope = scope
	}


private pure func compiler_subscript_assignment_mutability_result(
	context: CompilerInferContext,
	assign_target: Option[CompilerTypedAssignTarget],
) -> CompilerSubscriptAssignmentMutabilityResult:
	target_copy: Option[CompilerTypedAssignTarget] = match assign_target:
		Some(target):
			Some({
				name = target.name.substring(0, target.name.length()),
				scope = target.scope
			})
		None:
			None

	{
		context = compiler_infer_context_copy(context),
		assign_target = target_copy
	}


private pure func compiler_subscript_assignment_mutability(
	context: CompilerInferContext,
	target: ParsedExpr,
) -> CompilerSubscriptAssignmentMutabilityResult:
	match compiler_subscript_assignment_root(target):
		Some(name):
			match compiler_env_lookup_with_scope_depth(context.state.env, name):
				Some(lookup):
					match lookup.symbol.kind:
						CompilerVarSymbolKind(var_symbol):
							match var_symbol.mutability:
								CompilerImmutableBinding:
									compiler_subscript_assignment_mutability_result(
										compiler_infer_error(
											context,
											"Cannot assign to subscript of immutable variable '" + name + "'",
										),
										None,
									)
								CompilerMutableBinding:
									compiler_subscript_assignment_mutability_result(
										context,
										Some(compiler_typed_assign_target(
												name,
												compiler_assign_scope_from_lookup(context, lookup),
											)),
									)
						_:
							compiler_subscript_assignment_mutability_result(context, None)
				None:
					compiler_subscript_assignment_mutability_result(context, None)
		None:
			compiler_subscript_assignment_mutability_result(context, None)


private pure func compiler_subscript_assignment_arity_error(
	context: CompilerInferContext,
	index_count: Int,
	dim_count: Int,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Subscript assignment has "
			+ index_count.to_string()
			+ " indices but tensor has "
			+ dim_count.to_string()
			+ " dimensions",
	)


private pure func compiler_validate_array_subscript_assignment(
	context: CompilerInferContext,
	dims: List[CompilerType],
	values: List[Int],
	index_count: Int,
	all_static: Bool,
) -> CompilerInferContext:
	if index_count != dims.length():
		compiler_subscript_assignment_arity_error(context, index_count, dims.length())
	else:
		compiler_validate_array_subscript_indices(context, dims, values, all_static)


private pure func compiler_subscript_assignment_value_mismatch_error(
	context: CompilerInferContext,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Cannot assign "
			+ compiler_type_to_string(got)
			+ " to tensor element of type "
			+ compiler_type_to_string(expected),
	)


private pure func compiler_subscript_assignment_target_error(
	context: CompilerInferContext,
	target_type: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Type "
			+ compiler_type_to_string(target_type)
			+ " does not support subscript assignment. Subscript assignment is supported on array types",
	)


private pure func compiler_infer_subscript_assign_result(
	context: CompilerInferContext,
	next_context: CompilerInferContext,
	assign_target: Option[CompilerTypedAssignTarget],
	target: CompilerTypedExpr,
	indices: List[CompilerTypedExpr],
	value: CompilerTypedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	result_context = compiler_infer_context_with_state(context, next_context.state)
	typed = CompilerTypedSubscriptAssignExpr(
		assign_target,
		target,
		indices,
		value,
		span,
		compiler_inferred_info(result_context, compiler_type_void()),
	)
	compiler_infer_result(result_context, typed)


private pure func compiler_infer_subscript_assignment_value(
	context: CompilerInferContext,
	expected_type: Option[CompilerType],
	value: ParsedExpr,
) -> CompilerInferResult:
	match expected_type:
		Some(typ):
			compiler_infer_expr(
				compiler_infer_with_expected_value_slot(context, typ, CompilerExpectedArgumentSlot),
				value,
			)
		None:
			compiler_infer_expr(compiler_infer_without_expected(context), value)


private pure func compiler_infer_array_subscript_assign_expr(
	context: CompilerInferContext,
	target_result: CompilerInferResult,
	index_result: CompilerInferSubscriptIndicesResult,
	assign_target: Option[CompilerTypedAssignTarget],
	value: ParsedExpr,
	element_type: CompilerType,
	dims: List[CompilerType],
	index_count: Int,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	indices_context = compiler_validate_array_subscript_assignment(
		index_result.context,
		dims,
		index_result.values,
		index_count,
		index_result.all_static,
	)
	value_result = compiler_infer_subscript_assignment_value(
		indices_context,
		Some(element_type),
		value,
	)
	value_type = compiler_typed_expr_value_type(value_result.expr)
	next_context = if compiler_types_equal(value_type, element_type):
		compiler_infer_context_copy(value_result.context)
	else:
		compiler_subscript_assignment_value_mismatch_error(
			value_result.context,
			element_type,
			value_type,
		)

	compiler_infer_subscript_assign_result(
		context,
		next_context,
		assign_target,
		target_result.expr,
		index_result.indices,
		value_result.expr,
		span,
	)


private pure func compiler_infer_invalid_subscript_assign_expr(
	context: CompilerInferContext,
	target_result: CompilerInferResult,
	index_result: CompilerInferSubscriptIndicesResult,
	assign_target: Option[CompilerTypedAssignTarget],
	value: ParsedExpr,
	target_type: CompilerType,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	target_context = compiler_subscript_assignment_target_error(
		index_result.context,
		target_type,
	)
	value_result = compiler_infer_subscript_assignment_value(target_context, None, value)
	compiler_infer_subscript_assign_result(
		context,
		value_result.context,
		assign_target,
		target_result.expr,
		index_result.indices,
		value_result.expr,
		span,
	)


private pure func compiler_infer_subscript_assign_expr(
	context: CompilerInferContext,
	target: ParsedExpr,
	indices: List[ParsedExpr],
	value: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	mutability = compiler_subscript_assignment_mutability(context, target)
	target_result = compiler_infer_expr(compiler_infer_without_expected(mutability.context), target)
	index_result = compiler_infer_subscript_indices(target_result.context, indices)
	target_type = compiler_typed_expr_semantic_type(target_result.expr)
	index_count = indices.length()

	match compiler_array_type_parts(target_type):
		Some((element_type, dims)):
			compiler_infer_array_subscript_assign_expr(
				context,
				target_result,
				index_result,
				mutability.assign_target,
				value,
				element_type,
				dims,
				index_count,
				span,
			)
		None:
			compiler_infer_invalid_subscript_assign_expr(
				context,
				target_result,
				index_result,
				mutability.assign_target,
				value,
				target_type,
				span,
			)


private pure func compiler_range_endpoint_error(
	context: CompilerInferContext,
	label: String,
	typ: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Range " + label + " must be Int, got " + compiler_type_to_string(typ),
	)


private pure func compiler_infer_range_expr(
	context: CompilerInferContext,
	start_expr: ParsedExpr,
	end_expr: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	start_result = compiler_infer_expr(
		compiler_infer_with_expected_value_slot(
			context,
			compiler_type_int(),
			CompilerExpectedArgumentSlot,
		),
		start_expr,
	)
	start_type = compiler_typed_expr_value_type(start_result.expr)
	start_context = if compiler_named_value_type_is(start_type, "Int"):
		compiler_infer_context_copy(start_result.context)
	else:
		compiler_range_endpoint_error(start_result.context, "start", start_type)
	end_result = compiler_infer_expr(
		compiler_infer_with_expected_value_slot(
			start_context,
			compiler_type_int(),
			CompilerExpectedArgumentSlot,
		),
		end_expr,
	)
	end_type = compiler_typed_expr_value_type(end_result.expr)
	result_context = if compiler_named_value_type_is(end_type, "Int"):
		compiler_infer_context_with_state(context, end_result.context.state)
	else:
		compiler_infer_context_with_state(
			context,
			compiler_range_endpoint_error(end_result.context, "end", end_type).state,
		)
	typed = CompilerTypedRangeExpr(
		start_result.expr,
		end_result.expr,
		span,
		compiler_inferred_info(result_context, compiler_type_range()),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_pattern_type_error(
	context: CompilerInferContext,
	pattern_label: String,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		pattern_label
			+ " pattern requires "
			+ compiler_type_to_string(expected)
			+ " scrutinee, got "
			+ compiler_type_to_string(got),
	)


private pure func compiler_infer_pattern_result(
	context: CompilerInferContext,
	env: CompilerEnv,
	pattern: CompilerTypedPattern,
	catch_all: Bool,
	matches_true: Bool,
	matches_false: Bool,
) -> CompilerInferPatternResult:
	{
		context = compiler_infer_context_copy(context),
		env = env,
		pattern = pattern,
		catch_all = catch_all,
		matches_true = matches_true,
		matches_false = matches_false
	}


private pure func compiler_add_match_binding(
	env: CompilerEnv,
	name: ParsedIdentifier,
	typ: CompilerType,
) -> CompilerEnv:
	compiler_env_add_var_with_details(
		env,
		name.text,
		compiler_type_copy(typ),
		Some(compiler_type_copy(typ)),
		CompilerImmutableBinding,
		CompilerMatchBinding,
		compiler_unrefined_binding(),
	)


private pure func compiler_infer_pattern(
	context: CompilerInferContext,
	env: CompilerEnv,
	pattern: ParsedPattern,
	scrutinee_type: CompilerType,
) -> CompilerInferPatternResult:
	match pattern:
		ParsedWildcardPattern(span):
			compiler_infer_pattern_result(
				context,
				env,
				CompilerTypedWildcardPattern(span),
				True,
				False,
				False,
			)
		ParsedNamePattern(name):
			next_env = compiler_add_match_binding(env, name, scrutinee_type)
			compiler_infer_pattern_result(
				context,
				next_env,
				CompilerTypedNamePattern(name, scrutinee_type),
				True,
				False,
				False,
			)
		ParsedBoolPattern(value, span):
			next_context = if compiler_named_value_type_is(scrutinee_type, "Bool"):
				compiler_infer_context_copy(context)
			else:
				compiler_pattern_type_error(context, "Bool", compiler_type_bool(), scrutinee_type)
			compiler_infer_pattern_result(
				next_context,
				env,
				CompilerTypedBoolPattern(value, span),
				False,
				value,
				not value,
			)
		ParsedIntPattern(text, span):
			next_context = if compiler_is_any_integer_type(scrutinee_type) or compiler_named_value_type_is(scrutinee_type, "Int"):
				compiler_infer_context_copy(context)
			else:
				compiler_pattern_type_error(context, "Int", compiler_type_int(), scrutinee_type)
			compiler_infer_pattern_result(
				next_context,
				env,
				CompilerTypedIntPattern(text, span),
				False,
				False,
				False,
			)
		ParsedStringPattern(value, _, span):
			next_context = if compiler_named_value_type_is(scrutinee_type, "String"):
				compiler_infer_context_copy(context)
			else:
				compiler_pattern_type_error(context, "String", compiler_type_string(), scrutinee_type)
			compiler_infer_pattern_result(
				next_context,
				env,
				CompilerTypedStringPattern(value, span),
				False,
				False,
				False,
			)
		ParsedCharPattern(value, span):
			next_context = if compiler_named_value_type_is(scrutinee_type, "Char"):
				compiler_infer_context_copy(context)
			else:
				compiler_pattern_type_error(context, "Char", compiler_type_char(), scrutinee_type)
			compiler_infer_pattern_result(
				next_context,
				env,
				CompilerTypedCharPattern(value, span),
				False,
				False,
				False,
			)
		ParsedFloatPattern(_, span):
			compiler_infer_pattern_result(
				compiler_infer_error(context, "Float match patterns are not yet supported in Blorp inference"),
				env,
				CompilerTypedUnsupportedPattern("float", span),
				False,
				False,
				False,
			)
		ParsedConstructorPattern(name, _, _):
			compiler_infer_pattern_result(
				compiler_infer_error(context, "Constructor match patterns are not yet supported in Blorp inference"),
				env,
				CompilerTypedUnsupportedPattern("constructor", name.span),
				False,
				False,
				False,
			)
		ParsedQualifiedConstructorPattern(module_name, _, _, _):
			compiler_infer_pattern_result(
				compiler_infer_error(context, "Qualified constructor match patterns are not yet supported in Blorp inference"),
				env,
				CompilerTypedUnsupportedPattern("qualified constructor", module_name.span),
				False,
				False,
				False,
			)
		ParsedTuplePattern(_, span):
			compiler_infer_pattern_result(
				compiler_infer_error(context, "Tuple match patterns are not yet supported in Blorp inference"),
				env,
				CompilerTypedUnsupportedPattern("tuple", span),
				False,
				False,
				False,
			)
		ParsedListPattern(_, _, span):
			compiler_infer_pattern_result(
				compiler_infer_error(context, "List match patterns are not yet supported in Blorp inference"),
				env,
				CompilerTypedUnsupportedPattern("list", span),
				False,
				False,
				False,
			)
		ParsedOrPattern(_, span):
			compiler_infer_pattern_result(
				compiler_infer_error(context, "Or match patterns are not yet supported in Blorp inference"),
				env,
				CompilerTypedUnsupportedPattern("or", span),
				False,
				False,
				False,
			)
		ParsedMissingPattern(span):
			compiler_infer_pattern_result(
				compiler_infer_error(context, "Missing match pattern"),
				env,
				CompilerTypedUnsupportedPattern("missing", span),
				False,
				False,
				False,
			)


private pure func compiler_match_type_mismatch_error(
	context: CompilerInferContext,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Match branch type mismatch: expected "
			+ compiler_type_to_string(expected)
			+ ", got "
			+ compiler_type_to_string(got),
	)


private pure func compiler_match_result_type(
	context: CompilerInferContext,
	current_type: Option[CompilerType],
	branch_type: CompilerType,
) -> CompilerMatchResultTypeResult:
	match current_type:
		None:
			{
				context = compiler_infer_context_copy(context),
				result_type = Some(compiler_type_copy(branch_type))
			}
		Some(expected):
			match compiler_common_inferred_type(expected, branch_type):
				Some(common_type):
					{
						context = compiler_infer_context_copy(context),
						result_type = Some(common_type)
					}
				None:
					{
						context = compiler_match_type_mismatch_error(context, expected, branch_type),
						result_type = Some(expected)
					}


private pure func compiler_infer_match_cases_result(
	context: CompilerInferContext,
	cases: List[CompilerTypedMatchCase],
	result_type: Option[CompilerType],
	catch_all: Bool,
	matches_true: Bool,
	matches_false: Bool,
) -> CompilerInferMatchCasesResult:
	{
		context = compiler_infer_context_copy(context),
		cases = cases,
		result_type = compiler_optional_type_copy(result_type),
		catch_all = catch_all,
		matches_true = matches_true,
		matches_false = matches_false
	}


private pure func compiler_match_body_context(
	context: CompilerInferContext,
) -> CompilerInferContext:
	match context.expected_type:
		Some(expected):
			compiler_infer_with_expected_value_slot(context, expected, CompilerExpectedArgumentSlot)
		None:
			compiler_infer_without_expected(context)


private pure func compiler_infer_match_cases(
	context: CompilerInferContext,
	cases: List[ParsedMatchCase],
	scrutinee_type: CompilerType,
) -> CompilerInferMatchCasesResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_cases: List[CompilerTypedMatchCase] = []
	var result_type: Option[CompilerType] = None
	var catch_all: Bool = False
	var matches_true: Bool = False
	var matches_false: Bool = False
	var index: Int = 0

	while index < cases.length():
		match cases.get(index):
			Some(case):
				case_env = compiler_env_push_scope(next_context.state.env)
				pattern_result = compiler_infer_pattern(next_context, case_env, case.pattern, scrutinee_type)
				case_state = compiler_typecheck_state_with_env(pattern_result.context.state, pattern_result.env)
				case_context = compiler_infer_context_with_state(pattern_result.context, case_state)
				body_result = compiler_infer_expr(compiler_match_body_context(case_context), case.body)
				branch_type = compiler_typed_expr_semantic_type(body_result.expr)
				result_pair = compiler_match_result_type(
					body_result.context,
					result_type,
					branch_type,
				)
				next_context = result_pair.context
				result_type = result_pair.result_type
				outer_env = compiler_env_pop_scope(next_context.state.env)
				outer_state = compiler_typecheck_state_with_env(next_context.state, outer_env)
				next_context = compiler_infer_context_with_state(context, outer_state)
				typed_cases = typed_cases.append({
					pattern = pattern_result.pattern,
					body = body_result.expr,
					span = case.span
				})
				catch_all = catch_all or pattern_result.catch_all
				matches_true = matches_true or pattern_result.matches_true
				matches_false = matches_false or pattern_result.matches_false
			None:
				void

		index += 1

	compiler_infer_match_cases_result(next_context, typed_cases, result_type, catch_all, matches_true, matches_false)


private pure func compiler_bool_match_exhaustiveness_error(
	context: CompilerInferContext,
	matches_true: Bool,
	matches_false: Bool,
) -> CompilerInferContext:
	if matches_true and matches_false:
		compiler_infer_context_copy(context)
	else:
		missing = if not matches_true and not matches_false:
			"True and False"
		else if not matches_true:
			"True"
		else:
			"False"
		compiler_infer_error(context, "Non-exhaustive match on Bool: missing " + missing)


private pure func compiler_check_match_exhaustiveness(
	context: CompilerInferContext,
	scrutinee_type: CompilerType,
	catch_all: Bool,
	matches_true: Bool,
	matches_false: Bool,
) -> CompilerInferContext:
	if catch_all:
		compiler_infer_context_copy(context)
	else if compiler_named_value_type_is(scrutinee_type, "Bool"):
		compiler_bool_match_exhaustiveness_error(context, matches_true, matches_false)
	else:
		compiler_infer_context_copy(context)


private pure func compiler_infer_match_expr(
	context: CompilerInferContext,
	scrutinee: ParsedExpr,
	cases: List[ParsedMatchCase],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	scrutinee_result = compiler_infer_expr(compiler_infer_without_expected(context), scrutinee)
	scrutinee_type = compiler_typed_expr_semantic_type(scrutinee_result.expr)

	if cases.length() == 0:
		next = compiler_infer_error(scrutinee_result.context, "match expression must have at least one case")
		typed = CompilerTypedMatchExpr(
			scrutinee_result.expr,
			[],
			span,
			compiler_inferred_info(next, compiler_type_void()),
		)
		compiler_infer_result(next, typed)
	else:
		cases_result = compiler_infer_match_cases(scrutinee_result.context, cases, scrutinee_type)
		exhaustive_context = compiler_check_match_exhaustiveness(
			cases_result.context,
			scrutinee_type,
			cases_result.catch_all,
			cases_result.matches_true,
			cases_result.matches_false,
		)
		result_type = match cases_result.result_type:
			Some(typ):
				compiler_type_copy(typ)
			None:
				compiler_type_void()
		result_context = compiler_infer_context_with_state(context, exhaustive_context.state)
		typed = CompilerTypedMatchExpr(
			scrutinee_result.expr,
			cases_result.cases,
			span,
			compiler_inferred_info(result_context, result_type),
		)
		compiler_infer_result(result_context, typed)


private pure func compiler_condition_error(
	context: CompilerInferContext,
	kind: String,
	condition_type: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		kind + " condition must be Bool, got " + compiler_type_to_string(condition_type),
	)


private pure func compiler_if_without_else_error(
	context: CompilerInferContext,
	then_type: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"if-expression without else cannot produce a value; then-branch returns "
			+ compiler_type_to_string(then_type),
	)


private pure func compiler_if_type_mismatch_error(
	context: CompilerInferContext,
	then_type: CompilerType,
	else_type: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"If-else type mismatch: then-branch returns "
			+ compiler_type_to_string(then_type)
			+ ", else-branch returns "
			+ compiler_type_to_string(else_type),
	)


private pure func compiler_infer_if_expr(
	context: CompilerInferContext,
	condition: ParsedExpr,
	then_branch: ParsedExpr,
	else_branch: Option[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	condition_result = compiler_infer_expr(compiler_infer_without_expected(context), condition)
	condition_type = compiler_typed_expr_semantic_type(condition_result.expr)
	condition_context = if compiler_named_value_type_is(condition_type, "Bool"):
		compiler_infer_context_copy(condition_result.context)
	else:
		compiler_condition_error(condition_result.context, "If", condition_type)
	branch_context = match else_branch:
		Some(_):
			compiler_infer_context_with_state(context, condition_context.state)
		None:
			compiler_infer_without_expected(compiler_infer_context_with_state(context, condition_context.state))
	then_result = compiler_infer_expr(branch_context, then_branch)
	then_type = compiler_typed_expr_semantic_type(then_result.expr)

	match else_branch:
		None:
			next_context = if compiler_types_equal(then_type, compiler_type_void()):
				compiler_infer_context_copy(then_result.context)
			else:
				compiler_if_without_else_error(then_result.context, then_type)
			typed = CompilerTypedIfExpr(
				condition_result.expr,
				then_result.expr,
				None,
				span,
				compiler_inferred_info(next_context, compiler_type_void()),
			)
			compiler_infer_result(next_context, typed)
		Some(else_expr):
			else_result = compiler_infer_expr(
				compiler_infer_context_with_state(context, then_result.context.state),
				else_expr,
			)
			else_type = compiler_typed_expr_semantic_type(else_result.expr)
			match compiler_common_inferred_type(then_type, else_type):
				Some(result_type):
					result_context = compiler_infer_context_with_state(context, else_result.context.state)
					typed = CompilerTypedIfExpr(
						condition_result.expr,
						then_result.expr,
						Some(else_result.expr),
						span,
						compiler_inferred_info(result_context, result_type),
					)
					compiler_infer_result(result_context, typed)
				None:
					next_context = compiler_if_type_mismatch_error(
						else_result.context,
						then_type,
						else_type,
					)
					typed = CompilerTypedIfExpr(
						condition_result.expr,
						then_result.expr,
						Some(else_result.expr),
						span,
						compiler_inferred_info(next_context, compiler_type_void()),
					)
					compiler_infer_result(next_context, typed)


private pure func compiler_infer_while_expr(
	context: CompilerInferContext,
	condition: ParsedExpr,
	body: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	condition_result = compiler_infer_expr(
		compiler_infer_with_expected_value_slot(
			context,
			compiler_type_bool(),
			CompilerExpectedArgumentSlot,
		),
		condition,
	)
	condition_type = compiler_typed_expr_value_type(condition_result.expr)
	condition_context = if compiler_named_value_type_is(condition_type, "Bool"):
		compiler_infer_context_copy(condition_result.context)
	else:
		compiler_condition_error(condition_result.context, "While", condition_type)
	body_result = compiler_infer_expr(compiler_infer_inside_loop(condition_context), body)
	result_context = compiler_infer_context_with_state(context, body_result.context.state)
	typed = CompilerTypedWhileExpr(
		condition_result.expr,
		body_result.expr,
		span,
		compiler_inferred_info(result_context, compiler_type_void()),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_infer_break_expr(
	context: CompilerInferContext,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	next_context = if context.in_loop:
		compiler_infer_context_copy(context)
	else:
		compiler_infer_error(context, "'break' can only be used inside a loop")
	typed = CompilerTypedBreakExpr(span, compiler_inferred_info(next_context, compiler_type_void()))

	compiler_infer_result(next_context, typed)


private pure func compiler_infer_continue_expr(
	context: CompilerInferContext,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	next_context = if context.in_loop:
		compiler_infer_context_copy(context)
	else:
		compiler_infer_error(context, "'continue' can only be used inside a loop")
	typed = CompilerTypedContinueExpr(span, compiler_inferred_info(next_context, compiler_type_void()))

	compiler_infer_result(next_context, typed)


private pure func compiler_array_loop_element_type(
	element_type: CompilerType,
	dims: List[CompilerType],
) -> Option[CompilerType]:
	if dims.length() == 0:
		None
	else if dims.length() == 1:
		Some(compiler_type_copy(element_type))
	else:
		var rest: List[CompilerType] = []
		var index: Int = 1

		while index < dims.length():
			match dims.get(index):
				Some(dim):
					rest = rest.append(compiler_type_copy(dim))
				None:
					void

			index += 1

		Some(CompilerArrayType(compiler_type_copy(element_type), rest))


private pure func compiler_iterable_element_type(typ: CompilerType) -> Option[CompilerType]:
	match typ:
		CompilerNamedType(name, args):
			if name == "Range" and args.length() == 0:
				Some(compiler_type_int())
			else if name == "String" and args.length() == 0:
				Some(compiler_type_char())
			else if (name == "List" or name == "Set" or name == "Vector") and args.length() == 1:
				args.get(0).map(compiler_type_copy)
			else:
				None
		CompilerArrayType(element_type, dims):
			compiler_array_loop_element_type(element_type, dims)
		_:
			None


private pure func compiler_for_iterable_error(
	context: CompilerInferContext,
	iterable_type: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Cannot iterate over type "
			+ compiler_type_to_string(iterable_type)
			+ ". For-in loops work with List, Vector, Set, String, and Range types",
	)


private pure func compiler_for_tuple_elements_result(
	context: CompilerInferContext,
	elements: List[CompilerType],
	ok: Bool,
) -> CompilerForTupleElementsResult:
	{
		context = compiler_infer_context_copy(context),
		elements = elements.map(compiler_type_copy),
		ok = ok
	}


private pure func compiler_tuple_elements_from_type(
	typ: CompilerType,
) -> Option[List[CompilerType]]:
	match typ:
		CompilerTupleType(elements):
			Some(elements.map(compiler_type_copy))
		CompilerNamedType(name, args):
			if name == "Tuple":
				Some(args.map(compiler_type_copy))
			else:
				None
		_:
			None


private pure func compiler_for_tuple_elements_from_iterable_element(
	context: CompilerInferContext,
	element_type: CompilerType,
) -> CompilerForTupleElementsResult:
	match compiler_tuple_elements_from_type(element_type):
		Some(elements):
			compiler_for_tuple_elements_result(context, elements, True)
		None:
			next = compiler_infer_error(
				context,
				"Tuple for-loop requires iterable elements to be tuples, got "
					+ compiler_type_to_string(element_type),
			)
			compiler_for_tuple_elements_result(next, [], False)


private pure func compiler_for_tuple_iterable_error(
	context: CompilerInferContext,
	iterable_type: CompilerType,
) -> CompilerForTupleElementsResult:
	next = compiler_infer_error(
		context,
		"Cannot iterate over type "
			+ compiler_type_to_string(iterable_type)
			+ ". Tuple for-in loops work with Dict and iterables of tuples",
	)
	compiler_for_tuple_elements_result(next, [], False)


private pure func compiler_for_tuple_element_types(
	context: CompilerInferContext,
	iterable_type: CompilerType,
) -> CompilerForTupleElementsResult:
	match iterable_type:
		CompilerNamedType(name, args):
			if name == "Dict" and args.length() == 2:
				match (args.get(0), args.get(1)):
					(Some(key_type), Some(value_type)):
						compiler_for_tuple_elements_result(
							context,
							[compiler_type_copy(key_type), compiler_type_copy(value_type)],
							True,
						)
					_:
						compiler_for_tuple_elements_result(context, [], False)
			else:
				match compiler_iterable_element_type(iterable_type):
					Some(element_type):
						compiler_for_tuple_elements_from_iterable_element(context, element_type)
					None:
						compiler_for_tuple_iterable_error(context, iterable_type)
		_:
			match compiler_iterable_element_type(iterable_type):
				Some(element_type):
					compiler_for_tuple_elements_from_iterable_element(context, element_type)
				None:
					compiler_for_tuple_iterable_error(context, iterable_type)


private pure func compiler_for_tuple_arity_error(
	context: CompilerInferContext,
	binder_count: Int,
	element_count: Int,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Tuple for-loop arity mismatch: expected "
			+ binder_count.to_string()
			+ " binders, got "
			+ element_count.to_string()
			+ " tuple fields",
	)


private pure func compiler_for_redeclaration_error(
	context: CompilerInferContext,
	name: String,
) -> CompilerInferContext:
	compiler_infer_error(context, "Cannot redeclare `" + name + "` in for loop")


private pure func compiler_check_for_tuple_redeclarations(
	context: CompilerInferContext,
	names: List[ParsedIdentifier],
) -> CompilerInferContext:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var seen: List[String] = []

	for name in names:
		if name.text != "_":
			if (
				compiler_env_lookup_in_current_scope(context.state.env, name.text).is_some()
				or seen.contains(name.text)
			):
				next_context = compiler_for_redeclaration_error(next_context, name.text)
			seen = seen.append(name.text)

	next_context


private pure func compiler_tuple_binding_type(
	element_types: List[CompilerType],
	index: Int,
) -> CompilerType:
	match element_types.get(index):
		Some(typ):
			compiler_type_copy(typ)
		None:
			compiler_type_void()


private pure func compiler_add_tuple_for_bindings(
	env: CompilerEnv,
	names: List[ParsedIdentifier],
	element_types: List[CompilerType],
) -> CompilerEnv:
	var next_env: CompilerEnv = env
	var index: Int = 0

	while index < names.length():
		match names.get(index):
			Some(name):
				if name.text != "_":
					elem_type = compiler_tuple_binding_type(element_types, index)
					next_env = compiler_env_add_var_with_details(
						next_env,
						name.text,
						compiler_type_copy(elem_type),
						Some(compiler_type_copy(elem_type)),
						CompilerImmutableBinding,
						CompilerForLoopVar,
						compiler_unrefined_binding(),
					)
			None:
				void

		index += 1

	next_env


private pure func compiler_infer_for_expr(
	context: CompilerInferContext,
	binder: ParsedForBinder,
	iterable: ParsedExpr,
	body: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	iter_result = compiler_infer_expr(compiler_infer_without_expected(context), iterable)
	iter_type = compiler_typed_expr_semantic_type(iter_result.expr)

	match binder:
		ParsedForNameBinder(name):
			element_result = compiler_iterable_element_type(iter_type)
			after_iter_context = match element_result:
				Some(_):
					compiler_infer_context_copy(iter_result.context)
				None:
					compiler_for_iterable_error(iter_result.context, iter_type)
			redeclared = if name.text == "_":
				False
			else:
				compiler_env_lookup_in_current_scope(after_iter_context.state.env, name.text).is_some()
			checked_context = if redeclared:
				compiler_for_redeclaration_error(after_iter_context, name.text)
			else:
				compiler_infer_context_copy(after_iter_context)
			elem_type = match element_result:
				Some(typ):
					compiler_type_copy(typ)
				None:
					compiler_type_void()
			loop_env = compiler_env_push_scope(checked_context.state.env)
			bound_env = if name.text == "_":
				loop_env
			else:
				compiler_env_add_var_with_details(
					loop_env,
					name.text,
					compiler_type_copy(elem_type),
					Some(compiler_type_copy(elem_type)),
					CompilerImmutableBinding,
					CompilerForLoopVar,
					compiler_unrefined_binding(),
				)
			loop_state = compiler_typecheck_state_with_env(checked_context.state, bound_env)
			loop_context = compiler_infer_inside_loop(compiler_infer_context_with_state(checked_context, loop_state))
			body_result = compiler_infer_expr(loop_context, body)
			outer_env = compiler_env_pop_scope(body_result.context.state.env)
			outer_state = compiler_typecheck_state_with_env(body_result.context.state, outer_env)
			result_context = compiler_infer_context_with_state(context, outer_state)
			typed = CompilerTypedForExpr(
				binder,
				iter_result.expr,
				body_result.expr,
				span,
				compiler_inferred_info(result_context, compiler_type_void()),
			)
			compiler_infer_result(result_context, typed)
		ParsedForTupleBinder(names, _):
			tuple_elements = compiler_for_tuple_element_types(iter_result.context, iter_type)
			arity_context = if tuple_elements.ok:
				if names.length() == tuple_elements.elements.length():
					compiler_infer_context_copy(tuple_elements.context)
				else:
					compiler_for_tuple_arity_error(
						tuple_elements.context,
						names.length(),
						tuple_elements.elements.length(),
					)
			else:
				compiler_infer_context_copy(tuple_elements.context)
			checked_context = compiler_check_for_tuple_redeclarations(arity_context, names)
			loop_env = compiler_env_push_scope(checked_context.state.env)
			bound_env = compiler_add_tuple_for_bindings(loop_env, names, tuple_elements.elements)
			loop_state = compiler_typecheck_state_with_env(checked_context.state, bound_env)
			loop_context = compiler_infer_inside_loop(compiler_infer_context_with_state(checked_context, loop_state))
			body_result = compiler_infer_expr(loop_context, body)
			outer_env = compiler_env_pop_scope(body_result.context.state.env)
			outer_state = compiler_typecheck_state_with_env(body_result.context.state, outer_env)
			result_context = compiler_infer_context_with_state(context, outer_state)
			typed = CompilerTypedForExpr(
				binder,
				iter_result.expr,
				body_result.expr,
				span,
				compiler_inferred_info(result_context, compiler_type_void()),
			)
			compiler_infer_result(result_context, typed)


private pure func compiler_binding_slot(
	is_mutable: Bool,
	typ: CompilerType,
) -> CompilerValueSlot:
	if is_mutable:
		compiler_mutable_binding_slot(typ)
	else:
		compiler_keep_value_slot(typ)


private pure func compiler_var_mutability(is_mutable: Bool) -> CompilerVarMutability:
	if is_mutable:
		CompilerMutableBinding
	else:
		CompilerImmutableBinding


private pure func compiler_assign_to_non_var_error(
	context: CompilerInferContext,
	name: String,
	kind: CompilerSymbolKind,
) -> CompilerInferContext:
	message = match kind:
		CompilerFuncSymbolKind(_):
			"Cannot assign to function '" + name + "'"
		CompilerTypeSymbolKind(_):
			"Cannot assign to type name '" + name + "'"
		CompilerRecordSymbolKind(_):
			"Cannot assign to record type '" + name + "'"
		CompilerConstructorSymbolKind(_):
			"Cannot assign to constructor '" + name + "'"
		CompilerAliasSymbolKind(_):
			"Cannot assign to type alias '" + name + "'"
		CompilerOpaqueAliasSymbolKind(_):
			"Cannot assign to opaque type '" + name + "'"
		CompilerVarSymbolKind(_):
			"Cannot assign to variable '" + name + "'"

	compiler_infer_error(context, message)


private pure func compiler_assignment_type_mismatch_error(
	context: CompilerInferContext,
	name: String,
	expected: CompilerType,
	found: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Cannot assign to variable '"
			+ name
			+ "'\n    expected: "
			+ compiler_type_to_string(expected)
			+ "\n       found: "
			+ compiler_type_to_string(found),
	)


private pure func compiler_assign_scope_from_lookup(
	context: CompilerInferContext,
	lookup: CompilerSymbolLookup,
) -> CompilerTypedAssignScope:
	if compiler_env_lookup_is_outermost_scope(context.state.env, lookup):
		CompilerModuleAssignScope
	else:
		CompilerLocalAssignScope


private pure func compiler_infer_discard_assign_expr(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	value_result = compiler_infer_expr(compiler_infer_without_expected(context), value)
	typed = CompilerTypedAssignExpr(
		name,
		CompilerLocalAssignScope,
		value_result.expr,
		span,
		compiler_inferred_info(value_result.context, compiler_type_void()),
	)

	compiler_infer_result(value_result.context, typed)


private pure func compiler_infer_implicit_assign_binding(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	value_result = compiler_infer_expr(compiler_infer_without_expected(context), value)
	binding_type = compiler_typed_expr_semantic_type(value_result.expr)
	source_type = compiler_typed_expr_source_type(value_result.expr)
	initializer = compiler_typed_expr_with_slot(
		value_result.expr,
		compiler_binding_slot(False, compiler_type_copy(binding_type)),
	)
	next_env = compiler_env_add_var_with_details(
		value_result.context.state.env,
		name.text,
		compiler_type_copy(binding_type),
		compiler_optional_type_copy(source_type),
		CompilerImmutableBinding,
		CompilerLetBinding,
		compiler_unrefined_binding(),
	)
	next_state = compiler_typecheck_state_with_env(value_result.context.state, next_env)
	next_context = compiler_infer_context_with_state(value_result.context, next_state)
	typed = CompilerTypedVarDeclExpr(
		{
			name = name,
			annotation = Some(compiler_type_copy(binding_type)),
			initializer = initializer,
			is_mutable = False,
			span = span
		},
		compiler_inferred_info(next_context, compiler_type_void()),
	)

	compiler_infer_result(next_context, typed)


private pure func compiler_infer_mutable_assign_expr(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: CompilerSourceSpan,
	assign_scope: CompilerTypedAssignScope,
	var_type: CompilerType,
) -> CompilerInferResult:
	value_result = compiler_infer_expr(
		compiler_infer_with_expected_value_slot(context, var_type, CompilerExpectedArgumentSlot),
		value,
	)
	value_type = compiler_typed_expr_value_type(value_result.expr)
	next_context = if compiler_types_equal(value_type, var_type):
		compiler_infer_context_copy(value_result.context)
	else:
		compiler_assignment_type_mismatch_error(value_result.context, name.text, var_type, value_type)
	typed = CompilerTypedAssignExpr(
		name,
		assign_scope,
		value_result.expr,
		span,
		compiler_inferred_info(next_context, compiler_type_void()),
	)

	compiler_infer_result(next_context, typed)


private pure func compiler_infer_invalid_assign_target_result(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	typed_value = CompilerTypedUnsupportedExpr(
		"assignment value",
		parsed_expr_span(value),
		compiler_inferred_info(context, compiler_type_void()),
	)
	typed = CompilerTypedAssignExpr(
		name,
		CompilerLocalAssignScope,
		typed_value,
		span,
		compiler_inferred_info(context, compiler_type_void()),
	)

	compiler_infer_result(context, typed)


private pure func compiler_infer_assign_expr(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	match compiler_env_lookup_with_scope_depth(context.state.env, name.text):
		None:
			if name.text == "_":
				compiler_infer_discard_assign_expr(context, name, value, span)
			else:
				compiler_infer_implicit_assign_binding(context, name, value, span)
		Some(lookup):
			match lookup.symbol.kind:
				CompilerVarSymbolKind(var_symbol):
					match var_symbol.mutability:
						CompilerMutableBinding:
							compiler_infer_mutable_assign_expr(
								context,
								name,
								value,
								span,
								compiler_assign_scope_from_lookup(context, lookup),
								var_symbol.var_type,
							)
						CompilerImmutableBinding:
							next_context = compiler_infer_error(
								context,
								"Cannot assign to immutable variable '" + name.text + "'",
							)
							compiler_infer_invalid_assign_target_result(next_context, name, value, span)
				_:
					next_context = compiler_assign_to_non_var_error(
						context,
						name.text,
						lookup.symbol.kind,
					)
					compiler_infer_invalid_assign_target_result(next_context, name, value, span)


private pure func compiler_compound_assign_binary_op(op: ParsedCompoundAssignOp) -> ParsedBinaryOp:
	match op:
		ParsedAssignAddOp:
			ParsedAddOp
		ParsedAssignSubtractOp:
			ParsedSubtractOp
		ParsedAssignMultiplyOp:
			ParsedMultiplyOp
		ParsedAssignDivideOp:
			ParsedDivideOp


private pure func compiler_infer_compound_assign_expr(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	op: ParsedCompoundAssignOp,
	value: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	rhs = ParsedBinaryExpr(
		compiler_compound_assign_binary_op(op),
		ParsedNameExpr(name),
		value,
		span,
	)
	compiler_infer_assign_expr(context, name, rhs, span)


private pure func compiler_infer_var_decl_expr(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	annotation: Option[ParsedTypeExpr],
	value: ParsedExpr,
	is_mutable: Bool,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	declared_type: Option[CompilerType] = annotation.map(compiler_type_from_parsed_type_expr)
	value_context = match declared_type:
		Some(typ):
			compiler_infer_with_expected_value_slot(context, compiler_type_copy(typ), CompilerExpectedArgumentSlot)
		None:
			compiler_infer_without_expected(context)

	value_result = compiler_infer_expr(value_context, value)
	value_type = compiler_typed_expr_value_type(value_result.expr)
	binding_type = match declared_type:
		Some(typ):
			compiler_type_copy(typ)
		None:
			compiler_type_copy(compiler_typed_expr_semantic_type(value_result.expr))
	source_type = match declared_type:
		Some(typ):
			Some(compiler_type_copy(typ))
		None:
			compiler_optional_type_copy(compiler_typed_expr_source_type(value_result.expr))
	checked_context = match declared_type:
		Some(typ):
			if compiler_types_equal(value_type, typ):
				compiler_infer_context_copy(value_result.context)
			else:
				compiler_infer_error(
					value_result.context,
					"Binding `"
						+ name.text
						+ "` declared as `"
						+ compiler_type_to_string(typ)
						+ "` but initializer has type `"
						+ compiler_type_to_string(value_type)
						+ "`",
				)
		None:
			compiler_infer_context_copy(value_result.context)
	initializer = compiler_typed_expr_with_slot(
		value_result.expr,
		compiler_binding_slot(is_mutable, compiler_type_copy(binding_type)),
	)
	next_env = compiler_env_add_var_with_details(
		checked_context.state.env,
		name.text,
		compiler_type_copy(binding_type),
		compiler_optional_type_copy(source_type),
		compiler_var_mutability(is_mutable),
		CompilerLetBinding,
		compiler_unrefined_binding(),
	)
	next_state = compiler_typecheck_state_with_env(checked_context.state, next_env)
	next_context = compiler_infer_context(next_state)
	typed = CompilerTypedVarDeclExpr(
		{
			name = name,
			annotation = compiler_optional_type_copy(declared_type),
			initializer = initializer,
			is_mutable = is_mutable,
			span = span
		},
		compiler_inferred_info(next_context, compiler_type_void()),
	)

	compiler_infer_result(next_context, typed)


private pure func compiler_infer_block_items(
	context: CompilerInferContext,
	exprs: List[ParsedExpr],
	index: Int,
	typed_exprs: List[CompilerTypedExpr],
	block_span: CompilerSourceSpan,
) -> CompilerInferResult:
	if index >= exprs.length():
		typed = CompilerTypedBlockExpr(
			typed_exprs,
			block_span,
			compiler_inferred_info(context, compiler_type_void()),
		)
		compiler_infer_result(context, typed)
	else:
		match exprs.get(index):
			Some(expr):
				is_last: Bool = index == exprs.length() - 1
				item_context = if is_last:
					context
				else:
					compiler_infer_without_expected(context)
				item_result = compiler_infer_expr(item_context, expr)
				next_exprs = typed_exprs.append(item_result.expr)

				if is_last:
					typed = CompilerTypedBlockExpr(
						next_exprs,
						block_span,
						compiler_typed_expr_info(item_result.expr),
					)
					compiler_infer_result(item_result.context, typed)
				else:
					compiler_infer_block_items(
						item_result.context,
						exprs,
						index + 1,
						next_exprs,
						block_span,
					)
			None:
				typed = CompilerTypedBlockExpr(
					typed_exprs,
					block_span,
					compiler_inferred_info(context, compiler_type_void()),
				)
				compiler_infer_result(context, typed)


private pure func compiler_infer_block_expr(
	context: CompilerInferContext,
	exprs: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	inner_env = compiler_env_push_scope(context.state.env)
	inner_state = compiler_typecheck_state_with_env(context.state, inner_env)
	inner_context = compiler_infer_context_with_state(context, inner_state)

	result = if exprs.length() == 0:
		typed = CompilerTypedBlockExpr(
			[],
			span,
			compiler_inferred_info(inner_context, compiler_type_void()),
		)
		compiler_infer_result(inner_context, typed)
	else:
		compiler_infer_block_items(inner_context, exprs, 0, [], span)

	outer_env = compiler_env_pop_scope(result.context.state.env)
	outer_state = compiler_typecheck_state_with_env(result.context.state, outer_env)
	outer_context = compiler_infer_context_with_state(result.context, outer_state)
	block_items: List[CompilerTypedExpr] = match result.expr:
		CompilerTypedBlockExpr(items, _, _):
			items
		_:
			[]

	compiler_infer_result(
		outer_context,
		CompilerTypedBlockExpr(block_items, span, compiler_typed_expr_info(result.expr)),
	)


private pure func compiler_infer_debug_block_expr(
	context: CompilerInferContext,
	body: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	body_result = compiler_infer_expr(compiler_infer_without_expected(context), body)
	result_context = compiler_infer_context_with_state(context, body_result.context.state)
	typed = CompilerTypedDebugBlockExpr(
		body_result.expr,
		span,
		compiler_inferred_info(result_context, compiler_type_void()),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_unsupported_expr(
	context: CompilerInferContext,
	expr: ParsedExpr,
	label: String,
) -> CompilerInferResult:
	next = compiler_infer_error(
		context,
		"Blorp inference does not yet support " + label,
	)
	compiler_infer_result(
		next,
		CompilerTypedUnsupportedExpr(
			label,
			parsed_expr_span(expr),
			compiler_inferred_info(next, compiler_type_void()),
		),
	)


pure func compiler_infer_expr(
	context: CompilerInferContext,
	expr: ParsedExpr,
) -> CompilerInferResult:
	match expr:
		ParsedNameExpr(name):
			compiler_infer_name_expr(context, name)
		ParsedIntLiteralExpr(text, span):
			compiler_literal_result(
				context,
				CompilerTypedIntLiteralExpr(
					text,
					span,
					compiler_inferred_info(
						context,
						CompilerConstIntType(compiler_parse_int_literal(text)),
					),
				),
			)
		ParsedFloatLiteralExpr(text, span):
			compiler_literal_result(
				context,
				CompilerTypedFloatLiteralExpr(text, span, compiler_inferred_info(context, compiler_type_float())),
			)
		ParsedStringLiteralExpr(text, _, span):
			compiler_literal_result(
				context,
				CompilerTypedStringLiteralExpr(text, span, compiler_inferred_info(context, compiler_type_string())),
			)
		ParsedStringInterpolationExpr(text, raw, span):
			compiler_literal_result(
				context,
				CompilerTypedStringInterpolationExpr(
					text,
					raw,
					span,
					compiler_inferred_info(context, compiler_type_string()),
				),
			)
		ParsedStringInterpolationPartsExpr(parts, is_multiline, span):
			compiler_infer_string_interpolation_parts_expr(context, parts, is_multiline, span)
		ParsedBoolLiteralExpr(value, span):
			compiler_literal_result(
				context,
				CompilerTypedBoolLiteralExpr(value, span, compiler_inferred_info(context, compiler_type_bool())),
			)
		ParsedCharLiteralExpr(value, span):
			compiler_literal_result(
				context,
				CompilerTypedCharLiteralExpr(value, span, compiler_inferred_info(context, compiler_type_char())),
			)
		ParsedUnaryExpr(op, operand, span):
			compiler_infer_unary_expr(context, op, operand, span)
		ParsedBinaryExpr(op, left, right, span):
			compiler_infer_binary_expr(context, op, left, right, span)
		ParsedLogicalExpr(op, left, right, span):
			compiler_infer_logical_expr(context, op, left, right, span)
		ParsedCallExpr(callee, args, span):
			compiler_infer_call_expr(context, callee, args, span)
		ParsedLambdaExpr(is_pure, params, return_type, body, span):
			compiler_infer_lambda_expr(context, is_pure, params, return_type, body, span)
		ParsedFieldAccessExpr(receiver, field, span):
			compiler_infer_field_access_expr(context, receiver, field, span)
		ParsedSubscriptExpr(receiver, indices, span):
			compiler_infer_subscript_expr(context, receiver, indices, span)
		ParsedSubscriptAssignExpr(target, indices, value, span):
			compiler_infer_subscript_assign_expr(context, target, indices, value, span)
		ParsedTupleExpr(items, span):
			compiler_infer_tuple_expr(context, items, span)
		ParsedTupleDestructExpr(names, value, span):
			compiler_infer_tuple_destruct_expr(context, names, value, span)
		ParsedListExpr(items, span):
			compiler_infer_list_expr(context, items, span)
		ParsedVectorExpr(items, span):
			compiler_infer_vector_expr(context, items, span)
		ParsedDictExpr(entries, span):
			compiler_infer_dict_expr(context, entries, span)
		ParsedRecordExpr(fields, span):
			compiler_infer_record_expr(context, fields, span)
		ParsedRecordUpdateExpr(base, fields, span):
			compiler_infer_record_update_expr(context, base, fields, span)
		ParsedRangeExpr(start_expr, end_expr, span):
			compiler_infer_range_expr(context, start_expr, end_expr, span)
		ParsedIfExpr(condition, then_branch, else_branch, span):
			compiler_infer_if_expr(context, condition, then_branch, else_branch, span)
		ParsedMatchExpr(scrutinee, cases, span):
			compiler_infer_match_expr(context, scrutinee, cases, span)
		ParsedWhileExpr(condition, body, span):
			compiler_infer_while_expr(context, condition, body, span)
		ParsedForExpr(binder, iterable, body, span):
			compiler_infer_for_expr(context, binder, iterable, body, span)
		ParsedBreakExpr(span):
			compiler_infer_break_expr(context, span)
		ParsedContinueExpr(span):
			compiler_infer_continue_expr(context, span)
		ParsedAssignExpr(name, value, span):
			compiler_infer_assign_expr(context, name, value, span)
		ParsedCompoundAssignExpr(name, op, value, span):
			compiler_infer_compound_assign_expr(context, name, op, value, span)
		ParsedAscriptionExpr(inner, type_expr, span):
			compiler_infer_ascription_expr(context, inner, type_expr, span)
		ParsedBlockExpr(exprs, span):
			compiler_infer_block_expr(context, exprs, span)
		ParsedDebugBlockExpr(body, span):
			compiler_infer_debug_block_expr(context, body, span)
		ParsedVoidExpr(span):
			compiler_literal_result(
				context,
				CompilerTypedVoidExpr(span, compiler_inferred_info(context, compiler_type_void())),
			)
		ParsedBuiltinExpr(name, span):
			compiler_literal_result(
				context,
				CompilerTypedBuiltinExpr(name, span, compiler_inferred_info(context, compiler_type_void())),
			)
		ParsedVarDeclExpr(name, annotation, value, is_mutable, span):
			compiler_infer_var_decl_expr(context, name, annotation, value, is_mutable, span)
		ParsedMissingExpr(span):
			compiler_literal_result(
				context,
				CompilerTypedMissingExpr(span, compiler_inferred_info(context, compiler_type_void())),
			)
		_:
			compiler_unsupported_expr(context, expr, "expression form")
