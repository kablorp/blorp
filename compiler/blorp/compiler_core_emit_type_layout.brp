import:
	compiler_core_json:
		CoreReleasePolicy(
			ArcReleaseOnlyPolicy,
			ArcReleasePolicy,
			NoReleasePolicy,
			StackResultReleasePolicy,
		),
		CoreType(
			BoxedResultType,
			EnumType,
			HeapRecordType,
			NamedType,
			RangeType,
			StackResultType,
			TensorType,
			TupleType,
			UnionType,
			ValueRecordType,
			VoidType,
		),


pure func runtime_backed_heap_record_c_type(name: String) -> Option[String]:
	if name == "MemStats":
		Some("blorp_MemStats*")
	else if name == "SchedulerStats":
		Some("blorp_SchedulerStats*")
	else:
		None


pure func generated_stack_option_c_type_name(payload_name: String) -> String:
	if payload_name == "Range":
		"blorp_StackOption_RangeValue"
	else:
		"blorp_StackOption_" + payload_name


pure func stack_option_c_type(payload: CoreType) -> Option[String]:
	match payload:
		VoidType:
			Some("blorp_StackOption_Void")
		NamedType(name, args):
			if args.length() == 0:
				if name == "Int":
					Some("blorp_StackOption_Int")
				else if name == "Int8":
					Some("blorp_StackOption_Int8")
				else if name == "Int16":
					Some("blorp_StackOption_Int16")
				else if name == "Int32":
					Some("blorp_StackOption_Int32")
				else if name == "Int64":
					Some("blorp_StackOption_Int64")
				else if name == "UInt8":
					Some("blorp_StackOption_UInt8")
				else if name == "UInt16":
					Some("blorp_StackOption_UInt16")
				else if name == "UInt32":
					Some("blorp_StackOption_UInt32")
				else if name == "UInt64":
					Some("blorp_StackOption_UInt64")
				else if name == "Float":
					Some("blorp_StackOption_Float")
				else if name == "Float32":
					Some("blorp_StackOption_Float32")
				else if name == "Float16":
					Some("blorp_StackOption_Float16")
				else if name == "Bool":
					Some("blorp_StackOption_Bool")
				else if name == "Char":
					Some("blorp_StackOption_Char")
				else if name == "Int128":
					Some("blorp_StackOption_Int128")
				else if name == "UInt128":
					Some("blorp_StackOption_UInt128")
				else:
					None
			else:
				None
		EnumType(name):
			Some(generated_stack_option_c_type_name(name))
		ValueRecordType(name):
			Some(generated_stack_option_c_type_name(name))
		HeapRecordType(name):
			None
		UnionType(name):
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		RangeType:
			Some("blorp_StackOption_Range")
		TensorType:
			None
		TupleType(items):
			None


pure func runtime_owned_stack_option_payload_name(name: String) -> Bool:
	(
		name == "Void"
		or name == "Int"
		or name == "Int8"
		or name == "Int16"
		or name == "Int32"
		or name == "Int64"
		or name == "UInt8"
		or name == "UInt16"
		or name == "UInt32"
		or name == "UInt64"
		or name == "Float"
		or name == "Float32"
		or name == "Float16"
		or name == "Bool"
		or name == "Char"
	)


pure func is_closure_abi_prim_name(name: String) -> Bool:
	(
		name == "Int"
		or name == "Int8"
		or name == "Int16"
		or name == "Int32"
		or name == "Int64"
		or name == "UInt8"
		or name == "UInt16"
		or name == "UInt32"
		or name == "UInt64"
		or name == "Bool"
		or name == "Char"
	)


pure func is_resource_source_type_name(name: String) -> Bool:
	(
		name == "ResourceSource"
		or name == "std/stream::ResourceSource"
		or name == "std_stream__ResourceSource"
	)


pure func c_type_name(typ: CoreType) -> String:
	match typ:
		VoidType:
			"void"
		NamedType(name, args):
			if name == "Option":
				match args:
					[payload]:
						match stack_option_c_type(payload):
							Some(c_type):
								c_type
							None:
								"void*"
					[]:
						"void*"
					[first, second, ...rest]:
						"void*"
			else if name == "Result":
				match args:
					[ok_type, err_type]:
						"blorp_StackResult"
					[]:
						"void*"
					[only]:
						"void*"
					[first, second, third, ...rest]:
						"void*"
			else if name == "Int":
				"long"
			else if name == "Int8":
				"int8_t"
			else if name == "Int16":
				"int16_t"
			else if name == "Int32":
				"int32_t"
			else if name == "Int64":
				"long"
			else if name == "Int128":
				"__int128"
			else if name == "UInt8":
				"uint8_t"
			else if name == "UInt16":
				"uint16_t"
			else if name == "UInt32":
				"uint32_t"
			else if name == "UInt64":
				"uint64_t"
			else if name == "UInt128":
				"unsigned __int128"
			else if name == "Float":
				"double"
			else if name == "Float32":
				"float"
			else if name == "Float16":
				"_Float16"
			else if name == "Bool":
				"int"
			else if name == "Char":
				"int32_t"
			else if name == "String":
				"blorp_String*"
			else if name == "Bytes":
				"blorp_Bytes*"
			else if name == "Fixed":
				"blorp_Fixed*"
			else if name == "Closure":
				"blorp_Closure*"
			else if name == "Channel":
				"blorp_Channel*"
			else if is_resource_source_type_name(name):
				"blorp_ResourceSource*"
			else if (
				name == "Stream"
				or name == "std/stream::Stream"
				or name == "std_stream__Stream"
			):
				"blorp_Stream*"
			else if (
				name == "FallibleStream"
				or name == "std/stream::FallibleStream"
				or name == "std_stream__FallibleStream"
			):
				"blorp_FallibleStream*"
			else if (
				name == "Port"
				or name == "std/net/tcp::Port"
				or name == "std_net_tcp__Port"
			):
				"long"
			else if (
				name == "TcpListener"
				or name == "std/net/tcp::TcpListener"
				or name == "std_net_tcp__TcpListener"
			):
				"blorp_TcpListener*"
			else if (
				name == "TcpStream"
				or name == "std/net/tcp::TcpStream"
				or name == "std_net_tcp__TcpStream"
			):
				"blorp_TcpStream*"
			else if (
				name == "TlsSession"
				or name == "std/net/tls::TlsSession"
				or name == "std_net_tls__TlsSession"
			):
				"blorp_TlsSession*"
			else if (
				name == "WebSocketSession"
				or name == "std/net/websocket::WebSocketSession"
				or name == "std_net_websocket__WebSocketSession"
			):
				"blorp_WebSocketSession*"
			else if (
				name == "UdpSocket"
				or name == "std/net/udp::UdpSocket"
				or name == "std_net_udp__UdpSocket"
			):
				"blorp_UdpSocket*"
			else if name == "List":
				"blorp_List*"
			else if name == "Dict" and args.length() == 2:
				"blorp_Dict*"
			else if name == "Set" and args.length() == 1:
				"blorp_Set*"
			else:
				"void*"
		StackResultType(ok_type, err_type):
			"blorp_StackResult"
		BoxedResultType(ok_type, err_type):
			"blorp_Result*"
		EnumType(name):
			"long"
		ValueRecordType(name):
			name
		HeapRecordType(name):
			match runtime_backed_heap_record_c_type(name):
				Some(c_type):
					c_type
				None:
					name + "*"
		UnionType(name):
			name + "*"
		RangeType:
			"long"
		TensorType:
			"blorp_Vector*"
		TupleType(items):
			"blorp_Tuple*"


pure func is_void_type(typ: CoreType) -> Bool:
	match typ:
		VoidType:
			True
		NamedType(name, args):
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType:
			False
		TupleType(items):
			False


pure func is_stack_result_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if name == "Result":
				match args:
					[first, second]:
						True
					[]:
						False
					[first]:
						False
					[first, second, third, ...rest]:
						False
			else:
				False
		StackResultType(ok_type, err_type):
			True
		BoxedResultType(ok_type, err_type):
			False
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType:
			False
		TupleType(items):
			False


pure func type_requires_release(typ: CoreType) -> Bool:
	match typ:
		TupleType(items):
			True
		UnionType(name):
			True
		VoidType:
			False
		NamedType(name, args):
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			True
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			True
		RangeType:
			False
		TensorType:
			True


pure func boxed_value_needs_release_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if name == "String" and args.length() == 0:
				True
			else if name == "Bytes" and args.length() == 0:
				True
			else if name == "Fixed" and args.length() == 0:
				True
			else if name == "Closure" and args.length() == 0:
				True
			else if name == "List" and args.length() == 1:
				True
			else if name == "Dict" and args.length() == 2:
				True
			else if name == "Set" and args.length() == 1:
				True
			else if name == "Channel" and args.length() == 1:
				True
			else if is_resource_source_type_name(name):
				True
			else if (
				(name == "Stream" or name == "std/stream::Stream" or name == "std_stream__Stream")
				and args.length() == 1
			):
				True
			else if (
				((
					name == "FallibleStream"
					or name == "std/stream::FallibleStream"
					or name == "std_stream__FallibleStream"
				))
				and args.length() == 2
			):
				True
			else if name == "TcpListener" and args.length() == 0:
				True
			else if name == "TcpStream" and args.length() == 0:
				True
			else if name == "TlsSession" and args.length() == 0:
				True
			else if name == "WebSocketSession" and args.length() == 0:
				True
			else if name == "UdpSocket" and args.length() == 0:
				True
			else if name == "Result" and args.length() == 2:
				True
			else:
				False
		StackResultType(ok_type, err_type):
			True
		BoxedResultType(ok_type, err_type):
			True
		HeapRecordType(name):
			True
		UnionType(name):
			True
		TupleType(items):
			True
		TensorType:
			True
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False


pure func dict_stored_value_needs_release_type(typ: CoreType) -> Bool:
	match typ:
		ValueRecordType(name):
			True
		StackResultType(ok_type, err_type):
			True
		NamedType(name, args):
			boxed_value_needs_release_type(typ)
		BoxedResultType(ok_type, err_type):
			boxed_value_needs_release_type(typ)
		HeapRecordType(name):
			boxed_value_needs_release_type(typ)
		UnionType(name):
			boxed_value_needs_release_type(typ)
		TupleType(items):
			boxed_value_needs_release_type(typ)
		TensorType:
			boxed_value_needs_release_type(typ)
		VoidType:
			False
		EnumType(name):
			False
		RangeType:
			False


pure func dict_value_needs_release_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if name == "Dict":
				match args:
					[key_type, value_type]:
						dict_stored_value_needs_release_type(value_type)
					[]:
						False
					[first]:
						False
					[first, second, third, ...rest]:
						False
			else:
				False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		TupleType(items):
			False
		TensorType:
			False
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False


pure func list_element_needs_retain_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if name == "List" or name == "ParallelList":
				match args:
					[elem_type]:
						boxed_value_needs_release_type(elem_type)
					[]:
						True
					[first, second, ...rest]:
						True
			else:
				True
		StackResultType(ok_type, err_type):
			True
		BoxedResultType(ok_type, err_type):
			True
		HeapRecordType(name):
			True
		UnionType(name):
			True
		TupleType(items):
			True
		TensorType:
			True
		VoidType:
			True
		EnumType(name):
			True
		ValueRecordType(name):
			True
		RangeType:
			True


pure func type_is_value_record(typ: CoreType) -> Bool:
	match typ:
		ValueRecordType(name):
			True
		NamedType(name, args):
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		TupleType(items):
			False
		TensorType:
			False
		VoidType:
			False
		EnumType(name):
			False
		RangeType:
			False


pure func channel_element_type(typ: CoreType) -> Option[CoreType]:
	match typ:
		NamedType(name, args):
			if name == "Channel":
				match args:
					[elem_type]:
						Some(elem_type)
					[]:
						None
					[first, second, ...rest]:
						None
			else:
				None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		VoidType:
			None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		RangeType:
			None
		TensorType:
			None
		TupleType(items):
			None


pure func cleanup_release_policy_for_type(typ: CoreType) -> CoreReleasePolicy:
	if is_stack_result_type(typ):
		StackResultReleasePolicy
	else:
		match typ:
			NamedType(name, args):
				if name == "String" and args.length() == 0:
					ArcReleaseOnlyPolicy
				else if name == "LiteralString" and args.length() == 0:
					ArcReleaseOnlyPolicy
				else if name == "Bytes" and args.length() == 0:
					ArcReleaseOnlyPolicy
				else if name == "Fixed" and args.length() == 0:
					ArcReleaseOnlyPolicy
				else if name == "List" and args.length() == 1:
					ArcReleasePolicy
				else if name == "Dict" and args.length() == 2:
					ArcReleasePolicy
				else if name == "Set" and args.length() == 1:
					ArcReleasePolicy
				else if name == "Channel" and args.length() == 1:
					ArcReleasePolicy
				else if is_resource_source_type_name(name):
					ArcReleasePolicy
				else if (
					((
						name == "Stream"
						or name == "std/stream::Stream"
						or name == "std_stream__Stream"
					))
					and args.length() == 1
				):
					ArcReleasePolicy
				else if (
					((
						name == "FallibleStream"
						or name == "std/stream::FallibleStream"
						or name == "std_stream__FallibleStream"
					))
					and args.length() == 2
				):
					ArcReleasePolicy
				else if name == "TcpListener" and args.length() == 0:
					ArcReleasePolicy
				else if name == "TcpStream" and args.length() == 0:
					ArcReleasePolicy
				else if name == "TlsSession" and args.length() == 0:
					ArcReleasePolicy
				else if name == "WebSocketSession" and args.length() == 0:
					ArcReleasePolicy
				else:
					NoReleasePolicy
			VoidType:
				NoReleasePolicy
			StackResultType(ok_type, err_type):
				StackResultReleasePolicy
			BoxedResultType(ok_type, err_type):
				ArcReleasePolicy
			EnumType(name):
				NoReleasePolicy
			ValueRecordType(name):
				NoReleasePolicy
			HeapRecordType(name):
				ArcReleasePolicy
			UnionType(name):
				ArcReleasePolicy
			RangeType:
				NoReleasePolicy
			TensorType:
				ArcReleasePolicy
			TupleType(items):
				ArcReleasePolicy
