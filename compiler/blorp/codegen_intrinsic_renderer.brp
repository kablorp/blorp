pure func parse_intrinsic(name: String) -> Option[Intrinsic]:
	match INTRINSICS_NO_ARGS.get(name):
		Some(intrinsic): Some(NoArgs(intrinsic))
		None:
			match INTRINSICS_ONE_ARG.get(name):
				Some(intrinsic): Some(OneArg(intrinsic))
				None:
					match INTRINSICS_TWO_ARGS.get(name):
						Some(intrinsic): Some(TwoArgs(intrinsic))
						None:
							match INTRINSICS_THREE_ARGS.get(name):
								Some(intrinsic): Some(ThreeArgs(intrinsic))
								None: None


pure func render_error_to_string(error: RenderError) -> String:
	match error:
		WrongArity(intrinsic, expected, got):
			"intrinsic ${intrinsic_name(intrinsic)} expected ${expected} arg(s), got ${got}"
		UnsupportedIntrinsic(name): "unsupported intrinsic: ${name}"


pure func wrong_arity_for_args(
	intrinsic: Intrinsic,
	expected: Int,
	args: List[String],
) -> RenderError:
	WrongArity(intrinsic, expected, args.length())


pure func render_no_arg_intrinsic(intrinsic: NoArgIntrinsic) -> String:
	match intrinsic:
		MathInfinity: "(1.0/0.0)"
		MathNegInfinity: "(-1.0/0.0)"
		MathNan: "(0.0/0.0)"
		ElemReleaseFn: "((void*)blorp_elem_release_fn)"


pure func render_one_arg_intrinsic(intrinsic: OneArgIntrinsic, arg: String) -> String:
	match intrinsic:
		MathSin: "sin(${arg})"
		MathCos: "cos(${arg})"
		MathTan: "tan(${arg})"
		MathAsin: "asin(${arg})"
		MathAcos: "acos(${arg})"
		MathAtan: "atan(${arg})"
		MathSinh: "sinh(${arg})"
		MathCosh: "cosh(${arg})"
		MathTanh: "tanh(${arg})"
		MathAsinh: "asinh(${arg})"
		MathAcosh: "acosh(${arg})"
		MathAtanh: "atanh(${arg})"
		MathExp: "exp(${arg})"
		MathExp2: "exp2(${arg})"
		MathExpm1: "expm1(${arg})"
		MathLog: "log(${arg})"
		MathLog2: "log2(${arg})"
		MathLog10: "log10(${arg})"
		MathLog1p: "log1p(${arg})"
		MathSqrt: "sqrt(${arg})"
		MathCbrt: "cbrt(${arg})"
		MathFloor: "floor(${arg})"
		MathCeil: "ceil(${arg})"
		MathTrunc: "trunc(${arg})"
		MathIsNan: "isnan(${arg})"
		MathIsInf: "isinf(${arg})"
		MathIsFinite: "isfinite(${arg})"
		BitNot: "(~${arg})"
		ListLen: "((blorp_List*)${arg})->len"
		ListCapacity: "((blorp_List*)${arg})->capacity"
		ListReverseOwned: "blorp_list_reverse_owned((blorp_List*)${arg})"
		StringLen: "((blorp_String*)${arg})->len"
		StringAlloc: "blorp_string_alloc(${arg})"
		StringEnsureUnique: "blorp_string_cow(${arg})"
		BytesLen: "((blorp_Bytes*)${arg})->len"
		BytesAlloc: "blorp_bytes_alloc(${arg})"
		BytesCow: "blorp_bytes_cow(${arg})"
		DictLen: "((blorp_Dict*)${arg})->size"
		SetLen: "((blorp_Set*)${arg})->size"
		SetCapacity: "((blorp_Set*)${arg})->capacity"
		SetMask: "((blorp_Set*)${arg})->mask"
		SetFirst: "((void*)((blorp_Set*)${arg})->first)"
		SetLast: "((void*)((blorp_Set*)${arg})->last)"
		SetEntryKey: "((blorp_SetEntry*)${arg})->key"
		SetEntryNext: "((void*)((blorp_SetEntry*)${arg})->next)"
		SetEntryPrevOrder: "((void*)((blorp_SetEntry*)${arg})->prev_order)"
		SetEntryNextOrder: "((void*)((blorp_SetEntry*)${arg})->next_order)"
		SetHashImmediate: "blorp_hash_int((long)(intptr_t)${arg})"
		SetAlloc: "blorp_set_alloc(${arg})"
		SetAllocEntry: "blorp_set_alloc_entry(${arg})"
		SetCow: "blorp_set_cow((blorp_Set*)${arg})"
		DictCapacity: "((blorp_Dict*)${arg})->capacity"
		DictMask: "((blorp_Dict*)${arg})->mask"
		DictGrowAt: "((blorp_Dict*)${arg})->grow_at"
		DictOrderLen: "((blorp_Dict*)${arg})->order_len"
		DictKeyReleaseFn: "((void*)((blorp_Dict*)${arg})->key_release)"
		DictValueReleaseFn: "((void*)((blorp_Dict*)${arg})->value_release)"
		DictHashImmediate: "blorp_hash_int((long)(intptr_t)${arg})"
		DictAlloc: "blorp_dict_alloc(${arg})"
		DictCow: "blorp_dict_cow((blorp_Dict*)${arg})"
		SliceSource: "((void*)((blorp_StringSlice*)${arg})->source)"
		SliceStart: "((blorp_StringSlice*)${arg})->start"
		SliceLen: "((blorp_StringSlice*)${arg})->len"
		TensorIsUnique: "blorp_is_unique((blorp_Vector*)${arg})"
		TensorLen: "((blorp_Vector*)${arg})->len"
		TensorCapacity: "((blorp_Vector*)${arg})->capacity"
		FixedValue: "((blorp_Fixed*)${arg})->value"
		FixedScale: "(long)((blorp_Fixed*)${arg})->scale"
		FixedPrecision: "(long)((blorp_Fixed*)${arg})->precision"
		FixedPow10: "blorp_pow10((int)${arg})"


pure func render_two_arg_intrinsic(
	intrinsic: TwoArgIntrinsic,
	left: String,
	right: String,
) -> String:
	match intrinsic:
		MathPow: "pow(${left}, ${right})"
		MathAtan2: "atan2(${left}, ${right})"
		MathHypot: "hypot(${left}, ${right})"
		MathFmod: "fmod(${left}, ${right})"
		MathCopysign: "copysign(${left}, ${right})"
		BitAnd: "(${left} & ${right})"
		BitOr: "(${left} | ${right})"
		BitXor: "(${left} ^ ${right})"
		ShiftLeft: "((long)(${left} << (${right} & 63)))"
		ShiftRight: "((long)(${left} >> (${right} & 63)))"
		ListGet: "blorp_list_get((blorp_List*)${left}, ${right})"
		ListSetLen: "(((blorp_List*)${left})->len = ${right})"
		ListReleaseElem: "blorp_list_release_elem((blorp_List*)${left}, ${right})"
		ListSetElemRelease: "(((blorp_List*)${left})->elem_release = (void(*)(void*))${right})"
		StringGetByte: "(long)(unsigned char)((blorp_String*)${left})->data[${right}]"
		StringEnsureCapacity: "blorp_string_ensure_capacity(${left}, ${right})"
		BytesGet: "(long)((blorp_Bytes*)${left})->data[${right}]"
		BytesSetLen: "(((blorp_Bytes*)${left})->len = ${right})"
		SetBucket: "((void*)((blorp_Set*)${left})->buckets[${right}])"
		SetSetLen: "(((blorp_Set*)${left})->size = ${right})"
		SetSetFirst: "(((blorp_Set*)${left})->first = (blorp_SetEntry*)${right})"
		SetSetLast: "(((blorp_Set*)${left})->last = (blorp_SetEntry*)${right})"
		SetEntrySetNext: "(((blorp_SetEntry*)${left})->next = (blorp_SetEntry*)${right})"
		SetEntrySetPrevOrder: "(((blorp_SetEntry*)${left})->prev_order = (blorp_SetEntry*)${right})"
		SetEntrySetNextOrder: "(((blorp_SetEntry*)${left})->next_order = (blorp_SetEntry*)${right})"
		SetHash: "((long)((blorp_Set*)${left})->hash_fn(${right}))"
		SetEqImmediate: "((long)(${left} == ${right}))"
		SetFreeEntry: "blorp_set_free_entry((blorp_Set*)${left}, (blorp_SetEntry*)${right})"
		SetReuseAlloc: "blorp_set_reuse_alloc((blorp_Set*)${left}, ${right})"
		SetResize: "blorp_set_resize_to((blorp_Set*)${left}, ${right})"
		SetReserveForLen: "blorp_set_reserve_for_len((blorp_Set*)${left}, ${right})"
		DictKeyAt: "((blorp_Dict*)${left})->keys[${right}]"
		DictValueAt: "((blorp_Dict*)${left})->values[${right}]"
		DictMetaGet: "((long)((blorp_Dict*)${left})->meta[${right}])"
		DictOrderGet: "((blorp_Dict*)${left})->order[${right}]"
		DictOrderIndexGet: "((blorp_Dict*)${left})->order_index[${right}]"
		DictSetLen: "(((blorp_Dict*)${left})->size = ${right})"
		DictSetOrderLen: "(((blorp_Dict*)${left})->order_len = ${right})"
		DictHash: "((long)((blorp_Dict*)${left})->hash_fn(${right}))"
		DictEqImmediate: "((long)(${left} == ${right}))"
		DictReuseAlloc: "blorp_dict_reuse_alloc((blorp_Dict*)${left}, ${right})"
		DictResize: "blorp_dict_resize_to((blorp_Dict*)${left}, ${right})"
		TensorGetI64WordUnchecked: "((long)(intptr_t)((blorp_Vector*)${left})->data[${right}])"
		TensorGetI64RawUnchecked: "((long*)((blorp_Vector*)${left})->data)[${right}]"
		TensorGetF64: "blorp_vector_read_f64((blorp_Vector*)${left}, ${right})"
		TensorGetF32: "blorp_vector_read_f32((blorp_Vector*)${left}, ${right})"
		TensorGetF16: "blorp_vector_read_f16((blorp_Vector*)${left}, ${right})"
		TensorGetI64: "blorp_vector_read_i64((blorp_Vector*)${left}, ${right})"


pure func render_three_arg_intrinsic(
	intrinsic: ThreeArgIntrinsic,
	first: String,
	second: String,
	third: String,
) -> String:
	match intrinsic:
		MathFma: "fma(${first}, ${second}, ${third})"
		StringSetByte: "(((blorp_String*)${first})->data[${second}] = (char)${third})"
		BytesSet: "(((blorp_Bytes*)${first})->data[${second}] = (unsigned char)${third})"
		SetSetBucket: "(((blorp_Set*)${first})->buckets[${second}] = (blorp_SetEntry*)${third})"
		SetEq: "((long)((blorp_Set*)${first})->eq_fn(${second}, ${third}))"
		DictSetKeyAt: "(((blorp_Dict*)${first})->keys[${second}] = ${third})"
		DictSetValueAt: "(((blorp_Dict*)${first})->values[${second}] = ${third})"
		DictMetaSet: "(((blorp_Dict*)${first})->meta[${second}] = (uint8_t)${third})"
		DictOrderSet: "(((blorp_Dict*)${first})->order[${second}] = ${third})"
		DictOrderIndexSet: "(((blorp_Dict*)${first})->order_index[${second}] = ${third})"
		DictEq: "((long)((blorp_Dict*)${first})->eq_fn(${second}, ${third}))"
		SliceAlloc: "blorp_slice_alloc(${first}, ${second}, ${third})"
		TensorSetF64: "blorp_vector_write_f64((blorp_Vector*)${first}, ${second}, ${third})"
		TensorSetF32: "blorp_vector_write_f32((blorp_Vector*)${first}, ${second}, ${third})"
		TensorSetF16: "blorp_vector_write_f16((blorp_Vector*)${first}, ${second}, ${third})"
		TensorSetI64: "blorp_vector_write_i64((blorp_Vector*)${first}, ${second}, ${third})"
		FixedAlloc: "blorp_fixed_raw(${first}, (int)${second}, (int)${third})"


pure func render_parsed_intrinsic(
	intrinsic: Intrinsic,
	args: List[String],
) -> Result[String, RenderError]:
	match intrinsic:
		NoArgs(no_arg):
			match args:
				[]: Ok(render_no_arg_intrinsic(no_arg))
				_: Err(wrong_arity_for_args(intrinsic, 0, args))
		OneArg(one_arg):
			match args:
				[arg]: Ok(render_one_arg_intrinsic(one_arg, arg))
				_: Err(wrong_arity_for_args(intrinsic, 1, args))
		TwoArgs(two_args):
			match args:
				[left, right]: Ok(render_two_arg_intrinsic(two_args, left, right))
				_: Err(wrong_arity_for_args(intrinsic, 2, args))
		ThreeArgs(three_args):
			match args:
				[first, second, third]: Ok(
					render_three_arg_intrinsic(
						three_args,
						first,
						second,
						third,
					),
				)
				_: Err(wrong_arity_for_args(intrinsic, 3, args))


pure func render_intrinsic(name: String, args: List[String]) -> Result[String, RenderError]:
	match parse_intrinsic(name):
		Some(intrinsic): render_parsed_intrinsic(intrinsic, args)
		None: Err(UnsupportedIntrinsic(name))


pure func render_manifest_line(intrinsic: Intrinsic) -> String:
	match intrinsic:
		NoArgs(no_arg):
			template: String = render_no_arg_intrinsic(no_arg)
			"${intrinsic_name(intrinsic)}\t0\t${template}"
		OneArg(one_arg):
			template: String = render_one_arg_intrinsic(one_arg, "@0@")
			"${intrinsic_name(intrinsic)}\t1\t${template}"
		TwoArgs(two_args):
			template: String = render_two_arg_intrinsic(two_args, "@0@", "@1@")
			"${intrinsic_name(intrinsic)}\t2\t${template}"
		ThreeArgs(three_args):
			template: String = render_three_arg_intrinsic(three_args, "@0@", "@1@", "@2@")
			"${intrinsic_name(intrinsic)}\t3\t${template}"


pure func render_manifest_lines() -> List[String]:
	var lines: List[String] = []
	for intrinsic in all_intrinsics:
		lines = lines.append(render_manifest_line(intrinsic))
	lines


func print_manifest() -> Int:
	for line in render_manifest_lines():
		print(line)
	0


func print_result(result: Result[String, RenderError]) -> Int:
	match result:
		Ok(rendered):
			puts(rendered)
			0
		Err(error):
			print(render_error_to_string(error))
			1


func main(args: List[String]) -> Int:
	match args:
		[program_name, command_name, ...command_args]:
			match parse_command(command_name):
				RenderIntrinsicCommand:
					match command_args:
						[name, ...rendered_args]: print_result(
							render_intrinsic(
								name,
								rendered_args,
							),
						)
						[]:
							print(usage)
							1
				RenderManifestCommand: print_manifest()
				UnknownCommand:
					print(usage)
					1
		[]:
			print(usage)
			1
		[program_name]:
			print(usage)
			1
