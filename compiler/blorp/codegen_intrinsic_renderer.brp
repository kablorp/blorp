pure func intrinsic_name(intrinsic: Intrinsic) -> String:
	match intrinsic:
		NoArgs(inner): no_arg_intrinsic_name(inner)
		OneArg(inner): one_arg_intrinsic_name(inner)
		TwoArgs(inner): two_arg_intrinsic_name(inner)
		ThreeArgs(inner): three_arg_intrinsic_name(inner)


pure func intrinsic_arity(intrinsic: Intrinsic) -> Int:
	match intrinsic:
		NoArgs(_): 0
		OneArg(_): 1
		TwoArgs(_): 2
		ThreeArgs(_): 3


