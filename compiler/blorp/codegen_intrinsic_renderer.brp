Value, "fixed_scale" => FixedScale, "fixed_precision" => FixedPrecision, "fixed_pow10" => FixedPow10}

private INTRINSICS_TWO_ARGS: Dict[String, TwoArgIntrinsic] = {"math_pow" => MathPow, "math_atan2" => MathAtan2, "math_hypot" => MathHypot, "math_fmod" => MathFmod, "math_copysign" => MathCopysign, "bit_and" => BitAnd, "bit_or" => BitOr, "bit_xor" => BitXor, "shift_left" => ShiftLeft, "shift_right" => ShiftRight, "list_get" => ListGet, "list_set_len" => ListSetLen, "list_release_elem" => ListReleaseElem, "list_set_elem_release" => ListSetElemRelease, "string_get_byte" => StringGetByte, "string_ensure_capacity" => StringEnsureCapacity, "bytes_get" => BytesGet, "bytes_set_len" => BytesSetLen, "set_bucket" => SetBucket, "set_set_len" => SetSetLen, "set_set_first" => SetSetFirst, "set_set_last" => SetSetLast, "set_entry_set_next" => SetEntrySetNext, "set_entry_set_prev_order" => SetEntrySetPrevOrder, "set_entry_set_next_order" => SetEntrySetNextOrder, "set_hash" => SetHash, "set_eq_immediate" => SetEqImmediate, "set_free_entry" => SetFreeEntry, "set_reuse_alloc" => SetReuseAlloc, "set_resize" => SetResize, "set_reserve_for_len" => SetReserveForLen, "dict_key_at" => DictKeyAt, "dict_value_at" => DictValueAt, "dict_meta_get" => DictMetaGet, "dict_order_get" => DictOrderGet, "dict_order_index_get" => DictOrderIndexGet, "dict_set_len" => DictSetLen, "dict_set_order_len" => DictSetOrderLen, "dict_hash" => DictHash, "dict_eq_immediate" => DictEqImmediate, "dict_reuse_alloc" => DictReuseAlloc, "dict_resize" => DictResize, "tensor_get_i64_word_unchecked" => TensorGetI64WordUnchecked, "tensor_get_i64_raw_unchecked" => TensorGetI64RawUnchecked, "tensor_get_f64" => TensorGetF64, "tensor_get_f32" => TensorGetF32, "tensor_get_f16" => TensorGetF16, "tensor_get_i64" => TensorGetI64}

private INTRINSICS_THREE_ARGS: Dict[String, ThreeArgIntrinsic] = {"math_fma" => MathFma, "string_set_byte" => StringSetByte, "bytes_set" => BytesSet, "set_set_bucket" => SetSetBucket, "set_eq" => SetEq, "dict_set_key_at" => DictSetKeyAt, "dict_set_value_at" => DictSetValueAt, "dict_meta_set" => DictMetaSet, "dict_order_set" => DictOrderSet, "dict_order_index_set" => DictOrderIndexSet, "dict_eq" => DictEq, "slice_alloc" => SliceAlloc, "tensor_set_f64" => TensorSetF64, "tensor_set_f32" => TensorSetF32, "tensor_set_f16" => TensorSetF16, "tensor_set_i64" => TensorSetI64, "fixed_alloc" => FixedAlloc}

usage: String = "Usage: codegen_intrinsic_renderer intrinsic <name> [rendered-arg...] | manifest"


pure func parse_command(command: String) -> CompilerCommand:
	match command:
		"intrinsic": RenderIntrinsicCommand
		"manifest": RenderManifestCommand
		_: UnknownCommand


