-- Blorp-authored renderer for the first self-hosted code-emission slice.
--
-- This tool intentionally starts at the snippet/template boundary: OCaml still
-- owns Core traversal and subexpression emission, while Blorp owns selected
-- intrinsic C expression templates. The production emitter can compare against
-- this renderer before delegating any live code emission to it.
enum CompilerCommand:
	RenderIntrinsicCommand
	RenderManifestCommand
	UnknownCommand


enum NoArgIntrinsic:
	MathInfinity
	MathNegInfinity
	MathNan
	ElemReleaseFn


enum OneArgIntrinsic:
	MathSin
	MathCos
	MathTan
	MathAsin
	MathAcos
	MathAtan
	MathSinh
	MathCosh
	MathTanh
	MathAsinh
	MathAcosh
	MathAtanh
	MathExp
	MathExp2
	MathExpm1
	MathLog
	MathLog2
	MathLog10
	MathLog1p
	MathSqrt
	MathCbrt
	MathFloor
	MathCeil
	MathTrunc
	MathIsNan
	MathIsInf
	MathIsFinite
	BitNot
	ListLen
	ListCapacity
	ListReverseOwned
	StringLen
	StringAlloc
	StringEnsureUnique
	BytesLen
	BytesAlloc
	BytesCow
	DictLen
	SetLen
	SetCapacity
	SetMask
	SetFirst
	SetLast
	SetEntryKey
	SetEntryNext
	SetEntryPrevOrder
	SetEntryNextOrder
	SetHashImmediate
	SetAlloc
	SetAllocEntry
	SetCow
	DictCapacity
	DictMask
	DictGrowAt
	DictOrderLen
	DictKeyReleaseFn
	DictValueReleaseFn
	DictHashImmediate
	DictAlloc
	DictCow
	SliceSource
	SliceStart
	SliceLen
	TensorIsUnique
	TensorLen
	TensorCapacity
	FixedValue
	FixedScale
	FixedPrecision
	FixedPow10


enum TwoArgIntrinsic:
	MathPow
	MathAtan2
	MathHypot
	MathFmod
	MathCopysign
	BitAnd
	BitOr
	BitXor
	ShiftLeft
	ShiftRight
	ListGet
	ListSetLen
	ListReleaseElem
	ListSetElemRelease
	StringGetByte
	StringEnsureCapacity
	BytesGet
	BytesSetLen
	SetBucket
	SetSetLen
	SetSetFirst
	SetSetLast
	SetEntrySetNext
	SetEntrySetPrevOrder
	SetEntrySetNextOrder
	SetHash
	SetEqImmediate
	SetRetainKeyFor
	SetFreeEntry
	SetReuseAlloc
	SetResize
	SetReserveForLen
	DictKeyAt
	DictValueAt
	DictMetaGet
	DictOrderGet
	DictOrderIndexGet
	DictSetLen
	DictSetOrderLen
	DictHash
	DictEqImmediate
	DictRetainKeyFor
	DictRetainValueFor
	DictReleaseValueFor
	DictReuseAlloc
	DictResize
	TensorGetI64WordUnchecked
	TensorGetI64RawUnchecked
	TensorGetF64
	TensorGetF32
	TensorGetF16
	TensorGetI64


enum ThreeArgIntrinsic:
	MathFma
	StringSetByte
	BytesSet
	SetSetBucket
	SetEq
	DictSetKeyAt
	DictSetValueAt
	DictMetaSet
	DictOrderSet
	DictOrderIndexSet
	DictEq
	SliceAlloc
	TensorSetF64
	TensorSetF32
	TensorSetF16
	TensorSetI64
	FixedAlloc


union Intrinsic:
	NoArgs(NoArgIntrinsic)
	OneArg(OneArgIntrinsic)
	TwoArgs(TwoArgIntrinsic)
	ThreeArgs(ThreeArgIntrinsic)


record IntrinsicSpec {
	name: String,
	intrinsic: Intrinsic
}


union RenderError:
	WrongArity(Intrinsic, Int, Int)
	UnsupportedIntrinsic(String)


USAGE: String = "Usage: codegen_intrinsic_renderer intrinsic <name> [rendered-arg...] | manifest"


pure func parse_command(command: String) -> CompilerCommand:
	match command:
		"intrinsic":
			RenderIntrinsicCommand
		"manifest":
			RenderManifestCommand
		_:
			UnknownCommand


pure func intrinsic_arity(intrinsic: Intrinsic) -> Int:
	match intrinsic:
		NoArgs(_):
			0
		OneArg(_):
			1
		TwoArgs(_):
			2
		ThreeArgs(_):
			3


private pure func intrinsic_spec(name: String, intrinsic: Intrinsic) -> IntrinsicSpec:
	{
		name = name,
		intrinsic = intrinsic
	}


