pure func is_assert_shape_special(value: Option[SpecialInference]) -> Bool:
	match value:
		Some(AssertShapeInference):
			True
		_:
			False


pure func is_bitwise_special(value: Option[SpecialInference]) -> Bool:
	match value:
		Some(BitwiseInference):
			True
		_:
			False


func test_builtin_metadata_classifies_effects_and_specials() -> Bool:
	match (builtin_special_inference("length"), builtin_special_inference("tensor4_checked_set")):
		(Some(LengthRefinedInference), Some(TensorCheckedSetInference(rank))):
			(
				rank == 4
				and builtin_is_registered("checked_get")
				and not builtin_is_registered("__missing_builtin__")
				and builtin_is_impure("print")
				and builtin_is_impure("seal")
				and builtin_is_impure("blorp_udp_bind_numeric_raw")
				and builtin_has_effect("send_timeout", BuiltinImpure)
				and builtin_is_cancellation_point("yield_now")
				and builtin_is_cancellation_point("tls_state_probe_for_test")
				and builtin_is_cancellation_point("sleep")
				and builtin_may_park_fiber("recv")
				and builtin_may_park_fiber("blorp_udp_recv_from_raw")
				and not builtin_may_park_fiber("yield_now")
				and builtin_is_os_worker_blocking("blorp_dns_resolve_raw")
				and builtin_is_parallel_boundary("parallel")
				and is_assert_shape_special(builtin_special_inference("assert_shape"))
				and is_bitwise_special(builtin_special_inference("shift_right"))
				and builtin_trait_is_prelude("HasLength")
				and builtin_trait_is_prelude("Absolute")
				and builtin_trait_is_prelude("FloatingPoint")
				and builtin_trait_is_prelude("ToBool")
				and builtin_is_elementwise_tensor_function("sqrt")
				and builtin_is_elementwise_tensor_function("abs")
				and not builtin_is_elementwise_tensor_function("sin")
				and not builtin_trait_is_prelude("UserTrait")
			)
		_:
			False


func test_builtin_effect_lookup_does_not_materialize_registry() -> Bool:
	name: String = "send_timeout"
	reset_mem_stats()
	var classified: Bool = True

	for _ in 0..1000:
		if not builtin_may_park_fiber(name):
			classified = False

	stats = get_mem_stats()
	classified and stats.total_allocations == 0 and stats.total_releases == 0


pure func test_builtin_resource_result_policy_is_explicit() -> Bool:
	(
		builtin_resource_result_policy("blorp_tcp_accept_raw") == ResourceResultIndependent
		and builtin_resource_result_policy("read_handle") == ResourceResultDependent
	)


pure func test_prelude_traits_module_identity_is_explicit() -> Bool:
	(
		prelude_traits_module_matches(CompilerStdlibModule, "std/traits", "traits")
		and prelude_traits_module_matches(CompilerStdlibModule, "traits", "traits")
		and prelude_traits_module_matches(CompilerStdlibModule, "mounted/traits", "traits")
		and not prelude_traits_module_matches(CompilerStdlibModule, "std/other", "other")
		and not prelude_traits_module_matches(CompilerUserModule, "std/traits", "traits")
		and not prelude_traits_module_matches(CompilerUserModule, "user/traits", "traits")
	)


func test_with_builtins_populates_core_env() -> Bool:
	env: Env = env_with_builtins(env_empty())
	length_ufcs_matches = env_lookup_ufcs_methods(
		env,
		"length",
		SemanticNamedType("List", [type_int()]),
	)

	option_ok = match (env_get_type_decl(env, "Option"), env_get_constructor(env, "Some")):
		(Some((option_params, option_variants)), Some(ctor)):
			(
				option_params == ["T"]
				and option_variants.length() == 2
				and ctor.parent_type == "Option"
				and ctor.type_params == ["T"]
				and ctor.field_types.length() == 1
				and ctor.tag == 0
			)
		_:
			False

	concurrency_ok = match (
		env_get_type_decl(env, "ConcurrencyError"),
		env_get_constructor(env, "TaskFailed"),
	):
		(Some((concurrency_params, concurrency_variants)), Some(task_failed_ctor)):
			(
				concurrency_params.length() == 0
				and concurrency_variants.length() == 3
				and task_failed_ctor.parent_type == "ConcurrencyError"
				and task_failed_ctor.type_params.length() == 0
				and task_failed_ctor.field_types.length() == 1
				and types_equal(
					task_failed_ctor.field_types.get_or(0, type_int()),
					type_string(),
				)
				and task_failed_ctor.tag == 1
			)
		_:
			False

	function_ok = match (
		env_get_func_info(env, "print"),
		env_get_func_info(env, "length"),
		env_get_func_info(env, "seal"),
	):
		(Some((_, _, print_purity)), Some((_, length_params, length_purity)), Some((_, _, seal_purity))):
			(
				print_purity == Impure
				and length_params.map(bound_type_param_name) == ["T"]
				and length_purity == Pure
				and seal_purity == Impure
			)
		_:
			False

	(
		option_ok
		and concurrency_ok
		and function_ok
		and env_get_type_kind(env, "Int") == Some(TypeBuiltin)
		and env_is_builtin_func(env, "print")
		and env_is_builtin_func(env, "to_int")
		and env_is_builtin_func(env, "to_float")
		and env_is_builtin_func(env, "to_bool")
		and env_is_builtin_func(env, "to_char")
		and match length_ufcs_matches.get(0):
			Some(length_ufcs_entry):
				overload_type_param_names(length_ufcs_entry) == ["T"]
			None:
				False
		and env_get_function_trait(env, "length") == Some("HasLength")
		and env_get_function_trait(env, "to_bool") == Some("ToBool")
		and env_get_function_trait(env, "to_int") == Some("ToInt")
		and env_get_function_trait(env, "to_float") == Some("ToFloat")
		and env_get_function_trait(env, "less_than") == Some("Orderable")
		and env_resolve_trait_obligation(
			env,
			trait_obligation(type_string(), "Stringable"),
		) == TraitObligationSatisfied
		and env_resolve_trait_obligation(
			env,
			trait_obligation(type_string(), "Orderable"),
		) == TraitObligationSatisfied
		and env_resolve_trait_obligation(
			env,
			trait_obligation(
				SemanticArrayType(
					type_int(),
					[SemanticConstIntType(4), SemanticConstIntType(3)],
				),
				"HasLength",
			),
		) == TraitObligationSatisfied
		and types_equal(
			env_resolve_alias(
				env,
				SemanticNamedType("Int64", []),
			),
			type_int(),
		)
		and types_equal(
			env_resolve_alias(
				env,
				SemanticNamedType("TaskResult", [type_int()]),
			),
			SemanticNamedType(
				"Result",
				[type_int(), SemanticNamedType("ConcurrencyError", [])],
			),
		)
	)


func test_with_builtins_populates_specialized_and_scalar_functions() -> Bool:
	env: Env = env_with_builtins(env_empty())
	required_names: List[String] = [
		"bit_and",
		"bit_not",
		"bit_or",
		"bit_xor",
		"checked_div",
		"checked_mod",
		"checked_set",
		"checked_slice",
		"enumerate2",
		"fixed",
		"from_char",
		"from_chars",
		"matrix_checked_get",
		"matrix_checked_set",
		"matrix",
		"max_threads",
		"recv_timeout",
		"seal",
		"send_timeout",
		"shift_left",
		"shift_right",
		"tensor3",
		"tensor3_checked_get",
		"tensor3_checked_set",
		"tensor4",
		"tensor4_checked_get",
		"tensor4_checked_set",
		"tensor5",
		"tensor5_checked_get",
		"tensor5_checked_set",
		"tensor_peel",
		"to_float16",
		"to_float32",
		"to_int8",
		"to_int16",
		"to_int32",
		"to_int128",
		"to_uint8",
		"to_uint16",
		"to_uint32",
		"to_uint64",
		"to_uint128",
		"try_recv",
		"try_send",
		"vector",
		"zip",
	]

	required_names.all(func(name): env_is_builtin_func(env, name))


func test_channel_builtins_use_public_result_types() -> Bool:
	env: Env = env_with_builtins(env_empty())
	type_t: SemanticType = SemanticTypeVar("T")
	channel_t: SemanticType = SemanticNamedType("Channel", [type_t])

	match (env_get_func_info(env, "send"), env_get_func_info(env, "recv")):
		(Some((send_type, _, _)), Some((recv_type, _, _))):
			types_equal(
				send_type,
				SemanticFunctionType(
					False,
					[channel_t, type_t],
					type_bool(),
				),
			) and types_equal(
				recv_type,
				SemanticFunctionType(
					False,
					[channel_t],
					SemanticNamedType("Option", [type_t]),
				),
			)
		_:
			False


func test_builtin_numeric_families_satisfy_declared_traits() -> Bool:
	env: Env = env_with_builtins(env_empty())

	env_resolve_trait_obligation(
		env,
		trait_obligation(
			SemanticNamedType("Int32", []),
			"Integer",
		),
	) == TraitObligationSatisfied and env_resolve_trait_obligation(
		env,
		trait_obligation(
			SemanticNamedType("Int16", []),
			"SignedInteger",
		),
	) == TraitObligationSatisfied and env_resolve_trait_obligation(
		env,
		trait_obligation(
			SemanticNamedType("UInt8", []),
			"UnsignedInteger",
		),
	) == TraitObligationSatisfied and env_resolve_trait_obligation(
		env,
		trait_obligation(
			SemanticNamedType("Float32", []),
			"FloatingPoint",
		),
	) == TraitObligationSatisfied


func test_floating_point_methods_are_registered() -> Bool:
	env: Env = env_with_builtins(env_empty())
	method_names: List[String] = [
		"floor",
		"ceil",
		"round",
		"trunc",
		"sqrt",
		"sin",
		"cos",
		"tan",
		"asin",
		"acos",
		"atan",
		"atan2",
		"sinh",
		"cosh",
		"tanh",
		"asinh",
		"acosh",
		"atanh",
		"exp",
		"exp2",
		"expm1",
		"log",
		"log2",
		"log10",
		"log1p",
		"pow",
		"cbrt",
		"hypot",
		"fmod",
		"copysign",
		"fma",
		"is_nan",
		"is_inf",
		"is_finite",
	]

	registered = method_names.all(func(name):
		env_get_function_trait(env, name) == Some("FloatingPoint")
	)

	registered and match env_get_trait(env, "FloatingPoint"):
		Some(trait_def):
			trait_def.methods.any(func(method):
				floating_point_method_matches(
					method,
					"atan2",
					[SemanticSelfType, SemanticSelfType],
					SemanticSelfType,
				)
			) and trait_def.methods.any(func(method):
				floating_point_method_matches(
					method,
					"fma",
					[SemanticSelfType, SemanticSelfType, SemanticSelfType],
					SemanticSelfType,
				)
			) and trait_def.methods.any(func(method):
				floating_point_method_matches(method, "is_finite", [SemanticSelfType], type_bool())
			)
		None:
			False


pure func floating_point_method_matches(
	method: TraitMethodSig,
	name: String,
	params: List[SemanticType],
	return_type: SemanticType,
) -> Bool:
	(
		method.name == name
		and method.is_pure
		and floating_point_param_types_match(method.params, params)
		and types_equal(method.return_type, return_type)
	)


pure func floating_point_param_types_match(
	left: List[SemanticType],
	right: List[SemanticType],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var index: Int = 0
		var equal: Bool = True

		while index < left.length() and equal:
			equal = types_equal(
				left.get_or(index, SemanticSelfType),
				right.get_or(index, SemanticSelfType),
			)
			index += 1

		equal


func test_assert_shape_builtin_uses_variadic_tensor_signature() -> Bool:
	env: Env = env_with_builtins(env_empty())
	type_t: SemanticType = SemanticTypeVar("T")
	tensor_t: SemanticType = SemanticArrayType(type_t, [SemanticVarDimsType("#Ds")])

	match env_get_func_info(env, "assert_shape"):
		Some((typ, params, purity)):
			params.map(bound_type_param_name) == ["T"] and purity == Pure and types_equal(
				typ,
				SemanticFunctionType(
					True,
					[tensor_t, type_int()],
					SemanticNamedType("Option", [tensor_t]),
				),
			)
		None:
			False


func test_hashable_primitives_and_dispatch_are_registered() -> Bool:
	env: Env = env_with_builtins(env_empty())
	hashable_types: List[SemanticType] = [
		type_int(),
		SemanticNamedType("Int8", []),
		SemanticNamedType("Int16", []),
		SemanticNamedType("Int32", []),
		SemanticNamedType("Int64", []),
		SemanticNamedType("Int128", []),
		SemanticNamedType("UInt8", []),
		SemanticNamedType("UInt16", []),
		SemanticNamedType("UInt32", []),
		SemanticNamedType("UInt64", []),
		SemanticNamedType("UInt128", []),
		SemanticNamedType("Float", []),
		SemanticNamedType("Float32", []),
		SemanticNamedType("Float16", []),
		SemanticNamedType("Bool", []),
		SemanticNamedType("Char", []),
		type_string(),
	]

	(
		builtin_trait_is_prelude("Hashable")
		and env_get_function_trait(env, "hash") == Some("Hashable")
		and env_is_builtin_func(env, "hash")
		and env_is_builtin_func(env, "hash_combine")
		and hashable_types.all(func(typ):
			env_resolve_trait_obligation(
				env,
				trait_obligation(typ, "Hashable"),
			) == TraitObligationSatisfied
		)
	)


tests: TestSuite = {
	description = "Compiler builtins substrate",
	tests = [
		(
			"builtin metadata classifies effects and specials",
			test_builtin_metadata_classifies_effects_and_specials,
		),
		(
			"builtin effect lookup does not materialize registry",
			test_builtin_effect_lookup_does_not_materialize_registry,
		),
		(
			"builtin resource result policy is explicit",
			test_builtin_resource_result_policy_is_explicit,
		),
		(
			"prelude traits module identity is explicit",
			test_prelude_traits_module_identity_is_explicit,
		),
		("with builtins populates core env", test_with_builtins_populates_core_env),
		(
			"with builtins populates specialized and scalar functions",
			test_with_builtins_populates_specialized_and_scalar_functions,
		),
		("channel builtins use public result types", test_channel_builtins_use_public_result_types),
		(
			"builtin numeric families satisfy declared traits",
			test_builtin_numeric_families_satisfy_declared_traits,
		),
		("FloatingPoint methods are registered", test_floating_point_methods_are_registered),
		(
			"assert_shape uses variadic tensor signature",
			test_assert_shape_builtin_uses_variadic_tensor_signature,
		),
		(
			"Hashable primitives and dispatch are registered",
			test_hashable_primitives_and_dispatch_are_registered,
		),
	]
}
