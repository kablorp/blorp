import:
	../compiler_builtins:
		CompilerBuiltinEffect(
			CompilerBuiltinCancellationPoint,
			CompilerBuiltinFiberParking,
			CompilerBuiltinImpure,
			CompilerBuiltinOsWorkerBlocking,
			CompilerBuiltinParallelBoundary,
		),
		CompilerSpecialInference(
			CompilerAssertShapeInference,
			CompilerBitwiseInference,
			CompilerLengthRefinedInference,
			CompilerTensorCheckedSetInference,
		),
		compiler_builtin_duplicate_names,
		compiler_builtin_has_effect,
		compiler_builtin_inert_descriptor_names,
		compiler_builtin_is_cancellation_point,
		compiler_builtin_is_impure,
		compiler_builtin_is_os_worker_blocking,
		compiler_builtin_is_parallel_boundary,
		compiler_builtin_is_registered,
		compiler_builtin_may_park_fiber,
		compiler_builtin_special_inference,
		compiler_env_with_builtins,
	../compiler_env:
		CompilerEnv,
		CompilerPurity(CompilerImpure, CompilerPure),
		CompilerTraitObligationResolution(CompilerTraitObligationSatisfied),
		CompilerTypeKind(CompilerTypeBuiltin),
		compiler_env_empty,
		compiler_env_get_constructor,
		compiler_env_get_func_info,
		compiler_env_get_function_trait,
		compiler_env_get_type_decl,
		compiler_env_get_type_kind,
		compiler_env_is_builtin_func,
		compiler_env_lookup_ufcs_methods,
		compiler_env_resolve_alias,
		compiler_env_resolve_trait_obligation,
		compiler_overload_type_param_names,
		compiler_trait_obligation,
	../compiler_generic_params: compiler_bound_type_param_name
	../compiler_type:
		CompilerType(CompilerNamedType, CompilerTypeVar),
		compiler_type_int,
		compiler_type_string,
		compiler_types_equal,
	test: TestSuite


pure func is_assert_shape_special(value: Option[CompilerSpecialInference]) -> Bool:
	match value:
		Some(CompilerAssertShapeInference):
			True
		_:
			False


pure func is_bitwise_special(value: Option[CompilerSpecialInference]) -> Bool:
	match value:
		Some(CompilerBitwiseInference):
			True
		_:
			False


func test_builtin_metadata_classifies_effects_and_specials() -> Bool:
	match (
		compiler_builtin_special_inference("length"),
		compiler_builtin_special_inference("tensor4_checked_set"),
	):
		(Some(CompilerLengthRefinedInference), Some(CompilerTensorCheckedSetInference(rank))):
			(
				rank == 4
				and compiler_builtin_is_registered("checked_get")
				and not compiler_builtin_is_registered("__missing_builtin__")
				and compiler_builtin_is_impure("print")
				and compiler_builtin_has_effect("send_timeout", CompilerBuiltinImpure)
				and compiler_builtin_is_cancellation_point("yield_now")
				and compiler_builtin_is_cancellation_point("sleep")
				and compiler_builtin_may_park_fiber("recv")
				and not compiler_builtin_may_park_fiber("yield_now")
				and compiler_builtin_is_os_worker_blocking("blorp_dns_resolve_raw")
				and compiler_builtin_is_parallel_boundary("parallel")
				and is_assert_shape_special(compiler_builtin_special_inference("assert_shape"))
				and is_bitwise_special(compiler_builtin_special_inference("shift_right"))
				and compiler_builtin_duplicate_names().length() == 0
				and compiler_builtin_inert_descriptor_names().length() == 0
			)
		_:
			False


func test_with_builtins_populates_core_env() -> Bool:
	env: CompilerEnv = compiler_env_with_builtins(compiler_env_empty())
	length_ufcs_matches = compiler_env_lookup_ufcs_methods(
		env,
		"length",
		CompilerNamedType("List", [compiler_type_int()]),
	)
	option_ok = match (
		compiler_env_get_type_decl(env, "Option"),
		compiler_env_get_constructor(env, "Some"),
	):
		(Some((option_params, option_variants)), Some(ctor)):
			(
				option_params == ["T"]
				and option_variants.length() == 2
				and ctor.parent_type == "Option"
				and ctor.type_params == ["T"]
				and ctor.field_types.length() == 1
				and ctor.tag == 0
			)
		_:
			False
	concurrency_ok = match (
		compiler_env_get_type_decl(env, "ConcurrencyError"),
		compiler_env_get_constructor(env, "TaskFailed"),
	):
		(
			Some((concurrency_params, concurrency_variants)),
			Some(task_failed_ctor),
		):
			(
				concurrency_params.length() == 0
				and concurrency_variants.length() == 3
				and task_failed_ctor.parent_type == "ConcurrencyError"
				and task_failed_ctor.type_params.length() == 0
				and task_failed_ctor.field_types.length() == 1
				and compiler_types_equal(
					task_failed_ctor.field_types.get_or(0, compiler_type_int()),
					compiler_type_string(),
				)
				and task_failed_ctor.tag == 1
			)
		_:
			False
	function_ok = match (
		compiler_env_get_func_info(env, "print"),
		compiler_env_get_func_info(env, "length"),
	):
		(Some((_, _, print_purity)), Some((_, length_params, length_purity))):
			(
				print_purity == CompilerImpure
				and length_params.map(compiler_bound_type_param_name) == ["T"]
				and length_purity == CompilerPure
			)
		_:
			False

	(
		option_ok
		and concurrency_ok
		and function_ok
		and compiler_env_get_type_kind(env, "Int") == Some(CompilerTypeBuiltin)
		and compiler_env_is_builtin_func(env, "print")
		and compiler_env_is_builtin_func(env, "to_int")
		and compiler_env_is_builtin_func(env, "to_float")
		and compiler_env_is_builtin_func(env, "to_bool")
		and compiler_env_is_builtin_func(env, "to_char")
		and match length_ufcs_matches.get(0):
			Some(length_ufcs_entry):
				compiler_overload_type_param_names(length_ufcs_entry) == ["T"]
			None:
				False
		and compiler_env_get_function_trait(env, "length") == Some("HasLength")
		and compiler_env_get_function_trait(env, "to_int") == Some("ToInt")
		and compiler_env_get_function_trait(env, "to_float") == Some("ToFloat")
		and compiler_env_get_function_trait(env, "less_than") == Some("Orderable")
		and compiler_env_resolve_trait_obligation(
			env,
			compiler_trait_obligation(compiler_type_string(), "Stringable"),
		) == CompilerTraitObligationSatisfied
		and compiler_env_resolve_trait_obligation(
			env,
			compiler_trait_obligation(compiler_type_string(), "Orderable"),
		) == CompilerTraitObligationSatisfied
		and compiler_types_equal(
			compiler_env_resolve_alias(
				env,
				CompilerNamedType("Int64", []),
			),
			compiler_type_int(),
		)
		and compiler_types_equal(
			compiler_env_resolve_alias(
				env,
				CompilerNamedType("TaskResult", [compiler_type_int()]),
			),
			CompilerNamedType(
				"Result",
				[compiler_type_int(), CompilerNamedType("ConcurrencyError", [])],
			),
		)
	)


tests: TestSuite = {
	description = "Compiler builtins substrate",
	tests = [
		(
			"builtin metadata classifies effects and specials",
			test_builtin_metadata_classifies_effects_and_specials,
		),
		("with builtins populates core env", test_with_builtins_populates_core_env),
	]
}
