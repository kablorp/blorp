pure func is_assert_shape_special(value: Option[CompilerSpecialInference]) -> Bool:
	match value:
		Some(CompilerAssertShapeInference):
			True
		_:
			False


pure func is_bitwise_special(value: Option[CompilerSpecialInference]) -> Bool:
	match value:
		Some(CompilerBitwiseInference):
			True
		_:
			False


func test_builtin_metadata_classifies_effects_and_specials() -> Bool:
	match (
		compiler_builtin_special_inference("length"),
		compiler_builtin_special_inference("tensor4_checked_set"),
	):
		(Some(CompilerLengthRefinedInference), Some(CompilerTensorCheckedSetInference(rank))):
			(
				rank == 4
				and compiler_builtin_is_registered("checked_get")
				and not compiler_builtin_is_registered("__missing_builtin__")
				and compiler_builtin_is_impure("print")
				and compiler_builtin_is_impure("seal")
				and compiler_builtin_is_impure("blorp_udp_bind_numeric_raw")
				and compiler_builtin_has_effect("send_timeout", CompilerBuiltinImpure)
				and compiler_builtin_is_cancellation_point("yield_now")
				and compiler_builtin_is_cancellation_point("tls_state_probe_for_test")
				and compiler_builtin_is_cancellation_point("sleep")
				and compiler_builtin_may_park_fiber("recv")
				and compiler_builtin_may_park_fiber("blorp_udp_recv_from_raw")
				and not compiler_builtin_may_park_fiber("yield_now")
				and compiler_builtin_is_os_worker_blocking("blorp_dns_resolve_raw")
				and compiler_builtin_is_parallel_boundary("parallel")
				and is_assert_shape_special(compiler_builtin_special_inference("assert_shape"))
				and is_bitwise_special(compiler_builtin_special_inference("shift_right"))
				and compiler_builtin_trait_is_prelude("HasLength")
				and compiler_builtin_trait_is_prelude("Absolute")
				and compiler_builtin_trait_is_prelude("FloatingPoint")
				and not compiler_builtin_trait_is_prelude("UserTrait")
			)
		_:
			False


func test_builtin_effect_lookup_does_not_materialize_registry() -> Bool:
	name: String = "send_timeout"
	reset_mem_stats()
	var classified: Bool = True

	for _ in 0..1000:
		if not compiler_builtin_may_park_fiber(name):
			classified = False

	stats = get_mem_stats()
	classified and stats.total_allocations == 0 and stats.total_releases == 0


func test_with_builtins_populates_core_env() -> Bool:
	env: CompilerEnv = compiler_env_with_builtins(compiler_env_empty())
	length_ufcs_matches = compiler_env_lookup_ufcs_methods(
		env,
		"length",
		CompilerNamedType("List", [compiler_type_int()]),
	)

	option_ok = match (
		compiler_env_get_type_decl(env, "Option"),
		compiler_env_get_constructor(env, "Some"),
	):
		(Some((option_params, option_variants)), Some(ctor)):
			(
				option_params == ["T"]
				and option_variants.length() == 2
				and ctor.parent_type == "Option"
				and ctor.type_params == ["T"]
				and ctor.field_types.length() == 1
				and ctor.tag == 0
			)
		_:
			False

	concurrency_ok = match (
		compiler_env_get_type_decl(env, "ConcurrencyError"),
		compiler_env_get_constructor(env, "TaskFailed"),
	):
		(Some((concurrency_params, concurrency_variants)), Some(task_failed_ctor)):
			(
				concurrency_params.length() == 0
				and concurrency_variants.length() == 3
				and task_failed_ctor.parent_type == "ConcurrencyError"
				and task_failed_ctor.type_params.length() == 0
				and task_failed_ctor.field_types.length() == 1
				and compiler_types_equal(
					task_failed_ctor.field_types.get_or(0, compiler_type_int()),
					compiler_type_string(),
				)
				and task_failed_ctor.tag == 1
			)
		_:
			False

	function_ok = match (
		compiler_env_get_func_info(env, "print"),
		compiler_env_get_func_info(env, "length"),
		compiler_env_get_func_info(env, "seal"),
	):
		(Some((_, _, print_purity)), Some((_, length_params, length_purity)), Some((_, _, seal_purity))):
			(
				print_purity == CompilerImpure
				and length_params.map(compiler_bound_type_param_name) == ["T"]
				and length_purity == CompilerPure
				and seal_purity == CompilerImpure
			)
		_:
			False

	(
		option_ok
		and concurrency_ok
		and function_ok
		and compiler_env_get_type_kind(env, "Int") == Some(CompilerTypeBuiltin)
		and compiler_env_is_builtin_func(env, "print")
		and compiler_env_is_builtin_func(env, "to_int")
		and compiler_env_is_builtin_func(env, "to_float")
		and compiler_env_is_builtin_func(env, "to_bool")
		and compiler_env_is_builtin_func(env, "to_char")
		and match length_ufcs_matches.get(0):
			Some(length_ufcs_entry):
				compiler_overload_type_param_names(length_ufcs_entry) == ["T"]
			None:
				False
		and compiler_env_get_function_trait(env, "length") == Some("HasLength")
		and compiler_env_get_function_trait(env, "to_int") == Some("ToInt")
		and compiler_env_get_function_trait(env, "to_float") == Some("ToFloat")
		and compiler_env_get_function_trait(env, "less_than") == Some("Orderable")
		and compiler_env_resolve_trait_obligation(
			env,
			compiler_trait_obligation(compiler_type_string(), "Stringable"),
		) == CompilerTraitObligationSatisfied
		and compiler_env_resolve_trait_obligation(
			env,
			compiler_trait_obligation(compiler_type_string(), "Orderable"),
		) == CompilerTraitObligationSatisfied
		and compiler_env_resolve_trait_obligation(
			env,
			compiler_trait_obligation(
				CompilerArrayType(
					compiler_type_int(),
					[CompilerConstIntType(4), CompilerConstIntType(3)],
				),
				"HasLength",
			),
		) == CompilerTraitObligationSatisfied
		and compiler_types_equal(
			compiler_env_resolve_alias(
				env,
				CompilerNamedType("Int64", []),
			),
			compiler_type_int(),
		)
		and compiler_types_equal(
			compiler_env_resolve_alias(
				env,
				CompilerNamedType("TaskResult", [compiler_type_int()]),
			),
			CompilerNamedType(
				"Result",
				[compiler_type_int(), CompilerNamedType("ConcurrencyError", [])],
			),
		)
	)


func test_with_builtins_populates_specialized_and_scalar_functions() -> Bool:
	env: CompilerEnv = compiler_env_with_builtins(compiler_env_empty())
	required_names: List[String] = [
		"bit_and",
		"bit_not",
		"bit_or",
		"bit_xor",
		"checked_div",
		"checked_mod",
		"checked_set",
		"checked_slice",
		"enumerate2",
		"fixed",
		"from_char",
		"from_chars",
		"matrix_checked_get",
		"matrix_checked_set",
		"matrix",
		"max_threads",
		"recv_timeout",
		"seal",
		"send_timeout",
		"shift_left",
		"shift_right",
		"tensor3",
		"tensor3_checked_get",
		"tensor3_checked_set",
		"tensor4",
		"tensor4_checked_get",
		"tensor4_checked_set",
		"tensor5",
		"tensor5_checked_get",
		"tensor5_checked_set",
		"tensor_peel",
		"to_float16",
		"to_float32",
		"to_int8",
		"to_int16",
		"to_int32",
		"to_int128",
		"to_uint8",
		"to_uint16",
		"to_uint32",
		"to_uint64",
		"to_uint128",
		"try_recv",
		"try_send",
		"vector",
		"zip",
	]

	required_names.all(func(name): compiler_env_is_builtin_func(env, name))


func test_channel_builtins_use_public_result_types() -> Bool:
	env: CompilerEnv = compiler_env_with_builtins(compiler_env_empty())
	type_t: CompilerType = CompilerTypeVar("T")
	channel_t: CompilerType = CompilerNamedType("Channel", [type_t])

	match (compiler_env_get_func_info(env, "send"), compiler_env_get_func_info(env, "recv")):
		(Some((send_type, _, _)), Some((recv_type, _, _))):
			compiler_types_equal(
				send_type,
				CompilerFunctionType(
					False,
					[channel_t, type_t],
					compiler_type_bool(),
				),
			) and compiler_types_equal(
				recv_type,
				CompilerFunctionType(
					False,
					[channel_t],
					CompilerNamedType("Option", [type_t]),
				),
			)
		_:
			False


func test_builtin_numeric_families_satisfy_declared_traits() -> Bool:
	env: CompilerEnv = compiler_env_with_builtins(compiler_env_empty())

	compiler_env_resolve_trait_obligation(
		env,
		compiler_trait_obligation(
			CompilerNamedType("Int32", []),
			"Integer",
		),
	) == CompilerTraitObligationSatisfied and compiler_env_resolve_trait_obligation(
		env,
		compiler_trait_obligation(
			CompilerNamedType("Int16", []),
			"SignedInteger",
		),
	) == CompilerTraitObligationSatisfied and compiler_env_resolve_trait_obligation(
		env,
		compiler_trait_obligation(
			CompilerNamedType("UInt8", []),
			"UnsignedInteger",
		),
	) == CompilerTraitObligationSatisfied and compiler_env_resolve_trait_obligation(
		env,
		compiler_trait_obligation(
			CompilerNamedType("Float32", []),
			"FloatingPoint",
		),
	) == CompilerTraitObligationSatisfied


func test_floating_point_methods_are_registered() -> Bool:
	env: CompilerEnv = compiler_env_with_builtins(compiler_env_empty())
	method_names: List[String] = [
		"floor",
		"ceil",
		"round",
		"trunc",
		"sqrt",
		"sin",
		"cos",
		"tan",
		"asin",
		"acos",
		"atan",
		"atan2",
		"sinh",
		"cosh",
		"tanh",
		"asinh",
		"acosh",
		"atanh",
		"exp",
		"exp2",
		"expm1",
		"log",
		"log2",
		"log10",
		"log1p",
		"pow",
		"cbrt",
		"hypot",
		"fmod",
		"copysign",
		"fma",
		"is_nan",
		"is_inf",
		"is_finite",
	]

	registered = method_names.all(func(name):
		compiler_env_get_function_trait(env, name) == Some("FloatingPoint")
	)

	registered and match compiler_env_get_trait(env, "FloatingPoint"):
		Some(trait_def):
			trait_def.methods.any(func(method):
				floating_point_method_matches(
					method,
					"atan2",
					[CompilerSelfType, CompilerSelfType],
					CompilerSelfType,
				)
			) and trait_def.methods.any(func(method):
				floating_point_method_matches(
					method,
					"fma",
					[CompilerSelfType, CompilerSelfType, CompilerSelfType],
					CompilerSelfType,
				)
			) and trait_def.methods.any(func(method):
				floating_point_method_matches(
					method,
					"is_finite",
					[CompilerSelfType],
					compiler_type_bool(),
				)
			)
		None:
			False


pure func floating_point_method_matches(
	method: CompilerTraitMethodSig,
	name: String,
	params: List[CompilerType],
	return_type: CompilerType,
) -> Bool:
	(
		method.name == name
		and method.is_pure
		and floating_point_param_types_match(method.params, params)
		and compiler_types_equal(method.return_type, return_type)
	)


pure func floating_point_param_types_match(
	left: List[CompilerType],
	right: List[CompilerType],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var index: Int = 0
		var equal: Bool = True

		while index < left.length() and equal:
			equal = compiler_types_equal(
				left.get_or(index, CompilerSelfType),
				right.get_or(index, CompilerSelfType),
			)
			index += 1

		equal


func test_assert_shape_builtin_uses_variadic_tensor_signature() -> Bool:
	env: CompilerEnv = compiler_env_with_builtins(compiler_env_empty())
	type_t: CompilerType = CompilerTypeVar("T")
	tensor_t: CompilerType = CompilerArrayType(type_t, [CompilerVarDimsType("#Ds")])

	match compiler_env_get_func_info(env, "assert_shape"):
		Some((typ, params, purity)):
			(
				params.map(compiler_bound_type_param_name) == ["T"]
				and purity == CompilerPure
				and compiler_types_equal(
					typ,
					CompilerFunctionType(
						True,
						[tensor_t, compiler_type_int()],
						CompilerNamedType(
							"Option",
							[tensor_t],
						),
					),
				)
			)
		None:
			False


func test_hashable_primitives_and_dispatch_are_registered() -> Bool:
	env: CompilerEnv = compiler_env_with_builtins(compiler_env_empty())
	hashable_types: List[CompilerType] = [
		compiler_type_int(),
		CompilerNamedType("Int8", []),
		CompilerNamedType("Int16", []),
		CompilerNamedType("Int32", []),
		CompilerNamedType("Int64", []),
		CompilerNamedType("Int128", []),
		CompilerNamedType("UInt8", []),
		CompilerNamedType("UInt16", []),
		CompilerNamedType("UInt32", []),
		CompilerNamedType("UInt64", []),
		CompilerNamedType("UInt128", []),
		CompilerNamedType("Float", []),
		CompilerNamedType("Float32", []),
		CompilerNamedType("Float16", []),
		CompilerNamedType("Bool", []),
		CompilerNamedType("Char", []),
		compiler_type_string(),
	]

	(
		compiler_builtin_trait_is_prelude("Hashable")
		and compiler_env_get_function_trait(env, "hash") == Some("Hashable")
		and compiler_env_is_builtin_func(env, "hash")
		and compiler_env_is_builtin_func(env, "hash_combine")
		and hashable_types.all(func(typ):
			compiler_env_resolve_trait_obligation(
				env,
				compiler_trait_obligation(typ, "Hashable"),
			) == CompilerTraitObligationSatisfied
		)
	)


tests: TestSuite = {
	description = "Compiler builtins substrate",
	tests = [
		(
			"builtin metadata classifies effects and specials",
			test_builtin_metadata_classifies_effects_and_specials,
		),
		(
			"builtin effect lookup does not materialize registry",
			test_builtin_effect_lookup_does_not_materialize_registry,
		),
		("with builtins populates core env", test_with_builtins_populates_core_env),
		(
			"with builtins populates specialized and scalar functions",
			test_with_builtins_populates_specialized_and_scalar_functions,
		),
		("channel builtins use public result types", test_channel_builtins_use_public_result_types),
		(
			"builtin numeric families satisfy declared traits",
			test_builtin_numeric_families_satisfy_declared_traits,
		),
		("FloatingPoint methods are registered", test_floating_point_methods_are_registered),
		(
			"assert_shape uses variadic tensor signature",
			test_assert_shape_builtin_uses_variadic_tensor_signature,
		),
		(
			"Hashable primitives and dispatch are registered",
			test_hashable_primitives_and_dispatch_are_registered,
		),
	]
}
