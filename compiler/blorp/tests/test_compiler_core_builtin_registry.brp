import:
	../src/stage_09_core/core_builtin_registry:
		core_builtin_name,
		core_structural_length_intrinsic,
	test: TestSuite


pure func maps_to(module_path: String, name: String, runtime_name: String) -> Bool:
	match core_builtin_name(module_path, name):
		Some(actual):
			actual == runtime_name
		None:
			False


pure func test_prelude_and_math_builtins() -> Bool:
	(
		maps_to("", "length", "blorp_length")
		and maps_to("", "equals", "blorp_eq_dispatch")
		and maps_to("", "channel", "blorp_channel_new")
		and maps_to("", "recv_timeout", "blorp_channel_recv_timeout")
		and maps_to("", "sqrt", "sqrt")
		and maps_to("", "is_finite", "blorp_is_finite")
		and maps_to("std/math", "hypot", "hypot")
	)


pure func test_collection_and_tensor_builtins() -> Bool:
	(
		maps_to("std/list", "list", "blorp_list_new")
		and maps_to("std/dict", "get", "blorp_dict_get")
		and maps_to("std/dict", "with_capacity", "blorp_dict_with_capacity")
		and maps_to("std/set", "add", "blorp_set_add")
		and maps_to("std/tensor", "checked_slice", "blorp_checked_slice")
		and maps_to("std/vector", "cross", "blorp_vector_cross_float")
		and maps_to("std/matrix", "multiply", "blorp_tensor_matrix_multiply")
		and maps_to("std/matrix", "set_cell", "blorp_matrix_checked_set")
	)


pure func test_text_stream_and_bytes_builtins() -> Bool:
	(
		maps_to("std/string", "upper", "blorp_upper")
		and maps_to("std/string", "to_bytes", "blorp_bytes_from_string")
		and maps_to("std/regex", "replace_all", "blorp_regex_replace_all")
		and maps_to("std/stream", "filter_map", "blorp_stream_filter_map")
		and maps_to("std/stream", "for_each", "blorp_stream_for_each")
		and maps_to("std/bytes", "from_hex", "blorp_bytes_from_hex")
		and maps_to("std/bytes", "decode_utf8", "blorp_decode_utf8")
	)


pure func test_system_and_optional_builtins() -> Bool:
	(
		maps_to("std/net/dns", "resolve", "blorp_dns_resolve_raw")
		and maps_to("std/net/tcp", "set_reuse_addr", "blorp_tcp_set_reuse_addr_raw")
		and maps_to("std/net/tls", "read_chunk", "blorp_tls_read_raw")
		and maps_to("std/net/udp", "send_to_wait", "blorp_udp_send_to_wait_raw")
		and maps_to("std/net/websocket", "send_binary", "blorp_websocket_send_binary_raw")
		and maps_to("std/channel", "try_recv", "blorp_channel_try_recv")
		and maps_to("./raylib", "draw_text", "blorp_raylib_draw_text")
	)


pure func test_unknown_builtin_is_rejected() -> Bool:
	(
		core_builtin_name("std/dict", "missing").is_none()
		and core_builtin_name("std/unknown", "get").is_none()
		and core_builtin_name("", "missing").is_none()
	)


pure func structural_length_maps_to(
	module_path: String,
	receiver_name: String,
	intrinsic_name: String,
) -> Bool:
	match core_structural_length_intrinsic(module_path, "length", receiver_name, 1):
		Some(actual):
			actual == intrinsic_name
		None:
			False


pure func test_structural_length_intrinsics() -> Bool:
	(
		structural_length_maps_to("std/list", "List", "list_len")
		and structural_length_maps_to("std/string", "String", "string_len")
		and structural_length_maps_to("std/bytes", "Bytes", "bytes_len")
		and structural_length_maps_to("std/dict", "Dict", "dict_len")
		and structural_length_maps_to("std/set", "Set", "set_len")
	)


pure func test_structural_length_rejects_wrong_shape() -> Bool:
	(
		core_structural_length_intrinsic("std/dict", "length", "Set", 1).is_none()
		and core_structural_length_intrinsic("std/unknown", "length", "List", 1).is_none()
		and core_structural_length_intrinsic("std/list", "size", "List", 1).is_none()
		and core_structural_length_intrinsic("std/list", "length", "List", 2).is_none()
	)


tests: TestSuite = {
	description = "Blorp compiler Core builtin registry",
	tests = [
		("prelude and math builtins", test_prelude_and_math_builtins),
		("collection and tensor builtins", test_collection_and_tensor_builtins),
		("text stream and bytes builtins", test_text_stream_and_bytes_builtins),
		("system and optional builtins", test_system_and_optional_builtins),
		("unknown builtin is rejected", test_unknown_builtin_is_rejected),
		("structural length intrinsics", test_structural_length_intrinsics),
		("structural length rejects wrong shape", test_structural_length_rejects_wrong_shape),
	]
}
