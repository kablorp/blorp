import:
	../src/stage_03_parse/parser_bridge as ParserBridge
	../src/stage_04_modules/loaded_module:
		CompilerModuleLoadCandidate,
		CompilerModuleOrigin(CompilerUserModule),
		compiler_module_load_candidate,
		compiler_resolved_module_identity_from_resolver,
	../src/stage_06_typecheck/graph/indexed_graph:
		CompilerPreparedModuleScope,
		compiler_indexed_graph_build,
		compiler_prepared_module_scope_module,
		prepared_module_program,
	../src/stage_06_typecheck/headers/callable_headers: compiler_callable_header_graph_build
	../src/stage_06_typecheck/headers/callable_signature:
		compiler_callable_parameter_type,
		compiler_callable_signature_parameters,
	../src/stage_06_typecheck/headers/declaration_skeleton:
		compiler_declaration_skeleton_graph_build,
		compiler_impl_ids_equal,
		compiler_trait_id_name,
	../src/stage_06_typecheck/headers/implementation_headers:
		CompilerImplementationHeaderGraph,
		CompilerImplementationReceiverHeadCategory(CompilerDeclaredReceiverHead),
		compiler_explicit_implementation_method_signature,
		compiler_implementation_header_graph_build,
		compiler_implementation_header_graph_candidates,
		compiler_implementation_header_graph_error_message,
		compiler_implementation_header_graph_headers,
		compiler_implementation_header_id,
		compiler_implementation_header_method_ids,
		compiler_implementation_header_methods,
		compiler_implementation_header_parameters,
		compiler_implementation_header_receiver,
		compiler_implementation_header_receiver_head,
		compiler_implementation_header_trait_id,
		compiler_resolved_implementation_type_parameter_id,
	../src/stage_06_typecheck/headers/trait_headers: compiler_trait_topology_graph_build
	../src/stage_06_typecheck/headers/type_header_dependencies:
		compiler_type_alias_dependency_graph_validate,
	../src/stage_06_typecheck/headers/type_header_graph:
		CompilerResolvedTypeShape(
			CompilerDeclaredTypeShape,
			CompilerImplementationTypeParameterShape,
		),
		compiler_implementation_type_parameter_id_index,
		compiler_type_header_graph_build,
	../src/stage_06_typecheck/headers/type_parameter_headers:
		compiler_resolved_type_parameter_graph_build,
	../src/stage_06_typecheck/modules/bound_module_graph:
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		CompilerBoundModuleViewBinding(CompilerBoundModuleViewReady),
		compiler_bound_module_graph_build,
	../src/stage_06_typecheck/modules/module_view: COMPILER_MODULE_VIEW_EMPTY
	test: TestSuite


private pure func module_load_candidate(source: String) -> CompilerModuleLoadCandidate:
	module_load_candidate_at("main", source)


private pure func module_load_candidate_at(
	module_path: String,
	source: String,
) -> CompilerModuleLoadCandidate:
	compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver(module_path, CompilerUserModule),
		ParserBridge.parsed_typecheck_source_bridge_artifact(
			module_path + ".brp",
			module_path,
			source,
			False,
		).program,
	)


private pure func accept_empty_view(
	scope: CompilerPreparedModuleScope,
) -> CompilerBoundModuleViewBinding:
	CompilerBoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(compiler_prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private pure func implementation_graph(source: String) -> Option[CompilerImplementationHeaderGraph]:
	implementation_graph_at("main", source)


private pure func implementation_graph_at(
	module_path: String,
	source: String,
) -> Option[CompilerImplementationHeaderGraph]:
	indexed ?= compiler_indexed_graph_build(
		module_load_candidate_at(module_path, source),
		[],
	).to_option()
	bound ?= compiler_bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= compiler_declaration_skeleton_graph_build(bound).to_option()
	aliases ?= compiler_type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= compiler_resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= compiler_type_header_graph_build(parameters).to_option()
	topology ?= compiler_trait_topology_graph_build(type_headers).to_option()
	callables ?= compiler_callable_header_graph_build(topology).to_option()
	compiler_implementation_header_graph_build(callables).to_option()


private pure func implementation_headers_are_exact_and_indexed() -> Option[Bool]:
	source: String =
		|trait Renderable:
		|	pure func render(value: Self) -> String
		|
		|record Box[T] {value: T}
		|
		|implements Renderable for Box[T]:
		|	pure func render(value: Box[T]) -> String:
		|		"box"
	graph ?= implementation_graph(source)
	foreign_graph ?= implementation_graph_at("other", source)
	header ?= compiler_implementation_header_graph_headers(graph).get(0)
	foreign_header ?= compiler_implementation_header_graph_headers(foreign_graph).get(0)
	parameter ?= compiler_implementation_header_parameters(header).get(0)
	method ?= compiler_implementation_header_methods(header).get(0)
	method_signature ?= compiler_explicit_implementation_method_signature(method)
	method_value ?= compiler_callable_signature_parameters(method_signature).get(0)
	candidate ?= compiler_implementation_header_graph_candidates(
		graph,
		compiler_implementation_header_trait_id(header),
		compiler_implementation_header_receiver_head(header),
	).get(0)

	Some(
		(
			compiler_implementation_header_graph_headers(graph).length() == 1
			and compiler_trait_id_name(
				compiler_implementation_header_trait_id(header),
			) == "Renderable"
			and compiler_implementation_header_receiver_head(header) == CompilerDeclaredReceiverHead
			and compiler_implementation_type_parameter_id_index(
				compiler_resolved_implementation_type_parameter_id(parameter),
			) == 0
			and compiler_impl_ids_equal(
				compiler_implementation_header_id(header),
				compiler_implementation_header_id(candidate),
			)
			and compiler_implementation_header_graph_candidates(
				graph,
				compiler_implementation_header_trait_id(foreign_header),
				compiler_implementation_header_receiver_head(header),
			).is_empty()
			and match compiler_implementation_header_receiver(header):
				CompilerDeclaredTypeShape(_, [CompilerImplementationTypeParameterShape(_)]):
					(
						compiler_implementation_header_method_ids(header).length() == 1
						and match compiler_callable_parameter_type(method_value):
							CompilerDeclaredTypeShape(_, [CompilerImplementationTypeParameterShape(_)]):
								True
							_:
								False
					)
				_:
					False
		),
	)


pure func test_implementation_headers_are_exact_and_indexed() -> Bool:
	implementation_headers_are_exact_and_indexed().get_or(False)


private pure func implementation_headers_reject_missing_required_method() -> Option[Bool]:
	source: String =
		|trait Renderable:
		|	pure func render(value: Self) -> String
		|
		|record Box {value: Int}
		|
		|implements Renderable for Box:
		|	pure func other(value: Box) -> String:
		|		"box"
	indexed ?= compiler_indexed_graph_build(module_load_candidate(source), []).to_option()
	bound ?= compiler_bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= compiler_declaration_skeleton_graph_build(bound).to_option()
	aliases ?= compiler_type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= compiler_resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= compiler_type_header_graph_build(parameters).to_option()
	topology ?= compiler_trait_topology_graph_build(type_headers).to_option()
	callables ?= compiler_callable_header_graph_build(topology).to_option()

	match compiler_implementation_header_graph_build(callables):
		Ok(_):
			Some(False)
		Err(errors):
			Some(
				errors.any(func(error):
					compiler_implementation_header_graph_error_message(
						error,
					) == "implementation of 'Renderable' is missing required method 'render'"
				),
			)


pure func test_implementation_headers_reject_missing_required_method() -> Bool:
	implementation_headers_reject_missing_required_method().get_or(False)


private pure func implementation_headers_reject_method_parameter_owner_collision() -> Option[Bool]:
	source: String =
		|trait Renderable:
		|	pure func render(value: Self) -> String
		|
		|record Box[T] {value: T}
		|
		|implements Renderable for Box[T]:
		|	pure func render[T](value: Box[T]) -> String:
		|		"box"
	indexed ?= compiler_indexed_graph_build(module_load_candidate(source), []).to_option()
	bound ?= compiler_bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= compiler_declaration_skeleton_graph_build(bound).to_option()
	aliases ?= compiler_type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= compiler_resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= compiler_type_header_graph_build(parameters).to_option()
	topology ?= compiler_trait_topology_graph_build(type_headers).to_option()
	callables ?= compiler_callable_header_graph_build(topology).to_option()

	match compiler_implementation_header_graph_build(callables):
		Ok(_):
			Some(False)
		Err(errors):
			Some(
				errors.any(func(error):
					compiler_implementation_header_graph_error_message(error) == (
						"implementation method 'render' redeclares implementation type parameter 'T'; "
						+ "remove it from the method's type parameter list because implementation "
						+ "parameters are already in scope"
					)
				),
			)


pure func test_implementation_headers_reject_method_parameter_owner_collision() -> Bool:
	implementation_headers_reject_method_parameter_owner_collision().get_or(False)


tests: TestSuite = {
	description = "Compiler implementation headers",
	tests = [
		(
			"resolve exact implementation headers and candidates",
			test_implementation_headers_are_exact_and_indexed,
		),
		(
			"reject missing required methods",
			test_implementation_headers_reject_missing_required_method,
		),
		(
			"reject method and implementation parameter owner collision",
			test_implementation_headers_reject_method_parameter_owner_collision,
		),
	]
}
