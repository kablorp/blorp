import:
	../src/stage_09_core/core_closure: convert_program
	../src/stage_09_core/core_json:
		CoreDecl(FunctionDecl, UnionDecl),
		CoreExpr(ClosureCreateExpr, LambdaExpr, VarExpr),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, UnionType),
		CoreUnionPayloadStorage(ErasedUnionPayloadStorage),
		CoreVar,
	test: TestSuite


pure func closure_type() -> CoreType:
	NamedType("Closure", [])


pure func resolved_var(name: String, def_id: Int) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = Some(def_id)
	}


pure func resolved_param(name: String, def_id: Int, typ: CoreType) -> CoreParam:
	{
		name = resolved_var(name, def_id),
		typ = typ,
		loc = SyntheticSourceLoc
	}


pure func constructor_reference_lambda_program(
	reference_name: String,
	reference_id: Int,
	params: List[CoreParam],
) -> CoreProgram:
	tree_type: CoreType = UnionType("Tree")
	make_lambda: CoreFunction = {
		name = "make_constructor_lambda",
		source_module = None,
		type_params = [],
		params = params,
		return_type = closure_type(),
		body = Some(
			LambdaExpr(
				[],
				tree_type,
				VarExpr(
					resolved_var(reference_name, reference_id),
					tree_type,
					SyntheticSourceLoc,
				),
				True,
				closure_type(),
				SyntheticSourceLoc,
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 60,
		loc = SyntheticSourceLoc
	}

	{
		decls = [
			UnionDecl({
				name = "Tree",
				type_params = [],
				payload_storage = ErasedUnionPayloadStorage,
				variants = [
					{
						name = "Leaf",
						c_name = "__def_41_Leaf",
						tag_c_name = "TAG_Tree_Leaf",
						tag = 0,
						fields = [],
						def_id = Some(41)
					},
				],
				loc = SyntheticSourceLoc,
			}),
			FunctionDecl(make_lambda),
		],
		foreign_includes = []
	}


pure func converted_capture_count(program: CoreProgram) -> Option[Int]:
	converted: CoreProgram = convert_program(program)
	var count: Option[Int] = None

	for decl in converted.decls:
		match decl:
			FunctionDecl(function):
				if function.name == "make_constructor_lambda":
					match function.body:
						Some(ClosureCreateExpr(closure, _, _)):
							count = Some(closure.captures.length())
						_:
							void
				else:
					void
			_:
				void

	count


pure func test_exact_constructor_reference_is_not_captured() -> Bool:
	converted_capture_count(constructor_reference_lambda_program("Leaf", 41, [])) == Some(0)


pure func test_projected_constructor_reference_is_not_captured() -> Bool:
	converted_capture_count(
		constructor_reference_lambda_program(
			"__def_41_Leaf",
			41,
			[],
		),
	) == Some(0)


pure func test_same_named_resolved_parameter_is_captured() -> Bool:
	tree_type: CoreType = UnionType("Tree")
	converted_capture_count(
		constructor_reference_lambda_program(
			"Leaf",
			999,
			[resolved_param("Leaf", 999, tree_type)],
		),
	) == Some(1)


pure func test_different_named_parameter_with_constructor_id_is_captured() -> Bool:
	tree_type: CoreType = UnionType("Tree")
	converted_capture_count(
		constructor_reference_lambda_program(
			"branch",
			41,
			[resolved_param("branch", 41, tree_type)],
		),
	) == Some(1)


tests: TestSuite = {
	description = "Core closure definition identity",
	tests = [
		(
			"exact constructor reference is not captured",
			test_exact_constructor_reference_is_not_captured,
		),
		(
			"projected constructor reference is not captured",
			test_projected_constructor_reference_is_not_captured,
		),
		(
			"same-named resolved parameter is captured",
			test_same_named_resolved_parameter_is_captured,
		),
		(
			"different-named parameter with constructor id is captured",
			test_different_named_parameter_with_constructor_id_is_captured,
		),
	]
}
