import:
	../src/stage_09_core/core_json:
		CoreAccessor(RootAccessor),
		CoreBinaryOp(AddOp),
		CoreBoxKind(PrimBox),
		CoreBoxedStorageValue,
		CoreCallKind(UserCall),
		CoreConcurrentlyLoopItemMode(ConcurrentlyLoopCopyItem),
		CoreConcurrentlyLoopOutput(ConcurrentlyLoopCollect),
		CoreConstructorMatchBody(ConstructorMatchBodyExpr),
		CoreConstructorMatchFallback(ConstructorMatchFallbackBody),
		CoreConstructorMatchTest(EnumConstructorTest),
		CoreDecl(FunctionDecl),
		CoreDictLiteralEntry,
		CoreExpr(
			BinaryExpr,
			BorrowLetExpr,
			CallExpr,
			ConstructorMatchExpr,
			DictExpr,
			LetExpr,
			ListConstructExpr,
			LiteralExpr,
			PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr,
			RecordExpr,
			ResourceScopeExpr,
			SelectExpr,
			SeqExpr,
			TensorLiteralExpr,
			TensorRawViewLetExpr,
			TupleExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreListStorageLayout(PointerListStorage),
		CoreLiteral(IntLiteral),
		CoreParam,
		CoreProgram,
		CoreRecordFieldValue,
		CoreReleasePolicy(NoReleasePolicy),
		CoreResourceScope,
		CoreSelectArmKind(SelectAfterArm),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreTensorLiteral,
		CoreTensorLiteralPayload(TensorRawLiteralPayload),
		CoreTensorLiteralShape(TensorVectorLength),
		CoreTensorRawLiteral,
		CoreTensorRawScalarKind(TensorInt64Elements),
		CoreType(NamedType, TupleType, VoidType),
		CoreVar,
	../src/stage_09_core/core_std_inline:
		first_uninlined_std_wrapper_call,
		inline_std_wrappers,
	../src/stage_09_core/core_traverse: immediate_core_expr_children
	test: TestSuite


private pure func int_type() -> CoreType:
	NamedType("Int", [])


private pure func list_type() -> CoreType:
	NamedType("List", [int_type()])


private pure func option_int_type() -> CoreType:
	NamedType("Option", [int_type()])


private pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


private pure func param(name: String, typ: CoreType) -> CoreParam:
	{
		name = core_var(name),
		typ = typ,
		loc = SyntheticSourceLoc
	}


private pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, SyntheticSourceLoc)


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), int_type(), SyntheticSourceLoc)


private pure func resolved_user_call(
	name: String,
	def_id: Int,
	args: List[CoreExpr],
	typ: CoreType,
) -> CoreExpr:
	CallExpr(
		UserCall(
			name,
			Some(def_id),
			[],
		),
		VarExpr(
			{
				name = name,
				uniq = 0,
				def_id = Some(def_id)
			},
			typ,
			SyntheticSourceLoc,
		),
		args,
		typ,
		SyntheticSourceLoc,
	)


private pure func unresolved_user_call(name: String, typ: CoreType) -> CoreExpr:
	CallExpr(
		UserCall(name, None, []),
		variable(name, typ),
		[],
		typ,
		SyntheticSourceLoc,
	)


private pure func function_decl(
	name: String,
	source_module: Option[String],
	def_id: Int,
	params: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = source_module,
		type_params = [],
		params = params,
		return_type = return_type,
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


private pure func target_get_or(body: CoreExpr) -> CoreDecl:
	function_decl(
		"std_list__get_or__mono_Int",
		Some("std/list"),
		10,
		[param("self", list_type()), param("index", int_type()), param("default", int_type())],
		int_type(),
		body,
	)


private pure func target_get() -> CoreDecl:
	function_decl(
		"std_list__get__mono_Int",
		Some("std/list"),
		14,
		[param("self", list_type()), param("index", int_type())],
		option_int_type(),
		variable(
			"None",
			option_int_type(),
		),
	)


private pure func target_append() -> CoreDecl:
	function_decl(
		"std_list__append__mono_Int",
		Some("std/list"),
		12,
		[param("self", list_type()), param("item", int_type())],
		list_type(),
		variable(
			"self",
			list_type(),
		),
	)


private pure func caller(
	name: String,
	def_id: Int,
	source_module: Option[String],
	body: CoreExpr,
) -> CoreDecl:
	function_decl(name, source_module, def_id, [], int_type(), body)


private pure func program(decls: List[CoreDecl]) -> CoreProgram:
	{
		decls = decls,
		foreign_includes = []
	}


private pure func function_body(program_value: CoreProgram, name: String) -> Option[CoreExpr]:
	var found: Option[CoreExpr] = None

	for decl in program_value.decls:
		match decl:
			FunctionDecl(function_info):
				if function_info.name == name:
					found = function_info.body
					break
				else:
					void
			_:
				void

	found


private pure func count_resolved_user_calls(expr: CoreExpr, name: String, def_id: Int) -> Int:
	var count: Int = match expr:
		CallExpr(UserCall(actual_name, Some(actual_id), _), _, _, _, _):
			if actual_id == def_id and actual_name == name:
				1
			else:
				0
		_:
			0

	for child in immediate_core_expr_children(expr):
		count += count_resolved_user_calls(child, name, def_id)

	count


private pure func count_unresolved_user_calls(expr: CoreExpr, name: String) -> Int:
	var count: Int = match expr:
		CallExpr(UserCall(actual_name, None, _), _, _, _, _):
			if actual_name == name:
				1
			else:
				0
		_:
			0

	for child in immediate_core_expr_children(expr):
		count += count_unresolved_user_calls(child, name)

	count


private pure func let_names(expr: CoreExpr) -> List[String]:
	var names: List[String] = match expr:
		LetExpr(variable, _, _, _, _):
			["${variable.name}_${variable.uniq}"]
		_:
			[]

	for child in immediate_core_expr_children(expr):
		names = names.concat(let_names(child))

	names


private pure func borrow_names(expr: CoreExpr) -> List[String]:
	var names: List[String] = match expr:
		BorrowLetExpr(variable, _, _, _):
			["${variable.name}_${variable.uniq}"]
		_:
			[]

	for child in immediate_core_expr_children(expr):
		names = names.concat(borrow_names(child))

	names


private pure func count_variable_names(expr: CoreExpr, name: String) -> Int:
	var count: Int = match expr:
		VarExpr(variable, _, _):
			if variable.name == name:
				1
			else:
				0
		_:
			0

	for child in immediate_core_expr_children(expr):
		count += count_variable_names(child, name)

	count


private pure func all_unique(items: List[String]) -> Bool:
	var seen: List[String] = []
	var unique: Bool = True

	for item in items:
		if seen.contains(item):
			unique = False
			break
		else:
			seen = seen.append(item)

	unique


pure func test_inlines_allowed_list_get_or() -> Bool:
	call: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[variable("xs", list_type()), int_literal(0), int_literal(99)],
		int_type(),
	)
	rewritten: CoreProgram = inline_std_wrappers(program([
		target_get_or(variable("default", int_type())),
		caller("use_get_or", 20, None, call),
	]))

	match function_body(rewritten, "use_get_or"):
		Some(body):
			(
				count_resolved_user_calls(body, "std_list__get_or__mono_Int", 10) == 0
				and borrow_names(body).any(pure func(name): name.starts_with("__std_inline_self"))
			)
		None:
			False


pure func test_inlines_allowed_list_get() -> Bool:
	call: CoreExpr = resolved_user_call(
		"std_list__get__mono_Int",
		14,
		[variable("xs", list_type()), int_literal(0)],
		option_int_type(),
	)
	rewritten: CoreProgram = inline_std_wrappers(
		program([target_get(), caller("use_get", 20, None, call)]),
	)

	match function_body(rewritten, "use_get"):
		Some(body):
			(
				count_resolved_user_calls(body, "std_list__get__mono_Int", 14) == 0
				and borrow_names(body).any(pure func(name): name.starts_with("__std_inline_self"))
			)
		None:
			False


pure func test_post_inline_invariant_detects_surviving_target() -> Bool:
	call: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[variable("xs", list_type()), int_literal(0), int_literal(99)],
		int_type(),
	)
	before: CoreProgram = program([
		target_get_or(variable("default", int_type())),
		caller("use_get_or", 20, None, call),
	])
	after: CoreProgram = inline_std_wrappers(before)

	(
		first_uninlined_std_wrapper_call(before).is_some()
		and first_uninlined_std_wrapper_call(after).is_none()
	)


pure func test_preserves_argument_single_evaluation() -> Bool:
	target_body: CoreExpr = BinaryExpr(
		AddOp,
		variable("default", int_type()),
		variable("default", int_type()),
		int_type(),
		SyntheticSourceLoc,
	)
	call: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[
			variable("xs", list_type()),
			int_literal(0),
			unresolved_user_call("side_effect", int_type()),
		],
		int_type(),
	)
	rewritten: CoreProgram = inline_std_wrappers(program([
		target_get_or(target_body),
		caller("single_eval", 20, None, call),
	]))

	match function_body(rewritten, "single_eval"):
		Some(body):
			(
				count_unresolved_user_calls(body, "side_effect") == 1
				and let_names(body).any(pure func(name): name.starts_with("__std_inline_default"))
			)
		None:
			False


pure func test_clones_call_arguments_hygienically() -> Bool:
	target_body: CoreExpr = CallExpr(
		UserCall(
			"combine",
			None,
			[],
		),
		variable(
			"combine",
			int_type(),
		),
		[
			variable("self", list_type()),
			variable("index", int_type()),
			variable("default", int_type()),
		],
		int_type(),
		SyntheticSourceLoc,
	)
	call: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[variable("xs", list_type()), int_literal(0), int_literal(99)],
		int_type(),
	)
	rewritten: CoreProgram = inline_std_wrappers(program([
		target_get_or(target_body),
		caller("clone_call_args", 20, None, call),
	]))

	match function_body(rewritten, "clone_call_args"):
		Some(body):
			(
				count_variable_names(body, "self") == 0
				and count_variable_names(body, "index") == 0
				and count_variable_names(body, "default") == 0
			)
		None:
			False


pure func test_alpha_renames_repeated_inline_sites() -> Bool:
	local: CoreVar = core_var("tmp")
	target_body: CoreExpr = LetExpr(
		local,
		False,
		int_type(),
		variable("default", int_type()),
		VarExpr(local, int_type(), SyntheticSourceLoc),
	)
	first: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[variable("xs", list_type()), int_literal(0), int_literal(1)],
		int_type(),
	)
	second: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[variable("xs", list_type()), int_literal(1), int_literal(2)],
		int_type(),
	)
	rewritten: CoreProgram = inline_std_wrappers(program([
		target_get_or(target_body),
		caller(
			"twice",
			20,
			None,
			SeqExpr(first, second),
		),
	]))

	match function_body(rewritten, "twice"):
		Some(body):
			names: List[String] = let_names(body)
			names.length() >= 6 and all_unique(names)
		None:
			False


pure func test_threads_fresh_names_across_tuple_items() -> Bool:
	target_body: CoreExpr = LetExpr(
		core_var("tmp"),
		False,
		int_type(),
		variable("default", int_type()),
		variable("tmp", int_type()),
	)
	first: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[variable("xs", list_type()), int_literal(0), int_literal(1)],
		int_type(),
	)
	second: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[variable("xs", list_type()), int_literal(1), int_literal(2)],
		int_type(),
	)
	tuple_type: CoreType = TupleType([int_type(), int_type()])
	rewritten: CoreProgram = inline_std_wrappers(program([
		target_get_or(target_body),
		function_decl(
			"tuple_calls",
			None,
			20,
			[],
			tuple_type,
			TupleExpr(
				[first, second],
				tuple_type,
				SyntheticSourceLoc,
			),
		),
	]))

	match function_body(rewritten, "tuple_calls"):
		Some(body):
			names: List[String] = let_names(body)
			names.length() >= 6 and all_unique(names)
		None:
			False


pure func test_rewrites_calls_inside_list_literal() -> Bool:
	first: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[variable("xs", list_type()), int_literal(0), int_literal(1)],
		int_type(),
	)
	second: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[variable("xs", list_type()), int_literal(1), int_literal(2)],
		int_type(),
	)
	elements: List[CoreBoxedStorageValue] = [
		{
			kind = PrimBox,
			value = first,
			needs_release = False,
			transfers_ownership = False
		},
		{
			kind = PrimBox,
			value = second,
			needs_release = False,
			transfers_ownership = False
		},
	]
	rewritten: CoreProgram = inline_std_wrappers(program([
		target_get_or(variable("default", int_type())),
		function_decl(
			"list_calls",
			None,
			20,
			[],
			list_type(),
			ListConstructExpr(
				{
					layout = PointerListStorage,
					elements = elements,
					elem_needs_release = False
				},
				list_type(),
				SyntheticSourceLoc,
			),
		),
	]))

	match function_body(rewritten, "list_calls"):
		Some(body):
			names: List[String] = let_names(body)

			(
				count_resolved_user_calls(body, "std_list__get_or__mono_Int", 10) == 0
				and names.length() >= 4
				and all_unique(names)
			)
		None:
			False


pure func test_rewrites_calls_inside_source_aggregates() -> Bool:
	first: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[variable("xs", list_type()), int_literal(0), int_literal(1)],
		int_type(),
	)
	second: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[variable("xs", list_type()), int_literal(1), int_literal(2)],
		int_type(),
	)
	calls: List[CoreExpr] = [first, second]
	dict_entries: List[CoreDictLiteralEntry] = [
		{
			key = int_literal(0),
			value = first
		},
		{
			key = int_literal(1),
			value = second
		},
	]
	record_fields: List[CoreRecordFieldValue] = [
		{
			name = "first",
			value = first
		},
		{
			name = "second",
			value = second
		},
	]
	tensor_literal: CoreTensorLiteral = {
		shape = TensorVectorLength(2),
		payload = TensorRawLiteralPayload({
			raw_kind = TensorInt64Elements,
			elements = calls,
		})
	}
	dict_type: CoreType = NamedType(
		"Dict",
		[int_type(), int_type()],
	)
	record_type: CoreType = NamedType("Pair", [])
	tensor_type: CoreType = NamedType("Tensor", [int_type()])
	aggregate_type: CoreType = TupleType([dict_type, record_type, tensor_type])
	aggregate: CoreExpr = TupleExpr(
		[
			DictExpr(dict_entries, dict_type, SyntheticSourceLoc),
			RecordExpr(record_fields, record_type, SyntheticSourceLoc),
			TensorLiteralExpr(tensor_literal, tensor_type, SyntheticSourceLoc),
		],
		aggregate_type,
		SyntheticSourceLoc,
	)
	rewritten: CoreProgram = inline_std_wrappers(program([
		target_get_or(variable("default", int_type())),
		function_decl("aggregate_calls", None, 20, [], aggregate_type, aggregate),
	]))

	match function_body(rewritten, "aggregate_calls"):
		Some(body):
			names: List[String] = let_names(body)

			(
				count_resolved_user_calls(body, "std_list__get_or__mono_Int", 10) == 0
				and names.length() >= 12
				and all_unique(names)
			)
		None:
			False


pure func test_rewrites_calls_inside_boundary_containers() -> Bool:
	first: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[variable("xs", list_type()), int_literal(0), int_literal(1)],
		int_type(),
	)
	second: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[variable("xs", list_type()), int_literal(1), int_literal(2)],
		int_type(),
	)
	concurrently_loop: CoreExpr = PreClosureConcurrentlyLoopExpr(
		{
			variable = core_var("item"),
			item_type = int_type(),
			item_mode = ConcurrentlyLoopCopyItem,
			iterable = first,
			body = second,
			timeout = Some(first),
			limit = second,
			output = ConcurrentlyLoopCollect
		},
		int_type(),
		SyntheticSourceLoc,
	)
	concurrent_block: CoreExpr = PreClosureConcurrentExpr(
		{
			bindings = [
				{
					variable = core_var("result"),
					typ = int_type(),
					rhs = first
				},
			],
			body = second,
			timeout = Some(first),
			max_threads = None
		},
		int_type(),
		SyntheticSourceLoc,
	)
	select_expr: CoreExpr = SelectExpr(
		[
			{
				kind = SelectAfterArm(first),
				body = second,
				loc = SyntheticSourceLoc
			},
		],
		int_type(),
		SyntheticSourceLoc,
	)
	raw_view: CoreExpr = TensorRawViewLetExpr(
		{
			variable = core_var("view"),
			kind = TensorInt64Elements,
			source = first
		},
		second,
		int_type(),
		SyntheticSourceLoc,
	)
	constructor_match: CoreExpr = ConstructorMatchExpr(
		variable(
			"tag",
			int_type(),
		),
		NoReleasePolicy,
		[
			{
				constructor = "Value",
				accessor = RootAccessor,
				test = EnumConstructorTest("TAG_Value"),
				bindings = [],
				body = ConstructorMatchBodyExpr(first)
			},
		],
		ConstructorMatchFallbackBody(second),
		int_type(),
		SyntheticSourceLoc,
	)
	container_type: CoreType = TupleType([
		int_type(),
		int_type(),
		int_type(),
		int_type(),
		int_type(),
	])
	container: CoreExpr = TupleExpr(
		[concurrently_loop, concurrent_block, select_expr, raw_view, constructor_match],
		container_type,
		SyntheticSourceLoc,
	)
	rewritten: CoreProgram = inline_std_wrappers(program([
		target_get_or(variable("default", int_type())),
		function_decl("boundary_containers", None, 20, [], container_type, container),
	]))

	match function_body(rewritten, "boundary_containers"):
		Some(body):
			names: List[String] = let_names(body)

			(
				count_resolved_user_calls(body, "std_list__get_or__mono_Int", 10) == 0
				and all_unique(names)
			)
		None:
			False


pure func test_does_not_inline_inside_compiler_owned_module() -> Bool:
	call: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[variable("xs", list_type()), int_literal(0), int_literal(99)],
		int_type(),
	)
	rewritten: CoreProgram = inline_std_wrappers(program([
		target_get_or(variable("default", int_type())),
		caller("std_list__wrapper__mono_Int", 11, Some("std/list"), call),
	]))

	match function_body(rewritten, "std_list__wrapper__mono_Int"):
		Some(body):
			count_resolved_user_calls(body, "std_list__get_or__mono_Int", 10) == 1
		None:
			False


pure func test_append_substitutes_variable_receiver() -> Bool:
	call: CoreExpr = resolved_user_call(
		"std_list__append__mono_Int",
		12,
		[variable("xs", list_type()), int_literal(4)],
		list_type(),
	)
	rewritten: CoreProgram = inline_std_wrappers(program([
		target_append(),
		function_decl("append_one", None, 20, [], list_type(), call),
	]))

	match function_body(rewritten, "append_one"):
		Some(body):
			(
				count_resolved_user_calls(body, "std_list__append__mono_Int", 12) == 0
				and not let_names(body).any(pure func(name): name.starts_with("__std_inline_self"))
				and not borrow_names(
					body,
				).any(
					pure func(name): name.starts_with("__std_inline_self"),
				)
			)
		None:
			False


pure func test_requires_matching_name_and_definition_id() -> Bool:
	call: CoreExpr = resolved_user_call(
		"PrivateImplMethodSurfaceSource",
		12,
		[int_literal(1), int_literal(2)],
		int_type(),
	)
	rewritten: CoreProgram = inline_std_wrappers(
		program([target_append(), caller("unrelated", 20, None, call)]),
	)

	match function_body(rewritten, "unrelated"):
		Some(body):
			count_resolved_user_calls(body, "PrivateImplMethodSurfaceSource", 12) == 1
		None:
			False


pure func test_same_definition_id_caller_still_rewrites_body() -> Bool:
	call: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[variable("xs", list_type()), int_literal(0), int_literal(99)],
		int_type(),
	)
	rewritten: CoreProgram = inline_std_wrappers(program([
		target_get_or(variable("default", int_type())),
		caller("unrelated_same_id", 10, None, call),
	]))

	match function_body(rewritten, "unrelated_same_id"):
		Some(body):
			count_resolved_user_calls(body, "std_list__get_or__mono_Int", 10) == 0
		None:
			False


pure func test_clones_resource_scope_hygienically() -> Bool:
	scope: CoreResourceScope = {
		variable = core_var("default"),
		typ = int_type(),
		acquire = variable("default", int_type()),
		body = variable("default", int_type()),
		cleanup = variable("default", int_type())
	}
	call: CoreExpr = resolved_user_call(
		"std_list__get_or__mono_Int",
		10,
		[variable("xs", list_type()), int_literal(0), int_literal(99)],
		int_type(),
	)
	rewritten: CoreProgram = inline_std_wrappers(program([
		target_get_or(ResourceScopeExpr(scope, int_type(), SyntheticSourceLoc)),
		caller("resource_scope", 20, None, call),
	]))

	match function_body(rewritten, "resource_scope"):
		Some(BorrowLetExpr(_, _, _, LetExpr(_, _, _, _, LetExpr(argument, _, _, _, ResourceScopeExpr(rewritten_scope, _, _))))):
			match (rewritten_scope.acquire, rewritten_scope.body, rewritten_scope.cleanup):
				(VarExpr(acquire, _, _), VarExpr(body_var, _, _), VarExpr(cleanup_var, _, _)):
					(
						rewritten_scope.variable.name.starts_with("__std_inline_default")
						and acquire.name == argument.name
						and acquire.uniq == argument.uniq
						and body_var.name == rewritten_scope.variable.name
						and body_var.uniq == rewritten_scope.variable.uniq
						and cleanup_var.name == rewritten_scope.variable.name
						and cleanup_var.uniq == rewritten_scope.variable.uniq
						and (body_var.name != argument.name or body_var.uniq != argument.uniq)
					)
				_:
					False
		_:
			False


tests: TestSuite = {
	description = "Blorp compiler std wrapper inlining",
	tests = [
		("inlines allowed list get_or", test_inlines_allowed_list_get_or),
		("inlines allowed list get", test_inlines_allowed_list_get),
		(
			"post-inline invariant detects surviving target",
			test_post_inline_invariant_detects_surviving_target,
		),
		("preserves argument single evaluation", test_preserves_argument_single_evaluation),
		("clones call arguments hygienically", test_clones_call_arguments_hygienically),
		("alpha-renames repeated inline sites", test_alpha_renames_repeated_inline_sites),
		("threads fresh names across tuple items", test_threads_fresh_names_across_tuple_items),
		("rewrites calls inside list literals", test_rewrites_calls_inside_list_literal),
		("rewrites calls inside source aggregates", test_rewrites_calls_inside_source_aggregates),
		(
			"rewrites calls inside boundary containers",
			test_rewrites_calls_inside_boundary_containers,
		),
		(
			"does not inline inside compiler-owned modules",
			test_does_not_inline_inside_compiler_owned_module,
		),
		("append substitutes variable receiver", test_append_substitutes_variable_receiver),
		("requires matching name and definition id", test_requires_matching_name_and_definition_id),
		(
			"same definition id caller still rewrites",
			test_same_definition_id_caller_still_rewrites_body,
		),
		("clones resource scope hygienically", test_clones_resource_scope_hygienically),
	]
}
