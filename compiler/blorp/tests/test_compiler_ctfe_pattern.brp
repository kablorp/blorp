import:
	../src/stage_01_file_io/source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_03_parse/parsed_ast:
		ParsedIdentifier,
		ParsedListPatternSpread(ParsedListSpreadName),
		parsed_identifier,
	../src/stage_05_types/semantic_type: SemanticType(SemanticNamedType), type_int, type_list
	../src/stage_06_typecheck/infer:
		TypedPattern(
			TypedConstructorPattern,
			TypedIntPattern,
			TypedListPattern,
			TypedNamePattern,
			TypedOrPattern,
			TypedTuplePattern,
			TypedWildcardPattern,
		),
	../src/stage_07_ctfe/ctfe_context: CtfeContext, ctfe_context_empty
	../src/stage_07_ctfe/ctfe_pattern: ctfe_pattern_bind
	../src/stage_07_ctfe/ctfe_value:
		CtfeValue,
		CtfeValueDesc(CtfeConstructorValue, CtfeListValue, CtfeTupleValue),
		ctfe_constructor_info,
		ctfe_int,
		ctfe_value,
		ctfe_values_equal,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("ctfe_pattern.brp", "ctfe_pattern", "VALUE = 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func option_int_type() -> SemanticType:
	SemanticNamedType("Option", [type_int()])


pure func constructor_context() -> CtfeContext:
	{
		functions = [],
		imported_functions = [],
		constructors = [
			("None", ctfe_constructor_info("Option", 0, None)),
			("Some", ctfe_constructor_info("Option", 1, None)),
		],
		module_aliases = [],
		module_global_envs = [],
		active_module_path = None
	}


pure func int_value(value: Int) -> CtfeValue:
	ctfe_int(source_span(), value)


pure func list_value(values: List[CtfeValue]) -> CtfeValue:
	ctfe_value(type_list(type_int()), CtfeListValue(values), source_span())


pure func tuple_value(values: List[CtfeValue]) -> CtfeValue:
	ctfe_value(
		SemanticNamedType(
			"Tuple",
			[type_int(), type_int()],
		),
		CtfeTupleValue(values),
		source_span(),
	)


pure func constructor_value(name: String, args: List[CtfeValue]) -> CtfeValue:
	ctfe_value(option_int_type(), CtfeConstructorValue({
			name = name,
			args = args,
			constructor_info = ctfe_constructor_info("Option", args.length(), None),
		}), source_span())


pure func binding_value(bindings: List[(String, CtfeValue)], name: String) -> Option[CtfeValue]:
	var result: Option[CtfeValue] = None

	for (binding_name, value) in bindings:
		if result.is_none() and binding_name == name:
			result = Some(value)
			break

	result


pure func binding_matches(
	bindings: List[(String, CtfeValue)],
	name: String,
	expected: CtfeValue,
) -> Bool:
	match binding_value(bindings, name):
		Some(value):
			ctfe_values_equal(value, expected)
		None:
			False


func test_binds_wildcard_name_and_literal_patterns() -> Bool:
	value = int_value(7)
	wildcard = ctfe_pattern_bind(ctfe_context_empty(), TypedWildcardPattern(source_span()), value)
	name = ctfe_pattern_bind(
		ctfe_context_empty(),
		TypedNamePattern(ident("value"), type_int()),
		value,
	)
	literal = ctfe_pattern_bind(
		ctfe_context_empty(),
		TypedIntPattern("7", source_span()),
		value,
	)

	var wildcard_ok: Bool = False

	match wildcard:
		Ok(Some(bindings)):
			wildcard_ok = bindings.length() == 0
		_:
			void

	var name_ok: Bool = False

	match name:
		Ok(Some(bindings)):
			name_ok = binding_matches(bindings, "value", value)
		_:
			void

	var literal_ok: Bool = False

	match literal:
		Ok(Some(bindings)):
			literal_ok = bindings.length() == 0
		_:
			void

	wildcard_ok and name_ok and literal_ok


func test_binds_tuple_list_and_spread_patterns() -> Bool:
	tuple_result = ctfe_pattern_bind(
		ctfe_context_empty(),
		TypedTuplePattern(
			[TypedNamePattern(ident("left"), type_int()), TypedIntPattern("2", source_span())],
			source_span(),
		),
		tuple_value([int_value(1), int_value(2)]),
	)
	list_result = ctfe_pattern_bind(
		ctfe_context_empty(),
		TypedListPattern(
			[TypedNamePattern(ident("head"), type_int())],
			Some(ParsedListSpreadName(ident("tail"))),
			source_span(),
		),
		list_value([int_value(1), int_value(2), int_value(3)]),
	)

	var tuple_ok: Bool = False

	match tuple_result:
		Ok(Some(bindings)):
			tuple_ok = binding_matches(bindings, "left", int_value(1))
		_:
			void

	var list_ok: Bool = False

	match list_result:
		Ok(Some(bindings)):
			match binding_value(bindings, "tail"):
				Some(value):
					match value.desc:
						CtfeListValue(values):
							list_ok = (
								binding_matches(bindings, "head", int_value(1))
								and values.length() == 2
								and ctfe_values_equal(
									values.get_or(0, int_value(0)),
									int_value(2),
								)
							)
						_:
							void
				None:
					void
		_:
			void

	tuple_ok and list_ok


func test_matches_constructor_and_or_patterns() -> Bool:
	some_value = constructor_value("Some", [int_value(42)])
	none_value = constructor_value("None", [])
	constructor_result = ctfe_pattern_bind(
		constructor_context(),
		TypedConstructorPattern(
			ident("Some"),
			[TypedNamePattern(ident("value"), type_int())],
			source_span(),
		),
		some_value,
	)
	nullary_name_result = ctfe_pattern_bind(
		constructor_context(),
		TypedNamePattern(ident("None"), option_int_type()),
		none_value,
	)
	or_result = ctfe_pattern_bind(
		constructor_context(),
		TypedOrPattern(
			[
				TypedConstructorPattern(ident("None"), [], source_span()),
				TypedConstructorPattern(
					ident("Some"),
					[TypedNamePattern(ident("value"), type_int())],
					source_span(),
				),
			],
			source_span(),
		),
		some_value,
	)

	var constructor_ok: Bool = False

	match constructor_result:
		Ok(Some(bindings)):
			constructor_ok = binding_matches(bindings, "value", int_value(42))
		_:
			void

	var nullary_name_ok: Bool = False

	match nullary_name_result:
		Ok(Some(bindings)):
			nullary_name_ok = bindings.length() == 0
		_:
			void

	var or_ok: Bool = False

	match or_result:
		Ok(Some(bindings)):
			or_ok = binding_matches(bindings, "value", int_value(42))
		_:
			void

	constructor_ok and nullary_name_ok and or_ok


tests: TestSuite = {
	description = "Compiler CTFE pattern",
	tests = [
		("binds wildcard name and literal patterns", test_binds_wildcard_name_and_literal_patterns),
		("binds tuple list and spread patterns", test_binds_tuple_list_and_spread_patterns),
		("matches constructor and or patterns", test_matches_constructor_and_or_patterns),
	]
}
