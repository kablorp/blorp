import:
	../src/stage_01_file_io/compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_03_parse/compiler_parsed_ast:
		ParsedIdentifier,
		ParsedListPatternSpread(ParsedListSpreadName),
		parsed_identifier,
	../src/stage_05_types/compiler_type: SemanticType(SemanticNamedType), type_int, type_list
	../src/stage_06_typecheck/compiler_infer:
		CompilerTypedPattern(
			CompilerTypedConstructorPattern,
			CompilerTypedIntPattern,
			CompilerTypedListPattern,
			CompilerTypedNamePattern,
			CompilerTypedOrPattern,
			CompilerTypedTuplePattern,
			CompilerTypedWildcardPattern,
		),
	../src/stage_07_ctfe/compiler_ctfe_context: CompilerCtfeContext, compiler_ctfe_context_empty
	../src/stage_07_ctfe/compiler_ctfe_pattern: compiler_ctfe_pattern_bind
	../src/stage_07_ctfe/compiler_ctfe_value:
		CompilerCtfeValue,
		CompilerCtfeValueDesc(
			CompilerCtfeConstructorValue,
			CompilerCtfeListValue,
			CompilerCtfeTupleValue,
		),
		compiler_ctfe_constructor_info,
		compiler_ctfe_int,
		compiler_ctfe_value,
		compiler_ctfe_values_equal,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("ctfe_pattern.brp", "ctfe_pattern", "VALUE = 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func option_int_type() -> SemanticType:
	SemanticNamedType("Option", [type_int()])


pure func constructor_context() -> CompilerCtfeContext:
	{
		functions = [],
		imported_functions = [],
		constructors = [
			("None", compiler_ctfe_constructor_info("Option", 0, None)),
			("Some", compiler_ctfe_constructor_info("Option", 1, None)),
		],
		module_aliases = [],
		module_global_envs = [],
		active_module_path = None
	}


pure func int_value(value: Int) -> CompilerCtfeValue:
	compiler_ctfe_int(source_span(), value)


pure func list_value(values: List[CompilerCtfeValue]) -> CompilerCtfeValue:
	compiler_ctfe_value(type_list(type_int()), CompilerCtfeListValue(values), source_span())


pure func tuple_value(values: List[CompilerCtfeValue]) -> CompilerCtfeValue:
	compiler_ctfe_value(
		SemanticNamedType(
			"Tuple",
			[type_int(), type_int()],
		),
		CompilerCtfeTupleValue(values),
		source_span(),
	)


pure func constructor_value(name: String, args: List[CompilerCtfeValue]) -> CompilerCtfeValue:
	compiler_ctfe_value(option_int_type(), CompilerCtfeConstructorValue({
			name = name,
			args = args,
			constructor_info = compiler_ctfe_constructor_info("Option", args.length(), None),
		}), source_span())


pure func binding_value(
	bindings: List[(String, CompilerCtfeValue)],
	name: String,
) -> Option[CompilerCtfeValue]:
	var result: Option[CompilerCtfeValue] = None

	for (binding_name, value) in bindings:
		if result.is_none() and binding_name == name:
			result = Some(value)
			break

	result


pure func binding_matches(
	bindings: List[(String, CompilerCtfeValue)],
	name: String,
	expected: CompilerCtfeValue,
) -> Bool:
	match binding_value(bindings, name):
		Some(value):
			compiler_ctfe_values_equal(value, expected)
		None:
			False


func test_binds_wildcard_name_and_literal_patterns() -> Bool:
	value = int_value(7)
	wildcard = compiler_ctfe_pattern_bind(
		compiler_ctfe_context_empty(),
		CompilerTypedWildcardPattern(source_span()),
		value,
	)
	name = compiler_ctfe_pattern_bind(
		compiler_ctfe_context_empty(),
		CompilerTypedNamePattern(ident("value"), type_int()),
		value,
	)
	literal = compiler_ctfe_pattern_bind(
		compiler_ctfe_context_empty(),
		CompilerTypedIntPattern("7", source_span()),
		value,
	)

	var wildcard_ok: Bool = False

	match wildcard:
		Ok(Some(bindings)):
			wildcard_ok = bindings.length() == 0
		_:
			void

	var name_ok: Bool = False

	match name:
		Ok(Some(bindings)):
			name_ok = binding_matches(bindings, "value", value)
		_:
			void

	var literal_ok: Bool = False

	match literal:
		Ok(Some(bindings)):
			literal_ok = bindings.length() == 0
		_:
			void

	wildcard_ok and name_ok and literal_ok


func test_binds_tuple_list_and_spread_patterns() -> Bool:
	tuple_result = compiler_ctfe_pattern_bind(
		compiler_ctfe_context_empty(),
		CompilerTypedTuplePattern(
			[
				CompilerTypedNamePattern(ident("left"), type_int()),
				CompilerTypedIntPattern("2", source_span()),
			],
			source_span(),
		),
		tuple_value([int_value(1), int_value(2)]),
	)
	list_result = compiler_ctfe_pattern_bind(
		compiler_ctfe_context_empty(),
		CompilerTypedListPattern(
			[CompilerTypedNamePattern(ident("head"), type_int())],
			Some(ParsedListSpreadName(ident("tail"))),
			source_span(),
		),
		list_value([int_value(1), int_value(2), int_value(3)]),
	)

	var tuple_ok: Bool = False

	match tuple_result:
		Ok(Some(bindings)):
			tuple_ok = binding_matches(bindings, "left", int_value(1))
		_:
			void

	var list_ok: Bool = False

	match list_result:
		Ok(Some(bindings)):
			match binding_value(bindings, "tail"):
				Some(value):
					match value.desc:
						CompilerCtfeListValue(values):
							list_ok = (
								binding_matches(bindings, "head", int_value(1))
								and values.length() == 2
								and compiler_ctfe_values_equal(
									values.get_or(0, int_value(0)),
									int_value(2),
								)
							)
						_:
							void
				None:
					void
		_:
			void

	tuple_ok and list_ok


func test_matches_constructor_and_or_patterns() -> Bool:
	some_value = constructor_value("Some", [int_value(42)])
	none_value = constructor_value("None", [])
	constructor_result = compiler_ctfe_pattern_bind(
		constructor_context(),
		CompilerTypedConstructorPattern(
			ident("Some"),
			[CompilerTypedNamePattern(ident("value"), type_int())],
			source_span(),
		),
		some_value,
	)
	nullary_name_result = compiler_ctfe_pattern_bind(
		constructor_context(),
		CompilerTypedNamePattern(ident("None"), option_int_type()),
		none_value,
	)
	or_result = compiler_ctfe_pattern_bind(
		constructor_context(),
		CompilerTypedOrPattern(
			[
				CompilerTypedConstructorPattern(ident("None"), [], source_span()),
				CompilerTypedConstructorPattern(
					ident("Some"),
					[CompilerTypedNamePattern(ident("value"), type_int())],
					source_span(),
				),
			],
			source_span(),
		),
		some_value,
	)

	var constructor_ok: Bool = False

	match constructor_result:
		Ok(Some(bindings)):
			constructor_ok = binding_matches(bindings, "value", int_value(42))
		_:
			void

	var nullary_name_ok: Bool = False

	match nullary_name_result:
		Ok(Some(bindings)):
			nullary_name_ok = bindings.length() == 0
		_:
			void

	var or_ok: Bool = False

	match or_result:
		Ok(Some(bindings)):
			or_ok = binding_matches(bindings, "value", int_value(42))
		_:
			void

	constructor_ok and nullary_name_ok and or_ok


tests: TestSuite = {
	description = "Compiler CTFE pattern",
	tests = [
		("binds wildcard name and literal patterns", test_binds_wildcard_name_and_literal_patterns),
		("binds tuple list and spread patterns", test_binds_tuple_list_and_spread_patterns),
		("matches constructor and or patterns", test_matches_constructor_and_or_patterns),
	]
}
