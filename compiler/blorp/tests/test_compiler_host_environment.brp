import:
	../src/stage_12_cli/compiler_host_c:
		HostCCompilerFamily(HostOtherCompiler),
		HostTlsBackend(HostTlsOpenSsl, HostTlsUnsupported),
	../src/stage_12_cli/compiler_host_environment:
		CompilerHostEnvironmentInput,
		CompilerHostEnvironmentProbe,
		discover_compiler_host_environment,
	../src/stage_12_cli/compiler_platform: HostToolchainProbe
	test: TestSuite
	units: mebibytes, seconds


private func test_environment_discovery_keeps_configuration_structured() -> Bool:
	toolchain: HostToolchainProbe = {
		compiler = {
			program = "cc",
			prefix_arguments = [],
			family = HostOtherCompiler
		},
		uname_program = "uname",
		timeout = Some(seconds(10)),
		capture_limit = mebibytes(4)
	}
	environment_input: CompilerHostEnvironmentInput = {
		tls_backend = Some("openssl"),
		openssl_compile_arguments = Some("-I'/ssl include' -DSSL=1"),
		openssl_link_arguments = Some("-L'/ssl lib' -lssl -lcrypto"),
		runtime_cache_root = Some("/cache root"),
		xdg_cache_home = None,
		home = None,
		temporary_root = "/tmp",
		raylib_prefix = Some("/raylib root"),
		discover_raylib_prefix = True
	}
	probe: CompilerHostEnvironmentProbe = {
		input = environment_input,
		toolchain = toolchain,
		pkg_config_program = "missing-pkg-config-is-not-needed",
		brew_program = "missing-brew-is-not-needed"
	}

	match discover_compiler_host_environment(probe):
		Err(_):
			False
		Ok(environment):
			(
				environment.cache_root == "/cache root"
				and environment.raylib_prefix == Some("/raylib root")
				and environment.tls.backend == HostTlsOpenSsl
				and environment.tls.runtime_arguments == [
					"-DBLORP_TLS_BACKEND_PROFILE_OPENSSL=1",
					"-I/ssl include",
					"-DSSL=1",
				]
				and environment.tls.link_arguments == ["-L/ssl lib", "-lssl", "-lcrypto"]
			)


private func test_unsupported_tls_does_not_probe_pkg_config() -> Bool:
	toolchain: HostToolchainProbe = {
		compiler = {
			program = "cc",
			prefix_arguments = [],
			family = HostOtherCompiler
		},
		uname_program = "uname",
		timeout = Some(seconds(10)),
		capture_limit = mebibytes(4)
	}
	environment_input: CompilerHostEnvironmentInput = {
		tls_backend = None,
		openssl_compile_arguments = None,
		openssl_link_arguments = None,
		runtime_cache_root = None,
		xdg_cache_home = Some("/xdg"),
		home = Some("/home"),
		temporary_root = "/tmp",
		raylib_prefix = None,
		discover_raylib_prefix = False
	}
	probe: CompilerHostEnvironmentProbe = {
		input = environment_input,
		toolchain = toolchain,
		pkg_config_program = "missing-pkg-config",
		brew_program = "missing-brew"
	}

	match discover_compiler_host_environment(probe):
		Ok(environment):
			(
				environment.cache_root == "/xdg/blorp/cas"
				and environment.tls.backend == HostTlsUnsupported
				and environment.tls.runtime_arguments.length() == 0
				and environment.tls.link_arguments.length() == 0
			)
		Err(_):
			False


tests: TestSuite = {
	description = "Blorp compiler host environment",
	tests = [
		(
			"environment discovery keeps configuration structured",
			test_environment_discovery_keeps_configuration_structured,
		),
		(
			"unsupported TLS does not probe pkg-config",
			test_unsupported_tls_does_not_probe_pkg_config,
		),
	]
}
