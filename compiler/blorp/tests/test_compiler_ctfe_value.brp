import:
	../src/stage_07_ctfe/compiler_ctfe_value:
		CompilerCtfeConstructorPayload,
		CompilerCtfeError(CompilerCtfeExpectedValue, CompilerCtfeUnsupported),
		CompilerCtfeValue,
		CompilerCtfeValueDesc(
			CompilerCtfeBoolValue,
			CompilerCtfeConstructorValue,
			CompilerCtfeDictValue,
			CompilerCtfeFloatValue,
			CompilerCtfeListValue,
			CompilerCtfeRecordValue,
			CompilerCtfeStringValue,
			CompilerCtfeTupleValue,
		),
		compiler_ctfe_bool,
		compiler_ctfe_constructor_info,
		compiler_ctfe_error_message,
		compiler_ctfe_eval_binary,
		compiler_ctfe_eval_unary,
		compiler_ctfe_float,
		compiler_ctfe_int,
		compiler_ctfe_string,
		compiler_ctfe_value,
		compiler_ctfe_values_equal,
	../src/stage_03_parse/compiler_parsed_ast:
		ParsedBinaryOp(
			ParsedAddOp,
			ParsedDivideOp,
			ParsedEqualOp,
			ParsedGreaterOp,
			ParsedModuloOp,
			ParsedNotEqualOp,
		),
		ParsedUnaryOp(ParsedNegateOp, ParsedNotOp),
	../src/stage_01_file_io/compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_05_types/compiler_type:
		CompilerType(CompilerNamedType, CompilerTupleType),
		compiler_type_int,
		compiler_type_list,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("ctfe_value.brp", "ctfe_value", "func main(): 0")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func int_value(value: Int) -> CompilerCtfeValue:
	compiler_ctfe_int(source_span(), value)


pure func float_value(value: Float) -> CompilerCtfeValue:
	compiler_ctfe_float(source_span(), value)


pure func sized_float_value(type_name: String, value: Float) -> CompilerCtfeValue:
	compiler_ctfe_value(
		CompilerNamedType(type_name, []),
		CompilerCtfeFloatValue(value),
		source_span(),
	)


pure func string_value(value: String) -> CompilerCtfeValue:
	compiler_ctfe_string(source_span(), value)


pure func bool_value(value: Bool) -> CompilerCtfeValue:
	compiler_ctfe_bool(source_span(), value)


pure func result_value_equal(
	result: Result[CompilerCtfeValue, CompilerCtfeError],
	expected: CompilerCtfeValue,
) -> Bool:
	match result:
		Ok(value):
			compiler_ctfe_values_equal(value, expected)
		Err(_):
			False


pure func result_is_unsupported(
	result: Result[CompilerCtfeValue, CompilerCtfeError],
	expected_form: String,
) -> Bool:
	match result:
		Err(CompilerCtfeUnsupported(form)):
			form == expected_form
		_:
			False


pure func result_is_expected_value_error(
	result: Result[CompilerCtfeValue, CompilerCtfeError],
	expected_type: String,
	actual_type: String,
) -> Bool:
	match result:
		Err(CompilerCtfeExpectedValue(expected, actual)):
			expected == expected_type and actual == actual_type
		_:
			False


pure func tuple_value(values: List[CompilerCtfeValue]) -> CompilerCtfeValue:
	compiler_ctfe_value(CompilerTupleType(values.map(
			func(value: CompilerCtfeValue): value.typ,
		)), CompilerCtfeTupleValue(values), source_span())


pure func list_value(values: List[CompilerCtfeValue]) -> CompilerCtfeValue:
	compiler_ctfe_value(
		compiler_type_list(compiler_type_int()),
		CompilerCtfeListValue(values),
		source_span(),
	)


func test_value_equality_is_structural() -> Bool:
	left = tuple_value([
		int_value(1),
		list_value([int_value(2), int_value(3)]),
		compiler_ctfe_value(
			CompilerNamedType("Point", []),
			CompilerCtfeRecordValue([("x", int_value(4)), ("y", int_value(5))]),
			source_span(),
		),
	])
	right = tuple_value([
		int_value(1),
		list_value([int_value(2), int_value(3)]),
		compiler_ctfe_value(
			CompilerNamedType("Point", []),
			CompilerCtfeRecordValue([("x", int_value(4)), ("y", int_value(5))]),
			source_span(),
		),
	])
	different = tuple_value([
		int_value(1),
		list_value([int_value(2), int_value(99)]),
		compiler_ctfe_value(
			CompilerNamedType("Point", []),
			CompilerCtfeRecordValue([("x", int_value(4)), ("y", int_value(5))]),
			source_span(),
		),
	])

	compiler_ctfe_values_equal(left, right) and not compiler_ctfe_values_equal(left, different)


func test_constructor_and_dict_equality_are_structural() -> Bool:
	info = compiler_ctfe_constructor_info("Option", 1, Some(7))
	left_ctor: CompilerCtfeConstructorPayload = {
		name = "Some",
		args = [int_value(42)],
		constructor_info = info
	}
	right_ctor: CompilerCtfeConstructorPayload = {
		name = "Some",
		args = [int_value(42)],
		constructor_info = info
	}
	left = compiler_ctfe_value(
		CompilerNamedType("Option", [compiler_type_int()]),
		CompilerCtfeDictValue([(string_value("answer"), compiler_ctfe_value(
						CompilerNamedType("Option", [compiler_type_int()]),
						CompilerCtfeConstructorValue(left_ctor),
						source_span(),
					))]),
		source_span(),
	)
	right = compiler_ctfe_value(
		CompilerNamedType("Option", [compiler_type_int()]),
		CompilerCtfeDictValue([(string_value("answer"), compiler_ctfe_value(
						CompilerNamedType("Option", [compiler_type_int()]),
						CompilerCtfeConstructorValue(right_ctor),
						source_span(),
					))]),
		source_span(),
	)

	compiler_ctfe_values_equal(left, right)


func test_int_binary_ops_match_language_infallibility() -> Bool:
	div_zero = compiler_ctfe_eval_binary(ParsedDivideOp, int_value(9), int_value(0))
	mod_zero = compiler_ctfe_eval_binary(ParsedModuloOp, int_value(9), int_value(0))
	add = compiler_ctfe_eval_binary(ParsedAddOp, int_value(40), int_value(2))

	(
		result_value_equal(div_zero, int_value(0))
		and result_value_equal(mod_zero, int_value(0))
		and result_value_equal(add, int_value(42))
	)


func test_comparisons_return_bool_values() -> Bool:
	greater = compiler_ctfe_eval_binary(ParsedGreaterOp, int_value(5), int_value(3))
	equal = compiler_ctfe_eval_binary(ParsedEqualOp, string_value("a"), string_value("a"))
	not_equal = compiler_ctfe_eval_binary(ParsedNotEqualOp, string_value("a"), string_value("b"))

	(
		result_value_equal(greater, bool_value(True))
		and result_value_equal(equal, bool_value(True))
		and result_value_equal(not_equal, bool_value(True))
	)


func test_float_binary_ops_and_errors() -> Bool:
	sum = compiler_ctfe_eval_binary(ParsedAddOp, float_value(1.5), float_value(2.25))
	modulo = compiler_ctfe_eval_binary(ParsedModuloOp, float_value(4.0), float_value(2.0))

	result_value_equal(sum, float_value(3.75)) and result_is_unsupported(modulo, "Float modulo")


func test_float32_arithmetic_rounds_each_result() -> Bool:
	result = compiler_ctfe_eval_binary(
		ParsedAddOp,
		sized_float_value("Float32", 16777216.0),
		sized_float_value("Float32", 1.0),
	)

	result_value_equal(result, sized_float_value("Float32", 16777216.0))


func test_float16_arithmetic_rounds_each_result() -> Bool:
	result = compiler_ctfe_eval_binary(
		ParsedAddOp,
		sized_float_value("Float16", 2048.0),
		sized_float_value("Float16", 1.0),
	)

	result_value_equal(result, sized_float_value("Float16", 2048.0))


func test_sized_float_unary_preserves_type() -> Bool:
	result = compiler_ctfe_eval_unary(
		ParsedNegateOp,
		sized_float_value("Float16", 2048.0),
	)

	result_value_equal(result, sized_float_value("Float16", -2048.0))


func test_string_add_requires_string_rhs() -> Bool:
	ok = compiler_ctfe_eval_binary(ParsedAddOp, string_value("bl"), string_value("orp"))
	err = compiler_ctfe_eval_binary(ParsedAddOp, string_value("blorp"), int_value(1))

	(
		result_value_equal(ok, string_value("blorp"))
		and result_is_expected_value_error(err, "String", "Int")
	)


func test_unary_ops() -> Bool:
	neg_int = compiler_ctfe_eval_unary(ParsedNegateOp, int_value(7))
	neg_float = compiler_ctfe_eval_unary(ParsedNegateOp, float_value(2.5))
	not_bool = compiler_ctfe_eval_unary(ParsedNotOp, bool_value(False))

	(
		result_value_equal(neg_int, int_value(-7))
		and result_value_equal(neg_float, float_value(-2.5))
		and result_value_equal(not_bool, bool_value(True))
	)


func test_error_messages_are_user_facing() -> Bool:
	err = CompilerCtfeExpectedValue("Int", "String")

	compiler_ctfe_error_message(
		err,
	) == "compile-time constant evaluation expected Int, found String"


tests: TestSuite = {
	description = "Compiler CTFE value",
	tests = [
		("value equality is structural", test_value_equality_is_structural),
		(
			"constructor and dict equality are structural",
			test_constructor_and_dict_equality_are_structural,
		),
		(
			"int binary ops match language infallibility",
			test_int_binary_ops_match_language_infallibility,
		),
		("comparisons return bool values", test_comparisons_return_bool_values),
		("float binary ops and errors", test_float_binary_ops_and_errors),
		(
			"Float32 arithmetic rounds each result",
			test_float32_arithmetic_rounds_each_result,
		),
		(
			"Float16 arithmetic rounds each result",
			test_float16_arithmetic_rounds_each_result,
		),
		(
			"sized float unary preserves type",
			test_sized_float_unary_preserves_type,
		),
		("string add requires string rhs", test_string_add_requires_string_rhs),
		("unary ops", test_unary_ops),
		("error messages are user facing", test_error_messages_are_user_facing),
	]
}
