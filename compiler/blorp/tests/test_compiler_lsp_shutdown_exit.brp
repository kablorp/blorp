import:
	../src/stage_12_lsp/lsp_exit: LspExitNotification(LspClientExit), decode_lsp_exit_notification
	../src/stage_12_lsp/lsp_initialize: handle_lsp_initialize_body
	../src/stage_12_lsp/lsp_json_rpc: lsp_json_rpc_error_value
	../src/stage_12_lsp/lsp_lifecycle_model:
		LspExitStatus(LspExitFailure, LspExitSuccess),
		LspInitializedNotification(LspClientInitialized),
		LspLifecycleError(LspShutdownOutOfOrder),
		LspLifecycleState,
		LspOperationalAdmission(LspOperationalAfterShutdown),
		lsp_exit_status_code,
		lsp_initial_lifecycle_state,
		lsp_lifecycle_accept_initialize,
		lsp_lifecycle_accept_initialized,
		lsp_lifecycle_accept_shutdown,
		lsp_lifecycle_exit_status,
		lsp_lifecycle_operational_admission,
	../src/stage_12_lsp/lsp_protocol:
		LspProtocolError(LspInvalidMethodParameters, LspMissingRequestId, LspUnexpectedRequestId),
		LspProtocolInputOutcome(
			LspProtocolInputAccepted,
			LspProtocolInputIgnored,
			LspProtocolInputRejected,
		),
		LspRequestId(LspIntegerRequestId, LspStringRequestId),
	../src/stage_12_lsp/lsp_shutdown: decode_lsp_shutdown_request, encode_lsp_shutdown_response
	json: JsonValue(JsonNull), as_number, as_string, get_field, parse_json
	test: TestSuite


private INITIALIZE_BODY: String =
	|{
	|  "jsonrpc": "2.0",
	|  "id": 1,
	|  "method": "initialize",
	|  "params": {"processId": null, "capabilities": {}}
	|}


private pure func running_lifecycle() -> Option[LspLifecycleState]:
	match handle_lsp_initialize_body(INITIALIZE_BODY):
		LspProtocolInputAccepted(initialization):
			match lsp_lifecycle_accept_initialize(lsp_initial_lifecycle_state(), initialization):
				Ok(awaiting_initialized):
					match lsp_lifecycle_accept_initialized(
						awaiting_initialized,
						LspClientInitialized,
					):
						Ok(running):
							Some(running)
						Err(_):
							None
				Err(_):
					None
		_:
			None


private pure func response_error_code(response: JsonValue) -> Option[Float]:
	error ?= get_field(response, "error")
	code ?= get_field(error, "code")
	code.as_number()


func test_shutdown_accepts_omitted_or_null_parameters() -> Bool:
	omitted: Bool = match decode_lsp_shutdown_request(
		"{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"shutdown\"}",
	):
		LspProtocolInputAccepted(request):
			match request.id:
				LspIntegerRequestId(id):
					id == 4
				_:
					False
		_:
			False

	null_params: Bool = match decode_lsp_shutdown_request(
		"{\"jsonrpc\":\"2.0\",\"id\":\"close\",\"method\":\"shutdown\",\"params\":null}",
	):
		LspProtocolInputAccepted(request):
			match parse_json(encode_lsp_shutdown_response(request)):
				Ok(response):
					match get_field(response, "result"):
						Some(JsonNull):
							match get_field(response, "id"):
								Some(id):
									id.as_string() == Some("close")
								None:
									False
						_:
							False
				Err(_):
					False
		_:
			False

	omitted and null_params


func test_shutdown_rejects_notification_and_invalid_parameters() -> Bool:
	missing_id: Bool = match decode_lsp_shutdown_request(
		"{\"jsonrpc\":\"2.0\",\"method\":\"shutdown\"}",
	):
		LspProtocolInputIgnored(LspMissingRequestId(method)):
			method == "shutdown"
		_:
			False

	invalid_params: Bool = match decode_lsp_shutdown_request(
		"{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"shutdown\",\"params\":{}}",
	):
		LspProtocolInputRejected(failure):
			method_ok: Bool = match failure.error:
				LspInvalidMethodParameters(method, detail):
					method == "shutdown" and detail.contains("omitted or null")
				_:
					False

			id_ok: Bool = match failure.request_id:
				Some(LspIntegerRequestId(id)):
					id == 9
				_:
					False

			(
				response_error_code(lsp_json_rpc_error_value(failure)) == Some(-32602.0)
				and method_ok
				and id_ok
			)
		_:
			False

	missing_id and invalid_params


func test_exit_accepts_omitted_or_null_parameters() -> Bool:
	omitted: Bool = match decode_lsp_exit_notification("{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}"):
		LspProtocolInputAccepted(LspClientExit):
			True
		_:
			False

	null_params: Bool = match decode_lsp_exit_notification(
		"{\"jsonrpc\":\"2.0\",\"method\":\"exit\",\"params\":null}",
	):
		LspProtocolInputAccepted(LspClientExit):
			True
		_:
			False

	omitted and null_params


func test_exit_rejects_requests_and_ignores_invalid_parameters() -> Bool:
	request: Bool = match decode_lsp_exit_notification(
		"{\"jsonrpc\":\"2.0\",\"id\":\"exit-request\",\"method\":\"exit\"}",
	):
		LspProtocolInputRejected(failure):
			error_ok: Bool = match failure.error:
				LspUnexpectedRequestId(method):
					method == "exit"
				_:
					False

			id_ok: Bool = match failure.request_id:
				Some(LspStringRequestId(id)):
					id == "exit-request"
				_:
					False

			error_ok and id_ok
		_:
			False

	invalid_params: Bool = match decode_lsp_exit_notification(
		"{\"jsonrpc\":\"2.0\",\"method\":\"exit\",\"params\":[]}",
	):
		LspProtocolInputIgnored(LspInvalidMethodParameters(method, detail)):
			method == "exit" and detail.contains("omitted or null")
		_:
			False

	request and invalid_params


func test_shutdown_and_exit_lifecycle_contract() -> Bool:
	initial_status_ok: Bool = match lsp_lifecycle_exit_status(lsp_initial_lifecycle_state()):
		LspExitFailure:
			lsp_exit_status_code(LspExitFailure) == 1
		_:
			False

	match running_lifecycle():
		None:
			False
		Some(running):
			match lsp_lifecycle_accept_shutdown(running):
				Err(_):
					False
				Ok(shutdown):
					duplicate_ok: Bool = match lsp_lifecycle_accept_shutdown(shutdown):
						Err(LspShutdownOutOfOrder):
							True
						_:
							False

					status_ok: Bool = match lsp_lifecycle_exit_status(shutdown):
						LspExitSuccess:
							lsp_exit_status_code(LspExitSuccess) == 0
						_:
							False

					(
						initial_status_ok
						and duplicate_ok
						and status_ok
						and lsp_lifecycle_operational_admission(
							shutdown,
						) == LspOperationalAfterShutdown
					)


tests: TestSuite = {
	description = "Blorp LSP shutdown and exit",
	tests = [
		(
			"shutdown accepts omitted or null params",
			test_shutdown_accepts_omitted_or_null_parameters,
		),
		(
			"shutdown rejects notification and invalid params",
			test_shutdown_rejects_notification_and_invalid_parameters,
		),
		("exit accepts omitted or null params", test_exit_accepts_omitted_or_null_parameters),
		(
			"exit rejects requests and invalid params",
			test_exit_rejects_requests_and_ignores_invalid_parameters,
		),
		("enforce shutdown and exit lifecycle", test_shutdown_and_exit_lifecycle_contract),
	]
}
