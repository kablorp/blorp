import:
	../codegen_intrinsic_renderer:
		CompilerCommand(RenderIntrinsicCommand, RenderManifestCommand, UnknownCommand),
		Intrinsic(NoArgs, OneArg, TwoArgs, ThreeArgs),
		NoArgIntrinsic(ElemReleaseFn, MathNan),
		OneArgIntrinsic(FixedPow10, FixedScale, ListLen, MathSqrt, SliceSource),
		RenderError(UnsupportedIntrinsic, WrongArity),
		ThreeArgIntrinsic(
			BytesSet,
			DictSetValueAt,
			FixedAlloc,
			MathFma,
			SetSetBucket,
			TensorSetF64,
		),
		TwoArgIntrinsic(BitAnd, DictMetaGet, ListGet, MathPow, SetHash, ShiftLeft, StringGetByte),
		all_intrinsics,
		intrinsic_arity,
		intrinsic_name,
		parse_command,
		parse_intrinsic,
		render_error_to_string,
		render_intrinsic,
		render_manifest_line,
		render_manifest_lines,
	test: TestSuite


func test_parse_command_routes() -> Bool:
	intrinsic_command: CompilerCommand = parse_command("intrinsic")
	manifest_command: CompilerCommand = parse_command("manifest")
	unknown_command: CompilerCommand = parse_command("wat")
	intrinsic_ok: Bool = match intrinsic_command:
		RenderIntrinsicCommand: True
		RenderManifestCommand: False
		UnknownCommand: False
	manifest_ok: Bool = match manifest_command:
		RenderIntrinsicCommand: False
		RenderManifestCommand: True
		UnknownCommand: False
	unknown_ok: Bool = match unknown_command:
		RenderIntrinsicCommand: False
		RenderManifestCommand: False
		UnknownCommand: True
	intrinsic_ok and manifest_ok and unknown_ok


func test_parse_intrinsic_shapes() -> Bool:
	no_args_ok: Bool = match parse_intrinsic("math_nan"):
		Some(intrinsic):
			match intrinsic:
				NoArgs(inner): intrinsic_name(
					intrinsic,
				) == "math_nan" and intrinsic_arity(intrinsic) == 0
				OneArg(inner): False
				TwoArgs(inner): False
				ThreeArgs(inner): False
		None: False
	one_arg_ok: Bool = match parse_intrinsic("math_sqrt"):
		Some(intrinsic):
			match intrinsic:
				NoArgs(inner): False
				OneArg(inner): intrinsic_name(
					intrinsic,
				) == "math_sqrt" and intrinsic_arity(intrinsic) == 1
				TwoArgs(inner): False
				ThreeArgs(inner): False
		None: False
	two_args_ok: Bool = match parse_intrinsic("math_pow"):
		Some(intrinsic):
			match intrinsic:
				NoArgs(inner): False
				OneArg(inner): False
				TwoArgs(inner): intrinsic_name(
					intrinsic,
				) == "math_pow" and intrinsic_arity(intrinsic) == 2
				ThreeArgs(inner): False
		None: False
	three_args_ok: Bool = match parse_intrinsic("math_fma"):
		Some(intrinsic):
			match intrinsic:
				NoArgs(inner): False
				OneArg(inner): False
				TwoArgs(inner): False
				ThreeArgs(inner): intrinsic_name(
					intrinsic,
				) == "math_fma" and intrinsic_arity(intrinsic) == 3
		None: False
	missing_ok: Bool = match parse_intrinsic("missing"):
		Some(intrinsic): False
		None: True
	no_args_ok and one_arg_ok and two_args_ok and three_args_ok and missing_ok


func test_intrinsic_metadata() -> Bool:
	sqrt: Intrinsic = OneArg(MathSqrt)
	dict_meta_get: Intrinsic = TwoArgs(DictMetaGet)
	nan: Intrinsic = NoArgs(MathNan)
	fma: Intrinsic = ThreeArgs(MathFma)
	bit_and: Intrinsic = TwoArgs(BitAnd)
	list_len: Intrinsic = OneArg(ListLen)
	elem_release_fn: Intrinsic = NoArgs(ElemReleaseFn)
	string_get_byte: Intrinsic = TwoArgs(StringGetByte)
	tensor_set_f64: Intrinsic = ThreeArgs(TensorSetF64)
	names_ok: Bool = intrinsic_name(
		sqrt,
	) == "math_sqrt" and intrinsic_name(dict_meta_get) == "dict_meta_get"
	arities_ok: Bool = intrinsic_arity(
		nan,
	) == 0 and intrinsic_arity(
		fma,
	) == 3 and intrinsic_arity(
		bit_and,
	) == 2 and intrinsic_arity(
		list_len,
	) == 1 and intrinsic_arity(
		elem_release_fn,
	) == 0 and intrinsic_arity(string_get_byte) == 2 and intrinsic_arity(tensor_set_f64) == 3
	names_ok and arities_ok


func test_render_intrinsic_successes() -> Bool:
	sqrt_ok: Bool = match render_intrinsic("math_sqrt", ["x"]):
		Ok(rendered): rendered == "sqrt(x)"
		Err(error): False
	shift_ok: Bool = match render_intrinsic(
		"shift_left",
		["value", "amount"],
	):
		Ok(rendered): rendered == "((long)(value << (amount & 63)))"
		Err(error): False
	dict_ok: Bool = match render_intrinsic(
		"dict_meta_get",
		["dict", "slot"],
	):
		Ok(rendered): rendered == "((long)((blorp_Dict*)dict)->meta[slot])"
		Err(error): False
	slice_ok: Bool = match render_intrinsic("slice_source", ["slice"]):
		Ok(rendered): rendered == "((void*)((blorp_StringSlice*)slice)->source)"
		Err(error): False
	fixed_ok: Bool = match render_intrinsic("fixed_scale", ["fx"]):
		Ok(rendered): rendered == "(long)((blorp_Fixed*)fx)->scale"
		Err(error): False
	list_ok: Bool = match render_intrinsic(
		"list_get",
		["xs", "idx"],
	):
		Ok(rendered): rendered == "blorp_list_get((blorp_List*)xs, idx)"
		Err(error): False
	string_ok: Bool = match render_intrinsic(
		"string_get_byte",
		["s", "i"],
	):
		Ok(rendered): rendered == "(long)(unsigned char)((blorp_String*)s)->data[i]"
		Err(error): False
	bytes_ok: Bool = match render_intrinsic(
		"bytes_set",
		["b", "i", "v"],
	):
		Ok(rendered): rendered == "(((blorp_Bytes*)b)->data[i] = (unsigned char)v)"
		Err(error): False
	set_ok: Bool = match render_intrinsic(
		"set_set_bucket",
		["set", "slot", "entry"],
	):
		Ok(rendered): rendered == "(((blorp_Set*)set)->buckets[slot] = (blorp_SetEntry*)entry)"
		Err(error): False
	tensor_ok: Bool = match render_intrinsic(
		"tensor_set_f64",
		["vec", "i", "v"],
	):
		Ok(rendered): rendered == "blorp_vector_write_f64((blorp_Vector*)vec, i, v)"
		Err(error): False
	sqrt_ok and shift_ok and dict_ok and slice_ok and fixed_ok and list_ok and string_ok and bytes_ok and set_ok and tensor_ok


func test_render_intrinsic_errors_are_typed() -> Bool:
	wrong_arity_ok: Bool = match render_intrinsic(
		"math_sqrt",
		["x", "extra"],
	):
		Ok(rendered): False
		Err(error):
			match error:
				WrongArity(intrinsic, expected, got):
					intrinsic_name(intrinsic) == "math_sqrt" and expected == 1 and got == 2
				UnsupportedIntrinsic(name): False
	too_many_ok: Bool = match render_intrinsic(
		"math_sqrt",
		["a", "b", "c", "d"],
	):
		Ok(rendered): False
		Err(error):
			match error:
				WrongArity(intrinsic, expected, got):
					intrinsic_name(intrinsic) == "math_sqrt" and expected == 1 and got == 4
				UnsupportedIntrinsic(name): False
	unsupported_ok: Bool = match render_intrinsic(
		"list_set",
		["xs", "i", "value"],
	):
		Ok(rendered): False
		Err(error):
			match error:
				WrongArity(intrinsic, expected, got): False
				UnsupportedIntrinsic(name): name == "list_set"
	wrong_arity_ok and too_many_ok and unsupported_ok


func test_render_error_to_string() -> Bool:
	arity_error: RenderError = WrongArity(TwoArgs(MathPow), 2, 1)
	unsupported_error: RenderError = UnsupportedIntrinsic("missing")
	arity_text: String = render_error_to_string(arity_error)
	unsupported_text: String = render_error_to_string(unsupported_error)
	arity_text == "intrinsic math_pow expected 2 arg(s), got 1" and unsupported_text == "unsupported intrinsic: missing"


func test_render_manifest_line() -> Bool:
	shift_ok: Bool = render_manifest_line(
		TwoArgs(ShiftLeft),
	) == "shift_left\t2\t((long)(@0@ << (@1@ & 63)))"
	fixed_ok: Bool = render_manifest_line(
		OneArg(FixedScale),
	) == "fixed_scale\t1\t(long)((blorp_Fixed*)@0@)->scale"
	set_ok: Bool = render_manifest_line(
		TwoArgs(SetHash),
	) == "set_hash\t2\t((long)((blorp_Set*)@0@)->hash_fn(@1@))"
	fixed_alloc_ok: Bool = render_manifest_line(
		ThreeArgs(FixedAlloc),
	) == "fixed_alloc\t3\tblorp_fixed_raw(@0@, (int)@1@, (int)@2@)"
	shift_ok and fixed_ok and set_ok and fixed_alloc_ok


func test_render_manifest_lines_matches_intrinsic_list() -> Bool:
	lines: List[String] = render_manifest_lines()
	count_ok: Bool = lines.length() == all_intrinsics().length()
	first_ok: Bool = match lines:
		[]: False
		[first, ...rest]: first == "math_sin\t1\tsin(@0@)"
	count_ok and first_ok


tests: TestSuite = {
	description = "Self-hosted compiler intrinsic renderer",
	tests = [
		("parse command routes", test_parse_command_routes),
		("parse intrinsic shapes", test_parse_intrinsic_shapes),
		("intrinsic metadata", test_intrinsic_metadata),
		("render intrinsic successes", test_render_intrinsic_successes),
		("render intrinsic errors are typed", test_render_intrinsic_errors_are_typed),
		("render error to string", test_render_error_to_string),
		("render manifest line", test_render_manifest_line),
		(
			"render manifest lines matches intrinsic list",
			test_render_manifest_lines_matches_intrinsic_list,
		),
	]
}
