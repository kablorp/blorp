import:
	../codegen_intrinsic_renderer:
		CompilerCommand(RenderIntrinsicCommand, RenderManifestCommand, UnknownCommand),
		Intrinsic(
			BitAnd,
			DictMetaGet,
			FixedScale,
			ListLen,
			MathFma,
			MathNan,
			MathPow,
			MathSqrt,
			ShiftLeft,
			SliceSource,
		),
		RenderError(UnsupportedIntrinsic, WrongArity),
		all_intrinsics,
		intrinsic_arity,
		intrinsic_name,
		parse_command,
		placeholder_args,
		render_error_to_string,
		render_intrinsic,
		render_manifest_line,
		render_manifest_lines,
	test: TestSuite


func test_parse_command_routes() -> Bool:
	intrinsic_command: CompilerCommand = parse_command("intrinsic")
	manifest_command: CompilerCommand = parse_command("manifest")
	unknown_command: CompilerCommand = parse_command("wat")
	intrinsic_ok: Bool = match intrinsic_command:
		RenderIntrinsicCommand: True
		RenderManifestCommand: False
		UnknownCommand: False
	manifest_ok: Bool = match manifest_command:
		RenderIntrinsicCommand: False
		RenderManifestCommand: True
		UnknownCommand: False
	unknown_ok: Bool = match unknown_command:
		RenderIntrinsicCommand: False
		RenderManifestCommand: False
		UnknownCommand: True
	intrinsic_ok and manifest_ok and unknown_ok


func test_intrinsic_metadata() -> Bool:
	sqrt: Intrinsic = MathSqrt
	dict_meta_get: Intrinsic = DictMetaGet
	nan: Intrinsic = MathNan
	fma: Intrinsic = MathFma
	bit_and: Intrinsic = BitAnd
	list_len: Intrinsic = ListLen
	names_ok: Bool = intrinsic_name(
		sqrt,
	) == "math_sqrt" and intrinsic_name(dict_meta_get) == "dict_meta_get"
	arities_ok: Bool = intrinsic_arity(
		nan,
	) == 0 and intrinsic_arity(
		fma,
	) == 3 and intrinsic_arity(bit_and) == 2 and intrinsic_arity(list_len) == 1
	names_ok and arities_ok


func test_placeholder_args() -> Bool:
	placeholder_args(
		0,
	).length() == 0 and placeholder_args(
		1,
	) == [
		"@0@",
	] and placeholder_args(
		2,
	) == [
		"@0@",
		"@1@",
	] and placeholder_args(
		3,
	) == ["@0@", "@1@", "@2@"] and placeholder_args(9) == ["@0@", "@1@", "@2@"]


func test_render_intrinsic_successes() -> Bool:
	sqrt_ok: Bool = match render_intrinsic("math_sqrt", ["x"]):
		Ok(rendered): rendered == "sqrt(x)"
		Err(error): False
	shift_ok: Bool = match render_intrinsic(
		"shift_left",
		["value", "amount"],
	):
		Ok(rendered): rendered == "((long)(value << (amount & 63)))"
		Err(error): False
	dict_ok: Bool = match render_intrinsic(
		"dict_meta_get",
		["dict", "slot"],
	):
		Ok(rendered): rendered == "((long)((blorp_Dict*)dict)->meta[slot])"
		Err(error): False
	slice_ok: Bool = match render_intrinsic("slice_source", ["slice"]):
		Ok(rendered): rendered == "((void*)((blorp_StringSlice*)slice)->source)"
		Err(error): False
	fixed_ok: Bool = match render_intrinsic("fixed_scale", ["fx"]):
		Ok(rendered): rendered == "(long)((blorp_Fixed*)fx)->scale"
		Err(error): False
	sqrt_ok and shift_ok and dict_ok and slice_ok and fixed_ok


func test_render_intrinsic_errors_are_typed() -> Bool:
	wrong_arity_ok: Bool = match render_intrinsic(
		"math_sqrt",
		["x", "extra"],
	):
		Ok(rendered): False
		Err(error):
			match error:
				WrongArity(intrinsic, expected, got):
					intrinsic_name(intrinsic) == "math_sqrt" and expected == 1 and got == 2
				UnsupportedIntrinsic(name): False
	unsupported_ok: Bool = match render_intrinsic(
		"list_set",
		["xs", "i", "value"],
	):
		Ok(rendered): False
		Err(error):
			match error:
				WrongArity(intrinsic, expected, got): False
				UnsupportedIntrinsic(name): name == "list_set"
	wrong_arity_ok and unsupported_ok


func test_render_error_to_string() -> Bool:
	arity_error: RenderError = WrongArity(MathPow, 2, 1)
	unsupported_error: RenderError = UnsupportedIntrinsic("missing")
	arity_text: String = render_error_to_string(arity_error)
	unsupported_text: String = render_error_to_string(unsupported_error)
	arity_text == "intrinsic math_pow expected 2 arg(s), got 1" and unsupported_text == "unsupported intrinsic: missing"


func test_render_manifest_line() -> Bool:
	shift_ok: Bool = match render_manifest_line(ShiftLeft):
		Ok(line): line == "shift_left\t2\t((long)(@0@ << (@1@ & 63)))"
		Err(error): False
	fixed_ok: Bool = match render_manifest_line(FixedScale):
		Ok(line): line == "fixed_scale\t1\t(long)((blorp_Fixed*)@0@)->scale"
		Err(error): False
	shift_ok and fixed_ok


func test_render_manifest_lines_matches_intrinsic_list() -> Bool:
	match render_manifest_lines():
		Ok(lines):
			count_ok: Bool = lines.length() == all_intrinsics().length()
			first_ok: Bool = match lines:
				[]: False
				[first, ...rest]: first == "math_sin\t1\tsin(@0@)"
			count_ok and first_ok
		Err(error): False


tests: TestSuite = {
	description = "Self-hosted compiler intrinsic renderer",
	tests = [
		("parse command routes", test_parse_command_routes),
		("intrinsic metadata", test_intrinsic_metadata),
		("placeholder args", test_placeholder_args),
		("render intrinsic successes", test_render_intrinsic_successes),
		("render intrinsic errors are typed", test_render_intrinsic_errors_are_typed),
		("render error to string", test_render_error_to_string),
		("render manifest line", test_render_manifest_line),
		(
			"render manifest lines matches intrinsic list",
			test_render_manifest_lines_matches_intrinsic_list,
		),
	]
}
