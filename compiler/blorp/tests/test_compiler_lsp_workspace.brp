import:
	../src/stage_01_file_io/source: CompilerSourceFile, compiler_source_file
	../src/stage_04_modules/project_source_catalog:
		CompilerProjectStdProvider(CompilerProjectFilesystemStd),
	../src/stage_12_lsp/lsp_architecture:
		LspAnalysisPlanningRequirement(LspAnalysisPlanRequired, LspNoAnalysisPlanRequired),
		LspInvalidationReason(
			LspConfigurationInvalidated,
			LspDocumentIdentityInvalidated,
			LspModuleSetInvalidated,
			LspSourceContentInvalidated,
			LspSourceRemoved,
		),
		LspWorkspaceError(
			LspOutOfOrderDocumentVersion,
			LspWorkspaceSourceIdentityConflict,
			LspWorkspaceSourceUnavailable,
		),
