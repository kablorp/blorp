	../src/stage_12_lsp/lsp_document_store: lsp_document_store_find
	../src/stage_12_lsp/lsp_fingerprint_model: LspContentFingerprint
	../src/stage_12_lsp/lsp_identity: LspDocumentUri, lsp_document_uri
	../src/stage_12_lsp/lsp_snapshot_model:
		lsp_configuration_epoch_value,
		lsp_workspace_revision_value,
	../src/stage_12_lsp/lsp_workspace:
		LspWorkspace,
