import:
	../src/stage_01_file_io/compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_03_parse/compiler_parsed_ast:
		ParsedExpr(ParsedIntLiteralExpr),
		ParsedIdentifier,
		ParsedTypeExpr(ParsedNamedType),
		ParsedVarDecl,
		parsed_identifier,
	../src/stage_05_types/compiler_refinement: unrefined_binding
	../src/stage_05_types/compiler_type: type_int
	../src/stage_05_types/compiler_type_widening: ValueSlot(KeptValueSlot)
	../src/stage_06_typecheck/compiler_infer:
		ExprTypeOrigin(SynthesizedOrigin),
		TypedExpr(TypedIntLiteralExpr),
		TypedExprInfo,
	../src/stage_06_typecheck/compiler_typecheck_decl:
		TypedDecl(TypedGlobalVarDecl, TypedPrivateDecl),
		TypedGlobalVarInfo,
		TypedProgram,
	../src/stage_07_ctfe/compiler_ctfe_context: CompilerCtfeImportedProgram
	../src/stage_07_ctfe/compiler_ctfe_env:
		CompilerCtfeEnvError(CompilerCtfeUnavailableBinding, CompilerCtfeUnknownBinding),
		compiler_ctfe_env_empty,
		compiler_ctfe_lookup_value,
	../src/stage_07_ctfe/compiler_ctfe_globals:
		compiler_ctfe_bind_unavailable_program_globals,
		compiler_ctfe_global_decl_from_typed_decl,
		compiler_ctfe_global_initializer_runs_at_runtime,
		compiler_ctfe_imported_program_declares_global,
		compiler_ctfe_program_declares_global,
		compiler_ctfe_typed_decl_declares_global,
		compiler_ctfe_unavailable_reason_for_global,
	../src/stage_07_ctfe/compiler_ctfe_value:
		CompilerCtfeUnavailableGlobalReason(
			CompilerCtfeLaterGlobal,
			CompilerCtfeRuntimeInitializedGlobal,
		),
		CompilerCtfeValue,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("ctfe_globals.brp", "ctfe_globals", "VALUE = 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], source_span())


pure func parsed_var(name: String, is_mutable: Bool) -> ParsedVarDecl:
	{
		name = ident(name),
		type_expr = Some(named_type("Int")),
		value = ParsedIntLiteralExpr("1", source_span()),
		is_mutable = is_mutable,
		span = source_span()
	}


pure func expr_info() -> TypedExprInfo:
	{
		source_type = None,
		origin = SynthesizedOrigin("ctfe_globals_test"),
		value_slot = KeptValueSlot(type_int()),
		proofs = unrefined_binding(),
		resolved_call = None,
		resource_dependencies = []
	}


pure func typed_global(name: String, is_mutable: Bool) -> TypedGlobalVarInfo:
	{
		decl = parsed_var(name, is_mutable),
		binding_type = type_int(),
		source_type = Some(type_int()),
		value = TypedIntLiteralExpr("1", source_span(), expr_info())
	}


pure func typed_global_decl(name: String, is_mutable: Bool) -> TypedDecl:
	TypedGlobalVarDecl(typed_global(name, is_mutable))


pure func private_typed_global_decl(name: String, is_mutable: Bool) -> TypedDecl:
	TypedPrivateDecl(typed_global_decl(name, is_mutable))


pure func typed_program(decls: List[TypedDecl]) -> TypedProgram:
	{
		source = source_file(),
		decls = decls,
		diagnostics = []
	}


pure func reason_is_later(reason: CompilerCtfeUnavailableGlobalReason) -> Bool:
	match reason:
		CompilerCtfeLaterGlobal:
			True
		_:
			False


pure func reason_is_runtime(reason: CompilerCtfeUnavailableGlobalReason) -> Bool:
	match reason:
		CompilerCtfeRuntimeInitializedGlobal:
			True
		_:
			False


pure func unavailable_reason_is_later(
	result: Result[CompilerCtfeValue, CompilerCtfeEnvError],
) -> Bool:
	match result:
		Err(CompilerCtfeUnavailableBinding(_, CompilerCtfeLaterGlobal)):
			True
		_:
			False


pure func unavailable_reason_is_runtime(
	result: Result[CompilerCtfeValue, CompilerCtfeEnvError],
) -> Bool:
	match result:
		Err(CompilerCtfeUnavailableBinding(_, CompilerCtfeRuntimeInitializedGlobal)):
			True
		_:
			False


func test_global_reason_tracks_mutability() -> Bool:
	immutable_info = typed_global("A", False)
	mutable_info = typed_global("B", True)

	(
		not compiler_ctfe_global_initializer_runs_at_runtime(immutable_info)
		and compiler_ctfe_global_initializer_runs_at_runtime(mutable_info)
		and reason_is_later(compiler_ctfe_unavailable_reason_for_global(immutable_info))
		and reason_is_runtime(compiler_ctfe_unavailable_reason_for_global(mutable_info))
	)


func test_global_decl_preserves_private_flag() -> Bool:
	match compiler_ctfe_global_decl_from_typed_decl(private_typed_global_decl("HIDDEN", False)):
		Some(global_decl):
			global_decl.name == "HIDDEN" and global_decl.is_private
		None:
			False


func test_program_global_lookup_walks_private_decls() -> Bool:
	program = typed_program([
		typed_global_decl("PUBLIC", False),
		private_typed_global_decl("PRIVATE", False),
	])

	(
		compiler_ctfe_program_declares_global(program, "PUBLIC")
		and compiler_ctfe_program_declares_global(program, "PRIVATE")
		and compiler_ctfe_typed_decl_declares_global(
			private_typed_global_decl("PRIVATE", False),
			"PRIVATE",
		)
		and not compiler_ctfe_program_declares_global(program, "MISSING")
	)


func test_bind_unavailable_program_globals_sets_source_order_reasons() -> Bool:
	program = typed_program([
		typed_global_decl("EARLIER", False),
		typed_global_decl("RUNTIME", True),
	])
	env = compiler_ctfe_bind_unavailable_program_globals(compiler_ctfe_env_empty(), program)

	(
		unavailable_reason_is_later(compiler_ctfe_lookup_value(env, "EARLIER"))
		and unavailable_reason_is_runtime(compiler_ctfe_lookup_value(env, "RUNTIME"))
		and match compiler_ctfe_lookup_value(env, "MISSING"):
			Err(CompilerCtfeUnknownBinding(name)):
				name == "MISSING"
			_:
				False
	)


func test_imported_program_global_lookup_uses_module_path() -> Bool:
	imported_programs: List[CompilerCtfeImportedProgram] = [
		{
			module_path = "dep",
			program = typed_program([typed_global_decl("VALUE", False)]),
			import_bindings = []
		},
	]

	(
		compiler_ctfe_imported_program_declares_global(imported_programs, "dep", "VALUE")
		and not compiler_ctfe_imported_program_declares_global(imported_programs, "other", "VALUE")
		and not compiler_ctfe_imported_program_declares_global(imported_programs, "dep", "MISSING")
	)


tests: TestSuite = {
	description = "Compiler CTFE globals",
	tests = [
		("global reason tracks mutability", test_global_reason_tracks_mutability),
		("global decl preserves private flag", test_global_decl_preserves_private_flag),
		(
			"program global lookup walks private decls",
			test_program_global_lookup_walks_private_decls,
		),
		(
			"bind unavailable program globals sets source order reasons",
			test_bind_unavailable_program_globals_sets_source_order_reasons,
		),
		(
			"imported program global lookup uses module path",
			test_imported_program_global_lookup_uses_module_path,
		),
	]
}
