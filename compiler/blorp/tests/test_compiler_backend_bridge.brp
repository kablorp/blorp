import:
	../benchmarks/compiler_backend_bridge: handle_request_value
	io: print_error
	json:
		JsonValue(JsonBool, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_bool,
		as_string,
		get_field,
	test: TestSuite


private pure func benchmark_request(action: String) -> JsonValue:
	JsonObject([
		("schema", JsonNumber(1.0)),
		("domain", JsonString("compiler")),
		("action", JsonString(action)),
		("payload", JsonObject([("core", JsonObject([
				("kind", JsonString("program")),
				("decls", JsonVector([])),
				("foreign_includes", JsonVector([])),
			])), ("profile", JsonBool(False))])),
	])


private pure func artifact_field(response: JsonValue, name: String) -> Option[JsonValue]:
	artifact ?= get_field(response, "artifact")
	get_field(artifact, name)


private pure func artifact_string_field(response: JsonValue, name: String) -> Option[String]:
	match artifact_field(response, name):
		Some(value):
			as_string(value)
		None:
			None


private pure func artifact_array_field_exists(response: JsonValue, name: String) -> Bool:
	match artifact_field(response, name):
		Some(value):
			as_array(value).is_some()
		None:
			False


private pure func artifact_object_field_exists(response: JsonValue, name: String) -> Bool:
	match artifact_field(response, name):
		Some(value):
			match value:
				JsonObject(_):
					True
				_:
					False
		None:
			False


private pure func response_is_ok(response: JsonValue) -> Bool:
	match get_field(response, "ok"):
		Some(value):
			as_bool(value).get_or(False)
		None:
			False


func test_emit_core_c_returns_complete_artifact() -> Bool:
	response: JsonValue = handle_request_value(benchmark_request("emit_core_c"))

	valid: Bool = (
		response_is_ok(response)
		and artifact_string_field(response, "c_code")
			.map(func(code): code.length() > 0)
			.get_or(False)
		and artifact_array_field_exists(response, "link_flags")
		and artifact_array_field_exists(response, "include_dirs")
	)

	if not valid:
		print_error(response.to_string())

	valid


func test_run_perceus_returns_core_without_emission() -> Bool:
	response: JsonValue = handle_request_value(benchmark_request("run_perceus"))
	valid: Bool = (
		response_is_ok(response)
		and artifact_object_field_exists(response, "core")
		and artifact_field(response, "c_code").is_none()
	)

	if not valid:
		print_error(response.to_string())

	valid


pure func test_rejects_unsupported_benchmark_action() -> Bool:
	response: JsonValue = handle_request_value(benchmark_request("unknown_backend_action"))

	match get_field(response, "error"):
		Some(error):
			match get_field(error, "code"):
				Some(code_value):
					match as_string(code_value):
						Some(code):
							code == "unsupported_action"
						None:
							False
				None:
					False
		None:
			False


tests: TestSuite = {
	description = "Blorp compiler benchmark backend bridge",
	tests = [
		("emit Core C returns a complete artifact", test_emit_core_c_returns_complete_artifact),
		("run Perceus returns Core without emission", test_run_perceus_returns_core_without_emission),
		("rejects unsupported benchmark action", test_rejects_unsupported_benchmark_action),
	]
}
