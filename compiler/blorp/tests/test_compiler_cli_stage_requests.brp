import:
	../src/stage_09_core/compiler_semantic_worker_protocol: semantic_middle_stage_name
	../src/stage_12_cli/compiler_cli_stage_requests:
		CliLateCoreStageAction(
			ObserveAndStopLateCoreStage,
			ObserveLateCoreStage,
			StopLateCoreStage,
		),
		compile_stage_requests,
	test: TestSuite


pure func test_stage_requests_preserve_boundary_and_canonical_order() -> Bool:
	requests = compile_stage_requests(
		["final", "lower", "dce", "dce"],
		Some("reuse"),
	)

	(
		requests.semantic_observations.map(semantic_middle_stage_name) == ["lower"]
		and requests.semantic_stop.is_none()
		and requests.late_stages.map(func(request): request.name) == ["dce", "reuse", "final"]
		and requests.late_stages.map(
			func(
				request,
			): request.action,
		) == [ObserveLateCoreStage, StopLateCoreStage, ObserveLateCoreStage]
	)


pure func test_stage_request_can_observe_and_stop_once() -> Bool:
	requests = compile_stage_requests(["closure"], Some("closure"))

	match requests.late_stages:
		[request]:
			request.name == "closure" and request.action == ObserveAndStopLateCoreStage
		_:
			False


pure func test_semantic_stop_stays_in_worker_request() -> Bool:
	requests = compile_stage_requests(
		["resolve", "final"],
		Some("tailrec"),
	)

	(
		requests.semantic_stop.map(semantic_middle_stage_name) == Some("tailrec")
		and requests.late_stages.map(func(request): request.name) == ["final"]
	)


pure func test_specialize_is_owned_by_late_core() -> Bool:
	requests = compile_stage_requests(["specialize"], Some("specialize"))

	(
		requests.semantic_observations.length() == 0
		and requests.semantic_stop.is_none()
		and requests.late_stages.map(func(request): request.name) == ["specialize"]
		and requests.late_stages.map(func(request): request.action) == [ObserveAndStopLateCoreStage]
	)


tests: TestSuite = {
	description = "Blorp compiler CLI stage requests",
	tests = [
		(
			"stage requests preserve boundary and canonical order",
			test_stage_requests_preserve_boundary_and_canonical_order,
		),
		(
			"one late stage can be observed and stopped",
			test_stage_request_can_observe_and_stop_once,
		),
		("semantic stop stays in worker request", test_semantic_stop_stays_in_worker_request),
		("specialize is owned by late Core", test_specialize_is_owned_by_late_core),
	]
}
