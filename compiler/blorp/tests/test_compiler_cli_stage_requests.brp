import:
	../src/stage_09_core/early_pipeline: core_early_pipeline_stage_name
	../src/stage_12_cli/stage_requests:
		CliLateCoreStageAction(
			ObserveAndStopLateCoreStage,
			ObserveLateCoreStage,
			StopLateCoreStage,
		),
		compile_stage_requests,
	test: TestSuite


pure func test_stage_requests_preserve_boundary_and_canonical_order() -> Bool:
	requests = compile_stage_requests(
		["final", "lower", "dce", "dce"],
		Some("reuse"),
	)

	(
		requests.early_observations.map(core_early_pipeline_stage_name) == ["lower"]
		and requests.late_stages.map(func(request): request.name) == ["dce", "reuse", "final"]
		and requests.late_stages.map(
			func(
				request,
			): request.action,
		) == [ObserveLateCoreStage, StopLateCoreStage, ObserveLateCoreStage]
	)


pure func test_stage_request_can_observe_and_stop_once() -> Bool:
	requests = compile_stage_requests(["closure"], Some("closure"))

	match requests.late_stages:
		[request]:
			request.name == "closure" and request.action == ObserveAndStopLateCoreStage
		_:
			False


pure func test_fusion_is_owned_by_early_pipeline() -> Bool:
	requests = compile_stage_requests(
		["resolve", "fusion", "final"],
		Some("fusion"),
	)

	(
		requests.early_stop.map(core_early_pipeline_stage_name) == Some("fusion")
		and requests.early_observations.map(core_early_pipeline_stage_name) == ["resolve", "fusion"]
		and requests.late_stages.map(func(request): request.name) == ["final"]
	)


pure func test_call_resolution_is_owned_by_early_pipeline() -> Bool:
	requests = compile_stage_requests(
		["trait_resolve", "resolve"],
		Some("resolve"),
	)

	(
		requests.early_observations.map(
			core_early_pipeline_stage_name,
		) == ["trait_resolve", "resolve"]
		and requests.early_stop.map(core_early_pipeline_stage_name) == Some("resolve")
	)


pure func test_std_inline_and_tailrec_are_owned_by_early_pipeline() -> Bool:
	requests = compile_stage_requests(
		["resolve", "std_inline", "tailrec"],
		Some("tailrec"),
	)

	(
		requests.early_observations.map(
			core_early_pipeline_stage_name,
		) == ["resolve", "std_inline", "tailrec"]
		and requests.early_stop.map(core_early_pipeline_stage_name) == Some("tailrec")
		and requests.late_stages.is_empty()
	)


pure func test_specialize_is_owned_by_late_core() -> Bool:
	requests = compile_stage_requests(["specialize"], Some("specialize"))

	(
		requests.late_stages.map(func(request): request.name) == ["specialize"]
		and requests.late_stages.map(func(request): request.action) == [ObserveAndStopLateCoreStage]
	)


pure func test_early_stages_are_not_duplicated_across_later_boundaries() -> Bool:
	requests = compile_stage_requests(
		["debug", "desugar", "synth", "match"],
		Some("match"),
	)

	(
		requests.early_observations.map(
			core_early_pipeline_stage_name,
		) == ["debug", "desugar", "synth", "match"]
		and requests.early_stop.map(core_early_pipeline_stage_name) == Some("match")
		and requests.late_stages.length() == 0
	)


tests: TestSuite = {
	description = "Blorp compiler CLI stage requests",
	tests = [
		(
			"stage requests preserve boundary and canonical order",
			test_stage_requests_preserve_boundary_and_canonical_order,
		),
		(
			"one late stage can be observed and stopped",
			test_stage_request_can_observe_and_stop_once,
		),
		("fusion is owned by early pipeline", test_fusion_is_owned_by_early_pipeline),
		(
			"call resolution is owned by early pipeline",
			test_call_resolution_is_owned_by_early_pipeline,
		),
		(
			"std inline and tailrec are owned by early pipeline",
			test_std_inline_and_tailrec_are_owned_by_early_pipeline,
		),
		("specialize is owned by late Core", test_specialize_is_owned_by_late_core),
		(
			"early stages are not duplicated across later boundaries",
			test_early_stages_are_not_duplicated_across_later_boundaries,
		),
	]
}
