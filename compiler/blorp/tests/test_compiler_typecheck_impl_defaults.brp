import:
	../src/stage_01_file_io/source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_03_parse/parsed_ast:
		ParsedDecl(ImplParsedDecl, RecordParsedDecl, TraitParsedDecl),
		ParsedExpr(ParsedIntLiteralExpr, ParsedNameExpr, ParsedStringLiteralExpr),
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder),
		ParsedProgram,
		ParsedStringLiteralForm(ParsedPlainStringLiteral),
		ParsedTraitMethodDecl,
		ParsedTypeExpr(ParsedNamedType),
		parsed_identifier,
	../src/stage_06_typecheck/headers/type_headers: typecheck_register_program_type_decls
	../src/stage_06_typecheck/typecheck_decl:
		TypedDecl(TypedImplDecl),
		typecheck_check_program_bodies,
		typecheck_materialize_program_bodies,
		typecheck_prescan_program,
		typecheck_register_program_impl_decls,
		typecheck_register_program_signature_decls,
	../src/stage_06_typecheck/typecheck_state:
		CompilerTypecheckState,
		TYPECHECK_USER_ORIGIN,
		compiler_typecheck_state_for_origin,
	test: TestSuite


pure func source_file_named(module_name: String) -> CompilerSourceFile:
	compiler_source_file(module_name + ".brp", module_name, "func main(): 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file_named("impl_defaults")
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], source_span())


pure func int_type() -> ParsedTypeExpr:
	named_type("Int")


pure func string_type() -> ParsedTypeExpr:
	named_type("String")


pure func int_expr() -> ParsedExpr:
	ParsedIntLiteralExpr("1", source_span())


pure func string_expr() -> ParsedExpr:
	ParsedStringLiteralExpr("text", ParsedPlainStringLiteral, source_span())


pure func name_expr(name: String) -> ParsedExpr:
	ParsedNameExpr(ident(name))


pure func named_param(name: String, type_expr: ParsedTypeExpr) -> ParsedParam:
	{
		binder = ParsedParamNameBinder(ident(name)),
		type_expr = Some(type_expr),
		span = source_span()
	}


pure func function_decl_with_body(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: ParsedExpr,
	is_pure: Bool,
) -> ParsedFunctionDecl:
	{
		name = ident(name),
		keyword_span = Some(source_span()),
		type_params = [],
		params = params,
		return_type = return_type,
		dim_constraints = [],
		body = Some(body),
		is_pure = is_pure,
		annotations = [],
		doc = None,
		span = source_span()
	}


pure func record_decl(name: String) -> ParsedDecl:
	RecordParsedDecl({
		name = ident(name),
		type_params = [],
		fields = [],
		is_struct = False,
		doc = None,
		span = source_span(),
	})


pure func trait_method_decl_with_default_body(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	is_pure: Bool,
	body: ParsedExpr,
) -> ParsedTraitMethodDecl:
	{
		name = ident(name),
		params = params,
		return_type = return_type,
		body = Some(body),
		is_pure = is_pure,
		span = source_span()
	}


pure func trait_decl_with_methods(name: String, methods: List[ParsedTraitMethodDecl]) -> ParsedDecl:
	TraitParsedDecl({
		name = ident(name),
		type_params = [],
		supertraits = [],
		methods = methods,
		doc = None,
		span = source_span(),
	})


pure func impl_decl_with_methods(
	trait_name: String,
	for_type: ParsedTypeExpr,
	methods: List[ParsedFunctionDecl],
) -> ParsedDecl:
	ImplParsedDecl({
		trait_name = ident(trait_name),
		for_type = for_type,
		methods = methods,
		doc = None,
		span = source_span(),
	})


pure func impl_decl(trait_name: String, for_type: ParsedTypeExpr) -> ParsedDecl:
	impl_decl_with_methods(trait_name, for_type, [])


pure func program(decls: List[ParsedDecl]) -> ParsedProgram:
	{
		source = source_file_named("impl_defaults"),
		decls = decls,
		diagnostics = []
	}


pure func index_program_headers(source_program: ParsedProgram) -> CompilerTypecheckState:
	typecheck_register_program_impl_decls(
		typecheck_register_program_signature_decls(
			typecheck_register_program_type_decls(
				typecheck_prescan_program(
					compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)


func test_default_impl_method_body_is_checked() -> Bool:
	source_program = program([
		trait_decl_with_methods(
			"CheckpointDisplay",
			[
				trait_method_decl_with_default_body(
					"show",
					[named_param("value", named_type("Self"))],
					Some(string_type()),
					True,
					int_expr(),
				),
			],
		),
		record_decl("CheckpointWidget"),
		impl_decl("CheckpointDisplay", named_type("CheckpointWidget")),
	])
	state = typecheck_check_program_bodies(index_program_headers(source_program), source_program)

	(
		state.errors.length() == 1
		and state.errors
			.get_or(0, "")
			.contains("Function 'show' returns wrong type")
	)


func test_explicit_impl_method_suppresses_default_body() -> Bool:
	source_program = program([
		trait_decl_with_methods(
			"CheckpointDisplay",
			[
				trait_method_decl_with_default_body(
					"show",
					[named_param("value", named_type("Self"))],
					Some(string_type()),
					True,
					int_expr(),
				),
			],
		),
		record_decl("CheckpointWidget"),
		impl_decl_with_methods(
			"CheckpointDisplay",
			named_type("CheckpointWidget"),
			[
				function_decl_with_body(
					"show",
					[named_param("value", named_type("CheckpointWidget"))],
					Some(string_type()),
					string_expr(),
					True,
				),
			],
		),
	])
	state = typecheck_check_program_bodies(index_program_headers(source_program), source_program)

	state.errors.length() == 0


func test_default_impl_method_resolves_self_signature() -> Bool:
	source_program = program([
		trait_decl_with_methods(
			"CheckpointIdentity",
			[
				trait_method_decl_with_default_body(
					"same",
					[named_param("value", named_type("Self"))],
					Some(named_type("Self")),
					True,
					name_expr("value"),
				),
			],
		),
		record_decl("CheckpointWidget"),
		impl_decl("CheckpointIdentity", named_type("CheckpointWidget")),
	])
	state = typecheck_check_program_bodies(index_program_headers(source_program), source_program)

	state.errors.length() == 0


func test_default_impl_method_is_materialized() -> Bool:
	source_program = program([
		trait_decl_with_methods(
			"CheckpointIdentity",
			[
				trait_method_decl_with_default_body(
					"same",
					[named_param("value", named_type("Self"))],
					Some(named_type("Self")),
					True,
					name_expr("value"),
				),
			],
		),
		record_decl("CheckpointWidget"),
		impl_decl("CheckpointIdentity", named_type("CheckpointWidget")),
	])
	result = typecheck_materialize_program_bodies(
		index_program_headers(source_program),
		source_program,
	)

	if result.state.errors.length() > 0:
		False
	else:
		var found: Bool = False

		for decl in result.program.decls:
			match decl:
				TypedImplDecl(info):
					match info.methods.get(0):
						Some(method):
							if (
								info.decl.trait_name.text == "CheckpointIdentity"
								and info.methods.length() == 1
								and method.decl.name.text == "same"
							):
								found = True
								break
						None:
							void
				_:
					void

		found


tests: TestSuite = {
	description = "Compiler typecheck impl default methods",
	tests = [
		("default impl method body is checked", test_default_impl_method_body_is_checked),
		(
			"explicit impl method suppresses default body",
			test_explicit_impl_method_suppresses_default_body,
		),
		(
			"default impl method resolves self signature",
			test_default_impl_method_resolves_self_signature,
		),
		("default impl method is materialized", test_default_impl_method_is_materialized),
	]
}
