pure func overload_entry(
	def_id: Int,
	first_type: CompilerType,
	return_type: CompilerType,
) -> CompilerOverloadEntry:
	{
		def_id = def_id,
		func_type = CompilerFunctionType(True, [first_type], return_type),
		type_params = [],
		param_names = [Some("value")],
		purity = CompilerPure,
		origin = CompilerUserDefinedFunc,
		resource_args = CompilerRejectResourceArgs,
		module_path = None,
		dim_constraints = [],
		loop_producer = None,
		debug_only = False
	}


pure func two_arg_overload_entry(
	def_id: Int,
	first_type: CompilerType,
	second_type: CompilerType,
	return_type: CompilerType,
) -> CompilerOverloadEntry:
	{
		def_id = def_id,
		func_type = CompilerFunctionType(
			True,
			[first_type, second_type],
			return_type,
		),
		type_params = [],
		param_names = [Some("left"), Some("right")],
		purity = CompilerPure,
		origin = CompilerUserDefinedFunc,
		resource_args = CompilerRejectResourceArgs,
		module_path = None,
		dim_constraints = [],
		loop_producer = None,
		debug_only = False
	}


pure func generic_overload_entry(
	def_id: Int,
	param_type: CompilerType,
	return_type: CompilerType,
	type_param_name: String,
) -> CompilerOverloadEntry:
	{
		def_id = def_id,
		func_type = CompilerFunctionType(True, [param_type], return_type),
		type_params = [compiler_make_bound_type_param(type_param_name, [])],
		param_names = [Some("value")],
		purity = CompilerPure,
		origin = CompilerUserDefinedFunc,
		resource_args = CompilerRejectResourceArgs,
		module_path = None,
		dim_constraints = [],
		loop_producer = None,
		debug_only = False
	}


func test_scope_lookup_and_shadowing() -> Bool:
	base: CompilerEnv = compiler_env_empty()
	with_x = compiler_env_add_var(base, "x", compiler_type_int())
	inner = compiler_env_push_scope(with_x)
	inner_with_x = compiler_env_add_var_with_details(
		inner,
		"x",
		compiler_type_string(),
		None,
		CompilerImmutableBinding,
		CompilerFuncParam,
		compiler_unrefined_binding(),
	)
	with_resource = compiler_env_add_var_with_details(
		inner_with_x,
		"reader_line",
		compiler_type_string(),
		None,
		CompilerImmutableBinding,
		CompilerScopedResourceDerived,
		compiler_unrefined_binding(),
	)
	with_scoped_reader = compiler_env_add_var_with_details(
		with_resource,
		"reader",
		compiler_type_string(),
		None,
		CompilerImmutableBinding,
		CompilerScopedResource,
		compiler_unrefined_binding(),
	)
	with_unavailable_reader = compiler_env_add_var_with_details(
		with_scoped_reader,
		"parent_reader",
		compiler_type_string(),
		None,
		CompilerImmutableBinding,
		CompilerScopedResourceUnavailable("child"),
		compiler_unrefined_binding(),
	)
	outer_lookup = compiler_env_lookup_with_scope_depth(inner, "x")
	shadow_lookup = compiler_env_lookup_with_scope_depth(with_unavailable_reader, "x")

	match (
		compiler_env_get_var_type(with_unavailable_reader, "x"),
		compiler_env_lookup_in_current_scope(with_unavailable_reader, "x"),
		outer_lookup,
		shadow_lookup,
	):
		(Some(shadow_type), Some(current_symbol), Some(outer), Some(shadow)):
			(
				compiler_types_equal(shadow_type, compiler_type_string())
				and current_symbol.name == "x"
				and compiler_env_is_func_param(with_unavailable_reader, "x")
				and compiler_env_is_scoped_resource_related_var(
					with_unavailable_reader,
					"reader_line",
				)
				and compiler_env_is_scoped_resource_derived_var(
					with_unavailable_reader,
					"reader_line",
				)
				and compiler_env_is_scoped_resource_related_var(with_unavailable_reader, "reader")
				and compiler_env_is_scoped_resource_var(with_unavailable_reader, "reader")
				and compiler_env_is_scoped_resource_related_var(
					with_unavailable_reader,
					"parent_reader",
				)
				and compiler_env_scoped_resource_unavailable_owner(
					with_unavailable_reader,
					"parent_reader",
				) == Some("child")
				and compiler_env_get_var_type(base, "x").is_none()
				and outer.scope_depth == 1
				and compiler_env_lookup_is_outermost_scope(inner, outer)
				and shadow.scope_depth == 0
				and not compiler_env_lookup_is_outermost_scope(with_resource, shadow)
			)
		_:
			False


func test_same_scope_lookup_preserves_latest_symbol_and_full_history() -> Bool:
	base = compiler_env_empty()
	with_int = compiler_env_add_var(base, "value", compiler_type_int())
	with_string = compiler_env_add_var(with_int, "value", compiler_type_string())

	match compiler_env_lookup(with_string, "value"):
		Some(symbol):
			symbol.name == "value" and compiler_types_equal(
				compiler_env_get_var_type(with_string, "value").get_or(compiler_type_int()),
				compiler_type_string(),
			) and compiler_env_symbols_named(with_string, "value").length() == 2
		None:
			False


func test_symbol_history_preserves_scope_and_declaration_order() -> Bool:
	outer = compiler_env_add_var(compiler_env_empty(), "value", compiler_type_int())
	inner = compiler_env_add_var(
		compiler_env_add_var(compiler_env_push_scope(outer), "value", compiler_type_string()),
		"value",
		compiler_type_bool(),
	)
	history = compiler_env_symbols_named(inner, "value")

	match (history.get(0), history.get(1), history.get(2)):
		(Some(first), Some(second), Some(third)):
			match (first.kind, second.kind, third.kind):
				(CompilerVarSymbolKind(first_var), CompilerVarSymbolKind(second_var), CompilerVarSymbolKind(third_var)):
					(
						history.length() == 3
						and compiler_types_equal(first_var.var_type, compiler_type_bool())
						and compiler_types_equal(second_var.var_type, compiler_type_string())
						and compiler_types_equal(third_var.var_type, compiler_type_int())
					)
				_:
					False
		_:
			False


func test_constructor_lookup_preserves_same_name_candidates() -> Bool:
	first = compiler_env_add_type(
		compiler_env_empty(),
		"FirstChoice",
		[],
		[
			{
				name = "Shared",
				fields = [compiler_type_int()],
				tag = 0
			},
		],
		CompilerTypeUnion,
		False,
		True,
	)
	second = compiler_env_add_type(
		first,
		"SecondChoice",
		[],
		[
			{
				name = "Shared",
				fields = [compiler_type_string()],
				tag = 0
			},
		],
		CompilerTypeUnion,
		False,
		True,
	)
	constructors = compiler_env_get_constructors(second, "Shared")

	match (constructors.get(0), constructors.get(1)):
		(Some(latest), Some(earlier)):
			(
				constructors.length() == 2
				and latest.parent_type == "SecondChoice"
				and earlier.parent_type == "FirstChoice"
			)
		_:
			False


func test_type_record_alias_and_nominal_dim_resolution() -> Bool:
	var env: CompilerEnv = compiler_env_empty()
	env = compiler_env_add_type(
		env,
		"Option",
		["T"],
		[
			{
				name = "Some",
				fields = [CompilerTypeVar("T")],
				tag = 0
			},
			{
				name = "None",
				fields = [],
				tag = 1
			},
		],
		CompilerTypeUnion,
		False,
		True,
	)
	env = compiler_env_add_type(env, "File", [], [], CompilerTypeResource, True, False)
	env = compiler_env_add_record(
		env,
		"Point",
		[],
		[
			{
				name = "x",
				field_type = compiler_type_float()
			},
			{
				name = "y",
				field_type = compiler_type_float()
			},
		],
		True,
		False,
	)
	env = compiler_env_add_alias(env, "Str", [], compiler_type_string())
	env = compiler_env_add_alias(
		env,
		"FloatRow",
		["#N"],
		CompilerArrayType(compiler_type_float(), [CompilerTypeVar("#N")]),
	)
	parsed: CompilerType = CompilerArrayType(
		CompilerNamedType("FloatRow", []),
		[CompilerConstIntType(8)],
	)
	nominal: CompilerType = compiler_env_disambiguate_nominal_dim_application(env, parsed)
	resolved: CompilerType = compiler_env_resolve_alias(env, nominal)

	match (
		compiler_env_get_type_decl(env, "Option"),
		compiler_env_get_constructor(env, "Some"),
		compiler_env_get_record(env, "Point"),
		compiler_env_get_alias(env, "Str"),
	):
		(Some((type_params, variants)), Some(ctor), Some((_, record_fields)), Some((_, alias_target))):
			(
				type_params == ["T"]
				and variants.length() == 2
				and ctor.parent_type == "Option"
				and ctor.type_params == ["T"]
				and ctor.field_types.length() == 1
				and ctor.tag == 0
				and compiler_env_get_type_kind(env, "File") == Some(CompilerTypeResource)
				and record_fields.length() == 2
				and compiler_env_find_records_with_fields(
					env,
					["y", "x"],
				) == ["Point"]
				and compiler_types_equal(alias_target, compiler_type_string())
				and compiler_types_equal(
					resolved,
					CompilerArrayType(compiler_type_float(), [CompilerConstIntType(8)]),
				)
			)
		_:
			False


func test_nested_generic_alias_resolution() -> Bool:
	var env = compiler_env_add_alias(
		compiler_env_empty(),
		"Check",
		["A", "E"],
		CompilerFunctionType(
			True,
			[CompilerTypeVar("A")],
			CompilerNamedType("Option", [CompilerTypeVar("E")]),
		),
	)
	env = compiler_env_add_alias(
		env,
		"InvalidCheck",
		["A"],
		CompilerNamedType(
			"Check",
			[CompilerTypeVar("A"), CompilerNamedType("Invalid", [])],
		),
	)
	resolved = compiler_env_resolve_alias(
		env,
		CompilerNamedType("InvalidCheck", [compiler_type_int()]),
	)

	compiler_types_equal(
		resolved,
		CompilerFunctionType(
			True,
			[compiler_type_int()],
			CompilerNamedType("Option", [CompilerNamedType("Invalid", [])]),
		),
	)


func test_alias_resolution_terminates_cycles() -> Bool:
	var env = compiler_env_add_alias(
		compiler_env_empty(),
		"FirstAlias",
		[],
		CompilerNamedType("SecondAlias", []),
	)
	env = compiler_env_add_alias(
		env,
		"SecondAlias",
		[],
		CompilerNamedType("FirstAlias", []),
	)

	compiler_types_equal(
		compiler_env_resolve_alias(
			env,
			CompilerNamedType("FirstAlias", []),
		),
		CompilerNamedType("FirstAlias", []),
	)


func test_type_registration_uses_reserved_constructor_ids() -> Bool:
	base = compiler_env_empty()
	env = compiler_env_add_type_with_constructor_ids(
		{ base | next_def_id = 43 },
		"Choice",
		[],
		[
			{
				name = "Left",
				fields = [compiler_type_int()],
				tag = 0
			},
			{
				name = "Right",
				fields = [compiler_type_int()],
				tag = 1
			},
		],
		CompilerTypeUnion,
		False,
		True,
		[Some(41), Some(42)],
	)

	match (compiler_env_get_constructor(env, "Left"), compiler_env_get_constructor(env, "Right")):
		(Some(left), Some(right)):
			left.constructor_id == 41 and right.constructor_id == 42 and env.next_def_id == 43
		_:
			False


func test_traits_impls_overloads_and_ufcs() -> Bool:
	show_method = compiler_trait_method_sig(
		"show",
		[CompilerTypeVar("Self")],
		compiler_type_string(),
		True,
	)
	var env: CompilerEnv = compiler_env_empty()
	env = compiler_env_add_trait(
		env,
		compiler_trait_def(1, "Stringable", [], [show_method]),
	)
	env = compiler_env_add_trait(
		env,
		compiler_trait_def(2, "Display", ["Stringable"], []),
	)
	env = compiler_env_set_type_param_bounds(
		env,
		[compiler_make_bound_type_param("T", ["Display"])],
	)
	env = compiler_env_add_trait_function(env, "show", "Stringable")
	env = compiler_env_add_impl(
		env,
		compiler_impl_instance(3, "Display", compiler_type_string(), [], False),
	)
	conflict = compiler_env_find_conflicting_impl(
		env,
		compiler_impl_instance(4, "Display", compiler_type_string(), [], False),
	)
	int_entry = overload_entry(10, compiler_type_int(), compiler_type_string())
	string_entry = overload_entry(11, compiler_type_string(), compiler_type_string())
	int_string_entry = two_arg_overload_entry(
		13,
		compiler_type_int(),
		compiler_type_string(),
		compiler_type_string(),
	)
	int_bool_entry = two_arg_overload_entry(
		14,
		compiler_type_int(),
		compiler_type_bool(),
		compiler_type_bool(),
	)
	env = compiler_env_add_overload(env, "show", int_entry)
	env = compiler_env_add_overload(env, "show", string_entry)
	selected_two_arg = compiler_env_select_overload_for_args(
		[int_string_entry, int_bool_entry],
		[compiler_type_int(), compiler_type_bool()],
	)
	windowed_entry: CompilerOverloadEntry = {
		def_id = 12,
		func_type = string_entry.func_type,
		type_params = string_entry.type_params,
		param_names = string_entry.param_names,
		purity = string_entry.purity,
		origin = string_entry.origin,
		resource_args = string_entry.resource_args,
		module_path = string_entry.module_path,
		dim_constraints = string_entry.dim_constraints,
		loop_producer = Some(CompilerLoopProducerWindows),
		debug_only = string_entry.debug_only
	}
	env = compiler_env_add_ufcs_method(env, "windowed", windowed_entry)
	env = compiler_env_add_func(
		env,
		"local_helper",
		CompilerFunctionType(True, [], compiler_type_bool()),
		CompilerPure,
		CompilerUserDefinedFunc,
	)
	declaring_methods = compiler_env_trait_methods_with_declaring_trait(env, "Display")
	env = compiler_env_add_func(
		env,
		"print",
		CompilerFunctionType(False, [compiler_type_string()], compiler_type_int()),
		CompilerImpure,
		CompilerBuiltinFunc,
	)

	match (
		conflict,
		compiler_env_resolve_overload(env, "show", compiler_type_string()),
		compiler_env_find_overload_by_def_id(env, 10),
		compiler_env_lookup_ufcs_methods(env, "windowed", compiler_type_string()).get(0),
	):
		(Some(existing), Some(resolved_overload), Some(found_overload), Some(ufcs_entry)):
			match compiler_env_get_func_info(env, "local_helper"):
				Some((_, _, purity)):
					generic_entry: CompilerOverloadEntry = {
						def_id = int_entry.def_id,
						func_type = int_entry.func_type,
						type_params = [compiler_make_bound_type_param("U", ["Stringable"])],
						param_names = int_entry.param_names,
						purity = int_entry.purity,
						origin = int_entry.origin,
						resource_args = int_entry.resource_args,
						module_path = int_entry.module_path,
						dim_constraints = int_entry.dim_constraints,
						loop_producer = int_entry.loop_producer,
						debug_only = int_entry.debug_only
					}

					(
						existing.def_id == 3
						and resolved_overload.def_id == 11
						and found_overload.def_id == 10
						and match selected_two_arg:
							Some(entry):
								entry.def_id == 14
							None:
								False
						and ufcs_entry.def_id == 12
						and compiler_env_has_ufcs_method(env, "windowed")
						and compiler_env_get_overloads(env, "show").length() == 2
						and compiler_env_trait_has_supertrait(env, "Display", "Stringable")
						and compiler_env_trait_method_names_transitive(env, "Display") == ["show"]
						and declaring_methods.length() == 1
						and match declaring_methods.get(0):
							Some(pair):
								pair[0] == "show" and pair[1] == "Stringable"
							None:
								False
						and compiler_env_has_trait_bound_transitive(env, "T", "Stringable")
						and compiler_env_trait_function_collision(
							env,
							"show",
							"OtherTrait",
						) == Some("Stringable")
						and compiler_env_get_function_trait(env, "show") == Some("Stringable")
						and compiler_env_resolve_trait_obligation(
							env,
							compiler_trait_obligation(compiler_type_string(), "Stringable"),
						) == CompilerTraitObligationSatisfied
						and compiler_env_resolve_trait_obligation(
							env,
							compiler_trait_obligation(CompilerTypeVar("T"), "Stringable"),
						) == CompilerTraitObligationSatisfied
						and compiler_env_resolve_trait_obligation(
							env,
							compiler_trait_obligation(CompilerMetaType(1), "Stringable"),
						) == CompilerTraitObligationDeferred
						and compiler_env_resolve_trait_obligation(
							env,
							compiler_trait_obligation(compiler_type_int(), "Stringable"),
						) == CompilerTraitObligationUnsatisfied
						and compiler_overload_type_param_names(generic_entry) == ["U"]
						and purity == CompilerPure
						and compiler_env_is_local_func(env, "local_helper")
						and not compiler_env_is_local_func(env, "print")
					)
				None:
					False
		_:
			False


func test_empty_type_param_extension_preserves_environment() -> Bool:
	extended = compiler_env_extend_type_param_bounds(
		compiler_env_set_type_param_bounds(
			compiler_env_empty(),
			[compiler_make_bound_type_param("T", ["Display"])],
		),
		[],
	)

	compiler_env_has_trait_bound_transitive(extended, "T", "Display")


func test_resolve_self_returns_owned_types() -> Bool:
	concrete = CompilerNamedType("Widget", [])
	source = CompilerFunctionType(
		True,
		[CompilerSelfType, CompilerArrayType(CompilerSelfType, [CompilerConstIntType(2)])],
		CompilerSelfType,
	)
	resolved = compiler_resolve_self(compiler_type_copy(concrete), source)
	copied = compiler_type_copy(resolved)
	expected = CompilerFunctionType(
		True,
		[CompilerNamedType("Widget", []), CompilerArrayType(
				CompilerNamedType("Widget", []),
				[CompilerConstIntType(2)],
			)],
		CompilerNamedType(
			"Widget",
			[],
		),
	)

	compiler_types_equal(
		concrete,
		CompilerNamedType("Widget", []),
	) and compiler_types_equal(resolved, expected) and compiler_types_equal(copied, expected)


func test_generic_impl_satisfies_concrete_trait_obligation() -> Bool:
	var env: CompilerEnv = compiler_env_empty()
	env = compiler_env_add_trait(
		env,
		compiler_trait_def(40, "Printable", [], []),
	)
	env = compiler_env_add_impl(
		env,
		compiler_impl_instance(
			41,
			"Printable",
			CompilerNamedType("Box", [CompilerNamedType("T", [])]),
			[compiler_make_bound_type_param("T", [])],
			False,
		),
	)

	compiler_env_resolve_trait_obligation(
		env,
		compiler_trait_obligation(
			CompilerNamedType("Box", [compiler_type_int()]),
			"Printable",
		),
	) == CompilerTraitObligationSatisfied and compiler_env_resolve_trait_obligation(
		env,
		compiler_trait_obligation(
			CompilerNamedType("Other", [compiler_type_int()]),
			"Printable",
		),
	) == CompilerTraitObligationUnsatisfied


func test_overload_ranking_prefers_concrete_over_generic() -> Bool:
	generic_entry = generic_overload_entry(60, CompilerTypeVar("T"), compiler_type_string(), "T")
	int_entry = overload_entry(61, compiler_type_int(), compiler_type_int())
	env = compiler_env_add_overload(
		compiler_env_add_overload(compiler_env_empty(), "rank", generic_entry),
		"rank",
		int_entry,
	)

	match (compiler_env_select_overload_for_args(
			compiler_env_get_overloads(env, "rank"),
			[compiler_type_int()],
		), compiler_env_resolve_overload(env, "rank", compiler_type_int())):
		(Some(selected), Some(resolved)):
			selected.def_id == 61 and resolved.def_id == 61
		_:
			False


func test_overload_matching_handles_generic_callback_parameters() -> Bool:
	generic_callback_entry: CompilerOverloadEntry = {
		def_id = 62,
		func_type = CompilerFunctionType(
			True,
			[
				CompilerNamedType("List", [CompilerTypeVar("T")]),
				CompilerFunctionType(True, [CompilerTypeVar("T")], CompilerTypeVar("U")),
			],
			CompilerNamedType(
				"List",
				[CompilerTypeVar("U")],
			),
		),
		type_params = [
			compiler_make_bound_type_param("T", []),
			compiler_make_bound_type_param("U", []),
		],
		param_names = [Some("values"), Some("mapper")],
		purity = CompilerPure,
		origin = CompilerUserDefinedFunc,
		resource_args = CompilerRejectResourceArgs,
		module_path = None,
		dim_constraints = [],
		loop_producer = None,
		debug_only = False
	}
	decoy = two_arg_overload_entry(
		63,
		compiler_type_string(),
		compiler_type_string(),
		compiler_type_string(),
	)

	pure_selection = compiler_env_select_overload_for_args(
		[generic_callback_entry, decoy],
		[
			CompilerNamedType("List", [compiler_type_int()]),
			CompilerFunctionType(True, [compiler_type_int()], compiler_type_string()),
		],
	)
	impure_selection = compiler_env_select_overload_for_args(
		[generic_callback_entry],
		[
			CompilerNamedType("List", [compiler_type_int()]),
			CompilerFunctionType(False, [compiler_type_int()], compiler_type_string()),
		],
	)

	match pure_selection:
		Some(selected):
			selected.def_id == 62 and impure_selection.is_none()
		None:
			False


func test_overload_matching_rejects_narrower_higher_order_callback() -> Bool:
	impure_callback = CompilerFunctionType(False, [compiler_type_int()], compiler_type_int())
	pure_callback = CompilerFunctionType(True, [compiler_type_int()], compiler_type_int())
	expected_higher_order = CompilerFunctionType(False, [impure_callback], compiler_type_int())
	narrower_actual = CompilerFunctionType(True, [pure_callback], compiler_type_int())
	entry = two_arg_overload_entry(
		64,
		compiler_type_int(),
		expected_higher_order,
		compiler_type_int(),
	)

	compiler_env_select_overload_for_args(
		[entry],
		[compiler_type_int(), narrower_actual],
	).is_none()


func test_generic_impl_requires_concrete_type_to_satisfy_bounds() -> Bool:
	var env: CompilerEnv = compiler_env_empty()
	env = compiler_env_add_trait(
		env,
		compiler_trait_def(42, "Showable", [], []),
	)
	env = compiler_env_add_trait(
		env,
		compiler_trait_def(43, "Printable", [], []),
	)
	env = compiler_env_add_impl(
		env,
		compiler_impl_instance(44, "Showable", compiler_type_int(), [], False),
	)
	env = compiler_env_add_impl(
		env,
		compiler_impl_instance(
			45,
			"Printable",
			CompilerNamedType("Box", [CompilerNamedType("T", [])]),
			[compiler_make_bound_type_param("T", ["Showable"])],
			False,
		),
	)
	bounded_env = compiler_env_set_type_param_bounds(
		env,
		[compiler_make_bound_type_param("T", ["Showable"])],
	)

	compiler_env_resolve_trait_obligation(
		env,
		compiler_trait_obligation(
			CompilerNamedType("Box", [compiler_type_int()]),
			"Printable",
		),
	) == CompilerTraitObligationSatisfied and compiler_env_resolve_trait_obligation(
		env,
		compiler_trait_obligation(
			CompilerNamedType("Box", [compiler_type_string()]),
			"Printable",
		),
	) == CompilerTraitObligationUnsatisfied and compiler_env_resolve_trait_obligation(
		env,
		compiler_trait_obligation(
			CompilerNamedType("Box", [CompilerNamedType("T", [])]),
			"Printable",
		),
	) == CompilerTraitObligationUnsatisfied and compiler_env_resolve_trait_obligation(
		bounded_env,
		compiler_trait_obligation(
			CompilerNamedType("Box", [CompilerNamedType("T", [])]),
			"Printable",
		),
	) == CompilerTraitObligationSatisfied


func test_generic_impl_conflicts_with_specific_impl() -> Bool:
	generic_impl = compiler_impl_instance(
		50,
		"Printable",
		CompilerNamedType("Box", [CompilerNamedType("T", [])]),
		[compiler_make_bound_type_param("T", [])],
		False,
	)
	specific_impl = compiler_impl_instance(
		51,
		"Printable",
		CompilerNamedType("Box", [compiler_type_int()]),
		[],
		False,
	)
	env_with_generic = compiler_env_add_impl(compiler_env_empty(), generic_impl)
	env_with_specific = compiler_env_add_impl(compiler_env_empty(), specific_impl)

	match (
		compiler_env_find_conflicting_impl(env_with_generic, specific_impl),
		compiler_env_find_conflicting_impl(env_with_specific, generic_impl),
	):
		(Some(left_conflict), Some(right_conflict)):
			left_conflict.def_id == 50 and right_conflict.def_id == 51
		_:
			False


func test_callable_metadata_finds_impl_method_by_id() -> Bool:
	method = compiler_impl_method_info(
		"length",
		Some({
			callable_id = 73,
			module_path = "std/list",
		}),
		CompilerFunctionType(
			True,
			[CompilerNamedType("List", [CompilerTypeVar("T")])],
			compiler_type_int(),
		),
		[compiler_make_bound_type_param("T", [])],
		[Some("self")],
		CompilerPure,
		CompilerRejectResourceArgs,
		[],
		True,
	)
	impl = compiler_impl_instance_with_methods(
		72,
		"HasLength",
		CompilerNamedType("List", [CompilerTypeVar("T")]),
		[compiler_make_bound_type_param("T", [])],
		[method],
		False,
	)
	env = compiler_env_add_impl(compiler_env_empty(), impl)

	match compiler_env_find_callable_type_params_by_def_id(env, 73):
		Some([type_param]):
			(
				type_param.name == "T"
				and compiler_env_find_callable_debug_only_by_def_id(env, 73) == Some(True)
			)
		_:
			False


func test_module_function_lookup_uses_module_path() -> Bool:
	local_func = compiler_func_symbol(
		1,
		CompilerFunctionType(True, [compiler_type_int()], compiler_type_int()),
		[],
		[Some("value")],
		CompilerPure,
		CompilerUserDefinedFunc,
		CompilerRejectResourceArgs,
		None,
		[],
		None,
		False,
	)
	imported_func = compiler_func_symbol(
		2,
		CompilerFunctionType(True, [compiler_type_string()], compiler_type_string()),
		[],
		[Some("value")],
		CompilerPure,
		CompilerUserDefinedFunc,
		CompilerRejectResourceArgs,
		Some("std/text"),
		[],
		None,
		False,
	)
	env = compiler_env_add_func_with_info(
		compiler_env_add_func_with_info(compiler_env_empty(), "trim", local_func),
		"trim",
		imported_func,
	)

	match compiler_env_get_module_func_symbol(env, "std/text", "trim"):
		Some(function_symbol):
			(
				function_symbol.callable_id == 2
				and compiler_env_get_module_func_symbol(env, "other", "trim").is_none()
				and compiler_env_get_module_func_symbol(env, "std/text", "missing").is_none()
			)
		None:
			False


func test_module_ufcs_lookup_filters_module_and_receiver() -> Bool:
	string_entry = { overload_entry(20, compiler_type_string(), compiler_type_int()) |
		module_path = Some("std/text")
	}
	int_entry = { overload_entry(21, compiler_type_int(), compiler_type_float()) |
		module_path = Some("std/text")
	}
	other_module_entry = { overload_entry(22, compiler_type_string(), compiler_type_bool()) |
		module_path = Some("other")
	}
	env = compiler_env_add_ufcs_method(
		compiler_env_add_ufcs_method(
			compiler_env_add_ufcs_method(compiler_env_empty(), "size", string_entry),
			"size",
			int_entry,
		),
		"size",
		other_module_entry,
	)
	matches = compiler_env_lookup_module_ufcs_methods(
		env,
		"std/text",
		"size",
		compiler_type_string(),
	)
	wrong_receiver = compiler_env_lookup_module_ufcs_methods(
		env,
		"std/text",
		"size",
		compiler_type_bool(),
	)
	wrong_module = compiler_env_lookup_module_ufcs_methods(
		env,
		"missing",
		"size",
		compiler_type_string(),
	)

	match matches.get(0):
		Some(entry):
			(
				matches.length() == 1
				and entry.def_id == 20
				and wrong_receiver.length() == 0
				and wrong_module.length() == 0
			)
		None:
			False


func test_function_symbol_ufcs_lookup_filters_same_name_candidates() -> Bool:
	int_func = compiler_func_symbol(
		30,
		CompilerFunctionType(True, [compiler_type_int()], compiler_type_int()),
		[],
		[Some("value")],
		CompilerPure,
		CompilerUserDefinedFunc,
		CompilerRejectResourceArgs,
		Some("std/convert"),
		[],
		None,
		False,
	)
	string_func = compiler_func_symbol(
		31,
		CompilerFunctionType(True, [compiler_type_string()], compiler_type_string()),
		[],
		[Some("value")],
		CompilerPure,
		CompilerUserDefinedFunc,
		CompilerRejectResourceArgs,
		Some("std/convert"),
		[],
		None,
		False,
	)
	env = compiler_env_add_func_with_info(
		compiler_env_add_func_with_info(compiler_env_empty(), "convert", int_func),
		"convert",
		string_func,
	)
	matches = compiler_env_lookup_module_ufcs_methods(
		env,
		"std/convert",
		"convert",
		compiler_type_string(),
	)

	match matches.get(0):
		Some(entry):
			(
				matches.length() == 1
				and entry.def_id == 31
				and compiler_env_has_ufcs_method(env, "convert")
				and not compiler_env_has_ufcs_method(env, "missing")
			)
		None:
			False


func test_ufcs_resolution_prefers_concrete_receiver() -> Bool:
	generic_entry = generic_overload_entry(23, CompilerTypeVar("T"), compiler_type_string(), "T")
	concrete_entry = overload_entry(24, compiler_type_string(), compiler_type_int())
	env = compiler_env_add_ufcs_method(
		compiler_env_add_ufcs_method(compiler_env_empty(), "repeat", generic_entry),
		"repeat",
		concrete_entry,
	)

	match compiler_env_resolve_ufcs_method(env, "repeat", compiler_type_string()):
		Some(entry):
			entry.def_id == 24
		None:
			False


func test_module_variable_lookup_uses_module_path() -> Bool:
	env = compiler_env_add_var_with_module_details(
		compiler_env_add_var(compiler_env_empty(), "version", compiler_type_int()),
		"version",
		compiler_type_string(),
		Some(compiler_type_string()),
		CompilerImmutableBinding,
		CompilerLetBinding,
		compiler_unrefined_binding(),
		Some("std/build"),
	)

	match compiler_env_get_module_var_symbol(env, "std/build", "version"):
		Some(var_symbol):
			(
				compiler_types_equal(var_symbol.var_type, compiler_type_string())
				and compiler_env_get_module_var_symbol(env, "other", "version").is_none()
				and compiler_env_get_module_var_symbol(env, "std/build", "missing").is_none()
			)
		None:
			False


tests: TestSuite = {
	description = "Compiler env substrate",
	tests = [
		("scope lookup and shadowing", test_scope_lookup_and_shadowing),
		(
			"same-scope lookup preserves latest symbol and full history",
			test_same_scope_lookup_preserves_latest_symbol_and_full_history,
		),
		(
			"symbol history preserves scope and declaration order",
			test_symbol_history_preserves_scope_and_declaration_order,
		),
		(
			"constructor lookup preserves same-name candidates",
			test_constructor_lookup_preserves_same_name_candidates,
		),
		(
			"type record alias and nominal dim resolution",
			test_type_record_alias_and_nominal_dim_resolution,
		),
		(
			"type registration uses reserved constructor ids",
			test_type_registration_uses_reserved_constructor_ids,
		),
		("nested generic alias resolution", test_nested_generic_alias_resolution),
		("alias resolution terminates cycles", test_alias_resolution_terminates_cycles),
		("traits impls overloads and ufcs", test_traits_impls_overloads_and_ufcs),
		(
			"empty type parameter extension preserves environment",
			test_empty_type_param_extension_preserves_environment,
		),
		(
			"overload ranking prefers concrete over generic",
			test_overload_ranking_prefers_concrete_over_generic,
		),
		(
			"overload matching handles generic callback parameters",
			test_overload_matching_handles_generic_callback_parameters,
		),
		(
			"overload matching rejects narrower higher order callback",
			test_overload_matching_rejects_narrower_higher_order_callback,
		),
		("resolve self returns owned types", test_resolve_self_returns_owned_types),
		(
			"generic impl satisfies concrete trait obligation",
			test_generic_impl_satisfies_concrete_trait_obligation,
		),
		(
			"generic impl requires concrete type to satisfy bounds",
			test_generic_impl_requires_concrete_type_to_satisfy_bounds,
		),
		(
			"generic impl conflicts with specific impl",
			test_generic_impl_conflicts_with_specific_impl,
		),
		(
			"callable metadata finds impl method by id",
			test_callable_metadata_finds_impl_method_by_id,
		),
		("module function lookup uses module path", test_module_function_lookup_uses_module_path),
		(
			"module ufcs lookup filters module and receiver",
			test_module_ufcs_lookup_filters_module_and_receiver,
		),
		(
			"function-symbol ufcs lookup filters same-name candidates",
			test_function_symbol_ufcs_lookup_filters_same_name_candidates,
		),
		(
			"ufcs resolution prefers concrete receiver",
			test_ufcs_resolution_prefers_concrete_receiver,
		),
		("module variable lookup uses module path", test_module_variable_lookup_uses_module_path),
	]
}
