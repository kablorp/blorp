import:
	../src/stage_05_types/compiler_type:
		CompilerDimOp(CompilerDimAdd, CompilerDimDivide, CompilerDimMultiply, CompilerDimSubtract),
		CompilerType(
			CompilerArrayType,
			CompilerConstIntType,
			CompilerDimOpType,
			CompilerFunctionType,
			CompilerMetaType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerSelfType,
			CompilerTupleType,
			CompilerTypeVar,
			CompilerVarDimsType,
		),
		CompilerTypeSubstEntry,
		compiler_apply_subst,
		compiler_array_type,
		compiler_array_type_parts,
		compiler_canonical_module_type_name,
		compiler_collect_type_vars,
		compiler_display_type_name,
		compiler_function_type,
		compiler_is_any_float_type,
		compiler_is_any_integer_type,
		compiler_is_dim_type,
		compiler_is_global_abi_type_name,
		compiler_is_scalar_int_value_type,
		compiler_is_signed_integer_type,
		compiler_is_type_param_name,
		compiler_is_unsigned_integer_type,
		compiler_normalize_dim,
		compiler_normalize_type_name,
		compiler_occurs_in,
		compiler_scalar_int_value_type,
		compiler_strip_type_param_bounds,
		compiler_type_bool,
		compiler_type_char,
		compiler_type_contains_meta,
		compiler_type_float,
		compiler_type_int,
		compiler_type_list,
		compiler_type_string,
		compiler_type_subst_entry,
		compiler_type_to_string,
		compiler_type_void,
		compiler_types_compatible_with_params,
		compiler_types_equal,
		compiler_validate_array_dims,
	test: TestSuite


func test_type_to_string_simple() -> Bool:
	(
		compiler_type_to_string(compiler_type_int()) == "Int"
		and compiler_type_to_string(compiler_type_string()) == "String"
		and compiler_type_to_string(compiler_type_bool()) == "Bool"
		and compiler_type_to_string(compiler_type_void()) == "Void"
		and compiler_type_to_string(compiler_type_char()) == "Char"
	)


func test_type_to_string_parameterized_and_tuple() -> Bool:
	list_int: CompilerType = compiler_type_list(compiler_type_int())
	dict_type: CompilerType = CompilerNamedType(
		"Dict",
		[compiler_type_string(), compiler_type_int()],
	)
	tuple_type: CompilerType = CompilerTupleType([compiler_type_int(), compiler_type_string()])
	named_tuple: CompilerType = CompilerNamedType(
		"Tuple",
		[compiler_type_int(), compiler_type_string()],
	)

	(
		compiler_type_to_string(list_int) == "List[Int]"
		and compiler_type_to_string(dict_type) == "Dict[String, Int]"
		and compiler_type_to_string(tuple_type) == "(Int, String)"
		and compiler_type_to_string(named_tuple) == "(Int, String)"
	)


func test_type_to_string_function_array_and_dims() -> Bool:
	impure_func: CompilerType = compiler_function_type(
		False,
		[compiler_type_int(), compiler_type_string()],
		compiler_type_bool(),
	)
	pure_func: CompilerType = compiler_function_type(
		True,
		[compiler_type_int()],
		compiler_type_int(),
	)
	function_array: CompilerType = compiler_array_type(pure_func, [CompilerConstIntType(3)])
	dim_expr: CompilerType = CompilerDimOpType(
		CompilerDimAdd,
		CompilerTypeVar("#N"),
		CompilerConstIntType(1),
	)

	(
		compiler_type_to_string(impure_func) == "(Int, String) -> Bool"
		and compiler_type_to_string(pure_func) == "pure (Int) -> Int"
		and compiler_type_to_string(function_array) == "(pure (Int) -> Int)[#3]"
		and compiler_type_to_string(CompilerRangeType(CompilerConstIntType(3))) == "..#3"
		and compiler_type_to_string(CompilerVarDimsType("#Ds")) == "#Ds..."
		and compiler_type_to_string(dim_expr) == "#N + #1"
		and compiler_type_to_string(CompilerMetaType(4)) == "?m4"
		and compiler_type_to_string(CompilerSelfType) == "Self"
	)


func test_type_contains_meta_checks_nested_types() -> Bool:
	with_meta: CompilerType = compiler_function_type(
		True,
		[
			CompilerNamedType(
				"List",
				[CompilerArrayType(CompilerMetaType(1), [CompilerConstIntType(3)])],
			),
		],
		CompilerDimOpType(CompilerDimAdd, CompilerConstIntType(1), CompilerMetaType(2)),
	)
	without_meta: CompilerType = compiler_function_type(
		True,
		[
			CompilerNamedType(
				"List",
				[CompilerArrayType(compiler_type_int(), [CompilerConstIntType(3)])],
			),
		],
		CompilerDimOpType(CompilerDimAdd, CompilerConstIntType(1), CompilerConstIntType(2)),
	)

	compiler_type_contains_meta(with_meta) and not compiler_type_contains_meta(without_meta)


func test_canonical_type_display() -> Bool:
	canonical: String = compiler_canonical_module_type_name("pkg/math", "Point")

	canonical == "pkg/math::Point" and compiler_display_type_name(canonical) == "pkg/math.Point"


func test_std_duration_type_is_module_owned() -> Bool:
	(
		not compiler_is_global_abi_type_name("Duration")
		and compiler_canonical_module_type_name("std/units", "Duration") == "std/units::Duration"
	)


func test_types_equal_basic_and_tensor_normalization() -> Bool:
	vector: CompilerType = CompilerNamedType(
		"Vector",
		[compiler_type_float(), CompilerConstIntType(3)],
	)
	tensor: CompilerType = CompilerNamedType(
		"Tensor",
		[compiler_type_float(), CompilerConstIntType(3)],
	)
	matrix: CompilerType = CompilerNamedType(
		"Matrix",
		[compiler_type_float(), CompilerConstIntType(3)],
	)

	(
		compiler_types_equal(compiler_type_int(), compiler_type_int())
		and not compiler_types_equal(compiler_type_int(), compiler_type_string())
		and compiler_normalize_type_name("Vector") == "Tensor"
		and compiler_normalize_type_name("Matrix") == "Tensor"
		and compiler_types_equal(vector, tensor)
		and compiler_types_equal(vector, matrix)
	)


func test_types_equal_tuple_function_and_array_forms() -> Bool:
	tuple_type: CompilerType = CompilerTupleType([compiler_type_int(), compiler_type_string()])
	named_tuple: CompilerType = CompilerNamedType(
		"Tuple",
		[compiler_type_int(), compiler_type_string()],
	)
	pure_fn: CompilerType = CompilerFunctionType(True, [compiler_type_int()], compiler_type_bool())
	impure_fn: CompilerType = CompilerFunctionType(
		False,
		[compiler_type_int()],
		compiler_type_bool(),
	)
	array_type: CompilerType = CompilerArrayType(compiler_type_float(), [CompilerConstIntType(3)])
	tensor_type: CompilerType = CompilerNamedType(
		"Tensor",
		[compiler_type_float(), CompilerConstIntType(3)],
	)
	zero_dim_tensor: CompilerType = CompilerNamedType("Tensor", [compiler_type_int()])

	(
		compiler_types_equal(tuple_type, named_tuple)
		and compiler_types_equal(named_tuple, tuple_type)
		and compiler_types_equal(pure_fn, pure_fn)
		and not compiler_types_equal(pure_fn, impure_fn)
		and compiler_types_equal(array_type, tensor_type)
		and compiler_types_equal(zero_dim_tensor, compiler_type_int())
	)


func test_array_type_parts() -> Bool:
	array_type: CompilerType = CompilerArrayType(compiler_type_float(), [CompilerConstIntType(4)])
	tensor_type: CompilerType = CompilerNamedType(
		"Tensor",
		[compiler_type_float(), CompilerConstIntType(4)],
	)

	match (compiler_array_type_parts(array_type), compiler_array_type_parts(tensor_type)):
		(Some(array_parts), Some(tensor_parts)):
			compiler_types_equal(array_parts[0], tensor_parts[0]) and compiler_types_equal(
				array_parts[1].get_or(0, CompilerSelfType),
				tensor_parts[1].get_or(0, CompilerSelfType),
			)
		_:
			False


func test_numeric_predicates() -> Bool:
	(
		compiler_is_any_integer_type(compiler_type_int())
		and compiler_is_signed_integer_type(compiler_type_int())
		and compiler_is_unsigned_integer_type(CompilerNamedType("UInt32", []))
		and not compiler_is_unsigned_integer_type(compiler_type_int())
		and compiler_is_any_float_type(compiler_type_float())
		and compiler_is_any_float_type(CompilerNamedType("Float16", []))
		and not compiler_is_any_float_type(compiler_type_int())
	)


func test_dim_const_and_type_var_predicates() -> Bool:
	(
		compiler_is_dim_type(CompilerConstIntType(4))
		and compiler_is_dim_type(CompilerTypeVar("#N"))
		and not compiler_is_dim_type(CompilerTypeVar("T"))
	)


func test_dim_named_and_variadic_predicates() -> Bool:
	(
		compiler_is_dim_type(CompilerNamedType("#N", []))
		and compiler_is_dim_type(CompilerVarDimsType("#Ds"))
		and not compiler_is_dim_type(compiler_type_int())
	)


func test_dim_range_and_operation_predicates() -> Bool:
	(
		compiler_is_dim_type(CompilerRangeType(CompilerConstIntType(8)))
		and compiler_is_dim_type(
			CompilerDimOpType(
				CompilerDimMultiply,
				CompilerTypeVar("#M"),
				CompilerTypeVar("#N"),
			),
		)
	)


func test_scalar_dim_value_lifting() -> Bool:
	(
		compiler_types_equal(
			compiler_scalar_int_value_type(CompilerConstIntType(3)),
			compiler_type_int(),
		)
		and compiler_types_equal(
			compiler_scalar_int_value_type(CompilerRangeType(CompilerConstIntType(8))),
			compiler_type_int(),
		)
		and compiler_types_equal(
			compiler_scalar_int_value_type(CompilerTypeVar("#N")),
			compiler_type_int(),
		)
		and compiler_types_equal(
			compiler_scalar_int_value_type(CompilerNamedType("#N", [])),
			compiler_type_int(),
		)
		and compiler_types_equal(
			compiler_scalar_int_value_type(CompilerVarDimsType("#Ds")),
			CompilerVarDimsType("#Ds"),
		)
		and compiler_is_scalar_int_value_type(CompilerConstIntType(3))
		and not compiler_is_scalar_int_value_type(compiler_type_string())
	)


func test_collect_type_vars() -> Bool:
	typ: CompilerType = CompilerFunctionType(
		True,
		[
			CompilerTypeVar("T"),
			CompilerNamedType("U", []),
			CompilerArrayType(compiler_type_int(), [CompilerTypeVar("#N")]),
		],
		CompilerTupleType([CompilerVarDimsType("#Ds"), compiler_type_string()]),
	)
	vars: List[String] = compiler_collect_type_vars(typ)

	(
		vars.contains("T")
		and vars.contains("U")
		and vars.contains("#N")
		and vars.contains("#Ds")
		and vars.length() == 4
	)


func test_type_param_name_helpers() -> Bool:
	(
		compiler_strip_type_param_bounds("T") == "T"
		and compiler_strip_type_param_bounds("T:Stringable") == "T"
		and compiler_strip_type_param_bounds("T:Stringable+Showable") == "T"
		and compiler_is_type_param_name("T")
		and compiler_is_type_param_name("T:Stringable")
		and not compiler_is_type_param_name("Text")
	)


func test_apply_subst_basic_and_nested() -> Bool:
	subst: List[CompilerTypeSubstEntry] = [compiler_type_subst_entry("T", compiler_type_int())]
	direct: CompilerType = compiler_apply_subst(subst, CompilerTypeVar("T"))
	unchanged: CompilerType = compiler_apply_subst(subst, CompilerTypeVar("U"))
	nested: CompilerType = compiler_apply_subst(subst, compiler_type_list(CompilerTypeVar("T")))

	(
		compiler_types_equal(direct, compiler_type_int())
		and compiler_types_equal(unchanged, CompilerTypeVar("U"))
		and compiler_types_equal(nested, compiler_type_list(compiler_type_int()))
	)


func test_apply_subst_chained_and_cycle_safe() -> Bool:
	chained: List[CompilerTypeSubstEntry] = [
		compiler_type_subst_entry("T", CompilerTypeVar("U")),
		compiler_type_subst_entry("U", compiler_type_int()),
	]
	cyclic: List[CompilerTypeSubstEntry] = [
		compiler_type_subst_entry("T", CompilerTypeVar("U")),
		compiler_type_subst_entry("U", CompilerTypeVar("T")),
	]
	chained_result: CompilerType = compiler_apply_subst(chained, CompilerTypeVar("T"))
	cyclic_result: CompilerType = compiler_apply_subst(cyclic, CompilerTypeVar("T"))

	(
		compiler_types_equal(chained_result, compiler_type_int())
		and compiler_types_equal(cyclic_result, CompilerTypeVar("T"))
	)


func test_apply_subst_function_self_and_bound_names() -> Bool:
	subst: List[CompilerTypeSubstEntry] = [
		compiler_type_subst_entry("A", compiler_type_int()),
		compiler_type_subst_entry("B", compiler_type_string()),
		compiler_type_subst_entry("Self", compiler_type_bool()),
		compiler_type_subst_entry("T", compiler_type_char()),
	]
	func_type: CompilerType = compiler_function_type(
		True,
		[CompilerTypeVar("A")],
		CompilerTypeVar("B"),
	)
	expected_func: CompilerType = compiler_function_type(
		True,
		[compiler_type_int()],
		compiler_type_string(),
	)
	bound_named: CompilerType = CompilerNamedType("T:Stringable", [])

	compiler_types_equal(
		compiler_apply_subst(subst, func_type),
		expected_func,
	) and compiler_types_equal(
		compiler_apply_subst(subst, CompilerSelfType),
		compiler_type_bool(),
	) and compiler_types_equal(
		compiler_apply_subst(subst, bound_named),
		compiler_type_char(),
	)


func test_occurs_in() -> Bool:
	nested: CompilerType = compiler_type_list(CompilerTypeVar("T"))
	func_type: CompilerType = compiler_function_type(
		False,
		[CompilerTypeVar("A")],
		CompilerTypeVar("B"),
	)

	(
		compiler_occurs_in("T", CompilerTypeVar("T"))
		and compiler_occurs_in("T", nested)
		and compiler_occurs_in("A", func_type)
		and compiler_occurs_in("B", func_type)
		and not compiler_occurs_in("T", compiler_type_int())
	)


func test_normalize_dim_arithmetic() -> Bool:
	n: CompilerType = CompilerTypeVar("#N")

	(
		compiler_types_equal(
			compiler_normalize_dim(
				CompilerDimOpType(
					CompilerDimAdd,
					CompilerConstIntType(2),
					CompilerConstIntType(3),
				),
			),
			CompilerConstIntType(5),
		)
		and compiler_types_equal(
			compiler_normalize_dim(CompilerDimOpType(CompilerDimSubtract, n, n)),
			CompilerConstIntType(0),
		)
		and compiler_types_equal(
			compiler_normalize_dim(
				CompilerDimOpType(
					CompilerDimMultiply,
					n,
					CompilerConstIntType(1),
				),
			),
			n,
		)
		and compiler_types_equal(
			compiler_normalize_dim(
				CompilerDimOpType(
					CompilerDimDivide,
					CompilerConstIntType(8),
					CompilerConstIntType(2),
				),
			),
			CompilerConstIntType(4),
		)
	)


func test_apply_subst_normalizes_dim_ops() -> Bool:
	subst: List[CompilerTypeSubstEntry] = [compiler_type_subst_entry("#N", CompilerConstIntType(2))]
	dim_expr: CompilerType = CompilerDimOpType(
		CompilerDimAdd,
		CompilerTypeVar("#N"),
		CompilerConstIntType(3),
	)

	compiler_types_equal(
		compiler_apply_subst(subst, dim_expr),
		CompilerConstIntType(5),
	)


func test_validate_array_dims_accepts_valid_arrays() -> Bool:
	array_type: CompilerType = CompilerArrayType(
		compiler_type_int(),
		[CompilerTypeVar("#N"), CompilerConstIntType(3)],
	)
	tensor_type: CompilerType = CompilerNamedType(
		"Tensor",
		[compiler_type_float(), CompilerTypeVar("#N"), CompilerVarDimsType("#Ds")],
	)

	(
		compiler_validate_array_dims(["#N"], array_type) == None
		and compiler_validate_array_dims(["#N"], tensor_type) == None
	)


func test_validate_array_dims_rejects_invalid_dim_type() -> Bool:
	array_type: CompilerType = CompilerArrayType(compiler_type_int(), [compiler_type_string()])
	tensor_type: CompilerType = CompilerNamedType(
		"Tensor",
		[compiler_type_float(), compiler_type_string()],
	)

	match (
		compiler_validate_array_dims([], array_type),
		compiler_validate_array_dims([], tensor_type),
	):
		(Some(array_error), Some(tensor_error)):
			(
				array_error.contains("Array dimension argument must be a dimension type")
				and array_error.contains("String")
				and tensor_error.contains("Tensor dimension argument must be a dimension type")
				and tensor_error.contains("String")
			)
		_:
			False


func test_validate_array_dims_rejects_non_positive_dims() -> Bool:
	zero_dim: CompilerType = CompilerArrayType(compiler_type_int(), [CompilerConstIntType(0)])
	negative_expr: CompilerType = CompilerArrayType(
		compiler_type_int(),
		[CompilerDimOpType(CompilerDimSubtract, CompilerConstIntType(2), CompilerConstIntType(3))],
	)

	match (
		compiler_validate_array_dims([], zero_dim),
		compiler_validate_array_dims([], negative_expr),
	):
		(Some(zero_error), Some(negative_error)):
			(
				zero_error.contains("non-positive result: 0")
				and negative_error.contains("non-positive result: -1")
			)
		_:
			False


func test_validate_array_dims_rejects_variadic_placement() -> Bool:
	multiple: CompilerType = CompilerArrayType(
		compiler_type_int(),
		[CompilerVarDimsType("#A"), CompilerVarDimsType("#B")],
	)
	not_last: CompilerType = CompilerArrayType(
		compiler_type_int(),
		[CompilerVarDimsType("#A"), CompilerTypeVar("#N")],
	)
	vector: CompilerType = CompilerNamedType(
		"Vector",
		[compiler_type_float(), CompilerVarDimsType("#Ds")],
	)
	matrix: CompilerType = CompilerNamedType(
		"Matrix",
		[compiler_type_float(), CompilerVarDimsType("#Ds")],
	)

	match (
		compiler_validate_array_dims([], multiple),
		compiler_validate_array_dims([], not_last),
		compiler_validate_array_dims([], vector),
		compiler_validate_array_dims([], matrix),
	):
		(Some(multiple_error), Some(not_last_error), Some(vector_error), Some(matrix_error)):
			(
				multiple_error.contains("multiple variadic dims")
				and not_last_error.contains("must be the last")
				and vector_error.contains("Vector does not support variadic dimensions")
				and matrix_error.contains("Matrix does not support variadic dimensions")
			)
		_:
			False


func test_validate_array_dims_rejects_scalar_type_args() -> Bool:
	scalar_with_arg: CompilerType = CompilerNamedType("Int", [compiler_type_string()])

	match compiler_validate_array_dims([], scalar_with_arg):
		Some(error):
			(
				error.contains("Array dimension argument must be a dimension type")
				and error.contains("String")
			)
		None:
			False


func test_dim_wildcard_accepts_any_concrete_dimension() -> Bool:
	expected: CompilerType = CompilerArrayType(CompilerTypeVar("T"), [CompilerTypeVar("#_")])
	actual: CompilerType = CompilerArrayType(compiler_type_int(), [CompilerConstIntType(3)])

	compiler_types_compatible_with_params(["T"], expected, actual)


func test_dimension_value_is_compatible_with_int() -> Bool:
	(
		compiler_types_compatible_with_params([], compiler_type_int(), CompilerTypeVar("#N"))
		and compiler_types_compatible_with_params(
			[],
			compiler_type_int(),
			CompilerRangeType(CompilerConstIntType(8)),
		)
		and not compiler_types_compatible_with_params(
			[],
			compiler_type_string(),
			CompilerTypeVar("#N"),
		)
	)


func test_range_accepts_only_proven_literal_values() -> Bool:
	expected = CompilerRangeType(CompilerConstIntType(8))

	(
		compiler_types_compatible_with_params([], expected, CompilerConstIntType(0))
		and compiler_types_compatible_with_params([], expected, CompilerConstIntType(7))
		and not compiler_types_compatible_with_params([], expected, CompilerConstIntType(-1))
		and not compiler_types_compatible_with_params([], expected, CompilerConstIntType(8))
		and not compiler_types_compatible_with_params([], expected, compiler_type_int())
	)


func test_variadic_dims_accept_any_concrete_rank_one_way() -> Bool:
	expected: CompilerType = CompilerArrayType(compiler_type_float(), [CompilerVarDimsType("#Ds")])
	actual_vector: CompilerType = CompilerArrayType(
		compiler_type_float(),
		[CompilerConstIntType(3)],
	)
	actual_matrix: CompilerType = CompilerArrayType(
		compiler_type_float(),
		[CompilerConstIntType(3), CompilerConstIntType(4)],
	)

	(
		compiler_types_compatible_with_params([], expected, actual_vector)
		and compiler_types_compatible_with_params([], expected, actual_matrix)
		and not compiler_types_compatible_with_params([], actual_vector, expected)
	)


func test_variadic_dims_preserve_fixed_prefix() -> Bool:
	expected: CompilerType = CompilerArrayType(
		compiler_type_float(),
		[CompilerConstIntType(2), CompilerVarDimsType("#Ds")],
	)
	matching: CompilerType = CompilerArrayType(
		compiler_type_float(),
		[CompilerConstIntType(2), CompilerConstIntType(3), CompilerConstIntType(4)],
	)
	prefix_only: CompilerType = CompilerArrayType(compiler_type_float(), [CompilerConstIntType(2)])
	wrong_prefix: CompilerType = CompilerArrayType(
		compiler_type_float(),
		[CompilerConstIntType(3), CompilerConstIntType(4)],
	)

	(
		compiler_types_compatible_with_params([], expected, matching)
		and compiler_types_compatible_with_params([], expected, prefix_only)
		and not compiler_types_compatible_with_params([], expected, wrong_prefix)
		and not compiler_types_compatible_with_params([], matching, expected)
	)


func test_function_purity_compatibility_is_recursive() -> Bool:
	impure_callback = CompilerFunctionType(False, [compiler_type_int()], compiler_type_int())
	pure_callback = CompilerFunctionType(True, [compiler_type_int()], compiler_type_int())
	expected = CompilerTupleType([impure_callback, impure_callback])
	actual = CompilerTupleType([pure_callback, pure_callback])

	(
		compiler_types_compatible_with_params([], expected, actual)
		and not compiler_types_compatible_with_params([], actual, expected)
	)


func test_function_parameter_compatibility_is_contravariant() -> Bool:
	impure_callback = CompilerFunctionType(False, [compiler_type_int()], compiler_type_int())
	pure_callback = CompilerFunctionType(True, [compiler_type_int()], compiler_type_int())
	expected = CompilerFunctionType(False, [impure_callback], compiler_type_int())
	narrower_actual = CompilerFunctionType(True, [pure_callback], compiler_type_int())

	not compiler_types_compatible_with_params([], expected, narrower_actual)


tests: TestSuite = {
	description = "Compiler semantic types",
	tests = [
		("type_to_string simple", test_type_to_string_simple),
		("type_to_string parameterized and tuple", test_type_to_string_parameterized_and_tuple),
		("type_to_string function array and dims", test_type_to_string_function_array_and_dims),
		("type contains meta checks nested types", test_type_contains_meta_checks_nested_types),
		("canonical type display", test_canonical_type_display),
		("std Duration type is module-owned", test_std_duration_type_is_module_owned),
		(
			"types_equal basic and tensor normalization",
			test_types_equal_basic_and_tensor_normalization,
		),
		(
			"types_equal tuple function and array forms",
			test_types_equal_tuple_function_and_array_forms,
		),
		("array type parts", test_array_type_parts),
		("numeric predicates", test_numeric_predicates),
		("dim const and type var predicates", test_dim_const_and_type_var_predicates),
		("dim named and variadic predicates", test_dim_named_and_variadic_predicates),
