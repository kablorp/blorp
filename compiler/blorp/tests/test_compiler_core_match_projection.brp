import:
	../src/stage_09_core/core_json:
		CoreAccessor(
			ErasedVariantFieldAccessor,
			NullableOptionPayloadAccessor,
			RootAccessor,
			StackOptionPayloadAccessor,
			VariantFieldAccessor,
		),
		CoreCallKind(BuiltinCall),
		CoreConstructorMatchBody(ConstructorMatchBodyExpr, ConstructorMatchBodyLiteral),
		CoreConstructorMatchFallback(ConstructorMatchFallbackFail),
		CoreConstructorMatchTest(
			EnumConstructorTest,
			NullableOptionSomeConstructorTest,
			StackOptionSomeConstructorTest,
			UnionTagConstructorTest,
		),
		CoreDecl(EnumDecl, FunctionDecl, UnionDecl),
		CoreExpr(
			CallExpr,
			ConstructorMatchExpr,
			DropExpr,
			DupExpr,
			LengthMatchExpr,
			LetExpr,
			LiteralExpr,
			LiteralMatchExpr,
			SemanticMatchExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunctionKind(UserFunction),
		CoreLiteral(IntLiteral),
		CoreMatchBinding,
		CoreMatchBindingMode(MatchBorrowBindingMode),
		CoreProgram,
		CoreReleasePolicy(ArcReleasePolicy, NoReleasePolicy),
		CoreRetainPolicy(ArcRetainPolicy, NoRetainPolicy),
		CoreSemanticMatchAccessor(
			ListElementSemanticMatchAccessor,
			RootSemanticMatchAccessor,
			VariantFieldSemanticMatchAccessor,
		),
		CoreSemanticMatchTree(
			SemanticConstructorMatch,
			SemanticLengthMatch,
			SemanticLiteralMatch,
			SemanticMatchFail,
			SemanticMatchLeaf,
		),
		CoreSourceLoc(KnownSourceLoc, SyntheticSourceLoc),
		CoreType(EnumType, NamedType, TypeParameterType, UnionType, VoidType),
		CoreUnionPayloadStorage(ErasedUnionPayloadStorage, TypedUnionPayloadStorage),
		CoreVar,
		core_program_to_json,
	../src/stage_09_core/core_match_projection: project_backend_matches
	test: TestSuite


private pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


private pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


private pure func core_var_with_def_id(name: String, def_id: Int) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = Some(def_id)
	}


private pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, SyntheticSourceLoc)


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), named_type("Int"), SyntheticSourceLoc)


private pure func known_loc() -> CoreSourceLoc:
	KnownSourceLoc("match_projection.brp", 7, 3, 9, 12)


private pure func function_decl(body: CoreExpr) -> CoreDecl:
	FunctionDecl({
		name = "classify",
		source_module = None,
		type_params = [],
		params = [],
		return_type = named_type("Int"),
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 41,
		loc = known_loc(),
	})


private pure func program_with(body: CoreExpr, declarations: List[CoreDecl]) -> CoreProgram:
	{
		decls = declarations.append(function_decl(body)),
		foreign_includes = []
	}


private pure func projected_body(program: CoreProgram) -> Option[CoreExpr]:
	var result: Option[CoreExpr] = None

	for decl in project_backend_matches(program).decls:
		match decl:
			FunctionDecl(function_info):
				result = function_info.body
				break
			_:
				void

	result


private pure func enum_decl() -> CoreDecl:
	EnumDecl({
		name = "Color",
		type_params = [],
		variants = [
			{
				name = "Red",
				c_name = "__COLOR_RED",
				tag = 0,
				def_id = Some(101)
			},
			{
				name = "Blue",
				c_name = "__COLOR_BLUE",
				tag = 1,
				def_id = Some(102)
			},
		],
		loc = known_loc(),
	})


private pure func choice_decl() -> CoreDecl:
	UnionDecl({
		name = "Choice",
		type_params = [],
		payload_storage = TypedUnionPayloadStorage,
		variants = [
			{
				name = "A",
				c_name = "__CHOICE_A",
				tag_c_name = "__TAG_CHOICE_A",
				tag = 0,
				fields = [],
				def_id = Some(201)
			},
			{
				name = "B",
				c_name = "__CHOICE_B",
				tag_c_name = "__TAG_CHOICE_B",
				tag = 1,
				fields = [],
				def_id = Some(202)
			},
		],
		loc = known_loc(),
	})


private pure func generic_envelope_decl() -> CoreDecl:
	UnionDecl({
		name = "Envelope",
		type_params = ["T"],
		payload_storage = ErasedUnionPayloadStorage,
		variants = [
			{
				name = "Wrapped",
				c_name = "__ENVELOPE_WRAPPED",
				tag_c_name = "TAG_Envelope_Wrapped",
				tag = 0,
				fields = [
					{
						typ = TypeParameterType("T"),
						release_policy = NoReleasePolicy
					},
				],
				def_id = Some(301)
			},
		],
		loc = known_loc(),
	})


private pure func test_projects_enum_constructor_match() -> Bool:
	color_type: CoreType = EnumType("Color")
	body: CoreExpr = SemanticMatchExpr(
		variable(
			"color",
			color_type,
		),
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = "Red",
					body = SemanticMatchLeaf([], int_literal(1))
				},
			],
			Some(SemanticMatchFail),
		),
		named_type("Int"),
		known_loc(),
	)

	match projected_body(program_with(body, [enum_decl()])):
		Some(ConstructorMatchExpr(_, NoReleasePolicy, cases, ConstructorMatchFallbackFail, _, _)):
			match cases:
				[first]:
					match first.test:
						EnumConstructorTest(c_name):
							first.constructor == "Red" and c_name == "__COLOR_RED"
						_:
							False
				_:
					False
		_:
			False


private pure func test_projects_stack_option_binding() -> Bool:
	option_type: CoreType = NamedType("Option", [named_type("Int")])
	value_accessor = VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Some", 0)
	body: CoreExpr = SemanticMatchExpr(
		variable(
			"value",
			option_type,
		),
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = "Some",
					body = SemanticMatchLeaf(
						[
							{
								variable = core_var("payload"),
								accessor = value_accessor,
								mode = MatchBorrowBindingMode
							},
						],
						int_literal(1),
					)
				},
			],
			None,
		),
		named_type("Int"),
		known_loc(),
	)

	match projected_body(program_with(body, [])):
		Some(ConstructorMatchExpr(_, _, cases, _, _, _)):
			match cases:
				[first]:
					test_is_stack_option: Bool = match first.test:
						StackOptionSomeConstructorTest(c_type):
							c_type == "blorp_StackOption_Int"
						_:
							False

					match first.bindings:
						[binding]:
							accessor_is_stack_payload: Bool = match binding.accessor:
								StackOptionPayloadAccessor(RootAccessor):
									True
								_:
									False

							test_is_stack_option and accessor_is_stack_payload
						_:
							False
				_:
					False
		_:
			False


private pure func test_projects_nested_literal_match() -> Bool:
	option_type: CoreType = NamedType("Option", [named_type("Int")])
	payload_accessor = VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Some", 0)
	body: CoreExpr = SemanticMatchExpr(
		variable(
			"value",
			option_type,
		),
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = "Some",
					body = SemanticLiteralMatch(
						payload_accessor,
						[
							{
								literal = IntLiteral(7),
								body = SemanticMatchLeaf([], int_literal(7))
							},
						],
						SemanticMatchFail,
					)
				},
			],
			None,
		),
		named_type("Int"),
		known_loc(),
	)

	match projected_body(program_with(body, [])):
		Some(ConstructorMatchExpr(_, _, cases, _, _, _)):
			match cases:
				[first]:
					match first.body:
						ConstructorMatchBodyLiteral(match_info):
							match_info.cases.length() == 1 and match match_info.accessor:
								StackOptionPayloadAccessor(RootAccessor):
									True
								_:
									False
						_:
							False
				_:
					False
		_:
			False


private pure func generic_option_some_match(
	option_type: CoreType,
	payload_type: CoreType,
) -> CoreExpr:
	ConstructorMatchExpr(
		variable(
			"value",
			option_type,
		),
		NoReleasePolicy,
		[
			{
				constructor = "Some",
				accessor = RootAccessor,
				test = UnionTagConstructorTest("TAG_Option_Some", "Option"),
				bindings = [
					{
						variable = core_var("payload"),
						typ = payload_type,
						accessor = VariantFieldAccessor(RootAccessor, "Option", "Some", 0),
						mode = MatchBorrowBindingMode
					},
				],
				body = ConstructorMatchBodyExpr(int_literal(1))
			},
		],
		ConstructorMatchFallbackFail,
		named_type("Int"),
		known_loc(),
	)


private pure func test_reprojects_typed_nullable_option_match() -> Bool:
	payload_type: CoreType = UnionType("Choice")
	option_type: CoreType = NamedType("Option", [payload_type])

	match projected_body(
		program_with(
			generic_option_some_match(option_type, payload_type),
			[choice_decl()],
		),
	):
		Some(ConstructorMatchExpr(_, _, [match_case], _, _, _)):
			test_is_nullable: Bool = match match_case.test:
				NullableOptionSomeConstructorTest:
					True
				_:
					False

			accessor_is_nullable: Bool = match match_case.bindings:
				[binding]:
					match binding.accessor:
						NullableOptionPayloadAccessor(RootAccessor):
							True
						_:
							False
				_:
					False

			test_is_nullable and accessor_is_nullable
		_:
			False


private pure func test_reprojects_typed_stack_option_match() -> Bool:
	payload_type: CoreType = EnumType("Color")
	option_type: CoreType = NamedType("Option", [payload_type])

	match projected_body(
		program_with(
			generic_option_some_match(option_type, payload_type),
			[enum_decl()],
		),
	):
		Some(ConstructorMatchExpr(_, _, [match_case], _, _, _)):
			test_is_stack: Bool = match match_case.test:
				StackOptionSomeConstructorTest(c_type):
					c_type == "blorp_StackOption_Color"
				_:
					False

			accessor_is_stack: Bool = match match_case.bindings:
				[binding]:
					match binding.accessor:
						StackOptionPayloadAccessor(RootAccessor):
							True
						_:
							False
				_:
					False

			test_is_stack and accessor_is_stack
		_:
			False


private pure func projected_generic_union_binding() -> Option[CoreMatchBinding]:
	envelope_type: CoreType = NamedType("Envelope", [named_type("Int")])
	body: CoreExpr = ConstructorMatchExpr(
		variable(
			"envelope",
			envelope_type,
		),
		NoReleasePolicy,
		[
			{
				constructor = "Wrapped",
				accessor = RootAccessor,
				test = UnionTagConstructorTest("TAG_Envelope_Wrapped", "Envelope"),
				bindings = [
					{
						variable = core_var("value"),
						typ = TypeParameterType("T"),
						accessor = ErasedVariantFieldAccessor(
							RootAccessor,
							"Envelope",
							"Wrapped",
							0,
						),
						mode = MatchBorrowBindingMode
					},
				],
				body = ConstructorMatchBodyExpr(int_literal(1))
			},
		],
		ConstructorMatchFallbackFail,
		named_type("Int"),
		known_loc(),
	)

	projected ?= projected_body(program_with(body, [generic_envelope_decl()]))

	match projected:
		ConstructorMatchExpr(_, _, cases, _, _, _):
			match_case ?= cases.get(0)
			match_case.bindings.get(0)
		_:
			None


private pure func test_reprojects_generic_union_binding_type() -> Bool:
	match projected_generic_union_binding():
		Some(binding):
			match binding.typ:
				NamedType("Int", []):
					True
				_:
					False
		None:
			False


private pure func test_reprojects_generic_union_binding_accessor() -> Bool:
	match projected_generic_union_binding():
		Some(binding):
			match binding.accessor:
				ErasedVariantFieldAccessor(parent, type_name, constructor, field_index):
					match parent:
						RootAccessor:
							(
								type_name == "Envelope"
								and constructor == "Wrapped"
								and field_index == 0
							)
						_:
							False
				_:
					False
		None:
			False


private pure func test_projects_root_literal_match() -> Bool:
	body: CoreExpr = SemanticMatchExpr(
		variable(
			"value",
			named_type("Int"),
		),
		SemanticLiteralMatch(
			RootSemanticMatchAccessor,
			[
				{
					literal = IntLiteral(3),
					body = SemanticMatchLeaf([], int_literal(30))
				},
			],
			SemanticMatchLeaf(
				[],
				int_literal(0),
			),
		),
		named_type("Int"),
		known_loc(),
	)

	match projected_body(program_with(body, [])):
		Some(LiteralMatchExpr(_, cases, _, _, _)):
			cases.length() == 1
		_:
			False


private pure func test_projects_length_branches() -> Bool:
	list_type: CoreType = NamedType("List", [named_type("Int")])
	body: CoreExpr = SemanticMatchExpr(
		variable(
			"items",
			list_type,
		),
		SemanticLengthMatch(
			RootSemanticMatchAccessor,
			[
				{
					length = 0,
					body = SemanticMatchLeaf([], int_literal(0))
				},
			],
			Some({
				minimum_length = 1,
				body = SemanticMatchLeaf(
					[
						{
							variable = core_var("first"),
							accessor = ListElementSemanticMatchAccessor(
								RootSemanticMatchAccessor,
								0,
							),
							mode = MatchBorrowBindingMode
						},
					],
					int_literal(1),
				),
			}),
			Some(SemanticMatchFail),
		),
		named_type("Int"),
		known_loc(),
	)

	match projected_body(program_with(body, [])):
		Some(LengthMatchExpr(_, NoReleasePolicy, match_info, _, _)):
			match match_info.geq:
				Some(geq):
					(
						match_info.cases.length() == 1
						and geq.minimum_length == 1
						and geq.branch.bindings.length() == 1
						and match_info.fallback.is_none()
					)
				None:
					False
		_:
			False


private pure func test_owned_temporary_match_has_one_cleanup_owner() -> Bool:
	choice_type: CoreType = UnionType("Choice")
	scrutinee: CoreExpr = CallExpr(
		BuiltinCall("blorp_channel_try_recv_attempt"),
		VoidExpr(VoidType, SyntheticSourceLoc),
		[variable(
				"channel",
				NamedType("Channel", [named_type("Int")]),
			)],
		choice_type,
		known_loc(),
	)
	body: CoreExpr = SemanticMatchExpr(
		scrutinee,
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = "A",
					body = SemanticMatchLeaf([], int_literal(1))
				},
			],
			Some(SemanticMatchFail),
		),
		named_type("Int"),
		known_loc(),
	)

	match projected_body(program_with(body, [choice_decl()])):
		Some(LetExpr(temp, False, UnionType("Choice"), CallExpr(_, _, _, _, _), ConstructorMatchExpr(VarExpr(match_var, _, _), ArcReleasePolicy, _, _, _, _))):
			temp.name == "$blorp$match_scrut$41$7$3$9$12" and match_var.name == temp.name
		_:
			False


private pure func test_invalid_constructor_fails_closed() -> Bool:
	color_type: CoreType = EnumType("Color")
	body: CoreExpr = SemanticMatchExpr(
		variable(
			"color",
			color_type,
		),
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = "Green",
					body = SemanticMatchLeaf([], int_literal(1))
				},
			],
			None,
		),
		named_type("Int"),
		known_loc(),
	)

	match projected_body(program_with(body, [enum_decl()])):
		Some(SemanticMatchExpr(_, _, _, _)):
			True
		_:
			False


private pure func test_singleton_constructor_ownership_is_normalized() -> Bool:
	choice_type: CoreType = UnionType("Choice")
	body: CoreExpr = DupExpr(
		core_var_with_def_id("A", 201),
		choice_type,
		ArcRetainPolicy,
		DropExpr(
			core_var_with_def_id("A", 201),
			choice_type,
			ArcReleasePolicy,
			int_literal(1),
			named_type("Int"),
			known_loc(),
		),
		named_type("Int"),
		known_loc(),
	)

	match projected_body(program_with(body, [choice_decl()])):
		Some(DupExpr(_, _, NoRetainPolicy, DropExpr(_, _, NoReleasePolicy, _, _, _), _, _)):
			True
		_:
			False


private pure func test_resolved_nonconstructor_ownership_is_preserved() -> Bool:
	choice_type: CoreType = UnionType("Choice")
	body: CoreExpr = DupExpr(
		core_var_with_def_id("A", 999),
		choice_type,
		ArcRetainPolicy,
		DropExpr(
			core_var_with_def_id("A", 999),
			choice_type,
			ArcReleasePolicy,
			int_literal(1),
			named_type("Int"),
			known_loc(),
		),
		named_type("Int"),
		known_loc(),
	)

	match projected_body(program_with(body, [choice_decl()])):
		Some(DupExpr(_, _, ArcRetainPolicy, DropExpr(_, _, ArcReleasePolicy, _, _, _), _, _)):
			True
		_:
			False


private pure func test_projection_is_idempotent() -> Bool:
	color_type: CoreType = EnumType("Color")
	body: CoreExpr = SemanticMatchExpr(
		variable(
			"color",
			color_type,
		),
		SemanticConstructorMatch(
			RootSemanticMatchAccessor,
			[
				{
					constructor = "Red",
					body = SemanticMatchLeaf([], int_literal(1))
				},
			],
			Some(SemanticMatchFail),
		),
		named_type("Int"),
		known_loc(),
	)
	source: CoreProgram = program_with(body, [enum_decl()])
	once: CoreProgram = project_backend_matches(source)
	twice: CoreProgram = project_backend_matches(once)

	core_program_to_json(once).to_string() == core_program_to_json(twice).to_string()


tests: TestSuite = {
	description = "Late backend semantic match projection",
	tests = [
		("projects enum constructor matches", test_projects_enum_constructor_match),
		("projects stack Option bindings", test_projects_stack_option_binding),
		("projects nested literal matches", test_projects_nested_literal_match),
		("reprojects typed nullable Option matches", test_reprojects_typed_nullable_option_match),
		("reprojects typed stack Option matches", test_reprojects_typed_stack_option_match),
		("reprojects generic union binding types", test_reprojects_generic_union_binding_type),
		(
			"reprojects generic union binding accessors",
			test_reprojects_generic_union_binding_accessor,
		),
		("projects root literal matches", test_projects_root_literal_match),
		("projects length branches", test_projects_length_branches),
		(
			"owned temporary match has one cleanup owner",
			test_owned_temporary_match_has_one_cleanup_owner,
		),
		("invalid constructors fail closed", test_invalid_constructor_fails_closed),
		(
			"normalizes singleton constructor ownership",
			test_singleton_constructor_ownership_is_normalized,
		),
		(
			"preserves resolved nonconstructor ownership",
			test_resolved_nonconstructor_ownership_is_preserved,
		),
		("projection is idempotent", test_projection_is_idempotent),
	]
}
