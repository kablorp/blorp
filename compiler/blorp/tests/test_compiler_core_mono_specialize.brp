import:
	../src/stage_08_core_lower/compiler_core_identity: core_module_member_name
	../src/stage_09_core/compiler_core_json:
		CoreCallKind(SelectedDirectCall, UnknownCall),
		CoreDecl(FunctionDecl),
		CoreDimOp(DimMultiply),
		CoreExpr(CallExpr, LiteralExpr, SeqExpr, VarExpr, VoidExpr),
		CoreFunction,
		CoreFunctionKind(UnresolvedBuiltinFunction, UserFunction),
		CoreLiteral(IntLiteral),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreTensorDim(TensorDimOperation, TensorRuntimeDim, TensorStaticDim, TensorVariadicDim),
		CoreType(FunctionType, NamedType, TensorType, TypeParameterType, VoidType),
		CoreVar,
		core_program_to_json,
	../src/stage_09_core/compiler_core_mono_specialize:
		CoreMonoProgramSpecialization,
		specialize_selected_generic_calls,
	../src/stage_09_core/compiler_core_monomorphize: monomorphize_program
	test: TestSuite


pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


pure func type_parameter(name: String) -> CoreType:
	TypeParameterType(name)


pure func named_var(name: String, def_id: Option[Int]) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = def_id
	}


pure func function_type(param_type: CoreType, return_type: CoreType) -> CoreType:
	FunctionType(True, [param_type], return_type)


pure func generic_function(
	name: String,
	def_id: Int,
	type_params: List[String],
	value_type: CoreType,
	body: CoreExpr,
) -> CoreFunction:
	{
		name = name,
		source_module = None,
		type_params = type_params,
		params = [
			{
				name = named_var("value", None),
				typ = value_type,
				loc = SyntheticSourceLoc
			},
		],
		return_type = value_type,
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc
	}


pure func identity_function(
	name: String,
	def_id: Int,
	type_params: List[String],
	value_type: CoreType,
) -> CoreFunction:
	generic_function(
		name,
		def_id,
		type_params,
		value_type,
		VarExpr(
			named_var("value", None),
			value_type,
			SyntheticSourceLoc,
		),
	)


pure func generic_builtin_function(
	name: String,
	module_name: String,
	def_id: Int,
	type_params: List[String],
	value_type: CoreType,
) -> CoreFunction:
	{
		name = name,
		source_module = Some(module_name),
		type_params = type_params,
		params = [
			{
				name = named_var("value", None),
				typ = value_type,
				loc = SyntheticSourceLoc
			},
		],
		return_type = value_type,
		body = None,
		is_pure = True,
		function_kind = UnresolvedBuiltinFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc
	}


pure func call_with_argument(
	target_name: String,
	target_type: CoreType,
	argument_name: String,
	call_kind: CoreCallKind,
	callee_def_id: Option[Int],
) -> CoreExpr:
	CallExpr(
		call_kind,
		VarExpr(
			named_var(target_name, callee_def_id),
			function_type(target_type, target_type),
			SyntheticSourceLoc,
		),
		[VarExpr(
				named_var(argument_name, None),
				target_type,
				SyntheticSourceLoc,
			)],
		target_type,
		SyntheticSourceLoc,
	)


pure func identity_call(
	target_name: String,
	target_type: CoreType,
	call_kind: CoreCallKind,
	callee_def_id: Option[Int],
) -> CoreExpr:
	call_with_argument(target_name, target_type, "argument", call_kind, callee_def_id)


pure func main_function(body: CoreExpr) -> CoreFunction:
	{
		name = "main",
		source_module = None,
		type_params = [],
		params = [],
		return_type = named_type("Int"),
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 20,
		loc = SyntheticSourceLoc
	}


pure func decoder_type(value_type: CoreType) -> CoreType:
	FunctionType(
		True,
		[named_type("Value")],
		NamedType("Result", [value_type, named_type("DecodeError")]),
	)


pure func field_function() -> CoreFunction:
	value_type = type_parameter("T")
	{
		name = "std_codec__field",
		source_module = Some("std/codec"),
		type_params = ["T"],
		params = [
			{
				name = named_var("name", None),
				typ = named_type("String"),
				loc = SyntheticSourceLoc
			},
			{
				name = named_var("decoder", None),
				typ = decoder_type(value_type),
				loc = SyntheticSourceLoc
			},
		],
		return_type = decoder_type(value_type),
		body = Some(
			VarExpr(
				named_var("decoder", None),
				decoder_type(value_type),
				SyntheticSourceLoc,
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 199,
		loc = SyntheticSourceLoc
	}


pure func programs_equal(left: CoreProgram, right: CoreProgram) -> Bool:
	core_program_to_json(left).to_string() == core_program_to_json(right).to_string()


pure func source_program(target_type: String) -> CoreProgram:
	{
		decls = [
			FunctionDecl(identity_function("identity", 10, ["T"], type_parameter("T"))),
			FunctionDecl(
				main_function(
					identity_call(
						"identity",
						named_type(target_type),
						SelectedDirectCall(10),
						Some(10),
					),
				),
			),
		],
		foreign_includes = []
	}


pure func expected_program(target_type: String, specialized_def_id: Int) -> CoreProgram:
	{
		decls = [
			FunctionDecl(identity_function("identity", 10, ["T"], type_parameter("T"))),
			FunctionDecl(
				main_function(
					identity_call(
						"identity__mono_${target_type}",
						named_type(target_type),
						UnknownCall,
						None,
					),
				),
			),
			FunctionDecl(
				identity_function(
					"identity__mono_${target_type}",
					specialized_def_id,
					[],
					named_type(target_type),
				),
			),
		],
		foreign_includes = []
	}


func test_specializes_selected_generic_call() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		source_program("Int"),
		100,
	)

	actual.next_def_id == 101 and programs_equal(
		actual.program,
		expected_program("Int", 100),
	)


func test_specializes_generic_function_used_as_returned_callee() -> Bool:
	int_decoder = decoder_type(named_type("Int"))
	factory_call = CallExpr(
		SelectedDirectCall(199),
		VarExpr(
			named_var("std_codec__field", Some(199)),
			FunctionType(
				True,
				[named_type("String"), int_decoder],
				int_decoder,
			),
			SyntheticSourceLoc,
		),
		[
			VarExpr(named_var("name", None), named_type("String"), SyntheticSourceLoc),
			VarExpr(named_var("d_int", None), int_decoder, SyntheticSourceLoc),
		],
		int_decoder,
		SyntheticSourceLoc,
	)
	body = CallExpr(
		UnknownCall,
		factory_call,
		[VarExpr(named_var("obj", None), named_type("Value"), SyntheticSourceLoc)],
		NamedType("Result", [named_type("Int"), named_type("DecodeError")]),
		SyntheticSourceLoc,
	)
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		{
			decls = [FunctionDecl(field_function()), FunctionDecl(main_function(body))],
			foreign_includes = []
		},
		100,
	)
	rendered = core_program_to_json(actual.program).to_string()

	(
		actual.next_def_id == 101
			and rendered.contains("std_codec__field__mono_Int")
			and not rendered.contains("\"kind\":\"selected_direct\",\"def_id\":199")
	)


func test_full_mono_accepts_generic_function_used_as_returned_callee() -> Bool:
	int_decoder = decoder_type(named_type("Int"))
	factory_call = CallExpr(
		SelectedDirectCall(199),
		VarExpr(
			named_var("std_codec__field", Some(199)),
			FunctionType(
				True,
				[named_type("String"), int_decoder],
				int_decoder,
			),
			SyntheticSourceLoc,
		),
		[
			VarExpr(named_var("name", None), named_type("String"), SyntheticSourceLoc),
			VarExpr(named_var("d_int", None), int_decoder, SyntheticSourceLoc),
		],
		int_decoder,
		SyntheticSourceLoc,
	)
	body = CallExpr(
		UnknownCall,
		factory_call,
		[VarExpr(named_var("obj", None), named_type("Value"), SyntheticSourceLoc)],
		NamedType("Result", [named_type("Int"), named_type("DecodeError")]),
		SyntheticSourceLoc,
	)

	match monomorphize_program(
		{
			decls = [FunctionDecl(field_function()), FunctionDecl(main_function(body))],
			foreign_includes = []
		},
		100,
	):
		Ok(actual):
			actual.next_def_id == 101
		Err(_):
			False


pure func transitive_source_program(target_type: String) -> CoreProgram:
	{
		decls = [
			FunctionDecl(identity_function("inner", 11, ["U"], type_parameter("U"))),
			FunctionDecl(
				generic_function(
					"outer",
					12,
					["T"],
					type_parameter("T"),
					call_with_argument(
						"inner",
						type_parameter("T"),
						"value",
						SelectedDirectCall(11),
						Some(11),
					),
				),
			),
			FunctionDecl(
				main_function(
					identity_call(
						"outer",
						named_type(target_type),
						SelectedDirectCall(12),
						Some(12),
					),
				),
			),
		],
		foreign_includes = []
	}


pure func transitive_expected_program(
	target_type: String,
	outer_def_id: Int,
	inner_def_id: Int,
) -> CoreProgram:
	{
		decls = [
			FunctionDecl(identity_function("inner", 11, ["U"], type_parameter("U"))),
			FunctionDecl(
				generic_function(
					"outer",
					12,
					["T"],
					type_parameter("T"),
					call_with_argument(
						"inner",
						type_parameter("T"),
						"value",
						SelectedDirectCall(11),
						Some(11),
					),
				),
			),
			FunctionDecl(
				main_function(
					identity_call(
						"outer__mono_${target_type}",
						named_type(target_type),
						UnknownCall,
						None,
					),
				),
			),
			FunctionDecl(
				generic_function(
					"outer__mono_${target_type}",
					outer_def_id,
					[],
					named_type(target_type),
					call_with_argument(
						"inner__mono_${target_type}",
						named_type(target_type),
						"value",
						UnknownCall,
						None,
					),
				),
			),
			FunctionDecl(
				identity_function(
					"inner__mono_${target_type}",
					inner_def_id,
					[],
					named_type(target_type),
				),
			),
		],
		foreign_includes = []
	}


func test_drains_transitive_worklist() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		transitive_source_program("Int"),
		100,
	)

	actual.next_def_id == 102 and programs_equal(
		actual.program,
		transitive_expected_program("Int", 100, 101),
	)


pure func recursive_source_program(target_type: String) -> CoreProgram:
	{
		decls = [
			FunctionDecl(
				generic_function(
					"recur",
					13,
					["T"],
					type_parameter("T"),
					call_with_argument(
						"recur",
						type_parameter("T"),
						"value",
						SelectedDirectCall(13),
						Some(13),
					),
				),
			),
			FunctionDecl(
				main_function(
					identity_call(
						"recur",
						named_type(target_type),
						SelectedDirectCall(13),
						Some(13),
					),
				),
			),
		],
		foreign_includes = []
	}


pure func recursive_expected_program(target_type: String, specialized_def_id: Int) -> CoreProgram:
	{
		decls = [
			FunctionDecl(
				generic_function(
					"recur",
					13,
					["T"],
					type_parameter("T"),
					call_with_argument(
						"recur",
						type_parameter("T"),
						"value",
						SelectedDirectCall(13),
						Some(13),
					),
				),
			),
			FunctionDecl(
				main_function(
					identity_call(
						"recur__mono_${target_type}",
						named_type(target_type),
						UnknownCall,
						None,
					),
				),
			),
			FunctionDecl(
				generic_function(
					"recur__mono_${target_type}",
					specialized_def_id,
					[],
					named_type(target_type),
					call_with_argument(
						"recur__mono_${target_type}",
						named_type(target_type),
						"value",
						UnknownCall,
						None,
					),
				),
			),
		],
		foreign_includes = []
	}


func test_recursive_specialization_is_deduplicated() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		recursive_source_program("Int"),
		100,
	)

	actual.next_def_id == 101 and programs_equal(
		actual.program,
		recursive_expected_program("Int", 100),
	)


pure func conflicting_source_program(argument_type: String, result_type: String) -> CoreProgram:
	conflicting_call: CoreExpr = CallExpr(
		SelectedDirectCall(10),
		VarExpr(
			named_var("identity", Some(10)),
			function_type(named_type(argument_type), named_type(result_type)),
			SyntheticSourceLoc,
		),
		[VarExpr(
				named_var("argument", None),
				named_type(argument_type),
				SyntheticSourceLoc,
			)],
		named_type(result_type),
		SyntheticSourceLoc,
	)

	{
		decls = [
			FunctionDecl(identity_function("identity", 10, ["T"], type_parameter("T"))),
			FunctionDecl(main_function(conflicting_call)),
		],
		foreign_includes = []
	}


func test_conflicting_selected_call_is_left_unchanged() -> Bool:
	source: CoreProgram = conflicting_source_program("String", "Bool")
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(source, 100)

	actual.next_def_id == 100 and programs_equal(actual.program, source)


pure func ambiguous_source_program(call_name: String) -> CoreProgram:
	{
		decls = [
			FunctionDecl(identity_function("identity", 10, ["T"], type_parameter("T"))),
			FunctionDecl(identity_function("other", 10, ["T"], type_parameter("T"))),
			FunctionDecl(
				main_function(
					identity_call(
						call_name,
						named_type("Int"),
						SelectedDirectCall(10),
						Some(10),
					),
				),
			),
		],
		foreign_includes = []
	}


func test_callee_name_disambiguates_selected_id_collision() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		ambiguous_source_program("identity"),
		100,
	)

	actual.next_def_id == 101 and program_has_function(actual.program, "identity__mono_Int")


func test_specializes_bodyless_generic_builtin() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		{
			decls = [
				FunctionDecl(
					generic_builtin_function(
						"identity",
						"std/list",
						10,
						["T"],
						type_parameter("T"),
					),
				),
				FunctionDecl(
					main_function(
						identity_call(
							"__ufcs_std$list__identity",
							named_type("Int"),
							SelectedDirectCall(10),
							Some(10),
						),
					),
				),
			],
			foreign_includes = []
		},
		100,
	)

	(
		actual.next_def_id == 101
		and program_has_function(actual.program, "identity__mono_Int")
		and program_main_calls_unknown(actual.program, "identity__mono_Int")
	)


pure func argument_concretization_program(
	argument_type: CoreType,
	expected_type: String,
	specialized_def_id: Option[Int],
) -> CoreProgram:
	call_kind: CoreCallKind = match specialized_def_id:
		Some(_):
			UnknownCall
		None:
			SelectedDirectCall(10)

	callee_name: String = match specialized_def_id:
		Some(_):
			"identity__mono_${expected_type}"
		None:
			"identity"

	callee_def_id: Option[Int] = match specialized_def_id:
		Some(_):
			None
		None:
			Some(10)

	call: CoreExpr = CallExpr(
		call_kind,
		VarExpr(
			named_var(callee_name, callee_def_id),
			function_type(named_type(expected_type), named_type(expected_type)),
			SyntheticSourceLoc,
		),
		[LiteralExpr(IntLiteral(1), argument_type, SyntheticSourceLoc)],
		named_type(expected_type),
		SyntheticSourceLoc,
	)
	var decls: List[CoreDecl] = [
		FunctionDecl(identity_function("identity", 10, ["T"], type_parameter("T"))),
		FunctionDecl(main_function(call)),
	]

	match specialized_def_id:
		Some(def_id):
			decls = decls.append(
				FunctionDecl(
					identity_function(
						"identity__mono_${expected_type}",
						def_id,
						[],
						named_type(expected_type),
					),
				),
			)
		None:
			void

	{
		decls = decls,
		foreign_includes = []
	}


func test_concretizes_argument_types_from_return_evidence() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		argument_concretization_program(type_parameter("T"), "Int", None),
		100,
	)

	actual.next_def_id == 101 and programs_equal(
		actual.program,
		argument_concretization_program(named_type("Int"), "Int", Some(100)),
	)


pure func tensor_type(element_type: CoreType, dims: List[CoreTensorDim]) -> CoreType:
	TensorType({
		element_type = element_type,
		dims = dims,
	})


pure func tensor_function(
	name: String,
	def_id: Int,
	type_params: List[String],
	params: List[CoreParam],
) -> CoreFunction:
	{
		name = name,
		source_module = None,
		type_params = type_params,
		params = params,
		return_type = named_type("Int"),
		body = Some(LiteralExpr(IntLiteral(1), named_type("Int"), SyntheticSourceLoc)),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc
	}


pure func tensor_param(name: String, typ: CoreType) -> CoreParam:
	{
		name = named_var(name, None),
		typ = typ,
		loc = SyntheticSourceLoc
	}


pure func tensor_call_program(function: CoreFunction, args: List[CoreExpr]) -> CoreProgram:
	callee_type: CoreType = FunctionType(
		True,
		function.params.map(func(param): param.typ),
		function.return_type,
	)
	call: CoreExpr = CallExpr(
		SelectedDirectCall(function.def_id),
		VarExpr(
			named_var(function.name, Some(function.def_id)),
			callee_type,
			SyntheticSourceLoc,
		),
		args,
		function.return_type,
		SyntheticSourceLoc,
	)

	{
		decls = [FunctionDecl(function), FunctionDecl(main_function(call))],
		foreign_includes = []
	}


pure func program_has_function(program: CoreProgram, name: String) -> Bool:
	var found: Bool = False

	for decl in program.decls:
		match decl:
			FunctionDecl(function):
				if function.name == name:
					found = True
					break
			_:
				void

	found


pure func program_has_function_with_prefix(program: CoreProgram, prefix: String) -> Bool:
	program.decls.any(pure func(decl):
		match decl:
			FunctionDecl(function):
				function.name.starts_with(prefix)
			_:
				False
	)


func test_accepts_dimension_operation_resolved_by_other_evidence() -> Bool:
	single_dim: CoreType = tensor_type(named_type("Int"), [TensorRuntimeDim("#N")])
	expanded_dim: CoreType = tensor_type(
		named_type("Int"),
		[TensorDimOperation(DimMultiply, TensorRuntimeDim("#N"), TensorStaticDim(4))],
	)
	function: CoreFunction = tensor_function(
		"shape",
		30,
		["#N"],
		[tensor_param("base", single_dim), tensor_param("expanded", expanded_dim)],
	)
	source: CoreProgram = tensor_call_program(
		function,
		[VarExpr(
				named_var("base", None),
				tensor_type(named_type("Int"), [TensorStaticDim(2)]),
				SyntheticSourceLoc,
			), VarExpr(
				named_var("expanded", None),
				tensor_type(named_type("Int"), [TensorStaticDim(8)]),
				SyntheticSourceLoc,
			)],
	)
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(source, 100)

	actual.next_def_id == 101 and program_has_function(actual.program, "shape__mono_2")


func test_accepts_implicit_trailing_dimension_pack() -> Bool:
	function: CoreFunction = tensor_function("pack", 31, ["T"], [tensor_param("values", TensorType({
					element_type = type_parameter("T"),
					dims = [TensorVariadicDim("#Shape")],
				}))])
	source: CoreProgram = tensor_call_program(
		function,
		[
			VarExpr(
				named_var(
					"values",
					None,
				),
				tensor_type(
					named_type("Int"),
					[TensorStaticDim(2), TensorStaticDim(3)],
				),
				SyntheticSourceLoc,
			),
		],
	)
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(source, 100)

	(
		actual.next_def_id == 101
			and program_has_function_with_prefix(actual.program, "pack__mono_sig_")
	)


pure func recursive_collision_program(body_callee_name: String) -> CoreProgram:
	{
		decls = [
			FunctionDecl(
				generic_function(
					"recur",
					13,
					["T"],
					type_parameter("T"),
					call_with_argument(
						body_callee_name,
						type_parameter("T"),
						"value",
						SelectedDirectCall(13),
						Some(13),
					),
				),
			),
			FunctionDecl(
				main_function(
					identity_call(
						"recur",
						named_type("Int"),
						SelectedDirectCall(13),
						Some(13),
					),
				),
			),
		],
		foreign_includes = []
	}


pure func generated_function_keeps_selected_callee(
	program: CoreProgram,
	function_name: String,
	callee_name: String,
) -> Bool:
	var found: Bool = False

	for decl in program.decls:
		match decl:
			FunctionDecl(function):
				if function.name == function_name:
					match function.body:
						Some(CallExpr(SelectedDirectCall(def_id), VarExpr(variable, _, _), _, _, _)):
							found = def_id == 13 and variable.name == callee_name
						_:
							void
			_:
				void

	found


func test_recursive_rewrite_requires_matching_name_and_id() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		recursive_collision_program("other"),
		100,
	)

	(
		actual.next_def_id == 101
		and generated_function_keeps_selected_callee(actual.program, "recur__mono_Int", "other")
	)


pure func deep_sequence(depth: Int, final_expr: CoreExpr) -> CoreExpr:
	var result: CoreExpr = final_expr
	var index: Int = 0

	while index < depth:
		result = SeqExpr(
			VoidExpr(VoidType, SyntheticSourceLoc),
			result,
		)
		index += 1

	result


pure func deep_sequence_program(depth: Int) -> CoreProgram:
	tail: CoreExpr = identity_call("identity", named_type("Int"), SelectedDirectCall(10), Some(10))

	{
		decls = [
			FunctionDecl(identity_function("identity", 10, ["T"], type_parameter("T"))),
			FunctionDecl(main_function(deep_sequence(depth, tail))),
		],
		foreign_includes = []
	}


pure func imported_selected_program(
	module_path: String,
	declaration_name: String,
	callee_name: String,
	target_type: String,
) -> CoreProgram:
	module_function: CoreFunction = { identity_function(
		declaration_name,
		40,
		["T"],
		type_parameter("T"),
	) |
		source_module = Some(module_path)
	}

	{
		decls = [
			FunctionDecl(module_function),
			FunctionDecl(
				main_function(
					identity_call(
						callee_name,
						named_type(target_type),
						SelectedDirectCall(40),
						Some(40),
					),
				),
			),
		],
		foreign_includes = []
	}


pure func imported_collision_program(callee_name: String) -> CoreProgram:
	list_function: CoreFunction = { identity_function(
		core_module_member_name("std/list", "identity"),
		40,
		["T"],
		type_parameter("T"),
	) | source_module = Some("std/list") }
	option_function: CoreFunction = { identity_function(
		core_module_member_name("std/option", "identity"),
		40,
		["T"],
		type_parameter("T"),
	) | source_module = Some("std/option") }

	{
		decls = [
			FunctionDecl(list_function),
			FunctionDecl(option_function),
			FunctionDecl(
				main_function(
					identity_call(
						callee_name,
						named_type("Int"),
						SelectedDirectCall(40),
						Some(40),
					),
				),
			),
		],
		foreign_includes = []
	}


pure func program_main_calls_unknown(program: CoreProgram, callee_name: String) -> Bool:
	var found: Bool = False

	for decl in program.decls:
		match decl:
			FunctionDecl(function):
				if function.name == "main":
					match function.body:
						Some(CallExpr(UnknownCall, VarExpr(variable, _, _), _, _, _)):
							found = variable.name == callee_name
						_:
							void
			_:
				void

	found


func test_specializes_explicit_imported_identity() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		imported_selected_program(
			"std/list",
			core_module_member_name("std/list", "identity"),
			"__ufcs_std$list__identity",
			"Int",
		),
		100,
	)

	(
		actual.next_def_id == 101
		and program_has_function(actual.program, "std_list__identity__mono_Int")
		and program_main_calls_unknown(actual.program, "std_list__identity__mono_Int")
	)


func test_specializes_explicit_imported_pure_overload_identity() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		imported_selected_program(
			"std/list",
			core_module_member_name("std/list", "identity__pure"),
			"__ufcs_std$list__identity",
			"Int",
		),
		100,
	)

	(
		actual.next_def_id == 101
		and program_has_function(actual.program, "std_list__identity__pure__mono_Int")
		and program_main_calls_unknown(actual.program, "std_list__identity__pure__mono_Int")
	)


func test_rejects_mismatched_imported_identity() -> Bool:
	source: CoreProgram = imported_selected_program(
		"std/list",
		core_module_member_name("std/list", "identity"),
		"__ufcs_std$option__identity",
		"Int",
	)
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(source, 100)

	actual.next_def_id == 100 and programs_equal(actual.program, source)


func test_imported_identity_disambiguates_selected_id_collision() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		imported_collision_program("__ufcs_std$list__identity"),
		100,
	)

	(
		actual.next_def_id == 101
		and program_has_function(actual.program, "std_list__identity__mono_Int")
		and not program_has_function(actual.program, "std_option__identity__mono_Int")
		and program_main_calls_unknown(actual.program, "std_list__identity__mono_Int")
	)


func test_imported_identity_preserves_double_underscore_module_segment() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		imported_selected_program(
			"pkg/my__module",
			core_module_member_name("pkg/my__module", "identity"),
			"__ufcs_pkg$my__module__identity",
			"Int",
		),
		100,
	)

	(
		actual.next_def_id == 101
		and program_has_function(actual.program, "pkg_my__module__identity__mono_Int")
	)


func test_imported_identity_preserves_double_underscore_source_name() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		imported_selected_program(
			"std/list",
			core_module_member_name("std/list", "identity__checked"),
			"__ufcs_std$list__identity__checked",
			"Int",
		),
		100,
	)

	(
		actual.next_def_id == 101
		and program_has_function(actual.program, "std_list__identity__checked__mono_Int")
	)


func test_long_sequence_is_stack_bounded() -> Bool:
	actual: CoreMonoProgramSpecialization = specialize_selected_generic_calls(
		deep_sequence_program(2048),
		100,
	)

	actual.next_def_id == 101 and program_has_function(actual.program, "identity__mono_Int")


tests: TestSuite = {
	description = "Blorp compiler selected-call monomorphization",
	tests = [
		("specializes selected generic call", test_specializes_selected_generic_call),
		(
			"specializes generic function used as returned callee",
			test_specializes_generic_function_used_as_returned_callee,
		),
		(
			"full mono accepts generic function used as returned callee",
			test_full_mono_accepts_generic_function_used_as_returned_callee,
		),
		("drains transitive worklist", test_drains_transitive_worklist),
		("recursive specialization is deduplicated", test_recursive_specialization_is_deduplicated),
		(
			"conflicting selected call is left unchanged",
			test_conflicting_selected_call_is_left_unchanged,
		),
		(
			"callee name disambiguates selected id collision",
			test_callee_name_disambiguates_selected_id_collision,
		),
		("specializes bodyless generic builtin", test_specializes_bodyless_generic_builtin),
		(
			"concretizes argument types from return evidence",
			test_concretizes_argument_types_from_return_evidence,
		),
		(
			"accepts dimension operation resolved by other evidence",
			test_accepts_dimension_operation_resolved_by_other_evidence,
		),
		("accepts implicit trailing dimension pack", test_accepts_implicit_trailing_dimension_pack),
		(
			"recursive rewrite requires matching name and id",
			test_recursive_rewrite_requires_matching_name_and_id,
		),
		("specializes explicit imported identity", test_specializes_explicit_imported_identity),
		(
			"specializes explicit imported pure overload identity",
			test_specializes_explicit_imported_pure_overload_identity,
		),
		("rejects mismatched imported identity", test_rejects_mismatched_imported_identity),
		(
			"imported identity disambiguates selected id collision",
			test_imported_identity_disambiguates_selected_id_collision,
		),
		(
			"imported identity preserves double underscore module segment",
			test_imported_identity_preserves_double_underscore_module_segment,
		),
		(
			"imported identity preserves double underscore source name",
			test_imported_identity_preserves_double_underscore_source_name,
		),
		("long sequence is stack bounded", test_long_sequence_is_stack_bounded),
	]
}
