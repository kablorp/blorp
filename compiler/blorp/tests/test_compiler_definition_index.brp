import:
	../src/stage_01_file_io/source:
		compiler_source_file,
		compiler_source_span,
		compiler_source_start,
	../src/stage_03_parse/parsed_ast: ParsedProgram
	../src/stage_03_parse/parser_bridge as ParserBridge
	../src/stage_03_parse/source_ast_finalize:
		finalized_typecheck_program,
		finalized_typecheck_program_ast,
	../src/stage_04_modules/loaded_module:
		CompilerLoadedModuleSet,
		CompilerModuleOrigin(CompilerUserModule),
		compiler_loaded_module_identity,
		compiler_loaded_module_set,
		compiler_loaded_module_set_target,
		compiler_module_load_candidate,
		compiler_resolved_module_identity_from_resolver,
	../src/stage_05_types/env: ENV_EMPTY
	../src/stage_06_typecheck/graph/definition_identity:
		CompilerFuncCallableKey,
		CompilerSourceDefinitionKey,
		CompilerSourceDefinitionKind(CompilerConstructorDefinition),
		compiler_func_callable_key,
		compiler_source_definition_key,
	../src/stage_06_typecheck/graph/definition_index:
		CompilerDefinitionIndex,
		CompilerDefinitionIndexSeed,
		compiler_definition_index_all_func_callable_bindings,
		compiler_definition_index_all_source_definition_bindings,
		compiler_definition_index_bootstrap_empty_index,
		compiler_definition_index_bootstrap_env,
		compiler_definition_index_bootstrap_from_base_env,
		compiler_definition_index_empty,
		compiler_definition_index_find_func_callable_id,
		compiler_definition_index_find_source_definition_id,
		compiler_definition_index_for_loaded_modules,
		compiler_definition_index_func_callable_bindings,
		compiler_definition_index_func_callable_id_count,
		compiler_definition_index_initial_seed,
		compiler_definition_index_insert_func_callable_id,
		compiler_definition_index_insert_source_definition_id,
		compiler_definition_index_next_def_id,
		compiler_definition_index_seed_next_def_id,
		compiler_definition_index_source_definition_bindings,
		compiler_definition_index_source_definition_id_count,
	test: TestSuite


private pure func parsed_program(
	path: String,
	module_name: String,
	source: String,
) -> ParsedProgram:
	finalized_typecheck_program_ast(
		ParserBridge.parsed_typecheck_source_bridge_artifact(
			path,
			module_name,
			source,
			False,
		).program,
	)


private pure func definition_index_seed() -> CompilerDefinitionIndexSeed:
	compiler_definition_index_initial_seed(ENV_EMPTY)


private pure func loaded_module_set(
	target: ParsedProgram,
	modules: List[ParsedProgram],
) -> Option[CompilerLoadedModuleSet]:
	match (
		compiler_loaded_module_set(
			compiler_module_load_candidate(
				compiler_resolved_module_identity_from_resolver(
					target.source.module_name,
					CompilerUserModule,
				),
				finalized_typecheck_program(target),
			),
			modules.map(func(module):
				compiler_module_load_candidate(
					compiler_resolved_module_identity_from_resolver(
						module.source.module_name,
						CompilerUserModule,
					),
					finalized_typecheck_program(module),
				)
			),
		)
	):
		Ok(loaded_modules):
			Some(loaded_modules)
		Err(_):
			None


private pure func insert_callable(
	index: CompilerDefinitionIndex,
	key: CompilerFuncCallableKey,
	def_id: Int,
) -> CompilerDefinitionIndex:
	compiler_definition_index_insert_func_callable_id(index, key, def_id).get_or(index)


private pure func insert_source_definition(
	index: CompilerDefinitionIndex,
	key: CompilerSourceDefinitionKey,
	def_id: Int,
) -> CompilerDefinitionIndex:
	compiler_definition_index_insert_source_definition_id(index, key, def_id).get_or(index)


pure func test_definition_index_uses_explicit_seed_and_exact_keys() -> Bool:
	seed = definition_index_seed()
	empty = compiler_definition_index_empty(seed)
	source = compiler_source_file("index.brp", "index", "func render(): 0")
	start = compiler_source_start(source)
	span = compiler_source_span(source, start, start)

	match loaded_module_set(
		parsed_program("index.brp", "index", "func render(): 0"),
		[],
	):
		None:
			False
		Some(modules):
			identity = compiler_loaded_module_identity(compiler_loaded_module_set_target(modules))
			callable_key = compiler_func_callable_key(identity, "render", span)
			source_key = compiler_source_definition_key(
				identity,
				CompilerConstructorDefinition,
				"Ready",
				Some("Signal"),
				span,
			)
			first_id = compiler_definition_index_seed_next_def_id(seed) + 2
			with_callable = insert_callable(empty, callable_key, first_id)
			with_source = insert_source_definition(with_callable, source_key, first_id + 1)

			(
				compiler_definition_index_next_def_id(
					empty,
				) == compiler_definition_index_seed_next_def_id(seed)
				and compiler_definition_index_find_func_callable_id(empty, callable_key).is_none()
				and compiler_definition_index_find_func_callable_id(
					with_source,
					callable_key,
				) == Some(first_id)
				and compiler_definition_index_find_source_definition_id(
					with_source,
					source_key,
				) == Some(first_id + 1)
				and compiler_definition_index_next_def_id(with_source) == first_id + 2
				and compiler_definition_index_func_callable_bindings(
					with_source,
					"render",
				).length() == 1
				and compiler_definition_index_source_definition_bindings(
					with_source,
					"Ready",
				).length() == 1
				and compiler_definition_index_all_func_callable_bindings(
					with_source,
				).map(
					func(binding): binding[1],
				) == [first_id]
				and compiler_definition_index_all_source_definition_bindings(
					with_source,
				).map(
					func(binding): binding[1],
				) == [first_id + 1]
			)


pure func test_definition_index_plans_programs_without_exposing_maps() -> Bool:
	seed = definition_index_seed()
	target = parsed_program("main.brp", "main", "func main(args: List[String]) -> Int:\n\t0")
	dependency = parsed_program(
		"signal.brp",
		"signal",
		"union Signal:\n\tReady\n\tBusy(Int)\n\npure func answer() -> Int:\n\t42",
	)

	match loaded_module_set(target, [dependency]):
		None:
			False
		Some(modules):
			index = compiler_definition_index_for_loaded_modules(seed, modules)

			(
				compiler_definition_index_func_callable_id_count(index) == 2
				and compiler_definition_index_source_definition_id_count(index) == 3
				and compiler_definition_index_next_def_id(
					index,
				) == compiler_definition_index_seed_next_def_id(seed) + 5
				and compiler_definition_index_func_callable_bindings(index, "main").length() == 1
				and compiler_definition_index_func_callable_bindings(index, "answer").length() == 1
				and compiler_definition_index_source_definition_bindings(
					index,
					"Signal",
				).length() == 1
				and compiler_definition_index_source_definition_bindings(
					index,
					"Ready",
				).length() == 1
				and compiler_definition_index_source_definition_bindings(
					index,
					"Busy",
				).length() == 1
				and compiler_definition_index_all_func_callable_bindings(index).length() == 2
				and compiler_definition_index_all_source_definition_bindings(index).length() == 3
			)


pure func test_definition_index_bootstrap_aligns_environment_and_empty_index() -> Bool:
	bootstrap = compiler_definition_index_bootstrap_from_base_env(ENV_EMPTY)
	env = compiler_definition_index_bootstrap_env(bootstrap)
	index = compiler_definition_index_bootstrap_empty_index(bootstrap)

	(
		compiler_definition_index_func_callable_id_count(index) == 0
		and compiler_definition_index_source_definition_id_count(index) == 0
		and compiler_definition_index_next_def_id(index) == env.next_def_id
	)


tests: TestSuite = {
	description = "Compiler definition index",
	tests = [
		(
			"uses explicit seed and exact keys",
			test_definition_index_uses_explicit_seed_and_exact_keys,
		),
		(
			"plans programs without exposing maps",
			test_definition_index_plans_programs_without_exposing_maps,
		),
		(
			"bootstrap aligns environment and empty index",
			test_definition_index_bootstrap_aligns_environment_and_empty_index,
		),
	]
}
