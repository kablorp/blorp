private pure func module_load_candidate(source: String) -> CompilerModuleLoadCandidate:
	module_load_candidate_at("main", source)


private pure func module_load_candidate_at(
	module_path: String,
	source: String,
) -> CompilerModuleLoadCandidate:
	compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver(module_path, CompilerUserModule),
		ParserBridge.parsed_typecheck_source_bridge_artifact(
			module_path + ".brp",
			module_path,
			source,
			False,
		).program,
	)


private pure func accept_empty_view(
	scope: CompilerPreparedModuleScope,
) -> CompilerBoundModuleViewBinding:
	CompilerBoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(compiler_prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private pure func callable_graph(source: String) -> Option[CompilerCallableHeaderGraph]:
	callable_graph_at("main", source)


private pure func callable_graph_at(
	module_path: String,
	source: String,
) -> Option[CompilerCallableHeaderGraph]:
	indexed ?= compiler_indexed_graph_build(
		module_load_candidate_at(module_path, source),
		[],
	).to_option()
	bound ?= compiler_bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= compiler_declaration_skeleton_graph_build(bound).to_option()
	aliases ?= compiler_type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= compiler_resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= compiler_type_header_graph_build(parameters).to_option()
	topology ?= compiler_trait_topology_graph_build(type_headers).to_option()
	compiler_callable_header_graph_build(topology).to_option()


private pure func callable_header_by_name(
	graph: CompilerCallableHeaderGraph,
	name: String,
) -> Option[CompilerCallableHeader]:
	compiler_callable_header_graph_callables(
		graph,
	).find(
		func(header): compiler_callable_header_name(header) == name,
	)


private pure func global_header_by_name(
	graph: CompilerCallableHeaderGraph,
	name: String,
) -> Option[CompilerGlobalHeader]:
	compiler_callable_header_graph_globals(
		graph,
	).find(
		func(header): compiler_global_header_name(header) == name,
	)


private pure func callable_headers_resolve_exact_signatures() -> Option[Bool]:
	source: String =
		|pure func transform[T: Equatable](value: T, callback: pure (T) -> String) -> String:
		|	callback(value)
		|
		|foreign:
		|	pure func native_size(value: Int) -> Int = "native_size"
	graph ?= callable_graph(source)
	transform ?= callable_header_by_name(graph, "transform")
	native_size ?= callable_header_by_name(graph, "native_size")
	parameter ?= compiler_callable_header_parameters(transform).get(0)
	bound ?= compiler_callable_type_parameter_bounds(parameter).get(0)
	signature = compiler_callable_header_signature(transform)
	params = compiler_callable_signature_parameters(signature)
	value ?= params.get(0)
	callback ?= params.get(1)

	Some(
		(
			compiler_callable_header_graph_callables(graph).length() == 2
			and compiler_callable_header_category(transform) == CompilerFunctionCallableHeader
			and compiler_callable_header_category(native_size) == CompilerForeignCallableHeader
			and compiler_trait_id_name(bound) == "Equatable"
			and compiler_callable_type_parameter_id_index(
				compiler_callable_type_parameter_id(parameter),
			) == 0
			and match (
				compiler_callable_parameter_type(value),
				compiler_callable_parameter_type(callback),
				compiler_callable_signature_return_type(signature),
			):
				(CompilerCallableTypeParameterShape(_), CompilerFunctionTypeShape(True, [CompilerCallableTypeParameterShape(_)], CompilerIntrinsicTypeShape(CompilerIntrinsicString, [])), CompilerIntrinsicTypeShape(CompilerIntrinsicString, [])):
					True
				_:
					False
		),
	)


pure func test_callable_headers_resolve_exact_signatures() -> Bool:
	callable_headers_resolve_exact_signatures().get_or(False)


private pure func prepared_context_rejects_foreign_parameters() -> Option[Bool]:
	source: String =
		|pure func first[T](value: T) -> T: value
		|
		|pure func second[U](value: U) -> U: value
	graph ?= callable_graph(source)
	first ?= callable_header_by_name(graph, "first")
	second ?= callable_header_by_name(graph, "second")
	first_id = compiler_callable_header_id(first)
	second_id = compiler_callable_header_id(second)
	foreign_parameters = compiler_callable_type_parameter_ids(first_id, ["T"])
	type_headers = compiler_trait_topology_graph_type_headers(
		compiler_callable_header_graph_trait_topology(graph),
	)

	Some(
		match compiler_prepare_callable_type_resolution_context(
			type_headers,
			second_id,
			foreign_parameters,
		):
			Err([CompilerTypeShapeForeignCallableParameter(_, parameter, span)]):
				(
					compiler_callable_ids_equal(
						compiler_callable_type_parameter_id_owner(parameter),
						first_id,
					)
					and compiler_source_spans_equal(
						span,
						compiler_callable_id_source_span(second_id),
					)
				)
			_:
				False
	)


pure func test_prepared_context_rejects_foreign_parameters() -> Bool:
	prepared_context_rejects_foreign_parameters().get_or(False)


private pure func prepared_context_resolves_dimension_constraints() -> Option[Bool]:
	source: String =
		|pure func constrained[#M, #N, #R](left: Int[#M], right: Int[#N], result: Int[#R]) -> Int where #M + #N == #R:
		|	0
	graph ?= callable_graph(source)
	header ?= callable_header_by_name(graph, "constrained")
	constraint ?= compiler_callable_header_dimension_constraints(header).get(0)

	Some(
		match constraint:
			(CompilerDimensionBinaryShape(CompilerResolvedDimAdd, CompilerCallableDimensionParameterShape(left, False), CompilerCallableDimensionParameterShape(right, False)), CompilerCallableDimensionParameterShape(result, False)):
				(
					compiler_callable_type_parameter_id_index(left) == 0
					and compiler_callable_type_parameter_id_index(right) == 1
					and compiler_callable_type_parameter_id_index(result) == 2
				)
			_:
				False
	)


pure func test_prepared_context_resolves_dimension_constraints() -> Bool:
	prepared_context_resolves_dimension_constraints().get_or(False)


private pure func callable_and_global_ids_are_exact() -> Option[Bool]:
	source: String =
		|pure func identity(value: Int) -> Int: value
		|
		|foreign:
		|	pure func native_size(value: Int) -> Int = "native_size"
		|
		|answer: Int = 42
	graph ?= callable_graph_at("main", source)
	foreign_graph ?= callable_graph_at("other", source)
	shifted_graph ?= callable_graph_at("main", "\n" + source)
	declarations = compiler_type_header_graph_declaration_graph(
		compiler_trait_topology_graph_type_headers(
			compiler_callable_header_graph_trait_topology(graph),
		),
	)
	callable_headers = compiler_callable_header_graph_callables(graph)
	callable_skeletons = compiler_declaration_skeleton_graph_callable_skeletons(declarations)
	global_headers = compiler_callable_header_graph_globals(graph)
	global_skeletons = compiler_declaration_skeleton_graph_global_skeletons(declarations)
	foreign_callable ?= compiler_callable_header_graph_callables(foreign_graph).get(0)
	foreign_global ?= compiler_callable_header_graph_globals(foreign_graph).get(0)
	global ?= global_headers.get(0)
	shifted_global ?= compiler_callable_header_graph_globals(shifted_graph).get(0)
	global_id = compiler_global_header_id(global)
	shifted_global_id = compiler_global_header_id(shifted_global)

	Some((
			callable_headers.length() == callable_skeletons.length()
			and callable_headers
				.zip(callable_skeletons)
				.all(
					func(
						pair,
					): (
						compiler_callable_ids_equal(
							compiler_callable_header_id(pair[0]),
							pair[1].id,
						)
						and compiler_callable_header_graph_find(
							graph,
							compiler_callable_header_id(pair[0]),
						).is_some()
					),
				)
			and global_headers.length() == global_skeletons.length()
			and global_headers
				.zip(global_skeletons)
				.all(func(pair):
					compiler_global_ids_equal(compiler_global_header_id(pair[0]), pair[1].id)
				)
			and compiler_callable_header_graph_find(
				graph,
				compiler_callable_header_id(foreign_callable),
			).is_none()
			and compiler_callable_header_graph_find_global_source(
				graph,
				compiler_global_id_module_identity(compiler_global_header_id(foreign_global)),
				compiler_global_id_name(compiler_global_header_id(foreign_global)),
				compiler_global_id_source_span(
					compiler_global_header_id(foreign_global),
				),
			).is_none()
			and compiler_callable_header_graph_find_global_source(
				graph,
				compiler_global_id_module_identity(global_id),
				compiler_global_id_name(global_id),
				compiler_global_id_source_span(shifted_global_id),
			).is_none()
		))


pure func test_callable_and_global_ids_are_exact() -> Bool:
	callable_and_global_ids_are_exact().get_or(False)


private pure func callable_headers_infer_implicit_parameters() -> Option[Bool]:
	source: String =
		|pure func identity(value: T) -> T:
		|	value
		|
		|pure func first(values: Int[#N]) -> Int:
		|	values[0]
		|
		|pure func length_of(values: Int[#_]) -> Int:
		|	values.length()
		|
		|pure func prepare_sql(sql: LiteralString) -> String:
		|	sql
		|
		|func receive_one(values: Channel[Int]) -> Int:
		|	0
		|
		|func entry(args: List[String]):
		|	print(args.length().to_string())
	graph ?= callable_graph(source)
	identity ?= callable_header_by_name(graph, "identity")
	first ?= callable_header_by_name(graph, "first")
	length_of ?= callable_header_by_name(graph, "length_of")
	prepare_sql ?= callable_header_by_name(graph, "prepare_sql")
	receive_one ?= callable_header_by_name(graph, "receive_one")
	entry ?= callable_header_by_name(graph, "entry")
	identity_parameter ?= compiler_callable_header_parameters(identity).get(0)
	first_parameter ?= compiler_callable_header_parameters(first).get(0)
	identity_value ?= compiler_callable_signature_parameters(
		compiler_callable_header_signature(identity),
	).get(0)
	first_values ?= compiler_callable_signature_parameters(
		compiler_callable_header_signature(first),
	).get(0)
	length_values ?= compiler_callable_signature_parameters(
		compiler_callable_header_signature(length_of),
	).get(0)
	prepare_sql_value ?= compiler_callable_signature_parameters(
		compiler_callable_header_signature(prepare_sql),
	).get(0)
	receive_values ?= compiler_callable_signature_parameters(
		compiler_callable_header_signature(receive_one),
	).get(0)
	entry_signature = compiler_callable_header_signature(entry)
	entry_args ?= compiler_callable_signature_parameters(entry_signature).get(0)

	prepare_sql_shape_ok = match compiler_callable_parameter_type(prepare_sql_value):
		CompilerIntrinsicTypeShape(CompilerIntrinsicLiteralString, []):
			True
		_:
			False

	Some(
		(
			compiler_callable_header_parameters(identity).length() == 1
			and compiler_callable_header_parameters(first).length() == 1
			and compiler_callable_header_parameters(length_of).is_empty()
			and compiler_callable_header_parameters(prepare_sql).is_empty()
			and prepare_sql_shape_ok
			and compiler_callable_header_parameters(receive_one).is_empty()
			and compiler_callable_header_parameters(entry).is_empty()
			and compiler_callable_type_parameter_id_index(
				compiler_callable_type_parameter_id(identity_parameter),
			) == 0
			and compiler_callable_type_parameter_id_index(
				compiler_callable_type_parameter_id(first_parameter),
			) == 0
			and match compiler_callable_parameter_type(identity_value):
				CompilerCallableTypeParameterShape(_):
					match compiler_callable_parameter_type(first_values):
						CompilerArrayTypeShape(CompilerIntrinsicTypeShape(CompilerIntrinsicInt, []), [CompilerCallableDimensionParameterShape(_, False)]):
							match compiler_callable_parameter_type(length_values):
								CompilerArrayTypeShape(CompilerIntrinsicTypeShape(CompilerIntrinsicInt, []), [CompilerWildcardDimensionShape(False)]):
									match compiler_callable_parameter_type(receive_values):
										CompilerIntrinsicTypeShape(CompilerIntrinsicChannel, [CompilerIntrinsicTypeShape(CompilerIntrinsicInt, [])]):
											match (
												compiler_callable_parameter_type(entry_args),
												compiler_callable_signature_return_type(
													entry_signature,
												),
											):
												(CompilerPreludeTypeShape(_, [CompilerIntrinsicTypeShape(CompilerIntrinsicString, [])]), CompilerIntrinsicTypeShape(CompilerIntrinsicVoid, [])):
													True
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		),
	)


pure func test_callable_headers_infer_implicit_parameters() -> Bool:
	callable_headers_infer_implicit_parameters().get_or(False)


private pure func global_headers_distinguish_pending_initializers() -> Option[Bool]:
	graph ?= callable_graph("annotated: Int = 1\n\ninferred = 2")
	annotated ?= global_header_by_name(graph, "annotated")
	inferred ?= global_header_by_name(graph, "inferred")

	Some(
		match (annotated, inferred):
			(CompilerAnnotatedGlobalHeader(_), CompilerPendingGlobalInitializer(_)):
				match compiler_annotated_global_header_type(annotated):
					Some(CompilerIntrinsicTypeShape(CompilerIntrinsicInt, [])):
						True
					_:
						False
			_:
				False
	)


pure func test_global_headers_distinguish_pending_initializers() -> Bool:
	global_headers_distinguish_pending_initializers().get_or(False)


private pure func callable_type_errors_are_precise() -> Option[Bool]:
	source = "pure func broken(value: missing_type):\n\t0"
	indexed ?= compiler_indexed_graph_build(module_load_candidate(source), []).to_option()
	bound ?= compiler_bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= compiler_declaration_skeleton_graph_build(bound).to_option()
	aliases ?= compiler_type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= compiler_resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= compiler_type_header_graph_build(parameters).to_option()
	topology ?= compiler_trait_topology_graph_build(type_headers).to_option()

	match compiler_callable_header_graph_build(topology):
		Ok(_):
			Some(False)
		Err(errors):
			error ?= errors.get(0)
			span ?= compiler_callable_header_graph_error_span(error)
			Some(
				(
					compiler_callable_header_graph_error_message(
						error,
					) == "Unknown type 'missing_type' while resolving 'broken'"
					and span.path == "main.brp"
					and span.start_line == 1
				),
			)


pure func test_callable_type_errors_are_precise() -> Bool:
	callable_type_errors_are_precise().get_or(False)


tests: TestSuite = {
	description = "Compiler callable headers",
	tests = [
		("resolve exact signatures", test_callable_headers_resolve_exact_signatures),
		(
			"prepared context rejects foreign parameters",
			test_prepared_context_rejects_foreign_parameters,
		),
		(
			"prepared context resolves dimension constraints",
			test_prepared_context_resolves_dimension_constraints,
		),
		("callable and global ids are exact", test_callable_and_global_ids_are_exact),
		("infer implicit callable parameters", test_callable_headers_infer_implicit_parameters),
		(
			"distinguish pending global initializers",
			test_global_headers_distinguish_pending_initializers,
		),
		("retain callable type error spans", test_callable_type_errors_are_precise),
	]
}
