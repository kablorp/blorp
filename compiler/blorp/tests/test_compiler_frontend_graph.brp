import:
	../src/stage_01_file_io/source: compiler_source_file
	../src/stage_03_parse/language_parser: parse_compiler_source
	../src/stage_03_parse/source_ast_finalize: finalized_typecheck_program
	../src/stage_04_modules/frontend_graph:
		CompilerFrontendGraphError(
			DuplicateCompilerFrontendModule,
			MissingCompilerFrontendEdgeImporter,
			MissingCompilerFrontendEdgeTarget,
		),
		CompilerFrontendImportResolution(
			CompilerFrontendResolvedImport,
			CompilerFrontendUnresolvedImport,
		),
		CompilerFrontendModule,
		compiler_frontend_graph,
		compiler_frontend_graph_direct_dependents,
		compiler_frontend_graph_import_edges,
		compiler_frontend_module,
		compiler_frontend_resolved_import_edge,
		compiler_frontend_unresolved_import_edge,
	../src/stage_04_modules/loaded_module:
		CompilerModuleOrigin(CompilerSourcePackageModule, CompilerUserModule),
		CompilerResolvedModuleIdentity,
		compiler_resolved_module_identities_equal,
		compiler_resolved_module_identity_from_resolver,
	test: TestSuite


private pure func identity(
	canonical_path: String,
	origin: CompilerModuleOrigin,
) -> CompilerResolvedModuleIdentity:
	compiler_resolved_module_identity_from_resolver(canonical_path, origin)


private pure func module(
	canonical_path: String,
	module_name: String,
	origin: CompilerModuleOrigin,
) -> CompilerFrontendModule:
	source = compiler_source_file("/workspace/" + module_name + ".brp", module_name, "VALUE = 1\n")
	compiler_frontend_module(
		identity(canonical_path, origin),
		finalized_typecheck_program(parse_compiler_source(source)),
	)


pure func test_graph_retains_exact_requested_import_and_identity() -> Bool:
	app = module("app/main", "main", CompilerUserModule)
	dependency = module("packages/math/stats", "stats", CompilerSourcePackageModule("math"))
	edge = compiler_frontend_resolved_import_edge(app.identity, "math/stats", dependency.identity)

	match (
		compiler_frontend_graph(
			[app, dependency],
			[app.identity],
			[edge],
		)
	):
		Err(_):
			False
		Ok(graph):
			match compiler_frontend_graph_import_edges(graph):
				[found]:
					match found.resolution:
						CompilerFrontendResolvedImport(target):
							(
								found.requested_path == "math/stats"
								and compiler_resolved_module_identities_equal(
									found.importer,
									app.identity,
								)
								and compiler_resolved_module_identities_equal(
									target,
									dependency.identity,
								)
							)
						_:
							False
				_:
					False


pure func test_graph_retains_explicit_unresolved_outcome() -> Bool:
	app = module("app/main", "main", CompilerUserModule)
	edge = compiler_frontend_unresolved_import_edge(app.identity, "missing/module")

	match compiler_frontend_graph([app], [app.identity], [edge]):
		Err(_):
			False
		Ok(graph):
			match compiler_frontend_graph_import_edges(graph):
				[found]:
					(
						found.requested_path == "missing/module"
						and found.resolution == CompilerFrontendUnresolvedImport
					)
				_:
					False


pure func test_graph_rejects_duplicate_canonical_module() -> Bool:
	first = module("shared", "first", CompilerUserModule)
	second = module("shared", "second", CompilerSourcePackageModule("pkg"))

	match (
		compiler_frontend_graph(
			[first, second],
			[first.identity],
			[],
		)
	):
		Err([DuplicateCompilerFrontendModule(first_identity, second_identity)]):
			(
				compiler_resolved_module_identities_equal(first_identity, first.identity)
				and compiler_resolved_module_identities_equal(second_identity, second.identity)
			)
		_:
			False


pure func test_graph_rejects_missing_edge_endpoints() -> Bool:
	app = module("app/main", "main", CompilerUserModule)
	missing = identity("missing", CompilerUserModule)
	missing_importer = compiler_frontend_unresolved_import_edge(missing, "dep")
	missing_target = compiler_frontend_resolved_import_edge(app.identity, "dep", missing)

	importer_error: Bool = match compiler_frontend_graph([app], [app.identity], [missing_importer]):
		Err([MissingCompilerFrontendEdgeImporter(found)]):
			compiler_resolved_module_identities_equal(found, missing)
		_:
			False

	target_error: Bool = match compiler_frontend_graph([app], [app.identity], [missing_target]):
		Err([MissingCompilerFrontendEdgeTarget(found)]):
			compiler_resolved_module_identities_equal(found, missing)
		_:
			False

	importer_error and target_error


pure func test_graph_derives_reverse_dependency_lookup() -> Bool:
	app = module("app/main", "main", CompilerUserModule)
	middle = module("app/middle", "middle", CompilerUserModule)
	leaf = module("app/leaf", "leaf", CompilerUserModule)
	edges = [
		compiler_frontend_resolved_import_edge(app.identity, "middle", middle.identity),
		compiler_frontend_resolved_import_edge(middle.identity, "leaf", leaf.identity),
	]

	match (
		compiler_frontend_graph(
			[app, middle, leaf],
			[app.identity],
			edges,
		)
	):
		Err(_):
			False
		Ok(graph):
			dependents = compiler_frontend_graph_direct_dependents(graph, leaf.identity)

			match dependents:
				[found]:
					compiler_resolved_module_identities_equal(found, middle.identity)
				_:
					False


tests: TestSuite = {
	description = "Compiler frontend graph model",
	tests = [
		(
			"retain exact requested import and identity",
			test_graph_retains_exact_requested_import_and_identity,
		),
		("retain explicit unresolved outcome", test_graph_retains_explicit_unresolved_outcome),
		("reject duplicate canonical module", test_graph_rejects_duplicate_canonical_module),
		("reject missing import edge endpoints", test_graph_rejects_missing_edge_endpoints),
		("derive reverse dependency lookup", test_graph_derives_reverse_dependency_lookup),
	]
}
