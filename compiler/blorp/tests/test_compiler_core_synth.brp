import:
	../src/stage_09_core/compiler_core_json:
		CoreDecl(FunctionDecl, ImplDecl, ValueRecordDecl),
		CoreFunction,
		CoreFunctionKind(BuiltinFunction, UnresolvedBuiltinFunction),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreTensorDim(TensorStaticDim),
		CoreType(FunctionType, NamedType, TensorType),
		CoreVar,
	../src/stage_09_core/compiler_core_synth: synthesize_program
	../src/stage_09_core/compiler_core_synth_error:
		CoreSynthError(UnsupportedTensorReductionElement),
	test: TestSuite


private INT_TYPE: CoreType = NamedType("Int", [])

private FLOAT_TYPE: CoreType = NamedType("Float", [])

private BOOL_TYPE: CoreType = NamedType("Bool", [])

private BYTES_TYPE: CoreType = NamedType("Bytes", [])

private STRING_TYPE: CoreType = NamedType("String", [])

private LIST_INT_TYPE: CoreType = NamedType("List", [INT_TYPE])

private DICT_INT_TYPE: CoreType = NamedType(
	"Dict",
	[INT_TYPE, INT_TYPE],
)


pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func param(name: String, typ: CoreType) -> CoreParam:
	{
		name = core_var(name),
		typ = typ,
		loc = SyntheticSourceLoc
	}


pure func builtin_function(
	module_name: String,
	source_name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> CoreFunction:
	{
		name = module_name.replace("/", "_") + "__" + source_name + "__mono_fixture",
		source_module = Some(module_name),
		type_params = [],
		params = params,
		return_type = return_type,
		body = None,
		is_pure = True,
		function_kind = UnresolvedBuiltinFunction,
		def_id = 1,
		loc = SyntheticSourceLoc
	}


private pure func function_was_synthesized_kind(kind: CoreFunctionKind) -> Bool:
	match kind:
		UnresolvedBuiltinFunction:
			False
		_:
			True


pure func function_was_promoted(program: CoreProgram, expected_name: String) -> Bool:
	match program.decls:
		[FunctionDecl(function_info)]:
			(
				function_info.name == expected_name
				and function_info.body.is_some()
				and function_was_synthesized_kind(function_info.function_kind)
			)
		_:
			False


pure func program_with(function_info: CoreFunction) -> CoreProgram:
	{
		decls = [FunctionDecl(function_info)],
		foreign_includes = []
	}


pure func function_is_promoted(function_info: CoreFunction) -> Bool:
	match synthesize_program(program_with(function_info)):
		Ok(program):
			function_was_promoted(program, function_info.name)
		Err(_):
			False


pure func test_synthesis_promotes_successful_family_body() -> Bool:
	function_info = builtin_function("std/bytes", "length", [param("bytes", BYTES_TYPE)], INT_TYPE)
	program: CoreProgram = {
		decls = [FunctionDecl(function_info)],
		foreign_includes = []
	}

	match synthesize_program(program):
		Ok(result):
			function_was_promoted(result, function_info.name)
		Err(_):
			False


pure func test_synthesis_dispatches_across_families() -> Bool:
	function_info = builtin_function(
		"std/float",
		"is_finite",
		[param("value", FLOAT_TYPE)],
		BOOL_TYPE,
	)
	program: CoreProgram = {
		decls = [FunctionDecl(function_info)],
		foreign_includes = []
	}

	match synthesize_program(program):
		Ok(result):
			function_was_promoted(result, function_info.name)
		Err(_):
			False


pure func test_synthesis_dispatches_new_family_modules() -> Bool:
	tensor_type: CoreType = TensorType({
		element_type = INT_TYPE,
		dims = [TensorStaticDim(4)],
	})

	[
		builtin_function("std/string", "length", [param("value", STRING_TYPE)], INT_TYPE),
		builtin_function("std/list", "length", [param("values", LIST_INT_TYPE)], INT_TYPE),
		builtin_function("std/dict", "length", [param("values", DICT_INT_TYPE)], INT_TYPE),
		builtin_function(
			"std/vector",
			"parallel",
			[param("values", tensor_type), param(
					"body",
					FunctionType(True, [tensor_type], tensor_type),
				)],
			tensor_type,
		),
	].all(function_is_promoted)


pure func test_synthesis_uses_program_declarations_for_hash_layout() -> Bool:
	widget_type: CoreType = NamedType("Widget", [])
	dict_type: CoreType = NamedType(
		"Dict",
		[widget_type, INT_TYPE],
	)
	function_info: CoreFunction = builtin_function(
		"std/dict",
		"set",
		[param("self", dict_type), param("key", widget_type), param("value", INT_TYPE)],
		dict_type,
	)
	program: CoreProgram = {
		decls = [ValueRecordDecl({
				name = "Widget",
				type_params = [],
				fields = [],
				loc = SyntheticSourceLoc,
			}), FunctionDecl(function_info)],
		foreign_includes = []
	}

	match synthesize_program(program):
		Ok(result):
			match result.decls:
				[ValueRecordDecl(_), FunctionDecl(synthesized)]:
					(
						synthesized.body.is_some()
						and function_was_synthesized_kind(synthesized.function_kind)
					)
				_:
					False
		Err(_):
			False


pure func test_synthesis_propagates_family_error() -> Bool:
	tensor_type: CoreType = TensorType({
		element_type = STRING_TYPE,
		dims = [TensorStaticDim(4)],
	})
	function_info: CoreFunction = builtin_function(
		"std/vector",
		"sum",
		[param("values", tensor_type)],
		STRING_TYPE,
	)

	match synthesize_program(program_with(function_info)):
		Err(UnsupportedTensorReductionElement(name, element_type, _)):
			name == "sum" and element_type == STRING_TYPE
		_:
			False


pure func test_synthesis_records_registry_owned_runtime_identity() -> Bool:
	tensor_type: CoreType = TensorType({
		element_type = INT_TYPE,
		dims = [TensorStaticDim(4)],
	})
	function_info: CoreFunction = builtin_function(
		"std/vector",
		"max",
		[param("values", tensor_type)],
		INT_TYPE,
	)

	match synthesize_program(program_with(function_info)):
		Ok(program):
			match program.decls:
				[FunctionDecl(synthesized)]:
					match synthesized.function_kind:
						BuiltinFunction(runtime_name):
							synthesized.body.is_some() and runtime_name == "blorp_max"
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_synthesis_preserves_unhandled_builtin() -> Bool:
	function_info = builtin_function(
		"std/unported",
		"operation",
		[param("value", INT_TYPE)],
		INT_TYPE,
	)
	program: CoreProgram = {
		decls = [FunctionDecl(function_info)],
		foreign_includes = ["example.h"]
	}

	match synthesize_program(program):
		Ok(result):
			match result.decls:
				[FunctionDecl(unchanged)]:
					unchanged == function_info and result.foreign_includes == ["example.h"]
				_:
					False
		Err(_):
			False


pure func test_synthesis_promotes_concrete_impl_method() -> Bool:
	builtin_method: CoreFunction = builtin_function(
		"std/string",
		"length",
		[param("self", STRING_TYPE)],
		INT_TYPE,
	)
	method: CoreFunction = { builtin_method | name = "length" }
	program: CoreProgram = {
		decls = [ImplDecl({
				trait_name = "HasLength",
				for_type = STRING_TYPE,
				type_params = [],
				methods = [method],
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}

	match synthesize_program(program):
		Ok(result):
			match result.decls:
				[ImplDecl(impl_info)]:
					match impl_info.methods:
						[synthesized]:
							(
								synthesized.name == "length"
								and synthesized.body.is_some()
								and function_was_synthesized_kind(synthesized.function_kind)
							)
						_:
							False
				_:
					False
		Err(_):
			False


tests: TestSuite = {
	description = "Compiler Core synthesis orchestrator",
	tests = [
		(
			"synthesis promotes successful family body",
			test_synthesis_promotes_successful_family_body,
		),
		("synthesis dispatches across families", test_synthesis_dispatches_across_families),
		("synthesis dispatches new family modules", test_synthesis_dispatches_new_family_modules),
		(
			"synthesis uses declarations for hash layouts",
			test_synthesis_uses_program_declarations_for_hash_layout,
		),
		("synthesis propagates family errors", test_synthesis_propagates_family_error),
		(
			"synthesis records registry-owned runtime identity",
			test_synthesis_records_registry_owned_runtime_identity,
		),
		("synthesis preserves unhandled builtin", test_synthesis_preserves_unhandled_builtin),
		("synthesis promotes concrete impl method", test_synthesis_promotes_concrete_impl_method),
	]
}
