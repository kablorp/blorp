import:
	../src/stage_09_core/core_json:
		CoreAccessor(ListElementAccessor, ListSpreadAccessor, RootAccessor),
		CoreBinaryOp(EqualOp),
		CoreCallKind(IntrinsicCall, UserCall),
		CoreConstructorLengthMatchBranch,
		CoreConstructorMatchBody(ConstructorMatchBodyExpr),
		CoreDecl(FunctionDecl),
		CoreExpr(
			BinaryExpr,
			CallExpr,
			CastExpr,
			DropExpr,
			DupExpr,
			FieldExpr,
			IfExpr,
			LengthMatchExpr,
			LetExpr,
			LiteralExpr,
			LogicalExpr,
			RecordConstructExpr,
			SeqExpr,
			UnboxExpr,
			VarExpr,
		),
		CoreFunctionKind(UserFunction),
		CoreLiteral(BoolLiteral, StringLiteral),
		CoreLogicalOp(AndOp),
		CoreMatchBinding,
		CoreMatchBindingMode(MatchBorrowBindingMode, MatchOwnBindingMode),
		CoreParam,
		CoreProgram,
		CoreReleasePolicy(ArcReleasePolicy, NoReleasePolicy),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(HeapRecordType, NamedType),
		CoreUnboxKind(PointerUnbox),
		CoreVar,
	../src/stage_09_core/core_perceus: count_uses, insert_drops_program
	test: TestSuite


union OwnerScrutineeShape:
	DirectOwnerScrutinee
	CastOwnerScrutinee
	UnboxedOwnerScrutinee


pure func variable(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func string_type() -> CoreType:
	NamedType("String", [])


pure func string_list_type() -> CoreType:
	NamedType("List", [string_type()])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func requirement_type() -> CoreType:
	HeapRecordType("PurityRequirement")


pure func requirement_list_type() -> CoreType:
	NamedType("List", [requirement_type()])


pure func var_expr(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(variable(name), typ, SyntheticSourceLoc)


pure func parameter(name: String, typ: CoreType) -> CoreParam:
	{
		name = variable(name),
		typ = typ,
		loc = SyntheticSourceLoc
	}


pure func user_call(
	name: String,
	def_id: Int,
	consumed_args: List[Int],
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(
		UserCall(name, Some(def_id), consumed_args),
		var_expr(
			name,
			NamedType("Function", []),
		),
		args,
		return_type,
		SyntheticSourceLoc,
	)


pure func intrinsic_call(name: String, args: List[CoreExpr], return_type: CoreType) -> CoreExpr:
	CallExpr(
		IntrinsicCall(name),
		var_expr(
			name,
			NamedType("Function", []),
		),
		args,
		return_type,
		SyntheticSourceLoc,
	)


pure func length_branch(
	bindings: List[CoreMatchBinding],
	body: CoreExpr,
) -> CoreConstructorLengthMatchBranch:
	{
		bindings = bindings,
		body = ConstructorMatchBodyExpr(body)
	}


pure func owner_alias_program(
	release_policy: CoreReleasePolicy,
	scrutinee_shape: OwnerScrutineeShape,
) -> CoreProgram:
	comments_type: CoreType = string_list_type()
	result_type: CoreType = HeapRecordType("HeldComments")
	first: CoreMatchBinding = {
		variable = variable("first"),
		typ = string_type(),
		accessor = ListElementAccessor(RootAccessor, 0),
		mode = MatchBorrowBindingMode
	}
	rest: CoreMatchBinding = {
		variable = variable("rest"),
		typ = comments_type,
		accessor = ListSpreadAccessor(RootAccessor, 1),
		mode = MatchOwnBindingMode
	}
	condition: CoreExpr = BinaryExpr(
		EqualOp,
		var_expr("first", string_type()),
		LiteralExpr(StringLiteral("keep"), string_type(), SyntheticSourceLoc),
		bool_type(),
		SyntheticSourceLoc,
	)
	owner: CoreExpr = var_expr("comments", comments_type)

	scrutinee: CoreExpr = match scrutinee_shape:
		DirectOwnerScrutinee:
			owner
		CastOwnerScrutinee:
			CastExpr(owner, comments_type, SyntheticSourceLoc)
		UnboxedOwnerScrutinee:
			UnboxExpr(PointerUnbox, owner, comments_type, SyntheticSourceLoc)

	body: CoreExpr = LengthMatchExpr(
		scrutinee,
		release_policy,
		{
			accessor = RootAccessor,
			cases = [],
			geq = Some({
				minimum_length = 1,
				branch = length_branch(
					[first, rest],
					IfExpr(
						condition,
						RecordConstructExpr(
							"HeldComments",
							[
								{
									name = "remaining",
									value = var_expr("comments", comments_type)
								},
							],
							result_type,
							SyntheticSourceLoc,
						),
						RecordConstructExpr(
							"HeldComments",
							[
								{
									name = "remaining",
									value = var_expr("rest", comments_type)
								},
							],
							result_type,
							SyntheticSourceLoc,
						),
						result_type,
						SyntheticSourceLoc,
					),
				),
			}),
			fallback = None,
			result_type = result_type,
			loc = SyntheticSourceLoc
		},
		result_type,
		SyntheticSourceLoc,
	)

	{
		decls = [FunctionDecl({
				name = "hold_comments",
				source_module = None,
				type_params = [],
				params = [parameter("comments", comments_type)],
				return_type = result_type,
				body = Some(body),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 1,
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}


pure func local_owner_alias_program() -> CoreProgram:
	comments_type: CoreType = requirement_list_type()
	first: CoreMatchBinding = {
		variable = variable("first"),
		typ = requirement_type(),
		accessor = ListElementAccessor(RootAccessor, 0),
		mode = MatchBorrowBindingMode
	}
	field_matches: CoreExpr = BinaryExpr(
		EqualOp,
		FieldExpr(
			var_expr("first", requirement_type()),
			"name",
			string_type(),
			SyntheticSourceLoc,
		),
		LiteralExpr(StringLiteral("keep"), string_type(), SyntheticSourceLoc),
		bool_type(),
		SyntheticSourceLoc,
	)
	condition: CoreExpr = LogicalExpr(
		AndOp,
		field_matches,
		field_matches,
		bool_type(),
		SyntheticSourceLoc,
	)
	match_body: CoreExpr = LengthMatchExpr(
		var_expr(
			"requirements",
			comments_type,
		),
		NoReleasePolicy,
		{
			accessor = RootAccessor,
			cases = [],
			geq = Some({
				minimum_length = 1,
				branch = length_branch([first], condition),
			}),
			fallback = Some(
				length_branch(
					[],
					LiteralExpr(BoolLiteral(False), bool_type(), SyntheticSourceLoc),
				),
			),
			result_type = bool_type(),
			loc = SyntheticSourceLoc
		},
		bool_type(),
		SyntheticSourceLoc,
	)
	branched_match_body: CoreExpr = IfExpr(
		LiteralExpr(BoolLiteral(True), bool_type(), SyntheticSourceLoc),
		match_body,
		LiteralExpr(BoolLiteral(False), bool_type(), SyntheticSourceLoc),
		bool_type(),
		SyntheticSourceLoc,
	)
	body: CoreExpr = LetExpr(
		variable("requirements"),
		False,
		comments_type,
		user_call(
			"requirements_from_comments",
			3,
			[0],
			[var_expr("comments", comments_type)],
			comments_type,
		),
		branched_match_body,
	)

	{
		decls = [FunctionDecl({
				name = "requirements_from_comments",
				source_module = None,
				type_params = [],
				params = [parameter("comments", comments_type)],
				return_type = comments_type,
				body = Some(var_expr("comments", comments_type)),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 3,
				loc = SyntheticSourceLoc,
			}), FunctionDecl({
				name = "has_keep_requirement",
				source_module = None,
				type_params = [],
				params = [parameter("comments", comments_type)],
				return_type = bool_type(),
				body = Some(body),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 2,
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}


pure func direct_owner_return_program() -> CoreProgram:
	requirements_type: CoreType = requirement_list_type()
	requirement: CoreMatchBinding = {
		variable = variable("requirement"),
		typ = requirement_type(),
		accessor = ListElementAccessor(RootAccessor, 0),
		mode = MatchBorrowBindingMode
	}
	inspect_requirement: CoreExpr = FieldExpr(
		var_expr("requirement", requirement_type()),
		"name",
		string_type(),
		SyntheticSourceLoc,
	)
	transfer_requirements: CoreExpr = var_expr("requirements", requirements_type)
	match_body: CoreExpr = LengthMatchExpr(
		var_expr(
			"requirements",
			requirements_type,
		),
		NoReleasePolicy,
		{
			accessor = RootAccessor,
			cases = [],
			geq = Some({
				minimum_length = 1,
				branch = length_branch(
					[requirement],
					SeqExpr(inspect_requirement, transfer_requirements),
				),
			}),
			fallback = Some(length_branch([], var_expr("requirements", requirements_type))),
			result_type = requirements_type,
			loc = SyntheticSourceLoc
		},
		requirements_type,
		SyntheticSourceLoc,
	)
	body: CoreExpr = IfExpr(
		LiteralExpr(BoolLiteral(True), bool_type(), SyntheticSourceLoc),
		match_body,
		var_expr("requirements", requirements_type),
		requirements_type,
		SyntheticSourceLoc,
	)

	{
		decls = [FunctionDecl({
				name = "inspect_and_transfer_requirements",
				source_module = None,
				type_params = [],
				params = [parameter("requirements", requirements_type)],
				return_type = requirements_type,
				body = Some(body),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 4,
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}


pure func rewritten_body() -> Option[CoreExpr]:
	program: CoreProgram = insert_drops_program(
		owner_alias_program(
			NoReleasePolicy,
			DirectOwnerScrutinee,
		),
	)
	var found: Option[CoreExpr] = None

	for decl in program.decls:
		match decl:
			FunctionDecl(function_info):
				found = function_info.body
			_:
				void

	found


pure func rewritten_releasing_body() -> Option[CoreExpr]:
	program: CoreProgram = insert_drops_program(
		owner_alias_program(
			ArcReleasePolicy,
			DirectOwnerScrutinee,
		),
	)
	var found: Option[CoreExpr] = None

	for decl in program.decls:
		match decl:
			FunctionDecl(function_info):
				found = function_info.body
			_:
				void

	found


pure func rewritten_wrapped_releasing_body(shape: OwnerScrutineeShape) -> Option[CoreExpr]:
	program: CoreProgram = insert_drops_program(owner_alias_program(ArcReleasePolicy, shape))
	var found: Option[CoreExpr] = None

	for decl in program.decls:
		match decl:
			FunctionDecl(function_info):
				found = function_info.body
			_:
				void

	found


pure func rewritten_local_owner_body() -> Option[CoreExpr]:
	program: CoreProgram = insert_drops_program(local_owner_alias_program())
	var found: Option[CoreExpr] = None

	for decl in program.decls:
		match decl:
			FunctionDecl(function_info):
				if function_info.name == "has_keep_requirement":
					found = function_info.body
				else:
					void
			_:
				void

	found


pure func rewritten_direct_owner_return_body() -> Option[CoreExpr]:
	program: CoreProgram = insert_drops_program(direct_owner_return_program())
	var found: Option[CoreExpr] = None

	for decl in program.decls:
		match decl:
			FunctionDecl(function_info):
				found = function_info.body
			_:
				void

	found


-- This checks the nested lifetime scopes emitted by the focused branch
-- transformer. It does not model ownership state flowing between sibling
-- expressions; the source ASan regression and generated C cover that order.
pure func owner_drop_precedes_unretained_alias_use(
	owner: String,
	alias_name: String,
	alias_is_owned: Bool,
	expr: CoreExpr,
) -> Bool:
	match expr:
		DropExpr(variable, _, _, body, _, _):
			body_alias_is_owned: Bool = if variable.name == alias_name:
				False
			else:
				alias_is_owned

			(
				variable.name == owner and not alias_is_owned and count_uses(alias_name, body) > 0
				or owner_drop_precedes_unretained_alias_use(
					owner,
					alias_name,
					body_alias_is_owned,
					body,
				)
			)
		DupExpr(variable, _, _, body, _, _):
			owner_drop_precedes_unretained_alias_use(
				owner,
				alias_name,
				alias_is_owned or variable.name == alias_name,
				body,
			)
		LetExpr(_, _, _, rhs, body):
			(
				owner_drop_precedes_unretained_alias_use(owner, alias_name, alias_is_owned, rhs)
				or owner_drop_precedes_unretained_alias_use(owner, alias_name, alias_is_owned, body)
			)
		SeqExpr(first, second):
			(
				owner_drop_precedes_unretained_alias_use(owner, alias_name, alias_is_owned, first)
				or owner_drop_precedes_unretained_alias_use(
					owner,
					alias_name,
					alias_is_owned,
					second,
				)
			)
		IfExpr(condition, then_expr, else_expr, _, _):
			(
				owner_drop_precedes_unretained_alias_use(
					owner,
					alias_name,
					alias_is_owned,
					condition,
				)
				or owner_drop_precedes_unretained_alias_use(
					owner,
					alias_name,
					alias_is_owned,
					then_expr,
				)
				or owner_drop_precedes_unretained_alias_use(
					owner,
					alias_name,
					alias_is_owned,
					else_expr,
				)
			)
		LengthMatchExpr(scrutinee, _, match_expr, _, _):
			var branch_precedes: Bool = False

			for match_case in match_expr.cases:
				match match_case.branch.body:
					ConstructorMatchBodyExpr(body):
						if owner_drop_precedes_unretained_alias_use(
							owner,
							alias_name,
							alias_is_owned,
							body,
						):
							branch_precedes = True
						else:
							void
					_:
						void

			geq_precedes: Bool = match match_expr.geq:
				Some(match_case):
					match match_case.branch.body:
						ConstructorMatchBodyExpr(body):
							owner_drop_precedes_unretained_alias_use(
								owner,
								alias_name,
								alias_is_owned,
								body,
							)
						_:
							False
				None:
					False

			fallback_precedes: Bool = match match_expr.fallback:
				Some(branch):
					match branch.body:
						ConstructorMatchBodyExpr(body):
							owner_drop_precedes_unretained_alias_use(
								owner,
								alias_name,
								alias_is_owned,
								body,
							)
						_:
							False
				None:
					False

			(
				owner_drop_precedes_unretained_alias_use(
					owner,
					alias_name,
					alias_is_owned,
					scrutinee,
				)
				or branch_precedes
				or geq_precedes
				or fallback_precedes
			)
		BinaryExpr(_, left, right, _, _):
			(
				owner_drop_precedes_unretained_alias_use(owner, alias_name, alias_is_owned, left)
				or owner_drop_precedes_unretained_alias_use(
					owner,
					alias_name,
					alias_is_owned,
					right,
				)
			)
		LogicalExpr(_, left, right, _, _):
			(
				owner_drop_precedes_unretained_alias_use(owner, alias_name, alias_is_owned, left)
				or owner_drop_precedes_unretained_alias_use(
					owner,
					alias_name,
					alias_is_owned,
					right,
				)
			)
		RecordConstructExpr(_, fields, _, _):
			fields.any(
				func(
					field,
				): owner_drop_precedes_unretained_alias_use(
					owner,
					alias_name,
					alias_is_owned,
					field.value,
				),
			)
		_:
			False


pure func owner_drop_precedes_alias_use(owner: String, alias_name: String, expr: CoreExpr) -> Bool:
	owner_drop_precedes_unretained_alias_use(owner, alias_name, False, expr)


pure func ownership_operation_count(name: String, expr: CoreExpr) -> (Int, Int):
	match expr:
		DropExpr(variable, _, _, body, _, _):
			(body_dups, body_drops) = ownership_operation_count(name, body)

			drop_increment: Int = if variable.name == name:
				1
			else:
				0

			(body_dups, body_drops + drop_increment)
		DupExpr(variable, _, _, body, _, _):
			(body_dups, body_drops) = ownership_operation_count(name, body)

			dup_increment: Int = if variable.name == name:
				1
			else:
				0

			(body_dups + dup_increment, body_drops)
		LetExpr(_, _, _, rhs, body):
			(rhs_dups, rhs_drops) = ownership_operation_count(name, rhs)
			(body_dups, body_drops) = ownership_operation_count(name, body)
			(rhs_dups + body_dups, rhs_drops + body_drops)
		SeqExpr(first, second):
			(first_dups, first_drops) = ownership_operation_count(name, first)
			(second_dups, second_drops) = ownership_operation_count(name, second)
			(first_dups + second_dups, first_drops + second_drops)
		IfExpr(condition, then_expr, else_expr, _, _):
			(condition_dups, condition_drops) = ownership_operation_count(name, condition)
			(then_dups, then_drops) = ownership_operation_count(name, then_expr)
			(else_dups, else_drops) = ownership_operation_count(name, else_expr)
			(condition_dups + then_dups + else_dups, condition_drops + then_drops + else_drops)
		LengthMatchExpr(scrutinee, _, match_expr, _, _):
			(scrutinee_dups, scrutinee_drops) = ownership_operation_count(name, scrutinee)
			var branch_dups: Int = 0
			var branch_drops: Int = 0

			for match_case in match_expr.cases:
				match match_case.branch.body:
					ConstructorMatchBodyExpr(body):
						(case_dups, case_drops) = ownership_operation_count(name, body)
						branch_dups += case_dups
						branch_drops += case_drops
					_:
						void

			(geq_dups, geq_drops) = match match_expr.geq:
				Some(match_case):
					match match_case.branch.body:
						ConstructorMatchBodyExpr(body):
							ownership_operation_count(name, body)
						_:
							(0, 0)
				None:
					(0, 0)

			(fallback_dups, fallback_drops) = match match_expr.fallback:
				Some(branch):
					match branch.body:
						ConstructorMatchBodyExpr(body):
							ownership_operation_count(name, body)
						_:
							(0, 0)
				None:
					(0, 0)

			(
				scrutinee_dups + branch_dups + geq_dups + fallback_dups,
				scrutinee_drops + branch_drops + geq_drops + fallback_drops,
			)
		BinaryExpr(_, left, right, _, _):
			(left_dups, left_drops) = ownership_operation_count(name, left)
			(right_dups, right_drops) = ownership_operation_count(name, right)
			(left_dups + right_dups, left_drops + right_drops)
		LogicalExpr(_, left, right, _, _):
			(left_dups, left_drops) = ownership_operation_count(name, left)
			(right_dups, right_drops) = ownership_operation_count(name, right)
			(left_dups + right_dups, left_drops + right_drops)
		RecordConstructExpr(_, fields, _, _):
			var dups: Int = 0
			var drops: Int = 0

			for field in fields:
				(field_dups, field_drops) = ownership_operation_count(name, field.value)
				dups += field_dups
				drops += field_drops

			(dups, drops)
		_:
			(0, 0)


-- A retain around the whole branch leaks on paths that do not transfer the owner.
pure func geq_branch_starts_with_owner_dup(name: String, expr: CoreExpr) -> Bool:
	match expr:
		LengthMatchExpr(_, _, match_expr, _, _):
			match match_expr.geq:
				Some(match_case):
					match match_case.branch.body:
						ConstructorMatchBodyExpr(DupExpr(variable, _, _, _, _, _)):
							variable.name == name
						_:
							False
				None:
					False
		_:
			False


pure func test_transferred_owner_promotes_borrowed_binding_for_branch() -> Bool:
	match rewritten_body():
		Some(body):
			(owner_dups, owner_drops) = ownership_operation_count("comments", body)
			(alias_dups, alias_drops) = ownership_operation_count("first", body)
			(rest_dups, rest_drops) = ownership_operation_count("rest", body)

			(
				not owner_drop_precedes_alias_use("comments", "first", body)
				and not geq_branch_starts_with_owner_dup("comments", body)
				and owner_dups == 0
				and owner_drops == 1
				and alias_dups == 1
				and alias_drops == 2
				and rest_dups == 0
				and rest_drops == 1
			)
		None:
			False


pure func test_releasing_match_reserves_transferred_owner() -> Bool:
	match rewritten_releasing_body():
		Some(body):
			(owner_dups, owner_drops) = ownership_operation_count("comments", body)
			(alias_dups, alias_drops) = ownership_operation_count("first", body)

			(
				not owner_drop_precedes_alias_use("comments", "first", body)
				and not geq_branch_starts_with_owner_dup("comments", body)
				and owner_dups == 1
				and owner_drops == 0
				and alias_dups == 0
				and alias_drops == 0
			)
		None:
			False


pure func wrapped_releasing_match_reserves_owner(shape: OwnerScrutineeShape) -> Bool:
	match rewritten_wrapped_releasing_body(shape):
		Some(body):
			(owner_dups, owner_drops) = ownership_operation_count("comments", body)

			owner_dups == 1 and owner_drops == 0
		None:
			False


pure func test_cast_releasing_match_reserves_owner() -> Bool:
	wrapped_releasing_match_reserves_owner(CastOwnerScrutinee)


pure func test_unboxed_releasing_match_reserves_owner() -> Bool:
	wrapped_releasing_match_reserves_owner(UnboxedOwnerScrutinee)


pure func test_borrowed_binding_keeps_local_owner_live() -> Bool:
	match rewritten_local_owner_body():
		Some(body):
			(owner_dups, owner_drops) = ownership_operation_count("requirements", body)
			(alias_dups, alias_drops) = ownership_operation_count("first", body)

			(
				not owner_drop_precedes_alias_use("requirements", "first", body)
				and owner_dups == 0
				and owner_drops == 3
				and alias_dups == 1
				and alias_drops == 1
			)
		None:
			False


pure func test_borrowed_binding_precedes_direct_owner_return() -> Bool:
	match rewritten_direct_owner_return_body():
		Some(body):
			(owner_dups, owner_drops) = ownership_operation_count("requirements", body)
			(alias_dups, alias_drops) = ownership_operation_count("requirement", body)

			(
				not owner_drop_precedes_alias_use("requirements", "requirement", body)
				and owner_dups == 3
				and owner_drops == 0
				and alias_dups == 0
				and alias_drops == 0
			)
		None:
			False


