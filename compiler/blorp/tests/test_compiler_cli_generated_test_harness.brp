import:
	../src/stage_01_file_io/source: compiler_source_file
	../src/stage_03_parse/language_parser: parse_compiler_source
	../src/stage_03_parse/parsed_ast: parsed_program_ok
	../src/stage_12_cli/cli_generated_test_harness:
		GeneratedTestSuiteTarget,
		generate_doctest_batch_module,
		generate_single_suite_module,
		generate_suite_batch_module,
	test: TestSuite


private pure func test_target() -> GeneratedTestSuiteTarget:
	{
		path = "tests/test_blorp/example.brp",
		module_name = "example"
	}


private pure func second_test_target() -> GeneratedTestSuiteTarget:
	{
		path = "tests/test_blorp/other.brp",
		module_name = "other"
	}


private func test_suite_batch_harness_runs_all_targets_and_aggregates_results() -> Bool:
	generated = generate_suite_batch_module(
		[test_target(), second_test_target()],
		False,
		True,
	)
	source: String = generated.source.source_text

	(
		generated.source.path.ends_with("/__suite_batch_harness__.brp")
		and generated.source.module_name == "__suite_batch_harness__"
		and source.contains("run_suite_result(T0.tests)")
		and source.contains("run_suite_result(T1.tests)")
		and source.contains("passed += result_0[0]")
		and source.contains("failed += result_1[1]")
		and source.contains("print_error(\"BLORP_TEST_ARTIFACT_RESULT")
		and source.contains("BLORP_TEST_ARTIFACT_RESULT")
		and source
			.split("BLORP_TEST_ARTIFACT_RESULT")
			.length() == 3
		and generated.imports.length() == 2
		and generated.imports.any(func(binding): binding.source_path == test_target().path)
		and generated.imports.any(func(binding): binding.source_path == second_test_target().path)
	)


private func test_doctest_batch_harness_runs_all_targets_and_aggregates_results() -> Bool:
	generated = generate_doctest_batch_module(
		[test_target(), second_test_target()],
		True,
	)
	source: String = generated.source.source_text

	(
		generated.source.path.ends_with("/__doctest_batch_harness__.brp")
		and source.contains("D0.__blorp_run_doctests()")
		and source.contains("D1.__blorp_run_doctests()")
		and source.contains("passed += doctest_passed_0")
		and source.contains("failed += doctest_failed_1")
		and source.contains("print_error(\"BLORP_TEST_ARTIFACT_RESULT")
		and source.contains("BLORP_TEST_ARTIFACT_RESULT")
		and source
			.split("BLORP_TEST_ARTIFACT_RESULT")
			.length() == 3
		and generated.imports.length() == 2
	)


private func test_single_suite_harness_calls_test_runner_directly() -> Bool:
	generated = generate_single_suite_module(test_target(), False, True)
	source: String = generated.source.source_text
	program = parse_compiler_source(
		compiler_source_file(
			generated.source.path,
			generated.source.module_name,
			source,
		),
	)

	(
		parsed_program_ok(program)
		and generated.source.path.ends_with("/__single_suite_harness__.brp")
		and generated.source.module_name == "__single_suite_harness__"
		and source.contains("std/test: run_suite_result")
		and source.contains("run_suite_result(T.tests)")
		and source.contains("BLORP_TEST_ARTIFACT_RESULT")
		and not source.contains("parse_int")
		and not source.contains("get(args")
		and generated.imports.length() == 1
		and generated.imports.any(
			func(
				binding,
			): (
				binding.module_path == "./__blorp_generated_test_target"
				and binding.source_path == "tests/test_blorp/example.brp"
				and binding.source_module == "example"
			),
		)
	)


private func test_single_suite_harness_selects_leak_runner_explicitly() -> Bool:
	source: String = generate_single_suite_module(test_target(), True, False).source.source_text

	(
		source.contains("std/test: run_suite_leak_check_result")
		and source.contains("run_suite_leak_check_result(T.tests)")
		and not source.contains("BLORP_TEST_ARTIFACT_RESULT")
	)


tests: TestSuite = {
	description = "Blorp-owned generated test harnesses",
	tests = [
		(
			"doctest batch runs all targets and aggregates results",
			test_doctest_batch_harness_runs_all_targets_and_aggregates_results,
		),
		(
			"suite batch runs all targets and aggregates results",
			test_suite_batch_harness_runs_all_targets_and_aggregates_results,
		),
		(
			"single suite calls test runner directly",
			test_single_suite_harness_calls_test_runner_directly,
		),
		(
			"single suite selects leak runner explicitly",
			test_single_suite_harness_selects_leak_runner_explicitly,
		),
	]
}
