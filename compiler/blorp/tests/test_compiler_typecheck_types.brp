import:
	../src/stage_01_file_io/compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_03_parse/compiler_parsed_ast:
		ParsedDimBinaryOp(ParsedDimAddOp),
		ParsedIdentifier,
		ParsedTypeExpr(
			ParsedArrayType,
			ParsedDimBinaryType,
			ParsedDimLiteralType,
			ParsedDimNameType,
			ParsedFunctionType,
			ParsedNamedType,
			ParsedQualifiedNamedType,
			ParsedRangeType,
			ParsedTupleType,
		),
		ParsedTypeParamDecl,
		parsed_identifier,
	../src/stage_05_types/compiler_generic_params: compiler_bound_type_param_to_parser_string
	../src/stage_05_types/compiler_type:
		CompilerDimOp(CompilerDimAdd),
		CompilerType(
			CompilerArrayType,
			CompilerConstIntType,
			CompilerDimOpType,
			CompilerFunctionType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerSelfType,
			CompilerTupleType,
			CompilerTypeVar,
			CompilerVarDimsType,
		),
		compiler_type_int,
		compiler_types_equal,
	../src/stage_06_typecheck/compiler_typecheck_types:
		compiler_bound_type_param_from_parsed,
		compiler_type_from_parsed_type_expr,
		compiler_type_param_names,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("types.brp", "types", "func main(): 0")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], source_span())


pure func type_param(name: String, bounds: List[String]) -> ParsedTypeParamDecl:
	{
		name = ident(name),
		bounds = bounds.map(ident),
		span = source_span()
	}


func test_projects_named_and_qualified_types() -> Bool:
	list_int = ParsedNamedType(ident("List"), [named_type("Int")], source_span())
	qualified = ParsedQualifiedNamedType(ident("Math"), ident("Vector"), [], source_span())

	compiler_types_equal(
		compiler_type_from_parsed_type_expr(list_int),
		CompilerNamedType("List", [compiler_type_int()]),
	) and compiler_types_equal(
		compiler_type_from_parsed_type_expr(qualified),
		CompilerNamedType("Math.Vector", []),
	) and compiler_types_equal(
		compiler_type_from_parsed_type_expr(named_type("Self")),
		CompilerSelfType,
	)


func test_projects_arrays_and_dimension_types() -> Bool:
	array_type = ParsedArrayType(
		named_type("Float"),
		[ParsedDimNameType(ident("#N"), False, source_span()), ParsedDimBinaryType(
				ParsedDimAddOp,
				ParsedDimNameType(ident("#M"), False, source_span()),
				ParsedDimLiteralType("1", source_span()),
				source_span(),
			), ParsedDimNameType(ident("#Ds"), True, source_span())],
		source_span(),
	)

	compiler_types_equal(
		compiler_type_from_parsed_type_expr(array_type),
		CompilerArrayType(
			CompilerNamedType(
				"Float",
				[],
			),
			[
				CompilerTypeVar("#N"),
				CompilerDimOpType(CompilerDimAdd, CompilerTypeVar("#M"), CompilerConstIntType(1)),
				CompilerVarDimsType("#Ds"),
			],
		),
	)


func test_projects_range_tuple_and_function_types() -> Bool:
	function_type = ParsedFunctionType(
		True,
		[
			ParsedTupleType(
				[named_type("Int"), named_type("String")],
				source_span(),
			),
			ParsedRangeType(
				ParsedDimLiteralType("4", source_span()),
				source_span(),
			),
		],
		named_type("Bool"),
		source_span(),
	)

	compiler_types_equal(
		compiler_type_from_parsed_type_expr(function_type),
		CompilerFunctionType(
			True,
			[CompilerTupleType([
					CompilerNamedType("Int", []),
					CompilerNamedType("String", []),
				]), CompilerRangeType(CompilerConstIntType(4))],
			CompilerNamedType(
				"Bool",
				[],
			),
		),
	)


func test_projects_type_parameter_bounds() -> Bool:
	params = [
		type_param(
			"T",
			["Orderable", "Stringable"],
		),
		type_param("Item", []),
	]
	first = compiler_bound_type_param_from_parsed(params.get_or(0, type_param("T", [])))

	(
		compiler_type_param_names(params) == ["T", "Item"]
		and compiler_bound_type_param_to_parser_string(first) == "T:Orderable+Stringable"
	)


func test_projection_preserves_parsed_type_ownership() -> Bool:
	parsed = ParsedNamedType(ident("List"), [named_type("String")], source_span())
	projected = compiler_type_from_parsed_type_expr(parsed)

	parsed_name = match parsed:
		ParsedNamedType(name, _, _):
			name.text
		_:
			""

	parsed_name == "List" and compiler_types_equal(
		projected,
		CompilerNamedType("List", [CompilerNamedType("String", [])]),
	)


tests: TestSuite = {
	description = "Compiler typecheck type projection",
	tests = [
		("projects named and qualified types", test_projects_named_and_qualified_types),
		("projects arrays and dimension types", test_projects_arrays_and_dimension_types),
		("projects range tuple and function types", test_projects_range_tuple_and_function_types),
		("projects type parameter bounds", test_projects_type_parameter_bounds),
		(
			"projection preserves parsed type ownership",
			test_projection_preserves_parsed_type_ownership,
		),
	]
}
