import:
	../src/stage_05_types/compiler_generic_params:
		compiler_bound_type_param_name,
		compiler_bound_type_param_to_parser_string,
		compiler_make_bound_type_param,
		compiler_param_names,
		compiler_trait_ref,
		compiler_trait_ref_name,
		compiler_trait_ref_names,
	test: TestSuite


func test_source_spelling() -> Bool:
	bounded = compiler_make_bound_type_param(
		"T",
		["Stringable", "Showable"],
	)
	unbounded = compiler_make_bound_type_param("U", [])

	(
		compiler_bound_type_param_name(bounded) == "T"
		and compiler_trait_ref_names(bounded.bounds) == ["Stringable", "Showable"]
		and compiler_bound_type_param_to_parser_string(bounded) == "T:Stringable+Showable"
		and compiler_bound_type_param_name(unbounded) == "U"
		and compiler_trait_ref_names(unbounded.bounds).length() == 0
		and compiler_bound_type_param_to_parser_string(unbounded) == "U"
	)


func test_param_list_helpers() -> Bool:
	params = [
		compiler_make_bound_type_param("T", ["Equatable"]),
		compiler_make_bound_type_param("U", []),
	]

	(
		compiler_param_names(params) == ["T", "U"]
		and params.map(compiler_bound_type_param_to_parser_string) == ["T:Equatable", "U"]
	)


func test_constructor_helpers() -> Bool:
	param = compiler_make_bound_type_param(
		"Item",
		["Hashable", "Equatable"],
	)

	(
		compiler_bound_type_param_name(param) == "Item"
		and compiler_trait_ref_name(compiler_trait_ref("Hashable")) == "Hashable"
		and compiler_trait_ref_names(param.bounds) == ["Hashable", "Equatable"]
	)


tests: TestSuite = {
	description = "Compiler generic parameter helpers",
	tests = [
		("source spelling", test_source_spelling),
		("param list helpers", test_param_list_helpers),
		("constructor helpers", test_constructor_helpers),
	]
}
