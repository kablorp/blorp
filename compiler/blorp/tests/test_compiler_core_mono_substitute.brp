import:
	../src/stage_09_core/core_json:
		CoreAccessor(RootAccessor, TupleFieldAccessor),
		CoreBoxKind(PrimBox),
		CoreConstructorMatchBody(ConstructorMatchBodyExpr, ConstructorMatchBodyLiteral),
		CoreDecl(
			FunctionDecl,
			GlobalDecl,
			HeapRecordDecl,
			ImplDecl,
			TraitDecl,
			TypeAliasDecl,
			UnionDecl,
			ValueRecordDecl,
		),
		CoreExpr(
			BoxExpr,
			ClosureCreateExpr,
			ConcurrentExpr,
			DetachExpr,
			ForRangeExpr,
			LambdaExpr,
			LengthMatchExpr,
			ListHandoffExpr,
			LiteralExpr,
			LiteralMatchExpr,
			ResourceScopeExpr,
			SelectExpr,
			TailrecListSpreadLoopExpr,
			VarExpr,
		),
		CoreFunctionKind(ClosureBodyFunction, UserFunction),
		CoreListHandoffMode(BorrowFreshHandoff),
		CoreListHandoffWriteOrder(ForwardCompactingHandoff),
		CoreListStorageLayout(PointerListStorage),
		CoreLiteral(IntLiteral),
		CoreLiteralMatchFallback(LiteralMatchFallbackFail),
		CoreLoopRangeDirection(RangeMayRunBackward),
		CoreMatchBindingMode(MatchBorrowBindingMode),
		CoreProgram,
		CoreReleasePolicy(NoReleasePolicy),
		CoreSelectArmKind(SelectRecvArm),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreTaskCaptureKind(TaskCopyCapture),
		CoreType(FunctionType, NamedType, TypeParameterType),
		CoreUnionPayloadStorage(TypedUnionPayloadStorage),
		CoreVar,
		core_expr_to_json,
		core_program_to_json,
	../src/stage_09_core/core_mono:
		CoreMonoSubstitution,
		CoreMonoSubstitutionValue(TypeSubstitution),
	../src/stage_09_core/core_mono_substitute:
		substitute_core_decl_types,
		substitute_core_expr_types,
	test: TestSuite


pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


pure func type_parameter(name: String) -> CoreType:
	TypeParameterType(name)


pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func type_substitution(source_name: String, target_name: String) -> CoreMonoSubstitution:
	[(source_name, TypeSubstitution(named_type(target_name)))]


pure func literal_expr(typ: CoreType) -> CoreExpr:
	LiteralExpr(IntLiteral(1), typ, SyntheticSourceLoc)


pure func lambda_expr(typ: CoreType) -> CoreExpr:
	LambdaExpr(
		[
			{
				name = named_var("value"),
				typ = typ,
				loc = SyntheticSourceLoc
			},
		],
		typ,
		VarExpr(
			named_var("value"),
			typ,
			SyntheticSourceLoc,
		),
		True,
		FunctionType(
			True,
			[typ],
			typ,
		),
		SyntheticSourceLoc,
	)


pure func handoff_expr(typ: CoreType) -> CoreExpr:
	ListHandoffExpr(
		{
			mode = BorrowFreshHandoff,
			layout = PointerListStorage,
			elem_needs_release = False,
			source = BoxExpr(
				{
					kind = PrimBox,
					value = literal_expr(typ),
					source_type = typ
				},
				typ,
				SyntheticSourceLoc,
			),
			source_var = named_var("source"),
			source_type = typ,
			result_type = typ,
			capacity = literal_expr(named_type("Int")),
			result_var = named_var("result"),
			len_var = named_var("length"),
			out_var = named_var("out"),
			body = VarExpr(named_var("result"), typ, SyntheticSourceLoc),
			write_order = ForwardCompactingHandoff
		},
		typ,
		SyntheticSourceLoc,
	)


pure func loop_expr(typ: CoreType) -> CoreExpr:
	ForRangeExpr(
		{
			variable = named_var("item"),
			typ = typ,
			range_direction = RangeMayRunBackward
		},
		literal_expr(named_type("Int")),
		literal_expr(named_type("Int")),
		VarExpr(
			named_var("item"),
			typ,
			SyntheticSourceLoc,
		),
		typ,
		SyntheticSourceLoc,
	)


pure func detach_expr(typ: CoreType) -> CoreExpr:
	DetachExpr(
		{
			function_name = "task",
			def_id = 1,
			c_name = "task",
			static_name = "task",
			captures = [
				{
					name = "value",
					typ = typ,
					kind = TaskCopyCapture
				},
			],
			return_type = typ
		},
		typ,
		SyntheticSourceLoc,
	)


pure func literal_match_expr(typ: CoreType) -> CoreExpr:
	LiteralMatchExpr(
		literal_expr(typ),
		[
			{
				literal = IntLiteral(1),
				bindings = [
					{
						variable = named_var("value"),
						typ = typ,
						accessor = TupleFieldAccessor(RootAccessor, 0, typ),
						mode = MatchBorrowBindingMode
					},
				],
				body = VarExpr(named_var("value"), typ, SyntheticSourceLoc)
			},
		],
		LiteralMatchFallbackFail,
		typ,
		SyntheticSourceLoc,
	)


pure func concurrent_select_expr(typ: CoreType) -> CoreExpr:
	closure: CoreExpr = ClosureCreateExpr(
		{
			function_name = "closure",
			def_id = 10,
			c_name = "closure",
			static_name = "closure_static",
			captures = [
				{
					name = "captured",
					typ = typ
				},
			]
		},
		typ,
		SyntheticSourceLoc,
	)
	select_expr: CoreExpr = SelectExpr(
		[
			{
				kind = SelectRecvArm({
					binder = named_var("received"),
					elem_type = typ,
					channel = VarExpr(named_var("channel"), typ, SyntheticSourceLoc),
				}),
				body = VarExpr(named_var("received"), typ, SyntheticSourceLoc),
				loc = SyntheticSourceLoc
			},
		],
		typ,
		SyntheticSourceLoc,
	)

	ConcurrentExpr(
		{
			bindings = [
				{
					variable = named_var("value"),
					typ = typ,
					rhs = closure,
					task = {
						function_name = "task",
						def_id = 11,
						c_name = "task",
						static_name = "task_static",
						captures = [
							{
								name = "captured",
								typ = typ,
								kind = TaskCopyCapture
							},
						],
						return_type = typ
					}
				},
			],
			body = select_expr,
			timeout = Some(literal_expr(named_type("Int"))),
			max_threads = Some(2)
		},
		typ,
		SyntheticSourceLoc,
	)


pure func resource_tailrec_expr(typ: CoreType) -> CoreExpr:
	tailrec_body: CoreExpr = TailrecListSpreadLoopExpr(
		{
			params = [
				{
					name = named_var("value"),
					typ = typ,
					loc = SyntheticSourceLoc
				},
			],
			return_type = typ,
			list_index = 0,
			list_param = {
				name = named_var("items"),
				typ = typ,
				loc = SyntheticSourceLoc
			},
			cursor = named_var("cursor"),
			layout = PointerListStorage,
			body = VarExpr(named_var("value"), typ, SyntheticSourceLoc)
		},
		SyntheticSourceLoc,
	)

	ResourceScopeExpr(
		{
			variable = named_var("resource"),
			typ = typ,
			acquire = literal_expr(typ),
			body = tailrec_body,
			cleanup = literal_expr(typ)
		},
		typ,
		SyntheticSourceLoc,
	)


pure func constructor_length_expr(typ: CoreType) -> CoreExpr:
	binding = {
		variable = named_var("value"),
		typ = typ,
		accessor = TupleFieldAccessor(RootAccessor, 0, typ),
		mode = MatchBorrowBindingMode
	}
	nested_literal_match = {
		accessor = TupleFieldAccessor(RootAccessor, 1, typ),
		scrutinee_type = typ,
		cases = [
			{
				literal = IntLiteral(1),
				bindings = [binding],
				body = VarExpr(named_var("value"), typ, SyntheticSourceLoc)
			},
		],
		fallback = LiteralMatchFallbackFail,
		result_type = typ,
		loc = SyntheticSourceLoc
	}

	LengthMatchExpr(
		literal_expr(typ),
		NoReleasePolicy,
		{
			accessor = TupleFieldAccessor(RootAccessor, 0, typ),
			cases = [
				{
					length = 1,
					branch = {
						bindings = [binding],
						body = ConstructorMatchBodyLiteral(nested_literal_match)
					}
				},
			],
			geq = Some({
				minimum_length = 2,
				branch = {
					bindings = [binding],
					body = ConstructorMatchBodyExpr(literal_expr(typ))
				},
			}),
			fallback = Some({
				bindings = [],
				body = ConstructorMatchBodyExpr(literal_expr(typ)),
			}),
			result_type = typ,
			loc = SyntheticSourceLoc
		},
		typ,
		SyntheticSourceLoc,
	)


pure func core_exprs_equal(left: CoreExpr, right: CoreExpr) -> Bool:
	core_expr_to_json(left).to_string() == core_expr_to_json(right).to_string()


pure func function_decl(typ: CoreType, closure_body: Bool) -> CoreDecl:
	params = [
		{
			name = named_var("value"),
			typ = typ,
			loc = SyntheticSourceLoc
		},
	]

	function_kind = if closure_body:
		ClosureBodyFunction({
			c_name = "identity_closure",
			params = [
				{
					name = named_var("captured"),
					typ = typ,
					loc = SyntheticSourceLoc
				},
			],
			captures = [
				{
					name = "captured",
					typ = typ
				},
			],
			moved_captures = [],
			task_abi = False,
		})
	else:
		UserFunction

	FunctionDecl({
		name = "identity",
		source_module = None,
		type_params = ["T"],
		params = params,
		return_type = typ,
		body = Some(VarExpr(named_var("value"), typ, SyntheticSourceLoc)),
		is_pure = True,
		function_kind = function_kind,
		def_id = 1,
		loc = SyntheticSourceLoc,
	})


pure func declaration_program(typ: CoreType) -> CoreProgram:
	method_decl = {
		name = "method",
		source_module = None,
		type_params = [],
		params = [
			{
				name = named_var("value"),
				typ = typ,
				loc = SyntheticSourceLoc
			},
		],
		return_type = typ,
		body = Some(literal_expr(typ)),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 8,
		loc = SyntheticSourceLoc
	}

	{
		decls = [
			function_decl(typ, True),
			GlobalDecl({
				name = named_var("global"),
				source_module = None,
				typ = typ,
				init = literal_expr(typ),
				is_mutable = False,
				is_const = False,
				is_private = False,
				def_id = 2,
				loc = SyntheticSourceLoc,
			}),
			UnionDecl({
				name = "Maybe",
				type_params = ["T"],
				payload_storage = TypedUnionPayloadStorage,
				variants = [
					{
						name = "Some",
						c_name = "maybe_some",
						tag_c_name = "MAYBE_SOME",
						tag = 1,
						fields = [
							{
								typ = typ,
								release_policy = NoReleasePolicy
							},
						],
						def_id = Some(3)
					},
				],
				loc = SyntheticSourceLoc,
			}),
			ValueRecordDecl({
				name = "Pair",
				type_params = ["T"],
				fields = [
					{
						name = "value",
						typ = typ
					},
				],
				loc = SyntheticSourceLoc,
			}),
			HeapRecordDecl({
				name = "Box",
				type_params = ["T"],
				fields = [
					{
						name = "value",
						typ = typ,
						release_policy = NoReleasePolicy
					},
				],
				loc = SyntheticSourceLoc,
			}),
			TypeAliasDecl({
				name = "Alias",
				type_params = ["T"],
				target = typ,
				is_opaque = False,
				loc = SyntheticSourceLoc,
			}),
			TraitDecl({
				name = "Identity",
				type_params = ["T"],
				supertraits = [],
				methods = [
					{
						name = "identity",
						params = [
							{
								name = named_var("value"),
								typ = typ,
								loc = SyntheticSourceLoc
							},
						],
						return_type = typ,
						is_pure = True,
						loc = SyntheticSourceLoc
					},
				],
				loc = SyntheticSourceLoc,
			}),
			ImplDecl({
				trait_name = "Identity",
				for_type = typ,
				type_params = [
					{
						name = "T",
						bounds = []
					},
				],
				methods = [method_decl],
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = ["stdint.h"]
	}


pure func core_programs_equal(left: CoreProgram, right: CoreProgram) -> Bool:
	core_program_to_json(left).to_string() == core_program_to_json(right).to_string()


func test_substitutes_lambda_types_once() -> Bool:
	core_exprs_equal(
		substitute_core_expr_types(
			type_substitution("T", "Int"),
			lambda_expr(type_parameter("T")),
		),
		lambda_expr(named_type("Int")),
	)


func test_substitutes_literal_result_type() -> Bool:
	core_exprs_equal(
		substitute_core_expr_types(
			type_substitution("T", "Int"),
			literal_expr(type_parameter("T")),
		),
		literal_expr(named_type("Int")),
	)


func test_substitutes_box_and_list_handoff_types() -> Bool:
	core_exprs_equal(
		substitute_core_expr_types(
			type_substitution("T", "Int"),
			handoff_expr(type_parameter("T")),
		),
		handoff_expr(named_type("Int")),
	)


func test_substitutes_loop_and_task_metadata() -> Bool:
	core_exprs_equal(
		substitute_core_expr_types(
			type_substitution("T", "Int"),
			loop_expr(type_parameter("T")),
		),
		loop_expr(named_type("Int")),
	) and core_exprs_equal(
		substitute_core_expr_types(
			type_substitution("T", "Int"),
			detach_expr(type_parameter("T")),
		),
		detach_expr(named_type("Int")),
	)


func test_substitutes_compiled_match_metadata() -> Bool:
	core_exprs_equal(
		substitute_core_expr_types(
			type_substitution("T", "Int"),
			literal_match_expr(type_parameter("T")),
		),
		literal_match_expr(named_type("Int")),
	)


func test_substitutes_concurrent_select_metadata() -> Bool:
	core_exprs_equal(
		substitute_core_expr_types(
			type_substitution("T", "Int"),
			concurrent_select_expr(type_parameter("T")),
		),
		concurrent_select_expr(named_type("Int")),
	)


func test_substitutes_resource_tailrec_metadata() -> Bool:
	core_exprs_equal(
		substitute_core_expr_types(
			type_substitution("T", "Int"),
			resource_tailrec_expr(type_parameter("T")),
		),
		resource_tailrec_expr(named_type("Int")),
	)


func test_substitutes_nested_constructor_match_metadata() -> Bool:
	core_exprs_equal(
		substitute_core_expr_types(
			type_substitution("T", "Int"),
			constructor_length_expr(type_parameter("T")),
		),
		constructor_length_expr(named_type("Int")),
	)


func test_substitutes_declaration_types() -> Bool:
	source: CoreProgram = declaration_program(type_parameter("T"))
	expected: CoreProgram = declaration_program(named_type("Int"))
	var equal: Bool = source.decls.length() == expected.decls.length()
	var index: Int = 0

	while equal and index < source.decls.length():
		match (source.decls.get(index), expected.decls.get(index)):
			(Some(source_decl), Some(expected_decl)):
				equal = core_programs_equal(
					{
						decls = [substitute_core_decl_types(
								type_substitution("T", "Int"),
								source_decl,
							)],
						foreign_includes = []
					},
					{
						decls = [expected_decl],
						foreign_includes = []
					},
				)
			_:
				equal = False

		index += 1

	equal


tests: TestSuite = {
	description = "Blorp compiler Core monomorphization type substitution",
	tests = [
		("substitutes lambda types once", test_substitutes_lambda_types_once),
		("substitutes literal result type", test_substitutes_literal_result_type),
		("substitutes box and list handoff types", test_substitutes_box_and_list_handoff_types),
		("substitutes loop and task metadata", test_substitutes_loop_and_task_metadata),
		("substitutes compiled match metadata", test_substitutes_compiled_match_metadata),
		("substitutes concurrent select metadata", test_substitutes_concurrent_select_metadata),
		("substitutes resource tailrec metadata", test_substitutes_resource_tailrec_metadata),
		(
			"substitutes nested constructor match metadata",
			test_substitutes_nested_constructor_match_metadata,
		),
		("substitutes declaration types", test_substitutes_declaration_types),
	]
}
