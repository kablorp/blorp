import:
	../src/stage_03_parse/compiler_parsed_ast: ParsedBinaryOp(ParsedAddOp)
	../src/stage_05_types/compiler_context: compiler_context_empty, compiler_fresh_meta_with_origin
	../src/stage_05_types/compiler_type:
		CompilerType(
			CompilerConstIntType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerTupleType,
			CompilerTypeVar,
			CompilerVarDimsType,
		),
		compiler_type_char,
		compiler_type_int,
		compiler_type_string,
		compiler_types_equal,
	../src/stage_05_types/compiler_type_widening:
		CompilerCollectionKind(CompilerListLiteral, CompilerVectorLiteral),
		CompilerTypeWideningDecision(CompilerTypeKeep, CompilerTypeWiden),
		CompilerTypeWideningReason(
			CompilerArgumentSlot,
			CompilerBitwiseOperator,
			CompilerCollectionElement,
			CompilerMethodReceiver,
			CompilerMutableBinding,
			CompilerNumericOperator,
			CompilerRangeProofErasure,
			CompilerTupleLiteral,
		),
		CompilerValueSlot(CompilerKeptValueSlot, CompilerWidenedValueSlot),
		compiler_argument_slot,
		compiler_argument_target_slot,
		compiler_bitwise_operand_target_slot,
		compiler_collection_element_slot,
		compiler_collection_element_target_slot,
		compiler_is_scalar_int_value_type,
		compiler_method_receiver_slot,
		compiler_mutable_binding_slot,
		compiler_numeric_operand_slot,
		compiler_range_proof_slot,
		compiler_scalar_int_value_type,
		compiler_tuple_literal_slot,
		compiler_widening_decision,
		compiler_widening_reason,
		compiler_widening_reasons_equal,
		compiler_widening_semantic_type,
		compiler_widening_value_type,
	test: TestSuite


func test_value_slot_encodes_widening_without_a_nested_decision() -> Bool:
	kept = compiler_mutable_binding_slot(compiler_type_int())
	widened = compiler_mutable_binding_slot(CompilerConstIntType(1))

	match (kept, widened):
		(CompilerKeptValueSlot(kept_type), CompilerWidenedValueSlot(semantic_type, value_type, reason)):
			(
				compiler_types_equal(kept_type, compiler_type_int())
				and compiler_types_equal(semantic_type, CompilerConstIntType(1))
				and compiler_types_equal(value_type, compiler_type_int())
				and compiler_widening_reasons_equal(reason, CompilerMutableBinding)
			)
		_:
			False


func test_mutable_binding_slot_preserves_semantic_type() -> Bool:
	slot = compiler_mutable_binding_slot(CompilerConstIntType(1))

	(
		compiler_types_equal(compiler_widening_semantic_type(slot), CompilerConstIntType(1))
		and compiler_types_equal(compiler_widening_value_type(slot), compiler_type_int())
		and match compiler_widening_decision(slot):
			CompilerTypeWiden(from_type, to_type, reason):
				(
					compiler_types_equal(from_type, CompilerConstIntType(1))
					and compiler_types_equal(to_type, compiler_type_int())
					and compiler_widening_reasons_equal(reason, CompilerMutableBinding)
				)
			CompilerTypeKeep(_):
				False
	)


func test_non_singleton_value_type_is_kept() -> Bool:
	slot = compiler_mutable_binding_slot(compiler_type_int())

	(
		compiler_types_equal(compiler_widening_semantic_type(slot), compiler_type_int())
		and compiler_types_equal(compiler_widening_value_type(slot), compiler_type_int())
		and compiler_widening_reason(slot).is_none()
		and match compiler_widening_decision(slot):
			CompilerTypeKeep(kept_type):
				compiler_types_equal(kept_type, compiler_type_int())
			CompilerTypeWiden(_, _, _):
				False
	)


func test_numeric_operand_slot_preserves_semantic_type() -> Bool:
	semantic_type: CompilerType = CompilerRangeType(CompilerConstIntType(4))
	slot = compiler_numeric_operand_slot(ParsedAddOp, semantic_type)

	(
		compiler_types_equal(compiler_widening_semantic_type(slot), semantic_type)
		and compiler_types_equal(compiler_widening_value_type(slot), compiler_type_int())
		and match compiler_widening_decision(slot):
			CompilerTypeWiden(from_type, to_type, reason):
				(
					compiler_types_equal(from_type, semantic_type)
					and compiler_types_equal(to_type, compiler_type_int())
					and compiler_widening_reasons_equal(
						reason,
						CompilerNumericOperator(ParsedAddOp),
					)
				)
			CompilerTypeKeep(_):
				False
	)


func test_method_receiver_slot_preserves_semantic_type() -> Bool:
	slot = compiler_method_receiver_slot(CompilerConstIntType(1))

	(
		compiler_types_equal(compiler_widening_semantic_type(slot), CompilerConstIntType(1))
		and compiler_types_equal(compiler_widening_value_type(slot), compiler_type_int())
		and match compiler_widening_decision(slot):
			CompilerTypeWiden(_, _, reason):
				compiler_widening_reasons_equal(reason, CompilerMethodReceiver)
			CompilerTypeKeep(_):
				False
	)


func test_range_proof_slot_erases_only_runtime_type() -> Bool:
	semantic_type: CompilerType = CompilerRangeType(CompilerTypeVar("#N"))
	slot = compiler_range_proof_slot(semantic_type)

	(
		compiler_types_equal(compiler_widening_semantic_type(slot), semantic_type)
		and compiler_types_equal(compiler_widening_value_type(slot), compiler_type_int())
		and match compiler_widening_decision(slot):
			CompilerTypeWiden(_, _, reason):
				compiler_widening_reasons_equal(reason, CompilerRangeProofErasure)
			CompilerTypeKeep(_):
				False
	)


func test_tuple_literal_slot_preserves_semantic_items() -> Bool:
	semantic_type: CompilerType = CompilerTupleType([
		CompilerConstIntType(1),
		CompilerRangeType(CompilerConstIntType(10)),
	])
	value_type: CompilerType = CompilerTupleType([compiler_type_int(), compiler_type_int()])
	slot = compiler_tuple_literal_slot(semantic_type, value_type)

	(
		compiler_types_equal(compiler_widening_semantic_type(slot), semantic_type)
		and compiler_types_equal(compiler_widening_value_type(slot), value_type)
		and match compiler_widening_decision(slot):
			CompilerTypeWiden(_, _, reason):
				compiler_widening_reasons_equal(reason, CompilerTupleLiteral)
			CompilerTypeKeep(_):
				False
	)


func test_variadic_dimension_pack_is_kept() -> Bool:
	pack_type: CompilerType = CompilerVarDimsType("#Ds")
	slot = compiler_numeric_operand_slot(ParsedAddOp, pack_type)

	(
		compiler_types_equal(compiler_widening_semantic_type(slot), pack_type)
		and compiler_types_equal(compiler_widening_value_type(slot), pack_type)
		and match compiler_widening_decision(slot):
			CompilerTypeKeep(kept_type):
				compiler_types_equal(kept_type, pack_type)
			CompilerTypeWiden(_, _, _):
				False
	)


func test_scalar_int_value_type_lifts_only_scalar_dims() -> Bool:
	(
		compiler_types_equal(
			compiler_scalar_int_value_type(CompilerConstIntType(3)),
			compiler_type_int(),
		)
		and compiler_types_equal(
			compiler_scalar_int_value_type(CompilerRangeType(CompilerConstIntType(8))),
			compiler_type_int(),
		)
		and compiler_types_equal(
			compiler_scalar_int_value_type(CompilerVarDimsType("#Ds")),
			CompilerVarDimsType("#Ds"),
		)
		and compiler_is_scalar_int_value_type(CompilerConstIntType(3))
		and not compiler_is_scalar_int_value_type(compiler_type_string())
	)


func test_argument_slot_only_widens_open_value_metas() -> Bool:
	value_meta = compiler_fresh_meta_with_origin(compiler_context_empty(), "T")
	dim_meta = compiler_fresh_meta_with_origin(value_meta.context, "#N")
	value_slot = compiler_argument_slot(
		dim_meta.context,
		value_meta.meta_type,
		CompilerConstIntType(1),
	)
	dim_slot = compiler_argument_slot(dim_meta.context, dim_meta.meta_type, CompilerConstIntType(1))
	range_type: CompilerType = CompilerRangeType(CompilerConstIntType(10))
	range_slot = compiler_argument_slot(dim_meta.context, value_meta.meta_type, range_type)

	(
		compiler_types_equal(compiler_widening_value_type(value_slot), compiler_type_int())
		and compiler_types_equal(compiler_widening_value_type(dim_slot), CompilerConstIntType(1))
		and compiler_types_equal(compiler_widening_semantic_type(range_slot), range_type)
		and compiler_types_equal(compiler_widening_value_type(range_slot), compiler_type_int())
	)


func test_argument_target_slot_preserves_semantic_type() -> Bool:
	slot = compiler_argument_target_slot(
		compiler_context_empty(),
		compiler_type_int(),
		CompilerConstIntType(1),
	)

	(
		compiler_types_equal(compiler_widening_semantic_type(slot), CompilerConstIntType(1))
		and compiler_types_equal(compiler_widening_value_type(slot), compiler_type_int())
		and match compiler_widening_decision(slot):
			CompilerTypeWiden(_, _, reason):
				compiler_widening_reasons_equal(reason, CompilerArgumentSlot)
			CompilerTypeKeep(_):
				False
	)


func test_argument_target_slot_widens_dimension_to_int() -> Bool:
	semantic_type: CompilerType = CompilerTypeVar("#N")
	slot = compiler_argument_target_slot(
		compiler_context_empty(),
		compiler_type_int(),
		semantic_type,
	)

	(
		compiler_types_equal(compiler_widening_semantic_type(slot), semantic_type)
		and compiler_types_equal(compiler_widening_value_type(slot), compiler_type_int())
		and match compiler_widening_decision(slot):
			CompilerTypeWiden(_, _, reason):
				compiler_widening_reasons_equal(reason, CompilerArgumentSlot)
			CompilerTypeKeep(_):
				False
	)


func test_argument_target_slot_widens_literal_to_sized_integer() -> Bool:
	target_type = CompilerNamedType("Int128", [])
	slot = compiler_argument_target_slot(
		compiler_context_empty(),
		target_type,
		CompilerConstIntType(123),
	)

	(
		compiler_types_equal(compiler_widening_semantic_type(slot), CompilerConstIntType(123))
		and compiler_types_equal(compiler_widening_value_type(slot), target_type)
	)


func test_argument_target_slot_widens_literal_to_sized_float() -> Bool:
	target_type = CompilerNamedType("Float32", [])
	slot = compiler_argument_target_slot(
		compiler_context_empty(),
		target_type,
		CompilerNamedType("Float", []),
	)

	compiler_types_equal(
		compiler_widening_semantic_type(slot),
		CompilerNamedType("Float", []),
	) and compiler_types_equal(compiler_widening_value_type(slot), target_type)


func test_argument_target_slot_accepts_proven_range_literal() -> Bool:
	target_type: CompilerType = CompilerRangeType(CompilerTypeVar("#N"))
	slot = compiler_argument_target_slot(
		compiler_context_empty(),
		target_type,
		CompilerConstIntType(0),
	)

	(
		compiler_types_equal(compiler_widening_semantic_type(slot), CompilerConstIntType(0))
		and compiler_types_equal(compiler_widening_value_type(slot), target_type)
	)


func test_argument_target_slot_keeps_type_variable_targets() -> Bool:
	slot = compiler_argument_target_slot(
		compiler_context_empty(),
		CompilerTypeVar("T"),
		compiler_type_char(),
	)

	(
		compiler_types_equal(compiler_widening_semantic_type(slot), compiler_type_char())
		and compiler_types_equal(compiler_widening_value_type(slot), compiler_type_char())
		and match compiler_widening_decision(slot):
			CompilerTypeKeep(kept_type):
				compiler_types_equal(kept_type, compiler_type_char())
			CompilerTypeWiden(_, _, _):
				False
	)


func test_argument_target_slot_keeps_incompatible_concrete_targets() -> Bool:
	slot = compiler_argument_target_slot(
		compiler_context_empty(),
		compiler_type_int(),
		compiler_type_string(),
	)

	(
		compiler_types_equal(compiler_widening_semantic_type(slot), compiler_type_string())
		and compiler_types_equal(compiler_widening_value_type(slot), compiler_type_string())
		and match compiler_widening_decision(slot):
			CompilerTypeKeep(kept_type):
				compiler_types_equal(kept_type, compiler_type_string())
			CompilerTypeWiden(_, _, _):
				False
	)


func test_collection_element_slot_records_collection_kind() -> Bool:
	slot = compiler_collection_element_slot(CompilerListLiteral, CompilerConstIntType(1))

	match compiler_widening_decision(slot):
		CompilerTypeWiden(_, _, reason):
			compiler_widening_reasons_equal(reason, CompilerCollectionElement(CompilerListLiteral))
		CompilerTypeKeep(_):
			False


func test_collection_element_target_slot_preserves_target_type() -> Bool:
	target_type: CompilerType = CompilerNamedType("Int32", [])
	slot = compiler_collection_element_target_slot(
		CompilerVectorLiteral,
		target_type,
		CompilerConstIntType(1),
	)

	(
		compiler_types_equal(compiler_widening_semantic_type(slot), CompilerConstIntType(1))
		and compiler_types_equal(compiler_widening_value_type(slot), target_type)
		and match compiler_widening_decision(slot):
			CompilerTypeWiden(_, _, reason):
				compiler_widening_reasons_equal(
					reason,
					CompilerCollectionElement(CompilerVectorLiteral),
				)
			CompilerTypeKeep(_):
				False
	)


func test_bitwise_operand_target_slot_preserves_target_type() -> Bool:
	target_type: CompilerType = CompilerNamedType("UInt8", [])
	slot = compiler_bitwise_operand_target_slot(target_type, CompilerConstIntType(1))

	(
		compiler_types_equal(compiler_widening_semantic_type(slot), CompilerConstIntType(1))
		and compiler_types_equal(compiler_widening_value_type(slot), target_type)
		and match compiler_widening_decision(slot):
			CompilerTypeWiden(_, _, reason):
				compiler_widening_reasons_equal(reason, CompilerBitwiseOperator)
			CompilerTypeKeep(_):
				False
	)


tests: TestSuite = {
	description = "Compiler type widening",
	tests = [
		(
			"value slot encodes widening without a nested decision",
			test_value_slot_encodes_widening_without_a_nested_decision,
		),
		(
			"mutable binding slot preserves semantic type",
			test_mutable_binding_slot_preserves_semantic_type,
		),
		("non-singleton value type is kept", test_non_singleton_value_type_is_kept),
		(
			"numeric operand slot preserves semantic type",
			test_numeric_operand_slot_preserves_semantic_type,
		),
		(
			"method receiver slot preserves semantic type",
			test_method_receiver_slot_preserves_semantic_type,
		),
		(
			"range proof slot erases only runtime type",
			test_range_proof_slot_erases_only_runtime_type,
		),
		(
			"tuple literal slot preserves semantic items",
			test_tuple_literal_slot_preserves_semantic_items,
		),
		("variadic dimension pack is kept", test_variadic_dimension_pack_is_kept),
		(
			"scalar int value type lifts only scalar dims",
			test_scalar_int_value_type_lifts_only_scalar_dims,
		),
		(
			"argument slot only widens open value metas",
			test_argument_slot_only_widens_open_value_metas,
		),
		(
			"argument target slot preserves semantic type",
			test_argument_target_slot_preserves_semantic_type,
		),
		(
			"argument target slot widens dimension to int",
			test_argument_target_slot_widens_dimension_to_int,
		),
		(
			"argument target slot widens literal to sized integer",
			test_argument_target_slot_widens_literal_to_sized_integer,
		),
		(
			"argument target slot widens literal to sized float",
			test_argument_target_slot_widens_literal_to_sized_float,
		),
		(
			"argument target slot accepts proven range literal",
			test_argument_target_slot_accepts_proven_range_literal,
		),
		(
			"argument target slot keeps type variable targets",
			test_argument_target_slot_keeps_type_variable_targets,
		),
		(
			"argument target slot keeps incompatible concrete targets",
			test_argument_target_slot_keeps_incompatible_concrete_targets,
		),
		(
			"collection element slot records collection kind",
			test_collection_element_slot_records_collection_kind,
		),
		(
			"collection element target slot preserves target type",
			test_collection_element_target_slot_preserves_target_type,
		),
		(
			"bitwise operand target slot preserves target type",
			test_bitwise_operand_target_slot_preserves_target_type,
		),
	]
}
