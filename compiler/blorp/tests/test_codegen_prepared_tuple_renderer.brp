import:
	../codegen_prepared_tuple_renderer:
		ALL_TEMPLATES,
		CompilerCommand(RenderManifestCommand, RenderPreparedTupleCommand, UnknownCommand),
		PreparedTupleOp(
			TupleArg,
			TupleConstruct,
			TupleConstructWithRc,
			TupleFieldAccess,
			TupleFieldElement,
			TupleName,
			TupleRetainElem,
		),
		RenderError(UnsupportedPreparedTupleOp, WrongArity),
		parse_command,
		parse_prepared_tuple_template,
		prepared_tuple_template_arity,
		prepared_tuple_template_name,
		render_error_to_string,
		render_manifest_line,
		render_manifest_lines,
		render_prepared_tuple,
		render_prepared_tuple_op,
	test: TestSuite


func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_prepared_tuple_template(name):
		Some(info):
			(
				prepared_tuple_template_name(info) == expected_name
				and prepared_tuple_template_arity(info) == expected_arity
			)
		None:
			False


func manifest_line_is(name: String, expected: String) -> Bool:
	match parse_prepared_tuple_template(name):
		Some(info):
			render_manifest_line(info) == expected
		None:
			False


func test_parse_command_routes() -> Bool:
	render_command: CompilerCommand = parse_command("prepared-tuple")
	manifest_command: CompilerCommand = parse_command("manifest")
	unknown_command: CompilerCommand = parse_command("wat")

	render_ok: Bool = match render_command:
		RenderPreparedTupleCommand:
			True
		RenderManifestCommand:
			False
		UnknownCommand:
			False

	manifest_ok: Bool = match manifest_command:
		RenderPreparedTupleCommand:
			False
		RenderManifestCommand:
			True
		UnknownCommand:
			False

	unknown_ok: Bool = match unknown_command:
		RenderPreparedTupleCommand:
			False
		RenderManifestCommand:
			False
		UnknownCommand:
			True

	render_ok and manifest_ok and unknown_ok


func test_parse_template_shapes() -> Bool:
	name_ok: Bool = parsed_template_has("tuple_name", "tuple_name", 1)
	arg_ok: Bool = parsed_template_has("tuple_arg", "tuple_arg", 1)
	construct_ok: Bool = parsed_template_has("tuple_construct", "tuple_construct", 2)
	retain_ok: Bool = parsed_template_has("tuple_retain_elem", "tuple_retain_elem", 2)
	construct_rc_ok: Bool = parsed_template_has(
		"tuple_construct_with_rc",
		"tuple_construct_with_rc",
		5,
	)
	field_element_ok: Bool = parsed_template_has("tuple_field_element", "tuple_field_element", 2)
	field_access_ok: Bool = parsed_template_has("tuple_field_access", "tuple_field_access", 3)
	missing_ok: Bool = not parsed_template_has("tuple_len", "tuple_len", 1)

	(
		name_ok
		and arg_ok
		and construct_ok
		and retain_ok
		and construct_rc_ok
		and field_element_ok
		and field_access_ok
		and missing_ok
	)


func test_render_prepared_tuple_op_successes() -> Bool:
	name_ok: Bool = render_prepared_tuple_op(TupleName("0")) == "__tup_0"
	arg_ok: Bool = render_prepared_tuple_op(TupleArg("value")) == ", value"
	construct_ok: Bool = render_prepared_tuple_op(
		TupleConstruct(
			"2",
			", left, right",
		),
	) == "blorp_tuple_new(2, left, right)"
	retain_ok: Bool = render_prepared_tuple_op(
		TupleRetainElem(
			"__tup_0",
			"1",
		),
	) == "if (__tup_0->elem[1]) blorp_retain(__tup_0->elem[1]);"
	construct_rc_ok: Bool = render_prepared_tuple_op(TupleConstructWithRc({
		tuple = "__tup_0",
		arity = "2",
		args = ", left, right",
		retain_statements = "if (__tup_0->elem[1]) blorp_retain(__tup_0->elem[1]);",
		release_mask = "2",
	})) == (
		"({ blorp_Tuple* __tup_0 = blorp_tuple_new(2, left, right); if (__tup_0-"
		+ ">elem[1]) blorp_retain(__tup_0->elem[1]); blorp_tuple_set_rc(__tup_0, 2UL); "
		+ "__tup_0; })"
	)
	field_element_ok: Bool = render_prepared_tuple_op(
		TupleFieldElement(
			"__tup_0",
			"1",
		),
	) == "((blorp_Tuple*)__tup_0)->elem[1]"
	field_access_ok: Bool = render_prepared_tuple_op(TupleFieldAccess({
		tuple = "__tup_0",
		source = "tuple",
		read = "blorp_unbox_float(((blorp_Tuple*)__tup_0)->elem[1])",
	})) == (
		"({ void* __tup_0 = (void*)tuple; blorp_unbox_float(((blorp_Tuple*)__tup_0)-"
		+ ">elem[1]); })"
	)

	(
		name_ok
		and arg_ok
		and construct_ok
		and retain_ok
		and construct_rc_ok
		and field_element_ok
		and field_access_ok
	)


func test_render_prepared_tuple_successes() -> Bool:
	name_ok: Bool = match render_prepared_tuple("tuple_name", ["0"]):
		Ok(rendered):
			rendered == "__tup_0"
		Err(error):
			False

	construct_ok: Bool = match render_prepared_tuple(
		"tuple_construct",
		["2", ", left, right"],
	):
		Ok(rendered):
			rendered == "blorp_tuple_new(2, left, right)"
		Err(error):
			False

	construct_rc_ok: Bool = match render_prepared_tuple(
		"tuple_construct_with_rc",
		[
			"__tup_0",
			"2",
			", left, right",
			"if (__tup_0->elem[1]) blorp_retain(__tup_0->elem[1]);",
			"2",
		],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_Tuple* __tup_0 = blorp_tuple_new(2, left, right); if (__tup_0-"
				+ ">elem[1]) blorp_retain(__tup_0->elem[1]); blorp_tuple_set_rc(__tup_0, 2UL); "
				+ "__tup_0; })"
			)
		Err(error):
			False

	field_access_ok: Bool = match render_prepared_tuple(
		"tuple_field_access",
		["__tup_0", "tuple", "blorp_unbox_float(((blorp_Tuple*)__tup_0)->elem[1])"],
	):
		Ok(rendered):
			rendered == (
				"({ void* __tup_0 = (void*)tuple; blorp_unbox_float(((blorp_Tuple*)__tup_0)-"
				+ ">elem[1]); })"
			)
		Err(error):
			False

	name_ok and construct_ok and construct_rc_ok and field_access_ok


func test_render_errors_are_typed() -> Bool:
	match render_prepared_tuple("tuple_construct", ["2"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_tuple_template_name(info) == "tuple_construct"
						and prepared_tuple_template_arity(info) == 2
						and got == 1
					)
				UnsupportedPreparedTupleOp(name):
					False


func test_render_unknown_error_is_typed() -> Bool:
	match render_prepared_tuple("tuple_len", ["tuple"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					False
				UnsupportedPreparedTupleOp(name):
					name == "tuple_len"


func test_render_error_to_string() -> Bool:
	arity_text: String = match render_prepared_tuple("tuple_arg", []):
		Ok(rendered):
			rendered
		Err(error):
			render_error_to_string(error)

	unsupported_text: String = render_error_to_string(UnsupportedPreparedTupleOp("missing"))

	(
		arity_text == "prepared tuple op tuple_arg expected 1 arg(s), got 0"
		and unsupported_text == "unsupported prepared tuple op: missing"
	)


func test_render_manifest_lines() -> Bool:
	lines: List[String] = render_manifest_lines()
	count_ok: Bool = lines.length() == ALL_TEMPLATES.length()
	name_ok: Bool = manifest_line_is("tuple_name", "tuple_name\t1\t__tup_@0@")
	arg_ok: Bool = manifest_line_is("tuple_arg", "tuple_arg\t1\t, @0@")
	construct_ok: Bool = manifest_line_is(
		"tuple_construct",
		"tuple_construct\t2\tblorp_tuple_new(@0@@1@)",
	)
	retain_ok: Bool = manifest_line_is(
		"tuple_retain_elem",
		"tuple_retain_elem\t2\tif (@0@->elem[@1@]) blorp_retain(@0@->elem[@1@]);",
	)
	construct_rc_ok: Bool = manifest_line_is(
		"tuple_construct_with_rc",
		"tuple_construct_with_rc\t5\t({ blorp_Tuple* @0@ = blorp_tuple_new(@1@@2@); @3@ blorp_tuple_set_rc(@0@, @4@UL); @0@; })",
	)
	field_element_ok: Bool = manifest_line_is(
		"tuple_field_element",
		"tuple_field_element\t2\t((blorp_Tuple*)@0@)->elem[@1@]",
	)
	field_access_ok: Bool = manifest_line_is(
		"tuple_field_access",
		"tuple_field_access\t3\t({ void* @0@ = (void*)@1@; @2@; })",
	)

	(
		count_ok
		and name_ok
		and arg_ok
		and construct_ok
		and retain_ok
		and construct_rc_ok
		and field_element_ok
		and field_access_ok
	)


tests: TestSuite = {
	description = "Self-hosted compiler prepared tuple renderer",
	tests = [
		("parse command routes", test_parse_command_routes),
		("parse template shapes", test_parse_template_shapes),
		("render prepared tuple op successes", test_render_prepared_tuple_op_successes),
		("render prepared tuple successes", test_render_prepared_tuple_successes),
		("render prepared tuple errors are typed", test_render_errors_are_typed),
		("render unknown prepared tuple error is typed", test_render_unknown_error_is_typed),
		("render error to string", test_render_error_to_string),
		("render manifest lines", test_render_manifest_lines),
	]
}
