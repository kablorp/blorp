import:
	../codegen_prepared_tuple_renderer:
		PreparedTupleOp(
			TupleArg,
			TupleConstruct,
			TupleConstructWithRc,
			TupleFieldAccess,
			TupleFieldElement,
			TupleName,
			TupleRetainElem,
		),
		RenderError(UnsupportedPreparedTupleOp, WrongArity),
		parse_prepared_tuple_template,
		prepared_tuple_template_arity,
		prepared_tuple_template_name,
		render_error_to_string,
		render_prepared_tuple,
		render_prepared_tuple_op,
	test: TestSuite


func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_prepared_tuple_template(name):
		Some(info):
			(
				prepared_tuple_template_name(info) == expected_name
				and prepared_tuple_template_arity(info) == expected_arity
			)
		None:
			False


func rendered_tuple_is(name: String, args: List[String], expected: String) -> Bool:
	match render_prepared_tuple(name, args):
		Ok(rendered):
			rendered == expected
		Err(error):
			False


func test_parse_template_shapes() -> Bool:
	name_ok: Bool = parsed_template_has("backend_tuple_name", "backend_tuple_name", 1)
	arg_ok: Bool = parsed_template_has("backend_tuple_arg", "backend_tuple_arg", 1)
	construct_ok: Bool = parsed_template_has(
		"backend_tuple_construct",
		"backend_tuple_construct",
		2,
	)
	retain_ok: Bool = parsed_template_has(
		"backend_tuple_retain_elem",
		"backend_tuple_retain_elem",
		2,
	)
	construct_rc_ok: Bool = parsed_template_has(
		"backend_tuple_construct_with_rc",
		"backend_tuple_construct_with_rc",
		5,
	)
	field_ok: Bool = parsed_template_has(
		"backend_tuple_field_element",
		"backend_tuple_field_element",
		2,
	)
	access_ok: Bool = parsed_template_has(
		"backend_tuple_field_access",
		"backend_tuple_field_access",
		3,
	)

	name_ok and arg_ok and construct_ok and retain_ok and construct_rc_ok and field_ok and access_ok


func test_render_prepared_tuple_op_successes() -> Bool:
	name_ok: Bool = render_prepared_tuple_op(TupleName("7")) == "__tup_7"
	arg_ok: Bool = render_prepared_tuple_op(TupleArg("value")) == ", value"
	construct_ok: Bool = render_prepared_tuple_op(TupleConstruct({
		arity = "2",
		args = ", left, right",
	})) == "blorp_tuple_new(2, left, right)"
	retain_ok: Bool = render_prepared_tuple_op(TupleRetainElem({
		tuple = "__tup_0",
		index = "1",
	})) == "if (__tup_0->elem[1]) blorp_retain(__tup_0->elem[1]);"
	construct_rc_ok: Bool = render_prepared_tuple_op(TupleConstructWithRc({
		tuple = "__tup_0",
		arity = "2",
		args = ", left, right",
		retain_statements = "retain_left();",
		release_mask = "1",
	})) == (
		"({ blorp_Tuple* __tup_0 = blorp_tuple_new(2, left, right); retain_left(); "
		+ "blorp_tuple_set_rc(__tup_0, 1UL); __tup_0; })"
	)
	field_ok: Bool = render_prepared_tuple_op(TupleFieldElement({
		tuple = "__tup_0",
		field = "1",
	})) == "((blorp_Tuple*)__tup_0)->elem[1]"
	access_ok: Bool = render_prepared_tuple_op(TupleFieldAccess({
		tuple = "__tup_0",
		source = "tuple_expr",
		read = "(long)((blorp_Tuple*)__tup_0)->elem[1]",
	})) == "({ void* __tup_0 = (void*)tuple_expr; (long)((blorp_Tuple*)__tup_0)->elem[1]; })"

	name_ok and arg_ok and construct_ok and retain_ok and construct_rc_ok and field_ok and access_ok


func test_render_prepared_tuple_successes() -> Bool:
	name_ok: Bool = rendered_tuple_is("backend_tuple_name", ["7"], "__tup_7")
	arg_ok: Bool = rendered_tuple_is("backend_tuple_arg", ["value"], ", value")
	construct_ok: Bool = rendered_tuple_is(
		"backend_tuple_construct",
		["2", ", left, right"],
		"blorp_tuple_new(2, left, right)",
	)
	retain_ok: Bool = rendered_tuple_is(
		"backend_tuple_retain_elem",
		["__tup_0", "1"],
		"if (__tup_0->elem[1]) blorp_retain(__tup_0->elem[1]);",
	)
	construct_rc_ok: Bool = rendered_tuple_is(
		"backend_tuple_construct_with_rc",
		["__tup_0", "2", ", left, right", "retain_left();", "1"],
		(
			"({ blorp_Tuple* __tup_0 = blorp_tuple_new(2, left, right); retain_left(); "
			+ "blorp_tuple_set_rc(__tup_0, 1UL); __tup_0; })"
		),
	)
	field_ok: Bool = rendered_tuple_is(
		"backend_tuple_field_element",
		["__tup_0", "1"],
		"((blorp_Tuple*)__tup_0)->elem[1]",
	)
	access_ok: Bool = rendered_tuple_is(
		"backend_tuple_field_access",
		["__tup_0", "tuple_expr", "(long)((blorp_Tuple*)__tup_0)->elem[1]"],
		"({ void* __tup_0 = (void*)tuple_expr; (long)((blorp_Tuple*)__tup_0)->elem[1]; })",
	)

	name_ok and arg_ok and construct_ok and retain_ok and construct_rc_ok and field_ok and access_ok


func test_render_prepared_tuple_errors_are_typed() -> Bool:
	wrong_arity_ok: Bool = match render_prepared_tuple("backend_tuple_construct", ["2"]):
		Err(WrongArity(info, actual)):
			(
				prepared_tuple_template_name(info) == "backend_tuple_construct"
				and prepared_tuple_template_arity(info) == 2
				and actual == 1
			)
		Ok(value):
			False
		Err(UnsupportedPreparedTupleOp(name)):
			False

	unsupported_ok: Bool = match render_prepared_tuple("backend_tuple_missing", []):
		Err(UnsupportedPreparedTupleOp(name)):
			name == "backend_tuple_missing"
		Ok(value):
			False
		Err(WrongArity(info, actual)):
			False

	wrong_arity_ok and unsupported_ok


func test_error_text() -> Bool:
	arity_text: String = match render_prepared_tuple("backend_tuple_construct", ["2"]):
		Err(error):
			render_error_to_string(error)
		Ok(value):
			value

	unsupported_text: String = render_error_to_string(
		UnsupportedPreparedTupleOp("backend_tuple_missing"),
	)

	(
		arity_text == "prepared tuple op backend_tuple_construct expected 2 arg(s), got 1"
		and unsupported_text == "unsupported prepared tuple op: backend_tuple_missing"
	)


tests: TestSuite = {
	description = "Self-hosted compiler prepared tuple renderer",
	tests = [
		("parse template shapes", test_parse_template_shapes),
		("render prepared tuple op successes", test_render_prepared_tuple_op_successes),
		("render prepared tuple successes", test_render_prepared_tuple_successes),
		("render prepared tuple errors are typed", test_render_prepared_tuple_errors_are_typed),
		("error text", test_error_text),
	]
}
