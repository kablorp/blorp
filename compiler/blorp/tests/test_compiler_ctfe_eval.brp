func test_eval_imported_std_string_intrinsics() -> Bool:
	length_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			imported_call_expr(
				"std/string",
				40,
				"length#40",
				[string_expr("blorp")],
				compiler_type_int(),
			),
		),
		compiler_ctfe_int(source_span(), 5),
	)
	substring_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			imported_call_expr(
				"std/string",
				41,
				"substring#41",
				[string_expr("blorp"), int_expr("1"), int_expr("3")],
				compiler_type_string(),
			),
		),
		compiler_ctfe_string(
			source_span(),
			"lor",
		),
	)
	contains_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			imported_call_expr(
				"std/string",
				42,
				"contains#42",
				[string_expr("blorp"), string_expr("or")],
				compiler_type_bool(),
			),
		),
		compiler_ctfe_bool(
			source_span(),
			True,
		),
	)
	index_type = CompilerNamedType("Option", [compiler_type_int()])
	index_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			imported_call_expr(
				"std/string",
				43,
				"index_of#43",
				[string_expr("blorp"), string_expr("or")],
				index_type,
			),
		),
		compiler_ctfe_option_some_value(
			index_type,
			source_span(),
			compiler_ctfe_int(source_span(), 2),
		),
	)

	upper_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			imported_call_expr(
				"std/string",
				44,
				"upper#44",
				[string_expr("Blorp")],
				compiler_type_string(),
			),
		),
		compiler_ctfe_string(source_span(), "BLORP"),
	)
	lower_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			imported_call_expr(
				"std/string",
				45,
				"lower#45",
				[string_expr("Blorp")],
				compiler_type_string(),
			),
		),
		compiler_ctfe_string(source_span(), "blorp"),
	)
	drop_left_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			imported_call_expr(
				"std/string",
				47,
				"drop_left#47",
				[string_expr("blorp"), int_expr("2")],
				compiler_type_string(),
			),
		),
		compiler_ctfe_string(
			source_span(),
			"orp",
		),
	)
	take_left_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			imported_call_expr(
				"std/string",
				48,
				"take_left#48",
				[string_expr("blorp"), int_expr("2")],
				compiler_type_string(),
			),
		),
		compiler_ctfe_string(
			source_span(),
			"bl",
		),
	)
	char_list_type = compiler_type_list(compiler_type_char())
	chars_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			imported_call_expr("std/string", 49, "chars#49", [string_expr("az")], char_list_type),
		),
		compiler_ctfe_value(char_list_type, CompilerCtfeListValue([
				compiler_ctfe_char(source_span(), 'a'),
				compiler_ctfe_char(source_span(), 'z'),
			]), source_span()),
	)
	from_char_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			imported_call_expr(
				"std/string",
				50,
				"from_char#50",
				[char_expr(90)],
				compiler_type_string(),
			),
		),
		compiler_ctfe_string(source_span(), "Z"),
	)
	from_chars_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			imported_call_expr(
				"std/string",
				51,
				"from_chars#51",
				[
					CompilerTypedListExpr(
						[char_expr(111), char_expr(107)],
						source_span(),
						expr_info_for(char_list_type),
					),
				],
				compiler_type_string(),
			),
		),
		compiler_ctfe_string(
			source_span(),
			"ok",
		),
	)

	(
		length_ok
		and substring_ok
		and contains_ok
		and index_ok
		and upper_ok
		and lower_ok
		and drop_left_ok
		and take_left_ok
		and chars_ok
		and from_char_ok
		and from_chars_ok
	)


