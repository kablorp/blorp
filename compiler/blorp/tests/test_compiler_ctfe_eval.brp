pure func source_file() -> CompilerSourceFile:
	compiler_source_file("ctfe_eval.brp", "ctfe_eval", "VALUE = 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func expr_info_for(typ: CompilerType) -> CompilerTypedExprInfo:
	{
		source_type = None,
		semantic_type = typ,
		value_type = typ,
		origin = CompilerSynthesizedOrigin("ctfe_eval_test"),
		value_slot = {
			semantic_type = typ,
			decision = CompilerTypeKeep(typ)
		},
		proofs = compiler_unrefined_binding(),
		resolved_call = None,
		resource_dependencies = []
	}


pure func expr_info() -> CompilerTypedExprInfo:
	expr_info_for(compiler_type_int())


pure func lambda_expr() -> CompilerTypedExpr:
	CompilerTypedLambdaExpr(
		True,
		[],
		Some(compiler_type_int()),
		int_expr("42"),
		source_span(),
		expr_info_for(CompilerFunctionType(True, [], compiler_type_int())),
	)


pure func void_expr_info() -> CompilerTypedExprInfo:
	expr_info_for(compiler_type_void())


pure func expr_info_with_call(call: CompilerResolvedCallInfo) -> CompilerTypedExprInfo:
	{ expr_info() | resolved_call = Some(call) }


pure func expr_info_for_with_call(
	typ: CompilerType,
	call: CompilerResolvedCallInfo,
) -> CompilerTypedExprInfo:
	{ expr_info_for(typ) | resolved_call = Some(call) }


pure func int_expr(text: String) -> CompilerTypedExpr:
	CompilerTypedIntLiteralExpr(text, source_span(), expr_info())


pure func bool_expr(value: Bool) -> CompilerTypedExpr:
	CompilerTypedBoolLiteralExpr(value, source_span(), expr_info_for(compiler_type_bool()))


pure func char_expr(value: Int) -> CompilerTypedExpr:
	CompilerTypedCharLiteralExpr(value, source_span(), expr_info_for(compiler_type_char()))


pure func float_expr(text: String) -> CompilerTypedExpr:
	CompilerTypedFloatLiteralExpr(text, source_span(), expr_info_for(compiler_type_float()))


pure func string_expr(value: String) -> CompilerTypedExpr:
	CompilerTypedStringLiteralExpr(value, source_span(), expr_info_for(compiler_type_string()))


pure func name_expr(name: String) -> CompilerTypedExpr:
	CompilerTypedNameExpr(ident(name), expr_info())


pure func name_expr_for(name: String, typ: CompilerType) -> CompilerTypedExpr:
	CompilerTypedNameExpr(ident(name), expr_info_for(typ))


pure func int_binary_expr(
	op: ParsedBinaryOp,
	left: CompilerTypedExpr,
	right: CompilerTypedExpr,
) -> CompilerTypedExpr:
	CompilerTypedBinaryExpr(op, left, right, source_span(), expr_info())


pure func bool_binary_expr(
	op: ParsedBinaryOp,
	left: CompilerTypedExpr,
	right: CompilerTypedExpr,
) -> CompilerTypedExpr:
	CompilerTypedBinaryExpr(op, left, right, source_span(), expr_info_for(compiler_type_bool()))


pure func name_expr_with_call(name: String, call: CompilerResolvedCallInfo) -> CompilerTypedExpr:
	CompilerTypedNameExpr(ident(name), expr_info_with_call(call))


pure func local_resolved_call(callable_id: Int, source_name: String) -> CompilerResolvedCallInfo:
	resolved_call_with_origin(callable_id, source_name, CompilerCallableLocal)


pure func resolved_call_with_origin(
	callable_id: Int,
	source_name: String,
	origin: CompilerCallableOrigin,
) -> CompilerResolvedCallInfo:
	{
		callee_name = source_name,
		source_name = source_name,
		purity = CompilerPure,
		target = CompilerResolvedDirectCall(callable_id, origin),
		instantiated_params = [],
		instantiated_return = compiler_type_int(),
		resource_args = CompilerRejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}


pure func resolved_call_with_return(
	callable_id: Int,
	source_name: String,
	origin: CompilerCallableOrigin,
	return_type: CompilerType,
) -> CompilerResolvedCallInfo:
	{ resolved_call_with_origin(callable_id, source_name, origin) |
		instantiated_return = return_type
	}


pure func imported_call_expr(
	module_path: String,
	callable_id: Int,
	source_name: String,
	args: List[CompilerTypedExpr],
	return_type: CompilerType,
) -> CompilerTypedExpr:
	call = resolved_call_with_return(
		callable_id,
		source_name,
		CompilerCallableImported(module_path),
		return_type,
	)
	CompilerTypedCallExpr(
		name_expr_with_call(source_name, call),
		args,
		source_span(),
		expr_info_for_with_call(return_type, call),
	)


pure func lambda_call_expr() -> CompilerTypedExpr:
	lambda_param: CompilerTypedLambdaParam = {
		name = ident("value"),
		source_type = Some(compiler_type_int()),
		param_type = compiler_type_int()
	}
	body = CompilerTypedBinaryExpr(
		ParsedAddOp,
		name_expr("value"),
		name_expr("offset"),
		source_span(),
		expr_info(),
	)
	lambda_type = CompilerFunctionType(True, [compiler_type_int()], compiler_type_int())
	lambda = CompilerTypedLambdaExpr(
		True,
		[lambda_param],
		Some(compiler_type_int()),
		body,
		source_span(),
		expr_info_for(lambda_type),
	)
	call: CompilerResolvedCallInfo = {
		callee_name = "<lambda>",
		source_name = "<lambda>",
		purity = CompilerPure,
		target = CompilerResolvedClosureCall,
		instantiated_params = [compiler_type_int()],
		instantiated_return = compiler_type_int(),
		resource_args = CompilerRejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}

	CompilerTypedCallExpr(
		lambda,
		[int_expr("20")],
		source_span(),
		expr_info_for_with_call(compiler_type_int(), call),
	)


pure func builtin_call_expr(
	name: String,
	arg: CompilerTypedExpr,
	return_type: CompilerType,
) -> CompilerTypedExpr:
	call = resolved_call_with_return(50, name, CompilerCallableBuiltin, return_type)
	CompilerTypedCallExpr(
		name_expr_with_call(name, call),
		[arg],
		source_span(),
		expr_info_for_with_call(return_type, call),
	)


pure func local_function_reference_expr(
	name: String,
	callable_id: Int,
	param_types: List[CompilerType],
	return_type: CompilerType,
) -> CompilerTypedExpr:
	source_name = name + "#" + callable_id.to_string()
	call = resolved_call_with_return(callable_id, source_name, CompilerCallableLocal, return_type)
	function_type = CompilerFunctionType(True, param_types, return_type)
	CompilerTypedNameExpr(
		ident(name),
		expr_info_for_with_call(function_type, call),
	)


pure func constructor_context() -> CompilerCtfeContext:
	{
		functions = [],
		imported_functions = [],
		constructors = [("None", compiler_ctfe_constructor_info("Option", 0, None))],
		module_aliases = [],
		module_global_envs = [],
		active_module_path = None
	}


pure func param(name: String) -> ParsedParam:
	{
		binder = ParsedParamNameBinder(ident(name)),
		type_expr = None,
		span = source_span()
	}


pure func tuple_param(names: List[String]) -> ParsedParam:
	{
		binder = ParsedParamTupleBinder(
			names.map(func(name): ident(name)),
			source_span(),
		),
		type_expr = None,
		span = source_span()
	}


pure func parsed_function_decl(
	name: String,
	params: List[ParsedParam],
	is_pure: Bool,
) -> ParsedFunctionDecl:
	{
		name = ident(name),
		type_params = [],
		params = params,
		return_type = None,
		dim_constraints = [],
		body = None,
		is_pure = is_pure,
		annotations = [],
		doc = None,
		span = source_span()
	}


pure func typed_function_info(
	callable_id: Int,
	name: String,
	params: List[ParsedParam],
	body: Option[CompilerTypedExpr],
	is_pure: Bool,
) -> CompilerTypedFunctionInfo:
	{
		decl = parsed_function_decl(name, params, is_pure),
		callable_id = Some(callable_id),
		effective_type_params = [],
		param_types = [],
		source_return_type = None,
		semantic_return_type = compiler_type_int(),
		body = body
	}


pure func ctfe_function(
	callable_id: Int,
	name: String,
	params: List[ParsedParam],
	body: Option[CompilerTypedExpr],
	is_pure: Bool,
) -> CompilerCtfeFunction:
	{
		info = typed_function_info(callable_id, name, params, body, is_pure),
		source_name = name,
		module_path = None
	}


pure func imported_ctfe_function(
	module_path: String,
	callable_id: Int,
	name: String,
	params: List[ParsedParam],
	body: Option[CompilerTypedExpr],
	is_pure: Bool,
) -> CompilerCtfeFunction:
	{ ctfe_function(callable_id, name, params, body, is_pure) | module_path = Some(module_path) }


pure func function_context(functions: List[(Int, CompilerCtfeFunction)]) -> CompilerCtfeContext:
	{
		functions = functions,
		imported_functions = [],
		constructors = [],
		module_aliases = [],
		module_global_envs = [],
		active_module_path = None
	}


pure func imported_function_context(
	module_path: String,
	source_name: String,
	functions: List[CompilerCtfeFunction],
) -> CompilerCtfeContext:
	{
		functions = [],
		imported_functions = [
			{
				module_path = module_path,
				source_name = source_name,
				functions = functions
			},
		],
		constructors = [],
		module_aliases = [],
		module_global_envs = [],
		active_module_path = None
	}


pure func imported_function_context_with_global(
	module_path: String,
	source_name: String,
	functions: List[CompilerCtfeFunction],
	global_name: String,
	global_value: CompilerCtfeValue,
) -> CompilerCtfeContext:
	{
		functions = [],
		imported_functions = [
			{
				module_path = module_path,
				source_name = source_name,
				functions = functions
			},
		],
		constructors = [],
		module_aliases = [],
		module_global_envs = [
			{
				module_path = module_path,
				env = compiler_ctfe_bind_global_value(
					compiler_ctfe_env_empty(),
					global_name,
					global_value,
				)
			},
		],
		active_module_path = None
	}


pure func imported_global_context(
	alias_name: String,
	module_path: String,
	global_name: String,
	global_value: CompilerCtfeValue,
) -> CompilerCtfeContext:
	with_alias = compiler_ctfe_context_with_module_alias(
		compiler_ctfe_context_empty(),
		alias_name,
		module_path,
	)
	compiler_ctfe_context_with_module_global_env(
		with_alias,
		module_path,
		compiler_ctfe_bind_global_value(compiler_ctfe_env_empty(), global_name, global_value),
	)


pure func value_equals(
	result: Result[CompilerCtfeValue, CompilerCtfeEvalError],
	expected: CompilerCtfeValue,
) -> Bool:
	match result:
		Ok(value):
			compiler_ctfe_values_equal(value, expected)
		Err(_):
			False


pure func error_message(result: Result[CompilerCtfeValue, CompilerCtfeEvalError]) -> String:
	match result:
		Err(error):
			compiler_ctfe_eval_error_message(error)
		Ok(_):
			""


func test_eval_literals_and_binary_ops() -> Bool:
	expr = CompilerTypedBinaryExpr(
		ParsedAddOp,
		int_expr("20"),
		int_expr("22"),
		source_span(),
		expr_info(),
	)
	result = compiler_ctfe_eval_typed_expr(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		expr,
	)

	value_equals(
		result,
		compiler_ctfe_int(source_span(), 42),
	)


func test_eval_identifier_lookup() -> Bool:
	env = compiler_ctfe_bind_global_value(
		compiler_ctfe_env_empty(),
		"VALUE",
		compiler_ctfe_int(source_span(), 9),
	)

	value_equals(
		compiler_ctfe_eval_typed_expr(compiler_ctfe_context_empty(), env, name_expr("VALUE")),
		compiler_ctfe_int(source_span(), 9),
	)


func test_eval_logical_short_circuits() -> Bool:
	expr = CompilerTypedLogicalExpr(
		ParsedAndOp,
		bool_expr(False),
		name_expr("MISSING"),
		source_span(),
		expr_info_for(compiler_type_bool()),
	)

	match compiler_ctfe_eval_typed_expr(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		expr,
	):
		Ok(value):
			match value.desc:
				CompilerCtfeBoolValue(result):
					not result
				_:
					False
		Err(_):
			False


func test_eval_collection_and_record_values() -> Bool:
	list_expr = CompilerTypedListExpr(
		[int_expr("1"), int_expr("2")],
		source_span(),
		expr_info_for(compiler_type_list(compiler_type_int())),
	)
	record_field: CompilerTypedRecordField = {
		name = ident("value"),
		value = int_expr("3"),
		span = source_span()
	}
	record_expr = CompilerTypedRecordExpr(
		[record_field],
		source_span(),
		expr_info_for(CompilerNamedType("Box", [])),
	)

	list_result = compiler_ctfe_eval_typed_expr(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		list_expr,
	)
	record_result = compiler_ctfe_eval_typed_expr(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		record_expr,
	)

	var list_ok: Bool = False

	match list_result:
		Ok(value):
			match value.desc:
				CompilerCtfeListValue(items):
					list_ok = items.length() == 2
				_:
					void
		Err(_):
			void

	var record_ok: Bool = False

	match record_result:
		Ok(value):
			match value.desc:
				CompilerCtfeRecordValue(fields):
					match fields.get(0):
						Some(field):
							(name, field_value) = field
							record_ok = name == "value" and compiler_ctfe_values_equal(
								field_value,
								compiler_ctfe_int(source_span(), 3),
							)
						None:
							void
				_:
					void
		Err(_):
			void

	list_ok and record_ok


func test_eval_if_range_field_and_record_update() -> Bool:
	base_field: CompilerTypedRecordField = {
		name = ident("value"),
		value = int_expr("1"),
		span = source_span()
	}
	update_field: CompilerTypedRecordField = {
		name = ident("value"),
		value = int_expr("9"),
		span = source_span()
	}
	record_expr = CompilerTypedRecordExpr(
		[base_field],
		source_span(),
		expr_info_for(CompilerNamedType("Box", [])),
	)
	if_expr = CompilerTypedIfExpr(
		bool_expr(False),
		name_expr("MISSING"),
		Some(int_expr("7")),
		source_span(),
		expr_info(),
	)
	range_expr = CompilerTypedRangeExpr(
		int_expr("0"),
		int_expr("3"),
		source_span(),
		expr_info_for(CompilerNamedType("Range", [])),
	)
	range_start_expr = CompilerTypedFieldAccessExpr(
		range_expr,
		ident("start"),
		source_span(),
		expr_info(),
	)
	range_end_expr = CompilerTypedFieldAccessExpr(
		range_expr,
		ident("end"),
		source_span(),
		expr_info(),
	)
	tuple_type = CompilerTupleType([compiler_type_int(), compiler_type_int()])
	tuple_field_expr = CompilerTypedFieldAccessExpr(
		CompilerTypedTupleExpr(
			[int_expr("40"), int_expr("2")],
			source_span(),
			expr_info_for(tuple_type),
		),
		ident("1"),
		source_span(),
		expr_info(),
	)
	field_expr = CompilerTypedFieldAccessExpr(
		record_expr,
		ident("value"),
		source_span(),
		expr_info(),
	)
	update_expr = CompilerTypedRecordUpdateExpr(
		record_expr,
		[update_field],
		source_span(),
		expr_info_for(CompilerNamedType("Box", [])),
	)
	env = compiler_ctfe_env_empty()
	context = compiler_ctfe_context_empty()

	if_ok = value_equals(
		compiler_ctfe_eval_typed_expr(context, env, if_expr),
		compiler_ctfe_int(source_span(), 7),
	)
	field_ok = value_equals(
		compiler_ctfe_eval_typed_expr(context, env, field_expr),
		compiler_ctfe_int(source_span(), 1),
	)
	range_start_ok = value_equals(
		compiler_ctfe_eval_typed_expr(context, env, range_start_expr),
		compiler_ctfe_int(source_span(), 0),
	)
	range_end_ok = value_equals(
		compiler_ctfe_eval_typed_expr(context, env, range_end_expr),
		compiler_ctfe_int(source_span(), 3),
	)
	tuple_field_ok = value_equals(
		compiler_ctfe_eval_typed_expr(context, env, tuple_field_expr),
		compiler_ctfe_int(source_span(), 2),
	)

	var range_literal_ok: Bool = False

	match compiler_ctfe_eval_typed_expr(context, env, range_expr):
		Ok(value):
			match value.desc:
				CompilerCtfeRangeValue(start_value, end_value):
					range_literal_ok = compiler_ctfe_values_equal(
						start_value,
						compiler_ctfe_int(source_span(), 0),
					) and compiler_ctfe_values_equal(
						end_value,
						compiler_ctfe_int(source_span(), 3),
					)
				_:
					void
		Err(_):
			void

	var update_ok: Bool = False

	match compiler_ctfe_eval_typed_expr(context, env, update_expr):
		Ok(value):
			match value.desc:
				CompilerCtfeRecordValue(fields):
					match fields.get(0):
						Some(field):
							(name, field_value) = field
							update_ok = name == "value" and compiler_ctfe_values_equal(
								field_value,
								compiler_ctfe_int(source_span(), 9),
							)
						None:
							void
				_:
					void
		Err(_):
			void

	(
		if_ok
		and range_literal_ok
		and field_ok
		and range_start_ok
		and range_end_ok
		and tuple_field_ok
		and update_ok
	)


func test_eval_block_local_bindings() -> Bool:
	payload: CompilerTypedVarDeclPayload = {
		name = ident("x"),
		annotation = Some(compiler_type_int()),
		initializer = int_expr("40"),
