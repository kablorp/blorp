		instantiated_params = [matrix_type, compiler_type_int(), compiler_type_int()],
		instantiated_return = compiler_type_int(),
		resource_args = CompilerRejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}
	expr = CompilerTypedCallExpr(
