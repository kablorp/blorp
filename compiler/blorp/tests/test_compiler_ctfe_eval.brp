func test_eval_block_question_bind_result_ok_and_err() -> Bool:
	result_type = CompilerNamedType(
		"Result",
		[compiler_type_int(), compiler_type_string()],
	)
	ok_env = compiler_ctfe_bind_global_value(
		compiler_ctfe_env_empty(),
		"value_result",
		compiler_ctfe_result_ok_value(
			result_type,
			source_span(),
			compiler_ctfe_int(source_span(), 40),
		),
	)
	err_env = compiler_ctfe_bind_global_value(
		compiler_ctfe_env_empty(),
		"value_result",
		compiler_ctfe_result_err_value(
			result_type,
			source_span(),
			compiler_ctfe_string(source_span(), "bad"),
		),
	)
	block = CompilerTypedBlockExpr(
		[CompilerTypedQuestionBindExpr(
				ident("value"),
				Some(compiler_type_int()),
				name_expr_for("value_result", result_type),
				source_span(),
				expr_info_for(compiler_type_void()),
			), CompilerTypedBinaryExpr(
				ParsedAddOp,
				name_expr("value"),
				int_expr("2"),
				source_span(),
				expr_info(),
			)],
		source_span(),
		expr_info(),
	)
	err_block = CompilerTypedBlockExpr(
		[CompilerTypedQuestionBindExpr(
				ident("value"),
				Some(compiler_type_int()),
				name_expr_for("value_result", result_type),
				source_span(),
				expr_info_for(compiler_type_void()),
			), name_expr("value")],
		source_span(),
		expr_info_for(result_type),
	)

	value_equals(
		compiler_ctfe_eval_typed_expr(compiler_ctfe_context_empty(), ok_env, block),
		compiler_ctfe_int(source_span(), 42),
	) and value_equals(
		compiler_ctfe_eval_typed_expr(compiler_ctfe_context_empty(), err_env, err_block),
		compiler_ctfe_result_err_value(
			result_type,
			source_span(),
			compiler_ctfe_string(source_span(), "bad"),
		),
	)


func test_eval_nullary_constructor_reference() -> Bool:
	result = compiler_ctfe_eval_typed_expr(
		constructor_context(),
		compiler_ctfe_env_empty(),
		CompilerTypedNameExpr(
			ident("None"),
			expr_info_for(CompilerNamedType("Option", [compiler_type_int()])),
		),
	)

	match result:
		Ok(value):
			match value.desc:
				CompilerCtfeConstructorValue(payload):
					payload.name == "None" and payload.constructor_info.parent_type == "Option"
				_:
					False
		Err(_):
			False


func test_eval_string_interpolation() -> Bool:
	expr = CompilerTypedStringInterpolationPartsExpr(
		[
			CompilerTypedInterpolationLiteral("n="),
			CompilerTypedInterpolationExpr(int_expr("42")),
			CompilerTypedInterpolationLiteral(", flag="),
			CompilerTypedInterpolationExpr(bool_expr(True)),
			CompilerTypedInterpolationLiteral(", char="),
			CompilerTypedInterpolationExpr(char_expr(90)),
			CompilerTypedInterpolationLiteral(", text="),
			CompilerTypedInterpolationExpr(string_expr("ok")),
			CompilerTypedInterpolationLiteral(", float="),
			CompilerTypedInterpolationExpr(float_expr("2.75")),
		],
		False,
		source_span(),
		expr_info_for(compiler_type_string()),
	)

	match compiler_ctfe_eval_typed_expr(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		expr,
	):
		Ok(value):
			match value.desc:
				CompilerCtfeStringValue(text):
					text == "n=42, flag=True, char=Z, text=ok, float=2.75"
				_:
					False
		Err(_):
			False


