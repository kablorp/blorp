import:
	../compiler_ctfe_context: CompilerCtfeContext, compiler_ctfe_context_empty
	../compiler_ctfe_env: compiler_ctfe_bind_global_value, compiler_ctfe_env_empty
	../compiler_ctfe_eval:
		CompilerCtfeEvalError,
		compiler_ctfe_eval_error_message,
		compiler_ctfe_eval_typed_expr,
	../compiler_ctfe_value:
		CompilerCtfeValue,
		CompilerCtfeValueDesc(
			CompilerCtfeBoolValue,
			CompilerCtfeConstructorValue,
			CompilerCtfeListValue,
			CompilerCtfeRangeValue,
			CompilerCtfeRecordValue,
		),
		compiler_ctfe_constructor_info,
		compiler_ctfe_int,
		compiler_ctfe_values_equal,
	../compiler_env:
		CompilerPurity(CompilerPure),
		CompilerResourceArgPolicy(CompilerRejectResourceArgs),
	../compiler_infer:
		CompilerCallableOrigin(CompilerCallableLocal),
		CompilerExprTypeOrigin(CompilerSynthesizedOrigin),
		CompilerResolvedCallInfo,
		CompilerResolvedCallTarget(CompilerResolvedDirectCall),
		CompilerTypedAssignScope(CompilerLocalAssignScope),
		CompilerTypedExpr(
			CompilerTypedAssignExpr,
			CompilerTypedBinaryExpr,
			CompilerTypedBlockExpr,
			CompilerTypedBoolLiteralExpr,
			CompilerTypedCallExpr,
			CompilerTypedFieldAccessExpr,
			CompilerTypedIfExpr,
			CompilerTypedIntLiteralExpr,
			CompilerTypedListExpr,
			CompilerTypedLogicalExpr,
			CompilerTypedNameExpr,
			CompilerTypedRangeExpr,
			CompilerTypedRecordExpr,
			CompilerTypedRecordUpdateExpr,
			CompilerTypedTupleDestructExpr,
			CompilerTypedTupleExpr,
			CompilerTypedVarDeclExpr,
		),
		CompilerTypedExprInfo,
		CompilerTypedRecordField,
		CompilerTypedVarDeclPayload,
	../compiler_parsed_ast:
		ParsedBinaryOp(ParsedAddOp),
		ParsedIdentifier,
		ParsedLogicalOp(ParsedAndOp),
		parsed_identifier,
	../compiler_refinement: compiler_unrefined_binding
	../compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../compiler_type:
		CompilerType(CompilerNamedType, CompilerRangeType, CompilerTupleType),
		compiler_type_bool,
		compiler_type_int,
		compiler_type_list,
		compiler_type_void,
	../compiler_type_widening: CompilerTypeWideningDecision(CompilerTypeKeep)
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("ctfe_eval.brp", "ctfe_eval", "VALUE = 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func expr_info_for(typ: CompilerType) -> CompilerTypedExprInfo:
	{
		source_type = None,
		semantic_type = typ,
		value_type = typ,
		origin = CompilerSynthesizedOrigin("ctfe_eval_test"),
		value_slot = {
			semantic_type = typ,
			decision = CompilerTypeKeep(typ)
		},
		proofs = compiler_unrefined_binding(),
		resolved_call = None,
		resource_dependencies = []
	}


pure func expr_info() -> CompilerTypedExprInfo:
	expr_info_for(compiler_type_int())


pure func expr_info_with_call(call: CompilerResolvedCallInfo) -> CompilerTypedExprInfo:
	{ expr_info() | resolved_call = Some(call) }


pure func int_expr(text: String) -> CompilerTypedExpr:
	CompilerTypedIntLiteralExpr(text, source_span(), expr_info())


pure func bool_expr(value: Bool) -> CompilerTypedExpr:
	CompilerTypedBoolLiteralExpr(value, source_span(), expr_info_for(compiler_type_bool()))


pure func name_expr(name: String) -> CompilerTypedExpr:
	CompilerTypedNameExpr(ident(name), expr_info())


pure func name_expr_with_call(name: String, call: CompilerResolvedCallInfo) -> CompilerTypedExpr:
	CompilerTypedNameExpr(ident(name), expr_info_with_call(call))


pure func local_resolved_call(callable_id: Int, source_name: String) -> CompilerResolvedCallInfo:
	{
		callee_name = source_name,
		source_name = source_name,
		purity = CompilerPure,
		target = CompilerResolvedDirectCall(callable_id, CompilerCallableLocal),
		instantiated_params = [],
		instantiated_return = compiler_type_int(),
		resource_args = CompilerRejectResourceArgs,
		dim_constraints = []
	}


pure func constructor_context() -> CompilerCtfeContext:
	{
		functions = [],
		imported_functions = [],
		constructors = [("None", compiler_ctfe_constructor_info("Option", 0, None))],
		module_global_envs = []
	}


pure func value_equals(
	result: Result[CompilerCtfeValue, CompilerCtfeEvalError],
	expected: CompilerCtfeValue,
) -> Bool:
	match result:
		Ok(value):
			compiler_ctfe_values_equal(value, expected)
		Err(_):
			False


pure func error_message(result: Result[CompilerCtfeValue, CompilerCtfeEvalError]) -> String:
	match result:
		Err(error):
			compiler_ctfe_eval_error_message(error)
		Ok(_):
			""


func test_eval_literals_and_binary_ops() -> Bool:
	expr = CompilerTypedBinaryExpr(
		ParsedAddOp,
		int_expr("20"),
		int_expr("22"),
		source_span(),
		expr_info(),
	)
	result = compiler_ctfe_eval_typed_expr(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		expr,
	)

	value_equals(
		result,
		compiler_ctfe_int(source_span(), 42),
	)


func test_eval_identifier_lookup() -> Bool:
	env = compiler_ctfe_bind_global_value(
		compiler_ctfe_env_empty(),
		"VALUE",
		compiler_ctfe_int(source_span(), 9),
	)

	value_equals(
		compiler_ctfe_eval_typed_expr(compiler_ctfe_context_empty(), env, name_expr("VALUE")),
		compiler_ctfe_int(source_span(), 9),
	)


func test_eval_logical_short_circuits() -> Bool:
	expr = CompilerTypedLogicalExpr(
		ParsedAndOp,
		bool_expr(False),
		name_expr("MISSING"),
		source_span(),
		expr_info_for(compiler_type_bool()),
	)

	match compiler_ctfe_eval_typed_expr(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		expr,
	):
		Ok(value):
			match value.desc:
				CompilerCtfeBoolValue(result):
					not result
				_:
					False
		Err(_):
			False


func test_eval_collection_and_record_values() -> Bool:
	list_expr = CompilerTypedListExpr(
		[int_expr("1"), int_expr("2")],
		source_span(),
		expr_info_for(compiler_type_list(compiler_type_int())),
	)
	record_field: CompilerTypedRecordField = {
		name = ident("value"),
		value = int_expr("3"),
		span = source_span()
	}
	record_expr = CompilerTypedRecordExpr(
		[record_field],
		source_span(),
		expr_info_for(CompilerNamedType("Box", [])),
	)

	list_result = compiler_ctfe_eval_typed_expr(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		list_expr,
	)
	record_result = compiler_ctfe_eval_typed_expr(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		record_expr,
	)

	var list_ok: Bool = False

	match list_result:
		Ok(value):
			match value.desc:
				CompilerCtfeListValue(items):
					list_ok = items.length() == 2
				_:
					void
		Err(_):
			void

	var record_ok: Bool = False

	match record_result:
		Ok(value):
			match value.desc:
				CompilerCtfeRecordValue(fields):
					match fields.get(0):
						Some(field):
							(name, field_value) = field
							record_ok = name == "value" and compiler_ctfe_values_equal(
								field_value,
								compiler_ctfe_int(source_span(), 3),
							)
						None:
							void
				_:
					void
		Err(_):
			void

	list_ok and record_ok


func test_eval_if_range_field_and_record_update() -> Bool:
	base_field: CompilerTypedRecordField = {
		name = ident("value"),
		value = int_expr("1"),
		span = source_span()
	}
	update_field: CompilerTypedRecordField = {
		name = ident("value"),
		value = int_expr("9"),
		span = source_span()
	}
	record_expr = CompilerTypedRecordExpr(
		[base_field],
		source_span(),
		expr_info_for(CompilerNamedType("Box", [])),
	)
	if_expr = CompilerTypedIfExpr(
		bool_expr(False),
		name_expr("MISSING"),
		Some(int_expr("7")),
		source_span(),
		expr_info(),
	)
	range_expr = CompilerTypedRangeExpr(
		int_expr("0"),
		int_expr("3"),
		source_span(),
		expr_info_for(CompilerRangeType(compiler_type_int())),
	)
	field_expr = CompilerTypedFieldAccessExpr(
		record_expr,
		ident("value"),
		source_span(),
		expr_info(),
	)
	update_expr = CompilerTypedRecordUpdateExpr(
		record_expr,
		[update_field],
		source_span(),
		expr_info_for(CompilerNamedType("Box", [])),
	)
	env = compiler_ctfe_env_empty()
	context = compiler_ctfe_context_empty()

	if_ok = value_equals(
		compiler_ctfe_eval_typed_expr(context, env, if_expr),
		compiler_ctfe_int(source_span(), 7),
	)
	field_ok = value_equals(
		compiler_ctfe_eval_typed_expr(context, env, field_expr),
		compiler_ctfe_int(source_span(), 1),
	)

	var range_ok: Bool = False

	match compiler_ctfe_eval_typed_expr(context, env, range_expr):
		Ok(value):
			match value.desc:
				CompilerCtfeRangeValue(start_value, end_value):
					range_ok = compiler_ctfe_values_equal(
						start_value,
						compiler_ctfe_int(source_span(), 0),
					) and compiler_ctfe_values_equal(
						end_value,
						compiler_ctfe_int(source_span(), 3),
					)
				_:
					void
		Err(_):
			void

	var update_ok: Bool = False

	match compiler_ctfe_eval_typed_expr(context, env, update_expr):
		Ok(value):
			match value.desc:
				CompilerCtfeRecordValue(fields):
					match fields.get(0):
						Some(field):
							(name, field_value) = field
							update_ok = name == "value" and compiler_ctfe_values_equal(
								field_value,
								compiler_ctfe_int(source_span(), 9),
							)
						None:
							void
				_:
					void
		Err(_):
			void

	if_ok and range_ok and field_ok and update_ok


func test_eval_block_local_bindings() -> Bool:
	payload: CompilerTypedVarDeclPayload = {
		name = ident("x"),
		annotation = Some(compiler_type_int()),
		initializer = int_expr("40"),
		is_mutable = False,
		span = source_span()
	}
	block = CompilerTypedBlockExpr(
		[
			CompilerTypedVarDeclExpr(payload, expr_info_for(compiler_type_void())),
			CompilerTypedBinaryExpr(
				ParsedAddOp,
				name_expr("x"),
				int_expr("2"),
				source_span(),
				expr_info(),
			),
		],
		source_span(),
		expr_info(),
	)

	value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			block,
		),
		compiler_ctfe_int(source_span(), 42),
	)


func test_eval_block_mutable_local_assignment() -> Bool:
	payload: CompilerTypedVarDeclPayload = {
		name = ident("x"),
		annotation = Some(compiler_type_int()),
		initializer = int_expr("1"),
		is_mutable = True,
		span = source_span()
	}
	block = CompilerTypedBlockExpr(
		[
			CompilerTypedVarDeclExpr(payload, expr_info_for(compiler_type_void())),
			CompilerTypedAssignExpr(
				ident("x"),
				CompilerLocalAssignScope,
				int_expr("41"),
				source_span(),
				expr_info_for(compiler_type_void()),
			),
			CompilerTypedBinaryExpr(
				ParsedAddOp,
				name_expr("x"),
				int_expr("1"),
				source_span(),
				expr_info(),
			),
		],
		source_span(),
		expr_info(),
	)

	value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			block,
		),
		compiler_ctfe_int(source_span(), 42),
	)


func test_eval_block_rejects_immutable_local_assignment() -> Bool:
	payload: CompilerTypedVarDeclPayload = {
		name = ident("x"),
		annotation = Some(compiler_type_int()),
		initializer = int_expr("1"),
		is_mutable = False,
		span = source_span()
	}
	block = CompilerTypedBlockExpr(
		[
			CompilerTypedVarDeclExpr(payload, expr_info_for(compiler_type_void())),
			CompilerTypedAssignExpr(
				ident("x"),
				CompilerLocalAssignScope,
				int_expr("2"),
				source_span(),
				expr_info_for(compiler_type_void()),
			),
			name_expr("x"),
		],
		source_span(),
		expr_info(),
	)

	error_message(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			block,
		),
	) == "compile-time assignment target 'x' is immutable"


func test_eval_block_tuple_destructuring() -> Bool:
	tuple_type = CompilerTupleType([compiler_type_int(), compiler_type_int()])
	block = CompilerTypedBlockExpr(
		[
			CompilerTypedTupleDestructExpr(
				[ident("left"), ident("right")],
				CompilerTypedTupleExpr(
					[int_expr("40"), int_expr("2")],
					source_span(),
					expr_info_for(tuple_type),
				),
				source_span(),
				expr_info_for(compiler_type_void()),
			),
			CompilerTypedBinaryExpr(
				ParsedAddOp,
				name_expr("left"),
				name_expr("right"),
				source_span(),
				expr_info(),
			),
		],
		source_span(),
		expr_info(),
	)

	value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			block,
		),
		compiler_ctfe_int(source_span(), 42),
	)


func test_eval_nullary_constructor_reference() -> Bool:
	result = compiler_ctfe_eval_typed_expr(
		constructor_context(),
		compiler_ctfe_env_empty(),
		CompilerTypedNameExpr(
			ident("None"),
			expr_info_for(CompilerNamedType("Option", [compiler_type_int()])),
		),
	)

	match result:
		Ok(value):
			match value.desc:
				CompilerCtfeConstructorValue(payload):
					payload.name == "None" and payload.constructor_info.parent_type == "Option"
				_:
					False
		Err(_):
			False


func test_eval_errors_are_reported() -> Bool:
	unknown_message = error_message(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			name_expr("MISSING"),
		),
	)
	function_message = error_message(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			name_expr_with_call(
				"helper",
				local_resolved_call(3, "helper#3"),
			),
		),
	)
	translate_message = error_message(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			CompilerTypedCallExpr(name_expr("helper"), [], source_span(), expr_info()),
		),
	)

	(
		unknown_message == "global constant initializer cannot reference 'MISSING' before it is evaluated"
		and function_message == (
			"compile-time constant evaluation does not support function reference 'helper' "
			+ "yet"
		)
		and translate_message == "compile-time constant evaluation does not support function calls yet"
	)


tests: TestSuite = {
	description = "Compiler CTFE eval",
	tests = [
		("eval literals and binary ops", test_eval_literals_and_binary_ops),
		("eval identifier lookup", test_eval_identifier_lookup),
		("eval logical short circuits", test_eval_logical_short_circuits),
		("eval collection and record values", test_eval_collection_and_record_values),
		("eval if range field and record update", test_eval_if_range_field_and_record_update),
		("eval block local bindings", test_eval_block_local_bindings),
		("eval block mutable local assignment", test_eval_block_mutable_local_assignment),
		(
			"eval block rejects immutable local assignment",
			test_eval_block_rejects_immutable_local_assignment,
		),
		("eval block tuple destructuring", test_eval_block_tuple_destructuring),
		("eval nullary constructor reference", test_eval_nullary_constructor_reference),
		("eval errors are reported", test_eval_errors_are_reported),
	]
}
