func test_eval_imported_std_option_and_result_intrinsics() -> Bool:
	option_type = CompilerNamedType("Option", [compiler_type_int()])
	result_type = CompilerNamedType(
		"Result",
		[compiler_type_int(), compiler_type_string()],
	)
	env = compiler_ctfe_bind_global_value(
		compiler_ctfe_bind_global_value(
			compiler_ctfe_bind_global_value(
				compiler_ctfe_env_empty(),
				"some_value",
				compiler_ctfe_option_some_value(
					option_type,
					source_span(),
					compiler_ctfe_int(source_span(), 7),
				),
			),
			"none_value",
			compiler_ctfe_option_none_value(option_type, source_span()),
		),
		"ok_value",
		compiler_ctfe_result_ok_value(
			result_type,
			source_span(),
			compiler_ctfe_int(source_span(), 9),
		),
	)
	some_get_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			env,
			imported_call_expr(
				"std/option",
				60,
				"get_or#60",
				[name_expr_for("some_value", option_type), int_expr("1")],
				compiler_type_int(),
			),
		),
		compiler_ctfe_int(
			source_span(),
			7,
		),
	)
	none_is_none_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			env,
			imported_call_expr(
				"std/option",
				61,
				"is_none#61",
				[name_expr_for("none_value", option_type)],
				compiler_type_bool(),
			),
		),
		compiler_ctfe_bool(source_span(), True),
	)
	result_get_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			env,
			imported_call_expr(
				"std/result",
				62,
				"get_or#62",
				[name_expr_for("ok_value", result_type), int_expr("1")],
				compiler_type_int(),
			),
		),
		compiler_ctfe_int(
			source_span(),
			9,
		),
	)
	from_some_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			env,
			imported_call_expr(
				"std/result",
				63,
				"from_option#63",
				[name_expr_for("some_value", option_type), string_expr("missing")],
				result_type,
			),
		),
		compiler_ctfe_result_ok_value(
			result_type,
			source_span(),
			compiler_ctfe_int(source_span(), 7),
		),
	)
	from_none_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			env,
			imported_call_expr(
				"std/result",
				64,
				"from_option#64",
				[name_expr_for("none_value", option_type), string_expr("missing")],
				result_type,
			),
		),
		compiler_ctfe_result_err_value(
			result_type,
			source_span(),
			compiler_ctfe_string(source_span(), "missing"),
		),
	)
	to_option_some_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			env,
			imported_call_expr(
				"std/result",
				65,
				"to_option#65",
				[name_expr_for("ok_value", result_type)],
				option_type,
			),
		),
		compiler_ctfe_option_some_value(
			option_type,
			source_span(),
			compiler_ctfe_int(source_span(), 9),
		),
	)
	err_value = compiler_ctfe_result_err_value(
		result_type,
		source_span(),
		compiler_ctfe_string(source_span(), "missing"),
	)
	to_option_none_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_bind_global_value(env, "err_value", err_value),
			imported_call_expr(
				"std/result",
				66,
				"to_option#66",
				[name_expr_for("err_value", result_type)],
				option_type,
			),
		),
		compiler_ctfe_option_none_value(option_type, source_span()),
	)

	(
		some_get_ok
		and none_is_none_ok
		and result_get_ok
		and from_some_ok
		and from_none_ok
		and to_option_some_ok
		and to_option_none_ok
	)


func test_eval_imported_std_option_and_result_map_use_named_callback() -> Bool:
	option_type = CompilerNamedType("Option", [compiler_type_int()])
	result_type = CompilerNamedType(
		"Result",
		[compiler_type_int(), compiler_type_string()],
	)
	env = compiler_ctfe_bind_global_value(
		compiler_ctfe_bind_global_value(
			compiler_ctfe_env_empty(),
			"some_value",
			compiler_ctfe_option_some_value(
				option_type,
				source_span(),
				compiler_ctfe_int(source_span(), 7),
			),
		),
		"ok_value",
		compiler_ctfe_result_ok_value(
			result_type,
			source_span(),
			compiler_ctfe_int(source_span(), 9),
		),
	)
	callback = local_function_reference_expr(
		"increment",
		72,
		[compiler_type_int()],
		compiler_type_int(),
	)
	body = CompilerTypedBinaryExpr(
		ParsedAddOp,
		name_expr("value"),
		int_expr("1"),
		source_span(),
		expr_info(),
	)
	context = function_context(
		[(72, ctfe_function(72, "increment", [param("value")], Some(body), True))],
	)
	option_map_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			context,
			env,
			imported_call_expr(
				"std/option",
				73,
				"map#73",
				[name_expr_for("some_value", option_type), callback],
				option_type,
			),
		),
		compiler_ctfe_option_some_value(
			option_type,
			source_span(),
			compiler_ctfe_int(source_span(), 8),
		),
	)
	result_map_ok = value_equals(
		compiler_ctfe_eval_typed_expr(
			context,
			env,
			imported_call_expr(
				"std/result",
				74,
				"map#74",
				[name_expr_for("ok_value", result_type), callback],
				result_type,
			),
		),
		compiler_ctfe_result_ok_value(
			result_type,
			source_span(),
			compiler_ctfe_int(source_span(), 10),
		),
	)

	option_map_ok and result_map_ok


func test_eval_constructor_call() -> Bool:
	option_type = CompilerNamedType("Option", [compiler_type_int()])
	call = resolved_call_with_origin(12, "Some#12", CompilerCallableConstructor("Option"))
	expr = CompilerTypedCallExpr(
		name_expr_with_call("Some", call),
		[int_expr("42")],
		source_span(),
		expr_info_for_with_call(option_type, call),
	)

	match compiler_ctfe_eval_typed_expr(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		expr,
	):
		Ok(value):
			match value.desc:
				CompilerCtfeConstructorValue(payload):
					(
						payload.name == "Some"
						and payload.constructor_info.parent_type == "Option"
						and payload.constructor_info.arity == 1
						and payload.constructor_info.callable_id == Some(12)
						and payload.args.length() == 1
					)
				_:
					False
		Err(_):
			False


func test_eval_errors_are_reported() -> Bool:
	unknown_message = error_message(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			name_expr("MISSING"),
		),
	)
	function_message = error_message(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			name_expr_with_call(
				"helper",
				resolved_call_with_origin(3, "helper#3", CompilerCallableImported("dep/helper")),
			),
		),
	)
	unresolved_call_message = error_message(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			CompilerTypedCallExpr(name_expr("helper"), [], source_span(), expr_info()),
		),
	)

	(
		unknown_message == "global constant initializer cannot reference 'MISSING' before it is evaluated"
		and function_message == (
			"compile-time constant evaluation does not support function reference 'helper' "
			+ "yet"
		)
		and unresolved_call_message == "compile-time constant evaluation does not support unresolved function calls yet"
	)


