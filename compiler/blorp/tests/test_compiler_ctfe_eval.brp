func test_eval_lambda_preserves_lexical_environment() -> Bool:
	without_locals = match compiler_ctfe_eval_typed_expr(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		lambda_expr(),
	):
		Ok(value):
			match value.desc:
				CompilerCtfeLambdaValue(closure):
					not compiler_ctfe_has_local_bindings(closure.env)
				_:
					False
		Err(_):
			False

	local_env = compiler_ctfe_bind_local_value(
		compiler_ctfe_env_empty(),
		"offset",
		compiler_ctfe_int(source_span(), 3),
	)

	with_locals = match compiler_ctfe_eval_typed_expr(
		compiler_ctfe_context_empty(),
		local_env,
		lambda_expr(),
	):
		Ok(value):
			match value.desc:
				CompilerCtfeLambdaValue(closure):
					compiler_ctfe_has_local_bindings(closure.env)
				_:
					False
		Err(_):
			False

	without_locals and with_locals


