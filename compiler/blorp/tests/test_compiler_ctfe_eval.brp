		compiler_ctfe_int(source_span(), 2),
	)


func test_eval_checked_tensor_get_normalizes_negative_indices() -> Bool:
	row_type = CompilerArrayType(compiler_type_int(), [CompilerConstIntType(2)])
	matrix_type = CompilerArrayType(
