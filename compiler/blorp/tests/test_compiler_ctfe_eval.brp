func test_eval_sized_float_conversion_builtins() -> Bool:
	float32_type = CompilerNamedType("Float32", [])
	float16_type = CompilerNamedType("Float16", [])
	float32_result = compiler_ctfe_eval_typed_expr(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		builtin_call_expr("to_float32", float_expr("16777217.0"), float32_type),
	)
	float16_result = compiler_ctfe_eval_typed_expr(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		builtin_call_expr("to_float16", float_expr("1.0001"), float16_type),
	)

	float32_ok = match float32_result:
		Ok(value):
			match value.desc:
				CompilerCtfeFloatValue(raw):
					raw == 16777216.0 and compiler_types_equal(value.typ, float32_type)
				_:
					False
		Err(_):
			False

	float16_ok = match float16_result:
		Ok(value):
			match value.desc:
				CompilerCtfeFloatValue(raw):
					raw == 1.0 and compiler_types_equal(value.typ, float16_type)
				_:
					False
		Err(_):
			False

	float32_ok and float16_ok


func test_eval_length_builtin() -> Bool:
	list_type = compiler_type_list(compiler_type_int())
