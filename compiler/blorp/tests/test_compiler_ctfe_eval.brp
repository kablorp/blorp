func test_eval_imported_sized_float_conversion_intrinsics() -> Bool:
	float32_type = CompilerNamedType("Float32", [])
	result = compiler_ctfe_eval_typed_expr(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		imported_call_expr(
			"std/float",
			51,
			"to_float32#51",
			[float_expr("16777217.0")],
			float32_type,
		),
	)

	match result:
		Ok(value):
			match value.desc:
				CompilerCtfeFloatValue(raw):
					raw == 16777216.0 and compiler_types_equal(value.typ, float32_type)
				_:
					False
		Err(_):
			False


