func test_eval_while_break_and_continue_control_flow() -> Bool:
	i_payload: CompilerTypedVarDeclPayload = {
		name = ident("i"),
		annotation = Some(compiler_type_int()),
		initializer = int_expr("0"),
		is_mutable = True,
		span = source_span()
	}
	total_payload: CompilerTypedVarDeclPayload = {
		name = ident("total"),
		annotation = Some(compiler_type_int()),
		initializer = int_expr("0"),
		is_mutable = True,
		span = source_span()
	}
	increment_i = CompilerTypedAssignExpr(
		ident("i"),
		CompilerLocalAssignScope,
		int_binary_expr(ParsedAddOp, name_expr("i"), int_expr("1")),
		source_span(),
		void_expr_info(),
	)
	skip_two = CompilerTypedIfExpr(
		bool_binary_expr(ParsedEqualOp, name_expr("i"), int_expr("2")),
		CompilerTypedContinueExpr(source_span(), void_expr_info()),
		None,
		source_span(),
		void_expr_info(),
	)
	break_at_four = CompilerTypedIfExpr(
		bool_binary_expr(ParsedEqualOp, name_expr("i"), int_expr("4")),
		CompilerTypedBreakExpr(source_span(), void_expr_info()),
		None,
		source_span(),
		void_expr_info(),
	)
	add_to_total = CompilerTypedAssignExpr(
		ident("total"),
		CompilerLocalAssignScope,
		int_binary_expr(ParsedAddOp, name_expr("total"), name_expr("i")),
		source_span(),
		void_expr_info(),
	)
	body = CompilerTypedBlockExpr(
		[increment_i, skip_two, break_at_four, add_to_total],
		source_span(),
		void_expr_info(),
	)
	block = CompilerTypedBlockExpr(
		[
			CompilerTypedVarDeclExpr(i_payload, void_expr_info()),
			CompilerTypedVarDeclExpr(total_payload, void_expr_info()),
			CompilerTypedWhileExpr(
				bool_binary_expr(ParsedLessOp, name_expr("i"), int_expr("5")),
				body,
				source_span(),
				void_expr_info(),
			),
			name_expr("total"),
		],
		source_span(),
		expr_info(),
	)

	value_equals(
		compiler_ctfe_eval_typed_expr(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			block,
		),
		compiler_ctfe_int(source_span(), 4),
	)


