import:
	../compiler_bridge_protocol: BridgeAction(RunCliAction), BridgeEnvelope
	../compiler_cli:
		CliDelegationIo(BatchCliDelegation, TerminalCliDelegation),
		CliFrontendCommand(CliFrontendCheck, CliFrontendCompile),
		CliPackageRunCommand(
			CliPackageRunCheck,
			CliPackageRunFetchTarget,
			CliPackageRunPack,
			CliPackageRunVendorTarget,
		),
		CliRunPlan(
			CliRunDelegate,
			CliRunFrontendOptions,
			CliRunHandled,
			CliRunLsp,
			CliRunPackage,
			CliRunParsedSource,
			CliRunPurify,
			CliRunRepl,
			CliRunTest,
		),
		handle_cli_run_envelope,
		run_cli,
		run_cli_with_version,
	json:
		JsonValue(JsonBool, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_string,
		get_field,
	system: read_file, remove_file, temp_dir, write_file
	test: TestSuite


pure func json_array_length_field(value: JsonValue, name: String) -> Int:
	match get_field(value, name):
		Some(field):
			match as_array(field):
				Some(items):
					items.length()
				None:
					-1
		None:
			-1


pure func json_string_field(value: JsonValue, name: String) -> String:
	match get_field(value, name):
		Some(field):
			match as_string(field):
				Some(text):
					text
				None:
					""
		None:
			""


pure func json_bool_field(value: JsonValue, name: String) -> Bool:
	match get_field(value, name):
		Some(JsonBool(value)):
			value
		_:
			False


pure func json_int_field(value: JsonValue, name: String) -> Int:
	match get_field(value, name):
		Some(JsonNumber(value)):
			to_int(value)
		_:
			-1


func test_run_cli_keeps_frontend_options_without_source_parse() -> Bool:
	match run_cli([
		"check",
		"--no-format",
		"a.brp",
		"b.brp",
	]):
		CliRunFrontendOptions(plan):
			(
				plan.command == CliFrontendCheck
				and plan.args == ["check", "--no-format", "a.brp", "b.brp"]
				and json_string_field(plan.options, "kind") == "check"
				and json_bool_field(plan.options, "no_format")
				and json_array_length_field(plan.options, "paths") == 2
			)
		CliRunDelegate(_):
			False
		CliRunHandled(_):
			False
		CliRunParsedSource(_):
			False
		CliRunTest(_):
			False
		CliRunPurify(_):
			False
		CliRunRepl(_):
			False
		CliRunLsp(_):
			False
		CliRunPackage(_):
			False


