func cleanup_import_spelling_graph_project(root: String, nested: String) -> Void:
	_ = remove_file(root + "/a.brp")
	_ = remove_file(root + "/shared.brp")
	_ = remove_file(nested + "/b.brp")
	_ = remove_dir(nested)
	_ = remove_dir(root)


func test_run_cli_preserves_import_spellings_for_same_path() -> Bool:
	root: String = temp_dir() + "/blorp_cli_import_spelling_graph"
	nested: String = root + "/nested"
	first_path: String = root + "/a.brp"
	second_path: String = nested + "/b.brp"

	cleanup_import_spelling_graph_project(root, nested)

	first_source: String =
		|import:
		|	./shared: shared_value
		|
		|func a() -> Int:
		|	shared_value()
	second_source: String =
		|import:
		|	../shared: shared_value
		|
		|func b() -> Int:
		|	shared_value()
	shared_source: String = "pure func shared_value() -> Int: 9\n"

	if not ((
		mkdir(root)
		and mkdir(nested)
		and write_text_ok(first_path, first_source)
		and write_text_ok(second_path, second_source)
		and write_text_ok(root + "/shared.brp", shared_source)
	)):
		cleanup_import_spelling_graph_project(root, nested)
		False
	else:
		plan: CliRunPlan = run_cli([
			"check",
			"--no-format",
			first_path,
			second_path,
		])
		cleanup_import_spelling_graph_project(root, nested)

		match plan:
			CliRunFrontendModuleGraph(graph):
				var saw_dot_import: Bool = False
				var saw_dotdot_import: Bool = False

				for module in graph.modules:
					if module.path.ends_with("/shared.brp") and module.module_name == "./shared":
						saw_dot_import = True
					else if (
						module.path.ends_with("/shared.brp")
						and module.module_name == "../shared"
					):
						saw_dotdot_import = True

				(
					graph.command == CliFrontendCheck
					and graph.roots.length() == 2
					and graph.import_edges.length() == 2
					and saw_dot_import
					and saw_dotdot_import
				)
			CliRunDelegate(_):
				False
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunRepl(_):
				False
			CliRunLsp(_):
				False
			CliRunPackage(_):
				False


func cleanup_package_graph_project(root: String) -> Void:
	_ = remove_file(root + "/app/main.brp")
	_ = remove_file(root + "/vendor/sample/src/sample/internal.brp")
	_ = remove_file(root + "/vendor/sample/src/sample.brp")
	_ = remove_file(root + "/vendor/sample/package.toml")
	_ = remove_file(root + "/blorp.toml")
	_ = remove_dir(root + "/vendor/sample/src/sample")
	_ = remove_dir(root + "/vendor/sample/src")
	_ = remove_dir(root + "/vendor/sample")
	_ = remove_dir(root + "/vendor")
	_ = remove_dir(root + "/app")
	_ = remove_dir(root)


func test_run_cli_discovers_package_alias_source_graph() -> Bool:
	root: String = temp_dir() + "/blorp_cli_package_graph"
	app_dir: String = root + "/app"
	package_dir: String = root + "/vendor/sample"
	package_src: String = package_dir + "/src"
	package_nested: String = package_src + "/sample"
	main_path: String = app_dir + "/main.brp"

	cleanup_package_graph_project(root)

	created_ok: Bool = (
		mkdir(root)
		and mkdir(app_dir)
		and mkdir(root + "/vendor")
		and mkdir(package_dir)
		and mkdir(package_src)
		and mkdir(package_nested)
	)

	root_source: String =
		|import:
		|	sample_v1: answer
		|
		|func main(args: List[String]) -> Int:
		|	answer()
	package_source: String =
		|import:
		|	sample/internal: inner
		|
		|pure func answer() -> Int:
		|	inner()
	internal_source: String = "pure func inner() -> Int: 42\n"
	manifest: String =
		|[package]
		|name = "sample"
		|
		|[compat]
		|std = "preview-1"
		|
		|[exports]
		|modules = ["sample", "sample/internal"]
	config: String =
		|[packages.sample_v1]
		|path = "vendor/sample"

	if not ((
		created_ok
		and write_text_ok(root + "/blorp.toml", config)
		and write_text_ok(package_dir + "/package.toml", manifest)
		and write_text_ok(package_src + "/sample.brp", package_source)
		and write_text_ok(package_nested + "/internal.brp", internal_source)
		and write_text_ok(main_path, root_source)
	)):
		cleanup_package_graph_project(root)
		False
	else:
		plan: CliRunPlan = run_cli(["compile", "--no-format", main_path])
		cleanup_package_graph_project(root)

		match plan:
			CliRunFrontendModuleGraph(graph):
				var saw_alias: Bool = False
				var saw_internal: Bool = False

				for module in graph.modules:
					if module.module_name == "sample_v1":
						saw_alias = (
							module.path.ends_with("/vendor/sample/src/sample.brp")
							and is_source_package_origin(module, "sample_v1")
						)
					else if module.module_name == "sample/internal":
						saw_internal = (
							module.path.ends_with("/vendor/sample/src/sample/internal.brp")
							and module.source_text == internal_source
							and is_source_package_origin(module, "sample_v1")
						)

				(
					graph.command == CliFrontendCompile
					and graph.roots.length() == 1
					and graph.modules.length() == 2
					and graph.import_edges.length() == 2
					and graph_has_source_package_context(graph, "sample_v1", "/vendor/sample/src")
					and saw_alias
					and saw_internal
				)
			CliRunDelegate(_):
				False
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunRepl(_):
				False
			CliRunLsp(_):
				False
			CliRunPackage(_):
				False


func cleanup_pkg_root_graph_project(root: String) -> Void:
	_ = remove_file(root + "/app/main.brp")
	_ = remove_file(root + "/pkg/local_math.brp")
	_ = remove_dir(root + "/app")
	_ = remove_dir(root + "/pkg")
	_ = remove_dir(root)


func test_run_cli_discovers_pkg_root_source_graph() -> Bool:
	root: String = temp_dir() + "/blorp_cli_pkg_root_graph"
	app_dir: String = root + "/app"
	pkg_dir: String = root + "/pkg"
	main_path: String = app_dir + "/main.brp"
	pkg_path: String = pkg_dir + "/local_math.brp"

	cleanup_pkg_root_graph_project(root)

	root_source: String =
		|import:
		|	pkg/local_math: double
		|
		|func main(args: List[String]) -> Int:
		|	double(21)
	pkg_source: String = "pure func double(x: Int) -> Int:\n\tx * 2\n"

	if not ((
		mkdir(root)
		and mkdir(app_dir)
		and mkdir(pkg_dir)
		and write_text_ok(pkg_path, pkg_source)
		and write_text_ok(main_path, root_source)
	)):
		cleanup_pkg_root_graph_project(root)
		False
	else:
		plan: CliRunPlan = run_cli(["compile", "--no-format", main_path])
		cleanup_pkg_root_graph_project(root)

		match plan:
			CliRunFrontendModuleGraph(graph):
				match graph.modules.get(0):
					Some(module):
						(
							graph.command == CliFrontendCompile
							and graph.roots.length() == 1
							and graph.modules.length() == 1
							and graph.import_edges.length() == 1
							and module.module_name == "pkg/local_math"
							and module.path.ends_with("/pkg/local_math.brp")
							and module.source_text == pkg_source
							and is_pkg_origin(module, "local_math")
							and graph_has_package_root_context(graph, "/pkg")
						)
					None:
						False
			CliRunDelegate(_):
				False
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunRepl(_):
				False
			CliRunLsp(_):
				False
			CliRunPackage(_):
				False


func cleanup_std_context_graph_project(root: String) -> Void:
	_ = remove_file(root + "/app/main.brp")
	_ = remove_file(root + "/blorp.toml")
	_ = remove_dir(root + "/custom_std")
	_ = remove_dir(root + "/app")
	_ = remove_dir(root)


func test_run_cli_carries_config_std_context() -> Bool:
	root: String = temp_dir() + "/blorp_cli_std_context_graph"
	app_dir: String = root + "/app"
	std_dir: String = root + "/custom_std"
	main_path: String = app_dir + "/main.brp"

	cleanup_std_context_graph_project(root)

	source: String =
		|func main(args: List[String]) -> Int:
		|	0
	config: String =
		|[std]
		|path = "custom_std"

	if not ((
		mkdir(root)
		and mkdir(app_dir)
		and mkdir(std_dir)
		and write_text_ok(root + "/blorp.toml", config)
		and write_text_ok(main_path, source)
	)):
		cleanup_std_context_graph_project(root)
		False
	else:
		plan: CliRunPlan = run_cli(["compile", "--no-format", main_path])
		cleanup_std_context_graph_project(root)

		match plan:
			CliRunFrontendModuleGraph(graph):
				match graph.context.std_dir:
					Some(actual_std_dir):
						actual_std_dir.ends_with("/custom_std")
					None:
						False
			CliRunDelegate(_):
				False
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunRepl(_):
				False
			CliRunLsp(_):
				False
			CliRunPackage(_):
				False


func test_run_cli_formats_compile_source_before_parse() -> Bool:
	path: String = temp_dir() + "/blorp_cli_run_compile_format_frontier.brp"
	source: String = "func main(args: List[String]) -> Int:\n\tx=1\n\t0\n"

	match write_file(path, source):
		Ok(_):
			plan: CliRunPlan = run_cli(["compile", path])

			file_ok: Bool = match read_file(path):
				Ok(formatted):
					formatted.contains("x = 1") and not formatted.contains("x=1")
				Err(_):
					False

			_ = remove_file(path)

			plan_ok: Bool = match plan:
				CliRunFrontendModuleGraph(graph):
					graph_has_single_root(graph, CliFrontendCompile, path)
				CliRunDelegate(_):
					False
				CliRunHandled(_):
					False
				CliRunTest(_):
					False
				CliRunPurify(_):
					False
				CliRunRepl(_):
					False
				CliRunLsp(_):
					False
				CliRunPackage(_):
					False

			file_ok and plan_ok
		Err(_):
			False


func test_run_cli_parses_run_source_before_delegation() -> Bool:
	path: String = temp_dir() + "/blorp_cli_run_frontier.brp"
	source: String = "func main(args: List[String]) -> Int: 0"

	match write_file(path, source):
		Ok(_):
			plan: CliRunPlan = run_cli([
				"run",
				"--no-format",
				"--timeout",
				"5",
				path,
			])
			_ = remove_file(path)

			match plan:
				CliRunFrontendModuleGraph(graph):
					match graph.roots.get(0):
						Some(source):
							(
								graph.command == CliFrontendRun
								and source.path == path
								and source.module_name == "blorp_cli_run_frontier"
								and graph_source_decl_count(source) == 1
								and graph_source_diagnostic_count(source) == 0
								and json_string_field(graph.options, "kind") == "run"
								and json_int_field(graph.options, "timeout") == 5
							)
						None:
							False
				CliRunDelegate(_):
					False
				CliRunHandled(_):
					False
				CliRunTest(_):
					False
				CliRunPurify(_):
					False
				CliRunRepl(_):
					False
				CliRunLsp(_):
					False
				CliRunPackage(_):
					False
		Err(_):
			False


