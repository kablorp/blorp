import:
	../compiler_cli:
		CliDelegationIo(BatchCliDelegation, TerminalCliDelegation),
		CliWrapperPlan(CliWrapperDelegate, CliWrapperError),
		plan_cli_wrapper,
	test: TestSuite


func test_compile_delegates_after_parse() -> Bool:
	match plan_cli_wrapper(["compile", "--no-format", "main.brp"]):
		CliWrapperDelegate(delegation):
			(
				delegation.args == ["compile", "--no-format", "main.brp"]
				and delegation.io == BatchCliDelegation
			)
		CliWrapperError(_, _):
			False


func test_terminal_commands_are_marked() -> Bool:
	run_ok: Bool = match plan_cli_wrapper([
		"run",
		"main.brp",
		"--",
		"arg",
	]):
		CliWrapperDelegate(delegation):
			delegation.io == TerminalCliDelegation
		CliWrapperError(_, _):
			False

	repl_ok: Bool = match plan_cli_wrapper(["repl"]):
		CliWrapperDelegate(delegation):
			delegation.io == TerminalCliDelegation
		CliWrapperError(_, _):
			False

	stdin_bridge_ok: Bool = match plan_cli_wrapper(["__compiler-bridge"]):
		CliWrapperDelegate(delegation):
			delegation.io == TerminalCliDelegation
		CliWrapperError(_, _):
			False

	run_ok and repl_ok and stdin_bridge_ok


func test_parse_errors_stop_before_delegation() -> Bool:
	match plan_cli_wrapper(["compile", "--bogus"]):
		CliWrapperError(message, status):
			message == "Error: unknown compile option: --bogus" and status == 1
		CliWrapperDelegate(_):
			False


func test_help_and_version_delegate_for_checkpoint() -> Bool:
	help_ok: Bool = match plan_cli_wrapper(["--help"]):
		CliWrapperDelegate(delegation):
			delegation.args == ["--help"] and delegation.io == BatchCliDelegation
		CliWrapperError(_, _):
			False

	version_ok: Bool = match plan_cli_wrapper(["--version"]):
		CliWrapperDelegate(delegation):
			delegation.args == ["--version"] and delegation.io == BatchCliDelegation
		CliWrapperError(_, _):
			False

	help_ok and version_ok


tests: TestSuite = {
	description = "Blorp CLI wrapper",
	tests = [
		("compile delegates after parse", test_compile_delegates_after_parse),
		("terminal commands are marked", test_terminal_commands_are_marked),
		("parse errors stop before delegation", test_parse_errors_stop_before_delegation),
		(
			"help and version delegate for checkpoint",
			test_help_and_version_delegate_for_checkpoint,
		),
	]
}
