func test_run_cli_formats_directory_check_sources_before_batch_parse() -> Bool:
	root: String = temp_dir() + "/blorp_cli_check_format_dir"
	nested: String = root + "/nested"
	cleanup_check_expansion_tree(root, nested)
	_ = setenv("BLORP_NO_FORMAT", "0")

	created_ok: Bool = mkdir(root) and mkdir(nested)
	writes_ok: Bool = (
		write_text_ok(root + "/a.brp", unformatted_check_source("check_dir_a"))
		and write_text_ok(nested + "/c.brp", unformatted_check_source("check_dir_c"))
	)

	plan: CliRunPlan = run_cli(["check", root])
	first_formatted: Bool = file_contains(root + "/a.brp", "x = 1")
	second_formatted: Bool = file_contains(nested + "/c.brp", "x = 1")
	cleanup_check_expansion_tree(root, nested)

	if not created_ok or not writes_ok:
		False
	else:
		plan_ok: Bool = match plan:
			CliRunFrontendModuleGraph(graph):
				first_ok: Bool = match graph.roots.get(0):
					Some(source):
						graph_source_diagnostic_count(source) == 0
					None:
						False

				second_ok: Bool = match graph.roots.get(1):
					Some(source):
						graph_source_diagnostic_count(source) == 0
					None:
						False

				(
					graph.command == CliFrontendCheck
					and graph.args == ["check", root]
					and graph.roots.length() == 2
					and first_ok
					and second_ok
				)
			CliRunDelegate(_):
				False
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunRepl(_):
				False
			CliRunLsp(_):
				False
			CliRunPackage(_):
				False

		first_formatted and second_formatted and plan_ok


