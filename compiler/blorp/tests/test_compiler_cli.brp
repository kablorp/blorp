func test_cli_run_envelope_handles_version_payload() -> Bool:
	envelope: BridgeEnvelope = {
		schema = 1,
		domain = "compiler",
		action = RunCliAction,
		action_name = "run_cli",
		payload = JsonObject([
			("args", JsonVector([JsonString("--version")])),
			("version", JsonString("blorp bridge-version")),
		])
	}
	response: JsonValue = handle_cli_run_envelope(envelope)

	if not json_bool_field(response, "ok"):
		False
	else:
		match get_field(response, "artifact"):
			Some(artifact):
				(
					json_string_field(artifact, "kind") == "handled"
					and json_string_field(artifact, "stdout") == "blorp bridge-version\n"
					and json_string_field(artifact, "stderr") == ""
				)
			None:
				False


func test_cli_run_envelope_frontend_graph_includes_context() -> Bool:
	path: String = temp_dir() + "/blorp_cli_envelope_graph_context.brp"
	source: String =
		|func main(args: List[String]) -> Int:
		|	0

	match write_file(path, source):
		Ok(_):
			envelope: BridgeEnvelope = {
				schema = 1,
				domain = "compiler",
				action = RunCliAction,
				action_name = "run_cli",
				payload = JsonObject([("args", JsonVector([
							JsonString("compile"),
							JsonString("--no-format"),
							JsonString(path),
						]))])
			}
			response: JsonValue = handle_cli_run_envelope(envelope)
			_ = remove_file(path)

			if not json_bool_field(response, "ok"):
				False
			else:
				match get_field(response, "artifact"):
					Some(artifact):
						match get_field(artifact, "context"):
							Some(context):
								(
									json_string_field(artifact, "kind") == "frontend_module_graph"
									and json_array_length_field(context, "source_packages") == 0
									and json_array_length_field(context, "package_roots") >= 0
								)
							None:
								False
					None:
						False
		Err(_):
			False


