		Err(_):
			False


func test_run_cli_parses_run_source_before_delegation() -> Bool:
	path: String = temp_dir() + "/blorp_cli_run_frontier.brp"
	source: String = "func main(args: List[String]) -> Int: 0"

	match write_file(path, source):
		Ok(_):
			plan: CliRunPlan = run_cli([
				"run",
				"--no-format",
				"--timeout",
				"5",
				path,
			])
			_ = remove_file(path)

			match plan:
				CliRunParsedSource(parsed):
					match get_field(parsed.source.parsed_source, "parsed_ast"):
						Some(parsed_ast):
							(
								parsed.command == CliFrontendRun
								and parsed.source.path == path
								and parsed.source.module_name == "blorp_cli_run_frontier"
								and json_array_length_field(parsed_ast, "decls") == 1
								and json_array_length_field(parsed_ast, "diagnostics") == 0
								and json_string_field(parsed.options, "kind") == "run"
								and json_int_field(parsed.options, "timeout") == 5
							)
						None:
							False
				CliRunParsedSourceBatch(_):
					False
				CliRunDelegate(_):
					False
				CliRunFrontendOptions(_):
					False
				CliRunHandled(_):
					False
				CliRunTest(_):
					False
				CliRunPurify(_):
					False
				CliRunRepl(_):
					False
				CliRunLsp(_):
					False
				CliRunPackage(_):
					False
		Err(_):
			False


func test_run_cli_formats_run_source_before_parse() -> Bool:
	path: String = temp_dir() + "/blorp_cli_run_format_frontier.brp"
	source: String = "func main(args: List[String]) -> Int:\n\tx=1\n\t0\n"

	match write_file(path, source):
		Ok(_):
			plan: CliRunPlan = run_cli(["run", path])

			file_ok: Bool = match read_file(path):
				Ok(formatted):
					formatted.contains("x = 1") and not formatted.contains("x=1")
				Err(_):
					False

			_ = remove_file(path)

			plan_ok: Bool = match plan:
				CliRunParsedSource(parsed):
					parsed.command == CliFrontendRun and parsed.source.path == path
				CliRunParsedSourceBatch(_):
					False
				CliRunDelegate(_):
					False
				CliRunFrontendOptions(_):
					False
				CliRunHandled(_):
					False
				CliRunTest(_):
					False
				CliRunPurify(_):
					False
				CliRunRepl(_):
					False
				CliRunLsp(_):
					False
				CliRunPackage(_):
					False

			file_ok and plan_ok
		Err(_):
			False


func test_run_cli_compile_parse_diagnostics_stay_in_parsed_artifact() -> Bool:
	path: String = temp_dir() + "/blorp_cli_compile_diag.brp"
	_ = remove_file(path)

	if not write_text_ok(path, "func bad(\n"):
		False
	else:
		plan: CliRunPlan = run_cli(["compile", "--no-format", path])
		_ = remove_file(path)

		match plan:
			CliRunParsedSource(parsed):
				(
					parsed.command == CliFrontendCompile
					and parsed.source.path == path
					and parsed.source.module_name == "blorp_cli_compile_diag"
					and parsed_source_diagnostic_count(parsed.source) > 0
				)
			CliRunParsedSourceBatch(_):
				False
			CliRunDelegate(_):
