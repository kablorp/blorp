			result.status == 1 and result.stderr.contains("unknown format option")
		CliRunDelegate(_):
			False
		CliRunFrontendOptions(_):
			False
		CliRunParsedSource(_):
			False
		CliRunTest(_):
			False
		CliRunPurify(_):
			False
		CliRunRepl(_):
			False
		CliRunLsp(_):
			False
		CliRunPackage(_):
			False


tests: TestSuite = {
	description = "Blorp CLI wrapper",
	tests = [
		(
			"run CLI keeps frontend options without source parse",
			test_run_cli_keeps_frontend_options_without_source_parse,
		),
		("run CLI handles format help", test_run_cli_handles_format_help),
		("run CLI handles top-level usage", test_run_cli_handles_top_level_usage),
		("run CLI handles version with context", test_run_cli_handles_version_with_context),
		("CLI run envelope handles version payload", test_cli_run_envelope_handles_version_payload),
		("run CLI handles command help", test_run_cli_handles_command_help),
		("run CLI handles package help", test_run_cli_handles_package_help),
		("run CLI plans package command", test_run_cli_plans_package_command),
		(
			"run CLI parses compile source before delegation",
			test_run_cli_parses_compile_source_before_delegation,
		),
		(
			"run CLI formats compile source before parse",
			test_run_cli_formats_compile_source_before_parse,
		),
		("run CLI plans test command", test_run_cli_plans_test_command),
		("run CLI plans purify command", test_run_cli_plans_purify_command),
		("run CLI plans terminal commands", test_run_cli_plans_terminal_commands),
		("run CLI handles format errors", test_run_cli_handles_format_errors),
	]
}
