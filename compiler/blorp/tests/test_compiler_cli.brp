func test_run_cli_plans_test_command() -> Bool:
	test_ok: Bool = match run_cli([
		"test",
		"--doc",
		"--repeat",
		"3",
		"-j",
		"8",
		"--no-cache",
		"--sanitize=undefined",
		"--timeout",
		"5",
		"--std-dir",
		"custom-std",
		"--no-format",
		"tests",
	]):
		CliRunFrontendModuleGraph(_):
			False
		CliRunTest(test_plan):
			options: JsonValue = test_plan.options

			(
				test_plan.args == [
					"test",
					"--doc",
					"--repeat",
					"3",
					"-j",
					"8",
					"--no-cache",
					"--sanitize=undefined",
					"--timeout",
					"5",
					"--std-dir",
					"custom-std",
					"--no-format",
					"tests",
				]
				and json_string_field(options, "kind") == "test"
				and json_string_field(options, "mode") == "doc"
				and json_string_field(options, "sanitizer") == "undefined"
				and json_string_field(options, "std_dir") == "custom-std"
				and json_bool_field(options, "no_format")
				and not json_bool_field(options, "cache")
				and json_int_field(options, "repeat") == 3
				and json_int_field(options, "jobs") == 8
				and json_int_field(options, "timeout") == 5
				and json_array_length_field(options, "paths") == 1
			)
		CliRunDelegate(_):
			False
		CliRunHandled(_):
			False
		CliRunPurify(_):
			False
		CliRunRepl(_):
			False
		CliRunLsp(_):
			False
		CliRunPackage(_):
			False

	warmup_ok: Bool = match run_cli(["test", "--warmup-only"]):
		CliRunFrontendModuleGraph(_):
			False
		CliRunTest(test_plan):
			(
				test_plan.args == ["test", "--warmup-only"]
				and json_string_field(test_plan.options, "kind") == "test_warmup"
			)
		CliRunDelegate(_):
			False
		CliRunHandled(_):
			False
		CliRunPurify(_):
			False
		CliRunRepl(_):
			False
		CliRunLsp(_):
			False
		CliRunPackage(_):
			False

	test_ok and warmup_ok


func test_run_cli_plans_purify_command() -> Bool:
	match run_cli([
		"purify",
		"--dry-run",
		"--verbose",
		"src",
	]):
		CliRunFrontendModuleGraph(_):
			False
		CliRunPurify(purify_plan):
			options: JsonValue = purify_plan.options

			(
				purify_plan.args == ["purify", "--dry-run", "--verbose", "src"]
				and json_string_field(options, "kind") == "purify"
				and json_bool_field(options, "dry_run")
				and json_bool_field(options, "verbose")
				and json_array_length_field(options, "paths") == 1
			)
		CliRunDelegate(_):
			False
		CliRunHandled(_):
			False
		CliRunTest(_):
			False
		CliRunRepl(_):
			False
		CliRunLsp(_):
			False
		CliRunPackage(_):
			False


