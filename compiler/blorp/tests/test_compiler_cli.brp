			CliRunFrontendOptions(_):
				False
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunRepl(_):
				False
			CliRunLsp(_):
				False
			CliRunPackage(_):
				False


