func test_cli_run_envelope_handles_version_payload() -> Bool:
	envelope: BridgeEnvelope = {
		schema = 1,
		domain = "compiler",
		action = RunCliAction,
		action_name = "run_cli",
		payload = JsonObject([
			("args", JsonVector([JsonString("--version")])),
			("version", JsonString("blorp bridge-version")),
		])
	}
	response: JsonValue = handle_cli_run_envelope(envelope)

	if not json_bool_field(response, "ok"):
		False
	else:
		match get_field(response, "artifact"):
			Some(artifact):
				(
					json_string_field(artifact, "kind") == "handled"
					and json_string_field(artifact, "stdout") == "blorp bridge-version\n"
					and json_string_field(artifact, "stderr") == ""
				)
			None:
				False


