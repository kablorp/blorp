func test_run_cli_handles_format_errors() -> Bool:
	match run_cli(["format", "--bogus"]):
		CliRunHandled(result):
			result.status == 1 and result.stderr.contains("unknown format option")
		CliRunDelegate(_):
			False
		CliRunFrontendOptions(_):
			False
		CliRunParsedSource(_):
			False
		CliRunParsedSourceBatch(_):
			False
		CliRunTest(_):
			False
		CliRunPurify(_):
			False
		CliRunRepl(_):
			False
		CliRunLsp(_):
			False
		CliRunPackage(_):
			False


