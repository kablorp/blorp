import:
	../compiler_bridge_protocol: BridgeAction(RunCliAction), BridgeEnvelope
	../compiler_cli: handle_cli_run_envelope, run_cli, run_cli_with_version
	../compiler_cli_args: CliAction(CliCheck)
	../compiler_cli_plan:
		CliCheckTargetExpansion,
		CliDelegationIo(BatchCliDelegation, TerminalCliDelegation),
		CliFrontendCommand(CliFrontendCheck, CliFrontendCompile, CliFrontendRun),
		CliFrontendGraphSource,
		CliFrontendModuleGraph,
		CliFrontendModuleOrigin(
			CliFrontendPkgModule,
			CliFrontendSourcePackageModule,
			CliFrontendUserModule,
		),
		CliPackageRunCommand(
			CliPackageRunCheck,
			CliPackageRunFetchTarget,
			CliPackageRunPack,
			CliPackageRunVendorTarget,
		),
		CliParsedSourceFile,
		CliRunPlan(
			CliRunDelegate,
			CliRunFrontendModuleGraph,
			CliRunHandled,
			CliRunLsp,
			CliRunPackage,
			CliRunPurify,
			CliRunRepl,
			CliRunTest,
		),
		CliSourceFile,
		CliSourceTarget(CliSourceDirectoryTarget, CliSourceFileTarget),
	../compiler_cli_source_graph: expand_check_targets, source_graph_modules_for_roots
	json:
		JsonValue(JsonBool, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_string,
		get_field,
	system: getcwd, mkdir, read_file, remove_dir, remove_file, setenv, temp_dir, write_file
	test: TestSuite


pure func json_array_length_field(value: JsonValue, name: String) -> Int:
	match get_field(value, name):
		Some(field):
			match as_array(field):
				Some(items):
					items.length()
				None:
					-1
		None:
			-1


pure func json_string_field(value: JsonValue, name: String) -> String:
	match get_field(value, name):
		Some(field):
			match as_string(field):
				Some(text):
					text
				None:
					""
		None:
			""


pure func json_field(value: JsonValue, name: String) -> Option[JsonValue]:
	get_field(value, name)


pure func json_array_item_field(value: JsonValue, name: String, index: Int) -> Option[JsonValue]:
	match get_field(value, name):
		Some(field):
			match as_array(field):
				Some(items):
					items.get(index)
				None:
					None
		None:
			None


pure func json_bool_field(value: JsonValue, name: String) -> Bool:
	match get_field(value, name):
		Some(JsonBool(value)):
			value
		_:
			False


pure func json_int_field(value: JsonValue, name: String) -> Int:
	match get_field(value, name):
		Some(JsonNumber(value)):
			to_int(value)
		_:
			-1


pure func parsed_source_ast_field(source: CliParsedSourceFile) -> Option[JsonValue]:
	get_field(source.parsed_source, "parsed_ast")


pure func parsed_source_decl_count(source: CliParsedSourceFile) -> Int:
	match parsed_source_ast_field(source):
		Some(parsed_ast):
			json_array_length_field(parsed_ast, "decls")
		None:
			-1


pure func parsed_source_diagnostic_count(source: CliParsedSourceFile) -> Int:
	match parsed_source_ast_field(source):
		Some(parsed_ast):
			json_array_length_field(parsed_ast, "diagnostics")
		None:
			-1


pure func graph_source_decl_count(source: CliFrontendGraphSource) -> Int:
	match get_field(source.parsed_source, "parsed_ast"):
		Some(parsed_ast):
			json_array_length_field(parsed_ast, "decls")
		None:
			-1


pure func graph_source_diagnostic_count(source: CliFrontendGraphSource) -> Int:
	match get_field(source.parsed_source, "parsed_ast"):
		Some(parsed_ast):
			json_array_length_field(parsed_ast, "diagnostics")
		None:
			-1


pure func graph_source_ast_phase(source: CliFrontendGraphSource) -> String:
	json_string_field(source.parsed_source, "ast_phase")


pure func graph_source_has_module_surface(source: CliFrontendGraphSource) -> Bool:
	match get_field(source.parsed_source, "module_surface"):
		Some(_):
			True
		None:
			False


pure func module_surface_json_with_imports(imports: List[String]) -> JsonValue:
	JsonObject([
		("kind", JsonString("module_surface")),
		("module", JsonString("synthetic")),
		(
			"imports",
			JsonVector(
				imports.map(func(module_path: String):
					JsonObject([("module_path", JsonString(module_path))])
				),
			),
		),
		("exports", JsonVector([])),
		("private_names", JsonVector([])),
		("private_traits", JsonVector([])),
	])


pure func parsed_source_json_with_surface(imports: List[String]) -> JsonValue:
	JsonObject([("parsed_ast", JsonObject([
				("kind", JsonString("parsed_program")),
				("decls", JsonVector([])),
				("diagnostics", JsonVector([])),
			])), (
			"module_surface",
			module_surface_json_with_imports(
				imports,
			),
		), ("ast_phase", JsonString("typecheck_source"))])


pure func parsed_source_json_with_surface_and_ast_import(
	surface_imports: List[String],
	ast_import_path: String,
) -> JsonValue:
	JsonObject([
		(
			"parsed_ast",
			JsonObject([("kind", JsonString("parsed_program")), ("decls", JsonVector([JsonObject([
							("kind", JsonString("import_block")),
							(
								"imports",
								JsonVector(
									[
										JsonObject(
											[("module_path", JsonString(ast_import_path))],
										),
									],
								),
							),
						])])), ("diagnostics", JsonVector([]))]),
		),
		("module_surface", module_surface_json_with_imports(surface_imports)),
		("ast_phase", JsonString("typecheck_source")),
	])


pure func source_graph_test_check_action(root_path: String) -> CliAction:
	CliCheck({
		dump_ast = False,
		dump_typed_ast = False,
		debug = False,
		no_format = True,
		std_dir = None,
		paths = [root_path],
	})


pure func graph_root_at(
	graph: CliFrontendModuleGraph,
	index: Int,
) -> Option[CliFrontendGraphSource]:
	graph.roots.get(index)


pure func graph_module_at(
	graph: CliFrontendModuleGraph,
	index: Int,
) -> Option[CliFrontendGraphSource]:
	graph.modules.get(index)


pure func graph_has_single_root(
	graph: CliFrontendModuleGraph,
	command: CliFrontendCommand,
	path: String,
) -> Bool:
	match graph.roots:
		[root]:
			graph.command == command and root.path == path
		_:
			False


pure func is_source_package_origin(source: CliFrontendGraphSource, package_alias: String) -> Bool:
	match source.origin:
		CliFrontendSourcePackageModule(actual_package_alias):
			actual_package_alias == package_alias
		_:
			False


pure func is_pkg_origin(source: CliFrontendGraphSource, package_id: String) -> Bool:
	match source.origin:
		CliFrontendPkgModule(actual_package_id):
			actual_package_id == package_id
		_:
			False


pure func graph_has_source_package_context(
	graph: CliFrontendModuleGraph,
	package_alias: String,
	source_dir_suffix: String,
) -> Bool:
	var found: Bool = False

	for package in graph.context.source_packages:
		if (
			package.package_alias == package_alias
			and package.source_dir.ends_with(source_dir_suffix)
		):
			found = True
			break

	found


pure func graph_has_package_root_context(
	graph: CliFrontendModuleGraph,
	root_suffix: String,
) -> Bool:
	var found: Bool = False

	for package_root in graph.context.package_roots:
		if package_root.ends_with(root_suffix):
			found = True
			break

	found


func write_text_ok(path: String, text: String) -> Bool:
	match write_file(path, text):
		Ok(_):
			True
		Err(_):
			False


func cleanup_check_expansion_tree(root: String, nested: String) -> Void:
	_ = remove_file(root + "/a.brp")
	_ = remove_file(root + "/b.brp")
	_ = remove_file(root + "/note.txt")
	_ = remove_file(nested + "/c.brp")
	_ = remove_dir(nested)
	_ = remove_dir(root)


pure func unformatted_check_source(function_name: String) -> String:
	"func " + function_name + "() -> Int:\n\tx=1\n\t0\n"


func file_contains(path: String, text: String) -> Bool:
	match read_file(path):
		Ok(content):
			content.contains(text)
		Err(_):
			False


func test_cli_source_models_represent_targets_and_files() -> Bool:
	file_target: CliSourceTarget = CliSourceFileTarget("src/main.brp")
	dir_target: CliSourceTarget = CliSourceDirectoryTarget("src")
	source_file: CliSourceFile = {
		path = "src/main.brp",
		module_name = "main",
		source_text = "func main(args: List[String]) -> Int: 0"
	}
	parsed_file: CliParsedSourceFile = {
		path = source_file.path,
		module_name = source_file.module_name,
		source_text = source_file.source_text,
		parsed_source = JsonObject([("parsed_ast", JsonObject([]))])
	}

	file_target_ok: Bool = match file_target:
		CliSourceFileTarget(path):
			path == "src/main.brp"
		CliSourceDirectoryTarget(_):
			False

	dir_target_ok: Bool = match dir_target:
		CliSourceDirectoryTarget(path):
			path == "src"
		CliSourceFileTarget(_):
			False

	(
		file_target_ok
		and dir_target_ok
		and parsed_file.path == "src/main.brp"
		and parsed_file.module_name == "main"
	)


func test_source_graph_discovers_imports_from_module_surface() -> Bool:
	root_path: String = temp_dir() + "/blorp_cli_surface_root.brp"
	dep_path: String = temp_dir() + "/blorp_cli_surface_dep.brp"
	_ = remove_file(root_path)
	_ = remove_file(dep_path)

	root: CliParsedSourceFile = {
		path = root_path,
		module_name = "surface_root",
		source_text = "",
		parsed_source = parsed_source_json_with_surface(["./blorp_cli_surface_dep"])
	}
	dep_source: String = "pure func surface_dep_value() -> Int: 11\n"

	if not write_text_ok(dep_path, dep_source):
		False
	else:
		result: Result[List[CliParsedSourceFile], String] = source_graph_modules_for_roots(
			source_graph_test_check_action(root_path),
			[root],
		)
		_ = remove_file(dep_path)

		match result:
			Ok(modules):
				match modules:
					[module]:
						(
							module.path.ends_with("/blorp_cli_surface_dep.brp")
							and module.module_name == "./blorp_cli_surface_dep"
							and module.source_text == dep_source
							and graph_source_has_module_surface({
								path = module.path,
								module_name = module.module_name,
								source_text = module.source_text,
								parsed_source = module.parsed_source,
								origin = CliFrontendUserModule,
							})
						)
					_:
						False
			Err(_):
				False


func test_source_graph_rejects_parsed_source_missing_module_surface() -> Bool:
	root_path: String = temp_dir() + "/blorp_cli_surface_missing_root.brp"
	root: CliParsedSourceFile = {
		path = root_path,
		module_name = "surface_missing_root",
		source_text = "",
		parsed_source = JsonObject([("parsed_ast", JsonObject([
					("kind", JsonString("parsed_program")),
					("decls", JsonVector([])),
					("diagnostics", JsonVector([])),
				])), ("ast_phase", JsonString("typecheck_source"))])
	}

	match source_graph_modules_for_roots(source_graph_test_check_action(root_path), [root]):
		Ok(_):
			False
		Err(message):
			message.contains("missing module_surface")


func test_source_graph_no_longer_depends_on_parsed_ast_import_shape() -> Bool:
	root_path: String = temp_dir() + "/blorp_cli_surface_ast_root.brp"
	dep_path: String = temp_dir() + "/blorp_cli_surface_real_dep.brp"
	_ = remove_file(root_path)
	_ = remove_file(dep_path)

	root: CliParsedSourceFile = {
		path = root_path,
		module_name = "surface_ast_root",
		source_text = "",
		parsed_source = parsed_source_json_with_surface_and_ast_import(
			["./blorp_cli_surface_real_dep"],
			"./blorp_cli_surface_wrong_dep",
		)
	}
	dep_source: String = "pure func real_dep_value() -> Int: 12\n"

	if not write_text_ok(dep_path, dep_source):
		False
	else:
		result: Result[List[CliParsedSourceFile], String] = source_graph_modules_for_roots(
			source_graph_test_check_action(root_path),
			[root],
		)
		_ = remove_file(dep_path)

		match result:
			Ok(modules):
				match modules:
					[module]:
						(
							module.path.ends_with("/blorp_cli_surface_real_dep.brp")
							and module.module_name == "./blorp_cli_surface_real_dep"
						)
					_:
						False
			Err(_):
				False


func test_expand_check_targets_discovers_sorted_directory_sources() -> Bool:
	root: String = temp_dir() + "/blorp_cli_check_targets_dir"
	nested: String = root + "/nested"
	cleanup_check_expansion_tree(root, nested)

	created_ok: Bool = mkdir(root) and mkdir(nested)
	writes_ok: Bool = (
		write_text_ok(root + "/b.brp", "func b() -> Int: 2")
		and write_text_ok(root + "/a.brp", "func a() -> Int: 1")
		and write_text_ok(root + "/note.txt", "ignore")
		and write_text_ok(nested + "/c.brp", "func c() -> Int: 3")
	)

	result: Result[CliCheckTargetExpansion, String] = expand_check_targets([root])
	cleanup_check_expansion_tree(root, nested)

	if not created_ok or not writes_ok:
		False
	else:
		match result:
			Ok(expansion):
				target_ok: Bool = match expansion.targets:
					[CliSourceDirectoryTarget(path)]:
						path == root
					_:
						False

				expected: List[String] = [
					root + "/a.brp",
					root + "/b.brp",
					nested + "/c.brp",
				].sort()

				target_ok and expansion.source_paths == expected
			Err(_):
				False


func test_expand_check_targets_preserves_explicit_file_sources() -> Bool:
	path: String = temp_dir() + "/blorp_cli_explicit_check_target.txt"
	_ = remove_file(path)

	if not write_text_ok(path, "not blorp source"):
		False
	else:
		result: Result[CliCheckTargetExpansion, String] = expand_check_targets([path])
		_ = remove_file(path)

		match result:
			Ok(expansion):
				target_ok: Bool = match expansion.targets:
					[CliSourceFileTarget(target_path)]:
						target_path == path
					_:
						False

				target_ok and expansion.source_paths == [path]
			Err(_):
				False


func test_expand_check_targets_handles_mixed_file_and_directory_targets() -> Bool:
	root: String = temp_dir() + "/blorp_cli_check_targets_mixed_dir"
	nested: String = root + "/nested"
	explicit_path: String = temp_dir() + "/blorp_cli_check_targets_explicit.brp"
	cleanup_check_expansion_tree(root, nested)
	_ = remove_file(explicit_path)

	created_ok: Bool = mkdir(root) and mkdir(nested)
	writes_ok: Bool = (
		write_text_ok(root + "/a.brp", "func a() -> Int: 1")
		and write_text_ok(root + "/note.txt", "ignore")
		and write_text_ok(nested + "/c.brp", "func c() -> Int: 3")
		and write_text_ok(explicit_path, "func explicit() -> Int: 4")
	)

	result: Result[CliCheckTargetExpansion, String] = expand_check_targets([root, explicit_path])
	cleanup_check_expansion_tree(root, nested)
	_ = remove_file(explicit_path)

	if not created_ok or not writes_ok:
		False
	else:
		match result:
			Ok(expansion):
				targets_ok: Bool = match expansion.targets:
					[CliSourceDirectoryTarget(dir_path), CliSourceFileTarget(file_path)]:
						dir_path == root and file_path == explicit_path
					_:
						False

				expected: List[String] = [root + "/a.brp", nested + "/c.brp", explicit_path].sort()

				targets_ok and expansion.source_paths == expected
			Err(_):
				False


func test_expand_check_targets_preserves_empty_directory_targets() -> Bool:
	root: String = temp_dir() + "/blorp_cli_empty_check_dir"
	nested: String = root + "/nested"
	cleanup_check_expansion_tree(root, nested)

	created_ok: Bool = mkdir(root)
	result: Result[CliCheckTargetExpansion, String] = expand_check_targets([root])
	cleanup_check_expansion_tree(root, nested)

	if not created_ok:
		False
	else:
		match result:
			Ok(expansion):
				targets_ok: Bool = match expansion.targets:
					[CliSourceDirectoryTarget(path)]:
						path == root
					_:
						False

				empty_sources: List[String] = []
				targets_ok and expansion.source_paths == empty_sources
			Err(_):
				False


func test_expand_check_targets_reports_missing_targets() -> Bool:
	path: String = temp_dir() + "/blorp_cli_missing_check_target.brp"
	_ = remove_file(path)

	match expand_check_targets([path]):
		Ok(_):
			False
		Err(message):
			(
				message.contains("failed to read source file")
				and message.contains("not found")
				and message.contains(path)
			)


func test_run_cli_returns_frontend_graph_for_multi_file_check() -> Bool:
	first_path: String = temp_dir() + "/blorp_cli_check_multi_a.brp"
	second_path: String = temp_dir() + "/blorp_cli_check_multi_b.brp"
	_ = remove_file(first_path)
	_ = remove_file(second_path)

	if not ((
		write_text_ok(first_path, "func a() -> Int: 1")
		and write_text_ok(second_path, "func b() -> Int: 2")
	)):
		False
	else:
		plan: CliRunPlan = run_cli([
			"check",
			"--no-format",
			first_path,
			second_path,
		])
		_ = remove_file(first_path)
		_ = remove_file(second_path)

		match plan:
			CliRunFrontendModuleGraph(graph):
				first_ok: Bool = match graph.roots.get(0):
					Some(source):
						(
							source.path == first_path
							and source.module_name == "blorp_cli_check_multi_a"
							and graph_source_ast_phase(source) == "typecheck_source"
							and graph_source_decl_count(source) == 1
							and graph_source_diagnostic_count(source) == 0
						)
					None:
						False

				second_ok: Bool = match graph.roots.get(1):
					Some(source):
						(
							source.path == second_path
							and source.module_name == "blorp_cli_check_multi_b"
							and graph_source_ast_phase(source) == "typecheck_source"
							and graph_source_decl_count(source) == 1
							and graph_source_diagnostic_count(source) == 0
						)
					None:
						False

				(
					graph.command == CliFrontendCheck
					and graph.args == ["check", "--no-format", first_path, second_path]
					and json_string_field(graph.options, "kind") == "check"
					and json_bool_field(graph.options, "no_format")
					and json_array_length_field(graph.options, "paths") == 2
					and graph.roots.length() == 2
					and graph.modules.length() == 0
					and graph.import_edges.length() == 0
					and first_ok
					and second_ok
				)
			CliRunDelegate(_):
				False
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunRepl(_):
				False
			CliRunLsp(_):
				False
			CliRunPackage(_):
				False


func test_run_cli_returns_frontend_graph_for_directory_check() -> Bool:
	root: String = temp_dir() + "/blorp_cli_check_single_file_dir"
	nested: String = root + "/nested"
	cleanup_check_expansion_tree(root, nested)

	created_ok: Bool = mkdir(root)
	wrote_ok: Bool = write_text_ok(root + "/a.brp", "func a() -> Int: 1")
	plan: CliRunPlan = run_cli(["check", "--no-format", root])
	cleanup_check_expansion_tree(root, nested)

	if not created_ok or not wrote_ok:
		False
	else:
		match plan:
			CliRunFrontendModuleGraph(graph):
				source_ok: Bool = match graph.roots.get(0):
					Some(source):
						(
							source.path == root + "/a.brp"
							and source.module_name == "a"
							and graph_source_ast_phase(source) == "typecheck_source"
							and graph_source_decl_count(source) == 1
							and graph_source_diagnostic_count(source) == 0
						)
					None:
						False

				(
					graph.command == CliFrontendCheck
					and graph.args == ["check", "--no-format", root]
					and json_string_field(graph.options, "kind") == "check"
					and json_array_length_field(graph.options, "paths") == 1
					and graph.roots.length() == 1
					and graph.modules.length() == 0
					and source_ok
				)
			CliRunDelegate(_):
				False
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunRepl(_):
				False
			CliRunLsp(_):
				False
			CliRunPackage(_):
				False


func test_run_cli_frontend_graph_preserves_parse_diagnostics() -> Bool:
	first_path: String = temp_dir() + "/blorp_cli_check_diag_a.brp"
	second_path: String = temp_dir() + "/blorp_cli_check_diag_b.brp"
	_ = remove_file(first_path)
	_ = remove_file(second_path)

	if not ((
		write_text_ok(first_path, "func a() -> Int: 1")
		and write_text_ok(second_path, "func bad(\n")
	)):
		False
	else:
		plan: CliRunPlan = run_cli([
			"check",
			"--no-format",
			first_path,
			second_path,
		])
		_ = remove_file(first_path)
		_ = remove_file(second_path)

		match plan:
			CliRunFrontendModuleGraph(graph):
				failing_source_ok: Bool = match graph.roots.get(1):
					Some(source):
						(
							source.path == second_path
							and source.module_name == "blorp_cli_check_diag_b"
							and graph_source_ast_phase(source) == "typecheck_source"
							and graph_source_diagnostic_count(source) > 0
						)
					None:
						False

				(
					graph.command == CliFrontendCheck
					and graph.roots.length() == 2
					and failing_source_ok
				)
			CliRunDelegate(_):
				False
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunRepl(_):
				False
			CliRunLsp(_):
				False
			CliRunPackage(_):
				False


func test_run_cli_formats_check_source_before_read() -> Bool:
	path: String = temp_dir() + "/blorp_cli_check_format_source.brp"
	_ = setenv("BLORP_NO_FORMAT", "0")
	_ = remove_file(path)

	if not write_text_ok(path, unformatted_check_source("check_format_source")):
		False
	else:
		plan: CliRunPlan = run_cli(["check", path])
