func test_run_cli_compile_parse_diagnostics_stay_in_parsed_artifact() -> Bool:
	path: String = temp_dir() + "/blorp_cli_compile_diag.brp"
	_ = remove_file(path)

	if not write_text_ok(path, "func bad(\n"):
		False
	else:
		plan: CliRunPlan = run_cli(["compile", "--no-format", path])
		_ = remove_file(path)

		match plan:
			CliRunFrontendModuleGraph(graph):
				source_ok: Bool = match graph.roots.get(0):
					Some(source):
						(
							source.path == path
							and source.module_name == "blorp_cli_compile_diag"
							and graph_source_diagnostic_count(source) > 0
						)
					None:
						False

				graph.command == CliFrontendCompile and graph.roots.length() == 1 and source_ok
			CliRunDelegate(_):
				False
			CliRunHandled(_):
				False
			CliRunTest(_):
				False
			CliRunPurify(_):
				False
			CliRunRepl(_):
				False
			CliRunLsp(_):
				False
			CliRunPackage(_):
				False


