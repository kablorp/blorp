		_ = remove_file(root_path)
		_ = remove_file(dep_path)

		match plan:
			CliRunFrontendModuleGraph(graph):
				match (graph.roots.get(0), graph.modules.get(0)):
					(Some(root), Some(module)):
						(
							graph.command == CliFrontendCompile
							and graph.roots.length() == 1
							and graph.modules.length() == 1
							and graph.import_edges.length() == 1
							and graph_source_has_module_surface(root)
							and graph_source_has_module_surface(module)
							and module.path.ends_with("/blorp_cli_compile_graph_dep.brp")
							and module.module_name == "./blorp_cli_compile_graph_dep"
							and module.source_text == dep_source
