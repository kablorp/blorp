func test_run_cli_plans_package_command() -> Bool:
	check_ok: Bool = match run_cli(["package", "check", "pkg"]):
		CliRunPackage(package_plan):
			command_ok: Bool = match package_plan.command:
				CliPackageRunCheck(path):
					path == "pkg"
				_:
					False

			package_plan.args == ["package", "check", "pkg"] and command_ok
		CliRunDelegate(_):
			False
		CliRunFrontendOptions(_):
			False
		CliRunHandled(_):
			False
		CliRunLsp(_):
			False
		CliRunParsedSource(_):
			False
		CliRunPurify(_):
			False
		CliRunRepl(_):
			False
		CliRunTest(_):
			False

	pack_ok: Bool = match run_cli([
		"package",
		"pack",
		"pkg",
		"-o",
		"pkg.blp",
	]):
		CliRunPackage(package_plan):
			match package_plan.command:
				CliPackageRunPack(path, output):
					path == "pkg" and output == "pkg.blp"
				_:
					False
		CliRunDelegate(_):
			False
		CliRunFrontendOptions(_):
			False
		CliRunHandled(_):
			False
		CliRunLsp(_):
			False
		CliRunParsedSource(_):
			False
		CliRunPurify(_):
			False
		CliRunRepl(_):
			False
		CliRunTest(_):
			False

	fetch_ok: Bool = match run_cli([
		"package",
		"fetch",
		"hash",
		"https://example.invalid/pkg",
	]):
		CliRunPackage(package_plan):
			match package_plan.command:
				CliPackageRunFetchTarget(target, locations):
					target == "hash" and locations == ["https://example.invalid/pkg"]
				_:
					False
		CliRunDelegate(_):
			False
		CliRunFrontendOptions(_):
			False
		CliRunHandled(_):
			False
		CliRunLsp(_):
			False
		CliRunParsedSource(_):
			False
		CliRunPurify(_):
			False
		CliRunRepl(_):
			False
		CliRunTest(_):
			False

	vendor_ok: Bool = match run_cli([
		"package",
		"vendor",
		"hash",
		"vendor/hash",
	]):
		CliRunPackage(package_plan):
			match package_plan.command:
				CliPackageRunVendorTarget(target, dest):
					target == "hash" and dest == Some("vendor/hash")
				_:
					False
		CliRunDelegate(_):
			False
		CliRunFrontendOptions(_):
			False
		CliRunHandled(_):
			False
		CliRunLsp(_):
			False
		CliRunParsedSource(_):
			False
		CliRunPurify(_):
			False
		CliRunRepl(_):
			False
		CliRunTest(_):
			False

	check_ok and pack_ok and fetch_ok and vendor_ok


func test_run_cli_parses_compile_source_before_delegation() -> Bool:
	path: String = temp_dir() + "/blorp_cli_run_compile_frontier.brp"
	source: String = "func main(args: List[String]) -> Int: 0"

	match write_file(path, source):
		Ok(_):
			plan: CliRunPlan = run_cli(["compile", "--no-format", path])
			_ = remove_file(path)

			match plan:
				CliRunParsedSource(parsed):
					match get_field(parsed.parsed_source, "parsed_ast"):
						Some(parsed_ast):
							(
								parsed.command == CliFrontendCompile
								and parsed.path == path
								and parsed.module_name == "blorp_cli_run_compile_frontier"
								and json_array_length_field(parsed_ast, "decls") == 1
								and json_array_length_field(parsed_ast, "diagnostics") == 0
							)
						None:
							False
				CliRunDelegate(_):
					False
				CliRunFrontendOptions(_):
					False
				CliRunHandled(_):
					False
				CliRunTest(_):
					False
				CliRunPurify(_):
					False
				CliRunRepl(_):
					False
				CliRunLsp(_):
					False
				CliRunPackage(_):
					False
		Err(_):
			False


func test_run_cli_formats_compile_source_before_parse() -> Bool:
	path: String = temp_dir() + "/blorp_cli_run_compile_format_frontier.brp"
	source: String = "func main(args: List[String]) -> Int:\n\tx=1\n\t0\n"

	match write_file(path, source):
		Ok(_):
			plan: CliRunPlan = run_cli(["compile", path])

			file_ok: Bool = match read_file(path):
				Ok(formatted):
					formatted.contains("x = 1") and not formatted.contains("x=1")
				Err(_):
					False

			_ = remove_file(path)

			plan_ok: Bool = match plan:
				CliRunParsedSource(parsed):
					parsed.command == CliFrontendCompile and parsed.path == path
				CliRunDelegate(_):
					False
				CliRunFrontendOptions(_):
					False
				CliRunHandled(_):
					False
				CliRunTest(_):
					False
				CliRunPurify(_):
					False
				CliRunRepl(_):
					False
				CliRunLsp(_):
					False
				CliRunPackage(_):
					False

			file_ok and plan_ok
		Err(_):
			False


func test_run_cli_plans_test_command() -> Bool:
	test_ok: Bool = match run_cli([
		"test",
		"--doc",
		"--repeat",
		"3",
		"-j",
		"8",
		"--no-cache",
		"--sanitize=undefined",
		"--timeout",
		"5",
		"--std-dir",
		"custom-std",
		"--no-format",
		"tests",
	]):
		CliRunTest(test_plan):
			options: JsonValue = test_plan.options

			(
				test_plan.args == [
					"test",
					"--doc",
					"--repeat",
					"3",
					"-j",
					"8",
					"--no-cache",
					"--sanitize=undefined",
					"--timeout",
					"5",
					"--std-dir",
					"custom-std",
					"--no-format",
					"tests",
				]
				and json_string_field(options, "kind") == "test"
				and json_string_field(options, "mode") == "doc"
				and json_string_field(options, "sanitizer") == "undefined"
				and json_string_field(options, "std_dir") == "custom-std"
				and json_bool_field(options, "no_format")
				and not json_bool_field(options, "cache")
				and json_int_field(options, "repeat") == 3
				and json_int_field(options, "jobs") == 8
				and json_int_field(options, "timeout") == 5
				and json_array_length_field(options, "paths") == 1
			)
		CliRunDelegate(_):
			False
		CliRunFrontendOptions(_):
			False
		CliRunHandled(_):
			False
		CliRunParsedSource(_):
			False
		CliRunPurify(_):
			False
		CliRunRepl(_):
			False
		CliRunLsp(_):
			False
		CliRunPackage(_):
			False

	warmup_ok: Bool = match run_cli(["test", "--warmup-only"]):
		CliRunTest(test_plan):
			(
				test_plan.args == ["test", "--warmup-only"]
				and json_string_field(test_plan.options, "kind") == "test_warmup"
			)
		CliRunDelegate(_):
			False
		CliRunFrontendOptions(_):
			False
		CliRunHandled(_):
			False
		CliRunParsedSource(_):
			False
		CliRunPurify(_):
			False
		CliRunRepl(_):
			False
		CliRunLsp(_):
			False
		CliRunPackage(_):
			False

	test_ok and warmup_ok


