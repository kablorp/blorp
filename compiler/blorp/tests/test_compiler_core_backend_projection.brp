pure func test_projects_boxed_file_open_result() -> Bool:
	result_type: CoreType = BoxedResultType(named_type("FileReader"), UnionType("IOError"))
	call: CoreExpr = builtin_call(
		"blorp_file_open_read_raw",
		[variable("path", named_type("String"))],
		result_type,
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call)), io_error_decl()],
		foreign_includes = []
	}

	match projected_body(program):
		Some(CallExpr(OperationResultCall(bridge), _, _, _, _)):
			layout_is_boxed: Bool = match bridge.result_layout_policy:
				BoxedResultOnlyPolicy(_):
					True
				_:
					False

			payload_is_handle: Bool = match bridge.success.runtime_payload:
				RuntimeField("handle"):
					True
				_:
					False

			(
				bridge.runtime_result_c_type == "blorp_FileOpenReaderResult"
				and bridge.temp_prefix == "file_open"
				and layout_is_boxed
				and payload_is_handle
				and bridge.error.other_constructor_c_name == "__Other_7"
				and bridge.error.cases.length() == 8
			)
		_:
			False


pure func test_projects_stack_tcp_value_result() -> Bool:
	result_type: CoreType = StackResultType(named_type("Bytes"), UnionType("TcpError"))
	call: CoreExpr = builtin_call(
		"blorp_tcp_read_raw",
		[variable("stream", named_type("TcpStream")), variable("max_bytes", named_type("Int"))],
		result_type,
	)
	program: CoreProgram = {
		decls = [
			function_decl("main", 1, Some(call)),
			union_decl(
				"TcpError",
				[
					"InvalidInput",
					"TimedOut",
					"Closed",
					"Busy",
					"Dns",
					"ConnectionFailed",
					"Interrupted",
					"Unsupported",
					"Other",
				],
			),
		],
		foreign_includes = []
	}

	match projected_body(program):
		Some(CallExpr(OperationResultCall(bridge), _, _, _, _)):
			layout_is_default: Bool = match bridge.result_layout_policy:
				DefaultResultLayoutPolicy:
					True
				_:
					False

			payload_is_value: Bool = match bridge.success.runtime_payload:
				RuntimeField("value"):
					True
				_:
					False

			(
				bridge.runtime_result_c_type == "blorp_TcpBytesResult"
				and layout_is_default
				and payload_is_value
				and bridge.success.release_mask == 1
				and bridge.error.none_tag == "BLORP_TCP_ERROR_NONE"
			)
		_:
			False


pure func test_projects_websocket_union_result() -> Bool:
	result_type: CoreType = StackResultType(UnionType("Message"), UnionType("WebSocketError"))
	call: CoreExpr = builtin_call(
		"blorp_websocket_receive_raw",
		[variable("socket", named_type("WebSocketSession"))],
		result_type,
	)
	program: CoreProgram = {
		decls = [
			function_decl("main", 1, Some(call)),
			union_decl(
				"Message",
				["Text", "Binary", "Close", "Ping", "Pong"],
			),
			websocket_error_decl(),
		],
		foreign_includes = []
	}

	match projected_body(program):
		Some(CallExpr(OperationResultCall(bridge), _, _, _, _)):
			match bridge.success.runtime_payload:
				RuntimeUnionPayload("message_kind", cases):
					match cases:
						[first, ..._]:
							(
								cases.length() == 5
								and first.constructor_name == "Text"
								and first.constructor_c_name == "__Text_0"
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_projects_fallible_stream_terminal() -> Bool:
	result_type: CoreType = StackResultType(named_type("Int"), UnionType("IOError"))
	call: CoreExpr = builtin_call(
		"blorp_fallible_stream_count_raw",
		[variable("stream", named_type("FallibleStream"))],
		result_type,
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call)), io_error_decl()],
		foreign_includes = []
	}

	match projected_body(program):
		Some(CallExpr(FallibleStreamTerminalCall(bridge), _, _, _, _)):
			payload_is_int: Bool = match bridge.payload:
				FallibleStreamPayloadInt:
					True
				_:
					False

			(
				bridge.runtime_result_c_type == "blorp_FallibleStreamIntResult"
				and payload_is_int
				and bridge.error_domain.domain_tag == "BLORP_FALLIBLE_STREAM_ERROR_DOMAIN_FILE"
				and bridge.error_domain.cases.length() == 8
			)
		_:
			False


