import:
	../src/stage_09_core/compiler_core_backend_projection: project_backend_calls
	../src/stage_09_core/compiler_core_json:
		CoreBoxKind(FloatBox, PointerBox),
		CoreCallKind(
			BuiltinCall,
			DictWithCapacityCall,
			DirectRuntimeCall,
			FallibleStreamTerminalCall,
			IntrinsicCall,
			ListToStringCall,
			OperationResultCall,
		),
		CoreDecl(EnumDecl, FunctionDecl, UnionDecl),
		CoreDirectRuntimeArgs(DirectRuntimeArgsAsWritten),
		CoreDirectRuntimeResult(DirectRuntimeResultAsWritten),
		CoreExpr(
			BoxExpr,
			CallExpr,
			DictConstructExpr,
			DictExpr,
			ListAllocExpr,
			ListGetExpr,
			ListRetainExpr,
			ListSetExpr,
			SetAllocExpr,
			StringByteCopyExpr,
			StringByteReadExpr,
			StringByteWriteExpr,
			StringSetLenExpr,
			TensorRawFillExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFallibleStreamTerminalPayload(FallibleStreamPayloadInt),
		CoreFunctionKind(UserFunction),
		CoreHashContainerConstructor(CustomHashContainerConstructor),
		CoreListAccessBounds(ProvenListAccess),
		CoreListStorageLayout(InlineListStorage, PointerListStorage),
		CoreOperationResultLayoutPolicy(BoxedResultOnlyPolicy, DefaultResultLayoutPolicy),
		CoreProgram,
		CoreRuntimeSuccessPayload(RuntimeField, RuntimeUnionPayload),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreTensorDim(TensorStaticDim),
		CoreTensorRawScalarKind(TensorInt64Elements),
		CoreType(
			BoxedResultType,
			EnumType,
			NamedType,
			StackResultType,
			TensorType,
			UnionType,
			VoidType,
		),
		CoreUnionPayloadStorage(ErasedUnionPayloadStorage, TypedUnionPayloadStorage),
		CoreUnionVariant,
		CoreVar,
	test: TestSuite


pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, SyntheticSourceLoc)


pure func builtin_call(name: String, args: List[CoreExpr], result_type: CoreType) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		VoidExpr(VoidType, SyntheticSourceLoc),
		args,
		result_type,
		SyntheticSourceLoc,
	)


pure func intrinsic_call(name: String, args: List[CoreExpr], result_type: CoreType) -> CoreExpr:
	CallExpr(
		IntrinsicCall(name),
		VoidExpr(VoidType, SyntheticSourceLoc),
		args,
		result_type,
		SyntheticSourceLoc,
	)


pure func function_decl(name: String, def_id: Int, body: Option[CoreExpr]) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = None,
		type_params = [],
		params = [],
		return_type = named_type("Int"),
		body = body,
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func union_variant(name: String, tag: Int) -> CoreUnionVariant:
	{
		name = name,
		c_name = "__${name}_${tag}",
		tag_c_name = "__TAG_${name}_${tag}",
		tag = tag,
		fields = [],
		def_id = Some(100 + tag)
	}


pure func union_decl(name: String, variant_names: List[String]) -> CoreDecl:
	var variants: List[CoreUnionVariant] = []
	var tag: Int = 0

	for variant_name in variant_names:
		variants = variants.append(union_variant(variant_name, tag))
		tag += 1

	UnionDecl({
		name = name,
		type_params = [],
		payload_storage = TypedUnionPayloadStorage,
		variants = variants,
		loc = SyntheticSourceLoc,
	})


pure func io_error_decl() -> CoreDecl:
	union_decl(
		"IOError",
		[
			"NotFound",
			"PermissionDenied",
			"AlreadyExists",
			"InvalidInput",
			"Interrupted",
			"TimedOut",
			"Unsupported",
			"Other",
		],
	)


pure func websocket_error_decl() -> CoreDecl:
	union_decl(
		"WebSocketError",
		[
			"InvalidUrl",
			"HandshakeFailed",
			"Transport",
			"Tls",
			"Protocol",
			"TimedOut",
			"Closed",
			"Busy",
			"Unsupported",
			"Other",
		],
	)


pure func projected_body(program: CoreProgram) -> Option[CoreExpr]:
	match project_backend_calls(program).decls:
		[FunctionDecl(function_info), ..._]:
			function_info.body
		_:
			None


pure func direct_args_are_as_written(args: CoreDirectRuntimeArgs) -> Bool:
	match args:
		DirectRuntimeArgsAsWritten:
			True
		_:
			False


pure func direct_result_is_as_written(result: CoreDirectRuntimeResult) -> Bool:
	match result:
		DirectRuntimeResultAsWritten:
			True
		_:
			False


pure func test_projects_known_runtime_call() -> Bool:
	call: CoreExpr = builtin_call(
		"blorp_print",
		[variable("message", named_type("String"))],
		VoidType,
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call))],
		foreign_includes = []
	}

	match projected_body(program):
		Some(CallExpr(DirectRuntimeCall(runtime), _, _, VoidType, _)):
			(
				runtime.name == "blorp_print"
				and direct_args_are_as_written(runtime.args)
				and direct_result_is_as_written(runtime.result)
			)
		_:
			False


pure func test_projects_erased_runtime_argument() -> Bool:
	float_type: CoreType = named_type("Float")
	call: CoreExpr = builtin_call(
		"blorp_vector_set_cow_nullable",
		[variable("values", TensorType({
					element_type = float_type,
					dims = [TensorStaticDim(4)],
				})), variable("index", named_type("Int")), variable("value", float_type)],
		NamedType(
			"Option",
			[TensorType({
					element_type = float_type,
					dims = [TensorStaticDim(4)],
				})],
		),
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call))],
		foreign_includes = []
	}

	match projected_body(program):
		Some(CallExpr(DirectRuntimeCall(runtime), _, [_, _, BoxExpr(box, NamedType("Ptr", []), _)], _, _)):
			(
				runtime.name == "blorp_vector_set_cow_nullable"
				and box.kind == FloatBox
				and box.source_type == float_type
			)
		_:
			False


pure func test_projects_empty_set_literal() -> Bool:
	set_type: CoreType = NamedType("Set", [named_type("Int")])
	program: CoreProgram = {
		decls = [
			function_decl("main", 3, Some(DictExpr([], set_type, SyntheticSourceLoc))),
			function_decl("Hashable_hash_Int", 1, None),
			function_decl("Equatable_equals_Int", 2, None),
		],
		foreign_includes = []
	}

	match projected_body(program):
		Some(SetAllocExpr(_, typ, _)):
			typ == set_type
		_:
			False


pure func projected_memory_intrinsic(
	name: String,
	arg_type: CoreType,
	result_type: CoreType,
) -> Option[String]:
	call: CoreExpr = builtin_call(name, [variable("value", arg_type)], result_type)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call))],
		foreign_includes = []
	}

	match projected_body(program):
		Some(CallExpr(IntrinsicCall(intrinsic), _, _, _, _)):
			Some(intrinsic)
		_:
			None


pure func test_projects_memory_inspection_by_storage() -> Bool:
	(
		projected_memory_intrinsic(
			"blorp_is_unique",
			named_type("String"),
			named_type("Bool"),
		) == Some("memory_is_unique_heap")
		and projected_memory_intrinsic(
			"blorp_is_unique",
			named_type("Int"),
			named_type("Bool"),
		) == Some("memory_is_unique_stack")
		and projected_memory_intrinsic(
			"blorp_refcount",
			named_type("String"),
			named_type("Int"),
		) == Some("memory_refcount_heap")
		and projected_memory_intrinsic(
			"blorp_refcount",
			named_type("Int"),
			named_type("Int"),
		) == Some("memory_refcount_stack")
		and projected_memory_intrinsic(
			"blorp_size_of",
			named_type("String"),
			named_type("Int"),
		) == Some("memory_size_of_heap")
		and projected_memory_intrinsic(
			"blorp_size_of",
			named_type("Int"),
			named_type("Int"),
		) == Some("memory_size_of_stack")
	)


pure func test_preserves_semantic_and_unknown_calls() -> Bool:
	option_type: CoreType = NamedType("Option", [named_type("Int")])
	option_call: CoreExpr = builtin_call(
		"blorp_option_some",
		[variable("value", named_type("Int"))],
		option_type,
	)
	unknown_call: CoreExpr = builtin_call("blorp_not_a_runtime_call", [], VoidType)

	option_program: CoreProgram = {
		decls = [function_decl("main", 1, Some(option_call))],
		foreign_includes = []
	}
	unknown_program: CoreProgram = {
		decls = [function_decl("main", 1, Some(unknown_call))],
		foreign_includes = []
	}

	match (projected_body(option_program), projected_body(unknown_program)):
		(Some(CallExpr(BuiltinCall(option_name), _, _, _, _)), Some(CallExpr(BuiltinCall(unknown_name), _, _, _, _))):
			option_name == "blorp_option_some" and unknown_name == "blorp_not_a_runtime_call"
		_:
			False


