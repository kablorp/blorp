pure func test_projects_unchecked_list_get() -> Bool:
	element_type: CoreType = UnionType("Node")
	list_type: CoreType = NamedType("List", [element_type])
	call: CoreExpr = intrinsic_call(
		"list_get_unchecked",
		[variable("items", list_type), variable("index", named_type("Int"))],
		element_type,
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call))],
		foreign_includes = []
	}

	match projected_body(program):
		Some(ListGetExpr(get, UnionType("Node"), _)):
			layout_is_pointer: Bool = match get.layout:
				PointerListStorage:
					True
				_:
					False

			bounds_are_proven: Bool = match get.bounds:
				ProvenListAccess:
					True
				_:
					False

			layout_is_pointer and bounds_are_proven
		_:
			False


pure func test_projects_parallel_list_alloc() -> Bool:
	element_type: CoreType = EnumType("Bool")
	parallel_list_type: CoreType = NamedType("ParallelList", [element_type])
	call: CoreExpr = intrinsic_call(
		"list_alloc",
		[variable("capacity", named_type("Int"))],
		parallel_list_type,
	)
	program: CoreProgram = {
		decls = [
			function_decl("main", 1, Some(call)),
			EnumDecl({
				name = "Bool",
				type_params = [],
				variants = [
					{
						name = "True",
						c_name = "__def_2_True",
						tag = 0,
						def_id = Some(2)
					},
					{
						name = "False",
						c_name = "__def_3_False",
						tag = 1,
						def_id = Some(3)
					},
				],
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}

	match projected_body(program):
		Some(ListAllocExpr(alloc, _, _)):
			match alloc.layout:
				InlineListStorage(width):
					width == 1 and not alloc.elem_needs_release
				_:
					False
		_:
			False


pure func test_projects_raw_tensor_alloc() -> Bool:
	tensor_type: CoreType = TensorType({
		element_type = named_type("Float"),
		dims = [TensorStaticDim(4)],
	})
	call: CoreExpr = intrinsic_call(
		"tensor_alloc",
		[variable("capacity", named_type("Int"))],
		tensor_type,
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call))],
		foreign_includes = []
	}

	match projected_body(program):
		Some(CallExpr(DirectRuntimeCall(runtime), _, _, _, _)):
			runtime.name == "blorp_vector_new_f64"
		_:
			False


pure func test_projects_ranked_raw_tensor_fill() -> Bool:
	tensor_type: CoreType = TensorType({
		element_type = named_type("Int"),
		dims = [TensorStaticDim(2), TensorStaticDim(3), TensorStaticDim(4)],
	})
	call: CoreExpr = builtin_call(
		"blorp_tensor3_new",
		[
			variable("value", named_type("Int")),
			variable("first", named_type("Int")),
			variable("second", named_type("Int")),
			variable("third", named_type("Int")),
		],
		tensor_type,
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call))],
		foreign_includes = []
	}

	match projected_body(program):
		Some(TensorRawFillExpr(fill, projected_type, _)):
			match fill.raw_kind:
				TensorInt64Elements:
					fill.dims.length() == 3 and projected_type == tensor_type
				_:
					False
		_:
			False


pure func test_projects_list_retain_pointer_ownership() -> Bool:
	list_type: CoreType = NamedType("List", [named_type("Ptr")])
	call: CoreExpr = intrinsic_call(
		"list_retain_for",
		[variable("items", list_type), variable("value", named_type("Ptr"))],
		VoidType,
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call))],
		foreign_includes = []
	}

	match projected_body(program):
		Some(ListRetainExpr(retain, VoidType, _)):
			kind_is_pointer: Bool = match retain.value.kind:
				PointerBox:
					True
				_:
					False

			kind_is_pointer and retain.value.needs_release and not retain.value.transfers_ownership
		_:
			False


pure func test_projects_owned_list_set() -> Bool:
	value_type: CoreType = StackResultType(named_type("Int"), named_type("Int"))
	list_type: CoreType = NamedType("List", [value_type])
	call: CoreExpr = intrinsic_call(
		"list_set_owned",
		[
			variable("items", list_type),
			variable("index", named_type("Int")),
			variable("value", value_type),
		],
		VoidType,
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(call))],
		foreign_includes = []
	}

	match projected_body(program):
		Some(ListSetExpr(set, VoidType, _)):
			set.value.transfers_ownership and set.value_is_stack_result
		_:
			False


pure func project_string_intrinsic(name: String, args: List[CoreExpr]) -> Option[CoreExpr]:
	program: CoreProgram = {
		decls = [function_decl("main", 1, Some(intrinsic_call(name, args, VoidType)))],
		foreign_includes = []
	}
	projected_body(program)


pure func test_projects_string_storage_intrinsics() -> Bool:
	string_value: CoreExpr = variable("text", named_type("String"))
	index: CoreExpr = variable("index", named_type("Int"))
	byte: CoreExpr = variable("byte", named_type("UInt8"))

	read_projected: Bool = match (
		project_string_intrinsic(
			"string_get_byte",
			[string_value, index],
		)
	):
		Some(StringByteReadExpr(_, _, _)):
			True
		_:
			False

	write_projected: Bool = match (
		project_string_intrinsic(
			"string_set_byte",
			[string_value, index, byte],
		)
	):
		Some(StringByteWriteExpr(_, _, _)):
			True
		_:
			False

	copy_projected: Bool = match (
		project_string_intrinsic(
			"string_copy_bytes",
			[string_value, index, string_value, index, index],
		)
	):
		Some(StringByteCopyExpr(_, _, _)):
			True
		_:
			False

	set_len_projected: Bool = match (
		project_string_intrinsic(
			"string_set_len",
			[string_value, index],
		)
	):
		Some(StringSetLenExpr(_, _, _)):
			True
		_:
			False

	read_projected and write_projected and copy_projected and set_len_projected


pure func test_storage_projection_rejects_wrong_arity() -> Bool:
	program: CoreProgram = {
		decls = [
			function_decl(
				"main",
				1,
				Some(intrinsic_call("list_get_unchecked", [], named_type("Int"))),
			),
		],
		foreign_includes = []
	}

	match projected_body(program):
		Some(CallExpr(IntrinsicCall("list_get_unchecked"), _, [], _, _)):
			True
		_:
			False


tests: TestSuite = {
	description = "Core backend projection",
	tests = [
		("projects known runtime call", test_projects_known_runtime_call),
		("projects erased runtime argument", test_projects_erased_runtime_argument),
		("projects empty Set literal", test_projects_empty_set_literal),
		("projects memory inspection by storage", test_projects_memory_inspection_by_storage),
		("preserves semantic and unknown calls", test_preserves_semantic_and_unknown_calls),
		("projects list string callback", test_projects_list_string_callback),
		("projects custom dict constructor", test_projects_custom_dict_constructor),
		("projects empty custom dict constructor", test_projects_empty_custom_dict_constructor),
		("projects empty custom set constructor", test_projects_empty_custom_set_constructor),
		("projects singleton constructor value", test_projects_singleton_constructor_value),
		(
			"projects boxed Option None constructor value",
			test_projects_boxed_option_none_constructor_value,
		),
		(
			"preserves stack Option None constructor value",
			test_preserves_stack_option_none_constructor_value,
		),
		("projects boxed file-open result", test_projects_boxed_file_open_result),
		("projects stack TCP value result", test_projects_stack_tcp_value_result),
		("projects WebSocket runtime-union result", test_projects_websocket_union_result),
		("projects fallible stream terminal", test_projects_fallible_stream_terminal),
		(
			"missing operation constructor fails closed",
			test_missing_operation_constructor_fails_closed,
		),
		("projects unchecked list get", test_projects_unchecked_list_get),
		("projects ParallelList allocation", test_projects_parallel_list_alloc),
		("projects raw tensor allocation", test_projects_raw_tensor_alloc),
		("projects ranked raw tensor fill", test_projects_ranked_raw_tensor_fill),
		("projects list retain pointer ownership", test_projects_list_retain_pointer_ownership),
		("projects owned list set", test_projects_owned_list_set),
		("projects string storage intrinsics", test_projects_string_storage_intrinsics),
		("storage projection rejects wrong arity", test_storage_projection_rejects_wrong_arity),
	]
}
