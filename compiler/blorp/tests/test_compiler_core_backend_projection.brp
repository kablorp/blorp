			),
			UnionDecl({
				name = "Option",
				type_params = ["T"],
				payload_storage = ErasedUnionPayloadStorage,
				variants = [
					union_variant("Some", 1),
					{ union_variant("None", 2) |
						c_name = "__def_102_None",
						def_id = Some(102)
					},
				],
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}

	match projected_body(program):
		Some(VarExpr(variable, NamedType("Option", _), _)):
			variable.name == "__def_102_None"
		_:
			False


