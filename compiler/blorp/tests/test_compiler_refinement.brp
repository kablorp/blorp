import:
	../compiler_refinement:
		CompilerCollectionIdentity,
		CompilerDimensionIdentity,
		CompilerNarrowedSubject(CompilerNarrowedAlias, CompilerNarrowedBinding),
		CompilerOffsetRejection(CompilerOffsetNoMatchingBound, CompilerOffsetOutOfBounds),
		CompilerOffsetSubscriptProof(CompilerOffsetProven, CompilerOffsetRejected),
		CompilerProofSource(
			CompilerProofSourceCondition,
			CompilerProofSourceLoopEnumerate,
			CompilerProofSourceLoopIndices,
			CompilerProofSourceLoopRange,
		),
		CompilerProvenCollection,
		CompilerRangeUpper,
		CompilerSubscriptBound,
		compiler_binding_add_range_proof,
		compiler_binding_add_subscript_proof,
		compiler_binding_direct_collection_vars,
		compiler_binding_proves_direct_range,
		compiler_binding_proves_offset_range,
		compiler_binding_proves_subscript,
		compiler_branch_range_proof,
		compiler_branch_range_subject,
		compiler_collection_dim,
		compiler_collection_dim_at_most,
		compiler_collection_identity,
		compiler_collection_identity_name,
		compiler_collection_length_bound,
		compiler_collection_subscript,
		compiler_collection_var,
		compiler_constant_dim_bound,
		compiler_covers_const_dim,
		compiler_covers_const_dim_with_offset,
		compiler_covers_same_collection,
		compiler_covers_same_collection_with_offset,
		compiler_dimension_bound,
		compiler_dimension_identity,
		compiler_empty_proof_env,
		compiler_immutable_alias_subject,
		compiler_immutable_subject,
		compiler_make_branch_range_proof,
		compiler_make_range_proof,
		compiler_make_range_proof_with_source,
		compiler_make_subscript_proof,
		compiler_mutable_subject,
		compiler_proof_env_add_range_bounds,
		compiler_proof_env_add_subscript,
		compiler_proof_env_apply_subscript_to_binding,
		compiler_proof_env_find_range,
		compiler_proof_env_without_range,
		compiler_proof_env_without_subscript,
		compiler_proof_sources_equal,
		compiler_proven_collections_equal,
		compiler_proves_direct_subscript,
		compiler_proves_direct_subscript_with_bounds,
		compiler_proves_offset_subscript,
		compiler_range_binding,
		compiler_range_proof_source,
		compiler_range_upper_at_most_length,
		compiler_range_upper_dimension,
		compiler_range_upper_length_minus,
		compiler_range_upper_lit,
		compiler_subscript_bounds,
		compiler_subscript_proof_source,
		compiler_unrefined_binding,
	test: TestSuite


func coll_id(name: String) -> Option[CompilerCollectionIdentity]:
	compiler_collection_identity(name)


func dim_id(name: String) -> Option[CompilerDimensionIdentity]:
	compiler_dimension_identity(name)


func coll_var(name: String) -> Option[CompilerProvenCollection]:
	match coll_id(name):
		Some(identity):
			Some(compiler_collection_var(identity))
		None:
			None


func upper_lit(value: Int) -> Option[CompilerRangeUpper]:
	compiler_range_upper_lit(value)


func bound_const(value: Int) -> Option[CompilerSubscriptBound]:
	compiler_constant_dim_bound(value)


func bound_coll(name: String) -> Option[CompilerSubscriptBound]:
	match coll_id(name):
		Some(identity):
			Some(compiler_collection_length_bound(identity))
		None:
			None


func bound_dim(name: String) -> Option[CompilerSubscriptBound]:
	match dim_id(name):
		Some(identity):
			Some(compiler_dimension_bound(identity))
		None:
			None


func upper_dim(name: String) -> Option[CompilerRangeUpper]:
	match dim_id(name):
		Some(identity):
			Some(compiler_range_upper_dimension(identity))
		None:
			None


func upper_length_minus(name: String, end_offset: Int) -> Option[CompilerRangeUpper]:
	match coll_id(name):
		Some(identity):
			compiler_range_upper_length_minus(identity, end_offset)
		None:
			None


func upper_at_most(name: String) -> Option[CompilerRangeUpper]:
	match coll_id(name):
		Some(identity):
			Some(compiler_range_upper_at_most_length(identity))
		None:
			None


func test_collection_identity_and_proofs() -> Bool:
	match (coll_id("matrix"), coll_id("row"), coll_var("matrix")):
		(Some(matrix), Some(row), Some(matrix_collection)):
			match (compiler_collection_dim(4), compiler_collection_dim(8)):
				(Some(dim4), Some(dim8)):
					a = compiler_collection_subscript(matrix_collection, row)
					b = compiler_collection_subscript(compiler_collection_var(matrix), row)

					(
						compiler_collection_identity_name(matrix) == "matrix"
						and compiler_collection_identity(" ").is_none()
						and compiler_collection_dim(-1).is_none()
						and compiler_proven_collections_equal(a, b)
						and compiler_collection_dim_at_most(dim4, 8)
						and not compiler_collection_dim_at_most(dim8, 4)
					)
				_:
					False
		_:
			False


func test_range_upper_and_direct_bounds() -> Bool:
	match (upper_lit(5), upper_lit(-1), upper_length_minus("xs", 1), upper_length_minus("xs", -1)):
		(Some(lit5), None, Some(length_minus), None):
			match upper_at_most("xs"):
				Some(at_most):
					literal_proof_opt = compiler_make_range_proof(0, lit5)
					length_proof_opt = compiler_make_range_proof(0, length_minus)
					at_most_proof_opt = compiler_make_range_proof(0, at_most)

					match (literal_proof_opt, length_proof_opt, at_most_proof_opt, coll_id("xs")):
						(Some(literal_proof), Some(length_proof), Some(at_most_proof), Some(xs)):
							(
								compiler_covers_const_dim(literal_proof, 5)
								and not compiler_covers_const_dim(literal_proof, 4)
								and compiler_covers_same_collection(length_proof, xs)
								and compiler_covers_same_collection(at_most_proof, xs)
							)
						_:
							False
				None:
					False
		_:
			False


func test_dimension_bounds_and_offsets() -> Bool:
	match (upper_dim("#N"), bound_dim("#N"), bound_dim("#M"), upper_lit(5)):
		(Some(dim_upper), Some(bound_n), Some(bound_m), Some(lit5)):
			match (upper_length_minus("xs", 1), coll_id("xs")):
				(Some(length_minus), Some(xs)):
					dim_proof_opt = compiler_make_range_proof(0, dim_upper)
					literal_proof_opt = compiler_make_range_proof(0, lit5)
					symbolic_proof_opt = compiler_make_range_proof(0, length_minus)

					match (dim_proof_opt, literal_proof_opt, symbolic_proof_opt):
						(Some(dim_proof), Some(literal_proof), Some(symbolic_proof)):
							(
								compiler_proves_direct_subscript(dim_proof, [bound_n])
								and not compiler_proves_direct_subscript(dim_proof, [bound_m])
								and match compiler_proves_offset_subscript(dim_proof, [bound_n], 1):
									CompilerOffsetRejected(CompilerOffsetNoMatchingBound):
										True
									_:
										False
								and match compiler_covers_const_dim_with_offset(
									literal_proof,
									6,
									1,
								):
									Ok(_):
										True
									Err(_):
										False
								and match compiler_covers_const_dim_with_offset(
									literal_proof,
									5,
									1,
								):
									Err(message):
										message.length() > 0
									Ok(_):
										False
								and compiler_covers_same_collection_with_offset(
									symbolic_proof,
									xs,
									1,
								)
								and not compiler_covers_same_collection_with_offset(
									symbolic_proof,
									xs,
									2,
								)
							)
						_:
							False
				_:
					False
		_:
			False


func test_bounds_grouping_and_dispatch() -> Bool:
	match (bound_const(4), bound_coll("xs"), upper_lit(4), upper_at_most("xs")):
		(Some(const4), Some(xs_bound), Some(lit4), Some(at_most)):
			bounds = compiler_subscript_bounds([const4, xs_bound])
			literal_proof_opt = compiler_make_range_proof(0, lit4)
			symbolic_proof_opt = compiler_make_range_proof(0, at_most)

			match (literal_proof_opt, symbolic_proof_opt):
				(Some(literal_proof), Some(symbolic_proof)):
					(
						compiler_proves_direct_subscript_with_bounds(literal_proof, bounds)
						and compiler_proves_direct_subscript(
							symbolic_proof,
							[const4, xs_bound],
						)
						and match compiler_proves_offset_subscript(literal_proof, [const4], 1):
							CompilerOffsetRejected(CompilerOffsetOutOfBounds(message)):
								message.length() > 0
							_:
								False
						and bound_const(-1).is_none()
					)
				_:
					False
		_:
			False


func test_proof_env_replaces_shadowed_proofs() -> Bool:
	match (coll_id("i"), coll_var("xs"), coll_var("ys"), upper_lit(4)):
		(Some(i), Some(xs), Some(ys), Some(lit4)):
			match (upper_lit(8), bound_const(8), bound_const(4)):
				(Some(lit8), Some(bound8), Some(bound4)):
					env = compiler_empty_proof_env()
						.compiler_proof_env_add_subscript(i, xs, CompilerProofSourceLoopRange)
						.compiler_proof_env_add_subscript(i, ys, CompilerProofSourceLoopIndices)
						.compiler_proof_env_add_range_bounds(
							i,
							0,
							lit4,
							CompilerProofSourceLoopRange,
						)
						.compiler_proof_env_add_range_bounds(
							i,
							0,
							lit8,
							CompilerProofSourceLoopIndices,
						)
					binding = compiler_proof_env_apply_subscript_to_binding(
						env,
						i,
						compiler_unrefined_binding(),
					)
					forgotten = env
						.compiler_proof_env_without_subscript(i)
						.compiler_proof_env_without_range(i)
					forgotten_binding = compiler_proof_env_apply_subscript_to_binding(
						forgotten,
						i,
						compiler_unrefined_binding(),
					)

					match compiler_proof_env_find_range(env, i):
						Some(latest_range):
							(
								compiler_binding_proves_subscript(binding, ys)
								and not compiler_binding_proves_subscript(binding, xs)
								and compiler_proves_direct_subscript(latest_range, [bound8])
								and not compiler_proves_direct_subscript(latest_range, [bound4])
								and not compiler_binding_proves_subscript(forgotten_binding, ys)
								and compiler_proof_env_find_range(forgotten, i).is_none()
							)
						None:
							False
				_:
					False
		_:
			False


func test_sources_and_binding_metadata() -> Bool:
	match (upper_lit(4), coll_var("xs"), coll_var("ys"), bound_const(4)):
		(Some(lit4), Some(xs), Some(ys), Some(bound4)):
			range_opt = compiler_make_range_proof_with_source(0, lit4, CompilerProofSourceLoopRange)
			subscript_proof = compiler_make_subscript_proof(xs, CompilerProofSourceLoopEnumerate)

			match range_opt:
				Some(range):
					binding = compiler_unrefined_binding()
						.compiler_binding_add_range_proof(range)
						.compiler_binding_add_subscript_proof(xs, CompilerProofSourceLoopIndices)
					direct_vars = compiler_binding_direct_collection_vars(binding)

					(
						compiler_proof_sources_equal(
							compiler_range_proof_source(range),
							CompilerProofSourceLoopRange,
						)
						and compiler_proof_sources_equal(
							compiler_subscript_proof_source(subscript_proof),
							CompilerProofSourceLoopEnumerate,
						)
						and compiler_binding_proves_subscript(binding, xs)
						and not compiler_binding_proves_subscript(binding, ys)
						and direct_vars.length() == 1
						and match direct_vars.get(0):
							Some(identity):
								compiler_collection_identity_name(identity) == "xs"
							None:
								False
						and compiler_binding_proves_direct_range(binding, [bound4])
					)
				None:
					False
		_:
			False


func test_offset_binding_and_branch_narrowing() -> Bool:
	match (upper_lit(4), upper_lit(10), bound_const(4), bound_const(10)):
		(Some(lit4), Some(lit10), Some(bound4), Some(bound10)):
			offset_range_opt = compiler_make_range_proof(1, lit4)
			immutable_opt = compiler_immutable_subject("i")
			alias_opt = compiler_immutable_alias_subject("j", "i")
			mutable_opt = compiler_mutable_subject("i")

			match offset_range_opt:
				Some(offset_range):
					match (immutable_opt, alias_opt):
						(Some(immutable), Some(alias_subject)):
							match mutable_opt:
								Some(subject_value):
									offset_binding = compiler_range_binding(offset_range)
									immutable_proof_result = compiler_make_branch_range_proof(
										immutable,
										0,
										lit10,
									)
									alias_proof_result = compiler_make_branch_range_proof(
										alias_subject,
										0,
										lit10,
									)
									mutable_result = compiler_make_branch_range_proof(
										subject_value,
										0,
										lit10,
									)

									(
										match compiler_binding_proves_offset_range(
											offset_binding,
											[bound4],
											-1,
										):
											CompilerOffsetProven:
												True
											_:
												False
										and match compiler_binding_proves_offset_range(
											offset_binding,
											[bound4],
											1,
										):
											CompilerOffsetRejected(CompilerOffsetOutOfBounds(_)):
												True
											_:
												False
										and match immutable_proof_result:
											Ok(proof):
												match compiler_branch_range_subject(proof):
													CompilerNarrowedBinding(identity):
														(
															compiler_collection_identity_name(
																identity,
															) == "i"
															and compiler_proves_direct_subscript(
																compiler_branch_range_proof(proof),
																[bound10],
															)
														)
													_:
														False
											Err(_):
												False
										and match alias_proof_result:
											Ok(proof):
												match compiler_branch_range_subject(proof):
													CompilerNarrowedAlias(alias_id, target_id):
														(
															compiler_collection_identity_name(
																alias_id,
															) == "j"
															and compiler_collection_identity_name(
																target_id,
															) == "i"
														)
													_:
														False
											Err(_):
												False
										and match mutable_result:
											Err(CompilerMutableSubjectCannotNarrow):
												True
											_:
												False
										and compiler_immutable_subject("").is_none()
									)
								None:
									False
						_:
							False
				None:
					False
		_:
			False


tests: TestSuite = {
	description = "Compiler refinement proofs",
	tests = [
		("collection identity and proofs", test_collection_identity_and_proofs),
		("range upper and direct bounds", test_range_upper_and_direct_bounds),
		("dimension bounds and offsets", test_dimension_bounds_and_offsets),
		("bounds grouping and dispatch", test_bounds_grouping_and_dispatch),
		("proof env replaces shadowed proofs", test_proof_env_replaces_shadowed_proofs),
		("sources and binding metadata", test_sources_and_binding_metadata),
		("offset binding and branch narrowing", test_offset_binding_and_branch_narrowing),
	]
}
