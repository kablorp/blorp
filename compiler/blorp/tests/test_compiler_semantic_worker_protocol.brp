import:
	../src/stage_09_core/compiler_core_json:
		CoreDecl(
			FunctionDecl,
			HeapRecordDecl,
			ImplDecl,
			TraitDecl,
			TypeAliasDecl,
			UnionDecl,
			ValueRecordDecl,
		),
		CoreExpr(VoidExpr),
		CoreFunction,
		CoreFunctionKind(UnresolvedBuiltinFunction, UserFunction),
		CoreProgram,
		CoreReleasePolicy(NoReleasePolicy),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, TypeParameterType, VoidType),
		CoreUnionField,
		CoreUnionPayloadStorage(ErasedUnionPayloadStorage, TypedUnionPayloadStorage),
		CoreUnionVariant,
	../src/stage_09_core/compiler_semantic_worker_protocol:
		SEMANTIC_MIDDLE_DOMAIN,
		SEMANTIC_MIDDLE_SCHEMA_VERSION,
		SemanticMiddleCapability(
			PostResolveCoreCapability,
			PreDceCoreCapability,
			RenderedStageObservationsCapability,
		),
		SemanticMiddleProjectionError(SemanticMiddleMalformedRuntimeAbiUnion),
		SemanticMiddleProtocolError(SemanticMiddleInvalidCore),
		SemanticMiddleRequest,
		SemanticMiddleResponse(SemanticMiddleCompiled, SemanticMiddleFailed, SemanticMiddleStopped),
		SemanticMiddleStage(FusionMiddleStage, StdInlineMiddleStage, TailrecMiddleStage),
		decode_semantic_middle_response_value,
		parse_semantic_middle_capability,
		parse_semantic_middle_stage,
		project_semantic_middle_program,
		semantic_middle_capability_name,
		semantic_middle_request_to_json,
		semantic_middle_stage_name,
	json:
		JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_bool,
		as_number,
		as_string,
		get_field,
	test: TestSuite


pure func sample_request() -> SemanticMiddleRequest:
	{
		target_path = "src/main.brp",
		target_module_name = "main",
		core = {
			decls = [],
			foreign_includes = []
		},
		next_def_id = 42,
		require_main = True,
		check_invariants = True,
		required_capabilities = [
			PostResolveCoreCapability,
			PreDceCoreCapability,
			RenderedStageObservationsCapability,
		],
		observations = [StdInlineMiddleStage, FusionMiddleStage],
		stop_after = Some(StdInlineMiddleStage)
	}


pure func boundary_function(
	name: String,
	type_params: List[String],
	has_body: Bool,
) -> CoreFunction:
	body: Option[CoreExpr] = if has_body:
		Some(VoidExpr(VoidType, SyntheticSourceLoc))
	else:
		None

	function_kind: CoreFunctionKind = if has_body:
		UserFunction
	else:
		UnresolvedBuiltinFunction

	{
		name = name,
		source_module = None,
		type_params = type_params,
		params = [],
		return_type = VoidType,
		body = body,
		is_pure = True,
		function_kind = function_kind,
		def_id = 1,
		loc = SyntheticSourceLoc
	}


pure func boundary_union(name: String, type_params: List[String]) -> CoreDecl:
	payload_storage: CoreUnionPayloadStorage = if type_params.is_empty():
		TypedUnionPayloadStorage
	else:
		ErasedUnionPayloadStorage

	UnionDecl({
		name = name,
		type_params = type_params,
		payload_storage = payload_storage,
		variants = [],
		loc = SyntheticSourceLoc,
	})


pure func abi_union_variant(
	name: String,
	tag: Int,
	payload_type_parameter: Option[String],
) -> CoreUnionVariant:
	fields: List[CoreUnionField] = match payload_type_parameter:
		Some(type_parameter):
			[
				{
					typ = TypeParameterType(type_parameter),
					release_policy = NoReleasePolicy
				},
			]
		None:
			[]

	{
		name = name,
		c_name = name,
		tag_c_name = "TAG_${name}",
		tag = tag,
		fields = fields,
		def_id = None
	}


pure func runtime_option_union() -> CoreDecl:
	UnionDecl({
		name = "Option",
		type_params = ["T"],
		payload_storage = ErasedUnionPayloadStorage,
		variants = [abi_union_variant("Some", 0, Some("T")), abi_union_variant("None", 1, None)],
		loc = SyntheticSourceLoc,
	})


pure func runtime_result_union() -> CoreDecl:
	UnionDecl({
		name = "Result",
		type_params = ["T", "E"],
		payload_storage = ErasedUnionPayloadStorage,
		variants = [abi_union_variant("Ok", 0, Some("T")), abi_union_variant("Err", 1, Some("E"))],
		loc = SyntheticSourceLoc,
	})


pure func boundary_decl_name(decl: CoreDecl) -> String:
	match decl:
		FunctionDecl(function_info):
			"function:${function_info.name}"
		UnionDecl(union_decl):
			"union:${union_decl.name}"
		ValueRecordDecl(record_decl):
			"value_record:${record_decl.name}"
		HeapRecordDecl(record_decl):
			"heap_record:${record_decl.name}"
		TypeAliasDecl(alias_decl):
			"alias:${alias_decl.name}"
		TraitDecl(trait_decl):
			"trait:${trait_decl.name}"
		ImplDecl(impl_decl):
			"impl:${impl_decl.trait_name}"
		_:
			"other"


pure func test_projects_only_semantic_middle_runtime_declarations() -> Bool:
	t: CoreType = TypeParameterType("T")
	source: CoreProgram = {
		decls = [
			FunctionDecl(boundary_function("generic", ["T"], True)),
			FunctionDecl(boundary_function("main", [], True)),
			FunctionDecl(boundary_function("deferred", [], False)),
			boundary_union("Container", ["T"]),
			boundary_union("std_channel__RecvAttempt", ["T"]),
			runtime_option_union(),
			runtime_result_union(),
			boundary_union("Container__mono_Int", []),
			ValueRecordDecl({
				name = "Box",
				type_params = ["T"],
				fields = [],
				loc = SyntheticSourceLoc,
			}),
			HeapRecordDecl({
				name = "Node",
				type_params = ["T"],
				fields = [],
				loc = SyntheticSourceLoc,
			}),
			TypeAliasDecl({
				name = "Alias",
				type_params = ["T"],
				target = t,
				is_opaque = False,
				loc = SyntheticSourceLoc,
			}),
			TraitDecl({
				name = "Display",
				type_params = [],
				supertraits = [],
				methods = [],
				loc = SyntheticSourceLoc,
			}),
			ImplDecl({
				trait_name = "GenericDisplay",
				for_type = t,
				type_params = [
					{
						name = "T",
						bounds = []
					},
				],
				methods = [],
				loc = SyntheticSourceLoc,
			}),
			ImplDecl({
				trait_name = "UnresolvedDisplay",
				for_type = t,
				type_params = [],
				methods = [],
				loc = SyntheticSourceLoc,
			}),
			ImplDecl({
				trait_name = "GenericMethodDisplay",
				for_type = NamedType("Int", []),
				type_params = [],
				methods = [boundary_function("display", ["T"], True)],
				loc = SyntheticSourceLoc,
			}),
			ImplDecl({
				trait_name = "Display",
				for_type = NamedType("Int", []),
				type_params = [],
				methods = [],
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = ["runtime.h"]
	}

	match project_semantic_middle_program(source):
		Ok(projected):
			(
				projected.decls.map(
					boundary_decl_name,
				) == [
					"function:main",
					"function:deferred",
					"union:Option",
					"union:Result",
					"union:Container__mono_Int",
					"alias:Alias",
					"trait:Display",
					"impl:Display",
				]
				and projected.foreign_includes == ["runtime.h"]
			)
		Err(_):
			False


pure func test_rejects_malformed_runtime_abi_templates() -> Bool:
	source: CoreProgram = {
		decls = [
			UnionDecl({
				name = "Option",
				type_params = ["T"],
				payload_storage = ErasedUnionPayloadStorage,
				variants = [
					abi_union_variant("Some", 1, Some("T")),
					abi_union_variant("None", 0, None),
				],
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}

	match project_semantic_middle_program(source):
		Err(SemanticMiddleMalformedRuntimeAbiUnion("Option")):
			True
		_:
			False


pure func field_string_is(value: JsonValue, name: String, expected: String) -> Bool:
	match get_field(value, name):
		Some(field):
			match as_string(field):
				Some(text):
					text == expected
				None:
					False
		None:
			False


pure func field_bool_is(value: JsonValue, name: String, expected: Bool) -> Bool:
	match get_field(value, name):
		Some(field):
			match as_bool(field):
				Some(flag):
					flag == expected
				None:
					False
		None:
			False


pure func field_number_is(value: JsonValue, name: String, expected: Int) -> Bool:
	match get_field(value, name):
		Some(field):
			match as_number(field):
				Some(number):
					to_int(number) == expected
				None:
					False
		None:
			False


pure func field_array_length_is(value: JsonValue, name: String, expected: Int) -> Bool:
	match get_field(value, name):
		Some(field):
			match as_array(field):
				Some(items):
					items.length() == expected
				None:
					False
		None:
			False


pure func test_stage_names_round_trip() -> Bool:
	stages = [StdInlineMiddleStage, TailrecMiddleStage, FusionMiddleStage]

	stages.all(
		func(stage): parse_semantic_middle_stage(semantic_middle_stage_name(stage)) == Some(stage),
	)


pure func test_capability_names_round_trip() -> Bool:
	capabilities = [
		PostResolveCoreCapability,
		PreDceCoreCapability,
		RenderedStageObservationsCapability,
	]

	capabilities.all(
		func(
			capability,
		): parse_semantic_middle_capability(
			semantic_middle_capability_name(capability),
		) == Some(capability),
	)


pure func test_request_json_is_phase_specific() -> Bool:
	value = semantic_middle_request_to_json(sample_request())

	(
		field_number_is(value, "schema", SEMANTIC_MIDDLE_SCHEMA_VERSION)
		and field_string_is(value, "domain", SEMANTIC_MIDDLE_DOMAIN)
		and field_string_is(value, "kind", "compile_pre_dce")
		and field_string_is(value, "core_phase", "post_resolve")
		and field_string_is(value, "target_path", "src/main.brp")
		and field_string_is(value, "target_module", "main")
		and field_number_is(value, "next_def_id", 42)
		and get_field(value, "debug").is_none()
		and field_bool_is(value, "require_main", True)
		and field_bool_is(value, "check_invariants", True)
		and field_array_length_is(value, "required_capabilities", 3)
		and field_array_length_is(value, "observations", 2)
		and field_string_is(value, "stop_after", "std_inline")
		and get_field(value, "import_bindings").is_none()
		and get_field(value, "module_imports").is_none()
		and get_field(value, "args").is_none()
		and get_field(value, "source_text").is_none()
	)


pure func compiled_response_value_with_core(core: JsonValue) -> JsonValue:
	JsonObject([
		("schema", JsonNumber(to_float(SEMANTIC_MIDDLE_SCHEMA_VERSION))),
		("domain", JsonString(SEMANTIC_MIDDLE_DOMAIN)),
		("kind", JsonString("compiled")),
		("capabilities", JsonVector([
			JsonString("core_post_resolve"),
			JsonString("core_pre_dce"),
			JsonString("rendered_stage_observations"),
		])),
		("core", core),
		("observations", JsonVector([JsonObject([
				("stage", JsonString("std_inline")),
				("rendered", JsonString("func main")),
			])])),
	])


pure func compiled_response_value() -> JsonValue:
	compiled_response_value_with_core(JsonObject([
		("kind", JsonString("program")),
		("decls", JsonVector([])),
		("foreign_includes", JsonVector([])),
	]))


pure func test_decode_compiled_response() -> Bool:
	match decode_semantic_middle_response_value(compiled_response_value()):
		Ok(SemanticMiddleCompiled(core, observations)):
			match observations.get(0):
				Some(observation):
					(
						core.decls.length() == 0
						and core.foreign_includes.length() == 0
						and observation.stage == StdInlineMiddleStage
						and observation.rendered == "func main"
					)
				None:
					False
		Ok(_):
			False
		Err(_):
			False


pure func test_rejects_malformed_core_response() -> Bool:
	malformed = compiled_response_value_with_core(
		JsonObject([("kind", JsonString("not_a_program"))]),
	)

	match decode_semantic_middle_response_value(malformed):
		Err(SemanticMiddleInvalidCore(_)):
			True
		_:
			False


pure func test_decode_stopped_response() -> Bool:
	value = JsonObject([
		("schema", JsonNumber(to_float(SEMANTIC_MIDDLE_SCHEMA_VERSION))),
		("domain", JsonString(SEMANTIC_MIDDLE_DOMAIN)),
		("kind", JsonString("stopped")),
		("capabilities", JsonVector([
			JsonString("core_post_resolve"),
			JsonString("core_pre_dce"),
			JsonString("rendered_stage_observations"),
		])),
		("stage", JsonString("tailrec")),
		("rendered", JsonString("trait-resolve snapshot")),
		("observations", JsonVector([])),
	])

	match decode_semantic_middle_response_value(value):
		Ok(SemanticMiddleStopped(stage, rendered, observations)):
			(
				stage == TailrecMiddleStage
				and rendered == "trait-resolve snapshot"
				and observations.length() == 0
			)
		Ok(_):
			False
		Err(_):
			False


pure func test_decode_failed_response() -> Bool:
	value = JsonObject([
		("schema", JsonNumber(to_float(SEMANTIC_MIDDLE_SCHEMA_VERSION))),
		("domain", JsonString(SEMANTIC_MIDDLE_DOMAIN)),
		("kind", JsonString("failed")),
		("capabilities", JsonVector([
			JsonString("core_post_resolve"),
			JsonString("core_pre_dce"),
			JsonString("rendered_stage_observations"),
		])),
		("diagnostics", JsonVector([JsonObject([
				("code", JsonString("core_lower")),
				("message", JsonString("unsupported typed expression")),
				("path", JsonString("src/main.brp")),
				("line", JsonNumber(3.0)),
				("column", JsonNumber(5.0)),
				("help", JsonNull),
			])])),
	])

	match decode_semantic_middle_response_value(value):
		Ok(SemanticMiddleFailed(diagnostics)):
			match diagnostics.get(0):
				Some(diagnostic):
					(
						diagnostic.code == "core_lower"
						and diagnostic.message == "unsupported typed expression"
						and diagnostic.path == Some("src/main.brp")
						and diagnostic.line == 3
						and diagnostic.column == 5
						and diagnostic.help.is_none()
					)
				None:
					False
		Ok(_):
			False
		Err(_):
			False


pure func test_rejects_wrong_schema_domain_and_stage() -> Bool:
	wrong_schema = JsonObject([
		("schema", JsonNumber(99.0)),
		("domain", JsonString(SEMANTIC_MIDDLE_DOMAIN)),
		("kind", JsonString("compiled")),
		("capabilities", JsonVector([])),
		("core", JsonObject([])),
		("observations", JsonVector([])),
	])
	wrong_domain = JsonObject([
		("schema", JsonNumber(to_float(SEMANTIC_MIDDLE_SCHEMA_VERSION))),
		("domain", JsonString("compiler_cli")),
		("kind", JsonString("compiled")),
		("capabilities", JsonVector([])),
		("core", JsonObject([])),
		("observations", JsonVector([])),
	])
	wrong_stage = JsonObject([
		("schema", JsonNumber(to_float(SEMANTIC_MIDDLE_SCHEMA_VERSION))),
		("domain", JsonString(SEMANTIC_MIDDLE_DOMAIN)),
		("kind", JsonString("stopped")),
		("capabilities", JsonVector([])),
		("stage", JsonString("dce")),
		("rendered", JsonString("unsupported")),
		("observations", JsonVector([])),
	])
	missing_capability = JsonObject([
		("schema", JsonNumber(to_float(SEMANTIC_MIDDLE_SCHEMA_VERSION))),
		("domain", JsonString(SEMANTIC_MIDDLE_DOMAIN)),
		("kind", JsonString("compiled")),
		("capabilities", JsonVector([
			JsonString("core_post_resolve"),
			JsonString("core_pre_dce"),
		])),
		("core", JsonObject([])),
		("observations", JsonVector([])),
	])
	unknown_capability = JsonObject([
		("schema", JsonNumber(to_float(SEMANTIC_MIDDLE_SCHEMA_VERSION))),
		("domain", JsonString(SEMANTIC_MIDDLE_DOMAIN)),
		("kind", JsonString("compiled")),
		("capabilities", JsonVector([
			JsonString("core_post_resolve"),
			JsonString("core_pre_dce"),
			JsonString("source_loading"),
		])),
		("core", JsonObject([])),
		("observations", JsonVector([])),
	])

	(
		decode_semantic_middle_response_value(wrong_schema).is_err()
		and decode_semantic_middle_response_value(wrong_domain).is_err()
		and decode_semantic_middle_response_value(wrong_stage).is_err()
		and decode_semantic_middle_response_value(missing_capability).is_err()
		and decode_semantic_middle_response_value(unknown_capability).is_err()
	)


tests: TestSuite = {
	description = "Blorp semantic-middle worker protocol",
	tests = [
		("stage names round trip", test_stage_names_round_trip),
		("capability names round trip", test_capability_names_round_trip),
		(
			"projects only semantic-middle runtime declarations",
			test_projects_only_semantic_middle_runtime_declarations,
		),
		("rejects malformed runtime ABI templates", test_rejects_malformed_runtime_abi_templates),
		("request JSON is phase specific", test_request_json_is_phase_specific),
		("decode compiled response", test_decode_compiled_response),
		("reject malformed Core response", test_rejects_malformed_core_response),
		("decode stopped response", test_decode_stopped_response),
		("decode failed response", test_decode_failed_response),
		("reject wrong schema domain and stage", test_rejects_wrong_schema_domain_and_stage),
	]
}
