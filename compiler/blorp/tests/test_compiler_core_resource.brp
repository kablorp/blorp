import:
	../compiler_core_json:
		CoreCallKind(UserCall),
		CoreExpr(
			BreakExpr,
			CallExpr,
			ContinueExpr,
			LiteralExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			VarExpr,
			WhileExpr,
		),
		CoreLiteral(BoolLiteral),
		CoreResourceExit(ResourceBreakExit, ResourceContinueExit),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
		CoreVar,
		core_expr_to_json,
	../compiler_core_resource: rewrite_resource_expr
	test: TestSuite


pure func resource_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func resource_func_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 1,
		def_id = None
	}


pure func test_resource_type() -> CoreType:
	NamedType("TestResource", [])


pure func closure_type() -> CoreType:
	NamedType("Closure", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func resource_open(name: String) -> CoreExpr:
	VarExpr(resource_func_var("open_" + name), test_resource_type(), SyntheticSourceLoc)


pure func cleanup_call(name: String) -> CoreExpr:
	CallExpr(
		UserCall("close_" + name, None),
		VarExpr(resource_func_var("close_" + name), closure_type(), SyntheticSourceLoc),
		[VarExpr(resource_var(name), test_resource_type(), SyntheticSourceLoc)],
		VoidType,
		SyntheticSourceLoc,
	)


pure func resource_scope(name: String, body: CoreExpr) -> CoreExpr:
	ResourceScopeExpr(
		{
			variable = resource_var(name),
			typ = test_resource_type(),
			acquire = resource_open(name),
			body = body,
			cleanup = cleanup_call(name)
		},
		VoidType,
		SyntheticSourceLoc,
	)


pure func bool_literal(value: Bool) -> CoreExpr:
	LiteralExpr(BoolLiteral(value), bool_type(), SyntheticSourceLoc)


pure func cleanup_exit_break(cleanups: List[CoreExpr]) -> CoreExpr:
	ResourceCleanupExitExpr(
		{
			cleanups = cleanups,
			exit = ResourceBreakExit
		},
		VoidType,
		SyntheticSourceLoc,
	)


pure func cleanup_exit_continue(cleanups: List[CoreExpr]) -> CoreExpr:
	ResourceCleanupExitExpr(
		{
			cleanups = cleanups,
			exit = ResourceContinueExit
		},
		VoidType,
		SyntheticSourceLoc,
	)


pure func core_exprs_equal(left: CoreExpr, right: CoreExpr) -> Bool:
	core_expr_to_json(left).to_string() == core_expr_to_json(right).to_string()


pure func test_rewrites_direct_break_to_cleanup_exit() -> Bool:
	core_exprs_equal(
		rewrite_resource_expr(resource_scope("handle", BreakExpr(VoidType, SyntheticSourceLoc))),
		resource_scope("handle", cleanup_exit_break([cleanup_call("handle")])),
	)


pure func test_nested_loop_local_break_stays_plain_break() -> Bool:
	loop: CoreExpr = WhileExpr(
		bool_literal(True),
		BreakExpr(VoidType, SyntheticSourceLoc),
		VoidType,
		SyntheticSourceLoc,
	)

	core_exprs_equal(
		rewrite_resource_expr(resource_scope("handle", loop)),
		resource_scope("handle", loop),
	)


pure func test_nested_resources_cleanup_in_reverse_order() -> Bool:
	rewritten: CoreExpr = rewrite_resource_expr(
		resource_scope(
			"outer",
			resource_scope(
				"inner",
				ContinueExpr(VoidType, SyntheticSourceLoc),
			),
		),
	)
	expected: CoreExpr = resource_scope(
		"outer",
		resource_scope(
			"inner",
			cleanup_exit_continue([cleanup_call("inner"), cleanup_call("outer")]),
		),
	)

	core_exprs_equal(rewritten, expected)


tests: TestSuite = {
	description = "Blorp compiler Core resource",
	tests = [
		("rewrites direct break to cleanup exit", test_rewrites_direct_break_to_cleanup_exit),
		(
			"nested loop local break stays plain break",
			test_nested_loop_local_break_stays_plain_break,
		),
		(
			"nested resources clean up in reverse order",
			test_nested_resources_cleanup_in_reverse_order,
		),
	]
}
