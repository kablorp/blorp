import:
	../core_profile_format:
		CoreProfileRenderError(UnsupportedCoreProfileOp, WrongArity),
		core_profile_template_arity,
		core_profile_template_name,
		parse_core_profile_template,
		render_core_profile,
		render_error_to_string,
	test: TestSuite


pure func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_core_profile_template(name):
		Some(info):
			(
				core_profile_template_name(info) == expected_name
				and core_profile_template_arity(info) == expected_arity
			)
		None:
			False


pure func rendered_profile_is(name: String, args: List[String], expected: String) -> Bool:
	match render_core_profile(name, args):
		Ok(rendered):
			rendered == expected
		Err(error):
			False


pure func core_only_rows() -> String:
	"core\tlower\t1.5\ncore\tmono\t3.0"


pure func frontend_rows() -> String:
	"label\tparse\t1.0\nlabel\tmodule_load\t2.0\nlabel\tmodule_typecheck\t2.5\ncore\tlower\t3.0"


pure func expected_core_only_table() -> String:
	"phase      ms      %\n" + "--------------------\n" + "lower*    1.5   33.3\n" + "mono      3.0   66.7\n" + "--------------------\n" + "total     4.5  100.0\n" + "* first entry includes work before the first stage callback\n"


pure func expected_frontend_table() -> String:
	"phase                ms      %\n" + "------------------------------\n" + "parse               1.0   11.8\n" + "module_load         2.0   23.5\n" + "module_typecheck    2.5   29.4\n" + "lower               3.0   35.3\n" + "------------------------------\n" + "total               8.5  100.0\n"


pure func test_parse_template_shapes() -> Bool:
	parsed_template_has("core_profile_format", "core_profile_format", 1)


pure func test_render_profile_tables() -> Bool:
	core_only_ok: Bool = rendered_profile_is(
		"core_profile_format",
		[core_only_rows()],
		expected_core_only_table(),
	)
	frontend_ok: Bool = rendered_profile_is(
		"core_profile_format",
		[frontend_rows()],
		expected_frontend_table(),
	)
	empty_ok: Bool = rendered_profile_is(
		"core_profile_format",
		[""],
		"phase     ms      %\n-------------------\n-------------------\ntotal    0.0  100.0\n",
	)

	core_only_ok and frontend_ok and empty_ok


pure func test_render_errors_are_typed() -> Bool:
	wrong_arity_ok: Bool = match render_core_profile("core_profile_format", []):
		Err(WrongArity(info, actual)):
			(
				core_profile_template_name(info) == "core_profile_format"
				and core_profile_template_arity(info) == 1
				and actual == 0
			)
		Ok(value):
			False
		Err(UnsupportedCoreProfileOp(name)):
			False

	unsupported_ok: Bool = match render_core_profile("core_profile_missing", []):
		Err(UnsupportedCoreProfileOp(name)):
			name == "core_profile_missing"
		Ok(value):
			False
		Err(WrongArity(info, actual)):
			False

	wrong_arity_ok and unsupported_ok


pure func test_error_text() -> Bool:
	arity_text: String = match render_core_profile("core_profile_format", []):
		Err(error):
			render_error_to_string(error)
		Ok(value):
			value

	unsupported_text: String = render_error_to_string(
		UnsupportedCoreProfileOp("core_profile_missing"),
	)

	(
		arity_text == "core profile op core_profile_format expected 1 arg(s), got 0"
		and unsupported_text == "unsupported core profile op: core_profile_missing"
	)


tests: TestSuite = {
	description = "Self-hosted Core profile format",
	tests = [
		("parse template shapes", test_parse_template_shapes),
		("render profile tables", test_render_profile_tables),
		("render errors are typed", test_render_errors_are_typed),
		("error text", test_error_text),
	]
}
