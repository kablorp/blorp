import:
	../core_error_format:
		CoreErrorRenderError(InvalidHintKind, InvalidIntField, UnsupportedCoreErrorOp, WrongArity),
		core_error_template_arity,
		core_error_template_name,
		parse_core_error_template,
		render_core_error,
		render_error_to_string,
	test: TestSuite


pure func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_core_error_template(name):
		Some(info):
			(
				core_error_template_name(info) == expected_name
				and core_error_template_arity(info) == expected_arity
			)
		None:
			False


pure func rendered_error_is(name: String, args: List[String], expected: String) -> Bool:
	match render_core_error(name, args):
		Ok(rendered):
			rendered == expected
		Err(error):
			False


pure func test_parse_template_shapes() -> Bool:
	parsed_template_has("core_error_format", "core_error_format", 6)


pure func test_render_error_values() -> Bool:
	no_hint_ok: Bool = rendered_error_is(
		"core_error_format",
		["mono", "something broke", "7", "3", "none", ""],
		"mono: something broke at 7:3",
	)
	hint_ok: Bool = rendered_error_is(
		"core_error_format",
		["lower", "expression missing type", "12", "8", "some", "run Infer.infer first"],
		"lower: expression missing type at 12:8\n  hint: run Infer.infer first",
	)

	no_hint_ok and hint_ok


pure func test_render_errors_are_typed() -> Bool:
	wrong_arity_ok: Bool = match render_core_error("core_error_format", ["mono"]):
		Err(WrongArity(info, actual)):
			(
				core_error_template_name(info) == "core_error_format"
				and core_error_template_arity(info) == 6
				and actual == 1
			)
		Ok(value):
			False
		Err(UnsupportedCoreErrorOp(name)):
			False
		Err(InvalidHintKind(kind)):
			False
		Err(InvalidIntField(field_name, value)):
			False

	unsupported_ok: Bool = match render_core_error("core_error_missing", []):
		Err(UnsupportedCoreErrorOp(name)):
			name == "core_error_missing"
		Ok(value):
			False
		Err(WrongArity(info, actual)):
			False
		Err(InvalidHintKind(kind)):
			False
		Err(InvalidIntField(field_name, value)):
			False

	invalid_hint_ok: Bool = match render_core_error(
		"core_error_format",
		["mono", "message", "7", "3", "maybe", ""],
	):
		Err(InvalidHintKind(kind)):
			kind == "maybe"
		Ok(value):
			False
		Err(WrongArity(info, actual)):
			False
		Err(UnsupportedCoreErrorOp(name)):
			False
		Err(InvalidIntField(field_name, value)):
			False

	invalid_int_ok: Bool = match render_core_error(
		"core_error_format",
		["mono", "message", "line", "3", "none", ""],
	):
		Err(InvalidIntField(field_name, value)):
			field_name == "line" and value == "line"
		Ok(value):
			False
		Err(WrongArity(info, actual)):
			False
		Err(UnsupportedCoreErrorOp(name)):
			False
		Err(InvalidHintKind(kind)):
			False

	wrong_arity_ok and unsupported_ok and invalid_hint_ok and invalid_int_ok


pure func test_error_text() -> Bool:
	arity_text: String = match render_core_error("core_error_format", ["mono"]):
		Err(error):
			render_error_to_string(error)
		Ok(value):
			value

	unsupported_text: String = render_error_to_string(UnsupportedCoreErrorOp("core_error_missing"))
	invalid_hint_text: String = render_error_to_string(InvalidHintKind("maybe"))
	invalid_int_text: String = render_error_to_string(InvalidIntField("line", "bad"))

	(
		arity_text == "core error op core_error_format expected 6 arg(s), got 1"
		and unsupported_text == "unsupported core error op: core_error_missing"
		and invalid_hint_text == "invalid core error hint kind: maybe"
		and invalid_int_text == "invalid core error line: bad"
	)


tests: TestSuite = {
	description = "Self-hosted Core error format",
	tests = [
		("parse template shapes", test_parse_template_shapes),
		("render error values", test_render_error_values),
		("render errors are typed", test_render_errors_are_typed),
		("error text", test_error_text),
	]
}
