import:
	../src/stage_09_core/compiler_core_consume_specialize: rewrite_program
	../src/stage_09_core/compiler_core_json:
		CoreAccessor(RootAccessor, VariantFieldAccessor),
		CoreCallKind(UserCall),
		CoreConstructorMatchBody(ConstructorMatchBodyExpr),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(ConstructorMatchFallbackFail),
		CoreConstructorMatchTest(UnionTagConstructorTest),
		CoreDecl(FunctionDecl, UnionDecl),
		CoreExpr(
			AssignExpr,
			CallExpr,
			ConstructorMatchExpr,
			DropExpr,
			IfExpr,
			LetExpr,
			LiteralExpr,
			SeqExpr,
			VarExpr,
		),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreLiteral(BoolLiteral, IntLiteral),
		CoreMatchBinding,
		CoreMatchBindingMode(MatchBorrowBindingMode, MatchOwnBindingMode),
		CoreParam,
		CoreProgram,
		CoreReleasePolicy(ArcReleasePolicy, NoReleasePolicy),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, UnionType, VoidType),
		CoreUnionDecl,
		CoreUnionField,
		CoreUnionPayloadStorage(ErasedUnionPayloadStorage),
		CoreUnionVariant,
		CoreVar,
	test: TestSuite


pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func function_var(name: String, def_id: Int) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = Some(def_id)
	}


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func expr_type() -> CoreType:
	UnionType("Expr")


pure func closure_type() -> CoreType:
	NamedType("Closure", [])


pure func param(name: String, typ: CoreType) -> CoreParam:
	{
		name = named_var(name),
		typ = typ,
		loc = SyntheticSourceLoc
	}


pure func int_expr(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), int_type(), SyntheticSourceLoc)


pure func bool_expr(value: Bool) -> CoreExpr:
	LiteralExpr(BoolLiteral(value), bool_type(), SyntheticSourceLoc)


pure func var_expr(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(named_var(name), typ, SyntheticSourceLoc)


pure func callee_expr(name: String, def_id: Int) -> CoreExpr:
	VarExpr(
		function_var(name, def_id),
		closure_type(),
		SyntheticSourceLoc,
	)


pure func user_call(
	name: String,
	def_id: Int,
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(
		UserCall(name, Some(def_id), []),
		callee_expr(name, def_id),
		args,
		return_type,
		SyntheticSourceLoc,
	)


pure func lit_expr(value: Int) -> CoreExpr:
	user_call("Lit", 100, [int_expr(value)], expr_type())


pure func add_expr(left: CoreExpr, right: CoreExpr) -> CoreExpr:
	user_call(
		"Add",
		101,
		[left, right],
		expr_type(),
	)


pure func expr_union_field() -> CoreUnionField:
	{
		typ = expr_type(),
		release_policy = NoReleasePolicy
	}


pure func expr_union_variant(
	name: String,
	tag: Int,
	def_id: Int,
	fields: List[CoreUnionField],
) -> CoreUnionVariant:
	{
		name = name,
		c_name = name,
		tag_c_name = "TAG_Expr_${name}",
		tag = tag,
		fields = fields,
		def_id = Some(def_id)
	}


pure func expr_union_decl() -> CoreUnionDecl:
	{
		name = "Expr",
		payload_storage = ErasedUnionPayloadStorage,
		variants = [
			expr_union_variant(
				"Lit",
				0,
				100,
				[
					{
						typ = int_type(),
						release_policy = NoReleasePolicy
					},
				],
			),
			expr_union_variant(
				"Add",
				1,
				101,
				[expr_union_field(), expr_union_field()],
			),
		],
		loc = SyntheticSourceLoc
	}


pure func rewrite_function(body: CoreExpr) -> CoreFunction:
	{
		name = "rewrite_expr",
		source_module = None,
		type_params = [],
		params = [param("expr", expr_type()), param("pass", int_type())],
		return_type = expr_type(),
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 10,
		loc = SyntheticSourceLoc
	}


pure func assignment_expr() -> CoreExpr:
	AssignExpr(
		named_var("expr"),
		user_call(
			"rewrite_expr",
			10,
			[var_expr("expr", expr_type()), int_expr(1)],
			expr_type(),
		),
		VoidType,
		SyntheticSourceLoc,
	)


pure func run_function() -> CoreFunction:
	{
		name = "run",
		source_module = None,
		type_params = [],
		params = [],
		return_type = expr_type(),
		body = Some(
			LetExpr(
				named_var("expr"),
				True,
				expr_type(),
				lit_expr(0),
				SeqExpr(
					assignment_expr(),
					var_expr("expr", expr_type()),
				),
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 20,
		loc = SyntheticSourceLoc
	}


pure func program(rewrite_body: CoreExpr) -> CoreProgram:
	{
		decls = [
			UnionDecl(expr_union_decl()),
			FunctionDecl(rewrite_function(rewrite_body)),
			FunctionDecl(run_function()),
		],
		foreign_includes = []
	}


pure func rewritten_program(rewrite_body: CoreExpr) -> CoreProgram:
	rewrite_program(program(rewrite_body))


pure func function_names_are(program_value: CoreProgram, expected: List[String]) -> Bool:
	var index: Int = 0
	var matches: Bool = True

	for decl in program_value.decls:
		match decl:
			FunctionDecl(func_info):
				match expected.get(index):
					Some(expected_name):
						if func_info.name != expected_name:
							matches = False
							break
						else:
							void
					None:
						matches = False
						break

				index += 1
			UnionDecl(union_decl):
				void
			_:
				void

	matches and index == expected.length()


record CloneBodySummary {
	owned_names: List[String],
	rewrite_calls: List[String]
}


pure func clone_body_summary(program_value: CoreProgram, name: String) -> Option[CloneBodySummary]:
	var found: Option[CloneBodySummary] = None

	for decl in program_value.decls:
		match decl:
			FunctionDecl(func_info):
				if func_info.name == name:
					match func_info.body:
						Some(LetExpr(result_var, is_mutable, result_type, bind_rhs, body)):
							found = Some({
								owned_names = owned_binding_names(bind_rhs),
								rewrite_calls = rewrite_call_names(bind_rhs),
							})
						_:
							void
				else:
					void
			_:
				void

	found


pure func assignment_call_name_matches_in_expr(expr: CoreExpr, expected: String) -> Option[Bool]:
	match expr:
		AssignExpr(variable, rhs, typ, loc):
			match rhs:
				CallExpr(UserCall(name, def_id, consumed_args), callee, args, call_type, call_loc):
					Some(name == expected)
				_:
					None
		LetExpr(variable, is_mutable, typ, rhs, body):
			match assignment_call_name_matches_in_expr(rhs, expected):
				Some(matches):
					Some(matches)
				None:
					assignment_call_name_matches_in_expr(body, expected)
		SeqExpr(first, second):
			match assignment_call_name_matches_in_expr(first, expected):
				Some(matches):
					Some(matches)
				None:
					assignment_call_name_matches_in_expr(second, expected)
		_:
			None


pure func assignment_call_name_matches(program_value: CoreProgram, expected: String) -> Bool:
	var found: Option[Bool] = None

	for decl in program_value.decls:
		match decl:
			FunctionDecl(func_info):
				if func_info.name == "run":
					match func_info.body:
						Some(body):
							found = assignment_call_name_matches_in_expr(body, expected)
						None:
							void
				else:
					void
			_:
				void

	found.get_or(False)


pure func clone_drops_consumed_param(program_value: CoreProgram, name: String) -> Bool:
	var found: Bool = False

	for decl in program_value.decls:
		match decl:
			FunctionDecl(func_info):
				if func_info.name == name:
					match func_info.body:
						Some(LetExpr(result_var, is_mutable, result_type, bind_rhs, DropExpr(drop_var, drop_type, release_policy, body, typ, loc))):
							body_returns_result: Bool = match body:
								VarExpr(returned, return_type, return_loc):
									returned.name == "__consume_result_expr"
								_:
									False

							found = (
								drop_var.name == "expr"
								and result_var.name == "__consume_result_expr"
								and release_policy == ArcReleasePolicy
								and body_returns_result
							)
						_:
							void
				else:
					void
			_:
				void

	found


pure func add_field_binding(
	name: String,
	field_index: Int,
	mode: CoreMatchBindingMode,
) -> CoreMatchBinding:
	{
		variable = named_var(name),
		typ = expr_type(),
		accessor = VariantFieldAccessor(RootAccessor, "Expr", "Add", field_index),
		mode = mode
	}


pure func add_match_case(body: CoreExpr) -> CoreConstructorMatchCase:
	{
		constructor = "Add",
		accessor = RootAccessor,
		test = UnionTagConstructorTest("TAG_Expr_Add", "Expr"),
		bindings = [
			add_field_binding("left", 0, MatchBorrowBindingMode),
			add_field_binding("right", 1, MatchBorrowBindingMode),
		],
		body = ConstructorMatchBodyExpr(body)
	}


pure func recursive_rewrite_body() -> CoreExpr:
	left: CoreExpr = var_expr("left", expr_type())
	right: CoreExpr = var_expr("right", expr_type())
	recursive_left: CoreExpr = user_call(
		"rewrite_expr",
		10,
		[left, var_expr("pass", int_type())],
		expr_type(),
	)
	recursive_right: CoreExpr = user_call(
		"rewrite_expr",
		10,
		[right, var_expr("pass", int_type())],
		expr_type(),
	)

	ConstructorMatchExpr(
		var_expr("expr", expr_type()),
		NoReleasePolicy,
		[add_match_case(add_expr(recursive_left, recursive_right))],
		ConstructorMatchFallbackFail,
		expr_type(),
		SyntheticSourceLoc,
	)


pure func recursive_one_sided_rewrite_body() -> CoreExpr:
	left: CoreExpr = var_expr("left", expr_type())
	recursive_left: CoreExpr = user_call(
		"rewrite_expr",
		10,
		[left, var_expr("pass", int_type())],
		expr_type(),
	)

	ConstructorMatchExpr(
		var_expr("expr", expr_type()),
		NoReleasePolicy,
		[
			add_match_case(
				IfExpr(
					bool_expr(True),
					add_expr(recursive_left, lit_expr(1)),
					lit_expr(2),
					expr_type(),
					SyntheticSourceLoc,
				),
			),
		],
		ConstructorMatchFallbackFail,
		expr_type(),
		SyntheticSourceLoc,
	)


pure func owned_binding_names_in_case(match_case: CoreConstructorMatchCase) -> List[String]:
	var names: List[String] = []

	for binding in match_case.bindings:
		match binding.mode:
			MatchOwnBindingMode:
				names = names.append(binding.variable.name)
			MatchBorrowBindingMode:
				void

	names


pure func owned_binding_names(expr: CoreExpr) -> List[String]:
	match expr:
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			var names: List[String] = []

			for match_case in cases:
				for name in owned_binding_names_in_case(match_case):
					names = names.append(name)

			names
		_:
			[]


pure func rewrite_call_names(expr: CoreExpr) -> List[String]:
	match expr:
		CallExpr(UserCall(name, def_id, consumed_args), callee, args, typ, loc):
			var names: List[String] = []

			if name.starts_with("rewrite_expr"):
				names = names.append(name)
			else:
				void

			for arg in args:
				for child_name in rewrite_call_names(arg):
					names = names.append(child_name)

			names
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			var names: List[String] = rewrite_call_names(scrutinee)

			for match_case in cases:
				match match_case.body:
					ConstructorMatchBodyExpr(body):
						for child_name in rewrite_call_names(body):
							names = names.append(child_name)
					_:
						void

			names
		IfExpr(cond, then_expr, else_expr, typ, loc):
			rewrite_call_names(cond) + rewrite_call_names(then_expr) + rewrite_call_names(else_expr)
		_:
			[]


pure func test_rewrites_safe_self_replacement_call() -> Bool:
	rewritten: CoreProgram = rewritten_program(lit_expr(7))
	has_functions: Bool = function_names_are(
		rewritten,
		["rewrite_expr", "rewrite_expr__consume_arg0", "run"],
	)
	retargeted_assignment: Bool = assignment_call_name_matches(
		rewritten,
		"rewrite_expr__consume_arg0",
	)
	clone_drops_param: Bool = clone_drops_consumed_param(rewritten, "rewrite_expr__consume_arg0")

	has_functions and retargeted_assignment and clone_drops_param


pure func test_does_not_clone_when_result_is_consumed_param() -> Bool:
	rewritten: CoreProgram = rewritten_program(var_expr("expr", expr_type()))
	has_functions: Bool = function_names_are(
		rewritten,
		["rewrite_expr", "run"],
	)
	keeps_original_assignment: Bool = assignment_call_name_matches(rewritten, "rewrite_expr")

	has_functions and keeps_original_assignment


pure func test_does_not_clone_when_result_contains_consumed_param() -> Bool:
	rewritten: CoreProgram = rewritten_program(add_expr(var_expr("expr", expr_type()), lit_expr(1)))
	has_functions: Bool = function_names_are(
		rewritten,
		["rewrite_expr", "run"],
	)
	keeps_original_assignment: Bool = assignment_call_name_matches(rewritten, "rewrite_expr")

	has_functions and keeps_original_assignment


pure func test_consuming_clone_owns_recursive_match_fields() -> Bool:
	rewritten: CoreProgram = rewritten_program(recursive_rewrite_body())

	match clone_body_summary(rewritten, "rewrite_expr__consume_arg0"):
		Some(summary):
			owns_fields: Bool = summary.owned_names == ["left", "right"]
			rewrites_recursive_calls: Bool = summary.rewrite_calls == [
				"rewrite_expr__consume_arg0",
				"rewrite_expr__consume_arg0",
			]
			owns_fields and rewrites_recursive_calls
		None:
			False


pure func test_consuming_clone_rejects_one_sided_recursive_field_use() -> Bool:
	rewritten: CoreProgram = rewritten_program(recursive_one_sided_rewrite_body())

	match clone_body_summary(rewritten, "rewrite_expr__consume_arg0"):
		Some(summary):
			expected_owned_names: List[String] = []
			keeps_borrowed_fields: Bool = summary.owned_names == expected_owned_names
			keeps_original_call: Bool = summary.rewrite_calls == ["rewrite_expr"]
			keeps_borrowed_fields and keeps_original_call
		None:
			False


tests: TestSuite = {
	description = "Blorp compiler Core consume specialize",
	tests = [
		("rewrites safe self-replacement call", test_rewrites_safe_self_replacement_call),
		(
			"does not clone when result is consumed param",
			test_does_not_clone_when_result_is_consumed_param,
		),
		(
			"does not clone when result contains consumed param",
			test_does_not_clone_when_result_contains_consumed_param,
		),
		(
			"consuming clone owns recursive match fields",
			test_consuming_clone_owns_recursive_match_fields,
		),
		(
			"consuming clone rejects one-sided recursive field use",
			test_consuming_clone_rejects_one_sided_recursive_field_use,
		),
	]
}
