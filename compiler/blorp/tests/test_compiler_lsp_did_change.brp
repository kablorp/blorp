import:
	../src/stage_12_lsp/did_change:
		decode_lsp_did_change_envelope,
		decode_lsp_did_change_notification,
		handle_lsp_did_change_notification,
	../src/stage_12_lsp/did_open: decode_lsp_did_open_notification, handle_lsp_did_open_notification
	../src/stage_12_lsp/document_model: DocumentChange, OpenedDocument, document_version_value
	../src/stage_12_lsp/document_store:
		DocumentStore,
		DocumentStoreError(DocumentNotOpen, DocumentVersionNotNewer),
		document_store,
		document_store_find,
	../src/stage_12_lsp/identity: document_uri_value
	../src/stage_12_lsp/json_rpc: decode_lsp_json_rpc_body, json_rpc_error_value
	../src/stage_12_lsp/protocol:
		ProtocolError(InvalidMethodParameters, MalformedJson, UnexpectedRequestId),
		ProtocolInputOutcome(ProtocolInputAccepted, ProtocolInputIgnored, ProtocolInputRejected),
		RequestId(StringRequestId),
	json: JsonValue, as_number, as_string, get_field
	test: TestSuite


private DOCUMENT_URI: String = "file:///workspace/main.brp"

private DID_OPEN_BODY: String =
	|{
	|  "jsonrpc": "2.0",
	|  "method": "textDocument/didOpen",
	|  "params": {
	|    "textDocument": {
	|      "uri": "file:///workspace/main.brp",
	|      "languageId": "blorp",
	|      "version": 12,
	|      "text": "original"
	|    }
	|  }
	|}

private DID_CHANGE_BODY: String =
	|{
	|  "jsonrpc": "2.0",
	|  "method": "textDocument/didChange",
	|  "params": {
	|    "textDocument": {
	|      "uri": "file:///workspace/main.brp",
	|      "version": 13
	|    },
	|    "contentChanges": [
	|      {"text": "func main(args: List[String]):\n\tprint(\"changed\")\n"}
	|    ]
	|  }
	|}

private DID_CHANGE_TEXT: String = "func main(args: List[String]):\n\tprint(\"changed\")\n"

private DID_CHANGE_MULTIPLE_BODY: String =
	|{
	|  "jsonrpc": "2.0",
	|  "method": "textDocument/didChange",
	|  "params": {
	|    "textDocument": {
	|      "uri": "file:///workspace/main.brp",
	|      "version": 15
	|    },
	|    "contentChanges": [
	|      {"text": "intermediate"},
	|      {"text": "final"}
	|    ]
	|  }
	|}

private DID_CHANGE_STALE_BODY: String =
	|{
	|  "jsonrpc": "2.0",
	|  "method": "textDocument/didChange",
	|  "params": {
	|    "textDocument": {
	|      "uri": "file:///workspace/main.brp",
	|      "version": 11
	|    },
	|    "contentChanges": [{"text": "stale"}]
	|  }
	|}

private DID_CHANGE_EMPTY_EVENTS_BODY: String =
	|{
	|  "jsonrpc": "2.0",
	|  "method": "textDocument/didChange",
	|  "params": {
	|    "textDocument": {
	|      "uri": "file:///workspace/main.brp",
	|      "version": 13
	|    },
	|    "contentChanges": []
	|  }
	|}

private DID_CHANGE_EMPTY_TEXT_BODY: String =
	|{
	|  "jsonrpc": "2.0",
	|  "method": "textDocument/didChange",
	|  "params": {
	|    "textDocument": {
	|      "uri": "file:///workspace/main.brp",
	|      "version": 13
	|    },
	|    "contentChanges": [{"text": ""}]
	|  }
	|}

private DID_CHANGE_VERSION_14_BODY: String =
	|{
	|  "jsonrpc": "2.0",
	|  "method": "textDocument/didChange",
	|  "params": {
	|    "textDocument": {
	|      "uri": "file:///workspace/main.brp",
	|      "version": 14
	|    },
	|    "contentChanges": [{"text": "version fourteen"}]
	|  }
	|}

private DID_OPEN_OTHER_BODY: String =
	|{
	|  "jsonrpc": "2.0",
	|  "method": "textDocument/didOpen",
	|  "params": {
	|    "textDocument": {
	|      "uri": "file:///workspace/other.brp",
	|      "languageId": "other-language",
	|      "version": 3,
	|      "text": "other text"
	|    }
	|  }
	|}


private pure func response_error_code(response: JsonValue) -> Option[Float]:
	error ?= get_field(response, "error")
	code ?= get_field(error, "code")
	code.as_number()


private pure func invalid_parameters_contain(body: String, expected: String) -> Bool:
	match decode_lsp_did_change_notification(body):
		ProtocolInputIgnored(InvalidMethodParameters(method, detail)):
			method == "textDocument/didChange" and detail.contains(expected)
		_:
			False


private pure func decode_change(body: String) -> Option[DocumentChange]:
	match decode_lsp_did_change_notification(body):
		ProtocolInputAccepted(changed):
			Some(changed)
		_:
			None


private pure func opened_store() -> Option[(DocumentStore, OpenedDocument)]:
	opened ?= match decode_lsp_did_open_notification(DID_OPEN_BODY):
		ProtocolInputAccepted(opened):
			Some(opened)
		_:
			None

	store ?= match handle_lsp_did_open_notification(document_store(), opened):
		Ok(store):
			Some(store)
		Err(_):
			None

	Some((store, opened))


private pure func apply_change_body(store: DocumentStore, body: String) -> Option[DocumentStore]:
	changed ?= decode_change(body)

	match handle_lsp_did_change_notification(store, changed):
		Ok(updated):
			Some(updated)
		Err(_):
			None


private pure func apply_change_bodies(
	store: DocumentStore,
	first_body: String,
	second_body: String,
) -> Option[DocumentStore]:
	first ?= apply_change_body(store, first_body)
	apply_change_body(first, second_body)


private pure func opened_store_with_other() -> Option[(DocumentStore, OpenedDocument)]:
	main ?= opened_store()
	main_store = main[0]

	other ?= match decode_lsp_did_open_notification(DID_OPEN_OTHER_BODY):
		ProtocolInputAccepted(opened):
			Some(opened)
		_:
			None

	both ?= match handle_lsp_did_open_notification(main_store, other):
		Ok(store):
			Some(store)
		Err(_):
			None

	Some((both, other))


func test_did_change_decodes_full_document_replacement() -> Bool:
	match decode_change(DID_CHANGE_BODY):
		Some(changed):
			(
				document_uri_value(changed.uri) == DOCUMENT_URI
				and document_version_value(changed.version) == 13
				and changed.replacement_text == Some(DID_CHANGE_TEXT)
			)
		None:
			False


func test_did_change_uses_last_full_replacement() -> Bool:
	match decode_change(DID_CHANGE_MULTIPLE_BODY):
		Some(changed):
			(
				document_version_value(changed.version) == 15
				and changed.replacement_text == Some("final")
			)
		None:
			False


func test_did_change_accepts_predecoded_envelope() -> Bool:
	match decode_lsp_json_rpc_body(DID_CHANGE_BODY):
		Err(_):
			False
		Ok(envelope):
			match decode_lsp_did_change_envelope(envelope):
				ProtocolInputAccepted(changed):
					changed.replacement_text == Some(DID_CHANGE_TEXT)
				_:
					False


func test_did_change_distinguishes_empty_events_from_empty_text() -> Bool:
	match (decode_change(DID_CHANGE_EMPTY_EVENTS_BODY), decode_change(DID_CHANGE_EMPTY_TEXT_BODY)):
		(Some(version_only), Some(clear_document)):
			version_only.replacement_text == None and clear_document.replacement_text == Some("")
		_:
			False


func test_did_change_accepts_document_version_boundaries() -> Bool:
	minimum_body: String =
		|{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///a.brp","version":-2147483648},"contentChanges":[]}}
	maximum_body: String =
		|{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///a.brp","version":2147483647},"contentChanges":[]}}

	match (decode_change(minimum_body), decode_change(maximum_body)):
		(Some(minimum), Some(maximum)):
			(
				document_version_value(minimum.version) == -2147483648
				and document_version_value(maximum.version) == 2147483647
			)
		_:
			False


func test_did_change_request_returns_invalid_request_error() -> Bool:
	body: String =
		|{
		|  "jsonrpc": "2.0",
		|  "id": "did-change-request",
		|  "method": "textDocument/didChange",
		|  "params": {
		|    "textDocument": {
		|      "uri": "file:///workspace/main.brp",
		|      "version": 13
		|    },
		|    "contentChanges": [{"text": "changed"}]
		|  }
		|}

	match decode_lsp_did_change_notification(body):
		ProtocolInputRejected(failure):
			error_ok: Bool = match failure.error:
				UnexpectedRequestId(method):
					method == "textDocument/didChange"
				_:
					False

			id_ok: Bool = match failure.request_id:
				Some(StringRequestId(id)):
					id == "did-change-request"
				_:
					False

			response = json_rpc_error_value(failure)

			response_id_ok: Bool = match get_field(response, "id"):
				Some(id):
					id.as_string() == Some("did-change-request")
				None:
					False

			(
				error_ok
				and id_ok
				and response_id_ok
				and response_error_code(response) == Some(-32600.0)
			)
		_:
			False


func test_did_change_ignores_invalid_notification_parameters() -> Bool:
	missing_params: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\"}",
		"params",
	)
	missing_document: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"contentChanges\":[{\"text\":\"x\"}]}}",
		"textDocument",
	)
	missing_uri: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"version\":2},\"contentChanges\":[{\"text\":\"x\"}]}}",
		"uri",
	)
	invalid_version: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.brp\",\"version\":2.5},\"contentChanges\":[{\"text\":\"x\"}]}}",
		"version",
	)
	missing_changes: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.brp\",\"version\":2}}}",
		"contentChanges",
	)
	non_object_document: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":false,\"contentChanges\":[{\"text\":\"x\"}]}}",
		"textDocument",
	)
	non_string_uri: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":false,\"version\":2},\"contentChanges\":[{\"text\":\"x\"}]}}",
		"uri",
	)
	missing_version: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.brp\"},\"contentChanges\":[{\"text\":\"x\"}]}}",
		"version",
	)
	overflow_version: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.brp\",\"version\":2147483648},\"contentChanges\":[{\"text\":\"x\"}]}}",
		"version",
	)
	underflow_version: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.brp\",\"version\":-2147483649},\"contentChanges\":[{\"text\":\"x\"}]}}",
		"version",
	)
	changes_not_array: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.brp\",\"version\":2},\"contentChanges\":false}}",
		"array",
	)
	change_not_object: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.brp\",\"version\":2},\"contentChanges\":[false]}}",
		"object",
	)
	invalid_text: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.brp\",\"version\":2},\"contentChanges\":[{\"text\":false}]}}",
		"text",
	)
	incremental_change: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.brp\",\"version\":2},\"contentChanges\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"text\":\"x\"}]}}",
		"incremental",
	)
	range_length_change: Bool = invalid_parameters_contain(
		"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.brp\",\"version\":2},\"contentChanges\":[{\"rangeLength\":1,\"text\":\"x\"}]}}",
		"incremental",
	)

	(
		missing_params
		and missing_document
		and missing_uri
		and non_object_document
		and non_string_uri
		and missing_version
		and invalid_version
		and overflow_version
		and underflow_version
		and missing_changes
		and changes_not_array
		and change_not_object
		and invalid_text
		and incremental_change
		and range_length_change
	)


func test_did_change_rejects_mixed_full_and_incremental_events() -> Bool:
	full_then_incremental: String =
		|{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///a.brp","version":2},"contentChanges":[{"text":"full"},{"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":0}},"text":"incremental"}]}}
	incremental_then_full: String =
		|{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///a.brp","version":2},"contentChanges":[{"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":0}},"text":"incremental"},{"text":"full"}]}}

	(
		invalid_parameters_contain(full_then_incremental, "incremental")
		and invalid_parameters_contain(incremental_then_full, "incremental")
	)


func test_did_change_rejects_malformed_json() -> Bool:
	match decode_lsp_did_change_notification("{"):
		ProtocolInputRejected(failure):
			match failure.error:
				MalformedJson(_):
					True
				_:
					False
		_:
			False


func test_document_store_changes_open_document_and_preserves_language() -> Bool:
	match (opened_store(), decode_change(DID_CHANGE_BODY)):
		(Some((store, opened)), Some(changed)):
			match handle_lsp_did_change_notification(store, changed):
				Err(_):
					False
				Ok(updated):
					updated_ok: Bool = match document_store_find(updated, changed.uri):
						Some(document):
							(
								document.language_id == "blorp"
								and document.document.text == DID_CHANGE_TEXT
								and document_version_value(document.document.version) == 13
							)
						None:
							False

					original_ok: Bool = match document_store_find(store, opened.document.uri):
						Some(document):
							document.document.text == "original"
						None:
							False

					updated_ok and original_ok
		_:
			False


func test_document_store_applies_empty_changes() -> Bool:
	match opened_store():
		None:
			False
		Some((store, opened)):
			match (
				apply_change_body(store, DID_CHANGE_EMPTY_EVENTS_BODY),
				apply_change_body(store, DID_CHANGE_EMPTY_TEXT_BODY),
			):
				(Some(version_only_store), Some(clear_store)):
					version_only_ok: Bool = match document_store_find(
						version_only_store,
						opened.document.uri,
					):
						Some(document):
							(
								document.document.text == "original"
								and document_version_value(document.document.version) == 13
							)
						None:
							False

					clear_ok: Bool = match document_store_find(clear_store, opened.document.uri):
						Some(document):
							document.document.text == ""
						None:
							False

					version_only_ok and clear_ok
				_:
					False


func test_document_store_applies_sequential_changes() -> Bool:
	match (
		opened_store(),
		decode_change(DID_CHANGE_BODY),
		decode_change(DID_CHANGE_VERSION_14_BODY),
	):
		(Some((store, opened)), Some(version_13), Some(version_14)):
			match apply_change_bodies(store, DID_CHANGE_BODY, DID_CHANGE_VERSION_14_BODY):
				None:
					False
				Some(version_14_store):
					sequential_ok: Bool = match document_store_find(
						version_14_store,
						opened.document.uri,
					):
						Some(document):
							(
								document.document.text == "version fourteen"
								and document_version_value(document.document.version) == 14
							)
						None:
							False

					stale_ok: Bool = match handle_lsp_did_change_notification(
						version_14_store,
						version_13,
					):
						Err(DocumentVersionNotNewer(_, current, received)):
							(
								document_version_value(current) == 14
								and document_version_value(received) == 13
							)
						_:
							False

					sequential_ok and stale_ok
		_:
			False


func test_document_store_changes_only_exact_uri() -> Bool:
	match opened_store_with_other():
		None:
			False
		Some((both, other)):
			match (decode_change(DID_CHANGE_BODY), apply_change_body(both, DID_CHANGE_BODY)):
				(Some(change), Some(updated)):
					main_ok: Bool = match document_store_find(updated, change.uri):
						Some(document):
							document.document.text == DID_CHANGE_TEXT
						None:
							False

					other_ok: Bool = match document_store_find(updated, other.document.uri):
						Some(document):
							(
								document.language_id == "other-language"
								and document.document.text == "other text"
								and document_version_value(document.document.version) == 3
							)
						None:
							False

					main_ok and other_ok
				_:
					False


func test_document_store_rejects_unopened_and_non_newer_versions() -> Bool:
	match (decode_change(DID_CHANGE_BODY), decode_change(DID_CHANGE_STALE_BODY), opened_store()):
		(Some(change), Some(stale_version), Some((store, opened))):
			unopened_ok: Bool = match handle_lsp_did_change_notification(document_store(), change):
				Err(DocumentNotOpen(uri)):
					document_uri_value(uri) == DOCUMENT_URI
				_:
					False

			equal_version = { change | version = opened.document.version }

			equal_ok: Bool = match handle_lsp_did_change_notification(store, equal_version):
				Err(DocumentVersionNotNewer(uri, current, received)):
					(
						document_uri_value(uri) == DOCUMENT_URI
						and document_version_value(current) == 12
						and document_version_value(received) == 12
					)
				_:
					False

			stale_ok: Bool = match handle_lsp_did_change_notification(store, stale_version):
				Err(DocumentVersionNotNewer(_, current, received)):
					document_version_value(current) == 12 and document_version_value(received) == 11
				_:
					False

			unopened_ok and equal_ok and stale_ok
		_:
			False


tests: TestSuite = {
	description = "Blorp LSP didChange notification",
	tests = [
		("decode full replacement", test_did_change_decodes_full_document_replacement),
		("use last full replacement", test_did_change_uses_last_full_replacement),
		("accept predecoded envelope", test_did_change_accepts_predecoded_envelope),
		(
			"distinguish empty events from empty text",
			test_did_change_distinguishes_empty_events_from_empty_text,
		),
		("accept version boundaries", test_did_change_accepts_document_version_boundaries),
		("reject request form", test_did_change_request_returns_invalid_request_error),
		(
			"ignore invalid notification params",
			test_did_change_ignores_invalid_notification_parameters,
		),
		(
			"reject mixed full and incremental events",
			test_did_change_rejects_mixed_full_and_incremental_events,
		),
		("reject malformed JSON", test_did_change_rejects_malformed_json),
		(
			"change open document and preserve language",
			test_document_store_changes_open_document_and_preserves_language,
		),
		("apply empty changes", test_document_store_applies_empty_changes),
		("apply sequential changes", test_document_store_applies_sequential_changes),
		("change only exact URI", test_document_store_changes_only_exact_uri),
		(
			"reject unopened and non-newer versions",
			test_document_store_rejects_unopened_and_non_newer_versions,
		),
	]
}
