			LiteralExpr,
			PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr,
			PreClosureDetachExpr,
			RawMatchExpr,
			RecordExpr,
			RecordUpdateExpr,
			ResourceScopeExpr,
			SelectExpr,
			SemanticMatchExpr,
			SeqExpr,
			TensorRawReadExpr,
			TensorRawViewLetExpr,
			TupleConstructExpr,
			TupleExpr,
			VarExpr,
			VectorExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunctionKind(UserFunction),
		CoreLiteral(IntLiteral),
		CoreProgram,
		CoreReleasePolicy(ArcReleasePolicy),
		CoreSelectArmKind(SelectAfterArm),
		CoreSemanticMatchTree(SemanticMatchLeaf),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreTensorRawScalarKind(TensorFloat64Elements, TensorInt64Elements),
		CoreType(FunctionType, NamedType, StackResultType, TensorType, UnionType, VoidType),
		CoreVar,
	../src/stage_09_core/core_late_invariants:
		CoreLateInvariantViolation(
			CooperativeCheckpointMisplaced,
			ConcurrentContractViolation,
			DebugBlockSurvived,
			DictLiteralSurvived,
			LayoutlessListAllocationSurvived,
			LambdaSurvived,
			ManagedMatchScrutineeUnmaterialized,
			MissingOwnershipCallContract,
			PreClosureConcurrentSurvived,
			PreClosureConcurrentlyLoopSurvived,
			PreClosureDetachSurvived,
			RawMatchSurvived,
			RecordLiteralSurvived,
			RecordUpdateSurvived,
			RawTensorViewUnbound,
			RawTensorViewKindMismatch,
			ResourceContractViolation,
			SemanticMatchSurvived,
			TupleLiteralSurvived,
			UncheckedRawTensorIntrinsicSurvived,
			UncheckedStringByteIntrinsicSurvived,
			UnresolvedCallSurvived,
			VectorLiteralSurvived,
		),
		check_late_core_invariants,
	../src/stage_09_core/core_pipeline_stage:
		CorePipelineStage(ClosureStage, DceStage, FinalStage, PerceusStage, PostDceTailStage),
	test: TestSuite


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func variable(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), int_type(), SyntheticSourceLoc)


pure func program_with_body(body: CoreExpr) -> CoreProgram:
	{
		decls = [FunctionDecl({
				name = "main",
				source_module = None,
				type_params = [],
				params = [],
				return_type = int_type(),
				body = Some(body),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 1,
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}


pure func record_update_program() -> CoreProgram:
	point_type: CoreType = NamedType("Point", [])
	point: CoreVar = variable("point")
	program_with_body(
		RecordUpdateExpr(
			VarExpr(point, point_type, SyntheticSourceLoc),
			[],
			point_type,
			SyntheticSourceLoc,
		),
	)


pure func releasing_match_program(scrutinee: CoreExpr) -> CoreProgram:
	program_with_body(
		ConstructorMatchExpr(
			scrutinee,
			ArcReleasePolicy,
			[],
			ConstructorMatchFallbackFail,
			int_type(),
			SyntheticSourceLoc,
		),
	)


pure func test_releasing_match_requires_named_scrutinee_at_dce() -> Bool:
	union_type: CoreType = UnionType("Choice")
	invalid: CoreProgram = releasing_match_program(
		CallExpr(
			IntrinsicCall("make_choice"),
			VarExpr(
				variable("make_choice"),
				FunctionType(True, [], union_type),
				SyntheticSourceLoc,
			),
			[],
			union_type,
			SyntheticSourceLoc,
		),
	)
	valid: CoreProgram = releasing_match_program(
		VarExpr(
			variable("choice"),
			union_type,
			SyntheticSourceLoc,
		),
	)

	match check_late_core_invariants(DceStage, invalid):
		[ManagedMatchScrutineeUnmaterialized(_)]:
			check_late_core_invariants(DceStage, valid).is_empty()
		_:
			False


pure func test_record_update_boundary_starts_at_perceus() -> Bool:
	(
		check_late_core_invariants(DceStage, record_update_program()).is_empty()
		and match check_late_core_invariants(PerceusStage, record_update_program()):
			[RecordUpdateSurvived(_)]:
				match check_late_core_invariants(PostDceTailStage, record_update_program()):
					[RecordUpdateSurvived(_)]:
						True
					_:
						False
			_:
				False
	)


