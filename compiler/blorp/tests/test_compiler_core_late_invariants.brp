pure func raw_tensor_view_program(read_kind: CoreTensorRawScalarKind) -> CoreProgram:
	view: CoreVar = variable("raw_view")
	tensor_type: CoreType = TensorType({
		element_type = int_type(),
		dims = [],
	})
	read: CoreExpr = TensorRawReadExpr(
		{
			view = view,
			kind = read_kind,
			index = literal(0)
		},
		int_type(),
		SyntheticSourceLoc,
	)
	program_with_body(
		TensorRawViewLetExpr(
			{
				variable = view,
				kind = TensorInt64Elements,
				source = VarExpr(variable("tensor"), tensor_type, SyntheticSourceLoc)
			},
			read,
			int_type(),
			SyntheticSourceLoc,
		),
	)


