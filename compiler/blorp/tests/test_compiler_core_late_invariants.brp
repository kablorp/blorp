import:
	../src/stage_09_core/core_json:
		CoreCallKind(IntrinsicCall, SelectedDirectCall, UserCall),
		CoreConcurrentlyLoopItemMode(ConcurrentlyLoopCopyItem),
		CoreConcurrentlyLoopOutput(ConcurrentlyLoopDiscard),
		CoreConstructorMatchFallback(ConstructorMatchFallbackFail),
		CoreDecl(FunctionDecl),
		CoreExpr(
			BreakExpr,
			CallExpr,
			CooperativeCheckpointExpr,
			ConcurrentExpr,
			ConcurrentlyLoopExpr,
