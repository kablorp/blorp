pure func test_final_boundary_rejects_invalid_resource_cleanup() -> Bool:
	resource_expr: CoreExpr = ResourceScopeExpr(
		{
			variable = variable("resource"),
			typ = int_type(),
			acquire = literal(1),
			body = literal(2),
			cleanup = literal(3)
		},
		int_type(),
		SyntheticSourceLoc,
	)
	violations: List[CoreLateInvariantViolation] = check_late_core_invariants(
		FinalStage,
		program_with_body(resource_expr),
	)

	violations.any(func(violation):
		match violation:
			ResourceContractViolation(_, _):
				True
			_:
				False
	)


pure func resource_cleanup(variable_name: String) -> CoreExpr:
	CallExpr(
		UserCall("close", Some(10), []),
		VarExpr(variable("close"), int_type(), SyntheticSourceLoc),
		[VarExpr(variable(variable_name), int_type(), SyntheticSourceLoc)],
		VoidType,
		SyntheticSourceLoc,
	)


pure func resource_scope_with_cleanup(cleanup: CoreExpr) -> CoreExpr:
	ResourceScopeExpr(
		{
			variable = variable("resource"),
			typ = int_type(),
			acquire = literal(1),
			body = literal(2),
			cleanup = cleanup
		},
		int_type(),
		SyntheticSourceLoc,
	)


pure func test_final_boundary_rejects_cleanup_of_unrelated_resource() -> Bool:
	violations: List[CoreLateInvariantViolation] = check_late_core_invariants(
		FinalStage,
		program_with_body(resource_scope_with_cleanup(resource_cleanup("other"))),
	)

	violations.any(func(violation):
		match violation:
			ResourceContractViolation(_, _):
				True
			_:
				False
	)


pure func test_final_boundary_accepts_direct_resource_cleanup() -> Bool:
	check_late_core_invariants(
		FinalStage,
		program_with_body(resource_scope_with_cleanup(resource_cleanup("resource"))),
	).is_empty()


pure func resource_scope_with_body(body: CoreExpr) -> CoreExpr:
	ResourceScopeExpr(
		{
			variable = variable("resource"),
			typ = int_type(),
			acquire = literal(1),
			body = body,
			cleanup = resource_cleanup("resource")
		},
		VoidType,
		SyntheticSourceLoc,
	)


