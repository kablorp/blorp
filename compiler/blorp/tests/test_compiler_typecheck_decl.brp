	)

	result.state.errors.any(
		func(
			error,
		): error.contains(
			"Function 'use_reader' parameter 'reader' cannot contain a resource type",
		),
	)


func test_registers_type_record_alias_and_constructors() -> Bool:
	source_program = program([
		union_decl(
			"Maybe",
			["Some", "None"],
		),
		record_with_fields_decl("Point", [int_type()]),
		type_alias_decl("UserId", False),
	])
	state = compiler_typecheck_register_program_type_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
		source_program,
	)

	match (
		compiler_env_get_type_decl(state.env, "Maybe"),
		compiler_env_get_constructor(state.env, "Some"),
		compiler_env_get_record(state.env, "Point"),
		compiler_env_get_alias(state.env, "UserId"),
	):
		(Some((_, variants)), Some(ctor), Some((_, record_fields)), Some((_, alias_target))):
			(
				variants.length() == 2
				and ctor.parent_type == "Maybe"
				and ctor.field_types.length() == 0
				and ctor.tag == 0
				and record_fields.length() == 1
				and compiler_types_equal(alias_target, compiler_type_int())
				and compiler_typecheck_state_find_type_home(state, "Maybe") == Some("decl")
				and compiler_typecheck_state_find_type_home(state, "Point") == Some("decl")
			)
		_:
			False


func test_registers_builtin_resource_and_resource_containing_record() -> Bool:
	source_program = program([
		builtin_resource_type_decl_with_cleanup("Reader", "blorp_reader_close"),
		record_with_fields_decl("ReaderBox", [ParsedNamedType(ident("Reader"), [], source_span())]),
	])
	state = compiler_typecheck_register_program_type_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_stdlib(), source_program),
		source_program,
	)
	user_program = program([builtin_type_decl("Handle", False)])
	user_state = compiler_typecheck_register_program_type_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), user_program),
		user_program,
	)

	(
		state.errors.length() == 0
		and compiler_env_get_type_kind(state.env, "Reader") == Some(CompilerTypeResource)
		and compiler_env_get_type_contains_resource(state.env, "ReaderBox")
		and compiler_typecheck_state_has_known_resource_type_name(state, "Reader")
		and compiler_find_resource_cleanup(state.context, "Reader") == Some("blorp_reader_close")
		and user_state.errors.length() == 1
		and user_state.errors
			.get_or(0, "")
			.contains("can only be used in the standard library")
	)


func test_registers_struct_and_enum_boundary_errors() -> Bool:
	source_program = program([
		struct_decl("Empty", [type_param("T")], []),
		enum_decl("Choice", [type_param("T")], [int_type()]),
	])
	state = compiler_typecheck_register_program_type_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
		source_program,
	)

	(
		state.errors.length() == 4
		and state.errors
			.get_or(0, "")
			.contains("Struct 'Empty' cannot have type parameters")
		and state.errors
			.get_or(1, "")
			.contains("Struct 'Empty' must have at least one field")
		and state.errors
			.get_or(2, "")
			.contains("Enum 'Choice' cannot have type parameters")
		and state.errors
			.get_or(3, "")
			.contains("Enum variant 'Case' cannot have fields")
		and compiler_env_get_type_kind(state.env, "Choice") == Some(CompilerTypeEnum)
		and compiler_env_get_constructor(state.env, "Case").is_some()
	)


