func test_materialize_program_bodies_carries_typed_decl_shapes() -> Bool:
	source_program = program([
		record_with_fields_decl("Widget", [int_type()]),
		union_decl_with_variant_fields("Choice", "First", [int_type()]),
		type_alias_decl("WidgetId", False),
		trait_decl_with_methods(
			"Display",
			[],
			[],
			[
				trait_method_decl(
					"display",
					[named_param("value", named_type("Widget"))],
					Some(int_type()),
					False,
					False,
				),
			],
		),
		impl_decl_with_methods(
			"Display",
			named_type("Widget"),
			[
				method_body_decl(
					"display",
					[named_param("value", named_type("Widget"))],
					Some(int_type()),
					Some(int_expr()),
				),
			],
		),
		PrivateParsedDecl(
			type_alias_decl("PrivateId", False),
			source_span(),
		),
	])
	with_types = compiler_typecheck_register_program_type_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
		source_program,
	)
	with_signatures = compiler_typecheck_register_program_signature_decls(
		with_types,
		source_program,
	)
	base_state = compiler_typecheck_register_program_impl_decls(with_signatures, source_program)
	result = compiler_typecheck_materialize_program_bodies(base_state, source_program)

	record_ok = match result.program.decls.get(0):
		Some(CompilerTypedRecordDecl(info)):
			field_ok = match info.fields.get(0):
				Some(field):
					(
						field.name == "field"
						and compiler_types_equal(field.source_type, compiler_type_int())
						and compiler_types_equal(field.semantic_type, compiler_type_int())
					)
				None:
					False

			info.decl.name.text == "Widget" and info.fields.length() == 1 and field_ok
		_:
			False

	union_ok = match result.program.decls.get(1):
		Some(CompilerTypedUnionDecl(info)):
			match info.variants.get(0):
				Some(variant):
					match variant.fields.get(0):
						Some(field):
							(
								info.decl.name.text == "Choice"
								and info.variants.length() == 1
								and variant.name == "First"
								and variant.tag == 0
								and variant.def_id.is_some()
								and compiler_types_equal(field, compiler_type_int())
							)
						None:
							False
				None:
					False
		_:
			False

	alias_ok = match result.program.decls.get(2):
		Some(CompilerTypedTypeAliasDecl(info)):
			(
				info.decl.name.text == "WidgetId"
				and compiler_types_equal(info.source_target_type, compiler_type_int())
				and compiler_types_equal(info.semantic_target_type, compiler_type_int())
			)
		_:
			False

	trait_ok = match result.program.decls.get(3):
		Some(CompilerTypedTraitDecl(info)):
			match info.methods.get(0):
				Some(method):
					(
						info.decl.name.text == "Display"
						and method.decl.name.text == "display"
						and method.param_types.length() == 1
						and compiler_types_equal(
							method.param_types.get_or(0, compiler_type_void()),
							CompilerNamedType("Widget", []),
						)
						and compiler_types_equal(method.semantic_return_type, compiler_type_int())
					)
				None:
					False
		_:
			False

	impl_ok = match result.program.decls.get(4):
		Some(CompilerTypedImplDecl(info)):
			method_ok = match info.methods.get(0):
				Some(method_info):
					source_return_ok = match method_info.source_return_type:
						Some(return_type):
							compiler_types_equal(return_type, compiler_type_int())
						None:
							False

					(
						method_info.decl.name.text == "display"
						and source_return_ok
						and compiler_types_equal(
							method_info.semantic_return_type,
							compiler_type_int(),
						)
						and method_info.body.is_some()
					)
				None:
					False

			info.decl.trait_name.text == "Display" and info.methods.length() == 1 and method_ok
		_:
			False

	private_ok = match result.program.decls.get(5):
		Some(CompilerTypedPrivateDecl(CompilerTypedTypeAliasDecl(info))):
			info.decl.name.text == "PrivateId"
		_:
			False

	(
		result.state.errors.length() == 0
		and result.program.decls.length() == 6
		and record_ok
		and union_ok
		and alias_ok
		and trait_ok
		and impl_ok
		and private_ok
	)


func test_typecheck_program_runs_full_decl_pipeline() -> Bool:
	source_program = program([
		record_with_fields_decl("Widget", [int_type()]),
		trait_decl_with_methods(
			"Display",
			[],
			[],
			[
				trait_method_decl(
					"display",
					[named_param("value", named_type("Widget"))],
					Some(int_type()),
					False,
					False,
				),
			],
		),
		impl_decl_with_methods(
			"Display",
			named_type("Widget"),
			[
				method_body_decl(
					"display",
					[named_param("value", named_type("Widget"))],
					Some(int_type()),
					Some(int_expr()),
				),
			],
		),
		function_body_decl(
			"identity",
			[named_param("value", int_type())],
			Some(int_type()),
			Some(decl_name_expr("value")),
		),
		var_body_decl("answer", Some(int_type()), int_expr()),
	])
	base_state = compiler_typecheck_state_empty()
	result = compiler_typecheck_program(base_state, source_program)

	record_ok = match result.program.decls.get(0):
		Some(CompilerTypedRecordDecl(info)):
			info.decl.name.text == "Widget" and info.fields.length() == 1
		_:
			False

	impl_ok = match result.program.decls.get(2):
		Some(CompilerTypedImplDecl(info)):
			info.decl.trait_name.text == "Display" and info.methods.length() == 1
		_:
			False

	function_ok = match result.program.decls.get(3):
		Some(CompilerTypedFunctionDecl(info)):
			body_ok = match info.body:
				Some(body):
					compiler_types_equal(
						compiler_typed_expr_semantic_type(body),
						compiler_type_int(),
					)
				None:
					False

			info.decl.name.text == "identity" and info.param_types.length() == 1 and body_ok
		_:
			False

	global_ok = match result.program.decls.get(4):
		Some(CompilerTypedGlobalVarDecl(info)):
			(
				info.decl.name.text == "answer"
				and compiler_types_equal(info.binding_type, compiler_type_int())
			)
		_:
			False

	(
		result.state.errors.length() == 0
		and result.state.env.impls.length() == base_state.env.impls.length() + 1
		and result.program.source.module_name == "decl"
		and result.program.diagnostics.length() == 0
		and result.program.decls.length() == 5
		and compiler_typecheck_state_find_top_level_name(
			result.state,
			"Display",
		) == Some(CompilerTopLevelTrait)
		and record_ok
		and impl_ok
		and function_ok
		and global_ok
	)


func test_validate_typed_program_rejects_unfinalized_meta() -> Bool:
	source_decl = record_with_fields_decl("Broken", [int_type()])

	match source_decl:
		RecordParsedDecl(record_decl):
			typed_field: CompilerTypedRecordFieldInfo = {
				name = "field",
				source_type = CompilerMetaType(7),
				semantic_type = compiler_type_int()
			}
			typed_record: CompilerTypedRecordInfo = {
				decl = record_decl,
				fields = [typed_field]
			}
			typed_program: CompilerTypedProgram = {
				source = source_file(),
				decls = [CompilerTypedRecordDecl(typed_record)],
				diagnostics = []
			}
			result: CompilerTypecheckProgramResult = compiler_typecheck_validate_typed_program({
				state = compiler_typecheck_state_empty(),
				program = typed_program,
			})

			(
				result.state.errors.length() == 1
				and result.state.errors
					.get_or(0, "")
					.contains((
							"typed program contains unfinalized inference meta in record 'Broken' field "
							+ "'field' source type"
						))
			)
		_:
			False


pure func incoherent_typed_int_expr() -> CompilerTypedExpr:
	value_slot: CompilerValueSlot = {
		semantic_type = compiler_type_int(),
		decision = CompilerTypeKeep(compiler_type_int())
	}
	info: CompilerTypedExprInfo = {
		source_type = None,
		semantic_type = compiler_type_int(),
		value_type = compiler_type_string(),
		origin = CompilerInferredOrigin,
		value_slot = value_slot,
		proofs = compiler_unrefined_binding(),
		resolved_call = None,
		resource_dependencies = []
	}

	CompilerTypedIntLiteralExpr("1", source_span(), info)


func test_validate_typed_program_rejects_incoherent_expr_info() -> Bool:
	source_decl = var_body_decl("broken", Some(int_type()), int_expr())

	match source_decl:
		VarParsedDecl(var_decl):
			typed_global: CompilerTypedGlobalVarInfo = {
				decl = var_decl,
				binding_type = compiler_type_int(),
				source_type = Some(compiler_type_int()),
				value = incoherent_typed_int_expr()
			}
			typed_program: CompilerTypedProgram = {
				source = source_file(),
				decls = [CompilerTypedGlobalVarDecl(typed_global)],
				diagnostics = []
			}
			result: CompilerTypecheckProgramResult = compiler_typecheck_validate_typed_program({
				state = compiler_typecheck_state_empty(),
				program = typed_program,
			})

			(
				result.state.errors.length() == 1
				and result.state.errors
					.get_or(0, "")
					.contains((
							"typed expression has incoherent type info in global 'broken' value: kept "
							+ "widening decision must match value type"
						))
			)
		_:
			False


func test_check_function_body_reports_wrong_return_type() -> Bool:
	source_program = program(
		[function_body_decl("bad", [], Some(bool_type()), Some(decl_string_expr()))],
	)
	state = compiler_typecheck_check_program_bodies(
		compiler_typecheck_register_program_signature_decls(
			compiler_typecheck_register_program_type_decls(
				compiler_typecheck_prescan_program(
					compiler_typecheck_state_empty(),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)

	(
		state.errors.length() == 1
		and state.errors
			.get_or(0, "")
			.contains("Function 'bad' returns wrong type")
		and state.errors
			.get_or(0, "")
			.contains("expected: Bool")
	)


