		compiler_env_lookup,
		compiler_loop_producer_is_windows,
	../src/stage_05_types/compiler_refinement: compiler_unrefined_binding
	../src/stage_05_types/compiler_type:
		CompilerType(CompilerFunctionType, CompilerMetaType, CompilerNamedType),
		compiler_canonical_module_type_name,
		compiler_type_bool,
		compiler_type_int,
		compiler_type_string,
		compiler_type_void,
		compiler_types_equal,
	../src/stage_05_types/compiler_type_widening:
		CompilerTypeWideningDecision(CompilerTypeKeep),
		CompilerValueSlot,
	../src/stage_06_typecheck/compiler_imports:
		CompilerImportableModule,
		CompilerImportableModuleSurface,
		compiler_importable_module,
		compiler_importable_module_surface,
	../src/stage_06_typecheck/compiler_infer:
		CompilerExprTypeOrigin(CompilerInferredOrigin),
