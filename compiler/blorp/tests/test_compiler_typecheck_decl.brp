pure func source_file() -> CompilerSourceFile:
	compiler_source_file("decl.brp", "decl", "func main(): 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func source_span_at(offset: Int) -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, offset)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func int_type() -> ParsedTypeExpr:
	ParsedNamedType(ident("Int"), [], source_span())


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], source_span())


pure func dim_literal_type(text: String) -> ParsedTypeExpr:
	ParsedDimLiteralType(text, source_span())


pure func int_vector_type(size: String) -> ParsedTypeExpr:
	ParsedArrayType(int_type(), [dim_literal_type(size)], source_span())


pure func int_expr() -> ParsedExpr:
	ParsedIntLiteralExpr("1", source_span())


pure func decl_string_expr() -> ParsedExpr:
	ParsedStringLiteralExpr("text", ParsedPlainStringLiteral, source_span())


pure func decl_void_expr() -> ParsedExpr:
	ParsedVoidExpr(source_span())


pure func decl_name_expr(name: String) -> ParsedExpr:
	ParsedNameExpr(ident(name))


pure func decl_call_expr(name: String, args: List[ParsedExpr]) -> ParsedExpr:
	ParsedCallExpr(decl_name_expr(name), args, source_span())


pure func decl_field_access_expr(receiver: ParsedExpr, field: String) -> ParsedExpr:
	ParsedFieldAccessExpr(receiver, ident(field), source_span())


pure func decl_add_expr(left: ParsedExpr, right: ParsedExpr) -> ParsedExpr:
	ParsedBinaryExpr(ParsedAddOp, left, right, source_span())


pure func decl_assign_expr(name: String, value: ParsedExpr) -> ParsedExpr:
	ParsedAssignExpr(ident(name), value, source_span())


pure func decl_vector_expr(items: List[ParsedExpr]) -> ParsedExpr:
	ParsedVectorExpr(items, source_span())


pure func decl_record_field(name: String, value: ParsedExpr) -> ParsedRecordExprField:
	{
		name = ident(name),
		value = value,
		span = source_span()
	}


pure func decl_record_expr(fields: List[ParsedRecordExprField]) -> ParsedExpr:
	ParsedRecordExpr(fields, source_span())


pure func decl_subscript_assign_expr(
	target: ParsedExpr,
	indices: List[ParsedExpr],
	value: ParsedExpr,
) -> ParsedExpr:
	ParsedSubscriptAssignExpr(target, indices, value, source_span())


pure func decl_subscript_expr(target: ParsedExpr, indices: List[ParsedExpr]) -> ParsedExpr:
	ParsedSubscriptExpr(target, indices, source_span())


pure func decl_block_expr(items: List[ParsedExpr]) -> ParsedExpr:
	ParsedBlockExpr(items, source_span())


pure func decl_for_expr(name: String, iterable: ParsedExpr, body: ParsedExpr) -> ParsedExpr:
	ParsedForExpr(ParsedForNameBinder(ident(name)), iterable, body, source_span())


pure func decl_debug_expr(body: ParsedExpr) -> ParsedExpr:
	ParsedDebugBlockExpr(body, source_span())


pure func decl_lambda_expr(is_pure: Bool, body: ParsedExpr) -> ParsedExpr:
	ParsedLambdaExpr(is_pure, [], Some(int_type()), body, source_span())


pure func bool_type() -> ParsedTypeExpr:
	ParsedNamedType(ident("Bool"), [], source_span())


pure func string_type() -> ParsedTypeExpr:
	ParsedNamedType(ident("String"), [], source_span())


pure func generic_named_type(name: String, args: List[ParsedTypeExpr]) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), args, source_span())


pure func bounded_type(name: String, bounds: List[String]) -> ParsedTypeExpr:
	ParsedBoundedType(
		ident(name),
		bounds.map(ident),
		source_span(),
	)


pure func result_type(ok_type: ParsedTypeExpr, error_type: ParsedTypeExpr) -> ParsedTypeExpr:
	generic_named_type(
		"Result",
		[ok_type, error_type],
	)


pure func list_string_type() -> ParsedTypeExpr:
	ParsedNamedType(ident("List"), [string_type()], source_span())


pure func channel_type(element_type: ParsedTypeExpr) -> ParsedTypeExpr:
	ParsedNamedType(ident("Channel"), [element_type], source_span())


pure func stream_type(element_type: ParsedTypeExpr) -> ParsedTypeExpr:
	ParsedNamedType(ident("Stream"), [element_type], source_span())


pure func function_type(
	is_pure: Bool,
	params: List[ParsedTypeExpr],
	return_type: ParsedTypeExpr,
) -> ParsedTypeExpr:
	ParsedFunctionType(is_pure, params, return_type, source_span())


pure func named_param(name: String, type_expr: ParsedTypeExpr) -> ParsedParam:
	{
		binder = ParsedParamNameBinder(ident(name)),
		type_expr = Some(type_expr),
		span = source_span()
	}


pure func wildcard_param(type_expr: ParsedTypeExpr) -> ParsedParam:
	{
		binder = ParsedParamWildcardBinder(source_span()),
		type_expr = Some(type_expr),
		span = source_span()
	}


pure func untyped_named_param(name: String) -> ParsedParam:
	{
		binder = ParsedParamNameBinder(ident(name)),
		type_expr = None,
		span = source_span()
	}


pure func trait_method_decl(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	is_pure: Bool,
	has_default: Bool,
) -> ParsedTraitMethodDecl:
	body: Option[ParsedExpr] = if has_default:
		Some(int_expr())
	else:
		None

	{
		name = ident(name),
		params = params,
		return_type = return_type,
		body = body,
		is_pure = is_pure,
		span = source_span()
	}


pure func trait_decl_with_methods(
	name: String,
	type_params: List[ParsedTypeParamDecl],
	supertraits: List[String],
	methods: List[ParsedTraitMethodDecl],
) -> ParsedDecl:
	TraitParsedDecl({
		name = ident(name),
		type_params = type_params,
		supertraits = supertraits.map(func(supertrait): ident(supertrait)),
		methods = methods,
		doc = None,
		span = source_span(),
	})


pure func function_decl(name: String) -> ParsedDecl:
	FunctionParsedDecl({
		name = ident(name),
		keyword_span = Some(source_span()),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = Some(int_expr()),
		is_pure = False,
		annotations = [],
		doc = None,
		span = source_span(),
	})


pure func function_body_decl(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
) -> ParsedDecl:
	function_body_decl_with_purity(name, params, return_type, body, False)


pure func function_body_decl_with_purity(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
	is_pure: Bool,
) -> ParsedDecl:
	function_body_decl_with_annotations(name, params, return_type, body, is_pure, [])


pure func function_body_decl_with_annotations(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
) -> ParsedDecl:
	FunctionParsedDecl({
		name = ident(name),
		keyword_span = Some(source_span()),
		type_params = [],
		params = params,
		return_type = return_type,
		dim_constraints = [],
		body = body,
		is_pure = is_pure,
		annotations = annotations,
		doc = None,
		span = source_span(),
	})


pure func function_body_decl_with_span(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
	span: CompilerSourceSpan,
) -> ParsedDecl:
	FunctionParsedDecl({
		name = ident(name),
		keyword_span = Some(span),
		type_params = [],
		params = params,
		return_type = return_type,
		dim_constraints = [],
		body = body,
		is_pure = False,
		annotations = [],
		doc = None,
		span = span,
	})


pure func generic_function_body_decl(
	name: String,
	type_params: List[ParsedTypeParamDecl],
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
	is_pure: Bool,
) -> ParsedDecl:
	FunctionParsedDecl({
		name = ident(name),
		keyword_span = Some(source_span()),
		type_params = type_params,
		params = params,
		return_type = return_type,
		dim_constraints = [],
		body = body,
		is_pure = is_pure,
		annotations = [],
		doc = None,
		span = source_span(),
	})


pure func method_body_decl(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
) -> ParsedFunctionDecl:
	{
		name = ident(name),
		keyword_span = Some(source_span()),
		type_params = [],
		params = params,
		return_type = return_type,
		dim_constraints = [],
		body = body,
		is_pure = False,
		annotations = [],
		doc = None,
		span = source_span()
	}


pure func function_signature_decl(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
) -> ParsedDecl:
	FunctionParsedDecl({
		name = ident(name),
		keyword_span = Some(source_span()),
		type_params = [type_param("T")],
		params = params,
		return_type = return_type,
		dim_constraints = [],
		body = Some(int_expr()),
		is_pure = is_pure,
		annotations = annotations,
		doc = None,
		span = source_span(),
	})


pure func var_decl(name: String) -> ParsedDecl:
	VarParsedDecl({
		name = ident(name),
		type_expr = Some(int_type()),
		value = int_expr(),
		is_mutable = False,
		span = source_span(),
	})


pure func var_body_decl(
	name: String,
	type_expr: Option[ParsedTypeExpr],
	value: ParsedExpr,
) -> ParsedDecl:
	VarParsedDecl({
		name = ident(name),
		type_expr = type_expr,
		value = value,
		is_mutable = False,
		span = source_span(),
	})


pure func mutable_var_body_decl(
	name: String,
	type_expr: Option[ParsedTypeExpr],
	value: ParsedExpr,
) -> ParsedDecl:
	VarParsedDecl({
		name = ident(name),
		type_expr = type_expr,
		value = value,
		is_mutable = True,
		span = source_span(),
	})


pure func decl_var_expr(
	name: String,
	type_expr: Option[ParsedTypeExpr],
	value: ParsedExpr,
	is_mutable: Bool,
) -> ParsedExpr:
	ParsedVarDeclExpr(ident(name), type_expr, value, is_mutable, source_span())


pure func record_decl(name: String) -> ParsedDecl:
	RecordParsedDecl({
		name = ident(name),
		type_params = [],
		fields = [],
		is_struct = False,
		doc = None,
		span = source_span(),
	})


pure func field_decl(name: String, type_expr: ParsedTypeExpr) -> ParsedFieldDecl:
	{
		name = ident(name),
		type_expr = type_expr,
		span = source_span()
	}


pure func type_param(name: String) -> ParsedTypeParamDecl:
	{
		name = ident(name),
		bounds = [],
		span = source_span()
	}


pure func record_with_fields_decl(name: String, field_types: List[ParsedTypeExpr]) -> ParsedDecl:
	RecordParsedDecl({
		name = ident(name),
		type_params = [],
		fields = field_types.map(func(type_expr): field_decl("field", type_expr)),
		is_struct = False,
		doc = None,
		span = source_span(),
	})


pure func struct_decl(
	name: String,
	type_params: List[ParsedTypeParamDecl],
	fields: List[ParsedTypeExpr],
) -> ParsedDecl:
	RecordParsedDecl({
		name = ident(name),
		type_params = type_params,
		fields = fields.map(func(type_expr): field_decl("field", type_expr)),
		is_struct = True,
		doc = None,
		span = source_span(),
	})


pure func union_decl(name: String, variants: List[String]) -> ParsedDecl:
	UnionParsedDecl({
		name = ident(name),
		type_params = [],
		variants = variants.map(func(variant_name): {
				name = ident(variant_name),
				fields = [],
				span = source_span()
			}),
		is_enum = False,
		doc = None,
		span = source_span(),
	})


pure func union_decl_with_variant_fields(
	name: String,
	variant_name: String,
	field_types: List[ParsedTypeExpr],
) -> ParsedDecl:
	UnionParsedDecl({
		name = ident(name),
		type_params = [],
		variants = [
			{
				name = ident(variant_name),
				fields = field_types,
				span = source_span()
			},
		],
		is_enum = False,
		doc = None,
		span = source_span(),
	})


pure func result_union_decl() -> ParsedDecl:
	UnionParsedDecl({
		name = ident("Result"),
		type_params = [type_param("T"), type_param("E")],
		variants = [
			{
				name = ident("Ok"),
				fields = [named_type("T")],
				span = source_span()
			},
			{
				name = ident("Err"),
				fields = [named_type("E")],
				span = source_span()
			},
		],
		is_enum = False,
		doc = None,
		span = source_span(),
	})


pure func enum_decl(
	name: String,
	type_params: List[ParsedTypeParamDecl],
	variant_field_types: List[ParsedTypeExpr],
) -> ParsedDecl:
	UnionParsedDecl({
		name = ident(name),
		type_params = type_params,
		variants = [
			{
				name = ident("Case"),
				fields = variant_field_types,
				span = source_span()
			},
		],
		is_enum = True,
		doc = None,
		span = source_span(),
	})


pure func builtin_type_decl(name: String, is_resource: Bool) -> ParsedDecl:
	BuiltinTypeParsedDecl({
		name = ident(name),
		type_params = [],
		is_resource = is_resource,
		cleanup = None,
		doc = None,
		span = source_span(),
	})


pure func builtin_resource_type_decl_with_cleanup(
	name: String,
	cleanup_function: String,
) -> ParsedDecl:
	BuiltinTypeParsedDecl({
		name = ident(name),
		type_params = [],
		is_resource = True,
		cleanup = Some({
			builtin_name = cleanup_function,
			span = source_span(),
		}),
		doc = None,
		span = source_span(),
	})


pure func type_alias_decl(name: String, is_opaque: Bool) -> ParsedDecl:
	TypeAliasParsedDecl({
		name = ident(name),
		type_params = [],
		target = int_type(),
		is_opaque = is_opaque,
		doc = None,
		span = source_span(),
	})


pure func type_alias_decl_with_target(name: String, target: ParsedTypeExpr) -> ParsedDecl:
	TypeAliasParsedDecl({
		name = ident(name),
		type_params = [],
		target = target,
		is_opaque = False,
		doc = None,
		span = source_span(),
	})


pure func generic_type_alias_decl(
	name: String,
	type_param_name: String,
	target: ParsedTypeExpr,
) -> ParsedDecl:
	TypeAliasParsedDecl({
		name = ident(name),
		type_params = [type_param(type_param_name)],
		target = target,
		is_opaque = False,
		doc = None,
		span = source_span(),
	})


pure func trait_decl(name: String) -> ParsedDecl:
	TraitParsedDecl({
		name = ident(name),
		type_params = [],
		supertraits = [],
		methods = [],
		doc = None,
		span = source_span(),
	})


pure func impl_decl_with_methods(
	trait_name: String,
	for_type: ParsedTypeExpr,
	methods: List[ParsedFunctionDecl],
) -> ParsedDecl:
	ImplParsedDecl({
		trait_name = ident(trait_name),
		for_type = for_type,
		methods = methods,
		doc = None,
		span = source_span(),
	})


pure func impl_decl_with_methods_at(
	trait_name: String,
	for_type: ParsedTypeExpr,
	methods: List[ParsedFunctionDecl],
	offset: Int,
) -> ParsedDecl:
	match impl_decl_with_methods(trait_name, for_type, methods):
		ImplParsedDecl(impl_decl):
			ImplParsedDecl({ impl_decl | span = source_span_at(offset) })
		other:
			other


pure func foreign_block_visibility_decl(function_name: String, is_private: Bool) -> ParsedDecl:
	ForeignBlockParsedDecl(
		[],
		[
			{
				name = ident(function_name),
				params = [],
				return_type = int_type(),
				c_name = None,
				is_pure = False,
				is_private = is_private,
				annotations = [],
				span = source_span()
			},
		],
		source_span(),
	)


pure func foreign_block_decl(function_name: String) -> ParsedDecl:
	foreign_block_visibility_decl(function_name, False)


pure func foreign_block_with_metadata_decl() -> ParsedDecl:
	args: List[ParsedForeignBlockArg] = [
		{
			name = ident("include"),
			value = "native.h",
			span = source_span()
		},
		{
			name = ident("link_linux"),
			value = "-ldl",
			span = source_span()
		},
	]
	ForeignBlockParsedDecl(
		args,
		[
			{
				name = ident("mutate"),
				params = [],
				return_type = int_type(),
				c_name = Some("native_mutate"),
				is_pure = False,
				is_private = False,
				annotations = [],
				span = source_span()
			},
			{
				name = ident("inspect"),
				params = [],
				return_type = int_type(),
				c_name = None,
				is_pure = False,
				is_private = False,
				annotations = [ParsedNoCopyAnnotation],
				span = source_span()
			},
		],
		source_span(),
	)


pure func import_symbol(
	name: String,
	symbol_alias: Option[String],
	constructors: List[String],
) -> ParsedImportSymbol:
	{
		name = ident(name),
		symbol_alias = symbol_alias.map(func(alias_name): ident(alias_name)),
		constructors = constructors.map(func(constructor_name): ident(constructor_name)),
		span = source_span()
	}


pure func import_decl(
	module_path: String,
	module_alias: Option[String],
	symbols: Option[List[ParsedImportSymbol]],
) -> ParsedImportDecl:
	{
		module_path = module_path,
		module_alias = module_alias.map(func(alias_name): ident(alias_name)),
		symbols = symbols,
		span = source_span()
	}


pure func import_block_decl(imports: List[ParsedImportDecl]) -> ParsedDecl:
	ImportBlockParsedDecl(imports, source_span())


pure func program(decls: List[ParsedDecl]) -> ParsedProgram:
	{
		source = source_file(),
		decls = decls,
		diagnostics = []
	}


private pure func reserved_state_without_program_definitions(
	source_program: ParsedProgram,
) -> CompilerTypecheckState:
	empty_program = { source_program | decls = [] }
	candidate = compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver(
			source_program.source.module_name,
			CompilerUserModule,
		),
		finalized_typecheck_program(empty_program),
	)

	match compiler_indexed_graph_build(candidate, []):
		Err(_):
			compiler_typecheck_state_empty()
		Ok(graph):
			compiler_typecheck_state_enter_prepared_module_scope(
				compiler_typecheck_state_empty(),
				compiler_indexed_graph_target_scope(graph),
			)


pure func importable_surface(
	module_path: String,
	decls: List[ParsedDecl],
) -> CompilerImportableModuleSurface:
	compiler_importable_module_surface(
		module_path,
		CompilerStdlibModule,
		module_surface_for_program(program(decls)),
	)


private pure func program_for_module(module_path: String, decls: List[ParsedDecl]) -> ParsedProgram:
	base_program = program(decls)
	{ base_program |
		source = compiler_source_file(
			base_program.source.path,
			module_path,
			base_program.source.text,
		)
	}


pure func importable_modules_with_origin(
	module_path: String,
	decls: List[ParsedDecl],
	origin: CompilerModuleOrigin,
) -> List[CompilerImportableModule]:
	module_program = program_for_module(module_path, decls)
	candidate = compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver(module_path, origin),
		finalized_typecheck_program(module_program),
	)

	match compiler_indexed_graph_build(candidate, []):
		Err(_):
			[]
		Ok(graph):
			[compiler_importable_module(compiler_indexed_graph_target_scope(graph))]


pure func importable_modules(
	module_path: String,
	decls: List[ParsedDecl],
) -> List[CompilerImportableModule]:
	importable_modules_with_origin(module_path, decls, CompilerSourcePackageModule("test"))


private pure func importable_type_decl_name(decl: CompilerImportableTypeDecl) -> String:
	match decl:
		CompilerImportableRecordDecl(record_decl):
			record_decl.name.text
		CompilerImportableUnionDecl(union_decl):
			union_decl.name.text
		CompilerImportableBuiltinTypeDecl(type_decl):
			type_decl.name.text
		CompilerImportableTypeAliasDecl(alias_decl):
			alias_decl.name.text


private pure func importable_signature_decl_name(decl: CompilerImportableSignatureDecl) -> String:
	match decl:
		CompilerImportableFunctionDecl(function_decl):
			function_decl.name.text
		CompilerImportableVarDecl(var_decl):
			var_decl.name.text
		CompilerImportableForeignFunctionDecl(function_decl):
			function_decl.name.text
		CompilerImportableTraitDecl(trait_decl):
			trait_decl.name.text


func test_importable_module_precomputes_interface_facts() -> Bool:
	modules = importable_modules(
		"types",
		[
			import_block_decl([import_decl("dep", None, None)]),
			record_decl("Widget"),
			union_decl(
				"MaybeWidget",
				["Present", "Missing"],
			),
			builtin_type_decl("BuiltinThing", False),
			type_alias_decl("WidgetId", False),
			function_decl("make_widget"),
			var_decl("default_widget_id"),
			foreign_block_decl("native_widget_id"),
			foreign_block_visibility_decl("hidden_native_widget_id", True),
			trait_decl("Display"),
			impl_decl_with_methods("Display", int_type(), []),
			PrivateParsedDecl(record_decl("HiddenWidget"), source_span()),
			PrivateParsedDecl(function_decl("hidden_widget"), source_span()),
		],
	)

	match modules.get(0):
		None:
			False
		Some(module):
			local_type_names = compiler_importable_module_local_type_names(module)
			declared_imports = compiler_importable_module_declared_imports(module)
			type_decls = compiler_importable_module_type_decls(module)
			signature_decls = compiler_importable_module_signature_decls(module)
			impl_decls = compiler_importable_module_impl_decls(module)

			(
				local_type_names == [
					"BuiltinThing",
					"HiddenWidget",
					"MaybeWidget",
					"Widget",
					"WidgetId",
				]
				and declared_imports.length() == 1
				and declared_imports
					.get(0)
					.map(func(imported): imported.module_path) == Some("dep")
				and type_decls.map(
					importable_type_decl_name,
				) == ["Widget", "MaybeWidget", "BuiltinThing", "WidgetId"]
				and signature_decls.map(
					importable_signature_decl_name,
				) == ["make_widget", "default_widget_id", "native_widget_id", "Display"]
				and impl_decls.map(func(impl_decl): impl_decl.trait_name.text) == ["Display"]
			)


func test_prescan_collects_top_level_names_and_resources() -> Bool:
	state = compiler_typecheck_prescan_program(
		compiler_typecheck_state_empty(),
		program([
			record_decl("Widget"),
			union_decl(
				"Maybe",
				["Just", "Nothing"],
			),
			builtin_type_decl("Reader", True),
			type_alias_decl("WidgetId", False),
			function_decl("main"),
			var_decl("answer"),
			trait_decl("Display"),
		]),
	)

	(
		compiler_typecheck_state_has_known_type_name(state, "Widget")
		and compiler_typecheck_state_has_known_type_name(state, "Maybe")
		and compiler_typecheck_state_has_known_type_name(state, "Reader")
		and compiler_typecheck_state_has_known_type_name(state, "WidgetId")
		and compiler_typecheck_state_has_known_resource_type_name(state, "Reader")
		and compiler_typecheck_state_find_top_level_name(
			state,
			"Widget",
		) == Some(CompilerTopLevelType)
		and compiler_typecheck_state_find_top_level_name(
			state,
			"Just",
		) == Some(CompilerTopLevelConstructor)
		and compiler_typecheck_state_find_top_level_name(
			state,
			"Nothing",
		) == Some(CompilerTopLevelConstructor)
		and compiler_typecheck_state_find_top_level_name(
			state,
			"main",
		) == Some(CompilerTopLevelFunction)
		and compiler_typecheck_state_find_top_level_name(
			state,
			"answer",
		) == Some(CompilerTopLevelVariable)
		and compiler_typecheck_state_find_top_level_name(
			state,
			"Display",
		) == Some(CompilerTopLevelTrait)
	)


func test_prescan_recurses_private_and_keeps_first_namespace_kind() -> Bool:
	state = compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), program([
			function_decl("Thing"),
			PrivateParsedDecl(record_decl("Thing"), source_span()),
		]))

	(
		compiler_typecheck_state_has_known_type_name(state, "Thing")
		and compiler_typecheck_state_find_top_level_name(
			state,
			"Thing",
		) == Some(CompilerTopLevelFunction)
	)


func test_prescan_records_foreign_block_functions() -> Bool:
	state = compiler_typecheck_prescan_program(
		compiler_typecheck_state_empty(),
		program([foreign_block_decl("native_hash")]),
	)

	compiler_typecheck_state_find_top_level_name(
		state,
		"native_hash",
	) == Some(CompilerTopLevelFunction)


func test_register_imports_records_qualified_module_alias() -> Bool:
	source_program = program([import_block_decl([
			import_decl("std/file", Some("File"), None),
			import_decl("json", None, None),
		])])
	state = compiler_typecheck_register_program_import_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
		source_program,
	)

	(
		compiler_typecheck_state_find_module_alias(state, "File") == Some("std/file")
		and compiler_typecheck_state_find_module_alias(state, "json") == Some("json")
		and compiler_typecheck_state_has_imported_module(state, "std/file")
		and compiler_typecheck_state_has_import_binding(state, "File", "std/file", None)
		and compiler_typecheck_state_has_import_binding(state, "json", "json", None)
	)


func test_register_imports_records_selective_symbols_and_constructors() -> Bool:
	source_program = program([
		import_block_decl([
			import_decl(
				"option",
				None,
				Some([
					import_symbol(
						"Option",
						None,
						["Some", "None"],
					),
					import_symbol("map", Some("option_map"), []),
				]),
			),
		]),
	])
	state = compiler_typecheck_register_program_import_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
		source_program,
	)

	(
		compiler_typecheck_state_has_import_binding(state, "Option", "option", Some("Option"))
		and compiler_typecheck_state_has_import_binding(state, "Some", "option", Some("Some"))
		and compiler_typecheck_state_has_import_binding(state, "None", "option", Some("None"))
		and compiler_typecheck_state_has_import_binding(state, "option_map", "option", Some("map"))
		and compiler_typecheck_state_find_module_alias(state, "option").is_none()
	)


func test_register_imports_records_combined_alias_and_symbols() -> Bool:
	source_program = program(
		[
			import_block_decl(
				[import_decl("heap", Some("H"), Some([import_symbol("Heap", None, [])]))],
			),
		],
	)
	state = compiler_typecheck_register_program_import_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
		source_program,
	)

	(
		compiler_typecheck_state_find_module_alias(state, "H") == Some("heap")
		and compiler_typecheck_state_has_import_binding(state, "H", "heap", None)
		and compiler_typecheck_state_has_import_binding(state, "Heap", "heap", Some("Heap"))
	)


func test_register_imports_reports_namespace_collisions() -> Bool:
	source_program = program([function_decl("File"), import_block_decl([
			import_decl("std/file", Some("File"), None),
			import_decl("math", None, Some([import_symbol("File", None, [])])),
		])])
	state = compiler_typecheck_register_program_import_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
		source_program,
	)

	(
		state.errors.length() == 2
		and state.errors
			.get_or(0, "")
			.contains("module alias 'File' conflicts with function 'File'")
		and state.errors
			.get_or(1, "")
			.contains("imported name 'File' conflicts with function 'File'")
	)


func test_typecheck_program_with_import_surfaces_validates_imports() -> Bool:
	modules = [importable_surface("json", [record_decl("Token")])]
	valid_program = program([
		import_block_decl([import_decl("json", None, Some([import_symbol("Token", None, [])]))]),
		function_body_decl(
			"identity",
			[named_param("value", int_type())],
			Some(int_type()),
			Some(decl_name_expr("value")),
		),
	])
	valid_result = compiler_typecheck_program_with_import_surfaces(
		compiler_typecheck_state_empty(),
		valid_program,
		modules,
	)

	(
		valid_result.state.errors.length() == 0
		and compiler_typecheck_state_has_import_binding(
			valid_result.state,
			"Token",
			"json",
			Some("Token"),
		)
		and compiler_typecheck_state_find_type_home(valid_result.state, "Token") == Some("json")
	)


func test_reachable_import_modules_exclude_current_and_unrelated_modules() -> Bool:
	source_program = program([import_block_decl([import_decl("dep", None, None)])])
	modules = importable_modules("decl", [function_decl("current_only")])
		.concat(
			importable_modules(
				"dep",
				[import_block_decl([import_decl("transitive", None, None)])],
			),
		)
		.concat(importable_modules("transitive", [function_decl("transitive_only")]))
		.concat(importable_modules("unrelated", [function_decl("unrelated_only")]))
	reachable = compiler_reachable_importable_modules_for_program(
		compiler_typecheck_state_empty(),
		source_program,
		modules,
		"decl",
	)

	(
		reachable.length() == 2
		and reachable.any(func(module): compiler_importable_module_path(module) == "dep")
		and reachable.any(func(module): compiler_importable_module_path(module) == "transitive")
		and not reachable.any(func(module): compiler_importable_module_path(module) == "decl")
		and not reachable.any(func(module):
			compiler_importable_module_path(module) == "unrelated"
		)
	)


func test_ambient_tuple_module_registers_impls_without_source_import() -> Bool:
	base_state = compiler_typecheck_state_empty()
	ambient_decls = [
		trait_decl("AmbientTupleTrait"),
		impl_decl_with_methods("AmbientTupleTrait", int_type(), []),
	]
	result = compiler_typecheck_program_with_import_modules(
		base_state,
		program([]),
		importable_modules("std/tuple", ambient_decls),
	)

	(
		result.state.errors.length() == 0
		and result.state.env.impls.length() == base_state.env.impls.length() + 1
		and result.state.env.impls.any(func(instance): instance.trait_name == "AmbientTupleTrait")
		and not compiler_typecheck_state_has_imported_module(result.state, "std/tuple")
		and compiler_typecheck_state_find_module_alias(result.state, "tuple").is_none()
	)


func test_import_modules_register_canonical_type_payloads() -> Bool:
	module_decls = [
		record_with_fields_decl("Payload", [int_type()]),
		union_decl_with_variant_fields("Message", "WithPayload", [named_type("Payload")]),
	]
	source_program = program(
		[
			import_block_decl(
				[
					import_decl(
						"model",
						None,
						Some([import_symbol("Message", None, ["WithPayload"])]),
					),
				],
			),
		],
	)
	result = compiler_typecheck_program_with_import_modules(
		compiler_typecheck_state_empty(),
		source_program,
		importable_modules("model", module_decls),
	)
	canonical_message = compiler_canonical_module_type_name("model", "Message")
	canonical_payload = compiler_canonical_module_type_name("model", "Payload")

	match (
		compiler_env_get_type_decl(result.state.env, canonical_message),
		compiler_env_get_record(result.state.env, canonical_payload),
		compiler_env_get_alias(result.state.env, "Message"),
		compiler_env_get_alias(result.state.env, "Payload"),
	):
		(Some((_, variants)), Some(_), Some((_, CompilerNamedType(alias_target, _))), None):
			match variants.get(0):
				Some(variant):
					match variant.fields.get(0):
						Some(CompilerNamedType(payload_name, _)):
							(
								result.state.errors.length() == 0
								and alias_target == canonical_message
								and payload_name == canonical_payload
							)
						_:
							False
				None:
					False
		_:
			False


func test_import_modules_register_canonical_signature_types() -> Bool:
	module_decls = [
		record_with_fields_decl("Token", [int_type()]),
		function_body_decl_with_purity(
			"make_token",
			[],
			Some(named_type("Token")),
			Some(int_expr()),
			True,
		),
		function_body_decl_with_purity(
			"use_token",
			[named_param("token", named_type("Token"))],
			Some(named_type("Token")),
			Some(decl_name_expr("token")),
			True,
		),
		var_body_decl("default_token", Some(named_type("Token")), int_expr()),
	]
	source_program = program([import_block_decl([import_decl("model", None, Some([
					import_symbol("Token", None, []),
					import_symbol("make_token", None, []),
					import_symbol("use_token", None, []),
					import_symbol("default_token", None, []),
				]))])])
	result = compiler_typecheck_program_with_import_modules(
		compiler_typecheck_state_empty(),
		source_program,
		importable_modules("model", module_decls),
	)
	canonical_token = compiler_canonical_module_type_name("model", "Token")
	expected_token = CompilerNamedType(canonical_token, [])

	match (
		compiler_env_get_func_info(result.state.env, "make_token"),
		compiler_env_get_func_info(result.state.env, "use_token"),
		compiler_env_get_var_type(result.state.env, "default_token"),
	):
		(Some((make_type, _, _)), Some((use_type, _, _)), Some(var_type)):
			result.state.errors.length() == 0 and compiler_types_equal(
				make_type,
				CompilerFunctionType(True, [], expected_token),
			) and compiler_types_equal(
				use_type,
				CompilerFunctionType(True, [expected_token], expected_token),
			) and compiler_types_equal(var_type, expected_token)
		_:
			False


func test_imported_explicit_type_param_shadows_module_alias() -> Bool:
	module_decls = [type_alias_decl_with_target(
			"Callback",
			function_type(False, [int_type()], int_type()),
		), generic_function_body_decl(
			"identity",
			[type_param("Callback")],
			[named_param("value", named_type("Callback"))],
			Some(named_type("Callback")),
			Some(decl_name_expr("value")),
			True,
		)]
	source_program = program(
		[
			import_block_decl(
				[import_decl("model", None, Some([import_symbol("identity", None, [])]))],
			),
		],
	)
	result = compiler_typecheck_program_with_import_modules(
		compiler_typecheck_state_empty(),
		source_program,
		importable_modules("model", module_decls),
	)
	type_param = CompilerTypeVar("Callback")

	match compiler_env_get_func_info(result.state.env, "identity"):
		Some((func_type, _, _)):
			result.state.errors.length() == 0 and compiler_types_equal(
				func_type,
				CompilerFunctionType(True, [type_param], type_param),
			)
		None:
			False


func test_current_module_signatures_canonicalize_qualified_import_types() -> Bool:
	tcp_decls = [union_decl("TcpError", ["Closed"])]
	source_program = program([
		import_block_decl([import_decl("net/tcp", Some("TCP"), None)]),
		function_body_decl_with_purity(
			"keep_error",
			[named_param("error", named_type("TCP.TcpError"))],
			Some(named_type("TCP.TcpError")),
			Some(decl_name_expr("error")),
			True,
		),
	])
	result = compiler_typecheck_program_with_import_modules(
		compiler_typecheck_state_empty(),
		source_program,
		importable_modules("std/net/tcp", tcp_decls),
	)
	canonical_error = CompilerNamedType(
		compiler_canonical_module_type_name("std/net/tcp", "TcpError"),
		[],
	)

	match compiler_env_get_func_info(result.state.env, "keep_error"):
		Some((func_type, _, _)):
			result.state.errors.length() == 0 and compiler_types_equal(
				func_type,
				CompilerFunctionType(True, [canonical_error], canonical_error),
			)
		None:
			False


func test_import_modules_preserve_tensor_loop_producer() -> Bool:
	vector_type = ParsedArrayType(
		int_type(),
		[ParsedDimLiteralType("4", source_span())],
		source_span(),
	)
	module_decls = [
		function_body_decl_with_purity(
			"windows",
			[named_param("values", vector_type), named_param("size", int_type())],
			Some(ParsedNamedType(ident("List"), [int_type()], source_span())),
			Some(
				ParsedBlockExpr(
					[ParsedBuiltinExpr(Some("std/tensor.windows"), source_span())],
					source_span(),
				),
			),
			True,
		),
	]
	source_program = program(
		[
			import_block_decl(
				[import_decl("tensor", None, Some([import_symbol("windows", None, [])]))],
			),
		],
	)
	result = compiler_typecheck_program_with_import_modules(
		compiler_typecheck_state_empty(),
		source_program,
		importable_modules_with_origin("tensor", module_decls, CompilerStdlibModule),
	)

	match compiler_env_get_module_func_symbol(result.state.env, "tensor", "windows"):
		Some(symbol):
			match symbol.loop_producer:
				Some(producer):
					(
						result.state.errors.length() == 0
						and compiler_loop_producer_is_windows(producer)
					)
				None:
					False
		None:
			False


func test_imported_tensor_loop_producer_reaches_typed_for() -> Bool:
	vector_type = ParsedArrayType(
		int_type(),
		[ParsedDimLiteralType("4", source_span())],
		source_span(),
	)
	module_decls = [
		function_body_decl_with_purity(
			"windows",
			[named_param("values", vector_type), named_param("size", int_type())],
			Some(ParsedNamedType(ident("List"), [int_type()], source_span())),
			Some(
				ParsedBlockExpr(
					[ParsedBuiltinExpr(Some("std/tensor.windows"), source_span())],
					source_span(),
				),
			),
			True,
		),
	]
	source_program = program([
		import_block_decl(
			[import_decl("tensor", None, Some([import_symbol("windows", None, [])]))],
		),
		function_body_decl_with_purity(
			"consume",
			[named_param("values", vector_type)],
			Some(named_type("Void")),
			Some(
				ParsedForExpr(
					ParsedForNameBinder(ident("window")),
					ParsedCallExpr(
						ParsedNameExpr(ident("windows")),
						[ParsedNameExpr(ident("values")), int_expr()],
						source_span(),
					),
					ParsedVoidExpr(source_span()),
					source_span(),
				),
			),
			True,
		),
	])
	result = compiler_typecheck_program_with_import_modules(
		compiler_typecheck_state_empty(),
		source_program,
		importable_modules_with_origin("tensor", module_decls, CompilerStdlibModule),
	)

	match result.program.decls.get(1):
		Some(CompilerTypedFunctionDecl(info)):
			match info.body:
				Some(CompilerTypedForExpr(_, _, Some(CompilerTypedWindowsLoopView(_, _)), _, _, _)):
					result.state.errors.length() == 0
				_:
					False
		_:
			False


func test_import_modules_resolve_import_aliases_to_loaded_module_path() -> Bool:
	module_decls = [
		RecordParsedDecl({
			name = ident("Cursor"),
			type_params = [],
			fields = [
				field_decl("offset", int_type()),
				field_decl("line", int_type()),
				field_decl("column", int_type()),
			],
			is_struct = False,
			doc = None,
			span = source_span(),
		}),
		function_body_decl_with_purity(
			"make_span",
			[
				named_param("start", named_type("Cursor")),
				named_param("finish", named_type("Cursor")),
			],
			Some(named_type("Cursor")),
			Some(decl_name_expr("start")),
			True,
		),
	]
	source_program = program([
		import_block_decl([import_decl("parser", None, Some([
					import_symbol("Cursor", None, []),
					import_symbol("make_span", None, []),
				]))]),
		function_body_decl_with_purity(
			"identity_cursor",
			[named_param("cursor", named_type("Cursor"))],
			Some(named_type("Cursor")),
			Some(
				decl_call_expr(
					"make_span",
					[decl_name_expr("cursor"), decl_name_expr("cursor")],
				),
			),
			True,
		),
		function_body_decl_with_purity(
			"literal_cursor",
			[],
			Some(named_type("Cursor")),
			Some(decl_record_expr([
				decl_record_field("offset", int_expr()),
				decl_record_field("line", int_expr()),
				decl_record_field("column", int_expr()),
			])),
			True,
		),
		RecordParsedDecl({
			name = ident("CursorBox"),
			type_params = [],
			fields = [field_decl("cursor", named_type("Cursor"))],
			is_struct = False,
			doc = None,
			span = source_span(),
		}),
		function_body_decl_with_purity(
			"box_cursor",
			[named_param("cursor", named_type("Cursor"))],
			Some(named_type("CursorBox")),
			Some(decl_record_expr([decl_record_field("cursor", decl_name_expr("cursor"))])),
			True,
		),
	])
	result = compiler_typecheck_program_with_import_modules(
		compiler_typecheck_state_empty(),
		source_program,
		importable_modules("std/parser", module_decls),
	)
	canonical_cursor = compiler_canonical_module_type_name("std/parser", "Cursor")

	match (
		compiler_env_get_alias(result.state.env, "Cursor"),
		compiler_env_get_record(result.state.env, "CursorBox"),
	):
		(Some((_, CompilerNamedType(alias_target, _))), Some((_, fields))):
			match fields.get(0):
				Some(field):
					match field.field_type:
						CompilerNamedType(field_type_name, _):
							(
								result.state.errors.length() == 0
								and alias_target == canonical_cursor
								and field_type_name == canonical_cursor
							)
						_:
							False
				None:
					False
		_:
			False


func test_import_modules_canonicalize_dependency_types_inside_imported_decls() -> Bool:
	source_decls = [record_with_fields_decl("Span", [int_type()])]
	ast_decls = [
		import_block_decl([import_decl("source", None, Some([import_symbol("Span", None, [])]))]),
		record_with_fields_decl("Node", [named_type("Span")]),
		union_decl_with_variant_fields("Expr", "WithSpan", [named_type("Span")]),
	]
	source_program = program([import_block_decl([import_decl("ast", None, Some([
					import_symbol("Node", None, []),
					import_symbol("Expr", None, ["WithSpan"]),
				]))])])
	result = compiler_typecheck_program_with_import_modules(
		compiler_typecheck_state_empty(),
		source_program,
		importable_modules("source", source_decls).concat(importable_modules("ast", ast_decls)),
	)
	canonical_span = compiler_canonical_module_type_name("source", "Span")
	canonical_node = compiler_canonical_module_type_name("ast", "Node")
	canonical_expr = compiler_canonical_module_type_name("ast", "Expr")

	match (
		compiler_env_get_record(result.state.env, canonical_node),
		compiler_env_get_type_decl(result.state.env, canonical_expr),
	):
		(Some((_, fields)), Some((_, variants))):
			record_ok = match fields.get(0):
				Some(field):
					match field.field_type:
						CompilerNamedType(type_name, _):
							type_name == canonical_span
						_:
							False
				None:
					False

			variant_ok = match variants.get(0):
				Some(variant):
					match variant.fields.get(0):
						Some(CompilerNamedType(type_name, _)):
							type_name == canonical_span
						_:
							False
				None:
					False

			result.state.errors.length() == 0 and record_ok and variant_ok
		_:
			False


