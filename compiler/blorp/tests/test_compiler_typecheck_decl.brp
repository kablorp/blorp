import:
	../compiler_context: CompilerModuleOrigin(CompilerSourcePackageModule)
	../compiler_env:
		CompilerFuncOrigin(CompilerForeignFunc, CompilerUserDefinedFunc),
		CompilerPurity(CompilerImpure, CompilerPure),
		CompilerSymbolKind(CompilerFuncSymbolKind),
		CompilerTypeKind(CompilerTypeEnum, CompilerTypeResource),
		compiler_env_get_alias,
		compiler_env_get_constructor,
		compiler_env_get_func_callable_id,
		compiler_env_get_func_info,
		compiler_env_get_function_trait,
		compiler_env_get_opaque_alias,
		compiler_env_get_record,
		compiler_env_get_trait,
		compiler_env_get_type_contains_resource,
		compiler_env_get_type_decl,
		compiler_env_get_type_kind,
		compiler_env_get_var_type,
		compiler_env_lookup,
	../compiler_parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedExpr(ParsedIntLiteralExpr),
		ParsedFieldDecl,
		ParsedFunctionAnnotation(ParsedDebugOnlyAnnotation),
		ParsedIdentifier,
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder, ParsedParamWildcardBinder),
		ParsedProgram,
		ParsedTraitMethodDecl,
		ParsedTypeExpr(ParsedNamedType),
		ParsedTypeParamDecl,
		parsed_identifier,
	../compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../compiler_type:
		CompilerType(CompilerFunctionType),
		compiler_type_bool,
		compiler_type_int,
		compiler_type_string,
		compiler_type_void,
		compiler_types_equal,
	../compiler_typecheck_decl:
		compiler_typecheck_prescan_program,
		compiler_typecheck_register_program_signature_decls,
		compiler_typecheck_register_program_type_decls,
	../compiler_typecheck_state:
		CompilerTopLevelNameKind(
			CompilerTopLevelConstructor,
			CompilerTopLevelFunction,
			CompilerTopLevelTrait,
			CompilerTopLevelType,
			CompilerTopLevelVariable,
		),
		compiler_typecheck_state_empty,
		compiler_typecheck_state_find_top_level_name,
		compiler_typecheck_state_find_type_home,
		compiler_typecheck_state_for_origin,
		compiler_typecheck_state_has_known_resource_type_name,
		compiler_typecheck_state_has_known_type_name,
		compiler_typecheck_state_stdlib,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("decl.brp", "decl", "func main(): 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func int_type() -> ParsedTypeExpr:
	ParsedNamedType(ident("Int"), [], source_span())


pure func int_expr() -> ParsedExpr:
	ParsedIntLiteralExpr("1", source_span())


pure func bool_type() -> ParsedTypeExpr:
	ParsedNamedType(ident("Bool"), [], source_span())


pure func string_type() -> ParsedTypeExpr:
	ParsedNamedType(ident("String"), [], source_span())


pure func named_param(name: String, type_expr: ParsedTypeExpr) -> ParsedParam:
	{
		binder = ParsedParamNameBinder(ident(name)),
		type_expr = Some(type_expr),
		span = source_span()
	}


pure func wildcard_param(type_expr: ParsedTypeExpr) -> ParsedParam:
	{
		binder = ParsedParamWildcardBinder(source_span()),
		type_expr = Some(type_expr),
		span = source_span()
	}


pure func untyped_named_param(name: String) -> ParsedParam:
	{
		binder = ParsedParamNameBinder(ident(name)),
		type_expr = None,
		span = source_span()
	}


pure func trait_method_decl(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	is_pure: Bool,
	has_default: Bool,
) -> ParsedTraitMethodDecl:
	body: Option[ParsedExpr] = if has_default:
		Some(int_expr())
	else:
		None

	{
		name = ident(name),
		params = params,
		return_type = return_type,
		body = body,
		is_pure = is_pure,
		span = source_span()
	}


pure func trait_decl_with_methods(
	name: String,
	type_params: List[ParsedTypeParamDecl],
	supertraits: List[String],
	methods: List[ParsedTraitMethodDecl],
) -> ParsedDecl:
	TraitParsedDecl({
		name = ident(name),
		type_params = type_params,
		supertraits = supertraits.map(func(supertrait): ident(supertrait)),
		methods = methods,
		doc = None,
		span = source_span(),
	})


pure func function_decl(name: String) -> ParsedDecl:
	FunctionParsedDecl({
		name = ident(name),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = Some(int_expr()),
		is_pure = False,
		annotations = [],
		doc = None,
		span = source_span(),
	})


pure func function_signature_decl(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
) -> ParsedDecl:
	FunctionParsedDecl({
		name = ident(name),
		type_params = [type_param("T")],
		params = params,
		return_type = return_type,
		dim_constraints = [],
		body = Some(int_expr()),
		is_pure = is_pure,
		annotations = annotations,
		doc = None,
		span = source_span(),
	})


pure func var_decl(name: String) -> ParsedDecl:
	VarParsedDecl({
		name = ident(name),
		type_expr = Some(int_type()),
		value = int_expr(),
		is_mutable = False,
		span = source_span(),
	})


pure func record_decl(name: String) -> ParsedDecl:
	RecordParsedDecl({
		name = ident(name),
		type_params = [],
		fields = [],
		is_struct = False,
		doc = None,
		span = source_span(),
	})


pure func field_decl(name: String, type_expr: ParsedTypeExpr) -> ParsedFieldDecl:
	{
		name = ident(name),
		type_expr = type_expr,
		span = source_span()
	}


pure func type_param(name: String) -> ParsedTypeParamDecl:
	{
		name = ident(name),
		bounds = [],
		span = source_span()
	}


pure func record_with_fields_decl(name: String, field_types: List[ParsedTypeExpr]) -> ParsedDecl:
	RecordParsedDecl({
		name = ident(name),
		type_params = [],
		fields = field_types.map(func(type_expr): field_decl("field", type_expr)),
		is_struct = False,
		doc = None,
		span = source_span(),
	})


pure func struct_decl(
	name: String,
	type_params: List[ParsedTypeParamDecl],
	fields: List[ParsedTypeExpr],
) -> ParsedDecl:
	RecordParsedDecl({
		name = ident(name),
		type_params = type_params,
		fields = fields.map(func(type_expr): field_decl("field", type_expr)),
		is_struct = True,
		doc = None,
		span = source_span(),
	})


pure func union_decl(name: String, variants: List[String]) -> ParsedDecl:
	UnionParsedDecl({
		name = ident(name),
		type_params = [],
		variants = variants.map(func(variant_name): {
				name = ident(variant_name),
				fields = [],
				span = source_span()
			}),
		is_enum = False,
		doc = None,
		span = source_span(),
	})


pure func enum_decl(
	name: String,
	type_params: List[ParsedTypeParamDecl],
	variant_field_types: List[ParsedTypeExpr],
) -> ParsedDecl:
	UnionParsedDecl({
		name = ident(name),
		type_params = type_params,
		variants = [
			{
				name = ident("Case"),
				fields = variant_field_types,
				span = source_span()
			},
		],
		is_enum = True,
		doc = None,
		span = source_span(),
	})


pure func builtin_type_decl(name: String, is_resource: Bool) -> ParsedDecl:
	BuiltinTypeParsedDecl({
		name = ident(name),
		type_params = [],
		is_resource = is_resource,
		cleanup = None,
		doc = None,
		span = source_span(),
	})


pure func type_alias_decl(name: String, is_opaque: Bool) -> ParsedDecl:
	TypeAliasParsedDecl({
		name = ident(name),
		type_params = [],
		target = int_type(),
		is_opaque = is_opaque,
		doc = None,
		span = source_span(),
	})


pure func trait_decl(name: String) -> ParsedDecl:
	TraitParsedDecl({
		name = ident(name),
		type_params = [],
		supertraits = [],
		methods = [],
		doc = None,
		span = source_span(),
	})


pure func foreign_block_decl(function_name: String) -> ParsedDecl:
	ForeignBlockParsedDecl(
		[],
		[
			{
				name = ident(function_name),
				params = [],
				return_type = int_type(),
				c_name = None,
				is_pure = False,
				is_private = False,
				annotations = [],
				span = source_span()
			},
		],
		source_span(),
	)


pure func program(decls: List[ParsedDecl]) -> ParsedProgram:
	{
		source = source_file(),
		decls = decls,
		diagnostics = []
	}


func test_prescan_collects_top_level_names_and_resources() -> Bool:
	state = compiler_typecheck_prescan_program(
		compiler_typecheck_state_empty(),
		program([
			record_decl("Widget"),
			union_decl(
				"Maybe",
				["Just", "Nothing"],
			),
			builtin_type_decl("Reader", True),
			type_alias_decl("WidgetId", False),
			function_decl("main"),
			var_decl("answer"),
			trait_decl("Display"),
		]),
	)

	(
		compiler_typecheck_state_has_known_type_name(state, "Widget")
		and compiler_typecheck_state_has_known_type_name(state, "Maybe")
		and compiler_typecheck_state_has_known_type_name(state, "Reader")
		and compiler_typecheck_state_has_known_type_name(state, "WidgetId")
		and compiler_typecheck_state_has_known_resource_type_name(state, "Reader")
		and compiler_typecheck_state_find_top_level_name(
			state,
			"Widget",
		) == Some(CompilerTopLevelType)
		and compiler_typecheck_state_find_top_level_name(
			state,
			"Just",
		) == Some(CompilerTopLevelConstructor)
		and compiler_typecheck_state_find_top_level_name(
			state,
			"Nothing",
		) == Some(CompilerTopLevelConstructor)
		and compiler_typecheck_state_find_top_level_name(
			state,
			"main",
		) == Some(CompilerTopLevelFunction)
		and compiler_typecheck_state_find_top_level_name(
			state,
			"answer",
		) == Some(CompilerTopLevelVariable)
		and compiler_typecheck_state_find_top_level_name(
			state,
			"Display",
		) == Some(CompilerTopLevelTrait)
	)


func test_prescan_recurses_private_and_keeps_first_namespace_kind() -> Bool:
	state = compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), program([
			function_decl("Thing"),
			PrivateParsedDecl(record_decl("Thing"), source_span()),
		]))

	(
		compiler_typecheck_state_has_known_type_name(state, "Thing")
		and compiler_typecheck_state_find_top_level_name(
			state,
			"Thing",
		) == Some(CompilerTopLevelFunction)
	)


func test_prescan_records_foreign_block_functions() -> Bool:
	state = compiler_typecheck_prescan_program(
		compiler_typecheck_state_empty(),
		program([foreign_block_decl("native_hash")]),
	)

	compiler_typecheck_state_find_top_level_name(
		state,
		"native_hash",
	) == Some(CompilerTopLevelFunction)


func test_registers_type_record_alias_and_constructors() -> Bool:
	source_program = program([
		union_decl(
			"Maybe",
			["Some", "None"],
		),
		record_with_fields_decl("Point", [int_type()]),
		type_alias_decl("UserId", False),
	])
	state = compiler_typecheck_register_program_type_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
		source_program,
	)

	match (
		compiler_env_get_type_decl(state.env, "Maybe"),
		compiler_env_get_constructor(state.env, "Some"),
		compiler_env_get_record(state.env, "Point"),
		compiler_env_get_alias(state.env, "UserId"),
	):
		(Some((_, variants)), Some((parent, _, fields, tag)), Some((_, record_fields)), Some((_, alias_target))):
			(
				variants.length() == 2
				and parent == "Maybe"
				and fields.length() == 0
				and tag == 0
				and record_fields.length() == 1
				and compiler_types_equal(alias_target, compiler_type_int())
				and compiler_typecheck_state_find_type_home(state, "Maybe") == Some("decl")
				and compiler_typecheck_state_find_type_home(state, "Point") == Some("decl")
			)
		_:
			False


func test_registers_builtin_resource_and_resource_containing_record() -> Bool:
	source_program = program([
		builtin_type_decl("Reader", True),
		record_with_fields_decl("ReaderBox", [ParsedNamedType(ident("Reader"), [], source_span())]),
	])
	state = compiler_typecheck_register_program_type_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_stdlib(), source_program),
		source_program,
	)
	user_program = program([builtin_type_decl("Handle", False)])
	user_state = compiler_typecheck_register_program_type_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), user_program),
		user_program,
	)

	(
		state.errors.length() == 0
		and compiler_env_get_type_kind(state.env, "Reader") == Some(CompilerTypeResource)
		and compiler_env_get_type_contains_resource(state.env, "ReaderBox")
		and compiler_typecheck_state_has_known_resource_type_name(state, "Reader")
		and user_state.errors.length() == 1
		and user_state.errors
			.get_or(0, "")
			.contains("can only be used in the standard library")
	)


func test_registers_struct_and_enum_boundary_errors() -> Bool:
	source_program = program([
		struct_decl("Empty", [type_param("T")], []),
		enum_decl("Choice", [type_param("T")], [int_type()]),
	])
	state = compiler_typecheck_register_program_type_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
		source_program,
	)

	state.errors.length() == 4 and state.errors
		.get_or(0, "")
		.contains("Struct 'Empty' cannot have type parameters") and state.errors
		.get_or(1, "")
		.contains("Struct 'Empty' must have at least one field") and state.errors
		.get_or(2, "")
		.contains("Enum 'Choice' cannot have type parameters") and state.errors
		.get_or(3, "")
		.contains(
			"Enum variant 'Case' cannot have fields",
		) and compiler_env_get_type_kind(
		state.env,
		"Choice",
	) == Some(CompilerTypeEnum) and compiler_env_get_constructor(state.env, "Case").is_some()


func test_opaque_alias_records_type_home() -> Bool:
	source_program = program([type_alias_decl("SecretId", True)])
	state = compiler_typecheck_register_program_type_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
		source_program,
	)

	match compiler_env_get_opaque_alias(state.env, "SecretId"):
		Some((_, target, home)):
			(
				compiler_types_equal(target, compiler_type_int())
				and home == Some("decl")
				and compiler_typecheck_state_find_type_home(state, "SecretId") == Some("decl")
			)
		None:
			False


func test_registers_source_function_signature() -> Bool:
	source_program = program([
		function_signature_decl(
			"render",
			[named_param("value", int_type()), wildcard_param(string_type())],
			Some(bool_type()),
			True,
			[ParsedDebugOnlyAnnotation],
		),
	])
	state = compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
		source_program,
	)

	match compiler_env_lookup(state.env, "render"):
		Some(symbol):
			match symbol.kind:
				CompilerFuncSymbolKind(info):
					callable_ok: Bool = match compiler_env_get_func_callable_id(
						state.env,
						"render",
					):
						Some(callable_id):
							match state.func_callable_ids.get(0):
								Some(entry):
									(
										entry.key.name == "render"
										and entry.key.loc.file == Some("decl.brp")
										and entry.def_id == callable_id
									)
								None:
									False
						None:
							False

					type_param_ok: Bool = match info.type_params.get(0):
						Some(param):
							param.name == "T"
						None:
							False

					type_ok: Bool = compiler_types_equal(
						info.func_type,
						CompilerFunctionType(
							True,
							[compiler_type_int(), compiler_type_string()],
							compiler_type_bool(),
						),
					)

					names_ok: Bool = match info.param_names.get(0):
						Some(Some(first_name)):
							match info.param_names.get(1):
								Some(None):
									first_name == "value" and info.param_names.length() == 2
								_:
									False
						_:
							False

					type_params_len_ok: Bool = info.type_params.length() == 1
					purity_ok: Bool = info.purity == CompilerPure
					origin_ok: Bool = info.origin == CompilerUserDefinedFunc
					debug_ok: Bool = info.debug_only

					(
						type_ok
						and names_ok
						and type_params_len_ok
						and type_param_ok
						and purity_ok
						and origin_ok
						and debug_ok
						and callable_ok
					)
				_:
					False
		None:
			False


func test_registers_global_var_and_foreign_function_signature() -> Bool:
	source_program = program([
		var_decl("answer"),
		foreign_block_decl("native_hash"),
		function_signature_decl("unknown_return", [], None, False, []),
	])
	state = compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
		source_program,
	)

	match (
		compiler_env_get_var_type(state.env, "answer"),
		compiler_env_lookup(state.env, "native_hash"),
		compiler_env_get_func_info(state.env, "unknown_return"),
	):
		(Some(var_type), Some(symbol), Some((unknown_return_type, _, unknown_purity))):
			match symbol.kind:
				CompilerFuncSymbolKind(info):
					compiler_types_equal(var_type, compiler_type_int()) and compiler_types_equal(
						info.func_type,
						CompilerFunctionType(False, [], compiler_type_int()),
					) and info.origin == CompilerForeignFunc and info.purity == CompilerImpure and compiler_types_equal(
						unknown_return_type,
						CompilerFunctionType(False, [], compiler_type_void()),
					) and unknown_purity == CompilerImpure
				_:
					False
		_:
			False


func test_rejects_foreign_signatures_for_non_foreign_origins() -> Bool:
	source_program = program([foreign_block_decl("native_hash")])
	source_package_state = compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_prescan_program(
			compiler_typecheck_state_for_origin(CompilerSourcePackageModule("pkg/demo")),
			source_program,
		),
		source_program,
	)
	std_state = compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_stdlib(), source_program),
		source_program,
	)

	source_package_state.errors.length() == 1 and source_package_state.errors
		.get_or(0, "")
		.contains(
			"source packages",
		) and compiler_env_get_func_info(
		source_package_state.env,
		"native_hash",
	).is_some() and std_state.errors.length() == 1 and std_state.errors
		.get_or(0, "")
		.contains(
			"standard library",
		) and compiler_env_get_func_info(std_state.env, "native_hash").is_some()


func test_registers_trait_definition_and_method_bindings() -> Bool:
	source_program = program([
		trait_decl_with_methods(
			"Base",
			[],
			[],
			[
				trait_method_decl(
					"base",
					[named_param("value", int_type())],
					Some(string_type()),
					True,
					False,
				),
			],
		),
		trait_decl_with_methods(
			"Display",
			[type_param("T")],
			["Base"],
			[
				trait_method_decl(
					"display",
					[named_param("item", string_type())],
					Some(string_type()),
					False,
					True,
				),
			],
		),
	])
	state = compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
		source_program,
	)

	match (
		compiler_env_get_trait(state.env, "Display"),
		compiler_env_get_function_trait(state.env, "base"),
		compiler_env_get_function_trait(state.env, "display"),
	):
		(Some(trait_def), Some(base_trait), Some(display_trait)):
			method_ok: Bool = match trait_def.methods.get(0):
				Some(method):
					param_name_ok: Bool = match method.param_names.get(0):
						Some(Some(param_name)):
							param_name == "item"
						_:
							False

					method.name == "display" and compiler_types_equal(
						method.params.get_or(0, compiler_type_void()),
						compiler_type_string(),
					) and compiler_types_equal(
						method.return_type,
						compiler_type_string(),
					) and not method.is_pure and method.has_default and param_name_ok
				None:
					False

			type_param_ok: Bool = match trait_def.type_params.get(0):
				Some(name):
					name == "T"
				None:
					False

			(
				trait_def.supertraits == ["Base"]
				and trait_def.type_params.length() == 1
				and type_param_ok
				and method_ok
				and base_trait == "Base"
				and display_trait == "Display"
			)
		_:
			False


func test_trait_registration_reports_method_collisions_and_missing_param_types() -> Bool:
	source_program = program([
		trait_decl_with_methods(
			"One",
			[],
			[],
			[
				trait_method_decl(
					"same",
					[named_param("value", int_type())],
					Some(int_type()),
					True,
					False,
				),
			],
		),
		trait_decl_with_methods(
			"Two",
			[],
			[],
			[
				trait_method_decl(
					"same",
					[untyped_named_param("missing")],
					Some(int_type()),
					True,
					False,
				),
			],
		),
	])
	state = compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
		source_program,
	)

	state.errors.length() == 2 and state.errors
		.get_or(0, "")
		.contains("parameter 'missing' must have an explicit type") and state.errors
		.get_or(1, "")
		.contains("method 'same' is already registered under trait 'One'")


tests: TestSuite = {
	description = "Compiler typecheck declaration pre-scan",
	tests = [
		(
			"prescan collects top-level names and resources",
			test_prescan_collects_top_level_names_and_resources,
		),
		(
			"prescan recurses private and keeps first namespace kind",
			test_prescan_recurses_private_and_keeps_first_namespace_kind,
		),
		("prescan records foreign block functions", test_prescan_records_foreign_block_functions),
		(
			"registers type record alias and constructors",
			test_registers_type_record_alias_and_constructors,
		),
		(
			"registers builtin resource and resource-containing record",
			test_registers_builtin_resource_and_resource_containing_record,
		),
		(
			"registers struct and enum boundary errors",
			test_registers_struct_and_enum_boundary_errors,
		),
		("opaque alias records type home", test_opaque_alias_records_type_home),
		("registers source function signature", test_registers_source_function_signature),
		(
			"registers global var and foreign function signature",
			test_registers_global_var_and_foreign_function_signature,
		),
		(
			"rejects foreign signatures for non-foreign origins",
			test_rejects_foreign_signatures_for_non_foreign_origins,
		),
		(
			"registers trait definition and method bindings",
			test_registers_trait_definition_and_method_bindings,
