pure func test_reserved_definition_mode_rejects_missing_callable_id() -> Bool:
	source_program = program([function_decl("planned")])
	reserved_state = reserved_state_without_program_definitions(source_program)
	result = compiler_typecheck_program(reserved_state, source_program)

	(
		result.state.errors.any(
			func(
				message,
			): message.contains("missing reserved definition ID for callable 'planned'"),
		)
		and compiler_env_get_func_info(result.state.env, "planned").is_none()
	)


