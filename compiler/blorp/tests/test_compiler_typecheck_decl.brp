func test_registers_source_function_signature() -> Bool:
	source_program = program([
		function_signature_decl(
			"render",
			[named_param("value", int_type()), wildcard_param(string_type())],
			Some(bool_type()),
			True,
			[ParsedDebugOnlyAnnotation],
		),
	])
	state = compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
		source_program,
	)

	match compiler_env_lookup(state.env, "render"):
		Some(symbol):
			match symbol.kind:
				CompilerFuncSymbolKind(info):
					callable_ok: Bool = match compiler_env_get_func_callable_id(
						state.env,
						"render",
					):
						Some(callable_id):
							match compiler_typecheck_state_func_callable_bindings(
								state,
								"render",
							).get(0):
								Some(binding):
									key = binding[0]
									key_span = compiler_func_callable_key_span(key)

									(
										compiler_func_callable_key_name(key) == "render"
										and key_span.path == "decl.brp"
										and binding[1] == callable_id
									)
								None:
									False
						None:
							False

					type_param_ok: Bool = match info.type_params.get(0):
						Some(param):
							param.name == "T"
						None:
							False

					type_ok: Bool = compiler_types_equal(
						info.func_type,
						CompilerFunctionType(
							True,
							[compiler_type_int(), compiler_type_string()],
							compiler_type_bool(),
						),
					)

					names_ok: Bool = match info.param_names.get(0):
						Some(Some(first_name)):
							match info.param_names.get(1):
								Some(None):
									first_name == "value" and info.param_names.length() == 2
								_:
									False
						_:
							False

					type_params_len_ok: Bool = info.type_params.length() == 1
					purity_ok: Bool = info.purity == CompilerPure
					origin_ok: Bool = info.origin == CompilerUserDefinedFunc
					debug_ok: Bool = info.debug_only

					(
						type_ok
						and names_ok
						and type_params_len_ok
						and type_param_ok
						and purity_ok
						and origin_ok
						and debug_ok
						and callable_ok
					)
				_:
					False
		None:
			False


