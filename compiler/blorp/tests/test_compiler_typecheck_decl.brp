pure func test_direct_definition_ids_are_recorded_in_the_index() -> Bool:
	source_program = program([
		function_body_decl("render", [], Some(int_type()), Some(int_expr())),
		union_decl("Signal", ["Ready"]),
		trait_decl("Measure"),
		impl_decl_with_methods("Measure", int_type(), []),
	])
	result = compiler_typecheck_program(compiler_typecheck_state_empty(), source_program)

	(
		result.state.errors.length() == 0
		and compiler_typecheck_state_func_callable_bindings(result.state, "render").length() == 1
		and compiler_typecheck_state_source_definition_bindings_for_name(
			result.state,
			"Ready",
		).length() == 1
		and compiler_typecheck_state_source_definition_bindings_for_name(
			result.state,
			"Measure",
		).length() == 2
	)


pure func test_direct_import_constructor_ids_are_recorded_for_the_imported_module() -> Bool:
	source_program = program(
		[
			import_block_decl(
				[
					import_decl(
						"signals",
						None,
						Some([import_symbol("Signal", None, ["Ready"])]),
					),
				],
			),
		],
	)
	result = compiler_typecheck_program_with_import_modules(
		compiler_typecheck_state_empty(),
		source_program,
		importable_modules("signals", [union_decl("Signal", ["Ready"])]),
	)

	match compiler_typecheck_state_source_definition_bindings_for_name(
		result.state,
		"Ready",
	).get(0):
		None:
			False
		Some(binding):
			(
				result.state.errors.length() == 0
				and compiler_module_identity_display_name(
					compiler_source_definition_key_module_identity(binding[0]),
				) == "signals"
				and compiler_env_get_constructor(result.state.env, "Ready").is_some()
			)


pure func test_imported_module_prescan_isolated_from_target_name_indexes() -> Bool:
	source_program = program_for_module(
		"app",
		[
			import_block_decl(
				[import_decl("dep", None, Some([import_symbol("answer", None, [])]))],
			),
			function_body_decl("shared", [], Some(int_type()), Some(int_expr())),
		],
	)
	result = compiler_typecheck_program_with_import_modules(
		compiler_typecheck_state_empty(),
		source_program,
		importable_modules(
			"dep",
			[
				import_block_decl(
					[import_decl("other", None, Some([import_symbol("shared", None, [])]))],
				),
				function_body_decl("answer", [], Some(int_type()), Some(int_expr())),
			],
		).concat(
			importable_modules(
				"other",
				[function_body_decl("shared", [], Some(int_type()), Some(int_expr()))],
			),
		),
	)
	answer_binding = compiler_typecheck_state_func_callable_bindings(result.state, "answer").get(0)
	shared_bindings = compiler_typecheck_state_func_callable_bindings(result.state, "shared")

	match answer_binding:
		None:
			False
		Some(binding):
			(
				result.state.errors.length() == 0
				and shared_bindings.length() == 1
				and compiler_typecheck_state_find_top_level_name(
					result.state,
					"shared",
				) == Some(CompilerTopLevelFunction)
				and compiler_typecheck_state_find_top_level_name(result.state, "answer").is_none()
				and compiler_typecheck_state_find_imported_name(
					result.state,
					"answer",
				).map(
					func(imported): imported.module_path,
				) == Some("dep")
				and compiler_module_identity_display_name(
					compiler_func_callable_key_module_identity(binding[0]),
				) == "dep"
				and shared_bindings.any(
					func(
						shared,
					): compiler_module_identity_display_name(
						compiler_func_callable_key_module_identity(shared[0]),
					) == "app",
				)
			)


pure func test_reused_direct_state_rescopes_definition_identity() -> Bool:
	first_program = program_for_module(
		"pkg/first",
		[function_body_decl("first", [], Some(int_type()), Some(int_expr()))],
	)
	first_result = compiler_typecheck_program(compiler_typecheck_state_empty(), first_program)
	second_program = program_for_module(
		"pkg/second",
		[function_body_decl("second", [], Some(int_type()), Some(int_expr()))],
	)
	second_result = compiler_typecheck_program(first_result.state, second_program)

	match (
		compiler_typecheck_state_func_callable_bindings(second_result.state, "first").get(0),
		compiler_typecheck_state_func_callable_bindings(second_result.state, "second").get(0),
	):
		(Some(first_binding), Some(second_binding)):
			(
				second_result.state.errors.length() == 0
				and compiler_module_identity_display_name(
					compiler_func_callable_key_module_identity(first_binding[0]),
				) == "pkg/first"
				and compiler_module_identity_display_name(
					compiler_func_callable_key_module_identity(second_binding[0]),
				) == "pkg/second"
			)
		_:
			False


pure func test_reserved_graph_rejects_incompatible_module_scope_from_another_graph() -> Bool:
	target_program = program(
		[import_block_decl([import_decl("dep", None, Some([import_symbol("second", None, [])]))])],
	)
	target_candidate = compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver("app", CompilerUserModule),
		finalized_typecheck_program(target_program),
	)
	dependency_program = program_for_module(
		"dep",
		[function_body_decl("second", [], Some(int_type()), Some(int_expr()))],
	)
	dependency = compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver("dep", CompilerUserModule),
		finalized_typecheck_program(dependency_program),
	)
	foreign_dependency_program = program_for_module(
		"dep",
		[
			function_body_decl("second", [], Some(int_type()), Some(int_expr())),
			function_body_decl("foreign_only", [], Some(int_type()), Some(int_expr())),
		],
	)
	foreign_dependency = compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver("dep", CompilerUserModule),
		finalized_typecheck_program(foreign_dependency_program),
	)

	match compiler_indexed_graph_build(target_candidate, [dependency]):
		Err(_):
			False
		Ok(planned_graph):
			match compiler_indexed_graph_build(target_candidate, [foreign_dependency]):
				Err(_):
					False
				Ok(foreign_graph):
					match compiler_indexed_graph_find_dependency_scope(foreign_graph, "dep"):
						None:
							False
						Some(foreign_dependency_scope):
							state = compiler_typecheck_state_enter_prepared_module_scope(
								compiler_typecheck_state_empty(),
								compiler_indexed_graph_target_scope(planned_graph),
							)
							result = compiler_typecheck_program_with_import_modules_for_module(
								state,
								target_program,
								[compiler_importable_module(foreign_dependency_scope)],
								"app",
							)

							(
								result.state.errors.any(
									func(
										error,
									): error.contains(
										"imported module scope is incompatible with the current indexed graph",
									),
								)
								and compiler_env_lookup(result.state.env, "second").is_none()
								and compiler_typecheck_state_func_callable_bindings(
									result.state,
									"second",
								).length() == 1
							)


