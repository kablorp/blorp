func test_materialize_multiple_default_impl_methods_keep_distinct_callable_ids() -> Bool:
	default_method = trait_method_decl(
		"value",
		[named_param("self", named_type("Self"))],
		Some(int_type()),
		True,
		True,
	)
	source_program = program([
		trait_decl_with_methods("Value", [], [], [default_method]),
		impl_decl_with_methods_at("Value", int_type(), [], 1),
		impl_decl_with_methods_at("Value", string_type(), [], 2),
	])
	result = compiler_typecheck_program(compiler_typecheck_state_empty(), source_program)

	match (result.program.decls.get(1), result.program.decls.get(2)):
		(Some(CompilerTypedImplDecl(first)), Some(CompilerTypedImplDecl(second))):
			match (first.methods.get(0), second.methods.get(0)):
				(Some(first_method), Some(second_method)):
					match (first_method.callable_id, second_method.callable_id):
						(Some(first_id), Some(second_id)):
							(
								result.state.errors.length() == 0
								and first_id != second_id
								and compiler_typecheck_state_func_callable_bindings(
									result.state,
									"value",
								).length() == 2
							)
						_:
							False
				_:
					False
		_:
			False


