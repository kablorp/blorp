func test_check_global_var_bodies_validate_and_refine_registered_types() -> Bool:
	source_program = program([
		var_body_decl("answer", Some(int_type()), int_expr()),
		var_body_decl("bad", Some(bool_type()), decl_string_expr()),
		var_body_decl("inferred", None, decl_string_expr()),
	])
	state = compiler_typecheck_check_program_bodies(
		compiler_typecheck_register_program_signature_decls(
			compiler_typecheck_register_program_type_decls(
				compiler_typecheck_prescan_program(
					compiler_typecheck_state_empty(),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)

	match (
		compiler_env_get_var_type(state.env, "inferred"),
		compiler_env_get_module_var_symbol(state.env, "decl", "inferred"),
	):
		(Some(inferred_type), Some(module_var)):
			(
				state.errors.length() == 1
				and state.errors
					.get_or(0, "")
					.contains("Global variable 'bad' has wrong type")
				and compiler_types_equal(inferred_type, compiler_type_string())
				and compiler_types_equal(module_var.var_type, compiler_type_string())
			)
		_:
			False


