		function_body_decl("impure_value", [], Some(int_type()), Some(int_expr())),
		function_body_decl("container", [], None, Some(decl_block_expr([
				decl_lambda_expr(
					False,
					decl_call_expr("impure_value", []),
				),
				decl_void_expr(),
			]))),
	])
	state = compiler_typecheck_check_program_bodies(
		compiler_typecheck_register_program_signature_decls(
			compiler_typecheck_register_program_type_decls(
				compiler_typecheck_prescan_program(
					compiler_typecheck_state_empty(),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)

	state.errors.length() == 0


func test_check_tail_recursive_body_allows_direct_recursive_call() -> Bool:
	source_program = program(
		[
			function_body_decl_with_annotations(
				"loop",
				[],
				Some(int_type()),
				Some(decl_call_expr("loop", [])),
				False,
				[ParsedTailRecursiveAnnotation],
			),
		],
	)
	state = compiler_typecheck_check_program_bodies(
		compiler_typecheck_register_program_signature_decls(
			compiler_typecheck_register_program_type_decls(
				compiler_typecheck_prescan_program(
					compiler_typecheck_state_empty(),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)

	state.errors.length() == 0


func test_check_tail_recursive_body_rejects_operand_recursive_call() -> Bool:
	source_program = program(
		[
			function_body_decl_with_annotations(
				"loop",
				[],
				Some(int_type()),
				Some(decl_add_expr(decl_call_expr("loop", []), int_expr())),
				False,
				[ParsedTailRecursiveAnnotation],
			),
		],
	)
	state = compiler_typecheck_check_program_bodies(
		compiler_typecheck_register_program_signature_decls(
			compiler_typecheck_register_program_type_decls(
				compiler_typecheck_prescan_program(
					compiler_typecheck_state_empty(),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)

	(
		state.errors.length() == 1
		and state.errors
			.get_or(0, "")
			.contains("@tail_recursive function 'loop' has recursive call not in tail position")
	)


func test_check_global_var_bodies_validate_and_refine_registered_types() -> Bool:
	source_program = program([
		var_body_decl("answer", Some(int_type()), int_expr()),
		var_body_decl("bad", Some(bool_type()), decl_string_expr()),
		var_body_decl("inferred", None, decl_string_expr()),
	])
	state = compiler_typecheck_check_program_bodies(
		compiler_typecheck_register_program_signature_decls(
			compiler_typecheck_register_program_type_decls(
				compiler_typecheck_prescan_program(
					compiler_typecheck_state_empty(),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)

	match (
		compiler_env_get_var_type(state.env, "inferred"),
		compiler_env_get_module_var_symbol(state.env, "decl", "inferred"),
	):
		(Some(inferred_type), Some(module_var)):
			(
				state.errors.length() == 1
				and state.errors
					.get_or(0, "")
					.contains("Global variable 'bad' has wrong type")
				and compiler_types_equal(inferred_type, compiler_type_string())
				and compiler_types_equal(module_var.var_type, compiler_type_string())
			)
		_:
			False


func test_check_mutable_global_initializer_rejects_function_call() -> Bool:
	source_program = program([
		function_body_decl("compute", [], Some(int_type()), Some(int_expr())),
		mutable_var_body_decl(
			"value",
			Some(int_type()),
			decl_call_expr("compute", []),
		),
	])
	state = compiler_typecheck_check_program_bodies(
		compiler_typecheck_register_program_signature_decls(
			compiler_typecheck_register_program_type_decls(
				compiler_typecheck_prescan_program(
					compiler_typecheck_state_empty(),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)

	(
		state.errors.length() == 1
		and state.errors
			.get_or(0, "")
			.contains("top-level initializer 'value' cannot call function 'compute'")
	)


func test_check_mutable_global_initializer_rejects_subscript() -> Bool:
	source_program = program([mutable_var_body_decl(
				"value",
				Some(int_type()),
				decl_subscript_expr(decl_vector_expr([int_expr(), int_expr()]), [int_expr()]),
			)])
	state = compiler_typecheck_check_program_bodies(
		compiler_typecheck_register_program_signature_decls(
			compiler_typecheck_register_program_type_decls(
				compiler_typecheck_prescan_program(
					compiler_typecheck_state_empty(),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)

	(
		state.errors.length() == 1
		and state.errors
			.get_or(0, "")
			.contains("top-level initializer 'value' cannot use a subscript expression")
	)


func test_check_mutable_global_initializer_allows_lambda_body_call() -> Bool:
	source_program = program([
		function_body_decl("compute", [], Some(int_type()), Some(int_expr())),
		mutable_var_body_decl(
			"thunk",
			Some(function_type(False, [], int_type())),
			decl_lambda_expr(
				False,
				decl_call_expr("compute", []),
			),
		),
	])
	state = compiler_typecheck_check_program_bodies(
		compiler_typecheck_register_program_signature_decls(
			compiler_typecheck_register_program_type_decls(
				compiler_typecheck_prescan_program(
					compiler_typecheck_state_empty(),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)

	state.errors.length() == 0


