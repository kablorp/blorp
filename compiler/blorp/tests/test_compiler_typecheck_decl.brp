func test_materialize_program_bodies_resolves_function_alias_return_metadata() -> Bool:
	source_program = program([
		type_alias_decl_with_target(
			"IntThunk",
			function_type(True, [], int_type()),
		),
		function_body_decl_with_purity(
			"make",
			[],
			Some(named_type("IntThunk")),
			Some(decl_lambda_expr(True, int_expr())),
			True,
		),
	])
	base_state = compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_register_program_type_decls(
			compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
			source_program,
		),
		source_program,
	)
	result = compiler_typecheck_materialize_program_bodies(base_state, source_program)

	match result.program.decls.get(1):
		Some(CompilerTypedFunctionDecl(info)):
			source_return_ok = match info.source_return_type:
				Some(return_type):
					compiler_types_equal(
						return_type,
						CompilerNamedType("IntThunk", []),
					)
				None:
					False

			expected_semantic = CompilerFunctionType(True, [], compiler_type_int())

			body_ok = match info.body:
				Some(body):
					compiler_types_equal(compiler_typed_expr_semantic_type(body), expected_semantic)
				None:
					False

			(
				result.state.errors.length() == 0
				and source_return_ok
				and compiler_types_equal(info.semantic_return_type, expected_semantic)
				and body_ok
			)
		_:
			False


