				compiler_typecheck_prescan_program(
					compiler_typecheck_state_empty(),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)

	state.errors.length() == 0


func test_materialize_program_bodies_carries_typed_function_and_global() -> Bool:
	source_program = program([
		function_body_decl(
			"identity",
			[named_param("value", int_type())],
			Some(int_type()),
			Some(decl_name_expr("value")),
		),
		var_body_decl("answer", Some(int_type()), int_expr()),
	])
	base_state = compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_register_program_type_decls(
			compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
			source_program,
		),
		source_program,
	)
	result = compiler_typecheck_materialize_program_bodies(base_state, source_program)

	function_ok = match result.program.decls.get(0):
		Some(CompilerTypedFunctionDecl(info)):
			param_ok = match info.param_types.get(0):
				Some(param_type):
					compiler_types_equal(param_type, compiler_type_int())
				None:
					False

			source_return_ok = match info.source_return_type:
				Some(return_type):
					compiler_types_equal(return_type, compiler_type_int())
				None:
					False

			semantic_return_ok = compiler_types_equal(
				info.semantic_return_type,
				compiler_type_int(),
			)

			body_ok = match info.body:
				Some(body):
					compiler_types_equal(
						compiler_typed_expr_semantic_type(body),
						compiler_type_int(),
					)
				None:
					False

			(
				info.decl.name.text == "identity"
				and param_ok
				and source_return_ok
				and semantic_return_ok
				and body_ok
			)
		_:
			False

	global_ok = match result.program.decls.get(1):
		Some(CompilerTypedGlobalVarDecl(info)):
			source_ok = match info.source_type:
				Some(source_type):
					compiler_types_equal(source_type, compiler_type_int())
				None:
					False

			(
				info.decl.name.text == "answer"
				and compiler_types_equal(info.binding_type, compiler_type_int())
				and source_ok
			)
		_:
			False

	(
		result.state.errors.length() == 0
		and result.program.decls.length() == 2
		and function_ok
		and global_ok
	)


func test_materialize_program_bodies_preserves_implicit_type_params() -> Bool:
	source_program = program(
		[
			function_body_decl(
				"identity",
				[named_param("value", named_type("T"))],
				Some(named_type("T")),
				Some(decl_name_expr("value")),
			),
		],
	)
	base_state = compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_register_program_type_decls(
			compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
			source_program,
		),
		source_program,
	)
	result = compiler_typecheck_materialize_program_bodies(base_state, source_program)

	match result.program.decls.get(0):
		Some(CompilerTypedFunctionDecl(info)):
			expected = CompilerTypeVar("T")

			body_ok = match info.body:
				Some(body):
					(
						compiler_types_equal(compiler_typed_expr_semantic_type(body), expected)
						and compiler_types_equal(compiler_typed_expr_value_type(body), expected)
					)
				None:
					False

			(
				result.state.errors.length() == 0
				and info.decl.type_params.length() == 0
				and info.effective_type_params.map(func(param): param.name) == ["T"]
				and info.param_types.length() == 1
				and compiler_types_equal(
					info.param_types.get_or(0, compiler_type_void()),
					expected,
				)
				and compiler_types_equal(info.semantic_return_type, expected)
				and body_ok
			)
		_:
			False


