func test_materialize_program_bodies_selects_exact_overload_signature() -> Bool:
	source_program = program([
		function_body_decl_with_span(
			"identity",
			[named_param("value", int_type())],
			Some(int_type()),
			Some(decl_name_expr("value")),
			source_span_at(0),
		),
		function_body_decl_with_span(
			"identity",
			[named_param("value", string_type())],
			Some(string_type()),
			Some(decl_name_expr("value")),
			source_span_at(1),
		),
	])
	base_state = compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_register_program_type_decls(
			compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
			source_program,
		),
		source_program,
	)
	result = compiler_typecheck_materialize_program_bodies(base_state, source_program)

	match (result.program.decls.get(0), result.program.decls.get(1)):
		(Some(CompilerTypedFunctionDecl(first)), Some(CompilerTypedFunctionDecl(second))):
			callables_ok = match (first.callable_id, second.callable_id):
				(Some(first_id), Some(second_id)):
					first_id != second_id
				_:
					False

			result.state.errors.length() == 0 and callables_ok and compiler_types_equal(
				first.param_types.get_or(0, compiler_type_void()),
				compiler_type_int(),
			) and compiler_types_equal(
				first.semantic_return_type,
				compiler_type_int(),
			) and compiler_types_equal(
				second.param_types.get_or(0, compiler_type_void()),
				compiler_type_string(),
			) and compiler_types_equal(second.semantic_return_type, compiler_type_string())
		_:
			False


func test_materialize_generic_type_decls_use_explicit_semantic_params() -> Bool:
	generic_record = RecordParsedDecl({
		name = ident("Box"),
		type_params = [type_param("T")],
		fields = [field_decl("value", named_type("T"))],
		is_struct = False,
		doc = None,
		span = source_span(),
	})
	source_program = program([
		generic_record,
		result_union_decl(),
		generic_type_alias_decl("Wrapped", "T", named_type("T")),
	])
	state = compiler_typecheck_register_program_type_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
		source_program,
	)
	result = compiler_typecheck_materialize_program_bodies(state, source_program)
	expected = CompilerTypeVar("T")

	record_ok = match result.program.decls.get(0):
		Some(CompilerTypedRecordDecl(info)):
			match info.fields.get(0):
				Some(field):
					compiler_types_equal(
						field.source_type,
						CompilerNamedType("T", []),
					) and compiler_types_equal(field.semantic_type, expected)
				None:
					False
		_:
			False

	union_ok = match result.program.decls.get(1):
		Some(CompilerTypedUnionDecl(info)):
			match info.variants.get(0):
				Some(variant):
					compiler_types_equal(
						variant.fields.get_or(0, compiler_type_void()),
						expected,
					)
				None:
					False
		_:
			False

	alias_ok = match result.program.decls.get(2):
		Some(CompilerTypedTypeAliasDecl(info)):
			compiler_types_equal(
				info.source_target_type,
				CompilerNamedType("T", []),
			) and compiler_types_equal(info.semantic_target_type, expected)
		_:
			False

	result.state.errors.length() == 0 and record_ok and union_ok and alias_ok


