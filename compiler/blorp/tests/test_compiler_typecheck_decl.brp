		CompilerTypedLoopView(CompilerTypedWindowsLoopView),
		compiler_typed_expr_semantic_type,
		compiler_typed_expr_value_type,
	../src/stage_06_typecheck/compiler_typecheck_decl:
		CompilerTypecheckProgramResult,
		CompilerTypedDecl(
			CompilerTypedFunctionDecl,
			CompilerTypedForeignFunctionDecl,
			CompilerTypedGlobalVarDecl,
			CompilerTypedImplDecl,
			CompilerTypedParsedDecl,
			CompilerTypedPrivateDecl,
			CompilerTypedRecordDecl,
			CompilerTypedTraitDecl,
