func test_materialize_program_bodies_canonicalizes_compatible_declared_return() -> Bool:
	float_type = named_type("Float")
	concrete_vector_type = ParsedArrayType(
		float_type,
		[ParsedDimNameType(ident("#N"), False, source_span())],
		source_span(),
	)
	variadic_tensor_type = ParsedArrayType(
		float_type,
		[ParsedDimNameType(ident("#Ds"), True, source_span())],
		source_span(),
	)
	source_program = program(
		[
			generic_function_body_decl(
				"erase_dims",
				[type_param("#N")],
				[named_param("value", concrete_vector_type)],
				Some(variadic_tensor_type),
				Some(decl_name_expr("value")),
				True,
			),
		],
	)
	base_state = compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_register_program_type_decls(
			compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
			source_program,
		),
		source_program,
	)
	result = compiler_typecheck_materialize_program_bodies(base_state, source_program)
	expected_type = CompilerArrayType(compiler_type_float(), [CompilerVarDimsType("#Ds")])

	match result.program.decls.get(0):
		Some(CompilerTypedFunctionDecl(info)):
			match info.body:
				Some(body):
					(
						result.state.errors.length() == 0
						and compiler_types_equal(info.semantic_return_type, expected_type)
						and compiler_types_equal(
							compiler_typed_expr_semantic_type(body),
							expected_type,
						)
						and compiler_types_equal(
							compiler_typed_expr_value_type(body),
							expected_type,
						)
					)
				None:
					False
		_:
			False


func test_materialize_type_alias_preserves_source_target_metadata() -> Bool:
	source_program = program([
		type_alias_decl("BaseId", False),
		type_alias_decl_with_target("UserId", named_type("BaseId")),
