		CompilerTypedGlobalVarInfo,
		CompilerTypedProgram,
		CompilerTypedRecordFieldInfo,
		CompilerTypedRecordInfo,
		CompilerTypedUnionInfo,
		compiler_typecheck_check_function_body,
		compiler_typecheck_check_program_bodies,
		compiler_typecheck_materialize_program_bodies,
		compiler_typecheck_prescan_program,
