func test_materialize_impl_method_type_param_shadows_alias() -> Bool:
	method: ParsedFunctionDecl = {
		name = ident("identity"),
		keyword_span = Some(source_span()),
		type_params = [type_param("Callback")],
		params = [named_param("value", named_type("Callback"))],
		return_type = Some(named_type("Callback")),
		dim_constraints = [],
		body = Some(decl_name_expr("value")),
		is_pure = True,
		annotations = [],
		doc = None,
		span = source_span()
	}
	source_program = program([
		trait_decl("Identity"),
		type_alias_decl_with_target(
			"Callback",
			function_type(False, [int_type()], int_type()),
		),
		impl_decl_with_methods("Identity", int_type(), [method]),
	])
	base_state = compiler_typecheck_register_program_impl_decls(
		compiler_typecheck_register_program_signature_decls(
			compiler_typecheck_register_program_type_decls(
				compiler_typecheck_prescan_program(
					compiler_typecheck_state_empty(),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)
	result = compiler_typecheck_materialize_program_bodies(base_state, source_program)
	type_param = CompilerTypeVar("Callback")
	registered_method = compiler_env_find_impl_method_info(
		base_state.env,
		"Identity",
		"identity",
		compiler_type_int(),
	)

	match (registered_method, result.program.decls.get(2)):
		(Some(registered), Some(CompilerTypedImplDecl(info))):
			match info.methods.get(0):
				Some(method_info):
					target_ok = match (registered.target, method_info.callable_id):
						(Some(target), Some(callable_id)):
							target.callable_id == callable_id and target.module_path == "decl"
						_:
							False

					result.state.errors.length() == 0 and target_ok and compiler_types_equal(
						registered.func_type,
						CompilerFunctionType(True, [type_param], type_param),
					) and compiler_types_equal(
						method_info.param_types.get_or(0, compiler_type_void()),
						type_param,
					) and compiler_types_equal(method_info.semantic_return_type, type_param)
				None:
					False
		_:
			False


