func test_imported_builtin_resource_preserves_cleanup() -> Bool:
	module_path = "std/fs"
	resource_name = "FileReader"
	source_program = program(
		[
			import_block_decl(
				[import_decl("fs", None, Some([import_symbol(resource_name, None, [])]))],
			),
		],
	)
	result = compiler_typecheck_program_with_import_modules(
		compiler_typecheck_state_empty(),
		source_program,
		importable_modules(
			module_path,
			[builtin_resource_type_decl_with_cleanup(resource_name, "blorp_file_close_reader")],
		),
	)
	canonical_name = compiler_canonical_module_type_name(module_path, resource_name)

	(
		result.state.errors.length() == 0
		and compiler_find_resource_cleanup(
			result.state.context,
			canonical_name,
		) == Some("blorp_file_close_reader")
	)


func test_imported_resource_function_uses_canonical_parameter_type() -> Bool:
	module_path = "std/fs"
	resource_name = "FileReader"
	function_name = "use_reader"
	source_program = program([
		import_block_decl(
			[import_decl("fs", None, Some([import_symbol(function_name, None, [])]))],
		),
		record_decl(resource_name),
	])
	result = compiler_typecheck_program_with_import_modules(
		compiler_typecheck_state_empty(),
		source_program,
		importable_modules(
			module_path,
			[
				builtin_resource_type_decl_with_cleanup(resource_name, "blorp_file_close_reader"),
				function_body_decl(
					function_name,
					[named_param("reader", named_type(resource_name))],
					Some(int_type()),
					Some(int_expr()),
				),
			],
