func test_check_pure_function_rejects_module_variable_assignment() -> Bool:
	source_program = program([
		mutable_var_body_decl("counter", Some(int_type()), int_expr()),
		function_body_decl_with_purity(
			"bump",
			[],
			None,
			Some(decl_assign_expr("counter", int_expr())),
			True,
		),
	])
	state = compiler_typecheck_check_program_bodies(
		compiler_typecheck_register_program_signature_decls(
			compiler_typecheck_register_program_type_decls(
				compiler_typecheck_prescan_program(
					compiler_typecheck_state_empty(),
					source_program,
				),
				source_program,
			),
			source_program,
		),
		source_program,
	)

	(
