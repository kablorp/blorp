import:
	../compiler_diagnostic:
		CompilerDiagnostic,
		CompilerDiagnosticLabel,
		CompilerDiagnosticLabelStyle(PrimaryDiagnosticLabel, SecondaryDiagnosticLabel),
		CompilerDiagnosticSeverity(CompilerErrorSeverity, CompilerWarningSeverity),
		compiler_diagnostic,
		compiler_diagnostic_error,
		compiler_diagnostic_label,
		compiler_diagnostic_loc,
		compiler_diagnostic_loc_from_span,
		compiler_diagnostic_primary_label,
		compiler_diagnostic_render,
		compiler_diagnostic_severity_text,
		compiler_diagnostic_synthetic_loc,
	../compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	test: TestSuite


pure func sample_source() -> CompilerSourceFile:
	compiler_source_file("demo.brp", "demo", "first\n\tvalue = 1\nlast\n")


pure func value_span() -> CompilerSourceSpan:
	source: CompilerSourceFile = sample_source()
	start: CompilerCursor = compiler_source_cursor_at(source, 7)
	finish: CompilerCursor = compiler_source_cursor_at(source, 12)
	compiler_source_span(source, start, finish)


pure func warning_diagnostic() -> CompilerDiagnostic:
	compiler_diagnostic(
		CompilerWarningSeverity,
		"first line\nsecond line",
		[compiler_diagnostic_primary_label(compiler_diagnostic_synthetic_loc("synthetic.brp"))],
		[],
		None,
	)


func test_severity_text() -> Bool:
	(
		compiler_diagnostic_severity_text(CompilerErrorSeverity) == "error"
		and compiler_diagnostic_severity_text(CompilerWarningSeverity) == "warning"
	)


func test_render_error_keeps_tabs_and_notes() -> Bool:
	source: CompilerSourceFile = sample_source()
	label: CompilerDiagnosticLabel = compiler_diagnostic_primary_label(
		compiler_diagnostic_loc(
			"demo.brp",
			2,
			2,
			2,
			7,
			Some(source.text),
		),
	)
	diagnostic: CompilerDiagnostic = compiler_diagnostic_error(
		"bad value",
		label,
		["expected Int"],
		Some("use an integer expression"),
	)
	expected: String = "error: bad value\n  --> demo.brp:2:2\n   |\n 2 | \tvalue = 1\n   |\t^^^^^\n   |\n   = note: expected Int\n   = help: use an integer expression"

	compiler_diagnostic_render(diagnostic) == expected


func test_render_synthetic_multiline_message_without_source_line() -> Bool:
	compiler_diagnostic_render(
		warning_diagnostic(),
	) == "warning: first line\n    second line\n  --> synthetic.brp\n"


func test_render_secondary_label() -> Bool:
	source: CompilerSourceFile = sample_source()
	primary: CompilerDiagnosticLabel = compiler_diagnostic_primary_label(
		compiler_diagnostic_loc_from_span(
			source,
			value_span(),
		),
	)
	secondary: CompilerDiagnosticLabel = compiler_diagnostic_label(
		compiler_diagnostic_loc("demo.brp", 3, 1, 3, 5, Some(source.text)),
		"related",
		SecondaryDiagnosticLabel,
	)
	diagnostic: CompilerDiagnostic = compiler_diagnostic(
		CompilerErrorSeverity,
		"two labels",
		[primary, secondary],
		[],
		None,
	)

	(
		compiler_diagnostic_render(diagnostic).contains(" 3 | last")
		and compiler_diagnostic_render(diagnostic).contains("   |---- related")
	)


tests: TestSuite = {
	description = "Compiler diagnostics",
	tests = [
		("severity text", test_severity_text),
		("render error keeps tabs and notes", test_render_error_keeps_tabs_and_notes),
		(
			"render synthetic multiline message without source line",
			test_render_synthetic_multiline_message_without_source_line,
		),
		("render secondary label", test_render_secondary_label),
	]
}
