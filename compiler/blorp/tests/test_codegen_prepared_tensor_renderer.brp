		and literal_inline_struct_ok
		and literal_boxed_ok
		and literal_boxed_owned_ok
		and literal_boxed_borrowed_ok
		and missing_ok
	)

	all_ok


func test_render_prepared_tensor_op_successes() -> Bool:
	view_ok: Bool = render_prepared_tensor_op(RawViewDecl({
		pointer_c_type = "double*",
		view = "raw",
		source = "vec",
	})) == "double* raw = (double*)((blorp_Vector*)vec)->data"
	read_ok: Bool = render_prepared_tensor_op(RawRead("raw", "i")) == "raw[i]"
	expr_ok: Bool = render_prepared_tensor_op(RawWriteExpr({
		view = "raw",
		index = "i",
		value = "value",
	})) == "({ raw[i] = value; (void)0; })"
	stmt_ok: Bool = render_prepared_tensor_op(RawWriteStmt({
		view = "raw",
		index = "i",
		value = "value",
	})) == "raw[i] = value;"
	word_storage_ok: Bool = render_prepared_tensor_op(WordStorageCheck({
		tensor = "tensor",
		temp_seed = "0",
	})) == (
		"({ blorp_Vector* __tensor_layout_0 = (blorp_Vector*)tensor; __tensor_layout_0 "
		+ "&& __tensor_layout_0->storage_mode == BLORP_VECTOR_STORAGE_POINTER && "
		+ "__tensor_layout_0->elem_size == (int16_t)sizeof(void*) && __tensor_layout_0-"
		+ ">elem_release == NULL; })"
	)
	f64_storage_ok: Bool = render_prepared_tensor_op(F64StorageCheck({
		tensor = "tensor",
		temp_seed = "0",
	})) == (
		"({ blorp_Vector* __tensor_layout_0 = (blorp_Vector*)tensor; __tensor_layout_0 "
		+ "&& __tensor_layout_0->storage_mode == BLORP_VECTOR_STORAGE_F64 && "
		+ "__tensor_layout_0->elem_size == (int16_t)sizeof(double); })"
	)
	f32_storage_ok: Bool = render_prepared_tensor_op(F32StorageCheck({
		tensor = "tensor",
		temp_seed = "0",
	})) == (
		"({ blorp_Vector* __tensor_layout_0 = (blorp_Vector*)tensor; __tensor_layout_0 "
		+ "&& __tensor_layout_0->storage_mode == BLORP_VECTOR_STORAGE_F32 && "
		+ "__tensor_layout_0->elem_size == (int16_t)sizeof(float); })"
	)
	i64_storage_ok: Bool = render_prepared_tensor_op(I64StorageCheck({
		tensor = "tensor",
		temp_seed = "0",
	})) == (
		"({ blorp_Vector* __tensor_layout_0 = (blorp_Vector*)tensor; __tensor_layout_0 "
		+ "&& __tensor_layout_0->storage_mode == BLORP_VECTOR_STORAGE_I64 && "
		+ "__tensor_layout_0->elem_size == (int16_t)sizeof(long); })"
	)
	data_get_ok: Bool = render_prepared_tensor_op(DataPointerGetUnchecked({
		tensor = "tensor",
		index = "i",
	})) == "((blorp_Vector*)tensor)->data[i]"
	inline_struct_get_ok: Bool = render_prepared_tensor_op(InlineStructGetUnchecked({
		tensor = "tensor",
		index = "i",
		temp_seed = "0",
		struct_ty = "Small",
	})) == (
		"({ blorp_Vector* __tgu_vec_0 = (blorp_Vector*)tensor; long __tgu_idx_0 = i; "
		+ "Small __tgu_out_0; if (__builtin_expect(__tgu_vec_0->storage_mode == "
		+ "BLORP_VECTOR_STORAGE_INLINE && __tgu_vec_0->elem_size == sizeof(Small), 1)) { "
		+ "memcpy(&__tgu_out_0, (char*)__tgu_vec_0->data + __tgu_idx_0 * sizeof(Small), "
		+ "sizeof(Small)); } else { void* __tgu_raw_0 = __tgu_vec_0->data[__tgu_idx_0]; "
		+ "__tgu_out_0 = blorp_unbox_struct(__tgu_raw_0, Small); } __tgu_out_0; })"
	)
	f64_raw_get_ok: Bool = render_prepared_tensor_op(F64RawGetUnchecked({
		tensor = "tensor",
		index = "i",
		temp_seed = "0",
	})) == (
		"({ blorp_Vector* __tensor_raw_vec_0 = (blorp_Vector*)tensor; long "
		+ "__tensor_raw_idx_0 = i; double __tensor_raw_0; memcpy(&__tensor_raw_0, "
		+ "(char*)__tensor_raw_vec_0->data + __tensor_raw_idx_0 * sizeof(double), "
		+ "sizeof(double)); __tensor_raw_0; })"
	)
	f32_raw_get_ok: Bool = render_prepared_tensor_op(F32RawGetUnchecked({
		tensor = "tensor",
		index = "i",
		temp_seed = "0",
	})) == (
		"({ blorp_Vector* __tensor_raw_vec_0 = (blorp_Vector*)tensor; long "
		+ "__tensor_raw_idx_0 = i; float __tensor_raw_0; memcpy(&__tensor_raw_0, "
		+ "(char*)__tensor_raw_vec_0->data + __tensor_raw_idx_0 * sizeof(float), "
		+ "sizeof(float)); __tensor_raw_0; })"
	)
	alloc_pointer_ok: Bool = render_prepared_tensor_op(
		TensorAllocPointer("n"),
	) == "blorp_vector_new(n)"
	alloc_i64_ok: Bool = render_prepared_tensor_op(TensorAllocI64("n")) == "blorp_vector_new_i64(n)"
	alloc_f64_ok: Bool = render_prepared_tensor_op(TensorAllocF64("n")) == "blorp_vector_new_f64(n)"
	alloc_f32_ok: Bool = render_prepared_tensor_op(TensorAllocF32("n")) == "blorp_vector_new_f32(n)"
	alloc_packed_ok: Bool = render_prepared_tensor_op(TensorAllocPacked({
		size = "n",
		elem_size = "4",
	})) == "blorp_vector_new_packed(n, 4)"
	alloc_sized_ok: Bool = render_prepared_tensor_op(TensorAllocSized({
		size = "n",
		struct_ty = "Small",
	})) == "blorp_vector_new_sized(n, sizeof(Small))"
	alloc_release_ok: Bool = render_prepared_tensor_op(TensorAllocWithRelease({
		alloc_expr = "blorp_vector_new(n)",
		temp_seed = "0",
	})) == (
		"({ blorp_Vector* __tensor_alloc_0 = blorp_vector_new(n); "
		+ "blorp_vector_init_elem_release(__tensor_alloc_0, blorp_elem_release_fn); "
		+ "__tensor_alloc_0; })"
	)
	ranked_alloc_pointer_ok: Bool = render_prepared_tensor_op(TensorRankedAllocPointer({
		first_dim = "rows",
		total_dim = "total",
	})) == "blorp_tensor_new(rows, total)"
	ranked_alloc_i64_ok: Bool = render_prepared_tensor_op(TensorRankedAllocI64({
		first_dim = "rows",
		total_dim = "total",
	})) == "blorp_tensor_new_i64(rows, total)"
	ranked_alloc_f64_ok: Bool = render_prepared_tensor_op(TensorRankedAllocF64({
		first_dim = "rows",
		total_dim = "total",
	})) == "blorp_tensor_new_f64(rows, total)"
	ranked_alloc_f32_ok: Bool = render_prepared_tensor_op(TensorRankedAllocF32({
		first_dim = "rows",
		total_dim = "total",
	})) == "blorp_tensor_new_f32(rows, total)"
	ranked_alloc_packed_ok: Bool = render_prepared_tensor_op(TensorRankedAllocPacked({
		first_dim = "rows",
		total_dim = "total",
		elem_size = "1",
	})) == "blorp_tensor_new_packed(rows, total, 1)"
	ranked_alloc_sized_ok: Bool = render_prepared_tensor_op(TensorRankedAllocSized({
		first_dim = "rows",
		total_dim = "total",
		struct_ty = "Small",
	})) == "blorp_tensor_new_sized(rows, total, sizeof(Small))"
	init_release_ok: Bool = render_prepared_tensor_op(
		TensorInitElemRelease(
			"vec",
		),
	) == "blorp_vector_init_elem_release(vec, blorp_elem_release_fn);"
	literal_f32_ok: Bool = render_prepared_tensor_op(TensorLiteralF32Write({
		tensor = "vec",
		index = "i",
		value = "value",
	})) == "((float*)vec->data)[i] = value;"
	literal_f64_ok: Bool = render_prepared_tensor_op(TensorLiteralF64Write({
		tensor = "vec",
		index = "i",
		value = "value",
	})) == "blorp_vector_write_f64(vec, i, value);"
	literal_i64_ok: Bool = render_prepared_tensor_op(TensorLiteralI64Write({
		tensor = "vec",
		index = "i",
		value = "value",
	})) == "((long*)vec->data)[i] = value;"
	literal_word_ok: Bool = render_prepared_tensor_op(TensorLiteralWordWrite({
		tensor = "vec",
		index = "i",
		value = "value",
	})) == "vec->data[i] = (void*)(intptr_t)(value);"
	literal_packed_ok: Bool = render_prepared_tensor_op(TensorLiteralPackedWrite({
		tensor = "vec",
		index = "i",
		value = "value",
	})) == "blorp_packed_set(vec, i, (long)(value));"
	literal_inline_struct_ok: Bool = render_prepared_tensor_op(TensorLiteralInlineStructWrite({
		tensor = "vec",
		index = "i",
		value = "Point_make(1, 2)",
		temp_seed = "0",
		struct_ty = "Point",
	})) == (
		"{ Point __ten_elem_0 = Point_make(1, 2); memcpy((char*)vec->data + i * "
		+ "sizeof(Point), &__ten_elem_0, sizeof(Point)); }"
	)
	literal_boxed_ok: Bool = render_prepared_tensor_op(TensorLiteralBoxedWrite({
		tensor = "vec",
		index = "i",
		value = "boxed",
	})) == "vec->data[i] = boxed;"
	literal_boxed_owned_ok: Bool = render_prepared_tensor_op(TensorLiteralBoxedOwnedWrite({
		tensor = "vec",
		index = "i",
		value = "make_boxed()",
		temp_seed = "0",
	})) == "{ void* __ten_boxed_0 = make_boxed(); vec->data[i] = __ten_boxed_0; }"
	literal_boxed_borrowed_ok: Bool = render_prepared_tensor_op(TensorLiteralBoxedBorrowedWrite({
		tensor = "vec",
		index = "i",
		value = "boxed",
		temp_seed = "0",
	})) == (
		"{ void* __ten_boxed_0 = boxed; vec->data[i] = __ten_boxed_0; if (__ten_boxed_0) "
		+ "blorp_retain(__ten_boxed_0); }"
	)

	(
		view_ok
		and read_ok
		and expr_ok
		and stmt_ok
		and word_storage_ok
		and f64_storage_ok
		and f32_storage_ok
		and i64_storage_ok
		and data_get_ok
		and inline_struct_get_ok
		and f64_raw_get_ok
		and f32_raw_get_ok
		and alloc_pointer_ok
		and alloc_i64_ok
		and alloc_f64_ok
		and alloc_f32_ok
		and alloc_packed_ok
		and alloc_sized_ok
		and alloc_release_ok
		and ranked_alloc_pointer_ok
		and ranked_alloc_i64_ok
		and ranked_alloc_f64_ok
		and ranked_alloc_f32_ok
		and ranked_alloc_packed_ok
		and ranked_alloc_sized_ok
		and init_release_ok
		and literal_f32_ok
		and literal_f64_ok
		and literal_i64_ok
		and literal_word_ok
		and literal_packed_ok
		and literal_inline_struct_ok
		and literal_boxed_ok
		and literal_boxed_owned_ok
		and literal_boxed_borrowed_ok
	)


func test_render_prepared_tensor_successes() -> Bool:
	view_ok: Bool = match render_prepared_tensor(
		"tensor_raw_view_decl",
		["float*", "__raw", "tensor"],
	):
		Ok(rendered):
			rendered == "float* __raw = (float*)((blorp_Vector*)tensor)->data"
		Err(error):
			False

	read_ok: Bool = match render_prepared_tensor(
		"tensor_raw_read",
		["__raw", "idx"],
	):
		Ok(rendered):
			rendered == "__raw[idx]"
		Err(error):
			False

	stmt_ok: Bool = match render_prepared_tensor(
		"tensor_raw_write_stmt",
		["__raw", "idx", "next"],
	):
		Ok(rendered):
			rendered == "__raw[idx] = next;"
		Err(error):
			False

	storage_ok: Bool = match render_prepared_tensor(
		"tensor_is_i64_storage",
		["tensor", "0"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_Vector* __tensor_layout_0 = (blorp_Vector*)tensor; __tensor_layout_0 "
				+ "&& __tensor_layout_0->storage_mode == BLORP_VECTOR_STORAGE_I64 && "
				+ "__tensor_layout_0->elem_size == (int16_t)sizeof(long); })"
			)
		Err(error):
			False

	raw_get_ok: Bool = match render_prepared_tensor(
		"tensor_get_f32_raw_unchecked",
		["tensor", "idx", "0"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_Vector* __tensor_raw_vec_0 = (blorp_Vector*)tensor; long "
				+ "__tensor_raw_idx_0 = idx; float __tensor_raw_0; memcpy(&__tensor_raw_0, "
				+ "(char*)__tensor_raw_vec_0->data + __tensor_raw_idx_0 * sizeof(float), "
				+ "sizeof(float)); __tensor_raw_0; })"
			)
		Err(error):
			False

	expected_alloc_release: String = (
		"({ blorp_Vector* __tensor_alloc_0 = blorp_vector_new(n); "
		+ "blorp_vector_init_elem_release(__tensor_alloc_0, blorp_elem_release_fn); "
		+ "__tensor_alloc_0; })"
	)

	alloc_packed_ok: Bool = match render_prepared_tensor(
		"tensor_alloc_packed",
		["n", "8"],
	):
		Ok(rendered):
			rendered == "blorp_vector_new_packed(n, 8)"
		Err(error):
			False

	alloc_release_ok: Bool = match render_prepared_tensor(
		"tensor_alloc_with_release",
		["blorp_vector_new(n)", "0"],
	):
		Ok(rendered):
			rendered == expected_alloc_release
		Err(error):
			False

	ranked_alloc_ok: Bool = match render_prepared_tensor(
		"tensor_ranked_alloc_packed",
		["rows", "total", "1"],
	):
		Ok(rendered):
			rendered == "blorp_tensor_new_packed(rows, total, 1)"
		Err(error):
			False

	literal_write_ok: Bool = match render_prepared_tensor(
		"tensor_literal_write_inline_struct",
		["vec", "i", "Point_make(1, 2)", "0", "Point"],
	):
		Ok(rendered):
			rendered == (
				"{ Point __ten_elem_0 = Point_make(1, 2); memcpy((char*)vec->data + i * "
				+ "sizeof(Point), &__ten_elem_0, sizeof(Point)); }"
			)
		Err(error):
			False

	successes_ok: Bool = (
		view_ok
		and read_ok
		and stmt_ok
		and storage_ok
		and raw_get_ok
		and alloc_packed_ok
		and alloc_release_ok
		and ranked_alloc_ok
		and literal_write_ok
	)

	successes_ok


func test_render_prepared_tensor_errors_are_typed() -> Bool:
	match render_prepared_tensor("tensor_raw_read", ["raw"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_tensor_template_name(info) == "tensor_raw_read"
						and prepared_tensor_template_arity(info) == 2
						and got == 1
					)
				UnsupportedPreparedTensorOp(name):
					False


func test_render_inline_struct_error_is_typed() -> Bool:
	match render_prepared_tensor("tensor_inline_struct_get_unchecked", ["tensor"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_tensor_template_name(info) == "tensor_inline_struct_get_unchecked"
						and prepared_tensor_template_arity(info) == 4
						and got == 1
					)
				UnsupportedPreparedTensorOp(name):
					False


func test_render_unknown_prepared_tensor_error_is_typed() -> Bool:
	match render_prepared_tensor("tensor_len", ["vec"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					False
				UnsupportedPreparedTensorOp(name):
					name == "tensor_len"


func test_render_tensor_literal_write_errors_are_typed() -> Bool:
	match render_prepared_tensor(
		"tensor_literal_write_inline_struct",
		["vec", "i", "value", "__elem"],
	):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_tensor_template_name(info) == "tensor_literal_write_inline_struct"
						and prepared_tensor_template_arity(info) == 5
						and got == 4
					)
				UnsupportedPreparedTensorOp(name):
					False


func test_render_error_to_string() -> Bool:
	unsupported_error: RenderError = UnsupportedPreparedTensorOp("missing")

	arity_text: String = match render_prepared_tensor(
		"tensor_raw_write_expr",
		["a", "b"],
	):
		Ok(rendered):
			rendered
		Err(error):
			render_error_to_string(error)

	unsupported_text: String = render_error_to_string(unsupported_error)

	(
		arity_text == "prepared tensor op tensor_raw_write_expr expected 3 arg(s), got 2"
		and unsupported_text == "unsupported prepared tensor op: missing"
	)


func test_render_manifest_lines() -> Bool:
	lines: List[String] = render_manifest_lines()
	count_ok: Bool = lines.length() == ALL_TEMPLATES.length()

	first_ok: Bool = match lines:
		[]:
			False
		[first, ...rest]:
			first == "tensor_raw_view_decl\t3\t@0@ @1@ = (@0@)((blorp_Vector*)@2@)->data"

	stmt_ok: Bool = manifest_line_is(
		"tensor_raw_write_stmt",
		"tensor_raw_write_stmt\t3\t@0@[@1@] = @2@;",
	)
	storage_ok: Bool = manifest_line_is(
		"tensor_is_word_storage",
		"tensor_is_word_storage\t2\t({ blorp_Vector* __tensor_layout_@1@ = (blorp_Vector*)@0@; __tensor_layout_@1@ && __tensor_layout_@1@->storage_mode == BLORP_VECTOR_STORAGE_POINTER && __tensor_layout_@1@->elem_size == (int16_t)sizeof(void*) && __tensor_layout_@1@->elem_release == NULL; })",
	)
	inline_struct_get_ok: Bool = manifest_line_is(
		"tensor_inline_struct_get_unchecked",
		"tensor_inline_struct_get_unchecked\t4\t({ blorp_Vector* __tgu_vec_@2@ = (blorp_Vector*)@0@; long __tgu_idx_@2@ = @1@; @3@ __tgu_out_@2@; if (__builtin_expect(__tgu_vec_@2@->storage_mode == BLORP_VECTOR_STORAGE_INLINE && __tgu_vec_@2@->elem_size == sizeof(@3@), 1)) { memcpy(&__tgu_out_@2@, (char*)__tgu_vec_@2@->data + __tgu_idx_@2@ * sizeof(@3@), sizeof(@3@)); } else { void* __tgu_raw_@2@ = __tgu_vec_@2@->data[__tgu_idx_@2@]; __tgu_out_@2@ = blorp_unbox_struct(__tgu_raw_@2@, @3@); } __tgu_out_@2@; })",
	)
	raw_get_ok: Bool = manifest_line_is(
		"tensor_get_f64_raw_unchecked",
		"tensor_get_f64_raw_unchecked\t3\t({ blorp_Vector* __tensor_raw_vec_@2@ = (blorp_Vector*)@0@; long __tensor_raw_idx_@2@ = @1@; double __tensor_raw_@2@; memcpy(&__tensor_raw_@2@, (char*)__tensor_raw_vec_@2@->data + __tensor_raw_idx_@2@ * sizeof(double), sizeof(double)); __tensor_raw_@2@; })",
	)
	alloc_pointer_ok: Bool = manifest_line_is(
		"tensor_alloc_pointer",
		"tensor_alloc_pointer\t1\tblorp_vector_new(@0@)",
	)
	alloc_sized_ok: Bool = manifest_line_is(
		"tensor_alloc_sized",
		"tensor_alloc_sized\t2\tblorp_vector_new_sized(@0@, sizeof(@1@))",
	)
	alloc_release_ok: Bool = manifest_line_is(
		"tensor_alloc_with_release",
		"tensor_alloc_with_release\t2\t({ blorp_Vector* __tensor_alloc_@1@ = @0@; blorp_vector_init_elem_release(__tensor_alloc_@1@, blorp_elem_release_fn); __tensor_alloc_@1@; })",
	)
	ranked_alloc_pointer_ok: Bool = manifest_line_is(
		"tensor_ranked_alloc_pointer",
		"tensor_ranked_alloc_pointer\t2\tblorp_tensor_new(@0@, @1@)",
	)
	ranked_alloc_i64_ok: Bool = manifest_line_is(
		"tensor_ranked_alloc_i64",
		"tensor_ranked_alloc_i64\t2\tblorp_tensor_new_i64(@0@, @1@)",
	)
	ranked_alloc_f64_ok: Bool = manifest_line_is(
		"tensor_ranked_alloc_f64",
		"tensor_ranked_alloc_f64\t2\tblorp_tensor_new_f64(@0@, @1@)",
	)
	ranked_alloc_f32_ok: Bool = manifest_line_is(
		"tensor_ranked_alloc_f32",
		"tensor_ranked_alloc_f32\t2\tblorp_tensor_new_f32(@0@, @1@)",
	)
	ranked_alloc_packed_ok: Bool = manifest_line_is(
		"tensor_ranked_alloc_packed",
		"tensor_ranked_alloc_packed\t3\tblorp_tensor_new_packed(@0@, @1@, @2@)",
	)
	ranked_alloc_sized_ok: Bool = manifest_line_is(
		"tensor_ranked_alloc_sized",
		"tensor_ranked_alloc_sized\t3\tblorp_tensor_new_sized(@0@, @1@, sizeof(@2@))",
	)
	init_release_ok: Bool = manifest_line_is(
		"tensor_init_elem_release",
		"tensor_init_elem_release\t1\tblorp_vector_init_elem_release(@0@, blorp_elem_release_fn);",
	)
	literal_f32_ok: Bool = manifest_line_is(
		"tensor_literal_write_f32",
		"tensor_literal_write_f32\t3\t((float*)@0@->data)[@1@] = @2@;",
	)
	literal_f64_ok: Bool = manifest_line_is(
		"tensor_literal_write_f64",
		"tensor_literal_write_f64\t3\tblorp_vector_write_f64(@0@, @1@, @2@);",
	)
	literal_i64_ok: Bool = manifest_line_is(
		"tensor_literal_write_i64",
		"tensor_literal_write_i64\t3\t((long*)@0@->data)[@1@] = @2@;",
	)
	literal_word_ok: Bool = manifest_line_is(
		"tensor_literal_write_word",
		"tensor_literal_write_word\t3\t@0@->data[@1@] = (void*)(intptr_t)(@2@);",
	)
	literal_packed_ok: Bool = manifest_line_is(
		"tensor_literal_write_packed",
		"tensor_literal_write_packed\t3\tblorp_packed_set(@0@, @1@, (long)(@2@));",
	)
	literal_inline_struct_ok: Bool = manifest_line_is(
		"tensor_literal_write_inline_struct",
		"tensor_literal_write_inline_struct\t5\t{ @4@ __ten_elem_@3@ = @2@; memcpy((char*)@0@->data + @1@ * sizeof(@4@), &__ten_elem_@3@, sizeof(@4@)); }",
	)
	literal_boxed_ok: Bool = manifest_line_is(
		"tensor_literal_write_boxed",
		"tensor_literal_write_boxed\t3\t@0@->data[@1@] = @2@;",
	)
	literal_boxed_owned_ok: Bool = manifest_line_is(
		"tensor_literal_write_boxed_owned",
		"tensor_literal_write_boxed_owned\t4\t{ void* __ten_boxed_@3@ = @2@; @0@->data[@1@] = __ten_boxed_@3@; }",
	)
	literal_boxed_borrowed_ok: Bool = manifest_line_is(
		"tensor_literal_write_boxed_borrowed",
		"tensor_literal_write_boxed_borrowed\t4\t{ void* __ten_boxed_@3@ = @2@; @0@->data[@1@] = __ten_boxed_@3@; if (__ten_boxed_@3@) blorp_retain(__ten_boxed_@3@); }",
	)

	(
		count_ok
		and first_ok
		and stmt_ok
		and storage_ok
		and inline_struct_get_ok
		and raw_get_ok
		and alloc_pointer_ok
		and alloc_sized_ok
		and alloc_release_ok
		and ranked_alloc_pointer_ok
		and ranked_alloc_i64_ok
		and ranked_alloc_f64_ok
		and ranked_alloc_f32_ok
		and ranked_alloc_packed_ok
		and ranked_alloc_sized_ok
		and init_release_ok
		and literal_f32_ok
		and literal_f64_ok
		and literal_i64_ok
		and literal_word_ok
		and literal_packed_ok
		and literal_inline_struct_ok
		and literal_boxed_ok
		and literal_boxed_owned_ok
		and literal_boxed_borrowed_ok
	)


tests: TestSuite = {
	description = "Self-hosted compiler prepared tensor renderer",
	tests = [
		("parse command routes", test_parse_command_routes),
		("parse template shapes", test_parse_template_shapes),
		("render prepared tensor op successes", test_render_prepared_tensor_op_successes),
		("render prepared tensor successes", test_render_prepared_tensor_successes),
		("render prepared tensor errors are typed", test_render_prepared_tensor_errors_are_typed),
		("render inline struct error is typed", test_render_inline_struct_error_is_typed),
		(
			"render unknown prepared tensor error is typed",
			test_render_unknown_prepared_tensor_error_is_typed,
		),
		(
			"render tensor literal write errors are typed",
			test_render_tensor_literal_write_errors_are_typed,
		),
		("render error to string", test_render_error_to_string),
		("render manifest lines", test_render_manifest_lines),
	]
}
