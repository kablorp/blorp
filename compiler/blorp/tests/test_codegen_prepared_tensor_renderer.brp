func test_render_prepared_tensor_successes() -> Bool:
	view_ok: Bool = match render_prepared_tensor(
		"tensor_raw_view_decl",
		["float*", "__raw", "tensor"],
	):
		Ok(rendered):
			rendered == "float* __raw = (float*)((blorp_Vector*)tensor)->data"
		Err(error):
			False

	read_ok: Bool = match render_prepared_tensor(
		"tensor_raw_read",
		["__raw", "idx"],
	):
		Ok(rendered):
			rendered == "__raw[idx]"
		Err(error):
			False

	stmt_ok: Bool = match render_prepared_tensor(
		"tensor_raw_write_stmt",
		["__raw", "idx", "next"],
	):
		Ok(rendered):
			rendered == "__raw[idx] = next;"
		Err(error):
			False

	storage_ok: Bool = match render_prepared_tensor(
		"tensor_is_i64_storage",
		["tensor", "0"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_Vector* __tensor_layout_0 = (blorp_Vector*)tensor; __tensor_layout_0 "
				+ "&& __tensor_layout_0->storage_mode == BLORP_VECTOR_STORAGE_I64 && "
				+ "__tensor_layout_0->elem_size == (int16_t)sizeof(long); })"
			)
		Err(error):
			False

	storage_mode_pointer_ok: Bool = rendered_template_is(
		"tensor_storage_mode_pointer",
		[],
		"BLORP_VECTOR_STORAGE_POINTER",
	)
	storage_mode_f64_ok: Bool = rendered_template_is(
		"tensor_storage_mode_f64",
		[],
		"BLORP_VECTOR_STORAGE_F64",
	)
	storage_mode_f32_ok: Bool = rendered_template_is(
		"tensor_storage_mode_f32",
		[],
		"BLORP_VECTOR_STORAGE_F32",
	)
	storage_mode_i64_ok: Bool = rendered_template_is(
		"tensor_storage_mode_i64",
		[],
		"BLORP_VECTOR_STORAGE_I64",
	)
	storage_mode_inline_ok: Bool = rendered_template_is(
		"tensor_storage_mode_inline",
		[],
		"BLORP_VECTOR_STORAGE_INLINE",
	)
	element_size_pointer_ok: Bool = rendered_template_is(
		"tensor_element_size_pointer",
		[],
		"sizeof(void*)",
	)
	element_size_f64_ok: Bool = rendered_template_is(
		"tensor_element_size_f64",
		[],
		"sizeof(double)",
	)
	element_size_f32_ok: Bool = rendered_template_is("tensor_element_size_f32", [], "sizeof(float)")
	element_size_i64_ok: Bool = rendered_template_is("tensor_element_size_i64", [], "sizeof(long)")
	element_size_inline_struct_ok: Bool = rendered_template_is(
		"tensor_element_size_inline_struct",
		["Small"],
		"sizeof(Small)",
	)
	callback_boxed_struct_ok: Bool = rendered_template_is(
		"tensor_callback_result_boxed_struct",
		[],
		"BLORP_VECTOR_CALLBACK_BOXED_STRUCT",
	)
	callback_boxed_float_ok: Bool = rendered_template_is(
		"tensor_callback_result_boxed_float",
		[],
		"BLORP_VECTOR_CALLBACK_BOXED_FLOAT",
	)
	callback_boxed_float32_ok: Bool = rendered_template_is(
		"tensor_callback_result_boxed_float32",
		[],
		"BLORP_VECTOR_CALLBACK_BOXED_FLOAT32",
	)
	callback_bits_ok: Bool = rendered_template_is(
		"tensor_callback_result_bits",
		[],
		"BLORP_VECTOR_CALLBACK_BITS",
	)

	raw_get_ok: Bool = match render_prepared_tensor(
		"tensor_get_f32_raw_unchecked",
		["tensor", "idx", "0"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_Vector* __tensor_raw_vec_0 = (blorp_Vector*)tensor; long "
				+ "__tensor_raw_idx_0 = idx; float __tensor_raw_0; memcpy(&__tensor_raw_0, "
				+ "(char*)__tensor_raw_vec_0->data + __tensor_raw_idx_0 * sizeof(float), "
				+ "sizeof(float)); __tensor_raw_0; })"
			)
		Err(error):
			False

	checked_inline_struct_get_ok: Bool = match render_prepared_tensor(
		"tensor_inline_struct_get_checked",
		["tensor", "idx", "0", "Small"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_Vector* __tg_vec_0 = (blorp_Vector*)tensor; long __tg_idx_0 = idx; "
				+ "Small __tg_out_0 = {0}; if (__builtin_expect(__tg_vec_0 && __tg_idx_0 >= 0 && "
				+ "__tg_idx_0 < __tg_vec_0->len, 1)) { if (__builtin_expect(__tg_vec_0-"
				+ ">storage_mode == BLORP_VECTOR_STORAGE_INLINE && __tg_vec_0->elem_size == "
				+ "sizeof(Small), 1)) { memcpy(&__tg_out_0, (char*)__tg_vec_0->data + __tg_idx_0 * "
				+ "sizeof(Small), sizeof(Small)); } else { void* __tg_raw_0 = __tg_vec_0-"
				+ ">data[__tg_idx_0]; __tg_out_0 = blorp_unbox_struct(__tg_raw_0, Small); } } "
				+ "__tg_out_0; })"
			)
		Err(error):
			False

	inline_struct_element_decl_ok: Bool = match render_prepared_tensor(
		"tensor_inline_struct_element_decl",
		["out", "tensor", "idx", "0", "Small"],
	):
		Ok(rendered):
			rendered == (
				"Small out = ({ blorp_Vector* __tgu_vec_0 = (blorp_Vector*)tensor; long "
				+ "__tgu_idx_0 = idx; Small __tgu_out_0; if (__builtin_expect(__tgu_vec_0-"
				+ ">storage_mode == BLORP_VECTOR_STORAGE_INLINE && __tgu_vec_0->elem_size == "
				+ "sizeof(Small), 1)) { memcpy(&__tgu_out_0, (char*)__tgu_vec_0->data + "
				+ "__tgu_idx_0 * sizeof(Small), sizeof(Small)); } else { void* __tgu_raw_0 = "
				+ "__tgu_vec_0->data[__tgu_idx_0]; __tgu_out_0 = blorp_unbox_struct(__tgu_raw_0, "
				+ "Small); } __tgu_out_0; });"
			)
		Err(error):
			False

	stack_option_vector_long_ok: Bool = match render_prepared_tensor(
		"tensor_stack_option_vector_get_long",
		["values", "idx", "0", "blorp_StackOption_Range", "0"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_Vector* __gso_vec_0 = (blorp_Vector*)values; long __gso_idx_0 = idx; "
				+ "blorp_StackOption_Range __gso_result_0; if (!__gso_vec_0 || __gso_idx_0 < 0 || "
				+ "__gso_idx_0 >= __gso_vec_0->len) { __gso_result_0 = ((blorp_StackOption_Range){ "
				+ ".tag = BLORP_TAG_NONE, .value = 0 }); } else { __gso_result_0 = "
				+ "((blorp_StackOption_Range){ .tag = BLORP_TAG_SOME, .value = "
				+ "blorp_vector_read_i64(__gso_vec_0, __gso_idx_0) }); } __gso_result_0; })"
			)
		Err(error):
			False

	expected_alloc_release: String = (
		"({ blorp_Vector* __tensor_alloc_0 = blorp_vector_new(n); "
		+ "blorp_vector_init_elem_release(__tensor_alloc_0, blorp_elem_release_fn); "
		+ "__tensor_alloc_0; })"
	)

	alloc_packed_ok: Bool = match render_prepared_tensor(
		"tensor_alloc_packed",
		["n", "8"],
	):
		Ok(rendered):
			rendered == "blorp_vector_new_packed(n, 8)"
		Err(error):
			False

	alloc_release_ok: Bool = match render_prepared_tensor(
		"tensor_alloc_with_release",
		["blorp_vector_new(n)", "0"],
	):
		Ok(rendered):
			rendered == expected_alloc_release
		Err(error):
			False

	fill_inline_struct_ok: Bool = match render_prepared_tensor(
		"tensor_fill_inline_struct",
		["blorp_vector_new_fill", "Small_make(1)", ", rows, cols", "0", "Small"],
	):
		Ok(rendered):
			rendered == (
				"({ Small __fill_0 = Small_make(1); blorp_vector_new_fill_sized(&__fill_0, rows, "
				+ "cols, sizeof(Small)); })"
			)
		Err(error):
			False

	fill_boxed_release_value_ok: Bool = match render_prepared_tensor(
		"tensor_fill_boxed_release_value",
		["blorp_vector_new_fill", "boxed", ", rows, cols", "0"],
	):
		Ok(rendered):
			rendered == (
				"({ void* __fill_0 = boxed; blorp_Vector* __vec_0 = "
				+ "blorp_vector_new_fill(__fill_0, rows, cols); blorp_vector_set_elem_release(__vec"
				+ "_0, blorp_elem_release_fn); if (__fill_0) blorp_release(__fill_0); __vec_0; })"
			)
		Err(error):
			False

	fill_dim_name_ok: Bool = match render_prepared_tensor(
		"tensor_fill_dim_name",
		["0", "1"],
	):
		Ok(rendered):
			rendered == "__tensor_fill_dim_0_1"
		Err(error):
			False

	fill_total_name_ok: Bool = match render_prepared_tensor("tensor_fill_total_name", ["0"]):
		Ok(rendered):
			rendered == "__tensor_fill_total_0"
		Err(error):
			False

	fill_dim_bind_ok: Bool = match render_prepared_tensor(
		"tensor_fill_dim_bind",
		["0", "1", "cols"],
	):
		Ok(rendered):
			rendered == "long __tensor_fill_dim_0_1 = cols;"
		Err(error):
			False

	fill_dim_arg_ok: Bool = rendered_template_is("tensor_fill_dim_arg", ["cols"], ", cols")

	fill_product_expr_ok: Bool = match render_prepared_tensor(
		"tensor_fill_product_expr",
		["rows", "cols"],
	):
		Ok(rendered):
			rendered == "(rows * cols)"
		Err(error):
			False

	fill_raw_scalar_ok: Bool = match render_prepared_tensor(
		"tensor_fill_raw_scalar",
		[
			"long __tensor_fill_dim_0_0 = rows; long __tensor_fill_dim_0_1 = cols;",
			"(__tensor_fill_dim_0_0 * __tensor_fill_dim_0_1)",
			"long",
			"value",
			"blorp_tensor_new_i64(__tensor_fill_dim_0_0, __tensor_fill_total_0)",
			"0",
		],
	):
		Ok(rendered):
			rendered == (
				"({ long __tensor_fill_dim_0_0 = rows; long __tensor_fill_dim_0_1 = cols; long "
				+ "__tensor_fill_total_0 = (__tensor_fill_dim_0_0 * __tensor_fill_dim_0_1); long "
				+ "__tensor_fill_value_0 = value; blorp_Vector* __tensor_fill_vec_0 = "
				+ "blorp_tensor_new_i64(__tensor_fill_dim_0_0, __tensor_fill_total_0); long* "
				+ "__tensor_fill_raw_0 = (long*)__tensor_fill_vec_0->data; for (long "
				+ "__tensor_fill_i_0 = 0; __tensor_fill_i_0 < __tensor_fill_vec_0->capacity; "
				+ "__tensor_fill_i_0++) __tensor_fill_raw_0[__tensor_fill_i_0] = "
				+ "__tensor_fill_value_0; __tensor_fill_vec_0; })"
			)
		Err(error):
			False

	ranked_alloc_ok: Bool = match render_prepared_tensor(
		"tensor_ranked_alloc_packed",
		["rows", "total", "1"],
	):
		Ok(rendered):
			rendered == "blorp_tensor_new_packed(rows, total, 1)"
		Err(error):
			False

	literal_write_ok: Bool = match render_prepared_tensor(
		"tensor_literal_write_inline_struct",
		["vec", "i", "Point_make(1, 2)", "0", "Point"],
	):
		Ok(rendered):
			rendered == (
				"{ Point __ten_elem_0 = Point_make(1, 2); memcpy((char*)vec->data + i * "
				+ "sizeof(Point), &__ten_elem_0, sizeof(Point)); }"
			)
		Err(error):
			False

	successes_ok: Bool = (
		view_ok
		and read_ok
		and stmt_ok
		and storage_ok
		and storage_mode_pointer_ok
		and storage_mode_f64_ok
		and storage_mode_f32_ok
		and storage_mode_i64_ok
		and storage_mode_inline_ok
		and element_size_pointer_ok
		and element_size_f64_ok
		and element_size_f32_ok
		and element_size_i64_ok
		and element_size_inline_struct_ok
		and callback_boxed_struct_ok
		and callback_boxed_float_ok
		and callback_boxed_float32_ok
		and callback_bits_ok
		and raw_get_ok
		and checked_inline_struct_get_ok
		and inline_struct_element_decl_ok
		and stack_option_vector_long_ok
		and alloc_packed_ok
		and alloc_release_ok
		and fill_inline_struct_ok
		and fill_boxed_release_value_ok
		and fill_dim_name_ok
		and fill_total_name_ok
		and fill_dim_bind_ok
		and fill_dim_arg_ok
		and fill_product_expr_ok
		and fill_raw_scalar_ok
		and ranked_alloc_ok
		and literal_write_ok
	)

	successes_ok


func test_render_prepared_tensor_errors_are_typed() -> Bool:
	match render_prepared_tensor("tensor_raw_read", ["raw"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_tensor_template_name(info) == "tensor_raw_read"
						and prepared_tensor_template_arity(info) == 2
						and got == 1
					)
				UnsupportedPreparedTensorOp(name):
					False


func test_render_inline_struct_error_is_typed() -> Bool:
	match render_prepared_tensor("tensor_inline_struct_get_unchecked", ["tensor"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_tensor_template_name(info) == "tensor_inline_struct_get_unchecked"
						and prepared_tensor_template_arity(info) == 4
						and got == 1
					)
				UnsupportedPreparedTensorOp(name):
					False


func test_render_unknown_prepared_tensor_error_is_typed() -> Bool:
	match render_prepared_tensor("tensor_len", ["vec"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					False
				UnsupportedPreparedTensorOp(name):
					name == "tensor_len"


func test_render_tensor_literal_write_errors_are_typed() -> Bool:
	match render_prepared_tensor(
		"tensor_literal_write_inline_struct",
		["vec", "i", "value", "__elem"],
	):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_tensor_template_name(info) == "tensor_literal_write_inline_struct"
						and prepared_tensor_template_arity(info) == 5
						and got == 4
					)
				UnsupportedPreparedTensorOp(name):
					False


func test_render_error_to_string() -> Bool:
	unsupported_error: RenderError = UnsupportedPreparedTensorOp("missing")

	arity_text: String = match render_prepared_tensor(
		"tensor_raw_write_expr",
		["a", "b"],
	):
		Ok(rendered):
			rendered
		Err(error):
			render_error_to_string(error)

	unsupported_text: String = render_error_to_string(unsupported_error)

	(
		arity_text == "prepared tensor op tensor_raw_write_expr expected 3 arg(s), got 2"
		and unsupported_text == "unsupported prepared tensor op: missing"
	)


tests: TestSuite = {
	description = "Self-hosted compiler prepared tensor renderer",
	tests = [
		("parse template shapes", test_parse_template_shapes),
		("render prepared tensor op successes", test_render_prepared_tensor_op_successes),
		("render prepared tensor successes", test_render_prepared_tensor_successes),
		("render prepared tensor errors are typed", test_render_prepared_tensor_errors_are_typed),
		("render inline struct error is typed", test_render_inline_struct_error_is_typed),
		(
			"render unknown prepared tensor error is typed",
			test_render_unknown_prepared_tensor_error_is_typed,
		),
		(
			"render tensor literal write errors are typed",
			test_render_tensor_literal_write_errors_are_typed,
		),
		("render error to string", test_render_error_to_string),
	]
}
