import:
	../codegen_prepared_tensor_renderer:
		ALL_TEMPLATES,
		CompilerCommand(RenderManifestCommand, RenderPreparedTensorCommand, UnknownCommand),
		PreparedTensorOp(
			DataPointerGetUnchecked,
			F32RawGetUnchecked,
			F32StorageCheck,
			F64RawGetUnchecked,
			F64StorageCheck,
			I64StorageCheck,
			InlineStructGetUnchecked,
			RawRead,
			RawViewDecl,
			RawWriteExpr,
			RawWriteStmt,
			TensorInitElemRelease,
			TensorAllocF32,
			TensorAllocF64,
			TensorAllocI64,
			TensorAllocPacked,
			TensorAllocPointer,
			TensorAllocSized,
			TensorAllocWithRelease,
			TensorRankedAllocF32,
			TensorRankedAllocF64,
			TensorRankedAllocI64,
			TensorRankedAllocPacked,
			TensorRankedAllocPointer,
			TensorRankedAllocSized,
			TensorLiteralBoxedBorrowedWrite,
			TensorLiteralBoxedOwnedWrite,
			TensorLiteralBoxedWrite,
			TensorLiteralF32Write,
			TensorLiteralF64Write,
			TensorLiteralI64Write,
			TensorLiteralInlineStructWrite,
			TensorLiteralPackedWrite,
			TensorLiteralWordWrite,
			WordStorageCheck,
		),
		RenderError(UnsupportedPreparedTensorOp, WrongArity),
		parse_command,
		parse_prepared_tensor_template,
		prepared_tensor_template_arity,
		prepared_tensor_template_name,
		render_error_to_string,
		render_manifest_line,
		render_manifest_lines,
		render_prepared_tensor,
		render_prepared_tensor_op,
	test: TestSuite


func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_prepared_tensor_template(name):
		Some(info):
			(
				prepared_tensor_template_name(info) == expected_name
				and prepared_tensor_template_arity(info) == expected_arity
			)
		None:
			False


func manifest_line_is(name: String, expected: String) -> Bool:
	match parse_prepared_tensor_template(name):
		Some(info):
			render_manifest_line(info) == expected
		None:
			False


func test_parse_command_routes() -> Bool:
	render_command: CompilerCommand = parse_command("prepared-tensor")
	manifest_command: CompilerCommand = parse_command("manifest")
	unknown_command: CompilerCommand = parse_command("wat")

	render_ok: Bool = match render_command:
		RenderPreparedTensorCommand:
			True
		RenderManifestCommand:
			False
		UnknownCommand:
			False

	manifest_ok: Bool = match manifest_command:
		RenderPreparedTensorCommand:
			False
		RenderManifestCommand:
			True
		UnknownCommand:
			False

	unknown_ok: Bool = match unknown_command:
		RenderPreparedTensorCommand:
			False
		RenderManifestCommand:
			False
		UnknownCommand:
			True

	render_ok and manifest_ok and unknown_ok


func test_parse_template_shapes() -> Bool:
