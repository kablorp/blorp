import:
	../codegen_prepared_tensor_renderer:
		PreparedTensorOp(
			DataPointerGetUnchecked,
			F32RawGetUnchecked,
			F32StorageCheck,
			F64RawGetUnchecked,
			F64StorageCheck,
			I64StorageCheck,
			InlineStructGetChecked,
			InlineStructElementDecl,
			InlineStructGetUnchecked,
			InlineStructMatrixGetChecked,
			RawRead,
			RawViewDecl,
			RawWriteExpr,
			RawWriteStmt,
			StackOptionMatrixLongGet,
			StackOptionMatrixUInt128Get,
			StackOptionVectorInt128Get,
			StackOptionVectorValueRecordGet,
			TensorInitElemRelease,
			TensorAllocF32,
			TensorAllocF64,
			TensorAllocI64,
			TensorAllocPacked,
			TensorAllocPointer,
			TensorAllocSized,
			TensorAllocWithRelease,
			TensorRankedAllocF32,
			TensorRankedAllocF64,
			TensorRankedAllocI64,
			TensorRankedAllocPacked,
			TensorRankedAllocPointer,
			TensorRankedAllocSized,
			TensorLiteralBoxedBorrowedWrite,
			TensorLiteralBoxedOwnedWrite,
			TensorLiteralBoxedWrite,
			TensorLiteralF32Write,
			TensorLiteralF64Write,
			TensorLiteralI64Write,
			TensorLiteralInlineStructWrite,
			TensorLiteralConstruct,
			TensorLiteralName,
			TensorLiteralPackedWrite,
			TensorLiteralWordWrite,
			WordStorageCheck,
		),
		render_prepared_tensor_op,
	test: TestSuite


func test_render_prepared_tensor_op_successes() -> Bool:
	view_ok: Bool = render_prepared_tensor_op(RawViewDecl({
		pointer_c_type = "double*",
		view = "raw",
		source = "vec",
	})) == "double* raw = (double*)((blorp_Vector*)vec)->data"
	read_ok: Bool = render_prepared_tensor_op(RawRead("raw", "i")) == "raw[i]"
	expr_ok: Bool = render_prepared_tensor_op(RawWriteExpr({
		view = "raw",
		index = "i",
		value = "value",
	})) == "({ raw[i] = value; (void)0; })"
	stmt_ok: Bool = render_prepared_tensor_op(RawWriteStmt({
		view = "raw",
		index = "i",
		value = "value",
	})) == "raw[i] = value;"
	word_storage_ok: Bool = render_prepared_tensor_op(WordStorageCheck({
		tensor = "tensor",
		temp_seed = "0",
	})) == (
		"({ blorp_Vector* __tensor_layout_0 = (blorp_Vector*)tensor; __tensor_layout_0 "
		+ "&& __tensor_layout_0->storage_mode == BLORP_VECTOR_STORAGE_POINTER && "
		+ "__tensor_layout_0->elem_size == (int16_t)sizeof(void*) && __tensor_layout_0-"
		+ ">elem_release == NULL; })"
	)

	f64_storage_ok: Bool = render_prepared_tensor_op(F64StorageCheck({
		tensor = "tensor",
		temp_seed = "0",
	})) == (
		"({ blorp_Vector* __tensor_layout_0 = (blorp_Vector*)tensor; __tensor_layout_0 "
		+ "&& __tensor_layout_0->storage_mode == BLORP_VECTOR_STORAGE_F64 && "
		+ "__tensor_layout_0->elem_size == (int16_t)sizeof(double); })"
	)

	f32_storage_ok: Bool = render_prepared_tensor_op(F32StorageCheck({
		tensor = "tensor",
		temp_seed = "0",
	})) == (
		"({ blorp_Vector* __tensor_layout_0 = (blorp_Vector*)tensor; __tensor_layout_0 "
		+ "&& __tensor_layout_0->storage_mode == BLORP_VECTOR_STORAGE_F32 && "
		+ "__tensor_layout_0->elem_size == (int16_t)sizeof(float); })"
	)

	i64_storage_ok: Bool = render_prepared_tensor_op(I64StorageCheck({
		tensor = "tensor",
		temp_seed = "0",
	})) == (
		"({ blorp_Vector* __tensor_layout_0 = (blorp_Vector*)tensor; __tensor_layout_0 "
		+ "&& __tensor_layout_0->storage_mode == BLORP_VECTOR_STORAGE_I64 && "
		+ "__tensor_layout_0->elem_size == (int16_t)sizeof(long); })"
	)

	data_get_ok: Bool = render_prepared_tensor_op(DataPointerGetUnchecked({
		tensor = "tensor",
		index = "i",
	})) == "((blorp_Vector*)tensor)->data[i]"
	inline_struct_get_ok: Bool = render_prepared_tensor_op(InlineStructGetUnchecked({
		tensor = "tensor",
		index = "i",
		temp_seed = "0",
		struct_ty = "Small",
	})) == (
		"({ blorp_Vector* __tgu_vec_0 = (blorp_Vector*)tensor; long __tgu_idx_0 = i; "
		+ "Small __tgu_out_0; if (__builtin_expect(__tgu_vec_0->storage_mode == "
		+ "BLORP_VECTOR_STORAGE_INLINE && __tgu_vec_0->elem_size == sizeof(Small), 1)) { "
		+ "memcpy(&__tgu_out_0, (char*)__tgu_vec_0->data + __tgu_idx_0 * sizeof(Small), "
		+ "sizeof(Small)); } else { void* __tgu_raw_0 = __tgu_vec_0->data[__tgu_idx_0]; "
		+ "__tgu_out_0 = blorp_unbox_struct(__tgu_raw_0, Small); } __tgu_out_0; })"
	)

	inline_struct_element_decl_ok: Bool = render_prepared_tensor_op(InlineStructElementDecl({
		binding = "out",
		tensor = "tensor",
		index = "i",
		temp_seed = "0",
		struct_ty = "Small",
	})) == (
		"Small out = ({ blorp_Vector* __tgu_vec_0 = (blorp_Vector*)tensor; long "
		+ "__tgu_idx_0 = i; Small __tgu_out_0; if (__builtin_expect(__tgu_vec_0-"
		+ ">storage_mode == BLORP_VECTOR_STORAGE_INLINE && __tgu_vec_0->elem_size == "
		+ "sizeof(Small), 1)) { memcpy(&__tgu_out_0, (char*)__tgu_vec_0->data + "
		+ "__tgu_idx_0 * sizeof(Small), sizeof(Small)); } else { void* __tgu_raw_0 = "
		+ "__tgu_vec_0->data[__tgu_idx_0]; __tgu_out_0 = blorp_unbox_struct(__tgu_raw_0, "
		+ "Small); } __tgu_out_0; });"
	)

	inline_struct_get_checked_ok: Bool = render_prepared_tensor_op(InlineStructGetChecked({
		tensor = "tensor",
		index = "i",
		temp_seed = "0",
		struct_ty = "Small",
	})) == (
		"({ blorp_Vector* __tg_vec_0 = (blorp_Vector*)tensor; long __tg_idx_0 = i; Small "
		+ "__tg_out_0 = {0}; if (__builtin_expect(__tg_vec_0 && __tg_idx_0 >= 0 && "
		+ "__tg_idx_0 < __tg_vec_0->len, 1)) { if (__builtin_expect(__tg_vec_0-"
		+ ">storage_mode == BLORP_VECTOR_STORAGE_INLINE && __tg_vec_0->elem_size == "
		+ "sizeof(Small), 1)) { memcpy(&__tg_out_0, (char*)__tg_vec_0->data + __tg_idx_0 * "
		+ "sizeof(Small), sizeof(Small)); } else { void* __tg_raw_0 = __tg_vec_0-"
		+ ">data[__tg_idx_0]; __tg_out_0 = blorp_unbox_struct(__tg_raw_0, Small); } } "
		+ "__tg_out_0; })"
	)

	inline_struct_matrix_get_checked_ok: Bool = render_prepared_tensor_op(InlineStructMatrixGetChecked({
		tensor = "tensor",
		row = "row",
		col = "col",
		temp_seed = "0",
		struct_ty = "Small",
	})) == (
		"({ blorp_Vector* __tgm_vec_0 = (blorp_Vector*)tensor; long __tgm_row_0 = row; "
		+ "long __tgm_col_0 = col; long __tgm_cols_0 = (__tgm_vec_0 && __tgm_vec_0->len > "
		+ "0) ? __tgm_vec_0->capacity / __tgm_vec_0->len : 0; long __tgm_idx_0 = "
		+ "__tgm_row_0 * __tgm_cols_0 + __tgm_col_0; Small __tgm_out_0 = {0}; if "
		+ "(__builtin_expect(__tgm_vec_0 && __tgm_row_0 >= 0 && __tgm_col_0 >= 0 && "
		+ "__tgm_idx_0 >= 0 && __tgm_row_0 < __tgm_vec_0->len && __tgm_col_0 < "
		+ "__tgm_cols_0 && __tgm_idx_0 < __tgm_vec_0->capacity, 1)) { if "
		+ "(__builtin_expect(__tgm_vec_0->storage_mode == BLORP_VECTOR_STORAGE_INLINE && "
		+ "__tgm_vec_0->elem_size == sizeof(Small), 1)) { memcpy(&__tgm_out_0, "
		+ "(char*)__tgm_vec_0->data + __tgm_idx_0 * sizeof(Small), sizeof(Small)); } else "
		+ "{ void* __tgm_raw_0 = __tgm_vec_0->data[__tgm_idx_0]; __tgm_out_0 = "
		+ "blorp_unbox_struct(__tgm_raw_0, Small); } } __tgm_out_0; })"
	)

	stack_option_vector_value_record_ok: Bool = render_prepared_tensor_op(StackOptionVectorValueRecordGet({
		tensor = "values",
		index = "idx",
		temp_seed = "0",
		option_c_type = "blorp_StackOption_Point",
		payload_c_type = "Point",
		none_value = "{0}",
	})) == (
		"({ blorp_Vector* __gso_vec_0 = (blorp_Vector*)values; long __gso_idx_0 = idx; "
		+ "blorp_StackOption_Point __gso_result_0; if (!__gso_vec_0 || __gso_idx_0 < 0 || "
		+ "__gso_idx_0 >= __gso_vec_0->len) { __gso_result_0 = ((blorp_StackOption_Point){ "
		+ ".tag = BLORP_TAG_NONE, .value = {0} }); } else { if (__gso_vec_0->storage_mode "
		+ "== BLORP_VECTOR_STORAGE_INLINE) { Point __gso_payload_0; "
		+ "memcpy(&__gso_payload_0, (char*)__gso_vec_0->data + __gso_idx_0 * __gso_vec_0-"
		+ ">elem_size, sizeof(Point)); __gso_result_0 = ((blorp_StackOption_Point){ .tag = "
		+ "BLORP_TAG_SOME, .value = __gso_payload_0 }); } else { void* __gso_raw_0 = "
		+ "__gso_vec_0->data[__gso_idx_0]; __gso_result_0 = ((blorp_StackOption_Point){ ."
		+ "tag = BLORP_TAG_SOME, .value = blorp_unbox_struct(__gso_raw_0, Point) }); } } "
		+ "__gso_result_0; })"
	)

	stack_option_vector_int128_ok: Bool = render_prepared_tensor_op(StackOptionVectorInt128Get({
		tensor = "values",
		index = "idx",
		temp_seed = "0",
		option_c_type = "blorp_StackOption_Int128",
		none_value = "0",
	})) == (
		"({ blorp_Vector* __gso_vec_0 = (blorp_Vector*)values; long __gso_idx_0 = idx; "
		+ "blorp_StackOption_Int128 __gso_result_0; if (!__gso_vec_0 || __gso_idx_0 < 0 || "
		+ "__gso_idx_0 >= __gso_vec_0->len) { __gso_result_0 = "
		+ "((blorp_StackOption_Int128){ .tag = BLORP_TAG_NONE, .value = 0 }); } else { "
		+ "void* __gso_raw_0 = __gso_vec_0->data[__gso_idx_0]; __gso_result_0 = "
		+ "((blorp_StackOption_Int128){ .tag = BLORP_TAG_SOME, .value = "
		+ "blorp_unbox_int128(__gso_raw_0) }); } __gso_result_0; })"
	)

	stack_option_matrix_long_ok: Bool = render_prepared_tensor_op(StackOptionMatrixLongGet({
		tensor = "values",
		row = "row",
		col = "col",
		temp_seed = "0",
		option_c_type = "blorp_StackOption_Range",
		none_value = "0",
	})) == (
		"({ blorp_Vector* __gso_mat_0 = (blorp_Vector*)values; long __gso_row_0 = row; "
		+ "long __gso_col_0 = col; long __gso_cols_0 = (__gso_mat_0 && __gso_mat_0->len > "
		+ "0) ? __gso_mat_0->capacity / __gso_mat_0->len : 0; long __gso_idx_0 = "
		+ "__gso_row_0 * __gso_cols_0 + __gso_col_0; blorp_StackOption_Range "
		+ "__gso_result_0; if (!__gso_mat_0 || __gso_row_0 < 0 || __gso_col_0 < 0 || "
		+ "__gso_idx_0 < 0 || __gso_idx_0 >= __gso_mat_0->capacity) { __gso_result_0 = "
		+ "((blorp_StackOption_Range){ .tag = BLORP_TAG_NONE, .value = 0 }); } else { "
		+ "__gso_result_0 = ((blorp_StackOption_Range){ .tag = BLORP_TAG_SOME, .value = "
		+ "blorp_vector_read_i64(__gso_mat_0, __gso_idx_0) }); } __gso_result_0; })"
	)

	stack_option_matrix_uint128_ok: Bool = render_prepared_tensor_op(StackOptionMatrixUInt128Get({
		tensor = "values",
		row = "row",
		col = "col",
		temp_seed = "0",
		option_c_type = "blorp_StackOption_UInt128",
		none_value = "0",
	})) == (
		"({ blorp_Vector* __gso_mat_0 = (blorp_Vector*)values; long __gso_row_0 = row; "
		+ "long __gso_col_0 = col; long __gso_cols_0 = (__gso_mat_0 && __gso_mat_0->len > "
		+ "0) ? __gso_mat_0->capacity / __gso_mat_0->len : 0; long __gso_idx_0 = "
		+ "__gso_row_0 * __gso_cols_0 + __gso_col_0; blorp_StackOption_UInt128 "
		+ "__gso_result_0; if (!__gso_mat_0 || __gso_row_0 < 0 || __gso_col_0 < 0 || "
		+ "__gso_idx_0 < 0 || __gso_idx_0 >= __gso_mat_0->capacity) { __gso_result_0 = "
		+ "((blorp_StackOption_UInt128){ .tag = BLORP_TAG_NONE, .value = 0 }); } else { "
		+ "void* __gso_raw_0 = __gso_mat_0->data[__gso_idx_0]; __gso_result_0 = "
		+ "((blorp_StackOption_UInt128){ .tag = BLORP_TAG_SOME, .value = "
		+ "blorp_unbox_uint128(__gso_raw_0) }); } __gso_result_0; })"
	)

	f64_raw_get_ok: Bool = render_prepared_tensor_op(F64RawGetUnchecked({
		tensor = "tensor",
		index = "i",
		temp_seed = "0",
	})) == (
		"({ blorp_Vector* __tensor_raw_vec_0 = (blorp_Vector*)tensor; long "
		+ "__tensor_raw_idx_0 = i; double __tensor_raw_0; memcpy(&__tensor_raw_0, "
		+ "(char*)__tensor_raw_vec_0->data + __tensor_raw_idx_0 * sizeof(double), "
		+ "sizeof(double)); __tensor_raw_0; })"
	)

	f32_raw_get_ok: Bool = render_prepared_tensor_op(F32RawGetUnchecked({
		tensor = "tensor",
		index = "i",
		temp_seed = "0",
	})) == (
		"({ blorp_Vector* __tensor_raw_vec_0 = (blorp_Vector*)tensor; long "
		+ "__tensor_raw_idx_0 = i; float __tensor_raw_0; memcpy(&__tensor_raw_0, "
		+ "(char*)__tensor_raw_vec_0->data + __tensor_raw_idx_0 * sizeof(float), "
		+ "sizeof(float)); __tensor_raw_0; })"
	)

	alloc_pointer_ok: Bool = render_prepared_tensor_op(
		TensorAllocPointer("n"),
	) == "blorp_vector_new(n)"
	alloc_i64_ok: Bool = render_prepared_tensor_op(TensorAllocI64("n")) == "blorp_vector_new_i64(n)"
	alloc_f64_ok: Bool = render_prepared_tensor_op(TensorAllocF64("n")) == "blorp_vector_new_f64(n)"
	alloc_f32_ok: Bool = render_prepared_tensor_op(TensorAllocF32("n")) == "blorp_vector_new_f32(n)"
	alloc_packed_ok: Bool = render_prepared_tensor_op(TensorAllocPacked({
		size = "n",
		elem_size = "4",
	})) == "blorp_vector_new_packed(n, 4)"
	alloc_sized_ok: Bool = render_prepared_tensor_op(TensorAllocSized({
		size = "n",
		struct_ty = "Small",
	})) == "blorp_vector_new_sized(n, sizeof(Small))"
	alloc_release_ok: Bool = render_prepared_tensor_op(TensorAllocWithRelease({
		alloc_expr = "blorp_vector_new(n)",
		temp_seed = "0",
	})) == (
		"({ blorp_Vector* __tensor_alloc_0 = blorp_vector_new(n); "
		+ "blorp_vector_init_elem_release(__tensor_alloc_0, blorp_elem_release_fn); "
		+ "__tensor_alloc_0; })"
	)

	ranked_alloc_pointer_ok: Bool = render_prepared_tensor_op(TensorRankedAllocPointer({
		first_dim = "rows",
		total_dim = "total",
	})) == "blorp_tensor_new(rows, total)"
	ranked_alloc_i64_ok: Bool = render_prepared_tensor_op(TensorRankedAllocI64({
		first_dim = "rows",
		total_dim = "total",
	})) == "blorp_tensor_new_i64(rows, total)"
	ranked_alloc_f64_ok: Bool = render_prepared_tensor_op(TensorRankedAllocF64({
		first_dim = "rows",
		total_dim = "total",
	})) == "blorp_tensor_new_f64(rows, total)"
	ranked_alloc_f32_ok: Bool = render_prepared_tensor_op(TensorRankedAllocF32({
		first_dim = "rows",
		total_dim = "total",
	})) == "blorp_tensor_new_f32(rows, total)"
	ranked_alloc_packed_ok: Bool = render_prepared_tensor_op(TensorRankedAllocPacked({
		first_dim = "rows",
		total_dim = "total",
		elem_size = "1",
	})) == "blorp_tensor_new_packed(rows, total, 1)"
	ranked_alloc_sized_ok: Bool = render_prepared_tensor_op(TensorRankedAllocSized({
		first_dim = "rows",
		total_dim = "total",
		struct_ty = "Small",
	})) == "blorp_tensor_new_sized(rows, total, sizeof(Small))"
	init_release_ok: Bool = render_prepared_tensor_op(
		TensorInitElemRelease(
			"vec",
		),
	) == "blorp_vector_init_elem_release(vec, blorp_elem_release_fn);"

	literal_name_ok: Bool = render_prepared_tensor_op(TensorLiteralName("0")) == "__ten_0"

	literal_construct_ok: Bool = render_prepared_tensor_op(TensorLiteralConstruct({
		tensor = "__ten_0",
		alloc_expr = "blorp_vector_new_f64(2)",
		statements = "blorp_vector_write_f64(__ten_0, 0, value);",
	})) == (
		"({ blorp_Vector* __ten_0 = blorp_vector_new_f64(2); "
		+ "blorp_vector_write_f64(__ten_0, 0, value); __ten_0; })"
	)

	literal_f32_ok: Bool = render_prepared_tensor_op(TensorLiteralF32Write({
		tensor = "vec",
		index = "i",
		value = "value",
	})) == "((float*)vec->data)[i] = value;"
	literal_f64_ok: Bool = render_prepared_tensor_op(TensorLiteralF64Write({
		tensor = "vec",
		index = "i",
		value = "value",
	})) == "blorp_vector_write_f64(vec, i, value);"
	literal_i64_ok: Bool = render_prepared_tensor_op(TensorLiteralI64Write({
		tensor = "vec",
		index = "i",
		value = "value",
	})) == "((long*)vec->data)[i] = value;"
	literal_word_ok: Bool = render_prepared_tensor_op(TensorLiteralWordWrite({
		tensor = "vec",
		index = "i",
		value = "value",
	})) == "vec->data[i] = (void*)(intptr_t)(value);"
	literal_packed_ok: Bool = render_prepared_tensor_op(TensorLiteralPackedWrite({
		tensor = "vec",
		index = "i",
		value = "value",
	})) == "blorp_packed_set(vec, i, (long)(value));"
	literal_inline_struct_ok: Bool = render_prepared_tensor_op(TensorLiteralInlineStructWrite({
		tensor = "vec",
		index = "i",
		value = "Point_make(1, 2)",
		temp_seed = "0",
		struct_ty = "Point",
	})) == (
		"{ Point __ten_elem_0 = Point_make(1, 2); memcpy((char*)vec->data + i * "
		+ "sizeof(Point), &__ten_elem_0, sizeof(Point)); }"
	)

	literal_boxed_ok: Bool = render_prepared_tensor_op(TensorLiteralBoxedWrite({
		tensor = "vec",
		index = "i",
		value = "boxed",
	})) == "vec->data[i] = boxed;"
	literal_boxed_owned_ok: Bool = render_prepared_tensor_op(TensorLiteralBoxedOwnedWrite({
		tensor = "vec",
		index = "i",
		value = "make_boxed()",
		temp_seed = "0",
	})) == "{ void* __ten_boxed_0 = make_boxed(); vec->data[i] = __ten_boxed_0; }"
	literal_boxed_borrowed_ok: Bool = render_prepared_tensor_op(TensorLiteralBoxedBorrowedWrite({
		tensor = "vec",
		index = "i",
		value = "boxed",
		temp_seed = "0",
	})) == (
		"{ void* __ten_boxed_0 = boxed; vec->data[i] = __ten_boxed_0; if (__ten_boxed_0) "
		+ "blorp_retain(__ten_boxed_0); }"
	)

	(
		view_ok
		and read_ok
		and expr_ok
		and stmt_ok
		and word_storage_ok
		and f64_storage_ok
		and f32_storage_ok
		and i64_storage_ok
		and data_get_ok
		and inline_struct_get_ok
		and inline_struct_element_decl_ok
		and inline_struct_get_checked_ok
		and inline_struct_matrix_get_checked_ok
		and stack_option_vector_value_record_ok
		and stack_option_vector_int128_ok
		and stack_option_matrix_long_ok
		and stack_option_matrix_uint128_ok
		and f64_raw_get_ok
		and f32_raw_get_ok
		and alloc_pointer_ok
		and alloc_i64_ok
		and alloc_f64_ok
		and alloc_f32_ok
		and alloc_packed_ok
		and alloc_sized_ok
		and alloc_release_ok
		and ranked_alloc_pointer_ok
		and ranked_alloc_i64_ok
		and ranked_alloc_f64_ok
		and ranked_alloc_f32_ok
		and ranked_alloc_packed_ok
		and ranked_alloc_sized_ok
		and init_release_ok
		and literal_name_ok
		and literal_construct_ok
		and literal_f32_ok
		and literal_f64_ok
		and literal_i64_ok
		and literal_word_ok
		and literal_packed_ok
		and literal_inline_struct_ok
		and literal_boxed_ok
		and literal_boxed_owned_ok
		and literal_boxed_borrowed_ok
	)


tests: TestSuite = {
	description = "Self-hosted compiler prepared tensor renderer",
	tests = [("render prepared tensor op successes", test_render_prepared_tensor_op_successes)]
}
