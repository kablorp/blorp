import:
	../codegen_prepared_tensor_renderer:
		ALL_TEMPLATES,
		CompilerCommand(RenderManifestCommand, RenderPreparedTensorCommand, UnknownCommand),
		PreparedTensorOp(
			DataPointerGetUnchecked,
			F32RawGetUnchecked,
			F32StorageCheck,
			F64RawGetUnchecked,
			F64StorageCheck,
			I64StorageCheck,
			InlineStructGetUnchecked,
			RawRead,
			RawViewDecl,
			RawWriteExpr,
			RawWriteStmt,
			TensorInitElemRelease,
			TensorAllocF32,
			TensorAllocF64,
			TensorAllocI64,
			TensorAllocPacked,
			TensorAllocPointer,
			TensorAllocSized,
			TensorAllocWithRelease,
			TensorRankedAllocF32,
			TensorRankedAllocF64,
			TensorRankedAllocI64,
			TensorRankedAllocPacked,
			TensorRankedAllocPointer,
			TensorRankedAllocSized,
			TensorLiteralBoxedRetain,
			TensorLiteralBoxedWrite,
			TensorLiteralF32Write,
			TensorLiteralF64Write,
			TensorLiteralI64Write,
			TensorLiteralInlineStructWrite,
			TensorLiteralPackedWrite,
			TensorLiteralWordWrite,
			WordStorageCheck,
		),
		RenderError(UnsupportedPreparedTensorOp, WrongArity),
		parse_command,
		parse_prepared_tensor_template,
		prepared_tensor_template_arity,
		prepared_tensor_template_name,
		render_error_to_string,
		render_manifest_line,
		render_manifest_lines,
		render_prepared_tensor,
		render_prepared_tensor_op,
	test: TestSuite


func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_prepared_tensor_template(name):
		Some(info):
			(
				prepared_tensor_template_name(info) == expected_name
				and prepared_tensor_template_arity(info) == expected_arity
			)
		None: False


func manifest_line_is(name: String, expected: String) -> Bool:
	match parse_prepared_tensor_template(name):
		Some(info): render_manifest_line(info) == expected
		None: False


func test_parse_command_routes() -> Bool:
	render_command: CompilerCommand = parse_command("prepared-tensor")
	manifest_command: CompilerCommand = parse_command("manifest")
	unknown_command: CompilerCommand = parse_command("wat")
	render_ok: Bool = match render_command:
		RenderPreparedTensorCommand: True
		RenderManifestCommand: False
		UnknownCommand: False
	manifest_ok: Bool = match manifest_command:
		RenderPreparedTensorCommand: False
		RenderManifestCommand: True
		UnknownCommand: False
	unknown_ok: Bool = match unknown_command:
		RenderPreparedTensorCommand: False
		RenderManifestCommand: False
		UnknownCommand: True
	render_ok and manifest_ok and unknown_ok


func test_parse_template_shapes() -> Bool:
	view_ok: Bool = parsed_template_has("tensor_raw_view_decl", "tensor_raw_view_decl", 3)
	read_ok: Bool = parsed_template_has("tensor_raw_read", "tensor_raw_read", 2)
	stmt_ok: Bool = parsed_template_has("tensor_raw_write_stmt", "tensor_raw_write_stmt", 3)
	word_storage_ok: Bool = parsed_template_has(
		"tensor_is_word_storage",
		"tensor_is_word_storage",
		2,
	)
	f64_storage_ok: Bool = parsed_template_has("tensor_is_f64_storage", "tensor_is_f64_storage", 2)
	f32_storage_ok: Bool = parsed_template_has("tensor_is_f32_storage", "tensor_is_f32_storage", 2)
	i64_storage_ok: Bool = parsed_template_has("tensor_is_i64_storage", "tensor_is_i64_storage", 2)
	data_get_ok: Bool = parsed_template_has(
		"tensor_data_pointer_get_unchecked",
		"tensor_data_pointer_get_unchecked",
		2,
	)
	inline_struct_get_ok: Bool = parsed_template_has(
		"tensor_inline_struct_get_unchecked",
		"tensor_inline_struct_get_unchecked",
		7,
	)
	f64_raw_get_ok: Bool = parsed_template_has(
		"tensor_get_f64_raw_unchecked",
		"tensor_get_f64_raw_unchecked",
		5,
	)
	f32_raw_get_ok: Bool = parsed_template_has(
		"tensor_get_f32_raw_unchecked",
		"tensor_get_f32_raw_unchecked",
		5,
	)
	alloc_pointer_ok: Bool = parsed_template_has("tensor_alloc_pointer", "tensor_alloc_pointer", 1)
	alloc_i64_ok: Bool = parsed_template_has("tensor_alloc_i64", "tensor_alloc_i64", 1)
	alloc_f64_ok: Bool = parsed_template_has("tensor_alloc_f64", "tensor_alloc_f64", 1)
	alloc_f32_ok: Bool = parsed_template_has("tensor_alloc_f32", "tensor_alloc_f32", 1)
	alloc_packed_ok: Bool = parsed_template_has("tensor_alloc_packed", "tensor_alloc_packed", 2)
	alloc_sized_ok: Bool = parsed_template_has("tensor_alloc_sized", "tensor_alloc_sized", 2)
	alloc_release_ok: Bool = parsed_template_has(
		"tensor_alloc_with_release",
		"tensor_alloc_with_release",
		2,
	)
	ranked_alloc_pointer_ok: Bool = parsed_template_has(
		"tensor_ranked_alloc_pointer",
		"tensor_ranked_alloc_pointer",
		2,
	)
	ranked_alloc_i64_ok: Bool = parsed_template_has(
		"tensor_ranked_alloc_i64",
		"tensor_ranked_alloc_i64",
		2,
	)
	ranked_alloc_f64_ok: Bool = parsed_template_has(
		"tensor_ranked_alloc_f64",
		"tensor_ranked_alloc_f64",
		2,
	)
	ranked_alloc_f32_ok: Bool = parsed_template_has(
		"tensor_ranked_alloc_f32",
		"tensor_ranked_alloc_f32",
		2,
	)
	ranked_alloc_packed_ok: Bool = parsed_template_has(
		"tensor_ranked_alloc_packed",
		"tensor_ranked_alloc_packed",
		3,
	)
	ranked_alloc_sized_ok: Bool = parsed_template_has(
		"tensor_ranked_alloc_sized",
		"tensor_ranked_alloc_sized",
		3,
	)
	init_release_ok: Bool = parsed_template_has(
		"tensor_init_elem_release",
		"tensor_init_elem_release",
		1,
	)
	literal_f32_ok: Bool = parsed_template_has(
		"tensor_literal_write_f32",
		"tensor_literal_write_f32",
		3,
	)
	literal_f64_ok: Bool = parsed_template_has(
		"tensor_literal_write_f64",
		"tensor_literal_write_f64",
		3,
	)
	literal_i64_ok: Bool = parsed_template_has(
		"tensor_literal_write_i64",
		"tensor_literal_write_i64",
		3,
	)
	literal_word_ok: Bool = parsed_template_has(
		"tensor_literal_write_word",
