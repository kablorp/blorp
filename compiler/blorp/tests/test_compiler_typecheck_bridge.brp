	}
	right: TypecheckImportModule = {
		path = "right.brp",
		module_name = "shared",
		module_path = "pkg/right",
		text = "pure func right() -> Int:\n\t2",
		typecheck_program = None,
		origin = CompilerUserModule
	}
	left_first = ambiguous_source_name_graph([left, right])
	right_first = ambiguous_source_name_graph([right, left])
	expected = "module 'shared' is ambiguous; it matches 'pkg/left' and 'pkg/right'"

	(
		left_first.target.errors == right_first.target.errors
		and left_first.target.errors.contains(expected)
	)


pure func test_typed_graph_rejects_unknown_module_target() -> Bool:
	graph = compiler_typecheck_graph({
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = "func main(args: List[String]) -> Int:\n\t0",
			typecheck_program = None,
			origin = CompilerUserModule
		},
		modules = [
			{
				path = "first.brp",
				module_name = "first",
				module_path = "pkg/first",
				text = "pure func first() -> Int:\n\t1",
				typecheck_program = None,
				origin = CompilerUserModule
			},
		],
		module_targets = ["missing"],
		resolved_imports = [],
		include_comments = False,
		allow_debug_only_calls = False,
	})

	(
		graph.modules.length() == 0
		and graph.target.errors.contains("unknown typecheck module target 'missing'")
	)


pure func test_typed_graph_rejects_duplicate_module_target() -> Bool:
	graph = compiler_typecheck_graph({
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = "func main(args: List[String]) -> Int:\n\t0",
			typecheck_program = None,
			origin = CompilerUserModule
		},
		modules = [
			{
				path = "first.brp",
				module_name = "first",
				module_path = "pkg/first",
				text = "pure func first() -> Int:\n\t1",
				typecheck_program = None,
				origin = CompilerUserModule
			},
		],
		module_targets = ["pkg/first", "pkg/first"],
		resolved_imports = [],
		include_comments = False,
		allow_debug_only_calls = False,
	})

	(
		graph.modules.length() == 0
		and graph.target.errors.contains("duplicate typecheck module target 'pkg/first'")
	)


func test_streamed_graph_reports_duplicate_canonical_identity() -> Bool:
	dependency = user_import_module_json("shared", "dep", "pure func answer() -> Int:\n\t42")
	target = user_import_module_json("main", "main", "func main(args: List[String]) -> Int:\n\t0")
	request = typecheck_graph_request(
		target,
		[dependency, dependency],
		[],
	)
	expected = "duplicate canonical module identity 'shared': 'dep.brp' and 'dep.brp'"

	match (streamed_graph_responses(request, 1), chunked_graph_response_lines(request, 1)):
		(Some(responses), Some(chunked)):
			match (responses.get(0), chunked.get(0)):
				(Some(response), Some(chunked_response)):
					(
						responses.length() == 1
						and chunked.length() == 1
						and artifact_array_field(
							response,
							"type_errors",
						).any(
							func(item): as_string(item) == Some(expected),
						)
						and artifact_array_field(
							chunked_response,
							"type_errors",
						).any(
							func(item): as_string(item) == Some(expected),
						)
					)
				_:
					False
		_:
			False


func test_streamed_graph_rejects_mixed_valid_and_unknown_targets() -> Bool:
	dependency = user_import_module_json("shared", "dep", "pure func answer() -> Int:\n\t42")
	target = user_import_module_json(
		"main",
		"main",
		"import:\n\tshared\n\nfunc main(args: List[String]) -> Int:\n\tshared.answer()",
	)
	request = typecheck_graph_request(
		target,
		[dependency],
		["shared", "missing"],
	)
	expected = "unknown typecheck module target 'missing'"

	match (streamed_graph_responses(request, 1), chunked_graph_response_lines(request, 1)):
		(Some(responses), Some(chunked)):
			match (responses.get(0), chunked.get(0)):
				(Some(response), Some(chunked_response)):
					response_errors = artifact_array_field(response, "type_errors")
					chunked_errors = artifact_array_field(chunked_response, "type_errors")

					(
						responses.length() == 1
						and chunked.length() == 1
						and artifact_string_field(response, "path") == "main.brp"
						and artifact_string_field(chunked_response, "path") == "main.brp"
						and response_errors.length() == 1
						and chunked_errors.length() == 1
						and response_errors.any(func(item): as_string(item) == Some(expected))
						and chunked_errors.any(func(item): as_string(item) == Some(expected))
					)
				_:
					False
		_:
			False


