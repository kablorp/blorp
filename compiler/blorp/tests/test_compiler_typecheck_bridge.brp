private pure func typed_function_callable_id(
	program: CompilerTypedProgram,
	name: String,
) -> Option[Int]:
	var result: Option[Int] = None

	for decl in program.decls:
		match decl:
			CompilerTypedFunctionDecl(info):
				if info.decl.name.text == name:
					result = info.callable_id
					break
			CompilerTypedPrivateDecl(CompilerTypedFunctionDecl(info)):
				if info.decl.name.text == name:
					result = info.callable_id
					break
			_:
				void

	result


private pure func typed_function_body_call_id(
	program: CompilerTypedProgram,
	name: String,
) -> Option[Int]:
	var result: Option[Int] = None

	for decl in program.decls:
		match decl:
			CompilerTypedFunctionDecl(info):
				if info.decl.name.text == name:
					match info.body:
						Some(body):
							match compiler_typed_expr_resolved_call(body):
								Some(call):
									result = compiler_resolved_call_callable_id(call)
								None:
									void
						None:
							void

					break
			_:
				void

	result


private pure func typed_module_program(
	modules: List[CompilerTypecheckedModule],
	module_path: String,
) -> Option[CompilerTypedProgram]:
	modules
		.find(pure func(module): module.module_path == module_path)
		.map(pure func(module): module.typed_program)


private pure func typed_union_constructor_id(
	program: CompilerTypedProgram,
	type_name: String,
	constructor_name: String,
) -> Option[Int]:
	var result: Option[Int] = None

	for decl in program.decls:
		match decl:
			CompilerTypedUnionDecl(info):
				if info.decl.name.text == type_name:
					match info.variants.find(func(variant): variant.name == constructor_name):
						Some(variant):
							result = variant.def_id
						None:
							void

					break
			_:
				void

	result


pure func test_typed_graph_uses_graph_wide_definition_ids() -> Bool:
	graph = compiler_typecheck_graph({
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = "import:\n\tutil\n\nfunc main(args: List[String]) -> Int:\n\tutil.answer()",
			origin = CompilerUserModule
		},
		modules = [
			{
				path = "util.brp",
				module_name = "util",
				module_path = "util",
				text = "pure func answer() -> Int:\n\t42",
				origin = CompilerUserModule
			},
			{
				path = "color.brp",
				module_name = "color",
				module_path = "color",
				text = "enum Color:\n\tRed",
				origin = CompilerUserModule
			},
			{
				path = "signal.brp",
				module_name = "signal",
				module_path = "signal",
				text = "union Signal:\n\tRed(Int)",
				origin = CompilerUserModule
			},
		],
		module_targets = ["util", "color", "signal"],
		resolved_imports = [
			{
				from_path = "main.brp",
				from_module = "main",
				import_path = "util",
				resolved_module = "util"
			},
		],
		include_comments = False,
		allow_debug_only_calls = False,
	})

	match (
		typed_module_program(graph.modules, "util"),
		typed_module_program(graph.modules, "color"),
		typed_module_program(graph.modules, "signal"),
	):
		(Some(util_program), Some(color_program), Some(signal_program)):
			match (
				typed_function_callable_id(util_program, "answer"),
				typed_function_body_call_id(graph.target.typed_program, "main"),
				typed_union_constructor_id(color_program, "Color", "Red"),
				typed_union_constructor_id(signal_program, "Signal", "Red"),
			):
				(Some(answer_id), Some(call_id), Some(color_red_id), Some(signal_red_id)):
					answer_id == call_id and color_red_id != signal_red_id
				_:
					False
		_:
			False


