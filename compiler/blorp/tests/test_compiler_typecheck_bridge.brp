private pure func typed_function_callable_id(program: TypedProgram, name: String) -> Option[Int]:
	var result: Option[Int] = None

	for decl in program.decls:
		match decl:
			TypedFunctionDecl(info):
				if info.decl.name.text == name:
					result = info.callable_id
					break
			TypedPrivateDecl(TypedFunctionDecl(info)):
				if info.decl.name.text == name:
					result = info.callable_id
					break
			_:
				void

	result


private pure func typed_function_body_call_id(program: TypedProgram, name: String) -> Option[Int]:
	var result: Option[Int] = None

	for decl in program.decls:
		match decl:
			TypedFunctionDecl(info):
				if info.decl.name.text == name:
					match info.body:
						Some(body):
							match typed_expr_resolved_call(body):
								Some(call):
									result = resolved_call_callable_id(call)
								None:
									void
						None:
							void

					break
			_:
				void

	result


private pure func typed_function_body_call_module_path(
	program: TypedProgram,
	name: String,
) -> Option[String]:
	var result: Option[String] = None

	for decl in program.decls:
		match decl:
			TypedFunctionDecl(info):
				if info.decl.name.text == name:
					match info.body:
						Some(body):
							match typed_expr_resolved_call(body):
								Some(call):
									match call.target:
										ResolvedTraitMethodCall(_, Some(target)):
											result = Some(target.module_path)
										_:
											void
								None:
									void
						None:
							void

					break
			_:
				void

	result


private pure func typed_expr_callee_call_module_path(expr: TypedExpr) -> Option[String]:
	match expr:
		TypedCallExpr(callee, _, _, _):
			match typed_expr_resolved_call(callee):
				Some(call):
					match call.target:
						ResolvedTraitMethodCall(_, Some(target)):
							Some(target.module_path)
						_:
							None
				None:
					None
		TypedBlockExpr(items, _, _):
			match items.get(items.length() - 1):
				Some(last):
					typed_expr_callee_call_module_path(last)
				None:
					None
		_:
			None


private pure func typed_function_body_callee_call_module_path(
	program: TypedProgram,
	name: String,
) -> Option[String]:
	var result: Option[String] = None

	for decl in program.decls:
		match decl:
			TypedFunctionDecl(info):
				if info.decl.name.text == name:
					match info.body:
						Some(body):
							result = typed_expr_callee_call_module_path(body)
						None:
							void

					break
			_:
				void

	result


private pure func typed_module_program(
	modules: List[CompilerTypecheckedModule],
	module_path: String,
) -> Option[TypedProgram]:
	modules
		.find(pure func(module): module.module_path == module_path)
		.map(pure func(module): module.typed_program)


private pure func typed_impl_method_callable_id(
	program: TypedProgram,
	trait_name: String,
	method_name: String,
) -> Option[Int]:
	var result: Option[Int] = None

	for decl in program.decls:
		match decl:
			TypedImplDecl(info):
				if info.decl.trait_name.text == trait_name:
					match info.methods.find(func(method): method.decl.name.text == method_name):
						Some(method):
							result = method.callable_id
						None:
							void

					break
			_:
				void

	result


private pure func typed_union_constructor_id(
	program: TypedProgram,
	type_name: String,
	constructor_name: String,
) -> Option[Int]:
	var result: Option[Int] = None

	for decl in program.decls:
		match decl:
			TypedUnionDecl(info):
				if info.decl.name.text == type_name:
					match info.variants.find(func(variant): variant.name == constructor_name):
						Some(variant):
							result = variant.def_id
						None:
							void

					break
			_:
				void

	result


private pure func deterministic_definition_id_request() -> TypecheckGraphRequest:
	{
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = "import:\n\tutil\n\nfunc main(args: List[String]) -> Int:\n\tutil.answer()",
			typecheck_program = None,
			origin = CompilerUserModule
		},
		modules = [
			{
				path = "util.brp",
				module_name = "util",
				module_path = "util",
				text = "union Signal:\n\tReady\n\npure func answer() -> Int:\n\t42",
				typecheck_program = None,
				origin = CompilerUserModule
			},
		],
		module_targets = ["util"],
		resolved_imports = [
			{
				from_path = "main.brp",
				from_module = "main",
				import_path = "util",
				resolved_module = "util"
			},
		],
		include_comments = False,
		allow_debug_only_calls = False
	}


pure func test_typed_graph_definition_ids_are_deterministic() -> Bool:
	first = compiler_typecheck_graph(deterministic_definition_id_request())
	second = compiler_typecheck_graph(deterministic_definition_id_request())

	match (
		typed_module_program(first.modules, "util"),
		typed_module_program(second.modules, "util"),
	):
		(Some(first_util), Some(second_util)):
			first_main = typed_function_callable_id(first.target.typed_program, "main")
			second_main = typed_function_callable_id(second.target.typed_program, "main")
			first_answer = typed_function_callable_id(first_util, "answer")
			second_answer = typed_function_callable_id(second_util, "answer")
			first_call = typed_function_body_call_id(first.target.typed_program, "main")
			second_call = typed_function_body_call_id(second.target.typed_program, "main")
			first_ready = typed_union_constructor_id(first_util, "Signal", "Ready")
			second_ready = typed_union_constructor_id(second_util, "Signal", "Ready")

			(
				first.next_def_id == second.next_def_id
				and first_main.is_some()
				and first_answer.is_some()
				and first_call.is_some()
				and first_ready.is_some()
				and first_main == second_main
				and first_answer == second_answer
				and first_call == second_call
				and first_ready == second_ready
			)
		_:
			False


