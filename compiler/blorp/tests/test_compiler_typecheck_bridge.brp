import:
	../src/stage_06_typecheck/compiler_typecheck_bridge: handle_request
	json:
		JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_bool,
		as_string,
		get_field,
		parse_json,
	test: TestSuite


pure func request_json(action: String, payload: JsonValue) -> String:
	JsonObject([
		("schema", JsonNumber(1.0)),
		("domain", JsonString("compiler")),
		("action", JsonString(action)),
		("payload", payload),
	]).to_string()


pure func response_value(source: String) -> Option[JsonValue]:
	match parse_json(handle_request(source)):
		Ok(value):
			Some(value)
		Err(_):
			None


pure func bool_field(value: JsonValue, name: String) -> Bool:
	match get_field(value, name):
		Some(field):
			as_bool(field).get_or(False)
		None:
			False


pure func string_field(value: JsonValue, name: String) -> String:
	match get_field(value, name):
		Some(field):
			as_string(field).get_or("")
		None:
			""


pure func artifact_field(value: JsonValue, name: String) -> Option[JsonValue]:
	artifact ?= get_field(value, "artifact")
	get_field(artifact, name)


pure func artifact_string_field(value: JsonValue, name: String) -> String:
	match get_field(value, "artifact"):
		Some(artifact):
			string_field(artifact, name)
		None:
			""


pure func json_array_length(value: JsonValue, name: String) -> Int:
	match get_field(value, name):
		Some(field):
			match as_array(field):
				Some(items):
					items.length()
				None:
					-1
		None:
			-1


pure func artifact_array_length(value: JsonValue, name: String) -> Int:
	match get_field(value, "artifact"):
		Some(artifact):
			json_array_length(artifact, name)
		None:
			-1


pure func optional_string_field(value: JsonValue, name: String) -> Option[String]:
	field ?= get_field(value, name)
	as_string(field)


pure func artifact_array_field(value: JsonValue, name: String) -> List[JsonValue]:
	match get_field(value, "artifact"):
		Some(artifact):
			match get_field(artifact, name):
				Some(field):
					as_array(field).get_or([])
				None:
					[]
		None:
			[]


pure func typed_program_decls(value: JsonValue) -> List[JsonValue]:
	match artifact_field(value, "typed_program"):
		Some(typed_program):
			match get_field(typed_program, "decls"):
				Some(decls):
					as_array(decls).get_or([])
				None:
					[]
		None:
			[]


pure func json_is_non_null(value: JsonValue) -> Bool:
	match value:
		JsonNull:
			False
		_:
			True


pure func typed_program_has_impl_method_body(value: JsonValue) -> Bool:
	var found: Bool = False

	for decl in typed_program_decls(value):
		if string_field(decl, "kind") == "impl":
			match get_field(decl, "info"):
				Some(info):
					match get_field(info, "methods"):
						Some(methods_value):
							methods: List[JsonValue] = as_array(methods_value).get_or([])

							for method in methods:
								match get_field(method, "body"):
									Some(body):
										if json_is_non_null(body):
											found = True
											break
									None:
										void
						None:
							void
				None:
					void

		if found:
			break

	found


pure func resolved_call_has_alias_source(
	value: JsonValue,
	callee_name: String,
	source_name: String,
) -> Bool:
	(
		string_field(value, "callee_name") == callee_name
		and string_field(value, "source_name") == source_name
	)


pure func typed_program_body_call_has_alias_source(
	value: JsonValue,
	callee_name: String,
	source_name: String,
) -> Bool:
	var found: Bool = False

	for decl in typed_program_decls(value):
		if string_field(decl, "kind") == "function":
			match get_field(decl, "info"):
				Some(info):
					match get_field(info, "body"):
						Some(body):
							match get_field(body, "info"):
								Some(expr_info):
									match get_field(expr_info, "resolved_call"):
										Some(resolved_call):
											if resolved_call_has_alias_source(
												resolved_call,
												callee_name,
												source_name,
											):
												found = True
												break
										None:
											void
								None:
									void
						None:
							void
				None:
					void

		if found:
			break

	found


pure func import_binding_exists(
	bindings: List[JsonValue],
	local_name: String,
	module_path: String,
	original_name: Option[String],
) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if (
			string_field(binding, "local_name") == local_name
			and string_field(binding, "module_path") == module_path
			and optional_string_field(binding, "original_name") == original_name
		):
			found = True
			break

	found


pure func error_code(value: JsonValue) -> String:
	match get_field(value, "error"):
		Some(error):
			string_field(error, "code")
		None:
			""


pure func typecheck_source_request(source: String) -> String:
	request_json("typecheck_source", JsonObject([
			("path", JsonString("main.brp")),
			("module", JsonString("main")),
			("text", JsonString(source)),
		]))


pure func import_module_json(module_path: String, module_name: String, text: String) -> JsonValue:
	JsonObject([
		("path", JsonString(module_name + ".brp")),
		("module", JsonString(module_name)),
		("module_path", JsonString(module_path)),
		("text", JsonString(text)),
		("origin", JsonObject([("kind", JsonString("std"))])),
	])


pure func user_import_module_json(
	module_path: String,
	module_name: String,
	text: String,
) -> JsonValue:
	JsonObject([
		("path", JsonString(module_name + ".brp")),
		("module", JsonString(module_name)),
		("module_path", JsonString(module_path)),
		("text", JsonString(text)),
		("origin", JsonObject([("kind", JsonString("user"))])),
	])


pure func typecheck_source_request_with_imports(
	source: String,
	import_modules: List[JsonValue],
) -> String:
	request_json("typecheck_source", JsonObject([
			("path", JsonString("main.brp")),
			("module", JsonString("main")),
			("text", JsonString(source)),
			("import_modules", JsonVector(import_modules)),
		]))


pure func typecheck_sources_request(sources: List[JsonValue]) -> String:
	request_json("typecheck_sources", JsonObject([
			("sources", JsonVector(sources)),
			("include_comments", JsonBool(False)),
		]))


pure func typecheck_source_request_with_debug(
	source: String,
	allow_debug_only_calls: Bool,
) -> String:
	request_json("typecheck_source", JsonObject([
			("path", JsonString("main.brp")),
			("module", JsonString("main")),
			("text", JsonString(source)),
			("allow_debug_only_calls", JsonBool(allow_debug_only_calls)),
		]))


pure func json_string_array_contains(items: List[JsonValue], needle: String) -> Bool:
	var found: Bool = False

	for item in items:
		match as_string(item):
			Some(text):
				if text.contains(needle):
					found = True
					break
			None:
				void

	found


pure func test_typecheck_source_returns_typed_program_artifact() -> Bool:
	source: String = "func identity(value: Int) -> Int:\n\tvalue"

	match response_value(typecheck_source_request(source)):
		Some(response):
			match artifact_field(response, "typed_program"):
				Some(typed_program):
					(
						bool_field(response, "ok")
						and artifact_string_field(response, "ast_phase") == "typecheck_source"
						and string_field(typed_program, "kind") == "typed_program"
						and json_array_length(typed_program, "decls") == 1
						and json_array_length(typed_program, "diagnostics") == 0
						and artifact_array_length(response, "type_errors") == 0
						and typed_program
							.to_string()
							.contains("identity")
					)
				None:
					False
		None:
			False


pure func test_typecheck_source_accepts_main_args_signature() -> Bool:
	source: String = "func main(args: List[String]) -> Int:\n\t0"

	match response_value(typecheck_source_request(source)):
		Some(response):
			match artifact_field(response, "typed_program"):
				Some(typed_program):
					(
						bool_field(response, "ok")
						and json_array_length(typed_program, "decls") == 1
						and artifact_array_length(response, "type_errors") == 0
					)
				None:
					False
		None:
			False


pure func test_typecheck_source_reports_type_errors() -> Bool:
	source: String = "func bad() -> Int:\n\t\"no\""

	match response_value(typecheck_source_request(source)):
		Some(response):
			(
				bool_field(response, "ok")
				and artifact_array_length(response, "type_errors") > 0
				and artifact_field(response, "typed_program").is_some()
			)
		None:
			False


pure func test_typecheck_source_marks_self_contained_ctfe_evaluated() -> Bool:
	source: String = "VALUE: Int = 1 + 2\n\nfunc main(args: List[String]) -> Int:\n\tVALUE"

	match response_value(typecheck_source_request(source)):
		Some(response):
			(
				bool_field(response, "ok")
				and artifact_string_field(response, "ctfe_status") == "evaluated"
				and artifact_array_length(response, "type_errors") == 0
			)
		None:
			False


pure func test_typecheck_source_reports_unsupported_import_ctfe() -> Bool:
	source: String = "import:\n\tdep as Dep\n\nVALUE: String = Dep.answer()\n\nfunc main(args: List[String]) -> Int:\n\t0"
	dep_text: String = "pure func answer() -> String:\n\t3.to_string()"

	match response_value(
		typecheck_source_request_with_imports(
			source,
			[user_import_module_json("dep", "dep", dep_text)],
		),
	):
		Some(response):
			(
				bool_field(response, "ok")
				and artifact_string_field(response, "ctfe_status") == "not_run"
				and artifact_array_length(response, "type_errors") > 0
			)
		None:
			False


