pure func test_typecheck_source_uses_imported_trait_method_as_ufcs() -> Bool:
	source: String = "import:\n\tdep: Reader, read_text\n\nfunc read(reader: Reader) -> String:\n\treader.read_text()"
	dep_text: String = "trait TextReader:\n\tfunc read_text(value: Self) -> String\n\nrecord Reader {value: String}\n\nimplements TextReader for Reader:\n\tfunc read_text(reader: Reader) -> String:\n\t\treader.value"

	match response_value(
		typecheck_source_request_with_imports(
			source,
			[import_module_json("dep", "dep", dep_text)],
		),
	):
		Some(response):
			bool_field(response, "ok") and artifact_array_length(response, "type_errors") == 0
		None:
			False


pure func resource_trait_dep_text() -> String:
	"resource type Handle = builtin(\"close_handle\")\n\nunion IOError:\n\tOther(String)\n\ntrait Readable:\n\tfunc read_text(handle: Self) -> Result[String, IOError]\n\nfunc open_handle(path: String) -> Result[Handle, IOError]:\n\tbuiltin(\"open_handle\")\n\nimplements Readable for Handle:\n\t@resource_result_ordinary\n\tfunc read_text(handle: Handle) -> Result[String, IOError]:\n\t\tbuiltin(\"read_handle\")"


pure func test_typecheck_source_preserves_resource_policy_for_trait_method_ufcs() -> Bool:
	source: String = "import:\n\tdep: Handle, IOError, open_handle, read_text\n\nfunc read(path: String) -> Result[String, IOError]:\n\twith handle ?= open_handle(path):\n\t\thandle.read_text()"
	dep_text: String = resource_trait_dep_text()

	match response_value(
		typecheck_source_request_with_imports(
			source,
			[import_module_json("dep", "dep", dep_text)],
		),
	):
		Some(response):
			bool_field(response, "ok") and artifact_array_length(response, "type_errors") == 0
		None:
			False


pure func test_typecheck_source_preserves_resource_policy_for_direct_trait_method() -> Bool:
	source: String = "import:\n\tdep: Handle, IOError, open_handle, read_text\n\nfunc read(path: String) -> Result[String, IOError]:\n\twith handle ?= open_handle(path):\n\t\tread_text(handle)"
	dep_text: String = resource_trait_dep_text()

	match response_value(
		typecheck_source_request_with_imports(
			source,
			[import_module_json("dep", "dep", dep_text)],
		),
	):
		Some(response):
			bool_field(response, "ok") and artifact_array_length(response, "type_errors") == 0
		None:
			False


pure func test_typecheck_source_uses_trait_bounded_generic_arithmetic() -> Bool:
	source: String = "import:\n\tdep: Addable, HasZero, zero\n\npure func add_from_zero[T: Addable + HasZero](left: T, right: T) -> T:\n\tvar total: T = zero()\n\ttotal = total + left\n\ttotal + right"
	dep_text: String = "trait Addable:\n\tpure func add(a: Self, b: Self) -> Self\n\ntrait HasZero:\n\tpure func zero() -> Self"

	match response_value(
		typecheck_source_request_with_imports(
			source,
			[import_module_json("dep", "dep", dep_text)],
		),
	):
		Some(response):
			bool_field(response, "ok") and artifact_array_length(response, "type_errors") == 0
		None:
			False


pure func test_typecheck_source_accepts_generic_impl_method_signature() -> Bool:
	source: String = "import:\n\tdep: Stringable\n\nrecord Box[T] {value: T}\n\nimplements Stringable for Box[T:Stringable]:\n\tpure func to_string[T](self: Box[T]) -> String:\n\t\t\"box\""
	dep_text: String = "trait Stringable:\n\tpure func to_string(value: Self) -> String"

	match response_value(
		typecheck_source_request_with_imports(
			source,
			[import_module_json("dep", "dep", dep_text)],
		),
	):
		Some(response):
			bool_field(response, "ok") and artifact_array_length(response, "type_errors") == 0
		None:
			False


pure func test_typecheck_source_rejects_bare_qualified_only_import() -> Bool:
	source: String = "import:\n\tdep as Dep\n\nfunc identity() -> Int:\n\tanswer()"
	dep_text: String = "pure func answer() -> Int:\n\t1"

	match response_value(
		typecheck_source_request_with_imports(
			source,
			[import_module_json("dep", "dep", dep_text)],
		),
	):
		Some(response):
			errors: List[JsonValue] = artifact_array_field(response, "type_errors")

			(
				bool_field(response, "ok")
				and json_string_array_contains(errors, "Unbound value `answer`")
			)
		None:
			False


pure func test_typecheck_source_rejects_private_qualified_import() -> Bool:
	source: String = "import:\n\tdep as Dep\n\nfunc identity() -> Int:\n\tDep.secret()"
	dep_text: String = "private pure func secret() -> Int:\n\t1"

	match response_value(
		typecheck_source_request_with_imports(
			source,
			[import_module_json("dep", "dep", dep_text)],
		),
	):
		Some(response):
			errors: List[JsonValue] = artifact_array_field(response, "type_errors")

			(
				bool_field(response, "ok")
				and json_string_array_contains(errors, "has no function `secret`")
			)
		None:
			False


pure func debug_only_source() -> String:
	"@debug_only\npure func inspect() -> Int:\n\t1\n\nfunc use_it() -> Int:\n\tinspect()"


pure func test_typecheck_source_rejects_debug_only_call_by_default() -> Bool:
	match response_value(typecheck_source_request(debug_only_source())):
		Some(response):
			errors: List[JsonValue] = artifact_array_field(response, "type_errors")

			(
				bool_field(response, "ok")
				and json_string_array_contains(
					errors,
					"debug-only function 'inspect' can only be used inside a debug: block",
				)
			)
		None:
			False


pure func test_typecheck_source_allows_debug_only_call_when_enabled() -> Bool:
	match response_value(typecheck_source_request_with_debug(debug_only_source(), True)):
		Some(response):
			bool_field(response, "ok") and artifact_array_length(response, "type_errors") == 0
		None:
			False


pure func test_typecheck_source_allows_debug_only_call_inside_debug_block() -> Bool:
	source: String = "@debug_only\npure func inspect() -> Int:\n\t1\n\nfunc use_it() -> Int:\n\tdebug:\n\t\tinspect()\n\t0"

	match response_value(typecheck_source_request(source)):
		Some(response):
			bool_field(response, "ok") and artifact_array_length(response, "type_errors") == 0
		None:
			False


pure func test_typecheck_source_rejects_wrong_action() -> Bool:
	request: String = request_json("parse_source", JsonObject([]))

	match response_value(request):
		Some(response):
			not bool_field(response, "ok") and error_code(response) == "unsupported_action"
		None:
			False


pure func test_typecheck_source_requires_text() -> Bool:
	request: String = request_json("typecheck_source", JsonObject([
			("path", JsonString("main.brp")),
			("module", JsonString("main")),
		]))

	match response_value(request):
		Some(response):
			not bool_field(response, "ok") and error_code(response) == "invalid_request"
		None:
			False


