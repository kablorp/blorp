pure func test_typecheck_source_preserves_independent_accept_result() -> Bool:
	source: String =
		|import:
		|	dep: Error, Listener, Stream, accept, listen
		|
		|func serve() -> Result[Int, Error]:
		|	with listener ?= listen():
		|		with first ?= accept(listener):
		|			with second ?= accept(listener):
		|				Ok(0)
	dep_text: String =
		|resource type Listener = builtin("close_listener")
		|resource type Stream = builtin("close_stream")
		|
		|union Error:
		|	Other(String)
		|
		|func listen() -> Result[Listener, Error]:
		|	builtin("listen")
		|
		|func accept(listener: Listener) -> Result[Stream, Error]:
		|	builtin("blorp_tcp_accept_raw")

	match response_value(
		typecheck_source_request_with_imports(
			source,
			[import_module_json("dep", "dep", dep_text)],
		),
	):
		Some(response):
