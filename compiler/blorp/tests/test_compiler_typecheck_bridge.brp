func test_typecheck_graph_preserves_qualified_trait_method_resolution() -> Bool:
	traits: JsonValue = import_module_json(
		"std/traits",
		"traits",
		"trait Stringable:\n\tpure func to_string(value: Self) -> String",
	)
	slice_source: String =
		|import:
		|	traits: Stringable
		|
		|type StringSlice = builtin
		|
		|implements Stringable for StringSlice:
		|	pure func to_string(value: StringSlice) -> String:
		|		builtin("std/slice.to_string")
	slice: JsonValue = import_module_json("std/slice", "slice", slice_source)
	subject_source: String =
		|import:
		|	slice as S
		|
		|pure func render(value: S.StringSlice) -> String:
		|	S.to_string(value)
	subject: JsonValue = user_import_module_json("subject", "subject", subject_source)
	target: JsonValue = user_import_module_json(
		"main",
		"main",
		"func main(args: List[String]) -> Int:\n\t0",
	)

	match (
		streamed_graph_responses(
			typecheck_graph_request(
				target,
				[traits, slice, subject],
				["subject"],
			),
			2,
		)
	):
		Some(responses):
			subject_response = responses.get_or(0, JsonNull)

			match artifact_field(subject_response, "typed_program"):
				Some(program):
					(
						artifact_array_length(subject_response, "type_errors") == 0
						and json_contains_resolved_trait_call(program, "to_string", "std/slice")
					)
				None:
					False
		None:
			False


