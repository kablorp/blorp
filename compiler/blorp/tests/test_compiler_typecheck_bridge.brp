pure func test_typed_graph_api_returns_in_memory_results() -> Bool:
	graph = compiler_typecheck_graph({
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = "import:\n\tutil\n\nfunc main(args: List[String]) -> Int:\n\tutil.answer()",
			origin = CompilerUserModule
		},
		modules = [
			{
				path = "util.brp",
				module_name = "util",
				module_path = "util",
				text = "pure func answer() -> Int:\n\t42",
				origin = CompilerUserModule
			},
		],
		module_targets = ["util"],
		resolved_imports = [
			{
				from_path = "main.brp",
				from_module = "main",
				import_path = "util",
				resolved_module = "util"
			},
		],
		include_comments = False,
		allow_debug_only_calls = False,
	})

	(
		graph.target.path == "main.brp"
		and graph.target.errors.length() == 0
		and graph.target.ctfe_evaluated
		and graph.target.import_bindings.length() == 1
		and graph.modules.length() == 1
		and graph.modules
			.get(0)
			.map(func(module): module.module_path) == Some("util")
	)


