pure func test_typecheck_source_sees_global_conversion_builtins() -> Bool:
	source: String = "pure func convert(value: Int) -> Float:\n\tto_float(value)\n\npure func narrow(value: Float) -> Int:\n\tto_int(value)"

	match response_value(typecheck_source_request(source)):
		Some(response):
			bool_field(response, "ok") and artifact_array_length(response, "type_errors") == 0
		None:
			False


