import:
	../src/stage_05_types/compiler_context:
		CompilerModuleOrigin(CompilerStdlibModule, CompilerUserModule),
	../src/stage_06_typecheck/compiler_infer:
		compiler_resolved_call_callable_id,
		compiler_typed_expr_resolved_call,
	../src/stage_06_typecheck/compiler_typecheck_bridge:
		CompilerTypecheckedModule,
		compiler_typecheck_graph,
		handle_request,
		stream_typecheck_graph_request_value,
	../src/stage_06_typecheck/compiler_typecheck_decl:
		CompilerTypedDecl(
			CompilerTypedFunctionDecl,
			CompilerTypedPrivateDecl,
			CompilerTypedUnionDecl,
		),
		CompilerTypedProgram,
	channel: Channel, channel, recv, seal, send
	json:
		JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_bool,
		as_string,
		get_field,
		parse_json,
	test: TestSuite


pure func request_json(action: String, payload: JsonValue) -> String:
	JsonObject([
		("schema", JsonNumber(1.0)),
		("domain", JsonString("compiler")),
		("action", JsonString(action)),
		("payload", payload),
	]).to_string()


pure func response_value(source: String) -> Option[JsonValue]:
	match parse_json(handle_request(source)):
		Ok(value):
			Some(value)
		Err(_):
			None


pure func bool_field(value: JsonValue, name: String) -> Bool:
	match get_field(value, name):
		Some(field):
			as_bool(field).get_or(False)
		None:
			False


pure func string_field(value: JsonValue, name: String) -> String:
	match get_field(value, name):
		Some(field):
			as_string(field).get_or("")
		None:
			""


pure func artifact_field(value: JsonValue, name: String) -> Option[JsonValue]:
	artifact ?= get_field(value, "artifact")
	get_field(artifact, name)


pure func artifact_string_field(value: JsonValue, name: String) -> String:
	match get_field(value, "artifact"):
		Some(artifact):
			string_field(artifact, name)
		None:
			""


pure func json_array_length(value: JsonValue, name: String) -> Int:
	match get_field(value, name):
		Some(field):
			match as_array(field):
				Some(items):
					items.length()
				None:
					-1
		None:
			-1


pure func artifact_array_length(value: JsonValue, name: String) -> Int:
	match get_field(value, "artifact"):
		Some(artifact):
			json_array_length(artifact, name)
		None:
			-1


pure func optional_string_field(value: JsonValue, name: String) -> Option[String]:
	field ?= get_field(value, name)
	as_string(field)


pure func artifact_array_field(value: JsonValue, name: String) -> List[JsonValue]:
	match get_field(value, "artifact"):
		Some(artifact):
			match get_field(artifact, name):
				Some(field):
					as_array(field).get_or([])
				None:
					[]
		None:
			[]


pure func typed_program_decls(value: JsonValue) -> List[JsonValue]:
	match artifact_field(value, "typed_program"):
		Some(typed_program):
			match get_field(typed_program, "decls"):
				Some(decls):
					as_array(decls).get_or([])
				None:
					[]
		None:
			[]


pure func typed_program_has_decl_kind(value: JsonValue, kind: String) -> Bool:
	var found: Bool = False

	for decl in typed_program_decls(value):
		if string_field(decl, "kind") == kind:
			found = True
			break

	found


pure func json_is_non_null(value: JsonValue) -> Bool:
	match value:
		JsonNull:
			False
		_:
			True


pure func typed_program_has_impl_method_body(value: JsonValue) -> Bool:
	var found: Bool = False

	for decl in typed_program_decls(value):
		if string_field(decl, "kind") == "impl":
			match get_field(decl, "info"):
				Some(info):
					match get_field(info, "methods"):
						Some(methods_value):
							methods: List[JsonValue] = as_array(methods_value).get_or([])

							for method in methods:
								match get_field(method, "body"):
									Some(body):
										if json_is_non_null(body):
											found = True
											break
									None:
										void
						None:
							void
				None:
					void

		if found:
			break

	found


pure func resolved_call_has_alias_source(
	value: JsonValue,
	callee_name: String,
	source_name: String,
) -> Bool:
	(
		string_field(value, "callee_name") == callee_name
		and string_field(value, "source_name") == source_name
	)


pure func typed_program_body_call_has_alias_source(
	value: JsonValue,
	callee_name: String,
	source_name: String,
) -> Bool:
	var found: Bool = False

	for decl in typed_program_decls(value):
		if string_field(decl, "kind") == "function":
			match get_field(decl, "info"):
				Some(info):
					match get_field(info, "body"):
						Some(body):
							match get_field(body, "info"):
								Some(expr_info):
									match get_field(expr_info, "resolved_call"):
										Some(resolved_call):
											if resolved_call_has_alias_source(
												resolved_call,
												callee_name,
												source_name,
											):
												found = True
												break
										None:
											void
								None:
									void
						None:
							void
				None:
					void

		if found:
			break

	found


pure func import_binding_exists(
	bindings: List[JsonValue],
	local_name: String,
	module_path: String,
	original_name: Option[String],
) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if (
			string_field(binding, "local_name") == local_name
			and string_field(binding, "module_path") == module_path
			and optional_string_field(binding, "original_name") == original_name
		):
			found = True
			break

	found


pure func error_code(value: JsonValue) -> String:
	match get_field(value, "error"):
		Some(error):
			string_field(error, "code")
		None:
			""


pure func error_message(value: JsonValue) -> String:
	match get_field(value, "error"):
		Some(error):
			string_field(error, "message")
		None:
			""


pure func typecheck_source_request(source: String) -> String:
	request_json("typecheck_source", JsonObject([
			("path", JsonString("main.brp")),
			("module", JsonString("main")),
			("text", JsonString(source)),
		]))


pure func import_module_json(module_path: String, module_name: String, text: String) -> JsonValue:
	JsonObject([
		("path", JsonString(module_name + ".brp")),
		("module", JsonString(module_name)),
		("module_path", JsonString(module_path)),
		("text", JsonString(text)),
		("origin", JsonObject([("kind", JsonString("std"))])),
	])


pure func user_import_module_json(
	module_path: String,
	module_name: String,
	text: String,
) -> JsonValue:
	JsonObject([
		("path", JsonString(module_name + ".brp")),
		("module", JsonString(module_name)),
		("module_path", JsonString(module_path)),
		("text", JsonString(text)),
		("origin", JsonObject([("kind", JsonString("user"))])),
	])


pure func typecheck_source_request_with_imports(
	source: String,
	import_modules: List[JsonValue],
) -> String:
	request_json("typecheck_source", JsonObject([
			("path", JsonString("main.brp")),
			("module", JsonString("main")),
			("text", JsonString(source)),
			("import_modules", JsonVector(import_modules)),
		]))


pure func typecheck_source_request_with_debug(
	source: String,
	allow_debug_only_calls: Bool,
) -> String:
	request_json("typecheck_source", JsonObject([
			("path", JsonString("main.brp")),
			("module", JsonString("main")),
			("text", JsonString(source)),
			("allow_debug_only_calls", JsonBool(allow_debug_only_calls)),
		]))


pure func typecheck_graph_request(
	target: JsonValue,
	modules: List[JsonValue],
	module_targets: List[String],
) -> String:
	request_json("typecheck_graph", JsonObject([
			("target", target),
			("modules", JsonVector(modules)),
			("module_targets", JsonVector(module_targets.map(
					func(path): JsonString(path),
				))),
		]))


func streamed_graph_responses(request: String, expected_count: Int) -> Option[List[JsonValue]]:
	match parse_json(request):
		Ok(root):
			responses: Channel[String] = channel(expected_count + 1)
			streamed = stream_typecheck_graph_request_value(root, func(response):
				_ = send(responses, response)
			)
			seal(responses)

			if not streamed:
				None
			else:
				var values: List[JsonValue] = []
				var failed: Bool = False

				while True:
					match recv(responses):
						Some(response):
							match parse_json(response):
								Ok(value):
									values = values.append(value)
								Err(_):
									failed = True
									break
						None:
							break

				if failed or values.length() != expected_count:
					None
				else:
					Some(values)
		Err(_):
			None


pure func json_string_array_contains(items: List[JsonValue], needle: String) -> Bool:
	var found: Bool = False

	for item in items:
		match as_string(item):
			Some(text):
				if text.contains(needle):
					found = True
					break
			None:
				void

	found


pure func test_typecheck_source_returns_typed_program_artifact() -> Bool:
	source: String = "func identity(value: Int) -> Int:\n\tvalue"

	match response_value(typecheck_source_request(source)):
		Some(response):
			match artifact_field(response, "typed_program"):
				Some(typed_program):
					(
						bool_field(response, "ok")
						and artifact_string_field(response, "ast_phase") == "typecheck_source"
						and string_field(typed_program, "kind") == "typed_program"
						and json_array_length(typed_program, "decls") == 1
						and json_array_length(typed_program, "diagnostics") == 0
						and artifact_array_length(response, "type_errors") == 0
						and typed_program
							.to_string()
							.contains("identity")
					)
				None:
					False
		None:
			False


func test_typecheck_graph_returns_module_and_target_artifacts() -> Bool:
	dep: JsonValue = user_import_module_json("dep", "dep", "pure func answer() -> Int:\n\t41")
	unused: JsonValue = user_import_module_json(
		"unused",
		"unused",
		"pure func unused_value() -> Int:\n\t0",
	)
	context: JsonValue = user_import_module_json(
		"context",
		"context",
		"pure func context_value() -> Int:\n\t0",
	)
	target: JsonValue = user_import_module_json(
		"main",
		"main",
		"import:\n\tdep: answer\n\nfunc main(args: List[String]) -> Int:\n\tanswer()",
	)

	match (
		streamed_graph_responses(
			typecheck_graph_request(
				target,
				[dep, unused, context],
				["unused", "dep"],
			),
			3,
		)
	):
		Some(responses):
			unused_response = responses.get_or(0, JsonNull)
			dep_response = responses.get_or(1, JsonNull)
			target_response = responses.get_or(2, JsonNull)

			(
				bool_field(unused_response, "ok")
				and bool_field(dep_response, "ok")
				and bool_field(target_response, "ok")
				and artifact_string_field(unused_response, "path") == "unused.brp"
				and artifact_string_field(dep_response, "path") == "dep.brp"
				and artifact_array_length(unused_response, "type_errors") == 0
				and artifact_array_length(target_response, "type_errors") == 0
			)
		None:
			False


func test_typecheck_graph_handles_shared_import_context() -> Bool:
	base: JsonValue = user_import_module_json("base", "base", "pure func answer() -> Int:\n\t41")
	left: JsonValue = user_import_module_json(
		"left",
		"left",
		"import:\n\tbase: answer\n\npure func left_value() -> Int:\n\tanswer()",
	)
	right: JsonValue = user_import_module_json(
		"right",
		"right",
		"import:\n\tbase: answer\n\npure func right_value() -> Int:\n\tanswer() + 1",
	)
	target_text: String =
		|import:
		|	left: left_value
		|	right: right_value
		|
		|func main(args: List[String]) -> Int:
		|	left_value() + right_value()
	target: JsonValue = user_import_module_json("main", "main", target_text)

	match (
		streamed_graph_responses(
			typecheck_graph_request(
				target,
				[base, left, right],
				["left", "right"],
			),
			3,
		)
	):
		Some(responses):
			left_response = responses.get_or(0, JsonNull)
			right_response = responses.get_or(1, JsonNull)
			target_response = responses.get_or(2, JsonNull)

			(
				artifact_array_length(left_response, "type_errors") == 0
				and artifact_array_length(right_response, "type_errors") == 0
				and artifact_array_length(target_response, "type_errors") == 0
			)
		None:
			False


func test_typecheck_graph_evaluates_shared_ctfe_dependency() -> Bool:
	base: JsonValue = user_import_module_json("base", "base", "answer: Int = 41")
	left_source: String =
		|import:
		|	base: answer
		|
		|left_answer: Int = answer
	left: JsonValue = user_import_module_json("left", "left", left_source)
	right_source: String =
		|import:
		|	base: answer
		|
		|right_answer: Int = answer
	right: JsonValue = user_import_module_json("right", "right", right_source)
	target_source: String =
		|import:
		|	base: answer
		|
		|main_answer: Int = answer
	target: JsonValue = user_import_module_json("main", "main", target_source)

	match (
		streamed_graph_responses(
			typecheck_graph_request(
				target,
				[base, left, right],
				["left", "right"],
			),
			3,
		)
	):
		Some(responses):
			artifact_string_field(
				responses.get_or(0, JsonNull),
				"ctfe_status",
			) == "evaluated" and artifact_string_field(
				responses.get_or(1, JsonNull),
				"ctfe_status",
			) == "evaluated" and artifact_string_field(
				responses.get_or(2, JsonNull),
				"ctfe_status",
			) == "evaluated"
		None:
			False


pure func test_typecheck_source_accepts_main_args_signature() -> Bool:
	source: String = "func main(args: List[String]) -> Int:\n\t0"

	match response_value(typecheck_source_request(source)):
		Some(response):
			match artifact_field(response, "typed_program"):
				Some(typed_program):
					(
						bool_field(response, "ok")
						and json_array_length(typed_program, "decls") == 1
						and artifact_array_length(response, "type_errors") == 0
					)
				None:
					False
		None:
			False


func test_typecheck_graph_resolves_imported_global_annotation() -> Bool:
	dep_source: String =
		|record Box {value: Int}
		|
		|pure func make_box() -> Box:
		|	{value = 1}
	dep: JsonValue = user_import_module_json("dep", "dep", dep_source)
	target_source: String =
		|import:
		|	dep: Box, make_box
		|
		|box: Box = make_box()
	target: JsonValue = user_import_module_json("main", "main", target_source)

	match streamed_graph_responses(
		typecheck_graph_request(target, [dep], []),
		1,
	):
		Some(responses):
			artifact_array_length(
				responses.get_or(0, JsonNull),
				"type_errors",
			) == 0
		None:
			False


func test_typecheck_graph_preserves_imported_opaque_record_field_owner() -> Bool:
	units: JsonValue = user_import_module_json("units", "units", "opaque type Duration = Int")
	process_source: String =
		|import:
		|	units: Duration
		|
		|record Command {timeout: Option[Duration]}
		|
		|pure func command() -> Command:
		|	{timeout = None}
	process: JsonValue = user_import_module_json("process", "process", process_source)
	target_source: String =
		|import:
		|	process: command
		|
		|func main(args: List[String]) -> Int:
		|	configured = { command() | timeout = None }
		|
		|	match configured.timeout:
		|		Some(_):
		|			1
		|		None:
		|			0
	target: JsonValue = user_import_module_json("main", "main", target_source)

	match (
		streamed_graph_responses(
			typecheck_graph_request(
				target,
				[units, process],
				["process"],
			),
			2,
		)
	):
		Some(responses):
			process_response: String = responses
				.get_or(0, JsonNull)
				.to_string()
			target_response: String = responses
				.get_or(1, JsonNull)
				.to_string()

			artifact_array_length(
				responses.get_or(0, JsonNull),
				"type_errors",
			) == 0 and artifact_array_length(
				responses.get_or(1, JsonNull),
				"type_errors",
			) == 0 and process_response.contains(
				"units::Duration",
			) and target_response.contains("units::Duration")
		None:
			False


func test_typecheck_graph_materializes_impure_function_reference() -> Bool:
	target_source: String =
		|record Suite {tests: List[() -> Bool]}
		|
		|func check() -> Bool:
		|	True
		|
		|suite: Suite = {tests = [check]}
	target: JsonValue = user_import_module_json("main", "main", target_source)

	match streamed_graph_responses(
		typecheck_graph_request(target, [], []),
		1,
	):
		Some(responses):
			artifact_array_length(
				responses.get_or(0, JsonNull),
				"type_errors",
			) == 0
		None:
			False


func test_typecheck_graph_rejects_native_package_origin_alias() -> Bool:
	target: JsonValue = JsonObject([
		("path", JsonString("main.brp")),
		("module", JsonString("main")),
		("module_path", JsonString("main")),
		("text", JsonString("value: Int = 1")),
		("origin", JsonObject([
			("kind", JsonString("native_package")),
			("package", JsonString("legacy")),
		])),
	])

	match streamed_graph_responses(
		typecheck_graph_request(target, [], []),
		1,
	):
		Some(responses):
			response = responses.get_or(0, JsonNull)

			(
				error_code(response) == "invalid_request"
				and error_message(response).contains("one of user, std, source_package, pkg")
			)
		None:
			False


