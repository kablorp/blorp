func test_typecheck_inventory_traces_internal_typecheck_phases() -> Bool:
	target: JsonValue = user_import_module_json(
		"main",
		"main",
		"pure func answer() -> Int:\n\t41\n\nvalue: Int = answer()",
	)
	request = typecheck_graph_request(target, [], [])
	inventory_entries = chunked_graph_inventory_trace_entries(request)
	normal_entries = chunked_graph_trace_entries(request)

	(
		inventory_entries.contains("typecheck_prelude_complete:main")
		and inventory_entries.contains("typecheck_reachable_imports_complete:main")
		and inventory_entries.contains("typecheck_import_decls_complete:main")
		and inventory_entries.contains("typecheck_local_impls_complete:main")
		and inventory_entries.contains("typecheck_body_decl_0_start:main")
		and inventory_entries.contains("typecheck_body_decl_0_complete:main")
		and inventory_entries.contains("typecheck_bodies_complete:main")
		and not normal_entries.contains("typecheck_prelude_complete:main")
		and not normal_entries.contains("typecheck_body_decl_0_start:main")
	)


func test_typecheck_graph_chunk_stream_inventories_retained_typed_programs() -> Bool:
	dep: JsonValue = user_import_module_json("dep", "dep", "pure func answer() -> Int:\n\t41")
	target: JsonValue = user_import_module_json(
		"main",
		"main",
		"import:\n\tdep: answer\n\nvalue: Int = answer()",
	)
	entries = chunked_graph_inventory_entries(typecheck_graph_request(target, [dep], ["dep"]))
	graph_entry = entries.find(func(entry):
		(
			entry.starts_with("graph:")
			and entry.contains("modules=1")
			and entry.contains("selected_modules=1")
			and entry.contains("ctfe_dependencies=1")
			and entry.contains("ctfe_selected_overlap=1")
			and entry.contains("callable_ids=1")
			and entry.contains("source_definition_ids=1")
		)
	)
	dependency_entry = entries.find(func(entry):
		(
			entry.starts_with("ctfe_dependency:module=dep ")
			and entry.contains("typed_decls=1")
			and entry.contains("typed_expr_nodes=2")
		)
	)
	duplicate_artifact_entry = entries.find(func(entry):
		(
			entry.starts_with("artifact:module=dep ")
			and entry.contains("duplicates_retained_ctfe=0")
			and entry.contains("reuses_retained_ctfe=1")
			and entry.contains("typed_decls=1")
			and entry.contains("typed_expr_nodes=2")
		)
	)
	target_artifact_entry = entries.find(func(entry):
		(
			entry.starts_with("artifact:module=main ")
			and entry.contains("duplicates_retained_ctfe=0")
			and entry.contains("reuses_retained_ctfe=0")
			and entry.contains("typed_decls=2")
			and entry.contains("typed_expr_nodes=1")
		)
	)
	target_ownership_entry = entries.find(func(entry):
		(
			entry.starts_with("artifact_ownership:module=main ")
			and entry.contains("after_typecheck_unique=")
			and entry.contains("after_ctfe_unique=")
			and entry.contains("after_module_construction_unique=")
			and entry.contains("before_artifact_release_unique=")
		)
	)

	(
		graph_entry.is_some()
		and dependency_entry.is_some()
		and duplicate_artifact_entry.is_some()
		and target_artifact_entry.is_some()
		and target_ownership_entry.is_some()
	)


