pure func typecheck_graph_request(
	target: JsonValue,
	modules: List[JsonValue],
	module_targets: List[String],
) -> String:
	typecheck_graph_request_with_resolved_imports(target, modules, module_targets, [])


pure func typecheck_graph_request_with_resolved_imports(
	target: JsonValue,
	modules: List[JsonValue],
	module_targets: List[String],
	resolved_imports: List[JsonValue],
) -> String:
	typecheck_graph_request_with_options(target, modules, module_targets, resolved_imports, False)


pure func typecheck_graph_request_with_options(
	target: JsonValue,
	modules: List[JsonValue],
	module_targets: List[String],
	resolved_imports: List[JsonValue],
	include_comments: Bool,
) -> String:
	request_json("typecheck_graph", JsonObject([
			("target", target),
			("modules", JsonVector(modules)),
			("module_targets", JsonVector(module_targets.map(
					func(path): JsonString(path),
				))),
			("resolved_imports", JsonVector(resolved_imports)),
			("include_comments", JsonBool(include_comments)),
		]))


func ignore_typecheck_trace(
	phase: TypecheckTracePhase,
	declaration_index: Int,
	module_name: String,
) -> Void:
	_ = typecheck_trace_phase_name(phase, declaration_index).length()
	_ = module_name.length()


func streamed_graph_responses(request: String, expected_count: Int) -> Option[List[JsonValue]]:
	match parse_json(request):
		Ok(root):
			responses: Channel[String] = channel(expected_count + 1)
			streamed = stream_typecheck_graph_request_value(root, func(response):
				_ = send(responses, response)
			)
			seal(responses)

			if not streamed:
				None
			else:
				var values: List[JsonValue] = []
				var failed: Bool = False

				while True:
					match recv(responses):
						Some(response):
							match parse_json(response):
								Ok(value):
									values = values.append(value)
								Err(_):
									failed = True
									break
						None:
							break

				if failed or values.length() != expected_count:
					None
				else:
					Some(values)
		Err(_):
			None


func chunked_graph_response_lines(request: String, expected_count: Int) -> Option[List[JsonValue]]:
	match parse_json(request):
		Ok(root):
			chunks: Channel[String] = channel(4096)
			streamed = stream_typecheck_graph_request_chunks(root
			, func(chunk):
				_ = send(chunks, chunk)
			, ignore_typecheck_trace)
			seal(chunks)

			if not streamed:
				None
			else:
				var text: String = ""

				while True:
					match recv(chunks):
						Some(chunk):
							text += chunk
						None:
							break

				lines = text
					.split("\n")
					.filter(func(line): line.length() != 0)
				var values: List[JsonValue] = []
				var failed: Bool = False

				for line in lines:
					match parse_json(line):
						Ok(value):
							values = values.append(value)
						Err(_):
							failed = True
							break

				if failed or values.length() != expected_count:
					None
				else:
					Some(values)
		Err(_):
			None


func chunked_graph_trace_entries(request: String) -> List[String]:
	match parse_json(request):
		Ok(root):
			entries: Channel[String] = channel(256)
			emit_chunk = func(chunk: String):
				_ = chunk.length()
			trace_entry = func(
				phase: TypecheckTracePhase,
				declaration_index: Int,
				module_name: String,
			):
				_ = send(
					entries,
					typecheck_trace_phase_name(phase, declaration_index) + ":" + module_name,
				)
			_ = stream_typecheck_graph_request_chunks(root, emit_chunk, trace_entry)
			seal(entries)
			var result: List[String] = []

			while True:
				match recv(entries):
					Some(entry):
						result = result.append(entry)
					None:
						break

			result
		Err(_):
			[]


func chunked_graph_inventory_trace_entries(request: String) -> List[String]:
	match parse_json(request):
		Ok(root):
			entries: Channel[String] = channel(1024)
			emit_chunk = func(chunk: String):
				_ = chunk.length()
			trace_entry = func(
				phase: TypecheckTracePhase,
				declaration_index: Int,
				module_name: String,
			):
				_ = send(
					entries,
					typecheck_trace_phase_name(phase, declaration_index) + ":" + module_name,
				)
			inventory_entry = func(kind: String, fields: String):
				_ = kind.length() + fields.length()
			_ = stream_typecheck_graph_request_chunks_with_inventory(
				root,
				emit_chunk,
				trace_entry,
				inventory_entry,
			)
			seal(entries)
			var result: List[String] = []

			while True:
				match recv(entries):
					Some(entry):
						result = result.append(entry)
					None:
						break

			result
		Err(_):
			[]


func chunked_graph_inventory_entries(request: String) -> List[String]:
	match parse_json(request):
		Ok(root):
			entries: Channel[String] = channel(256)
			emit_chunk = func(chunk: String):
				_ = chunk.length()
			trace_entry = func(
				phase: TypecheckTracePhase,
				declaration_index: Int,
				module_name: String,
			):
				_ = typecheck_trace_phase_name(
					phase,
					declaration_index,
				).length() + module_name.length()

			inventory_entry = func(kind: String, fields: String):
				_ = send(entries, kind + ":" + fields)
			_ = stream_typecheck_graph_request_chunks_with_inventory(
				root,
				emit_chunk,
				trace_entry,
				inventory_entry,
			)
			seal(entries)
			var result: List[String] = []

			while True:
				match recv(entries):
					Some(entry):
						result = result.append(entry)
					None:
						break

			result
		Err(_):
			[]


pure func json_value_lists_equal(left: List[JsonValue], right: List[JsonValue]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var index: Int = 0
		var equal: Bool = True

		while index < left.length() and equal:
			equal = left
				.get_or(index, JsonNull)
				.to_string() == right
				.get_or(index, JsonNull)
				.to_string()

			index += 1

		equal


pure func json_string_array_contains(items: List[JsonValue], needle: String) -> Bool:
	var found: Bool = False

	for item in items:
		match as_string(item):
			Some(text):
				if text.contains(needle):
					found = True
					break
			None:
				void

	found


pure func test_typecheck_source_returns_typed_program_artifact() -> Bool:
	source: String = "func identity(value: Int) -> Int:\n\tvalue"

	match response_value(typecheck_source_request(source)):
		Some(response):
			match artifact_field(response, "typed_program"):
				Some(typed_program):
					(
						bool_field(response, "ok")
						and artifact_string_field(response, "ast_phase") == "typecheck_source"
						and string_field(typed_program, "kind") == "typed_program"
						and json_array_length(typed_program, "decls") == 1
						and json_array_length(typed_program, "diagnostics") == 0
						and artifact_array_length(response, "type_errors") == 0
						and typed_program
							.to_string()
							.contains("identity")
					)
				None:
					False
		None:
			False


func test_typecheck_graph_returns_module_and_target_artifacts() -> Bool:
	dep: JsonValue = user_import_module_json("dep", "dep", "pure func answer() -> Int:\n\t41")
	unused: JsonValue = user_import_module_json(
		"unused",
		"unused",
		"pure func unused_value() -> Int:\n\t0",
	)
	context: JsonValue = user_import_module_json(
		"context",
		"context",
		"pure func context_value() -> Int:\n\t0",
	)
	target: JsonValue = user_import_module_json(
		"main",
		"main",
		"import:\n\tdep: answer\n\nfunc main(args: List[String]) -> Int:\n\tanswer()",
	)

	match (
		streamed_graph_responses(
			typecheck_graph_request(
				target,
				[dep, unused, context],
				["unused", "dep"],
			),
			3,
		)
	):
		Some(responses):
			unused_response = responses.get_or(0, JsonNull)
			dep_response = responses.get_or(1, JsonNull)
			target_response = responses.get_or(2, JsonNull)

			(
				bool_field(unused_response, "ok")
				and bool_field(dep_response, "ok")
				and bool_field(target_response, "ok")
				and artifact_string_field(unused_response, "path") == "unused.brp"
				and artifact_string_field(dep_response, "path") == "dep.brp"
				and artifact_array_length(unused_response, "type_errors") == 0
				and artifact_array_length(target_response, "type_errors") == 0
			)
		None:
			False


