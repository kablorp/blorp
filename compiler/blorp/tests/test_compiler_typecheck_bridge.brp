pure func test_typecheck_source_allows_bounded_type_param_equality() -> Bool:
	source: String = "pure func same[T: Equatable](left: T, right: T) -> Bool:\n\tleft == right"

	match response_value(typecheck_source_request(source)):
		Some(response):
