	target_source: String =
		|import:
		|	dependency: answer
		|
		|record Marker {value: Int}
		|
		|final_answer: Int = answer
	target: JsonValue = user_import_module_json("main", "main", target_source)
	request = typecheck_graph_request(target, [dependency], ["dependency"])
	entries = chunked_graph_inventory_entries(request)
	dependency_entry = entries.find(func(entry):
		(
			entry.starts_with("artifact:module=dependency ")
			and entry.contains("duplicates_retained_ctfe=1")
			and entry.contains("reuses_retained_ctfe=0")
		)
	)

	match streamed_graph_responses(request, 2):
		Some(responses):
			dependency_response = responses.get_or(0, JsonNull)
			target_response = responses.get_or(1, JsonNull)

			(
				dependency_entry.is_some()
				and artifact_array_length(dependency_response, "type_errors") == 0
				and artifact_array_length(target_response, "type_errors") == 0
				and artifact_string_field(target_response, "ctfe_status") == "evaluated"
			)
		None:
			False


