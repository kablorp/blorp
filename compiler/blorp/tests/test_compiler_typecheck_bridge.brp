pure func test_typed_graph_retains_structured_typecheck_diagnostics() -> Bool:
	graph = compiler_typecheck_graph({
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = "func main(args: List[String]) -> Int:\n\tmissing_name",
			typecheck_program = None,
			origin = CompilerUserModule
		},
		modules = [],
		module_targets = [],
		resolved_imports = [],
		include_comments = False,
		allow_debug_only_calls = False,
	})

	var found_located_error: Bool = False
	var found_located_return_error: Bool = False

	for diagnostic in graph.target.diagnostics:
		match diagnostic.span:
			Some(span):
				if (
					diagnostic.message.contains("Unbound value `missing_name`")
					and span.path == "main.brp"
					and span.start_line == 2
					and span.start_column == 5
				):
					found_located_error = True
				else if (
					diagnostic.message.contains("Function 'main' returns wrong type")
					and span.path == "main.brp"
					and span.start_line == 2
					and span.start_column == 5
				):
					found_located_return_error = True
			None:
				void

	(
		graph.target.errors.length() == 2
		and graph.target.diagnostics.length() == 2
		and found_located_error
		and found_located_return_error
	)


