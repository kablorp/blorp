pure func test_typecheck_source_materializes_imported_trait_impl_method() -> Bool:
	source: String = "import:\n\tdep: Same\n\nrecord Box {value: Int}\n\nimplements Same for Box:\n\tpure func same(a: Box, b: Box) -> Bool:\n\t\tTrue"
	dep_text: String = "trait Same:\n\tpure func same(a: Self, b: Self) -> Bool"

	match response_value(
		typecheck_source_request_with_imports(
			source,
			[import_module_json("dep", "dep", dep_text)],
		),
	):
		Some(response):
			(
				bool_field(response, "ok")
				and artifact_array_length(response, "type_errors") == 0
				and typed_program_has_impl_method_body(response)
			)
		None:
			False


