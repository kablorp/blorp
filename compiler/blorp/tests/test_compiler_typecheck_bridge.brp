private CTFE_REACHABILITY_TRACKED_GROWTH_NUMERATOR: Int = 11

private CTFE_REACHABILITY_TRACKED_GROWTH_DENOMINATOR: Int = 5


pure func request_json(action: String, payload: JsonValue) -> String:
	JsonObject([
		("schema", JsonNumber(1.0)),
		("domain", JsonString("compiler")),
		("action", JsonString(action)),
		("payload", payload),
	]).to_string()


pure func typecheck_program_fixture(
	path: String,
	module_name: String,
	source: String,
) -> FinalizedTypecheckProgram:
	ParserBridge.parsed_typecheck_source_bridge_artifact(path, module_name, source, False).program


pure func ctfe_reachability_chain_module(index: Int, module_count: Int) -> TypecheckImportModule:
	module_name = "reachability_" + index.to_string()
	value_name = "value_" + index.to_string()

	source = if index + 1 < module_count:
		next_module_name = "reachability_" + (index + 1).to_string()
		next_value_name = "value_" + (index + 1).to_string()
		"import:\n\t" + next_module_name + ": " + next_value_name + "\n\n" + value_name + ": Int = " + next_value_name
	else:
		value_name + ": Int = 42"

	path = module_name + ".brp"

	{
		path = path,
		module_name = module_name,
		module_path = module_name,
		text = source,
		typecheck_program = Some(typecheck_program_fixture(path, module_name, source)),
		origin = CompilerUserModule
	}


func ctfe_reachability_chain_tracked_allocation_count(module_count: Int) -> (Int, Bool):
	var modules: List[TypecheckImportModule] = []
	var module_targets: List[String] = []

	for index in 0..module_count:
		module = ctfe_reachability_chain_module(index, module_count)
		modules = modules.append(module)
		module_targets = module_targets.append(module.module_path)

	target_source: String =
		|import:
		|	reachability_0: value_0
		|
		|answer: Int = value_0
	target_path = "reachability_target.brp"
	target: TypecheckImportModule = {
		path = target_path,
		module_name = "reachability_target",
		module_path = "reachability_target",
		text = target_source,
		typecheck_program = Some(
			typecheck_program_fixture(
				target_path,
				"reachability_target",
				target_source,
			),
		),
		origin = CompilerUserModule
	}

	reset_mem_stats()
	graph = compiler_typecheck_graph({
		target = target,
		modules = modules,
		module_targets = module_targets,
		resolved_imports = [],
		include_comments = False,
		allow_debug_only_calls = False,
	})
	stats = get_mem_stats()
	valid = (
		graph.target.errors.length() == 0
		and graph.modules.length() == module_count
		and graph.modules.all(func(module): module.errors.length() == 0)
	)

	(stats.total_allocations, valid)


func test_typecheck_graph_target_reachability_has_bounded_tracked_allocation_growth() -> Bool:
	shallow = ctfe_reachability_chain_tracked_allocation_count(8)
	deep = ctfe_reachability_chain_tracked_allocation_count(16)
	-- This guards the former recursive visited-path allocation growth. Native
	-- Dict backing arrays are outside MemStats and are covered by the compiler
	-- instruction benchmark instead.
	bounded = deep[0] * CTFE_REACHABILITY_TRACKED_GROWTH_DENOMINATOR <= shallow[0] * CTFE_REACHABILITY_TRACKED_GROWTH_NUMERATOR

	if not bounded:
		print(
			"typecheck target reachability allocations: shallow=" + shallow[0].to_string() + " deep=" + deep[0].to_string(),
		)

	shallow[1] and deep[1] and bounded


pure func response_value(source: String) -> Option[JsonValue]:
	match parse_json(handle_request(source)):
		Ok(value):
			Some(value)
		Err(_):
			None


pure func bool_field(value: JsonValue, name: String) -> Bool:
	match get_field(value, name):
		Some(field):
			as_bool(field).get_or(False)
		None:
			False


pure func string_field(value: JsonValue, name: String) -> String:
	match get_field(value, name):
		Some(field):
			as_string(field).get_or("")
		None:
			""


pure func artifact_field(value: JsonValue, name: String) -> Option[JsonValue]:
	artifact ?= get_field(value, "artifact")
	get_field(artifact, name)


pure func artifact_string_field(value: JsonValue, name: String) -> String:
	match get_field(value, "artifact"):
		Some(artifact):
			string_field(artifact, name)
		None:
			""


pure func json_array_length(value: JsonValue, name: String) -> Int:
	match get_field(value, name):
		Some(field):
			match as_array(field):
				Some(items):
					items.length()
				None:
					-1
		None:
			-1


pure func artifact_array_length(value: JsonValue, name: String) -> Int:
	match get_field(value, "artifact"):
		Some(artifact):
			json_array_length(artifact, name)
		None:
			-1


pure func optional_string_field(value: JsonValue, name: String) -> Option[String]:
	field ?= get_field(value, name)
	as_string(field)


pure func artifact_array_field(value: JsonValue, name: String) -> List[JsonValue]:
	match get_field(value, "artifact"):
		Some(artifact):
			match get_field(artifact, name):
				Some(field):
					as_array(field).get_or([])
				None:
					[]
		None:
			[]


pure func typed_program_decls(value: JsonValue) -> List[JsonValue]:
	match artifact_field(value, "typed_program"):
		Some(typed_program):
			match get_field(typed_program, "decls"):
				Some(decls):
					as_array(decls).get_or([])
				None:
					[]
		None:
			[]


pure func typed_program_has_decl_kind(value: JsonValue, kind: String) -> Bool:
	var found: Bool = False

	for decl in typed_program_decls(value):
		if string_field(decl, "kind") == kind:
			found = True
			break

	found


pure func json_is_non_null(value: JsonValue) -> Bool:
	match value:
		JsonNull:
			False
		_:
			True


pure func json_is_resolved_trait_call(
	value: JsonValue,
	callee_name: String,
	module_path: String,
) -> Bool:
	if string_field(value, "callee_name") != callee_name:
		False
	else:
		match get_field(value, "target"):
			Some(target):
				if string_field(target, "kind") != "trait_method":
					False
				else:
					match get_field(target, "impl_target"):
						Some(impl_target):
							string_field(impl_target, "module_path") == module_path
						None:
							False
			None:
				False


pure func json_contains_resolved_trait_call(
	value: JsonValue,
	callee_name: String,
	module_path: String,
) -> Bool:
	if json_is_resolved_trait_call(value, callee_name, module_path):
		True
	else:
		match value:
			JsonObject(fields):
				fields.any(func(field):
					json_contains_resolved_trait_call(field[1], callee_name, module_path)
				)
			JsonVector(items):
				items.any(func(item):
					json_contains_resolved_trait_call(item, callee_name, module_path)
				)
			_:
				False


pure func typed_program_has_impl_method_body(value: JsonValue) -> Bool:
	var found: Bool = False

	for decl in typed_program_decls(value):
		if string_field(decl, "kind") == "impl":
			match get_field(decl, "info"):
				Some(info):
					match get_field(info, "methods"):
						Some(methods_value):
							methods: List[JsonValue] = as_array(methods_value).get_or([])

							for method in methods:
								match get_field(method, "body"):
									Some(body):
										if json_is_non_null(body):
											found = True
											break
									None:
										void
						None:
							void
				None:
					void

		if found:
			break

	found


pure func typed_program_impl_method_count(value: JsonValue) -> Int:
	var result: Int = -1

	for decl in typed_program_decls(value):
		if string_field(decl, "kind") == "impl":
			match get_field(decl, "info"):
				Some(info):
					result = json_array_length(info, "methods")
					break
				None:
					void

	result


pure func resolved_call_has_alias_source(
	value: JsonValue,
	callee_name: String,
	source_name: String,
) -> Bool:
	(
		string_field(value, "callee_name") == callee_name
		and string_field(value, "source_name") == source_name
	)


pure func typed_program_body_call_has_alias_source(
	value: JsonValue,
	callee_name: String,
	source_name: String,
) -> Bool:
	var found: Bool = False

	for decl in typed_program_decls(value):
		if string_field(decl, "kind") == "function":
			match get_field(decl, "info"):
				Some(info):
					match get_field(info, "body"):
						Some(body):
							match get_field(body, "info"):
								Some(expr_info):
									match get_field(expr_info, "resolved_call"):
										Some(resolved_call):
											if resolved_call_has_alias_source(
												resolved_call,
												callee_name,
												source_name,
											):
												found = True
												break
										None:
											void
								None:
									void
						None:
							void
				None:
					void

		if found:
			break

	found


pure func import_binding_exists(
	bindings: List[JsonValue],
	local_name: String,
	module_path: String,
	original_name: Option[String],
) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if (
			string_field(binding, "local_name") == local_name
			and string_field(binding, "module_path") == module_path
			and optional_string_field(binding, "original_name") == original_name
		):
			found = True
			break

	found


pure func error_code(value: JsonValue) -> String:
	match get_field(value, "error"):
		Some(error):
			string_field(error, "code")
		None:
			""


pure func error_message(value: JsonValue) -> String:
	match get_field(value, "error"):
		Some(error):
			string_field(error, "message")
		None:
			""


