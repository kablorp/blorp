pure func test_typed_graph_reparses_retained_program_with_stale_text() -> Bool:
	valid_source = "func main(args: List[String]) -> Int:\n\t0"
	stale_source = "func main(args: List[String]) -> Int:\n\tmissing_name"
	graph = compiler_typecheck_graph({
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = valid_source,
			typecheck_program = Some(typecheck_program_fixture("main.brp", "main", stale_source)),
			origin = CompilerUserModule
		},
		modules = [],
		module_targets = [],
		resolved_imports = [],
		include_comments = False,
		allow_debug_only_calls = False,
	})

	graph.target.errors.length() == 0 and graph.target.ctfe_evaluated


private pure func graph_errors_for_target_source(source: String) -> List[String]:
	compiler_typecheck_graph({
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = source,
			typecheck_program = None,
			origin = CompilerUserModule
		},
		modules = [],
		module_targets = [],
		resolved_imports = [],
		include_comments = False,
		allow_debug_only_calls = False,
	}).target.errors


pure func test_typed_graph_rejects_duplicate_type_declarations() -> Bool:
	graph_errors_for_target_source(
		"record Item {value: Int}\n\nunion Item:\n\tReady",
	) == ["duplicate type declaration 'Item' in module 'main'"]


pure func test_typed_graph_rejects_duplicate_trait_declarations() -> Bool:
	graph_errors_for_target_source(
		"trait Measure:\n\tpure func measure(value: Self) -> Int\n\ntrait Measure:\n\tpure func other(value: Self) -> Int",
	) == ["duplicate trait declaration 'Measure' in module 'main'"]


pure func test_typed_graph_rejects_duplicate_union_constructors() -> Bool:
	graph_errors_for_target_source(
		"union Signal:\n\tReady\n\tReady",
	) == ["duplicate constructor 'Ready' in union 'Signal' in module 'main'"]


pure func test_typed_graph_rejects_inline_value_layout_cycle() -> Bool:
	graph_errors_for_target_source(
		"struct Left {right: Right}\n\nstruct Right {left: Left}",
	) == ["Infinitely sized value layout: Left -> Right -> Left"]


