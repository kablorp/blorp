pure func test_typed_graph_ufcs_rejects_mismatched_local_generic_receiver() -> Bool:
	graph = compiler_typecheck_graph({
		target = {
			path = "main.brp",
			module_name = "main",
			module_path = "main",
			text = "import:\n\tdep: Data, HasLength\n\nrecord Cache[K, V] {key: K, value: V}\n\npure func length[K, V](cache: Cache[K, V]) -> Int:\n\t0\n\npure func measure[T](data: Data[T]) -> Int:\n\tdata.length()",
			typecheck_program = None,
			origin = CompilerUserModule
		},
		modules = [
			{
				path = "dep.brp",
				module_name = "dep",
				module_path = "dep",
				text = "trait HasLength:\n\tpure func length(self: Self) -> Int\n\nrecord Data[T] {value: T}\n\nimplements HasLength for Data[T]:\n\tpure func length[T](self: Data[T]) -> Int:\n\t\t1",
				typecheck_program = None,
				origin = CompilerUserModule
			},
		],
		module_targets = ["dep"],
		resolved_imports = [
			{
				from_path = "main.brp",
				from_module = "main",
				import_path = "dep",
				resolved_module = "dep"
			},
		],
		include_comments = False,
		allow_debug_only_calls = False,
	})
	body_call_module_path = typed_function_body_call_module_path(
		graph.target.typed_program,
		"measure",
	)

	match (
		typed_function_callable_id(graph.target.typed_program, "length"),
		typed_function_body_call_id(graph.target.typed_program, "measure"),
		typed_function_body_callee_call_module_path(graph.target.typed_program, "measure"),
		typed_module_program(graph.modules, "dep"),
	):
		(Some(local_length_id), Some(measure_call_id), Some("dep"), Some(dep_program)):
			(
				graph.target.errors.length() == 0
				and body_call_module_path == Some("dep")
				and measure_call_id != local_length_id
				and typed_impl_method_callable_id(
					dep_program,
					"HasLength",
					"length",
				) == Some(measure_call_id)
			)
		_:
			False


