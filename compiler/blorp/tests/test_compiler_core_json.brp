import:
	../compiler_core_json:
		CoreBinaryOp(
			AddOp,
			DivideOp,
			EqualOp,
			GreaterEqualOp,
			GreaterOp,
			LessEqualOp,
			LessOp,
			MultiplyOp,
			NotEqualOp,
			SubtractOp,
		),
		CoreCallKind(BuiltinCall, ClosureCall, ForeignCall, IntrinsicCall, UserCall),
		CoreDecl(FunctionDecl),
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			CallExpr,
			IfExpr,
			LetExpr,
			LiteralExpr,
			LogicalExpr,
			SeqExpr,
			UnaryExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunction,
		CoreFunctionKind(BuiltinFunction, ClosureBodyFunction, ForeignFunction, UserFunction),
		CoreJsonError(
			CoreExpectedArrayField,
			CoreExpectedBoolField,
			CoreExpectedIntField,
			CoreExpectedObject,
			CoreExpectedObjectField,
			CoreExpectedStringField,
			CoreMissingField,
			CoreUnsupportedTag,
		),
		CoreLiteral(BoolLiteral, IntLiteral, StringLiteral),
		CoreLogicalOp(AndOp, OrOp),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(KnownSourceLoc, SyntheticSourceLoc),
		CoreSourceSpan,
		CoreType(NamedType, TupleType, VoidType),
		CoreUnaryOp(NegateOp, NotOp),
		CoreVar,
		core_json_error_to_string,
		core_program_to_json,
		decode_core_program_json,
	json: JsonValue(JsonBool, JsonNumber, JsonObject, JsonString, JsonVector)
	test: TestSuite


pure func sample_loc() -> CoreSourceLoc:
	KnownSourceLoc({
		file = "main.brp",
		line = 1,
		column = 1,
		end_line = 1,
		end_column = 12,
	})


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func string_type() -> CoreType:
	NamedType("String", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func sample_var() -> CoreVar:
	{
		name = "answer",
		uniq = 0,
		def_id = Some(7)
	}


pure func sample_function() -> CoreFunction:
	param: CoreParam = {
		name = {
			name = "argc",
			uniq = 0,
			def_id = None
		},
		typ = int_type(),
		loc = sample_loc()
	}

	{
		name = "main",
		source_module = None,
		type_params = [],
		params = [param],
		return_type = int_type(),
		body = Some(
			SeqExpr(
				VarExpr(sample_var(), int_type(), sample_loc()),
				CallExpr(
					BuiltinCall("print"),
					VarExpr(sample_var(), int_type(), sample_loc()),
					[LiteralExpr(StringLiteral("done"), string_type(), sample_loc())],
					VoidType,
					SyntheticSourceLoc,
				),
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 1,
		loc = sample_loc()
	}


pure func sample_program() -> CoreProgram:
	{decls = [FunctionDecl(sample_function())]}


pure func let_function() -> CoreFunction:
	{
		name = "let_answer",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(
			LetExpr(
				sample_var(),
				False,
				int_type(),
				LiteralExpr(IntLiteral(40), int_type(), sample_loc()),
				BinaryExpr(
					AddOp,
					VarExpr(sample_var(), int_type(), sample_loc()),
					LiteralExpr(IntLiteral(2), int_type(), sample_loc()),
					int_type(),
					sample_loc(),
				),
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 8,
		loc = sample_loc()
	}


pure func let_program() -> CoreProgram:
	{decls = [FunctionDecl(let_function())]}


pure func logical_function() -> CoreFunction:
	{
		name = "logical",
		source_module = None,
		type_params = [],
		params = [],
		return_type = bool_type(),
		body = Some(
			LogicalExpr(
				AndOp,
				UnaryExpr(
					NotOp,
					LiteralExpr(BoolLiteral(False), bool_type(), sample_loc()),
					bool_type(),
					sample_loc(),
				),
				LiteralExpr(BoolLiteral(True), bool_type(), sample_loc()),
				bool_type(),
				sample_loc(),
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 9,
		loc = sample_loc()
	}


pure func logical_program() -> CoreProgram:
	{decls = [FunctionDecl(logical_function())]}


pure func assign_function() -> CoreFunction:
	{
		name = "assign",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(
			LetExpr(
				sample_var(),
				True,
				int_type(),
				LiteralExpr(IntLiteral(0), int_type(), sample_loc()),
				SeqExpr(
					AssignExpr(
						sample_var(),
						LiteralExpr(IntLiteral(1), int_type(), sample_loc()),
						VoidType,
						sample_loc(),
					),
					VarExpr(sample_var(), int_type(), sample_loc()),
				),
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 10,
		loc = sample_loc()
	}


pure func assign_program() -> CoreProgram:
	{decls = [FunctionDecl(assign_function())]}


pure func vars_equal(left: CoreVar, right: CoreVar) -> Bool:
	left.name == right.name and left.uniq == right.uniq and left.def_id == right.def_id


pure func source_spans_equal(left: CoreSourceSpan, right: CoreSourceSpan) -> Bool:
	(
		left.file == right.file
		and left.line == right.line
		and left.column == right.column
		and left.end_line == right.end_line
		and left.end_column == right.end_column
	)


pure func locs_equal(left: CoreSourceLoc, right: CoreSourceLoc) -> Bool:
	match left:
		SyntheticSourceLoc:
			match right:
				SyntheticSourceLoc:
					True
				KnownSourceLoc(right_span):
					False
		KnownSourceLoc(left_span):
			match right:
				SyntheticSourceLoc:
					False
				KnownSourceLoc(right_span):
					source_spans_equal(left_span, right_span)


pure func types_equal(left: CoreType, right: CoreType) -> Bool:
	match left:
		VoidType:
			match right:
				VoidType:
					True
				NamedType(right_name, right_args):
					False
				TupleType(right_items):
					False
		NamedType(left_name, left_args):
			match right:
				VoidType:
					False
				NamedType(right_name, right_args):
					left_name == right_name and type_lists_equal(left_args, right_args)
				TupleType(right_items):
					False
		TupleType(left_items):
			match right:
				VoidType:
					False
				NamedType(right_name, right_args):
					False
				TupleType(right_items):
					type_lists_equal(left_items, right_items)


pure func type_lists_equal(left: List[CoreType], right: List[CoreType]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var index: Int = 0
		var ok: Bool = True

		while index < left.length():
			if ok:
				match left.get(index):
					Some(left_item):
						match right.get(index):
							Some(right_item):
								ok = types_equal(left_item, right_item)
							None:
								ok = False
					None:
						ok = False

			index += 1

		ok


pure func literals_equal(left: CoreLiteral, right: CoreLiteral) -> Bool:
	match left:
		IntLiteral(left_value):
			match right:
				IntLiteral(right_value):
					left_value == right_value
				BoolLiteral(right_value):
					False
				StringLiteral(right_value):
					False
		BoolLiteral(left_value):
			match right:
				IntLiteral(right_value):
					False
				BoolLiteral(right_value):
					left_value == right_value
				StringLiteral(right_value):
					False
		StringLiteral(left_value):
			match right:
				IntLiteral(right_value):
					False
				BoolLiteral(right_value):
					False
				StringLiteral(right_value):
					left_value == right_value


pure func call_kinds_equal(left: CoreCallKind, right: CoreCallKind) -> Bool:
	match left:
		UserCall(left_name, left_def_id):
			match right:
				UserCall(right_name, right_def_id):
					left_name == right_name and left_def_id == right_def_id
				ForeignCall(right_name):
					False
				BuiltinCall(right_name):
					False
				IntrinsicCall(right_name):
					False
				ClosureCall:
					False
		ForeignCall(left_name):
			match right:
				UserCall(right_name, right_def_id):
					False
				ForeignCall(right_name):
					left_name == right_name
				BuiltinCall(right_name):
					False
				IntrinsicCall(right_name):
					False
				ClosureCall:
					False
		BuiltinCall(left_name):
			match right:
				UserCall(right_name, right_def_id):
					False
				ForeignCall(right_name):
					False
				BuiltinCall(right_name):
					left_name == right_name
				IntrinsicCall(right_name):
					False
				ClosureCall:
					False
		IntrinsicCall(left_name):
			match right:
				UserCall(right_name, right_def_id):
					False
				ForeignCall(right_name):
					False
				BuiltinCall(right_name):
					False
				IntrinsicCall(right_name):
					left_name == right_name
				ClosureCall:
					False
		ClosureCall:
			match right:
				UserCall(right_name, right_def_id):
					False
				ForeignCall(right_name):
					False
				BuiltinCall(right_name):
					False
				IntrinsicCall(right_name):
					False
				ClosureCall:
					True


pure func binary_op_rank(op: CoreBinaryOp) -> Int:
	match op:
		AddOp:
			0
		SubtractOp:
			1
		MultiplyOp:
			2
		DivideOp:
			3
		EqualOp:
			4
		NotEqualOp:
			5
		LessOp:
			6
		LessEqualOp:
			7
		GreaterOp:
			8
		GreaterEqualOp:
			9


pure func binary_ops_equal(left: CoreBinaryOp, right: CoreBinaryOp) -> Bool:
	binary_op_rank(left) == binary_op_rank(right)


pure func unary_op_rank(op: CoreUnaryOp) -> Int:
	match op:
		NegateOp:
			0
		NotOp:
			1


pure func unary_ops_equal(left: CoreUnaryOp, right: CoreUnaryOp) -> Bool:
	unary_op_rank(left) == unary_op_rank(right)


pure func logical_op_rank(op: CoreLogicalOp) -> Int:
	match op:
		AndOp:
			0
		OrOp:
			1


pure func logical_ops_equal(left: CoreLogicalOp, right: CoreLogicalOp) -> Bool:
	logical_op_rank(left) == logical_op_rank(right)


pure func exprs_equal(left: CoreExpr, right: CoreExpr) -> Bool:
	match left:
		LiteralExpr(left_literal, left_type, left_loc):
			match right:
				LiteralExpr(right_literal, right_type, right_loc):
					(
						literals_equal(left_literal, right_literal)
						and types_equal(left_type, right_type)
						and locs_equal(left_loc, right_loc)
					)
				VarExpr(right_var, right_type, right_loc):
					False
				VoidExpr(right_type, right_loc):
					False
				CallExpr(right_kind, right_callee, right_args, right_type, right_loc):
					False
				BinaryExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				UnaryExpr(right_op, right_expr, right_type, right_loc):
					False
				LogicalExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				AssignExpr(right_var, right_rhs, right_type, right_loc):
					False
				LetExpr(right_name, right_mutable, right_type, right_rhs, right_body):
					False
				SeqExpr(right_first, right_second):
					False
				IfExpr(right_cond, right_then, right_else, right_type, right_loc):
					False
		VarExpr(left_var, left_type, left_loc):
			match right:
				LiteralExpr(right_literal, right_type, right_loc):
					False
				VarExpr(right_var, right_type, right_loc):
					(
						vars_equal(left_var, right_var)
						and types_equal(left_type, right_type)
						and locs_equal(left_loc, right_loc)
					)
				VoidExpr(right_type, right_loc):
					False
				CallExpr(right_kind, right_callee, right_args, right_type, right_loc):
					False
				BinaryExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				UnaryExpr(right_op, right_expr, right_type, right_loc):
					False
				LogicalExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				AssignExpr(right_var, right_rhs, right_type, right_loc):
					False
				LetExpr(right_name, right_mutable, right_type, right_rhs, right_body):
					False
				SeqExpr(right_first, right_second):
					False
				IfExpr(right_cond, right_then, right_else, right_type, right_loc):
					False
		VoidExpr(left_type, left_loc):
			match right:
				LiteralExpr(right_literal, right_type, right_loc):
					False
				VarExpr(right_var, right_type, right_loc):
					False
				VoidExpr(right_type, right_loc):
					types_equal(left_type, right_type) and locs_equal(left_loc, right_loc)
				CallExpr(right_kind, right_callee, right_args, right_type, right_loc):
					False
				BinaryExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				UnaryExpr(right_op, right_expr, right_type, right_loc):
					False
				LogicalExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				AssignExpr(right_var, right_rhs, right_type, right_loc):
					False
				LetExpr(right_name, right_mutable, right_type, right_rhs, right_body):
					False
				SeqExpr(right_first, right_second):
					False
				IfExpr(right_cond, right_then, right_else, right_type, right_loc):
					False
		CallExpr(left_kind, left_callee, left_args, left_type, left_loc):
			match right:
				LiteralExpr(right_literal, right_type, right_loc):
					False
				VarExpr(right_var, right_type, right_loc):
					False
				VoidExpr(right_type, right_loc):
					False
				CallExpr(right_kind, right_callee, right_args, right_type, right_loc):
					(
						call_kinds_equal(left_kind, right_kind)
						and exprs_equal(left_callee, right_callee)
						and expr_lists_equal(left_args, right_args)
						and types_equal(left_type, right_type)
						and locs_equal(left_loc, right_loc)
					)
				BinaryExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				UnaryExpr(right_op, right_expr, right_type, right_loc):
					False
				LogicalExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				AssignExpr(right_var, right_rhs, right_type, right_loc):
					False
				LetExpr(right_name, right_mutable, right_type, right_rhs, right_body):
					False
				SeqExpr(right_first, right_second):
					False
				IfExpr(right_cond, right_then, right_else, right_type, right_loc):
					False
		BinaryExpr(left_op, left_left, left_right, left_type, left_loc):
			match right:
				LiteralExpr(right_literal, right_type, right_loc):
					False
				VarExpr(right_var, right_type, right_loc):
					False
				VoidExpr(right_type, right_loc):
					False
				CallExpr(right_kind, right_callee, right_args, right_type, right_loc):
					False
				BinaryExpr(right_op, right_left, right_right, right_type, right_loc):
					(
						binary_ops_equal(left_op, right_op)
						and exprs_equal(left_left, right_left)
						and exprs_equal(left_right, right_right)
						and types_equal(left_type, right_type)
						and locs_equal(left_loc, right_loc)
					)
				UnaryExpr(right_op, right_expr, right_type, right_loc):
					False
				LogicalExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				AssignExpr(right_var, right_rhs, right_type, right_loc):
					False
				LetExpr(right_name, right_mutable, right_type, right_rhs, right_body):
					False
				SeqExpr(right_first, right_second):
					False
				IfExpr(right_cond, right_then, right_else, right_type, right_loc):
					False
		UnaryExpr(left_op, left_expr, left_type, left_loc):
			match right:
				LiteralExpr(right_literal, right_type, right_loc):
					False
				VarExpr(right_var, right_type, right_loc):
					False
				VoidExpr(right_type, right_loc):
					False
				CallExpr(right_kind, right_callee, right_args, right_type, right_loc):
					False
				BinaryExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				UnaryExpr(right_op, right_expr, right_type, right_loc):
					(
						unary_ops_equal(left_op, right_op)
						and exprs_equal(left_expr, right_expr)
						and types_equal(left_type, right_type)
						and locs_equal(left_loc, right_loc)
					)
				LogicalExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				AssignExpr(right_var, right_rhs, right_type, right_loc):
					False
				LetExpr(right_name, right_mutable, right_type, right_rhs, right_body):
					False
				SeqExpr(right_first, right_second):
					False
				IfExpr(right_cond, right_then, right_else, right_type, right_loc):
					False
		LogicalExpr(left_op, left_left, left_right, left_type, left_loc):
			match right:
				LiteralExpr(right_literal, right_type, right_loc):
					False
				VarExpr(right_var, right_type, right_loc):
					False
				VoidExpr(right_type, right_loc):
					False
				CallExpr(right_kind, right_callee, right_args, right_type, right_loc):
					False
				BinaryExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				UnaryExpr(right_op, right_expr, right_type, right_loc):
					False
				LogicalExpr(right_op, right_left, right_right, right_type, right_loc):
					(
						logical_ops_equal(left_op, right_op)
						and exprs_equal(left_left, right_left)
						and exprs_equal(left_right, right_right)
						and types_equal(left_type, right_type)
						and locs_equal(left_loc, right_loc)
					)
				AssignExpr(right_var, right_rhs, right_type, right_loc):
					False
				LetExpr(right_name, right_mutable, right_type, right_rhs, right_body):
					False
				SeqExpr(right_first, right_second):
					False
				IfExpr(right_cond, right_then, right_else, right_type, right_loc):
					False
		AssignExpr(left_var, left_rhs, left_type, left_loc):
			match right:
				LiteralExpr(right_literal, right_type, right_loc):
					False
				VarExpr(right_var, right_type, right_loc):
					False
				VoidExpr(right_type, right_loc):
					False
				CallExpr(right_kind, right_callee, right_args, right_type, right_loc):
					False
				BinaryExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				UnaryExpr(right_op, right_expr, right_type, right_loc):
					False
				LogicalExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				AssignExpr(right_var, right_rhs, right_type, right_loc):
					(
						vars_equal(left_var, right_var)
						and exprs_equal(left_rhs, right_rhs)
						and types_equal(left_type, right_type)
						and locs_equal(left_loc, right_loc)
					)
				LetExpr(right_name, right_mutable, right_type, right_rhs, right_body):
					False
				SeqExpr(right_first, right_second):
					False
				IfExpr(right_cond, right_then, right_else, right_type, right_loc):
					False
		LetExpr(left_name, left_mutable, left_type, left_rhs, left_body):
			match right:
				LiteralExpr(right_literal, right_type, right_loc):
					False
				VarExpr(right_var, right_type, right_loc):
					False
				VoidExpr(right_type, right_loc):
					False
				CallExpr(right_kind, right_callee, right_args, right_type, right_loc):
					False
				BinaryExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				UnaryExpr(right_op, right_expr, right_type, right_loc):
					False
				LogicalExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				AssignExpr(right_var, right_rhs, right_type, right_loc):
					False
				LetExpr(right_name, right_mutable, right_type, right_rhs, right_body):
					(
						vars_equal(left_name, right_name)
						and left_mutable == right_mutable
						and types_equal(left_type, right_type)
						and exprs_equal(left_rhs, right_rhs)
						and exprs_equal(left_body, right_body)
					)
				SeqExpr(right_first, right_second):
					False
				IfExpr(right_cond, right_then, right_else, right_type, right_loc):
					False
		SeqExpr(left_first, left_second):
			match right:
				LiteralExpr(right_literal, right_type, right_loc):
					False
				VarExpr(right_var, right_type, right_loc):
					False
				VoidExpr(right_type, right_loc):
					False
				CallExpr(right_kind, right_callee, right_args, right_type, right_loc):
					False
				BinaryExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				UnaryExpr(right_op, right_expr, right_type, right_loc):
					False
				LogicalExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				AssignExpr(right_var, right_rhs, right_type, right_loc):
					False
				LetExpr(right_name, right_mutable, right_type, right_rhs, right_body):
					False
				SeqExpr(right_first, right_second):
					exprs_equal(left_first, right_first) and exprs_equal(left_second, right_second)
				IfExpr(right_cond, right_then, right_else, right_type, right_loc):
					False
		IfExpr(left_cond, left_then, left_else, left_type, left_loc):
			match right:
				LiteralExpr(right_literal, right_type, right_loc):
					False
				VarExpr(right_var, right_type, right_loc):
					False
				VoidExpr(right_type, right_loc):
					False
				CallExpr(right_kind, right_callee, right_args, right_type, right_loc):
					False
				BinaryExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				UnaryExpr(right_op, right_expr, right_type, right_loc):
					False
				LogicalExpr(right_op, right_left, right_right, right_type, right_loc):
					False
				AssignExpr(right_var, right_rhs, right_type, right_loc):
					False
				LetExpr(right_name, right_mutable, right_type, right_rhs, right_body):
					False
				SeqExpr(right_first, right_second):
					False
				IfExpr(right_cond, right_then, right_else, right_type, right_loc):
					(
						exprs_equal(left_cond, right_cond)
						and exprs_equal(left_then, right_then)
						and exprs_equal(left_else, right_else)
						and types_equal(left_type, right_type)
						and locs_equal(left_loc, right_loc)
					)


pure func expr_lists_equal(left: List[CoreExpr], right: List[CoreExpr]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var index: Int = 0
		var ok: Bool = True

		while index < left.length():
			if ok:
				match left.get(index):
					Some(left_item):
						match right.get(index):
							Some(right_item):
								ok = exprs_equal(left_item, right_item)
							None:
								ok = False
					None:
						ok = False

			index += 1

		ok


pure func function_kinds_equal(left: CoreFunctionKind, right: CoreFunctionKind) -> Bool:
	left == right


pure func params_equal(left: List[CoreParam], right: List[CoreParam]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var index: Int = 0
		var ok: Bool = True

		while index < left.length():
			if ok:
				match left.get(index):
					Some(left_param):
						match right.get(index):
							Some(right_param):
								ok = (
									vars_equal(left_param.name, right_param.name)
									and types_equal(left_param.typ, right_param.typ)
									and locs_equal(left_param.loc, right_param.loc)
								)
							None:
								ok = False
					None:
						ok = False

			index += 1

		ok


pure func string_lists_equal(left: List[String], right: List[String]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var index: Int = 0
		var ok: Bool = True

		while index < left.length():
			if ok:
				match left.get(index):
					Some(left_item):
						match right.get(index):
							Some(right_item):
								ok = left_item == right_item
							None:
								ok = False
					None:
						ok = False

			index += 1

		ok


pure func functions_equal(left: CoreFunction, right: CoreFunction) -> Bool:
	var body_ok: Bool = False

	match left.body:
		Some(left_body):
			match right.body:
				Some(right_body):
					body_ok = exprs_equal(left_body, right_body)
				None:
					body_ok = False
		None:
			match right.body:
				Some(right_body):
					body_ok = False
				None:
					body_ok = True

	result: Bool = (
		left.name == right.name
		and left.source_module == right.source_module
		and string_lists_equal(left.type_params, right.type_params)
		and params_equal(left.params, right.params)
		and types_equal(left.return_type, right.return_type)
		and body_ok
		and left.is_pure == right.is_pure
		and function_kinds_equal(left.function_kind, right.function_kind)
		and left.def_id == right.def_id
		and locs_equal(left.loc, right.loc)
	)

	result


pure func programs_equal(left: CoreProgram, right: CoreProgram) -> Bool:
	if left.decls.length() != right.decls.length():
		False
	else:
		match left.decls.get(0):
			Some(FunctionDecl(left_function)):
				match right.decls.get(0):
					Some(FunctionDecl(right_function)):
						functions_equal(left_function, right_function)
					None:
						False
			None:
				False


pure func test_core_program_json_round_trips() -> Bool:
	program: CoreProgram = sample_program()

	match decode_core_program_json(core_program_to_json(program)):
		Ok(decoded):
			programs_equal(decoded, program)
		Err(error):
			False


pure func test_core_program_json_preserves_empty_program() -> Bool:
	program: CoreProgram = {decls = []}

	match decode_core_program_json(core_program_to_json(program)):
		Ok(decoded):
			decoded.decls.length() == 0
		Err(error):
			False


pure func test_core_program_json_round_trips_let_expression() -> Bool:
	program: CoreProgram = let_program()

	match decode_core_program_json(core_program_to_json(program)):
		Ok(decoded):
			programs_equal(decoded, program)
		Err(error):
			False


pure func test_core_program_json_round_trips_logical_expression() -> Bool:
	program: CoreProgram = logical_program()

	match decode_core_program_json(core_program_to_json(program)):
		Ok(decoded):
			programs_equal(decoded, program)
		Err(error):
			False


pure func test_core_program_json_round_trips_assignment_expression() -> Bool:
	program: CoreProgram = assign_program()

	match decode_core_program_json(core_program_to_json(program)):
		Ok(decoded):
			programs_equal(decoded, program)
		Err(error):
			False


pure func test_core_program_json_preserves_foreign_declaration_shape() -> Bool:
	foreign_func: CoreFunction = {
		name = "puts",
		source_module = Some("std/io"),
		type_params = [],
		params = [],
		return_type = int_type(),
		body = None,
		is_pure = False,
		function_kind = ForeignFunction,
		def_id = 99,
		loc = SyntheticSourceLoc
	}

	match decode_core_program_json(core_program_to_json({decls = [FunctionDecl(foreign_func)]})):
		Ok(decoded):
			match decoded.decls.get(0):
				Some(FunctionDecl(decoded_func)):
					functions_equal(decoded_func, foreign_func)
				None:
					False
		Err(error):
			False


pure func test_core_program_json_rejects_missing_decls() -> Bool:
	value: JsonValue = JsonObject([("kind", JsonString("program"))])

	match decode_core_program_json(value):
		Ok(program):
			False
		Err(CoreMissingField(path, field)):
			path == "program" and field == "decls"
		Err(CoreExpectedObject(path)):
			False
		Err(CoreExpectedObjectField(path, field)):
			False
		Err(CoreExpectedStringField(path, field)):
			False
		Err(CoreExpectedIntField(path, field)):
			False
		Err(CoreExpectedBoolField(path, field)):
			False
		Err(CoreExpectedArrayField(path, field)):
			False
		Err(CoreUnsupportedTag(path, tag)):
			False


pure func test_core_program_json_rejects_unknown_expression_tag() -> Bool:
	value: JsonValue = core_program_to_json(sample_program())
	bad_body: JsonValue = JsonObject([("kind", JsonString("not_an_expr"))])
	bad_function: JsonValue = JsonObject([
		("kind", JsonString("function")),
		("name", JsonString("main")),
		("module", JsonString("")),
		("type_params", JsonVector([])),
		("params", JsonVector([])),
		("return_type", JsonObject([("kind", JsonString("void"))])),
		("body", bad_body),
		("pure", JsonBool(False)),
		("function_kind", JsonString("user")),
		("def_id", JsonNumber(1.0)),
		("loc", JsonObject([("kind", JsonString("synthetic"))])),
	])
	bad_program: JsonValue = JsonObject([
		("kind", JsonString("program")),
		("decls", JsonVector([bad_function])),
	])

	match decode_core_program_json(bad_program):
		Ok(program):
			False
		Err(CoreUnsupportedTag(path, tag)):
			path.contains("body") and tag == "not_an_expr"
		Err(CoreMissingField(path, field)):
			False
		Err(CoreExpectedObject(path)):
			False
		Err(CoreExpectedObjectField(path, field)):
			False
		Err(CoreExpectedStringField(path, field)):
			False
		Err(CoreExpectedIntField(path, field)):
			False
		Err(CoreExpectedBoolField(path, field)):
			False
		Err(CoreExpectedArrayField(path, field)):
			False


pure func test_core_json_error_strings_are_stable() -> Bool:
	(
		core_json_error_to_string(
			CoreMissingField(
				"program",
				"decls",
			),
		) == "missing Core JSON field at program: decls"
		and core_json_error_to_string(
			CoreExpectedObject(
				"program.decls[0]",
			),
		) == "Core JSON value at program.decls[0] must be an object"
		and core_json_error_to_string(
			CoreUnsupportedTag(
				"program.decls[0].body",
				"bad",
			),
		) == "unsupported Core JSON tag at program.decls[0].body: bad"
	)


tests: TestSuite = {
	description = "Blorp compiler Core JSON",
	tests = [
		("Core program JSON round trips", test_core_program_json_round_trips),
		(
			"Core program JSON preserves empty program",
			test_core_program_json_preserves_empty_program,
		),
		(
			"Core program JSON round trips let expression",
			test_core_program_json_round_trips_let_expression,
		),
		(
			"Core program JSON round trips logical expression",
			test_core_program_json_round_trips_logical_expression,
		),
		(
			"Core program JSON round trips assignment expression",
			test_core_program_json_round_trips_assignment_expression,
		),
		(
			"Core program JSON preserves foreign declaration shape",
			test_core_program_json_preserves_foreign_declaration_shape,
		),
		("Core program JSON rejects missing decls", test_core_program_json_rejects_missing_decls),
		(
			"Core program JSON rejects unknown expression tag",
			test_core_program_json_rejects_unknown_expression_tag,
		),
		("Core JSON error strings are stable", test_core_json_error_strings_are_stable),
	]
}
