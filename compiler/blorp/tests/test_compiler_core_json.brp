pure func while_function() -> CoreFunction:
	{
		name = "while_loop",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(
			LetExpr(
				sample_var(),
				True,
				int_type(),
				LiteralExpr(IntLiteral(0), int_type(), sample_loc()),
				SeqExpr(
					WhileExpr(
						BinaryExpr(
							LessOp,
							VarExpr(sample_var(), int_type(), sample_loc()),
							LiteralExpr(IntLiteral(3), int_type(), sample_loc()),
							bool_type(),
							sample_loc(),
						),
						SeqExpr(
							CooperativeCheckpointExpr(VoidType, sample_loc()),
							SeqExpr(
								AssignExpr(
									sample_var(),
									BinaryExpr(
										AddOp,
										VarExpr(sample_var(), int_type(), sample_loc()),
										LiteralExpr(IntLiteral(1), int_type(), sample_loc()),
										int_type(),
										sample_loc(),
									),
									VoidType,
									sample_loc(),
								),
								SeqExpr(
									IfExpr(
										BinaryExpr(
											EqualOp,
											VarExpr(sample_var(), int_type(), sample_loc()),
											LiteralExpr(IntLiteral(3), int_type(), sample_loc()),
											bool_type(),
											sample_loc(),
										),
										ContinueExpr(VoidType, sample_loc()),
										VoidExpr(VoidType, sample_loc()),
										VoidType,
										sample_loc(),
									),
									IfExpr(
										BinaryExpr(
											EqualOp,
											VarExpr(sample_var(), int_type(), sample_loc()),
											LiteralExpr(IntLiteral(4), int_type(), sample_loc()),
											bool_type(),
											sample_loc(),
										),
										BreakExpr(VoidType, sample_loc()),
										VoidExpr(VoidType, sample_loc()),
										VoidType,
										sample_loc(),
									),
								),
							),
						),
						VoidType,
						sample_loc(),
					),
					VarExpr(sample_var(), int_type(), sample_loc()),
				),
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 11,
		loc = sample_loc()
	}


pure func while_program() -> CoreProgram:
	{decls = [FunctionDecl(while_function())]}


pure func tailrec_function() -> CoreFunction:
	{
		name = "sum_to",
		source_module = None,
		type_params = [],
		params = [tailrec_n_param(), tailrec_acc_param()],
		return_type = int_type(),
		body = Some(
			TailrecLoopExpr(
				[tailrec_n_param(), tailrec_acc_param()],
				int_type(),
				SeqExpr(
					CooperativeCheckpointExpr(
						VoidType,
						sample_loc(),
					),
					IfExpr(
						BinaryExpr(
							EqualOp,
							VarExpr(tailrec_n_var(), int_type(), sample_loc()),
							LiteralExpr(IntLiteral(0), int_type(), sample_loc()),
							bool_type(),
							sample_loc(),
						),
						VarExpr(
							tailrec_acc_var(),
							int_type(),
							sample_loc(),
						),
						TailrecRecurExpr(
							[BinaryExpr(
									SubtractOp,
									VarExpr(tailrec_n_var(), int_type(), sample_loc()),
									LiteralExpr(IntLiteral(1), int_type(), sample_loc()),
									int_type(),
									sample_loc(),
								), BinaryExpr(
									AddOp,
									VarExpr(tailrec_acc_var(), int_type(), sample_loc()),
									VarExpr(tailrec_n_var(), int_type(), sample_loc()),
									int_type(),
									sample_loc(),
								)],
							int_type(),
							sample_loc(),
						),
						int_type(),
						sample_loc(),
					),
				),
				sample_loc(),
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 14,
		loc = sample_loc()
	}


pure func tailrec_program() -> CoreProgram:
	{decls = [FunctionDecl(tailrec_function())]}


pure func range_for_function() -> CoreFunction:
	{
		name = "sum_range",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(
			LetExpr(
				sample_var(),
				True,
				int_type(),
				LiteralExpr(IntLiteral(0), int_type(), sample_loc()),
				SeqExpr(
					ForRangeExpr(
						range_loop_binder(),
						LiteralExpr(IntLiteral(0), int_type(), sample_loc()),
						LiteralExpr(IntLiteral(5), int_type(), sample_loc()),
						SeqExpr(
							CooperativeCheckpointExpr(VoidType, sample_loc()),
							AssignExpr(
								sample_var(),
								BinaryExpr(
									AddOp,
									VarExpr(sample_var(), int_type(), sample_loc()),
									VarExpr(range_index_var(), int_type(), sample_loc()),
									int_type(),
									sample_loc(),
								),
								VoidType,
								sample_loc(),
							),
						),
						VoidType,
						sample_loc(),
					),
					VarExpr(sample_var(), int_type(), sample_loc()),
				),
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 15,
		loc = sample_loc()
	}


pure func range_for_program() -> CoreProgram:
	{decls = [FunctionDecl(range_for_function())]}


pure func literal_match_function() -> CoreFunction:
	zero_case: CoreLiteralMatchCase = {
		literal = IntLiteral(0),
		body = LiteralExpr(IntLiteral(10), int_type(), sample_loc())
	}
	one_case: CoreLiteralMatchCase = {
		literal = IntLiteral(1),
		body = LiteralExpr(IntLiteral(20), int_type(), sample_loc())
	}

	{
		name = "classify",
		source_module = None,
		type_params = [],
		params = [match_input_param()],
		return_type = int_type(),
		body = Some(
			LiteralMatchExpr(
				VarExpr(
					match_input_var(),
					int_type(),
					sample_loc(),
				),
				[zero_case, one_case],
				LiteralMatchFallbackBody(LiteralExpr(IntLiteral(30), int_type(), sample_loc())),
				int_type(),
				sample_loc(),
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 16,
		loc = sample_loc()
	}


pure func literal_match_program() -> CoreProgram:
	{decls = [FunctionDecl(literal_match_function())]}


pure func literal_match_fail_function() -> CoreFunction:
	true_case: CoreLiteralMatchCase = {
		literal = BoolLiteral(True),
		body = LiteralExpr(IntLiteral(1), int_type(), sample_loc())
	}
	false_case: CoreLiteralMatchCase = {
		literal = BoolLiteral(False),
		body = LiteralExpr(IntLiteral(0), int_type(), sample_loc())
	}

	{
		name = "classify_bool",
		source_module = None,
		type_params = [],
		params = [bool_match_input_param()],
		return_type = int_type(),
		body = Some(
			LiteralMatchExpr(
				VarExpr(
					bool_match_input_var(),
					bool_type(),
					sample_loc(),
				),
				[true_case, false_case],
				LiteralMatchFallbackFail,
				int_type(),
				sample_loc(),
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 17,
		loc = sample_loc()
	}


pure func literal_match_fail_program() -> CoreProgram:
	{decls = [FunctionDecl(literal_match_fail_function())]}


