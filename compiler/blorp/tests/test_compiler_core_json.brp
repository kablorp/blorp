pure func json_values_equal(left: JsonValue, right: JsonValue) -> Bool:
	left.to_string() == right.to_string()


pure func program_round_trips(program: CoreProgram) -> Bool:
	encoded: JsonValue = core_program_to_json(program)

	match decode_core_program_json(encoded):
		Ok(decoded):
			json_values_equal(core_program_to_json(decoded), encoded)
		Err(error):
			False


pure func test_core_type_json_round_trips_range() -> Bool:
	encoded: JsonValue = core_type_to_json(range_type())

	match decode_core_type_json(encoded, "type"):
		Ok(decoded):
			json_values_equal(core_type_to_json(decoded), encoded)
		Err(error):
			False


pure func test_core_type_json_round_trips_tensor_details() -> Bool:
	encoded: JsonValue = core_type_to_json(
		tensor_type_for(
			float32_type(),
			[2, 3],
		),
	)

	match decode_core_type_json(encoded, "type"):
		Ok(decoded):
			match decoded:
				TensorType(info):
					match info.dims:
						[TensorStaticDim(rows), TensorStaticDim(cols)]:
							(
								rows == 2
								and cols == 3
								and json_values_equal(core_type_to_json(decoded), encoded)
							)
						_:
							False
				_:
					False
		Err(error):
