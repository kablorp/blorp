pure func resource_concurrently_program() -> CoreProgram:
	source_param: CoreParam = local_param("items", resource_source_tcp_stream_io_error_type())
	conn_var: CoreVar = local_var("conn")
	move_item: CoreConcurrentlyLoopMoveResourceItem = {
		resource_type = tcp_stream_type(),
		error_type = io_error_type()
	}
	loop: CoreConcurrentlyLoop = {
		variable = conn_var,
		item_type = tcp_stream_type(),
		item_mode = ConcurrentlyLoopMoveResourceItem(move_item),
		iterable = VarExpr(
			source_param.name,
			resource_source_tcp_stream_io_error_type(),
			sample_loc(),
		),
		body = VoidExpr(VoidType, sample_loc()),
		timeout = None,
		limit = LiteralExpr(IntLiteral(2), int_type(), sample_loc()),
		output = ConcurrentlyLoopDiscard,
		task = resource_concurrently_task()
	}
	fanout: CoreFunction = {
		name = "fanout_resource_connections",
