pure func decoded_is_float_infinity(value: JsonValue) -> Bool:
	match decode_core_literal_json(value, "literal"):
		Ok(literal):
			match literal:
				FloatInfinityLiteral:
					True
				FloatNegInfinityLiteral:
					False
				FloatNanLiteral:
					False
				FloatLiteral(number):
					False
				FloatTextLiteral(text):
					False
				IntLiteral(number):
					False
				WideIntLiteral(text):
					False
				BoolLiteral(flag):
					False
				CharLiteral(codepoint):
					False
				StringLiteral(text):
					False
		Err(error):
			False


pure func decoded_is_float_neg_infinity(value: JsonValue) -> Bool:
	match decode_core_literal_json(value, "literal"):
		Ok(literal):
			match literal:
				FloatInfinityLiteral:
					False
				FloatNegInfinityLiteral:
					True
				FloatNanLiteral:
					False
				FloatLiteral(number):
					False
				FloatTextLiteral(text):
					False
				IntLiteral(number):
					False
				WideIntLiteral(text):
					False
				BoolLiteral(flag):
					False
				CharLiteral(codepoint):
					False
				StringLiteral(text):
					False
		Err(error):
			False


pure func decoded_is_float_nan(value: JsonValue) -> Bool:
	match decode_core_literal_json(value, "literal"):
		Ok(literal):
			match literal:
				FloatInfinityLiteral:
					False
				FloatNegInfinityLiteral:
					False
				FloatNanLiteral:
					True
				FloatLiteral(number):
					False
				FloatTextLiteral(text):
					False
				IntLiteral(number):
					False
				WideIntLiteral(text):
					False
				BoolLiteral(flag):
					False
				CharLiteral(codepoint):
					False
				StringLiteral(text):
					False
		Err(error):
			False


pure func decoded_wide_int_equals(value: JsonValue, expected: String) -> Bool:
	match decode_core_literal_json(value, "literal"):
		Ok(literal):
			match literal:
				FloatInfinityLiteral:
					False
				FloatNegInfinityLiteral:
					False
				FloatNanLiteral:
					False
				FloatLiteral(number):
					False
				FloatTextLiteral(text):
					False
				IntLiteral(number):
					False
				WideIntLiteral(text):
					text == expected
				BoolLiteral(flag):
					False
				CharLiteral(codepoint):
					False
				StringLiteral(text):
					False
		Err(error):
			False


pure func decoded_float_text_equals(value: JsonValue, expected: String) -> Bool:
	match decode_core_literal_json(value, "literal"):
		Ok(literal):
			match literal:
				FloatInfinityLiteral:
					False
				FloatNegInfinityLiteral:
					False
				FloatNanLiteral:
					False
				FloatLiteral(number):
					False
				FloatTextLiteral(text):
					text == expected
				IntLiteral(number):
					False
				WideIntLiteral(text):
					False
				BoolLiteral(flag):
					False
				CharLiteral(codepoint):
					False
				StringLiteral(text):
					False
		Err(error):
			False


pure func test_core_literal_json_uses_nonfinite_float_tags() -> Bool:
	inf_value: JsonValue = core_literal_to_json(FloatInfinityLiteral)
	neg_inf_value: JsonValue = core_literal_to_json(FloatNegInfinityLiteral)
	nan_value: JsonValue = core_literal_to_json(FloatNanLiteral)
	inf_json: String = inf_value.to_string()
	neg_inf_json: String = neg_inf_value.to_string()
	nan_json: String = nan_value.to_string()

	(
		inf_json.contains("float_infinity")
		and not inf_json.contains("null")
		and decoded_is_float_infinity(inf_value)
		and neg_inf_json.contains("float_neg_infinity")
		and not neg_inf_json.contains("null")
		and decoded_is_float_neg_infinity(neg_inf_value)
		and nan_json.contains("float_nan")
		and not nan_json.contains("null")
		and decoded_is_float_nan(nan_value)
	)


pure func test_core_literal_json_uses_wide_int_tag() -> Bool:
	max_text: String = "9223372036854775807"
	value: JsonValue = core_literal_to_json(WideIntLiteral(max_text))
	json_text: String = value.to_string()

	(
		json_text.contains("wide_int")
		and json_text.contains(max_text)
		and decoded_wide_int_equals(value, max_text)
	)


pure func test_core_literal_json_uses_float_text_tag() -> Bool:
	float_text: String = "73.985656"
	value: JsonValue = core_literal_to_json(FloatTextLiteral(float_text))
	json_text: String = value.to_string()

	(
		json_text.contains("float_text")
		and json_text.contains(float_text)
		and decoded_float_text_equals(value, float_text)
	)


