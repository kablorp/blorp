pure func enum_program() -> CoreProgram:
	func_info: CoreFunction = {
		name = "is_red",
		source_module = None,
		type_params = [],
		params = [
			{
				name = {
					name = "color",
					uniq = 0,
					def_id = None
				},
				typ = color_type(),
				loc = sample_loc()
			},
		],
		return_type = bool_type(),
		body = Some(
			BinaryExpr(
				EqualOp,
				VarExpr(
					{
						name = "color",
						uniq = 0,
						def_id = None
					},
					color_type(),
					sample_loc(),
				),
				VarExpr(
					{
						name = "__def_101_Red",
						uniq = 0,
						def_id = Some(101)
					},
					color_type(),
					sample_loc(),
				),
				bool_type(),
				sample_loc(),
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 14,
		loc = sample_loc()
	}

	{decls = [EnumDecl(color_enum_decl()), FunctionDecl(func_info)]}


pure func constructor_match_program() -> CoreProgram:
	red_case: CoreConstructorMatchCase = {
		constructor = "Red",
		constructor_c_name = "__def_101_Red",
		body = LiteralExpr(IntLiteral(1), int_type(), sample_loc())
	}
	blue_case: CoreConstructorMatchCase = {
		constructor = "Blue",
		constructor_c_name = "__def_102_Blue",
		body = LiteralExpr(IntLiteral(2), int_type(), sample_loc())
	}
	color_var: CoreVar = {
		name = "color",
		uniq = 0,
		def_id = None
	}
	func_info: CoreFunction = {
		name = "classify_color",
		source_module = None,
		type_params = [],
		params = [{
				name = color_var,
				typ = color_type(),
				loc = sample_loc()
			}],
		return_type = int_type(),
		body = Some(
			ConstructorMatchExpr(
				VarExpr(
					color_var,
					color_type(),
					sample_loc(),
				),
				[red_case, blue_case],
				ConstructorMatchFallbackFail,
				int_type(),
				sample_loc(),
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 15,
		loc = sample_loc()
	}

	{decls = [EnumDecl(color_enum_decl()), FunctionDecl(func_info)]}


pure func json_values_equal(left: JsonValue, right: JsonValue) -> Bool:
	left.to_string() == right.to_string()


pure func program_round_trips(program: CoreProgram) -> Bool:
	encoded: JsonValue = core_program_to_json(program)

	match decode_core_program_json(encoded):
		Ok(decoded):
			json_values_equal(core_program_to_json(decoded), encoded)
		Err(error):
			False


pure func test_core_program_json_round_trips() -> Bool:
	program_round_trips(sample_program())


pure func test_core_program_json_round_trips_intrinsic_call() -> Bool:
	program_round_trips(intrinsic_call_program())


pure func test_core_program_json_preserves_empty_program() -> Bool:
	program_round_trips({decls = []})


pure func test_core_program_json_round_trips_global_declaration() -> Bool:
	program_round_trips(global_program())


pure func test_core_program_json_round_trips_let_expression() -> Bool:
	program_round_trips(let_program())


