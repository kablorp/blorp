import:
	../compiler_core_json:
		CoreBinaryOp(AddOp, EqualOp, LessOp, ModuloOp),
		CoreCallKind(BuiltinCall),
		CoreDecl(FunctionDecl),
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			BreakExpr,
			CastExpr,
			CallExpr,
			CooperativeCheckpointExpr,
			ContinueExpr,
			IfExpr,
			LetExpr,
			LiteralExpr,
			LogicalExpr,
			SeqExpr,
			UnaryExpr,
			VarExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreFunctionKind(ForeignFunction, UserFunction),
		CoreJsonError(
			CoreExpectedArrayField,
			CoreExpectedBoolField,
			CoreExpectedIntField,
			CoreExpectedObject,
			CoreExpectedObjectField,
			CoreExpectedStringField,
			CoreMissingField,
			CoreUnsupportedTag,
		),
		CoreLiteral(BoolLiteral, IntLiteral, StringLiteral),
		CoreLogicalOp(AndOp, OrOp),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(KnownSourceLoc, SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
		CoreUnaryOp(NotOp),
		CoreVar,
		core_json_error_to_string,
		core_program_to_json,
		decode_core_program_json,
	json: JsonValue(JsonBool, JsonNumber, JsonObject, JsonString, JsonVector)
	test: TestSuite


pure func sample_loc() -> CoreSourceLoc:
	KnownSourceLoc({
		file = "main.brp",
		line = 1,
		column = 1,
		end_line = 1,
		end_column = 12,
	})


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func string_type() -> CoreType:
	NamedType("String", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func float_type() -> CoreType:
	NamedType("Float", [])


pure func sample_var() -> CoreVar:
	{
		name = "answer",
		uniq = 0,
		def_id = Some(7)
	}


pure func sample_function() -> CoreFunction:
	param: CoreParam = {
		name = {
			name = "argc",
			uniq = 0,
			def_id = None
		},
		typ = int_type(),
		loc = sample_loc()
	}

	{
		name = "main",
		source_module = None,
		type_params = [],
		params = [param],
		return_type = int_type(),
		body = Some(
			SeqExpr(
				VarExpr(sample_var(), int_type(), sample_loc()),
				CallExpr(
					BuiltinCall("print"),
					VarExpr(sample_var(), int_type(), sample_loc()),
					[LiteralExpr(StringLiteral("done"), string_type(), sample_loc())],
					VoidType,
					SyntheticSourceLoc,
				),
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 1,
		loc = sample_loc()
	}


pure func sample_program() -> CoreProgram:
	{decls = [FunctionDecl(sample_function())]}


pure func let_function() -> CoreFunction:
	{
		name = "let_answer",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(
			LetExpr(
				sample_var(),
				False,
				int_type(),
				LiteralExpr(IntLiteral(40), int_type(), sample_loc()),
				BinaryExpr(
					AddOp,
					VarExpr(sample_var(), int_type(), sample_loc()),
					LiteralExpr(IntLiteral(2), int_type(), sample_loc()),
					int_type(),
					sample_loc(),
				),
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 8,
		loc = sample_loc()
	}


pure func let_program() -> CoreProgram:
	{decls = [FunctionDecl(let_function())]}


pure func logical_function() -> CoreFunction:
	{
		name = "logical",
		source_module = None,
		type_params = [],
		params = [],
		return_type = bool_type(),
		body = Some(
			LogicalExpr(
				AndOp,
				UnaryExpr(
					NotOp,
					LiteralExpr(BoolLiteral(False), bool_type(), sample_loc()),
					bool_type(),
					sample_loc(),
				),
				LiteralExpr(BoolLiteral(True), bool_type(), sample_loc()),
				bool_type(),
				sample_loc(),
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 9,
		loc = sample_loc()
	}


pure func logical_program() -> CoreProgram:
	{decls = [FunctionDecl(logical_function())]}


pure func assign_function() -> CoreFunction:
	{
		name = "assign",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(
			LetExpr(
				sample_var(),
				True,
				int_type(),
				LiteralExpr(IntLiteral(0), int_type(), sample_loc()),
				SeqExpr(
					AssignExpr(
						sample_var(),
						LiteralExpr(IntLiteral(1), int_type(), sample_loc()),
						VoidType,
						sample_loc(),
					),
					VarExpr(sample_var(), int_type(), sample_loc()),
				),
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 10,
		loc = sample_loc()
	}


pure func assign_program() -> CoreProgram:
	{decls = [FunctionDecl(assign_function())]}


pure func while_function() -> CoreFunction:
	{
		name = "while_loop",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(
			LetExpr(
				sample_var(),
				True,
				int_type(),
				LiteralExpr(IntLiteral(0), int_type(), sample_loc()),
				SeqExpr(
					WhileExpr(
						BinaryExpr(
							LessOp,
							VarExpr(sample_var(), int_type(), sample_loc()),
							LiteralExpr(IntLiteral(3), int_type(), sample_loc()),
							bool_type(),
							sample_loc(),
						),
						SeqExpr(
							CooperativeCheckpointExpr(VoidType, sample_loc()),
							SeqExpr(
								AssignExpr(
									sample_var(),
									BinaryExpr(
										AddOp,
										VarExpr(sample_var(), int_type(), sample_loc()),
										LiteralExpr(IntLiteral(1), int_type(), sample_loc()),
										int_type(),
										sample_loc(),
									),
									VoidType,
									sample_loc(),
								),
								SeqExpr(
									IfExpr(
										BinaryExpr(
											EqualOp,
											VarExpr(sample_var(), int_type(), sample_loc()),
											LiteralExpr(IntLiteral(3), int_type(), sample_loc()),
											bool_type(),
											sample_loc(),
										),
										ContinueExpr(VoidType, sample_loc()),
										VoidExpr(VoidType, sample_loc()),
										VoidType,
										sample_loc(),
									),
									IfExpr(
										BinaryExpr(
											EqualOp,
											VarExpr(sample_var(), int_type(), sample_loc()),
											LiteralExpr(IntLiteral(4), int_type(), sample_loc()),
											bool_type(),
											sample_loc(),
										),
										BreakExpr(VoidType, sample_loc()),
										VoidExpr(VoidType, sample_loc()),
										VoidType,
										sample_loc(),
									),
								),
							),
						),
						VoidType,
						sample_loc(),
					),
					VarExpr(sample_var(), int_type(), sample_loc()),
				),
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 11,
		loc = sample_loc()
	}


pure func while_program() -> CoreProgram:
	{decls = [FunctionDecl(while_function())]}


pure func cast_function() -> CoreFunction:
	{
		name = "cast_to_float",
		source_module = None,
		type_params = [],
		params = [],
		return_type = float_type(),
		body = Some(
			CastExpr(
				LiteralExpr(IntLiteral(7), int_type(), sample_loc()),
				float_type(),
				float_type(),
				sample_loc(),
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 12,
		loc = sample_loc()
	}


pure func cast_program() -> CoreProgram:
	{decls = [FunctionDecl(cast_function())]}


pure func json_values_equal(left: JsonValue, right: JsonValue) -> Bool:
	left.to_string() == right.to_string()


pure func program_round_trips(program: CoreProgram) -> Bool:
	encoded: JsonValue = core_program_to_json(program)

	match decode_core_program_json(encoded):
		Ok(decoded):
			json_values_equal(core_program_to_json(decoded), encoded)
		Err(error):
			False


pure func test_core_program_json_round_trips() -> Bool:
	program_round_trips(sample_program())


pure func test_core_program_json_preserves_empty_program() -> Bool:
	program_round_trips({decls = []})


pure func test_core_program_json_round_trips_let_expression() -> Bool:
	program_round_trips(let_program())


pure func modulo_program() -> CoreProgram:
	func_info: CoreFunction = {
		name = "modulo",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(
			BinaryExpr(
				ModuloOp,
				LiteralExpr(IntLiteral(7), int_type(), sample_loc()),
				LiteralExpr(IntLiteral(3), int_type(), sample_loc()),
				int_type(),
				sample_loc(),
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 12,
		loc = sample_loc()
	}

	{decls = [FunctionDecl(func_info)]}


pure func test_core_program_json_round_trips_modulo_expression() -> Bool:
	program_round_trips(modulo_program())


pure func test_core_program_json_round_trips_logical_expression() -> Bool:
	program_round_trips(logical_program())


pure func test_core_program_json_round_trips_assignment_expression() -> Bool:
	program_round_trips(assign_program())


pure func test_core_program_json_round_trips_while_expression() -> Bool:
	program_round_trips(while_program())


pure func test_core_program_json_round_trips_cast_expression() -> Bool:
	program_round_trips(cast_program())


pure func test_core_program_json_preserves_foreign_declaration_shape() -> Bool:
	foreign_func: CoreFunction = {
		name = "puts",
		source_module = Some("std/io"),
		type_params = [],
		params = [],
		return_type = int_type(),
		body = None,
		is_pure = False,
		function_kind = ForeignFunction,
		def_id = 99,
		loc = SyntheticSourceLoc
	}

	program_round_trips({decls = [FunctionDecl(foreign_func)]})


pure func test_core_program_json_rejects_missing_decls() -> Bool:
	value: JsonValue = JsonObject([("kind", JsonString("program"))])

	match decode_core_program_json(value):
		Ok(program):
			False
		Err(CoreMissingField(path, field)):
			path == "program" and field == "decls"
		Err(CoreExpectedObject(path)):
			False
		Err(CoreExpectedObjectField(path, field)):
			False
		Err(CoreExpectedStringField(path, field)):
			False
		Err(CoreExpectedIntField(path, field)):
			False
		Err(CoreExpectedBoolField(path, field)):
			False
		Err(CoreExpectedArrayField(path, field)):
			False
		Err(CoreUnsupportedTag(path, tag)):
			False


pure func test_core_program_json_rejects_unknown_expression_tag() -> Bool:
	value: JsonValue = core_program_to_json(sample_program())
	bad_body: JsonValue = JsonObject([("kind", JsonString("not_an_expr"))])
	bad_function: JsonValue = JsonObject([
		("kind", JsonString("function")),
		("name", JsonString("main")),
		("module", JsonString("")),
		("type_params", JsonVector([])),
		("params", JsonVector([])),
		("return_type", JsonObject([("kind", JsonString("void"))])),
		("body", bad_body),
		("pure", JsonBool(False)),
		("function_kind", JsonString("user")),
		("def_id", JsonNumber(1.0)),
		("loc", JsonObject([("kind", JsonString("synthetic"))])),
	])
	bad_program: JsonValue = JsonObject([
		("kind", JsonString("program")),
		("decls", JsonVector([bad_function])),
	])

	match decode_core_program_json(bad_program):
		Ok(program):
			False
		Err(CoreUnsupportedTag(path, tag)):
			path.contains("body") and tag == "not_an_expr"
		Err(CoreMissingField(path, field)):
			False
		Err(CoreExpectedObject(path)):
			False
		Err(CoreExpectedObjectField(path, field)):
			False
		Err(CoreExpectedStringField(path, field)):
			False
		Err(CoreExpectedIntField(path, field)):
			False
		Err(CoreExpectedBoolField(path, field)):
			False
		Err(CoreExpectedArrayField(path, field)):
			False


pure func test_core_json_error_strings_are_stable() -> Bool:
	(
		core_json_error_to_string(
			CoreMissingField(
				"program",
				"decls",
			),
		) == "missing Core JSON field at program: decls"
		and core_json_error_to_string(
			CoreExpectedObject(
				"program.decls[0]",
			),
		) == "Core JSON value at program.decls[0] must be an object"
		and core_json_error_to_string(
			CoreUnsupportedTag(
				"program.decls[0].body",
				"bad",
			),
		) == "unsupported Core JSON tag at program.decls[0].body: bad"
	)


tests: TestSuite = {
	description = "Blorp compiler Core JSON",
	tests = [
		("Core program JSON round trips", test_core_program_json_round_trips),
		(
			"Core program JSON preserves empty program",
			test_core_program_json_preserves_empty_program,
		),
		(
			"Core program JSON round trips let expression",
			test_core_program_json_round_trips_let_expression,
		),
		(
			"Core program JSON round trips modulo expression",
			test_core_program_json_round_trips_modulo_expression,
		),
		(
			"Core program JSON round trips logical expression",
			test_core_program_json_round_trips_logical_expression,
		),
		(
			"Core program JSON round trips assignment expression",
			test_core_program_json_round_trips_assignment_expression,
		),
		(
			"Core program JSON round trips while expression",
			test_core_program_json_round_trips_while_expression,
		),
		(
			"Core program JSON round trips cast expression",
			test_core_program_json_round_trips_cast_expression,
		),
		(
			"Core program JSON preserves foreign declaration shape",
			test_core_program_json_preserves_foreign_declaration_shape,
		),
		("Core program JSON rejects missing decls", test_core_program_json_rejects_missing_decls),
		(
			"Core program JSON rejects unknown expression tag",
			test_core_program_json_rejects_unknown_expression_tag,
		),
		("Core JSON error strings are stable", test_core_json_error_strings_are_stable),
	]
}
