import:
	../compiler_core_json:
		CoreBinaryOp(AddOp, EqualOp, LessOp, ModuloOp, SubtractOp),
		CoreCallKind(BuiltinCall, IntrinsicCall),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(ConstructorMatchFallbackFail),
		CoreDecl(EnumDecl, FunctionDecl, GlobalDecl),
		CoreEnumDecl,
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			BreakExpr,
			CastExpr,
			CallExpr,
			ConstructorMatchExpr,
			CooperativeCheckpointExpr,
			ContinueExpr,
			ForRangeExpr,
			IfExpr,
			LetExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			SeqExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			UnaryExpr,
			VarExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreFunctionKind(ForeignFunction, UserFunction),
		CoreGlobal,
		CoreJsonError(
			CoreExpectedArrayField,
			CoreExpectedBoolField,
			CoreExpectedIntField,
			CoreExpectedNumberField,
			CoreExpectedObject,
			CoreExpectedObjectField,
			CoreExpectedStringField,
			CoreMissingField,
			CoreUnsupportedTag,
		),
		CoreLiteral(BoolLiteral, CharLiteral, FloatLiteral, IntLiteral, StringLiteral),
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(LiteralMatchFallbackBody, LiteralMatchFallbackFail),
		CoreLogicalOp(AndOp, OrOp),
		CoreLoopBinder,
		CoreLoopRangeDirection(RangeMayRunBackward),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(KnownSourceLoc, SyntheticSourceLoc),
		CoreType(EnumType, NamedType, VoidType),
		CoreUnaryOp(NotOp),
		CoreVar,
		core_json_error_to_string,
		core_program_to_json,
		decode_core_program_json,
	json: JsonValue(JsonBool, JsonNumber, JsonObject, JsonString, JsonVector)
	test: TestSuite


pure func sample_loc() -> CoreSourceLoc:
	KnownSourceLoc({
		file = "main.brp",
		line = 1,
		column = 1,
		end_line = 1,
		end_column = 12,
	})


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func string_type() -> CoreType:
	NamedType("String", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func float_type() -> CoreType:
	NamedType("Float", [])


pure func char_type() -> CoreType:
	NamedType("Char", [])


pure func color_type() -> CoreType:
	EnumType("Color")


pure func sample_var() -> CoreVar:
	{
		name = "answer",
		uniq = 0,
		def_id = Some(7)
	}


pure func tailrec_n_var() -> CoreVar:
	{
		name = "n",
		uniq = 0,
		def_id = None
	}


pure func tailrec_acc_var() -> CoreVar:
	{
		name = "acc",
		uniq = 1,
		def_id = None
	}


pure func tailrec_n_param() -> CoreParam:
	{
		name = tailrec_n_var(),
		typ = int_type(),
		loc = sample_loc()
	}


pure func tailrec_acc_param() -> CoreParam:
	{
		name = tailrec_acc_var(),
		typ = int_type(),
		loc = sample_loc()
	}


pure func range_index_var() -> CoreVar:
	{
		name = "i",
		uniq = 2,
		def_id = None
	}


pure func match_input_var() -> CoreVar:
	{
		name = "n",
		uniq = 3,
		def_id = None
	}


pure func match_input_param() -> CoreParam:
	{
		name = match_input_var(),
		typ = int_type(),
		loc = sample_loc()
	}


pure func bool_match_input_var() -> CoreVar:
	{
		name = "flag",
		uniq = 4,
		def_id = None
	}


pure func bool_match_input_param() -> CoreParam:
	{
		name = bool_match_input_var(),
		typ = bool_type(),
		loc = sample_loc()
	}


pure func range_loop_binder() -> CoreLoopBinder:
	{
		variable = range_index_var(),
		typ = int_type(),
		range_direction = RangeMayRunBackward
	}


pure func sample_function() -> CoreFunction:
	param: CoreParam = {
		name = {
			name = "argc",
			uniq = 0,
			def_id = None
		},
		typ = int_type(),
		loc = sample_loc()
	}

	{
		name = "main",
		source_module = None,
		type_params = [],
		params = [param],
		return_type = int_type(),
		body = Some(
			SeqExpr(
				VarExpr(sample_var(), int_type(), sample_loc()),
				CallExpr(
					BuiltinCall("print"),
					VarExpr(sample_var(), int_type(), sample_loc()),
					[LiteralExpr(StringLiteral("done"), string_type(), sample_loc())],
					VoidType,
					SyntheticSourceLoc,
				),
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 1,
		loc = sample_loc()
	}


pure func sample_program() -> CoreProgram:
	{decls = [FunctionDecl(sample_function())]}


pure func intrinsic_call_function() -> CoreFunction:
