import:
	../compiler_type:
		CompilerType(CompilerArrayType, CompilerConstIntType, CompilerNamedType, CompilerTupleType),
		compiler_type_bool,
		compiler_type_char,
		compiler_type_float,
		compiler_type_int,
		compiler_type_list,
		compiler_type_string,
	../compiler_type_metadata:
		CompilerConstructorSpace(
			CompilerClosedNominalSpace,
			CompilerOpenScalarSpace,
			CompilerSequenceSpace,
		),
		CompilerRecursionStorage(CompilerHeapIndirectedRecursion, CompilerInlineRecursion),
		compiler_constructor_space_of_name,
		compiler_has_builtin_to_string_fallback_type,
		compiler_has_native_operator_fast_path_type,
		compiler_is_fallible_stream_type_name,
		compiler_is_heap_indirected_name,
		compiler_is_one_shot_stream_type_name,
		compiler_is_open_exhaustiveness_scalar_name,
		compiler_is_resource_source_type_name,
		compiler_is_stream_type_name,
		compiler_is_struct_scalar_field_type,
		compiler_primitive_home,
		compiler_primitive_home_for_name,
		compiler_recursion_storage_of_name,
	test: TestSuite


func test_recursion_storage_and_primitive_homes() -> Bool:
	tensor_int: CompilerType = CompilerArrayType(compiler_type_int(), [CompilerConstIntType(4)])

	(
		compiler_recursion_storage_of_name("List") == CompilerHeapIndirectedRecursion
		and compiler_recursion_storage_of_name("Widget") == CompilerInlineRecursion
		and compiler_is_heap_indirected_name("Tensor")
		and not compiler_is_heap_indirected_name("Point")
		and compiler_primitive_home_for_name("Int") == Some("std/int")
		and compiler_primitive_home_for_name("Matrix") == Some("std/tensor")
		and compiler_primitive_home_for_name("Widget") == None
		and compiler_primitive_home(compiler_type_int()) == Some("std/int")
		and compiler_primitive_home(tensor_int) == Some("std/tensor")
		and compiler_primitive_home(
			CompilerTupleType([compiler_type_int(), compiler_type_string()]),
		) == Some("std/tuple")
	)


func test_struct_scalar_policy() -> Bool:
	(
		compiler_is_struct_scalar_field_type(compiler_type_int())
		and compiler_is_struct_scalar_field_type(compiler_type_float())
		and compiler_is_struct_scalar_field_type(compiler_type_bool())
		and compiler_is_struct_scalar_field_type(compiler_type_char())
		and compiler_is_struct_scalar_field_type(CompilerNamedType("UInt64", []))
		and compiler_is_struct_scalar_field_type(CompilerNamedType("Ptr", []))
		and not compiler_is_struct_scalar_field_type(compiler_type_string())
		and not compiler_is_struct_scalar_field_type(compiler_type_list(compiler_type_int()))
	)


func test_operator_and_to_string_policy() -> Bool:
	list_int: CompilerType = compiler_type_list(compiler_type_int())
	tensor_int: CompilerType = CompilerArrayType(compiler_type_int(), [CompilerConstIntType(4)])

	(
		compiler_has_native_operator_fast_path_type(compiler_type_int())
		and compiler_has_native_operator_fast_path_type(compiler_type_string())
		and compiler_has_native_operator_fast_path_type(tensor_int)
		and compiler_has_native_operator_fast_path_type(CompilerConstIntType(4))
		and not compiler_has_native_operator_fast_path_type(list_int)
		and compiler_has_builtin_to_string_fallback_type(list_int)
		and compiler_has_builtin_to_string_fallback_type(CompilerNamedType("StringSlice", []))
		and compiler_has_builtin_to_string_fallback_type(tensor_int)
		and not compiler_has_builtin_to_string_fallback_type(CompilerNamedType("Widget", []))
	)


func test_constructor_spaces() -> Bool:
	(
		compiler_constructor_space_of_name("List") == CompilerSequenceSpace
		and compiler_constructor_space_of_name("String") == CompilerOpenScalarSpace
		and compiler_constructor_space_of_name("Int32") == CompilerOpenScalarSpace
		and compiler_constructor_space_of_name("Bool") == CompilerClosedNominalSpace
		and compiler_is_open_exhaustiveness_scalar_name("Char")
		and not compiler_is_open_exhaustiveness_scalar_name("Bool")
	)


func test_stream_and_resource_source_names() -> Bool:
	(
		compiler_is_stream_type_name("Stream")
		and compiler_is_stream_type_name("std_stream__Stream")
		and compiler_is_stream_type_name("std/stream::Stream")
		and compiler_is_fallible_stream_type_name("FallibleStream")
		and compiler_is_fallible_stream_type_name("std_stream__FallibleStream")
		and compiler_is_fallible_stream_type_name("std/stream::FallibleStream")
		and compiler_is_one_shot_stream_type_name("Stream")
		and compiler_is_one_shot_stream_type_name("FallibleStream")
		and not compiler_is_one_shot_stream_type_name("List")
		and compiler_is_resource_source_type_name("ResourceSource")
		and compiler_is_resource_source_type_name("std_stream__ResourceSource")
		and compiler_is_resource_source_type_name("std/stream::ResourceSource")
		and not compiler_is_resource_source_type_name("Stream")
	)


tests: TestSuite = {
	description = "Compiler type metadata",
	tests = [
		("recursion storage and primitive homes", test_recursion_storage_and_primitive_homes),
		("struct scalar policy", test_struct_scalar_policy),
		("operator and to_string policy", test_operator_and_to_string_policy),
		("constructor spaces", test_constructor_spaces),
		("stream and resource source names", test_stream_and_resource_source_names),
	]
}
