import:
	../src/stage_01_file_io/source: compiler_source_file
	../src/stage_04_modules/frontend_graph_service:
		CompilerFrontendSourceCandidate,
		compiler_frontend_source_candidate,
	../src/stage_04_modules/frontend_import_plan:
		CompilerFrontendImportLookup(
			CompilerFrontendLocalPathLookup,
			CompilerFrontendNativePackageLookup,
			CompilerFrontendRelativePathLookup,
			CompilerFrontendSourcePackageAliasLookup,
			CompilerFrontendSourcePackageInternalLookup,
			CompilerFrontendStandardLibraryLookup,
		),
		compiler_frontend_import_lookup_plan,
	../src/stage_04_modules/loaded_module:
		CompilerModuleOrigin(CompilerSourcePackageModule, CompilerStdlibModule, CompilerUserModule),
		compiler_module_origins_equal,
		compiler_resolved_module_identity_from_resolver,
	test: TestSuite


private pure func candidate(origin: CompilerModuleOrigin) -> CompilerFrontendSourceCandidate:
	compiler_frontend_source_candidate(
		compiler_resolved_module_identity_from_resolver("main", origin),
		compiler_source_file("/workspace/app/main.brp", "main", ""),
	)


pure func test_user_import_precedence_is_package_then_std_then_local() -> Bool:
	match compiler_frontend_import_lookup_plan(candidate(CompilerUserModule), "dep"):
		[CompilerFrontendSourcePackageAliasLookup("dep"), CompilerFrontendStandardLibraryLookup("std/dep"), CompilerFrontendLocalPathLookup("/workspace/app/dep.brp")]:
			True
		_:
			False


pure func test_source_package_import_is_internal_only() -> Bool:
	match compiler_frontend_import_lookup_plan(
		candidate(CompilerSourcePackageModule("math")),
		"math_core/vector",
	):
		[CompilerFrontendSourcePackageInternalLookup("math", "math_core/vector")]:
			True
		_:
			False


pure func test_relative_import_retains_confinement_origin() -> Bool:
	match compiler_frontend_import_lookup_plan(
		candidate(CompilerSourcePackageModule("math")),
		"../shared",
	):
		[CompilerFrontendRelativePathLookup("/workspace/shared.brp", origin)]:
			compiler_module_origins_equal(origin, CompilerSourcePackageModule("math"))
		_:
			False


pure func test_explicit_native_import_is_forbidden_from_std_and_source_packages() -> Bool:
	(
		compiler_frontend_import_lookup_plan(
			candidate(CompilerStdlibModule),
			"pkg/sqlite",
		).is_empty()
		and compiler_frontend_import_lookup_plan(
			candidate(CompilerSourcePackageModule("math")),
			"pkg/sqlite",
		).is_empty()
		and match compiler_frontend_import_lookup_plan(candidate(CompilerUserModule), "pkg/sqlite"):
			[CompilerFrontendNativePackageLookup("pkg/sqlite")]:
				True
			_:
				False
	)


tests: TestSuite = {
	description = "Compiler frontend import lookup plan",
	tests = [
		(
			"user import precedence is package then std then local",
			test_user_import_precedence_is_package_then_std_then_local,
		),
		("source package import is internal only", test_source_package_import_is_internal_only),
		(
			"relative import retains confinement origin",
			test_relative_import_retains_confinement_origin,
		),
		(
			"explicit native import is forbidden from std and source packages",
			test_explicit_native_import_is_forbidden_from_std_and_source_packages,
		),
	]
}
