private enum RecordReuseFallbackFixture:
	FailRecordReuseFallback
	BodyRecordReuseFallback
	BindingsRecordReuseFallback


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func record_reuse_fallback_bindings() -> List[CoreMatchBinding]:
	[
		{
			variable = {
				name = "matched_value",
				uniq = 99,
				def_id = None
			},
			typ = bool_type(),
			accessor = RootAccessor,
			mode = MatchBorrowBindingMode
		},
	]


pure func preserves_record_reuse_fallback_binding(json: String) -> Bool:
	json.contains(
		"\"bindings\":[{\"variable\":{\"name\":\"matched_value\",\"uniq\":99,\"def_id\":null},\"type\":{\"kind\":\"named\",\"name\":\"Bool\",\"args\":[]},\"accessor\":{\"kind\":\"root\"},\"mode\":\"borrow\"}]",
	)


pure func function_decl(name: String, def_id: Int, body: CoreExpr) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func selected_call_without_callee_id(name: String, def_id: Int) -> CoreExpr:
	callee: CoreVar = {
		name = name,
		uniq = 0,
		def_id = None
	}
	CallExpr(
		SelectedDirectCall(def_id),
		VarExpr(callee, int_type(), SyntheticSourceLoc),
		[],
		int_type(),
		SyntheticSourceLoc,
	)


pure func test_pre_dce_tail_resolves_selected_direct_call() -> Bool:
	program: CoreProgram = {
		decls = [function_decl(
				"main",
				1,
				selected_call_without_callee_id("helper", 2),
			), function_decl(
				"helper",
				2,
				LiteralExpr(IntLiteral(42), int_type(), SyntheticSourceLoc),
			)],
		foreign_includes = []
	}

	json: String = match run_pre_dce_tail(program):
		PreparedCore(prepared):
			core_program_to_json(prepared).to_string()

	json.contains("\"call_kind\":{\"kind\":\"user\"") and not json.contains("selected_direct")


pure func test_perceus_snapshot_includes_production_projection_prefix() -> Bool:
	program: CoreProgram = {
		decls = [function_decl(
				"main",
				1,
				selected_call_without_callee_id("helper", 2),
			), function_decl(
				"helper",
				2,
				LiteralExpr(IntLiteral(42), int_type(), SyntheticSourceLoc),
			)],
		foreign_includes = []
	}
	json: String = core_program_to_json(run_core_pipeline_stage(PerceusStage, program)).to_string()

	json.contains("\"call_kind\":{\"kind\":\"user\"") and not json.contains("selected_direct")


pure func test_pre_dce_tail_projects_semantic_matches() -> Bool:
	subject: CoreVar = {
		name = "subject",
		uniq = 0,
		def_id = None
	}
	body: CoreExpr = SemanticMatchExpr(
		VarExpr(
			subject,
			int_type(),
			SyntheticSourceLoc,
		),
		SemanticLiteralMatch(
			RootSemanticMatchAccessor,
			[
				{
					literal = IntLiteral(7),
					body = SemanticMatchLeaf(
						[],
						LiteralExpr(IntLiteral(1), int_type(), SyntheticSourceLoc),
					)
				},
			],
			SemanticMatchLeaf(
				[],
				LiteralExpr(IntLiteral(0), int_type(), SyntheticSourceLoc),
			),
		),
		int_type(),
		SyntheticSourceLoc,
	)
	program: CoreProgram = {
		decls = [function_decl("classify", 3, body)],
		foreign_includes = []
	}

	json: String = match run_pre_dce_tail(program):
		PreparedCore(prepared):
			core_program_to_json(prepared).to_string()

	json.contains("\"kind\":\"literal_match\"") and not json.contains("\"kind\":\"semantic_match\"")


pure func test_pre_dce_tail_preserves_erased_float_argument_box() -> Bool:
	float_type: CoreType = NamedType("Float", [])
	vector_type: CoreType = TensorType({
		element_type = float_type,
		dims = [TensorStaticDim(4)],
	})
	call: CoreExpr = CallExpr(
		BuiltinCall("blorp_vector_set_cow_nullable"),
		VoidExpr(
			VoidType,
			SyntheticSourceLoc,
		),
		[
			VarExpr(
				{
					name = "values",
					uniq = 0,
					def_id = None
				},
				vector_type,
				SyntheticSourceLoc,
			),
			LiteralExpr(IntLiteral(1), int_type(), SyntheticSourceLoc),
			VarExpr(
				{
					name = "value",
					uniq = 0,
					def_id = None
				},
				float_type,
				SyntheticSourceLoc,
			),
		],
		NamedType(
			"Option",
			[vector_type],
		),
		SyntheticSourceLoc,
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, call)],
		foreign_includes = []
	}

	match run_pre_dce_tail(program):
		PreparedCore(prepared):
			match prepared.decls:
				[FunctionDecl(function_info)]:
					match function_info.body:
						Some(CallExpr(DirectRuntimeCall(runtime), _, [_, _, BoxExpr(box, NamedType("Ptr", []), _)], _, _)):
							runtime.name == "blorp_vector_set_cow_nullable" and box.kind == FloatBox
						_:
							False
				_:
					False


pure func test_named_list_layout_stage_relayouts_list_nodes() -> Bool:
	list_type: CoreType = NamedType("List", [int_type()])
	body: CoreExpr = ListConstructExpr(
		{
			layout = PointerListStorage,
			elements = [],
			elem_needs_release = True
		},
		list_type,
		SyntheticSourceLoc,
	)
	program: CoreProgram = {
		decls = [function_decl("main", 1, body)],
		foreign_includes = []
	}

	match parse_core_pipeline_stage("list_layout"):
		Some(ListLayoutStage):
			match run_core_pipeline_stage(ListLayoutStage, program).decls.get(0):
				Some(FunctionDecl(function_info)):
					match function_info.body:
						Some(ListConstructExpr(construct, _, _)):
							match construct.layout:
								InlineListStorage(width):
									width == 8 and not construct.elem_needs_release
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_specialize_stage_is_late_core_owned() -> Bool:
	parse_core_pipeline_stage("specialize") == Some(SpecializeStage)


pure func record_update_program() -> CoreProgram:
	point_type: CoreType = ValueRecordType("Point")
	point_var: CoreVar = {
		name = "point",
		uniq = 0,
		def_id = None
	}
	body: CoreExpr = RecordUpdateExpr(
		VarExpr(
			point_var,
			point_type,
			SyntheticSourceLoc,
		),
		[
			{
				name = "x",
				value = LiteralExpr(IntLiteral(10), int_type(), SyntheticSourceLoc)
			},
			{
				name = "y",
				value = FieldExpr(
					VarExpr(point_var, point_type, SyntheticSourceLoc),
					"y",
					int_type(),
					SyntheticSourceLoc,
				)
			},
		],
		point_type,
		SyntheticSourceLoc,
	)
	program: CoreProgram = {
		decls = [
			ValueRecordDecl({
				name = "Point",
				type_params = [],
				fields = [
					{
						name = "x",
						typ = int_type()
					},
					{
						name = "y",
						typ = int_type()
					},
				],
				loc = SyntheticSourceLoc,
			}),
			FunctionDecl({
				name = "main",
				source_module = None,
				type_params = [],
				params = [
					{
						name = point_var,
						typ = point_type,
						loc = SyntheticSourceLoc
					},
				],
				return_type = point_type,
				body = Some(body),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 3,
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}

	program


pure func test_dce_preserves_record_update_for_ownership() -> Bool:
	json: String = core_program_to_json(
		run_core_pipeline_stage(
			DceStage,
			record_update_program(),
		),
	).to_string()

	json.contains("\"kind\":\"record_update\"")


pure func test_record_update_normalization_preserves_complete_field_shape() -> Bool:
	match lower_record_updates_for_ownership(record_update_program()).decls:
		[ValueRecordDecl(_), FunctionDecl(function_info)]:
			match function_info.body:
				Some(RecordExpr(fields, _, _)):
					match (fields.get(0), fields.get(1)):
						(Some(first), Some(second)):
							first_is_replacement: Bool = match first.value:
								LiteralExpr(IntLiteral(10), _, _):
									True
								_:
									False

							second_uses_base: Bool = match second.value:
								FieldExpr(VarExpr(base, _, _), "y", _, _):
									base.name == "point"
								_:
									False

							(
								fields.length() == 2
								and first.name == "x"
								and first_is_replacement
								and second.name == "y"
								and second_uses_base
							)
						_:
							False
				_:
					False
		_:
			False


pure func heap_record_update_program_without_decl() -> CoreProgram:
	box_type: CoreType = HeapRecordType("Box__mono_Int")
	box_var: CoreVar = {
		name = "box",
		uniq = 0,
		def_id = None
	}
	box_ref: CoreExpr = VarExpr(box_var, box_type, SyntheticSourceLoc)
	body: CoreExpr = RecordUpdateExpr(
		box_ref,
		[
			{
				name = "count",
				value = LiteralExpr(IntLiteral(11), int_type(), SyntheticSourceLoc)
			},
			{
				name = "label",
				value = FieldExpr(
					box_ref,
					"label",
					NamedType("String", []),
					SyntheticSourceLoc,
				)
			},
		],
		box_type,
		SyntheticSourceLoc,
	)

	{
		decls = [
			FunctionDecl({
				name = "update_box",
				source_module = None,
				type_params = [],
				params = [
					{
						name = box_var,
						typ = box_type,
						loc = SyntheticSourceLoc
					},
				],
				return_type = box_type,
				body = Some(body),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 4,
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}


pure func test_record_update_normalization_is_total_after_monomorphization() -> Bool:
	match lower_record_updates_for_ownership(heap_record_update_program_without_decl()).decls:
		[FunctionDecl(function_info)]:
			match function_info.body:
				Some(RecordExpr(fields, HeapRecordType("Box__mono_Int"), _)):
					match (fields.get(0), fields.get(1)):
						(Some(first), Some(second)):
							first_is_replacement: Bool = match first.value:
								LiteralExpr(IntLiteral(11), _, _):
									True
								_:
									False

							second_uses_base: Bool = match second.value:
								FieldExpr(VarExpr(base, _, _), "label", _, _):
									base.name == "box"
								_:
									False

							(
								fields.length() == 2
								and first.name == "count"
								and first_is_replacement
								and second.name == "label"
								and second_uses_base
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_perceus_materializes_record_update_for_ownership() -> Bool:
	json: String = core_program_to_json(
		run_core_pipeline_stage(
			PerceusStage,
			record_update_program(),
		),
	).to_string()

	(
		not json.contains("\"kind\":\"record_update\"")
		and json.contains("\"kind\":\"record\"")
		and json.contains("\"field\":\"y\"")
	)


pure func counter_box_decl() -> CoreDecl:
	HeapRecordDecl({
		name = "CounterBox",
		type_params = [],
		fields = [
			{
				name = "count",
				typ = int_type(),
				release_policy = NoReleasePolicy
			},
			{
				name = "limit",
				typ = int_type(),
				release_policy = NoReleasePolicy
			},
		],
		loc = SyntheticSourceLoc,
	})


pure func heap_record_self_update_program() -> CoreProgram:
	box_type: CoreType = HeapRecordType("CounterBox")
	box_var: CoreVar = {
		name = "box",
		uniq = 0,
		def_id = None
	}
	update_base_var: CoreVar = {
		name = "__record_update_box",
		uniq = 1,
		def_id = None
	}
	box_ref: CoreExpr = VarExpr(box_var, box_type, SyntheticSourceLoc)
	update_base_ref: CoreExpr = VarExpr(update_base_var, box_type, SyntheticSourceLoc)
	update: CoreExpr = LetExpr(
		update_base_var,
		False,
		box_type,
		box_ref,
		RecordUpdateExpr(
			update_base_ref,
			[
				{
					name = "count",
					value = LiteralExpr(IntLiteral(11), int_type(), SyntheticSourceLoc)
				},
				{
					name = "limit",
					value = FieldExpr(update_base_ref, "limit", int_type(), SyntheticSourceLoc)
				},
			],
			box_type,
			SyntheticSourceLoc,
		),
	)
	body: CoreExpr = LetExpr(
		box_var,
		True,
		box_type,
		RecordConstructExpr(
			"CounterBox",
			[
				{
					name = "count",
					value = LiteralExpr(IntLiteral(10), int_type(), SyntheticSourceLoc)
				},
				{
					name = "limit",
					value = LiteralExpr(IntLiteral(20), int_type(), SyntheticSourceLoc)
				},
			],
			box_type,
			SyntheticSourceLoc,
		),
		SeqExpr(
			AssignExpr(box_var, update, VoidType, SyntheticSourceLoc),
			box_ref,
		),
	)

	{
		decls = [counter_box_decl(), FunctionDecl({
				name = "update_counter_box",
				source_module = None,
				type_params = [],
				params = [],
				return_type = box_type,
				body = Some(body),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 5,
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}


pure func test_perceus_marks_heap_record_self_update_for_reuse() -> Bool:
	json: String = core_program_to_json(
		run_core_pipeline_stage(
			PerceusStage,
			heap_record_self_update_program(),
		),
	).to_string()

	(
		json.contains("\"kind\":\"record_reuse\"")
		and not json.contains("\"kind\":\"record_update\"")
		and not json.contains("\"kind\":\"dup\",\"var\":{\"name\":\"box\"")
		and not json.contains("\"kind\":\"drop\",\"var\":{\"name\":\"box\"")
	)


pure func counter_box_update_from(
	box_var: CoreVar,
	update_base_var: CoreVar,
	count: Int,
	limit: Int,
) -> CoreExpr:
	box_type: CoreType = HeapRecordType("CounterBox")
	update_base_ref: CoreExpr = VarExpr(update_base_var, box_type, SyntheticSourceLoc)

	LetExpr(
		update_base_var,
		False,
		box_type,
		VarExpr(
			box_var,
			box_type,
			SyntheticSourceLoc,
		),
		RecordUpdateExpr(
			update_base_ref,
			[
				{
					name = "count",
					value = LiteralExpr(IntLiteral(count), int_type(), SyntheticSourceLoc)
				},
				{
					name = "limit",
					value = LiteralExpr(IntLiteral(limit), int_type(), SyntheticSourceLoc)
				},
			],
			box_type,
			SyntheticSourceLoc,
		),
	)


pure func heap_record_branch_self_update_program(
	mixed_else: Bool,
	mutating_condition: Bool,
	nested_else: Bool,
) -> CoreProgram:
	box_type: CoreType = HeapRecordType("CounterBox")
	box_var: CoreVar = {
		name = "box",
		uniq = 0,
		def_id = None
	}
	then_base_var: CoreVar = {
		name = "__record_update_box",
		uniq = 1,
		def_id = None
	}
	else_base_var: CoreVar = {
		name = "__record_update_box",
		uniq = 2,
		def_id = None
	}
	nested_else_base_var: CoreVar = {
		name = "__record_update_box",
		uniq = 3,
		def_id = None
	}
	box_ref: CoreExpr = VarExpr(box_var, box_type, SyntheticSourceLoc)

	flat_else_expr: CoreExpr = if mixed_else:
		box_ref
	else:
		counter_box_update_from(box_var, else_base_var, 12, 22)

	else_expr: CoreExpr = if nested_else:
		IfExpr(
			LiteralExpr(BoolLiteral(False), bool_type(), SyntheticSourceLoc),
			flat_else_expr,
			counter_box_update_from(box_var, nested_else_base_var, 14, 24),
			box_type,
			SyntheticSourceLoc,
		)
	else:
		flat_else_expr

	condition: CoreExpr = if mutating_condition:
		SeqExpr(
			AssignExpr(box_var, box_ref, VoidType, SyntheticSourceLoc),
			LiteralExpr(BoolLiteral(True), bool_type(), SyntheticSourceLoc),
		)
	else:
		LiteralExpr(BoolLiteral(True), bool_type(), SyntheticSourceLoc)

	update: CoreExpr = IfExpr(
		condition,
		counter_box_update_from(box_var, then_base_var, 11, 21),
		else_expr,
		box_type,
		SyntheticSourceLoc,
	)
	body: CoreExpr = LetExpr(
		box_var,
		True,
		box_type,
		RecordConstructExpr(
			"CounterBox",
			[
				{
					name = "count",
					value = LiteralExpr(IntLiteral(10), int_type(), SyntheticSourceLoc)
				},
				{
					name = "limit",
					value = LiteralExpr(IntLiteral(20), int_type(), SyntheticSourceLoc)
				},
			],
			box_type,
			SyntheticSourceLoc,
		),
		SeqExpr(
			AssignExpr(box_var, update, VoidType, SyntheticSourceLoc),
			box_ref,
		),
	)

	{
		decls = [counter_box_decl(), FunctionDecl({
				name = "branch_update_counter_box",
				source_module = None,
				type_params = [],
				params = [],
				return_type = box_type,
				body = Some(body),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 10,
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}


pure func test_perceus_reuses_heap_record_self_update_in_every_if_branch() -> Bool:
	json: String = core_program_to_json(
		run_core_pipeline_stage(
			PerceusStage,
			heap_record_branch_self_update_program(False, False, False),
		),
	).to_string()

	(
		json.count("\"kind\":\"record_reuse\"") == 2
		and not json.contains("\"kind\":\"record_update\"")
		and not json.contains("\"kind\":\"dup\",\"var\":{\"name\":\"box\"")
		and not json.contains("\"kind\":\"drop\",\"var\":{\"name\":\"box\"")
	)


pure func test_perceus_reuses_nested_if_branch_self_updates() -> Bool:
	json: String = core_program_to_json(
		run_core_pipeline_stage(
			PerceusStage,
			heap_record_branch_self_update_program(False, False, True),
		),
	).to_string()

	(
		json.count("\"kind\":\"record_reuse\"") == 3
		and not json.contains("\"kind\":\"record_update\"")
		and not json.contains("\"kind\":\"dup\",\"var\":{\"name\":\"box\"")
		and not json.contains("\"kind\":\"drop\",\"var\":{\"name\":\"box\"")
	)


pure func test_record_reuse_rejects_mixed_if_branches() -> Bool:
	json: String = core_program_to_json(
		lower_record_updates_for_ownership(
			heap_record_branch_self_update_program(
				True,
				False,
				False,
			),
		),
	).to_string()

	(
		json.contains("\"kind\":\"record\"")
		and not json.contains("\"kind\":\"record_reuse\"")
		and not json.contains("\"kind\":\"record_update\"")
	)


pure func test_record_reuse_rejects_if_condition_that_assigns_target() -> Bool:
	json: String = core_program_to_json(
		lower_record_updates_for_ownership(
			heap_record_branch_self_update_program(
				False,
				True,
