	(
		json.contains("\"kind\":\"record\"")
		and not json.contains("\"kind\":\"record_reuse\"")
		and not json.contains("\"kind\":\"record_update\"")
	)


pure func heap_record_match_self_update_program(
	mixed_false_case: Bool,
	mutating_scrutinee: Bool,
	malformed_result_type: Bool,
	fallback_fixture: RecordReuseFallbackFixture,
) -> CoreProgram:
	box_type: CoreType = HeapRecordType("CounterBox")
	box_var: CoreVar = {
		name = "box",
		uniq = 0,
		def_id = None
	}
	true_base_var: CoreVar = {
		name = "__record_update_box",
		uniq = 1,
		def_id = None
	}
	false_base_var: CoreVar = {
		name = "__record_update_box",
		uniq = 2,
		def_id = None
	}
	box_ref: CoreExpr = VarExpr(box_var, box_type, SyntheticSourceLoc)
	true_case: CoreConstructorMatchCase = {
		constructor = "True",
		accessor = RootAccessor,
		test = BoolTrueConstructorTest,
		bindings = [],
		body = ConstructorMatchBodyExpr(counter_box_update_from(box_var, true_base_var, 11, 21))
	}

	false_body: CoreExpr = if mixed_false_case:
		box_ref
	else:
		counter_box_update_from(box_var, false_base_var, 12, 22)

	false_case: CoreConstructorMatchCase = {
		constructor = "False",
		accessor = RootAccessor,
		test = BoolFalseConstructorTest,
		bindings = [],
		body = ConstructorMatchBodyExpr(false_body)
	}

	match_cases: List[CoreConstructorMatchCase] = match fallback_fixture:
		FailRecordReuseFallback:
			[true_case, false_case]
		_:
			[true_case]

	match_fallback: CoreConstructorMatchFallback = match fallback_fixture:
		BodyRecordReuseFallback:
			ConstructorMatchFallbackBody(false_body)
		BindingsRecordReuseFallback:
			ConstructorMatchFallbackBindings(record_reuse_fallback_bindings(), false_body)
		FailRecordReuseFallback:
			ConstructorMatchFallbackFail

	scrutinee: CoreExpr = if mutating_scrutinee:
		SeqExpr(
			AssignExpr(box_var, box_ref, VoidType, SyntheticSourceLoc),
			LiteralExpr(BoolLiteral(True), bool_type(), SyntheticSourceLoc),
		)
	else:
		LiteralExpr(BoolLiteral(True), bool_type(), SyntheticSourceLoc)

	match_result_type: CoreType = if malformed_result_type:
		int_type()
	else:
		box_type

	update: CoreExpr = ConstructorMatchExpr(
		scrutinee,
		NoReleasePolicy,
		match_cases,
		match_fallback,
		match_result_type,
		SyntheticSourceLoc,
	)
	body: CoreExpr = LetExpr(
		box_var,
		True,
		box_type,
		RecordConstructExpr(
			"CounterBox",
			[
				{
					name = "count",
					value = LiteralExpr(IntLiteral(10), int_type(), SyntheticSourceLoc)
				},
				{
					name = "limit",
					value = LiteralExpr(IntLiteral(20), int_type(), SyntheticSourceLoc)
				},
			],
			box_type,
			SyntheticSourceLoc,
		),
		SeqExpr(
			AssignExpr(box_var, update, VoidType, SyntheticSourceLoc),
			box_ref,
		),
	)

	{
		decls = [counter_box_decl(), FunctionDecl({
				name = "match_update_counter_box",
				source_module = None,
				type_params = [],
				params = [],
				return_type = box_type,
				body = Some(body),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 11,
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}


