pure func heap_record_nested_literal_match_self_update_program(
	mixed_inner_case: Bool,
	use_inner_fallback: Bool,
	malformed_inner_result_type: Bool,
	use_inner_length_match: Bool,
) -> CoreProgram:
	box_type: CoreType = HeapRecordType("CounterBox")
	box_var: CoreVar = {
		name = "box",
		uniq = 0,
		def_id = None
	}
	true_base_var: CoreVar = {
		name = "__record_update_box",
		uniq = 1,
		def_id = None
	}
	false_base_var: CoreVar = {
		name = "__record_update_box",
		uniq = 2,
		def_id = None
	}
	outer_base_var: CoreVar = {
		name = "__record_update_box",
		uniq = 3,
		def_id = None
	}
	box_ref: CoreExpr = VarExpr(box_var, box_type, SyntheticSourceLoc)

	inner_false_body: CoreExpr = if mixed_inner_case:
		box_ref
	else:
		counter_box_update_from(box_var, false_base_var, 12, 22)

	inner_cases: List[CoreLiteralMatchCase] = if use_inner_fallback:
		[
			{
				literal = BoolLiteral(True),
				bindings = [],
				body = counter_box_update_from(box_var, true_base_var, 11, 21)
			},
		]
	else:
		[
			{
				literal = BoolLiteral(True),
				bindings = [],
				body = counter_box_update_from(box_var, true_base_var, 11, 21)
			},
			{
				literal = BoolLiteral(False),
				bindings = [],
				body = inner_false_body
			},
		]

	inner_fallback: CoreLiteralMatchFallback = if use_inner_fallback:
		LiteralMatchFallbackBody(inner_false_body)
	else:
		LiteralMatchFallbackFail

	inner_result_type: CoreType = if malformed_inner_result_type:
		int_type()
	else:
		box_type

	inner_match: CoreConstructorLiteralMatch = {
		accessor = RootAccessor,
		scrutinee_type = bool_type(),
		cases = inner_cases,
		fallback = inner_fallback,
		result_type = inner_result_type,
		loc = SyntheticSourceLoc
	}
	inner_length_match: CoreConstructorLengthMatch = {
		accessor = RootAccessor,
		cases = [
			{
				length = 0,
				branch = {
					bindings = [],
					body = ConstructorMatchBodyExpr(
						counter_box_update_from(
							box_var,
							true_base_var,
							11,
							21,
						),
					)
				}
			},
		],
		geq = None,
		fallback = None,
		result_type = box_type,
		loc = SyntheticSourceLoc
	}

	outer_true_body: CoreConstructorMatchBody = if use_inner_length_match:
		ConstructorMatchBodyLength(inner_length_match)
	else:
		ConstructorMatchBodyLiteral(inner_match)

	outer_true_case: CoreConstructorMatchCase = {
		constructor = "True",
		accessor = RootAccessor,
		test = BoolTrueConstructorTest,
		bindings = [],
		body = outer_true_body
	}
	outer_false_case: CoreConstructorMatchCase = {
		constructor = "False",
		accessor = RootAccessor,
		test = BoolFalseConstructorTest,
		bindings = [],
		body = ConstructorMatchBodyExpr(counter_box_update_from(box_var, outer_base_var, 13, 23))
	}
	update: CoreExpr = ConstructorMatchExpr(
		LiteralExpr(
			BoolLiteral(True),
			bool_type(),
			SyntheticSourceLoc,
		),
		NoReleasePolicy,
		[outer_true_case, outer_false_case],
		ConstructorMatchFallbackFail,
		box_type,
		SyntheticSourceLoc,
	)
	body: CoreExpr = LetExpr(
		box_var,
		True,
		box_type,
		RecordConstructExpr(
			"CounterBox",
			[
				{
					name = "count",
					value = LiteralExpr(IntLiteral(10), int_type(), SyntheticSourceLoc)
				},
				{
					name = "limit",
					value = LiteralExpr(IntLiteral(20), int_type(), SyntheticSourceLoc)
				},
			],
			box_type,
			SyntheticSourceLoc,
		),
		SeqExpr(
			AssignExpr(box_var, update, VoidType, SyntheticSourceLoc),
			box_ref,
		),
	)

	{
		decls = [counter_box_decl(), FunctionDecl({
				name = "nested_literal_match_update_counter_box",
				source_module = None,
				type_params = [],
				params = [],
				return_type = box_type,
				body = Some(body),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 13,
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}


