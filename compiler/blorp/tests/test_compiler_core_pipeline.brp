	inner_base_ref: CoreExpr = VarExpr(inner_base_var, box_type, SyntheticSourceLoc)
	outer_base_ref: CoreExpr = VarExpr(outer_base_var, box_type, SyntheticSourceLoc)
	inner_update: CoreExpr = LetExpr(
		inner_base_var,
		False,
		box_type,
		box_ref,
		RecordUpdateExpr(
			inner_base_ref,
			[
				{
					name = "count",
					value = LiteralExpr(IntLiteral(11), int_type(), SyntheticSourceLoc)
				},
