					value = FieldExpr(inner_base_ref, "limit", int_type(), SyntheticSourceLoc)
				},
			],
			box_type,
			SyntheticSourceLoc,
		),
	)
	nested_update: CoreExpr = LetExpr(
		outer_base_var,
		False,
		box_type,
		inner_update,
		RecordUpdateExpr(
			outer_base_ref,
			[
				{
					name = "count",
					value = FieldExpr(outer_base_ref, "count", int_type(), SyntheticSourceLoc)
				},
				{
					name = "limit",
					value = LiteralExpr(IntLiteral(21), int_type(), SyntheticSourceLoc)
				},
			],
			box_type,
			SyntheticSourceLoc,
		),
	)
	body: CoreExpr = LetExpr(
		box_var,
		True,
		box_type,
		RecordConstructExpr(
			"CounterBox",
			[
				{
					name = "count",
					value = LiteralExpr(IntLiteral(10), int_type(), SyntheticSourceLoc)
				},
				{
					name = "limit",
					value = LiteralExpr(IntLiteral(20), int_type(), SyntheticSourceLoc)
				},
			],
			box_type,
			SyntheticSourceLoc,
		),
		SeqExpr(
			AssignExpr(box_var, nested_update, VoidType, SyntheticSourceLoc),
			box_ref,
		),
	)

	{
		decls = [counter_box_decl(), FunctionDecl({
				name = "nested_update_counter_box",
				source_module = None,
				type_params = [],
				params = [],
				return_type = box_type,
				body = Some(body),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 9,
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}


pure func test_nested_heap_record_self_update_stages_one_reuse() -> Bool:
	json: String = core_program_to_json(
		run_core_pipeline_stage(
			PerceusStage,
			heap_record_nested_self_update_program(),
		),
	).to_string()

	(
		json.count("\"kind\":\"record_reuse\"") == 1
		and not json.contains("\"kind\":\"record_update\"")
		and not json.contains("\"kind\":\"record\"")
		and json.contains("\"name\":\"$blorp$record_update$field$__record_update$1$0\"")
		and json.contains("\"name\":\"$blorp$record_update$field$__record_update$2$0\"")
	)


pure func heap_record_self_update_with_target_assignment_program() -> CoreProgram:
	box_type: CoreType = HeapRecordType("CounterBox")
	box_var: CoreVar = {
		name = "box",
		uniq = 0,
		def_id = None
	}
	update_base_var: CoreVar = {
		name = "__record_update_box",
		uniq = 1,
		def_id = None
	}
	box_ref: CoreExpr = VarExpr(box_var, box_type, SyntheticSourceLoc)
	update_base_ref: CoreExpr = VarExpr(update_base_var, box_type, SyntheticSourceLoc)
	update: CoreExpr = LetExpr(
		update_base_var,
		False,
		box_type,
		box_ref,
		RecordUpdateExpr(
			update_base_ref,
			[
				{
					name = "count",
					value = SeqExpr(
						AssignExpr(box_var, update_base_ref, VoidType, SyntheticSourceLoc),
						LiteralExpr(IntLiteral(11), int_type(), SyntheticSourceLoc),
					)
				},
				{
					name = "limit",
					value = FieldExpr(update_base_ref, "limit", int_type(), SyntheticSourceLoc)
				},
			],
			box_type,
			SyntheticSourceLoc,
		),
	)
	program: CoreProgram = {
		decls = [
			counter_box_decl(),
			FunctionDecl({
				name = "update_counter_box_with_target_assignment",
				source_module = None,
				type_params = [],
				params = [
					{
						name = box_var,
						typ = box_type,
						loc = SyntheticSourceLoc
					},
				],
				return_type = VoidType,
				body = Some(AssignExpr(box_var, update, VoidType, SyntheticSourceLoc)),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 6,
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}

	program


pure func test_record_reuse_rejects_fields_that_assign_the_target() -> Bool:
	json: String = core_program_to_json(
		lower_record_updates_for_ownership(
			heap_record_self_update_with_target_assignment_program(),
		),
	).to_string()

	(
		json.contains("\"kind\":\"record\"")
		and not json.contains("\"kind\":\"record_reuse\"")
		and not json.contains("\"kind\":\"record_update\"")
	)


pure func test_record_reuse_requires_matching_heap_record_declaration() -> Bool:
	program: CoreProgram = heap_record_self_update_program()

	match program.decls:
		[HeapRecordDecl(_), function_decl]:
			without_record_decl: CoreProgram = {
				decls = [function_decl],
				foreign_includes = []
			}
			json: String = core_program_to_json(
				lower_record_updates_for_ownership(without_record_decl),
			).to_string()

			(
				json.contains("\"kind\":\"record\"")
				and not json.contains("\"kind\":\"record_reuse\"")
				and not json.contains("\"kind\":\"record_update\"")
			)
		_:
			False


pure func test_record_reuse_classification_rejects_ordinary_let_assignment() -> Bool:
	box_type: CoreType = HeapRecordType("CounterBox")
	box_var: CoreVar = {
		name = "box",
		uniq = 0,
		def_id = None
	}
	temporary_var: CoreVar = {
		name = "temporary",
		uniq = 1,
		def_id = None
	}
	body: CoreExpr = AssignExpr(
		box_var,
		LetExpr(
			temporary_var,
			False,
			box_type,
			RecordConstructExpr("CounterBox", [], box_type, SyntheticSourceLoc),
			VarExpr(temporary_var, box_type, SyntheticSourceLoc),
		),
		VoidType,
		SyntheticSourceLoc,
	)
	program: CoreProgram = {
		decls = [function_decl("ordinary_let_assignment", 7, body)],
		foreign_includes = []
	}
	json: String = core_program_to_json(lower_record_updates_for_ownership(program)).to_string()

	(
		json.contains("\"kind\":\"record_construct\"")
		and not json.contains("\"kind\":\"record_reuse\"")
		and not json.contains("\"kind\":\"record_update\"")
	)


pure func test_record_update_normalization_handles_long_sequence_spines() -> Bool:
	var body: CoreExpr = LiteralExpr(IntLiteral(0), int_type(), SyntheticSourceLoc)

	for index in 0..4096:
		body = SeqExpr(
			LiteralExpr(IntLiteral(index), int_type(), SyntheticSourceLoc),
			body,
		)

	program: CoreProgram = {
		decls = [function_decl("long_sequence", 8, body)],
		foreign_includes = []
	}

	not record_update_carrier_survives(lower_record_updates_for_ownership(program))


