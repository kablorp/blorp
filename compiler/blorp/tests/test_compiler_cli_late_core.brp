import:
	../src/stage_09_core/compiler_core_json:
		CoreCallKind(SelectedDirectCall),
		CoreDecl(FunctionDecl),
		CoreExpr(CallExpr, LiteralExpr, VarExpr),
		CoreFunctionKind(UserFunction),
		CoreLiteral(IntLiteral),
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType),
		CoreVar,
		core_program_to_json,
	../src/stage_09_core/compiler_core_pipeline_stage: CorePipelineStage(DceStage)
	../src/stage_12_cli/compiler_cli_late_core:
		CliLateCoreExecution(CliLateCoreCompleted, CliLateCoreStopped),
		execute_late_core_stages,
	../src/stage_12_cli/compiler_cli_stage_requests:
		CliLateCoreStageAction(ObserveLateCoreStage, StopLateCoreStage),
		CliLateCoreStageRequest,
	test: TestSuite


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func function_decl(name: String, def_id: Int, body: CoreExpr) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func selected_helper_call() -> CoreExpr:
	callee: CoreVar = {
		name = "helper",
		uniq = 0,
		def_id = None
	}
	CallExpr(
		SelectedDirectCall(2),
		VarExpr(callee, int_type(), SyntheticSourceLoc),
		[],
		int_type(),
		SyntheticSourceLoc,
	)


pure func pre_dce_program() -> CoreProgram:
	{
		decls = [
			function_decl("main", 1, selected_helper_call()),
			function_decl(
				"helper",
				2,
				LiteralExpr(IntLiteral(42), int_type(), SyntheticSourceLoc),
			),
			function_decl(
				"dead",
				3,
				LiteralExpr(IntLiteral(0), int_type(), SyntheticSourceLoc),
			),
		],
		foreign_includes = []
	}


pure func test_empty_stage_requests_complete_final_pipeline() -> Bool:
	match execute_late_core_stages(pre_dce_program(), [], []):
		CliLateCoreCompleted(prepared, observations):
			encoded: String = core_program_to_json(prepared.program).to_string()

			(
				observations.length() == 0
				and not encoded.contains("selected_direct")
				and not encoded.contains("dead")
			)
		CliLateCoreStopped(_, _, _):
			False


pure func test_observation_does_not_replace_final_completion() -> Bool:
	stages: List[CliLateCoreStageRequest] = [{
		name = "dce",
		stage = DceStage,
		action = ObserveLateCoreStage
	}]

	match execute_late_core_stages(pre_dce_program(), [], stages):
		CliLateCoreCompleted(prepared, observations):
			final_core: String = core_program_to_json(prepared.program).to_string()

			match observations:
				[observation]:
					(
						observation.stage_name == "dce"
						and observation.rendered.contains("selected_direct")
						and not final_core.contains("selected_direct")
					)
				_:
					False
		CliLateCoreStopped(_, _, _):
			False


pure func test_stop_returns_requested_snapshot() -> Bool:
	stages: List[CliLateCoreStageRequest] = [{
		name = "dce",
		stage = DceStage,
		action = StopLateCoreStage
	}]

	match execute_late_core_stages(pre_dce_program(), [], stages):
		CliLateCoreStopped(stage_name, rendered, observations):
			(
				stage_name == "dce"
				and observations.length() == 0
				and rendered.contains("selected_direct")
			)
		CliLateCoreCompleted(_, _):
			False


tests: TestSuite = {
	description = "Blorp CLI late Core execution",
	tests = [
		(
			"empty stage requests complete the final pipeline",
			test_empty_stage_requests_complete_final_pipeline,
		),
		(
			"observations do not replace final completion",
			test_observation_does_not_replace_final_completion,
		),
		("stop returns requested snapshot", test_stop_returns_requested_snapshot),
	]
}
