pure func list_parallel_layout_args_policy(
	semantic_arity: Int,
	runtime_arity: Int,
	storage_mode: String,
	elem_size: String,
	value_encoding: String,
) -> CoreDirectRuntimeArgs:
	DirectRuntimeArgsAppendListParallelLayout({
		semantic_arity = semantic_arity,
		runtime_arity = runtime_arity,
		storage_mode = storage_mode,
		elem_size = elem_size,
		value_encoding = value_encoding,
	})


pure func direct_runtime_result_policy_for_return_type(
	return_type: CoreType,
) -> CoreDirectRuntimeResult:
	match return_type:
		StackResultType(ok_type, err_type):
			DirectRuntimeResultStackResultFromBoxed
		BoxedResultType(ok_type, err_type):
			DirectRuntimeResultAsWritten
		EnumType(name):
			DirectRuntimeResultAsWritten
		HeapRecordType(name):
			DirectRuntimeResultAsWritten
		NamedType(name, args):
			if name == "Result":
				DirectRuntimeResultStackResultFromBoxed
			else:
				DirectRuntimeResultAsWritten
		RangeType:
			DirectRuntimeResultAsWritten
		TensorType:
			DirectRuntimeResultAsWritten
		TupleType(items):
			DirectRuntimeResultAsWritten
		UnionType(name):
			DirectRuntimeResultAsWritten
		ValueRecordType(name):
			DirectRuntimeResultAsWritten
		VoidType:
			DirectRuntimeResultAsWritten


pure func direct_runtime_call_function_with_policy(
	function_name: String,
	builtin_name: String,
	params: List[CoreParam],
	return_type: CoreType,
	def_id: Int,
	args_policy: CoreDirectRuntimeArgs,
	result_policy: CoreDirectRuntimeResult,
) -> CoreFunction:
	var args: List[CoreExpr] = []

	for param in params:
		args = args.append(param_var_expr(param))

	{
		name = function_name,
		source_module = None,
		type_params = [],
		params = params,
		return_type = return_type,
		body = Some(CallExpr(
			DirectRuntimeCall({
				name = builtin_name,
				args = args_policy,
				result = result_policy,
			}),
			VarExpr(named_var(builtin_name), closure_type(), SyntheticSourceLoc),
			args,
			return_type,
			SyntheticSourceLoc,
		)),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc
	}


pure func direct_builtin_call_function(
	function_name: String,
	builtin_name: String,
	params: List[CoreParam],
	return_type: CoreType,
	def_id: Int,
) -> CoreFunction:
	direct_runtime_call_function_with_policy(
		function_name,
		builtin_name,
		params,
		return_type,
		def_id,
		DirectRuntimeArgsAsWritten,
		direct_runtime_result_policy_for_return_type(return_type),
	)


