pure func let_list_append_transfer_function() -> CoreFunction:
	source_param: CoreParam = list_string_param("source")
	elem_param: CoreParam = string_param("elem")
	source_var: CoreVar = named_var("source_owner")
	elem_var: CoreVar = named_var("__std_inline_elem")
	len_var: CoreVar = named_var("__std_inline___n")
	result_var: CoreVar = named_var("__std_inline___result")
	cdrop_var: CoreVar = named_var("__cdrop___std_inline_elem")
	source_expr: CoreExpr = VarExpr(source_var, list_string_type(), SyntheticSourceLoc)
	elem_expr: CoreExpr = VarExpr(elem_var, string_type(), SyntheticSourceLoc)
	len_expr: CoreExpr = VarExpr(len_var, int_type(), SyntheticSourceLoc)
	result_expr: CoreExpr = VarExpr(result_var, list_string_type(), SyntheticSourceLoc)
	next_len_expr: CoreExpr = BinaryExpr(
		AddOp,
		len_expr,
		LiteralExpr(IntLiteral(1), int_type(), SyntheticSourceLoc),
		int_type(),
		SyntheticSourceLoc,
	)
	append_body: CoreExpr = LetExpr(
		len_var,
		False,
		int_type(),
		list_string_intrinsic_expr(
			"list_len",
			[source_expr],
			int_type(),
		),
		LetExpr(
			result_var,
			False,
			list_string_type(),
			list_string_intrinsic_expr(
				"list_ensure_capacity",
				[source_expr, next_len_expr],
				list_string_type(),
			),
			SeqExpr(
				ListRetainExpr(
					{
						list = result_expr,
						value = string_boxed_value(elem_expr)
					},
					VoidType,
					SyntheticSourceLoc,
				),
				SeqExpr(
					ListSetExpr(
						{
							layout = PointerListStorage,
							list = result_expr,
							index = len_expr,
							value = string_boxed_value(elem_expr),
							value_is_stack_result = False
						},
						VoidType,
						SyntheticSourceLoc,
					),
					SeqExpr(
						list_string_intrinsic_expr(
							"list_set_len",
							[result_expr, next_len_expr],
							VoidType,
						),
						result_expr,
					),
				),
			),
		),
	)

	{
		name = "let_list_append_transfer",
		source_module = None,
		type_params = [],
		params = [source_param, elem_param],
		return_type = list_string_type(),
		body = Some(
			LetExpr(
				source_var,
				False,
				list_string_type(),
				param_var_expr(source_param),
				LetExpr(
					elem_var,
					False,
					string_type(),
					param_var_expr(elem_param),
					LetExpr(
						cdrop_var,
						False,
						list_string_type(),
						append_body,
						DropExpr(
							elem_var,
							string_type(),
							ArcReleaseOnlyPolicy,
							VarExpr(cdrop_var, list_string_type(), SyntheticSourceLoc),
							list_string_type(),
