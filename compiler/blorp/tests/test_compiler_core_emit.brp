		and artifact.c_code.contains("blorp_Closure* __cl = (blorp_Closure*)callback")
		and artifact.c_code.contains("void* __cl_arg_0 = (void*)(long)(value)")
		and artifact.c_code.contains(
			"void* __cl_r = ((void* (*)(void*, void*))(__cl->func))(__cl->env, __cl_arg_0)",
		)
		and artifact.c_code.contains("return ({ blorp_Closure* __cl")
		and artifact.c_code.contains("; ((long)(long)__cl_r); })")
