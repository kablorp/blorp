import:
	../compiler_artifact_json: CArtifact
	../compiler_core_emit: emit_core_program_c_artifact
	../compiler_core_json:
		CoreBinaryOp(AddOp, DivideOp, EqualOp, LessOp, ModuloOp),
		CoreCallKind(UserCall),
		CoreDecl(FunctionDecl),
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			BreakExpr,
			CastExpr,
			CallExpr,
			CooperativeCheckpointExpr,
			ContinueExpr,
			IfExpr,
			LetExpr,
			LiteralExpr,
			LogicalExpr,
			SeqExpr,
			UnaryExpr,
			VarExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreLiteral(BoolLiteral, IntLiteral, StringLiteral),
		CoreLogicalOp(AndOp, OrOp),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
		CoreUnaryOp(NegateOp, NotOp),
		CoreVar,
	test: TestSuite


pure func empty_program() -> CoreProgram:
	{decls = []}


pure func main_function() -> CoreFunction:
	{
		name = "main",
		source_module = None,
		type_params = [],
		params = [],
		return_type = VoidType,
		body = None,
		is_pure = False,
		function_kind = UserFunction,
		def_id = 1,
		loc = SyntheticSourceLoc
	}


