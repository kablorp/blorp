pure func test_emit_empty_program_artifact_shape() -> Bool:
	artifact: CArtifact = emit_core_program_c_artifact(empty_program())

	(
		artifact.c_code.contains("Blorp final Core C artifact")
		and artifact.c_code.contains("#include <stdint.h>")
		and artifact.link_flags.length() == 0
		and artifact.include_dirs.length() == 0
	)


pure func test_emit_foreign_includes_before_declarations() -> Bool:
	program: CoreProgram = {
		decls = [FunctionDecl(main_return_zero_function())],
		foreign_includes = ["ffi_bytes_inspect_header.h", "string.h"]
	}
	artifact: CArtifact = emit_core_program_c_artifact(program)
	std_include_index: Option[Int] = artifact.c_code.index_of("#include <string.h>")
	foreign_include_index: Option[Int] = artifact.c_code.index_of(
		"#include \"ffi_bytes_inspect_header.h\"",
	)
	second_foreign_include_index: Option[Int] = artifact.c_code.index_of("#include \"string.h\"")
	declaration_index: Option[Int] = artifact.c_code.index_of("int main(void)")

	(
		option_int_less_than(std_include_index, foreign_include_index)
		and option_int_less_than(foreign_include_index, second_foreign_include_index)
		and option_int_less_than(second_foreign_include_index, declaration_index)
	)


pure func test_emit_foreign_default_bytes_call_copies_and_releases() -> Bool:
	program: CoreProgram = {
		decls = [FunctionDecl(foreign_bytes_default_copy_function())],
		foreign_includes = []
	}
	artifact: CArtifact = emit_core_program_c_artifact(program)
	copy_index: Option[Int] = artifact.c_code.index_of("blorp_Bytes* __ffi_bytes_copy_")
	call_index: Option[Int] = artifact.c_code.index_of("inspect_bytes(__ffi_bytes_copy_")
	release_index: Option[Int] = artifact.c_code.index_of("blorp_release(__ffi_bytes_copy_")

	(
		artifact.c_code.contains(" = blorp_bytes_copy_ffi(payload);")
		and option_int_less_than(copy_index, call_index)
		and option_int_less_than(call_index, release_index)
	)


