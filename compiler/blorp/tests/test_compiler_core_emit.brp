	program: CoreProgram = {decls = [FunctionDecl(forward_range_sum_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long sum_forward_range(void)")
		and artifact.c_code.contains("long __range_start_0 = counter;")
		and artifact.c_code.contains("long __range_end_0 = 3;")
		and artifact.c_code.contains("for (long i = __range_start_0; i < __range_end_0; i++) {")
		and artifact.c_code.contains("blorp_cooperative_checkpoint();")
		and not artifact.c_code.contains("__range_step_0")
		and artifact.c_code.contains("return counter;")
	)


