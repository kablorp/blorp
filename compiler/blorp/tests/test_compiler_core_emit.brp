		),
		LetExpr(
			matches_var,
			False,
			bool_type(),
			BinaryExpr(
				EqualOp,
				VarExpr(text_var, string_type(), SyntheticSourceLoc),
				LiteralExpr(StringLiteral("3.14"), string_type(), SyntheticSourceLoc),
				bool_type(),
				SyntheticSourceLoc,
