pure func test_emit_empty_program_artifact_shape() -> Bool:
	artifact: CArtifact = emit_core_program_c_artifact(empty_program())

	(
		artifact.c_code.contains("Blorp final Core C artifact")
		and artifact.link_flags.length() == 0
		and artifact.include_dirs.length() == 0
	)


pure func test_emit_function_inventory_comment() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(main_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	artifact.c_code.contains("function main") and artifact.c_code.contains("def_id=1")


pure func test_emit_main_return_int_literal() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(main_return_zero_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("int main(void)")
		and artifact.c_code.contains("return 0;")
		and not artifact.c_code.contains("function main")
	)


pure func test_emit_main_with_source_args_uses_c_entrypoint_signature() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(main_return_zero_with_args_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("int main(int argc, char** argv)")
		and artifact.c_code.contains("(void)argc;")
		and artifact.c_code.contains("(void)argv;")
		and artifact.c_code.contains("return 0;")
	)


pure func test_emit_identity_function_with_int_param() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(identity_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long id(long x)")
		and artifact.c_code.contains("return x;")
		and not artifact.c_code.contains("function id")
	)


pure func test_emit_closure_param_function_signature() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(closure_param_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	artifact.c_code.contains("long accept_callback(blorp_Closure* callback)")


pure func test_emit_if_expression_as_ternary() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(main_return_if_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	artifact.c_code.contains("return (1 ? 1 : 2);")


pure func test_emit_binary_add_expression() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(add_one_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	artifact.c_code.contains("long add_one(long x)") and artifact.c_code.contains("return (x + 1);")


pure func test_emit_binary_divide_expression_is_infallible() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(divide_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long safe_divide(void)")
		and artifact.c_code.contains("return ((0) == 0 ? 0 : (7 / 0));")
	)


pure func test_emit_binary_modulo_expression_is_infallible() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(modulo_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long safe_modulo(void)")
		and artifact.c_code.contains("return ((0) == 0 ? 0 : (7 % 0));")
	)


pure func test_emit_unary_negate_expression() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(negate_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	artifact.c_code.contains("long negate(void)") and artifact.c_code.contains("return (-7);")


pure func test_emit_unary_not_expression() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(not_false_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	artifact.c_code.contains("int not_false(void)") and artifact.c_code.contains("return (!0);")


pure func test_emit_cast_expression() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(cast_int_to_float_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("double int_to_float(void)")
		and artifact.c_code.contains("return ((double)7);")
	)


pure func test_emit_logical_and_expression() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(logical_and_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("int logical_and(void)")
		and artifact.c_code.contains("return (1 && 0);")
	)


pure func test_emit_logical_or_expression() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(logical_or_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("int logical_or(void)")
		and artifact.c_code.contains("return (0 || 1);")
	)


pure func test_emit_escaped_string_literal() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(escaped_string_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("const char* escaped_string(void)")
		and artifact.c_code.contains("return \"line\\n\\\"quote\\\"\\\\slash\";")
	)


pure func test_emit_simple_user_call_expression() -> Bool:
	program: CoreProgram = {
		decls = [FunctionDecl(identity_function()), FunctionDecl(main_call_identity_function())],
	}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long id(long x)")
		and artifact.c_code.contains("int main(void)")
		and artifact.c_code.contains("return id(41);")
	)


pure func test_emit_let_binding_statement() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(let_add_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long let_add(void)")
		and artifact.c_code.contains("long y = 40;")
		and artifact.c_code.contains("return (y + 2);")
	)


pure func test_emit_void_let_as_statement_sequence() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(void_let_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long void_let(void)")
		and artifact.c_code.contains("touch(1);")
		and artifact.c_code.contains("return 3;")
		and not artifact.c_code.contains("void ignored_void =")
	)


pure func test_emit_discard_let_without_binding_declaration() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(discard_let_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long discard_let(void)")
		and artifact.c_code.contains("(void)(9);")
		and artifact.c_code.contains("return 4;")
		and not artifact.c_code.contains("long _ =")
	)


pure func test_emit_assignment_statement() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(assign_then_return_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long assign_then_return(void)")
		and artifact.c_code.contains("long counter = 0;")
		and artifact.c_code.contains("counter = 42;")
		and not artifact.c_code.contains("counter = 42;\n  0;")
		and artifact.c_code.contains("return counter;")
	)


pure func test_emit_while_statement() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(while_counter_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long count_to_three(void)")
		and artifact.c_code.contains("long counter = 0;")
		and artifact.c_code.contains("while ((counter < 3)) {")
		and artifact.c_code.contains("blorp_cooperative_checkpoint();")
		and artifact.c_code.contains("counter = (counter + 1);")
		and artifact.c_code.contains("return counter;")
	)


pure func test_emit_break_and_continue_statements() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(break_continue_loop_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long break_continue_loop(void)")
		and artifact.c_code.contains("while ((counter < 5)) {")
		and artifact.c_code.contains("if ((counter == 3)) {")
		and artifact.c_code.contains("continue;")
		and artifact.c_code.contains("if ((counter == 4)) {")
		and artifact.c_code.contains("break;")
		and not artifact.c_code.contains("__if_result")
		and artifact.c_code.contains("return counter;")
	)


pure func test_emit_sequence_statement_before_return() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(call_then_return_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long call_then_return(void)")
		and artifact.c_code.contains("touch(1);")
		and artifact.c_code.contains("return 2;")
	)


pure func test_emit_statement_if_with_result_temp() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(if_with_let_branch_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long branch_let(void)")
		and artifact.c_code.contains("long __if_result_0;")
		and artifact.c_code.contains("if (1) {")
		and artifact.c_code.contains("long y = 11;")
		and artifact.c_code.contains("__if_result_0 = y;")
		and artifact.c_code.contains("} else {")
		and artifact.c_code.contains("__if_result_0 = 5;")
		and artifact.c_code.contains("return __if_result_0;")
	)


pure func test_emit_nested_statement_if_with_distinct_temps() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(nested_if_with_let_branch_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long nested_branch_let(void)")
		and artifact.c_code.contains("long __if_result_0;")
		and artifact.c_code.contains("long __if_result_1;")
		and artifact.c_code.contains("__if_result_1 = y;")
		and artifact.c_code.contains("__if_result_0 = __if_result_1;")
		and artifact.c_code.contains("return __if_result_0;")
	)


tests: TestSuite = {
	description = "Blorp compiler Core emit",
	tests = [
		("emit empty program artifact shape", test_emit_empty_program_artifact_shape),
		("emit function inventory comment", test_emit_function_inventory_comment),
		("emit main return int literal", test_emit_main_return_int_literal),
		(
			"emit main with source args uses C entrypoint signature",
			test_emit_main_with_source_args_uses_c_entrypoint_signature,
		),
		("emit identity function with Int param", test_emit_identity_function_with_int_param),
		("emit closure param function signature", test_emit_closure_param_function_signature),
		("emit if expression as ternary", test_emit_if_expression_as_ternary),
		("emit binary add expression", test_emit_binary_add_expression),
		(
			"emit binary divide expression is infallible",
			test_emit_binary_divide_expression_is_infallible,
		),
		(
			"emit binary modulo expression is infallible",
			test_emit_binary_modulo_expression_is_infallible,
		),
		("emit unary negate expression", test_emit_unary_negate_expression),
		("emit unary not expression", test_emit_unary_not_expression),
		("emit cast expression", test_emit_cast_expression),
		("emit logical and expression", test_emit_logical_and_expression),
		("emit logical or expression", test_emit_logical_or_expression),
		("emit escaped string literal", test_emit_escaped_string_literal),
		("emit simple user call expression", test_emit_simple_user_call_expression),
		("emit let binding statement", test_emit_let_binding_statement),
		("emit void let as statement sequence", test_emit_void_let_as_statement_sequence),
		(
			"emit discard let without binding declaration",
			test_emit_discard_let_without_binding_declaration,
		),
		("emit assignment statement", test_emit_assignment_statement),
		("emit while statement", test_emit_while_statement),
		("emit break and continue statements", test_emit_break_and_continue_statements),
		("emit sequence statement before return", test_emit_sequence_statement_before_return),
		("emit statement if with result temp", test_emit_statement_if_with_result_temp),
		(
			"emit nested statement if with distinct temps",
			test_emit_nested_statement_if_with_distinct_temps,
		),
	]
}
