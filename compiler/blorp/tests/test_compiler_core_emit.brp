pure func test_emit_enum_declaration_and_typed_function() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(is_red_function()), EnumDecl(color_enum_decl())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)
	red_define_index: Option[Int] = artifact.c_code.index_of("#define __def_101_Red 0L")
	function_index: Option[Int] = artifact.c_code.index_of("int is_red(long color)")
	define_before_function: Bool = option_int_less_than(red_define_index, function_index)

	(
		artifact.c_code.contains("#define __def_101_Red 0L")
		and artifact.c_code.contains("#define __def_102_Blue 1L")
		and artifact.c_code.contains("int is_red(long color)")
		and artifact.c_code.contains("return (color == __def_101_Red);")
		and define_before_function
		and not artifact.c_code.contains("int is_red(void* color)")
	)


