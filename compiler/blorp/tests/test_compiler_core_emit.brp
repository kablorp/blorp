pure func test_emit_static_closure_create() -> Bool:
	program: CoreProgram = {
		decls = [
			FunctionDecl(static_closure_body_function()),
			FunctionDecl(static_closure_create_function()),
		],
	}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("void* __def_77__blorp_eta_0(void* __env, void* __arg0)")
		and artifact.c_code.contains("(void)__env;")
		and artifact.c_code.contains("long x = (long)(long)__arg0;")
		and artifact.c_code.contains("return (void*)(long)(x);")
		and artifact.c_code.contains((
				"static blorp_Closure __sc___def_77__blorp_eta_0 = { { BLORP_IMMORTAL_REFCOUNT, "
				+ "BLORP_ALLOC_CLASS_DIRECT, 0 }, (void*)__def_77__blorp_eta_0, NULL, 0, 0 };"
			))
		and artifact.c_code.contains("blorp_Closure* make_callback(void)")
		and artifact.c_code.contains("return ((void*)&__sc___def_77__blorp_eta_0);")
	)


pure func test_emit_captured_closure_create() -> Bool:
	program: CoreProgram = {
		decls = [
			FunctionDecl(captured_closure_create_function()),
			FunctionDecl(captured_closure_body_function()),
		],
	}
	artifact: CArtifact = emit_core_program_c_artifact(program)
	prototype_index: Option[Int] = artifact.c_code.index_of(
		"void* __def_80__blorp_eta_1(void* __env, void* __arg0);",
	)
	creator_index: Option[Int] = artifact.c_code.index_of("blorp_Closure* make_adder(long base) {")
	body_index: Option[Int] = artifact.c_code.index_of(
		"void* __def_80__blorp_eta_1(void* __env, void* __arg0) {",
	)

	(
		artifact.c_code.contains("void* __def_80__blorp_eta_1(void* __env, void* __arg0)")
		and artifact.c_code.contains("void** __e = (void**)__env;")
		and artifact.c_code.contains("long base = (long)(long)__e[0];")
		and artifact.c_code.contains("long x = (long)(long)__arg0;")
		and artifact.c_code.contains("return (void*)(long)((base + x));")
		and artifact.c_code.contains("blorp_Closure* make_adder(long base)")
		and artifact.c_code.contains("blorp_closure_new_inline((void*)__def_80__blorp_eta_1, 1)")
		and artifact.c_code.contains("((void**)__cl_new->env)[0] = (void*)(long)(base);")
		and artifact.c_code.contains("__cl_new->env_release_mask = 0UL;")
		and artifact.c_code.contains("return ({ blorp_Closure* __cl_new")
		and option_int_less_than(prototype_index, creator_index)
		and option_int_less_than(creator_index, body_index)
	)


