pure func test_emit_tuple_construct_and_field_access() -> Bool:
	program: CoreProgram = {
		decls = [
			FunctionDecl(make_pair_function()),
			FunctionDecl(pair_sum_function()),
			FunctionDecl(drop_pair_function()),
			FunctionDecl(make_range_tuple_function()),
			FunctionDecl(range_tuple_value_function()),
		],
		foreign_includes = []
	}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("blorp_Tuple* make_pair(long a, long b)")
		and artifact.c_code.contains("blorp_tuple_new(2, (void*)(long)(a), (void*)(long)(b))")
		and artifact.c_code.contains("long pair_sum(blorp_Tuple* pair)")
		and artifact.c_code.contains("((blorp_Tuple*)pair)->elem[0]")
		and artifact.c_code.contains("((blorp_Tuple*)pair)->elem[1]")
		and artifact.c_code.contains("long drop_pair(blorp_Tuple* pair)")
		and artifact.c_code.contains("blorp_release(pair);")
		and artifact.c_code.contains("blorp_Tuple* make_range_tuple(long value)")
		and artifact.c_code.contains("blorp_tuple_new(1, (void*)(long)(value))")
		and artifact.c_code.contains("long range_tuple_value(blorp_Tuple* pair)")
		and artifact.c_code.contains("return ((long)((blorp_Tuple*)pair)->elem[0]);")
	)


