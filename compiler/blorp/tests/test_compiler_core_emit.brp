pure func choice_string_reuse_function() -> CoreFunction:
	source_var: CoreVar = named_var("source")
	result_var: CoreVar = named_var("result")
	payload_var: CoreVar = named_var("payload")
	payload_expr: CoreExpr = VarExpr(payload_var, string_type(), SyntheticSourceLoc)
	construct: CoreExpr = UnionConstructExpr(
		{
			type_name = "Choice__mono_String",
			constructor_name = "Picked",
			constructor_c_name = "__def_144_Picked",
			representation = GenericUnionRepresentation,
			payload_storage = TypedUnionPayloadStorage,
			uses_release_mask = True,
			release_mask = 1,
			args = [string_boxed_value(payload_expr)]
		},
		choice_string_type(),
		SyntheticSourceLoc,
	)
	picked_case: CoreConstructorMatchCase = {
		constructor = "Picked",
		accessor = RootAccessor,
		test = UnionTagConstructorTest("TAG_Choice__mono_String_Picked", "Choice__mono_String"),
		bindings = [{
				variable = payload_var,
				typ = string_type(),
				accessor = VariantFieldAccessor(RootAccessor, "Choice__mono_String", "Picked", 0),
				mode = MatchOwnBindingMode
			}],
		body = ConstructorMatchBodyExpr(construct)
	}
	body: CoreExpr = LetExpr(
		result_var,
		False,
		choice_string_type(),
		ConstructorMatchExpr(
			VarExpr(source_var, choice_string_type(), SyntheticSourceLoc),
			ArcReleasePolicy,
			[picked_case],
			ConstructorMatchFallbackFail,
			choice_string_type(),
			SyntheticSourceLoc,
		),
		DropExpr(
			source_var,
			choice_string_type(),
			ArcReleasePolicy,
			VarExpr(result_var, choice_string_type(), SyntheticSourceLoc),
			choice_string_type(),
			SyntheticSourceLoc,
		),
	)

	{
		name = "reuse_choice_string",
		source_module = None,
		type_params = [],
		params = [{
				name = source_var,
				typ = choice_string_type(),
				loc = SyntheticSourceLoc
			}],
		return_type = choice_string_type(),
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 246,
		loc = SyntheticSourceLoc
	}


