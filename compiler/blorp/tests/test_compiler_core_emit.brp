pure func test_emit_drop_release_policies() -> Bool:
	program: CoreProgram = {
		decls = [
			FunctionDecl(
				drop_policy_function(
					"drop_arc_only",
					string_type(),
					ArcReleaseOnlyPolicy,
					117,
				),
			),
			FunctionDecl(
				drop_policy_function(
					"drop_stack_result",
					stack_result_type(),
					StackResultReleasePolicy,
					118,
				),
			),
			FunctionDecl(drop_policy_function("drop_none", int_type(), NoReleasePolicy, 119)),
			FunctionDecl(dup_policy_function("dup_arc", string_type(), ArcRetainPolicy, 120)),
			FunctionDecl(
				dup_policy_function(
					"dup_stack_result",
					stack_result_type(),
					StackResultRetainPolicy,
					121,
				),
			),
			FunctionDecl(dup_policy_function("dup_none", int_type(), NoRetainPolicy, 122)),
		],
		foreign_includes = []
	}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long drop_arc_only(blorp_String* value)")
		and artifact.c_code.contains("blorp_release_arc_only(value);")
		and artifact.c_code.contains("long drop_stack_result(void* value)")
		and artifact.c_code.contains("blorp_stack_result_release(value);")
		and artifact.c_code.contains("long drop_none(long value)")
		and artifact.c_code.contains("blorp_String* dup_arc(blorp_String* value)")
		and artifact.c_code.contains("blorp_retain(value);")
		and artifact.c_code.contains("void* dup_stack_result(void* value)")
		and artifact.c_code.contains("blorp_stack_result_retain(value);")
		and artifact.c_code.contains("long dup_none(long value)")
		and not artifact.c_code.contains("blorp_release(value);")
	)


