pure func test_emit_heap_record_declaration_and_field_access() -> Bool:
	program: CoreProgram = {
		decls = [HeapRecordDecl(box_heap_record_decl()), FunctionDecl(box_count_function())],
		foreign_includes = []
	}
	artifact: CArtifact = emit_core_program_c_artifact(program)
	forward_index: Option[Int] = artifact.c_code.index_of("typedef struct Box Box;")
	record_index: Option[Int] = artifact.c_code.index_of("typedef struct Box {")
	function_index: Option[Int] = artifact.c_code.index_of("long box_count(Box* box)")

	(
		artifact.c_code.contains("typedef struct Box Box;")
		and artifact.c_code.contains("typedef struct Box {")
		and artifact.c_code.contains("  blorp_Object header;")
		and artifact.c_code.contains("  long count;")
		and artifact.c_code.contains("  blorp_String* label;")
		and artifact.c_code.contains("static void Box_destroy(void* obj)")
		and artifact.c_code.contains(
			"if (__rec->label) blorp_release((blorp_Object*)__rec->label);",
		)
		and artifact.c_code.contains("Box* Box_make(long count, blorp_String* label)")
		and artifact.c_code.contains("BLORP_SET_DESTRUCTOR(__rec, Box_destroy);")
		and artifact.c_code.contains("long box_count(Box* box)")
		and artifact.c_code.contains("return box->count;")
		and option_int_less_than(forward_index, record_index)
		and option_int_less_than(record_index, function_index)
	)


