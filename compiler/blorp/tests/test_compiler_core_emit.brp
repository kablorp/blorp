import:
	../compiler_artifact_json: CArtifact
	../compiler_core_emit: emit_core_program_c_artifact
	../compiler_core_json:
		CoreBinaryOp(AddOp, DivideOp, EqualOp, LessOp, ModuloOp, SubtractOp),
		CoreCallKind(BuiltinCall, IntrinsicCall, UserCall),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(ConstructorMatchFallbackFail),
		CoreDecl(EnumDecl, FunctionDecl, GlobalDecl, ValueRecordDecl),
		CoreEnumDecl,
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			BreakExpr,
			CastExpr,
			CallExpr,
			ConstructorMatchExpr,
			CooperativeCheckpointExpr,
			ContinueExpr,
			FieldExpr,
			ForRangeExpr,
			IfExpr,
			LetExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			RangeExpr,
			SeqExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			UnaryExpr,
			VarExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreGlobal,
		CoreLiteral(BoolLiteral, CharLiteral, FloatLiteral, IntLiteral, StringLiteral),
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(LiteralMatchFallbackBody, LiteralMatchFallbackFail),
		CoreLogicalOp(AndOp, OrOp),
		CoreLoopBinder,
		CoreLoopRangeDirection(RangeForwardOnly, RangeMayRunBackward),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(EnumType, NamedType, ValueRecordType, VoidType),
		CoreUnaryOp(NegateOp, NotOp),
		CoreValueRecordDecl,
		CoreVar,
	test: TestSuite


