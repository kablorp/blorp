pure func test_emit_self_recursive_union_destructor_is_iterative() -> Bool:
	program: CoreProgram = {
		decls = [UnionDecl(doc_union_decl())],
		foreign_includes = []
	}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	artifact.c_code.contains((
			"static void Doc_destroy_release_child(Doc*** stack, long* count, long* capacity,"
			+ " Doc* value)"
		)) and artifact.c_code.contains(
		"long previous_refcount = BLORP_RC_DEC_PREV(header->refcount);",
	) and artifact.c_code.contains((
			"static void Doc_destroy_fields(Doc* self, Doc*** __destroy_stack, long* "
			+ "__destroy_count, long* __destroy_capacity)"
		)) and artifact.c_code.contains((
			"if ((self->release_mask & 1UL) && self->data.Group.field0) "
			+ "Doc_destroy_release_child(__destroy_stack, __destroy_count, __destroy_capacity, "
			+ "(Doc*)self->data.Group.field0);"
		)) and artifact.c_code.contains((
			"if ((self->release_mask & 1UL) && self->data.Concat.field0) "
			+ "Doc_destroy_release_child(__destroy_stack, __destroy_count, __destroy_capacity, "
			+ "(Doc*)self->data.Concat.field0);"
		)) and artifact.c_code.contains((
			"if ((self->release_mask & 2UL) && self->data.Concat.field1) "
			+ "Doc_destroy_release_child(__destroy_stack, __destroy_count, __destroy_capacity, "
			+ "(Doc*)self->data.Concat.field1);"
		)) and artifact.c_code.contains((
			"if ((self->release_mask & 1UL) && self->data.Text.field0) blorp_release(self-"
			+ ">data.Text.field0);"
		)) and artifact.c_code.contains(
		"blorp_release_arc_only_slow_extern(self);",
	) and not artifact.c_code.contains(
		"blorp_release(self->data.Group.field0);",
	) and not artifact.c_code.contains(
		"blorp_release(self->data.Concat.field0);",
	) and not artifact.c_code.contains("blorp_release(self->data.Concat.field1);")


