pure func paint_list_get_option_expr(colors_expr: CoreExpr) -> CoreExpr:
	self_var: CoreVar = named_var("__std_inline_self")
	index_var: CoreVar = named_var("__std_inline_index")
	elem_var: CoreVar = named_var("__std_inline___elem")
	self_expr: CoreExpr = VarExpr(self_var, list_paint_type(), SyntheticSourceLoc)
	index_expr: CoreExpr = VarExpr(index_var, int_type(), SyntheticSourceLoc)
	elem_expr: CoreExpr = VarExpr(elem_var, paint_type(), SyntheticSourceLoc)
	get_expr: CoreExpr = ListGetExpr(
		{
			layout = PointerListStorage,
			list = self_expr,
			index = index_expr,
			bounds = ProvenListAccess
		},
		raw_pointer_type(),
		SyntheticSourceLoc,
	)
	condition: CoreExpr = LogicalExpr(
		AndOp,
		BinaryExpr(
			GreaterEqualOp,
			index_expr,
			LiteralExpr(IntLiteral(0), int_type(), SyntheticSourceLoc),
			bool_type(),
			SyntheticSourceLoc,
		),
		BinaryExpr(
			LessOp,
			index_expr,
			paint_list_len_expr(self_expr),
			bool_type(),
			SyntheticSourceLoc,
		),
		bool_type(),
		SyntheticSourceLoc,
	)
	then_expr: CoreExpr = LetExpr(
		elem_var,
		False,
		paint_type(),
		UnboxExpr(
			PointerUnbox,
			get_expr,
			paint_type(),
			SyntheticSourceLoc,
		),
		SeqExpr(
			ListRetainExpr(
				{
					list = self_expr,
					value = paint_pointer_value(elem_expr, False)
				},
				VoidType,
				SyntheticSourceLoc,
			),
			paint_option_some_expr(elem_expr),
		),
	)

	LetExpr(
		self_var,
		False,
		list_paint_type(),
		colors_expr,
		LetExpr(
			index_var,
			False,
			int_type(),
			LiteralExpr(IntLiteral(0), int_type(), SyntheticSourceLoc),
			IfExpr(
				condition,
				then_expr,
				paint_option_none_expr(),
				option_paint_type(),
				SyntheticSourceLoc,
			),
		),
	)


