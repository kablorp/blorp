pure func test_emit_unmanaged_tailrec_loop() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(tailrec_sum_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long sum_to(long n, long acc)")
		and artifact.c_code.contains("while (1) {")
		and artifact.c_code.contains("blorp_cooperative_checkpoint();")
		and artifact.c_code.contains("if ((n == 0)) {")
		and artifact.c_code.contains("return acc;")
		and artifact.c_code.contains("long __tailrec_arg_0_0 = (n - 1);")
		and artifact.c_code.contains("long __tailrec_arg_1_1 = (acc + n);")
		and artifact.c_code.contains("n = __tailrec_arg_0_0;")
		and artifact.c_code.contains("acc = __tailrec_arg_1_1;")
		and artifact.c_code.contains("continue;")
	)


pure func test_emit_range_for_loop_with_dynamic_step() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(range_sum_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("long sum_range(void)")
		and artifact.c_code.contains("long __range_start_0 = 5;")
		and artifact.c_code.contains("long __range_end_0 = 0;")
		and artifact.c_code.contains(
			"long __range_step_0 = (__range_start_0 <= __range_end_0) ? 1 : -1;",
		)
		and artifact.c_code.contains(
			"for (long i = __range_start_0; i != __range_end_0; i += __range_step_0) {",
		)
		and artifact.c_code.contains("blorp_cooperative_checkpoint();")
		and artifact.c_code.contains("counter = (counter + i);")
		and artifact.c_code.contains("return counter;")
	)


