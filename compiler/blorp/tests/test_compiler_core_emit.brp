	artifact: CArtifact = emit_core_program_c_artifact(program)
	prototype_index: Option[Int] = artifact.c_code.index_of("long id(long x);")
	main_index: Option[Int] = artifact.c_code.index_of("int main(void)")
	definition_index: Option[Int] = artifact.c_code.index_of("long id(long x) {")

	(
		artifact.c_code.contains("return id(41);")
		and option_int_less_than(prototype_index, main_index)
		and option_int_less_than(main_index, definition_index)
	)


