pure func test_emit_empty_program_artifact_shape() -> Bool:
	artifact: CArtifact = emit_core_program_c_artifact(empty_program())

	(
		artifact.c_code.contains("Blorp final Core C artifact")
		and artifact.c_code.contains("#include <stdint.h>")
		and artifact.link_flags.length() == 0
		and artifact.include_dirs.length() == 0
	)


pure func test_emit_function_inventory_comment() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(main_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	artifact.c_code.contains("function main") and artifact.c_code.contains("def_id=1")


pure func test_emit_main_return_int_literal() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(main_return_zero_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("int main(void)")
		and artifact.c_code.contains("return 0;")
		and not artifact.c_code.contains("function main")
	)


pure func test_emit_main_with_source_args_uses_c_entrypoint_signature() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(main_return_zero_with_args_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("int main(int argc, char** argv)")
		and artifact.c_code.contains("(void)argc;")
		and artifact.c_code.contains("(void)argv;")
		and artifact.c_code.contains("return 0;")
	)


