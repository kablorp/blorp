	point_index: Option[Int] = artifact.c_code.index_of("typedef struct { long x; long y; } Point;")
	point_option_index: Option[Int] = artifact.c_code.index_of(
		"typedef struct { int tag; Point value; } blorp_StackOption_Point;",
	)

	(
		artifact.c_code.contains(
			"typedef struct { int tag; __int128 value; } blorp_StackOption_Int128;",
		)
		and artifact.c_code.contains(
			"typedef struct { int tag; unsigned __int128 value; } blorp_StackOption_UInt128;",
		)
		and artifact.c_code.contains(
			"typedef struct { int tag; long value; } blorp_StackOption_Range;",
		)
		and artifact.c_code.contains(
			"typedef struct { int tag; long value; } blorp_StackOption_Color;",
		)
		and option_int_less_than(point_index, point_option_index)
	)


