		and artifact.c_code.contains("void* handle = open_handle();")
		and artifact.c_code.contains("blorp_CancelCleanupFrame __blorp_cleanup_handle;")
		and artifact.c_code.contains((
				"blorp_task_cleanup_push(&__blorp_cleanup_handle, &handle, (void*)handle, "
				+ "(blorp_CancelCleanupFn)close_handle);"
			))
		and artifact.c_code.contains("long __resource_result_0;")
		and artifact.c_code.contains("__resource_result_0 = 7;")
		and artifact.c_code.contains("blorp_task_cleanup_pop_slot(&handle);")
		and artifact.c_code.contains("close_handle(handle);")
		and artifact.c_code.contains("return __resource_result_0;")
	)


pure func test_emit_resource_cleanup_exit_before_break() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(resource_scope_break_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	match artifact.c_code.index_of("blorp_task_cleanup_pop_slot(&handle);"):
		Some(pop_index):
			match artifact.c_code.index_of("close_handle(handle);"):
				Some(cleanup_index):
					match artifact.c_code.index_of("break;"):
						Some(break_index):
							(
								artifact.c_code.contains("void with_resource_break(void)")
								and cleanup_index > pop_index
								and break_index > cleanup_index
							)
						None:
							False
				None:
					False
		None:
			False


