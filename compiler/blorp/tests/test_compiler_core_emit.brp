pure func test_emit_tuple_construct_and_field_access() -> Bool:
	program: CoreProgram = {
		decls = [
			FunctionDecl(make_pair_function()),
			FunctionDecl(pair_sum_function()),
			FunctionDecl(drop_pair_function()),
		],
	}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("blorp_Tuple* make_pair(long a, long b)")
		and artifact.c_code.contains(
			"return blorp_tuple_new(2, (void*)(long)(a), (void*)(long)(b));",
		)
		and artifact.c_code.contains("long pair_sum(blorp_Tuple* pair)")
		and artifact.c_code.contains("((blorp_Tuple*)pair)->elem[0]")
		and artifact.c_code.contains("((blorp_Tuple*)pair)->elem[1]")
		and artifact.c_code.contains("long drop_pair(blorp_Tuple* pair)")
		and artifact.c_code.contains("blorp_release(pair);")
	)


pure func test_emit_managed_tuple_construct() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(make_managed_pair_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("blorp_Tuple* make_managed_pair(blorp_String* label, long value)")
		and artifact.c_code.contains((
				"blorp_Tuple* __tup_tuple = blorp_tuple_new(2, (void*)label, "
				+ "(void*)(long)(value));"
			))
		and artifact.c_code.contains(
			"if (__tup_tuple->elem[0]) blorp_retain(__tup_tuple->elem[0]);",
		)
		and artifact.c_code.contains("blorp_tuple_set_rc(__tup_tuple, 1UL);")
	)


pure func test_emit_pointer_tuple_field_access() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(pair_label_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
