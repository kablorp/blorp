pure func test_emit_static_closure_create() -> Bool:
	program: CoreProgram = {
		decls = [
			FunctionDecl(static_closure_body_function()),
			FunctionDecl(static_closure_create_function()),
		],
		foreign_includes = []
	}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("void* __def_77__blorp_eta_0(void* __env, void* __arg0)")
		and artifact.c_code.contains("(void)__env;")
		and artifact.c_code.contains("long x = (long)(long)__arg0;")
		and artifact.c_code.contains("return (void*)(long)(x);")
		and artifact.c_code.contains((
				"static blorp_Closure __sc___def_77__blorp_eta_0 = { { BLORP_IMMORTAL_REFCOUNT, "
