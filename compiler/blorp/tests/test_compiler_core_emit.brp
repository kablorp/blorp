pure func test_emit_inline_struct_list_construct() -> Bool:
	program: CoreProgram = {decls = [FunctionDecl(make_options_function())]}
	artifact: CArtifact = emit_core_program_c_artifact(program)

	(
		artifact.c_code.contains("blorp_List* make_options(void)")
		and artifact.c_code.contains(
			"blorp_List* __lst = blorp_list_new_inline(1, sizeof(blorp_StackOption_Int));",
		)
		and artifact.c_code.contains((
				"blorp_StackOption_Int __lst_elem_0 = ((blorp_StackOption_Int){ .tag = 0, .value "
				+ "= 1 });"
			))
		and artifact.c_code.contains("blorp_list_set_raw_copy(__lst, 0, &__lst_elem_0);")
		and artifact.c_code.contains("__lst->len = 1;")
	)


