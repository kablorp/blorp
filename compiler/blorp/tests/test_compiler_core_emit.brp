	global_index: Option[Int] = artifact.c_code.index_of("static long ANSWER = 42L;")
	function_index: Option[Int] = artifact.c_code.index_of("long return_answer(void)")
	global_before_function: Bool = option_int_less_than(global_index, function_index)

	(
		artifact.c_code.contains("static long ANSWER = 42L;")
		and artifact.c_code.contains("long return_answer(void)")
		and artifact.c_code.contains("return ANSWER;")
		and global_before_function
	)


