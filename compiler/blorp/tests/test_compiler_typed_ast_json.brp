import:
	../src/stage_05_types/compiler_env:
		CompilerPurity(CompilerImpure),
		CompilerResourceArgPolicy(CompilerAllowResourceArgs),
		CompilerResourceResultPolicy(CompilerResourceResultDependent),
	../src/stage_06_typecheck/compiler_infer:
		CompilerCallableOrigin(CompilerCallableImported),
		CompilerExprTypeOrigin(CompilerExplicitAnnotationOrigin, CompilerSynthesizedOrigin),
		CompilerResolvedCallInfo,
		CompilerResolvedCallTarget(
			CompilerResolvedClosureCall,
			CompilerResolvedDirectCall,
			CompilerResolvedIntrinsicCall,
			CompilerResolvedTraitMethodCall,
		),
		CompilerTypedConcurrentBinding,
		CompilerTypedConcurrentParam,
		CompilerTypedExpr(
			CompilerTypedCallExpr,
			CompilerTypedConcurrentBlockExpr,
			CompilerTypedIntLiteralExpr,
			CompilerTypedMatchExpr,
			CompilerTypedNameExpr,
		),
		CompilerTypedExprInfo,
		CompilerTypedMatchCase,
		CompilerTypedPattern(CompilerTypedIntPattern),
	../src/stage_03_parse/compiler_parsed_ast:
		ParsedBinaryOp(ParsedAddOp, ParsedMultiplyOp),
		ParsedDecl(
			ImplParsedDecl,
			ImportBlockParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
		),
		ParsedExpr(ParsedIntLiteralExpr),
		ParsedFieldDecl,
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedImplDecl,
		ParsedImportDecl,
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder),
		ParsedRecordDecl,
		ParsedTraitDecl,
		ParsedTypeAliasDecl,
		ParsedTypeExpr(ParsedNamedType),
		ParsedVarDecl,
		parsed_identifier,
	../src/stage_03_parse/compiler_parsed_ast_json:
		parsed_decl_to_json,
		parsed_identifier_to_json,
		parsed_source_file_to_json,
		parsed_source_span_to_json,
	../src/stage_05_types/compiler_refinement:
		CompilerCollectionIdentity,
		CompilerProofSource(CompilerProofSourceCondition, CompilerProofSourceLoopRange),
		CompilerProvenCollection(CompilerCollSubscript, CompilerCollVar),
		CompilerRangeUpper(CompilerRangeUpperLengthMinus),
		CompilerValueProofs,
		compiler_unrefined_binding,
	../src/stage_01_file_io/compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_05_types/compiler_type:
		CompilerType(CompilerConstIntType, CompilerVarDimsType),
		compiler_type_int,
		compiler_type_string,
	../src/stage_05_types/compiler_type_json: compiler_type_to_json
	../src/stage_05_types/compiler_type_widening:
		CompilerCollectionKind(CompilerListLiteral),
		CompilerTypeWideningDecision(CompilerTypeKeep, CompilerTypeWiden),
		CompilerTypeWideningReason(
			CompilerArgumentSlot,
			CompilerCollectionElement,
			CompilerNumericOperator,
		),
		CompilerValueSlot,
	../src/stage_06_typecheck/compiler_typecheck_decl:
		CompilerTypedDecl(
			CompilerTypedFunctionDecl,
			CompilerTypedGlobalVarDecl,
			CompilerTypedImplDecl,
			CompilerTypedParsedDecl,
			CompilerTypedPrivateDecl,
			CompilerTypedRecordDecl,
			CompilerTypedTypeAliasDecl,
		),
		CompilerTypedFunctionInfo,
		CompilerTypedGlobalVarInfo,
		CompilerTypedImplInfo,
		CompilerTypedProgram,
		CompilerTypedRecordFieldInfo,
		CompilerTypedRecordInfo,
		CompilerTypedTypeAliasInfo,
	../src/stage_06_typecheck/compiler_typed_ast_json:
		compiler_expr_type_origin_to_json,
		compiler_resolved_call_to_json,
		compiler_typed_decl_to_json,
		compiler_typed_expr_info_to_json,
		compiler_typed_expr_to_json,
		compiler_typed_function_info_to_json,
		compiler_typed_global_var_info_to_json,
		compiler_typed_impl_info_to_json,
		compiler_typed_program_to_json,
		compiler_typed_record_info_to_json,
		compiler_typed_type_alias_info_to_json,
		compiler_value_proofs_to_json,
		compiler_value_slot_to_json,
		compiler_widening_decision_to_json,
		compiler_widening_reason_to_json,
	json: JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector)
	test: TestSuite


pure func json_values_equal(left: JsonValue, right: JsonValue) -> Bool:
	left.to_string() == right.to_string()


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("typed_ast_json.brp", "typed_ast_json", "func main(): 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func sample_resolved_call() -> CompilerResolvedCallInfo:
	{
			callee_name = "read_chunk_at",
			source_name = "read_chunk_at",
			purity = CompilerImpure,
			target = CompilerResolvedDirectCall(42, CompilerCallableImported("std/file")),
			instantiated_params = [compiler_type_string(), compiler_type_int()],
			instantiated_return = compiler_type_string(),
			resource_args = CompilerAllowResourceArgs(CompilerResourceResultDependent),
		dim_constraints = [(CompilerVarDimsType("#N"), CompilerConstIntType(4096))]
	}


pure func sample_value_slot() -> CompilerValueSlot:
	{
		semantic_type = CompilerConstIntType(1),
		decision = CompilerTypeWiden(
			CompilerConstIntType(1),
			compiler_type_int(),
			CompilerArgumentSlot,
		)
	}


pure func sample_expr_info() -> CompilerTypedExprInfo:
	{
		source_type = None,
		semantic_type = compiler_type_int(),
		value_type = compiler_type_int(),
		origin = CompilerSynthesizedOrigin("test"),
		value_slot = {
			semantic_type = compiler_type_int(),
			decision = CompilerTypeKeep(compiler_type_int())
		},
		proofs = compiler_unrefined_binding(),
		resolved_call = None,
		resource_dependencies = []
	}


pure func sample_expr_info_with_call() -> CompilerTypedExprInfo:
	{ sample_expr_info() | resolved_call = Some(sample_resolved_call()) }


pure func parsed_int_expr(text: String) -> ParsedExpr:
	ParsedIntLiteralExpr(text, source_span())


pure func parsed_type_int() -> ParsedTypeExpr:
	ParsedNamedType(ident("Int"), [], source_span())


pure func parsed_param(name: String) -> ParsedParam:
	{
		binder = ParsedParamNameBinder(ident(name)),
		type_expr = Some(parsed_type_int()),
		span = source_span()
	}


pure func parsed_function_decl() -> ParsedFunctionDecl:
	{
		name = ident("answer"),
		type_params = [],
		params = [parsed_param("x")],
		return_type = Some(parsed_type_int()),
		dim_constraints = [],
		body = Some(parsed_int_expr("1")),
		is_pure = True,
		annotations = [],
		doc = None,
		span = source_span()
	}


pure func parsed_var_decl() -> ParsedVarDecl:
	{
		name = ident("answer"),
		type_expr = None,
		value = parsed_int_expr("42"),
		is_mutable = False,
		span = source_span()
	}


pure func parsed_field(name: String) -> ParsedFieldDecl:
	{
		name = ident(name),
		type_expr = parsed_type_int(),
		span = source_span()
	}


pure func parsed_record_decl() -> ParsedRecordDecl:
	{
		name = ident("Box"),
		type_params = [],
		fields = [parsed_field("value")],
		is_struct = False,
		doc = None,
		span = source_span()
	}


pure func parsed_type_alias_decl() -> ParsedTypeAliasDecl:
	{
		name = ident("Name"),
		type_params = [],
		target = parsed_type_int(),
		is_opaque = False,
		doc = None,
		span = source_span()
	}


pure func parsed_impl_decl() -> ParsedImplDecl:
	{
		trait_name = ident("Show"),
		for_type = parsed_type_int(),
		methods = [parsed_function_decl()],
		doc = None,
		span = source_span()
	}


pure func parsed_trait_decl() -> ParsedTraitDecl:
	{
		name = ident("Show"),
		type_params = [],
		supertraits = [],
		methods = [],
		doc = None,
		span = source_span()
	}


pure func parsed_import_decl(module_path: String) -> ParsedImportDecl:
	{
		module_path = module_path,
		module_alias = None,
		symbols = None,
		span = source_span()
	}


pure func typed_function_info() -> CompilerTypedFunctionInfo:
	{
		decl = parsed_function_decl(),
		callable_id = Some(77),
		param_types = [compiler_type_int()],
		source_return_type = Some(compiler_type_int()),
		semantic_return_type = compiler_type_int(),
		body = Some(CompilerTypedIntLiteralExpr("1", source_span(), sample_expr_info()))
	}


pure func typed_global_var_info() -> CompilerTypedGlobalVarInfo:
	{
		decl = parsed_var_decl(),
		binding_type = compiler_type_int(),
		source_type = None,
		value = CompilerTypedIntLiteralExpr("42", source_span(), sample_expr_info())
	}


pure func typed_record_field_info() -> CompilerTypedRecordFieldInfo:
	{
		name = "value",
		source_type = compiler_type_int(),
		semantic_type = compiler_type_string()
	}


pure func typed_record_info() -> CompilerTypedRecordInfo:
	{
		decl = parsed_record_decl(),
		fields = [typed_record_field_info()]
	}


pure func typed_type_alias_info() -> CompilerTypedTypeAliasInfo:
	{
		decl = parsed_type_alias_decl(),
		source_target_type = compiler_type_int(),
		semantic_target_type = compiler_type_string()
	}


pure func typed_impl_info() -> CompilerTypedImplInfo:
	{
		decl = parsed_impl_decl(),
		for_type = compiler_type_int(),
		methods = [typed_function_info()]
	}


func test_widening_reason_json_preserves_payloads() -> Bool:
	numeric = compiler_widening_reason_to_json(CompilerNumericOperator(ParsedMultiplyOp))
	collection = compiler_widening_reason_to_json(CompilerCollectionElement(CompilerListLiteral))

	json_values_equal(numeric, JsonObject([
			("kind", JsonString("numeric_operator")),
			("op", JsonString("multiply")),
		])) and json_values_equal(collection, JsonObject([
			("kind", JsonString("collection_element")),
			("collection", JsonString("list")),
		]))


func test_widening_decision_json_preserves_source_target_and_reason() -> Bool:
	decision = CompilerTypeWiden(
		CompilerConstIntType(1),
		compiler_type_int(),
		CompilerNumericOperator(ParsedAddOp),
	)
	expected = JsonObject([
		("kind", JsonString("widen")),
		("from_type", compiler_type_to_json(CompilerConstIntType(1))),
		("to_type", compiler_type_to_json(compiler_type_int())),
		("reason", compiler_widening_reason_to_json(CompilerNumericOperator(ParsedAddOp))),
	])

	json_values_equal(compiler_widening_decision_to_json(decision), expected)


func test_resolved_call_json_preserves_origin_policy_and_dim_constraints() -> Bool:
	expected = JsonObject([
		("callee_name", JsonString("read_chunk_at")),
		("source_name", JsonString("read_chunk_at")),
		("purity", JsonString("impure")),
		("target", JsonObject([
			("kind", JsonString("direct")),
			("callable_id", JsonNumber(42.0)),
			("origin", JsonObject([
				("kind", JsonString("imported")),
				("module", JsonString("std/file")),
			])),
		])),
		("instantiated_params", JsonVector([
				compiler_type_to_json(compiler_type_string()),
				compiler_type_to_json(compiler_type_int()),
			])),
		("instantiated_return", compiler_type_to_json(compiler_type_string())),
		("resource_args", JsonObject([
				("kind", JsonString("allow")),
				("result_policy", JsonString("dependent")),
			])),
		("dim_constraints", JsonVector([JsonObject([
					("left", compiler_type_to_json(CompilerVarDimsType("#N"))),
					("right", compiler_type_to_json(CompilerConstIntType(4096))),
				])])),
	])

	json_values_equal(compiler_resolved_call_to_json(sample_resolved_call()), expected)


func test_resolved_call_json_encodes_closure_target() -> Bool:
	info: CompilerResolvedCallInfo = {
		callee_name = "<closure>",
		source_name = "<closure>",
		purity = CompilerPure,
		target = CompilerResolvedClosureCall,
		instantiated_params = [compiler_type_int()],
		instantiated_return = compiler_type_int(),
		resource_args = CompilerRejectResourceArgs,
		dim_constraints = []
	}
	expected = JsonObject([
		("callee_name", JsonString("<closure>")),
		("source_name", JsonString("<closure>")),
		("purity", JsonString("pure")),
		("target", JsonObject([("kind", JsonString("closure"))])),
		("instantiated_params", JsonVector([compiler_type_to_json(compiler_type_int())])),
		("instantiated_return", compiler_type_to_json(compiler_type_int())),
		("resource_args", JsonObject([("kind", JsonString("reject"))])),
		("dim_constraints", JsonVector([])),
	])

	json_values_equal(compiler_resolved_call_to_json(info), expected)


func test_resolved_call_json_encodes_intrinsic_target() -> Bool:
	info: CompilerResolvedCallInfo = {
		callee_name = "__checked_get",
		source_name = "__checked_get",
		purity = CompilerPure,
		target = CompilerResolvedIntrinsicCall,
		instantiated_params = [compiler_type_string(), compiler_type_int()],
		instantiated_return = compiler_type_string(),
		resource_args = CompilerRejectResourceArgs,
		dim_constraints = []
	}
	expected = JsonObject([
		("callee_name", JsonString("__checked_get")),
		("source_name", JsonString("__checked_get")),
		("purity", JsonString("pure")),
		("target", JsonObject([("kind", JsonString("intrinsic"))])),
		("instantiated_params", JsonVector([
				compiler_type_to_json(compiler_type_string()),
				compiler_type_to_json(compiler_type_int()),
			])),
		("instantiated_return", compiler_type_to_json(compiler_type_string())),
		("resource_args", JsonObject([("kind", JsonString("reject"))])),
		("dim_constraints", JsonVector([])),
	])

	json_values_equal(compiler_resolved_call_to_json(info), expected)


func test_value_proofs_json_preserves_range_and_subscript() -> Bool:
	collection: CompilerCollectionIdentity = {name = "items"}
	child: CompilerCollectionIdentity = {name = "items_row"}
	proofs: CompilerValueProofs = {
		range = Some({
			range_start = 0,
			range_upper = CompilerRangeUpperLengthMinus(collection, 1),
			range_source = CompilerProofSourceLoopRange,
		}),
		subscript = Some({
			subscript_collection = CompilerCollSubscript(CompilerCollVar(collection), child),
			subscript_source = CompilerProofSourceCondition,
		})
	}
	expected = JsonObject([("range", JsonObject([("start", JsonNumber(0.0)), ("upper", JsonObject([
						("kind", JsonString("length_minus")),
						("identity", JsonObject([("name", JsonString("items"))])),
						("offset", JsonNumber(1.0)),
					])), (
					"source",
					JsonString(
						"loop_range",
					),
			)])), ("subscript", JsonObject([
			("collection", JsonObject([("kind", JsonString("subscript")), ("parent", JsonObject([
								("kind", JsonString("var")),
								("identity", JsonObject([("name", JsonString("items"))])),
				])), ("identity", JsonObject([("name", JsonString("items_row"))]))])),
				("source", JsonString("condition")),
		]))])

	json_values_equal(compiler_value_proofs_to_json(proofs), expected)


func test_typed_expr_info_json_contains_all_metadata() -> Bool:
	info: CompilerTypedExprInfo = {
		source_type = Some(compiler_type_int()),
		semantic_type = CompilerConstIntType(1),
		value_type = compiler_type_int(),
		origin = CompilerExplicitAnnotationOrigin(compiler_type_int()),
		value_slot = sample_value_slot(),
		proofs = compiler_unrefined_binding(),
		resolved_call = Some(sample_resolved_call()),
		resource_dependencies = ["reader"]
	}
	expected = JsonObject([
		("source_type", compiler_type_to_json(compiler_type_int())),
		("semantic_type", compiler_type_to_json(CompilerConstIntType(1))),
		("value_type", compiler_type_to_json(compiler_type_int())),
		(
			"origin",
			compiler_expr_type_origin_to_json(
				CompilerExplicitAnnotationOrigin(compiler_type_int()),
			),
		),
		("value_slot", compiler_value_slot_to_json(sample_value_slot())),
		("proofs", compiler_value_proofs_to_json(compiler_unrefined_binding())),
		("resolved_call", compiler_resolved_call_to_json(sample_resolved_call())),
		("resource_dependencies", JsonVector([JsonString("reader")])),
	])

	json_values_equal(compiler_typed_expr_info_to_json(info), expected)


func test_origin_json_handles_synthesized_and_optional_fields() -> Bool:
	info: CompilerTypedExprInfo = {
		source_type = None,
		semantic_type = compiler_type_string(),
		value_type = compiler_type_string(),
		origin = CompilerSynthesizedOrigin("empty block"),
		value_slot = {
			semantic_type = compiler_type_string(),
			decision = CompilerTypeKeep(compiler_type_string())
		},
		proofs = compiler_unrefined_binding(),
		resolved_call = None,
		resource_dependencies = []
	}
	encoded = compiler_typed_expr_info_to_json(info)
	expected = JsonObject([
		("source_type", JsonNull),
		("semantic_type", compiler_type_to_json(compiler_type_string())),
		("value_type", compiler_type_to_json(compiler_type_string())),
		("origin", JsonObject([
				("kind", JsonString("synthesized")),
				("label", JsonString("empty block")),
			])),
		("value_slot", compiler_value_slot_to_json(info.value_slot)),
		("proofs", compiler_value_proofs_to_json(compiler_unrefined_binding())),
		("resolved_call", JsonNull),
		("resource_dependencies", JsonVector([])),
	])

	json_values_equal(encoded, expected)


func test_typed_expr_json_encodes_call_tree() -> Bool:
	span = source_span()
	callee = CompilerTypedNameExpr(ident("read_chunk_at"), sample_expr_info_with_call())
	arg = CompilerTypedIntLiteralExpr("1", span, sample_expr_info())
	call_info = sample_expr_info_with_call()
	expr = CompilerTypedCallExpr(callee, [arg], span, call_info)
	expected = JsonObject([
		("kind", JsonString("call")),
		("span", parsed_source_span_to_json(span)),
		("info", compiler_typed_expr_info_to_json(call_info)),
		("callee", compiler_typed_expr_to_json(callee)),
		("args", JsonVector([compiler_typed_expr_to_json(arg)])),
	])

	json_values_equal(compiler_typed_expr_to_json(expr), expected)


func test_typed_expr_json_encodes_match_patterns() -> Bool:
	span = source_span()
	scrutinee = CompilerTypedNameExpr(ident("value"), sample_expr_info())
	body = CompilerTypedBlockExpr(
		[CompilerTypedIntLiteralExpr("7", span, sample_expr_info())],
		span,
		sample_expr_info(),
	)
	case: CompilerTypedMatchCase = {
		pattern = CompilerTypedIntPattern("7", span),
		body = body,
		span = span
	}
	expr = CompilerTypedMatchExpr(scrutinee, [case], span, sample_expr_info())
	expected = JsonObject([
		("kind", JsonString("match")),
		("span", parsed_source_span_to_json(span)),
		("info", compiler_typed_expr_info_to_json(sample_expr_info())),
		("scrutinee", compiler_typed_expr_to_json(scrutinee)),
		("cases", JsonVector([JsonObject([("pattern", JsonObject([
							("kind", JsonString("int")),
							("value", JsonString("7")),
							("span", parsed_source_span_to_json(span)),
						])), (
						"body",
						compiler_typed_expr_to_json(
							body,
						),
					), ("span", parsed_source_span_to_json(span))])])),
	])

	json_values_equal(compiler_typed_expr_to_json(expr), expected)


func test_typed_expr_json_encodes_concurrent_block_bindings() -> Bool:
	span = source_span()
	value = CompilerTypedIntLiteralExpr("1", span, sample_expr_info())
	binding: CompilerTypedConcurrentBinding = {
		name = ident("answer"),
		annotation = None,
		value = value,
		span = span,
		info = sample_expr_info(),
	}
	param: CompilerTypedConcurrentParam = {
		name = ident("max_threads"),
		value = CompilerTypedIntLiteralExpr("2", span, sample_expr_info()),
		span = span
	}
	expr = CompilerTypedConcurrentBlockExpr([param], [binding], span, sample_expr_info())
	expected = JsonObject([
		("kind", JsonString("concurrent_block")),
		("span", parsed_source_span_to_json(span)),
		("info", compiler_typed_expr_info_to_json(sample_expr_info())),
		("params", JsonVector([JsonObject([
					("name", parsed_identifier_to_json(ident("max_threads"))),
					("value", compiler_typed_expr_to_json(param.value)),
					("span", parsed_source_span_to_json(span)),
				])])),
		("bindings", JsonVector([JsonObject([
					("kind", JsonString("concurrent_bind")),
					("span", parsed_source_span_to_json(span)),
					("info", compiler_typed_expr_info_to_json(binding.info)),
					("name", parsed_identifier_to_json(ident("answer"))),
					("annotation", JsonNull),
					("value", compiler_typed_expr_to_json(value)),
				])])),
	])

	json_values_equal(compiler_typed_expr_to_json(expr), expected)


pure func parsed_type_int_json() -> JsonValue:
	JsonObject([("kind", JsonString("named")), ("name", JsonObject([
				("text", JsonString("Int")),
				("span", parsed_source_span_to_json(source_span())),
			])), ("args", JsonVector([])), ("span", parsed_source_span_to_json(source_span()))])


pure func parsed_param_json() -> JsonValue:
	JsonObject([("binder", JsonObject([("kind", JsonString("name")), ("name", JsonObject([
						("text", JsonString("x")),
						("span", parsed_source_span_to_json(source_span())),
					]))])), (
			"type",
			parsed_type_int_json(),
		), ("span", parsed_source_span_to_json(source_span()))])


func test_typed_function_info_json_preserves_callable_id_and_params() -> Bool:
	info = typed_function_info()
	expected = JsonObject([("decl", JsonObject([("name", JsonObject([
						("text", JsonString("answer")),
						("span", parsed_source_span_to_json(source_span())),
					])), (
					"type_params",
					JsonVector(
						[

						],
					),
				), (
					"params",
					JsonVector(
						[
							parsed_param_json(),
						],
					),
				), (
					"return_type",
					parsed_type_int_json(),
				), ("dim_constraints", JsonVector([])), ("body", JsonObject([
						("kind", JsonString("int_literal")),
						("value", JsonString("1")),
						("span", parsed_source_span_to_json(source_span())),
					])), (
					"is_pure",
					JsonBool(
						True,
					),
				), (
					"annotations",
					JsonVector(
						[

						],
					),
				), (
					"doc",
					JsonNull,
				), (
					"span",
					parsed_source_span_to_json(
						source_span(),
					),
				)])), (
			"callable_id",
			JsonNumber(
				77.0,
			),
		), (
			"param_types",
			JsonVector(
				[
					compiler_type_to_json(
						compiler_type_int(),
					),
				],
			),
		), (
			"source_return_type",
			compiler_type_to_json(
				compiler_type_int(),
			),
		), (
			"semantic_return_type",
			compiler_type_to_json(
				compiler_type_int(),
			),
		), (
			"body",
			compiler_typed_expr_to_json(
				CompilerTypedIntLiteralExpr(
					"1",
					source_span(),
					sample_expr_info(),
				),
			),
		)])

	json_values_equal(compiler_typed_function_info_to_json(info), expected)


func test_typed_program_json_encodes_source_decls_and_diagnostics() -> Bool:
	global_info = typed_global_var_info()
	function_info = typed_function_info()
	program: CompilerTypedProgram = {
		source = source_file(),
		decls = [CompilerTypedFunctionDecl(function_info), CompilerTypedGlobalVarDecl(global_info)],
		diagnostics = []
	}
	expected = JsonObject([
		("kind", JsonString("typed_program")),
		("source", parsed_source_file_to_json(source_file())),
		("decls", JsonVector([JsonObject([
					("kind", JsonString("function")),
					("info", compiler_typed_function_info_to_json(function_info)),
				]), JsonObject([
					("kind", JsonString("global_var")),
					("info", compiler_typed_global_var_info_to_json(global_info)),
				])])),
		("diagnostics", JsonVector([])),
	])

	json_values_equal(compiler_typed_program_to_json(program), expected)


func test_typed_decl_json_encodes_declaration_variants() -> Bool:
	record_info = typed_record_info()
	alias_info = typed_type_alias_info()
	impl_info = typed_impl_info()
	parsed_trait = TraitParsedDecl(parsed_trait_decl())
	parsed_imports = ImportBlockParsedDecl([parsed_import_decl("option")], source_span())

	record_ok = json_values_equal(
		compiler_typed_decl_to_json(CompilerTypedRecordDecl(record_info)),
		JsonObject([
			("kind", JsonString("record")),
			("info", compiler_typed_record_info_to_json(record_info)),
		]),
	)
	alias_ok = json_values_equal(
		compiler_typed_decl_to_json(CompilerTypedTypeAliasDecl(alias_info)),
		JsonObject([
			("kind", JsonString("type_alias")),
			("info", compiler_typed_type_alias_info_to_json(alias_info)),
		]),
	)
	impl_ok = json_values_equal(
		compiler_typed_decl_to_json(CompilerTypedImplDecl(impl_info)),
		JsonObject([
			("kind", JsonString("impl")),
			("info", compiler_typed_impl_info_to_json(impl_info)),
		]),
	)
	private_ok = json_values_equal(
		compiler_typed_decl_to_json(
			CompilerTypedPrivateDecl(CompilerTypedTypeAliasDecl(alias_info)),
		),
		JsonObject([
			("kind", JsonString("private")),
			("inner", compiler_typed_decl_to_json(CompilerTypedTypeAliasDecl(alias_info))),
		]),
	)
	parsed_trait_ok = json_values_equal(
		compiler_typed_decl_to_json(CompilerTypedParsedDecl(parsed_trait)),
		JsonObject([
			("kind", JsonString("parsed")),
			("decl", parsed_decl_to_json(parsed_trait)),
		]),
	)
	parsed_import_ok = json_values_equal(
		compiler_typed_decl_to_json(CompilerTypedParsedDecl(parsed_imports)),
		JsonObject([
			("kind", JsonString("parsed")),
			("decl", parsed_decl_to_json(parsed_imports)),
		]),
	)

	record_ok and alias_ok and impl_ok and private_ok and parsed_trait_ok and parsed_import_ok


tests: TestSuite = {
	description = "Compiler typed AST JSON",
	tests = [
		("widening reason JSON preserves payloads", test_widening_reason_json_preserves_payloads),
		(
			"widening decision JSON preserves source target and reason",
			test_widening_decision_json_preserves_source_target_and_reason,
		),
		(
			"resolved call JSON preserves origin policy and dim constraints",
			test_resolved_call_json_preserves_origin_policy_and_dim_constraints,
		),
			(
				"resolved call JSON encodes closure target",
				test_resolved_call_json_encodes_closure_target,
			),
			(
				"resolved call JSON encodes intrinsic target",
				test_resolved_call_json_encodes_intrinsic_target,
			),
			(
				"value proofs JSON preserves range and subscript",
				test_value_proofs_json_preserves_range_and_subscript,
		),
		(
			"typed expr info JSON contains all metadata",
			test_typed_expr_info_json_contains_all_metadata,
		),
		(
			"origin JSON handles synthesized and optional fields",
			test_origin_json_handles_synthesized_and_optional_fields,
		),
		("typed expr JSON encodes call tree", test_typed_expr_json_encodes_call_tree),
		("typed expr JSON encodes match patterns", test_typed_expr_json_encodes_match_patterns),
		(
			"typed expr JSON encodes concurrent block bindings",
			test_typed_expr_json_encodes_concurrent_block_bindings,
		),
		(
			"typed function info JSON preserves callable id and params",
			test_typed_function_info_json_preserves_callable_id_and_params,
		),
		(
			"typed program JSON encodes source decls and diagnostics",
			test_typed_program_json_encodes_source_decls_and_diagnostics,
		),
		(
			"typed decl JSON encodes declaration variants",
			test_typed_decl_json_encodes_declaration_variants,
		),
	]
}
