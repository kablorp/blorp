import:
	../src/stage_09_core/compiler_core_json:
		CoreCallKind(IntrinsicCall),
		CoreExpr(CallExpr, VarExpr),
		CoreFunction,
		CoreFunctionKind(BuiltinFunction, UnresolvedBuiltinFunction),
		CoreParam,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType),
		CoreVar,
	../src/stage_09_core/compiler_core_synth_float: synthesize_float_body
	test: TestSuite


private INT_TYPE: CoreType = NamedType("Int", [])

private FLOAT_TYPE: CoreType = NamedType("Float", [])

private BOOL_TYPE: CoreType = NamedType("Bool", [])


pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func param(name: String, typ: CoreType) -> CoreParam:
	{
		name = core_var(name),
		typ = typ,
		loc = SyntheticSourceLoc
	}


pure func builtin_function(
	module_name: String,
	source_name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> CoreFunction:
	{
		name = module_name.replace("/", "_") + "__" + source_name,
		source_module = Some(module_name),
		type_params = [],
		params = params,
		return_type = return_type,
		body = None,
		is_pure = True,
		function_kind = UnresolvedBuiltinFunction,
		def_id = 1,
		loc = SyntheticSourceLoc
	}


pure func intrinsic_body_matches(
	function_info: CoreFunction,
	intrinsic_name: String,
	arity: Int,
) -> Bool:
	match synthesize_float_body(function_info):
		Some(CallExpr(IntrinsicCall(name), _, args, _, _)):
			name == intrinsic_name and args.length() == arity and args.all(func(arg):
				match arg:
					VarExpr(_, _, _):
						True
					_:
						False
			)
		_:
			False


pure func test_unary_float_intrinsic() -> Bool:
	intrinsic_body_matches(
		builtin_function("std/float", "sin", [param("x", FLOAT_TYPE)], FLOAT_TYPE),
		"math_sin",
		1,
	)


pure func test_binary_float_intrinsic() -> Bool:
	intrinsic_body_matches(
		builtin_function(
			"std/float",
			"pow",
			[param("base", FLOAT_TYPE), param("exponent", FLOAT_TYPE)],
			FLOAT_TYPE,
		),
		"math_pow",
		2,
	)


pure func test_fused_multiply_add_intrinsic() -> Bool:
	intrinsic_body_matches(
		builtin_function(
			"std/float",
			"fma",
			[param("x", FLOAT_TYPE), param("y", FLOAT_TYPE), param("z", FLOAT_TYPE)],
			FLOAT_TYPE,
		),
		"math_fma",
		3,
	)


pure func test_float_classification_intrinsic() -> Bool:
	intrinsic_body_matches(
		builtin_function("std/float", "is_nan", [param("x", FLOAT_TYPE)], BOOL_TYPE),
		"math_is_nan",
		1,
	)


pure func test_float_synthesis_requires_module_and_signature() -> Bool:
	wrong_module = builtin_function("app/float", "sin", [param("x", FLOAT_TYPE)], FLOAT_TYPE)
	wrong_param = builtin_function("std/float", "sin", [param("x", INT_TYPE)], FLOAT_TYPE)
	unresolved = builtin_function("std/float", "sin", [param("x", FLOAT_TYPE)], FLOAT_TYPE)
	resolved = { unresolved | function_kind = BuiltinFunction("math_sin") }

	(
		synthesize_float_body(wrong_module) == None
		and synthesize_float_body(wrong_param) == None
		and synthesize_float_body(resolved) == None
	)


tests: TestSuite = {
	description = "Compiler Core Float synthesis",
	tests = [
		("unary Float intrinsic", test_unary_float_intrinsic),
		("binary Float intrinsic", test_binary_float_intrinsic),
		("fused multiply-add intrinsic", test_fused_multiply_add_intrinsic),
		("Float classification intrinsic", test_float_classification_intrinsic),
		(
			"Float synthesis requires module and signature",
			test_float_synthesis_requires_module_and_signature,
		),
	]
}
