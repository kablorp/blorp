import:
	../src/stage_01_file_io/source: CompilerSourceFile, compiler_source_file
	../src/stage_04_modules/loaded_module:
		CompilerModuleOrigin(
			CompilerNativePackageModule,
			CompilerSourcePackageModule,
			CompilerStdlibModule,
			CompilerUserModule,
		),
	../src/stage_04_modules/source_package_layout: CompilerSourcePackageLayout
	../src/stage_12_lsp/lsp_analysis_cache: lsp_analysis_cache
	../src/stage_12_lsp/lsp_analysis_model:
		LspArtifactLocalSymbolId,
		LspSemanticIndexState(LspSemanticIndexUnavailable),
		LspSemanticSymbolId(LspArtifactLocalSemanticSymbol),
	../src/stage_12_lsp/lsp_architecture:
		LspCompilerWorkspaceSnapshot,
		LspWorkspaceError(LspWorkspaceSourceIdentityConflict, LspWorkspaceSourceUnavailable),
		LspWorkspaceSnapshot,
	../src/stage_12_lsp/lsp_document_model:
		LspDocumentVersion,
		lsp_document_version,
		lsp_document_version_value,
	../src/stage_12_lsp/lsp_fingerprint_model: LspSemanticArtifactId
	../src/stage_12_lsp/lsp_identity: LspDocumentUri, lsp_document_uri
	../src/stage_12_lsp/lsp_snapshot_model:
		LspConfigurationEpoch,
		LspWorkspaceRevision,
		lsp_configuration_epoch,
		lsp_workspace_revision,
	../src/stage_12_lsp/lsp_workspace_model:
		LspDiscoveredSourceProvenance(
			LspDiskSource,
			LspNativePackageSource,
			LspSourcePackageSource,
			LspStandardLibrarySource,
		),
		LspSelectedSourceProvenance(LspSelectedDiscoveredSource, LspSelectedOpenDocument),
		LspSourceLayers,
		LspSourceSnapshot,
		LspWorkspaceConfiguration,
		lsp_source_snapshot_content_fingerprint,
		lsp_source_snapshot_origin,
		lsp_source_snapshot_provenance,
		lsp_source_snapshot_source,
	../src/stage_12_lsp/lsp_workspace_source:
		lsp_discovered_source_layer,
		lsp_open_document_source_layer,
		lsp_source_for_uri,
		lsp_source_layers,
	../src/stage_12_lsp/lsp_workspace_store:
		LspSourceStore,
		lsp_dependency_store,
		lsp_source_store_from_values,
	test: TestSuite


private MAIN_URI_TEXT: String = "file:///workspace/main.brp"

private OTHER_URI_TEXT: String = "file:///workspace/other.brp"

private TEST_WORKSPACE_REVISION: Int = 7

private TEST_CONFIGURATION_EPOCH: Int = 3


private pure func source_package() -> CompilerSourcePackageLayout:
	{
		package_alias = "math",
		package_name = "math_core",
		source_dir = "/packages/math/src",
		exports = ["math_core/stats"]
	}


private pure func main_uri() -> LspDocumentUri:
	lsp_document_uri(MAIN_URI_TEXT)


private pure func other_uri() -> LspDocumentUri:
	lsp_document_uri(OTHER_URI_TEXT)


private pure func source(path: String, module_name: String, text: String) -> CompilerSourceFile:
	compiler_source_file(path, module_name, text)


private pure func version(value: Int) -> Option[LspDocumentVersion]:
	lsp_document_version(value)


private pure func workspace_configuration() -> LspWorkspaceConfiguration:
	{
		workspace_roots = [],
		stdlib_path = "std",
		source_package_roots = [],
		native_package_roots = []
	}


private pure func workspace_snapshot_with_store(
	source_store: LspSourceStore,
) -> Option[LspWorkspaceSnapshot]:
	revision ?= lsp_workspace_revision(TEST_WORKSPACE_REVISION)
	epoch ?= lsp_configuration_epoch(TEST_CONFIGURATION_EPOCH)
	compiler: LspCompilerWorkspaceSnapshot = {
		revision = revision,
		configuration_epoch = epoch,
		configuration = workspace_configuration(),
		sources = source_store,
		dependencies = lsp_dependency_store(),
		analysis_cache = lsp_analysis_cache()
	}

	Some({
		compiler = compiler,
		semantic_index = LspSemanticIndexUnavailable(revision),
	})


private pure func workspace_snapshot(
	sources: List[LspSourceLayers],
) -> Option[LspWorkspaceSnapshot]:
	match lsp_source_store_from_values(sources):
		Ok(source_store):
			workspace_snapshot_with_store(source_store)
		Err(_):
			None


private pure func selected_open_version_is(snapshot: LspSourceSnapshot, expected: Int) -> Bool:
	match lsp_source_snapshot_provenance(snapshot):
		LspSelectedOpenDocument(document_version):
			lsp_document_version_value(document_version) == expected
		_:
			False


pure func test_open_overlay_wins_and_inherits_discovered_origin() -> Bool:
	match version(11):
		None:
			False
		Some(document_version):
			disk = lsp_discovered_source_layer(
				source("/workspace/main.brp", "main", "VALUE = 1\n"),
				LspStandardLibrarySource,
			)
			overlay = lsp_open_document_source_layer(
				source("/workspace/main.brp", "main", "VALUE = 2\n"),
				document_version,
			)
			layers = lsp_source_layers(main_uri(), Some(disk), Some(overlay))

			match workspace_snapshot([layers]):
				None:
					False
				Some(workspace):
					match lsp_source_for_uri(workspace, main_uri()):
						Ok(selected):
							selected_source = lsp_source_snapshot_source(selected)

							(
								selected_source.text == "VALUE = 2\n"
								and selected_open_version_is(selected, 11)
								and lsp_source_snapshot_origin(selected) == CompilerStdlibModule
								and lsp_source_snapshot_content_fingerprint(
									selected,
								).value == "VALUE = 2\n"
							)
						Err(_):
							False


pure func test_discovered_package_origins_are_preserved() -> Bool:
	package = lsp_source_layers(
		main_uri(),
		Some(
			lsp_discovered_source_layer(
				source("/packages/math/stats.brp", "stats", "VALUE = 1\n"),
				LspSourcePackageSource(source_package()),
			),
		),
		None,
	)
	native = lsp_source_layers(
		other_uri(),
		Some(
			lsp_discovered_source_layer(
				source("/pkg/native.brp", "native", "VALUE = 2\n"),
				LspNativePackageSource("native-id"),
			),
		),
		None,
	)

	match workspace_snapshot([package, native]):
		None:
			False
		Some(workspace):
			match lsp_source_for_uri(workspace, main_uri()):
				Err(_):
					False
				Ok(package_source):
					match lsp_source_for_uri(workspace, other_uri()):
						Err(_):
							False
						Ok(native_source):
							package_matches: Bool = match lsp_source_snapshot_origin(
								package_source,
							):
								CompilerSourcePackageModule(package_alias):
									package_alias == "math"
								_:
									False

							native_matches: Bool = match lsp_source_snapshot_origin(native_source):
								CompilerNativePackageModule(package_id):
									package_id == "native-id"
								_:
									False

							provenance_matches: Bool = match lsp_source_snapshot_provenance(
								package_source,
							):
								LspSelectedDiscoveredSource(LspSourcePackageSource(package)):
									package.package_alias == "math"
								_:
									False

							package_matches and native_matches and provenance_matches


pure func test_open_only_source_defaults_to_user_origin() -> Bool:
	match version(1):
		None:
			False
		Some(document_version):
			layers = lsp_source_layers(
				main_uri(),
				None,
				Some(
					lsp_open_document_source_layer(
						source("/workspace/main.brp", "main", "VALUE = 3\n"),
						document_version,
					),
				),
			)

			match workspace_snapshot([layers]):
				Some(workspace):
					match lsp_source_for_uri(workspace, main_uri()):
						Ok(selected):
							lsp_source_snapshot_origin(selected) == CompilerUserModule
						Err(_):
							False
				None:
					False


pure func test_source_lookup_rejects_missing_and_duplicate_uri() -> Bool:
	first = lsp_source_layers(
		main_uri(),
		Some(
			lsp_discovered_source_layer(
				source("/workspace/main.brp", "main", "VALUE = 1\n"),
				LspDiskSource,
			),
		),
		None,
	)
	second = lsp_source_layers(
		main_uri(),
		Some(
			lsp_discovered_source_layer(
				source("/alternate/main.brp", "main", "VALUE = 2\n"),
				LspDiskSource,
			),
		),
		None,
	)
	empty = lsp_source_layers(other_uri(), None, None)

	match (workspace_snapshot([first]), workspace_snapshot([empty])):
		(Some(single_workspace), Some(empty_workspace)):
			duplicate_rejected: Bool = match lsp_source_store_from_values([first, second]):
				Err(uri):
					uri == main_uri()
				Ok(_):
					False

			missing_rejected: Bool = match lsp_source_for_uri(single_workspace, other_uri()):
				Err(LspWorkspaceSourceUnavailable(uri)):
					uri == other_uri()
				_:
					False

			empty_rejected: Bool = match lsp_source_for_uri(empty_workspace, other_uri()):
				Err(LspWorkspaceSourceUnavailable(uri)):
					uri == other_uri()
				_:
					False

			duplicate_rejected and missing_rejected and empty_rejected
		_:
			False


pure func test_artifact_local_symbol_id_owns_managed_artifact_identity() -> Bool:
	artifact_id: LspSemanticArtifactId = {value = "artifact-main-v1"}
	local_id: LspArtifactLocalSymbolId = {
		artifact_id = artifact_id,
		compiler_definition_id = 42
	}
	symbol = LspArtifactLocalSemanticSymbol(local_id)

	match symbol:
		LspArtifactLocalSemanticSymbol(value):
			value.artifact_id.value == "artifact-main-v1" and value.compiler_definition_id == 42
		_:
			False


tests: TestSuite = {
	description = "Compiler LSP workspace source selection",
	tests = [
		(
			"open overlay wins and inherits discovered origin",
			test_open_overlay_wins_and_inherits_discovered_origin,
		),
		("discovered package origins are preserved", test_discovered_package_origins_are_preserved),
		("open-only source defaults to user origin", test_open_only_source_defaults_to_user_origin),
		(
			"source lookup rejects missing and duplicate URI",
			test_source_lookup_rejects_missing_and_duplicate_uri,
		),
		(
			"artifact-local symbol ID owns managed artifact identity",
			test_artifact_local_symbol_id_owns_managed_artifact_identity,
		),
	]
}
