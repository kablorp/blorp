import:
	../src/stage_05_types/compiler_dim_solver:
		DimSolveResult(DimBindMeta, DimBindVar, DimContradiction, DimSolved, DimStuck),
		dim_solve,
	../src/stage_05_types/compiler_type:
		SemanticDimOp(SemanticDimAdd, SemanticDimDivide, SemanticDimMultiply),
		SemanticType(SemanticConstIntType, SemanticDimOpType, SemanticMetaType, SemanticTypeVar),
		type_to_string,
		types_equal,
	test: TestSuite


pure func dim_add(left: SemanticType, right: SemanticType) -> SemanticType:
	SemanticDimOpType(SemanticDimAdd, left, right)


pure func dim_mul(left: SemanticType, right: SemanticType) -> SemanticType:
	SemanticDimOpType(SemanticDimMultiply, left, right)


pure func dim_div(left: SemanticType, right: SemanticType) -> SemanticType:
	SemanticDimOpType(SemanticDimDivide, left, right)


pure func dim_var(name: String) -> SemanticType:
	SemanticTypeVar(name)


pure func dim_const(value: Int) -> SemanticType:
	SemanticConstIntType(value)


func test_equivalent_sum_products_solve() -> Bool:
	left: SemanticType = dim_mul(
		dim_const(2),
		dim_add(dim_var("#N"), dim_const(3)),
	)
	right: SemanticType = dim_add(
		dim_mul(dim_var("#N"), dim_const(2)),
		dim_const(6),
	)

	match dim_solve([], left, right):
		DimSolved:
			True
		_:
			False


func test_exact_constant_division_solves() -> Bool:
	left: SemanticType = dim_div(
		dim_mul(dim_const(8), dim_var("#N")),
		dim_const(4),
	)
	right: SemanticType = dim_mul(dim_const(2), dim_var("#N"))

	match dim_solve([], left, right):
		DimSolved:
			True
		_:
			False


func test_single_dim_variable_binding() -> Bool:
	match dim_solve(
		[],
		dim_add(dim_var("#N"), dim_const(1)),
		dim_const(5),
	):
		DimBindVar(name, value):
			name == "#N" and types_equal(value, dim_const(4))
		_:
			False


func test_single_meta_binding() -> Bool:
	match dim_solve(
		[],
		dim_add(SemanticMetaType(0), dim_const(2)),
		dim_const(5),
	):
		DimBindMeta(meta_id, value):
			meta_id == 0 and types_equal(value, dim_const(3))
		_:
			False


func test_uses_meta_bindings() -> Bool:
	match dim_solve(
		[(0, dim_const(3))],
		dim_add(SemanticMetaType(0), dim_const(2)),
		dim_const(5),
	):
		DimSolved:
			True
		_:
			False


func test_contradiction_and_stuck_are_distinct() -> Bool:
	contradiction_ok: Bool = match dim_solve([], dim_const(3), dim_const(5)):
		DimContradiction:
			True
		_:
			False

	stuck_ok: Bool = match dim_solve(
		[],
		dim_mul(dim_var("#N"), dim_var("#M")),
		dim_const(5),
	):
		DimStuck:
			True
		_:
			False

	contradiction_ok and stuck_ok


func test_linear_binding_can_keep_symbolic_remainder() -> Bool:
	match dim_solve(
		[],
		dim_add(SemanticMetaType(4), dim_const(1)),
		dim_add(dim_var("#N"), dim_const(2)),
	):
		DimBindMeta(meta_id, value):
			meta_id == 4 and type_to_string(value) == "#1 + #N"
		_:
			False


tests: TestSuite = {
	description = "Compiler dimension solver",
	tests = [
		("equivalent sum products solve", test_equivalent_sum_products_solve),
		("exact constant division solves", test_exact_constant_division_solves),
		("single dim variable binding", test_single_dim_variable_binding),
		("single meta binding", test_single_meta_binding),
		("uses meta bindings", test_uses_meta_bindings),
		("contradiction and stuck are distinct", test_contradiction_and_stuck_are_distinct),
		(
			"linear binding can keep symbolic remainder",
			test_linear_binding_can_keep_symbolic_remainder,
		),
	]
}
