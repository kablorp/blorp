import:
	../src/stage_05_types/compiler_dim_solver:
		CompilerDimSolveResult(
			CompilerDimBindMeta,
			CompilerDimBindVar,
			CompilerDimContradiction,
			CompilerDimSolved,
			CompilerDimStuck,
		),
		compiler_dim_solve,
	../src/stage_05_types/compiler_type:
		CompilerDimOp(CompilerDimAdd, CompilerDimDivide, CompilerDimMultiply),
		CompilerType(CompilerConstIntType, CompilerDimOpType, CompilerMetaType, CompilerTypeVar),
		compiler_type_to_string,
		compiler_types_equal,
	test: TestSuite


pure func dim_add(left: CompilerType, right: CompilerType) -> CompilerType:
	CompilerDimOpType(CompilerDimAdd, left, right)


pure func dim_mul(left: CompilerType, right: CompilerType) -> CompilerType:
	CompilerDimOpType(CompilerDimMultiply, left, right)


pure func dim_div(left: CompilerType, right: CompilerType) -> CompilerType:
	CompilerDimOpType(CompilerDimDivide, left, right)


pure func dim_var(name: String) -> CompilerType:
	CompilerTypeVar(name)


pure func dim_const(value: Int) -> CompilerType:
	CompilerConstIntType(value)


func test_equivalent_sum_products_solve() -> Bool:
	left: CompilerType = dim_mul(
		dim_const(2),
		dim_add(dim_var("#N"), dim_const(3)),
	)
	right: CompilerType = dim_add(
		dim_mul(dim_var("#N"), dim_const(2)),
		dim_const(6),
	)

	match compiler_dim_solve([], left, right):
		CompilerDimSolved:
			True
		_:
			False


func test_exact_constant_division_solves() -> Bool:
	left: CompilerType = dim_div(
		dim_mul(dim_const(8), dim_var("#N")),
		dim_const(4),
	)
	right: CompilerType = dim_mul(dim_const(2), dim_var("#N"))

	match compiler_dim_solve([], left, right):
		CompilerDimSolved:
			True
		_:
			False


func test_single_dim_variable_binding() -> Bool:
	match compiler_dim_solve(
		[],
		dim_add(dim_var("#N"), dim_const(1)),
		dim_const(5),
	):
		CompilerDimBindVar(name, value):
			name == "#N" and compiler_types_equal(value, dim_const(4))
		_:
			False


func test_single_meta_binding() -> Bool:
	match compiler_dim_solve(
		[],
		dim_add(CompilerMetaType(0), dim_const(2)),
		dim_const(5),
	):
		CompilerDimBindMeta(meta_id, value):
			meta_id == 0 and compiler_types_equal(value, dim_const(3))
		_:
			False


func test_uses_meta_bindings() -> Bool:
	match compiler_dim_solve(
		[(0, dim_const(3))],
		dim_add(CompilerMetaType(0), dim_const(2)),
		dim_const(5),
	):
		CompilerDimSolved:
			True
		_:
			False


func test_contradiction_and_stuck_are_distinct() -> Bool:
	contradiction_ok: Bool = match compiler_dim_solve([], dim_const(3), dim_const(5)):
		CompilerDimContradiction:
			True
		_:
			False

	stuck_ok: Bool = match compiler_dim_solve(
		[],
		dim_mul(dim_var("#N"), dim_var("#M")),
		dim_const(5),
	):
		CompilerDimStuck:
			True
		_:
			False

	contradiction_ok and stuck_ok


func test_linear_binding_can_keep_symbolic_remainder() -> Bool:
	match compiler_dim_solve(
		[],
		dim_add(CompilerMetaType(4), dim_const(1)),
		dim_add(dim_var("#N"), dim_const(2)),
	):
		CompilerDimBindMeta(meta_id, value):
			meta_id == 4 and compiler_type_to_string(value) == "#1 + #N"
		_:
			False


tests: TestSuite = {
	description = "Compiler dimension solver",
	tests = [
		("equivalent sum products solve", test_equivalent_sum_products_solve),
		("exact constant division solves", test_exact_constant_division_solves),
		("single dim variable binding", test_single_dim_variable_binding),
		("single meta binding", test_single_meta_binding),
		("uses meta bindings", test_uses_meta_bindings),
		("contradiction and stuck are distinct", test_contradiction_and_stuck_are_distinct),
		(
			"linear binding can keep symbolic remainder",
			test_linear_binding_can_keep_symbolic_remainder,
		),
	]
}
