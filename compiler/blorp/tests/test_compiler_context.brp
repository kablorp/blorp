func test_module_origin_policies() -> Bool:
	match (
		source_package_origin(" sqlite "),
		source_package_origin("  "),
		native_package_origin(" raylib "),
	):
		(Some(source_origin), None, Some(native_origin)):
			(
				module_origin_is_std(CompilerStdlibModule)
				and not module_origin_is_std(CompilerUserModule)
				and module_origin_is_package(source_origin)
				and module_origin_is_package(native_origin)
				and module_origin_allows_builtin(CompilerStdlibModule)
				and not module_origin_allows_builtin(source_origin)
				and module_origin_allows_foreign(CompilerUserModule)
				and module_origin_allows_foreign(native_origin)
				and not module_origin_allows_foreign(source_origin)
				and module_origin_label(source_origin) == "source package 'sqlite'"
				and module_origin_label(native_origin) == "native package 'raylib'"
			)
		_:
			False


func test_type_home_registration_tracks_ambiguity() -> Bool:
	base = context_empty()
	one = register_type_home(base, "Widget", "pkg/a")
	same = register_type_home(one, "Widget", "pkg/a")
	ambiguous = register_type_home(same, "Widget", "pkg/b")

	match (find_type_home(one, "Widget"), find_type_home(ambiguous, "Widget")):
		(Some(unique_home), None):
			(
				unique_home == "pkg/a"
				and find_type_homes(same, "Widget") == ["pkg/a"]
				and find_type_homes(ambiguous, "Widget") == ["pkg/a", "pkg/b"]
				and find_type_homes(base, "Widget").length() == 0
			)
		_:
			False


func test_resource_cleanup_registration_is_context_local() -> Bool:
	base = context_empty()
	with_cleanup = register_resource_cleanup(base, "File", "close_file")
	updated = register_resource_cleanup(with_cleanup, "File", "close_file_now")

	match (
		find_resource_cleanup(base, "File"),
		find_resource_cleanup(with_cleanup, "File"),
		find_resource_cleanup(updated, "File"),
	):
		(None, Some(first_cleanup), Some(updated_cleanup)):
			first_cleanup == "close_file" and updated_cleanup == "close_file_now"
		_:
			False


func test_trait_home_registration_reports_conflicts() -> Bool:
	base = context_empty()

	match register_trait_home(base, "Renderable", "pkg/a"):
		TraitHomeRegistered(first_context):
			match register_trait_home(first_context, "Renderable", "pkg/a"):
				TraitHomeRegistered(idempotent_context):
					match register_trait_home(idempotent_context, "Renderable", "pkg/b"):
						TraitHomeConflict(conflict):
							(
								find_trait_home(idempotent_context, "Renderable") == Some("pkg/a")
								and conflict.trait_name == "Renderable"
								and conflict.existing_module == "pkg/a"
								and conflict.new_module == "pkg/b"
							)
						_:
							False
				_:
					False
		_:
			False


func test_context_counters_and_meta_reset() -> Bool:
	start = context_empty()
	first_id = mint_def_id(start)
	second_id = mint_def_id(first_id.context)
	first_meta = fresh_meta(second_id.context)
	second_meta = fresh_meta(first_meta.context)
	meta_reset = reset_meta(second_meta.context)
	third_meta = fresh_meta(meta_reset)
	advanced = { third_meta.context |
		def_id_counter = 9,
		lower_destruct_counter = 2,
		lower_param_counter = 3,
		lower_question_bind_counter = 4,
		lower_resource_counter = 5,
		lower_task_scope_counter = 6,
		lower_current_task_scope_id = 7,
		desugar_counter = 8,
		ssa_mut_counter = 9
	}
	core_reset = reset_core_counters(advanced)

	match (first_meta.meta_type, second_meta.meta_type, third_meta.meta_type):
		(CompilerMetaType(first_meta_id), CompilerMetaType(second_meta_id), CompilerMetaType(third_meta_id)):
			(
				first_id.def_id == 0
				and second_id.def_id == 1
				and first_meta_id == 0
				and second_meta_id == 1
				and third_meta_id == 0
				and meta_reset.def_id_counter == 2
				and core_reset.def_id_counter == 0
				and core_reset.lower_destruct_counter == 0
				and core_reset.lower_param_counter == 0
				and core_reset.lower_question_bind_counter == 0
				and core_reset.lower_resource_counter == 0
				and core_reset.lower_task_scope_counter == 1
				and core_reset.lower_current_task_scope_id == 0
				and core_reset.desugar_counter == 0
				and core_reset.ssa_mut_counter == 0
				and core_reset.fresh_meta_counter == 1
			)
		_:
			False


func test_meta_bindings_head_resolve_and_zonk() -> Bool:
	first_meta = fresh_meta_with_origin(context_empty(), "T")
	second_meta = fresh_meta_with_origin(first_meta.context, "U")
	third_meta = fresh_meta_with_origin(second_meta.context, "V")
	context_with_chain = bind_meta(
		bind_meta(third_meta.context, 1, compiler_type_list(compiler_type_int())),
		0,
		CompilerMetaType(1),
	)
	nested: CompilerType = CompilerNamedType(
		"Box",
		[CompilerMetaType(0), CompilerMetaType(2), CompilerMetaType(9)],
	)
	zonked: CompilerType = zonk_type(context_with_chain, nested)

	match lookup_meta(context_with_chain, 0):
		Some(bound_zero):
			compiler_types_equal(bound_zero, CompilerMetaType(1)) and compiler_types_equal(
				head_resolve(context_with_chain, CompilerMetaType(0)),
				compiler_type_list(compiler_type_int()),
			) and compiler_types_equal(
				zonked,
				CompilerNamedType(
					"Box",
					[
						compiler_type_list(compiler_type_int()),
						CompilerTypeVar("V"),
						CompilerTypeVar("?m9"),
					],
				),
			) and meta_origin_name(
				context_with_chain,
				2,
			) == "V" and meta_origin_name(
				context_with_chain,
				9,
			) == "?m9" and occurs_meta(context_with_chain, 1, CompilerMetaType(0))
		None:
			False


func test_meta_origins_are_dense_by_meta_id() -> Bool:
	first_meta = fresh_meta_with_origin(context_empty(), "T")
	second_meta = fresh_meta_with_origin(first_meta.context, "U")

	(
		second_meta.context.meta_origins.get(0) == Some("T")
		and second_meta.context.meta_origins.get(1) == Some("U")
		and second_meta.context.meta_origins.get(2) == None
	)


func test_resolve_type_metas_preserves_unbound_inference_identity() -> Bool:
	first_meta = fresh_meta_with_origin(context_empty(), "T")
	second_meta = fresh_meta_with_origin(first_meta.context, "U")
	bound_context = bind_meta(second_meta.context, 1, compiler_type_string())
	nested: CompilerType = CompilerNamedType(
		"Pair",
		[first_meta.meta_type, second_meta.meta_type],
	)

	compiler_types_equal(
		resolve_type_metas(
			bound_context,
			nested,
		),
		CompilerNamedType(
			"Pair",
			[first_meta.meta_type, compiler_type_string()],
		),
	)


func test_meta_reset_clears_bindings_and_origins() -> Bool:
	meta_step = fresh_meta_with_origin(context_empty(), "T")
	bound_context = bind_meta(meta_step.context, 0, compiler_type_int())
	reset_context = reset_meta(bound_context)
	fresh_after_reset = fresh_meta(reset_context)

	match fresh_after_reset.meta_type:
		CompilerMetaType(meta_id):
			(
				meta_id == 0
				and lookup_meta(reset_context, 0) == None
				and meta_origin_name(reset_context, 0) == "?m0"
			)
		_:
			False


func subst_has(step: UnifyStep, name: String, expected: CompilerType) -> Bool:
	match unify_subst_lookup(step, name):
		Some(actual):
			compiler_types_equal(actual, expected)
		None:
			False


func test_unify_binds_meta_and_rejects_occurs() -> Bool:
	bind_result = unify(context_empty(), CompilerMetaType(0), compiler_type_int())
	occurs_result = unify(
		context_empty(),
		CompilerMetaType(0),
		compiler_type_list(CompilerMetaType(0)),
	)

	match bind_result:
		Some(step):
			match lookup_meta(step.context, 0):
				Some(binding):
					compiler_types_equal(binding, compiler_type_int()) and occurs_result == None
				None:
					False
		None:
			False


func test_unify_type_vars_one_way_and_symmetric() -> Bool:
	left_bind = unify(context_empty(), CompilerTypeVar("T"), compiler_type_int())
	right_bind_one_way = unify(context_empty(), compiler_type_int(), CompilerTypeVar("T"))
	right_bind_symmetric = unify_symmetric(
		context_empty(),
		compiler_type_int(),
		CompilerTypeVar("T"),
	)

	match (left_bind, right_bind_one_way, right_bind_symmetric):
		(Some(left_step), None, Some(right_step)):
			(
				subst_has(left_step, "T", compiler_type_int())
				and subst_has(right_step, "T", compiler_type_int())
			)
		_:
			False


func test_unify_functions_arrays_and_variadic_dims() -> Bool:
	impure_expected: CompilerType = CompilerFunctionType(
		False,
		[compiler_type_int()],
		compiler_type_string(),
	)
	pure_actual: CompilerType = CompilerFunctionType(
		True,
		[compiler_type_int()],
		compiler_type_string(),
	)
	pure_expected: CompilerType = CompilerFunctionType(
		True,
		[compiler_type_int()],
		compiler_type_string(),
	)
	impure_actual: CompilerType = CompilerFunctionType(
		False,
		[compiler_type_int()],
		compiler_type_string(),
	)
	array_type: CompilerType = CompilerArrayType(compiler_type_int(), [CompilerTypeVar("#N")])
	tensor_type: CompilerType = CompilerNamedType(
		"Tensor",
		[compiler_type_int(), CompilerTypeVar("#N")],
	)
	variadic_expected: CompilerType = CompilerNamedType(
		"Tensor",
		[compiler_type_int(), CompilerVarDimsType("#Ds")],
	)
	concrete_tensor: CompilerType = CompilerNamedType(
		"Tensor",
		[compiler_type_int(), CompilerConstIntType(3), CompilerConstIntType(4)],
	)

	(
		unify(context_empty(), impure_expected, pure_actual) != None
		and unify(context_empty(), pure_expected, impure_actual) == None
		and unify(context_empty(), array_type, tensor_type) != None
		and unify(context_empty(), variadic_expected, concrete_tensor) != None
		and unify(context_empty(), concrete_tensor, variadic_expected) == None
	)


func test_unify_named_literal_range_and_dim_arithmetic() -> Bool:
	string_type: CompilerType = compiler_type_string()
	literal_type: CompilerType = CompilerNamedType("LiteralString", [])
	dim_expr_left: CompilerType = CompilerDimOpType(
		CompilerDimAdd,
		CompilerConstIntType(2),
		CompilerConstIntType(3),
	)
	dim_expr_right: CompilerType = CompilerConstIntType(5)

	(
		types_compatible_in_context(context_empty(), string_type, literal_type)
		and types_bidirectional_in_context(context_empty(), string_type, literal_type)
		and types_compatible_in_context(
			context_empty(),
			compiler_type_int(),
			CompilerRangeType(CompilerConstIntType(5)),
		)
		and types_bidirectional_in_context(
			context_empty(),
			CompilerRangeType(CompilerConstIntType(5)),
			compiler_type_int(),
		)
		and types_bidirectional_in_context(context_empty(), dim_expr_left, dim_expr_right)
		and not types_compatible_in_context(
			context_empty(),
			compiler_type_string(),
			compiler_type_int(),
		)
	)


func test_unify_dim_solver_binds_vars_and_metas() -> Bool:
	dim_var_expr: CompilerType = CompilerDimOpType(
		CompilerDimAdd,
		CompilerTypeVar("#N"),
		CompilerConstIntType(1),
	)
	var_step = unify_symmetric(context_empty(), dim_var_expr, CompilerConstIntType(5))
	meta_step = fresh_meta(context_empty())
	meta_expr: CompilerType = CompilerDimOpType(
		CompilerDimAdd,
		meta_step.meta_type,
		CompilerConstIntType(2),
	)
	meta_unified = unify_symmetric(meta_step.context, meta_expr, CompilerConstIntType(5))
	distributed_left: CompilerType = CompilerDimOpType(
		CompilerDimMultiply,
		CompilerConstIntType(2),
		CompilerDimOpType(CompilerDimAdd, CompilerTypeVar("#M"), CompilerConstIntType(3)),
	)
	distributed_right: CompilerType = CompilerDimOpType(
		CompilerDimAdd,
		CompilerDimOpType(CompilerDimMultiply, CompilerTypeVar("#M"), CompilerConstIntType(2)),
		CompilerConstIntType(6),
	)

	match (var_step, meta_unified):
		(Some(var_result), Some(meta_result)):
			subst_has(var_result, "#N", CompilerConstIntType(4)) and compiler_types_equal(
				head_resolve(meta_result.context, meta_step.meta_type),
				CompilerConstIntType(3),
			) and types_bidirectional_in_context(
				context_empty(),
				distributed_left,
				distributed_right,
			)
		_:
			False


func test_unify_rigid_vars_do_not_bind_except_dims_to_int() -> Bool:
	(
		not types_compatible_rigid_in_context(
			context_empty(),
			["T"],
			CompilerTypeVar("T"),
			compiler_type_int(),
		)
		and types_compatible_rigid_in_context(
			context_empty(),
			["#N"],
			CompilerTypeVar("#N"),
			compiler_type_int(),
		)
	)


func test_unify_named_type_params() -> Bool:
	left_named_param = unify_with_type_params(
		context_empty(),
		["T:Stringable"],
		CompilerNamedType("T", []),
		compiler_type_string(),
	)
	right_named_param = unify_symmetric_with_type_params(
		context_empty(),
		["T"],
		compiler_type_string(),
		CompilerNamedType("T", []),
	)

	match (left_named_param, right_named_param):
		(Some(left_step), Some(right_step)):
			(
				subst_has(left_step, "T", compiler_type_string())
				and subst_has(right_step, "T", compiler_type_string())
				and types_compatible_with_params_in_context(
					context_empty(),
					["T"],
					CompilerNamedType("T", []),
					compiler_type_int(),
				)
			)
		_:
			False


tests: TestSuite = {
	description = "Compiler context",
	tests = [
		("module origin policies", test_module_origin_policies),
		("type home registration tracks ambiguity", test_type_home_registration_tracks_ambiguity),
		(
			"resource cleanup registration is context local",
			test_resource_cleanup_registration_is_context_local,
		),
		(
			"trait home registration reports conflicts",
			test_trait_home_registration_reports_conflicts,
		),
		("context counters and meta reset", test_context_counters_and_meta_reset),
		("meta bindings head resolve and zonk", test_meta_bindings_head_resolve_and_zonk),
		("meta origins are dense by meta id", test_meta_origins_are_dense_by_meta_id),
		(
			"resolve type metas preserves unbound inference identity",
			test_resolve_type_metas_preserves_unbound_inference_identity,
		),
		("meta reset clears bindings and origins", test_meta_reset_clears_bindings_and_origins),
		("unify binds meta and rejects occurs", test_unify_binds_meta_and_rejects_occurs),
		("unify type vars one way and symmetric", test_unify_type_vars_one_way_and_symmetric),
		("unify functions arrays and variadic dims", test_unify_functions_arrays_and_variadic_dims),
		(
			"unify named literal range and dim arithmetic",
			test_unify_named_literal_range_and_dim_arithmetic,
		),
		("unify dim solver binds vars and metas", test_unify_dim_solver_binds_vars_and_metas),
		(
			"unify rigid vars do not bind except dims to int",
			test_unify_rigid_vars_do_not_bind_except_dims_to_int,
		),
		("unify named type params", test_unify_named_type_params),
	]
}
