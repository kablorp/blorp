import:
	../src/stage_12_cli/cli_package_artifact:
		CLI_PACKAGE_ARTIFACT_MAX_BYTES,
		parse_cli_package_artifact,
		validate_cli_package_artifact_size,
	bytes: Bytes, concat as concat_bytes
	test: TestSuite


private ARTIFACT_MAGIC: String = "blorp-package-artifact-v1\0"


private pure func framed(value: Bytes) -> List[Bytes]:
	[
		value
			.length()
			.to_string()
			.to_bytes(),
		"\0".to_bytes(),
		value,
		"\0".to_bytes(),
	]


private pure func artifact_entry(path: String, contents: String) -> List[Bytes]:
	["file\0".to_bytes()]
		.concat(framed(path.to_bytes()))
		.concat(framed(contents.to_bytes()))


private pure func artifact(entries: List[List[Bytes]]) -> Bytes:
	var parts: List[Bytes] = [ARTIFACT_MAGIC.to_bytes()]

	for entry in entries:
		parts = parts.concat(entry)

	concat_bytes(parts)


pure func test_package_artifact_parses_binary_entries() -> Bool:
	bytes_value: Bytes = artifact([
		artifact_entry("package.toml", "manifest"),
		artifact_entry("src/sample.brp", "pure func answer() -> Int: 42\n"),
	])

	match parse_cli_package_artifact("sample.blorpkg", bytes_value):
		Ok([manifest, source]):
			(
				manifest.relative_path == "package.toml"
				and manifest.contents.to_string() == "manifest"
				and source.relative_path == "src/sample.brp"
			)
		_:
			False


pure func test_package_artifact_rejects_unsafe_paths() -> Bool:
	bytes_value: Bytes = artifact([artifact_entry("src/../outside.brp", "bad")])

	match parse_cli_package_artifact("unsafe.blorpkg", bytes_value):
		Err(errors):
			errors.any(func(error): error.contains("unsafe path"))
		Ok(_):
			False


pure func test_package_artifact_rejects_duplicate_paths() -> Bool:
	bytes_value: Bytes = artifact([
		artifact_entry("package.toml", "first"),
		artifact_entry("package.toml", "second"),
	])

	match parse_cli_package_artifact("duplicate.blorpkg", bytes_value):
		Err(errors):
			errors.any(func(error): error.contains("duplicate path"))
		Ok(_):
			False


pure func test_package_artifact_rejects_truncated_values() -> Bool:
	bytes_value: Bytes = concat_bytes([
		ARTIFACT_MAGIC.to_bytes(),
		"file\0".to_bytes(),
		"5\0".to_bytes(),
		"src/x\0".to_bytes(),
		"10\0short".to_bytes(),
	])

	match parse_cli_package_artifact("truncated.blorpkg", bytes_value):
		Err(errors):
			errors.any(func(error): error.contains("truncated artifact value"))
		Ok(_):
			False


pure func test_package_artifact_rejects_overflowing_lengths() -> Bool:
	bytes_value: Bytes = concat_bytes([
		ARTIFACT_MAGIC.to_bytes(),
		"file\0".to_bytes(),
		"999999999999999999999999999999999999\0".to_bytes(),
	])

	match parse_cli_package_artifact("overflow.blorpkg", bytes_value):
		Err(errors):
			errors.any(func(error): error.contains("length is too large"))
		Ok(_):
			False


pure func test_package_artifact_rejects_oversized_input() -> Bool:
	(
		validate_cli_package_artifact_size(
			"maximum.blorpkg",
			CLI_PACKAGE_ARTIFACT_MAX_BYTES,
		).is_ok()
		and validate_cli_package_artifact_size(
			"oversized.blorpkg",
			CLI_PACKAGE_ARTIFACT_MAX_BYTES + 1,
		).is_err()
	)


tests: TestSuite = {
	description = "CLI package artifact",
	tests = [
		("parse binary entries", test_package_artifact_parses_binary_entries),
		("reject unsafe paths", test_package_artifact_rejects_unsafe_paths),
		("reject duplicate paths", test_package_artifact_rejects_duplicate_paths),
		("reject truncated values", test_package_artifact_rejects_truncated_values),
		("reject overflowing lengths", test_package_artifact_rejects_overflowing_lengths),
		("reject oversized input", test_package_artifact_rejects_oversized_input),
	]
}
