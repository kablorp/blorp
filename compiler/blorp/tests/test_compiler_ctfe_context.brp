import:
	../src/stage_01_file_io/compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_03_parse/compiler_parsed_ast:
		ParsedDecl(ImportBlockParsedDecl, PrivateParsedDecl, UnionParsedDecl),
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedImportDecl,
		ParsedTypeExpr(ParsedNamedType),
		ParsedUnionDecl,
		ParsedVariantDecl,
		parsed_identifier,
	../src/stage_05_types/compiler_type: compiler_type_int
	../src/stage_06_typecheck/compiler_typecheck_decl:
		CompilerTypedDecl(
			CompilerTypedFunctionDecl,
			CompilerTypedParsedDecl,
			CompilerTypedPrivateDecl,
			CompilerTypedUnionDecl,
		),
		CompilerTypedFunctionInfo,
		CompilerTypedProgram,
		CompilerTypedUnionInfo,
	../src/stage_07_ctfe/compiler_ctfe_context:
		compiler_ctfe_context_constructor_arity,
		compiler_ctfe_context_constructor_info,
		compiler_ctfe_context_constructor_is_nullary,
		compiler_ctfe_context_empty,
		compiler_ctfe_context_from_program,
		compiler_ctfe_context_function_by_callable_id,
		compiler_ctfe_context_imported_functions_by_source,
		compiler_ctfe_context_module_alias,
		compiler_ctfe_context_module_global_value,
		compiler_ctfe_context_module_has_global_binding,
		compiler_ctfe_context_nullary_constructor_reference,
		compiler_ctfe_context_with_module_global_env,
	../src/stage_07_ctfe/compiler_ctfe_env: compiler_ctfe_bind_global_value, compiler_ctfe_env_empty
	../src/stage_07_ctfe/compiler_ctfe_value:
		CompilerCtfeValue,
		compiler_ctfe_int,
		compiler_ctfe_values_equal,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("ctfe_context.brp", "ctfe_context", "func main(): 0")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], source_span())


pure func parsed_function(name: String) -> ParsedFunctionDecl:
	{
		name = ident(name),
		keyword_span = Some(source_span()),
		type_params = [],
		params = [],
		return_type = Some(named_type("Int")),
		dim_constraints = [],
		body = None,
		is_pure = True,
		annotations = [],
		doc = None,
		span = source_span()
	}


pure func optional_ident(text: Option[String]) -> Option[ParsedIdentifier]:
	match text:
		Some(value):
			Some(ident(value))
		None:
			None


pure func parsed_import(module_path: String, alias_name: Option[String]) -> ParsedImportDecl:
	{
		module_path = module_path,
		module_alias = optional_ident(alias_name),
		symbols = None,
		span = source_span()
	}


pure func typed_function(name: String, callable_id: Option[Int]) -> CompilerTypedFunctionInfo:
	{
		decl = parsed_function(name),
		callable_id = callable_id,
		effective_type_params = [],
		param_types = [],
		source_return_type = Some(compiler_type_int()),
		semantic_return_type = compiler_type_int(),
		body = None
	}


pure func parsed_variant(name: String, fields: List[ParsedTypeExpr]) -> ParsedVariantDecl:
	{
		name = ident(name),
		fields = fields,
		span = source_span()
	}


pure func parsed_union(name: String, variants: List[ParsedVariantDecl]) -> ParsedUnionDecl:
	{
		name = ident(name),
		type_params = [],
		variants = variants,
		is_enum = False,
		doc = None,
		span = source_span()
	}


pure func typed_union_info() -> CompilerTypedUnionInfo:
	{
		decl = parsed_union(
			"Maybe",
			[parsed_variant("None", []), parsed_variant("Some", [named_type("Int")])],
		),
		variants = [
			{
				name = "None",
				fields = [],
				tag = 0,
				def_id = Some(41)
			},
			{
				name = "Some",
				fields = [compiler_type_int()],
				tag = 1,
				def_id = Some(42)
			},
		]
	}


pure func typed_program(decls: List[CompilerTypedDecl]) -> CompilerTypedProgram:
	{
		source = source_file(),
		decls = decls,
		diagnostics = []
	}


pure func int_value(value: Int) -> CompilerCtfeValue:
	compiler_ctfe_int(source_span(), value)


func test_context_collects_constructors_and_nullary_refs() -> Bool:
	program = typed_program([
		CompilerTypedParsedDecl(
			UnionParsedDecl(
				parsed_union(
					"Maybe",
					[parsed_variant("None", []), parsed_variant("Some", [named_type("Int")])],
				),
			),
		),
	])
	context = compiler_ctfe_context_from_program(program, [])

	match compiler_ctfe_context_nullary_constructor_reference(context, "None"):
		Some(ref):
			(
				compiler_ctfe_context_constructor_arity(context, "None") == Some(0)
				and compiler_ctfe_context_constructor_arity(context, "Some") == Some(1)
				and compiler_ctfe_context_constructor_is_nullary(context, "None")
				and not compiler_ctfe_context_constructor_is_nullary(context, "Some")
				and ref.name == "None"
				and ref.parent_type == "Maybe"
				and ref.callable_id == None
			)
		None:
			False


func test_context_collects_typed_union_constructor_ids() -> Bool:
	program = typed_program([CompilerTypedUnionDecl(typed_union_info())])
	context = compiler_ctfe_context_from_program(program, [])

	match compiler_ctfe_context_constructor_info(context, "Some"):
		Some(info):
			info.parent_type == "Maybe" and info.arity == 1 and info.callable_id == Some(42)
		None:
			False


func test_context_collects_private_union_constructors() -> Bool:
	private_decl = PrivateParsedDecl(
		UnionParsedDecl(parsed_union("Status", [parsed_variant("Ready", [])])),
		source_span(),
	)
	program = typed_program([CompilerTypedPrivateDecl(CompilerTypedParsedDecl(private_decl))])
	context = compiler_ctfe_context_from_program(program, [])

	match compiler_ctfe_context_constructor_info(context, "Ready"):
		Some(info):
			info.parent_type == "Status" and info.arity == 0
		None:
			False


func test_context_collects_functions_by_callable_id() -> Bool:
	program = typed_program([
		CompilerTypedFunctionDecl(typed_function("top", Some(10))),
		CompilerTypedFunctionDecl(typed_function("ignored", None)),
		CompilerTypedPrivateDecl(CompilerTypedFunctionDecl(typed_function("hidden", Some(11)))),
	])
	context = compiler_ctfe_context_from_program(program, [])

	match (
		compiler_ctfe_context_function_by_callable_id(context, 10),
		compiler_ctfe_context_function_by_callable_id(context, 11),
		compiler_ctfe_context_function_by_callable_id(context, 12),
	):
		(Some(top), Some(hidden), None):
			top.source_name == "top" and hidden.source_name == "hidden"
		_:
			False


func test_context_groups_imported_functions_by_module_and_source() -> Bool:
	imported_program = typed_program([
		CompilerTypedFunctionDecl(typed_function("render", Some(20))),
		CompilerTypedFunctionDecl(typed_function("render", Some(21))),
		CompilerTypedFunctionDecl(typed_function("parse", Some(22))),
	])
	context = compiler_ctfe_context_from_program(
		typed_program([]),
		[
			{
				module_path = "dep",
				program = imported_program,
				import_bindings = []
			},
		],
	)
	render_functions = compiler_ctfe_context_imported_functions_by_source(context, "dep", "render")
	missing_functions = compiler_ctfe_context_imported_functions_by_source(
		context,
		"other",
		"render",
	)
	var first_function_matches: Bool = False

	match render_functions.get(0):
		Some(ctfe_function):
			first_function_matches = (
				ctfe_function.source_name == "render"
				and ctfe_function.module_path == Some("dep")
			)
		None:
			void

	render_functions.length() == 2 and missing_functions.length() == 0 and first_function_matches


func test_context_groups_private_imported_functions() -> Bool:
	imported_program = typed_program(
		[CompilerTypedPrivateDecl(CompilerTypedFunctionDecl(typed_function("helper", Some(23))))],
	)
	context = compiler_ctfe_context_from_program(
		typed_program([]),
		[
			{
				module_path = "dep",
				program = imported_program,
				import_bindings = []
			},
		],
	)
	helper_functions = compiler_ctfe_context_imported_functions_by_source(context, "dep", "helper")

	match helper_functions.get(0):
		Some(ctfe_function):
			helper_functions.length() == 1 and ctfe_function.module_path == Some("dep")
		None:
			False


func test_context_collects_module_aliases_from_import_blocks() -> Bool:
	program = typed_program([
		CompilerTypedParsedDecl(
			ImportBlockParsedDecl(
				[parsed_import("std/list", None), parsed_import("dep/math", Some("Math"))],
				source_span(),
			),
		),
	])
	context = compiler_ctfe_context_from_program(program, [])

	default_ok = match compiler_ctfe_context_module_alias(context, "list"):
		Some(module_path):
			module_path == "std/list"
		None:
			False

	explicit_ok = match compiler_ctfe_context_module_alias(context, "Math"):
		Some(module_path):
			module_path == "dep/math"
		None:
			False

	missing_ok = compiler_ctfe_context_module_alias(context, "dep").is_none()

	default_ok and explicit_ok and missing_ok


func test_context_scopes_module_aliases_to_importing_module() -> Bool:
	first_program = typed_program(
		[
			CompilerTypedParsedDecl(
				ImportBlockParsedDecl(
					[parsed_import("dep/first_value", Some("Dep"))],
					source_span(),
				),
			),
		],
	)
	second_program = typed_program(
		[
			CompilerTypedParsedDecl(
				ImportBlockParsedDecl(
					[parsed_import("dep/second_value", Some("Dep"))],
					source_span(),
				),
			),
		],
	)
	context = compiler_ctfe_context_from_program(
		typed_program([]),
		[
			{
				module_path = "dep/first",
				program = first_program,
				import_bindings = []
			},
			{
				module_path = "dep/second",
				program = second_program,
				import_bindings = []
			},
		],
	)
	first_context = { context | active_module_path = Some("dep/first") }
	second_context = { context | active_module_path = Some("dep/second") }

	first_ok = match compiler_ctfe_context_module_alias(first_context, "Dep"):
		Some(module_path):
			module_path == "dep/first_value"
		None:
			False

	second_ok = match compiler_ctfe_context_module_alias(second_context, "Dep"):
		Some(module_path):
			module_path == "dep/second_value"
		None:
			False

	first_ok and second_ok and compiler_ctfe_context_module_alias(context, "Dep").is_none()


func test_context_module_global_env_lookup() -> Bool:
	env = compiler_ctfe_bind_global_value(compiler_ctfe_env_empty(), "LIMIT", int_value(42))
	context = compiler_ctfe_context_with_module_global_env(
		compiler_ctfe_context_empty(),
		"dep",
		env,
	)

	match compiler_ctfe_context_module_global_value(context, "dep", "LIMIT"):
		Some(value):
			(
				compiler_ctfe_values_equal(value, int_value(42))
				and compiler_ctfe_context_module_has_global_binding(context, "dep", "LIMIT")
				and not compiler_ctfe_context_module_has_global_binding(context, "dep", "MISSING")
			)
		None:
			False


tests: TestSuite = {
	description = "Compiler CTFE context",
	tests = [
		(
			"context collects constructors and nullary refs",
			test_context_collects_constructors_and_nullary_refs,
		),
		(
			"context collects private union constructors",
			test_context_collects_private_union_constructors,
		),
		(
			"context collects typed union constructor ids",
			test_context_collects_typed_union_constructor_ids,
		),
		(
			"context collects functions by callable id",
			test_context_collects_functions_by_callable_id,
		),
		(
			"context groups imported functions by module and source",
			test_context_groups_imported_functions_by_module_and_source,
		),
		(
			"context groups private imported functions",
			test_context_groups_private_imported_functions,
		),
		(
			"context collects module aliases from import blocks",
			test_context_collects_module_aliases_from_import_blocks,
		),
		(
			"context scopes module aliases to importing module",
			test_context_scopes_module_aliases_to_importing_module,
		),
		("context module global env lookup", test_context_module_global_env_lookup),
	]
}
