import:
	../src/stage_01_file_io/source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_03_parse/parsed_ast:
		ParsedDecl(ImportBlockParsedDecl, PrivateParsedDecl, UnionParsedDecl),
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedImportDecl,
		ParsedTypeExpr(ParsedNamedType),
		ParsedUnionDecl,
		ParsedVariantDecl,
		parsed_identifier,
	../src/stage_05_types/semantic_type: TYPE_INT
	../src/stage_06_typecheck/typecheck_decl:
		TypedDecl(TypedFunctionDecl, TypedParsedDecl, TypedPrivateDecl, TypedUnionDecl),
		TypedFunctionInfo,
		TypedProgram,
		TypedUnionInfo,
	../src/stage_07_ctfe/ctfe_context:
		CTFE_CONTEXT_EMPTY,
		ctfe_context_constructor_arity,
		ctfe_context_constructor_info,
		ctfe_context_constructor_is_nullary,
		ctfe_context_from_program,
		ctfe_context_function_by_callable_id,
		ctfe_context_imported_functions_by_source,
		ctfe_context_module_alias,
		ctfe_context_module_global_value,
		ctfe_context_module_has_global_binding,
		ctfe_context_nullary_constructor_reference,
		ctfe_context_with_module_global_env,
	../src/stage_07_ctfe/ctfe_env: CTFE_ENV_EMPTY, ctfe_bind_global_value
	../src/stage_07_ctfe/ctfe_value: CtfeValue, ctfe_int, ctfe_values_equal
	memory: get_mem_stats, reset_mem_stats
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("ctfe_context.brp", "ctfe_context", "func main(): 0")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], source_span())


pure func parsed_function(name: String) -> ParsedFunctionDecl:
	{
		name = ident(name),
		keyword_span = Some(source_span()),
		type_params = [],
		params = [],
		return_type = Some(named_type("Int")),
		dim_constraints = [],
		body = None,
		is_pure = True,
		annotations = [],
		doc = None,
		span = source_span()
	}


pure func optional_ident(text: Option[String]) -> Option[ParsedIdentifier]:
	match text:
		Some(value):
			Some(ident(value))
		None:
			None


pure func parsed_import(module_path: String, alias_name: Option[String]) -> ParsedImportDecl:
	{
		module_path = module_path,
		module_alias = optional_ident(alias_name),
		symbols = None,
		span = source_span()
	}


pure func typed_function(name: String, callable_id: Option[Int]) -> TypedFunctionInfo:
	{
		decl = parsed_function(name),
		callable_id = callable_id,
		effective_type_params = [],
		param_types = [],
		source_return_type = Some(TYPE_INT),
		semantic_return_type = TYPE_INT,
		body = None
	}


pure func parsed_variant(name: String, fields: List[ParsedTypeExpr]) -> ParsedVariantDecl:
	{
		name = ident(name),
		fields = fields,
		span = source_span()
	}


pure func parsed_union(name: String, variants: List[ParsedVariantDecl]) -> ParsedUnionDecl:
	{
		name = ident(name),
		type_params = [],
		variants = variants,
		is_enum = False,
		doc = None,
		span = source_span()
	}


pure func typed_union_info() -> TypedUnionInfo:
	{
		decl = parsed_union(
			"Maybe",
			[parsed_variant("None", []), parsed_variant("Some", [named_type("Int")])],
		),
		variants = [
			{
				name = "None",
				fields = [],
				tag = 0,
				def_id = Some(41),
				declaration_span = source_span(),
				selection_span = source_span()
			},
			{
				name = "Some",
				fields = [TYPE_INT],
				tag = 1,
				def_id = Some(42),
				declaration_span = source_span(),
				selection_span = source_span()
			},
		]
	}


pure func typed_program(decls: List[TypedDecl]) -> TypedProgram:
	{
		source = source_file(),
		decls = decls,
		diagnostics = [],
		type_definitions = [],
		type_references = []
	}


pure func int_value(value: Int) -> CtfeValue:
	ctfe_int(source_span(), value)


private pure func generated_function_program(
	function_count: Int,
	shared_source_name: Bool,
) -> TypedProgram:
	var decls: List[TypedDecl] = []
	var index: Int = 0

	while index < function_count:
		source_name: String = if shared_source_name:
			"overloaded"
		else:
			index.to_string()

		decls = decls.append(TypedFunctionDecl(typed_function(source_name, Some(index + 1))))
		index += 1

	typed_program(decls)


private func imported_context_allocation_bytes(
	function_count: Int,
	shared_source_name: Bool,
) -> Int:
	imported_program = generated_function_program(function_count, shared_source_name)
	reset_mem_stats()
	context = ctfe_context_from_program(
		typed_program([]),
		[
			{
				module_path = "generated/module",
				program = imported_program,
				import_bindings = []
			},
		],
	)
	group_count: Int = context.imported_functions.length()
	allocated_bytes: Int = get_mem_stats().bytes_allocated

	expected_group_count: Int = if shared_source_name:
		1
	else:
		function_count

	if group_count == expected_group_count:
		allocated_bytes
	else:
		-1


func test_context_imported_function_index_has_bounded_allocation_growth() -> Bool:
	unique_shallow_bytes: Int = imported_context_allocation_bytes(128, False)
	unique_deep_bytes: Int = imported_context_allocation_bytes(512, False)
	overload_shallow_bytes: Int = imported_context_allocation_bytes(128, True)
	overload_deep_bytes: Int = imported_context_allocation_bytes(512, True)
	growth_is_bounded: Bool = (
		unique_shallow_bytes > 0
		and overload_shallow_bytes > 0
		and unique_deep_bytes <= unique_shallow_bytes * 8
		and overload_deep_bytes <= overload_shallow_bytes * 8
	)

	if not growth_is_bounded:
		print(
			"CTFE imported function context bytes: unique=${unique_shallow_bytes.to_string()}/${unique_deep_bytes.to_string()}, overload=${overload_shallow_bytes.to_string()}/${overload_deep_bytes.to_string()}",
		)
	else:
		void

	growth_is_bounded


func test_context_collects_constructors_and_nullary_refs() -> Bool:
	program = typed_program([
		TypedParsedDecl(
			UnionParsedDecl(
				parsed_union(
					"Maybe",
					[parsed_variant("None", []), parsed_variant("Some", [named_type("Int")])],
				),
			),
		),
	])
	context = ctfe_context_from_program(program, [])

	match ctfe_context_nullary_constructor_reference(context, "None"):
		Some(ref):
			(
				ctfe_context_constructor_arity(context, "None") == Some(0)
				and ctfe_context_constructor_arity(context, "Some") == Some(1)
				and ctfe_context_constructor_is_nullary(context, "None")
				and not ctfe_context_constructor_is_nullary(context, "Some")
				and ref.name == "None"
				and ref.parent_type == "Maybe"
				and ref.callable_id == None
			)
		None:
			False


func test_context_collects_typed_union_constructor_ids() -> Bool:
	program = typed_program([TypedUnionDecl(typed_union_info())])
	context = ctfe_context_from_program(program, [])

	match ctfe_context_constructor_info(context, "Some"):
		Some(info):
			info.parent_type == "Maybe" and info.arity == 1 and info.callable_id == Some(42)
		None:
			False


func test_context_collects_private_union_constructors() -> Bool:
	private_decl = PrivateParsedDecl(
		UnionParsedDecl(parsed_union("Status", [parsed_variant("Ready", [])])),
		source_span(),
	)
	program = typed_program([TypedPrivateDecl(TypedParsedDecl(private_decl))])
	context = ctfe_context_from_program(program, [])

	match ctfe_context_constructor_info(context, "Ready"):
		Some(info):
			info.parent_type == "Status" and info.arity == 0
		None:
			False


func test_context_collects_functions_by_callable_id() -> Bool:
	program = typed_program([
		TypedFunctionDecl(typed_function("top", Some(10))),
		TypedFunctionDecl(typed_function("ignored", None)),
		TypedPrivateDecl(TypedFunctionDecl(typed_function("hidden", Some(11)))),
	])
	context = ctfe_context_from_program(program, [])

	match (
		ctfe_context_function_by_callable_id(context, 10),
		ctfe_context_function_by_callable_id(context, 11),
		ctfe_context_function_by_callable_id(context, 12),
	):
		(Some(top), Some(hidden), None):
			top.source_name == "top" and hidden.source_name == "hidden"
		_:
			False


func test_context_groups_imported_functions_by_module_and_source() -> Bool:
	imported_program = typed_program([
		TypedFunctionDecl(typed_function("render", Some(20))),
		TypedFunctionDecl(typed_function("render", Some(21))),
		TypedFunctionDecl(typed_function("parse", Some(22))),
	])
	context = ctfe_context_from_program(
		typed_program([]),
		[
			{
				module_path = "dep",
				program = imported_program,
				import_bindings = []
			},
		],
	)
	render_functions = ctfe_context_imported_functions_by_source(context, "dep", "render")
	missing_functions = ctfe_context_imported_functions_by_source(context, "other", "render")
	var first_function_matches: Bool = False

	match render_functions.get(0):
		Some(ctfe_function):
			first_function_matches = (
				ctfe_function.source_name == "render"
				and ctfe_function.module_path == Some("dep")
			)
		None:
			void

	render_functions.length() == 2 and missing_functions.length() == 0 and first_function_matches


func test_context_groups_private_imported_functions() -> Bool:
	imported_program = typed_program(
		[TypedPrivateDecl(TypedFunctionDecl(typed_function("helper", Some(23))))],
	)
	context = ctfe_context_from_program(
		typed_program([]),
		[
			{
				module_path = "dep",
				program = imported_program,
				import_bindings = []
			},
		],
	)
	helper_functions = ctfe_context_imported_functions_by_source(context, "dep", "helper")

	match helper_functions.get(0):
		Some(ctfe_function):
			helper_functions.length() == 1 and ctfe_function.module_path == Some("dep")
		None:
			False


func test_context_merges_duplicate_imported_module_groups() -> Bool:
	context = ctfe_context_from_program(
		typed_program([]),
		[
			{
				module_path = "dep",
				program = typed_program([TypedFunctionDecl(typed_function("render", Some(24)))]),
				import_bindings = []
			},
			{
				module_path = "dep",
				program = typed_program([TypedFunctionDecl(typed_function("render", Some(25)))]),
				import_bindings = []
			},
		],
	)
	functions = ctfe_context_imported_functions_by_source(context, "dep", "render")

	match (functions.get(0), functions.get(1)):
		(Some(first), Some(second)):
			(
				functions.length() == 2
				and first.info.callable_id == Some(24)
				and second.info.callable_id == Some(25)
			)
		_:
			False


func test_context_collects_module_aliases_from_import_blocks() -> Bool:
	program = typed_program([
		TypedParsedDecl(
			ImportBlockParsedDecl(
				[parsed_import("std/list", None), parsed_import("dep/math", Some("Math"))],
				source_span(),
			),
		),
	])
	context = ctfe_context_from_program(program, [])

	default_ok = match ctfe_context_module_alias(context, "list"):
		Some(module_path):
			module_path == "std/list"
		None:
			False

	explicit_ok = match ctfe_context_module_alias(context, "Math"):
		Some(module_path):
			module_path == "dep/math"
		None:
			False

	missing_ok = ctfe_context_module_alias(context, "dep").is_none()

	default_ok and explicit_ok and missing_ok


func test_context_scopes_module_aliases_to_importing_module() -> Bool:
	first_program = typed_program(
		[
			TypedParsedDecl(
				ImportBlockParsedDecl(
					[parsed_import("dep/first_value", Some("Dep"))],
					source_span(),
				),
			),
		],
	)
	second_program = typed_program(
		[
			TypedParsedDecl(
				ImportBlockParsedDecl(
					[parsed_import("dep/second_value", Some("Dep"))],
					source_span(),
				),
			),
		],
	)
	context = ctfe_context_from_program(
		typed_program([]),
		[
			{
				module_path = "dep/first",
				program = first_program,
				import_bindings = []
			},
			{
				module_path = "dep/second",
				program = second_program,
				import_bindings = []
			},
		],
	)
	first_context = { context | active_module_path = Some("dep/first") }
	second_context = { context | active_module_path = Some("dep/second") }

	first_ok = match ctfe_context_module_alias(first_context, "Dep"):
		Some(module_path):
			module_path == "dep/first_value"
		None:
			False

	second_ok = match ctfe_context_module_alias(second_context, "Dep"):
		Some(module_path):
			module_path == "dep/second_value"
		None:
			False

	first_ok and second_ok and ctfe_context_module_alias(context, "Dep").is_none()


func test_context_module_global_env_lookup() -> Bool:
	env = ctfe_bind_global_value(CTFE_ENV_EMPTY, "LIMIT", int_value(42))
	context = ctfe_context_with_module_global_env(CTFE_CONTEXT_EMPTY, "dep", env)

	match ctfe_context_module_global_value(context, "dep", "LIMIT"):
		Some(value):
			(
				ctfe_values_equal(value, int_value(42))
				and ctfe_context_module_has_global_binding(context, "dep", "LIMIT")
				and not ctfe_context_module_has_global_binding(context, "dep", "MISSING")
			)
		None:
			False


tests: TestSuite = {
	description = "Compiler CTFE context",
	tests = [
		(
			"context collects constructors and nullary refs",
			test_context_collects_constructors_and_nullary_refs,
		),
		(
			"context collects private union constructors",
			test_context_collects_private_union_constructors,
		),
		(
			"context collects typed union constructor ids",
			test_context_collects_typed_union_constructor_ids,
		),
		(
			"context collects functions by callable id",
			test_context_collects_functions_by_callable_id,
		),
		(
			"context groups imported functions by module and source",
			test_context_groups_imported_functions_by_module_and_source,
		),
		(
			"context groups private imported functions",
			test_context_groups_private_imported_functions,
		),
		(
			"context imported function index has bounded allocation growth",
			test_context_imported_function_index_has_bounded_allocation_growth,
		),
		(
			"context merges duplicate imported module groups",
			test_context_merges_duplicate_imported_module_groups,
		),
		(
			"context collects module aliases from import blocks",
			test_context_collects_module_aliases_from_import_blocks,
		),
		(
			"context scopes module aliases to importing module",
			test_context_scopes_module_aliases_to_importing_module,
		),
		("context module global env lookup", test_context_module_global_env_lookup),
	]
}
