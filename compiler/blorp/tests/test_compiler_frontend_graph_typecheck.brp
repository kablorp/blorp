import:
	../src/stage_01_file_io/source: compiler_source_file
	../src/stage_03_parse/language_parser: parse_compiler_source
	../src/stage_03_parse/source_ast_finalize: finalized_typecheck_program
	../src/stage_04_modules/frontend_graph:
		CompilerFrontendModule,
		compiler_frontend_graph,
		compiler_frontend_module,
		compiler_frontend_resolved_import_edge,
	../src/stage_04_modules/loaded_module:
		CompilerModuleOrigin(CompilerSourcePackageModule, CompilerUserModule),
		CompilerResolvedModuleIdentity,
		compiler_resolved_module_identity_from_resolver,
	../src/stage_06_typecheck/frontend_graph_typecheck:
		compiler_typecheck_request_for_frontend_graph,
	test: TestSuite


private pure func identity(
	module_name: String,
	origin: CompilerModuleOrigin,
) -> CompilerResolvedModuleIdentity:
	compiler_resolved_module_identity_from_resolver(module_name, origin)


private pure func module(
	path: String,
	module_name: String,
	text: String,
	origin: CompilerModuleOrigin,
) -> CompilerFrontendModule:
	compiler_frontend_module(
		identity(module_name, origin),
		finalized_typecheck_program(
			parse_compiler_source(compiler_source_file(path, module_name, text)),
		),
	)


pure func test_request_uses_exact_graph_identities_and_requested_import() -> Bool:
	app = module(
		"/workspace/main.brp",
		"main",
		"import:\n\tmath/stats\n\nVALUE = 1\n",
		CompilerUserModule,
	)
	dependency = module(
		"/packages/math/stats.brp",
		"math/stats",
		"VALUE = 2\n",
		CompilerSourcePackageModule("math"),
	)
	edge = compiler_frontend_resolved_import_edge(app.identity, "math/stats", dependency.identity)

	match (
		compiler_frontend_graph(
			[app, dependency],
			[app.identity],
			[edge],
		)
	):
		Err(_):
			False
		Ok(graph):
			match compiler_typecheck_request_for_frontend_graph(
				graph,
				app.identity,
				[dependency.identity],
				False,
				False,
			):
				Err(_):
					False
				Ok(request):
					module_ok: Bool = match request.modules:
						[found]:
							origin_ok: Bool = match found.origin:
								CompilerSourcePackageModule(package_alias):
									package_alias == "math"
								_:
									False

							(
								found.path == "/packages/math/stats.brp"
								and found.module_name == "math/stats"
								and found.module_path == "math/stats"
								and origin_ok
							)
						_:
							False

					resolved_ok: Bool = match request.resolved_imports:
						[found]:
							(
								found.from_path == "/workspace/main.brp"
								and found.from_module == "main"
								and found.import_path == "math/stats"
								and found.resolved_module == "math/stats"
							)
						_:
							False

					(
						request.target.module_path == "main"
						and request.module_targets == ["math/stats"]
						and module_ok
						and resolved_ok
					)


pure func test_request_rejects_a_root_outside_the_graph() -> Bool:
	app = module("/workspace/main.brp", "main", "VALUE = 1\n", CompilerUserModule)
	missing = identity("missing", CompilerUserModule)

	match compiler_frontend_graph([app], [app.identity], []):
		Err(_):
			False
		Ok(graph):
			compiler_typecheck_request_for_frontend_graph(graph, missing, [], False, False).is_err()


tests: TestSuite = {
	description = "Compiler frontend graph typecheck request",
	tests = [
		(
			"use exact graph identities and requested import",
			test_request_uses_exact_graph_identities_and_requested_import,
		),
		("reject root outside graph", test_request_rejects_a_root_outside_the_graph),
	]
}
