import:
	../src/stage_09_core/core_json:
		CoreBinaryOp(AddOp, LessEqualOp, SubtractOp),
		CoreCallKind(UserCall),
		CoreDecl(FunctionDecl, TypeAliasDecl),
		CoreExpr(
			BinaryExpr,
			CallExpr,
			IfExpr,
			LetExpr,
			LiteralExpr,
			ResourceScopeExpr,
			SemanticMatchExpr,
			TailrecListSpreadLoopExpr,
			TailrecListSpreadRecurExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreLiteral(IntLiteral),
		CoreMatchBindingMode(MatchBorrowBindingMode),
		CoreParam,
		CoreProgram,
		CoreResourceScope,
		CoreSemanticMatchAccessor(
			ListElementSemanticMatchAccessor,
			ListSpreadSemanticMatchAccessor,
			RootSemanticMatchAccessor,
		),
		CoreSemanticMatchBinding,
		CoreSemanticMatchTree(SemanticLengthMatch, SemanticMatchLeaf),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
		CoreTypeAliasDecl,
		CoreVar,
	../src/stage_09_core/core_tailrec: lower_tailrec_program
	test: TestSuite


TY_INT: CoreType = NamedType("Int", [])

TY_BOOL: CoreType = NamedType("Bool", [])

TY_VOID: CoreType = VoidType


private pure func list_type(element_type: CoreType) -> CoreType:
	NamedType("List", [element_type])


private pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


private pure func param(name: String, typ: CoreType) -> CoreParam:
	{
		name = core_var(name),
		typ = typ,
		loc = SyntheticSourceLoc
	}


private pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, SyntheticSourceLoc)


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), TY_INT, SyntheticSourceLoc)


private pure func self_call(
	name: String,
	def_id: Int,
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(
		UserCall(
			name,
			Some(def_id),
			[],
		),
		VarExpr(
			{
				name = name,
				uniq = 0,
				def_id = Some(def_id)
			},
			return_type,
			SyntheticSourceLoc,
		),
		args,
		return_type,
		SyntheticSourceLoc,
	)


private pure func function_decl(
	name: String,
	def_id: Int,
	params: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = None,
		type_params = [],
		params = params,
		return_type = return_type,
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


private pure func program(decls: List[CoreDecl]) -> CoreProgram:
	{
		decls = decls,
		foreign_includes = []
	}


private pure func lowered_function_body(
	program_value: CoreProgram,
	name: String,
) -> Option[CoreExpr]:
	lowered: CoreProgram = lower_tailrec_program(program_value)
	var result: Option[CoreExpr] = None

	for decl in lowered.decls:
		match decl:
			FunctionDecl(function_info):
				if function_info.name == name:
					result = function_info.body
					break
			_:
				void

	result


private pure func borrowed_binding(
	variable_name: String,
	accessor: CoreSemanticMatchAccessor,
) -> CoreSemanticMatchBinding:
	{
		variable = core_var(variable_name),
		accessor = accessor,
		mode = MatchBorrowBindingMode
	}


private pure func list_match_body(
	function_name: String,
	def_id: Int,
	list_param_type: CoreType,
	recursive_argument: CoreExpr,
) -> CoreExpr:
	recur: CoreExpr = self_call(
		function_name,
		def_id,
		[recursive_argument, BinaryExpr(
				AddOp,
				variable("acc", TY_INT),
				variable("x", TY_INT),
				TY_INT,
				SyntheticSourceLoc,
			)],
		TY_INT,
	)
	tree: CoreSemanticMatchTree = SemanticLengthMatch(
		RootSemanticMatchAccessor,
		[
			{
				length = 0,
				body = SemanticMatchLeaf(
					[],
					variable("acc", TY_INT),
				)
			},
		],
		Some({
			minimum_length = 1,
			body = SemanticMatchLeaf(
				[borrowed_binding(
						"x",
						ListElementSemanticMatchAccessor(RootSemanticMatchAccessor, 0),
					), borrowed_binding(
						"rest",
						ListSpreadSemanticMatchAccessor(RootSemanticMatchAccessor, 1),
					)],
				recur,
			),
		}),
		None,
	)

	SemanticMatchExpr(
		variable("items", list_param_type),
		tree,
		TY_INT,
		SyntheticSourceLoc,
	)


pure func test_unmanaged_self_call_becomes_tailrec_loop() -> Bool:
	def_id: Int = 11
	body: CoreExpr = IfExpr(
		BinaryExpr(
			LessEqualOp,
			variable("n", TY_INT),
			int_literal(0),
			TY_BOOL,
			SyntheticSourceLoc,
		),
		variable(
			"acc",
			TY_INT,
		),
		self_call(
			"sum_to",
			def_id,
			[BinaryExpr(
					SubtractOp,
					variable("n", TY_INT),
					int_literal(1),
					TY_INT,
					SyntheticSourceLoc,
				), BinaryExpr(
					AddOp,
					variable("acc", TY_INT),
					variable("n", TY_INT),
					TY_INT,
					SyntheticSourceLoc,
				)],
			TY_INT,
		),
		TY_INT,
		SyntheticSourceLoc,
	)

	match (
		lowered_function_body(
			program([
				function_decl(
					"sum_to",
					def_id,
					[param("n", TY_INT), param("acc", TY_INT)],
					TY_INT,
					body,
				),
			]),
			"sum_to",
		)
	):
		Some(TailrecLoopExpr(params, return_type, IfExpr(_, _, recur, _, _), _)):
			match recur:
				TailrecRecurExpr(args, recur_type, _):
					(
						params.length() == 2
						and return_type == TY_INT
						and args.length() == 2
						and recur_type == TY_INT
					)
				_:
					False
		_:
			False


pure func test_list_spread_recur_omits_list_rebind() -> Bool:
	def_id: Int = 19
	list_int: CoreType = list_type(TY_INT)
	body: CoreExpr = list_match_body(
		"sum_recursive",
		def_id,
		list_int,
		variable("rest", list_int),
	)

	match (
		lowered_function_body(
			program([
				function_decl(
					"sum_recursive",
					def_id,
					[param("items", list_int), param("acc", TY_INT)],
					TY_INT,
					body,
				),
			]),
			"sum_recursive",
		)
	):
		Some(TailrecListSpreadLoopExpr(loop, _)):
			match loop.body:
				SemanticMatchExpr(_, SemanticLengthMatch(_, _, Some(geq_case), _), _, _):
					match geq_case.body:
						SemanticMatchLeaf(bindings, recur):
							match recur:
								TailrecListSpreadRecurExpr(rebinds, cursor_advance, _, _):
									(
										loop.list_index == 0
										and loop.list_param.name.name == "items"
										and loop.cursor.name.starts_with("__tailrec_list_index_")
										and bindings.length() == 1
										and bindings.all(
											pure func(binding): binding.variable.name != "rest",
										)
										and rebinds.length() == 1
										and rebinds
											.get(0)
											.map(pure func(rebind): rebind.param_index == 1)
											.get_or(False)
										and cursor_advance == 1
									)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_list_spread_loop_preserves_prefix_binding() -> Bool:
	def_id: Int = 23
	list_int: CoreType = list_type(TY_INT)
	match_body: CoreExpr = list_match_body(
		"sum_recursive",
		def_id,
		list_int,
		variable("rest", list_int),
	)
	body: CoreExpr = LetExpr(core_var("bias"), False, TY_INT, int_literal(0), match_body)

	match (
		lowered_function_body(
			program([
				function_decl(
					"sum_recursive",
					def_id,
					[param("items", list_int), param("acc", TY_INT)],
					TY_INT,
					body,
				),
			]),
			"sum_recursive",
		)
	):
		Some(TailrecListSpreadLoopExpr(loop, _)):
			match loop.body:
				LetExpr(variable, _, _, _, SemanticMatchExpr(_, _, _, _)):
					variable.name == "bias"
				_:
					False
		_:
			False


pure func test_list_spread_loop_recognizes_alias_param() -> Bool:
	def_id: Int = 29
	list_alias: CoreType = NamedType("IntList", [])
	alias_decl: CoreTypeAliasDecl = {
		name = "IntList",
		type_params = [],
		target = list_type(TY_INT),
		is_opaque = False,
		loc = SyntheticSourceLoc
	}
	body: CoreExpr = list_match_body(
		"sum_recursive",
		def_id,
		list_alias,
		variable("rest", list_alias),
	)

	match (
		lowered_function_body(
			program([
				TypeAliasDecl(alias_decl),
				function_decl(
					"sum_recursive",
					def_id,
					[param("items", list_alias), param("acc", TY_INT)],
					TY_INT,
					body,
				),
			]),
			"sum_recursive",
		)
	):
		Some(TailrecListSpreadLoopExpr(loop, _)):
			loop.list_param.typ == list_alias
		_:
			False


pure func test_list_spread_ignores_resource_scope_shadowed_spread_var() -> Bool:
	def_id: Int = 31
	list_int: CoreType = list_type(TY_INT)
	scoped_argument: CoreExpr = ResourceScopeExpr(
		{
			variable = core_var("rest"),
			typ = TY_INT,
			acquire = int_literal(0),
			body = variable("rest", TY_INT),
			cleanup = VoidExpr(TY_VOID, SyntheticSourceLoc)
		},
		TY_INT,
		SyntheticSourceLoc,
	)
	recur: CoreExpr = self_call(
		"sum_recursive",
		def_id,
		[variable("rest", list_int), scoped_argument],
		TY_INT,
	)
	tree: CoreSemanticMatchTree = SemanticLengthMatch(
		RootSemanticMatchAccessor,
		[
			{
				length = 0,
				body = SemanticMatchLeaf(
					[],
					variable("acc", TY_INT),
				)
			},
		],
		Some({
			minimum_length = 1,
			body = SemanticMatchLeaf(
				[borrowed_binding(
						"x",
						ListElementSemanticMatchAccessor(RootSemanticMatchAccessor, 0),
					), borrowed_binding(
						"rest",
						ListSpreadSemanticMatchAccessor(RootSemanticMatchAccessor, 1),
					)],
				recur,
			),
		}),
		None,
	)
	body: CoreExpr = SemanticMatchExpr(
		variable("items", list_int),
		tree,
		TY_INT,
		SyntheticSourceLoc,
	)

	match (
		lowered_function_body(
			program([
				function_decl(
					"sum_recursive",
					def_id,
					[param("items", list_int), param("acc", TY_INT)],
					TY_INT,
					body,
				),
			]),
			"sum_recursive",
		)
	):
		Some(TailrecListSpreadLoopExpr(loop, _)):
			match loop.body:
				SemanticMatchExpr(_, SemanticLengthMatch(_, _, Some(geq_case), _), _, _):
					match geq_case.body:
						SemanticMatchLeaf(_, recur_body):
							match recur_body:
								TailrecListSpreadRecurExpr(rebinds, _, _, _):
									rebinds.length() == 1
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_managed_unmanaged_loop_candidate_is_unchanged() -> Bool:
	string_type: CoreType = NamedType("String", [])
	def_id: Int = 37
	body: CoreExpr = self_call("repeat", def_id, [variable("text", string_type)], string_type)

	match lowered_function_body(
		program([function_decl("repeat", def_id, [param("text", string_type)], string_type, body)]),
		"repeat",
	):
		Some(CallExpr(UserCall(_, Some(actual_id), _), _, _, _, _)):
			actual_id == def_id
		_:
			False


pure func test_unknown_type_fails_closed() -> Bool:
	unknown_type: CoreType = NamedType("UnknownRuntimeValue", [])
	def_id: Int = 41
	body: CoreExpr = self_call("unknown", def_id, [variable("value", unknown_type)], unknown_type)

	match lowered_function_body(
		program(
			[
				function_decl(
					"unknown",
					def_id,
					[param("value", unknown_type)],
					unknown_type,
					body,
				),
			],
		),
		"unknown",
	):
		Some(CallExpr(UserCall(_, Some(actual_id), _), _, _, _, _)):
			actual_id == def_id
		_:
			False


pure func test_option_of_unmanaged_resource_handle_fails_closed() -> Bool:
	file_reader_type: CoreType = NamedType("FileReader", [])
	option_type: CoreType = NamedType("Option", [file_reader_type])
	def_id: Int = 43
	body: CoreExpr = self_call("read_again", def_id, [variable("reader", option_type)], option_type)

	match lowered_function_body(
		program(
			[
				function_decl(
					"read_again",
					def_id,
					[param("reader", option_type)],
					option_type,
					body,
				),
			],
		),
		"read_again",
	):
		Some(CallExpr(UserCall(_, Some(actual_id), _), _, _, _, _)):
			actual_id == def_id
		_:
			False


tests: TestSuite = {
	description = "Blorp compiler tail recursion lowering",
	tests = [
		("unmanaged self call becomes loop", test_unmanaged_self_call_becomes_tailrec_loop),
		("list spread omits list rebind", test_list_spread_recur_omits_list_rebind),
		("list spread preserves prefix binding", test_list_spread_loop_preserves_prefix_binding),
		("list spread recognizes alias parameter", test_list_spread_loop_recognizes_alias_param),
		(
			"list spread ignores resource-scope shadowing",
			test_list_spread_ignores_resource_scope_shadowed_spread_var,
		),
		("managed candidate remains unchanged", test_managed_unmanaged_loop_candidate_is_unchanged),
		("unknown type fails closed", test_unknown_type_fails_closed),
		(
			"option of resource handle fails closed",
			test_option_of_unmanaged_resource_handle_fails_closed,
		),
	]
}
