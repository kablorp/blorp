import:
	../src/stage_02_lex/compiler_parse_diagnostic:
		CompilerParseDiagnostic,
		ParseDiagnosticSeverity(ParseErrorSeverity, ParseWarningSeverity),
		compiler_parse_diagnostic_is_error,
		compiler_parse_diagnostic_to_string,
		compiler_parse_error,
		compiler_parse_error_expected,
		compiler_parse_warning,
	../src/stage_01_file_io/compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("demo.brp", "demo", "func main\n\tbad")


pure func bad_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	start: CompilerCursor = compiler_source_cursor_at(src, 11)
	finish: CompilerCursor = compiler_source_cursor_at(src, 14)
	compiler_source_span(src, start, finish)


func test_parse_error_has_expected_labels() -> Bool:
	diag: CompilerParseDiagnostic = compiler_parse_error_expected(
		bad_span(),
		"expected expression",
		["identifier", "literal"],
		Some("insert an expression after the indentation"),
	)

	(
		compiler_parse_diagnostic_is_error(diag)
		and diag.severity == ParseErrorSeverity
		and diag.expected.length() == 2
		and diag.help.get_or("") == "insert an expression after the indentation"
	)


func test_warning_is_not_error() -> Bool:
	diag: CompilerParseDiagnostic = compiler_parse_warning(bad_span(), "unused trivia")
	not compiler_parse_diagnostic_is_error(diag) and diag.severity == ParseWarningSeverity


func test_diagnostic_formatting() -> Bool:
	diag: CompilerParseDiagnostic = compiler_parse_error(bad_span(), "expected expression")
	compiler_parse_diagnostic_to_string(diag) == "demo.brp:2:5: error: expected expression"


tests: TestSuite = {
	description = "Compiler parse diagnostics",
	tests = [
		("parse error has expected labels", test_parse_error_has_expected_labels),
		("warning is not error", test_warning_is_not_error),
		("diagnostic formatting", test_diagnostic_formatting),
	]
}
