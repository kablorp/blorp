import:
	../src/stage_09_core/compiler_core_json:
		CoreAccessor(RootAccessor),
		CoreBinaryOp(NotEqualOp),
		CoreCallKind(BuiltinCall, DirectRuntimeCall, IntrinsicCall),
		CoreConstructorMatchBody(ConstructorMatchBodyExpr),
		CoreConstructorMatchFallback(ConstructorMatchFallbackBody),
		CoreConstructorMatchTest(BoxedResultOkConstructorTest, StackResultOkConstructorTest),
		CoreDecl(FunctionDecl),
		CoreExpr(
			BinaryExpr,
			CallExpr,
			CastExpr,
			ConstructorMatchExpr,
			FieldExpr,
			LiteralExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunctionKind(UserFunction),
		CoreLiteral(BoolLiteral, IntLiteral, StringLiteral),
		CoreProgram,
		CoreReleasePolicy(NoReleasePolicy),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreTensorDim(TensorStaticDim),
		CoreTensorTypeInfo,
		CoreType(
			BoxedResultType,
			HeapRecordType,
			NamedType,
			RangeType,
			StackResultType,
			TensorType,
			TupleType,
			ValueRecordType,
			VoidType,
		),
		CoreVar,
		core_expr_to_json,
	../src/stage_09_core/compiler_core_specialize: specialize_program
	test: TestSuite


pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, SyntheticSourceLoc)


pure func builtin_call(name: String, arg: CoreExpr, typ: CoreType) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		VoidExpr(VoidType, SyntheticSourceLoc),
		[arg],
		typ,
		SyntheticSourceLoc,
	)


pure func intrinsic_call(name: String, arg: CoreExpr, typ: CoreType) -> CoreExpr:
	CallExpr(
		IntrinsicCall(name),
		VoidExpr(VoidType, SyntheticSourceLoc),
		[arg],
		typ,
		SyntheticSourceLoc,
	)


pure func program_with_body(body: CoreExpr) -> CoreProgram:
	{
		decls = [FunctionDecl({
				name = "main",
				source_module = None,
				type_params = [],
				params = [],
				return_type = named_type("Int"),
				body = Some(body),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 1,
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}


pure func specialized_body(body: CoreExpr) -> Option[CoreExpr]:
	match specialize_program(program_with_body(body)).decls:
		[FunctionDecl(function_info)]:
			function_info.body
		_:
			None


pure func test_to_int_identity_and_casts() -> Bool:
	int_value: CoreExpr = variable("int_value", named_type("Int"))
	float_value: CoreExpr = variable("float_value", named_type("Float"))
	range_value: CoreExpr = variable("range_value", RangeType)

	match (
		specialized_body(builtin_call("blorp_to_int", int_value, named_type("Int"))),
		specialized_body(builtin_call("blorp_to_int", float_value, named_type("Int"))),
		specialized_body(builtin_call("blorp_to_int", range_value, named_type("Int"))),
	):
		(Some(VarExpr(int_var, NamedType("Int", []), _)), Some(CastExpr(VarExpr(float_var, _, _), NamedType("Int", []), _)), Some(CastExpr(VarExpr(range_var, _, _), NamedType("Int", []), _))):
			(
				int_var.name == "int_value"
				and float_var.name == "float_value"
				and range_var.name == "range_value"
			)
		_:
			False


pure func test_float_width_conversions() -> Bool:
	value: CoreExpr = variable("value", named_type("Int"))

	match (
		specialized_body(builtin_call("blorp_to_float", value, named_type("Float"))),
		specialized_body(builtin_call("blorp_to_float32", value, NamedType("Float32", []))),
		specialized_body(builtin_call("blorp_to_float16", value, NamedType("Float16", []))),
	):
		(Some(CastExpr(_, NamedType("Float", []), _)), Some(CastExpr(_, NamedType("Float32", []), _)), Some(CastExpr(_, NamedType("Float16", []), _))):
			True
		_:
			False


pure func test_to_bool_int_and_option() -> Bool:
	int_value: CoreExpr = variable("value", named_type("Int"))
	option_value: CoreExpr = variable(
		"maybe",
		NamedType("Option", [named_type("Int")]),
	)

	match (
		specialized_body(builtin_call("blorp_to_bool", int_value, named_type("Bool"))),
		specialized_body(builtin_call("blorp_to_bool", option_value, named_type("Bool"))),
	):
		(Some(BinaryExpr(NotEqualOp, _, LiteralExpr(IntLiteral(0), _, _), NamedType("Bool", []), _)), Some(BinaryExpr(_, FieldExpr(_, "tag", _, _), VarExpr(tag, _, _), NamedType("Bool", []), _))):
			tag.name == "TAG_Some"
		_:
			False


private pure func expected_result_truthiness(
	arg: CoreExpr,
	test: CoreConstructorMatchTest,
) -> CoreExpr:
	bool_type = named_type("Bool")
	ConstructorMatchExpr(
		arg,
		NoReleasePolicy,
		[
			{
				constructor = "Ok",
				accessor = RootAccessor,
				test = test,
				bindings = [],
				body = ConstructorMatchBodyExpr(
					LiteralExpr(
						BoolLiteral(True),
						bool_type,
						SyntheticSourceLoc,
					),
				)
			},
		],
		ConstructorMatchFallbackBody(
			LiteralExpr(
				BoolLiteral(False),
				bool_type,
				SyntheticSourceLoc,
			),
		),
		bool_type,
		SyntheticSourceLoc,
	)


private pure func specialized_matches(actual: Option[CoreExpr], expected: CoreExpr) -> Bool:
	match actual:
		Some(expr):
			core_expr_to_json(expr).to_string() == core_expr_to_json(expected).to_string()
		None:
			False


pure func test_to_bool_result_layouts() -> Bool:
	stack_result: CoreExpr = variable(
		"stack_result",
		StackResultType(VoidType, named_type("String")),
	)
	boxed_result: CoreExpr = variable(
		"boxed_result",
		BoxedResultType(named_type("String"), named_type("String")),
	)

	stack_specialized = specialized_body(
		builtin_call(
			"blorp_to_bool",
			stack_result,
			named_type("Bool"),
		),
	)
	boxed_specialized = specialized_body(
		builtin_call(
			"blorp_to_bool",
			boxed_result,
			named_type("Bool"),
		),
	)

	specialized_matches(
		stack_specialized,
		expected_result_truthiness(stack_result, StackResultOkConstructorTest("blorp_StackResult")),
	) and specialized_matches(
		boxed_specialized,
		expected_result_truthiness(boxed_result, BoxedResultOkConstructorTest),
	)


pure func test_specialization_recurses_through_nested_calls() -> Bool:
	inner: CoreExpr = builtin_call(
		"blorp_to_float",
		variable("value", named_type("Int")),
		named_type("Float"),
	)
	outer: CoreExpr = builtin_call("blorp_to_int", inner, named_type("Int"))

	match specialized_body(outer):
		Some(CastExpr(CastExpr(_, NamedType("Float", []), _), NamedType("Int", []), _)):
			True
		_:
			False


pure func test_string_to_int_becomes_direct_runtime_call() -> Bool:
	text: CoreExpr = variable(
		"text",
		NamedType("String", []),
	)

	match specialized_body(builtin_call("blorp_to_int", text, named_type("Int"))):
		Some(specialized):
			match specialized:
				CallExpr(kind, _, args, _, _):
					match kind:
						DirectRuntimeCall(call):
							call.name == "blorp_to_int" and args.length() == 1
						_:
							False
				_:
					False
		_:
			False


pure func test_int_hash_becomes_direct_runtime_call() -> Bool:
	hash_specializes_to_runtime(named_type("Int"), "blorp_hash_int")


pure func hash_specializes_to_runtime(arg_type: CoreType, expected_runtime: String) -> Bool:
	match specialized_body(
		builtin_call(
			"blorp_hash",
			variable("value", arg_type),
			named_type("Int"),
		),
	):
		Some(specialized):
			match specialized:
				CallExpr(kind, _, args, _, _):
					match kind:
						DirectRuntimeCall(call):
							call.name == expected_runtime and args.length() == 1
						_:
							False
				_:
					False
		_:
			False


pure func test_hash_dispatches_other_primitive_types() -> Bool:
	(
		hash_specializes_to_runtime(named_type("String"), "blorp_hash_string")
		and hash_specializes_to_runtime(named_type("Bool"), "blorp_hash_int")
		and hash_specializes_to_runtime(named_type("Char"), "blorp_hash_int")
		and hash_specializes_to_runtime(named_type("UInt128"), "blorp_hash_int")
		and hash_specializes_to_runtime(named_type("Float"), "blorp_hash_float")
		and hash_specializes_to_runtime(named_type("Float32"), "blorp_hash_float")
		and hash_specializes_to_runtime(named_type("Float16"), "blorp_hash_float")
		and hash_specializes_to_runtime(RangeType, "blorp_hash_int")
	)


pure func test_type_name_intrinsic_renders_post_mono_core_types() -> Bool:
	tensor_type: CoreType = TensorType({
		element_type = named_type("Float"),
		dims = [TensorStaticDim(2), TensorStaticDim(3)],
	})
	tuple_type: CoreType = TupleType([named_type("Int"), named_type("String")])

	match (
		specialized_body(
			intrinsic_call(
				"type_name",
				variable("tensor", tensor_type),
				named_type("String"),
			),
		),
		specialized_body(
			intrinsic_call(
				"type_name",
				variable("tuple", tuple_type),
				named_type("String"),
			),
		),
	):
		(Some(LiteralExpr(StringLiteral(tensor_name), _, _)), Some(LiteralExpr(StringLiteral(tuple_name), _, _))):
			tensor_name == "Float[#2, #3]" and tuple_name == "(Int, String)"
		_:
			False


pure func is_heap_specializes_to(typ: CoreType, expected: Bool) -> Bool:
	match specialized_body(intrinsic_call("is_heap", variable("value", typ), named_type("Bool"))):
		Some(LiteralExpr(BoolLiteral(actual), _, _)):
			actual == expected
		_:
			False


pure func test_is_heap_intrinsic_uses_core_ownership_layout() -> Bool:
	(
		is_heap_specializes_to(named_type("Int"), False)
		and is_heap_specializes_to(named_type("String"), True)
		and is_heap_specializes_to(ValueRecordType("Point"), False)
		and is_heap_specializes_to(HeapRecordType("Node"), True)
		and is_heap_specializes_to(
			StackResultType(named_type("String"), named_type("Int")),
			True,
		)
		and is_heap_specializes_to(
			StackResultType(named_type("Int"), named_type("Bool")),
			False,
		)
	)


pure func test_hash_preserves_unsupported_type_dispatch() -> Bool:
	match specialized_body(
		builtin_call(
			"blorp_hash",
			variable("value", VoidType),
			named_type("Int"),
		),
	):
		Some(specialized):
			match specialized:
				CallExpr(kind, _, args, _, _):
					match kind:
						BuiltinCall(name):
							name == "blorp_hash" and args.length() == 1
						_:
							False
				_:
					False
		_:
			False


tests: TestSuite = {
	description = "Blorp compiler Core primitive specialization",
	tests = [
		("to_int identity and casts", test_to_int_identity_and_casts),
		("float width conversions", test_float_width_conversions),
		("to_bool Int and Option", test_to_bool_int_and_option),
		("to_bool Result layouts", test_to_bool_result_layouts),
		(
			"specialization recurses through nested calls",
			test_specialization_recurses_through_nested_calls,
		),
		(
			"String to_int becomes direct runtime call",
			test_string_to_int_becomes_direct_runtime_call,
		),
		("Int hash becomes direct runtime call", test_int_hash_becomes_direct_runtime_call),
		("hash dispatches other primitive types", test_hash_dispatches_other_primitive_types),
		(
			"type_name renders post-mono Core types",
			test_type_name_intrinsic_renders_post_mono_core_types,
		),
		("is_heap uses Core ownership layout", test_is_heap_intrinsic_uses_core_ownership_layout),
		(
			"hash preserves unsupported type dispatch",
			test_hash_preserves_unsupported_type_dispatch,
		),
	]
}
