func test_mono_invariant_accepts_concrete_user_call() -> Bool:
	int_type: CoreType = named_type("Int")
	call: CoreExpr = CallExpr(
		UserCall("identity", Some(20), []),
		variable(
			"identity",
			FunctionType(True, [int_type], int_type),
		),
		[variable("value", int_type)],
		int_type,
		SyntheticSourceLoc,
	)

	check_mono_invariants(program(call, int_type)).is_empty()


