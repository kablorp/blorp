import:
	../codegen_prepared_list_renderer:
		InlineStructStoreBoxing(StackResultBoxing, StructAddressBoxing),
		PreparedListOp(
			CopySpanUninit,
			EnsureCapacity,
			EnsureUnique,
			HandoffSetSourceSlot,
			InlineCheckedGet,
			InlineBitsLoad,
			InlineBitsSwap,
			InlineBitsStore,
			InlineProvenGet,
			InlineStructHandoffSetOwnedStore,
			InlineStructSwap,
			InlineStructLoadChecked,
			InlineStructLoadProven,
			InlineStructSetRawStore,
			ListAllocInline,
			ListAllocInlineStruct,
			ListAllocPointer,
			ListAllocWithRelease,
			ListConstructAppend,
			ListConstructAppendOwned,
			ListConstruct,
			ListConstructInitElemRelease,
			ListConstructInlineStructSet,
			ListConstructName,
			ListConstructSetLen,
			ListHandoffBorrowPrefix,
			ListHandoffBorrowSuffix,
			ListHandoffCapacityName,
			ListHandoffReleaseName,
			ListHandoffReusePrefix,
			ListHandoffReuseName,
			ListHandoffReuseSuffix,
			ListInlineStructUnboxClose,
			ListInlineStructUnboxIndexName,
			ListInlineStructUnboxListName,
			ListInlineStructUnboxOpen,
			ListInlineStructUnboxOutName,
			PointerHandoffSetOwnedStore,
			PointerSwap,
			PointerGet,
			PointerSetRawStore,
			RetainFor,
			RetainForNoop,
			ReuseAlloc,
			ReuseAllocWithRelease,
		),
		RenderError(UnsupportedPreparedListOp, WrongArity),
		parse_prepared_list_template,
		prepared_list_template_arity,
		prepared_list_template_name,
		render_error_to_string,
		render_prepared_list,
		render_prepared_list_op,
	test: TestSuite


func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_prepared_list_template(name):
		Some(info):
			(
				prepared_list_template_name(info) == expected_name
				and prepared_list_template_arity(info) == expected_arity
			)
		None:
			False


